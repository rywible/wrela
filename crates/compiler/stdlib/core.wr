public A Env:
    public can get(key: String) -> String:
        return env_get(key)

    public can get_or(key: String, default: String) -> String:
        return env_get_or(key, default)

    public can get_as_bool(key: String) -> Bool:
        return env_get_as_bool(key)

    public can get_as_int(key: String) -> Int:
        return env_get_as_int(key)

    public can set(key: String, value: String) -> Bool:
        return env_set(key, value)

    public can load(path: String) -> Bool:
        return env_load(path)

public A Auth:
    has:
        storage: StorageClient
    public can create_user(email: String, username: String, password: String) -> Pending:
        return auth_create_user(its.storage, email, username, password)

    public can verify_password(user_id: String, password: String) -> Pending:
        return auth_verify_password(its.storage, user_id, password)

    public can issue_jwt(user_id: String, claims: Map, ttl_secs: Int) -> Pending:
        return auth_issue_jwt(its.storage, user_id, claims, ttl_secs)

    public can verify_jwt(token: String) -> Pending:
        return auth_verify_jwt(its.storage, token)

    public can issue_email_token(user_id: String, ttl_secs: Int) -> Pending:
        return auth_issue_email_token(its.storage, user_id, ttl_secs)

    public can verify_email_token(token: String) -> Pending:
        return auth_verify_email_token(its.storage, token)

    public can oauth_login(provider: String, code: String) -> Pending:
        return auth_oauth_login(its.storage, provider, code)

public A RBAC:
    has:
        storage: StorageClient
    public can create_role(scope: String, name: String, permissions: List) -> Pending:
        return rbac_create_role(its.storage, scope, name, permissions)

    public can assign_role(user_id: String, role_id: String, scope_id: String) -> Pending:
        return rbac_assign_role(its.storage, user_id, role_id, scope_id)

    public can check(user_id: String, permission: String, scope_id: String) -> Pending:
        return rbac_check(its.storage, user_id, permission, scope_id)

    public can permissions_for(user_id: String, scope_id: String) -> Pending:
        return rbac_permissions_for(its.storage, user_id, scope_id)

public A Files:
    has:
        storage: StorageClient
    public can upload_stream(stream: Bytes, opts: Map) -> Pending:
        return files_upload_stream(its.storage, stream, opts)

    public can signed_url(file_id: String, opts: Map) -> Pending:
        return files_signed_url(its.storage, file_id, opts)

    public can metadata(file_id: String) -> Pending:
        return files_metadata(its.storage, file_id)

    public can delete(file_id: String) -> Pending:
        return files_delete(its.storage, file_id)

    public can set_acl(file_id: String, acl: String) -> Pending:
        return files_set_acl(its.storage, file_id, acl)

public A Jobs:
    has:
        storage: StorageClient
    public can enqueue(queue: String, payload: Map, opts: Map) -> Pending:
        return jobs_enqueue(its.storage, queue, payload, opts)

    public can process(queue: String, handler) -> Pending:
        return jobs_process(its.storage, queue, handler)

    public can dead_letter(queue: String) -> Pending:
        return jobs_dead_letter(its.storage, queue)

public A Schedule:
    has:
        storage: StorageClient
    public can cron(expr: String, job) -> Pending:
        return schedule_cron(its.storage, expr, job)

    public can every(seconds: Int, job) -> Pending:
        return schedule_every(its.storage, seconds, job)

    public can at(timestamp: Int, job) -> Pending:
        return schedule_at(its.storage, timestamp, job)

public A Search:
    has:
        storage: StorageClient
    public can index(collection: String, id: String, text: String, fields: Map) -> Pending:
        return search_index(its.storage, collection, id, text, fields)

    public can remove(collection: String, id: String) -> Pending:
        return search_remove(its.storage, collection, id)

    public can query(collection: String, query: String, opts: Map) -> Pending:
        return search_query(its.storage, collection, query, opts)

public A Realtime:
    public can on_connect(handler) -> Pending:
        return realtime_on_connect(handler)

    public can join(socket_id: String, room: String) -> Pending:
        return realtime_join(socket_id, room)

    public can leave(socket_id: String, room: String) -> Pending:
        return realtime_leave(socket_id, room)

    public can broadcast(room: String, message) -> Pending:
        return realtime_broadcast(room, message)

    public can send(socket_id: String, message) -> Pending:
        return realtime_send(socket_id, message)

public A RateLimit:
    has:
        storage: StorageClient
    public can check(key: String, opts: Map) -> Pending:
        return rate_check(its.storage, key, opts)

    public can ip(request: HttpRequest) -> String:
        return rate_ip(request)

public A Admin:
    public can enable(opts: Map) -> Pending:
        return admin_enable(opts)

public A StorageConfig:
    has:
        s3_bucket: String
        s3_region: String
        s3_access_key: String
        s3_secret_key: String
        s3_endpoint: String
        s3_prefix: String
        file_path: String

public A StorageClient:
    public can get(key: String) -> Result:
        return await storage_get(key)

    public can get_with_version(key: String) -> Result:
        return await storage_get_with_version(key)

    public can scan(start: String, end: String, limit: Number) -> Result:
        return await storage_scan(start, end, limit)

    public can list_prefix(prefix: String, limit: Number) -> Result:
        return await storage_list_prefix(prefix, limit)

    public can set(key: String, value: String) -> Result:
        return await storage_set(key, value)

    public can set_if_version(key: String, value: String, version: Number) -> Result:
        return await storage_set_if_version(key, value, version)

    public can delete_if_version(key: String, version: Number) -> Result:
        return await storage_delete_if_version(key, version)

    public can delete(key: String) -> Result:
        return await storage_delete(key)

    public can batch_set(items: List) -> Result:
        return await storage_batch_set(items)

public to storage_open(config: StorageConfig):
    storage_configure(config)
    return detach StorageClient() * 1

public A HttpRequest:
    has:
        method: String
        path: String
        headers: Map
        query: Map
        params: Map
        body: Bytes

    public can header(name: String) -> String:
        return map_get(its.headers, name)

    public can query_param(name: String) -> String:
        return map_get(its.query, name)

    public can path_param(name: String) -> String:
        return map_get(its.params, name)

    public can text() -> String:
        return bytes_to_string(its.body)

    public can json() -> String:
        return bytes_to_string(its.body)

public A HttpResponse:
    has:
        status: Number
        headers: Map
        body: Bytes

    public can header(name: String, value: String) -> HttpResponse:
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, name, value)
        return its

    public can ok(text: String) -> HttpResponse:
        its.status = 200
        its.body = bytes_from_string(text)
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, "content-type", "text/plain; charset=utf-8")
        return its

    public can json(text: String) -> HttpResponse:
        its.status = 200
        its.body = bytes_from_string(text)
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, "content-type", "application/json")
        return its

    public can text(text: String) -> HttpResponse:
        return its.ok(text)

    public can text_with_status(text: String, status: Number) -> HttpResponse:
        its.status = status
        its.body = bytes_from_string(text)
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, "content-type", "text/plain; charset=utf-8")
        return its

    public can empty() -> HttpResponse:
        its.status = 204
        its.body = bytes_from_string("")
        return its

    public can empty_with_status(status: Number) -> HttpResponse:
        its.status = status
        its.body = bytes_from_string("")
        return its

public A HttpServer:
    public can serve_get_requests(path: String, handler) -> Nothing:
        http_server_serve_get_requests(path, handler)

    public can serve_post_requests(path: String, handler) -> Nothing:
        http_server_serve_post_requests(path, handler)

    public can serve_requests(method: String, path: String, handler) -> Nothing:
        http_server_serve_requests(method, path, handler)

    public can serve_on(addr: String) -> Nothing:
        http_server_serve_on(addr)

    public can stop() -> Nothing:
        http_server_stop()
