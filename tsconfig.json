{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "bun",
      "@webgpu/types"
    ],
    "paths": {
      "@wrela/model": [
        "./packages/model/src/index.ts"
      ],
      "@wrela/compiler": [
        "./packages/compiler/src/index.ts"
      ],
      "@wrela/world": [
        "./packages/world/src/index.ts"
      ],
      "@wrela/runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@wrela/render-webgpu": [
        "./packages/render-webgpu/src/index.ts"
      ],
      "@wrela/authoring": [
        "./packages/authoring/src/index.ts"
      ],
      "@wrela/review": [
        "./packages/review/src/index.ts"
      ],
      "@wrela/examples": [
        "./packages/examples/src/index.ts"
      ],
      "@wrela/examples/*": [
        "./packages/examples/src/*"
      ],
      "@wrela/game-winter/*": [
        "./games/winter-valley/src/*"
      ],
      "@wrela/game-creature/*": [
        "./games/creature-study/src/*"
      ],
      "@wrela/delivery": [
        "./packages/delivery/src/index.ts"
      ],
      "@wrela/compiler/*": [
        "./packages/compiler/src/*"
      ],
      "@wrela/delivery/*": [
        "./packages/delivery/src/*"
      ],
      "@wrela/model/*": [
        "./packages/model/src/*"
      ],
      "@wrela/render-webgpu/*": [
        "./packages/render-webgpu/src/*"
      ],
      "@wrela/review/*": [
        "./packages/review/src/*"
      ],
      "@wrela/authoring/*": [
        "./packages/authoring/src/*"
      ],
      "@wrela/world/*": [
        "./packages/world/src/*"
      ],
      "@wrela/runtime/*": [
        "./packages/runtime/src/*"
      ]
    }
  },
  "include": [
    "packages",
    "apps",
    "games",
    "tools",
    "verification"
  ]
}
