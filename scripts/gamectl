#!/usr/bin/env python3
import os,runpy,sys,re
from pathlib import Path
args=sys.argv[1:]
if len(args)<2 or args[0]!='--project':raise SystemExit('Usage: gamectl --project sanctuary|cave <action> [options]')
project=args[1]
if not re.fullmatch(r'[a-z][a-z0-9-]{0,47}',project):raise SystemExit('Invalid project id')
os.environ['SANCTUARY_CONTROL_ROOT']='.'+project
sys.argv=[sys.argv[0]]+args[2:]
runpy.run_path(str(Path(__file__).with_name('gardenctl')),run_name='__main__')
