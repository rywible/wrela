#!/usr/bin/env python3
"""Measure a fixed camera workload without captures or concurrent compilation."""
import argparse
import json
from pathlib import Path
import runpy
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--seconds', type=int, default=60)
args = parser.parse_args()
if args.seconds < 10: parser.error('Use at least 10 seconds')
client = runpy.run_path(str(Path(__file__).with_name('gardenctl')))
command, root = client['command'], client['ROOT']
command('scene', value='garden')
command('reset')
command('lighting', value='morning')
command('parameters', scale=1, exposure=1, wind=1)
command('pause', value=False)
time.sleep(5)
command('clearMetrics')
initial = command('status')['state']
start = time.monotonic()
power = subprocess.run(['pmset','-g','batt'],capture_output=True,text=True).stdout.strip()
samples = []
while time.monotonic()-start < args.seconds:
    time.sleep(min(10, max(0,args.seconds-(time.monotonic()-start))))
    state = command('status')['state']
    if state['sessionPID'] != initial['sessionPID']: raise RuntimeError('App restarted during benchmark')
    if state['scene'] != 'garden' or state['camera'] != initial['camera'] or state['lighting'] != 'morning' or state['paused']:
        raise RuntimeError('Scene changed during benchmark; rerun without interacting with the app')
    rss = subprocess.run(['ps','-o','rss=','-p',str(state['sessionPID'])],capture_output=True,text=True).stdout.strip()
    samples.append(dict(elapsedSeconds=time.monotonic()-start, rssMiB=int(rss)/1024 if rss else None, state=state))
    (root/'benchmark-progress.json').write_text(json.dumps(samples[-1],indent=2))
elapsed = time.monotonic()-start
report = dict(durationSeconds=elapsed, power=power, workload='Fixed arrival camera; animated wind; native 1920x1080; no captures during sampling',
              submittedFramesPerSecond=(state['frame']-initial['frame'])/elapsed,
              maxRollingGPUP95=max(s['state']['gpuMilliseconds'].get('p95',0) for s in samples),
              maxRSSMiB=max(s['rssMiB'] or 0 for s in samples), samples=samples,
              notes='Timing percentiles are rolling windows of up to 3600 frames. This tests this garden view, not the future game or all viewpoints. Submitted frame rate is not direct presentation telemetry.')
out = root/'benchmark.json'
out.write_text(json.dumps(report,indent=2))
print(json.dumps({k:v for k,v in report.items() if k != 'samples'},indent=2))
print(f'Report: {out}')
