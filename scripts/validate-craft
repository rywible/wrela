#!/usr/bin/env python3
import os,runpy,subprocess,sys
from pathlib import Path
root=Path(__file__).resolve().parents[1]
if os.environ.get('WRELA_CONTROL_ROOT'):
 runpy.run_path(str(root/'Games/Sanctuary/Testing/CraftAuthoring.py'),run_name='__main__')
 runpy.run_path(str(root/'Games/Sanctuary/Testing/SourceAnatomyAuthoring.py'),run_name='__main__')
else:
 sys.exit(subprocess.call([str(root/'scripts/test'),'authoring','--suite','craft']))
