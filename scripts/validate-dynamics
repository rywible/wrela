#!/usr/bin/env python3
"""Run the project-owned secondary-motion authoring checks in an isolated app."""
import os,sys,runpy
from pathlib import Path
root=Path(__file__).resolve().parents[1]
if not os.environ.get('WRELA_CONTROL_ROOT'):
 os.execv(sys.executable,[sys.executable,str(root/'scripts/test'),'authoring','--suite','dynamics','--game','sanctuary'])
runpy.run_path(str(root/'Games/Sanctuary/Testing/DynamicsAuthoring.py'),run_name='__main__')
