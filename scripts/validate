#!/usr/bin/env python3
"""Check the standalone Sanctuary host; editor checks live in validate-workshop."""
import os,sys
if not os.environ.get('WRELA_CONTROL_ROOT'):
    os.execv(sys.executable,[sys.executable,str(__import__('pathlib').Path(__file__).with_name('test')),'host','--game','sanctuary'])
import json,runpy,struct,uuid
from pathlib import Path
client=runpy.run_path(str(Path(__file__).with_name('gardenctl')))
c,root=client['command'],client['ROOT']
original=c('status')['state'];checks=[];complete=False
assert original['project']=='sanctuary' and original['mode']=='game'
def check(name,value):
 checks.append(dict(name=name,passed=bool(value)))
 if not value:raise AssertionError(name)
def reject(action,**values):
 try:c(action,**values);return False
 except RuntimeError:return True
try:
 c('pause',value=True);c('expeditionSlot',name='host-validation-'+uuid.uuid4().hex[:10]);c('reset')
 for _ in range(12):
  state=c('move',z=2)['state'];clearance=state['camera']['position'][1]-state['groundHeight']
  assert 1.70<=clearance<=1.95
 check('Grounded route stays above the field',True)
 first=c('capture',label='host-reference');second=c('capture',label='host-repeat');image=Path(first['path']).read_bytes()
 check('Captures are native 1080p',struct.unpack('>II',image[16:24])==(1920,1080))
 check('Paused captures reproduce exactly',image==Path(second['path']).read_bytes())
 t=c('status')['state']['time'];state=c('step',frames=60)['state']
 check('Fixed stepping advances one second',abs(state['time']-t-1)<0.01)
 c('parameters',scale=1)
 center=c('query',x=5,y=0,z=12)['podPosition'];probe=dict(x=center[0]+.015,y=center[1],z=center[2])
 before=c('query',**probe)['podDistanceBound'];c('parameters',scale=1.4)
 check('Scale updates the shared field query',abs(before-c('query',**probe)['podDistanceBound'])>.0001)
 check('Rejected edit preserves valid state',reject('parameters',scale=9) and abs(c('status')['state']['parameters']['scale']-1.4)<.0001)
 for action,values in [('step',dict(frames=1e30)),('step',dict(frames=1.5)),('query',dict(x=1e30)),('camera',dict(x='bad')),('parameters',dict(scale=True))]:
  assert reject(action,**values)
 check('Malformed and extreme values fail without crashing',True)
 check('Game host directs authoring to Soundstage',reject('scene',value='studio'))
 check('No GPU command errors',not c('status')['state']['gpuErrors']);complete=True
finally:
 c('expeditionSlot',name=original['expedition']['saveSlot'])
 p=original['camera'];c('camera',x=p['position'][0],z=p['position'][2],yaw=p['yaw'],pitch=p['pitch'])
 c('parameters',exposure=original['parameters']['exposure'],scale=original['parameters']['scale'],wetness=original['wetness'])
 c('pause',value=original['paused'])
 report=dict(passed=complete,checks=checks);(root/'validation.json').write_text(json.dumps(report,indent=2));print(json.dumps(report,indent=2))
