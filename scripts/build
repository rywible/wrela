#!/bin/zsh
set -eu
cd "${0:A:h:h}"
export WRELA_BUILD_PRODUCT="${1:-}"
if [[ -n "$WRELA_BUILD_PRODUCT" ]]; then
 swift build -c release --product "$WRELA_BUILD_PRODUCT"
else
 swift build -c release
fi
/usr/bin/python3 - "$PWD" <<'PY'
import plistlib,pathlib,sys,subprocess,shutil,hashlib,os
workspace=pathlib.Path(sys.argv[1]);revision=subprocess.check_output(['git','rev-parse','--short','HEAD'],text=True).strip()
if subprocess.check_output(['git','status','--porcelain'],text=True).strip():revision+='-working-tree'
digest=hashlib.sha256()
for source in sorted(p for folder in ['Engine','Games','Tools'] for p in (workspace/folder).rglob('*'))+[workspace/'Package.swift']:
 if source.is_file():digest.update(str(source.relative_to(workspace)).encode());digest.update(source.read_bytes())
for product,identifier in [('Sanctuary','dev.sanctuary.fieldgarden'),('Cave','dev.wrela.cave'),('Soundstage','dev.sanctuary.soundstage')]:
 if os.environ.get('WRELA_BUILD_PRODUCT') and product!=os.environ['WRELA_BUILD_PRODUCT']:continue
 app=workspace/'.build'/f'{product}.app';(app/'Contents/MacOS').mkdir(parents=True,exist_ok=True);(app/'Contents/Resources').mkdir(exist_ok=True)
 shutil.copy2(workspace/'.build/release'/product,app/'Contents/MacOS'/product)
 for shader in (workspace/'Engine/FieldEngine/Resources').glob('*.metal'):shutil.copy2(shader,app/'Contents/Resources'/shader.name)
 for obsolete in ['Garden.metal','Trace.metal']:
  (app/'Contents/Resources'/obsolete).unlink(missing_ok=True)
 old=app/'Contents/MacOS/Sanctuary'
 if product=='Soundstage' and old.exists():old.unlink()
 info=dict(CFBundleExecutable=product,CFBundleIdentifier=identifier,CFBundleName=product,CFBundleDisplayName=product,CFBundlePackageType='APPL',CFBundleVersion='1',CFBundleShortVersionString='0.2.0',NSHighResolutionCapable=True,LSMinimumSystemVersion='14.0',SanctuaryWorkspace=str(workspace),SanctuaryRevision=revision,SanctuarySourceDigest=digest.hexdigest())
 with (app/'Contents/Info.plist').open('wb') as f:plistlib.dump(info,f)
 subprocess.run(['codesign','--force','--sign','-',str(app)],check=True)
 print('Built',app)
PY
