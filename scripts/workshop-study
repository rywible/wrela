#!/usr/bin/env python3
"""Capture, archive and open a review, or compare against immutable rendered pixels."""
import argparse,hashlib,json,os,runpy,shutil,subprocess,time,uuid
from pathlib import Path
from workshop_viewer import write_viewer
p=argparse.ArgumentParser(description=__doc__)
mode=p.add_mutually_exclusive_group()
mode.add_argument('--baseline',type=Path,help='Compare a saved source study with the current subject')
mode.add_argument('--reference',type=Path,help='Compare stored pixels; with --current compare current edits, otherwise replay archived settings with current shaders')
mode.add_argument('--style-board',action='store_true',help='Compare the current subject with project working references under matching lights')
p.add_argument('--current',action='store_true',help='Capture the current view and lighting; a reference must contain one frame')
p.add_argument('--no-open',action='store_true',help='Do not open the native review window')
p.add_argument('--views',default='front,quarter,back,above')
p.add_argument('--lights',default='noon,sunset,overcast')
p.add_argument('--rigs',default='softbox,lamp,room')
p.add_argument('--motion',type=int,default=1)
p.add_argument('--creature-sequence',action='store_true',help='Sample a full registered clip or five seconds of idle, independent of playback speed; preserve the current rig')
p.add_argument('--step',type=int,default=15)
p.add_argument('--sweep',action='store_true')
p.add_argument('--label',default='workshop')
a=p.parse_args()
if a.reference:a.reference=a.reference.resolve()
if a.baseline:a.baseline=a.baseline.resolve()
if not 1<=a.motion<=24 or not 1<=a.step<=600:p.error('Motion must be 1…24 frames; step must be 1…600 ticks')
if a.current and (a.baseline or a.style_board):p.error('--current is a single-view capture; use it alone or with --reference')
if a.creature_sequence and (a.current or a.baseline or a.reference or a.style_board or a.motion<2):p.error('Creature sequences need at least two motion frames and no comparison mode')
os.environ['SANCTUARY_CONTROL_ROOT']='.soundstage'
client=runpy.run_path(str(Path(__file__).with_name('gardenctl')));c,root=client['command'],client['ROOT']
label=''.join(x for x in a.label if x.isalnum() or x in '-_') or 'workshop'
folder=root/'studies'/(label+'-'+time.strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:6]);folder.mkdir(parents=True)
records=[];art=None;original=folder/'current.json'
def resolve(record,relative,absolute,base):
    path=base/record[relative] if record.get(relative) else Path(record[absolute])
    if not path.exists():raise RuntimeError('Archived capture is missing: '+str(path))
    return path
reference=[]
if a.reference:
    source=json.loads(a.reference.read_text());all_records=source['records']
    # A comparison report can itself become a baseline: take its newest rendering.
    latest=all_records[-1]['variant']
    if source.get('artDirection'):
        art=json.loads((Path(c('status')['state']['artDirectionPath'])).read_text());reference=[r for r in all_records if r.get('generation')!='Baseline']
    else:reference=[r for r in all_records if r['variant']==latest]
    if a.current and len(reference)!=1:p.error('Current-view comparison needs a single-frame reference. Omit --current to replay a complete report.')
    for r in reference:
        resolve(r,'image','path',a.reference.parent);resolve(r,'meta','metadata',a.reference.parent)
        if not a.current and not r.get('study'):p.error('This older report has no exact replay state. Use --current with a single-frame reference, or capture a new baseline.')
if c('status')['state']['workshop']['authoring']['automating']:raise RuntimeError('Another review is active')
c('automation',value=True)
def capture(variant,condition,view,frame=0):
    n=len(records);stem=f'frame-{n:03d}'
    c('saveStudy',path=str(folder/(stem+'-study.json')))
    result=c('capture',label=label+'-'+stem)
    image=folder/(stem+'.png');meta=folder/(stem+'.json')
    shutil.copyfile(result['path'],image);shutil.copyfile(result['metadata'],meta)
    records.append(dict(result,path=str(image),metadata=str(meta),image=image.name,meta=meta.name,study=stem+'-study.json',generation='Current',variant=variant,condition=condition,view=view,frame=frame,rendererFrame=result['frame']))
    print(f'{variant}: {condition} / {view} / {frame+1}',flush=True)
def archive(r):
    n=len(records);stem=f'frame-{n:03d}';base=a.reference.parent
    image=folder/(stem+'.png');meta=folder/(stem+'.json')
    shutil.copyfile(resolve(r,'image','path',base),image);shutil.copyfile(resolve(r,'meta','metadata',base),meta)
    record=dict(r,path=str(image),metadata=str(meta),image=image.name,meta=meta.name,generation='Baseline',variant=('Stored · '+r['variant']) if art else 'Stored baseline')
    if r.get('study'):
        target=folder/(stem+'-study.json');shutil.copyfile(base/r['study'],target);record['study']=target.name
    records.append(record)
try:
    c('saveStudy',path=str(original));c('pause',value=True)
    if a.current:
        if reference:archive(reference[0])
        capture('Current',reference[0]['condition'] if reference else 'Current lighting',reference[0]['view'] if reference else 'Current view')
    elif a.reference:
        current_look=json.loads(original.read_text()).get('sceneLook')
        for r in reference:
            archive(r);c('loadStudy',path=str(a.reference.parent/r['study']));c('pause',value=True)
            if current_look:c('look',**current_look)
            capture(('Current · '+r['variant']) if art else 'Current renderer',r['condition'],r['view'],r['frame'])
    else:
        variants=[('Current',original)]
        if a.baseline:
            baseline=json.loads(a.baseline.read_text());current=json.loads(original.read_text())
            current['time']=baseline['time'];current['windState']=baseline.get('windState');current['paused']=True
            synchronized=folder/'synchronized-current.json';synchronized.write_text(json.dumps(current,indent=2))
            variants=[('Baseline source',a.baseline.resolve()),('Current',synchronized)]
        if a.style_board:
            art=json.loads((Path(c('status')['state']['artDirectionPath'])).read_text())
            variants=[('Candidate',original)]+[(entry['label'],entry['subject']) for entry in art['references']]+[('Lighting and sky','__environment__')]
        views=['quarter'] if a.style_board else [x.strip() for x in a.views.split(',') if x.strip()]
        # Match WorkshopRenderer.lighting: indoor selects a room fixture. Replacing
        # it with outdoor leaves indoor shading paired with a distant sun lamp.
        lights=[('outdoor','noon'),('outdoor','sunset'),('softbox',None)] if a.style_board else [('room' if x.strip()=='indoor' else 'outdoor',x.strip()) for x in a.lights.split(',') if x.strip()]+[(x.strip(),None) for x in a.rigs.split(',') if x.strip()]
        if not views or not lights:raise RuntimeError('Choose at least one view and lighting condition')
        anchors={}
        for variant,source in variants:
            for rig,light in lights:
                for view in views:
                    c('loadStudy',path=str(source if isinstance(source,Path) else original));c('pause',value=True)
                    if not isinstance(source,Path):c('subject',value=('sky' if rig=='outdoor' else 'calibration') if source=='__environment__' else source)
                    sequence=None
                    if a.creature_sequence:
                        document=c('status')['state']['workshop']['document']
                        creature=document.get('creature',{});recipe=document['source'].get('motion')
                        if not recipe or creature.get('mode','bind')=='bind':raise RuntimeError('Choose a creature motion clip or behavior scenario before recording')
                        start=0 if creature['mode'] not in ['idle','behavior','bind'] else creature['seconds']
                        span=c('status')['state']['workshop']['animationDuration'] if creature['mode'] not in ['idle','behavior','bind'] else (5 if creature['mode']=='idle' else (a.motion-1)*a.step/60)
                        sequence=(start,span,document['rig'])
                    c('layout',turntable=False)
                    if light:c('lighting',value=light)
                    rig_values={k:v for k,v in sequence[2].items() if k!='name'} if sequence and sequence[2]['name']==rig else {}
                    c('rig',value=rig,**rig_values);state=c('view',value='sunward' if source=='__environment__' and rig=='outdoor' else view)['state'];orbit=state['camera']['orbit'];w=state['workshop'];key=(rig,light,view)
                    if key not in anchors:anchors[key]=(w['cameraDistanceMetres'],w['heightMetres']*w['document']['layout']['focus'])
                    elif not a.style_board and state['studioObject']!='sky':
                        distance,target=anchors[key];c('layout',focus=min(1,max(0,target/w['heightMetres'])));c('camera',metres=distance)
                    for frame in range(a.motion):
                        if frame:c('step',frames=a.step)
                        if sequence:c('creature',seconds=min(60,sequence[0]+sequence[1]*frame/(a.motion-1)))
                        if a.sweep:c('camera',orbit=orbit+frame*6.28318530718/a.motion)
                        capture(variant,light or rig,view,frame)
finally:
    try:
        if original.exists():c('loadStudy',path=str(original))
    finally:c('automation',value=False)
report=dict(version=2,records=records,original=str(original),tickSeconds=a.step/60,baseline=str(a.baseline) if a.baseline else None,reference=str(a.reference) if a.reference else None,artDirection=art)
(folder/'report.json').write_text(json.dumps(report,indent=2))
write_viewer(folder,records,art)
if not a.no_open:
    subprocess.run(['/usr/bin/open','-a',os.environ.get('WRELA_APP_BUNDLE',str(root.parent/'.build/Soundstage.app')),str(folder/'index.html')],check=True)
print(json.dumps(dict(viewer=str(folder/'index.html'),report=str(folder/'report.json'),captures=len(records))))
