#!/usr/bin/env python3
"""Run project-owned authoring checks in an isolated native app."""
import os,sys,runpy
from pathlib import Path
root=Path(__file__).resolve().parents[1]
if not os.environ.get('WRELA_CONTROL_ROOT'):
 os.execv(sys.executable,[sys.executable,str(root/'scripts/test'),'authoring','--suite','creature-tools','--game','sanctuary'])
runpy.run_path(str(root/'Games/Sanctuary/Testing/CreatureToolsAuthoring.py'),run_name='__main__')
