    let up = Event::PointerUp { at: vec2(120.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    ui.number("count", mut value, step: 0.5)
    assert(value == 13.0 && ui.editing_id() == 0)
}

@test
fn a_split_drag_uses_the_release_position() {
    var ui = Ui::new(Fonts::load())
    let down = Event::PointerDown { at: vec2(100.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.begin_split("split", Dir::Row, 0.5)
    ui.next_pane()
    ui.end_split()
    ui.end()
    let up = Event::PointerUp { at: vec2(150.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    ui.begin_split("split", Dir::Row, 0.5)
    assert(ui.fractions.get(ui.id("split")) == Some(0.75))
    ui.next_pane()
    ui.end_split()
