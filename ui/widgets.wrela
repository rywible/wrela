// An immediate-mode toolkit for user interfaces: widgets are calls a program makes each frame,
// which draw themselves and say what the person did to them. A program keeps one `Ui`, calls
// `begin` with the frame's input events, calls its widgets, calls `end`, and draws the `Ui`'s
// `draw` list (draw.wrela). Between frames the `Ui` keeps only what a person's actions leave
// behind: which widget is pressed, which has the keyboard's focus, how far each region is
// scrolled, which tree nodes are open, a text field's cursor.
//
// Layout is a stack of areas: a panel, a column or a row, a split, a scrolling region. Each
// places widgets one after another; a widget's width is what it needs, or the rest of the row
// or column.

use draw::{DrawList, Rect}
use text::{Face, Fonts, next_cluster, previous_cluster}
use std::arena::SortedMap
use std::input::{Button, Event, Key, Mods}
use std::math::is_finite

/// The toolkit's look.
pub struct Theme: Copy {
    pub size: f32 = 15.0,
    pub mono_size: f32 = 13.0,
    pub pad: f32 = 6.0,
    pub row: f32 = 24.0,
    pub spacing: f32 = 4.0,
    pub radius: f32 = 4.0,
    pub text: vec4 = vec4(0.92, 0.93, 0.95, 1.0),
    pub dim: vec4 = vec4(0.62, 0.65, 0.7, 1.0),
    pub panel: vec4 = vec4(0.11, 0.12, 0.14, 0.96),
    pub widget: vec4 = vec4(0.2, 0.22, 0.26, 1.0),
    pub hot: vec4 = vec4(0.27, 0.3, 0.36, 1.0),
    pub pressed: vec4 = vec4(0.17, 0.19, 0.23, 1.0),
    pub accent: vec4 = vec4(0.32, 0.55, 0.95, 1.0),
    pub field: vec4 = vec4(0.07, 0.08, 0.1, 1.0),
    pub focus: vec4 = vec4(0.45, 0.68, 1.0, 1.0),
    pub selection: vec4 = vec4(0.22, 0.36, 0.62, 1.0),
}

/// Which way an area places its widgets.
pub enum Dir: Copy + Eq {
    Column,
    Row,
}

/// Where a panel sits on the screen.
pub enum Anchor: Copy + Eq {
    TopLeft,
    TopRight,
    Center,
    Bottom,
}

/// An area being filled.
struct Area: Copy {
    rect: Rect,
    /// Where the next widget goes.
    cursor: vec2,
    dir: Dir,
    /// The furthest any widget reached: the content's extent, for scrolling.
    extent: vec2,
}

/// A split's state while its first pane is filled.
struct Split: Copy {
    id: u32,
    rect: Rect,
    dir: Dir,
    at: f32,
}

/// A text field being edited: its id, the cursor (a byte offset), the text before editing (for
/// Escape), and a number's text as it's typed.
struct Editing: Clone {
    id: u32,
    cursor: u32,
    before: String,
    buffer: String,
}

/// A tree's item: its label, how deep it is, and whether it has children. A tree is a list of
/// them in depth-first order.
pub struct TreeItem: Clone {
    pub label: String,
    pub depth: u32,
    pub children: bool,
}

/// FNV-1a of `text`'s bytes, then of the id stack.
fn hash(text: str, ids: [u32]) -> u32 {
    var h = 2166136261
    for i in 0..text.len() {
        h = (h ^ u32(text.byte(i))).wrapping_mul(16777619)
    }
    for x in ids {
        h = (h ^ x).wrapping_mul(16777619)
    }
    h | 1
}

pub struct Ui {
    pub theme: Theme,
    pub fonts: Fonts,
    pub draw: DrawList,
    screen: vec2,
    // This frame's input.
    pointer: vec2,
    down: bool,
    pressed: bool,
    released: bool,
    press_at: vec2,
    release_at: vec2,
    wheel: vec2,
    keys: Vec<Key>,
    mods: Mods,
    typed: Vec<u32>,
    /// For each of `keys`, how many of `typed` came before it: the order they came in.
    typed_before: Vec<u32>,
    // Ids.
    ids: Vec<u32>,
    /// The widget the pointer went down on, while it's down; the one with the keyboard.
    active: u32,
    focus: u32,
    /// The focusable widgets, in the order this frame placed them, and last frame's.
    focusable: Vec<u32>,
    last_focusable: Vec<u32>,
    /// A Tab this frame: +1 forward, -1 back.
    tab: i32,
    /// The pointer's place and the value when a drag began.
    drag_start: vec2,
    drag_value: f32,
    dragged: bool,
    // Layout.
    areas: Vec<Area>,
    splits: Vec<Split>,
    // What lasts between frames, by widget.
    scrolls: SortedMap<u32, f32>,
    opens: SortedMap<u32, bool>,
    fractions: SortedMap<u32, f32>,
    editing: Option<Editing>,
    // A drag and drop in flight, and one dropped this frame.
    payload: Option<u32>,
    dropped: Option<u32>,
    dropped_at: vec2,
    /// The last widget's id and rectangle.
    last: u32,
    last_rect: Rect,
    /// Each labelled widget this frame and last: its label's hash and rectangle (`find`).
    seen: Vec<(u32, Rect)>,
    last_seen: Vec<(u32, Rect)>,
}

impl Ui {
    pub fn new(fonts: take Fonts) -> Ui {
        Ui {
            theme: Theme {},
            fonts,
            draw: DrawList::new(),
            screen: vec2(640.0, 480.0),
            pointer: vec2(-1.0),
            down: false,
            pressed: false,
            released: false,
            press_at: vec2(-1.0),
            release_at: vec2(-1.0),
            wheel: vec2(0.0),
            keys: Vec::new(),
            mods: Mods {},
            typed: Vec::new(),
            typed_before: Vec::new(),
            ids: Vec::new(),
            active: 0,
            focus: 0,
            focusable: Vec::new(),
            last_focusable: Vec::new(),
            tab: 0,
            drag_start: vec2(0.0),
            drag_value: 0.0,
            dragged: false,
            areas: Vec::new(),
            splits: Vec::new(),
            scrolls: SortedMap::new(),
            opens: SortedMap::new(),
            fractions: SortedMap::new(),
            editing: None,
            payload: None,
            dropped: None,
            dropped_at: vec2(-1.0),
            last: 0,
            last_rect: Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 },
            seen: Vec::new(),
            last_seen: Vec::new(),
        }
    }

    // ---- frames ----------------------------------------------------------------------------

    /// Starts a frame on a screen `screen` pixels wide and high, with this frame's input
    /// events. The draw list starts empty, and the screen is one column.
    pub fn begin(mut self, screen: vec2, events: [Event]) {
        self.screen = screen
        self.draw.clear(screen)
        self.ids.clear()
        self.areas.clear()
        self.splits.clear()
        // Keep both frames' buffers: yesterday's previous frame is today's empty room.
        swap(mut self.seen, mut self.last_seen)
        self.seen.clear()
        swap(mut self.focusable, mut self.last_focusable)
        self.focusable.clear()
        self.pressed = false
        self.released = false
        self.wheel = vec2(0.0)
        self.keys.clear()
        self.typed.clear()
        self.typed_before.clear()
        self.tab = 0
        self.dropped = None
        for e in events {
            match e {
                Event::PointerMove { at, mods } => {
                    self.pointer = at
                    self.mods = mods
                },
                Event::PointerDown { at, button, mods } => {
                    self.pointer = at
                    self.mods = mods
                    if button == Button::Primary {
                        self.down = true
                        self.pressed = true
                        self.press_at = at
                    }
                },
                Event::PointerUp { at, button, mods } => {
                    self.pointer = at
                    self.mods = mods
                    if button == Button::Primary {
                        self.down = false
                        self.released = true
                        self.release_at = at
                    }
                },
                Event::Wheel { at, delta, mods } => {
                    self.pointer = at
                    self.wheel += delta
                    self.mods = mods
                },
                Event::KeyDown { key, mods, .. } => {
                    self.mods = mods
                    if key == Key::Tab {
                        self.tab = if mods.shift { -1 } else { 1 }
                    } else {
                        self.keys.push(key)
                        self.typed_before.push(self.typed.len())
                    }
                },
                Event::KeyUp { mods, .. } => {
                    self.mods = mods
                },
                Event::Text { char } => {
                    if char >= 32 && char != 127 {
                        self.typed.push(char)
                    }
                },
                // Pads, input methods, pastes, assistive actions and the network don't drive
                // the widgets.
                Event::PadButton { .. } | Event::PadAxis { .. } => {},
                Event::Compose { .. } | Event::Paste { .. } | Event::Assist { .. } => {},
                Event::Message { .. } | Event::Connection { .. } | Event::Field { .. } => {},
            }
        }
        if self.released {
            if let Some(payload) = self.payload {
                self.dropped = Some(payload)
                self.dropped_at = self.release_at
                self.payload = None
            }
        }
        // Tab moves the focus along last frame's order.
        if self.tab != 0 && self.last_focusable.len() > 0 {
            let n = i32(self.last_focusable.len())
            var at = -1
            for i in 0..self.last_focusable.len() {
                if self.last_focusable[i] == self.focus {
                    at = i32(i)
                }
            }
            let next = if at < 0 { if self.tab > 0 { 0 } else { n - 1 } } else {
                (at + self.tab + n) % n
            }
            self.focus = self.last_focusable[u32(next)]
            self.end_editing()
        }
        if self.pressed {
            // A press on nothing focusable takes the focus away; a widget pressed takes it.
            self.focus = 0
        }
        if self.key(Key::Escape) && self.editing.is_none() {
            self.focus = 0
        }
        self.begin_area(Rect { x: 0.0, y: 0.0, w: screen.x, h: screen.y }, Dir::Column)
    }

    /// Ends a frame: what's let go of is let go.
    pub fn end(mut self) {
        if !self.down {
            self.active = 0
            self.dragged = false
        }
        if self.editing_id() != self.focus {
            self.end_editing()
        }
    }

    /// Whether `key` went down this frame.
    pub fn key(self, key: Key) -> bool {
        for k in self.keys {
            if k == key {
                return true
            }
        }
        false
    }

    /// The modifier keys held.
    pub fn mods(self) -> Mods {
        self.mods
    }

    /// Where the pointer is.
    pub fn pointer(self) -> vec2 {
        self.pointer
    }

    /// Whether the primary button is down, went down this frame, or came up this frame.
    pub fn pointer_down(self) -> bool {
        self.down
    }

    pub fn pointer_pressed(self) -> bool {
        self.pressed
    }

    pub fn pointer_released(self) -> bool {
        self.released
    }

    fn drag_pointer(self) -> vec2 {
        if self.down { self.pointer } else { self.release_at }
    }

    /// The wheel's scroll this frame, in pixels.
    pub fn wheel(self) -> vec2 {
        self.wheel
    }

    /// Whether a widget has the pointer pressed on it, or the keyboard's focus.
    pub fn busy(self) -> bool {
        self.active != 0 || self.focus != 0
    }

    pub fn screen(self) -> vec2 {
        self.screen
    }

    // ---- ids -------------------------------------------------------------------------------

    /// Tells apart widgets with the same label, until `pop_id`.
    pub fn push_id(mut self, id: u32) {
        self.ids.push(id)
    }

    pub fn pop_id(mut self) {
        let _ = self.ids.pop()
    }

    /// The id of a widget labelled `label` here.
    pub fn id(self, label: str) -> u32 {
        hash(label, self.ids)
    }

    /// Where the widget labelled `label` was last frame: for tests that drive the UI as a
    /// person would.
    pub fn find(self, label: str) -> Option<Rect> {
        let h = hash(label, [0; 0])
        for s in self.last_seen {
            if s.0 == h {
                return Some(s.1)
            }
        }
        None
    }

    fn note(mut self, label: str, r: Rect) {
        self.seen.push((hash(label, [0; 0]), r))
    }

    // ---- layout ----------------------------------------------------------------------------

    fn area(self) -> Area {
        self.areas[self.areas.len() - 1]
    }

    /// The room left in the area: from its cursor to its right and bottom edges.
    pub fn room(self) -> vec2 {
        let a = self.area()
        vec2(a.rect.right() - a.cursor.x, a.rect.bottom() - a.cursor.y)
    }

    /// The area's rectangle.
    pub fn area_rect(self) -> Rect {
        self.area().rect
    }

    /// Places a widget `size` big (a width of 0 fills the room across a column, a height of 0
    /// the room down a row): its rectangle.
    pub fn place(mut self, size: vec2) -> Rect {
        let i = self.areas.len() - 1
        let a = self.areas[i]
        let s = self.theme.spacing
        let r = match a.dir {
            Dir::Column => {
                let w = if size.x > 0.0 { size.x } else { a.rect.right() - a.cursor.x }
                Rect::new(a.cursor.x, a.cursor.y, w, size.y)
            },
            Dir::Row => {
                let h = if size.y > 0.0 { size.y } else { a.rect.bottom() - a.cursor.y }
                Rect::new(a.cursor.x, a.cursor.y, size.x, h)
            },
        }
        var next = a
        match a.dir {
            Dir::Column => next.cursor.y += r.h + s,
            Dir::Row => next.cursor.x += r.w + s,
        }
        next.extent = max(a.extent, vec2(r.right(), r.bottom()))
        self.areas[i] = next
        self.last_rect = r
        r
    }

    /// Skips `d` pixels along the area.
    pub fn space(mut self, d: f32) {
        let i = self.areas.len() - 1
        match self.areas[i].dir {
            Dir::Column => self.areas[i].cursor.y += d,
            Dir::Row => self.areas[i].cursor.x += d,
        }
    }

    /// Fills `r` with an area placing widgets `dir`-wise, until `end_area`.
    pub fn begin_area(mut self, r: Rect, dir: Dir) {
        self.areas.push(Area { rect: r, cursor: vec2(r.x, r.y), dir, extent: vec2(r.x, r.y) })
    }

    pub fn end_area(mut self) {
        let a = self.areas.pop()
        // What it held reaches the area around it.
        if let Some(inner) = a {
            let i = self.areas.len() - 1
            self.areas[i].extent = max(self.areas[i].extent, inner.extent)
        }
    }

    /// A row `height` pixels tall (0: a widget row's) across the area: widgets go left to
    /// right until `end_row`.
    pub fn begin_row(mut self, height: f32 = 0.0) {
        let h = if height > 0.0 { height } else { self.theme.row }
        let r = self.place(vec2(0.0, h))
        self.begin_area(r, Dir::Row)
    }

    pub fn end_row(mut self) {
        self.end_area()
    }

    /// A column `width` pixels wide (0: the room left) in a row: widgets go top to bottom
    /// until `end_column`.
    pub fn begin_column(mut self, width: f32 = 0.0) {
        let w = if width > 0.0 { width } else { self.room().x }
        let r = self.place(vec2(w, 0.0))
        self.begin_area(r, Dir::Column)
    }

    pub fn end_column(mut self) {
        self.end_area()
    }

    /// A panel at `r`: its background, a title if `title` isn't empty, and a column inside
    /// it, until `end_panel`.
    pub fn begin_panel(mut self, title: str, r: Rect) {
        let t = self.theme
        let clip = self.draw.clip_rect()
        if self.pressed && r.contains(self.press_at) && clip.contains(self.press_at) {
            // Forget a widget placed below the panel; one inside it may claim the press next.
            self.active = 0
            self.focus = 0
            self.payload = None
        }
        self.draw.rect(r, t.panel, t.radius)
        var inner = r.shrink(t.pad)
        if title.len() > 0 {
            self.draw.text(self.fonts, Face::Sans, title, t.size, vec2(inner.x, inner.y), t.dim)
            inner = Rect::new(inner.x, inner.y + t.row, inner.w, max(inner.h - t.row, 0.0))
        }
        self.note(title, r)
        // A press on a panel isn't a press on what's under it.
        self.begin_area(inner, Dir::Column)
        self.draw.push_clip(r)
    }

    /// A panel `width` × `height` at `at`.
    pub fn panel(mut self, title: str, at: Anchor, width: f32, height: f32) {
        let s = self.screen
        let p = match at {
            Anchor::TopLeft => vec2(10.0, 10.0),
            Anchor::TopRight => vec2(s.x - width - 10.0, 10.0),
            Anchor::Center => 0.5 * (s - vec2(width, height)),
            Anchor::Bottom => vec2(0.5 * (s.x - width), s.y - height - 10.0),
        }
        self.begin_panel(title, Rect::new(p.x, p.y, width, height))
    }

    pub fn end_panel(mut self) {
        self.draw.pop_clip()
        self.end_area()
    }

    /// Splits the area `dir`-wise (`Row`: side by side) at `initial` of its size (0 to 1), or
    /// where the person last dragged the divider. The first pane is filled now; `next_pane`
    /// starts the second, and `end_split` ends both.
    pub fn begin_split(mut self, label: str, dir: Dir, initial: f32) {
        let id = self.id(label)
        let r = if self.area().dir == Dir::Column {
            self.place(vec2(0.0, self.room().y))
        } else {
            self.place(vec2(self.room().x, 0.0))
        }
        let full = if dir == Dir::Row { r.w } else { r.h }
        var f = self.fractions.get(id).unwrap_or(initial)
        // The divider, 6 pixels across.
        let at = floor(clamp(f, 0.0, 1.0) * full)
        let div = if dir == Dir::Row { Rect::new(r.x + at - 3.0, r.y, 6.0, r.h) } else {
            Rect::new(r.x, r.y + at - 3.0, r.w, 6.0)
        }
        if self.pressed &&
            div.contains(self.press_at) &&
            self.draw.clip_rect().contains(self.press_at) {
            self.active = id
        }
        if self.active == id && (self.down || self.released) {
            let at = self.drag_pointer()
            let p = if dir == Dir::Row { at.x - r.x } else { at.y - r.y }
            f = clamp(p / max(full, 1.0), 0.05, 0.95)
            let _ = self.fractions.insert(id, f)
        }
        let at = floor(clamp(f, 0.0, 1.0) * full)
        let color = if self.active == id || div.contains(self.pointer) { self.theme.accent } else {
            self.theme.widget
        }
        let line = if dir == Dir::Row { Rect::new(r.x + at - 1.0, r.y, 2.0, r.h) } else {
            Rect::new(r.x, r.y + at - 1.0, r.w, 2.0)
        }
        self.draw.rect(line, color)
        self.splits.push(Split { id, rect: r, dir, at })
        let first = if dir == Dir::Row { Rect::new(r.x, r.y, at - 4.0, r.h) } else {
            Rect::new(r.x, r.y, r.w, at - 4.0)
        }
        self.begin_area(first, Dir::Column)
        self.draw.push_clip(first)
    }

    pub fn next_pane(mut self) {
        self.draw.pop_clip()
        self.end_area()
        let s = self.splits[self.splits.len() - 1]
        let r = s.rect
        let second = if s.dir == Dir::Row {
            Rect::new(r.x + s.at + 4.0, r.y, r.w - s.at - 4.0, r.h)
        } else {
            Rect::new(r.x, r.y + s.at + 4.0, r.w, r.h - s.at - 4.0)
        }
        self.begin_area(second, Dir::Column)
        self.draw.push_clip(second)
    }

    pub fn end_split(mut self) {
        self.draw.pop_clip()
        self.end_area()
        let _ = self.splits.pop()
    }

    /// A region `height` pixels tall (0: the room left) whose content scrolls: the wheel over
    /// it, or its bar dragged. Widgets go top to bottom until `end_scroll`.
    pub fn begin_scroll(mut self, label: str, height: f32 = 0.0) {
        let id = self.id(label)
        let h = if height > 0.0 { height } else { self.room().y }
        let r = self.place(vec2(0.0, h))
        self.note(label, r)
        var y = self.scrolls.get(id).unwrap_or(0.0)
        if r.contains(self.pointer) &&
            self.draw.clip_rect().contains(self.pointer) &&
            self.wheel.y != 0.0 {
            y += self.wheel.y
            self.wheel = vec2(0.0)
        }
        y = max(y, 0.0)
        let content = Rect::new(r.x, r.y - y, r.w - 8.0, 100000.0)
        self.draw.push_clip(r)
        self.begin_area(content, Dir::Column)
        // The view's rectangle and the scroll it's drawn with, for `end_scroll`.
        self.splits.push(Split { id, rect: r, dir: Dir::Column, at: y })
    }

    pub fn end_scroll(mut self) {
        let a = self.areas.pop()
        self.draw.pop_clip()
        let Some(view) = self.splits.pop() else { return }
        let Some(a) = a else { return }
        let r = view.rect
        // The content's height: how far the widgets reached below its top.
        let height = a.extent.y - a.rect.y
        let most = max(height - r.h, 0.0)
        var y = clamp(view.at, 0.0, most)
        // The bar: dragged to scroll.
        if most > 0.0 {
            let bar_h = min(max(r.h * r.h / height, 20.0), r.h)
            let track = Rect::new(r.right() - 6.0, r.y, 6.0, r.h)
            let bar_id = view.id ^ 2654435761
            if self.pressed &&
                track.contains(self.press_at) &&
                self.draw.clip_rect().contains(self.press_at) {
                self.active = bar_id
                self.drag_start = self.press_at
                self.drag_value = y
            }
            if self.active == bar_id && (self.down || self.released) {
                y = clamp(
                    self.drag_value +
                        (self.drag_pointer().y - self.drag_start.y) * most / max(r.h - bar_h, 1.0),
                    0.0,
                    most,
                )
            }
            let bar_y = r.y + (r.h - bar_h) * y / most
            self.draw.rect(Rect::new(r.right() - 5.0, bar_y, 4.0, bar_h), self.theme.hot, 2.0)
        }
        let _ = self.scrolls.insert(view.id, y)
        self.last_rect = r
    }

    /// Scrolls the region `label` so that content at `y` (from its top) is in view.
    pub fn scroll_to(mut self, label: str, y: f32) {
        let id = self.id(label)
        let _ = self.scrolls.insert(id, max(y, 0.0))
    }

    // ---- interaction -----------------------------------------------------------------------

    /// What the pointer and keys do to a widget at `r`: whether it's hovered, and whether it was
    /// clicked (pressed and released on it, or Enter or Space while it has the focus).
    fn interact(mut self, id: u32, r: Rect, focusable: bool) -> (bool, bool) {
        if focusable {
            self.focusable.push(id)
        }
        let clip = self.draw.clip_rect()
        let over = r.contains(self.pointer) && clip.contains(self.pointer)
        if self.pressed && r.contains(self.press_at) && clip.contains(self.press_at) {
            self.active = id
            self.drag_start = self.press_at
            self.dragged = false
            if focusable {
                self.focus = id
            }
        }
        if self.editing_id() == id && self.focus != id {
            self.end_editing()
        }
        var clicked = self.released &&
            self.active == id &&
            r.contains(self.release_at) &&
            clip.contains(self.release_at)
        if focusable && self.focus == id && (self.key(Key::Enter) || self.key(Key::Space)) {
            clicked = true
        }
        self.last = id
        (over, clicked)
    }

    /// Whether a widget at `r` is more than its own height above or below the clipping
    /// rectangle, so nothing drawn for it shows (its text reaches past it less than that).
    fn hidden(self, r: Rect) -> bool {
        let c = self.draw.clip_rect()
        r.bottom() + r.h <= c.y || r.y - r.h >= c.bottom()
    }

    fn widget_color(self, id: u32, over: bool) -> vec4 {
        if self.active == id && self.down { self.theme.pressed } else if over {
            self.theme.hot
        } else {
            self.theme.widget
        }
    }

    fn focus_ring(mut self, id: u32, r: Rect) {
        if self.focus == id {
            self.draw.frame(r, self.theme.focus, 1.5)
        }
    }

    /// Whether the pointer is on the last widget.
    pub fn hovered(self) -> bool {
        self.last_rect.contains(self.pointer) && self.draw.clip_rect().contains(self.pointer)
    }

    /// The last widget's rectangle.
    pub fn last_rect(self) -> Rect {
        self.last_rect
    }

    /// Whether the widget with id `id` has the keyboard's focus.
    pub fn focused(self, id: u32) -> bool {
        self.focus == id
    }

    /// Gives the keyboard's focus to the widget with id `id`.
    pub fn set_focus(mut self, id: u32) {
        self.focus = id
    }

    // ---- widgets ---------------------------------------------------------------------------

    /// `text`, on a widget row.
    pub fn label(mut self, text: str) {
        let t = self.theme
        let w = self.fonts.sans.measure(text, t.size)
        let r = self.place(vec2(w + 2.0 * t.pad, t.row))
        self.note(text, r)
        self.draw_label(text, r, t.text)
    }

    /// `text` dimmed.
    pub fn note_text(mut self, text: str) {
        let t = self.theme
        let w = self.fonts.sans.measure(text, t.size)
        let r = self.place(vec2(w + 2.0 * t.pad, t.row))
        self.draw_label(text, r, t.dim)
    }

    /// `text` in the monospace font.
    pub fn mono(mut self, text: str, color: vec4) {
        let t = self.theme
        let w = self.fonts.mono.measure(text, t.mono_size)
        let r = self.place(vec2(w + 2.0 * t.pad, t.mono_size * 1.4))
        let y = r.y + 0.5 * (r.h - self.fonts.mono.line_height(t.mono_size))
        let _ = self.draw.text(
            self.fonts,
            Face::Mono,
            text,
            t.mono_size,
            vec2(r.x + t.pad, y),
            color,
        )
    }

    fn draw_label(mut self, text: str, r: Rect, color: vec4) {
        let t = self.theme
        let y = r.y + 0.5 * (r.h - self.fonts.sans.line_height(t.size))
        let _ = self.draw.text(self.fonts, Face::Sans, text, t.size, vec2(r.x + t.pad, y), color)
    }

    /// A button: true on the frame it's clicked.
    pub fn button(mut self, text: str) -> bool {
        let t = self.theme
        let id = self.id(text)
        let w = self.fonts.sans.measure(text, t.size)
        let r = self.place(vec2(w + 4.0 * t.pad, t.row))
        self.note(text, r)
        let (over, clicked) = self.interact(id, r, focusable: true)
        self.draw.rect(r, self.widget_color(id, over), t.radius)
        self.focus_ring(id, r)
        let y = r.y + 0.5 * (r.h - self.fonts.sans.line_height(t.size))
        self.draw.text(self.fonts, Face::Sans, text, t.size, vec2(r.x + 2.0 * t.pad, y), t.text)
        clicked
    }

    /// A toggle: a click (or Enter or Space while focused) flips `value`. True if it changed.
    pub fn toggle(mut self, text: str, value: mut bool) -> bool {
        let t = self.theme
        let id = self.id(text)
        let w = self.fonts.sans.measure(text, t.size)
        let r = self.place(vec2(w + t.row + 2.0 * t.pad, t.row))
        self.note(text, r)
        let (over, clicked) = self.interact(id, r, focusable: true)
        if clicked {
            value = !value
        }
        let b = Rect::new(r.x + 3.0, r.y + 3.0, t.row - 6.0, t.row - 6.0)
        self.draw.rect(b, self.widget_color(id, over), t.radius)
        if value {
            self.draw.rect(b.shrink(4.0), t.accent, 2.0)
        }
        self.focus_ring(id, b)
        let y = r.y + 0.5 * (r.h - self.fonts.sans.line_height(t.size))
        self.draw.text(self.fonts, Face::Sans, text, t.size, vec2(r.x + t.row + t.pad, y), t.text)
        clicked
    }

    /// A slider from `lo` to `hi`: dragged, or stepped by the arrow keys while focused (a
    /// hundredth of the range, a tenth with Shift). True if it changed.
    pub fn slider(mut self, text: str, value: mut f32, lo: f32, hi: f32) -> bool {
        let t = self.theme
        let id = self.id(text)
        let r = self.place(vec2(0.0, t.row))
        self.note(text, r)
        let (over, _) = self.interact(id, r, focusable: true)
        let before = value
        if self.active == id && (self.down || self.released) {
            let f = clamp((self.drag_pointer().x - r.x) / max(r.w, 1.0), 0.0, 1.0)
            value = mix(lo, hi, f)
        }
        if self.focus == id {
            let step = (hi - lo) * (if self.mods.shift { 0.1 } else { 0.01 })
            if self.key(Key::Right) || self.key(Key::Up) {
                value = min(value + step, hi)
            }
            if self.key(Key::Left) || self.key(Key::Down) {
                value = max(value - step, lo)
            }
        }
        let f = if hi != lo { clamp((value - lo) / (hi - lo), 0.0, 1.0) } else { 0.0 }
        self.draw.rect(r, self.widget_color(id, over), t.radius)
        self.draw.rect(Rect::new(r.x, r.y, r.w * f, r.h), t.selection, t.radius)
        self.focus_ring(id, r)
        self.draw_label(f"{text}: {value:.2}", r, t.text)
        value != before
    }

    /// A number: dragged sideways (`step` a pixel), stepped by the arrow keys while focused,
    /// or typed after a click (Enter keeps it, Escape doesn't). True if it changed.
    pub fn number(mut self, text: str, value: mut f32, step: f32) -> bool {
        let t = self.theme
        let id = self.id(text)
        let label_w = self.fonts.sans.measure(text, t.size) + 2.0 * t.pad
        let r = self.place(vec2(0.0, t.row))
        self.note(text, r)
        let field = Rect::new(r.x + label_w, r.y, max(r.w - label_w, 40.0), r.h)
        let editing = self.editing_id() == id
        let (over, clicked) = self.interact(id, field, focusable: true)
        let before = value
        if self.active == id && (self.down || self.released) && !editing {
            if self.pressed {
                self.drag_value = value
            }
            let dx = self.drag_pointer().x - self.drag_start.x
            if abs(dx) > 3.0 {
                self.dragged = true
            }
            if self.dragged {
                value = self.drag_value + dx * step
            }
        }
        if clicked && !self.dragged && !editing {
            self.start_editing(id, f"{value}")
        }
        if self.focus == id && !editing {
            if self.key(Key::Up) || self.key(Key::Right) {
                value += step * (if self.mods.shift { 10.0 } else { 1.0 })
            }
            if self.key(Key::Down) || self.key(Key::Left) {
                value -= step * (if self.mods.shift { 10.0 } else { 1.0 })
            }
        }
        self.draw_label(text, Rect::new(r.x, r.y, label_w, r.h), t.dim)
        if self.editing_id() == id {
            var s = self.edit_buffer()
            let done = self.edit_keys(id, mut s)
            if done == 1 {
                if let Some(v) = s.as_str().parse_f32() {
                    value = v
                }
            }
            self.draw.rect(field, t.field, t.radius)
            self.draw_edit(field, s.as_str())
            self.store_edit(take s)
        } else {
            self.draw.rect(field, self.widget_color(id, over), t.radius)
            self.draw_label(f"{value:.3}", field, t.text)
        }
        self.focus_ring(id, field)
        value != before
    }

    /// A single line of text to edit: click it (or Tab to it), type, and Enter or a click
    /// elsewhere keeps the text; Escape puts it back. True when the text changed this frame.
    pub fn text_field(mut self, text: str, value: mut String) -> bool {
        let t = self.theme
        let id = self.id(text)
        let label_w = self.fonts.sans.measure(text, t.size) + 2.0 * t.pad
        let r = self.place(vec2(0.0, t.row))
        self.note(text, r)
        let field = Rect::new(r.x + label_w, r.y, max(r.w - label_w, 40.0), r.h)
        let (over, clicked) = self.interact(id, field, focusable: true)
        if self.focus == id && self.editing_id() != id {
            self.start_editing(id, value.as_str())
        }
        self.draw_label(text, Rect::new(r.x, r.y, label_w, r.h), t.dim)
        var changed = false
        if self.editing_id() == id {
            if clicked {
                // A click puts the cursor under the pointer.
                let x = self.release_at.x - field.x - t.pad
                let at = self.fonts.sans.offset_at(value.as_str(), t.size, x)
                self.set_cursor(at)
            }
            let original = self.edit_original()
            let before = value.clone()
            let done = self.edit_keys(id, mut value)
            if done == 2 {
                value = take original
            }
            changed = value.as_str() != before.as_str()
            self.draw.rect(field, t.field, t.radius)
            self.draw_edit(field, value.as_str())
        } else {
            self.draw.rect(field, if over { t.hot } else { t.field }, t.radius)
            self.draw_label(value.as_str(), field, t.text)
        }
        self.focus_ring(id, field)
        changed
    }

    // ---- editing text ------------------------------------------------------------------------

    fn editing_id(self) -> u32 {
        if let Some(e) = self.editing { e.id } else { 0 }
    }

    fn start_editing(mut self, id: u32, text: str) {
        self.end_editing()
        self.editing = Some(
            Editing { id, cursor: text.len(), before: text.to_string(), buffer: text.to_string() },
        )
        self.focus = id
    }

    /// Stops editing.
    fn end_editing(mut self) {
        self.editing = None
    }

    /// The text when editing began.
    fn edit_original(self) -> String {
        if let Some(e) = self.editing { e.before.clone() } else { String::new() }
    }

    /// A number's text, as typed so far.
    fn edit_buffer(self) -> String {
        if let Some(e) = self.editing { e.buffer.clone() } else { String::new() }
    }

    fn store_edit(mut self, s: take String) {
        match mut self.editing {
            Some(e) => e.buffer = take s,
            None => {},
        }
    }

    fn set_cursor(mut self, at: u32) {
        match mut self.editing {
            Some(e) => e.cursor = at,
            None => {},
        }
    }

    fn cursor(self) -> u32 {
        if let Some(e) = self.editing { e.cursor } else { 0 }
    }

    /// Applies this frame's typing and editing keys to `s`, the text being edited: 0 still
    /// editing, 1 Enter (kept), 2 Escape (put back).
    fn edit_keys(mut self, id: u32, s: mut String) -> u32 {
        var cursor = min(self.cursor(), s.len())
        var done = 0
        // The typing and the keys in the order they came: each key after the text typed before
        // it (`typed_before`), then the text typed after the last.
        var t = 0
        for j in 0..self.keys.len() + 1 {
            let upto = if j < self.keys.len() { self.typed_before[j] } else { self.typed.len() }
            if t < upto {
                // One uninterrupted run of typing shares one saved tail; keys still split runs.
                let tail = s.as_str().slice(cursor, s.len()).to_string()
                s.truncate(cursor)
                while t < upto {
                    s.push_char(self.typed[t])
                    t += 1
                }
                cursor = s.len()
                s.push_str(tail.as_str())
            }
            if j == self.keys.len() {
                break
            }
            match self.keys[j] {
                Key::Backspace => {
                    if cursor > 0 {
                        let from = previous_cluster(s.as_str(), cursor)
                        let tail = s.as_str().slice(cursor, s.len()).to_string()
                        s.truncate(from)
                        s.push_str(tail.as_str())
                        cursor = from
                    }
                },
                Key::Delete => {
                    if cursor < s.len() {
                        let next = next_cluster(s.as_str(), cursor)
                        let tail = s.as_str().slice(next, s.len()).to_string()
                        s.truncate(cursor)
                        s.push_str(tail.as_str())
                    }
                },
                Key::Left => {
                    cursor = previous_cluster(s.as_str(), cursor)
                },
                Key::Right => {
                    if cursor < s.len() {
                        cursor = next_cluster(s.as_str(), cursor)
                    }
                },
                Key::Home => cursor = 0,
                Key::End => cursor = s.len(),
                Key::Enter => done = 1,
                Key::NumpadEnter => done = 1,
                Key::Escape => done = 2,
                _ => {},
            }
        }
        self.set_cursor(cursor)
        if done != 0 {
            self.editing = None
            self.focus = if done == 1 { id } else { 0 }
        }
        done
    }

    /// The text being edited in `field`, with its cursor.
    fn draw_edit(mut self, field: Rect, s: str) {
        let t = self.theme
        let y = field.y + 0.5 * (field.h - self.fonts.sans.line_height(t.size))
        self.draw.push_clip(field)
        self.draw.text(self.fonts, Face::Sans, s, t.size, vec2(field.x + t.pad, y), t.text)
        let c = min(self.cursor(), s.len())
        let x = field.x + t.pad + self.fonts.sans.caret_at(s, t.size, c)
        self.draw.rect(Rect::new(x, field.y + 4.0, 1.5, field.h - 8.0), t.focus)
        self.draw.pop_clip()
    }

    // ---- lists and trees ---------------------------------------------------------------------

    /// A row that can be selected: true when it's clicked.
    pub fn selectable(mut self, text: str, selected: bool) -> bool {
        let t = self.theme
        let r = self.place(vec2(0.0, t.row))
        self.note(text, r)
        if self.hidden(r) {
            // Scrolled out of view: nothing of it shows, and the pointer can't reach it.
            return false
        }
        let id = self.id(text)
        let (over, clicked) = self.interact(id, r, focusable: false)
        if selected {
            self.draw.rect(r, t.selection, t.radius)
        } else if over {
            self.draw.rect(r, t.hot, t.radius)
        }
        self.draw_label(text, r, t.text)
        clicked
    }

    /// A list of `items`, `height` pixels tall, scrolling: a click selects an item, and while
    /// the list has the focus, Up and Down move the selection. `selected` is an index, or -1.
    /// True if the selection changed.
    pub fn list(mut self, label: str, items: [String], selected: mut i32, height: f32) -> bool {
        let id = self.id(label)
        self.focusable.push(id)
        let before = selected
        if self.focus == id && items.len() > 0 {
            if self.key(Key::Down) {
                selected = min(selected + 1, i32(items.len()) - 1)
            }
            if self.key(Key::Up) {
                selected = max(selected - 1, 0)
            }
        }
        self.begin_scroll(label, height)
        self.push_id(id)
        for i in 0..items.len() {
            self.push_id(i)
            if self.selectable(items[i].as_str(), selected == i32(i)) {
                selected = i32(i)
                self.focus = id
            }
            self.pop_id()
        }
        self.pop_id()
        self.end_scroll()
        let r = self.last_rect
        self.focus_ring(id, r)
        selected != before
    }

    /// A tree of `items` (depth first), `height` pixels tall, scrolling. A click on an item
    /// selects it, and one on its arrow opens or closes it; while the tree has the focus, Up and
    /// Down move the selection among the items shown, and Right and Left open and close the
    /// selected one. `selected` is an index into `items`, or -1. True if the selection changed.
    pub fn tree(mut self, label: str, items: [TreeItem], selected: mut i32, height: f32) -> bool {
        let id = self.id(label)
        self.focusable.push(id)
        let before = selected
        // Which items show: those whose ancestors are all open.
        var shown: Vec<u32> = Vec::new()
        var hide_below = 4294967295
        for i in 0..items.len() {
            let d = items[i].depth
            if d <= hide_below {
                hide_below = 4294967295
                shown.push(i)
                if items[i].children && !self.is_open(id, i) {
                    hide_below = d
                }
            }
        }
        if self.focus == id && shown.len() > 0 {
            var at = -1
            for k in 0..shown.len() {
                if i32(shown[k]) == selected {
                    at = i32(k)
                }
            }
            if self.key(Key::Down) {
                selected = i32(shown[min(u32(at + 1), shown.len() - 1)])
            }
            if self.key(Key::Up) {
                selected = i32(shown[if at < 0 { shown.len() - 1 } else if at > 0 {
                    u32(at - 1)
                } else {
                    0
                }])
            }
            if selected >= 0 && u32(selected) < items.len() && items[u32(selected)].children {
                if self.key(Key::Right) {
                    self.set_open(id, u32(selected), open: true)
                }
                if self.key(Key::Left) {
                    self.set_open(id, u32(selected), open: false)
                }
            }
        }
        let t = self.theme
        self.begin_scroll(label, height)
        self.push_id(id)
        for k in 0..shown.len() {
            let i = shown[k]
            borrow item = items[i]
            self.push_id(i)
            let r = self.place(vec2(0.0, t.row))
            self.note(item.label.as_str(), r)
            let row_id = self.id(item.label.as_str())
            let (over, clicked) = self.interact(row_id, r, focusable: false)
            let indent = 14.0 * f32(item.depth)
            let arrow = Rect::new(r.x + indent, r.y, 16.0, r.h)
            if selected == i32(i) {
                self.draw.rect(r, t.selection, t.radius)
            } else if over {
                self.draw.rect(r, t.hot, t.radius)
            }
            if item.children {
                let open = self.is_open(id, i)
                self.draw_label(if open { "-" } else { "+" }, arrow, t.dim)
                if clicked && arrow.contains(self.release_at) {
                    self.set_open(id, i, !open)
                }
            }
            if clicked {
                selected = i32(i)
                self.focus = id
            }
            self.draw_label(
                item.label.as_str(),
                Rect::new(r.x + indent + 14.0, r.y, r.w, r.h),
                t.text,
            )
            self.pop_id()
        }
        self.pop_id()
        self.end_scroll()
        let r = self.last_rect
        self.focus_ring(id, r)
        selected != before
    }

    fn is_open(self, tree: u32, item: u32) -> bool {
        self.opens.get(tree ^ item.wrapping_mul(2654435761)).unwrap_or(false)
    }

    fn set_open(mut self, tree: u32, item: u32, open: bool) {
        let _ = self.opens.insert(tree ^ item.wrapping_mul(2654435761), open)
    }

    /// Opens or closes item `item` of the tree `label`.
    pub fn open(mut self, label: str, item: u32, open: bool) {
        let id = self.id(label)
        self.set_open(id, item, open)
    }

    // ---- the rest -------------------------------------------------------------------------------

    /// A bar `fill` (0 to 1) full.
    pub fn bar(mut self, fill: f32, color: vec4) {
        let r = self.place(vec2(0.0, 10.0))
        self.draw.rect(r, vec4(0.0, 0.0, 0.0, 0.6), 3.0)
        self.draw.rect(Rect::new(r.x, r.y, r.w * clamp(fill, 0.0, 1.0), r.h), color, 3.0)
    }

    /// A box by the pointer showing `text`.
    pub fn tooltip(mut self, text: str) {
        let t = self.theme
        let w = self.fonts.sans.measure(text, t.size) + 2.0 * t.pad
        let at = self.pointer + vec2(12.0, 12.0)
        let r = Rect::new(at.x, at.y, w, t.row)
        self.draw.push_clip(Rect { x: 0.0, y: 0.0, w: self.screen.x, h: self.screen.y })
        self.draw.rect(r, t.panel, t.radius)
        self.draw_label(text, r, t.text)
        self.draw.pop_clip()
    }

    /// Dragging starts at the last widget when the pointer goes down on it, carrying
    /// `payload`.
    pub fn drag_source(mut self, payload: u32) {
        if self.pressed &&
            self.last_rect.contains(self.press_at) &&
            self.draw.clip_rect().contains(self.press_at) {
            if self.released && !self.down {
                self.dropped = Some(payload)
                self.dropped_at = self.release_at
                self.payload = None
            } else {
                self.payload = Some(payload)
            }
        }
    }

    /// A payload dropped on the last widget this frame.
    pub fn dropped(mut self) -> Option<u32> {
        if self.last_rect.contains(self.dropped_at) &&
            self.draw.clip_rect().contains(self.dropped_at) {
            if let Some(payload) = self.dropped {
                self.dropped = None
                return Some(payload)
            }
        }
        None
    }
}

// ---- tests ------------------------------------------------------------------------------------

@test
fn drag_and_drop_handles_a_press_and_release_in_one_frame() {
    var ui = Ui::new(Fonts::load())
    ui.begin(
        vec2(200.0),
        [
            Event::PointerDown { at: vec2(10.0), button: Button::Primary, mods: Mods {} },
            Event::PointerUp { at: vec2(10.0, 40.0), button: Button::Primary, mods: Mods {} },
        ],
    )
    ui.label("source")
    ui.drag_source(12)
    ui.label("target")
    assert(ui.dropped() == Some(12))
    assert(ui.payload.is_none())
    ui.end()
}

@test
fn text_editing_moves_and_deletes_whole_character_groups() {
    var ui = Ui::new(Fonts::load())
    let id = ui.id("text")
    let original = "éx"
    var value = String::from(original)
    ui.start_editing(id, original)
    ui.set_cursor(0)
    let right = Event::KeyDown { key: Key::Right, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [right])
    let _ = ui.edit_keys(id, mut value)
    assert(ui.cursor() == 3, "Right moves past the letter and its accent")
    let left = Event::KeyDown { key: Key::Left, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [left])
    let _ = ui.edit_keys(id, mut value)
    assert(ui.cursor() == 0, "Left moves back over the same group")
    let delete = Event::KeyDown { key: Key::Delete, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [delete])
    let _ = ui.edit_keys(id, mut value)
    assert(value == "x", "Delete removes the whole next group")

    value = String::from(original)
    ui.start_editing(id, original)
    ui.set_cursor(3)
    let backspace = Event::KeyDown { key: Key::Backspace, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [backspace])
    let _ = ui.edit_keys(id, mut value)
    assert(value == "x" && ui.cursor() == 0, "Backspace removes the whole previous group")
}

@test
fn a_slider_uses_the_release_position_and_accepts_a_quick_click() {
    var ui = Ui::new(Fonts::load())
    var value = 0.0
    let down = Event::PointerDown { at: vec2(20.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.slider("level", mut value, lo: 0.0, hi: 1.0)
    ui.end()
    let up = Event::PointerUp { at: vec2(160.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    ui.slider("level", mut value, lo: 0.0, hi: 1.0)
    assert(abs(value - 0.8) < 0.00001)
    ui.end()

    value = 0.0
    let moved = Event::PointerMove { at: vec2(190.0, 10.0), mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down, up, moved])
    ui.slider("level", mut value, lo: 0.0, hi: 1.0)
    assert(abs(value - 0.8) < 0.00001)
}

@test
fn a_number_drag_uses_the_release_position() {
    var ui = Ui::new(Fonts::load())
    var value = 3.0
    let down = Event::PointerDown { at: vec2(100.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.number("count", mut value, step: 0.5)
