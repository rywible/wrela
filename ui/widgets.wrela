@test
fn a_scroll_thumb_drag_uses_the_release_position() {
    var ui = Ui::new(Fonts::load())
    let down = Event::PointerDown { at: vec2(199.0, 10.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.begin_scroll("scroll", height: 40.0)
    let _ = ui.place(vec2(10.0, 200.0))
    ui.end_scroll()
    ui.end()
    let up = Event::PointerUp { at: vec2(199.0, 30.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    ui.begin_scroll("scroll", height: 40.0)
    let _ = ui.place(vec2(10.0, 200.0))
    ui.end_scroll()
    assert(ui.scrolls.get(ui.id("scroll")) == Some(160.0))
}

@test
fn typing_after_a_press_goes_only_to_the_new_text_field() {
    var ui = Ui::new(Fonts::load())
    var first = String::from("old")
    var second = String::from("new")
    ui.start_editing(ui.id("first"), first.as_str())
    ui.begin(
        vec2(300.0, 100.0),
        [
            Event::PointerDown { at: vec2(150.0, 40.0), button: Button::Primary, mods: Mods {} },
            Event::Text { char: 120 },
        ],
    )
    let _ = ui.text_field("first", mut first)
    let _ = ui.text_field("second", mut second)
    ui.end()
    assert(first.as_str() == "old", first.as_str())
    assert(second.as_str() == "newx", second.as_str())
}

@test
fn a_press_on_another_widget_ends_text_editing() {
    var ui = Ui::new(Fonts::load())
    let text_id = ui.id("text")
    ui.start_editing(text_id, "kept")
    let down = Event::PointerDown { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    let button_id = ui.id("button")
    let _ = ui.interact(button_id, Rect::new(x: 0.0, y: 0.0, w: 100.0, h: 20.0), focusable: true)
    ui.end()
    assert(ui.focused(button_id) && ui.editing_id() == 0)

    // A press in the same field keeps the original text for Escape to restore.
    ui.start_editing(text_id, "kept")
    ui.begin(vec2(200.0, 100.0), [down])
    let _ = ui.interact(text_id, Rect::new(x: 0.0, y: 0.0, w: 100.0, h: 20.0), focusable: true)
    ui.end()
    assert(ui.editing_id() == text_id && ui.edit_original() == "kept")
}

@test
fn a_scroll_thumb_stays_inside_a_short_viewport() {
    var ui = Ui::new(Fonts::load())
    ui.begin(vec2(200.0, 100.0), Vec::<Event>::new())
    ui.begin_scroll("short", 10.0)
    ui.space(100.0)
    let _ = ui.place(vec2(10.0))
    ui.end_scroll()
    let viewport = ui.last_rect()
    assert(ui.draw.quads.len() == 1)
    let thumb = ui.draw.quads[0].rect
    assert(thumb.y >= viewport.y && thumb.y + thumb.w <= viewport.bottom())
}

@test
fn a_clipped_split_divider_cannot_take_a_press() {
    var ui = Ui::new(Fonts::load())
    let down = Event::PointerDown { at: vec2(96.0, 51.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.begin_scroll("outer", 20.0)
    ui.space(50.0)
    ui.begin_split("hidden", Dir::Row, 0.5)
    assert(!ui.busy())
    ui.next_pane()
    ui.end_split()
    ui.end_scroll()
    ui.end()
}

@test
fn a_split_reserves_its_place_in_the_parent_area() {
    var ui = Ui::new(Fonts::load())
    ui.begin(vec2(200.0, 100.0), Vec::<Event>::new())
    ui.begin_split("side by side", Dir::Row, 0.5)
    ui.next_pane()
    ui.end_split()
    assert(ui.place(vec2(10.0, 10.0)).y >= 100.0)
    ui.end()

    ui.begin(vec2(200.0, 100.0), Vec::<Event>::new())
    ui.begin_row(height: 40.0)
    ui.begin_split("stacked", Dir::Column, 0.5)
    ui.next_pane()
    ui.end_split()
    assert(ui.place(vec2(10.0, 10.0)).x >= 200.0)
}

@test
fn a_tree_starts_keyboard_navigation_at_the_first_or_last_item() {
    var ui = Ui::new(Fonts::load())
    var nodes: Vec<TreeItem> = Vec::new()
    nodes.push(TreeItem { label: String::from("first"), depth: 0, children: false })
    nodes.push(TreeItem { label: String::from("second"), depth: 0, children: false })
    nodes.push(TreeItem { label: String::from("last"), depth: 0, children: false })
    var selected = -1
    let down = Event::KeyDown { key: Key::Down, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.set_focus(ui.id("nodes"))
    ui.tree("nodes", nodes, mut selected, 80.0)
    assert(selected == 0)
    ui.end()

    selected = -1
    let up = Event::KeyDown { key: Key::Up, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    ui.set_focus(ui.id("nodes"))
    ui.tree("nodes", nodes, mut selected, 80.0)
    assert(selected == 2)
}

@test
fn a_clipped_widget_is_not_hovered() {
    var ui = Ui::new(Fonts::load())
    let move = Event::PointerMove { at: vec2(1.0, 51.0), mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [move])
    ui.begin_scroll("scroll", 20.0)
    ui.last_rect = Rect::new(x: 0.0, y: 50.0, w: 100.0, h: 20.0)
    assert(!ui.hovered())
    ui.end_scroll()
}

@test
fn a_fixed_range_slider_draws_finite_quads() {
    var ui = Ui::new(Fonts::load())
    var value = 3.0
    ui.begin(vec2(200.0, 100.0), Vec::<Event>::new())
    assert(!ui.slider("fixed", mut value, lo: 3.0, hi: 3.0))
    for q in ui.draw.quads {
        assert(is_finite(q.rect.x) && is_finite(q.rect.y))
        assert(is_finite(q.rect.z) && is_finite(q.rect.w))
    }
}

@test
fn drag_and_drop_accepts_every_u32_payload() {
    var ui = Ui::new(Fonts::load())
    let widget = Rect::new(x: 0.0, y: 0.0, w: 100.0, h: 20.0)
    let down = Event::PointerDown { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    ui.last_rect = widget
    ui.drag_source(4294967295)
    ui.end()

    let up = Event::PointerUp { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    ui.last_rect = widget
    assert(ui.dropped() == Some(4294967295))
}

@test
fn clipped_widgets_cannot_start_or_receive_a_drag() {
    var source_ui = Ui::new(Fonts::load())
    let down = Event::PointerDown { at: vec2(1.0, 51.0), button: Button::Primary, mods: Mods {} }
    source_ui.begin(vec2(200.0, 100.0), [down])
    source_ui.begin_scroll("scroll", 20.0)
    source_ui.space(50.0)
    source_ui.last_rect = Rect::new(x: 0.0, y: 50.0, w: 100.0, h: 20.0)
    source_ui.drag_source(7)
    source_ui.end_scroll()
    source_ui.end()
    let up = Event::PointerUp { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    source_ui.begin(vec2(200.0, 100.0), [up])
    source_ui.last_rect = Rect::new(x: 0.0, y: 0.0, w: 100.0, h: 20.0)
    assert(source_ui.dropped() == None)

    var target_ui = Ui::new(Fonts::load())
    let down = Event::PointerDown { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    target_ui.begin(vec2(200.0, 100.0), [down])
    target_ui.last_rect = Rect::new(x: 0.0, y: 0.0, w: 100.0, h: 20.0)
    target_ui.drag_source(7)
    target_ui.end()
    let up = Event::PointerUp { at: vec2(1.0, 51.0), button: Button::Primary, mods: Mods {} }
    target_ui.begin(vec2(200.0, 100.0), [up])
    target_ui.begin_scroll("scroll", 20.0)
    target_ui.space(50.0)
    target_ui.last_rect = Rect::new(x: 0.0, y: 50.0, w: 100.0, h: 20.0)
    assert(target_ui.dropped() == None)
    target_ui.end_scroll()
}

@test
fn a_clipped_nested_scroll_cannot_consume_wheel() {
    var ui = Ui::new(Fonts::load())
    let wheel = Event::Wheel { at: vec2(1.0, 51.0), delta: vec2(0.0, 9.0), mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [wheel])
    ui.begin_scroll("outer", 20.0)
    ui.space(50.0)
    ui.begin_scroll("hidden inner", 20.0)
    ui.end_scroll()
    ui.end_scroll()
    assert(ui.wheel().y == 9.0)
}

@test
fn a_panel_press_clears_underlying_interaction_state() {
    var ui = Ui::new(Fonts::load())
    let panel = Rect::new(x: 0.0, y: 0.0, w: 200.0, h: 100.0)
    let under = 17
    let down = Event::PointerDown { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [down])
    let _ = ui.interact(under, panel, focusable: true)
    ui.last_rect = panel
    ui.drag_source(7)
    ui.begin_panel("", panel)
    ui.end_panel()
    ui.end()

    let up = Event::PointerUp { at: vec2(1.0), button: Button::Primary, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [up])
    let (_, clicked) = ui.interact(under, panel, focusable: true)
    ui.last_rect = panel
    let dropped = ui.dropped()
    ui.begin_panel("", panel)
    ui.end_panel()
    ui.end()
    assert(!clicked && dropped == None)

    let enter = Event::KeyDown { key: Key::Enter, repeat: false, mods: Mods {} }
    ui.begin(vec2(200.0, 100.0), [enter])
    let (_, keyed) = ui.interact(under, panel, focusable: true)
    ui.begin_panel("", panel)
    ui.end_panel()
    assert(!keyed)
}
