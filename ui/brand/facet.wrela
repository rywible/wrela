// Wrela Facet: the console's display face, unicase capitals drawn as stroke centrelines and
// baked into a font (`FONT`) when the program is built. Joins are mitred, terminals are cut
// flat, and bowls are chamfered at 45 degrees. The same strokes, heavier, make the WRΞLA mark
// (`mark`, `mark_distance`).
use ui::ttf::{Baked, BakedGlyph, Kern}

/// The capitals' height: 0.70 em. Design units are hundredths of an em.
pub const CAP: f32 = 0.70
/// Half the stroke's width: capitals are drawn with a 0.10 em stroke.
pub const HALF: f32 = 0.05
/// Half the wordmark's heavier stroke's width.
pub const MARK_HALF: f32 = 0.07
const SIDE: f32 = 0.07
const MARK_GAP: f32 = 0.15

@fuel(2 ** 38)
pub const FONT: Baked = bake()

pub struct Stroke: Clone {
    pub points: Vec<vec2>,
    pub closed: bool,
}

pub struct Letter: Clone {
    pub advance: f32,
    pub strokes: Vec<Stroke>,
    // Cut to the baseline and cap height: diagonals run past both and end flat.
    pub clip: bool,
}

/// One straight run of a stroke: its centreline from `a` to `b`, and the planes through each
/// end that it shares with its neighbours (perpendicular at a free terminal).
pub struct Piece: Copy {
    pub a: vec2,
    pub b: vec2,
    pub start: vec2,
    pub end: vec2,
    // The next run's direction, when this one turns into it rather than ending.
    pub after: Option<vec2>,
    pub half: f32,
    pub clip: bool,
}

fn units(points: [vec2]) -> Vec<vec2> {
    var out: Vec<vec2> = Vec::new()
    for p in points { out.push(p * 0.01) }
    out
}

fn line(points: [vec2]) -> Stroke {
    Stroke { points: units(points), closed: false }
}

fn ring(points: [vec2]) -> Stroke {
    Stroke { points: units(points), closed: true }
}

// A closed rectangle of centrelines, its corners chamfered by `k`.
fn facet(low: vec2, high: vec2, k: f32) -> Stroke {
    let (x0, y0, x1, y1) = (low.x, low.y, high.x, high.y)
    ring(
        [
            vec2(x0 + k, y0),
            vec2(x1 - k, y0),
            vec2(x1, y0 + k),
            vec2(x1, y1 - k),
            vec2(x1 - k, y1),
            vec2(x0 + k, y1),
            vec2(x0, y1 - k),
            vec2(x0, y0 + k),
        ],
    )
}

pub fn pieces(stroke: Stroke, half: f32, clip: bool, shift: vec2 = vec2(0.0)) -> Vec<Piece> {
    borrow p = stroke.points
    let n = p.len()
    let count = if stroke.closed { n } else { n - 1 }
    var out: Vec<Piece> = Vec::new()
    for i in 0..count {
        let a = p[i]
        let b = p[(i + 1) % n]
        let u = normalize(b - a)
        let before = if stroke.closed || i > 0 { normalize(a - p[(i + n - 1) % n]) } else { u }
        let turns = stroke.closed || i + 2 < n
        let after = if turns { normalize(p[(i + 2) % n] - b) } else { u }
        out.push(
            Piece {
                a: a + shift,
                b: b + shift,
                start: normalize(before + u),
                end: normalize(u + after),
                after: if turns { Some(after) } else { None },
                half,
                clip,
            },
        )
    }
    out
}

/// Signed distance to one mitred run: negative inside. Exact on the outline, and a lower
/// bound outside it, which is what a distance field and a sphere tracer both need.
pub fn piece_distance(p: vec2, s: Piece) -> f32 {
    let u = normalize(s.b - s.a)
    let side = abs(dot(p - s.a, vec2(-u.y, u.x))) - s.half
    var d = max(side, max(-dot(p - s.a, s.start), dot(p - s.b, s.end)))
    // Where two runs overlap around their mitre, the shared cut is inside the ink; without
    // this term a field would show it as a hairline.
    if let Some(next) = s.after {
        let across = abs(dot(p - s.b, vec2(-next.y, next.x))) - s.half
        d = min(d, max(max(side, across), -dot(p - s.a, s.start)))
    }
    if s.clip { d = max(d, max(-p.y, p.y - CAP)) }
    d
}

