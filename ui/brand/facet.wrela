            s.push(line([vec2(5.0, 80.0), vec2(19.0, 80.0), vec2(19.0, -10.0), vec2(5.0, -10.0)]))
            24.0
        },
        94 => {
            s.push(line([vec2(6.0, 44.0), vec2(27.0, 68.0), vec2(48.0, 44.0)]))
            54.0
        },
        95 => {
            clip = false
            s.push(line([vec2(0.0, -10.0), vec2(56.0, -10.0)]))
            56.0
        },
        96 => {
            clip = false
            s.push(line([vec2(5.0, 72.0), vec2(17.0, 58.0)]))
            22.0
        },
        123 => {
            clip = false
            s.push(
                line(
                    [
                        vec2(22.0, 80.0),
                        vec2(14.0, 80.0),
                        vec2(9.0, 75.0),
                        vec2(9.0, 40.0),
                        vec2(3.0, 35.0),
                        vec2(9.0, 30.0),
                        vec2(9.0, -5.0),
                        vec2(14.0, -10.0),
                        vec2(22.0, -10.0),
                    ],
                ),
            )
            24.0
        },
        124 => {
            clip = false
            s.push(line([vec2(5.0, -12.0), vec2(5.0, 82.0)]))
            10.0
        },
        125 => {
            clip = false
            s.push(
                line(
                    [
                        vec2(2.0, 80.0),
                        vec2(10.0, 80.0),
                        vec2(15.0, 75.0),
                        vec2(15.0, 40.0),
                        vec2(21.0, 35.0),
                        vec2(15.0, 30.0),
                        vec2(15.0, -5.0),
                        vec2(10.0, -10.0),
                        vec2(2.0, -10.0),
                    ],
                ),
            )
            24.0
        },
        126 => {
            s.push(line([vec2(5.0, 28.0), vec2(17.0, 40.0), vec2(37.0, 28.0), vec2(49.0, 40.0)]))
            54.0
        },
        _ => return letter(63),
    }
    Letter { advance: width * 0.01 + 2.0 * SIDE, strokes: s, clip }
}

fn glyph_pieces(l: Letter, shift: vec2) -> Vec<Piece> {
    var out: Vec<Piece> = Vec::new()
    for stroke in l.strokes { for p in pieces(stroke, HALF, l.clip, shift) { out.push(p) } }
    out
}

// ---- kerning ---------------------------------------------------------------------------------

// Pairs whose open sides face each other leave a hole that even side bearings can't close: a
// slope beside a slope, or beside the open side of an L, F, P or T. Each moves together by
// hundredths of an em. Only capitals pair; digits keep their widths, so figures line up.
const KERNING: [(u32, u32, f32); 15] = [
    (65, 84, -5.0),
    (65, 86, -6.0),
    (65, 87, -4.0),
    (65, 89, -6.0),
    (84, 65, -5.0),
    (86, 65, -6.0),
    (87, 65, -4.0),
    (89, 65, -6.0),
    (76, 84, -7.0),
    (76, 86, -6.0),
    (76, 87, -4.0),
    (76, 89, -7.0),
    (76, 65, -4.0),
    (70, 65, -4.0),
    (80, 65, -4.0),
]

// The table as the font carries it: each pair in either case, in 1/8192 ems.
fn kerns() -> Vec<Kern> {
    var out: Vec<Kern> = Vec::new()
    for (a, b, hundredths) in KERNING {
        for left in [a, a + 32] {
            for right in [b, b + 32] {
                out.push(
                    Kern { left: left - 32, right: right - 32, units: i32(hundredths * 81.92) },
                )
            }
        }
    }
    out
}

// The wordmark: heavier strokes, and a stemless E. Each segment is one rigid piece.
fn mark_letters() -> Vec<Letter> {
    var w: Vec<Stroke> = Vec::new()
    w.push(
        line(
            [
                vec2(6.0, 90.0),
                vec2(26.0, -20.0),
                vec2(47.0, 40.0),
                vec2(68.0, -20.0),
                vec2(88.0, 90.0),
            ],
        ),
    )
    var r: Vec<Stroke> = Vec::new()
    r.push(
        line(
            [
                vec2(7.0, 0.0),
                vec2(7.0, 53.0),
                vec2(17.0, 63.0),
                vec2(46.0, 63.0),
                vec2(56.0, 53.0),
                vec2(56.0, 40.0),
                vec2(46.0, 30.0),
                vec2(7.0, 30.0),
            ],
        ),
    )
    r.push(line([vec2(32.0, 30.0), vec2(60.0, -16.0)]))
    var e: Vec<Stroke> = Vec::new()
    e.push(line([vec2(0.0, 63.0), vec2(52.0, 63.0)]))
    e.push(line([vec2(6.0, 35.0), vec2(46.0, 35.0)]))
    e.push(line([vec2(0.0, 7.0), vec2(52.0, 7.0)]))
    var l: Vec<Stroke> = Vec::new()
    l.push(line([vec2(7.0, 70.0), vec2(7.0, 17.0), vec2(17.0, 7.0), vec2(50.0, 7.0)]))
    var a: Vec<Stroke> = Vec::new()
    a.push(line([vec2(5.0, -18.0), vec2(34.0, 88.0), vec2(63.0, -18.0)]))
    a.push(line([vec2(19.0, 22.0), vec2(49.0, 22.0)]))
    var out: Vec<Letter> = Vec::new()
    out.push(Letter { advance: 0.94, strokes: w, clip: true })
    out.push(Letter { advance: 0.63, strokes: r, clip: true })
    out.push(Letter { advance: 0.52, strokes: e, clip: true })
    // The A tucks in over the L's open side, so the gap between them matches the others.
    out.push(Letter { advance: 0.43, strokes: l, clip: true })
    out.push(Letter { advance: 0.68, strokes: a, clip: true })
    out
}

/// The mark's pieces in ems, centred on the origin horizontally, baseline at y = 0.
pub fn mark() -> Vec<Piece> {
    let letters = mark_letters()
    var width = -MARK_GAP
    for l in letters { width += l.advance + MARK_GAP }
    var out: Vec<Piece> = Vec::new()
    var pen = -width * 0.5
    for l in letters {
        for stroke in l.strokes {
            for p in pieces(stroke, MARK_HALF, l.clip, vec2(pen, 0.0)) {
                // The clip planes stay in the letter's own frame: baseline and cap height.
                out.push(p)
            }
        }
        pen += l.advance + MARK_GAP
    }
    out
}

/// The mark's runs for the GPU: each run's ends, its cuts, the run it turns into, and its
/// half stroke with the baseline and cap height.
pub struct MarkRun: Copy + GpuData {
    pub ab: vec4,
    pub cuts: vec4,
    pub after: vec4,
    pub shape: vec4,
}

pub fn mark_runs() -> Vec<MarkRun> {
    var out: Vec<MarkRun> = Vec::new()
    for p in mark() {
        out.push(
            MarkRun {
                ab: vec4(p.a, p.b),
                cuts: vec4(p.start, p.end),
                after: match p.after {
                    Some(n) => vec4(n, 1.0, 0.0),
                    None => vec4(0.0),
                },
                shape: vec4(p.half, if p.clip { 0.0 } else { -100.0 }, if p.clip { CAP } else {
                    100.0
                }, 0.0),
            },
        )
    }
    out
}

/// The flat mark's field at `p` (ems, mark centred, baseline at 0): the same as the font's
/// pieces, joined at their mitres without a seam.
pub fn mark_distance(p: vec2, s: MarkRun) -> f32 {
    let a = s.ab.xy
    let b = s.ab.zw
    let u = normalize(b - a)
    let side = abs(dot(p - a, vec2(-u.y, u.x))) - s.shape.x
    var d = max(side, max(-dot(p - a, s.cuts.xy), dot(p - b, s.cuts.zw)))
    if s.after.z > 0.5 {
        let next = s.after.xy
        let across = abs(dot(p - b, vec2(-next.y, next.x))) - s.shape.x
        d = min(d, max(max(side, across), -dot(p - a, s.cuts.xy)))
    }
    max(d, max(s.shape.y - p.y, p.y - s.shape.z))
}

pub fn mark_width() -> f32 {
    var width = -MARK_GAP
    for l in mark_letters() { width += l.advance + MARK_GAP }
    width
}

/// The font, baked from the drawings when the program is built: no font file, and no outline
/// processing while the program runs.
pub fn bake() -> Baked {
    let em = 64.0
    let spread = 5.0
    var glyphs: Vec<BakedGlyph> = Vec::new()
    var fields: Vec<u8> = Vec::new()
    for cp in 32..127 {
        let l = letter(cp)
        let parts = glyph_pieces(l, vec2(SIDE, 0.0))
        var lo = vec2(100.0)
        var hi = vec2(-100.0)
        for p in parts {
            lo = min(lo, min(p.a, p.b))
            hi = max(hi, max(p.a, p.b))
        }
        // Mitres can reach past the centreline by a few stroke widths; clipped ones stop at
        // the baseline and cap height.
        lo -= vec2(HALF * 3.0)
        hi += vec2(HALF * 3.0)
        if l.clip {
            lo.y = max(lo.y, 0.0)
            hi.y = min(hi.y, CAP)
        }
        let empty = parts.is_empty()
        let left = if empty { 0.0 } else { floor(lo.x * em - spread) }
        let top = if empty { 0.0 } else { ceil(hi.y * em + spread) }
        let width = if empty { 0 } else { u32(ceil(hi.x * em + spread) - left) }
        let height = if empty { 0 } else { u32(top - floor(lo.y * em - spread)) }
        glyphs.push(
            BakedGlyph {
                codepoint: cp,
                advance: l.advance,
                left,
                top,
                width,
                height,
                offset: fields.len(),
            },
        )
        for y in 0..height {
            for x in 0..width {
                let p = vec2(left + f32(x) + 0.5, top - f32(y) - 0.5) / em
                var distance = 100.0
                for part in parts { distance = min(distance, piece_distance(p, part)) }
                fields.push(u8(round(saturate(0.5 - distance * em / (2.0 * spread)) * 255.0)))
            }
        }
    }
    Baked {
        em,
        spread,
        ascender: 0.80,
        descender: -0.18,
        line_gap: 0.12,
        glyphs,
        kerning: kerns(),
        fields,
    }
}

@test
fn facet_has_printable_ascii_with_ink_and_shared_capitals() {
    borrow font = FONT
    assert(font.glyphs.len() == 95)
    var end = 0
    for i in 0..95 {
        let g = font.glyphs[i]
        assert(g.codepoint == i + 32 && g.advance > 0.0 && g.advance < 1.1)
        assert(g.offset == end)
        end += g.width * g.height
        assert(end <= font.fields.len())
        if i == 0 { assert(g.width == 0 && g.height == 0) } else {
            var ink = 0
            for k in g.offset..end { if font.fields[k] > 127 { ink += 1 } }
            assert(ink > 0, "every visible ASCII character has ink")
        }
    }
    assert(end == font.fields.len())
    assert(letter(97).advance == letter(65).advance)
    assert(letter(87).advance > letter(77).advance)
}

@test
fn mitred_joins_close_corners_and_terminals_cut_flat() {
    let near_in = |cp: u32, p: vec2| -> f32 {
        var d = 100.0
        for s in glyph_pieces(letter(cp), vec2(0.0)) { d = min(d, piece_distance(p, s)) }
        d
    }
    // [: the outer corner of a square turn is filled to the square.
    assert(near_in(91, vec2(0.001, 0.849)) < 0.0)
    // L: its corner is cut at 45 degrees, and nothing passes the end of its foot.
    assert(near_in(76, vec2(0.001, 0.001)) > 0.0)
    assert(near_in(76, vec2(0.075, 0.075)) < 0.0)
    assert(near_in(76, vec2(0.499, 0.05)) < 0.0)
    assert(near_in(76, vec2(0.505, 0.05)) > 0.0)
    // A mitred bowl has no seam: the middle of its stroke at a chamfer is deep inside.
    let o = glyph_pieces(letter(79), vec2(0.0))
    var deep = 100.0
    for s in o { deep = min(deep, piece_distance(vec2(0.05, 0.18), s)) }
    assert(deep < -0.03)
    // V: diagonals stop flat at the baseline and the cap height.
    let v = glyph_pieces(letter(86), vec2(0.0))
    for s in v {
        assert(piece_distance(vec2(0.32, -0.001), s) > 0.0)
        assert(piece_distance(vec2(0.06, CAP + 0.001), s) > 0.0)
    }
}

@test
fn the_flat_mark_matches_its_pieces() {
    let runs = mark_runs()
    let parts = mark()
    assert(runs.len() == parts.len())
    for x in 0..40 {
        for y in 0..8 {
            let p = vec2(f32(x) * 0.1 - 2.0, f32(y) * 0.1)
            var flat = 100.0
            var pieces = 100.0
            for r in runs { flat = min(flat, mark_distance(p, r)) }
            for q in parts { pieces = min(pieces, piece_distance(p, q)) }
            assert((flat < 0.0) == (pieces < 0.0), "the same ink")
        }
    }
}

@test
fn the_mark_is_twenty_one_pieces_on_one_baseline_and_centred() {
    let parts = mark()
    assert(parts.len() == 21)
    var lo = 100.0
    var hi = -100.0
    for p in parts {
        assert(p.clip && p.half == MARK_HALF)
        assert(abs(length(p.start) - 1.0) < 0.001 && abs(length(p.end) - 1.0) < 0.001)
        lo = min(lo, min(p.a.x, p.b.x))
        hi = max(hi, max(p.a.x, p.b.x))
    }
    assert(abs(lo + hi) < 0.12)
    assert(mark_width() > 3.5 && mark_width() < 4.2)
}

@test
fn every_square_corner_of_a_letter_or_digit_is_cut_at_45_degrees() {
    // The octagon is the console's shape: Facet's bowls and outer corners are cut at 45
    // degrees. A square turn stays only where another stroke runs on through it. Brackets
    // keep their square corners, so they stay apart from parentheses.
    var letters: Vec<Letter> = mark_letters()
    for cp in 48..58 { letters.push(letter(cp)) }
    for cp in 65..91 { letters.push(letter(cp)) }
    for l in letters {
        for k in 0..l.strokes.len() {
            let stroke = l.strokes[k].clone()
            let p = stroke.points.clone()
            let n = p.len()
            for i in 0..n {
                if !stroke.closed && (i == 0 || i + 1 == n) { continue }
                let before = normalize(p[i] - p[(i + n - 1) % n])
                let after = normalize(p[(i + 1) % n] - p[i])
                if abs(dot(before, after)) > 0.01 { continue }
                // A square turn: another stroke must run through its corner.
                var through = false
                for j in 0..l.strokes.len() {
                    if j == k { continue }
                    for q in l.strokes[j].points {
                        if length(q - p[i]) < 0.0001 { through = true }
                    }
                }
                assert(through, "a square corner is cut")
            }
        }
    }
}

@test
fn open_pairs_kern_together_in_either_case_and_stems_and_digits_do_not() {
    borrow font = FONT
    let kern = |a: u32, b: u32| -> i32 {
        var units = 0
        for k in font.kerning { if k.left == a - 32 && k.right == b - 32 { units = k.units } }
        units
    }
    for (a, b) in [(76, 65), (108, 65), (76, 97), (108, 97)] { assert(kern(a, b) < 0, "LA") }
    assert(kern(65, 86) < 0 && kern(84, 65) < 0)
    assert(kern(72, 72) == 0 && kern(49, 49) == 0 && kern(55, 65) == 0)
    // No pair moves by more than a tenth of an em.
    for k in font.kerning { assert(k.units < 0 && k.units > -820) }
}
