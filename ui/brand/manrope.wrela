// The Manrope face, baked into distance fields for the ui layer's text: the face the console
// and the docs read in. Its licence, the SIL Open Font License, is in fonts/OFL-Manrope.txt.
use ui::ttf::{Baked, bake}

@fuel(2 ** 38)
pub const MANROPE: Baked = bake(embed("fonts/Manrope-Medium.ttf"), em: 36.0, spread: 4.0)
