// Prompts: the keys and a controller's buttons drawn as a player sees them, so a game says
// "press Space" with the key itself. Which a game draws follows the device the player last used
// (`device_of`): a key or a click, or a controller's button or stick.
//
// Each glyph is drawn into a `DrawList` at a height, its top left at a point, in two colours
// (`Ink`: its line and its face), and says how wide it was. A controller's buttons are drawn by
// where they are, as the standard mapping names them, so a glyph is right for any make of pad:
// the four face buttons a diamond of dots with the one to press filled, the d-pad a cross with
// the arms to press filled.

use draw::{DrawList, Rect}
use text::{Face, Fonts}
use std::input::{Event, Key, Mods, PadButton}

/// What a player plays with: the keyboard (and the pointer), or a controller.
pub enum Device: Copy + Eq {
    Keys,
    Pad,
}

/// The device event `e` says the player is using, if it says: a key or a click, or a
/// controller's button or a stick pushed past half its travel.
pub fn device_of(e: Event) -> Option<Device> {
    match e {
        Event::KeyDown { .. } => Some(Device::Keys),
        Event::PointerDown { .. } => Some(Device::Keys),
        Event::PadButton { pressed, .. } => if pressed { Some(Device::Pad) } else { None },
        Event::PadAxis { value, .. } => if abs(value) >= 0.5 { Some(Device::Pad) } else { None },
        _ => None,
    }
}

/// A glyph's colours: its line, and its face.
pub struct Ink: Copy {
    pub line: vec4,
    pub face: vec4,
}

/// The d-pad's arms, a bit each, for `dpad`.
pub const ARM_UP: u32 = 1
pub const ARM_DOWN: u32 = 2
pub const ARM_LEFT: u32 = 4
pub const ARM_RIGHT: u32 = 8

/// How thick a glyph's line is at height `size`.
fn stroke(size: f32) -> f32 {
    max(size * 0.07, 1.0)
}

/// A key's cap in `r`: its outline, and its face raised on a deeper edge along its bottom.
fn cap(list: mut DrawList, r: Rect, ink: Ink) {
    let size = r.h
    let line = stroke(size)
    let radius = size * 0.22
    list.rect(r, ink.line, radius: radius)
    list.rect(
        Rect::new(r.x + line, r.y + line, r.w - 2.0 * line, r.h - 3.2 * line),
        ink.face,
        radius: radius - line,
    )
}

/// How wide `key` draws a key with `label` on it, `size` pixels high.
pub fn key_width(fonts: Fonts, label: str, size: f32) -> f32 {
    max(fonts.font(Face::Sans).measure(label, size * 0.46) + size * 0.62, size)
}

/// A key with `label` on it (`Space`, `Esc`, `R`), `size` pixels high: at least as wide as it
/// is high.
pub fn key(list: mut DrawList, fonts: Fonts, label: str, at: vec2, size: f32, ink: Ink) -> f32 {
    let text = size * 0.46
    borrow font = fonts.font(Face::Sans)
    let tw = font.measure(label, text)
    let w = key_width(fonts, label, size)
    cap(mut list, Rect::new(at.x, at.y, w, size), ink)
    let face_h = size - 3.2 * stroke(size)
    let top = at.y + (face_h - font.line_height(text)) * 0.5 + stroke(size) * 0.5
    let _ = list.text(fonts, Face::Sans, label, text, vec2(at.x + (w - tw) * 0.5, top), ink.line)
    w
}

/// An arrow key pointing `way` (on the screen: y down), `size` pixels high and wide.
pub fn arrow(list: mut DrawList, way: vec2, at: vec2, size: f32, ink: Ink) -> f32 {
    cap(mut list, Rect::new(at.x, at.y, size, size), ink)
    let c = at + vec2(size * 0.5, (size - 2.2 * stroke(size)) * 0.5)
    let side = vec2(-way.y, way.x)
    list.triangle(
        c + way * size * 0.19,
        c - way * size * 0.13 + side * size * 0.17,
        c - way * size * 0.13 - side * size * 0.17,
        ink.line,
    )
    size
}

/// The key that `key` names, as a player reads it: an arrow for an arrow key, else its name.
pub fn key_named(list: mut DrawList, fonts: Fonts, k: Key, at: vec2, size: f32, ink: Ink) -> f32 {
    if k == Key::Up {
        arrow(mut list, vec2(0.0, -1.0), at, size, ink)
    } else if k == Key::Down {
        arrow(mut list, vec2(0.0, 1.0), at, size, ink)
    } else if k == Key::Left {
        arrow(mut list, vec2(-1.0, 0.0), at, size, ink)
    } else if k == Key::Right {
        arrow(mut list, vec2(1.0, 0.0), at, size, ink)
    } else { key(mut list, fonts, key_name(k), at, size, ink) }
}

/// What a key is called on its cap.
pub fn key_name(k: Key) -> Text {
    if k == Key::Space {
        "Space"
    } else if k == Key::Enter {
        "Enter"
    } else if k == Key::Escape {
        "Esc"
    } else if k == Key::Backspace {
        "Backspace"
    } else if k == Key::Tab {
        "Tab"
    } else { letter(k) }
}

/// The letter keys and their letters.
const LETTERS: [(Key, Text); 26] = [
    (Key::A, "A"),
    (Key::B, "B"),
    (Key::C, "C"),
    (Key::D, "D"),
    (Key::E, "E"),
    (Key::F, "F"),
    (Key::G, "G"),
    (Key::H, "H"),
    (Key::I, "I"),
    (Key::J, "J"),
    (Key::K, "K"),
    (Key::L, "L"),
    (Key::M, "M"),
    (Key::N, "N"),
    (Key::O, "O"),
    (Key::P, "P"),
    (Key::Q, "Q"),
    (Key::R, "R"),
    (Key::S, "S"),
    (Key::T, "T"),
    (Key::U, "U"),
    (Key::V, "V"),
    (Key::W, "W"),
    (Key::X, "X"),
    (Key::Y, "Y"),
    (Key::Z, "Z"),
]

/// A letter key's letter, or "?".
fn letter(k: Key) -> Text {
    for i in 0..LETTERS.len() {
        if LETTERS[i].0 == k {
            return LETTERS[i].1
        }
    }
    "?"
}

/// A controller's face button `b` (South, East, West or North), `size` pixels high and wide: the
/// four as a diamond of dots, `b`'s filled.
pub fn face_button(list: mut DrawList, b: PadButton, at: vec2, size: f32, ink: Ink) -> f32 {
    let c = at + vec2(size * 0.5)
    let r = size * 0.3
    let dot = size * 0.2
    for (button, off) in [
        (PadButton::North, vec2(0.0, -r)),
        (PadButton::South, vec2(0.0, r)),
        (PadButton::West, vec2(-r, 0.0)),
        (PadButton::East, vec2(r, 0.0)),
    ] {
        let p = c + off
        let round = Rect::new(p.x - dot, p.y - dot, 2.0 * dot, 2.0 * dot)
        if button == b {
            list.ellipse(round, ink.line)
        } else {
            list.ellipse(round, ink.face)
            list.ellipse(round, vec4(ink.line.xyz, ink.line.w * 0.45), width: stroke(size))
        }
    }
    size
}

/// The d-pad, `size` pixels high and wide: a cross, with the arms in `arms` (`ARM_UP`...) filled.
pub fn dpad(list: mut DrawList, arms: u32, at: vec2, size: f32, ink: Ink) -> f32 {
    let line = stroke(size)
    let t = size * 0.34
    let mid = (size - t) * 0.5
    let r = size * 0.08
    // The cross's outline, then its face.
    list.rect(Rect::new(at.x + mid, at.y, t, size), ink.line, radius: r)
    list.rect(Rect::new(at.x, at.y + mid, size, t), ink.line, radius: r)
    list.rect(
        Rect::new(at.x + mid + line, at.y + line, t - 2.0 * line, size - 2.0 * line),
        ink.face,
        radius: r,
    )
    list.rect(
        Rect::new(at.x + line, at.y + mid + line, size - 2.0 * line, t - 2.0 * line),
        ink.face,
        radius: r,
    )
    let arm = mid - line
    for (bit, r) in [
        (ARM_UP, Rect::new(at.x + mid, at.y, t, arm)),
        (ARM_DOWN, Rect::new(at.x + mid, at.y + size - arm, t, arm)),
        (ARM_LEFT, Rect::new(at.x, at.y + mid, arm, t)),
        (ARM_RIGHT, Rect::new(at.x + size - arm, at.y + mid, arm, t)),
    ] {
        if arms & bit != 0 {
            list.rect(r, ink.line, radius: size * 0.08)
        }
    }
    size
}

/// A controller's Start (menu) button, `size` pixels high: a small pill with three lines on it.
pub fn start_button(list: mut DrawList, at: vec2, size: f32, ink: Ink) -> f32 {
    let w = size * 1.3
    let line = stroke(size)
    let h = size * 0.7
    let top = at.y + (size - h) * 0.5
    list.rect(Rect::new(at.x, top, w, h), ink.line, radius: h * 0.5)
    list.rect(
        Rect::new(at.x + line, top + line, w - 2.0 * line, h - 2.0 * line),
        ink.face,
        radius: h * 0.5 - line,
    )
    for i in 0..3 {
        let y = top + h * (0.32 + 0.18 * f32(i))
        list.line(vec2(at.x + w * 0.33, y), vec2(at.x + w * 0.67, y), ink.line, width: line)
    }
    w
}

/// A controller's Select (view) button, `size` pixels high: a small pill with two squares on it,
/// one over the other.
pub fn select_button(list: mut DrawList, at: vec2, size: f32, ink: Ink) -> f32 {
    let w = size * 1.3
    let line = stroke(size)
    let h = size * 0.7
    let top = at.y + (size - h) * 0.5
    list.rect(Rect::new(at.x, top, w, h), ink.line, radius: h * 0.5)
    list.rect(
        Rect::new(at.x + line, top + line, w - 2.0 * line, h - 2.0 * line),
        ink.face,
        radius: h * 0.5 - line,
    )
    let side = h * 0.34
    let c = vec2(at.x + w * 0.5, top + h * 0.5)
    list.ring(Rect::new(c.x - side * 0.75, c.y - side * 0.75, side, side), ink.line, width: line)
    list.rect(Rect::new(c.x - side * 0.25, c.y - side * 0.25, side, side), ink.line)
    w
}

/// A controller's shoulder button, left or right, `size` pixels high: a tab rounded on top, with
/// L or R on it.
pub fn shoulder(
    list: mut DrawList,
    fonts: Fonts,
    right: bool,
    at: vec2,
    size: f32,
    ink: Ink,
) -> f32 {
    let w = size * 1.4
    let line = stroke(size)
    let h = size * 0.75
    let top = at.y + (size - h) * 0.5
    list.rect(Rect::new(at.x, top, w, h), ink.line, radius: h * 0.45)
    list.rect(
        Rect::new(at.x + line, top + line, w - 2.0 * line, h - 2.0 * line),
        ink.face,
        radius: h * 0.45 - line,
    )
    let label = if right { "R" } else { "L" }
    let text = size * 0.46
    borrow font = fonts.font(Face::Sans)
    let tw = font.measure(label, text)
    let y = top + (h - font.line_height(text)) * 0.5
    let _ = list.text(fonts, Face::Sans, label, text, vec2(at.x + (w - tw) * 0.5, y), ink.line)
    w
}

// ---- tests -------------------------------------------------------------------------------------

@test
fn keys_and_clicks_say_keys_and_a_controller_says_pad() {
    let mods = Mods {}
    assert(device_of(Event::KeyDown { key: Key::A, repeat: false, mods }) == Some(Device::Keys))
    let click = Event::PointerDown { at: vec2(1.0), button: std::input::Button::Primary, mods }
    assert(device_of(click) == Some(Device::Keys))
    let press = Event::PadButton { pad: 1, button: PadButton::South, value: 1.0, pressed: true }
    assert(device_of(press) == Some(Device::Pad), "any controller")
    let release = Event::PadButton { pad: 0, button: PadButton::South, value: 0.0, pressed: false }
    assert(device_of(release).is_none())
    let drift = Event::PadAxis { pad: 0, axis: std::input::PadAxis::LeftX, value: 0.2 }
    assert(device_of(drift).is_none(), "a stick's drift says nothing")
    let push = Event::PadAxis { pad: 0, axis: std::input::PadAxis::LeftX, value: -0.7 }
    assert(device_of(push) == Some(Device::Pad))
    assert(device_of(Event::PointerMove { at: vec2(1.0), mods }).is_none(), "a pointer moved")
}

@test
fn a_key_is_as_wide_as_its_name_needs_and_never_narrower_than_it_is_high() {
    let fonts = Fonts::load()
    var list = DrawList::new()
    list.clear(vec2(400.0))
    let ink = Ink { line: vec4(0.0, 0.0, 0.0, 1.0), face: vec4(1.0) }
    let r = key(mut list, fonts, "R", vec2(0.0), size: 30.0, ink: ink)
    let space = key(mut list, fonts, "Space", vec2(0.0), size: 30.0, ink: ink)
    assert(r == 30.0 && space > 40.0, f"{r} {space}")
    assert(key_named(mut list, fonts, Key::Up, vec2(0.0), size: 30.0, ink: ink) == 30.0)
    assert(key_name(Key::Escape) == "Esc" && key_name(Key::M) == "M")
}
