// Text: two fonts as signed distance fields (Inter for the UI, JetBrains Mono for source), baked
// from ui/fonts when the program is built (ttf.wrela), and laid out a line at a time. A glyph's
// field is sampled at 32 pixels per em; the GPU reads it at any size (draw.wrela), from 10 to
// 72 pixels.

use ttf::{Baked, bake}

/// The fonts, baked from their files: constants, so a build holds each once, and the build's
/// cache keeps them while the files and the baker are as they were.
@fuel(2 ** 38)
const SANS: Baked = bake(embed("fonts/Inter-Regular-Latin1.ttf"), em: 32.0, spread: 4.0)

@fuel(2 ** 38)
const MONO: Baked = bake(embed("fonts/JetBrainsMono-Regular-Latin1.ttf"), em: 32.0, spread: 4.0)

/// A face's baked font.
fn baked(face: Face) -> borrow Baked {
    match face {
        Face::Sans => SANS,
        Face::Mono => MONO,
    }
}

/// Which font.
pub enum Face: Copy + Eq {
    /// Inter: proportional, for the UI.
    Sans,
    /// JetBrains Mono: monospace, for source and numbers in columns.
    Mono,
}

/// A glyph: its advance (ems), where its field sits from the pen (pixels at the font's `em`),
/// and where its field is in the atlas.
pub struct Glyph: Copy {
    pub advance: f32,
    pub left: f32,
    pub top: f32,
    pub width: u32,
    pub height: u32,
    /// Into the baked font's fields.
    offset: u32,
    /// Its top-left texel in the atlas.
    pub atlas_x: u32,
    pub atlas_y: u32,
}

/// A font, from its baked constant when the program starts.
pub struct Font: Clone {
    /// The pixels per em its fields were sampled at, and the distance (in those pixels) that
    /// the field's 0 and 255 stand for.
    pub em: f32,
    pub spread: f32,
    /// Above and below the baseline, and between lines: ems.
    pub ascender: f32,
    pub descender: f32,
    pub line_gap: f32,
    glyphs: Vec<Glyph>,
    /// Each code point below 256: its glyph's index plus one (0: none).
    index: [u32; 256],
    /// The advance's change between two glyphs, by `left * count + right`: ems.
    kerning: Vec<f32>,
    /// The fields supplied with this face, including application-specific fonts.
    fields: Vec<u8>,
    /// `?`'s glyph: what a character the font hasn't shows.
    missing: u32,
}

impl Font {
    /// The font of `face`: its glyphs, each code point's, and its kerning by glyph.
    pub fn of(face: Face) -> Font {
        Font::from_baked(baked(face))
    }

    /// A caller-selected baked font, independent of the default UI faces.
    pub fn from_baked(b: Baked) -> Font {
        let n = b.glyphs.len()
        var glyphs: Vec<Glyph> = Vec::with_capacity(n)
        var index = [0; 256]
        for i in 0..n {
            let g = b.glyphs[i]
            glyphs.push(
                Glyph {
                    advance: g.advance,
                    left: g.left,
                    top: g.top,
                    width: g.width,
                    height: g.height,
                    offset: g.offset,
                    atlas_x: 0,
                    atlas_y: 0,
                },
            )
            if g.codepoint < 256 {
                index[g.codepoint] = i + 1
            }
        }
        var kerning: Vec<f32> = Vec::filled(n * n, 0.0)
        for k in b.kerning {
            kerning[k.left * n + k.right] = f32(k.units) / 8192.0
        }
        let missing = if index[63] > 0 { index[63] - 1 } else { 0 }
        Font {
            em: b.em,
            spread: b.spread,
            ascender: b.ascender,
            descender: b.descender,
            line_gap: b.line_gap,
            glyphs,
            index,
            kerning,
            fields: b.fields.clone(),
            missing,
        }
    }

    pub fn count(self) -> u32 {
        self.glyphs.len()
    }

    /// The bytes of its glyphs' fields, all of them.
    pub fn field_bytes(self) -> u32 {
        self.fields.len()
    }

    /// The index of the glyph for code point `cp`: `?`'s for one the font hasn't.
    pub fn glyph_index(self, cp: u32) -> u32 {
        if cp < 256 && self.index[cp] > 0 { self.index[cp] - 1 } else { self.missing }
    }

    pub fn glyph(self, i: u32) -> Glyph {
        self.glyphs[i]
    }

    /// Byte `k` of glyph `i`'s field (rows from the top).
    pub fn field_byte(self, i: u32, k: u32) -> u8 {
        self.fields[self.glyphs[i].offset + k]
    }

    /// The kerning between glyphs `a` and `b`: ems added to `a`'s advance.
    pub fn kern(self, a: u32, b: u32) -> f32 {
        self.kerning[a * self.glyphs.len() + b]
    }

    /// A line's height at `size` pixels per em.
    pub fn line_height(self, size: f32) -> f32 {
        (self.ascender - self.descender + self.line_gap) * size
    }

    /// Lays `text` out at `size` pixels per em from a pen at `pen` (pixels): `visit(i, g, at)`
    /// for each character, with its first byte, its glyph's index and the pen there (kerned),
    /// until `visit` returns false. The pen after the last glyph laid out.
    pub fn walk(self, text: str, size: f32, pen: f32, visit: fn(u32, u32, f32) -> bool) -> f32 {
        var x = pen
        var prev = 4294967295
        var i = 0
        while i < text.len() {
            let (cp, next) = decode(text, i)
            let g = self.glyph_index(cp)
            if prev != 4294967295 {
                x += self.kern(prev, g) * size
            }
            if !visit(i, g, x) {
                return x
            }
            x += self.glyphs[g].advance * size
            prev = g
            i = next
        }
        x
    }

    /// How wide `text` is at `size` pixels per em.
    pub fn measure(self, text: str, size: f32) -> f32 {
        self.walk(text, size, 0.0, |_i, _g, _pen| true)
    }

    /// The byte offset in `text` nearest `x` pixels from its start, at `size`: where a click
    /// puts a text cursor.
    pub fn offset_at(self, text: str, size: f32, x: f32) -> u32 {
        var at = 0
        var distance = abs(x)
        let end = self.walk(text, size, 0.0, |i, _g, pen| {
            let d = abs(x - pen)
            if d <= distance {
                distance = d
                at = i
            }
            true
        })
        if abs(x - end) <= distance {
            at = text.len()
        }
        at
    }

    /// The caret's x position at byte offset `at`, including kerning before the next glyph.
    pub fn caret_at(self, text: str, size: f32, at: u32) -> f32 {
        self.walk(text, size, 0.0, |i, _g, _pen| i != at)
    }

    /// Glyph `i`'s place in the atlas.
    pub fn place(mut self, i: u32, x: u32, y: u32) {
        self.glyphs[i].atlas_x = x
        self.glyphs[i].atlas_y = y
    }
}

/// The code point at byte `i` of UTF-8 `s`, and where the next one starts. A byte that doesn't
/// start a valid sequence is U+FFFD, one byte long.
pub fn decode(s: str, i: u32) -> (u32, u32) {
    let Some((cp, len)) = s.char_at(i) else { return (65533, i + 1) }
    (cp, i + len)
}

/// Where the character before byte `i` of UTF-8 `s` starts.
pub fn previous(s: str, i: u32) -> u32 {
    var j = i
    while j > 0 {
        j -= 1
        if (u32(s.byte(j)) & 192) != 128 {
            return j
        }
    }
    0
}

// ---- tests ------------------------------------------------------------------------------------

/// A byte that doesn't start a character is one replacement character (std's `char_at` tests
/// UTF-8's every invalid form); a character decodes whole.
@test
fn decode_replaces_what_isnt_a_character() {
    assert(decode("a狼", 1) == (29436, 4))
    assert(decode("a狼", 2) == (65533, 3))
}

@test
fn offset_uses_kerned_caret_positions() {
    let font = Font::of(Face::Sans)
    let a = font.glyph_index(65)
    let v = font.glyph_index(86)
    let advance = font.glyph(a).advance
    let next = advance + font.kern(a, v)
    assert(next < advance)
    let x = 0.25 * (next + advance)
    assert(x > 0.5 * next && x < 0.5 * advance)
    assert(font.offset_at("AV", 1.0, x) == 1)
    assert(abs(font.caret_at("AV", 1.0, 1) - next) < 1.0e-6)
}

/// The two fonts, and where their glyphs are in one atlas: `width` × `height` texels.
pub struct Fonts: Clone {
    pub sans: Font,
    pub mono: Font,
    pub width: u32,
    pub height: u32,
}

/// Each glyph's place in an atlas `width` texels wide, shelf by shelf: the glyphs in order,
/// each shelf as tall as its tallest, a texel apart so filtering doesn't bleed. Returns the
/// height used.
fn pack(font: mut Font, width: u32, start: u32) -> u32 {
    var x = 1
    var y = start
    var shelf = 0
    for i in 0..font.count() {
        let g = font.glyph(i)
        if x + g.width + 1 > width {
            x = 1
            y += shelf + 1
            shelf = 0
        }
        font.place(i, x, y)
        x += g.width + 1
        shelf = max(shelf, g.height)
    }
    y + shelf + 1
}

impl Fonts {
    /// Both fonts, their glyphs placed in an atlas 1024 texels wide.
    pub fn load() -> Fonts {
        var sans = Font::of(Face::Sans)
        var mono = Font::of(Face::Mono)
        let width = 1024
        let mid = pack(mut sans, width, 1)
        let height = pack(mut mono, width, mid)
        Fonts { sans, mono, width, height }
    }

    /// Two application-selected faces. `Sans` selects the first; `Mono` selects the second.
    /// The default loader keeps the studio's proportional/source pair.
    pub fn from_baked(first: Baked, second: Baked) -> Fonts {
        var sans = Font::from_baked(first)
        var mono = Font::from_baked(second)
        let width = 1024
        let mid = pack(mut sans, width, 1)
        let height = pack(mut mono, width, mid)
        Fonts { sans, mono, width, height }
    }

    pub fn font(self, face: Face) -> borrow Font {
        match face {
            Face::Sans => self.sans,
            Face::Mono => self.mono,
        }
    }

    /// The atlas's texels, RGBA8 with each glyph's field in red, rows from the top.
    pub fn atlas(self) -> Vec<u8> {
        var bytes: Vec<u8> = Vec::filled(self.width * self.height * 4, 0)
        for f in 0..2 {
            borrow font = self.font(if f == 0 { Face::Sans } else { Face::Mono })
            for i in 0..font.count() {
                let g = font.glyph(i)
                for row in 0..g.height {
                    let base = ((g.atlas_y + row) * self.width + g.atlas_x) * 4
                    for col in 0..g.width {
                        let v = font.field_byte(i, row * g.width + col)
                        bytes[base + col * 4] = v
                        bytes[base + col * 4 + 3] = 255
                    }
                }
            }
        }
        bytes
    }
}

@test
fn caller_fonts_keep_their_own_fields_and_atlas_places() {
    var glyphs: Vec<ttf::BakedGlyph> = Vec::new()
    glyphs.push(
        ttf::BakedGlyph {
            codepoint: 63,
            advance: 0.5,
            left: 0.0,
            top: 1.0,
            width: 2,
            height: 1,
            offset: 0,
        },
    )
    var first = Baked {
        em: 9.0,
        spread: 2.0,
        ascender: 0.8,
        descender: -0.2,
        line_gap: 0.0,
        glyphs,
        kerning: Vec::new(),
        fields: Vec::filled(2, 17),
    }
    var second = first.clone()
    second.fields[0] = 231
    let fonts = Fonts::from_baked(first, second)
    first.fields[0] = 0
    assert(fonts.sans.field_byte(i: 0, k: 0) == 17)
    assert(fonts.mono.field_byte(i: 0, k: 0) == 231)
    let bytes = fonts.atlas()
    let a = fonts.sans.glyph(0)
    let b = fonts.mono.glyph(0)
    assert(a.atlas_y != b.atlas_y)
    assert(bytes[(a.atlas_y * fonts.width + a.atlas_x) * 4] == 17)
    assert(bytes[(b.atlas_y * fonts.width + b.atlas_x) * 4] == 231)
}
