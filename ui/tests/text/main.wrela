// Test strings at 10 to 72 pixels per em, in both fonts, white on a dark grey, each line's top
// at a known place. tests.wrela draws them on the GPU and compares them with a reference
// rasterizer's picture of the same glyphs at the same places (goldens/reference.png); this
// module's tests pin what that picture was made from: the fonts' bakes and the lines' layout.

use std::gpu::{begin_screen_pass}
use std::hash::Hasher
use ui::draw::{DrawList, Renderer}
use ui::text::{Face, Font, Fonts}

/// The lines: their font, their size, and the top of each, from the screen's top.
pub const SIZES: [f32; 7] = [10.0, 12.0, 16.0, 24.0, 32.0, 48.0, 72.0]
const LATIN: Text = "The quick brown fox jumps over the lazy dog: 0123456789"
const MORE: Text = "Grüße, Æsir! ¿Qué? £5 © ÿ ñ ß Ø"

/// The layout's hash (`layout_hash`) when the reference picture was drawn.
const LAYOUT: u64 = 8046416755935635671

pub struct Scene {
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
}

pub fn init() -> Scene {
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    Scene { fonts, renderer, list: DrawList::new() }
}

/// Where line `i` of a face's lines starts: x 10, and its top.
pub fn line_top(face: u32, i: u32) -> f32 {
    var y = 10.0 + f32(face) * 700.0
    for k in 0..i {
        y += SIZES[k / 2] * 1.4 + 6.0
    }
    y
}

pub fn frame(state: mut Scene, time: f32, width: u32, height: u32) {
    let screen = vec2(f32(width), f32(height))
    state.list.clear(screen)
    for f in 0..2 {
        for i in 0..14 {
            let _ = state.list.text(
                state.fonts,
                face_of(f),
                line_text(i),
                SIZES[i / 2],
                vec2(10.0, line_top(f, i)),
                vec4(1.0, 1.0, 1.0, 1.0),
            )
        }
    }
    state.renderer.upload(state.list)
    let screen_pass = begin_screen_pass(clear: vec4(0.1, 0.1, 0.12, 1.0))
    state.renderer.draw(screen_pass, screen)
    screen_pass.present()
}

fn face_of(face: u32) -> Face {
    if face == 0 { Face::Sans } else { Face::Mono }
}

/// Line `i`'s text: the Latin line, then the line past ASCII, in turn.
fn line_text(i: u32) -> Text {
    if i % 2 == 0 { LATIN } else { MORE }
}

/// The bytes of the face's fields.
fn field_bytes(face: u32) -> u32 {
    Font::of(face_of(face)).field_bytes()
}

/// All glyph field bytes, in order: a regression for the baker's exact output.
fn field_hash(face: u32) -> u64 {
    let font = Font::of(face_of(face))
    var h = Hasher::new()
    h.write_u32(font.field_bytes())
    for i in 0..font.count() {
        let glyph = font.glyph(i)
        for k in 0..glyph.width * glyph.height {
            h.write_u32(u32(font.field_byte(i, k)))
        }
    }
    h.finish()
}

/// The layout's hash: each face's ascender, then each line's glyphs' pens (pixels from the
/// left), as the line is laid out from x 10.
fn layout_hash() -> u64 {
    var h = Hasher::new()
    for f in 0..2 {
        let font = Font::of(face_of(f))
        h.write_u32(bitcast_u32(font.ascender))
        for i in 0..14 {
            let _ = font.walk(line_text(i), SIZES[i / 2], 10.0, |_i, _g, x| {
                h.write_u32(bitcast_u32(x))
                true
            })
        }
    }
    h.finish()
}

/// The package's tool, which does nothing: its tool tests are in tests.wrela.
pub fn tool() -> u32 {
    0
}

/// The build bakes each font from its file (ui/ttf.wrela), into at most 200 KB of fields: what
/// a font adds to a build. Every baked byte matches the original per-segment-distance baker:
/// choosing the nearest squared distance must not change its output.
@test
fn the_fonts_are_baked_small() {
    let hashes = [17162884810785632069, 7364730740798196822]
    for face in 0..2 {
        let bytes = field_bytes(face)
        assert(bytes > 100 * 1024 && bytes <= 200 * 1024, f"face {face}: {bytes} bytes of fields")
        assert(field_hash(face) == hashes[face], f"face {face}: baked fields changed")
    }
}

/// The reference picture (goldens/reference.png) was drawn by a reference rasterizer (ab_glyph
/// 0.2) with the glyphs at this layout's pens and baselines: if the layout changes, the picture
/// is another's, and must be drawn again (docs/process.md says how).
@test
fn the_reference_is_of_this_layout() {
    assert(layout_hash() == LAYOUT, f"the layout changed: {layout_hash()}")
}
