// The great tree (#28 §1, §9): a short, broad trunk on its rise, roots grown into it, five limbs
// leaving it at their own heights, and a crown in masses at their ends. Limbs along curves and
// clumps of leaves, as `engine::plant` grows a plant; its cards, impostor and volume are cooked
// from this, as the clearing loads.

use engine::noise::{pick, rand}
use engine::plant::{Bark, Leaves, Plant, limb_axis, limb_at_height, plant}
use std::math::TAU

/// The great tree, its base at the origin.
pub fn great_tree() -> Plant {
    // Old bark: darker than a young tree's, so the trunk stays a shape in shade under the crown;
    // deep furrows broken into blocks, as an old oak's.
    let bark = Bark {
        dark: vec3(0.06, 0.047, 0.036),
        light: vec3(0.21, 0.17, 0.125),
        grain: vec3(0.65, 0.35, 0.0),
        relief: 1.5,
    }
    var p = plant(leaves: Leaves { size: 0.5, cover: 1.9 }, bark: bark)
    let base = vec3(0.0, -0.3, 0.0)
    let fork = base + vec3(0.215, 4.2, -0.1)
    // The trunk, one tube: from below the ground (its rounded end out of sight), flared at its
    // root, tapering to past the highest limb, where the crown hides its closing tip.
    let top = fork + vec3(0.0, 2.2, 0.0)
    p.tube(
        [base - vec3(0.0, 0.9, 0.0), base + vec3(0.0, 0.6, 0.0), mix(base, top, vec3(0.45)), top],
        [1.6, 1.2, 0.9, 0.5],
    )
    // Roots (`Plant::root`), from a trunk about 1.1 m thick at its foot.
    for k in 0..6 {
        let a = TAU * (f32(k) + 0.5 * rand(29, k)) / 6.0
        let dir = vec3(cos(a), 0.0, sin(a))
        let out = pick(29, 10 + k, lo: 3.2, hi: 4.8)
        let across = vec3(-dir.z, 0.0, dir.x) * pick(29, 20 + k, lo: -0.8, hi: 0.8)
        p.root(
            base,
            dir,
            girth: 1.1,
            out: out,
            across: across,
            r: pick(29, 30 + k, lo: 0.6, hi: 0.85),
        )
    }
    // The limbs: each leaves the trunk at its own height, the lowest reaching farthest and
    // flattest (an oak grown in the open); each one tube that bends at an elbow and tapers
    // into its mass of leaves, forking twice on the way. (All five leaving at one height read as
    // an abrupt fork, the lookdev reviews' F3; two tubes a limb left a blunt, rounded end at the
    // elbow, round 1's blind judges.)
    let heights = [2.6, 4.6, 3.3, 5.4, 3.9]
    var tips = [vec3(0.0); 5]
    for i in 0..5 {
        let a = 2.39996 * f32(i) + 0.4 + pick(31, i, lo: -0.25, hi: 0.25)
        let out = vec3(cos(a), 0.0, sin(a))
        let side = vec3(-out.z, 0.0, out.x)
        let h = heights[i]
        let low = 1.0 - (h - 2.6) / 2.8
        let (foot, trunk_axis, trunk_radius) = limb_at_height(p.limbs[0], base.y + h)
        let elbow = foot +
            out * (2.2 + 1.2 * low) +
            side * pick(32, i, lo: -0.9, hi: 0.9) +
            vec3(0.0, 1.2 + 1.2 * (1.0 - low), 0.0)
        let tip = foot +
            out * (5.0 + 1.6 * low) +
            side * pick(34, i, lo: -0.8, hi: 0.8) +
            vec3(0.0, 3.6 + 1.4 * (1.0 - low) + pick(33, i, lo: -0.6, hi: 0.6), 0.0)
        let r0 = trunk_radius * pick(36, i, lo: 0.55, hi: 0.7)
        p.limb(
            foot,
            elbow * 0.75 + foot * 0.25 + trunk_axis * 0.35,
            tip,
            r_from: r0,
            r_to: 0.10,
        )
        let parent = p.limbs[p.limbs.len() - 1]
        // Unequal laterals leave at different places and follow the parent's growth before
        // turning outward. Their starts use the same curved axis as the rendered scaffold.
        let (left_from, left_axis, left_r) = limb_axis(parent, pick(37, i, lo: 0.4, hi: 0.58))
        let (right_from, right_axis, right_r) = limb_axis(parent, pick(38, i, lo: 0.68, hi: 0.82))
        let left = left_from +
            side * pick(39, i, lo: 1.4, hi: 2.7) +
            out * 1.4 +
            vec3(0.0, pick(40, i, lo: 1.2, hi: 2.4), 0.0)
        let right = right_from -
            side * pick(42, i, lo: 0.9, hi: 2.0) +
            out * 1.2 +
            vec3(0.0, pick(44, i, lo: 0.8, hi: 1.6), 0.0)
        p.limb(
            left_from,
            left_from + left_axis * 0.9 + (left - left_from) * 0.3,
            left,
            r_from: left_r * 0.6,
            r_to: 0.04,
        )
        p.limb(
            right_from,
            right_from + right_axis * 0.65 + (right - right_from) * 0.3,
            right,
            r_from: right_r * 0.5,
            r_to: 0.025,
        )
        p.clump(left + vec3(0.0, 0.5, 0.0), radius: pick(49, i, lo: 1.8, hi: 2.4))
        p.clump(right + vec3(0.0, 0.5, 0.0), radius: pick(51, i, lo: 1.8, hi: 2.4))
        tips[i] = tip
    }
    // The crown: a mass of clumps round each limb's end, raised over it, and one over the
    // trunk's top; gaps of sky between the masses, their undersides open.
    for i in 0..34 {
        let mass = i % 6
        let centre = if mass == 5 { top + vec3(0.0, 7.0, 0.0) } else {
            tips[mass] + vec3(0.0, 0.8, 0.0)
        }
        let spread = if mass == 5 { 2.6 } else { 2.2 }
        let a = TAU * rand(43, i)
        let r = spread * sqrt(rand(41, i))
        let at = centre + vec3(r * cos(a), pick(45, i, lo: -0.6, hi: 1.4), r * sin(a))
        p.clump(at, radius: pick(47, i, lo: 2.1, hi: 3.1))
    }
    p
}

@test
fn great_tree_laterals_grow_from_the_scaffold_axis() {
    let p = great_tree()
    // One trunk and six roots precede the five scaffolds and their two laterals.
    for i in 0..5 {
        let parent = p.limbs[7 + 3 * i]
        for j in 1..3 {
            let child = p.limbs[7 + 3 * i + j]
            var nearest = 1.0e6
            for sample in 0..128 {
                let (at, _, radius) = limb_axis(parent, f32(sample) / 127.0)
                nearest = min(nearest, length(child.points[0] - at) - radius)
            }
            assert(nearest < 0.005, "hero tree lateral is detached from its scaffold")
            assert(child.radii[0] < parent.radii[0] * 0.65, "lateral competes with the scaffold")
        }
    }
}
