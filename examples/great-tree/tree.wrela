// The great tree (#28 §1, §9): a short, broad trunk on its rise, five limbs, and a wide dome of
// clumps. Limbs along curves and clumps of leaves, as `engine::plant` grows a plant; its cards,
// impostor and volume are cooked from this, as the clearing loads.

use engine::noise::{pick, rand}
use engine::plant::{Bark, Leaves, Plant, plant}
use std::math::TAU

/// The great tree, its base at the origin.
pub fn great_tree() -> Plant {
    // Old bark: darker than a young tree's, so the trunk stays a shape in shade under the crown.
    let bark = Bark { dark: vec3(0.085, 0.065, 0.05), light: vec3(0.19, 0.155, 0.115) }
    var p = plant(leaves: Leaves { size: 0.5, cover: 1.9 }, bark: bark)
    let base = vec3(0.0, -0.3, 0.0)
    let fork = base + vec3(0.215, 4.2, -0.1)
    // The trunk, one tube: from below the ground (its rounded end out of sight), flared at its
    // root, tapering to past the fork, where the limbs hide its closing tip.
    let top = fork + vec3(0.0, 1.4, 0.0)
    p.tube(
        [base - vec3(0.0, 0.9, 0.0), base + vec3(0.0, 0.6, 0.0), mix(base, top, vec3(0.45)), top],
        [1.6, 1.2, 0.9, 0.62],
    )
    let dome = base + vec3(0.0, 9.6, 0.0)
    for i in 0..5 {
        let a = TAU * (f32(i) + 0.3) / 5.0 + pick(31, i, lo: -0.3, hi: 0.3)
        let out = vec3(cos(a), 0.0, sin(a))
        let mid = fork + out * 3.2 + vec3(0.0, 2.6, 0.0)
        let tip = fork + out * 6.6 + vec3(0.0, 4.4 + pick(33, i, lo: -0.8, hi: 0.8), 0.0)
        p.limb(fork, mix(fork, mid, vec3(0.5)) + vec3(0.0, 0.3, 0.0), mid, r_from: 0.6, r_to: 0.4)
        p.limb(mid, mix(mid, tip, vec3(0.5)) + vec3(0.0, 0.2, 0.0), tip, r_from: 0.4, r_to: 0.18)
        let side = vec3(-out.z, 0.0, out.x)
        p.straight(mid, mid + side * 2.2 + out * 1.5 + vec3(0.0, 2.0, 0.0), r_from: 0.2, r_to: 0.09)
        p.straight(
            mid,
            mid - side * 2.0 + out * 1.8 + vec3(0.0, 1.4, 0.0),
            r_from: 0.18,
            r_to: 0.08,
        )
        let low = fork + out * 1.6 + vec3(0.0, 0.8, 0.0)
        p.straight(low, low + out * 3.2 + side * 0.8 + vec3(0.0, 0.9, 0.0), r_from: 0.2, r_to: 0.07)
    }
    // The crown: six masses, one over each limb's end and one at the top of the dome, each a
    // large core with smaller clumps bulging from its top and sides, few from below: a wide,
    // flat-topped dome that reads as lit masses over shaded undersides, open underneath. (M6's
    // lookdev pass 1: 34 clumps spread evenly over the dome read as one even blob of leaves.)
    p.blend = 0.75
    for m in 0..6 {
        let centre = if m == 5 {
            dome + vec3(0.6, 1.2, -0.4)
        } else {
            let a = TAU * (f32(m) + 0.3) / 5.0 + pick(31, m, lo: -0.3, hi: 0.3)
            fork + vec3(cos(a) * 6.4, 5.6 + pick(33, m, lo: -0.8, hi: 0.8), sin(a) * 6.4)
        }
        p.clump(centre, radius: pick(45, m, lo: 3.3, hi: 3.9))
        for i in 0..4 {
            let k = m * 4 + i
            let a = TAU * rand(43, k)
            let up = pick(41, k, lo: -0.2, hi: 0.9)
            let out = sqrt(max(1.0 - up * up, 0.0))
            let dir = vec3(out * cos(a), up, out * sin(a))
            p.clump(
                centre + dir * pick(49, k, lo: 2.2, hi: 3.0),
                radius: pick(47, k, lo: 1.9, hi: 2.7),
            )
        }
    }
    p
}
