// What the map lens (`wrela studio examples/last-green`, #55 AC13) reads of the floor: its map as
// its literals say now, its ground, its preview (the history at the preview's grain, checked as
// the bake is: with the crowns as they're drawn and the built things), and its geology. The game
// never calls these, so none of it is in its build.

use engine::footing::obstacles_of
use engine::grow::{Ground, PREVIEW, simulate}
use engine::interest::{Evidence, Preview, QUICK, check}
use engine::landform::{Landscape, Survey}
use engine::place::Map

/// The floor's map.
pub fn map() -> Map {
    map::map()
}

/// The ground's height at `p`.
pub fn height(p: vec2) -> f32 {
    Ground::height(ground::GROUND, p.x, p.y)
}

/// The preview: the history at the preview's grain over the history's domain, and the check on
/// it (`interest::QUICK`), with the streams it found.
pub fn preview() -> Preview {
    let m = map::map()
    let lo = history::domain_lo()
    let hi = history::domain_hi()
    let st = stones::stones(m)
    let h = simulate(
        ground::GROUND,
        m,
        species::habits(),
        PREVIEW,
        lo,
        hi,
        st,
        history::past,
    )
    let streams = h.streams.clone()
    let o = obstacles_of(h.trees, species::habits(), h.streams, st, stones::walls(m), lo, hi)
    var e = Evidence::of(h)
    e.crowns = trees::drawn_crowns(e.trees)
    e.solids = blockouts::solids(m)
    Preview { checked: check(ground::GROUND, m, species::habits(), e, o, st, QUICK), streams }
}

/// The far land as its making left it (`geology::made`), for the lens.
@fuel(2 ** 40)
const FAR_LAND: Landscape = geology::made()

/// The floor's geology as an agent surveys it: its far land as its making left it, how much each
/// cell rose or sank over the sketch, the ground over the same cells as the game draws it, and the
/// cells where the relief holds whole.
pub fn geology() -> Survey {
    borrow g = ground::GROUND
    let grid = FAR_LAND.grid
    Survey {
        made: FAR_LAND.clone(),
        rise: Vec::from_fn(grid.cells(), |c| g.far.rise(c)),
        surface: Vec::from_fn(grid.cells(), |c| {
            let p = grid.centre(c)
            g.natural(p.x, p.y)
        }),
        counted: Vec::from_fn(grid.cells(), |c| {
            let p = grid.centre(c)
            geology::far_weight(g.far, p, ground::past_edge(p)) == 1.0
        }),
    }
}
