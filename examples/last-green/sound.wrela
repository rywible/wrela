// The Last Green's sound (M5.5, #49): what its ground, its water and its wind sound like on
// engine::sound's mixer, and the cues its frame sends the mixer: where the ears are, the
// player's steps on what's underfoot, the grass and the water it pushes through, the wind
// there, and the water near.
//
// The ears are at the camera, facing as it faces; the steps at the player's feet. Every place
// is in the world (not render space), so a ringing step doesn't jump when the render origin
// moves.

use climber::moves::drift_rate
use climber::sounds::{IMPACTS, WHOOSHES}
use engine::place::{Map, Water}
use engine::plant::{Wind, gust}
use engine::sound::{Babble, Breath, Cue, Mixer, Palette, Surface, WATERS, mix, mixer}
use ground::{CLOSED, Ground}
use provenance::{NearTile, fields_at}
use std::audio::{RingWriter, play}

/// What's underfoot (the floor's surfaces: `PALETTE.surfaces`' order).
pub const GRASS: u32 = 0
pub const LITTER: u32 = 1
pub const PATH: u32 = 2
pub const ROCK: u32 = 3
pub const GRAVEL: u32 = 4
pub const SHALLOWS: u32 = 5
pub const BARE: u32 = 6

/// The floor's water (`PALETTE.waters`' order), and its brushes'.
pub const MERE: u32 = 0
pub const STREAM: u32 = 1
pub const FALLS: u32 = 2
pub const POOL: u32 = 3
pub const THROUGH_GRASS: u32 = 0
pub const THROUGH_WATER: u32 = 1
pub const HEM: u32 = 2

/// How the floor sounds. A step's knock is the foot's weight on the ground (deep and dull on
/// soft ground, higher and sharper on rock); its grit is what the ground is made of (grass's
/// swish, dry leaves' crackle, grit on a path, gravel, a splash).
pub const PALETTE: Palette = Palette {
    surfaces: [
        // Meadow grass: soft, a swish of blades.
        Surface {
            knock_hz: 70.0,
            knock_t60: 0.06,
            knock: 0.08,
            grit_hz: 3200.0,
            grit_q: 0.6,
            grit_t60: 0.16,
            grit: 0.10,
        },
        // Leaf litter and moss: a dull thud, dry leaves crackling.
        Surface {
            knock_hz: 80.0,
            knock_t60: 0.07,
            knock: 0.10,
            grit_hz: 4200.0,
            grit_q: 0.9,
            grit_t60: 0.22,
            grit: 0.16,
        },
        // A path's packed earth: a firm thud, a little grit.
        Surface {
            knock_hz: 110.0,
            knock_t60: 0.06,
            knock: 0.16,
            grit_hz: 2400.0,
            grit_q: 1.2,
            grit_t60: 0.07,
            grit: 0.06,
        },
        // Rock: a short, higher knock, a click of grit.
        Surface {
            knock_hz: 260.0,
            knock_t60: 0.035,
            knock: 0.18,
            grit_hz: 5200.0,
            grit_q: 1.6,
            grit_t60: 0.03,
            grit: 0.08,
        },
        // A stream's bed: gravel shifting, wet.
        Surface {
            knock_hz: 150.0,
            knock_t60: 0.05,
            knock: 0.08,
            grit_hz: 2800.0,
            grit_q: 0.8,
            grit_t60: 0.14,
            grit: 0.18,
        },
        // Shallow water: a splash, no knock.
        Surface {
            knock_hz: 90.0,
            knock_t60: 0.04,
            knock: 0.02,
            grit_hz: 1500.0,
            grit_q: 0.5,
            grit_t60: 0.30,
            grit: 0.22,
        },
        // Bare ground.
        Surface {
            knock_hz: 95.0,
            knock_t60: 0.06,
            knock: 0.14,
            grit_hz: 2600.0,
            grit_q: 1.0,
            grit_t60: 0.08,
            grit: 0.07,
        },
        Surface {
            knock_hz: 95.0,
            knock_t60: 0.06,
            knock: 0.14,
            grit_hz: 2600.0,
            grit_q: 1.0,
            grit_t60: 0.08,
            grit: 0.07,
        },
    ],
    waters: [
        // The mere: a quiet lapping at its shore, low, in slow swells.
        Babble { lo_hz: 150.0, hi_hz: 900.0, level: 0.02, rate: 0.6, depth: 0.9 },
        // A stream: a babble, brighter, quick and uneven.
        Babble { lo_hz: 500.0, hi_hz: 5000.0, level: 0.08, rate: 6.0, depth: 0.6 },
        // The falls: a roar, broad and steady, heard from far.
        Babble { lo_hz: 120.0, hi_hz: 3500.0, level: 0.09, rate: 1.5, depth: 0.15 },
        // A spring's pool, or the plunge pool's edge: a trickle.
        Babble { lo_hz: 900.0, hi_hz: 6000.0, level: 0.03, rate: 8.0, depth: 0.8 },
    ],
    brushes: [
        // Pushing through grass and the wood's floor's plants: a high swish.
        Babble { lo_hz: 1800.0, hi_hz: 8000.0, level: 0.06, rate: 3.0, depth: 0.5 },
        // Wading: water round the legs, low and swirling.
        Babble { lo_hz: 250.0, hi_hz: 2200.0, level: 0.12, rate: 2.5, depth: 0.6 },
        // The climber's hem dragging over the ground: a soft, slow hush of cloth, under the
        // touches and the beds.
        Babble { lo_hz: 300.0, hi_hz: 2500.0, level: 0.02, rate: 1.2, depth: 0.4 },
    ],
    // The fight's (`climber::sounds`): its blows and its blade's swings.
    impacts: IMPACTS,
    whooshes: WHOOSHES,
    // The wind: a low rush in the open, a soft hush under the trees; under the steps and the
    // water, a bed that's there when listened for.
    wind: Breath { rush_hz: 300.0, rush: 0.05, leaves_hz: 1400.0, leaves: 0.025 },
    near: 2.0,
    gain: 2.5,
}

/// The step's surface at `at` (normal `n`), from the ground and the history's fields there `f`
/// (as `provenance::cover_name` names it), with water `wading` deep over it (m).
pub fn surface_at(g: Ground, at: vec3, n: vec3, f: vec4, wading: f32) -> u32 {
    if wading > 0.05 {
        return SHALLOWS
    }
    if f.z > engine::bake::STREAM_BED {
        return GRAVEL
    }
    if g.rocky(at.xz, n) > 0.5 {
        return ROCK
    }
    if f.y > 0.5 {
        return PATH
    }
    if f.x >= 0.0 && f.x < CLOSED {
        return LITTER
    }
    let c = engine::terrain::Terrain::cover_with(g, at, n, f)
    if c.grass > 0.1 { GRASS } else { BARE }
}

/// How much foliage is round `at` to hiss in the wind (0 the open, 1 a closed canopy), from the
/// history's light at the ground `f.x`; past the tiles (the wildwood), most of it.
pub fn canopy(f: vec4) -> f32 {
    if f.x < 0.0 { 0.8 } else { 1.0 - smoothstep(CLOSED * 0.6, 0.9, f.x) }
}

/// A water source near the ears: which (its number among the floor's), its kind, the nearest
/// point of it to the ears, and how loud it flows (0 to 1).
pub struct Heard: Copy {
    pub id: u32,
    pub kind: u32,
    pub at: vec3,
    pub flow: f32,
}

/// The nearest point to `p` on the segment from `a` to `b`.
fn nearest_on(p: vec2, a: vec2, b: vec2) -> vec2 {
    let d = b - a
    let t = clamp(dot(p - a, d) / max(dot(d, d), 1e-6), 0.0, 1.0)
    a + t * d
}

/// The water sources the ears at `ears` (in the world) hear best, at most `WATERS`: each of the
/// streams and falls (`courses`, each a line of points x, z, width, depth) at its nearest point,
/// the meres at their nearest shore, and the pools, ranked by how loud each is there. A stream's
/// or a pool's point is put at the height `ground` (the ground under the feet): the ground's
/// height is costly to work out, and a source's height matters little to how it's heard.
pub fn heard(
    ears: vec3,
    courses: [engine::water::Course],
    pools: [vec4],
    w: Water,
    ground: f32,
) -> Bounded<Heard, WATERS> {
    var best: Bounded<Heard, WATERS> = Bounded::new()
    var loudness = [0.0; WATERS]
    let p = ears.xz
    let consider = |h: Heard| {
        let level = PALETTE.waters[h.kind].level * h.flow / max(length(h.at - ears), PALETTE.near)
        // Too faint to hear: below -80 dB.
        if level < 1e-4 {
            return
        }
        if best.len() < WATERS {
            loudness[best.len()] = level
            best.push(h)
            return
        }
        var quietest = 0
        for i in 1..WATERS {
            if loudness[i] < loudness[quietest] {
                quietest = i
            }
        }
        if level > loudness[quietest] {
            loudness[quietest] = level
            best[quietest] = h
        }
    }
    for c in 0..courses.len() {
        borrow pts = courses[c].points
        var near = vec2(1.0e9)
        var width = 1.0
        for i in 1..pts.len() {
            let q = nearest_on(p, pts[i - 1].xy, pts[i].xy)
            if length(q - p) < length(near - p) {
                near = q
                width = pts[i].z
            }
        }
        if pts.len() >= 2 {
            let kind = if courses[c].falls { FALLS } else { STREAM }
            let flow = clamp(width / 3.0, 0.3, 1.0)
            consider(Heard { id: c, kind, at: vec3(near.x, ground, near.y), flow })
        }
    }
    let first_mere = courses.len()
    for i in 0..2 {
        let m = w.meres[i]
        if m.z > 0.0 {
            let d = p - m.xy
            let shore = if length(d) > m.z { m.xy + m.z * normalize(d) } else { p }
            consider(
                Heard {
                    id: first_mere + i,
                    kind: MERE,
                    at: vec3(shore.x, m.w, shore.y),
                    flow: 1.0,
                },
            )
        }
    }
    for i in 0..pools.len() {
        let q = pools[i]
        let d = p - q.xy
        let edge = if length(d) > q.z { q.xy + q.z * normalize(d) } else { p }
        consider(
            Heard {
                id: first_mere + 2 + i,
                kind: POOL,
                at: vec3(edge.x, ground, edge.y),
                flow: 1.0,
            },
        )
    }
    best
}

/// The pace at which the hem's touches are heaviest, and the pace past which the climber isn't
/// walking (the play harness's glides): no touches.
const RUN: f32 = 5.0
const GLIDING: f32 = 7.0

/// How long the hem's hush takes to come to a new pace (s): it rises and falls slowly, as cloth
/// does.
const HEM_EASE: f32 = 0.5

/// How far the climber goes between two touches of its hem on the ground at `speed` (m/s): two
/// a round of its float (`climber::moves::drift_rate`), so the touches keep time with the cape.
pub fn touch_every(speed: f32) -> f32 {
    max(speed, 0.5) / (2.0 * drift_rate(speed))
}

/// The floor's ears: the ring to the mixer, the water sources in its slots (by their `Heard::id`,
/// or none), the feet and the time as the last frame had them, how far the feet have gone since
/// the hem's last touch (in strides), and how loud the hem's hush is (0 to 1).
pub struct Hearing {
    cues: RingWriter<Cue>,
    pub(package) slots: [u32; 4],
    feet: vec3,
    time: f32,
    walked: f32,
    pub(package) hem: f32,
    started: bool,
    /// How many steps, by surface (tests and the play harness), and in all.
    pub steps: [u32; 8],
    taken: u32,
}

/// No water source.
const NOBODY: u32 = 4294967295

/// The floor's ears, and its mixer (for a test to render, as the voice would), its noise seeded
/// with `seed`.
pub fn listen(seed: u32 = 7) -> (Hearing, Mixer) {
    let (cues, m) = mixer(PALETTE, seed)
    (
        Hearing {
            cues,
            slots: [NOBODY; 4],
            feet: vec3(0.0),
            time: 0.0,
            walked: 0.0,
            hem: 0.0,
            started: false,
            steps: [0; 8],
            taken: 0,
        },
        m,
    )
}

/// The floor's ears, and its voice started.
pub fn start() -> Hearing {
    let (h, m) = listen()
    play(take m, mix)
    take h
}

/// A cue from another of the floor's parts (a sound a thing makes), sent with the frame's.
pub fn cue(h: mut Hearing, c: Cue) {
    let _ = h.cues.push(c)
}

/// What the ears and the feet are this frame (all in the world): the eye and the way it faces
/// on the plane; the feet, the ground's normal under them, the history's fields there, the water
/// over the ground there (m); the wind; the frame's time (s).
pub struct Moment: Copy {
    pub eye: vec3,
    pub facing: vec2,
    pub feet: vec3,
    pub normal: vec3,
    pub fields: vec4,
    pub wading: f32,
    pub wind: Wind,
    pub time: f32,
}

/// The moment of a frame with the eye at `eye` facing `facing` and the feet at `feet` (all in
/// the world; the feet on the ground), the history's fields from the tiles `grounds` near, the wind `wind`, at `time`.
pub fn moment(
    eye: vec3,
    facing: vec2,
    feet: vec3,
    grounds: [NearTile],
    wind: Wind,
    time: f32,
) -> Moment {
    let g = world::GROUND
    let wading = max(
        engine::footing::mere_depth(world::MAP.water, feet.xz, feet.y),
        history::OBSTACLES.depth(feet.xz),
    )
    Moment {
        eye,
        facing,
        feet,
        normal: engine::terrain::Terrain::normal(g, feet.x, feet.z, 0.5),
        fields: fields_at(grounds, feet.xz),
        wading,
        wind,
        time,
    }
}

/// A frame's sound: the water near `m`'s ears found, and the frame's cues sent.
pub fn frame(h: mut Hearing, m: Moment) {
    borrow waters = history::COURSES
    let near = heard(m.eye, waters.courses, waters.pools, world::MAP.water, m.feet.y)
    hear(mut h, m, near)
}

/// The cues for one frame: the ears, a touch of the hem if its stride has come round, the hem's
/// hush, what the climber pushes through, the wind at the ears, and the water sources `near` (from
/// `heard`), each kept in the slot it had.
pub fn hear(h: mut Hearing, m: Moment, near: Bounded<Heard, WATERS>) {
    h.cues.push(Cue::Listen { at: m.eye, forward: m.facing })
    let moved = length((m.feet - h.feet).xz)
    let dt = m.time - h.time
    let speed = if dt > 0.0 { moved / dt } else { 0.0 }
    var going = 0.0
    if !h.started || speed > GLIDING {
        h.started = true
        h.walked = 0.0
    } else {
        going = clamp(speed / RUN, 0.0, 1.0)
        // The way to the next touch, as a share of the stride at this pace.
        h.walked += moved / touch_every(speed)
        if h.walked >= 1.0 {
            h.walked -= 1.0
            let s = surface_at(world::GROUND, m.feet, m.normal, m.fields, m.wading)
            h.steps[s] += 1
            // Seeded by how many touches the floor's ears have heard: a replay's sound the same.
            h.taken += 1
            h.cues.push(
                Cue::Step { at: m.feet, surface: s, weight: 0.35 + 0.65 * going, seed: h.taken },
            )
        }
    }
    h.feet = m.feet
    h.time = m.time
    // Pushing through grass and the wood's floor's plants (and thorn), or through water.
    let c = engine::terrain::Terrain::cover_with(world::GROUND, m.feet, m.normal, m.fields)
    let plants = clamp(c.grass * (0.5 + c.tall) + max(m.fields.w, 0.0), 0.0, 1.0)
    let water = smoothstep(0.05, 0.5, m.wading)
    h.cues.push(
        Cue::Brush { brush: THROUGH_GRASS, at: m.feet, amount: going * plants * (1.0 - water) },
    )
    h.cues.push(Cue::Brush { brush: THROUGH_WATER, at: m.feet, amount: going * water })
    // The hem's hush on any ground but water, eased so it rises and falls smoothly.
    if dt > 0.0 {
        h.hem += (going * (1.0 - water) - h.hem) * min(dt / HEM_EASE, 1.0)
    }
    h.cues.push(Cue::Brush { brush: HEM, at: m.feet, amount: h.hem })
    let g = gust(m.wind, m.eye.xz, m.time) * m.wind.strength / 0.035
    h.cues.push(Cue::Wind { gust: g, toward: m.wind.dir, leaves: canopy(m.fields) })
    // Each source keeps its slot while it's heard; a new one takes a slot let go.
    var placed = [false; 4]
    // A slot let go this frame isn't taken again until the next: its source's gain comes down
    // over this frame's first quantum, and the new one's rises from 0 over the next frame's.
    var freed = [false; 4]
    for slot in 0..WATERS {
        var kept = false
        for i in 0..near.len() {
            if near[i].id == h.slots[slot] {
                let w = near[i]
                h.cues.push(Cue::Water { slot, at: w.at, kind: w.kind, flow: w.flow })
                placed[i] = true
                kept = true
            }
        }
        // Let go only once the voice will hear it: a full ring (a voice not yet running) drops
        // the cue, and the slot is let go again next frame.
        if !kept && h.slots[slot] != NOBODY {
            let silenced = Cue::Water { slot, at: vec3(0.0), kind: 0, flow: 0.0 }
            if h.cues.push(silenced) {
                h.slots[slot] = NOBODY
                freed[slot] = true
            }
        }
    }
    for i in 0..near.len() {
        if !placed[i] {
            for slot in 0..WATERS {
                if h.slots[slot] == NOBODY && !freed[slot] && !placed[i] {
                    let w = near[i]
                    h.slots[slot] = w.id
                    h.cues.push(Cue::Water { slot, at: w.at, kind: w.kind, flow: w.flow })
                    placed[i] = true
                }
            }
        }
    }
}
