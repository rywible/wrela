// The floor's own tests (`wrela test examples/last-green`, #55): what the bake leaves, read back
// as the program reads it. They read the bake, so they're long (`suite/last_green.rs`).

use engine::bake::{WEAR_N, decode_tile, reaching, tile_fields, tile_name}
use engine::grow::{BAKE, BESIDE_PATH, Grid, HEAD_ROOM, State, Tree}
use engine::place::{Keeper, Map, TILE}
use engine::terrain::Terrain
use history::{BAKED, decisions, domain_hi, domain_lo, tiles_hi, tiles_lo}

/// The line browsing keeps where tree `t` stands (m; 0 for none), judged as the history judges
/// it: at the middle of the history's cell that holds it, a region's browse line or the head
/// room beside a herd's path.
fn line_at(m: Map, g: Grid, t: Tree) -> f32 {
    let p = g.centre(g.cell_at(t.at))
    let line = m.regions[m.region_of(p)].character.browse_line
    if line > 0.0 {
        return line
    }
    for r in m.routes {
        if r.keeper == Keeper::Grazing && r.distance(p).x < 0.5 * r.width + BESIDE_PATH {
            return HEAD_ROOM
        }
    }
    0.0
}

/// AC2's head room: along the herd's paths (their width and 4 m each side) and in wood pasture
/// (a region with a browse line), no shrub of the history's stands, and no living tree's branch
/// comes below the line: not in the history (its lift), and not as it's drawn (its kind's lowest
/// branch, placed at its height).
@test
fn nothing_grows_into_the_head_room() {
    let m = map::map()
    let g = Grid::over(domain_lo(), domain_hi(), BAKE.cell)
    let habits = species::habits()
    let u = decisions()
    var zoned = 0
    for t in u.trees {
        if t.state != State::Alive || t.pinned {
            continue
        }
        let line = line_at(m, g, t)
        if line <= 0.0 {
            continue
        }
        zoned += 1
        let h = habits[t.kind]
        let at = t.at
        assert(
            !h.thorny && !h.suckers,
            f"a shrub (kind {t.kind}) stands at {at} under a {line} m line",
        )
        assert(t.lift >= line, f"a tree at {at} keeps branches to {t.lift} m under a {line} m line")
        let k = trees::drawn_kind(t)
        let low = trees::lowest_placed(k, t.tall)
        assert(
            low >= line - 0.01,
            f"a tree at {at}, {t.tall} m, drawn as kind {k}: branches to {low} m",
        )
    }
    assert(zoned > 200, f"only {zoned} trees stand where browsing keeps a line")
}

/// AC11's ground cover: over every tile the floor streams, its ground's fields worked out as the
/// program works them out once its neighbours are in (`tile_fields`, with their trees whose
/// crowns reach over its edge), no meadow grass or flowers grow where the history's canopy is
/// closed (the light at the ground under `ground::CLOSED`); and the beech wood's floor is closed
/// over most of it.
@test
fn no_meadow_grass_under_a_closed_canopy() {
    let lo = tiles_lo()
    let hi = tiles_hi()
    let habits = species::habits()
    let m = map::map()
    let g = ground::ground()
    var trees: Vec<Vec<Tree>> = Vec::new()
    for j in lo.y..(hi.y + 1) {
        for i in lo.x..(hi.x + 1) {
            trees.push(
                decode_tile(
                    BAKED.bytes(BAKED.find(tile_name(vec2i(i, j)).as_str()).unwrap()),
                ).trees,
            )
        }
    }
    let nx = hi.x - lo.x + 1
    var closed = 0
    var texels = 0
    var beech_closed = 0
    var beech = 0
    var beech_wood = 0
    for r in 0..m.regions.len() {
        if m.regions[r].name == "the beech wood" {
            beech_wood = r
        }
    }
    for j in lo.y..(hi.y + 1) {
        for i in lo.x..(hi.x + 1) {
            let t = vec2i(i, j)
            let d = decode_tile(BAKED.bytes(BAKED.find(tile_name(t).as_str()).unwrap()))
            var others: Vec<Tree> = Vec::new()
            for dj in -1..2 {
                for di in -1..2 {
                    let n = t + vec2i(di, dj)
                    if (di != 0 || dj != 0) &&
                        n.x >= lo.x &&
                        n.y >= lo.y &&
                        n.x <= hi.x &&
                        n.y <= hi.y {
                        reaching(t, trees[u32((n.y - lo.y) * nx + n.x - lo.x)], mut others)
                    }
                }
            }
            let f = tile_fields(d, others, habits, m.routes, map::PRESENT)
            let cell = TILE / f32(WEAR_N)
            for k in 0..(WEAR_N * WEAR_N) {
                let p = vec2(t) * TILE + (vec2(f32(k % WEAR_N), f32(k / WEAR_N)) + vec2(0.5)) * cell
                if !m.inside(p) {
                    continue
                }
                let fields = vec4(
                    f32(f[4 * k]),
                    f32(f[4 * k + 1]),
                    f32(f[4 * k + 2]),
                    f32(f[4 * k + 3]),
                ) /
                    255.0
                texels += 1
                let in_beech = m.region_of(p) == beech_wood
                if in_beech {
                    beech += 1
                }
                if fields.x < ground::CLOSED {
                    closed += 1
                    if in_beech {
                        beech_closed += 1
                    }
                    let c = g.cover_with(
                        vec3(p.x, g.at(p.x, p.y), p.y),
                        vec3(0.0, 1.0, 0.0),
                        fields,
                    )
                    let flowers = c.flowers.x + c.flowers.y + c.flowers.z + c.flowers.w
                    assert(
                        c.grass == 0.0 && flowers == 0.0,
                        f"meadow grass ({c.grass}) under a closed canopy at {p}, its light {fields.x}",
                    )
                }
            }
        }
    }
    assert(closed > 0 && texels > 0, "no texel of the floor's ground")
    let in_beech = f32(beech_closed) / f32(max(beech, 1))
    assert(in_beech > 0.5, f"the beech wood's canopy is closed over only {in_beech * 100.0}% of it")
}

/// AC9's one surface: the sim's water height (`Laid::surface`: the mesh's triangles binned) and
/// the drawn mesh's (every triangle's plane, as the rasterizer draws it) agree within 1 cm: down
/// every course, across its width (to 0.6 of it each way: a bend's ribbon turns), and over the
/// mere's water. And it lies where it should: a stream's within 10 cm of a skin over the ground
/// (`SKIN`), the mere's at its level.
@test
fn the_water_is_one_surface() {
    let w = map::map().water
    borrow laid = history::WATERS
    var worst = 0.0
    var worst_at = vec2(0.0)
    var samples = 0
    for c in laid.courses {
        var k = 0
        while k + 1 < c.points.len() {
            let a = c.points[k]
            let b = c.points[k + 1]
            let along = normalize(b.xy - a.xy + vec2(1.0e-6, 0.0))
            let side = vec2(-along.y, along.x)
            for i in 0..5 {
                let u = 0.6 * (f32(i) / 2.0 - 1.0)
                let p = mix(a.xy, b.xy, vec2(0.37)) + side * (u * 0.5 * a.z)
                let sim = laid.surface(p)
                let drawn = laid.mesh.height_over(p)
                assert(
                    sim > engine::water::NONE && drawn > engine::water::NONE,
                    f"no water at {p} down a course",
                )
                let skin = sim - world::GROUND.at(p.x, p.y) - engine::water::SKIN
                let ground = world::GROUND.at(p.x, p.y)
                let in_mere = length(p - w.meres[0].xy) <
                    w.meres[0].z * engine::water::MERE_REACH &&
                    ground < w.meres[0].w
                assert(
                    c.falls || in_mere || abs(skin) < 0.1,
                    f"a stream's water at {p} is {skin} m off its skin",
                )
                if abs(sim - drawn) > worst {
                    worst = abs(sim - drawn)
                    worst_at = p
                }
                samples += 1
            }
            k += 7
        }
    }
    for m in w.meres {
        if m.z > 0.0 {
            for i in 0..200 {
                let a = f32(i) * 2.399963
                let p = m.xy + vec2(cos(a), sin(a)) * m.z * sqrt(f32(i) / 200.0)
                if world::GROUND.at(p.x, p.y) < m.w {
                    let sim = laid.surface(p)
                    assert(
                        abs(sim - m.w) < 1.0e-4,
                        f"the mere's water at {p} is at {sim}, not its level {m.w}",
                    )
                    let drawn = laid.mesh.height_over(p)
                    if abs(sim - drawn) > worst {
                        worst = abs(sim - drawn)
                        worst_at = p
                    }
                    samples += 1
                }
            }
        }
    }
    assert(samples > 200, f"only {samples} points of the water")
    assert(worst <= 0.01, f"the sim's water and the drawn are {worst} m apart at {worst_at}")
}

/// AC9's where it is: a course rises at each spring and at the mere's outlet, and one falls from
/// the map's fall, to a pool at its foot; and open water keeps its opening: no tree stands in a
/// mere's water or a stream's course (but at its very edge, as the history's cells judge it:
/// `SHORE`, `BANK`).
@test
fn the_water_is_where_the_map_and_the_flow_put_it() {
    let m = map::map()
    let w = m.water
    borrow laid = history::WATERS
    for i in 0..w.spring_count {
        var rises = false
        for c in laid.courses {
            rises = rises || length(c.points[0].xy - w.springs[i]) < 1.0
        }
        let s = w.springs[i]
        assert(rises, f"no stream rises at the spring at {s}")
    }
    var falls = false
    for c in laid.courses {
        falls = falls || (c.falls && length(c.points[0].xy - w.falls[0]) < 10.0)
    }
    let f = w.falls[0]
    assert(falls, f"no water falls at the map's fall at {f}")
    for t in decisions().trees {
        if t.state == State::Alive || t.state == State::Snag {
            let at = t.at
            let deep = laid.surface(at) - world::GROUND.at(at.x, at.y)
            assert(
                deep <= SHORE && !in_course(laid, at),
                f"a tree stands in the water at {at}, {deep} m deep",
            )
        }
    }
}

/// The water a tree may stand in at a shore or a stream's bank (m deep, or m in from its edge):
/// the history judges a cell of 2 m by its middle.
const SHORE: f32 = 0.1
const BANK: f32 = 1.5

/// Whether `p` is within a stream's course, more than `BANK` in from its edge (not a fall's:
/// past the edge, where no tree is read).
fn in_course(laid: engine::water::Laid, p: vec2) -> bool {
    for c in laid.courses {
        if !c.falls {
            for i in 0..c.points.len() - 1 {
                let a = c.points[i]
                let b = c.points[i + 1]
                let ab = b.xy - a.xy
                let t = clamp(dot(p - a.xy, ab) / max(dot(ab, ab), 1.0e-6), 0.0, 1.0)
                if length(p - (a.xy + ab * t)) < 0.5 * a.z - BANK {
                    return true
                }
            }
        }
    }
    false
}
