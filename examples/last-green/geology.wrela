// The world's geology, the first level its land is made in (`engine::landform`): a dissected
// plateau. An old, level land of bedded rock stands over the lowland round it, a hard grit
// sandstone on top, shale under it with a band of sandstone, and granite bosses through them.
// Over a million years and more its rivers cut back into it from the lowland and the trunk
// valley that crosses it, and its slopes creep; where they're steeper than their rock stands,
// they weather back as fast as the rock lets them, so the grit stands in cliffs over the shale's
// talus. What's left of the plateau
// stands between ravines; its places (summits, tors, overlooks, falls, gorges, springs, lakes and
// the meetings of its streams) are found in it, not drawn, and named for what and where they
// are. The region round the floor is made at 64 m, and the floor's square in it at 8 m; past the
// region the lowland goes on.
//
// The floor's play doesn't stand on this land yet: the bare view (F8's fourth) draws it alone,
// to be judged before what grows on it is.

use engine::grow::Grid
use engine::landform::{
    Feature, Finding, Landscape, PlaceKind, Relief, Shaping, Strength, border, evolve, places,
}
use engine::noise::{fbm2, fbm2_seen, rand}
use engine::look::{CreatureLook, Mesh as Tolerance}
use engine::stone::{Placement, Realized, block_bed, normal_matrix, realize_weathered}
use engine::terrain::{Cover, Terrain}
use ground::{BED, BED_DIP, joints, rock_albedo}
use lookbook::Shot
use std::io::{Shipped, ship}
use std::math::TAU
use std::string::String
use std::transform::{rotate_y, scale, translate}

// ---- the rock ---------------------------------------------------------------------------------

/// The plateau's rock: the grit sandstone that caps it, the shale under that, a band of
/// sandstone, the shale under that, and the granite bosses through them all.
pub enum Stratum: Copy + Eq + Fieldless {
    Grit,
    UpperShale,
    Sandstone,
    LowerShale,
    Granite,
}

/// How the beds lie: their rise per metre along x and z (they dip gently to the south-east),
/// and the height (m, at the origin) of the foot of the grit, of the upper shale and of the
/// sandstone band.
const DIP = vec2(-0.004, 0.003)
const GRIT_FOOT: f32 = 180.0
const SHALE_FOOT: f32 = 122.0
const SANDSTONE_FOOT: f32 = 106.0
/// Two thin bands of sandstone in the shale, each a bench along the valleys' sides: the upper
/// band's foot and top (x, y), the lower's (z, w).
const BENCHES = vec4(166.0, 172.0, 84.0, 92.0)

/// The granite bosses: (x, z, radius).
const BOSSES = [
    vec3(980.0, -760.0, 140.0),
    vec3(130.0, -180.0, 90.0),
    vec3(1450.0, -150.0, 110.0),
    vec3(-2600.0, 1900.0, 260.0),
    vec3(3900.0, -2600.0, 220.0),
    vec3(-1200.0, -4100.0, 300.0),
]

/// How much of `p` is a granite boss's (0 to 1), its edge ragged.
fn granite(p: vec2) -> f32 {
    var g = 0.0
    for b in BOSSES {
        let d = length(p - b.xy) + 0.3 * b.z * (fbm2(p * 0.02 + b.xy * 0.001, 2) - 0.5)
        g = max(g, 1.0 - smoothstep(0.85 * b.z, b.z, d))
    }
    g
}

/// The stratum at `p`, `y` high: the beds, bent a little by a broad fold, or a boss's granite.
pub fn stratum(p: vec2, y: f32) -> Stratum {
    if granite(p) > 0.5 {
        return Stratum::Granite
    }
    let lay = y - dot(p, DIP) + 6.0 * (fbm2(p * 0.0008 + vec2(4.0, 1.0), 2) - 0.5)
    if lay > GRIT_FOOT {
        Stratum::Grit
    } else if lay > BENCHES.x && lay < BENCHES.y {
        Stratum::Sandstone
    } else if lay > SHALE_FOOT {
        Stratum::UpperShale
    } else if lay > SANDSTONE_FOOT || lay > BENCHES.z && lay < BENCHES.w {
        Stratum::Sandstone
    } else { Stratum::LowerShale }
}

/// How easily water cuts each stratum (the stream power law's K, m^0 a year per m of fall: m is
/// 0.5), the slope it stands at (rise over run), how fast a steeper face of it weathers back (m a
/// year) and how much of the land's creep it has: the grit stands in stepped cliffs and the
/// granite steeper, both weathering slowly and hardly creeping; the sandstone stands in steep
/// steps, and the shale only as talus, weathering fast under a soil that creeps.
const STRENGTH: [Strength; Stratum] = [
    Strength { erodibility: 1.4e-6, standing: 1.6, weathering: 2.0e-4, creep: 0.05 },
    Strength { erodibility: 8.0e-6, standing: 0.65, weathering: 2.0e-3, creep: 1.0 },
    Strength { erodibility: 2.4e-6, standing: 1.2, weathering: 6.0e-4, creep: 0.3 },
    Strength { erodibility: 8.0e-6, standing: 0.65, weathering: 2.0e-3, creep: 1.0 },
    Strength { erodibility: 7.0e-7, standing: 3.0, weathering: 1.0e-4, creep: 0.02 },
]

/// The strength of the rock at `p`, `y` high: its stratum's, its joints making it a little
/// weaker or stronger from place to place.
pub fn strength(p: vec2, y: f32) -> Strength {
    let s = STRENGTH[stratum(p, y)]
    let joints = 0.7 + 0.6 * fbm2(p * 0.006 + vec2(-2.0, 7.0), 2)
    Strength { erodibility: s.erodibility * joints, ..s }
}

/// Each stratum's colour where it shows: the grit buff, the shale dark grey, the sandstone
/// brown, the granite grey.
const COLOUR: [vec3; Stratum] = [
    vec3(0.36, 0.31, 0.22),
    vec3(0.17, 0.17, 0.18),
    vec3(0.30, 0.24, 0.17),
    vec3(0.16, 0.16, 0.17),
    vec3(0.30, 0.29, 0.29),
]

// ---- the land before it was cut ----------------------------------------------------------------

/// The middle of the floor's square, which the region is made round.
pub const MIDDLE = vec2(675.0, -525.0)

/// The plateau's old top (m), the lowland's level past it, and how far from the middle the
/// plateau's edge was, from where to where (m).
const PLATEAU: f32 = 214.0
const LOWLAND: f32 = 40.0
const EDGE_FROM: f32 = 5400.0
const EDGE_TO: f32 = 7400.0

/// The lowland past the region, as far as the eye goes: low swells (m).
pub fn lowland(p: vec2) -> f32 {
    LOWLAND + 14.0 * (fbm2(p * 0.0011 + vec2(9.0, 2.0), 4) - 0.5)
}

/// The trunk valley the plateau's rivers run to: its course (x, z), the river falling along it
/// from its first point to its last (m).
const TRUNK = [
    vec2(-7000.0, 3000.0),
    vec2(-3200.0, 1500.0),
    vec2(-1000.0, 400.0),
    vec2(300.0, -300.0),
    vec2(900.0, -700.0),
    vec2(1900.0, -1500.0),
    vec2(4600.0, -4300.0),
    vec2(7800.0, -5200.0),
]
const TRUNK_FROM: f32 = 150.0
const TRUNK_TO: f32 = 45.0

/// How far `p` is from the trunk river (m), and its level at its nearest point.
fn trunk(p: vec2) -> vec2 {
    var best = 1.0e9
    var level = TRUNK_TO
    var along = 0.0
    var total = 0.0
    for i in 0..7 {
        total += length(TRUNK[i + 1] - TRUNK[i])
    }
    for i in 0..7 {
        let (d, t) = engine::place::to_segment(p, a: TRUNK[i], b: TRUNK[i + 1])
        let here = length(TRUNK[i + 1] - TRUNK[i])
        if d < best {
            best = d
            level = mix(TRUNK_FROM, TRUNK_TO, (along + t * here) / total)
        }
        along += here
    }
    vec2(best, level)
}

/// The land before it was cut: the plateau's old top, low swells on it, falling at its ragged edge
/// to the lowland; and the trunk valley across it, a trough to its river.
pub fn old_land(p: vec2) -> f32 {
    let r = length(p - MIDDLE) +
        900.0 * (fbm2(p * 0.00035 + vec2(1.0, 6.0), 3) - 0.5) +
        350.0 * (fbm2(p * 0.0012 + vec2(-3.0, 4.0), 3) - 0.5)
    // Broad swells as well as low ones, so the water's first ways branch and don't all run
    // straight down the trough's sides.
    let top = PLATEAU +
        9.0 * (fbm2(p * 0.0016 + vec2(3.0, 3.0), 4) - 0.5) +
        26.0 * (fbm2(p * 0.0005 + vec2(-6.0, 2.0), 3) - 0.5)
    let edge = smoothstep(EDGE_FROM, EDGE_TO, r)
    // The edge's slope is broken by spurs and bays, not an even ramp its water would comb.
    let y = mix(top, lowland(p), edge) +
        4.0 * edge * (1.0 - edge) * 40.0 * (fbm2(p * 0.0014 + vec2(5.0, -7.0), 3) - 0.5)
    let t = trunk(p)
    let wall = max(t.x - 40.0 + 220.0 * (fbm2(p * 0.0022 + vec2(8.0, -1.0), 3) - 0.5), 0.0)
    min(y, t.y + 0.6 * wall)
}

// ---- its making -------------------------------------------------------------------------------

/// The region: 16 km round the middle, 64 m cells; and the floor's square with a margin, 8 m.
pub const REGION = Grid { lo: vec2(-7517.0, -8717.0), nx: 256, nz: 256, cell: 64.0 }
pub const REGION_N: u32 = 65536
pub const SQUARE = Grid { lo: vec2(-478.0, -1428.0), nx: 288, nz: 226, cell: 8.0 }
pub const SQUARE_N: u32 = 65088

/// How the region was made, and its square at its finer grain: 1.2 million years, in steps of
/// 8000. The plateau was raised before: its rivers cut it to their base level, and nothing raises
/// it now. Water runs in a channel where more than 5 ha drains to it on the region's coarse grain,
/// 0.4 ha on the square's, and lays down some of what it carries where its load is heavy.
const REGION_MAKING = Shaping {
    steps: 150,
    years: 8000.0,
    m: 0.5,
    creep: 0.004,
    channel: 5.0e4,
    laying: 0.3,
}
const SQUARE_MAKING = Shaping { channel: 4.0e3, ..REGION_MAKING }

/// How much faster the square's water cuts its rock than the region's: the stream power law
/// cuts less on a finer grid, and at this the square is cut as deep as the region is over it
/// (`the_square_is_cut_as_deep_as_the_region_round_it`).
const SQUARE_GRAIN: f32 = 6.0

/// The region as its rivers, its creep and its rock made it from the old land: its border holds
/// the base level, which the trunk river runs to.
pub fn region() -> Landscape {
    let g = REGION
    let start: Vec<f32> = Vec::from_fn(g.cells(), |c| old_land(g.centre(c)))
    let still: Vec<f32> = Vec::filled(g.cells(), 0.0)
    evolve(g, start, border(g), still, |at: vec3| strength(at.xz, at.y), REGION_MAKING)
}

/// The floor's square, made at its finer grain from the old land over the same time: its border
/// holds its base level at the heights the region was left at there, and a little roughness on
/// the old land lets its water find its own channels.
pub fn square(region: Relief<REGION_N>) -> Landscape {
    let g = SQUARE
    let edges = border(g)
    let start: Vec<f32> = Vec::from_fn(g.cells(), |c| {
        let p = g.centre(c)
        if edges[c] { region.rise_at(p) } else {
            old_land(p) + 1.2 * (fbm2(p * 0.05 + vec2(7.0, 1.0), 3) - 0.5)
        }
    })
    let still: Vec<f32> = Vec::filled(g.cells(), 0.0)
    evolve(
        g,
        start,
        edges,
        still,
        |at: vec3| {
            let s = strength(at.xz, at.y)
            Strength { erodibility: s.erodibility * SQUARE_GRAIN, ..s }
        },
        SQUARE_MAKING,
    )
}

// ---- the land, as the bare view draws it ------------------------------------------------------

/// The world's land: the region's relief and the square's in it (each cell's height, m), and
/// past the region the lowland. The bare view's terrain.
pub struct Bare: Copy + GpuData {
    pub region: Relief<REGION_N>,
    pub square: Relief<SQUARE_N>,
}

/// How far in from the region's edge cells its land comes in fully over the lowland's, and the
/// square's over the region's (m).
const REGION_COLLAR: f32 = 1200.0
const SQUARE_COLLAR: f32 = 64.0

/// The granite's sheets: how far apart their lips are up its slopes (m), and how far each stands
/// out over the next one down.
const SHEET: f32 = 7.0
const LIP: f32 = 1.4

/// Which of its granite's sheets `p` (on the land as it was made, `y` high) is on, and how far
/// through it: its whole part counts the sheets up the boss, its fraction is 0 at the sheet's foot
/// and 1 at its top, where the next one's lip is. The lips run round the boss, wavering.
fn sheet(p: vec2, y: f32) -> f32 {
    (y + 8.0 * (fbm2(p * 0.012 + vec2(7.0, 1.0), 2) - 0.5)) / SHEET
}

impl Bare {
    /// The land's height at `p` before its rock's own detail (m), and its slope there (its rise
    /// per metre along x and z).
    fn made(self, p: vec2) -> vec3 {
        let r = self.region.rise_grad(p)
        let w = self.region.within(p, REGION_COLLAR)
        var y = vec3(mix(lowland(p), r.x, w), r.y * w, r.z * w)
        let s = self.square.within(p, SQUARE_COLLAR)
        if s > 0.0 {
            y = mix(y, self.square.rise_grad(p), vec3(s))
        }
        y
    }

    /// The land's height at (x, z): as it was made, its steep faces in the rock's ledges and
    /// joints, the gentle ground a little rough.
    pub fn at(self, x: f32, z: f32) -> f32 {
        let p = vec2(x, z)
        let m = self.made(p)
        let slope = length(m.yz)
        var y = m.x + 0.6 * (fbm2(p * 0.04 + vec2(2.0, 9.0), 3) - 0.5)
        y += 0.25 * (fbm2(p * 0.17 + vec2(-4.0, 3.0), 2) - 0.5)
        let face = smoothstep(0.5, 1.1, slope)
        if stratum(p, m.x) == Stratum::Granite {
            // Granite isn't bedded: its boss's skin splits into sheets parallel to it, each
            // ending in a lip a little proud of the one below, curved across the dome; and its
            // few joints, far apart, as shallow clefts.
            let sheeted = smoothstep(0.2, 0.6, slope)
            let f = fract(sheet(p, m.x))
            y += sheeted * LIP * (0.5 - saturate(f / 0.86) + smoothstep(0.86, 1.0, f))
            let (_, joint) = joints(p + vec2(13.0, 5.0), 14.0)
            y -= face * 0.6 * (1.0 - smoothstep(0.0, 0.08, joint))
        } else if face > 0.0 {
            // The beds as ledges (the floor's own: `ground::BED` deep, dipping as `BED_DIP`, so
            // the rock's colour's bands lie on them), every third standing out more, and the
            // joints' blocks each its own plane.
            let tilt = dot(p, BED_DIP)
            let major = (y + tilt) / (3.0 * BED)
            let thick = (floor(major) + saturate((fract(major) - 0.5) / 0.5)) * 3.0 * BED
            y = mix(y, thick - tilt, 0.35 * face)
            let lay = (y + tilt) / BED
            let stepped = (floor(lay) + saturate((fract(lay) - 0.45) / 0.55)) * BED
            y = mix(y, stepped - tilt, 0.6 * face)
            let (block, joint) = joints(p, 5.0)
            y += face * 0.7 * (block - 0.5) * min(joint / 0.15, 1.0)
        }
        y
    }

    /// How wet the land is at `p` (0 to 1): the region's, the square's in it.
    pub fn wet(self, p: vec2) -> f32 {
        let r = self.region.wet_at(p) * self.region.within(p, REGION_COLLAR)
        mix(r, self.square.wet_at(p), self.square.within(p, SQUARE_COLLAR))
    }
}

impl Terrain for Bare {
    fn height(self, x: f32, z: f32) -> f32 {
        self.at(x, z)
    }

    fn cover(self, at: vec3, n: vec3) -> Cover {
        self.bare_cover(at, n, 0.0)
    }

    fn cover_seen(self, at: vec3, n: vec3, fields: vec4, footprint: f32) -> Cover {
        self.bare_cover(at, n, footprint)
    }

    fn steepest(self) -> f32 {
        // The grit's and the granite's cliffs stand at up to 3, their ledges steeper still.
        12.0
    }
}

impl Bare {
    /// The bare land as a sample `w` metres across sees it: its rock where it's too steep to
    /// hold soil, in its beds, joints and streaks (`ground::rock_albedo`) and its stratum's
    /// colour; its soil elsewhere, darker and browner where it's wet; nothing growing.
    fn bare_cover(self, at: vec3, n: vec3, w: f32) -> Cover {
        let p = at.xz
        let slope = sqrt(max(1.0 - n.y * n.y, 0.0)) / max(n.y, 0.05)
        let s = stratum(p, at.y)
        let grain = 0.85 + 0.3 * fbm2_seen(p * 0.08 + vec2(5.0, 5.0), 3, w * 0.08)
        let rock = if s == Stratum::Granite {
            granite_albedo(at, n, sheet(p, self.made(p).x), w)
        } else {
            COLOUR[s] / 0.24 * rock_albedo(at, n, w)
        }
        // (The granite's smooth domes shed what weathers off them: they're bare less steep.)
        let bare = if s == Stratum::Granite {
            max(smoothstep(0.35, 0.75, slope), 0.35)
        } else {
            max(smoothstep(0.75, 1.1, slope), if s == Stratum::Grit { 0.35 } else { 0.0 })
        }
        let wet = self.wet(p)
        let soil = mix(
            vec3(0.20, 0.15, 0.10),
            vec3(0.11, 0.08, 0.05),
            vec3(smoothstep(0.3, 0.9, wet)),
        )
        let a = mix(soil * grain, rock, vec3(bare))
        Cover { albedo: a, grass: 0.0, materials: vec4(0.0, 1.0 - bare, bare, 0.0) }
    }
}

/// Granite's colour at `at` (its normal `n`, on its sheet `l`, as `sheet`), as a sample `w`
/// metres across sees it: grey, warmer and cooler in broad patches, coarsely grained, each sheet
/// its own tone; a dark line under each sheet's lip, where it overhangs; dark streaks where water
/// runs down it. No beds: it has none.
fn granite_albedo(at: vec3, n: vec3, l: f32, w: f32) -> vec3 {
    let xz = at.xz
    let tone = fbm2_seen(xz * 0.04 + vec2(-3.0, 8.0), 3, w * 0.04)
    var c = COLOUR[Stratum::Granite] * mix(vec3(0.5, 0.52, 0.55), vec3(0.9, 0.84, 0.78), vec3(tone))
    c *= 0.8 + 0.4 * fbm2_seen(xz * 0.9 + vec2(1.0, 4.0), 2, w * 0.9)
    // Each sheet a little its own tone, and darker on its lip's riser, which faces down the dome.
    let f = fract(l)
    let own = engine::noise::hash2(i32(floor(l)), 41)
    c *= 0.9 + 0.2 * mix(own, 0.5, smoothstep(0.5 * SHEET, 2.0 * SHEET, w))
    let lip = smoothstep(0.8, 0.9, f) * (1.0 - smoothstep(0.97, 1.0, f))
    c *= 1.0 - 0.5 * mix(lip, 0.08, smoothstep(0.3, 1.5, w))
    let steep = 1.0 - smoothstep(0.55, 0.9, n.y)
    let runs = engine::noise::noise2_seen(
        vec2((xz.x * 0.8 + xz.y * 1.1) * 0.7, at.y * 0.05),
        w * 0.7,
    )
    c *= 1.0 - 0.3 * smoothstep(0.5, 0.75, runs) * steep
    c
}

/// The world's land as its making left it, its places, their names, and the shots of them the
/// bare view's lookbook takes (`shots`).
pub struct World {
    pub land: Bare,
    pub places: Vec<Feature>,
    pub names: Vec<String>,
    pub shots: Vec<Shot>,
    pub shot_names: Vec<String>,
}

@fuel(2 ** 42)
pub const WORLD: World = world()

/// The land's height at `p` (the bare view's `height_at`).
pub fn height_at(p: vec2) -> f32 {
    WORLD.land.at(p.x, p.y)
}

fn world() -> World {
    // Each relief over a level land at 0 m: its rise is the land's height.
    let r = region()
    let region_relief: Relief<REGION_N> = Relief::of(r, Vec::filled(REGION_N, 0.0))
    let s = square(region_relief)
    let land = Bare { region: region_relief, square: Relief::of(s, Vec::filled(SQUARE_N, 0.0)) }
    let found = found_places(land, s)
    let names = named(found)
    let (shots, shot_names) = shots_of(land, found, names)
    World { land, places: found, names, shots, shot_names }
}

// ---- its rock as solids -----------------------------------------------------------------------

/// The rocks that stand as solids where they show (the heightfield can't hold a face of rock
/// steeper than a few cells): the grit, the sandstone and the granite, a set of jointed blocks of
/// each (`BLOCKS` of them) and, of the granite, rounded corestones as well.
const SOLID = [Stratum::Grit, Stratum::Sandstone, Stratum::Granite]
pub const BLOCKS: u32 = 4

/// The prototypes, each a unit each way (a placement scales it): for each of `SOLID`'s rocks its
/// `BLOCKS` jointed blocks, then the granite's `BLOCKS` corestones, blocks weathered round; each
/// realized to `look`'s tolerance, its colours a cell `cell` across.
pub fn rock_prototypes(look: CreatureLook, cell: f32) -> Vec<Realized> {
    var out: Vec<Realized> = Vec::new()
    for r in 0..3 {
        // (Its colour a little greyer than the land's: weathered, it reads olive in the sun.)
        let own = COLOUR[SOLID[r]]
        let c = mix(own, vec3(dot(own, vec3(0.3, 0.55, 0.15))), vec3(0.4))
        for k in 0..BLOCKS {
            let b = block_bed(seed: 500 + r * 10 + k, dark: c * 0.3, light: c * 0.46, worn: 0.06)
            out.push(realize_weathered(b, rough: 0.05, look: look, cell: cell))
        }
    }
    // The granite's corestones: its blocks weathered round along their joints.
    let granite = COLOUR[Stratum::Granite]
    for k in 0..BLOCKS {
        let b = block_bed(
            seed: 700 + k * 13,
            dark: granite * 0.45,
            light: granite * 0.7,
            worn: 0.5,
        )
        out.push(realize_weathered(b, rough: 0.08, look: look, cell: cell))
    }
    out
}

/// The rocks' near prototypes, for those close to the eye: fine enough to show their laminae and
/// pits a few metres off; and their far ones.
pub const NEAR_LOOK = CreatureLook { surface: Tolerance { tolerance: 1cm, largest: 3cm } }
pub const FAR_LOOK = CreatureLook { surface: Tolerance { tolerance: 6cm, largest: 18cm } }

/// The prototype of a jointed block of stratum `s` (a solid one), seed `seed`; and a corestone.
fn block_of(s: Stratum, seed: u32) -> u32 {
    let r = if s == Stratum::Grit { 0 } else if s == Stratum::Sandstone { 1 } else { 2 }
    r * BLOCKS + seed % BLOCKS
}

fn corestone(seed: u32) -> u32 {
    3 * BLOCKS + seed % BLOCKS
}

/// A placement of prototype `k` at `centre`, turned `turn` about the vertical, its half sizes
/// `half`.
fn placed(k: u32, centre: vec3, turn: f32, half: vec3, seed: u32) -> Placement {
    let at = translate(centre) * rotate_y(turn) * scale(half)
    Placement { prototype: k, at, normal_at: normal_matrix(at), reach: length(half) * 1.3, seed }
}

/// Whether stratum `s` stands as solids where it shows.
fn solid(s: Stratum) -> bool {
    s == Stratum::Grit || s == Stratum::Sandstone || s == Stratum::Granite
}

/// The rock as solids over land `land`'s square: each face of solid rock steeper than the
/// heightfield draws well, as its beds stacked up it, each bed a block a little proud of the
/// ground at its own height, so the face steps back in ledges; the blocks fallen from it, on the
/// scree under it, smaller the further they rolled; the granite's tors, its corestones stacked
/// on the summits of its bosses; and boulders in the streams where they fall steeply.
pub fn rock_placements(land: Bare) -> Vec<Placement> {
    var out: Vec<Placement> = Vec::new()
    let g = SQUARE
    for c in 0..g.cells() {
        let p = g.centre(c)
        if land.square.within(p, SQUARE_COLLAR) < 1.0 {
            continue
        }
        let m = land.made(p)
        let slope = length(m.yz)
        let seed = c * 7919
        if slope > 0.9 {
            face(land, p, m, seed, mut out)
        }
        let s = stratum(p, m.x)
        if s == Stratum::Granite {
            tor(land, p, m, seed, mut out)
        }
        if land.wet(p) > 0.62 && slope > 0.12 && slope < 0.9 && rand(seed, 5) < 0.35 {
            // A stream's boulder, where it falls steeply enough to have left it.
            let r = 0.5 + 0.8 * rand(seed, 6)
            let q = p + (vec2(rand(seed, 7), rand(seed, 8)) - vec2(0.5)) * g.cell
            let k = if solid(s) { block_of(s, seed) } else { corestone(seed) }
            let y = lowest(land, q, r)
            out.push(
                placed(
                    k,
                    vec3(q.x, y + 0.3 * r, q.y),
                    TAU * rand(seed, 9),
                    vec3(r, 0.7 * r, r),
                    seed,
                ),
            )
        }
    }
    out
}

/// The face through `p` (where the land is `m`: height and slope): found up and down its
/// slope from `p`, kept only if `p`'s cell holds its middle (so each face is built once); its
/// beds, where they're solid rock, as blocks a little proud of the ground at their own heights,
/// each bed the rock's own (`ground::BED` deep, dipping as `BED_DIP`, as the ground's ledges and
/// colours), set back by its own amount all along the face and in its own tone, so the face
/// steps back in ledges that run across it; and the blocks fallen from it, on the scree under.
fn face(land: Bare, p: vec2, m: vec3, seed: u32, out: mut Vec<Placement>) {
    let up = m.yz / length(m.yz)
    let (top, foot) = extent(land, p, up)
    let mid = p + up * 0.5 * (top - foot)
    if SQUARE.cell_at(mid) != SQUARE.cell_at(p) {
        return
    }
    let low = land.made(p - up * foot).x
    let high = land.made(p + up * top).x
    let along = vec2(-up.y, up.x)
    // (`rotate_y` turns +x toward -z.)
    let turn = atan2(-along.y, along.x)
    let tilt = dot(p, BED_DIP)
    // The major beds (three of the rock's beds each, as its ledges' thicker ones) from the one at
    // the face's foot to the one at its top.
    let major = 3.0 * BED
    let first = i32(floor((low + tilt) / major))
    let last = i32(floor((high + tilt) / major))
    for bed in first..(last + 1) {
        let b0 = f32(bed) * major - tilt
        let at_h = clamp(b0 + 0.5 * major, low + 0.5 * major, high - 0.5 * major)
        // Where the face is at this bed's height: between its foot and its top.
        var lo = -foot
        var hi = top
        for _ in 0..12 {
            let mm = 0.5 * (lo + hi)
            if land.made(p + up * mm).x < at_h { lo = mm } else { hi = mm }
        }
        let q = p + up * (0.5 * (lo + hi))
        let s = stratum(q, at_h)
        // Granite isn't bedded: its boss weathers to a smooth dome the land itself draws, its
        // blocks loosed only at its foot.
        if !solid(s) || s == Stratum::Granite {
            continue
        }
        // The bed's own: how far it's set back along the whole face, and its tone's seed.
        let bed_seed = u32(bed + 4096).wrapping_mul(2654435761)
        let back = 0.6 * rand(bed_seed, 1)
        // Its blocks across the cell, each as wide as its joints are apart (6 to 14 m).
        var x = -0.5 * SQUARE.cell - 4.0 * rand(seed, 30 + u32(bed - first))
        var j = 0
        while x < 0.5 * SQUARE.cell && j < 4 {
            let w = 3.0 + 4.0 * rand(seed, 40 + u32(bed - first) * 8 + j)
            let depth = 3.5 + 1.5 * rand(seed, 50 + j)
            let proud = 0.15 * rand(seed, 60 + j) - back
            let c2 = q + along * (x + w) + up * (depth - proud)
            let t = 0.5 * major * (0.94 + 0.08 * rand(seed, 70 + j))
            // Where the land under it falls away (the face lower to one side, or behind it on a
            // thin spur), it reaches down to it, not hanging over the air (as far as two more
            // beds at most).
            var under = 1.0e9
            for e in 0..6 {
                let side = q + along * (x + w * f32(e % 3))
                let off = if e < 3 { -(proud + 0.5) } else { 2.0 * depth - proud }
                let below = side + up * off
                under = min(under, land.at(below.x, below.y))
            }
            let top = at_h + t
            let bottom = clamp(under - 0.3, at_h - t - 2.0 * major, at_h - t)
            let k = block_of(s, seed + u32(bed - first) * 8 + j)
            let wobble = 0.08 * (rand(seed, 80 + j) - 0.5)
            out.push(
                placed(
                    k,
                    vec3(c2.x, 0.5 * (top + bottom), c2.y),
                    turn + wobble,
                    vec3(w, 0.5 * (top - bottom), depth),
                    bed_seed,
                ),
            )
            x += 2.0 * w
            j += 1
        }
    }
    // What fell: pieces of the face's rock on the scree under it, the big ones angular near its
    // foot, the ones that rolled further rounder and smaller, each half sunk in the scree.
    let s = stratum(p, 0.5 * (low + high))
    if solid(s) {
        for k in 0..2 {
            let d = foot + 2.0 + 20.0 * rand(seed, 100 + k)
            let q = p - up * d + along * (rand(seed, 110 + k) - 0.5) * 8.0
            let near = 1.0 - min(d / 25.0, 1.0)
            let r = 0.5 + 1.8 * rand(seed, 120 + k) * (0.4 + 0.6 * near)
            let y = lowest(land, q, r)
            let piece = if rand(seed, 125 + k) < near { block_of(s, seed + 130 + k) } else {
                corestone(seed + 130 + k)
            }
            out.push(
                placed(
                    piece,
                    vec3(q.x, y + 0.1 * r, q.y),
                    TAU * rand(seed, 140 + k),
                    vec3(r, 0.55 * r, r * 0.85),
                    seed + 130 + k,
                ),
            )
        }
    }
}

/// The lowest the land is under a piece `r` across at `q`: where it settles, sunk into the
/// ground uphill of it, not hanging over the ground downhill.
fn lowest(land: Bare, q: vec2, r: f32) -> f32 {
    var y = land.at(q.x, q.y)
    for k in 0..8 {
        let a = TAU * f32(k) / 8.0
        y = min(y, land.at(q.x + 1.3 * r * cos(a), q.y + 1.3 * r * sin(a)))
    }
    y
}

/// How far the steep ground through `p` goes up (`up`) and down from it (m, a metre at a time,
/// to 40 m at most): to its top and its foot.
fn extent(land: Bare, p: vec2, up: vec2) -> (f32, f32) {
    var top = 0.0
    while top < 40.0 && length(land.made(p + up * (top + 1.0)).yz) > 0.6 {
        top += 1.0
    }
    var foot = 0.0
    while foot < 40.0 && length(land.made(p - up * (foot + 1.0)).yz) > 0.6 {
        foot += 1.0
    }
    (top, foot)
}

/// A tor where `p` is the top of a granite boss within 12 m (the land `m` there): its corestones
/// stacked, each smaller, a little off the one under it.
fn tor(land: Bare, p: vec2, m: vec3, seed: u32, out: mut Vec<Placement>) {
    for k in 0..8 {
        let a = TAU * f32(k) / 8.0
        if land.made(p + vec2(cos(a), sin(a)) * 12.0).x > m.x {
            return
        }
    }
    var y = land.at(p.x, p.y) - 0.4
    var r = 2.2 + 1.2 * rand(seed, 200)
    var at = p
    for k in 0..(2 + u32(3.0 * rand(seed, 201))) {
        let half = vec3(r, 0.6 * r, r * (0.8 + 0.3 * rand(seed, 210 + k)))
        out.push(
            placed(
                corestone(seed + k),
                vec3(at.x, y + half.y, at.y),
                TAU * rand(seed, 220 + k),
                half,
                seed + k,
            ),
        )
        y += 1.6 * half.y
        at += (vec2(rand(seed, 230 + k), rand(seed, 240 + k)) - vec2(0.5)) * 0.6 * r
        r *= 0.7 + 0.15 * rand(seed, 250 + k)
    }
}

// ---- its places -------------------------------------------------------------------------------

/// What makes a place on the square's 8 m grid.
pub const FINDING = Finding {
    channel: 2.0e4,
    summit_reach: 160.0,
    summit_rise: 15.0,
    tor_reach: 24.0,
    tor_rise: 4.0,
    tor_hard: 0.5,
    overlook_reach: 120.0,
    overlook_drop: 30.0,
    falls_drop: 8.0,
    gorge_walls: 15.0,
    gorge_reach: 40.0,
    lake_depth: 0.5,
    confluence_area: 1.0e5,
    apart: 120.0,
    most: 4,
}

/// The places in the floor's square that land `land` (made as `s` is) has: found on its final
/// surface, as the bare view draws it.
pub fn found_places(land: Bare, s: Landscape) -> Vec<Feature> {
    let g = s.grid
    let surface: Vec<f32> = Vec::from_fn(g.cells(), |c| {
        let p = g.centre(c)
        land.at(p.x, p.y)
    })
    let counted: Vec<bool> = Vec::from_fn(g.cells(), |c| {
        let p = g.centre(c)
        p.x >= map::LO.x && p.y >= map::LO.y && p.x < map::HI.x && p.y < map::HI.y
    })
    places(s, surface, counted, FINDING)
}

/// What a place of each kind is called.
fn word(k: PlaceKind) -> Text {
    match k {
        PlaceKind::Summit => "summit",
        PlaceKind::Tor => "tor",
        PlaceKind::Overlook => "overlook",
        PlaceKind::Falls => "falls",
        PlaceKind::Gorge => "gorge",
        PlaceKind::Spring => "spring",
        PlaceKind::Lake => "lake",
        PlaceKind::Confluence => "meeting of streams",
    }
}

/// Which side of the square's middle `p` is on: one of the eight winds (north is -z), or the
/// middle.
fn side(p: vec2) -> Text {
    let d = p - MIDDLE
    if length(d) < 250.0 {
        return "middle"
    }
    let a = atan2(d.x, -d.y)
    let k = u32(round(a / (std::math::TAU / 8.0)) + 8.0) % 8
    let winds = [
        "north",
        "north-east",
        "east",
        "south-east",
        "south",
        "south-west",
        "west",
        "north-west",
    ]
    winds[k]
}

/// Each place's name: what it is and which side of the square it's on ("the north-west falls"),
/// the second and later of the same name numbered.
pub fn named(found: [Feature]) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for i in 0..found.len() {
        let base = f"the {side(found[i].at)} {word(found[i].kind)}"
        var same = 0
        for j in 0..i {
            if found[j].kind == found[i].kind && side(found[j].at) == side(found[i].at) {
                same += 1
            }
        }
        out.push(if same == 0 { take base } else { f"{base} ({same + 1})" })
    }
    out
}

/// The bare view's shots of the places on land `land`, and their names: from the best
/// overlooks, below the tallest falls, in the deepest gorge, at the tallest tor, from the highest
/// summit out to the horizon, and at the deepest lake; each where the place has one, its eye
/// raised till it sees what it looks at (`clear`); and under the tallest crag (`crag`).
pub fn shots_of(land: Bare, found: [Feature], names: [String]) -> (Vec<Shot>, Vec<String>) {
    var shots: Vec<Shot> = Vec::new()
    var called: Vec<String> = Vec::new()
    var overlooks = 0
    var have = [false; PlaceKind]
    for i in 0..found.len() {
        let f = found[i]
        let at = f.at
        let across = vec2(-f.toward.y, f.toward.x)
        let out = if length(at - MIDDLE) > 1.0 { normalize(at - MIDDLE) } else { vec2(0.0, -1.0) }
        let shot = match f.kind {
            PlaceKind::Overlook => {
                if overlooks >= 2 {
                    continue
                }
                overlooks += 1
                // At the drop's lip, looking out the way the land is lowest under the eye's
                // line, a little down into what it sees.
                let from = lip(land, f)
                let view = outlook(land, from)
                Some(
                    (
                        f"from {names[i]}",
                        Shot {
                            name: "",
                            eye: vec3(from.x, 1.7, from.y),
                            at: vec3(
                                from.x + view.x * 400.0,
                                0.4 * f.measure,
                                from.y + view.y * 400.0,
                            ),
                            moves: vec2(-view.y, view.x) * 3.0,
                        },
                    ),
                )
            },
            PlaceKind::Falls => Some(
                (
                    f"below {names[i]}",
                    Shot {
                        name: "",
                        eye: vec3(at.x + f.toward.x * 80.0, 1.7, at.y + f.toward.y * 80.0),
                        at: vec3(at.x, 0.5 * f.measure, at.y),
                        moves: across * 2.0,
                    },
                ),
            ),
            PlaceKind::Gorge => Some(
                (
                    f"in {names[i]}",
                    Shot {
                        name: "",
                        eye: vec3(at.x, 1.7, at.y),
                        at: vec3(at.x + f.toward.x * 90.0, 3.0, at.y + f.toward.y * 90.0),
                        moves: f.toward * 3.0,
                    },
                ),
            ),
            PlaceKind::Tor => Some(
                (
                    f"{names[i]}",
                    Shot {
                        name: "",
                        eye: vec3(at.x - out.x * 40.0, 1.7, at.y - out.y * 40.0),
                        at: vec3(at.x, 3.0, at.y),
                        moves: vec2(-out.y, out.x) * 3.0,
                    },
                ),
            ),
            PlaceKind::Summit => Some(
                (
                    f"from {names[i]} to the horizon",
                    Shot {
                        name: "",
                        eye: vec3(at.x, 1.7, at.y),
                        at: vec3(at.x + out.x * 3000.0, 0.0, at.y + out.y * 3000.0),
                        moves: vec2(-out.y, out.x) * 3.0,
                    },
                ),
            ),
            PlaceKind::Lake => Some(
                (
                    f"{names[i]}",
                    Shot {
                        name: "",
                        eye: vec3(at.x - out.x * 80.0, 1.7, at.y - out.y * 80.0),
                        at: vec3(at.x, 0.5, at.y),
                        moves: vec2(-out.y, out.x) * 3.0,
                    },
                ),
            ),
            _ => None,
        }
        if let Some((name, s)) = shot {
            if f.kind != PlaceKind::Overlook && have[f.kind] {
                continue
            }
            if let Some(seen) = clear(land, s) {
                have[f.kind] = true
                shots.push(seen)
                called.push(name.clone())
            }
        }
    }
    if let Some((name, s)) = crag(land) {
        shots.push(s)
        called.push(take name)
    }
    (shots, called)
}

/// The bare view's shot of the rock up close: of the tallest face of bedded rock in the square,
/// from 18 m out from its foot, at its middle; none if no face is seen from there.
fn crag(land: Bare) -> Option<(String, Shot)> {
    let g = SQUARE
    var tallest = 0.0
    var found: Option<(String, Shot)> = None
    for c in 0..g.cells() {
        let p = g.centre(c)
        let m = land.made(p)
        let slope = length(m.yz)
        let s = stratum(p, m.x)
        if slope < 1.2 ||
            !solid(s) ||
            s == Stratum::Granite ||
            land.square.within(p, SQUARE_COLLAR) < 1.0 {
            continue
        }
        let up = m.yz / slope
        let (top, foot) = extent(land, p, up)
        let high = land.made(p + up * top).x
        let low = land.made(p - up * foot).x
        // Bedded rock its whole height (not a face that runs on up a granite boss).
        let granite = stratum(p + up * top, high) == Stratum::Granite ||
            stratum(p - up * foot, low) == Stratum::Granite
        if high - low <= tallest || granite {
            continue
        }
        let eye = p - up * (foot + 18.0)
        let mid = p + up * 0.5 * (top - foot)
        let shot = Shot {
            name: "",
            eye: vec3(eye.x, 1.7, eye.y),
            at: vec3(mid.x, 0.0, mid.y),
            moves: vec2(-up.y, up.x) * 2.0,
        }
        if let Some(seen) = clear(land, shot) {
            tallest = high - low
            found = Some((f"under the {side(p)} crag", seen))
        }
    }
    found
}

/// The way out from `p` the land is lowest seen from over it: of 32 ways round it, the one whose
/// horizon (the steepest rise from `p`'s eye to the land, out to 1.2 km) is lowest.
fn outlook(land: Bare, p: vec2) -> vec2 {
    let eye = land.at(p.x, p.y) + 1.7
    var best = vec2(1.0, 0.0)
    var lowest = 1.0e9
    for k in 0..32 {
        let a = TAU * f32(k) / 32.0
        let way = vec2(cos(a), sin(a))
        var horizon = -1.0e9
        var d = 30.0
        while d < 1200.0 {
            let q = p + way * d
            horizon = max(horizon, (land.at(q.x, q.y) - eye) / d)
            d *= 1.15
        }
        if horizon < lowest {
            lowest = horizon
            best = way
        }
    }
    best
}

/// Where overlook `f`'s land begins to drop (x, z): along the way it faces, 3 m short of where
/// the ground first falls 2 m below it.
fn lip(land: Bare, f: Feature) -> vec2 {
    var d = 0.0
    while d < FINDING.overlook_reach {
        let p = f.at + f.toward * d
        if land.at(p.x, p.y) < f.height - 2.0 {
            return f.at + f.toward * max(d - 3.0, 0.0)
        }
        d += 1.0
    }
    f.at
}

/// Shot `s` with its eye raised, 2 m at a time and to 40 m at most, till nothing of land `land`
/// stands between it and what it looks at; none if it can't see it from there.
pub fn clear(land: Bare, s: Shot) -> Option<Shot> {
    var shot = s
    let to = vec3(s.at.x, land.at(s.at.x, s.at.z) + s.at.y, s.at.z)
    while shot.eye.y <= 40.0 {
        let from = vec3(s.eye.x, land.at(s.eye.x, s.eye.z) + shot.eye.y, s.eye.z)
        var seen = true
        for k in 1..48 {
            let p = mix(from, to, vec3(f32(k) / 48.0))
            seen = seen && land.at(p.x, p.z) < p.y - 0.5
        }
        if seen {
            return Some(shot)
        }
        shot.eye.y += 2.0
    }
    None
}

/// The places and the bare view's shots, as files beside the build (`files/geology/`): each place's
/// name, kind, place (x, z), height and measure, and each shot's name, as JSON.
pub const FILES: Shipped = ship("geology", files())

fn files() -> Vec<(String, Vec<u8>)> {
    borrow w = WORLD
    var places = String::from("[")
    for i in 0..w.places.len() {
        let f = w.places[i]
        if i > 0 {
            places.push_str(",")
        }
        places.push_str(
            f"\n  {{\"name\": \"{w.names[i]}\", \"kind\": \"{word(f.kind)}\", \"at\": [{f.at.x}, {f.at.y}], \"height\": {f.height}, \"measure\": {f.measure}}}".as_str(),
        )
    }
    places.push_str("\n]\n")
    var shots = String::from("[")
    for i in 0..w.shot_names.len() {
        if i > 0 {
            shots.push_str(", ")
        }
        shots.push_str(f"\"{w.shot_names[i]}\"".as_str())
    }
    shots.push_str("]\n")
    var out: Vec<(String, Vec<u8>)> = Vec::new()
    out.push((String::from("places.json"), Vec::from(places.as_bytes())))
    out.push((String::from("shots.json"), Vec::from(shots.as_bytes())))
    out
}

// ---- tests ------------------------------------------------------------------------------------

/// The square, made at its finer grain, is cut as deep as the region is over it: their mean
/// heights over the square agree within 5%.
@test
fn the_square_is_cut_as_deep_as_the_region_round_it() {
    borrow land = WORLD.land
    var sum = vec2(0.0)
    for c in 0..SQUARE_N {
        sum += vec2(land.square.rise(c), land.region.rise_at(SQUARE.centre(c)))
    }
    assert(
        abs(sum.x / sum.y - 1.0) < 0.05,
        f"the square's mean {sum.x / f32(SQUARE_N)} m, the region's {sum.y / f32(SQUARE_N)} m",
    )
}

/// Each bare shot sees what it looks at: nothing of the land stands between its eye and its
/// subject.
@test
fn each_bare_shot_sees_its_subject() {
    borrow w = WORLD
    assert(w.shots.len() >= 4, f"only {w.shots.len()} shots of the places")
    for i in 0..w.shots.len() {
        let s = w.shots[i]
        let from = vec3(s.eye.x, w.land.at(s.eye.x, s.eye.z) + s.eye.y, s.eye.z)
        let to = vec3(s.at.x, w.land.at(s.at.x, s.at.z) + s.at.y, s.at.z)
        for k in 1..48 {
            let p = mix(from, to, vec3(f32(k) / 48.0))
            assert(w.land.at(p.x, p.z) < p.y, f"{w.shot_names[i]} looks into the land")
        }
    }
}

/// The rock as solids lies on the land it's of: each piece within the square, meeting the land
/// within its footprint (a cliff's bed set into its face, a fallen piece half sunk in its scree);
/// each cliff block of solid rock; and as many as the square's faces and scree need.
@test
@fuel(2 ** 40)
fn the_rock_as_solids_lies_on_its_land() {
    borrow land = WORLD.land
    let placed = rock_placements(land)
    assert(placed.len() > 2000 && placed.len() < 60000, f"{placed.len()} rocks placed")
    let lo = SQUARE.lo
    let hi = lo + vec2(f32(SQUARE.nx), f32(SQUARE.nz)) * SQUARE.cell
    for p in placed {
        let c = p.at[3].xyz
        assert(c.x > lo.x && c.z > lo.y && c.x < hi.x && c.z < hi.y, "a rock lies past the square")
        // It meets the land somewhere under its footprint (set into a face, the land under its
        // middle is the hill behind it).
        let under = land.at(c.x, c.z)
        var near = abs(c.y - under)
        for k in 0..16 {
            let a = TAU * f32(k) / 16.0
            let q = c.xz + vec2(cos(a), sin(a)) * 0.6 * p.reach
            near = min(near, abs(c.y - land.at(q.x, q.y)))
        }
        // (A tor's corestones stand on each other, the top one a stack over the land.)
        let stack = if p.prototype >= 3 * BLOCKS { 12.0 } else { 4.0 }
        assert(near < stack, f"a rock floats or is buried at ({c.x}, {c.z})")
        if p.prototype < 2 * BLOCKS {
            // A grit or sandstone block: of the rock its stratum is, or fallen from it.
            assert(solid(stratum(c.xz, c.y)) || c.y < under + 3.0, "a block stands in soft rock")
        }
    }
}

/// No block of the rock hangs over the air: each jointed block's bottom corners are within 2 m
/// over the land under them (a bed set into a face reaches down to it where it falls away).
@test
@fuel(2 ** 40)
fn no_block_of_the_rock_hangs_over_the_air() {
    borrow land = WORLD.land
    var hanging = 0
    var worst = 0.0
    var at = vec3(0.0)
    let placed = rock_placements(land)
    for p in placed {
        if p.prototype >= 3 * BLOCKS {
            continue
        }
        for k in 0..4 {
            let corner = p.at * vec4(f32(k % 2) * 2.0 - 1.0, -1.0, f32(k / 2) * 2.0 - 1.0, 1.0)
            let over = corner.y - land.at(corner.x, corner.z)
            if over > 2.0 {
                hanging += 1
                if over > worst {
                    worst = over
                    at = corner.xyz
                }
            }
        }
    }
    assert(hanging == 0, f"{hanging} corners of {placed.len()} hang, the worst {worst} m at {at}")
}
