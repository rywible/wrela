// The lookbook (#54 §9): named shots of the floor, each a place, an eye, what it looks at and a
// 10 s move, which the look is developed against. `tools/lookbook.py` renders each one settled
// at 1080p and records it in motion; each round's stills sit beside the last round's and spike
// 17's. Heights are above the ground under each point.

/// A shot: its name, where the eye is and what it looks at (x, height above the ground, z), how
/// far the eye moves over the shot's 10 s (m, on the plane), and the field of view (radians).
pub struct Shot: Copy {
    pub name: Text,
    pub eye: vec3,
    pub at: vec3,
    pub moves: vec2,
    pub fovy: f32 = 0.82,
}

/// How long a shot's move takes (s), and how long it holds still first while the floor round it
/// streams in and its caches settle (its still is taken as the move starts).
pub const MOVE: f32 = 10.0
pub const SETTLE: f32 = 5.0

