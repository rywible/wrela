/// Where shot `s`'s eye is and what it looks at, `t` seconds after it was chosen (it holds still
/// `SETTLE` seconds, then moves), the ground's height given by `height`.
pub fn place(s: Shot, t: f32, height: fn(vec2) -> f32) -> (vec3, vec3) {
    let k = clamp((t - SETTLE) / MOVE, 0.0, 1.0)
    let e = s.eye.xz + s.moves * k
    let eye = vec3(e.x, height(e) + s.eye.y, e.y)
    let at = vec3(s.at.x, height(s.at.xz) + s.at.y, s.at.z)
    (eye, at)
}
