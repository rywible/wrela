// The Last Green's floor, as its author decides it (#54 §1, §2): the land's big shapes, its sites
// (#44's anatomy: a gate, a town's site, four anchors, a Warden's arena, rest points, waystones,
// echoes' sites, views), what each must do for a player, the openings and what keeps each open in
// the present, the water, the routes, the events by year, and the regions with the character of
// their forest. Nothing else: the history grows the forest round it (`engine::grow`), and the
// interest check measures it (`engine::interest`). A literal here is what the map lens drags.
//
// Metres; +y up. The clearing (M5's) is at the origin; the plateau's edge cuts the square's
// north-west corner off, past which the land falls to the valley.

use species::Species
use engine::place::{
    Character, Event, EventKind, Feature, Herd, Keeper, Kept, Kind, Land, Map, Opening, Region,
    Relation, Route, RouteKind, Site, SiteKind, Water,
}

/// The history's present: its last year, the floor as a player finds it.
pub const PRESENT: i32 = 900

/// The authored square.
pub const LO = vec2(-350.0, -1300.0)
pub const HI = vec2(1700.0, 250.0)

/// The great oak's knoll, the clearing's (M5's `KNOLL`).
pub const KNOLL = vec2(7.0, 33.0)

/// The land's big shapes: the Spine, a ridge across the floor's north with the crag on its high
/// point; the Watch, the tower's hill; the Sink, a hollow the mere fills; the Cut, a ravine from
/// the mere to the plateau's edge, where its stream falls; the Fang, a second crag over the pines
/// in the east; the quarry's face; and the rock at the edge's view.
pub fn land() -> Land {
    Land {
        hills: [
            vec4(560.0, -470.0, 150.0, 40.0),
            vec4(1300.0, -700.0, 260.0, 22.0),
            vec4(700.0, -1050.0, 220.0, 9.0),
            ..vec4(0.0),
        ],
        hollows: [
            vec4(255.0, -385.0, 95.0, 9.0),
            vec4(1450.0, -1150.0, 70.0, 3.0),
            ..vec4(0.0),
        ],
        ridges: [
            vec4(90.0, -230.0, 5.0, 38.0),
            vec4(330.0, -150.0, 17.0, 46.0),
            vec4(520.0, -40.0, 12.0, 44.0),
            vec4(740.0, 60.0, 5.0, 40.0),
            vec4(0.0),
            vec4(1050.0, -320.0, 4.0, 50.0),
            vec4(1300.0, -650.0, 14.0, 70.0),
            vec4(1500.0, -950.0, 6.0, 60.0),
            ..vec4(0.0),
        ],
        ravines: [
            vec4(185.0, -392.0, 7.0, 11.0),
            vec4(110.0, -352.0, 7.0, 11.0),
            vec4(40.0, -322.0, 7.0, 11.0),
            vec4(-60.0, -262.0, 7.0, 11.0),
            vec4(-150.0, -205.0, 7.0, 11.0),
            vec4(-235.0, -150.0, 7.0, 11.0),
            ..vec4(0.0),
        ],
        ravine_fall: 5.0,
        crags: [
            vec4(330.0, -150.0, 14.0, 22.0),
            vec4(1310.0, -660.0, 16.0, 20.0),
            vec4(1225.0, -925.0, 8.0, 16.0),
            vec4(-300.0, -345.0, 4.0, 12.0),
        ],
        ramps: vec4(3.6, 2.4, 0.9, 0.3),
        tilt: vec4(0.74, -0.67, 12.0, 800.0),
    }
}

