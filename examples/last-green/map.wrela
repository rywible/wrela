    let tower = 1
    let crag = 7
    let fang = 8
    let mere = 12
    var relations: Vec<Relation> = Vec::new()
    // The tower: from the knoll (the clearing's promise of the floor), from the crag's top, and
    // from the town's site in the beech wood.
    relations.push(
        Relation::Seen {
            from: vec2(4.0, 26.0),
            within: 6.0,
            to: tower,
            landmark: true,
            name: "the tower from the knoll",
