// The game's small session program: save policy before its renderer is loaded.
use engine::tower::{Carry, STAIR}
use platform::host
use platform::protocol::{Reply, Request, SaveFile, SaveInfo, valid_key}
use std::io::{Pending, load as read_file, store}
use std::reload::{hand_over, keep, prepare}
use std::serialize::{LoadError, Serialize, load, save}

const GAME: Text = "last-green"
const SAVE: Text = "tower/save"
const ACTIVE: Text = "session/profile"
const JOURNAL: Text = "session/preparing"

enum Phase: Copy + Eq {
    Journal,
    Active,
    Recover,
    WriteRecovery,
    Idle,
    ReadSlot,
    Backup,
    BackupSaved,
    MarkPrepare,
    WriteSave,
    WriteProfile,
    CommitPrepare,
    Prepare,
    Reply,
    Launch,
}

pub struct Session {
    phase: Phase,
    io: Option<Pending<u8>>,
    incoming: Option<Pending<u8>>,
    request: Option<Request>,
    call: u32,
    profile: String,
    active: String,
    slot: String,
    entries: Vec<SaveInfo>,
    list_slot: u32,
    bytes: Vec<u8>,
    saved: u32,
    environment: Option<Pending<u8>>,
    entry: String,
    launch: bool,
    prepared: bool,
    interrupted: bool,
    recovery_failed: bool,
    recovered: Vec<u8>,
}

pub fn init() -> Session {
    Session {
        phase: Phase::Journal,
        io: Some(read_file(JOURNAL)),
        incoming: None,
        request: None,
        call: 0,
        profile: String::new(),
        active: String::from("player-1"),
        slot: String::new(),
        entries: Vec::new(),
        list_slot: 0,
        bytes: Vec::new(),
        saved: 0,
        environment: Some(host::environment()),
        entry: String::from("../last-green"),
        launch: false,
        prepared: false,
        interrupted: false,
        recovery_failed: false,
        recovered: Vec::new(),
    }
}

fn path(profile: str, slot: str) -> String {
    f"profiles/{profile}/{slot}"
}

fn slot_name(i: u32) -> Text {
    if i == 0 { "continue" } else if i == 1 { "imported" } else { "previous" }
}

fn valid_carry(carry: Carry) -> bool {
    carry.tower.worlds() == 2 &&
        (carry.at == STAIR || carry.tower.door_open(carry.at)) &&
        (carry.door == STAIR || carry.door < 2)
}

/// Only this game interprets its tower snapshot. Imports cannot name another game/build.
fn checked(bytes: Vec<u8>) -> Option<SaveFile> {
    let file: Result<SaveFile, LoadError> = load(bytes.clone())
    let Ok(file) = file else { return None }
    if file.game != GAME || file.version != 1 { return None }
    let carry: Result<Carry, LoadError> = load(file.body.clone())
    let Ok(carry) = carry else { return None }
    if !valid_carry(carry) { return None }
    Some(file.clone())
}

fn summary(file: SaveFile, slot: str) -> SaveInfo {
    let carry: Result<Carry, LoadError> = load(file.body.clone())
    let at = match carry {
        Ok(c) => c.at,
        Err(_) => STAIR,
    }
    SaveInfo {
        slot: slot.to_string(),
        label: String::from(if slot == "continue" { "Continue" } else if slot == "imported" {
            "Imported save"
        } else { "Previous game" }),
        description: if at == STAIR { String::from("Staircase") } else { f"World {at + 1}" },
        saved: file.saved,
    }
}

fn respond(s: mut Session, reply: Reply) {
    let bytes = save(reply)
    s.io = Some(host::reply(s.call, bytes))
    s.phase = Phase::Reply
}

fn error(s: mut Session, message: str) {
    respond(mut s, Reply::Error { message: message.to_string() })
}

fn begin(s: mut Session, request: Request) {
    s.request = Some(request.clone())
    match request {
        Request::Start => {
            if !s.prepared {
                error(mut s, "The game is not ready. Try preparing it again.")
                return
            }
            s.launch = true
            respond(mut s, Reply::Started)
        },
        Request::List { profile } => {
            if !valid_key(profile) {
                error(mut s, "Invalid profile.")
                return
            }
            s.profile = profile.clone()
            s.entries.clear()
            s.list_slot = 0
            s.io = Some(read_file(path(profile, slot_name(0))))
            s.phase = Phase::ReadSlot
        },
        Request::Prepare { profile, slot } => {
            if s.recovery_failed {
                error(
                    mut s,
                    "The latest save could not be backed up. Export it before starting another game.",
                )
                return
            }
            if !valid_key(profile) || (!slot.is_empty() && !valid_key(slot)) {
                error(mut s, "Invalid save selection.")
                return
            }
            s.profile = profile.clone()
            s.slot = slot.clone()
            s.prepared = false
            s.launch = false
            if slot.is_empty() {
                s.bytes.clear()
                s.entry = String::from("../last-green")
                s.io = Some(read_file(path(profile, "continue")))
                s.phase = Phase::Backup
            } else {
                s.io = Some(read_file(path(profile, slot)))
                s.phase = Phase::ReadSlot
            }
        },
        Request::Export { profile, slot } => {
            if s.recovery_failed && profile == s.active && slot == "continue" {
                let file = SaveFile {
                    game: String::from(GAME),
                    version: 1,
                    saved: s.saved,
                    body: s.recovered.clone(),
                }
                respond(mut s, Reply::Exported { bytes: save(file) })
                return
            }
            if !valid_key(profile) || !valid_key(slot) {
                error(mut s, "Invalid save selection.")
                return
            }
            s.profile = profile.clone()
            s.slot = slot.clone()
            s.io = Some(read_file(path(profile, slot)))
            s.phase = Phase::ReadSlot
        },
        Request::Import { profile, bytes } => {
            if !valid_key(profile) {
                error(mut s, "Invalid profile.")
                return
            }
            let Some(file) = checked(bytes) else {
                error(mut s, "This file is not a supported Last Green save.")
                return
            }
            s.profile = profile.clone()
            s.slot = String::from("imported")
            s.bytes = save(file)
            s.io = Some(store(path(profile, "imported"), s.bytes))
            s.phase = Phase::WriteSave
        },
    }
}

fn answered(s: mut Session, result: Result<Vec<u8>, std::io::IoError>) {
    match s.phase {
        Phase::Journal => {
            if let Ok(bytes) = result { s.interrupted = !bytes.is_empty() }
            s.io = Some(read_file(ACTIVE))
            s.phase = Phase::Active
        },
        Phase::Active => {
            if let Ok(bytes) = result {
                let key: Result<String, LoadError> = load(bytes.clone())
                if let Ok(key) = key { if valid_key(key) { s.active = key.clone() } }
            }
            s.io = Some(read_file(SAVE))
            s.phase = Phase::Recover
        },
        Phase::Recover => {
            if s.interrupted {
                s.phase = Phase::Idle
                return
            }
            if let Ok(bytes) = result {
                let carry: Result<Carry, LoadError> = load(bytes.clone())
                if let Ok(c) = carry {
                    if valid_carry(c) {
                        s.recovered = bytes.clone()
                        let file = SaveFile {
                            game: String::from(GAME),
                            version: 1,
                            saved: s.saved,
                            body: bytes.clone(),
                        }
                        let envelope = save(file)
                        s.io = Some(store(path(s.active, "continue"), envelope))
                        s.phase = Phase::WriteRecovery
                        return
                    }
                }
            }
            s.phase = Phase::Idle
        },
        Phase::WriteRecovery => {
            s.recovery_failed = result.is_err()
            s.phase = Phase::Idle
        },
        Phase::ReadSlot => {
            var file = match result {
                Ok(bytes) => checked(bytes),
                Err(_) => None,
            }
            if s.recovery_failed && s.profile == s.active && s.list_slot == 0 {
                file = Some(
                    SaveFile {
                        game: String::from(GAME),
                        version: 1,
                        saved: s.saved,
                        body: s.recovered.clone(),
                    },
                )
            }
            let request = s.request.clone()
            match request {
                Some(Request::List { .. }) => {
                    if let Some(file) = file {
                        s.entries.push(summary(file, slot_name(s.list_slot)))
                    }
                    s.list_slot += 1
                    if s.list_slot < 3 {
                        s.io = Some(read_file(path(s.profile, slot_name(s.list_slot))))
                    } else {
                        let entries = s.entries.clone()
                        respond(mut s, Reply::Saves { entries })
                    }
                },
                Some(Request::Export { .. }) => {
                    if let Some(file) = file {
                        respond(mut s, Reply::Exported { bytes: save(file) })
                    } else { error(mut s, "This save cannot be read.") }
                },
                Some(Request::Prepare { .. }) => {
                    let Some(file) = file else {
                        error(
                            mut s,
                            "This save cannot be read. Import a backup or start a new game.",
                        )
                        return
                    }
                    let carry: Result<Carry, LoadError> = load(file.body.clone())
                    if let Ok(c) = carry {
                        s.entry = String::from(if c.at == STAIR { "../stair" } else if c.at == 1 {
                            "../test-floor"
                        } else { "../last-green" })
                    }
                    s.bytes = file.body.clone()
                    s.io = Some(store(JOURNAL, [u8(1)]))
                    s.phase = Phase::MarkPrepare
                },
                _ => error(mut s, "Unexpected session request."),
            }
        },
        Phase::Backup => {
            if let Ok(bytes) = result {
                if let Some(file) = checked(bytes) {
                    let body = save(file)
                    s.io = Some(store(path(s.profile, "previous"), body))
                    s.phase = Phase::BackupSaved
                    return
                }
            }
            s.io = Some(store(JOURNAL, [u8(1)]))
            s.phase = Phase::MarkPrepare
        },
        Phase::BackupSaved => {
            if result.is_err() {
                error(mut s, "Your previous save could not be backed up.")
                return
            }
            s.io = Some(store(JOURNAL, [u8(1)]))
            s.phase = Phase::MarkPrepare
        },
        Phase::MarkPrepare => {
            if result.is_err() {
                error(mut s, "The save preparation could not commit. Your existing saves are kept.")
                return
            }
            s.io = Some(store(SAVE, s.bytes))
            s.phase = Phase::WriteSave
        },
        Phase::WriteSave => {
            if result.is_err() {
                error(mut s, "The save could not be written. Your previous save is kept.")
                return
            }
            if let Some(Request::Import { .. }) = s.request {
                respond(mut s, Reply::Imported)
            } else {
                let active = save(s.profile)
                s.io = Some(store(ACTIVE, active))
                s.phase = Phase::WriteProfile
            }
        },
        Phase::WriteProfile => {
            if result.is_err() {
                error(mut s, "The profile could not be saved.")
                return
            }
            s.io = Some(store(JOURNAL, [u8(0); 0]))
            s.phase = Phase::CommitPrepare
        },
        Phase::CommitPrepare => {
            if result.is_err() {
                error(mut s, "Save preparation could not commit. Try again.")
                return
            }
            s.interrupted = false
            keep(s.bytes)
            s.io = Some(prepare(s.entry))
            s.phase = Phase::Prepare
        },
        Phase::Prepare => {
            if result.is_err() {
                error(mut s, "The game could not load. Check your connection and try again.")
                return
            }
            s.prepared = true
            respond(mut s, Reply::Ready)
        },
        Phase::Reply => {
            s.request = None
            if s.launch {
                s.io = Some(hand_over(s.entry))
                s.phase = Phase::Launch
            } else { s.phase = Phase::Idle }
        },
        Phase::Launch => {
            // A failed hand-over leaves this session running; close its surface so the
            // console's readiness wait fails and can offer Retry.
            s.io = Some(std::host::request("surface/failed", [u8(0); 0]))
            s.phase = Phase::Idle
        },
        Phase::Idle => {},
    }
}

pub fn frame(s: mut Session, time: f32, width: u32, height: u32) {
    var environment = None
    match mut s.environment {
        Some(p) => environment = p.poll(),
        None => {},
    }
    if let Some(result) = environment {
        s.environment = None
        if let Ok(bytes) = result { if let Some(now) = host::word(bytes, 1) { s.saved = now } }
    }
    var answer = None
    match mut s.io {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if let Some(result) = answer {
        s.io = None
        answered(mut s, result)
    }
    if s.phase != Phase::Idle { return }
    if s.incoming.is_none() { s.incoming = Some(host::receive()) }
    var incoming = None
    match mut s.incoming {
        Some(p) => incoming = p.poll(),
        None => {},
    }
    if let Some(result) = incoming {
        s.incoming = None
        if let Ok(bytes) = result {
            let Some(id) = host::word(bytes) else { return }
            s.call = id
            var body = Vec::new()
            for i in 4..bytes.len() { body.push(bytes[i]) }
            let request: Result<Request, LoadError> = load(take body)
            match request {
                Ok(r) => begin(mut s, r),
                Err(_) => error(mut s, "Unsupported session message."),
            }
        }
    }
}

@test
fn foreign_or_truncated_saves_are_rejected_before_writing() {
    let file = SaveFile {
        game: String::from("different-game"),
        version: 1,
        saved: 0,
        body: Vec::new(),
    }
    assert(checked(save(file)).is_none())
    assert(checked(Vec::new()).is_none())
    assert(checked(Vec::filled(12, 255)).is_none())
}

// A serialization fixture can name fields that game callers cannot construct directly.
struct CarryFixture: Serialize { tower: engine::tower::Tower, at: u32, door: u32, going: u32 }

@test
fn imports_reject_locked_worlds_and_invalid_doors() {
    let file = |at: u32, door: u32| save(
        SaveFile {
            game: String::from(GAME),
            version: 1,
            saved: 0,
            body: save(
                CarryFixture { tower: engine::tower::Tower::new(2), at, door, going: 0xFFFFFFFE },
            ),
        },
    )
    assert(checked(file(0, STAIR)).is_some())
    assert(checked(file(1, STAIR)).is_none())
    assert(checked(file(0, 5)).is_none())
    assert(checked(file(4, STAIR)).is_none())
}
