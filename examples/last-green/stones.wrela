// What's built or set on the floor, where a player walks round it (#54 §5): the standing stones of
// the ring and the Warden's arena, the waystones, the rests' seats and the small stones of the
// echoes' sites as stones (x, z, radius); the tower as a stone of its own breadth; the ruins'
// walls (each two points: a wall's line). From the map's sites, so each is where the map puts it:
// the renderer draws the same ones (`engine::footing`'s obstacles, the check's walking).

use engine::noise::rand
use engine::place::{Feature, Map, Site, SiteKind}
use std::math::TAU

/// The tower's radius over its battered foot (m), and how far the batter stands out past it.
pub const TOWER_RADIUS: f32 = 4.6
pub const TOWER_BATTER: f32 = 0.4

/// How far the tower's foot reaches from its axis, and its height (m).
pub const TOWER_FOOT: f32 = TOWER_RADIUS + TOWER_BATTER
pub const TOWER_TALL: f32 = 22.0

/// A ring's stones: how many, and how far round from its middle (a share of the site's reach).
pub const RING_STONES: u32 = 11
pub const RING_AT: f32 = 0.8

/// Which way a ring opens (radians round it, as `atan2(z, x)`): toward the floor's low sun
/// (`main::SUN`: x 0.900, z -0.159), so the sun comes in through its threshold and lights its
/// great stone across the ring.
pub const THRESHOLD: f32 = -0.175

/// A ring's stone: where it stands (x, z), its half size (x along the ring, y up, z across it)
/// and its turn about +y (its x along the ring). A fallen stone lies: its half height is less
/// than its half breadth.
pub struct Standing: Copy {
    pub at: vec2,
    pub half: vec3,
    pub turn: f32,
}

/// The angular distance between `a` and `b`.
pub fn apart(a: f32, b: f32) -> f32 {
    let d = abs(a - b) % TAU
    min(d, TAU - d)
}

/// The turn about +y that lays a stone's x along the direction at angle `a`.
fn along(a: f32) -> f32 {
    -atan2(sin(a), cos(a))
}

/// A ring's stones, as its builders set them: a threshold toward the sun (`THRESHOLD`), wider
/// than the other gaps and held by two taller portal stones; across the ring from it the great
/// stone, the tallest and broadest, with the stones graded up toward it; one stone fallen; and
/// at the centre, the ring's own stone (a squat broad stone across the axis; the arena's
/// low and broad, a table that keeps its floor open). Each stands with its broad face to the
/// centre.
pub fn ring(k: Site) -> Vec<Standing> {
    let arena = k.kind == SiteKind::Arena
    let n = if arena { RING_STONES + 6 } else { RING_STONES }
    let seed = u32(abs(k.at.x) * 7.0 + abs(k.at.y) * 13.0)
    let r = k.reach * RING_AT
    // The threshold's gap is 1.8 of the others.
    let space = TAU / (f32(n) + 0.8)
    let great = (n - 1) / 2
    let fallen = 2 + seed % 3
    var out: Vec<Standing> = Vec::new()
    for i in 0..n {
        let a = THRESHOLD + space * (0.9 + f32(i) + 0.3 * (rand(seed + i, 1) - 0.5))
        let at = k.at + vec2(cos(a), sin(a)) * r * (0.97 + 0.06 * rand(seed + i, 2))
        // 0 at the threshold, 1 across the ring.
        let u = apart(a, THRESHOLD) / (0.5 * TAU)
        var wide = 0.42 + 0.16 * rand(seed + i, 3)
        let deep = 0.24 + 0.08 * rand(seed + i, 4)
        var stretch = 1.0
        if i != great && i != 0 && i != n - 1 {
            // Each stone its own kind: a needle, a broad stone or a pillar.
            let kind = rand(seed + i, 7)
            if kind < 0.33 {
                wide = 0.28 + 0.06 * rand(seed + i, 3)
                stretch = 1.35
            } else if kind < 0.66 {
                wide = 0.85 + 0.25 * rand(seed + i, 3)
                stretch = 0.8
            }
        }
        let grade = if i == great {
            2.0
        } else if i == 0 || i == n - 1 {
            1.5
        } else if i + 1 == great || i == great + 1 {
            1.1
        } else {
            0.55 + 0.3 * u + 0.15 * rand(seed + i, 5)
        }
        let tall = grade * k.tall * stretch
        let turn = along(a + 0.25 * TAU) + 0.3 * (rand(seed + i, 6) - 0.5)
        let half = if i == great {
            vec3(1.1, 0.5 * tall, 0.45)
        } else if i == fallen {
            // Fallen outward, lying along the ring.
            vec3(0.5 * tall, 0.3, wide)
        } else {
            vec3(wide, 0.5 * tall, deep)
        }
        let out_by = if i == fallen { 0.6 } else { 0.0 }
        out.push(Standing { at: at + vec2(cos(a), sin(a)) * out_by, half, turn })
    }
    // The centre's stone, its long side across the axis from the threshold to the great stone.
    let half = if arena { vec3(1.5, 0.45, 1.0) } else { vec3(0.8, 0.55, 0.55) }
    out.push(Standing { at: k.at, half, turn: along(THRESHOLD + 0.25 * TAU) })
    out
}

/// A ring's stone's footprint: its radius on the ground (m).
pub fn footprint(s: Standing) -> f32 {
    max(s.half.x, s.half.z) + 0.05
}

/// A curved wall on the map: round `at`, `r` from it, from angle `from` to `to` (radians, as
/// `atan2(z, x)`, `to` past `from`), `wide` across and `tall` high.
pub struct Curved: Copy {
    pub at: vec2,
    pub r: f32,
    pub from: f32,
    pub to: f32,
    pub wide: f32,
    pub tall: f32,
}

/// The longest stretch of a curved wall in one piece (m): a piece is realized alone.
const PIECE: f32 = 24.0

/// Where the map's routes cross the circle round `at`, `r` from it: each crossing's angle and
/// half the gap a route needs there (radians: its width, and a metre and a half each side).
fn crossings(m: Map, at: vec2, r: f32) -> Vec<vec2> {
    var out: Vec<vec2> = Vec::new()
    for route in m.routes {
        let half = (0.5 * route.width + 1.5) / r
        for i in 0..route.points.len() - 1 {
            let a = route.points[i] - at
            let b = route.points[i + 1] - at
            let ab = b - a
            // |a + t ab| = r: t² ab·ab + 2t a·ab + a·a - r² = 0.
            let qa = dot(ab, ab)
            let qb = 2.0 * dot(a, ab)
            let qc = dot(a, a) - r * r
            let disc = qb * qb - 4.0 * qa * qc
            if qa > 0.0 && disc >= 0.0 {
                for sign in [-1.0, 1.0] {
                    let t = (-qb + sign * sqrt(disc)) / (2.0 * qa)
                    if t >= 0.0 && t <= 1.0 {
                        let p = a + ab * t
                        out.push(vec2(atan2(p.y, p.x), half))
                    }
                }
            }
        }
    }
    out
}

/// A wall round `at`, `r` from it, from angle `from` to `to`, open where the map's
/// routes cross it and at `gaps` (each an angle and half its width, radians), in pieces no
/// longer than `PIECE`.
fn round(
    m: Map,
    at: vec2,
    r: f32,
    span: vec2,
    gaps: Vec<vec2>,
    wide: f32,
    tall: f32,
    out: mut Vec<Curved>,
) {
    var open = crossings(m, at, r)
    for g in gaps {
        open.push(g)
    }
    // Walk along it in steps of about 20 cm, keeping the stretches no gap touches.
    let steps = u32(ceil((span.y - span.x) * r / 0.2))
    var start = -1.0
    for i in 0..steps + 1 {
        let a = mix(span.x, span.y, f32(i) / f32(steps))
        var shut = i < steps
        for g in open {
            if apart(a, g.x) < g.y {
                shut = false
            }
        }
        if shut && start < span.x {
            start = a
        }
        if start >= span.x && (!shut || (a - start) * r >= PIECE) {
            if a - start > 0.5 / r {
                out.push(Curved { at, r, from: start, to: a, wide, tall })
            }
            start = if shut { a } else { span.x - 1.0 }
        }
    }
}

/// The curved walls the floor's people left at the town's site: its terraces' walls and the
/// round footings of its houses.
pub fn curved(m: Map) -> Vec<Curved> {
    var out: Vec<Curved> = Vec::new()
    for k in m.sites {
        let seed = u32(abs(k.at.x) * 7.0 + abs(k.at.y) * 13.0)
        if k.kind == SiteKind::Town {
            // The town stepped down its slope in rings of terrace walls, each fallen in a stretch
            // or two, and open where a way crosses it.
            for t in 0..3 {
                let gaps = Vec::from(
                    [
                        vec2(TAU * rand(seed + 30 + t, 1), 0.08 + 0.12 * rand(seed + 30 + t, 2)),
                        vec2(TAU * rand(seed + 30 + t, 3), 0.05 + 0.1 * rand(seed + 30 + t, 4)),
                    ],
                )
                round(
                    m,
                    k.at,
                    TERRACES.x + TERRACES.y * f32(t),
                    vec2(0.0, TAU),
                    gaps,
                    wide: 0.8,
                    tall: 1.3 - 0.2 * f32(t),
                    out: mut out,
                )
            }
            // Its houses' round footings on the terraces between the walls, each door toward
            // the town's middle. Like the terrace walls, lower than the eye (1.7 m).
            for i in 0..HOUSES {
                let a = TAU * (f32(i) + 0.6 * rand(seed + i, 1)) / f32(HOUSES)
                let r = 2.6 + 0.6 * rand(seed + i, 2)
                let ring = TERRACES.x + TERRACES.y * (0.5 + f32(i % 2))
                let at = k.at + vec2(cos(a), sin(a)) * ring
                var clear = true
                for route in m.routes {
                    if route.distance(at).x < 0.5 * route.width + r + 1.5 {
                        clear = false
                    }
                }
                if clear {
                    let door = vec2(a + 0.5 * TAU, 0.8 / r)
                    round(
                        m,
                        at,
                        r,
                        vec2(0.0, TAU),
                        Vec::from([door]),
                        wide: 0.6,
                        tall: 0.9 + 0.7 * rand(seed + i, 4),
                        out: mut out,
                    )
                }
            }
        }
    }
    out
}

/// The town's site's terrace walls' first radius and the step between them (m), and how many
/// houses' footings it has.
const TERRACES: vec2 = vec2(11.0, 10.0)
const HOUSES: u32 = 8

/// The land's height at `p` after the earthworks the floor's people shaped in it, from its
/// height `y` before them: round the Warden's arena a bank, a ditch inside it, the stones'
/// ring within; both open at its threshold and where each way comes in (exactly `y` farther
/// than `WORKS_REACH` from the arena).
pub fn earthworks(p: vec2, y: f32) -> f32 {
    let q = p - ARENA
    let d = length(q)
    if d >= WORKS_REACH {
        return y
    }
    let a = atan2(q.y, q.x)
    var open = 1.0
    for g in ARENA_WAYS {
        open = min(open, smoothstep(g.y, g.y + 3.0, apart(a, g.x) * max(d, 1.0)))
    }
    y + open * (BANK.z * bell((d - BANK.x) / BANK.y) - DITCH.z * bell((d - DITCH.x) / DITCH.y))
}

/// A bell 1 at 0, falling to 0 at ±1 (and flat past them).
fn bell(t: f32) -> f32 {
    0.5 + 0.5 * cos(3.14159265 * clamp(t, -1.0, 1.0))
}

/// The Warden's arena's middle (`map`'s site), and the ways into it: each an angle round it
/// (as `atan2(z, x)`) and half its opening (m): its threshold, the pine trail and the heath path.
const ARENA: vec2 = vec2(1450.0, -1150.0)
const ARENA_WAYS: [vec2; 3] = [vec2(THRESHOLD, 3.5), vec2(2.554, 3.5), vec2(0.785, 3.0)]
/// The arena's bank and ditch: each its radius, half its width and its height or depth (m);
/// and how far from its middle the earthworks reach.
const BANK: vec3 = vec3(31.0, 4.0, 1.6)
const DITCH: vec3 = vec3(26.5, 2.0, 0.7)
const WORKS_REACH: f32 = 36.0

/// The floor's stones: each (x, z, radius).
pub fn stones(m: Map) -> Vec<vec3> {
    var out: Vec<vec3> = Vec::new()
    for k in m.sites {
        match k.feature {
            Feature::Ring => {
                for s in ring(k) {
                    out.push(vec3(s.at, footprint(s)))
                }
            },
            Feature::Tower => out.push(vec3(k.at.x, k.at.y, TOWER_FOOT)),
            // A stone a player stands beside (a waystone, a seat, a cairn); a taller "stone" is
            // the land's own rock (the quarry's face).
            Feature::Stone => {
                if k.tall <= 2.5 {
                    out.push(vec3(k.at.x, k.at.y, 0.3 + 0.15 * k.tall))
                }
            },
            _ => {},
        }
    }
    out
}

/// The ruins' walls: each a line (a, b); a ruin's walls are a rectangle round its site, its long
/// side across the x axis, with a doorway in its south wall.
pub fn ruin_walls(m: Map) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for k in m.sites {
        if k.feature == Feature::Ruin && k.tall > 1.0 {
            let h = vec2(k.reach * 0.7, k.reach * 0.45)
            let a = k.at + vec2(-h.x, -h.y)
            let b = k.at + vec2(h.x, -h.y)
            let c = k.at + vec2(h.x, h.y)
            let d = k.at + vec2(-h.x, h.y)
            // Its doorway, wide enough for a player past the walls' rubble (4 m).
            let door = 2.0
            out.push(vec4(a.x, a.y, k.at.x - door, a.y))
            out.push(vec4(k.at.x + door, a.y, b.x, b.y))
            out.push(vec4(b.x, b.y, c.x, c.y))
            out.push(vec4(c.x, c.y, d.x, d.y))
            out.push(vec4(d.x, d.y, a.x, a.y))
        }
    }
    out
}

/// What a player walks round of the floor's walls: the ruins' walls, and the curved walls in
/// chords about 2 m long.
pub fn walls(m: Map) -> Vec<vec4> {
    var out = ruin_walls(m)
    for c in curved(m) {
        let n = u32(ceil((c.to - c.from) * c.r / 2.0))
        for i in 0..n {
            let a = mix(c.from, c.to, f32(i) / f32(n))
            let b = mix(c.from, c.to, f32(i + 1) / f32(n))
            let p = c.at + vec2(cos(a), sin(a)) * c.r
            let q = c.at + vec2(cos(b), sin(b)) * c.r
            out.push(vec4(p.x, p.y, q.x, q.y))
        }
    }
    out
}
