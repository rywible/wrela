// The clearing's clouds (#28 §6): a few great cumulus heaped over the valley and behind the
// forest, placed for the shot, and fair-weather puffs between them (spike 15's cloudscape).

use engine::noise::rand
use engine::sky::{BASE, Puff, cumulus}

pub fn cloudscape() -> Vec<Puff> {
    var p: Vec<Puff> = Vec::new()
    cumulus(mut p, vec2(-4600.0, 12500.0), wide: 4200.0, tall: 3600.0, seed: 1, base: BASE)
    cumulus(mut p, vec2(-10800.0, 14500.0), wide: 3400.0, tall: 2600.0, seed: 2, base: BASE)
    cumulus(mut p, vec2(3400.0, 16000.0), wide: 3800.0, tall: 3000.0, seed: 3, base: BASE)
    cumulus(mut p, vec2(9500.0, 11000.0), wide: 2600.0, tall: 1900.0, seed: 4, base: BASE)
    for k in 0..26 {
        let a = -1.0 + 2.0 * rand(500 + k, 1)
        let d = 3500.0 + 9000.0 * rand(500 + k, 2)
        let at = vec2(sin(a) * d, cos(a) * d)
        cumulus(
            mut p,
            at,
            wide: 700.0 + 900.0 * rand(500 + k, 3),
            tall: 500.0 + 600.0 * rand(500 + k, 4),
            seed: 10 + k,
            base: BASE,
        )
    }
    p
}
