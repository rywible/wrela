// The Last Green's clearing (#28, #51), drawn by the engine's renderer: the scene at half the
// output's resolution, jittered, into a linear-light target with depth and tags; temporal AA
// brings it up to the output; the look's passes draw it to the screen.

use creature::{Fawn, REALIZED, walker_body}
use engine::character::{
    character, character_motion, character_shade, character_shadow, colours, motion, parts_of,
}
use engine::gait::{Body, between, palette}
use engine::grass::{Blooms, Grass, GrassLook}
use engine::present::Snapshots
use engine::realize::Realizing
use engine::render::MAX_BONES
use engine::run::run
use fawn::creature::fawn
use engine::air::{Air, Tables, hazy, tables}
use engine::light::{Light, SUN_TOP, sunlight}
use engine::paint::{
    Develop, Exposure, Look, Metering, dab_map, develop, glow_blur, glow_down, meter,
}
use engine::lit::Lighting
use engine::plant::{Wind, leaf_atlas}
use engine::probes::{Baked, Occluder, Probe, ProbeGrid, Reference, Sampling, Trace, grid, reference}
use engine::shadow::{Cascade, Shadows, shadows}
use engine::stone::{Realized, stone_shade, stone_shadow, stone_vertex}
use engine::sky::{Clouds, Sky, new_sky, sky_shade}
use engine::temporal::{Resolve, neighbourhoods, resolve, seen_box}
use engine::terrain::{Clipmap, Terrain, Texel, ground, ground_shade}
use engine::vegetation::{Forest, Kind, kind, nothing}
use engine::view::{BEHIND, Camera, NEAREST, camera, first_camera}
use std::gpu::dispatch
use std::collections::{replace, swap}
use scene::{FOVY, Ground, LOOK_AT, MEADOW, SUN, start_eye}
use std::gpu::{
    Address, ClipPosition, Compare, ComparisonSampler, Cull, Depth, DepthBias, DepthTexture,
    FragCoord, GpuBuffer, GpuSpan, Rgba16Float, Rgba8, Sampler, Texture, Unorm8x4, VertexIndex,
    begin_depth_pass, begin_pass, begin_pass_with_depth, begin_screen_pass, buffer,
    comparison_sampler, depth_texture, draw, label, present, sampler, texture, writable_texture,
    write,
}
use std::input::{Event, Key, events}
use std::io::print
use std::lift::{Watch, reads}
use std::reload::{keep, kept}
use std::serialize::{LoadError, Serialize, load, save}
use trees::{KINDS, kind_plant, occluders, placed}
use clouds::{CLOUD_WIND, FAIR, SUN_GAP, cloudscape}
use rocks::{BOULDERS, boulder, boulders, footprints}
use path::shot
use world::{World, present as snapshot, spawn, tick}

/// The scene's size against the output's: half each way (Q3 of #51).
const SCALE: u32 = 2

/// How the camera meters (`paint::meter`): the start's view, settled (its mean luminance
/// 0.136), at the exposure the look was picked at; other views half-way (in stops) to the same
/// mean.
const METERING = Metering {
    base: 0.62,
    reference: 0.136,
    strength: 0.5,
    lo: 0.15,
    hi: 0.75,
    rate: 0.05,
    fresh: 0,
}

/// The forest's card width for its levels, in the scene's pixels (`Lod::card_px`): the levels
/// are chosen as the game draws them, at `SCALE`, so a scene drawn at another scale (a test's
/// native frame) draws the same levels and fades, the same content.
fn card_px(scale: u32) -> f32 {
    engine::lod::CARD_PX * f32(SCALE) / f32(scale)
}

/// What's cooked a frame at load, so each frame's GPU work stays short (the GPU safety rule,
/// AC6): a slice of the creature's mesh (`Realizing`), two of the forest's kinds, and a
/// boulder.
const CREATURE_SLICES: u32 = 1
const KINDS_PER_FRAME: u32 = 2

/// The static cascades: the clearing's (about 7 cm a texel) and the valley's.
const NEAR_CASCADE = Cascade { centre: vec3(0.0, 4.0, 36.0), span: 144.0, reach: 250.0, side: 2048 }
const FAR_CASCADE = Cascade {
    centre: vec3(-60.0, -40.0, 330.0),
    span: 1040.0,
    reach: 1300.0,
    side: 2048,
}

/// What a build carries across a hot reload (`std::reload`): where the camera's path is, and
/// how the clearing is shown. The rest is made again, as at load.
struct Carried: Clone + Serialize {
    path_from: f32,
    asked: bool,
    follow: vec3,
    follow_heading: f32,
    off: u32,
    view: u32,
    scale: u32,
    held: bool,
    held_eye: vec3,
    held_at: vec3,
}

/// What's cooked at load from the clearing's own literals, each watched by the literals its
/// code reads (`std::lift::reads`): an edit of one (hot reload) cooks it again.
struct Watches {
    light: Watch,
    forest: Watch,
    stones: Watch,
    clouds: Watch,
    ground: Watch,
}

impl Watches {
    fn new() -> Watches {
        Watches {
            light: Watch::new(reads(sun_light)),
            forest: Watch::new(reads(forest_source)),
            stones: Watch::new(reads(stones_source)),
            clouds: Watch::new(reads(clouds_source)),
            ground: Watch::new(reads(ground_source)),
        }
    }
}

/// The air the clearing's sun shines through, its tables cooked from the eye's start.
fn air_of() -> Air {
    hazy(SUN, SUN_TOP, eye: start_eye().y)
}

/// The sun's light.
fn sun_light() -> Light {
    sunlight(air_of())
}

/// The code that makes the forest: the kinds' plants and where they stand.
fn forest_source() -> u32 {
    var cards = placed().len()
    for k in 0..KINDS {
        cards += kind_plant(k).cards()
    }
    cards
}

fn stones_source() -> u32 {
    boulders().len()
}

fn clouds_source() -> u32 {
    // The cloudscape, its fair-weather clouds' share and its gap.
    cloudscape().len() + u32(FAIR * 1000.0) + u32(SUN_GAP.radius)
}

/// The ground's field, as the clipmap cooks it.
fn ground_source() -> f32 {
    let g = Ground {}
    g.height(x: 0.0, z: 0.0) + g.cover(at: vec3(0.0), n: vec3(0.0, 1.0, 0.0)).grass
}

/// The forest: each kind's plant (trees.wrela) cooked, and where the trees stand.
fn forest_of(atlas: Texture<Rgba8>, linear: Sampler) -> Forest {
    var kinds: Vec<Kind> = Vec::new()
    for k in 0..KINDS {
        kinds.push(kind(kind_plant(k), seed: k + 1, atlas: atlas, s: linear))
    }
    Forest::new(take kinds, placed(), cards_to: 150.0, impostors_to: 1000.0)
}

/// The probes over the meadow, unbaked, and what occludes them: the trees and the boulders.
fn probes_of() -> Baked {
    var plants: Vec<engine::plant::Plant> = Vec::new()
    for k in 0..KINDS {
        plants.push(kind_plant(k))
    }
    let p = placed()
    let g = grid(MEADOW, cols: 81, spacing: 2.0, low: -12.0, high: 40.0, voxel: 1.0)
    var occ = occluders(p, plants, lo: g.corner, hi: g.corner + vec2(160.0))
    for st in rocks::SPOTS {
        let y = scene::height(x: st.x, z: st.y) + st.z * 0.25
        occ.push(
            Occluder {
                a: vec3(st.x, y, st.y),
                radius: st.z * 1.05,
                b: vec3(st.x, y, st.y),
                solid: 1.0,
            },
        )
    }
    Baked::new(g, occ)
}

/// A grid of one probe, for the next probes before an edit asks for them.
fn no_probes() -> Baked {
    let none: Vec<Occluder> = Vec::new()
    Baked::new(grid(MEADOW, cols: 1, spacing: 1.0, low: 0.0, high: 1.0, voxel: 1.0), none)
}

pub struct Clearing {
    /// The sim's snapshots, the creature's mesh and colours, its body for walking, and its
    /// palettes: this frame's and the last.
    snaps: Snapshots<World>,
    /// The creature's mesh, realized a few slices a frame (a short submission each), and its
    /// colours, once it's whole.
    creature: Realizing,
    creature_done: bool,
    colours: GpuBuffer<Unorm8x4>,
    body: Body,
    palette: GpuBuffer<mat4>,
    last_palette: GpuBuffer<mat4>,
    /// When the camera's path began (the frame's time; negative before), and where the camera
    /// follows the creature from (smoothed).
    path_from: f32,
    follow: vec3,
    follow_heading: f32,
    clipmap: Clipmap,
    stones: Vec<Realized>,
    light: Light,
    /// The air the sun shines through, its tables, and whether they're cooked for it (with the
    /// probes' open sky, from them).
    air: Air,
    tables: Tables,
    air_cooked: bool,
    cam: Camera,
    /// The forest, its kinds cooked a few a frame at load (a short submission each): until
    /// they're all cooked, a forest of none.
    forest: Forest,
    kinds: Vec<Kind>,
    forest_done: bool,
    grass: Grass,
    /// The shadow maps: the static cascades (drawn when something static changes), and the
    /// moving map.
    near: DepthTexture,
    far: DepthTexture,
    moving: DepthTexture,
    cmp: ComparisonSampler,
    static_drawn: bool,
    /// The probes, baked over the first frames, and whether the occluders are cooked. After an
    /// edit, the next probes bake beside them, and take over when they're done.
    probes: Baked,
    occluders_cooked: bool,
    next_probes: Baked,
    next_cooked: bool,
    rebaking: bool,
    /// The leaves' atlas, which the forest's kinds are cooked with.
    atlas: Texture<Rgba8>,
    /// What's cooked from literals (hot reload), and whether this build took over from another:
    /// it shows nothing until it's cooked everything, so the screen keeps the old build's frame.
    watches: Watches,
    restored: bool,
    /// Whether everything cooked at load is done, and the frame it was.
    ready: bool,
    /// Whether the camera's path was asked for (it starts once the clearing's ready).
    asked: bool,
    /// The clouds: their noises, weather and shadow maps and dome (`engine::sky`), and whether
    /// the noises and the maps are cooked (the maps again after an edit).
    sky: Sky,
    noise_cooked: bool,
    sky_cooked: bool,
    /// The clouds as the last frame drew them (where their field had drifted).
    clouds: Clouds,
    /// The scene: linear colour and tags, depth, motion; and the output's history, two to swap.
    scene: Texture<Rgba16Float>,
    depth: DepthTexture,
    /// Which far tree won each pixel of the prepass (`impostor::far_cut`).
    ids: Texture<Rgba8>,
    motion: Texture<Rgba16Float>,
    /// Each scene pixel's neighbourhood, for temporal AA: its 3 × 3 samples' mean and spread
    /// (`temporal::neighbourhoods`).
    means: Texture<Rgba16Float>,
    spreads: Texture<Rgba16Float>,
    history_a: Texture<Rgba16Float>,
    history_b: Texture<Rgba16Float>,
    /// The dabs and tooth, at the scene's size.
    dabs: Texture<Rgba16Float>,
    /// The glow's chain, at a quarter of the output's size.
    glow_a: Texture<Rgba16Float>,
    glow_b: Texture<Rgba16Float>,
    /// The metered exposure, and the scene's mean luminance (`paint::meter`).
    exposure: GpuBuffer<Exposure>,
    linear: Sampler,
    /// A linear sampler that tiles (the clouds' noises and maps).
    repeat: Sampler,
    width: u32,
    height: u32,
    frames: u32,
    /// The systems left out of the frame (`off`'s bits), for timing each and for looking.
    off: u32,
    /// What the tests set (testing.wrela): how a frame is shown, the scene's scale against the
    /// output, a camera held in place, whether the clouds' shadow map needs cooking again (for
    /// one left out or back), whether the next frame counts the cards' shading, and the
    /// shadows the last frame drew by.
    view: u32,
    scale: u32,
    held: bool,
    held_eye: vec3,
    held_at: vec3,
    clouds_again: bool,
    counting: bool,
    sh: Shadows,
    /// The last counts and captures, which a test reads back (each the newest buffer).
    shaded: GpuBuffer<u32>,
    covering: GpuBuffer<u32>,
    captured: GpuBuffer<vec4>,
    captured_depth: GpuBuffer<f32>,
    captured_counts: GpuBuffer<u32>,
    captured_texels: GpuBuffer<Texel>,
    references: GpuBuffer<Reference>,
}

/// The systems a frame can leave out, and the keys that toggle them.
const TREES: u32 = 1
const GRASS: u32 = 2
const SHADOWS: u32 = 4
const TERRAIN: u32 = 8

/// Whether a system is in the frame.
fn on(off: u32, system: u32) -> bool {
    (off & system) == 0
}

fn keys(s: mut Clearing, time: f32) {
    for e in events() {
        if let Event::KeyDown { key, .. } = e {
            if key == Key::Space {
                s.asked = true
            }
            let system = match key {
                Key::T => TREES,
                Key::G => GRASS,
                Key::H => SHADOWS,
                Key::L => TERRAIN,
                _ => 0,
            }
            s.off = s.off ^ system
            if system == SHADOWS {
                s.static_drawn = false
            }
        }
    }
}

pub fn init() -> Clearing {
    let world = spawn()
    let latest = run(take world, hz: 60, step: tick, present: snapshot)
    let creature = Realizing::start(fawn(), REALIZED)
    let atlas = leaf_atlas(6)

    print(f"forest: {KINDS} kinds, {placed().len()} instances")
    let probes = probes_of()
    print(
        f"probes: {probes.grid.probes()} in {probes.grid.cols * probes.grid.cols} columns, {probes.occluder_count} occluders",
    )
    print(f"clouds: {cloudscape().len()} cumulus")
    let w = spawn().walker
    let back: Result<Carried, LoadError> = load(kept())
    var s = Clearing {
        snaps: Snapshots::new(take latest, hz: 60),
        creature: take creature,
        creature_done: false,
        colours: buffer(1),
        body: walker_body(),
        palette: buffer(MAX_BONES),
        last_palette: buffer(MAX_BONES),
        path_from: -1.0,
        follow: w.root.pos,
        follow_heading: w.root.heading,
        clipmap: Clipmap::new(levels: 11, finest: 0.125),
        stones: Vec::new(),
        light: sun_light(),
        air: air_of(),
        tables: tables(),
        air_cooked: false,
        cam: first_camera(start_eye(), LOOK_AT, FOVY, width: 960, height: 540),
        forest: Forest::new(Vec::new(), Vec::new(), cards_to: 150.0, impostors_to: 1000.0),
        kinds: Vec::new(),
        forest_done: false,
        grass: Grass::new(),
        near: depth_texture(width: NEAR_CASCADE.side, height: NEAR_CASCADE.side),
        far: depth_texture(width: FAR_CASCADE.side, height: FAR_CASCADE.side),
        moving: depth_texture(width: 1024, height: 1024),
        cmp: comparison_sampler(),
        static_drawn: false,
        probes: take probes,
        occluders_cooked: false,
        next_probes: no_probes(),
        next_cooked: false,
        rebaking: false,
        atlas: take atlas,
        watches: Watches::new(),
        restored: false,
        ready: false,
        asked: false,
        sky: new_sky(),
        noise_cooked: false,
        sky_cooked: false,
        clouds: Clouds {
            eye: vec3(0.0),
            phase: 0,
            sun: SUN,
            blend: 1.0,
            drift: vec2(0.0),
            seed: 0,
        },
        scene: texture::<Rgba16Float>(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        ids: texture::<Rgba8>(width: 1, height: 1),
        motion: texture::<Rgba16Float>(width: 1, height: 1),
        means: writable_texture::<Rgba16Float>(width: 1, height: 1),
        spreads: writable_texture::<Rgba16Float>(width: 1, height: 1),
        history_a: texture::<Rgba16Float>(width: 1, height: 1),
        history_b: texture::<Rgba16Float>(width: 1, height: 1),
        dabs: texture::<Rgba16Float>(width: 1, height: 1),
        glow_a: texture::<Rgba16Float>(width: 1, height: 1),
        glow_b: texture::<Rgba16Float>(width: 1, height: 1),
        exposure: buffer(1),
        linear: sampler(),
        repeat: sampler(address: Address::Repeat),
        width: 0,
        height: 0,
        frames: 0,
        off: 0,
        view: testing::LOOK,
        scale: SCALE,
        held: false,
        held_eye: vec3(0.0),
        held_at: vec3(0.0),
        clouds_again: false,
        counting: false,
        sh: shadows(SUN, NEAR_CASCADE, FAR_CASCADE, vec3(0.0), 6.0, moving_side: 1024, frame: 0),
        shaded: buffer(1),
        covering: buffer(1),
        captured: buffer(1),
        captured_depth: buffer(1),
        captured_counts: buffer(1),
        captured_texels: buffer(1),
        references: buffer(1),
    }
    if let Ok(c) = back {
        s.restored = true
        s.path_from = c.path_from
        s.asked = c.asked
        s.follow = c.follow
        s.follow_heading = c.follow_heading
        s.off = c.off
        s.view = c.view
        s.scale = c.scale
        s.held = c.held
        s.held_eye = c.held_eye
        s.held_at = c.held_at
    }
    s
}

/// What's cooked from a literal an edit changed (hot reload), cooked again: the sky, the
/// forest, the boulders, the clouds, the ground; then the shadows and the probes they light.
/// The probes bake beside the ones in use, which stay until they're done.
fn cook_again(s: mut Clearing, eye: vec3) {
    var shadows = false
    var probes = false
    var clouds = false
    if s.watches.light.changed() {
        s.light = sun_light()
        s.air = air_of()
        s.air_cooked = false
        shadows = true
        probes = true
        clouds = true
    }
    if s.watches.forest.changed() {
        s.forest = forest_of(s.atlas, s.linear)
        s.forest.card_px = card_px(s.scale)
        s.forest.cell = 1.0 / f32(s.scale)
        shadows = true
        probes = true
    }
    if s.watches.stones.changed() {
        s.stones = boulders()
        shadows = true
        probes = true
    }
    if s.watches.clouds.changed() {
        clouds = true
    }
    if s.watches.ground.changed() {
        s.clipmap.follow(Ground {}, eye, again: true)
        shadows = true
        probes = true
    }
    if shadows {
        s.static_drawn = false
    }
    if probes {
        s.next_probes = probes_of()
        s.next_cooked = false
        s.rebaking = true
    }
    if clouds {
        s.sky_cooked = false
    }
}

/// What the clearing carries across a hot reload, kept each frame.
fn keep_carried(s: Clearing) {
    let c = Carried {
        path_from: s.path_from,
        asked: s.asked,
        follow: s.follow,
        follow_heading: s.follow_heading,
        off: s.off,
        view: s.view,
        scale: s.scale,
        held: s.held,
        held_eye: s.held_eye,
        held_at: s.held_at,
    }
    let bytes = save(c)
    keep(bytes)
}

/// A triangle that covers the target, at depth `z`.
@vertex
pub fn cover(v: VertexIndex, z: f32) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, z, 1.0) }
}

/// The look's passes: the glow's chain from `image` (a quarter's size, blurred across and
/// down), then the image developed to the screen.
fn look(
    image: Texture<Rgba16Float>,
    depth: DepthTexture,
    dabs: Texture<Rgba16Float>,
    s: Sampler,
    glow_a: mut Texture<Rgba16Float>,
    glow_b: mut Texture<Rgba16Float>,
    exposure: GpuSpan<Exposure>,
    d: Develop,
) {
    label("look glow")
    let down = begin_pass(mut glow_a)
    draw(
        cover.bind(z: 0.5),
        glow_down.bind(image, s: s, threshold: 1.1, base: METERING.base, exposure: exposure),
        vertices: 3,
    )
    down.end()
    label("look glow")
    let x = begin_pass(mut glow_b)
    draw(cover.bind(z: 0.5), glow_blur.bind(src: glow_a, across: 0, spread: 2.0), vertices: 3)
    x.end()
    label("look glow")
    let y = begin_pass(mut glow_a)
    draw(cover.bind(z: 0.5), glow_blur.bind(src: glow_b, across: 1, spread: 2.0), vertices: 3)
    y.end()
    label("look develop")
    begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        cover.bind(z: 0.5),
        develop.bind(d, image, depth, glow: glow_a, dabs: dabs, s: s, exposure: exposure),
        vertices: 3,
    )
    present()
}

/// Temporal AA's pass: the history `from` resolved with this frame's scene into `into`.
fn temporal(
    into: mut Texture<Rgba16Float>,
    from: Texture<Rgba16Float>,
    r: Resolve,
    scene: Texture<Rgba16Float>,
    depth: DepthTexture,
    motion: Texture<Rgba16Float>,
    means: mut Texture<Rgba16Float>,
    spreads: mut Texture<Rgba16Float>,
    s: Sampler,
) {
    dispatch(neighbourhoods.bind(scene, mut means, mut spreads), over: scene)
    let p = begin_pass(mut into)
    draw(
        cover.bind(z: 0.5),
        resolve.bind(r, scene, depth, motion, from, means, spreads, s),
        vertices: 3,
    )
    p.end()
}

/// How the probes trace: through the occluders, the crowns' dim green (and, bounced, their
/// leaves' albedo), 48 m.
fn trace_of(s: Clearing) -> Trace {
    Trace {
        light: s.light,
        grid: s.probes.grid,
        foliage: vec3(0.035, 0.07, 0.02),
        reach: 48.0,
        leaf: vec3(0.10, 0.18, 0.04),
        bounced: 0,
    }
}

/// Last frame's palette, kept for the motion target.
fn copy_palette(s: mut Clearing) {
    std::gpu::copy(
        from: s.palette.span(start: 0, count: MAX_BONES),
        to: s.last_palette.span_mut(start: 0, count: MAX_BONES),
    )
}

/// The static cascades: the forest, cut to its leaves, into each.
fn static_shadows(s: mut Clearing, sh: Shadows, wind: Wind) {
    label("shadows static")
    let shadows = on(s.off, SHADOWS)
    let near = begin_depth_pass(mut s.near, clear_depth: 1.0)
    if shadows {
        s.forest.shadow(view: sh.near, sh: sh, wind: wind, s: s.linear)
    }
    if shadows {
        for st in s.stones {
            draw(
                stone_shadow.bind(verts: st.mesh.verts.items(), at: st.at, view: sh.near),
                nothing,
                indices: st.mesh.quads.items(),
                indirect: st.mesh.draw.items(),
                depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
            )
        }
    }
    near.end()
    let far = begin_depth_pass(mut s.far, clear_depth: 1.0)
    if shadows {
        s.forest.shadow(view: sh.far, sh: sh, wind: wind, s: s.linear)
    }
    far.end()
}

pub fn frame(s: mut Clearing, time: f32, width: u32, height: u32) {
    keys(mut s, time)
    let (w, h) = (max(width / s.scale, 1), max(height / s.scale, 1))
    if width != s.width || height != s.height || f32(w) != s.cam.screen.x {
        s.scene = texture::<Rgba16Float>(width: w, height: h)
        s.depth = depth_texture(width: w, height: h)
        s.ids = texture::<Rgba8>(width: w, height: h)
        s.motion = texture::<Rgba16Float>(width: w, height: h)
        s.means = writable_texture::<Rgba16Float>(width: w, height: h)
        s.spreads = writable_texture::<Rgba16Float>(width: w, height: h)
        s.dabs = texture::<Rgba16Float>(width: w, height: h)
        s.history_a = texture::<Rgba16Float>(width: width, height: height)
        s.history_b = texture::<Rgba16Float>(width: width, height: height)
        let (qw, qh) = (max(width / 4, 1), max(height / 4, 1))
        s.glow_a = texture::<Rgba16Float>(width: qw, height: qh)
        s.glow_b = texture::<Rgba16Float>(width: qw, height: qh)
        s.width = width
        s.height = height
        s.frames = 0
        s.forest.card_px = card_px(s.scale)
        s.forest.cell = 1.0 / f32(s.scale)
    }
    // The creature, between the two ticks round the frame's sim time, and its palette.
    s.snaps.update()
    let b = s.snaps.at(s.snaps.sim_time(time))
    let walker = between(b.a.walker, b.b.walker, b.alpha)
    let pose = palette(fawn().skeleton(), s.body, walker)
    copy_palette(mut s)
    write(mut s.palette, 0, pose.bones)
    // The camera on its path, following the creature eased.
    let ease = 1.0 - exp(-1.0 / 60.0 * 1.2)
    s.follow = mix(s.follow, walker.root.pos, vec3(ease))
    s.follow_heading = s.follow_heading +
        engine::present::lerp_angle(0.0, walker.root.heading - s.follow_heading, ease)
    let t = if s.path_from < 0.0 { 0.0 } else { time - s.path_from }
    let path = shot(t, s.follow, s.follow_heading)
    let (eye, look_at) = if s.held { (s.held_eye, s.held_at) } else { (path.eye, path.at) }
    s.cam = camera(
        eye,
        look_at,
        FOVY,
        width: w,
        height: h,
        frame: s.frames,
        time: time,
        last: s.cam,
        // A frame drawn with no history (a test's) isn't jittered: plain rendering.
        still: !on(s.off, testing::HISTORY),
    )
    let cam = s.cam
    let wind = Wind {
        dir: normalize(vec2(-0.55, 0.3)),
        strength: 0.035,
        time: if on(s.off, testing::WIND) { time } else { 0.0 },
    }
    s.clipmap.follow(Ground {}, eye, again: false)
    cook_again(mut s, eye)
    // The forest's kinds, a few a frame; the forest once they're all cooked.
    if !s.forest_done {
        for _ in 0..KINDS_PER_FRAME {
            let k = s.kinds.len()
            if k < KINDS {
                s.kinds.push(kind(kind_plant(k), seed: k + 1, atlas: s.atlas, s: s.linear))
            }
        }
        if s.kinds.len() == KINDS {
            let kinds = replace(mut s.kinds, Vec::new())
            s.forest = Forest::new(take kinds, placed(), cards_to: 150.0, impostors_to: 1000.0)
            s.forest.card_px = card_px(s.scale)
            s.forest.cell = 1.0 / f32(s.scale)
            s.forest_done = true
            s.static_drawn = false
        }
    }
    // The boulders, one a frame.
    if s.stones.len() < BOULDERS {
        s.stones.push(boulder(s.stones.len()))
        s.static_drawn = false
    }
    // The creature's mesh, a few slices a frame until it's whole; then its colours.
    if !s.creature_done {
        s.creature.step(fawn(), n: CREATURE_SLICES)
        if s.creature.done() {
            s.colours = colours(s.creature.mesh, fawn().field(), Fawn {}, cell: 1cm)
            s.creature_done = true
        }
    }
    let sh = shadows(
        s.light.sun,
        NEAR_CASCADE,
        FAR_CASCADE,
        moving_at: walker.root.pos + vec3(0.0, 1.0, 0.0),
        moving_span: 6.0,
        moving_side: 1024,
        frame: s.frames,
    )
    s.sh = sh
    // The static shadows, once the forest that casts them is cooked.
    if !s.static_drawn && s.forest_done && s.stones.len() == BOULDERS {
        static_shadows(mut s, sh, wind)
        s.static_drawn = true
    }
    label("shadow moving")
    let mv = begin_depth_pass(mut s.moving, clear_depth: 1.0)
    if on(s.off, testing::CREATURE) && s.creature_done {
        draw(
            character_shadow.bind(
                verts: s.creature.mesh.verts.items(),
                palettes: s.palette.span(start: 0, count: MAX_BONES),
                view: sh.moving,
            ),
            nothing,
            indices: s.creature.mesh.quads.items(),
            indirect: s.creature.mesh.draw.items(),
            depth_bias: DepthBias { constant: 2, slope: 1.5, clamp: 0.0 },
        )
    }
    mv.end()
    // The air's tables, cooked at load (and again when the sun moves), and the probes' open sky
    // from them: after the load's first frame, which is full (the forest's first kinds, the
    // terrain's clipmap).
    if s.frames == 0 && !s.ready {} else if !s.air_cooked {
        s.tables.cook(s.air, s.linear)
        s.probes.open(s.light, s.air.ground, s.tables.view, s.linear)
        s.air_cooked = true
    } else if !s.noise_cooked {
        // The clouds: their noises, then their maps (again after an edit), each cooked in a
        // frame of its own after the air's (each is tens of milliseconds of the GPU: together,
        // with the load's other work, a frame took 137 ms); then one of the dome's tiles in 64
        // marched each frame, the field drifted with the wind.
        s.sky.cook_noise()
        s.noise_cooked = true
    } else if !s.sky_cooked {
        s.sky.cook_weather(
            cloudscape(),
            FAIR,
            SUN_GAP,
            s.light.sun,
            s.repeat,
            shadows: on(s.off, testing::CLOUD_SHADOWS),
        )
        s.sky_cooked = true
        s.clouds_again = false
    }
    // A test left the clouds' shadows out, or put them back.
    if s.clouds_again && s.sky_cooked {
        s.sky.cook_shadow(s.light.sun, s.repeat, shadows: on(s.off, testing::CLOUD_SHADOWS))
        s.clouds_again = false
    }
    if s.sky_cooked {
        s.clouds = s.sky.march(
            s.air,
            s.light,
            s.tables,
            eye,
            drift: CLOUD_WIND * wind.time,
            rep: s.repeat,
            s: s.linear,
            still: !on(s.off, testing::WIND),
        )
    }
    let clouds = s.clouds
    // The probes: their occluders cooked once, then a strip of columns a frame; once every
    // column is baked, a strip baked again a frame, while the clouds drift (a test's frames,
    // still, keep the probes as they are). They read the static shadows, so they start once
    // those are drawn.
    let texels = s.clipmap.texels()
    if !s.static_drawn {} else if !s.occluders_cooked {
        s.probes.cook()
        s.occluders_cooked = true
    } else if !s.probes.done() || on(s.off, testing::WIND) {
        s.probes.bake_strip(
            trace_of(s),
            sh,
            s.clipmap.levels(),
            texels,
            s.near,
            s.far,
            s.cmp,
            s.tables.view,
            s.sky.dome,
            s.linear,
        )
    }
    // After an edit, the next probes bake beside these, and replace them when they're done.
    if s.rebaking {
        if !s.next_cooked {
            s.next_probes.cook()
            s.next_probes.open(s.light, s.air.ground, s.tables.view, s.linear)
            s.next_cooked = true
        } else if !s.next_probes.done() {
            let levels = s.clipmap.levels()
            s.next_probes.bake_strip(
                trace_of(s),
                sh,
                levels,
                texels,
                s.near,
                s.far,
                s.cmp,
                s.tables.view,
                s.sky.dome,
                s.linear,
            )
        } else {
            swap(mut s.probes, mut s.next_probes)
            s.rebaking = false
        }
    }
    if !s.ready && s.probes.done() && s.sky.done() && s.creature_done {
        s.ready = true
        print(f"clearing ready at frame {s.frames}")
    }
    // A build that took over from another (hot reload) shows nothing until it's cooked
    // everything: the screen keeps the old build's last frame meanwhile.
    if s.restored && !s.ready {
        keep_carried(s)
        return
    }
    // The camera's path starts once it's asked for and the clearing's ready.
    if s.asked && s.ready && s.path_from < 0.0 {
        s.path_from = time
        print(f"path begins at frame {s.frames}")
    }
    // Until the probes are baked, the open sky lights everything.
    var grid = s.probes.grid
    if !s.probes.done() {
        grid.cols = 0
    }
    borrow probes = s.probes.maps
    let grounds = s.probes.grounds.span(start: 0, count: s.probes.grid.probes())
    let lt = Lighting {
        cam,
        light: s.light,
        shadows: sh,
        grid,
        clouds,
        levels: s.clipmap.levels(),
        near: s.near,
        far: s.far,
        moving: s.moving,
        cmp: s.cmp,
        probes,
        grounds,
        cloud: s.sky.shadow,
        air: s.tables.aerial,
        s: s.linear,
    }
    s.grass.place(
        cam,
        s.light,
        grid,
        lt.levels,
        texels,
        probes,
        clouds,
        s.sky.shadow,
        s.linear,
        grounds,
        stones: footprints(),
    )
    s.forest.select(cam)

    // The depth prepass: the cut cards and flowers.
    label("vegetation prepass")
    let pre = begin_pass_with_depth(mut s.ids, mut s.depth, clear: vec4(0.0), clear_depth: 0.0)
    if on(s.off, TREES) {
        s.forest.prepass(cam, wind, s.linear)
    }
    if on(s.off, GRASS) {
        s.grass.prepass(cam, wind)
    }
    pre.end()
    if s.counting {
        // The cards' shading counted, pixel by pixel, where the prepass left the depth; and the
        // cards covering each pixel (for a test, `test_count`).
        s.shaded = buffer(w * h)
        s.covering = buffer(w * h)
        let shading = begin_pass(mut s.scene, clear: vec4(0.0))
        s.forest.count_shading(cam, wind, s.depth, w, mut s.shaded)
        shading.end()
        let covering = begin_pass_with_depth(mut s.scene, mut s.depth, keep: true, keep_depth: true)
        s.forest.count_covering(cam, wind, s.linear, w, mut s.covering)
        covering.end()
        s.counting = false
    }
    // The vegetation: the grass and stones, then the trees (`Forest::shade`), the flowers and
    // the cards where the prepass left them.
    label("vegetation")
    let veg = begin_pass_with_depth(mut s.scene, mut s.depth, clear: vec4(0.0), keep_depth: true)
    if on(s.off, GRASS) {
        s.grass.shade(lt, wind, GrassLook {}, Blooms {})
    }
    for st in s.stones {
        if !on(s.off, testing::STONES) {
            break
        }
        draw(
            stone_vertex.bind(
                verts: st.mesh.verts.items(),
                colours: st.colours.span(start: 0, count: st.colours.len()),
                at: st.at,
                seed: st.seed,
                cam: cam,
            ),
            stone_shade.bind(lt),
            indices: st.mesh.quads.items(),
            indirect: st.mesh.draw.items(),
            cull: Cull::Back,
            depth: NEAREST,
        )
    }
    if on(s.off, TREES) {
        s.forest.shade(lt, wind, s.ids)
    }
    veg.end()
    // The terrain, the creature and the sky: one render pass outside the serial timing (the
    // creature and the sky `join` it: light passes, whose targets needn't be stored and loaded
    // again between them; the vegetation's is heavy, and joined to it the frame took longer).
    label("terrain")
    let ter = begin_pass_with_depth(mut s.scene, mut s.depth, keep: true, keep_depth: true)
    if on(s.off, TERRAIN) {
        for l in 0..lt.levels.count {
            draw(
                ground.bind(cam, lt.levels, texels),
                ground_shade.bind(lt, texels),
                indices: s.clipmap.indices(),
                indirect: s.clipmap.draw_args(l),
                depth: NEAREST,
            )
        }
    }
    ter.end()
    label("creature")
    let cr = begin_pass_with_depth(
        mut s.scene,
        mut s.depth,
        keep: true,
        keep_depth: true,
        join: true,
    )
    if on(s.off, testing::CREATURE) && s.creature_done {
        draw(
            character.bind(
                verts: s.creature.mesh.verts.items(),
                colours: s.colours.span(start: 0, count: s.colours.len()),
                palettes: s.palette.span(start: 0, count: MAX_BONES),
                parts: parts_of(fawn().skeleton()),
                cam: cam,
            ),
            character_shade.bind(lt),
            indices: s.creature.mesh.quads.items(),
            indirect: s.creature.mesh.draw.items(),
            cull: Cull::Back,
            depth: NEAREST,
        )
    }
    cr.end()
    label("sky")
    let sky = begin_pass_with_depth(
        mut s.scene,
        mut s.depth,
        keep: true,
        keep_depth: true,
        join: true,
    )
    if on(s.off, testing::SKY) {
        draw(
            cover.bind(z: 0.0),
            sky_shade.bind(cam, s.light, view: s.tables.view, dome: s.sky.dome, s: s.linear),
            vertices: 3,
            depth: BEHIND,
        )
    } else {
        draw(cover.bind(z: 0.0), testing::key, vertices: 3, depth: BEHIND)
    }
    sky.end()
    // The creature's motion, where it's seen.
    label("motion")
    let mo = begin_pass_with_depth(mut s.motion, mut s.depth, clear: vec4(0.0), keep_depth: true)
    if on(s.off, testing::CREATURE) && s.creature_done {
        draw(
            character_motion.bind(
                verts: s.creature.mesh.verts.items(),
                palettes: s.palette.span(start: 0, count: MAX_BONES),
                last: s.last_palette.span(start: 0, count: MAX_BONES),
                cam: cam,
            ),
            motion.bind(cam),
            indices: s.creature.mesh.quads.items(),
            indirect: s.creature.mesh.draw.items(),
            cull: Cull::Back,
            depth: Depth { compare: Compare::GreaterEqual, write: false },
        )
    }
    mo.end()

    // Temporal AA, up to the output.
    let a = s.frames % 2
    // Where the creature can be on the output, now or last frame: a box round it, wider than
    // it, as the camera sees it each time (temporal AA checks its history for it there).
    let out = vec2(f32(width), f32(height))
    // (The creature's root is at its hips: its hooves are below it.)
    let creature = if on(s.off, testing::CREATURE) && s.creature_done {
        let at = walker.root.pos
        seen_box(cam, out, at - vec3(1.4, 1.6, 1.4), at + vec3(1.4, 1.4, 1.4), margin: 6.0)
    } else {
        vec4(0.0, 0.0, -1.0, -1.0)
    }
    let r = Resolve {
        cam,
        out,
        blend: 0.12,
        fresh: if s.frames == 0 || !on(s.off, testing::HISTORY) { 1 } else { 0 },
        creature,
    }
    label("temporal")
    if a == 0 {
        temporal(
            mut s.history_a,
            s.history_b,
            r,
            s.scene,
            s.depth,
            s.motion,
            mut s.means,
            mut s.spreads,
            s.linear,
        )
    } else {
        temporal(
            mut s.history_b,
            s.history_a,
            r,
            s.scene,
            s.depth,
            s.motion,
            mut s.means,
            mut s.spreads,
            s.linear,
        )
    }
    label("look")
    if s.view == testing::LOOK {
        let m = Metering { fresh: if s.frames == 0 { 1 } else { 0 }, ..METERING }
        dispatch(meter.bind(s.scene, m, exposure: mut s.exposure), groups: 1)
        let d = Develop { cam, light: s.light, look: Look {}, out: vec2(f32(width), f32(height)) }
        let dp = begin_pass(mut s.dabs)
        draw(
            cover.bind(z: 0.5),
            dab_map.bind(
                cam,
                look: d.look,
                out: d.out,
                levels: s.clipmap.levels(),
                texels: s.clipmap.texels(),
                scene: s.scene,
                depth: s.depth,
            ),
            vertices: 3,
        )
        dp.end()
        if a == 0 {
            let e = s.exposure.span(start: 0, count: 1)
            look(s.history_a, s.depth, s.dabs, s.linear, mut s.glow_a, mut s.glow_b, e, d)
        } else {
            let e = s.exposure.span(start: 0, count: 1)
            look(s.history_b, s.depth, s.dabs, s.linear, mut s.glow_a, mut s.glow_b, e, d)
        }
    } else {
        begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
        if s.view == testing::SCENE {
            draw(cover.bind(z: 0.5), testing::scene_view.bind(s.scene, s.scale), vertices: 3)
        } else if a == 0 {
            draw(cover.bind(z: 0.5), testing::temporal_view.bind(s.history_a, s.light), vertices: 3)
        } else {
            draw(cover.bind(z: 0.5), testing::temporal_view.bind(s.history_b, s.light), vertices: 3)
        }
        present()
    }
    s.frames += 1
    keep_carried(s)
}

// ---- for tests (testing.wrela; suite/clearing.rs) -------------------------------------------

/// How frames are shown (`testing::LOOK`, `SCENE` or `TEMPORAL`).
pub fn test_view(s: mut Clearing, view: u32) {
    s.view = view
}

/// The systems frames leave out (`TREES` to `TERRAIN`, and testing.wrela's).
pub fn test_off(s: mut Clearing, off: u32) {
    if (off ^ s.off) & SHADOWS != 0 {
        s.static_drawn = false
    }
    if (off ^ s.off) & testing::CLOUD_SHADOWS != 0 {
        s.clouds_again = true
    }
    s.off = off
}

/// The scene's size against the output's: 1 (native) or 2.
pub fn test_scale(s: mut Clearing, scale: u32) {
    s.scale = max(scale, 1)
}

/// The camera held at `eye`, looking at `at` (instead of on its path).
pub fn test_hold(s: mut Clearing, eye: vec3, at: vec3) {
    s.held = true
    s.held_eye = eye
    s.held_at = at
}

/// The sun from `toward` (normalized), its light scaled by `light` (0: the sky light alone):
/// the air's tables are cooked again and the static shadows drawn again.
pub fn test_sun(s: mut Clearing, toward: vec3, light: f32) {
    s.air = hazy(toward, SUN_TOP, eye: start_eye().y)
    let l = sunlight(s.air)
    s.light = Light { sun_colour: l.sun_colour * light, ..l }
    s.air_cooked = false
    s.static_drawn = false
}

/// The forest replaced by one instance of kind `kind` at `at` (on the ground there), drawn as
/// cards within `cards_to` and as an impostor within `impostors_to` (a volume beyond).
pub fn test_solo(s: mut Clearing, kind: u32, at: vec2, cards_to: f32, impostors_to: f32) {
    let y = scene::height(x: at.x, z: at.y)
    let one = engine::vegetation::Placed {
        kind,
        at: engine::plant::Instance {
            at: vec3(at.x, y, at.y),
            yaw: 0.0,
            tint: vec3(0.0),
            scale: 1.0,
        },
    }
    var placed: Vec<engine::vegetation::Placed> = Vec::new()
    placed.push(one)
    s.forest.place(take placed)
    s.forest.cards_to = cards_to
    s.forest.impostors_to = impostors_to
    s.static_drawn = false
}

/// How wide kind `k`'s cards look on screen at their finest level (the scene's pixels), for an
/// instance at (x, z) on the ground, from the last frame's camera (`lod::place`'s measure).
pub fn test_card_px(s: Clearing, k: u32, x: f32, z: f32) -> f32 {
    borrow kind = s.forest.kinds[k]
    let at = vec3(x, scene::height(x: x, z: z), z)
    let d = length(at + vec3(0.0, kind.top * 0.5, 0.0) - s.cam.eye)
    kind.plant.leaves.size / max(s.cam.footprint(max(d - kind.reach * 0.5, 0.5)), 1.0e-4)
}

/// Where the forest's levels hand over: its cards to impostors and impostors to volumes (m), and
/// how wide its cards grow on screen before the next level's take over.
pub fn test_lod(s: mut Clearing, cards_to: f32, impostors_to: f32, card_px: f32) {
    s.forest.cards_to = cards_to
    s.forest.impostors_to = impostors_to
    s.forest.card_px = card_px
}

/// The next frame counts its cards' shading and covering (`test_capture` reads them).
pub fn test_count(s: mut Clearing) {
    s.counting = true
}

/// What the last frame drew, copied into a new buffer (the newest), and how many elements:
/// 0, the scene (colour and tag, a vec4 a pixel); 1, its depth (an f32); 2, its motion (a
/// vec4); 3, temporal AA's output (a vec4, at the output's size); 4, the cards' shading count
/// and 5, the cards covering (a u32 each, from a `test_count` frame); 6, the clipmap's texels.
pub fn test_capture(s: mut Clearing, what: u32) -> u32 {
    let scene = s.cam.screen
    let n = u32(scene.x) * u32(scene.y)
    if what == 0 || what == 2 || what == 3 {
        let count = if what == 3 { s.width * s.height } else { n }
        s.captured = buffer(count)
        if what == 0 {
            dispatch(
                testing::copy_texture.bind(s.scene, out: mut s.captured),
                over: count,
            )
        } else if what == 2 {
            dispatch(
                testing::copy_texture.bind(s.motion, out: mut s.captured),
                over: count,
            )
        } else if (s.frames + 1) % 2 == 0 {
            dispatch(
                testing::copy_texture.bind(s.history_a, out: mut s.captured),
                over: count,
            )
        } else {
            dispatch(
                testing::copy_texture.bind(s.history_b, out: mut s.captured),
                over: count,
            )
        }
        return count
    }
    if what == 1 {
        s.captured_depth = buffer(n)
        dispatch(
            testing::copy_depth.bind(s.depth, out: mut s.captured_depth),
            over: n,
        )
        return n
    }
    if what == 4 || what == 5 {
        s.captured_counts = buffer(n)
        if what == 4 {
            std::gpu::copy(
                from: s.shaded.span(start: 0, count: n),
                to: s.captured_counts.span_mut(start: 0, count: n),
            )
        } else {
            std::gpu::copy(
                from: s.covering.span(start: 0, count: n),
                to: s.captured_counts.span_mut(start: 0, count: n),
            )
        }
        return n
    }
    let texels = s.clipmap.levels().count * engine::terrain::STRIDE
    s.captured_texels = buffer(texels)
    std::gpu::copy(
        from: s.clipmap.texels(),
        to: s.captured_texels.span_mut(start: 0, count: texels),
    )
    texels
}

/// The camera the last frame was drawn by.
pub struct CameraReport: Copy {
    pub eye: vec3,
    pub forward: vec3,
    pub right: vec3,
    pub up: vec3,
    pub tan_half: f32,
    pub aspect: f32,
    pub near: f32,
    pub jitter: vec2,
    pub screen: vec2,
    pub frame: u32,
}

pub fn test_camera(s: Clearing) -> CameraReport {
    let c = s.cam
    CameraReport {
        eye: c.eye,
        forward: c.forward,
        right: c.right,
        up: c.up,
        tan_half: c.tan_half,
        aspect: c.aspect,
        near: c.near,
        jitter: c.jitter,
        screen: c.screen,
        frame: c.frame,
    }
}

/// Clipmap level `l`: its texel (0, 0) at (x, y), z apart; and in w, how many levels.
pub fn test_level(s: Clearing, l: u32) -> vec4 {
    let levels = s.clipmap.levels()
    vec4(levels.at[l].xyz, f32(levels.count))
}

/// The terrain field's height at (x, z), and its slope there (rise over run).
pub fn test_height(x: f32, z: f32) -> vec2 {
    let e = 0.01
    let g = Ground {}
    let dx = (g.height(x + e, z) - g.height(x - e, z)) / (2.0 * e)
    let dz = (g.height(x, z + e) - g.height(x, z - e)) / (2.0 * e)
    vec2(g.height(x, z), length(vec2(dx, dz)))
}

/// The sim's raycast against the terrain field (the creature's feet's): the point it meets, and
/// 1 in w if it met the ground within 100 m.
pub fn test_raycast(from: vec3, dir: vec3) -> vec4 {
    let hit = engine::terrain::raycast(Ground {}, from, normalize(dir), reach: 100.0)
    vec4(hit.point, if hit.hit { 1.0 } else { 0.0 })
}

/// The wind's sway at `time`, at `at`, `height` up its plant (`engine::plant::sway`, as the
/// clearing's wind blows).
pub fn test_sway(time: f32, at: vec3, height: f32) -> vec3 {
    engine::plant::sway(
        Wind { dir: normalize(vec2(-0.55, 0.3)), strength: 0.035, time },
        at,
        height,
    )
}

/// The probes' brute-force reference at points `first` to `first + count` of the last frame's
/// screen (each `step`th pixel each way), each traced with `rays` rays: into a new buffer of
/// `Reference`s (the newest).
pub fn test_reference(s: mut Clearing, first: u32, count: u32, step: u32, rays: u32) {
    let at = Sampling { t: trace_of(s), sh: s.sh, cam: s.cam, clouds: s.clouds, step, first, rays }
    s.references = buffer(count)
    let grounds = s.probes.grounds.span(start: 0, count: s.probes.grid.probes())
    dispatch(
        reference.bind(
            at,
            s.depth,
            s.scene,
            volume: s.probes.volume.span(start: 0, count: s.probes.grid.voxels()),
            levels: s.clipmap.levels(),
            texels: s.clipmap.texels(),
            maps: s.probes.maps,
            s: s.linear,
            grounds: grounds,
            near: s.near,
            far: s.far,
            cmp: s.cmp,
            view: s.tables.view,
            dome: s.sky.dome,
            cloud: s.sky.shadow,
            out: mut s.references,
        ),
        groups: (count + 63) / 64,
    )
}

/// Whether everything cooked at load is done (1), and how far along its path the camera is (s;
/// negative before it starts).
pub fn test_ready(s: Clearing) -> vec2 {
    vec2(if s.ready { 1.0 } else { 0.0 }, if s.path_from < 0.0 { -1.0 } else {
        s.cam.time - s.path_from
    })
}

/// Every surface's sky light set to `sh` (spherical harmonics' first two bands: `Light`'s
/// `sky_sh`), or back to the probes' (`on` 0).
pub fn test_sky(s: mut Clearing, on: u32, sh: vec4) {
    s.light = Light { sky_test: on, sky_sh: sh, ..s.light }
}

/// `c` (linear light) as the tone curve shows it (in [0, 1]).
pub fn test_display(s: Clearing, c: vec3) -> vec3 {
    engine::light::display(s.light, c)
}

/// Kind `k`'s far levels' sizes: its impostor's box (its half-width), one texel of its
/// impostor's views and one voxel of its volume (m).
pub fn test_kind(s: Clearing, k: u32) -> vec3 {
    let b = s.forest.kinds[k].impostor.bake
    vec3(
        b.half,
        2.0 * b.half / f32(engine::impostor::CELL),
        2.0 * b.half / f32(engine::impostor::VOXELS),
    )
}

/// The instances drawn the last frame as cards, as impostors and as volumes.
pub fn test_trees(s: Clearing) -> vec3 {
    vec3(f32(s.forest.near_count), f32(s.forest.far_count), f32(s.forest.volume_count))
}
