// The Last Green's clearing (#28, #51), drawn by the engine's frame (`engine::frame`): the scene
// at half the output's resolution, jittered, into a linear-light target with depth and tags;
// temporal AA brings it up to the output; the look's passes draw it to the screen. What the
// clearing draws, casts and cooks is its stage (stage.wrela); this is its sim, its camera's path,
// what a hot reload carries, its keys and its tests' exports.

use creature::{SKELETON, WALKER_BODY, grown}
use engine::air::{Air, hazy}
use engine::frame::{Aim, Arrival, Change, Frame, Off, ProbeQuality, Quality, ShadowQuality, Shared}
use engine::gait::{between, palette}
use engine::light::{Light, SUN_TOP, sunlight}
use engine::paint::Metering
use engine::present::{Snapshots, lerp_angle}
use engine::probes::{Reference, Sampling, grid, reference}
use engine::run::run
use engine::shot::{Shots, place}
use engine::shadow::Cascade
use engine::terrain::{Clipmap, Terrain}
use engine::view::first_camera
use path::{Shot, shot}
use rocks::{boulders, footprints}
use scene::{FOVY, Ground, LOOK_AT, MEADOW, SUN, on_ground, start_eye}
use stage::{Stage, System, on, stage, wind}
use std::time::phase
use std::collections::Flags
use std::gpu::{GpuBuffer, Rgba16Float, Texture, buffer, buffer_of, dispatch}
use std::input::{Event, Key, events}
use std::io::print
use std::lift::{Watch, reads}
use std::reload::{keep, kept}
use std::serialize::{Serialize, load, save}
use testing::{Capture, View}
use trees::{standing, woods}
use world::{World, present as snapshot, spawn, tick}

/// How the camera meters (`paint::meter`): the start's view, settled (its metered luminance
/// 0.197: its geometric mean, 0.136, was what the look was picked at, and the band the meter
/// reads is 1.45 times it), at the exposure the look was picked at; other views half-way (in
/// stops) to the same.
const METERING = Metering {
    base: 0.62,
    reference: 0.197,
    strength: 0.5,
    lo: 0.15,
    hi: 0.75,
    rate: 0.05,
    flash: 1.25,
    fresh: 0,
}

/// The static cascades: the clearing's (about 7 cm a texel) and the valley's, each drawn whole
/// in a frame (the clearing's casters stand still), where they stand.
const NEAR_CASCADE = Cascade { centre: vec3(0.0, 4.0, 36.0), span: 144.0, reach: 250.0, side: 2048 }
const FAR_CASCADE = Cascade {
    centre: vec3(-60.0, -40.0, 330.0),
    span: 1040.0,
    reach: 1300.0,
    side: 2048,
}

/// How the clearing is drawn at `scale` (the scene's size against the output's): its cascades
/// stay where they stand and are drawn whole; its probes stay over the meadow and are baked
/// again a strip a frame as the clouds drift; its frames aren't covered (it has no arrival).
fn quality(scale: u32) -> Quality {
    Quality {
        scale: 1.0 / f32(scale),
        shadows: ShadowQuality {
            near: NEAR_CASCADE,
            near_strips: 1,
            near_moves: 1.0e9,
            far: FAR_CASCADE,
            far_strips: 1,
        },
        probes: ProbeQuality { moves: 1.0e9, rays: engine::probes::RAYS, again: true },
        arrival: Arrival { on: false },
    }
}

/// What a build carries across a hot reload (`std::reload`): where the camera's path is, and
/// how the clearing is shown. The rest is made again, as at load.
struct Carried: Copy + Serialize {
    /// When the camera's path began (the frame's time; negative before), whether it was asked
    /// for (it starts once the clearing's ready), and where the camera follows the creature
    /// from (smoothed), as of the frame at `follow_time`.
    path_from: f32,
    asked: bool,
    follow: vec3,
    follow_heading: f32,
    follow_time: f32,
    /// The systems left out of the frame, for timing each and for looking.
    off: Flags<System>,
    /// What the tests set (testing.wrela): how a frame is shown, the scene's scale against the
    /// output, and a camera held in place (instead of on its path).
    view: View,
    scale: u32,
    held: Option<Shot>,
    /// The develop's view of form (`Frame::form`: 0 the look, 1 clay, 2 silhouettes).
    form: u32,
}

/// What's cooked at load from the clearing's own literals, each watched by the literals its
/// code reads (`std::lift::reads`): an edit of one (hot reload) cooks it again.
struct Watches {
    light: Watch,
    forest: Watch,
    stones: Watch,
    clouds: Watch,
    ground: Watch,
    fawn_shape: Watch,
    fawn_coat: Watch,
}

impl Watches {
    fn new() -> Watches {
        Watches {
            light: Watch::new(reads(sun_light)),
            forest: Watch::new(reads(woods)),
            stones: Watch::new(reads(boulders)),
            clouds: Watch::new(reads(clouds::weather::weather)),
            ground: Watch::new(reads(ground_source)),
            fawn_shape: Watch::new(reads(fawn_shape)),
            fawn_coat: Watch::new(reads(fawn_coat)),
        }
    }
}

/// The air the sun shines through, from the start's eye.
fn air_of() -> Air {
    hazy(SUN, SUN_TOP, eye: start_eye().y)
}

/// The sun's light.
fn sun_light() -> Light {
    sunlight(air_of())
}

/// The ground's field, as the clipmap cooks it: on the GPU, whose code reads its own literals,
/// so this calls the field's height and cover on the CPU for `reads` to find theirs.
fn ground_source() -> f32 {
    let g = Ground {}
    g.height(x: 0.0, z: 0.0) + g.cover(at: vec3(0.0), n: vec3(0.0, 1.0, 0.0)).grass
}

/// The fawn's form: its field's distance, which `reads` follows to the literals that shape it.
fn fawn_shape() -> f32 {
    grown().field().distance(vec3(0.0, 0.8, 0.3))
}

/// The fawn's colours: its channels, which `reads` follows to the literals that colour it.
fn fawn_coat() -> f32 {
    let c = grown().field().channels(vec3(0.0, 0.8, 0.3))
    c.albedo.r + c.albedo.g + c.albedo.b
}

pub struct Clearing {
    /// The sim's snapshots.
    snaps: Snapshots<World>,
    frame: Frame<Shared>,
    /// The lookbook's shot the camera's held on (lookbook.wrela), if one is.
    shots: Shots,
    stage: Stage,
    /// What's carried across a hot reload, and what's cooked from literals.
    carried: Carried,
    watches: Watches,
    /// Whether this build took over from another (it shows nothing until it's cooked
    /// everything, so the screen keeps the old build's frame), and whether everything cooked at
    /// load is done.
    restored: bool,
    ready: bool,
    /// The last captures, which a test reads back (each the newest buffer).
    captured: GpuBuffer<vec4>,
    captured_floats: GpuBuffer<f32>,
    captured_counts: GpuBuffer<u32>,
    captured_texels: GpuBuffer<engine::terrain::Texel>,
    references: GpuBuffer<Reference>,
}

/// The keys: Space starts the camera's path; T, G, H and F4 leave out the trees, the grass, the
/// shadows and the terrain; L, a number and Enter hold the camera on a lookbook shot, and Escape
/// lets it go; F7 stills and V plain rendering (the frame's), and F8 the next view of form (clay,
/// silhouettes, the look).
fn keys(s: mut Clearing, time: f32) {
    for e in events() {
        if let Event::KeyDown { key, .. } = e {
            let chose = s.shots.key(key, lookbook::SHOTS.len(), time)
            if chose.chosen {
                s.frame.arrive()
            }
            if chose.taken || s.frame.key(key) {
                continue
            }
            if key == Key::Space {
                s.carried.asked = true
            }
            if key == Key::F8 {
                s.carried.form = (s.carried.form + 1) % 3
            }
            let system = match key {
                Key::T => Some(System::Trees),
                Key::G => Some(System::Grass),
                Key::H => Some(System::Shadows),
                Key::F4 => Some(System::Terrain),
                _ => None,
            }
            if let Some(system) = system {
                s.carried.off = s.carried.off.toggled(system)
            }
        }
    }
}

pub fn init() -> Clearing {
    let world = spawn()
    let w = world.walker
    let latest = run(take world, hz: 60, step: tick, present: snapshot)
    let eye = start_eye()
    let light = sun_light()
    let st = stage(w, light)
    print(f"forest: {trees::KINDS} kinds, {st.woods.placed.len()} instances")
    print(f"clouds: {clouds::weather::cloudscape().len()} cumulus")
    var f: Frame<Shared> = Frame::new(
        quality(stage::SCALE),
        light,
        air_of(),
        Clipmap::new(levels: 11, finest: 0.125),
        first_camera(eye, LOOK_AT, FOVY, width: 960, height: 540),
        grid(MEADOW, cols: 81, spacing: 2.0, low: -12.0, high: 40.0, voxel: 1.0),
        eye.xz,
    )
    f.metering = METERING
    var s = Clearing {
        snaps: Snapshots::new(take latest, hz: 60),
        frame: f,
        shots: Shots {},
        stage: st,
        carried: Carried {
            path_from: -1.0,
            asked: false,
            follow: w.root.pos,
            follow_heading: w.root.heading,
            follow_time: 0.0,
            off: Flags::none(),
            view: View::Look,
            scale: stage::SCALE,
            held: None,
            form: 0,
        },
        watches: Watches::new(),
        restored: false,
        ready: false,
        captured: buffer(1),
        captured_floats: buffer(1),
        captured_counts: buffer(1),
        captured_texels: buffer(1),
        references: buffer(1),
    }
    if let Ok(c) = load(kept()) {
        s.carried = c
        s.restored = true
    }
    s
}

/// What's cooked from a literal an edit changed (hot reload), cooked again: the light and the
/// air (the frame cooks their tables again, and the cascades and the probes they light), the
/// forest, the boulders, the clouds, the ground, and the fawn (its mesh, or only its colours).
fn cook_again(s: mut Clearing) {
    if s.watches.light.changed() {
        s.frame.light = sun_light()
        s.frame.air = air_of()
        s.stage.light = s.frame.light
    }
    if s.watches.forest.changed() {
        s.stage.remake_woods(s.frame.linear)
        s.frame.changed(Change::Casters)
        s.frame.changed(Change::Occluders)
    }
    if s.watches.stones.changed() {
        s.stage.stones = boulders()
        s.stage.footprints = buffer_of(footprints(), at_least: 1)
        s.frame.changed(Change::Casters)
        s.frame.changed(Change::Occluders)
    }
    if s.watches.clouds.changed() {
        s.frame.changed(Change::Weather)
    }
    if s.watches.ground.changed() {
        s.frame.changed(Change::Ground)
    }
    // The fawn: realized again if its shape changed; its materials cooked again, its mesh kept, if
    // only its colours did.
    let reshaped = s.watches.fawn_shape.changed()
    let recoloured = s.watches.fawn_coat.changed()
    if reshaped {
        s.stage.fawn.remake(grown())
    } else if recoloured {
        s.stage.fawn.recolour(grown())
    }
}

/// What the clearing carries across a hot reload, kept each frame.
fn keep_carried(s: Clearing) {
    keep(save(s.carried))
}

pub fn frame(s: mut Clearing, time: f32, width: u32, height: u32) {
    keys(mut s, time)
    let off = s.carried.off
    // The systems the frame itself leaves out, and the scale the scene is drawn at.
    s.frame.set(Off::Shadows, on: on(off, System::Shadows))
    s.frame.set(Off::Terrain, on: on(off, System::Terrain))
    s.frame.set(Off::History, on: on(off, System::History))
    s.frame.set(Off::CloudShadows, on: on(off, System::CloudShadows))
    s.frame.debug.still = !on(off, System::Wind)
    s.stage.off = off
    s.stage.view = s.carried.view
    s.frame.form(s.carried.form)
    if s.carried.scale != s.stage.scale {
        s.stage.scale = s.carried.scale
        s.frame.requality(quality(s.carried.scale))
    }
    // The creature, between the two ticks round the frame's sim time, and its palette.
    // The sim's part of the frame: its snapshots read (engine::frame `PHASES`).
    phase("sim")
    s.snaps.update()
    let b = s.snaps.at(s.snaps.sim_time(time))
    let walker = between(b.a.walker, b.b.walker, b.alpha)
    s.stage.walker = walker
    if on(off, System::Creature) {
        s.stage.fawn.pose(
            palette(SKELETON, WALKER_BODY, walker).bones,
            shadowed: true,
            moved: false,
        )
    } else {
        s.stage.fawn.hide()
    }
    // The camera on its path, following the creature eased at one rate whatever the frame
    // rate: a frame of `dt` seconds closes 1 - e^(-1.2 dt) of the gap (a frame after a stall at
    // most 0.1 s's). The time it last eased is carried, so a hot reload doesn't change it.
    let dt = clamp(time - s.carried.follow_time, 0.0, 0.1)
    let ease = 1.0 - exp(-1.2 * dt)
    s.carried.follow_time = time
    s.carried.follow = mix(s.carried.follow, walker.root.pos, vec3(ease))
    s.carried.follow_heading = lerp_angle(s.carried.follow_heading, walker.root.heading, ease)
    let t = if s.carried.path_from < 0.0 { 0.0 } else { time - s.carried.path_from }
    s.shots.clock(time, covered: s.frame.ready.arriving)
    let (eye, at, fovy) = match (s.carried.held, s.shots.held) {
        (Some(h), _) => (h.eye, h.at, FOVY),
        (None, Some(i)) => {
            let sh = lookbook::SHOTS[i]
            let (e, a) = place(sh, s.shots.since(time), |p: vec2| on_ground(p).y)
            (e, a, sh.fovy)
        },
        (None, None) => {
            let p = shot(t, s.carried.follow, s.carried.follow_heading)
            (p.eye, p.at, FOVY)
        },
    }
    let aim = Aim { eye, at, fovy, moving_at: walker.root.pos }
    cook_again(mut s)
    // A build that took over from another (hot reload) shows nothing until it's cooked
    // everything: the screen keeps the old build's last frame meanwhile.
    s.frame.hold = s.restored && !s.ready
    let _ = s.frame.begin(mut s.stage, aim, time, width, height)
    s.frame.draw(mut s.stage, aim)
    if !s.ready && s.frame.probes.done() && s.frame.sky.done() && s.stage.fawn.realized.is_some() {
        s.ready = true
        print(f"clearing ready at frame {s.frame.frames}")
    }
    // The camera's path starts once it's asked for and the clearing's ready.
    if s.carried.asked && s.ready && s.carried.path_from < 0.0 {
        s.carried.path_from = time
        print(f"path begins at frame {s.frame.frames}")
    }
    keep_carried(s)
}

// ---- for tests (testing.wrela; tests/checks) ------------------------------------------------

/// How frames are shown.
@testing
pub fn test_view(s: mut Clearing, view: View) {
    s.carried.view = view
}

/// The systems frames leave out, by their bits (`System`).
@testing
pub fn test_off(s: mut Clearing, off: u32) {
    s.carried.off = Flags::of_bits(off)
}

/// The scene's size against the output's: 1 (native) or 2.
@testing
pub fn test_scale(s: mut Clearing, scale: u32) {
    s.carried.scale = max(scale, 1)
}

/// The camera held at `eye`, looking at `at` (instead of on its path).
@testing
pub fn test_hold(s: mut Clearing, eye: vec3, at: vec3) {
    s.carried.held = Some(Shot { eye, at })
}

/// The sun from `toward` (normalized), its light scaled by `light` (0: the sky light alone):
/// the frame cooks the air's tables again and draws the static shadows again.
@testing
pub fn test_sun(s: mut Clearing, toward: vec3, light: f32) {
    s.frame.air = hazy(toward, SUN_TOP, eye: start_eye().y)
    let l = sunlight(s.frame.air)
    s.frame.light = Light { sun_colour: l.sun_colour * light, ..l }
    s.stage.light = s.frame.light
}

/// The forest replaced by one instance of kind `kind` at `at` (on the ground there), drawn as
/// cards within `cards_to` and as an impostor within `impostors_to` (a volume beyond).
@testing
pub fn test_solo(s: mut Clearing, kind: u32, at: vec2, cards_to: f32, impostors_to: f32) {
    var placed: Vec<engine::vegetation::Placed> = Vec::new()
    placed.push(standing(kind, at))
    match mut s.stage.wood {
        Some(w) => {
            w.drop(vec2i(0))
            let _ = w.load(vec2i(0), placed)
            w.cards_to = cards_to
            w.cards_limit = cards_to
            w.impostors_to = impostors_to
            w.write_lods()
        },
        None => {},
    }
    s.stage.woods.placed = take placed
    s.frame.changed(Change::Casters)
}

/// How wide kind `k`'s cards look on screen at their finest level (the scene's pixels), for an
/// instance at (x, z) on the ground, from the last frame's camera (`lod::place`'s measure).
@testing
pub fn test_card_px(s: Clearing, k: u32, x: f32, z: f32) -> f32 {
    match s.stage.wood {
        Some(w) => engine::lod::card_width(
            w.lod(k),
            s.frame.cam,
            on_ground(vec2(x, z)),
            scale: 1.0,
        ),
        None => 0.0,
    }
}

/// Where the forest's levels hand over: its cards to impostors and impostors to volumes (m), and
/// how wide its cards grow on screen before the next level's take over.
@testing
pub fn test_lod(s: mut Clearing, cards_to: f32, impostors_to: f32, card_px: f32) {
    match mut s.stage.wood {
        Some(w) => {
            w.cards_to = cards_to
            w.cards_limit = cards_to
            w.impostors_to = impostors_to
            w.card_px = card_px
            w.write_lods()
        },
        None => {},
    }
}

/// `t`'s first `count` texels, row by row, in a new buffer.
fn texels_of(t: Texture<Rgba16Float>, count: u32) -> GpuBuffer<vec4> {
    var out: GpuBuffer<vec4> = buffer(count)
    dispatch(testing::copy_texture.bind(t, out: mut out), over: count)
    out
}

/// What the last frame drew (`Capture`), copied into a new buffer (the newest), and how many
/// elements.
@testing
pub fn test_capture(s: mut Clearing, what: Capture) -> u32 {
    let scene = s.frame.cam.screen
    let n = u32(scene.x) * u32(scene.y)
    borrow t = s.frame.targets
    let out = t.history.width() * t.history.height()
    match what {
        Capture::Scene => {
            s.captured = texels_of(t.scene, n)
            n
        },
        Capture::Depth => {
            s.captured_floats = buffer(n)
            dispatch(testing::copy_depth.bind(t.depth, out: mut s.captured_floats), over: n)
            n
        },
        Capture::Motion => {
            s.captured = texels_of(t.motion, n)
            n
        },
        Capture::Output => {
            s.captured = texels_of(t.history, out)
            out
        },
        Capture::Texels => {
            let texels = s.frame.clipmap.levels().count * engine::terrain::STRIDE
            s.captured_texels = buffer(texels)
            std::gpu::copy(from: s.frame.clipmap.texels(), to: s.captured_texels.items_mut())
            texels
        },
        Capture::Tags => {
            s.captured_floats = buffer(out)
            dispatch(testing::copy_tags.bind(t.history, out: mut s.captured_floats), over: out)
            out
        },
    }
}

/// The camera the last frame was drawn by.
pub struct CameraReport: Copy {
    pub eye: vec3,
    pub forward: vec3,
    pub right: vec3,
    pub up: vec3,
    pub tan_half: f32,
    pub aspect: f32,
    pub near: f32,
    pub jitter: vec2,
    pub screen: vec2,
    pub frame: u32,
}

@testing
pub fn test_camera(s: Clearing) -> CameraReport {
    let c = s.frame.cam
    CameraReport {
        eye: c.eye,
        forward: c.forward,
        right: c.right,
        up: c.up,
        tan_half: c.tan_half,
        aspect: c.aspect,
        near: c.near,
        jitter: c.jitter,
        screen: c.screen,
        frame: c.frame,
    }
}

/// Clipmap level `l`: its texel (0, 0) at (x, y), z apart; and in w, how many levels.
@testing
pub fn test_level(s: Clearing, l: u32) -> vec4 {
    let levels = s.frame.clipmap.levels()
    vec4(levels.at[l].xyz, f32(levels.count))
}

/// The terrain field's height at (x, z), and its slope there (rise over run).
@testing
pub fn test_height(x: f32, z: f32) -> vec2 {
    let e = 0.01
    let g = Ground {}
    let dx = (g.height(x + e, z) - g.height(x - e, z)) / (2.0 * e)
    let dz = (g.height(x, z + e) - g.height(x, z - e)) / (2.0 * e)
    vec2(g.height(x, z), length(vec2(dx, dz)))
}

/// The sim's raycast against the terrain field (the creature's feet's): the point it meets, and
/// 1 in w if it met the ground within 100 m.
@testing
pub fn test_raycast(from: vec3, dir: vec3) -> vec4 {
    let hit = engine::terrain::raycast(Ground {}, from, normalize(dir), reach: 100.0)
    vec4(hit.point, if hit.hit { 1.0 } else { 0.0 })
}

/// The wind's sway at `time`, at `at`, `height` up its plant (`engine::plant::sway`, as the
/// clearing's wind blows).
@testing
pub fn test_sway(time: f32, at: vec3, height: f32) -> vec3 {
    engine::plant::sway(wind(time), at, height)
}

/// The probes' brute-force reference at points `first` to `first + count` of the last frame's
/// screen (each `step`th pixel each way), each traced with `rays` rays: into a new buffer of
/// `Reference`s (the newest).
@testing
pub fn test_reference(s: mut Clearing, first: u32, count: u32, step: u32, rays: u32) {
    let q = s.frame.quality().shadows
    let sh = engine::shadow::shadows(
        s.frame.light.sun,
        s.frame.near.cascade(),
        s.frame.far.cascade(),
        moving_at: s.stage.walker.root.pos + vec3(0.0, 1.0, 0.0),
        moving_span: q.moving_span,
        moving_side: q.moving_side,
    )
    let t = engine::frame::Scene::trace(s.stage, s.frame.light, s.frame.probes.using.grid)
    let at = Sampling { t, sh, cam: s.frame.cam, clouds: s.frame.clouds, step, first, rays }
    s.references = buffer(count)
    borrow f = s.frame
    borrow probes = f.probes.using
    let grounds = probes.grounds.span(start: 0, count: probes.grid.probes())
    dispatch(
        reference.bind(
            at,
            f.targets.depth,
            f.targets.scene,
            density: probes.density,
            levels: f.clipmap.levels(),
            texels: f.clipmap.texels(),
            maps: probes.maps,
            s: f.linear,
            grounds: grounds,
            near: f.near.front,
            far: f.far.front,
            cmp: f.cmp,
            view: f.tables.view,
            dome: f.sky.dome,
            cloud: f.sky.shadow,
            out: mut s.references,
        ),
        groups: (count + 63) / 64,
    )
}

/// The clipmap's layout (`engine::terrain`), which a capture of its texels has: a level's texels
/// a side, its quads a side, a row's texels in the buffer, and a level's.
@testing
pub fn test_clip_layout() -> vec4 {
    let t = (engine::terrain::SIDE, engine::terrain::QUADS, engine::terrain::ROW)
    vec4(f32(t.0), f32(t.1), f32(t.2), f32(engine::terrain::STRIDE))
}

/// How many of the last frame's blades (every tier's) are rooted well under a boulder
/// (`testing::under_boulders`), in a new buffer (the newest).
@testing
pub fn test_under_boulders(s: mut Clearing) {
    s.captured_counts = buffer(1)
    count_under_boulders(s.stage.grass.near, mut s.captured_counts)
    count_under_boulders(s.stage.grass.middle, mut s.captured_counts)
    count_under_boulders(s.stage.grass.far, mut s.captured_counts)
}

fn count_under_boulders(
    tier: std::gpu::AppendBuffer<engine::grass::Blade>,
    out: mut GpuBuffer<u32>,
) {
    dispatch(
        testing::under_boulders.bind(blades: tier.items(), count: tier.count(), out: mut out),
        over: tier.capacity(),
    )
}

/// Where on the output what moves can be, the last frame (`Resolve::moving`): its corners.
@testing
pub fn test_moving(s: Clearing) -> vec4 {
    let out = vec2(f32(s.frame.targets.history.width()), f32(s.frame.targets.history.height()))
    engine::frame::Scene::moves_in(s.stage, s.frame.cam, out)
}

/// Whether everything cooked at load is done (1), and how far along its path the camera is (s;
/// negative before it starts).
@testing
pub fn test_ready(s: Clearing) -> vec2 {
    vec2(if s.ready { 1.0 } else { 0.0 }, if s.carried.path_from < 0.0 { -1.0 } else {
        s.frame.cam.time - s.carried.path_from
    })
}

/// Every surface's sky light set to `sh` (spherical harmonics' first two bands: `Light`'s
/// `sky_sh`), or back to the probes' (`on` 0).
@testing
pub fn test_sky(s: mut Clearing, on: u32, sh: vec4) {
    s.frame.light = Light { sky_test: on, sky_sh: sh, ..s.frame.light }
    s.stage.light = s.frame.light
}

/// `c` (linear light) as the tone curve shows it (in [0, 1]).
@testing
pub fn test_display(s: Clearing, c: vec3) -> vec3 {
    engine::light::display(s.frame.light, c)
}

/// Kind `k`'s far levels' sizes: its impostor's box (its half-width), one texel of its
/// impostor's views and one voxel of its volume (m).
@testing
pub fn test_kind(s: Clearing, k: u32) -> vec3 {
    let Some(w) = s.stage.wood else { return vec3(0.0) }
    let b = w.kinds[k].impostor.bake
    vec3(
        b.half,
        2.0 * b.half / f32(engine::impostor::CELL),
        2.0 * b.half / f32(engine::impostor::VOXELS),
    )
}

/// Instance `i`'s middle, where its levels' patterns are anchored (`lod::anchor`), and its
/// trunk's foot (in w, its height above the ground).
@testing
pub fn test_middle(s: Clearing, i: u32) -> vec4 {
    let Some(w) = s.stage.wood else { return vec4(0.0) }
    let n = s.stage.woods.placed.len()
    let p = s.stage.woods.placed[i % n]
    let top = w.kinds[p.kind].top * p.at.scale
    vec4(p.at.at + vec3(0.0, top * 0.5, 0.0), top)
}

/// The instances the wood holds (each chosen on the GPU each frame as cards, an impostor or a
/// volume), in x.
@testing
pub fn test_trees(s: Clearing) -> vec3 {
    match s.stage.wood {
        Some(w) => vec3(f32(w.loaded()), 0.0, 0.0),
        None => vec3(0.0),
    }
}
