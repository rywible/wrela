// The ground: a mesh of rings round the eye, within the view's sector, its height the scene's
// field; shaded per pixel from the field's normal (the decided renderer's raster terrain; a
// clipmap would follow the eye the same way).

use camera::{Cam, GROUND}
use history::{CELL, FCELL, FN, FX0, FZ0, N, X0, Z0, in_domain, in_fine}
use scene::HISTORY
use light::{Lit, hazed, shade}
use noise::{fbm2, noise2}
use scene::{height, normal, track}
use shadow::{Sun, sunlit}
use std::gpu::{ClipPosition, ComparisonSampler, DepthTexture, VertexIndex}

/// The rings and segments, and the radii they span.
pub const RINGS: u32 = 560
pub const SEGS: u32 = 320
const NEAR_R: f32 = 0.3
const FAR_R: f32 = 12000.0
/// Half the sector's angle (radians).
const HALF: f32 = 0.95

pub struct Ground: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub normal: vec3,
}

/// The ground's vertex `v`: quad `v / 6`, two triangles.
@vertex
pub fn ground(v: VertexIndex, cam: Cam) -> Ground {
    let qx = [0, 1, 1, 0, 1, 0]
    let qz = [0, 0, 1, 0, 1, 1]
    let q = v.index / 6
    let c = v.index % 6
    let ring = q / SEGS + qz[c]
    let seg = q % SEGS + qx[c]
    let r = NEAR_R * pow(FAR_R / NEAR_R, f32(ring) / f32(RINGS))
    let a = cam.yaw + (f32(seg) / f32(SEGS) - 0.5) * 2.0 * HALF
    let x = cam.eye.x + r * sin(a)
    let z = cam.eye.z + r * cos(a)
    let world = vec3(x, height(x, z), z)
    // The normal at the vertex, over its own spacing; near the eye, each pixel finds its own.
    let e = max(0.05, r * 0.012)
    let n = normalize(vec3(world.y - height(x + e, z), e, world.y - height(x, z + e)))
    Ground { clip: ClipPosition { position: cam.clip(world) }, world, normal: n }
}

/// A grid of `vec4`s at `p`, bilinear: `n` by `n` cells `size` wide from (`x0`, `z0`).
fn grid4(g: [vec4], p: vec2, x0: f32, z0: f32, size: f32, n: u32) -> vec4 {
    let u = (p.x - x0) / size - 0.5
    let v = (p.y - z0) / size - 0.5
    let i = clamp(i32(floor(u)), 0, i32(n) - 2)
    let j = clamp(i32(floor(v)), 0, i32(n) - 2)
    let s = clamp(u - f32(i), 0.0, 1.0)
    let t = clamp(v - f32(j), 0.0, 1.0)
    let k = u32(j) * n + u32(i)
    mix(mix(g[k], g[k + 1], vec4(s)), mix(g[k + n], g[k + n + 1], vec4(s)), vec4(t))
}

/// The ground's albedo at `p`: meadow, worn track, forest floor, far slopes, rock and snow. With
/// the history (spike 16), the meadow, its trails and the forest floor are where the history
/// left them: `fine` holds wear, browsing, resting and wetness round the meadow, `wide` light,
/// wetness, litter and browsing over the domain.
pub fn albedo(p: vec3, n: vec3, fine: [vec4], wide: [vec4]) -> vec3 {
    let xz = p.xz
    let patches = fbm2(xz * 0.08, 3)
    var meadow = mix(vec3(0.10, 0.17, 0.035), vec3(0.20, 0.24, 0.05), vec3(patches))
    let dirt = mix(vec3(0.24, 0.17, 0.10), vec3(0.30, 0.23, 0.14), vec3(noise2(xz * 2.0)))
    var a = meadow
    if HISTORY && in_domain(xz) {
        let w = grid4(wide, xz, X0, Z0, CELL, N)
        let f = if in_fine(xz) { grid4(fine, xz, FX0, FZ0, FCELL, FN) } else {
            vec4(0.0, w.w, 0.0, w.y)
        }
        // Cropped short and paler where the herd grazes; a deeper green in the wet.
        meadow = mix(meadow, meadow * vec3(1.3, 1.18, 0.85), vec3(smoothstep(0.15, 0.5, f.y)))
        meadow = mix(meadow, vec3(0.05, 0.12, 0.035), vec3(smoothstep(0.5, 0.9, f.w) * 0.55))
        // The forest floor: last year's leaves, greening with moss where it's wet.
        let leaves = mix(vec3(0.13, 0.085, 0.045), vec3(0.21, 0.13, 0.06), vec3(noise2(xz * 1.7)))
        let floor = mix(leaves, vec3(0.06, 0.10, 0.03), vec3(smoothstep(0.55, 0.9, w.y) * 0.55))
        a = mix(meadow, floor, vec3(w.z))
        // The trails, worn to earth, and the resting place, trampled bare.
        let worn = smoothstep(0.12, 0.32, f.x + 0.1 * (noise2(xz * 3.0) - 0.5))
        a = mix(a, dirt, vec3(worn))
        a = mix(a, dirt * vec3(1.08, 1.04, 1.0), vec3(smoothstep(0.15, 0.6, f.z) * 0.55))
    } else {
        let worn = if length(xz - vec2(0.0, 20.0)) < 45.0 { track(xz) } else { 0.0 }
        a = mix(meadow, dirt, vec3(worn))
    }
    // The far land: woods and open meadows in patches, fields' lighter greens between.
    let far = smoothstep(80.0, 260.0, length(xz - vec2(0.0, 30.0)))
    let patches = fbm2(xz * 0.0035 + vec2(4.0, 2.0), 5)
    let woods = vec3(0.03, 0.065, 0.03)
    let open = mix(vec3(0.10, 0.15, 0.045), vec3(0.17, 0.18, 0.07), vec3(fbm2(xz * 0.012, 3)))
    let land = mix(open, woods, vec3(smoothstep(0.45, 0.55, patches)))
    a = mix(a, land, vec3(far))
    // Rock on the mountain's steep slopes, snow high on it.
    let steep = smoothstep(0.7, 0.5, n.y) * smoothstep(500.0, 800.0, p.y)
    a = mix(a, vec3(0.22, 0.21, 0.21), vec3(steep))
    let snow = smoothstep(820.0, 900.0, p.y + 60.0 * noise2(xz * 0.01)) * smoothstep(0.5, 0.7, n.y)
    mix(a, vec3(0.85, 0.88, 0.92), vec3(snow))
}

@fragment
pub fn ground_shade(
    g: Ground,
    cam: Cam,
    sun: Sun,
    near: DepthTexture,
    far: DepthTexture,
    ss: ComparisonSampler,
    fine: [vec4],
    wide: [vec4],
) -> vec4 {
    let d = length(g.world - cam.eye)
    let n = if d < 50.0 { normal(g.world.x, g.world.z, max(0.02, d * 0.002)) } else {
        normalize(g.normal)
    }
    let a = albedo(g.world, n, fine, wide)
    let lit = sunlit(sun, g.world, n, near, far, ss, 2.0)
    let s = Lit { albedo: a, n, sun: lit, sky: 1.0, through: vec3(0.0) }
    vec4(hazed(shade(s, g.world, cam), g.world, cam.eye, cam.sun), GROUND)
}
