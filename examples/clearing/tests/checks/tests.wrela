// The tool tests. The source and WGSL checks build the clearing (a test build) and read its
// manifest's pipelines (their names, entry points, depth states and WGSL), and ask the compiler
// for its call graph through `wrela query`'s `callees`: walked from the functions they check a
// level at a time, each level's queries in one check of the package. The others drive the
// clearing on the CPU at 320 × 180, its frames in lockstep with its ticker, so two runs draw the
// same; the static shadows' test counts the draws its recorded commands make.

use std::collections::{Box, Vec}
use std::input::Script
use std::job::Step
use std::json::{Doc, TOP, parse}
use std::string::String
use std::tool::answer
use std::tool::drive
use std::tool::drive::{Recorded, Scalar}
use std::tool::files
use std::tool::toolchain

/// The output's size.
const W: u32 = 320
const H: u32 = 180

/// The hashes the fields' noise is built from (std::field's `hash_u32`, engine::noise's lattice
/// hashes), as WGSL writes them: a field evaluated in a shader brings them in.
const FIELD_HASHES: [Text; 6] = [
    "747796405u",
    "2891336453u",
    "277803737u",
    "1597334677u",
    "3812015801u",
    "2798796415u",
]

/// The entry points (vertex, fragment) of the pipelines that draw the stones, the creature and
/// the plants each frame.
const DRAWN: [(Text, Text); 8] = [
    ("stone_vertex", "stone_shade"),
    ("character", "character_shade"),
    ("card", "leaf_shade"),
    ("limb", "bark_shade"),
    ("far_quad", "far_shade"),
    ("far_quad", "volume_shade"),
    ("blade", "blade_shade"),
    ("flower", "flower_shade"),
]

/// The grass's placing, whose callees the flowers' test asks for.
const PLACE: Text = "engine::grass::place"

/// An entry point's path in the engine.
fn ps_path(entry: str) -> String {
    let module = match entry {
        "stone_vertex" | "stone_shade" => "stone",
        "character" | "character_shade" => "character",
        "card" | "leaf_shade" | "limb" | "bark_shade" => "vegetation",
        "far_quad" | "far_shade" | "volume_shade" => "impostor",
        "blade" | "blade_shade" | "flower" | "flower_shade" => "grass",
        "sky_shade" => "sky",
        _ => panic(f"where is {entry}?"),
    }
    String::from(f"engine::{module}::{entry}")
}

/// Whether `text` holds `part`.
fn has(text: str, part: str) -> bool {
    text.find(part).is_some()
}

/// A pipeline of the clearing's build: its name, its entry points (a kernel's entry and no
/// fragment), its depth state (a render pipeline's; none is no test and no writes), and its
/// WGSL.
struct Pipeline: Clone {
    name: String,
    vertex: String,
    fragment: String,
    depth_write: bool,
    depth_compare: String,
    wgsl: String,
}

/// The text of the file at `path`.
@job
fn text_of(path: take String) -> String {
    var r = files::read(path.as_str())
    var got = r.poll()
    while got.is_none() {
        yield
        got = r.poll()
    }
    let Some(rp) = take got else { panic("no answer") }
    let Ok(bytes) = answer(take rp) else { panic(f"{path.as_str()} reads") }
    let Some(text) = String::from_utf8(take bytes) else { panic(f"{path.as_str()} isn't UTF-8") }
    text
}

/// The clearing, built as a test build into `scratch/clearing`.
@job
fn built() -> bool {
    var options = toolchain::options()
    options.testing = true
    var b = toolchain::build("repo/examples/clearing", "scratch/clearing", options)
    var got = b.poll()
    while got.is_none() {
        yield
        got = b.poll()
    }
    let Some(bp) = take got else { panic("no answer") }
    let Ok(build) = toolchain::read_built(take bp) else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the clearing builds")
    true
}

/// The text of `key` of object `n`, or empty.
fn text_at(d: Doc, n: u32, key: str) -> String {
    match d.get(n, key) {
        Some(v) => match d.text(v) {
            Some(t) => t,
            None => String::new(),
        },
        None => String::new(),
    }
}

/// The clearing's pipelines, from its build's manifest and WGSL.
@job
fn pipelines() -> Vec<Pipeline> {
    var b = Box::new(built.start())
    loop {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var m = Box::new(text_of.start(String::from("scratch/clearing/manifest.json")))
    var manifest = String::new()
    loop {
        match m.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(t) => {
                manifest = take t
                break
            },
        }
    }
    let Some(d) = parse(manifest.as_str()) else { panic("the manifest is JSON") }
    let Some(list) = d.get(TOP, "pipelines") else { panic("the manifest's pipelines") }
    var out: Vec<Pipeline> = Vec::new()
    for k in 0..d.count(list) {
        let Some(p) = d.at(list, k) else { continue }
        let render = text_at(d, p, "kind").as_str() == "render"
        let vertex = if render { text_at(d, p, "vertex_entry") } else { text_at(d, p, "entry") }
        let fragment = if render { text_at(d, p, "fragment_entry") } else { String::new() }
        var depth_write = false
        var depth_compare = String::new()
        if let Some(depth) = d.get(p, "depth") {
            if let Some(w) = d.get(depth, "write") {
                depth_write = d.is_true(w)
            }
            depth_compare = text_at(d, depth, "compare")
        }
        let shader = text_at(d, p, "shader")
        var w = Box::new(text_of.start(String::from(f"scratch/clearing/{shader.as_str()}")))
        var wgsl = String::new()
        loop {
            match w.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(t) => {
                    wgsl = take t
                    break
                },
            }
        }
        out.push(
            Pipeline {
                name: text_at(d, p, "name"),
                vertex,
                fragment,
                depth_write,
                depth_compare,
                wgsl,
            },
        )
    }
    out
}

/// The text of WGSL function `name` (its signature to its closing brace).
fn wgsl_function(wgsl: str, name: str) -> String {
    let Some(start) = wgsl.find(f"\nfn {name}(".as_str()) else {
        panic(f"no `fn {name}` in the WGSL")
    }
    let rest = wgsl.slice(start + 1, wgsl.len())
    let end = match rest.find("\n}\n") {
        Some(e) => start + 1 + e + 3,
        None => wgsl.len(),
    }
    String::from(wgsl.slice(start, end))
}

/// The answers to `queries` on the clearing, in one run: one check of the package.
@job
fn queried(queries: take Vec<String>) -> Doc {
    var q = toolchain::query("repo/examples/clearing", queries, [])
    var got = q.poll()
    while got.is_none() {
        yield
        got = q.poll()
    }
    let Some(qp) = take got else { panic("no answer") }
    let Ok(json) = toolchain::read_queried(take qp) else { panic("the queries' request") }
    let Some(d) = parse(json.as_str()) else { panic("the queries' answer is JSON") }
    d
}

/// The names a list `key` of answer `i` gives in each item's `field`.
fn names(d: Doc, i: u32, key: str, field: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    let Some(a) = d.at(TOP, i) else { panic(f"no answer {i}") }
    let Some(list) = d.get(a, key) else { return out }
    for k in 0..d.count(list) {
        let Some(item) = d.at(list, k) else { continue }
        out.push(text_at(d, item, field))
    }
    out
}

/// Whether `names` holds `name`.
fn holds(names: [String], name: str) -> bool {
    for n in names {
        if n.as_str() == name {
            return true
        }
    }
    false
}

/// What each function calls directly, as the call graph's walk found it.
struct Callees: Clone {
    of: Vec<String>,
    calls: Vec<Vec<String>>,
}

impl Callees {
    fn direct(self, f: str) -> Vec<String> {
        for k in 0..self.of.len() {
            if self.of[k].as_str() == f {
                return self.calls[k].clone()
            }
        }
        panic(f"{f} wasn't walked")
    }

    fn known(self, f: str) -> bool {
        holds(self.of, f)
    }

    /// Every function `f` calls, through any depth.
    fn closure(self, f: str) -> Vec<String> {
        var reached: Vec<String> = Vec::new()
        var todo: Vec<String> = Vec::new()
        todo.push(String::from(f))
        while todo.len() > 0 {
            let Some(next) = todo.pop() else { break }
            let direct = self.direct(next.as_str())
            for c in direct {
                if !holds(reached, c.as_str()) {
                    reached.push(c.clone())
                    todo.push(c.clone())
                }
            }
        }
        reached
    }
}

/// The call graph from `roots` (and the grass's placing, with the first level), walked a level
/// at a time, each level's `callees` queries in one run.
@job
fn walked(roots: take Vec<String>) -> Callees {
    var known = Callees { of: Vec::new(), calls: Vec::new() }
    var level = roots.clone()
    var seen: Vec<String> = Vec::new()
    var also = true
    while level.len() > 0 {
        var asked: Vec<String> = Vec::new()
        for f in level {
            if !known.known(f.as_str()) && !holds(asked, f.as_str()) {
                asked.push(f.clone())
            }
        }
        if also {
            asked.push(String::from(PLACE))
            also = false
        }
        if asked.len() > 0 {
            var texts: Vec<String> = Vec::new()
            for f in asked {
                texts.push(String::from(f"callees {f.as_str()}"))
            }
            var q = Box::new(queried.start(take texts))
            var d: Option<Doc> = None
            while d.is_none() {
                match q.get_mut().resume() {
                    Step::Yielded => yield,
                    Step::Done(x) => d = Some(take x),
                }
            }
            let Some(answers) = take d else { panic("the answers") }
            for k in 0..asked.len() {
                known.of.push(asked[k].clone())
                known.calls.push(names(answers, k, "callees", "callee"))
            }
        }
        for f in level {
            if !holds(seen, f.as_str()) {
                seen.push(f.clone())
            }
        }
        var next: Vec<String> = Vec::new()
        for f in level {
            for c in known.direct(f.as_str()) {
                if !holds(seen, c.as_str()) && !holds(next, c.as_str()) {
                    next.push(c.clone())
                }
            }
        }
        level = take next
    }
    known
}

/// The functions whose callees the tests check through any depth: the terrain's vertex shader,
/// and the entry points of the pipelines that draw each frame.
fn roots() -> Vec<String> {
    var out: Vec<String> = Vec::new()
    out.push(String::from("engine::terrain::ground"))
    for k in 0..DRAWN.len() {
        let (v, f) = DRAWN[k]
        for e in [v, f] {
            let p = ps_path(e)
            if !holds(out, p.as_str()) {
                out.push(take p)
            }
        }
    }
    out
}

/// The call graph the source checks read.
@job
fn calls() -> Callees {
    var w = Box::new(walked.start(roots()))
    loop {
        match w.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(c) => return c,
        }
    }
}

/// AC3: the terrain's vertex shader reads the clipmap and never evaluates the terrain field:
/// nothing it calls is the field's (`Terrain::height`, the scene's height, its noise), and its
/// WGSL holds none of the noise's hashes.
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn the_terrain_vertex_shader_reads_the_clipmap_not_the_field() {
    var c = Box::new(calls.start())
    var graph: Option<Callees> = None
    while graph.is_none() {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => graph = Some(take x),
        }
    }
    let Some(g) = take graph else { panic("the call graph") }
    let reached = g.closure("engine::terrain::ground")
    assert(holds(reached, "engine::terrain::level_height"), "it reads the clipmap")
    for f in reached {
        let name = f.as_str()
        assert(
            !has(name, "height(") &&
                !name.starts_with("scene::") &&
                !name.starts_with("engine::noise"),
            f"the terrain's vertex shader calls {name}",
        )
        assert(!has(name, "Terrain::") && !has(name, "Ground::"), f"it calls {name}")
    }
    var p = Box::new(pipelines.start())
    var ps: Vec<Pipeline> = Vec::new()
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                ps = take x
                break
            },
        }
    }
    var ground: Option<Pipeline> = None
    var cook: Option<Pipeline> = None
    for k in 0..ps.len() {
        if ground.is_none() && ps[k].vertex.as_str() == "ground" {
            ground = Some(ps[k].clone())
        }
        if cook.is_none() && ps[k].name.as_str() == "cook_level" {
            cook = Some(ps[k].clone())
        }
    }
    let Some(gp) = ground else { panic("the terrain's pipeline") }
    let body = wgsl_function(gp.wgsl.as_str(), "ground")
    for h in FIELD_HASHES {
        assert(
            !has(body.as_str(), h),
            f"{gp.name.as_str()}: the vertex shader holds the noise's {h}",
        )
    }
    // The cooking kernel does evaluate it, so the check would see it.
    let Some(cp) = cook else { panic("the clipmap's cooking") }
    var any = false
    for h in FIELD_HASHES {
        any = any || has(cp.wgsl.as_str(), h)
    }
    assert(any, "the cook holds no hash")
}

/// AC4 (stones), AC5 (the creature and the plants): drawn from meshes and cards whose normals
/// and colours were cooked, so no pipeline that draws them each frame evaluates a field: none
/// calls a field's distance or its colour (the stones' facets and stain, the crowns' clumps and
/// limbs, the creature's parts), and the stones' and the creature's WGSL hold none of the
/// noise's hashes (the plants' shaders hash a card's seed for its tint, so theirs is checked by
/// what they call).
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn no_field_is_evaluated_per_vertex_or_per_pixel() {
    var p = Box::new(pipelines.start())
    var ps: Vec<Pipeline> = Vec::new()
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                ps = take x
                break
            },
        }
    }
    var c = Box::new(calls.start())
    var graph: Option<Callees> = None
    while graph.is_none() {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => graph = Some(take x),
        }
    }
    let Some(g) = take graph else { panic("the call graph") }
    for k in 0..DRAWN.len() {
        let (v, f) = DRAWN[k]
        var found: Option<Pipeline> = None
        for j in 0..ps.len() {
            if found.is_none() && ps[j].vertex.as_str() == v && ps[j].fragment.as_str() == f {
                found = Some(ps[j].clone())
            }
        }
        let Some(pl) = found else { panic(f"no pipeline {v}+{f}") }
        if v == "stone_vertex" || v == "character" {
            for h in FIELD_HASHES {
                assert(
                    !has(pl.wgsl.as_str(), h),
                    f"{pl.name.as_str()}: its WGSL holds the noise's {h}",
                )
            }
        }
        for entry in [v, f] {
            for c in g.closure(ps_path(entry).as_str()) {
                let n = c.as_str()
                let field = n.starts_with("std::field::") && !n.ends_with("hash_u32") ||
                    has(n, "::crown") ||
                    has(n, "::wood") ||
                    has(n, "::part_") ||
                    n.ends_with("::distance") ||
                    has(n, "Stain::at") ||
                    has(n, "Ground::") ||
                    has(n, "Terrain::")
                assert(!field, f"{entry} ({pl.name.as_str()}) calls {n}")
            }
        }
    }
}

/// AC5: a crown's three levels light their leaves alike, so they match where they meet (as
/// `a_crown_matches_where_its_levels_meet` measures): the cards', the impostors' and the
/// volumes' shading each light them by one function, `impostor::leaf_light`, with its gloss as
/// rough as a leaf's size on the screen makes it (`impostor::leaf_rough`). No level gains or
/// loses the gloss alone.
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn a_crowns_levels_light_their_leaves_by_one_light_with_gloss() {
    var c = Box::new(calls.start())
    var graph: Option<Callees> = None
    while graph.is_none() {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => graph = Some(take x),
        }
    }
    let Some(g) = take graph else { panic("the call graph") }
    for f in ["leaf_shade", "far_shade", "volume_shade"] {
        let reached = g.closure(ps_path(f).as_str())
        for want in [
            "engine::impostor::leaf_light",
            "engine::impostor::leaf_rough",
            "engine::light::gloss",
        ] {
            assert(holds(reached, want), f"{f} doesn't call {want}")
        }
    }
}

/// AC6: the sky's pass reads the clouds' dome and marches nothing (its WGSL, with the functions
/// it calls, has no loop), where the dome's kernel marches.
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn the_sky_pass_reads_the_cooked_clouds_and_marches_nothing() {
    var p = Box::new(pipelines.start())
    var ps: Vec<Pipeline> = Vec::new()
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                ps = take x
                break
            },
        }
    }
    var sky: Option<Pipeline> = None
    var march: Option<Pipeline> = None
    for k in 0..ps.len() {
        if sky.is_none() && ps[k].fragment.as_str() == "sky_shade" {
            sky = Some(ps[k].clone())
        }
        // A kernel's entry is its pipeline's first.
        if march.is_none() && ps[k].vertex.as_str() == "march_dome" {
            march = Some(ps[k].clone())
        }
    }
    let Some(s) = sky else { panic("the sky's pipeline") }
    assert(!has(s.wgsl.as_str(), "loop"), "the sky's pass loops")
    assert(has(s.wgsl.as_str(), "textureSampleLevel"), "the sky's pass reads no texture")
    let Some(m) = march else { panic("the dome's march") }
    assert(has(m.wgsl.as_str(), "loop"), "the dome's kernel doesn't march")
}

/// AC4: flowers are cut cards in the depth prepass (cut by `discard`, writing depth), shaded
/// where it left the depth (equal, no writes), and placed with the grass (the grass's placing
/// kernel appends them).
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn flowers_are_cut_cards_in_the_prepass_placed_with_the_grass() {
    var p = Box::new(pipelines.start())
    var ps: Vec<Pipeline> = Vec::new()
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                ps = take x
                break
            },
        }
    }
    var cut: Option<Pipeline> = None
    var shade: Option<Pipeline> = None
    for k in 0..ps.len() {
        if cut.is_none() && ps[k].fragment.as_str() == "flower_cut" {
            cut = Some(ps[k].clone())
        }
        if shade.is_none() && ps[k].fragment.as_str() == "flower_shade" {
            shade = Some(ps[k].clone())
        }
    }
    let Some(c) = cut else { panic("no pipeline shades with flower_cut") }
    let Some(s) = shade else { panic("no pipeline shades with flower_shade") }
    assert(has(c.wgsl.as_str(), "discard"), "the flowers' cut doesn't discard")
    assert(!has(s.wgsl.as_str(), "discard"), "the flowers' shading discards")
    assert(c.depth_write, "the cut writes no depth")
    assert(
        !s.depth_write && s.depth_compare.as_str() == "equal",
        f"the shading isn't at equal depth without writes: {s.depth_compare.as_str()}, write {s.depth_write}",
    )
    var g = Box::new(text_of.start(String::from("repo/engine/grass.wrela")))
    var grass = String::new()
    loop {
        match g.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(t) => {
                grass = take t
                break
            },
        }
    }
    assert(has(grass.as_str(), "flowers.push("), "the grass's placing appends no flowers")
    var w = Box::new(calls.start())
    var graph: Option<Callees> = None
    while graph.is_none() {
        match w.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => graph = Some(take x),
        }
    }
    let Some(gr) = take graph else { panic("the call graph") }
    assert(gr.direct(PLACE).len() > 0, "the grass's placing calls nothing")
}

/// The clearing, built, loaded on the CPU (recording its commands if `record`), `init` run.
@job
fn driven(record: take bool) -> drive::Build {
    var b = Box::new(built.start())
    loop {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var load = drive::cpu()
    load.width = W
    load.height = H
    load.record = record
    var l = drive::load("scratch/clearing", load)
    var loaded = l.poll()
    while loaded.is_none() {
        yield
        loaded = l.poll()
    }
    let Some(lp) = take loaded else { panic("no answer") }
    let Ok(it) = drive::read_loaded(take lp) else { panic("the clearing loads") }
    var i = drive::init(it.build)
    var inited = i.poll()
    while inited.is_none() {
        yield
        inited = i.poll()
    }
    let Some(ip) = take inited else { panic("no answer") }
    let Ok(init) = drive::read_ran(take ip) else { panic("init's request") }
    if let Some(trap) = init.trap {
        panic(trap.message.as_str())
    }
    it.build
}

/// A scalar as a number.
fn number(s: Scalar) -> f64 {
    match s {
        Scalar::F32(x) => f64(x),
        Scalar::I32(x) => f64(x),
        Scalar::F64(x) => x,
        Scalar::I64(x) => f64(x),
    }
}

/// The export `name` called with `args`: its results, as numbers.
@job
fn called(h: take drive::Build, name: take String, args: take Vec<Scalar>) -> Vec<f64> {
    var c = drive::call(h, name.as_str(), args)
    var got = c.poll()
    while got.is_none() {
        yield
        got = c.poll()
    }
    let Some(cp) = take got else { panic("no answer") }
    let Ok(ran) = drive::read_ran(take cp) else { panic(f"{name.as_str()}'s request") }
    if let Some(trap) = ran.trap {
        panic(f"{name.as_str()}: {trap.message.as_str()}")
    }
    var out: Vec<f64> = Vec::new()
    for k in 0..ran.results.len() {
        out.push(number(ran.results[k]))
    }
    out
}

/// The next `n` frames, in lockstep, which must not trap.
@job
fn steps(h: take drive::Build, n: take u32) {
    var f = drive::frames(h, n, Script::frames())
    var got = f.poll()
    while got.is_none() {
        yield
        got = f.poll()
    }
    let Some(fp) = take got else { panic("no answer") }
    let Ok(ran) = drive::read_ran(take fp) else { panic("the frames' request") }
    if let Some(trap) = ran.trap {
        panic(f"frame {trap.number}: {trap.message.as_str()}")
    }
}

/// Every command recorded since the last time, however many answers they take.
@job
fn recorded(h: take drive::Build) -> Vec<Recorded> {
    var out: Vec<Recorded> = Vec::new()
    loop {
        var c = drive::commands(h)
        var got = c.poll()
        while got.is_none() {
            yield
            got = c.poll()
        }
        let Some(cp) = take got else { panic("no answer") }
        let Ok(r) = drive::read_commands(take cp) else { panic("the commands") }
        for k in 0..r.commands.len() {
            out.push(r.commands[k].clone())
        }
        if r.waiting == 0 {
            return out
        }
    }
}

/// How many draws each batch of `commands` makes after the label `name` (to the next label).
fn draws_after(commands: [Recorded], name: str) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    var inside = false
    for c in commands {
        let kind = c.kind.as_str()
        if kind == "Batch" {
            out.push(0)
            inside = false
        } else if kind == "Label" {
            inside = c.label.as_str() == name
        } else if inside &&
            (kind == "Draw" || kind == "DrawIndirect" || kind == "DrawIndexedIndirect") {
            let last = out.len() - 1
            out[last] += 1
        }
    }
    out
}

/// The sum of `xs`.
fn sum(xs: [u32]) -> u32 {
    var s = 0
    for x in xs {
        s += x
    }
    s
}

/// The draws into the static cascades in each batch since the last time.
@job
fn statics(h: take drive::Build) -> Vec<u32> {
    var r = Box::new(recorded.start(h))
    loop {
        match r.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(c) => return draws_after(c, "shadows static"),
        }
    }
}

/// Frames until the clearing is ready (`test_ready`), then `settle` more; it's ready within
/// 600 frames. How many frames ran.
@job
fn until_ready(h: take drive::Build, frame: take u32, settle: take u32) -> u32 {
    var at = frame
    loop {
        var c = Box::new(called.start(h, String::from("test_ready"), Vec::new()))
        var ready = 0.0
        loop {
            match c.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    ready = v[0]
                    break
                },
            }
        }
        if ready >= 0.5 {
            break
        }
        assert(at < 600, f"the clearing isn't ready after {at} frames")
        var s = Box::new(steps.start(h, 1))
        loop {
            match s.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => break,
            }
        }
        at += 1
    }
    var s = Box::new(steps.start(h, settle))
    loop {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    at + settle
}

/// AC4: the wind's sway is a function of time and place only: `sway` is pure (its effects are
/// none) and takes the wind (its direction, strength and time) and a place; the same time and
/// place sway the same, and a different time or place differently.
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn the_wind_is_a_function_of_time_and_place() {
    var texts: Vec<String> = Vec::new()
    texts.push(String::from("effects engine::plant::sway"))
    texts.push(String::from("callers engine::plant::sway"))
    texts.push(String::from("callers engine::grass::flower_head"))
    var q = Box::new(queried.start(take texts))
    var answers: Option<Doc> = None
    while answers.is_none() {
        match q.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(d) => answers = Some(take d),
        }
    }
    let Some(d) = take answers else { panic("the answers") }
    let Some(first) = d.at(TOP, 0) else { panic("the effects' answer") }
    let Some(effects) = d.get(first, "effects") else { panic("sway's effects") }
    assert(d.count(effects) == 0, "sway has effects")
    let callers = names(d, 1, "callers", "caller")
    for want in ["blade_point", "flower_head", "card_corner"] {
        var found = false
        for c in callers {
            found = found || c.as_str().ends_with(want)
        }
        assert(found, f"{want} doesn't sway")
    }
    let heads = names(d, 2, "callers", "caller")
    assert(
        holds(heads, "engine::grass::flower"),
        "the flower vertex no longer uses the shared moving stem tip",
    )
    var o = Box::new(driven.start(false))
    var opened: Option<drive::Build> = None
    while opened.is_none() {
        match o.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(b) => opened = Some(b),
        }
    }
    let Some(h) = opened else { panic("the clearing") }
    let cases = [
        (3.5, vec3(2.0, 1.0, 20.0)),
        (3.5, vec3(2.0, 1.0, 20.0)),
        (3.6, vec3(2.0, 1.0, 20.0)),
        (3.5, vec3(5.0, 1.0, 20.0)),
    ]
    var sways: Vec<Vec<f64>> = Vec::new()
    for k in 0..4 {
        let (t, p) = cases[k]
        var args: Vec<Scalar> = Vec::new()
        for x in [t, p.x, p.y, p.z, 1.5] {
            args.push(Scalar::F32(x))
        }
        var c = Box::new(called.start(h, String::from("test_sway"), take args))
        loop {
            match c.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    sways.push(take v)
                    break
                },
            }
        }
    }
    let same = |a: [f64], b: [f64]| a.len() == b.len() &&
        a[0] == b[0] &&
        a[1] == b[1] &&
        a[2] == b[2]
    assert(same(sways[0], sways[1]), "the same time and place sway alike")
    assert(!same(sways[0], sways[2]), "the sway doesn't move with time")
    assert(!same(sways[0], sways[3]), "the sway doesn't move with place")
    let a = sways[0].clone()
    assert(sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]) > 1.0e-4, "no sway")
}

/// AC5: static shadows are cached: once the forest and the boulders are cooked (a few at a
/// frame, at load), one frame draws them into the static cascades, a steady frame draws nothing
/// into them, and moving the sun draws them again (counted in the frames' command streams).
@test(tool, read: [("repo", "../../../..")], budget: 600)
@job
fn static_shadows_are_drawn_once_and_again_when_the_sun_moves() {
    var o = Box::new(driven.start(true))
    var opened: Option<drive::Build> = None
    while opened.is_none() {
        match o.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(b) => opened = Some(b),
        }
    }
    let Some(h) = opened else { panic("the clearing") }
    var drawn: Vec<u32> = Vec::new()
    for _ in 0..30 {
        var s = Box::new(steps.start(h, 1))
        loop {
            match s.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => break,
            }
        }
        var st = Box::new(statics.start(h))
        loop {
            match st.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    drawn.push(sum(v))
                    break
                },
            }
        }
    }
    var frames = 0
    var first = 0
    for k in 0..drawn.len() {
        if drawn[k] > 0 {
            frames += 1
            first = drawn[k]
        }
    }
    assert(frames == 1, f"{frames} frames drew static shadows at load")
    assert(first > 10, f"the load drew {first} times into the static cascades")
    var u = Box::new(until_ready.start(h, frame: 30, settle: 2))
    loop {
        match u.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var drop = Box::new(recorded.start(h))
    loop {
        match drop.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var s = Box::new(steps.start(h, 30))
    loop {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var st = Box::new(statics.start(h))
    var steady: Vec<u32> = Vec::new()
    loop {
        match st.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(v) => {
                steady = take v
                break
            },
        }
    }
    assert(sum(steady) == 0, "steady frames draw static shadows")
    var args: Vec<Scalar> = Vec::new()
    for x in [0.85, 0.45, -0.25, 1.0] {
        args.push(Scalar::F32(x))
    }
    var c = Box::new(called.start(h, String::from("test_sun"), take args))
    loop {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var counts: Vec<u32> = Vec::new()
    for k in 0..2 {
        let n = if k == 0 { 1 } else { 5 }
        var s2 = Box::new(steps.start(h, n))
        loop {
            match s2.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => break,
            }
        }
        var st2 = Box::new(statics.start(h))
        loop {
            match st2.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    counts.push(sum(v))
                    break
                },
            }
        }
    }
    assert(counts[0] == first, f"moving the sun drew {counts[0]} times, the first frame {first}")
    assert(counts[1] == 0, "frames after the sun moved still draw static shadows")
}

/// The camera held inside a crown, exactly at a plant's middle (where its levels' patterns are
/// anchored, `lod::anchor`) and a step either side, looking each way, and inside a trunk: every
/// frame submits valid commands (M6 AC4, AC15). Playing spike 17, a camera there made
/// `engine::lod::packed` convert an infinite pixel to an integer, which trapped
/// (`lod.wrela:125`).
@test(tool, read: [("repo", "../../../..")], budget: 600)
@job
fn the_camera_inside_a_crown_draws_its_frames() {
    var o = Box::new(driven.start(true))
    var opened: Option<drive::Build> = None
    while opened.is_none() {
        match o.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(b) => opened = Some(b),
        }
    }
    let Some(h) = opened else { panic("the clearing") }
    var u = Box::new(until_ready.start(h, frame: 0, settle: 1))
    loop {
        match u.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var t = Box::new(called.start(h, String::from("test_trees"), Vec::new()))
    loop {
        match t.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(v) => {
                assert(v[0] > 0.0, "the forest is drawn")
                break
            },
        }
    }
    let plants = [0, 1, 7, 40]
    let offsets = [vec2(0.0, 0.0), vec2(0.05, 0.0), vec2(0.0, -0.05)]
    let looks = [vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(-1.0, 0.0), vec2(0.0, -1.0)]
    for k in 0..4 {
        var margs: Vec<Scalar> = Vec::new()
        margs.push(Scalar::I32(plants[k]))
        var m = Box::new(called.start(h, String::from("test_middle"), take margs))
        var middle: Vec<f64> = Vec::new()
        loop {
            match m.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    middle = take v
                    break
                },
            }
        }
        let mid = vec3(f32(middle[0]), f32(middle[1]), f32(middle[2]))
        var shots: Vec<(vec3, vec3)> = Vec::new()
        for j in 0..3 {
            let eye = vec3(mid.x + offsets[j].x, mid.y + offsets[j].y, mid.z)
            for l in 0..4 {
                shots.push((eye, vec3(eye.x + looks[l].x, eye.y, eye.z + looks[l].y)))
            }
        }
        // Inside its trunk, a metre up, looking along the ground.
        let foot = vec3(f32(middle[0]), f32(middle[1]) - f32(middle[3]) * 0.5 + 1.0, f32(middle[2]))
        shots.push((foot, vec3(foot.x + 3.0, foot.y, foot.z + 1.0)))
        for s in 0..shots.len() {
            let (eye, at) = shots[s]
            var args: Vec<Scalar> = Vec::new()
            for x in [eye.x, eye.y, eye.z, at.x, at.y, at.z] {
                args.push(Scalar::F32(x))
            }
            var hold = Box::new(called.start(h, String::from("test_hold"), take args))
            loop {
                match hold.get_mut().resume() {
                    Step::Yielded => yield,
                    Step::Done(_) => break,
                }
            }
            var st = Box::new(steps.start(h, 2))
            loop {
                match st.get_mut().resume() {
                    Step::Yielded => yield,
                    Step::Done(_) => break,
                }
            }
        }
    }
}
