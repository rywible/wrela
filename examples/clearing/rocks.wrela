// The clearing's boulders (#28 §1, §4): one big and mossy at the right of the foreground, a pair
// by the track, a few at the meadow's edge (spike 15's).

use engine::noise::rand
use engine::stone::{Realized, realize_stone}
use scene::height
use std::math::TAU

/// Each boulder: its place on the plane (x, z), its size (m), and its seed.
pub const SPOTS = [
    vec4(-6.8, 9.5, 1.5, 1.0),
    vec4(-5.2, 10.9, 0.6, 2.0),
    vec4(2.6, 14.0, 0.95, 3.0),
    vec4(3.8, 13.1, 0.5, 4.0),
    vec4(-13.0, 31.0, 1.3, 5.0),
    vec4(13.0, 22.0, 1.0, 6.0),
    vec4(-3.0, 41.0, 0.9, 7.0),
]

/// A boulder's squash, from its seed.
fn squash(seed: u32) -> vec3 {
    vec3(1.0 + 0.3 * rand(seed, 1), 0.62 + 0.15 * rand(seed, 2), 0.9 + 0.3 * rand(seed, 3))
}

/// How many boulders there are.
pub const BOULDERS: u32 = 7

/// Boulder `i`, realized: sunk a third of its height into the ground.
pub fn boulder(i: u32) -> Realized {
    let s = SPOTS[i]
    let seed = u32(s.w)
    let q = squash(seed)
    let at = vec3(s.x, height(x: s.x, z: s.y) + s.z * q.y * 0.35, s.y)
    realize_stone(radius: s.z, squash: q, seed: seed, at: at, turn: TAU * rand(seed, 4))
}

/// The boulders, realized.
pub fn boulders() -> Vec<Realized> {
    var out: Vec<Realized> = Vec::new()
    for i in 0..BOULDERS {
        out.push(boulder(i))
    }
    out
}

/// Where the grass keeps out of the boulders: each one's place and reach on the plane.
pub fn footprints() -> [vec4; 7] {
    var out = [vec4(0.0); 7]
    for i in 0..7 {
        let s = SPOTS[i]
        let q = squash(u32(s.w))
        out[i] = vec4(s.x, s.y, s.z * max(q.x, q.z) * 0.85, 0.0)
    }
    out
}
