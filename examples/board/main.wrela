// A whiteboard: an endless board of sticky notes, shapes, text, pen strokes and connectors, made
// with the pointer and the keyboard, kept in the program's storage. Everything on the screen is
// drawn here, from quads; the browser gives input and a canvas.
//
// Each frame: the host's answers (the display's pixel ratio, the saved board), the input, a
// save if the board changed, then the drawing. Input hits what the frame before drew.

use board::{Board, History, Item, Kind, NOTE, SMALLEST, has}
use chrome::{Action, Chrome, Tool}
use paint::{ACCENT, PAPER, Typing}
use platform::host
use std::gpu::begin_screen_pass
use std::input::{Button, Event, Key, Mods, events}
use std::io::{Pending, load as read_file, store}
use std::serialize::{LoadError, load, save}
use ui::draw::{DrawList, Rect, Renderer}
use ui::text::{Face, Fonts, decode, previous}
use view::View

/// Where the board is kept.
const SAVED: Text = "board/board"

/// What the pointer is doing while it's held.
enum Drag: Copy + Eq {
    Idle,
    /// Moving the camera: where the pointer and the camera began.
    Pan { from: vec2, pan: vec2 },
    /// Pressed on item `id`: it moves the selection once it travels.
    Press { at: vec2, id: u32, shift: bool },
    Move { last: vec2 },
    /// Selecting what a rectangle touches, added to the selection or instead of it.
    Marquee { from: vec2, add: bool },
    /// Resizing item `id` by a corner, the opposite corner held.
    Resize { id: u32, anchor: vec2 },
    /// Drawing a new shape from `from`.
    Shape { from: vec2 },
    /// Drawing a connector from item `from`.
    Link { from: u32 },
    Pen { id: u32 },
    /// Pressed on a control.
    Control,
}

/// A press on an item, to tell a double click.
struct Click: Copy {
    time: f32,
    at: vec2,
    id: u32,
}

pub struct App {
    fonts: Fonts,
    renderer: Renderer,
    draw: DrawList,
    board: Board,
    history: History,
    view: View,
    /// Whether the camera has been fitted to the board.
    placed: bool,
    tool: Tool,
    selected: Vec<u32>,
    typing: Option<Typing>,
    drag: Drag,
    /// Where the pointer is, in device pixels, and whether Space is held (a pan).
    pointer: vec2,
    space: bool,
    click: Option<Click>,
    clipboard: Vec<Item>,
    pastes: u32,
    screen: vec2,
    time: f32,
    // The host's answers: the environment, the saved board, the last save, the cursor.
    environment: Option<Pending<u8>>,
    loading: Option<Pending<u8>>,
    writing: Option<Pending<u8>>,
    cursor: Option<Pending<u8>>,
    shown_cursor: Text,
    /// The board as last saved, and when it last changed.
    saved: Board,
    changed_at: f32,
}

pub fn init() -> App {
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    let board = starter()
    App {
        fonts,
        renderer,
        draw: DrawList::new(),
        saved: board.clone(),
        board,
        history: History::new(),
        view: View::new(),
        placed: false,
        tool: Tool::Select,
        selected: Vec::new(),
        typing: None,
        drag: Drag::Idle,
        pointer: vec2(-1.0),
        space: false,
        click: None,
        clipboard: Vec::new(),
        pastes: 0,
        screen: vec2(640.0, 480.0),
        time: 0.0,
        environment: Some(host::environment()),
        loading: Some(read_file(SAVED)),
        writing: None,
        cursor: None,
        shown_cursor: "default",
        changed_at: 0.0,
    }
}

/// The board a person first sees: what it can do, on itself.
fn starter() -> Board {
    var b = Board::new()
    let notes = [
        "Welcome to the board! Double-click a note to write on it",
        "N  note\nR  rectangle\nO  ellipse\nD  diamond\nT  text\nL  connector\nP  pen",
        "Drag empty space to select. Space + drag pans, Cmd + scroll zooms",
    ]
    for i in 0..notes.len() {
        var n = Item::new(
            Kind::Note,
            vec2(-340.0 + 240.0 * f32(i), -260.0),
            vec2(NOTE),
            color: [0, 4, 2][i],
        )
        n.text = String::from(notes[i])
        let _ = b.add(take n)
    }
    var idea = Item::new(Kind::Box, vec2(-340.0, 40.0), vec2(200.0, 110.0), color: 5)
    idea.text = String::from("Idea")
    let idea = b.add(take idea)
    var plan = Item::new(Kind::Ellipse, vec2(-50.0, 30.0), vec2(160.0, 130.0), color: 3)
    plan.text = String::from("Plan")
    let plan = b.add(take plan)
    var ship = Item::new(Kind::Diamond, vec2(200.0, 15.0), vec2(160.0, 160.0), color: 1)
    ship.text = String::from("Ship it?")
    let ship = b.add(take ship)
    for (from, to) in [(idea, plan), (plan, ship)] {
        var l = Item::new(Kind::Link, vec2(0.0), vec2(0.0), color: 7)
        l.from = from
        l.to = to
        let _ = b.add(take l)
    }
    var note = Item::new(Kind::Text, vec2(-340.0, 230.0), vec2(760.0, 30.0), color: 7)
    note.text = String::from(
        "Cmd+Z undoes, Cmd+D duplicates, Backspace deletes. The board saves itself.",
    )
    let _ = b.add(take note)
    b
}

fn poll(pending: mut Option<Pending<u8>>) -> Option<Result<Vec<u8>, std::io::IoError>> {
    var answer = None
    match mut pending {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if answer.is_some() { pending = None }
    answer
}

/// Device pixels to a logical one.
fn unit(s: App) -> f32 {
    s.view.unit
}

pub fn frame(s: mut App, time: f32, width: u32, height: u32) {
    let screen = vec2(f32(width), f32(height))
    s.screen = screen
    s.time = time
    answers(mut s)
    if !s.placed {
        if let Some(r) = s.board.whole() {
            s.view.fit(r, screen, margin: 80.0 * unit(s), most: 1.0)
        }
        s.placed = true
    }
    let chrome = layout(s)
    for e in events() {
        handle(mut s, e, chrome)
    }
    keep(mut s)
    draw(mut s, screen)
}

/// The host's answers: the pixel ratio, the saved board, and the requests done.
fn answers(s: mut App) {
    if let Some(result) = poll(mut s.environment) {
        if let Ok(bytes) = result {
            if let Some(ratio) = host::word(bytes, 5) {
                let u = clamp(f32(ratio) / 1024.0, 0.5, 4.0)
                // The same world point stays in the middle of the screen.
                let middle = s.view.to_world(0.5 * s.screen)
                s.view.unit = u
                s.view.pan = middle - 0.5 * s.screen / s.view.scale()
                if s.history.fresh() { s.placed = false }
            }
        }
    }
    if let Some(result) = poll(mut s.loading) {
        if let Ok(bytes) = result {
            let kept: Result<Board, LoadError> = load(bytes.clone())
            // A board kept from before, unless the person has already changed this one.
            if let Ok(b) = kept {
                if s.history.fresh() {
                    s.saved = b.clone()
                    s.board = b.clone()
                    s.placed = false
                }
            }
        }
    }
    let _ = poll(mut s.writing)
    let _ = poll(mut s.cursor)
}

/// Saves the board once it has rested a moment after a change.
fn keep(s: mut App) {
    if s.board == s.saved {
        s.changed_at = s.time
        return
    }
    if s.writing.is_none() && s.drag == Drag::Idle && s.time - s.changed_at > 0.75 {
        let bytes = save(s.board)
        s.writing = Some(store(SAVED, bytes))
        s.saved = s.board.clone()
    }
}

/// The selection's rectangle on the screen, if anything's selected.
fn selection_rect(s: App) -> Option<Rect> {
    if s.selected.is_empty() {
        return None
    }
    match s.board.extent(s.selected) {
        Some(r) => Some(s.view.rect(r)),
        None => None,
    }
}

fn layout(s: App) -> Chrome {
    let bar = match s.drag {
        Drag::Idle => selection_rect(s),
        Drag::Control => selection_rect(s),
        _ => None,
    }
    chrome::layout(s.screen, unit(s), bar)
}

// ---- changes ----------------------------------------------------------------------------------

/// Keeps the board as it is, before a change.
fn checkpoint(s: mut App) {
    s.history.checkpoint(s.board)
}

fn select(s: mut App, ids: [u32]) {
    s.selected.clear()
    for id in ids {
        s.selected.push(id)
    }
}

/// Starts typing into item `id`, the caret at byte `at`; `keep` keeps the board for undo first.
fn begin_typing(s: mut App, id: u32, at: u32, keep: bool) {
    if keep {
        checkpoint(mut s)
    }
    s.typing = Some(Typing { id, at })
    select(mut s, [id])
}

/// Stops typing: text left empty goes.
fn stop_typing(s: mut App) {
    let Some(t) = replace(mut s.typing, None) else { return }
    let Some(i) = s.board.index(t.id) else { return }
    if s.board.items[i].kind == Kind::Text && s.board.items[i].text.trim().is_empty() {
        s.board.remove([t.id])
        s.selected.clear()
    }
}

/// Replaces the typed item's text with `text`, the caret at `at`.
fn retype(s: mut App, text: take String, at: u32) {
    let Some(t) = s.typing else { return }
    let Some(i) = s.board.index(t.id) else { return }
    s.board.items[i].text = take text
    if s.board.items[i].kind == Kind::Text {
        borrow font = s.fonts.font(Face::Sans)
        s.board.items[i].size.y = paint::text_height(font, s.board.items[i])
    }
    s.typing = Some(Typing { id: t.id, at })
}

/// Text typed at the caret.
fn type_char(s: mut App, c: u32) {
    let Some(t) = s.typing else { return }
    let Some(i) = s.board.index(t.id) else { return }
    borrow old = s.board.items[i].text.as_str()
    var text = String::from(old.slice(0, t.at))
    text.push_char(c)
    let at = text.len()
    text.push_str(old.slice(t.at, old.len()))
    retype(mut s, take text, at)
}

/// A key while typing: the caret's moves, deleting, a new line, and Escape to stop.
fn typing_key(s: mut App, key: Key, mods: Mods) {
    let Some(t) = s.typing else { return }
    let Some(i) = s.board.index(t.id) else { return }
    borrow old = s.board.items[i].text.as_str()
    let n = old.len()
    if key == Key::Escape || (key == Key::Enter && mods.command()) {
        stop_typing(mut s)
    } else if key == Key::Enter {
        type_char(mut s, 10)
    } else if key == Key::Backspace && t.at > 0 {
        let from = previous(old, t.at)
        var text = String::from(old.slice(0, from))
        text.push_str(old.slice(t.at, n))
        retype(mut s, take text, from)
    } else if key == Key::Delete && t.at < n {
        let to = decode(old, t.at).1
        var text = String::from(old.slice(0, t.at))
        text.push_str(old.slice(to, n))
        retype(mut s, take text, t.at)
    } else if key == Key::Left {
        s.typing = Some(Typing { id: t.id, at: previous(old, t.at) })
    } else if key == Key::Right && t.at < n {
        s.typing = Some(Typing { id: t.id, at: decode(old, t.at).1 })
    } else if key == Key::Home {
        s.typing = Some(Typing { id: t.id, at: 0 })
    } else if key == Key::End {
        s.typing = Some(Typing { id: t.id, at: n })
    }
}

fn delete_selection(s: mut App) {
    if s.selected.is_empty() {
        return
    }
    checkpoint(mut s)
    s.board.remove(s.selected)
    s.selected.clear()
}

fn recolor(s: mut App, index: u32) {
    if s.selected.is_empty() {
        return
    }
    checkpoint(mut s)
    for i in 0..s.board.items.len() {
        if has(s.selected, s.board.items[i].id) {
            s.board.items[i].color = index
        }
    }
}

fn undo(s: mut App) {
    stop_typing(mut s)
    if s.history.undo(mut s.board) {
        s.selected.retain(|id| s.board.index(id).is_some())
    }
}

fn redo(s: mut App) {
    stop_typing(mut s)
    if s.history.redo(mut s.board) {
        s.selected.retain(|id| s.board.index(id).is_some())
    }
}

/// Pastes `items` a step further each time, selected.
fn paste(s: mut App, items: [Item]) {
    if items.len() == 0 {
        return
    }
    checkpoint(mut s)
    s.pastes += 1
    let ids = s.board.paste(items, vec2(24.0 * f32(s.pastes)))
    select(mut s, ids)
}

fn zoom_by(s: mut App, factor: f32) {
    s.view.zoom_at(0.5 * s.screen, s.view.zoom * factor)
}

fn fit(s: mut App) {
    let u = unit(s)
    if let Some(r) = s.board.whole() {
        s.view.fit(r, s.screen, margin: 80.0 * u, most: 2.0)
    }
}

fn act(s: mut App, a: Action) {
    match a {
        Action::Use { tool } => {
            stop_typing(mut s)
            s.tool = tool
        },
        Action::Color { index } => recolor(mut s, index),
        Action::Front => if !s.selected.is_empty() {
            checkpoint(mut s)
            s.board.restack(s.selected, front: true)
        },
        Action::Back => if !s.selected.is_empty() {
            checkpoint(mut s)
            s.board.restack(s.selected, front: false)
        },
        Action::Delete => {
            stop_typing(mut s)
            delete_selection(mut s)
        },
        Action::Undo => undo(mut s),
        Action::Redo => redo(mut s),
        Action::ZoomIn => zoom_by(mut s, 1.25),
        Action::ZoomOut => zoom_by(mut s, 0.8),
        Action::Actual => zoom_by(mut s, 1.0 / s.view.zoom),
        Action::Fit => fit(mut s),
    }
}

// ---- input ------------------------------------------------------------------------------------

fn handle(s: mut App, e: Event, chrome: Chrome) {
    match e {
        Event::PointerDown { at, button, mods } => {
            s.pointer = at
            press(mut s, at, button, mods, chrome)
        },
        Event::PointerMove { at, .. } => {
            s.pointer = at
            moved(mut s, at)
        },
        Event::PointerUp { at, button, mods } => {
            s.pointer = at
            if button == Button::Primary || button == Button::Middle {
                released(mut s, at, mods)
            }
        },
        Event::Wheel { at, delta, mods } => {
            if mods.command() {
                let d = clamp(delta.y, -30.0, 30.0)
                s.view.zoom_at(at, s.view.zoom * exp(-0.01 * d))
            } else {
                let d = if mods.shift { vec2(delta.y, delta.x) } else { delta }
                s.view.pan += d / s.view.scale()
            }
        },
        Event::KeyDown { key, repeat, mods } => key_down(mut s, key, repeat, mods),
        Event::KeyUp { key, .. } => if key == Key::Space { s.space = false },
        Event::Text { char } => if s.typing.is_some() && char >= 32 && char != 127 {
            type_char(mut s, char)
        },
        _ => {},
    }
}

/// How near the pointer must come to a thin thing to hit it, in world units.
fn slack(s: App) -> f32 {
    6.0 * unit(s) / s.view.scale()
}

/// The corner of the one selected box under screen point `at`, and the opposite corner.
fn corner_at(s: App, at: vec2) -> Option<(u32, vec2)> {
    if s.selected.len() != 1 {
        return None
    }
    let id = s.selected[0]
    let Some(i) = s.board.index(id) else { return None }
    borrow it = s.board.items[i]
    if !it.boxed() {
        return None
    }
    let r = it.rect()
    for c in [vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0)] {
        let p = vec2(r.x, r.y) + c * vec2(r.w, r.h)
        if length(s.view.to_screen(p) - at) <= 8.0 * unit(s) {
            let o = vec2(r.x, r.y) + (vec2(1.0) - c) * vec2(r.w, r.h)
            return Some((id, o))
        }
    }
    None
}

fn press(s: mut App, at: vec2, button: Button, mods: Mods, chrome: Chrome) {
    if button == Button::Middle ||
        (button == Button::Primary && (s.space || s.tool == Tool::Hand)) {
        s.drag = Drag::Pan { from: at, pan: s.view.pan }
        return
    }
    if button != Button::Primary {
        return
    }
    if let Some(a) = chrome::at(chrome, at) {
        s.drag = Drag::Control
        act(mut s, a)
        return
    }
    if chrome::over(chrome, at) {
        s.drag = Drag::Control
        return
    }
    let w = s.view.to_world(at)
    // A press in the text being typed moves its caret; anywhere else, typing stops.
    if let Some(t) = s.typing {
        if s.board.hit(w, 0.0) == Some(t.id) {
            let Some(i) = s.board.index(t.id) else { return }
            borrow font = s.fonts.font(Face::Sans)
            let l = paint::layout(font, s.board.items[i])
            s.typing = Some(Typing { id: t.id, at: paint::offset_at(font, s.board.items[i], l, w) })
            return
        }
        stop_typing(mut s)
    }
    match s.tool {
        Tool::Select => press_select(mut s, at, w, mods),
        Tool::Note => {
            checkpoint(mut s)
            let id = s.board.add(Item::new(Kind::Note, w - vec2(0.5 * NOTE), vec2(NOTE), color: 0))
            begin_typing(mut s, id, 0, keep: false)
            s.tool = Tool::Select
        },
        Tool::Text => {
            checkpoint(mut s)
            borrow font = s.fonts.font(Face::Sans)
            let h = font.line_height(paint::TEXT_SIZE)
            let id = s.board.add(
                Item::new(Kind::Text, w - vec2(0.0, 0.5 * h), vec2(280.0, h), color: 7),
            )
            begin_typing(mut s, id, 0, keep: false)
            s.tool = Tool::Select
        },
        Tool::Box => s.drag = Drag::Shape { from: w },
        Tool::Ellipse => s.drag = Drag::Shape { from: w },
        Tool::Diamond => s.drag = Drag::Shape { from: w },
        Tool::Link => if let Some(id) = s.board.hit(w, slack(s)) {
            let Some(i) = s.board.index(id) else { return }
            if s.board.items[i].kind != Kind::Link {
                s.drag = Drag::Link { from: id }
            }
        },
        Tool::Pen => {
            checkpoint(mut s)
            var stroke = Item::new(Kind::Pen, w, vec2(0.0), color: 7)
            stroke.points.push(vec2(0.0))
            let id = s.board.add(take stroke)
            s.drag = Drag::Pen { id }
        },
        Tool::Hand => {},
    }
}

fn press_select(s: mut App, at: vec2, w: vec2, mods: Mods) {
    if let Some((id, anchor)) = corner_at(s, at) {
        checkpoint(mut s)
        s.drag = Drag::Resize { id, anchor }
        return
    }
    let Some(id) = s.board.hit(w, slack(s)) else {
        if !mods.shift {
            s.selected.clear()
        }
        s.click = None
        s.drag = Drag::Marquee { from: w, add: mods.shift }
        return
    }
    // A second press on the same item, soon and near: type into it.
    let double = match s.click {
        Some(c) => c.id == id && s.time - c.time < 0.45 && length(c.at - at) < 6.0 * unit(s),
        None => false,
    }
    s.click = Some(Click { time: s.time, at, id })
    let Some(i) = s.board.index(id) else { return }
    if double && s.board.items[i].has_text() {
        borrow font = s.fonts.font(Face::Sans)
        let l = paint::layout(font, s.board.items[i])
        let caret = paint::offset_at(font, s.board.items[i], l, w)
        begin_typing(mut s, id, caret, keep: true)
        s.click = None
        return
    }
    if mods.shift {
        if has(s.selected, id) {
            s.selected.retain(|k| k != id)
        } else {
            s.selected.push(id)
        }
    } else if !has(s.selected, id) {
        select(mut s, [id])
    }
    s.drag = Drag::Press { at: w, id, shift: mods.shift }
}

fn moved(s: mut App, at: vec2) {
    let w = s.view.to_world(at)
    match s.drag {
        Drag::Pan { from, pan } => s.view.pan = pan - (at - from) / s.view.scale(),
        Drag::Press { at: start, .. } => if length(w - start) * s.view.scale() > 3.0 * unit(s) {
            checkpoint(mut s)
            s.board.move_by(s.selected, w - start)
            s.drag = Drag::Move { last: w }
        },
        Drag::Move { last } => {
            s.board.move_by(s.selected, w - last)
            s.drag = Drag::Move { last: w }
        },
        Drag::Resize { id, anchor } => {
            let Some(i) = s.board.index(id) else { return }
            var d = w - anchor
            if s.board.items[i].kind == Kind::Note {
                // A note stays square.
                let side = max(abs(d.x), abs(d.y))
                d = vec2(if d.x < 0.0 { -side } else { side }, if d.y < 0.0 { -side } else { side })
            }
            let size = max(abs(d), vec2(SMALLEST))
            let lo = vec2(if d.x < 0.0 { anchor.x - size.x } else { anchor.x }, if d.y < 0.0 {
                anchor.y - size.y
            } else { anchor.y })
            s.board.items[i].at = lo
            s.board.items[i].size = size
            if s.board.items[i].kind == Kind::Text {
                borrow font = s.fonts.font(Face::Sans)
                s.board.items[i].size.y = paint::text_height(font, s.board.items[i])
            }
        },
        Drag::Pen { id } => {
            let Some(i) = s.board.index(id) else { return }
            let p = w - s.board.items[i].at
            let n = s.board.items[i].points.len()
            if length(p - s.board.items[i].points[n - 1]) * s.view.scale() >= 2.0 * unit(s) {
                s.board.items[i].points.push(p)
            }
        },
        _ => {},
    }
}

fn released(s: mut App, at: vec2, mods: Mods) {
    let w = s.view.to_world(at)
    match s.drag {
        Drag::Press { id, shift, .. } => if !shift && s.selected.len() > 1 {
            // A click (not a drag) in a selection picks the one item.
            select(mut s, [id])
        },
        Drag::Marquee { from, add } => {
            let lo = min(from, w)
            let hi = max(from, w)
            let ids = s.board.touching(Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y))
            if !add {
                s.selected.clear()
            }
            for id in ids {
                if !has(s.selected, id) {
                    s.selected.push(id)
                }
            }
        },
        Drag::Shape { from } => {
            let kind = match s.tool {
                Tool::Ellipse => Kind::Ellipse,
                Tool::Diamond => Kind::Diamond,
                _ => Kind::Box,
            }
            let d = abs(w - from) * s.view.scale()
            let (lo, size) = if d.x < 6.0 * unit(s) && d.y < 6.0 * unit(s) {
                // A click: the shape's usual size, about it.
                let size = match kind {
                    Kind::Ellipse => vec2(160.0),
                    Kind::Diamond => vec2(180.0),
                    _ => vec2(200.0, 120.0),
                }
                (from - 0.5 * size, size)
            } else {
                (min(from, w), max(abs(w - from), vec2(SMALLEST)))
            }
            let color = match kind {
                Kind::Ellipse => 5,
                Kind::Diamond => 3,
                _ => 4,
            }
            checkpoint(mut s)
            let id = s.board.add(Item::new(kind, lo, size, color))
            select(mut s, [id])
            s.tool = Tool::Select
        },
        Drag::Link { from } => {
            if let Some(to) = s.board.hit(w, slack(s)) {
                let Some(i) = s.board.index(to) else { return }
                if to != from && s.board.items[i].kind != Kind::Link {
                    checkpoint(mut s)
                    var l = Item::new(Kind::Link, vec2(0.0), vec2(0.0), color: 7)
                    l.from = from
                    l.to = to
                    let id = s.board.add(take l)
                    select(mut s, [id])
                    s.tool = Tool::Select
                }
            }
        },
        _ => {},
    }
    let _ = mods
    s.drag = Drag::Idle
}

fn key_down(s: mut App, key: Key, repeat: bool, mods: Mods) {
    if s.typing.is_some() {
        typing_key(mut s, key, mods)
        return
    }
    if mods.command() {
        if key == Key::Z && mods.shift || key == Key::Y {
            redo(mut s)
        } else if key == Key::Z {
            undo(mut s)
        } else if key == Key::A {
            var all: Vec<u32> = Vec::new()
            for it in s.board.items {
                all.push(it.id)
            }
            select(mut s, all)
        } else if key == Key::D {
            let items = s.board.copy(s.selected)
            s.pastes = 0
            paste(mut s, items)
        } else if key == Key::C || key == Key::X {
            s.clipboard = s.board.copy(s.selected)
            s.pastes = 0
            if key == Key::X {
                delete_selection(mut s)
            }
        } else if key == Key::V {
            let items = s.clipboard.clone()
            paste(mut s, items)
        } else if key == Key::Equal {
            zoom_by(mut s, 1.25)
        } else if key == Key::Minus {
            zoom_by(mut s, 0.8)
        } else if key == Key::Digit0 {
            act(mut s, Action::Actual)
        }
        return
    }
    if key == Key::Space {
        s.space = true
    } else if key == Key::Escape {
        s.selected.clear()
        s.tool = Tool::Select
    } else if key == Key::Backspace || key == Key::Delete {
        delete_selection(mut s)
    } else if key == Key::Enter && !repeat && s.selected.len() == 1 {
        let id = s.selected[0]
        let Some(i) = s.board.index(id) else { return }
        if s.board.items[i].has_text() {
            let n = s.board.items[i].text.len()
            begin_typing(mut s, id, n, keep: true)
        }
    } else if key == Key::Digit1 && mods.shift {
        fit(mut s)
    } else if key == Key::BracketRight || key == Key::BracketLeft {
        act(mut s, if key == Key::BracketRight { Action::Front } else { Action::Back })
    } else if key == Key::Left || key == Key::Right || key == Key::Up || key == Key::Down {
        if s.selected.is_empty() {
            return
        }
        if !repeat {
            checkpoint(mut s)
        }
        let step = if mods.shift { 10.0 } else { 1.0 }
        let d = match key {
            Key::Left => vec2(-step, 0.0),
            Key::Right => vec2(step, 0.0),
            Key::Up => vec2(0.0, -step),
            _ => vec2(0.0, step),
        }
        s.board.move_by(s.selected, d)
    } else {
        let tool = match key {
            Key::V => Some(Tool::Select),
            Key::H => Some(Tool::Hand),
            Key::N => Some(Tool::Note),
            Key::R => Some(Tool::Box),
            Key::O => Some(Tool::Ellipse),
            Key::D => Some(Tool::Diamond),
            Key::T => Some(Tool::Text),
            Key::L => Some(Tool::Link),
            Key::P => Some(Tool::Pen),
            _ => None,
        }
        if let Some(t) = tool {
            s.tool = t
        }
    }
}

// ---- drawing ----------------------------------------------------------------------------------

fn draw(s: mut App, screen: vec2) {
    let u = unit(s)
    let chrome = layout(s)
    let w = s.view.to_world(s.pointer)
    let hover_control = chrome::at(chrome, s.pointer)
    let on_chrome = chrome::over(chrome, s.pointer)
    let hover = if s.drag == Drag::Idle && !on_chrome && s.tool == Tool::Select {
        s.board.hit(w, slack(s))
    } else {
        None
    }
    let blink = (s.time * 1.6) % 2.0 < 1.3
    mut list = s.draw
    list.clear(screen)
    paint::grid(mut list, s.view, screen)
    paint::items(mut list, s.fonts, s.board, s.view, screen, s.typing, blink)
    // What's selected, and what the pointer is over or a marquee touches.
    let ring = max(1.5 * u, 1.0)
    let touched = match s.drag {
        Drag::Marquee { from, .. } => {
            let lo = min(from, w)
            let hi = max(from, w)
            s.board.touching(Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y))
        },
        _ => Vec::new(),
    }
    for i in 0..s.board.items.len() {
        let id = s.board.items[i].id
        let chosen = has(s.selected, id)
        if !chosen && hover != Some(id) && !has(touched, id) {
            continue
        }
        let r = s.view.rect(s.board.bounds(i)).shrink(-3.0 * u)
        list.ring(r, if chosen { ACCENT } else {
            vec4(ACCENT.xyz, 0.5)
        }, radius: 3.0 * u, width: ring)
    }
    if s.drag == Drag::Idle || s.drag == Drag::Control {
        if s.selected.len() == 1 {
            if let Some(i) = s.board.index(s.selected[0]) {
                if s.board.items[i].boxed() && s.typing.is_none() {
                    let r = s.view.rect(s.board.items[i].rect())
                    for c in [vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0)] {
                        let p = vec2(r.x, r.y) + c * vec2(r.w, r.h)
                        let h = Rect::new(p.x - 4.5 * u, p.y - 4.5 * u, 9.0 * u, 9.0 * u)
                        list.rect(h, vec4(1.0), radius: 2.0 * u)
                        list.ring(h, ACCENT, radius: 2.0 * u, width: ring)
                    }
                }
            }
        }
    }
    // What the pointer is making.
    match s.drag {
        Drag::Marquee { from, .. } => {
            let a = s.view.to_screen(from)
            let lo = min(a, s.pointer)
            let hi = max(a, s.pointer)
            let r = Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
            list.rect(r, vec4(ACCENT.xyz, 0.08))
            list.ring(r, vec4(ACCENT.xyz, 0.8), width: max(1.0 * u, 1.0))
        },
        Drag::Shape { from } => {
            let a = s.view.to_screen(from)
            let lo = min(a, s.pointer)
            let hi = max(a, s.pointer)
            let r = Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
            let ink = vec4(ACCENT.xyz, 0.9)
            match s.tool {
                Tool::Ellipse => list.ellipse(r, ink, width: ring),
                Tool::Diamond => list.diamond(r, ink, width: ring),
                _ => list.ring(r, ink, radius: 6.0 * s.view.scale(), width: ring),
            }
        },
        Drag::Link { from } => {
            if let Some(i) = s.board.index(from) {
                let a = s.board.items[i].edge(w)
                paint::arrow(
                    mut list,
                    s.view.to_screen(a),
                    s.pointer,
                    ACCENT,
                    max(2.0 * u, 1.0),
                    s.view.scale(),
                )
            }
        },
        _ => {},
    }
    let color = if s.selected.is_empty() {
        None
    } else {
        match s.board.index(s.selected[0]) {
            Some(i) => Some(s.board.items[i].color),
            None => None,
        }
    }
    // The board's name, top left.
    let title = Rect::new(12.0 * u, 12.0 * u, 120.0 * u, 40.0 * u)
    list.rect(
        Rect::new(title.x, title.y + 2.0 * u, title.w, title.h),
        vec4(0.0, 0.0, 0.0, 0.06),
        radius: 12.0 * u,
    )
    list.rect(title, vec4(1.0), radius: 10.0 * u)
    list.rect(
        Rect::new(title.x + 12.0 * u, title.y + 12.0 * u, 16.0 * u, 16.0 * u),
        ACCENT,
        radius: 4.0 * u,
    )
    let _ = list.text(
        s.fonts,
        Face::Sans,
        "Board",
        15.0 * u,
        vec2(title.x + 38.0 * u, title.y + 11.0 * u),
        paint::TEXT,
    )
    chrome::draw(
        mut list,
        s.fonts,
        chrome,
        u,
        s.tool,
        color,
        if s.drag == Drag::Idle { hover_control } else { None },
        s.view.zoom,
        can_undo: s.history.can_undo(),
        can_redo: s.history.can_redo(),
    )
    s.renderer.upload(list)
    let pass = begin_screen_pass(clear: PAPER)
    s.renderer.draw(pass, screen)
    pass.present()
    // The pointer's shape: a hand over a control, a bar over the text being typed.
    let typed_under = match s.typing {
        Some(t) => s.board.hit(w, 0.0) == Some(t.id),
        None => false,
    }
    let want: Text = if hover_control.is_some() { "pointer" } else if typed_under { "text" } else {
        "default"
    }
    if want != s.shown_cursor && s.cursor.is_none() {
        s.shown_cursor = want
        s.cursor = Some(host::cursor(want))
    }
}

// ---- tests: each a script of input (scripts/), as a person would use the board ---------------

fn screen_rect(game: App, i: u32) -> Rect {
    game.view.rect(game.board.items[i].rect())
}

/// N, a click, typing and Escape leave one note with the text.
@test(frames: 14, input: "scripts/note.json")
fn a_note_is_placed_and_typed(game: App) {
    assert(game.board.items.len() == 1, f"{game.board.items.len()} items")
    let it = game.board.items[0].clone()
    assert(it.kind == Kind::Note && it.text == "Hi there", f"`{it.text}`")
    assert(game.typing.is_none(), "Escape stopped the typing")
    let r = screen_rect(game, 0)
    assert(length(r.center() - vec2(320.0, 240.0)) < 1.0e-2, "the note is centred on the click")
}

/// R and a drag make a rectangle where the pointer went; dragging it moves it.
@test(frames: 16, input: "scripts/move.json")
fn a_dragged_shape_follows_the_pointer(game: App) {
    assert(game.board.items.len() == 1)
    assert(game.board.items[0].kind == Kind::Box)
    let r = screen_rect(game, 0)
    let want = Rect::new(x: 280.0, y: 200.0, w: 100.0, h: 60.0)
    assert(abs(r.x - want.x) < 0.05 && abs(r.y - want.y) < 0.05, f"at {r.x}, {r.y}")
    assert(abs(r.w - want.w) < 0.05 && abs(r.h - want.h) < 0.05, f"{r.w} by {r.h}")
}

/// The same, then Cmd+Z: the rectangle is back where it was made.
@test(frames: 18, input: "scripts/undo.json")
fn undo_puts_a_move_back(game: App) {
    assert(game.board.items.len() == 1)
    let r = screen_rect(game, 0)
    assert(abs(r.x - 200.0) < 0.05 && abs(r.y - 200.0) < 0.05, f"at {r.x}, {r.y}")
    assert(game.history.can_redo(), "the move can be made again")
}

/// L and a drag from one note to another join them.
@test(frames: 20, input: "scripts/link.json")
fn a_connector_joins_two_notes(game: App) {
    assert(game.board.items.len() == 3, f"{game.board.items.len()} items")
    let link = game.board.items[2].clone()
    assert(link.kind == Kind::Link, "the connector is on top")
    assert(link.from == game.board.items[0].id && link.to == game.board.items[1].id)
}

/// A marquee over one of two notes selects it alone, and Backspace deletes it.
@test(frames: 20, input: "scripts/marquee.json")
fn a_marquee_selects_and_backspace_deletes(game: App) {
    assert(game.board.items.len() == 1, f"{game.board.items.len()} items")
    assert(screen_rect(game, 0).x > 320.0, "the right-hand note is left")
    assert(game.selected.is_empty())
}

/// P and a drag draw a stroke through the pointer's path.
@test(frames: 12, input: "scripts/pen.json")
fn the_pen_draws_a_stroke(game: App) {
    assert(game.board.items.len() == 1)
    let it = game.board.items[0].clone()
    assert(it.kind == Kind::Pen && it.points.len() == 4, f"{it.points.len()} points")
    assert(game.tool == Tool::Pen, "the pen stays in hand")
}
