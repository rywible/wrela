// The board's scripts of input, which its frame tests give it
// (`@test(frames: n, input: scripts::NAME)`), as a person would: clicks, drags, keys and text.

use std::input::{Assist, Button, Key, Mods, Script}

/// The input of `the_align_row_lines_notes_up`.
pub const ALIGN: Script = Script::frames()
    .press(2, Key::A, Mods { meta: true })
    .press(3, Key::Backspace)
    .press(4, Key::N)
    .down(5, vec2(150.0, 150.0))
    .up(5, vec2(150.0, 150.0))
    .press(6, Key::Escape)
    .press(7, Key::N)
    .down(8, vec2(330.0, 260.0))
    .up(8, vec2(330.0, 260.0))
    .press(9, Key::Escape)
    .press(10, Key::N)
    .down(11, vec2(560.0, 200.0))
    .up(11, vec2(560.0, 200.0))
    .press(12, Key::Escape)
    .press(13, Key::A, Mods { meta: true })
    .assist(14, node: 72)
    .assist(15, node: 83)
    .press(16, Key::H, Mods { shift: true, alt: true })

