// What's on a board: notes, shapes, text, pen strokes and the links between them, in world
// units, in the order they're drawn. Hit tests, selection, copies and undo work on it here;
// main.wrela turns input into these calls and paint.wrela draws it.

use std::serialize::Serialize
use ui::draw::Rect

pub enum Kind: Copy + Eq + Serialize {
    Note,
    Box,
    Ellipse,
    Diamond,
    /// Its point at the middle of its top, its base along its bottom.
    Triangle,
    /// Rounded fully at its ends.
    Pill,
    Text,
    Pen,
    Link,
    /// A titled region that holds what's inside it: drawn behind everything, and what's in it
    /// moves, copies and goes with it.
    Frame,
}

/// How tall a frame's title strip is, above it.
pub const TITLE: f32 = 26.0

/// One thing on the board. A box's place is `at` (its top left) and `size`; a pen stroke's
/// `points` are from `at`; a link joins items `from` and `to`, drawn from edge to edge (`route`),
/// with `style`'s bends and arrowheads, and its label's box is `at` and `size` (`paint::label`).
/// `color` indexes the palette (paint.wrela).
pub struct Item: Clone + Eq + Serialize {
    pub id: u32,
    pub kind: Kind,
    pub at: vec2,
    pub size: vec2,
    pub color: u32,
    pub text: String,
    pub points: Vec<vec2>,
    pub from: u32,
    pub to: u32,
    pub style: u32,
    /// A locked item stays as it is: it can be selected, but not moved, resized, recoloured,
    /// typed into or deleted until it's unlocked.
    pub locked: bool,
    /// Its words' size (world units an em), or 0 for its kind's (a note's fits itself).
    pub type_size: f32,
    /// The group it's in (Cmd+G makes one), or 0: a click on one item of a group selects all.
    pub group: u32,
}

/// How `Board::arrange` lines things up: their left edges, centres or right edges together; their
/// tops, middles or bottoms; or with even gaps between them, across or down.
pub enum Align: Copy + Eq {
    Left,
    Center,
    Right,
    Top,
    Middle,
    Bottom,
    Across,
    Down,
}

/// A link's style: bits for elbows (else straight), and an arrowhead at each end.
pub const ELBOW: u32 = 1
pub const START_ARROW: u32 = 2
pub const END_ARROW: u32 = 4
/// A new connector's: in elbows, with an arrowhead where it ends.
pub const CONNECTOR: u32 = ELBOW | END_ARROW

/// The space `Board::beside` leaves between an item and the new one beside it.
pub const BESIDE: f32 = 60.0

/// A note's side, and the smallest a box is made.
pub const NOTE: f32 = 200.0
pub const SMALLEST: f32 = 24.0
/// How wide a pen's stroke and a link's line are.
pub const PEN_WIDTH: f32 = 3.0
pub const LINK_WIDTH: f32 = 2.0

impl Item {
    pub fn new(kind: Kind, at: vec2, size: vec2, color: u32) -> Item {
        Item {
            id: 0,
            kind,
            at,
            size,
            color,
            text: String::new(),
            points: Vec::new(),
            from: 0,
            to: 0,
            style: if kind == Kind::Link { CONNECTOR } else { 0 },
            locked: false,
            type_size: 0.0,
            group: 0,
        }
    }

    /// Whether a person types into it: a link's text is its label.
    pub fn has_text(self) -> bool {
        self.kind != Kind::Pen
    }

    /// Whether it's a box that resizes by its corners.
    pub fn boxed(self) -> bool {
        self.kind != Kind::Pen && self.kind != Kind::Link
    }

    /// The middle of its side facing `d` (a direction): where an elbow leaves it.
    pub fn side(self, d: vec2) -> vec2 {
        let c = self.center()
        if abs(d.x) >= abs(d.y) {
            // A triangle's slopes cross its middle height a quarter in from its corners.
            let inset = if self.kind == Kind::Triangle { 0.25 * self.size.x } else { 0.0 }
            vec2(if d.x >= 0.0 { self.at.x + self.size.x - inset } else { self.at.x + inset }, c.y)
        } else {
            vec2(c.x, if d.y >= 0.0 { self.at.y + self.size.y } else { self.at.y })
        }
    }

    pub fn rect(self) -> Rect {
        Rect::new(self.at.x, self.at.y, self.size.x, self.size.y)
    }

    /// It scaled by `k` about `about`: where it is, its size and a stroke's points. `words` is the
    /// size its words are at if it hasn't had one chosen, or 0 where they don't scale.
    pub fn scaled(self, about: vec2, k: f32, words: f32) -> Item {
        var out = self.clone()
        out.at = about + (self.at - about) * k
        out.size = self.size * k
        for i in 0..out.points.len() {
            out.points[i] = self.points[i] * k
        }
        if words > 0.0 {
            out.type_size = (if self.type_size > 0.0 { self.type_size } else { words }) * k
        }
        out
    }

    pub fn center(self) -> vec2 {
        self.at + 0.5 * self.size
    }

    /// Where the line from its centre toward `toward` leaves its edge.
    /// A triangle's corners: its point, then its base's left and right.
    pub fn corners(self) -> (vec2, vec2, vec2) {
        let r = self.rect()
        (vec2(r.x + 0.5 * r.w, r.y), vec2(r.x, r.bottom()), vec2(r.right(), r.bottom()))
    }

    pub fn edge(self, toward: vec2) -> vec2 {
        let c = self.center()
        let d = toward - c
        let h = 0.5 * self.size
        if d.x == 0.0 && d.y == 0.0 {
            return c
        }
        // A pen has no box: connectors meet its origin, as elbow connectors do.
        if self.kind == Kind::Pen { return c }
        if self.kind == Kind::Triangle {
            // The nearest side the ray from the middle crosses.
            let (a, b, z) = self.corners()
            var reach = 1.0e9
            for (p, q) in [(a, b), (b, z), (z, a)] {
                let e = q - p
                let den = d.x * e.y - d.y * e.x
                if abs(den) > 1.0e-9 {
                    let t = ((p.x - c.x) * e.y - (p.y - c.y) * e.x) / den
                    let u = ((p.x - c.x) * d.y - (p.y - c.y) * d.x) / den
                    if t > 0.0 && u >= 0.0 && u <= 1.0 { reach = min(reach, t) }
                }
            }
            return c + d * reach
        }
        if self.kind == Kind::Pill {
            let r = min(h.x, h.y)
            let half = max(h.x, h.y) - r
            let ray = if h.x >= h.y { abs(d) } else { abs(d.yx) }
            let reach = if ray.y > 0.0 && ray.x * r <= half * ray.y {
                r / ray.y
            } else {
                // The far crossing of the round cap at the end of the middle segment.
                let squared = dot(d, d)
                (ray.x * half + sqrt(max(r * r * squared - half * half * ray.y * ray.y, 0.0))) /
                    squared
            }
            return c + d * reach
        }
        let q = abs(d) / h
        let reach = match self.kind {
            Kind::Ellipse => 1.0 / length(q),
            Kind::Diamond => 1.0 / (q.x + q.y),
            _ => 1.0 / max(q.x, q.y),
        }
        c + d * reach
    }

    /// Whether world point `p` is on it, or within `slack` of a stroke or the box's edge.
    fn holds(self, p: vec2, slack: f32) -> bool {
        match self.kind {
            Kind::Pen => {
                let reach = slack + 0.5 * PEN_WIDTH
                if self.points.len() == 1 {
                    return length(p - self.at - self.points[0]) <= reach
                }
                for i in 1..self.points.len() {
                    let a = self.at + self.points[i - 1]
                    let b = self.at + self.points[i]
                    if distance_to_line(p, a, b) <= reach {
                        return true
                    }
                }
                false
            },
            Kind::Link => false,
            Kind::Ellipse => length((p - self.center()) / (0.5 * self.size + vec2(slack))) <= 1.0,
            Kind::Diamond => {
                let q = abs(p - self.center()) / (0.5 * self.size + vec2(slack))
                q.x + q.y <= 1.0
            },
            Kind::Triangle => {
                let (a, b, z) = self.corners()
                let side = |p0: vec2, p1: vec2| -> f32 {
                    (p1.x - p0.x) * (p.y - p0.y) - (p1.y - p0.y) * (p.x - p0.x)
                }
                let inside = side(a, b) <= 0.0 && side(b, z) <= 0.0 && side(z, a) <= 0.0
                inside ||
                    distance_to_line(p, a, b) <= slack ||
                    distance_to_line(p, b, z) <= slack ||
                    distance_to_line(p, z, a) <= slack
            },
            Kind::Pill => {
                // Within half its height (or width) of the line along its middle.
                let r = self.rect()
                let h = 0.5 * min(r.w, r.h)
                let c = r.center()
                let along = if r.w >= r.h { vec2(0.5 * r.w - h, 0.0) } else {
                    vec2(0.0, 0.5 * r.h - h)
                }
                distance_to_line(p, c - along, c + along) <= h + slack
            },
            _ => {
                let r = self.rect()
                p.x >= r.x - slack &&
                    p.y >= r.y - slack &&
                    p.x <= r.right() + slack &&
                    p.y <= r.bottom() + slack
            },
        }
    }
}

/// The distance from `p` to the line from `a` to `b`.
pub fn distance_to_line(p: vec2, a: vec2, b: vec2) -> f32 {
    let ab = b - a
    let along = dot(ab, ab)
    let t = if along > 0.0 { clamp(dot(p - a, ab) / along, 0.0, 1.0) } else { 0.0 }
    length(p - a - ab * t)
}

/// A frame's title strip, above it.
pub fn title_strip(f: Item) -> Rect {
    Rect::new(f.at.x, f.at.y - TITLE, f.size.x, TITLE)
}

/// Whether rectangles `a` and `b` overlap.
fn overlaps(a: Rect, b: Rect) -> bool {
    a.x <= b.right() && a.right() >= b.x && a.y <= b.bottom() && a.bottom() >= b.y
}

/// Whether the line from `a` to `b` passes through rectangle `r` (Liang and Barsky's clipping).
pub fn crosses(a: vec2, b: vec2, r: Rect) -> bool {
    let d = b - a
    var lo = 0.0
    var hi = 1.0
    for (p, q) in [
        (-d.x, a.x - r.x),
        (d.x, r.right() - a.x),
        (-d.y, a.y - r.y),
        (d.y, r.bottom() - a.y),
    ] {
        if p == 0.0 {
            if q < 0.0 {
                return false
            }
        } else {
            let t = q / p
            if p < 0.0 { lo = max(lo, t) } else { hi = min(hi, t) }
        }
    }
    lo <= hi
}

/// Whether `ids` holds `id`.
/// Group `g`'s new number in `pairs` (old, new), or 0.
fn renumbered(pairs: [(u32, u32)], g: u32) -> u32 {
    for p in pairs {
        if p.0 == g { return p.1 }
    }
    0
}

pub fn has(ids: [u32], id: u32) -> bool {
    for i in ids {
        if i == id {
            return true
        }
    }
    false
}

pub struct Board: Clone + Eq + Serialize {
    /// What the board is called (top left; a double click renames it).
    pub name: String,
    pub items: Vec<Item>,
    /// The number the next item or group gets.
    pub next: u32,
}

impl Board {
    pub fn new() -> Board {
        Board { name: String::from("Untitled board"), items: Vec::new(), next: 1 }
    }

    /// Adds `item` on top, with a new id, which it returns.
    pub fn add(mut self, item: take Item) -> u32 {
        var it = take item
        it.id = self.next
        self.next += 1
        let id = it.id
        self.items.push(take it)
        id
    }

    pub fn index(self, id: u32) -> Option<u32> {
        for i in 0..self.items.len() {
            if self.items[i].id == id {
                return Some(i)
            }
        }
        None
    }

    /// A link's ends: on the edges of the items it joins, each on the line between their
    /// centres. `None` if either is gone.
    pub fn ends(self, link: Item) -> Option<(vec2, vec2)> {
        let Some(a) = self.index(link.from) else { return None }
        let Some(b) = self.index(link.to) else { return None }
        borrow from = self.items[a]
        borrow to = self.items[b]
        Some((from.edge(to.center()), to.edge(from.center())))
    }

    /// Where link `link` runs, its ends on its items' edges: straight, the line between their
    /// middles; in elbows, from the sides that face each other, across and back. Empty if either
    /// item is gone.
    pub fn route(self, link: Item) -> Vec<vec2> {
        var out: Vec<vec2> = Vec::new()
        let Some(a) = self.index(link.from) else { return out }
        let Some(b) = self.index(link.to) else { return out }
        borrow from = self.items[a]
        borrow to = self.items[b]
        if link.style & ELBOW == 0 {
            out.push(from.edge(to.center()))
            out.push(to.edge(from.center()))
            return out
        }
        let d = to.center() - from.center()
        let start = from.side(d)
        let end = to.side(-d)
        out.push(start)
        if abs(d.x) >= abs(d.y) {
            let mid = 0.5 * (start.x + end.x)
            if start.y != end.y {
                out.push(vec2(mid, start.y))
                out.push(vec2(mid, end.y))
            }
        } else {
            let mid = 0.5 * (start.y + end.y)
            if start.x != end.x {
                out.push(vec2(start.x, mid))
                out.push(vec2(end.x, mid))
            }
        }
        out.push(end)
        out
    }

    /// The world rectangle item `i` covers.
    pub fn bounds(self, i: u32) -> Rect {
        borrow it = self.items[i]
        match it.kind {
            Kind::Pen => {
                var lo = it.points[0]
                var hi = it.points[0]
                for p in it.points {
                    lo = min(lo, p)
                    hi = max(hi, p)
                }
                let h = vec2(0.5 * PEN_WIDTH)
                lo = it.at + lo - h
                hi = it.at + hi + h
                Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)
            },
            Kind::Link => {
                let route = self.route(it)
                if route.is_empty() {
                    return Rect::new(it.at.x, it.at.y, w: 0.0, h: 0.0)
                }
                var lo = route[0]
                var hi = route[0]
                for p in route {
                    lo = min(lo, p)
                    hi = max(hi, p)
                }
                // Its label, where it has one.
                if it.size.x > 0.0 {
                    lo = min(lo, it.at)
                    hi = max(hi, it.at + it.size)
                }
                let h = vec2(0.5 * LINK_WIDTH)
                Rect::new(lo.x - h.x, lo.y - h.y, hi.x - lo.x + 2.0 * h.x, hi.y - lo.y + 2.0 * h.y)
            },
            _ => it.rect(),
        }
    }

    /// The rectangle around every item, if there are any.
    pub fn whole(self) -> Option<Rect> {
        self.span([], every: true)
    }

    /// The rectangle around the items in `ids`, if there are any.
    pub fn extent(self, ids: [u32]) -> Option<Rect> {
        self.span(ids, every: false)
    }

    /// `ids`, and the rest of each group one of them is in.
    pub fn with_groups(self, ids: [u32]) -> Vec<u32> {
        let groups = self.groups(ids)
        var out = Vec::from(ids)
        for it in self.items {
            if it.group != 0 && has(groups, it.group) && !has(out, it.id) {
                out.push(it.id)
            }
        }
        out
    }

    /// The groups the items in `ids` are in, each once.
    pub fn groups(self, ids: [u32]) -> Vec<u32> {
        var out: Vec<u32> = Vec::new()
        for it in self.items {
            if it.group != 0 && has(ids, it.id) && !has(out, it.group) {
                out.push(it.group)
            }
        }
        out
    }

    /// The items in group `g`.
    pub fn members(self, g: u32) -> Vec<u32> {
        var out: Vec<u32> = Vec::new()
        for it in self.items {
            if g != 0 && it.group == g {
                out.push(it.id)
            }
        }
        out
    }

    fn span(self, ids: [u32], every: bool) -> Option<Rect> {
        var lo = vec2(0.0)
        var hi = vec2(0.0)
        var any = false
        for i in 0..self.items.len() {
            if !every && !has(ids, self.items[i].id) {
                continue
            }
            let r = self.bounds(i)
            if r.w <= 0.0 && r.h <= 0.0 {
                continue
            }
            lo = if any { min(lo, vec2(r.x, r.y)) } else { vec2(r.x, r.y) }
            hi = if any { max(hi, vec2(r.right(), r.bottom())) } else {
                vec2(r.right(), r.bottom())
            }
            any = true
        }
        if any { Some(Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y)) } else { None }
    }

    /// The topmost item at world point `p`, within `slack` units: links lie over the rest.
    pub fn hit(self, p: vec2, slack: f32) -> Option<u32> {
        var i = self.items.len()
        while i > 0 {
            i -= 1
            borrow it = self.items[i]
            if it.kind == Kind::Link {
                if it.size.x > 0.0 && it.rect().contains(p) {
                    return Some(it.id)
                }
                let route = self.route(it)
                for k in 1..route.len() {
                    if distance_to_line(p, route[k - 1], route[k]) <= slack + LINK_WIDTH {
                        return Some(it.id)
                    }
                }
            }
        }
        i = self.items.len()
        while i > 0 {
            i -= 1
            if self.items[i].kind != Kind::Frame && self.items[i].holds(p, slack) {
                return Some(self.items[i].id)
            }
        }
        // Frames lie under everything: hit last, on their area or their title.
        i = self.items.len()
        while i > 0 {
            i -= 1
            borrow it = self.items[i]
            if it.kind == Kind::Frame && (it.holds(p, slack) || title_strip(it).contains(p)) {
                return Some(it.id)
            }
        }
        None
    }

    /// The items inside frame `id`, bounds and all (frames aside): what goes with it.
    pub fn inside(self, id: u32) -> Vec<u32> {
        var out: Vec<u32> = Vec::new()
        let Some(f) = self.index(id) else { return out }
        let r = self.items[f].rect()
        for i in 0..self.items.len() {
            borrow it = self.items[i]
            if it.kind == Kind::Frame || it.kind == Kind::Link {
                continue
            }
            let b = self.bounds(i)
            if b.x >= r.x && b.y >= r.y && b.right() <= r.right() && b.bottom() <= r.bottom() {
                out.push(it.id)
            }
        }
        out
    }

    /// `ids` with what's inside the frames among them.
    pub fn with_contents(self, ids: [u32]) -> Vec<u32> {
        var out: Vec<u32> = Vec::new()
        for id in ids {
            if !has(out, id) {
                out.push(id)
            }
            let Some(i) = self.index(id) else { continue }
            if self.items[i].kind == Kind::Frame {
                for k in self.inside(id) {
                    if !has(out, k) {
                        out.push(k)
                    }
                }
            }
        }
        out
    }

    /// Every item that touches world rectangle `r`, bottom first.
    pub fn touching(self, r: Rect) -> Vec<u32> {
        var out: Vec<u32> = Vec::new()
        for i in 0..self.items.len() {
            let b = self.bounds(i)
            if !(b.x <= r.right() && b.right() >= r.x && b.y <= r.bottom() && b.bottom() >= r.y) {
                continue
            }
            // A connector or a stroke touches it where a line of it does, not its bounds; a
            // locked item isn't swept up.
            borrow it = self.items[i]
            if it.locked {
                continue
            }
            // A frame only when the rectangle holds it all: a drag inside one selects its
            // contents, not it.
            if it.kind == Kind::Frame &&
                !(b.x >= r.x && b.y >= r.y && b.right() <= r.right() && b.bottom() <= r.bottom()) {
                continue
            }
            let touches = match it.kind {
                Kind::Link => {
                    let route = self.route(it)
                    var any = it.size.x > 0.0 && overlaps(it.rect(), r)
                    for k in 1..route.len() {
                        if crosses(route[k - 1], route[k], r) { any = true }
                    }
                    any
                },
                Kind::Pen => {
                    var any = it.points.len() == 1 && r.contains(it.at + it.points[0])
                    for k in 1..it.points.len() {
                        if crosses(it.at + it.points[k - 1], it.at + it.points[k], r) { any = true }
                    }
                    any
                },
                _ => true,
            }
            if touches {
                out.push(it.id)
            }
        }
        out
    }

    /// Removes the items in `ids`, and the links to them.
    pub fn remove(mut self, ids: [u32]) {
        self.items.retain(|it| !has(ids, it.id) && !has(ids, it.from) && !has(ids, it.to))
    }

    /// Moves the items in `ids` by `d`; links follow what they join.
    pub fn move_by(mut self, ids: [u32], d: vec2) {
        for i in 0..self.items.len() {
            if has(ids, self.items[i].id) && !self.items[i].locked {
                self.items[i].at += d
            }
        }
    }

    /// A new item like item `id` (its kind, size, colour and size of words, but no words) beside
    /// it in direction `d`, a unit step along an axis: `BESIDE` past it, or on in steps of its
    /// size and that space until it overlaps no other box (frames aside), up to 20 steps.
    pub fn beside(self, id: u32, d: vec2) -> Option<Item> {
        let Some(i) = self.index(id) else { return None }
        borrow it = self.items[i]
        var out = Item::new(it.kind, it.at, it.size, it.color)
        out.type_size = it.type_size
        let step = d * (it.size + vec2(BESIDE))
        out.at = it.at + step
        for _ in 0..20 {
            var free = true
            for o in self.items {
                if o.boxed() &&
                    o.kind != Kind::Frame &&
                    overlaps(o.rect().shrink(0.5), out.rect()) {
                    free = false
                }
            }
            if free {
                break
            }
            out.at += step
        }
        Some(out)
    }

    /// Lines up the items in `ids` as `way` says. A group among them moves as one, a frame
    /// takes what's inside it, a connector follows its ends, and a locked item stays (but the
    /// rest still line up on it). Even gaps need three things; the outer two stay.
    pub fn arrange(mut self, ids: [u32], way: Align) {
        // What moves as one: a group, or an item in none.
        var units: Vec<Vec<u32>> = Vec::new()
        var groups: Vec<u32> = Vec::new()
        for id in ids {
            let Some(i) = self.index(id) else { continue }
            let g = self.items[i].group
            if self.items[i].kind == Kind::Link || g != 0 && has(groups, g) {
                continue
            }
            if g == 0 {
                units.push(Vec::from([id]))
                continue
            }
            groups.push(g)
            var members: Vec<u32> = Vec::new()
            for k in ids {
                let Some(j) = self.index(k) else { continue }
                if self.items[j].group == g && self.items[j].kind != Kind::Link {
                    members.push(k)
                }
            }
            units.push(take members)
        }
        let spaced = way == Align::Across || way == Align::Down
        if units.len() < (if spaced { 3 } else { 2 }) {
            return
        }
        var rects: Vec<Rect> = Vec::new()
        for u in units {
            rects.push(self.extent(u).unwrap())
        }
        var lo = vec2(rects[0].x, rects[0].y)
        var hi = vec2(rects[0].right(), rects[0].bottom())
        for r in rects {
            lo = min(lo, vec2(r.x, r.y))
            hi = max(hi, vec2(r.right(), r.bottom()))
        }
        let middle = 0.5 * (lo + hi)
        var shifts: Vec<vec2> = Vec::new()
        for r in rects {
            shifts.push(match way {
                Align::Left => vec2(lo.x - r.x, 0.0),
                Align::Center => vec2(middle.x - r.center().x, 0.0),
                Align::Right => vec2(hi.x - r.right(), 0.0),
                Align::Top => vec2(0.0, lo.y - r.y),
                Align::Middle => vec2(0.0, middle.y - r.center().y),
                Align::Bottom => vec2(0.0, hi.y - r.bottom()),
                _ => vec2(0.0),
            })
        }
        if spaced {
            // In order of their centres along the way, with what's left over shared between them.
            let across = way == Align::Across
            let along = |r: Rect| -> f32 { if across { r.center().x } else { r.center().y } }
            var order: Vec<u32> = Vec::new()
            for k in 0..rects.len() {
                var at = order.len()
                while at > 0 && along(rects[order[at - 1]]) > along(rects[k]) {
                    at -= 1
                }
                order.insert(at, k)
            }
            var used = 0.0
            for r in rects {
                used += if across { r.w } else { r.h }
            }
            let gap = ((if across { hi.x - lo.x } else {
                hi.y - lo.y
            }) - used) / f32(rects.len() - 1)
            var at = if across { lo.x } else { lo.y }
            for k in order {
                let r = rects[k]
                shifts[k] = if across { vec2(at - r.x, 0.0) } else { vec2(0.0, at - r.y) }
                at += (if across { r.w } else { r.h }) + gap
            }
        }
        for k in 0..units.len() {
            // A frame's contents come too, unless they're lined up themselves.
            var carried: Vec<u32> = Vec::new()
            for id in self.with_contents(units[k]) {
                if has(units[k], id) || !has(ids, id) {
                    carried.push(id)
                }
            }
            self.move_by(carried, shifts[k])
        }
    }

    /// Copies of the items in `ids`, and of the links between them, bottom first.
    pub fn copy(self, ids: [u32]) -> Vec<Item> {
        var out: Vec<Item> = Vec::new()
        for it in self.items {
            let joined = it.kind == Kind::Link && has(ids, it.from) && has(ids, it.to)
            let picked = it.kind != Kind::Link && has(ids, it.id)
            if joined || picked {
                out.push(it.clone())
            }
        }
        out
    }

    /// Adds copies of `items` on top, moved by `d`, with new ids: a link joins the copies of
    /// what it joined, and is left out if they aren't both there. The new ids.
    pub fn paste(mut self, items: [Item], d: vec2) -> Vec<u32> {
        var old: Vec<u32> = Vec::new()
        var new: Vec<u32> = Vec::new()
        // The copies of a group are a group of their own.
        var groups: Vec<(u32, u32)> = Vec::new()
        for it in items {
            if it.group != 0 && renumbered(groups, it.group) == 0 {
                groups.push((it.group, self.next))
                self.next += 1
            }
        }
        for it in items {
            if it.kind != Kind::Link {
                var copy = it.clone()
                copy.group = renumbered(groups, it.group)
                copy.at += d
                old.push(it.id)
                new.push(self.add(take copy))
            }
        }
        var out = new.clone()
        for it in items {
            if it.kind == Kind::Link {
                var from = 0
                var to = 0
                for k in 0..old.len() {
                    if old[k] == it.from { from = new[k] }
                    if old[k] == it.to { to = new[k] }
                }
                if from != 0 && to != 0 {
                    var copy = it.clone()
                    copy.group = renumbered(groups, it.group)
                    copy.from = from
                    copy.to = to
                    out.push(self.add(take copy))
                }
            }
        }
        out
    }

    /// Moves the items in `ids` above everything else (`front`) or below it, keeping their
    /// order.
    pub fn restack(mut self, ids: [u32], front: bool) {
        var moved: Vec<Item> = Vec::new()
        var kept: Vec<Item> = Vec::new()
        for it in self.items {
            if has(ids, it.id) { moved.push(it.clone()) } else { kept.push(it.clone()) }
        }
        self.items.clear()
        if front {
            self.items.append(mut kept)
            self.items.append(mut moved)
        } else {
            self.items.append(mut moved)
            self.items.append(mut kept)
        }
    }
}

/// The boards before and after each change, for undo and redo.
pub struct History {
    undo: Vec<Board>,
    redo: Vec<Board>,
}

/// How many changes undo goes back.
const KEPT: u32 = 100

impl History {
    pub fn new() -> History {
        History { undo: Vec::new(), redo: Vec::new() }
    }

    /// Whether nothing has changed yet.
    pub fn fresh(self) -> bool {
        self.undo.is_empty() && self.redo.is_empty()
    }

    pub fn can_undo(self) -> bool {
        !self.undo.is_empty()
    }

    pub fn can_redo(self) -> bool {
        !self.redo.is_empty()
    }

    /// Keeps `b` as it is before a change.
    pub fn checkpoint(mut self, b: Board) {
        if self.undo.len() == KEPT {
            let _ = self.undo.remove(0)
        }
        self.undo.push(b.clone())
        self.redo.clear()
    }

    /// Puts `b` back as it was before its last change; false if there's none.
    pub fn undo(mut self, b: mut Board) -> bool {
        let Some(before) = self.undo.pop() else { return false }
        self.redo.push(replace(mut b, take before))
        true
    }

    /// Makes the last change undone again; false if there's none.
    pub fn redo(mut self, b: mut Board) -> bool {
        let Some(after) = self.redo.pop() else { return false }
        self.undo.push(replace(mut b, take after))
        true
    }
}

// ---- tests ------------------------------------------------------------------------------------

fn sample() -> Board {
    var b = Board::new()
    let _ = b.add(Item::new(Kind::Box, vec2(0.0, 0.0), vec2(100.0, 50.0), color: 0))
    let _ = b.add(Item::new(Kind::Ellipse, vec2(50.0, 20.0), vec2(100.0, 100.0), color: 1))
    let _ = b.add(Item::new(Kind::Note, vec2(400.0, 0.0), vec2(NOTE), color: 2))
    var link = Item::new(Kind::Link, vec2(0.0), vec2(0.0), color: 3)
    link.from = 1
    link.to = 3
    let _ = b.add(take link)
    b
}

@test
fn the_topmost_item_is_hit() {
    let b = sample()
    // Inside both the box and the ellipse: the ellipse is on top.
    assert(b.hit(vec2(90.0, 45.0), slack: 0.0) == Some(2))
    // In the box, outside the ellipse's curve.
    assert(b.hit(vec2(55.0, 22.0), slack: 0.0) == Some(1))
    // On the link, between the box and the note.
    assert(b.hit(vec2(250.0, 58.0), slack: 2.0) == Some(4))
    assert(b.hit(vec2(250.0, 300.0), slack: 2.0) == None)
}

@test
fn a_link_ends_on_its_items_edges() {
    let b = sample()
    let Some((a, z)) = b.ends(b.items[3]) else { panic("the link has ends") }
    // From the box's centre (50, 25) toward the note's (500, 100): it leaves the box's right side.
    assert(abs(a.x - 100.0) < 1.0e-3, f"{a.x}")
    assert(abs(z.x - 400.0) < 1.0e-3, f"{z.x}")
    var e = Item::new(Kind::Ellipse, vec2(0.0), vec2(100.0, 50.0), color: 0)
    let p = e.edge(vec2(50.0, 125.0))
    assert(length(p - vec2(50.0, 50.0)) < 1.0e-3, "straight down, to the bottom of the curve")
    e.kind = Kind::Diamond
    assert(length(e.edge(vec2(200.0, 25.0)) - vec2(100.0, 25.0)) < 1.0e-3)
}

@test
fn straight_connectors_meet_the_rounded_edges_of_pills() {
    for size in [vec2(200.0, 60.0), vec2(60.0, 200.0), vec2(80.0)] {
        let p = Item::new(Kind::Pill, vec2(10.0, -20.0), size, color: 0)
        let r = 0.5 * min(size.x, size.y)
        let along = if size.x >= size.y { vec2(0.5 * size.x - r, 0.0) } else {
            vec2(0.0, 0.5 * size.y - r)
        }
        for i in 0..32 {
            let angle = f32(i) * std::math::TAU / 32.0
            let d = vec2(cos(angle), sin(angle))
            let edge = p.edge(p.center() + d * 500.0)
            let radius = distance_to_line(edge, p.center() - along, p.center() + along)
            assert(abs(radius - r) < 0.001, "the endpoint lies on the pill, not its box")
            let from = edge - p.center()
            assert(dot(from, d) > 0.0 && abs(from.x * d.y - from.y * d.x) < 0.001)
        }
    }
}

@test
fn a_straight_connector_can_start_on_a_pen_stroke() {
    var b = Board::new()
    var pen = Item::new(Kind::Pen, vec2(10.0, 20.0), vec2(0.0), color: 0)
    pen.points.push(vec2(0.0))
    pen.points.push(vec2(20.0, 10.0))
    let from = b.add(take pen)
    let to = b.add(Item::new(Kind::Box, vec2(100.0, 0.0), vec2(40.0), color: 0))
    var link = Item::new(Kind::Link, vec2(0.0), vec2(0.0), color: 0)
    link.from = from
    link.to = to
    link.style = 0
    let route = b.route(link)
    assert(route.len() == 2 && route[0] == vec2(10.0, 20.0) && route[1] == vec2(100.0, 20.0))
}

@test
fn a_marquee_selects_what_it_touches() {
    let b = sample()
    let ids = b.touching(Rect::new(x: 120.0, y: 95.0, w: 20.0, h: 20.0))
    assert(ids.len() == 1 && ids[0] == 2, "only the ellipse reaches there")
    assert(b.touching(Rect::new(x: -10.0, y: -10.0, w: 1000.0, h: 1000.0)).len() == 4)
}

@test
fn removing_an_item_removes_its_links() {
    var b = sample()
    b.remove([3])
    assert(b.items.len() == 2, f"{b.items.len()} left")
    assert(b.index(4).is_none(), "the link to the note went with it")
}

@test
fn pasting_joins_the_copies() {
    var b = sample()
    let items = b.copy([1, 3])
    assert(items.len() == 3, "the box, the note and the link between them")
    let ids = b.paste(items, vec2(10.0, 0.0))
    assert(ids.len() == 3 && b.items.len() == 7)
    let link = b.items[6].clone()
    assert(link.kind == Kind::Link && link.from == ids[0] && link.to == ids[1])
    assert(b.items[4].at == vec2(10.0, 0.0))
}

@test
fn undo_and_redo_restore_the_board() {
    var b = sample()
    var h = History::new()
    let first = b.clone()
    h.checkpoint(b)
    b.move_by([1, 2], vec2(5.0, 5.0))
    let moved = b.clone()
    h.checkpoint(b)
    b.remove([1])
    assert(h.undo(mut b) && b == moved)
    assert(h.undo(mut b) && b == first)
    assert(!h.undo(mut b), "nothing before the first change")
    assert(h.redo(mut b) && b == moved)
    b.restack([1], front: true)
    assert(b.items[3].id == 1, "the box is on top")
}

@test
fn a_connector_runs_in_elbows_between_facing_sides() {
    var b = Board::new()
    let a = b.add(Item::new(Kind::Box, vec2(0.0, 0.0), vec2(100.0, 50.0), color: 0))
    let z = b.add(Item::new(Kind::Box, vec2(300.0, 200.0), vec2(100.0, 50.0), color: 0))
    var link = Item::new(Kind::Link, vec2(0.0), vec2(0.0), color: 7)
    link.from = a
    link.to = z
    assert(link.style == CONNECTOR)
    // Wider apart than tall: out of the right side, across at the middle, into the left side.
    let r = b.route(link)
    assert(r.len() == 4)
    assert(r[0] == vec2(100.0, 25.0) && r[1] == vec2(200.0, 25.0))
    assert(r[2] == vec2(200.0, 225.0) && r[3] == vec2(300.0, 225.0))
    // In line, it's one straight run.
    b.items[1].at = vec2(300.0, 0.0)
    assert(b.route(link).len() == 2)
    // Straight style: centre to centre, from edge to edge.
    link.style = END_ARROW
    let line = b.route(link)
    assert(line.len() == 2 && line[0] == vec2(100.0, 25.0) && line[1] == vec2(300.0, 25.0))
    // The bend is hit; empty space beside it isn't.
    link.style = CONNECTOR
    b.items[1].at = vec2(300.0, 200.0)
    let l = b.add(take link)
    assert(b.hit(vec2(200.0, 120.0), slack: 2.0) == Some(l))
    assert(b.hit(vec2(250.0, 120.0), slack: 2.0).is_none())
}

@test
fn a_line_crosses_a_rectangle_only_where_it_passes_through() {
    let r = Rect::new(x: 10.0, y: 10.0, w: 20.0, h: 20.0)
    assert(crosses(vec2(0.0, 20.0), vec2(40.0, 20.0), r), "straight through")
    assert(crosses(vec2(15.0, 15.0), vec2(16.0, 16.0), r), "inside")
    assert(!crosses(vec2(0.0, 0.0), vec2(40.0, 5.0), r), "above it")
    assert(!crosses(vec2(0.0, 65.0), vec2(65.0, 0.0), r), "past its corner")
    assert(crosses(vec2(0.0, 35.0), vec2(35.0, 0.0), r), "across its corner")
}

@test
fn a_frame_holds_what_is_inside_it_and_lies_under_it() {
    var b = Board::new()
    let f = b.add(Item::new(Kind::Frame, vec2(0.0), vec2(400.0, 300.0), color: 7))
    let inner = b.add(Item::new(Kind::Note, vec2(50.0), vec2(100.0), color: 0))
    let across = b.add(Item::new(Kind::Box, vec2(350.0, 50.0), vec2(100.0), color: 0))
    assert(b.inside(f) == Vec::from([inner]), "the note, not the box across its edge")
    // Frames lie under everything: the note is hit over it; its empty space and its title hit it.
    assert(b.hit(vec2(100.0), slack: 0.0) == Some(inner))
    assert(b.hit(vec2(20.0, 250.0), slack: 0.0) == Some(f))
    assert(b.hit(vec2(20.0, -10.0), slack: 0.0) == Some(f), "its title")
    // A marquee inside it takes the note, not the frame; one round it takes both.
    assert(b.touching(Rect::new(x: 40.0, y: 40.0, w: 200.0, h: 200.0)) == Vec::from([inner]))
    assert(
        b.touching(Rect::new(x: -10.0, y: -10.0, w: 420.0, h: 320.0)) ==
            Vec::from([f, inner, across]),
    )
    assert(b.with_contents([f, across]) == Vec::from([f, inner, across]))
}

@test
fn triangles_and_pills_are_hit_where_they_are_drawn() {
    var t = Item::new(Kind::Triangle, vec2(0.0), vec2(100.0), color: 0)
    assert(t.holds(vec2(50.0, 60.0), slack: 0.0), "inside")
    assert(!t.holds(vec2(5.0, 10.0), slack: 0.0), "the empty top left corner")
    // A connector from its middle straight left meets its left slope.
    let e = t.edge(vec2(-100.0, 50.0))
    assert(abs(e.x - 25.0) < 1.0e-3 && abs(e.y - 50.0) < 1.0e-3, f"{e.x}, {e.y}")
    assert(t.side(vec2(-1.0, 0.0)) == vec2(25.0, 50.0))
    t.kind = Kind::Pill
    t.size = vec2(200.0, 60.0)
    assert(
        t.holds(vec2(100.0, 5.0), slack: 0.0) && !t.holds(vec2(3.0, 3.0), slack: 0.0),
        "its rounded end",
    )
}

@test
fn a_group_is_selected_whole_and_pasted_as_a_new_one() {
    var b = Board::new()
    let a = b.add(Item::new(Kind::Note, vec2(0.0), vec2(NOTE), color: 0))
    let c = b.add(Item::new(Kind::Box, vec2(300.0, 0.0), vec2(100.0), color: 4))
    let d = b.add(Item::new(Kind::Box, vec2(600.0, 0.0), vec2(100.0), color: 4))
    var link = Item::new(Kind::Link, vec2(0.0), vec2(0.0), color: 7)
    link.from = a
    link.to = c
    let l = b.add(take link)
    for i in 0..b.items.len() {
        if b.items[i].id != d { b.items[i].group = 9 }
    }
    assert(b.with_groups([c]) == Vec::from([c, a, l]), "one of a group brings the rest")
    assert(b.with_groups([d]) == Vec::from([d]), "an item in no group comes alone")
    assert(b.groups([a, c, d]) == Vec::from([9]))
    let items = Vec::from([b.items[0].clone(), b.items[1].clone(), b.items[3].clone()])
    let copies = b.paste(items, vec2(24.0))
    assert(copies.len() == 3)
    let g = b.items[b.index(copies[0]).unwrap()].group
    assert(g != 0 && g != 9, f"the copies' group is new: {g}")
    assert(b.members(g) == copies, "the copies, their connector too, are one group")
}

@test
fn arranging_lines_up_edges_and_shares_gaps() {
    var b = Board::new()
    let a = b.add(Item::new(Kind::Box, vec2(0.0, 0.0), vec2(100.0, 50.0), color: 4))
    let c = b.add(Item::new(Kind::Box, vec2(150.0, 40.0), vec2(40.0, 40.0), color: 4))
    let d = b.add(Item::new(Kind::Box, vec2(400.0, 10.0), vec2(60.0, 20.0), color: 4))
    let rect = |b: Board, id: u32| -> Rect { b.items[b.index(id).unwrap()].rect() }
    var right = b.clone()
    right.arrange([a, c, d], Align::Right)
    assert(
        rect(right, a).right() == 460.0 &&
            rect(right, c).right() == 460.0 &&
            rect(right, d).x == 400.0,
    )
    var middle = b.clone()
    middle.arrange([a, c, d], Align::Middle)
    // From y 0 to 80: middles at 40.
    assert(rect(middle, a).center().y == 40.0 && rect(middle, d).center().y == 40.0)
    // 460 across holds 200 of boxes: two gaps of 130, the outer two staying.
    var spread = b.clone()
    spread.arrange([d, a, c], Align::Across)
    assert(
        rect(spread, a).x == 0.0 && rect(spread, c).x == 230.0 && rect(spread, d).x == 400.0,
        f"{rect(spread, c).x}",
    )
    // A group lines up whole, and a locked item stays.
    var grouped = b.clone()
    for i in 0..grouped.items.len() {
        if grouped.items[i].id != d { grouped.items[i].group = 7 }
    }
    grouped.arrange([a, c, d], Align::Top)
    assert(rect(grouped, a).y == 0.0 && rect(grouped, c).y == 40.0 && rect(grouped, d).y == 0.0)
    var locked = b.clone()
    locked.items[0].locked = true
    locked.arrange([a, c], Align::Left)
    assert(rect(locked, a).x == 0.0 && rect(locked, c).x == 0.0)
}

@test
fn an_item_scales_about_a_point() {
    var pen = Item::new(Kind::Pen, vec2(10.0, 20.0), vec2(0.0), color: 7)
    pen.points = Vec::from([vec2(0.0), vec2(4.0, -2.0)])
    let half = pen.scaled(vec2(0.0), 0.5, words: 0.0)
    assert(half.at == vec2(5.0, 10.0) && half.points[1] == vec2(2.0, -1.0) && half.type_size == 0.0)
    let text = Item::new(Kind::Text, vec2(100.0), vec2(200.0, 30.0), color: 7)
    let twice = text.scaled(vec2(100.0, 0.0), 2.0, words: 20.0)
    assert(
        twice.at == vec2(100.0, 200.0) &&
            twice.size == vec2(400.0, 60.0) &&
            twice.type_size == 40.0,
    )
}

@test
fn a_new_item_beside_another_skips_what_is_in_the_way() {
    var b = Board::new()
    let a = b.add(Item::new(Kind::Note, vec2(0.0), vec2(NOTE), color: 2))
    let _ = b.add(Item::new(Kind::Box, vec2(260.0, 0.0), vec2(NOTE), color: 4))
    let right = b.beside(a, vec2(1.0, 0.0)).unwrap()
    assert(right.kind == Kind::Note && right.color == 2 && right.text.is_empty())
    assert(right.at == vec2(520.0, 0.0), f"{right.at.x}, {right.at.y}")
    assert(b.beside(a, vec2(0.0, 1.0)).unwrap().at == vec2(0.0, 260.0))
}
