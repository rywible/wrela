// Spike 01's grazer (design-archive-2026-10: spikes/01-grazer, grazer.js and field.wgsl),
// written through the engine's creature API (#43 §12): its 29 bones, its 20 parts on them in its
// fold order (torso, neck, head, tail, the legs' twelve segments, the four hooves),
// smooth-unioned over 6 cm times its scale; the torso's fbm, filtered by the footprint as the
// spike's octaves fade; its two channels, torso-ness and hoof-ness; and skin bindings that give
// the spike's weights. Its numbers come from its seed as grazer.js draws them: mulberry32 seeded
// with seed × 7919 + 17, five draws, computed in f64 and rounded once.

use engine::creature::{
    Body, Bone, Creature, CreatureField, Placed, Segment, Skeleton, Then, along, creature, split,
}
use engine::rng::{Rng, seed}
use std::derive::{Box3, Interval}
use std::field::{
    Blend, Displace, Ellipsoid, HalfSpace, Intersect, Noise, RoundCone, SmoothUnion, Surface,
    Translate, With, ellipsoid, half_space, round_cone, value_noise,
}
use std::units::{kg, m}

/// What a point of the grazer carries: how much it's torso (dappled hide) and how much hoof.
/// Everything else is plain hide.
pub struct Tissue: Copy + GpuData + Blend {
    pub torso: f32,
    pub hoof: f32,
}

const HIDE = Tissue { torso: 0.0, hoof: 0.0 }
const TORSO_HIDE = Tissue { torso: 1.0, hoof: 0.0 }
const HOOF = Tissue { torso: 0.0, hoof: 1.0 }

/// Its density, kg/m³ (sketch 01 §1): hide and hoof.
pub const HIDE_DENSITY: f32 = 1050 * kg / m ** 3
pub const HOOF_DENSITY: f32 = 1300 * kg / m ** 3

/// The torso's bark: fbm of value noise, `octaves` of them from `freq`, each half the last's
/// amplitude, sampled at `p + offset`. Seen a footprint wide, an octave whose period is under
/// two to four footprints fades out, and finer ones are skipped (spike 01's `fbm_d`, D-077).
pub struct Bark: Copy + GpuData {
    pub freq: f32,
    pub octaves: u32,
    pub offset: vec3,
}

/// How much of an octave of frequency `freq` a footprint `fp` wide sees.
fn octave_weight(fp: f32, freq: f32) -> f32 {
    1.0 - smoothstep(0.25, 0.5, fp * freq)
}

impl Noise for Bark {
    fn value(self, p: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..self.octaves {
            s += a * value_noise(q * fr + f32(o) * 17.0)
            a *= 0.5
            fr *= 2.0
        }
        s
    }

    /// The octaves' amplitudes add up to 2 − 2^(1 − octaves).
    fn range(self) -> Interval {
        var r = 0.0
        var a = 1.0
        for _o in 0..self.octaves {
            r += a
            a *= 0.5
        }
        Interval { lo: -r, hi: r }
    }

    /// Each octave's gradient is at most its amplitude times its frequency (`freq` for each)
    /// times value noise's bound.
    fn lipschitz(self) -> f32 {
        f32(self.octaves) * abs(self.freq) * std::field::VALUE_NOISE_LIPSCHITZ
    }

    fn bandlimit(self) -> f32 {
        if self.octaves == 0 { 0.0 } else { abs(self.freq) * exp2(f32(self.octaves - 1)) }
    }

    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        let fp = footprint.x
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..self.octaves {
            let w = a * octave_weight(fp, fr)
            if w <= 0.0 {
                break
            }
            s += w * value_noise(q * fr + f32(o) * 17.0)
            a *= 0.5
            fr *= 2.0
        }
        s
    }
}

// ---- the spike's makeGrazer, in f64 --------------------------------------------------------------

/// A point in f64 (vectors are f32), for the same numbers as JavaScript's.
pub struct P3: Copy {
    pub x: f64,
    pub y: f64,
    pub z: f64,
}

pub fn p3(x: f64, y: f64, z: f64) -> P3 {
    P3 { x, y, z }
}

fn add(a: P3, b: P3) -> P3 {
    P3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

fn scl(a: P3, s: f64) -> P3 {
    P3 { x: a.x * s, y: a.y * s, z: a.z * s }
}

/// A point rounded to f32, once.
fn v(a: P3) -> vec3 {
    vec3(f32(a.x), f32(a.y), f32(a.z))
}

/// The bones, in the spike's order.
pub const PELVIS: u32 = 0
pub const CHEST: u32 = 1
pub const NECK0: u32 = 2
pub const HEAD: u32 = 6
pub const TAIL0: u32 = 7
pub const LEG0: u32 = 13
pub const BONES: u32 = 29

/// The rest skeleton at scale 1, in metres: +y up, +z forward (grazer.js's `restSkeleton`).
fn rest_joints() -> [P3; 29] {
    var j = [p3(x: 0.0, y: 0.0, z: 0.0); 29]
    j[0] = p3(x: 0.0, y: 1.3m, z: 0.0)
    j[1] = p3(x: 0.0, y: 1.3m, z: 1m)
    let neck_base = p3(x: 0.0, y: 1.5m, z: 1.55m)
    let neck_span = p3(x: 0.0, y: 55cm, z: 45cm)
    for i in 0..4 {
        j[2 + i] = add(neck_base, scl(neck_span, f64(i) / 4.0))
    }
    j[6] = add(add(neck_base, neck_span), p3(x: 0.0, y: 0.0, z: 12cm))
    let tail_base = p3(x: 0.0, y: 1.45m, z: -40cm)
    let tail_span = p3(x: 0.0, y: -55cm, z: -45cm)
    for i in 0..6 {
        j[7 + i] = add(tail_base, scl(tail_span, f64(i) / 6.0))
    }
    let fore = [
        p3(x: 0.0, y: -45cm, z: -4cm),
        p3(x: 0.0, y: -42cm, z: 3cm),
        p3(x: 0.0, y: -20cm, z: 2cm),
    ]
    let hind = [
        p3(x: 0.0, y: -50cm, z: 10cm),
        p3(x: 0.0, y: -45cm, z: -12cm),
        p3(x: 0.0, y: -22cm, z: 0.0),
    ]
    let hips = [
        p3(x: 25cm, y: 1.15m, z: 1.25m),
        p3(x: -25cm, y: 1.15m, z: 1.25m),
        p3(x: 25cm, y: 1.25m, z: 5cm),
        p3(x: -25cm, y: 1.25m, z: 5cm),
    ]
    for l in 0..4 {
        var p = hips[l]
        j[13 + l * 4] = p
        for k in 0..3 {
            p = add(p, if l < 2 { fore[k] } else { hind[k] })
            j[14 + l * 4 + k] = p
        }
    }
    j
}

/// One individual's numbers (grazer.js's `makeGrazer`): its build and scale, its joints, and
/// what its parts are made of.
pub struct Params: Copy {
    pub bulk: f64,
    pub scale: f64,
    pub joints: [P3; 29],
    /// The fbm's offset.
    pub offset: P3,
}

pub fn params(seed_value: u32) -> Params {
    var r = Rng::new(seed(seed_value))
    let bulk = 0.9 + 0.25 * r.next()
    let s = 0.92 + 0.16 * r.next()
    let rest = rest_joints()
    var joints = [p3(x: 0.0, y: 0.0, z: 0.0); 29]
    for i in 0..29 {
        joints[i] = scl(rest[i], s)
    }
    let ox = 100.0 * r.next()
    let oy = 100.0 * r.next()
    let oz = 100.0 * r.next()
    Params { bulk, scale: s, joints, offset: p3(ox, oy, oz) }
}

/// A box in f64.
struct Bounds: Copy {
    lo: P3,
    hi: P3,
}

fn grow(b: Bounds, c: P3, r: P3) -> Bounds {
    Bounds {
        lo: p3(min(b.lo.x, c.x - r.x), min(b.lo.y, c.y - r.y), min(b.lo.z, c.z - r.z)),
        hi: p3(max(b.hi.x, c.x + r.x), max(b.hi.y, c.y + r.y), max(b.hi.z, c.z + r.z)),
    }
}

/// A point and a radius rounded to f32 and back, as the spike's bounds read them from its
/// `Float32Array`.
fn f(x: f64) -> f64 {
    f64(f32(x))
}

fn fp3(a: P3) -> P3 {
    p3(f(a.x), f(a.y), f(a.z))
}

/// A round cone's bounds: each end grown by the larger radius.
fn grow_cone(b: Bounds, a: P3, ra: f64, c: P3, rc: f64) -> Bounds {
    let r = max(f(ra), f(rc))
    grow(grow(b, fp3(a), p3(r, r, r)), fp3(c), p3(r, r, r))
}

/// The grazer's rest-space bounds, as grazer.js's `bounds` makes them: each part's own bounds,
/// padded for the blend.
pub fn bounds(g: Params) -> Box3 {
    let s = g.scale
    let j = g.joints
    var b = Bounds { lo: p3(x: 1e300, y: 1e300, z: 1e300), hi: p3(x: -1e300, y: -1e300, z: -1e300) }
    let amp = f(3mm) * 1.875
    let t = torso_parts(g)
    let (c1, r1, c2, r2) = t
    b = grow(b, fp3(c1), p3(f(r1.x) + amp, f(r1.y) + amp, f(r1.z) + amp))
    b = grow(b, fp3(c2), p3(f(r2.x) + amp, f(r2.y) + amp, f(r2.z) + amp))
    let h = j[HEAD]
    b = grow(
        b,
        fp3(add(h, scl(p3(x: 0.0, y: -4cm, z: 10cm), s))),
        fp3(scl(p3(x: 12cm, y: 15cm, z: 24cm), s)),
    )
    b = grow_cone(
        b,
        add(h, scl(p3(x: 0.0, y: -5cm, z: 15cm), s)),
        10cm * s,
        add(h, scl(p3(x: 0.0, y: -16cm, z: 42cm), s)),
        6.5cm * s,
    )
    let neck_end = add(j[NECK0], scl(p3(x: 0.0, y: 55cm, z: 45cm), s))
    b = grow_cone(b, j[NECK0], 22cm * s * g.bulk, neck_end, 12cm * s)
    b = grow_cone(
        b,
        j[TAIL0],
        7cm * s,
        add(j[TAIL0], scl(p3(x: 0.0, y: -55cm, z: -45cm), s)),
        2.5cm * s,
    )
    let radii = [(10cm * g.bulk, 6.5cm), (6.5cm, 4.8cm), (4.8cm, 4.2cm)]
    for l in 0..4 {
        let bone = LEG0 + l * 4
        for k in 0..3 {
            let (top, bottom) = radii[k]
            b = grow_cone(b, j[bone + k], top * s, j[bone + k + 1], bottom * s)
        }
    }
    for l in 0..4 {
        let foot = j[LEG0 + l * 4 + 3]
        b = grow_cone(b, foot, 6cm * s, add(foot, p3(0.0, -8cm * s, 0.0)), 7cm * s)
    }
    let pad = f(6cm * s) * 0.25
    Box3 {
        lo: vec3(f32(b.lo.x - pad), f32(b.lo.y - pad), f32(b.lo.z - pad)),
        hi: vec3(f32(b.hi.x + pad), f32(b.hi.y + pad), f32(b.hi.z + pad)),
    }
}

/// The torso's two ellipsoids: their centres and radii.
fn torso_parts(g: Params) -> (P3, P3, P3, P3) {
    let s = g.scale
    let c = g.joints[CHEST]
    let sb = s * g.bulk
    (
        add(c, scl(p3(x: 0.0, y: 5cm, z: -15cm), s)),
        scl(p3(x: 42cm, y: 48cm, z: 80cm), sb),
        add(c, scl(p3(x: 0.0, y: 5cm, z: -85cm), s)),
        scl(p3(x: 38cm, y: 44cm, z: 50cm), sb),
    )
}

// ---- the creature ---------------------------------------------------------------------------------

pub type Torso = With<Displace<SmoothUnion<Translate<Ellipsoid>, Translate<Ellipsoid>>, Bark>, Tissue>

pub type Cone = With<RoundCone, Tissue>

pub type Head = With<SmoothUnion<Translate<Ellipsoid>, RoundCone>, Tissue>

pub type Hoof = With<Intersect<RoundCone, HalfSpace>, Tissue>

pub type Parts = Then<Then<Then<Then<Placed<Torso>, Placed<Cone>>, Placed<Head>>, Placed<Cone>>, Then<[Placed<Cone>; 12], [Placed<Hoof>; 4]>>

/// A grazer's field: what the renderer and the physique read.
pub type GrazerField = CreatureField<Parts>

/// The grazer of seed `seed_value`.
pub fn grazer(seed_value: u32) -> Body<Parts> {
    let g = params(seed_value)
    let s = g.scale
    let j = g.joints
    // The skeleton: pelvis, chest, four neck joints, the head, six tail joints, four legs.
    var sk = Skeleton::new()
    let pelvis = sk.root("pelvis", v(j[PELVIS]))
    let chest = sk.joint("chest", pelvis, v(j[CHEST]))
    let neck = sk.chain(
        "neck",
        chest,
        v(j[NECK0]) - v(j[CHEST]),
        4,
        v(scl(p3(x: 0.0, y: 55cm, z: 45cm), s)),
    )
    let head = sk.joint("head", neck.last(), v(j[HEAD]))
    let tail = sk.chain(
        "tail",
        pelvis,
        v(j[TAIL0]) - v(j[PELVIS]),
        6,
        v(scl(p3(x: 0.0, y: -55cm, z: -45cm), s)),
    )
    let names = [
        ["fore left hip", "fore left knee", "fore left ankle", "fore left foot"],
        ["fore right hip", "fore right knee", "fore right ankle", "fore right foot"],
        ["hind left hip", "hind left knee", "hind left ankle", "hind left foot"],
        ["hind right hip", "hind right knee", "hind right ankle", "hind right foot"],
    ]
    for l in 0..4 {
        let b = LEG0 + l * 4
        let parent = if l < 2 { chest } else { pelvis }
        let _ = sk.leg_at(names[l], parent, [v(j[b]), v(j[b + 1]), v(j[b + 2]), v(j[b + 3])])
    }

    // Torso: two ellipsoids, smooth-unioned (k 15 cm), displaced by fbm; on the pelvis, its
    // weight split from pelvis to chest along z.
    let at = v(j[PELVIS])
    let (c1, r1, c2, r2) = torso_parts(g)
    let torso = ellipsoid(v(r1))
        .translate(v(c1) - at)
        .smooth_union(ellipsoid(v(r2)).translate(v(c2) - at), k: f32(15cm * s))
        .displace(Bark { freq: 25.0, octaves: 4, offset: v(g.offset) + at }, amp: 3mm)
        .with(TORSO_HIDE)
    let z_pelvis = vec3(0.0, 0.0, f32(j[PELVIS].z))
    let z_chest = vec3(0.0, 0.0, f32(j[CHEST].z))

    // Neck: a round cone along the neck chain's span.
    let n0 = v(j[NECK0])
    let neck_end = v(add(j[NECK0], scl(p3(x: 0.0, y: 55cm, z: 45cm), s)))
    let neck_part = round_cone(
        vec3(),
        neck_end - n0,
        r_top: f32(22cm * s * g.bulk),
        r_bottom: f32(12cm * s),
    )
        .with(HIDE)

    // Head: an ellipsoid smooth-unioned with a muzzle cone (k 5 cm).
    let h = j[HEAD]
    let hv = v(h)
    let head_part = ellipsoid(v(scl(p3(x: 12cm, y: 15cm, z: 24cm), s)))
        .translate(v(add(h, scl(p3(x: 0.0, y: -4cm, z: 10cm), s))) - hv)
        .smooth_union(
            round_cone(
                v(add(h, scl(p3(x: 0.0, y: -5cm, z: 15cm), s))) - hv,
                v(add(h, scl(p3(x: 0.0, y: -16cm, z: 42cm), s))) - hv,
                r_top: f32(10cm * s),
                r_bottom: f32(6.5cm * s),
            ),
            k: f32(5cm * s),
        )
        .with(HIDE)

    // Tail: a round cone along the tail chain's span.
    let t0 = v(j[TAIL0])
    let tail_end = v(add(j[TAIL0], scl(p3(x: 0.0, y: -55cm, z: -45cm), s)))
    let tail_part = round_cone(
        vec3(),
        tail_end - t0,
        r_top: f32(7cm * s),
        r_bottom: f32(2.5cm * s),
    )
        .with(HIDE)

    let bulk = g.bulk
    creature(sk)
        .join("torso", pelvis, torso, skin: split(pelvis, chest, a: z_pelvis, b: z_chest))
        .join("neck", neck.first(), neck_part, skin: along(neck, a: n0, b: neck_end))
        .join("head", head, head_part)
        .join("tail", tail.first(), tail_part, skin: along(tail, a: t0, b: tail_end))
        // Legs: three round cones each, then a hoof (a round cone below the sole's plane).
        .each_leg(|leg| {
            leg.fill(|seg: Segment| {
                let (top, bottom) = if seg.index == 0 { (10cm * bulk, 6.5cm) } else if seg.index ==
                    1 {
                    (6.5cm, 4.8cm)
                } else { (4.8cm, 4.2cm) }
                round_cone(vec3(), seg.end, r_top: f32(top * s), r_bottom: f32(bottom * s)).with(
                    HIDE,
                )
            })
                .foot(
                    round_cone(
                        vec3(),
                        vec3(0.0, f32(-8cm * s), 0.0),
                        r_top: f32(6cm * s),
                        r_bottom: f32(7cm * s),
                    )
                        .intersect(half_space(vec3(0.0, -1.0, 0.0), f32(7cm * s)))
                        .with(HOOF),
                )
        })
        .blend(f32(6cm * s))
        .bounded(bounds(g))
}

/// Its density where its channels are `c`: hide, and hoof where it's hoof.
pub fn density(c: Tissue) -> f32 {
    mix(HIDE_DENSITY, HOOF_DENSITY, c.hoof)
}
