// The tool tests: each builds this package (a normal build), loads it on the machine's hardware
// GPU (never a software renderer), calls its exports, and reads the mesh they realized back from
// the program's newest eight buffers: the vertices' count and items, the quads' count and items,
// the draw's and the skin pass's arguments, the holes and the tally. A mesh is compared by its
// counts and its triangles, each as its corners' bits from its lowest corner on (so the
// vertices' order in the buffer, which slices change, doesn't matter, but the winding does),
// sorted.

use hosts::steps::{built, word}
use std::io::print
use std::tool::MOST_BYTES
use std::tool::blob
use std::tool::blob::Data
use std::tool::drive
use std::tool::drive::{Scalar, Step}
use std::tool::toolchain

/// A mesh's buffers, in the order `Mesh::new` makes them.
const MESH_BUFFERS: u32 = 8

/// The draw's arguments and the tally, among the mesh's buffers.
const PARTS: [u32; 2] = [4, 7]

/// The cells the grazer is realized at, the slices it's spread over, and the slab's.
const CELLS: [f32; 2] = [0.03, 0.015]
const SLICES: [u32; 3] = [1, 5, 40]
const SLAB_SLICES: [u32; 2] = [0, 2]

/// The bytes of a vertex in the vertices' buffer; its position is its first three floats.
const VERTEX_BYTES: u32 = 48

/// A triangle: its corners' bits, from its lowest corner on.
struct Tri: Copy {
    k: [u32; 9],
}

/// Whether `a` sorts before `b`, word by word.
fn before(a: Tri, b: Tri) -> bool {
    for i in 0..9 {
        if a.k[i] != b.k[i] {
            return a.k[i] < b.k[i]
        }
    }
    false
}

/// A realized mesh: its live blocks, triangles, holes and flags, and its triangles, sorted.
struct Ours {
    live: u32,
    tris: u32,
    holes: u32,
    flags: u32,
    sorted: Vec<Tri>,
}

/// The package, built into `scratch/build`, loaded on the GPU, `init` run.
fn opened() -> drive::Build {
    built(
        "repo/examples/herd/tests/realize",
        "scratch/build",
        toolchain::options(),
        "the package builds",
    )
    let Ok(it) = drive::load("scratch/build", drive::gpu()).wait() else {
        panic("the build loads on a hardware GPU")
    }
    let Ok(seen) = drive::steps(it.build, [Step::Init]).wait() else { panic("init's request") }
    if let Some(trap) = seen.trap {
        panic(trap.message.as_str())
    }
    it.build
}

/// The first `most` bytes (all, for 0) of a buffer's bytes, read from their blob, which is
/// released.
fn bytes_of(data: take Data, most: u64) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    match take data {
        Data::Bytes(v) => {
            let n = if most == 0 { v.len() } else { min(v.len(), u32(most)) }
            for j in 0..n {
                out.push(v[j])
            }
        },
        Data::Blob(held) => {
            let Ok(size) = blob::len(held).wait() else { panic("the blob's length") }
            let want = if most == 0 { size } else { min(size, most) }
            var at: u64 = 0
            while at < want {
                let len = u32(min(want - at, u64(MOST_BYTES)))
                let Ok(chunk) = blob::read(held, at, len).wait() else { panic("the blob's bytes") }
                for j in 0..chunk.len() {
                    out.push(chunk[j])
                }
                at += u64(len)
            }
            let _ = blob::release(held).wait()
        },
    }
    out
}

/// The export `name` called with `args`, which must not trap; then the mesh it realized, from
/// the newest eight buffers.
fn realized(h: drive::Build, name: str, args: take Vec<Scalar>) -> Ours {
    let Ok(called) = drive::steps(h, [Step::Call(String::from(name), take args), Step::Buffers])
        .wait() else { panic(f"{name}'s request") }
    if let Some(trap) = called.trap {
        panic(f"{name}: {trap.message.as_str()}")
    }
    borrow held = called.buffers[0]
    assert(held.len() >= MESH_BUFFERS, "the mesh's buffers")
    let first = held.len() - MESH_BUFFERS
    // The draw's arguments, the tally, the vertices and the quads: the first two say how much
    // of the others to read.
    let Ok(read) = drive::steps(
        h,
        [
            Step::ReadBuffer(held[first + PARTS[0]]),
            Step::ReadBuffer(held[first + PARTS[1]]),
            Step::ReadBuffer(held[first + 1]),
            Step::ReadBuffer(held[first + 3]),
        ],
    ).wait() else { panic("the mesh's buffers' bytes") }
    var bytes = take read.bytes
    let args = bytes_of(bytes.remove(0), 0)
    let tally = bytes_of(bytes.remove(0), 0)
    let draw = word(args, 0)
    let (nv, holes, flags, live) = (word(tally, 0), word(tally, 4), word(tally, 8), word(tally, 20))
    let verts = bytes_of(bytes.remove(0), u64(nv) * u64(VERTEX_BYTES))
    let quads = bytes_of(bytes.remove(0), u64(draw) * 4)
    var sorted: Vec<Tri> = Vec::with_capacity(draw / 3)
    for t in 0..draw / 3 {
        var corners = [[0; 3]; 3]
        for k in 0..3 {
            let index = word(quads, 4 * (3 * t + k))
            assert(index < nv, f"triangle {t} names vertex {index} of {nv}")
            for c in 0..3 {
                corners[k][c] = word(verts, index * VERTEX_BYTES + 4 * c)
            }
        }
        // The lowest corner, the first of equal ones.
        var low = 0
        for k in 1..3 {
            let (a, b) = (corners[k], corners[low])
            if a[0] < b[0] || (a[0] == b[0] && (a[1] < b[1] || (a[1] == b[1] && a[2] < b[2]))) {
                low = k
            }
        }
        var key = [0; 9]
        for k in 0..3 {
            let corner = corners[(low + k) % 3]
            for c in 0..3 {
                key[3 * k + c] = corner[c]
            }
        }
        sorted.push(Tri { k: key })
    }
    sorted.sort_by(before)
    Ours { live, tris: draw / 3, holes, flags, sorted }
}

/// Whether two meshes' sorted triangles are the same.
fn same_triangles(a: Ours, b: Ours) -> bool {
    if a.sorted.len() != b.sorted.len() {
        return false
    }
    for i in 0..a.sorted.len() {
        if before(a.sorted[i], b.sorted[i]) || before(b.sorted[i], a.sorted[i]) {
            return false
        }
    }
    true
}

/// A `Realizer` spreads a level change over frames (`record_vertices` a slice at a time): the
/// mesh is the one a whole realization makes, triangle for triangle, at 3 and 1.5 cm, in 1, 5
/// and 40 slices (40: most are past the live blocks' end, and empty).
@test(tool, read: [("repo", "../../../..")], budget: 600)
fn a_realization_in_slices_is_the_whole_ones() {
    let b = opened()
    for c in 0..2 {
        let cell = CELLS[c]
        var args: Vec<Scalar> = Vec::new()
        args.push(Scalar::I32(1))
        args.push(Scalar::F32(cell))
        let want = realized(b, "realize", take args)
        assert(want.tris > 1000 && want.holes == 0 && want.flags == 0, f"{cell} m: whole")
        for n in 0..3 {
            let slices = SLICES[n]
            var sargs: Vec<Scalar> = Vec::new()
            sargs.push(Scalar::I32(1))
            sargs.push(Scalar::F32(cell))
            sargs.push(Scalar::I32(i32(slices)))
            let sliced = realized(b, "realize_sliced", take sargs)
            assert(
                sliced.live == want.live &&
                    sliced.tris == want.tris &&
                    sliced.holes == want.holes &&
                    sliced.flags == want.flags,
                f"{cell} m in {slices} slices: {sliced.live} live, {sliced.tris} triangles, {sliced.holes} holes, {sliced.flags} flags; whole {want.live}, {want.tris}, {want.holes}, {want.flags}",
            )
            assert(
                same_triangles(sliced, want),
                f"{cell} m in {slices} slices: the triangles differ",
            )
        }
        print(f"{cell} m: {want.tris} triangles, the same in 1, 5 and 40 slices")
    }
}

/// More live blocks than WebGPU dispatches workgroups along x (65,535): the slab, 750 × 750 × 3
/// cells, about 70,000 live blocks. Its passes go in chunks, so its mesh is whole: a quad for
/// each lattice edge its faces cross (2 × 750² + 4 × 750 × 3), no holes, and the same triangles
/// in 2 slices (the second past 65,535 blocks on its own). It can't be smaller.
@test(tool, read: [("repo", "../../../..")], budget: 600, blobs: "512M,64")
fn a_realization_past_65535_live_blocks_is_whole() {
    let b = opened()
    var meshes: Vec<Ours> = Vec::new()
    for n in 0..2 {
        let slices = SLAB_SLICES[n]
        var args: Vec<Scalar> = Vec::new()
        args.push(Scalar::I32(i32(slices)))
        meshes.push(realized(b, "realize_slab", take args))
    }
    let Some(sliced) = meshes.pop() else { panic("the sliced mesh") }
    let Some(whole) = meshes.pop() else { panic("the whole mesh") }
    let quads = 2 * 750 * 750 + 4 * 750 * 3
    assert(whole.live > 65535, f"only {whole.live} live blocks")
    assert(
        whole.tris == 2 * quads && whole.holes == 0 && whole.flags == 0,
        f"{whole.tris} triangles, {whole.holes} holes, {whole.flags} flags",
    )
    assert(
        sliced.live == whole.live &&
            sliced.tris == whole.tris &&
            sliced.holes == whole.holes &&
            sliced.flags == whole.flags,
        "the counts differ in 2 slices",
    )
    assert(same_triangles(sliced, whole), "the triangles differ in 2 slices")
    print(f"{whole.live} live blocks, {whole.tris} triangles")
}
