// The program under test: the herd's grazers realized one at a time, at any cell size, by the
// engine's `record` (#42 AC2), into a mesh with room for the most its grid could hold, so
// nothing overflows; and a slab whose faces cross more live blocks than WebGPU dispatches
// workgroups along x. tests.wrela builds it, calls its exports and reads the mesh's buffers back
// (the newest the program holds: the vertices' count and items, the quads' count and items, the
// draw's and the skin pass's arguments, the holes and the tally).

use engine::creature::{Creature, Parts, Skeleton, creature}
use engine::stone::Rock
use engine::realize::{Grid, Mesh, Room, Scratch, record, record_cull, record_finish, record_slice}
use herd::grazer::{FALLOFF, Grazer, grazer}
use std::derive::Box3
use std::field::cuboid

pub struct Game {
    scratch: Scratch,
    mesh: Mesh,
}

pub fn init() -> Game {
    Game {
        scratch: Scratch::new(1),
        mesh: Mesh::new(Room { vertices: 1, quads: 1 }),
    }
}

/// Seed `s` and its grid at `cell`, with a new mesh that has room for the most the grid could
/// hold: the scratch fitted first, so the mesh's buffers are the newest.
fn prepare(game: mut Game, s: u32, cell: f32) -> (Grazer, Grid) {
    let g = grazer(s)
    let grid = Grid::around(g.bounds(), cell)
    game.scratch.fit(grid.blocks)
    game.mesh = Mesh::new(Room { vertices: grid.blocks * 8, quads: grid.blocks * 8 })
    (g, grid)
}

/// Realizes seed `s` at `cell` into a mesh of its own: the mesh's buffers are the newest.
pub fn realize(game: mut Game, s: u32, cell: f32) {
    let (g, grid) = prepare(mut game, s, cell)
    record(g.field(), grid, FALLOFF, mut game.scratch, mut game.mesh)
}

/// Records `field` on `grid` as a `Realizer` spreads a level change over frames: its live blocks
/// culled, recorded in `slices` slices, then its mesh finished.
fn record_sliced<C, F: Parts<C>>(field: F, grid: Grid, slices: u32, game: mut Game) {
    record_cull(field, grid, mut game.scratch, mut game.mesh)
    for k in 0..slices {
        record_slice(
            field,
            grid,
            slice: k,
            slices: slices,
            scratch: mut game.scratch,
            mesh: mut game.mesh,
        )
    }
    record_finish(field, grid, FALLOFF, mut game.scratch, mut game.mesh)
}

/// Realizes seed `s` at `cell` as a `Realizer` spreads a level change over frames, in `slices`
/// slices of its live blocks, into a mesh of its own: the mesh's buffers are the newest.
pub fn realize_sliced(game: mut Game, s: u32, cell: f32, slices: u32) {
    let (g, grid) = prepare(mut game, s, cell)
    record_sliced(g.field(), grid, slices, mut game)
}

/// A slab 7.5 m square and 3 cm thick, a creature of one bone (at its centre).
fn slab() -> Creature<Rock> {
    var s = Skeleton::new()
    let root = s.root("slab", vec3(0.0))
    let half = vec3(3.75, 3.75, 0.015)
    // Its box grown by half a cell at 1 cm, so its faces lie halfway between the lattice's planes.
    creature(s)
        .part(root, cuboid(half).with_at(|p| Rock { albedo: vec3(0.5) }))
        .bounded(Box3 { lo: -half - vec3(5mm), hi: half + vec3(5mm) })
}

/// The slab realized at 1 cm: its faces cross more live blocks (about 70,000) than WebGPU
/// dispatches workgroups along x (65,535), so the passes over them go in chunks. Whole, or
/// (`slices` > 0) as a `Realizer` spreads it over frames, into a mesh of its own with room for
/// 1.25 million vertices and quads: the mesh's buffers are the newest.
pub fn realize_slab(game: mut Game, slices: u32) {
    let slab = slab()
    let grid = Grid::around(slab.bounds(), 1cm)
    game.scratch.fit(grid.blocks)
    game.mesh = Mesh::new(Room { vertices: 1250000, quads: 1250000 })
    let field = slab.field()
    if slices == 0 {
        record(field, grid, FALLOFF, mut game.scratch, mut game.mesh)
    } else {
        record_sliced(field, grid, slices, mut game)
    }
}

pub fn frame(game: mut Game, time: f32, width: u32, height: u32) {}

/// The package's tool, which does nothing: its tool tests are its work (tests.wrela).
pub fn tool() -> u32 {
    0
}
