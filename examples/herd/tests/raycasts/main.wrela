// The program under test: `compare` casts a ray at the herd's terrain (seed 7) with its own
// `raycast`, which reuses the height of a vertical ray's column, and with a plain march that
// doesn't, and gives both hits' bits and march counts. tests.wrela builds it and calls it.

use herd::terrain::Terrain

/// The march that `Terrain::raycast` keeps: 128 steps at most, each its distance and at least
/// 1 mm; a miss is -1.
fn reference(terrain: Terrain, from: vec3, dir: vec3, max_t: f32) -> (f32, u32) {
    var t = 0.0
    for i in 1..129 {
        let d = terrain.distance(from + dir * t)
        if d < 1mm {
            return (t, i)
        }
        t += max(d, 1mm)
        if t > max_t {
            return (-1.0, i)
        }
    }
    (-1.0, 128)
}

/// The terrain's ray and the reference's: each hit's bits and its march count.
pub fn compare(from: vec3, dir: vec3, max_t: f32) -> (u32, u32, u32, u32) {
    let terrain = Terrain::new(7)
    let (a, sa) = terrain.raycast(from, dir, max_t)
    let (b, sb) = reference(terrain, from, dir, max_t)
    (bitcast_u32(a), sa, bitcast_u32(b), sb)
}

pub fn frame(time: f32, width: u32, height: u32) {}

/// The package's tool, which does nothing: its tool test calls `compare` (tests.wrela).
pub fn tool() -> u32 {
    0
}
