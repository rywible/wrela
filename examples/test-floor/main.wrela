// A small floor behind the stair's second door (examples/stair), to test the way between builds:
// the player comes in through the door, can decide the floor's fate (a stand-in for its
// Warden's end: F frees it, P preserves it), and walks back out through the same door.
//
// Keys: W and S walk, A and D turn, E goes back through the door when the player is at it.

use engine::tower::{Fate, Journey, STAIR, Start}
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw}
use std::input::{Input, Key}

const TAU: f32 = 6.2831853

/// This floor's world in the tower, and the door to it.
const WORLD: u32 = 1
const WORLDS: u32 = 2
const STAIR_BUILD: Text = "../stair"
const SAVE: Text = "tower/save"

/// The player's pace (m/s), turn (radians a second) and eye height (m); the floor's radius.
const PACE: f32 = 3.0
const TURN: f32 = 1.8
const EYE: f32 = 1.6
const RADIUS: f32 = 14.0

pub struct Floor {
    journey: Journey,
    input: Input,
    /// Where the player stands, and which way they face (radians from +z towards +x).
    at: vec2,
    yaw: f32,
    last_time: f32,
}

pub fn init() -> Floor {
    // In through the door, which stands at the middle facing +z: the player steps out of it.
    Floor {
        journey: Journey::begin(WORLD, WORLDS, SAVE),
        input: Input::new(),
        at: vec2(0.0, 1.5),
        yaw: 0.0,
        last_time: 0.0,
    }
}

/// Whether the player is at the door: in front of it, within a step.
fn at_door(f: Floor) -> bool {
    length(f.at - vec2(0.0, 0.6)) < 1.2
}

/// Goes back out to the stair, if the player is at the door.
fn leave(f: mut Floor) {
    if at_door(f) {
        let _ = f.journey.go(WORLD, STAIR, STAIR_BUILD)
    }
}

struct Scene: Copy + GpuData {
    eye: vec3,
    forward: vec3,
    resolution: vec2,
    /// 0 undecided, 1 preserved, 2 freed: the light follows it.
    fate: f32,
}

fn fate_code(f: Floor) -> f32 {
    match f.journey.carry.tower.fate(WORLD) {
        Fate::Undecided => 0.0,
        Fate::Preserved => 1.0,
        Fate::Freed => 2.0,
    }
}

fn scene_of(f: Floor, width: u32, height: u32) -> Scene {
    Scene {
        eye: vec3(f.at.x, EYE, f.at.y),
        forward: normalize(vec3(sin(f.yaw), -0.08, cos(f.yaw))),
        resolution: vec2(f32(width), f32(height)),
        fate: fate_code(f),
    }
}

fn box(q: vec3, half: vec3) -> f32 {
    let d = abs(q) - half
    length(max(d, vec3(0.0))) + min(max(d.x, max(d.y, d.z)), 0.0)
}

/// The nearest surface's distance and what it is: 0 ground, 1 a pillar, 2 the door's frame, 3
/// the doorway.
fn scene_distance(p: vec3) -> vec2 {
    var best = vec2(max(p.y, length(p.xz) - RADIUS), 0.0)
    // Six pillars round the middle.
    let a = atan2(p.z, p.x)
    let sector = TAU / 6.0
    let k = floor(a / sector + 0.5)
    let c = vec2(cos(k * sector), sin(k * sector)) * 8.0
    let pillar = max(length(p.xz - c) - 0.45, p.y - 3.5)
    if pillar < best.x {
        best = vec2(pillar, 1.0)
    }
    let q = p - vec3(0.0, 1.15, 0.0)
    let frame = max(box(q, vec3(0.75, 1.3, 0.12)), -box(q, vec3(0.6, 1.15, 0.3)))
    if frame < best.x {
        best = vec2(frame, 2.0)
    }
    let doorway = box(q, vec3(0.6, 1.15, 0.03))
    if doorway < best.x {
        best = vec2(doorway, 3.0)
    }
    best
}

fn normal_at(p: vec3) -> vec3 {
    let h = 0.002
    normalize(
        vec3(
            scene_distance(p + vec3(x: h)).x - scene_distance(p - vec3(x: h)).x,
            scene_distance(p + vec3(y: h)).x - scene_distance(p - vec3(y: h)).x,
            scene_distance(p + vec3(z: h)).x - scene_distance(p - vec3(z: h)).x,
        ),
    )
}

fn shade_pixel(pixel: vec2, scene: Scene) -> vec4 {
    let uv = (pixel * 2.0 - scene.resolution) / scene.resolution.y
    let right = normalize(cross(scene.forward, vec3(y: 1.0)))
    let up = cross(right, scene.forward)
    let dir = normalize(scene.forward * 1.3 + right * uv.x - up * uv.y)
    // A preserved floor keeps its warm light; a freed one goes cold and pale.
    let warm = if scene.fate > 1.5 { 0.0 } else { 1.0 }
    let sky = mix(
        mix(vec3(0.72, 0.76, 0.8), vec3(0.95, 0.78, 0.55), warm),
        vec3(0.3, 0.4, 0.55),
        clamp(dir.y * 1.5, 0.0, 1.0),
    )
    var t = 0.02
    var hit = vec2(-1.0)
    var i = 0
    while i < 128 && hit.x < 0.0 && t < 60.0 {
        let d = scene_distance(scene.eye + dir * t)
        if d.x < 0.0008 * t {
            hit = vec2(t, d.y)
        } else {
            t += d.x * 0.9
        }
        i += 1
    }
    if hit.x < 0.0 {
        return vec4(sky, 1.0)
    }
    if hit.y > 2.5 {
        // The doorway: the stair's dark beyond.
        return vec4(0.02, 0.025, 0.04, 1.0)
    }
    let p = scene.eye + dir * t
    let n = normal_at(p)
    let sun_dir = normalize(vec3(0.5, 0.7, 0.3))
    let sun = mix(vec3(0.9, 0.92, 0.95), vec3(1.0, 0.85, 0.6), warm) * max(dot(n, sun_dir), 0.0)
    let albedo = if hit.y < 0.5 { vec3(0.42, 0.45, 0.32) } else if hit.y < 1.5 {
        vec3(0.6, 0.58, 0.54)
    } else { vec3(0.3, 0.26, 0.22) }
    let lit = albedo * (sun + sky * 0.35)
    let fog = exp(-0.02 * t)
    vec4(mix(sky, lit, fog), 1.0)
}

@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn shade(pixel: FragCoord, scene: Scene) -> vec4 {
    shade_pixel(pixel.position.xy, scene)
}

pub fn frame(f: mut Floor, time: f32, width: u32, height: u32) {
    let dt = clamp(time - f.last_time, 0.0, 0.1)
    f.last_time = time
    f.journey.update()
    f.input.read()
    borrow i = f.input
    let walk = (if i.held(Key::W) || i.held(Key::Up) { 1.0 } else { 0.0 })
    -(if i.held(Key::S) || i.held(Key::Down) { 1.0 } else { 0.0 })
    let turn = (if i.held(Key::D) { 1.0 } else { 0.0 }) - (if i.held(Key::A) { 1.0 } else { 0.0 })
    let pressed_e = i.pressed(Key::E)
    let pressed_f = i.pressed(Key::F)
    let pressed_p = i.pressed(Key::P)
    f.yaw += turn * TURN * dt
    step(mut f, walk * PACE * dt)
    if pressed_f {
        let _ = f.journey.decide(WORLD, Fate::Freed)
    }
    if pressed_p {
        let _ = f.journey.decide(WORLD, Fate::Preserved)
    }
    if pressed_e {
        leave(mut f)
    }
    // The way back is the stair: it's got ready while nothing of the floor's own waits.
    f.journey.prepare(Some(STAIR_BUILD), allowed: true)
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(screen, cover, shade.bind(scene: scene_of(f, width, height)), vertices: 3)
    screen.present()
}

/// Walks `metres` the way the player faces, staying on the floor and out of the door's frame.
fn step(f: mut Floor, metres: f32) {
    let next = f.at + vec2(sin(f.yaw), cos(f.yaw)) * metres
    if length(next) < RADIUS - 0.5 && scene_distance(vec3(next.x, 1.0, next.y)).x > 0.25 {
        f.at = next
    }
}

// ---- for tests and tools ----

/// Walks `metres` ahead.
pub fn walk(f: mut Floor, metres: f32) {
    step(mut f, metres)
}

/// Turns by `radians`.
pub fn turn(f: mut Floor, radians: f32) {
    f.yaw += radians
}

/// Goes back out through the door, if the player is at it.
pub fn go_out(f: mut Floor) {
    leave(mut f)
}

/// Where the player stands, how the floor started (`Start`'s order), and its fate.
pub fn report(f: Floor) -> vec4 {
    let start = match f.journey.start {
        Start::Fresh => 0.0,
        Start::Arrived => 1.0,
        Start::TurnedBack => 2.0,
        Start::Again => 3.0,
    }
    vec4(f.at.x, f.at.y, start, fate_code(f))
}

/// The pixel at (`x`, `y`), shaded on the CPU.
pub fn probe(f: Floor, x: f32, y: f32, width: u32, height: u32) -> vec4 {
    shade_pixel(vec2(x, y), scene_of(f, width, height))
}

/// Decides the floor's fate (1 preserved, 2 freed).
@testing
pub fn test_decide(f: mut Floor, fate: u32) {
    let _ = f.journey.decide(WORLD, if fate == 1 { Fate::Preserved } else { Fate::Freed })
}
