// The fight's sim alone (content/climber's `fight`), drawn as a map from above: 12 m across,
// round where the fight starts; the climber a square (lighter while it can't be hurt), the wolf
// one (redder as it crouches and lunges, darker when it's down). It sounds as the fight does
// (`climber::sounds`), heard from the climber.

use climber::fight::{Mood, World, present, spawn, tick}
use climber::moves::Act
use climber::sounds::{Heard, IMPACTS, WHOOSHES, cues, heard}
use engine::present::Snapshots
use engine::run::run
use engine::sound::{BRUSHES, Babble, Breath, Cue, Palette, Surface, mixer}
use std::audio::{RingWriter, play}
use std::gpu::{ClipPosition, VertexIndex, begin_screen_pass, draw}

pub struct Arena {
    snaps: Snapshots<World>,
    cues: RingWriter<Cue>,
    heard: Heard,
}

/// The arena's sounds: the fight's alone.
const PALETTE = Palette {
    surfaces: [Surface {}; 8],
    waters: [Babble {}; 4],
    brushes: [Babble {}; BRUSHES],
    impacts: IMPACTS,
    whooshes: WHOOSHES,
    wind: Breath {},
}

pub fn init() -> Arena {
    let latest = run(spawn(), hz: 60, step: tick, present: present)
    let (cues, m) = mixer(PALETTE)
    play(take m, engine::sound::mix)
    Arena { snaps: Snapshots::new(take latest, hz: 60), cues, heard: heard(spawn()) }
}

/// A square of `size` (clip space) at `at`, two triangles.
@vertex
fn square(at: vec2, size: f32, v: VertexIndex) -> ClipPosition {
    let corners = [
        vec2(-1.0, -1.0),
        vec2(1.0, -1.0),
        vec2(-1.0, 1.0),
        vec2(-1.0, 1.0),
        vec2(1.0, -1.0),
        vec2(1.0, 1.0),
    ]
    let c = corners[v.index % 6]
    ClipPosition { position: vec4(at + c * size, 0.0, 1.0) }
}

@fragment
fn flat(colour: vec4) -> vec4 {
    colour
}

/// The middle of the map: between where the climber and the wolf start.
const MIDDLE = vec2(-1.0, 23.0)

pub fn frame(arena: mut Arena, time: f32, width: u32, height: u32) {
    arena.snaps.update()
    let b = arena.snaps.at(arena.snaps.sim_time(time))
    let w = b.b
    let c = mix(b.a.climber.at.xz, w.climber.at.xz, vec2(b.alpha))
    let f = mix(b.a.wolf.pos(), w.wolf.pos(), vec2(b.alpha))
    let _ = arena.cues.push(
        Cue::Listen {
            at: vec3(c.x, w.climber.at.y + 1.6, c.y),
            forward: w.climber.forward(),
        },
    )
    for cue in cues(mut arena.heard, w) {
        let _ = arena.cues.push(cue)
    }
    let screen = begin_screen_pass(clear: vec4(0.12, 0.16, 0.1, 1.0))
    let lit = if w.climber.invulnerable() { 1.0 } else { 0.7 }
    let climber = if w.climber.act == Act::Down { vec4(0.3, 0.3, 0.3, 1.0) } else {
        vec4(lit, lit * 0.5, 0.2, 1.0)
    }
    let wolf = match w.wolf.mood {
        Mood::Crouch | Mood::Lunge => vec4(0.9, 0.2, 0.15, 1.0),
        Mood::Down => vec4(0.25, 0.25, 0.25, 1.0),
        _ => vec4(0.6, 0.6, 0.62, 1.0),
    }
    draw(screen, square.bind((c - MIDDLE) / 6.0, 0.03), flat.bind(climber), vertices: 6)
    draw(screen, square.bind((f - MIDDLE) / 6.0, 0.04), flat.bind(wolf), vertices: 6)
    screen.present()
}
