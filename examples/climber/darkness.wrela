// The darkness off the climber: licks of shadow, like flame, along the robe's hem and the
// outline of its train, and fainter along the back of the blade. Each lick is a short ribbon
// along the path its root has taken over the last moments, each part of it carried up and
// flickered as it ages since it left: so when the climber stands, the licks rise straight off
// the hem, and when it moves, they lean and stream back (and on a blink, lie along the way
// between). Each is drawn as a hard flame shape cut from its ribbon, with a thin edge.

use cape::{AROUND, Cape, DOWN, point}
use std::math::TAU

/// How many licks rise off the hem and off the blade (in that order); and how many points each
/// has, its root and its past.
pub const HEM_LICKS: u32 = 44
pub const BLADE_LICKS: u32 = 4
pub const LICKS: u32 = HEM_LICKS + BLADE_LICKS
pub const NODES: u32 = 8
pub const LICK_POINTS: u32 = LICKS * NODES

/// How often each lick keeps a point of its root's path (s): it shows (`NODES` - 1) of them.
const EVERY: f32 = 1.0 / 48.0
/// How long a lick is (s of its root's path).
pub const LIFE: f32 = EVERY * f32(NODES - 1)

/// How much of its root's motion each lick's past is carried along by (0 to 1): the licks cling
/// to the hem and lean back only a little as the body moves.
const CLING: f32 = 0.75

/// The darkness: each lick's root's path, newest first (`NODES` - 1 a lick), how long since its
/// newest was kept, the time (s), and where each root was last.
pub struct Shroud {
    past: Vec<vec3>,
    since: f32,
    time: f32,
    started: bool,
    last: Vec<vec3>,
}

pub fn shroud() -> Shroud {
    Shroud { past: Vec::new(), since: 0.0, time: 0.0, started: false, last: Vec::new() }
}

/// A fixed, uneven number in [0, 1) for lick `w`.
pub fn seed(w: u32) -> f32 {
    fract(sin(f32(w) * 91.3458 + 3.17) * 47453.547)
}

/// Whether lick `w` rises off the hem (the rest rise off the blade).
pub fn from_hem(w: u32) -> bool {
    w < HEM_LICKS
}

/// Where round the hem lick `w` rises, in columns (0 to `AROUND`): spread unevenly, and closer
/// together behind, along the train's outline, than in front.
pub fn round_hem(w: u32) -> f32 {
    let a = TAU * (f32(w) + 0.5 * seed(w)) / f32(HEM_LICKS)
    let warped = a + 0.4 * sin(a)
    f32(AROUND) * fract(warped / TAU)
}

/// Where each lick's root is now: on the hem's edge (its last row, which runs round the robe's
/// foot and out along the train's outline), and along the back of the blade toward its point
/// (`grip`, `aim`: the sword's grip and the way to its point; `edge` the way its edge leads).
pub fn roots(c: Cape, grip: vec3, aim: vec3, edge: vec3) -> Vec<vec3> {
    var out: Vec<vec3> = Vec::new()
    for w in 0..HEM_LICKS {
        let at = round_hem(w)
        let i = u32(floor(at))
        let f = at - floor(at)
        let a = c.at[point(i, DOWN - 1)]
        let b = c.at[point(i + 1, DOWN - 1)]
        out.push(mix(a, b, vec3(f)) + vec3(0.0, 0.01, 0.0))
    }
    for k in 0..BLADE_LICKS {
        let along = body::GUARD_AT + (body::POINT_AT - body::GUARD_AT) * (0.2 + 0.2 * f32(k))
        out.push(grip + aim * along - edge * (body::BLADE_WIDTH * 0.4))
    }
    out
}

impl Shroud {
    /// The darkness `dt` seconds on, its roots now at `at` (`roots`); carried along with its
    /// roots as it clings, unless `left` (a blink: it stays where it was, along the way).
    pub fn step(mut self, at: Vec<vec3>, left: bool, dt: f32) {
        if !self.started {
            self.restart(at)
            return
        }
        self.time += dt
        self.since += dt
        if !left {
            for w in 0..LICKS {
                let by = (at[w] - self.last[w]) * CLING
                for k in 0..(NODES - 1) {
                    self.past[w * (NODES - 1) + k] = self.past[w * (NODES - 1) + k] + by
                }
            }
        }
        self.last = at.clone()
        // Keep a point of each root's path every `EVERY` seconds: the oldest falls off the end.
        // (A long frame keeps only the points it needs, along the way from the last to now.)
        var kept = 0
        while self.since >= EVERY && kept < NODES {
            self.since -= EVERY
            kept += 1
            for w in 0..LICKS {
                let base = w * (NODES - 1)
                var k = NODES - 2
                while k > 0 {
                    self.past[base + k] = self.past[base + k - 1]
                    k -= 1
                }
                // Where the root was `since` ago, along the way from its last point to now.
                let last = self.past[base + 1]
                let u = EVERY / (EVERY + self.since)
                self.past[base] = mix(last, at[w], vec3(u))
            }
        }
        self.since = min(self.since, EVERY)
    }

    /// Every lick's path started again where its root is: nothing streams from before.
    pub fn restart(mut self, at: Vec<vec3>) {
        self.past = Vec::new()
        for w in 0..LICKS {
            for _ in 0..(NODES - 1) {
                self.past.push(at[w])
            }
        }
        self.last = at.clone()
        self.since = 0.0
        self.started = true
    }

    /// The whole darkness moved by `by`, as it is (the render origin moved).
    pub fn carry(mut self, by: vec3) {
        for k in 0..self.past.len() {
            self.past[k] = self.past[k] + by
        }
        for k in 0..self.last.len() {
            self.last[k] = self.last[k] + by
        }
    }

    /// Lick `w`'s point `k` (0 its root, now at `root`), and how far along its life it is (0 to
    /// 1), with `wind` (m/s) bending it as it ages.
    pub fn node(self, w: u32, k: u32, root: vec3, wind: vec3) -> vec4 {
        if k == 0 || !self.started {
            return vec4(root, 0.0)
        }
        let age = self.since + f32(k - 1) * EVERY
        let at = self.past[w * (NODES - 1) + k - 1]
        vec4(at + rise(w, age, self.time - age, wind), age / LIFE)
    }

    /// Every lick's points (`LICK_POINTS`), each its place and how far along its life it is.
    pub fn nodes(self, roots: Vec<vec3>, wind: vec3) -> Vec<vec4> {
        var out: Vec<vec4> = Vec::new()
        for w in 0..LICKS {
            for k in 0..NODES {
                out.push(self.node(w, k, roots[w], wind))
            }
        }
        out
    }
}

/// How far a part of lick `w` has gone from where it left its root, `age` seconds after it left
/// at time `left`, in `wind`: up fast, as flame goes, flickering side to side more as it rises.
/// Each part keeps its own turn of the flicker (it's keyed to when it left), so the flicker runs
/// up the lick rather than waving it as one. Hem licks rise a hand or two, now and then more;
/// blade licks less.
pub fn rise(w: u32, age: f32, left: f32, wind: vec3) -> vec3 {
    let s = seed(w)
    let phase = left * (9.0 + 5.0 * s) + s * TAU
    let flicker = vec3(sin(phase + age * 30.0), 0.0, cos(phase * 1.3 + age * 23.0))
    // Most lick low; a few, now and then, reach up higher (each lick's reach wanders slowly).
    let reach = 0.5 + 0.5 * sin(left * (1.3 + s) + s * 17.0)
    let speed = if from_hem(w) { 1.2 + 1.6 * s * s + 1.2 * reach * reach * reach } else {
        0.6 + 0.4 * s
    }
    vec3(0.0, speed * age, 0.0) + flicker * (0.6 * age) + wind * (0.3 * age)
}

// ---- tests -------------------------------------------------------------------------------------

/// A shroud stepped with its roots at `at` for `frames` frames of 60 a second.
fn stepped(s: mut Shroud, at: Vec<vec3>, frames: u32) {
    for _ in 0..frames {
        s.step(at.clone(), left: false, dt: 1.0 / 60.0)
    }
}

/// Roots all at `p`.
fn all_at(p: vec3) -> Vec<vec3> {
    var out: Vec<vec3> = Vec::new()
    for _ in 0..LICKS {
        out.push(p)
    }
    out
}

/// Standing still, every lick rises off its root like a flame: connected at the root, risen at
/// its end a hand or two (never a column of smoke), in one piece.
@test
fn standing_the_licks_rise_off_their_roots() {
    var s = shroud()
    let roots = all_at(vec3(1.0, 0.0, 2.0))
    stepped(mut s, roots.clone(), 90)
    let nodes = s.nodes(roots.clone(), vec3(0.0))
    for w in 0..LICKS {
        let root = nodes[w * NODES]
        let end = nodes[w * NODES + NODES - 1]
        assert(length(root.xyz - roots[w]) < 1.0e-6, "a lick is detached from its root")
        assert(root.w == 0.0 && end.w > 0.85 && end.w <= 1.0, "a lick's life runs wrong")
        let up = end.y - root.y
        assert(up > 0.06, f"lick {w} rises only {up} m")
        assert(up < 0.6, f"lick {w} rises {up} m: a column, not a lick")
        for k in 1..NODES {
            let step = length(nodes[w * NODES + k].xyz - nodes[w * NODES + k - 1].xyz)
            assert(step < 0.12, "a lick breaks into pieces")
        }
    }
}

/// Moving at a sprint, the licks lean back the way the body came, but cling: a short way, not a
/// trail; and they flicker as they go, rather than holding their shape. On a blink they stay
/// behind, along the way between.
@test
fn moving_the_licks_lean_back_and_flicker() {
    var s = shroud()
    var at = vec3(0.0)
    var before = vec3(0.0)
    for f in 0..90 {
        at.z += 7.5 / 60.0
        s.step(all_at(at), left: false, dt: 1.0 / 60.0)
        if f == 80 {
            before = s.nodes(all_at(at), vec3(0.0))[NODES / 2].xyz - at
        }
    }
    let nodes = s.nodes(all_at(at), vec3(0.0))
    for w in 0..LICKS {
        let behind = at.z - nodes[w * NODES + NODES - 1].z
        assert(behind > 0.1, f"lick {w}'s tip is {behind} m behind the body: it doesn't lean")
        assert(behind < 0.6, f"lick {w}'s tip is {behind} m behind the body: it doesn't cling")
    }
    let middle = nodes[NODES / 2].xyz - at
    assert(length(middle - before) > 0.005, "the licks hold their shape as they go")
    for _ in 0..3 {
        at.z += 1.2
        s.step(all_at(at), left: true, dt: 1.0 / 60.0)
    }
    let trail = s.nodes(all_at(at), vec3(0.0))
    assert(at.z - trail[NODES - 1].z > 2.0, "a blink's darkness doesn't stay along the way")
}

/// A long frame keeps the lick's path along the way the root went: no point is left far off it.
@test
fn a_long_frame_keeps_the_path_continuous() {
    var s = shroud()
    stepped(mut s, all_at(vec3(0.0)), 30)
    s.step(all_at(vec3(0.0, 0.0, 1.0)), left: false, dt: 0.1)
    let nodes = s.nodes(all_at(vec3(0.0, 0.0, 1.0)), vec3(0.0))
    for k in 1..NODES {
        let gap = length(nodes[k].xyz - nodes[k - 1].xyz)
        assert(gap < 0.5, f"a long frame tore the lick: a {gap} m gap")
    }
}

/// The origin's move carries the darkness as it is.
@test
fn an_origin_move_carries_the_darkness() {
    var s = shroud()
    stepped(mut s, all_at(vec3(0.0)), 30)
    let before = s.nodes(all_at(vec3(0.0)), vec3(0.0))
    let by = vec3(-64.0, 0.0, 128.0)
    s.carry(by)
    let after = s.nodes(all_at(by), vec3(0.0))
    for k in 0..LICK_POINTS {
        assert(length(after[k].xyz - (before[k].xyz + by)) < 1.0e-3, "the origin's move left it")
    }
}

/// The hem's licks rise from its edge all round, closer together behind than in front.
@test
fn the_licks_crowd_the_train() {
    let c = cape::hang(cape::body_frame(vec3(0.0), 0.0, moves::Form {}))
    let r = roots(c, vec3(0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0))
    var ahead = 0
    var behind = 0
    for w in 0..HEM_LICKS {
        assert(r[w].y < 0.05, "a hem lick rises from above the hem")
        if r[w].z > 0.0 {
            ahead += 1
        } else {
            behind += 1
        }
    }
    assert(behind > ahead + 8, f"{behind} licks behind and {ahead} ahead: the train isn't crowded")
}
