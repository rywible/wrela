// The robe's lower fabric curls into dark flame-shaped tongues. These are the cape's own
// vertices, connected to its upper rows; no detached particle, bead, or billboard is drawn.

use cape::{AROUND, Cape, DOWN, point}
use std::math::TAU

/// Presentation-only folds and escaping shadow at one cloth point. Relief keeps the hanging
/// cloth's long creases readable after its physical links settle. The lower edge spills in
/// unequal tapered tongues: most lie low, while a few turn back into the robe.
pub fn cloth_point(c: Cape, i: u32, j: u32, phase: f32) -> vec3 {
    let p = c.at[point(i, j)]
    let down = f32(j) / f32(DOWN - 1)
    let a = TAU * f32(i) / f32(AROUND)
    let collar = c.at[point(i, 0)]
    let away = p.xz - collar.xz
    let radial = if length(away) > 1.0e-5 { normalize(away) } else { vec2(sin(a), cos(a)) }
    let side = vec2(radial.y, -radial.x)
    let fold_root = smoothstep(0.04, 0.25, down)
    let fold = 0.065 * sin(7.0 * a + 0.25 * sin(3.0 * a) + down * 0.8) * fold_root
    let weight = smoothstep(0.67, 1.0, down)
    let long = pow(0.5 + 0.5 * sin(5.0 * a - phase * 0.7 + 0.6 * sin(3.0 * a + phase * 0.23)), 3.0)
    let short = pow(0.5 + 0.5 * sin(9.0 * a + phase * 0.43), 5.0)
    let tongue = max(long, short * 0.55)
    let curl = 0.5 + 0.5 * sin(3.0 * a + phase * 0.31 + 0.9)
    let spread = 0.32 * tongue * (1.0 - 0.65 * curl) * weight
    let turn = 0.15 * tongue * sin(phase * 0.65 + a * 4.0 + down * 3.0) * weight
    let rise = 0.32 * tongue * pow(curl, 3.0) * weight
    let offset = radial * (fold + spread) + side * turn
    p + vec3(offset.x, rise, offset.y)
}

/// The shadow tongues are attached to unchanged cloth roots, and stay within a small bounded
/// region of its physical hem. A later phase moves that same connected surface.
@test
fn the_dark_hem_is_connected_and_its_motion_is_bounded() {
    let c = cape::hang(cape::body_frame(vec3(0.0), 0.0, moves::Form {}))
    var changed = 0.0
    for phase in [0.0, 0.6, 1.7, 3.0] {
        for i in 0..AROUND {
            for j in 0..DOWN {
                let physical = c.at[point(i, j)]
                let p = cloth_point(c, i, j, phase)
                if j == 0 {
                    assert(
                        length(p - physical) == 0.0,
                        "shadow deformation detached from the robe collar",
                    )
                }
                assert(
                    p.y >= physical.y && length(p - physical) < 0.45,
                    "dark fabric left its bounded hem region",
                )
            }
            changed = max(
                changed,
                length(
                    cloth_point(c, i, DOWN - 1, phase) - cloth_point(c, i, DOWN - 1, phase + 0.5),
                ),
            )
        }
    }
    assert(changed > 0.05, "the connected dark hem does not change shape")
}
