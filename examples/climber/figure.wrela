// The climber's figure: simulated cloth with a connected curling hem, stepped each frame
// from where the body stands and its pose. They're presentation: the frames step them, so the
// fight's state and its replays don't carry presentation cloth or hem deformation.

use cape::{Cape, Plane, POINTS, body_frame, hang}
use moves::Pose

/// How far the body may move in a frame before the figure is carried there as it is, not
/// stepped (m): a blink, a travel, a new shot.
const JUMP: f32 = 1.0

/// The figure: cloth hung at the first step and a continuous phase for its lower fabric.
pub struct Figure {
    pub cape: Option<Cape>,
    phase: f32,
}

pub fn figure() -> Figure {
    Figure { cape: None, phase: 0.0 }
}

impl Figure {
    /// The figure `dt` seconds on: the body at `feet`, facing `heading`, in `pose`, gliding at
    /// `speed` (m/s), swinging or not, gone (a blink) or not, on `ground`, in `wind` (m/s).
    /// The connected lower fabric moves a little faster while travelling or swinging.
    pub fn step(
        mut self,
        feet: vec3,
        heading: f32,
        pose: Pose,
        speed: f32,
        swinging: bool,
        gone: bool,
        ground: Plane,
        wind: vec3,
        dt: f32,
    ) {
        let frame = body_frame(feet, heading, pose.form)
        var cape = match replace(mut self.cape, None) {
            Some(it) => take it,
            None => hang(frame),
        }
        let moved = (frame * vec4(0.0, 0.0, 0.0, 1.0)).xyz -
            (cape.frame * vec4(0.0, 0.0, 0.0, 1.0)).xyz
        // A blink or travel carries the entire connected robe together.
        if gone || length(moved) > JUMP {
            cape.carry(moved)
        }
        cape.step(frame, gather: pose.form.gather, ground: ground, wind: wind, dt: dt)
        self.phase += dt * (1.6 + 0.04 * min(speed, 8.0) + if swinging { 0.3 } else { 0.0 })
        self.cape = Some(take cape)
    }

    /// The whole figure moved by `by`, as it is (the floor's render origin moved).
    pub fn carry(mut self, by: vec3) {
        match mut self.cape {
            Some(c) => c.carry(by),
            None => {},
        }
    }

    /// The cape's points, for a buffer (none before its first step).
    pub fn points(self) -> Vec<vec4> {
        var out: Vec<vec4> = Vec::new()
        match self.cape {
            Some(c) => {
                for j in 0..cape::DOWN {
                    for i in 0..cape::AROUND {
                        out.push(vec4(darkness::cloth_point(c, i, j, self.phase), 1.0))
                    }
                }
            },
            None => {},
        }
        out
    }
}

// ---- tests -------------------------------------------------------------------------------------

/// A body that jumps (a travel, a new shot) takes its figure with it as it is: the cape doesn't
/// fall the whole way, its connected hem doesn't stay behind; an origin shift carries it all.
@test
fn a_jump_takes_the_figure_along() {
    var f = figure()
    let ground = cape::flat(0.0)
    for _ in 0..60 {
        f.step(
            vec3(0.0),
            0.0,
            moves::REST,
            speed: 0.0,
            swinging: false,
            gone: false,
            ground: ground,
            wind: vec3(0.0),
            dt: 1.0 / 60.0,
        )
    }
    let hem = f.points()[POINTS - 1].xyz
    let by = vec3(40.0, 0.0, -25.0)
    f.step(
        by,
        0.0,
        moves::REST,
        speed: 0.0,
        swinging: false,
        gone: false,
        ground: ground,
        wind: vec3(0.0),
        dt: 1.0 / 60.0,
    )
    let off = length(f.points()[POINTS - 1].xyz - (hem + by))
    assert(off < 0.05, f"the hem is {off} m off where the jump took it")
    f.carry(vec3(-40.0, 0.0, 25.0))
    assert(length(f.points()[POINTS - 1].xyz - hem) < 0.05, "the origin's move left the hem")
}
