// The climber's look (#30): the hood and the mask on its head, the great sword, and the cape's
// colour, as the characters thread designs them. The fight places them (`body`'s measures), the
// cape's shape is its cloth's (`cape`), and `draw` draws them; these say how they look.
//
// Units: metres. +y up, +z ahead, +x the climber's left.

use body::{BLADE_THICK, BLADE_WIDTH, GUARD_AT, HEAD, HEAD_RADIUS, POINT_AT}
use engine::creature::{Creature, Skeleton, creature, smooth}
use engine::render::Shaded
use std::derive::Box3
use std::field::{Blend, cuboid, ellipsoid, half_space, round_cone, sphere, top, width}
use std::io::print

/// What a point of the head or the sword carries: its colour (linear).
pub struct Paint: Copy + GpuData + Blend {
    pub albedo: vec3,
}

impl Shaded for Paint {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        0.8
    }
}

/// The cape's colour: near black, a little blue. At play distance only its outline, its rim and
/// its line read, so its folds show by the light that carves them, not by its colour.
pub const CAPE = vec3(0.035, 0.035, 0.045)

// The look's colours: the hood the cape's, its inside blacker still (nothing is under the mask);
// a pale mask with red marks; the sword's grey steel blade (pale, so it reads against the dark
// wood), its paler ground edge, its dark iron guard and pommel, and its grip's leather.
const HOOD = Paint { albedo: CAPE }
const VOID = Paint { albedo: vec3(0.004, 0.004, 0.005) }
const MASK = Paint { albedo: vec3(0.78, 0.75, 0.68) }
const MARK = Paint { albedo: vec3(0.45, 0.025, 0.02) }
const IRON = Paint { albedo: vec3(0.07, 0.072, 0.078) }
const STEEL = Paint { albedo: vec3(0.36, 0.37, 0.39) }
const EDGE = Paint { albedo: vec3(0.62, 0.62, 0.6) }
const LEATHER = Paint { albedo: vec3(0.09, 0.05, 0.03) }

/// The head as a creature of one bone (at the feet, in the body's space: +z ahead): a hood round
/// the head, open at the front and black inside; in it a mask, pale, with two eye slits cut
/// through to the black, red marks swept up from the eyes and down the cheeks, and a red mouth
/// line. Nothing is under it.
pub fn head() -> Creature<Paint> {
    var s = Skeleton::new()
    let root = s.root("body", vec3(0.0))
    let r = HEAD_RADIUS
    let slits = [
        round_cone(
            vec3(0.016, 0.003, 0.118),
            vec3(0.06, 0.019, 0.106),
            r_top: 0.01,
            r_bottom: 0.008,
        ),
        round_cone(
            vec3(-0.016, 0.003, 0.118),
            vec3(-0.06, 0.019, 0.106),
            r_top: 0.01,
            r_bottom: 0.008,
        ),
    ].union()
    let marks = [
        round_cone(
            vec3(0.026, 0.033, 0.114),
            vec3(0.08, 0.09, 0.09),
            r_top: 0.012,
            r_bottom: 0.004,
        ),
        round_cone(
            vec3(-0.026, 0.033, 0.114),
            vec3(-0.08, 0.09, 0.09),
            r_top: 0.012,
            r_bottom: 0.004,
        ),
        round_cone(
            vec3(0.04, -0.025, 0.113),
            vec3(0.074, -0.08, 0.094),
            r_top: 0.011,
            r_bottom: 0.004,
        ),
        round_cone(
            vec3(-0.04, -0.025, 0.113),
            vec3(-0.074, -0.08, 0.094),
            r_top: 0.011,
            r_bottom: 0.004,
        ),
        round_cone(
            vec3(-0.022, -0.085, 0.112),
            vec3(0.022, -0.085, 0.112),
            r_top: 0.009,
            r_bottom: 0.009,
        ),
    ].union()
    creature(s)
        .join(
            "hood",
            root,
            sphere(r + 0.005)
                .translate(vec3(0.0, 0.005, -0.02))
                .smooth_subtract(
                    ellipsoid(vec3(0.1, 0.13, 0.09)).translate(vec3(0.0, -0.01, 0.1)),
                    k: 0.02,
                )
                .translate(HEAD)
                .with(HOOD),
        )
        .join("void", root, sphere(r - 0.025).translate(HEAD).with(VOID), seam: smooth(0.005))
        .join(
            "mask",
            root,
            ellipsoid(vec3(0.088, 0.118, 0.034))
                .translate(vec3(0.0, -0.01, 0.082))
                .smooth_subtract(slits, k: 0.004)
                .translate(HEAD)
                .with(MASK),
            seam: smooth(0.004),
        )
        .join("mask's marks", root, marks.translate(HEAD).with(MARK), seam: smooth(0.003))
        .bounded(Box3 { lo: HEAD - vec3(0.2), hi: HEAD + vec3(0.2, 0.2, 0.25) })
}

/// The great sword, as a creature of one bone at the grip's middle: the point along +y, the edge
/// along +x. A heavy single-edged blade, straight-backed, that widens toward a clipped point (its
/// weight forward, for a blow), ground to a pale edge, with a groove along each face; a plain
/// bar guard, a wrapped grip and a squared pommel.
pub fn sword() -> Creature<Paint> {
    var s = Skeleton::new()
    let grip = s.root("grip", vec3(0.0))
    let back = -BLADE_WIDTH * 0.42
    let (base, wide) = (BLADE_WIDTH * 0.42, BLADE_WIDTH * 0.66)
    let clip = POINT_AT - 0.25
    // The blade's outline: the back, the guard's line, the edge widening up to the clip, and the
    // clip down from the point; its section a wedge, thick at the back, thin at the edge.
    let slope = (wide - base) / (clip - GUARD_AT)
    let thick = BLADE_THICK * 0.5
    let taper = (thick - 0.002) / (wide - back)
    let blade = half_space(vec3(-1.0, 0.0, 0.0), -back)
        .smooth_intersect(half_space(vec3(0.0, -1.0, 0.0), -GUARD_AT), k: 0.002)
        .smooth_intersect(
            half_space(vec3(1.0, -slope, 0.0), base - slope * GUARD_AT),
            k: 0.002,
        )
        .smooth_intersect(
            half_space(
                vec3(POINT_AT - clip, wide - back, 0.0),
                (POINT_AT - clip) * wide + (wide - back) * clip,
            ),
            k: 0.004,
        )
        .smooth_intersect(half_space(vec3(taper, 0.0, 1.0), thick + taper * back), k: 0.002)
        .smooth_intersect(half_space(vec3(taper, 0.0, -1.0), thick + taper * back), k: 0.002)
    let grooves = [
        round_cone(
            vec3(back + 0.05, GUARD_AT + 0.1, thick + 0.006),
            vec3(back + 0.05, clip - 0.15, thick + 0.004),
            r_top: 0.011,
            r_bottom: 0.011,
        ),
        round_cone(
            vec3(back + 0.05, GUARD_AT + 0.1, -thick - 0.006),
            vec3(back + 0.05, clip - 0.15, -thick - 0.004),
            r_top: 0.011,
            r_bottom: 0.011,
        ),
    ].union()
    let ground = half_space(vec3(-1.0, slope, 0.0), -(base - 0.035) + slope * GUARD_AT)
    creature(s)
        .join("blade", grip, blade.smooth_subtract(grooves, k: 0.004).with(STEEL))
        .join(
            "edge",
            grip,
            blade.smooth_intersect(ground, k: 0.003).with(EDGE),
            seam: smooth(0.001),
        )
        .join(
            "guard",
            grip,
            cuboid(vec3(0.16, 0.022, 0.04)).translate(vec3(0.0, GUARD_AT - 0.02, 0.0)).with(IRON),
            seam: smooth(0.01),
        )
        .join(
            "grip",
            grip,
            round_cone(
                vec3(0.0, -0.24, 0.0),
                vec3(0.0, GUARD_AT - 0.04, 0.0),
                r_top: 0.03,
                r_bottom: 0.032,
            )
                .with(LEATHER),
            seam: smooth(0.008),
        )
        .join(
            "pommel",
            grip,
            cuboid(vec3(0.042, 0.03, 0.036)).translate(vec3(0.0, -0.27, 0.0)).with(IRON),
            seam: smooth(0.01),
        )
        .bounded(Box3 { lo: vec3(-0.3, -0.35, -0.08), hi: vec3(0.3, POINT_AT + 0.05, 0.08) })
}

/// The sword reaches its point and keeps its width: its top (the clipped point, at its back) at
/// the point, as wide as the blade at its middle, and its section a wedge: solid near the back
/// at the faces' thickness, open there near the edge.
@test
fn the_sword_reaches_its_point_and_its_edge_is_thin() {
    let f = sword().field()
    let tip = top(f, -BLADE_WIDTH * 0.4, 0.0)
    let mid = (GUARD_AT + POINT_AT) * 0.5
    let across = width(f, mid, 0.0)
    print(f"the point at {tip} m, the blade {across} m wide at its middle")
    assert(abs(tip - POINT_AT) < 0.03, f"its point is at {tip} m, not {POINT_AT} m")
    assert(abs(across - BLADE_WIDTH) < 0.03, f"it is {across} m wide, not {BLADE_WIDTH} m")
    let face = BLADE_THICK * 0.4
    assert(f.distance(vec3(-BLADE_WIDTH * 0.35, mid, face)) < 0.0, "the back isn't thick")
    assert(f.distance(vec3(BLADE_WIDTH * 0.45, mid, face)) > 0.0, "the edge isn't thin")
}

/// The mask's eyes are open to the black behind them: the slits are cut through it.
@test
fn the_masks_eyes_are_open() {
    let f = head().field()
    for x in [0.038, -0.038] {
        let d = f.distance(HEAD + vec3(x, 0.011, 0.116))
        assert(d > 0.0, f"the eye slit at x {x} is closed ({d} m)")
    }
}
