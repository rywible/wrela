// The climber's look: an empty hood and open sleeves, the great sword, and the cape's
// colour, as the characters thread designs them. The fight places them (`body`'s measures), the
// cape's shape is its cloth's (`cape`), and `draw` draws them; these say how they look.
//
// Units: metres. +y up, +z ahead, +x the climber's left.

use body::{BLADE_THICK, BLADE_WIDTH, GUARD_AT, HEAD, POINT_AT}
use engine::creature::{Creature, Skeleton, creature, smooth}
use engine::render::Shaded
use std::derive::Box3
use std::field::{Blend, cuboid, ellipsoid, half_space, round_cone, top, width}
use std::io::print

/// What a point of the head or the sword carries: its colour (linear).
pub struct Paint: Copy + GpuData + Blend {
    pub albedo: vec3,
    pub rough: f32 = 0.9,
    pub metal: f32 = 0.0,
}

impl Shaded for Paint {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        self.rough
    }

    fn metallic(self) -> f32 {
        self.metal
    }
}

/// The cape's colour: near black, a little blue. At play distance only its outline, its rim and
/// its line read, so its folds show by the light that carves them, not by its colour.
pub const CAPE = vec3(0.011, 0.013, 0.018)

// Black cloth holds a deep unlit recess. The blade carries cool steel and small warm fittings.
const HOOD = Paint { albedo: CAPE }
const VOID = Paint { albedo: vec3(0.0008, 0.001, 0.0014) }
const BRONZE = Paint { albedo: vec3(0.42, 0.25, 0.095), rough: 0.27, metal: 0.85 }
const STEEL = Paint { albedo: vec3(0.24, 0.27, 0.31), rough: 0.24, metal: 0.94 }
const DARK_STEEL = Paint { albedo: vec3(0.085, 0.11, 0.14), rough: 0.32, metal: 0.9 }
const EDGE = Paint { albedo: vec3(0.68, 0.70, 0.72), rough: 0.14, metal: 0.98 }
const LEATHER = Paint { albedo: vec3(0.055, 0.035, 0.025) }
const WRAP = Paint { albedo: vec3(0.12, 0.075, 0.045) }

// The crown narrows into a forward-drooping fold. Its backing is clipped to the same outer
// volume so a dark interior can never add a rectangular ledge or change the hood silhouette.
const HOOD_OUTER = ellipsoid(vec3(0.235, 0.32, 0.24)).translate(vec3(0.0, 0.035, -0.04))
    .smooth_union(
        round_cone(
            vec3(-0.01, 0.15, -0.025),
            vec3(-0.05, 0.285, 0.13),
            r_top: 0.14,
            r_bottom: 0.065,
        ),
        k: 0.04,
    )
    .smooth_union(
        round_cone(
            vec3(-0.05, 0.285, 0.13),
            vec3(-0.09, 0.20, 0.285),
            r_top: 0.065,
            r_bottom: 0.022,
        ),
        k: 0.025,
    )
const HOOD_RECESS = HOOD_OUTER.smooth_intersect(
    ellipsoid(vec3(0.19, 0.25, 0.04)).translate(vec3(-0.005, -0.035, -0.17)),
    k: 0.004,
)

/// Empty cloth: a deep hood opening below a forward brow, broad shoulder drapery, and hollow
/// cuffs. The recess is behind the opening; there is no face, mask, skin, hand, or eye geometry.
pub fn head() -> Creature<Paint> {
    var s = Skeleton::new()
    let root = s.root("cloth", vec3(0.0))
    // The offset opening leaves unequal folds framing the void; no straight lid or planar
    // forehead spans it. The narrow crown rolls forward over the larger lower opening.
    let opening = ellipsoid(vec3(0.185, 0.26, 0.40)).translate(vec3(0.018, -0.055, 0.21))
    let mantle = [
        round_cone(
            vec3(0.11, 1.82, -0.015),
            vec3(0.34, 1.58, -0.015),
            r_top: 0.105,
            r_bottom: 0.07,
        ),
        round_cone(
            vec3(-0.11, 1.82, -0.015),
            vec3(-0.34, 1.61, -0.015),
            r_top: 0.105,
            r_bottom: 0.07,
        ),
    ].union()
    // Cuffs hang beyond the front robe surface so the robe cannot cap their holes. Their
    // lengths differ; the narrow tails pull the silhouette downward instead of sideways.
    let left = round_cone(
        vec3(0.28, 1.68, 0.0),
        vec3(0.46, 0.91, 0.44),
        r_top: 0.125,
        r_bottom: 0.12,
    )
        .smooth_union(
            round_cone(
                vec3(0.51, 1.03, 0.37),
                vec3(0.53, 0.69, 0.38),
                r_top: 0.07,
                r_bottom: 0.008,
            ),
            k: 0.02,
        )
        .smooth_subtract(
            round_cone(
                vec3(0.42, 1.13, 0.29),
                vec3(0.51, 0.70, 0.59),
                r_top: 0.073,
                r_bottom: 0.13,
            ),
            k: 0.008,
        )
    let right = round_cone(
        vec3(-0.28, 1.70, 0.0),
        vec3(-0.47, 1.08, 0.47),
        r_top: 0.125,
        r_bottom: 0.12,
    )
        .smooth_union(
            round_cone(
                vec3(-0.52, 1.17, 0.40),
                vec3(-0.55, 0.84, 0.42),
                r_top: 0.065,
                r_bottom: 0.008,
            ),
            k: 0.02,
        )
        .smooth_subtract(
            round_cone(
                vec3(-0.41, 1.29, 0.30),
                vec3(-0.53, 0.85, 0.65),
                r_top: 0.073,
                r_bottom: 0.13,
            ),
            k: 0.008,
        )
    creature(s)
        .join(
            "hood",
            root,
            HOOD_OUTER.smooth_subtract(opening, k: 0.008).translate(HEAD).with(HOOD),
        )
        .join(
            "hood recess",
            root,
            HOOD_RECESS.translate(HEAD).with(VOID),
        )
        .join("shoulder drape", root, mantle.with(HOOD), seam: smooth(0.025))
        .join("left empty sleeve", root, left.with(HOOD), seam: smooth(0.02))
        .join("right empty sleeve", root, right.with(HOOD), seam: smooth(0.02))
        .bounded(Box3 { lo: vec3(-0.68, 0.67, -0.3), hi: vec3(0.68, 2.28, 0.65) })
}

/// How far below the point the back of the blade turns in toward it (m).
const SPINE_TIP: f32 = 0.18

/// The great sword has a broad forged blade, a recessed fuller and a pale ground edge. Its
/// short swept guard, fitted collar and bound grip give the floating weapon a usable hilt.
/// The grip's middle is the origin, the point is +y, and the cutting edge is +x.
pub fn sword() -> Creature<Paint> {
    var s = Skeleton::new()
    let grip = s.root("grip", vec3(0.0))
    let back = -BLADE_WIDTH * 0.42
    let (base, wide) = (BLADE_WIDTH * 0.42, BLADE_WIDTH * 0.66)
    let clip = POINT_AT - 0.25
    // Keep the physical blade's measures and wedge section. The long face and ground edge
    // meet in an unbroken cutting line; fittings never widen the combat blade.
    let slope = (wide - base) / (clip - GUARD_AT)
    let thick = BLADE_THICK * 0.5
    let taper = (thick - 0.002) / (wide - back)
    let blade = half_space(vec3(-1.0, 0.0, 0.0), -back)
        .smooth_intersect(half_space(vec3(0.0, -1.0, 0.0), -GUARD_AT), k: 0.002)
        .smooth_intersect(
            half_space(vec3(1.0, -slope, 0.0), base - slope * GUARD_AT),
            k: 0.002,
        )
        .smooth_intersect(half_space(vec3(POINT_AT - clip, wide, 0.0), wide * POINT_AT), k: 0.004)
        .smooth_intersect(half_space(vec3(-SPINE_TIP, -back, 0.0), -back * POINT_AT), k: 0.004)
        .smooth_intersect(half_space(vec3(taper, 0.0, 1.0), thick + taper * back), k: 0.002)
        .smooth_intersect(half_space(vec3(taper, 0.0, -1.0), thick + taper * back), k: 0.002)
    let grooves = [
        round_cone(
            vec3(back + 0.045, GUARD_AT + 0.17, thick + 0.004),
            vec3(back + 0.045, clip - 0.06, thick + 0.004),
            r_top: 0.016,
            r_bottom: 0.013,
        ),
        round_cone(
            vec3(back + 0.045, GUARD_AT + 0.17, -thick - 0.004),
            vec3(back + 0.045, clip - 0.06, -thick - 0.004),
            r_top: 0.016,
            r_bottom: 0.013,
        ),
    ].union()
    let ground = half_space(vec3(-1.0, slope, 0.0), -(base - 0.038) + slope * GUARD_AT)
    let spine = [
        round_cone(
            vec3(back + 0.014, GUARD_AT + 0.12, 0.017),
            vec3(back + 0.014, clip - 0.07, 0.017),
            r_top: 0.006,
            r_bottom: 0.004,
        ),
        round_cone(
            vec3(back + 0.014, GUARD_AT + 0.12, -0.017),
            vec3(back + 0.014, clip - 0.07, -0.017),
            r_top: 0.006,
            r_bottom: 0.004,
        ),
    ].union()
    // Quillons sweep toward the edge and return toward the hand on the blunt side. Flattened
    // faces catch a broad highlight, while the narrow bronze caps stay small against the steel.
    let quillons = [
        round_cone(vec3(-0.09, 0.224, 0.0), vec3(-0.20, 0.20, 0.0), r_top: 0.035, r_bottom: 0.025),
        round_cone(vec3(-0.20, 0.20, 0.0), vec3(-0.245, 0.16, 0.0), r_top: 0.025, r_bottom: 0.017),
        round_cone(vec3(0.08, 0.224, 0.0), vec3(0.20, 0.26, 0.0), r_top: 0.035, r_bottom: 0.025),
        round_cone(vec3(0.20, 0.26, 0.0), vec3(0.245, 0.31, 0.0), r_top: 0.025, r_bottom: 0.017),
    ]
        .union()
        .smooth_intersect(
            cuboid(vec3(0.29, 0.11, 0.023)).translate(vec3(0.0, 0.235, 0.0)),
            k: 0.003,
        )
    let caps = [
        ellipsoid(vec3(0.022, 0.025, 0.027)).translate(vec3(-0.245, 0.16, 0.0)),
        ellipsoid(vec3(0.022, 0.025, 0.027)).translate(vec3(0.245, 0.31, 0.0)),
    ].union()
    let collar = cuboid(vec3(0.105, 0.052, 0.027))
        .translate(vec3(0.005, GUARD_AT + 0.033, 0.0))
        .smooth_intersect(half_space(vec3(1.0, 0.6, 0.0), 0.275), k: 0.003)
        .smooth_intersect(half_space(vec3(-1.0, 0.6, 0.0), 0.27), k: 0.003)
    let ferrules = [
        round_cone(vec3(0.0, -0.224, 0.0), vec3(0.0, -0.209, 0.0), r_top: 0.038, r_bottom: 0.038),
        round_cone(vec3(0.0, 0.175, 0.0), vec3(0.0, 0.192, 0.0), r_top: 0.038, r_bottom: 0.04),
    ].union()
    // Six raised turns follow the leather rather than floating above it. Eight short facets
    // per turn keep the binding in contact around the whole grip.
    var wraps = [round_cone(vec3(0.0), vec3(0.0), r_top: 0.005, r_bottom: 0.005); 48]
    for i in 0..48 {
        let a = f32(i) * 0.7853982
        let b = f32(i + 1) * 0.7853982
        let y = -0.197 + f32(i) * 0.0075
        wraps[i] = round_cone(
            vec3(cos(a) * 0.031, y, sin(a) * 0.031),
            vec3(cos(b) * 0.031, y + 0.0075, sin(b) * 0.031),
            r_top: 0.005,
            r_bottom: 0.005,
        )
    }
    let pommel = cuboid(vec3(0.049, 0.061, 0.036))
        .translate(vec3(0.0, -0.275, 0.0))
        .smooth_intersect(half_space(vec3(1.0, -0.65, 0.0), 0.231), k: 0.003)
        .smooth_intersect(half_space(vec3(-1.0, -0.65, 0.0), 0.231), k: 0.003)
    let studs = [
        ellipsoid(vec3(0.017, 0.018, 0.009)).translate(vec3(0.0, 0.23, 0.03)),
        ellipsoid(vec3(0.017, 0.018, 0.009)).translate(vec3(0.0, 0.23, -0.03)),
        ellipsoid(vec3(0.023, 0.025, 0.008)).translate(vec3(0.0, -0.267, 0.035)),
        ellipsoid(vec3(0.023, 0.025, 0.008)).translate(vec3(0.0, -0.267, -0.035)),
    ].union()
    creature(s)
        .join("blade", grip, blade.smooth_subtract(grooves, k: 0.002).with(STEEL))
        .join(
            "edge",
            grip,
            blade.smooth_intersect(ground, k: 0.002).with(EDGE),
            seam: smooth(0.001),
        )
        .join("spine", grip, spine.with(DARK_STEEL), seam: smooth(0.001))
        .join("collar", grip, collar.with(DARK_STEEL), seam: smooth(0.002))
        .join("guard", grip, quillons.with(DARK_STEEL), seam: smooth(0.003))
        .join("guard caps", grip, caps.with(BRONZE), seam: smooth(0.002))
        .join(
            "grip",
            grip,
            round_cone(
                vec3(0.0, -0.224, 0.0),
                vec3(0.0, 0.192, 0.0),
                r_top: 0.03,
                r_bottom: 0.032,
            ).with(LEATHER),
            seam: smooth(0.003),
        )
        .join("bindings", grip, wraps.union().with(WRAP), seam: smooth(0.001))
        .join("ferrules", grip, ferrules.with(DARK_STEEL), seam: smooth(0.002))
        .join("pommel", grip, pommel.with(DARK_STEEL), seam: smooth(0.003))
        .join("fittings", grip, studs.with(BRONZE), seam: smooth(0.001))
        .bounded(Box3 { lo: vec3(-0.3, -0.35, -0.08), hi: vec3(0.3, POINT_AT + 0.05, 0.08) })
}

/// The blade retains its physical measures, wedge section and continuous edge. The fuller is
/// a shallow recess in either face, and the guard and pommel remain within the hilt's bounds.
@test
fn the_sword_reaches_its_point_and_its_edge_is_thin() {
    let f = sword().field()
    let tip = top(f, x: 0.0, z: 0.0)
    let mid = (GUARD_AT + POINT_AT) * 0.5
    let across = width(f, mid, 0.0)
    print(f"the point at {tip} m, the blade {across} m wide at its middle")
    assert(abs(tip - POINT_AT) < 0.03, f"its point is at {tip} m, not {POINT_AT} m")
    assert(abs(across - BLADE_WIDTH) < 0.03, f"it is {across} m wide, not {BLADE_WIDTH} m")
    let face = BLADE_THICK * 0.4
    assert(f.distance(vec3(-BLADE_WIDTH * 0.35, mid, face)) < 0.0, "the back isn't thick")
    assert(f.distance(vec3(BLADE_WIDTH * 0.45, mid, face)) > 0.0, "the edge isn't thin")
    let fuller = -BLADE_WIDTH * 0.42 + 0.045
    for z in [-0.014, 0.014] {
        assert(f.distance(vec3(fuller, 0.6, z)) > 0.0, "the fuller must cut both blade faces")
        assert(
            f.distance(vec3(fuller, 0.6, z * 0.4)) < 0.0,
            "the fuller must leave a solid blade core",
        )
    }
    assert(f.distance(vec3(-0.245, 0.16, 0.0)) < 0.0, "the back quillon must meet its cap")
    assert(f.distance(vec3(0.245, 0.31, 0.0)) < 0.0, "the front quillon must meet its cap")
    assert(f.distance(vec3(0.0, -0.32, 0.0)) < 0.0, "the pommel must close the hilt")
    assert(f.distance(vec3(0.31, 0.25, 0.0)) > 0.0, "the guard must stay inside the bounded hilt")
}

/// The hood has an actual open recess; cuffs remain open rather than becoming hidden hands.
@test
fn the_hood_and_sleeves_are_empty() {
    let f = head().field()
    assert(f.distance(HEAD + vec3(0.0, 0.0, 0.20)) > 0.03, "a face fills the hood opening")
    assert(f.distance(HEAD + vec3(-0.005, -0.035, -0.17)) < 0.0, "the recess has no dark back")
    let inside = f.channels(HEAD + vec3(-0.005, -0.035, -0.17)).albedo
    assert(max(inside.x, max(inside.y, inside.z)) < 0.005, "the empty hood contains a bright face")
    for p in [vec3(0.46, 0.91, 0.44), vec3(-0.47, 1.08, 0.47)] {
        assert(f.distance(p) > 0.02, "an empty cuff has been filled")
    }
}

/// The dark backing must never become an exterior block above the shoulders. Sample the
/// crown around all sides, including the old ledge, independently of which part shades it.
@test
fn the_hood_recess_cannot_escape_the_cloth_silhouette() {
    let f = head().field()
    for y in 0..7 {
        for z in 0..9 {
            for x in 0..9 {
                let p = vec3(-0.32 + f32(x) * 0.08, 0.1 + f32(y) * 0.06, -0.32 + f32(z) * 0.08)
                if HOOD_OUTER.distance(p) > 0.005 {
                    assert(
                        HOOD_RECESS.distance(p) > 0.0,
                        "the dark backing extends outside the hood",
                    )
                    assert(
                        f.distance(HEAD + p) > 0.0,
                        "an interior part changes the crown silhouette",
                    )
                }
            }
        }
    }
}
