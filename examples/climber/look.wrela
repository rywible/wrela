// The climber's look (#30): the hood and the mask on its head, the great sword, and the cape's
// colour, as the characters thread designs them. The fight places them (`body`'s measures), the
// cape's shape is its cloth's (`cape`), and `draw` draws them; these say how they look.
//
// Units: metres. +y up, +z ahead, +x the climber's left.

use body::{BLADE_THICK, BLADE_WIDTH, GUARD_AT, HEAD, HEAD_RADIUS, POINT_AT}
use engine::creature::{Creature, Skeleton, creature, smooth}
use engine::render::Shaded
use std::derive::Box3
use std::field::{Blend, cuboid, ellipsoid, half_space, round_cone, sphere, top, width}
use std::io::print

/// What a point of the head or the sword carries: its colour (linear).
pub struct Paint: Copy + GpuData + Blend {
    pub albedo: vec3,
}

impl Shaded for Paint {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        0.8
    }
}

/// The cape's colour: near black, a little blue. At play distance only its outline, its rim and
/// its line read, so its folds show by the light that carves them, not by its colour.
pub const CAPE = vec3(0.035, 0.035, 0.045)

// The look's colours: the hood the cape's, its inside blacker still (nothing is under the mask);
// an ivory mask (darker than it looks: in the sun its lit band is about twice its albedo) with
// red marks; the sword's grey steel blade (pale, so it reads against the dark
// wood), its paler ground edge, its bronze guard and pommel (a warm accent the eye finds), and
// its grip's leather.
const HOOD = Paint { albedo: CAPE }
const VOID = Paint { albedo: vec3(0.004, 0.004, 0.005) }
const MASK = Paint { albedo: vec3(0.42, 0.4, 0.35) }
const MARK = Paint { albedo: vec3(0.32, 0.015, 0.012) }
const BRONZE = Paint { albedo: vec3(0.3, 0.18, 0.07) }
const STEEL = Paint { albedo: vec3(0.36, 0.37, 0.39) }
const EDGE = Paint { albedo: vec3(0.62, 0.62, 0.6) }
const LEATHER = Paint { albedo: vec3(0.09, 0.05, 0.03) }

/// The head as a creature of one bone (at the feet, in the body's space: +z ahead): a hood round
/// the head, open at the front and black inside, with a collar standing round it behind; in it a
/// mask, pale, flat at the brow and pointed at the chin, a brow ridge and a nose plane raised on
/// it, two wide black eyes set in it, and red marks that aren't mirrored, all a fifth larger
/// than the head and forward of it, so the mask fills the hood's opening. Nothing is under it.
pub fn head() -> Creature<Paint> {
    var s = Skeleton::new()
    let root = s.root("body", vec3(0.0))
    let r = HEAD_RADIUS
    // Where the mask goes: a little forward of the head, so it stands in the hood's opening.
    let on_face = HEAD + vec3(0.0, 0.0, 0.012)
    // The mask's face: an oval cut flat across the brow and to a point at the chin, so its
    // outline isn't an egg's; a brow ridge and a nose plane raised on it for the light to carve.
    let face = ellipsoid(vec3(0.09, 0.122, 0.036))
        .translate(vec3(0.0, -0.012, 0.082))
        .smooth_intersect(half_space(vec3(0.0, 1.0, 0.0), 0.07), k: 0.006)
        .smooth_intersect(half_space(vec3(1.0, -0.75, 0.0), 0.09), k: 0.01)
        .smooth_intersect(half_space(vec3(-1.0, -0.75, 0.0), 0.09), k: 0.01)
    let relief = [
        round_cone(
            vec3(-0.07, 0.035, 0.108),
            vec3(0.07, 0.035, 0.108),
            r_top: 0.012,
            r_bottom: 0.012,
        ),
        round_cone(vec3(0.0, 0.03, 0.117), vec3(0.0, -0.045, 0.125), r_top: 0.008, r_bottom: 0.016),
    ].union()
    let eyes = [
        round_cone(
            vec3(0.012, 0.008, 0.124),
            vec3(0.072, 0.03, 0.106),
            r_top: 0.024,
            r_bottom: 0.013,
        ),
        round_cone(
            vec3(-0.012, 0.008, 0.124),
            vec3(-0.072, 0.03, 0.106),
            r_top: 0.024,
            r_bottom: 0.013,
        ),
    ].union()
    // The marks, not mirrored: two red sweeps up from the right eye past the brow, one down the
    // left cheek.
    let marks = [
        round_cone(
            vec3(-0.035, 0.05, 0.118),
            vec3(-0.085, 0.115, 0.09),
            r_top: 0.02,
            r_bottom: 0.006,
        ),
        round_cone(
            vec3(-0.072, 0.045, 0.108),
            vec3(-0.1, 0.075, 0.09),
            r_top: 0.009,
            r_bottom: 0.004,
        ),
        round_cone(
            vec3(0.045, -0.03, 0.114),
            vec3(0.06, -0.095, 0.094),
            r_top: 0.011,
            r_bottom: 0.004,
        ),
    ].union()
    creature(s)
        .join(
            "hood",
            root,
            sphere(r + 0.005)
                .translate(vec3(0.0, 0.005, -0.02))
                .smooth_subtract(
                    ellipsoid(vec3(0.1, 0.13, 0.09)).translate(vec3(0.0, -0.01, 0.1)),
                    k: 0.02,
                )
                .translate(HEAD)
                .with(HOOD),
        )
        .join("void", root, sphere(r - 0.025).translate(HEAD).with(VOID), seam: smooth(0.005))
        .join(
            "mask",
            root,
            face.smooth_union(relief, k: 0.012).smooth_subtract(eyes, k: 0.004)
                .scale(1.2)
                .translate(on_face)
                .with(MASK),
            seam: smooth(0.004),
        )
        .join(
            "mask's eyes",
            root,
            eyes.smooth_intersect(face.translate(vec3(0.0, 0.0, -0.012)), k: 0.002)
                .scale(1.2)
                .translate(on_face)
                .with(VOID),
            seam: smooth(0.002),
        )
        .join(
            "mask's marks",
            root,
            marks.scale(1.2).translate(on_face).with(MARK),
            seam: smooth(0.003),
        )
        .join(
            "collar",
            root,
            round_cone(vec3(0.0, 1.48, -0.02), vec3(0.0, 1.8, -0.06), r_top: 0.17, r_bottom: 0.21)
                .smooth_subtract(
                    round_cone(
                        vec3(0.0, 1.5, 0.03),
                        vec3(0.0, 1.85, 0.0),
                        r_top: 0.15,
                        r_bottom: 0.19,
                    ),
                    k: 0.01,
                )
                .smooth_intersect(half_space(vec3(0.0, 0.0, 1.0), 0.04), k: 0.01)
                .with(HOOD),
            seam: smooth(0.02),
        )
        .bounded(Box3 { lo: vec3(-0.3, 1.4, -0.3), hi: vec3(0.3, 1.95, 0.3) })
}

/// How far below the point the back of the blade turns in toward it (m).
const SPINE_TIP: f32 = 0.18

/// The great sword, as a creature of one bone at the grip's middle: the point along +y, the edge
/// along +x. A heavy single-edged blade, straight-backed, that widens toward its point (its
/// weight forward, for a blow), the edge and the back both sweeping in to the point; ground to a
/// pale edge, with a groove along each face; a bronze bar guard and pommel, and a wrapped grip.
pub fn sword() -> Creature<Paint> {
    var s = Skeleton::new()
    let grip = s.root("grip", vec3(0.0))
    let back = -BLADE_WIDTH * 0.42
    let (base, wide) = (BLADE_WIDTH * 0.42, BLADE_WIDTH * 0.66)
    let clip = POINT_AT - 0.25
    // The blade's outline: the back, the guard's line, the edge widening up to the clip, and the
    // clip down from the point; its section a wedge, thick at the back, thin at the edge.
    let slope = (wide - base) / (clip - GUARD_AT)
    let thick = BLADE_THICK * 0.5
    let taper = (thick - 0.002) / (wide - back)
    let blade = half_space(vec3(-1.0, 0.0, 0.0), -back)
        .smooth_intersect(half_space(vec3(0.0, -1.0, 0.0), -GUARD_AT), k: 0.002)
        .smooth_intersect(
            half_space(vec3(1.0, -slope, 0.0), base - slope * GUARD_AT),
            k: 0.002,
        )
        .smooth_intersect(half_space(vec3(POINT_AT - clip, wide, 0.0), wide * POINT_AT), k: 0.004)
        .smooth_intersect(half_space(vec3(-SPINE_TIP, -back, 0.0), -back * POINT_AT), k: 0.004)
        .smooth_intersect(half_space(vec3(taper, 0.0, 1.0), thick + taper * back), k: 0.002)
        .smooth_intersect(half_space(vec3(taper, 0.0, -1.0), thick + taper * back), k: 0.002)
    let grooves = [
        round_cone(
            vec3(back + 0.05, GUARD_AT + 0.1, thick + 0.006),
            vec3(back + 0.05, clip - 0.15, thick + 0.004),
            r_top: 0.011,
            r_bottom: 0.011,
        ),
        round_cone(
            vec3(back + 0.05, GUARD_AT + 0.1, -thick - 0.006),
            vec3(back + 0.05, clip - 0.15, -thick - 0.004),
            r_top: 0.011,
            r_bottom: 0.011,
        ),
    ].union()
    let ground = half_space(vec3(-1.0, slope, 0.0), -(base - 0.035) + slope * GUARD_AT)
    creature(s)
        .join("blade", grip, blade.smooth_subtract(grooves, k: 0.004).with(STEEL))
        .join(
            "edge",
            grip,
            blade.smooth_intersect(ground, k: 0.003).with(EDGE),
            seam: smooth(0.001),
        )
        .join(
            "guard",
            grip,
            cuboid(vec3(0.16, 0.022, 0.04)).translate(vec3(0.0, GUARD_AT - 0.02, 0.0)).with(BRONZE),
            seam: smooth(0.01),
        )
        .join(
            "grip",
            grip,
            round_cone(
                vec3(0.0, -0.24, 0.0),
                vec3(0.0, GUARD_AT - 0.04, 0.0),
                r_top: 0.03,
                r_bottom: 0.032,
            )
                .with(LEATHER),
            seam: smooth(0.008),
        )
        .join(
            "pommel",
            grip,
            cuboid(vec3(0.042, 0.03, 0.036)).translate(vec3(0.0, -0.27, 0.0)).with(BRONZE),
            seam: smooth(0.01),
        )
        .bounded(Box3 { lo: vec3(-0.3, -0.35, -0.08), hi: vec3(0.3, POINT_AT + 0.05, 0.08) })
}

/// The sword reaches its point and keeps its width: its top at the point, as wide as the blade at its middle, and its section a wedge: solid near the back
/// at the faces' thickness, open there near the edge.
@test
fn the_sword_reaches_its_point_and_its_edge_is_thin() {
    let f = sword().field()
    let tip = top(f, x: 0.0, z: 0.0)
    let mid = (GUARD_AT + POINT_AT) * 0.5
    let across = width(f, mid, 0.0)
    print(f"the point at {tip} m, the blade {across} m wide at its middle")
    assert(abs(tip - POINT_AT) < 0.03, f"its point is at {tip} m, not {POINT_AT} m")
    assert(abs(across - BLADE_WIDTH) < 0.03, f"it is {across} m wide, not {BLADE_WIDTH} m")
    let face = BLADE_THICK * 0.4
    assert(f.distance(vec3(-BLADE_WIDTH * 0.35, mid, face)) < 0.0, "the back isn't thick")
    assert(f.distance(vec3(BLADE_WIDTH * 0.45, mid, face)) > 0.0, "the edge isn't thin")
}

/// The mask's eyes are black inlays on its pale face, wide enough to read at play distance.
@test
fn the_masks_eyes_are_dark_on_a_pale_face() {
    let f = head().field()
    for x in [0.05, -0.05] {
        let eye = f.channels(HEAD + vec3(x, 0.023, 0.145)).albedo
        assert(eye.x < 0.05, f"the eye at x {x} isn't dark ({eye})")
    }
    let brow = f.channels(HEAD + vec3(0.0, 0.06, 0.14)).albedo
    assert(brow.x > 0.3, f"the brow isn't pale ({brow})")
}
