// The fight's tests: its frame data holds together, a player who swings hits the wolf, a blink
// through a lunge isn't bitten, a blink goes where the stick points, the sword's cut sweeps the
// space ahead, a replay of the same presses comes out the same, and the climber answers as a hand
// expects: a press shows on the next tick, the stick lets a move go in its recovery at its pace,
// and its moves work with no wolf. A test bot plays: it reads the world and presses as a player
// would.

use fight::{BITE, CROUCH, Duel, Level, MOTION, Mood, World, blade_at, dry, open, spawn, tick}
use engine::player::{facing, screen_right}
use engine::run::TickInput
use moves::{Act, BLINK_GONE, frames}
use std::hash::state_hash
use std::input::{Event, PadAxis, PadButton}
use std::io::print

/// The moves with frame data, in the table's order.
const MOVES = [Act::Slash, Act::Backslash, Act::Blink, Act::Hurt, Act::Down]

fn name(a: Act) -> Text {
    match a {
        Act::Free => "free",
        Act::Slash => "slash",
        Act::Backslash => "backslash",
        Act::Blink => "blink",
        Act::Hurt => "stagger",
        Act::Down => "down",
    }
}

/// Each move's frame data, as a table (ticks at 60 Hz): wind-up, active, recovery, when it can be
/// cancelled, its invulnerable ticks, its cost and damage. Its ticks hold together: a move's
/// active ticks end before it can be cancelled, which is before its end; its invulnerable
/// ticks are within it.
@test
fn frame_data_holds_together() {
    print_frames()
    for a in MOVES {
        let f = frames(a)
        assert(f.windup + f.active <= f.cancel, f"{name(a)} can be cancelled while it's active")
        assert(f.cancel <= f.total, f"{name(a)} is cancelled after its end")
        assert(f.invulnerable.y <= f.total, f"{name(a)} is invulnerable past its end")
    }
}

/// The frame data table (the fight prints it as it starts).
pub fn print_frames() {
    print(
        "| move | wind-up | active | recovery | total | cancel from | invulnerable | stamina | damage |",
    )
    print("|---|---:|---:|---:|---:|---:|---|---:|---:|")
    for a in MOVES {
        let f = frames(a)
        let recovery = f.total - f.windup - f.active
        let inv = if f.invulnerable.y > f.invulnerable.x {
            f"{f.invulnerable.x}–{f.invulnerable.y - 1}"
        } else {
            f"–"
        }
        print(
            f"| {name(a)} | {f.windup} | {f.active} | {recovery} | {f.total} | {f.cancel} | {inv} | {f.stamina} | {f.damage} |",
        )
    }
    print(
        f"| wolf's lunge | {CROUCH} | {BITE.y - BITE.x} | {fight::LUNGE - BITE.y + fight::RECOVER} | {CROUCH + fight::LUNGE + fight::RECOVER} | – | – | – | {fight::BITE_DAMAGE} |",
    )
}

fn step(d: mut Duel, events: take Vec<Event>) {
    let t = d.fight.ticks
    tick(mut d, TickInput { tick: t, dt: 1.0 / 60.0, records: events, answers: Vec::new() })
}

@test
fn a_wolf_arriving_at_its_circle_goal_keeps_a_finite_direction() {
    var d = spawn()
    d.fight.wolf.circle = 1
    d.fight.wolf.goal = d.fight.wolf.pos()
    step(mut d, Vec::new())
    let at = d.fight.wolf.walker.root.pos
    assert(at == at && dot(at, at) < 1.0e6)
    assert(d.fight.wolf.circle == 0, "the wolf finished circling")
}

fn stick(x: f32, y: f32) -> Vec<Event> {
    var v: Vec<Event> = Vec::new()
    v.push(Event::PadAxis { pad: 0, axis: PadAxis::LeftX, value: x })
    v.push(Event::PadAxis { pad: 0, axis: PadAxis::LeftY, value: -y })
    v
}

fn button(b: PadButton, down: bool) -> Event {
    Event::PadButton { pad: 0, button: b, value: if down { 1.0 } else { 0.0 }, pressed: down }
}

/// The stick that points the way `dir` goes on the plane, as the camera at `yaw` sees it.
fn stick_toward(dir: vec2, yaw: f32) -> vec2 {
    vec2(dot(dir, screen_right(yaw)), dot(dir, facing(yaw)))
}

/// The bot's presses this tick: the stick toward the wolf (as the camera sees it) until it's
/// near, an attack (if it `attacks`) when it's in reach and prowling, a blink toward it (through
/// it) when it has crouched long enough (if it `blinks`). It holds each button a few ticks. (fight.json, the
/// scripted fight, is this bot's presses, its stick rounded to hundredths.)
fn bot(d: Duel, blinks: bool, attacks: bool, held: mut u32) -> Vec<Event> {
    let w = d.fight
    let c = w.climber
    let to = w.wolf.pos() - c.at.xz
    let dist = length(to)
    let dir = to / max(dist, 1.0e-4)
    let s = stick_toward(dir, d.body.controls.yaw)
    // Near, only a nudge: enough to turn toward it.
    let facing_it = dot(dir, c.forward())
    let push = if dist > 1.9 { 1.0 } else if facing_it < 0.9 { 0.3 } else { 0.0 }
    var out = stick(s.x * push, s.y * push)
    if held > 0 {
        held -= 1
        if held == 0 {
            out.push(button(PadButton::RightShoulder, down: false))
            out.push(button(PadButton::East, down: false))
        }
        return out
    }
    let wolf = w.wolf
    if blinks && wolf.mood == Mood::Crouch && wolf.t >= CROUCH - 6 {
        out = stick(s.x, s.y)
        out.push(button(PadButton::East, down: true))
        held = 3
        return out
    }
    if attacks && dist < 2.0 && wolf.mood == Mood::Prowl && c.act == Act::Free {
        out.push(button(PadButton::RightShoulder, down: true))
        held = 4
    }
    out
}

/// Plays `ticks` ticks with the bot.
fn play(ticks: u32, blinks: bool, attacks: bool) -> Duel {
    var d = spawn()
    var held = 0
    for _ in 0..ticks {
        let e = bot(d, blinks, attacks, mut held)
        step(mut d, take e)
    }
    d
}

/// A player who walks up and swings, again and again, hits the wolf, and puts it down; a hit
/// stops the fight for its ticks.
@test
fn swinging_hits_the_wolf() {
    let t = play(1800, blinks: true, attacks: true).fight.tally
    print(
        f"30 s: {t.swings} swings, {t.hits} hits, {t.lunges} lunges, {t.bites} bites, {t.dodged} blinked through, {t.blinks} blinks, wolf down {t.wolf_downs}, climber down {t.climber_downs}",
    )
    assert(t.swings > 10, f"only {t.swings} swings")
    assert(t.hits * 3 > t.swings, f"{t.hits} hits of {t.swings} swings")
    assert(t.wolf_downs >= 1, "the wolf never went down")
}

/// A blink at the end of the wolf's crouch takes the climber out of its lunge unbitten; a player
/// who never blinks is bitten.
@test
fn a_blink_at_the_lunge_isnt_bitten() {
    let blinked = play(1800, blinks: true, attacks: false).fight.tally
    let stood = play(1800, blinks: false, attacks: false).fight.tally
    print(f"blinking: {blinked.lunges} lunges, {blinked.bites} bites, {blinked.blinks} blinks")
    print(f"standing: {stood.lunges} lunges, {stood.bites} bites")
    assert(blinked.lunges >= 3, f"only {blinked.lunges} lunges")
    assert(
        blinked.bites * 4 < blinked.lunges,
        f"bitten {blinked.bites} times in {blinked.lunges} lunges",
    )
    assert(stood.bites >= 2, f"standing still, bitten only {stood.bites} times")
}

/// The bite passes through the climber in the blink's invulnerable ticks (counted as dodged), and
/// bites it a tick after they end: the wolf's jaws on it, mid-lunge, either way.
@test
fn the_blinks_invulnerable_ticks_pass_the_bite() {
    for t in [1, frames(Act::Blink).invulnerable.y] {
        var d = spawn()
        let c = d.fight.climber.at.xz
        let f = d.fight.climber.forward()
        d.fight.wolf = fight::new_wolf(Level {}, c + f * 0.75, d.fight.climber.heading + 3.14159265)
        d.fight.wolf.mood = Mood::Lunge
        d.fight.wolf.t = BITE.x
        d.fight.wolf.aim = -f
        d.fight.climber.start(Act::Blink)
        // Blinking straight ahead, so the travel keeps it on the jaws (the blink's own path).
        d.fight.climber.going = f
        d.fight.climber.t = t
        d.fight.climber.fade = 10
        step(mut d, Vec::new())
        let tally = d.fight.tally
        print(f"blink tick {t}: bitten {tally.bites}, passed through {tally.dodged}")
        if t < frames(Act::Blink).invulnerable.y {
            assert(
                tally.bites == 0 && tally.dodged == 1,
                "bitten in the blink's invulnerable ticks",
            )
        } else {
            assert(tally.bites == 1, "not bitten after the blink's invulnerable ticks")
        }
    }
}

/// The same presses, played twice, give the same state hash each tick.
@test
fn the_fight_is_the_same_twice() {
    var a = spawn()
    var b = spawn()
    var ha = 0
    var hb = 0
    for _ in 0..600 {
        let e = bot(a, blinks: true, attacks: true, held: mut ha)
        let f = bot(b, blinks: true, attacks: true, held: mut hb)
        step(mut a, take e)
        step(mut b, take f)
        assert(state_hash(a) == state_hash(b), f"the hashes differ at tick {a.fight.ticks}")
    }
}

/// A blink starts as East goes down and carries the climber's body 3.6 m the way the stick
/// points, as the camera sees it, still facing the way it faced; with the stick let go, straight
/// back. It's gone for its middle ticks.
@test
fn a_blink_goes_where_the_stick_points() {
    for (sx, sy) in [(1.0, 0.0), (0.0, 0.0)] {
        var d = spawn()
        d.fight.wolf = fight::new_wolf(Level {}, vec2(-60.0, -20.0), 0.0)
        let start = d.body.at.world()
        let yaw = d.body.controls.yaw
        let want = if sx == 0.0 && sy == 0.0 { -d.fight.climber.forward() } else {
            screen_right(yaw) * sx + facing(yaw) * sy
        }
        var e = stick(sx, sy)
        e.push(button(PadButton::East, down: true))
        step(mut d, take e)
        assert(d.fight.climber.act == Act::Blink, "no blink as East went down")
        let heading = d.fight.climber.heading
        var gone = if d.fight.climber.gone() { 1 } else { 0 }
        var up = stick(x: 0.0, y: 0.0)
        up.push(button(PadButton::East, down: false))
        step(mut d, take up)
        for _ in 0..30 {
            if d.fight.climber.gone() {
                gone += 1
            }
            if d.fight.climber.act == Act::Free {
                break
            }
            step(mut d, stick(x: 0.0, y: 0.0))
        }
        let moved = d.body.at.world() - start
        print(
            f"stick ({sx}, {sy}): moved {length(moved)} m, {dot(normalize(moved), want)} along the stick, gone {gone} ticks",
        )
        assert(abs(length(moved) - 3.6) < 0.05, f"the blink went {length(moved)} m")
        assert(dot(normalize(moved), want) > 0.999, "the blink went astray")
        assert(abs(d.fight.climber.heading - heading) < 1.0e-5, "the blink turned the climber")
        assert(gone == BLINK_GONE.y - BLINK_GONE.x, f"gone {gone} ticks")
        let c = d.fight.climber.at.xz
        assert(length(c - d.body.at.world()) < 1.0e-5, "the climber isn't where its body is")
    }
}

/// The slash's edge sweeps the space ahead at its active ticks: its point reaches 1.5 to 2.8 m
/// ahead and falls through more than a metre, from over the head to the wolf's height.
@test
fn the_slash_sweeps_ahead() {
    var c = spawn().fight.climber
    c.start(Act::Slash)
    let f = frames(Act::Slash)
    var lo = 10.0
    var hi = -10.0
    var reach = 0.0
    for t in f.windup..(f.windup + f.active) {
        c.t = t
        c.fade = 10
        let (_, b) = blade_at(c, 0.0)
        let ahead = dot((b - c.at).xz, c.forward())
        lo = min(lo, b.y - c.at.y)
        hi = max(hi, b.y - c.at.y)
        reach = max(reach, ahead)
        print(f"tick {t}: tip {b.y - c.at.y} m up, {ahead} m ahead")
    }
    assert(reach > 1.5 && reach < 2.8, f"the slash reaches {reach} m ahead")
    assert(hi - lo > 1.0, f"the slash's point only falls {hi - lo} m")
    assert(lo < 0.6, f"the slash's point stays {lo} m up: over a wolf")
}

/// A slash that hits throws the wolf's head the way the edge goes (the slash cuts to the
/// climber's left), as fast as the blow's kick; the head swings back to its place on its own by
/// the time the wolf crouches to answer.
@test
fn a_hit_throws_the_wolfs_head_along_the_cut() {
    var d = spawn()
    let c = d.fight.climber.at.xz
    let f = d.fight.climber.forward()
    d.fight.wolf = fight::new_wolf(Level {}, c + f * 1.7, d.fight.climber.heading + 3.14159265)
    d.fight.wolf.wait = 1000
    d.fight.climber.start(Act::Slash)
    d.fight.climber.t = frames(Act::Slash).windup
    d.fight.climber.fade = 10
    var ticks = 0
    while d.fight.tally.hits == 0 && ticks < 8 {
        step(mut d, Vec::new())
        ticks += 1
    }
    assert(d.fight.tally.hits == 1, "the slash missed")
    let head = d.fight.wolf.walker.springs[0]
    let left = vec2(f.y, -f.x)
    let across = dot(head.vel.xz, left)
    print(
        f"hit after {ticks} ticks: the head thrown {length(head.vel)} m/s, {across} m/s to the climber's left",
    )
    assert(length(head.vel) > fight::HEAD_KICK * 0.8, "the head wasn't thrown")
    assert(across > 0.5, "the head wasn't thrown the way the cut went")
    // On through the hit stop and the flinch, into the crouch that answers it (it stands still).
    for _ in 0..45 {
        step(mut d, Vec::new())
    }
    assert(d.fight.wolf.mood == Mood::Crouch, "the wolf isn't crouching")
    let rest = (engine::gait::body_frame(d.fight.wolf.walker) *
        vec4(fight::WOLF_BODY.spring_tips[0], 1.0)).xyz
    let off = length(d.fight.wolf.walker.springs[0].pos - rest)
    print(f"0.75 s on, crouched: the head {off} m from its place")
    assert(off < 0.05, f"the head is {off} m from its place")
}

/// What the fight did, heard tick by tick: (whooshes of the sword, hits, blink goings, blink
/// comings), and where the last hit and the last coming were.
fn listen(
    d: mut Duel,
    ticks: u32,
    presses: fn(u32) -> Vec<Event>,
    counts: mut vec4u,
    at: mut [vec3; 2],
) {
    var h = sounds::heard(d.fight)
    for k in 0..ticks {
        step(mut d, presses(k))
        for cue in sounds::cues(mut h, d.fight) {
            match cue {
                engine::sound::Cue::Whoosh { kind, .. } if kind == sounds::SWORD => counts.x += 1,
                engine::sound::Cue::Whoosh { kind, .. } if kind == sounds::GONE => counts.z += 1,
                engine::sound::Cue::Impact { at: p, kind, .. } if kind == sounds::HIT => {
                    counts.y += 1
                    at[0] = p
                },
                engine::sound::Cue::Impact { at: p, kind, .. } if kind == sounds::ARRIVE => {
                    counts.w += 1
                    at[1] = p
                },
                _ => {},
            }
        }
    }
}

/// A slash that hits sounds once as it starts and once as it hits, at the wolf; a blink sounds
/// as it goes and as it comes, where it comes.
@test
fn the_fight_sounds_its_swings_hits_and_blinks() {
    var d = spawn()
    let c = d.fight.climber.at.xz
    let f = d.fight.climber.forward()
    d.fight.wolf = fight::new_wolf(Level {}, c + f * 1.7, d.fight.climber.heading + 3.14159265)
    d.fight.wolf.wait = 1000
    var counts = vec4u(0)
    var at = [vec3(0.0); 2]
    let slash = |k: u32| -> Vec<Event> {
        var e: Vec<Event> = Vec::new()
        if k == 0 || k == 4 {
            e.push(button(PadButton::RightShoulder, down: k == 0))
        }
        take e
    }
    listen(mut d, 40, slash, mut counts, mut at)
    print(
        f"slash: {counts.x} whooshes, {counts.y} hits, the hit {length(at[0].xz - d.fight.wolf.pos())} m from the wolf",
    )
    assert(counts.x == 1 && counts.y == 1, f"{counts.x} whooshes, {counts.y} hits")
    assert(length(at[0].xz - d.fight.wolf.pos()) < 0.5, "the hit sounded away from the wolf")
    let blink = |k: u32| -> Vec<Event> {
        var e: Vec<Event> = Vec::new()
        if k < 2 {
            e.push(button(PadButton::East, down: k == 0))
        }
        take e
    }
    listen(mut d, 30, blink, mut counts, mut at)
    let me = d.fight.climber.at.xz
    print(
        f"blink: {counts.z} goings, {counts.w} comings, the coming {length(at[1].xz - me)} m from the climber",
    )
    assert(counts.z == 1 && counts.w == 1, f"{counts.z} goings, {counts.w} comings")
    assert(length(at[1].xz - me) < 0.1, "the coming sounded away from the climber")
}

/// How far the sword's point and the body's form have moved from pose `a` to pose `b` (m, and the
/// form's lift and tilt together), for the climber facing +z at the origin.
fn shown(a: moves::Pose, b: moves::Pose) -> f32 {
    let (at_a, aim_a, _) = a.sword.placed(vec3(0.0), 0.0)
    let (at_b, aim_b, _) = b.sword.placed(vec3(0.0), 0.0)
    let tip = length((at_b + aim_b * body::POINT_AT) - (at_a + aim_a * body::POINT_AT))
    let form = abs(b.form.lift - a.form.lift) + length(b.form.tilt - a.form.tilt)
    tip + form
}

/// A press shows on the tick after it, as a hand expects: a slash, a backslash out of the slash,
/// and a blink each move the sword's point or the body more than 5 cm (or the body's form) by
/// then; the press isn't buffered past its tick when the climber is free.
@test
fn a_press_shows_on_the_tick_after_it() {
    for (b, follow) in [
        (PadButton::RightShoulder, false),
        (PadButton::RightShoulder, true),
        (PadButton::East, false),
    ] {
        var d = spawn()
        d.fight.wolf = fight::new_wolf(Level {}, vec2(-60.0, -20.0), 0.0)
        if follow {
            // In the slash, from the tick it can first be cancelled.
            var e: Vec<Event> = Vec::new()
            e.push(button(PadButton::RightShoulder, down: true))
            step(mut d, take e)
            var up: Vec<Event> = Vec::new()
            up.push(button(PadButton::RightShoulder, down: false))
            step(mut d, take up)
            while d.fight.climber.t < frames(Act::Slash).cancel {
                step(mut d, Vec::new())
            }
        }
        let before = d.fight.climber.pose(0.0)
        var e: Vec<Event> = Vec::new()
        e.push(button(b, down: true))
        step(mut d, take e)
        let c = d.fight.climber
        let after = c.pose(0.0)
        let moved = shown(before, after)
        print(f"{name(c.act)}: {moved} shown a tick after the press")
        assert(c.act != Act::Free && c.t == 1, "the press didn't start its move on its tick")
        assert(moved > 0.05, f"a tick after the press, only {moved} shows")
    }
}

/// Pushing the stick in a move's recovery lets the move go, and the body goes on at once at the
/// pace the stick asks, not from a stand; before the move can be cancelled the stick waits.
@test
fn the_stick_lets_a_move_go_in_its_recovery_at_its_pace() {
    var d = spawn()
    d.fight.wolf = fight::new_wolf(Level {}, vec2(-60.0, -20.0), 0.0)
    var e: Vec<Event> = Vec::new()
    e.push(button(PadButton::RightShoulder, down: true))
    step(mut d, take e)
    var up = stick(x: 0.0, y: 1.0)
    up.push(button(PadButton::RightShoulder, down: false))
    step(mut d, take up)
    let f = frames(Act::Slash)
    var last = 0
    while d.fight.climber.act == Act::Slash && d.fight.climber.t < f.total {
        last = d.fight.climber.t
        assert(last <= f.cancel, "the stick didn't let the slash go")
        step(mut d, Vec::new())
    }
    assert(d.fight.climber.act == Act::Free, "the slash went on past the stick")
    let speed = length(d.body.velocity)
    print(f"let go after tick {last} of {f.total}: on at {speed} m/s at once")
    assert(abs(speed - MOTION.walk) < 1.0e-3, f"the body went on at {speed} m/s, not the walk's")
}

/// The moves are the climber's, not the fight's: with no wolf, a press still swings and blinks,
/// and the body walks between them.
@test
fn moves_work_with_no_wolf() {
    var d = spawn()
    var w = d.fight
    let at = d.body.at.world()
    var e: Vec<Event> = Vec::new()
    e.push(button(PadButton::RightShoulder, down: true))
    fight::step(
        Level {},
        dry(),
        open(),
        MOTION,
        mut d.body,
        mut w,
        e,
        wolf_on: false,
        dt: 1.0 / 60.0,
    )
    assert(w.climber.act == Act::Slash, "no slash with no wolf")
    for _ in 0..60 {
        fight::step(
            Level {},
            dry(),
            open(),
            MOTION,
            mut d.body,
            mut w,
            stick(x: 0.0, y: 1.0),
            wolf_on: false,
            dt: 1.0 / 60.0,
        )
    }
    assert(w.climber.act == Act::Free, "the slash didn't end")
    assert(length(d.body.at.world() - at) > 1.0, "the body didn't walk after the slash")
    assert(w.wolf.pos() == spawn().fight.wolf.pos(), "the wolf moved while off")
}

/// The sword at rest floats on its own: a hand's width clear of the cape all along its blade, it
/// rises and falls a quarter round behind the body's float, and it holds still at the guard.
@test
fn the_sword_at_rest_floats_clear_of_the_cape() {
    var low = 10.0
    var high = -10.0
    var clear = 10.0
    for k in 0..8 {
        let drift = f32(k) / 8.0
        let p = moves::locomotion(ready: 0.0, speed: 0.0, accel: 0.0, turning: 0.0, drift: drift)
        low = min(low, p.sword.at.y)
        high = max(high, p.sword.at.y)
        let aim = normalize(p.sword.aim)
        for j in 1..cape::DOWN {
            for i in 0..cape::AROUND {
                let c = cape::rest(i, j) + vec3(0.0, p.form.lift, 0.0)
                let along = clamp(dot(c - p.sword.at, aim), 0.0, body::POINT_AT)
                let gap = length(c - (p.sword.at + aim * along)) - 0.5 * body::BLADE_WIDTH
                clear = min(clear, gap)
            }
        }
        let guard = moves::locomotion(
            ready: 1.0,
            speed: 0.0,
            accel: 0.0,
            turning: 0.0,
            drift: drift,
        )
        let still = moves::locomotion(ready: 1.0, speed: 0.0, accel: 0.0, turning: 0.0, drift: 0.0)
        assert(length(guard.sword.at - still.sword.at) < 1e-5, "the sword at the guard bobs")
    }
    print(f"the sword at rest: {clear} m clear of the cape, rising and falling {high - low} m")
    assert(clear >= 0.12, f"the sword at rest is only {clear} m clear of the cape")
    assert(high - low > 1.5 * moves::SWORD_BOB, f"the sword at rest bobs only {high - low} m")
}

/// A cut leaves a trail; the wind-up before it and the floating blade leave none, and a blink
/// starts it afresh.
@test
fn a_cut_leaves_a_trail_and_a_float_none() {
    let dt = 1.0 / 60.0
    var t = draw::trail()
    let blade = |p: moves::Pose| {
        let (at, aim, _) = p.sword.placed(vec3(0.0), 0.0)
        (at + aim * 0.7, at + aim * body::POINT_AT)
    }
    for k in 0..30 {
        let p = moves::locomotion(
            ready: 1.0,
            speed: 3.0,
            accel: 0.0,
            turning: 0.0,
            drift: f32(k) / 30.0,
        )
        let (inner, tip) = blade(p)
        t.after(inner, tip, afresh: k == 0, dt: dt)
        assert(!t.showing, "the floating blade leaves a trail")
    }
    let f = frames(Act::Slash)
    var shown_in_windup = false
    var shown_in_cut = false
    for k in 0..f.total {
        let (inner, tip) = blade(moves::pose(Act::Slash, f32(k)))
        t.after(inner, tip, afresh: false, dt: dt)
        if k + 2 < f.windup {
            shown_in_windup = shown_in_windup || t.showing
        }
        if f.is_active(k) {
            shown_in_cut = shown_in_cut || t.showing
        }
    }
    assert(!shown_in_windup, "the wind-up leaves a trail")
    assert(shown_in_cut, "the cut leaves no trail")
    let (inner, tip) = blade(moves::GUARD)
    t.after(inner, tip, afresh: true, dt: dt)
    assert(!t.showing, "a blink kept the trail")
}
