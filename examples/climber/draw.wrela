// The climber drawn (#30), as the floors draw characters where they can (`engine::character`:
// the motion target, the moving shadow map, a line round its silhouette): its garment from its
// cloth's points, written each frame (`figure`), as one surface in its own coat shading; and the
// sword, a field realized once as a mesh of one bone, in the characters' cel treatment.
//
// The garment's sheets are drawn as smooth spline surfaces through their points, finer than the
// cloth is simulated, with creases along them. The hood is the robe's top, open in front, its
// inside black. The robe's hem burns: the surface runs on past it a little, rising, and licks
// of shadow like flame are cut from the cloth's own edge.

use cape::{
    AROUND, DOWN, HOOD_ROWS, MANTLE_ROWS, MANTLE_SHEET, OPEN_HALF, OPEN_ROWS, POINTS, SLEEVE_ROUND,
    SLEEVE_ROWS, SLEEVE_SHEETS, body_frame,
}
use engine::character::{
    Cast, MotionVertex, PartOf, Realized, cast, character, character_motion, character_shade,
    character_shadow, materials, motion,
}
use engine::creature::{Creature, MAX_BONES}
use engine::gait::{between, palette}
use engine::light::CLAY
use engine::lit::{Lighting, sun_and_gloss, through_air}
use engine::look::{CreatureLook, Mesh as Tolerance}
use engine::noise::fbm2
use engine::probes::open_light
use engine::realize::realize_rigid
use engine::render::{ByChannels, Look}
use engine::shadow::CASTER
use engine::vegetation::nothing
use engine::view::{CREATURE, Camera, NEAREST, SEEN, VEIL}
use fight::{WOLF_BODY, WOLF_SKELETON, Wolf}
use figure::Figure
use look::{Paint, sword}
use moves::Pose
use std::gpu::{
    ClipPosition, Cull, Flat, GpuBuffer, RenderPass, VertexIndex, buffer, copy, discard, draw,
    write,
}
use std::math::TAU
use std::transform::translate

/// Each part's id, for the lines where parts meet: the garment is one.
const GARMENT_PART: u32 = 1
const SWORD_PART: u32 = 3

/// A creature of one bone realized: its mesh and colours (cells for a 3 mm tolerance, and no
/// wider than `largest`).
fn realized<K: Creature<Paint>>(c: K, largest: f32) -> Realized {
    let look = CreatureLook { surface: Tolerance { tolerance: 3mm, largest } }
    let mesh = realize_rigid(c, look)
    let materials = materials(mesh, c.field(), ByChannels {}, cell: min(largest, 1cm))
    Realized { mesh, materials }
}

/// A rigid part drawn (the sword): realized, its one bone's place this frame and the last, and
/// its part id.
pub struct Rigid {
    r: Realized,
    at: GpuBuffer<mat4>,
    was: GpuBuffer<mat4>,
    part: u32,
}

fn rigid<K: Creature<Paint>>(c: K, part: u32, largest: f32) -> Rigid {
    Rigid { r: realized(c, largest), at: buffer(1), was: buffer(1), part }
}

impl Rigid {
    /// Its bone placed at `m`; the last place kept unless `still`.
    fn place(mut self, m: mat4, still: bool) {
        if still {
            write(mut self.was, 0, [m])
        } else {
            copy(from: self.at.items(), to: self.was.items_mut())
        }
        write(mut self.at, 0, [m])
    }

    fn shadow<P: RenderPass>(self, pass: P, view: mat4) {
        draw(
            pass,
            character_shadow.bind(
                verts: self.r.mesh.verts.items(),
                palettes: self.at.items(),
                view: view,
            ),
            nothing,
            indices: self.r.mesh.quads.items(),
            indirect: self.r.mesh.draw.items(),
            depth_bias: CASTER,
        )
    }

    fn draw<P: RenderPass>(self, pass: P, lt: Lighting, cam: Camera) {
        draw(
            pass,
            character.bind(
                verts: self.r.mesh.verts.items(),
                materials: self.r.materials.items(),
                palettes: self.at.items(),
                parts: PartOf { of: [self.part; 64] },
                cam: cam,
            ),
            character_shade.bind(lt),
            indices: self.r.mesh.quads.items(),
            indirect: self.r.mesh.draw.items(),
            cull: Cull::Back,
            depth: NEAREST,
        )
    }

    fn motion<P: RenderPass>(self, pass: P, cam: Camera) {
        draw(
            pass,
            character_motion.bind(
                verts: self.r.mesh.verts.items(),
                palettes: self.at.items(),
                last: self.was.items(),
                cam: cam,
            ),
            motion.bind(cam),
            indices: self.r.mesh.quads.items(),
            indirect: self.r.mesh.draw.items(),
            cull: Cull::Back,
            depth: SEEN,
        )
    }
}

// ---- the garment ---------------------------------------------------------------------------------

/// A sheet of the garment as it's drawn: where its points start, how many round and down, how
/// many times finer it's drawn round and down, how deep its creases are at its foot (m), whether
/// its hem burns (1), and the rows (`open_rows`: from, before) and the columns either side of
/// straight ahead (`open_half`) left open (none where `open_rows` is empty).
pub struct Drawing: Copy + GpuData {
    pub open_rows: vec2u,
    pub first: u32,
    pub around: u32,
    pub down: u32,
    pub finer_round: u32,
    pub finer_down: u32,
    pub crease: f32,
    pub burns: u32,
    pub open_half: u32,
}

/// The drawn rows a burning hem runs on past its last: the licks' height, in the drawn grid.
const BURN_ROWS: u32 = 3

/// How many vertices a drawing has: two triangles a cell of its finer grid, and of its burning
/// edge.
fn vertices_of(d: Drawing) -> u32 {
    d.around * d.finer_round * ((d.down - 1) * d.finer_down + d.burns * BURN_ROWS) * 6
}

/// The garment's drawings: the hood and the robe as one, from the crown to the burning hem, open
/// at the face; the mantle; and the sleeves.
pub const DRAWINGS = [
    Drawing {
        first: 0,
        around: AROUND,
        down: HOOD_ROWS + DOWN,
        finer_round: 3,
        finer_down: 2,
        crease: 0.016,
        burns: 1,
        open_rows: OPEN_ROWS,
        open_half: OPEN_HALF,
    },
    Drawing {
        first: MANTLE_SHEET.first,
        around: AROUND,
        down: MANTLE_ROWS,
        finer_round: 3,
        finer_down: 2,
        crease: 0.01,
        burns: 0,
        open_rows: vec2u(0, 0),
        open_half: 0,
    },
    Drawing {
        first: SLEEVE_SHEETS[0].first,
        around: SLEEVE_ROUND,
        down: SLEEVE_ROWS,
        finer_round: 3,
        finer_down: 2,
        crease: 0.006,
        burns: 0,
        open_rows: vec2u(0, 0),
        open_half: 0,
    },
    Drawing {
        first: SLEEVE_SHEETS[1].first,
        around: SLEEVE_ROUND,
        down: SLEEVE_ROWS,
        finer_round: 3,
        finer_down: 2,
        crease: 0.006,
        burns: 0,
        open_rows: vec2u(0, 0),
        open_half: 0,
    },
]

/// The point `i` round and `j` down drawing `d`'s sheet.
fn sheet_point(points: [vec4], d: Drawing, i: u32, j: u32) -> vec3 {
    points[d.first + j * d.around + i % d.around].xyz
}

/// Catmull and Rom's spline through four points, `t` of the way from the second to the third.
fn catmull_rom(a: vec3, b: vec3, c: vec3, e: vec3, t: f32) -> vec3 {
    let t2 = t * t
    0.5 *
        (2.0 * b +
            (c - a) * t +
            (2.0 * a - 5.0 * b + 4.0 * c - e) * t2 +
            (3.0 * b - a - 3.0 * c + e) * t2 * t)
}

/// The smooth cloth through drawing `d`'s points at `uv` (columns round, rows down): a spline
/// through the four columns and four rows round it (round wraps; down holds at its ends).
fn cloth_at(points: [vec4], d: Drawing, uv: vec2) -> vec3 {
    // Round wraps: a column just before the first is one just before the last (a negative one
    // turned to a u32 is 0 on the GPU, and the cloth there would fold back on itself).
    let x = uv.x - floor(uv.x / f32(d.around)) * f32(d.around)
    let i = u32(floor(x)) % d.around
    let j = min(u32(floor(max(uv.y, 0.0))), d.down - 2)
    let t = vec2(x - floor(x), clamp(uv.y - f32(j), 0.0, 1.0))
    var rows = [vec3(0.0); 4]
    for r in 0..4 {
        let row = u32(clamp(i32(j) + i32(r) - 1, 0, i32(d.down) - 1))
        rows[r] = catmull_rom(
            sheet_point(points, d, i + d.around - 1, row),
            sheet_point(points, d, i, row),
            sheet_point(points, d, i + 1, row),
            sheet_point(points, d, i + 2, row),
            t.x,
        )
    }
    catmull_rom(rows[0], rows[1], rows[2], rows[3], t.y)
}

/// The cloth's creases at `uv` on drawing `d`: long folds that hang down it, uneven round it,
/// shallow at its top and deeper toward its foot (on the robe, running on down the train as the
/// lines it drags in). How far the cloth stands out (m, along its normal), how fast that changes
/// round it (m a column), and how far it is from a valley (-1) to a crest (1).
fn crease(d: Drawing, uv: vec2) -> (f32, f32, f32) {
    let a = TAU * uv.x / f32(d.around)
    let n = f32(d.around) / 32.0
    let depth = d.crease * (0.2 + 0.8 * smoothstep(0.0, f32(d.down - 1), uv.y))
    let k1 = max(round(13.0 * n), 3.0)
    let k2 = max(round(21.0 * n), 5.0)
    let p1 = k1 * a + 1.7 * sin(3.0 * a) + 0.15 * uv.y
    let p2 = k2 * a + 0.9 + 0.25 * uv.y
    let f = 0.6 * sin(p1) + 0.4 * sin(p2)
    let df = (0.6 * cos(p1) * (k1 + 5.1 * cos(3.0 * a)) + 0.4 * cos(p2) * k2) * TAU / f32(d.around)
    (depth * f, depth * df, f)
}

/// Vertex `v`'s place on drawing `d`: how far round (in columns) and down (in rows; past the
/// last row, the burning edge). A cell left open (the face's) is drawn as nothing: all its
/// corners at one place.
fn drawn_uv(d: Drawing, v: u32) -> vec2 {
    let cell = v / 6
    let c = v % 6
    let round = d.around * d.finer_round
    let (cu, cv) = (cell % round, cell / round)
    let col = cu / d.finer_round
    let row = cv / d.finer_down
    let open = row >= d.open_rows.x &&
        row < d.open_rows.y &&
        (col < d.open_half || col >= d.around - d.open_half)
    let di = if open { [0, 0, 0, 0, 0, 0] } else { [0, 1, 0, 0, 1, 1] }
    let dj = if open { [0, 0, 0, 0, 0, 0] } else { [0, 0, 1, 1, 0, 1] }
    vec2(
        f32(cu + di[c]) / f32(d.finer_round),
        f32(cv + dj[c]) / f32(d.finer_down),
    )
}

/// How high the licks rise off a burning hem (m), and how far a metre a second of the body's
/// speed leans them back (s).
const LICK_RISE: f32 = 0.34
const LICK_LEAN: f32 = 0.05

/// How far into drawing `d`'s burning edge `uv` is: below 0 on the cloth (in rows up from the
/// hem), 0 to 1 over the licks' height.
fn burn_of(d: Drawing, uv: vec2) -> f32 {
    (uv.y - f32(d.down - 1)) / (f32(BURN_ROWS) / f32(d.finer_down))
}

/// Drawing `d`'s place at `uv`, before its creases: the cloth; past its hem, the burning edge
/// rising off it, leaning back by `lean` (m) toward its tips.
fn garment_at(points: [vec4], d: Drawing, uv: vec2, lean: vec3) -> vec3 {
    let s = burn_of(d, uv)
    if s <= 0.0 {
        return cloth_at(points, d, uv)
    }
    let last = f32(d.down - 1)
    let hem = cloth_at(points, d, vec2(uv.x, last))
    let out = hem - cloth_at(points, d, vec2(uv.x, last - 0.3))
    let away = if length(out) > 1.0e-5 { normalize(out) } else { vec3(0.0) }
    hem + away * (0.05 * s) + vec3(0.0, LICK_RISE * s, 0.0) + lean * s
}

/// A point of the garment as drawn: where it is, its normal as its creases turn it and as the
/// cloth's own surface faces (outward: which side of the cloth is seen), the way down the cloth
/// there, where it is on its sheet (columns round, rows down), how far from a crease's valley to
/// its crest (-1 to 1), how far into the burning edge (`burn_of`), and whether its sheet burns.
pub struct GarmentVertex: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub normal: vec3,
    pub outward: vec3,
    pub down: vec3,
    pub uv: vec2,
    pub fold: f32,
    pub burn: f32,
    pub burns: Flat<u32>,
}

/// The garment drawn: the smooth cloth through its points, its creases standing out along its
/// normal, and that normal turned by the creases' slopes; past a burning hem, its licks.
@vertex
pub fn garment_vertex(
    v: VertexIndex,
    points: [vec4],
    d: Drawing,
    lean: vec3,
    cam: Camera,
) -> GarmentVertex {
    let uv = drawn_uv(d, v.index)
    let burn = burn_of(d, uv)
    if burn > 0.0 && d.burns != 0 {
        let p = garment_at(points, d, uv, lean)
        return GarmentVertex {
            clip: ClipPosition { position: cam.clip(p) },
            world: p,
            normal: vec3(0.0, 1.0, 0.0),
            outward: vec3(0.0, 1.0, 0.0),
            down: vec3(0.0, -1.0, 0.0),
            uv,
            fold: 0.0,
            burn,
            burns: Flat { value: 1 },
        }
    }
    let e = 0.25
    let last = f32(d.down - 1)
    let p = cloth_at(points, d, uv)
    let around = cloth_at(points, d, uv + vec2(e, 0.0)) - cloth_at(points, d, uv - vec2(e, 0.0))
    let down = cloth_at(points, d, vec2(uv.x, min(uv.y + e, last))) -
        cloth_at(points, d, vec2(uv.x, max(uv.y - e, 0.0)))
    let n = normalize(cross(down, around) + vec3(0.0, 1.0e-6, 0.0))
    let (out, slope, fold) = crease(d, uv)
    // A crease tips the normal by its slope across the cloth, but never far: on the hood's small
    // rings a column is a few millimetres, and an untamed slope there turns it right over.
    let per_column = max(length(around) / (2.0 * e), 1.0e-4)
    let tip = clamp(slope / per_column, -0.6, 0.6)
    let turned = normalize(n - normalize(around + vec3(1.0e-6, 0.0, 0.0)) * tip)
    let at = p + n * out
    GarmentVertex {
        clip: ClipPosition { position: cam.clip(at) },
        world: at,
        normal: turned,
        outward: n,
        down: normalize(down + vec3(0.0, -1.0e-6, 0.0)),
        uv,
        fold,
        burn,
        burns: Flat { value: d.burns },
    }
}

@vertex
pub fn garment_motion(
    v: VertexIndex,
    points: [vec4],
    last: [vec4],
    d: Drawing,
    lean: vec3,
    cam: Camera,
) -> MotionVertex {
    let uv = drawn_uv(d, v.index)
    let now = garment_at(points, d, uv, lean)
    MotionVertex {
        clip: ClipPosition { position: cam.clip(now) },
        now,
        then: garment_at(last, d, uv, lean),
    }
}

/// The garment cast into a shadow map: its cloth, not its licks (all of a lick's corners on the
/// hem: it casts nothing).
@vertex
pub fn garment_shadow(v: VertexIndex, points: [vec4], d: Drawing, view: mat4) -> ClipPosition {
    let uv = drawn_uv(d, v.index)
    let on = vec2(uv.x, min(uv.y, f32(d.down - 1)))
    ClipPosition { position: view * vec4(cloth_at(points, d, on), 1.0) }
}

// ---- the coat's shading ----------------------------------------------------------------------------

/// The coat's colour, and the cool light its fibres scatter where it turns from the eye.
const COAT = vec3(0.011, 0.011, 0.015)
const SHEEN = vec3(0.05, 0.055, 0.075)

/// The coat at a point (`n` its normal, `fold` from a crease's valley to its crest), in the
/// characters' cel manner but its own: two bands, the lit and the shade, with a soft terminator,
/// the valleys a little darker; and no gloss, which on black reads as wet latex. Heavy cloth reads
/// by its fibres instead: a soft cool sheen that grows toward the edge of the form (a velvet's
/// light, its fibres catching what's behind them), brighter on the lit side and where the sun is
/// behind it, and less down in the creases.
fn coat(lt: Lighting, world: vec3, n: vec3, fold: f32) -> vec3 {
    let l = lt.light.sun
    let v = normalize(lt.cam.eye - world)
    let (sun, sky, _) = sun_and_gloss(lt, world, n, soft: 1.0)
    let open = open_light(lt.probes, vec3(0.0, 1.0, 0.0))
    let lit = lt.light.sun_colour * 0.75 + open * 0.5
    let shade = vec3(0.36, 0.4, 0.54) * (0.45 + 0.55 * saturate(dot(sky, vec3(0.6))))
    let t = smoothstep(-0.05, 0.15, dot(n, l)) * sun
    if lt.light.clay != 0 {
        return CLAY * mix(shade, lit, vec3(t))
    }
    let valley = 1.0 - smoothstep(-0.6, 0.0, fold)
    let c = COAT * mix(shade, lit, vec3(t)) * (1.0 - 0.3 * valley)
    let away = 1.0 - max(dot(n, v), 0.0)
    let behind = saturate(-dot(v, l))
    let fibres = pow(away, 2.5) * (1.0 - 0.6 * valley)
    let light = open * 0.5 + lt.light.sun_colour * (0.35 * t + 0.6 * behind * sun)
    c + SHEEN * light * fibres
}

// ---- the licks of shadow ---------------------------------------------------------------------------

/// The licks' core: black, a little cold; and their edge, a thin band of a deep violet where each
/// lick's shape ends (and where the cloth's edge burns), so black flame reads against black
/// cloth. It's their own light, not the sun's. (Picked from violet, cold blue, ember and pale
/// grey edges.)
const INK = vec3(0.002, 0.002, 0.0035)
const EDGE = vec3(0.055, 0.02, 0.14)
const EDGE_BAND: f32 = 0.05

/// How far inside the licks a point of a burning edge is (above 0 inside; its edge at 0), `u`
/// columns round the hem (of `around`) and `burn` into it (`burn_of`): a low band of shadow-fire
/// all along the edge, and tongues rising out of it, about one a column, full at their roots
/// and drawn to points, tall and short, swaying round the hem and torn by noise that runs up
/// them fast, so tips fork and reform; tallest along the train behind. Below the hem, the cloth,
/// solid, but for notches the band eats out of its edge.
fn licks(u: f32, around: f32, burn: f32, time: f32) -> f32 {
    let a = TAU * u / around
    let behind = 0.5 - 0.5 * cos(a)
    let sway = 0.7 * sin(u * 0.8 + time * 1.3) + 0.5 * burn * sin(u * 1.9 - time * 4.5)
    let fine = 0.5 + 0.5 * sin(u * TAU / 1.05 + sway + time * 0.9)
    let broad = 0.5 + 0.5 * sin(u * TAU / 3.1 - 0.7 * sway + time * 0.4)
    let tongue = pow(fine, 1.8) * (0.4 + 0.6 * broad)
    let run = fbm2(vec2(u * 1.6 + 3.0, burn * 2.4 - time * 4.2), 3)
    let reach = (0.22 + 0.78 * tongue) * mix(0.7, 1.15, behind)
    reach * (0.7 + 0.6 * run) - burn - 0.06 + 2.5 * max(-burn, 0.0)
}

/// The garment's pixel: on its outside, the coat; on its inside (the hood's tunnel, a sleeve's
/// mouth), black; at a burning hem, the cloth charred toward its edge and the licks of shadow
/// cut from it, hard-edged; through the haze. The cloth is tagged as the climber's, the licks as
/// a veil, so no line is drawn round each tongue.
@fragment
pub fn garment_shade(g: GarmentVertex, lt: Lighting) -> vec4 {
    var colour = vec3(0.0)
    var burning = false
    var inside = 1.0
    if g.burns.value != 0 && g.burn > -1.2 {
        inside = licks(g.uv.x, f32(AROUND), burn: g.burn, time: lt.cam.time)
        if inside <= 0.0 {
            discard()
        }
        burning = g.burn > 0.0
    }
    let n = normalize(g.normal)
    if burning {
        colour = INK
    } else if dot(g.outward, lt.cam.eye - g.world) < 0.0 {
        colour = vec3(0.0)
    } else {
        colour = coat(lt, g.world, n, g.fold)
        if g.burns.value != 0 {
            colour = mix(colour, INK, vec3(smoothstep(-1.2, 0.0, g.burn)))
        }
    }
    if inside < EDGE_BAND {
        colour = EDGE
    }
    let tag = if burning { VEIL } else { CREATURE + f32(GARMENT_PART) }
    vec4(through_air(lt, colour, g.world), tag)
}

// ---- the climber -------------------------------------------------------------------------------

/// The climber as it's drawn: the garment's points this frame and the last (for the motion
/// target), how far its licks lean back, and the sword; whether it's been written yet, and
/// whether it's shown (not while a blink has it gone).
pub struct Drawn {
    points: GpuBuffer<vec4>,
    last_points: GpuBuffer<vec4>,
    lean: vec3,
    sword: Rigid,
    written: bool,
    shown: bool,
}

/// The climber ready to draw: its sword realized (once, at load).
pub fn drawn() -> Drawn {
    Drawn {
        points: buffer(POINTS),
        last_points: buffer(POINTS),
        lean: vec3(0.0),
        sword: rigid(sword(), SWORD_PART, largest: 12mm),
        written: false,
        shown: false,
    }
}

/// The sword's bone in the world: the grip at `at`, its point along `aim`, its edge along `edge`.
fn sword_bone(at: vec3, aim: vec3, edge: vec3) -> mat4 {
    mat4(vec4(edge, 0.0), vec4(aim, 0.0), vec4(cross(edge, aim), 0.0), vec4(at, 1.0))
}

impl Drawn {
    /// This frame's figure `f` written to be drawn, the body at `feet` facing `heading` in
    /// `pose`; not shown while `gone` (a blink). The last frame's places are kept for the motion
    /// target, unless `still` (the first frame, or the render origin moved: the last frame's are
    /// in another space).
    pub fn write(
        mut self,
        f: Figure,
        feet: vec3,
        heading: f32,
        pose: Pose,
        gone: bool,
        still: bool,
    ) {
        let points = f.points()
        if points.len() < POINTS {
            return
        }
        let still = still || !self.written
        self.written = true
        if !still {
            copy(from: self.points.items(), to: self.last_points.items_mut())
        }
        write(mut self.points, 0, points.clone())
        if still {
            write(mut self.last_points, 0, points)
        }
        let back = -f.velocity * LICK_LEAN
        self.lean = if length(back) > 0.3 { normalize(back) * 0.3 } else { back }
        let (at, aim, edge) = pose.sword.placed(feet, heading)
        self.sword.place(sword_bone(at, aim, edge), still)
        self.shown = !gone
    }

    /// The garment and the sword cast into a shadow map (`view` its view).
    pub fn shadow<P: RenderPass>(self, pass: P, view: mat4) {
        if !self.shown {
            return
        }
        for d in DRAWINGS {
            draw(
                pass,
                garment_shadow.bind(points: self.points.items(), d: d, view: view),
                nothing,
                vertices: vertices_of(d),
                cull: Cull::None,
                depth_bias: CASTER,
            )
        }
        self.sword.shadow(pass, view)
    }

    /// The climber drawn into the scene: its garment and its sword.
    pub fn draw<P: RenderPass>(self, pass: P, lt: Lighting, cam: Camera) {
        if !self.shown {
            return
        }
        for d in DRAWINGS {
            draw(
                pass,
                garment_vertex.bind(points: self.points.items(), d: d, lean: self.lean, cam: cam),
                garment_shade.bind(lt),
                vertices: vertices_of(d),
                cull: Cull::None,
                depth: NEAREST,
            )
        }
        self.sword.draw(pass, lt, cam)
    }

    /// The climber's motion, from the actual preceding cloth and sword positions.
    pub fn motion<P: RenderPass>(self, pass: P, cam: Camera) {
        if !self.shown {
            return
        }
        for d in DRAWINGS {
            draw(
                pass,
                garment_motion.bind(
                    points: self.points.items(),
                    last: self.last_points.items(),
                    d: d,
                    lean: self.lean,
                    cam: cam,
                ),
                motion.bind(cam),
                vertices: vertices_of(d),
                cull: Cull::None,
                depth: SEEN,
            )
        }
        self.sword.motion(pass, cam)
    }
}

// ---- the wolf ------------------------------------------------------------------------------------

/// The wolf's colours: its coat's.
pub struct WolfCoat: Copy + GpuData {}

impl Look<wolf::creature::Coat> for WolfCoat {
    fn surface(self, c: wolf::creature::Coat, rest: vec3, fp: f32) -> (vec3, f32) {
        (vec3(c.albedo.r, c.albedo.g, c.albedo.b), 0.8)
    }
}

/// The wolf, built.
pub type WolfGrown = Creature<wolf::creature::Coat>

fn grown_wolf() -> WolfGrown {
    wolf::creature::wolf()
}

/// The wolf as a floor casts it (`engine::character::Cast`): realized at 1 cm, a slice a frame.
pub type CastWolf = Cast<wolf::creature::Coat, WolfGrown, WolfCoat>

pub fn cast_wolf() -> CastWolf {
    let how = CreatureLook { surface: Tolerance { tolerance: 1cm } }
    cast(grown_wolf(), WolfCoat {}, how, slices: 1)
}

/// The wolf's palette between its ticks `a` and `b` (`alpha` of the way), in a render space
/// whose origin is `origin`.
pub fn wolf_bones(a: Wolf, b: Wolf, alpha: f32, origin: vec3) -> [mat4; MAX_BONES] {
    let walker = between(a.walker, b.walker, alpha)
    let posed = palette(WOLF_SKELETON, WOLF_BODY, walker).bones
    let to_render = translate(-origin)
    var bones = posed
    for i in 0..MAX_BONES {
        bones[i] = to_render * posed[i]
    }
    bones
}

// ---- tests -------------------------------------------------------------------------------------

/// How high the licks reach at `u` round the hem (in the burning edge's measure), at `time`.
fn reach_at(u: f32, time: f32) -> f32 {
    var top = 0.0
    for k in 0..80 {
        let burn = f32(k) / 50.0
        if licks(u, f32(AROUND), burn: burn, time: time) > 0.0 {
            top = burn
        }
    }
    top
}

/// The licks grow out of the cloth's own edge: the hem is solid cloth a little above its edge
/// everywhere, a band of shadow-fire runs all along the edge, and tongues rise out of it, never
/// as tall as a column of smoke, taller along the train behind than in front; and they move.
@test
fn the_licks_rise_from_the_hem_tallest_behind() {
    var front = 0.0
    var back = 0.0
    var changed = 0.0
    for k in 0..64 {
        let u = f32(k) * 0.5
        assert(licks(u, f32(AROUND), burn: -0.6, time: 1.0) > 0.0, "the cloth above the hem is cut")
        assert(
            licks(u, f32(AROUND), burn: 0.02, time: 1.0) > 0.0,
            "the burning band breaks along the hem",
        )
        let r = reach_at(u, 1.0)
        assert(r < 1.6, f"a lick reaches {r}: a column, not a lick")
        let a = TAU * u / f32(AROUND)
        if cos(a) > 0.7 {
            front = max(front, r)
        }
        if cos(a) < -0.7 {
            back = max(back, r)
        }
        changed = max(changed, abs(r - reach_at(u, 1.4)))
    }
    assert(back > front + 0.1, f"the licks reach {back} behind and {front} in front")
    assert(changed > 0.1, "the licks don't move")
}

/// The face's cells are left open on the hood; everywhere else the garment is whole.
@test
fn the_face_is_left_open() {
    let d = DRAWINGS[0]
    let round = d.around * d.finer_round
    var open = 0
    var whole = 0
    for cell in 0..(round * (d.down - 1) * d.finer_down) {
        let uv = drawn_uv(d, cell * 6 + 1)
        let corner = drawn_uv(d, cell * 6)
        let col = (cell % round) / d.finer_round
        let row = (cell / round) / d.finer_down
        let face = row >= OPEN_ROWS.x &&
            row < OPEN_ROWS.y &&
            (col < OPEN_HALF || col >= AROUND - OPEN_HALF)
        if face {
            assert(length(uv - corner) == 0.0, "a cell of the face is drawn")
            open += 1
        } else {
            assert(length(uv - corner) > 0.0, "a cell of the garment is left open")
            whole += 1
        }
    }
    assert(open > 0 && whole > open * 20, "the face's opening is the wrong size")
}
