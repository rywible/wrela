// The fight's simulation (#30): the climber against the wolf on any ground (`Terrain`: the arena's
// is level, the Last Green's its own), stepped on the ticker's thread at 60 Hz (`engine::run`),
// deterministic, so a tick log replays to the same state hash in both hosts.
//
// The climber is one character: its body is the engine's player (`engine::player`), which walks
// and runs it and turns its look, and its moves are this module's, which carry that same body as
// footing lets them (`step`). Moves work anywhere; the wolf, when there is one, is only their
// mark. The walk and the look are the engine player's controls (the left stick, the keys, the
// mouse); the moves are presses (`Actions`): East, or Space, is a blink (gone, and there again a
// few metres away the way the stick points), the right shoulder, West, J or (with the mouse
// locked to the game) its left button swings the sword, a slash then a backslash. A press is
// buffered for a few ticks, so a move pressed late in another starts when that one can be
// cancelled; the stick cancels a move's recovery, and the body goes on at the pace the stick
// asks. Moves cost stamina, which comes back after a pause.
//
// The wolf is a sparring dummy on the engine's gait: it closes in, crouches (its tell), lunges
// and bites, then recovers. The sword's edge hits it as a swept segment against capsules on its
// body; its bite is a sphere at its head against a capsule up the climber's middle, who can't be
// hurt in the blink's invulnerable ticks. A hit stops both for a few ticks (the hit stop).
//
//   wolf:  Prowl ──in range, facing──► Crouch (30) ──► Lunge (16: bites 3–12) ──► Recover (40)
//            ▲                                                                        │
//            └────────────────────────── Flinch (20) ◄── a blade hit ─────────────────┘
//                                         Down (200) when its health runs out, then up again

use engine::gait::{Body, Path, Walk, Walker, body, body_frame, stand, step as gait_step}
use engine::creature::Skeleton
use engine::footing::Obstacles
use engine::grow::Ground
use engine::place::{Place, Water}
use engine::player::{
    Motion, Player, carry, control, look_toward, resume, spawn as body_at, step_with, turn_look,
    wish,
}
use engine::present::short_way
use engine::run::{Asks, TickInput}
use engine::sim::{SimState, Tick}
use body::{BODY_HIGH, BODY_LOW, BODY_RADIUS, GUARD_AT, POINT_AT}
use moves::{Act, BLINK_GONE, Pose, REST, drift_rate, frames, locomotion, pose}
use engine::terrain::{Cover, Terrain}
use std::field::Blend
use std::hash::StateHash
use std::input::{Button, Event, Key, PadButton}
use std::math::{PI, TAU}
use std::serialize::Serialize

// ---- the presses ---------------------------------------------------------------------------------

/// The buttons the moves answer, as the tick's records left them: pad 0's (East the blink; the
/// right shoulder and West the sword), the keys that stand in (Space, J), and the mouse's left
/// button while the pointer is locked to the game (its last move said so). A move starts on its
/// press, not on its release.
pub struct Actions: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub east_pad: bool = false,
    pub attack_pad: bool = false,
    pub west_pad: bool = false,
    pub space: bool = false,
    pub j: bool = false,
    pub locked: bool = false,
    pub mouse: bool = false,
}

impl Actions {
    /// After event `e` (pad 0's, the keyboard's and the pointer's).
    pub fn update(mut self, e: Event) {
        match e {
            Event::PadButton { pad, button, pressed, .. } => {
                if pad == 0 {
                    if button == PadButton::East {
                        self.east_pad = pressed
                    }
                    if button == PadButton::RightShoulder {
                        self.attack_pad = pressed
                    }
                    if button == PadButton::West {
                        self.west_pad = pressed
                    }
                }
            },
            Event::KeyDown { key, repeat, .. } => {
                if !repeat {
                    if key == Key::Space {
                        self.space = true
                    }
                    if key == Key::J {
                        self.j = true
                    }
                }
            },
            Event::KeyUp { key, .. } => {
                if key == Key::Space {
                    self.space = false
                }
                if key == Key::J {
                    self.j = false
                }
            },
            Event::PointerMove { locked, .. } => {
                self.locked = locked
                if !locked {
                    self.mouse = false
                }
            },
            Event::PointerDown { button, .. } => {
                if button == Button::Primary && self.locked {
                    self.mouse = true
                }
            },
            Event::PointerUp { button, .. } => {
                if button == Button::Primary {
                    self.mouse = false
                }
            },
            _ => {},
        }
    }

    pub fn dodge(self) -> bool {
        self.east_pad || self.space
    }

    pub fn attack(self) -> bool {
        self.attack_pad || self.west_pad || self.mouse || self.j
    }
}

// ---- the climber -----------------------------------------------------------------------------------

/// The climber as its moves have it. Its body is the engine player's (`step`): where it stands
/// on the ground (the middle of its hem), which way it faces and how fast it goes (m/s) are the
/// body's, as the tick left it, for the moves, the hits and the frames.
pub struct Climber: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub at: vec3,
    pub heading: f32,
    pub speed: f32,
    /// How fast its speed changes (m/s², eased) and how fast it turns (rad/s, eased): its lean;
    /// its float's phase (0 to 1); and how far its sword has come to the guard (0 to 1).
    pub accel: f32,
    pub turning: f32,
    pub drift: f32,
    pub ready: f32,
    /// What it's doing, for how many ticks, and which way the move carries it (on the plane).
    pub act: Act,
    pub t: u32,
    pub going: vec2,
    /// Its pose as the move began, and how many ticks it has blended from it.
    pub from: Pose,
    pub fade: u32,
    /// A move pressed and waiting for its turn, and for how many more ticks it waits.
    pub buffered: Act,
    pub buffer: u32,
    pub stamina: f32,
    /// Ticks since stamina was last spent.
    pub rested: u32,
    pub health: f32,
    /// Whether the move in hand has hit already.
    pub landed: bool,
}

pub const STAMINA: f32 = 100.0
pub const HEALTH: f32 = 100.0

/// The climber's motion: a brisk floating walk, a run, and the engine's quick answer to the stick
/// (`engine::player::Motion`). A game adds its own clearance or follow to it.
pub const MOTION = Motion { walk: 3.0, run: 7.5 }

/// How long a press waits for its turn (ticks).
pub const BUFFER: u32 = 12

/// Stamina comes back at 45 a second after half a second unspent.
const REGEN: f32 = 45.0
const REGEN_AFTER: u32 = 30

fn new_climber<G: Terrain>(ground: G, at: vec2, heading: f32) -> Climber {
    Climber {
        at: vec3(at.x, ground.height(at.x, at.y), at.y),
        heading,
        speed: 0.0,
        accel: 0.0,
        turning: 0.0,
        drift: 0.0,
        ready: 0.0,
        act: Act::Free,
        t: 0,
        going: vec2(sin(heading), cos(heading)),
        from: REST,
        fade: 0,
        buffered: Act::Free,
        buffer: 0,
        stamina: STAMINA,
        rested: 0,
        health: HEALTH,
        landed: false,
    }
}

/// How many ticks a blend into `a` takes.
fn fade_into(a: Act) -> u32 {
    match a {
        Act::Free => 8,
        Act::Slash => 4,
        Act::Backslash => 3,
        Act::Blink => 2,
        Act::Hurt => 2,
        Act::Down => 6,
    }
}

impl Climber {
    pub fn forward(self) -> vec2 {
        vec2(sin(self.heading), cos(self.heading))
    }

    /// Starts `a`, blending from its pose now.
    pub fn start(mut self, a: Act) {
        self.from = self.pose(0.0)
        self.fade = 0
        self.act = a
        self.t = 0
        self.landed = false
        self.going = self.forward()
        let f = frames(a)
        if f.stamina > 0.0 {
            self.stamina -= f.stamina
            self.rested = 0
        }
    }

    /// Whether it's free to start a move now: free, or late enough in its move.
    fn can_start(self) -> bool {
        self.act == Act::Free || (self.act != Act::Down && self.t >= frames(self.act).cancel)
    }

    /// Whether a move has its pose: in a move, or settling out of one into its glide.
    pub fn moving(self) -> bool {
        self.act != Act::Free || self.fade < fade_into(Act::Free)
    }

    /// Whether it can't be hurt now (the blink's invulnerable ticks, or down).
    pub fn invulnerable(self) -> bool {
        self.act == Act::Down ||
            (self.act == Act::Blink && frames(Act::Blink).is_invulnerable(self.t))
    }

    /// Whether it's between its two places in a blink (drawn as gone).
    pub fn gone(self) -> bool {
        self.act == Act::Blink && self.t >= BLINK_GONE.x && self.t < BLINK_GONE.y
    }

    /// The pose it's drawn in, and hits with: its move's (or its glide's), blended from where the
    /// move began for the blend's first ticks; `sub` ticks on (0 to 1, between ticks).
    pub fn pose(self, sub: f32) -> Pose {
        let now = if self.act == Act::Free {
            locomotion(self.ready, self.speed, self.accel, self.turning, self.drift)
        } else {
            pose(self.act, f32(self.t) + sub)
        }
        let f = (f32(self.fade) + sub) / f32(fade_into(self.act))
        if f >= 1.0 {
            return now
        }
        // Eased out: the move shows at once, then settles into its own pose.
        self.from.blend(now, 1.0 - (1.0 - f) * (1.0 - f))
    }
}

// ---- the wolf ----------------------------------------------------------------------------------------

/// What the wolf is doing.
pub enum Mood: Copy + Eq + Plain + StateHash + Serialize + SimState + Fieldless {
    Prowl,
    Crouch,
    Lunge,
    Recover,
    Flinch,
    Down,
}

/// How long each of its moods lasts (ticks), and the bite's active ticks within the lunge.
pub const CROUCH: u32 = 30
pub const LUNGE: u32 = 16
pub const BITE: vec2u = vec2u(3, 12)
pub const RECOVER: u32 = 40
pub const FLINCH: u32 = 20
pub const WOLF_DOWN: u32 = 200
pub const WOLF_HEALTH: f32 = 100.0
pub const BITE_DAMAGE: f32 = 25.0

pub struct Wolf: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub walker: Walker,
    pub mood: Mood,
    pub t: u32,
    pub health: f32,
    /// Where the lunge goes (on the plane), whether it has bitten, and whether the climber
    /// blinked through it.
    pub aim: vec2,
    pub bit: bool,
    pub dodged: bool,
    /// Ticks before it may crouch again.
    pub wait: u32,
    /// Which way the last hit pushed it (on the plane).
    pub pushed: vec2,
    /// Where it circles out to, and for how many more ticks.
    pub goal: vec2,
    pub circle: u32,
}

/// The wolf's skeleton, and its body for walking: springs on its neck and tail. Found once.
pub const WOLF_SKELETON: Skeleton = wolf::creature::skeleton()
pub const WOLF_BODY: Body = wolf_body()

fn wolf_body() -> Body {
    let s = WOLF_SKELETON
    body(
        s,
        [s.find("neck"), s.find("head")],
        [s.find("tail 0"), s.find("tail 1"), s.find("tail 2"), s.find("tail 3")],
        head_k: 90.0,
        tail_k: 30.0,
    )
}

/// How it walks when it prowls, when it turns where it stands, and how it bounds when it lunges.
const PROWL = Walk { speed: 1.3, steer: 2.2, look_ahead: 1.2 }
const TURN = Walk { speed: 0.45, steer: 3.0, look_ahead: 1.0 }
const BOUND = Walk {
    speed: 6.5,
    duty: 0.35,
    lift: 0.16,
    offsets: [0.0, 0.08, 0.5, 0.58],
    steer: 0.3,
    look_ahead: 3.0,
}

/// Where it keeps from the climber (m), and how near and far a lunge starts.
const KEEP: f32 = 2.6
const LUNGE_FROM: vec2 = vec2(1.4, 3.6)

/// A straight path: from a point, along a direction, so long.
struct Toward: Copy {
    from: vec2,
    dir: vec2,
    length: f32,
}

impl Path for Toward {
    fn at(self, s: f32) -> vec2 {
        self.from + self.dir * s
    }

    fn length(self) -> f32 {
        self.length
    }
}

impl Wolf {
    pub fn pos(self) -> vec2 {
        self.walker.root.pos.xz
    }

    pub fn forward(self) -> vec2 {
        vec2(sin(self.walker.root.heading), cos(self.walker.root.heading))
    }

    /// A rest joint of its skeleton, where its body has it now (its legs aside).
    pub fn joint(self, rest: vec3) -> vec3 {
        (body_frame(self.walker) * vec4(rest, 1.0)).xyz
    }

    /// Its bite: a sphere at its jaws.
    pub fn jaws(self) -> vec3 {
        self.joint(wolf::creature::J_HEAD + vec3(0.0, -0.05, 0.2))
    }
}

pub const BITE_RADIUS: f32 = 0.28

pub fn new_wolf<G: Terrain>(ground: G, at: vec2, heading: f32) -> Wolf {
    Wolf {
        walker: stand(ground, WOLF_BODY, at, heading),
        mood: Mood::Prowl,
        t: 0,
        health: WOLF_HEALTH,
        aim: vec2(0.0),
        bit: false,
        dodged: false,
        wait: 90,
        pushed: vec2(0.0),
        goal: at,
        circle: 0,
    }
}

// ---- the world -----------------------------------------------------------------------------------------

/// What happened, counted: for the tests, and for the frames (a count that changes is an event).
pub struct Tally: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub swings: u32 = 0,
    pub hits: u32 = 0,
    pub lunges: u32 = 0,
    pub bites: u32 = 0,
    pub dodged: u32 = 0,
    pub blinks: u32 = 0,
    pub wolf_downs: u32 = 0,
    pub climber_downs: u32 = 0,
}

/// The fight: the climber's moves, the wolf, the presses the moves answer, the hit stop and
/// what happened. The climber's body is the engine player's, stepped with it (`step`).
pub struct World: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub climber: Climber,
    pub wolf: Wolf,
    pub actions: Actions,
    /// Ticks of hit stop left: while it lasts, the climber and the wolf hold still.
    pub stop: u32,
    pub tally: Tally,
    pub ticks: u32,
}

/// Level ground at height 0 under short grass, with no edge and no rock: the arena's, the lab's
/// and the tests'.
pub struct Level: Copy + GpuData {}

impl Terrain for Level {
    fn height(self, x: f32, z: f32) -> f32 {
        0.0
    }

    fn cover(self, at: vec3, n: vec3) -> Cover {
        Cover { albedo: vec3(0.1, 0.16, 0.05), grass: 0.3, tall: 0.1 }
    }
}

impl Ground for Level {
    fn height(self, x: f32, z: f32) -> f32 {
        0.0
    }

    fn past_edge(self, p: vec2) -> f32 {
        -1000.0
    }

    fn rock(self, p: vec2) -> f32 {
        0.0
    }
}

/// No water, and nothing in the way: level ground's.
pub fn dry() -> Water {
    Water {
        meres: [vec4(0.0), vec4(0.0)],
        springs: [vec2(0.0), ..vec2(0.0)],
        spring_count: 0,
        falls: [vec2(0.0), vec2(0.0)],
    }
}

pub fn open() -> Obstacles {
    let nothing: Vec<engine::footing::Obstacle> = Vec::new()
    Obstacles::of(nothing, vec2(-512.0), vec2(512.0))
}

/// Where the fight starts: the climber, and the wolf 7.6 m ahead, facing it.
pub const CLIMBER_START = vec2(-2.5, 19.5)
pub const WOLF_START = vec2(0.5, 26.5)

/// A fight's start on `ground`: the climber at `climber`, the wolf at `wolf`, each facing the
/// other.
pub fn spawn_on<G: Terrain>(ground: G, climber: vec2, wolf: vec2) -> World {
    let to = wolf - climber
    let heading = atan2(to.x, to.y)
    World {
        climber: new_climber(ground, climber, heading),
        wolf: new_wolf(ground, wolf, heading + PI),
        actions: Actions {},
        stop: 0,
        tally: Tally {},
        ticks: 0,
    }
}

/// The fight alone, on level ground with nothing in the way: the climber's body and the fight
/// (the arena's, the lab's and the tests').
pub struct Duel: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub body: Player,
    pub fight: World,
}

impl Asks for Duel {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

/// The duel's start: the climber at `CLIMBER_START`, the wolf at `WOLF_START`, each facing the
/// other, the climber's look along its facing.
pub fn spawn() -> Duel {
    let fight = spawn_on(Level {}, CLIMBER_START, WOLF_START)
    Duel { body: body_at(Level {}, Place::of(CLIMBER_START), fight.climber.heading), fight }
}

/// How many ticks a hit stops the fight for.
pub const HIT_STOP: u32 = 5

/// One tick of the duel (`step`, with its wolf, on level ground with nothing in the way).
@deterministic
pub fn tick(d: mut Duel, input: TickInput<Duel>) {
    step(
        Level {},
        dry(),
        open(),
        MOTION,
        mut d.body,
        mut d.fight,
        input.records,
        wolf_on: true,
        dt: input.dt,
    )
}

/// One tick of the climber and its fight on `ground`, round `o`, through `water`: the records'
/// presses (the walk's and the look's to `body`'s controls, the moves' to the fight's); then,
/// unless a hit stopped it, the climber's tick on its body (`act`: a move, or the engine's walk
/// with `motion`); and if the fight has its wolf (`wolf_on`), the look turned to keep it in view,
/// the wolf's tick, the blade against it, its bite, and the two kept apart.
@deterministic
pub fn step<G: Terrain + Ground>(
    ground: G,
    water: Water,
    o: Obstacles,
    motion: Motion,
    body: mut Player,
    w: mut World,
    records: Vec<Event>,
    wolf_on: bool,
    dt: f32,
) {
    held(mut w.climber)
    for e in records {
        control(mut body.controls, e)
        let before = w.actions
        w.actions.update(e)
        press(mut w.climber, w.actions, before)
    }
    w.ticks += 1
    if w.stop > 0 {
        w.stop -= 1
        turn_look(mut body.controls, dt)
        return
    }
    let feet = body.at.world()
    let foe = if wolf_on && engaged(w) { Some(w.wolf.pos()) } else { None }
    if wolf_on {
        let (at, weight) = focus(w, feet)
        look_toward(mut body.controls, feet, at.xz, weight, dt)
    }
    act(ground, water, o, motion, mut body, mut w.climber, foe, dt, mut w.tally)
    if wolf_on {
        wolf_step(ground, mut w.wolf, w.climber, dt, mut w.tally)
        blade_hits(mut w)
        bite(mut w)
        let push = keep_apart(w.climber, w.wolf)
        if length(push) > 0.0 {
            carry(mut body, ground, water, o, push, body.heading, motion.clearance)
            let at = body.at.world()
            w.climber.at = vec3(at.x, body.y, at.y)
        }
    }
}

/// A beaten wolf's tick (a floor's, once its fight is won): it goes at its prowl the way `away`
/// points.
@deterministic
pub fn slink<G: Terrain>(ground: G, w: mut Wolf, away: vec2, dt: f32) {
    w.walker.along = 0.0
    let path = Toward { from: w.pos(), dir: away, length: 10.0 }
    gait_step(mut w.walker, ground, path, WOLF_BODY, PROWL, go: true, dt: dt)
}

/// How near the wolf is when the climber raises its guard and its moves turn to it (m).
const ENGAGE = 7.0

/// Whether the climber and the wolf are fighting: the wolf up and within `ENGAGE`.
pub fn engaged(w: World) -> bool {
    w.wolf.mood != Mood::Down && length(w.wolf.pos() - w.climber.at.xz) < ENGAGE
}

/// How near the wolf the look turns fully to keep it in view, and how far off it doesn't turn at
/// all (m).
pub const FOCUS_FULL: f32 = 7.0
pub const FOCUS_NONE: f32 = 25.0

/// What the look keeps in view in the fight, and how much, for a climber at `feet`: the wolf's
/// shoulders, fully within `FOCUS_FULL`, not at all past `FOCUS_NONE`, nor while it's down.
pub fn focus(w: World, feet: vec2) -> (vec3, f32) {
    let at = w.wolf.walker.root.pos + vec3(0.0, 0.6, 0.0)
    if w.wolf.mood == Mood::Down {
        return (at, 0.0)
    }
    (at, 1.0 - smoothstep(FOCUS_FULL, FOCUS_NONE, length(w.wolf.pos() - feet)))
}

/// A tick of what's held: a buffered press waits a tick less.
fn held(c: mut Climber) {
    if c.buffer > 0 {
        c.buffer -= 1
        if c.buffer == 0 {
            c.buffered = Act::Free
        }
    }
}

/// What an event pressed: an attack, or a blink, buffered, as it goes down.
fn press(c: mut Climber, now: Actions, before: Actions) {
    if now.attack() && !before.attack() {
        c.buffered = Act::Slash
        c.buffer = BUFFER
    }
    if now.dodge() && !before.dodge() {
        c.buffered = Act::Blink
        c.buffer = BUFFER
    }
}

/// How far the stick must be pushed to let a move go in its recovery, or to aim a blink.
const STICK: f32 = 0.3

/// The climber's tick on its body: a buffered move started when it can be; a move's tick (in its
/// wind-up, its turn toward its mark, the wolf if it's near, else the stick; its travel, carrying
/// the body as footing lets it), let go when the stick asks after it can be cancelled (not a
/// fall); or, free, the body walked by the engine, going on at once at the stick's pace as a move
/// ends. Then where the body is for the moves; the float; the guard, raised with a `foe` near;
/// stamina spent and regained.
fn act<G: Terrain + Ground>(
    ground: G,
    water: Water,
    o: Obstacles,
    motion: Motion,
    body: mut Player,
    c: mut Climber,
    foe: Option<vec2>,
    dt: f32,
    tally: mut Tally,
) {
    let (asked, _) = wish(body.controls)
    let was = c.act
    let prev_speed = c.speed
    let prev_heading = body.heading
    if c.act == Act::Free {
        c.heading = body.heading
    }
    if c.buffered != Act::Free && c.can_start() && c.stamina > 0.0 {
        var a = c.buffered
        // An attack after a slash is the backslash.
        if a == Act::Slash && c.act == Act::Slash {
            a = Act::Backslash
        }
        c.buffered = Act::Free
        c.buffer = 0
        c.start(a)
        if a == Act::Blink {
            // The way the stick points (straight back if it's let go), still facing as it was.
            c.going = if length(asked) > STICK { normalize(asked) } else { -c.forward() }
            tally.blinks += 1
        } else {
            tally.swings += 1
        }
    }
    if c.act != Act::Free &&
        c.act != Act::Down &&
        c.buffered == Act::Free &&
        length(asked) > STICK &&
        c.t >= frames(c.act).cancel {
        c.start(Act::Free)
    }
    if c.act != Act::Free {
        turn_look(mut body.controls, dt)
        let f = frames(c.act)
        if c.t < f.windup && f.turn > 0.0 {
            let target = match foe {
                Some(at) if length(at - c.at.xz) < 4.0 => {
                    let to = at - c.at.xz
                    atan2(to.x, to.y)
                },
                _ => if length(asked) > STICK { atan2(asked.x, asked.y) } else { c.heading },
            }
            let d = short_way(target - c.heading, TAU)
            c.heading += clamp(d, -f.turn * dt, f.turn * dt)
        }
        let moved = f.travel * (f.travelled(f32(c.t + 1)) - f.travelled(f32(c.t)))
        // A blink goes its own way; the rest carry the body the way it faces.
        let way = if c.act == Act::Blink { c.going } else { c.forward() }
        carry(mut body, ground, water, o, way * moved, c.heading, motion.clearance)
        body.velocity = vec2(0.0)
        c.t += 1
        if c.t >= f.total {
            if c.act == Act::Down {
                c.health = HEALTH
                c.stamina = STAMINA
            }
            c.start(Act::Free)
            resume(mut body, ground, water, o, motion)
        }
    } else {
        if was != Act::Free {
            resume(mut body, ground, water, o, motion)
        }
        step_with(mut body, ground, water, o, motion, dt)
        c.heading = body.heading
    }
    let at = body.at.world()
    c.at = vec3(at.x, body.y, at.y)
    c.speed = length(body.velocity)
    if c.act != Act::Free || c.fade < fade_into(c.act) {
        c.fade += 1
    }
    c.drift = fract(c.drift + drift_rate(c.speed) * dt)
    let to_ready = if foe.is_some() { 1.0 } else { 0.0 }
    c.ready += clamp(to_ready - c.ready, -dt * 1.5, dt * 4.0)
    let ease = 1.0 - exp(-dt * 10.0)
    c.accel += ((c.speed - prev_speed) / dt - c.accel) * ease
    c.turning += (short_way(c.heading - prev_heading, TAU) / dt - c.turning) * ease
    c.rested += 1
    if c.rested > REGEN_AFTER && c.act == Act::Free {
        c.stamina = min(c.stamina + REGEN * dt, STAMINA)
    }
}

/// The wolf's tick.
fn wolf_step<G: Terrain>(ground: G, w: mut Wolf, c: Climber, dt: f32, tally: mut Tally) {
    let to = c.at.xz - w.pos()
    let dist = length(to)
    let dir = if dist > 1.0e-4 { to / dist } else { w.forward() }
    let facing = short_way(atan2(dir.x, dir.y) - w.walker.root.heading, TAU)
    let g = ground
    w.t += 1
    if w.wait > 0 {
        w.wait -= 1
    }
    w.walker.along = 0.0
    match w.mood {
        Mood::Prowl => {
            // Toward the climber until it's KEEP away. Nearer than a lunge starts, it circles out
            // to a point to the side and away (a wolf doesn't back off), then comes round again.
            // Between, it turns toward the climber, stepping as it turns.
            var walk = PROWL
            var way = dir
            var ahead = 0.0
            if w.circle == 0 && dist < LUNGE_FROM.x {
                let side = vec2(-dir.y, dir.x)
                w.goal = c.at.xz + normalize(side * 0.9 - dir) * (KEEP + 0.8)
                w.circle = 150
            }
            if w.circle > 0 {
                w.circle -= 1
                let off = w.goal - w.pos()
                if length(off) < 0.5 {
                    w.circle = 0
                }
                ahead = length(off)
                if ahead > 1.0e-4 {
                    way = off / ahead
                }
            } else if dist > KEEP {
                ahead = dist - KEEP
            } else if abs(facing) > 0.2 {
                walk = TURN
                ahead = 1.0
            }
            let path = Toward { from: w.pos(), dir: way, length: ahead + walk.look_ahead }
            let keep = w.walker.root.pos
            gait_step(
                mut w.walker,
                g,
                path,
                WOLF_BODY,
                walk,
                go: ahead > 0.05 && c.act != Act::Down,
                dt: dt,
            )
            if walk == TURN {
                // It turns where it stands: its feet step, its body stays, turning faster than
                // the gait steers (2.4 rad/s in all).
                w.walker.root.pos = keep
                w.walker.root.heading += clamp(facing, -1.6 * dt, 1.6 * dt)
            }
            if w.wait == 0 &&
                dist > LUNGE_FROM.x &&
                dist < LUNGE_FROM.y &&
                abs(facing) < 0.3 &&
                c.act != Act::Down {
                w.mood = Mood::Crouch
                w.t = 0
            }
        },
        Mood::Crouch => {
            // Still, turning a little toward the climber.
            w.walker.root.heading += clamp(facing, -0.8 * dt, 0.8 * dt)
            gait_step(
                mut w.walker,
                g,
                Toward { from: w.pos(), dir, length: 0.0 },
                WOLF_BODY,
                PROWL,
                go: false,
                dt: dt,
            )
            if w.t >= CROUCH {
                w.mood = Mood::Lunge
                w.t = 0
                w.aim = dir
                w.bit = false
                w.dodged = false
                w.walker.speed = BOUND.speed
                tally.lunges += 1
            }
        },
        Mood::Lunge => {
            let path = Toward { from: w.pos(), dir: w.aim, length: 100.0 }
            w.walker.speed = if w.bit { w.walker.speed } else { BOUND.speed }
            gait_step(mut w.walker, g, path, WOLF_BODY, BOUND, go: !w.bit, dt: dt)
            if w.t >= LUNGE {
                w.mood = Mood::Recover
                w.t = 0
            }
        },
        Mood::Recover => {
            gait_step(
                mut w.walker,
                g,
                Toward { from: w.pos(), dir, length: 0.0 },
                WOLF_BODY,
                PROWL,
                go: false,
                dt: dt,
            )
            if w.t >= RECOVER {
                w.mood = Mood::Prowl
                w.t = 0
                // When it next crouches: not the same each time.
                w.wait = 30 + (tally.lunges * 37) % 70
            }
        },
        Mood::Flinch => {
            // Pushed back by the hit, over its first ticks.
            let push = 0.35 * (1.0 - f32(w.t) / 8.0)
            if w.t < 8 {
                let p = w.walker.root.pos + vec3(w.pushed.x, 0.0, w.pushed.y) * (push * dt * 8.0)
                w.walker.root.pos = vec3(p.x, g.height(p.x, p.z), p.z)
            }
            w.walker.speed = 0.0
            gait_step(
                mut w.walker,
                g,
                Toward { from: w.pos(), dir, length: 0.0 },
                WOLF_BODY,
                PROWL,
                go: false,
                dt: dt,
            )
            if w.t >= FLINCH {
                // Hurt near the climber, it answers: it crouches to lunge at once (the same
                // crouch, so the same tell); farther, it prowls.
                w.mood = if dist < LUNGE_FROM.y && c.act != Act::Down { Mood::Crouch } else {
                    Mood::Prowl
                }
                w.t = 0
                w.wait = 20
            }
        },
        Mood::Down => {
            gait_step(
                mut w.walker,
                g,
                Toward { from: w.pos(), dir, length: 0.0 },
                WOLF_BODY,
                PROWL,
                go: false,
                dt: dt,
            )
            if w.t >= WOLF_DOWN {
                w.health = WOLF_HEALTH
                w.mood = Mood::Prowl
                w.t = 0
                w.wait = 60
            }
        },
    }
}

/// The closest two segments come: `a0`–`a1` and `b0`–`b1`.
pub fn segments_apart(a0: vec3, a1: vec3, b0: vec3, b1: vec3) -> f32 {
    let d1 = a1 - a0
    let d2 = b1 - b0
    let r = a0 - b0
    let a = dot(d1, d1)
    let e = dot(d2, d2)
    let f = dot(d2, r)
    var s = 0.0
    var t = 0.0
    if a <= 1.0e-9 && e <= 1.0e-9 {
        return length(r)
    }
    if a <= 1.0e-9 {
        t = clamp(f / e, 0.0, 1.0)
    } else {
        let c = dot(d1, r)
        if e <= 1.0e-9 {
            s = clamp(-c / a, 0.0, 1.0)
        } else {
            let b = dot(d1, d2)
            let den = a * e - b * b
            s = if den > 1.0e-9 { clamp((b * f - c * e) / den, 0.0, 1.0) } else { 0.0 }
            t = (b * s + f) / e
            if t < 0.0 {
                t = 0.0
                s = clamp(-c / a, 0.0, 1.0)
            } else if t > 1.0 {
                t = 1.0
                s = clamp((b - c) / a, 0.0, 1.0)
            }
        }
    }
    length((a0 + d1 * s) - (b0 + d2 * t))
}

/// The sword in the world, `sub` ticks on from tick `c.t` (0 to 1): its grip's middle, toward its
/// point, and the way its edge leads (unit, the edge square to the aim).
pub fn sword_at(c: Climber, sub: f32) -> (vec3, vec3, vec3) {
    c.pose(sub).sword.placed(c.at, c.heading)
}

/// The blade's edge in the world, from a little past the guard to the point, `sub` ticks on from
/// tick `c.t` (0 to 1).
pub fn blade_at(c: Climber, sub: f32) -> (vec3, vec3) {
    let (at, aim, _) = sword_at(c, sub)
    (at + aim * (GUARD_AT + 0.1), at + aim * POINT_AT)
}

/// The wolf's body to the blade: capsules from its pelvis to its chest, and its neck to its head,
/// a little fuller than its body (a hit that grazes its fur counts).
pub fn wolf_hurt(w: Wolf) -> [vec4; 4] {
    let cr = wolf::creature::J_PELVIS
    [
        vec4(w.joint(cr), 0.26),
        vec4(w.joint(wolf::creature::J_CHEST + vec3(0.0, 0.05, 0.1)), 0.26),
        vec4(w.joint(wolf::creature::J_NECK), 0.17),
        vec4(w.joint(wolf::creature::J_HEAD), 0.17),
    ]
}

/// How hard a blow throws the wolf's head and its tail (m/s, along the cut), how far it jolts
/// its front up (rad) and drops its body (m).
pub const HEAD_KICK: f32 = 2.2
pub const TAIL_KICK: f32 = 1.2
const JOLT: f32 = 0.12
const DROP: f32 = 0.05

/// How far past the wolf's capsules a blade still hits it (m): a cut that looks to go through it
/// does, by its fur and by a hand's grace, not by a centimetre.
const BLADE_GRACE: f32 = 0.1

/// The blade against the wolf in the move's active ticks: the edge swept from the last tick's
/// place to this one's, in four steps, against the wolf's capsules. A hit hurts it (it flinches
/// or goes down), throws its head and tail the way the edge went, pushes it back, and stops the
/// fight for a few ticks.
fn blade_hits(w: mut World) {
    let c = w.climber
    if c.act != Act::Slash && c.act != Act::Backslash {
        return
    }
    let f = frames(c.act)
    // The tick has advanced: this sweep covers the interval starting at t - 1.
    if c.landed || c.t == 0 || !f.is_active(c.t - 1) || w.wolf.mood == Mood::Down {
        return
    }
    var prev = c
    prev.t = c.t - 1
    prev.fade = max(c.fade, 1) - 1
    let (p0, p1) = blade_at(prev, 0.0)
    let (q0, q1) = blade_at(c, 0.0)
    let hurt = wolf_hurt(w.wolf)
    var hit = false
    for k in 0..5 {
        let u = f32(k) / 4.0
        let a0 = mix(p0, q0, vec3(u))
        let a1 = mix(p1, q1, vec3(u))
        for j in 0..2 {
            let (b0, b1) = (hurt[2 * j], hurt[2 * j + 1])
            if segments_apart(a0, a1, b0.xyz, b1.xyz) < b0.w + BLADE_GRACE {
                hit = true
            }
        }
    }
    if !hit {
        return
    }
    w.climber.landed = true
    w.tally.hits += 1
    w.stop = HIT_STOP
    w.wolf.health -= f.damage
    // The blow, as the wolf's body takes it: its head and tail thrown the way the edge went
    // (their springs kicked: they swing back on their own once the hit stop ends), its body
    // jolted up at the front and down, and pushed back along the cut as much as away.
    let away = w.wolf.pos() - c.at.xz
    let away_n = if length(away) > 1.0e-4 { normalize(away) } else { c.forward() }
    let sweep = (q0 + q1 - p0 - p1) * 0.5
    let blow = if length(sweep) > 1.0e-4 { normalize(sweep) } else {
        vec3(away_n.x, 0.0, away_n.y)
    }
    for i in 0..WOLF_BODY.spring_tips.len() {
        let kick = if i == 0 { HEAD_KICK } else { TAIL_KICK }
        w.wolf.walker.springs[i].vel = w.wolf.walker.springs[i].vel + blow * kick
    }
    w.wolf.walker.pitch += JOLT
    w.wolf.walker.height -= DROP
    let push = away_n + blow.xz * 0.6
    w.wolf.pushed = if length(push) > 1.0e-4 { normalize(push) } else { away_n }
    w.wolf.t = 0
    if w.wolf.health <= 0.0 {
        w.wolf.mood = Mood::Down
        w.tally.wolf_downs += 1
    } else {
        w.wolf.mood = Mood::Flinch
    }
}

/// A sweep ending at a tick covers the interval before it: none of the wind-up or recovery,
/// and all of the active intervals, including the last one.
@test
fn blade_sweeps_cover_exactly_the_active_intervals() {
    for act in [Act::Slash, Act::Backslash] {
        let f = frames(act)
        for (elapsed, should_hit) in [
            (f.windup, false),
            (f.windup + 1, true),
            (f.windup + f.active, true),
            (f.windup + f.active + 1, false),
        ] {
            var w = spawn().fight
            w.climber.start(act)
            w.climber.t = elapsed
            w.climber.fade = 10
            // Put the pelvis on the edge at the interval's end: contact is certain, so only
            // the interval's eligibility can decide whether the blow lands.
            let (a, b) = blade_at(w.climber, 0.0)
            w.wolf.walker.root.pos = (a + b) * 0.5 - wolf::creature::J_PELVIS
            w.wolf.walker.root.heading = 0.0
            w.wolf.walker.height = 0.0
            w.wolf.walker.pitch = 0.0
            blade_hits(mut w)
            assert(
                (w.tally.hits == 1) == should_hit,
                "the sweep used its end tick instead of its active interval",
            )
        }
    }
}

/// The wolf's bite against the climber in its active ticks: a sphere at its jaws against a
/// capsule up the climber's middle. In the blink's invulnerable ticks it passes through (counted
/// once a lunge); otherwise it bites once.
fn bite(w: mut World) {
    let wolf = w.wolf
    if wolf.mood != Mood::Lunge || wolf.t < BITE.x || wolf.t >= BITE.y || wolf.bit {
        return
    }
    let c = w.climber
    let jaws = wolf.jaws()
    let apart = segments_apart(jaws, jaws, c.at + BODY_LOW, c.at + BODY_HIGH)
    if apart > BITE_RADIUS + BODY_RADIUS {
        return
    }
    if c.invulnerable() {
        if !wolf.dodged {
            w.wolf.dodged = true
            w.tally.dodged += 1
        }
        return
    }
    w.wolf.bit = true
    w.tally.bites += 1
    w.stop = HIT_STOP
    w.climber.health -= BITE_DAMAGE
    // Struck: it faces the wolf and is thrown back from it.
    let to = wolf.pos() - c.at.xz
    w.climber.heading = atan2(to.x, to.y)
    w.climber.buffered = Act::Free
    w.climber.buffer = 0
    if w.climber.health <= 0.0 {
        w.climber.start(Act::Down)
        w.tally.climber_downs += 1
    } else {
        w.climber.start(Act::Hurt)
    }
}

/// How far the climber is pushed out of the wolf's body (two circles along it), on the plane:
/// not at all in a blink, which passes through it.
fn keep_apart(c: Climber, w: Wolf) -> vec2 {
    if c.invulnerable() && c.act == Act::Blink {
        return vec2(0.0)
    }
    let f = w.forward()
    var at = c.at.xz
    for k in 0..2 {
        let centre = w.pos() + f * (if k == 0 { 0.3 } else { -0.3 })
        let d = at - centre
        let r = 0.3 + BODY_RADIUS
        let l = length(d)
        if l < r && l > 1.0e-4 {
            at = centre + d * (r / l)
        }
    }
    at - c.at.xz
}

/// The snapshot the frames read.
@deterministic
pub fn present(d: Duel) -> Duel {
    d
}
