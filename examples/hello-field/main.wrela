// hello field: milestone 1's program. Each frame the CPU records one full-screen draw; the
// fragment shader sphere-traces the field and lights it with normals from the derived gradient
// (language.md §13), which nobody wrote by hand. `probe` runs the same shading on the CPU, so a
// test can check the GPU's pixels against a WASM evaluation of the same field.
use shape::creature
use std::field::Surface
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw, present}

/// What the shaders read besides the field: the canvas and the camera.
struct Scene: Copy + Clone + GpuData {
    resolution: vec2,
    time: f32,
    eye: vec3,
}

fn scene_at(time: f32, width: u32, height: u32) -> Scene {
    let a = 0.35 * time
    Scene {
        resolution: vec2(f32(width), f32(height)),
        time,
        eye: vec3(2.6 * sin(a), 0.7, 2.6 * cos(a)),
    }
}

/// One triangle that covers the screen.
@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// The colour of the pixel at `pixel` (pixel centres are at half-integers). Generic over the
/// field: each concrete field type is its own pipeline, and its numbers arrive as a uniform.
fn shade_pixel<F: Surface>(pixel: vec2, scene: Scene, field: F) -> vec4 {
    let uv = (pixel * 2.0 - scene.resolution) / scene.resolution.y
    let target = vec3(0.2, 0.25, 0.0)
    let forward = normalize(target - scene.eye)
    let right = normalize(cross(forward, vec3(y: 1.0)))
    let up = cross(right, forward)
    let dir = normalize(forward * 1.6 + right * uv.x - up * uv.y)
    var t = 0.0
    var hit = false
    var i = 0
    while i < 96 && !hit && t < 8.0 {
        let d = field.distance(scene.eye + dir * t)
        if d < 0.0005 {
            hit = true
        } else {
            t += d * 0.9
        }
        i += 1
    }
    let sky = mix(vec3(0.62, 0.72, 0.86), vec3(0.18, 0.24, 0.36), clamp(0.5 - 0.5 * dir.y, 0.0, 1.0))
    if !hit {
        return vec4(sky, 1.0)
    }
    let p = scene.eye + dir * t
    let n = normalize(field.gradient(p))
    let sun = normalize(vec3(0.6, 0.8, 0.3))
    let diffuse = max(dot(n, sun), 0.0)
    let rim = pow(1.0 - max(dot(n, -dir), 0.0), 3.0)
    let albedo = vec3(0.58, 0.44, 0.3)
    let c = albedo * (0.18 + 0.82 * diffuse) + sky * 0.25 * rim
    vec4(c, 1.0)
}

@fragment
fn shade<F: Surface>(pixel: FragCoord, scene: Scene, field: F) -> vec4 {
    shade_pixel(pixel.position.xy, scene, field)
}

/// Called by the host once per frame, with the time in seconds and the canvas size in pixels.
pub fn frame(time: f32, width: u32, height: u32) {
    begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(cover, shade, vertices: 3, scene: scene_at(time, width, height), field: creature(sin(time * 1.3)))
    present()
}

/// The same pixel, computed on the CPU (for tests).
pub fn probe(x: f32, y: f32, time: f32, width: u32, height: u32) -> vec4 {
    shade_pixel(vec2(x, y), scene_at(time, width, height), creature(sin(time * 1.3)))
}
