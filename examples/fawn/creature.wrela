// The clearing's creature, authored in M5's art-directed round (#51 AC9) from round 1's grazer
// (examples/grazer) toward a forest grazer of the Last Green: a short coat, a lower hump, short
// horns, a slimmer barrel and neck.
//
// It's built on the grazer's skeleton and its shapes (`grazer::creature`: the joints, the
// muscles, hooves, ears and the woolly cape, each with its Lipschitz bound): what's the fawn's
// own is here, the literals the lens edits (`wrela studio examples/fawn`): its coat, its horns'
// joints, and its parts, each a named part on a bone, round 1's in round 1's order. The
// grazer's file says how they were ported from round 1's WGSL.
//
// Its coat is round 1's browns warmed and lifted toward a fawn's (spike 15's): the game shows
// these colours as they are, and so does the lens.

use engine::creature::{Creature, Skeleton, creature, cut, ground, smooth}
use grazer::creature::{
    CHEST, Cape, EAR_BASE, ELBOW, EYE_AT, Ear, FFETLOCK, HEAD, HFETLOCK, HIP, HOCK, HORN0, Hoof,
    KNEE, Muscle, NECK0, NECK1, NECK2, NECK3, PELVIS, SCAPULA, SHOULDER, SPINE, STIFLE, TAIL0,
    TAIL1, TAIL2, TAIL3, TAIL4, TAIL5, TAIL_END, coat, head_frame, muscle, neck_cone,
}
use round1::shapes::{ell, fbm3, flat_cone, mirror_x, noise3, rot_x, sd_box, sstep}
use std::field::{cuboid, round_cone, sphere}

// ---- the coat ------------------------------------------------------------------------------------

/// What each part carries: the grazer's channels.
pub type Coat = grazer::creature::Coat

const HIDE = coat(r: 0.312, g: 0.1426, b: 0.054)
const WOOL = coat(r: 0.1508, g: 0.0805, b: 0.036)
const PALE = coat(r: 0.52, g: 0.299, b: 0.144)
const SOCK = coat(r: 0.13, g: 0.0736, b: 0.0396)
const HOOF = coat(r: 0.0572, g: 0.0437, b: 0.0306)
const EYE = coat(r: 0.0208, g: 0.0138, b: 0.009)
const HORN = coat(r: 0.091, g: 0.069, b: 0.0468)
const TUFT = coat(r: 0.078, g: 0.046, b: 0.0234)

// ---- its own joints -------------------------------------------------------------------------------

// The horns, shorter than the grazer's (in the head's space).
pub const HORN1: vec3 = vec3(0.12, 0.093, 0.035)
pub const HORN2: vec3 = vec3(0.14, 0.12, 0.028)
pub const HORN3: vec3 = vec3(0.14, 0.138, 0.032)

/// The fawn's skeleton: the grazer's.
pub fn skeleton() -> Skeleton {
    grazer::creature::skeleton()
}

/// A tail segment from `a` to `c`, on the bone at `a`.
fn tail_cone(a: vec3, c: vec3, r1: f32, r2: f32) -> std::field::With<std::field::RoundCone, Coat> {
    round_cone(vec3(), c - a, r_top: r1, r_bottom: r2).with(HIDE)
}

// ---- the fawn ----------------------------------------------------------------------------------

/// The fawn, standing.
pub fn fawn() -> Creature<Coat> {
    let s = skeleton()
    let b = |name: Text| s.find(name)
    let (pelvis, chest, head) = (b("pelvis"), b("chest"), b("head"))
    let (shoulder, elbow, knee, ffet) = (
        b("shoulder right"),
        b("elbow right"),
        b("knee right"),
        b("fore fetlock right"),
    )
    let (hip, stifle, hock, hfet) = (
        b("hip right"),
        b("stifle right"),
        b("hock right"),
        b("hind fetlock right"),
    )
    creature(s)
        .group(
            "torso",
            |g| {
                g.join(
                    "barrel",
                    pelvis,
                    ell(vec3(0.336, 0.33, 0.60))
                        .translate(vec3(0.0, 1.10, 0.53) - PELVIS)
                        .with(HIDE),
                )
                    .join(
                        "chest",
                        chest,
                        ell(vec3(0.36, 0.35, 0.34))
                            .translate(vec3(0.0, 1.14, 0.96) - CHEST)
                            .with(WOOL),
                        seam: smooth(0.14),
                    )
                    .join(
                        "rump",
                        pelvis,
                        ell(vec3(0.30, 0.27, 0.36))
                            .translate(vec3(0.0, 1.21, 0.02) - PELVIS)
                            .with(HIDE),
                        seam: smooth(0.14),
                    )
                    .join(
                        "shoulder hump",
                        chest,
                        ell(vec3(0.23, 0.24074, 0.40))
                            .translate(vec3(0.0, 1.43, 0.80) - CHEST)
                            .with(WOOL),
                        seam: smooth(0.12),
                    )
                    .join(
                        "hip point", // the hook
                        pelvis,
                        ell(vec3(0.06, 0.05, 0.07))
                            .translate(vec3(0.24, 1.26, 0.14) - PELVIS)
                            .with(HIDE),
                        seam: smooth(0.08),
                    )
            },
            mirror: true,
        )
        .group(
            "neck",
            |g| {
                let n0 = b("neck 0")
                g.join(
                    "neck base",
                    n0,
                    neck_cone(NECK0, NECK1, r1: 0.30, r2: 0.22, sx: 1.3).with(WOOL),
                )
                    .join(
                        "throat",
                        n0,
                        round_cone(
                            vec3(0.0, -0.02, -0.06),
                            vec3(0.0, 0.08, 0.06),
                            r_top: 0.30,
                            r_bottom: 0.22,
                        ).with(WOOL),
                        seam: smooth(0.06),
                    )
                    .join(
                        "neck middle",
                        b("neck 1"),
                        flat_cone(
                            vec3(),
                            NECK2 - NECK1,
                            r1: 0.22,
                            r2: 0.175,
                            sx: 1.3,
                            scale_ends: false,
                        )
                            .with(WOOL),
                        seam: smooth(0.03),
                    )
                    .join(
                        "neck upper",
                        b("neck 2"),
                        flat_cone(
                            vec3(),
                            NECK3 - NECK2,
                            r1: 0.175,
                            r2: 0.14,
                            sx: 1.3,
                            scale_ends: false,
                        )
                            .with(WOOL),
                        seam: smooth(0.03),
                    )
                    .join(
                        "neck top",
                        b("neck 3"),
                        flat_cone(
                            vec3(),
                            HEAD - NECK3,
                            r1: 0.14,
                            r2: 0.10,
                            sx: 1.3,
                            scale_ends: false,
                        )
                            .with(WOOL),
                        seam: smooth(0.03),
                    )
                    .join(
                        "mane", // a ridge along the top of the neck
                        n0,
                        neck_cone(
                            vec3(0.0, 1.74, 1.40),
                            vec3(0.0, 1.99, 1.58),
                            r1: 0.045,
                            r2: 0.035,
                            sx: 2.0,
                        )
                            .with(WOOL),
                        seam: smooth(0.05),
                    )
                    .join(
                        "beard", // hanging under the jaw and the throat
                        n0,
                        neck_cone(
                            vec3(0.0, 1.76, 1.68),
                            vec3(0.0, 1.48, 1.56),
                            r1: 0.03,
                            r2: 0.06,
                            sx: 1.6,
                        )
                            .with(WOOL),
                        seam: smooth(0.06),
                    )
                    .join(
                        "dewlap", // a keel down the front of the chest
                        n0,
                        neck_cone(
                            vec3(0.0, 1.28, 1.24),
                            vec3(0.0, 0.88, 1.12),
                            r1: 0.07,
                            r2: 0.08,
                            sx: 2.2,
                        )
                            .with(WOOL),
                        seam: smooth(0.08),
                    )
            },
            seam: smooth(0.10),
            mirror: true,
        )
        .group(
            "head",
            |g| {
                g.join(
                    "cranium",
                    head,
                    ell(vec3(0.115, 0.105, 0.13)).translate(vec3(0.0, 0.02, 0.06)).with(HIDE),
                )
                    .join(
                        "face", // the nasal bridge
                        head,
                        round_cone(
                            vec3(0.0, 0.0, 0.10),
                            vec3(0.0, -0.025, 0.38),
                            r_top: 0.10,
                            r_bottom: 0.07,
                        )
                            .with(HIDE),
                        seam: smooth(0.05),
                    )
                    .join(
                        "muzzle",
                        head,
                        ell(vec3(0.072, 0.075, 0.08)).translate(vec3(0.0, -0.04, 0.43)).with(PALE),
                        seam: smooth(0.04),
                    )
                    .join(
                        "upper lip", // a little overhanging
                        head,
                        ell(vec3(0.06, 0.028, 0.05)).translate(vec3(0.0, -0.068, 0.47)).with(PALE),
                        seam: smooth(0.02),
                    )
                    .join(
                        "lower jaw",
                        head,
                        round_cone(
                            vec3(0.0, -0.075, 0.05),
                            vec3(0.0, -0.105, 0.40),
                            r_top: 0.07,
                            r_bottom: 0.034,
                        )
                            .with(HIDE),
                        seam: smooth(0.04),
                    )
                    .join(
                        "chin", // and lower lip
                        head,
                        ell(vec3(0.042, 0.02, 0.042)).translate(vec3(0.0, -0.115, 0.42)).with(PALE),
                        seam: smooth(0.02),
                    )
                    .join(
                        "cheek", // masseter
                        head,
                        ell(vec3(0.05, 0.075, 0.09))
                            .translate(vec3(0.065, -0.055, 0.12))
                            .with(HIDE),
                        seam: smooth(0.03),
                    )
                    .join(
                        "brow",
                        head,
                        ell(vec3(0.032, 0.018, 0.05)).translate(vec3(0.08, 0.066, 0.18)).with(HIDE),
                        seam: smooth(0.02),
                    )
                    .join(
                        "eye",
                        head,
                        sphere(0.028).translate(EYE_AT).with(EYE),
                        seam: smooth(0.008),
                    )
                    .join(
                        "mouth line",
                        head,
                        cuboid(half: vec3(0.1, 0.0025, 0.08))
                            .translate(vec3(0.0, -0.098, 0.49))
                            .with(EYE),
                        seam: cut(0.003),
                    )
                    .join(
                        "nostril",
                        head,
                        ell(vec3(0.012, 0.026, 0.016))
                            .rotate(Quat::axis_angle(vec3(1.0, 0.0, 0.0), -0.5))
                            .translate(vec3(0.034, -0.02, 0.505))
                            .with(EYE),
                        seam: cut(0.006),
                    )
            },
            seam: smooth(0.05),
            space: head_frame(),
            mirror: true,
        )
        .group(
            "tail",
            |g| {
                g.join("tail 0", b("tail 0"), tail_cone(TAIL0, TAIL1, r1: 0.06, r2: 0.045))
                    .join(
                        "tail 1",
                        b("tail 1"),
                        tail_cone(TAIL1, TAIL2, r1: 0.045, r2: 0.036),
                        seam: smooth(0.015),
                    )
                    .join(
                        "tail 2",
                        b("tail 2"),
                        tail_cone(TAIL2, TAIL3, r1: 0.036, r2: 0.030),
                        seam: smooth(0.015),
                    )
                    .join(
                        "tail 3",
                        b("tail 3"),
                        tail_cone(TAIL3, TAIL4, r1: 0.030, r2: 0.026),
                        seam: smooth(0.015),
                    )
                    .join(
                        "tail 4",
                        b("tail 4"),
                        tail_cone(TAIL4, TAIL5, r1: 0.026, r2: 0.022),
                        seam: smooth(0.015),
                    )
                    .join(
                        "tuft",
                        b("tail 5"),
                        Muscle {
                            a: vec3(),
                            b: TAIL_END - TAIL5,
                            t: 0.55,
                            off: vec2(0.0),
                            r: vec3(0.04, 0.04, 0.085),
                            noise: 0.002,
                            freq: 30.0,
                            origin: TAIL5,
                        }.with(TUFT),
                        seam: smooth(0.03),
                    )
            },
            seam: smooth(0.05),
            mirror: true,
        )
        .group(
            "fore leg",
            |g| {
                g.join(
                    "shoulder blade", // the scapula's mass
                    b("scapula right"),
                    muscle(
                        SCAPULA,
                        SHOULDER,
                        SCAPULA,
                        t: 0.45,
                        off: vec2(0.0, -0.02),
                        r: vec3(0.12, 0.17, 0.28),
                    )
                        .with(WOOL),
                )
                    .join(
                        "upper arm",
                        shoulder,
                        round_cone(vec3(), ELBOW - SHOULDER, r_top: 0.10, r_bottom: 0.085).with(
                            WOOL,
                        ),
                        seam: smooth(0.06),
                    )
                    .join(
                        "triceps",
                        shoulder,
                        muscle(
                            SHOULDER,
                            ELBOW,
                            SHOULDER,
                            t: 0.55,
                            off: vec2(0.0, -0.08),
                            r: vec3(0.10, 0.13, 0.2),
                        )
                            .with(WOOL),
                        seam: smooth(0.06),
                    )
                    .join(
                        "point of elbow",
                        elbow,
                        sphere(0.05).translate(vec3(0.0, 0.02, -0.065)).with(HIDE),
                        seam: smooth(0.04),
                    )
                    .join(
                        "forearm",
                        elbow,
                        round_cone(vec3(), KNEE - ELBOW, r_top: 0.10, r_bottom: 0.048).with(HIDE),
                        seam: smooth(0.04),
                    )
                    .join(
                        "forearm muscles",
                        elbow,
                        muscle(
                            ELBOW,
                            KNEE,
                            ELBOW,
                            t: 0.2,
                            off: vec2(0.0, 0.01),
                            r: vec3(0.085, 0.115, 0.17),
                        )
                            .with(HIDE),
                        seam: smooth(0.05),
                    )
                    .join(
                        "knee",
                        knee,
                        ell(vec3(0.058, 0.056, 0.055)).with(SOCK),
                        seam: smooth(0.03),
                    ) // the carpus
                    .join(
                        "cannon",
                        knee,
                        round_cone(vec3(), FFETLOCK - KNEE, r_top: 0.040, r_bottom: 0.037).with(
                            SOCK,
                        ),
                        seam: smooth(0.02),
                    )
                    .join(
                        "fetlock",
                        ffet,
                        sphere(0.045).translate(vec3(0.0, 0.0, -0.01)).with(SOCK),
                        seam: smooth(0.025),
                    )
                    .join(
                        "pastern",
                        ffet,
                        round_cone(
                            vec3(0.0, 0.0, -0.005),
                            vec3(0.0, 0.068 - FFETLOCK.y, 0.022),
                            r_top: 0.04,
                            r_bottom: 0.043,
                        ).with(SOCK),
                        seam: smooth(0.02),
                    )
                    .join("hoof", ffet, Hoof { drop: FFETLOCK.y }.with(HOOF), seam: smooth(0.01))
            },
            seam: smooth(0.07),
            mirror: true,
        )
        .group(
            "hind leg",
            |g| {
                g.join(
                    "thigh",
                    hip,
                    muscle(
                        HIP,
                        STIFLE,
                        HIP,
                        t: 0.5,
                        off: vec2(0.0, -0.10),
                        r: vec3(0.15, 0.27, 0.36),
                    ).with(HIDE),
                )
                    .join(
                        "hamstrings",
                        hip,
                        round_cone(
                            vec3(0.13, 1.18, -0.24) - HIP,
                            vec3(0.18, 0.66, -0.07) - HIP,
                            r_top: 0.12,
                            r_bottom: 0.07,
                        ).with(HIDE),
                        seam: smooth(0.09),
                    )
                    .join(
                        "stifle", // the patella
                        stifle,
                        sphere(0.065).translate(vec3(0.015, 0.0, 0.05)).with(HIDE),
                        seam: smooth(0.06),
                    )
                    .join(
                        "gaskin",
                        stifle,
                        round_cone(vec3(), HOCK - STIFLE, r_top: 0.10, r_bottom: 0.052).with(HIDE),
                        seam: smooth(0.06),
                    )
                    .join(
                        "calf",
                        stifle,
                        muscle(
                            STIFLE,
                            HOCK,
                            STIFLE,
                            t: 0.32,
                            off: vec2(0.0, -0.05),
                            r: vec3(0.07, 0.08, 0.16),
                        )
                            .with(HIDE),
                        seam: smooth(0.05),
                    )
                    .join(
                        "achilles",
                        stifle,
                        round_cone(
                            mix(STIFLE, HOCK, vec3(0.5)) + vec3(0.0, 0.0, -0.07) - STIFLE,
                            HOCK + vec3(0.0, 0.04, -0.07) - STIFLE,
                            r_top: 0.022,
                            r_bottom: 0.022,
                        ).with(HIDE),
                        seam: smooth(0.04),
                    )
                    .join(
                        "point of hock",
                        hock,
                        sphere(0.035).translate(vec3(0.0, 0.04, -0.07)).with(HIDE),
                        seam: smooth(0.02),
                    )
                    .join(
                        "hock",
                        hock,
                        ell(vec3(0.055, 0.058, 0.06)).with(SOCK),
                        seam: smooth(0.03),
                    )
                    .join(
                        "cannon",
                        hock,
                        round_cone(vec3(), HFETLOCK - HOCK, r_top: 0.043, r_bottom: 0.038).with(
                            SOCK,
                        ),
                        seam: smooth(0.02),
                    )
                    .join(
                        "fetlock",
                        hfet,
                        sphere(0.046).translate(vec3(0.0, 0.0, -0.01)).with(SOCK),
                        seam: smooth(0.025),
                    )
                    .join(
                        "pastern",
                        hfet,
                        round_cone(
                            vec3(0.0, 0.0, -0.005),
                            vec3(0.0, 0.068 - HFETLOCK.y, 0.022),
                            r_top: 0.04,
                            r_bottom: 0.043,
                        ).with(SOCK),
                        seam: smooth(0.02),
                    )
                    .join("hoof", hfet, Hoof { drop: HFETLOCK.y }.with(HOOF), seam: smooth(0.01))
            },
            seam: smooth(0.08),
            mirror: true,
        )
        .then(
            Cape { depth: 0.006 },
        )
        .group(
            "ears",
            |g| g.join("ear", head, Ear { cup: 0.022 }.with(WOOL)),
            seam: smooth(0.012),
            space: head_frame(),
            mirror: true,
        )
        .group(
            "horns",
            |g| {
                g.join(
                    "horn base",
                    head,
                    round_cone(HORN0, HORN1, r_top: 0.036, r_bottom: 0.026).with(HORN),
                )
                    .join(
                        "horn middle",
                        head,
                        round_cone(HORN1, HORN2, r_top: 0.026, r_bottom: 0.018).with(HORN),
                        seam: smooth(0.012),
                    )
                    .join(
                        "horn tip",
                        head,
                        round_cone(HORN2, HORN3, r_top: 0.018, r_bottom: 0.009).with(HORN),
                        seam: smooth(0.008),
                    )
            },
            seam: smooth(0.025),
            space: head_frame(),
            mirror: true,
        )
        .then(ground())
}
