// A performance of the first Gymnopédie: a taste (habits that would hold for any piece) and
// marks (this piece, this time). Functions, not constants, so a lifted build lifts every
// number here and the lens's tools can change them while the piece plays.
//
// The reading, by Claude, third version. "Lent et douloureux": slow, grieving and restrained.
// The left hand is a pendulum, bass on one and the chord on two, and the piece lives on it, so
// time stays nearly steady: the owner heard the second version's rubato (the melody up to
// 170 ms behind the chords) and its breaths (beats stretched by a third) as weird timing, and
// preferred the deadpan. The expression is in the sound instead: the melody sings over the
// chords and a little ahead of them; each phrase swells toward its peak and settles; the pedal
// changes with each bass note, fully down; the soft pedal veils the quiet parts. The first
// edition's forte in bar 9 is a swell, not a shout; the repeat is quieter; one breath before
// it; the last bars slow, and the D minor chord is let ring.
//
// Bars are counted as the piece is played: the repeat written out, so its second time
// through is bars 40 to 70, and the second ending 71 to 78.

use engine::perform::{Mark, Pedal, Taste, bar, bars}

pub fn taste() -> Taste {
    Taste {
        tempo: 66.0,
        lead: "melody",
        voicing: 1.15,
        under: 0.88,
        melody_lead: 0.012,
        bass: "bass",
        bass_weight: 1.08,
        arch_tempo: 0.012,
        arch_loudness: 0.1,
        arch_peak: 0.4,
        phrase_end: 0.03,
        final_rit: 0.25,
        final_bars: 3,
        final_curve: 2.0,
        range: 0.7,
        level: 0.0,
        hairpin_curve: 1.0,
        metre: 0.03,
        high_loud: 0.02,
        legato: 0.03,
        detache: 0.02,
        pedal: Pedal::ByVoice { voice: "bass", catch: 0.08, depth: 1.0 },
        ring: 4.0,
        soft: 0.6,
        soft_below: 0.36,
        jitter_time: 0.003,
        jitter_velocity: 0.03,
        seed: 7,
    }
}

pub fn marks() -> [Mark; 10] {
    [
        // One breath, before the repeat, after the first ending's D major chord is held.
        Mark::Hold { at: bar(39).on(3.0), by: 1.3 },
        Mark::Breathe { at: bar(40), length: 0.35 },
        // The first entry, softly; the climax, the A5 in bar 28 (and 67), leaned on.
        Mark::Lean { at: bar(5).on(2.0), voice: "melody", by: 0.94 },
        Mark::Lean { at: bar(28), voice: "melody", by: 1.12 },
        Mark::Lean { at: bar(67), voice: "melody", by: 1.08 },
        // The forte in bar 9 rises, and stays below a shout.
        Mark::Swell { over: bars(9, last: 12), by: 0.85 },
        // The repeat, a memory: quieter.
        Mark::Swell { over: bars(40, last: 70), by: 0.92 },
        // The last chord rolled gently from the bass up, and held.
        Mark::Roll { at: bar(78), spread: 0.04 },
        Mark::Hold { at: bar(78).on(3.0), by: 1.6 },
        Mark::Swell { over: bars(76, last: 78), by: 0.95 },
    ]
}
