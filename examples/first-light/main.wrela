// First light: the thinnest path from wrela source to pixels. Each frame the CPU records one
// full-screen draw, and the GPU colours every pixel by its distance to an animated sphere.

/// What the shaders read. `GpuData` fixes the layout to WGSL's rules, so the bytes the CPU
/// records are the bytes the GPU reads.
struct Scene: Copy + GpuData {
    resolution: vec2, // the canvas size in pixels
    time: f32,        // seconds since the first frame
}

/// One triangle that covers the screen: vertices 0, 1 and 2 land at (-1, -1), (3, -1) and
/// (-1, 3) in clip space.
@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// Colours a pixel by its signed distance to a sphere that orbits and breathes: warm inside,
/// cool outside, contour bands that fade with distance, and a soft rim at the surface.
@fragment
fn shade(pixel: FragCoord, scene: Scene) -> vec4 {
    // The pixel as a point on a plane through the sphere: y up, the short side spanning -1 to 1.
    // The plane drifts through the sphere over time.
    let uv = (pixel.position.xy * 2.0 - scene.resolution) / scene.resolution.y
    let t = scene.time
    let p = vec3(uv.x, -uv.y, 0.25 * sin(t * 0.7))
    let centre = vec3(0.35 * cos(t), 0.2 * sin(t * 1.3), 0.0)
    let radius = 0.45 + 0.05 * sin(t * 2.0)
    let d = length(p - centre) - radius

    let base = mix(vec3(1.0, 0.55, 0.25), vec3(0.25, 0.45, 0.85), step(0.0, d))
    let bands = 0.5 + 0.5 * cos(d * 62.831853) // one band every 0.1 units
    let fade = clamp(1.0 - abs(d) * 1.5, 0.0, 1.0)
    let shaded = base * (0.75 + 0.25 * bands * fade)
    let rim = 1.0 - smoothstep(0.0, 0.015, abs(d))
    vec4(mix(shaded, vec3(1.0), rim), 1.0)
}

/// Called by the host once per frame, with the time in seconds and the canvas size in pixels.
pub fn frame(time: f32, width: u32, height: u32) {
    let scene = Scene { resolution: vec2(f32(width), f32(height)), time }
    begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(cover, shade, 3, scene)
    present()
}
