// Side A's motion: a few poses a cycle, keyed by hand from the textbook gait (a walk's contact,
// loading, passing and terminal stance; a run's contact, mid-stance, toe-off and flight), each
// half a cycle mirrored for the other, and played smoothly through (`cycle`): the procedural layer
// (`motion`) does the rest. Phase 0 of a cycle is the left foot's contact, as the motion
// capture's (`mocap`). Angles in degrees, about the parent's axes (`rig::euler`): a hip's or a
// shoulder's swing forward is negative about x, a knee's bend positive; a pelvis turned so its
// left side leads is negative about y.

use rig::{
    CHEST, CHEST2, CHEST3, CHEST4, HEAD, HIPS, L_ANKLE, L_ELBOW, L_HIP, L_KNEE, L_SHOULDER, L_TOE,
    L_WRIST, NECK, Pose, R_ANKLE, R_ELBOW, R_HIP, R_KNEE, R_SHOULDER, R_TOE, R_WRIST, euler, t_pose,
}

/// A leg's turns: hip, knee, ankle and toe (degrees about x).
struct Leg: Copy {
    hip: f32,
    knee: f32,
    ankle: f32,
    toe: f32,
}

/// An arm's: the shoulder's swing forward (negative) or back, how far it hangs from the T-pose
/// (degrees about z, toward the body), and the elbow's bend.
struct Arm: Copy {
    swing: f32,
    hang: f32,
    elbow: f32,
}

/// A body's pose from its parts: the hips' place, the pelvis's tilt forward, its turn (the left
/// side leading, negative) and its roll (the right side dropping, positive); the spine's lean
/// forward and its turn against the pelvis, spread up its four joints; the head held level; the
/// legs and the arms, left and right.
fn body(
    hips: vec3,
    pelvis: vec3,
    spine: vec2,
    left: Leg,
    right: Leg,
    left_arm: Arm,
    right_arm: Arm,
) -> Pose {
    var p = t_pose()
    p.hips = hips
    p.rot[HIPS] = euler(pelvis)
    let s = vec3(spine.x * 0.25, spine.y * 0.25, 0.0)
    p.rot[CHEST] = euler(s)
    p.rot[CHEST2] = euler(s)
    p.rot[CHEST3] = euler(s)
    p.rot[CHEST4] = euler(s)
    p.rot[NECK] = euler(vec3(-(pelvis.x + spine.x) * 0.5, -(pelvis.y + spine.y) * 0.5, -pelvis.z))
    p.rot[HEAD] = euler(vec3(-(pelvis.x + spine.x) * 0.4, -(pelvis.y + spine.y) * 0.4, 0.0))
    p.rot[L_HIP] = euler(vec3(left.hip, 0.0, 0.0))
    p.rot[L_KNEE] = euler(vec3(left.knee, 0.0, 0.0))
    p.rot[L_ANKLE] = euler(vec3(left.ankle, 0.0, 0.0))
    p.rot[L_TOE] = euler(vec3(left.toe, 0.0, 0.0))
    p.rot[R_HIP] = euler(vec3(right.hip, 0.0, 0.0))
    p.rot[R_KNEE] = euler(vec3(right.knee, 0.0, 0.0))
    p.rot[R_ANKLE] = euler(vec3(right.ankle, 0.0, 0.0))
    p.rot[R_TOE] = euler(vec3(right.toe, 0.0, 0.0))
    // The arms: lowered about z, swung about x; the elbow bends the forearm forward (about the
    // arm's own y); the wrist relaxed, a little in.
    p.rot[R_SHOULDER] = euler(vec3(right_arm.swing, 0.0, right_arm.hang))
    p.rot[L_SHOULDER] = euler(vec3(left_arm.swing, 0.0, -left_arm.hang))
    p.rot[R_ELBOW] = euler(vec3(0.0, right_arm.elbow, 0.0))
    p.rot[L_ELBOW] = euler(vec3(0.0, -left_arm.elbow, 0.0))
    p.rot[R_WRIST] = euler(vec3(0.0, 8.0, 0.0))
    p.rot[L_WRIST] = euler(vec3(0.0, -8.0, 0.0))
    p
}

/// A leg's turns, hip, knee, ankle and toe, as one value (`Leg`).
fn leg(t: vec4) -> Leg {
    Leg { hip: t.x, knee: t.y, ankle: t.z, toe: t.w }
}

/// An arm's swing, hang and elbow, as one value (`Arm`).
fn arm(t: vec3) -> Arm {
    Arm { swing: t.x, hang: t.y, elbow: t.z }
}

// ---- the walk: phase 0 the left heel's contact -----------------------------------------------

/// The walk's first half: contact, loading, passing (the right leg swinging through) and
/// terminal stance; the second half is the first mirrored.
pub fn walk_keys() -> [Pose; 4] {
    [
        body(
            hips: vec3(0.0, 0.952, 0.0),
            pelvis: vec3(2.0, -5.0, 0.0),
            spine: vec2(1.0, 7.0),
            left: leg(vec4(-28.0, 3.0, -5.0, 0.0)),
            right: leg(vec4(18.0, 10.0, 14.0, -22.0)),
            left_arm: arm(vec3(16.0, 78.0, 10.0)),
            right_arm: arm(vec3(-16.0, 78.0, 24.0)),
        ),
        body(
            hips: vec3(0.022, 0.945, 0.0),
            pelvis: vec3(2.0, -3.0, 4.0),
            spine: vec2(1.0, 4.0),
            left: leg(vec4(-21.0, 16.0, 3.0, 0.0)),
            right: leg(vec4(19.0, 38.0, 18.0, -12.0)),
            left_arm: arm(vec3(10.0, 78.0, 12.0)),
            right_arm: arm(vec3(-10.0, 78.0, 20.0)),
        ),
        body(
            hips: vec3(0.032, 0.982, 0.0),
            pelvis: vec3(2.0, 0.0, 3.0),
            spine: vec2(1.0, 0.0),
            left: leg(vec4(-2.0, 6.0, -8.0, 0.0)),
            right: leg(vec4(-22.0, 62.0, -6.0, 0.0)),
            left_arm: arm(vec3(0.0, 78.0, 15.0)),
            right_arm: arm(vec3(0.0, 78.0, 15.0)),
        ),
        body(
            hips: vec3(0.016, 0.972, 0.0),
            pelvis: vec3(2.0, 3.0, 1.0),
            spine: vec2(1.0, -4.0),
            left: leg(vec4(11.0, 5.0, 3.0, -8.0)),
            right: leg(vec4(-31.0, 18.0, -4.0, 0.0)),
            left_arm: arm(vec3(-10.0, 78.0, 20.0)),
            right_arm: arm(vec3(10.0, 78.0, 12.0)),
        ),
    ]
}

/// The walk's period (s), and the shares of it a foot and its heel are down: a brisk walk's.
pub const WALK_PERIOD: f32 = 1.05
pub const WALK_STANCE: f32 = 0.6
pub const WALK_HEEL: f32 = 0.38

// ---- the run: phase 0 the left foot's contact --------------------------------------------------

/// The run's first half: contact, mid-stance (most bent), toe-off and flight; the trunk leans
/// in, the elbows bent near square.
pub fn run_keys() -> [Pose; 4] {
    [
        body(
            hips: vec3(0.0, 0.93, 0.0),
            pelvis: vec3(7.0, -8.0, 0.0),
            spine: vec2(4.0, 11.0),
            left: leg(vec4(-30.0, 22.0, -2.0, 0.0)),
            right: leg(vec4(12.0, 75.0, 15.0, -5.0)),
            left_arm: arm(vec3(26.0, 74.0, 75.0)),
            right_arm: arm(vec3(-36.0, 74.0, 96.0)),
        ),
        body(
            hips: vec3(0.012, 0.885, 0.0),
            pelvis: vec3(7.0, -3.0, 2.0),
            spine: vec2(4.0, 5.0),
            left: leg(vec4(-8.0, 42.0, -18.0, 0.0)),
            right: leg(vec4(-15.0, 110.0, -5.0, 0.0)),
            left_arm: arm(vec3(10.0, 74.0, 85.0)),
            right_arm: arm(vec3(-15.0, 74.0, 90.0)),
        ),
        body(
            hips: vec3(0.006, 0.952, 0.0),
            pelvis: vec3(7.0, 4.0, 0.0),
            spine: vec2(4.0, -6.0),
            left: leg(vec4(22.0, 18.0, 30.0, -25.0)),
            right: leg(vec4(-45.0, 85.0, -8.0, 0.0)),
            left_arm: arm(vec3(-30.0, 74.0, 95.0)),
            right_arm: arm(vec3(20.0, 74.0, 75.0)),
        ),
        body(
            hips: vec3(0.0, 0.985, 0.0),
            pelvis: vec3(7.0, 7.0, 0.0),
            spine: vec2(4.0, -10.0),
            left: leg(vec4(12.0, 60.0, 18.0, -5.0)),
            right: leg(vec4(-42.0, 40.0, -2.0, 0.0)),
            left_arm: arm(vec3(-35.0, 74.0, 98.0)),
            right_arm: arm(vec3(28.0, 74.0, 75.0)),
        ),
    ]
}

/// The run's period (s), and the shares of it a foot and its heel are down, as its keys have them:
/// its heel lifts a little after mid-stance, its toes leave by the toe-off key.
pub const RUN_PERIOD: f32 = 0.72
pub const RUN_STANCE: f32 = 0.22
pub const RUN_HEEL: f32 = 0.12

// ---- standing ------------------------------------------------------------------------------------

/// Standing: two poses a breath apart, the weight shifting a little from one foot to the other.
pub fn idle_keys() -> [Pose; 4] {
    let a = body(
        hips: vec3(0.008, 0.972, 0.0),
        pelvis: vec3(1.0, 0.0, -1.0),
        spine: vec2(0.0, 0.0),
        left: leg(vec4(-1.0, 3.0, 1.0, 0.0)),
        right: leg(vec4(1.5, 4.0, -1.5, 0.0)),
        left_arm: arm(vec3(-2.0, 80.0, 12.0)),
        right_arm: arm(vec3(-2.0, 80.0, 12.0)),
    )
    let b = body(
        hips: vec3(0.0, 0.975, 0.0),
        pelvis: vec3(0.5, 0.0, 0.0),
        spine: vec2(2.0, 0.0),
        left: leg(vec4(-0.5, 3.0, 0.5, 0.0)),
        right: leg(vec4(0.5, 3.0, -0.5, 0.0)),
        left_arm: arm(vec3(-3.0, 79.0, 14.0)),
        right_arm: arm(vec3(-3.0, 79.0, 14.0)),
    )
    [a, b, a.mirrored(), b]
}

/// The idle's period (s).
pub const IDLE_PERIOD: f32 = 4.0

/// Side A: these cycles, periods and stances (`motion::source`).
pub fn source() -> motion::Source {
    motion::source(
        cycle(idle_keys()),
        cycle(walk_keys()),
        cycle(run_keys()),
        periods: vec3(IDLE_PERIOD, WALK_PERIOD, RUN_PERIOD),
        stances: vec4(WALK_STANCE, RUN_STANCE, WALK_HEEL, RUN_HEEL),
    )
}

/// A half cycle's keys and its mirror: the whole cycle's eight, evenly spaced.
pub fn cycle(half: [Pose; 4]) -> Vec<Pose> {
    var out: Vec<Pose> = Vec::new()
    for k in 0..4 {
        out.push(half[k])
    }
    for k in 0..4 {
        out.push(half[k].mirrored())
    }
    out
}
