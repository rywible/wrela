// The region's history (spike 17), from spike 16's: nine hundred years over the map's square
// kilometre, on the CPU, from the terrain up.
// - Water finds the hollows; thin soil lies on the crests.
// - A forest of seven species grows, competes for light, dies, stands, falls and rots: beech
//   where the soil is deep, oak and pine on the dry crests, alder and birch in the wet.
// - People build the tower, lay the road along the knoll's sightline and keep both clear, then
//   leave. A storm opens the clearing; a herd comes, keeps it open, drinks at the Sink and wears
//   its trails between them.
// - A fire makes the burn; the giant falls across the Cut; a gale makes the windthrow.
// The author's map gives the events and the relations; each relation is held as a pin (a
// sightline caps the trees' height in its cone). What's left in the last year is what's drawn
// and what the interest check measures. Throwaway code: it answers the spike's question.

use engine::noise::{noise2, rand}
use map::{
    CUT_PATH, LAWNS, ROUND_2, SPINE_PATH, HILLS, RIDGE, DRINK, FIRE_AT, FIRE_REACH, FIRE_YEAR, GIANT_KEY, GIANT_YEAR, KEYSTONES, PEOPLE_FROM,
    PEOPLE_TO, REGION_HI, REGION_LO, RELATIONS, RING_KEY, ROAD, ROAD_WIDTH, SIGHT, SIGHT_CLEAR,
    SIGHT_WIDTH, TOWER_KEY, WATCH_CLEAR, WINDTHROW_AT, WINDTHROW_REACH, WINDTHROW_YEAR, to_road,
    to_segment,
}
use rocks::{Spot, reach}
use scene::{ACROSS, KNOLL, MEADOW, STAND, SUN, EYE_HEIGHT, height, in_gap, past_edge, rocky}
use std::math::{PI, TAU}

// ---- the grids ----------------------------------------------------------------------------------

/// The domain the history runs over: the map's square, 2 m cells, `N` by `N`, from (`X0`, `Z0`).
pub const X0: f32 = -200.0
pub const Z0: f32 = -700.0
pub const CELL: f32 = 2.0
pub const N: u32 = 500

/// The fine grid, where the herd walks: 1 m cells over the same square, `FN` by `FN`.
pub const FX0: f32 = -200.0
pub const FZ0: f32 = -700.0
pub const FCELL: f32 = 1.0
pub const FN: u32 = 1000

fn index(i: i32, j: i32, n: u32) -> u32 {
    u32(clamp(j, 0, i32(n) - 1)) * n + u32(clamp(i, 0, i32(n) - 1))
}

/// The domain's cell at `p`, clamped to the domain.
pub fn cell(p: vec2) -> u32 {
    index(i32(floor((p.x - X0) / CELL)), i32(floor((p.y - Z0) / CELL)), N)
}

/// The middle of the domain's cell `c`.
pub fn centre(c: u32) -> vec2 {
    vec2(X0 + (f32(c % N) + 0.5) * CELL, Z0 + (f32(c / N) + 0.5) * CELL)
}

/// The fine grid's cell at `p`, clamped to the grid.
pub fn fcell(p: vec2) -> u32 {
    index(i32(floor((p.x - FX0) / FCELL)), i32(floor((p.y - FZ0) / FCELL)), FN)
}

/// The middle of the fine grid's cell `c`.
pub fn fcentre(c: u32) -> vec2 {
    vec2(FX0 + (f32(c % FN) + 0.5) * FCELL, FZ0 + (f32(c / FN) + 0.5) * FCELL)
}

/// Whether `p` is in the domain.
pub fn in_domain(p: vec2) -> bool {
    let e = f32(N) * CELL
    p.x > X0 && p.x < X0 + e && p.y > Z0 && p.y < Z0 + e
}

fn bilinear(g: [f32], p: vec2, x0: f32, z0: f32, size: f32, n: u32) -> f32 {
    let u = (p.x - x0) / size - 0.5
    let v = (p.y - z0) / size - 0.5
    let i = clamp(i32(floor(u)), 0, i32(n) - 2)
    let j = clamp(i32(floor(v)), 0, i32(n) - 2)
    let s = clamp(u - f32(i), 0.0, 1.0)
    let t = clamp(v - f32(j), 0.0, 1.0)
    let k = u32(j) * n + u32(i)
    mix(mix(g[k], g[k + 1], s), mix(g[k + n], g[k + n + 1], s), t)
}

/// A domain grid's value at `p`, bilinear.
pub fn sample(g: [f32], p: vec2) -> f32 {
    bilinear(g, p, X0, Z0, CELL, N)
}

/// A fine grid's value at `p`, bilinear.
pub fn fine(g: [f32], p: vec2) -> f32 {
    bilinear(g, p, FX0, FZ0, FCELL, FN)
}

/// A box blur of an `n` by `n` grid, `r` cells each way, across then down: running sums, the
/// edges clamped.
pub fn blur(g: [f32], n: u32, r: i32) -> Vec<f32> {
    let w = 1.0 / f32(2 * r + 1)
    let last = i32(n) - 1
    var a: Vec<f32> = Vec::filled(n * n, 0.0)
    for j in 0..n {
        let row = j * n
        var s = 0.0
        for k in 0..(2 * r + 1) {
            s += g[row + u32(clamp(k - r, 0, last))]
        }
        a[row] = s * w
        for i in 1..n {
            let add = u32(clamp(i32(i) + r, 0, last))
            let sub = u32(clamp(i32(i) - r - 1, 0, last))
            s += g[row + add] - g[row + sub]
            a[row + i] = s * w
        }
    }
    var b: Vec<f32> = Vec::filled(n * n, 0.0)
    for i in 0..n {
        var s = 0.0
        for k in 0..(2 * r + 1) {
            s += a[u32(clamp(k - r, 0, last)) * n + i]
        }
        b[i] = s * w
        for j in 1..n {
            let add = u32(clamp(i32(j) + r, 0, last))
            let sub = u32(clamp(i32(j) - r - 1, 0, last))
            s += a[add * n + i] - a[sub * n + i]
            b[j * n + i] = s * w
        }
    }
    b
}

/// The eight neighbours' offsets.
const DI = [-1, 0, 1, -1, 1, -1, 0, 1]
const DJ = [-1, -1, -1, 0, 0, 1, 1, 1]

// ---- the species --------------------------------------------------------------------------------

/// The forest's step: it grows, dies and seeds every other year; the herd walks every year.
pub const STEP_YEARS: f32 = 2.0

pub const OAK: u32 = 0
pub const BEECH: u32 = 1
pub const BIRCH: u32 = 2
pub const THORN: u32 = 3
pub const BLACKTHORN: u32 = 4
pub const PINE: u32 = 5
pub const ALDER: u32 = 6
pub const KINDS: u32 = 7
/// Seed of each species from the forests beyond the domain: birch's and pine's ride the wind.
const BEYOND = [0.01, 0.005, 0.3, 0.4, 0.3, 0.1, 0.05]

/// How a species lives.
pub struct Habit: Copy {
    /// Its greatest height (m), and how fast it grows in full light while it's small (m a year).
    pub tallest: f32,
    pub rate: f32,
    /// The light it needs to grow at all (0 to 1 of the open sky's).
    pub need: f32,
    pub lifespan: f32,
    /// Its crown's radius per metre of height, in the open.
    pub crown: f32,
    /// How much of the light its crown stops.
    pub shade: f32,
    /// How readily grazers eat it while it's small.
    pub palatable: f32,
    /// How far its seed goes (m), and the age it first seeds at.
    pub reach: f32,
    pub mature: f32,
    /// Years it stands dead, and years it lasts as a log, per metre of height.
    pub stands: f32,
    pub rots: f32,
}

