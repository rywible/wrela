// ---- helpers ----------------------------------------------------------------------------------

/// The distance from `p` to the segment `a`–`b`, and how far along it the nearest point is (0
/// to 1).
pub fn to_segment(p: vec2, a: vec2, b: vec2) -> (f32, f32) {
    let ab = b - a
    let t = clamp(dot(p - a, ab) / max(dot(ab, ab), 1.0e-6), 0.0, 1.0)
    (length(p - a - ab * t), t)
}

/// The distance from `p` to the road (m).
pub fn to_road(p: vec2) -> f32 {
    var best = 1.0e9
    for i in 0..5 {
        let (d, _) = to_segment(p, ROAD[i], ROAD[i + 1])
        best = min(best, d)
    }
    best
}

/// The distance from `p` to the Cut's course (m), and how far along it (m from the Sink).
pub fn to_cut(p: vec2) -> (f32, f32) {
    var best = 1.0e9
    var along = 0.0
    var walked = 0.0
    for i in 0..5 {
        let (d, t) = to_segment(p, CUT[i], CUT[i + 1])
        let len = length(CUT[i + 1] - CUT[i])
        if d < best {
            best = d
            along = walked + t * len
        }
        walked += len
    }
    (best, along)
}

/// A direction on the plane at angle `a` (radians, from +x toward +z).
pub fn heading(a: f32) -> vec2 {
    vec2(cos(a), sin(a))
}

/// A full turn, for code that sweeps round a point.
pub const TURN: f32 = TAU
