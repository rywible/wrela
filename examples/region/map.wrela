// ---- the keystones -------------------------------------------------------------------------------

/// What a keystone is, for the history (what it does to the forest), the interest check (how
/// it draws the eye) and the renderer (what's drawn).
pub const TREE: u32 = 0
pub const TOWER: u32 = 1
pub const TOR: u32 = 2
pub const RING: u32 = 3
pub const WAYSTONE: u32 = 4
pub const GIANT: u32 = 5
pub const VISTA: u32 = 6
pub const GLADE: u32 = 7

/// A keystone: where it is, what it is, how tall it stands above the ground (m), how far it
/// reaches on the plane (m), and how strongly it draws the eye where it's seen (0 to 1).
pub struct Keystone: Copy {
    pub at: vec2,
    pub kind: u32,
    pub tall: f32,
    pub reach: f32,
    pub salience: f32,
    pub name: Text,
}

/// Where the keystones whose places the land's shapes need stand (GPU code reads these, so
/// they're plain numbers).
pub const TOWER_AT = vec2(560.0, -470.0)
pub const TOR_AT = vec2(330.0, -150.0)

