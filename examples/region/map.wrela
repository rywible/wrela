pub const KEYSTONES = [
    // The clearing's great oak, on its knoll (scene::KNOLL).
    Keystone { at: vec2(7.0, 33.0), kind: TREE, tall: 16.0, reach: 9.0, salience: 0.8, name: "the great oak" },
    // The tower on the Watch: a broken round tower, the region's landmark.
    Keystone { at: vec2(560.0, -470.0), kind: TOWER, tall: 22.0, reach: 6.0, salience: 1.0, name: "the tower" },
    // The tor, on the Spine's high point: granite above the trees.
    Keystone { at: vec2(330.0, -150.0), kind: TOR, tall: 7.0, reach: 14.0, salience: 0.7, name: "the tor" },
    // The ring of standing stones, in a glade deep in the south-west.
    Keystone { at: vec2(40.0, -455.0), kind: RING, tall: 2.6, reach: 9.0, salience: 0.6, name: "the ring" },
