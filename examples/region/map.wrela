// ---- relations -----------------------------------------------------------------------------------

/// What a relation asks: `to` seen from `from` (a sightline the history keeps open); `to`
/// hidden until a player reaches `from` (a reveal: the land hides it before).
pub const SIGHT: u32 = 0
pub const REVEAL: u32 = 1

/// A relation: its kind, the place it's judged from (a point on the plane, and how far round
/// it a player may stand), and the keystone it's about.
pub struct Relation: Copy {
    pub kind: u32,
    pub from: vec2,
    pub within: f32,
    pub to: u32,
    pub name: Text,
}

pub const RELATIONS = [
    // From the great oak's knoll, the tower over the trees: the clearing's promise of the
    // region. The old road was laid out along it.
    Relation { kind: SIGHT, from: vec2(4.0, 26.0), within: 6.0, to: TOWER_KEY, name: "the tower from the knoll" },
    // From the tor, the tower, and the Sink below.
    Relation { kind: SIGHT, from: vec2(330.0, -150.0), within: 10.0, to: TOWER_KEY, name: "the tower from the tor" },
    Relation { kind: SIGHT, from: vec2(330.0, -150.0), within: 10.0, to: SINK_KEY, name: "the sink from the tor" },
    // The Sink stays hidden until the Spine's crest.
    Relation { kind: REVEAL, from: vec2(300.0, -200.0), within: 30.0, to: SINK_KEY, name: "the sink revealed at the crest" },
    // The tor seen from the clearing's south side, over the trees: a second promise.
    Relation { kind: SIGHT, from: vec2(14.0, 18.0), within: 8.0, to: TOR_KEY, name: "the tor from the clearing" },
]

/// How far below a sightline the history keeps the trees' tops (m), and how wide the cone is
/// at its far end (m): a ride through the forest, not a cut.
pub const SIGHT_CLEAR: f32 = 1.5
pub const SIGHT_WIDTH: f32 = 14.0

