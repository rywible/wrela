A Whale:
    has:
        name: String
        type: String

    can swim(distance: Number, new_parameter: String) -> Nothing:
        print("Hi! My name is {its.name} and I can swim {distance.toString()}")

to make_moby_swim(fake_param: String) -> Nothing:
    moby = Whale(name="moby")
    moby.swim(distance=500)

