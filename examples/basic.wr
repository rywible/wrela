A Whale:
    has:
        name: String

    can swim(distance: Number) -> Nothing:
        print("Hi! My name is {its.name} and I can swim {distance.toString()}")

to make_moby_swim():
    moby = Whale(name="moby")
    moby.swim(500)

make_moby_swim()

whale = detach Whale() * n

whale = detach Whale() * 1 optimize latency
whale = Whale(name=23)