// The vale (plan three's §B1): a grown valley drawn by the engine's frame, with no game sim. Its
// land (landscape.wrela), its water (water.wrela) and its wood's history (history.wrela) are made
// when it's built; what it draws is its stage (stage.wrela), streamed round the eye. The camera
// is held on the lookbook's shots (L, the shot's number, Enter; Escape lets it go), or walks the
// vale's walk (walk.wrela), or stands where a test holds it.

use engine::frame::{Aim, Change, Frame, Quality, ShadowQuality, Shared}
use engine::light::Light
use engine::switches::Switches
use engine::tier::{Tier, Tiered, Tiers}
use styles
use styles::physical::Physical
use engine::shadow::Cascade
use engine::shot::{NO_CAST, Shots, Skies, place}
use engine::view::first_camera
use land::stage::{fields_clipmap, probe_grid}
use landscape::height_at
use stage::{Stage, TILES, stage}
use std::input::{Event, events}
use std::io::print

/// The far static cascade: over the whole vale (the near follows the eye: the frame's defaults).
const FAR_CASCADE = Cascade {
    centre: vec3(0.0, 80.0, 0.0),
    span: 1400.0,
    reach: 1600.0,
    side: 2048,
}

/// How the vale is drawn: the engine's defaults (the floor's: every switch on), and its far
/// cascade, as its tier draws them.
fn quality() -> Quality {
    TIER.quality(Quality { shadows: ShadowQuality { far: FAR_CASCADE } })
}

/// The vale's look (`engine::style`, Part D): `wrela build examples/vale --set
/// LOOK=styles::fixtures::Every` builds it in another.
pub type LOOK = Physical

/// The vale's tier (`engine::tier`, D37): `wrela build examples/vale --set TIER=Medium` builds
/// another.
pub const TIER: Tier = Tier::Epic

/// The vale's switches: its tier's (`engine::tier::Tiered`), each else at its approved value.
pub struct ValeTier {}

impl Switches for ValeTier {}

impl Tiers for ValeTier {
    const TIER: Tier = TIER
}

/// The field of view the walk and a held camera see with (radians).
const FOVY: f32 = 0.82

/// Where the eye starts, before the walk or a shot: the vale's middle, 1.7 m over the ground,
/// looking up the valley.
pub fn start_eye() -> vec3 {
    vec3(0.0, height_at(vec2(0.0)) + 1.7, 0.0)
}

pub struct Vale {
    /// The frame (the engine's: targets, light, shadows, probes, sky, readiness) and what it
    /// draws (stage.wrela).
    frame: Frame<Shared, Tiered<ValeTier>, LOOK>,
    stage: Stage,
    /// The lookbook's shot the camera's held on (lookbook.wrela), if one is.
    shots: Shots,
    /// The camera a test holds (eye, what it looks at), if one does.
    held: Option<(vec3, vec3)>,
    /// Whether the vale's ready: playable, its tiles round the eye in.
    ready: bool,
    /// The hour the frame is lit at (`day`; its weather is the stage's, `Stage::skies`).
    hour: f32,
    /// A fitting look's candidate constants (`fit`), carried in the light.
    fit: [vec4; 2],
    /// How many frames the walk has run (none: it hasn't begun; W begins it).
    walked: Option<u32>,
    /// The grazer's walk in "down the trail", while that shot's held: the shot's held since, and
    /// the walk (`grazer::Walking`).
    walking: Option<(f32, grazer::Walking)>,
    /// The grazer's pose grazing in another cast shot, while it's held: the shot's held since, and
    /// its palette (world space, `grazer::grazing`: found once a hold).
    grazing: Option<(f32, grazer::Grazing)>,
}

/// The shot the grazer walks in (lookbook.wrela's "down the trail"): toward the eye along its
/// look, `TRAIL_AT` m from it at the shot's still.
pub const WALKS_IN: Text = "down the trail"
pub const TRAIL_AT: f32 = 10.0

/// How far from facing the eye the grazer grazes (radians: three-quarters on, its side and its
/// face both seen).
pub const GRAZING_TURN: f32 = 0.9

/// The hour and the weather of the walk, and of a camera held by a test (**proposed**).
pub const WALK_HOUR: f32 = 10.5
pub const WALK_SKIES: Skies = Skies::Fair

/// The air and the light at `hour` in `skies`, for an eye `eye` m high.
fn lit(hour: f32, skies: Skies, eye: f32) -> (engine::air::Air, engine::light::Light) {
    let air = day::air_at(hour, skies, eye)
    (air, day::light_at(air, skies))
}

/// The frame lit at `hour` in `skies`: its air and light (the frame draws its shadows and its sky
/// again as the sun moves), and its sky's weather cooked again when the weather changes.
fn light(s: mut Vale, hour: f32, skies: Skies, eye: f32) {
    if hour == s.hour && skies == s.stage.skies {
        return
    }
    let (air, light) = lit(hour, skies, eye)
    s.frame.air = air
    s.frame.light = Light { fit: s.fit, ..light }
    if skies != s.stage.skies {
        s.stage.skies = skies
        s.frame.changed(Change::Weather)
    }
    s.hour = hour
}

pub fn init() -> Vale {
    // The archetypes grown at build, as this host holds them (§E7's hashes: the same everywhere).
    var h = std::hash::Hasher::new()
    borrow grown = trees::archetypes::GROWN
    for i in 0..(grown.len() / 4) {
        h.write_u32(land::bake::get_u32(grown, 4 * i))
    }
    for i in (4 * (grown.len() / 4))..grown.len() {
        h.write_u32(u32(grown[i]))
    }
    print(
        f"grown: the archetypes, {trees::archetypes::GROWN.len()} bytes; their hash {h.finish():016x}",
    )
    let eye = start_eye()
    let at = eye + vec3(0.0, 0.0, 1.0)
    let (air, light) = lit(WALK_HOUR, WALK_SKIES, eye.y)
    let f: Frame<Shared, Tiered<ValeTier>, LOOK> = Frame::new(
        quality(),
        light,
        air,
        fields_clipmap(),
        first_camera(eye, at, FOVY, width: 960, height: 540),
        probe_grid(eye.xz, vec2(0.0), TILES),
        eye.xz,
    )
    Vale {
        frame: f,
        stage: stage(),
        shots: Shots {},
        held: None,
        ready: false,
        hour: WALK_HOUR,
        fit: [vec4(0.0), vec4(0.0)],
        walked: None,
        walking: None,
        grazing: None,
    }
}

/// The keys: L, a number and Enter hold the camera on a lookbook shot, and Escape lets it go; W
/// begins the walk; the frame's own (its views, its lookdev instrument) otherwise.
fn keys(s: mut Vale, time: f32) {
    for e in events() {
        if let Event::KeyDown { key, .. } = e {
            let chose = s.shots.key(key, lookbook::SHOTS.len(), time)
            if chose.chosen {
                s.frame.arrive()
            }
            if chose.taken {
                continue
            }
            if key == std::input::Key::W && s.walked.is_none() {
                s.walked = Some(0)
            } else {
                let _ = s.frame.key(key)
            }
        }
    }
}

pub fn frame(s: mut Vale, time: f32, width: u32, height: u32) {
    keys(mut s, time)
    // Its clocks held while the frame's time is (the lookdev instrument's F10, F12).
    let time = s.frame.held_time(time)
    s.shots.clock(time, covered: s.frame.ready.arriving)
    let (eye, at, fovy, hour, skies) = match (s.held, s.shots.held) {
        (Some(h), _) => (h.0, h.1, FOVY, WALK_HOUR, WALK_SKIES),
        (None, Some(i)) => {
            let sh = lookbook::SHOTS[i]
            let (e, a) = place(sh, s.shots.since(time), height_at)
            (e, a, sh.fovy, sh.time, sh.weather)
        },
        (None, None) => {
            let (e, a) = walk::at(match s.walked {
                Some(n) => n,
                None => 0,
            })
            (e, a, FOVY, WALK_HOUR, WALK_SKIES)
        },
    }
    light(mut s, hour, skies, eye.y)
    // The grazer, where a held shot casts it (`Shot::cast`): walking toward the eye along its look
    // in "down the trail", grazing there facing three-quarters from the eye in another;
    // not drawn otherwise.
    let origin = s.frame.origin
    let cast = match (s.held, s.shots.held) {
        (None, Some(i)) => if lookbook::SHOTS[i].cast != NO_CAST { Some(i) } else { None },
        _ => None,
    }
    let from = s.shots.from
    match cast {
        Some(i) => if lookbook::SHOTS[i].name == WALKS_IN {
            s.grazing = None
            let fresh = match s.walking {
                Some((f, _)) => f != from,
                None => true,
            }
            if fresh {
                // From far enough up the trail that it's `TRAIL_AT` from the eye at the shot's
                // still (`engine::shot::SETTLE` in; its speed eased up over its first half second).
                let toward = normalize(at.xz - eye.xz)
                let lead = grazer::walk().walk.speed * (engine::shot::SETTLE - 0.5)
                s.walking = Some(
                    (from, grazer::set_off(eye.xz + toward * (TRAIL_AT + lead), eye.xz)),
                )
            }
            if let Some((f, w)) = s.walking {
                var w = w
                let since = s.shots.since(time)
                let was = w.walker.feet
                grazer::walk_to(mut w, since)
                // Where a hoof came down since the last frame (a splash or a puff: `Stage::emit`).
                for i in 0..4 {
                    let foot = w.walker.feet[i]
                    if foot.planted && !was[i].planted {
                        s.stage.footfalls.push((foot.at - origin, foot.at))
                    }
                }
                let bones = grazer::walking(mut w, engine::motion::motion_of::<LOOK>(), since, eye)
                s.stage.pushes = grazer::pushes(grazer::body(), w.walker, origin)
                s.walking = Some((f, w))
                s.stage.grazer.pose(grazer::shifted(bones, origin), shadowed: true, moved: false)
            }
        } else {
            s.walking = None
            let fresh = match s.grazing {
                Some((f, _)) => f != from,
                None => true,
            }
            if fresh {
                let heading = atan2(eye.x - at.x, eye.z - at.z) + GRAZING_TURN
                s.grazing = Some((from, grazer::grazing(at.xz, heading)))
            }
            if let Some((f, g)) = s.grazing {
                var g = g
                let bones = grazer::grazing_now(mut g, s.shots.since(time), eye)
                s.stage.pushes = grazer::pushes(g.body, g.walker, origin)
                s.grazing = Some((f, g))
                s.stage.grazer.pose(grazer::shifted(bones, origin), shadowed: true, moved: false)
            }
        },
        None => {
            s.walking = None
            s.grazing = None
            s.stage.pushes = [engine::grass::Push {}; engine::grass::PUSHES]
            s.stage.grazer.hide()
        },
    }
    let aim = Aim { eye, at, fovy, moving_at: eye }
    let _ = s.frame.begin(mut s.stage, aim, time, width, height)
    s.frame.draw(mut s.stage, aim)
    // The walk steps a frame from W, playable or not, so every run walks the same frames (the
    // bench's `vale-walk` presses W at frame 240, once the vale has loaded at rest).
    if let Some(n) = s.walked {
        s.walked = Some(min(n + 1, walk::FRAMES))
    }
    if !s.ready && s.frame.ready.playable_at.is_some() {
        s.ready = true
        print(f"vale ready at frame {s.frame.frames}")
    }
}

// ---- for tests -----------------------------------------------------------------------------------

/// The camera held at `eye`, looking at `at`.
/// A fitting look's candidate constants (`wrela tool fit --style`: `engine::style::Knob`), from
/// the next frame: the light carries them to the look's slots.
pub fn fit(s: mut Vale, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, g: f32, h: f32) {
    s.fit = [vec4(a, b, c, d), vec4(e, f, g, h)]
    s.frame.light = Light { fit: s.fit, ..s.frame.light }
}

@testing
pub fn test_hold(s: mut Vale, eye: vec3, at: vec3) {
    s.held = Some((eye, at))
}

/// How many trees the wood holds of the tiles that have come (each tile's own instances).
pub fn loaded(s: Vale) -> u32 {
    var n = 0
    for a in s.stage.land.own {
        n += a.placed.len()
    }
    n
}

/// The vale's first frames from its middle: its wood made and its tiles round the eye in, more
/// than a thousand trees of them placed, and playable within the frames.
@test(frames: 400, gpu: true)
fn the_vale_draws_its_forest_from_its_history(s: Vale) {
    let n = loaded(s)
    let Some(playable) = s.frame.ready.playable_at else { panic("playable within 400 frames") }
    let Some(wood) = s.stage.land.wood_at else { panic("the wood within 400 frames") }
    print(
        f"the vale: {s.stage.land.own.len()} tiles, {n} trees loaded; the wood at frame {wood}, playable at frame {playable}",
    )
    assert(n > 1000, f"{n} trees loaded")
}

/// The trees near the eye drawn as themselves (docs/plan-world-class-3.md §E1.3): after its first
/// frames, the vale's near individuals are drawn, each within `NEAR` of the eye, each grown from
/// its own record (its growth's seed the record's); every other instance is its kind's archetype.
@test(frames: 900, gpu: true)
fn the_trees_near_the_eye_are_their_own(s: Vale) {
    let eye = s.stage.land.eye
    var drawn = 0
    for o in s.stage.land.near {
        if !o.drawn {
            continue
        }
        drawn += 1
        let d = length(o.at - vec2(eye.x, eye.z))
        assert(d < land::stage::NEAR + 30.0, f"an individual {d} m from the eye")
        var seed = 0
        for g in s.stage.land.grounds {
            for t in g.trees {
                if length(t.at - o.at) < 1.0e-2 {
                    seed = t.seed
                }
            }
        }
        assert(o.seed == seed, f"an individual grown from seed {o.seed}, its record's {seed}")
    }
    print(f"the vale: {drawn} of {s.stage.land.near.len()} near trees drawn as themselves")
    assert(drawn >= 8, f"{drawn} near trees drawn as themselves")
}

/// The floor's small causes placed on the vale (docs/plan-world-class-3.md §E4), counted over its
/// tiles as they've come: its fallen trees and their brackets and lost bark (by each one's rot), the
/// litter's mean depth and the share of its ground in moss's causes (by its fields' light and
/// wetness), and its trees old enough to carry lichen. Printed for its design.md's "What is grown".
@test(frames: 400, gpu: true)
fn the_vales_small_causes_are_placed(s: Vale) {
    var logs = 0
    var brackets = 0
    var bare = 0.0
    var lichened = 0
    for a in s.stage.land.own {
        for p in a.placed {
            let h = p.at.history.decode()
            if p.kind == trees::kinds::LOG_SHORT || p.kind == trees::kinds::LOG_LONG {
                logs += 1
                brackets += engine::growth::fungi_on(
                    h.x,
                    12.0 * p.at.scale,
                    u32(abs(p.at.at.x * 7.0 + p.at.at.z * 13.0)),
                ).len()
                bare += engine::growth::bare_share(h.x)
            } else if engine::growth::lichen_of(h) > 0.5 {
                lichened += 1
            }
        }
    }
    var litter = 0.0
    var mossy = 0
    var cells = 0
    for g in s.stage.land.grounds {
        let n = g.fields.len() / 4
        for i in 0..n {
            let light = f32(g.fields[4 * i]) / 255.0
            let wet = f32(g.fields[4 * i + 2]) / 255.0
            litter += engine::growth::litter_at(1.0 - light, land::cover::LITTER_SEASON)
            if wet > 0.4 && light < 0.5 {
                mossy += 1
            }
            cells += 1
        }
    }
    print(
        f"the vale's small causes: {logs} fallen trees, {brackets} brackets, {bare / f32(max(logs, 1))} of their bark gone; litter {litter / f32(max(cells, 1))} deep; {f32(mossy) / f32(max(cells, 1))} of the ground in moss's causes; {lichened} trees old enough for lichen",
    )
    assert(logs > 0 && cells > 0, "no fallen tree, or no ground")
}

/// The first ring of near trees (§E7: the `FIRST_N` nearest within 40 m of the first eye) grown and
/// drawn as themselves within the frames (none as its archetype: `Landscape::ring_fallen_back`),
/// each grown (nothing is kept in a test's storage). Its
/// time is printed, not judged: a frame test's host runs its parallel work on few helpers, so the
/// ring's growths queue; the budget (1,000 ms) is measured with a played page's helpers by
/// `wrela tool grow -- --hash` (docs/bench.md "E7").
@test(frames: 900, gpu: true)
fn the_first_ring_grows_before_the_vale_is_ready(s: Vale) {
    borrow land = s.stage.land
    let Some(ms) = land.ring_ms else { panic("the first ring wasn't drawn within 900 frames") }
    print(f"the first ring: {land.ring.len()} trees in {ms} ms")
    assert(land.ring.len() == land::stage::FIRST_N, f"{land.ring.len()} trees in the first ring")
    assert(land.ring_fallen_back == 0, f"{land.ring_fallen_back} of the ring drawn as archetypes")
}
