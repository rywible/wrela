// The vale's lookbook (plan three's §B1.4): its twelve shots, one of each class the plan fixes, in
// its order, and its eight development shots (D1–D8, of classes 1, 2, 3, 4, 6, 8, 9 and 12, each
// at another place, at least 80 m from the twelve's of its class), which every fit and every
// tuning uses (the twelve are for the reviews' record alone). `wrela tool lookbook --package
// examples/vale` renders them settled and records them in motion; a player chooses one as any
// shot (L, the number, Enter). Heights are above the ground under each point; each fixes its
// hour of the vale's day and its weather (`day`). Every place is **proposed**.

use engine::shot::{Shot, Skies}
use landscape::height_at

/// What looks toward the sun at `hour` from `eye` (x, height above the ground, z), `d` m away (x,
/// height above the ground there, z): the canopy against the sun.
pub fn toward_sun(eye: vec3, hour: f32, d: f32) -> vec3 {
    let sun = day::sun_toward(hour)
    let at = eye.xz + sun.xz * d
    let y = height_at(eye.xz) + eye.y + sun.y * d
    vec3(at.x, y - height_at(at), at.y)
}

/// How many of `SHOTS` are the twelve (the rest the development shots).
pub const EVALUATION: u32 = 12

