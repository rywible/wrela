// The vale's history: its forest grown by `land::grow` on its land as its water left it, from the
// floor's species (`trees::species`, the old wood's habits), as the floor's grown land's is
// (`land::grow::simulate_given`), from the soil its rock and its shape made (`landscape`) and as
// wet as its water makes it; with no people, a herd of deer that came three centuries before the
// present, which grazes the meadow at the mere's head and drinks at its shore, and a gale six years
// before the present that threw two of the crests' exposed stands, east and west of the mere. Grown at the bake's grain (2 m cells, 2-year steps) over the
// square's tiles, baked a file a tile with the far layer (`land::bake`), and cached by the build
// while nothing it reads changes.

use land::bake::{bake, unbake}
use land::grow::{BAKE, Given, Grain, Grid, History, Land, NONE, Start, simulate_given}
use land::place::{
    Character, Event, EventKind, Herd, Keeper, Kind, Map, Opening, Region, Route, RouteKind,
    tile_of,
}
use land::soil::SoilKind
use landscape::{CELLS, GRID, GROUND, HI, LO, VALE}
use std::io::{Shipped, ship}
use std::math::PI

/// The history's present: the year it ends (the floor's, so its trees' ages read alike).
pub const PRESENT: i32 = 900

/// The tiles the vale streams in: those its square touches.
pub fn tiles_lo() -> vec2i {
    tile_of(LO)
}

pub fn tiles_hi() -> vec2i {
    tile_of(HI - vec2(0.01))
}

/// The wood's mix (`land::place::Character::mix`, by `trees::species::HABITS`' order: oak, beech,
/// birch, hawthorn, blackthorn, pine, alder): its trees alike, so the ground picks among them as it
/// suits each (`land::grow::takes`), its shrubs few, as the floor's grown land's.
const WOOD = [0.2, 0.2, 0.15, 0.05, 0.0, 0.2, 0.2, 0.0]

/// The meadow at the mere's head: where its stream comes into it, how far it reaches (m), kept by
/// the herd's grazing.
pub fn meadow() -> Opening {
    Opening {
        at: meadow_at(),
        radius: MEADOW_REACH,
        keeper: Keeper::Grazing,
        name: "the mere's meadow",
    }
}

const MEADOW_REACH: f32 = 34.0

/// Where the main stream comes into the mere: its first cell in the mere's basin, moved up the
/// stream by the meadow's reach (so the meadow's on the land, the mere at its foot).
pub fn meadow_at() -> vec2 {
    borrow v = VALE
    let g = v.made.grid
    var k = 0
    while k < v.main.len() && v.lakes.of[v.main[k]] != v.mere {
        k += 1
    }
    let back = min(u32(MEADOW_REACH / g.cell), k)
    g.centre(v.main[k - back])
}

/// The mere as the map places it (x, z, radius, level): its middle, the radius of a disc as large.
pub fn mere() -> vec4 {
    borrow v = VALE
    let g = v.made.grid
    var sum = vec2(0.0)
    var n = 0
    for c in 0..CELLS {
        if v.lakes.of[c] == v.mere {
            sum += g.centre(c)
            n += 1
        }
    }
    let at = sum / f32(max(n, 1))
    vec4(at.x, at.y, sqrt(f32(n) * g.cell * g.cell / PI), v.lakes.level[v.mere])
}

/// Where the herd drinks: the mere's shore nearest the meadow.
pub fn drink() -> vec2 {
    let m = mere()
    let at = meadow_at()
    m.xy + normalize(at - m.xy) * m.z * 0.9
}

/// The herd's trail: from the meadow's middle down to the mere's shore, where it drinks.
pub fn trail() -> Route {
    let a = meadow_at()
    let b = drink()
    Route {
        kind: RouteKind::Herd,
        points: Vec::from([a, mix(a, b, 0.5), b]),
        width: 2.0,
        keeper: Keeper::Grazing,
        name: "the deer's trail to the mere",
    }
}

/// The gale six years before the present: where it threw the crests' stands (the east one's and the
/// west one's middles: from their gaps the vale shows wide, the lookbook's dusk shots), how far it
/// reached, and how it blew (**proposed**).
pub const GALE_YEAR: i32 = PRESENT - 6
pub const EAST_GAP = vec2(330.0, 236.0)
pub const WEST_GAP = vec2(-300.0, 24.0)
const GAP_REACH: f32 = 90.0
const GALE = vec2(0.75, -0.66)

/// The gale's two throws, and the gaps they opened, which the deer keep browsed while they're
/// recent (`land::place::RECENT`).
fn gale() -> (Vec<Event>, Vec<Opening>) {
    var events: Vec<Event> = Vec::new()
    var openings: Vec<Opening> = Vec::new()
    for (at, name) in [
        (EAST_GAP, "the east crest's windthrow"),
        (WEST_GAP, "the west crest's windthrow"),
    ] {
        events.push(
            Event {
                year: GALE_YEAR,
                kind: EventKind::Storm { at, reach: GAP_REACH, dir: GALE, share: 0.95 },
                name,
            },
        )
        openings.push(
            Opening { at, radius: GAP_REACH, keeper: Keeper::Event { year: GALE_YEAR }, name },
        )
    }
    (events, openings)
}

/// When the herd came (300 years before the present) and how many trips it makes a year.
const HERD_CAME: i32 = 300
const HERD_TRIPS: u32 = 12

/// The vale's map, as the history reads it: the square; its openings (the meadow, the gale's gaps),
/// its herd's trail and the gale; no sites or kept trees; one wood all over (`WOOD`); its mere; and
/// its herd.
pub fn vale_map() -> Map {
    let middle = 0.5 * (LO + HI)
    var regions: Vec<Region> = Vec::new()
    regions.push(
        Region {
            name: "the wood",
            kind: Kind::HighForest,
            at: middle,
            character: Character { mix: WOOD },
        },
    )
    let (events, gaps) = gale()
    var openings: Vec<Opening> = Vec::new()
    openings.push(meadow())
    for g in gaps {
        openings.push(g)
    }
    var routes: Vec<Route> = Vec::new()
    routes.push(trail())
    Map {
        lo: LO,
        hi: HI,
        present: PRESENT,
        land: land::place::Land {},
        sites: Vec::new(),
        relations: Vec::new(),
        openings,
        routes,
        water: land::place::Water { meres: [mere(), vec4(0.0)] },
        events,
        wind: GALE,
        kept: Vec::new(),
        regions,
        herd: Herd {
            arrives: PRESENT - HERD_CAME,
            trips: HERD_TRIPS,
            drink: drink(),
            rest: meadow_at(),
        },
    }
}

/// The wettest ground short of a stream's bed (the floor's grown land's: `land::grow` marks its
/// streams' beds itself).
const WETTEST: f32 = 0.88

/// What the land gives the history (`land::grow::Given`), on its grid at `grain`: its streams; how
/// wet each cell is (the land's wetness between its cells, to `WETTEST`); how thin its soil is
/// (bare rock 1, a soil 10 cm deep nearly, half a metre none, as `land::soil`'s thin soil is under
/// 35 cm); and the mere's water.
pub fn given(grain: Grain) -> Given {
    let g = Grid::over(LO, HI, grain.cell)
    borrow v = VALE
    Given {
        streams: landscape::streams(v),
        wet: Vec::from_fn(g.cells(), |c| WETTEST * GRID.sample(v.wet, g.centre(c))),
        thin: Vec::from_fn(g.cells(), |c| {
            let at = GRID.cell_at(g.centre(c))
            if v.soil[at] == SoilKind::Rock { 1.0 } else { 1.0 - smoothstep(0.1, 0.5, v.depth[at]) }
        }),
        water: Vec::from_fn(g.cells(), |c| v.lakes.of[GRID.cell_at(g.centre(c))] != NONE),
    }
}

/// The vale's history at `grain`.
pub fn grown(grain: Grain) -> History {
    let none: Vec<vec3> = Vec::new()
    simulate_given(
        GROUND,
        vale_map(),
        trees::species::ancient(),
        grain,
        LO,
        HI,
        none,
        wild,
        given(grain),
    )
}

/// No past: the land an old wood when its history begins.
fn wild(land: Land, year: i32) -> Start {
    Start::wild(land)
}

/// Each standing tree's fork chosen among its neighbours, as the floor's are.
pub fn forked(h: take History) -> History {
    let all = h.trees.clone()
    History { trees: trees::kinds::forked(take all), ..h }
}

/// Its bake, at the floor's grain (`land::grow::BAKE`): a file a tile and the far layer.
@fuel(2 ** 43)
pub const BAKED: Shipped = ship("vale", bake(forked(grown(BAKE)), tiles_lo(), tiles_hi()))

/// The bake read back.
pub fn decisions() -> land::bake::Unbaked {
    unbake(BAKED, tiles_lo(), tiles_hi())
}
