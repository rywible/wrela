// The wolf as a program. It realizes the wolf's mesh once (sketch 02's extraction) and walks
// it on the spot with sketch 01's cycle, skinned by the palette the gait's pose gives
// (`engine::walk`). Its exports give the tests (subjects.rs) the wolf's distance and points
// around it; the lens draws it too (`wrela studio examples/wolf`).

use creature::{Coat, wolf}
use engine::creature::Creature
use engine::look::CreatureLook
use engine::render::Shaded
use engine::walk::{Walker, walker}
use std::derive::Box3
use std::field::{part_family, part_image, part_share}
use std::lift::{Literal, count, gradient, literal, reads}
use std::units::mm

/// A box around the wolf, from the ground up: where its points are sampled.
pub const AROUND: Box3 = Box3 { lo: vec3(-0.3, -0.02, -0.85), hi: vec3(0.3, 1.1, 0.85) }

/// The wolf's distance at a point.
pub fn distance(x: f32, y: f32, z: f32) -> f32 {
    wolf().field().distance(vec3(x, y, z))
}

/// Point `i` of `AROUND`'s samples, seed `seed`.
pub fn sample(seed: u32, i: u32) -> vec3 {
    AROUND.sample(seed, i)
}

/// The wolf's gradient at a point.
pub fn gradient_at(x: f32, y: f32, z: f32) -> vec3 {
    wolf().field().gradient(vec3(x, y, z))
}

/// The part that decides the wolf's distance at a point, as its family (`part_family`): a part
/// and its mirror image give the same number.
pub fn part(x: f32, y: f32, z: f32) -> u32 {
    let f = wolf().field()
    part_family(f, f.part_at(vec3(x, y, z)).1)
}

/// Part `i`'s share in the distance at a point (`std::field::part_share`).
pub fn part_share_at(x: f32, y: f32, z: f32, i: u32) -> f32 {
    std::field::part_share(wolf().field(), vec3(x, y, z), i)
}

/// Part `i`'s mirror image (`part_image`: `i` if none).
pub fn image_part(i: u32) -> u32 {
    part_image(wolf().field(), i)
}

/// The part that decides the distance at a point (`Surface::part_at`'s index).
pub fn part_index(x: f32, y: f32, z: f32) -> u32 {
    wolf().field().part_at(vec3(x, y, z)).1
}

// ---- a lifted build's literals (`wrela build --lift wolf`), for the tests ------------------------

/// How many literals the build lifted (0 in a build that isn't lifted).
pub fn literals() -> u32 {
    count()
}

pub fn value(i: u32) -> f32 {
    if let Some(l) = literal(i) { l.value() } else { 0.0 }
}

pub fn set(i: u32, v: f32) {
    if let Some(l) = literal(i) {
        l.set(v)
    }
}

/// The distance's derivative by literal `i` at a point.
pub fn derivative(x: f32, y: f32, z: f32, i: u32) -> f32 {
    let p = vec3(x, y, z)
    let (_, d) = gradient(|| wolf().field().distance(p), [Literal { index: i }])
    d[0]
}

/// How many literals the distance reads.
pub fn reads_count() -> u32 {
    reads(|| wolf().field().distance(vec3(0.0))).len()
}

/// The `k`th literal the distance reads, in index order.
pub fn read_literal(k: u32) -> u32 {
    reads(|| wolf().field().distance(vec3(0.0)))[k].index
}

impl Shaded for Coat {
    fn albedo(self) -> vec3 {
        vec3(self.albedo.r, self.albedo.g, self.albedo.b)
    }

    fn roughness(self) -> f32 {
        0.8
    }
}

/// The wolf's mesh: cells of about 1.4 cm.
const LOOK = CreatureLook { surface: engine::look::Mesh { tolerance: 0.5mm } }

pub fn init() -> Walker {
    walker(wolf(), LOOK)
}

pub fn frame(state: mut Walker, time: f32, width: u32, height: u32) {
    state.frame(wolf(), width, height, eye: vec3(2.6, 1.0, 1.0), at: vec3(0.0, 0.45, 0.0))
}

/// Sketch 01's cycle for 120 frames: the legs keep their bones' lengths, each foot is where
/// the gait puts it within 1 mm (or as near as its leg reaches: the wolf stands on nearly
/// straight legs, and the gait's stride, scaled to its 0.6 m hips, overreaches at its ends),
/// the feet come down where they rest and lift, and every bone's matrix is finite.
@test(frames: 120)
fn walks_with_sketch_01s_cycle(state: Walker) {
    let w = state.walked
    assert(w.frames == 120)
    assert(w.finite, "a bone's matrix isn't finite")
    assert(w.length_error < 1.0e-4, f"a bone's length changed by {w.length_error} m")
    assert(w.foot_error < 1mm, f"a foot is {w.foot_error} m from the gait's place, past its reach")
    assert(w.overreached * 2 < 4 * w.frames, f"{w.overreached} feet were beyond their legs' reach")
    assert(abs(w.lowest) < 1mm, f"the lowest a foot went is {w.lowest} m from its rest")
    assert(w.highest > 2.0e-2, f"the highest a foot went is {w.highest} m above its rest")
}

@test
fn each_part_shares_the_surface_where_it_decides_it() {
    let f = wolf().field()
    var i = 0
    var checked = 0
    while checked < 128 {
        let p = AROUND.sample(3, i)
        i += 1
        if abs(f.distance(p)) > 0.01 {
            continue
        }
        let part = f.part_at(p).1
        assert(
            part_share(f, p, part) != 0.0,
            f"part {part} doesn't share the surface it decides at ({p.x}, {p.y}, {p.z})",
        )
        checked += 1
    }
    // Far from its blends a part has no share: the nose, at the tail's tip; and an ear, at its
    // own image.
    let tail = f.part_at(vec3(0.0, 0.31, -0.69))
    let nose = f.part_at(vec3(0.0, 0.87, 0.82)).1
    assert(part_share(f, vec3(0.0, 0.31, -0.69), nose) == 0.0)
    assert(part_share(f, vec3(0.0, 0.87, 0.82), tail.1) == 0.0)
    let ear = vec3(0.06, 1.02, 0.55)
    let (left, right) = (f.part_at(ear).1, f.part_at(vec3(-0.06, 1.02, 0.55)).1)
    assert(left != right)
    assert(part_share(f, ear, left) > 0.5 && part_share(f, ear, right) == 0.0)
}
