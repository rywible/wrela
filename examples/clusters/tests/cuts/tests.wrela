// The tool tests: each builds examples/clusters as a test build, loads it on the machine's
// hardware GPU (never a software renderer) with a 640 × 360 screen, runs `init`, and drives it
// through its `@testing` exports: `view` sets the eye, the error and the copies, `ask_counts`,
// `counts` and `count` read the last frame's counts back, and `megabytes` the clusters' size.
// Frames are drawn at the times the tests name (`drive::frame_at`), and the screen captured.

use hosts::both::{Both, both_hosts, difference}
use std::collections::{Box, Vec}
use std::io::print
use std::job::Step
use std::string::String
use std::tool::answer
use std::tool::blob
use std::tool::blob::Data
use std::tool::drive
use std::tool::drive::Scalar
use std::tool::toolchain

/// The screen's size.
const W: u32 = 640
const H: u32 = 360

/// The eye low over the field of copies, looking along a row: near copies a few metres off, far
/// ones twenty, so the cut takes several levels.
const EYE = vec3(-2.0, 0.9, -1.5)
const AT = vec3(6.0, 0.3, 9.0)

/// The most bytes a blob read gives at once.
const CHUNK: u64 = 524288

/// The example, built as a test build into `scratch/clusters`, loaded on the GPU, `init` run.
@job
fn opened() -> drive::Build {
    var options = toolchain::options()
    options.testing = true
    var b = toolchain::build("repo/examples/clusters", "scratch/clusters", options)
    var built = b.poll()
    while built.is_none() {
        yield
        built = b.poll()
    }
    let Some(bp) = take built else { panic("no answer") }
    let Ok(build) = toolchain::read_built(take bp) else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the clusters build")
    var load = drive::gpu()
    load.width = W
    load.height = H
    var l = drive::load("scratch/clusters", load)
    var loaded = l.poll()
    while loaded.is_none() {
        yield
        loaded = l.poll()
    }
    let Some(lp) = take loaded else { panic("no answer") }
    let Ok(it) = drive::read_loaded(take lp) else { panic("the build loads on a hardware GPU") }
    var i = drive::init(it.build)
    var inited = i.poll()
    while inited.is_none() {
        yield
        inited = i.poll()
    }
    let Some(ip) = take inited else { panic("no answer") }
    let Ok(init) = drive::read_ran(take ip) else { panic("init's request") }
    if let Some(trap) = init.trap {
        panic(trap.message.as_str())
    }
    it.build
}

/// The export `name` called with `args`: its first result, as a `u32` (0 if it has none).
@job
fn called(h: take drive::Build, name: take String, args: take Vec<Scalar>) -> u32 {
    var c = drive::call(h, name.as_str(), args)
    var got = c.poll()
    while got.is_none() {
        yield
        got = c.poll()
    }
    let Some(cp) = take got else { panic("no answer") }
    let Ok(ran) = drive::read_ran(take cp) else { panic(f"{name.as_str()}'s request") }
    if let Some(trap) = ran.trap {
        panic(f"{name.as_str()}: {trap.message.as_str()}")
    }
    if ran.results.len() == 0 {
        return 0
    }
    match ran.results[0] {
        Scalar::I32(x) => u32(x),
        _ => panic(f"{name.as_str()} gives an integer"),
    }
}

/// A frame at `time`.
@job
fn framed(h: take drive::Build, time: take f32) {
    var f = drive::frame_at(h, time)
    var got = f.poll()
    while got.is_none() {
        yield
        got = f.poll()
    }
    let Some(fp) = take got else { panic("no answer") }
    let Ok(ran) = drive::read_ran(take fp) else { panic("the frame's request") }
    if let Some(trap) = ran.trap {
        panic(trap.message.as_str())
    }
}

/// The screen, RGBA8, rows top to bottom.
@job
fn screen(h: take drive::Build) -> Vec<u8> {
    var c = drive::capture(h)
    var captured = c.poll()
    while captured.is_none() {
        yield
        captured = c.poll()
    }
    let Some(cp) = take captured else { panic("no answer") }
    let Ok(shot) = drive::read_capture(take cp) else { panic("the capture") }
    var pixels: Vec<u8> = Vec::new()
    match take shot.rgba {
        Data::Bytes(v) => pixels = take v,
        Data::Blob(held) => {
            var n = blob::len(held)
            var counted = n.poll()
            while counted.is_none() {
                yield
                counted = n.poll()
            }
            let Some(np) = take counted else { panic("no answer") }
            let Ok(size) = blob::read_len(take np) else { panic("the blob's length") }
            var at: u64 = 0
            while at < size {
                let len = u32(min(size - at, CHUNK))
                var r = blob::read(held, at, len)
                var read = r.poll()
                while read.is_none() {
                    yield
                    read = r.poll()
                }
                let Some(rp) = take read else { panic("no answer") }
                let Ok(chunk) = answer(take rp) else { panic("the blob's bytes") }
                for j in 0..chunk.len() {
                    pixels.push(chunk[j])
                }
                at += u64(len)
            }
        },
    }
    assert(pixels.len() == 4 * W * H, "every pixel came back")
    pixels
}

/// The frame with the eye at `EYE` looking at `AT`, `pixels` of error, `side` × `side` copies:
/// the third, and every one before it whole (the lists have room for every quad the copies
/// could list, from the first frame).
@job
fn view(h: take drive::Build, pixels: take f32, side: take u32) -> Vec<u8> {
    var args: Vec<Scalar> = Vec::new()
    for x in [EYE.x, EYE.y, EYE.z, AT.x, AT.y, AT.z, pixels] {
        args.push(Scalar::F32(x))
    }
    args.push(Scalar::I32(i32(side)))
    var c = Box::new(called.start(h, String::from("view"), take args))
    var done = false
    while !done {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => done = true,
        }
    }
    for i in 0..3 {
        var f = Box::new(framed.start(h, f32(i) / 60.0))
        var drawn = false
        while !drawn {
            match f.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => drawn = true,
            }
        }
    }
    var s = Box::new(screen.start(h))
    loop {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(v) => return v,
        }
    }
}

/// The export `name` with `args` called, its first result.
@job
fn number(h: take drive::Build, name: take String, args: take Vec<Scalar>) -> u32 {
    var c = Box::new(called.start(h, take name, take args))
    loop {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(v) => return v,
        }
    }
}

/// A frame at `time`, through `framed`.
@job
fn drawn(h: take drive::Build, time: take f32) {
    var f = Box::new(framed.start(h, time))
    loop {
        match f.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => return,
        }
    }
}

/// The last frame's counts (`Clusters::counts`), checked: every level's clusters' quads fit its
/// room, and so do the quads its frame listed. How many levels listed some.
@job
fn levels_listed(h: take drive::Build) -> u32 {
    var a = Box::new(number.start(h, String::from("ask_counts"), Vec::new()))
    var asked = false
    while !asked {
        match a.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => asked = true,
        }
    }
    var n = 0
    var i = 0
    while i < 30 && n == 0 {
        var f = Box::new(drawn.start(h, 1.0 + f32(i) / 60.0))
        var done = false
        while !done {
            match f.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => done = true,
            }
        }
        var c = Box::new(number.start(h, String::from("counts"), Vec::new()))
        var counted = false
        while !counted {
            match c.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    n = v
                    counted = true
                },
            }
        }
        i += 1
    }
    assert(n > 0, "the counts never arrived")
    var got: Vec<u32> = Vec::new()
    for k in 0..n {
        var args: Vec<Scalar> = Vec::new()
        args.push(Scalar::I32(i32(k)))
        var c = Box::new(number.start(h, String::from("count"), take args))
        var read = false
        while !read {
            match c.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    got.push(v)
                    read = true
                },
            }
        }
    }
    var levels = 0
    for level in 0..n / 4 {
        let (wanted, room) = (got[4 * level], got[4 * level + 1])
        let (listed, list_room) = (got[4 * level + 2], got[4 * level + 3])
        print(f"level {level}: {wanted} quads of {room}, {listed} listed of {list_room}")
        assert(wanted <= room, f"level {level} wanted {wanted} quads, room for {room}")
        assert(listed <= list_room, f"level {level} listed {listed} quads, room for {list_room}")
        if listed > 0 {
            levels += 1
        }
    }
    levels
}

/// The clusters' megabytes once cooking's quads and vertices are fitted to what it emitted (read
/// back a few frames after cooking): frames until two running agree.
@job
fn settled_megabytes(h: take drive::Build) -> u32 {
    var last = 4294967295
    for i in 0..120 {
        var f = Box::new(drawn.start(h, 2.0 + f32(i) / 60.0))
        var done = false
        while !done {
            match f.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => done = true,
            }
        }
        var m = Box::new(number.start(h, String::from("megabytes"), Vec::new()))
        var mb = 0
        var read = false
        while !read {
            match m.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(v) => {
                    mb = v
                    read = true
                },
            }
        }
        if mb == last {
            return mb
        }
        last = mb
    }
    panic("the clusters' buffers never settled")
}

/// Which pixels of `frame` show a copy: not the sky's colour (its top left pixel's).
fn covered(frame: [u8]) -> Vec<bool> {
    var out: Vec<bool> = Vec::with_capacity(W * H)
    for p in 0..W * H {
        let i = 4 * p
        out.push(frame[i] != frame[0] || frame[i + 1] != frame[1] || frame[i + 2] != frame[2])
    }
    out
}

/// Every level's quads and listed quads fit their rooms, and the cut over the field of 64
/// copies takes at least three levels; its buffers, cooking's fitted to what it emitted and the
/// frames' with room for every quad, take under 400 MB.
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn a_cut_holds_every_quad_it_wants() {
    var o = Box::new(opened.start())
    var h: Option<drive::Build> = None
    while h.is_none() {
        match o.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(b) => h = Some(b),
        }
    }
    let Some(b) = h else { panic("opened") }
    var v = Box::new(view.start(b, 0.5, 8))
    var viewed = false
    while !viewed {
        match v.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => viewed = true,
        }
    }
    var l = Box::new(levels_listed.start(b))
    var levels = 0
    var listed = false
    while !listed {
        match l.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(n) => {
                levels = n
                listed = true
            },
        }
    }
    assert(levels >= 3, f"the cut took {levels} levels")
    var m = Box::new(settled_megabytes.start(b))
    var mb = 0
    var settled = false
    while !settled {
        match m.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(n) => {
                mb = n
                settled = true
            },
        }
    }
    print(f"the clusters take {mb} MB")
    assert(mb < 400, f"the clusters take {mb} MB")
}

/// Over 9 copies (the finest level drawn everywhere, 669,000 quads a copy, fits its room for 9,
/// not 64), a cut of at least three levels, against the finest level drawn everywhere (no error
/// allowed), shows the sky nowhere the finest level covers a pixel and all eight round it (a
/// crack), and every pixel the two cover differently is beside the finest level's silhouette
/// (within a pixel of it).
@test(tool, read: [("repo", "../../../..")], budget: 300)
@job
fn a_cut_opens_no_crack_and_keeps_its_silhouettes() {
    var o = Box::new(opened.start())
    var h: Option<drive::Build> = None
    while h.is_none() {
        match o.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(b) => h = Some(b),
        }
    }
    let Some(b) = h else { panic("opened") }
    var cut_frame: Vec<u8> = Vec::new()
    var v = Box::new(view.start(b, 0.5, 3))
    var viewed = false
    while !viewed {
        match v.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(f) => {
                cut_frame = take f
                viewed = true
            },
        }
    }
    var l = Box::new(levels_listed.start(b))
    var levels = 0
    var listed = false
    while !listed {
        match l.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(n) => {
                levels = n
                listed = true
            },
        }
    }
    assert(levels >= 3, f"the cut took {levels} levels")
    var finest_frame: Vec<u8> = Vec::new()
    var w = Box::new(view.start(b, 0.0, 3))
    var finest_viewed = false
    while !finest_viewed {
        match w.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(f) => {
                finest_frame = take f
                finest_viewed = true
            },
        }
    }
    let cut = covered(cut_frame)
    let finest = covered(finest_frame)
    var cracks = 0
    var far = 0
    var differ = 0
    for y in 1..H - 1 {
        for x in 1..W - 1 {
            let here = finest[y * W + x]
            var all_covered = true
            var all_alike = true
            for k in 0..9 {
                let f = finest[(y + k / 3 - 1) * W + x + k % 3 - 1]
                all_covered = all_covered && f
                all_alike = all_alike && f == here
            }
            if !cut[y * W + x] && all_covered {
                cracks += 1
            }
            if cut[y * W + x] != here {
                differ += 1
                // A pixel the two cover differently, with no pixel round it that the finest
                // level covers differently from it: off the finest level's silhouette.
                if all_alike {
                    far += 1
                }
            }
        }
    }
    var shown = 0
    for c in finest {
        if c {
            shown += 1
        }
    }
    print(
        f"{shown} pixels covered; {differ} covered differently, {far} away from a silhouette, {cracks} cracks",
    )
    assert(shown > W * H / 10, f"the copies cover too little to test: {shown} pixels")
    assert(cracks == 0, f"the cut opened {cracks} cracks")
    assert(far == 0, f"{far} pixels differ away from the finest level's silhouettes")
}

/// Chrome draws the moving eye's cut of the 64 copies as the native host does: frames within a
/// mean of 0.5/255 after 30 frames (Tint takes the clusters' shaders, and its atomics keep each
/// cluster's quads together as wgpu's do). Not the same state hash: cooking's buffers are fitted
/// once its counts are read back, at a frame each host chooses.
@test(tool, read: [("repo", "../../../..")], browser: true, budget: 300)
@job
fn the_browser_draws_the_native_hosts_clusters() {
    var j = Box::new(
        both_hosts.start(
            String::from("repo/examples/clusters"),
            String::from("clusters-browser"),
            W,
            H,
            frames: 30,
            testing: true,
        ),
    )
    var drawn: Option<Both> = None
    while drawn.is_none() {
        match j.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(b) => drawn = Some(take b),
        }
    }
    let Some(both) = take drawn else { panic("both hosts") }
    let (mean, most) = difference(both.chrome, both.native)
    print(f"Chrome against the native host: mean {mean}/255, max {most}/255")
    assert(mean <= 0.5, f"mean difference {mean}")
}
