// The virtual geometry spike (S1a of the rendering moonshots): spike 13's smooth creature
// (`compiler/tests/spike13`, its bark left off) cooked as clusters (`engine::virtual`) and
// drawn at the coarsest level whose error is at most `PIXELS` from where the eye is, block by
// block. The scene: a field of copies on a plane, the eye moving between them; a test sets its
// own eye and level of error (`view`).
use engine::virtual::{ClusterLook, Clusters, Placed, cook_creature}
use engine::creature::Creature
use engine::view::{Camera, first_camera}
use std::derive::Box3
use std::field::{Surface, ellipsoid, round_cone, sphere}
use std::io::Pending
use std::gpu::{
    DepthTexture, GpuBuffer, R32Uint, Texture, begin_pass_with_depth, begin_screen_pass,
    begin_screen_pass_with_depth, buffer, depth_texture, label, read, texture, write,
}

/// The error a cluster may show, in pixels.
pub const PIXELS: f32 = 0.5

/// Whether the copies are drawn through the visibility buffer (`engine::virtual`) and resolved,
/// or forward.
pub const VISIBILITY: bool = true

/// How small a cluster looks across (pixels) for the software rasterizer to draw it, when the
/// copies are drawn through the visibility buffer (0: the hardware draws every cluster).
pub const SMALL: f32 = 32.0

/// The copies along each side of the field.
pub const SIDE: u32 = 8

/// Copies placed far under the ground, never in view (the spike's measure of hidden copies).
pub const HIDDEN: u32 = 0

/// The finest level's cells (m) and the levels.
pub const CELL: f32 = 4mm
pub const LEVELS: u32 = 6

/// Spike 13's creature without its bark, at rest.
fn smooth_creature() -> Surface {
    let body = ellipsoid(vec3(0.62, 0.42, 0.42))
    let neck = round_cone(vec3(0.35, 0.15, 0.0), vec3(0.75, 0.62, 0.0), r_top: 0.16, r_bottom: 0.1)
    let head = sphere(radius: 0.2).translate(vec3(0.82, 0.72, 0.0))
    body.smooth_union(neck, k: 0.12).smooth_union(head, k: 0.08)
}

/// It as a creature of one part (channels it has none of: a number), in its box.
fn body() -> Creature<f32> {
    engine::realize::solid(smooth_creature().with(1.0), BOUNDS, name: "body")
}

/// The box that holds it.
pub const BOUNDS = Box3 { lo: vec3(-0.7, -0.5, -0.5), hi: vec3(1.1, 1.0, 0.5) }

pub struct State {
    clusters: Clusters,
    places: GpuBuffer<Placed>,
    depth: DepthTexture,
    /// Whether the copies are drawn through the visibility buffer (`VISIBILITY`, or a test's
    /// `shade_visibility`), into `ids`, and resolved; or forward.
    visibility: bool,
    ids: Texture<R32Uint>,
    /// How small a cluster looks for the software rasterizer to draw it (`SMALL`, or a test's
    /// `rasterize_small`).
    small: f32,
    /// The listed triangles' areas, counted (`Clusters::count_areas`), and a test's readback.
    bins: GpuBuffer<u32>,
    bins_asked: Option<Pending<u32>>,
    bins_got: Vec<u32>,
    /// A test's eye and where it looks, and its error in pixels; none: the moving eye.
    eye: Option<(vec3, vec3)>,
    pixels: f32,
    side: u32,
    /// A test's readback of the clusters' counts (`Clusters::counts`), and what's arrived.
    asked: Vec<Pending<u32>>,
    answered: Vec<u32>,
}

/// `side` × `side` copies on the plane, 3 m apart, each a little larger than the last.
fn placements(side: u32) -> GpuBuffer<Placed> {
    var out: Vec<Placed> = Vec::new()
    for i in 0..side * side {
        let (x, z) = (f32(i % side), f32(i / side))
        out.push(Placed { at: vec3(x * 3.0, 0.0, z * 3.0), scale: 1.0 + 0.05 * f32(i % 7) })
    }
    for i in 0..HIDDEN {
        out.push(Placed { at: vec3(f32(i % 100) * 3.0, -500.0, f32(i / 100) * 3.0), scale: 1.0 })
    }
    var b: GpuBuffer<Placed> = buffer(out.len())
    write(mut b, 0, out)
    b
}

pub fn init() -> State {
    let clusters = cook_creature(body(), CELL, LEVELS)
    State {
        clusters,
        places: placements(SIDE),
        depth: depth_texture(width: 1, height: 1),
        visibility: VISIBILITY,
        ids: texture::<R32Uint>(width: 1, height: 1),
        small: SMALL,
        bins: buffer(6),
        bins_asked: None,
        bins_got: Vec::new(),
        eye: None,
        pixels: PIXELS,
        side: SIDE,
        asked: Vec::new(),
        answered: Vec::new(),
    }
}

/// A test's view: the eye at (`ex`, `ey`, `ez`) looking at (`ax`, `ay`, `az`), `pixels` of
/// error, `side` × `side` copies.
@testing
pub fn view(
    s: mut State,
    ex: f32,
    ey: f32,
    ez: f32,
    ax: f32,
    ay: f32,
    az: f32,
    pixels: f32,
    side: u32,
) {
    s.eye = Some((vec3(ex, ey, ez), vec3(ax, ay, az)))
    s.pixels = pixels
    if side != s.side {
        s.places = placements(side)
        s.side = side
    }
}

/// Draws through the visibility buffer and its resolve (`on`), or forward.
@testing
pub fn shade_visibility(s: mut State, on: bool) {
    s.visibility = on
}

/// The software rasterizer draws clusters that look under `small` pixels across (0: none).
@testing
pub fn rasterize_small(s: mut State, small: f32) {
    s.small = small
}

/// Asks for the listed triangles' areas, counted this frame (`Clusters::count_areas`), which
/// `area` gives once they arrive.
@testing
pub fn ask_areas(s: mut State) {
    let cam = camera_at(s, 0.0, s.depth.width(), s.depth.height())
    s.clusters.count_areas(cam, s.places, mut s.bins)
    s.bins_asked = Some(read(s.bins.items()))
    s.bins_got = Vec::new()
}

/// Bin `i` of the areas asked for (`ask_areas`: under 1, 4, 16 and 64 px², the rest, then the
/// triangles), or `NOT_YET` before they've come.
@testing
pub fn area(s: mut State, i: u32) -> u32 {
    if s.bins_got.len() == 0 {
        match mut s.bins_asked {
            Some(p) => {
                if let Some(Ok(v)) = p.poll() {
                    s.bins_got = take v
                }
            },
            None => {},
        }
    }
    if s.bins_got.len() > i { s.bins_got[i] } else { NOT_YET }
}

/// A count not yet read back.
const NOT_YET: u32 = 0xffffffff

/// Asks for the clusters' counts (`Clusters::counts`), which `counts` gives once they arrive.
@testing
pub fn ask_counts(s: mut State) {
    s.asked = s.clusters.counts()
    s.answered = Vec::new()
    for _ in 0..s.asked.len() {
        s.answered.push(NOT_YET)
    }
}

/// How many of the counts asked for (`ask_counts`) there are, each beside its room
/// (`Clusters::rooms`: wanted, room, listed by either rasterizer, room, a level at a time); 0
/// until every answer has arrived.
@testing
pub fn counts(s: mut State) -> u32 {
    var waiting = false
    for i in 0..s.asked.len() {
        if s.answered[i] == NOT_YET {
            if let Some(Ok(v)) = s.asked[i].poll() {
                s.answered[i] = v[0]
            } else {
                waiting = true
            }
        }
    }
    if waiting { 0 } else { 4 * s.answered.len() / 3 }
}

/// Count `i` of those `counts` says there are.
@testing
pub fn count(s: State, i: u32) -> u32 {
    let (level, k) = (i / 4, i % 4)
    match k {
        0 => s.answered[3 * level],
        2 => s.answered[3 * level + 1] + s.answered[3 * level + 2],
        _ => s.clusters.rooms()[2 * level + k / 2],
    }
}

/// The clusters' bytes in megabytes (`Clusters::bytes`).
@testing
pub fn megabytes(s: State) -> u32 {
    u32(s.clusters.bytes() / 1000000)
}

fn camera_at(s: State, time: f32, width: u32, height: u32) -> Camera {
    let (eye, at) = match s.eye {
        Some(v) => v,
        None => {
            // Round the field's middle, a little outside it.
            let a = 0.2 * time
            let middle = 1.5 * f32(s.side - 1)
            let r = middle + 1.5
            (vec3(middle + r * sin(a), 1.4, middle + r * cos(a)), vec3(middle, 0.4, middle))
        },
    }
    first_camera(eye, at, 1.0, width, height)
}

/// The copies' colour and light.
const LOOK = ClusterLook {
    albedo: vec3(0.62, 0.5, 0.38),
    sun: vec3(0.5, 0.8, 0.3) / 0.9899495,
    sky: 0.25,
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if s.depth.width() != width || s.depth.height() != height {
        s.depth = depth_texture(width, height)
        s.ids = texture::<R32Uint>(width, height)
    }
    let cam = camera_at(s, time, width, height)
    label("clusters select")
    s.clusters.select(cam, s.places, s.pixels, small: if s.visibility { s.small } else { 0.0 })
    if s.visibility {
        // The small clusters in software, the visibility pass (the hardware's raster and the
        // merge), then the resolve (the shading), each timed.
        label("virtual software")
        s.clusters.raster_small(cam, s.places)
        label("virtual raster")
        let v = begin_pass_with_depth(mut s.ids, mut s.depth, clear: vec4(0.0), clear_depth: 0.0)
        s.clusters.draw_ids(v, cam, s.places)
        v.end()
        label("virtual resolve")
        let p = begin_screen_pass(clear: vec4(0.55, 0.68, 0.85, 1.0))
        s.clusters.resolve(p, cam, s.places, LOOK, s.ids, s.depth)
        p.present()
        return
    }
    label("clusters draw")
    let p = begin_screen_pass_with_depth(
        mut s.depth,
        clear: vec4(0.55, 0.68, 0.85, 1.0),
        clear_depth: 0.0,
    )
    s.clusters.draw(p, cam, s.places, LOOK)
    p.present()
}
