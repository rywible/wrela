// A page in test mode, run in Chrome to its end (language.md §15.5; runtime/browser's test mode):
// a build's directory served on a free port (`std::tool::serve`), opened in headless Chrome
// (`std::tool::browser`) with a test mode's hash, and waited on until it writes `results/DONE`
// (`ok`, or why it failed). The page's other results land in the directory's `results/`, which
// each run empties first; its console goes to `results/console.log`.

use std::io::print
use std::time::now
use std::tool::ToolError
use std::tool::browser
use std::tool::browser::{Browser, Script, Until}
use std::tool::files
use std::tool::serve
use whole::{chunked, write_file}

/// The longest one wait for the page's result is (a request's most), in seconds.
const SLICE: f64 = 600.0

/// Runs the page in `dir` (a root path in a write root) at `width` × `height`, with `hash` (as
/// `#test&frames=...`), until it writes `results/DONE` or `timeout` seconds pass: whether it
/// wrote `ok`, or why not. The console's last 20 lines are printed, as is how long it took.
pub fn run_page(
    dir: str,
    hash: str,
    width: u32,
    height: u32,
    timeout: f64,
) -> Result<(), ToolError> {
    let results = String::from(f"{dir}/results")
    // What an earlier run left, a stale DONE above all, isn't this run's.
    let _ = files::remove_all(results.as_str()).wait()
    let _ = files::make_dirs(results.as_str()).wait()?
    let started = serve::start(dir).wait()?
    let start = now()
    let b = browser::open(f"{started.origin}/{hash}", width, height, timeout: 120.0).wait()?
    let result = finished(b, start, timeout)
    let lines = match browser::console(b).wait() {
        Ok(l) => take l,
        Err(e) => Vec::from([String::from(f"(the console couldn't be read: {e.message()})")]),
    }
    var log = String::new()
    for l in lines {
        log.push_str(l.as_str())
        log.push_str("\n")
    }
    let _ = write_file(f"{results}/console.log", chunked(Vec::from(log.as_bytes())))
    let _ = browser::close(b).wait()
    let _ = serve::close(started.server).wait()
    print(f"elapsed {now() - start:.1}s; console: {results}/console.log")
    let from = if lines.len() > 20 { lines.len() - 20 } else { 0 }
    for k in from..lines.len() {
        print(f"  {lines[k]}")
    }
    result
}

/// Waits until `b`'s page has written `results/DONE`, or `timeout` seconds from `start` pass:
/// whether it wrote `ok`, or why not. A request waits at most `SLICE`, so a longer timeout is
/// waited in slices; a wait that fails before its slice ends fails for another reason.
fn finished(b: Browser, start: f64, timeout: f64) -> Result<(), ToolError> {
    loop {
        let left = timeout - (now() - start)
        if left <= 0.0 {
            return Err(ToolError::new(f"timed out after {timeout:.0}s"))
        }
        let slice = min(left, SLICE)
        let from = now()
        let script = Script::new().wait(Until::done(), timeout: slice)
        match browser::run(b, script, timeout: SLICE).wait() {
            Ok(_) => break,
            Err(e) => {
                if now() - from < slice {
                    return Err(take e)
                }
            },
        }
    }
    let Some(body) = browser::results(b).wait()? else {
        return Err(ToolError::new("the page's result isn't there"))
    }
    let text = body.as_str().trim()
    if text == "ok" { Ok(()) } else { Err(ToolError::new(f"page failed: {text}")) }
}
