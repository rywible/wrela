// A CMA-ES search (Hansen's tutorial's algorithm, 2016: arXiv 1604.00772) over coordinates in
// [0, 1], from a fixed seed: the studio's fitters share it (`studio/fit`'s looks, D8;
// `studio/grow`'s trees, E6; the creatures' gaits, F5).

use engine::noise::rand

/// A CMA-ES search (Hansen's (μ/μ_W, λ) with rank-one and rank-μ updates and cumulative step
/// size) over `n` coordinates in [0, 1]: a candidate outside is brought back to the nearest edge,
/// and updated from where it was brought.
pub struct Cma: Clone {
    pub n: u32,
    pub lambda: u32,
    pub mu: u32,
    pub weights: Vec<f32>,
    pub mueff: f32,
    pub cc: f32,
    pub cs: f32,
    pub c1: f32,
    pub cmu: f32,
    pub damps: f32,
    pub chi: f32,
    pub mean: Vec<f32>,
    pub sigma: f32,
    /// The covariance, row by row, its eigenvectors (`b`, column by column) and the square roots
    /// of its eigenvalues (`d`).
    pub c: Vec<f32>,
    pub b: Vec<f32>,
    pub d: Vec<f32>,
    pub pc: Vec<f32>,
    pub ps: Vec<f32>,
    pub generation: u32,
    pub seed: u32,
    /// The last candidates asked for, each its normal draw (`z`) and its point.
    pub zs: Vec<Vec<f32>>,
    pub xs: Vec<Vec<f32>>,
}

/// `x` reflected into [0, 1] at its ends (a draw past an end lands as far inside it): the
/// candidates a search scores and learns from are the same, and none piles on an end (clamped,
/// every draw past an end was the end, and the search's spread there collapsed onto it).
fn mirrored(x: f32) -> f32 {
    let t = abs(x) - 2.0 * floor(abs(x) * 0.5)
    if t > 1.0 { 2.0 - t } else { t }
}

/// A standard normal draw: the `k`th of `seed`'s (Box-Muller).
fn normal(seed: u32, k: u32) -> f32 {
    let u1 = max(f32(rand(seed, 2 * k)), 1.0e-9)
    let u2 = f32(rand(seed, 2 * k + 1))
    sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2)
}

impl Cma {
    /// A search from `start` (each in [0, 1]) with step `sigma`, its draws from `seed`, and
    /// `lambda` candidates a generation (0: Hansen's default, 4 + 3 ln n; more is steadier on a
    /// rugged landscape, and a multiple of the helpers wastes none of them).
    pub fn new(start: [f32], sigma: f32, seed: u32, lambda: u32 = 0) -> Cma {
        let n = start.len()
        let nf = f32(n)
        let lambda = if lambda > 0 { lambda } else { 4 + u32(floor(3.0 * log(nf))) }
        let mu = lambda / 2
        var weights: Vec<f32> = Vec::new()
        var total = 0.0
        for i in 0..mu {
            let w = log(f32(mu) + 0.5) - log(f32(i + 1))
            weights.push(w)
            total += w
        }
        var sq = 0.0
        for i in 0..mu {
            weights[i] = weights[i] / total
            sq += weights[i] * weights[i]
        }
        let mueff = 1.0 / sq
        let cc = (4.0 + mueff / nf) / (nf + 4.0 + 2.0 * mueff / nf)
        let cs = (mueff + 2.0) / (nf + mueff + 5.0)
        let c1 = 2.0 / ((nf + 1.3) * (nf + 1.3) + mueff)
        let cmu = min(
            1.0 - c1,
            2.0 * (mueff - 2.0 + 1.0 / mueff) / ((nf + 2.0) * (nf + 2.0) + mueff),
        )
        let damps = 1.0 + 2.0 * max(0.0, sqrt((mueff - 1.0) / (nf + 1.0)) - 1.0) + cs
        let chi = sqrt(nf) * (1.0 - 1.0 / (4.0 * nf) + 1.0 / (21.0 * nf * nf))
        var c: Vec<f32> = Vec::new()
        var b: Vec<f32> = Vec::new()
        for i in 0..n {
            for j in 0..n {
                c.push(if i == j { 1.0 } else { 0.0 })
                b.push(if i == j { 1.0 } else { 0.0 })
            }
        }
        var d: Vec<f32> = Vec::new()
        var pc: Vec<f32> = Vec::new()
        var ps: Vec<f32> = Vec::new()
        var mean: Vec<f32> = Vec::new()
        for i in 0..n {
            d.push(1.0)
            pc.push(0.0)
            ps.push(0.0)
            mean.push(start[i])
        }
        Cma {
            n,
            lambda,
            mu,
            weights,
            mueff,
            cc,
            cs,
            c1,
            cmu,
            damps,
            chi,
            mean,
            sigma,
            c,
            b,
            d,
            pc,
            ps,
            generation: 0,
            seed,
            zs: Vec::new(),
            xs: Vec::new(),
        }
    }

    /// This generation's `lambda` candidates, each in [0, 1].
    pub fn ask(mut self) -> Vec<Vec<f32>> {
        let n = self.n
        self.zs = Vec::new()
        self.xs = Vec::new()
        for k in 0..self.lambda {
            var z: Vec<f32> = Vec::new()
            for i in 0..n {
                z.push(normal(self.seed + self.generation * 7919, k * n + i))
            }
            var x: Vec<f32> = Vec::new()
            for i in 0..n {
                var s = 0.0
                for j in 0..n {
                    s += self.b[i * n + j] * self.d[j] * z[j]
                }
                x.push(mirrored(self.mean[i] + self.sigma * s))
            }
            self.zs.push(take z)
            self.xs.push(take x)
        }
        self.xs.clone()
    }

    /// The generation's scores, in `ask`'s order (lower is better): the mean, the paths, the
    /// covariance and the step updated.
    pub fn tell(mut self, scores: [f32]) {
        let n = self.n
        var order: Vec<u32> = Vec::new()
        for k in 0..self.lambda {
            order.push(k)
        }
        order.sort_by(|a: u32, b: u32| scores[a] < scores[b])
        let old = self.mean.clone()
        var mean: Vec<f32> = Vec::new()
        for i in 0..n {
            var m = 0.0
            for r in 0..self.mu {
                m += self.weights[r] * self.xs[order[r]][i]
            }
            mean.push(m)
        }
        // The step in the search's own coordinates: C^(-1/2) (mean - old) / sigma.
        var y: Vec<f32> = Vec::new()
        for i in 0..n {
            y.push((mean[i] - old[i]) / self.sigma)
        }
        var bty: Vec<f32> = Vec::new()
        for j in 0..n {
            var s = 0.0
            for i in 0..n {
                s += self.b[i * n + j] * y[i]
            }
            bty.push(s / max(self.d[j], 1.0e-12))
        }
        var len_ps = 0.0
        for i in 0..n {
            var s = 0.0
            for j in 0..n {
                s += self.b[i * n + j] * bty[j]
            }
            self.ps[i] = (1.0 - self.cs) * self.ps[i] +
                sqrt(self.cs * (2.0 - self.cs) * self.mueff) * s
            len_ps += self.ps[i] * self.ps[i]
        }
        len_ps = sqrt(len_ps)
        let g = f32(self.generation + 1)
        let hsig = if len_ps / sqrt(1.0 - pow(1.0 - self.cs, 2.0 * g)) / self.chi <
            1.4 + 2.0 / (f32(n) + 1.0) { 1.0 } else { 0.0 }
        for i in 0..n {
            self.pc[i] = (1.0 - self.cc) * self.pc[i] +
                hsig * sqrt(self.cc * (2.0 - self.cc) * self.mueff) * y[i]
        }
        for i in 0..n {
            for j in 0..n {
                var rank_mu = 0.0
                for r in 0..self.mu {
                    let x = self.xs[order[r]].clone()
                    rank_mu += self.weights[r] *
                        (x[i] - old[i]) *
                        (x[j] - old[j]) /
                        (self.sigma * self.sigma)
                }
                let k = i * n + j
                self.c[k] = (1.0 - self.c1 - self.cmu) * self.c[k] +
                    self.c1 *
                        (self.pc[i] * self.pc[j] +
                            (1.0 - hsig) * self.cc * (2.0 - self.cc) * self.c[k]) +
                    self.cmu * rank_mu
            }
        }
        self.sigma = self.sigma * exp((self.cs / self.damps) * (len_ps / self.chi - 1.0))
        self.sigma = min(self.sigma, 0.5)
        self.mean = take mean
        let (b, d) = eigen(self.c.clone(), n)
        self.b = take b
        self.d = take d
        self.generation += 1
    }
}

/// A symmetric `n` × `n` matrix's eigenvectors (column by column) and the square roots of its
/// eigenvalues (each at least 1e-10), by Jacobi's rotations.
pub fn eigen(m: [f32], n: u32) -> (Vec<f32>, Vec<f32>) {
    var a = Vec::from(m)
    var v: Vec<f32> = Vec::new()
    for i in 0..n {
        for j in 0..n {
            v.push(if i == j { 1.0 } else { 0.0 })
        }
    }
    for _sweep in 0..50 {
        var off = 0.0
        for i in 0..n {
            for j in 0..n {
                if i != j {
                    off += a[i * n + j] * a[i * n + j]
                }
            }
        }
        if off < 1.0e-14 {
            break
        }
        for p in 0..n {
            for q in (p + 1)..n {
                let apq = a[p * n + q]
                if abs(apq) < 1.0e-30 {
                    continue
                }
                let theta = (a[q * n + q] - a[p * n + p]) / (2.0 * apq)
                let t = (if theta >= 0.0 { 1.0 } else {
                    -1.0
                }) / (abs(theta) + sqrt(theta * theta + 1.0))
                let c = 1.0 / sqrt(t * t + 1.0)
                let s = t * c
                for k in 0..n {
                    let (akp, akq) = (a[k * n + p], a[k * n + q])
                    a[k * n + p] = c * akp - s * akq
                    a[k * n + q] = s * akp + c * akq
                }
                for k in 0..n {
                    let (apk, aqk) = (a[p * n + k], a[q * n + k])
                    a[p * n + k] = c * apk - s * aqk
                    a[q * n + k] = s * apk + c * aqk
                }
                for k in 0..n {
                    let (vkp, vkq) = (v[k * n + p], v[k * n + q])
                    v[k * n + p] = c * vkp - s * vkq
                    v[k * n + q] = s * vkp + c * vkq
                }
            }
        }
    }
    var d: Vec<f32> = Vec::new()
    for i in 0..n {
        d.push(sqrt(max(a[i * n + i], 1.0e-20)))
    }
    (v, d)
}
