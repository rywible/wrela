// Files and blobs moved whole (language.md §15.5): a request carries at most 512 KiB, so a larger
// file is read and written through a blob, a chunk at a time.

use std::tool::{Call, MOST_BYTES, ToolError}
use std::tool::blob
use std::tool::blob::{Blob, Data}
use std::tool::files
use std::tool::image

/// How many reads of a blob are asked at once.
const READS: u32 = 8

/// `b`'s bytes, in chunks of at most 512 KiB, read `READS` at a time.
pub fn read_blob(b: Blob) -> Result<Vec<Vec<u8>>, ToolError> {
    let size = blob::len(b).wait()?
    let chunks = u32((size + u64(MOST_BYTES) - 1) / u64(MOST_BYTES))
    var out: Vec<Vec<u8>> = Vec::with_capacity(chunks)
    var next: u32 = 0
    while next < chunks {
        let n = min(READS, chunks - next)
        var reads: Vec<Call<Vec<u8>>> = Vec::with_capacity(n)
        for k in 0..n {
            reads.push(blob::read(b, u64(next + k) * u64(MOST_BYTES), MOST_BYTES))
        }
        for _ in 0..n {
            out.push(reads.remove(0).wait()?)
        }
        next += n
    }
    Ok(out)
}

/// The bytes `data` holds, in the answer itself or in a blob, which is released after.
pub fn data_bytes(data: take Data) -> Result<Vec<Vec<u8>>, ToolError> {
    match take data {
        Data::Bytes(bytes) => Ok(Vec::from([take bytes])),
        Data::Blob(b) => {
            let read = read_blob(b)
            let _ = blob::release(b).wait()
            read
        },
    }
}

/// `chunks`, one after another, as one run of bytes.
pub fn joined(chunks: take Vec<Vec<u8>>) -> Vec<u8> {
    var parts = take chunks
    var size = 0
    for c in parts {
        size += c.len()
    }
    var out: Vec<u8> = Vec::with_capacity(size)
    for k in 0..parts.len() {
        out.append(mut parts[k])
    }
    out
}

/// The whole file at `path` (a root path), named `shown` in an error.
pub fn read_file(path: str, shown: str) -> Result<Vec<u8>, ToolError> {
    let b = files::read_blob(path)
        .wait()
        .map_err(|e| ToolError::new(f"can't read {shown}: {e.message()}"))?
    Ok(joined(data_bytes(Data::Blob(b))?))
}

/// A new blob of `parts`' bytes, one after another (each at most 512 KiB).
pub fn blob_of(parts: take Vec<Vec<u8>>) -> Result<Blob, ToolError> {
    let b = blob::new().wait()?
    for p in parts {
        if let Err(e) = blob::append(b, p).wait() {
            let _ = blob::release(b).wait()
            return Err(e)
        }
    }
    Ok(b)
}

/// `bytes` cut into chunks of at most 512 KiB.
pub fn chunked(bytes: take Vec<u8>) -> Vec<Vec<u8>> {
    if bytes.len() <= MOST_BYTES {
        return Vec::from([take bytes])
    }
    var out: Vec<Vec<u8>> = Vec::new()
    var at = 0
    while at < bytes.len() {
        let end = min(at + MOST_BYTES, bytes.len())
        var chunk: Vec<u8> = Vec::with_capacity(end - at)
        for i in at..end {
            chunk.push(bytes[i])
        }
        out.push(take chunk)
        at = end
    }
    out
}

/// Writes `parts`, one after another, as the whole file at `path` (a root path, in a write
/// root): at once, or through a blob if they're more than a request carries.
pub fn write_file(path: str, parts: take Vec<Vec<u8>>) -> Result<(), ToolError> {
    var parts = take parts
    var size = 0
    for p in parts {
        size += p.len()
    }
    if size <= MOST_BYTES {
        let _ = files::write(path, joined(take parts)).wait()?
        return Ok(())
    }
    // Each part as it is, if it fits a request (a blob's chunks do), else a chunk at a time.
    var fitted: Vec<Vec<u8>> = Vec::new()
    for k in 0..parts.len() {
        var cut = chunked(replace(mut parts[k], Vec::new()))
        for c in 0..cut.len() {
            fitted.push(replace(mut cut[c], Vec::new()))
        }
    }
    write_data(path, Data::Blob(blob_of(take fitted)?))
}

/// Writes `data` as the whole file at `path` (a root path, in a write root); a blob is released
/// after.
pub fn write_data(path: str, data: take Data) -> Result<(), ToolError> {
    match take data {
        Data::Bytes(bytes) => {
            let _ = files::write(path, bytes).wait()?
        },
        Data::Blob(b) => {
            let written = files::write_blob(path, b).wait()
            let _ = blob::release(b).wait()
            let _ = (take written)?
        },
    }
    Ok(())
}

/// Copies the file `from` to `to` (root paths, `to` in a write root), whole, through a blob.
pub fn copy_file(from: str, to: str) -> Result<(), ToolError> {
    let b = files::read_blob(from)
        .wait()
        .map_err(|e| ToolError::new(f"can't read {from}: {e.message()}"))?
    write_data(to, Data::Blob(b))
}

/// Encodes `img` as a PNG and writes it at `path` (a root path in a write root); the image's
/// pixels' blob, if it has one, is released after.
pub fn write_png(img: take image::Image, path: str) -> Result<(), ToolError> {
    let png = image::encode_png(img.clone(), timeout: 600.0).wait()
    if let Data::Blob(pixels) = img.rgba {
        let _ = blob::release(pixels).wait()
    }
    write_data(path, (take png)?)
}
