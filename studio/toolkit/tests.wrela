// The toolkit's tests: bytes cut into a request's chunks and joined again, and a job's result
// taken when it ends. Its requests are tested where the tools use them (studio/lookbook's
// tool test).

use std::job::Step
use std::tool::MOST_BYTES
use wait::done
use whole::{chunked, joined}

@test
fn bytes_cut_into_chunks_join_again() {
    var bytes: Vec<u8> = Vec::new()
    for i in 0..MOST_BYTES * 2 + 5 {
        bytes.push(u8(i % 253))
    }
    let parts = chunked(bytes.clone())
    assert(parts.len() == 3 && parts[0].len() == MOST_BYTES && parts[2].len() == 5)
    let whole = joined(take parts)
    assert(whole.len() == bytes.len() && whole[MOST_BYTES + 1] == bytes[MOST_BYTES + 1])
    assert(chunked(Vec::new()).len() == 1, "nothing is one empty chunk")
}

@test
fn a_jobs_result_is_taken_when_it_ends() {
    let running: Step<u32> = Step::Yielded
    assert(done(take running).is_none())
    assert(done(Step::Done(7)) == Some(7))
}
