// The toolkit's tests: bytes cut into a request's chunks and joined again, and a size read from
// a command line. Its requests are tested where the tools use them (studio/lookbook's tool
// test).

use std::tool::MOST_BYTES
use command::size_of
use whole::{chunked, joined}

@test
fn bytes_cut_into_chunks_join_again() {
    var bytes: Vec<u8> = Vec::new()
    for i in 0..MOST_BYTES * 2 + 5 {
        bytes.push(u8(i % 253))
    }
    let parts = chunked(bytes.clone())
    assert(parts.len() == 3 && parts[0].len() == MOST_BYTES && parts[2].len() == 5)
    let whole = joined(take parts)
    assert(whole.len() == bytes.len() && whole[MOST_BYTES + 1] == bytes[MOST_BYTES + 1])
    assert(chunked(Vec::new()).len() == 1, "nothing is one empty chunk")
}

@test
fn a_size_is_a_width_and_a_height_of_at_least_one() {
    assert(size_of("64x48") == Some((64, 48)) && size_of("1x1") == Some((1, 1)))
    for bad in ["0x5", "5x0", "12", "x", "64x", "x48", "-1x5", "64x48x2"] {
        assert(size_of(bad).is_none(), bad)
    }
}
