// The deploy tool (`wrela tool deploy`): deploys a release that `wrela tool release` built to
// Cloudflare Workers, keeping what live clients use.
//
// ```text
// wrela tool deploy -- [--require-main-head] [--dry-run]
// ```
//
// The release is the root `release` (build/release). A client keeps the console it loaded, and
// the console pins each game's release: a deploy must keep serving every release a client may
// still hold. The console serves `deploys.json`, the history of deploys. A release is kept while
// it's live and for `KEEP` after it stops being live (policy.wrela).
//
// **Where kept releases are.** Each Worker serves static assets alone, so Cloudflare runs no
// script, and bills nothing, for any request of theirs (release_tool::site::wrangler_config).
// Its assets are the new release and each release it keeps, beside it under `releases/<id>/`,
// and the union of the shared files they name, each once: the payloads under `b/` and the
// runtimes under `r/` (release_tool::addresses), which a release's `files.json` lists by their
// root-absolute paths. So a deploy fetches each kept release from the live site before any
// Worker changes: its listing (`files.json`), as its Worker serves it, and each file it lists
// that the Worker's directory doesn't have yet, once, checked against its SHA-256. A file that
// doesn't arrive, or doesn't match, stops the deploy before anything changes, and so does a
// Worker over the file limits. A kept release the docs Worker answers 404 for never went live
// there, and no reader holds it: the docs keep the rest. The console's server is a Worker of its
// own (`release.json`'s `api`), on the console's API paths.
//
// With `--require-main-head`, a deploy whose commit is no longer the head of `main` (as GitHub's
// git service advertises it, as `git ls-remote` reads it) stops before it changes anything.
//
// Wrangler deploys each Worker (`npx --yes wrangler@<WRANGLER>`, granted as `npx`), with the
// secrets `CLOUDFLARE_API_TOKEN` and `CLOUDFLARE_ACCOUNT_ID` given to it alone. First the
// release's server's verifier goes into the bucket of builds (`keep_verifier`), so a later build
// can play this board's runs; then the console's server deploys, since the games and the console
// that call it are the release's; then the
// games, and then the console, so a console never offers a game release its Worker doesn't serve
// yet; the docs, which no other Worker depends on, go last, so a failure there leaves the console
// and games up to date. Each Worker must serve the new release, byte for byte, and each kept
// release's listing, the console must list the new release as the one live release, and the
// console's API paths must reach its server, before the deploy passes. Then each WASM and runtime
// script of the console and the games must come back as Zstandard (`ZSTD_RULE`). The log says what each Worker keeps, what Wrangler said of each Worker and
// that each serves its releases.
//
// `--dry-run` does all but run Wrangler: it fetches the kept releases into the release and writes
// `deploys.json`. The grants are the workspace's (`[tools.deploy]`), so the secrets must be set,
// if only to empty values, for a dry run too.

use policy::{
    CLOUDFLARE, Deploy, Found, Limits, Release, Worker, compressed, deploy_order, history_json,
    home, insert, kept, main_head, next_history, not_zstd, placed, quoted, read_history,
    read_listing, read_release, redirected, uploads,
}
use release_tool::io::{copy_files, data_bytes, read_files, write_files}
use release_tool::tree::hex_sha
use std::io::print
use std::tool::{Call, Done, ToolError, any, args, secret}
use std::tool::files
use std::tool::files::Kind
use std::tool::http
use std::tool::Request
use std::tool::http::Header
use std::tool::run
use std::tool::time

/// The root the release is in: `wrela tool release`'s output.
pub const RELEASE: Text = "release"

/// The repository whose `main` deploys.
pub const REPOSITORY: Text = "https://github.com/rywible/wrela"

/// The Wrangler that deploys, pinned, as `npx` runs it.
pub const WRANGLER: Text = "wrangler@4.151.0"

/// The secrets Wrangler gets, when they're granted.
pub const SECRETS: [Text; 2] = ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]

/// How many files of a kept release are fetched at once.
pub const AT_ONCE: u32 = 16

/// Where a dry run or a deploy keeps what it fetched of the kept releases, in the release's root
/// and outside each Worker's directory: each file by its SHA-256.
pub const STAGE: Text = "stored"

/// How long a request to a live site, and a run of Wrangler, may take, in seconds.
pub const FETCH_TIMEOUT: f64 = 60.0
pub const RUN_TIMEOUT: f64 = 600.0

/// The seconds a kept release's file waits before each retry of a `GET` that failed in transport
/// or that its origin answered 500, 502, 503 or 504: so it's tried at most 5 times.
pub const BACKOFF: [f64; 4] = [1.0, 2.0, 4.0, 8.0]

/// A path of the console's API that its server answers a `GET` at with 405, since only a `POST`
/// changes things there (console/server/serve.wrela), as the console's assets never answer a
/// `GET`: they answer 404. A `GET`, not a `POST` from no origin, which the zone's firewall refuses
/// before any Worker runs.
pub const API_PROBE: Text = "/api/accounts"

/// Whether Ryan has set the zone's Compression Rule (Zstandard, then Brotli, then Gzip:
/// docs/toolchain.md, "Delivery"). Once it's set, a WASM or runtime script of the console or a game
/// that doesn't come back with `content-encoding: zstd` fails the deploy; until then the log
/// warns of each.
pub const ZSTD_RULE: bool = true

/// What the Zstandard check asks for, as a browser that takes both does.
pub const ACCEPT_ENCODING: Text = "zstd, br"

/// How many times a Worker is asked whether it serves the new release, and the seconds between.
pub const TRIES: u32 = 12
pub const BETWEEN_TRIES: f64 = 5.0

pub const USAGE: Text = "usage: wrela tool deploy -- [--require-main-head] [--dry-run]"

/// What a deploy does: the root its release is in, whether it stops unless its commit is the
/// head of `main`, whether it stops before Wrangler runs, the Workers' limits, the repository
/// whose `main` it checks, and whether a file that doesn't come back as Zstandard fails it
/// (`ZSTD_RULE`).
pub struct Options: Clone {
    pub root: String,
    pub require_main_head: bool,
    pub dry_run: bool,
    pub limits: Limits,
    pub repository: String,
    pub zstd: bool,
}

/// The options the command line gives, or `None` for a usage error.
pub fn parse_args(given: [String]) -> Option<Options> {
    var o = Options {
        root: String::from(RELEASE),
        require_main_head: false,
        dry_run: false,
        limits: CLOUDFLARE,
        repository: String::from(REPOSITORY),
        zstd: ZSTD_RULE,
    }
    for a in given {
        if a.as_str() == "--require-main-head" && !o.require_main_head {
            o.require_main_head = true
        } else if a.as_str() == "--dry-run" && !o.dry_run {
            o.dry_run = true
        } else {
            return None
        }
    }
    Some(o)
}

pub fn tool() -> u32 {
    let Some(o) = parse_args(args()) else {
        print(USAGE)
        return 2
    }
    match deploy(o) {
        Ok(_) => 0,
        Err(e) => {
            print(f"deploy: {e.message()}")
            1
        },
    }
}

// ---- Requests ----------------------------------------------------------------------------------

/// What a live site answered: its status and its body.
pub struct Got: Clone {
    pub status: u16,
    pub body: Vec<u8>,
}

/// Why a `GET` failed, and whether it failed in transport (`http::is_transport`): no response
/// came, so a retry may mend it.
pub struct Failure: Clone {
    pub why: String,
    pub transport: bool,
}

fn failure(why: str) -> Failure {
    Failure { why: String::from(why), transport: false }
}

/// A `GET` of `url` as the deploy asks it of a live site.
fn request(url: str) -> http::Request {
    var req = http::get(url)
    req.headers.push(
        Header { name: String::from("User-Agent"), value: String::from("wrela-deploy") },
    )
    req.timeout = FETCH_TIMEOUT
    req
}

/// The most `GET`s of one try: the first and at most 5 redirects.
const HOPS: u32 = 6

/// What a `GET`'s answer leads to: a redirect to follow on its origin, or its result.
enum Answered {
    Redirect(String),
    Result(Result<Got, Failure>),
}

/// The answer `r` to a `GET` of `url`. A request that fails is a `Failure`; a status isn't.
fn answered(url: str, r: take Result<http::Response, ToolError>) -> Answered {
    let response = match take r {
        Ok(r) => take r,
        Err(e) => {
            return Answered::Result(
                Err(
                    Failure {
                        why: String::from(f"GET {url}: {e.message()}"),
                        transport: http::is_transport(e),
                    },
                ),
            )
        },
    }
    let status = response.status
    if status == 301 || status == 302 || status == 303 || status == 307 || status == 308 {
        let Some(location) = response.header("location") else {
            return Answered::Result(Err(failure(f"GET {url}: a redirect with no location")))
        }
        return match redirected(url, location.as_str()) {
            Some(next) => Answered::Redirect(take next),
            None => Answered::Result(
                Err(failure(f"GET {url}: a redirect off its origin, to {location.as_str()}")),
            ),
        }
    }
    match data_bytes(response.body.clone()) {
        Ok(body) => Answered::Result(Ok(Got { status, body })),
        Err(e) => Answered::Result(Err(failure(f"GET {url}: {e.message()}"))),
    }
}

/// A `GET` of `url`, following a redirect that stays on its origin (at most 5), as a Worker's
/// assets redirect `/x/index.html` to `/x/`. A request that fails is an error; a status isn't.
pub fn get_once(first: str) -> Result<Got, Failure> {
    var url = String::from(first)
    for _ in 0..HOPS {
        match answered(url.as_str(), http::fetch(request(url.as_str())).wait()) {
            Answered::Redirect(next) => url = take next,
            Answered::Result(r) => return take r,
        }
    }
    Err(failure(f"GET {url.as_str()}: too many redirects"))
}

/// `get_once`, its failure said as a `ToolError`.
pub fn get(url: str) -> Result<Got, ToolError> {
    get_once(url).map_err(|f| ToolError::new(f.why.as_str()))
}

/// Whether a `GET`'s result may mend if it's tried again: it failed in transport (no response
/// came), or the origin answered 500, 502, 503 or 504. A definite answer (200, a 404, ...) isn't.
pub fn transient(r: Result<Got, Failure>) -> bool {
    match r {
        Ok(g) => g.status == 500 || g.status == 502 || g.status == 503 || g.status == 504,
        Err(f) => f.transport,
    }
}

/// One file of a batch (`get_all`): the URL asked for, the URL its try has reached (after its
/// redirects) and how many `GET`s that try has made, how many tries ended, what it waits on (a
/// `GET`'s answer or the backoff before its next try), and its result once it has one.
struct Fetching {
    first: String,
    url: String,
    hops: u32,
    tries: u32,
    fetch: Option<Call<http::Response>>,
    backoff: Option<Call<Done>>,
    result: Option<Result<Got, ToolError>>,
}

impl Fetching {
    fn new(url: str) -> Fetching {
        Fetching {
            first: String::from(url),
            url: String::from(url),
            hops: 1,
            tries: 0,
            fetch: Some(http::fetch(request(url))),
            backoff: None,
            result: None,
        }
    }

    /// What it waits on, if it waits.
    fn waits_on(self) -> Option<Request> {
        match self.fetch {
            Some(c) => Some(c.request()),
            None => match self.backoff {
                Some(t) => Some(t.request()),
                None => None,
            },
        }
    }

    /// Goes on from what it waited on, which has answered: a redirect followed, a try ended
    /// (retried after its backoff while its result is `transient`, as at most `BACKOFF` says),
    /// or the next try begun.
    fn advance(mut self) {
        if let Some(t) = replace(mut self.backoff, None) {
            // The backoff ends however the timer answers.
            let _ = (take t).wait()
            self.url = self.first.clone()
            self.hops = 1
            self.fetch = Some(http::fetch(request(self.first.as_str())))
            return
        }
        let Some(c) = replace(mut self.fetch, None) else { return }
        let r = match answered(self.url.as_str(), (take c).wait()) {
            Answered::Result(r) => take r,
            Answered::Redirect(next) => {
                self.url = take next
                if self.hops < HOPS {
                    self.hops += 1
                    self.fetch = Some(http::fetch(request(self.url.as_str())))
                    return
                }
                Err(failure(f"GET {self.url.as_str()}: too many redirects"))
            },
        }
        self.tries += 1
        let tries = self.tries
        if !transient(r) {
            self.result = Some((take r).map_err(|f| ToolError::new(f.why.as_str())))
        } else if tries > BACKOFF.len() {
            self.result = Some(
                match take r {
                    Ok(g) => Err(
                        ToolError::new(
                            f"GET {self.first.as_str()}: HTTP {g.status}, {tries} tries",
                        ),
                    ),
                    Err(f) => Err(ToolError::new(f"{f.why.as_str()} ({tries} tries)")),
                },
            )
        } else {
            self.backoff = Some(time::after(BACKOFF[tries - 1]))
        }
    }
}

/// Each `GET` of `urls`, at once, each tried again after each `BACKOFF` while its result is
/// `transient`: every file's request and every backoff is outstanding at once, on this thread,
/// so the batch's retries wait together, whatever the helpers. Each result in `urls`' order; a
/// result still transient after its last try says how many tries it took.
pub fn get_all(urls: [String]) -> Vec<Result<Got, ToolError>> {
    var batch: Vec<Fetching> = Vec::with_capacity(urls.len())
    for u in urls {
        batch.push(Fetching::new(u.as_str()))
    }
    loop {
        var requests: Vec<Request> = Vec::new()
        var whose: Vec<u32> = Vec::new()
        for k in 0..batch.len() {
            if let Some(r) = batch[k].waits_on() {
                requests.push(r)
                whose.push(k)
            }
        }
        if requests.is_empty() {
            break
        }
        batch[whose[any(requests)]].advance()
    }
    var out: Vec<Result<Got, ToolError>> = Vec::with_capacity(batch.len())
    for k in 0..batch.len() {
        match replace(mut batch[k].result, None) {
            Some(r) => out.push(take r),
            None => panic("a batch's file ended with no result"),
        }
    }
    out
}

/// The body at `url`, which must answer 200.
pub fn fetch_ok(url: str) -> Result<Vec<u8>, ToolError> {
    let got = get(url)?
    if got.status != 200 {
        return Err(ToolError::new(f"GET {url}: HTTP {got.status}"))
    }
    Ok(got.body.clone())
}

/// The deploys the console at `domain` lists, oldest first.
pub fn history(domain: str) -> Result<Vec<Deploy>, ToolError> {
    let body = fetch_ok(f"https://{domain}/deploys.json")?
    let Some(text) = String::from_utf8(take body) else {
        return Err(ToolError::new(f"{domain}'s deploys.json isn't UTF-8"))
    }
    read_history(text.as_str()).map_err(own)
}

/// A failure of the deploy's own, said as `why`.
fn own(why: take String) -> ToolError {
    ToolError::new(why.as_str())
}

/// The whole of the file at `path`, a root path.
pub fn read_one(path: str) -> Result<Vec<u8>, ToolError> {
    var all = read_files(Vec::from([String::from(path)]))?
    Ok(replace(mut all[0], Vec::new()))
}

/// Every entry under the directory `dir` (a root path), each by its path there, with its kind
/// and size: a link is listed, not followed.
pub fn found(dir: str) -> Result<Vec<Found>, ToolError> {
    var out: Vec<Found> = Vec::new()
    var todo: Vec<String> = Vec::from([String::new()])
    while !todo.is_empty() {
        let rel = todo.drain_front(1)[0].clone()
        let path = if rel.is_empty() { String::from(dir) } else {
            String::from(f"{dir}/{rel.as_str()}")
        }
        let entries = files::list(path.as_str())
            .wait()
            .map_err(|e| ToolError::new(f"{path.as_str()}: {e.message()}"))?
        for e in entries {
            let at = if rel.is_empty() { e.name.clone() } else {
                String::from(f"{rel.as_str()}/{e.name.as_str()}")
            }
            if e.kind == Kind::Dir {
                todo.push(take at)
            } else {
                out.push(Found { path: at, kind: e.kind, size: e.size })
            }
        }
    }
    Ok(out)
}

// ---- Kept releases -----------------------------------------------------------------------------

/// A kept release's listing on one of its Workers: the Worker, the release, its files (each its
/// path and SHA-256, by path) and its `files.json` as the Worker served it.
pub struct Listing: Clone {
    pub worker: Worker,
    pub release: String,
    pub files: Vec<(String, String)>,
    pub body: Vec<u8>,
}

/// Whether `names` has `name`.
fn named(names: [String], name: str) -> bool {
    for n in names {
        if n.as_str() == name {
            return true
        }
    }
    false
}

/// The listing of `release` that `w` serves, or `None` if `w` is the docs and they never served
/// it (404).
pub fn served_listing(release: str, w: Worker) -> Result<Option<Listing>, ToolError> {
    let url = String::from(f"https://{w.domain.as_str()}/releases/{release}/files.json")
    let g = get(url.as_str())?
    if g.status == 404 && w.docs {
        print(f"{w.worker.as_str()} never served {release}")
        return Ok(None)
    }
    if g.status != 200 {
        return Err(ToolError::new(f"GET {url.as_str()}: HTTP {g.status}"))
    }
    let Some(text) = String::from_utf8(g.body.clone()) else {
        return Err(ToolError::new(f"{release}: its files.json isn't UTF-8"))
    }
    let files = read_listing(release, text.as_str()).map_err(own)?
    Ok(
        Some(
            Listing {
                worker: w.clone(),
                release: String::from(release),
                files,
                body: g.body.clone(),
            },
        ),
    )
}

/// Fetches each of `wanted` (a file's URL on the live site, and its SHA-256) into `STAGE` in
/// `root`, by its SHA-256, each checked against it: `AT_ONCE` at a time, each retried while it's
/// transient (`get_all`).
pub fn fetch_files(wanted: [(String, String)], root: str) -> Result<(), ToolError> {
    var at = 0
    while at < wanted.len() {
        let n = min(AT_ONCE, wanted.len() - at)
        var urls: Vec<String> = Vec::new()
        for k in 0..n {
            urls.push(wanted[at + k].0.clone())
        }
        var got = get_all(urls)
        var items: Vec<(String, Vec<u8>)> = Vec::new()
        for k in 0..n {
            let g = got.remove(0)?
            if g.status != 200 {
                return Err(ToolError::new(f"GET {urls[k].as_str()}: HTTP {g.status}"))
            }
            let sha = wanted[at + k].1.as_str()
            if hex_sha(g.body).as_str() != sha {
                return Err(ToolError::new(f"{urls[k].as_str()} doesn't match its SHA-256"))
            }
            items.push((String::from(f"{root}/{STAGE}/{sha}"), g.body.clone()))
        }
        write_files(take items)?
        at += n
    }
    Ok(())
}

/// The files of the new release `rel`, read from `root` before anything changes: each a SHA-256
/// and the root path of a file that has it (in its release, or a shared one at its Worker's
/// root: `placed`), sorted by SHA-256. A Worker whose listing is missing or isn't one stops the
/// deploy.
pub fn new_files(rel: Release, root: str) -> Result<Vec<(String, String)>, ToolError> {
    var out: Vec<(String, String)> = Vec::new()
    let r = rel.release.as_str()
    for w in rel.workers {
        let dir = String::from(f"{root}/{w.worker.as_str()}")
        let listing = String::from(f"{dir.as_str()}/releases/{r}/files.json")
        let Some(text) = String::from_utf8(read_one(listing.as_str())?) else {
            return Err(ToolError::new(f"{listing.as_str()} isn't UTF-8"))
        }
        for (path, sha) in read_listing(r, text.as_str()).map_err(own)? {
            out.push(
                (sha.clone(), String::from(f"{dir.as_str()}/{placed(r, path.as_str()).as_str()}")),
            )
        }
    }
    out.sort_by(|a: (String, String), b: (String, String)| a.0 < b.0)
    Ok(out)
}

/// The root path of a file of `files` (sorted by SHA-256, `new_files`) that has `sha`, if one has.
fn file_with(files: [(String, String)], sha: str) -> Option<String> {
    var lo: u32 = 0
    var hi = files.len()
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if files[mid].0.as_str() < sha {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < files.len() && files[lo].0.as_str() == sha {
        return Some(files[lo].1.clone())
    }
    None
}

/// Each release that a deploy of `rel` at `at`, after `deploys`, keeps, put beside the new one in
/// the directory of each of its Workers in `root`: its listing as the Worker serves it, and each
/// file that lists (its own in its release, a shared one at the root, once a Worker: `placed`),
/// copied from the new release (`local`, `new_files`) if it has it, else fetched from the live
/// site into `STAGE`, each once, all at once (`fetch_files`) and each checked against its
/// SHA-256. A shared file the new release has is in the Worker's directory already. The listing
/// of each kept release on each of its Workers.
pub fn keep(
    rel: Release,
    deploys: [Deploy],
    at: i64,
    local: [(String, String)],
    root: str,
) -> Result<Vec<Listing>, ToolError> {
    // The files to fetch so far: a sorted set of SHA-256s.
    var fetching: Vec<String> = Vec::new()
    var fetches: Vec<(String, String)> = Vec::new()
    var copies: Vec<(String, String)> = Vec::new()
    var writes: Vec<(String, Vec<u8>)> = Vec::new()
    var listed: Vec<Listing> = Vec::new()
    // The shared files each Worker's directory has: a sorted set of root paths, the new
    // release's first, so none is copied onto itself.
    var there: Vec<String> = Vec::new()
    for (_, path) in local {
        for w in rel.workers {
            for store in ["b", "r"] {
                if path.as_str().starts_with(f"{root}/{w.worker.as_str()}/{store}/") {
                    let _ = insert(mut there, path.as_str())
                }
            }
        }
    }
    for d in kept(deploys, at, rel.release.as_str()) {
        for w in rel.workers {
            // A Worker the kept release didn't have (a game added since) keeps nothing.
            if !named(d.workers, w.worker.as_str()) {
                continue
            }
            let Some(l) = served_listing(d.release.as_str(), w)? else { continue }
            let worker_dir = String::from(f"{root}/{w.worker.as_str()}")
            let dir = String::from(f"{worker_dir.as_str()}/releases/{d.release.as_str()}")
            var fetched = 0
            var shared = 0
            for (path, sha) in l.files {
                let to = String::from(
                    f"{worker_dir.as_str()}/{placed(d.release.as_str(), path.as_str()).as_str()}",
                )
                if path.as_str().starts_with("/") {
                    shared += 1
                    if !insert(mut there, to.as_str()) {
                        continue
                    }
                }
                let from = match file_with(local, sha.as_str()) {
                    Some(f) => take f,
                    None => {
                        if insert(mut fetching, sha.as_str()) {
                            fetches.push(
                                (
                                    String::from(
                                        f"https://{w.domain.as_str()}/{quoted(placed(d.release.as_str(), path.as_str()).as_str()).as_str()}",
                                    ),
                                    sha.clone(),
                                ),
                            )
                            fetched += 1
                        }
                        String::from(f"{root}/{STAGE}/{sha.as_str()}")
                    },
                }
                copies.push((take from, take to))
            }
            writes.push((String::from(f"{dir.as_str()}/files.json"), l.body.clone()))
            print(
                f"{w.worker.as_str()} keeps {d.release.as_str()}: {l.files.len()} files ({shared} shared), {fetched} to fetch from {w.domain.as_str()}",
            )
            listed.push(take l)
        }
    }
    fetch_files(fetches, root)?
    copy_files(copies)?
    write_files(take writes)?
    Ok(listed)
}

// ---- Wrangler ----------------------------------------------------------------------------------

/// Wrangler with `args`, run in `root`, with the secrets that are granted.
pub fn wrangler(args: [String], root: str) -> run::Command {
    var c = run::command("npx", root)
    c.args = Vec::from([String::from("--yes"), String::from(WRANGLER)])
    for a in args {
        c.args.push(a.clone())
    }
    for name in SECRETS {
        if secret(name).is_some() {
            c.secrets.push(String::from(name))
        }
    }
    c.timeout = RUN_TIMEOUT
    c
}

/// What a run of Wrangler printed: its standard output, then its standard error, each trimmed.
fn said(ran: run::Ran) -> Result<String, ToolError> {
    var out = String::new()
    for stream in 0..2 {
        let data = if stream == 0 { ran.stdout.clone() } else { ran.stderr.clone() }
        match String::from_utf8(data_bytes(take data)?) {
            Some(t) => {
                let s = t.trim()
                if !s.is_empty() {
                    if !out.is_empty() {
                        out.push_str("\n")
                    }
                    out.push_str(s)
                }
            },
            None => out.push_str("(wrangler's output isn't UTF-8)"),
        }
    }
    Ok(out)
}

/// Runs Wrangler with `args` in `root` (`what`, as its errors name it): its exit status and what
/// it said.
fn wrangler_ran(args: [String], root: str, what: str) -> Result<(i32, String), ToolError> {
    let ran = run::run(wrangler(args, root))
        .wait()
        .map_err(|e| ToolError::new(f"{what}: {e.message()}"))?
    let out = said(ran)?
    Ok((ran.status, out))
}

/// Runs Wrangler with `args` in `root` (`what`, as its errors name it): what it said, or, if it
/// failed, an error once what it said is printed.
fn run_wrangler(args: [String], root: str, what: str) -> Result<String, ToolError> {
    let (status, out) = wrangler_ran(args, root, what)?
    if status != 0 {
        if !out.is_empty() {
            print(out.as_str())
        }
        return Err(ToolError::new(f"{what} exited {status}"))
    }
    Ok(out)
}

/// Deploys the Worker that `<worker>.wrangler.json` in `root` configures, saying what Wrangler
/// said.
pub fn deploy_worker(worker: str, root: str) -> Result<(), ToolError> {
    let args = Vec::from(
        [String::from("deploy"), String::from("--config"), String::from(f"{worker}.wrangler.json")],
    )
    print(f"{worker}: wrangler deploy")
    let out = run_wrangler(args, root, f"wrangler deploy of {worker}")?
    if !out.is_empty() {
        print(out.as_str())
    }
    Ok(())
}

/// Puts the release's server's verifier in the bucket of builds (release_tool::site's
/// `BUILDS_BUCKET`), at its path, a file at a time, before any Worker deploys: a later build plays
/// this board's runs with it (toolchain 0.18.0's `call_build`). Its path names its files' bytes, so
/// one whose `verifier.json` is there already (each release of the same build's) is that one, and
/// isn't put again.
pub fn keep_verifier(rel: Release, root: str) -> Result<(), ToolError> {
    let bucket = release_tool::site::BUILDS_BUCKET
    let at = String::from(f"{bucket}/{rel.verifier.path.as_str()}")
    print(f"the server's verifier: {at.as_str()}")
    let described = String::from(f"{at.as_str()}/{release_tool::site::VERIFIER_JSON}")
    let probe = Vec::from(
        [
            String::from("r2"),
            String::from("object"),
            String::from("get"),
            described.clone(),
            String::from("--pipe"),
            String::from("--remote"),
        ],
    )
    // Any failure (none there, or Wrangler's own) puts it, which says what went wrong.
    let (status, _) = wrangler_ran(probe, root, f"wrangler r2 object get {described.as_str()}")?
    if status == 0 {
        print("  kept already")
        return Ok(())
    }
    for f in rel.verifier.files {
        let key = String::from(f"{at.as_str()}/{f.as_str()}")
        let file = String::from(f"{rel.api.as_str()}.server/verifier/{f.as_str()}")
        let args = Vec::from(
            [
                String::from("r2"),
                String::from("object"),
                String::from("put"),
                key.clone(),
                String::from("--file"),
                take file,
                String::from("--remote"),
            ],
        )
        let _ = run_wrangler(args, root, f"wrangler r2 object put {key.as_str()}")?
    }
    Ok(())
}

// ---- The deploy --------------------------------------------------------------------------------

/// The seconds since 1970, now.
pub fn now() -> Result<i64, ToolError> {
    let t = time::utc_now().wait()?
    Ok(i64(t.seconds))
}

/// The deploy `o` says: the history it leaves.
pub fn deploy(o: Options) -> Result<Vec<Deploy>, ToolError> {
    let root = o.root.as_str()
    let Some(text) = String::from_utf8(read_one(f"{root}/release.json")?) else {
        return Err(ToolError::new("release.json isn't UTF-8"))
    }
    let rel = read_release(text.as_str()).map_err(own)?
    let console = home(rel)
    let at = now()?
    let deploys = history(console.domain.as_str())?
    print(f"deploying release {rel.release.as_str()} of {rel.source.as_str()}")
    let local = new_files(rel, root)?
    let listings = keep(rel, deploys, at, local, root)?
    print(f"the Workers keep {listings.len()} listings of the releases a client may still hold")
    var names: Vec<String> = Vec::new()
    for w in rel.workers {
        names.push(w.worker.clone())
    }
    let after = next_history(deploys, rel.release.as_str(), rel.source.as_str(), names, at)
    let path = String::from(f"{root}/{console.worker.as_str()}/deploys.json")
    write_files(Vec::from([(take path, Vec::from(history_json(after).as_bytes()))]))?
    for w in rel.workers {
        let listed = found(f"{root}/{w.worker.as_str()}")?
        let n = uploads(listed, o.limits).map_err(own)?
        print(f"{w.worker.as_str()} ({w.domain.as_str()}): {n} files")
    }
    if o.require_main_head {
        let url = String::from(f"{o.repository.as_str()}.git/info/refs?service=git-upload-pack")
        let refs = fetch_ok(url.as_str())?
        let Some(head) = main_head(refs) else {
            return Err(ToolError::new(f"{url.as_str()} names no head of main"))
        }
        if head.as_str() != rel.source.as_str() {
            return Err(
                ToolError::new(
                    f"{rel.source.as_str()} is no longer the head of main ({head.as_str()} is); a newer push deploys",
                ),
            )
        }
    }
    if o.dry_run {
        print("a dry run: nothing deployed")
        return Ok(after)
    }
    keep_verifier(rel, root)?
    deploy_worker(rel.api.as_str(), root)?
    for w in deploy_order(rel.workers) {
        deploy_worker(w.worker.as_str(), root)?
    }
    verify(rel, root)?
    verify_kept(listings)?
    verify_api(console.domain.as_str())?
    let _ = verify_zstd(rel, root, o.zstd)?
    Ok(after)
}

/// Whether `url` answers 200 with `want`, asked at most `TRIES` times, `BETWEEN_TRIES` apart: a
/// Worker just deployed may take a while to serve its new version everywhere.
pub fn serves(url: str, want: Vec<u8>) -> Result<bool, ToolError> {
    for tries in 0..TRIES {
        if tries > 0 {
            let _ = time::after(BETWEEN_TRIES).wait()?
        }
        if let Ok(g) = get(url) {
            if g.status == 200 && g.body == want {
                return Ok(true)
            }
        }
    }
    Ok(false)
}

/// Waits until each Worker of `rel` serves its release, byte for byte (its `files.json` as the
/// release in `root` has it), and the console lists it as the one live release.
pub fn verify(rel: Release, root: str) -> Result<(), ToolError> {
    for w in rel.workers {
        let want = read_one(
            f"{root}/{w.worker.as_str()}/releases/{rel.release.as_str()}/files.json",
        )?
        let url = String::from(
            f"https://{w.domain.as_str()}/releases/{rel.release.as_str()}/files.json",
        )
        if !serves(url.as_str(), want)? {
            return Err(
                ToolError::new(f"{w.domain.as_str()} doesn't serve release {rel.release.as_str()}"),
            )
        }
        print(f"{w.worker.as_str()} ({w.domain.as_str()}) serves release {rel.release.as_str()}")
    }
    let console = home(rel)
    let deploys = history(console.domain.as_str())?
    var live = String::new()
    var count = 0
    var only = true
    for d in deploys {
        if d.live_until.is_none() {
            if count > 0 {
                live.push_str(", ")
            }
            live.push_str(d.release.as_str())
            count += 1
            only = only && d.release.as_str() == rel.release.as_str()
        }
    }
    if count != 1 || !only {
        return Err(
            ToolError::new(
                f"{console.domain.as_str()} lists [{live.as_str()}] live, not {rel.release.as_str()}",
            ),
        )
    }
    print(f"{console.domain.as_str()} lists {rel.release.as_str()} as live")
    Ok(())
}

/// Waits until the console's API paths on `domain` reach its server's Worker, as a route that takes
/// them before the console's custom domain does: until a `GET` of `API_PROBE` answers 405, asked
/// at most `TRIES` times, `BETWEEN_TRIES` apart.
pub fn verify_api(domain: str) -> Result<(), ToolError> {
    let url = String::from(f"https://{domain}{API_PROBE}")
    var last = String::new()
    for tries in 0..TRIES {
        if tries > 0 {
            let _ = time::after(BETWEEN_TRIES).wait()?
        }
        match http::fetch(request(url.as_str())).wait() {
            Ok(r) => {
                if r.status == 405 {
                    print(f"{domain}'s API paths reach its server")
                    return Ok(())
                }
                last = String::from(f"HTTP {r.status}")
            },
            Err(e) => last = String::from(e.message()),
        }
    }
    Err(ToolError::new(f"POST {url.as_str()} doesn't reach the console's server: {last.as_str()}"))
}

/// Asks each WASM and runtime script of the new release `rel` (in `root`) on the console and the
/// games (`compressed`) for Zstandard or Brotli (`ACCEPT_ENCODING`), and says which didn't come
/// back as Zstandard (`not_zstd`): each a warning in the log, or, if `required`, the deploy's
/// failure. The warnings.
pub fn verify_zstd(rel: Release, root: str, required: bool) -> Result<Vec<String>, ToolError> {
    var problems: Vec<String> = Vec::new()
    var asked = 0
    let r = rel.release.as_str()
    for w in rel.workers {
        if w.docs {
            continue
        }
        let listing = read_one(f"{root}/{w.worker.as_str()}/releases/{r}/files.json")?
        let Some(text) = String::from_utf8(take listing) else {
            return Err(ToolError::new(f"{w.worker.as_str()}'s files.json isn't UTF-8"))
        }
        for path in compressed(read_listing(r, text.as_str()).map_err(own)?) {
            let url = String::from(f"https://{w.domain.as_str()}{quoted(path.as_str()).as_str()}")
            var req = request(url.as_str())
            req.headers.push(
                Header {
                    name: String::from("Accept-Encoding"),
                    value: String::from(ACCEPT_ENCODING),
                },
            )
            asked += 1
            let problem = match http::fetch(take req).wait() {
                Ok(got) => not_zstd(url.as_str(), got.status, got.header("content-encoding")),
                Err(e) => Some(String::from(f"GET {url.as_str()}: {e.message()}")),
            }
            if let Some(p) = problem {
                problems.push(p.clone())
            }
        }
    }
    if problems.is_empty() {
        print(f"each of {asked} WASM modules and runtime scripts comes back as Zstandard")
        return Ok(problems)
    }
    if required {
        return Err(ToolError::new(problems[0].as_str()))
    }
    for p in problems {
        print(
            f"warning: {p.as_str()} (until the zone's Compression Rule is set: docs/toolchain.md)",
        )
    }
    Ok(problems)
}

/// Waits until each Worker serves each of `listings`, its kept releases, byte for byte, as its
/// assets beside the new release.
pub fn verify_kept(listings: [Listing]) -> Result<(), ToolError> {
    for l in listings {
        let url = String::from(
            f"https://{l.worker.domain.as_str()}/releases/{l.release.as_str()}/files.json",
        )
        if !serves(url.as_str(), l.body)? {
            return Err(
                ToolError::new(
                    f"{l.worker.domain.as_str()} doesn't serve kept release {l.release.as_str()}",
                ),
            )
        }
    }
    print(f"each Worker serves its kept releases: {listings.len()} listings")
    Ok(())
}
