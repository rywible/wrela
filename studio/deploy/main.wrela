// The deploy tool (`wrela tool deploy`): deploys a release that `wrela tool release` built to
// Cloudflare Workers, keeping what live clients use.
//
// ```text
// wrela tool deploy -- [--require-main-head] [--dry-run]
// ```
//
// The release is the root `release` (build/release). A client keeps the console it loaded, and
// the console pins each game's release: a deploy must keep serving every release a client may
// still hold. The console serves `deploys.json`, the history of deploys. A release is kept while
// it's live and for `KEEP` after it stops being live (policy.wrela). The live site is the
// archive: each kept release's files are fetched from the Worker that serves them, each checked
// against the SHA-256 its `files.json` lists, and uploaded again with the new release. A file
// that doesn't arrive, or doesn't match, stops the deploy before `deploys.json` is written, and
// so does a Worker over the file limits: nothing is dropped to make room. With
// `--require-main-head`, a deploy whose commit is no longer the head of `main` (as GitHub's git
// service advertises it, as `git ls-remote` reads it) stops before it changes anything. The docs
// are the one exception to keeping: nothing pins their releases, and they deploy last, so a kept
// release the docs Worker answers 404 for never went live there, and no reader holds it.
//
// Wrangler deploys each Worker (`npx --yes wrangler@<WRANGLER>`, granted as `npx`), with the
// secrets `CLOUDFLARE_API_TOKEN` and `CLOUDFLARE_ACCOUNT_ID` given to it alone. The games deploy
// first and then the console, so a console never offers a game release its Worker doesn't serve
// yet; the docs, which no other Worker depends on, go last, so a failure there leaves the console
// and games up to date. Each Worker must serve the new release, byte for byte, and the console
// must list it as the one live release, before the deploy passes. The log says, for each
// Worker, what it keeps, how many files it uploads, what Wrangler said and that it serves the
// release.
//
// `--dry-run` does all but run Wrangler: it restores the kept releases and writes
// `deploys.json`. The grants are the workspace's (`[tools.deploy]`), so the secrets must be set,
// if only to empty values, for a dry run too.

use policy::{
    CLOUDFLARE, Deploy, Found, Limits, Release, Worker, deploy_order, history_json, home, is_inside,
    kept, main_head, next_history, quoted, read_history, read_release, redirected, uploads,
}
use release_tool::io::{data_bytes, read_files, write_files}
use release_tool::tree::hex_sha
use std::io::print
use std::job::{Job, Step}
use std::json::parse as parse_json
use std::tool::{RUNNING, args, secret}
use std::tool::files
use std::tool::files::Kind
use std::tool::http
use std::tool::http::{Header, Request}
use std::tool::run
use std::tool::time
use toolkit::wait::{done, wait}

/// The root the release is in: `wrela tool release`'s output.
pub const RELEASE: Text = "release"

/// The repository whose `main` deploys.
pub const REPOSITORY: Text = "https://github.com/rywible/wrela"

/// The Wrangler that deploys, pinned, as `npx` runs it.
pub const WRANGLER: Text = "wrangler@4.151.0"

/// The secrets Wrangler gets, when they're granted.
pub const SECRETS: [Text; 2] = ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]

/// How many files of a kept release are fetched at once.
pub const AT_ONCE: u32 = 16

/// How long a request to a live site, and a Worker's deploy, may take, in seconds.
pub const FETCH_TIMEOUT: f64 = 60.0
pub const DEPLOY_TIMEOUT: f64 = 600.0

/// The seconds a kept release's file waits before each retry of a `GET` that failed in transport
/// or that its origin answered 502, 503 or 504: so it's tried at most 5 times.
pub const BACKOFF: [f64; 4] = [1.0, 2.0, 4.0, 8.0]

/// How many times a Worker is asked whether it serves the new release, and the seconds between.
pub const TRIES: u32 = 12
pub const BETWEEN_TRIES: f64 = 5.0

pub const USAGE: Text = "usage: wrela tool deploy -- [--require-main-head] [--dry-run]"

/// What a deploy does: the root its release is in, whether it stops unless its commit is the
/// head of `main`, whether it stops before Wrangler runs, the Workers' limits, and the
/// repository whose `main` it checks.
pub struct Options: Clone {
    pub root: String,
    pub require_main_head: bool,
    pub dry_run: bool,
    pub limits: Limits,
    pub repository: String,
}

/// The options the command line gives, or `None` for a usage error.
pub fn parse_args(given: [String]) -> Option<Options> {
    var o = Options {
        root: String::from(RELEASE),
        require_main_head: false,
        dry_run: false,
        limits: CLOUDFLARE,
        repository: String::from(REPOSITORY),
    }
    for a in given {
        if a.as_str() == "--require-main-head" && !o.require_main_head {
            o.require_main_head = true
        } else if a.as_str() == "--dry-run" && !o.dry_run {
            o.dry_run = true
        } else {
            return None
        }
    }
    Some(o)
}

@job
fn main(given: take Vec<String>) -> u32 {
    let Some(o) = parse_args(given) else {
        print(USAGE)
        return 2
    }
    var j = Box::new(deploy.start(take o))
    loop {
        match j.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                match take r {
                    Ok(_) => return 0,
                    Err(e) => {
                        print(f"deploy: {e.as_str()}")
                        return 1
                    },
                }
            },
        }
    }
}

pub fn tool_init() -> Job<main> {
    main.start(args())
}

pub fn tool(job: mut Job<main>) -> u32 {
    match job.resume() {
        Step::Yielded => RUNNING,
        Step::Done(status) => status,
    }
}

// ---- Requests ----------------------------------------------------------------------------------

/// What a live site answered: its status and its body.
pub struct Got: Clone {
    pub status: u16,
    pub body: Vec<u8>,
}

/// Why a `GET` failed, and whether it failed in transport (`http::is_transport`): no response
/// came, so a retry may mend it.
pub struct Failure: Clone {
    pub why: String,
    pub transport: bool,
}

fn failure(why: take String) -> Failure {
    Failure { why, transport: false }
}

/// A `GET` of `url`, following a redirect that stays on its origin (at most 5), as a Worker's
/// assets redirect `/x/index.html` to `/x/`. A request that fails is an error; a status isn't.
@job
pub fn get_once(given: take String) -> Result<Got, Failure> {
    var url = take given
    for _ in 0..6 {
        var req = http::get(url.as_str())
        req.headers.push(
            Header { name: String::from("User-Agent"), value: String::from("wrela-deploy") },
        )
        req.timeout = FETCH_TIMEOUT
        var f = wait(http::fetch(req))
        while !f.ready() { yield }
        let response = match http::read_response(f.polled()) {
            Ok(r) => take r,
            Err(e) => {
                return Err(
                    Failure {
                        why: String::from(f"GET {url.as_str()}: {e.message()}"),
                        transport: http::is_transport(e),
                    },
                )
            },
        }
        let status = response.status
        if status == 301 || status == 302 || status == 303 || status == 307 || status == 308 {
            let Some(location) = response.header("location") else {
                return Err(
                    failure(String::from(f"GET {url.as_str()}: a redirect with no location")),
                )
            }
            let Some(next) = redirected(url.as_str(), location.as_str()) else {
                return Err(
                    failure(
                        String::from(
                            f"GET {url.as_str()}: a redirect off its origin, to {location.as_str()}",
                        ),
                    ),
                )
            }
            url = take next
            continue
        }
        var jb = Box::new(data_bytes.start(response.body.clone()))
        var b = done(jb.get_mut().resume())
        while b.is_none() {
            yield
            b = done(jb.get_mut().resume())
        }
        return match (take b).unwrap() {
            Ok(body) => Ok(Got { status, body }),
            Err(e) => Err(failure(String::from(f"GET {url.as_str()}: {e.as_str()}"))),
        }
    }
    Err(failure(String::from(f"GET {url.as_str()}: too many redirects")))
}

/// `get_once`, its failure said as text.
@job
pub fn get(given: take String) -> Result<Got, String> {
    var j = Box::new(get_once.start(take given))
    var r = done(j.get_mut().resume())
    while r.is_none() {
        yield
        r = done(j.get_mut().resume())
    }
    match (take r).unwrap() {
        Ok(g) => Ok(take g),
        Err(f) => Err(f.why.clone()),
    }
}

/// Whether a `GET`'s result may mend if it's tried again: it failed in transport (no response
/// came), or the origin answered 502, 503 or 504. A definite answer (200, a 404, ...) isn't.
pub fn transient(r: Result<Got, Failure>) -> bool {
    match r {
        Ok(g) => g.status == 502 || g.status == 503 || g.status == 504,
        Err(f) => f.transport,
    }
}

/// A `GET` of `url`, tried again after each `BACKOFF` while its result is `transient`. Its last
/// result, which says how many tries it took if it's still transient.
@job
pub fn get_retried(given: take String) -> Result<Got, String> {
    let url = take given
    var tries: u32 = 0
    loop {
        var j = Box::new(get_once.start(url.clone()))
        var got = done(j.get_mut().resume())
        while got.is_none() {
            yield
            got = done(j.get_mut().resume())
        }
        let r = (take got).unwrap()
        tries += 1
        if !transient(r) {
            return match take r {
                Ok(g) => Ok(take g),
                Err(f) => Err(f.why.clone()),
            }
        }
        if tries > BACKOFF.len() {
            return match take r {
                Ok(g) => Err(String::from(f"GET {url.as_str()}: HTTP {g.status}, {tries} tries")),
                Err(f) => Err(String::from(f"{f.why.as_str()} ({tries} tries)")),
            }
        }
        var t = wait(time::after(BACKOFF[tries - 1]))
        while !t.ready() { yield }
    }
}

/// Each `GET` of `urls`, at once, each retried while it's transient (`get_retried`).
@job
pub fn get_all(given: take Vec<String>) -> Vec<Result<Got, String>> {
    let urls = take given
    var jobs: Vec<Job<get_retried>> = Vec::new()
    var got: Vec<Option<Result<Got, String>>> = Vec::new()
    for u in urls {
        jobs.push(get_retried.start(u.clone()))
        got.push(None)
    }
    var left = urls.len()
    while left > 0 {
        for k in 0..jobs.len() {
            if got[k].is_none() {
                got[k] = done(jobs[k].resume())
                if got[k].is_some() {
                    left -= 1
                }
            }
        }
        if left > 0 {
            yield
        }
    }
    var out: Vec<Result<Got, String>> = Vec::new()
    for k in 0..got.len() {
        let Some(r) = replace(mut got[k], None) else { panic("every request is answered") }
        out.push(take r)
    }
    out
}

/// The body at `url`, which must answer 200.
@job
pub fn fetch_ok(given: take String) -> Result<Vec<u8>, String> {
    let url = take given
    var j = Box::new(get.start(url.clone()))
    var r = done(j.get_mut().resume())
    while r.is_none() {
        yield
        r = done(j.get_mut().resume())
    }
    let got = (take r).unwrap()?
    if got.status != 200 {
        return Err(String::from(f"GET {url.as_str()}: HTTP {got.status}"))
    }
    Ok(got.body.clone())
}

/// The deploys the console at `domain` lists, oldest first.
@job
pub fn history(given: take String) -> Result<Vec<Deploy>, String> {
    let domain = take given
    var j = Box::new(fetch_ok.start(String::from(f"https://{domain.as_str()}/deploys.json")))
    var r = done(j.get_mut().resume())
    while r.is_none() {
        yield
        r = done(j.get_mut().resume())
    }
    let body = (take r).unwrap()?
    let Some(text) = String::from_utf8(take body) else {
        return Err(String::from(f"{domain.as_str()}'s deploys.json isn't UTF-8"))
    }
    read_history(text.as_str())
}

/// The whole of the file at `path`, a root path.
@job
pub fn read_one(given: take String) -> Result<Vec<u8>, String> {
    let path = take given
    var j = Box::new(read_files.start(Vec::from([path.clone()])))
    var r = done(j.get_mut().resume())
    while r.is_none() {
        yield
        r = done(j.get_mut().resume())
    }
    var all = (take r).unwrap()?
    Ok(replace(mut all[0], Vec::new()))
}

/// Every entry under the directory `dir` (a root path), each by its path there, with its kind
/// and size: a link is listed, not followed.
@job
pub fn found(given: take String) -> Result<Vec<Found>, String> {
    let dir = take given
    var out: Vec<Found> = Vec::new()
    var todo: Vec<String> = Vec::from([String::new()])
    while !todo.is_empty() {
        let rel = todo.drain_front(1)[0].clone()
        let path = if rel.is_empty() { dir.clone() } else {
            String::from(f"{dir.as_str()}/{rel.as_str()}")
        }
        var l = wait(files::list(path.as_str()))
        while !l.ready() { yield }
        let entries = match files::read_list(l.polled()) {
            Ok(e) => take e,
            Err(e) => return Err(String::from(f"{path.as_str()}: {e.message()}")),
        }
        for e in entries {
            let at = if rel.is_empty() { e.name.clone() } else {
                String::from(f"{rel.as_str()}/{e.name.as_str()}")
            }
            if e.kind == Kind::Dir {
                todo.push(take at)
            } else {
                out.push(Found { path: at, kind: e.kind, size: e.size })
            }
        }
    }
    Ok(out)
}

// ---- Keeping -----------------------------------------------------------------------------------

/// Fetches the kept `release` from the Worker `w` serves, by its `listing` (its `files.json`,
/// as fetched), into the Worker's `releases/<release>` in `root`: each file checked against its
/// SHA-256, and one already there must be the same. How many files it keeps.
@job
pub fn restore(
    given_release: take String,
    given_worker: take Worker,
    given_listing: take Vec<u8>,
    given_root: take String,
) -> Result<u32, String> {
    let release = take given_release
    let w = take given_worker
    let listing = take given_listing
    let root = take given_root
    let base = String::from(f"https://{w.domain.as_str()}/releases/{release.as_str()}/")
    let destination = String::from(
        f"{root.as_str()}/{w.worker.as_str()}/releases/{release.as_str()}",
    )
    let Some(text) = String::from_utf8(listing.clone()) else {
        return Err(String::from(f"{release.as_str()}: its files.json isn't UTF-8"))
    }
    let Some(doc) = parse_json(text.as_str()) else {
        return Err(String::from(f"{release.as_str()}: its files.json isn't JSON"))
    }
    var wanted: Vec<(String, String)> = Vec::new()
    for (path, n) in doc.members(0) {
        let Some(digest) = doc.text(n) else {
            return Err(String::from(f"{release.as_str()}: {path.as_str()} has no SHA-256"))
        }
        if !is_inside(path.as_str()) {
            return Err(String::from(f"{release.as_str()}: invalid path '{path.as_str()}'"))
        }
        wanted.push((path.clone(), take digest))
    }
    wanted.sort_by(|a: (String, String), b: (String, String)| a.0 < b.0)
    // What's there already: the release may have this release's files (a redeploy).
    var jf = Box::new(found.start(destination.clone()))
    var listed = done(jf.get_mut().resume())
    while listed.is_none() {
        yield
        listed = done(jf.get_mut().resume())
    }
    var there: Vec<String> = Vec::new()
    // No such directory: nothing is there.
    if let Ok(list) = (take listed).unwrap() {
        for f in list {
            there.push(f.path.clone())
        }
    }
    var at = 0
    while at < wanted.len() {
        let n = min(AT_ONCE, wanted.len() - at)
        var urls: Vec<String> = Vec::new()
        for k in 0..n {
            urls.push(String::from(f"{base.as_str()}{quoted(wanted[at + k].0.as_str()).as_str()}"))
        }
        var jg = Box::new(get_all.start(urls.clone()))
        var fetched = done(jg.get_mut().resume())
        while fetched.is_none() {
            yield
            fetched = done(jg.get_mut().resume())
        }
        var got = (take fetched).unwrap()
        var items: Vec<(String, Vec<u8>)> = Vec::new()
        for k in 0..n {
            let r = replace(mut got[k], Ok(Got { status: 0, body: Vec::new() }))
            let g = (take r)?
            if g.status != 200 {
                return Err(String::from(f"GET {urls[k].as_str()}: HTTP {g.status}"))
            }
            let path = wanted[at + k].0.clone()
            let digest = wanted[at + k].1.clone()
            if hex_sha(g.body).as_str() != digest.as_str() {
                return Err(
                    String::from(
                        f"{release.as_str()}/{path.as_str()} from {w.domain.as_str()} doesn't match its SHA-256",
                    ),
                )
            }
            items.push((path.clone(), g.body.clone()))
        }
        var jk = Box::new(keep.start(take items, destination.clone(), there.clone()))
        var kept = done(jk.get_mut().resume())
        while kept.is_none() {
            yield
            kept = done(jk.get_mut().resume())
        }
        (take kept).unwrap()?
        at += n
    }
    var jl = Box::new(
        keep.start(
            Vec::from([(String::from("files.json"), listing.clone())]),
            destination.clone(),
            there.clone(),
        ),
    )
    var kept = done(jl.get_mut().resume())
    while kept.is_none() {
        yield
        kept = done(jl.get_mut().resume())
    }
    (take kept).unwrap()?
    Ok(wanted.len())
}

/// Writes each file of `items` (its path in `dir`, and its bytes) into `dir`, unless it's
/// `there` already: then it must be the same, since a release's URLs are immutable.
@job
pub fn keep(
    given_items: take Vec<(String, Vec<u8>)>,
    given_dir: take String,
    given_there: take Vec<String>,
) -> Result<(), String> {
    var items = take given_items
    let dir = take given_dir
    let there = take given_there
    var new: Vec<(String, Vec<u8>)> = Vec::new()
    for k in 0..items.len() {
        let path = String::from(f"{dir.as_str()}/{items[k].0.as_str()}")
        var known = false
        for t in there {
            if t.as_str() == items[k].0.as_str() {
                known = true
            }
        }
        if !known {
            new.push((take path, replace(mut items[k].1, Vec::new())))
            continue
        }
        var j = Box::new(read_one.start(path.clone()))
        var r = done(j.get_mut().resume())
        while r.is_none() {
            yield
            r = done(j.get_mut().resume())
        }
        let had = (take r).unwrap()?
        if had != items[k].1 {
            return Err(String::from(f"an immutable release cannot change: {path.as_str()}"))
        }
    }
    var jw = Box::new(write_files.start(take new))
    var r = done(jw.get_mut().resume())
    while r.is_none() {
        yield
        r = done(jw.get_mut().resume())
    }
    (take r).unwrap()
}

// ---- The deploy --------------------------------------------------------------------------------

/// The seconds since 1970, now.
@job
pub fn now() -> Result<i64, String> {
    var w = wait(time::utc_now())
    while !w.ready() { yield }
    match time::read_utc(w.polled()) {
        Ok(t) => Ok(i64(t.seconds)),
        Err(e) => Err(String::from(e.message())),
    }
}

/// The deploy `o` says: the history it leaves.
@job
pub fn deploy(given: take Options) -> Result<Vec<Deploy>, String> {
    let o = take given
    let root = o.root.clone()
    var jr = Box::new(read_one.start(String::from(f"{root.as_str()}/release.json")))
    var read = done(jr.get_mut().resume())
    while read.is_none() {
        yield
        read = done(jr.get_mut().resume())
    }
    let Some(text) = String::from_utf8((take read).unwrap()?) else {
        return Err(String::from("release.json isn't UTF-8"))
    }
    let rel = read_release(text.as_str())?
    let console = home(rel)
    var jn = Box::new(now.start())
    var clock = done(jn.get_mut().resume())
    while clock.is_none() {
        yield
        clock = done(jn.get_mut().resume())
    }
    let at = (take clock).unwrap()?
    var jh = Box::new(history.start(console.domain.clone()))
    var listed = done(jh.get_mut().resume())
    while listed.is_none() {
        yield
        listed = done(jh.get_mut().resume())
    }
    let deploys = (take listed).unwrap()?
    print(f"deploying release {rel.release.as_str()} of {rel.source.as_str()}")
    let keeping = kept(deploys, at, rel.release.as_str())
    for di in 0..keeping.len() {
        let d = keeping[di].clone()
        for wi in 0..rel.workers.len() {
            let w = rel.workers[wi].clone()
            // A Worker the kept release didn't have (a game added since) has nothing to keep.
            var had = false
            for name in d.workers {
                if name.as_str() == w.worker.as_str() {
                    had = true
                }
            }
            if !had {
                continue
            }
            let url = String::from(
                f"https://{w.domain.as_str()}/releases/{d.release.as_str()}/files.json",
            )
            var jl = Box::new(get.start(url.clone()))
            var got = done(jl.get_mut().resume())
            while got.is_none() {
                yield
                got = done(jl.get_mut().resume())
            }
            let g = (take got).unwrap()?
            if g.status == 404 && w.docs {
                print(f"{w.worker.as_str()} never served {d.release.as_str()}: nothing to keep")
                continue
            }
            if g.status != 200 {
                return Err(String::from(f"GET {url.as_str()}: HTTP {g.status}"))
            }
            if g.body.is_empty() {
                continue
            }
            var jk = Box::new(
                restore.start(d.release.clone(), w.clone(), g.body.clone(), root.clone()),
            )
            var restored = done(jk.get_mut().resume())
            while restored.is_none() {
                yield
                restored = done(jk.get_mut().resume())
            }
            let n = (take restored).unwrap()?
            print(
                f"{w.worker.as_str()} keeps {d.release.as_str()}: {n} files from {w.domain.as_str()}",
            )
        }
    }
    var names: Vec<String> = Vec::new()
    for wi in 0..rel.workers.len() {
        let w = rel.workers[wi].clone()
        names.push(w.worker.clone())
    }
    let after = next_history(deploys, rel.release.as_str(), rel.source.as_str(), names, at)
    let path = String::from(f"{root.as_str()}/{console.worker.as_str()}/deploys.json")
    var jw = Box::new(
        write_files.start(Vec::from([(take path, Vec::from(history_json(after).as_bytes()))])),
    )
    var wrote = done(jw.get_mut().resume())
    while wrote.is_none() {
        yield
        wrote = done(jw.get_mut().resume())
    }
    (take wrote).unwrap()?
    for wi in 0..rel.workers.len() {
        let w = rel.workers[wi].clone()
        var jf = Box::new(found.start(String::from(f"{root.as_str()}/{w.worker.as_str()}")))
        var listed = done(jf.get_mut().resume())
        while listed.is_none() {
            yield
            listed = done(jf.get_mut().resume())
        }
        let n = uploads((take listed).unwrap()?, o.limits)?
        print(f"{w.worker.as_str()} ({w.domain.as_str()}): {n} files")
    }
    if o.require_main_head {
        let url = String::from(f"{o.repository.as_str()}.git/info/refs?service=git-upload-pack")
        var jm = Box::new(fetch_ok.start(url.clone()))
        var refs = done(jm.get_mut().resume())
        while refs.is_none() {
            yield
            refs = done(jm.get_mut().resume())
        }
        let Some(head) = main_head((take refs).unwrap()?) else {
            return Err(String::from(f"{url.as_str()} names no head of main"))
        }
        if head.as_str() != rel.source.as_str() {
            return Err(
                String::from(
                    f"{rel.source.as_str()} is no longer the head of main ({head.as_str()} is); a newer push deploys",
                ),
            )
        }
    }
    if o.dry_run {
        print("a dry run: nothing deployed")
        return Ok(after)
    }
    let order = deploy_order(rel.workers)
    for wi in 0..order.len() {
        let w = order[wi].clone()
        var c = run::command("npx", root.as_str())
        c.args = Vec::from(
            [
                String::from("--yes"),
                String::from(WRANGLER),
                String::from("deploy"),
                String::from("--config"),
                String::from(f"{w.worker.as_str()}.wrangler.json"),
            ],
        )
        for name in SECRETS {
            if secret(name).is_some() {
                c.secrets.push(String::from(name))
            }
        }
        c.timeout = DEPLOY_TIMEOUT
        print(f"{w.worker.as_str()}: wrangler deploy")
        var r = wait(run::run(c))
        while !r.ready() { yield }
        let ran = match run::read_ran(r.polled()) {
            Ok(r) => take r,
            Err(e) => return Err(
                String::from(f"wrangler deploy of {w.worker.as_str()}: {e.message()}"),
            ),
        }
        for stream in 0..2 {
            let data = if stream == 0 { ran.stdout.clone() } else { ran.stderr.clone() }
            var jd = Box::new(data_bytes.start(take data))
            var said = done(jd.get_mut().resume())
            while said.is_none() {
                yield
                said = done(jd.get_mut().resume())
            }
            match String::from_utf8((take said).unwrap()?) {
                Some(t) => {
                    let out = t.trim()
                    if !out.is_empty() {
                        print(out)
                    }
                },
                None => print("(wrangler's output isn't UTF-8)"),
            }
        }
        if ran.status != 0 {
            return Err(String::from(f"wrangler deploy of {w.worker.as_str()} exited {ran.status}"))
        }
    }
    var jv = Box::new(verify.start(take rel, root.clone()))
    var verified = done(jv.get_mut().resume())
    while verified.is_none() {
        yield
        verified = done(jv.get_mut().resume())
    }
    (take verified).unwrap()?
    Ok(after)
}

/// Waits until each Worker of `rel` serves its release, byte for byte (its `files.json` as the
/// release in `root` has it), and the console lists it as the one live release.
@job
pub fn verify(given: take Release, given_root: take String) -> Result<(), String> {
    let rel = take given
    let root = take given_root
    for wi in 0..rel.workers.len() {
        let w = rel.workers[wi].clone()
        let local = String::from(
            f"{root.as_str()}/{w.worker.as_str()}/releases/{rel.release.as_str()}/files.json",
        )
        var jr = Box::new(read_one.start(take local))
        var read = done(jr.get_mut().resume())
        while read.is_none() {
            yield
            read = done(jr.get_mut().resume())
        }
        let want = (take read).unwrap()?
        let url = String::from(
            f"https://{w.domain.as_str()}/releases/{rel.release.as_str()}/files.json",
        )
        var tries = 0
        loop {
            var jg = Box::new(get.start(url.clone()))
            var got = done(jg.get_mut().resume())
            while got.is_none() {
                yield
                got = done(jg.get_mut().resume())
            }
            let serves = match (take got).unwrap() {
                Ok(g) => g.status == 200 && g.body == want,
                Err(_) => false,
            }
            if serves {
                break
            }
            tries += 1
            if tries == TRIES {
                return Err(
                    String::from(
                        f"{w.domain.as_str()} doesn't serve release {rel.release.as_str()}",
                    ),
                )
            }
            var t = wait(time::after(BETWEEN_TRIES))
            while !t.ready() { yield }
        }
        print(f"{w.worker.as_str()} ({w.domain.as_str()}) serves release {rel.release.as_str()}")
    }
    let console = home(rel)
    var jh = Box::new(history.start(console.domain.clone()))
    var listed = done(jh.get_mut().resume())
    while listed.is_none() {
        yield
        listed = done(jh.get_mut().resume())
    }
    let deploys = (take listed).unwrap()?
    var live = String::new()
    var count = 0
    var only = true
    for d in deploys {
        if d.live_until.is_none() {
            if count > 0 {
                live.push_str(", ")
            }
            live.push_str(d.release.as_str())
            count += 1
            only = only && d.release.as_str() == rel.release.as_str()
        }
    }
    if count != 1 || !only {
        return Err(
            String::from(
                f"{console.domain.as_str()} lists [{live.as_str()}] live, not {rel.release.as_str()}",
            ),
        )
    }
    print(f"{console.domain.as_str()} lists {rel.release.as_str()} as live")
    Ok(())
}
