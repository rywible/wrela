// The deploy tool's tests: the history, its dates and the releases it keeps, the listings, the
// files a Worker may upload, the order of the Workers, the head of `main` and redirects, as plain
// tests; and as tool tests against fake sites and a fake `npx` (fakes/npx), the deploy itself:
// the kept releases it puts in each Worker's assets, what stops it before it changes anything,
// and the Workers deployed in order, each serving the release and its kept ones as assets.

use main::{Listing, Options, deploy, parse_args, verify, verify_api, verify_kept}
use policy::{
    CLOUDFLARE, Deploy, Found, Limits, Release, Worker, deploy_order, has, history_json, insert,
    is_inside, kept, main_head, next_history, parse_stamp, quoted, read_history, read_listing,
    read_release, redirected, stamp, uploads,
}
use release_tool::catalog::CATALOG
use release_tool::io::{read_files, write_files}
use release_tool::json::{Json, compact, member, text}
use release_tool::site::{Report, api_config, release_json, replace_all, wrangler_config}
use release_tool::tree::hex_sha
use std::tool::ToolError
use std::tool::files
use std::tool::files::Kind
use std::tool::testing
use std::tool::testing::Fake
use std::tool::time
use std::tool::time::Utc

fn contains(haystack: str, needle: str) -> bool {
    haystack.find(needle).is_some()
}

// ---- The history -------------------------------------------------------------------------------

const A: Text = "aaaaaaaaaaaaaaaaaaaa"
const B: Text = "bbbbbbbbbbbbbbbbbbbb"
const C: Text = "cccccccccccccccccccc"
const D: Text = "dddddddddddddddddddd"
const DAY: i64 = 86400

/// The commit the tests' release D is built from.
const SOURCE: Text = "235bac2f6ee4865141b2d2347ddae9f175a6ff17"

/// The tests' now: 2026-10-15T12:00:00Z.
fn now() -> i64 {
    let Some(t) = parse_stamp("2026-10-15T12:00:00+00:00") else { panic("a date") }
    t
}

fn workers(docs: bool) -> Vec<String> {
    var w = Vec::from([String::from("console-host"), String::from("game-host")])
    if docs {
        w.push(String::from("docs-host"))
    }
    w
}

fn entry(release: str, until: Option<i64>, docs: bool) -> Deploy {
    Deploy {
        release: String::from(release),
        source: String::from("x"),
        workers: workers(docs: docs),
        live_from: now() - 30 * DAY,
        live_until: until,
    }
}

/// A ended 20 days ago, B 3 days ago, and C is live.
fn history(docs: bool) -> Vec<Deploy> {
    Vec::from(
        [
            entry(A, Some(now() - 20 * DAY), docs: docs),
            entry(B, Some(now() - 3 * DAY), docs: docs),
            entry(C, None, docs: docs),
        ],
    )
}

fn releases(deploys: [Deploy]) -> String {
    var out = String::new()
    for d in deploys {
        out.push_str(d.release.slice(from: 0, to: 1))
    }
    out
}

@test
fn a_release_stays_for_its_window_after_it_stops_being_live() {
    let h = history(docs: false)
    assert(releases(kept(h, now(), D)).as_str() == "bc")
    // Redeploying the live release keeps the others it would have kept.
    assert(releases(kept(h, now(), C)).as_str() == "b")
    let after = next_history(h, D, "head", workers(docs: false), now())
    assert(releases(after).as_str() == "bcd")
    assert(after[0].live_until == Some(now() - 3 * DAY))
    assert(after[1].live_until == Some(now()), "the live one ends now")
    assert(after[2].live_until.is_none() && after[2].live_from == now())
    assert(after[2].source.as_str() == "head" && after[2].workers.len() == 2)
    // A release exactly `KEEP` past its end is still kept; a second later it isn't.
    let edge = Vec::from([entry(A, Some(now() - 14 * DAY), docs: false)])
    assert(kept(edge, now(), D).len() == 1)
    assert(kept(edge, now() + 1, D).is_empty())
    assert(releases(kept(edge, now(), A)).is_empty(), "a redeploy of it isn't kept beside itself")
}

@test
fn dates_read_and_write_as_the_history_has_them() {
    for s in [
        "2026-10-15T20:32:18+00:00",
        "2024-02-29T00:00:00+00:00",
        "1970-01-01T00:00:00+00:00",
    ] {
        let Some(t) = parse_stamp(s) else { panic(s) }
        assert(stamp(t).as_str() == s, stamp(t).as_str())
    }
    assert(parse_stamp("1970-01-02T00:00:00Z") == Some(DAY))
    assert(parse_stamp("1970-01-01T01:00:00+01:00") == Some(0))
    assert(parse_stamp("1970-01-01T00:00:00-00:30") == Some(1800))
    for bad in ["2026-10-15", "2026-13-01T00:00:00+00:00", "2026-10-15 12:00:00+00:00", "x"] {
        assert(parse_stamp(bad).is_none(), bad)
    }
}

@test
fn the_history_reads_back_as_it_is_written() {
    let h = next_history(history(docs: false), D, "head", workers(docs: false), now())
    let json = history_json(h)
    let Ok(again) = read_history(json.as_str()) else { panic("reads") }
    assert(history_json(again).as_str() == json.as_str())
    let one = Vec::from([entry(D, None, docs: false)])
    let want = "{\n  \"deploys\": [\n    {\n      \"release\": \"dddddddddddddddddddd\",\n      \"source\": \"x\",\n      \"workers\": [\n        \"console-host\",\n        \"game-host\"\n      ],\n      \"live_from\": \"2026-09-15T12:00:00+00:00\",\n      \"live_until\": null\n    }\n  ]\n}\n"
    assert(history_json(one).as_str() == want, history_json(one).as_str())
    // A history an R2 bucket's deploys wrote, which says whether the bucket held each release,
    // reads as the same deploys, and is written again without it.
    let bucket = "{\"deploys\": [{\"release\": \"dddddddddddddddddddd\", \"source\": \"x\", \"workers\": [\"console-host\", \"game-host\"], \"live_from\": \"2026-09-15T12:00:00+00:00\", \"live_until\": null, \"stored\": true}]}"
    let Ok(old) = read_history(bucket) else { panic("reads") }
    assert(history_json(old).as_str() == want, history_json(old).as_str())
    let bad = "{\"deploys\": [{\"release\": \"../x\", \"source\": \"x\", \"workers\": [], \"live_from\": \"2026-09-15T12:00:00+00:00\", \"live_until\": null}]}"
    match read_history(bad) {
        Ok(_) => panic("an invalid release reads"),
        Err(e) => assert(contains(e.as_str(), "invalid release"), e.as_str()),
    }
    assert(read_history("{}").is_err())
}

// ---- Uploads, order, main's head, redirects ----------------------------------------------------

fn file(path: Text, size: u64) -> Found {
    Found { path: String::from(path), kind: Kind::File, size }
}

fn refused(entries: [Found], limits: Limits, why: str) {
    match uploads(entries, limits) {
        Ok(_) => panic(f"uploads, but should fail with `{why}`"),
        Err(e) => assert(contains(e.as_str(), why), e.as_str()),
    }
}

@test
fn private_storage_and_symlinks_cannot_be_uploaded() {
    assert(uploads([file("game.wasm", 4)], CLOUDFLARE) == Ok(1))
    refused([file("game.wasm", 4), file("storage/save", 7)], CLOUDFLARE, "private")
    refused([file("a/results/DONE", 1)], CLOUDFLARE, "private")
    refused([file(".native/x", 1)], CLOUDFLARE, "private")
    refused([file("a/.wrangler/state", 1)], CLOUDFLARE, "hidden")
    refused(
        [file("game.wasm", 4), Found { path: String::from("outside"), kind: Kind::Link, size: 0 }],
        CLOUDFLARE,
        "symbolic",
    )
    refused([file("big.bin", CLOUDFLARE.largest + 1)], CLOUDFLARE, "file limit")
    assert(uploads([file("big.bin", CLOUDFLARE.largest)], CLOUDFLARE) == Ok(1))
    let three = Limits { most_files: 3, largest: CLOUDFLARE.largest }
    assert(uploads([file("a", 1), file("b", 1), file("c", 1)], three) == Ok(3))
    refused([file("a", 1), file("b", 1), file("c", 1), file("d", 1)], three, "file-count")
}

@test
fn kept_paths_stay_in_their_release_and_quote_as_urls() {
    assert(is_inside("session/files/floor/t1_-1.bin"))
    for bad in ["", "../../escape", "a//b", "./a", "a/.", "/abs", "a\\b"] {
        assert(!is_inside(bad), bad)
    }
    assert(quoted("session/files/floor/t1_-1.bin").as_str() == "session/files/floor/t1_-1.bin")
    assert(quoted("a b/c%d~é").as_str() == "a%20b/c%25d~%C3%A9")
}

@test
fn a_listing_names_files_inside_its_release_by_their_sha256() {
    let sha = hex_sha(String::from("x").as_bytes())
    let Ok(files) = read_listing(
        D,
        f"{{\"b/c\": \"{sha.as_str()}\", \"a\": \"{sha.as_str()}\"}}",
    ) else {
        panic("reads")
    }
    assert(files.len() == 2 && files[0].0.as_str() == "a" && files[1].0.as_str() == "b/c")
    assert(files[0].1.as_str() == sha.as_str())
    let bad = [
        String::from(f"{{\"../x\": \"{sha.as_str()}\"}}"),
        String::from("{\"a\": \"not a digest\"}"),
        String::from(
            "{\"a\": \"ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789\"}",
        ),
        String::from("{\"a\": 1}"),
        String::from("[]"),
        String::from("x"),
    ]
    for b in bad {
        assert(read_listing(D, b.as_str()).is_err(), b.as_str())
    }
}

@test
fn a_sorted_set_holds_each_file_once() {
    var set: Vec<String> = Vec::new()
    assert(insert(mut set, "b") && insert(mut set, "a") && insert(mut set, "c"))
    assert(!insert(mut set, "b"), "each once")
    assert(set.len() == 3 && set[0].as_str() == "a" && set[2].as_str() == "c")
    assert(has(set, "c") && !has(set, "d") && !has(set, ""))
}

fn worker(name: Text, console: bool, docs: bool) -> Worker {
    Worker { worker: String::from(name), domain: String::from(f"{name}.example"), console, docs }
}

@test
fn the_games_deploy_before_the_console_and_the_docs_last() {
    let order = deploy_order(
        [
            worker("docs", console: false, docs: true),
            worker("console", console: true, docs: false),
            worker("one", console: false, docs: false),
            worker("two", console: false, docs: false),
        ],
    )
    var names = String::new()
    for w in order {
        names.push_str(f"{w.worker.as_str()} ")
    }
    assert(names.as_str() == "one two console docs ", names.as_str())
}

/// A pkt-line: its length in four hexadecimal digits, then `line`.
fn pkt(out: mut Vec<u8>, line: str) {
    let hex = "0123456789abcdef"
    let n = line.len() + 4
    for k in 0..4 {
        out.push(hex.byte((n >> (12 - 4 * k)) & 15))
    }
    for i in 0..line.len() {
        out.push(line.byte(i))
    }
}

/// GitHub's advertisement of a repository whose `main` is at `head`.
fn advertised(head: str) -> Vec<u8> {
    let other = "0123456789012345678901234567890123456789"
    var out: Vec<u8> = Vec::new()
    pkt(mut out, "# service=git-upload-pack\n")
    for b in String::from("0000").as_bytes() {
        out.push(b)
    }
    var first = String::from(f"{head} HEAD")
    first.push_byte(0)
    first.push_str("multi_ack symref=HEAD:refs/heads/main\n")
    pkt(mut out, first.as_str())
    pkt(mut out, f"{other} refs/heads/main-old\n")
    pkt(mut out, f"{head} refs/heads/main\n")
    pkt(mut out, f"{other} refs/pull/1/head\n")
    for b in String::from("0000").as_bytes() {
        out.push(b)
    }
    out
}

@test
fn mains_head_is_read_from_the_advertised_refs() {
    let head = "235bac2f6ee4865141b2d2347ddae9f175a6ff17"
    let Some(got) = main_head(advertised(head)) else { panic("main's head") }
    assert(got.as_str() == head, got.as_str())
    var none: Vec<u8> = Vec::new()
    pkt(mut none, f"{head} refs/heads/mainline\n")
    assert(main_head(none).is_none())
    assert(main_head(Vec::from(String::from("zzzz").as_bytes())).is_none(), "not a pkt-line")
    assert(
        main_head(Vec::from(String::from("00ff").as_bytes())).is_none(),
        "a pkt-line past the end",
    )
}

@test
fn redirects_are_followed_only_on_their_origin() {
    let from = "https://wrela.dev/releases/x/index.html"
    let Some(a) = redirected(from, "/releases/x/") else { panic("a path") }
    assert(a.as_str() == "https://wrela.dev/releases/x/")
    let Some(b) = redirected(from, "https://wrela.dev/releases/x/") else { panic("its origin") }
    assert(b.as_str() == "https://wrela.dev/releases/x/")
    for off in [
        "https://wrela.devil/x",
        "https://evil.example/",
        "//evil.example/",
        "http://wrela.dev/",
    ] {
        assert(redirected(from, off).is_none(), off)
    }
}

@test
fn the_command_line_takes_its_flags_once() {
    let Some(o) = parse_args(
        [String::from("--dry-run"), String::from("--require-main-head")],
    ) else {
        panic("flags")
    }
    assert(o.dry_run && o.require_main_head && o.root.as_str() == "release")
    let none: [String; 0] = []
    let Some(plain) = parse_args(none) else { panic("no flags") }
    assert(!plain.dry_run && !plain.require_main_head)
    assert(parse_args([String::from("--dry-run"), String::from("--dry-run")]).is_none())
    assert(parse_args([String::from("--release"), String::from("build/release")]).is_none())
}

@test
fn a_release_names_one_console() {
    let one = release_json(
        "head",
        D,
        "api-host",
        [
            Report {
                worker: String::from("c"),
                domain: String::from("c.example"),
                console: true,
                docs: false,
                files: 0,
                bytes: 0,
            },
            Report {
                worker: String::from("d"),
                domain: String::from("d.example"),
                console: false,
                docs: true,
                files: 0,
                bytes: 0,
            },
        ],
    )
    let Ok(r) = read_release(one.as_str()) else { panic("reads") }
    assert(r.release.as_str() == D && r.workers.len() == 2 && r.workers[1].docs)
    assert(r.api.as_str() == "api-host")
    let none = release_json(
        "head",
        D,
        "api-host",
        [
            Report {
                worker: String::from("d"),
                domain: String::from("d.example"),
                console: false,
                docs: true,
                files: 0,
                bytes: 0,
            },
        ],
    )
    assert(read_release(none.as_str()).is_err())
    assert(read_release(release_json("head", "D", "api-host", [])).is_err(), "an invalid id")
    // A release with no server's Worker isn't one.
    for bad in ["", "../x", "a b"] {
        let other = replace_all(one.as_str(), "\"api\": \"api-host\"", f"\"api\": \"{bad}\"")
        assert(other.as_str() != one.as_str() && read_release(other.as_str()).is_err(), bad)
    }
}

// ---- Tool tests: setting up --------------------------------------------------------------------

/// Puts `body` at `path` in the test's scratch, in place of what `out` put there before: one
/// write a path, since a batch writes its files at once.
fn put(out: mut Vec<(String, Vec<u8>)>, path: str, body: str) {
    let at = String::from(f"scratch/{path}")
    let bytes = Vec::from(String::from(body).as_bytes())
    for k in 0..out.len() {
        if out[k].0.as_str() == at.as_str() {
            out[k].1 = take bytes
            return
        }
    }
    out.push((take at, take bytes))
}

/// The `files.json` of `files` (each a path and its bytes).
fn listing_of(files: [(Text, String)]) -> String {
    var listing: Vec<(String, Json)> = Vec::new()
    for (path, body) in files {
        listing.push(member(path, text(hex_sha(body.as_bytes()).as_str())))
    }
    compact(Json::Obj(take listing))
}

/// `files` (each a path and its bytes) as the fake site `domain` serves `release`, with its
/// `files.json`.
fn serve(out: mut Vec<(String, Vec<u8>)>, domain: str, release: str, files: [(Text, String)]) {
    for (path, body) in files {
        put(mut out, f"sites/{domain}/releases/{release}/{path}", body.as_str())
    }
    put(mut out, f"sites/{domain}/releases/{release}/files.json", listing_of(files).as_str())
}

/// A release D as `wrela tool release` leaves it, with the docs if `docs` (listed first if
/// `docs_first`) and the console's server's Worker, and the live site: B and C on the console and
/// the game, and the history.
fn site(docs: bool, docs_first: bool) -> Vec<(String, Vec<u8>)> {
    var out: Vec<(String, Vec<u8>)> = Vec::new()
    var reports: Vec<Report> = Vec::new()
    let docs_report = Report {
        worker: String::from("docs-host"),
        domain: String::from("docs.example"),
        console: false,
        docs: true,
        files: 0,
        bytes: 0,
    }
    if docs && docs_first {
        reports.push(docs_report.clone())
    }
    reports.push(
        Report {
            worker: String::from("console-host"),
            domain: String::from("console.example"),
            console: true,
            docs: false,
            files: 0,
            bytes: 0,
        },
    )
    reports.push(
        Report {
            worker: String::from("game-host"),
            domain: String::from("game.example"),
            console: false,
            docs: false,
            files: 0,
            bytes: 0,
        },
    )
    if docs && !docs_first {
        reports.push(docs_report.clone())
    }
    put(mut out, "release.json", release_json(SOURCE, D, "api-host", reports).as_str())
    put(mut out, "api-host.wrangler.json", api_host_config().as_str())
    for r in reports {
        let page = [("index.html", String::from("new"))]
        put(mut out, f"{r.worker.as_str()}/releases/{D}/index.html", "new")
        put(mut out, f"{r.worker.as_str()}/releases/{D}/files.json", listing_of(page).as_str())
        put(
            mut out,
            f"{r.worker.as_str()}.wrangler.json",
            wrangler_config(r.worker.as_str(), r.domain.as_str()).as_str(),
        )
    }
    for release in [B, C] {
        serve(
            mut out,
            "console.example",
            release,
            [("index.html", String::from(f"{release} page"))],
        )
        serve(
            mut out,
            "game.example",
            release,
            [
                ("session/game.wasm", String::from(release)),
                ("session/files/floor/t1_-1.bin", String::from("tile")),
            ],
        )
    }
    put(mut out, "sites/console.example/deploys.json", history_json(history(docs: docs)).as_str())
    out
}

/// The console's server's Worker's configuration, as the release tool writes it for a server
/// build that runs `/api/*` first: a script on the console's API paths.
fn api_host_config() -> String {
    let first = Json::Obj(
        Vec::from([member("run_worker_first", Json::List(Vec::from([text("/api/*")])))]),
    )
    match api_config(
        "api-host",
        "console.example",
        "console.example",
        "",
        [member("assets", take first)],
    ) {
        Ok(c) => c,
        Err(e) => panic(e.as_str()),
    }
}

fn options(dry_run: bool) -> Options {
    Options {
        root: String::from("scratch"),
        require_main_head: !dry_run,
        dry_run,
        limits: CLOUDFLARE,
        repository: String::from("https://github.com/rywible/wrela"),
    }
}

/// The URL GitHub advertises the repository's refs at.
const REFS: Text = "https://github.com/rywible/wrela.git/info/refs?service=git-upload-pack"

/// Writes `files`, and sets the fake clock to the tests' now.
fn set_up(files: take Vec<(String, Vec<u8>)>) {
    if let Err(e) = write_files(take files) {
        panic(e.message())
    }
    assert(testing::set_utc(Utc { seconds: u64(now()), nanos: 0 }).wait().is_ok(), "the fake clock")
}

/// Sets `fake` for `url` on the fake sites.
fn faked(url: str, fake: take Fake) {
    assert(testing::fake(url, take fake).wait().is_ok(), url)
}

/// The file at `path` (a root path), or `None` if it isn't there.
fn read(path: str) -> Option<String> {
    let Ok(all) = read_files(Vec::from([String::from(path)])) else { return None }
    String::from_utf8(all[0].clone())
}

/// Whether anything is at `path` (a root path).
fn there(path: str) -> bool {
    files::stat(path).wait().is_ok()
}

fn failed(r: Result<Vec<Deploy>, ToolError>, why: str) {
    match r {
        Ok(_) => panic(f"deployed, but should fail with `{why}`"),
        Err(e) => assert(contains(e.message(), why), e.message()),
    }
}

// ---- Tool tests --------------------------------------------------------------------------------

/// The file of a kept release that a deploy fetched into its stage, by its bytes.
fn staged(body: str) -> String {
    String::from(f"scratch/stored/{hex_sha(String::from(body).as_bytes()).as_str()}")
}

/// The file at `path` of kept release `release` in `worker`'s directory of the release.
fn kept_file(worker: str, release: str, path: str) -> Option<String> {
    read(f"scratch/{worker}/releases/{release}/{path}")
}

/// A dry run fetches the kept releases from the live site, each file checked and fetched once,
/// puts each beside the new release in its Worker's directory, and writes the history it would
/// serve; a release past its window isn't kept.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn kept_releases_come_from_the_live_site_checked_into_the_workers_assets() {
    var files = site(docs: false, docs_first: false)
    // B's game has a file the new release has too: it's copied from the release, not fetched.
    serve(
        mut files,
        "game.example",
        B,
        [
            ("session/game.wasm", String::from(B)),
            ("session/files/floor/t1_-1.bin", String::from("tile")),
            ("session/same.txt", String::from("new")),
        ],
    )
    set_up(take files)
    let after = match deploy(options(dry_run: true)) {
        Ok(a) => take a,
        Err(e) => panic(e.message()),
    }
    // The tile B and C both list is one file.
    let bodies = [
        String::from(B),
        String::from(C),
        String::from("tile"),
        String::from(f"{B} page"),
        String::from(f"{C} page"),
    ]
    for body in bodies {
        let Some(t) = read(staged(body.as_str()).as_str()) else { panic(body.as_str()) }
        assert(t.as_str() == body.as_str(), body.as_str())
    }
    let Ok(stage) = files::list("scratch/stored").wait() else { panic("no stage") }
    assert(stage.len() == 5, f"{stage.len()} entries")
    // Each kept release beside the new one, as the live site served it.
    for release in [B, C] {
        for w in ["console-host", "game-host"] {
            let Some(listing) = kept_file(w, release, "files.json") else { panic(release) }
            let domain = if w == "console-host" { "console.example" } else { "game.example" }
            let Some(served) = read(f"scratch/sites/{domain}/releases/{release}/files.json") else {
                panic(domain)
            }
            assert(listing.as_str() == served.as_str(), release)
        }
        assert(
            kept_file("console-host", release, "index.html") ==
                Some(String::from(f"{release} page")),
        )
        assert(kept_file("game-host", release, "session/game.wasm") == Some(String::from(release)))
        assert(
            kept_file("game-host", release, "session/files/floor/t1_-1.bin") ==
                Some(String::from("tile")),
            release,
        )
    }
    assert(
        !there(staged(A).as_str()) && !there(f"scratch/game-host/releases/{A}"),
        "A, past its window",
    )
    assert(!there(staged("new").as_str()), "the new release's files are in the release already")
    assert(kept_file("game-host", B, "session/same.txt") == Some(String::from("new")), "copied")
    let Some(t) = read("scratch/console-host/deploys.json") else { panic("no deploys.json") }
    assert(t.as_str() == history_json(after).as_str(), t.as_str())
    assert(releases(after).as_str() == "bcd")
    assert(!there("scratch/npx.log"), "a dry run deploys nothing")
}

/// The fake clock's seconds now.
fn clock() -> u64 {
    let Ok(t) = time::utc_now().wait() else { panic("the fake clock") }
    t.seconds
}

/// A kept file that doesn't match, doesn't arrive or leaves its release stops the deploy, and
/// no history is written: how many seconds of the fake clock the deploy took (its retries'
/// waits).
fn spoiled(why: str, fake: take Option<Fake>, files: take Vec<(String, Vec<u8>)>) -> u64 {
    set_up(site(docs: false, docs_first: false))
    if let Some(f) = take fake {
        faked(f"https://game.example/releases/{C}/session/game.wasm", take f)
    }
    set_up(take files)
    let started = clock()
    failed(deploy(options(dry_run: true)), why)
    assert(!there("scratch/console-host/deploys.json"), "a deploys.json was written")
    clock() - started
}

/// A mismatch is a definite answer: the deploy stops at once, with no retry.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_file_that_does_not_match_stops_the_deploy() {
    let waited = spoiled(
        "doesn't match its SHA-256",
        Some(Fake::Bytes(Vec::from(String::from("tampered").as_bytes()))),
        Vec::new(),
    )
    assert(waited == 0, "a mismatch is not retried")
}

/// A 404 is a definite answer too: no retry.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_file_that_does_not_arrive_stops_the_deploy() {
    let waited = spoiled("HTTP 404", Some(Fake::Missing), Vec::new())
    assert(waited == 0, "a 404 is not retried")
}

/// A file whose fetch keeps failing in transport, or whose origin keeps answering 500 or 503, is
/// tried 5 times, the waits between 15 s in all, and then stops the deploy, saying so.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_file_that_keeps_failing_stops_the_deploy_after_its_retries() {
    for k in 0..3 {
        // The statuses first: a fake's failures in transport come before its status.
        let (why, fake) = if k == 0 {
            ("HTTP 503, 5 tries", Fake::Status(503))
        } else if k == 1 {
            ("HTTP 500, 5 tries", Fake::Status(500))
        } else {
            ("connection reset (a fake site's failure) (5 tries)", Fake::Fail(100))
        }
        let waited = spoiled(why, Some(take fake), Vec::new())
        assert(waited == 15, why)
    }
}

/// A file whose fetch fails in transport twice, then answers, is kept: the deploy goes on.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_file_that_fails_in_transport_then_answers_is_kept() {
    set_up(site(docs: false, docs_first: false))
    faked(f"https://game.example/releases/{C}/session/game.wasm", Fake::Fail(2))
    if let Err(e) = deploy(options(dry_run: true)) {
        panic(e.message())
    }
    let Some(t) = read(staged(C).as_str()) else { panic("the kept file") }
    assert(t.as_str() == C, t.as_str())
}

/// The 16 files of a batch (`AT_ONCE`), as kept release C serves them on the game's site.
const BATCH: [Text; 16] = [
    "f00.bin",
    "f01.bin",
    "f02.bin",
    "f03.bin",
    "f04.bin",
    "f05.bin",
    "f06.bin",
    "f07.bin",
    "f08.bin",
    "f09.bin",
    "f10.bin",
    "f11.bin",
    "f12.bin",
    "f13.bin",
    "f14.bin",
    "f15.bin",
]

/// A batch whose 16 files each fail in transport 1 to 4 times, and with `lasting` two of them
/// (f05 and f09) answering 503 for good: the retries of every file wait together, whatever the
/// helpers, so the deploy waits one schedule (1 + 2 + 4 + 8 s), not one a file or a wave. With
/// no lasting 503 the deploy keeps every file; with them it stops at the first in the batch's
/// order, after its 5 tries. The fake clock's seconds the deploy took.
fn batch_retried(lasting: bool) -> u64 {
    var files = site(docs: false, docs_first: false)
    var served: Vec<(Text, String)> = Vec::new()
    for name in BATCH {
        served.push((name, String::from(f"body of {name}")))
    }
    // The batch is all the deploy fetches: the other kept releases list nothing.
    let none: [(Text, String); 0] = []
    serve(mut files, "console.example", B, none)
    serve(mut files, "console.example", C, none)
    serve(mut files, "game.example", B, none)
    serve(mut files, "game.example", C, served)
    // What an earlier deploy of this test wrote.
    let _ = files::remove_all("scratch/stored").wait()
    let _ = files::remove("scratch/console-host/deploys.json").wait()
    set_up(take files)
    for k in 0..BATCH.len() {
        let url = String::from(f"https://game.example/releases/{C}/{BATCH[k]}")
        if lasting && (k == 5 || k == 9) {
            faked(url.as_str(), Fake::Status(503))
        } else {
            faked(url.as_str(), Fake::Fail(1 + k % 4))
        }
    }
    let started = clock()
    let r = deploy(options(dry_run: true))
    let waited = clock() - started
    if lasting {
        failed(r, f"GET https://game.example/releases/{C}/f05.bin: HTTP 503, 5 tries")
        assert(!there("scratch/console-host/deploys.json"), "a deploys.json was written")
    } else {
        if let Err(e) = r {
            panic(e.message())
        }
        for name in BATCH {
            let body = String::from(f"body of {name}")
            let Some(t) = read(staged(body.as_str()).as_str()) else { panic(name) }
            assert(t.as_str() == body.as_str(), name)
        }
    }
    waited
}

/// With no helpers, a batch's retries still wait together: one schedule.
@test(tool, net: ["console.example", "game.example"], budget: 60, workers: 0)
fn a_batch_s_retries_wait_together_with_no_helpers() {
    for lasting in [false, true] {
        let waited = batch_retried(lasting)
        assert(waited == 15, f"{waited} s")
    }
}

/// With three helpers (a 4-core runner's), the same: one schedule, not waves.
@test(tool, net: ["console.example", "game.example"], budget: 60, workers: 3)
fn a_batch_s_retries_wait_together_with_three_helpers() {
    for lasting in [false, true] {
        let waited = batch_retried(lasting)
        assert(waited == 15, f"{waited} s")
    }
}

@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_file_that_leaves_its_release_stops_the_deploy() {
    var escape: Vec<(String, Vec<u8>)> = Vec::new()
    // Its listing alone: no file can be at a path that leaves the site.
    let listing = Json::Obj(
        Vec::from([member("../../escape", text(hex_sha(String::from("x").as_bytes()).as_str()))]),
    )
    put(mut escape, f"sites/game.example/releases/{C}/files.json", compact(listing).as_str())
    let _ = spoiled("invalid path", None, take escape)
}

/// The docs keep each kept release they served, and none they never served (404); but a game's
/// missing release stops the deploy, and so does a docs failure that isn't a 404.
@test(tool, net: ["console.example", "game.example", "docs.example"], budget: 60)
fn the_docs_keep_what_they_served_and_skip_what_they_never_did() {
    var files = site(docs: true, docs_first: false)
    // The docs served C, and never B.
    serve(mut files, "docs.example", C, [("index.html", String::from("docs"))])
    set_up(take files)
    if let Err(e) = deploy(options(dry_run: true)) {
        panic(e.message())
    }
    assert(kept_file("docs-host", C, "index.html") == Some(String::from("docs")), "the docs' C")
    assert(!there(f"scratch/docs-host/releases/{B}"), "the docs' B")
    // A docs failure that isn't a 404 stops it.
    faked(f"https://docs.example/releases/{B}/files.json", Fake::Status(503))
    failed(deploy(options(dry_run: true)), "HTTP 503")
    // A game's missing release stops it.
    faked(f"https://docs.example/releases/{B}/files.json", Fake::Clear)
    faked(f"https://game.example/releases/{B}/files.json", Fake::Missing)
    failed(deploy(options(dry_run: true)), "HTTP 404")
}

/// A Worker over its file limit fails the deploy; the limit counts the history the console
/// serves and the releases each Worker keeps.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn the_file_limit_includes_the_history_and_the_kept_releases() {
    set_up(site(docs: false, docs_first: false))
    // The console has its release's two files, deploys.json and two files of each of the two
    // releases it keeps: 7. The game has its release's two files and three of each kept: 8.
    var o = options(dry_run: true)
    o.limits = Limits { most_files: 7, largest: CLOUDFLARE.largest }
    failed(deploy(o), "file-count")
    o.limits = Limits { most_files: 8, largest: CLOUDFLARE.largest }
    if let Err(e) = deploy(o) {
        panic(e.message())
    }
}

/// A deploy whose commit is no longer main's head runs no Wrangler.
@test(
    tool,
    net: ["console.example", "game.example", "github.com"],
    run: [("npx", "fakes/npx")],
    budget: 120,
)
fn a_deploy_no_longer_at_main_s_head_changes_nothing() {
    set_up(site(docs: false, docs_first: false))
    faked(REFS, Fake::Bytes(advertised("1111111111111111111111111111111111111111")))
    failed(deploy(options(dry_run: false)), "no longer the head of main")
    assert(!there("scratch/npx.log"), "wrangler ran")
}

/// The console's server deploys first, then the games, the console and the docs after it, through
/// the pinned Wrangler; each Worker then serves the release and its kept ones as its assets, and
/// none past its window, and the console lists the release live.
@test(
    tool,
    net: ["console.example", "game.example", "docs.example", "github.com"],
    run: [("npx", "fakes/npx")],
    budget: 300,
)
fn the_server_and_games_deploy_before_the_console_the_docs_after_and_each_serves_its_releases() {
    // The docs, listed first, still go last: a failure there leaves the console live.
    var files = site(docs: true, docs_first: true)
    // A, past its window, is still on the game's live site.
    serve(mut files, "game.example", A, [("session/game.wasm", String::from(A))])
    set_up(take files)
    faked(REFS, Fake::Bytes(advertised(SOURCE)))
    faked(f"https://console.example{main::API_PROBE}", Fake::Status(403))
    let after = match deploy(options(dry_run: false)) {
        Ok(a) => take a,
        Err(e) => panic(e.message()),
    }
    let Some(log) = read("scratch/npx.log") else { panic("wrangler never ran") }
    assert(log.as_str() == "api-host\ngame-host\nconsole-host\ndocs-host\n", log.as_str())
    for (domain, release) in [
        ("console.example", B),
        ("game.example", B),
        ("console.example", C),
        ("game.example", C),
        ("console.example", D),
        ("game.example", D),
        ("docs.example", D),
    ] {
        assert(there(f"scratch/sites/{domain}/releases/{release}/files.json"), domain)
    }
    let Some(t) = read(f"scratch/sites/game.example/releases/{B}/session/game.wasm") else {
        panic("B's game")
    }
    assert(t.as_str() == B, t.as_str())
    // The docs never served B or C, and nothing serves A now.
    assert(!there(f"scratch/sites/docs.example/releases/{B}"), "the docs' B")
    assert(!there(f"scratch/sites/game.example/releases/{A}"), "A, past its window")
    assert(releases(after).as_str() == "bcd")
}

fn listed_release() -> Release {
    Release {
        source: String::from("head"),
        release: String::from(D),
        api: String::from("api-host"),
        workers: Vec::from(
            [
                worker("console-host", console: true, docs: false),
                worker("game-host", console: false, docs: false),
            ],
        ),
    }
}

/// A Worker that doesn't serve the release, once deployed, fails the deploy.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_worker_that_does_not_serve_the_release_fails_the_deploy() {
    var files = site(docs: false, docs_first: false)
    put(mut files, f"console-host/releases/{D}/files.json", "{}")
    put(mut files, f"game-host/releases/{D}/files.json", "{}")
    set_up(take files)
    match verify(listed_release(), "scratch") {
        Ok(_) => panic("verified"),
        Err(e) => assert(contains(e.message(), "doesn't serve"), e.message()),
    }
}

/// API paths that don't reach the console's server once it's deployed (the console's assets answer
/// them: 404 or 405) fail the deploy; its router's 403 to a `POST` from no origin passes it.
@test(tool, net: ["console.example"], budget: 60)
fn api_paths_that_do_not_reach_the_server_fail_the_deploy() {
    match verify_api("console.example") {
        Ok(_) => panic("verified"),
        Err(e) => assert(contains(e.message(), "doesn't reach the console's server"), e.message()),
    }
    faked(f"https://console.example{main::API_PROBE}", Fake::Status(403))
    if let Err(e) = verify_api("console.example") {
        panic(e.message())
    }
}

/// A Worker that doesn't serve a kept release as its listing was, once deployed, fails it too.
@test(tool, net: ["console.example", "game.example"], budget: 60)
fn a_worker_that_does_not_serve_a_kept_release_fails_the_deploy() {
    set_up(site(docs: false, docs_first: false))
    let game = worker("game-host", console: false, docs: false)
    let served = listing_of(
        [
            ("session/game.wasm", String::from(B)),
            ("session/files/floor/t1_-1.bin", String::from("tile")),
        ],
    )
    var l = Listing {
        worker: Worker {
            worker: game.worker.clone(),
            domain: String::from("game.example"),
            console: false,
            docs: false,
        },
        release: String::from(B),
        files: Vec::new(),
        body: Vec::from(served.as_bytes()),
    }
    if let Err(e) = verify_kept([l.clone()]) {
        panic(e.message())
    }
    l.body = Vec::from(String::from("{}").as_bytes())
    match verify_kept([take l]) {
        Ok(_) => panic("verified"),
        Err(e) => assert(contains(e.message(), "doesn't serve kept release"), e.message()),
    }
}

/// The workspace grants the deploy tool the catalog's domains and GitHub alone, the pinned
/// `npx`, and Cloudflare's secrets: a domain that the catalog gains is a grant to add.
@test(tool, read: [("ws", "../..")], budget: 30)
fn the_deploy_tool_is_granted_the_catalogs_domains() {
    let Some(manifest) = read("ws/wrela.toml") else { panic("no wrela.toml") }
    let Some(at) = manifest.find("[tools.deploy]") else { panic("no [tools.deploy]") }
    let section = manifest.slice(at, manifest.len())
    let Some(net_at) = section.find("\nnet = [") else { panic("no net") }
    let net = section.slice(net_at, section.len())
    let Some(end) = net.find("]") else { panic("net isn't closed") }
    let hosts = net.slice(0, end)
    var want: Vec<String> = Vec::from(
        [String::from(CATALOG.console.domain), String::from(CATALOG.docs.domain)],
    )
    for g in CATALOG.games {
        want.push(String::from(g.domain))
    }
    want.push(String::from("github.com"))
    var count = 0
    for _ in hosts.split("\"") {
        count += 1
    }
    // Each host quoted once: two quotes a host, and the text around them.
    assert(count == 2 * want.len() + 1, hosts)
    for h in want {
        assert(contains(hosts, f"\"{h.as_str()}\""), h.as_str())
    }
    assert(contains(section, "\nrun = [\"npx\"]"), "npx")
    assert(
        contains(section, "\nsecrets = [\"CLOUDFLARE_API_TOKEN\", \"CLOUDFLARE_ACCOUNT_ID\"]"),
        "secrets",
    )
}
