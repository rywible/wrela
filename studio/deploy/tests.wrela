/// The games deploy before the console and the docs after it, through the pinned Wrangler, and
/// each Worker then serves the release, and the console lists it live.
@test(
    tool,
    net: ["console.example", "game.example", "docs.example", "github.com"],
    run: [("npx", "fakes/npx")],
    budget: 300,
)
@job
fn the_games_deploy_before_the_console_the_docs_after_and_each_serves_the_release() {
    // The docs, listed first, still go last: a failure there leaves the console live.
    var files = site(docs: true, docs_first: true)
    for w in ["console-host", "game-host", "docs-host"] {
        let listing = Json::Obj(
            Vec::from(
                [member("index.html", text(hex_sha(String::from("new").as_bytes()).as_str()))],
            ),
        )
        put(mut files, f"{w}/releases/{D}/files.json", compact(listing).as_str())
    }
    var s = Box::new(set_up.start(take files))
    loop {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var f = Box::new(faked.start(String::from(REFS), Fake::Bytes(advertised(SOURCE))))
    loop {
        match f.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var j = Box::new(deployed.start(options(dry_run: false)))
    loop {
        match j.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                if let Err(e) = take r {
                    panic(e.as_str())
                }
                break
            },
        }
    }
    var r = Box::new(read.start(String::from("scratch/npx.log")))
    loop {
        match r.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(got) => {
                let Some(log) = take got else { panic("wrangler never ran") }
                assert(log.as_str() == "game-host\nconsole-host\ndocs-host\n", log.as_str())
                break
            },
        }
    }
}

/// A Worker that doesn't serve the release, once deployed, fails the deploy.
@test(tool, net: ["console.example", "game.example"], budget: 60)
@job
fn a_worker_that_does_not_serve_the_release_fails_the_deploy() {
    var files = site(docs: false, docs_first: false)
    put(mut files, f"console-host/releases/{D}/files.json", "{}")
    put(mut files, f"game-host/releases/{D}/files.json", "{}")
    var s = Box::new(set_up.start(take files))
    loop {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    let rel = Release {
        source: String::from("head"),
        release: String::from(D),
        workers: Vec::from(
            [
                worker("console-host", console: true, docs: false),
                worker("game-host", console: false, docs: false),
            ],
        ),
    }
    var j = Box::new(verify.start(take rel, String::from("scratch")))
    loop {
        match j.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                match take r {
                    Ok(_) => panic("verified"),
                    Err(e) => assert(contains(e.as_str(), "doesn't serve"), e.as_str()),
                }
                break
            },
        }
    }
}

/// The workspace grants the deploy tool the catalog's domains and GitHub alone, the pinned
/// `npx`, and Cloudflare's secrets: a domain that the catalog gains is a grant to add.
@test(tool, read: [("ws", "../..")], budget: 30)
@job
fn the_deploy_tool_is_granted_the_catalogs_domains() {
    var r = Box::new(read.start(String::from("ws/wrela.toml")))
    var manifest = String::new()
    loop {
        match r.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(got) => {
                let Some(t) = take got else { panic("no wrela.toml") }
                manifest = take t
                break
            },
        }
    }
    let Some(at) = manifest.find("[tools.deploy]") else { panic("no [tools.deploy]") }
    let section = manifest.slice(at, manifest.len())
    let Some(net_at) = section.find("\nnet = [") else { panic("no net") }
    let net = section.slice(net_at, section.len())
    let Some(end) = net.find("]") else { panic("net isn't closed") }
    let hosts = net.slice(0, end)
    var want: Vec<String> = Vec::from(
        [String::from(CATALOG.console.domain), String::from(CATALOG.docs.domain)],
    )
    for g in CATALOG.games {
        want.push(String::from(g.domain))
    }
    want.push(String::from("github.com"))
    var count = 0
    for _ in hosts.split("\"") {
        count += 1
    }
    // Each host quoted once: two quotes a host, and the text around them.
    assert(count == 2 * want.len() + 1, hosts)
    for h in want {
        assert(contains(hosts, f"\"{h.as_str()}\""), h.as_str())
    }
    assert(contains(section, "\nrun = [\"npx\"]"), "npx")
    assert(
        contains(section, "\nsecrets = [\"CLOUDFLARE_API_TOKEN\", \"CLOUDFLARE_ACCOUNT_ID\"]"),
        "secrets",
    )
}
