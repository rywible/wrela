}

/// The docs keep no release they never served (404), but a game's missing release still stops
/// the deploy, and so does a docs failure that isn't one.
@test(tool, net: ["console.example", "game.example", "docs.example"], budget: 60)
@job
fn a_kept_release_the_docs_never_served_is_skipped_but_a_game_s_is_not() {
    var files = site(docs: true, docs_first: false)
    // The docs served C, and never B.
    serve(mut files, "docs.example", C, [("index.html", String::from("docs"))])
    var s = Box::new(set_up.start(take files))
    loop {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var j = Box::new(deployed.start(options(dry_run: true)))
    loop {
        match j.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                if let Err(e) = take r {
                    panic(e.as_str())
                }
                break
            },
        }
    }
    let checks = [
        (String::from(f"scratch/docs-host/releases/{B}"), false),
        (String::from(f"scratch/docs-host/releases/{C}/index.html"), true),
        (String::from(f"scratch/game-host/releases/{B}/session/game.wasm"), true),
    ]
    for k in 0..3 {
        var t = Box::new(there.start(checks[k].0.clone()))
        loop {
            match t.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(is) => {
                    assert(is == checks[k].1, checks[k].0.as_str())
                    break
                },
            }
        }
    }
    // A docs failure that isn't a 404 stops it.
    var f = Box::new(
        faked.start(
            String::from(f"https://docs.example/releases/{B}/files.json"),
            Fake::Status(503),
        ),
    )
    loop {
        match f.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var j2 = Box::new(deployed.start(options(dry_run: true)))
    loop {
        match j2.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                failed(take r, "HTTP 503")
                break
            },
        }
    }
    // A game's missing release stops it.
    var c = Box::new(
        faked.start(String::from(f"https://docs.example/releases/{B}/files.json"), Fake::Clear),
    )
    loop {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var m = Box::new(
        faked.start(String::from(f"https://game.example/releases/{B}/files.json"), Fake::Missing),
    )
    loop {
        match m.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var j3 = Box::new(deployed.start(options(dry_run: true)))
    loop {
        match j3.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                failed(take r, "HTTP 404")
                break
            },
        }
    }
}

