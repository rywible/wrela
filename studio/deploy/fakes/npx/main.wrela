// A fake `npx` for the deploy tool's tests: `npx --yes wrangler@4.151.0 <command>`, run in the
// write root `scratch`, does as Wrangler would to fake sites, `scratch/sites/<domain>/`:
// `deploy --config <worker>.wrangler.json` "deploys" the Worker. A Worker of static assets, on its
// custom domain, has no script (release_tool::site::wrangler_config): its site becomes its
// assets directory. A Worker of a script alone (the console's server) has routes in a zone and no
// assets, and changes no site. Either adds the Worker's name to `scratch/npx.log` (a line each, in
// the order they ran) and prints what it uploaded. `r2 object put <bucket>/<key> --file <path>
// --remote` puts the file at `scratch/r2/<bucket>/<key>` and adds `r2 <bucket>/<key>` to the log.
// Any other command, or a configuration of assets and a script, exits 2 or more.

use release_tool::io::{copy_files, read_files, walk, write_files}
use std::io::print
use std::json::{Doc, TOP, parse}
use std::tool::args
use std::tool::files

/// The write root the deploy runs it in.
const ROOT: Text = "scratch"

pub fn tool() -> u32 {
    let a = args()
    if a.len() < 3 || a[0].as_str() != "--yes" || a[1].as_str() != "wrangler@4.151.0" {
        return usage()
    }
    let put = a.len() == 9 &&
        a[2].as_str() == "r2" &&
        a[3].as_str() == "object" &&
        a[4].as_str() == "put" &&
        a[6].as_str() == "--file" &&
        a[8].as_str() == "--remote"
    if put {
        // An object of the bucket: the file, copied where the bucket keeps it.
        let from = String::from(f"{ROOT}/{a[7].as_str()}")
        let to = String::from(f"{ROOT}/r2/{a[5].as_str()}")
        if copy_files(Vec::from([(take from, take to)])).is_err() {
            return 3
        }
        return logged(String::from(f"r2 {a[5].as_str()}"))
    }
    let deploy = a.len() == 5 &&
        a[2].as_str() == "deploy" &&
        a[3].as_str() == "--config" &&
        a[4].as_str().ends_with(".wrangler.json")
    if !deploy {
        return usage()
    }
    let Ok(all) = read_files(Vec::from([String::from(f"{ROOT}/{a[4].as_str()}")])) else {
        return 3
    }
    let Some(config) = String::from_utf8(all[0].clone()) else { return 3 }
    let Some(d) = parse(config.as_str()) else { return 4 }
    let Some(name) = d.get(TOP, "name") else { return 4 }
    let Some(worker) = d.text(name) else { return 4 }
    let Some(routes) = d.get(TOP, "routes") else { return 4 }
    let Some(route) = d.at(routes, 0) else { return 4 }
    let Some(pattern) = d.get(route, "pattern") else { return 4 }
    let Some(domain) = d.text(pattern) else { return 4 }
    let uploaded = match d.get(TOP, "assets") {
        Some(assets) => {
            // A script beside assets would run for every request no asset matches.
            if d.get(TOP, "main").is_some() {
                return 8
            }
            let Some(dir) = d.get(assets, "directory") else { return 4 }
            let Some(directory) = d.text(dir) else { return 4 }
            if directory.as_str() != f"./{worker.as_str()}" || !custom_domain(d, route) {
                return 4
            }
            // The site is the assets alone.
            let site = String::from(f"{ROOT}/sites/{domain.as_str()}")
            let _ = files::remove_all(site.as_str()).wait()
            let from = String::from(f"{ROOT}/{worker.as_str()}")
            let Ok(paths) = walk(from.as_str()) else { return 5 }
            var pairs: Vec<(String, String)> = Vec::new()
            for p in paths {
                pairs.push(
                    (
                        String::from(f"{from.as_str()}/{p.as_str()}"),
                        String::from(f"{site.as_str()}/{p.as_str()}"),
                    ),
                )
            }
            if copy_files(pairs).is_err() {
                return 6
            }
            paths.len()
        },
        None => {
            // A script alone, on routes of a zone.
            if d.get(TOP, "main").is_none() || custom_domain(d, route) {
                return 4
            }
            if d.get(route, "zone_name").is_none() {
                return 4
            }
            1
        },
    }
    let wrote = logged(worker.clone())
    if wrote != 0 {
        return wrote
    }
    print(f"Uploaded {uploaded} files of {worker.as_str()} to {domain.as_str()}")
    0
}

/// The log, a line added (`line`): it isn't there before the first run.
fn logged(line: String) -> u32 {
    let log = String::from(f"{ROOT}/npx.log")
    var lines: Vec<u8> = Vec::new()
    if let Ok(all) = read_files(Vec::from([log.clone()])) {
        lines = all[0].clone()
    }
    for b in line.as_bytes() {
        lines.push(b)
    }
    lines.push(10)
    if write_files(Vec::from([(take log, take lines)])).is_err() {
        return 7
    }
    0
}

/// Whether `route` (a node of `d`) is a custom domain.
fn custom_domain(d: Doc, route: u32) -> bool {
    match d.get(route, "custom_domain") {
        Some(c) => d.is_true(c),
        None => false,
    }
}

fn usage() -> u32 {
    print("usage: npx --yes wrangler@4.151.0 deploy --config <worker>.wrangler.json")
    2
}
