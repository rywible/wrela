// Export actual AMD-decoded conventional/neural representations from one authored
// crown, plus packed blocks and model bytes for independent CPU checks.
use std::io::print
use std::tool::{ToolError, args, drive, files, time, toolchain}
use std::tool::drive::{Scalar, Step}
use toolkit::driven::untrapped
use toolkit::whole::{chunked, data_bytes, joined, write_file}

fn capture(b: drive::Build, directory: str, seed: u32) -> Result<(), ToolError> {
    let _ = untrapped("init", drive::steps(b, [Step::Init], timeout: 600.0).wait()?)?
    let _ = untrapped(
        "generate",
        drive::steps(
            b,
            [
                Step::Call(String::from("generate"), Vec::from([Scalar::I32(i32(seed))])),
            ],
            timeout: 600.0,
        ).wait()?,
    )?
    let names = [
        "bake.f32",
        "bc.f32",
        "legacy.f32",
        "colour.bc7",
        "normal.bc5",
        "depth.bc5",
        "legacy.half",
    ]
    for mode in 0..7 {
        let saw = untrapped(
            "publish",
            drive::steps(
                b,
                [
                    Step::Call(String::from("publish"), Vec::from([Scalar::I32(i32(mode))])),
                ],
                timeout: 600.0,
            ).wait()?,
        )?
        let expected = match saw.ran[0].results[0] {
            Scalar::I32(n) => u32(n),
            _ => return Err(ToolError::new("publish did not return a byte count")),
        }
        let ids = untrapped("buffers", drive::steps(b, [Step::Buffers]).wait()?)?
        borrow buffers = ids.buffers[0]
        let id = buffers[buffers.len() - 1]
        var read = untrapped(
            "representation",
            drive::steps(b, [Step::ReadBuffer(id)], timeout: 600.0).wait()?,
        )?
        let bytes = joined(data_bytes(read.bytes.remove(0))?)
        if bytes.len() != expected { return Err(ToolError::new("wrong representation byte count")) }
        if mode <= 2 {
            for k in 0..bytes.len() / 4 {
                let word = u32(bytes[k * 4]) |
                    (u32(bytes[k * 4 + 1]) << 8) |
                    (u32(bytes[k * 4 + 2]) << 16) |
                    (u32(bytes[k * 4 + 3]) << 24)
                if (word & 0x7f800000) == 0x7f800000 {
                    return Err(ToolError::new("non-finite representation"))
                }
            }
        }
        write_file(f"{directory}/{names[mode]}", chunked(take bytes))?
        print(f"appearance: exported {names[mode]} ({expected} bytes)")
    }
    let metadata = f"asset=great_tree\nseed={seed}\natlas_width=1024\natlas_height=1024\nviews=16x16\ncell=64\nlayout=atlas_row_major_8_f32_le\nchannels=sqrt_albedo_rgb,coverage,oct_normal_xy,toward,depth\nreference=existing_uncompressed_bake_not_converged_source_truth\nbc=existing_mode6_bc7_plus_two_bc5_not_exhaustive_best_encoder\nlegacy=model_from_content_kit_great_tree_net\nlegacy_train_views=all_except_view_mod_16_eq_15\nlegacy_train_seed=7\ntrack=public_asset_specialization_diagnostic_not_G4_or_G7_acceptance\n"
    let _ = files::write(f"{directory}/capture.txt", metadata.as_bytes()).wait()?
    Ok(())
}

fn probe(b: drive::Build, directory: str) -> Result<(), ToolError> {
    let _ = untrapped("init", drive::steps(b, [Step::Init]).wait()?)?
    let _ = untrapped(
        "bc probe",
        drive::steps(b, [
            Step::Call(String::from("bc_probe"), Vec::new()),
        ], timeout: 600.0).wait()?,
    )?
    let ids = untrapped("buffers", drive::steps(b, [Step::Buffers]).wait()?)?
    borrow buffers = ids.buffers[0]
    let id = buffers[buffers.len() - 1]
    var read = untrapped("probe read", drive::steps(b, [Step::ReadBuffer(id)]).wait()?)?
    let bytes = joined(data_bytes(read.bytes.remove(0))?)
    if bytes.len() != 1024 * 1024 * 16 { return Err(ToolError::new("wrong probe byte count")) }
    write_file(f"{directory}/bc-probe.f32", chunked(take bytes))?
    Ok(())
}

fn capture_geometry(
    b: drive::Build,
    directory: str,
    seed: u32,
    primitives: bool,
) -> Result<(), ToolError> {
    let _ = untrapped("init", drive::steps(b, [Step::Init]).wait()?)?
    let names = [
        "geometry.f32",
        "cards.f32",
        "volume.f32",
        "centres.f32",
        "volume-raw.f32",
        "card-info.f32",
        "wood-gpu.f32",
        "wood-cpu.f32",
        "pattern-texels.f32",
        "pattern128.f32",
        "pattern256.f32",
        "pattern512.f32",
    ]
    let count = if primitives { 12 } else { 5 }
    for mode in 0..count {
        if primitives && (mode == 2 || mode == 4) { continue }
        let saw = untrapped(
            "geometry",
            drive::steps(
                b,
                [
                    Step::Call(
                        String::from("geometry_export"),
                        Vec::from([Scalar::I32(i32(seed)), Scalar::I32(i32(mode))]),
                    ),
                ],
                timeout: 600.0,
            ).wait()?,
        )?
        let expected = match saw.ran[0].results[0] {
            Scalar::I32(n) => u32(n),
            _ => return Err(ToolError::new("geometry export did not return bytes")),
        }
        let ids = untrapped("geometry buffers", drive::steps(b, [Step::Buffers]).wait()?)?
        borrow buffers = ids.buffers[0]
        var read = untrapped(
            "geometry read",
            drive::steps(b, [Step::ReadBuffer(buffers[buffers.len() - 1])]).wait()?,
        )?
        let bytes = joined(data_bytes(read.bytes.remove(0))?)
        if bytes.len() != expected { return Err(ToolError::new("wrong geometry byte count")) }
        write_file(f"{directory}/{names[mode]}", chunked(take bytes))?
    }
    let metadata = f"asset=great_tree\nseed={seed}\ngeometry=vec4_f32_le;header6_then_clump2_then_limb4\nheader=mid_xyz_half;clumps_limbs_cards_cover;young_rgb_card_size;old_rgb_leaves_per_card;bark_dark_rgb_blend;bark_light_rgb_volume_size\nclump=centre_xyz_radius;squash_zero_zero_zero\nlimb=controlpoint_xyz_radius_times4\ncards=12_f32_le;centre_xyz_width;normal_xyz_crown_depth;unquantized_albedo_rgb_pattern_cover8x8\nvolume=24cubed;z_y_x;8_f32_le;density_normalXYZ;depth_times_density_zero_zero_zero;actual_f16_storage_expanded\ncentres=CPU_card_centres_vec4_f32_le\nvolume_raw=same_volume_equation_in_f32_buffer_for_independent_precision_audit\nvolume_scope=existing_leaf_only_density_no_limbs_not_source_truth\n"
    let _ = files::write(f"{directory}/geometry.txt", metadata.as_bytes()).wait()?
    if primitives {
        let detail = String::from(
            "mode=source_primitives_not_image_truth\ncard_info=4_f32_le;turn_cos_sin,pattern_index,zero\nwood=limb_major_triangle_vertex_order;8_f32_le;position_xyz_U;normal_xyz_V\nwood_vertices_per_limb=1008\npatterns=16;texels=512x512_rgba_f32_from_actual_rgba8;tiles4x4_each128\npattern_samples=pattern_y_x;4_f32_le;filtered_red,leaf_index,hard_cut,zero\npattern_grids=128,256,512;midpoints_in_card_local_minus1_to1;hard_cut=red_greater_equal_half_and_leaf_index_below6\nvolume_exports=omitted_for_primitive_mode\n",
        )
        let _ = files::write(f"{directory}/primitives.txt", detail.as_bytes()).wait()?
    }
    Ok(())
}

struct SourceConfig: Copy {
    enabled: bool = false,
    geometry: bool = false,
    response: bool = false,
    runtime: bool = false,
    joint: bool = false,
    shaded: bool = false,
    illumination: u32 = 0,
    detailed: u32 = 1,
    primitives: bool = false,
    batch: bool = false,
    compress: bool = false,
    first: u32 = 0,
    count: u32 = 1,
    part: u32 = 0,
    probe: bool = false,
    px: u32 = 0,
    py: u32 = 0,
    gx: f32 = 0.0,
    gy: f32 = 0.0,
    size: u32 = 64,
    level: u32 = 0,
    grid: u32 = 1,
}

fn capture_source(
    b: drive::Build,
    directory: str,
    seed: u32,
    c: SourceConfig,
    initialize: bool,
) -> Result<(), ToolError> {
    if initialize { let _ = untrapped("init", drive::steps(b, [Step::Init]).wait()?)? }
    var parameters = Vec::from(
        [
            Scalar::I32(i32(seed)),
            Scalar::F32(c.gx),
            Scalar::F32(c.gy),
            Scalar::I32(i32(c.size)),
            Scalar::I32(i32(c.level)),
            Scalar::I32(i32(c.grid)),
        ],
    )
    let entry = if c.part == 0 { "source_capture" } else { "source_layer_capture" }
    if c.part != 0 { parameters.push(Scalar::I32(i32(c.part))) }
    let saw = untrapped(
        "source",
        drive::steps(
            b,
            [Step::Call(String::from(entry), take parameters)],
            timeout: 600.0,
        ).wait()?,
    )?
    if c.part != 0 {
        let part = if c.part == 1 { "leaves" } else { "wood" }
        let metadata = f"part={part}\nscope=component_diagnostic_not_full_tree_reference\n"
        let _ = files::write(f"{directory}/source-part.txt", metadata.as_bytes()).wait()?
    }
    let expected = c.size * c.size * 48
    match saw.ran[0].results[0] {
        Scalar::I32(n) => if u32(n) != expected {
            return Err(ToolError::new("wrong source byte count"))
        },
        _ => return Err(ToolError::new("source did not return a byte count")),
    }
    let ids = untrapped("buffers", drive::steps(b, [Step::Buffers]).wait()?)?
    borrow buffers = ids.buffers[0]
    var read = untrapped(
        "source read",
        drive::steps(b, [
            Step::ReadBuffer(buffers[buffers.len() - 1]),
        ], timeout: 600.0).wait()?,
    )?
    let bytes = joined(data_bytes(read.bytes.remove(0))?)
    if bytes.len() != expected { return Err(ToolError::new("wrong source read size")) }
    for k in 0..bytes.len() / 4 {
        let word = u32(bytes[k * 4]) |
            (u32(bytes[k * 4 + 1]) << 8) |
            (u32(bytes[k * 4 + 2]) << 16) |
            (u32(bytes[k * 4 + 3]) << 24)
        if (word & 0x7f800000) == 0x7f800000 {
            return Err(ToolError::new("non-finite source moment"))
        }
    }
    write_file(f"{directory}/source.f32", chunked(take bytes))?
    let metadata = f"asset=great_tree\nseed={seed}\nview_grid_x={c.gx}\nview_grid_y={c.gy}\nsize={c.size}\ncard_level={c.level}\nspatial_grid={c.grid}\nlayout=row_major_12_f32_le\nchannels=linear_albedo_rgb_times_coverage,coverage,world_normal_xyz_times_coverage,normalized_toward_times_coverage,normalized_depth_times_coverage,reserved_zero_3\nspatial_sampling=regular_grid_pixel_centres_rendered_at_size_times_grid_then_box_averaged\naccumulation=nearest_Q20_ties_positive_infinity_exact_signed_two_word_sum_then_f32_mean\nreference=source_card_limb_material_diagnostic_not_full_production_lighting_or_G4_truth\nmaterial=existing_bake_hard_leaf_cut_crown_normal_flat_bark\nbounds=existing_bake_bounds_shared_between_card_levels\n"
    let _ = files::write(f"{directory}/capture.txt", metadata.as_bytes()).wait()?
    print(f"appearance: exported source.f32 ({expected} bytes)")
    if c.compress {
        let names = ["area-bc.f32", "area-colour.bc7", "area-geometry.bc7", "area-depth.bc5"]
        for mode in 0..4 {
            let _ = untrapped(
                "area compression",
                drive::steps(
                    b,
                    [
                        Step::Call(
                            String::from("source_compress"),
                            Vec::from([Scalar::I32(i32(mode))]),
                        ),
                    ],
                ).wait()?,
            )?
            let ids = untrapped("area buffers", drive::steps(b, [Step::Buffers]).wait()?)?
            borrow buffers = ids.buffers[0]
            var read = untrapped(
                "area readback",
                drive::steps(b, [
                    Step::ReadBuffer(buffers[buffers.len() - 1]),
                ]).wait()?,
            )?
            let bytes = joined(data_bytes(read.bytes.remove(0))?)
            let expected = c.size * c.size * if mode == 0 { 48 } else { 1 }
            if bytes.len() != expected {
                return Err(ToolError::new("wrong area compression byte count"))
            }
            write_file(f"{directory}/{names[mode]}", chunked(take bytes))?
        }
        let description = f"layout=area_independent_depth_v2\ncolour_bc7=sqrt_conditional_linear_albedo_times_coverage_rgb,coverage\ngeometry_bc7=conditional_mean_world_normal_xyz_mapped_to_0_1,one\ndepth_bc5=conditional_normalized_toward,conditional_normalized_crown_depth\ndecoded=source_12_f32_le_moment_layout\nnormal_decode=cap_length_at_one_without_unit_normalization\ncodec=existing_mode6_bc7_and_bc5_encoders\npayload=three_bytes_per_texel\n"
        let _ = files::write(f"{directory}/area-bc.txt", description.as_bytes()).wait()?
    }
    if c.probe {
        let _ = untrapped(
            "source pixel probe",
            drive::steps(
                b,
                [
                    Step::Call(
                        String::from("source_probe"),
                        Vec::from(
                            [
                                Scalar::I32(i32(c.px)),
                                Scalar::I32(i32(c.py)),
                                Scalar::I32(i32(c.grid)),
                            ],
                        ),
                    ),
                ],
            ).wait()?,
        )?
        let ids = untrapped("probe buffers", drive::steps(b, [Step::Buffers]).wait()?)?
        borrow buffers = ids.buffers[0]
        var read = untrapped(
            "pixel read",
            drive::steps(b, [
                Step::ReadBuffer(buffers[buffers.len() - 1]),
            ]).wait()?,
        )?
        let bytes = joined(data_bytes(read.bytes.remove(0))?)
        if bytes.len() != c.grid * c.grid * 48 {
            return Err(ToolError::new("wrong pixel probe size"))
        }
        write_file(f"{directory}/pixel.f32", chunked(take bytes))?
        let metadata = f"pixel_x={c.px}\npixel_y={c.py}\nspatial_grid={c.grid}\nlayout=sample_row_major_12_f32_le\naccumulation=none_unquantized_individual_samples\n"
        let _ = files::write(f"{directory}/pixel.txt", metadata.as_bytes()).wait()?
    }
    Ok(())
}

fn capture_views(
    b: drive::Build,
    directory: str,
    seed: u32,
    c: SourceConfig,
) -> Result<(), ToolError> {
    for offset in 0..c.count {
        let view = c.first + offset
        let sample = SourceConfig {
            gx: (f32(view % 16) + 0.5) / 16.0,
            gy: (f32(view / 16) + 0.5) / 16.0,
            ..c,
        }
        let destination = f"{directory}/view-{view}"
        let _ = files::make_dirs(destination.as_str()).wait()?
        capture_source(b, destination.as_str(), seed, sample, initialize: offset == 0)?
        print(f"appearance: completed source view {view}")
    }
    Ok(())
}

fn capture_shaded(
    b: drive::Build,
    directory: str,
    seed: u32,
    c: SourceConfig,
) -> Result<(), ToolError> {
    let _ = untrapped("init", drive::steps(b, [Step::Init]).wait()?)?
    let names = ["source-lit.f32", "averaged-lit.f32", "same-view-bc-lit.f32", "pixel-lit.f32"]
    for mode in 0..4 {
        let entry = if mode == 0 { "shaded_capture" } else if mode < 3 { "shaded_average" } else {
            "shaded_probe"
        }
        let parameters = if mode == 0 {
            Vec::from(
                [
                    Scalar::I32(i32(seed)),
                    Scalar::F32(c.gx),
                    Scalar::F32(c.gy),
                    Scalar::I32(i32(c.size)),
                    Scalar::I32(i32(c.grid)),
                    Scalar::I32(i32(c.illumination)),
                    Scalar::I32(i32(c.detailed)),
                ],
            )
        } else if mode < 3 {
            Vec::from(
                [
                    Scalar::F32(c.gx),
                    Scalar::F32(c.gy),
                    Scalar::I32(i32(c.illumination)),
                    Scalar::I32(i32(mode - 1)),
                ],
            )
        } else {
            Vec::from(
                [
                    Scalar::I32(i32(c.size / 2)),
                    Scalar::I32(i32(c.size * 3 / 8)),
                    Scalar::I32(i32(c.grid)),
                ],
            )
        }
        let saw = untrapped(
            "shaded source",
            drive::steps(
                b,
                [Step::Call(String::from(entry), take parameters)],
                timeout: 600.0,
            ).wait()?,
        )?
        let expected = if mode < 3 { c.size * c.size * 16 } else { c.grid * c.grid * 16 }
        match saw.ran[0].results[0] {
            Scalar::I32(n) => if u32(n) != expected {
                return Err(ToolError::new("wrong shaded bytes"))
            },
            _ => return Err(ToolError::new("shaded capture did not return bytes")),
        }
        let ids = untrapped("shaded buffers", drive::steps(b, [Step::Buffers]).wait()?)?
        borrow buffers = ids.buffers[0]
        var read = untrapped(
            "shaded read",
            drive::steps(b, [Step::ReadBuffer(buffers[buffers.len() - 1])], timeout: 600.0).wait()?,
        )?
        let bytes = joined(data_bytes(read.bytes.remove(0))?)
        if bytes.len() != expected { return Err(ToolError::new("wrong shaded read size")) }
        write_file(f"{directory}/{names[mode]}", chunked(take bytes))?
    }
    let metadata = f"asset=great_tree\nseed={seed}\ngx={c.gx}\ngy={c.gy}\nsize={c.size}\ngrid={c.grid}\nlight={c.illumination}\nleaf_tissue={c.detailed}\nprobe_x={c.size / 2}\nprobe_y={c.size * 3 / 8}\nlayout=row_major_linear_rgb_times_coverage_coverage_f32\nreference=source_visible_fragment_production_leaf_response_before_Q20_integration\nlimitations=static_hard_cut_geometry_flat_bark_analytic_sky_no_scene_shadows_wind_fog_or_full_G4\ncontrol=averaged_material_shading_and_same_view_BC_not_fixed_view_atlas\n"
    let _ = files::write(f"{directory}/shaded.txt", metadata.as_bytes()).wait()?
    Ok(())
}

fn runtime_word(values: [Scalar], i: u32) -> u32 {
    match values[i] {
        Scalar::I32(n) => u32(n),
        _ => panic("runtime returned a non-integer"),
    }
}

fn capture_runtime(
    b: drive::Build,
    directory: str,
    first: u32,
    count: u32,
) -> Result<(), ToolError> {
    let _ = untrapped("init", drive::steps(b, [Step::Init]).wait()?)?
    for view in first..first + count {
        for light in 0..4 {
            let _ = untrapped(
                "runtime configuration",
                drive::steps(
                    b,
                    [
                        Step::Call(
                            String::from("configure"),
                            Vec::from([Scalar::I32(i32(view)), Scalar::I32(i32(light))]),
                        ),
                    ],
                ).wait()?,
            )?
            let saw = untrapped(
                "runtime render",
                drive::steps(
                    b,
                    [Step::Call(String::from("publish"), Vec::new())],
                    timeout: 600.0,
                ).wait()?,
            )?
            if runtime_word(saw.ran[0].results, 0) != 65536 {
                return Err(ToolError::new("wrong runtime bytes"))
            }
            let ids = untrapped("runtime buffers", drive::steps(b, [Step::Buffers]).wait()?)?
            borrow buffers = ids.buffers[0]
            var read = untrapped(
                "runtime pixels",
                drive::steps(
                    b,
                    [Step::ReadBuffer(buffers[buffers.len() - 1])],
                    timeout: 600.0,
                ).wait()?,
            )?
            let bytes = joined(data_bytes(read.bytes.remove(0))?)
            if bytes.len() != 65536 { return Err(ToolError::new("wrong runtime read size")) }
            write_file(f"{directory}/runtime-v{view}-l{light}.f32", chunked(take bytes))?
            let got = untrapped(
                "resident",
                drive::steps(b, [Step::Call(String::from("resident"), Vec::new())]).wait()?,
            )?
            borrow values = got.ran[0].results
            let text = f"buffers={runtime_word(values, 0)}\ntextures={runtime_word(values, 1)}\npeak_buffers={runtime_word(values, 2)}\npeak_textures={runtime_word(values, 3)}\n"
            let _ = files::write(
                f"{directory}/runtime-v{view}-l{light}.memory.txt",
                text.as_bytes(),
            ).wait()?
        }
    }
    Ok(())
}

fn capture_response(b: drive::Build, directory: str) -> Result<(), ToolError> {
    let _ = untrapped("init", drive::steps(b, [Step::Init]).wait()?)?
    let _ = untrapped(
        "response probe",
        drive::steps(b, [Step::Call(String::from("response_probe"), Vec::new())]).wait()?,
    )?
    let ids = untrapped("response buffers", drive::steps(b, [Step::Buffers]).wait()?)?
    borrow buffers = ids.buffers[0]
    var read = untrapped(
        "response read",
        drive::steps(b, [Step::ReadBuffer(buffers[buffers.len() - 1])]).wait()?,
    )?
    let bytes = joined(data_bytes(read.bytes.remove(0))?)
    if bytes.len() != 4096 * 16 { return Err(ToolError::new("wrong response probe size")) }
    write_file(f"{directory}/response.f32", chunked(take bytes))?
    Ok(())
}

fn run(seed: u32, only_probe: bool, source: SourceConfig) -> Result<(), ToolError> {
    let now = time::utc_now().wait()?
    let directory = f"out/runs/{now.seconds}-{now.nanos}"
    if files::stat(directory.as_str()).wait().is_ok() { return Err(ToolError::new("run exists")) }
    print(f"appearance: writing {directory}")
    var opt = toolchain::options()
    opt.optimize = true
    opt.timeout = 600.0
    let built = toolchain::build(
        if source.joint { "ws/studio/appearance/joint" } else if source.runtime {
            "ws/studio/appearance/runtime"
        } else {
            "ws/studio/appearance/fixture"
        },
        f"{directory}/fixture",
        opt,
    ).wait()?
    if !built.ok {
        for d in built.diagnostics { if d.error { print(d.rendered.as_str()) } }
        return Err(ToolError::new("appearance fixture did not build"))
    }
    var load = drive::gpu()
    load.workers = 1
    load.timeout = 600.0
    let b = drive::load(f"{directory}/fixture", load).wait()?.build
    let result = if source.runtime {
        capture_runtime(b, directory.as_str(), source.first, source.count)
    } else if source.shaded {
        capture_shaded(b, directory.as_str(), seed, source)
    } else if source.response {
        capture_response(b, directory.as_str())
    } else if source.geometry {
        capture_geometry(b, directory.as_str(), seed, source.primitives)
    } else if source.batch {
        capture_views(b, directory.as_str(), seed, source)
    } else if source.enabled {
        capture_source(b, directory.as_str(), seed, source, initialize: true)
    } else if only_probe { probe(b, directory.as_str()) } else {
        capture(b, directory.as_str(), seed)
    }
    let closed = drive::close(b).wait()
    (take result)?
    let _ = (take closed)?
    Ok(())
}

pub fn tool() -> u32 {
    let given = args()
    var seed = 7
    var source = SourceConfig {}
    let only_probe = given.len() == 1 && given[0].as_str() == "bc-probe"
    if given.len() > 0 && (given[0].as_str() == "runtime" || given[0].as_str() == "joint-runtime") {
        source.runtime = true
        source.joint = given[0].as_str() == "joint-runtime"
        source.first = 0
        source.count = 2
        if given.len() == 3 {
            let Some(first) = given[1].as_str().parse_u32() else { return 2 }
            let Some(count) = given[2].as_str().parse_u32() else { return 2 }
            if first >= 146 || count == 0 || count > 146 - first { return 2 }
            source.first = first
            source.count = count
        } else if given.len() != 1 {
            print("usage: appearance runtime | joint-runtime [FIRST COUNT]")
            return 2
        }
    } else if given.len() > 0 && given[0].as_str() == "shaded" {
        if given.len() != 8 {
            print("usage: appearance shaded SEED GX GY SIZE GRID LIGHT TISSUE")
            return 2
        }
        let Some(n) = given[1].as_str().parse_u32() else { return 2 }
        let Some(gx) = given[2].as_str().parse_f32() else { return 2 }
        let Some(gy) = given[3].as_str().parse_f32() else { return 2 }
        let Some(size) = given[4].as_str().parse_u32() else { return 2 }
        let Some(grid) = given[5].as_str().parse_u32() else { return 2 }
        let Some(illumination) = given[6].as_str().parse_u32() else { return 2 }
        let Some(detailed) = given[7].as_str().parse_u32() else { return 2 }
        if !(gx >= 0.0 && gx <= 1.0 && gy >= 0.0 && gy <= 1.0) ||
            size == 0 ||
            size > 512 ||
            size % 4 != 0 ||
            grid == 0 ||
            grid > 128 ||
            size * grid > 8192 ||
            illumination >= 4 ||
            detailed > 1 { return 2 }
        seed = n
        source = SourceConfig { shaded: true, gx, gy, size, grid, illumination, detailed }
    } else if given.len() == 1 && given[0].as_str() == "response-probe" {
        source.response = true
    } else if given.len() > 0 &&
        (given[0].as_str() == "geometry" || given[0].as_str() == "primitives") {
        if given.len() != 2 {
            print("usage: appearance geometry SEED | primitives SEED")
            return 2
        }
        let Some(n) = given[1].as_str().parse_u32() else { return 2 }
        seed = n
        source.geometry = true
        source.primitives = given[0].as_str() == "primitives"
    } else if given.len() > 0 && given[0].as_str() == "source-grid" {
        if given.len() != 7 && given.len() != 8 {
            print("usage: appearance source-grid SEED SIZE LEVEL GRID FIRST COUNT [--bc]")
            return 2
        }
        let Some(n) = given[1].as_str().parse_u32() else { return 2 }
        let Some(size) = given[2].as_str().parse_u32() else { return 2 }
        let Some(level) = given[3].as_str().parse_u32() else { return 2 }
        let Some(grid) = given[4].as_str().parse_u32() else { return 2 }
        let Some(first) = given[5].as_str().parse_u32() else { return 2 }
        let Some(count) = given[6].as_str().parse_u32() else { return 2 }
        if size == 0 ||
            size > 512 ||
            grid == 0 ||
            grid > 128 ||
            size * grid > 8192 ||
            level > 2 ||
            first >= 256 ||
            count == 0 ||
            count > 256 - first {
            print("invalid source-grid size, card level, sampling grid, or view range")
            return 2
        }
        seed = n
        source = SourceConfig { enabled: true, batch: true, first, count, size, level, grid }
        if given.len() == 8 {
            if given[7].as_str() != "--bc" || size % 4 != 0 { return 2 }
            source.compress = true
        }
    } else if given.len() > 0 && given[0].as_str() == "source" {
        if given.len() != 7 && given.len() != 9 && given.len() != 10 {
            print(
                "usage: appearance source SEED GX GY SIZE LEVEL GRID [--pixel X Y | --part all|leaves|wood]",
            )
            return 2
        }
        let Some(n) = given[1].as_str().parse_u32() else { return 2 }
        let Some(gx) = given[2].as_str().parse_f32() else { return 2 }
        let Some(gy) = given[3].as_str().parse_f32() else { return 2 }
        let Some(size) = given[4].as_str().parse_u32() else { return 2 }
        let Some(level) = given[5].as_str().parse_u32() else { return 2 }
        let Some(grid) = given[6].as_str().parse_u32() else { return 2 }
        if !(gx >= 0.0 &&
            gx <= 1.0 &&
            gy >= 0.0 &&
            gy <= 1.0 &&
            size > 0 &&
            size <= 512 &&
            grid > 0 &&
            grid <= 128 &&
            size * grid <= 8192 &&
            level <= 2) {
            print("invalid source view, size, card level, or spatial grid")
            return 2
        }
        seed = n
        source = SourceConfig { enabled: true, gx, gy, size, level, grid }
        if given.len() == 9 {
            if given[7].as_str() != "--part" { return 2 }
            source.part = match given[8].as_str() {
                "all" => 0,
                "leaves" => 1,
                "wood" => 2,
                _ => return 2,
            }
        }
        if given.len() == 10 {
            if given[7].as_str() != "--pixel" { return 2 }
            let Some(px) = given[8].as_str().parse_u32() else { return 2 }
            let Some(py) = given[9].as_str().parse_u32() else { return 2 }
            if px >= size || py >= size { return 2 }
            source.probe = true
            source.px = px
            source.py = py
        }
    } else if given.len() != 0 && !only_probe {
        if given.len() != 2 || given[0].as_str() != "--seed" {
            print("usage: wrela tool appearance -- [--seed 7] | bc-probe")
            return 2
        }
        let Some(n) = given[1].as_str().parse_u32() else { return 2 }
        seed = n
    }
    match run(seed, only_probe, source) {
        Ok(()) => 0,
        Err(e) => {
            print(f"appearance: {e.message()}")
            1
        },
    }
}
