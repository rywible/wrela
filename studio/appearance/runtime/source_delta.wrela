// Source-algebra update for one translated clump. No history integration.
// Unchanged owners retain fixed positions, so their other clump contributions are invariant.
use engine::plant::{Card, Plant}
use std::gpu::{GlobalId, GpuBuffer, Oct32, Slots, buffer, dispatch}

fn contribution(plant: Plant, which: u32, p: vec3) -> vec4 {
    let c = plant.clumps[which]
    let w = exp(-plant.blend * c.distance(p))
    vec4(c.normal(p) * w, w)
}

@compute(64)
fn cook(plant: Plant, n: u32, nodes: [vec4], out: mut Slots<vec4>, id: GlobalId) {
    if id.x >= n * source_population::LAYOUTS { return }
    let index = id.x % n
    let which = source_hierarchy::owner(index, nodes)
    var sum = vec4(0.0)
    if which != great_tree::edit::CLUMP {
        let card = source_hierarchy::placed(index, which, nodes, id.x / n)
        for i in 0..plant.clumps.len() {
            if i != great_tree::edit::CLUMP { sum += contribution(plant, i, card.centre) }
        }
    }
    out[id] = sum
}

pub fn invariant(plant: Plant, n: u32, nodes: GpuBuffer<vec4>) -> GpuBuffer<vec4> {
    validate_raw(plant)
    var out = buffer(n * source_population::LAYOUTS)
    dispatch(cook.bind(plant, n, nodes.items(), mut out), over: n * source_population::LAYOUTS)
    take out
}

fn updated(plant: Plant, n: u32, nodes: [vec4], invariant: [vec4], at: u32) -> Card {
    let index = at % n
    let which = source_hierarchy::owner(index, nodes)
    let card = source_hierarchy::placed(index, which, nodes, at / n)
    if great_tree::edit::MODE == 5 {
        var value = vec4(0.0)
        for i in 0..plant.clumps.len() { value += contribution(plant, i, card.centre) }
        let sum = max(value.w, 0.5)
        return Card {
            normal: Oct32::encode(normalize(value.xyz / sum)),
            depth: max(log(sum) / plant.blend, 0.0),
            ..card,
        }
    }
    if great_tree::edit::MODE == 2 || which == great_tree::edit::CLUMP {
        let (d, g) = plant.crown(card.centre)
        return Card { normal: Oct32::encode(normalize(g)), depth: max(-d, 0.0), ..card }
    }
    let v = invariant[at] + contribution(plant, great_tree::edit::CLUMP, card.centre)
    let sum = max(v.w, 0.5)
    Card {
        normal: Oct32::encode(normalize(v.xyz / sum)),
        depth: max(log(sum) / plant.blend, 0.0),
        ..card,
    }
}

@compute(64)
fn update_cards(
    plant: Plant,
    n: u32,
    nodes: [vec4],
    invariant: [vec4],
    out: mut Slots<Card>,
    id: GlobalId,
) {
    if id.x >= n * source_population::LAYOUTS { return }
    out[id] = updated(plant, n, nodes, invariant, id.x)
}

@compute(64)
fn update_response(
    plant: Plant,
    n: u32,
    nodes: [vec4],
    invariant: [vec4],
    out: mut Slots<vec2u>,
    id: GlobalId,
) {
    if id.x >= n * source_population::LAYOUTS { return }
    let card = updated(plant, n, nodes, invariant, id.x)
    out[id] = vec2u(card.normal.bits, bitcast_u32(card.depth))
}

pub fn cards(
    plant: Plant,
    n: u32,
    nodes: GpuBuffer<vec4>,
    invariant: GpuBuffer<vec4>,
    out: mut GpuBuffer<Card>,
) {
    dispatch(
        update_cards.bind(plant, n, nodes.items(), invariant.items(), mut out),
        over: n * source_population::LAYOUTS,
    )
}

pub fn response(
    plant: Plant,
    n: u32,
    nodes: GpuBuffer<vec4>,
    invariant: GpuBuffer<vec4>,
    out: mut GpuBuffer<vec2u>,
) {
    dispatch(
        update_response.bind(plant, n, nodes.items(), invariant.items(), mut out),
        over: n * source_population::LAYOUTS,
    )
}

pub fn validate_raw(plant: Plant) {
    for i in 0..plant.clumps.len() {
        let c = plant.clumps[i]
        assert(
            c.radius > 0.0 &&
                c.squash > 0.0 &&
                plant.blend > 0.0 &&
                plant.blend * c.radius * max(c.squash, 1.0) < 20.0,
        )
    }
}

// Preparation-cost diagnostic; includes every contribution, with no allocation replacement.
pub fn refill(plant: Plant, n: u32, nodes: GpuBuffer<vec4>, out: mut GpuBuffer<vec4>) {
    dispatch(cook.bind(plant, n, nodes.items(), mut out), over: n * source_population::LAYOUTS)
}
