// Opt-in conventional source-field diagnostic; existing defaults remain unchanged.
// 0: original stabilized field; 1: finite-range direct exponentials;
// 2: drop far terms (cutoffs 4/5 fail broader shaded checks; 6 remains diagnostic);
// 3: exact nearby terms plus a source-compiled regional far-field aggregate.
// The recorded ten-layout test rejects compact cutoff4 and regional cutoff2.
// Compact cutoff5, degree2, logfalse, regions1 passes the recorded quality cases,
// but remains slower than exact caching. This is not a G4-qualified representation.
pub const MODE: u32 = 0
pub const CUTOFF: f32 = 6.0
pub const TAIL_CUTOFF: f32 = 5.0
pub const TAIL_DEGREE: u32 = 2
pub const TAIL_LOG: bool = false
pub const TAIL_REGIONS: u32 = 1
