// The grow tool (docs/plan-world-class-3.md §E1.5): trees grown as specimens.
//
// ```text
// wrela tool grow -- --species <s> --age <years> [--light open|edge|under] [--wind <0..1>] [--stand <0..1>]
//     [--seed <n>] --out <dir>
// wrela tool grow -- --specimens <dir>
// wrela tool grow -- --kinds <dir>
// wrela tool grow -- --fit <silhouette.png> --species <s> --out <dir> [--evaluations <n>] [--seed <n>]
// wrela tool grow -- --goal <goal.toml> --out <dir>
// ```
//
// A specimen is a species' tree grown from its genome (content/trees/genomes.wrela) at a site
// (`engine::growth::grow_graph`: its light a year, open 1, at a forest's edge half, under a
// canopy a quarter; its exposure to the wind), converted to the renderer's plant (`into_plant`),
// and written to `<dir>`: `side.png`, its side view (`growth::side_view`: its wood dark over its
// crown), and `grown.json`: the genome's values and hash, the site, the seed, the graph's nodes,
// the plant's limbs and chains, the height, the crown's centroid (its leaves' middle, from the
// trunk), the conversion's woody IoU and crown volume (its clumps' over its leaves'), and the
// milliseconds the growth and the conversion took on this machine (an optimized build).
// `--specimens <dir>` writes each species at ages 10, 40, 100 and 200, in each light, a
// specimen a directory (`<species>-<age>-<light>`), and `<dir>/index.html`, a page of them.
// `--kinds <dir>` draws each of the trees' kinds (`trees::kinds::kind_plant`: the archetypes
// grown at build, the rest authored) side on, `<dir>/<k>.png`, with a page.
// `--fit` finds the site, the seed and the genome's deltas (fit.wrela) whose tree's side view is
// most like the silhouette's (a tree dark on light; a photograph's, cut out), by CMA-ES over 400
// evaluations, its trajectory printed every 20; it writes the best's `grown.json` (with its IoU,
// evaluations and trajectory), `side.png`, and both masks compared (`fitted.png`, `target.png`).
// `--goal` grows a structured goal (goal.wrela says its format) and checks what it can measure:
// its height within 10 %, its crown toward its light, a lightning scar; it writes the specimen
// with the checks in its `grown.json`, and fails if a check does.

use engine::growth::into_plant
use engine::growth::side_view
use engine::plant::{Bark, Leaves}
use fit::{EVALUATIONS, MASK, candidate_json, fit, genome_of, mask_rgba, read_mask, silhouette}
use goal::{parse, reach, specimen_of}
use specimens::{AGES, Ask, LIGHTS, NAMES, Specimen, index_of, kinds_page, page, specimen, write}
use std::tool::blob::Data
use std::tool::image
use toolkit::whole::{blob_of, read_file, write_png}
use std::io::print
use std::tool::{ToolError, args}
use toolkit::whole::{chunked, write_file}

pub const USAGE: Text = "usage: wrela tool grow -- --species <s> --age <years> [--light open|edge|under] [--wind <0..1>] [--stand <0..1>] [--seed <n>] --out <dir> | --specimens <dir> | --kinds <dir> | --fit <silhouette.png> --species <s> --out <dir> [--evaluations <n>] [--seed <n>] | --goal <goal.toml> --out <dir>"

/// A number argument after `flag`, if given.
fn number_after(given: [String], flag: str) -> Option<f32> {
    for i in 0..given.len() {
        if given[i].as_str() == flag && i + 1 < given.len() {
            return given[i + 1].as_str().parse_f32()
        }
    }
    None
}

/// A text argument after `flag`, if given.
fn text_after(given: [String], flag: str) -> Option<String> {
    for i in 0..given.len() {
        if given[i].as_str() == flag && i + 1 < given.len() {
            return Some(given[i + 1].clone())
        }
    }
    None
}

fn run(given: [String]) -> Result<(), ToolError> {
    if let Some(dir) = text_after(given, "--specimens") {
        var done: Vec<(String, Specimen)> = Vec::new()
        for k in 0..NAMES.len() {
            for age in AGES {
                for light in 0..LIGHTS.len() {
                    let s = specimen(Ask { species: k, age, light, wind: 0.0, stand: 0.0, seed: 1 })
                    let name = String::from(f"{NAMES[k]}-{u32(age)}-{LIGHTS[light]}")
                    print(
                        f"grow: {name}: {s.nodes} nodes, {s.limbs} of {s.chains} limbs, {s.height} m, IoU {s.iou}, grown in {s.grow_ms} ms, converted in {s.convert_ms} ms",
                    )
                    var kept = s.clone_measures()
                    write(take s, f"{dir}/{name}")?
                    done.push((take name, take kept))
                }
            }
        }
        return write_file(f"{dir}/index.html", chunked(Vec::from(page(done).as_bytes())))
    }
    if let Some(dir) = text_after(given, "--kinds") {
        return kinds_page(dir.as_str())
    }
    if let Some(path) = text_after(given, "--fit") {
        return fitted(given, path.as_str())
    }
    if let Some(path) = text_after(given, "--goal") {
        let Some(out) = text_after(given, "--out") else {
            return Err(ToolError::new(USAGE))
        }
        let Some(text) = String::from_utf8(read_file(path.as_str(), shown: path.as_str())?) else {
            return Err(ToolError::new(f"the goal {path} isn't text"))
        }
        let g = parse(text.as_str())?
        let r = reach(g.clone())
        var failed = 0
        for (line, ok) in r.checks {
            print(f"grow: {if ok { "passed" } else { "FAILED" }}: {line}")
            if !ok {
                failed += 1
            }
        }
        write(specimen_of(g, r), out.as_str())?
        if failed > 0 {
            return Err(ToolError::new(f"{failed} of the goal's checks failed"))
        }
        return Ok(())
    }
    let Some(species) = text_after(given, "--species") else {
        return Err(ToolError::new(USAGE))
    }
    let Some(k) = index_of(NAMES, species.as_str()) else {
        return Err(ToolError::new(f"no species {species}: {USAGE}"))
    }
    let Some(age) = number_after(given, "--age") else {
        return Err(ToolError::new(USAGE))
    }
    let light_name = text_after(given, "--light").unwrap_or(String::from("open"))
    let Some(light) = index_of(LIGHTS, light_name.as_str()) else {
        return Err(ToolError::new(f"no light {light_name}: {USAGE}"))
    }
    let Some(out) = text_after(given, "--out") else {
        return Err(ToolError::new(USAGE))
    }
    let wind = clamp(number_after(given, "--wind").unwrap_or(0.0), 0.0, 1.0)
    let stand = clamp(number_after(given, "--stand").unwrap_or(0.0), 0.0, 1.0)
    let seed = u32(number_after(given, "--seed").unwrap_or(1.0))
    let s = specimen(Ask { species: k, age, light, wind, stand, seed })
    print(f"grow: {s.json}")
    write(take s, out.as_str())
}

/// `--fit`: species `--species` fitted to the silhouette at `path`, written to `--out`.
fn fitted(given: [String], path: str) -> Result<(), ToolError> {
    let Some(species) = text_after(given, "--species") else {
        return Err(ToolError::new(USAGE))
    }
    let Some(k) = index_of(NAMES, species.as_str()) else {
        return Err(ToolError::new(f"no species {species}: {USAGE}"))
    }
    let Some(out) = text_after(given, "--out") else {
        return Err(ToolError::new(USAGE))
    }
    let evaluations = u32(number_after(given, "--evaluations").unwrap_or(f32(EVALUATIONS)))
    let seed = u32(number_after(given, "--seed").unwrap_or(1.0))
    let target = read_mask(path)?
    let f = fit(k, target.clone(), evaluations, seed)
    print(f"grow: fitted to IoU {f.iou} in {f.evaluations} evaluations")
    var trajectory = String::new()
    for i in 0..f.trajectory.len() {
        let sep = if i == 0 { "" } else { "," }
        trajectory = String::from(f"{trajectory}{sep}[{f.trajectory[i].0},{f.trajectory[i].1}]")
    }
    let json = String::from(
        f"{{\"species\":\"{NAMES[k]}\",{candidate_json(f.best)},\"iou\":{f.iou},\"evaluations\":{f.evaluations},\"trajectory\":[{trajectory}]}}\n",
    )
    write_file(f"{out}/grown.json", chunked(Vec::from(json.as_bytes())))?
    let shape = fit::grown(f.best)
    let mask = silhouette(shape)
    for (name, m) in [("fitted", take mask), ("target", take target)] {
        let px = blob_of(chunked(mask_rgba(m)))?
        write_png(
            image::Image { width: MASK, height: MASK, rgba: Data::Blob(px) },
            f"{out}/{name}.png",
        )?
    }
    // Its side view, the specimens' (on this thread: its plant is 130 KB).
    let g = genome_of(f.best)
    let t = engine::growth::grow_graph(
        g,
        engine::growth::Site { age: f.best.age, light: f.best.light, wind: f.best.wind, slope: f.best.slope },
        if f.best.light >= 1.0 { Vec::new() } else {
            Vec::filled(u32(ceil(f.best.age)), f.best.light)
        },
        vec2(0.0),
        [],
        f.best.seed,
    )
    let (p, _) = into_plant(t, g, Leaves {}, Bark {})
    let (w, h, px) = side_view(p, 1024)
    write_png(image::Image { width: w, height: h, rgba: Data::Blob(blob_of(chunked(take px))?) }, f"{out}/side.png")
}

pub fn tool() -> u32 {
    let given = args()
    if given.len() == 0 {
        print(USAGE)
        return 2
    }
    match run(given) {
        Ok(()) => 0,
        Err(e) => {
            print(f"grow: {e.message()}")
            1
        },
    }
}
