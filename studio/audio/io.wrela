// The tool's requests: a piece built through the toolchain, and its build driven on the CPU
// (`std::tool::drive`): started with its take chosen, described, and its voice rendered offline.
// Each is a job that waits for its answers. Files are read and written whole through the
// toolkit's jobs (`toolkit::whole`).

use piece::Take
use std::collections::{Box, Vec}
use std::string::String
use std::tool::drive
use std::tool::drive::Scalar
use std::tool::toolchain
use toolkit::wait::{done, said, wait}
use toolkit::whole::data_bytes

/// The audio thread's rate and quantum.
pub const RATE: f64 = 48000.0
pub const QUANTUM: u32 = 128

/// Builds the piece at `pkg` (a root path) into its `build/audio`: that directory, or the
/// build's errors.
@job
pub fn build_piece(pkg: take String) -> Result<String, String> {
    let out = String::from(f"{pkg}/build/audio")
    var b = wait(toolchain::build(pkg.as_str(), out.as_str(), toolchain::options()))
    while !b.ready() { yield }
    let result = said(toolchain::read_built(b.polled()))?
    if !result.ok {
        var why = String::new()
        for d in result.diagnostics {
            if d.error {
                why.push_str(d.rendered.as_str())
            }
        }
        return Err(take why)
    }
    Ok(out)
}

fn trapped(what: str, ran: take drive::Ran) -> Result<drive::Ran, String> {
    match ran.trap {
        Some(t) => Err(String::from(f"{what}: {t.message}")),
        None => Ok(ran),
    }
}

/// Calls `export` with `args` on `b`: what it ran, or why it failed (`what` names it).
@job
pub fn call(
    b: take drive::Build,
    export: take String,
    args: take Vec<Scalar>,
    what: take String,
) -> Result<drive::Ran, String> {
    var c = wait(drive::call(b, export.as_str(), args, timeout: 600.0))
    while !c.ready() { yield }
    match drive::read_ran(c.polled()) {
        Ok(ran) => trapped(what.as_str(), take ran),
        Err(e) => Err(String::from(f"{what}: {e.message()}")),
    }
}

/// The piece built in `build`, loaded on the CPU and started (`init`), with `chosen` its take
/// (`choose(...)`, if given).
@job
pub fn start_piece(
    build: take String,
    chosen: take Option<Vec<u32>>,
) -> Result<drive::Build, String> {
    var options = drive::cpu()
    options.width = 16
    options.height = 16
    var l = wait(drive::load(build.as_str(), options))
    while !l.ready() { yield }
    let b = said(drive::read_loaded(l.polled()))?.build
    var i = wait(drive::init(b, timeout: 600.0))
    while !i.ready() { yield }
    let _ = trapped("`init`", said(drive::read_ran(i.polled()))?)?
    let Some(t) = take chosen else { return Ok(b) }
    var args: Vec<Scalar> = Vec::new()
    var list = String::new()
    for n in t {
        args.push(Scalar::I32(i32(n)))
        if !list.is_empty() {
            list.push_str(", ")
        }
        list.push_str(f"{n}")
    }
    var c = Box::new(
        call.start(b, String::from("choose"), take args, String::from(f"`choose([{list}])`")),
    )
    var r = done(c.get_mut().resume())
    while r.is_none() {
        yield
        r = done(c.get_mut().resume())
    }
    let _ = (take r).unwrap()?
    Ok(b)
}

/// The take that `b`'s `describe()` prints.
@job
pub fn describe_piece(b: take drive::Build) -> Result<Take, String> {
    var c = Box::new(
        call.start(b, String::from("describe"), Vec::new(), String::from("`describe()`")),
    )
    var r = done(c.get_mut().resume())
    while r.is_none() {
        yield
        r = done(c.get_mut().resume())
    }
    let _ = (take r).unwrap()?
    var lines: Vec<String> = Vec::new()
    loop {
        var o = wait(drive::logs(b))
        while !o.ready() { yield }
        let logs = said(drive::read_logs(o.polled()))?
        for l in logs.lines {
            lines.push(l.clone())
        }
        if logs.waiting == 0 {
            break
        }
    }
    piece::read(lines)
}

/// How many seconds `b`'s take sounds: `given`, or the piece's `seconds()`.
@job
pub fn length_of(b: take drive::Build, given: take Option<f64>) -> Result<f64, String> {
    if let Some(s) = given {
        return Ok(s)
    }
    var c = Box::new(
        call.start(b, String::from("seconds"), Vec::new(), String::from("`seconds()`")),
    )
    var r = done(c.get_mut().resume())
    while r.is_none() {
        yield
        r = done(c.get_mut().resume())
    }
    let ran = (take r).unwrap()?
    if ran.results.is_empty() {
        return Err(String::from("`seconds()` returns no f32"))
    }
    match ran.results[0] {
        Scalar::F32(s) => Ok(f64(s)),
        Scalar::F64(s) => Ok(s),
        _ => Err(String::from("`seconds()` returns no f32")),
    }
}

/// How many quanta `seconds` takes, or why it can't be rendered.
pub fn quanta(seconds: f64) -> Result<u32, String> {
    let count = ceil(seconds * RATE / f64(QUANTUM))
    if !(abs(seconds) <= 1.7976931348623157e308) || seconds <= 0.0 || !(count <= 4294967295.0) {
        return Err(
            String::from(
                "audio length must be a positive, finite number of seconds within the render limit",
            ),
        )
    }
    Ok(u32(count))
}

/// A voice rendered: its samples' bytes as the host gave them (little-endian `f32`s, the two
/// channels interleaved), the samples, and each quantum's seconds if timed.
pub struct Rendered: Clone {
    pub bytes: Vec<Vec<u8>>,
    pub samples: Vec<f32>,
    pub times: Vec<f64>,
}

fn f32s(chunks: [Vec<u8>]) -> Vec<f32> {
    var size = 0
    for c in chunks {
        size += c.len() / 4
    }
    var out: Vec<f32> = Vec::with_capacity(size)
    for c in chunks {
        let n = c.len() / 4
        for k in 0..n {
            let i = 4 * k
            out.push(
                bitcast_f32(
                    u32(c[i]) |
                        (u32(c[i + 1]) << 8) |
                        (u32(c[i + 2]) << 16) |
                        (u32(c[i + 3]) << 24),
                ),
            )
        }
    }
    out
}

fn f64s(chunks: [Vec<u8>]) -> Vec<f64> {
    var out: Vec<f64> = Vec::new()
    for c in chunks {
        let n = c.len() / 8
        for k in 0..n {
            var bits: u64 = 0
            for j in 0..8 {
                bits = bits | (u64(c[8 * k + j]) << (8 * j))
            }
            out.push(bitcast_f64(bits))
        }
    }
    out
}

/// `b`'s voice over `seconds`, after its first frame (when a piece starts it): each quantum
/// timed alone if `timed`.
@job
pub fn render_piece(
    b: take drive::Build,
    seconds: take f64,
    timed: take bool,
) -> Result<Rendered, String> {
    let n = quanta(seconds)?
    var f = wait(drive::frames(b, 1, std::input::Script::frames(), timeout: 600.0))
    while !f.ready() { yield }
    match drive::read_ran(f.polled()) {
        Ok(ran) => {
            let _ = trapped("the first frame", take ran)?
        },
        Err(e) => return Err(String::from(f"the first frame: {e.message()}")),
    }
    var a = wait(drive::audio(b, n, timed, timeout: 600.0))
    while !a.ready() { yield }
    let voice = said(drive::read_audio(a.polled()))?
    var times: Vec<f64> = Vec::new()
    if let Some(t) = voice.times.clone() {
        var j = Box::new(data_bytes.start(take t))
        var r = done(j.get_mut().resume())
        while r.is_none() {
            yield
            r = done(j.get_mut().resume())
        }
        times = f64s((take r).unwrap()?)
    }
    var j = Box::new(data_bytes.start(voice.samples.clone()))
    var r = done(j.get_mut().resume())
    while r.is_none() {
        yield
        r = done(j.get_mut().resume())
    }
    let bytes = (take r).unwrap()?
    let samples = f32s(bytes)
    Ok(Rendered { bytes, samples, times })
}

/// Closes `b`.
@job
pub fn close(b: take drive::Build) -> u32 {
    var c = wait(drive::close(b))
    while !c.ready() { yield }
    0
}
