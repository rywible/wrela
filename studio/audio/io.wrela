// The tool's requests: a piece built through the toolchain, and its build driven on the CPU
// (`std::tool::drive`): started with its take chosen, described, and its voice rendered offline.
// Files are read and written whole through the toolkit (`toolkit::whole`).

use piece::Take
use std::collections::Vec
use std::string::String
use std::tool::ToolError
use std::tool::drive
use std::tool::drive::{Scalar, Seen, Step}
use std::tool::toolchain
use toolkit::whole::data_bytes

/// The audio thread's rate and quantum.
pub const RATE: f64 = 48000.0
pub const QUANTUM: u32 = 128

/// Builds the piece at `pkg` (a root path) into its `build/audio`: that directory, or the
/// build's errors.
pub fn build_piece(pkg: str) -> Result<String, ToolError> {
    let out = String::from(f"{pkg}/build/audio")
    let result = toolchain::build(pkg, out.as_str(), toolchain::options()).wait()?
    if !result.ok {
        var why = String::new()
        for d in result.diagnostics {
            if d.error {
                why.push_str(d.rendered.as_str())
            }
        }
        return Err(ToolError::new(why.as_str()))
    }
    Ok(out)
}

/// How a piece's build is loaded: on the CPU, its screen as small as it goes.
pub fn load() -> drive::Load {
    var options = drive::cpu()
    options.width = 16
    options.height = 16
    options
}

/// Steps to run on a piece's build, each with the name a trap in it is said with.
pub struct Steps: Clone {
    list: Vec<Step>,
    names: Vec<String>,
}

impl Steps {
    /// The piece started (`init`), with `chosen` its take (`choose(...)`, if given).
    pub fn started(chosen: Option<Vec<u32>>) -> Steps {
        var s = Steps { list: Vec::from([Step::Init]), names: Vec::from([String::from("`init`")]) }
        let Some(t) = chosen else { return s }
        var args: Vec<Scalar> = Vec::new()
        var list = String::new()
        for n in t {
            args.push(Scalar::I32(i32(n)))
            if !list.is_empty() {
                list.push_str(", ")
            }
            list.push_str(f"{n}")
        }
        s.then(Step::Call(String::from("choose"), take args), f"`choose([{list}])`")
        s
    }

    /// `step` after these, named `name`.
    pub fn then(mut self, step: take Step, name: str) {
        self.list.push(take step)
        self.names.push(String::from(name))
    }

    /// The first frame (when a piece starts its voice), then the voice over `seconds`, each
    /// quantum timed alone if `timed`, after these.
    pub fn render(mut self, seconds: f64, timed: bool) -> Result<(), ToolError> {
        let n = quanta(seconds).map_err(|why| ToolError::new(why.as_str()))?
        self.then(Step::Frames(1, std::input::Script::frames()), "the first frame")
        self.then(Step::Audio(n, timed), "the voice")
        Ok(())
    }

    /// What `seen` saw, or the trap it ended with, said with its step's name.
    fn checked(self, seen: take Seen) -> Result<Seen, ToolError> {
        let Some(t) = seen.trap.clone() else { return Ok(take seen) }
        let what = if t.step < self.names.len() {
            self.names[t.step].clone()
        } else {
            String::from("a step")
        }
        Err(ToolError::new(f"{what}: {t.message}"))
    }

    /// These steps run on `b`, in one request, and cleared: what they saw.
    pub fn on(mut self, b: drive::Build) -> Result<Seen, ToolError> {
        let seen = drive::steps(b, self.list, timeout: 600.0).wait()?
        let checked = self.checked(take seen)
        self.list = Vec::new()
        self.names = Vec::new()
        checked
    }

    /// The piece built in `build` loaded, these steps run on it, and closed, in one request:
    /// what they saw.
    pub fn run(self, build: str) -> Result<Seen, ToolError> {
        self.checked(drive::run(build, load(), self.list, timeout: 600.0).wait()?)
    }
}

/// Whether the drive service kept every line `describe()` printed in what `seen` saw: it drops
/// those past 256 MiB.
pub fn all_kept(seen: Seen) -> Result<(), ToolError> {
    if seen.dropped_lines > 0 {
        return Err(
            ToolError::new(
                f"`describe()` printed more than the drive service keeps: {seen.dropped_lines} lines dropped",
            ),
        )
    }
    Ok(())
}

/// The take a piece's `describe()` printed, in what `seen` saw: every line, in the answer or
/// in its blob (`drive::lines`).
pub fn described(seen: take Seen) -> Result<Take, ToolError> {
    all_kept(seen)?
    var all = take seen
    piece::read(drive::lines(mut all)?).map_err(|why| ToolError::new(why.as_str()))
}

/// What a piece's `seconds()` returned, the last step that ran code in what `seen` saw.
pub fn length(seen: Seen) -> Result<f64, ToolError> {
    let none = ToolError::new("`seconds()` returns no f32")
    if seen.ran.is_empty() || seen.ran[seen.ran.len() - 1].results.is_empty() {
        return Err(none)
    }
    match seen.ran[seen.ran.len() - 1].results[0] {
        Scalar::F32(s) => Ok(f64(s)),
        Scalar::F64(s) => Ok(s),
        _ => Err(none),
    }
}

/// How many quanta `seconds` takes, or why it can't be rendered.
pub fn quanta(seconds: f64) -> Result<u32, String> {
    let count = ceil(seconds * RATE / f64(QUANTUM))
    if !(abs(seconds) <= 1.7976931348623157e308) || seconds <= 0.0 || !(count <= 4294967295.0) {
        return Err(
            String::from(
                "audio length must be a positive, finite number of seconds within the render limit",
            ),
        )
    }
    Ok(u32(count))
}

/// A voice rendered: its samples' bytes as the host gave them (little-endian `f32`s, the two
/// channels interleaved), the samples, and each quantum's seconds if timed.
pub struct Rendered: Clone {
    pub bytes: Vec<Vec<u8>>,
    pub samples: Vec<f32>,
    pub times: Vec<f64>,
}

fn f32s(chunks: [Vec<u8>]) -> Vec<f32> {
    var size = 0
    for c in chunks {
        size += c.len() / 4
    }
    var out: Vec<f32> = Vec::with_capacity(size)
    for c in chunks {
        let n = c.len() / 4
        for k in 0..n {
            let i = 4 * k
            out.push(
                bitcast_f32(
                    u32(c[i]) |
                        (u32(c[i + 1]) << 8) |
                        (u32(c[i + 2]) << 16) |
                        (u32(c[i + 3]) << 24),
                ),
            )
        }
    }
    out
}

fn f64s(chunks: [Vec<u8>]) -> Vec<f64> {
    var out: Vec<f64> = Vec::new()
    for c in chunks {
        let n = c.len() / 8
        for k in 0..n {
            var bits: u64 = 0
            for j in 0..8 {
                bits = bits | (u64(c[8 * k + j]) << (8 * j))
            }
            out.push(bitcast_f64(bits))
        }
    }
    out
}

/// The voice that `seen`'s `Audio` step rendered: its samples, and each quantum's seconds if
/// timed, read from their blobs (which are released).
pub fn rendered(seen: take Seen) -> Result<Rendered, ToolError> {
    var seen = take seen
    let voice = seen.audio.remove(0)
    var times: Vec<f64> = Vec::new()
    if let Some(t) = voice.times.clone() {
        times = f64s(data_bytes(take t)?)
    }
    let bytes = data_bytes(voice.samples.clone())?
    let samples = f32s(bytes)
    Ok(Rendered { bytes, samples, times })
}

/// What steps that saw nothing saw, with `trap`, and `dropped` lines dropped.
fn seen(trap: take Option<drive::Trap>, dropped: u32) -> Seen {
    Seen {
        ran: Vec::new(),
        captures: Vec::new(),
        hashes: Vec::new(),
        phases: Vec::new(),
        audio: Vec::new(),
        buffers: Vec::new(),
        bytes: Vec::new(),
        commands: Vec::new(),
        running: Vec::new(),
        lines: Vec::new(),
        log: None,
        dropped_lines: dropped,
        trap,
    }
}

@test
fn a_trap_is_said_with_its_steps_name_and_dropped_lines_fail() {
    let s = Steps::started(Some(Vec::from([2, 5])))
    let trap = drive::Trap {
        message: String::from("trapped in a call"),
        panic: String::from("no"),
        at: String::new(),
        stage: drive::Stage::Call,
        number: 0,
        step: 1,
    }
    let Err(e) = s.checked(seen(Some(take trap), 0)) else { panic("a trap fails") }
    assert(e.message() == "`choose([2, 5])`: trapped in a call", e.message())
    assert(s.checked(seen(None, 0)).is_ok())
    let Err(dropped) = all_kept(seen(None, 3)) else { panic("dropped lines fail") }
    assert(dropped.message().find("3 lines dropped").is_some(), dropped.message())
}
