// The audio tool (`wrela tool audio`): what a piece's take sounds like, in forms an agent can
// read, for a program that plays a piece on its voice (spike 14, #48). An agent can't listen, so
// these say what a take sounds like: the samples as a WAV file for a person, and for the agent
// the notes as played, a summary in numbers, a MIDI file for another instrument, and a sheet (a
// PNG of the piano roll, the tempo, the pedals and a spectrogram). Three more measure recordings:
// a note's partials, a piano model fitted to many notes, and the clicks in a recording.
//
// ```text
// wrela tool audio -- <package-dir> wav <out.wav> [--take n] [--seconds s]
// wrela tool audio -- <package-dir> describe [--take n]
// wrela tool audio -- <package-dir> numbers [--take n]
// wrela tool audio -- <package-dir> midi <out.mid> [--take n]
// wrela tool audio -- <package-dir> sheet <out.png> [--take n] [--bars a-b]
// wrela tool audio -- <package-dir> speed [--take n]
// wrela tool audio -- partials <file.wav> --key k [--from s] [--seconds s]
// wrela tool audio -- model <dir> --out <file.wrela> [--against <dir>]
// wrela tool audio -- clicks <file.wav> [--notes <take.json>]
// ```
//
// Paths are from the workspace's directory (the root `ws`). Each answer is JSON, as the Rust
// command it replaced (`wrela audio`) printed it, byte for byte.
//
// **A piece** is a program with three exports: `choose(...)`, called before its first frame with
// `--take`'s numbers (`--take 1`, or `--take 60,64` for two), which says which take it plays (the
// program's own choice without `--take`); `seconds() -> f32`, how long the take sounds; and
// `describe()`, which prints the take as JSON lines (examples/gymnopedie has them). The tool
// builds the piece through the toolchain into its `build/audio`, loads it on the native host's
// CPU (`std::tool::drive`), runs `init`, `choose` and its first frame, and renders its voice
// offline (`drive::audio`): the samples Chrome's AudioWorklet renders too.
// - **`wav`** writes the take as a 32-bit float WAV file at 48 kHz, and says its length, peak,
//   RMS, how many samples clip, and how long building and rendering took.
// - **`describe`** gives the take: its notes (key, voice, bar, onset, release, velocity), its
//   pedals' points and its beats.
// - **`numbers`** gives, per bar, its tempo, its loudness and each voice's mean velocity, and
//   the whole take's level.
// - **`midi`** writes a standard MIDI file: one track at 960 ticks a second (a quarter note a
//   second), the notes, and the pedals as controllers 64 (sustain) and 67 (soft).
// - **`sheet`** draws one PNG (sheet.wrela says what it shows), of the whole take or bars `a-b`.
// - **`speed`** times each quantum of the voice: the mean, the 99th percentile and the worst
//   against a quantum's budget of 2.667 ms. They're timed in a driven build, whose deadline
//   checks at each loop's head keep a loop's SIMD values in memory (about 2.2× slower than the
//   native host on the piano's voice), so they're comparable only with each other, as its
//   answer's `measured_in` says.
//
// **`partials`** measures a note in a WAV file (a recorded note, say), struck at `--from`
// (seconds, 0 unless given) and measured over `--seconds` (8 unless given): its tuning,
// inharmonicity, each partial's frequency, level and decay in two stages, and the strike's noise
// (measure.wrela). **`model`** fits engine::piano's tables to recorded notes (model.wrela).
// **`clicks`** finds the clicks in a recording, each put with a take's notes if given
// (clicks.wrela).

use clicks::clicks_report
use dsp::{db, peak_of, rms, round}
use io::{RATE, Rendered, Steps, build_piece}
use json::{Value, obj, text}
use measure::report
use model::fit_model
use piece::{Take, described, midi, numbers}
use std::collections::Vec
use std::io::print
use std::string::String
use std::time::now
use std::tool::{ToolError, args}
use std::tool::drive
use std::tool::drive::Step
use std::tool::files::rooted
use toolkit::whole::{read_file, write_file}

/// The root the tool reads and writes the workspace in.
pub const WS: Text = "ws"

pub const USAGE: Text = "usage: wrela tool audio -- <package-dir> (wav <out.wav> | describe | numbers | midi <out.mid> | sheet <out.png> [--bars a-b] | speed) [--take n] [--seconds s]\n       wrela tool audio -- partials <file.wav> --key k [--from s] [--seconds s]\n       wrela tool audio -- model <dir-of-key-velocity.wav> --out <file.wrela> [--against <dir>]\n       wrela tool audio -- clicks <file.wav> [--notes <take.json>]"

fn usage() -> u32 {
    print(USAGE)
    2
}

/// What the command line asks: the root its paths are in (the workspace's, `WS`), the piece's
/// directory (for a piece's action), the action, the rest of its words, and its options.
pub struct Args: Clone {
    pub root: String,
    pub dir: String,
    pub action: String,
    pub rest: Vec<String>,
    pub chosen: Option<Vec<u32>>,
    pub seconds: Option<f64>,
    pub bars: Option<(u32, u32)>,
    pub key: Option<u32>,
    pub from: f64,
    pub out: Option<String>,
    pub against: Option<String>,
    pub notes: Option<String>,
}

/// The command line's words as `Args`, or `None` for a usage error.
pub fn parse_args(given: [String]) -> Option<Args> {
    var a = Args {
        root: String::from(WS),
        dir: String::new(),
        action: String::new(),
        rest: Vec::new(),
        chosen: None,
        seconds: None,
        bars: None,
        key: None,
        from: 0.0,
        out: None,
        against: None,
        notes: None,
    }
    var positional: Vec<String> = Vec::new()
    var i = 0
    while i < given.len() {
        let x = given[i].as_str()
        let value = if i + 1 < given.len() { Some(given[i + 1].clone()) } else { None }
        if x == "--take" {
            let Some(v) = take value else { return None }
            var nums: Vec<u32> = Vec::new()
            for (a0, b0) in v.as_str().split(",") {
                nums.push(v.as_str().slice(a0, b0).trim().parse_u32()?)
            }
            a.chosen = Some(take nums)
            i += 2
        } else if x == "--seconds" {
            let Some(v) = take value else { return None }
            a.seconds = Some(v.as_str().parse_f64()?)
            i += 2
        } else if x == "--from" {
            let Some(v) = take value else { return None }
            a.from = v.as_str().parse_f64()?
            i += 2
        } else if x == "--key" {
            let Some(v) = take value else { return None }
            a.key = Some(v.as_str().parse_u32()?)
            i += 2
        } else if x == "--out" {
            a.out = Some((take value)?)
            i += 2
        } else if x == "--against" {
            a.against = Some((take value)?)
            i += 2
        } else if x == "--notes" {
            a.notes = Some((take value)?)
            i += 2
        } else if x == "--bars" {
            let Some(v) = take value else { return None }
            let s = v.as_str()
            let dash = s.find("-")?
            let lo = s.slice(0, dash).parse_u32()?
            let hi = s.slice(dash + 1, s.len()).parse_u32()?
            a.bars = Some((lo, hi))
            i += 2
        } else if x.starts_with("--") {
            return None
        } else {
            positional.push(String::from(x))
            i += 1
        }
    }
    if positional.is_empty() {
        return None
    }
    let first = positional[0].as_str()
    if first == "partials" || first == "model" || first == "clicks" {
        a.action = String::from(first)
        for k in 1..positional.len() {
            a.rest.push(positional[k].clone())
        }
        return Some(a)
    }
    if positional.len() < 2 {
        return None
    }
    a.dir = positional[0].clone()
    a.action = positional[1].clone()
    for k in 2..positional.len() {
        a.rest.push(positional[k].clone())
    }
    Some(a)
}

/// `path`, from the workspace's directory, as a path in the root `root` (the workspace's).
pub fn in_root(root: str, path: str) -> Result<String, ToolError> {
    match rooted(root, path) {
        Some(p) => Ok(p),
        None => Err(ToolError::new(f"`{path}` isn't a path in the workspace")),
    }
}

/// `why`, a failure said as text (a pure function's), as the tool's.
pub fn failed(why: take String) -> ToolError {
    ToolError::new(why.as_str())
}

pub fn tool() -> u32 {
    let Some(a) = parse_args(args()) else { return usage() }
    borrow action = a.action
    let known = [
        "wav",
        "describe",
        "numbers",
        "midi",
        "sheet",
        "speed",
        "partials",
        "model",
        "clicks",
    ]
    var found = false
    for k in known {
        if action.as_str() == k {
            found = true
        }
    }
    if !found {
        return usage()
    }
    if action.as_str() == "model" && (a.rest.is_empty() || a.out.is_none()) {
        return usage()
    }
    if action.as_str() == "clicks" && a.rest.is_empty() {
        return usage()
    }
    match run(a) {
        Ok(()) => 0,
        Err(e) => {
            print(f"error: {e.message()}")
            2
        },
    }
}

/// Carries out the command.
fn run(a: Args) -> Result<(), ToolError> {
    let action = a.action.as_str()
    if action == "partials" {
        return partials_command(a)
    }
    if action == "clicks" {
        return clicks_report(a)
    }
    if action == "model" {
        return fit_model(a)
    }
    piece_command(a)
}

/// The take an instance of the piece in `build` (started with `a`'s take chosen) describes: the
/// instance loaded, started, described and closed in one request.
pub fn take_of(a: Args, build: str) -> Result<Take, ToolError> {
    var s = Steps::started(a.chosen.clone())
    s.then(Step::Call(String::from("describe"), Vec::new()), "`describe()`")
    io::described(s.run(build)?)
}

/// The voice of an instance of the piece in `build` (started with `a`'s take chosen) over its
/// length (`a`'s seconds, or the piece's), and that length, the instance closed after.
pub fn voice_of(a: Args, build: str, timed: bool) -> Result<(Rendered, f64), ToolError> {
    var s = Steps::started(a.chosen.clone())
    if let Some(seconds) = a.seconds {
        s.render(seconds, timed)?
        return Ok((io::rendered(s.run(build)?)?, seconds))
    }
    // The piece's length is asked first, then its voice rendered over it.
    s.then(Step::Call(String::from("seconds"), Vec::new()), "`seconds()`")
    let b = drive::load(build, io::load()).wait()?.build
    let voiced = voice_on(b, take s, timed)
    let _ = drive::close(b).wait()
    voiced
}

/// The voice of the piece loaded as `b`, over the length its `seconds()` returns after `s`.
fn voice_on(b: drive::Build, s: take Steps, timed: bool) -> Result<(Rendered, f64), ToolError> {
    var s = take s
    let seconds = io::length(s.on(b)?)?
    s.render(seconds, timed)?
    Ok((io::rendered(s.on(b)?)?, seconds))
}

/// A piece's action: built once, then described, rendered, or both (on two instances: `describe`
/// is the program's export and can change its state).
pub fn piece_command(a: Args) -> Result<(), ToolError> {
    borrow action = a.action
    let out_arg: Option<String> = if a.rest.is_empty() { None } else { Some(a.rest[0].clone()) }
    let needs_file = action.as_str() == "wav" ||
        action.as_str() == "midi" ||
        action.as_str() == "sheet"
    if needs_file && out_arg.is_none() {
        return Err(
            ToolError::new(
                if action.as_str() == "wav" {
                    "wav needs a file to write"
                } else if action.as_str() == "midi" {
                    "midi needs a file to write"
                } else {
                    "sheet needs a PNG to write"
                },
            ),
        )
    }
    let out = match out_arg {
        Some(o) => Some(in_root(a.root.as_str(), o.as_str())?),
        None => None,
    }
    let started_at = now()
    let pkg = in_root(a.root.as_str(), a.dir.as_str())?
    let build = build_piece(pkg.as_str())?
    let wants_take = action.as_str() == "describe" ||
        action.as_str() == "numbers" ||
        action.as_str() == "midi" ||
        action.as_str() == "sheet"
    let wants_voice = action.as_str() == "wav" ||
        action.as_str() == "numbers" ||
        action.as_str() == "sheet" ||
        action.as_str() == "speed"
    var t: Option<Take> = None
    if wants_take {
        t = Some(take_of(a, build.as_str())?)
    }
    var voice: Option<(Rendered, f64)> = None
    if wants_voice {
        voice = Some(voice_of(a, build.as_str(), action.as_str() == "speed")?)
    }
    let shown = if a.rest.is_empty() { String::new() } else { a.rest[0].clone() }
    if action.as_str() == "describe" {
        let Some(tk) = take t else { return Err(ToolError::new("no take")) }
        print(described(tk).pretty().as_str())
        return Ok(())
    }
    if action.as_str() == "numbers" {
        let Some(tk) = take t else { return Err(ToolError::new("no take")) }
        let Some((v, _)) = take voice else { return Err(ToolError::new("no voice")) }
        print(numbers(tk, v.samples).map_err(failed)?.pretty().as_str())
        return Ok(())
    }
    if action.as_str() == "midi" {
        let Some(tk) = take t else { return Err(ToolError::new("no take")) }
        let Some(path) = take out else {
            return Err(ToolError::new("midi needs a file to write"))
        }
        write_file(path.as_str(), Vec::from([midi(tk)])).map_err(
            |e| ToolError::new(f"can't write {shown}: {e.message()}"),
        )?
        print(
            obj()
                .with("midi", text(shown.as_str()))
                .with("notes", Value::Int(i64(tk.notes.len())))
                .compact()
                .as_str(),
        )
        return Ok(())
    }
    if action.as_str() == "wav" {
        let Some(path) = take out else { return Err(ToolError::new("wav needs a file to write")) }
        let Some((v, seconds)) = take voice else { return Err(ToolError::new("no voice")) }
        let took = now() - started_at
        var parts: Vec<Vec<u8>> = Vec::new()
        parts.push(wav::header(samples: v.samples.len(), channels: 2))
        var bytes = take v.bytes
        parts.append(mut bytes)
        write_file(path.as_str(), take parts).map_err(
            |e| ToolError::new(f"can't write {shown}: {e.message()}"),
        )?
        var clipped = 0
        for x in v.samples {
            if abs(x) > 1.0 {
                clipped += 1
            }
        }
        print(
            obj()
                .with("wav", text(shown.as_str()))
                .with("seconds", Value::Num(seconds))
                .with("peak_db", Value::Num(db(f64(peak_of(v.samples)))))
                .with("rms_db", Value::Num(db(rms(v.samples, 0, v.samples.len()))))
                .with("clipped", Value::Int(i64(clipped)))
                .with("build_and_render_seconds", Value::Num(took))
                .compact()
                .as_str(),
        )
        return Ok(())
    }
    if action.as_str() == "speed" {
        let Some((v, seconds)) = take voice else { return Err(ToolError::new("no voice")) }
        print(speed(v.times, seconds).pretty().as_str())
        return Ok(())
    }
    if action.as_str() == "sheet" {
        let Some(tk) = take t else { return Err(ToolError::new("no take")) }
        let Some((v, _)) = take voice else { return Err(ToolError::new("no voice")) }
        let Some(path) = take out else {
            return Err(ToolError::new("sheet needs a PNG to write"))
        }
        sheet::write_sheet(take tk, v.samples, a.bars, path.as_str(), shown.as_str())?
        print(obj().with("sheet", text(shown.as_str())).compact().as_str())
        return Ok(())
    }
    Err(ToolError::new(f"no action `{action}`"))
}

/// Where `speed`'s times come from, as its answer says.
pub const MEASURED_IN: Text = "a driven build, with interruption checks (SIMD loops about 2.2x slower than the native host's): comparable only with each other"

/// `speed`'s answer: how fast the voice renders in a driven build, each quantum timed.
pub fn speed(times: [f64], seconds: f64) -> Value {
    let n = times.len()
    var ms: Vec<f64> = Vec::with_capacity(n)
    var total = 0.0
    for t in times {
        ms.push(t * 1000.0)
        total += t * 1000.0
    }
    var sorted = ms.clone()
    sorted.sort_by(|a, b| a < b)
    let budget = 1000.0 * f64(io::QUANTUM) / RATE
    let p99 = if n == 0 { 0.0 } else { sorted[min(n * 99 / 100, n - 1)] }
    let worst = if n == 0 { 0.0 } else { sorted[n - 1] }
    obj()
        .with("measured_in", text(MEASURED_IN))
        .with("seconds", Value::Num(seconds))
        .with("quanta", Value::Int(i64(n)))
        .with("render_seconds", Value::Num(round(total / 1000.0, 3)))
        .with("times_real_time", Value::Num(round(seconds / (total / 1000.0), 2)))
        .with("quantum_budget_ms", Value::Num(round(budget, 3)))
        .with("mean_ms", Value::Num(round(total / f64(n), 4)))
        .with("p99_ms", Value::Num(round(p99, 4)))
        .with("worst_ms", Value::Num(round(worst, 4)))
}

/// `partials`: a note's partials in a WAV file.
pub fn partials_command(a: Args) -> Result<(), ToolError> {
    if a.rest.is_empty() {
        return Err(ToolError::new("partials needs a WAV file"))
    }
    let Some(key) = a.key else {
        return Err(ToolError::new("partials needs --key, the note's MIDI key"))
    }
    if key > 127 {
        return Err(ToolError::new("partials needs a MIDI key from 0 to 127"))
    }
    if !(a.from >= 0.0 && a.from <= 1.7976931348623157e308) {
        return Err(ToolError::new("partials needs a finite, non-negative --from time"))
    }
    let seconds = a.seconds.unwrap_or(8.0)
    if !(seconds > 0.0 && seconds <= 1.7976931348623157e308) {
        return Err(ToolError::new("partials needs a positive, finite --seconds length"))
    }
    let shown = a.rest[0].as_str()
    let path = in_root(a.root.as_str(), shown)?
    let w = wav::read(read_file(path.as_str(), shown)?, shown).map_err(failed)?
    let mono = w.mono()
    let remaining = f64(mono.len()) / w.rate - a.from
    if remaining <= 0.0 {
        return Err(ToolError::new("partials needs a --from time before the end of the recording"))
    }
    let length = if seconds < remaining { seconds } else { remaining }
    print(report(mono, w.rate, key, a.from, length).pretty().as_str())
    Ok(())
}
