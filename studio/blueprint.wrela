// Blueprints (language.md §22): outlines of the subject from the side, the front and the top,
// written as code in the subject package (a module `blueprint` with `pub fn side()`,
// `front()` or `top()`, each returning the outline's points in order, a closed polygon). The
// lens draws an outline over its view, says where the subject's silhouette misses it and by
// how much, and fits chosen literals to it (`fit_blueprint`), as it fits a reference image.
//
// An outline's points are in its view's own coordinates, in metres: from the side (z, y), +z
// the subject's front; from the front (x, y), +x its left; from the top (x, z).

use json::{List, list, obj}
use std::collections::Vec
use std::field::Surface
use std::string::String
use fit::FitView
use view::{SHEET, axes}

/// The outlines' facings by number, as commands and answers name them.
pub const BLUEPRINT_NAMES: [Text; 3] = ["side", "front", "top"]

/// The facing an outline's name or number gives (`front` or `1`, `top` or `2`; else the side).
pub fn facing_named(w: str) -> u32 {
    if w == BLUEPRINT_NAMES[1] || w == "1" {
        1
    } else if w == BLUEPRINT_NAMES[2] || w == "2" {
        2
    } else {
        0
    }
}

/// Facing `facing` of an outline as a facing of the contact sheet (`view::SHEET`): side, front,
/// top.
pub fn sheet_facing(facing: u32) -> u32 {
    if facing == 0 { 0 } else if facing == 1 { 1 } else { 3 }
}

/// The world point of outline point `q` in facing `facing`'s plane (through the origin): side
/// (z, y) → (0, y, z), front (x, y) → (x, y, 0), top (x, z) → (x, 0, z).
pub fn world(facing: u32, q: vec2) -> vec3 {
    if facing == 0 {
        vec3(0.0, q.y, q.x)
    } else if facing == 1 {
        vec3(q.x, q.y, 0.0)
    } else {
        vec3(q.x, 0.0, q.y)
    }
}

/// World point `p` in facing `facing`'s outline coordinates (`world`'s inverse).
pub fn plane(facing: u32, p: vec3) -> vec2 {
    if facing == 0 {
        vec2(p.z, p.y)
    } else if facing == 1 {
        vec2(p.x, p.y)
    } else {
        vec2(p.x, p.z)
    }
}

/// The direction back towards the viewer in facing `facing` (the rays run the other way).
fn back(facing: u32) -> vec3 {
    axes(SHEET[sheet_facing(facing)]).0
}

/// Whether `q` is inside the closed polygon `pts` (even-odd).
pub fn inside(pts: [vec2], q: vec2) -> bool {
    let n = pts.len()
    var odd = false
    for i in 0..n {
        let a = pts[i]
        let b = pts[(i + 1) % n]
        if (a.y > q.y) != (b.y > q.y) {
            let x = a.x + (q.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if q.x < x {
                odd = !odd
            }
        }
    }
    odd
}

/// The outline as a fit's reference: for each pixel of `fv`, 1 inside the outline, else 0.
pub fn mask(fv: FitView, facing: u32, pts: [vec2]) -> Vec<u8> {
    let n = fv.res * fv.res
    var out: Vec<u8> = Vec::with_capacity(n)
    for i in 0..n {
        let (o, _) = fv.view.ray(f32(i % fv.res) + 0.5, f32(i / fv.res) + 0.5)
        out.push(if inside(pts, plane(facing, o)) { 1 } else { 0 })
    }
    out
}

/// The least distance of `field` along the line through outline point `q` (seen from
/// `facing`), searched over `reach` either side of the plane: positive outside the silhouette
/// (then it's the distance to it, for an exact distance), negative where the line passes
/// through the subject.
fn line_min<S: Surface>(field: S, facing: u32, q: vec2, reach: f32) -> f32 {
    let dir = -back(facing)
    let o = world(facing, q) - dir * reach
    var t = 0.0
    var least = 1.0e9
    for _ in 0..400 {
        let d = field.distance(o + dir * t)
        least = min(least, d)
        t += max(if d > 0.0 { 0.8 * d } else { -d }, 0.001)
        if t > 2.0 * reach {
            break
        }
    }
    least
}

/// Where the subject's silhouette misses the outline `pts` seen from `facing`: samples every
/// centimetre along it, each the signed distance from the outline to the silhouette (positive:
/// the subject reaches past the outline; negative: it falls short of it), then the worst
/// stretches. `reach` covers the subject's depth along the view.
pub fn report<S: Surface>(field: S, facing: u32, pts: [vec2], reach: f32) -> String {
    let n = pts.len()
    if n < 3 {
        return obj()
            .text("action", "blueprint")
            .text("error", "an outline needs three points or more")
            .done()
    }
    // Its winding, for which side is outward.
    var area = 0.0
    for i in 0..n {
        let a = pts[i]
        let b = pts[(i + 1) % n]
        area += a.x * b.y - b.x * a.y
    }
    let ccw = area > 0.0
    var at: Vec<vec2> = Vec::new()
    var miss: Vec<f32> = Vec::new()
    for i in 0..n {
        let a = pts[i]
        let b = pts[(i + 1) % n]
        let e = b - a
        let len = length(e)
        if len < 0.000001 {
            continue
        }
        let outward = if ccw { vec2(e.y, -e.x) / len } else { vec2(-e.y, e.x) / len }
        let steps = max(1, u32(len / 0.01))
        for s in 0..steps {
            let q = a + e * ((f32(s) + 0.5) / f32(steps))
            let m = line_min(field, facing, q, reach)
            var signed = 0.0
            if m > 0.0 {
                signed = -m
            } else {
                // The subject covers the outline here: how far outward it reaches, in 4 mm
                // steps, then halved down to 4 µm.
                var out = 0.0
                while out < 0.2 {
                    out += 0.004
                    if line_min(field, facing, q + outward * out, reach) > 0.0 {
                        break
                    }
                }
                var lo = max(out - 0.004, 0.0)
                var hi = out
                for _ in 0..10 {
                    let mid = 0.5 * (lo + hi)
                    if line_min(field, facing, q + outward * mid, reach) > 0.0 {
                        hi = mid
                    } else {
                        lo = mid
                    }
                }
                signed = 0.5 * (lo + hi)
            }
            at.push(q)
            miss.push(signed)
        }
    }
    var total = 0.0
    var worst = 0.0
    var near = 0
    for m in miss {
        total += abs(m)
        worst = max(worst, abs(m))
        if abs(m) <= 0.01 {
            near += 1
        }
    }
    let count = max(miss.len(), 1)
    // The stretches off by more than a centimetre, the same way, in order along the outline.
    var stretches: Vec<(vec2, f32, f32, u32)> = Vec::new()
    var i = 0
    while i < miss.len() {
        if abs(miss[i]) <= 0.01 {
            i += 1
            continue
        }
        let sign = miss[i] > 0.0
        var j = i
        var sum = 0.0
        var peak = 0.0
        var centre = vec2(0.0)
        while j < miss.len() && abs(miss[j]) > 0.01 && (miss[j] > 0.0) == sign {
            sum += miss[j]
            centre += at[j]
            if abs(miss[j]) > abs(peak) {
                peak = miss[j]
            }
            j += 1
        }
        let k = j - i
        stretches.push((centre / f32(k), sum / f32(k), peak, k))
        i = j
    }
    // The largest six by their peaks.
    var order: Vec<u32> = Vec::new()
    for s in 0..stretches.len() {
        order.push(s)
    }
    for a in 0..order.len() {
        for b in a + 1..order.len() {
            if abs(stretches[order[b]].2) > abs(stretches[order[a]].2) {
                let t = order[a]
                order[a] = order[b]
                order[b] = t
            }
        }
    }
    var list = list()
    for r in 0..min(order.len(), 6) {
        let (c, mean, peak, k) = stretches[order[r]]
        let w = obj()
            .vec2("at", c)
            .num("length_cm", f32(k))
            .num("mean_cm", 100.0 * mean)
            .num("peak_cm", 100.0 * peak)
            .text("so", if peak > 0.0 { "the subject reaches past the outline" } else {
                "the subject falls short of the outline"
            })
            .done()
        list.add(w.as_str())
    }
    let list = take list.done()
    obj()
        .text("action", "blueprint")
        .text("view", BLUEPRINT_NAMES[min(facing, 2)])
        .int("samples", miss.len())
        .num("mean_miss_cm", 100.0 * total / f32(count))
        .num("worst_miss_cm", 100.0 * worst)
        .num("within_1cm", f32(near) / f32(count))
        .raw("misses", list.as_str())
        .done()
}
