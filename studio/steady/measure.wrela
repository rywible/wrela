// A shot measured: its builds made and driven on the native host's GPU, each with one worker so
// its frames repeat exactly, and each build's crawl counted (studio/lookbook's
// `measures::Crawl`) over the same frames with the same keys, so the same camera.
//
// The ids' view runs first, and says each frame's pixels' kinds (each kind's outline taken in).
// Then each build: play (the program as it's shipped, with any `--set`) and each switch (play
// with it set), each after its settled twin (the same build dwelling on each frame's moment,
// which it's held against for its crawl of its own), and the reference if asked (at twice the
// size, brought down, each moment the mean of its frames). A build's heat is where its pixels
// stepped: a picture of the last frame in grey, the pixels that stepped lit from red (a step
// in the frames) to yellow (a step in a quarter of them or more).

use lookbook_tool::measures::{Crawl, NO_KIND, halved, luma, outlined}
use shots::Shot
use std::input::Script
use std::io::print
use std::tool::ToolError
use std::tool::blob::Data
use std::tool::drive
use std::tool::drive::Step
use std::tool::files
use std::tool::image
use std::tool::toolchain
use std::tool::toolchain::Set
use toolkit::driven::untrapped
use toolkit::whole::{blob_of, chunked, data_bytes, joined, write_file, write_png}

/// What a run measures: the shot; where its builds, its report and its pictures go (a root
/// path in a write root); the workspace's root; the screen's size; the step a pixel must pass
/// (of the 255 levels); play's own constants; whether the reference and the switches are
/// measured too, and each build's crawl of its own (`own`: against its settled twin, where the
/// shot's builds can dwell); how many times play is measured (its runs differ a little: the GPU's pixels
/// may differ by a level or two between runs of one build); and whether each build's heat is
/// written.
pub struct Options: Clone {
    pub shot: Shot,
    pub out: String,
    pub ws: String,
    pub width: u32 = 1280,
    pub height: u32 = 720,
    pub step: f32 = 15.0,
    pub sets: Vec<Set> = Vec::new(),
    pub reference: bool = false,
    pub own: bool = true,
    pub switches: bool = false,
    pub runs: u32 = 1,
    pub heat: bool = true,
}

/// A build's crawl: its name (`play`, `reference`, a switch's), what it is, each kind's crawl
/// (its pixels that stepped, in a thousand), each kind's crawl of its own (its pixels whose
/// difference from its settled twin's stepped: empty where that wasn't measured) and each
/// kind's pixels a frame, on average.
pub struct Row: Clone {
    pub name: String,
    pub about: String,
    pub crawl: Vec<f64>,
    pub own: Vec<f64>,
    pub pixels: Vec<f64>,
}

/// A run's report: the shot's name and package, the screen's size, the first frame measured and
/// how many, the step, the kinds' names, and each build's row, play's first.
pub struct Report: Clone {
    pub shot: String,
    pub program: String,
    pub width: u32,
    pub height: u32,
    pub first: u32,
    pub frames: u32,
    pub step: f32,
    pub kinds: Vec<String>,
    pub rows: Vec<Row>,
}

impl Report {
    /// The row named `name`.
    pub fn row(self, name: str) -> Option<Row> {
        for r in self.rows {
            if r.name.as_str() == name {
                return Some(r.clone())
            }
        }
        None
    }

    /// Build `name`'s crawl of kind `kind`, if both are there.
    pub fn crawl(self, name: str, kind: str) -> Option<f64> {
        let r = self.row(name)?
        for k in 0..self.kinds.len() {
            if self.kinds[k].as_str() == kind {
                return Some(r.crawl[k])
            }
        }
        None
    }

    /// Build `name`'s crawl of its own of kind `kind` (what it steps by that its settled twin
    /// doesn't), if both are there and it was measured.
    pub fn own(self, name: str, kind: str) -> Option<f64> {
        let r = self.row(name)?
        for k in 0..self.kinds.len() {
            if self.kinds[k].as_str() == kind && k < r.own.len() {
                return Some(r.own[k])
            }
        }
        None
    }

    /// The report as a table, a row a build and a column a kind, under a line that says what
    /// was measured; then each kind's pixels a frame, and what each switch is.
    pub fn text(self) -> String {
        var s = String::from(
            f"{self.shot} ({self.program}), {self.width}x{self.height}, frames {self.first} to {self.first + self.frames}: pixels in a thousand that step more than {self.step:.0} levels a frame\n\n| build |",
        )
        for k in self.kinds {
            s.push_str(f" {k} |")
        }
        s.push_str("\n|---|")
        for _ in self.kinds {
            s.push_str("---|")
        }
        for r in self.rows {
            s.push_str(f"\n| {r.name} |")
            for c in r.crawl {
                s.push_str(f" {c:.2} |")
            }
        }
        if self.rows.len() > 0 {
            s.push_str("\n| (pixels a frame) |")
            for p in self.rows[0].pixels {
                s.push_str(f" {p:.0} |")
            }
        }
        // Each build's own: what steps in it that doesn't in the reference.
        var any = false
        for r in self.rows {
            any = any || r.own.len() > 0
        }
        if any {
            s.push_str(
                f"\n\nits own: pixels in a thousand whose difference from the build's settled twin steps more than {self.step:.0} levels a frame (each moment dwelt on until nothing is left to come: what moves is in both, and taken out)\n\n| build |",
            )
            for k in self.kinds {
                s.push_str(f" {k} |")
            }
            s.push_str("\n|---|")
            for _ in self.kinds {
                s.push_str("---|")
            }
            for r in self.rows {
                if r.own.len() == 0 {
                    continue
                }
                s.push_str(f"\n| {r.name} |")
                for c in r.own {
                    s.push_str(f" {c:.2} |")
                }
            }
        }
        for r in self.rows {
            if r.about.len() > 0 {
                s.push_str(f"\n{r.name}: {r.about}")
            }
        }
        s
    }

    /// The report as JSON.
    pub fn json(self) -> String {
        var s = String::from(
            f"{{\"shot\": \"{self.shot}\", \"package\": \"{self.program}\", \"width\": {self.width}, \"height\": {self.height}, \"first\": {self.first}, \"frames\": {self.frames}, \"step\": {self.step}, \"builds\": [",
        )
        for i in 0..self.rows.len() {
            borrow r = self.rows[i]
            if i > 0 {
                s.push_str(", ")
            }
            s.push_str(f"{{\"build\": \"{r.name}\", \"crawl\": {{")
            for k in 0..self.kinds.len() {
                if k > 0 {
                    s.push_str(", ")
                }
                s.push_str(f"\"{self.kinds[k]}\": {r.crawl[k]:.4}")
            }
            s.push_str("}, \"own\": {")
            for k in 0..min(self.kinds.len(), r.own.len()) {
                if k > 0 {
                    s.push_str(", ")
                }
                s.push_str(f"\"{self.kinds[k]}\": {r.own[k]:.4}")
            }
            s.push_str("}, \"pixels\": {")
            for k in 0..self.kinds.len() {
                if k > 0 {
                    s.push_str(", ")
                }
                s.push_str(f"\"{self.kinds[k]}\": {r.pixels[k]:.1}")
            }
            s.push_str("}}")
        }
        s.push_str("]}\n")
        s
    }
}

/// How many distances the kinds' table tells apart: each a power of two of metres, 0 to 15.
pub const DISTANCES: u32 = 16

/// Each number an ids' view can show (a level over `id_step`, rounded), at each distance (the
/// whole power of two of its metres), as its kind in `shot`, or `NO_KIND`: the number's row of
/// `DISTANCES`, the first kind that takes it.
pub fn kinds_by_id(shot: Shot) -> Vec<u8> {
    var table: Vec<u8> = Vec::with_capacity(256 * DISTANCES)
    for _ in 0..256 * DISTANCES {
        table.push(NO_KIND)
    }
    for k in 0..shot.kinds.len() {
        borrow kind = shot.kinds[k]
        for id in kind.ids {
            for d in kind.nearer..min(kind.farther, DISTANCES) {
                let at = u32(id) * DISTANCES + d
                if table[at] == NO_KIND {
                    table[at] = u8(k)
                }
            }
        }
    }
    table
}

/// Each pixel's kind in an ids' view's frame (`rgba`, `w` to a row): its red level over
/// `id_step`, rounded, and its green over `id_step`, rounded down (how far off it is), as
/// `table` says, with each kind's outline taken in (`ground`).
pub fn kinds_in(rgba: [u8], w: u32, id_step: u32, table: [u8], ground: [bool]) -> Vec<u8> {
    let n = rgba.len() / 4
    let step = max(id_step, 1)
    var kind: Vec<u8> = Vec::with_capacity(n)
    for i in 0..n {
        let id = (u32(rgba[4 * i]) + step / 2) / step
        let d = min(u32(rgba[4 * i + 1]) / step, DISTANCES - 1)
        kind.push(table[min(id, 255) * DISTANCES + d])
    }
    outlined(kind, w, ground)
}

/// A build's heat as a picture (RGBA8): `last` (its last frame) in dim grey, and each pixel
/// that stepped `heat` times in `frames` lit, red for once, toward yellow for a quarter of the
/// frames or more.
pub fn heat_picture(last: [u8], heat: [u32], frames: u32) -> Vec<u8> {
    let l = luma(last)
    var out: Vec<u8> = Vec::with_capacity(last.len())
    let full = max(f32(frames) * 0.25, 1.0)
    for i in 0..l.len() {
        let g = l[i] * 0.4 * 255.0
        let n = if i < heat.len() { heat[i] } else { 0 }
        if n == 0 {
            out.push(u8(g + 0.5))
            out.push(u8(g + 0.5))
            out.push(u8(g + 0.5))
        } else {
            let t = min(f32(n) / full, 1.0)
            out.push(255)
            out.push(u8(30.0 + 225.0 * t + 0.5))
            out.push(0)
        }
        out.push(255)
    }
    out
}

/// The shot's package built into `out` (a root path) with `sets`.
fn built(o: Options, out: str, sets: take Vec<Set>) -> Result<(), ToolError> {
    var options = toolchain::options()
    options.timeout = 600.0
    var all = take sets
    for one in o.shot.always {
        all.push(one.clone())
    }
    options.set = take all
    let b = toolchain::build(f"{o.ws}/{o.shot.program}", out, options).wait()?
    if !b.ok {
        for d in b.diagnostics {
            if d.error {
                print(d.rendered.as_str())
            }
        }
        return Err(ToolError::new(f"{o.shot.program} didn't build into {out}"))
    }
    Ok(())
}

/// The build at `build` loaded at `width` × `height` with one worker, and run to the shot's
/// first measured frame.
fn started(o: Options, build: str, width: u32, height: u32) -> Result<drive::Build, ToolError> {
    var load = drive::gpu()
    load.width = width
    load.height = height
    load.workers = 1
    load.timeout = 600.0
    let b = drive::load(build, load).wait()?.build
    let _ = untrapped("init", drive::steps(b, [Step::Init], timeout: 600.0).wait()?)?
    // (A hundred frames a request: a request may take ten minutes at most, and a reference's
    // frame at a large size is a second or more.)
    var left = o.shot.settle
    while left > 0 {
        let n = min(left, 100)
        let before = [Step::Frames(n, o.shot.keys.clone())]
        let _ = untrapped("the frames before", drive::steps(b, before, timeout: 600.0).wait()?)?
        left -= n
    }
    Ok(b)
}

/// The build's next frame's screen (RGBA8).
fn screen(b: drive::Build, keys: Script) -> Result<Vec<u8>, ToolError> {
    let steps = [Step::Frames(1, keys.clone()), Step::Capture]
    var saw = untrapped("a frame", drive::steps(b, steps, timeout: 600.0).wait()?)?
    let shot = saw.captures.remove(0)
    Ok(joined(data_bytes(take shot.rgba)?))
}

/// Each measured frame's pixels' kinds (the first measured frame's, then each after), from the
/// ids' view built into `<out>/build/ids`.
fn kinds_of(o: Options) -> Result<Vec<Vec<u8>>, ToolError> {
    let build = String::from(f"{o.out}/build/ids")
    built(o, build.as_str(), o.shot.ids.clone())?
    let table = kinds_by_id(o.shot)
    var ground: Vec<bool> = Vec::new()
    for k in o.shot.kinds {
        ground.push(k.ground)
    }
    let b = started(o, build.as_str(), o.width, o.height)?
    var out: Vec<Vec<u8>> = Vec::new()
    for _ in 0..o.shot.frames + 1 {
        let rgba = screen(b, o.shot.keys.clone())?
        out.push(kinds_in(rgba, o.width, o.shot.id_step, table, ground))
    }
    let _ = drive::close(b).wait()
    Ok(out)
}

/// A frame's luma (0 to 1) as bytes, a level each: what a settled twin's frames are kept as.
pub fn levels(l: [f32]) -> Vec<u8> {
    var out: Vec<u8> = Vec::with_capacity(l.len())
    for x in l {
        out.push(u8(clamp(x, 0.0, 1.0) * 255.0 + 0.5))
    }
    out
}

/// How far a frame's luma `l` is from its settled twin's frame `r` (its levels), pixel by pixel:
/// what a crawl of its own is counted in. What moves the same in both is the same in both, and
/// isn't in the difference.
pub fn apart(l: [f32], r: [u8]) -> Vec<f32> {
    var out: Vec<f32> = Vec::with_capacity(l.len())
    for i in 0..min(l.len(), r.len()) {
        out.push(l[i] - f32(r[i]) / 255.0)
    }
    out
}

/// A build's next moment: dwelt on for `dwelt` frames, the last `mean` of them (drawn at twice
/// the size and brought down if `twice`) taken, the last of them (RGBA8, at the size) and
/// their lumas' mean. With `dwelt` 1, the next frame as it's drawn.
fn moment(
    o: Options,
    b: drive::Build,
    dwelt: u32,
    mean: u32,
    twice: bool,
) -> Result<(Vec<u8>, Vec<f32>), ToolError> {
    let dwelt = max(dwelt, 1)
    let mean = clamp(mean, 1, dwelt)
    // (A hundred frames a request, as `started`'s.)
    var left = dwelt - mean
    while left > 0 {
        let n = min(left, 100)
        let before = [Step::Frames(n, o.shot.keys.clone())]
        let _ = untrapped(
            "a moment's first frames",
            drive::steps(b, before, timeout: 600.0).wait()?,
        )?
        left -= n
    }
    var sum: Vec<f32> = Vec::new()
    var last: Vec<u8> = Vec::new()
    for _ in 0..mean {
        let drawn = screen(b, o.shot.keys.clone())?
        let rgba = if twice { halved(drawn, w: o.width * 2, h: o.height * 2) } else { take drawn }
        let l = luma(rgba)
        if sum.is_empty() {
            sum = take l
        } else {
            for i in 0..min(sum.len(), l.len()) {
                sum[i] += l[i]
            }
        }
        last = take rgba
    }
    if mean > 1 {
        for i in 0..sum.len() {
            sum[i] = sum[i] / f32(mean)
        }
    }
    Ok((take last, take sum))
}

/// How a build's frames are taken: at twice the size and brought down or not, each moment
/// dwelt on for `dwelt` frames and the last `mean` of them its frame.
pub struct Taken: Copy {
    pub twice: bool = false,
    pub dwelt: u32 = 1,
    pub mean: u32 = 1,
}

/// The row of the build named `name` (what it is, `about`): the shot's package built with
/// `sets` into `<out>/build/<dir>`, its frames taken as `how` says, its crawl counted against
/// `kinds`, and its heat written as `<out>/heat-<dir>.png`. With another build's frames to
/// hold it against (`against`, each one's levels: its settled twin's), its crawl of its own
/// too: the steps of its difference from them, and where, as `<out>/own-<dir>.png`. With
/// `keep`, its frames' levels come back (for a build held against it).
fn row_of(
    o: Options,
    name: str,
    about: str,
    dir: str,
    sets: take Vec<Set>,
    how: Taken,
    kinds: [Vec<u8>],
    against: [Vec<u8>],
    keep: bool,
) -> Result<(Row, Vec<Vec<u8>>), ToolError> {
    let build = String::from(f"{o.out}/build/{dir}")
    built(o, build.as_str(), take sets)?
    let scale = if how.twice { 2 } else { 1 }
    let b = started(o, build.as_str(), o.width * scale, o.height * scale)?
    let compared = against.len() == kinds.len()
    var crawl = Crawl::new(o.shot.kinds.len(), o.step / 255.0)
    var own = Crawl::new(o.shot.kinds.len(), o.step / 255.0)
    var kept: Vec<Vec<u8>> = Vec::new()
    var last: Vec<u8> = Vec::new()
    for f in 0..kinds.len() {
        let (rgba, l) = moment(o, b, how.dwelt, how.mean, how.twice)?
        if compared {
            own.add(apart(l, against[f]), kinds[f])
        }
        if keep {
            kept.push(levels(l))
        }
        crawl.add(take l, kinds[f])
        // (The middle frame as it was drawn, to lay a build beside its settled twin.)
        if o.heat && f == kinds.len() / 2 {
            let img = image::Image {
                width: o.width,
                height: o.height,
                rgba: Data::Blob(blob_of(chunked(rgba.clone()))?),
            }
            write_png(take img, f"{o.out}/frame-{dir}.png")?
        }
        last = take rgba
    }
    let _ = drive::close(b).wait()
    let steps = max(kinds.len(), 2) - 1
    if o.heat && !keep {
        let img = image::Image {
            width: o.width,
            height: o.height,
            rgba: Data::Blob(blob_of(chunked(heat_picture(last, crawl.heat, steps)))?),
        }
        write_png(take img, f"{o.out}/heat-{dir}.png")?
        if compared {
            let img = image::Image {
                width: o.width,
                height: o.height,
                rgba: Data::Blob(blob_of(chunked(heat_picture(last, own.heat, steps)))?),
            }
            write_png(take img, f"{o.out}/own-{dir}.png")?
        }
    }
    var per: Vec<f64> = Vec::new()
    var per_own: Vec<f64> = Vec::new()
    var pixels: Vec<f64> = Vec::new()
    for k in 0..o.shot.kinds.len() {
        per.push(crawl.per_thousand(k))
        if compared {
            per_own.push(own.per_thousand(k))
        }
        pixels.push(crawl.looked[k] / f64(steps))
    }
    Ok(
        (
            Row {
                name: String::from(name),
                about: String::from(about),
                crawl: per,
                own: per_own,
                pixels,
            },
            kept,
        ),
    )
}

/// `sets` and the constants that make a build of `shot` dwell `frames` frames on each moment.
pub fn dwelling(shot: Shot, sets: [Set], frames: u32) -> Vec<Set> {
    var out: Vec<Set> = Vec::new()
    for one in sets {
        out.push(one.clone())
    }
    for one in shot.hold {
        out.push(one.clone())
    }
    if shot.dwell.len() > 0 {
        out.push(Set { name: String::from(shot.dwell), value: String::from(f"{frames}") })
    }
    out
}

/// The row of a build as it plays (named `name`, what it is `about`, built with `sets`), with
/// its crawl of its own where the shot's builds can dwell (`Shot::settled`) and `o.own` asks:
/// its settled twin measured first (into `<out>/build/<dir>-settled`), then the build held
/// against it.
fn played(
    o: Options,
    name: str,
    about: str,
    dir: str,
    sets: [Set],
    kinds: [Vec<u8>],
) -> Result<Row, ToolError> {
    var against: Vec<Vec<u8>> = Vec::new()
    if o.own && o.shot.settled > 1 && o.shot.dwell.len() > 0 {
        let (_, frames) = row_of(
            o,
            f"{name}, settled",
            "",
            f"{dir}-settled",
            dwelling(o.shot, sets, o.shot.settled),
            Taken { dwelt: o.shot.settled },
            kinds: kinds,
            against: against,
            keep: true,
        )?
        against = take frames
    }
    var mine: Vec<Set> = Vec::new()
    for one in sets {
        mine.push(one.clone())
    }
    let (row, _) = row_of(
        o,
        name,
        about,
        dir,
        take mine,
        Taken {},
        kinds: kinds,
        against: against,
        keep: false,
    )?
    Ok(row)
}

/// `name` as a directory's name: its `=`, `.` and spaces dashes.
pub fn dir_of(name: str) -> String {
    var out = String::new()
    for i in 0..name.len() {
        // (`=` is 61, `.` 46, a space 32.)
        let b = name.byte(i)
        if b == 61 || b == 46 || b == 32 {
            out.push_str("-")
        } else {
            out.push_str(name.slice(i, i + 1))
        }
    }
    out
}

/// The shot measured as `o` says: its report, also written as `<out>/crawl.json` and
/// `<out>/crawl.md`, each build's heat beside them.
pub fn measure(o: Options) -> Result<Report, ToolError> {
    let _ = files::make_dirs(o.out.as_str()).wait()?
    let kinds = kinds_of(o)?
    var rows: Vec<Row> = Vec::new()
    rows.push(played(o, "play", "", "play", o.sets, kinds)?)
    for r in 1..max(o.runs, 1) {
        rows.push(played(o, f"play, run {r + 1}", "", f"play-{r + 1}", o.sets, kinds)?)
    }
    if o.reference {
        // (Dwelling only where the shot's builds can: a held shot's reference is the mean of
        // its next frames as they come.)
        let sets = if o.shot.dwell.len() > 0 {
            dwelling(o.shot, o.shot.reference, o.shot.dwelt)
        } else {
            o.shot.reference.clone()
        }
        let (row, _) = row_of(
            o,
            "reference",
            "every pixel met every frame at twice the size and brought down, each moment the mean of its frames: the scene drawn sharp, whose steps are its motion's own",
            "reference",
            take sets,
            Taken { twice: true, dwelt: o.shot.dwelt, mean: o.shot.mean },
            kinds: kinds,
            against: [],
            keep: false,
        )?
        rows.push(take row)
    }
    if o.switches {
        for s in o.shot.switches {
            var sets = o.sets.clone()
            for one in s.sets {
                sets.push(one.clone())
            }
            rows.push(played(o, s.name, s.about, dir_of(s.name).as_str(), sets, kinds)?)
        }
    }
    var names: Vec<String> = Vec::new()
    for k in o.shot.kinds {
        names.push(String::from(k.name))
    }
    let report = Report {
        shot: String::from(o.shot.name),
        program: String::from(o.shot.program),
        width: o.width,
        height: o.height,
        first: o.shot.settle,
        frames: o.shot.frames,
        step: o.step,
        kinds: names,
        rows,
    }
    write_file(f"{o.out}/crawl.json", chunked(Vec::from(report.json().as_bytes())))?
    write_file(f"{o.out}/crawl.md", chunked(Vec::from(f"{report.text()}\n".as_bytes())))?
    Ok(report)
}
