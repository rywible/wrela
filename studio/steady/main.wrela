// The steady tool (`wrela tool steady`): how unsteady a scene's picture is while its camera
// moves, as numbers. A flicker or a crawl is in how frames differ, which a still can't show and
// an eye on a few stills can't judge; this counts it, kind of pixel by kind (the cathedral's,
// the rock's, the sea's), names where it is, and says which of the scene's switches it follows.
//
// ```text
// wrela tool steady -- <out-dir> [--shot <name>] [--size WxH] [--frames N] [--settle N]
//     [--step LEVELS] [--set NAME=VALUE ...] [--runs N] [--switches] [--reference]
//     [--no-own] [--no-heat]
// ```
//
// It builds the shot's program (shots.wrela; `sailing`, the opening's, unless `--shot` names
// another: `held` is the same shot with the scene stopped, where nothing should step at all)
// into `<out-dir>/build`, with any `--set` for play's own, and drives each build on the native
// host's GPU with one worker (measure.wrela): the ids' view, play, and with `--switches` play
// again with each of the shot's switches set. It prints two tables and writes them as
// `<out-dir>/crawl.md` and `crawl.json`:
//
// - Each build's crawl of each kind: the pixels in a thousand that step by more than `--step`
//   levels (15) of luma from one frame to the next (`lookbook_tool::measures::Crawl`). What
//   truly moves steps too, and the sharper it's drawn the more, so this alone doesn't say what
//   is wrong: a soft picture steps less than a sharp one.
// - Each build's crawl of its own: the same count in its difference from its settled twin, the
//   same build dwelling on each frame's moment until nothing is left to come (`Shot::settled`).
//   Motion is in both and drops out; what's left is what the drawing does by spreading its
//   work over frames: a pixel met late, a fill that hops, a history that trails. Its target is
//   none, for every kind. `--no-own` leaves it out (it takes most of the time).
//
// `--reference` adds the scene drawn sharp (every pixel met every frame, at twice the size,
// each moment the mean of its frames): how much the motion itself steps when nothing is
// softened. `heat-<build>.png` shows where each build's pixels stepped, `own-<build>.png` where
// its own did, and `frame-<build>.png` is its middle frame (`frame-<build>-settled.png` its
// settled twin's, to lay beside it). `--runs N` measures play N times, to see how far its runs differ. Paths are
// from the workspace's directory (the root `ws`).
//
// The crawl depends on the screen's size and the frames, so numbers compare only between runs
// of the same shot at the same `--size`, `--frames` and `--settle`.

use measure::{Options, measure}
use shots::{NAMES, set_of, shot}
use std::io::print
use std::tool::args
use std::tool::files::rooted
use toolkit::command::size_of

pub const USAGE: Text = "usage: wrela tool steady -- <out-dir> [--shot <name>] [--size WxH] [--frames N] [--settle N] [--step LEVELS] [--set NAME=VALUE ...] [--runs N] [--switches] [--reference] [--no-own] [--no-heat]"

/// The workspace's root.
pub const WS: Text = "ws"

/// The options the command line gives, or what's wrong with it.
pub fn parse_args(given: [String]) -> Result<Options, String> {
    let Some(first) = shot(NAMES[0]) else { panic("the first name is a shot") }
    var o = Options { shot: first, out: String::new(), ws: String::from(WS) }
    var out: Option<String> = None
    var frames: Option<u32> = None
    var settle: Option<u32> = None
    var k = 0
    while k < given.len() {
        let a = given[k].as_str()
        let next = if k + 1 < given.len() { given[k + 1].clone() } else { String::new() }
        if a == "--shot" {
            let Some(s) = shot(next.as_str()) else {
                return Err(String::from(f"no shot {next}: the shots are {NAMES[0]} and {NAMES[1]}"))
            }
            o.shot = take s
            k += 1
        } else if a == "--size" {
            let Some((w, h)) = size_of(next.as_str()) else {
                return Err(String::from("--size takes WxH, as 1280x720"))
            }
            o.width = w
            o.height = h
            k += 1
        } else if a == "--frames" {
            let Some(n) = next.as_str().parse_u32() else {
                return Err(String::from("--frames takes how many frames are measured"))
            }
            if n == 0 {
                return Err(String::from("--frames takes at least 1"))
            }
            frames = Some(n)
            k += 1
        } else if a == "--settle" {
            let Some(n) = next.as_str().parse_u32() else {
                return Err(String::from("--settle takes the frames run before the first measured"))
            }
            settle = Some(n)
            k += 1
        } else if a == "--step" {
            let Some(n) = next.as_str().parse_u32() else {
                return Err(String::from("--step takes levels of the 255, as 15"))
            }
            o.step = f32(n)
            k += 1
        } else if a == "--set" {
            let Some(s) = set_of(next.as_str()) else {
                return Err(String::from("--set takes NAME=VALUE"))
            }
            o.sets.push(take s)
            k += 1
        } else if a == "--runs" {
            let Some(n) = next.as_str().parse_u32() else {
                return Err(String::from("--runs takes how many times play is measured"))
            }
            if n == 0 {
                return Err(String::from("--runs takes at least 1"))
            }
            o.runs = n
            k += 1
        } else if a == "--switches" {
            o.switches = true
        } else if a == "--reference" {
            o.reference = true
        } else if a == "--no-own" {
            o.own = false
        } else if a == "--no-heat" {
            o.heat = false
        } else if out.is_none() {
            let Some(path) = rooted(WS, a) else {
                return Err(String::from(f"{a} isn't a directory in the workspace"))
            }
            out = Some(take path)
        } else {
            return Err(String::from(USAGE))
        }
        k += 1
    }
    let Some(path) = take out else { return Err(String::from(USAGE)) }
    o.out = take path
    if let Some(n) = frames {
        o.shot.frames = n
    }
    if let Some(n) = settle {
        o.shot.settle = n
    }
    Ok(o)
}

pub fn tool() -> u32 {
    let o = match parse_args(args()) {
        Ok(o) => take o,
        Err(e) => {
            print(e.as_str())
            return 2
        },
    }
    match measure(o) {
        Ok(report) => {
            print(report.text().as_str())
            0
        },
        Err(e) => {
            print(f"steady: {e.message()}")
            1
        },
    }
}
