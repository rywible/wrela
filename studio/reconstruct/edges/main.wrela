// Production temporal reconstruction on a moving analytic field. Reference pixels integrate
// visible foreground/background exactly in linear RGB. They never use temporal history.
// Warmup advances output time; collect freezes one named frame for the requested observation.

use engine::frame::{full, fullscreen}
use engine::neural::eval_gpu
use reconstruction_model::main::{MODEL, baseline, features, linear, view}
use engine::supersample::{Moment, Reference}
use engine::temporal::{
    ReconstructionSample, Resolve, neighbourhoods, reconstruction_samples, resolve,
}
use engine::view::{Camera, camera, first_camera, jitter_of}
use field::{Field, case, front_at, front_coverage, pixel, point}
use reconstruction_patch::network as patch
use std::collections::swap
use std::gpu::{
    Compare, Depth, DepthTexture, FragCoord, GlobalId, GpuBuffer, Half2, Rgba16Float, Sampler,
    Slots, Texture, WithDepth, begin_pass, begin_pass_with_depth, begin_screen_pass, buffer,
    depth_texture, dispatch, draw, label, sampler, texture, writable_texture, copy, write,
}

@fragment
fn sampled(p: FragCoord, f: Field, tick: u32, jitter: vec2, scale: vec2) -> WithDepth<vec4> {
    let at = (p.position.xy - jitter) / scale
    WithDepth { color: point(f, at, tick), depth: if front_at(f, at, tick) { 0.5 } else { 0.25 } }
}

@fragment
fn moved(p: FragCoord, f: Field, tick: u32, jitter: vec2, scale: vec2) -> vec4 {
    let at = (p.position.xy - jitter) / scale
    if front_at(f, at, tick) { vec4(f.speed * scale.x, 0.0, 0.5, 1.0) } else { vec4(0.0) }
}

@compute(64)
fn integrated(f: Field, tick: u32, width: u32, count: u32, out: mut Slots<vec4>, id: GlobalId) {
    if id.x < count {
        out[id] = pixel(f, vec2(f32(id.x % width), f32(id.x / width)), tick)
    }
}

@fragment
fn shown(p: FragCoord, image: Texture<Rgba16Float>) -> vec4 {
    let c = max(image.load(x: u32(p.position.x), y: u32(p.position.y)).rgb, vec3(0.0))
    vec4(c / (vec3(1.0) + c), 1.0)
}

pub struct State {
    width: u32,
    height: u32,
    divisor: u32,
    cells: u32,
    shot: u32,
    tick: u32,
    collecting: bool,
    captured_count: u32,
    captured_tick: u32,
    captured_shot: u32,
    collect_rows: bool,
    reset: bool,
    cam: Camera,
    scene: Texture<Rgba16Float>,
    depth: DepthTexture,
    last_depth: DepthTexture,
    motion: Texture<Rgba16Float>,
    last_motion: Texture<Rgba16Float>,
    means: Texture<Rgba16Float>,
    spreads: Texture<Rgba16Float>,
    current: Texture<Rgba16Float>,
    last: Texture<Rgba16Float>,
    captured: GpuBuffer<vec4>,
    truth: GpuBuffer<vec4>,
    visibility: GpuBuffer<vec4>,
    no_net: GpuBuffer<Half2>,
    rgb_net: GpuBuffer<Half2>,
    rgb_words: u32,
    rgb_enabled: bool,
    patch_enabled: bool,
    patch_trained: bool,
    patch_fast: bool,
    patch_history: f32,
    patch_source: u32,
    previous_shape: vec4,
    captured_previous_shape: vec4,
    exported_source: GpuBuffer<vec4>,
    patch_expanded: GpuBuffer<vec4>,
    patch_words: u32,
    patch_frames: u32,
    patch_net: GpuBuffer<Half2>,
    patch_cells: GpuBuffer<patch::Cell>,
    patch_inputs: GpuBuffer<patch::Input>,
    exported_patch: GpuBuffer<patch::Input>,
    exported_cells: GpuBuffer<patch::Cell>,
    raw_enabled: bool,
    raw_count: u32,
    raw_history: GpuBuffer<raw::Sample>,
    exported_raw: GpuBuffer<raw::Sample>,
    samples: GpuBuffer<ReconstructionSample>,
    exported_samples: GpuBuffer<ReconstructionSample>,
    linear: Sampler,
}

pub fn init() -> State {
    State {
        width: 0,
        height: 0,
        divisor: 1,
        cells: 0,
        shot: 0,
        tick: 0,
        collecting: false,
        captured_count: 0,
        captured_tick: 0,
        captured_shot: 0,
        collect_rows: true,
        reset: true,
        cam: first_camera(vec3(0.0), vec3(0.0, 0.0, -1.0), 1.0, width: 1, height: 1),
        scene: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        last_depth: depth_texture(width: 1, height: 1),
        motion: texture(width: 1, height: 1),
        last_motion: texture(width: 1, height: 1),
        means: writable_texture(width: 1, height: 1),
        spreads: writable_texture(width: 1, height: 1),
        current: texture(width: 1, height: 1),
        last: texture(width: 1, height: 1),
        captured: buffer(1),
        truth: buffer(1),
        visibility: buffer(1),
        no_net: buffer(1),
        rgb_net: buffer(1),
        rgb_words: 0,
        rgb_enabled: false,
        patch_enabled: false,
        patch_trained: false,
        patch_fast: false,
        patch_history: 0.0,
        patch_source: 0,
        previous_shape: vec4(1.0, 0.0, 0.0, 0.0),
        captured_previous_shape: vec4(0.0),
        exported_source: buffer(1),
        patch_expanded: buffer(1),
        patch_words: 0,
        patch_frames: 0,
        patch_net: buffer(1),
        patch_cells: buffer(1),
        patch_inputs: buffer(1),
        exported_patch: buffer(1),
        exported_cells: buffer(1),
        raw_enabled: false,
        raw_count: 0,
        raw_history: buffer(1),
        exported_raw: buffer(1),
        samples: buffer(1),
        exported_samples: buffer(1),
        linear: sampler(),
    }
}

pub fn configure(s: mut State, divisor: u32, cells: u32, shot: u32) {
    assert(divisor >= 1 && divisor <= 4 && shot < 8, "unknown analytic configuration")
    assert(cells == 0 || divisor == 1, "analytic truth has output resolution")
    s.divisor = divisor
    s.cells = cells
    s.shot = shot
}

pub fn ready(s: State) -> u32 {
    u32(s.width > 0 && s.height > 0)
}

/// The exact integral takes one evaluation, regardless of a quadrature-grid request.
pub fn sample_count(s: State) -> u32 {
    1
}

pub fn collect(s: mut State, width: u32, height: u32) {
    assert(s.width == width && s.height == height, "capture changed image size")
    s.collecting = true
    s.captured_count = 0
    s.captured_tick = s.tick
    s.captured_shot = s.shot
}

fn resize(s: mut State, width: u32, height: u32) {
    if s.width == width && s.height == height { return }
    assert(!s.collecting, "resize during capture")
    s.width = width
    s.height = height
    let (w, h) = (width / s.divisor, height / s.divisor)
    assert(w > 0 && h > 0 && width % s.divisor == 0 && height % s.divisor == 0)
    s.scene = texture(width: w, height: h)
    s.depth = depth_texture(width: w, height: h)
    s.last_depth = depth_texture(width: w, height: h)
    s.motion = texture(width: w, height: h)
    s.last_motion = texture(width: w, height: h)
    s.means = writable_texture(width: w, height: h)
    s.spreads = writable_texture(width: w, height: h)
    if s.raw_enabled { s.raw_history = buffer(raw::stride(w, h) * raw::HISTORY) }
    s.raw_count = 0
    s.patch_frames = 0
    if s.patch_enabled { s.patch_cells = buffer(w * h) }
    s.current = texture(width, height)
    s.last = texture(width, height)
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    resize(mut s, width, height)
    let f = case(s.shot)
    if s.collecting && s.cells > 0 {
        s.captured = buffer(width * height)
        dispatch(
            integrated.bind(
                f,
                tick: s.tick,
                width: width,
                count: width * height,
                out: mut s.captured,
            ),
            over: width * height,
        )
        s.captured_count = 1
        return
    }
    let (w, h) = (s.scene.width(), s.scene.height())
    let scale = vec2(f32(w) / f32(width), f32(h) / f32(height))
    let jitter = jitter_of(s.tick)
    s.cam = camera(
        vec3(0.0),
        vec3(0.0, 0.0, -1.0),
        1.0,
        w,
        h,
        frame: s.tick,
        time: f32(s.tick) / 60.0,
        last: s.cam,
    )
    swap(mut s.depth, mut s.last_depth)
    swap(mut s.motion, mut s.last_motion)
    swap(mut s.current, mut s.last)
    label("analytic samples")
    let p = begin_pass_with_depth(mut s.scene, mut s.depth)
    draw(
        p,
        full.bind(z: 0.5),
        sampled.bind(f, tick: s.tick, jitter: jitter, scale: scale),
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
    let p = begin_pass(mut s.motion)
    fullscreen(p, moved.bind(f, tick: s.tick, jitter: jitter, scale: scale))
    p.end()
    if s.raw_enabled {
        if s.reset { s.raw_count = 0 }
        s.raw_count = min(s.raw_count + 1, raw::HISTORY)
        dispatch(
            raw::retain.bind(
                s.scene,
                s.depth,
                s.motion,
                s.divisor,
                s.raw_history.span_mut((s.tick % raw::HISTORY) * raw::stride(w, h), w * h),
            ),
            over: w * h,
        )
    }
    if s.patch_enabled {
        label("patch encode")
        if s.reset { s.patch_frames = 0 }
        dispatch(
            patch::encode.bind(
                s.scene,
                s.depth,
                s.motion,
                s.last_depth,
                s.last,
                s.linear,
                s.divisor,
                s.tick,
                s.patch_frames,
                u32(s.patch_trained),
                u32(s.patch_fast),
                s.patch_net.items(),
                s.patch_expanded.items(),
                mut s.patch_cells,
            ),
            over: w * h,
        )
        if s.collecting && s.collect_rows {
            s.patch_inputs = buffer(w * h)
            dispatch(
                patch::export_inputs.bind(
                    s.scene,
                    s.depth,
                    s.motion,
                    s.last_depth,
                    s.last,
                    s.linear,
                    s.divisor,
                    s.tick,
                    s.patch_frames,
                    mut s.patch_inputs,
                ),
                over: w * h,
            )
        }
    } else {
        dispatch(neighbourhoods.bind(s.scene, mut s.means, mut s.spreads), over: s.scene)
    }
    let r = Resolve {
        cam: s.cam,
        out: vec2(f32(width), f32(height)),
        blend: 0.12,
        fresh: u32(s.tick == 0 || s.reset),
        jitter,
        last_jitter: jitter_of(if s.tick == 0 { 0 } else { s.tick - 1 }),
        moving: vec4(0.0, 0.0, f32(width), f32(height)),
        settled: f32(s.tick),
    }
    if !s.patch_enabled && ((s.collecting && s.collect_rows) || s.rgb_enabled) {
        s.samples = buffer(width * height)
        dispatch(
            reconstruction_samples.bind(
                r,
                s.scene,
                s.depth,
                s.last_depth,
                s.motion,
                s.last_motion,
                s.last,
                s.means,
                s.spreads,
                s.linear,
                out: mut s.samples,
            ),
            over: width * height,
        )
    }
    label(if s.patch_enabled { "patch decode" } else { "temporal control" })
    let p = begin_pass(mut s.current)
    if s.patch_enabled {
        if s.patch_history > 0.0 && s.patch_source == 1 {
            fullscreen(
                p,
                reconstruction_patch::history::reconstruct_source.bind(
                    s.patch_cells.items(),
                    s.last,
                    s.linear,
                    w,
                    h,
                    s.divisor,
                    s.tick,
                    s.patch_frames,
                    s.patch_history,
                    vec4(f.period, f.width, f.offset, f.speed),
                    s.previous_shape,
                ),
            )
        } else if s.patch_history > 0.0 {
            fullscreen(
                p,
                reconstruction_patch::history::reconstruct.bind(
                    s.patch_cells.items(),
                    s.depth,
                    s.last_depth,
                    s.motion,
                    s.last_motion,
                    s.last,
                    s.linear,
                    s.divisor,
                    s.tick,
                    s.patch_frames,
                    s.patch_history,
                ),
            )
        } else if s.patch_fast {
            fullscreen(
                p,
                patch::reconstruct_fast.bind(s.patch_cells.items(), w, h, s.divisor, s.tick),
            )
        } else {
            fullscreen(p, patch::reconstruct.bind(s.patch_cells.items(), w, h, s.divisor, s.tick))
        }
    } else if s.raw_enabled {
        fullscreen(
            p,
            raw::reconstruct.bind(s.raw_history.items(), w, h, s.divisor, s.tick, s.raw_count),
        )
    } else if s.rgb_enabled {
        fullscreen(
            p,
            corrected.bind(s.samples.items(), s.rgb_net.items(), width, height, s.divisor, jitter),
        )
    } else {
        fullscreen(
            p,
            resolve.bind(
                r,
                s.scene,
                s.depth,
                s.last_depth,
                s.motion,
                s.last_motion,
                s.last,
                s.means,
                s.spreads,
                s.linear,
                s.no_net.items(),
            ),
        )
    }
    p.end()
    if s.patch_enabled { s.patch_frames = min(s.patch_frames + 1, 16) }
    s.captured_previous_shape = s.previous_shape
    s.previous_shape = vec4(f.period, f.width, f.offset, f.speed)
    s.reset = false
    label("diagnostic view")
    let screen = begin_screen_pass(clear: vec4(0.0))
    fullscreen(screen, shown.bind(s.current))
    screen.present()
    if s.collecting {
        var reference = Reference::new(width, height, Moment { frame: s.tick, revision: s.shot })
        assert(reference.add(s.current, Moment { frame: s.tick, revision: s.shot }).is_ok())
        s.captured = reference.image().unwrap()
        s.captured_count = 1
    } else {
        s.tick += 1
    }
}

pub fn publish(s: mut State) -> u32 {
    assert(s.collecting && s.captured_count == 1, "publish requires one captured frame")
    s.collecting = false
    s.tick += 1
    s.captured_count
}

/// Training evidence in the newest buffer; valid only for a captured production frame.
pub fn publish_samples(s: mut State) -> u32 {
    assert(s.cells == 0 && s.captured_count == 1, "no production samples captured")
    s.exported_samples = buffer(s.samples.len())
    copy(from: s.samples.items(), to: s.exported_samples.items_mut())
    s.samples.len()
}

// Weight upload is explicit and complete before any rendering; a half-written net cannot run.
pub fn model_begin(s: mut State, words: u32) {
    assert(!s.raw_enabled && !s.patch_enabled && words == (MODEL.size() + 1) / 2)
    s.rgb_enabled = false
    s.rgb_words = 0
    s.rgb_net = buffer(words)
}

pub fn model_word(s: mut State, index: u32, bits: u32) {
    assert(index == s.rgb_words && index < s.rgb_net.len())
    assert((bits & 0x7c00) != 0x7c00 && ((bits >> 16) & 0x7c00) != 0x7c00, "non-finite weight")
    write(mut s.rgb_net, index, [Half2 { bits }])
    s.rgb_words += 1
}

pub fn model_end(s: mut State) {
    assert(s.rgb_words == (MODEL.size() + 1) / 2)
    s.rgb_enabled = true
}

@fragment
fn corrected(
    p: FragCoord,
    rows: [ReconstructionSample],
    weights: [Half2],
    width: u32,
    height: u32,
    divisor: u32,
    jitter: vec2,
) -> vec4 {
    let row = rows[u32(p.position.y) * width + u32(p.position.x)]
    let base = baseline(row)
    if row.v[21] > 0.5 { return vec4(base, row.v[23]) }
    let x = features(row, p.position.xy, vec2(f32(width), f32(height)), divisor, jitter)
    let out = eval_gpu(MODEL, weights, x)
    vec4(linear(view(base) + vec3(out[0], out[1], out[2])), row.v[23])
}

// A continuous instrument starts without consuming a frame. Its target and visibility are
// computed only AFTER reconstruction, in separate buffers that no decoder can read.
pub fn prepare_sequence(s: mut State, width: u32, height: u32, start: u32, inputs: u32) {
    assert(inputs <= 1 && (inputs == 0 || s.patch_enabled))
    resize(mut s, width, height)
    s.tick = start
    s.collect_rows = inputs == 1
}

pub fn cut(s: mut State, shot: u32, reset: u32) {
    assert(!s.collecting && shot < 8 && reset <= 1)
    s.shot = shot
    if reset == 1 { s.reset = true }
}

pub fn publish_truth(s: mut State) -> u32 {
    assert(!s.collecting && s.captured_count == 1)
    s.truth = buffer(s.width * s.height)
    dispatch(
        integrated.bind(
            case(s.captured_shot),
            tick: s.captured_tick,
            width: s.width,
            count: s.width * s.height,
            out: mut s.truth,
        ),
        over: s.width * s.height,
    )
    s.width * s.height
}

@compute(64)
fn visibility_at(f: Field, tick: u32, width: u32, count: u32, out: mut Slots<vec4>, id: GlobalId) {
    if id.x < count {
        let at = vec2(f32(id.x % width), f32(id.x / width))
        // R: foreground area fraction; G: its horizontal velocity in output pixels/frame.
        out[id] = vec4(front_coverage(f, at, tick), f.speed, 0.0, 1.0)
    }
}

pub fn publish_visibility(s: mut State) -> u32 {
    assert(!s.collecting && s.captured_count == 1)
    s.visibility = buffer(s.width * s.height)
    dispatch(
        visibility_at.bind(
            case(s.captured_shot),
            tick: s.captured_tick,
            width: s.width,
            count: s.width * s.height,
            out: mut s.visibility,
        ),
        over: s.width * s.height,
    )
    s.width * s.height
}

/// An explicit fixture-only control. Never silently combines with a trained RGB correction.
pub fn decoder(s: mut State, mode: u32) {
    assert(mode <= 2 && !s.rgb_enabled && s.width == 0)
    s.raw_enabled = mode == 1
    s.patch_enabled = mode == 2
    if s.raw_enabled { s.collect_rows = false }
}

/// Observation only, after capture. Its RGBA tags and motion/depth are not display pixels.
pub fn publish_raw(s: mut State) -> u32 {
    assert(s.raw_enabled && s.cells == 0 && !s.collecting && s.captured_count == 1)
    s.exported_raw = buffer(s.raw_history.len())
    copy(from: s.raw_history.items(), to: s.exported_raw.items_mut())
    s.raw_history.len()
}

pub fn patch_begin(s: mut State, words: u32) {
    assert(s.patch_enabled && words == (patch::MODEL.size() + 1) / 2)
    s.patch_trained = false
    s.patch_words = 0
    s.patch_net = buffer(words)
    s.patch_expanded = buffer(patch::MODEL.size() / 4)
}

pub fn patch_word(s: mut State, index: u32, bits: u32) {
    assert(index == s.patch_words && index < s.patch_net.len())
    assert((bits & 0x7c00) != 0x7c00 && ((bits >> 16) & 0x7c00) != 0x7c00)
    write(mut s.patch_net, index, [Half2 { bits }])
    s.patch_words += 1
}

pub fn patch_end(s: mut State) {
    assert(s.patch_enabled && s.patch_words == (patch::MODEL.size() + 1) / 2)
    dispatch(
        reconstruction_patch::vector::expand.bind(s.patch_net.items(), mut s.patch_expanded),
        over: s.patch_expanded.len(),
    )
    s.patch_trained = true
}

pub fn publish_patch(s: mut State) -> u32 {
    assert(
        s.patch_enabled && s.collect_rows && s.cells == 0 && !s.collecting && s.captured_count == 1,
    )
    s.exported_patch = buffer(s.patch_inputs.len())
    copy(from: s.patch_inputs.items(), to: s.exported_patch.items_mut())
    s.patch_inputs.len()
}

pub fn publish_cells(s: mut State) -> u32 {
    assert(s.patch_enabled && s.cells == 0 && !s.collecting && s.captured_count == 1)
    s.exported_cells = buffer(s.patch_cells.len())
    copy(from: s.patch_cells.items(), to: s.exported_cells.items_mut())
    s.patch_cells.len()
}

pub fn patch_kernel(s: mut State, fast: u32) {
    assert(s.patch_enabled && fast <= 1 && s.width == 0)
    s.patch_fast = fast == 1
}

// A measured constant-share ablation before learning output-resolution history confidence.
pub fn patch_history(s: mut State, permille: u32) {
    assert(s.patch_enabled && permille <= 1000 && s.width == 0)
    s.patch_history = f32(permille) / 1000.0
}

// Observation only, after reconstruction: raw point colour, output-pixel motion and depth.
// Reuse the diagnostic export buffer; no geometry readback allocation in normal rendering.
pub fn publish_patch_geometry(s: mut State) -> u32 {
    assert(s.patch_enabled && s.collect_rows && !s.collecting && s.captured_count == 1)
    let n = s.scene.width() * s.scene.height()
    s.exported_raw = buffer(n)
    dispatch(
        raw::retain.bind(s.scene, s.depth, s.motion, s.divisor, mut s.exported_raw),
        over: n,
    )
    n
}

// This changes the information/cost budget: source geometry queries are full-stack only.
pub fn patch_source_geometry(s: mut State, source: u32) {
    assert(s.patch_enabled && source <= 1 && s.width == 0)
    s.patch_source = source
}

// Preserve the exact geometry-only source parameters used by the full-stack pipeline.
pub fn publish_patch_source(s: mut State) -> u32 {
    assert(s.patch_enabled && s.patch_source == 1 && s.collect_rows && !s.collecting)
    let f = case(s.captured_shot)
    s.exported_source = buffer(2)
    write(
        mut s.exported_source,
        0,
        [
            vec4(f.period, f.width, f.offset, f.speed),
            s.captured_previous_shape,
        ],
    )
    2
}
