// Nonlinear lighting diagnostic: production leaf_response on authored smooth surface fields.
use engine::light::{Light, Lit}
use std::gpu::FragCoord

pub const REFERENCE_GRID: u32 = 8

pub fn shade(f: field::Field, material: u32, p: vec2, tick: u32) -> vec3 {
    let colour = if material == 0 { f.front } else if material == 1 { f.light } else { f.dark }
    if f.radiance < 3 {
        let c = field::radiance_terms(f, material)
        return c[0] + c[1] * p.x + c[2] * p.y + c[3] * p.x * p.y
    }
    let variant = f.radiance - 3
    let frequency = if variant % 2 == 0 { 0.035 } else { 0.19 }
    let x = (p.x - if material == 0 { f.speed * f32(tick) } else { 0.0 }) * frequency
    let y = p.y * frequency
    let phase = f32(material) * 1.7 + f32(variant) * 0.31
    let n = normalize(vec3(0.65 * sin(x + phase) + 0.2 * sin(y * 1.7),
        0.8 + 0.45 * cos(x * 0.7 - y), 0.55 * cos(y + phase) + 0.25 * sin(x * 1.3)))
    let t = f32(tick) * 0.025
    let sun = normalize(vec3(0.6 * cos(t), 0.7, 0.5 * sin(t) - 0.3))
    let light = Light { sun, exposure: 1.0, sun_colour: vec3(3.3, 2.75, 2.05), eye: 4.0, horizon: 0.0 }
    let intensity = if variant >= 2 && tick >= 16 { 0.35 } else { 1.0 }
    let surface = Lit {
        albedo: vec3(0.04) + colour / (vec3(1.0) + colour) * 0.6,
        n,
        sun: intensity * (0.65 + 0.35 * sin(x * 0.8 + y * 0.6 + phase)),
        sky: vec3(0.2, 0.28, 0.4) * intensity,
        through: vec3(0.12, 0.3, 0.06),
        rough: engine::impostor::LEAF_ROUGH,
        reflected: vec3(0.16, 0.2, 0.3) * intensity,
    }
    let depth = 0.8 + 0.7 * sin(x * 0.5 - y * 0.9 + phase)
    engine::impostor::leaf_response(light, surface, vec3(0.0), vec3(0.0, 0.8, 1.0), depth)
}

// Reference: source pulse antiderivatives for each subrectangle's material areas,
// then midpoint quadrature of smooth per-material lighting. Decoder never calls this.
pub fn reference(f: field::Field, at: vec2, tick: u32) -> vec4 {
    let step = 1.0 / f32(REFERENCE_GRID)
    var sum = vec3(0.0)
    var correction = vec3(0.0)
    for y in 0..REFERENCE_GRID {
        for x in 0..REFERENCE_GRID {
            let lo = at + vec2(f32(x), f32(y)) * step
            let hi = lo + vec2(step)
            let areas = field::rectangle_areas(f, lo, hi, tick)
            let p = (lo + hi) * 0.5
            for m in 0..3 {
                if areas[m] <= 0.0 { continue }
                let value = shade(f, m, p, tick) * areas[m] - correction
                let next = sum + value
                correction = (next - sum) - value
                sum = next
            }
        }
    }
    vec4(sum, 1.0)
}

@fragment
pub fn direct(p: FragCoord, f: field::Field, tick: u32) -> vec4 {
    let at = floor(p.position.xy)
    let weights = source_bilinear::moments(at, tick, vec4(f.period, f.width, f.offset, f.speed), f.checker)
    var rgb = vec3(0.0)
    for m in 0..3 {
        let w = weights[m]
        if w.x > 0.0 { rgb += shade(f, m, at + w.yz / w.x, tick) * w.x }
    }
    vec4(rgb, 1.0)
}
