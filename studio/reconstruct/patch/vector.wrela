// Fixed-shape vector form of the scalar encoder, generated from MODEL's row-major layout.
// Weights are unpacked once at load time. Constant indices avoid private-array dynamic indexing
// and repeated half unpacking in the inner products. This is the SAME trained network.
use std::gpu::{GlobalId, Half2, Slots}
use engine::neural::half_at

@compute(64)
pub fn expand(weights: [Half2], out: mut Slots<vec4>, id: GlobalId) {
    if id.x < 315 {
        let k = id.x * 4
        out[id] = vec4(
            half_at(weights, k),
            half_at(weights, k + 1),
            half_at(weights, k + 2),
            half_at(weights, k + 3),
        )
    }
}

pub fn eval(weights: [vec4], x: [f32; 48]) -> [vec4; 3] {
    let x0 = vec4(x[0], x[1], x[2], x[3])
    let x1 = vec4(x[4], x[5], x[6], x[7])
    let x2 = vec4(x[8], x[9], x[10], x[11])
    let x3 = vec4(x[12], x[13], x[14], x[15])
    let x4 = vec4(x[16], x[17], x[18], x[19])
    let x5 = vec4(x[20], x[21], x[22], x[23])
    let x6 = vec4(x[24], x[25], x[26], x[27])
    let x7 = vec4(x[28], x[29], x[30], x[31])
    let x8 = vec4(x[32], x[33], x[34], x[35])
    let x9 = vec4(x[36], x[37], x[38], x[39])
    let x10 = vec4(x[40], x[41], x[42], x[43])
    let x11 = vec4(x[44], x[45], x[46], x[47])
    let h1_0 = max(
        weights[192].x +
