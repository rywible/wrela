// Direct output-resolution history controls. The fixed-input entry uses only renderer
// buffers. The source-geometry entry is a separate full-stack pipeline with authored
// geometry parameters, never source colours, integrated coverage or future input.
use engine::view::jitter_of
use network::{decoded, linear, view}
use std::gpu::{DepthTexture, FragCoord, GlobalId, Rgba16Float, Sampler, Slots, Texture}

pub fn share(age: u32, maximum: f32, valid: bool) -> f32 {
    if !valid || age == 0 { 0.0 } else {
        min(clamp(maximum, 0.0, 1.0), f32(age) / f32(age + 1))
    }
}

// Analytic fixture's authored geometry only: period, width, offset, speed. No colours.
// Two causal source queries per output pixel are extra full-stack work, not fixed input.
pub fn source_geometry(at: vec2, tick: u32, shape: vec4) -> vec3 {
    let x = at.x - shape.z - shape.w * f32(tick)
    let front = x - floor(x / shape.x) * shape.x < shape.y
    vec3(if front { shape.w } else { 0.0 }, 0.0, if front { 0.5 } else { 0.25 })
}

fn observe(
    current: vec4,
    at: vec2,
    geometry: vec3,
    old_geometry: vec3,
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    age: u32,
    maximum: f32,
    divisor: u32,
) -> confidence::Input {
    let previous = at - geometry.xy
    let size = vec2(f32(history.width()), f32(history.height()))
    let valid = previous.x >= 0.0 &&
        previous.y >= 0.0 &&
        previous.x < size.x &&
        previous.y < size.y &&
        abs(geometry.z - old_geometry.z) / max(geometry.z, 1.0e-6) < 0.05 &&
        length(geometry.xy - old_geometry.xy) < 0.05
    let weight = share(age, maximum, valid)
    let old_color = if weight > 0.0 {
        view(history.sample_level(linear_sampler, previous / size).rgb)
    } else { vec3(0.0) }
    confidence::Input {
        current: vec4(view(current.rgb), weight),
        old: vec4(old_color, 1.0 / f32(divisor)),
        context: vec4(geometry.xy, f32(min(age, 16)) / 16.0, current.a),
    }
}

fn sampled_input(
    at: vec2,
    cells: [network::Cell],
    depth: DepthTexture,
    previous_depth: DepthTexture,
    motion: Texture<Rgba16Float>,
    previous_motion: Texture<Rgba16Float>,
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    divisor: u32,
    tick: u32,
    age: u32,
    maximum: f32,
) -> confidence::Input {
    let width = depth.width()
    let height = depth.height()
    let current = decoded(at, cells, width, height, divisor, tick)
    let d = f32(divisor)
    let limit = vec2i(i32(width) - 1, i32(height) - 1)
    let near = clamp(vec2i(floor(at / d + jitter_of(tick))), vec2i(0), limit)
    let geometry = vec3(
        motion.load(x: u32(near.x), y: u32(near.y)).xy * d,
        depth.load(x: u32(near.x), y: u32(near.y)),
    )
    let previous = at - geometry.xy
    let last_jitter = jitter_of(if tick > 0 { tick - 1 } else { 0 })
    let old = clamp(vec2i(floor(previous / d + last_jitter)), vec2i(0), limit)
    let old_geometry = vec3(
        previous_motion.load(x: u32(old.x), y: u32(old.y)).xy * d,
        previous_depth.load(x: u32(old.x), y: u32(old.y)),
    )
    observe(current, at, geometry, old_geometry, history, linear_sampler, age, maximum, divisor)
}

fn source_input(
    at: vec2,
    cells: [network::Cell],
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    width: u32,
    height: u32,
    divisor: u32,
    tick: u32,
    age: u32,
    maximum: f32,
    current_shape: vec4,
    previous_shape: vec4,
) -> confidence::Input {
    let current = decoded(at, cells, width, height, divisor, tick)
    let geometry = source_geometry(at, tick, current_shape)
    let old_geometry = source_geometry(
        at - geometry.xy,
        if tick > 0 { tick - 1 } else { 0 },
        previous_shape,
    )
    observe(current, at, geometry, old_geometry, history, linear_sampler, age, maximum, divisor)
}

@fragment
pub fn reconstruct(
    p: FragCoord,
    cells: [network::Cell],
    depth: DepthTexture,
    previous_depth: DepthTexture,
    motion: Texture<Rgba16Float>,
    previous_motion: Texture<Rgba16Float>,
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    divisor: u32,
    tick: u32,
    age: u32,
    maximum: f32,
    gate: [vec4],
    trained: u32,
) -> vec4 {
    let row = sampled_input(
        p.position.xy,
        cells,
        depth,
        previous_depth,
        motion,
        previous_motion,
        history,
        linear_sampler,
        divisor,
        tick,
        age,
        maximum,
    )
    vec4(linear(confidence::prediction(row, gate, trained)), row.context.w)
}

@fragment
pub fn reconstruct_source(
    p: FragCoord,
    cells: [network::Cell],
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    width: u32,
    height: u32,
    divisor: u32,
    tick: u32,
    age: u32,
    maximum: f32,
    current_shape: vec4,
    previous_shape: vec4,
    gate: [vec4],
    trained: u32,
) -> vec4 {
    let row = source_input(
        p.position.xy,
        cells,
        history,
        linear_sampler,
        width,
        height,
        divisor,
        tick,
        age,
        maximum,
        current_shape,
        previous_shape,
    )
    vec4(linear(confidence::prediction(row, gate, trained)), row.context.w)
}

// Export before reconstruction, only for requested diagnostic/training captures.
// These records contain no target; truth is a separate pass after reconstruction.
@compute(64)
pub fn export_source(
    cells: [network::Cell],
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    width: u32,
    height: u32,
    divisor: u32,
    tick: u32,
    age: u32,
    maximum: f32,
    current_shape: vec4,
    previous_shape: vec4,
    out: mut Slots<confidence::Input>,
    id: GlobalId,
) {
    let w = history.width()
    if id.x < w * history.height() {
        out[id] = source_input(
            vec2(f32(id.x % w) + 0.5, f32(id.x / w) + 0.5),
            cells,
            history,
            linear_sampler,
            width,
            height,
            divisor,
            tick,
            age,
            maximum,
            current_shape,
            previous_shape,
        )
    }
}

@test
fn fresh_invalid_and_cold_history_weights_are_bounded() {
    assert(share(0, 0.9, valid: true) == 0.0)
    assert(share(7, 0.9, valid: false) == 0.0)
    assert(share(1, 0.9, valid: true) == 0.5)
    assert(share(16, 0.9, valid: true) == 0.9)
    assert(share(16, -1.0, valid: true) == 0.0)
    assert(share(3, 2.0, valid: true) == 0.75)
}

@test
fn source_geometry_translation_preserves_visibility_and_motion() {
    let shape = vec4(5.375, 0.9, 0.31, 0.375)
    let front = vec2(1.11, 2.0)
    let background = vec2(1.41, 2.0)
    assert(source_geometry(front, 0, shape) == vec3(0.375, 0.0, 0.5))
    assert(source_geometry(background, 0, shape) == vec3(0.0, 0.0, 0.25))
    for tick in [1, 7, 37] {
        let shift = vec2(shape.w * f32(tick), 0.0)
        assert(source_geometry(front + shift, tick, shape) == source_geometry(front, 0, shape))
        assert(
            source_geometry(background + shift, tick, shape) ==
                source_geometry(background, 0, shape),
        )
    }
    assert(
        source_geometry(front - vec2(shape.x, 0.0), 0, shape) == source_geometry(front, 0, shape),
    )
}

// Untrained control: identical bilinear colour and source-history rule, without neural cells.
@fragment
pub fn reconstruct_source_bilinear(
    p: FragCoord,
    scene: Texture<Rgba16Float>,
    history: Texture<Rgba16Float>,
    linear_sampler: Sampler,
    divisor: u32,
    tick: u32,
    age: u32,
    maximum: f32,
    current_shape: vec4,
    previous_shape: vec4,
) -> vec4 {
    let at = p.position.xy
    let q = at / f32(divisor) + jitter_of(tick) - vec2(0.5)
    let base = floor(q)
    let f = q - base
    let limit = vec2(f32(scene.width() - 1), f32(scene.height() - 1))
    let a = clamp(base, vec2(0.0), limit)
    let b = clamp(base + vec2(1.0, 0.0), vec2(0.0), limit)
    let c = clamp(base + vec2(0.0, 1.0), vec2(0.0), limit)
    let d = clamp(base + vec2(1.0), vec2(0.0), limit)
    let ca = scene.load(x: u32(a.x), y: u32(a.y))
    let cb = scene.load(x: u32(b.x), y: u32(b.y))
    let cc = scene.load(x: u32(c.x), y: u32(c.y))
    let cd = scene.load(x: u32(d.x), y: u32(d.y))
    let wa = (1.0 - f.x) * (1.0 - f.y)
    let wb = f.x * (1.0 - f.y)
    let wc = (1.0 - f.x) * f.y
    let wd = f.x * f.y
    let color = ca.rgb * wa + cb.rgb * wb + cc.rgb * wc + cd.rgb * wd
    let current = vec4(linear(view(color)), ca.a)
    let geometry = source_geometry(at, tick, current_shape)
    let old_geometry = source_geometry(at - geometry.xy, if tick > 0 { tick - 1 } else { 0 }, previous_shape)
    let row = observe(current, at, geometry, old_geometry, history, linear_sampler, age, maximum, divisor)
    vec4(linear(mix(row.current.rgb, row.old.rgb, row.current.w)), row.context.w)
}
