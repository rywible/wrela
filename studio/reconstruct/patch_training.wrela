// End-to-end gradients through four overlapping input-resolution polynomial encoders.
// Capture features are causal GPU observations. Pixel-integrated targets are read separately.
// Entire analytic cases stay disjoint; a validation loss does not certify recurrent quality.
use engine::neural::{Adam, Pass, backward, forward, halves, start, unhalves}
use engine::noise::rand
use engine::view::jitter_of
use reconstruction_patch::network::{MODEL, query, view}
use std::io::print
use std::tool::{ToolError, files, time}
use toolkit::whole::{chunked, read_file, write_file}
use training::{floats, number, text_file, word}

struct Capture {
    width: u32,
    height: u32,
    divisor: u32,
    tick: u32,
    inputs: Vec<f32>,
    truth: Vec<f32>,
}

fn append(
    data: mut Vec<Capture>,
    reference: [f32],
    inputs: take Vec<f32>,
    width: u32,
    height: u32,
    divisor: u32,
    tick: u32,
) -> Result<(), ToolError> {
    if reference.len() != width * height * 4 { return Err(ToolError::new("patch reference size")) }
    var truth: Vec<f32> = Vec::with_capacity(width * height * 3)
    for i in 0..width * height {
        if reference[i * 4 + 3] != 1.0 { return Err(ToolError::new("patch reference alpha")) }
        let c = view(vec3(reference[i * 4], reference[i * 4 + 1], reference[i * 4 + 2]))
        for channel in 0..3 { truth.push(c[channel]) }
    }
    let count = (width / divisor) * (height / divisor)
    if inputs.len() != count * 52 { return Err(ToolError::new("patch input layout")) }
    let jitter = jitter_of(tick)
    for i in 0..count {
        let a = i * 52
        let c = view(vec3(inputs[a + 48], inputs[a + 49], inputs[a + 50]))
        for channel in 0..3 {
            if abs(inputs[a + 12 + channel] - c[channel]) > 1.0e-5 {
                return Err(ToolError::new("patch center color/features disagree"))
            }
        }
        if abs(inputs[a + 38] - jitter.x) > 1.0e-6 ||
            abs(inputs[a + 39] - jitter.y) > 1.0e-6 ||
            abs(inputs[a + 40] - 1.0 / f32(divisor)) > 1.0e-6 ||
            (inputs[a + 44] != 0.0 && inputs[a + 44] != 1.0) {
            return Err(ToolError::new("patch timing/scale/history metadata disagree"))
        }
    }
    data.push(Capture { width, height, divisor, tick, inputs, truth })
    Ok(())
}

fn add(data: mut Vec<Capture>, directory: str) -> Result<u32, ToolError> {
    let sequence = files::stat(f"{directory}/sequence.txt").wait().is_ok()
    let meta = text_file(if sequence { f"{directory}/sequence.txt" } else {
        f"{directory}/capture.txt"
    })?
    if meta.as_str().find("scene=analytic/slats-checkerboard\n").is_none() ||
        number(meta.as_str(), "decoder")? != 2 {
        return Err(ToolError::new("patch training requires causal patch captures"))
    }
    let width = number(meta.as_str(), "width")?
    let height = number(meta.as_str(), "height")?
    let shot = number(meta.as_str(), "shot")?
    if width == 0 || height == 0 || width % 12 != 0 || height % 12 != 0 || shot >= 8 {
        return Err(ToolError::new("invalid patch capture dimensions or case"))
    }
    if sequence {
        if number(meta.as_str(), "cut_at")? != 0 ||
            number(meta.as_str(), "training_inputs")? != 1 ||
            meta
                .as_str()
                .find(
                    "reference=analytic_pixel_integral_after_reconstruction_never_decoder_input\n",
                )
                .is_none() {
            return Err(
                ToolError::new("patch training clip needs exported inputs and one complete case"),
            )
        }
        let first = number(meta.as_str(), "start_frame")?
        let frames = number(meta.as_str(), "frames")?
        if frames == 0 || frames > 300 { return Err(ToolError::new("patch clip length")) }
        for frame in 0..frames {
            for divisor in 1..5 {
                let stem = f"{directory}/scale-{divisor}/{frame}"
                let reference = floats(read_file(f"{stem}.truth32f", "clip patch reference")?)?
                let inputs = floats(read_file(f"{stem}.patch32f", "clip patch inputs")?)?
                append(
                    mut data,
                    reference,
                    take inputs,
                    width,
                    height,
                    divisor,
                    tick: first + frame,
                )?
            }
        }
    } else {
        if meta.as_str().find("reference=exact_box_integral_of_analytic_field\n").is_none() {
            return Err(ToolError::new("patch reference must be independently integrated"))
        }
        let tick = number(meta.as_str(), "simulation_frame")?
        let reference = floats(read_file(f"{directory}/reference.rgba32f", "patch reference")?)?
        for divisor in 1..5 {
            let inputs = floats(
                read_file(f"{directory}/temporal-{divisor}x.patch32f", "patch inputs")?,
            )?
            append(mut data, reference, take inputs, width, height, divisor, tick)?
        }
    }
    Ok(shot)
}

fn target(c: Capture, pixel: u32) -> vec3 {
    vec3(c.truth[pixel * 3], c.truth[pixel * 3 + 1], c.truth[pixel * 3 + 2])
}

/// Return unclamped named-view prediction and its zero-network bilinear baseline.
fn prediction(c: Capture, weights: [f32], pixel: u32) -> (vec3, vec3) {
    let at = vec2(f32(pixel % c.width) + 0.5, f32(pixel / c.width) + 0.5)
    let q = query(at, c.width / c.divisor, c.height / c.divisor, c.divisor, jitter_of(c.tick))
    var base = vec3(0.0)
    var residual = vec3(0.0)
    for k in 0..4 {
        let a = q.indices[k] * 52
        base += vec3(c.inputs[a + 48], c.inputs[a + 49], c.inputs[a + 50]) * q.weights[k]
        let p = forward(MODEL, weights, c.inputs, x_at: a)
        for channel in 0..3 {
            for j in 0..4 {
                residual[channel] += p.out[channel * 4 + j] * q.basis[k][j] * q.weights[k]
            }
        }
    }
    let b = view(base)
    (b + residual, b)
}

/// Single-pixel mean RGB squared error and exact derivative through all four encoders.
/// Optimize the unclamped prediction: an out-of-range output must still receive a gradient.
fn loss_gradient(c: Capture, weights: [f32], pixel: u32, g: mut Vec<f32>) -> f32 {
    let at = vec2(f32(pixel % c.width) + 0.5, f32(pixel / c.width) + 0.5)
    let q = query(at, c.width / c.divisor, c.height / c.divisor, c.divisor, jitter_of(c.tick))
    var passes: Vec<Pass> = Vec::new()
    var base = vec3(0.0)
    var residual = vec3(0.0)
    for k in 0..4 {
        let a = q.indices[k] * 52
        base += vec3(c.inputs[a + 48], c.inputs[a + 49], c.inputs[a + 50]) * q.weights[k]
        passes.push(forward(MODEL, weights, c.inputs, x_at: a))
        for channel in 0..3 {
            for j in 0..4 {
                residual[channel] += passes[k].out[channel * 4 + j] * q.basis[k][j] * q.weights[k]
            }
        }
    }
    let e = view(base) + residual - target(c, pixel)
    var none: Vec<f32> = Vec::new()
    for k in 0..4 {
        var dout: Vec<f32> = Vec::from([0.0; 12])
        for channel in 0..3 {
            for j in 0..4 {
                dout[channel * 4 + j] = (2.0 / 3.0) * e[channel] * q.weights[k] * q.basis[k][j]
            }
        }
        backward(
            MODEL,
            weights,
            c.inputs,
            passes[k],
            dout,
            mut g,
            mut none,
            x_at: q.indices[k] * 52,
        )
    }
    dot(e, e) / 3.0
}

fn zeros(n: u32) -> Vec<f32> {
    var out: Vec<f32> = Vec::with_capacity(n)
    for _ in 0..n { out.push(0.0) }
    out
}

fn score(data: [Capture], weights: [f32]) -> (f64, f64) {
    var base: f64 = 0.0
    var learned: f64 = 0.0
    var count: u32 = 0
    for c in data {
        // Match the deployed architecture: encode each input once, then decode all outputs.
        // This also makes full-pixel validation practical instead of re-encoding four cells
        // for every output pixel on the CPU.
        let input_count = (c.width / c.divisor) * (c.height / c.divisor)
        var encoded: Vec<f32> = Vec::with_capacity(input_count * 12)
        for i in 0..input_count {
            let p = forward(MODEL, weights, c.inputs, x_at: i * 52)
            for v in p.out { encoded.push(v) }
        }
        for pixel in 0..c.width * c.height {
            let at = vec2(f32(pixel % c.width) + 0.5, f32(pixel / c.width) + 0.5)
            let q = query(
                at,
                c.width / c.divisor,
                c.height / c.divisor,
                c.divisor,
                jitter_of(c.tick),
            )
            var color = vec3(0.0)
            var residual = vec3(0.0)
            for k in 0..4 {
                let a = q.indices[k] * 52
                color += vec3(c.inputs[a + 48], c.inputs[a + 49], c.inputs[a + 50]) * q.weights[k]
                for channel in 0..3 {
                    for j in 0..4 {
                        residual[channel] += encoded[q.indices[k] * 12 + channel * 4 + j] *
                            q.basis[k][j] *
                            q.weights[k]
                    }
                }
            }
            let b = view(color)
            let t = target(c, pixel)
            let e = clamp(b + residual, vec3(0.0), vec3(0.9999)) - t
            let before = b - t
            learned += f64(dot(e, e))
            base += f64(dot(before, before))
            count += 3
        }
    }
    (base / f64(count), learned / f64(count))
}

fn run(manifest: str, steps: u32, seed: u32, initial: str) -> Result<(), ToolError> {
    let list = text_file(manifest)?
    var train: Vec<Capture> = Vec::new()
    var validation: Vec<Capture> = Vec::new()
    var train_mask: u32 = 0
    var validation_mask: u32 = 0
    for (a, b) in list.as_str().split("\n") {
        let line = list.as_str().slice(a, b)
        if line.is_empty() { continue }
        let Some(at) = line.find(",") else {
            return Err(ToolError::new("patch manifest role,run-id"))
        }
        let role = line.slice(0, at)
        let id = line.slice(at + 1, line.len())
        if id.find("/").is_some() || id.find("..").is_some() || id.is_empty() {
            return Err(ToolError::new("invalid patch run id"))
        }
        let directory = f"out/runs/{id}"
        if role == "train" {
            train_mask |= 1 << add(mut train, directory.as_str())?
        } else if role == "validate" {
            validation_mask |= 1 << add(mut validation, directory.as_str())?
        } else { return Err(ToolError::new("unknown patch dataset role")) }
    }
    if train_mask == 0 || validation_mask == 0 || (train_mask & validation_mask) != 0 {
        return Err(ToolError::new("patch training/validation need disjoint complete cases"))
    }
    var weights = if initial.is_empty() { start(MODEL, seed) } else {
        floats(read_file(initial, "initial patch weights")?)?
    }
    if weights.len() != MODEL.size() { return Err(ToolError::new("initial patch model size")) }
    if initial.is_empty() {
        let offsets = MODEL.offsets()
        for i in offsets[4]..MODEL.size() { weights[i] = 0.0 }
    }
    let now = time::utc_now().wait()?
    let directory = f"out/models/patch-{now.seconds}-{now.nanos}"
    if files::stat(directory.as_str()).wait().is_ok() {
        return Err(ToolError::new("patch model exists"))
    }
    let _ = files::write(f"{directory}/dataset.txt", list.as_bytes()).wait()?
    let about = f"architecture=48-16-16-12 input-resolution overlapping bilinear RGB residual polynomials\nweights={MODEL.size()}\ntraining_case_mask={train_mask}\nvalidation_case_mask={validation_mask}\nsteps={steps}\nbatch=128\nseed={seed}\ninitial={initial}\nloss=unclamped exposure-1 Reinhard linear RGB MSE after four-cell polynomial decoding\nrate=0.002 linearly decaying to 0.0002\nscope=full-pixel one-step development validation; continuous GPU rollout required\n"
    let _ = files::write(f"{directory}/model.txt", about.as_bytes()).wait()?
    print(
        f"patch train: {directory}, {train.len()} training captures, {validation.len()} validation captures",
    )
    var adam = Adam::new(MODEL.size(), rate: 0.002)
    var curve = String::from("step,batch_view_mse\n")
    for step in 0..steps {
        adam.rate = 0.002 * (1.0 - 0.9 * f32(step) / f32(steps))
        var g = zeros(MODEL.size())
        var loss = 0.0
        for k in 0..128 {
            let index = u32(rand(seed * 7919 + step, k * 2) * f32(train.len())) % train.len()
            borrow c = train[index]
            let pixel = u32(rand(seed * 7919 + step, k * 2 + 1) * f32(c.width * c.height)) %
                (c.width * c.height)
            loss += loss_gradient(c, weights, pixel, mut g) / 128.0
        }
        for i in 0..g.len() { g[i] /= 128.0 }
        if (bitcast_u32(loss) & 0x7f800000) == 0x7f800000 {
            return Err(ToolError::new("patch loss became non-finite"))
        }
        adam.step(mut weights, g)
        if step % 100 == 0 || step + 1 == steps {
            print(f"patch train: step {step + 1}/{steps}, batch view MSE {loss:.8}")
            curve.push_str(f"{step + 1},{loss:.10}\n")
        }
    }
    for w in weights {
        if (bitcast_u32(w) & 0x7f800000) == 0x7f800000 {
            return Err(ToolError::new("patch weight became non-finite"))
        }
    }
    let packed = halves(weights)
    for p in packed {
        if (p.bits & 0x7c00) == 0x7c00 || ((p.bits >> 16) & 0x7c00) == 0x7c00 {
            return Err(ToolError::new("patch weight overflows half"))
        }
    }
    let quantized = unhalves(packed, MODEL.size())
    print("patch train: evaluating all validation pixels with half-quantized weights")
    let (base, learned) = score(validation, quantized)
    print(f"patch train: one-step validation MSE {base:.9} -> {learned:.9}")
    var raw: Vec<u8> = Vec::new()
    for w in weights { word(mut raw, bitcast_u32(w)) }
    write_file(f"{directory}/weights.f32", chunked(take raw))?
    var half: Vec<u8> = Vec::new()
    for p in packed { word(mut half, p.bits) }
    write_file(f"{directory}/weights.half", chunked(take half))?
    let _ = files::write(f"{directory}/curve.csv", curve.as_bytes()).wait()?
    let report = f"zero_patch_view_mse,learned_half_view_mse\n{base:.12},{learned:.12}\n"
    let _ = files::write(f"{directory}/one-step.csv", report.as_bytes()).wait()?
    Ok(())
}

pub fn tool(given: [String]) -> u32 {
    if given.len() < 4 || given.len() > 5 { return 2 }
    let Some(steps) = given[2].as_str().parse_u32() else { return 2 }
    let Some(seed) = given[3].as_str().parse_u32() else { return 2 }
    if steps == 0 || steps > 100000 || seed > 10000 { return 2 }
    let result = if given.len() == 5 {
        run(given[1].as_str(), steps, seed, given[4].as_str())
    } else { run(given[1].as_str(), steps, seed, "") }
    match result {
        Ok(()) => 0,
        Err(e) => {
            print(f"patch train: {e.message()}")
            1
        },
    }
}

@test
fn polynomial_decoder_gradient_matches_finite_differences() {
    var inputs = zeros(4 * 52)
    for i in 0..inputs.len() { inputs[i] = rand(73, i) * 0.7 }
    let c = Capture {
        width: 4,
        height: 4,
        divisor: 2,
        tick: 5,
        inputs,
        truth: Vec::from([0.27; 48]),
    }
    var weights = start(MODEL, 19)
    // Positive biases keep this finite-difference probe away from ReLU's kink.
    let offsets = MODEL.offsets()
    for i in 0..16 {
        weights[offsets[1] + i] = 0.4
        weights[offsets[3] + i] = 0.4
    }
    var g = zeros(MODEL.size())
    let _ = loss_gradient(c, weights, 5, mut g)
    var witnessed = false
    for k in [0, 17, 288, 767, 780, 811, 1018, 1058, 1080, 1183, 1250, 1259] {
        let was = weights[k]
        weights[k] = was + 0.001
        let (a, _) = prediction(c, weights, 5)
        weights[k] = was - 0.001
        let (b, _) = prediction(c, weights, 5)
        weights[k] = was
        let ta = a - target(c, 5)
        let tb = b - target(c, 5)
        let derivative = (dot(ta, ta) - dot(tb, tb)) / 0.006
        assert(
            abs(g[k] - derivative) < 0.002 * max(1.0, abs(derivative)),
            f"patch gradient {k}: {g[k]} vs {derivative}",
        )
        if abs(derivative) > 0.01 { witnessed = true }
    }
    assert(witnessed, "gradient test probed only inactive weights")
}
