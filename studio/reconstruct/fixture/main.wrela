// First instrument scene: bare ground and sky at one fixed time and camera.
use engine::frame::{Aim, Frame, Quality, Shared}
use engine::light::sunlight
use engine::probes::grid
use engine::supersample::Moment
use engine::terrain::Clipmap
use engine::view::first_camera
use frame_transitions::bare::{AHEAD, Bare, START, SUN, air_of, bare}
use session::Session

const MOMENT = Moment { frame: 0, revision: 1 }

pub struct State { capture: Session<Bare> }

pub fn init() -> State {
    let air = air_of(SUN)
    let frame: Frame<Shared> = Frame::new(
        Quality { scale: 1.0, measured: false, pace: false },
        sunlight(air),
        air,
        Clipmap::new(levels: 6, finest: 0.5),
        first_camera(START, START + AHEAD, 0.82, width: 192, height: 108),
        grid(START.xz, cols: 17, spacing: 4.0, low: -8.0, high: 24.0, voxel: 2.0),
        START.xz,
    )
    State { capture: Session::new(take frame, bare()) }
}

pub fn configure(s: mut State, divisor: u32, cells: u32, shot: u32) {
    assert(shot == 0, "the bare scene has one view")
    s.capture.configure(divisor, cells)
}

pub fn ready(s: State) -> u32 {
    u32(s.capture.ready())
}

pub fn collect(s: mut State, width: u32, height: u32) {
    s.capture.collect(width, height, MOMENT)
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    let aim = Aim { eye: START, at: START + AHEAD, fovy: 0.82, moving_at: START }
    s.capture.draw(aim, time: 0.0, width: width, height: height, moment: MOMENT)
}

pub fn publish(s: mut State) -> u32 {
    s.capture.publish()
}

pub fn sample_count(s: State) -> u32 {
    s.capture.sample_count()
}
