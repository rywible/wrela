// Continuous analytic clips, including cold starts and a declared scene cut. Truth and
// visibility are separate observation passes after the causal reconstruction, never inputs.
use main::{call, finite_floats, floats, frames, upload_gate, upload_model, upload_raw_kernel}
use std::io::print
use std::tool::{ToolError, drive, files}
use std::tool::drive::{Scalar, Step}
use toolkit::driven::untrapped
use toolkit::whole::{chunked, data_bytes, joined, read_file, write_file}

pub struct Spec: Copy {
    pub width: u32,
    pub height: u32,
    pub warmup: u32,
    pub start: u32,
    pub length: u32,
    pub shot: u32,
    pub cut_at: u32,
    pub reset_cut: u32,
    pub decoder: u32,
    pub raw_specialize: u32,
    pub training_inputs: u32,
    pub patch_fast: u32,
    pub patch_history: u32,
    pub patch_source: u32,
    pub light_history: u32,
}

fn save(
    b: drive::Build,
    path: str,
    count: u32,
    stride: u32 = 4,
    records: bool = false,
) -> Result<(), ToolError> {
    let ids = untrapped("clip buffers", drive::steps(b, [Step::Buffers]).wait()?)?
    borrow buffers = ids.buffers[0]
    let id = buffers[buffers.len() - 1]
    var result = untrapped("clip readback", drive::steps(b, [Step::ReadBuffer(id)]).wait()?)?
    let bytes = joined(data_bytes(result.bytes.remove(0))?)
    if records { let _ = finite_floats(bytes, count * stride)? } else {
        let _ = floats(bytes, count * stride)?
    }
    write_file(path, chunked(take bytes))?
    Ok(())
}

fn path(
    b: drive::Build,
    directory: str,
    spec: Spec,
    divisor: u32,
    model: str,
    gate: str,
    raw_model: str,
) -> Result<(), ToolError> {
    let _ = untrapped("clip init", drive::steps(b, [Step::Init], timeout: 600.0).wait()?)?
    let _ = call(
        b,
        "configure",
        Vec::from([Scalar::I32(i32(divisor)), Scalar::I32(0), Scalar::I32(i32(spec.shot))]),
    )?
    let _ = call(b, "decoder", Vec::from([Scalar::I32(i32(spec.decoder))]))?
    if spec.raw_specialize == 1 {
        let _ = call(b, "raw_kernel_specialize", Vec::from([Scalar::I32(1)]))?
    }
    if spec.decoder == 2 {
        let _ = call(b, "patch_kernel", Vec::from([Scalar::I32(i32(spec.patch_fast))]))?
        let _ = call(b, "patch_history", Vec::from([Scalar::I32(i32(spec.patch_history))]))?
        let _ = call(b, "patch_source_geometry", Vec::from([Scalar::I32(i32(spec.patch_source))]))?
    }
    if spec.decoder == 2 &&
        spec.patch_source == 1 &&
        spec.patch_history > 0 &&
        spec.training_inputs == 0 &&
        model.is_empty() &&
        gate.is_empty() {
        let _ = call(b, "patch_conventional", Vec::new())?
    }
    let _ = call(b, "illumination_history", Vec::from([Scalar::I32(i32(spec.light_history))]))?
    let _ = call(
        b,
        "prepare_sequence",
        Vec::from(
            [
                Scalar::I32(i32(spec.width)),
                Scalar::I32(i32(spec.height)),
                Scalar::I32(i32(spec.start)),
                Scalar::I32(i32(spec.training_inputs)),
            ],
        ),
    )?
    if !model.is_empty() {
        upload_model(b, read_file(model, "clip model")?, patch: spec.decoder == 2)?
    }
    if !gate.is_empty() { upload_gate(b, read_file(gate, "clip history gate")?)? }
    if !raw_model.is_empty() { upload_raw_kernel(b, read_file(raw_model, "clip raw kernel")?)? }
    frames(b, spec.warmup)?
    for frame in 0..spec.length {
        if spec.cut_at > 0 && frame == spec.cut_at {
            let _ = call(
                b,
                "cut",
                Vec::from(
                    [Scalar::I32(i32((spec.shot + 3) % 8)), Scalar::I32(i32(spec.reset_cut))],
                ),
            )?
        }
        let _ = call(
            b,
            "collect",
            Vec::from([Scalar::I32(i32(spec.width)), Scalar::I32(i32(spec.height))]),
        )?
        frames(b, 1)?
        if call(b, "publish", Vec::new())? != 1 { return Err(ToolError::new("clip capture count")) }
        let stem = f"{directory}/scale-{divisor}/{frame}"
        let count = spec.width * spec.height
        save(b, f"{stem}.rgba32f", count)?
        if call(b, "publish_truth", Vec::new())? != i32(count) {
            return Err(ToolError::new("clip truth count"))
        }
        save(b, f"{stem}.truth32f", count)?
        if call(b, "publish_visibility", Vec::new())? != i32(count) {
            return Err(ToolError::new("clip visibility count"))
        }
        save(b, f"{stem}.visibility32f", count)?
        if spec.decoder == 6 || spec.decoder == 7 {
            let rows = if spec.decoder == 7 { 12 } else { 3 }
            if call(b, "publish_basis", Vec::new())? != rows {
                return Err(ToolError::new("basis count"))
            }
            save(b, f"{stem}.basis32f", u32(rows), stride: 4, records: true)?
        }
        if spec.training_inputs == 1 {
            let n = (spec.width / divisor) * (spec.height / divisor)
            if spec.decoder == 2 {
                if call(b, "publish_patch", Vec::new())? != i32(n) {
                    return Err(ToolError::new("clip patch input count"))
                }
                save(b, f"{stem}.patch32f", n, stride: 52, records: true)?
            }
            if call(b, "publish_patch_geometry", Vec::new())? != i32(n) {
                return Err(ToolError::new("clip patch geometry count"))
            }
            save(b, f"{stem}.geometry32f", n, stride: 8, records: true)?
            if spec.patch_source == 1 || spec.decoder >= 3 {
                if call(b, "publish_patch_source", Vec::new())? != 2 {
                    return Err(ToolError::new("clip source geometry parameters"))
                }
                save(b, f"{stem}.source32f", 2, stride: 4, records: true)?
                if spec.patch_history > 0 {
                    if call(b, "publish_gate", Vec::new())? != i32(count) {
                        return Err(ToolError::new("clip confidence input count"))
                    }
                    save(b, f"{stem}.gate32f", count, stride: 12, records: true)?
                }
            }
        }
        if frame % 30 == 0 || frame + 1 == spec.length {
            print(f"sequence: scale {divisor}, frame {frame + 1}/{spec.length}")
        }
    }
    Ok(())
}

pub fn run(
    directory: str,
    spec: Spec,
    model: str,
    gate: str,
    raw_model: str,
    fixture: str,
) -> Result<(), ToolError> {
    let input_track = if spec.light_history > 0 {
        "source_geometry_and_declared_positive_illumination_event"
    } else if spec.decoder == 8 {
        "authored_geometry_and_radiance_formula_direct_conventional"
    } else if spec.decoder == 7 {
        "source_material_regions_observed_bilinear_radiance_conventional"
    } else if spec.decoder >= 6 {
        "source_geometry_and_material_regions_observed_rgb_full_stack"
    } else if spec.patch_source == 1 || spec.decoder >= 3 {
        "source_geometry_full_stack"
    } else {
        "fixed_sampler_inputs"
    }
    let raw_index_layout = if spec.decoder == 4 {
        "u32_heads_bin2_pad8_then_links_age_major_low_resolution_pixels_node_plus_one_zero_null"
    } else { "unused" }
    let raw_storage = if spec.decoder == 8 {
        "none_source_formula_integration"
    } else if spec.decoder == 7 {
        "twelve_current_observed_bilinear_rgb_rows"
    } else if spec.decoder >= 6 {
        "three_observed_rgb_coefficients_with_last_seen_tick_no_raw_history"
    } else if spec.decoder >= 3 {
        "20_byte_half_color_f32_motion_depth_stride_ceil_pixels_to_64"
    } else if spec.decoder == 1 { "32_byte_f32_color_motion_depth_stride_ceil_pixels_to_8" } else {
        "unused"
    }
    let format = if spec.decoder == 6 || spec.decoder == 7 {
        "rgba32f_le_top_down_scene_linear_alpha_sampling_material_tag"
    } else { "rgba32f_le_top_down_scene_linear_alpha1" }
    let radiance = if spec.shot >= 74 {
        "production_leaf_response_spatial_fields"
    } else if spec.shot == 72 { "affine_spatial" } else if spec.shot == 73 {
        "bilinear_spatial"
    } else { "constant_per_material" }
    let reference = if spec.shot >= 74 {
        "source_lighting_midpoint_with_analytic_material_areas_see_archived_grid"
    } else { "analytic_pixel_integral_after_reconstruction_never_decoder_input" }
    let metadata = f"radiance={radiance}\nscene=analytic/slats-checkerboard\ncase_catalog=legacy8_stress64_radiance2_leaf4_v3\nshot={spec.shot}\ncut_shot={(spec.shot + 3) % 8}\nwidth={spec.width}\nheight={spec.height}\nstart_frame={spec.start + spec.warmup}\nwarmup={spec.warmup}\nframes={spec.length}\nsimulation_fps=60\ncut_at={spec.cut_at}\nreset_cut={spec.reset_cut}\nmodel={model}\ngate_model={gate}\nraw_model={raw_model}\nraw_specialize={spec.raw_specialize}\ngate_input_version=1\nraw_input_version=1\nraw_storage={raw_storage}\nraw_index_layout={raw_index_layout}\ndecoder={spec.decoder}\npatch_fast={spec.patch_fast}\npatch_width={reconstruction_patch::network::MODEL.h1}\npatch_history={spec.patch_history}\npatch_source_geometry={spec.patch_source}\nlight_history={spec.light_history}\ninput_track={input_track}\ntraining_inputs={spec.training_inputs}\nformat={format}\nvisibility=foreground_area,horizontal_speed_output_pixels_per_frame,0,1\nreference={reference}\ntrack=development_continuous_clip_not_sealed_test\n"
    let _ = files::write(f"{directory}/sequence.txt", metadata.as_bytes()).wait()?
    for divisor in 1..5 {
        var load = drive::gpu()
        load.width = spec.width
        load.height = spec.height
        load.workers = 1
        load.timeout = 600.0
        let built = if fixture.is_empty() { f"{directory}/fixture" } else { String::from(fixture) }
        let b = drive::load(built.as_str(), load).wait()?.build
        let result = path(b, directory, spec, divisor, model, gate, raw_model)
        let closed = drive::close(b).wait()
        (take result)?
        let _ = (take closed)?
    }
    Ok(())
}
