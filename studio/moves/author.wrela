// The author's loop for a written, solved strike, as one command (`wrela tool moves -- --solve
// <out-dir> <strike>`): solve its numbers against its spec, written only if every check holds,
// then read the new move's sheet, its chart and its arms, and say what changed. And a read
// without a solve (`--read <out-dir> <strike>`): every check's value against its bound, as the
// strike stands, and its sheet, in seconds.
//
// A strike's `free` names its numbers, each a `let` in its file, and the solve frees them by
// name (`wrela solve --free <file>:<name>,...`; a whole value is one name: `chain` frees every
// lag and snap of a `Chain` literal). The toolchain writes a solve only if every check holds
// where it stopped, and says which miss. A strike whose every check holds already isn't solved,
// so a round leaves it as it was: a solve of a spec that holds may still move a number by less
// than its last decimal and write it back longer (toolchain 0.33.0).
//
// The sheet is read by a fresh run of this tool: this one was built with the numbers as they
// were, and a move is a constant made when its package is built.

use std::collections::Vec
use std::io::print
use std::string::String
use std::tool::ToolError
use std::tool::files::rooted
use std::tool::run
use toolkit::whole::{data_bytes, joined, read_file}

/// A strike a solve can move: its name on the command line (a strike of `strikes`), the
/// workspace member its spec is in, the file there that holds its numbers, the names of the
/// numbers a solve frees (`,` between them), and what its checks' names start with (a package's
/// spec holds every strike's checks).
pub struct Solved: Copy {
    pub name: Text,
    pub member: Text,
    pub file: Text,
    pub free: Text,
    pub checks: Text,
}

/// The solved strikes: add a line for a new one.
pub const SOLVED: [Solved; 2] = [
    Solved {
        name: "cross-solved",
        member: "content/humanoid",
        file: "solved.wrela",
        free: "sets_off,drive,hips_yaw,chest_yaw,spot_x,spot_y,spot_z,elbow_out",
        checks: "cross: ",
    },
    Solved {
        name: "hook-solved",
        member: "content/humanoid",
        file: "hook.wrela",
        // (Not `sets_off` for now: freed against the fighter's taste, a solve of it never
        // comes back, a fault in toolchain 0.33.0's solver. It goes back in once a release
        // fixes it; till then it's set by reading.)
        free: "hips_yaw,spot_x,spot_y,spot_z,elbow_up",
        checks: "hook: ",
    },
]

/// How long a solve or a sheet may take (s).
const TIMEOUT: f64 = 600.0

/// Each name of `free` (`,` between them) with the line of `text` that binds it (`let <name> =`,
/// from 1; 0 for none): how a solve's report, which gives lines, is read back by name.
pub fn lines_of(text: str, free: str) -> Vec<(u32, String)> {
    var out: Vec<(u32, String)> = Vec::new()
    for (f0, f1) in free.split(",") {
        let name = free.slice(f0, f1).trim()
        let want = f"let {name} ="
        var at = 0
        var n = 0
        for (a, b) in text.lines() {
            n += 1
            if text.slice(a, b).trim().starts_with(want.as_str()) {
                at = n
            }
        }
        out.push((at, name.to_string()))
    }
    out
}

/// Runs `wrela` in the workspace with `given`: how it ended, and all it said.
fn wrela(given: take Vec<String>) -> Result<(i32, String), ToolError> {
    var c = run::command("wrela", "ws")
    c.args = take given
    c.timeout = TIMEOUT
    let r = run::run(c).wait()?
    var said = String::from_utf8(joined(data_bytes(r.stdout.clone())?)).unwrap_or(String::new())
    let err = String::from_utf8(joined(data_bytes(r.stderr.clone())?)).unwrap_or(String::new())
    said.push_str(err.as_str())
    Ok((r.status, said))
}

/// How many of a solve's checks hold, of how many, from what it said (`the spec: 20 of 21
/// hold`); nothing where it didn't say.
fn held(said: str) -> Option<(u32, u32)> {
    for (a, b) in said.lines() {
        let line = said.slice(a, b).trim()
        if line.starts_with("the spec: ") && line.ends_with(" hold") {
            let words = line.slice(10, line.len() - 5)
            let of = words.find(" of ")?
            return Some(
                (words.slice(0, of).parse_u32()?, words.slice(of + 4, words.len()).parse_u32()?),
            )
        }
    }
    None
}

/// What a solve said, for an author: each number by its name with how it moved, the checks
/// that miss, and how many hold.
fn told(said: str, s: Solved, names: [(u32, String)]) {
    let at = f"{s.file}:"
    for (a, b) in said.lines() {
        let line = said.slice(a, b).trim()
        if line.starts_with(at.as_str()) {
            let rest = line.slice(at.len(), line.len())
            let Some(gap) = rest.find(" ") else { continue }
            let Some(n) = rest.slice(0, gap).parse_u32() else { continue }
            for (l, name) in names {
                if l == n {
                    print(f"  {name}: {rest.slice(gap, rest.len()).trim()}")
                }
            }
        } else if line.starts_with("misses ") ||
            line.starts_with("the spec: ") ||
            line.starts_with("error") {
            print(f"  {line}")
        }
    }
}

/// The text of the file at `path` in the workspace, or nothing.
fn text_of(path: str) -> Option<String> {
    let at = rooted("ws", path)?
    let bytes = read_file(at.as_str(), path).ok()?
    String::from_utf8(take bytes)
}

/// The arguments of a solve of `s`'s spec, its numbers freed by name.
fn solve_args(s: Solved) -> Vec<String> {
    Vec::from(
        [
            String::from("solve"),
            String::from(s.member),
            String::from("--spec"),
            String::from("--free"),
            String::from(f"{s.file}:{s.free}"),
        ],
    )
}

/// Whether a read (`said`) left a check missed: a strike whose every check holds isn't solved.
pub fn needs_solve(said: str) -> bool {
    match held(said) {
        Some((h, o)) => h < o,
        None => true,
    }
}

/// The checks of `s` in what a read said, printed: its own (named as its `checks` says), and how
/// many of them hold, of how many.
fn own_checks(said: str, s: Solved) -> (u32, u32) {
    let mark = s.checks
    var held = 0
    var of = 0
    for (a, b) in said.lines() {
        let line = said.slice(a, b).trim()
        for start in ["holds ", "misses "] {
            if line.starts_with(start) &&
                line.slice(start.len(), line.len()).trim().starts_with(mark) {
                print(f"  {line}")
                of += 1
                if start == "holds " {
                    held += 1
                }
            }
        }
    }
    (held, of)
}

/// `s`'s sheet written under `dir` by a fresh run of this tool, printed with what changed on
/// it since the last.
fn sheet(s: Solved, dir: str) -> Result<(), ToolError> {
    let path = f"{dir}/{s.name}.txt"
    let was = text_of(path.as_str()).unwrap_or(String::new())
    let (status, said) = wrela(
        Vec::from(
            [
                String::from("tool"),
                String::from("moves"),
                String::from("--"),
                String::from("--sheet"),
                String::from(dir),
                String::from(s.name),
            ],
        ),
    )?
    if status != 0 {
        print(said.as_str())
        return Err(ToolError::new("the sheet's run failed"))
    }
    let now = text_of(path.as_str()).unwrap_or(String::new())
    print(now.as_str())
    if !was.is_empty() && was.as_str() != now.as_str() {
        print("what changed on the sheet:")
        let (old, new) = (was.as_str().lines(), now.as_str().lines())
        for i in 0..max(old.len(), new.len()) {
            let a = if i < old.len() { was.as_str().slice(old[i].0, old[i].1).to_string() } else {
                String::new()
            }
            let b = if i < new.len() { now.as_str().slice(new[i].0, new[i].1).to_string() } else {
                String::new()
            }
            if a.as_str() != b.as_str() {
                print(f"  was {a.as_str().trim()}")
                print(f"  now {b.as_str().trim()}")
            }
        }
    }
    Ok(())
}

/// The read for `s`: each of its own checks as the strike stands (a solve of no steps), and its
/// sheet under `dir`: the tool's exit code, 1 where a check misses.
pub fn read(s: Solved, dir: str) -> Result<u32, ToolError> {
    var given = solve_args(s)
    given.push(String::from("--steps"))
    given.push(String::from("0"))
    print(f"{s.name}: its checks as it stands")
    let (_, said) = wrela(take given)?
    let (holds, of) = own_checks(said.as_str(), s)
    if of == 0 {
        print(said.as_str())
        return Err(ToolError::new("the spec said nothing of its checks"))
    }
    print(f"  {holds} of its {of} checks hold")
    sheet(s, dir)?
    Ok(if holds < of { 1 } else { 0 })
}

/// The loop for `s`, its sheet under `dir` (a path in the workspace): the tool's exit code. 1
/// where the solve left a check missed: the toolchain writes nothing then.
pub fn solve(s: Solved, dir: str) -> Result<u32, ToolError> {
    let path = f"{s.member}/{s.file}"
    let Some(text) = text_of(path.as_str()) else {
        return Err(ToolError::new(f"can't read {path}"))
    }
    // (Each name's line, to read the solve's report back by name; a name the file doesn't bind
    // is the toolchain's to refuse.)
    let names = lines_of(text.as_str(), s.free)
    // A strike that holds already is left as it is.
    var reading = solve_args(s)
    reading.push(String::from("--steps"))
    reading.push(String::from("0"))
    let (_, now) = wrela(take reading)?
    if !needs_solve(now.as_str()) {
        print(f"{s.name}: every check holds already; nothing solved, nothing written")
        sheet(s, dir)?
        return Ok(0)
    }
    var given = solve_args(s)
    given.push(String::from("--write"))
    print(f"{s.name}: solving {names.len()} numbers of {path}")
    let (status, said) = wrela(take given)?
    told(said.as_str(), s, names)
    if status != 0 {
        print(
            "  not written: a check misses where the solve stopped. Change a target or a start, and go again.",
        )
        return Ok(1)
    }
    print("  written: every check holds")
    sheet(s, dir)?
    Ok(0)
}

@test
fn the_solved_numbers_are_found_by_name() {
    let text = "pub fn x() {\n    let sets_off = 0.140\n    let drive = 0.1\n    let chain = Chain {\n"
    let found = lines_of(text, "sets_off, drive,chain,gone")
    assert(found.len() == 4)
    assert(found[0].0 == 2 && found[0].1.as_str() == "sets_off")
    assert(found[1].0 == 3 && found[1].1.as_str() == "drive")
    assert(found[2].0 == 4, "a whole value is one name")
    assert(found[3].0 == 0, "a name the file doesn't bind")
    let said = "spec::spec: 1 -> 0\n  solved.wrela:4  0.14 -> 0.144\nthe spec: 20 of 21 hold\n  misses a check\n"
    assert(held(said) == Some((20, 21)))
    // A strike whose every check holds isn't solved, so a round changes no file.
    assert(needs_solve(said), "a check misses: solve")
    assert(!needs_solve("the spec: 41 of 41 hold\n"), "all hold: leave it as it is")
}
