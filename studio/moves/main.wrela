/// A strike to read: its name on the command line, its clip, the limb that strikes (`ANY` to
/// find it), its contact (s; negative to find it), and what it is.
pub struct Strike: Clone {
    pub name: Text,
    pub clip: Clip,
    pub limb: u32,
    pub contact: f32,
    pub about: Text,
}

/// How long before its contact the exchange's cross is read from, and how long after its
/// hit-stop (s).
const X_BEFORE: f32 = 0.7
const X_AFTER: f32 = 0.9

/// The exchange's striker as he's drawn (`exchange::striker_on`, the hit-stop and the
/// connection in), from `X_BEFORE` before the contact, a pose for each of a game's frames.
fn exchange_cross(rig: Rig) -> Clip {
    let from = exchange::hit_at() - X_BEFORE
    let n = u32((X_BEFORE + exchange::TUNED.hold + X_AFTER) * timing::RATE)
    var poses: Vec<engine::humanoid::Pose> = Vec::with_capacity(n)
    for f in 0..n {
        poses.push(exchange::striker_on(from + f32(f) / timing::RATE, exchange::TUNED))
    }
    timing::clip_of(rig, poses, timing::RATE)
}

/// The strikes the fight plays, each as its move (its marks say when it lands), by its name
/// among `strikes`: what `--drawn` and `--differ` play as the lab does (thrown out of the
/// bouncing guard, drawn as an everyday strike is: `anime::LIGHT`), with the arm that strikes
/// (whose fist `--drawn` follows). Add a line for a new one.
pub fn played() -> Vec<(Text, Played, u32)> {
    Vec::from(
        [
            ("cross-solved", solved::CROSS.clone(), RIGHT_ARM),
            ("hook-solved", hook::HOOK.clone(), LEFT_ARM),
        ],
    )
}

/// The strikes: add a line for a new one.
pub fn strikes(rig: Rig) -> Vec<Strike> {
    Vec::from(
        [
            Strike {
                name: "exchange",
                clip: exchange_cross(rig),
                limb: RIGHT_ARM,
                contact: X_BEFORE,
                about: "the combat lab's cross as it's drawn, hit-stop and all (exchange::striker_on)",
            },
            Strike {
                name: "cross-solved",
                clip: solved::CROSS.clip.clone(),
                limb: RIGHT_ARM,
                contact: solved::CONTACT,
                about: "the solved cross (solved::CROSS, engine::written): goal poses, each part on its own clock, its numbers solved against spec.wrela",
            },
            Strike {
                name: "hook-solved",
                clip: hook::HOOK.clip.clone(),
                limb: LEFT_ARM,
                contact: hook::CONTACT,
                about: "the solved lead hook (hook::HOOK, engine::written): goal poses, each part on its own clock, its numbers solved against spec.wrela",
            },
            Strike {
                name: "cross-take",
                clip: accad_fists::CROSS_TAKE.clone(),
                limb: ANY,
                contact: -1.0,
                about: "a boxer's captured cross (ACCAD, accad_fists::CROSS_TAKE): the reference",
            },
            Strike {
                name: "cross-kimodo",
                clip: kimodo::TIMED.clone(),
                limb: ANY,
                contact: -1.0,
                about: "Kimodo's cross, timed (kimodo::TIMED)",
            },
            Strike {
                name: "punch",
                clip: PUNCH_KEYED.clip.clone(),
                limb: ANY,
                contact: -1.0,
                about: "Quaternius's Punch_Cross, held to its feet (body::PUNCH_KEYED)",
            },
        ],
    )
}

/// `s`'s sheet printed, and written with its chart under `dir` (a root path).
fn sheet(s: Strike, rig: Rig, dir: str) -> Result<(), ToolError> {
    let t = timing::timing(s.clip, rig, s.limb, s.contact)
    var text = String::from(f"{t.text(s.name)}\n")
    // Its arms, a stretch at a time (`engine::arms::report`): nothing for arms a person makes.
    let faults = arms::report(rig, s.clip, accad_fists::REAL)
    if faults.is_empty() {
        text.push_str("  arms: nothing flagged\n")
    }
    for fault in faults {
        text.push_str(f"  arms: {fault}\n".as_str())
    }
    text.push_str(f"  ({s.about})\n".as_str())
    print(text.as_str())
    if files::write(f"{dir}/{s.name}.txt".as_str(), text.as_bytes()).wait().is_err() {
        return Err(ToolError::new(f"couldn't write {dir}/{s.name}.txt"))
    }
    let img = chart(s.clip, rig, t, f"{s.name}: {s.about}".as_str())
    write_png(img.rgba()?, f"{dir}/{s.name}.png".as_str())
}

/// The sheets of the strikes `wanted` names (all of them when it names none) into `dir`, a
/// path in the workspace: the tool's exit code.
fn sheets(dir: str, wanted: [String], rig: Rig) -> u32 {
    let Some(out) = rooted("ws", dir) else {
        print(f"moves: no path for {dir}")
        return 2
    }
    if let Err(e) = files::make_dirs(out.as_str()).wait() {
        print(f"moves: {e.message()}")
        return 1
    }
    var done = 0
    for s in strikes(rig) {
        var chosen = wanted.is_empty()
        for w in wanted {
            if w.as_str() == s.name {
                chosen = true
            }
        }
        if !chosen {
            continue
        }
        if let Err(e) = sheet(s.clone(), rig, out.as_str()) {
            print(f"moves: {e.message()}")
            return 1
        }
        done += 1
    }
    if done == 0 {
        print(USAGE)
        return 2
    }
    0
}

/// Each bone of `rig` in the body's space in frame `f` of `c`.
pub fn world(rig: Rig, c: Clip, f: u32) -> Vec<Rigid> {
    let nb = rig.bones.len()
    var out: Vec<Rigid> = Vec::filled(nb, Rigid::identity())
    for b in 0..nb {
        let p = rig.bones[b].parent
        let q = c.turns[f * nb + b]
        if p == NONE {
            out[b] = rig.base.then(Rigid { q, t: c.hips[f] })
        } else {
            out[b] = out[p].then(Rigid { q, t: rig.bones[b].rest.t })
        }
    }
    out
}

/// How far (m) any joint of `b` strays from where it is in `a`, at any frame (of a loop, all but
/// the last, which a cycle makes its first again): both on `rig`, with as many frames.
pub fn strays(rig: Rig, a: Clip, b: Clip) -> f32 {
    var worst = 0.0
    let frames = if a.looped { min(a.frames, b.frames) - 1 } else { min(a.frames, b.frames) }
    for f in 0..frames {
        let (wa, wb) = (world(rig.clone(), a.clone(), f), world(rig.clone(), b.clone(), f))
        for j in 0..wa.len() {
            worst = max(worst, length(wa[j].t - wb[j].t))
        }
    }
    worst
}

/// The source of `m`'s file.
pub fn file_of(m: Move, c: Cycle) -> String {
    var out = String::new()
    out.push_str(
        "// Written by the moves tool (`wrela tool moves`, studio/moves): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. A cycle (engine::cycle): each bone's turn a\n",
    )
    out.push_str("// mean turn and a few harmonics of the phase.\n\n")
    out.push_str("use engine::cycle::{Cycle, Swing, wave}\nuse std::quat::Quat\n\n")
    var doc: Vec<String> = Vec::new()
    for line in m.about {
        doc.push(line.to_string())
    }
    out.push_str(cycle::source(c, m.constant.to_string().as_str(), doc).as_str())
    out
}

/// The source of one-off `m`'s file, its shot `k`.
pub fn shot_file_of(m: Move, k: OneOff) -> String {
    var out = String::new()
    out.push_str(
        "// Written by the moves tool (`wrela tool moves`, studio/moves): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. A shot (engine::oneoff): each bone's turn at a\n",
    )
    out.push_str("// few moments, and a smooth curve through them.\n\n")
    out.push_str("use engine::oneoff::{OneOff, Track, place, turn}\n\n")
    var doc: Vec<String> = Vec::new()
    for line in m.about {
        doc.push(line.to_string())
    }
    out.push_str(oneoff::source(k, m.constant.to_string().as_str(), doc).as_str())
    out
}

/// `m` fitted, played back on `rig` and written: what to print of it, or why it failed.
fn written(m: Move, rig: Rig) -> Result<String, String> {
    let Some(path) = rooted("ws", f"content/moves/{m.file}".as_str()) else {
        return Err(f"no path for {m.file}")
    }
    var text = String::new()
    var said = String::new()
    if m.clip.looped {
        let c = cycle::rounded(cycle::cycle_of(m.clip.clone(), rig.clone(), Fit {}))
        let off = strays(rig.clone(), m.clip.clone(), c.clip(rig.clone(), m.clip.fps))
        var most = c.sway.len()
        var terms = c.sway.len()
        for s in c.bones {
            most = max(most, s.waves.len())
            terms += s.waves.len()
        }
        text = file_of(m.clone(), c.clone())
        said = f"{c.bones.len()} bones, {terms} harmonics (at most {most} a bone), joints within {off * 100.0:.2} cm of the clip"
    } else {
        let k = oneoff::rounded(oneoff::shot_of(m.clip.clone(), rig.clone(), Keying {}))
        let off = strays(rig.clone(), m.clip.clone(), k.clip(rig.clone(), m.clip.fps))
        var most = k.hips.len()
        var keys = k.hips.len()
        for t in k.bones {
            most = max(most, t.keys.len())
            keys += t.keys.len()
        }
        text = shot_file_of(m.clone(), k.clone())
        said = f"{k.bones.len()} bones, {keys} keys of {m.clip.frames} frames (at most {most} a bone), joints within {off * 100.0:.2} cm of the clip"
    }
    if files::write(path.as_str(), text.as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(f"{m.name}: content/moves/{m.file}, {said}")
}

pub fn tool() -> u32 {
    let wanted = args()
    let rig = HERO.rig.clone()
    if wanted.len() >= 1 && wanted[0].as_str() == "--drawn" {
        // Each played strike as it's drawn, drawing by drawing.
        var done = 0
        for (name, m, arm) in played() {
            var chosen = wanted.len() == 1
            for i in 1..wanted.len() {
                if wanted[i].as_str() == name {
                    chosen = true
                }
            }
            if chosen {
                let s = drawn::shown(rig, fists::FIGHT_GAITS, m, LIGHT)
                let hand = if arm == LEFT_ARM { "leftHand" } else { "rightHand" }
                print(drawn::drawings(rig, s, rig.find(hand), name).as_str())
                done += 1
            }
        }
        return if done == 0 { 2 } else { 0 }
    }
    if wanted.len() >= 1 && wanted[0].as_str() == "--differ" {
        // Two played strikes held against each other, as played and as drawn.
        if wanted.len() != 3 {
            print(USAGE)
            return 2
        }
        var both: Vec<drawn::Shown> = Vec::new()
        for i in 1..3 {
            for (name, m, _) in played() {
                if wanted[i].as_str() == name {
                    both.push(drawn::shown(rig, fists::FIGHT_GAITS, m, LIGHT))
                }
            }
        }
        if both.len() != 2 {
            print("moves: --differ takes two of the played strikes (`played` in main.wrela)")
            return 2
        }
        let names = f"{wanted[1]} against {wanted[2]}"
        print(drawn::differ(rig, both[0].clone(), both[1].clone(), names.as_str()).as_str())
        return 0
    }
    let solving = wanted.len() >= 1 && wanted[0].as_str() == "--solve"
    if solving || (wanted.len() >= 1 && wanted[0].as_str() == "--read") {
        if wanted.len() != 3 {
            print(USAGE)
            return 2
        }
        for s in author::SOLVED {
            if s.name == wanted[2].as_str() {
                let done = if solving { author::solve(s, wanted[1].as_str()) } else {
                    author::read(s, wanted[1].as_str())
                }
                return match done {
                    Ok(code) => code,
                    Err(e) => {
                        print(f"moves: {e.message()}")
                        1
                    },
                }
            }
        }
        print(f"moves: no solved strike {wanted[2]}: author.wrela's `SOLVED` names them")
        return 2
    }
    if wanted.len() >= 1 && wanted[0].as_str() == "--sheet" {
        if wanted.len() < 2 {
            print(USAGE)
            return 2
        }
        var names: Vec<String> = Vec::new()
        for i in 2..wanted.len() {
            names.push(wanted[i].clone())
        }
        return sheets(wanted[1].as_str(), names, rig)
    }
    var done = 0
    for m in moves() {
        var chosen = wanted.is_empty()
        for w in wanted {
            if w.as_str() == m.name {
                chosen = true
            }
        }
        if !chosen {
            continue
        }
        match written(m.clone(), rig.clone()) {
            Ok(said) => print(said),
            Err(e) => {
                print(f"moves: {e}")
                return 1
            },
        }
        done += 1
    }
    if done == 0 {
        print(USAGE)
        return 2
    }
    0
}

@test
fn each_written_move_is_the_clip_it_was_fitted_to() {
    // The files in content/moves, played on the body, against the clips as they are now: a
    // change to a clip without writing its file again fails here.
    let rig = HERO.rig.clone()
    let written = [
        ("walk", moves::walk::WALK.clip(rig.clone(), ACCAD_M2_WALK.fps)),
        ("run", moves::run::RUN.clip(rig.clone(), ACCAD_M2_RUN.fps)),
        ("idle", moves::idle::IDLE.clip(rig.clone(), IDLE.fps)),
        ("start", moves::start::START.clip(rig.clone(), ACCAD_M2_START.fps)),
        ("stop", moves::stop::STOP.clip(rig.clone(), ACCAD_M2_STOP.fps)),
        ("roll", moves::roll::ROLL.clip(rig.clone(), ROLL_RAW.fps)),
    ]
    for m in moves() {
        for (name, back) in written {
            if m.name == name {
                assert(back.frames == m.clip.frames, f"{name}: a frame for each of the clip's")
                let off = strays(rig.clone(), m.clip.clone(), back.clone())
                assert(
                    off < 0.0075,
                    f"{name}'s joints within 7.5 mm of the clip's ({off * 100.0:.2} cm)",
                )
            }
        }
    }
}

@test
fn a_strikes_chart_marks_where_it_sets_off_and_lands() {
    // The captured cross's chart: the curves' strip has a line where the strike sets off and
    // one on its contact, each in its colour; a clip nothing moves in gets no chart.
    let rig = HERO.rig.clone()
    let clip = accad_fists::CROSS_TAKE.clone()
    let t = timing::timing(clip, rig, ANY, -1.0)
    assert(t.found)
    let img = chart(clip, rig, t, "cross-take")
    assert(img.w == chart::WIDTH && img.h == chart::HEIGHT)
    let m = u32(t.length * timing::RATE + 0.5)
    let at = |time: f32, c: vec3u| -> bool {
        let x = chart::STRIP_LEFT + u32(time * timing::RATE / f32(m) * f32(chart::STRIP_W))
        let i = 3 * ((chart::STRIP_TOP - 6) * img.w + x)
        u32(img.px[i]) == c.x && u32(img.px[i + 1]) == c.y && u32(img.px[i + 2]) == c.z
    }
    assert(at(t.sets_off, chart::SET), "a line where it sets off")
    assert(at(t.contact, chart::HIT), "a line on its contact")
    assert(!at(0.5 * (t.sets_off + t.contact), chart::SET), "and none between")
    let still = engine::humanoid::rest_clip(rig)
    assert(!timing::timing(still, rig, ANY, -1.0).found)
}
