// The styles tool: the looks a file declares, and G-style on a log and on this branch's history.

use looks::{added_in, combined, holds, looks_in}
use std::io::print
use std::tool::files
use toolkit::whole::read_file

/// A file's looks are its `impl Style for` types, a fit's variant aside.
@test
fn a_files_looks_are_its_styles() {
    let src = "pub struct Cel {}\nimpl Knob for Cel {}\nimpl Style for Cel {\n}\nimpl Style for CelFitting {\n}\n"
    let l = looks_in(src)
    assert(l.len() == 1 && l[0].as_str() == "Cel")
}

/// A look added alone holds G-style; one added with an engine change doesn't; the engine's own
/// look is held to none; the oldest commit adding a file is its adding.
@test
fn g_style_reads_each_looks_adding_commit() {
    let log = "commit:c3\nM\tengine/frame.wrela\nA\tcontent/styles/ink.wrela\ncommit:c2\nA\tcontent/styles/cel.wrela\ncommit:c1\nA\tcontent/styles/physical.wrela\nM\tengine/style.wrela\nA\tcontent/styles/ink.wrela\n"
    let added = added_in(log)
    var seen = 0
    for a in added {
        if a.file.as_str() == "cel.wrela" {
            assert(a.commit.as_str() == "c2" && holds(a.clone()))
            seen += 1
        }
        if a.file.as_str() == "ink.wrela" {
            assert(a.commit.as_str() == "c1" && !holds(a.clone()))
            seen += 1
        }
        if a.file.as_str() == "physical.wrela" {
            assert(holds(a.clone()))
            seen += 1
        }
    }
    assert(seen == 3)
}

/// A rename names both ends: a look moved into content/styles is an adding, and an engine file at
/// either end of a rename in the same commit is the engine's change.
@test
fn g_style_reads_renames() {
    let log = "commit:c2\nR100\tcontent/styles/helper.wrela\tengine/helper.wrela\nA\tcontent/styles/wash.wrela\ncommit:c1\nR095\tcontent/old/flat.wrela\tcontent/styles/flat.wrela\n"
    var seen = 0
    for a in added_in(log) {
        if a.file.as_str() == "wash.wrela" {
            assert(a.commit.as_str() == "c2" && !holds(a.clone()), "wash: the move into engine/")
            seen += 1
        }
        if a.file.as_str() == "flat.wrela" {
            assert(a.commit.as_str() == "c1" && holds(a.clone()), "flat: renamed in alone")
            seen += 1
        }
    }
    assert(seen == 2, f"{seen} of the two looks")
}

/// The recorded history's adding commit for a look wins over the live log's (a squash merge's),
/// and the live log fills in a look the record lacks.
@test
fn the_recorded_history_wins_over_a_squash() {
    let recorded = added_in("commit:b1\nA\tcontent/styles/cel.wrela\n")
    let live = added_in(
        "commit:s1\nM\tengine/frame.wrela\nA\tcontent/styles/cel.wrela\nA\tcontent/styles/wash.wrela\n",
    )
    let all = combined(recorded, live)
    assert(all.len() == 2, f"{all.len()} looks")
    for a in all {
        if a.file.as_str() == "cel.wrela" {
            assert(a.commit.as_str() == "b1" && holds(a.clone()), "cel: the branch's commit")
        } else {
            assert(a.commit.as_str() == "s1" && !holds(a.clone()), "wash: the live squash")
        }
    }
}

/// G-style on this branch's history as the tool recorded it (`wrela tool styles -- --record`,
/// `history.log`: a tool test runs no real program): every look under content/styles has its
/// adding commit there, and holds it.
@test(tool, read: [("repo", "../..")])
fn g_style_holds_on_this_branchs_history() {
    let Ok(bytes) = read_file("repo/studio/styles/history.log", "history.log") else {
        panic("studio/styles/history.log: record it with `wrela tool styles -- --record`")
    }
    let log = String::from_utf8(take bytes).unwrap_or(String::new())
    var looks = 0
    for a in added_in(log.as_str()) {
        if a.file.as_str() == "fixtures.wrela" {
            continue
        }
        print(f"{a.file}: added in {a.commit}, the engine's files it changed: {a.engine.len()}")
        assert(
            holds(a.clone()),
            f"{a.file}'s commit {a.commit} changed {a.engine.len()} engine files",
        )
        looks += 1
    }
    assert(looks >= 4, f"only {looks} looks")
    // And every look's file under content/styles has its adding commit there.
    let added = added_in(log.as_str())
    let Ok(entries) = files::list("repo/content/styles").wait() else {
        panic("content/styles: not listed")
    }
    for e in entries {
        let name = e.name.as_str()
        if !name.ends_with(".wrela") || name == "fixtures.wrela" {
            continue
        }
        var found = false
        for a in added.clone() {
            if a.file.as_str() == name {
                found = true
            }
        }
        assert(found, f"{name} has no adding commit in history.log")
    }
}
