// The costs tool's tests: the query it sends, the usage it reads from an answer (and the errors
// it passes on), the month and its pace, the readout and its alarms, and, as a tool test, the
// request against a fake API.

use main::{
    GRAPHQL, METERS, Month, Usage, body, cost, fetch_usage, month_of, pace, parse_args, query,
    r2_class, read_usage, readout, short,
}
use std::json
use std::json::TOP
use std::tool::testing
use std::tool::testing::Fake

fn contains(haystack: str, needle: str) -> bool {
    haystack.find(needle).is_some()
}

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let tolerance = if b > 1.0 || b < -1.0 { 0.000001 * (if b > 0.0 { b } else { -b }) } else {
        0.000001
    }
    d < tolerance && d > -tolerance
}

/// Nov 5 2026, 17:00 UTC.
const NOV5: i64 = 1793898000

/// An answer as the API gives one: two Workers, two Durable Object groups, R2 reads, writes and
/// a delete, and two buckets.
const ANSWER: Text = "{\"data\": {\"viewer\": {\"accounts\": [{\"workers\": [{\"sum\": {\"requests\": 1200, \"cpuTimeUs\": 3500000}, \"dimensions\": {\"scriptName\": \"wrela-console\"}}, {\"sum\": {\"requests\": 4800, \"cpuTimeUs\": 500000}, \"dimensions\": {\"scriptName\": \"wrela-console-api\"}}], \"calls\": [{\"sum\": {\"requests\": 900}}], \"periodic\": [{\"sum\": {\"activeTime\": 3600000000, \"rowsRead\": 7000, \"rowsWritten\": 300}}, {\"sum\": {\"activeTime\": 1800000000, \"rowsRead\": 3000, \"rowsWritten\": 100}}], \"stored\": [{\"max\": {\"storedBytes\": 2000000}}, {\"max\": {\"storedBytes\": 5000000}}], \"r2ops\": [{\"sum\": {\"requests\": 40}, \"dimensions\": {\"actionType\": \"PutObject\"}}, {\"sum\": {\"requests\": 10}, \"dimensions\": {\"actionType\": \"ListObjects\"}}, {\"sum\": {\"requests\": 700}, \"dimensions\": {\"actionType\": \"GetObject\"}}, {\"sum\": {\"requests\": 5}, \"dimensions\": {\"actionType\": \"DeleteObject\"}}], \"r2stored\": [{\"max\": {\"payloadSize\": 1500000000, \"metadataSize\": 0}, \"dimensions\": {\"bucketName\": \"a\"}}, {\"max\": {\"payloadSize\": 500000000, \"metadataSize\": 0}, \"dimensions\": {\"bucketName\": \"b\"}}]}]}}, \"errors\": null}"

fn zero() -> Usage {
    var amounts: Vec<f64> = Vec::new()
    for _ in 0..METERS.len() {
        amounts.push(0.0)
    }
    Usage { amounts, workers: Vec::new() }
}

// ---- The query ---------------------------------------------------------------------------------

@test
fn the_request_asks_for_the_account_from_the_first_of_the_month() {
    let q = query("abc123", "2026-11-01")
    assert(contains(q.as_str(), "accountTag: \"abc123\""), q.as_str())
    assert(contains(q.as_str(), "date_geq: \"2026-11-01\""), q.as_str())
    for name in [
        "workersInvocationsAdaptive",
        "durableObjectsPeriodicGroups",
        "r2StorageAdaptiveGroups",
    ] {
        assert(contains(q.as_str(), name), name)
    }
    // The body is one JSON object whose `query` is the query, as it was.
    let b = body(q.as_str())
    let Some(d) = json::parse(b.as_str()) else { panic(b.as_str()) }
    let Some(n) = d.get(TOP, "query") else { panic("query") }
    assert(d.text(n).unwrap_or(String::new()).as_str() == q.as_str())
}

// ---- Reading the usage -------------------------------------------------------------------------

@test
fn an_answer_reads_as_each_meters_use() {
    let Ok(u) = read_usage(ANSWER) else { panic("usage") }
    assert(near(u.amounts[0], 6000.0), "Worker requests")
    assert(near(u.amounts[1], 4000.0), "CPU time in ms")
    assert(near(u.amounts[2], 900.0), "object requests")
    // 5,400 s active at 128 MB.
    assert(near(u.amounts[3], 5400.0 * 0.128), "GB-s")
    assert(near(u.amounts[4], 10000.0) && near(u.amounts[5], 400.0), "rows")
    // Storage is the most it held, not the sum of the groups.
    assert(near(u.amounts[6], 0.005), "object storage")
    assert(near(u.amounts[7], 50.0), "class A: puts and lists")
    assert(near(u.amounts[8], 700.0), "class B: reads; deletes are free")
    // Buckets add up.
    assert(near(u.amounts[9], 2.0), "R2 storage")
    // The Workers, the busiest first.
    assert(u.workers.len() == 2 && u.workers[0].0.as_str() == "wrela-console-api")
}

@test
fn r2_operations_fall_in_their_classes() {
    assert(r2_class("PutObject") == 0 && r2_class("CompleteMultipartUpload") == 0)
    assert(r2_class("ListBuckets") == 0 && r2_class("UploadPartCopy") == 0)
    assert(r2_class("GetObject") == 1 && r2_class("HeadObject") == 1)
    assert(r2_class("DeleteObject") == 2 && r2_class("AbortMultipartUpload") == 2)
}

@test
fn the_apis_errors_come_back_word_for_word() {
    let Err(why) = read_usage(
        "{\"data\": null, \"errors\": [{\"message\": \"not authorized for that account\"}, {\"message\": \"unknown field\"}]}",
    ) else {
        panic("an error")
    }
    assert(why.as_str() == "not authorized for that account; unknown field", why.as_str())
    let Err(none) = read_usage(
        "{\"data\": {\"viewer\": {\"accounts\": []}}, \"errors\": null}",
    ) else {
        panic("no account")
    }
    assert(contains(none.as_str(), "CLOUDFLARE_ACCOUNT_ID"), none.as_str())
    assert(read_usage("<html>").is_err(), "not JSON")
}

@test
fn an_account_with_nothing_used_reads_as_zero() {
    let Ok(u) = read_usage(
        "{\"data\": {\"viewer\": {\"accounts\": [{\"workers\": [], \"calls\": [], \"periodic\": [], \"stored\": [], \"r2ops\": [], \"r2stored\": []}]}}, \"errors\": null}",
    ) else {
        panic("usage")
    }
    for a in u.amounts {
        assert(a == 0.0)
    }
}

// ---- The month ---------------------------------------------------------------------------------

@test
fn the_month_is_the_calendar_month_in_utc() {
    let m = month_of(NOV5)
    assert(m.since.as_str() == "2026-11-01", m.since.as_str())
    assert(m.name.as_str() == "November 2026", m.name.as_str())
    assert(m.seconds == 30.0 * 86400.0)
    assert(m.elapsed == 4.0 * 86400.0 + 17.0 * 3600.0)
    // December runs into the next year; a leap February has 29 days.
    let dec = month_of(NOV5 + 30 * 86400)
    assert(dec.since.as_str() == "2026-12-01" && dec.seconds == 31.0 * 86400.0)
    // 2028-02-10.
    let feb = month_of(1833753600)
    assert(feb.since.as_str() == "2028-02-01" && feb.seconds == 29.0 * 86400.0, feb.since.as_str())
}

@test
fn the_pace_stretches_use_to_the_month_but_not_storage() {
    let m = month_of(NOV5)
    // 4.7 days in, use is stretched over the 30.
    assert(near(pace(METERS[0], 470.0, m), 470.0 * 30.0 / (4.0 + 17.0 / 24.0)))
    assert(pace(METERS[6], 2.0, m) == 2.0, "storage is billed as held")
    // An hour into a month is taken as a day, so it isn't stretched 720 times.
    let early = Month {
        since: String::from("2026-11-01"),
        name: String::from("November 2026"),
        seconds: 30.0 * 86400.0,
        elapsed: 3600.0,
    }
    assert(near(pace(METERS[0], 10.0, early), 300.0))
}

@test
fn a_meter_costs_only_past_its_allowance() {
    assert(cost(METERS[5], 50000000.0) == 0.0)
    // 10M rows past the 50M written: $10.
    assert(near(cost(METERS[5], 60000000.0), 10.0))
    // 2 GB past the 5 stored: $0.40.
    assert(near(cost(METERS[6], 7.0), 0.4))
}

// ---- The readout -------------------------------------------------------------------------------

@test
fn a_quiet_month_has_no_alarm() {
    let Ok(u) = read_usage(ANSWER) else { panic("usage") }
    let r = readout(u, month_of(NOV5), 20.0)
    assert(r.alarms.len() == 0, r.text.as_str())
    assert(
        contains(r.text.as_str(), "## Cloudflare usage, November 2026 (4.7 of 30 days)"),
        r.text.as_str(),
    )
    assert(
        contains(r.text.as_str(), "| Worker requests | 6.0k | 38.2k | 10.0M | 0% | $0.00 |"),
        r.text.as_str(),
    )
    assert(contains(r.text.as_str(), "**$5.00**"), r.text.as_str())
    assert(contains(r.text.as_str(), "wrela-console-api 4.8k, wrela-console 1.2k"), r.text.as_str())
    assert(!contains(r.text.as_str(), "ALARM"), r.text.as_str())
}

@test
fn a_meter_on_pace_past_most_of_its_allowance_raises_an_alarm() {
    var u = zero()
    // 9M rows written by day 4.7 is ~57M by day 30: past the 50M free.
    u.amounts[5] = 9000000.0
    let r = readout(u, month_of(NOV5), 20.0)
    assert(r.alarms.len() == 1, r.text.as_str())
    assert(
        contains(r.alarms[0].as_str(), "Durable Object rows written is on pace for 115%"),
        r.alarms[0].as_str(),
    )
    assert(contains(r.text.as_str(), "**ALARM:** Durable Object rows written"), r.text.as_str())
    // Under 80% stays quiet.
    var calm = zero()
    calm.amounts[5] = 5000000.0
    assert(readout(calm, month_of(NOV5), 20.0).alarms.len() == 0)
}

@test
fn a_bill_on_pace_past_the_budget_raises_an_alarm() {
    var u = zero()
    // 100 GB of objects: $19 past the 5 free, so $24 with the plan.
    u.amounts[6] = 100.0
    let r = readout(u, month_of(NOV5), 20.0)
    var past = false
    for a in r.alarms {
        if contains(a.as_str(), "past the budget of $20.00") {
            past = true
        }
    }
    assert(past, r.text.as_str())
    assert(contains(r.text.as_str(), "**$24.00**"), r.text.as_str())
    // With a bigger budget, only the meter's alarm.
    assert(readout(u, month_of(NOV5), 30.0).alarms.len() == 1)
}

@test
fn numbers_read_short() {
    assert(short(0.0).as_str() == "0" && short(812.0).as_str() == "812")
    assert(short(0.25).as_str() == "0.25" && short(34500.0).as_str() == "34.5k")
    assert(short(1200000.0).as_str() == "1.2M" && short(25000000000.0).as_str() == "25.0B")
}

@test
fn the_command_line_takes_a_budget() {
    assert(parse_args([]) == Some(20.0))
    assert(parse_args([String::from("--budget"), String::from("12.5")]) == Some(12.5))
    assert(parse_args([String::from("--budget")]).is_none())
    assert(parse_args([String::from("--budget"), String::from("-1")]).is_none())
    assert(parse_args([String::from("--other")]).is_none())
}

// ---- The request -------------------------------------------------------------------------------

@test(tool, net: ["api.cloudflare.com"], budget: 30)
fn the_usage_comes_from_the_api_and_its_errors_fail_the_run() {
    let m = month_of(NOV5)
    assert(
        testing::fake(GRAPHQL, Fake::Bytes(Vec::from(String::from(ANSWER).as_bytes())))
            .wait()
            .is_ok(),
    )
    let Ok(u) = fetch_usage("token", "account", m.clone()) else { panic("usage") }
    assert(near(u.amounts[2], 900.0))
    let denied = "{\"data\": null, \"errors\": [{\"message\": \"Authentication error\"}]}"
    assert(
        testing::fake(GRAPHQL, Fake::Bytes(Vec::from(String::from(denied).as_bytes())))
            .wait()
            .is_ok(),
    )
    let Err(e) = fetch_usage("token", "account", m) else { panic("an error") }
    assert(contains(e.message(), "Authentication error"), e.message())
}
