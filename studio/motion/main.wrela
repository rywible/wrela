// The motion tool (`wrela tool motion`): the floor in motion, short repeatable captures of what a
// still can't show (the temporal AA's history, the wind in the leaves, arriving somewhere), each
// a run of frames on the native host's GPU saved as they're drawn, into a directory.
//
// ```text
// wrela tool motion -- <out-dir> [--size WxH] [capture ...]
// ```
//
// The floor must be built (`wrela build games/last-green`). Paths are from the workspace's
// directory (the root `ws`). Each capture is a script of the player's keys (a lookbook shot
// chosen as a player would: L, its number, Enter) and the frames it keeps, at 60 a second
// (captures.wrela):
//
// - walk: the floor's walk at a run (P), from the gate, 4 s of it.
// - reversal: a run from the gate, the camera turned hard left then hard right (the arrow keys
//   held, 1.2 s each way).
// - arrive-dark: the clearing's shot held 5 s, then the beech wood's: its first 2.5 s (black
//   until the light there is drawn, then its first second and more).
// - arrive-sun: the beech wood's shot held 5 s, then the clearing's: the same.
// - gust: the wood pasture's shot held, the wind in its crowns: 4 s, the view settled.
// - canopy: the clearing's move, crowns against the sky: 2 s.
// - water: the mere's move: 2 s.
// - occlusion: the move of the fawn under the beeches, the stand-in and the fawn passing behind
//   trunks and ferns: 2 s.
//
// The frames before a capture's first still run, so the temporal history is the same; only the
// kept frames are read back, each encoded as a PNG (`std::tool::image`). Each capture is kept as
// its frames (`<name>/NNNNN.png`, the frame's number), a clip (`<name>.mp4`, 60 fps,
// near-lossless, which FFmpeg makes: the tool runs `ffmpeg`, which must be on `PATH`) and a
// contact sheet of six frames at half size, each labelled by its frame (`<name>-sheet.webp`,
// composed here). 1280x720 unless `--size` says otherwise. With no capture named, all of them,
// one at a time.

use audio_tool::sheet::Image
use captures::{Capture, Options, compose, parse_args, picks}
use lookbook_tool::shots::{BUILD, shown_path}
use std::io::print
use std::job::{Job, Step}
use std::tool::{RUNNING, args}
use std::tool::blob
use std::tool::blob::Data
use std::tool::drive
use std::tool::files
use std::tool::image
use std::tool::run
use toolkit::wait::{done, said, wait}
use toolkit::whole::{blob_of, data_bytes, joined, write_data, write_png}

/// How many frames' PNGs are encoded and written at once, beside the frames rendering.
const SAVING: u32 = 4

/// How long FFmpeg may take to make a clip, in seconds.
const FFMPEG_TIMEOUT: f64 = 600.0

/// The trap a run ended with, said with `what`, or nothing.
fn trapped(what: str, ran: drive::Ran) -> Result<(), String> {
    match ran.trap {
        Some(t) => Err(String::from(f"{what}: {t.message} {t.panic}")),
        None => Ok(()),
    }
}

/// Runs FFmpeg in the workspace with `args`: what it said if it failed.
@job
pub fn ffmpeg(given: take Vec<String>) -> Result<(), String> {
    var c = run::command("ffmpeg", "ws")
    c.args = take given
    c.timeout = FFMPEG_TIMEOUT
    var r = wait(run::run(c))
    while !r.ready() { yield }
    let ran = said(run::read_ran(r.polled()))?
    if ran.status == 0 {
        return Ok(())
    }
    var j = Box::new(data_bytes.start(ran.stderr.clone()))
    var e = done(j.get_mut().resume())
    while e.is_none() {
        yield
        e = done(j.get_mut().resume())
    }
    let err = String::from_utf8(joined((take e).unwrap()?)).unwrap_or(String::new())
    Err(String::from(f"ffmpeg exited {ran.status}: {err.as_str().trim()}"))
}

/// Capture `c` at `width` × `height` into `out` (a root path): its frames, its clip and its
/// sheet. The clip's path.
@job
pub fn shoot(
    c: take Capture,
    out: take String,
    width: take u32,
    height: take u32,
) -> Result<String, String> {
    let frames = String::from(f"{out}/{c.name}")
    var gone = wait(files::remove_all(frames.as_str()))
    while !gone.ready() { yield }
    let _ = gone.bytes()
    var made = wait(files::make_dirs(frames.as_str()))
    while !made.ready() { yield }
    let _ = made.bytes()?
    var options = drive::gpu()
    options.width = width
    options.height = height
    options.timeout = 600.0
    var l = wait(drive::load(BUILD, options))
    while !l.ready() { yield }
    let b = said(drive::read_loaded(l.polled()))?.build
    var i = wait(drive::init(b, timeout: 600.0))
    while !i.ready() { yield }
    trapped("init", said(drive::read_ran(i.polled()))?)?
    // The frames before the first kept one run alone, so the history is the same.
    var pre = wait(drive::frames(b, c.first, c.keys.clone(), timeout: 600.0))
    while !pre.ready() { yield }
    trapped("the frames before", said(drive::read_ran(pre.polled()))?)?
    let shown = picks(c.first, c.last)
    let half = image::Size { width: width / 2, height: height / 2 }
    var cells: Vec<Vec<u8>> = Vec::new()
    // Each frame's PNG is encoded and written while the next frames render, `SAVING` at most.
    var saving: Vec<Box<Job<write_png>>> = Vec::new()
    for n in c.first..c.last + 1 {
        var k = 0
        while k < saving.len() || saving.len() >= SAVING {
            if k >= saving.len() {
                yield
                k = 0
                continue
            }
            match saving[k].get_mut().resume() {
                Step::Yielded => k += 1,
                Step::Done(r) => {
                    (take r)?
                    let _ = saving.remove(k)
                },
            }
        }
        var f = wait(drive::frames(b, 1, c.keys.clone(), timeout: 600.0))
        while !f.ready() { yield }
        trapped(f"frame {n}", said(drive::read_ran(f.polled()))?)?
        var cap = wait(drive::capture(b, timeout: 600.0))
        while !cap.ready() { yield }
        let screen = said(drive::read_capture(cap.polled()))?
        let img = image::Image {
            width: screen.width,
            height: screen.height,
            rgba: take screen.rgba,
        }
        // A frame the sheet shows, at half size.
        var sheet_cell = false
        for p in shown {
            if p == n {
                sheet_cell = true
            }
        }
        if sheet_cell && cells.len() < 6 {
            var rs = wait(image::resize(img.clone(), half, timeout: 600.0))
            while !rs.ready() { yield }
            let small = said(image::read_image(rs.polled()))?
            var j = Box::new(data_bytes.start(take small.rgba))
            var px = done(j.get_mut().resume())
            while px.is_none() {
                yield
                px = done(j.get_mut().resume())
            }
            cells.push(joined((take px).unwrap()?))
        }
        var w = Box::new(write_png.start(take img, String::from(f"{frames}/{n:05}.png")))
        match w.get_mut().resume() {
            Step::Yielded => saving.push(take w),
            Step::Done(r) => (take r)?,
        }
    }
    while !saving.is_empty() {
        var k = 0
        while k < saving.len() {
            match saving[k].get_mut().resume() {
                Step::Yielded => k += 1,
                Step::Done(r) => {
                    (take r)?
                    let _ = saving.remove(k)
                },
            }
        }
        if !saving.is_empty() {
            yield
        }
    }
    var shut = wait(drive::close(b))
    while !shut.ready() { yield }
    let clip = String::from(f"{out}/{c.name}.mp4")
    let from = shown_path(frames.as_str())
    var ff = Box::new(
        ffmpeg.start(
            Vec::from(
                [
                    String::from("-y"),
                    String::from("-loglevel"),
                    String::from("error"),
                    String::from("-threads"),
                    String::from("1"),
                    String::from("-framerate"),
                    String::from("60"),
                    String::from("-start_number"),
                    String::from(f"{c.first}"),
                    String::from("-i"),
                    String::from(f"{from}/%05d.png"),
                    String::from("-c:v"),
                    String::from("libx264"),
                    String::from("-crf"),
                    String::from("12"),
                    String::from("-pix_fmt"),
                    String::from("yuv420p"),
                    String::from(shown_path(clip.as_str())),
                ],
            ),
        ),
    )
    var fr = done(ff.get_mut().resume())
    while fr.is_none() {
        yield
        fr = done(ff.get_mut().resume())
    }
    (take fr).unwrap()?
    let sheet = compose(cells, shown, half.width, half.height)
    var sj = Box::new(write_sheet.start(take sheet, String::from(f"{out}/{c.name}-sheet.webp")))
    var sr = done(sj.get_mut().resume())
    while sr.is_none() {
        yield
        sr = done(sj.get_mut().resume())
    }
    (take sr).unwrap()?
    Ok(clip)
}

/// Writes `img` as a WebP at `path` (a root path in a write root).
@job
pub fn write_sheet(img: take Image, path: take String) -> Result<(), String> {
    var bj = Box::new(blob_of.start(img.rgba_chunks()))
    var made = done(bj.get_mut().resume())
    while made.is_none() {
        yield
        made = done(bj.get_mut().resume())
    }
    let pixels = (take made).unwrap()?
    var e = wait(
        image::encode_webp(
            image::Image { width: img.w, height: img.h, rgba: Data::Blob(pixels) },
            quality: 90.0,
            method: 4,
            timeout: 600.0,
        ),
    )
    while !e.ready() { yield }
    var g = wait(blob::release(pixels))
    while !g.ready() { yield }
    let webp = said(image::read_encoded(e.polled()))?
    var w = Box::new(write_data.start(take path, take webp))
    var wr = done(w.get_mut().resume())
    while wr.is_none() {
        yield
        wr = done(w.get_mut().resume())
    }
    (take wr).unwrap()
}

@job
fn main(given: take Vec<String>) -> u32 {
    let o = match parse_args(given) {
        Ok(o) => take o,
        Err(e) => {
            print(e.as_str())
            return 2
        },
    }
    var md = wait(files::make_dirs(o.out.as_str()))
    while !md.ready() { yield }
    if let Err(e) = md.bytes() {
        print(f"motion: {e}")
        return 1
    }
    for k in 0..o.captures.len() {
        let c = o.captures[k].clone()
        let name = c.name
        var j = Box::new(shoot.start(take c, o.out.clone(), o.width, o.height))
        var r = done(j.get_mut().resume())
        while r.is_none() {
            yield
            r = done(j.get_mut().resume())
        }
        match (take r).unwrap() {
            Ok(clip) => print(f"{name} {shown_path(clip.as_str())}"),
            Err(e) => {
                print(f"capture {name} failed: {e}")
                return 1
            },
        }
    }
    0
}

pub fn tool_init() -> Job<main> {
    main.start(args())
}

pub fn tool(job: mut Job<main>) -> u32 {
    match job.resume() {
        Step::Yielded => RUNNING,
        Step::Done(status) => status,
    }
}
