// The feel bench (`wrela tool feel`): how the fight feels to play, read off the fight's real
// rules (mmo/combat), its real input path (the client's `Encoder` and look-ahead) and the bodies
// that draw it (mmo/game's `bodies`), stepped as the client steps them at 60 frames a second,
// with no GPU. A person feels a fight's lag, its dropped presses, how long a tell warns them and
// whether what's seen to land is what hits; each is a number here.
//
// ```text
// wrela tool feel -- [<out-dir>]
// ```
//
// It prints the sheet, and writes it as `<out-dir>/feel.md` (a path in the workspace) when one
// is given. What it reads:
// - **Press to drawing**: from the step that reads a press to the first drawing in which the
//   player's body has moved (any joint 5 mm from where it'd be had nothing been pressed). The
//   target is 1: the drawing right after that step.
// - **Presses**: a script of presses (a player mashing a pattern every `CADENCE` frames,
//   walking in between) through the client's input path, at each of `BUFFERS` frames of the
//   rules' input buffer: how many an action began from and how long after, how many the rules
//   kept and nothing began from, and how many were dropped and how early each was.
// - **Packets**: the changes, packets and bytes each player sends over the relay in a fight.
// - **Each move's windows**: its frames as the rules have them.
// - **Warning before the idol's hits**: from the first drawing in which its body has moved
//   (2 cm) toward its hit to the frame the rules hit. The target is at least 14.
// - **Hit to drawn contact**: from the frame the rules hit to the drawing whose fist is nearest
//   where the move puts it on its contact. The target is 0.
// - **Drift**: how far the drawn bodies are from the rules' places in a fight whose second
//   player is heard `LATE` frames late, so the first's client predicts and corrects.
// - **Chains**: each weapon's chain struck at the idol standing still: whether each strike lands
//   after the one before pushed it (`sim::push_of`), and whether it would had it been a man.
// - **Bots**: a bot that answers the idol's tell 12, 15, 18 and 24 frames in, alone against it.

use std::collections::Vec
use std::string::String
use std::io::print
use std::tool::args
use std::tool::files
use std::tool::files::rooted
use engine::humanoid::pose_world
use watch::bots::{bot, dist, stick_to}
use combat::codec::{Encoder, LOOK_AHEAD, Link, Pad}
use combat::sim::{
    ACTIVE, ATTACK, ATTACKS, BUTTON_BITS, DODGE, DODGING, PARRYING, FISTS, HEAVY, HZ, IDLE,
    LONGSWORD, MOVES, NO_MOVE, PARRY, RECOVER, STAGGERED, STICK_BITS, Seen, WEAPONS, WINDUP, World,
    step,
}
use mmo::bodies
use mmo::bodies::{Bodies, Body, Shown, drawn_at, place_of, shown}
use humanoid::body::HERO
use humanoid::solved

pub const USAGE: Text = "usage: wrela tool feel -- [<out-dir>]"

/// A drawing's step (s): the client steps the rules and draws once a frame.
const DT: f32 = 1.0 / 60.0
/// How far a joint moves before a drawing has moved (m): for a press, and for the idol's tell.
const MOVED: f32 = 0.005
const TELL_MOVED: f32 = 0.02
/// The script: a press every `CADENCE` frames (a person mashing), from `SCRIPT_FROM`, `PRESSES`
/// of them, in `PATTERN`'s order.
const CADENCE: u32 = 9
const SCRIPT_FROM: u32 = 150
const PRESSES: u32 = 120
const PATTERN: [u32; 8] = [ATTACK, ATTACK, ATTACK, HEAVY, DODGE, ATTACK, PARRY, ATTACK]
/// How late the second player is heard in the drift's fight (frames), and how long it runs.
const LATE: u32 = 6
const DRIFT_FRAMES: u32 = 1800
/// The bots' reactions (frames into the idol's windup), and how long each fights at most.
const REACTIONS: [u32; 4] = [12, 15, 18, 24]
const BOT_FRAMES: u32 = 10800

// ---- what a drawing shows ------------------------------------------------------------------------

/// Each joint of what `s` shows, where it's drawn (m).
fn joints(s: Shown) -> [vec3; 64] {
    let w = pose_world(HERO.rig, s.pose)
    var out = [vec3(0.0); 64]
    for b in 0..HERO.rig.bones.len() {
        out[b] = (s.place * vec4(w[b].t, 1.0)).xyz
    }
    out
}

/// How far apart two drawings are at the joint that's furthest (m).
fn apart(a: Shown, b: Shown) -> f32 {
    let (ja, jb) = (joints(a), joints(b))
    var most = 0.0
    for i in 0..HERO.rig.bones.len() {
        most = max(most, length(ja[i] - jb[i]))
    }
    most
}

/// The right fist of `pose`, in the pose's own space (where it's drawn left out).
fn fist_of(pose: engine::humanoid::Pose) -> vec3 {
    pose_world(HERO.rig, pose)[HERO.rig.find("rightHand")].t
}

// ---- press to drawing ----------------------------------------------------------------------------

/// The drawings from the step that reads `input` (pressed from idle with `weapon`) to the first
/// in which the body has moved; 0 if none does within half a second.
fn reply(weapon: u32, input: u32) -> u32 {
    var w = World::armed([weapon])
    var b = Bodies::new()
    for _ in 0..40 {
        step(mut w, [0])
        let _ = b.follow(w, DT)
    }
    var w2 = w.clone()
    var b2 = b.clone()
    for k in 1..31 {
        step(mut w, [input])
        step(mut w2, [0])
        let pressed = b.follow(w, DT)
        let still = b2.follow(w2, DT)
        if apart(pressed[1], still[1]) > MOVED {
            return k
        }
    }
    0
}

fn replies() -> String {
    var t = String::from(
        "## Press to drawing\n\nDrawings from the step that reads a press to the first that moves (target 1).\n\n| Press | Drawings |\n|---|---|\n",
    )
    let side = stick_to(dx: 1, dz: 0, speed: 2)
    let rows: [(Text, u32, u32); 6] = [
        ("Fists, light", FISTS, ATTACK << 6),
        ("Fists, heavy", FISTS, HEAVY << 6),
        ("Longsword, light", LONGSWORD, ATTACK << 6),
        ("Longsword, heavy", LONGSWORD, HEAVY << 6),
        ("Parry", LONGSWORD, PARRY << 6),
        ("Dodge", LONGSWORD, (DODGE << 6) | side),
    ]
    for (name, weapon, input) in rows {
        let k = reply(weapon, input)
        let shown = if k == 0 { String::from("none within 30") } else { String::from(f"{k}") }
        t.push_str(f"| {name} | {shown} |\n".as_str())
    }
    t
}

// ---- presses the rules read nothing for ----------------------------------------------------------

/// The pad the script holds at frame `f` of `w`: walking to the idol while out of reach, a press
/// every `CADENCE` frames from `SCRIPT_FROM`, and the stick aside for a dodge.
fn script_pad(w: World, f: u32) -> Pad {
    let p = w.player(0)
    let b = w.boss()
    let (dx, dz) = (b.x - p.x, b.z - p.z)
    let d = max(dist(dx, dz), 1)
    let reach = MOVES[WEAPONS[LONGSWORD].light].reach
    var pad = Pad { x: 0.0, z: 0.0, held: 0 }
    if d > reach - 16 {
        pad.x = f32(dx) / f32(d) * 0.6
        pad.z = f32(dz) / f32(d) * 0.6
    }
    if f >= SCRIPT_FROM &&
        (f - SCRIPT_FROM) % CADENCE == 0 &&
        (f - SCRIPT_FROM) / CADENCE < PRESSES {
        let button = PATTERN[((f - SCRIPT_FROM) / CADENCE) % 8]
        pad.pressed = button
        if button == DODGE {
            pad.x = -f32(dz) / f32(d)
            pad.z = f32(dx) / f32(d)
        }
    }
    pad
}

/// The lengths of the rules' input buffer the presses are read at (frames).
const BUFFERS: [u32; 4] = [6, 8, 10, 12]

/// Whether `w` shows player 0 beginning an action as it goes on from `was`: what press it began
/// from (`ATTACK` and the rest; 0 for none).
fn begun_by(was: Seen, now: Seen) -> u32 {
    let fresh = now.act != was.act || now.move_ != was.move_
    if now.act == WINDUP && fresh && now.move_ != NO_MOVE {
        // (The longsword's light cuts, its combo, are 2 to 4; its heavy, the overhead, 5.)
        return if now.move_ == WEAPONS[LONGSWORD].heavy { HEAVY } else { ATTACK }
    }
    if now.act == PARRYING && was.act != PARRYING {
        return PARRY
    }
    if now.act == DODGING && was.act != DODGING {
        return DODGE
    }
    0
}

/// How many frames on from `w` player 0 can act on `button`, its input held at `input`: when the
/// rules, keeping nothing, would read it.
fn frames_till(w: World, button: u32, input: u32) -> u32 {
    var c = w.buffered(0)
    for k in 0..240 {
        if c.reads(0) & (button << 6) != 0 || c.over {
            return k
        }
        step(mut c, [input])
    }
    240
}

/// The script's presses at a buffer of `buffer` frames: the row of the sheet.
fn presses_at(buffer: u32) -> String {
    let fresh = || -> World { World::armed([LONGSWORD]).buffered(buffer) }
    var w = fresh()
    var enc = Encoder::new()
    var prev: u32 = 0
    // The presses the rules read and haven't acted on yet: (frame, button).
    var pending: Vec<(u32, u32)> = Vec::new()
    var made = 0
    var acted = 0
    var waits: Vec<u32> = Vec::new()
    var unused = 0
    var early: Vec<u32> = Vec::new()
    let end = SCRIPT_FROM + CADENCE * PRESSES + 30
    var fights = 1
    for f in 0..end {
        if w.over {
            // (The idol won: the script goes on in a fight begun anew.)
            w = fresh()
            enc = Encoder::new()
            prev = 0
            unused += pending.len()
            pending.clear()
            fights += 1
        }
        let pad = script_pad(w, f)
        // As the client's `tick`: what's read now, and within the look-ahead.
        let ready = w.reads(0)
        var reads = ready
        if ready & (STICK_BITS | BUTTON_BITS) != (STICK_BITS | BUTTON_BITS) {
            reads |= w.soon(0, [prev], LOOK_AHEAD)
        }
        let input = enc.input(pad, prev: prev, reads: reads, now: ready)
        let flips = ((input ^ prev) & BUTTON_BITS) >> 6
        for k in 0..4 {
            let bit = u32(1) << k
            if pad.pressed & bit != 0 {
                made += 1
                if flips & bit != 0 {
                    // (A later press replaces the one the rules kept.)
                    unused += pending.len()
                    pending.clear()
                    pending.push((f, bit))
                } else {
                    early.push(frames_till(w, bit, prev))
                }
            }
        }
        let was = w.player(0)
        prev = input
        step(mut w, [input])
        let by = begun_by(was, w.player(0))
        if by != 0 && !pending.is_empty() && pending[0].1 == by {
            acted += 1
            waits.push(f - pending[0].0)
            pending.clear()
        }
        if !pending.is_empty() && f - pending[0].0 > buffer + 2 {
            unused += 1
            pending.clear()
        }
    }
    var longest = 0
    var total = 0
    for x in waits {
        longest = max(longest, x)
        total += x
    }
    let mean = if waits.is_empty() { 0.0 } else { f32(total) / f32(waits.len()) }
    // How early the dropped ones were: within the buffer and a frame of it, a little more, and
    // far too early (a fifth of a second and more).
    var near = 0
    var some = 0
    var far = 0
    for e in early {
        if e <= buffer + 1 { near += 1 } else if e < 12 + buffer { some += 1 } else { far += 1 }
    }
    String::from(
        f"| {buffer} | {made} | {acted} (after {mean:.1} frames on average, {longest} at most) | {unused} | {early.len()}: {near} within the buffer, {some} up to 11 frames before it, {far} further ({fights} fights) |\n",
    )
}

fn presses() -> String {
    var t = String::from(
        f"## Presses\n\nA press every {CADENCE} frames ({PRESSES} of them: attack, attack, attack, heavy, dodge, attack, parry, attack, over again), walking in to the idol, with the longsword, through the client's input path, at each length of the rules' input buffer (`sim::BUFFER`; the rules read a button from that many frames before its fighter can act on it, and keep its press till then). A fight begins anew when the idol wins. Acted on: an action began from it. Read, not acted on: the rules kept it and nothing began (too little stamina, or a later press replaced it). Dropped: the rules read nothing then; how early each was is how many frames before its fighter could act on it.\n\n| Buffer | Presses | Acted on | Read, not acted on | Dropped: how early |\n|---|---|---|---|---|\n",
    )
    for b in BUFFERS {
        t.push_str(presses_at(b).as_str())
    }
    t
}

/// The packets each player sends over the relay in the two bots' fight (`drift`'s, each heard
/// at once), and their bytes.
fn packets() -> String {
    let weapons = [FISTS, LONGSWORD]
    var w = World::armed(weapons)
    var a = Link::new(me: 0, party: 2)
    var b = Link::new(me: 1, party: 2)
    var before = [u32(0), 0]
    var sent = 0
    var bytes = 0
    var changes = 0
    for f in 0..DRIFT_FRAMES {
        if w.over {
            break
        }
        let ins = [bot(w, 0, before[0], weapons[0], 15), bot(w, 1, before[1], weapons[1], 15)]
        for i in 0..2 {
            if ins[i] != before[i] {
                changes += 1
            }
        }
        if let Some(p) = a.send(f, ins[0]) {
            sent += 1
            bytes += p.len()
            let _ = b.heard(0, p, f)
        }
        if let Some(p) = b.send(f, ins[1]) {
            sent += 1
            bytes += p.len()
            let _ = a.heard(1, p, f)
        }
        before = ins
        step(mut w, ins)
    }
    String::from(
        f"## Packets\n\nThe two bots' fight ({DRIFT_FRAMES} frames at most), each player's input over the relay, each packet heard at once: {changes} changes of input, {sent} packets, {bytes} bytes.\n",
    )
}

// ---- the windows ---------------------------------------------------------------------------------

fn windows() -> String {
    var t = String::from(
        "## Each move's windows\n\nFrames, as the rules have them. A combo's window is the recovery a light press goes on from.\n\n| Move | Windup | Active | Recovery | Combo window | Reach (m) | Damage |\n|---|---|---|---|---|---|---|\n",
    )
    let names: [Text; 6] = [
        "Fists, jab",
        "Fists, straight",
        "Longsword, cut 1",
        "Longsword, cut 2",
        "Longsword, cut 3",
        "Longsword, overhead",
    ]
    for i in 0..MOVES.len() {
        let m = MOVES[i]
        let combo = if m.next != NO_MOVE { m.recovery } else { 0 }
        t.push_str(
            f"| {names[i]} | {m.windup} | {m.active} | {m.recovery} | {combo} | {f32(m.reach) / bodies::UNIT:.2} | {m.damage} |\n".as_str(),
        )
    }
    t.push_str(
        "\n| The idol's | Tell (windup) | Active | Recovery (its opening) | Met by | Reach (m) | Damage |\n|---|---|---|---|---|---|---|\n",
    )
    for a in ATTACKS {
        let met = if a.parried { "a parry or a dodge" } else { "a dodge" }
        t.push_str(
            f"| {a.name} | {a.windup} | {a.active} | {a.recovery} | {met} | {f32(a.near) / bodies::UNIT:.2} to {f32(a.far) / bodies::UNIT:.2} | {a.damage} |\n".as_str(),
        )
    }
    t
}

// ---- a strike drawn against the rules' frames ----------------------------------------------------

/// What the rules say of a fighter `k` frames after they begin strike `m` (the boss's, or a
/// player's): its timer stepped as `sim` steps it, each step a frame.
fn striking(boss: bool, m: u32, k: u32) -> Seen {
    let (w, a, r) = if boss {
        (ATTACKS[m].windup, ATTACKS[m].active, ATTACKS[m].recovery)
    } else { (MOVES[m].windup, MOVES[m].active, MOVES[m].recovery) }
    let (act, timer, move_) = if k < w { (WINDUP, w - k, m) } else if k < w + a {
        (ACTIVE, w + a - k, m)
    } else if k < w + a + r { (RECOVER, w + a + r - k, m) } else { (IDLE, 0, NO_MOVE) }
    Seen { x: 0, z: 0, hp: 100, stamina: 100, act, timer, move_, facing: 4 }
}

fn still() -> Seen {
    Seen { x: 0, z: 0, hp: 100, stamina: 100, act: IDLE, timer: 0, move_: NO_MOVE, facing: 4 }
}

/// A strike drawn as the rules time it, from a body that stood a second: the frame (from when the
/// rules began it) of its first drawing that moved `moved` from where it'd stand, and of the
/// drawing whose fist was nearest where the move puts it on its contact.
fn drawn_strike(boss: bool, m: u32, moved: f32) -> (u32, u32, f32) {
    var b = Body::new(still(), boss: boss)
    let mask = Bodies::new().mask()
    var frame: u32 = 1
    for _ in 0..60 {
        let _ = shown(mut b, still(), frame, mask, DT)
        frame += 1
    }
    var idle = b
    // Where the written strike puts its fist on its contact, as written (not the played move's
    // own pose on the hit frame, which is wherever the fist is then): every strike the game plays
    // is the solved cross (mmo/game's `bodies`).
    let hit = if boss { ATTACKS[m].windup + 1 } else { MOVES[m].windup }
    let target = solved::cross().end(HERO.rig, solved::CONTACT)
    var on_hit = 0.0
    var first: u32 = 0
    var nearest: u32 = 0
    var best = 1.0e9
    let (w, a, r) = if boss {
        (ATTACKS[m].windup, ATTACKS[m].active, ATTACKS[m].recovery)
    } else { (MOVES[m].windup, MOVES[m].active, MOVES[m].recovery) }
    for k in 0..(w + a + r) {
        let s = shown(mut b, striking(boss, m, k), frame, mask, DT)
        let i = shown(mut idle, still(), frame, mask, DT)
        frame += 1
        if first == 0 && apart(s, i) > moved {
            first = k
        }
        let d = length(fist_of(s.pose) - target)
        if k == hit {
            on_hit = d
        }
        if d < best - 1.0e-5 {
            best = d
            nearest = k
        }
    }
    (first, nearest, on_hit)
}

fn warnings() -> String {
    var t = String::from(
        "## Warning before the idol's hits\n\nFrames from the first drawing in which the idol has moved toward its hit to the frame the rules hit (target at least 14).\n\n| Attack | Tell | Warning |\n|---|---|---|\n",
    )
    for i in 0..ATTACKS.len() {
        let (first, _, _) = drawn_strike(boss: true, m: i, moved: TELL_MOVED)
        // (Its rules meet the party a step after its windup ends.)
        let hit = ATTACKS[i].windup + 1
        t.push_str(f"| {ATTACKS[i].name} | {ATTACKS[i].windup} | {hit - first} |\n".as_str())
    }
    t
}

fn contacts() -> String {
    var t = String::from(
        "## Hit to drawn contact\n\nFrames from the rules' hit to the drawing whose fist is nearest where the written cross puts it on its contact, and how far it is from there on the hit frame (target 0; negative: drawn before the hit). The fight draws a strike on twos, a drawing every 5 frames.\n\n| Strike | Rules hit (frame) | Drawn contact (frame) | Off by | Fist from its contact on the hit frame (cm) |\n|---|---|---|---|---|\n",
    )
    for i in 0..MOVES.len() {
        let (_, near, off) = drawn_strike(boss: false, m: i, moved: MOVED)
        let hit = MOVES[i].windup
        t.push_str(
            f"| Move {i} | {hit} | {near} | {i32(near) - i32(hit)} | {off * 100.0:.1} |\n".as_str(),
        )
    }
    for i in 0..ATTACKS.len() {
        let (_, near, off) = drawn_strike(boss: true, m: i, moved: MOVED)
        let hit = ATTACKS[i].windup + 1
        t.push_str(
            f"| The idol's {ATTACKS[i].name} | {hit} | {near} | {i32(near) - i32(hit)} | {off * 100.0:.1} |\n".as_str(),
        )
    }
    t
}

// ---- drift ---------------------------------------------------------------------------------------

fn drift() -> String {
    let weapons = [FISTS, LONGSWORD]
    var truth = World::armed(weapons)
    var past: Vec<World> = Vec::new()
    var inputs: Vec<Vec<u32>> = Vec::from([Vec::new(), Vec::new()])
    var b = Bodies::new()
    // The boss's, then each player's: the most and the sum from the client's rules, and the
    // most from the true rules.
    var most = [0.0; 3]
    var sum = [0.0; 3]
    var most_true = [0.0; 3]
    var n = 0
    for f in 0..DRIFT_FRAMES {
        if truth.over {
            break
        }
        var ins: Vec<u32> = Vec::new()
        for i in 0..2 {
            let before = if f > 0 { inputs[i][f - 1] } else { 0 }
            let x = bot(truth, i, before, weapons[i], 15)
            inputs[i].push(x)
            ins.push(x)
        }
        past.push(truth.clone())
        if past.len() > LATE {
            past.remove(0)
        }
        step(mut truth, ins)
        // The first player's client: the second's input held at the last it heard.
        var w = past[0].clone()
        let heard = if w.frame > 0 { inputs[1][w.frame - 1] } else { 0 }
        while w.frame < truth.frame {
            let g = w.frame
            step(mut w, [inputs[0][g], heard])
        }
        let _ = b.follow(w, DT)
        for k in 0..3 {
            let (said, real) = if k == 0 { (w.boss(), truth.boss()) } else {
                (w.player(k - 1), truth.player(k - 1))
            }
            let at = drawn_at(b.body(k))
            let off = length(at - place_of(said))
            most[k] = max(most[k], off)
            most_true[k] = max(most_true[k], length(at - place_of(real)))
            sum[k] += off
        }
        n += 1
    }
    var t = String::from(
        f"## Drift\n\nTwo bots against the idol for {n} frames, the second heard {LATE} frames late (the first's client predicts it, and corrects): how far each drawn body is from the place the rules give it (m). A dodge carries a body 3.75 m in 12 frames.\n\n| Body | From the client's rules: most | mean | From the true rules: most |\n|---|---|---|---|\n",
    )
    let names: [Text; 3] = ["The idol", "P1 (this client's)", "P2 (heard late)"]
    for k in 0..3 {
        t.push_str(
            f"| {names[k]} | {most[k]:.3} | {sum[k] / f32(max(n, 1)):.3} | {most_true[k]:.3} |\n".as_str(),
        )
    }
    t
}

// ---- chains --------------------------------------------------------------------------------------

/// Each weapon's chain (its light attack and each combo's next, pressed every frame) struck at the
/// idol standing still (`World::standing_still`), from just inside the first's reach: whether
/// each hit lands, and how far the idol is at each (its pushes, `sim::push_of`, carry it off).
/// Its last column is how far it would be had each strike before pushed it as far as a man (the
/// idol takes a quarter, `sim::IDOL_TAKES`), against the move's reach.
fn chains() -> String {
    var t = String::from(
        "## Each weapon's chain against a foe standing still\n\nThe chain pressed every frame at the idol standing still, from 16 units inside the first strike's reach: each strike, whether it landed, the idol's distance as it struck (m), how far it had been pushed (m), and the distance had each strike before pushed it as far as a man (m), against the strike's reach (m).\n\n| Weapon | Strike | Landed | Distance | Pushed so far | Had it been a man | Reach |\n|---|---|---|---|---|---|---|\n",
    )
    let names = ["Fists", "Longsword"]
    for weapon in [FISTS, LONGSWORD] {
        var w = World::armed([weapon]).standing_still()
        let first = MOVES[WEAPONS[weapon].light]
        var input: u32 = 0
        // Walk in, to just inside the first strike's reach.
        for _ in 0..900 {
            let p = w.player(0)
            let b = w.boss()
            let (dx, dz) = (b.x - p.x, b.z - p.z)
            if dist(dx, dz) <= first.reach - 16 {
                break
            }
            input = (input & BUTTON_BITS) | stick_to(dx, dz, 1)
            step(mut w, [input])
        }
        // Face it, then strike, pressing every frame, till the chain's done.
        let p = w.player(0)
        let b = w.boss()
        input = (input & BUTTON_BITS) | stick_to(b.x - p.x, b.z - p.z, 0)
        step(mut w, [input])
        let start = w.boss()
        var hp = w.boss().hp
        var m = WEAPONS[weapon].light
        var k = 0
        var begun = false
        var man = 0
        for _ in 0..400 {
            input = (input ^ (ATTACK << 6)) & BUTTON_BITS
            let was = w.player(0)
            step(mut w, [input])
            let now = w.player(0)
            if now.act == WINDUP && (was.act != WINDUP || was.move_ != now.move_) {
                if begun {
                    // (A strike begun that never landed.)
                    t.push_str(
                        f"| {names[weapon]} | {k + 1} | no | | | | {f32(MOVES[m].reach) / bodies::UNIT:.2} |\n".as_str(),
                    )
                    k += 1
                }
                begun = true
                m = now.move_
            }
            let b = w.boss()
            if b.hp < hp {
                let d = f32(dist(b.x - now.x, b.z - now.z)) / bodies::UNIT
                let pushed = f32(dist(b.x - start.x, b.z - start.z)) / bodies::UNIT
                t.push_str(
                    f"| {names[weapon]} | {k + 1} | yes | {d:.2} | {pushed:.3} | {d - pushed + f32(man) / bodies::UNIT:.2} | {f32(MOVES[m].reach) / bodies::UNIT:.2} |\n".as_str(),
                )
                man += combat::sim::push_of(combat::sim::hold_of(MOVES[m].damage))
                k += 1
                begun = false
                hp = b.hp
            }
            if was.act != IDLE && now.act == IDLE && MOVES[m].next == NO_MOVE {
                break
            }
        }
    }
    t
}

// ---- bots ----------------------------------------------------------------------------------------

fn bots() -> String {
    var t = String::from(
        "## Bots answering the tell\n\nOne bot with the longsword, alone against the idol, answering its tell this many frames in: what came of the idol's attacks that met it.\n\n| Reaction | Outcome | Frames | Its health | Hit | Parried | Passed by |\n|---|---|---|---|---|---|---|\n",
    )
    for react in REACTIONS {
        var w = World::armed([LONGSWORD])
        var before: u32 = 0
        var hit = 0
        var parried = 0
        var passed = 0
        var was = w.boss()
        var hp = w.player(0).hp
        for _ in 0..BOT_FRAMES {
            if w.over {
                break
            }
            let x = bot(w, 0, before, LONGSWORD, react)
            before = x
            step(mut w, [x])
            let b = w.boss()
            let p = w.player(0)
            if p.hp < hp {
                hit += 1
            }
            if b.act == STAGGERED && was.act != STAGGERED {
                parried += 1
            }
            // An attack ended whose active frames met neither.
            if was.act == ACTIVE && b.act != ACTIVE && b.act != STAGGERED && p.hp == hp {
                passed += 1
            }
            hp = p.hp
            was = b
        }
        let outcome = if !w.over { "still going" } else {
            match w.winner {
                combat::sim::Winner::Party => "the bot wins",
                combat::sim::Winner::Boss => "the idol wins",
                combat::sim::Winner::Draw => "a draw",
            }
        }
        t.push_str(
            f"| {react} | {outcome} | {w.frame} | {w.player(0).hp} | {hit} | {parried} | {passed} |\n".as_str(),
        )
    }
    t
}

// ---- the tool ------------------------------------------------------------------------------------

/// The whole sheet.
pub fn sheet() -> String {
    var t = String::from("# The feel bench\n\n")
    for part in [
        replies(),
        presses(),
        packets(),
        windows(),
        warnings(),
        contacts(),
        drift(),
        chains(),
        bots(),
    ] {
        t.push_str(part.as_str())
        t.push_str("\n")
    }
    t
}

pub fn tool() -> u32 {
    let wanted = args()
    if wanted.len() > 1 {
        print(USAGE)
        return 2
    }
    let text = sheet()
    print(text.as_str())
    if wanted.len() == 1 {
        let Some(dir) = rooted("ws", wanted[0].as_str()) else {
            print(f"feel: no path for {wanted[0]}")
            return 2
        }
        if let Err(e) = files::make_dirs(dir.as_str()).wait() {
            print(f"feel: {e.message()}")
            return 1
        }
        if files::write(f"{dir}/feel.md".as_str(), text.as_bytes()).wait().is_err() {
            print(f"feel: couldn't write {dir}/feel.md")
            return 1
        }
    }
    0
}

// ---- tests --------------------------------------------------------------------------------------

/// A press shows on the drawing right after the step that reads it, a light one and a heavy one.
@test
fn a_press_shows_on_the_next_drawing() {
    assert(reply(LONGSWORD, ATTACK << 6) == 1, "a light cut")
    assert(reply(LONGSWORD, HEAVY << 6) == 1, "the overhead")
}

/// Every strike is drawn landing on the frame the rules hit, and the idol's warn a person for
/// at least 14 frames.
@test
fn strikes_land_when_the_rules_hit_and_the_idol_warns() {
    for i in 0..MOVES.len() {
        let (_, near, off) = drawn_strike(boss: false, m: i, moved: MOVED)
        assert(off < 0.02, "on the hit frame the fist is on its contact")
        assert(near == MOVES[i].windup, "a player's strike lands as the rules hit")
    }
    for i in 0..ATTACKS.len() {
        let (first, near, off) = drawn_strike(boss: true, m: i, moved: TELL_MOVED)
        assert(off < 0.02, "the idol's fist is on its contact on the hit frame")
        assert(near == ATTACKS[i].windup + 1, "the idol's strike lands as the rules hit")
        assert(ATTACKS[i].windup + 1 - first >= 14, "it warns for at least 14 frames")
    }
}
