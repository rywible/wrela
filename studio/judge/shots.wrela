// The judging tool's scenes, shots and command line: what is pure of the tool, so its tests need
// no build.

use std::tool::files::rooted
use std::tool::toolchain::Set

/// The root the tool reads and writes the workspace in.
pub const WS: Text = "ws"

/// A scene: a program (its package, from the workspace's root) built with constants and driven
/// at a size and a frame rate, and the frames a clip of it keeps (from `clip_first` to
/// `clip_last`; none where the last isn't past the first).
pub struct Scene: Clone {
    pub name: Text,
    pub program: Text,
    pub sets: Vec<Set>,
    pub width: u32,
    pub height: u32,
    pub fps: f64,
    pub clip_first: u32 = 0,
    pub clip_last: u32 = 0,
    /// Where its figure is on the screen: what the look made for a person's eye is cropped to
    /// (`look_of` in main.wrela); nothing (no width) for a scene with no such look.
    pub look: Crop = Crop { x0: 0, y0: 0, x1: 0, y1: 0 },
}

/// A crop of the screen: from (`x0`, `y0`) up to (`x1`, `y1`), in pixels.
pub struct Crop: Copy + Eq {
    pub x0: u32,
    pub y0: u32,
    pub x1: u32,
    pub y1: u32,
}

/// A shot: its name; its scene's; the frames it shows, counted from the build's first (0), in
/// order (one: a still; several: a strip, a row a frame, each labelled by its number); each
/// frame's crop; the size each is shown at (`up` times its pixels over `down`); and what it's
/// there to show, for the critics' brief.
pub struct Shot: Clone {
    pub name: Text,
    pub scene: Text,
    pub frames: Vec<u32>,
    pub crop: Crop,
    pub up: u32 = 1,
    pub down: u32 = 1,
    pub about: Text,
}

/// `NAME=VALUE`, as `wrela build --set` takes it.
pub fn set(name: str, value: str) -> Set {
    Set { name: String::from(name), value: String::from(value) }
}

/// `NAME=VALUE` as a `Set`, or `None` if it has no `=` or no name.
pub fn set_of(s: str) -> Option<Set> {
    let at = s.find("=")?
    if at == 0 {
        return None
    }
    Some(set(s.slice(0, at), s.slice(at + 1, s.len())))
}

/// The scenes' names.
pub const SCENES: [Text; 8] = [
    "exchange",
    "played",
    "rider",
    "rider-quarter",
    "turnaround",
    "turnaround-large",
    "run",
    "roll",
]

/// The scene named `name`, if there is one.
/// - `exchange`: the combat lab's exchange (content/humanoid, `SHOW=28`): Hakuro and his double
///   in their guards, a step in, the cross thrown and landed, and the recovery, at 30 frames a
///   second; its clip is the cross and the one struck thrown and home again (four seconds before
///   it lands, three and a half after), and its look both fighters, stood apart and the striker
///   stepping in.
/// - `played`: the lab's fight as it's played (`SHOW=12`): the body bounces in its guard, steps
///   in and throws its cross, at 60 frames a second; its clip is the cross, from the step in
///   to the fist home.
/// - `rider`: the opening (scenes/opening) with its traveller close (`VIEW=8`): Hakuro aboard
///   the skiff, a hand to the sail's boom, riding the swell, at 60 frames a second; seven
///   seconds in, the sky and the sea have settled. Its clip is the two seconds round that.
/// - `rider-quarter`: the same from off the starboard quarter (`VIEW=9`).
/// - `turnaround`: Hakuro's own viewer (content/hakuro) in plain light: the sheet's pose drawn
///   five times round, front, three-quarter, side, back and the other side.
/// - `run` and `roll`: the same five views with his run and his roll played in place (`MOVE=5`,
///   `MOVE=7`), at 60 frames a second; each one's clip is its first two seconds.
pub fn scene(name: str) -> Option<Scene> {
    if name == "exchange" {
        return Some(
            Scene {
                name: "exchange",
                program: "content/humanoid",
                sets: Vec::from([set("SHOW", "28")]),
                width: 1600,
                height: 900,
                fps: 30.0,
                clip_first: 96,
                clip_last: 312,
                look: Crop { x0: 100, y0: 0, x1: 1500, y1: 900 },
            },
        )
    }
    if name == "played" {
        // (The lab's fight as it's played, `SHOW=12`: its own script steps in at 1.2 s and
        // throws the cross at 1.62 s. At a game's 60 frames a second, for a look at full rate.)
        return Some(
            Scene {
                name: "played",
                program: "content/humanoid",
                sets: Vec::from([set("SHOW", "12")]),
                width: 1600,
                height: 900,
                fps: 60.0,
                clip_first: 84,
                clip_last: 156,
                look: Crop { x0: 400, y0: 50, x1: 1200, y1: 850 },
            },
        )
    }
    if name == "turnaround-large" {
        // (The turnaround three times as large each way: a hand at a hip is 60 pixels across
        // in the turnaround, and a shot of it wants it as a close camera would have it.)
        return Some(
            Scene {
                name: "turnaround-large",
                program: "content/hakuro",
                sets: Vec::from([set("MOVE", "0")]),
                width: 4800,
                height: 2700,
                fps: 60.0,
                clip_first: 0,
                clip_last: 0,
            },
        )
    }
    if name == "turnaround" || name == "run" || name == "roll" {
        let (scene, mv) = if name == "turnaround" { ("turnaround", "0") } else if name == "run" {
            ("run", "5")
        } else {
            ("roll", "7")
        }
        return Some(
            Scene {
                name: scene,
                program: "content/hakuro",
                sets: Vec::from([set("MOVE", mv)]),
                width: 1600,
                height: 900,
                fps: 60.0,
                clip_first: if name == "turnaround" { 0 } else { 1 },
                clip_last: if name == "turnaround" { 0 } else { 120 },
            },
        )
    }
    if name == "rider" || name == "rider-quarter" {
        return Some(
            Scene {
                name: if name == "rider" { "rider" } else { "rider-quarter" },
                program: "scenes/opening",
                sets: Vec::from([set("VIEW", if name == "rider" { "8" } else { "9" })]),
                width: 1600,
                height: 900,
                fps: 60.0,
                clip_first: 360,
                clip_last: 480,
            },
        )
    }
    None
}

/// The lists' names.
pub const LISTS: [Text; 6] = ["arms", "rider", "body", "hands", "strike", "played"]

/// The frames from `first` to `last`, every `every`th.
pub fn every(first: u32, last: u32, every: u32) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    var f = first
    while f <= last {
        out.push(f)
        f += max(every, 1)
    }
    out
}

/// The list of shots named `name`, if there is one.
/// - `arms`: the exchange's six moments the charted arms' first three rounds were judged on (the
///   guard, the step, the cross's wind-up, its impact frame, its follow-through and the
///   recovery), each a still of the fighters' arms, and the cross as a strip of frames.
/// - `rider`: the opening's traveller aboard his skiff, close and from off the quarter, at two
///   moments of the swell each.
/// - `body`: the whole of him. In plain light, from his viewer: his turnaround's front, side
///   and back, two moments of his run from the side and one from three-quarters, and his roll
///   upside down and coming up. And in the combat lab's ink, head to foot: the guard, the
///   follow-through and the recovery.
pub fn list(name: str) -> Option<Vec<Shot>> {
    if name == "arms" {
        let near = Crop { x0: 560, y0: 130, x1: 1160, y1: 560 }
        let mid = Crop { x0: 380, y0: 60, x1: 1200, y1: 700 }
        return Some(
            Vec::from(
                [
                    Shot {
                        name: "guard",
                        scene: "exchange",
                        frames: Vec::from([99]),
                        crop: near,
                        up: 2,
                        about: "both fighters in their guards",
                    },
                    Shot {
                        name: "step",
                        scene: "exchange",
                        frames: Vec::from([135]),
                        crop: near,
                        up: 2,
                        about: "the step in",
                    },
                    Shot {
                        name: "windup",
                        scene: "exchange",
                        frames: Vec::from([198]),
                        crop: mid,
                        about: "the cross drawn back",
                    },
                    Shot {
                        name: "impact",
                        scene: "exchange",
                        frames: Vec::from([204]),
                        crop: mid,
                        about: "the cross landing",
                    },
                    Shot {
                        name: "follow",
                        scene: "exchange",
                        frames: Vec::from([210]),
                        crop: Crop { x0: 200, y0: 0, x1: 1600, y1: 800 },
                        about: "the follow-through",
                    },
                    Shot {
                        name: "recover",
                        scene: "exchange",
                        frames: Vec::from([216]),
                        crop: Crop { x0: 380, y0: 0, x1: 1500, y1: 900 },
                        about: "the recovery",
                    },
                    Shot {
                        name: "cross",
                        scene: "exchange",
                        frames: every(first: 186, last: 216, every: 6),
                        crop: Crop { x0: 200, y0: 0, x1: 1600, y1: 800 },
                        down: 2,
                        about: "the whole cross, a frame in six",
                    },
                ],
            ),
        )
    }
    if name == "strike" {
        // The cross's fastest drawings, one by one: going in, the contact, and held on the face.
        let mid = Crop { x0: 380, y0: 60, x1: 1200, y1: 700 }
        let drawing = |name: Text, frame: u32, about: Text| Shot {
            name,
            scene: "exchange",
            frames: Vec::from([frame]),
            crop: mid,
            about,
        }
        return Some(
            Vec::from(
                [
                    drawing("going-in", 202, "the cross going in"),
                    drawing("contact", 203, "the contact drawing"),
                    drawing("landed", 204, "the cross landed"),
                    drawing("held", 206, "the cross held on the face"),
                ],
            ),
        )
    }
    if name == "played" {
        // The played cross's beats, one by one, and the whole of it: thrown at 1.62 s (frame
        // 98 at 60 a second), landing 0.40 s on (its contact's drawing is up by frame 123).
        let whole = Crop { x0: 0, y0: 0, x1: 1600, y1: 900 }
        let drawing = |name: Text, frame: u32, about: Text| Shot {
            name,
            scene: "played",
            frames: Vec::from([frame]),
            crop: whole,
            down: 2,
            about,
        }
        return Some(
            Vec::from(
                [
                    drawing("load", 108, "the cross loaded, before it's thrown"),
                    drawing("going-in", 120, "the cross going in"),
                    drawing("contact", 123, "the cross as it lands"),
                    drawing("held", 127, "the cross held on its contact"),
                    drawing("home", 138, "the fist on its way home"),
                    Shot {
                        name: "cross",
                        scene: "played",
                        frames: every(first: 100, last: 148, every: 4),
                        crop: whole,
                        down: 4,
                        about: "the whole cross, a frame in four",
                    },
                ],
            ),
        )
    }
    if name == "hands" {
        // His hands close: his fists through the exchange, and his open hands standing.
        let close = |name: Text, scene: Text, frame: u32, crop: Crop, up: u32, about: Text| Shot {
            name,
            scene,
            frames: Vec::from([frame]),
            crop,
            up,
            about,
        }
        return Some(
            Vec::from(
                [
                    close(
                        "guard-fists",
                        "exchange",
                        99,
                        Crop { x0: 560, y0: 170, x1: 980, y1: 400 },
                        3,
                        "both fighters' fists in their guards",
                    ),
                    close(
                        "impact-fists",
                        "exchange",
                        204,
                        Crop { x0: 450, y0: 120, x1: 1150, y1: 520 },
                        2,
                        "the cross landing, and the fists round it",
                    ),
                    close(
                        "follow-fists",
                        "exchange",
                        210,
                        Crop { x0: 200, y0: 0, x1: 1600, y1: 800 },
                        1,
                        "the follow-through",
                    ),
                    close(
                        "recover-fists",
                        "exchange",
                        216,
                        Crop { x0: 380, y0: 0, x1: 1500, y1: 900 },
                        1,
                        "the recovery",
                    ),
                    close(
                        "open-hand-front",
                        "turnaround-large",
                        30,
                        Crop { x0: 500, y0: 1140, x1: 1040, y1: 1540 },
                        2,
                        "his open hand at his hip, from the front",
                    ),
                    close(
                        "open-hand-quarter",
                        "turnaround-large",
                        30,
                        Crop { x0: 1360, y0: 1140, x1: 1900, y1: 1540 },
                        2,
                        "his open hand at his hip, from three-quarters",
                    ),
                    close(
                        "open-hand-side",
                        "turnaround-large",
                        30,
                        Crop { x0: 2200, y0: 1140, x1: 2740, y1: 1540 },
                        2,
                        "his open hand at his hip, from the side",
                    ),
                ],
            ),
        )
    }
    if name == "body" {
        let still = |name: Text, scene: Text, frame: u32, crop: Crop, up: u32, down: u32, about: Text| Shot {
            name,
            scene,
            frames: Vec::from([frame]),
            crop,
            up,
            down,
            about,
        }
        return Some(
            Vec::from(
                [
                    still(
                        "turn-front",
                        "turnaround",
                        30,
                        Crop { x0: 30, y0: 130, x1: 330, y1: 740 },
                        2,
                        1,
                        "standing, from the front",
                    ),
                    still(
                        "turn-side",
                        "turnaround",
                        30,
                        Crop { x0: 655, y0: 130, x1: 955, y1: 740 },
                        2,
                        1,
                        "standing, from the side",
                    ),
                    still(
                        "turn-back",
                        "turnaround",
                        30,
                        Crop { x0: 980, y0: 130, x1: 1280, y1: 740 },
                        2,
                        1,
                        "standing, from the back",
                    ),
                    still(
                        "run-side",
                        "run",
                        20,
                        Crop { x0: 620, y0: 130, x1: 1040, y1: 740 },
                        2,
                        1,
                        "running, from the side",
                    ),
                    still(
                        "run-side-later",
                        "run",
                        40,
                        Crop { x0: 620, y0: 130, x1: 1040, y1: 740 },
                        2,
                        1,
                        "running, a third of a second on",
                    ),
                    still(
                        "run-quarter",
                        "run",
                        20,
                        Crop { x0: 330, y0: 130, x1: 660, y1: 740 },
                        2,
                        1,
                        "running, from three-quarters",
                    ),
                    still(
                        "roll-over",
                        "roll",
                        40,
                        Crop { x0: 300, y0: 400, x1: 1000, y1: 880 },
                        2,
                        1,
                        "the roll, upside down, from two sides",
                    ),
                    still(
                        "roll-up",
                        "roll",
                        60,
                        Crop { x0: 0, y0: 250, x1: 920, y1: 740 },
                        3,
                        2,
                        "coming up out of the roll, from three sides",
                    ),
                    still(
                        "guard-whole",
                        "exchange",
                        99,
                        Crop { x0: 250, y0: 60, x1: 1350, y1: 900 },
                        1,
                        1,
                        "both fighters in their guards, head to foot",
                    ),
                    still(
                        "follow-whole",
                        "exchange",
                        210,
                        Crop { x0: 100, y0: 0, x1: 1600, y1: 900 },
                        1,
                        1,
                        "the follow-through, head to foot",
                    ),
                    still(
                        "recover-whole",
                        "exchange",
                        216,
                        Crop { x0: 250, y0: 0, x1: 1500, y1: 900 },
                        1,
                        1,
                        "the recovery, head to foot",
                    ),
                ],
            ),
        )
    }
    if name == "rider" {
        let close = Crop { x0: 620, y0: 90, x1: 1120, y1: 560 }
        let quarter = Crop { x0: 780, y0: 100, x1: 1180, y1: 520 }
        return Some(
            Vec::from(
                [
                    Shot {
                        name: "aboard",
                        scene: "rider",
                        frames: Vec::from([420]),
                        crop: close,
                        up: 2,
                        about: "the traveller aboard, a hand to the boom",
                    },
                    Shot {
                        name: "aboard-later",
                        scene: "rider",
                        frames: Vec::from([480]),
                        crop: close,
                        up: 2,
                        about: "the same a second on, the swell passed under him",
                    },
                    Shot {
                        name: "quarter",
                        scene: "rider-quarter",
                        frames: Vec::from([420]),
                        crop: quarter,
                        up: 2,
                        about: "the traveller from off the skiff's quarter",
                    },
                    Shot {
                        name: "quarter-later",
                        scene: "rider-quarter",
                        frames: Vec::from([480]),
                        crop: quarter,
                        up: 2,
                        about: "the same a second on",
                    },
                ],
            ),
        )
    }
    None
}

pub const USAGE: Text = "usage: wrela tool judge -- <out-dir> [--against <revision>] [--base-set NAME=VALUE ...] [--new-set NAME=VALUE ...] [--shots <list>] [--only <shot> ...] [--critics N] [--seed N] [--what <words>] [--clips]\n       wrela tool judge -- <out-dir> --tally"

/// What a run does: where it writes (a root path); the revision the base is built from (none:
/// the workspace as it is); the constants the base and the new are each built with, on top of
/// their scenes'; the list of shots, and the shots of it to keep (none named: all); how many
/// critics get pairs, and the shuffles' seed; what the only difference between the two is, as
/// the brief tells the critics; whether clips are made; and whether it tallies votes instead of
/// rendering.
pub struct Options: Clone {
    pub out: String,
    pub against: String = String::new(),
    pub base_sets: Vec<Set> = Vec::new(),
    pub new_sets: Vec<Set> = Vec::new(),
    pub list: String,
    pub only: Vec<String> = Vec::new(),
    pub critics: u32 = 10,
    pub seed: u32 = 1,
    pub what: String,
    pub clips: bool = false,
    pub tally: bool = false,
}

/// The options the command line gives, or what's wrong with it.
pub fn parse_args(given: [String]) -> Result<Options, String> {
    var o = Options {
        out: String::new(),
        list: String::from(LISTS[0]),
        what: String::from("how the fighters are drawn"),
    }
    var out: Option<String> = None
    var k = 0
    while k < given.len() {
        let a = given[k].as_str()
        let next = if k + 1 < given.len() { given[k + 1].clone() } else { String::new() }
        if a == "--against" {
            if next.is_empty() {
                return Err(String::from("--against takes a revision, as origin/main"))
            }
            o.against = take next
            k += 1
        } else if a == "--base-set" || a == "--new-set" {
            let Some(s) = set_of(next.as_str()) else {
                return Err(String::from(f"{a} takes NAME=VALUE"))
            }
            if a == "--base-set" {
                o.base_sets.push(take s)
            } else {
                o.new_sets.push(take s)
            }
            k += 1
        } else if a == "--shots" {
            if list(next.as_str()).is_none() {
                return Err(
                    String::from(
                        f"no list of shots {next}: the lists are {LISTS[0]}, {LISTS[1]} and {LISTS[2]}",
                    ),
                )
            }
            o.list = take next
            k += 1
        } else if a == "--only" {
            if next.is_empty() {
                return Err(String::from("--only takes a shot's name"))
            }
            o.only.push(take next)
            k += 1
        } else if a == "--critics" {
            let Some(n) = next.as_str().parse_u32() else {
                return Err(String::from("--critics takes how many critics get pairs"))
            }
            if n == 0 || n > 64 {
                return Err(String::from("--critics takes 1 to 64"))
            }
            o.critics = n
            k += 1
        } else if a == "--seed" {
            let Some(n) = next.as_str().parse_u32() else {
                return Err(String::from("--seed takes a number"))
            }
            o.seed = n
            k += 1
        } else if a == "--what" {
            if next.is_empty() {
                return Err(String::from("--what takes what differs between the two, in words"))
            }
            o.what = take next
            k += 1
        } else if a == "--clips" {
            o.clips = true
        } else if a == "--tally" {
            o.tally = true
        } else if out.is_none() {
            let Some(path) = rooted(WS, a) else {
                return Err(String::from(f"{a} isn't a directory in the workspace"))
            }
            out = Some(take path)
        } else {
            return Err(String::from(USAGE))
        }
        k += 1
    }
    let Some(path) = take out else { return Err(String::from(USAGE)) }
    o.out = take path
    let Some(all) = list(o.list.as_str()) else { panic("the list was checked") }
    for name in o.only {
        var found = false
        for s in all {
            if name.as_str() == s.name {
                found = true
            }
        }
        if !found {
            return Err(String::from(f"no shot {name} in the list {o.list}"))
        }
    }
    Ok(o)
}

/// The shots a run renders: its list's, or those of it `--only` names, in the list's order.
pub fn chosen(o: Options) -> Vec<Shot> {
    let Some(all) = list(o.list.as_str()) else { panic("the list was checked") }
    if o.only.is_empty() {
        return all
    }
    var out: Vec<Shot> = Vec::new()
    for s in all {
        for name in o.only {
            if name.as_str() == s.name {
                out.push(s.clone())
                break
            }
        }
    }
    out
}
