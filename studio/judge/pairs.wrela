// The judging tool's pairs: a shot's frames laid out as one image, which of a pair is shown as A
// and which as B, the key that says so, the critics' brief, and their votes tallied. What is
// pure of the tool, so its tests need no build.

use audio_tool::sheet::Image
use shots::{Crop, Shot}

/// The gap between a sheet's frames, and between a pair laid side by side, in pixels.
pub const GAP: u32 = 6

/// The scale of a label's 5×7 dots, and where it sits in its frame.
pub const LABEL_SCALE: u32 = 2
pub const LABEL_AT: u32 = 6

/// `c` of a screen `width` wide (RGBA8, rows top to bottom), as RGBA8: clipped to the screen.
pub fn cropped(screen: [u8], width: u32, c: Crop) -> Vec<u8> {
    let height = screen.len() / (4 * max(width, 1))
    let x1 = min(c.x1, width)
    let y1 = min(c.y1, height)
    var out: Vec<u8> = Vec::with_capacity((x1 - min(c.x0, x1)) * (y1 - min(c.y0, y1)) * 4)
    var y = min(c.y0, y1)
    while y < y1 {
        var i = 4 * (y * width + min(c.x0, x1))
        let end = 4 * (y * width + x1)
        while i < end {
            out.push(screen[i])
            i += 1
        }
        y += 1
    }
    out
}

/// How wide and how high crop `c` of a screen `width` × `height` is.
pub fn size_of(c: Crop, width: u32, height: u32) -> (u32, u32) {
    let x1 = min(c.x1, width)
    let y1 = min(c.y1, height)
    (x1 - min(c.x0, x1), y1 - min(c.y0, y1))
}

/// A label's box: `s` in white on a half-dark box at (`x`, `y`) of `img`.
pub fn labelled(img: mut Image, x: u32, y: u32, s: str) {
    let bw = s.len() * 6 * LABEL_SCALE + LABEL_SCALE
    let bh = 7 * LABEL_SCALE + 2 * LABEL_SCALE
    for yy in y..min(y + bh, img.h) {
        for xx in x..min(x + bw, img.w) {
            let i = 3 * (yy * img.w + xx)
            for c in 0..3 {
                img.px[i + c] = img.px[i + c] / 3
            }
        }
    }
    img.text(x + LABEL_SCALE, y + LABEL_SCALE, s, LABEL_SCALE, vec3u(255, 255, 255))
}

/// The longest side an image a critic reads may have: a reader shrinks a larger one, and its
/// detail goes.
pub const MOST: u32 = 1568

/// `px` (`w` × `h`, RGBA8) drawn into `img` with its top left at (`x0`, `y0`).
fn drawn(img: mut Image, px: [u8], w: u32, h: u32, x0: u32, y0: u32) {
    for y in 0..h {
        var from = 4 * (y * w)
        var to = 3 * ((y0 + y) * img.w + x0)
        for _ in 0..w {
            img.px[to] = px[from]
            img.px[to + 1] = px[from + 1]
            img.px[to + 2] = px[from + 2]
            from += 4
            to += 3
        }
    }
}

/// How many rows of a strip's pairs (each `h` high) a page holds.
pub fn rows_a_page(h: u32) -> u32 {
    max((MOST + GAP) / (h + GAP), 1)
}

/// A shot's pair as the images a critic reads, both sides in each, named `first` and `second`
/// at their top lefts. `a` and `b` are the sides' frames (each `w` × `h`, RGBA8), in order.
/// - A still (one frame): one image, the two side by side or one over the other, whichever
///   keeps them larger within `MOST` each way.
/// - A strip (several): a row a frame, `first`'s on the left and `second`'s on the right, the
///   frame's number on the left one; as many pages as its rows need (`rows_a_page`).
pub fn pages(
    a: [Vec<u8>],
    b: [Vec<u8>],
    w: u32,
    h: u32,
    numbers: [u32],
    first: str,
    second: str,
) -> Vec<Image> {
    var out: Vec<Image> = Vec::new()
    let n = min(a.len(), b.len())
    if n == 1 {
        // (How much each way of laying them out is shrunk to fit, in thousandths.)
        let beside = min(min(1000 * MOST / (2 * w + GAP), 1000 * MOST / h), 1000)
        let over = min(min(1000 * MOST / w, 1000 * MOST / (2 * h + GAP)), 1000)
        if beside >= over {
            var img = Image::new(2 * w + GAP, h)
            drawn(mut img, a[0], w, h, x0: 0, y0: 0)
            drawn(mut img, b[0], w, h, x0: w + GAP, y0: 0)
            labelled(mut img, LABEL_AT, LABEL_AT, first)
            labelled(mut img, w + GAP + LABEL_AT, LABEL_AT, second)
            out.push(take img)
        } else {
            var img = Image::new(w, 2 * h + GAP)
            drawn(mut img, a[0], w, h, x0: 0, y0: 0)
            drawn(mut img, b[0], w, h, x0: 0, y0: h + GAP)
            labelled(mut img, LABEL_AT, LABEL_AT, first)
            labelled(mut img, LABEL_AT, h + GAP + LABEL_AT, second)
            out.push(take img)
        }
        return out
    }
    let rows = rows_a_page(h)
    var at = 0
    while at < n {
        let here = min(rows, n - at)
        var img = Image::new(2 * w + GAP, here * h + (here - 1) * GAP)
        for r in 0..here {
            let y0 = r * (h + GAP)
            drawn(mut img, a[at + r], w, h, x0: 0, y0: y0)
            drawn(mut img, b[at + r], w, h, x0: w + GAP, y0: y0)
            if at + r < numbers.len() {
                let label = String::from(f"{numbers[at + r]}")
                labelled(mut img, LABEL_AT, y0 + h - LABEL_AT - 9 * LABEL_SCALE, label.as_str())
            }
        }
        labelled(mut img, LABEL_AT, LABEL_AT, first)
        labelled(mut img, w + GAP + LABEL_AT, LABEL_AT, second)
        out.push(take img)
        at += here
    }
    out
}

/// The file a shot's page `page` (of `pages`, from 0) is written as: `<shot>.png`, or with more
/// than one, `<shot>-1.png` on.
pub fn page_name(shot: str, page: u32, pages: u32) -> String {
    if pages <= 1 { String::from(f"{shot}.png") } else { String::from(f"{shot}-{page + 1}.png") }
}

/// Three numbers mixed into one (below 2^32), each bit of it moved by each of theirs: for a
/// draw that neighbouring seeds, critics and shots don't share.
pub fn mixed(a: u32, b: u32, c: u32) -> u64 {
    let m: u64 = 4294967296
    var x = ((u64(a) * 2654435761) % m +
        (u64(b) * 2246822519) % m +
        (u64(c) * 3266489917) % m +
        374761393) %
        m
    x = x ^ (x >> 15)
    x = (x * 2246822519) % m
    x = x ^ (x >> 13)
    x = (x * 3266489917) % m
    x ^ (x >> 16)
}

/// Whether shot `k`'s pair is swapped for critic `critic` (from 1) of a panel of `critics`
/// under `seed`: the new shown as A and the base as B (else the base is A). Each shot is
/// swapped for half its panel, drawn afresh for each shot (the half of an odd panel rounded
/// down), so a critic's lean toward one letter falls on both sides alike: critics shown the
/// same pictures chose B about two times in three, whichever side it was.
pub fn swapped(seed: u32, critics: u32, critic: u32, k: u32) -> bool {
    let mine = mixed(seed, k, critic)
    var before = 0
    for other in 1..critics + 1 {
        let theirs = mixed(seed, k, other)
        if theirs < mine || (theirs == mine && other < critic) {
            before += 1
        }
    }
    before < critics / 2
}

/// The key: a line a shot, `<shot>: A=<side> B=<side>`.
pub fn key_text(names: [Text], swaps: [bool]) -> String {
    var out = String::new()
    for k in 0..names.len() {
        let (a, b) = if swaps[k] { ("new", "base") } else { ("base", "new") }
        out.push_str(f"{names[k]}: A={a} B={b}\n")
    }
    out
}

/// A key's line read: the shot's name, and whether its A is the new.
pub struct Keyed: Clone {
    pub shot: String,
    pub new_is_a: bool,
}

/// What a key (`key_text`) says.
pub fn key_of(text: str) -> Vec<Keyed> {
    var out: Vec<Keyed> = Vec::new()
    for (a, b) in text.split("\n") {
        let line = text.slice(a, b)
        let Some(colon) = line.find(":") else { continue }
        out.push(
            Keyed {
                shot: String::from(line.slice(0, colon).trim()),
                new_is_a: line.find("A=new").is_some(),
            },
        )
    }
    out
}

/// The critics' brief: where the images are, that the letters are shuffled, what the only
/// difference is, each shot with its files (`files`: each shot's, in order) and what it shows,
/// and the one line a shot they answer with.
pub fn brief(shots: [Shot], files: [Vec<String>], what: str, dir: str) -> String {
    var out = String::new()
    out.push_str("# A blind comparison\n\n")
    out.push_str(
        f"Each shot below is an image in `{dir}` that shows the same moment twice, marked A and B at the top left of each. ",
    )
    out.push_str(
        f"The only difference between A and B is {what}. Which letter is which is shuffled shot by shot, so A isn't the same one every time, and neither letter is a before or an after: judge each on what it shows, not on where it sits. Nothing else differs.\n\n",
    )
    out.push_str("The shots:\n\n")
    for k in 0..shots.len() {
        borrow s = shots[k]
        var named = String::new()
        for i in 0..files[k].len() {
            if i > 0 {
                named.push_str(", ")
            }
            named.push_str(f"`{files[k][i]}`")
        }
        let kind = if s.frames.len() > 1 {
            "a strip: a row a frame, A's on the left and B's on the right, the frame's number at the lower left"
        } else {
            "a still"
        }
        out.push_str(f"- `{s.name}` ({named}): {s.about} ({kind}).\n")
    }
    out.push_str(
        "\nJudge A against B in each shot as drawings: which reads better as a believable, appealing figure in this style? Look at silhouettes, joints, where one part meets another, the shapes of light and shade, and the ink lines; and for anything broken, lumpy, pinched, hollow or floating.\n\n",
    )
    out.push_str("Answer with exactly one line a shot, in this form:\n\n")
    out.push_str(
        "`<shot>: <A better | B better | no visible difference> (confidence low/medium/high) - <one sentence naming what you saw, and where on the image>`\n\n",
    )
    out.push_str(
        "Then two or three sentences overall: which flaws recurred, and in which letter of which shot. \"No visible difference\" is a fine answer where it's true. Don't guess which is which.\n",
    )
    out
}

/// `s` with its ASCII capitals lowered.
pub fn lowered(s: str) -> String {
    var bytes: Vec<u8> = Vec::with_capacity(s.len())
    for i in 0..s.len() {
        let b = s.byte(i)
        bytes.push(if b >= 65 && b <= 90 { b + 32 } else { b })
    }
    String::from_utf8(take bytes).unwrap_or(String::from(s))
}

/// What a vote picks.
pub enum Pick: Copy + Eq {
    A,
    B,
    Same,
}

/// A critic's vote on a shot: what it picks, how sure (0 unsaid, 1 low, 2 medium, 3 high), and
/// the line as written.
pub struct Vote: Clone {
    pub shot: String,
    pub pick: Pick,
    pub sure: u32,
    pub line: String,
}

/// The votes in a critic's answer: for each of `names`, the first line that starts with the
/// shot's name (after any `*`, `` ` ``, `-` or space) and a colon, and says `A better`, `B
/// better` or `no visible difference`.
pub fn votes_of(text: str, names: [String]) -> Vec<Vote> {
    var out: Vec<Vote> = Vec::new()
    for name in names {
        for (a, b) in text.split("\n") {
            let line = text.slice(a, b)
            let low = lowered(line)
            var at = 0
            while at < low.len() {
                let c = low.as_str().byte(at)
                if c == 42 || c == 96 || c == 45 || c == 32 {
                    at += 1
                } else {
                    break
                }
            }
            let rest = low.as_str().slice(at, low.len())
            if !rest.starts_with(name.as_str()) {
                continue
            }
            let after = rest.slice(name.len(), rest.len())
            let Some(colon) = after.find(":") else { continue }
            // (Only marks between the name and its colon: `guard`**: ...)
            if colon > 3 {
                continue
            }
            let said = after.slice(colon + 1, after.len())
            // The verdict is what comes before the note (` - `): the note's own words (a
            // highlight, "no visible difference at this size") aren't the pick.
            let end = match said.find(" - ") {
                Some(dash) => dash,
                None => said.len(),
            }
            let verdict = said.slice(0, end)
            let pick = if verdict.find("no visible difference").is_some() {
                Pick::Same
            } else {
                let at_a = verdict.find("a better")
                let at_b = verdict.find("b better")
                match (at_a, at_b) {
                    (Some(x), Some(y)) => if x < y { Pick::A } else { Pick::B },
                    (Some(_), None) => Pick::A,
                    (None, Some(_)) => Pick::B,
                    (None, None) => continue,
                }
            }
            let sure = if verdict.find("high").is_some() {
                3
            } else if verdict.find("medium").is_some() {
                2
            } else if verdict.find("low").is_some() {
                1
            } else {
                0
            }
            out.push(Vote { shot: name.clone(), pick, sure, line: String::from(line.trim()) })
            break
        }
    }
    out
}

/// A shot's votes counted: for the new, for the base, for neither, and the votes for the new by
/// how sure (low, medium, high).
pub struct Count: Copy {
    pub new: u32 = 0,
    pub base: u32 = 0,
    pub same: u32 = 0,
    pub sure: [u32; 4] = [0; 4],
}

/// The votes for `shot` among `votes`, counted under the key (`new_is_a`: its A is the new).
pub fn counted(votes: [Vote], shot: str, new_is_a: bool) -> Count {
    var c = Count {}
    for v in votes {
        if v.shot.as_str() != shot {
            continue
        }
        if v.pick == Pick::Same {
            c.same += 1
        } else if (v.pick == Pick::A) == new_is_a {
            c.new += 1
            c.sure[min(v.sure, 3)] += 1
        } else {
            c.base += 1
        }
    }
    c
}

/// The chance a fair coin tossed `n` times lands heads `k` times or more: what a tally of `k`
/// of `n` votes for one side would be if the critics couldn't tell the two apart.
pub fn by_chance(k: u32, n: u32) -> f64 {
    if k == 0 {
        return 1.0
    }
    // Each term is C(n, i) / 2^n, from i = 0.
    var term = 1.0
    for _ in 0..n {
        term *= 0.5
    }
    var sum = 0.0
    for i in 0..n + 1 {
        if i >= k {
            sum += term
        }
        term = term * f64(n - i) / f64(i + 1)
    }
    min(sum, 1.0)
}

/// `x` (0 to 1) in thousandths, as `0.031`.
pub fn thousandths(x: f64) -> String {
    let t = min(u32(x * 1000.0 + 0.5), 1000)
    if t >= 1000 {
        return String::from("1.000")
    }
    String::from(f"0.{t / 100}{(t / 10) % 10}{t % 10}")
}

/// The tally as a page: a row a shot (the votes for the new, for the base, for neither, how
/// sure the new's were, and the chance a coin would give the new as many of the votes that
/// chose a side), their sum, and under it each critic's line with its letter read through that
/// critic's key (`keys`: each critic's, in `critics`' order; the shots are the first's).
pub fn tally(keys: [Vec<Keyed>], critics: [String], votes: [Vec<Vote>]) -> String {
    var out = String::new()
    out.push_str("# Tally\n\n")
    if keys.is_empty() {
        out.push_str("No votes.\n")
        return out
    }
    borrow shots = keys[0]
    out.push_str(f"{critics.len()} critics, {shots.len()} shots.\n\n")
    out.push_str(
        "| Shot | For the new | For the base | No difference | The new's votes: low, medium, high | By chance |\n",
    )
    out.push_str("|---|---|---|---|---|---|\n")
    var all = Count {}
    for s in 0..shots.len() {
        var c = Count {}
        for i in 0..critics.len() {
            let one = counted(votes[i], shots[s].shot.as_str(), keys[i][s].new_is_a)
            c.new += one.new
            c.base += one.base
            c.same += one.same
            for j in 0..4 {
                c.sure[j] += one.sure[j]
            }
        }
        let chance = thousandths(by_chance(c.new, c.new + c.base))
        out.push_str(
            f"| {shots[s].shot} | {c.new} | {c.base} | {c.same} | {c.sure[1]}, {c.sure[2]}, {c.sure[3]} | {chance} |\n",
        )
        all.new += c.new
        all.base += c.base
        all.same += c.same
        for j in 0..4 {
            all.sure[j] += c.sure[j]
        }
    }
    let chance = thousandths(by_chance(all.new, all.new + all.base))
    out.push_str(
        f"| all | {all.new} | {all.base} | {all.same} | {all.sure[1]}, {all.sure[2]}, {all.sure[3]} | {chance} |\n",
    )
    out.push_str(f"\n{all.new} of {all.new + all.base + all.same} votes for the new.\n")
    // The letters themselves: a lean toward one is the critics', not the pictures'.
    var a = 0
    var b = 0
    for vs in votes {
        for v in vs {
            if v.pick == Pick::A {
                a += 1
            } else if v.pick == Pick::B {
                b += 1
            }
        }
    }
    out.push_str(
        f"\nA was chosen {a} times and B {b} times. Each shot is shown each way round to half its panel, so a lean toward one letter falls on both sides alike.\n",
    )
    for s in 0..shots.len() {
        out.push_str(f"\n## {shots[s].shot}\n\n")
        for i in 0..critics.len() {
            let side = |new_is: bool| -> Text { if new_is { "the new" } else { "the base" } }
            for v in votes[i] {
                if v.shot.as_str() == shots[s].shot.as_str() {
                    let a = side(keys[i][s].new_is_a)
                    let b = side(!keys[i][s].new_is_a)
                    out.push_str(f"- {critics[i]} (A {a}, B {b}): {v.line}\n")
                }
            }
        }
    }
    out
}
