// The round tool (`wrela tool round`): a play round of the floor (#55 AC5), games/last-green
// played in headless Chrome stable at 1080p, paced at 60 Hz as in play, through the play
// harness's keys, then its lookbook rendered again. Everything goes to target/rounds/round-<n>/.
//
// ```text
// wrela tool round -- <n> [--quick [--every <k>] | --minutes 30|60] [--no-lookbook]
//     [--frames <n>] [--workers <n>]
// ```
//
// `--quick` (about two minutes, the edit loop's round): a travel to every fourth site (each
// region's), at each a run of 2 s and a look round, then six lookbook shots held, the screen
// saved at each (`snaps/`); no lookbook render after. `--every 1` travels to every site (every
// region: about five minutes), as the last round does.
//
// The floor must be built (`wrela build games/last-green`). The build is served on a free port
// (`std::tool::serve`) and played in Chrome (`std::tool::browser`, test mode), its jobs on
// `--workers` threads (8 unless given). The round plays, as a player would through the harness's
// taps: the floor's walk (P: from the gate, along the critical path, through every region and
// the water, past each lookbook place: 25 minutes at a run); then each lookbook shot held 15 s
// (L, its number, Enter; Escape); with `--minutes 60`, then the egg's road in the wildwood
// (travel, Y) for 10 minutes, and the floor's walk again. It saves:
//
// - `ticks.log`, the round's replay (each tick's records and state hash: `wrela-host --replay`);
// - `log.txt`, what the floor printed (the harness's report every 2 s, late tiles, the playable
//   frame), and `console.log`;
// - `summary.json` and what it prints: the frames' intervals (a frame later than 33 ms after the
//   last is a hitch), each hitch with where the player was, the tiles late, the regions crossed
//   and the sites passed, the deepest water stood in (summary.wrela);
// - `lookbook/`, each shot's still (the lookbook tool's stills), to set beside the last round's.
//
// `--frames` cuts the round short (to try the tool).

use lookbook_tool::main::lookbook
use lookbook_tool::shots::{BUILD, LOOKBOOK, PROGRAM, names_in, shown_path}
use lookbook_tool::shots::Options as Stills
use std::io::print
use std::tool::{ToolError, args}
use std::tool::files
use summary::{FPS, SNAP, quick_script, script, sites_in, summarize}
use toolkit::page::run_page
use toolkit::whole::{copy_file, read_file, write_file}

/// The floor's map, whose sites the round travels to.
const MAP: Text = "ws/games/last-green/map.wrela"

/// What the page saves that the round keeps.
const KEPT: [Text; 6] = [
    "ticks.log",
    "log.txt",
    "console.log",
    "frames.json",
    "memory.json",
    "load.json",
]

pub const USAGE: Text = "usage: wrela tool round -- <n> [--quick [--every <k>] | --minutes 30|60] [--no-lookbook] [--frames <n>] [--workers <n>]"

/// What a round does: its number, its minutes, whether it's quick and how many sites apart it
/// travels then, whether its lookbook is rendered after, the frames it's cut to (0: all), and
/// the page's threads.
pub struct Options: Clone {
    pub n: u32,
    pub minutes: u32,
    pub quick: bool,
    pub every: u32,
    pub lookbook: bool,
    pub frames: u32,
    pub workers: u32,
}

/// The options the command line gives, or `None` for a usage error.
pub fn parse_args(given: [String]) -> Option<Options> {
    if given.is_empty() {
        return None
    }
    var o = Options {
        n: given[0].as_str().parse_u32()?,
        minutes: 30,
        quick: false,
        every: 4,
        lookbook: true,
        frames: 0,
        workers: 8,
    }
    var k = 1
    while k < given.len() {
        let a = given[k].as_str()
        if a == "--quick" {
            o.quick = true
        } else if a == "--no-lookbook" {
            o.lookbook = false
        } else if k + 1 < given.len() {
            let v = given[k + 1].as_str().parse_u32()?
            if a == "--minutes" {
                o.minutes = v
            } else if a == "--every" && v > 0 {
                o.every = v
            } else if a == "--frames" {
                o.frames = v
            } else if a == "--workers" && v > 0 {
                o.workers = v
            } else {
                return None
            }
            k += 1
        } else {
            return None
        }
        k += 1
    }
    Some(o)
}

/// The text of the file at `path` (a root path), or why it can't be read.
fn text_of(path: str) -> Result<String, ToolError> {
    match String::from_utf8(read_file(path, path)?) {
        Some(t) => Ok(t),
        None => Err(ToolError::new(f"{path} isn't UTF-8")),
    }
}

/// Plays the round `o` says: its exit status.
pub fn round(o: Options) -> u32 {
    let (lookbook_source, map) = match (text_of(LOOKBOOK), text_of(MAP)) {
        (Ok(l), Ok(m)) => (take l, take m),
        (Err(e), _) => {
            print(f"round: {e.message()}")
            return 1
        },
        (_, Err(e)) => {
            print(f"round: {e.message()}")
            return 1
        },
    }
    let shots = names_in(lookbook_source.as_str()).len()
    let sites = sites_in(map.as_str())
    let out = String::from(f"ws/target/rounds/round-{o.n}")
    let _ = files::remove_all(out.as_str()).wait()
    if let Err(e) = files::make_dirs(out.as_str()).wait() {
        print(f"round: {e.message()}")
        return 1
    }
    let whole = script(o.minutes, shots, sites)
    var keys = whole.0.clone()
    var frames = whole.1
    var snaps: Vec<u32> = Vec::new()
    if o.quick {
        let (k, f, s) = quick_script(o.every, sites)
        keys = take k
        frames = f
        snaps = take s
    }
    if o.frames > 0 {
        frames = o.frames
    }
    let script_at = String::from(f"{BUILD}/round-keys.json")
    if let Err(e) = files::write(
        script_at.as_str(),
        String::from(keys.as_json()).as_bytes(),
    ).wait() {
        print(f"round: {e.message()}")
        return 1
    }
    let timeout = f64(frames / FPS * 2 + 600)
    let snap = if o.quick { String::from(f"&snap={SNAP}&snapfrom={SNAP}") } else { String::new() }
    let hash = String::from(
        f"#test&frames={frames}&width=1920&height=1080&fps={FPS}&workers={o.workers}&paced=1&nohash=1&ticklog=1&inflight=2{snap}&input=round-keys.json",
    )
    print(f"round {o.n}: {frames} frames ({f64(frames) / f64(FPS) / 60.0:.1} min) in Chrome")
    let played = run_page(BUILD, hash.as_str(), width: 1920, height: 1080, timeout: timeout)
    let _ = files::remove(script_at.as_str()).wait()
    // What the page saved, each file if it's there; the saved screens, numbered.
    var copies: Vec<(String, String)> = Vec::new()
    for name in KEPT {
        copies.push((String::from(f"{BUILD}/results/{name}"), String::from(f"{out}/{name}")))
    }
    if !snaps.is_empty() {
        let _ = files::make_dirs(f"{out}/snaps").wait()
        for k in 0..snaps.len() {
            copies.push(
                (
                    String::from(f"{BUILD}/results/snap-{snaps[k]}.png"),
                    String::from(f"{out}/snaps/{k:02}-frame-{snaps[k]}.png"),
                ),
            )
        }
    }
    for (from, to) in copies {
        let _ = copy_file(from.as_str(), to.as_str())
    }
    let shown = shown_path(out.as_str())
    var status: u32 = 0
    if let Err(e) = played {
        print(e.message())
        print(f"the round's run failed (see {shown}/console.log)")
        status = 1
    }
    let (frames_json, log) = match (text_of(f"{out}/frames.json"), text_of(f"{out}/log.txt")) {
        (Ok(f), Ok(l)) => (take f, take l),
        _ => {
            print("the round produced no frames.json or log.txt")
            return max(status, 1)
        },
    }
    var lines: Vec<String> = Vec::new()
    for (a, b) in log.as_str().lines() {
        lines.push(String::from(log.as_str().slice(a, b)))
    }
    let Some(doc) = std::json::parse(frames_json.as_str()) else {
        print("the round's frames.json isn't JSON")
        return max(status, 1)
    }
    let Some(summary) = summarize(doc, lines, snaps) else {
        print("the round's frames.json has no began_ms or printed_in")
        return max(status, 1)
    }
    let summary_at = String::from(f"{out}/summary.json")
    if let Err(e) = write_file(
        summary_at.as_str(),
        Vec::from([Vec::from(summary.json.as_bytes())]),
    ) {
        print(f"round: {e.message()}")
        return 1
    }
    for l in summary.lines {
        print(l.as_str())
    }
    if o.lookbook && !o.quick {
        let stills = Stills {
            program: String::from(PROGRAM),
            out: String::from(f"{out}/lookbook"),
            stills: true,
            capture: false,
            quality: false,
            controls: false,
            view: 0,
            width: 1920,
            height: 1080,
            jobs: 1,
            workers: o.workers,
            picks: Vec::new(),
        }
        if let Err(e) = lookbook(stills) {
            print(f"the lookbook failed: {e.message()}")
            status = max(status, 1)
        }
    }
    status
}

pub fn tool() -> u32 {
    let Some(o) = parse_args(args()) else {
        print(USAGE)
        return 2
    }
    round(o)
}
