// A style fitted to a reference (`wrela tool fit -- --style ...`, docs/plan-world-class-3.md §D8):
// the statistics a still is scored by, and the search. A reference set's statistics (`Stats`:
// its luma's quintiles, its edges' share, its palette's size, its mean chroma) are its hand's tone
// and economy, not a picture to trace; a single reference is scored by its colour difference and
// structure (`against`). The search is CMA-ES (Hansen's tutorial, docs/citations.md) over the
// style's fittable constants scaled to [0, 1], from a fixed seed.

use engine::noise::rand

/// The side every image is brought within before its statistics: a painting's resolution and a
/// still's differ, and an edge's share and a palette's size depend on it.
pub const SIDE: u32 = 480

/// An image's statistics: its luma's quintiles (0.2, 0.4, 0.6, 0.8), the share of its pixels whose
/// luma steps by more than 0.1 to the next pixel across or down, its palette's size (log2 of the
/// colours, quantized to 32 levels a channel, that hold at least 1/4096 of its pixels), and its
/// mean chroma (CIE Lab's C*, over 100).
pub struct Stats: Copy {
    pub quintiles: [f32; 4],
    pub edges: f32,
    pub palette: f32,
    pub chroma: f32,
}

/// The statistics as one list, in `Stats`' order, and how little of each counts as apart (the
/// floor under a set's spread: a set alike in one makes no wall of it).
pub fn values(s: Stats) -> [f32; 7] {
    [s.quintiles[0], s.quintiles[1], s.quintiles[2], s.quintiles[3], s.edges, s.palette, s.chroma]
}

pub const FLOORS: [f32; 7] = [0.02, 0.02, 0.02, 0.02, 0.01, 0.25, 0.01]

/// An sRGB byte's linear value.
fn linear(c: u8) -> f32 {
    let v = f32(c) / 255.0
    if v <= 0.04045 { v / 12.92 } else { pow((v + 0.055) / 1.055, 2.4) }
}

fn lab_f(t: f32) -> f32 {
    if t > 0.008856 { pow(t, 1.0 / 3.0) } else { 7.787 * t + 16.0 / 116.0 }
}

/// An sRGB pixel's CIE Lab (D65).
pub fn lab(r: u8, g: u8, b: u8) -> (f32, f32, f32) {
    let (lr, lg, lb) = (linear(r), linear(g), linear(b))
    let x = (0.4124 * lr + 0.3576 * lg + 0.1805 * lb) / 0.95047
    let y = 0.2126 * lr + 0.7152 * lg + 0.0722 * lb
    let z = (0.0193 * lr + 0.1192 * lg + 0.9505 * lb) / 1.08883
    let (fx, fy, fz) = (lab_f(x), lab_f(y), lab_f(z))
    (116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz))
}

/// A pixel's luma (Rec. 709's weights on its sRGB values, 0 to 1).
fn luma_of(px: [u8], i: u32) -> f32 {
    (0.2126 * f32(px[4 * i]) + 0.7152 * f32(px[4 * i + 1]) + 0.0722 * f32(px[4 * i + 2])) / 255.0
}

/// The statistics of an RGBA8 image `w` wide (rows top to bottom).
pub fn stats(px: [u8], w: u32) -> Stats {
    let n = px.len() / 4
    let h = n / max(w, 1)
    var lumas: Vec<f32> = Vec::new()
    var chroma = 0.0
    var bins: Vec<u32> = Vec::new()
    for _ in 0..32768 {
        bins.push(0)
    }
    for i in 0..n {
        lumas.push(luma_of(px, i))
        let (_, a, b) = lab(px[4 * i], px[4 * i + 1], px[4 * i + 2])
        chroma += sqrt(a * a + b * b) / 100.0
        let q = (u32(px[4 * i]) / 8) * 1024 + (u32(px[4 * i + 1]) / 8) * 32 + u32(px[4 * i + 2]) / 8
        bins[q] += 1
    }
    var edges = 0
    for y in 0..h {
        for x in 0..w {
            let i = y * w + x
            let l = lumas[i]
            let across = if x + 1 < w { abs(lumas[i + 1] - l) } else { 0.0 }
            let down = if y + 1 < h { abs(lumas[i + w] - l) } else { 0.0 }
            if max(across, down) > 0.1 {
                edges += 1
            }
        }
    }
    var colours = 0
    for c in bins {
        if c * 4096 >= n {
            colours += 1
        }
    }
    lumas.sort_by(|a: f32, b: f32| a < b)
    let at = |q: f32| lumas[min(u32(q * f32(n)), n - 1)]
    Stats {
        quintiles: [at(0.2), at(0.4), at(0.6), at(0.8)],
        edges: f32(edges) / f32(max(n, 1)),
        palette: log2(f32(max(colours, 1))),
        chroma: chroma / f32(max(n, 1)),
    }
}

/// A set's statistics: each one's mean and spread (its standard deviation, at least its floor).
pub struct Target: Clone {
    pub mean: [f32; 7],
    pub spread: [f32; 7],
}

pub fn target_of(set: [Stats]) -> Target {
    var mean = [0.0; 7]
    var spread = [0.0; 7]
    let n = f32(max(set.len(), 1))
    for s in set {
        let v = values(s)
        for k in 0..7 {
            mean[k] += v[k] / n
        }
    }
    for s in set {
        let v = values(s)
        for k in 0..7 {
            spread[k] += (v[k] - mean[k]) * (v[k] - mean[k]) / n
        }
    }
    for k in 0..7 {
        spread[k] = max(sqrt(spread[k]), FLOORS[k])
    }
    Target { mean, spread }
}

/// How far a still's statistics are from a set's: the root mean square of each one's distance
/// from the set's mean, in the set's spreads.
pub fn distance(s: Stats, t: Target) -> f32 {
    let v = values(s)
    var sum = 0.0
    for k in 0..7 {
        let z = (v[k] - t.mean[k]) / t.spread[k]
        sum += z * z
    }
    sqrt(sum / 7.0)
}

/// A still's score against a single reference the same size (RGBA8, `w` wide): the mean colour
/// difference (CIE76 ΔE, over 100) plus 1 less the SSIM of their lumas (8 × 8 windows).
pub fn against(still: [u8], reference: [u8], w: u32) -> f32 {
    let n = still.len() / 4
    var de = 0.0
    for i in 0..n {
        let (l1, a1, b1) = lab(still[4 * i], still[4 * i + 1], still[4 * i + 2])
        let (l2, a2, b2) = lab(reference[4 * i], reference[4 * i + 1], reference[4 * i + 2])
        de += sqrt((l1 - l2) * (l1 - l2) + (a1 - a2) * (a1 - a2) + (b1 - b2) * (b1 - b2))
    }
    de / f32(max(n, 1)) / 100.0 + 1.0 - ssim_of(still, reference, w)
}

/// The mean SSIM of two RGBA8 images' lumas over 8 × 8 windows.
fn ssim_of(a: [u8], b: [u8], w: u32) -> f32 {
    let h = a.len() / 4 / max(w, 1)
    let (c1, c2) = (0.0001, 0.0009)
    var sum = 0.0
    var count = 0
    var y = 0
    while y + 8 <= h {
        var x = 0
        while x + 8 <= w {
            var ma = 0.0
            var mb = 0.0
            for j in 0..8 {
                for i in 0..8 {
                    let k = (y + j) * w + x + i
                    ma += luma_of(a, k) / 64.0
                    mb += luma_of(b, k) / 64.0
                }
            }
            var va = 0.0
            var vb = 0.0
            var cov = 0.0
            for j in 0..8 {
                for i in 0..8 {
                    let k = (y + j) * w + x + i
                    let (da, db) = (luma_of(a, k) - ma, luma_of(b, k) - mb)
                    va += da * da / 63.0
                    vb += db * db / 63.0
                    cov += da * db / 63.0
                }
            }
            sum += (2.0 * ma * mb + c1) *
                (2.0 * cov + c2) /
                ((ma * ma + mb * mb + c1) * (va + vb + c2))
            count += 1
            x += 8
        }
        y += 8
    }
    sum / f32(max(count, 1))
}

/// A CMA-ES search (Hansen's (μ/μ_W, λ) with rank-one and rank-μ updates and cumulative step
/// size) over `n` coordinates in [0, 1]: a candidate outside is brought back to the nearest edge,
/// and updated from where it was brought.
pub struct Cma: Clone {
    pub n: u32,
    pub lambda: u32,
    pub mu: u32,
    pub weights: Vec<f32>,
    pub mueff: f32,
    pub cc: f32,
    pub cs: f32,
    pub c1: f32,
    pub cmu: f32,
    pub damps: f32,
    pub chi: f32,
    pub mean: Vec<f32>,
    pub sigma: f32,
    /// The covariance, row by row, its eigenvectors (`b`, column by column) and the square roots
    /// of its eigenvalues (`d`).
    pub c: Vec<f32>,
    pub b: Vec<f32>,
    pub d: Vec<f32>,
    pub pc: Vec<f32>,
    pub ps: Vec<f32>,
    pub generation: u32,
    pub seed: u32,
    /// The last candidates asked for, each its normal draw (`z`) and its point.
    pub zs: Vec<Vec<f32>>,
    pub xs: Vec<Vec<f32>>,
}

/// A standard normal draw: the `k`th of `seed`'s (Box-Muller).
fn normal(seed: u32, k: u32) -> f32 {
    let u1 = max(f32(rand(seed, 2 * k)), 1.0e-9)
    let u2 = f32(rand(seed, 2 * k + 1))
    sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2)
}

impl Cma {
    /// A search from `start` (each in [0, 1]) with step `sigma`, its draws from `seed`.
    pub fn new(start: [f32], sigma: f32, seed: u32) -> Cma {
        let n = start.len()
        let nf = f32(n)
        let lambda = 4 + u32(floor(3.0 * log(nf)))
        let mu = lambda / 2
        var weights: Vec<f32> = Vec::new()
        var total = 0.0
        for i in 0..mu {
            let w = log(f32(mu) + 0.5) - log(f32(i + 1))
            weights.push(w)
            total += w
        }
        var sq = 0.0
        for i in 0..mu {
            weights[i] = weights[i] / total
            sq += weights[i] * weights[i]
        }
        let mueff = 1.0 / sq
        let cc = (4.0 + mueff / nf) / (nf + 4.0 + 2.0 * mueff / nf)
        let cs = (mueff + 2.0) / (nf + mueff + 5.0)
        let c1 = 2.0 / ((nf + 1.3) * (nf + 1.3) + mueff)
        let cmu = min(
            1.0 - c1,
            2.0 * (mueff - 2.0 + 1.0 / mueff) / ((nf + 2.0) * (nf + 2.0) + mueff),
        )
        let damps = 1.0 + 2.0 * max(0.0, sqrt((mueff - 1.0) / (nf + 1.0)) - 1.0) + cs
        let chi = sqrt(nf) * (1.0 - 1.0 / (4.0 * nf) + 1.0 / (21.0 * nf * nf))
        var c: Vec<f32> = Vec::new()
        var b: Vec<f32> = Vec::new()
        for i in 0..n {
            for j in 0..n {
                c.push(if i == j { 1.0 } else { 0.0 })
                b.push(if i == j { 1.0 } else { 0.0 })
            }
        }
        var d: Vec<f32> = Vec::new()
        var pc: Vec<f32> = Vec::new()
        var ps: Vec<f32> = Vec::new()
        var mean: Vec<f32> = Vec::new()
        for i in 0..n {
            d.push(1.0)
            pc.push(0.0)
            ps.push(0.0)
            mean.push(start[i])
        }
        Cma {
            n,
            lambda,
            mu,
            weights,
            mueff,
            cc,
            cs,
            c1,
            cmu,
            damps,
            chi,
            mean,
            sigma,
            c,
            b,
            d,
            pc,
            ps,
            generation: 0,
            seed,
            zs: Vec::new(),
            xs: Vec::new(),
        }
    }

    /// This generation's `lambda` candidates, each in [0, 1].
    pub fn ask(mut self) -> Vec<Vec<f32>> {
        let n = self.n
        self.zs = Vec::new()
        self.xs = Vec::new()
        for k in 0..self.lambda {
            var z: Vec<f32> = Vec::new()
            for i in 0..n {
                z.push(normal(self.seed + self.generation * 7919, k * n + i))
            }
            var x: Vec<f32> = Vec::new()
            for i in 0..n {
                var s = 0.0
                for j in 0..n {
                    s += self.b[i * n + j] * self.d[j] * z[j]
                }
                x.push(clamp(self.mean[i] + self.sigma * s, 0.0, 1.0))
            }
            self.zs.push(take z)
            self.xs.push(take x)
        }
        self.xs.clone()
    }

    /// The generation's scores, in `ask`'s order (lower is better): the mean, the paths, the
    /// covariance and the step updated.
    pub fn tell(mut self, scores: [f32]) {
        let n = self.n
        var order: Vec<u32> = Vec::new()
        for k in 0..self.lambda {
            order.push(k)
        }
        order.sort_by(|a: u32, b: u32| scores[a] < scores[b])
        let old = self.mean.clone()
        var mean: Vec<f32> = Vec::new()
        for i in 0..n {
            var m = 0.0
            for r in 0..self.mu {
                m += self.weights[r] * self.xs[order[r]][i]
            }
            mean.push(m)
        }
        // The step in the search's own coordinates: C^(-1/2) (mean - old) / sigma.
        var y: Vec<f32> = Vec::new()
        for i in 0..n {
            y.push((mean[i] - old[i]) / self.sigma)
        }
        var bty: Vec<f32> = Vec::new()
        for j in 0..n {
            var s = 0.0
            for i in 0..n {
                s += self.b[i * n + j] * y[i]
            }
            bty.push(s / max(self.d[j], 1.0e-12))
        }
        var len_ps = 0.0
        for i in 0..n {
            var s = 0.0
            for j in 0..n {
                s += self.b[i * n + j] * bty[j]
            }
            self.ps[i] = (1.0 - self.cs) * self.ps[i] +
                sqrt(self.cs * (2.0 - self.cs) * self.mueff) * s
            len_ps += self.ps[i] * self.ps[i]
        }
        len_ps = sqrt(len_ps)
        let g = f32(self.generation + 1)
        let hsig = if len_ps / sqrt(1.0 - pow(1.0 - self.cs, 2.0 * g)) / self.chi <
            1.4 + 2.0 / (f32(n) + 1.0) { 1.0 } else { 0.0 }
        for i in 0..n {
            self.pc[i] = (1.0 - self.cc) * self.pc[i] +
                hsig * sqrt(self.cc * (2.0 - self.cc) * self.mueff) * y[i]
        }
        for i in 0..n {
            for j in 0..n {
                var rank_mu = 0.0
                for r in 0..self.mu {
                    let x = self.xs[order[r]].clone()
                    rank_mu += self.weights[r] *
                        (x[i] - old[i]) *
                        (x[j] - old[j]) /
                        (self.sigma * self.sigma)
                }
                let k = i * n + j
                self.c[k] = (1.0 - self.c1 - self.cmu) * self.c[k] +
                    self.c1 *
                        (self.pc[i] * self.pc[j] +
                            (1.0 - hsig) * self.cc * (2.0 - self.cc) * self.c[k]) +
                    self.cmu * rank_mu
            }
        }
        self.sigma = self.sigma * exp((self.cs / self.damps) * (len_ps / self.chi - 1.0))
        self.sigma = min(self.sigma, 0.5)
        self.mean = take mean
        let (b, d) = eigen(self.c.clone(), n)
        self.b = take b
        self.d = take d
        self.generation += 1
    }
}

/// A symmetric `n` × `n` matrix's eigenvectors (column by column) and the square roots of its
/// eigenvalues (each at least 1e-10), by Jacobi's rotations.
pub fn eigen(m: [f32], n: u32) -> (Vec<f32>, Vec<f32>) {
    var a = Vec::from(m)
    var v: Vec<f32> = Vec::new()
    for i in 0..n {
        for j in 0..n {
            v.push(if i == j { 1.0 } else { 0.0 })
        }
    }
    for _sweep in 0..50 {
        var off = 0.0
        for i in 0..n {
            for j in 0..n {
                if i != j {
                    off += a[i * n + j] * a[i * n + j]
                }
            }
        }
        if off < 1.0e-14 {
            break
        }
        for p in 0..n {
            for q in (p + 1)..n {
                let apq = a[p * n + q]
                if abs(apq) < 1.0e-30 {
                    continue
                }
                let theta = (a[q * n + q] - a[p * n + p]) / (2.0 * apq)
                let t = (if theta >= 0.0 { 1.0 } else {
                    -1.0
                }) / (abs(theta) + sqrt(theta * theta + 1.0))
                let c = 1.0 / sqrt(t * t + 1.0)
                let s = t * c
                for k in 0..n {
                    let (akp, akq) = (a[k * n + p], a[k * n + q])
                    a[k * n + p] = c * akp - s * akq
                    a[k * n + q] = s * akp + c * akq
                }
                for k in 0..n {
                    let (apk, aqk) = (a[p * n + k], a[q * n + k])
                    a[p * n + k] = c * apk - s * aqk
                    a[q * n + k] = s * apk + c * aqk
                }
                for k in 0..n {
                    let (vkp, vkq) = (v[k * n + p], v[k * n + q])
                    v[k * n + p] = c * vkp - s * vkq
                    v[k * n + q] = s * vkp + c * vkq
                }
            }
        }
    }
    var d: Vec<f32> = Vec::new()
    for i in 0..n {
        d.push(sqrt(max(a[i * n + i], 1.0e-20)))
    }
    (v, d)
}
