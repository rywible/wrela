// The fit's style panel (wrela.toml says what for): 256 × 144, six balls in two rows (the ground,
// leaves, bark; stone, grass, water), each lit from the side through the look's `shade` and
// `palette`, its albedo its class's colour from a fifth to twice it across the ball, on black.

use engine::frame::full
use engine::light::{Light, Lit}
use engine::style
use engine::style::Style
use engine::substance
use std::gpu::{FragCoord, begin_screen_pass, draw}
use styles::cel::CelFitting

/// The look the panel draws in: a fitting one (`engine::style::Knob`).
pub type LOOK = CelFitting

/// The screen's size.
pub const WIDTH: u32 = 256
pub const HEIGHT: u32 = 144

/// The light: from the side, a little toward the eye and down.
const SUN: vec3 = vec3(0.86, 0.35, 0.37)

/// The balls' classes and colours, row by row.
const CLASSES: [u32; 6] = [
    style::GROUND,
    style::LEAVES,
    style::BARK,
    style::STONE,
    style::GRASS,
    style::WATER,
]
const COLOURS: [vec3; 6] = [
    vec3(0.22, 0.18, 0.11),
    vec3(0.10, 0.20, 0.05),
    vec3(0.14, 0.11, 0.08),
    vec3(0.25, 0.24, 0.22),
    vec3(0.16, 0.26, 0.06),
    vec3(0.06, 0.12, 0.14),
]

pub struct Panel {
    fit: [vec4; 2],
}

pub fn init() -> Panel {
    Panel { fit: [vec4(0.0), vec4(0.0)] }
}

/// The look's candidate constants (`engine::style::Knob`), from the next frame.
pub fn fit(s: mut Panel, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, g: f32, h: f32) {
    s.fit = [vec4(a, b, c, d), vec4(e, f, g, h)]
}

@fragment
fn balls<Y: Style>(pixel: FragCoord, light: Light) -> vec4 {
    let cell = f32(HEIGHT) / 2.0
    let at = pixel.position.xy / cell
    let i = u32(at.x) + 3 * u32(at.y)
    let uv = (fract(at) * 2.0 - vec2(1.0)) * vec2(1.0, -1.0) / 0.9
    let r2 = dot(uv, uv)
    if r2 >= 1.0 || i >= 6 {
        return vec4(0.0, 0.0, 0.0, 1.0)
    }
    let n = normalize(vec3(uv, sqrt(1.0 - r2)))
    let class = CLASSES[i]
    let albedo = Y::palette(light, class, vec4(0.0), COLOURS[i] * mix(0.2, 2.0, 0.5 + 0.5 * uv.x))
    let l = Lit { albedo, n, sun: 1.0, sky: vec3(0.04, 0.05, 0.06), through: albedo * 0.3 }
    let c = Y::shade(light, l, substance::NONE, class, n, vec3(0.0, 0.0, 4.0))
    vec4(pow(c / (vec3(1.0) + c), vec3(1.0 / 2.2)), 1.0)
}

pub fn frame(s: mut Panel, time: f32, width: u32, height: u32) {
    let light = Light {
        sun: SUN,
        exposure: 1.0,
        sun_colour: vec3(2.0),
        eye: 1.0,
        horizon: 0.0,
        fit: s.fit,
    }
    let screen = begin_screen_pass(clear: vec4(0.0))
    draw(screen, full.bind(z: 0.5), balls::<LOOK>.bind(light), vertices: 3)
    screen.present()
}
