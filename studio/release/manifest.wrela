// What the release reads of a package's manifest (`wrela.toml`, language.md §3.6): its name,
// its dependencies (each by a path, or a member of its workspace by name), and, for a workspace's
// manifest, its members. A release ships the font licences of a package and of every package it
// depends on, so it walks these.
//
// The manifest is read as the subset of TOML that manifests are written in: `[section]` headers,
// `key = value` lines, comments, strings, inline tables and arrays, which may run over several
// lines. Anything else on a line is passed over: the compiler checks a manifest, not the release.

/// A dependency: its name, and its package's directory relative to the manifest's, or `None`
/// for the member of the workspace of that name.
pub struct Dependency: Clone {
    pub name: String,
    pub path: Option<String>,
}

/// What a manifest says that the release reads.
pub struct Manifest: Clone {
    pub name: Option<String>,
    pub dependencies: Vec<Dependency>,
    pub members: Option<Vec<String>>,
}

/// The strings of a value, in order: `"a"`, `["a", "b"]`, and an inline table's values.
fn strings(value: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    var i = 0
    while i < value.len() {
        let q = value.byte(i)
        if q == 35 {
            break
        }
        if q != 34 && q != 39 {
            i += 1
            continue
        }
        var s = String::new()
        var k = i + 1
        while k < value.len() && value.byte(k) != q {
            if q == 34 && value.byte(k) == 92 && k + 1 < value.len() {
                k += 1
            }
            k += pages::push_at(mut s, value, k)
        }
        out.push(take s)
        i = k + 1
    }
    out
}

/// The value of key `key` in an inline table `{ a = 1, b = "x" }`, as written.
fn field(table: str, key: str) -> Option<String> {
    let inner = table.trim()
    if !inner.starts_with("{") {
        return None
    }
    for (a, b) in inner.slice(1, inner.len()).split(",") {
        let part = inner.slice(1, inner.len()).slice(a, b)
        let Some(eq) = part.find("=") else { continue }
        if part.slice(0, eq).trim() == key {
            let v = part.slice(eq + 1, part.len()).trim()
            if v.ends_with("}") {
                return Some(String::from(v.slice(0, v.len() - 1).trim()))
            }
            return Some(String::from(v))
        }
    }
    None
}

/// The text of a manifest, read.
pub fn parse(text: str) -> Manifest {
    var m = Manifest { name: None, dependencies: Vec::new(), members: None }
    var section = String::new()
    let lines = text.lines()
    var i = 0
    while i < lines.len() {
        let line = text.slice(lines[i].0, lines[i].1).trim()
        i += 1
        if line.is_empty() || line.starts_with("#") {
            continue
        }
        if line.starts_with("[") {
            let end = match line.find("]") {
                Some(k) => k,
                None => line.len(),
            }
            section = String::from(line.slice(1, end).trim())
            continue
        }
        let Some(eq) = line.find("=") else { continue }
        var key = String::from(line.slice(0, eq).trim())
        let k = key.as_str()
        if k.len() >= 2 && (k.starts_with("\"") || k.starts_with("'")) {
            key = String::from(k.slice(1, k.len() - 1))
        }
        var value = String::from(line.slice(eq + 1, line.len()).trim())
        // An array runs on to its `]`.
        if value.as_str().starts_with("[") {
            while value.as_str().find("]").is_none() && i < lines.len() {
                value.push_str(" ")
                value.push_str(text.slice(lines[i].0, lines[i].1).trim())
                i += 1
            }
        }
        let s = section.as_str()
        if s == "package" && key.as_str() == "name" {
            let names = strings(value.as_str())
            if names.len() == 1 {
                m.name = Some(names[0].clone())
            }
        } else if s == "dependencies" {
            if let Some(p) = field(value.as_str(), "path") {
                let paths = strings(p.as_str())
                if paths.len() == 1 {
                    m.dependencies.push(
                        Dependency { name: key.clone(), path: Some(paths[0].clone()) },
                    )
                }
            } else if let Some(w) = field(value.as_str(), "workspace") {
                if w.as_str() == "true" {
                    m.dependencies.push(Dependency { name: key.clone(), path: None })
                }
            }
        } else if s == "workspace" && key.as_str() == "members" {
            m.members = Some(strings(value.as_str()))
        }
    }
    if m.members.is_none() && has_section(text, "workspace") {
        m.members = Some(Vec::new())
    }
    m
}

/// Whether the manifest has a `[name]` section.
fn has_section(text: str, name: str) -> bool {
    for (a, b) in text.lines() {
        let line = text.slice(a, b).trim()
        if line.starts_with("[") && line.find("]").is_some() {
            let Some(end) = line.find("]") else { continue }
            if line.slice(1, end).trim() == name {
                return true
            }
        }
    }
    false
}

/// A member's name when its manifest names none: its directory's, with `-` read as `_`.
pub fn default_name(dir: str) -> String {
    var at = 0
    for k in 0..dir.len() {
        if dir.byte(k) == 47 {
            at = k + 1
        }
    }
    var out = String::new()
    var k = at
    while k < dir.len() {
        if dir.byte(k) == 45 {
            out.push_byte(95)
            k += 1
        } else {
            k += pages::push_at(mut out, dir, k)
        }
    }
    out
}

/// `rel` (a path from directory `dir`, with `/` between parts) joined to `dir`, a root path:
/// `.` parts dropped, `..` parts taking the part before; `None` if it leaves the root (the first
/// part of `dir`).
pub fn joined(dir: str, rel: str) -> Option<String> {
    var parts: Vec<String> = Vec::new()
    for (a, b) in dir.split("/") {
        parts.push(String::from(dir.slice(a, b)))
    }
    for (a, b) in rel.split("/") {
        let p = rel.slice(a, b)
        if p.is_empty() || p == "." {
            continue
        }
        if p == ".." {
            if parts.len() <= 1 {
                return None
            }
            let _ = parts.pop()
        } else {
            parts.push(String::from(p))
        }
    }
    var out = String::new()
    for k in 0..parts.len() {
        if k > 0 {
            out.push_str("/")
        }
        out.push_str(parts[k].as_str())
    }
    Some(out)
}

/// The directory a root path is in, or `None` for a root.
pub fn parent(path: str) -> Option<String> {
    var at: Option<u32> = None
    for k in 0..path.len() {
        if path.byte(k) == 47 {
            at = Some(k)
        }
    }
    match at {
        Some(k) => Some(String::from(path.slice(0, k))),
        None => None,
    }
}
