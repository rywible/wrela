// The released console and its games, and the reference docs: each a Cloudflare Worker serving
// static assets on its own domain, and the console's server a Worker of its own on the console's
// API paths. `wrela tool release` builds a release of them all, and the
// deploy tool (studio/deploy) deploys it. The console reads the catalog that a release writes
// for it (catalog.tsv), not this value: what it shows is what the release built.
//
// The catalog is a value of the release tool's own package, because the tool is its only
// reader: the console and the games build without it, and it names packages and Workers, which
// are a release's business, not a program's.

/// A build of a game: its name (its directory in the game's Worker), its package, and the
/// constants of the package's `main.wrela` it's built with, each `NAME=VALUE` as `wrela build
/// --set` takes it (none for the package as it is).
pub struct Build: Clone {
    pub name: Text,
    pub dir: Text,
    pub set: Vec<Text> = Vec::new(),
}

/// A game: its id (its storage namespace and its prefetch list), its title, its Worker and
/// domain, the build the console opens (`session`), its builds, and its cover, a PNG that Wrela
/// rendered; and the build that plays itself (`attract`, empty for none), which the console's
/// home shows behind its text once it has rested on the game a few seconds. What the console's home shows of it while it's chosen, each left empty for none:
/// its hero, a PNG that Wrela rendered, full-bleed behind the home's text, which stands on its
/// left; its title art, a PNG with alpha, in place of its title; its tagline, a line that sells
/// it; and its theme, a melody the home plays softly, as text: its tempo in quarter notes a
/// minute on the first line, then a voice a line in engine::score's notation.
pub struct Game: Clone {
    pub id: Text,
    pub title: Text,
    pub worker: Text,
    pub domain: Text,
    pub session: Text,
    pub builds: Vec<Build>,
    pub attract: Text,
    pub cover: Text,
    pub hero: Text,
    pub logo: Text,
    pub tagline: Text,
    pub theme: Text,
}

/// The console: its package, Worker, domain, and the one-line description its page has; the
/// Worker its server runs in (`api`), on the console's domain's API paths, as a route of its
/// Cloudflare zone (`zone`, the domain or one it's under); and the Worker the server ran in
/// before (`api_from`, empty for none), whose Durable Objects `api`'s first deploy takes over.
pub struct Console: Clone {
    pub dir: Text,
    pub worker: Text,
    pub domain: Text,
    pub description: Text,
    pub api: Text,
    pub zone: Text,
    pub api_from: Text,
}

/// The reference docs: a Wrela program (`package`) beside the docs that `wrela doc --export`
/// writes of std and `packages`.
pub struct Docs: Clone {
    pub dir: Text,
    pub worker: Text,
    pub domain: Text,
    pub description: Text,
    pub packages: Vec<Text>,
}

/// What a release holds.
pub struct Catalog: Clone {
    pub console: Console,
    pub docs: Docs,
    pub games: Vec<Game>,
}

/// The production release, wrela.dev: the capybara game alone, the first flagship game. Leapling
/// and The Last Green were beta tests and stay in the workspace, out of the release (Ryan,
/// 2026-10-30).
pub const CATALOG: Catalog = Catalog {
    console: Console {
        dir: "console",
        worker: "wrela-console",
        domain: "wrela.dev",
        description: "Games that run in your browser, built with the Wrela language and engine.",
        api: "wrela-console-api",
        zone: "wrela.dev",
        // The server ran in the console's Worker until 2026-10-31, when its first deploy here
        // took its class over (rywible/wrela#348); there's nothing left to take.
        api_from: "",
    },
    docs: Docs {
        dir: "docsite",
        worker: "wrela-docs",
        domain: "docs.wrela.dev",
        description: "The Wrela reference. It covers the language, its standard library, the engine, the ui and platform packages, and the studio's tool.",
        packages: Vec::from(["engine", "land", "ui", "platform", "studio/tool"]),
    },
    games: Vec::from(
        [
            Game {
                id: "capybara",
                title: "Capybara",
                worker: "wrela-capybara",
                domain: "capybara.wrela.dev",
                session: "session",
                builds: Vec::from(
                    [
                        Build { name: "session", dir: "games/capybara/session" },
                        Build { name: "capybara", dir: "games/capybara" },
                        // The game playing its searched runs by itself, with no sound and no
                        // HUD (games/capybara/attract.wrela). It's a build of its own because
                        // toolchain 0.16.0's browser host opens no program at an address with
                        // a fragment (docs/toolchain-gaps.md).
                        Build {
                            name: "attract",
                            dir: "games/capybara",
                            set: Vec::from(["ATTRACT=true"]),
                        },
                    ],
                ),
                attract: "attract",
                cover: "games/capybara/cover.png",
                hero: "games/capybara/hero.png",
                logo: "",
                tagline: "Run, swim and slide through nine habitats at the zoo.",
                theme: "games/capybara/theme.txt",
            },
        ],
    ),
}

/// The longest tagline, in bytes: the console's catalog takes no longer.
pub const TAGLINE: u32 = 200

/// The names a game's build can't take: the paths the release puts beside its builds.
pub const RESERVED_BUILD_NAMES: [Text; 7] = [
    "releases",
    "_headers",
    "_redirects",
    "index.html",
    "LICENSE",
    "deploys.json",
    "files.json",
]

/// The project's own hosts beside the console's domain, which no game may take.
pub const RESERVED_HOSTS: [Text; 4] = ["www", "docs", "api", "studio"]

fn is_lower_or_digit(b: u8) -> bool {
    (b >= 97 && b <= 122) || (b >= 48 && b <= 57)
}

/// Whether `value` can be a part of a path, a header or a catalog line: 1 to 64 lowercase
/// letters, digits and `-`, not starting with `-`.
pub fn is_component(value: str) -> bool {
    if value.is_empty() || value.len() > 64 || !is_lower_or_digit(value.byte(0)) {
        return false
    }
    for i in 1..value.len() {
        let b = value.byte(i)
        if !is_lower_or_digit(b) && b != 45 {
            return false
        }
    }
    true
}

fn component(value: str) -> Result<(), String> {
    if is_component(value) {
        Ok(())
    } else {
        Err(String::from(f"invalid release component: '{value}'"))
    }
}

/// Whether `value` sets a constant as `wrela build --set` takes it: `NAME=VALUE`, the name a
/// constant's (capitals, digits and `_`, not starting with a digit), the value one line with no
/// tab.
pub fn is_setting(value: str) -> bool {
    let Some(eq) = value.find("=") else { return false }
    if eq == 0 || eq + 1 == value.len() || value.find("\t").is_some() || !one_line(value) {
        return false
    }
    for i in 0..eq {
        let b = value.byte(i)
        let capital = b >= 65 && b <= 90
        let digit = b >= 48 && b <= 57
        if !(capital || b == 95 || (digit && i > 0)) {
            return false
        }
    }
    true
}

/// The origin of a custom domain (`https://` and the domain), or why it isn't one: lowercase
/// letters, digits, `.` and `-`, starting and ending with a letter or digit, with a `.` and no
/// `..`.
pub fn origin(domain: str) -> Result<String, String> {
    let bad = Err(String::from("invalid custom domain"))
    if domain.is_empty() || !is_lower_or_digit(domain.byte(0)) {
        return bad
    }
    if !is_lower_or_digit(domain.byte(domain.len() - 1)) {
        return bad
    }
    for i in 0..domain.len() {
        let b = domain.byte(i)
        if !is_lower_or_digit(b) && b != 45 && b != 46 {
            return bad
        }
    }
    if domain.find("..").is_some() || domain.find(".").is_none() {
        return bad
    }
    Ok(String::from(f"https://{domain}"))
}

/// A domain's origin, for a domain `check` has passed.
pub fn origin_of(domain: str) -> String {
    match origin(domain) {
        Ok(o) => o,
        Err(e) => panic(e.as_str()),
    }
}

fn one_line(text: str) -> bool {
    !text.is_empty() && text.find("\r").is_none() && text.find("\n").is_none()
}

fn has(names: [String], name: str) -> bool {
    for n in names {
        if n.as_str() == name {
            return true
        }
    }
    false
}

/// The first part of a domain: its host's own name.
fn first_label(domain: str) -> borrow str {
    match domain.find(".") {
        Some(k) => domain.slice(0, k),
        None => domain,
    }
}

/// Why `c` can't be released, if it can't: a part that isn't a component, a Worker or a domain
/// two projects share, a console outside its zone, a game on one of the project's own hosts, a
/// title or description that isn't one line, a tagline that isn't one line or is longer than the
/// console shows, a session or an attract build that isn't one of its game's builds (or an
/// attract build that is its session), a build with a reserved name, or a build's constant that
/// isn't `NAME=VALUE`. Whether its packages and covers are there is the tool's to check (`paths`).
pub fn check(c: Catalog) -> Result<(), String> {
    var workers: Vec<String> = Vec::new()
    var domains: Vec<String> = Vec::new()
    component(c.console.worker)?
    workers.push(String::from(c.console.worker))
    component(c.console.api)?
    if has(workers, c.console.api) {
        return Err(String::from("the console's server needs a Worker of its own"))
    }
    workers.push(String::from(c.console.api))
    if !c.console.api_from.is_empty() {
        component(c.console.api_from)?
        if c.console.api_from == c.console.api {
            return Err(String::from("the server's Worker can't take over its own classes"))
        }
    }
    domains.push(String::from(c.console.domain))
    origin(c.console.domain)?
    origin(c.console.zone)?
    let d = c.console.domain
    let z = c.console.zone
    let under = d.len() > z.len() && d.ends_with(z) && d.byte(d.len() - z.len() - 1) == 46
    if d != z && !under {
        return Err(String::from(f"{d} isn't in the zone {z}"))
    }
    if !one_line(c.console.description) {
        return Err(String::from("the console needs a one-line description"))
    }
    var seen: Vec<String> = Vec::new()
    for game in c.games {
        component(game.id)?
        if has(seen, game.id) {
            return Err(String::from("duplicate game id"))
        }
        seen.push(String::from(game.id))
        component(game.worker)?
        if has(workers, game.worker) || has(domains, game.domain) {
            return Err(String::from(f"{game.id} shares a worker or a domain"))
        }
        workers.push(String::from(game.worker))
        domains.push(String::from(game.domain))
        origin(game.domain)?
        for host in RESERVED_HOSTS {
            if first_label(game.domain) == host {
                return Err(String::from(f"{game.domain} is one of the project's own hosts"))
            }
        }
        component(game.session)?
        if game.title.is_empty() || game.title.find("\t").is_some() || !one_line(game.title) {
            return Err(String::from("invalid catalog title"))
        }
        let tagline = game.tagline
        if !tagline.is_empty() &&
            (tagline.find("\t").is_some() || !one_line(tagline) || tagline.len() > TAGLINE) {
            return Err(String::from(f"invalid tagline for {game.id}"))
        }
        var session = false
        for b in game.builds {
            if b.name == game.session {
                session = true
            }
        }
        if !session {
            return Err(String::from("the session build is missing"))
        }
        if !game.attract.is_empty() {
            var attract = false
            for b in game.builds {
                if b.name == game.attract {
                    attract = true
                }
            }
            if !attract || game.attract == game.session {
                return Err(String::from(f"the attract build of {game.id} isn't one of its own"))
            }
        }
        var names: Vec<String> = Vec::new()
        for b in game.builds {
            for reserved in RESERVED_BUILD_NAMES {
                if b.name == reserved {
                    return Err(String::from(f"reserved build name: '{b.name}'"))
                }
            }
            component(b.name)?
            if has(names, b.name) {
                return Err(String::from(f"{game.id} has two builds named {b.name}"))
            }
            names.push(String::from(b.name))
            for named in b.set {
                if !is_setting(named) {
                    return Err(String::from(f"invalid constant for {b.name}: '{named}'"))
                }
            }
        }
    }
    if seen.is_empty() {
        return Err(String::from("the release needs at least one game"))
    }
    component(c.docs.worker)?
    if has(workers, c.docs.worker) || has(domains, c.docs.domain) {
        return Err(String::from("the docs share a worker or a domain"))
    }
    origin(c.docs.domain)?
    if !one_line(c.docs.description) {
        return Err(String::from("the docs need a one-line description"))
    }
    Ok(())
}

/// What must be in the workspace for `c` to build, each a path from the workspace's directory
/// and what to say if it isn't there: each package's manifest, and each game's cover, and its
/// hero, title art and theme if it names them.
pub fn paths(c: Catalog) -> Vec<(String, String)> {
    var out: Vec<(String, String)> = Vec::new()
    let p = c.console.dir
    out.push(
        (
            String::from(f"{p}/wrela.toml"),
            String::from("the console package is not inside the repository"),
        ),
    )
    for game in c.games {
        out.push(
            (String::from(game.cover), String::from(f"missing Wrela-rendered cover for {game.id}")),
        )
        for (named, what) in [
            (game.hero, "hero"),
            (game.logo, "title art"),
            (game.theme, "theme"),
        ] {
            if !named.is_empty() {
                out.push((String::from(named), String::from(f"missing {what} for {game.id}")))
            }
        }
        for b in game.builds {
            out.push(
                (
                    String::from(f"{b.dir}/wrela.toml"),
                    String::from("a build package is not inside the repository"),
                ),
            )
        }
    }
    let d = c.docs.dir
    out.push(
        (
            String::from(f"{d}/wrela.toml"),
            String::from(f"a docs package is not inside the repository: {d}"),
        ),
    )
    for q in c.docs.packages {
        out.push(
            (
                String::from(f"{q}/wrela.toml"),
                String::from(f"a docs package is not inside the repository: {q}"),
            ),
        )
    }
    out
}
