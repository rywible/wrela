// What a release serves beside its builds: each Worker's headers and redirects, its favicon and
// 404 page, and its Wrangler configuration, the console's server's Worker (its script and configuration), the console's
// catalog, prefetch lists and card, the docs page's head and text, and the storage namespace each
// bootstrap names.

use catalog::{Catalog, Console, Docs, Game, attract_build, attract_fragment, origin_of}
use json::{Json, compact, indented, member, member_of, member_of_obj, text}
use pages::{Page, escape, group_of, groups, stem}

/// The Workers runtime each release's Workers run on.
pub const COMPATIBILITY_DATE: Text = "2026-10-12"

/// The docs' page in each scheme (docsite/theme.wrela `DARK.page`, `LIGHT.page`).
pub const PAGE_DARK: Text = "#09090B"
pub const PAGE_LIGHT: Text = "#FFFFFF"

/// `s` with each `from` replaced by `to`, left to right.
pub fn replace_all(s: str, from: str, to: str) -> String {
    var out = String::new()
    var i = 0
    var start = 0
    let n = from.len()
    while n > 0 && i + n <= s.len() {
        var hit = true
        for k in 0..n {
            if s.byte(i + k) != from.byte(k) {
                hit = false
                break
            }
        }
        if hit {
            out.push_str(s.slice(start, i))
            out.push_str(to)
            i += n
            start = i
        } else {
            i += 1
            while i < s.len() && s.byte(i) >= 128 && s.byte(i) < 192 {
                i += 1
            }
        }
    }
    out.push_str(s.slice(start, s.len()))
    out
}

/// A Worker's headers. Its assets are public; the origin-owned OPFS is never uploaded or served.
/// `parent` is the console's origin; `children` are the origins its page may frame and fetch
/// from; an `embedded` game's files are readable by the console.
pub fn headers(parent: str, children: [String], embedded: bool) -> String {
    let ancestors = if embedded { String::from(parent) } else { String::from("'none'") }
    var frame_src = String::new()
    var connect_src = String::from("'self'")
    var policy = String::from("cross-origin-isolated=(self")
    for k in 0..children.len() {
        if k > 0 {
            frame_src.push_str(" ")
        }
        frame_src.push_str(children[k].as_str())
        connect_src.push_str(" ")
        connect_src.push_str(children[k].as_str())
        policy.push_str(f" \"{children[k].as_str()}\"")
    }
    if children.is_empty() {
        frame_src.push_str("'none'")
    }
    policy.push_str(")")
    // The console fetches a game's files ahead (its prefetch list) as readable CORS requests
    // with credentials, as the game's own page fetches them, so the browser's cache keeps them.
    var shared = String::new()
    if embedded {
        shared.push_str(
            f"\n  Access-Control-Allow-Origin: {parent}\n  Access-Control-Allow-Credentials: true",
        )
    }
    var h = String::from("/*\n  Cross-Origin-Opener-Policy: same-origin\n")
    h.push_str("  Cross-Origin-Embedder-Policy: require-corp\n")
    h.push_str(f"  Cross-Origin-Resource-Policy: cross-origin{shared.as_str()}\n")
    h.push_str(f"  Permissions-Policy: {policy.as_str()}\n")
    h.push_str("  X-Content-Type-Options: nosniff\n  Referrer-Policy: origin\n")
    h.push_str(
        f"  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src {connect_src.as_str()}; img-src 'self' blob:; frame-src {frame_src.as_str()}; frame-ancestors {ancestors.as_str()}; object-src 'none'; base-uri 'self'\n",
    )
    h.push_str("/*.wasm\n  Content-Type: application/wasm\n")
    h.push_str("/*.wgsl\n  Content-Type: text/plain; charset=utf-8\n")
    h
}

/// The docs Worker's headers: the program's, and its Markdown and text readable by anyone, as
/// what they are.
pub fn docs_headers(home: str) -> String {
    let none: [String; 0] = []
    let raw = "\n  Access-Control-Allow-Origin: *"
    var h = headers(home, none, embedded: false)
    h.push_str(f"/*.md\n  Content-Type: text/markdown; charset=utf-8{raw}\n")
    h.push_str(f"/*.txt\n  Content-Type: text/plain; charset=utf-8{raw}\n")
    h.push_str(f"/*.json{raw}\n")
    h
}

/// What every Worker's headers end with: a release's files, and the payloads and runtimes at
/// their content addresses (addresses.wrela), are kept; its entry points never.
pub const CACHE_RULES: Text = "/releases/*\n  Cache-Control: public, max-age=31536000, immutable\n/b/*\n  Cache-Control: public, max-age=31536000, immutable\n/r/*\n  Cache-Control: public, max-age=31536000, immutable\n/\n  Cache-Control: no-cache\n/index.html\n  Cache-Control: no-cache\n/deploys.json\n  Cache-Control: no-cache\n"

/// A top entry of the docs' Worker before its release is put in `releases/`: its name, whether
/// it's a directory, and for a directory whether a Markdown file is somewhere inside it.
pub struct Top: Clone {
    pub name: String,
    pub dir: bool,
    pub markdown: bool,
}

/// Stable addresses for the docs' raw files (`/llms.txt`, `/std/io.md`): each leads to this
/// release's copy, so an agent's link outlives the release. `tops` are sorted by name.
pub fn docs_redirects(tops: [Top], release: str) -> String {
    var out = String::new()
    for t in tops {
        let name = t.name.as_str()
        if t.dir && t.markdown {
            out.push_str(f"/{name}/* /releases/{release}/{name}/:splat 302\n")
        } else if !t.dir &&
            (suffix(name) == ".txt" || suffix(name) == ".json") &&
            name != "manifest.json" &&
            name != "addresses.json" &&
            name != "files.json" {
            out.push_str(f"/{name} /releases/{release}/{name} 302\n")
        }
    }
    if out.is_empty() {
        out.push_str("\n")
    }
    out
}

/// A file name's suffix: from its last `.`, if that is neither its first byte nor its last.
pub fn suffix(name: str) -> borrow str {
    var k = name.len()
    while k > 0 {
        k -= 1
        if name.byte(k) == 46 {
            if k == 0 || k + 1 == name.len() {
                return name.slice(from: 0, to: 0)
            }
            return name.slice(k, name.len())
        }
    }
    name.slice(from: 0, to: 0)
}

/// The console page's description, and the card a link to it shows where it is shared: its
/// first game's cover, `cover`.
pub fn card(console: Console, release: str, cover: str) -> String {
    let home = origin_of(console.domain)
    let h = home.as_str()
    let t = escape(console.description, quote: true)
    let text = t.as_str()
    var out = String::new()
    out.push_str(f"\n<meta name=\"description\" content=\"{text}\">")
    out.push_str("\n<meta property=\"og:type\" content=\"website\">")
    out.push_str("\n<meta property=\"og:site_name\" content=\"wrela\">")
    out.push_str("\n<meta property=\"og:title\" content=\"wrela\">")
    out.push_str(f"\n<meta property=\"og:description\" content=\"{text}\">")
    out.push_str(f"\n<meta property=\"og:url\" content=\"{h}/\">")
    out.push_str(f"\n<meta property=\"og:image\" content=\"{h}/releases/{release}/{cover}\">")
    out.push_str("\n<meta name=\"twitter:card\" content=\"summary_large_image\">")
    out
}

/// A line of Markdown as HTML: escaped, with its `code` as code.
pub fn code_of(markdown: str) -> String {
    let e = escape(markdown, quote: false)
    let s = e.as_str()
    var out = String::new()
    var code = false
    var from = 0
    for i in 0..s.len() + 1 {
        if i == s.len() || s.byte(i) == 96 {
            if code {
                out.push_str("<code>")
                out.push_str(s.slice(from, i))
                out.push_str("</code>")
            } else {
                out.push_str(s.slice(from, i))
            }
            code = !code
            from = i + 1
        }
    }
    out
}

/// The docs page's description, its Markdown for agents, and its own text (`main#wrela-text`):
/// the docs' pages, each a link to its HTML page, for whoever doesn't run the program, such as
/// an agent that reads the page as HTML or a browser without WebGPU. An address's fragment never
/// reaches the server, so the text says how an address names a page. The browser host shows it
/// when the program can't run and removes it once the program draws. `has` says whether the
/// docs have a file at a path (`llms.txt`, `std/llms-full.txt`).
pub fn docs_page(docs: Docs, pages: [Page], has: [String]) -> (String, String) {
    let t = escape(docs.description, quote: true)
    let text = t.as_str()
    let home_owned = origin_of(docs.domain)
    let home = home_owned.as_str()
    var head = String::new()
    head.push_str(f"\n<meta name=\"description\" content=\"{text}\">")
    head.push_str("\n<meta property=\"og:type\" content=\"website\">")
    head.push_str("\n<meta property=\"og:site_name\" content=\"wrela\">")
    head.push_str("\n<meta property=\"og:title\" content=\"Wrela docs\">")
    head.push_str(f"\n<meta property=\"og:description\" content=\"{text}\">")
    head.push_str(f"\n<meta property=\"og:url\" content=\"{home}/\">")
    head.push_str(
        "\n<link rel=\"alternate\" type=\"text/markdown\" href=\"/llms.txt\" title=\"The docs as Markdown\">",
    )
    head.push_str("\n<script src=\"pages.js\" defer></script>")
    // The docs' page colours, behind the canvas before the program draws and in a phone's
    // browser bar, so the page doesn't open black.
    head.push_str(
        f"\n<meta name=\"theme-color\" media=\"(prefers-color-scheme: dark)\" content=\"{PAGE_DARK}\">",
    )
    head.push_str(
        f"\n<meta name=\"theme-color\" media=\"(prefers-color-scheme: light)\" content=\"{PAGE_LIGHT}\">",
    )
    // A reader may still pinch the docs larger, as on any page; a finger's swipe is the
    // program's.
    head.push_str(
        f"\n<style>html canvas#screen {{ touch-action: pinch-zoom; }} html, body {{ background: {PAGE_DARK}; }} @media (prefers-color-scheme: light) {{ html, body {{ background: {PAGE_LIGHT}; }} }}</style>",
    )
    // The groups: the language, then std, then the packages by name, as `llms.txt` has them.
    let groups = groups(pages)
    var files: Vec<(String, String)> = Vec::new()
    files.push(
        (
            String::from("llms.txt"),
            String::from("every page with its summary, and how to read the docs"),
        ),
    )
    files.push(
        (
            String::from("index.json"),
            String::from("every item with its signature, its page and its source line"),
        ),
    )
    for g in groups {
        let path = String::from(f"{g.as_str()}/llms-full.txt")
        if contains(has, path.as_str()) {
            let what = if g.as_str() == "spec" { String::from("the language") } else { g.clone() }
            files.push((path.clone(), String::from(f"{what.as_str()}'s pages in one file")))
        }
    }
    files.push((String::from("llms-full.txt"), String::from("every page in one file")))
    // A person first: the pages, each as plain HTML. Then an agent: the Markdown, and how an
    // address names a page, as its fragment never reaches the server.
    var body: Vec<String> = Vec::new()
    body.push(String::from("<main id=\"wrela-text\">"))
    body.push(String::from("<h1>Wrela docs</h1>"))
    body.push(String::from(f"<p>{text}</p>"))
    body.push(
        String::from(
            "<p>These docs are a Wrela program that draws with WebGPU. If your browser can't run it, here they are as plain pages.</p>",
        ),
    )
    for g in groups {
        if g.as_str() == "spec" {
            body.push(String::from("<h2>The language</h2>"))
        } else {
            body.push(String::from(f"<h2>{escape(g.as_str(), quote: true).as_str()}</h2>"))
        }
        body.push(String::from("<ul>"))
        for p in pages {
            if group_of(p).as_str() != g.as_str() {
                continue
            }
            let to = escape(stem(p.path.as_str()), quote: true)
            let title = escape(p.title.as_str(), quote: true)
            let link = String::from(f"<a href=\"{home}/{to.as_str()}.html\">{title.as_str()}</a>")
            if p.summary.is_empty() {
                body.push(String::from(f"<li>{link.as_str()}</li>"))
            } else {
                body.push(
                    String::from(
                        f"<li>{link.as_str()}: {code_of(p.summary.as_str()).as_str()}</li>",
                    ),
                )
            }
        }
        body.push(String::from("</ul>"))
    }
    body.push(String::from("<h2>For agents</h2>"))
    body.push(String::from("<p>Each page is Markdown too:</p>"))
    body.push(String::from("<ul>"))
    for (name, what) in files {
        if contains(has, name.as_str()) {
            body.push(
                String::from(
                    f"<li><a href=\"{home}/{name.as_str()}\">{name.as_str()}</a>: {what.as_str()}.</li>",
                ),
            )
        }
    }
    body.push(String::from("</ul>"))
    body.push(
        String::from(
            f"<p>In an address, the page's name comes after <code>#</code> and a heading's after <code>:</code>. So <code>{home}/#std/arena:arena-insert</code> is the heading <code>arena-insert</code> on <a href=\"{home}/std/arena.md\">{home}/std/arena.md</a>.</p>",
        ),
    )
    body.push(String::from("</main>"))
    var all = String::new()
    for b in body {
        all.push_str("\n")
        all.push_str(b.as_str())
    }
    (head, all)
}

/// Whether `names` holds `name`.
pub(package) fn contains(names: [String], name: str) -> bool {
    for n in names {
        if n.as_str() == name {
            return true
        }
    }
    false
}

/// The Worker secrets the console's server makes and checks its ceremonies' challenges with
/// (platform/edge.wrela): the key in use and the one before it, so a challenge made just before a
/// rotation still finishes. `wrangler secret put` sets each (docs/toolchain.md); the Worker gives
/// them to the program as the request headers `KEY_HEADERS` says, which it removes from what a
/// client sent first, since a program reads no Worker variable (docs/toolchain-gaps.md).
pub const KEY_SECRETS: [Text; 2] = ["WRELA_CEREMONY_KEY", "WRELA_CEREMONY_KEY_OLD"]
pub const KEY_HEADERS: [Text; 2] = ["x-wrela-key", "x-wrela-key-old"]

/// The path of the requests whose ceremonies the keys are for: a `POST` there (platform/wire.wrela's
/// `ACCOUNTS`, which a test checks) is the only request the Worker gives them to.
pub const KEYED: Text = "/api/accounts"

/// The R2 bucket of archived builds' verifiers (toolchain 0.18.0's `call_build`, its binding
/// `WRELA_BUILDS`): each release's deploy puts its server's verifier there (`verifier_path`).
pub const BUILDS_BUCKET: Text = "wrela-builds"

/// Where a release's server's verifier is kept in `BUILDS_BUCKET`: `verifiers/<game>/<board>/` and
/// the SHA-256 of its files (addresses.wrela's `runtime_hash` of each one's name and SHA-256).
pub fn verifier_path(game: str, board: u32, sha: str) -> String {
    String::from(f"verifiers/{game}/{board}/{sha}")
}

/// A release's server's verifier: where it's kept (`verifier_path`), and its files' names, each
/// in `<api>.server/verifier/` (main.wrela's `server_dir`).
pub struct Verifier: Clone {
    pub path: String,
    pub files: Vec<String>,
}

/// The file of a verifier that says what it is (`wrela-verify-1`): every verifier has it.
pub const VERIFIER_JSON: Text = "verifier.json"

/// Whether a verifier's `files` (their names) include its `VERIFIER_JSON`.
pub fn described(files: [String]) -> bool {
    contains(files, VERIFIER_JSON)
}

/// The console's server's Worker's script, `<api>.worker.js`: it exports the server's Durable
/// Objects, the server's and its rooms', and gives each request to the host's routers (`api`, then
/// `rooms`: toolchain 0.18.0's `server/cloudflare.js`, in the directory `server` beside the
/// script), which the Worker's routes bring only on the server's paths, with the ceremonies' keys
/// (`KEY_SECRETS`) as the headers `KEY_HEADERS` on a `POST` to `KEYED` alone, and any a client
/// sent removed from every request. A request neither answers is a 404.
pub fn api_script(server: str) -> String {
    var out = String::from(
        "// The console's server (studio/release/site.wrela). Written by the release tool.\n",
    )
    out.push_str(
        f"import {{ WrelaServer, WrelaRoom, api, rooms }} from \"./{server}/cloudflare.js\";\n",
    )
    out.push_str("export { WrelaServer, WrelaRoom };\n")
    out.push_str(
        "// The ceremonies' keys, from the Worker's secrets, never from a client, and only where a\n",
    )
    out.push_str("// ceremony is.\n")
    out.push_str("function keyed(request, env) {\n")
    out.push_str("  const headers = new Headers(request.headers);\n")
    for header in KEY_HEADERS {
        out.push_str(f"  headers.delete(\"{header}\");\n")
    }
    out.push_str(
        f"  if (request.method === \"POST\" && new URL(request.url).pathname === \"{KEYED}\") {{\n",
    )
    for k in 0..2 {
        let (secret, header) = (KEY_SECRETS[k], KEY_HEADERS[k])
        out.push_str(f"    if (env.{secret}) headers.set(\"{header}\", env.{secret});\n")
    }
    out.push_str("  }\n")
    out.push_str("  return new Request(request, { headers });\n")
    out.push_str("}\n")
    out.push_str("export default {\n")
    out.push_str("  async fetch(request, env, ctx) {\n")
    out.push_str(
        "    const answered = (await api(keyed(request, env), env, { ctx: ctx })) ?? (await rooms(request, env));\n",
    )
    out.push_str("    return answered ?? new Response(null, { status: 404 });\n")
    out.push_str("  },\n")
    out.push_str("};\n")
    out
}

/// The per-client rate limits of the console's server, ahead of it (toolchain 0.13.0's
/// `WRELA_LIMITS`, each a Workers Rate Limiting binding keyed on the client's address, which goes no
/// further: developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/): its binding, its
/// namespace, the path it counts under (wire.wrela's), its methods (none: every one), and the
/// requests a client may make in a minute. A sign-in is three requests and a console's start one,
/// so 120 a minute leaves room for several people behind one address, and an attacker few guesses
/// (the server limits recovery codes across everyone too); the public reads are mostly the cache's.
pub const RATE_LIMITS: [(Text, Text, Text, Text, u32); 2] = [
    ("ACCOUNTS_LIMIT", "4401", "/api/accounts", "POST", 120),
    ("PUBLIC_LIMIT", "4402", "/api/public", "", 300),
]

/// The console build's icons (console/icon.wrela, shipped under `files/icons/`), each with its size:
/// every Worker serves them as its `/favicon.ico` (`ico`).
pub const FAVICONS: [(Text, u32); 2] = [
    ("files/icons/icon-16.png", 16),
    ("files/icons/icon-32.png", 32),
]

fn le16(out: mut Vec<u8>, v: u32) {
    out.push(u8(v & 255))
    out.push(u8((v >> 8) & 255))
}

fn le32(out: mut Vec<u8>, v: u32) {
    le16(mut out, v & 65535)
    le16(mut out, v >> 16)
}

/// `pngs`, each a square PNG and its size in pixels (1 to 255), as one ICO file: its header, an
/// entry for each image, then each PNG as it is, which an ICO may hold in place of a bitmap
/// (en.wikipedia.org/wiki/ICO_(file_format)). A browser asks a site for `/favicon.ico` before its
/// program names its icons, and a crawler asks whatever the page names.
pub fn ico(pngs: [(Vec<u8>, u32)]) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    le16(mut out, 0)
    le16(mut out, 1)
    le16(mut out, pngs.len())
    var at = 6 + 16 * pngs.len()
    for (png, size) in pngs {
        out.push(u8(size))
        out.push(u8(size))
        // No palette, a reserved byte, one plane, 32 bits a pixel.
        out.push(0)
        out.push(0)
        le16(mut out, 1)
        le16(mut out, 32)
        le32(mut out, png.len())
        le32(mut out, at)
        at += png.len()
    }
    for (png, _) in pngs {
        for b in png {
            out.push(b)
        }
    }
    out
}

/// What every Worker answers a request no file matches with (`404.html`, with a 404): a short page
/// in the docs' colours, which leads to the start.
pub const NOT_FOUND: Text = "<!doctype html>\n<html lang=\"en\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Page not found</title>\n<style>body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 16px/1.5 system-ui, sans-serif; background: #09090B; color: #E4E4E7; } @media (prefers-color-scheme: light) { body { background: #FFFFFF; color: #18181B; } } a { color: inherit; }</style>\n<main>\n<h1>Page not found</h1>\n<p>There's nothing at this address. <a href=\"/\">Go to the home page</a>.</p>\n</main>\n"

/// A Worker's Wrangler configuration: its directory as its assets, on its custom domain only, and
/// no script. A request no file matches gets its `404.html` with a 404 (`404-page`). Cloudflare bills a request only when it runs a Worker's script, and a Worker that
/// has one runs it for each request no asset matches, a 404 too
/// (developers.cloudflare.com/workers/static-assets/routing/static-site-generation/, its routing
/// diagram). So the assets answer every request: the release's, each kept release's (the deploy
/// puts them beside it, studio/deploy), and a 404.
pub fn wrangler_config(worker: str, domain: str) -> String {
    var route: Vec<(String, Json)> = Vec::new()
    route.push(member("pattern", text(domain)))
    route.push(member("custom_domain", Json::Bool(true)))
    var assets: Vec<(String, Json)> = Vec::new()
    assets.push(member("directory", text(f"./{worker}")))
    assets.push(member("not_found_handling", text("404-page")))
    var c: Vec<(String, Json)> = Vec::new()
    c.push(member("name", text(worker)))
    c.push(member("compatibility_date", text(COMPATIBILITY_DATE)))
    c.push(member("assets", Json::Obj(take assets)))
    c.push(member("routes", Json::List(Vec::from([Json::Obj(take route)]))))
    c.push(member("workers_dev", Json::Bool(false)))
    c.push(member("preview_urls", Json::Bool(false)))
    var out = indented(Json::Obj(take c))
    out.push_str("\n")
    out
}

/// The console's server's Worker's Wrangler configuration: its script (`api_script`), and a route
/// in `zone` on `domain` for each path the server's build runs first (its `cloudflare.json`'s
/// `assets.run_worker_first`), which takes those paths before the console's custom domain does
/// (developers.cloudflare.com/workers/configuration/routing/routes/); the members the build asks
/// for, its first migration taking its classes over from the Worker `from` if one is named
/// (`transferred`), its origin as the one that may change things (`WRELA_ORIGINS`), and
/// `RATE_LIMITS`. Or why it can't be: the build names no paths, or one a route can't be (a route's
/// `*` is the last of its path), or its migrations can't be a transfer.
pub fn api_config(
    worker: str,
    domain: str,
    zone: str,
    from: str,
    server: [(String, Json)],
) -> Result<String, String> {
    var routes: Vec<Json> = Vec::new()
    if let Some(assets) = member_of(server, "assets") {
        if let Some(Json::List(rs)) = member_of_obj(assets, "run_worker_first") {
            for r in rs {
                let Json::Text(path) = r else {
                    return Err(String::from("the server's paths aren't text"))
                }
                let at = path.as_str().find("*")
                let last = match at {
                    Some(k) => k + 1 == path.len(),
                    None => true,
                }
                if !path.as_str().starts_with("/") || !last {
                    return Err(String::from(f"the server's path {path.as_str()} can't be a route"))
                }
                var route: Vec<(String, Json)> = Vec::new()
                route.push(member("pattern", text(f"{domain}{path.as_str()}")))
                route.push(member("zone_name", text(zone)))
                routes.push(Json::Obj(take route))
            }
        }
    }
    if routes.is_empty() {
        return Err(String::from("the server's build names no paths (assets.run_worker_first)"))
    }
    var c: Vec<(String, Json)> = Vec::new()
    c.push(member("name", text(worker)))
    c.push(member("compatibility_date", text(COMPATIBILITY_DATE)))
    c.push(member("main", text(f"./{worker}.worker.js")))
    c.push(member("routes", Json::List(take routes)))
    c.push(member("workers_dev", Json::Bool(false)))
    c.push(member("preview_urls", Json::Bool(false)))
    server_members(mut c, domain, from, server)?
    var out = indented(Json::Obj(take c))
    out.push_str("\n")
    Ok(out)
}

/// `migrations`, a server build's (`new_sqlite_classes` first), with its first migration taking
/// each of those classes over from the Worker `from`, with their Durable Objects, in place of
/// making them new: a transfer migration, which the destination's deploy alone applies
/// (developers.cloudflare.com/durable-objects/reference/durable-object-class-migrations-legacy/).
/// Or why it can't be one: no first migration of new SQLite classes.
pub fn transferred(migrations: Json, from: str) -> Result<Json, String> {
    let none = Err(String::from("the server's first migration makes no new SQLite classes"))
    let Json::List(list) = migrations else { return none }
    if list.is_empty() {
        return none
    }
    let Json::Obj(first) = list[0] else { return none }
    let Some(Json::List(classes)) = member_of(first, "new_sqlite_classes") else { return none }
    var moved: Vec<Json> = Vec::new()
    for class in classes {
        let Json::Text(name) = class else { return none }
        var t: Vec<(String, Json)> = Vec::new()
        t.push(member("from", text(name.as_str())))
        t.push(member("from_script", text(from)))
        t.push(member("to", text(name.as_str())))
        moved.push(Json::Obj(take t))
    }
    var m: Vec<(String, Json)> = Vec::new()
    for (k, v) in first {
        if k.as_str() == "new_sqlite_classes" {
            m.push(member("transferred_classes", Json::List(take moved)))
            moved = Vec::new()
        } else {
            m.push((k.clone(), v.clone()))
        }
    }
    var out: Vec<Json> = Vec::from([Json::Obj(take m)])
    for k in 1..list.len() {
        out.push(list[k].clone())
    }
    Ok(Json::List(take out))
}

/// A server's members of a Wrangler configuration: as its build gives them, its migrations a
/// transfer from `from` if it names a Worker, its variables filled (its origin, and the limits),
/// and the limits' bindings.
fn server_members(
    c: mut Vec<(String, Json)>,
    domain: str,
    from: str,
    server: [(String, Json)],
) -> Result<(), String> {
    var limits: Vec<Json> = Vec::new()
    var bindings: Vec<Json> = Vec::new()
    for (binding, namespace, prefix, method, n) in RATE_LIMITS {
        var l: Vec<(String, Json)> = Vec::new()
        l.push(member("binding", text(binding)))
        l.push(member("prefix", text(prefix)))
        if !method.is_empty() {
            l.push(member("methods", Json::List(Vec::from([text(method)]))))
        }
        l.push(member("period", Json::Int(60)))
        limits.push(Json::Obj(take l))
        var simple: Vec<(String, Json)> = Vec::new()
        simple.push(member("limit", Json::Int(u64(n))))
        simple.push(member("period", Json::Int(60)))
        var b: Vec<(String, Json)> = Vec::new()
        b.push(member("name", text(binding)))
        b.push(member("namespace_id", text(namespace)))
        b.push(member("simple", Json::Obj(take simple)))
        bindings.push(Json::Obj(take b))
    }
    for (k, v) in server {
        // The run-first paths are its routes; its note is for whoever merges, not Wrangler.
        if k.as_str() == "assets" || k.as_str() == "comment" {
            continue
        }
        if k.as_str() == "vars" {
            var vars: Vec<(String, Json)> = Vec::new()
            if let Json::Obj(given) = v {
                for (name, value) in given {
                    if name.as_str() != "WRELA_ORIGINS" && name.as_str() != "WRELA_LIMITS" {
                        vars.push((name.clone(), value.clone()))
                    }
                }
            }
            vars.push(member("WRELA_ORIGINS", text(f"https://{domain}")))
            vars.push(member("WRELA_LIMITS", text(compact(Json::List(limits.clone())).as_str())))
            c.push(member("vars", Json::Obj(take vars)))
            continue
        }
        if k.as_str() == "migrations" && !from.is_empty() {
            c.push(member("migrations", transferred(v.clone(), from)?))
            continue
        }
        c.push((k.clone(), v.clone()))
    }
    c.push(member("ratelimits", Json::List(take bindings)))
    // The archived builds' verifiers, for `call_build` (the build names its Worker Loader).
    var bucket: Vec<(String, Json)> = Vec::new()
    bucket.push(member("binding", text("WRELA_BUILDS")))
    bucket.push(member("bucket_name", text(BUILDS_BUCKET)))
    c.push(member("r2_buckets", Json::List(Vec::from([Json::Obj(take bucket)]))))
    Ok(())
}

/// The catalog as JSON, compact with its keys sorted: the first bytes of the release's
/// fingerprint.
pub fn catalog_json(c: Catalog) -> Json {
    var console: Vec<(String, Json)> = Vec::new()
    console.push(member("package", text(c.console.dir)))
    console.push(member("worker", text(c.console.worker)))
    console.push(member("domain", text(c.console.domain)))
    console.push(member("description", text(c.console.description)))
    console.push(member("api", text(c.console.api)))
    console.push(member("zone", text(c.console.zone)))
    console.push(member("api_from", text(c.console.api_from)))
    console.push(member("boards", text(c.console.boards)))
    console.push(member("board", Json::Int(u64(c.console.board))))
    var packages: Vec<Json> = Vec::new()
    for p in c.docs.packages {
        packages.push(text(p))
    }
    var docs: Vec<(String, Json)> = Vec::new()
    docs.push(member("package", text(c.docs.dir)))
    docs.push(member("worker", text(c.docs.worker)))
    docs.push(member("domain", text(c.docs.domain)))
    docs.push(member("description", text(c.docs.description)))
    docs.push(member("packages", Json::List(take packages)))
    var games: Vec<Json> = Vec::new()
    for g in c.games {
        var builds: Vec<(String, Json)> = Vec::new()
        for b in g.builds {
            builds.push(member(b.name, text(b.dir)))
        }
        var game: Vec<(String, Json)> = Vec::new()
        game.push(member("id", text(g.id)))
        game.push(member("title", text(g.title)))
        game.push(member("worker", text(g.worker)))
        game.push(member("domain", text(g.domain)))
        game.push(member("session", text(g.session)))
        game.push(member("builds", Json::Obj(take builds)))
        game.push(member("attract", text(g.attract)))
        game.push(member("cover", text(g.cover)))
        game.push(member("hero", text(g.hero)))
        game.push(member("logo", text(g.logo)))
        game.push(member("tagline", text(g.tagline)))
        game.push(member("theme", text(g.theme)))
        games.push(Json::Obj(take game))
    }
    var top: Vec<(String, Json)> = Vec::new()
    top.push(member("console", Json::Obj(take console)))
    top.push(member("docs", Json::Obj(take docs)))
    top.push(member("games", Json::List(take games)))
    Json::Obj(take top)
}

/// An image the release made for the console: its file's name and its size. No name: none.
pub struct Shipped: Clone {
    pub name: String,
    pub width: u32,
    pub height: u32,
}

/// A game's line of the console's catalog, between tabs: its id, title and session's address;
/// its cover's, hero's and title art's files and sizes; its tagline; its theme's file; and the
/// address where it plays itself, its fragment kept (empty for none).
pub fn catalog_line(
    game: Game,
    release: str,
    cover: Shipped,
    hero: Shipped,
    logo: Shipped,
    theme: str,
) -> String {
    let o = origin_of(game.domain)
    var line = String::from(
        f"{game.id}\t{game.title}\t{o.as_str()}/releases/{release}/{game.session}/",
    )
    for art in [cover.clone(), hero.clone(), logo.clone()] {
        line.push_str(f"\t{art.name.as_str()}\t{art.width}\t{art.height}")
    }
    line.push_str(f"\t{game.tagline}\t{theme}\t")
    if !game.attract.is_empty() {
        line.push_str(f"{o.as_str()}/releases/{release}/{attract_build(game.attract)}/")
        let fragment = attract_fragment(game.attract)
        if !fragment.is_empty() {
            line.push_str(f"#{fragment}")
        }
    }
    line
}

/// The builds of `game` in the order the console fetches them: the session first, then the
/// others in the catalog's order.
pub fn fetch_order(game: Game) -> Vec<Text> {
    var out: Vec<Text> = Vec::new()
    out.push(game.session)
    for b in game.builds {
        if b.name != game.session {
            out.push(b.name)
        }
    }
    out
}

/// Whether the console fetches a build's file at `path` (in the build) ahead of time: its
/// runtime, WASM and shaders, not the files a game streams as it plays (`files/`), nor its trap
/// locations (`.lines`), which only a crash reads, nor its pages (`.html`): a frame's page is a
/// navigation, which the browser caches apart from fetches.
pub fn prefetched(path: str) -> bool {
    !(path == "files" ||
        path.starts_with("files/") ||
        path.ends_with(".lines") ||
        path.ends_with(".html"))
}

/// What the console fetches of a game ahead of time, once it's idle: each build's files that
/// `prefetched` keeps, by their address, each once. `builds` holds each build's name and its
/// files, in `fetch_order`, each its path in the build and its URL on the game's origin if it
/// moved to a content address (addresses.wrela), else empty for its release's copy; its paths
/// sorted by their parts.
pub fn prefetch_list(game: Game, release: str, builds: [(Text, Vec<(String, String)>)]) -> String {
    let o = origin_of(game.domain)
    var out = String::new()
    var seen: Vec<String> = Vec::new()
    for (name, paths) in builds {
        for (p, url) in paths {
            if !prefetched(p.as_str()) {
                continue
            }
            let line = if url.is_empty() {
                String::from(f"{o.as_str()}/releases/{release}/{name}/{p.as_str()}")
            } else {
                String::from(f"{o.as_str()}{url.as_str()}")
            }
            if !contains(seen, line.as_str()) {
                out.push_str(f"{line.as_str()}\n")
                seen.push(take line)
            }
        }
    }
    if out.is_empty() {
        out.push_str("\n")
    }
    out
}

/// The URLs a page preloads as fetches (`<link rel="preload" href="..." as="fetch" ...>`), in
/// its order.
pub fn preloads(page: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    var at = 0
    while at < page.len() {
        let rest = page.slice(at, page.len())
        let Some(start) = rest.find("<link ") else { break }
        let tag_from = rest.slice(start, rest.len())
        let Some(end) = tag_from.find(">") else { break }
        let tag = tag_from.slice(0, end)
        at += start + end + 1
        if tag.find(" rel=\"preload\"").is_none() || tag.find(" as=\"fetch\"").is_none() {
            continue
        }
        let Some(h) = tag.find(" href=\"") else { continue }
        let value = tag.slice(h + 7, tag.len())
        let Some(q) = value.find("\"") else { continue }
        out.push(String::from(value.slice(0, q)))
    }
    out
}

/// The `_headers` rule for a page served at `path` that preloads `preloaded` (`preloads`), each
/// relative to `base` (the page's directory, or its `<base>`) unless it's root-absolute: each
/// as a `Link` header, which a zone with Early Hints sends ahead of the page, as a 103. Empty
/// for a page that preloads nothing. Or why not: a URL that leaves the origin or its directory,
/// or that a header can't carry.
pub fn early_hints(path: str, base: str, preloaded: [String]) -> Result<String, String> {
    if preloaded.is_empty() {
        return Ok(String::new())
    }
    var out = String::from(f"{path}\n")
    for u in preloaded {
        let s = u.as_str()
        var plain = !s.is_empty() && !s.starts_with("//")
        for i in 0..s.len() {
            let b = s.byte(i)
            plain = plain &&
                b > 32 &&
                b < 127 &&
                b != 60 &&
                b != 62 &&
                b != 44 &&
                b != 59 &&
                b != 34 &&
                b != 92 &&
                b != 58
        }
        for (a, b) in s.split("/") {
            if s.slice(a, b) == ".." {
                plain = false
            }
        }
        if !plain {
            return Err(String::from(f"a page at {path} preloads '{s}', which a header can't name"))
        }
        let url = if s.starts_with("/") { String::from(s) } else { String::from(f"{base}{s}") }
        out.push_str(f"  Link: <{url.as_str()}>; rel=preload; as=fetch; crossorigin\n")
    }
    Ok(out)
}

/// A bootstrap page with the storage namespace its program keeps its files under: the same in
/// every release, so a release doesn't lose what the last one stored.
pub fn with_storage(page: str, namespace: str) -> String {
    replace_all(page, "<head>", f"<head>\n<meta name=\"wrela-storage\" content=\"{namespace}\">")
}

/// What `release.json` says of a Worker: its name and domain, whether it's the console or the
/// docs, and its files and bytes.
pub struct Report: Clone {
    pub worker: String,
    pub domain: String,
    pub console: bool,
    pub docs: bool,
    pub files: u64,
    pub bytes: u64,
}

/// `release.json`: the release's source revision, its id, the console's server's Worker, its
/// verifier (which the deploy puts in `BUILDS_BUCKET`, and which a later build names for this
/// board: games/capybara/boards.wrela's `ARCHIVED`), and each Worker's report.
pub fn release_json(
    source: str,
    release: str,
    api: str,
    verifier: Verifier,
    workers: [Report],
) -> String {
    var list: Vec<Json> = Vec::new()
    for w in workers {
        var m: Vec<(String, Json)> = Vec::new()
        m.push(member("worker", text(w.worker.as_str())))
        m.push(member("domain", text(w.domain.as_str())))
        m.push(member("console", Json::Bool(w.console)))
        m.push(member("docs", Json::Bool(w.docs)))
        m.push(member("files", Json::Int(w.files)))
        m.push(member("bytes", Json::Int(w.bytes)))
        list.push(Json::Obj(take m))
    }
    var top: Vec<(String, Json)> = Vec::new()
    top.push(member("source", text(source)))
    top.push(member("release", text(release)))
    top.push(member("api", text(api)))
    var files: Vec<Json> = Vec::new()
    for f in verifier.files {
        files.push(text(f.as_str()))
    }
    var v: Vec<(String, Json)> = Vec::new()
    v.push(member("path", text(verifier.path.as_str())))
    v.push(member("files", Json::List(take files)))
    top.push(member("verifier", Json::Obj(take v)))
    top.push(member("workers", Json::List(take list)))
    indented(Json::Obj(take top))
}
