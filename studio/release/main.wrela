// The release tool (`wrela tool release`): a release of the console, its games and the
// reference docs, for Cloudflare Workers' static assets. The deploy tool (studio/deploy)
// deploys it.
//
// ```text
// wrela tool release -- --revision <commit>
// ```
//
// It reads the workspace (the root `ws`), stages its builds in `work` (build/release-work), and
// writes the release into `out` (build/release), which must be empty. `--revision` is the commit
// the workspace is at: the docs' source links name it, and `release.json` says it.
//
// **What it builds**, from the catalog (catalog.wrela), each package through the toolchain as it
// ships (optimized through Binaryen's `wasm-opt`, its trap locations beside it as `game.lines`):
// - **The console** in its Worker's directory, with the MIT licence and the font licences of its
//   package and every package it depends on (manifest.wrela), and each game's cover: its PNG
//   fitted within 960×540 with Lanczos and encoded as WebP at quality 90, method 6, named by its
//   bytes' SHA-256 (`cover-<16 hex>.webp`); and, for a game that names them, its hero (fitted
//   within 1920×1080, `hero-<16 hex>.webp`), its title art (within 1200×480, with its alpha,
//   `title-<16 hex>.webp`) and its theme (`theme-<16 hex>.txt`, as it is). The console reads them
//   with `catalog.tsv` (a line a game: its id, title, session's address, each image's file and
//   size, its tagline and its theme's file) and fetches each game's runtime, WASM and shaders
//   ahead of time from `prefetch-<id>.txt`.
// - **The docs**: the docs' program, the reference docs `wrela doc --export` writes of std and
//   the docs' packages beside it (a file of the export can't take the place of one of the
//   program's), and each page of the export as plain HTML (pages.wrela).
// - **Each game**: its builds, each in a directory of its name, the MIT licence, and headers and
//   a redirect that serve it only framed by the console.
//
// Each bootstrap page names its Worker's storage namespace (`<meta name="wrela-storage">`), the
// same in every release. **The release's id** is the first 20 hexadecimal digits of a SHA-256 of
// the catalog (compact JSON, keys sorted), then each file of the console, the docs and the games,
// in that order and each Worker's in the order of its paths' parts, framed by length (tree.wrela).
// Each Worker serves its release under `releases/<id>/` with `files.json` (each file's SHA-256,
// for a later deploy to keep), from an entry page that names that release (`<base>`), with
// headers and redirects (site.wrela), as static assets alone: `<worker>.wrangler.json` configures
// it. The console's server is a Worker of its own, on the console's API paths (`<api>.worker.js`
// and `<api>.wrangler.json`, its build beside them), and `release.json` says what the release
// holds.

use catalog::{CATALOG, Catalog, Game, check, origin_of, paths}
use json::{Json, from_doc}
use io::{copy_files, data_bytes, empty, read_files, release_blobs, walk, write_files}
use manifest::{Manifest, default_name, joined, last_part, parent, parse}
use pages::{FONTS, Page, file_of, in_order, page_html, render, stem}
use site::{
    CACHE_RULES, Report, Shipped, Top, api_config, api_script, card, catalog_json, catalog_line,
    docs_headers, docs_page, docs_redirects, fetch_order, headers, prefetch_list, release_json,
    replace_all, with_storage, wrangler_config,
}
use std::hash::sha256::{Sha256, hex}
use std::io::print
use std::json::{TOP, parse as parse_json}
use std::tool::{Call, ToolError, all, args}
use std::tool::blob::{Blob, Data}
use std::tool::files
use std::tool::files::{Entry, Kind}
use std::tool::image
use std::tool::image::{Image, Size}
use std::tool::toolchain
use tree::{Source, Tree, check_files, files_json, frame, hex_sha}

/// The roots: the workspace, read; the builds' stage; the release.
pub const WS: Text = "ws"
pub const WORK: Text = "work"
pub const OUT: Text = "out"

/// Where the docs' source is: their links name its files at the revision.
pub const REPOSITORY: Text = "https://github.com/rywible/wrela"

/// A cover's box and its WebP's quality and method: a 960×540 cover is 30 to 110 KB, not 2 MB
/// of pixels.
pub const COVER_BOX: Size = Size { width: 960, height: 540 }
/// A hero's box, behind a 1080p screen, and a title art's.
pub const HERO_BOX: Size = Size { width: 1920, height: 1080 }
pub const LOGO_BOX: Size = Size { width: 1200, height: 480 }
pub const COVER_QUALITY: f64 = 90.0
pub const COVER_METHOD: u8 = 6

/// How long an image may take, in seconds.
pub const LONGEST: f64 = 600.0

/// How long a build or the docs' export may take, in seconds: most of the run's budget
/// (`[tools.release] timeout`, 5400 s), less 5 minutes for the covers and the writing. Every
/// build is asked for at once and the host runs four at a time, so a build's deadline, which
/// counts from when the host takes the request, also counts its wait for the others: on a cold
/// cache and a 4-core runner, the last build starts long after the first.
pub const BUILD_TIMEOUT: f64 = 5100.0

pub const USAGE: Text = "usage: wrela tool release -- --revision <commit>"

/// The revision the command line gives, or `None` for a usage error: `--revision` and a commit's
/// hexadecimal name, 7 to 40 digits.
pub fn parse_args(given: [String]) -> Option<String> {
    if given.len() != 2 || given[0].as_str() != "--revision" {
        return None
    }
    let r = given[1].as_str()
    if r.len() < 7 || r.len() > 40 {
        return None
    }
    for k in 0..r.len() {
        let b = r.byte(k)
        if !((b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70)) {
            return None
        }
    }
    Some(String::from(r))
}

pub fn tool() -> u32 {
    let Some(revision) = parse_args(args()) else {
        print(USAGE)
        return 2
    }
    match release(revision.as_str()) {
        Ok(report) => {
            print(report.as_str())
            0
        },
        Err(e) => {
            print(f"release: {e.message()}")
            1
        },
    }
}

/// A failure of the release's own, said as `why`.
fn own(why: take String) -> ToolError {
    ToolError::new(why.as_str())
}

/// What a Worker of the release is.
pub enum Role: Copy + Eq {
    Console,
    Docs,
    Game(u32),
}

/// A Worker as the release assembles it: its role, name, domain, storage namespace and files.
pub struct Project: Clone {
    pub role: Role,
    pub worker: String,
    pub domain: String,
    pub namespace: String,
    pub tree: Tree,
}

fn project(role: Role, worker: str, domain: str, namespace: str) -> Project {
    Project {
        role,
        worker: String::from(worker),
        domain: String::from(domain),
        namespace: String::from(namespace),
        tree: Tree::new(),
    }
}

/// A package to build: its directory in the workspace, and its output in the stage.
struct Planned: Clone {
    dir: String,
    out: String,
}

/// Where the console's server build goes in the release: beside its Worker's script (`api`), and
/// in no Worker's assets, since its module isn't for the public.
pub fn server_dir(api: str) -> String {
    String::from(f"{api}.server")
}

fn rooted(path: str) -> String {
    String::from(f"{WS}/{path}")
}

/// The projects of `c`, in the order the fingerprint reads them: the console, the docs, then the
/// games.
pub fn projects_of(c: Catalog) -> Vec<Project> {
    var out: Vec<Project> = Vec::new()
    out.push(project(Role::Console, c.console.worker, c.console.domain, "console"))
    out.push(project(Role::Docs, c.docs.worker, c.docs.domain, "docs"))
    for k in 0..c.games.len() {
        borrow g = c.games[k]
        out.push(project(Role::Game(k), g.worker, g.domain, g.id))
    }
    out
}

/// The release, made: what `release.json` says. Each step's failure ends it.
fn release(revision: str) -> Result<String, ToolError> {
    let c = CATALOG.clone()
    check(c).map_err(own)?
    // The output is empty, and the stage is emptied.
    let out_list = files::list(OUT).wait()?
    if !out_list.is_empty() {
        return Err(ToolError::new("release output must be empty; choose a new directory"))
    }
    empty(WORK)?
    // What the catalog names is in the workspace.
    let wanted = paths(c)
    var stats: Vec<Call<Entry>> = Vec::new()
    for (path, why) in wanted {
        let Some(p) = files::rooted(WS, path.as_str()) else { return Err(own(why.clone())) }
        stats.push(files::stat(p.as_str()))
    }
    for k in 0..wanted.len() {
        match stats.remove(0).wait() {
            Ok(e) => {
                if e.kind != Kind::File {
                    return Err(own(wanted[k].1.clone()))
                }
            },
            Err(_) => return Err(own(wanted[k].1.clone())),
        }
    }
    var projects = projects_of(c)
    // Every package built, and the docs exported, at once.
    var plan: Vec<Planned> = Vec::new()
    plan.push(
        Planned { dir: rooted(c.console.dir), out: String::from(f"{WORK}/{c.console.worker}") },
    )
    plan.push(Planned { dir: rooted(c.docs.dir), out: String::from(f"{WORK}/{c.docs.worker}") })
    for g in c.games {
        for b in g.builds {
            plan.push(
                Planned { dir: rooted(b.dir), out: String::from(f"{WORK}/{g.worker}/{b.name}") },
            )
        }
    }
    var builds: Vec<Call<toolchain::Built>> = Vec::new()
    for p in plan {
        builds.push(toolchain::build(p.dir.as_str(), p.out.as_str(), build_options()))
    }
    var exported: Vec<String> = Vec::new()
    for p in c.docs.packages {
        exported.push(rooted(p))
    }
    let corpus = String::from(f"{WORK}/export")
    let export = toolchain::doc_export(
        exported,
        corpus.as_str(),
        REPOSITORY,
        revision,
        timeout: BUILD_TIMEOUT,
    )
    var outputs: Vec<Vec<String>> = Vec::new()
    for k in 0..plan.len() {
        let b = builds
            .remove(0)
            .wait()
            .map_err(
                |e| ToolError::new(f"{plan[k].dir.as_str()}: {e.message()}"),
            )?
        for d in b.diagnostics {
            if d.error {
                print(d.rendered.as_str())
            }
        }
        if !b.ok {
            return Err(ToolError::new(f"{plan[k].dir.as_str()} doesn't build"))
        }
        print(
            f"built {plan[k].out.as_str()} ({b.files.len()} files; constants: {b.computed} computed, {b.cached} from the cache)",
        )
        outputs.push(b.files.clone())
    }
    let n = (take export)
        .wait()
        .map_err(|e| ToolError::new(f"the docs' export: {e.message()}"))?
    print(f"exported {n} files of the docs to {corpus.as_str()}")
    // The builds' files, in their projects. The console's server build (`server/`) isn't served:
    // it runs in a Worker of its own, from beside that Worker's script (`server_dir`).
    var server_files: Vec<String> = Vec::new()
    var at = 0
    for k in 0..2 {
        for f in outputs[at] {
            if k == 0 && f.as_str().starts_with("server/") {
                server_files.push(f.clone())
                continue
            }
            if !is_marker(f.as_str()) {
                projects[k].tree.put(
                    f.as_str(),
                    Source::File(String::from(f"{plan[at].out.as_str()}/{f.as_str()}")),
                )
            }
        }
        at += 1
    }
    for g in 0..c.games.len() {
        let k = 2 + g
        projects[k].tree.put("LICENSE", Source::File(rooted("LICENSE")))
        for b in c.games[g].builds {
            for f in outputs[at] {
                if !is_marker(f.as_str()) {
                    projects[k].tree.put(
                        f"{b.name}/{f.as_str()}",
                        Source::File(String::from(f"{plan[at].out.as_str()}/{f.as_str()}")),
                    )
                }
            }
            at += 1
        }
    }
    // The licences of the console's and the docs' packages and their dependencies.
    for k in 0..2 {
        let dir = if k == 0 { rooted(c.console.dir) } else { rooted(c.docs.dir) }
        let ls = licences(dir.as_str())?
        projects[k].tree.put("LICENSE", Source::File(rooted("LICENSE")))
        for (name, path) in ls {
            projects[k].tree.put(name.as_str(), Source::File(path.clone()))
        }
    }
    // The docs' export beside their program: no file of the export in the place of one of the
    // program's.
    var export = walk(corpus.as_str())?
    export.sort_by(|a: String, b: String| tree::before_by_parts(a.as_str(), b.as_str()))
    if let Some(name) = export_conflict(projects[1].tree.tops(), export) {
        return Err(ToolError::new(f"the docs' export and program both have {name.as_str()}"))
    }
    for f in export {
        projects[1].tree.put(
            f.as_str(),
            Source::File(String::from(f"{corpus.as_str()}/{f.as_str()}")),
        )
    }
    // The docs as plain pages.
    var index_bytes = read_files(Vec::from([String::from(f"{corpus.as_str()}/index.json")]))?
    let pages = pages_of(replace(mut index_bytes[0], Vec::new())).map_err(own)?
    let ordered = in_order(pages)
    var sources: Vec<String> = Vec::new()
    var rendered: Vec<u32> = Vec::new()
    for k in 0..ordered.len() {
        if let Some(e) = projects[1].tree.find(ordered[k].path.as_str()) {
            match projects[1].tree.entries[e].source {
                Source::File(path) => {
                    sources.push(path.clone())
                    rendered.push(k)
                },
                Source::Bytes(_) => {},
            }
        }
    }
    var mds = read_files(sources)?
    for i in 0..rendered.len() {
        let k = rendered[i]
        let Some(text) = String::from_utf8(replace(mut mds[i], Vec::new())) else {
            return Err(ToolError::new(f"{ordered[k].path.as_str()} isn't UTF-8"))
        }
        let body = render(text.as_str())
        let before = if k > 0 { Some(ordered[k - 1].clone()) } else { None }
        let after = if k + 1 < ordered.len() { Some(ordered[k + 1].clone()) } else { None }
        let html = page_html(ordered[k], body.as_str(), before, after)
        projects[1].tree.put_bytes(f"{stem(ordered[k].path.as_str())}.html", html.as_bytes())
    }
    projects[1].tree.put_bytes("pages.css", file_of(pages::CSS).as_bytes())
    projects[1].tree.put_bytes("pages.js", file_of(pages::SCRIPT).as_bytes())
    for font in FONTS {
        projects[1].tree.put(last_part(font), Source::File(rooted(font)))
    }
    // The games' images, each made by a task of its own: each game's cover, and its hero and
    // title art if it names them, shipped at `images[game * 3 + kind]` (`KINDS`).
    var jobs: Vec<(String, Size)> = Vec::new()
    var slots: Vec<u32> = Vec::new()
    for g in 0..c.games.len() {
        borrow game = c.games[g]
        let wanted = [(game.cover, COVER_BOX), (game.hero, HERO_BOX), (game.logo, LOGO_BOX)]
        for k in 0..3 {
            let (path, within) = wanted[k]
            if !path.is_empty() {
                jobs.push((rooted(path), within))
                slots.push(g * 3 + k)
            }
        }
    }
    var made = all(take jobs, cover)
    var images: Vec<Shipped> = Vec::new()
    for _ in 0..c.games.len() * 3 {
        images.push(Shipped { name: String::new(), width: 0, height: 0 })
    }
    for slot in slots {
        let (art, width, height) = made.remove(0)?
        let name = ship(mut projects[0].tree, KINDS[slot % 3], "webp", art)
        images[slot] = Shipped { name, width, height }
    }
    // The themes, as they are.
    var theme_paths: Vec<String> = Vec::new()
    for g in c.games { if !g.theme.is_empty() { theme_paths.push(rooted(g.theme)) } }
    var theme_bytes = read_files(theme_paths)?
    var themes: Vec<String> = Vec::new()
    for g in c.games {
        themes.push(if g.theme.is_empty() { String::new() } else {
            ship(mut projects[0].tree, "theme", "txt", theme_bytes.remove(0))
        })
    }
    // A game's headers and its redirect to the console.
    let parent_origin = origin_of(c.console.domain)
    for g in 0..c.games.len() {
        let none: [String; 0] = []
        projects[2 + g].tree.put_bytes(
            "_headers",
            headers(parent_origin.as_str(), none, embedded: true).as_bytes(),
        )
        projects[2 + g].tree.put_bytes(
            "_redirects",
            f"/ {parent_origin.as_str()}/ 302\n".to_string().as_bytes(),
        )
    }
    // Each bootstrap page names its storage namespace.
    var pages_at: Vec<(u32, u32)> = Vec::new()
    var made_at: Vec<(u32, u32)> = Vec::new()
    var page_paths: Vec<String> = Vec::new()
    for k in 0..projects.len() {
        for e in 0..projects[k].tree.entries.len() {
            let p = projects[k].tree.entries[e].path.as_str()
            if p == "index.html" || p.ends_with("/index.html") {
                match projects[k].tree.entries[e].source {
                    Source::File(path) => {
                        pages_at.push((k, e))
                        page_paths.push(path.clone())
                    },
                    Source::Bytes(_) => made_at.push((k, e)),
                }
            }
        }
    }
    var boots = read_files(page_paths)?
    for i in 0..pages_at.len() {
        let (k, e) = pages_at[i]
        let Some(text) = String::from_utf8(replace(mut boots[i], Vec::new())) else {
            return Err(ToolError::new("a bootstrap page isn't UTF-8"))
        }
        let path = projects[k].tree.entries[e].path.clone()
        let page = with_storage(text.as_str(), projects[k].namespace.as_str())
        projects[k].tree.put_bytes(path.as_str(), page.as_bytes())
    }
    // A page the release made (a page of the docs named `index`) too.
    for (k, e) in made_at {
        let Source::Bytes(b) = projects[k].tree.entries[e].source else { panic("bytes") }
        let Some(text) = String::from_utf8(b.clone()) else {
            return Err(ToolError::new("a page isn't UTF-8"))
        }
        let path = projects[k].tree.entries[e].path.clone()
        let page = with_storage(text.as_str(), projects[k].namespace.as_str())
        projects[k].tree.put_bytes(path.as_str(), page.as_bytes())
    }
    // The fingerprint.
    for k in 0..projects.len() {
        projects[k].tree.sort()
    }
    let release = fingerprint(mut projects)?
    let r = release.as_str()
    // The console's catalog and prefetch lists, and the headers and redirects that name them.
    var catalog_text = String::new()
    for g in 0..c.games.len() {
        let line = catalog_line(
            c.games[g],
            r,
            images[g * 3],
            images[g * 3 + 1],
            images[g * 3 + 2],
            themes[g].as_str(),
        )
        catalog_text.push_str(line.as_str())
        catalog_text.push_str("\n")
    }
    projects[0].tree.put_bytes("catalog.tsv", catalog_text.as_bytes())
    for g in 0..c.games.len() {
        borrow game = c.games[g]
        var lists: Vec<(Text, Vec<String>)> = Vec::new()
        for name in fetch_order(game) {
            var paths_of: Vec<String> = Vec::new()
            let prefix = String::from(f"{name}/")
            for e in projects[2 + g].tree.entries {
                if e.path.as_str().starts_with(prefix.as_str()) {
                    paths_of.push(String::from(e.path.as_str().slice(prefix.len(), e.path.len())))
                }
            }
            lists.push((name, take paths_of))
        }
        let list = prefetch_list(game, r, lists)
        projects[0].tree.put_bytes(f"prefetch-{game.id}.txt", list.as_bytes())
    }
    var children: Vec<String> = Vec::new()
    for g in c.games {
        children.push(origin_of(g.domain))
    }
    projects[0].tree.put_bytes(
        "_headers",
        headers(parent_origin.as_str(), children, embedded: false).as_bytes(),
    )
    let docs_origin = origin_of(c.docs.domain)
    projects[1].tree.put_bytes("_headers", docs_headers(docs_origin.as_str()).as_bytes())
    let tops = projects[1].tree.tops()
    projects[1].tree.put_bytes("_redirects", docs_redirects(tops, r).as_bytes())
    // Each Worker's release, under `releases/<id>/`, from its entry page.
    let cover_name = if images.is_empty() { String::new() } else { images[0].name.clone() }
    var has: Vec<String> = Vec::new()
    for e in projects[1].tree.entries {
        has.push(e.path.clone())
    }
    let (docs_head, docs_body) = docs_page(c.docs, ordered, has)
    var finals: Vec<Project> = Vec::new()
    var copies: Vec<(String, String)> = Vec::new()
    for k in 0..projects.len() {
        borrow p = projects[k]
        var entry: Option<String> = None
        if p.role == Role::Console || p.role == Role::Docs {
            let Some(e) = p.tree.find("index.html") else {
                return Err(ToolError::new(f"{p.worker.as_str()} has no index.html"))
            }
            let Source::Bytes(b) = p.tree.entries[e].source else {
                return Err(ToolError::new("index.html"))
            }
            let Some(text) = String::from_utf8(b.clone()) else {
                return Err(ToolError::new("index.html isn't UTF-8"))
            }
            let base = String::from(f"<head>\n<base href=\"/releases/{r}/\">")
            if p.role == Role::Console {
                var head = base.clone()
                head.push_str(card(c.console, r, cover_name.as_str()).as_str())
                entry = Some(replace_all(text.as_str(), "<head>", head.as_str()))
            } else {
                var head = base.clone()
                head.push_str(docs_head.as_str())
                let a = replace_all(text.as_str(), "<head>", head.as_str())
                let b2 = replace_all(
                    a.as_str(),
                    "<title>wrela</title>",
                    "<title>Wrela docs</title>",
                )
                var body = String::from("<body>")
                body.push_str(docs_body.as_str())
                entry = Some(replace_all(b2.as_str(), "<body>", body.as_str()))
            }
        }
        var f = project(p.role, p.worker.as_str(), p.domain.as_str(), p.namespace.as_str())
        var versioned = Tree::new()
        for e in p.tree.entries {
            let path = e.path.as_str()
            let cut = match path.find("/") {
                Some(i) => i,
                None => path.len(),
            }
            let top = path.slice(0, cut)
            if top == "releases" || top == "_headers" || top == "_redirects" {
                f.tree.entries.push(e.clone())
            } else {
                var moved = e.clone()
                moved.path = String::from(f"releases/{r}/{path}")
                f.tree.entries.push(take moved)
                versioned.entries.push(e.clone())
            }
        }
        if let Some(text) = take entry {
            f.tree.put_bytes("index.html", text.as_bytes())
        }
        f.tree.put_bytes(f"releases/{r}/files.json", files_json(versioned.entries).as_bytes())
        let Some(h) = f.tree.find("_headers") else { return Err(ToolError::new("no _headers")) }
        let Source::Bytes(old) = f.tree.entries[h].source else {
            return Err(ToolError::new("_headers"))
        }
        let Some(given) = String::from_utf8(old.clone()) else {
            return Err(ToolError::new("_headers"))
        }
        var all_headers = given.clone()
        all_headers.push_str(CACHE_RULES)
        f.tree.put_bytes("_headers", all_headers.as_bytes())
        f.tree.sort()
        check_files(f.tree.entries).map_err(own)?
        finals.push(take f)
    }
    // The console's server: its build's files beside its Worker's script, and the members of its
    // Wrangler configuration it asks for (toolchain 0.13.0's `server/cloudflare.json`).
    let api = c.console.api
    let console_out = plan[0].out.clone()
    var server_members: Vec<(String, Json)> = Vec::new()
    for f in server_files {
        let rest = f.as_str().slice("server/".len(), f.len())
        copies.push(
            (
                String::from(f"{console_out.as_str()}/{f.as_str()}"),
                String::from(f"{OUT}/{server_dir(api).as_str()}/{rest}"),
            ),
        )
        if rest == "cloudflare.json" {
            let bytes = read_files(
                Vec::from([String::from(f"{console_out.as_str()}/{f.as_str()}")]),
            )?
            let Some(t) = String::from_utf8(bytes[0].clone()) else {
                return Err(ToolError::new("the server's cloudflare.json isn't UTF-8"))
            }
            let Some(doc) = parse_json(t.as_str()) else {
                return Err(ToolError::new("the server's cloudflare.json isn't JSON"))
            }
            let Some(Json::Obj(members)) = from_doc(doc, TOP) else {
                return Err(
                    ToolError::new("the server's cloudflare.json isn't an object of whole numbers"),
                )
            }
            server_members = take members
        }
    }
    if server_members.is_empty() {
        return Err(ToolError::new("the console's build has no server (server/cloudflare.json)"))
    }
    // Written: each Worker's files and its configuration, the server's Worker's script and
    // configuration, and what the release holds.
    var writes: Vec<(String, Vec<u8>)> = Vec::new()
    for p in finals {
        for e in p.tree.entries {
            let to = String::from(f"{OUT}/{p.worker.as_str()}/{e.path.as_str()}")
            match e.source {
                Source::File(from) => copies.push((from.clone(), take to)),
                Source::Bytes(b) => writes.push((take to, b.clone())),
            }
        }
        writes.push(
            (
                String::from(f"{OUT}/{p.worker.as_str()}.wrangler.json"),
                Vec::from(wrangler_config(p.worker.as_str(), p.domain.as_str()).as_bytes()),
            ),
        )
    }
    let config = api_config(api, c.console.domain, c.console.zone, server_members).map_err(own)?
    writes.push((String::from(f"{OUT}/{api}.wrangler.json"), Vec::from(config.as_bytes())))
    writes.push(
        (
            String::from(f"{OUT}/{api}.worker.js"),
            Vec::from(api_script(server_dir(api).as_str()).as_bytes()),
        ),
    )
    // The console first, then the games, then the docs, as release.json lists them.
    var reports: Vec<Report> = Vec::new()
    for want in 0..3 {
        for p in finals {
            let order = match p.role {
                Role::Console => 0,
                Role::Game(_) => 1,
                Role::Docs => 2,
            }
            if order != want {
                continue
            }
            let (count, bytes) = p.tree.totals()
            reports.push(
                Report {
                    worker: p.worker.clone(),
                    domain: p.domain.clone(),
                    console: p.role == Role::Console,
                    docs: p.role == Role::Docs,
                    files: count,
                    bytes,
                },
            )
        }
    }
    let report = release_json(revision, r, api, reports)
    var report_file = report.clone()
    report_file.push_str("\n")
    writes.push((String::from(f"{OUT}/release.json"), Vec::from(report_file.as_bytes())))
    copy_files(copies)?
    write_files(take writes)?
    // The stage, emptied.
    empty(WORK)?
    Ok(report)
}

/// Whether a build's file is its output's own record (`.wrela-build`), which doesn't ship.
fn is_marker(path: str) -> bool {
    path == ".wrela-build" || path.ends_with("/.wrela-build")
}

/// How a release's packages are built: as they ship, optimized through `wasm-opt`.
pub fn build_options() -> toolchain::BuildOptions {
    var options = toolchain::options()
    options.optimize = true
    options.timeout = BUILD_TIMEOUT
    options
}

/// The first name of the export's files (`paths`, sorted by parts) that one of the program's
/// top entries has, if one has.
pub fn export_conflict(program: [Top], paths: [String]) -> Option<String> {
    for t in export_tops(paths) {
        for p in program {
            if p.name.as_str() == t.as_str() {
                return Some(t.clone())
            }
        }
    }
    None
}

/// The first parts of `paths`, each once.
fn export_tops(paths: [String]) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for p in paths {
        let s = p.as_str()
        let cut = match s.find("/") {
            Some(k) => k,
            None => s.len(),
        }
        let top = s.slice(0, cut)
        var known = false
        for t in out {
            if t.as_str() == top {
                known = true
            }
        }
        if !known {
            out.push(String::from(top))
        }
    }
    out
}

/// The pages of the export's `index.json`.
pub fn pages_of(bytes: take Vec<u8>) -> Result<Vec<Page>, String> {
    let Some(text) = String::from_utf8(take bytes) else {
        return Err(String::from("index.json isn't UTF-8"))
    }
    let Some(doc) = parse_json(text.as_str()) else {
        return Err(String::from("index.json isn't JSON"))
    }
    var out: Vec<Page> = Vec::new()
    let Some(list) = doc.get(TOP, "pages") else { return Ok(out) }
    for i in 0..doc.count(list) {
        let Some(n) = doc.at(list, i) else { continue }
        let field = |key: str| -> String {
            match doc.get(n, key) {
                Some(v) => doc.text(v).unwrap_or(String::new()),
                None => String::new(),
            }
        }
        out.push(
            Page {
                path: field("path"),
                title: field("title"),
                summary: field("summary"),
                kind: field("kind"),
            },
        )
    }
    Ok(out)
}

// What `images` holds for each game, in order, as its files' names begin.
const KINDS: [Text; 3] = ["cover", "hero", "title"]

// Puts `bytes` in `tree` under a name of `prefix`, its content's hash and `extension`: the name.
fn ship(tree: mut Tree, prefix: str, extension: str, bytes: [u8]) -> String {
    let name = String::from(
        f"{prefix}-{hex_sha(bytes).as_str().slice(from: 0, to: 16)}.{extension}",
    )
    tree.put_bytes(name.as_str(), bytes)
    name
}

/// A game's image, from its PNG at `path` (a root path): fitted within `within` with Lanczos,
/// encoded as WebP, and its size.
fn cover(job: take (String, Size)) -> Result<(Vec<u8>, u32, u32), ToolError> {
    let (path, within) = job
    // Decoded, resized if it doesn't fit, and encoded, each blob given back after.
    var blobs: Vec<Blob> = Vec::new()
    let made = encoded(path.as_str(), within, mut blobs)
    release_blobs(blobs)
    let (art, width, height) = (take made).map_err(
        |e| ToolError::new(f"{path.as_str()}: {e.message()}"),
    )?
    Ok((data_bytes(take art)?, width, height))
}

/// The PNG at `path` as `cover` makes it within `within`, and its size: the WebP's data, which
/// `blobs` doesn't hold, and each blob made for it before in `blobs`.
fn encoded(path: str, within: Size, blobs: mut Vec<Blob>) -> Result<(Data, u32, u32), ToolError> {
    let file = files::read_blob(path).wait()?
    blobs.push(file)
    var img = image::decode(Data::Blob(file), timeout: LONGEST).wait()?
    if let Data::Blob(b) = img.rgba {
        blobs.push(b)
    }
    let to = image::fit(img.size(), within)
    if to != img.size() {
        img = image::resize(img, to, timeout: LONGEST).wait()?
        if let Data::Blob(b) = img.rgba {
            blobs.push(b)
        }
    }
    let art = image::encode_webp(img, COVER_QUALITY, COVER_METHOD, timeout: LONGEST).wait()?
    Ok((art, img.width, img.height))
}

/// The font licences to ship with the package at `dir` (a root path): each `fonts/OFL-*.txt` of
/// it and of every package it depends on, by name (a later one in the walk in place of an
/// earlier one of the same name) and path.
pub fn licences(dir: str) -> Result<Vec<(String, String)>, ToolError> {
    var seen: Vec<String> = Vec::new()
    var stack: Vec<String> = Vec::from([String::from(dir)])
    // The members of the workspace the last workspace dependency was found in, and its
    // directory: each package of one workspace finds the same.
    var members: Vec<(String, String)> = Vec::new()
    var members_of = String::new()
    while !stack.is_empty() {
        let Some(dir) = stack.pop() else { break }
        var known = false
        for s in seen {
            if s.as_str() == dir.as_str() {
                known = true
            }
        }
        if known {
            continue
        }
        seen.push(dir.clone())
        let Some(m) = manifest_at(dir.as_str())? else { continue }
        borrow deps = m.dependencies
        for di in 0..deps.len() {
            borrow d = deps[di]
            match d.path {
                Some(rel) => {
                    let Some(to) = joined(dir.as_str(), rel.as_str()) else {
                        return Err(
                            ToolError::new(
                                f"{dir.as_str()}: {d.name.as_str()} is outside the workspace",
                            ),
                        )
                    }
                    stack.push(take to)
                },
                None => {
                    // The members of the nearest workspace at or above `dir`.
                    let (root, entries) = nearest_workspace(dir.as_str())?
                    if root.as_str() != members_of.as_str() {
                        members = members_at(root.as_str(), entries)?
                        members_of = take root
                    }
                    var to: Option<String> = None
                    for (name, member) in members {
                        if name.as_str() == d.name.as_str() {
                            to = Some(member.clone())
                        }
                    }
                    let Some(t) = take to else {
                        return Err(
                            ToolError::new(
                                f"no member of the workspace is named {d.name.as_str()}",
                            ),
                        )
                    }
                    stack.push(take t)
                },
            }
        }
    }
    // Each directory's `fonts/OFL-*.txt`, in the walk's order.
    var lists: Vec<Call<Vec<Entry>>> = Vec::new()
    for s in seen {
        lists.push(files::list(f"{s.as_str()}/fonts"))
    }
    var out: Vec<(String, String)> = Vec::new()
    for k in 0..seen.len() {
        let Ok(entries) = lists.remove(0).wait() else { continue }
        for e in entries {
            let n = e.name.as_str()
            if e.kind == Kind::File && n.starts_with("OFL-") && n.ends_with(".txt") {
                let path = String::from(f"{seen[k].as_str()}/fonts/{n}")
                var placed = false
                for i in 0..out.len() {
                    if out[i].0.as_str() == n {
                        out[i].1 = path.clone()
                        placed = true
                    }
                }
                if !placed {
                    out.push((String::from(n), take path))
                }
            }
        }
    }
    Ok(out)
}

/// The manifest of the package at `dir` (a root path), or `None` if it has none.
pub fn manifest_at(dir: str) -> Result<Option<Manifest>, ToolError> {
    let path = String::from(f"{dir}/wrela.toml")
    match files::stat(path.as_str()).wait() {
        Ok(e) => {
            if e.kind != Kind::File {
                return Ok(None)
            }
        },
        Err(_) => return Ok(None),
    }
    var bytes = read_files(Vec::from([path.clone()]))?
    let Some(text) = String::from_utf8(replace(mut bytes[0], Vec::new())) else {
        return Err(ToolError::new(f"{path.as_str()} isn't UTF-8"))
    }
    Ok(Some(parse(text.as_str())))
}

/// The nearest workspace at or above the package at `dir` (a root path): its directory, and its
/// members, each by name and directory (`members_at`).
pub fn workspace_of(dir: str) -> Result<(String, Vec<(String, String)>), ToolError> {
    let (root, entries) = nearest_workspace(dir)?
    let members = members_at(root.as_str(), entries)?
    Ok((root, members))
}

/// The nearest workspace at or above the package at `dir` (a root path): its directory, and its
/// manifest's `members`.
fn nearest_workspace(dir: str) -> Result<(String, Vec<String>), ToolError> {
    var at: Option<String> = Some(String::from(dir))
    loop {
        let Some(dir) = take at else {
            return Err(ToolError::new("a workspace dependency, but no workspace"))
        }
        if let Some(m) = manifest_at(dir.as_str())? {
            if let Some(list) = m.members {
                return Ok((dir.clone(), list.clone()))
            }
        }
        at = parent(dir.as_str())
    }
}

/// The members of the workspace at `root` whose manifest lists `entries`, each by name and
/// directory. A member's name is its manifest's, else its directory's with `-` read as `_`; two
/// members of one name are refused.
fn members_at(root: str, entries: [String]) -> Result<Vec<(String, String)>, ToolError> {
    // Each entry's directories: itself, or each directory with a manifest in it for `x/*`.
    var dirs: Vec<String> = Vec::new()
    var globs: Vec<String> = Vec::new()
    for e in entries {
        let s = e.as_str()
        if s == "*" || s.ends_with("/*") {
            let base = s.slice(0, s.len() - 1)
            let Some(d) = joined(root, base) else {
                return Err(ToolError::new(f"a member outside the workspace: {s}"))
            }
            globs.push(take d)
        } else {
            let Some(d) = joined(root, s) else {
                return Err(ToolError::new(f"a member outside the workspace: {s}"))
            }
            dirs.push(take d)
        }
    }
    var lists: Vec<Call<Vec<Entry>>> = Vec::new()
    for g in globs {
        lists.push(files::list(g.as_str()))
    }
    // The candidates of each glob, kept if they have a manifest.
    for k in 0..globs.len() {
        let list = lists
            .remove(0)
            .wait()
            .map_err(|e| ToolError::new(f"{globs[k].as_str()}: {e.message()}"))?
        for e in list {
            if e.kind == Kind::Dir && !e.name.as_str().starts_with(".") {
                dirs.push(String::from(f"{globs[k].as_str()}/{e.name.as_str()}"))
            }
        }
    }
    var members: Vec<(String, String)> = Vec::new()
    for di in 0..dirs.len() {
        let d = dirs[di].clone()
        let Some(m) = manifest_at(d.as_str())? else { continue }
        let name = match m.name {
            Some(n) => n.clone(),
            None => default_name(d.as_str()),
        }
        for (other, at_dir) in members {
            if other.as_str() == name.as_str() && at_dir.as_str() != d.as_str() {
                return Err(
                    ToolError::new(f"two members of the workspace are named {name.as_str()}"),
                )
            }
        }
        members.push((take name, d.clone()))
    }
    Ok(members)
}

/// The release's fingerprint over `projects`' files (each tree sorted by parts), with each
/// file's size and SHA-256 filled in: the release's id.
fn fingerprint(projects: mut Vec<Project>) -> Result<String, ToolError> {
    var digest = Sha256::new()
    digest.update(json::compact(catalog_json(CATALOG)).as_bytes())
    for k in 0..projects.len() {
        let count = projects[k].tree.entries.len()
        var at = 0
        while at < count {
            let n = min(io::AT_ONCE, count - at)
            var wanted: Vec<String> = Vec::new()
            for i in at..at + n {
                if let Source::File(path) = projects[k].tree.entries[i].source {
                    wanted.push(path.clone())
                }
            }
            var bodies = read_files(wanted)?
            var b = 0
            for i in at..at + n {
                let path = String::from(
                    f"{projects[k].worker.as_str()}/{projects[k].tree.entries[i].path.as_str()}",
                )
                let is_file = match projects[k].tree.entries[i].source {
                    Source::File(_) => true,
                    Source::Bytes(_) => false,
                }
                if is_file {
                    let body = replace(mut bodies[b], Vec::new())
                    b += 1
                    frame(mut digest, path.as_str(), u64(body.len()))
                    digest.update(body)
                    projects[k].tree.entries[i].size = u64(body.len())
                    projects[k].tree.entries[i].sha = hex_sha(body)
                } else {
                    let Source::Bytes(body) = projects[k].tree.entries[i].source else {
                        panic("bytes")
                    }
                    frame(mut digest, path.as_str(), u64(body.len()))
                    digest.update(body)
                }
            }
            at += n
        }
    }
    let id = hex(digest.finish())
    Ok(String::from(id.as_str().slice(from: 0, to: 20)))
}
