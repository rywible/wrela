// The console's server in a release: its build (the console's `server/`), and what Fly.io runs it
// with, written into the release's `fly/` (the deploy tool deploys it with `flyctl`). The repository
// holds only Wrela, so the image's files are made here, from the release's own facts.
//
// What runs, on one Fly machine with a volume at /data:
// - `wrela-serve` of the toolchain the workspace pins (downloaded and checked against its
//   release's SHA256SUMS, as CI's own toolchain is), serving the console's server build over
//   WebTransport to the console's origin alone (`--origin`), with its store in /data.
// - A UDP relay (socat) on `fly-global-services:443`: Fly delivers UDP only to that address, and a
//   wildcard bind replies from the wrong one, while `wrela-serve` binds every address
//   (docs/toolchain-gaps.md, "wrela-serve can't choose its address"). It forwards to
//   `wrela-serve` on the loopback.
// - Let's Encrypt's certificate for `HOST`, through Cloudflare's DNS (a WebTransport server needs
//   a certificate a browser trusts, and Fly terminates no TLS for UDP), asked for at each start
//   and renewed twice a day when due; a renewal restarts the server for it.
// - Litestream, which copies the store to a bucket as it changes, and brings it back on a new
//   volume, its copies kept 30 days (the Privacy Policy's promise for a deleted account).
// No part of it logs an IP address: wrela-serve logs only a room's failures, and socat, certbot
// and Litestream run without per-connection logs.

/// The host the console finds its server at, and the console's origin, the one it takes.
pub const HOST: Text = "play.wrela.dev"
pub const ORIGIN: Text = "https://wrela.dev"
/// The Fly app and its region.
pub const APP: Text = "wrela-play"
pub const REGION: Text = "iad"
/// The port the relay forwards to on the loopback.
pub const INNER_PORT: u32 = 4433
/// Litestream's release, pinned.
pub const LITESTREAM: Text = "0.3.13"

/// The console's `net.json`: where its server is (language.md §19.3, "Finding and running the
/// server"). A certificate authority's certificate, so no hash.
pub fn net_json() -> String {
    String::from(f"{{\"url\":\"https://{HOST}\"}}\n")
}

/// The toolchain `wrela.toml`'s text pins, if it pins one.
pub fn pinned(manifest: str) -> Option<String> {
    let key = "toolchain = \""
    let at = manifest.find(key)?
    let from = at + key.len()
    let rest = manifest.slice(from, manifest.len())
    let end = rest.find("\"")?
    let v = rest.slice(0, end)
    for i in 0..v.len() {
        let b = v.byte(i)
        if !(b == 46 || (b >= 48 && b <= 57)) {
            return None
        }
    }
    if v.is_empty() { None } else { Some(v.to_string()) }
}

pub fn fly_toml() -> String {
    var t = String::new()
    t.push_str(
        "# Made by `wrela tool release` (studio/release/server.wrela): the console's server.\n",
    )
    t.push_str(f"app = \"{APP}\"\nprimary_region = \"{REGION}\"\n\n")
    t.push_str("[build]\n  dockerfile = \"Dockerfile\"\n\n")
    t.push_str(f"[env]\n  HOST = \"{HOST}\"\n  ORIGIN = \"{ORIGIN}\"\n\n")
    t.push_str("[[mounts]]\n  source = \"wrela_data\"\n  destination = \"/data\"\n\n")
    t.push_str(
        "# WebTransport is QUIC, over UDP: Fly passes it through to the machine untouched.\n",
    )
    t.push_str(
        "[[services]]\n  internal_port = 443\n  protocol = \"udp\"\n\n  [[services.ports]]\n    port = 443\n\n",
    )
    t.push_str("[[vm]]\n  size = \"shared-cpu-1x\"\n  memory = \"512mb\"\n")
    t
}

pub fn dockerfile(toolchain: str) -> String {
    let tarball = f"wrela-{toolchain}-x86_64-unknown-linux-gnu.tar.gz"
    let base = f"https://github.com/rywible/wrela-compiler/releases/download/v{toolchain}"
    var d = String::new()
    d.push_str(
        "# Made by `wrela tool release` (studio/release/server.wrela): the console's server.\n",
    )
    d.push_str("FROM debian:bookworm-slim\n")
    d.push_str(
        "RUN apt-get update \\\n && apt-get install -y --no-install-recommends ca-certificates curl socat procps certbot python3-certbot-dns-cloudflare \\\n && rm -rf /var/lib/apt/lists/*\n",
    )
    d.push_str(
        f"RUN curl -fsSL -o /tmp/litestream.deb https://github.com/benbjohnson/litestream/releases/download/v{LITESTREAM}/litestream-v{LITESTREAM}-linux-amd64.deb \\\n && dpkg -i /tmp/litestream.deb && rm /tmp/litestream.deb\n",
    )
    d.push_str(
        "# wrela-serve, from the toolchain the workspace pins, checked against its release's sums.\n",
    )
    d.push_str(
        f"RUN cd /tmp && curl -fsSLO {base}/{tarball} && curl -fsSLO {base}/SHA256SUMS \\\n && grep \"  {tarball}$\" SHA256SUMS | sha256sum -c - \\\n && mkdir -p /opt/wrela && tar xzf {tarball} -C /opt/wrela && rm {tarball} SHA256SUMS\n",
    )
    d.push_str("COPY server /app/build/server\n")
    d.push_str("COPY start.sh litestream.yml /app/\n")
    d.push_str("RUN chmod +x /app/start.sh\n")
    d.push_str("CMD [\"/app/start.sh\"]\n")
    d
}

pub fn start_script() -> String {
    var s = String::new()
    s.push_str(
        "#!/bin/sh\n# Made by `wrela tool release` (studio/release/server.wrela): the console's server.\nset -eu\n",
    )
    s.push_str("mkdir -p /data/certs\n")
    s.push_str("# On a new volume, the store comes back from its bucket.\n")
    s.push_str(
        "if [ ! -f /data/store.sqlite ]; then\n  litestream restore -if-replica-exists -config /app/litestream.yml /data/store.sqlite\nfi\n",
    )
    s.push_str(
        "# The certificate for $HOST, from Let's Encrypt through Cloudflare's DNS. No email is given.\n",
    )
    s.push_str(
        "printf 'dns_cloudflare_api_token = %s\\n' \"$CLOUDFLARE_DNS_TOKEN\" > /tmp/cloudflare.ini\nchmod 600 /tmp/cloudflare.ini\n",
    )
    s.push_str(
        "cert() {\n  certbot certonly --quiet --non-interactive --agree-tos --register-unsafely-without-email \\\n    --dns-cloudflare --dns-cloudflare-credentials /tmp/cloudflare.ini \\\n    --config-dir /data/certs --work-dir /tmp/certbot --logs-dir /tmp/certbot \\\n    --keep-until-expiring -d \"$HOST\" \"$@\"\n}\ncert\n",
    )
    s.push_str(
        "# Twice a day, renewed when due: a renewal ends the server, and Fly starts the machine again with it.\n",
    )
    s.push_str(
        "(while sleep 43200; do cert --deploy-hook 'pkill -f wrela-serve' || true; done) &\n",
    )
    s.push_str(
        "# Fly delivers UDP only to fly-global-services, and wrela-serve binds every address: a relay.\n",
    )
    s.push_str(
        f"socat -T 300 UDP4-RECVFROM:443,bind=fly-global-services,fork UDP4-SENDTO:127.0.0.1:{INNER_PORT} &\n",
    )
    s.push_str(
        "# The server, under Litestream, which copies its store to the bucket as it changes.\n",
    )
    s.push_str(
        f"exec litestream replicate -config /app/litestream.yml -exec \"/opt/wrela/bin/wrela-serve /app/build --port {INNER_PORT} --data /data --cert /data/certs/live/$HOST/fullchain.pem --key /data/certs/live/$HOST/privkey.pem --origin $ORIGIN\"\n",
    )
    s
}

pub fn litestream_yml() -> String {
    var y = String::new()
    y.push_str(
        "# Made by `wrela tool release` (studio/release/server.wrela): the store's copies, kept 30 days.\n",
    )
    y.push_str("dbs:\n  - path: /data/store.sqlite\n    replicas:\n      - type: s3\n")
    y.push_str(
        "        bucket: ${BUCKET_NAME}\n        path: store\n        endpoint: ${AWS_ENDPOINT_URL_S3}\n        region: auto\n        retention: 720h\n",
    )
    y
}

/// The files of the release's `fly/`, by name, but the server's build, which is copied beside them.
pub fn fly_files(toolchain: str) -> Vec<(String, String)> {
    Vec::from(
        [
            (String::from("fly.toml"), fly_toml()),
            (String::from("Dockerfile"), dockerfile(toolchain)),
            (String::from("start.sh"), start_script()),
            (String::from("litestream.yml"), litestream_yml()),
        ],
    )
}

@test
fn the_server_runs_the_pinned_toolchain_for_the_consoles_origin_alone() {
    assert(
        pinned("[workspace]\ntoolchain = \"0.10.3\"\nmembers = []") == Some(String::from("0.10.3")),
    )
    assert(pinned("toolchain = \"0.10.3; rm -rf /\"").is_none(), "only a version")
    assert(pinned("members = []").is_none())
    let d = dockerfile("0.10.3")
    assert(d.as_str().find("v0.10.3/wrela-0.10.3-x86_64-unknown-linux-gnu.tar.gz").is_some())
    assert(d.as_str().find("sha256sum -c").is_some(), "checked against its sums")
    let s = start_script()
    assert(
        s.as_str().find("--origin $ORIGIN").is_some() &&
            fly_toml().as_str().find("ORIGIN = \"https://wrela.dev\"").is_some(),
    )
    assert(s.as_str().find("bind=fly-global-services").is_some(), "UDP where Fly delivers it")
    assert(s.as_str().find("--register-unsafely-without-email").is_some(), "no email")
    assert(litestream_yml().as_str().find("retention: 720h").is_some(), "copies kept 30 days")
    assert(net_json() == String::from("{\"url\":\"https://play.wrela.dev\"}\n"))
}
