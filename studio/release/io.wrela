// The release's requests, a batch at a time: files read, copied and written whole through blobs,
// and directories walked. A batch's requests are all made before any is waited on, so they run at
// once; at most `AT_ONCE` of them are outstanding, so a release of hundreds of files keeps the
// host's file workers busy without holding every file at once.

use std::tool::{Answer, Call, Done, MOST_BYTES, ToolError}
use std::tool::blob
use std::tool::blob::{Blob, Data}
use std::tool::files
use std::tool::files::Kind
use toolkit::whole::{joined, write_file}

/// How many requests of a batch are outstanding at once.
pub const AT_ONCE: u32 = 32

/// `e`, said with what it was about.
fn said(what: str, e: ToolError) -> ToolError {
    ToolError::new(f"{what}: {e.message()}")
}

/// The answer of each of `calls`, in order, once every one has come: or the first failure, said
/// with its name in `what`.
fn waited<T: Answer>(calls: take Vec<Call<T>>, what: [String]) -> Result<Vec<T>, ToolError> {
    var calls = take calls
    var out: Vec<T> = Vec::new()
    var failed: Option<ToolError> = None
    for k in 0..what.len() {
        match calls.remove(0).wait() {
            Ok(x) => out.push(take x),
            Err(e) => {
                if failed.is_none() {
                    failed = Some(said(what[k].as_str(), e))
                }
            },
        }
    }
    match take failed {
        Some(e) => Err(e),
        None => Ok(out),
    }
}

/// The blob of each file at `paths` (root paths), opened at once.
fn opened(paths: [String]) -> Result<Vec<Blob>, ToolError> {
    var calls: Vec<Call<Blob>> = Vec::new()
    for p in paths {
        calls.push(files::read_blob(p.as_str()))
    }
    waited(take calls, paths)
}

/// The bytes of each of `blobs`, the files at `paths`: their lengths at once, then all their
/// chunks at once.
fn contents(blobs: [Blob], paths: [String]) -> Result<Vec<Vec<u8>>, ToolError> {
    var lens: Vec<Call<u64>> = Vec::new()
    for b in blobs {
        lens.push(blob::len(b))
    }
    let sizes = waited(take lens, paths)?
    var chunks: Vec<Call<Vec<u8>>> = Vec::new()
    var whose: Vec<String> = Vec::new()
    var counts: Vec<u32> = Vec::new()
    for k in 0..blobs.len() {
        let c = u32((sizes[k] + u64(MOST_BYTES) - 1) / u64(MOST_BYTES))
        counts.push(c)
        for i in 0..c {
            chunks.push(blob::read(blobs[k], u64(i) * u64(MOST_BYTES), MOST_BYTES))
            whose.push(paths[k].clone())
        }
    }
    var parts = waited(take chunks, whose)?
    var out: Vec<Vec<u8>> = Vec::new()
    var c = 0
    for k in 0..blobs.len() {
        var whole: Vec<u8> = Vec::new()
        for _ in 0..counts[k] {
            whole.append(mut parts[c])
            c += 1
        }
        out.push(take whole)
    }
    Ok(out)
}

/// The whole of each file at `paths` (root paths), in order.
pub fn read_files(paths: [String]) -> Result<Vec<Vec<u8>>, ToolError> {
    var out: Vec<Vec<u8>> = Vec::new()
    var at = 0
    while at < paths.len() {
        let n = min(AT_ONCE, paths.len() - at)
        var names: Vec<String> = Vec::new()
        for k in 0..n {
            names.push(paths[at + k].clone())
        }
        let blobs = opened(names)?
        let read = contents(blobs, names)
        release_blobs(blobs)
        var wholes = (take read)?
        out.append(mut wholes)
        at += n
    }
    Ok(out)
}

/// Copies each file `from` to `to` (root paths, `to` in a write root), whole, through a blob.
pub fn copy_files(pairs: [(String, String)]) -> Result<(), ToolError> {
    var at = 0
    while at < pairs.len() {
        let n = min(AT_ONCE, pairs.len() - at)
        var names: Vec<String> = Vec::new()
        var targets: Vec<String> = Vec::new()
        for k in 0..n {
            names.push(pairs[at + k].0.clone())
            targets.push(pairs[at + k].1.clone())
        }
        let blobs = opened(names)?
        var writes: Vec<Call<Done>> = Vec::new()
        for k in 0..n {
            writes.push(files::write_blob(targets[k].as_str(), blobs[k]))
        }
        let written = waited(take writes, targets)
        release_blobs(blobs)
        let _ = (take written)?
        at += n
    }
    Ok(())
}

/// Writes each file's bytes as the whole file at its path (a root path in a write root): at
/// once, or through a blob if they're more than a request carries.
pub fn write_files(given: take Vec<(String, Vec<u8>)>) -> Result<(), ToolError> {
    var items = take given
    var at = 0
    while at < items.len() {
        let n = min(AT_ONCE, items.len() - at)
        // The small files at once; each large one through a blob of its own (`write_file`).
        var names: Vec<String> = Vec::new()
        var writes: Vec<Call<Done>> = Vec::new()
        var large: Vec<u32> = Vec::new()
        for k in 0..n {
            if items[at + k].1.len() <= MOST_BYTES {
                names.push(items[at + k].0.clone())
                writes.push(files::write(items[at + k].0.as_str(), items[at + k].1))
            } else {
                large.push(at + k)
            }
        }
        let _ = waited(take writes, names)?
        for index in large {
            let path = items[index].0.clone()
            let bytes = replace(mut items[index].1, Vec::new())
            write_file(path.as_str(), Vec::from([take bytes])).map_err(|e| said(path.as_str(), e))?
        }
        at += n
    }
    Ok(())
}

/// The files under the directory `dir` (a root path), each by its path there, in no order. A
/// symbolic link, or anything but a file or a directory, is refused.
pub fn walk(dir: str) -> Result<Vec<String>, ToolError> {
    var out: Vec<String> = Vec::new()
    // Directories still to list, each by its path from `dir` ("" for `dir` itself).
    var todo: Vec<String> = Vec::from([String::new()])
    while !todo.is_empty() {
        let n = min(AT_ONCE, todo.len())
        let batch = todo.drain_front(n)
        var names: Vec<String> = Vec::new()
        var lists: Vec<Call<Vec<files::Entry>>> = Vec::new()
        for rel in batch {
            let path = if rel.is_empty() {
                String::from(dir)
            } else {
                String::from(f"{dir}/{rel.as_str()}")
            }
            lists.push(files::list(path.as_str()))
            names.push(take path)
        }
        let listed = waited(take lists, names)?
        for k in 0..n {
            for e in listed[k] {
                let rel = if batch[k].is_empty() {
                    e.name.clone()
                } else {
                    String::from(f"{batch[k].as_str()}/{e.name.as_str()}")
                }
                match e.kind {
                    Kind::File => out.push(take rel),
                    Kind::Dir => todo.push(take rel),
                    Kind::Link => {
                        return Err(
                            ToolError::new(
                                f"release assets cannot be symbolic links: {names[k].as_str()}/{e.name.as_str()}",
                            ),
                        )
                    },
                    Kind::Other => {
                        return Err(
                            ToolError::new(
                                f"not a file or a directory: {names[k].as_str()}/{e.name.as_str()}",
                            ),
                        )
                    },
                }
            }
        }
    }
    Ok(out)
}

/// The bytes `data` holds, as one run: in the answer itself, or in a blob, read whole and then
/// given back (`toolkit::whole::data_bytes`).
pub fn data_bytes(data: take Data) -> Result<Vec<u8>, ToolError> {
    let chunks = toolkit::whole::data_bytes(take data).map_err(|e| said("a blob", e))?
    Ok(joined(take chunks))
}

/// Gives each blob back, all at once.
pub fn release_blobs(blobs: [Blob]) {
    var calls: Vec<Call<Done>> = Vec::new()
    for b in blobs {
        calls.push(blob::release(b))
    }
    for _ in 0..blobs.len() {
        let _ = calls.remove(0).wait()
    }
}

/// Removes everything in the directory `dir` (a root path in a write root), leaving it empty.
pub fn empty(dir: str) -> Result<(), ToolError> {
    let entries = files::list(dir).wait().map_err(|e| said(dir, e))?
    var removes: Vec<Call<Done>> = Vec::new()
    var names: Vec<String> = Vec::new()
    for e in entries {
        let path = String::from(f"{dir}/{e.name.as_str()}")
        if e.kind == Kind::Dir {
            removes.push(files::remove_all(path.as_str()))
        } else {
            removes.push(files::remove(path.as_str()))
        }
        names.push(take path)
    }
    let _ = waited(take removes, names)?
    Ok(())
}
