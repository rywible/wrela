// The release's requests, a batch at a time: files read, copied and written whole through blobs,
// and directories walked. Each is a job that waits for its answers (`toolkit::wait`); at most
// `AT_ONCE` of a batch's requests are outstanding at once, so a release of hundreds of files keeps
// the host's file workers busy without holding every file at once.

use std::io::Pending
use std::tool::{MOST_BYTES, answer}
use std::tool::blob
use std::tool::blob::{Blob, Data}
use std::tool::files
use std::tool::files::Kind
use toolkit::wait::{Waits, done, wait, wait_all}
use toolkit::whole::{joined, write_file}

/// How many requests of a batch are outstanding at once.
pub const AT_ONCE: u32 = 32

/// Each answer of `w`'s bytes, or why the first that failed did, said with `what` and its index.
fn answers(w: mut Waits, what: [String]) -> Result<Vec<Vec<u8>>, String> {
    var out: Vec<Vec<u8>> = Vec::new()
    for k in 0..w.len() {
        match answer(w.polled(k)) {
            Ok(b) => out.push(take b),
            Err(e) => return Err(String::from(f"{what[k].as_str()}: {e.message()}")),
        }
    }
    Ok(out)
}

/// Each answer of `w` read as a blob's handle, or why the first that failed did, said with `what`
/// and its index.
fn handles(w: mut Waits, what: [String]) -> Result<Vec<Blob>, String> {
    var out: Vec<Blob> = Vec::new()
    for k in 0..w.len() {
        match blob::read_handle(w.polled(k)) {
            Ok(b) => out.push(b),
            Err(e) => return Err(String::from(f"{what[k].as_str()}: {e.message()}")),
        }
    }
    Ok(out)
}

/// The blob handle of each file at `paths` (root paths), opened at once.
@job
fn opened(paths: take Vec<String>) -> Result<Vec<Blob>, String> {
    var ps: Vec<Pending<u8>> = Vec::new()
    for p in paths {
        ps.push(files::read_blob(p.as_str()))
    }
    var w = wait_all(take ps)
    while !w.ready() { yield }
    handles(mut w, paths)
}

/// The whole of each file at `paths` (root paths), in order.
@job
pub fn read_files(given: take Vec<String>) -> Result<Vec<Vec<u8>>, String> {
    let paths = take given
    var out: Vec<Vec<u8>> = Vec::new()
    var at = 0
    while at < paths.len() {
        let n = min(AT_ONCE, paths.len() - at)
        var names: Vec<String> = Vec::new()
        for k in 0..n {
            names.push(paths[at + k].clone())
        }
        var jo = Box::new(opened.start(names.clone()))
        var o = done(jo.get_mut().resume())
        while o.is_none() {
            yield
            o = done(jo.get_mut().resume())
        }
        let blobs = (take o).unwrap()?
        // Their lengths, then their chunks, then the blobs given back.
        var ls: Vec<Pending<u8>> = Vec::new()
        for b in blobs {
            ls.push(blob::len(b))
        }
        var lens = wait_all(take ls)
        while !lens.ready() { yield }
        var chunks: Vec<Pending<u8>> = Vec::new()
        var whose: Vec<String> = Vec::new()
        var counts: Vec<u32> = Vec::new()
        for k in 0..n {
            let size = match blob::read_len(lens.polled(k)) {
                Ok(s) => s,
                Err(e) => return Err(String::from(f"{names[k].as_str()}: {e.message()}")),
            }
            let c = u32((size + u64(MOST_BYTES) - 1) / u64(MOST_BYTES))
            counts.push(c)
            for i in 0..c {
                chunks.push(blob::read(blobs[k], u64(i) * u64(MOST_BYTES), MOST_BYTES))
                whose.push(names[k].clone())
            }
        }
        var parts = wait_all(take chunks)
        while !parts.ready() { yield }
        var jr = Box::new(release_blobs.start(take blobs))
        while done(jr.get_mut().resume()).is_none() { yield }
        var bytes = answers(mut parts, whose)?
        var c = 0
        for k in 0..n {
            var whole: Vec<u8> = Vec::new()
            for _ in 0..counts[k] {
                whole.append(mut bytes[c])
                c += 1
            }
            out.push(take whole)
        }
        at += n
    }
    Ok(out)
}

/// Copies each file `from` to `to` (root paths, `to` in a write root), whole, through a blob.
@job
pub fn copy_files(given: take Vec<(String, String)>) -> Result<(), String> {
    let pairs = take given
    var at = 0
    while at < pairs.len() {
        let n = min(AT_ONCE, pairs.len() - at)
        var names: Vec<String> = Vec::new()
        var targets: Vec<String> = Vec::new()
        for k in 0..n {
            names.push(pairs[at + k].0.clone())
            targets.push(pairs[at + k].1.clone())
        }
        var jo = Box::new(opened.start(take names))
        var o = done(jo.get_mut().resume())
        while o.is_none() {
            yield
            o = done(jo.get_mut().resume())
        }
        let blobs = (take o).unwrap()?
        var ws: Vec<Pending<u8>> = Vec::new()
        for k in 0..n {
            ws.push(files::write_blob(targets[k].as_str(), blobs[k]))
        }
        var written = wait_all(take ws)
        while !written.ready() { yield }
        var jr = Box::new(release_blobs.start(take blobs))
        while done(jr.get_mut().resume()).is_none() { yield }
        let _ = answers(mut written, targets)?
        at += n
    }
    Ok(())
}

/// Writes each file's bytes as the whole file at its path (a root path in a write root): at
/// once, or through a blob if they're more than a request carries.
@job
pub fn write_files(given: take Vec<(String, Vec<u8>)>) -> Result<(), String> {
    var items = take given
    var at = 0
    while at < items.len() {
        let n = min(AT_ONCE, items.len() - at)
        var names: Vec<String> = Vec::new()
        // The small files at once; each large one through a blob of its own (`write_file`).
        var ps: Vec<Pending<u8>> = Vec::new()
        var large: Vec<u32> = Vec::new()
        for k in 0..n {
            if items[at + k].1.len() <= MOST_BYTES {
                names.push(items[at + k].0.clone())
                ps.push(files::write(items[at + k].0.as_str(), items[at + k].1))
            } else {
                large.push(at + k)
            }
        }
        var w = wait_all(take ps)
        while !w.ready() { yield }
        let _ = answers(mut w, names)?
        for index in large {
            let path = items[index].0.clone()
            let bytes = replace(mut items[index].1, Vec::new())
            var j = Box::new(write_file.start(path.clone(), Vec::from([take bytes])))
            var r = done(j.get_mut().resume())
            while r.is_none() {
                yield
                r = done(j.get_mut().resume())
            }
            if let Err(e) = (take r).unwrap() {
                return Err(String::from(f"{path.as_str()}: {e.as_str()}"))
            }
        }
        at += n
    }
    Ok(())
}

/// The files under the directory `dir` (a root path), each by its path there, in no order. A
/// symbolic link, or anything but a file or a directory, is refused.
@job
pub fn walk(dir: take String) -> Result<Vec<String>, String> {
    var out: Vec<String> = Vec::new()
    // Directories still to list, each by its path from `dir` ("" for `dir` itself).
    var todo: Vec<String> = Vec::from([String::new()])
    while !todo.is_empty() {
        let n = min(AT_ONCE, todo.len())
        let batch = todo.drain_front(n)
        var names: Vec<String> = Vec::new()
        var ps: Vec<Pending<u8>> = Vec::new()
        for rel in batch {
            let path = if rel.is_empty() {
                dir.clone()
            } else {
                String::from(f"{dir.as_str()}/{rel.as_str()}")
            }
            ps.push(files::list(path.as_str()))
            names.push(take path)
        }
        var got = wait_all(take ps)
        while !got.ready() { yield }
        for k in 0..n {
            let entries = match files::read_list(got.polled(k)) {
                Ok(e) => take e,
                Err(e) => return Err(String::from(f"{names[k].as_str()}: {e.message()}")),
            }
            for e in entries {
                let rel = if batch[k].is_empty() {
                    e.name.clone()
                } else {
                    String::from(f"{batch[k].as_str()}/{e.name.as_str()}")
                }
                match e.kind {
                    Kind::File => out.push(take rel),
                    Kind::Dir => todo.push(take rel),
                    Kind::Link => {
                        return Err(
                            String::from(
                                f"release assets cannot be symbolic links: {names[k].as_str()}/{e.name.as_str()}",
                            ),
                        )
                    },
                    Kind::Other => {
                        return Err(
                            String::from(
                                f"not a file or a directory: {names[k].as_str()}/{e.name.as_str()}",
                            ),
                        )
                    },
                }
            }
        }
    }
    Ok(out)
}

/// The bytes `data` holds, as one run: in the answer itself, or in a blob, read whole and then
/// given back (`toolkit::whole::data_bytes`).
@job
pub fn data_bytes(data: take Data) -> Result<Vec<u8>, String> {
    var j = Box::new(toolkit::whole::data_bytes.start(take data))
    var r = done(j.get_mut().resume())
    while r.is_none() {
        yield
        r = done(j.get_mut().resume())
    }
    match (take r).unwrap() {
        Ok(chunks) => Ok(joined(take chunks)),
        Err(e) => Err(String::from(f"a blob: {e.as_str()}")),
    }
}

/// Gives each blob back.
@job
pub fn release_blobs(given: take Vec<Blob>) -> u32 {
    let blobs = take given
    var rs: Vec<Pending<u8>> = Vec::new()
    for b in blobs {
        rs.push(blob::release(b))
    }
    var w = wait_all(take rs)
    while !w.ready() { yield }
    0
}

/// Removes everything in the directory `dir` (a root path in a write root), leaving it empty.
@job
pub fn empty(dir: take String) -> Result<(), String> {
    var l = wait(files::list(dir.as_str()))
    while !l.ready() { yield }
    let entries = match files::read_list(l.polled()) {
        Ok(e) => take e,
        Err(e) => return Err(String::from(f"{dir.as_str()}: {e.message()}")),
    }
    var rs: Vec<Pending<u8>> = Vec::new()
    var names: Vec<String> = Vec::new()
    for e in entries {
        let path = String::from(f"{dir.as_str()}/{e.name.as_str()}")
        if e.kind == Kind::Dir {
            rs.push(files::remove_all(path.as_str()))
        } else {
            rs.push(files::remove(path.as_str()))
        }
        names.push(take path)
    }
    var removed = wait_all(take rs)
    while !removed.ready() { yield }
    let _ = answers(mut removed, names)?
    Ok(())
}
