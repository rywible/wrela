// The release tool's tests: the catalog's checks, the fingerprint's framing, each Worker's
// headers, redirects, configuration and lists, the console's server's Worker, the docs' page and plain pages (their Markdown,
// anchors and links), and, as tool tests on small fixtures, the walk of a package's dependencies
// for its font licences and the members of a workspace.

use addresses::{address, payloads, runtime_hash}
use catalog::{
    Build, CATALOG, Catalog, Console, Docs, Game, attract_build, check, is_component, origin, paths,
}
use io::read_files
use main::{
    BUILD_TIMEOUT, build_options, export_conflict, licences, parse_args, served, workspace_of,
}
use manifest::{joined, parse}
use pages::{Page, cells, in_order, page_html, render}
use site::{
    Shipped, Top, api_config, api_script, card, ico, catalog_json, catalog_line, code_of,
    docs_headers, docs_page, docs_redirects, early_hints, fetch_order, headers, prefetch_list,
    preloads, release_json, replace_all, suffix, with_storage, wrangler_config,
}
use std::hash::sha256::{Sha256, hex}
use tree::{Entry, Source, Tree, before_by_parts, check_files, files_json, frame}

fn contains(haystack: str, needle: str) -> bool {
    haystack.find(needle).is_some()
}

// ---- The catalog -------------------------------------------------------------------------------

fn one_game(
    session: Text,
    build: Text,
    domain: Text,
    description: Text,
    console_domain: Text,
) -> Catalog {
    Catalog {
        console: Console {
            dir: "console",
            worker: "console-host",
            domain: console_domain,
            description,
            api: "api-host",
            zone: console_domain,
            api_from: "",
            boards: "capybara",
            board: 3,
        },
        docs: Docs {
            dir: "docsite",
            worker: "docs-host",
            domain: "docs.example",
            description: "The reference.",
            packages: Vec::from(["engine"]),
        },
        games: Vec::from(
            [
                Game {
                    id: "game",
                    title: "Game",
                    worker: "game-host",
                    domain,
                    session,
                    builds: Vec::from([Build { name: build, dir: "session" }]),
                    attract: "",
                    cover: "cover.png",
                    hero: "",
                    logo: "",
                    tagline: "",
                    theme: "",
                },
            ],
        ),
    }
}

fn fails_with(c: Catalog, why: str) {
    match check(c) {
        Ok(_) => panic(f"passed, but should fail with `{why}`"),
        Err(e) => assert(contains(e.as_str(), why), e.as_str()),
    }
}

@test
fn the_released_catalog_passes_its_checks() {
    assert(check(CATALOG).is_ok())
    // Each package's manifest and each cover must be in the workspace.
    let wanted = paths(CATALOG)
    var covers = 0
    for (path, why) in wanted {
        if path.as_str().ends_with("cover.png") {
            covers += 1
            assert(contains(why.as_str(), "cover"), why.as_str())
        }
    }
    assert(covers == CATALOG.games.len())
}

@test
fn a_tagline_is_one_short_line_and_named_art_must_be_there() {
    var c = one_game("session", "session", "game.example", "A console.", "console.example")
    c.games[0].tagline = "A day at the zoo"
    c.games[0].hero = "games/game/hero.png"
    assert(check(c).is_ok())
    var named = 0
    for (path, why) in paths(c) {
        if path.as_str() == "games/game/hero.png" {
            named += 1
            assert(contains(why.as_str(), "hero"), why.as_str())
        }
    }
    assert(named == 1, "a named hero must be in the workspace")
    for bad in ["two\nlines", "a\ttab"] {
        c.games[0].tagline = bad
        fails_with(c.clone(), "tagline")
    }
}

@test
fn build_names_cannot_collide_with_release_directories() {
    fails_with(
        one_game("releases", "releases", "game.example", "A console.", "console.example"),
        "reserved",
    )
    assert(
        check(
            one_game("session", "session", "game.example", "A console.", "console.example"),
        ).is_ok(),
    )
    fails_with(one_game("session", "session", "game.example", "", "console.example"), "description")
    fails_with(
        one_game("session", "session", "www.example", "A console.", "console.example"),
        "own hosts",
    )
    fails_with(
        one_game("session", "session", "console.example", "A console.", "console.example"),
        "shares",
    )
    fails_with(
        one_game("session", "other", "game.example", "A console.", "console.example"),
        "session",
    )
}

@test
fn the_attract_address_is_one_of_the_games_own_builds_and_a_plain_fragment() {
    var c = one_game("session", "session", "game.example", "A console.", "console.example")
    c.games[0].builds.push(Build { name: "floor", dir: "game" })
    for good in ["floor", "floor#attract", "floor#attract-2"] {
        c.games[0].attract = good
        assert(check(c.clone()).is_ok(), good)
    }
    for bad in ["missing", "missing#attract", "session", "session#attract"] {
        c.games[0].attract = bad
        fails_with(c.clone(), "attract build")
    }
    // The fragment a token, which a host opens: not empty, no query or second fragment, nothing
    // that asks for test mode.
    for bad in ["floor#", "floor#Attract", "floor#a&b", "floor#a?b", "floor#a#b", "floor#test"] {
        c.games[0].attract = bad
        fails_with(c.clone(), "attract fragment")
    }
    c.games[0].attract = ""
    assert(check(c).is_ok(), "a game with none")
    // The released capybara plays itself in its play build, opened at `#attract`: no build of its
    // own.
    borrow capybara = CATALOG.games[0]
    assert(capybara.attract == "capybara#attract", capybara.attract)
    assert(capybara.builds.len() == 2, "the session and the play build")
    var found = false
    for b in capybara.builds {
        if b.name == attract_build(capybara.attract) {
            found = true
            assert(b.dir == "games/capybara")
        }
    }
    assert(found, "the capybara plays itself in one of its builds")
    assert(build_options().set.is_empty() && build_options().optimize)
    // The fingerprint holds it: another attract address, another release.
    let fingerprint = json::compact(catalog_json(CATALOG))
    assert(
        contains(fingerprint.as_str(), "\"attract\": \"capybara#attract\""),
        fingerprint.as_str(),
    )
    assert(contains(fingerprint.as_str(), "\"session\": \"games/capybara/session\""))
}

@test
fn the_consoles_server_has_a_worker_of_its_own_in_the_consoles_zone() {
    var c = one_game("session", "session", "game.example", "A console.", "console.example")
    c.console.domain = "games.console.example"
    assert(check(c).is_ok(), "a domain under its zone")
    c.console.zone = "other.example"
    fails_with(c.clone(), "isn't in the zone")
    c.console.zone = "le.example"
    fails_with(c.clone(), "isn't in the zone")
    c.console.zone = "console.example"
    for taken in ["console-host", "game-host", "docs-host"] {
        c.console.api = taken
        fails_with(c.clone(), if taken == "console-host" { "of its own" } else { "share" })
    }
    c.console.api = "../api"
    fails_with(c.clone(), "invalid release component")
    // The Worker it ran in before is another, whose classes it takes over.
    c.console.api = "api-host"
    c.console.api_from = "console-host"
    assert(check(c).is_ok(), "the console's Worker")
    c.console.api_from = "api-host"
    fails_with(c.clone(), "its own classes")
    c.console.api_from = "a/b"
    fails_with(c.clone(), "invalid release component")
}

@test
fn domains_and_catalog_components_reject_header_and_path_injection() {
    for value in ["../game", "a/b", "name\nHeader: injected", "", "-a", "A"] {
        assert(!is_component(value), value)
    }
    assert(is_component("last-green") && is_component("a1"))
    for domain in [
        "example.com\nOther: value",
        "https://example.com",
        "a..example.com",
        "localhost",
        ".a.b",
        "a.b-",
    ] {
        assert(origin(domain).is_err(), domain)
    }
    let Ok(o) = origin("games.wrela.dev") else { panic("a domain") }
    assert(o.as_str() == "https://games.wrela.dev")
    let h = headers(
        "https://games.wrela.dev",
        Vec::from([String::from("https://one.games.wrela.dev")]),
        embedded: false,
    )
    assert(contains(h.as_str(), "cross-origin-isolated=(self \"https://one.games.wrela.dev\")"))
    assert(contains(h.as_str(), "frame-ancestors 'none'"))
    let none: [String; 0] = []
    let child = headers("https://games.wrela.dev", none, embedded: true)
    assert(contains(child.as_str(), "frame-ancestors https://games.wrela.dev"))
    assert(contains(child.as_str(), "Cross-Origin-Embedder-Policy: require-corp"))
    assert(contains(child.as_str(), "/*.wgsl\n  Content-Type: text/plain"))
}

@test
fn the_command_line_takes_a_revision() {
    let Some(r) = parse_args(
        Vec::from([String::from("--revision"), String::from("488edbe8")]),
    ) else {
        panic("a revision")
    }
    assert(r.as_str() == "488edbe8")
    assert(parse_args(Vec::from([String::from("--revision"), String::from("main")])).is_none())
    assert(parse_args(Vec::from([String::from("--revision")])).is_none())
    assert(parse_args(Vec::from([String::from("--output"), String::from("488edbe8")])).is_none())
}

@test
fn released_builds_are_optimized() {
    assert(build_options().optimize)
    assert(build_options().timeout == BUILD_TIMEOUT)
}

// ---- The fingerprint ---------------------------------------------------------------------------

fn digest_of(files: [(Text, Text)]) -> String {
    var d = Sha256::new()
    for (path, body) in files {
        let b = String::from(body)
        frame(mut d, path, u64(b.len()))
        d.update(b.as_bytes())
    }
    hex(d.finish())
}

@test
fn the_release_identity_distinguishes_file_paths_from_their_contents() {
    let a = digest_of([("a", "bc")])
    let b = digest_of([("ab", "c")])
    let again = digest_of([("a", "bc")])
    assert(a.as_str() != b.as_str())
    assert(a.as_str() == again.as_str())
    // A frame is the path's length, the path and the body's length, each length 8 bytes, the
    // most significant first.
    var d = Sha256::new()
    frame(mut d, "a", 2)
    var e = Sha256::new()
    e.update([u8(0), 0, 0, 0, 0, 0, 0, 1, 97, 0, 0, 0, 0, 0, 0, 0, 2])
    assert(hex(d.finish()).as_str() == hex(e.finish()).as_str())
}

@test
fn files_are_read_in_the_order_of_their_paths_parts() {
    assert(before_by_parts("x/y", "x-y"))
    assert(before_by_parts("x", "x/y"))
    assert(before_by_parts("a/c", "ab/c"))
    assert(!before_by_parts("b", "a/z"))
    var t = Tree::new()
    for p in ["x-y", "x/y", "x", "a.txt"] {
        t.put_bytes(p, String::from(p).as_bytes())
    }
    t.sort()
    let want = ["a.txt", "x", "x/y", "x-y"]
    for k in 0..4 {
        assert(t.entries[k].path.as_str() == want[k], t.entries[k].path.as_str())
    }
}

@test
fn private_storage_and_hidden_files_cannot_be_uploaded() {
    var t = Tree::new()
    t.put_bytes("game.wasm", String::from("wasm").as_bytes())
    assert(check_files(t.entries).is_ok())
    t.put_bytes("storage/save", String::from("private").as_bytes())
    let Err(e) = check_files(t.entries) else { panic("private storage") }
    assert(contains(e.as_str(), "private"), e.as_str())
    t.remove("storage/save")
    t.put_bytes("a/.native/x", String::from("cache").as_bytes())
    assert(check_files(t.entries).is_err(), "runtime output")
    t.remove("a/.native/x")
    t.put_bytes(".wrela-build", String::from("[]").as_bytes())
    let Err(h) = check_files(t.entries) else { panic("hidden") }
    assert(contains(h.as_str(), "hidden"), h.as_str())
}

@test
fn each_release_lists_its_files_for_a_later_deploy_to_keep() {
    var t = Tree::new()
    t.put_bytes("session/game.wasm", String::from("wasm").as_bytes())
    t.put_bytes("LICENSE", String::from("MIT").as_bytes())
    let listed = files_json(t.entries)
    let wasm = tree::hex_sha(String::from("wasm").as_bytes())
    let mit = tree::hex_sha(String::from("MIT").as_bytes())
    assert(
        listed.as_str() ==
            f"{{\"LICENSE\": \"{mit.as_str()}\", \"session/game.wasm\": \"{wasm.as_str()}\"}}",
        listed.as_str(),
    )
    var empty = Tree::new()
    assert(files_json(empty.entries).as_str() == "{}")
    let (count, bytes) = t.totals()
    assert(count == 2 && bytes == 7)
    empty.put("x", Source::File(String::from("work/x")))
    assert(empty.entries[0].sha.is_empty(), "a file's hash is read with it")
}

// ---- Each Worker -------------------------------------------------------------------------------

@test
fn every_bootstrap_has_its_storage_namespace() {
    let page = with_storage("<html><head><title>wrela</title></head></html>", "console")
    assert(
        page.as_str() ==
            "<html><head>\n<meta name=\"wrela-storage\" content=\"console\"><title>wrela</title></head></html>",
    )
    assert(replace_all("a·<b>·<b>", "<b>", "c").as_str() == "a·c·c")
}

@test
fn each_worker_serves_its_assets_on_its_domain_only() {
    // Assets alone, with no script that a request it doesn't match would run.
    let w = wrangler_config("game-host", "game.example")
    assert(
        w.as_str() ==
            "{\n  \"name\": \"game-host\",\n  \"compatibility_date\": \"2026-10-12\",\n  \"assets\": {\n    \"directory\": \"./game-host\",\n    \"not_found_handling\": \"404-page\"\n  },\n  \"routes\": [\n    {\n      \"pattern\": \"game.example\",\n      \"custom_domain\": true\n    }\n  ],\n  \"workers_dev\": false,\n  \"preview_urls\": false\n}\n",
        w.as_str(),
    )
    var reports: Vec<site::Report> = Vec::new()
    reports.push(
        site::Report {
            worker: String::from("console-host"),
            domain: String::from("console.example"),
            console: true,
            docs: false,
            files: 3,
            bytes: 12,
        },
    )
    let verifier = site::Verifier {
        path: site::verifier_path("capybara", 3, "ab12"),
        files: Vec::from([String::from("cloudflare.js"), String::from("verifier.json")]),
    }
    let r = release_json("abc1234", "0123456789abcdef0123", "api-host", verifier, reports)
    assert(
        contains(
            r.as_str(),
            "{\n  \"source\": \"abc1234\",\n  \"release\": \"0123456789abcdef0123\",\n  \"api\": \"api-host\",\n  \"verifier\": {\n    \"path\": \"verifiers/capybara/3/ab12\",\n    \"files\": [\n      \"cloudflare.js\",\n      \"verifier.json\"\n    ]\n  },\n  \"workers\": [\n    {\n      \"worker\": \"console-host\",",
        ),
        r.as_str(),
    )
    assert(
        contains(
            r.as_str(),
            "\"console\": true,\n      \"docs\": false,\n      \"files\": 3,\n      \"bytes\": 12\n    }\n  ]\n}",
        ),
    )
}

/// Each Worker's favicon holds each PNG as it is, after a header and an entry for each that says
/// its size, its length and where it starts.
@test
fn a_favicon_holds_each_icon_as_its_png() {
    let small = Vec::from(String::from("PNG-16").as_bytes())
    let large = Vec::from(String::from("PNG-of-32").as_bytes())
    let f = ico([(small.clone(), 16), (large.clone(), 32)])
    assert(f.len() == 6 + 2 * 16 + small.len() + large.len(), f"{f.len()} bytes")
    // Reserved, an icon, two images.
    assert(f[0] == 0 && f[1] == 0 && f[2] == 1 && f[3] == 0 && f[4] == 2 && f[5] == 0)
    let word = |at: u32| -> u32 {
        u32(f[at]) | (u32(f[at + 1]) << 8) | (u32(f[at + 2]) << 16) | (u32(f[at + 3]) << 24)
    }
    for (k, png, size) in [(0, small.clone(), 16), (1, large.clone(), 32)] {
        let e = 6 + 16 * k
        assert(u32(f[e]) == size && u32(f[e + 1]) == size, "its size")
        assert(f[e + 4] == 1 && f[e + 6] == 32, "a plane, 32 bits")
        assert(word(e + 8) == png.len(), "its length")
        let at = word(e + 12)
        for i in 0..png.len() {
            assert(f[at + i] == png[i], "its PNG")
        }
    }
}

@test
fn the_console_may_fetch_its_games_files_and_shows_a_card_where_shared() {
    let policy = headers(
        "https://console.example",
        Vec::from([String::from("https://game.example")]),
        embedded: false,
    )
    assert(contains(policy.as_str(), "connect-src 'self' https://game.example;"))
    assert(!contains(policy.as_str(), "Access-Control-Allow-Origin"))
    let none: [String; 0] = []
    let game = headers("https://console.example", none, embedded: true)
    assert(contains(game.as_str(), "connect-src 'self';"))
    assert(contains(game.as_str(), "Access-Control-Allow-Origin: https://console.example\n"))
    assert(contains(game.as_str(), "Access-Control-Allow-Credentials: true\n"))
    let console = Console {
        dir: "console",
        worker: "console-host",
        domain: "console.example",
        description: "Games & <more>",
        api: "api-host",
        zone: "console.example",
        api_from: "",
        boards: "capybara",
        board: 3,
    }
    let c = card(console, "R", "cover-0123456789abcdef.webp")
    assert(contains(c.as_str(), "<meta name=\"description\" content=\"Games &amp; &lt;more&gt;\">"))
    assert(contains(c.as_str(), "<meta property=\"og:url\" content=\"https://console.example/\">"))
    assert(
        contains(
            c.as_str(),
            "<meta property=\"og:image\" content=\"https://console.example/releases/R/cover-0123456789abcdef.webp\">",
        ),
    )
}

@test
fn the_console_prefetches_a_games_runtime_and_wasm_from_its_origin() {
    let game = Game {
        id: "game",
        title: "Game",
        worker: "game-host",
        domain: "game.example",
        session: "session",
        builds: Vec::from(
            [
                Build { name: "floor", dir: "floor" },
                Build { name: "session", dir: "session" },
            ],
        ),
        attract: "floor#attract",
        cover: "cover.png",
        hero: "hero.png",
        logo: "",
        tagline: "A line that sells it",
        theme: "theme.txt",
    }
    let order = fetch_order(game)
    assert(order.len() == 2 && order[0] == "session" && order[1] == "floor")
    // Each file by its path in its build, and its content address if it moved there: the
    // session's and the floor's runtime is one set, fetched once.
    let at = |path: Text, url: Text| (String::from(path), String::from(url))
    var builds: Vec<(Text, Vec<(String, String)>)> = Vec::new()
    builds.push(
        (
            "session",
            Vec::from(
                [
                    at("addresses.json", ""),
                    at("files/tile.bin", "/b/1111.bin"),
                    at("game.lines", "/b/2222.lines"),
                    at("game.wasm", "/b/3333.wasm"),
                    at("index.html", ""),
                    at("main.js", "/r/4444/main.js"),
                    at("manifest.json", ""),
                ],
            ),
        ),
    )
    builds.push(("floor", Vec::from([at("main.js", "/r/4444/main.js"), at("net.json", "")])))
    let list = prefetch_list(game, "R", builds)
    assert(
        list.as_str() ==
            "https://game.example/releases/R/session/addresses.json\nhttps://game.example/b/3333.wasm\nhttps://game.example/r/4444/main.js\nhttps://game.example/releases/R/session/manifest.json\nhttps://game.example/releases/R/floor/net.json\n",
        list.as_str(),
    )
    let shipped = |name: Text, width: u32, height: u32| Shipped {
        name: String::from(name),
        width,
        height,
    }
    let line = catalog_line(
        game,
        "R",
        shipped("cover-0123456789abcdef.webp", 960, 540),
        shipped("hero-0123456789abcdef.webp", 1920, 1080),
        shipped("", 0, 0),
        "theme-0123456789abcdef.txt",
    )
    assert(
        line.as_str() ==
            "game\tGame\thttps://game.example/releases/R/session/\tcover-0123456789abcdef.webp\t960\t540\thero-0123456789abcdef.webp\t1920\t1080\t\t0\t0\tA line that sells it\ttheme-0123456789abcdef.txt\thttps://game.example/releases/R/floor/#attract",
        line.as_str(),
    )
    // A game with no build that plays itself leaves its last column empty.
    var still = game.clone()
    still.attract = ""
    let none = catalog_line(
        still,
        "R",
        shipped("cover-0123456789abcdef.webp", 960, 540),
        shipped("", 0, 0),
        shipped("", 0, 0),
        "",
    )
    assert(none.as_str().ends_with("\tA line that sells it\t\t"), none.as_str())
    assert(none.as_str().split("\t").len() == 15, none.as_str())
}

// ---- Content addresses -------------------------------------------------------------------------

/// The page a build's bootstrap is, as toolchain 0.17.0 writes it: its preloads and its script.
const PAGE: Text = "<html><head>\n<link rel=\"preload\" href=\"manifest.json\" as=\"fetch\" crossorigin>\n<link rel=\"preload\" href=\"game.wasm\" as=\"fetch\" crossorigin>\n<link rel=\"preload\" href=\"pipeline_0.wgsl\" as=\"fetch\" crossorigin>\n<link rel=\"icon\" href=\"files/icons/icon-16.png\">\n</head><body><script type=\"module\" src=\"main.js\"></script></body></html>"

const MANIFEST: Text = "{\"wasm\": \"game.wasm\", \"wasm_relaxed\": \"game.relaxed.wasm\", \"pipelines\": [{\"shader\": \"pipeline_0.wgsl\"}, {\"shader\": \"pipeline_0.wgsl\"}]}"

/// A build at `dir` in `t`, whose WASM is `wasm`: its files, each as bytes (so read).
fn build_in(t: mut Tree, dir: Text, wasm: Text) -> addresses::Build {
    let files = [
        ("index.html", String::from(PAGE)),
        ("manifest.json", String::from(MANIFEST)),
        ("net.json", String::from("{}")),
        ("game.wasm", String::from(wasm)),
        ("game.lines", String::from(f"lines of {wasm}")),
        ("game.relaxed.wasm", String::from(f"relaxed {wasm}")),
        ("pipeline_0.wgsl", String::from("shader")),
        ("main.js", String::from("main")),
        ("worker.js", String::from("worker")),
        ("worklet.js", String::from("worklet")),
        ("files/floor/t1.bin", String::from("tile")),
        ("files/icons/icon-16.png", String::from("icon")),
    ]
    var names: Vec<String> = Vec::new()
    for (path, body) in files {
        t.put_bytes(addresses::in_dir(dir, path).as_str(), body.as_bytes())
        names.push(String::from(path))
    }
    addresses::Build { dir: String::from(dir), files: names, manifest: String::from(MANIFEST) }
}

fn sha_of(body: Text) -> String {
    tree::hex_sha(String::from(body).as_bytes())
}

@test
fn a_builds_payloads_and_runtime_move_to_their_content_addresses() {
    var t = Tree::new()
    let b = build_in(mut t, "session", "wasm")
    let Ok(listed) = payloads(b) else { panic("payloads") }
    var names = String::new()
    for p in listed {
        names.push_str(f"{p.as_str()} ")
    }
    // The manifest's modules and shader (once), the modules' trap locations it has, and the
    // streamed files, but not the icons the page links.
    assert(
        names.as_str() ==
            "files/floor/t1.bin game.lines game.relaxed.wasm game.wasm pipeline_0.wgsl ",
        names.as_str(),
    )
    let moved = match address(mut t, [b.clone()]) {
        Ok(m) => take m,
        Err(e) => panic(e.as_str()),
    }
    let set = runtime_hash(
        [
            (String::from("main.js"), sha_of("main")),
            (String::from("worker.js"), sha_of("worker")),
            (String::from("worklet.js"), sha_of("worklet")),
        ],
    )
    let wasm = String::from(f"/b/{sha_of("wasm").as_str()}.wasm")
    let shader = String::from(f"/b/{sha_of("shader").as_str()}.wgsl")
    // Its map: each payload's path and URL.
    let Some(k) = t.find("session/addresses.json") else { panic("no addresses.json") }
    let Source::Bytes(map) = t.entries[k].source else { panic("bytes") }
    let Some(m) = String::from_utf8(map.clone()) else { panic("UTF-8") }
    assert(
        m.as_str() ==
            f"{{\"files\": {{\"files/floor/t1.bin\": \"/b/{sha_of("tile").as_str()}.bin\", \"game.lines\": \"/b/{sha_of("lines of wasm").as_str()}.lines\", \"game.relaxed.wasm\": \"/b/{sha_of("relaxed wasm").as_str()}.wasm\", \"game.wasm\": \"{wasm.as_str()}\", \"pipeline_0.wgsl\": \"{shader.as_str()}\"}}, \"format\": \"wrela-addresses-1\"}}",
        m.as_str(),
    )
    // Its page preloads them there and runs its runtime from its set; the manifest stays.
    let Some(pk) = t.find("session/index.html") else { panic("no page") }
    let Source::Bytes(page) = t.entries[pk].source else { panic("bytes") }
    let Some(p) = String::from_utf8(page.clone()) else { panic("UTF-8") }
    assert(contains(p.as_str(), f"href=\"{wasm.as_str()}\" as=\"fetch\""), p.as_str())
    assert(contains(p.as_str(), f"href=\"{shader.as_str()}\" as=\"fetch\""), p.as_str())
    assert(contains(p.as_str(), "href=\"manifest.json\" as=\"fetch\""), p.as_str())
    assert(contains(p.as_str(), "href=\"files/icons/icon-16.png\""), p.as_str())
    assert(contains(p.as_str(), f"src=\"/r/{set.as_str()}/main.js\""), p.as_str())
    // Nothing moved stays in the build; its page, manifest, net.json and icons do.
    for gone in [
        "game.wasm",
        "game.lines",
        "pipeline_0.wgsl",
        "main.js",
        "worklet.js",
        "files/floor/t1.bin",
    ] {
        assert(t.find(addresses::in_dir("session", gone).as_str()).is_none(), gone)
    }
    for kept in ["index.html", "manifest.json", "net.json", "files/icons/icon-16.png"] {
        assert(t.find(addresses::in_dir("session", kept).as_str()).is_some(), kept)
    }
    // Each moved file once at its address, by its bytes.
    assert(moved.files.len() == 8, f"{moved.files.len()} files")
    assert(moved.urls.len() == 8, f"{moved.urls.len()} moved")
    var shared = String::new()
    for f in moved.files {
        shared.push_str(f"{f.path.as_str()} ")
    }
    assert(contains(shared.as_str(), f"b/{sha_of("wasm").as_str()}.wasm "), shared.as_str())
    assert(contains(shared.as_str(), f"r/{set.as_str()}/worklet.js "), shared.as_str())
}

@test
fn a_build_that_names_a_file_it_lacks_or_has_its_own_map_is_refused() {
    var t = Tree::new()
    var b = build_in(mut t, "", "wasm")
    b.manifest = String::from("{\"wasm\": \"other.wasm\", \"pipelines\": []}")
    match address(mut t, [b.clone()]) {
        Ok(_) => panic("addressed"),
        Err(e) => assert(contains(e.as_str(), "other.wasm, which it doesn't have"), e.as_str()),
    }
    b.manifest = String::from(MANIFEST)
    t.put_bytes("addresses.json", String::from("{}").as_bytes())
    match address(mut t, [take b]) {
        Ok(_) => panic("addressed"),
        Err(e) => assert(contains(e.as_str(), "of its own"), e.as_str()),
    }
}

/// A Worker as a release serves it, with `release`'s own `catalog.tsv` (`docs`, which only a
/// change to the docs changes), its builds at `dirs`: what moved, and the files.
fn worker_of(dirs: [Text], release: Text, docs: Text) -> Tree {
    var t = Tree::new()
    var builds: Vec<addresses::Build> = Vec::new()
    for d in dirs {
        builds.push(build_in(mut t, d, "wasm"))
    }
    t.put_bytes("catalog.tsv", String::from(docs).as_bytes())
    t.put_bytes("_headers", String::from("/*\n  X-Content-Type-Options: nosniff\n").as_bytes())
    let moved = match address(mut t, builds) {
        Ok(m) => take m,
        Err(e) => panic(e.as_str()),
    }
    t.sort()
    // An entry page, as the release makes the console's from its page once it's addressed.
    var entry: Option<String> = None
    if let Some(k) = t.find("index.html") {
        let Source::Bytes(b) = t.entries[k].source else { panic("bytes") }
        let Some(page) = String::from_utf8(b.clone()) else { panic("UTF-8") }
        entry = Some(
            replace_all(page.as_str(), "<head>", f"<head>\n<base href=\"/releases/{release}/\">"),
        )
    }
    match served(t, moved, release, take entry, [u8(0)]) {
        Ok(s) => take s,
        Err(e) => panic(e.as_str()),
    }
}

fn shared_paths(t: Tree) -> String {
    var out = String::new()
    for e in t.entries {
        if e.path.as_str().starts_with("b/") || e.path.as_str().starts_with("r/") {
            out.push_str(f"{e.path.as_str()}={e.sha.as_str()} ")
        }
    }
    out
}

/// The plan's deploy-delta check (docs/plan-online-play.md, step 11): two releases that differ
/// only in the docs give the console and a game no new `/b/` or `/r/` URL; what's new is only
/// their own release's files.
@test
fn a_docs_only_change_gives_the_console_and_a_game_no_new_shared_url() {
    for dirs in [[""], ["session"]] {
        let before = worker_of(dirs, "aaaaaaaaaaaaaaaaaaaa", "docs at one commit")
        let after = worker_of(dirs, "bbbbbbbbbbbbbbbbbbbb", "docs at the next")
        assert(!shared_paths(after).is_empty(), "something moved")
        assert(
            shared_paths(before).as_str() == shared_paths(after).as_str(),
            shared_paths(after).as_str(),
        )
        for e in after.entries {
            let p = e.path.as_str()
            if before.find(p).is_none() {
                assert(p.starts_with("releases/bbbbbbbbbbbbbbbbbbbb/"), p)
            }
        }
    }
}

/// The plan's served-artifact check, as the release writes it: no release-relative copy of a
/// moved file, and each target of each `addresses.json` beside it; `files.json` lists both.
@test
fn a_served_worker_has_each_payload_once_at_its_address() {
    let r = "aaaaaaaaaaaaaaaaaaaa"
    let w = worker_of(["session", "floor"], r, "x")
    var maps = 0
    for e in w.entries {
        let p = e.path.as_str()
        if !p.ends_with("/addresses.json") {
            continue
        }
        maps += 1
        let Source::Bytes(b) = e.source else { panic("bytes") }
        let Some(text) = String::from_utf8(b.clone()) else { panic("UTF-8") }
        let Some(doc) = std::json::parse(text.as_str()) else { panic("JSON") }
        let dir = p.slice(0, p.len() - "addresses.json".len())
        let Some(format) = doc.get(std::json::TOP, "format") else { panic("format") }
        assert(doc.text(format) == Some(String::from("wrela-addresses-1")), "format")
        let Some(files) = doc.get(std::json::TOP, "files") else { panic("files") }
        for (path, n) in doc.members(files) {
            let Some(url) = doc.text(n) else { panic("a URL") }
            assert(url.as_str().starts_with("/b/"), url.as_str())
            assert(w.find(url.as_str().slice(1, url.len())).is_some(), url.as_str())
            assert(w.find(f"{dir}{path.as_str()}").is_none(), path.as_str())
        }
    }
    assert(maps == 2, f"{maps} maps")
    let Some(k) = w.find(f"releases/{r}/files.json") else { panic("files.json") }
    let Source::Bytes(listing) = w.entries[k].source else { panic("bytes") }
    let Some(l) = String::from_utf8(listing.clone()) else { panic("UTF-8") }
    assert(
        contains(
            l.as_str(),
            f"\"/b/{sha_of("wasm").as_str()}.wasm\": \"{sha_of("wasm").as_str()}\"",
        ),
        l.as_str(),
    )
    assert(contains(l.as_str(), "\"session/addresses.json\""), l.as_str())
    assert(!contains(l.as_str(), "\"session/game.wasm\""), l.as_str())
    // The two builds' one runtime and one WASM, each once.
    var wasms = 0
    for e in w.entries {
        if e.path.as_str().starts_with("b/") && e.path.as_str().ends_with(".wasm") {
            wasms += 1
        }
    }
    assert(wasms == 2, f"{wasms} modules: the standard and the relaxed")
    // Kept for a year, like a release's files.
    let Some(h) = w.find("_headers") else { panic("_headers") }
    let Source::Bytes(hb) = w.entries[h].source else { panic("bytes") }
    let Some(headers_text) = String::from_utf8(hb.clone()) else { panic("UTF-8") }
    assert(
        contains(
            headers_text.as_str(),
            "/b/*\n  Cache-Control: public, max-age=31536000, immutable\n",
        ),
    )
    assert(
        contains(
            headers_text.as_str(),
            "/r/*\n  Cache-Control: public, max-age=31536000, immutable\n",
        ),
    )
}

/// Each bootstrap page's preloads are `Link` headers for the path it's served at, for Early
/// Hints: a build's page at its directory, an entry page at `/` against its `<base>`.
@test
fn each_pages_preloads_are_its_link_headers() {
    let r = "aaaaaaaaaaaaaaaaaaaa"
    let wasm = String::from(f"/b/{sha_of("wasm").as_str()}.wasm")
    let shader = String::from(f"/b/{sha_of("shader").as_str()}.wgsl")
    for (dirs, path, base) in [
        ([""], String::from("/"), f"/releases/{r}/"),
        ([""], f"/releases/{r}/", f"/releases/{r}/"),
        (["session"], f"/releases/{r}/session/", f"/releases/{r}/session/"),
    ] {
        let w = worker_of(dirs, r, "x")
        let Some(h) = w.find("_headers") else { panic("_headers") }
        let Source::Bytes(hb) = w.entries[h].source else { panic("bytes") }
        let Some(text) = String::from_utf8(hb.clone()) else { panic("UTF-8") }
        let want = f"\n{path}\n  Link: <{base}manifest.json>; rel=preload; as=fetch; crossorigin\n  Link: <{wasm.as_str()}>; rel=preload; as=fetch; crossorigin\n  Link: <{shader.as_str()}>; rel=preload; as=fetch; crossorigin\n"
        assert(contains(text.as_str(), want), text.as_str())
        // Before the cache rules, which end it.
        assert(text.as_str().ends_with(site::CACHE_RULES), text.as_str())
    }
    // A preload is a `<link>` with both `rel="preload"` and `as="fetch"`.
    let found = preloads(
        "<link rel=\"preload\" href=\"a.wasm\" as=\"fetch\" crossorigin><link rel=\"icon\" href=\"i.png\"><link rel=\"preload\" href=\"f.woff2\" as=\"font\"><link as=\"fetch\" rel=\"preload\" href=\"/b/x.wgsl\">",
    )
    assert(found.len() == 2 && found[0].as_str() == "a.wasm" && found[1].as_str() == "/b/x.wgsl")
    let none: [String; 0] = []
    assert(early_hints("/", "/", none) == Ok(String::new()), "no preloads, no rule")
    for bad in [
        "https://other.example/a.wasm",
        "//other.example/a",
        "a>b",
        "a b",
        "../x.wasm",
        "a,b",
        "",
    ] {
        assert(early_hints("/", "/r/", [String::from(bad)]).is_err(), bad)
    }
}

// ---- The docs ----------------------------------------------------------------------------------

fn file(name: Text) -> Top {
    Top { name: String::from(name), dir: false, markdown: false }
}

fn dir(name: Text, markdown: bool) -> Top {
    Top { name: String::from(name), dir: true, markdown }
}

@test
fn the_docs_have_stable_addresses_for_agents() {
    let tops = [
        file("LICENSE"),
        file("OFL-Manrope.txt"),
        dir("files", markdown: false),
        file("index.json"),
        file("llms.txt"),
        file("manifest.json"),
        dir("std", markdown: true),
    ]
    let r = docs_redirects(tops, "R")
    assert(
        r.as_str() ==
            "/OFL-Manrope.txt /releases/R/OFL-Manrope.txt 302\n/index.json /releases/R/index.json 302\n/llms.txt /releases/R/llms.txt 302\n/std/* /releases/R/std/:splat 302\n",
        r.as_str(),
    )
    let h = docs_headers("https://docs.example")
    assert(
        contains(
            h.as_str(),
            "/*.md\n  Content-Type: text/markdown; charset=utf-8\n  Access-Control-Allow-Origin: *",
        ),
    )
    assert(contains(h.as_str(), "frame-ancestors 'none'"))
    assert(contains(h.as_str(), "connect-src 'self';"))
    assert(suffix("llms-full.txt") == ".txt" && suffix(".hidden") == "" && suffix("a.") == "")
}

@test
fn the_export_cannot_take_the_place_of_the_program() {
    let program = [file("index.html"), file("game.wasm")]
    let Some(name) = export_conflict(
        program,
        Vec::from([String::from("index.html"), String::from("std/io.md")]),
    ) else {
        panic("a conflict")
    }
    assert(name.as_str() == "index.html")
    assert(export_conflict(program, Vec::from([String::from("std/io.md")])).is_none())
}

fn page(path: Text, title: Text, summary: Text, kind: Text) -> Page {
    Page {
        path: String::from(path),
        title: String::from(title),
        summary: String::from(summary),
        kind: String::from(kind),
    }
}

@test
fn the_docs_page_lists_each_page_for_a_person_then_an_agent() {
    let docs = Docs {
        dir: "docsite",
        worker: "docs-host",
        domain: "docs.example",
        description: "The reference.",
        packages: Vec::new(),
    }
    let pages = [
        page("std/io.md", "std::io", "", "module"),
        page("spec/language/6-memory.md", "6. Memory", "Values & `moves`.", "spec"),
    ]
    let has = [
        String::from("llms.txt"),
        String::from("index.json"),
        String::from("std/llms-full.txt"),
    ]
    let (head, text) = docs_page(docs, pages, has)
    assert(contains(head.as_str(), "<meta name=\"description\" content=\"The reference.\">"))
    assert(
        contains(
            head.as_str(),
            "<link rel=\"alternate\" type=\"text/markdown\" href=\"/llms.txt\"",
        ),
    )
    assert(contains(head.as_str(), "<script src=\"pages.js\" defer></script>"))
    assert(
        contains(
            head.as_str(),
            "<style>html canvas#screen { touch-action: pinch-zoom; } html, body { background: #09090B; }",
        ),
    )
    assert(
        contains(
            head.as_str(),
            "<meta name=\"theme-color\" media=\"(prefers-color-scheme: light)\" content=\"#FFFFFF\">",
        ),
    )
    let t = text.as_str()
    assert(t.starts_with("\n<main id=\"wrela-text\">"))
    let Some(language) = t.find("<h2>The language</h2>") else { panic("the language") }
    let Some(agents) = t.find("<h2>For agents</h2>") else { panic("for agents") }
    assert(language < agents, "a person's pages first")
    assert(
        contains(
            t,
            "<li><a href=\"https://docs.example/spec/language/6-memory.html\">6. Memory</a>: Values &amp; <code>moves</code>.</li>",
        ),
    )
    assert(contains(t, "<li><a href=\"https://docs.example/std/io.html\">std::io</a></li>"))
    assert(contains(t, "<a href=\"https://docs.example/std/llms-full.txt\">std/llms-full.txt</a>"))
    assert(!contains(t, "spec/llms-full.txt"))
    assert(!contains(t, "https://docs.example/llms-full.txt"), "the whole file isn't there")
    assert(contains(t, "<code>https://docs.example/#std/arena:arena-insert</code>"))
    assert(code_of("a `b` <c>").as_str() == "a <code>b</code> &lt;c&gt;")
}

@test
fn each_page_is_html_beside_its_markdown_with_its_neighbours() {
    let pages = [
        page("std/io.md", "std::io", "Requests.", "module"),
        page("spec/language/6-memory.md", "6. Memory", "Values.", "spec"),
    ]
    let ordered = in_order(pages)
    // The language first: its page's next is std's.
    assert(ordered[0].path.as_str() == "spec/language/6-memory.md")
    let memory = page_html(ordered[0], "<h1>6. Memory</h1>", None, Some(ordered[1].clone()))
    let m = memory.as_str()
    assert(contains(m, "<a class=\"next\" href=\"../../std/io.html\"><span>Next</span>std::io</a>"))
    assert(contains(m, "<link rel=\"stylesheet\" href=\"../../pages.css\">"))
    assert(contains(m, "href=\"/#spec/language/6-memory\">Live docs"))
    assert(contains(m, "<link rel=\"alternate\" type=\"text/markdown\" href=\"6-memory.md\">"))
    let io = page_html(ordered[1], "", Some(ordered[0].clone()), None)
    assert(contains(io.as_str(), "<a class=\"previous\" href=\"../spec/language/6-memory.html\">"))
    assert(contains(io.as_str(), "<p class=\"group\">Standard library</p>"))
    assert(contains(io.as_str(), "<title>std::io | Wrela docs</title>"))
}

