@test
fn link_destinations_do_not_receive_text_styles() {
    let out = render("[**file**](https://example.test/a**b**c?q=*value*)")
    assert(
        out.as_str() ==
            "<p><a href=\"https://example.test/a**b**c?q=*value*\"><strong>file</strong></a></p>",
        out.as_str(),
    )
}

@test
fn fenced_code_keeps_shorter_fences_and_backticks_with_text() {
    let out = render("````wrela\n\nlet a = 1\n```\n````still code\n\n````\n")
    assert(
        out.as_str() == "<pre><code>\nlet a = 1\n```\n````still code\n</code></pre>",
        out.as_str(),
    )
}

@test
fn escaped_pipes_stay_in_their_table_cells() {
    for first in ["`x\\|y`", "`x|y`"] {
        let out = render(f"| A | B |\n|---|---|\n| {first} | *z* |\n")
        assert(contains(out.as_str(), "<td><code>x|y</code></td><td><em>z</em></td>"), out.as_str())
    }
    let c = cells("| a || c |")
    assert(c.len() == 3 && c[0].as_str() == "a" && c[1].as_str() == "" && c[2].as_str() == "c")
}

@test
fn link_queries_are_escaped_once() {
    let out = render("[search](https://example.test/?q=fields&sort=name)")
    assert(
        contains(out.as_str(), "href=\"https://example.test/?q=fields&amp;sort=name\""),
        out.as_str(),
    )
    assert(!contains(out.as_str(), "&amp;amp;"))
}

@test
fn headings_take_the_exports_anchors_and_repeats_are_numbered() {
    let out = render(
        "# std::arena\n\n## Arena::insert\n\n## `Arena`\n\n## Arena\n\n## §6.8 Handles…\n",
    )
    let o = out.as_str()
    assert(contains(o, "<h1 id=\"std-arena\">"), o)
    assert(contains(o, "<h2 id=\"arena-insert\">"), o)
    assert(contains(o, "<h2 id=\"arena\">"), o)
    assert(contains(o, "<h2 id=\"arena-2\">"), o)
    assert(contains(o, "<h2 id=\"6-8-handles\">"), o)
}

@test
fn links_to_pages_lead_to_their_html_and_code_is_kept_as_written() {
    let out = render(
        "See [§6.8](../spec/language/6-memory.md#6-8-handles) and [the source](https://github.com/x/a.md#L3), `a < b` and **this**.",
    )
    let o = out.as_str()
    assert(contains(o, "<a href=\"../spec/language/6-memory.html#6-8-handles\">§6.8</a>"), o)
    assert(contains(o, "<a href=\"https://github.com/x/a.md#L3\">the source</a>"), o)
    assert(contains(o, "<code>a &lt; b</code>"), o)
    assert(contains(o, "<strong>this</strong>"), o)
}

@test
fn blocks_lists_code_tables_and_an_items_kind_under_its_heading() {
    let out = render(
        "## fetch\n\n`fn` · [`io.wrela:3`](https://x/io#L3)\n\n```wrela\nlet a = <b>\n```\n\n- one\n  - inner\n- two\n\n3. three\n4. four\n\n| A | B |\n|---|---|\n| x | y |\n\n> quiet\n",
    )
    let o = out.as_str()
    assert(contains(o, "<p class=\"meta\"><code>fn</code> · "), o)
    assert(contains(o, "<pre><code>let a = &lt;b&gt;</code></pre>"), o)
    assert(contains(o, "<ul>\n<li>one\n<ul>\n<li>inner\n</li></ul>\n</li>\n<li>two\n</li></ul>"), o)
    assert(contains(o, "<ol start=\"3\">"), o)
    assert(contains(o, "<th>A</th><th>B</th>"), o)
    assert(contains(o, "<td>x</td><td>y</td>"), o)
    assert(contains(o, "<blockquote><p>quiet</p></blockquote>"), o)
}

@test
fn emphasis_needs_stars_no_word_touches() {
    let out = render("a *b* c 2*3*4 and *not closed")
    assert(out.as_str() == "<p>a <em>b</em> c 2*3*4 and *not closed</p>", out.as_str())
}

// ---- Manifests ---------------------------------------------------------------------------------

@test
fn a_manifest_names_its_dependencies_and_members() {
    let m = parse(
        "# a comment\n[package]\nname = \"console\"\n\n[dependencies]\nbrand = { workspace = true }\nui = { path = \"..\" }\n\n[workspace]\nmembers = [\n    \"console\",\n    \"ui/*\", # all of them\n]\n",
    )
    let Some(name) = m.name else { panic("a name") }
    assert(name.as_str() == "console")
    assert(m.dependencies.len() == 2)
    assert(m.dependencies[0].name.as_str() == "brand" && m.dependencies[0].path.is_none())
    let Some(p) = m.dependencies[1].path else { panic("a path") }
    assert(p.as_str() == "..")
    let Some(members) = m.members else { panic("members") }
    assert(members.len() == 2 && members[1].as_str() == "ui/*")
    assert(parse("[package]\n").members.is_none())
    let Some(none) = parse("[workspace]\n").members else { panic("a workspace") }
    assert(none.is_empty())
    let Some(up) = joined("ws/ui/brand", "..") else { panic("inside") }
    assert(up.as_str() == "ws/ui")
    assert(joined("ws", "..").is_none())
}

// ---- Tool tests --------------------------------------------------------------------------------

/// A redistributed release ships the font licences of its package and of each package it
/// depends on: through a dependency of a dependency, one a member of the workspace found by its
/// name and one found by its path.
@test(tool, read: [("fx", "fixtures/licences")], budget: 30)
fn releases_ship_the_font_licences_of_every_package_they_build() {
    let found = match licences("fx/console") {
        Ok(f) => take f,
        Err(e) => panic(e.message()),
    }
    var names = String::new()
    for (name, path) in found {
        names.push_str(f"{name.as_str()}={path.as_str()};")
    }
    assert(
        names.as_str() ==
            "OFL-example.txt=fx/console/fonts/OFL-example.txt;OFL-Brand.txt=fx/ui/brand/fonts/OFL-Brand.txt;OFL-Ui.txt=fx/ui/fonts/OFL-Ui.txt;",
        names.as_str(),
    )
}

/// A workspace dependency is the nearest workspace's member, by its name or its directory's.
@test(tool, read: [("fx", "fixtures/nearest"), ("twice", "fixtures/twice")], budget: 30)
fn workspace_members_are_the_nearest_workspaces() {
    let (root, members) = match workspace_of("fx/inner/great-tree") {
        Ok(f) => take f,
        Err(e) => panic(e.message()),
    }
    assert(root.as_str() == "fx/inner", root.as_str())
    assert(members.len() == 2, "the inner workspace's members")
    assert(members[0].0.as_str() == "app" && members[0].1.as_str() == "fx/inner")
    assert(members[1].0.as_str() == "great_tree" && members[1].1.as_str() == "fx/inner/great-tree")
    // Two members of one name are refused.
    assert(workspace_of("twice").is_err(), "two members named great_tree")
}

/// The board version the catalog says the console's server verifies is the capybara's: its
/// verifier is kept under that version, which a later build names when that board is older.
@test(tool, read: [("ws", "../..")], budget: 30)
fn the_catalogs_board_is_the_games() {
    let Ok(all) = read_files(Vec::from([String::from("ws/games/capybara/replay.wrela")])) else {
        panic("no replay.wrela")
    }
    let Some(source) = String::from_utf8(all[0].clone()) else { panic("not UTF-8") }
    let line = String::from(f"\npub const BOARD: u32 = {CATALOG.console.board}\n")
    assert(
        CATALOG.console.boards == "capybara" && source.as_str().find(line.as_str()).is_some(),
        line.as_str(),
    )
}

/// The path the Worker gives the ceremonies' keys to is the one the console posts its account's
/// requests to (platform/wire.wrela's `ACCOUNTS`), which alone reads them.
@test(tool, read: [("ws", "../..")], budget: 30)
fn the_keys_go_where_the_ceremonies_are() {
    let Ok(all) = read_files(Vec::from([String::from("ws/platform/wire.wrela")])) else {
        panic("no wire.wrela")
    }
    let Some(source) = String::from_utf8(all[0].clone()) else { panic("not UTF-8") }
    let line = String::from(f"\npub const ACCOUNTS: Text = \"{site::KEYED}\"\n")
    assert(source.as_str().find(line.as_str()).is_some(), line.as_str())
}

/// A build's deadline fits the run's budget, with 5 minutes left for the covers and the
/// writing: the deadline counts a build's wait behind the others, so it's most of the budget.
@test(tool, read: [("ws", "../..")], budget: 30)
fn the_builds_deadline_fits_the_runs_budget() {
    let Ok(all) = read_files(Vec::from([String::from("ws/wrela.toml")])) else {
        panic("no wrela.toml")
    }
    let Some(manifest) = String::from_utf8(all[0].clone()) else { panic("not UTF-8") }
    let Some(at) = manifest.find("[tools.release]") else { panic("no [tools.release]") }
    let section = manifest.slice(at, manifest.len())
    let Some(t) = section.find("\ntimeout = ") else { panic("no timeout") }
    let rest = section.slice(t + 11, section.len())
    let Some(end) = rest.find("\n") else { panic("no end of line") }
    let Some(budget) = rest.slice(0, end).parse_u32() else { panic("a timeout in seconds") }
    assert(BUILD_TIMEOUT > 600.0, "longer than a request's deadline without a budget")
    assert(BUILD_TIMEOUT + 300.0 <= f64(budget), f"{BUILD_TIMEOUT} s in a budget of {budget} s")
}

/// What toolchain 0.15.0's server build writes beside `server/game.wasm` for the Worker's
/// configuration (wrela-compiler, docs/plans/cloudflare-host.md §8).
/// The console's server's Worker that names the Worker the server ran in before takes its classes
/// over from it in its first migration, with their Durable Objects, in place of making them.
@test
fn the_servers_first_deploy_takes_its_classes_over_from_the_worker_it_ran_in() {
    let Some(doc) = std::json::parse(SERVER_JSON) else { panic("the server's members") }
    let Some(json::Json::Obj(server)) = json::from_doc(doc, std::json::TOP) else {
        panic("members")
    }
    let w = match api_config("wrela-api", "wrela.dev", "wrela.dev", "wrela", server) {
        Ok(w) => take w,
        Err(e) => panic(e.as_str()),
    }
    let Some(c) = std::json::parse(w.as_str()) else { panic(w.as_str()) }
    let Some(migrations) = c.get(std::json::TOP, "migrations") else { panic("migrations") }
    assert(c.count(migrations) == 2)
    let first = c.at(migrations, 0).unwrap()
    assert(c.text(c.get(first, "tag").unwrap()) == Some(String::from("wrela-server-1")))
    assert(c.get(first, "new_sqlite_classes").is_none(), "no new class")
    let Some(moved) = c.get(first, "transferred_classes") else { panic("transferred_classes") }
    assert(c.count(moved) == 1)
    let t = c.at(moved, 0).unwrap()
    assert(c.text(c.get(t, "from").unwrap()) == Some(String::from("WrelaServer")))
    assert(c.text(c.get(t, "from_script").unwrap()) == Some(String::from("wrela")))
    assert(c.text(c.get(t, "to").unwrap()) == Some(String::from("WrelaServer")))
    // A later migration, the rooms' class, makes its class as the build asks.
    let rooms = c.at(migrations, 1).unwrap()
    assert(c.text(c.get(rooms, "tag").unwrap()) == Some(String::from("wrela-room-1")))
    assert(
        c.get(rooms, "new_sqlite_classes").is_some() &&
            c.get(rooms, "transferred_classes").is_none(),
    )
    // Its binding is to the class as it was.
    let Some(objects) = c.get(std::json::TOP, "durable_objects") else { panic("durable_objects") }
    assert(c.write(objects).as_str().find("WrelaServer").is_some())
}

const SERVER_JSON: Text = "{\"comment\": \"merge these\", \"durable_objects\": {\"bindings\": [{\"name\": \"WRELA_SERVER\", \"class_name\": \"WrelaServer\"}, {\"name\": \"WRELA_ROOM\", \"class_name\": \"WrelaRoom\"}]}, \"migrations\": [{\"tag\": \"wrela-server-1\", \"new_sqlite_classes\": [\"WrelaServer\"]}, {\"tag\": \"wrela-room-1\", \"new_sqlite_classes\": [\"WrelaRoom\"]}], \"rules\": [{\"type\": \"CompiledWasm\", \"globs\": [\"**/*.wasm\"], \"fallthrough\": true}], \"vars\": {\"WRELA_ORIGINS\": \"\", \"WRELA_LIMITS\": \"[]\"}, \"assets\": {\"run_worker_first\": [\"/api/*\", \"/room/*\"]}}"

@test
fn the_consoles_server_runs_in_a_worker_of_its_own_on_its_paths() {
    let Some(doc) = std::json::parse(SERVER_JSON) else { panic("the server's members") }
    let Some(json::Json::Obj(server)) = json::from_doc(doc, std::json::TOP) else {
        panic("members")
    }
    let w = match api_config("wrela-api", "wrela.dev", "wrela.dev", "", server) {
        Ok(w) => take w,
        Err(e) => panic(e.as_str()),
    }
    let Some(c) = std::json::parse(w.as_str()) else { panic(w.as_str()) }
    let top = std::json::TOP
    let Some(main) = c.get(top, "main") else { panic("main") }
    assert(c.text(main) == Some(String::from("./wrela-api.worker.js")))
    assert(c.get(top, "assets").is_none(), "the server's Worker serves no assets")
    // The server's paths are its routes, in the console's zone: they take those paths before the
    // console's custom domain does.
    let Some(routes) = c.get(top, "routes") else { panic("routes") }
    assert(c.count(routes) == 2)
    for (k, pattern) in [(0, "wrela.dev/api/*"), (1, "wrela.dev/room/*")] {
        let route = c.at(routes, k).unwrap()
        assert(c.text(c.get(route, "pattern").unwrap()) == Some(String::from(pattern)), pattern)
        assert(c.text(c.get(route, "zone_name").unwrap()) == Some(String::from("wrela.dev")))
        assert(c.get(route, "custom_domain").is_none())
    }
    // The build's members, as it gave them.
    let Some(objects) = c.get(top, "durable_objects") else { panic("durable_objects") }
    assert(c.write(objects).as_str().find("WrelaServer").is_some())
    let Some(migrations) = c.get(top, "migrations") else { panic("migrations") }
    assert(c.write(migrations).as_str().find("wrela-server-1").is_some())
    assert(c.write(migrations).as_str().find("transferred_classes").is_none(), "none named")
    assert(c.get(top, "rules").is_some())
    assert(c.get(top, "comment").is_none(), "the build's note isn't Wrangler's")
    // Its origin alone may change things, and each client is limited.
    let Some(vars) = c.get(top, "vars") else { panic("vars") }
    let Some(origins) = c.get(vars, "WRELA_ORIGINS") else { panic("WRELA_ORIGINS") }
    assert(c.text(origins) == Some(String::from("https://wrela.dev")))
    let Some(given) = c.get(vars, "WRELA_LIMITS") else { panic("WRELA_LIMITS") }
    let Some(listed) = std::json::parse(c.text(given).unwrap().as_str()) else { panic("a list") }
    assert(listed.count(top) == site::RATE_LIMITS.len())
    let Some(bindings) = c.get(top, "ratelimits") else { panic("ratelimits") }
    assert(c.count(bindings) == site::RATE_LIMITS.len())
    for i in 0..listed.count(top) {
        let l = listed.at(top, i).unwrap()
        let b = c.at(bindings, i).unwrap()
        assert(
            listed.text(listed.get(l, "binding").unwrap()) == c.text(c.get(b, "name").unwrap()),
            "each limit names its binding",
        )
    }
    // Its script exports the Durable Object and gives the server each request, a 404 for one it
    // doesn't answer.
    let s = api_script("wrela-api.server")
    assert(
        contains(
            s.as_str(),
            "import { WrelaServer, WrelaRoom, api, rooms } from \"./wrela-api.server/cloudflare.js\";\n",
        ) &&
            contains(s.as_str(), "export { WrelaServer, WrelaRoom };\n") &&
            contains(
                s.as_str(),
                "    const answered = (await api(keyed(request, env), env, { ctx: ctx })) ?? (await rooms(request, env));\n",
            ) &&
            contains(s.as_str(), "    return answered ?? new Response(null, { status: 404 });\n"),
        s.as_str(),
    )
    // The ceremonies' keys reach the program from the Worker's secrets alone, and only on a POST
    // to the accounts' path: what a client sent under their names is removed from every request.
    let where_keyed = "  if (request.method === \"POST\" && new URL(request.url).pathname === \"/api/accounts\") {\n"
    for k in 0..2 {
        let (secret, header) = (site::KEY_SECRETS[k], site::KEY_HEADERS[k])
        let removed = String::from(f"  headers.delete(\"{header}\");\n")
        let given = String::from(
            f"    if (env.{secret}) headers.set(\"{header}\", env.{secret});\n",
        )
        let (Some(r), Some(w), Some(g)) = (
            s.as_str().find(removed.as_str()),
            s.as_str().find(where_keyed),
            s.as_str().find(given.as_str()),
        ) else {
            panic(s.as_str())
        }
        assert(r < w && w < g, "removed from every request, then set on a ceremony's alone")
    }
    // The archived builds' bucket, for `call_build`.
    let Some(buckets) = c.get(top, "r2_buckets") else { panic("r2_buckets") }
    let b = c.at(buckets, 0).unwrap()
    assert(c.text(c.get(b, "binding").unwrap()) == Some(String::from("WRELA_BUILDS")))
    assert(c.text(c.get(b, "bucket_name").unwrap()) == Some(String::from(site::BUILDS_BUCKET)))
    // A build that names no paths, or a path that can't be a route (an exception, a `*` before
    // its path's end), has no Worker; nor has a transfer of migrations that make no new classes.
    for (given, from, why) in [
        ("{}", "", "no paths"),
        (
            "{\"assets\": {\"run_worker_first\": [\"/api/*\", \"!/api/docs/*\"]}}",
            "",
            "can't be a route",
        ),
        ("{\"assets\": {\"run_worker_first\": [\"/api/*/admin\"]}}", "", "can't be a route"),
        (
            "{\"assets\": {\"run_worker_first\": [\"/api/*\"]}, \"migrations\": [{\"tag\": \"x\", \"deleted_classes\": [\"A\"]}]}",
            "wrela",
            "no new SQLite classes",
        ),
    ] {
        let Some(d) = std::json::parse(given) else { panic(given) }
        let Some(json::Json::Obj(members)) = json::from_doc(d, std::json::TOP) else { panic(given) }
        match api_config("wrela-api", "wrela.dev", "wrela.dev", from, members) {
            Ok(_) => panic(f"configured, but should fail with `{why}`"),
            Err(e) => assert(contains(e.as_str(), why), e.as_str()),
        }
    }
}
