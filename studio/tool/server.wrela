// The lens served to Chrome (`serve`): the lens's build, over `std::tool::serve` on 127.0.0.1
// only, which answers only requests addressed to this machine by name (so a page elsewhere
// can't reach it through DNS rebinding) and takes posts only from its own pages (their
// `Origin`), so another site open in the browser can't edit the files. The lens's edits (a post
// to `studio/edit` beside the page) are written through `toolchain::edit`, and its fit's
// request for the reference image (`studio/reference`) is answered with `--reference`'s mask:
// one blob for every fit, given back when the server ends. A post's body of any size the server
// takes (a blob past 512 KiB) is read and given back; every post is answered, whatever another
// did.
//
// The server is one thread that answers its requests as they come (`Server::step`): it waits
// for the first of the next post, the watch's timer and the request a rebuild waits on (and a
// caller's own, a test's), and answers it.
//
// The tool watches the subject's files every 200 ms, sources of any size. A change that touches
// only literals (another tool's edit) goes to the open lens as new values, which it sets with
// no rebuild; any other change builds the lens again. Each build is a generation of the
// server's, a directory of its own (`<out>/serve/<run>-<n>`), and the page is in it, so a
// page's posts name the build that made it. A build is served only once it built and its page
// is ready: the root page is then its page, and a page of another build goes to it; a build
// that fails leaves the last good one served, with its error in the state. A rebuild goes on
// beside the posts, which are answered meanwhile. An edit is taken only from a page of the
// build served, and not while the lens is built again, since its literals' numbers are its
// build's. A served build starts with its literals' values as it has them, and the source's
// since then follow as updates, so a literal changed while it was built reaches the page. A
// source that can't be read (but for one that went) is reported. The page's script asks the
// tool what's new every 250 ms, once the page's own scripts have run: a post to `studio/state`
// beside the page with `{"since": n}` answers the build served, its version, whether it's being
// built again, its error, and the literal updates since `n`, which the script types into the
// lens as its `set` command.

use lens::{Building, Built, Place, data_of, parse_edits, read_text, write_text}
use std::json::{TOP, parse}
use json::{f32_text, obj, quoted}
use std::collections::{Vec, replace}
use std::io::print
use std::string::String
use std::tool::{Call, Done, MOST_BYTES, Request, ToolError, any}
use std::tool::blob
use std::tool::blob::Data
use std::tool::files
use std::tool::files::Kind
use std::tool::serve
use std::tool::time
use std::tool::toolchain
use toolkit::whole::{data_bytes, joined}

/// The script the page gets: it asks what's new (a post to `studio/state` beside the page, so
/// the tool knows which build asks), goes to the build served once it isn't the page's own, and
/// types each literal update into the lens as `set <literal> <value>`.
fn script() -> String {
    var s = String::new()
    s.push_str("<script>\n")
    s.push_str("(() => {\n")
    s.push_str("  const here = new URL(document.baseURI).pathname.split(\"/\")[1];\n")
    s.push_str("  let since = 0;\n")
    s.push_str("  const type = (line) => {\n")
    s.push_str("    for (const ch of line + \"\\n\") {\n")
    s.push_str("      const key = ch === \"\\n\" ? \"Enter\" : ch;\n")
    s.push_str("      const code = ch === \"\\n\" ? \"Enter\" : \"\";\n")
    s.push_str("      window.dispatchEvent(new KeyboardEvent(\"keydown\", { key, code }));\n")
    s.push_str("      window.dispatchEvent(new KeyboardEvent(\"keyup\", { key, code }));\n")
    s.push_str("    }\n")
    s.push_str("  };\n")
    s.push_str("  const tick = async () => {\n")
    s.push_str("    try {\n")
    s.push_str(
        "      const r = await fetch(\"studio/state\", { method: \"POST\", body: JSON.stringify({ since }), cache: \"no-store\" });\n",
    )
    s.push_str("      const s = await r.json();\n")
    s.push_str("      if (s.build !== here) { location.replace(`/${s.build}/`); return; }\n")
    s.push_str("      for (const [i, v] of s.updates) type(`set ${i} ${v}`);\n")
    s.push_str("      since = s.next;\n")
    s.push_str("    } catch (_) {}\n")
    s.push_str("    setTimeout(tick, 250);\n")
    s.push_str("  };\n")
    // Once the page's own scripts have run, so the lens's input listens before anything is typed.
    s.push_str(
        "  if (document.readyState === \"complete\") tick(); else window.addEventListener(\"load\", tick);\n",
    )
    s.push_str("})();\n")
    s.push_str("</script>\n")
    s
}

/// The page at the root of the server: the page of the build served now (`html`, generation
/// `build`), its files and posts beside it there.
pub fn root_page(build: str, html: str) -> String {
    glue::replace(html, "<head>", f"<head>\n<base href=\"/{build}/\">")
}

/// The literal values a lens has when it loads a build (`built`, as the build has them), and
/// the updates that bring them to the source's values now (`now`, if the source changed in its
/// literals alone): a literal changed while the build was made reaches the page too.
pub fn seeded(built: [f32], now: Option<Vec<f32>>) -> (Vec<f32>, Vec<(u32, f32)>) {
    var values: Vec<f32> = Vec::from(built)
    var updates: Vec<(u32, f32)> = Vec::new()
    if let Some(v) = now {
        follow(mut values, v, mut updates)
    }
    (values, updates)
}

/// `values` brought to `now`'s, each literal whose bits differ an update pushed to `updates`:
/// how many there were.
fn follow(values: mut Vec<f32>, now: [f32], updates: mut Vec<(u32, f32)>) -> u32 {
    var n = 0
    for i in 0..min(now.len(), values.len()) {
        if bitcast_u32(values[i]) != bitcast_u32(now[i]) {
            updates.push((i, now[i]))
            values[i] = now[i]
            n += 1
        }
    }
    n
}

/// A post's path read as the build it came from (the first part, a generation the server
/// names) and what it asks for (`studio/edit`); a path with one part has no build.
pub fn post_route(path: str) -> (String, String) {
    let end = match path.find("?") {
        Some(q) => q,
        None => path.len(),
    }
    let trimmed = path.slice(min(1, end), end)
    if trimmed.starts_with("studio/") {
        return (String::new(), String::from(trimmed))
    }
    match trimmed.find("/") {
        Some(k) => (
            String::from(trimmed.slice(0, k)),
            String::from(trimmed.slice(k + 1, trimmed.len())),
        ),
        None => (String::new(), String::from(trimmed)),
    }
}

/// What the server knows as it runs: the build it serves (its generation, which names the
/// directory the page is in, and how many it has served), the literals the lens should set, in
/// order, the values the lens has (the build's, then each update's), the files the build
/// lifted, the files as the build saw them, and why the last rebuild failed, if it did.
pub struct Live: Clone {
    pub build: String,
    pub version: u32,
    pub updates: Vec<(u32, f32)>,
    pub values: Vec<f32>,
    pub lifted: Vec<String>,
    pub built: Vec<(String, String)>,
    pub error: Option<String>,
}

/// The state's answer to a page that has seen the updates before `since`.
pub fn state_answer(live: Live, since: u32, rebuilding: bool) -> String {
    var updates = String::from("[")
    for k in since..live.updates.len() {
        if k > since {
            updates.push_str(",")
        }
        let (i, v) = live.updates[k]
        updates.push_str(f"[{i},{f32_text(v).as_str()}]")
    }
    updates.push_str("]")
    let error = match live.error.clone() {
        Some(e) => quoted(e.as_str()),
        None => String::from("null"),
    }
    obj()
        .text("build", live.build.as_str())
        .raw("error", error.as_str())
        .int("next", live.updates.len())
        .raw("rebuilding", if rebuilding { "true" } else { "false" })
        .raw("updates", updates.as_str())
        .int("version", live.version)
        .done()
}

/// Whether what changed from `built` to `now` (each file's path and text) is in the lifted
/// files alone, which the toolchain then reads for new values: no file came or went, and every
/// other file is as the build saw it.
pub fn only_lifted_changed(
    built: [(String, String)],
    now: [(String, String)],
    lifted: [String],
) -> bool {
    if built.len() != now.len() {
        return false
    }
    for k in 0..now.len() {
        let (path, text) = now[k].clone()
        let (was, then) = built[k].clone()
        if path != was {
            return false
        }
        var is_lifted = false
        for l in lifted {
            if l.as_str() == path.as_str() {
                is_lifted = true
            }
        }
        if !is_lifted && text != then {
            return false
        }
    }
    true
}

/// The source files (modules and manifests, not build output) of the package at `dir`, each
/// with its text, sorted by path.
pub fn scan(dir: str) -> Result<Vec<(String, String)>, ToolError> {
    var out: Vec<(String, String)> = Vec::new()
    var todo: Vec<(String, bool)> = Vec::new()
    todo.push((String::from(dir), true))
    while let Some(next) = todo.pop() {
        let (d, top) = take next
        let entries = files::list(d.as_str()).wait()?
        for e in entries {
            let name = e.name.as_str()
            if name.starts_with(".") {
                continue
            }
            let path = String::from(f"{d.as_str()}/{name}")
            if e.kind == Kind::Dir {
                if !(top && (name == "build" || name == "results" || name == "target")) {
                    todo.push((take path, false))
                }
            } else if e.kind == Kind::File && (name.ends_with(".wrela") || name == "wrela.toml") {
                // A file that went between the list and the read is a change, read next time.
                if let Some(text) = read_source(path.as_str(), e.size)? {
                    out.push((take path, take text))
                }
            }
        }
    }
    out.sort_by(|a, b| a.0 < b.0)
    Ok(out)
}

/// The text of the source file at `path`, `size` bytes as its directory listed it: read whole,
/// or through a blob past 512 KiB. `None` if it went since it was listed; any other failure is
/// the error.
pub fn read_source(path: str, size: u64) -> Result<Option<String>, ToolError> {
    var bytes: Option<Vec<u8>> = None
    var why = String::new()
    if size <= u64(MOST_BYTES) {
        match files::read(path).wait() {
            Ok(b) => bytes = Some(take b),
            Err(e) => why = String::from(e.message()),
        }
    } else {
        match files::read_blob(path).wait() {
            Ok(b) => bytes = Some(joined(data_bytes(Data::Blob(b))?)),
            Err(e) => why = String::from(e.message()),
        }
    }
    if let Some(b) = take bytes {
        return match String::from_utf8(take b) {
            Some(t) => Ok(Some(t)),
            None => Err(ToolError::new(f"{path} isn't UTF-8")),
        }
    }
    // Gone since it was listed, or a failure to report.
    if files::stat(path).wait().is_err() {
        return Ok(None)
    }
    Err(ToolError::new(f"can't read {path}: {why.as_str()}"))
}

/// The lifted build's literals: its lifted files, their values as the build has them, and their
/// values in the files now.
fn literals_of(built: Built) -> Result<(Vec<String>, Vec<f32>, Option<Vec<f32>>), ToolError> {
    let lit = toolchain::literals(built.program.as_str(), built.page.as_str()).wait()?
    Ok((lit.files.clone(), lit.built.clone(), lit.values.clone()))
}

/// What a server's caller sees of it as it runs, and asks of it: its origin, the build it
/// serves (its generation and its page's directory), how many builds it has served, whether
/// it's building the lens again, how many literal updates it has sent, why the last build
/// failed (empty if it didn't); and `hold`, which keeps a finished build from being served until
/// the caller lets it go (`held` says one waits): a test's.
pub struct Control: Clone {
    pub origin: String,
    pub build: String,
    pub page: String,
    pub version: u32,
    pub rebuilding: bool,
    pub updates: u32,
    pub error: String,
    pub hold: bool,
    pub held: bool,
}

/// The place a served lens is first built in: its page is generation 1 of the server's builds,
/// `<out>/serve/<run>-1`, where `run` names this run of the server, so a page of another run
/// never names one of this run's builds.
pub fn serving_place(place: take Place, run: str) -> Place {
    var p = take place
    p.page = String::from(f"{p.out.as_str()}/serve/{run}-1")
    p
}

/// What an edit is answered while the lens is built again: its literals may be another build's.
const REBUILDING: Text = "{\"why\":\"the lens is being built again: edit once the page has reloaded\",\"written\":false}"

/// What an edit from a page of another build than the one served is answered: its literals'
/// numbers are that build's.
const OTHER_BUILD: Text = "{\"why\":\"the page has another build of the lens than the one served: it goes to the new one; edit there\",\"written\":false}"

/// A server of the lens, as it runs: what its caller sees (`control`); the subject's place, the
/// generations' directory and this run's name; the server, and the fit's reference (one blob,
/// or bytes, for every fit, given back when the server stops); the build served, how many
/// generations there have been and the one before it; what the pages are told (`live`); the
/// files as the last look saw them; a build of the lens under way, into the next generation's
/// directory, and the files as it read them, or a finished one the caller holds; and the
/// requests it waits on: the next post, and the watch's timer.
pub struct Server {
    pub control: Control,
    place: Place,
    root: String,
    run: String,
    handle: serve::Server,
    reference: Option<Data>,
    current: Built,
    generation: u32,
    previous: String,
    live: Live,
    last: Vec<(String, String)>,
    rebuild: Option<Building>,
    next_build: String,
    rebuilt_from: Vec<(String, String)>,
    finished: Option<Result<Built, ToolError>>,
    post: Call<serve::Post>,
    timer: Call<Done>,
}

/// Starts serving the lens's build `built` (of the subject at `place`, named `shown`), built
/// into a generation's directory (`serving_place`), on 127.0.0.1:`port`: its page made ready
/// and the server listening, the subject's files read, and the lens's address printed. Each
/// build is a generation of its own, the page's directory: a build is served (the root page goes
/// to it, and pages of other builds go to it) only once it built, and a failed one leaves the
/// last good one served, with its error in the state. An edit is taken only from a page of the
/// build served, and not while the lens is built again. A post is answered whatever happens to
/// another. `Server::step` serves.
pub fn start(
    place: take Place,
    built: Built,
    port: u16,
    mask: take Option<Vec<u8>>,
    shown: str,
) -> Result<Server, ToolError> {
    // The generations: `<root>/<run>-<n>`.
    let parts = built.page.as_str().split("/")
    let (last_from, last_to) = parts[parts.len() - 1]
    let root = String::from(built.page.as_str().slice(0, max(last_from, 1) - 1))
    let first = String::from(built.page.as_str().slice(last_from, last_to))
    let Some(dash) = last_dash(first.as_str()) else {
        return Err(
            ToolError::new(f"`{built.page.as_str()}` isn't a served generation's directory"),
        )
    }
    let run = String::from(first.as_str().slice(0, dash))
    publish(built.page.as_str(), root.as_str(), first.as_str())?
    var reference: Option<Data> = None
    if let Some(m) = take mask {
        reference = Some(data_of(take m)?)
    }
    let started = serve::start(root.as_str(), port).wait()?
    let (lifted, compiled, now_values) = literals_of(built)?
    let (values, updates) = seeded(compiled, take now_values)
    let seen = scan(place.subject.as_str())?
    let live = Live {
        build: first.clone(),
        version: 1,
        updates,
        values,
        lifted,
        built: seen.clone(),
        error: None,
    }
    let control = Control {
        origin: started.origin.clone(),
        build: first.clone(),
        page: built.page.clone(),
        version: 1,
        rebuilding: false,
        updates: live.updates.len(),
        error: String::new(),
        hold: false,
        held: false,
    }
    print(f"the lens on `{shown}`: {started.origin.as_str()}/")
    Ok(
        Server {
            control,
            place,
            root,
            run,
            handle: started.server,
            reference,
            current: built.clone(),
            generation: 1,
            previous: String::new(),
            live,
            last: seen,
            rebuild: None,
            next_build: String::new(),
            rebuilt_from: Vec::new(),
            finished: None,
            post: serve::next_post(started.server, 600.0),
            timer: time::after(0.2),
        },
    )
}

/// Serves the lens's build `built` (`start`) until the tool is stopped: the command line's
/// server.
pub fn run_server(
    place: take Place,
    built: Built,
    port: u16,
    mask: take Option<Vec<u8>>,
    shown: str,
) -> Result<(), ToolError> {
    var s = start(take place, built, port, take mask, shown)?
    loop {
        let _ = s.step([])
    }
    Ok(())
}

impl Server {
    /// Serves what comes first: it waits for the first of its own requests (the next post, the
    /// watch's timer, the request a build under way waits on) and `also`, the caller's, and
    /// answers its own. A finished build the caller doesn't hold is served at once. The index in
    /// `also` of the caller's request that was answered, which it hasn't read; else `None`.
    pub fn step(mut self, also: [Request]) -> Option<u32> {
        if self.finished.is_some() && !self.control.hold {
            self.served()
            self.control.held = false
            return None
        }
        var requests: Vec<Request> = Vec::from([self.post.request(), self.timer.request()])
        if let Some(b) = self.rebuild {
            requests.push(b.request())
        }
        let own = requests.len()
        for r in also {
            requests.push(r)
        }
        let k = any(requests)
        if k >= own {
            return Some(k - own)
        }
        if k == 0 {
            self.answer_post()
        } else if k == 1 {
            self.watch()
        } else {
            self.built_more()
        }
        self.control.held = self.finished.is_some() && self.control.hold
        None
    }

    /// Stops the server: its port closed, its reference given back.
    pub fn stop(take self) -> Result<(), ToolError> {
        let closed = serve::close(self.handle).wait()
        if let Some(Data::Blob(b)) = self.reference {
            let _ = blob::release(b).wait()
        }
        let _ = (take closed)?
        Ok(())
    }

    /// The post that came, answered, and the next one asked for.
    fn answer_post(mut self) {
        let Ok(p) = replace(mut self.post, serve::next_post(self.handle, 600.0)).wait() else {
            return
        }
        // A body past 512 KiB comes as a blob: read, then given back.
        var body: Vec<u8> = Vec::new()
        var unread = String::new()
        match data_bytes(p.body.clone()) {
            Ok(chunks) => body = joined(take chunks),
            Err(why) => unread = String::from(why.message()),
        }
        var reply = Data::empty()
        let (from, asked) = post_route(p.path.as_str())
        if !unread.is_empty() {
            reply = text_data(f"{{\"error\":{quoted(unread.as_str()).as_str()}}}")
        } else if asked == "studio/state" {
            var since = 0
            if let Some(text) = String::from_utf8(body.clone()) {
                if let Some(d) = parse(text.as_str()) {
                    if let Some(s) = d.get(TOP, "since") {
                        if let Some(n) = d.num(s) {
                            since = u32(min(max(n, 0.0), f64(self.live.updates.len())))
                        }
                    }
                }
            }
            // A page of another build gets every update of the build served, which it goes to.
            if from != self.live.build {
                since = 0
            }
            reply = text_data(state_answer(self.live, since, self.rebuild.is_some()).as_str())
        } else if asked == "studio/edit" {
            if from != self.live.build {
                reply = text_data(OTHER_BUILD)
            } else if self.rebuild.is_some() || self.finished.is_some() {
                reply = text_data(REBUILDING)
            } else {
                let answer_text = lens::edit(
                    self.current.program.as_str(),
                    self.current.page.as_str(),
                    body.clone(),
                )
                // The values are the lens's already, so they aren't updates for it.
                if answer_text.as_str().find("\"written\":true").is_some() {
                    let text = match String::from_utf8(take body) {
                        Some(t) => take t,
                        None => String::new(),
                    }
                    if let Some(edits) = parse_edits(text.as_str()) {
                        for e in edits {
                            let (i, v) = e
                            if i < self.live.values.len() {
                                self.live.values[i] = v
                            }
                        }
                    }
                }
                reply = text_data(answer_text.as_str())
            }
        } else if asked == "studio/reference" {
            // A fit with no reference reads an empty one, which it refuses.
            match self.reference.clone() {
                Some(r) => reply = take r,
                None => print("the fit asked for a reference image: serve with --reference"),
            }
        } else {
            reply = text_data(
                f"{{\"error\":{quoted(f"nothing answers `{asked.as_str()}` here").as_str()}}}",
            )
        }
        let _ = serve::answer(self.handle, p.id, reply).wait()
    }

    /// The watch's timer came: the subject's files looked at, and the timer asked for again. A
    /// change to the lifted files' literals alone goes to the lens as new values; any other
    /// starts a build into the next generation's directory. Changes made while a build is under
    /// way are looked at once it's done.
    fn watch(mut self) {
        match scan(self.place.subject.as_str()) {
            Ok(now) => {
                if self.rebuild.is_none() && self.finished.is_none() && now != self.last {
                    var values: Option<Vec<f32>> = None
                    if only_lifted_changed(self.live.built, now, self.live.lifted) &&
                        self.live.error.is_none() {
                        if let Ok(found) = literals_of(self.current) {
                            let (_, _, v) = take found
                            values = take v
                        }
                    }
                    match take values {
                        Some(v) => {
                            self.control.updates += follow(
                                mut self.live.values,
                                v,
                                mut self.live.updates,
                            )
                        },
                        None => {
                            self.next_build = String::from(
                                f"{self.run.as_str()}-{self.generation + 1}",
                            )
                            var into = self.place.clone()
                            into.page = String::from(
                                f"{self.root.as_str()}/{self.next_build.as_str()}",
                            )
                            match lens::begin(take into) {
                                Ok(b) => self.rebuild = Some(take b),
                                Err(e) => self.finished = Some(Err(take e)),
                            }
                            self.rebuilt_from = now.clone()
                            self.control.rebuilding = true
                        },
                    }
                    self.last = take now
                }
            },
            Err(why) => print(f"error: {why.message()}"),
        }
        let _ = replace(mut self.timer, time::after(0.2)).wait()
    }

    /// The request the build under way waits on was answered: it goes on, and once it's done,
    /// it's finished.
    fn built_more(mut self) {
        let got = match mut self.rebuild {
            Some(b) => b.advance(),
            None => return,
        }
        match take got {
            Ok(None) => {},
            Ok(Some(next)) => {
                self.finished = Some(Ok(take next))
                self.rebuild = None
            },
            Err(why) => {
                self.finished = Some(Err(take why))
                self.rebuild = None
            },
        }
    }

    /// The finished build served, once its page is ready, its literals' values the build's and
    /// then the source's now; or, if it failed, the last good one kept, with its error.
    fn served(mut self) {
        let Some(result) = replace(mut self.finished, None) else { return }
        self.control.rebuilding = false
        var outcome: Result<Built, String> = Err(String::new())
        match take result {
            Ok(next) => {
                if next.errors.is_empty() {
                    outcome = Ok(take next)
                } else {
                    print(next.errors.as_str())
                    outcome = Err(next.errors.clone())
                }
            },
            Err(why) => {
                print(f"error: {why.message()}")
                outcome = Err(String::from(why.message()))
            },
        }
        if let Ok(next) = outcome.clone() {
            let ready = publish(next.page.as_str(), self.root.as_str(), self.next_build.as_str())
            let found = literals_of(next)
            match (take ready, take found) {
                (Ok(()), Ok(lit)) => {
                    let (lifted, compiled, now) = take lit
                    let (values, updates) = seeded(compiled, take now)
                    // The generation before the last goes; the last stays for a page that is
                    // still on its way to the new one.
                    if !self.previous.is_empty() {
                        let gone = f"{self.root.as_str()}/{self.previous.as_str()}"
                        let _ = files::remove_all(gone).wait()
                    }
                    self.previous = self.live.build.clone()
                    self.current = next.clone()
                    self.generation += 1
                    self.live.build = self.next_build.clone()
                    self.live.version += 1
                    self.live.updates = take updates
                    self.live.values = take values
                    self.live.lifted = take lifted
                    self.live.built = self.rebuilt_from.clone()
                    self.live.error = None
                    self.control.build = self.live.build.clone()
                    self.control.page = self.current.page.clone()
                    self.control.version = self.live.version
                    self.control.updates += self.live.updates.len()
                    self.control.error = String::new()
                    print(f"rebuilt the lens (version {self.live.version})")
                },
                (Err(why), _) => outcome = Err(String::from(why.message())),
                (_, Err(why)) => outcome = Err(String::from(why.message())),
            }
        }
        // A build that failed leaves the last good one served, and goes.
        if let Err(why) = take outcome {
            let _ = files::remove_all(f"{self.root.as_str()}/{self.next_build.as_str()}").wait()
            self.control.error = why.clone()
            self.live.error = Some(take why)
        }
        // The files as the build read them: a change since is looked at next.
        self.last = self.rebuilt_from.clone()
    }
}

/// Where the last `-` of `name` is.
fn last_dash(name: str) -> Option<u32> {
    var k = name.len()
    while k > 0 {
        k -= 1
        if name.byte(k) == 45 {
            return Some(k)
        }
    }
    None
}

/// The build in `page` (generation `build` of the server's root `root`) made ready and served:
/// its page's `index.html` given the script that keeps it current, then the root's page made
/// that page.
fn publish(page: str, root: str, build: str) -> Result<(), ToolError> {
    let index = String::from(f"{page}/index.html")
    let Some(html) = read_text(index.as_str())? else {
        return Err(ToolError::new("the lens's build has no index.html"))
    }
    let with = glue::replace(html.as_str(), "</body>", f"{script().as_str()}</body>")
    write_text(index.as_str(), with.as_str())?
    write_text(f"{root}/index.html", root_page(build, with.as_str()).as_str())
}

/// `text`'s bytes as an answer's: themselves (a post's answer here is at most a few KiB, but
/// an edit's diff can be more: past 512 KiB, it's cut to an error).
fn text_data(text: str) -> Data {
    if text.len() > MOST_BYTES {
        let cut = String::from("{\"error\":\"the answer is more than 512 KiB\"}")
        return Data::Bytes(Vec::from(cut.as_bytes()))
    }
    let owned = String::from(text)
    Data::Bytes(Vec::from(owned.as_bytes()))
}

@test
fn the_state_answers_the_updates_since_a_page_saw_them() {
    var live = Live {
        build: String::from("b-2"),
        version: 2,
        updates: Vec::new(),
        values: Vec::new(),
        lifted: Vec::new(),
        built: Vec::new(),
        error: None,
    }
    live.updates.push((3, 0.25))
    live.updates.push((1, -1.0))
    assert(
        state_answer(live, 0, rebuilding: false).as_str() ==
            "{\"build\":\"b-2\",\"error\":null,\"next\":2,\"rebuilding\":false,\"updates\":[[3,0.25],[1,-1.0]],\"version\":2}",
    )
    assert(
        state_answer(live, 1, rebuilding: true).as_str() ==
            "{\"build\":\"b-2\",\"error\":null,\"next\":2,\"rebuilding\":true,\"updates\":[[1,-1.0]],\"version\":2}",
    )
}

@test
fn only_a_change_in_lifted_files_can_be_new_values() {
    var built: Vec<(String, String)> = Vec::new()
    built.push((String::from("ws/a/main.wrela"), String::from("x")))
    built.push((String::from("ws/a/subject.wrela"), String::from("0.5")))
    var lifted: Vec<String> = Vec::new()
    lifted.push(String::from("ws/a/subject.wrela"))
    var now = built.clone()
    now[1] = (String::from("ws/a/subject.wrela"), String::from("0.25"))
    assert(only_lifted_changed(built, now, lifted))
    now[0] = (String::from("ws/a/main.wrela"), String::from("y"))
    assert(!only_lifted_changed(built, now, lifted), "another file changed")
    var more = built.clone()
    more.push((String::from("ws/a/z.wrela"), String::new()))
    assert(!only_lifted_changed(built, more, lifted), "a file came")
}

@test
fn a_build_starts_at_its_own_values_and_the_sources_follow() {
    let (values, updates) = seeded([0.5, 1.0, 2.0], Some(Vec::from([0.5, 0.25, 2.0])))
    assert(values.len() == 3 && values[1] == 0.25, "the source's values")
    assert(updates.len() == 1, "one literal changed since the build read it")
    let (i, v) = updates[0]
    assert(i == 1 && v == 0.25)
    let (as_built, none) = seeded([0.5], None)
    assert(as_built[0] == 0.5 && none.len() == 0, "a source past its literals waits for a build")
}

@test
fn a_post_names_the_build_whose_page_made_it() {
    assert(post_route("/t-2/studio/edit") == (String::from("t-2"), String::from("studio/edit")))
    assert(
        post_route("/t-1/studio/state?x=1") == (String::from("t-1"), String::from("studio/state")),
    )
    assert(post_route("/studio/edit") == (String::new(), String::from("studio/edit")))
}
