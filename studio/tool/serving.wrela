// The tool's tests of its server (`serve`): the server runs as the command line runs it, a job
// the test resumes beside its own requests, and the test stops it (`Control::stop`). Pages are
// the lens's own, in Chrome through the browser service, or a test's page beside the lens's
// build that posts what a page may post. Each waits for what the host says (a title, a line the
// lens printed, the server's version), never for a time.

use std::json::{TOP, parse}
use lens::{
    Built, Lens, Place, blob_bytes, build, call, data_of, last_json, logs, read_text, start,
    write_text,
}
use main::{read_command, run}
use server::{Control, control, run_server, serving_place}
use std::collections::{Box, Vec}
use std::input::{Key, Mods, key_of}
use std::io::{IoError, Pending}
use std::job::{Job, Step}
use std::string::String
use std::tool::answer
use std::tool::blob
use std::tool::blob::Data
use std::tool::browser
use std::tool::browser::{Match, Script, Until}
use std::tool::drive
use std::tool::drive::Scalar
use std::tool::files

/// A ball 30 cm across on the ground.
const BALL: Text = "use std::field::{Surface, sphere}\n\npub fn subject() -> Surface {\n    sphere(0.30).translate(vec3(0.0, 0.30, 0.0))\n}\n"

/// Where a test builds the lens on the package `scratch/<name>`.
fn place(name: str) -> Place {
    Place {
        ws: String::from("ws"),
        files: String::from("scratch"),
        outs: String::from("scratch/out"),
        page: String::new(),
        subject: String::from(f"scratch/{name}"),
        out: String::from(f"scratch/out/{name}"),
        overrides: Vec::new(),
        debug: false,
    }
}

/// Writes `text` as the file at `path`, of any size (through a blob past 512 KiB).
@job
fn put(path: take String, text: take String) {
    var d = Box::new(data_of.start(Vec::from(text.as_bytes())))
    var made: Option<Data> = None
    while made.is_none() {
        match d.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                let Ok(data) = take x else { panic("the file's bytes") }
                made = Some(take data)
            },
        }
    }
    let Some(data) = take made else { panic("bytes") }
    var w = match data.clone() {
        Data::Bytes(b) => files::write(path.as_str(), b),
        Data::Blob(b) => files::write_blob(path.as_str(), b),
    }
    var wrote = w.poll()
    while wrote.is_none() {
        yield
        wrote = w.poll()
    }
    let Some(wp) = take wrote else { panic("no answer") }
    assert(answer(take wp).is_ok(), path.as_str())
    if let Data::Blob(b) = data {
        var rel = blob::release(b)
        while rel.poll().is_none() { yield }
    }
}

/// The package `scratch/<name>`: a manifest, an empty main, and its subject `subject`.
@job
fn subject_package(name: take String, subject: take String) {
    var files: Vec<(String, String)> = Vec::new()
    files.push(
        (String::from("wrela.toml"), String::from(f"[package]\nname = \"{name.as_str()}\"\n")),
    )
    files.push(
        (
            String::from("main.wrela"),
            String::from("pub fn frame(time: f32, width: u32, height: u32) {}\n"),
        ),
    )
    files.push((String::from("subject.wrela"), take subject))
    for k in 0..files.len() {
        let (file, text) = files[k].clone()
        var p = Box::new(
            put.start(String::from(f"scratch/{name.as_str()}/{file.as_str()}"), take text),
        )
        loop {
            match p.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => break,
            }
        }
    }
}

/// The lens built at `at`, which must build.
@job
fn built_lens(at: take Place) -> Built {
    var b = Box::new(build.start(take at))
    loop {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(r) => {
                let Ok(built) = take r else { panic("the lens's program is written and built") }
                assert(built.errors.is_empty(), built.errors.as_str())
                return built
            },
        }
    }
}

/// The text of the file at `path`.
@job
fn text_at(path: take String) -> String {
    var r = Box::new(read_text.start(take path))
    loop {
        match r.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                let Ok(Some(t)) = take x else { panic("a file") }
                return t
            },
        }
    }
}

/// The server's next steps until it listens.
@job
fn listening(srv: mut Box<Job<run_server>>, control: mut Control) {
    while control.origin.is_empty() {
        match srv.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(r) => {
                let Err(why) = r else { panic("the server ended") }
                panic(f"the server didn't start: {why.as_str()}")
            },
        }
    }
}

/// The answer to `p`, the server serving meanwhile.
@job
fn while_serving(
    p: take Pending<u8>,
    srv: mut Box<Job<run_server>>,
    control: mut Control,
) -> Result<Vec<u8>, IoError> {
    var p = take p
    loop {
        if let Some(x) = p.poll() {
            return x
        }
        match srv.get_mut().resume(mut control) {
            Step::Yielded => {},
            Step::Done(r) => {
                let Err(why) = r else { panic("the server ended") }
                panic(f"the server failed: {why.as_str()}")
            },
        }
        yield
    }
}

/// The server serving until `done` says its control is as wanted.
@job
fn serving_until(
    srv: mut Box<Job<run_server>>,
    control: mut Control,
    version: take u32,
    updates: take u32,
) {
    while control.version < version || control.updates < updates || control.rebuilding {
        if !control.error.is_empty() {
            panic(f"the lens didn't build: {control.error.as_str()}")
        }
        match srv.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(r) => {
                let Err(why) = r else { panic("the server ended") }
                panic(f"the server failed: {why.as_str()}")
            },
        }
    }
}

/// What `waiting` waits for: a finished build held, a build's error, or a build served after
/// one.
const HELD: u32 = 0
const FAILED: u32 = 1
const RECOVERED: u32 = 2

/// The server serving until `what` holds.
@job
fn waiting(srv: mut Box<Job<run_server>>, control: mut Control, what: take u32) {
    loop {
        let done = if what == HELD {
            control.held
        } else if what == FAILED {
            !control.error.is_empty() && !control.rebuilding
        } else {
            control.version >= 2 && control.error.is_empty() && !control.rebuilding
        }
        if done {
            return
        }
        match srv.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(r) => {
                let Err(why) = r else { panic("the server ended") }
                panic(f"the server failed: {why.as_str()}")
            },
        }
    }
}

/// A browser opened at `url` while the server serves, `script` run on it (whether it held),
/// then its title, and the browser closed.
@job
fn titled(
    url: take String,
    script: take Script,
    srv: mut Box<Job<run_server>>,
    control: mut Control,
) -> (bool, String) {
    var o = Box::new(opened.start(take url))
    var page: Option<browser::Browser> = None
    while page.is_none() {
        match o.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => page = Some(x),
        }
    }
    let Some(br) = take page else { panic("a page") }
    var ok = false
    var r = Box::new(ran.start(br, take script))
    loop {
        match r.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => {
                ok = x
                break
            },
        }
    }
    var title = String::new()
    var t = Box::new(title_of.start(br))
    loop {
        match t.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => {
                title = take x
                break
            },
        }
    }
    var shut = browser::close(br)
    while shut.poll().is_none() { yield }
    (ok, title)
}

/// The server started on the ball `name`, built as a served generation `t-1`, and listening:
/// the build, and the server's job.
@job
fn ball_served(name: take String, control: mut Control) -> (Built, Box<Job<run_server>>) {
    var sp = Box::new(subject_package.start(name.clone(), String::from(BALL)))
    loop {
        match sp.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var b = Box::new(built_lens.start(serving_place(place(name.as_str()), "t")))
    var built: Option<Built> = None
    while built.is_none() {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => built = Some(take x),
        }
    }
    let Some(lb) = take built else { panic("built") }
    var srv = Box::new(run_server.start(place(name.as_str()), lb.clone(), 0, None, name.clone()))
    var l = Box::new(listening.start())
    loop {
        match l.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    (lb, take srv)
}

/// An edit is bound to the build that made its page: a page held on the old build, across a
/// rebuild that renumbers the literals, edits after a second page has loaded the new build, and
/// the edit is refused, the source as it was.
@job
fn an_old_pages_edit_is_refused() {
    var control = control()
    var bs = Box::new(ball_served.start(String::from("stale")))
    var served: Option<(Built, Box<Job<run_server>>)> = None
    while served.is_none() {
        match bs.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(x) => served = Some(take x),
        }
    }
    let Some(pair) = take served else { panic("served") }
    let (lb, srv0) = take pair
    var srv = take srv0
    // The old page: it waits for a new build to be served, then for `go.txt`, then edits
    // literal 0, as its build numbers it.
    var p = Box::new(
        put.start(
            String::from("scratch/out/stale/serve/t-1/old.html"),
            String::from(
                "<!doctype html><title>waiting</title><script>(async () => { const wait = (ms) => new Promise((go) => setTimeout(go, ms)); for (;;) { const s = await (await fetch('studio/state', { method: 'POST', body: JSON.stringify({ since: 0 }) })).json(); if (s.build !== 't-1') break; await wait(50); } for (;;) { const g = await fetch('go.txt', { cache: 'no-store' }); if (g.status === 200) break; await wait(50); } const e = await fetch('studio/edit', { method: 'POST', body: JSON.stringify({ edits: [[0, 0.9]] }) }); document.title = `edit ${await e.text()}`; })().catch((e) => { document.title = `failed ${e}`; });</script>",
            ),
        ),
    )
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var o = Box::new(opened.start(String::from(f"{control.origin.as_str()}/t-1/old.html")))
    var page: Option<browser::Browser> = None
    while page.is_none() {
        match o.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => page = Some(x),
        }
    }
    let Some(old) = take page else { panic("the old page") }
    // A new literal ahead of the radius: literal 0 is another literal in the new build.
    let renumbered = glue::replace(BALL, "sphere(0.30)", "sphere(0.0 + 0.30)")
    var q = Box::new(put.start(String::from("scratch/stale/subject.wrela"), renumbered.clone()))
    loop {
        match q.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var v = Box::new(waiting.start(RECOVERED))
    loop {
        match v.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // A second page loads the new build: it answers as the headless lens on it does.
    var h = Box::new(headless.start(served_build(lb, control), Vec::from([probe_call()])))
    var probed = String::new()
    loop {
        match h.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                probed = take line
                break
            },
        }
    }
    var agreed = false
    for _ in 0..6 {
        if agreed {
            break
        }
        var t = Box::new(
            titled.start(
                String::from(f"{control.origin.as_str()}/"),
                typed("probe 0 0.6 0").wait(Until::printed(probed.as_str()), timeout: 15.0),
            ),
        )
        loop {
            match t.get_mut().resume(mut srv, mut control) {
                Step::Yielded => yield,
                Step::Done(x) => {
                    let (ok, _) = take x
                    agreed = ok
                    break
                },
            }
        }
    }
    assert(agreed, "the second page has the new build")
    // Then the old page edits.
    var go = Box::new(
        put.start(String::from("scratch/out/stale/serve/t-1/go.txt"), String::from("go")),
    )
    loop {
        match go.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var r = Box::new(
        ran.start(old, Script::new().wait(Until::title(Match::starts("edit")), timeout: 60.0)),
    )
    loop {
        match r.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(ok) => {
                assert(ok, "the old page's edit is answered")
                break
            },
        }
    }
    var t = Box::new(title_of.start(old))
    loop {
        match t.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(title) => {
                assert(title.as_str().find("\"written\":false").is_some(), title.as_str())
                assert(title.as_str().find("another build").is_some(), title.as_str())
                break
            },
        }
    }
    var shut = browser::close(old)
    while shut.poll().is_none() { yield }
    var src = Box::new(text_at.start(String::from("scratch/stale/subject.wrela")))
    loop {
        match src.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(text) => {
                assert(text == renumbered, "the source is as it was")
                break
            },
        }
    }
    var st = Box::new(stopped.start())
    loop {
        match st.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// A literal changed while the lens is built again reaches the page of the new build: the
/// build is held once it's done, the radius changed, then the build is served, and Chrome's lens
/// answers as the headless lens does with the new radius, with no other edit.
@job
fn a_literal_changed_during_a_rebuild_reaches_the_page() {
    var control = control()
    var bs = Box::new(ball_served.start(String::from("held")))
    var served: Option<(Built, Box<Job<run_server>>)> = None
    while served.is_none() {
        match bs.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(x) => served = Some(take x),
        }
    }
    let Some(pair) = take served else { panic("served") }
    let (lb, srv0) = take pair
    var srv = take srv0
    control.hold = true
    let moved = glue::replace(
        BALL,
        "vec3(0.0, 0.30, 0.0))",
        "vec3(0.0, 0.30, 0.0)).translate(vec3(0.0))",
    )
    var q = Box::new(put.start(String::from("scratch/held/subject.wrela"), moved.clone()))
    loop {
        match q.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var w = Box::new(waiting.start(HELD))
    loop {
        match w.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // The build has read its sources: the radius changes now.
    var r = Box::new(
        put.start(
            String::from("scratch/held/subject.wrela"),
            glue::replace(moved.as_str(), "sphere(0.30)", "sphere(0.20)"),
        ),
    )
    loop {
        match r.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    control.hold = false
    var v = Box::new(waiting.start(RECOVERED))
    loop {
        match v.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    let now = served_build(lb, control)
    var h1 = Box::new(
        headless.start(
            now.clone(),
            Vec::from([(String::from("set"), Vec::from([Scalar::I32(0), Scalar::F32(0.2)]))]),
        ),
    )
    var set_answer = String::new()
    loop {
        match h1.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                set_answer = take line
                break
            },
        }
    }
    var h2 = Box::new(
        headless.start(
            now.clone(),
            Vec::from(
                [
                    (String::from("set"), Vec::from([Scalar::I32(0), Scalar::F32(0.2)])),
                    probe_call(),
                ],
            ),
        ),
    )
    var probed = String::new()
    loop {
        match h2.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                probed = take line
                break
            },
        }
    }
    // The page of the new build sets the radius the source has, then probes as the headless lens.
    let waited = Script::new().wait(Until::printed(set_answer.as_str()), timeout: 30.0)
    let script = typed_after(take waited, "probe 0 0.6 0").wait(
        Until::printed(probed.as_str()),
        timeout: 30.0,
    )
    var t = Box::new(titled.start(String::from(f"{control.origin.as_str()}/"), take script))
    loop {
        match t.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => {
                let (ok, _) = take x
                assert(
                    ok,
                    f"Chrome's lens has the radius changed during the build: {probed.as_str()}",
                )
                break
            },
        }
    }
    var st = Box::new(stopped.start())
    loop {
        match st.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// A build that fails leaves the last good one served: pages opened then load it, the state
/// says why, and once the source is fixed, the lens is built and served again.
@job
fn a_failed_rebuild_keeps_the_last_good_build() {
    var control = control()
    var bs = Box::new(ball_served.start(String::from("broken")))
    var served: Option<(Built, Box<Job<run_server>>)> = None
    while served.is_none() {
        match bs.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(x) => served = Some(take x),
        }
    }
    let Some(pair) = take served else { panic("served") }
    let (lb, srv0) = take pair
    var srv = take srv0
    var p = Box::new(
        put.start(
            String::from("scratch/out/broken/serve/t-1/state.html"),
            String::from(
                "<!doctype html><title>waiting</title><script>(async () => { const s = await (await fetch('studio/state', { method: 'POST', body: JSON.stringify({ since: 0 }) })).json(); document.title = `state ${s.error === null ? 'none' : 'error'} ${s.build}`; })().catch((e) => { document.title = `failed ${e}`; });</script>",
            ),
        ),
    )
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var q = Box::new(
        put.start(
            String::from("scratch/broken/subject.wrela"),
            glue::replace(BALL, "pub fn subject() -> Surface {", "pub fn subject( -> Surface {"),
        ),
    )
    loop {
        match q.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var w = Box::new(waiting.start(FAILED))
    loop {
        match w.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    assert(control.build.as_str() == "t-1" && control.version == 1, "the last good build is served")
    // A page opened now, twice, loads the last good build, and answers as it does.
    var h = Box::new(headless.start(lb.clone(), Vec::from([probe_call()])))
    var probed = String::new()
    loop {
        match h.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                probed = take line
                break
            },
        }
    }
    for _ in 0..2 {
        var agreed = false
        for _ in 0..6 {
            if agreed {
                break
            }
            var t = Box::new(
                titled.start(
                    String::from(f"{control.origin.as_str()}/"),
                    typed("probe 0 0.6 0").wait(Until::printed(probed.as_str()), timeout: 15.0),
                ),
            )
            loop {
                match t.get_mut().resume(mut srv, mut control) {
                    Step::Yielded => yield,
                    Step::Done(x) => {
                        let (ok, _) = take x
                        agreed = ok
                        break
                    },
                }
            }
        }
        assert(agreed, "a page opened after the failed build has the last good one")
    }
    var s1 = Box::new(
        titled.start(
            String::from(f"{control.origin.as_str()}/t-1/state.html"),
            Script::new().wait(Until::title(Match::starts("state")), timeout: 30.0),
        ),
    )
    loop {
        match s1.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => {
                let (_, title) = take x
                assert(title.as_str() == "state error t-1", title.as_str())
                break
            },
        }
    }
    // Fixed: built and served again.
    var f = Box::new(put.start(String::from("scratch/broken/subject.wrela"), String::from(BALL)))
    loop {
        match f.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var v = Box::new(waiting.start(RECOVERED))
    loop {
        match v.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    assert(control.build.as_str() == "t-2", control.build.as_str())
    var st = Box::new(stopped.start())
    loop {
        match st.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// The server stopped: its port closed, its reference given back.
@job
fn stopped(srv: mut Box<Job<run_server>>, control: mut Control) {
    control.stop = true
    loop {
        match srv.get_mut().resume(mut control) {
            Step::Yielded => yield,
            Step::Done(r) => {
                assert(r.is_ok(), "the server stops")
                return
            },
        }
    }
}

/// A browser opened at `url`, the server serving meanwhile.
@job
fn opened(
    url: take String,
    srv: mut Box<Job<run_server>>,
    control: mut Control,
) -> browser::Browser {
    var j = Box::new(while_serving.start(browser::open(url.as_str(), width: 640, height: 480)))
    loop {
        match j.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => {
                match browser::read_opened(take x) {
                    Ok(b) => return b,
                    Err(e) => panic(f"the page opens: {e.message()}"),
                }
            },
        }
    }
}

/// `script` run on `b`, the server serving meanwhile: whether every step held.
@job
fn ran(
    b: take browser::Browser,
    script: take Script,
    srv: mut Box<Job<run_server>>,
    control: mut Control,
) -> bool {
    var j = Box::new(while_serving.start(browser::run(b, script, 120.0)))
    loop {
        match j.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => return answer(take x).is_ok(),
        }
    }
}

/// `b`'s title, the server serving meanwhile.
@job
fn title_of(
    b: take browser::Browser,
    srv: mut Box<Job<run_server>>,
    control: mut Control,
) -> String {
    var j = Box::new(while_serving.start(browser::title(b)))
    loop {
        match j.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => {
                let Ok(t) = browser::read_text(take x) else { panic("the title") }
                return t
            },
        }
    }
}

/// `line` typed into the lens, then Enter, as a person types it.
fn typed(line: str) -> Script {
    typed_after(Script::new(), line)
}

/// `script`, then `line` typed.
fn typed_after(script: take Script, line: str) -> Script {
    var s = take script
    for i in 0..line.len() {
        let c = line.byte(i)
        let code = if c >= 97 && c <= 122 {
            u32(c - 96)
        } else if c >= 48 && c <= 57 {
            27 + u32(c - 48)
        } else if c == 32 {
            41
        } else if c == 45 {
            61
        } else if c == 46 {
            70
        } else if c == 95 {
            61
        } else {
            panic(f"no key types `{line}`")
        }
        s = take s.press(key_of(code), mods: Mods { shift: c == 95 })
    }
    take s.press(Key::Enter)
}

/// The lens's answer, headless on the CPU, to `calls` on the build `built`: the last JSON line
/// the last call printed.
@job
fn headless(built: take Built, calls: take Vec<(String, Vec<Scalar>)>) -> String {
    var s = Box::new(start.start(take built, width: 64, height: 64, cpu: true, reference: None))
    var started: Option<Lens> = None
    while started.is_none() {
        match s.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                let Ok(l) = take x else { panic("the lens starts") }
                started = Some(take l)
            },
        }
    }
    let Some(l) = take started else { panic("a lens") }
    var lens = take l
    var line = String::new()
    for k in 0..calls.len() {
        let (name, args) = calls[k].clone()
        var c = drive::call(lens.b, name.as_str(), args)
        while c.poll().is_none() { yield }
        var g = Box::new(logs.start())
        loop {
            match g.get_mut().resume(mut lens) {
                Step::Yielded => yield,
                Step::Done(x) => {
                    let Ok(lines) = take x else { panic("lines") }
                    if let Some(j) = last_json(lines) {
                        line = take j
                    }
                    break
                },
            }
        }
    }
    var cl = drive::close(lens.b)
    while cl.poll().is_none() { yield }
    line
}

/// The build the server serves now: `built`'s program, in the page `control` names.
fn served_build(built: Built, control: Control) -> Built {
    var b = built.clone()
    b.page = control.page.clone()
    b
}

fn probe_call() -> (String, Vec<Scalar>) {
    (String::from("probe"), Vec::from([Scalar::F32(0.0), Scalar::F32(0.6), Scalar::F32(0.0)]))
}

/// A watched source past 512 KiB is read through a blob: a change to its literals goes to the
/// lens as new values, and a change to its code builds the lens again.
@test(tool, read: [("ws", "../..")], budget: 300)
@job
fn a_large_source_is_watched_through_both_paths() {
    // The ball, with 600 KiB of comment after it.
    var padding = String::new()
    for _ in 0..10000 {
        padding.push_str("// sixty bytes of a comment that makes the file large: ......\n")
    }
    let big = String::from(f"{BALL}{padding.as_str()}")
    var sp = Box::new(subject_package.start(String::from("big"), big.clone()))
    loop {
        match sp.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var b = Box::new(built_lens.start(serving_place(place("big"), "t")))
    var built: Option<Built> = None
    while built.is_none() {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => built = Some(take x),
        }
    }
    let Some(lb) = take built else { panic("built") }
    var control = control()
    var srv = Box::new(run_server.start(place("big"), take lb, 0, None, String::from("big")))
    var l = Box::new(listening.start())
    loop {
        match l.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // A literal: a new value, with no build.
    var p = Box::new(
        put.start(
            String::from("scratch/big/subject.wrela"),
            glue::replace(big.as_str(), "sphere(0.30)", "sphere(0.25)"),
        ),
    )
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var u = Box::new(serving_until.start(version: 1, updates: 1))
    loop {
        match u.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    assert(control.version == 1, "a literal's change isn't a build")
    // Code: a build.
    var q = Box::new(
        put.start(
            String::from("scratch/big/subject.wrela"),
            glue::replace(big.as_str(), "sphere(0.30)", "sphere(0.25).translate(vec3(0.0))"),
        ),
    )
    loop {
        match q.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var v = Box::new(serving_until.start(version: 2, updates: 1))
    loop {
        match v.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var s = Box::new(stopped.start())
    loop {
        match s.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// A PNG path outside the workspace's directory is refused before anything is built; one in
/// it is where the screen is written.
@test(tool, read: [("ws", "../..")], budget: 300)
@job
fn a_png_outside_the_workspace_is_refused_before_building() {
    var sp = Box::new(subject_package.start(String::from("pictured"), String::from(BALL)))
    loop {
        match sp.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    for png in ["/tmp/shot.png", "../shot.png", "shot.png"] {
        var words: Vec<String> = Vec::new()
        for w in ["pictured", "parts", "--png", png, "--size", "64x64"] {
            words.push(String::from(w))
        }
        let Some(c) = read_command(words) else { panic("a command") }
        var r = Box::new(
            run.start(place("pictured"), take c, String::from("parts"), String::from("pictured")),
        )
        var status = 0
        loop {
            match r.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(s) => {
                    status = s
                    break
                },
            }
        }
        var st = files::stat("scratch/out")
        var stated = st.poll()
        while stated.is_none() {
            yield
            stated = st.poll()
        }
        let Some(sp2) = take stated else { panic("no answer") }
        let built = files::read_entry(take sp2).is_ok()
        if png == "shot.png" {
            assert(status == 0 && built, "a PNG in the workspace")
            var s = files::stat("scratch/shot.png")
            var shot = s.poll()
            while shot.is_none() {
                yield
                shot = s.poll()
            }
            let Some(shp) = take shot else { panic("no answer") }
            let Ok(e) = files::read_entry(take shp) else { panic("the PNG is written") }
            assert(e.size > 0, "an image")
        } else {
            assert(status == 2 && !built, png)
        }
    }
}

/// A post of a body past 512 KiB (a blob to the tool) is answered, and the server goes on; and a
/// fit's reference is one blob for every fit: a page asks for a 1024×1024 reference again and
/// again within a blob budget of a few of them, and each answer is whole.
@job
fn large_posts_and_references_are_answered_within_the_blob_budget() {
    var sp = Box::new(subject_package.start(String::from("fitted"), String::from(BALL)))
    loop {
        match sp.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var b = Box::new(built_lens.start(serving_place(place("fitted"), "t")))
    var built: Option<Built> = None
    while built.is_none() {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => built = Some(take x),
        }
    }
    let Some(lb) = take built else { panic("built") }
    var p = Box::new(
        put.start(
            String::from("scratch/out/fitted/serve/t-1/fits.html"),
            String::from(
                "<!doctype html><title>waiting</title><script>(async () => { const big = await fetch('studio/state', { method: 'POST', body: 'x'.repeat(524289) }); await big.text(); const s = await fetch('studio/state', { method: 'POST', body: JSON.stringify({ since: 0 }) }); const j = await s.json(); let whole = 0; for (let i = 0; i < 12; i++) { const r = await fetch('studio/reference', { method: 'POST', body: 'reference' }); const b = await r.arrayBuffer(); if (r.status === 200 && b.byteLength === 1048580) whole++; } document.title = `done ${big.status} ${s.status} ${j.version} ${whole}`; })().catch((e) => { document.title = `failed ${e}`; });</script>",
            ),
        ),
    )
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var mask: Vec<u8> = Vec::with_capacity(4 + 1024 * 1024)
    mask.push(0)
    mask.push(4)
    mask.push(0)
    mask.push(0)
    for i in 0..1024 * 1024 {
        mask.push(u8(i % 2))
    }
    var control = control()
    var srv = Box::new(
        run_server.start(place("fitted"), take lb, 0, Some(take mask), String::from("fitted")),
    )
    var l = Box::new(listening.start())
    loop {
        match l.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var o = Box::new(opened.start(String::from(f"{control.origin.as_str()}/t-1/fits.html")))
    var page: Option<browser::Browser> = None
    while page.is_none() {
        match o.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => page = Some(x),
        }
    }
    let Some(br) = take page else { panic("a page") }
    var r = Box::new(
        ran.start(br, Script::new().wait(Until::title(Match::starts("done")), timeout: 60.0)),
    )
    loop {
        match r.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(ok) => {
                assert(ok, "the page's fits were answered")
                break
            },
        }
    }
    var t = Box::new(title_of.start(br))
    loop {
        match t.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(title) => {
                assert(title.as_str() == "done 200 200 1 12", title.as_str())
                break
            },
        }
    }
    // The browser closes first: one Chrome at a time.
    var shut = browser::close(br)
    while shut.poll().is_none() { yield }
    var s = Box::new(stopped.start())
    loop {
        match s.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// A subject whose build computes a constant for a while: changing the constant's count builds
/// it again, slowly.
const SLOW: Text = "use std::field::{Surface, sphere}\n\nfn spin(n: u32) -> u32 {\n    var s: u32 = 0\n    for i in 0..n {\n        s = s ^ i.wrapping_mul(2654435761)\n    }\n    s\n}\n\nconst TURNS: u32 = spin(150000000)\n\npub fn subject() -> Surface {\n    sphere(0.30 + f32(TURNS & 1) * 0.0).translate(vec3(0.0, 0.30, 0.0))\n}\n"

/// While the lens is built again, the server answers its page: state says it's rebuilding, and an
/// edit is refused, saying so, rather than written against literals of another build.
@job
fn the_server_answers_while_the_lens_is_built_again() {
    var sp = Box::new(subject_package.start(String::from("slow"), String::from(SLOW)))
    loop {
        match sp.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var b = Box::new(built_lens.start(serving_place(place("slow"), "t")))
    var built: Option<Built> = None
    while built.is_none() {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => built = Some(take x),
        }
    }
    let Some(lb) = take built else { panic("built") }
    var p = Box::new(
        put.start(
            String::from("scratch/out/slow/serve/t-1/rebuild.html"),
            String::from(
                "<!doctype html><title>waiting</title><script>(async () => { for (;;) { const r = await fetch('studio/state', { method: 'POST', body: JSON.stringify({ since: 0, version: 1 }) }); const s = await r.json(); if (s.rebuilding) { const e = await fetch('studio/edit', { method: 'POST', body: JSON.stringify({ edits: [[0, 0.2]] }) }); document.title = `seen ${await e.text()}`; return; } await new Promise((go) => setTimeout(go, 20)); } })().catch((e) => { document.title = `failed ${e}`; });</script>",
            ),
        ),
    )
    loop {
        match p.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var control = control()
    var srv = Box::new(run_server.start(place("slow"), take lb, 0, None, String::from("slow")))
    var l = Box::new(listening.start())
    loop {
        match l.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var o = Box::new(opened.start(String::from(f"{control.origin.as_str()}/t-1/rebuild.html")))
    var page: Option<browser::Browser> = None
    while page.is_none() {
        match o.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => page = Some(x),
        }
    }
    let Some(br) = take page else { panic("a page") }
    // The constant's count changes: a slow build.
    var q = Box::new(
        put.start(
            String::from("scratch/slow/subject.wrela"),
            glue::replace(SLOW, "spin(150000000)", "spin(150000001)"),
        ),
    )
    loop {
        match q.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var r = Box::new(
        ran.start(br, Script::new().wait(Until::title(Match::starts("seen")), timeout: 110.0)),
    )
    loop {
        match r.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(ok) => {
                assert(ok, "the state said it was rebuilding while it was")
                break
            },
        }
    }
    var t = Box::new(title_of.start(br))
    loop {
        match t.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(title) => {
                assert(title.as_str().find("\"written\":false").is_some(), title.as_str())
                assert(title.as_str().find("built again").is_some(), title.as_str())
                break
            },
        }
    }
    var source = Box::new(text_at.start(String::from("scratch/slow/subject.wrela")))
    loop {
        match source.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(text) => {
                assert(text.as_str().find("sphere(0.30 ").is_some(), "the edit wasn't written")
                break
            },
        }
    }
    var v = Box::new(serving_until.start(version: 2, updates: 0))
    loop {
        match v.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // The browser closes first: one Chrome at a time.
    var shut = browser::close(br)
    while shut.poll().is_none() { yield }
    var s = Box::new(stopped.start())
    loop {
        match s.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// The lens in Chrome, served by the tool, as a person uses it: a typed action answers as the
/// headless lens does; a typed `set` and `write` write the source as the headless lens writes
/// it; another tool's change to a literal reaches the open lens; and a change to the code builds
/// the lens again, and the page reloads with it.
@job
fn the_served_lens_in_chrome_answers_and_writes_as_the_headless_one() {
    for name in ["served"] {
        var sp = Box::new(subject_package.start(String::from(name), String::from(BALL)))
        loop {
            match sp.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(_) => break,
            }
        }
    }
    var b = Box::new(built_lens.start(serving_place(place("served"), "t")))
    var built: Option<Built> = None
    while built.is_none() {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => built = Some(take x),
        }
    }
    let Some(lb) = take built else { panic("built") }
    // The headless answers: the probe as built, and after the radius is 0.35 (literal 0, the
    // ball's one radius... found by its text).
    var h0 = Box::new(
        headless.start(lb.clone(), Vec::from([(String::from("literals"), Vec::new())])),
    )
    var radius = 0
    loop {
        match h0.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                let Some(d) = parse(line.as_str()) else { panic(line.as_str()) }
                let Some(list) = d.get(TOP, "literals") else { panic("literals") }
                for k in 0..d.count(list) {
                    let Some(lit) = d.at(list, k) else { continue }
                    let Some(t) = d.get(lit, "text") else { continue }
                    let Some(c) = d.get(lit, "column") else { continue }
                    if d.text(t) == Some(String::from("0.30")) && d.num(c) == Some(12.0) {
                        let Some(i) = d.get(lit, "index") else { continue }
                        let Some(n) = d.num(i) else { continue }
                        radius = u32(n)
                    }
                }
                break
            },
        }
    }
    var h1 = Box::new(headless.start(lb.clone(), Vec::from([probe_call()])))
    var probed = String::new()
    loop {
        match h1.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                probed = take line
                break
            },
        }
    }
    var h2 = Box::new(
        headless.start(
            lb.clone(),
            Vec::from(
                [
                    (String::from("set"), Vec::from([Scalar::I32(i32(radius)), Scalar::F32(0.35)])),
                    probe_call(),
                ],
            ),
        ),
    )
    var probed_after = String::new()
    loop {
        match h2.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                probed_after = take line
                break
            },
        }
    }
    // The headless write, on the same build and files, which are then put back as they were
    // built.
    var hs = Box::new(start.start(lb.clone(), width: 64, height: 64, cpu: false, reference: None))
    var hl: Option<Lens> = None
    while hl.is_none() {
        match hs.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(x) => {
                let Ok(l) = take x else { panic("the headless lens") }
                hl = Some(take l)
            },
        }
    }
    let Some(hll) = take hl else { panic("a lens") }
    var hlens = take hll
    for k in 0..2 {
        let (name, args) = if k == 0 {
            (String::from("set"), Vec::from([Scalar::I32(i32(radius)), Scalar::F32(0.25)]))
        } else {
            (String::from("write"), Vec::new())
        }
        var c = Box::new(call.start(take name, take args, deferred: false))
        loop {
            match c.get_mut().resume(mut hlens) {
                Step::Yielded => yield,
                Step::Done(x) => {
                    assert(x.is_ok(), "the headless write")
                    break
                },
            }
        }
    }
    var hc = drive::close(hlens.b)
    while hc.poll().is_none() { yield }
    var hw = Box::new(text_at.start(String::from("scratch/served/subject.wrela")))
    var headless_source = String::new()
    loop {
        match hw.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(t) => {
                headless_source = take t
                break
            },
        }
    }
    assert(headless_source.as_str().find("sphere(0.25)").is_some(), headless_source.as_str())
    var back = Box::new(put.start(String::from("scratch/served/subject.wrela"), String::from(BALL)))
    loop {
        match back.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // Served, in Chrome.
    var control = control()
    var srv = Box::new(
        run_server.start(place("served"), lb.clone(), 0, None, String::from("served")),
    )
    var l = Box::new(listening.start())
    loop {
        match l.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var o = Box::new(opened.start(String::from(f"{control.origin.as_str()}/")))
    var page: Option<browser::Browser> = None
    while page.is_none() {
        match o.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(x) => page = Some(x),
        }
    }
    let Some(br) = take page else { panic("a page") }
    // A typed probe answers as the headless one: typed again until the lens has started and
    // takes its keys.
    var agreed = false
    for _ in 0..6 {
        if agreed {
            break
        }
        let script = typed("probe 0 0.6 0").wait(Until::printed(probed.as_str()), timeout: 15.0)
        var r = Box::new(ran.start(br, take script))
        loop {
            match r.get_mut().resume(mut srv, mut control) {
                Step::Yielded => yield,
                Step::Done(ok) => {
                    agreed = ok
                    break
                },
            }
        }
    }
    assert(agreed, f"Chrome's probe answers {probed.as_str()}")
    // A typed write: the source as the headless write left it.
    let set_line = String::from(f"set {radius} 0.25")
    let script = typed(set_line.as_str())
    var w = Box::new(ran.start(br, take script))
    loop {
        match w.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(ok) => {
                assert(ok, "typed")
                break
            },
        }
    }
    var w2 = Box::new(ran.start(br, typed("write")))
    loop {
        match w2.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(ok) => {
                assert(ok, "typed")
                break
            },
        }
    }
    var written = false
    while !written {
        var t = Box::new(text_at.start(String::from("scratch/served/subject.wrela")))
        loop {
            match t.get_mut().resume() {
                Step::Yielded => yield,
                Step::Done(text) => {
                    written = text == headless_source
                    break
                },
            }
        }
        if !written {
            // Serve a step (the write's post) before looking again.
            match srv.get_mut().resume(mut control) {
                Step::Yielded => yield,
                Step::Done(_) => panic("the server ended"),
            }
        }
    }
    // Another tool's change of the radius: the open lens gets it, and probes as the headless
    // lens does with it.
    var x = Box::new(
        put.start(
            String::from("scratch/served/subject.wrela"),
            glue::replace(headless_source.as_str(), "sphere(0.25)", "sphere(0.35)"),
        ),
    )
    loop {
        match x.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var u = Box::new(serving_until.start(version: 1, updates: 1))
    loop {
        match u.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // The page types the new value into the lens as `set`, as the headless lens answers it;
    // then a typed probe.
    var hset = Box::new(
        headless.start(
            lb.clone(),
            Vec::from(
                [(String::from("set"), Vec::from([Scalar::I32(i32(radius)), Scalar::F32(0.35)]))],
            ),
        ),
    )
    var set_answer = String::new()
    loop {
        match hset.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                set_answer = take line
                break
            },
        }
    }
    let waited = Script::new().wait(Until::printed(set_answer.as_str()), timeout: 30.0)
    let after = typed_after(take waited, "probe 0 0.6 0")
        .wait(Until::printed(probed_after.as_str()), timeout: 30.0)
    var r2 = Box::new(ran.start(br, take after))
    loop {
        match r2.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(ok) => {
                assert(ok, f"after the change, Chrome's probe answers {probed_after.as_str()}")
                break
            },
        }
    }
    // Code: a new build, and the page reloads with it, as a new headless build answers.
    let moved = glue::replace(headless_source.as_str(), "sphere(0.25)", "sphere(0.35)")
    let changed = glue::replace(
        moved.as_str(),
        "vec3(0.0, 0.30, 0.0))",
        "vec3(0.0, 0.30, 0.0)).translate(vec3(0.0, 0.1, 0.0))",
    )
    var y = Box::new(put.start(String::from("scratch/served/subject.wrela"), take changed))
    loop {
        match y.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var v = Box::new(serving_until.start(version: 2, updates: 0))
    loop {
        match v.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    // The new build is the server's next generation: the headless lens loads it there.
    var h3 = Box::new(headless.start(served_build(lb, control), Vec::from([probe_call()])))
    var probed_rebuilt = String::new()
    loop {
        match h3.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(line) => {
                probed_rebuilt = take line
                break
            },
        }
    }
    assert(probed_rebuilt != probed_after, "the new build answers otherwise")
    var reloaded = false
    for _ in 0..6 {
        if reloaded {
            break
        }
        let script = typed("probe 0 0.6 0").wait(
            Until::printed(probed_rebuilt.as_str()),
            timeout: 15.0,
        )
        var r3 = Box::new(ran.start(br, take script))
        loop {
            match r3.get_mut().resume(mut srv, mut control) {
                Step::Yielded => yield,
                Step::Done(ok) => {
                    reloaded = ok
                    break
                },
            }
        }
    }
    assert(reloaded, f"after the reload, Chrome's probe answers {probed_rebuilt.as_str()}")
    // The browser closes first: one Chrome at a time.
    var shut = browser::close(br)
    while shut.poll().is_none() { yield }
    var s = Box::new(stopped.start())
    loop {
        match s.get_mut().resume(mut srv, mut control) {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}

/// The server in Chrome, one browser at a time: large posts and a fit's references within a
/// blob budget, the posts answered while the lens is built again, and the lens as a person uses
/// it, beside the headless one.
@test(tool, read: [("ws", "../..")], browser: true, budget: 600, blobs: "6M,64")
@job
fn the_server_serves_chrome() {
    var a = Box::new(large_posts_and_references_are_answered_within_the_blob_budget.start())
    loop {
        match a.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var b = Box::new(the_server_answers_while_the_lens_is_built_again.start())
    loop {
        match b.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var c = Box::new(the_served_lens_in_chrome_answers_and_writes_as_the_headless_one.start())
    loop {
        match c.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var d = Box::new(an_old_pages_edit_is_refused.start())
    loop {
        match d.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var e = Box::new(a_literal_changed_during_a_rebuild_reaches_the_page.start())
    loop {
        match e.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
    var g = Box::new(a_failed_rebuild_keeps_the_last_good_build.start())
    loop {
        match g.get_mut().resume() {
            Step::Yielded => yield,
            Step::Done(_) => break,
        }
    }
}
