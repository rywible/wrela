// The lens built and driven: the glue written into the tool's output beside a probe, the
// program built lifted through the toolchain (the subject read as a dependency overridden with
// its directory, so nothing is written beside its sources), and the build loaded on the native
// host through `std::tool::drive`. A headless action is the lens's export called, then frames
// until the lens isn't busy; the lens's posts (its edits, `studio/edit`, and a fit's reference,
// `studio/reference`) go to the tool, which writes edits through `toolchain::edit` (`wrela
// edit`'s code) and answers a reference with the mask it was given.

use glue::{
    LensKind, course_text, floor_text, glue_text, has_geology, lens_kind, manifest, package_name,
    probe_main, probe_queries, probe_text, read_probe,
}
use std::json::{Kind, TOP, parse}
use json::quoted
use std::collections::{Vec, replace}
use std::input::{Key, Script}
use std::math::is_finite
use std::string::String
use std::tool::{Call, MOST_BYTES, Request, ToolError}
use std::tool::blob
use std::tool::blob::Data
use std::tool::drive
use std::tool::drive::{Scalar, Seen, Step}
use std::tool::files
use std::tool::image
use std::tool::toolchain
use std::tool::toolchain::Override
use toolkit::whole::{blob_of, chunked, data_bytes, joined, write_data}

/// The lens's exported actions: each one's name and arguments (`f`: an `f32`, `u`: a `u32`).
/// studio/glue exports each, and the headless runner calls them by this table.
pub const ACTIONS: [(Text, Text); 22] = [
    ("view", "u"),
    ("zoom", "ffff"),
    ("spec", ""),
    ("blueprint", "u"),
    ("fit_blueprint", "uu"),
    ("mode", "uu"),
    ("parts", ""),
    ("probe", "fff"),
    ("project", "fff"),
    ("ray", "ffffff"),
    ("measure", "ffffff"),
    ("diagnose", "ffff"),
    ("describe", ""),
    ("literals", ""),
    ("set", "uf"),
    ("click", "ff"),
    ("move", "ffffff"),
    ("choose", "u"),
    ("choose_none", ""),
    ("silhouette", "uffffu"),
    ("fit", "uffffu"),
    ("write", ""),
]

/// The map lens's exported actions, as `ACTIONS` lists the field lens's.
pub const MAP_ACTIONS: [(Text, Text); 10] = [
    ("show", "u"),
    ("zoom", "fff"),
    ("items", ""),
    ("click", "ff"),
    ("move", "ffff"),
    ("check", ""),
    ("write", ""),
    ("walk", ""),
    ("point", "ff"),
    ("geology", "u"),
]

/// The course lens's exported actions, as `ACTIONS` lists the field lens's.
pub const COURSE_ACTIONS: [(Text, Text); 5] = [
    ("zoom", "fff"),
    ("corners", ""),
    ("click", "ff"),
    ("move", "ffff"),
    ("write", ""),
]

/// How long a headless run waits for the lens at most, in the host's seconds: for the GPU's
/// answers, or for work on its helpers (the map lens's preview history, a few seconds).
pub const WAIT: f64 = 120.0

/// Where a lens is built: the root path of the workspace's directory (`ws`: it holds studio/,
/// studio/glue, studio/maplens, studio/courselens and engine/), the directories the command line's paths are from
/// (`files`) and the lenses' programs go in (`outs`, in a write root), the subject's package,
/// the directory its programs and its build go in, the dependencies the subject's own manifest
/// reads from elsewhere (a copy's), and whether the build is a debug one.
pub struct Place: Clone {
    pub ws: String,
    pub files: String,
    pub outs: String,
    /// The directory the build goes in (empty: `<out>/page`).
    pub page: String,
    pub subject: String,
    pub out: String,
    pub overrides: Vec<Override>,
    pub debug: bool,
}

/// A lens built: its subject's name, which lens it is, its program's directory, its build's
/// (`page`), how many warnings the build had, and its errors as `wrela check` shows them (empty
/// if it built).
pub struct Built: Clone {
    pub errors: String,
    pub name: String,
    pub kind: LensKind,
    pub program: String,
    pub page: String,
    pub warnings: u32,
}

/// Reads the text file at `path`: `None` if it isn't there.
pub fn read_text(path: str) -> Result<Option<String>, ToolError> {
    if files::stat(path).wait().is_err() {
        return Ok(None)
    }
    match String::from_utf8(files::read(path).wait()?) {
        Some(s) => Ok(Some(s)),
        None => Err(ToolError::new("a file isn't UTF-8")),
    }
}

/// Reads the text file at `path`, which must be there.
fn needed_text(path: str) -> Result<String, ToolError> {
    let Some(text) = read_text(path)? else { return Err(ToolError::new(f"there's no {path}")) }
    Ok(text)
}

/// Writes `text` as the whole file at `path`, in a write root.
pub fn write_text(path: str, text: str) -> Result<(), ToolError> {
    let _ = files::write(path, String::from(text).as_bytes()).wait()?
    Ok(())
}

/// A lens's build under way, a request at a time, so a caller can answer other requests
/// meanwhile (the server's rebuild): the subject's name, which lens it is, the program's
/// directory, its build's, the workspace's directory and the build's options, and the request
/// it waits on: a field lens's probe query, then the build.
pub struct Building {
    name: String,
    kind: LensKind,
    program: String,
    page: String,
    ws: String,
    options: toolchain::BuildOptions,
    query: Option<Call<String>>,
    build: Option<Call<toolchain::Built>>,
}

/// Starts building the lens on the subject at `place`: the glue written into `place.out`, and
/// for a field lens the probe written and asked about, then (`Building::advance`) the program
/// built lifted into `place.out/page`.
pub fn begin(place: Place) -> Result<Building, ToolError> {
    let subject = place.subject.as_str()
    let out = place.out.as_str()
    let ws = place.ws.as_str()
    // The subject's name, and which lens shows it.
    let Some(m) = read_text(f"{subject}/wrela.toml")? else {
        return Err(ToolError::new(f"`{subject}` isn't a package: it has no wrela.toml"))
    }
    let name = package_name(m.as_str(), subject)
    var kind = LensKind::Field
    var geology = false
    if let Some(t) = read_text(f"{subject}/lens.wrela")? {
        kind = lens_kind(t.as_str())
        geology = has_geology(t.as_str())
    }
    // What the program is, and what's written for it.
    var overrides: Vec<Override> = place.overrides.clone()
    overrides.push(Override { name: name.clone(), dir: String::from(subject) })
    overrides.push(Override { name: String::from("studio"), dir: String::from(f"{ws}/studio") })
    var options = toolchain::options()
    options.debug = place.debug
    let page = if place.page.is_empty() {
        String::from(f"{out}/page")
    } else {
        place.page.clone()
    }
    var b = Building {
        name: name.clone(),
        kind,
        program: String::from(f"{out}/lens"),
        page,
        ws: String::from(ws),
        options: toolchain::options(),
        query: None,
        build: None,
    }
    if kind == LensKind::Course {
        b.program = String::from(f"{out}/course")
        let glue_dir = String::from(f"{ws}/studio/courselens/glue")
        let main = needed_text(f"{glue_dir.as_str()}/main.wrela")?
        write_text(f"{b.program.as_str()}/main.wrela", main.as_str())?
        let course = needed_text(f"{glue_dir.as_str()}/course.wrela")?
        write_text(
            f"{b.program.as_str()}/course.wrela",
            course_text(course.as_str(), name.as_str()).as_str(),
        )?
        let deps = Vec::from([String::from("courselens")])
        write_text(
            f"{b.program.as_str()}/wrela.toml",
            manifest("course_lens", name.as_str(), deps).as_str(),
        )?
        for (dep, dir) in [
            ("courselens", "studio/courselens"),
            ("engine", "engine"),
            ("ui", "ui"),
        ] {
            overrides.push(Override { name: String::from(dep), dir: String::from(f"{ws}/{dir}") })
        }
        // The course's literals alone: what a drag moves. (The rest is built into the code, so
        // the player's run is the game's.)
        options.lift.push(String::from(f"{name.as_str()}/course.wrela"))
        options.overrides = take overrides
        b.build = Some(toolchain::build(b.program.as_str(), b.page.as_str(), options.clone()))
    } else if kind == LensKind::Map {
        b.program = String::from(f"{out}/map")
        let glue_dir = String::from(f"{ws}/studio/maplens/glue")
        var writes: Vec<(String, String)> = Vec::new()
        for f in ["main.wrela", "floor.wrela"] {
            let text = needed_text(f"{glue_dir.as_str()}/{f}")?
            let written = if f == "floor.wrela" {
                floor_text(text.as_str(), name.as_str(), geology)
            } else {
                take text
            }
            writes.push((String::from(f"{b.program.as_str()}/{f}"), take written))
        }
        let deps = Vec::from(
            [String::from("maplens"), String::from("engine"), String::from("land")],
        )
        writes.push(
            (
                String::from(f"{b.program.as_str()}/wrela.toml"),
                manifest("map", name.as_str(), deps),
            ),
        )
        overrides.push(
            Override { name: String::from("maplens"), dir: String::from(f"{ws}/studio/maplens") },
        )
        overrides.push(Override { name: String::from("engine"), dir: String::from(f"{ws}/engine") })
        overrides.push(Override { name: String::from("land"), dir: String::from(f"{ws}/land") })
        // The map's literals alone: what a drag moves. (The ground's, the species' and the rest
        // are built into the code, so the preview runs at the speed of the game's build.)
        options.lift.push(String::from(f"{name.as_str()}/map.wrela"))
        for w in writes {
            write_text(w.0.as_str(), w.1.as_str())?
        }
        options.overrides = take overrides
        b.build = Some(toolchain::build(b.program.as_str(), b.page.as_str(), options.clone()))
    } else {
        // The probe: what the compiler says of the subject's channels, spec and blueprint.
        let probe = String::from(f"{out}/probe")
        write_text(f"{probe.as_str()}/wrela.toml", manifest("probe", name.as_str(), Vec::new()))?
        write_text(f"{probe.as_str()}/main.wrela", probe_main())?
        write_text(f"{probe.as_str()}/probe.wrela", probe_text(name.as_str()))?
        b.query = Some(toolchain::query(probe.as_str(), probe_queries(name.as_str()), overrides))
        options.overrides = take overrides
    }
    b.options = take options
    Ok(b)
}

impl Building {
    /// The request the build waits on now.
    pub fn request(self) -> Request {
        match self.query {
            Some(q) => q.request(),
            None => match self.build {
                Some(c) => c.request(),
                None => panic("a lens's build waits on nothing"),
            },
        }
    }

    /// Waits for the request the build waits on, and goes on from its answer: the lens built
    /// once the build's answer has come, else `None` (a field lens's probe answered, and its
    /// program written and being built).
    pub fn advance(mut self) -> Result<Option<Built>, ToolError> {
        if let Some(q) = replace(mut self.query, None) {
            let json = (take q).wait()?
            let s = read_probe(self.name.as_str(), json.as_str()).map_err(
                |e| ToolError::new(e.as_str()),
            )?
            let ws = self.ws.as_str()
            let main = needed_text(f"{ws}/studio/glue/main.wrela")?
            let program = self.program.as_str()
            write_text(f"{program}/main.wrela", main.as_str())?
            write_text(f"{program}/subject.wrela", glue_text(s).as_str())?
            let deps = Vec::from([String::from("studio")])
            write_text(
                f"{program}/wrela.toml",
                manifest("lens", self.name.as_str(), deps).as_str(),
            )?
            self.options.lift.push(self.name.clone())
            self.build = Some(toolchain::build(program, self.page.as_str(), self.options.clone()))
            return Ok(None)
        }
        let Some(c) = replace(mut self.build, None) else {
            return Err(ToolError::new("a lens's build waits on nothing"))
        }
        let result = (take c).wait()?
        // A build that failed: its errors; one that built: how many warnings it had.
        var errors = String::new()
        var warnings = 0
        for d in result.diagnostics {
            if !result.ok && d.error {
                errors.push_str(d.rendered.as_str())
            } else if result.ok && !d.error {
                warnings += 1
            }
        }
        Ok(
            Some(
                Built {
                    errors,
                    name: self.name.clone(),
                    kind: self.kind,
                    program: self.program.clone(),
                    page: self.page.clone(),
                    warnings,
                },
            ),
        )
    }
}

/// Builds the lens on the subject at `place`: the glue written into `place.out`, then the
/// program built lifted into `place.out/page`.
pub fn build(place: Place) -> Result<Built, ToolError> {
    var b = begin(place)?
    loop {
        if let Some(built) = b.advance()? {
            return Ok(built)
        }
    }
}

/// The actions of a lens of kind `kind`: the field lens's, the map lens's or the course lens's.
pub fn actions(kind: LensKind) -> Vec<(String, String)> {
    match kind {
        LensKind::Field => listed(ACTIONS),
        LensKind::Map => listed(MAP_ACTIONS),
        LensKind::Course => listed(COURSE_ACTIONS),
    }
}

/// An action table's names and arguments as strings.
fn listed(table: [(Text, Text)]) -> Vec<(String, String)> {
    var out: Vec<(String, String)> = Vec::new()
    for a in table {
        let (n, k) = a
        out.push((n.to_string(), k.to_string()))
    }
    out
}

/// Field lens actions whose answer depends only on CPU state after `init`, with no viewport,
/// frame, GPU readback or post request. A PNG still uses the rendered host. Map actions with
/// the same names have different implementations and are not covered by this list.
pub fn cpu_action(name: str) -> bool {
    for n in [
        "literals",
        "parts",
        "probe",
        "ray",
        "measure",
        "spec",
        "view",
        "zoom",
        "mode",
        "set",
        "choose",
        "choose_none",
    ] {
        if n == name {
            return true
        }
    }
    false
}

/// Whether an action of a lens (the field lens's, or the map lens's) waits for the lens to
/// settle: every one but the map lens's `geology`, which answers at once, reading nothing of the
/// preview the lens may still be waiting for, and draws in the next frame.
pub fn settles(field: bool, name: str) -> bool {
    field || name != "geology"
}

/// The lens running headless on the native host: its driven build, its screen's size, the next
/// frame's number, whether it's the field lens, its program and its build (where its edits are
/// written), the fit's reference, the host's time after the last request (seconds since the
/// load), and the lines the lens printed that haven't been read (`logs`).
pub struct Lens: Clone {
    pub b: drive::Build,
    pub width: u32,
    pub height: u32,
    pub frame: u32,
    pub field: bool,
    pub program: String,
    pub page: String,
    pub reference: Option<Vec<u8>>,
    pub now: f64,
    pub lines: Vec<String>,
}

/// Runs `list` on the lens's build: what the steps saw, the lines it printed kept for `logs`.
/// A trap is the error, in the host's words.
pub fn steps(lens: mut Lens, list: [Step]) -> Result<Seen, ToolError> {
    var seen = drive::steps(lens.b, list).wait()?
    var printed = drive::lines(mut seen)?
    lens.lines.append(mut printed)
    if let Some(t) = seen.trap {
        return Err(ToolError::new(t.message.as_str()))
    }
    if !seen.ran.is_empty() {
        let last = seen.ran.len() - 1
        lens.now = seen.ran[last].started + seen.ran[last].elapsed
    }
    Ok(seen)
}

/// Loads the lens's build at `page` (with the GPU unless `cpu`, its screen `width` by `height`),
/// runs its `init`, and with the GPU a first frame, so it knows the screen's size.
pub fn start(
    built: Built,
    width: u32,
    height: u32,
    cpu: bool,
    reference: take Option<Vec<u8>>,
) -> Result<Lens, ToolError> {
    var options = if cpu { drive::cpu() } else { drive::gpu() }
    options.width = width
    options.height = height
    let it = drive::load(built.page.as_str(), options)
        .wait()
        .map_err(
            |e| ToolError::new(f"can't run the lens: {e.message()}"),
        )?
    var lens = Lens {
        b: it.build,
        width,
        height,
        frame: 0,
        field: built.kind == LensKind::Field,
        program: built.program.clone(),
        page: built.page.clone(),
        reference,
        now: 0.0,
        lines: Vec::new(),
    }
    if cpu {
        let _ = steps(mut lens, [Step::Init])?
    } else {
        let _ = steps(mut lens, [Step::Init, Step::Frames(1, Script::frames())])?
        lens.frame += 1
        answer_posts(mut lens)?
    }
    Ok(lens)
}

/// The lens's next frame, with `script`'s events, then its posts answered.
pub fn frames(lens: mut Lens, script: take Script) -> Result<(), ToolError> {
    let _ = steps(mut lens, [Step::Frames(1, take script)])?
    lens.frame += 1
    answer_posts(mut lens)
}

/// Export `name` called with `args`: its results. A trap is the error.
pub fn invoke(lens: mut Lens, name: str, args: [Scalar]) -> Result<Vec<Scalar>, ToolError> {
    var seen = steps(mut lens, [Step::Call(String::from(name), Vec::from(args))])?
    Ok(seen.ran.remove(0).results)
}

/// Frames until the lens isn't waiting (at most `WAIT` seconds of the host's), then one more:
/// each frame after a call of its `busy` export, in one request.
pub fn settle(lens: mut Lens) -> Result<(), ToolError> {
    let began = lens.now
    loop {
        let seen = steps(
            mut lens,
            [Step::Call(String::from("busy"), Vec::new()), Step::Frames(1, Script::frames())],
        )?
        var busy = false
        if seen.ran[0].results.len() == 1 {
            if let Scalar::I32(x) = seen.ran[0].results[0] {
                busy = x != 0
            }
        }
        lens.frame += 1
        answer_posts(mut lens)?
        if !busy {
            return Ok(())
        }
        if lens.now - began >= WAIT {
            return Err(ToolError::new(f"the lens was still waiting after {u32(WAIT)} s"))
        }
    }
}

/// Export `name` called with `args`, the lens's lines before it dropped, and the frames after
/// until it settles (one frame, for an action that waits for nothing: `settles`); with
/// `deferred`, a field lens's view control (`zoom`, `mode`, `view`) waits for the next call's
/// frames instead: a comparison needs only the final image.
pub fn call(lens: mut Lens, name: str, args: [Scalar], deferred: bool) -> Result<(), ToolError> {
    lens.lines.clear()
    let _ = invoke(mut lens, name, args)?
    if deferred && lens.field && (name == "zoom" || name == "mode" || name == "view") {
        return Ok(())
    }
    answer_posts(mut lens)?
    if settles(lens.field, name) {
        return settle(mut lens)
    }
    frames(mut lens, Script::frames())
}

/// The lines the lens printed since the last time.
pub fn logs(lens: mut Lens) -> Vec<String> {
    replace(mut lens.lines, Vec::new())
}

/// The last line of `lines` that is a JSON object: a lens's answer.
pub fn last_json(lines: [String]) -> Option<String> {
    var k = lines.len()
    while k > 0 {
        k -= 1
        if lines[k].as_str().starts_with("{") {
            return Some(lines[k].clone())
        }
    }
    None
}

/// Answers the posts the lens made: its edits through `wrela edit`'s code, its fit's request
/// for the reference with the reference, and any other post fails, saying nothing answers it.
pub fn answer_posts(lens: mut Lens) -> Result<(), ToolError> {
    let posts = drive::posts(lens.b).wait()?
    for post in posts {
        let url = post.url.as_str()
        var reply: Result<Vec<u8>, String> = Err(String::from(f"nothing answers `{url}` here"))
        if url == "studio/edit" {
            let Data::Bytes(body) = post.body.clone() else {
                return Err(ToolError::new("a post's body is a blob"))
            }
            let text = edit(lens.program.as_str(), lens.page.as_str(), take body)
            reply = Ok(Vec::from(text.as_bytes()))
        } else if url == "studio/reference" {
            reply = match lens.reference.clone() {
                Some(mask) => Ok(take mask),
                None => Err(String::from("no reference image: give one with --reference")),
            }
        }
        match take reply {
            Ok(bytes) => {
                let data = data_of(take bytes)?
                let answered = drive::answer(lens.b, post.id, data.clone()).wait()
                if let Data::Blob(bl) = data {
                    let _ = blob::release(bl).wait()
                }
                let _ = (take answered)?
            },
            Err(why) => {
                let _ = drive::fail(lens.b, post.id, why.as_str()).wait()?
            },
        }
    }
    Ok(())
}

/// `bytes` as a request carries them: themselves, or a new blob of them past 512 KiB.
pub fn data_of(bytes: take Vec<u8>) -> Result<Data, ToolError> {
    if bytes.len() <= MOST_BYTES {
        return Ok(Data::Bytes(take bytes))
    }
    Ok(Data::Blob(blob_of(chunked(take bytes))?))
}

/// The edits of a body `{"edits": [[literal, value], ...]}`, as the lens posts them: every
/// entry must be a pair of a `u32` literal index and a finite `f32` value.
pub fn parse_edits(body: str) -> Option<Vec<(u32, f32)>> {
    let d = parse(body)?
    let list = d.get(TOP, "edits")?
    if d.kind(list) != Kind::List {
        return None
    }
    var out: Vec<(u32, f32)> = Vec::new()
    for k in 0..d.count(list) {
        let entry = d.at(list, k)?
        if d.kind(entry) != Kind::List || d.count(entry) != 2 {
            return None
        }
        let i = d.num(d.at(entry, 0)?)?
        if i < 0.0 || i > 4294967295.0 || floor(i) != i {
            return None
        }
        let v = f32(d.num(d.at(entry, 1)?)?)
        if !is_finite(v) {
            return None
        }
        out.push((u32(i), v))
    }
    Some(out)
}

/// Applies a body of the lens's edits to the subject's files through `toolchain::edit`: the
/// JSON answer (`wrela edit --json`'s), or why they were refused, on one line.
pub fn edit(program: str, page: str, body: take Vec<u8>) -> String {
    let text = match String::from_utf8(take body) {
        Some(t) => take t,
        None => String::new(),
    }
    let Some(edits) = parse_edits(text.as_str()) else {
        return String::from(
            "{\"why\":\"the edits aren't [[literal, value], ...]\",\"written\":false}",
        )
    }
    match toolchain::edit(program, page, edits).wait() {
        Ok(answer) => answer,
        Err(e) => String::from(f"{{\"why\":{quoted(e.message()).as_str()},\"written\":false}}"),
    }
}

/// The lens's screen: its RGBA8 pixels.
pub fn screen(lens: mut Lens) -> Result<Vec<u8>, ToolError> {
    var seen = steps(mut lens, [Step::Capture])?
    Ok(joined(data_bytes(seen.captures.remove(0).rgba)?))
}

/// RGBA8 pixels, `width` by `height`, written as a PNG at `path`.
pub fn save_png(path: str, width: u32, height: u32, rgba: take Vec<u8>) -> Result<(), ToolError> {
    let pixels = data_of(take rgba)?
    let encoded = image::encode_png(image::Image { width, height, rgba: pixels.clone() }).wait()
    if let Data::Blob(b) = pixels {
        let _ = blob::release(b).wait()
    }
    write_data(path, (take encoded)?).map_err(
        |e| ToolError::new(f"can't write {path}: {e.message()}"),
    )
}

/// The PNG (or JPEG, or WebP) at `path`, read: its size and its RGBA8 pixels; `None` if no file
/// is there.
pub fn read_png(path: str) -> Result<Option<(u32, u32, Vec<u8>)>, ToolError> {
    if files::stat(path).wait().is_err() {
        return Ok(None)
    }
    let file = files::read_blob(path).wait()?
    let decoded = image::decode(Data::Blob(file)).wait()
    let _ = blob::release(file).wait()
    let img = (take decoded).map_err(|e| ToolError::new(f"{path}: {e.message()}"))?
    let rgba = joined(data_bytes(img.rgba.clone())?)
    Ok(Some((img.width, img.height, rgba)))
}

/// A reference image for the lens's fit (`fit`), as its post `studio/reference` takes it: the
/// image's size (it must be square) as 4 bytes, little-endian, then a byte a pixel, rows top to
/// bottom: 1 inside (dark: luminance under half, and opaque), 0 outside.
pub fn reference_mask(width: u32, height: u32, rgba: [u8]) -> Result<Vec<u8>, String> {
    if width != height {
        return Err(String::from(f"a reference is square; this one is {width}x{height}"))
    }
    var out: Vec<u8> = Vec::with_capacity(4 + width * height)
    out.push(u8(width & 255))
    out.push(u8((width >> 8) & 255))
    out.push(u8((width >> 16) & 255))
    out.push(u8(width >> 24))
    var i = 0
    while i + 3 < rgba.len() {
        let luminance = 0.2126 * f32(rgba[i]) +
            0.7152 * f32(rgba[i + 1]) +
            0.0722 * f32(rgba[i + 2])
        out.push(if luminance < 127.5 && rgba[i + 3] >= 128 { 1 } else { 0 })
        i += 4
    }
    Ok(out)
}

/// The text a typed command is, then Enter: the script of frame `at`.
pub fn typed(at: u32, line: str) -> Script {
    Script::frames().text(at, line).key_down(at, Key::Enter).key_up(at, Key::Enter)
}

@test
fn edit_posts_reject_an_invalid_entry_without_keeping_other_edits() {
    let Some(ok) = parse_edits("{\"edits\": [[7, -0.5], [2, 1.0]]}") else { panic("edits") }
    assert(ok.len() == 2)
    let (i, v) = ok[0]
    assert(i == 7 && v == -0.5)
    for body in [
        "{\"edits\": [[0, 1.0], [1, \"invalid\"]]}",
        "{\"edits\": [[4294967296, 1.0]]}",
        "{\"edits\": [[0, 1e100]]}",
        "{\"edits\": [[0, 1.0, 2.0]]}",
    ] {
        assert(parse_edits(body).is_none(), body)
    }
}

@test
fn the_map_lenss_geology_answers_without_waiting_for_its_preview() {
    assert(!settles(field: false, name: "geology"))
    for name in ["show", "zoom", "check", "move", "write"] {
        assert(settles(field: false, name: name), name)
    }
    assert(settles(field: true, name: "geology"))
}

@test
fn a_reference_is_a_square_mask_of_its_dark_pixels() {
    let Ok(m) = reference_mask(
        width: 2,
        height: 2,
        rgba: [0, 0, 0, 255, 255, 255, 255, 255, 10, 10, 10, 0, 100, 100, 100, 200],
    ) else {
        panic("a mask")
    }
    assert(
        m.len() == 8 && m[0] == 2 && m[1] == 0 && m[4] == 1 && m[5] == 0 && m[6] == 0 && m[7] == 1,
    )
    assert(
        reference_mask(width: 2, height: 1, rgba: [0, 0, 0, 0, 0, 0, 0, 0]).is_err(),
        "not square",
    )
}
