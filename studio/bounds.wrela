// Where a surface is: a box holding everything inside it, found by its derived interval
// (language.md §13), for any surface.

use std::derive::{Box3, interval}
use std::field::Surface

/// The space searched first: 8 m around the origin, the ground at the middle of its bottom half
/// (a creature's). A surface that reaches its faces is searched again in a box twice the size,
/// up to `GROWTHS` times: a tree's 16 m, a hill's.
pub const SEARCH: Box3 = Box3 { lo: vec3(-4.0, -2.0, -4.0), hi: vec3(4.0, 6.0, 4.0) }
pub const GROWTHS: u32 = 5

/// A box holding the surface's inside, each face to a cell of an octree `depth` levels deep
/// (a cell of `SEARCH` at depth 8 is about 3 cm, of a box grown once 6 cm). Empty (`lo > hi`)
/// if nothing is inside.
pub fn bounds<S: Surface>(field: S, depth: u32) -> Box3 {
    var search = SEARCH
    for _ in 0..GROWTHS {
        let b = bounds_in(field, depth, search)
        if b.lo.x > b.hi.x {
            return b
        }
        // A face within a cell of the search's: the surface may reach past it.
        let cell = (search.hi - search.lo) / f32(1 << depth)
        let low = b.lo - search.lo
        let high = search.hi - b.hi
        let reaches = min(min(min(low.x, low.y), low.z), min(min(high.x, high.y), high.z)) <=
            max(max(cell.x, cell.y), cell.z) * 1.5
        if !reaches {
            return b
        }
        search = Box3 { lo: search.lo * 2.0, hi: search.hi * 2.0 }
    }
    bounds_in(field, depth, search)
}

/// `bounds`, searching `search`.
fn bounds_in<S: Surface>(field: S, depth: u32, search: Box3) -> Box3 {
    var lo = vec3(1.0e9)
    var hi = vec3(-1.0e9)
    for face in 0..6 {
        let (axis, far) = (face / 2, face % 2 == 1)
        let (found, at) = extreme(field, depth, axis, far, search)
        if !found {
            return Box3 { lo, hi }
        }
        if far {
            hi[axis] = at
        } else {
            lo[axis] = at
        }
    }
    Box3 { lo, hi }
}

/// How far the inside reaches along `axis` (toward its low end, or its high end with `far`): a
/// best-first search of the octree, nearest the face first, so it stops at the first cell of
/// the deepest level, or the first wholly inside, its interval can't show is outside: every
/// cell nearer the face has been shown outside by then.
fn extreme<S: Surface>(field: S, depth: u32, axis: u32, far: bool, search: Box3) -> (bool, f32) {
    // The cells still to search, at most 512 (past that the search is coarser, never wrong:
    // a cell dropped is kept whole).
    var cells: Vec<(Box3, u32)> = Vec::new()
    cells.push((search, 0))
    while cells.len() > 0 {
        // The cell nearest the face.
        var best = 0
        for k in 1..cells.len() {
            if nearer(cells[k].0, cells[best].0, axis, far) {
                best = k
            }
        }
        let (b, d) = cells.remove(best)
        let r = interval(|q: vec3| field.distance(q), b)
        if r.lo > 0.0 {
            continue
        }
        if d == depth || r.hi < 0.0 || cells.len() >= 504 {
            return (true, if far { b.hi[axis] } else { b.lo[axis] })
        }
        let h = 0.5 * (b.hi - b.lo)
        for j in 0..8 {
            let o = vec3(f32(j & 1), f32((j >> 1) & 1), f32((j >> 2) & 1)) * h
            cells.push((Box3 { lo: b.lo + o, hi: b.lo + o + h }, d + 1))
        }
    }
    (false, 0.0)
}

/// Whether box `a` reaches nearer the face than `b` does.
fn nearer(a: Box3, b: Box3, axis: u32, far: bool) -> bool {
    if far { a.hi[axis] > b.hi[axis] } else { a.lo[axis] < b.lo[axis] }
}
