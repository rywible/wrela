// A ball 0.1 m about (0, 0.2, 0) whose distance traps past x = 0.05: one instance's call traps
// while the others' are out.

pub fn distance(x: f32, y: f32, z: f32) -> f32 {
    assert(x <= 0.05, "past x = 0.05")
    length(vec3(x, y - 0.2, z)) - 0.1
}

pub fn part(x: f32, y: f32, z: f32) -> u32 {
    0
}

pub fn frame(time: f32, width: u32, height: u32) {}
