// What the map lens needs of its floor: its map (as its literals say now), its preview, and its
// geology if it has one. `wrela tool studio -- <floor>` writes one for the floor's `lens`
// module; this one is the Last Green's.

use land::interest::Preview
use land::landform::Survey
use land::place::Map

pub fn map() -> Map {
    last_green::lens::map()
}

pub fn preview() -> Preview {
    last_green::lens::preview()
}

/// The floor's geology, if its lens surveys one (`wrela tool studio` writes `None` where it
/// doesn't).
pub fn geology() -> Option<Survey> {
    Some(last_green::lens::geology())
}
