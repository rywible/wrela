// A program's lookbook shots, chosen as a player chooses them, and the lookbook tool's command
// line: what is pure of the tool, so its tests need no build.

use std::input::{Key, Script}
use std::json::{Doc, Kind, TOP}
use std::tool::files::rooted
use toolkit::command::size_of

/// The root the tool reads and writes the workspace in.
pub const WS: Text = "ws"

/// The package whose lookbook the tool renders unless `--package` names another: the floor's.
pub const PROGRAM: Text = "ws/games/last-green"

/// The floor's build (`wrela build games/last-green`), and its lookbook's source.
pub const BUILD: Text = "ws/games/last-green/build"
pub const LOOKBOOK: Text = "ws/games/last-green/lookbook.wrela"

/// A package's build (`wrela build <package>`), from its root path.
pub fn build_of(program: str) -> String {
    String::from(f"{program}/build")
}

/// A package's lookbook's source (its `engine::shot::Shot`s), from its root path.
pub fn lookbook_of(program: str) -> String {
    String::from(f"{program}/lookbook.wrela")
}

/// A shot's move starts this many frames after it's chosen (`lookbook::SETTLE` seconds at 60 a
/// second): its still is the frame then.
pub const SETTLE_FRAMES: u32 = 300

/// A capture-mode still's frames at most, its load and its resolve: it stops before, at the
/// frame that prints `STILL`.
pub const CAPTURE_FRAMES: u32 = 900
pub const STILL: Text = "still at frame"

/// What the frame prints once the reference (F12) is drawn round the eye, and once play is
/// again (`engine::frame::REFERENCE`, `PLAY`).
pub const REFERENCE: Text = "reference at frame"
pub const PLAY: Text = "play at frame"

/// A shot's move, in frames: its clip's length.
pub const MOVE_FRAMES: u32 = 600

/// The views: each one's name, how many presses of F8 draw it (`engine::frame::Frame::form`'s
/// views first; the floor's own world views after them, `view` in games/last-green/main.wrela),
/// and the directory of the build's `files/` that names its shots (empty: the lookbook's own).
pub const VIEWS: [(Text, u32, Text); 6] = [
    ("look", 0, ""),
    ("clay", 1, ""),
    ("silhouette", 2, ""),
    ("bare", 3, "geology"),
    ("grown", 4, "growth"),
    ("specimens", 5, "specimens"),
]

/// The digit key for `d`, from 0 to 9.
fn digit(d: u32) -> Key {
    match d {
        0 => Key::Digit0,
        1 => Key::Digit1,
        2 => Key::Digit2,
        3 => Key::Digit3,
        4 => Key::Digit4,
        5 => Key::Digit5,
        6 => Key::Digit6,
        7 => Key::Digit7,
        8 => Key::Digit8,
        _ => Key::Digit9,
    }
}

/// `s` with `key`, then `n`'s digits, then Enter pressed at frame `at`: a number typed after its
/// key, as a player chooses a lookbook shot (L) or travels to a site (G).
pub fn typed(given: take Script, at: u32, key: Key, n: u32) -> Script {
    var s = (take given).press(at, key)
    let digits = String::from(f"{n}")
    for k in 0..digits.len() {
        s = (take s).press(at, digit(u32(digits.as_str().byte(k)) - 48))
    }
    (take s).press(at, Key::Enter)
}

/// `s` with the keys that choose lookbook shot `i` at frame `at`: L, its number's digits, Enter.
pub fn choose(given: take Script, at: u32, i: u32) -> Script {
    typed(take given, at, Key::L, i)
}

/// The keys of shot `i`'s still or clip, all at frame 1: F7 in capture mode (it toggles it),
/// F8 `presses` times for a debug view, then the shot.
pub fn keys(i: u32, presses: u32, capture: bool) -> Script {
    var s = Script::frames()
    if capture {
        s = (take s).press(1, Key::F7)
    }
    for _ in 0..presses {
        s = (take s).press(1, Key::F8)
    }
    choose(take s, 1, i)
}

/// Shot `i`'s files' stem: its number in two digits and its name, spaces as dashes and no
/// apostrophes (`02-beech-high-forest`).
pub fn stem(i: u32, name: str) -> String {
    var out = String::from(f"{i:02}-")
    for k in 0..name.len() {
        let b = name.byte(k)
        if b == 32 {
            out.push_byte(45)
        } else if b != 39 {
            out.push_byte(b)
        }
    }
    out
}

/// A root path in `WS` as the command line gives it: from the workspace's directory.
pub fn shown_path(path: str) -> borrow str {
    if path.starts_with("ws/") { path.slice(3, path.len()) } else { path }
}

/// The lookbook's shots' names, in order, as its source writes them: each `Shot {`'s first
/// field, `name: "..."`.
pub fn names_in(source: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    var at = 0
    loop {
        let Some(found) = source.slice(at, source.len()).find("Shot {") else { break }
        var i = at + found + 6
        while i < source.len() && (source.byte(i) == 32 || source.byte(i) == 10) {
            i += 1
        }
        at = i
        if !source.slice(i, source.len()).starts_with("name: \"") {
            continue
        }
        let from = i + 7
        var to = from
        while to < source.len() && source.byte(to) != 34 {
            to += 1
        }
        if to > from && to < source.len() {
            out.push(String::from(source.slice(from, to)))
        }
        at = to
    }
    out
}

/// The names in a JSON list of texts (the build's `shots.json` of a view), or `None`.
pub fn names_listed(json: str) -> Option<Vec<String>> {
    let doc = std::json::parse(json)?
    if doc.kind(TOP) != Kind::List {
        return None
    }
    var out: Vec<String> = Vec::new()
    for k in 0..doc.count(TOP) {
        out.push(doc.text(doc.at(TOP, k)?)?)
    }
    Some(out)
}

/// What the interest check found at shot `i`'s eye (the build's `files/check/shots.json`, read
/// as `doc`), as the tool prints it under the shot, or `None` if the check has no such shot.
pub fn check_line(doc: Doc, i: u32) -> Option<String> {
    let shot = doc.at(TOP, i)?
    let v = doc.get(shot, "view")?
    let draws = doc.get(v, "draws")?
    var what = String::new()
    for k in 0..min(4, doc.count(draws)) {
        let d = doc.at(draws, k)?
        if k > 0 {
            what.push_str(", ")
        }
        let pull = doc.text(doc.get(d, "pull")?)?
        let strength = doc.num(doc.get(d, "strength")?)?
        what.push_str(f"{pull} {strength:.2}")
    }
    let state = if doc.is_true(doc.get(v, "dead")?) {
        String::from("dead")
    } else if doc.is_true(doc.get(v, "quiet")?) {
        String::from("quiet")
    } else {
        String::from(f"{doc.num(doc.get(v, "count")?)?:.0} draw")
    }
    let best = doc.num(doc.get(v, "best")?)?
    var line = String::from(f"  the check: {state}; strongest {best:.2}")
    if !what.is_empty() {
        line.push_str(f" ({what})")
    }
    Some(line)
}

/// What a run of the tool does: the program whose lookbook it renders and where its files go
/// (root paths), whether it makes the stills alone, whether in capture mode, its view (an index in
/// `VIEWS`), the stills' size, how many stills render at once, how many threads the clips' pages
/// run their jobs on, and the shots (none: every one); with `quality`, the lookdev instrument's
/// measures instead of stills and clips (docs/lookdev.md), and with `controls` its negative
/// controls too.
pub struct Options: Clone {
    pub program: String,
    pub out: String,
    pub stills: bool,
    pub capture: bool,
    pub quality: bool,
    pub controls: bool,
    pub view: u32,
    pub width: u32,
    pub height: u32,
    pub jobs: u32,
    pub workers: u32,
    pub picks: Vec<u32>,
    /// Which of the shots, when none is picked by number (`--shots dev`, `--shots evaluation`):
    /// `ALL`, `EVALUATION` or `DEVELOPMENT`.
    pub set: u32 = ALL,
    /// The look the program's built in (`--look`: `wrela build --set LOOK=<type>`,
    /// `engine::style`), or empty for its own build.
    pub look: String = String::new(),
    /// A run whose measures (`<dir>/quality.json`) are the bars' baseline (`--bars`: docs/lookdev.md,
    /// "Judging a style"), or empty.
    pub bars: String = String::new(),
}

/// The shots a run takes when none is picked by number: all of them, a lookbook's evaluation
/// shots alone, or its development shots alone (plan three's §B1.4: a development shot is named
/// `D` and its number, as `D3 another old oak`).
pub const ALL: u32 = 0
pub const EVALUATION: u32 = 1
pub const DEVELOPMENT: u32 = 2

/// Whether a shot named `name` is a development shot: `D`, then a digit.
pub fn developing(name: str) -> bool {
    name.len() >= 2 && name.byte(0) == 68 && name.byte(1) >= 48 && name.byte(1) <= 57
}

/// The shots of `shots` (their names) a run takes: those picked by number, or else those of its
/// set (`Options::set`).
pub fn chosen(o: Options, shots: [String]) -> Vec<u32> {
    if !o.picks.is_empty() {
        return o.picks.clone()
    }
    var out: Vec<u32> = Vec::new()
    for i in 0..shots.len() {
        let dev = developing(shots[i].as_str())
        if o.set == ALL || (o.set == DEVELOPMENT) == dev {
            out.push(i)
        }
    }
    out
}

pub const USAGE: Text = "usage: wrela tool lookbook -- <out-dir> [--package <dir>] [--stills] [--capture] [--quality [--controls]] [--shots a,b,c|dev|evaluation] [--view clay|silhouette|bare|grown|specimens] [--size WxH] [--jobs N] [--workers N] [shot-number ...]"

/// The options the command line gives, or what's wrong with it.
pub fn parse_args(given: [String]) -> Result<Options, String> {
    var o = Options {
        program: String::from(PROGRAM),
        out: String::new(),
        stills: false,
        capture: false,
        quality: false,
        controls: false,
        view: 0,
        width: 1920,
        height: 1080,
        jobs: 1,
        workers: 8,
        picks: Vec::new(),
    }
    var k = 0
    var out: Option<String> = None
    while k < given.len() {
        let a = given[k].as_str()
        let next = if k + 1 < given.len() { given[k + 1].clone() } else { String::new() }
        let value = next.as_str()
        if a == "--package" {
            let Some(path) = rooted(WS, value) else {
                return Err(String::from(f"--package takes a package's directory in the workspace"))
            }
            o.program = take path
            k += 1
        } else if a == "--stills" {
            o.stills = true
        } else if a == "--capture" {
            o.capture = true
        } else if a == "--quality" {
            o.quality = true
        } else if a == "--controls" {
            o.controls = true
        } else if a == "--look" && !value.is_empty() {
            o.look = String::from(value)
            k += 1
        } else if a == "--bars" && !value.is_empty() {
            o.bars = String::from(value)
            k += 1
        } else if a == "--shots" && value == "dev" {
            o.set = DEVELOPMENT
            k += 1
        } else if a == "--shots" && value == "evaluation" {
            o.set = EVALUATION
            k += 1
        } else if a == "--shots" {
            for (from, to) in value.split(",") {
                let Some(n) = value.slice(from, to).parse_u32() else {
                    return Err(
                        String::from("--shots takes shot numbers, as 2,7,11, or dev or evaluation"),
                    )
                }
                o.picks.push(n)
            }
            k += 1
        } else if a == "--view" {
            var found = false
            for v in 0..VIEWS.len() {
                if VIEWS[v].0 == value {
                    o.view = v
                    found = true
                }
            }
            if !found {
                return Err(
                    String::from(
                        "--view takes one of look, clay, silhouette, bare, grown, specimens",
                    ),
                )
            }
            k += 1
        } else if a == "--size" {
            let Some((w, h)) = size_of(value) else {
                return Err(String::from("--size takes WxH, as 1280x720"))
            }
            o.width = w
            o.height = h
            k += 1
        } else if a == "--jobs" || a == "--workers" {
            let Some(n) = value.parse_u32() else {
                return Err(String::from(f"{a} takes a whole number, 1 or more"))
            }
            if n == 0 {
                return Err(String::from(f"{a} takes a whole number, 1 or more"))
            }
            if a == "--jobs" {
                o.jobs = n
            } else {
                o.workers = n
            }
            k += 1
        } else if out.is_none() {
            let Some(path) = rooted(WS, a) else {
                return Err(String::from(f"{a} isn't a directory in the workspace"))
            }
            out = Some(take path)
        } else {
            let Some(n) = a.parse_u32() else { return Err(String::from(USAGE)) }
            o.picks.push(n)
        }
        k += 1
    }
    let Some(path) = take out else { return Err(String::from(USAGE)) }
    o.out = take path
    Ok(o)
}
