// The lookbook tool (`wrela tool lookbook`): a program's lookbook (the floor's unless `--package`
// names another; #54 §9, #55 AC10), each shot of its `lookbook.wrela` (`engine::shot::Shot`s)
// rendered settled at 1080p, as a still on the native host and as a 10 s clip in Chrome (its
// move), into a directory.
//
// ```text
// wrela tool lookbook -- <out-dir> [--package <dir>] [--stills] [--capture]
//     [--quality [--controls]] [--shots a,b,c]
//     [--view clay|silhouette|bare|grown|specimens] [--size WxH] [--jobs N] [--workers N]
//     [shot-number ...]
// ```
//
// The package must be built (`wrela build games/last-green`, or `examples/clearing`). Paths are
// from the workspace's directory (the root `ws`). A shot is chosen as a player would (L, its
// number, Enter: `engine::shot::Shots`); the still is the frame its move starts at
// (`engine::shot::SETTLE` seconds in), when what's round it has streamed in and its caches have
// settled. The build runs on the native host's GPU
// (`std::tool::drive`), and its screen is encoded as a PNG (`std::tool::image`). The clip is its
// move, from then for `lookbook::MOVE` seconds, paced as in play, recorded from Chrome's canvas
// (test mode's `clip`: a WebM), with the build served on a free port (`std::tool::serve`) and
// the page's jobs on `--workers` threads (8 unless given). `--stills` makes the stills alone.
//
// `--view` draws a debug view of form instead of the look (F8): `clay`, the scene's light on its
// forms all one matte grey, or `silhouette`, the sky white, the land light and the solid forms
// dark, a step lighter for each band of distance; or, in the floor alone, `bare`, the world's land
// as its geology made it, alone, whose shots are of the places found in it (the build's
// `files/geology/shots.json`, numbered as there); or `grown`, the world's land as its water and its
// forest left it, whose shots are of those places and of its wood (`files/growth/shots.json`); or
// `specimens`, each species at a run of ages on level ground, a species a shot
// (`files/specimens/shots.json`). `--size` renders the stills at another size than 1920x1080
// (1280x720 while iterating). Stills render one at a time unless `--jobs` says how many at once,
// with the same pixels. Each shot's numbers, the interest check's view at its eye (the build's
// `files/check/shots.json`), are printed beside it and saved as `check.json`.
//
// `--capture` takes each still in capture mode (F7, `engine::frame::Frame::key`): the program does
// its load in a few frames, and the still is the frame it prints `still at frame N` on, a
// 16-frame resolve once the light round the eye is in, not the frame 5 s in.
//
// `--quality` measures each shot instead, as the lookdev instrument (quality.wrela,
// docs/lookdev.md): play against a frozen-time reference, its flicker, pop and trail, into
// `quality.json`; `--controls` adds the instrument's negative controls (`controls.json`).
//
// `--runs <n>` measures each shot n times, each measure the median of them (a shot's flicker
// differs by up to a fifth from one run to the next).
//
// `--look <type>` builds the package in that look first (`wrela build --set LOOK=<type>`, into
// build/looks), and measures or renders that build. `--bars <dir>` holds each shot measured to the
// bars of the run in `<dir>` (its `quality.json`, the physical look's): flicker and pop at most
// 1.5 times its, trail at most its plus a pixel (docs/lookdev.md, "Judging a style"), printed and
// written as `bars.json`; with `--held`, the run already in the output directory is held to them,
// nothing measured.

use shots::{
    CAPTURE_FRAMES, MOVE_FRAMES, Options, SETTLE_FRAMES, STILL, VIEWS, WS, build_of, check_line,
    chosen, keys, lookbook_of, names_in, names_listed, parse_args, shown_path, stem,
}
use quality::{
    CONTROL_SHOT, Control, DETAIL_SHOT, Driven, FAST_POLL, HEADER, json_list, judged, lit, measure,
    measured_json, row,
}
use std::input::Script
use std::io::print
use std::json::{Doc, TOP, parse}
use std::tool::{Task, ToolError, args, spawn}
use std::tool::blob::Data
use std::tool::drive
use std::tool::drive::Step
use std::tool::files
use std::tool::image
use std::tool::toolchain
use toolkit::driven::untrapped
use toolkit::page::run_page
use toolkit::whole::{
    blob_of, chunked, copy_file, data_bytes, joined, read_file, write_file, write_png,
}

/// How long a page's clip may take, in seconds.
const CLIP_TIMEOUT: f64 = 600.0

/// A still to render: shot `keys` chooses, at `width` × `height`, from the build in `build`,
/// written as a PNG at `png`; with `capture`, the frame that prints `STILL`.
pub struct Still: Clone {
    pub build: String,
    pub keys: Script,
    pub png: String,
    pub width: u32,
    pub height: u32,
    pub capture: bool,
}

/// The screen as it is (no frame drawn for it): its width, height and RGBA.
fn screen_of(b: drive::Build) -> Result<(u32, u32, Vec<u8>), ToolError> {
    var seen = drive::steps(b, [Step::Capture], timeout: 600.0).wait()?
    let screen = seen.captures.remove(0)
    Ok((screen.width, screen.height, joined(data_bytes(take screen.rgba)?)))
}

/// `s`'s still, rendered and written: the frame `SETTLE_FRAMES` in (or, for a shot black then,
/// `SETTLE_FRAMES` after it shows), or with `capture` the frame that prints `STILL`. The PNG's
/// path.
pub fn still(s: take Still) -> Result<String, ToolError> {
    var options = drive::gpu()
    options.width = s.width
    options.height = s.height
    options.timeout = 600.0
    let b = drive::load(s.build.as_str(), options).wait()?.build
    let _ = untrapped("init", drive::steps(b, [Step::Init], timeout: 600.0).wait()?)?
    if s.capture {
        var seen = false
        var n = 0
        while !seen && n < CAPTURE_FRAMES {
            let frame = drive::steps(b, [Step::Frames(1, s.keys.clone())], timeout: 600.0).wait()?
            var saw = untrapped(f"frame {n}", take frame)?
            for line in drive::lines(mut saw)? {
                if line.as_str().find(STILL).is_some() {
                    seen = true
                }
            }
            n += 1
        }
        if !seen {
            return Err(
                ToolError::new(f"it didn't print \"{STILL}\" within {CAPTURE_FRAMES} frames"),
            )
        }
    } else {
        let frames = [Step::Frames(SETTLE_FRAMES + 1, s.keys.clone())]
        let _ = untrapped("the frames", drive::steps(b, frames, timeout: 600.0).wait()?)?
    }
    var shown = screen_of(b)?
    // A shot whose content hasn't arrived by then (black: a far place streams in) is run on until
    // it shows (`Driven::shown`), then settled as long again; a shot shown in time is the frame it
    // always was.
    if !s.capture && !lit(shown.2) {
        var d = Driven { b, script: s.keys.clone(), frame: 0, width: s.width }
        if let Err(e) = d.shown(step: FAST_POLL) {
            let _ = drive::close(b).wait()
            return Err(take e)
        }
        print(f"lookbook: {s.png} shown {d.frame} frames late; settled {SETTLE_FRAMES} more")
        let _ = d.run(SETTLE_FRAMES)?
        shown = screen_of(b)?
    }
    let _ = drive::close(b).wait()
    let (width, height, rgba) = take shown
    let img = image::Image { width, height, rgba: Data::Blob(blob_of(chunked(take rgba))?) }
    write_png(take img, s.png.as_str())?
    Ok(take s.png)
}

/// Shot `i`'s move as a clip in Chrome (1080p, paced, its jobs on `workers` threads), from the
/// build in `build`, copied to `webm`.
pub fn clip(build: str, keys: Script, webm: str, workers: u32) -> Result<(), ToolError> {
    let script = String::from(f"{build}/lookbook-keys.json")
    let _ = files::write(script.as_str(), String::from(keys.as_json()).as_bytes()).wait()?
    let frames = SETTLE_FRAMES + MOVE_FRAMES + 30
    let hash = String::from(
        f"#test&frames={frames}&width=1920&height=1080&fps=60&workers={workers}&paced=1&nohash=1&input=lookbook-keys.json&clipfrom={SETTLE_FRAMES}&clip={MOVE_FRAMES}",
    )
    let ran = run_page(build, hash.as_str(), width: 1920, height: 1080, timeout: CLIP_TIMEOUT)
    let _ = files::remove(script.as_str()).wait()
    let _ = (take ran)?
    copy_file(f"{build}/results/clip.webm", webm)
}

/// The median of `v`.
fn median(v: take Vec<f64>) -> f64 {
    var w = take v
    w.sort_by(|a: f64, b: f64| a < b)
    w[w.len() / 2]
}

/// The median of each of `runs`' flicker, pop, still pop, trail, PSNR, SSIM and sharpness (the
/// first run's for the rest).
pub fn medians(runs: Vec<quality::Measured>) -> quality::Measured {
    var psnr: Vec<f64> = Vec::new()
    var ssim: Vec<f64> = Vec::new()
    var sharpness: Vec<f64> = Vec::new()
    var flicker: Vec<f64> = Vec::new()
    var pop: Vec<f64> = Vec::new()
    var still_pop: Vec<f64> = Vec::new()
    var trail: Vec<f64> = Vec::new()
    for m in runs {
        psnr.push(m.psnr)
        ssim.push(m.ssim)
        sharpness.push(m.sharpness)
        flicker.push(m.flicker)
        pop.push(m.pop)
        still_pop.push(m.still_pop)
        trail.push(m.trail)
    }
    quality::Measured {
        psnr: median(take psnr),
        ssim: median(take ssim),
        sharpness: median(take sharpness),
        flicker: median(take flicker),
        pop: median(take pop),
        still_pop: median(take still_pop),
        trail: median(take trail),
        ..runs[0].clone(),
    }
}

/// `program` built in look `look` (`--set LOOK=<look>`) into build/looks: the build's directory.
fn built_in(program: str, look: str) -> Result<String, ToolError> {
    let parts = look.split("::")
    let (a, b) = parts[parts.len() - 1]
    let names = program.split("/")
    let (pa, pb) = names[names.len() - 1]
    let out = String::from(f"{WS}/build/looks/{program.slice(pa, pb)}-{look.slice(a, b)}")
    print(f"building {program} in {look} into {out}")
    build_in(program, look, out.as_str())?
    Ok(out)
}

/// `program` built into `out` in look `look` (`wrela build --set LOOK=<look>`, the
/// `engine::style` the program names), its errors printed if it doesn't build.
pub fn build_in(program: str, look: str, out: str) -> Result<(), ToolError> {
    var options = toolchain::options()
    options.timeout = 600.0
    options.set.push(toolchain::Set { name: String::from("LOOK"), value: String::from(look) })
    let made = toolchain::build(program, out, options).wait()?
    if !made.ok {
        for d in made.diagnostics {
            if d.error {
                print(d.rendered.as_str())
            }
        }
        return Err(ToolError::new(f"{program} didn't build in {look}"))
    }
    Ok(())
}

/// The bars a run is held to from the physical look's measures (`base`: flicker, pop, trail):
/// flicker and pop at most 1.5 times its, trail at most its plus a pixel (docs/lookdev.md,
/// **proposed**).
pub fn bars(base: (f64, f64, f64)) -> (f64, f64, f64) {
    let (bf, bp, bt) = base
    (1.5 * bf, 1.5 * bp, bt + 1.0)
}

/// Whether a look's measures (`flicker`, `pop`, `trail`) hold the bars from `base` (`bars`).
pub fn holds(flicker: f64, pop: f64, trail: f64, base: (f64, f64, f64)) -> (bool, bool, bool) {
    let (mf, mp, mt) = bars(base)
    (flicker <= mf, pop <= mp, trail <= mt)
}

/// Each shot's flicker, pop and trail in a run's `quality.json` text (`text`): (shot, the three).
pub fn measures_in(text: str) -> Vec<(String, f64, f64, f64)> {
    var out: Vec<(String, f64, f64, f64)> = Vec::new()
    let Some(d) = parse(text) else { return out }
    for k in 0..d.count(TOP) {
        let Some(e) = d.at(TOP, k) else { continue }
        let num = |key: str| match d.get(e, key) {
            Some(v) => d.num(v).unwrap_or(0.0),
            None => 0.0,
        }
        let shot = match d.get(e, "shot") {
            Some(v) => d.text(v).unwrap_or(String::new()),
            None => String::new(),
        }
        out.push((take shot, num("flicker"), num("pop"), num("trail")))
    }
    out
}

/// The shots of `ran` (this run's `quality.json` text) held to the bars of the run in `dir`: a
/// table printed and `bars.json` written into `out`. Whether every shot held them (a shot the
/// baseline lacks misses; no measures either side is an error).
fn barred(ran: str, dir: str, out: str) -> Result<bool, ToolError> {
    let at = String::from(f"{WS}/{dir}/quality.json")
    let base = String::from_utf8(read_file(at.as_str(), at.as_str())?).unwrap_or(String::new())
    let bases = measures_in(base.as_str())
    if bases.is_empty() || measures_in(ran).is_empty() {
        return Err(ToolError::new(f"no measures to hold: {at} or this run's quality.json"))
    }
    print("| Shot | flicker ×10⁻⁶ (bar) | pop (bar) | trail px (bar) | |\n|---|---|---|---|---|")
    var lines: Vec<String> = Vec::new()
    var all = true
    for (shot, f, p, t) in measures_in(ran) {
        var found: Option<(f64, f64, f64)> = None
        for (bs, bf, bp, bt) in bases {
            if bs.as_str() == shot.as_str() {
                found = Some((bf, bp, bt))
            }
        }
        let Some(b) = found else {
            print(f"| {shot} | (no baseline) | | | misses |")
            all = false
            continue
        }
        let (bf, bp, bt) = bars(b)
        let (hf, hp, ht) = holds(f, p, t, b)
        let ok = hf && hp && ht
        all = all && ok
        print(
            f"| {shot} | {f * 1.0e6:.2} ({bf * 1.0e6:.2}) | {p:.4} ({bp:.4}) | {t:.0} ({bt:.0}) | {if ok { "holds" } else { "misses" }} |",
        )
        lines.push(
            String::from(
                f"{{\"shot\": \"{shot}\", \"flicker\": {f}, \"flicker_bar\": {bf}, \"pop\": {p}, \"pop_bar\": {bp}, \"trail\": {t}, \"trail_bar\": {bt}, \"holds\": {ok}}}",
            ),
        )
    }
    write_file(f"{out}/bars.json", Vec::from([Vec::from(json_list(lines).as_bytes())]))?
    Ok(all)
}

/// Every shot held its bars, said; or a miss, failing the tool (its table and `bars.json` say
/// which).
fn held_or_missed(all: bool) -> Result<(), ToolError> {
    if all {
        print("every shot holds its bars")
        return Ok(())
    }
    Err(ToolError::new("a shot misses its bars (bars.json)"))
}

/// `--held`: the run already in `o.out` held to `--bars`, nothing measured.
fn held(o: Options) -> Result<(), ToolError> {
    if o.bars.is_empty() {
        return Err(ToolError::new("--held takes --bars <dir>"))
    }
    let out = o.out.as_str()
    let at = String::from(f"{out}/quality.json")
    let ran = String::from_utf8(read_file(at.as_str(), at.as_str())?).unwrap_or(String::new())
    held_or_missed(barred(ran.as_str(), o.bars.as_str(), out)?)
}

/// Makes the stills, then the clips, as `o` says.
pub fn lookbook(o: Options) -> Result<(), ToolError> {
    if o.held {
        return held(o)
    }
    let (view, presses, listed) = VIEWS[o.view]
    let build = if o.look.is_empty() { build_of(o.program.as_str()) } else {
        built_in(o.program.as_str(), o.look.as_str())?
    }
    let names_at = if listed.is_empty() {
        lookbook_of(o.program.as_str())
    } else {
        String::from(f"{build}/files/{listed}/shots.json")
    }
    let source = String::from_utf8(read_file(names_at.as_str(), names_at.as_str())?).unwrap_or(
        String::new(),
    )
    let shots = if listed.is_empty() {
        names_in(source.as_str())
    } else {
        let Some(n) = names_listed(source.as_str()) else {
            return Err(ToolError::new(f"{names_at} isn't a list of names"))
        }
        take n
    }
    let picks = chosen(o, shots)
    for i in picks {
        if i >= shots.len() {
            return Err(ToolError::new(f"no shot {i}: the {view} view has {shots.len()}"))
        }
    }
    let _ = files::make_dirs(o.out.as_str()).wait()?
    if o.quality {
        return lookdev(o, build.as_str(), presses, shots)
    }
    // The interest check's numbers, for the look and its debug views of form.
    var check: Option<Doc> = None
    if listed.is_empty() {
        let numbers = String::from(f"{build}/files/check/shots.json")
        if let Ok(bytes) = read_file(numbers.as_str(), numbers.as_str()) {
            check = std::json::parse(
                String::from_utf8(bytes.clone()).unwrap_or(String::new()).as_str(),
            )
            write_file(f"{o.out}/check.json", Vec::from([take bytes]))?
        }
    }
    // The stills, `jobs` at a time, each printed in order as it and those before it end.
    var running: Vec<Task<Result<String, ToolError>>> = Vec::new()
    var next = 0
    for shown in 0..picks.len() {
        while running.len() < o.jobs && next < picks.len() {
            let i = picks[next]
            let s = Still {
                build: build.clone(),
                keys: keys(i, presses, o.capture),
                png: String::from(f"{o.out}/{stem(i, shots[i].as_str())}.png"),
                width: o.width,
                height: o.height,
                capture: o.capture,
            }
            running.push(spawn(take s, still))
            next += 1
        }
        let png = running.remove(0).join()?
        print(shown_path(png.as_str()))
        if let Some(doc) = check {
            if let Some(line) = check_line(doc, picks[shown]) {
                print(line.as_str())
            }
        }
    }
    if !o.stills {
        for i in picks {
            let webm = String::from(f"{o.out}/{stem(i, shots[i].as_str())}.webm")
            let k = keys(i, presses, capture: false)
            if let Err(e) = clip(build.as_str(), k, webm.as_str(), o.workers) {
                return Err(ToolError::new(f"shot {i} ({shots[i]})'s clip failed: {e.message()}"))
            }
            print(shown_path(webm.as_str()))
        }
    }
    Ok(())
}

/// The lookdev instrument's measures of `o`'s shots (`shots`, drawn with `presses` of F8) from
/// the build in `build`, as a table and `quality.json`; with `--controls`, its negative controls
/// too, as `controls.json` (docs/lookdev.md): on `CONTROL_SHOT`, and the detail removal on
/// `DETAIL_SHOT`.
fn lookdev(o: Options, build: str, presses: u32, shots: Vec<String>) -> Result<(), ToolError> {
    let picks = chosen(o, shots)
    let out = o.out.as_str()
    // Shot `i`'s run (`what` names its files after the shot's), with the blurred play's measures
    // if `blurs`, changed as `c` says.
    let run = |i: u32, what: str, blurs: bool, c: Control| -> Result<quality::Measured, ToolError> {
        let name = stem(i, shots[i].as_str())
        let m = measure(
            f"{out}/{name}{what}",
            build,
            i,
            presses,
            o.width,
            o.height,
            blurs,
            c,
            fast: o.fast,
            psnr_too: o.psnr,
        )?
        print(row(f"{name}{what}", m.clone()).as_str())
        Ok(take m)
    }
    print(HEADER)
    var entries: Vec<String> = Vec::new()
    var ran: Vec<(u32, quality::Measured)> = Vec::new()
    for i in picks {
        var m = run(i, "", o.controls && i == CONTROL_SHOT, Control {})?
        if o.runs > 1 {
            var more: Vec<quality::Measured> = Vec::from([m.clone()])
            for r in 1..o.runs {
                more.push(run(i, f"-run{r + 1}", false, Control {})?)
            }
            m = medians(more)
            print(row(f"{stem(i, shots[i].as_str())} (median of {o.runs})", m.clone()).as_str())
        }
        entries.push(measured_json(stem(i, shots[i].as_str()).as_str(), m.clone(), "measured"))
        ran.push((i, take m))
    }
    let listed = json_list(entries)
    write_file(f"{out}/quality.json", Vec::from([Vec::from(listed.as_bytes())]))?
    // Held to the bars (but failing the tool after the controls, so a miss still writes them).
    let held = if o.bars.is_empty() { true } else { barred(listed.as_str(), o.bars.as_str(), out)? }
    if !o.controls {
        return held_or_missed(held)
    }
    // The plain runs the controls compare with: the table's, or their own.
    let plain = match ran_of(ran, CONTROL_SHOT) {
        Some(m) => take m,
        None => run(CONTROL_SHOT, "", true, Control {})?,
    }
    let ghost = run(CONTROL_SHOT, "-ghost", false, Control { blend: 0.02 })?
    let detail = match ran_of(ran, DETAIL_SHOT) {
        Some(m) => take m,
        None => run(DETAIL_SHOT, "", false, Control {})?,
    }
    let thinned = run(DETAIL_SHOT, "-thinned", false, Control { thin: 0.5 })?
    var lines: Vec<String> = Vec::new()
    var all = true
    for (control, passed, saw) in judged(plain, ghost.clone()) {
        print(f"{control}: {if passed { "passes" } else { "FAILS" }}: {saw}")
        lines.push(
            String::from(
                f"{{\"control\": \"{control}\", \"passed\": {passed}, \"saw\": \"{saw}\"}}",
            ),
        )
        all = all && passed
    }
    let (control_name, detail_name) = (
        stem(CONTROL_SHOT, shots[CONTROL_SHOT].as_str()),
        stem(DETAIL_SHOT, shots[DETAIL_SHOT].as_str()),
    )
    lines.push(
        String::from(
            f"{{\"control\": \"ghost run\", \"measured\": {measured_json(control_name.as_str(), ghost, "control")}}}",
        ),
    )
    // Degraded whatever its PSNR says: the blind judge's calibration pair.
    print(
        f"detail removal: degraded (PSNR {detail.psnr:.2} → {thinned.psnr:.2} dB with half the grass)",
    )
    lines.push(
        String::from(
            f"{{\"control\": \"detail removal\", \"plain\": {measured_json(detail_name.as_str(), detail, "measured")}, \"measured\": {measured_json(detail_name.as_str(), thinned, "degraded")}}}",
        ),
    )
    write_file(f"{out}/controls.json", Vec::from([Vec::from(json_list(lines).as_bytes())]))?
    if !all {
        return Err(ToolError::new("a negative control failed (controls.json)"))
    }
    held_or_missed(held)
}

/// Shot `i`'s measures in `ran`, if it was measured.
fn ran_of(ran: [(u32, quality::Measured)], i: u32) -> Option<quality::Measured> {
    for (k, m) in ran {
        if k == i {
            return Some(m.clone())
        }
    }
    None
}

pub fn tool() -> u32 {
    let o = match parse_args(args()) {
        Ok(o) => take o,
        Err(e) => {
            print(e.as_str())
            return 2
        },
    }
    match lookbook(o) {
        Ok(_) => 0,
        Err(e) => {
            print(f"lookbook: {e.message()}")
            1
        },
    }
}
