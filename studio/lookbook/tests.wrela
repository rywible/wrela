// The lookbook tool's tests: its command line, the keys that choose a shot, the shots' names
// and files, and the interest check's line, on small fixtures.

use shots::{
    PROGRAM, VIEWS, WS, build_of, check_line, keys, lookbook_of, names_in, names_listed, parse_args,
    shown_path, stem,
}
use measures::{
    sharpness, blurred, clipped, edge_width, flicker, luma, mean_of, pop, psnr, quartered, ssim,
    trail,
}
use std::json::parse
use std::tool::blob::Data
use std::tool::files
use std::tool::image
use toolkit::whole::{copy_file, data_bytes, joined, read_file, write_file, write_png}

fn texts(lines: [Text]) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for l in lines {
        out.push(String::from(l))
    }
    out
}

@test
fn the_command_line_takes_a_directory_its_options_and_shots() {
    let Ok(o) = parse_args(
        texts(
            [
                "build/lb",
                "--stills",
                "--view",
                "grown",
                "--size",
                "1280x720",
                "--jobs",
                "3",
                "2",
                "5",
            ],
        ),
    ) else {
        panic("a run")
    }
    assert(o.out.as_str() == "ws/build/lb" && o.stills && !o.capture, o.out.as_str())
    assert(VIEWS[o.view].0 == "grown" && o.width == 1280 && o.height == 720 && o.jobs == 3)
    assert(o.picks.len() == 2 && o.picks[0] == 2 && o.picks[1] == 5)
    let Ok(plain) = parse_args(texts(["out"])) else { panic("defaults") }
    assert(plain.width == 1920 && plain.height == 1080 && plain.jobs == 1 && plain.workers == 8)
    assert(parse_args(texts(["out", "--view", "fog"])).is_err(), "an unknown view")
    assert(parse_args(texts(["out", "--jobs", "0"])).is_err(), "no jobs")
    assert(parse_args(texts(["out", "--size", "1280"])).is_err(), "a size without its height")
    assert(parse_args(texts(["/tmp/out"])).is_err(), "a directory outside the workspace")
    assert(parse_args(texts([])).is_err(), "no directory")
    assert(shown_path("ws/build/lb") == "build/lb" && WS == "ws")
}

/// The floor's lookbook unless `--package` names another program's, whose build and shots are
/// beside its source.
@test
fn the_package_is_the_floors_unless_another_is_named() {
    let Ok(floor) = parse_args(texts(["out"])) else { panic("defaults") }
    assert(floor.program.as_str() == PROGRAM && PROGRAM == "ws/games/last-green")
    let Ok(o) = parse_args(texts(["out", "--package", "examples/clearing", "1"])) else {
        panic("a package")
    }
    assert(o.program.as_str() == "ws/examples/clearing", o.program.as_str())
    assert(build_of(o.program.as_str()).as_str() == "ws/examples/clearing/build")
    assert(lookbook_of(o.program.as_str()).as_str() == "ws/examples/clearing/lookbook.wrela")
    assert(o.picks.len() == 1 && o.picks[0] == 1, "the shot after it")
    assert(parse_args(texts(["out", "--package", "/elsewhere"])).is_err(), "outside the workspace")
}

@test
fn a_shot_is_chosen_as_a_player_would_after_its_view() {
    // F7 (capture mode), F8 twice (silhouette), then L, 1, 2, Enter: all at frame 1.
    let k = keys(i: 12, presses: 2, capture: true)
    let j = k.as_json()
    var at = 0
    var codes: Vec<String> = Vec::new()
    loop {
        let Some(c) = j.slice(at, j.len()).find("\"code\": ") else { break }
        let from = at + c + 8
        var to = from
        while j.byte(to) >= 48 && j.byte(to) <= 57 {
            to += 1
        }
        codes.push(String::from(j.slice(from, to)))
        at = to
    }
    let want = [
        u32(std::input::Key::F7),
        u32(std::input::Key::F8),
        u32(std::input::Key::F8),
        u32(std::input::Key::L),
        u32(std::input::Key::Digit1),
        u32(std::input::Key::Digit2),
        u32(std::input::Key::Enter),
    ]
    assert(codes.len() == want.len(), j)
    for i in 0..want.len() {
        assert(codes[i].as_str() == String::from(f"{want[i]}").as_str(), j)
    }
    assert(j.find("\"frame\": 2").is_none(), j)
}

@test
fn shots_are_named_from_the_lookbook_or_the_build() {
    let source = "const SHOTS = [\n    Shot {\n        name: \"the clearing\",\n        eye: x,\n    },\n    Shot { name: \"the crag's top\", eye: y },\n    // Shot {} in a comment, unnamed\n]"
    let names = names_in(source)
    assert(names.len() == 2, f"{names.len()}")
    assert(names[0].as_str() == "the clearing" && names[1].as_str() == "the crag's top")
    assert(stem(1, names[1].as_str()).as_str() == "01-the-crags-top")
    assert(stem(12, "the ring").as_str() == "12-the-ring")
    let Some(listed) = names_listed("[\"a bare ridge\", \"the scarp\"]") else { panic("a list") }
    assert(listed.len() == 2 && listed[1].as_str() == "the scarp")
    assert(names_listed("{\"a\": 1}").is_none() && names_listed("[1]").is_none())
}

@test
fn the_checks_line_says_its_state_and_strongest_draws() {
    let Some(doc) = parse(
        "[{\"view\": {\"best\": 0.789, \"count\": 10, \"dead\": false, \"quiet\": false, \"draws\": [{\"pull\": \"the great oak\", \"strength\": 0.789}, {\"pull\": \"the crag\", \"strength\": 0.692}, {\"pull\": \"the gap\", \"strength\": 0.351}, {\"pull\": \"a trail\", \"strength\": 0.35}, {\"pull\": \"a feature\", \"strength\": 0.3}]}}, {\"view\": {\"best\": 0.1, \"count\": 0, \"dead\": false, \"quiet\": true, \"draws\": []}}]",
    ) else {
        panic("the check's numbers")
    }
    let Some(line) = check_line(doc, 0) else { panic("shot 0") }
    assert(
        line.as_str() ==
            "  the check: 10 draw; strongest 0.79 (the great oak 0.79, the crag 0.69, the gap 0.35, a trail 0.35)",
        line.as_str(),
    )
    let Some(quiet) = check_line(doc, 1) else { panic("shot 1") }
    assert(quiet.as_str() == "  the check: quiet; strongest 0.10", quiet.as_str())
    assert(check_line(doc, 2).is_none(), "no such shot")
}

/// The toolkit's whole files, as the stills and clips use them: a file past a request's 512 KiB
/// written and read back through a blob, copied, and pixels written as a PNG that decodes to them.
@test(tool, budget: 60)
fn files_and_pngs_go_whole_through_the_toolkit() {
    var big: Vec<u8> = Vec::new()
    for i in 0..600000 {
        big.push(u8(i % 251))
    }
    assert(write_file("scratch/a/big.bin", Vec::from([big.clone()])).is_ok(), "written")
    assert(copy_file("scratch/a/big.bin", "scratch/b.bin").is_ok(), "copied")
    let Ok(back) = read_file("scratch/b.bin", "b.bin") else { panic("read") }
    assert(back.len() == big.len() && back[599999] == big[599999] && back[524288] == big[524288])
    // A 3 × 2 image, its pixels distinct, as a PNG that decodes to them.
    var px: Vec<u8> = Vec::new()
    for i in 0..24 {
        px.push(u8(10 * i))
    }
    let img = image::Image { width: 3, height: 2, rgba: Data::Bytes(px.clone()) }
    assert(write_png(take img, "scratch/s.png").is_ok(), "the PNG")
    let Ok(png) = files::read("scratch/s.png").wait() else { panic("the PNG's bytes") }
    let Ok(decoded) = image::decode(Data::Bytes(take png)).wait() else { panic("decoded") }
    let Ok(chunks) = data_bytes(decoded.rgba.clone()) else { panic("its pixels") }
    let got = joined(take chunks)
    assert(decoded.width == 3 && decoded.height == 2 && got.len() == 24 && got[23] == 230)
}

// ---- the lookdev measures (measures.wrela) -----------------------------------------------------

/// A `w` × `h` test image: a soft gradient with a sharp vertical edge at `edge` and fine stripes
/// (the detail a blur or a lower resolution loses).
fn scene_image(w: u32, h: u32, edge: u32) -> Vec<u8> {
    var out = Vec::new()
    for y in 0..h {
        for x in 0..w {
            let base = 40 + (x * 100) / w + (y * 40) / h
            let stripe = if (x / 2 + y / 3) % 2 == 0 { 30 } else { 0 }
            let v = if x >= edge { base + 60 + stripe } else { base + stripe }
            for c in 0..3 {
                out.push(u8(min(v + c * 5, 254)))
            }
            out.push(255)
        }
    }
    out
}

/// `rgba` with each pixel's channels moved by a hashed amount up to `amp`, for `seed`.
fn noisy(rgba: [u8], seed: u32, amp: u32) -> Vec<u8> {
    var out = Vec::new()
    for i in 0..rgba.len() {
        var hsh = (u32(i) ^ seed.wrapping_mul(747796405)).wrapping_mul(2654435761)
        hsh = hsh ^ (hsh >> 15)
        let d = i32(hsh % (2 * amp + 1)) - i32(amp)
        out.push(if i % 4 == 3 { rgba[i] } else { u8(clamp(i32(rgba[i]) + d, 0, 254)) })
    }
    out
}

@test
fn the_measures_react_as_the_instrument_needs() {
    let (w, h) = (64, 48)
    let reference = scene_image(w, h, 32)
    let rl = luma(reference)
    // Equal images: the best scores.
    assert(psnr(rl, rl) == 100.0 && abs(ssim(rl, rl, w) - 1.0) < 1.0e-9)
    // A quarter-resolution render loses at least 3 dB.
    let quarter = luma(quartered(reference, w, h))
    let play = luma(noisy(reference, seed: 1, amp: 2))
    assert(psnr(play, rl) - psnr(quarter, rl) >= 3.0)
    // A 3 × 3 blur (the negative control) loses at least 1 dB, although its flicker falls.
    let blur = luma(blurred(noisy(reference, seed: 1, amp: 2), w, h))
    assert(psnr(play, rl) - psnr(blur, rl) >= 1.0)
    // And it's softer than the reference, which an image of the reference isn't.
    assert(abs(sharpness(rl, rl, w) - 1.0) < 1.0e-9 && sharpness(blur, rl, w) < 0.9)
    var frames: Vec<Vec<f32>> = Vec::new()
    var blurred_frames: Vec<Vec<f32>> = Vec::new()
    for k in 0..8 {
        let f = noisy(reference, seed: k + 2, amp: 6)
        blurred_frames.push(luma(blurred(f, w, h)))
        frames.push(luma(f))
    }
    assert(flicker(blurred_frames) < flicker(frames))
    // Per-frame noise raises flicker; a still image has none, and no pop.
    var still: Vec<Vec<f32>> = Vec::new()
    for _ in 0..8 {
        still.push(rl.clone())
    }
    assert(flicker(still) == 0.0 && pop(still) == 0.0 && flicker(frames) > 1.0e-5)
    // A frame shifted by a pixel pops more than the noise does.
    let shifted = luma(scene_image(w, h, 33))
    assert(pop([rl.clone(), shifted.clone()]) > 0.0)
    // A history dragging 6 pixels behind the edge is a 6-pixel trail; the reference has none.
    let ghost = luma(scene_image(w, h, 38))
    assert(trail(rl, rl, w) == 0.0 && trail(ghost, rl, w) >= 4.0)
    // The edge stays sharp in a mean of jittered frames of it.
    let mean = mean_of([reference.clone(), reference.clone()])
    assert(edge_width(luma(mean), w) <= edge_width(rl, w) + 1)
    // Clipping: an image of 255s is all clipped; the scene isn't.
    var white = Vec::new()
    for _ in 0..w * h * 4 {
        white.push(255)
    }
    assert(clipped(white) == 1.0 && clipped(reference) == 0.0)
}
