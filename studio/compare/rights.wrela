// What a reference's licence lets the review do with it (plan three's §B3.1): a copy kept outside
// the repository, shown to an agent judge with its credit, resized for display, published. Only a
// work whose permission covers a local copy and an agent judge's view is eligible; anything
// unknown is link-only, which the review refuses, and never fetches.

use references::vale::VisualReference

/// Whether `licence` (as a reference's page states it) permits what a review does with a
/// reference (a copy kept outside the repository, shown to an agent judge with its credit beside
/// it, resized for display, and published with its credit and notice): a public-domain or CC0
/// work, or a CC BY or CC BY-SA one with its credit and notice; anything else (unknown, all rights
/// reserved, a silent page) is link-only and permits none of it.
pub fn permits(licence: str) -> bool {
    licence.starts_with("CC0") ||
        licence.starts_with("Public domain") ||
        licence.starts_with("CC BY")
}

/// Whether reference `r` may stand in a panel: its permission covers a local copy, an agent
/// judge's view and a display's resizing, and it has a local copy and a hash. Why not, if not.
pub fn eligible(r: VisualReference) -> Option<String> {
    if !permits(r.licence) {
        return Some(
            String::from(
                f"{r.id}: its licence ({r.licence}) doesn't permit what a review does: link-only, refused",
            ),
        )
    }
    if r.local_file.len() == 0 || r.sha256.len() != 64 {
        return Some(String::from(f"{r.id}: no local copy and hash: link-only, refused"))
    }
    None
}
