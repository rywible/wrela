// The bench tool's tests: its command line, its statistics, its reading of a page's GPU timings
// and its report, written as a later `--compare` reads it and as docs/bench.md shows it.

use main::{chosen, measure, parse_args}
use report::{
    hitches, Measured, Stats, compared, date_of, doc, intervals, markdown, report_json, spans,
    stats, time_of,
}
use scenes::{SCENES, Scene, script}
use std::tool::files

fn texts(lines: [Text]) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for l in lines {
        out.push(String::from(l))
    }
    out
}

fn contains(haystack: str, needle: str) -> bool {
    haystack.find(needle).is_some()
}

@test
fn the_command_line_names_scenes_and_cuts_frames() {
    let Some(o) = parse_args(
        texts(["--scene", "herd", "--frames", "30", "--warmup", "10", "--no-native"]),
    ) else {
        panic("a short bench of the herd")
    }
    assert(o.frames == 30 && o.warmup == 10 && !o.native && o.docs)
    let picked = chosen(o)
    assert(picked.len() == 1 && picked[0].name == "herd" && picked[0].frames == 30)
    let Some(all) = parse_args(texts([])) else { panic("every scene") }
    assert(chosen(all).len() == SCENES.len())
    assert(parse_args(texts(["--scene", "nowhere"])).is_none(), "an unknown scene")
    assert(parse_args(texts(["--frames"])).is_none(), "an option without its value")
}

@test
fn each_gated_scene_has_its_gates_script() {
    // The gates' own files' events (build/gates/CLEARING_PATH.json): H's code is 8.
    assert(
        contains(
            script("clearing-path").as_json(),
            "{\"frame\": 400, \"type\": \"keydown\", \"code\": 8}",
        ),
    )
    assert(contains(script("last-green-walk").as_json(), "1140"))
    assert(contains(script("capybara-run-large").as_json(), "573"))
    assert(!contains(script("herd").as_json(), "frame"))
}

@test
fn statistics_are_by_nearest_rank() {
    var xs: Vec<f64> = Vec::new()
    for k in 0..100 {
        xs.push(f64(100 - k))
    }
    let s = stats(take xs)
    assert(s.p50 == 50.0 && s.p95 == 95.0 && s.p99 == 99.0)
    let none = stats(Vec::new())
    assert(none.p50 == 0.0 && none.p99 == 0.0)
}

@test
fn a_frames_gpu_span_is_its_first_start_to_its_last_end_whatever_the_origin() {
    // Times are from the host's first timestamp, so they may be negative.
    let Ok(d) = doc(
        "[{\"frame\": 0, \"start\": 0, \"end\": 5}, {\"frame\": 1, \"start\": -3000000, \"end\": -1000000}, {\"frame\": 1, \"start\": -2000000, \"end\": 500000}]",
        "timings",
    ) else {
        panic("timings")
    }
    let s = spans(d, 1)
    assert(s.len() == 1 && s[0] == 3.5)
    let between = intervals(Vec::from([0.0, 16.0, 33.0, 50.0]), 1)
    assert(between.len() == 3 && between[1] == 17.0)
}

@test
fn a_report_reads_back_for_a_comparison_and_shows_as_a_table() {
    let st = Stats { p50: 2.0, p95: 3.0, p99: 4.0 }
    let m = Measured {
        scene: String::from("herd"),
        span: st,
        interval: st,
        over_16: 1,
        over_33: 0,
        cpu: st,
        native: st,
        first_frame_ms: 100.0,
        playable_ms: 0.0,
        pipelines_ms: 50.0,
        loaded_bytes: 1048576.0,
        gpu_bytes: 2097152.0,
        gpu_peak: 2097152.0,
        warm_playable_ms: 40.0,
        warm_pipelines_ms: 0.0,
        warm_loaded_bytes: 1024.0,
        hitches: Vec::new(),
        compiles: Vec::new(),
        runs: Vec::new(),
    }
    let all = Vec::from([m.clone()])
    let text = report_json("Apple M4", "2026-10-25", all)
    let Ok(earlier) = doc(text.as_str(), "report") else { panic("the report is JSON") }
    var faster = m.clone()
    faster.span = Stats { p50: 1.0, p95: 3.0, p99: 4.0 }
    let lines = compared(earlier, Vec::from([take faster]))
    assert(contains(lines.as_str(), "herd: GPU span p50 2.00 -> 1.00 (-50.0%)"), lines.as_str())
    let table = markdown("Apple M4", "2026-10-25", Vec::from([take m]))
    assert(contains(table.as_str(), "## 2026-10-25, Apple M4"))
    assert(contains(table.as_str(), "| herd | 2.00 / 3.00 / 4.00 |"))
    assert(contains(table.as_str(), "| 1.0 | 40.00 | 0.0 | 2.0 |"), table.as_str())
}

@test
fn a_date_is_the_civil_day_of_its_milliseconds() {
    assert(date_of(0.0) == "1970-01-01")
    assert(date_of(1792886400000.0) == "2026-10-25")
    assert(date_of(951782400000.0) == "2000-02-29")
    // Two runs on one day are two reports.
    assert(time_of(1792886400000.0 + 3723000.0) == "010203")
}

@test
fn a_paced_runs_hitches_name_their_heaviest_labels() {
    // Frames 0..4 at 16.6 ms but frame 3, 40 ms late: one hitch; frame 4's 50 ms has no label
    // over 2 ms and 1 ms of CPU, so it's the browser's.
    let frames = "{\"began_ms\": [0, 16.6, 33.2, 73.2, 123.2], \"cpu_ms\": [1, 1, 1, 9, 1], \"phases\": [{}, {}, {}, {\"cook\": 6, \"passes\": 2}, {}], \"labels\": [[], [], [], [[\"terrain cook\", 4.5], [\"sky\", 12.25]], [[\"sky\", 0.5]]]}"
    let counters = "[{}, {}, {}, {\"draws\": 31, \"write_buffer_bytes\": 4096}, {}]"
    let (Ok(f), Ok(c)) = (doc(frames, "frames"), doc(counters, "counters")) else { panic("JSON") }
    let h = hitches(f, c, 1)
    assert(h.len() == 2 && h[0].frame == 3 && h[1].frame == 4)
    assert(h[0].labels[0].0.as_str() == "sky" && h[0].phases[0].0.as_str() == "cook")
    assert(h[0].draws == 31 && h[0].written == 4096.0 && !h[0].unattributed())
    assert(h[1].unattributed())
}

/// The bench of a small scene (examples/hello-field, 30 frames after 10 of warmup, at 640 × 360)
/// keeps each run's results where the report names them, and its report has the warm start and
/// the hitch table, an empty one or not.
@test(tool, read: [("ws", "../..")], browser: true, budget: 600)
fn a_bench_keeps_its_runs_and_reports_the_warm_start_and_the_hitches() {
    let s = Scene {
        name: "hello-field",
        pkg: "examples/hello-field",
        frames: 30,
        width: 640,
        height: 360,
    }
    let Some(o) = parse_args(texts(["--warmup", "10", "--no-docs"])) else { panic("the options") }
    let Ok((m, _, machine)) = measure(
        s,
        o,
        salt: 1,
        build: true,
        ws: "ws",
        out: "scratch",
        kept: "scratch/kept",
    ) else {
        panic("the bench of hello-field")
    }
    assert(m.runs.len() == 4)
    let named = ["gpu", "play", "cold", "warm"]
    for k in 0..4 {
        let run = named[k]
        assert(m.runs[k].as_str() == f"scratch/kept/hello-field/{run}", m.runs[k].as_str())
        for file in ["frames.json", "counters.json", "memory.json", "log.txt"] {
            assert(files::stat(f"{m.runs[k]}/{file}").wait().is_ok(), f"{run}'s {file}")
        }
    }
    // The timed runs' GPU timings (a start isn't timed: its timestamps would cost it), and the
    // starts' loads.
    for k in 0..2 {
        assert(files::stat(f"{m.runs[k]}/timings.json").wait().is_ok(), "a timed run's timings")
    }
    for k in 2..4 {
        assert(files::stat(f"{m.runs[k]}/load.json").wait().is_ok(), "a start's load.json")
    }
    assert(m.warm_playable_ms >= 0.0 && m.warm_loaded_bytes > 0.0, "the warm start's numbers")
    let table = markdown(machine.as_str(), "2026-01-01", [m.clone()])
    assert(contains(table.as_str(), "Warm playable") && contains(table.as_str(), "Hitches"))
    let json = report_json(machine.as_str(), "2026-01-01", [take m])
    for key in [
        "\"hitches\"",
        "\"unattributed\"",
        "\"warm_playable_ms\"",
        "\"runs\"",
        "\"compiles\"",
    ] {
        assert(contains(json.as_str(), key), key)
    }
}

/// A program's `memory shares:` line, its names' spaces kept: what's held, then each share.
@test
fn the_memory_shares_line_is_read() {
    let line = "wrela: memory shares: held 902000000, targets 120000000, leaves' atlas 4194304"
    let sh = report::shares_of(line)
    assert(sh.len() == 3, f"{sh.len()} shares")
    assert(sh[0].0.as_str() == "held" && sh[0].1 == 902000000.0)
    assert(sh[2].0.as_str() == "leaves' atlas" && sh[2].1 == 4194304.0)
    assert(report::shares_of("playable at frame 80").is_empty())
}
