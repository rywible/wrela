// The bench tool (`wrela tool bench`, docs/plan-world-class.md §B1): what each scene costs on
// this machine, in Chrome and natively.
//
// ```text
// wrela tool bench -- [--scene <name>]... [--frames <n>] [--warmup <n>] [--workers <n>]
//     [--compare <report.json>] [--no-native] [--no-docs]
// ```
//
// Each scene's package (scenes.wrela) is built as it ships (optimized) into
// `build/bench/builds/<package>` (its path, a dash for each slash), once for the scenes that share
// it, served (`std::tool::serve`) and run in headless Chrome's test mode (`std::tool::browser`),
// each scene's gate script given as its own input, the command checker off as in a release build:
//
// 1. GPU: `timestamps=1&saturate=1&nohash=1`: each frame's GPU span, its p50, p95 and p99;
// 2. play: `paced=1&inflight=2&nohash=1`: the intervals between frames (p50, p95, p99, and how
//    many over 16.7 and 33 ms), each frame's CPU time, and the GPU memory (`memory.json`);
// 3. cold start: `salt=<n>` (no pipeline cache): ms from the page opening to its first frame
//    and to the program's `playable` print, the pipelines' ms, and the bytes loaded;
// 4. natively, on the native host's GPU (`std::tool::drive`): each frame call's time.
//
// The warmup (60 frames unless `--warmup` says) isn't counted. `--frames` cuts every scene's
// measured frames to that many (to try the tool). The report is written to
// `build/bench/<machine>-<date>.json` and printed as a Markdown table, which is added to
// `docs/bench.md` under a heading of its date and machine (unless `--no-docs`). `--compare`
// prints each scene's change from an earlier report, named by the tool's roots
// (`out/<report>.json` for one in build/bench).

use report::{
    Measured, compared, date_of, doc, hitches, intervals, markdown, number_at, numbers, report_json,
    spans, time_of, stats,
}
use scenes::{SCENES, Scene, script}
use std::io::print
use std::json::TOP
use std::tool::{ToolError, args}
use std::tool::drive
use std::tool::drive::Step
use std::tool::files
use std::tool::time
use std::tool::toolchain
use toolkit::driven::untrapped
use toolkit::page::{keep_results, run_page}
use toolkit::whole::{chunked, read_file, write_file}

pub const USAGE: Text = "usage: wrela tool bench -- [--scene <name>]... [--frames <n>] [--warmup <n>] [--workers <n>] [--compare <report.json>] [--no-native] [--no-docs]"

/// What a run of the bench does.
pub struct Options: Clone {
    pub scenes: Vec<String>,
    pub frames: u32,
    pub warmup: u32,
    pub workers: u32,
    pub compare: String,
    pub native: bool,
    pub docs: bool,
}

/// The options the command line gives, or `None` for a usage error.
pub fn parse_args(given: [String]) -> Option<Options> {
    var o = Options {
        scenes: Vec::new(),
        frames: 0,
        warmup: 60,
        workers: 4,
        compare: String::new(),
        native: true,
        docs: true,
    }
    var k = 0
    while k < given.len() {
        let a = given[k].as_str()
        let value = |k: u32| -> Option<String> {
            if k + 1 < given.len() { Some(given[k + 1].clone()) } else { None }
        }
        if a == "--scene" {
            let v = value(k)?
            var known = false
            for s in SCENES {
                if s.name == v.as_str() {
                    known = true
                }
            }
            if !known {
                return None
            }
            o.scenes.push(take v)
            k += 2
        } else if a == "--frames" {
            o.frames = value(k)?.as_str().parse_u32()?
            k += 2
        } else if a == "--warmup" {
            o.warmup = value(k)?.as_str().parse_u32()?
            k += 2
        } else if a == "--workers" {
            o.workers = value(k)?.as_str().parse_u32()?
            k += 2
        } else if a == "--compare" {
            o.compare = value(k)?
            k += 2
        } else if a == "--no-native" {
            o.native = false
            k += 1
        } else if a == "--no-docs" {
            o.docs = false
            k += 1
        } else {
            return None
        }
    }
    Some(o)
}

/// The scenes `o` names, or every one.
pub fn chosen(o: Options) -> Vec<Scene> {
    var out = Vec::new()
    for s in SCENES {
        var wanted = o.scenes.is_empty()
        for n in o.scenes {
            if n.as_str() == s.name {
                wanted = true
            }
        }
        if wanted {
            var c = s.clone()
            if o.frames > 0 {
                c.frames = o.frames
            }
            out.push(take c)
        }
    }
    out
}

fn text_of(path: str) -> Result<String, ToolError> {
    let bytes = read_file(path, path)?
    match String::from_utf8(take bytes) {
        Some(t) => Ok(t),
        None => Err(ToolError::new(f"{path} isn't UTF-8")),
    }
}

fn json_of(path: str) -> Result<std::json::Doc, ToolError> {
    doc(text_of(path)?.as_str(), path).map_err(|e| ToolError::new(e.as_str()))
}

/// The adapter a page ran on (`device.json`), for the report's machine.
fn machine_of(dir: str) -> Result<String, ToolError> {
    let d = json_of(f"{dir}/results/device.json")?
    var out = String::new()
    for key in ["vendor", "architecture", "description"] {
        if let Some(k) = d.get(TOP, key) {
            if let Some(t) = d.text(k) {
                if t.len() > 0 {
                    if out.len() > 0 {
                        out.push_str(" ")
                    }
                    out.push_str(t.as_str())
                }
            }
        }
    }
    Ok(out)
}

/// `text`'s parts between `sep`s, joined by dashes.
fn dashed(text: str, sep: str) -> String {
    var out = String::new()
    for (a, b) in text.split(sep) {
        if out.len() > 0 {
            out.push_str("-")
        }
        out.push_str(text.slice(a, b))
    }
    out
}

/// Where package `pkg` (the workspace's) is built for the bench, in the write root `out`.
fn build_dir(out: str, pkg: str) -> String {
    String::from(f"{out}/builds/{dashed(pkg, "/")}")
}

/// A test-mode page's hash: `frames` frames at `w` × `h` on `workers` workers, its input
/// `input`, the command checker off.
fn page_hash(frames: u32, w: u32, h: u32, workers: u32, input: str) -> String {
    String::from(
        f"#test&frames={frames}&width={w}&height={h}&fps=60&workers={workers}&input={input}&checks=0",
    )
}

/// Scene `s` measured, its package (in the root `ws`) built first into the write root `out`
/// unless an earlier scene's was (`build`), each run's results kept in `kept`; the page's date
/// (ms since the epoch) and the machine.
pub fn measure(
    s: Scene,
    o: Options,
    salt: u32,
    build: bool,
    ws: str,
    out: str,
    kept: str,
) -> Result<(Measured, f64, String), ToolError> {
    let dir = build_dir(out, s.pkg)
    // Each run's results, kept before the next run empties them.
    var runs: Vec<String> = Vec::new()
    for r in ["gpu", "play", "cold", "warm"] {
        runs.push(String::from(f"{kept}/{s.name}/{r}"))
    }
    if build {
        var options = toolchain::options()
        options.optimize = true
        options.timeout = 600.0
        let built = toolchain::build(f"{ws}/{s.pkg}", dir.as_str(), options).wait()?
        if !built.ok {
            for d in built.diagnostics {
                if d.error {
                    print(d.rendered.as_str())
                }
            }
            return Err(ToolError::new(f"{s.pkg} didn't build"))
        }
    }
    let input = script(s.name)
    let input_file = String::from(f"input-{s.name}.json")
    let _ = files::write(
        f"{dir}/{input_file}",
        String::from(input.as_json()).as_bytes(),
    ).wait()?
    let frames = o.warmup + s.frames
    let (w, h) = (s.width, s.height)
    let timeout = f64(frames) / 60.0 * 10.0 + 240.0
    let common = page_hash(frames, w, h, o.workers, input_file.as_str())
    // 1. The GPU.
    run_page(dir.as_str(), f"{common}&timestamps=1&saturate=1&nohash=1", w, h, timeout)?
    keep_results(dir.as_str(), runs[0].as_str())?
    let span = stats(spans(json_of(f"{dir}/results/timings.json")?, o.warmup))
    let machine = machine_of(dir.as_str())?
    // 2. Play, each frame's labels timed (what a hitch held).
    run_page(dir.as_str(), f"{common}&paced=1&inflight=2&nohash=1&timestamps=1", w, h, timeout)?
    keep_results(dir.as_str(), runs[1].as_str())?
    let framed = json_of(f"{dir}/results/frames.json")?
    let held = hitches(framed, json_of(f"{dir}/results/counters.json")?, o.warmup)
    let began = match framed.get(TOP, "began_ms") {
        Some(n) => numbers(framed, n, 0),
        None => Vec::new(),
    }
    let between = intervals(began, o.warmup)
    var over_16 = 0
    var over_33 = 0
    for x in between {
        if x > 16.7 {
            over_16 += 1
        }
        if x > 33.3 {
            over_33 += 1
        }
    }
    let cpu = match framed.get(TOP, "cpu_ms") {
        Some(n) => stats(numbers(framed, n, o.warmup)),
        None => stats(Vec::new()),
    }
    let memory = json_of(f"{dir}/results/memory.json")?
    let (gpu_bytes, gpu_peak) = match memory.get(TOP, "gpu") {
        Some(g) => (number_at(memory, g, "bytes"), number_at(memory, g, "peak")),
        None => (0.0, 0.0),
    }
    // 3. A cold start.
    let cold_frames = min(frames, 300)
    let cold_hash = page_hash(cold_frames, w, h, o.workers, input_file.as_str())
    run_page(dir.as_str(), f"{cold_hash}&nohash=1&salt={salt}", w, h, timeout)?
    keep_results(dir.as_str(), runs[2].as_str())?
    let (opened, first_frame_ms, loaded_bytes, playable_ms) = started(dir.as_str())?
    let pipelines = json_of(f"{dir}/results/pipelines.json")?
    let pipelines_ms = number_at(pipelines, TOP, "ms")
    let compiles = slowest_compiles(dir.as_str(), pipelines)?
    // 4. A warm start: opened again in the same profile, no salt, so its caches serve it.
    run_page(dir.as_str(), f"{cold_hash}&nohash=1", w, h, timeout, again: true)?
    keep_results(dir.as_str(), runs[3].as_str())?
    let (_, _, warm_loaded_bytes, warm_playable_ms) = started(dir.as_str())?
    // Where the page timed its pipelines (a salted run alone does, today).
    let warm_pipelines_ms = match files::read(f"{dir}/results/pipelines.json").wait() {
        Ok(_) => number_at(json_of(f"{dir}/results/pipelines.json")?, TOP, "ms"),
        Err(_) => 0.0,
    }
    // 5. Natively.
    var native = stats(Vec::new())
    if o.native {
        let native_timeout = min(timeout, 600.0)
        var load_native = drive::gpu()
        load_native.width = w
        load_native.height = h
        load_native.workers = o.workers
        load_native.timeout = native_timeout
        let b = drive::load(dir.as_str(), load_native).wait()?.build
        let _ = untrapped(
            "init",
            drive::steps(b, [Step::Init], timeout: native_timeout).wait()?,
        )?
        let seen = untrapped(
            "the frames",
            drive::steps(b, [Step::Frames(frames, input.clone())], timeout: native_timeout).wait()?,
        )?
        let _ = drive::close(b).wait()
        var calls = Vec::new()
        if seen.ran.len() > 0 {
            let spans = seen.ran[0].spans.len()
            for k in o.warmup..spans {
                let span = seen.ran[0].spans[k]
                calls.push((span.end - span.start) * 1000.0)
            }
        }
        native = stats(take calls)
    }
    let m = Measured {
        scene: String::from(s.name),
        span,
        interval: stats(take between),
        over_16,
        over_33,
        cpu,
        native,
        first_frame_ms,
        playable_ms,
        pipelines_ms,
        loaded_bytes,
        gpu_bytes,
        gpu_peak,
        warm_playable_ms,
        warm_pipelines_ms,
        warm_loaded_bytes,
        hitches: held,
        compiles,
        runs,
    }
    Ok((m, opened, machine))
}

/// A start's numbers, from the page in `dir`'s `load.json`, `frames.json` and `log.txt`: when the
/// page opened (ms since the epoch), ms from then to its first frame, the bytes it loaded, and
/// ms to the program's first line that says `playable` (0 if none did).
fn started(dir: str) -> Result<(f64, f64, f64, f64), ToolError> {
    let load = json_of(f"{dir}/results/load.json")?
    let opened = number_at(load, TOP, "opened_ms")
    let first_frame_ms = number_at(load, TOP, "first_frame_ms") - opened
    var loaded_bytes = 0.0
    if let Some(r) = load.get(TOP, "resources") {
        for i in 0..load.count(r) {
            if let Some(e) = load.at(r, i) {
                loaded_bytes += number_at(load, e, "bytes")
            }
        }
    }
    let framed = json_of(f"{dir}/results/frames.json")?
    let log = text_of(f"{dir}/results/log.txt")?
    var playable_ms = 0.0
    if let (Some(pi), Some(bi)) = (framed.get(TOP, "printed_in"), framed.get(TOP, "began_ms")) {
        let printed_in = numbers(framed, pi, 0)
        let began = numbers(framed, bi, 0)
        var line = 0
        for (a, b) in log.lines() {
            let l = log.as_str().slice(a, b)
            if playable_ms == 0.0 && l.find("playable").is_some() && line < printed_in.len() {
                let f = u32(printed_in[line])
                if f < began.len() {
                    playable_ms = began[f] - opened
                }
            }
            line += 1
        }
    }
    Ok((opened, first_frame_ms, loaded_bytes, playable_ms))
}

/// The ten slowest pipelines to compile, from a cold run's `pipelines.json` (`each`, each one
/// built again alone): their names, ms and WGSL bytes (from the build in `dir`).
fn slowest_compiles(
    dir: str,
    pipelines: std::json::Doc,
) -> Result<Vec<(String, f64, f64)>, ToolError> {
    var each: Vec<(String, f64)> = Vec::new()
    if let Some(e) = pipelines.get(TOP, "each") {
        for i in 0..pipelines.count(e) {
            let Some(p) = pipelines.at(e, i) else { continue }
            let name = match pipelines.get(p, "name") {
                Some(n) => pipelines.text(n).unwrap_or(String::new()),
                None => String::new(),
            }
            each.push((take name, number_at(pipelines, p, "ms")))
        }
    }
    each.sort_by(slower)
    let manifest = json_of(f"{dir}/manifest.json")?
    var out = Vec::new()
    for k in 0..min(each.len(), 10) {
        var bytes = 0.0
        if let Some(list) = manifest.get(TOP, "pipelines") {
            for i in 0..manifest.count(list) {
                let Some(p) = manifest.at(list, i) else { continue }
                let (Some(n), Some(sh)) = (
                    manifest.get(p, "name"),
                    manifest.get(p, "shader"),
                ) else { continue }
                if manifest.text(n).unwrap_or(String::new()).as_str() == each[k].0.as_str() {
                    let shader = manifest.text(sh).unwrap_or(String::new())
                    bytes = match files::stat(f"{dir}/{shader}").wait() {
                        Ok(e) => f64(e.size),
                        Err(_) => 0.0,
                    }
                }
            }
        }
        out.push((each[k].0.clone(), each[k].1, bytes))
    }
    Ok(out)
}

fn slower(a: (String, f64), b: (String, f64)) -> bool {
    a.1 > b.1
}

/// The heading and introduction `docs/bench.md` starts with, when the bench writes it first.
const BENCH_HEAD: Text = "# Benchmarks\n\nWhat the engine's scenes cost, measured by `wrela tool bench` (studio/bench): each scene's GPU span (saturated, timestamped), the intervals between paced frames as a player sees them, each frame's CPU time, a cold start's time to first frame and to playable, and the GPU memory at its most, in headless Chrome stable, and each frame call natively. Each run adds a table under its date and machine; compare a change with the run before it on the same machine (`--compare out/<report>.json`: a report in build/bench, the tool's `out` root).\n\n## Other engines on this machine\n\nMeasured by hand in a sibling repository (this one holds only Wrela), with the command and date beside each number. None yet.\n\n"

fn bench(o: Options) -> Result<(), ToolError> {
    let _ = files::make_dirs("out/builds").wait()?
    // The earlier report, read before this run writes its own.
    let earlier = if o.compare.len() > 0 { Some(json_of(o.compare.as_str())?) } else { None }
    var all: Vec<Measured> = Vec::new()
    var date = String::new()
    var opened_at = 0.0
    var machine = String::new()
    var salt = 1
    // Where the runs' results are kept: `out/<date>-<time>/<scene>/<run>/`, the bench's start.
    let now = time::utc_now().wait()?
    let at = f64(now.seconds) * 1000.0
    let kept = String::from(f"out/{date_of(at)}-{time_of(at)}")
    // The packages built so far: each once, for all the scenes that share it.
    var built: Vec<String> = Vec::new()
    for s in chosen(o.clone()) {
        print(f"bench: {s.name} ({s.pkg}, {s.frames} frames at {s.width}x{s.height})")
        var build = true
        for b in built {
            if b.as_str() == s.pkg {
                build = false
            }
        }
        if build {
            built.push(String::from(s.pkg))
        }
        let (m, opened, mach) = measure(s, o.clone(), salt, build, "ws", "out", kept.as_str())?
        salt += 1
        date = date_of(opened)
        opened_at = opened
        machine = take mach
        all.push(take m)
    }
    let table = markdown(machine.as_str(), date.as_str(), all)
    print(table.as_str())
    let slug = dashed(machine.as_str(), " ")
    // A run of its own: the machine, the date and the time of day (UTC) its last page opened.
    let path = String::from(f"out/{slug}-{date}-{time_of(opened_at)}.json")
    write_file(
        path.as_str(),
        chunked(Vec::from(report_json(machine.as_str(), date.as_str(), all).as_bytes())),
    )?
    print(f"bench: the report is {path}")
    if let Some(e) = earlier {
        print(compared(e, all).as_str())
    }
    if o.docs {
        let existing = match files::read("ws/docs/bench.md").wait() {
            Ok(b) => String::from_utf8(take b).unwrap_or(String::new()),
            Err(_) => String::from(BENCH_HEAD),
        }
        var text = take existing
        text.push_str(table.as_str())
        write_file("ws/docs/bench.md", chunked(Vec::from(text.as_bytes())))?
        print("bench: the table is added to docs/bench.md")
    }
    Ok(())
}

pub fn tool() -> u32 {
    let Some(o) = parse_args(args()) else {
        print(USAGE)
        return 2
    }
    match bench(o) {
        Ok(()) => 0,
        Err(e) => {
            print(f"bench: {e.message()}")
            1
        },
    }
}
