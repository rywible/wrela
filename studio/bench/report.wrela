// What the bench measured of a scene, read from a test-mode page's results (runtime/browser's
// testmode.ts) and the native host's frames, and the report it writes: JSON for a later
// `--compare`, and a Markdown table for docs/bench.md.

use std::json
use std::json::{Doc, TOP}

/// A sample's statistics, in ms: its median and its 95th and 99th percentiles, by nearest rank.
pub struct Stats: Copy {
    pub p50: f64,
    pub p95: f64,
    pub p99: f64,
}

fn before(a: f64, b: f64) -> bool {
    a < b
}

/// `xs`'s statistics; all zero for none.
pub fn stats(xs: take Vec<f64>) -> Stats {
    var v = take xs
    if v.len() == 0 {
        return Stats { p50: 0.0, p95: 0.0, p99: 0.0 }
    }
    v.sort_by(before)
    let at = |p: u32| -> f64 {
        let rank = (v.len() * p + 99) / 100
        v[max(rank, 1) - 1]
    }
    Stats { p50: at(50), p95: at(95), p99: at(99) }
}

/// One scene's measurements.
pub struct Measured: Clone {
    pub scene: String,
    /// The GPU's frame span (saturated, timestamped).
    pub span: Stats,
    /// The interval between paced frames, as a player sees them, and how many were over 16.7
    /// and over 33.3 ms.
    pub interval: Stats,
    pub over_16: u32,
    pub over_33: u32,
    /// A paced frame's CPU time (its call, its commands encoded).
    pub cpu: Stats,
    /// The native host's frame call (its GPU waits included).
    pub native: Stats,
    /// A cold start (no pipeline cache): ms from the page opening to the first frame, and to the
    /// program's `playable` print (0 if it printed none), the pipelines' ms, and the bytes loaded.
    pub first_frame_ms: f64,
    pub playable_ms: f64,
    pub pipelines_ms: f64,
    pub loaded_bytes: f64,
    /// The program's GPU memory at the end and at its most (`memory.json`), bytes.
    pub gpu_bytes: f64,
    pub gpu_peak: f64,
    /// A warm start: the same build opened again by the same browser profile, its caches warm
    /// (no `salt`): ms to `playable`, the pipelines' ms (0 where the page didn't time them), and
    /// the bytes loaded over the wire.
    pub warm_playable_ms: f64,
    pub warm_pipelines_ms: f64,
    pub warm_loaded_bytes: f64,
    /// The paced run's frames over 33 ms, each with what it held.
    pub hitches: Vec<Hitch>,
    /// The ten slowest pipelines to compile in the cold run (`pipelines.json`'s `each`): each
    /// one's name, its ms and its WGSL's bytes.
    pub compiles: Vec<(String, f64, f64)>,
    /// Where each run's results are kept: `gpu`, `play`, `cold`, `warm`, in that order.
    pub runs: Vec<String>,
    /// The program's GPU memory at `playable`, as it printed it (`memory shares:`): what's held,
    /// then each share, bytes.
    pub shares: Vec<(String, f64)> = Vec::new(),
    /// The sustained run (`--sustained`), where there was one: how long the walk was paced before
    /// the measured frames (s), and the GPU's median span over the first minute of that and over
    /// its last (ms: their ratio over `THROTTLING` says the machine throttled).
    pub sustained_s: u32 = 0,
    pub minute_1_ms: f64 = 0.0,
    pub minute_last_ms: f64 = 0.0,
    /// The measured play run's throughput (`throughput`): its frame starts a second, and its
    /// intervals over 25 ms.
    pub starts_per_s: f64 = 0.0,
    pub over_25: u32 = 0,
}

/// The ratio of the last minute's GPU median to the first's past which a sustained run says the
/// machine throttled.
pub const THROTTLING: f64 = 1.15

/// A sustained run's last minute's GPU median over its first's (0 with no first minute).
pub fn ratio(minute_1_ms: f64, minute_last_ms: f64) -> f64 {
    if minute_1_ms > 0.0 { minute_last_ms / minute_1_ms } else { 0.0 }
}

/// Whether a sustained run's minutes say the machine throttled.
pub fn throttled(minute_1_ms: f64, minute_last_ms: f64) -> bool {
    ratio(minute_1_ms, minute_last_ms) > THROTTLING
}

/// A paced run's throughput, from its frames' starts (`began_ms`, the warm-up's left out): how
/// many starts, the time they took (the last less the first, and one mean interval more, so a
/// run of n starts spans n intervals), the starts a second, and the intervals over 25 ms. With one
/// frame in flight a frame starts only once the one two before is done on the GPU, so a cadence
/// of starts is a lower bound on the GPU's throughput (presentation itself isn't seen from a
/// page: these are frame starts, not frames presented).
pub struct Throughput: Copy {
    pub frame_starts: u32,
    pub elapsed_ms: f64,
    pub starts_per_s: f64,
    pub over_25: u32,
}

pub fn throughput(began: [f64], warmup: u32) -> Throughput {
    let n = if began.len() > warmup { began.len() - warmup } else { 0 }
    if n < 2 {
        return Throughput { frame_starts: n, elapsed_ms: 0.0, starts_per_s: 0.0, over_25: 0 }
    }
    let first = began[warmup]
    let last = began[began.len() - 1]
    let mean = (last - first) / f64(n - 1)
    let elapsed = last - first + mean
    var over_25 = 0
    for x in intervals(Vec::from(began), warmup) {
        if x > 25.0 {
            over_25 += 1
        }
    }
    Throughput {
        frame_starts: n,
        elapsed_ms: elapsed,
        starts_per_s: f64(n) * 1000.0 / elapsed,
        over_25,
    }
}

/// The sustained frame's gates (docs/plan-world-class-3.md §C6, G-sustained), on a paced run's
/// intervals: its starts keep 60 a second (at least `STARTS_FLOOR`), its p99 is under
/// `P99_CEILING`, and no interval is over 33 ms.
pub struct Gates: Copy {
    pub throughput: bool,
    pub p99: bool,
    pub over_33: bool,
}

pub const STARTS_FLOOR: f64 = 59.0
pub const P99_CEILING: f64 = 20.0

/// The gates of a run whose frames started at `began` (the warm-up's `warmup` left out).
pub fn gates(began: [f64], warmup: u32) -> Gates {
    let t = throughput(began, warmup)
    let between = intervals(Vec::from(began), warmup)
    var over_33 = 0
    for x in between {
        if x > 33.3 {
            over_33 += 1
        }
    }
    Gates {
        throughput: t.starts_per_s >= STARTS_FLOOR,
        p99: stats(take between).p99 < P99_CEILING,
        over_33: over_33 == 0,
    }
}

/// A sustained run's record (`sustained.json`): how long it paced the walk, how many pages that
/// took, the two minutes' GPU medians, their ratio and whether that's throttling.
pub fn sustained_json(seconds: u32, pages: u32, minute_1_ms: f64, minute_last_ms: f64) -> String {
    let ratio = ratio(minute_1_ms, minute_last_ms)
    String::from(
        f"{{\"seconds\": {seconds}, \"pages\": {pages}, \"minute_1_ms\": {minute_1_ms}, \"minute_last_ms\": {minute_last_ms}, \"ratio\": {ratio}, \"throttling\": {throttled(minute_1_ms, minute_last_ms)}}}\n",
    )
}

/// A play run's throughput record (`throughput.json`): frame starts, not presented frames.
pub fn throughput_json(t: Throughput) -> String {
    String::from(
        f"{{\"frame_starts\": {t.frame_starts}, \"elapsed_ms\": {t.elapsed_ms}, \"starts_per_s\": {t.starts_per_s}, \"over_25\": {t.over_25}}}\n",
    )
}

/// A `memory shares: held <bytes>, <name> <bytes>, ...` line's shares (a name may hold spaces:
/// its bytes are the last word), or none if `line` isn't one.
pub fn shares_of(line: str) -> Vec<(String, f64)> {
    var out: Vec<(String, f64)> = Vec::new()
    let Some(at) = line.find("memory shares: ") else { return out }
    let rest = line.slice(at + 15, line.len())
    for (a, b) in rest.split(", ") {
        let part = rest.slice(a, b)
        // The last space: the name before it, the bytes after.
        var space: Option<u32> = None
        var from = 0
        while let Some(i) = part.slice(from, part.len()).find(" ") {
            space = Some(from + i)
            from += i + 1
        }
        let Some(at) = space else { continue }
        let Some(bytes) = part.slice(at + 1, part.len()).parse_f64() else { continue }
        out.push((String::from(part.slice(0, at)), bytes))
    }
    out
}

/// A frame of a paced run over 33 ms (docs/plan-world-class-2.md §B1.2): which, its interval
/// and its CPU time, its phases and its labels' GPU ms (the heaviest first), its draws and the
/// bytes it wrote to buffers.
pub struct Hitch: Clone {
    pub frame: u32,
    pub interval_ms: f64,
    pub cpu_ms: f64,
    pub phases: Vec<(String, f64)>,
    pub labels: Vec<(String, f64)>,
    pub draws: u32,
    pub written: f64,
}

impl Hitch {
    /// No label over 2 ms and a CPU time under 2 ms: a stall of the browser's, not the program's.
    pub fn unattributed(self) -> bool {
        var named = false
        for l in self.labels {
            named = named || l.1 > 2.0
        }
        !named && self.cpu_ms < 2.0
    }
}

fn heavier(a: (String, f64), b: (String, f64)) -> bool {
    a.1 > b.1
}

/// A list of `[name, ms]`s, or an object of `name: ms`, as `(name, ms)`s, the heaviest first.
fn weighed(d: Doc, n: u32) -> Vec<(String, f64)> {
    var out: Vec<(String, f64)> = Vec::new()
    if d.count(n) > 0 {
        for i in 0..d.count(n) {
            let Some(e) = d.at(n, i) else { continue }
            let (Some(k), Some(v)) = (d.at(e, 0), d.at(e, 1)) else { continue }
            out.push((d.text(k).unwrap_or(String::new()), d.num(v).unwrap_or(0.0)))
        }
    } else {
        for m in d.members(n) {
            out.push((m.0.clone(), d.num(m.1).unwrap_or(0.0)))
        }
    }
    out.sort_by(heavier)
    out
}

/// The paced run's frames over 33 ms, from its `frames.json` and `counters.json`, the frames
/// from `warmup` on. A frame's interval is from when it began to when the next did: the host
/// notes a frame's start before it runs, so the work that made a gap long is the frame before
/// the gap's end.
pub fn hitches(frames: Doc, counters: Doc, warmup: u32) -> Vec<Hitch> {
    var out = Vec::new()
    let began = match frames.get(TOP, "began_ms") {
        Some(n) => numbers(frames, n, 0),
        None => return out,
    }
    let cpu = match frames.get(TOP, "cpu_ms") {
        Some(n) => numbers(frames, n, 0),
        None => Vec::new(),
    }
    for next in (warmup + 1)..began.len() {
        let i = next - 1
        let interval = began[next] - began[i]
        if interval <= 33.3 {
            continue
        }
        let at = |key: str| -> Vec<(String, f64)> {
            let Some(all) = frames.get(TOP, key) else { return Vec::new() }
            match frames.at(all, i) {
                Some(n) => weighed(frames, n),
                None => Vec::new(),
            }
        }
        let c = counters.at(TOP, i)
        let count = |key: str| -> f64 {
            match c {
                Some(n) => number_at(counters, n, key),
                None => 0.0,
            }
        }
        out.push(Hitch {
            frame: i,
            interval_ms: interval,
            cpu_ms: if i < cpu.len() { cpu[i] } else { 0.0 },
            phases: at("phases"),
            labels: at("labels"),
            draws: u32(count("draws")),
            written: count("write_buffer_bytes"),
        })
    }
    out
}

/// The numbers of list `n` of `d`, from index `from`.
pub fn numbers(d: Doc, n: u32, from: u32) -> Vec<f64> {
    var out = Vec::new()
    for i in from..d.count(n) {
        if let Some(k) = d.at(n, i) {
            if let Some(x) = d.num(k) {
                out.push(x)
            }
        }
    }
    out
}

/// The number at `key` of object `n` of `d`, or 0.
pub fn number_at(d: Doc, n: u32, key: str) -> f64 {
    match d.get(n, key) {
        Some(k) => d.num(k).unwrap_or(0.0),
        None => 0.0,
    }
}

/// Each frame's GPU span (its first timed start to its last end, ms) in `timings.json`, for
/// the frames from `warmup` on.
pub fn spans(timings: Doc, warmup: u32) -> Vec<f64> {
    // A start may be negative: the times are from the first timestamp the host read. Each
    // frame's first start and last end, if it was timed.
    var frames: Vec<Option<(f64, f64)>> = Vec::new()
    for i in 0..timings.count(TOP) {
        let Some(t) = timings.at(TOP, i) else { continue }
        let frame = number_at(timings, t, "frame")
        if frame < f64(warmup) {
            continue
        }
        let k = u32(frame) - warmup
        while frames.len() <= k {
            frames.push(None)
        }
        let (start, end) = (number_at(timings, t, "start"), number_at(timings, t, "end"))
        frames[k] = Some(match frames[k] {
            Some((first, last)) => {
                (if start < first { start } else { first }, if end > last { end } else { last })
            },
            None => (start, end),
        })
    }
    var out = Vec::new()
    for f in frames {
        if let Some((first, last)) = f {
            out.push((last - first) / 1000000.0)
        }
    }
    out
}

/// The intervals between paced frames' beginnings, each ending at a frame after `warmup` (as
/// `hitches` and `throughput` count them: each between two counted frames).
pub fn intervals(began: Vec<f64>, warmup: u32) -> Vec<f64> {
    var out = Vec::new()
    for k in (warmup + 1)..began.len() {
        out.push(began[k] - began[k - 1])
    }
    out
}

fn stats_json(s: Stats) -> String {
    String::from(f"{{\"p50\": {s.p50}, \"p95\": {s.p95}, \"p99\": {s.p99}}}")
}

/// `m` as JSON.
pub fn measured_json(m: Measured) -> String {
    var s = String::from(
        f"{{\"scene\": \"{m.scene}\", \"span\": {stats_json(m.span)}, \"interval\": {stats_json(m.interval)}, \"over_16\": {m.over_16}, \"over_33\": {m.over_33}, \"cpu\": {stats_json(m.cpu)}, \"native\": {stats_json(m.native)}, \"first_frame_ms\": {m.first_frame_ms}, \"playable_ms\": {m.playable_ms}, \"pipelines_ms\": {m.pipelines_ms}, \"loaded_bytes\": {m.loaded_bytes}, \"gpu_bytes\": {m.gpu_bytes}, \"gpu_peak\": {m.gpu_peak}, \"warm_playable_ms\": {m.warm_playable_ms}, \"warm_pipelines_ms\": {m.warm_pipelines_ms}, \"warm_loaded_bytes\": {m.warm_loaded_bytes}, \"sustained_s\": {m.sustained_s}, \"minute_1_ms\": {m.minute_1_ms}, \"minute_last_ms\": {m.minute_last_ms}, \"starts_per_s\": {m.starts_per_s}, \"over_25\": {m.over_25}",
    )
    var unattributed = 0
    s.push_str(", \"hitches\": [")
    for k in 0..m.hitches.len() {
        borrow h = m.hitches[k]
        unattributed += u32(h.unattributed())
        s.push_str(if k > 0 { ", " } else { "" })
        s.push_str(
            f"{{\"frame\": {h.frame}, \"interval_ms\": {h.interval_ms}, \"cpu_ms\": {h.cpu_ms}, \"draws\": {h.draws}, \"written\": {h.written}, \"labels\": {pairs_json(h.labels)}, \"phases\": {pairs_json(h.phases)}}}",
        )
    }
    s.push_str(f"], \"unattributed\": {unattributed}, \"compiles\": [")
    for k in 0..m.compiles.len() {
        let (name, at, bytes) = m.compiles[k].clone()
        s.push_str(if k > 0 { ", " } else { "" })
        s.push_str(f"{{\"name\": \"{name}\", \"ms\": {at}, \"wgsl_bytes\": {bytes}}}")
    }
    s.push_str("], \"runs\": [")
    for k in 0..m.runs.len() {
        s.push_str(if k > 0 { ", " } else { "" })
        s.push_str(f"\"{m.runs[k]}\"")
    }
    s.push_str("]}")
    s
}

/// `[[name, ms], ...]`: the first five.
fn pairs_json(xs: [(String, f64)]) -> String {
    var s = String::from("[")
    for k in 0..min(xs.len(), 5) {
        s.push_str(if k > 0 { ", " } else { "" })
        s.push_str(f"[\"{xs[k].0}\", {xs[k].1:.3}]")
    }
    s.push_str("]")
    s
}

/// When a report's first frame and playable time say a frame showed (`shown`): its submission,
/// from toolchain 0.12.0. A report without it timed the frames' starts.
pub const SHOWN: Text = "submitted"

/// A whole report: the machine, the date, when a frame is taken to show (`SHOWN`), and each
/// scene's measurements.
pub fn report_json(machine: str, date: str, all: [Measured]) -> String {
    var s = String::from(
        f"{{\"machine\": \"{machine}\", \"date\": \"{date}\", \"shown\": \"{SHOWN}\", \"scenes\": [",
    )
    for k in 0..all.len() {
        if k > 0 {
            s.push_str(", ")
        }
        s.push_str(measured_json(all[k].clone()).as_str())
    }
    s.push_str("]}\n")
    s
}

fn ms(x: f64) -> String {
    String::from(f"{x:.2}")
}

fn mib(bytes: f64) -> String {
    String::from(f"{bytes / 1048576.0:.1}")
}

/// A row's sustained cell: `sustained 600 s`, its minutes' GPU medians and their ratio (and
/// "throttling" past `THROTTLING`), the measured run's starts a second and intervals over 25 ms;
/// or "no" where the run wasn't sustained.
fn sustained_cell(m: Measured) -> String {
    if m.sustained_s == 0 {
        return String::from("no")
    }
    let ratio = ratio(m.minute_1_ms, m.minute_last_ms)
    let throttling = if throttled(m.minute_1_ms, m.minute_last_ms) { ", throttling" } else { "" }
    String::from(
        f"sustained {m.sustained_s} s: minute 1 {ms(m.minute_1_ms)}, last {ms(m.minute_last_ms)} ({ratio:.2}{throttling}); {m.starts_per_s:.1} starts/s, {m.over_25} over 25 ms",
    )
}

/// The report as Markdown: a heading for the machine and the date, then a row a scene.
pub fn markdown(machine: str, date: str, all: [Measured]) -> String {
    var s = String::from(f"## {date}, {machine}\n\n")
    s.push_str(
        "| Scene | GPU span p50 / p95 / p99 ms | Interval p50 / p95 / p99 ms | Over 16.7 / 33 ms | CPU p50 / p95 ms | Native p50 / p95 ms | First frame ms | Playable ms | Pipelines ms | Loaded MiB | Warm playable ms | Warm loaded MiB | GPU peak MiB | Sustained |\n",
    )
    s.push_str("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|\n")
    for m in all {
        s.push_str(
            f"| {m.scene} | {ms(m.span.p50)} / {ms(m.span.p95)} / {ms(m.span.p99)} | {ms(m.interval.p50)} / {ms(m.interval.p95)} / {ms(m.interval.p99)} | {m.over_16} / {m.over_33} | {ms(m.cpu.p50)} / {ms(m.cpu.p95)} | {ms(m.native.p50)} / {ms(m.native.p95)} | {ms(m.first_frame_ms)} | {ms(m.playable_ms)} | {ms(m.pipelines_ms)} | {mib(m.loaded_bytes)} | {ms(m.warm_playable_ms)} | {mib(m.warm_loaded_bytes)} | {mib(m.gpu_peak)} | {sustained_cell(m)} |\n",
        )
    }
    s.push_str("\n")
    for m in all {
        if m.hitches.len() == 0 {
            s.push_str(f"Hitches, {m.scene}: none (no frame over 33 ms).\n\n")
        } else {
            var unattributed = 0
            s.push_str(
                f"Hitches, {m.scene} (frames over 33 ms, the five heaviest labels each):\n\n",
            )
            s.push_str(
                "| Frame | Interval ms | CPU ms | Labels, GPU ms | Phases, ms | Draws | Written KiB |\n|---|---|---|---|---|---|---|\n",
            )
            for h in m.hitches {
                let none = h.unattributed()
                unattributed += u32(none)
                s.push_str(
                    f"| {h.frame} | {ms(h.interval_ms)} | {ms(h.cpu_ms)} | {if none { "unattributed: " } else { "" }}{listed(h.labels)} | {listed(h.phases)} | {h.draws} | {h.written / 1024.0:.0} |\n",
                )
            }
            s.push_str(
                f"\n{unattributed} of {m.hitches.len()} unattributed (no label over 2 ms, CPU under 2 ms).\n\n",
            )
        }
        if m.shares.len() > 0 {
            s.push_str(
                f"Memory at playable, {m.scene} (cold, by the program's own counts):\n\n| Share | MiB |\n|---|---|\n",
            )
            for sh in m.shares {
                s.push_str(f"| {sh.0} | {sh.1 / 1048576.0:.1} |\n")
            }
            s.push_str("\n")
        }
        if m.compiles.len() > 0 {
            s.push_str(
                f"Slowest compiles, {m.scene} (cold):\n\n| Pipeline | ms | WGSL KiB |\n|---|---|---|\n",
            )
            for c in m.compiles {
                s.push_str(f"| {c.0} | {ms(c.1)} | {c.2 / 1024.0:.1} |\n")
            }
            s.push_str("\n")
        }
    }
    s
}

/// The first five `(name, ms)`s, as `name 1.23, ...`.
fn listed(xs: [(String, f64)]) -> String {
    var s = String::new()
    for k in 0..min(xs.len(), 5) {
        s.push_str(if k > 0 { ", " } else { "" })
        s.push_str(f"{xs[k].0} {ms(xs[k].1)}")
    }
    s
}

/// The change from `then` to `now` of scene `scene`'s main numbers, a line each, from an earlier
/// report's JSON `earlier`.
pub fn compared(earlier: Doc, now: [Measured]) -> String {
    var s = String::new()
    let Some(scenes) = earlier.get(TOP, "scenes") else {
        return String::from("the earlier report has no scenes\n")
    }
    // A first frame timed at its start isn't comparable with one timed at its submission.
    let same_shown = match earlier.get(TOP, "shown") {
        Some(k) => earlier.text(k).unwrap_or(String::new()).as_str() == SHOWN,
        None => false,
    }
    for m in now {
        var found = false
        for i in 0..earlier.count(scenes) {
            let Some(e) = earlier.at(scenes, i) else { continue }
            let Some(name) = earlier.get(e, "scene") else { continue }
            if earlier.text(name).unwrap_or(String::new()).as_str() != m.scene.as_str() {
                continue
            }
            found = true
            let at = |key: str, stat: str| -> f64 {
                match earlier.get(e, key) {
                    Some(k) => number_at(earlier, k, stat),
                    None => 0.0,
                }
            }
            let change = |then: f64, now: f64| -> String {
                if then > 0.0 {
                    let pc = (now - then) / then * 100.0
                    let sign = if pc >= 0.0 { "+" } else { "" }
                    String::from(f"{then:.2} -> {now:.2} ({sign}{pc:.1}%)")
                } else {
                    String::from(f"{now:.2}")
                }
            }
            let span = change(at("span", "p50"), m.span.p50)
            let interval = change(at("interval", "p95"), m.interval.p95)
            let cpu = change(at("cpu", "p50"), m.cpu.p50)
            let first = if same_shown {
                change(number_at(earlier, e, "first_frame_ms"), m.first_frame_ms)
            } else {
                String::from(f"{m.first_frame_ms:.2} (the earlier report timed frames' starts)")
            }
            let peak = change(number_at(earlier, e, "gpu_peak") / 1048576.0, m.gpu_peak / 1048576.0)
            s.push_str(
                f"{m.scene}: GPU span p50 {span}; interval p95 {interval}; CPU p50 {cpu}; first frame {first}; GPU peak MiB {peak}\n",
            )
        }
        if !found {
            s.push_str(f"{m.scene}: new\n")
        }
    }
    s
}

/// `d`'s JSON document, or why not.
pub fn doc(text: str, what: str) -> Result<Doc, String> {
    match json::parse(text) {
        Some(d) => Ok(d),
        None => Err(String::from(f"{what} isn't JSON")),
    }
}

/// The date of `ms` since the epoch, as `YYYY-MM-DD` (Hinnant's days-from-civil, inverted).
pub fn date_of(ms: f64) -> String {
    let days = i64(ms / 86400000.0)
    let z = days + 719468
    let era = (if z >= 0 { z } else { z - 146096 }) / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
    String::from(f"{y}-{m:02}-{d:02}")
}

/// The time of day of `ms` since the epoch, UTC, as `HHMMSS`.
pub fn time_of(ms: f64) -> String {
    let secs = i64(ms / 1000.0) % 86400
    let (h, m, sec) = (secs / 3600, (secs / 60) % 60, secs % 60)
    String::from(f"{h:02}{m:02}{sec:02}")
}
