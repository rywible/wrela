// The scenes the bench measures (docs/plan-world-class.md §B1): each a package, its input
// script, its frames and its size.

use std::input::Script

/// A scene: its name, its package (`pkg`) (from the workspace), the frames it measures after the
/// warmup, its size, the frame its walk begins (`WALKS`: its counted frames begin there) or 0 for
/// none, whether its program arrives (`engine::frame::Frame`'s cover, ended by `playable at
/// frame`: its frames before aren't counted, and a start is timed to it), whether its program
/// names a tier (`pub const TIER`, which `--tier` sets), and whether it names a look (`pub type
/// LOOK`, which `--look` sets: `engine::style`).
pub struct Scene: Clone {
    pub name: Text,
    pub pkg: Text,
    pub frames: u32,
    pub width: u32,
    pub height: u32,
    pub walks: u32 = 0,
    pub arrives: bool = false,
    pub tiered: bool = false,
    pub looked: bool = false,
}

/// Every scene, in the order the report lists them: the engine's bare frame (flat ground, open
/// sky, nobody: engine/tests/frame), the floor every lit program stands on; and the yard
/// (lookdev/ink-yard), Kinetic Ink's look-development scene, a duellist striking among standing
/// stones (`--set LOOK=styles::physical::Physical --set SWITCHES=Realistic` for its physical
/// build).
pub const SCENES: [Scene; 2] = [
    Scene {
        name: "frame-bare",
        pkg: "engine/tests/frame",
        frames: 600,
        width: 1920,
        height: 1080,
        arrives: true,
        looked: true,
    },
    Scene {
        name: "ink-yard",
        pkg: "lookdev/ink-yard",
        frames: 600,
        width: 1920,
        height: 1080,
        arrives: true,
        looked: true,
    },
]

/// The frame a walking scene's walk begins: after it's playable in a saturated run too, whose
/// frames race its helpers' jobs and fetches (the floor was playable at frames 232-239 at `Epic`;
/// begun before, the moving eye kept its near cascade from being whole, which its first probes
/// wait for, and the run stayed covered: docs/bench.md C6, C7).
pub const WALKS: u32 = 900

/// Scene `name`'s input: none (the bare frame scripts itself).
pub fn script(name: str) -> Script {
    let _ = name
    Script::frames()
}
