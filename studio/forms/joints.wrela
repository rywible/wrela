// How a form changes where its chain bends, solved. A charted form made again along its posed
// path already bends with its joints; what it lacks is what flesh does there: the outside of a
// bent elbow comes to a point, the cap of a shoulder thins as the arm comes down from a T-pose.
// The reference body's own skin weights say how its sculptor had those go, so each joint's
// change is solved against the reference posed (`posed`), over poses from captured motion: a
// radial form in the bend's own frame (written for a bend toward angle 0, turned to where the
// bend is), one times the bend's angle and one times its square. Linear in its numbers, so one
// solve finds every joint's at once.

use engine::chart
use engine::chart::{Bend, JOINTS, Radial, Sample}
use engine::humanoid::{Clip, palette}
use humanoid::body::HERO
use posed::{ARM_LEFT, Limb, bones_of, posed_rays}
use std::math::{PI, TAU}
use std::transform::translate

/// A joint's change's size: control values along the path by terms round it. Smaller than the
/// form it changes: a bend's change is smooth.
pub const ALONG: u32 = 10
pub const ROUND: u32 = 7

/// A joint's change as it's solved (`engine::chart::Change`).
pub type Solved = chart::Change<10, 7>

/// A pose of the reference, and what's read of it: the limb's joints' bends, and the
/// reference's radius less the rest form's at places on the posed chart.
pub struct Reading {
    pub bends: [Bend; JOINTS],
    pub samples: Vec<Sample>,
}

/// The poses the changes are solved over: frames of captured boxing, an idle, a run, a roll
/// and a keyed cross, a third of a second apart or so.
pub fn poses() -> Vec<[mat4; 64]> {
    let rig = HERO.rig.clone()
    var out: Vec<[mat4; 64]> = Vec::new()
    let clips = [
        (humanoid::accad_fists::BOXING.clone(), 0.37, 14),
        (humanoid::body::IDLE.clone(), 0.9, 2),
        (humanoid::body::RUN.clone(), 0.11, 4),
        (humanoid::body::ROLL_RAW.clone(), 0.23, 4),
        (humanoid::body::PUNCH_RAW.clone(), 0.13, 6),
    ]
    for c in clips {
        for k in 0..c.2 {
            out.push(palette(rig.clone(), c.0.pose(c.1 * f32(k + 1)), translate(vec3(0.0))))
        }
    }
    out
}

/// How far past its own stretch of the path a joint's change eases to nothing (of the path's
/// length).
pub const REACH_EASE: f32 = 0.08

/// Where a limb's readings start along its path: past its root's first few centimetres,
/// where the reference has too little of a side to read.
pub const FROM: f32 = 0.04

/// Limb `l` read in pose `m` against the reference at rest (`at_rest`: `posed::rest_rays` on
/// the same grid): how the reference's own radius changes with the pose, place by place.
pub fn reading(l: Limb, at_rest: [Sample], m: [mat4; 64], shift: vec2) -> Reading {
    var samples = posed::posed_changes(l, m, at_rest, vec2(FROM, 1.0), 44, 24, shift)
    // Its root, before `FROM`, is as at rest in every pose: no difference there, so a solve
    // doesn't carry a joint's change on into it.
    for i in 0..2 {
        for j in 0..24 {
            samples.push(Sample { f: FROM * f32(i) / 2.0, theta: TAU * f32(j) / 24.0, r: 0.0 })
        }
    }
    Reading { bends: posed::as_weighted(l.chain).bends(bones_of(l, m)), samples }
}

/// What a reading's sample asks of the changes: its difference; but inside a bend (within a
/// quarter turn of where it leans, near its joint) no growth, since flesh pressed there has
/// nowhere to go but into what it's pressed against.
fn asked<const N: u32>(s: Sample, bends: [Bend; JOINTS], joints: [u32; N]) -> f32 {
    var r = s.r
    for j in 0..N {
        let b = bends[joints[j]]
        if abs(s.f - b.at) < 0.15 && abs(chart::wrapped(s.theta - b.lean_at(s.f))) < 0.5 * PI {
            r = min(r, 0.0)
        }
    }
    r
}

/// The changes of the joints `joints` of a limb (their places in its chain), solved over
/// `readings`: each joint's two forms, nearest the readings' differences by least squares.
pub fn solved<const N: u32>(readings: [Reading], joints: [u32; N]) -> [Solved; N] {
    assert(N <= 8, "a limb's changes are solved for 8 joints at most")
    let shape: Radial<10, 7> = Radial { from: 0.0, to: 1.0, coef: [[0.0; 7]; 10] }
    let per = ALONG * ROUND
    let n = N * 2 * per
    var m: Vec<f64> = Vec::filled(n * n, value: 0.0)
    var g: Vec<f64> = Vec::filled(n, value: 0.0)
    var count = 0
    for r in readings {
        for s in r.samples {
            // What each number weighs in this sample: joint by joint, its form times the
            // bend's angle and its form times the angle's square, at the angle from the bend.
            var at = [0; 448]
            var w = [0.0; 448]
            var k = 0
            let (i, along) = shape.along_weights(s.f)
            for j in 0..N {
                let b = r.bends[joints[j]]
                if b.angle <= 0.0 {
                    continue
                }
                let round: [f64; 7] = chart::terms(s.theta - b.lean_at(s.f))
                for p in 0..2 {
                    let by = if p == 0 { f64(b.angle) } else { f64(b.angle * b.angle) }
                    for a in 0..4 {
                        for t in 0..ROUND {
                            at[k] = (j * 2 + p) * per + (i + a) * ROUND + t
                            w[k] = by * along[a] * round[t]
                            k += 1
                        }
                    }
                }
            }
            let want = f64(asked(s, r.bends, joints))
            // (The sums' upper half: the matrix is symmetric, and is filled out after.)
            for x in 0..k {
                g[at[x]] += w[x] * want
                let row = at[x] * n
                let wx = w[x]
                for y in x..k {
                    m[row + at[y]] += wx * w[y]
                }
            }
            count += 1
        }
    }
    for x in 0..n {
        for y in x + 1..n {
            let v = m[x * n + y] + m[y * n + x]
            m[x * n + y] = v
            m[y * n + x] = v
        }
    }
    // Each number near 0 where no pose asks otherwise, and near its neighbours along the path.
    let lam = 0.0001 * f64(max(count, 1))
    for k in 0..n {
        m[k * n + k] += 0.02 * lam
    }
    for form in 0..N * 2 {
        for i in 1..ALONG - 1 {
            for k in 0..ROUND {
                let rows = [
                    form * per + (i - 1) * ROUND + k,
                    form * per + i * ROUND + k,
                    form * per + (i + 1) * ROUND + k,
                ]
                let c = [1.0, -2.0, 1.0]
                for a in 0..3 {
                    for b in 0..3 {
                        m[rows[a] * n + rows[b]] += lam * c[a] * c[b]
                    }
                }
            }
        }
    }
    // Each joint's change keeps to its own stretch of the path: as far as halfway to the joint
    // either side of it (the first's, back to the root). Left free, the solve trades one
    // joint's change against the next's wherever the poses bend both together, and a pose that
    // bends one alone shows the trade: a straight arm hanging at its side had its forearm
    // thinned 14 mm by its shoulder's change.
    for j in 0..N {
        let at = readings[0].bends[joints[j]].at
        let from = if j == 0 { -1.0 } else { 0.5 * (readings[0].bends[joints[j - 1]].at + at) }
        let after = if j + 1 == N { 1.0 } else { readings[0].bends[joints[j + 1]].at }
        let to = 0.5 * (at + after)
        for i in 0..ALONG {
            let x = shape.place_of_control(i)
            let past = max(
                1.0 - smoothstep(from - REACH_EASE, from, x),
                smoothstep(to, to + REACH_EASE, x),
            )
            for p in 0..2 {
                for k in 0..ROUND {
                    let row = (j * 2 + p) * per + i * ROUND + k
                    m[row * n + row] += 1.0e6 * lam * f64(past)
                }
            }
        }
    }
    let x = chart::solve_symmetric(take m, g, n)
    var out = [chart::Change { by_angle: shape, by_square: shape }; N]
    for j in 0..N {
        // (It holds at the deepest bend among the poses it was solved over.)
        var deepest = 0.0
        for r in readings {
            deepest = max(deepest, r.bends[joints[j]].angle)
        }
        out[j].upto = engine::cycle::rounded_to(deepest, 2)
        for i in 0..ALONG {
            for k in 0..ROUND {
                out[j].by_angle.coef[i][k] = f32(x[(j * 2) * per + i * ROUND + k])
                out[j].by_square.coef[i][k] = f32(x[(j * 2 + 1) * per + i * ROUND + k])
            }
        }
        out[j].by_angle = chart::rounded(out[j].by_angle)
        out[j].by_square = chart::rounded(out[j].by_square)
    }
    out
}

/// What the changes add to a form's radius at a place, for a pose's bends.
pub fn added<const N: u32>(
    changes: [Solved; N],
    joints: [u32; N],
    bends: [Bend; JOINTS],
    f: f32,
    theta: f32,
) -> f32 {
    var sum = 0.0
    for j in 0..N {
        let b = bends[joints[j]]
        sum += b.angle * changes[j].by_angle.radius(f, theta - b.lean_at(f)) +
            b.angle * b.angle * changes[j].by_square.radius(f, theta - b.lean_at(f))
    }
    sum
}

/// How far a form with `changes` is from `readings` (mm, root mean square): over every sample,
/// and over those outside every bend (more than a quarter turn from where it leans), where a
/// drawn form shows; with no changes at all, the same two.
pub fn left_over<const N: u32>(
    changes: [Solved; N],
    joints: [u32; N],
    readings: [Reading],
) -> vec4 {
    var all = vec2()
    var outside = vec2()
    var n = 0.0
    var n_out = 0.0
    for r in readings {
        for s in r.samples {
            let e = (s.r - added(changes, joints, r.bends, s.f, s.theta)) * 1000.0
            let was = s.r * 1000.0
            all += vec2(e * e, was * was)
            n += 1.0
            var out = true
            for j in 0..N {
                let b = r.bends[joints[j]]
                if abs(s.f - b.at) < 0.15 &&
                    abs(chart::wrapped(s.theta - b.lean_at(s.f))) < 0.5 * PI {
                    out = false
                }
            }
            if out {
                outside += vec2(e * e, was * was)
                n_out += 1.0
            }
        }
    }
    vec4(
        sqrt(all.x / max(n, 1.0)),
        sqrt(outside.x / max(n_out, 1.0)),
        sqrt(all.y / max(n, 1.0)),
        sqrt(outside.y / max(n_out, 1.0)),
    )
}

/// A limb's two joints' changes (its joint against the trunk, then its hinge), solved over
/// every pose (`poses`): how the reference's own radius changes from rest, and how much of
/// that is left outside its bends with no change and with them (mm rms).
pub fn changes_of(limb: Limb) -> ([Solved; 2], vec2) {
    let at_rest = posed::rest_rays(limb, vec2(FROM, 1.0), 44, 24, vec2(0.0, 0.0))
    var readings: Vec<Reading> = Vec::new()
    for m in poses() {
        readings.push(reading(limb, at_rest, m, vec2(0.0, 0.0)))
    }
    let changes = solved(readings, [1, 2])
    let left = left_over(changes, [1, 2], readings)
    (changes, vec2(left.w, left.y))
}

/// The arm's shoulder's and elbow's changes (`changes_of`).
pub fn arm_changes() -> ([Solved; 2], vec2) {
    changes_of(ARM_LEFT)
}

@test
fn the_arms_joints_changes_solved() {
    // Solved over every other pose, measured on the rest, between the solve's own places.
    let all = poses()
    let at_rest = posed::rest_rays(ARM_LEFT, vec2(FROM, 1.0), 44, 24, vec2(0.0, 0.0))
    let at_rest_between = posed::rest_rays(ARM_LEFT, vec2(FROM, 1.0), 44, 24, vec2(0.5, 0.5))
    var fit: Vec<Reading> = Vec::new()
    var held: Vec<Reading> = Vec::new()
    for k in 0..all.len() {
        if k % 2 == 0 {
            fit.push(reading(ARM_LEFT, at_rest, all[k], vec2(0.0, 0.0)))
        } else {
            held.push(reading(ARM_LEFT, at_rest_between, all[k], vec2(0.5, 0.5)))
        }
    }
    let changes = solved(fit, [1, 2])
    let on_fit = left_over(changes, [1, 2], fit)
    let on_held = left_over(changes, [1, 2], held)
    std::io::print(
        f"{fit.len()} poses solved: the arm with no change is {on_fit.z:.1} mm rms from the posed reference ({on_fit.w:.1} outside the bends); with its joints' changes {on_fit.x:.1} ({on_fit.y:.1} outside)",
    )
    std::io::print(
        f"{held.len()} poses held out: {on_held.z:.1} mm rms with no change ({on_held.w:.1} outside the bends); with the changes {on_held.x:.1} ({on_held.y:.1} outside)",
    )
    // On poses the solve never saw, the changes take off some of what's left outside the bends.
    assert(
        on_held.y < on_held.w,
        f"held out: {on_held.y} mm rms with the changes, {on_held.w} without",
    )
}

@test
fn the_arm_as_its_drawn_against_the_posed_reference() {
    // The arm as a game draws it: the species' arm as a part (`figure::limbs::arm`), posed by
    // the rig's own bones (its collarbone, upper arm and forearm: bones 14 to 16). Against the
    // reference posed, read from that same path.
    var keep = [false; 6]
    keep[ARM_LEFT.part] = true
    var k = 0
    for m in poses() {
        k += 1
        if k % 5 != 0 {
            continue
        }
        let bones = bones_of(ARM_LEFT, m)
        let chain = ARM_LEFT.chain
        let bends = chain.bends(bones)
        let part = figure::limbs::arm(
            figure::arm::ARM,
            0,
            ARM_LEFT.bones,
            to: 1.0,
            under: vec2(0.0, 0.24),
        )
        let form = part.posed(m).form
        let tris = posed::posed_triangles(HERO.clone(), m, keep)
        let seen = targets::rays(
            tris,
            chain.posed(bones[0], bones),
            vec2(0.14, 1.0),
            40,
            24,
            vec2(0.0, 0.0),
            0.14,
        )
        var sum = vec2()
        var most = 0.0
        var least = 1.0
        for s in seen {
            let r = form.radius(s.f, s.theta)
            let e = (r - s.r) * 1000.0
            let was = (figure::arm::ARM.radius(s.f, s.theta) - s.r) * 1000.0
            sum += vec2(e * e, was * was)
            most = max(most, r)
            least = min(least, r)
        }
        let n = f32(max(seen.len(), 1))
        // (And over its whole chart, its root too, its side stays an arm's: never nearer its
        // path than the engine's least, never a flap.)
        let limb = part.posed(m)
        for i in 0..50 {
            for j in 0..24 {
                let f = f32(i) / 49.0
                let centre = limb.path.frame(f * limb.path.length()).at
                let r = length(limb.side(f, TAU * f32(j) / 24.0) - centre)
                assert(r > 0.0029 && r < 0.16, f"pose {k}'s arm is {r} m from its path")
            }
        }
        std::io::print(
            f"pose {k}: shoulder {bends[1].angle:.2} rad toward {bends[1].toward:.2} after {bends[1].after:.2} reached {bends[1].reached:.2}, elbow {bends[2].angle:.2} toward {bends[2].toward:.2} after {bends[2].after:.2}; drawn radius {least * 1000.0:.0} to {most * 1000.0:.0} mm; from the reference {sqrt(sum.x / n):.1} mm rms (unchanged {sqrt(sum.y / n):.1})",
        )
    }
}

/// What's left of the posed reference's change once the arm's joints' changes are solved, with
/// the arm's chain cutting a bent joint's corner by `cut`: solved on every other pose, measured
/// on the rest (mm rms).
fn left_cutting(cut: f32) -> f32 {
    let limb = Limb { chain: engine::chart::Chain { cut, ..ARM_LEFT.chain }, ..ARM_LEFT }
    let at_rest = posed::rest_rays(limb, vec2(FROM, 1.0), 44, 24, vec2(0.0, 0.0))
    let between = posed::rest_rays(limb, vec2(FROM, 1.0), 44, 24, vec2(0.5, 0.5))
    let all = poses()
    var fit: Vec<Reading> = Vec::new()
    var held: Vec<Reading> = Vec::new()
    for k in 0..all.len() {
        if k % 2 == 0 {
            fit.push(reading(limb, at_rest, all[k], vec2(0.0, 0.0)))
        } else {
            held.push(reading(limb, between, all[k], vec2(0.5, 0.5)))
        }
    }
    left_over(solved(fit, [1, 2]), [1, 2], held).x
}

@test
fn an_arm_whose_path_cuts_its_elbows_corner_is_nearer_the_posed_reference() {
    // Through the joint itself, 12.1 mm rms is left on poses the solve never saw; cutting the
    // corner all the way, 10.1. (A longer rounding, 8 or 10 cm, is worse than 5: 11.1, 11.5.)
    let through = left_cutting(0.0)
    let cutting = left_cutting(1.0)
    assert(cutting < through - 1.0, f"cutting leaves {cutting} mm rms, through the joint {through}")
}
