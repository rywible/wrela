// The written forms against their references: each file the tool writes is what the tool would
// write now, and is as near its reference as this says. A change to a reference, a chain or
// the fit without writing the forms again (`wrela tool forms`) fails here.

use engine::chart::Radial
use main::{Fitted, arm, hakuro_arm_left, hakuro_arm_right}

/// The most two forms' numbers differ (m).
fn apart<const A: u32, const R: u32>(a: Radial<A, R>, b: Radial<A, R>) -> f32 {
    var most = max(abs(a.from - b.from), abs(a.to - b.to))
    for i in 0..A {
        for j in 0..R {
            most = max(most, abs(a.coef[i][j] - b.coef[i][j]))
        }
    }
    most
}

@test
fn each_written_arm_is_its_reference_fitted() {
    // The species' arm: the reference body's, within 1.2 mm rms and 6 mm at worst.
    let species = arm()
    assert(apart(species.form, figure::arm::ARM) < 0.000011, "content/figure/arm.wrela is stale")
    let m = species.miss.spread
    assert(m.rms < 1.2 && m.most < 2.5 && m.worst < 6.0, f"the arm misses by {m.rms} mm rms")
    // Hakuro's arms, as the species' and what each is over it: his sampled grids', within
    // 1.3 mm rms.
    let left = hakuro_arm_left(species.form)
    assert(
        apart(left.form, hakuro::arm_left_form::ARM_LEFT_OVER) < 0.000011,
        "content/hakuro/arm_left_form.wrela is stale",
    )
    let l = left.miss.spread
    assert(l.rms < 1.3 && l.most < 2.6 && l.worst < 6.0, f"his left arm misses by {l.rms} mm rms")
    let right = hakuro_arm_right(species.form)
    assert(
        apart(right.form, hakuro::arm_right_form::ARM_RIGHT_OVER) < 0.000011,
        "content/hakuro/arm_right_form.wrela is stale",
    )
    let r = right.miss.spread
    assert(r.rms < 1.3 && r.most < 2.6 && r.worst < 6.0, f"his right arm misses by {r.rms} mm rms")
}

@test
fn the_arms_written_joints_are_the_reference_solved() {
    let (changes, left) = joints::arm_changes()
    let written = [
        figure::arm_joints::SHOULDER_BY_ANGLE,
        figure::arm_joints::SHOULDER_BY_SQUARE,
        figure::arm_joints::ELBOW_BY_ANGLE,
        figure::arm_joints::ELBOW_BY_SQUARE,
    ]
    let now = [changes[0].by_angle, changes[0].by_square, changes[1].by_angle, changes[1].by_square]
    for k in 0..4 {
        assert(apart(now[k], written[k]) < 0.000011, "content/figure/arm_joints.wrela is stale")
    }
    // Outside its bends, the changes take off some of what the posed reference differs by.
    assert(left.y < left.x, f"the joints' changes leave {left.y} mm rms of {left.x}")
}
