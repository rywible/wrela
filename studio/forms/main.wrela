}

/// Hakuro's neck, fitted.
pub fn hakuro_neck() -> Fitted<16, 13> {
    fitted(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_NECK)
}

/// What's said of a fitted form: its misses' spread, and their size by place.
fn said<const A: u32, const R: u32>(s: Spec, f: Fitted<A, R>) -> String {
    let m = f.miss.spread
    var out = String::new()
    out.push_str(
        if f.rays > 0 {
            f"{s.name}: {s.file}, {f.form.numbers()} numbers from {f.rays} rays; {m.count} more between them miss by {m.rms:.2} mm rms, half under {m.half:.2}, 95% under {m.most:.2}, worst {m.worst:.1}\n"
        } else {
            f"{s.name}: {s.file}, {f.form.numbers()} numbers kept where they were; {m.count} radii of its reference as it was miss by {m.rms:.2} mm rms, half under {m.half:.2}, 95% under {m.most:.2}, worst {m.worst:.1}\n"
        },
    )
    out.push_str(
        "  by place (mm rms): a row a station from the span's start to its end, a column a sector round from angle 0\n",
    )
    for i in 0..STATIONS {
        out.push_str("   ")
        for j in 0..SECTORS {
            out.push_str(f" {f.miss.by_place[i][j]:.2}")
        }
        out.push_str("\n")
    }
    out
}

/// The source of form `s`'s file.
pub fn file_of<const A: u32, const R: u32>(s: Spec, form: Radial<A, R>) -> String {
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. A charted form's radius (engine::chart): a row\n",
    )
    out.push_str(
        "// a control value along its path, each a Fourier series round it (m).\n\n",
    )
    out.push_str("use engine::chart::Radial\n\n")
    var doc: Vec<String> = Vec::new()
    for line in s.about {
        doc.push(line.to_string())
    }
    out.push_str(chart::source(form, s.constant.to_string().as_str(), doc).as_str())
    out
}

/// Form `s` written: what to print of it, or why it failed.
fn written<const A: u32, const R: u32>(s: Spec, f: Fitted<A, R>) -> Result<String, String> {
    let Some(path) = rooted("ws", s.file.to_string().as_str()) else {
        return Err(f"no path for {s.file}")
    }
    if files::write(path.as_str(), file_of(s, f.form).as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(said(s, f))
}

/// A limb's joints' changes written: `name` on the command line, into `file`, its two
/// joints' constants named after `joints` (as "SHOULDER", "ELBOW"), solved for `limb`. What to
/// print of them, or why it failed.
fn joints_written(
    name: Text,
    file: Text,
    joints: [Text; 2],
    limb: posed::Limb,
) -> Result<String, String> {
    let Some(path) = rooted("ws", file.to_string().as_str()) else {
        return Err(f"no path for {file}")
    }
    let (changes, left) = joints::changes_of(limb)
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. How a limb's form changes where its two joints\n",
    )
    out.push_str(
        "// bend (engine::chart::Change): each a form times the bend's angle and a form times its\n",
    )
    out.push_str(
        "// square, written for a bend toward angle 0. Solved against the reference body (Quaternius's\n",
    )
    out.push_str(
        "// Superhero Male, CC0) posed by its own skin weights, over poses of captured motion\n",
    )
    out.push_str("// (studio/forms/joints.wrela).\n\n")
    out.push_str("use engine::chart::Radial\n\n")
    for j in 0..2 {
        out.push_str(
            f"/// The deepest the joint bent among the poses its change was solved over (radians).\npub const {joints[j]}_UPTO: f32 = {changes[j].upto:.2}\n\n",
        )
    }
    for k in 0..4 {
        let form = if k % 2 == 0 { changes[k / 2].by_angle } else { changes[k / 2].by_square }
        let by = if k % 2 == 0 { "ANGLE" } else { "SQUARE" }
        let what = if k % 2 == 0 { "a radian" } else { "a radian squared" }
        var doc: Vec<String> = Vec::new()
        doc.push(f"The joint's change, {what} of its bend (m).")
        out.push_str(chart::source(form, f"{joints[k / 2]}_BY_{by}".as_str(), doc).as_str())
        if k < 3 {
            out.push_str("\n")
        }
    }
    if files::write(path.as_str(), out.as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(
        f"{name}: {file}, its two joints' changes; outside its bends the posed reference is {left.x:.1} mm rms from itself at rest, {left.y:.1} with the changes taken off\n",
    )
}

/// The height his jacket's body stops at (m, at rest): the underside of its shoulders. Under
/// it the jacket is its body's (about his spine); over it, its collar's and its shoulders'.
pub const JACKET_BODY_TOP: f32 = 1.535

/// The height his collar's form starts from: a little under the body's top, so it lies over
/// it with no gap. And the height his shoulders' forms start from: under his armholes' tops.
/// About his spine the jacket's sides are 12 mm rms out over its top 10 cm (its shoulders'
/// corners, their caps over his arms, his armholes' rims: too sharp for a section's Fourier
/// series), so its shoulders' forms take its sides from here up.
pub const COLLAR_FOOT: f32 = 1.53
pub const YOKE_FOOT: f32 = 1.42

/// How far from his middle his shoulders start (m): just inside his collar's wall.
pub const YOKE_INSIDE: f32 = 0.118

/// How far round from straight up a shoulder's form is the jacket's (radians): over the top
/// and down in front and behind; under that it's his armhole or the inside of the jacket.
pub const YOKE_ROUND: f32 = 2.0

/// Which piece of his jacket a point of it at rest belongs to, for piece `piece` (0 its body,
/// 1 its collar, 2 its shoulders), `theta` round that piece's path.
pub fn jacket_piece(piece: u32, p: vec3, theta: f32) -> bool {
    if piece == 0 {
        // (Its body: under its shoulders' tops, and at its sides only as far up as a
        // centimetre past where its shoulders' forms start.)
        return p.y < JACKET_BODY_TOP && (abs(p.x) < YOKE_INSIDE + 0.01 || p.y < YOKE_FOOT + 0.01)
    }
    if piece == 1 {
        return p.y >= COLLAR_FOOT
    }
    p.y >= YOKE_FOOT && abs(p.x) >= YOKE_INSIDE && abs(chart::wrapped(theta)) <= YOKE_ROUND
}

/// Where piece `piece` of Hakuro's jacket (`jacket_piece`) is on the chart of spec `s`: a mark
/// a place, set where a ray from its path meets his sampled jacket at a point that's the
/// piece's. And how many places are set.
pub fn jacket_marks(s: Spec, piece: u32) -> (Vec<bool>, u32) {
    let path = s.chain.rest()
    let len = path.length()
    let every = targets::every_ray(
        Grid { samples: hakuro::jacket_grid::samples(0) },
        path,
        vec2(0.0, 1.0),
        chart::COVER_ALONG,
        chart::COVER_ROUND,
        vec2(0.5, 0.5),
        s.most,
    )
    var marks: Vec<bool> = Vec::new()
    var met = 0
    for k in every {
        var here = false
        if k.r > 0.0 {
            let fr = path.frame(k.f * len)
            let p = fr.at + (fr.up * cos(k.theta) + fr.left * sin(k.theta)) * k.r
            here = jacket_piece(piece, p, k.theta)
        }
        marks.push(here)
    }
    // (A ray grazing a rim meets it at one place and misses at the next, and a mark a ray
    // leaves a toothed edge: each place takes what most of the places round it have, twice.)
    marks = evened(evened(marks))
    for m in marks {
        if m {
            met += 1
        }
    }
    (marks, met)
}

/// A cover's marks with each place given what most of the places within 2 along and 5 round
/// it have: an edge without teeth, and no specks.
pub fn evened(marks: Vec<bool>) -> Vec<bool> {
    let along = chart::COVER_ALONG
    let round = chart::COVER_ROUND
    var out: Vec<bool> = Vec::new()
    for i in 0..along {
        for j in 0..round {
            var set = 0
            var all = 0
            for di in 0..5 {
                if i + di < 2 || i + di >= along + 2 {
                    continue
                }
                for dj in 0..11 {
                    all += 1
                    if marks[(i + di - 2) * round + (j + dj + round - 5) % round] {
                        set += 1
                    }
                }
            }
            out.push(2 * set > all)
        }
    }
    out
}

/// Where Hakuro's jacket's pieces are on their charts, written
/// (content/hakuro/jacket_cover.wrela): its body's, its collar's and each shoulder's cover.
/// What to print of them, or why it failed.
fn jacket_cover_written() -> Result<String, String> {
    let file = "content/hakuro/jacket_cover.wrela"
    let Some(path) = rooted("ws", file) else {
        return Err(f"no path for {file}")
    }
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. Where a garment is on its charts\n",
    )
    out.push_str("// (engine::chart::Cover): a bit a place, set where it is.\n\n")
    out.push_str("use engine::chart::Cover\n")
    var said = String::from("hakuro-jacket-cover: content/hakuro/jacket_cover.wrela;")
    let pieces = [
        (
            HAKURO_JACKET,
            0,
            "JACKET_COVER",
            "its body, about his spine (`figure::chains::trunk`): from its hem to under its shoulders, but for its open front and its armholes",
        ),
        (
            HAKURO_COLLAR,
            1,
            "COLLAR_COVER",
            "its collar, about the line behind the root of his neck (`figure::chains::collar`): but for the gaps either side of its front piece",
        ),
        (
            HAKURO_YOKE_LEFT,
            2,
            "YOKE_LEFT_COVER",
            "its left shoulder, about his collarbone's line (`figure::chains::yoke_left`): over the top and a little way down in front and behind",
        ),
        (
            HAKURO_YOKE_RIGHT,
            2,
            "YOKE_RIGHT_COVER",
            "its right shoulder, about his collarbone's line (`figure::chains::yoke_right`): over the top and a little way down in front and behind",
        ),
    ]
    for piece in pieces {
        let (marks, met) = jacket_marks(piece.0, piece.1)
        var doc: Vec<String> = Vec::new()
        doc.push(f"Where Hakuro's jacket is on the chart of {piece.3},")
        doc.push("as his sampled jacket has it (`jacket_grid`).".to_string())
        out.push_str("\n")
        out.push_str(chart::cover_source(chart::cover_of(marks), piece.2, doc).as_str())
        said.push_str(f" {piece.2} {met} of {marks.len()} places;")
    }
    if files::write(path.as_str(), out.as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    said.push_str("\n")
    Ok(said)
}

/// Whether the command line asks for the form named `name` (every form, if it names none).
fn chosen(wanted: [String], name: Text) -> bool {
    if wanted.is_empty() {
        return true
    }
    for w in wanted {
        if w.as_str() == name {
            return true
        }
    }
    false
}

/// Where a form's reference is, listed: 24 stations along its chain's whole path, each with
/// where the path is there, how many of 32 rays round it meet the reference, and the least and
/// the most radius they find (mm). What a span, a `most` and a `tuck` are chosen from.
fn stations<T: Reference>(t: T, s: Spec) -> String {
    let path = s.chain.rest()
    var out = String::new()
    out.push_str(
        f"{s.name}: its path is {path.length():.3} m; a station: how far along, where the path is (m), rays of 32 that meet its reference within {s.most} m, the least and the most radius (mm)\n",
    )
    for i in 0..24 {
        let f = (f32(i) + 0.5) / 24.0
        let at = path.frame(f * path.length()).at
        let met = rays(t, path, vec2(f, f + 0.0001), 1, 32, vec2(0.0, 0.0), s.most)
        var least = 9.0
        var most = 0.0
        for k in met {
            least = min(least, k.r)
            most = max(most, k.r)
        }
        if met.is_empty() {
            least = 0.0
        }
        out.push_str(
            f"  {f:.3}  at {at.x:.3} {at.y:.3} {at.z:.3}  {met.len()} rays  {least * 1000.0:.0} to {most * 1000.0:.0}\n",
        )
    }
    // Every third station's section: the radius each of 16 rays round it finds (mm; 0 where a
    // ray meets nothing), from angle 0.
    out.push_str("  sections, 16 rays round from angle 0 (mm):\n")
    for i in 0..8 {
        let f = (f32(3 * i) + 1.5) / 24.0
        let every = targets::every_ray(t, path, vec2(f, f + 0.0001), 1, 16, vec2(0.0, 0.0), s.most)
        var line = String::from(f"  {f:.3} ")
        for k in every {
            line.push_str(f" {max(k.r, 0.0) * 1000.0:.0}".as_str())
        }
        line.push_str("\n")
        out.push_str(line.as_str())
    }
    out
}

/// The stations of the form named `name` (`stations`), or nothing if no form has the name.
fn stations_of(name: str) -> Option<String> {
    let body = |part: u32| {
        var keep = [false; 6]
        keep[part] = true
        triangles_of(HERO.clone(), keep, vec3(-9.0), vec3(9.0))
    }
    if name == ARM.name {
        return Some(stations(body(4), ARM))
    }
    if name == LEG.name {
        return Some(stations(body(2), LEG))
    }
    if name == HAKURO_LEG.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_LEG))
    }
    if name == HAKURO_TRUNK.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_TRUNK))
    }
    if name == HAKURO_JACKET.name {
        return Some(stations(Grid { samples: hakuro::jacket_grid::samples(0) }, HAKURO_JACKET))
    }
    if name == HAKURO_HEAD.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_HEAD))
    }
    if name == HAKURO_NECK.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_NECK))
    }
    if name == HAKURO_COLLAR.name {
        return Some(stations(Grid { samples: hakuro::jacket_grid::samples(0) }, HAKURO_COLLAR))
    }
    for i in 0..2 * HAND_PIECES {
        if name == hand_spec(i).name {
            if i < HAND_PIECES {
                return Some(
                    stations(Grid { samples: hakuro::hand_left_grid::samples(0) }, hand_spec(i)),
                )
            }
            return Some(
                stations(Grid { samples: hakuro::hand_right_grid::samples(0) }, hand_spec(i)),
            )
        }
    }
    if name == HAKURO_YOKE_LEFT.name {
        return Some(stations(Grid { samples: hakuro::jacket_grid::samples(0) }, HAKURO_YOKE_LEFT))
    }
    if name == HAKURO_YOKE_RIGHT.name {
        return Some(stations(Grid { samples: hakuro::jacket_grid::samples(0) }, HAKURO_YOKE_RIGHT))
    }
    None
}

pub fn tool() -> u32 {
    let wanted = args()
    if wanted.len() >= 1 && wanted[0].as_str() == "--stations" {
        if wanted.len() < 2 {
            print(USAGE)
            return 2
        }
        for i in 1..wanted.len() {
            match stations_of(wanted[i].as_str()) {
                Some(text) => print(text),
                None => {
                    print(f"forms: no form is named {wanted[i]}")
                    return 2
                },
            }
        }
        return 0
    }
    var done = 0
    var results: Vec<Result<String, String>> = Vec::new()
    // (What's fitted over the species' arm is fitted over it as this run has it, so one run
    // writes them all the same whatever was written before.)
    let arms = chosen(wanted, HAKURO_ARM_LEFT.name) || chosen(wanted, HAKURO_ARM_RIGHT.name)
    if chosen(wanted, ARM.name) || arms {
        let species = arm()
        if chosen(wanted, ARM.name) {
            results.push(written(ARM, species))
        }
        if chosen(wanted, HAKURO_ARM_LEFT.name) {
            results.push(written(HAKURO_ARM_LEFT, hakuro_arm_left(species.form)))
        }
        if chosen(wanted, HAKURO_ARM_RIGHT.name) {
            results.push(written(HAKURO_ARM_RIGHT, hakuro_arm_right(species.form)))
        }
    }
    if chosen(wanted, "arm-joints") {
        results.push(
            joints_written(
                "arm-joints",
                "content/figure/arm_joints.wrela",
                ["SHOULDER", "ELBOW"],
                posed::ARM_LEFT,
            ),
        )
    }
    if chosen(wanted, HAKURO_TRUNK.name) {
        results.push(written(HAKURO_TRUNK, hakuro_trunk()))
    }
    if chosen(wanted, HAKURO_JACKET.name) {
        results.push(written(HAKURO_JACKET, hakuro_jacket()))
    }
    if chosen(wanted, "hakuro-jacket-cover") {
        results.push(jacket_cover_written())
    }
    if chosen(wanted, HAKURO_COLLAR.name) {
        results.push(written(HAKURO_COLLAR, hakuro_collar()))
    }
    if chosen(wanted, HAKURO_YOKE_LEFT.name) {
        results.push(written(HAKURO_YOKE_LEFT, hakuro_yoke(HAKURO_YOKE_LEFT)))
    }
    if chosen(wanted, HAKURO_YOKE_RIGHT.name) {
        results.push(written(HAKURO_YOKE_RIGHT, hakuro_yoke(HAKURO_YOKE_RIGHT)))
    }
    for i in 0..2 * HAND_PIECES {
        if chosen(wanted, hand_spec(i).name) {
            results.push(written(hand_spec(i), hakuro_hand(i)))
        }
    }
    if chosen(wanted, HAKURO_NECK.name) {
        results.push(written(HAKURO_NECK, hakuro_neck()))
    }
    if chosen(wanted, HAKURO_HEAD.name) {
        results.push(written(HAKURO_HEAD, hakuro_head()))
    }
    if chosen(wanted, LEG.name) || chosen(wanted, HAKURO_LEG.name) {
        let species_leg = leg()
        if chosen(wanted, LEG.name) {
            results.push(written(LEG, species_leg))
        }
        if chosen(wanted, HAKURO_LEG.name) {
            results.push(written(HAKURO_LEG, hakuro_leg(species_leg.form)))
        }
    }
    if chosen(wanted, "leg-joints") {
        results.push(
            joints_written(
                "leg-joints",
                "content/figure/leg_joints.wrela",
                ["HIP", "KNEE"],
                posed::LEG_LEFT,
            ),
        )
    }
    for r in results {
        match r {
            Ok(text) => print(text),
            Err(e) => {
                print(f"forms: {e}")
                return 1
            },
        }
        done += 1
    }
    if done == 0 {
        print(USAGE)
        return 2
    }
    0
}
