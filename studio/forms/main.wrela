/// What's said of a fitted form: its misses' spread, and their size by place.
fn said<const A: u32, const R: u32>(s: Spec, f: Fitted<A, R>) -> String {
    let m = f.miss.spread
    var out = String::new()
    out.push_str(
        if f.rays > 0 {
            f"{s.name}: {s.file}, {f.form.numbers()} numbers from {f.rays} rays; {m.count} more between them miss by {m.rms:.2} mm rms, half under {m.half:.2}, 95% under {m.most:.2}, worst {m.worst:.1}\n"
        } else {
            f"{s.name}: {s.file}, {f.form.numbers()} numbers kept where they were; {m.count} radii of its reference as it was miss by {m.rms:.2} mm rms, half under {m.half:.2}, 95% under {m.most:.2}, worst {m.worst:.1}\n"
        },
    )
    out.push_str(
        "  by place (mm rms): a row a station from the span's start to its end, a column a sector round from angle 0\n",
    )
    for i in 0..STATIONS {
        out.push_str("   ")
        for j in 0..SECTORS {
            out.push_str(f" {f.miss.by_place[i][j]:.2}")
        }
        out.push_str("\n")
    }
    out
}

/// The source of form `s`'s file.
pub fn file_of<const A: u32, const R: u32>(s: Spec, form: Radial<A, R>) -> String {
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. A charted form's radius (engine::chart): a row\n",
    )
    out.push_str(
        "// a control value along its path, each a Fourier series round it (m).\n\n",
    )
    out.push_str("use engine::chart::Radial\n\n")
    var doc: Vec<String> = Vec::new()
    for line in s.about {
        doc.push(line.to_string())
    }
    out.push_str(chart::source(form, s.constant.to_string().as_str(), doc).as_str())
    out
}

/// Form `s` written: what to print of it, or why it failed.
fn written<const A: u32, const R: u32>(s: Spec, f: Fitted<A, R>) -> Result<String, String> {
    let Some(path) = rooted("ws", s.file.to_string().as_str()) else {
        return Err(f"no path for {s.file}")
    }
    if files::write(path.as_str(), file_of(s, f.form).as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(said(s, f))
}

/// A limb's joints' changes written: `name` on the command line, into `file`, its two
/// joints' constants named after `joints` (as "SHOULDER", "ELBOW"), solved for `limb`. What to
/// print of them, or why it failed.
fn joints_written(
    name: Text,
    file: Text,
    joints: [Text; 2],
    limb: posed::Limb,
) -> Result<String, String> {
    let Some(path) = rooted("ws", file.to_string().as_str()) else {
        return Err(f"no path for {file}")
    }
    let (changes, left) = joints::changes_of(limb)
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. How a limb's form changes where its two joints\n",
    )
    out.push_str(
        "// bend (engine::chart::Change): each a form times the bend's angle and a form times its\n",
    )
    out.push_str(
        "// square, written for a bend toward angle 0. Solved against the reference body (Quaternius's\n",
    )
    out.push_str(
        "// Superhero Male, CC0) posed by its own skin weights, over poses of captured motion\n",
    )
    out.push_str("// (studio/forms/joints.wrela).\n\n")
    out.push_str("use engine::chart::Radial\n\n")
    for j in 0..2 {
        out.push_str(
            f"/// The deepest the joint bent among the poses its change was solved over (radians).\npub const {joints[j]}_UPTO: f32 = {changes[j].upto:.2}\n\n",
        )
    }
    for k in 0..4 {
        let form = if k % 2 == 0 { changes[k / 2].by_angle } else { changes[k / 2].by_square }
        let by = if k % 2 == 0 { "ANGLE" } else { "SQUARE" }
        let what = if k % 2 == 0 { "a radian" } else { "a radian squared" }
        var doc: Vec<String> = Vec::new()
        doc.push(f"The joint's change, {what} of its bend (m).")
        out.push_str(chart::source(form, f"{joints[k / 2]}_BY_{by}".as_str(), doc).as_str())
        if k < 3 {
            out.push_str("\n")
        }
    }
    if files::write(path.as_str(), out.as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(
        f"{name}: {file}, its two joints' changes; outside its bends the posed reference is {left.x:.1} mm rms from itself at rest, {left.y:.1} with the changes taken off\n",
    )
}

/// Whether the command line asks for the form named `name` (every form, if it names none).
fn chosen(wanted: [String], name: Text) -> bool {
    if wanted.is_empty() {
        return true
    }
    for w in wanted {
        if w.as_str() == name {
            return true
        }
    }
    false
}

/// Where a form's reference is, listed: 24 stations along its chain's whole path, each with
/// where the path is there, how many of 32 rays round it meet the reference, and the least and
/// the most radius they find (mm). What a span, a `most` and a `tuck` are chosen from.
fn stations<T: Reference>(t: T, s: Spec) -> String {
    let path = s.chain.rest()
    var out = String::new()
    out.push_str(
        f"{s.name}: its path is {path.length():.3} m; a station: how far along, where the path is (m), rays of 32 that meet its reference within {s.most} m, the least and the most radius (mm)\n",
    )
    for i in 0..24 {
        let f = (f32(i) + 0.5) / 24.0
        let at = path.frame(f * path.length()).at
        let met = rays(t, path, vec2(f, f + 0.0001), 1, 32, vec2(0.0, 0.0), s.most)
        var least = 9.0
        var most = 0.0
        for k in met {
            least = min(least, k.r)
            most = max(most, k.r)
        }
        if met.is_empty() {
            least = 0.0
        }
        out.push_str(
            f"  {f:.3}  at {at.x:.3} {at.y:.3} {at.z:.3}  {met.len()} rays  {least * 1000.0:.0} to {most * 1000.0:.0}\n",
        )
    }
    // Every third station's section: the radius each of 16 rays round it finds (mm; 0 where a
    // ray meets nothing), from angle 0.
    out.push_str("  sections, 16 rays round from angle 0 (mm):\n")
    for i in 0..8 {
        let f = (f32(3 * i) + 1.5) / 24.0
        let every = targets::every_ray(t, path, vec2(f, f + 0.0001), 1, 16, vec2(0.0, 0.0), s.most)
        var line = String::from(f"  {f:.3} ")
        for k in every {
            line.push_str(f" {max(k.r, 0.0) * 1000.0:.0}".as_str())
        }
        line.push_str("\n")
        out.push_str(line.as_str())
    }
    out
}

/// The stations of the form named `name` (`stations`), or nothing if no form has the name.
fn stations_of(name: str) -> Option<String> {
    let body = |part: u32| {
        var keep = [false; 6]
        keep[part] = true
        triangles_of(HERO.clone(), keep, vec3(-9.0), vec3(9.0))
    }
    if name == ARM.name {
        return Some(stations(body(4), ARM))
    }
    if name == LEG.name {
        return Some(stations(body(2), LEG))
    }
    None
}

pub fn tool() -> u32 {
    let wanted = args()
    if wanted.len() >= 1 && wanted[0].as_str() == "--stations" {
        if wanted.len() < 2 {
            print(USAGE)
            return 2
        }
        for i in 1..wanted.len() {
            match stations_of(wanted[i].as_str()) {
                Some(text) => print(text),
                None => {
                    print(f"forms: no form is named {wanted[i]}")
                    return 2
                },
            }
        }
        return 0
    }
    var done = 0
    var results: Vec<Result<String, String>> = Vec::new()
    // (What's fitted over the species' arm is fitted over it as this run has it, so one run
    // writes them all the same whatever was written before.)
    let arms = chosen(wanted, HAKURO_ARM_LEFT.name) || chosen(wanted, HAKURO_ARM_RIGHT.name)
    if chosen(wanted, ARM.name) || arms {
        let species = arm()
        if chosen(wanted, ARM.name) {
            results.push(written(ARM, species))
        }
        if chosen(wanted, HAKURO_ARM_LEFT.name) {
            results.push(written(HAKURO_ARM_LEFT, hakuro_arm_left(species.form)))
        }
        if chosen(wanted, HAKURO_ARM_RIGHT.name) {
            results.push(written(HAKURO_ARM_RIGHT, hakuro_arm_right(species.form)))
        }
    }
    if chosen(wanted, "arm-joints") {
        results.push(
            joints_written(
                "arm-joints",
                "content/figure/arm_joints.wrela",
                ["SHOULDER", "ELBOW"],
                posed::ARM_LEFT,
            ),
        )
    }
    if chosen(wanted, HAKURO_TRUNK.name) {
        results.push(written(HAKURO_TRUNK, hakuro_trunk()))
    }
    if chosen(wanted, HAKURO_JACKET.name) {
        results.push(written(HAKURO_JACKET, hakuro_jacket()))
    }
    if chosen(wanted, HAKURO_COLLAR.name) {
        results.push(written(HAKURO_COLLAR, hakuro_collar()))
    }
    if chosen(wanted, HAKURO_YOKE_LEFT.name) {
        results.push(written(HAKURO_YOKE_LEFT, hakuro_yoke_left()))
    }
    if chosen(wanted, HAKURO_YOKE_RIGHT.name) {
        results.push(written(HAKURO_YOKE_RIGHT, hakuro_yoke_right()))
    }
    for i in 0..2 * HAND_PIECES {
        if chosen(wanted, hand_spec(i).name) {
            results.push(written(hand_spec(i), hakuro_hand(i)))
        }
    }
    if chosen(wanted, LEG.name) || chosen(wanted, HAKURO_LEG.name) {
        let species_leg = leg()
        if chosen(wanted, LEG.name) {
            results.push(written(LEG, species_leg))
        }
        if chosen(wanted, HAKURO_LEG.name) {
            results.push(written(HAKURO_LEG, hakuro_leg(species_leg.form)))
        }
    }
    if chosen(wanted, "leg-joints") {
        results.push(
            joints_written(
                "leg-joints",
                "content/figure/leg_joints.wrela",
                ["HIP", "KNEE"],
                posed::LEG_LEFT,
            ),
        )
    }
    for r in results {
        match r {
            Ok(text) => print(text),
            Err(e) => {
                print(f"forms: {e}")
                return 1
            },
        }
        done += 1
    }
    if done == 0 {
        print(USAGE)
        return 2
    }
    0
}
