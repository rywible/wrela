/// A form fitted: its numbers as written, how far it is from its reference where it wasn't
/// fitted, and how many rays it was fitted to.
pub struct Fitted<const A: u32, const R: u32>: Copy {
    pub form: Radial<A, R>,
    pub miss: Miss,
    pub rays: u32,
}

/// What's fitted of `s` over `base`: the reference `t` read at four places a control value
/// along by four a term round over its span, less `base` there. A place whose ray meets no
/// side of the reference (an opening in a garment, where a limb is joined to something else)
/// is given what the places either side of it round its station have, so the form runs on
/// smoothly across it. The root's radius narrows evenly from where the reference starts to
/// `tuck` of it at the path's start (or, over a base that isn't nothing, the difference is
/// held: the base is tucked already); and past the reference's end the form keeps what it is
/// at its end. Solved, rounded as it's written, and measured with `base` added back, between
/// the fit's places.
pub fn fitted_over<const A: u32, const R: u32, T: Reference>(
    t: T,
    s: Spec,
    base: Radial<A, R>,
    based: bool,
) -> Fitted<A, R> {
    let path = s.chain.rest()
    let along = 4 * A
    let about = 4 * R
    let every = targets::every_ray(t, path, s.span, along, about, vec2(0.0, 0.0), s.most)
    var seen: Vec<Sample> = Vec::new()
    var read = 0
    // The first and the last station's rows, as they're fitted: the root and the tail run on
    // from them.
    var first: Vec<Sample> = Vec::new()
    var last: Vec<Sample> = Vec::new()
    for i in 0..along {
        var row: Vec<Sample> = Vec::new()
        var met = 0
        for j in 0..about {
            let k = every[i * about + j]
            if k.r > 0.0 {
                met += 1
            }
            row.push(Sample { r: k.r - base.radius(k.f, k.theta), ..k })
        }
        if met == 0 {
            continue
        }
        read += met
        for j in 0..about {
            if every[i * about + j].r > 0.0 {
                continue
            }
            // The nearest places round the station, before and after, whose rays met a side.
            var before = 1
            while every[i * about + (j + about - before) % about].r <= 0.0 {
                before += 1
            }
            var after = 1
            while every[i * about + (j + after) % about].r <= 0.0 {
                after += 1
            }
            let a = every[i * about + (j + about - before) % about]
            let b = every[i * about + (j + after) % about]
            let x = f32(before) / f32(before + after)
            row[j].r = mix(a.r - base.radius(a.f, a.theta), b.r - base.radius(b.f, b.theta), x)
        }
        if first.is_empty() {
            first = row.clone()
        }
        last = row.clone()
        for k in row {
            seen.push(k)
        }
    }
    // The root, before the reference starts.
    let steps = max(u32(f32(along) * s.span.x / max(s.span.y - s.span.x, 0.001)), 2)
    for i in 0..steps {
        let f = s.span.x * f32(i) / f32(steps)
        for k in first {
            let r = if based { k.r } else { k.r * mix(s.tuck, 1.0, smoothstep(0.0, s.span.x, f)) }
            seen.push(Sample { f, theta: k.theta, r })
        }
    }
    // Past the reference's end.
    if s.span.y < 0.999 {
        let more = max(u32(f32(along) * (1.0 - s.span.y) / max(s.span.y - s.span.x, 0.001)), 2)
        for i in 0..more {
            let f = s.span.y + (1.0 - s.span.y) * f32(i + 1) / f32(more)
            for k in last {
                seen.push(Sample { f, theta: k.theta, r: k.r })
            }
        }
    }
    let form: Radial<A, R> = chart::rounded(chart::fit(seen))
    let unseen = rays(t, path, s.span, along, about, vec2(0.5, 0.5), s.most)
    Fitted { form, miss: miss(base.plus(form), unseen, s.span, path.length()), rays: read }
}

/// `s`'s form fitted to reference `t`, over nothing.
pub fn fitted<const A: u32, const R: u32, T: Reference>(t: T, s: Spec) -> Fitted<A, R> {
    fitted_over(t, s, chart::round(0.0), false)
}

/// The reference body's left arm's triangles (its shoulder, arm and hand).
pub fn body_arm_left() -> targets::Triangles {
    triangles_of(
        HERO.clone(),
        [false, false, false, false, true, false],
        vec3(0.1, 1.2, -0.3),
        vec3(0.8, 1.7, 0.2),
    )
}

/// The species' arm, fitted.
pub fn arm() -> Fitted<16, 13> {
    fitted(body_arm_left(), ARM)
}

/// What Hakuro's left arm is over the species' arm `base`, fitted.
pub fn hakuro_arm_left(base: Radial<16, 13>) -> Fitted<16, 13> {
    fitted_over(Grid { samples: arm_left_grid::samples(0) }, HAKURO_ARM_LEFT, base, true)
}

/// What Hakuro's right arm is over the species' arm `base` (the left's: mirrored here),
/// fitted.
pub fn hakuro_arm_right(base: Radial<16, 13>) -> Fitted<16, 13> {
    fitted_over(
        Grid { samples: hakuro::arm_right_grid::samples(0) },
        HAKURO_ARM_RIGHT,
        base.mirrored(),
        true,
    )
}

/// The species' leg, fitted to the reference body's left leg's triangles.
pub fn leg() -> Fitted<16, 13> {
    fitted(
        triangles_of(
            HERO.clone(),
            [false, false, true, false, false, false],
            vec3(-9.0),
            vec3(9.0),
        ),
        LEG,
    )
}

/// What Hakuro's left leg is over the species' leg `base`, fitted.
pub fn hakuro_leg(base: Radial<16, 13>) -> Fitted<16, 13> {
    fitted_over(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_LEG, base, true)
}

/// Hakuro's trunk, fitted.
pub fn hakuro_trunk() -> Fitted<24, 21> {
    fitted(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_TRUNK)
}

/// Hakuro's jacket, fitted.
pub fn hakuro_jacket() -> Fitted<24, 21> {
    fitted(Grid { samples: hakuro::jacket_grid::samples(0) }, HAKURO_JACKET)
}

/// Hakuro's neck and head, fitted.
pub fn hakuro_head() -> Fitted<16, 13> {
    fitted(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_HEAD)
}

/// What's said of a fitted form: its misses' spread, and their size by place.
fn said<const A: u32, const R: u32>(s: Spec, f: Fitted<A, R>) -> String {
    let m = f.miss.spread
    var out = String::new()
    out.push_str(
        f"{s.name}: {s.file}, {f.form.numbers()} numbers from {f.rays} rays; {m.count} more between them miss by {m.rms:.2} mm rms, half under {m.half:.2}, 95% under {m.most:.2}, worst {m.worst:.1}\n",
    )
    out.push_str(
        "  by place (mm rms): a row a station from the span's start to its end, a column a sector round from angle 0\n",
    )
    for i in 0..STATIONS {
        out.push_str("   ")
        for j in 0..SECTORS {
            out.push_str(f" {f.miss.by_place[i][j]:.2}")
        }
        out.push_str("\n")
    }
    out
}

/// The source of form `s`'s file.
pub fn file_of<const A: u32, const R: u32>(s: Spec, form: Radial<A, R>) -> String {
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. A charted form's radius (engine::chart): a row\n",
    )
    out.push_str(
        "// a control value along its path, each a Fourier series round it (m).\n\n",
    )
    out.push_str("use engine::chart::Radial\n\n")
    var doc: Vec<String> = Vec::new()
    for line in s.about {
        doc.push(line.to_string())
    }
    out.push_str(chart::source(form, s.constant.to_string().as_str(), doc).as_str())
    out
}

/// Form `s` written: what to print of it, or why it failed.
fn written<const A: u32, const R: u32>(s: Spec, f: Fitted<A, R>) -> Result<String, String> {
    let Some(path) = rooted("ws", s.file.to_string().as_str()) else {
        return Err(f"no path for {s.file}")
    }
    if files::write(path.as_str(), file_of(s, f.form).as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(said(s, f))
}

/// A limb's joints' changes written: `name` on the command line, into `file`, its two
/// joints' constants named after `joints` (as "SHOULDER", "ELBOW"), solved for `limb`. What to
/// print of them, or why it failed.
fn joints_written(
    name: Text,
    file: Text,
    joints: [Text; 2],
    limb: posed::Limb,
) -> Result<String, String> {
    let Some(path) = rooted("ws", file.to_string().as_str()) else {
        return Err(f"no path for {file}")
    }
    let (changes, left) = joints::changes_of(limb)
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. How a limb's form changes where its two joints\n",
    )
    out.push_str(
        "// bend (engine::chart::Change): each a form times the bend's angle and a form times its\n",
    )
    out.push_str(
        "// square, written for a bend toward angle 0. Solved against the reference body (Quaternius's\n",
    )
    out.push_str(
        "// Superhero Male, CC0) posed by its own skin weights, over poses of captured motion\n",
    )
    out.push_str("// (studio/forms/joints.wrela).\n\n")
    out.push_str("use engine::chart::Radial\n\n")
    for j in 0..2 {
        out.push_str(
            f"/// The deepest the joint bent among the poses its change was solved over (radians).\npub const {joints[j]}_UPTO: f32 = {changes[j].upto:.2}\n\n",
        )
    }
    for k in 0..4 {
        let form = if k % 2 == 0 { changes[k / 2].by_angle } else { changes[k / 2].by_square }
        let by = if k % 2 == 0 { "ANGLE" } else { "SQUARE" }
        let what = if k % 2 == 0 { "a radian" } else { "a radian squared" }
        var doc: Vec<String> = Vec::new()
        doc.push(f"The joint's change, {what} of its bend (m).")
        out.push_str(chart::source(form, f"{joints[k / 2]}_BY_{by}".as_str(), doc).as_str())
        if k < 3 {
            out.push_str("\n")
        }
    }
    if files::write(path.as_str(), out.as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(
        f"{name}: {file}, its two joints' changes; outside its bends the posed reference is {left.x:.1} mm rms from itself at rest, {left.y:.1} with the changes taken off\n",
    )
}

/// Where Hakuro's jacket is on its chart, written (content/hakuro/jacket_cover.wrela): a mark a
/// place, set where a ray from the line of his spine meets his sampled jacket. What to print of
/// it, or why it failed.
fn jacket_cover_written() -> Result<String, String> {
    let file = "content/hakuro/jacket_cover.wrela"
    let Some(path) = rooted("ws", file) else {
        return Err(f"no path for {file}")
    }
    let every = targets::every_ray(
        Grid { samples: hakuro::jacket_grid::samples(0) },
        chains::trunk().rest(),
        vec2(0.0, 1.0),
        chart::COVER_ALONG,
        chart::COVER_ROUND,
        vec2(0.5, 0.5),
        HAKURO_JACKET.most,
    )
    var marks: Vec<bool> = Vec::new()
    var met = 0
    for k in every {
        marks.push(k.r > 0.0)
        if k.r > 0.0 {
            met += 1
        }
    }
    var out = String::new()
    out.push_str(
        "// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change\n",
    )
    out.push_str(
        "// the tool or what it fits and write it again. Where a garment is on its chart\n",
    )
    out.push_str("// (engine::chart::Cover): a bit a place, set where it is.\n\n")
    out.push_str("use engine::chart::Cover\n\n")
    var doc: Vec<String> = Vec::new()
    doc.push(
        "Where Hakuro's jacket is on its chart (`figure::chains::trunk`): everywhere but its open".to_string(),
    )
    doc.push("front and its armholes, as his sampled jacket has them (`jacket_grid`).".to_string())
    out.push_str(chart::cover_source(chart::cover_of(marks), "JACKET_COVER", doc).as_str())
    if files::write(path.as_str(), out.as_bytes()).wait().is_err() {
        return Err(f"couldn't write {path}")
    }
    Ok(
        f"hakuro-jacket-cover: {file}, the jacket is at {met} of {every.len()} places on its chart\n",
    )
}

/// Whether the command line asks for the form named `name` (every form, if it names none).
fn chosen(wanted: [String], name: Text) -> bool {
    if wanted.is_empty() {
        return true
    }
    for w in wanted {
        if w.as_str() == name {
            return true
        }
    }
    false
}

/// Where a form's reference is, listed: 24 stations along its chain's whole path, each with
/// where the path is there, how many of 32 rays round it meet the reference, and the least and
/// the most radius they find (mm). What a span, a `most` and a `tuck` are chosen from.
fn stations<T: Reference>(t: T, s: Spec) -> String {
    let path = s.chain.rest()
    var out = String::new()
    out.push_str(
        f"{s.name}: its path is {path.length():.3} m; a station: how far along, where the path is (m), rays of 32 that meet its reference within {s.most} m, the least and the most radius (mm)\n",
    )
    for i in 0..24 {
        let f = (f32(i) + 0.5) / 24.0
        let at = path.frame(f * path.length()).at
        let met = rays(t, path, vec2(f, f + 0.0001), 1, 32, vec2(0.0, 0.0), s.most)
        var least = 9.0
        var most = 0.0
        for k in met {
            least = min(least, k.r)
            most = max(most, k.r)
        }
        if met.is_empty() {
            least = 0.0
        }
        out.push_str(
            f"  {f:.3}  at {at.x:.3} {at.y:.3} {at.z:.3}  {met.len()} rays  {least * 1000.0:.0} to {most * 1000.0:.0}\n",
        )
    }
    out
}

/// The stations of the form named `name` (`stations`), or nothing if no form has the name.
fn stations_of(name: str) -> Option<String> {
    let body = |part: u32| {
        var keep = [false; 6]
        keep[part] = true
        triangles_of(HERO.clone(), keep, vec3(-9.0), vec3(9.0))
    }
    if name == ARM.name {
        return Some(stations(body(4), ARM))
    }
    if name == LEG.name {
        return Some(stations(body(2), LEG))
    }
    if name == HAKURO_ARM_LEFT.name {
        return Some(stations(Grid { samples: arm_left_grid::samples(0) }, HAKURO_ARM_LEFT))
    }
    if name == HAKURO_ARM_RIGHT.name {
        return Some(
            stations(Grid { samples: hakuro::arm_right_grid::samples(0) }, HAKURO_ARM_RIGHT),
        )
    }
    if name == HAKURO_LEG.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_LEG))
    }
    if name == HAKURO_TRUNK.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_TRUNK))
    }
    if name == HAKURO_JACKET.name {
        return Some(stations(Grid { samples: hakuro::jacket_grid::samples(0) }, HAKURO_JACKET))
    }
    if name == HAKURO_HEAD.name {
        return Some(stations(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_HEAD))
    }
    None
}

pub fn tool() -> u32 {
    let wanted = args()
    if wanted.len() >= 1 && wanted[0].as_str() == "--stations" {
        if wanted.len() < 2 {
            print(USAGE)
            return 2
        }
        for i in 1..wanted.len() {
            match stations_of(wanted[i].as_str()) {
                Some(text) => print(text),
                None => {
                    print(f"forms: no form is named {wanted[i]}")
                    return 2
                },
            }
        }
        return 0
    }
    var done = 0
    var results: Vec<Result<String, String>> = Vec::new()
    // (What's fitted over the species' arm is fitted over it as this run has it, so one run
    // writes them all the same whatever was written before.)
    let arms = chosen(wanted, HAKURO_ARM_LEFT.name) || chosen(wanted, HAKURO_ARM_RIGHT.name)
    if chosen(wanted, ARM.name) || arms {
        let species = arm()
        if chosen(wanted, ARM.name) {
            results.push(written(ARM, species))
        }
        if chosen(wanted, HAKURO_ARM_LEFT.name) {
            results.push(written(HAKURO_ARM_LEFT, hakuro_arm_left(species.form)))
        }
        if chosen(wanted, HAKURO_ARM_RIGHT.name) {
            results.push(written(HAKURO_ARM_RIGHT, hakuro_arm_right(species.form)))
        }
    }
    if chosen(wanted, "arm-joints") {
        results.push(
            joints_written(
                "arm-joints",
                "content/figure/arm_joints.wrela",
                ["SHOULDER", "ELBOW"],
                posed::ARM_LEFT,
            ),
        )
    }
    if chosen(wanted, HAKURO_TRUNK.name) {
        results.push(written(HAKURO_TRUNK, hakuro_trunk()))
    }
    if chosen(wanted, HAKURO_JACKET.name) {
        results.push(written(HAKURO_JACKET, hakuro_jacket()))
    }
    if chosen(wanted, "hakuro-jacket-cover") {
        results.push(jacket_cover_written())
    }
    if chosen(wanted, HAKURO_HEAD.name) {
        results.push(written(HAKURO_HEAD, hakuro_head()))
    }
    if chosen(wanted, LEG.name) || chosen(wanted, HAKURO_LEG.name) {
        let species_leg = leg()
        if chosen(wanted, LEG.name) {
            results.push(written(LEG, species_leg))
        }
        if chosen(wanted, HAKURO_LEG.name) {
            results.push(written(HAKURO_LEG, hakuro_leg(species_leg.form)))
        }
    }
    if chosen(wanted, "leg-joints") {
        results.push(
            joints_written(
                "leg-joints",
                "content/figure/leg_joints.wrela",
                ["HIP", "KNEE"],
                posed::LEG_LEFT,
            ),
        )
    }
    for r in results {
        match r {
            Ok(text) => print(text),
            Err(e) => {
                print(f"forms: {e}")
                return 1
            },
        }
        done += 1
    }
    if done == 0 {
        print(USAGE)
        return 2
    }
    0
}
