/// The pieces of a hand: its four fingers from the index, its thumb, its palm.
pub const HAND_PIECES: u32 = 6

const HAND_NAMES: [Text; 12] = [
    "hakuro-index-left",
    "hakuro-middle-left",
    "hakuro-ring-left",
    "hakuro-little-left",
    "hakuro-thumb-left",
    "hakuro-palm-left",
    "hakuro-index-right",
    "hakuro-middle-right",
    "hakuro-ring-right",
    "hakuro-little-right",
    "hakuro-thumb-right",
    "hakuro-palm-right",
]
const HAND_FILES: [Text; 12] = [
    "content/hakuro/index_left_form.wrela",
    "content/hakuro/middle_left_form.wrela",
    "content/hakuro/ring_left_form.wrela",
    "content/hakuro/little_left_form.wrela",
    "content/hakuro/thumb_left_form.wrela",
    "content/hakuro/palm_left_form.wrela",
    "content/hakuro/index_right_form.wrela",
    "content/hakuro/middle_right_form.wrela",
    "content/hakuro/ring_right_form.wrela",
    "content/hakuro/little_right_form.wrela",
    "content/hakuro/thumb_right_form.wrela",
    "content/hakuro/palm_right_form.wrela",
]
const HAND_CONSTANTS: [Text; 12] = [
    "INDEX_LEFT",
    "MIDDLE_LEFT",
    "RING_LEFT",
    "LITTLE_LEFT",
    "THUMB_LEFT",
    "PALM_LEFT",
    "INDEX_RIGHT",
    "MIDDLE_RIGHT",
    "RING_RIGHT",
    "LITTLE_RIGHT",
    "THUMB_RIGHT",
    "PALM_RIGHT",
]

/// Piece `i` of Hakuro's hands (his left's six in `HAND_PIECES`' order, then his right's): his
/// left hand bare and his right in its glove, each its sampled hand's own surface. A finger
/// from where it leaves his palm to where its tip starts to round (a part closes it from
/// there: `Part::caps`); his palm from up his forearm, through his wrist, to his knuckles. A
/// finger's reference is read no further out than the gap to the finger beside it.
pub fn hand_spec(i: u32) -> Spec {
    let piece = i % HAND_PIECES
    let left = i < HAND_PIECES
    let palm = piece == 5
    Spec {
        name: HAND_NAMES[i],
        file: HAND_FILES[i],
        constant: HAND_CONSTANTS[i],
        about: [
            "A piece of one of Hakuro's hands (his left bare, his right gloved): his sampled hand's",
            "surface (`hand_left_grid`, `hand_right_grid`), read along rays from the piece's own",
            "line (`hakuro::hands`) and fitted by the forms tool.",
        ],
        chain: if palm {
            if left { hakuro::hands::palm_left() } else { hakuro::hands::palm_right() }
        } else if left {
            hakuro::hands::finger_left(piece)
        } else {
            hakuro::hands::finger_right(piece)
        },
        // (A finger is read from its knuckle on: there only the rays toward the back of his
        // hand meet it, and the rest run on from them, so the form carries the knuckle's
        // head. Read from past the web, his open hand had no line of knuckles.)
        span: if palm { vec2(0.04, 0.94) } else if piece == 4 { vec2(0.55, 0.88) } else {
            vec2(0.15, 0.88)
        },
        // (His palm is read as far out as the root of his thumb: cut short of it, a notch
        // opened between his palm and his thumb.)
        most: if palm { 0.07 } else { 0.016 },
        tuck: 1.0,
    }
}

/// Piece `i` of Hakuro's hands (`hand_spec`), fitted.
pub fn hakuro_hand(i: u32) -> Fitted<16, 13> {
    if i < HAND_PIECES {
        fitted(Grid { samples: hakuro::hand_left_grid::samples(0) }, hand_spec(i))
    } else {
        fitted(Grid { samples: hakuro::hand_right_grid::samples(0) }, hand_spec(i))
    }
}

/// A form fitted: its numbers as written, how far it is from its reference where it wasn't
/// fitted, and how many rays it was fitted to.
pub struct Fitted<const A: u32, const R: u32>: Copy {
    pub form: Radial<A, R>,
    pub miss: Miss,
    pub rays: u32,
}

/// What's fitted of `s` over `base`: the reference `t` read at four places a control value
/// along by four a term round over its span, less `base` there. A place whose ray meets no
/// side of the reference (an opening in a garment, where a limb is joined to something else)
/// is given what the places either side of it round its station have, so the form runs on
/// smoothly across it. The root's radius narrows evenly from where the reference starts to
/// `tuck` of it at the path's start (or, over a base that isn't nothing, the difference is
/// held: the base is tucked already); and past the reference's end the form keeps what it is
/// at its end. Solved, rounded as it's written, and measured with `base` added back, between
/// the fit's places.
pub fn fitted_over<const A: u32, const R: u32, T: Reference>(
    t: T,
    s: Spec,
    base: Radial<A, R>,
    based: bool,
) -> Fitted<A, R> {
    let path = s.chain.rest()
    let along = 4 * A
    let about = 4 * R
    let every = targets::every_ray(t, path, s.span, along, about, vec2(0.0, 0.0), s.most)
    var seen: Vec<Sample> = Vec::new()
    var read = 0
    // The first and the last station's rows, as they're fitted: the root and the tail run on
    // from them.
    var first: Vec<Sample> = Vec::new()
    var last: Vec<Sample> = Vec::new()
    for i in 0..along {
        var row: Vec<Sample> = Vec::new()
        var met = 0
        for j in 0..about {
            let k = every[i * about + j]
            if k.r > 0.0 {
                met += 1
            }
            row.push(Sample { r: k.r - base.radius(k.f, k.theta), ..k })
        }
        if met == 0 {
            continue
        }
        read += met
        for j in 0..about {
            if every[i * about + j].r > 0.0 {
                continue
            }
            // The nearest places round the station, before and after, whose rays met a side.
            var before = 1
            while every[i * about + (j + about - before) % about].r <= 0.0 {
                before += 1
            }
            var after = 1
            while every[i * about + (j + after) % about].r <= 0.0 {
                after += 1
            }
            let a = every[i * about + (j + about - before) % about]
            let b = every[i * about + (j + after) % about]
            let x = f32(before) / f32(before + after)
            row[j].r = mix(a.r - base.radius(a.f, a.theta), b.r - base.radius(b.f, b.theta), x)
        }
        if first.is_empty() {
            first = row.clone()
        }
        last = row.clone()
        for k in row {
            seen.push(k)
        }
    }
    // The root, before the reference starts.
    let steps = max(u32(f32(along) * s.span.x / max(s.span.y - s.span.x, 0.001)), 2)
    for i in 0..steps {
        let f = s.span.x * f32(i) / f32(steps)
        for k in first {
            let r = if based { k.r } else { k.r * mix(s.tuck, 1.0, smoothstep(0.0, s.span.x, f)) }
            seen.push(Sample { f, theta: k.theta, r })
        }
    }
    // Past the reference's end.
    if s.span.y < 0.999 {
        let more = max(u32(f32(along) * (1.0 - s.span.y) / max(s.span.y - s.span.x, 0.001)), 2)
        for i in 0..more {
            let f = s.span.y + (1.0 - s.span.y) * f32(i + 1) / f32(more)
            for k in last {
                seen.push(Sample { f, theta: k.theta, r: k.r })
            }
        }
    }
    let form: Radial<A, R> = chart::rounded(chart::fit(seen))
    let unseen = rays(t, path, s.span, along, about, vec2(0.5, 0.5), s.most)
    Fitted { form, miss: miss(base.plus(form), unseen, s.span, path.length()), rays: read }
}

/// `s`'s form fitted to reference `t`, over nothing.
pub fn fitted<const A: u32, const R: u32, T: Reference>(t: T, s: Spec) -> Fitted<A, R> {
    fitted_over(t, s, chart::round(0.0), false)
}

/// The reference body's left arm's triangles (its shoulder, arm and hand).
pub fn body_arm_left() -> targets::Triangles {
    triangles_of(
        HERO.clone(),
        [false, false, false, false, true, false],
        vec3(0.1, 1.2, -0.3),
        vec3(0.8, 1.7, 0.2),
    )
}

/// The species' arm, fitted.
pub fn arm() -> Fitted<16, 13> {
    fitted(body_arm_left(), ARM)
}

/// A character's limb kept where it is over a species' limb fitted again: what it's written as
/// over the species' limb as written (`over`, `was`), over the species' limb as it is now
/// (`now`). Forms about one path add, so no reference is read: the character's limb is the
/// same radius at every place, and only what it's a difference from has changed. Measured
/// against what its reference was found to be (`measured`, over `span` of the path).
pub fn kept_over<const A: u32, const R: u32>(
    s: Spec,
    over: Radial<A, R>,
    was: Radial<A, R>,
    now: Radial<A, R>,
    measured: [Sample],
) -> Fitted<A, R> {
    let form: Radial<A, R> = chart::rounded(over.plus(was).plus(now, by: -1.0))
    let whole = now.plus(form)
    Fitted {
        form,
        miss: miss(whole, measured, s.span, s.chain.rest().length()),
        rays: 0,
    }
}

/// What Hakuro's left arm is over the species' arm `base`: his arm as written, kept where it
/// is, and how far it is from his sampled arm's radii (`measured::ARM_LEFT`).
pub fn hakuro_arm_left(base: Radial<16, 13>) -> Fitted<16, 13> {
    kept_over(
        HAKURO_ARM_LEFT,
        hakuro::arm_left_form::ARM_LEFT_OVER,
        figure::arm::ARM,
        base,
        measured::samples(measured::ARM_LEFT),
    )
}

/// What Hakuro's right arm is over the species' arm `base` (the left's: mirrored here), kept
/// where it is, and how far it is from his sampled arm's radii (`measured::ARM_RIGHT`).
pub fn hakuro_arm_right(base: Radial<16, 13>) -> Fitted<16, 13> {
    kept_over(
        HAKURO_ARM_RIGHT,
        hakuro::arm_right_form::ARM_RIGHT_OVER,
        figure::arm::ARM.mirrored(),
        base.mirrored(),
        measured::samples(measured::ARM_RIGHT),
    )
}

/// The species' leg, fitted to the reference body's left leg's triangles.
pub fn leg() -> Fitted<16, 13> {
    fitted(
        triangles_of(
            HERO.clone(),
            [false, false, true, false, false, false],
            vec3(-9.0),
            vec3(9.0),
        ),
        LEG,
    )
}

/// What Hakuro's left leg is over the species' leg `base`, fitted.
pub fn hakuro_leg(base: Radial<16, 13>) -> Fitted<16, 13> {
    fitted_over(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_LEG, base, true)
}

/// Hakuro's trunk, fitted.
pub fn hakuro_trunk() -> Fitted<24, 21> {
    fitted(Grid { samples: hakuro::body_grid::samples(0) }, HAKURO_TRUNK)
}

/// Hakuro's jacket, fitted.
pub fn hakuro_jacket() -> Fitted<24, 21> {
