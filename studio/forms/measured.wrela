/// The radii as samples of a reference: each with its place on the chart.
pub fn samples(radii: [f32; 416]) -> Vec<Sample> {
    var out: Vec<Sample> = Vec::new()
    for i in 0..ALONG {
        let f = mix(SPAN.x, SPAN.y, (f32(i) + 0.5) / f32(ALONG))
        for j in 0..ROUND {
            let r = radii[i * ROUND + j]
            if r > 0.0 {
                out.push(Sample { f, theta: TAU * (f32(j) + 0.5) / f32(ROUND), r })
            }
        }
    }
    out
}

// His hands as his sampled grids had them, kept when the grids went (rywible/wrela#437 is the
// last revision that holds them, and the forms tool as it fitted his hands to them): each
// piece's radius about its own line at rest (m), read as the arms' are, on a grid of
// `HAND_ALONG` places along the piece's span by `HAND_ROUND` round it, each half a step on from
// the grid's own; 0 where a ray met no side within what the piece is read to, or looks away
// from the sides a thumb is read on. Each piece's form was fitted to the same grid at four
// times as many places; these are what the forms are measured against now (`tests`).

/// How many places a hand's piece's radii were read at along its span, and round its line.
pub const HAND_ALONG: u32 = 16
pub const HAND_ROUND: u32 = 13

/// The span of its line each piece's radii cover (his left's four fingers from his index, his
/// thumb, his palm; then his right's): a finger's from its knuckle, a thumb's from its root at
/// his wrist, a palm's from inside his wrap.
pub const HAND_SPANS: [vec2; 12] = [
    vec2(0.15, 0.88),
    vec2(0.15, 0.88),
    vec2(0.15, 0.88),
    vec2(0.15, 0.88),
    vec2(0.06, 0.90),
    vec2(0.04, 0.90),
    vec2(0.15, 0.88),
    vec2(0.15, 0.88),
    vec2(0.15, 0.88),
    vec2(0.15, 0.88),
    vec2(0.06, 0.90),
    vec2(0.04, 0.90),
]

