/// Piece `i` of his hands' radii as samples of a reference: each with its place on the chart.
pub fn hand_samples(i: u32) -> Vec<Sample> {
    var out: Vec<Sample> = Vec::new()
    let span = HAND_SPANS[i]
    for a in 0..HAND_ALONG {
        let f = mix(span.x, span.y, (f32(a) + 0.5) / f32(HAND_ALONG))
        for j in 0..HAND_ROUND {
            let r = HANDS[i][a * HAND_ROUND + j]
            if r > 0.0 {
                out.push(Sample { f, theta: TAU * (f32(j) + 0.5) / f32(HAND_ROUND), r })
            }
        }
    }
    out
}
