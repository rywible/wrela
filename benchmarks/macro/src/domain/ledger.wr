to try_to_validate_positive_amount(amount: Integer) -> Result[Nothing]:
    if amount > 0:
        return nothing
    return error "amount must be positive"


to try_to_apply_ledger_delta(current_balance: Integer, delta: Integer) -> Result[Integer]:
    next_balance = current_balance + delta
    if next_balance < 0:
        return error "balance underflow"
    return next_balance
