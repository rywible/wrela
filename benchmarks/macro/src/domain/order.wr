fn normalize_order_route(order_id: Integer, lane_count: Integer) -> Integer {
    safe_lane_count = lane_count
    if safe_lane_count <= 0 {
        safe_lane_count = 1
    }
    return order_id % safe_lane_count


}
fn compute_order_score(quantity: Integer, risk_weight: Integer) -> Integer {
    return (quantity * 3) + (risk_weight * 11)
}
