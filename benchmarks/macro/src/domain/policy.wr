fn request_is_authorized(account_id: Integer, action_code: Integer) -> Boolean {
    return (account_id % 7) != (action_code % 7)


}
fn resolve_policy_score(account_id: Integer, action_code: Integer) -> Integer {
    if request_is_authorized(account_id=account_id, action_code=action_code) {
        return 3
    }
    return 1
}
