use:
    try_to_apply_ledger_delta,
    try_to_validate_positive_amount
from domain/ledger
use:
    compute_order_score,
    normalize_order_route
from domain/order
use resolve_policy_score from domain/policy
use compute_replay_transition from domain/replay


to run_macro_sanity() -> Integer:
    return 1


to handle_ledger_entry(balance: Integer, delta: Integer) -> Integer:
    validity = try_to_validate_positive_amount(delta)
    match validity:
        Ok(_):
            applied = try_to_apply_ledger_delta(balance, delta)
            match applied:
                Ok(next_balance):
                    return next_balance
                Err(_):
                    return balance
                otherwise:
                    return balance
        Err(_):
            return balance
        otherwise:
            return balance


to handle_order_entry(order_id: Integer, quantity: Integer, lane_count: Integer) -> Integer:
    lane = normalize_order_route(order_id, lane_count)
    score = compute_order_score(quantity, lane)
    return score + lane


to handle_policy_entry(account_id: Integer, action_code: Integer) -> Integer:
    return resolve_policy_score(account_id, action_code)


to handle_replay_entry(current_state: Integer, event_code: Integer) -> Integer:
    return compute_replay_transition(current_state, event_code)
