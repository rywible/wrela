fn update_scene_checksum(current: Integer, value: Integer) -> Integer {
    return ((current * 41) + value) % 2147483647
}

field conservative distance dense_constructive_shell(p: Vec3) -> F32 {
    loft = f32(0.92) {
        from rounded_rect2(half = vec2(0.34, 0.22), radius = 0.10)
        to rounded_rect2(half = vec2(0.48, 0.30), radius = 0.12)
    }
}

field conservative distance dense_constructive_bridge(p: Vec3) -> F32 {
    translate = vec3(0.34, 0.18, 0.0) {
        extrude = f32(0.12) {
            rounded_rect2(half = vec2(0.28, 0.06), radius = 0.03)
        }
    }
}

field conservative distance dense_constructive_cap(p: Vec3) -> F32 {
    displace = vec3(0.02, 0.0, 0.0) {
        extrude = f32(0.20) {
            rounded_rect2(half = vec2(0.22, 0.12), radius = 0.05)
        }
    }
}

field conservative distance dense_constructive_field(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use dense_constructive_shell
        use dense_constructive_bridge
        use dense_constructive_cap
    }
}

field conservative distance repetition_cell(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.0, 0.0) {
        extrude = f32(0.16) {
            rounded_rect2(half = vec2(0.12, 0.06), radius = 0.02)
        }
    }
}

field conservative distance repetition_row(p: Vec3) -> F32 {
    repeat_linear = vec3(0.78, 0.0, 0.0) {
        use repetition_cell
    }
}

field conservative distance repeat_linear_solver_field(p: Vec3) -> F32 {
    repeat_linear = vec3(12.0, 0.0, 0.0) {
        translate = vec3(6.0, 0.0, 0.0) {
            sphere(radius = 0.18)
        }
    }
}

field conservative distance repetition_field(p: Vec3) -> F32 {
    instance_array = Transform3(
        matrix=mat4_cols(
            vec4(1.0, 0.0, 0.0, 0.0),
            vec4(0.0, 1.0, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(1.08, 0.0, 0.0, 1.0)
        ),
        inverse=mat4_cols(
            vec4(1.0, 0.0, 0.0, 0.0),
            vec4(0.0, 1.0, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(-1.08, 0.0, 0.0, 1.0)
        )
    ) {
        repeat_linear = vec3(0.0, 0.62, 0.0) {
            use repetition_row
        }
    }
}

field conservative distance thin_stack_plate(p: Vec3) -> F32 {
    sweep = vec3(0.0, 0.90, 0.0) {
        rect2(half = vec2(0.05, 0.14))
    }
}

field conservative distance thin_stack_layer_a(p: Vec3) -> F32 {
    translate = vec3(0.06, 0.00, 0.0) {
        use thin_stack_plate
    }
}

field conservative distance thin_stack_layer_b(p: Vec3) -> F32 {
    translate = vec3(-0.04, 0.05, 0.0) {
        use thin_stack_plate
    }
}

field conservative distance thin_stack_edge(p: Vec3) -> F32 {
    translate = vec3(0.0, -0.02, 0.0) {
        extrude = f32(0.08) {
            rounded_rect2(half = vec2(0.22, 0.09), radius = 0.02)
        }
    }
}

field conservative distance thin_stack_field(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use thin_stack_layer_a
        use thin_stack_layer_b
        use thin_stack_edge
    }
}

field exact distance media_core(p: Vec3) -> F32 {
    sphere(radius = 0.72)
}

field exact distance relaxed_torus_field(p: Vec3) -> F32 {
    torus(major_radius = 0.72, minor_radius = 0.22)
}

field conservative distance media_shell(p: Vec3) -> F32 {
    translate = vec3(0.0, -0.16, 0.0) {
        loft = f32(0.76) {
            from rounded_rect2(half = vec2(0.16, 0.12), radius = 0.04)
            to rounded_rect2(half = vec2(0.28, 0.20), radius = 0.06)
        }
    }
}

field conservative distance media_field(p: Vec3) -> F32 {
    smooth_union {
        smoothing = f32(0.10)
        use media_core
        use media_shell
    }
}

field conservative distance transformed_gallery_sphere(p: Vec3) -> F32 {
