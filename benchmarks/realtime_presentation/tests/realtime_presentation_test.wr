fn test_realtime_presentation_media_radiance_scene_ops_256() -> Nothing {
    media_scene = capture media_region
    domain = media_domain(world = media_scene)
    probe = vec3(0.0, 0.02, 0.84)
    coarse_distance = spatial.distance(capture=media_scene, domain=domain, point=probe)
    fine_hit = spatial.nearest(
        capture=media_scene,
        domain=domain,
        ray=ray_query(
            origin=vec3(0.0, 0.0, 3.0),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=12.0,
            min_step=0.04,
            hit_epsilon=0.001,
            max_steps=128
        )
    )
    fine_surface = surface.sample(capture=media_scene, domain=domain, hit=fine_hit)
    fine_radiance = participants.radiance(
        capture=media_scene,
        domain=domain,
        sample=point_direction_query(
            point=fine_hit.position,
            direction=normalize(vec3(0.0, 1.0, 1.0))
        )
    )
    fine_medium = participants.medium(capture=media_scene, domain=domain, point=fine_hit.position)

    media_signal = i32(abs(coarse_distance) * 100.0)
        + i32(fine_surface.clearcoat * 100.0)
        + i32(fine_radiance.z * 10.0)
        + i32(fine_medium.density * 1000.0)

    mutable rays = []
    mutable points = []
    for i in 1...257 {
        px = f32(i % 16) / 15.0 - 0.5
        py = f32((i / 16) % 16) / 15.0 - 0.5
        origin = vec3(px * 1.2, py * 1.0, 3.0)
        __wr_list_push(
            rays,
            ray_query(
                origin=origin,
                direction=normalize(vec3(-px * 0.08, -py * 0.08, -1.0)),
                max_distance=12.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=128
            )
        )
        __wr_list_push(
            points,
            PointQuery(point=origin + vec3(0.0, 0.0, -1.0))
        )
    }

    hits = spatial.nearest_batch(
        capture=media_scene,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    normals = spatial.normal_batch(
        capture=media_scene,
        domain=domain,
        points=points,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    for sample_i in 0...64 {
        sample_index = sample_i * 4
        hit = hits[sample_index]
        normal = normals[sample_index].normal
        if hit.hit {
            hit_count += 1
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
    }

    require hit_count > 0 else "media radiance hits present"
    require media_signal != 0 else "media radiance signal nonzero"
    require checksum != 0 else "media radiance checksum nonzero"
}

