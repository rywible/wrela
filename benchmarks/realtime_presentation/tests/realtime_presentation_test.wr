fn compute_closure_camera_motion_offset(frame: Integer) -> Vec3 {
    return vec3(
        f32(frame) * 0.02,
        f32(frame % 3) * 0.01,
        f32(frame % 2) * -0.015
    )
}

fn compute_cache_stress_motion_offset(frame: Integer) -> Vec3 {
    return vec3(
        f32(frame % 7) * 0.035 - 0.105,
        f32((frame / 7) % 5) * 0.018 - 0.036,
        f32(frame % 3) * -0.020
    )
}

view show_dense_constructive_1080p120_closure_view(
    world: RegionCapture,
    camera: Camera
) {
    domain = dense_constructive_domain(world = world)
    viewport = viewport(width = 1920, height = 1080)
    quality = realtime_quality(
        target_fps = 120,
        allow_dynamic_resolution = false,
        primary_max_steps = 96
    )
    lighting = key_light(
        light = Light(
            position=vec3(-1.6, 2.8, 2.6),
            direction=normalize(vec3(-0.86, -0.82, -0.78)),
            intensity=vec3(1.0, 0.98, 0.95),
            range=14.0
        ),
        fill_direction = normalize(vec3(-0.44, 0.38, 0.20))
    )
    outputs = frame_outputs(color = true, depth = true, normal = true, motion = true)
    history = temporal_history(color = true)
}

