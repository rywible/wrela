view show_dense_constructive_view(
    world: RegionCapture,
    camera: Camera
) {
    domain = dense_constructive_domain(world = world)
    viewport = viewport(width = 6, height = 6)
    quality = realtime_quality(target_fps = 60)
    lighting = key_light(
        light = Light(
            position=vec3(-1.8, 3.0, 2.8),
            direction=normalize(vec3(-0.9, -0.85, -0.8)),
            intensity=vec3(1.0, 0.98, 0.96),
            range=14.0
        ),
        fill_direction = normalize(vec3(-0.5, 0.42, 0.25))
    )
    outputs = frame_outputs(color = true, depth = true, normal = true, motion = true)
    history = temporal_history(color = true)
}

