fn test_realtime_presentation_dense_constructive_geometry_ops_256() -> Nothing {
    world = capture dense_constructive_region
    domain = dense_constructive_domain(world = world)
    mutable rays = []
    mutable points = []
    for i in 1...257 {
        px = f32(i % 16) / 15.0 - 0.5
        py = f32((i / 16) % 16) / 15.0 - 0.5
        origin = vec3(px * 1.4, py * 1.2, 3.4)
        __wr_list_push(
            rays,
            ray_query(
                origin=origin,
                direction=normalize(vec3(-px * 0.10, -py * 0.10, -1.0)),
                max_distance=14.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=128
            )
        )
        __wr_list_push(
            points,
            PointQuery(point=origin + vec3(0.0, 0.0, -1.0))
        )
    }

    hits = spatial.nearest_batch(
        capture=world,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    normals = spatial.normal_batch(
        capture=world,
        domain=domain,
        points=points,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    mutable miss_count = 0
    for sample_i in 0...64 {
        sample_index = sample_i * 4
        hit = hits[sample_index]
        normal = normals[sample_index].normal
        if hit.hit {
            hit_count += 1
        } else {
            miss_count += 1
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
    }

    require hit_count > 0 else "dense constructive hits present"
    require miss_count > 0 else "dense constructive misses present"
    require checksum != 0 else "dense constructive checksum nonzero"
}

fn test_realtime_presentation_repetition_heavy_scene_ops_512() -> Nothing {
    repeat_scene = capture repetition_region
    repeat_scene_again = capture repetition_region
    repeat_shape = capture repetition_shape
    domain = repetition_domain(world = repeat_scene)
    require repeat_scene.scene_id == repeat_scene_again.scene_id else "repeat scene_id stable"
    require repeat_scene.root_feature_id == repeat_scene_again.root_feature_id else "repeat root_feature_id stable"

    mutable rays = []
    for i in 1...513 {
        px = f32(i % 24) * 0.20 - 2.3
        py = f32((i / 24) % 8) * 0.11 - 0.24
        __wr_list_push(
            rays,
            ray_query(
                origin=vec3(px, py, 2.8),
                direction=vec3(0.0, 0.0, -1.0),
                max_distance=12.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=128
            )
        )
    }

    hits = spatial.nearest_batch(
        capture=repeat_scene,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    mutable repeat_identity_checksum = 0
    for sample_i in 0...64 {
        sample_index = sample_i * 8
        hit = hits[sample_index]
        if hit.hit {
            hit_count += 1
            if sample_i < 16 {
                repeat_identity_checksum = update_scene_checksum(
                    current=repeat_identity_checksum,
                    value=i32(hit.repeat_id % u32(23)) + i32(hit.instance_id % u32(29))
                )
            }
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(hit.repeat_id % u32(17))
                + i32(hit.instance_id % u32(19))
        )
    }

    mutable comparison_rays = []
    for sample_i in 0...64 {
        py = f32(sample_i % 8) * 0.08 - 0.28
        pz = f32(sample_i / 8) * 0.03 - 0.105
        __wr_list_push(
            comparison_rays,
            ray_query(
                origin=vec3(-6.0, py, pz),
                direction=vec3(1.0, 0.0, 0.0),
                max_distance=12.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=128
            )
        )
    }

    world_hit_count_before = __wr_metrics_get(__wr_metrics_scene_trace_hit_count_id())
    world_hit_steps_before = __wr_metrics_get(__wr_metrics_scene_trace_hit_steps_total_id())
    world_field_samples_before = __wr_metrics_get(__wr_metrics_scene_trace_hit_field_samples_total_id())
    comparison_hits = spatial.nearest_batch(
        capture=repeat_scene,
        domain=domain,
        rays=comparison_rays,
        backend=dispatch_backend_cpu()
    )
    world_hit_count_after = __wr_metrics_get(__wr_metrics_scene_trace_hit_count_id())
    world_hit_steps_after = __wr_metrics_get(__wr_metrics_scene_trace_hit_steps_total_id())
    world_field_samples_after = __wr_metrics_get(__wr_metrics_scene_trace_hit_field_samples_total_id())

    dense_hit_count_before = __wr_metrics_get(__wr_metrics_scene_trace_hit_count_id())
    dense_hit_steps_before = __wr_metrics_get(__wr_metrics_scene_trace_hit_steps_total_id())
    dense_field_samples_before = __wr_metrics_get(__wr_metrics_scene_trace_hit_field_samples_total_id())
    mutable dense_hit_count = 0
    for sample_i in 0...64 {
        ray = comparison_rays[sample_i]
        world_hit = comparison_hits[sample_i]
        dense_hit = trace_shape(capture=repeat_shape, ray=ray)
        require world_hit.hit == dense_hit.hit else "repeat-aware hit parity"
        if world_hit.hit {
            dense_hit_count += 1
            require abs(world_hit.distance - dense_hit.distance) < 0.02 else "repeat-aware distance parity"
            require world_hit.repeat_id == dense_hit.repeat_id else "repeat-aware repeat_id parity"
            require world_hit.instance_id == dense_hit.instance_id else "repeat-aware instance_id parity"
        }
    }
    dense_hit_count_after = __wr_metrics_get(__wr_metrics_scene_trace_hit_count_id())
    dense_hit_steps_after = __wr_metrics_get(__wr_metrics_scene_trace_hit_steps_total_id())
    dense_field_samples_after = __wr_metrics_get(__wr_metrics_scene_trace_hit_field_samples_total_id())

    require hit_count > 0 else "repeat-heavy hits present"
    require world_hit_count_after - world_hit_count_before == dense_hit_count else "repeat-aware comparison hit count stable"
    require dense_hit_count_after - dense_hit_count_before == dense_hit_count else "repeat-aware dense hit count stable"
    require repeat_identity_checksum != 0 else "repeat-heavy repeat identity checksum nonzero"
    require checksum != 0 else "repeat-heavy checksum nonzero"
}

