fn test_realtime_presentation_camera_motion_temporal_reuse_clipmap_churn_1080p120_closure_ops_320() -> Nothing {
    media_scene = capture media_region
    domain = media_domain(world = media_scene)
    anchor_hit = spatial.nearest(
        capture=media_scene,
        domain=domain,
        ray=ray_query(
            origin=vec3(0.0, 0.0, 3.0) + compute_closure_camera_motion_offset(1),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=12.0,
            min_step=0.04,
            hit_epsilon=0.001,
            max_steps=96
        )
    )
    anchor_radiance = participants.radiance(
        capture=media_scene,
        domain=domain,
        sample=point_direction_query(
            point=anchor_hit.position,
            direction=normalize(vec3(0.0, 1.0, 1.0))
        )
    )
    anchor_medium = participants.medium(
        capture=media_scene,
        domain=domain,
        point=anchor_hit.position
    )

    mutable rays = []
    mutable points = []
    for i in 1...321 {
        px = f32(i % 16) / 15.0 - 0.5
        py = f32((i / 16) % 16) / 15.0 - 0.5
        motion = compute_closure_camera_motion_offset(i) + compute_cache_stress_motion_offset(i)
        origin = vec3(px * 1.2, py * 1.0, 3.0) + motion
        __wr_list_push(
            rays,
            ray_query(
                origin=origin,
                direction=normalize(vec3(-px * 0.08, -py * 0.08, -1.0)),
                max_distance=12.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=96
            )
        )
        __wr_list_push(
            points,
            PointQuery(point=origin + vec3(0.0, 0.0, -0.8))
        )
    }

    hits = spatial.nearest_batch(
        capture=media_scene,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    normals = spatial.normal_batch(
        capture=media_scene,
        domain=domain,
        points=points,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    mutable churn_signal = 0
    for sample_i in 0...40 {
        sample_index = sample_i * 8
        hit = hits[sample_index]
        normal = normals[sample_index].normal
        if hit.hit {
            hit_count += 1
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
        churn_signal = update_scene_checksum(
            current=churn_signal,
            value=i32(sample_i + 1)
                + i32(hit.steps)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
    }

    require anchor_hit.hit == true else "camera-motion closure anchor hit present"
    require anchor_radiance.z > anchor_radiance.x else "camera-motion closure radiance gradient present"
    require anchor_medium.density > 0.0 else "camera-motion closure medium density present"
    require hit_count > 0 else "camera-motion closure hits present"
    require churn_signal != 0 else "camera-motion closure churn signal nonzero"
    require checksum != 0 else "camera-motion closure checksum nonzero"
}
