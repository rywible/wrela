            intensity=vec3(1.0, 0.96, 0.91),
            range=12.0
        ),
        fill_direction = normalize(vec3(-0.38, 0.33, 0.18))
    )
    outputs = frame_outputs(color = true, depth = true, normal = true, motion = true)
    history = temporal_history(color = true)
}

view show_camera_motion_temporal_reuse_clipmap_churn_1080p120_closure_view(
    world: RegionCapture,
    camera: Camera
) {
    domain = media_domain(world = world)
    viewport = viewport(width = 1920, height = 1080)
    quality = realtime_quality(
        target_fps = 120,
        allow_dynamic_resolution = false,
        primary_max_steps = 96,
        allow_media = true
    )
    lighting = key_light(
        light = Light(
            position=vec3(-1.45, 2.95, 2.95),
            direction=normalize(vec3(-0.82, -0.78, -0.74)),
            intensity=vec3(1.0, 0.98, 0.96),
            range=12.0
        ),
        fill_direction = normalize(vec3(-0.40, 0.34, 0.18))
    )
    outputs = frame_outputs(color = true, depth = true, normal = true, motion = true)
    history = temporal_history(color = true)
}

fn test_realtime_presentation_dense_constructive_1080p120_closure_ops_256() -> Nothing {
    world = capture dense_constructive_region
    domain = dense_constructive_domain(world = world)
    mutable rays = []
    mutable points = []
    for i in 1...257 {
        px = f32(i % 16) / 15.0 - 0.5
        py = f32((i / 16) % 16) / 15.0 - 0.5
        motion = compute_closure_camera_motion_offset(i)
        origin = vec3(px * 1.4, py * 1.2, 3.4) + motion
        __wr_list_push(
            rays,
            ray_query(
                origin=origin,
                direction=normalize(vec3(-px * 0.10, -py * 0.10, -1.0)),
                max_distance=14.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=96
            )
        )
        __wr_list_push(
            points,
            PointQuery(point=origin + vec3(0.0, 0.0, -1.0))
        )
    }

    hits = spatial.nearest_batch(
        capture=world,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    normals = spatial.normal_batch(
        capture=world,
        domain=domain,
        points=points,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    mutable miss_count = 0
    for sample_i in 0...64 {
        sample_index = sample_i * 4
        hit = hits[sample_index]
        normal = normals[sample_index].normal
        if hit.hit {
            hit_count += 1
        } else {
            miss_count += 1
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
    }

    require hit_count > 0 else "dense constructive closure hits present"
    require miss_count > 0 else "dense constructive closure misses present"
    require checksum != 0 else "dense constructive closure checksum nonzero"
}

fn test_realtime_presentation_media_radiance_1080p120_closure_ops_256() -> Nothing {
    media_scene = capture media_region
    domain = media_domain(world = media_scene)
    probe = vec3(0.0, 0.02, 0.84)
    coarse_distance = spatial.distance(capture=media_scene, domain=domain, point=probe)
    fine_hit = spatial.nearest(
        capture=media_scene,
        domain=domain,
        ray=ray_query(
            origin=vec3(0.0, 0.0, 3.0) + compute_closure_camera_motion_offset(1),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=12.0,
            min_step=0.04,
            hit_epsilon=0.001,
            max_steps=96
        )
    )
    fine_surface = surface.sample(capture=media_scene, domain=domain, hit=fine_hit)
    fine_radiance = participants.radiance(
        capture=media_scene,
        domain=domain,
        sample=point_direction_query(
            point=fine_hit.position,
            direction=normalize(vec3(0.0, 1.0, 1.0))
        )
    )
    fine_medium = participants.medium(capture=media_scene, domain=domain, point=fine_hit.position)

    media_signal = i32(abs(coarse_distance) * 100.0)
        + i32(fine_surface.clearcoat * 100.0)
        + i32(fine_radiance.z * 10.0)
        + i32(fine_medium.density * 1000.0)

    mutable rays = []
    mutable points = []
    for i in 1...257 {
        px = f32(i % 16) / 15.0 - 0.5
        py = f32((i / 16) % 16) / 15.0 - 0.5
        motion = compute_closure_camera_motion_offset(i)
        origin = vec3(px * 1.2, py * 1.0, 3.0) + motion
        __wr_list_push(
            rays,
            ray_query(
                origin=origin,
                direction=normalize(vec3(-px * 0.08, -py * 0.08, -1.0)),
                max_distance=12.0,
                min_step=0.04,
                hit_epsilon=0.001,
                max_steps=96
            )
        )
        __wr_list_push(
            points,
            PointQuery(point=origin + vec3(0.0, 0.0, -1.0))
        )
    }

    hits = spatial.nearest_batch(
        capture=media_scene,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    normals = spatial.normal_batch(
        capture=media_scene,
        domain=domain,
        points=points,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    for sample_i in 0...64 {
        sample_index = sample_i * 4
        hit = hits[sample_index]
        normal = normals[sample_index].normal
        if hit.hit {
            hit_count += 1
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
    }

    require hit_count > 0 else "media radiance closure hits present"
    require media_signal != 0 else "media radiance closure signal nonzero"
    require checksum != 0 else "media radiance closure checksum nonzero"
}

fn test_realtime_presentation_transformed_primitive_gallery_1080p120_closure_ops_288() -> Nothing {
    gallery_scene = capture transformed_gallery_region
    domain = transformed_gallery_domain(world = gallery_scene)
    anchor_hit = spatial.nearest(
        capture=gallery_scene,
        domain=domain,
        ray=ray_query(
            origin=vec3(-0.54, 0.10, 2.8),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=10.0,
            min_step=0.03,
            hit_epsilon=0.001,
            max_steps=96
        )
    )
    anchor_surface = surface.sample(capture=gallery_scene, domain=domain, hit=anchor_hit)

    mutable rays = []
    mutable points = []
    for i in 1...289 {
        branch = i % 3
        motion = compute_closure_camera_motion_offset(i)
        mutable origin = vec3(0.0, 0.0, 2.8)
        if branch == 0 {
            origin = vec3(-0.54, 0.10, 2.8) + motion
        } else if branch == 1 {
            origin = vec3(0.38, -0.08, 2.8) + motion
        } else {
            origin = vec3(0.02, 0.42, 2.8) + motion
        }
        __wr_list_push(
            rays,
            ray_query(
                origin=origin,
                direction=vec3(0.0, 0.0, -1.0),
                max_distance=10.0,
                min_step=0.03,
                hit_epsilon=0.001,
                max_steps=96
            )
        )
        __wr_list_push(
            points,
            PointQuery(point=origin + vec3(0.0, 0.0, -0.4))
        )
    }

    hits = spatial.nearest_batch(
        capture=gallery_scene,
        domain=domain,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    normals = spatial.normal_batch(
        capture=gallery_scene,
        domain=domain,
        points=points,
        backend=dispatch_backend_cpu()
    )

    mutable checksum = 0
    mutable hit_count = 0
    mutable gallery_signal = i32(anchor_surface.albedo.x + anchor_surface.albedo.y)
    for sample_index in 0...288 {
        hit = hits[sample_index]
        normal = normals[sample_index].normal
        if hit.hit {
            hit_count += 1
        }
        checksum = update_scene_checksum(
            current=checksum,
            value=i32(hit.steps)
                + i32(abs(hit.distance) * 100.0)
                + i32(abs(normal.x + normal.y + normal.z) * 100.0)
        )
        gallery_signal = update_scene_checksum(
            current=gallery_signal,
            value=i32(hit.feature_id % u32(29)) + i32(hit.instance_id % u32(31))
        )
    }

    require anchor_hit.hit == true else "transformed gallery anchor hit"
    require hit_count > 0 else "transformed gallery closure hits present"
    require gallery_signal != 0 else "transformed gallery closure signal nonzero"
    require checksum != 0 else "transformed gallery closure checksum nonzero"
}

