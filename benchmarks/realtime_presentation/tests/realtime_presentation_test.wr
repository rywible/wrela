field conservative distance mixed_opaque_conservative_core(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        translate = vec3(-0.58, 0.0, 0.0) {
            use dense_constructive_field
        }
        translate = vec3(0.34, 0.04, 0.0) {
            use thin_stack_field
        }
    }
}

field conservative distance mixed_opaque_conservative_guard(p: Vec3) -> F32 {
    support = Support3(bounds=Bounds3(
        min=vec3(1.30, -0.95, -0.70),
        max=vec3(2.70, 0.95, 0.70)
    ))
    bounds = Bounds3(
        min=vec3(1.30, -0.95, -0.70),
        max=vec3(2.70, 0.95, 0.70)
    )
    return length(p - vec3(2.00, 0.0, 0.0)) - 0.42
}

field conservative distance mixed_opaque_conservative_field(p: Vec3) -> F32 {
    support = Support3(bounds=Bounds3(
        min=vec3(1.30, -0.95, -0.70),
        max=vec3(2.70, 0.95, 0.70)
    ))
    bounds = Bounds3(
        min=vec3(1.30, -0.95, -0.70),
        max=vec3(2.70, 0.95, 0.70)
    )
    union {
        provenance_policy = nearest
        use mixed_opaque_conservative_core
        use mixed_opaque_conservative_guard
    }
}

material dense_constructive_surface(hit: Hit3) -> Surface {
    contour = clamp(abs(hit.local_position.x) * 0.32 + abs(hit.local_normal.y) * 0.24, 0.0, 1.0)
    return Surface(
        albedo=vec3(148.0, 104.0, 184.0) + vec3(18.0, 16.0, 20.0) * contour,
        roughness=0.16 + contour * 0.20,
        metalness=0.08 + abs(hit.local_normal.x) * 0.10,
        clearcoat=0.14 + abs(hit.local_normal.z) * 0.12,
        clearcoat_roughness=0.08 + abs(hit.local_position.y) * 0.10,
        sheen=0.10 + contour * 0.08,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material repetition_surface(hit: Hit3) -> Surface {
    rib = clamp(abs(hit.local_position.x) * 0.28 + abs(hit.local_position.y) * 0.22, 0.0, 1.0)
    return Surface(
        albedo=vec3(104.0, 156.0, 132.0) + vec3(14.0, 12.0, 16.0) * rib,
        roughness=0.18 + rib * 0.16,
        metalness=0.10 + abs(hit.local_normal.z) * 0.10,
        clearcoat=0.10 + abs(hit.local_normal.y) * 0.12,
        clearcoat_roughness=0.08 + abs(hit.local_position.x) * 0.08,
        sheen=0.06 + abs(hit.local_normal.x) * 0.10,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material relaxed_torus_surface(hit: Hit3) -> Surface {
    rib = clamp(abs(hit.local_position.x) * 0.30 + abs(hit.local_normal.y) * 0.20, 0.0, 1.0)
    return Surface(
        albedo=vec3(126.0, 154.0, 202.0) + vec3(12.0, 10.0, 8.0) * rib,
        roughness=0.20 + rib * 0.15,
        metalness=0.10,
        clearcoat=0.08,
        clearcoat_roughness=0.06,
        sheen=0.04,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material thin_stack_surface(hit: Hit3) -> Surface {
    edge = clamp(abs(hit.local_position.z) * 0.52 + abs(hit.local_normal.x) * 0.30, 0.0, 1.0)
    return Surface(
        albedo=vec3(116.0, 142.0, 196.0) + vec3(16.0, 12.0, 18.0) * edge,
        roughness=0.14 + edge * 0.18,
        metalness=0.10 + edge * 0.12,
        clearcoat=0.12 + abs(hit.local_normal.y) * 0.14,
        clearcoat_roughness=0.08 + abs(hit.local_position.x) * 0.06,
        sheen=0.08 + abs(hit.local_normal.z) * 0.12,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material media_surface(hit: Hit3) -> Surface {
    crest = clamp(0.48 + hit.local_position.y * 0.38 + abs(hit.local_normal.x) * 0.16, 0.0, 1.0)
    return Surface(
        albedo=vec3(94.0, 118.0, 176.0) + vec3(12.0, 18.0, 24.0) * crest,
        roughness=0.12 + abs(hit.local_position.z) * 0.10,
        metalness=0.12 + crest * 0.10,
        clearcoat=0.16 + crest * 0.16,
        clearcoat_roughness=0.10 + (1.0 - crest) * 0.12,
        sheen=0.08 + abs(hit.local_normal.y) * 0.14,
        emissive=vec3(1.4, 1.8, 2.8) * clamp(hit.local_normal.y, 0.0, 1.0)
    )
}

material transformed_gallery_surface(hit: Hit3) -> Surface {
    stripe = clamp(abs(hit.local_position.x) * 0.40 + abs(hit.local_normal.z) * 0.24, 0.0, 1.0)
    return Surface(
        albedo=vec3(188.0, 132.0, 108.0) + vec3(14.0, 12.0, 10.0) * stripe,
        roughness=0.16 + stripe * 0.16,
        metalness=0.10 + abs(hit.local_normal.y) * 0.12,
        clearcoat=0.10 + abs(hit.local_normal.x) * 0.12,
        clearcoat_roughness=0.08 + abs(hit.local_position.y) * 0.08,
        sheen=0.08 + abs(hit.local_normal.z) * 0.10,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material mixed_opaque_conservative_surface(hit: Hit3) -> Surface {
    guard = clamp(abs(hit.local_position.x) * 0.22 + abs(hit.local_normal.y) * 0.26, 0.0, 1.0)
    return Surface(
        albedo=vec3(132.0, 146.0, 164.0) + vec3(10.0, 12.0, 14.0) * guard,
        roughness=0.14 + guard * 0.18,
        metalness=0.08 + abs(hit.local_normal.x) * 0.14,
        clearcoat=0.12 + abs(hit.local_normal.z) * 0.10,
        clearcoat_roughness=0.08 + abs(hit.local_position.x) * 0.08,
        sheen=0.06 + abs(hit.local_normal.y) * 0.10,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

radiance field media_radiance(p: Vec3, direction: Vec3, feature_id: U32) -> Vec3 {
    sky_t = clamp(0.5 + direction.y * 0.5, 0.0, 1.0)
    halo = clamp(0.24 - abs(p.y + 0.08) * 0.12 - abs(p.x) * 0.05, 0.0, 0.24) / 0.24
    return vec3(7.0, 10.0, 16.0) * (1.0 - sky_t)
        + vec3(52.0, 78.0, 128.0) * sky_t
        + vec3(5.0, 7.0, 9.0) * halo
}

volume field media_volume(p: Vec3, surface_distance: F32) -> Medium {
    band = clamp((0.68 - abs(p.y)) * 0.78, 0.0, 0.68) / 0.68
    near_surface = clamp((0.16 - abs(surface_distance)) * 5.5, 0.0, 1.0)
    density = clamp(0.012 + band * 0.020 + near_surface * 0.016, 0.0, 0.09)
    return Medium(
        density=density,
        emission=vec3(2.0, 2.8, 4.4) * density + vec3(0.0, 0.01, 0.02) * near_surface,
        anisotropy=0.12
    )
}

