/// The parts of a replica of the sculpt as lofts: a loft per part, on a straight axis inside
/// the sculpt. The rump has a cleft on the midline under the tail, so the torso stops before it
/// and a buttock on each side goes on, and the tail's root runs back along the top (below a
/// crease on its crest) before it turns down. A fore paw's inner and outer toes have parts of
/// their own: from the paw's axis, the clefts between the toes (up to 1.7 cm high) hide their
/// pads. Neighbouring parts overlap at each joint (each part is inside the sculpt, so overlap
/// costs nothing), so no wedge at a bend is left out of both.
///
/// Stations every 1.5 cm (1 cm gained nothing measurable, and its tables were at the size where
/// building the creature overflows the CPU's 8 MiB stack); each axis runs on 2 cm past its ends,
/// and where an end is inside another part, the part sinks by up to 2 mm toward its cap there,
/// so it passes under its neighbour before it ends (where it ended proud of it, the lens drew a
/// line).
pub const LOFTS: Parts = Parts {
    name: "wolf/lofts",
    sculpt: SCULPT,
    spacing: 0.015,
    overlap: 0.02,
    taper: 0.002,
    landmarks: Vec::from(LANDMARKS),
    parts: Vec::from(
        [
            Part {
                name: "torso",
                from: Point::At(CHEST),
                to: Point::At(RUMP),
                angles: Some(64),
                r_max: Some(0.22),
            },
            Part {
                name: "neck",
                from: Point::At(NECK_BASE),
                to: Point::At(SKULL),
                parent: "torso",
                angles: Some(64),
                r_max: Some(0.25),
            },
            Part {
                name: "head",
                from: Point::At(OCCIPUT),
                to: Point::At(NOSE),
                parent: "neck",
                angles: Some(64),
                r_max: Some(0.14),
            },
            // The chin's tip and the buttocks' backs are round: at 1.5 cm, the straight line from a
            // section to the small one where the axis leaves the sculpt cut their corners (the
            // buttocks' by up to 2 cm, leaving a slit under the tail you could see through).
            Part {
                name: "jaw",
                from: Point::At(JAW),
                to: Point::At(CHIN),
                parent: "head",
                spacing: Some(0.005),
                angles: Some(32),
                r_max: Some(0.05),
            },
            Part {
                name: "ear left",
                from: Point::At(EAR_LEFT),
                to: Point::At(EAR_TIP_LEFT),
                parent: "head",
                angles: Some(64),
                r_max: Some(0.05),
            },
            Part {
                name: "ear right",
                from: Point::At(EAR_RIGHT),
                to: Point::At(EAR_TIP_RIGHT),
                parent: "head",
                angles: Some(64),
                r_max: Some(0.05),
            },
            Part {
                name: "sheath",
                from: Point::At(SHEATH),
                to: Point::At(SHEATH_TIP),
                parent: "torso",
                angles: Some(32),
                r_max: Some(0.04),
            },
            Part {
                name: "buttock left",
                from: Point::At(HAUNCH_LEFT),
                to: Point::At(SEAT_LEFT),
                parent: "torso",
                spacing: Some(0.006),
                angles: Some(48),
                r_max: Some(0.12),
            },
            Part {
                name: "buttock right",
                from: Point::At(HAUNCH_RIGHT),
                to: Point::At(SEAT_RIGHT),
                parent: "torso",
                spacing: Some(0.006),
                angles: Some(48),
                r_max: Some(0.12),
            },
            Part {
                name: "tail root",
                from: Point::At(TAIL_ROOT),
                to: Point::At(TAIL_TOP),
                parent: "torso",
                angles: Some(32),
                r_max: Some(0.08),
            },
            Part {
                name: "tail upper",
                from: Point::At(TAIL_TOP),
                to: Point::At(TAIL_BEND),
                parent: "tail root",
                angles: Some(32),
                r_max: Some(0.08),
            },
            Part {
                name: "tail",
                from: Point::At(TAIL_BEND),
                to: Point::At(TAIL_TIP),
                parent: "tail upper",
                angles: Some(32),
                r_max: Some(0.08),
            },
            Part {
                name: "forearm left",
                from: Point::At(ELBOW_LEFT),
                to: Point::At(CARPUS_LEFT),
                parent: "torso",
                angles: Some(32),
                r_max: Some(0.1),
            },
            Part {
                name: "pastern left",
                from: Point::At(ABOVE_CARPUS_LEFT),
