@test
fn every_reference_has_its_source_licence_and_hash() {
    var evaluation = 0
    var development = 0
    var motion = 0
    for r in VALE {
        assert(r.source_page.starts_with("https://commons.wikimedia.org/"), r.id)
        assert(
            r.licence.starts_with("CC0") ||
                r.licence.starts_with("CC BY") ||
                r.licence.starts_with("Public domain"),
            r.id,
        )
        assert(r.sha256.len() == 64 && r.shot_class >= 1 && r.shot_class <= 12, r.id)
        if r.set == "evaluation" {
            evaluation += 1
        } else if r.set == "development" {
            development += 1
        } else if r.set == "motion" {
            motion += 1
        }
    }
    assert(evaluation == 12 && development == 8 && motion == 1, "12, 8 and 1")
}
