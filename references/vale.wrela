// The vale's references (docs/plan-world-class-3.md §B2–B4, D29): freely licensed photographs and
// footage of the real subjects the vale draws, one per evaluation shot, one per development shot,
// and a walking deer for the motion review. Metadata only: each file lives outside the repo under
// `$WRELA_REFERENCE_DIR` (default ~/wrela-references) at `local_file`, its SHA-256 here, its
// credit and licence beside it in `vale/CREDITS.md`. Each licence was read from the file's own
// Wikimedia Commons page. They are shown to agent judges with their credit and licence, and never
// used as textures, geometry, fitting or training inputs (§B3).

/// One reference: what it shows and which shot it's the bar for, its source and rights, what the
/// file's page discloses (anything it doesn't is "unknown"), and the local copy's path and hash.
pub struct VisualReference: Copy {
    pub id: Text,
    /// "evaluation", "development" or "motion".
    pub set: Text,
    /// The vale shot's class it's the bar for (§B1.4's table, 1 to 12).
    pub shot_class: u32,
    pub subject: Text,
    pub why: Text,
    /// "photograph" or "footage".
    pub kind: Text,
    pub title: Text,
    pub creator: Text,
    pub source_page: Text,
    pub file_url: Text,
    pub licence: Text,
    pub licence_url: Text,
    pub date_taken: Text,
    pub processing: Text,
    pub size: vec2u,
    /// The seconds of footage the motion review reads, or "".
    pub segment: Text = "",
    /// The copy's path under `$WRELA_REFERENCE_DIR`, and its SHA-256.
    pub local_file: Text,
    pub sha256: Text,
    pub accessed: Text,
}

/// Every reference may be copied locally, shown to an agent judge with its credit and licence,
/// resized for display (footage: frames extracted), the change noted with the credit; public
/// reports link to the source rather than reproduce it (§B3.2).
pub const USES: Text = "local copy; shown to agent judges with credit and licence; resized or frames extracted, noted; not textures, geometry, fitting or training"

