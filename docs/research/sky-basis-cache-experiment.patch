+/** Lower the immutable spatial part of the cloud field separately from weather.
+ * Broad shape, billows, erosion and regional cover do not depend on sun, cover,
+ * cloud type or time. Rigid wind is a coordinate transform, not a rebuild.
+ * Interpolation is an approximation, not a conservative occupancy certificate. */
+export const CLOUD_BASIS_SIZE = [256, 256, 64] as const;
+export const CLOUD_BASIS_EXTENT = 16384;
+export const CLOUD_BASIS_SNAP = 2048;
+export const CLOUD_BASIS_BASE = 1100;
+export const CLOUD_BASIS_TOP = 6500;
+
+export function cloudBasisCenter(camera: readonly number[], drift: readonly number[]): [number, number] {
+  return [0, 1].map((i) => Math.round((camera[i] - drift[i]) / CLOUD_BASIS_SNAP) * CLOUD_BASIS_SNAP) as [number, number];
+}
+
+// Bake texel *nodes*, including both domain faces. Lookup maps the domain to
+// these nodes, avoiding clamped half-cell plateaus at the slab/cache boundaries.
+export const cloudBasisCoordinatesWGSL = /* wgsl */ `
+@group(0) @binding(22) var<uniform> cloudBasisDomain:vec4f;
+fn physicalCloudBasisUV(stable:vec3f)->vec3f {
+  let f=physicalFrame();
+  let drift=vec2f(f.cloud.y,f.cloud.z)*f.cloud.w;
+  return vec3f((stable.xz-drift-cloudBasisDomain.xy)/${CLOUD_BASIS_EXTENT}.0+0.5,
+    (stable.y-${CLOUD_BASIS_BASE}.0)/${CLOUD_BASIS_TOP-CLOUD_BASIS_BASE}.0);
+}
+`;
+
+export const cloudBasisLookupWGSL = /* wgsl */ `
+${cloudBasisCoordinatesWGSL}
+@group(0) @binding(21) var cloudBasisTexture:texture_3d<f32>;
+override PHYSICAL_CLOUD_CACHED_BASIS:bool=true;
+fn physicalCloudBasis(stable:vec3f,footprint:f32)->vec4f {
+  if(!PHYSICAL_CLOUD_CACHED_BASIS) {return vec4f(-1.0);}
+  let uv=physicalCloudBasisUV(stable);
+  // A procedural collar avoids a cache seam. Both evaluate the same field;
+  // blend the basis before thresholding, never the resulting cloud opacity.
+  if(any(uv<vec3f(0.0))||any(uv>vec3f(1.0))) {return vec4f(-1.0);}
+  let size=vec3f(textureDimensions(cloudBasisTexture));
+  var basis=textureSampleLevel(cloudBasisTexture,physicalAtmosphereSampler,
+    (uv*(size-1.0)+0.5)/size,0.0);
+  let edge=min(min(uv.x,1.0-uv.x),min(uv.y,1.0-uv.y));
+  if(edge<0.03125) {
+    let f=physicalFrame();
+    let p=(stable-vec3f(f.cloud.y,0.0,f.cloud.z)*f.cloud.w)*0.00068+vec3f(8.2,1.9,3.7);
+    basis=mix(physicalCloudBasisReference(p),basis,smoothstep(0.0,0.03125,edge));
+  }
+  let octaveFilter=smoothstep(vec3f(0.3),vec3f(0.9),footprint*0.0007*vec3f(1.0,2.13,5.37));
+  return vec4f(mix(basis.xyz,vec3f(0.5),octaveFilter),basis.w);
+}
+`;
+
+export const cloudBasisReferenceWGSL = /* wgsl */ `
+fn physicalCloudBasisReference(p:vec3f)->vec4f {
+  let region=physicalCloudNoise3(vec3f(p.x*0.48,3.17,p.z*0.48));
+  let warped=physicalCloudRotate(p+vec3f(region-0.5,0.0,(region-0.5)*0.7));
+  let broad=physicalCloudFilteredShape(warped,0.0,0.24);
+  let billows=physicalCloudNoise3(physicalCloudRotate(warped)*2.13+vec3f(11.4,7.3,2.8));
+  let erosion=physicalCloudFilteredShape(physicalCloudRotate(warped)*5.37+vec3f(3.6,14.8,5.2),0.0,0.7);
+  return vec4f(broad,billows,erosion,region);
+}
+`;
