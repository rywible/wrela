@test
fn the_searched_runs_finish_in_their_times_without_a_death() {
    let every = course(WETLANDS).every_snack()
    let any = play(WETLANDS, ANY)
    let full = play(WETLANDS, FULL)
    assert(any.finished == 1311 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 1858 && full.deaths == 0 && full.snacks == every)
    let human_any = play(WETLANDS, HUMAN_ANY)
    let human_full = play(WETLANDS, HUMAN_FULL)
    assert(human_any.finished == 1316 && human_any.deaths == 0)
    assert(human_full.finished == 1957 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
