// The route tool (`wrela tool route`): the route search's fastest any% and 100% runs of a level
// of the capybara game, written as the game's routes_<key>.wrela, with its tests.
//
// ```text
// wrela tool route -- --level <key> [--human] [--seconds S]
// ```
//
// The key is the level's (searched.wrela's `KEYS`: home, wetlands...). With `--needs` it searches
// no runs: for each move, it searches the level with that move forbidden and writes how far it
// got (`NEEDS`: where the move is first needed), keeping the runs the file holds.
//
// Without `--human` it improves the tool-assisted runs (`ANY` and `FULL`); with it, the human
// runs (`HUMAN_ANY` and `HUMAN_FULL`), which keep to a human's limits and are forgiving
// (slack.wrela). For each category it starts from the run routes_<key>.wrela holds, if that still
// finishes as its category asks (the sim may have changed since), and spends up to `S` seconds
// (300 unless given) improving it. A round takes one of the settings in turn and searches
// (search.wrela) from each of the run's segment entries, the latest first: the tick the run
// passes each checkpoint, then the level's start, and for a human run also 0.5 s and 1.5 s before
// each of its first changes that aren't firm. From an entry the search's segment is the rest of
// the level, so a faster end can't leave the next segment worse off; the run it finds takes the
// best's place from the entry on if it costs less: its time, and for a human run `FRAGILE` ticks
// more for each change that isn't firm past the 5% a forgiving run may have. Without a run to start from, the first round searches
// from the start alone. It writes routes_<key>.wrela again if a run is better, keeping the other mode's
// while they still finish: a human run stands for a tool-assisted one that doesn't, and while a
// human run doesn't, it writes nothing until `--human` has found new ones.

use capybara::course::{course, name}
use capybara::pad::{DOWN, Hold, JUMP, LEFT, PRESS, Pad, RIGHT, UP, holds_of}
use capybara::searched::{KEYS, level_of, searched}
use capybara::world::{step, world}
use search::{Goal, Settings, played, search, to_goal}
use slack::{EARLY, LATE, LONGER, RECOVER, Slack, WHOLE, finishes, forgiving, moved, pads_of, slack}
use std::io::print
use std::time::{now, since}
use std::tool::args
use std::tool::files::write

pub const USAGE: Text = "usage: wrela tool route -- --level <key> [--human | --needs] [--seconds S] | --report"

/// The seconds each category is searched unless `--seconds` gives another.
pub const SECONDS: u32 = 300

/// The settings a round takes, in turn: the search's landscape is rough, so each finds other
/// runs, and a run one misses another may find.
pub const TRIES: [Settings; 8] = [
    Settings {},
    Settings { every: 4 },
    Settings { every: 8 },
    Settings { every: 5, cell: 0.5 },
    Settings { every: 7, cell: 0.15 },
    Settings { beam: 3000 },
    Settings { every: 3, beam: 600 },
    Settings { lookahead: 0.5, cell: 0.35 },
]

/// What a change that isn't firm costs a human run, in ticks of its time.
pub const FRAGILE: u32 = 30

/// How many of a human run's first changes that aren't firm a round searches before.
const MENDS: u32 = 3

/// What the command line asks: the level, the seconds for each category, and whether for the
/// human runs.
pub struct Ask: Copy + Eq {
    pub level: u32,
    pub seconds: u32,
    pub human: bool,
    /// Measure where each move is first needed, and search no runs.
    pub needs: bool = false,
    /// Print every level's numbers (design.wrela's `report`), and search nothing.
    pub report: bool = false,
}

/// No level asked for yet.
const NO_LEVEL: u32 = 0xffffffff

/// What the command line gives, or `None` for a usage error (no level is one).
pub fn parse_args(given: [String]) -> Option<Ask> {
    var ask = Ask { level: NO_LEVEL, seconds: SECONDS, human: false }
    var k = 0
    while k < given.len() {
        let a = given[k].as_str()
        if a == "--human" && !ask.human && !ask.needs {
            ask.human = true
        } else if a == "--needs" && !ask.needs && !ask.human {
            ask.needs = true
        } else if a == "--report" && given.len() == 1 {
            ask.report = true
        } else if a == "--level" && k + 1 < given.len() && ask.level == NO_LEVEL {
            ask.level = level_of(given[k + 1].as_str())?
            k += 1
        } else if a == "--seconds" && k + 1 < given.len() {
            ask.seconds = given[k + 1].as_str().parse_u32()?
            k += 1
        } else {
            return None
        }
        k += 1
    }
    if ask.level == NO_LEVEL && !ask.report { None } else { Some(ask) }
}

/// The ticks on which the run of `pads` first reaches each checkpoint's x: a fast run may pass
/// over a flag, so a segment begins where the run passes it, touched or not.
fn checkpoints(level: u32, pads: [u32]) -> Vec<u32> {
    borrow c = course(level)
    var at: Vec<u32> = Vec::new()
    var w = world(level)
    var next = 0
    for i in 0..pads.len() {
        step(mut w, Pad { bits: pads[i] })
        while next < c.checkpoints.len() && w.body.at.x >= c.checkpoints[next].x {
            at.push(i + 1)
            next += 1
        }
    }
    at
}

/// The tick a stretch of held buttons begins on, at or before `t`: where a human run may change.
fn stretch_start(pads: [u32], t: u32) -> u32 {
    var s = t
    while s > 0 && pads[s] & !PRESS == pads[s - 1] & !PRESS {
        s -= 1
    }
    s
}

/// The best run of a category: its pads, its time (0 for none yet), and, for a human run, its
/// slack.
struct Best: Clone {
    pads: Vec<u32>,
    time: u32,
    slack: Slack,
}

fn none() -> Best {
    Best {
        pads: Vec::new(),
        time: 0,
        slack: Slack { changes: 0, firm: 0, fragile: Vec::new(), missed: Vec::new() },
    }
}

/// A round's entries into the run `best`, the latest first, each once, the level's start last.
fn entries(level: u32, best: Best, human: bool) -> Vec<u32> {
    var at = checkpoints(level, best.pads)
    if human {
        for i in 0..min(best.slack.fragile.len(), MENDS) {
            let f = best.slack.fragile[i]
            for back in [60, 180] {
                if f > back {
                    at.push(f - back)
                }
            }
        }
        for i in 0..at.len() {
            at[i] = stretch_start(best.pads, at[i])
        }
    }
    at.push(0)
    at.sort_by(|a, b| a > b)
    var once: Vec<u32> = Vec::new()
    for e in at {
        if once.is_empty() || once[once.len() - 1] != e {
            once.push(e)
        }
    }
    once
}

/// What `b` costs: its time, and for a human run `FRAGILE` more for each change that isn't firm
/// past the share a forgiving run may have (`slack::FIRM`): once forgiving, faster is better.
fn cost(b: Best, human: bool) -> u32 {
    if !human {
        return b.time
    }
    let fragile = b.slack.changes - b.slack.firm
    let allowed = b.slack.changes * (100 - slack::FIRM) / 100
    b.time + FRAGILE * (if fragile > allowed { fragile - allowed } else { 0 })
}

/// `pads` as a category's best, if they finish as it asks (and, for a human run, keep to the
/// limits).
fn best_of(level: u32, pads: take Vec<u32>, snacks: u32, human: bool) -> Option<Best> {
    let w = played(world(level), pads)
    if !finishes(w, snacks) || (human && !slack::human(pads)) {
        return None
    }
    var b = none()
    b.time = w.finished
    if human {
        b.slack = slack(level, pads, to_goal(snacks), RECOVER)
    }
    b.pads = take pads
    Some(b)
}

/// A run routes_<key>.wrela holds, as its category's best (none for no run).
fn kept(level: u32, run: [Hold], snacks: u32, human: bool) -> Best {
    if run.is_empty() {
        return none()
    }
    match best_of(level, pads_of(level, run), snacks, human) {
        Some(b) => b,
        None => none(),
    }
}

/// What a category's best is, in words.
fn told(b: Best, human: bool) -> String {
    if human {
        f"{b.time} ticks, {b.slack.firm} of {b.slack.changes} changes firm"
    } else {
        f"{b.time} ticks"
    }
}

/// The human run `b` with its changes that aren't firm moved to where they are: one that misses
/// only shifts late moves 1 or 2 ticks earlier, one that misses only shifts early moves later.
/// Each move stays if the run then costs less; it stops by `start` + `seconds`.
fn steadied(level: u32, b: take Best, snacks: u32, start: f64, seconds: f32) -> Best {
    var best = take b
    var from = 0
    loop {
        var i = 0
        while i < best.slack.fragile.len() && best.slack.fragile[i] < from {
            i += 1
        }
        if i == best.slack.fragile.len() || since(start) >= seconds {
            return best
        }
        let (at, missed) = (best.slack.fragile[i], best.slack.missed[i])
        from = at + 1
        if missed & EARLY != 0 && missed & LATE != 0 {
            continue
        }
        let ways: [i32; 2] = if missed & EARLY == 0 { [-1, -2] } else { [1, 2] }
        for by in ways {
            let Some(c) = best_of(level, moved(best.pads, at, by), snacks, human: true) else {
                continue
            }
            if cost(c, human: true) < cost(best, human: true) {
                best = take c
                from = at
                break
            }
        }
    }
}

/// The best run of the category whose runs find `snacks`, from `from` on, after up to `seconds`
/// of search.
fn improve(level: u32, name: str, from: take Best, snacks: u32, human: bool, seconds: f32) -> Best {
    let start = now()
    var best = take from
    print(f"{name}: from {told(best, human)}")
    var round = 0
    while since(start) < seconds {
        let settings = Settings { human, ..TRIES[round % TRIES.len()] }
        let from = if best.time == 0 { Vec::from([0]) } else { entries(level, best, human) }
        for e in from {
            if since(start) >= seconds {
                break
            }
            var prefix: Vec<u32> = Vec::new()
            for i in 0..e {
                prefix.push(best.pads[i])
            }
            let last = if e > 0 { prefix[e - 1] & !PRESS } else { 0 }
            let entry = played(world(level), prefix)
            let limit = if best.time == 0 { settings.ticks } else { cost(best, human) - e - 1 }
            let begun = now()
            var s = search(entry, last, to_goal(snacks), Settings { ticks: limit, ..settings })
            while !s.stopped && since(start) < seconds {
                s.layer()
            }
            let took = f"{s.states} states, {since(begun)} s"
            let Some(f) = s.found else {
                print(f"  round {round} from tick {e}: none ({took})")
                continue
            }
            for p in f.pads {
                prefix.push(p)
            }
            let Some(b) = best_of(level, take prefix, snacks, human) else {
                print(f"  round {round} from tick {e}: a run that doesn't count ({took})")
                continue
            }
            if best.time == 0 || cost(b, human) < cost(best, human) {
                print(f"  round {round} from tick {e}: {told(b, human)} ({took})")
                best = take b
            } else {
                print(f"  round {round} from tick {e}: {told(b, human)}, no better ({took})")
            }
        }
        if human && best.time > 0 {
            best = steadied(level, take best, snacks, start, seconds)
            print(f"  round {round} steadied: {told(best, human)}")
        }
        round += 1
    }
    print(f"{name}: {told(best, human)} after {since(start)} s")
    best
}

/// A pad's bits as the pad module's names, joined by `|`.
fn bits_text(bits: u32) -> String {
    let names: [Text; 6] = ["RIGHT", "LEFT", "UP", "DOWN", "JUMP", "PRESS"]
    let values = [RIGHT, LEFT, UP, DOWN, JUMP, PRESS]
    var out = String::new()
    for i in 0..names.len() {
        if bits & values[i] != 0 {
            if !out.is_empty() {
                out.push_str(" | ")
            }
            out.push_str(names[i])
        }
    }
    out
}

/// A run for a routes_<key>.wrela: its holds, its time, and its doc comment.
pub struct Route: Clone {
    pub run: Vec<Hold>,
    pub time: u32,
    pub doc: String,
}

/// A run as a constant of holds, after its doc comment.
fn constant(text: mut String, name: str, r: Route) {
    text.push_str(r.doc)
    text.push_str(f"pub const {name}: [Hold; {r.run.len()}] = [\n")
    for h in r.run {
        if h.bits == 0 {
            text.push_str(f"    hold(bits: 0, ticks: {h.ticks}),\n")
        } else {
            text.push_str(f"    hold({bits_text(h.bits)}, {h.ticks}),\n")
        }
    }
    text.push_str("]\n")
}

/// `x` as a literal for routes_<key>.wrela: to the centimetre, or 1e9 for never.
fn literal(x: f32) -> String {
    if x >= 1.0e8 { String::from("1.0e9") } else { f"{x:.2}" }
}

/// The name of level `key`'s course number in course.wrela: the key in capitals (`food_court`,
/// `FOOD_COURT`).
pub fn constant_of(key: str) -> String {
    var out = String::new()
    for i in 0..key.len() {
        let b = key.byte(i)
        out.push_byte(if b >= 97 && b <= 122 { b - 32 } else { b })
    }
    out
}

/// routes_<key>.wrela with level `key`'s runs `routes`, named `level`: any% and 100%,
/// tool-assisted, then with the human limits.
pub fn routes_text(key: str, level: str, routes: [Route; 4], needs: [f32; 5]) -> String {
    var text = f"// The route search's fastest runs of {level} (design.md, \"The agent loop\"): any% and\n// 100%, tool-assisted, and the same human-possible: each input has slack, and a slip of a tick\n// or two is recoverable within a second (route/slack.wrela; route/tests.wrela checks them for\n// it). No person has played them. `wrela tool route -- --level {key}` searches for better ones\n// and writes this file again, with the tests' times; run it again when a change to the movement\n// or the course moves them.\n\n"
    let c = constant_of(key)
    var bits = 0
    for r in routes {
        for h in r.run {
            bits = bits | h.bits
        }
    }
    var names: Vec<Text> = Vec::new()
    let order: [Text; 6] = ["DOWN", "JUMP", "LEFT", "PRESS", "RIGHT", "UP"]
    let values = [DOWN, JUMP, LEFT, PRESS, RIGHT, UP]
    for i in 0..order.len() {
        if bits & values[i] != 0 {
            names.push(order[i])
        }
        if i == 0 {
            names.push("Hold")
        }
    }
    names.push("hold")
    text.push_str(f"use course::{{{c}, course}}\nuse pad::{{")
    for i in 0..names.len() {
        if i > 0 {
            text.push_str(", ")
        }
        text.push_str(names[i])
    }
    text.push_str("}\nuse world::play\n")
    let consts: [Text; 4] = ["ANY", "FULL", "HUMAN_ANY", "HUMAN_FULL"]
    for i in 0..4 {
        text.push_str("\n")
        constant(mut text, consts[i], routes[i])
    }
    let (any, full, human_any, human_full) = (
        routes[0].time,
        routes[1].time,
        routes[2].time,
        routes[3].time,
    )
    text.push_str(
        f"\n/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,\n/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --\n/// --level {key} --needs` measures them.\npub const NEEDS: [f32; 5] = [{literal(needs[0])}, {literal(needs[1])}, {literal(needs[2])}, {literal(needs[3])}, {literal(needs[4])}]\n",
    )
    text.push_str(
        f"\n@test\nfn the_searched_runs_of_{key}_finish_in_their_times_without_a_death() {{\n    let every = course({c}).every_snack()\n    let any = play({c}, ANY)\n    let full = play({c}, FULL)\n    assert(any.finished == {any} && any.deaths == 0, \"the any% run's time moved\")\n    assert(full.finished == {full} && full.deaths == 0 && full.snacks == every)\n    let human_any = play({c}, HUMAN_ANY)\n    let human_full = play({c}, HUMAN_FULL)\n    assert(human_any.finished == {human_any} && human_any.deaths == 0)\n    assert(human_full.finished == {human_full} && human_full.deaths == 0)\n    assert(human_full.snacks == every)\n}}\n",
    )
    text
}

/// The other mode's run of a category to write beside this mode's `mine` (`human`: this mode's
/// are the human runs): `other` as routes_<key>.wrela holds it (`kept`), if it still finishes. A human
/// run is a tool-assisted one too, so `mine` stands for a tool-assisted run that no longer
/// finishes; none for a human run that no longer finishes, which must be searched again first.
fn standing(other: take Best, mine: Best, human: bool) -> Option<Best> {
    if other.time > 0 {
        return Some(take other)
    }
    if human { Some(mine.clone()) } else { None }
}

@test
fn a_run_that_no_longer_finishes_isnt_written() {
    var found = none()
    found.time = 1300
    var still = none()
    still.time = 1400
    assert(
        standing(take still, found, human: false).expect("it stays").time == 1400,
        "a run that finishes",
    )
    assert(
        standing(none(), found, human: true).expect("it stands in").time == 1300,
        "a human run stands for a tool-assisted one that doesn't",
    )
    assert(
        standing(none(), found, human: false).is_none(),
        "a human run that doesn't isn't written",
    )
}

/// A category's run for routes_<key>.wrela: its best, with its doc comment.
fn route(level: u32, b: Best, what: str, snacks: u32, human: bool) -> Route {
    let doc = if human {
        let longer = slack(level, b.pads, to_goal(snacks), LONGER)
        let whole = slack(level, b.pads, to_goal(snacks), WHOLE)
        let n = b.slack.changes
        f"/// {what}, human-possible, in {b.time} ticks.\n/// Every stretch of buttons is held 3 ticks or more, and jump is pressed only after it was let\n/// go. Of its {n} changes of buttons, each moved 1 or 2 ticks early or late, {b.slack.firm} live\n/// through the second after, {longer.firm} through two seconds, and {whole.firm} through the whole\n/// run with every later button as it was. Human-possible means each input has slack and a slip\n/// is recoverable within a second, not that a person was tested on it.\n"
    } else {
        f"/// {what}, tool-assisted, in {b.time} ticks.\n"
    }
    Route { run: holds_of(b.pads), time: b.time, doc }
}

pub fn tool() -> u32 {
    let Some(ask) = parse_args(args()) else {
        print(USAGE)
        return 2
    }
    if ask.report {
        print(design::report())
        return 0
    }
    let level = ask.level
    let key = KEYS[level]
    let file = f"routes_{key}.wrela"
    let runs = searched(level)
    let all = course(level).every_snack()
    let named = name(level)
    let first = f"{named} from start to goal (any%)"
    let every = f"{named} with every snack (100%)"
    if ask.needs {
        if runs.any.is_empty() || runs.human_any.is_empty() {
            print(f"route: search {key}'s runs first")
            return 1
        }
        let needs = needs_of(level, f32(ask.seconds))
        let routes = [
            route(level, kept(level, runs.any, 0, human: false), first.as_str(), 0, human: false),
            route(
                level,
                kept(level, runs.full, all, human: false),
                every.as_str(),
                all,
                human: false,
            ),
            route(
                level,
                kept(level, runs.human_any, 0, human: true),
                first.as_str(),
                0,
                human: true,
            ),
            route(
                level,
                kept(level, runs.human_full, all, human: true),
                every.as_str(),
                all,
                human: true,
            ),
        ]
        return write_routes(key, named, file, routes, needs)
    }
    let (any_run, full_run) = if ask.human {
        (runs.human_any.clone(), runs.human_full.clone())
    } else {
        (runs.any.clone(), runs.full.clone())
    }
    let was_any = kept(level, any_run, 0, ask.human)
    let was_full = kept(level, full_run, all, ask.human)
    let any = improve(level, "any%", was_any.clone(), 0, ask.human, f32(ask.seconds))
    let full = improve(level, "100%", was_full.clone(), all, ask.human, f32(ask.seconds))
    if any.time == 0 || full.time == 0 {
        print("route: no run of each category to write")
        return 1
    }
    if any.pads == was_any.pads && full.pads == was_full.pads {
        print(f"route: no better run; {file} stays")
        return 0
    }
    if ask.human && (!forgiving(any.slack) || !forgiving(full.slack)) {
        print(
            f"route: a human run has fewer than {slack::FIRM}% of its changes firm within a second",
        )
    }
    // The other mode's runs stay as the file holds them, while they still finish. A level
    // searched for the first time has none: its tool-assisted runs stand in for its human ones
    // until `--human` finds them.
    let (other_any, other_full) = if ask.human {
        (kept(level, runs.any, 0, human: false), kept(level, runs.full, all, human: false))
    } else {
        (
            kept(level, runs.human_any, 0, human: true),
            kept(level, runs.human_full, all, human: true),
        )
    }
    let again = "route: the human runs no longer finish: search them first (--human)"
    let fresh = runs.human_any.is_empty()
    let Some(stays_any) = standing(take other_any, any, ask.human || fresh) else {
        print(again)
        return 1
    }
    let Some(stays_full) = standing(take other_full, full, ask.human || fresh) else {
        print(again)
        return 1
    }
    let (assisted_any, assisted_full, human_any, human_full) = if ask.human {
        (take stays_any, take stays_full, take any, take full)
    } else {
        (take any, take full, take stays_any, take stays_full)
    }
    let routes = [
        route(level, assisted_any, first.as_str(), 0, human: false),
        route(level, assisted_full, every.as_str(), all, human: false),
        route(level, human_any, first.as_str(), 0, human: true),
        route(level, human_full, every.as_str(), all, human: true),
    ]
    write_routes(key, named, file, routes, runs.needs)
}

/// The moves whose first need `--needs` measures, by their bit's place: the double jump, a splash,
/// the slide, swimming. (The run and jump is needed from the start.)
const MEASURED: [u32; 4] = [1, 2, 3, 4]

/// Where each move is first needed on `level`: for each measured move, how far a search with it
/// forbidden lives, over up to `seconds` each; 1e9 for one it finishes without, and for the run
/// and jump.
fn needs_of(level: u32, seconds: f32) -> [f32; 5] {
    var out = [1.0e9; 5]
    for b in MEASURED {
        let start = now()
        let goal = Goal { until: 1.0e9, snacks: 0, forbid: 1 << b }
        var s = search(world(level), 0, goal, TRIES[0])
        while !s.stopped && since(start) < seconds {
            s.layer()
        }
        out[b] = if s.found.is_some() { 1.0e9 } else { s.far }
        print(f"needs: move {1 << b} at {out[b]} m ({s.states} states, {since(start)} s)")
    }
    out
}

/// Writes routes_<key>.wrela: the runs `routes`, and `needs`.
fn write_routes(key: str, named: str, file: str, routes: [Route; 4], needs: [f32; 5]) -> u32 {
    let text = routes_text(key, named, routes, needs)
    match write(f"game/{file}", text.as_bytes()).wait() {
        Ok(_) => {
            print(f"route: wrote games/capybara/{file}")
            0
        },
        Err(e) => {
            print(f"route: {e.message()}")
            1
        },
    }
}
