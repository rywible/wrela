// What a human can play: runs as the buttons held each tick, whether a run keeps to a human's
// limits, and how forgiving it is.
//
// - Human limits: every stretch of held buttons lasts at least `STRETCH` ticks, and jump is
//   pressed only as it goes down, after it was let go (so no press and release within one tick,
//   and no press while it's held). The run's last stretch may be shorter: the goal ends it.
// - Slack: each change of the held buttons, moved 1 and 2 ticks early or late, one at a time (the
//   old buttons held on, or the new ones pressed sooner), then played on with the run's buttons.
//   A change is firm within a window of ticks if all four live through the window (or reach the
//   run's end as its goal asks first), with no death. A forgiving run's changes nearly all are
//   firm within `RECOVER` ticks: a player who slips sees where they are and corrects within a
//   second, which fixed buttons after a slip don't. Over the whole run, with every later button
//   fixed, a slip of 2 ticks moves the capybara a little, and that spoils a jump seconds later,
//   so far fewer are firm there (`WHOLE`).
// - So a human run here means: every change has slack, and a slip is recoverable within a
//   second. No person has played these runs.

use capybara::pad::{Hold, JUMP, PRESS, Pad, pad_of}
use capybara::world::{World, step, world}
use search::{Goal, alive, ended}

/// The fewest ticks a human holds the same buttons.
pub const STRETCH: u32 = 3

/// The share of a human run's changes that must be firm within `RECOVER` ticks, in percent.
pub const FIRM: u32 = 95

/// The window a slip must be lived through: a second. Wider windows, for the record: two
/// seconds, and the whole run.
pub const RECOVER: u32 = 120
pub const LONGER: u32 = 240
pub const WHOLE: u32 = 0

/// How far a change is moved, either way (ticks).
const SHIFTS: [i32; 4] = [-2, -1, 1, 2]

/// A run's pads, tick by tick, up to its finish on course `c`.
pub fn pads_of(c: u32, run: [Hold]) -> Vec<u32> {
    var pads: Vec<u32> = Vec::new()
    var w = world(c)
    for h in run {
        for i in 0..h.ticks {
            if w.finished == 0 {
                let p = pad_of(h, i)
                pads.push(p.bits)
                step(mut w, p)
            }
        }
    }
    pads
}

/// The pad of a tick whose held buttons are `held`, after a tick that held `last`: jump is
/// pressed as it goes down.
pub fn pressed(held: u32, last: u32) -> u32 {
    if held & JUMP != 0 && last & JUMP == 0 { held | PRESS } else { held }
}

/// Whether `pads` keep to a human's limits.
pub fn human(pads: [u32]) -> bool {
    var last = 0
    var run = STRETCH
    for p in pads {
        let held = p & !PRESS
        if p != pressed(held, last) {
            return false
        }
        if held != last {
            if run < STRETCH {
                return false
            }
            run = 0
        }
        run += 1
        last = held
    }
    true
}

/// How forgiving a run is: its changes, those that are firm, and the ticks of the rest, each
/// with the shifts it missed (a bit each, in `SHIFTS`' order: 2 and 1 early, 1 and 2 late).
pub struct Slack: Clone {
    pub changes: u32,
    pub firm: u32,
    pub fragile: Vec<u32>,
    pub missed: Vec<u32>,
}

/// The shifts a change missed early, and late (`Slack::missed`).
pub const EARLY: u32 = 3
pub const LATE: u32 = 12

/// One shift of one change: where it is (the change's tick), how far, the state 2 ticks before
/// it, and whether the shifted run finished.
struct Shift: Copy {
    at: u32,
    within: u32,
    by: i32,
    from: World,
    ok: bool,
}

/// Whether `w` finished as a run that needs `snacks` must: at the goal, with no death, and with
/// those snacks.
pub fn finishes(w: World, snacks: u32) -> bool {
    w.finished > 0 && w.deaths == 0 && w.snacks & snacks == snacks
}

/// Whether `w` reached the end of a segment of `goal` as it asks: with no death, and with its
/// snacks.
fn reaches(w: World, goal: Goal) -> bool {
    ended(w, goal) && w.deaths == 0 && w.snacks & goal.snacks == goal.snacks
}

/// The buttons held on tick `t` of the run of `held` with its change at tick `at` moved `by`
/// ticks (early if negative): the new buttons sooner, or the old ones on.
fn held_at(held: [u32], t: u32, at: u32, by: i32) -> u32 {
    let from = i32(t) - i32(at)
    if by < 0 && from >= by && from < 0 {
        held[at]
    } else if by > 0 && from >= 0 && from < by {
        held[at - 1]
    } else {
        held[t]
    }
}

/// The run of `pads` with its change at tick `at` moved `by` ticks, as pads.
pub fn moved(pads: [u32], at: u32, by: i32) -> Vec<u32> {
    var held: Vec<u32> = Vec::with_capacity(pads.len())
    for p in pads {
        held.push(p & !PRESS)
    }
    var out: Vec<u32> = Vec::with_capacity(pads.len())
    var last = 0
    for t in 0..held.len() {
        let h = held_at(held, t, at, by)
        out.push(pressed(h, last))
        last = h
    }
    out
}

/// The run of `held` with its change at tick `at` moved `by` ticks, played from `from`, the state
/// on tick `at - 2`.
@deterministic
fn shifted(s: mut Shift, held: [u32], goal: Goal) {
    var w = s.from
    var last = if s.at >= 3 { held[s.at - 3] } else { 0 }
    for t in s.at - 2..held.len() {
        if s.within != WHOLE && t >= s.at + s.within {
            s.ok = alive(w, goal) && w.deaths == 0
            return
        }
        let h = held_at(held, t, s.at, s.by)
        step(mut w, Pad { bits: pressed(h, last) })
        last = h
        if w.dying > 0 || ended(w, goal) {
            break
        }
    }
    // Played to the end of the run, it may still be on its way: on, holding its last buttons.
    for _ in 0..240 {
        if w.dying > 0 || ended(w, goal) {
            break
        }
        step(mut w, Pad { bits: last })
    }
    s.ok = reaches(w, goal)
}

/// How forgiving the run of `pads` on course `c` to the end of `goal` is, a run that keeps to the
/// human limits: its changes firm `within` ticks (or over the whole run, `WHOLE`). A change in the
/// first 2 ticks can't be moved early, so it isn't counted.
pub fn slack(c: u32, pads: [u32], goal: Goal, within: u32) -> Slack {
    var held: Vec<u32> = Vec::with_capacity(pads.len())
    for p in pads {
        held.push(p & !PRESS)
    }
    var shifts: Vec<Shift> = Vec::new()
    var w = world(c)
    var last = 0
    for t in 0..held.len() {
        if t + 2 < held.len() && held[t + 2] != held[t + 1] {
            for by in SHIFTS {
                shifts.push(Shift { at: t + 2, within, by, from: w, ok: false })
            }
        }
        step(mut w, Pad { bits: pressed(held[t], last) })
        last = held[t]
    }
    shifts.par_each_mut(|s| shifted(mut s, held, goal))
    var s = Slack { changes: 0, firm: 0, fragile: Vec::new(), missed: Vec::new() }
    var i = 0
    while i < shifts.len() {
        s.changes += 1
        var missed = 0
        for k in 0..4 {
            if !shifts[i + k].ok {
                missed = missed | (1 << k)
            }
        }
        if missed == 0 {
            s.firm += 1
        } else {
            s.fragile.push(shifts[i].at)
            s.missed.push(missed)
        }
        i += 4
    }
    s
}

/// Whether a run's slack within `RECOVER` ticks is a forgiving run's: at least `FIRM` percent of
/// its changes firm.
pub fn forgiving(s: Slack) -> bool {
    s.firm * 100 >= s.changes * FIRM
}
