// Watching a run: a replay played back on the frames' side (main.wrela), apart from the ticker,
// which stands paused with the runs open meanwhile. It steps its own world with the replay's pads
// at the sim's rate, slower or faster, goes on a few seconds past the goal for the fireworks, and
// seeks forward by playing on and back by playing again from the start, as the sim has no way
// back. It counts what happens as the ticker does (world.wrela's `Tally`), a seek as a cut. The
// frames draw it as they draw play, between its last two snapshots.

use feel::{HZ, STEP}
use pad::{IDLE, pad_of}
use replay::Replay
use world::{NO_TALLY, Snap, Tally, World, present, step_counted, world}

/// How long a watched run goes on past its goal (ticks): the fireworks.
const AFTER: u32 = 6 * HZ

/// The speeds it plays at, and the one it starts at.
pub const SPEEDS: [f32; 5] = [0.25, 0.5, 1.0, 2.0, 4.0]
const NORMAL: u32 = 2

/// A run being watched: its replay, the world it has reached, what happened in it and the
/// snapshot before that, the ticks played, the hold and the tick in it that come next, how far
/// into the next tick the frames are (0 to 1), its speed (in `SPEEDS`) and whether it plays.
pub struct Watch {
    pub replay: Replay,
    pub world: World,
    pub tally: Tally,
    before: Snap,
    pub tick: u32,
    hold: u32,
    within: u32,
    part: f32,
    pub speed: u32,
    pub playing: bool,
}

/// `r` from its start, playing.
pub fn watch(r: take Replay) -> Watch {
    let w = started(r.course)
    Watch {
        replay: r,
        world: w,
        tally: NO_TALLY,
        before: present(w),
        tick: 0,
        hold: 0,
        within: 0,
        part: 0.0,
        speed: NORMAL,
        playing: true,
    }
}

/// Course `c`'s start, playing: a new world opens paused on the level's title.
fn started(c: u32) -> World {
    var w = world(c)
    w.paused = false
    w
}

impl Watch {
    /// The tick it stops on: its run's and the time after.
    pub fn end(self) -> u32 {
        self.replay.ticks + AFTER
    }

    /// `dt` seconds on, at its speed, while it plays: it stops at its end.
    pub fn advance(mut self, dt: f32) {
        if !self.playing {
            return
        }
        self.part += dt * f32(HZ) * SPEEDS[self.speed]
        while self.part >= 1.0 {
            if self.tick >= self.end() {
                self.part = 0.0
                self.playing = false
                return
            }
            self.step_once()
            self.part -= 1.0
        }
    }

    /// To tick `t` (at most its end): played on to it, or again from the start to one before. What
    /// it passes isn't counted: the seek is a cut.
    pub fn seek(mut self, t: u32) {
        let target = min(t, self.end())
        let (from, kept) = (self.tick, self.tally)
        if target < self.tick {
            self.world = started(self.replay.course)
            self.before = present(self.world)
            self.tick = 0
            self.hold = 0
            self.within = 0
        }
        self.part = 0.0
        while self.tick < target {
            self.step_once()
        }
        self.tally = kept
        if self.tick != from {
            self.tally.cuts += 1
        }
        self.before.tally = self.tally
    }

    /// The snapshots before and after the frame, and how far between them it falls (0 to 1).
    pub fn between(self) -> (Snap, Snap, f32) {
        var now = present(self.world)
        now.tally = self.tally
        (self.before, now, self.part)
    }

    /// One tick: the replay's pad, or none past its end.
    fn step_once(mut self) {
        self.before = present(self.world)
        self.before.tally = self.tally
        let holds = self.replay.holds.len()
        let pad = if self.hold < holds {
            pad_of(self.replay.holds[self.hold], self.within)
        } else { IDLE }
        step_counted(mut self.world, mut self.tally, pad)
        self.tick += 1
        if self.hold < holds {
            self.within += 1
            if self.within == self.replay.holds[self.hold].ticks {
                self.hold += 1
                self.within = 0
            }
        }
    }
}

// ---- tests -------------------------------------------------------------------------------------

use replay::{played, tool_assisted}
use course::WETLANDS

@test
fn a_watched_run_plays_to_its_goal_at_any_speed_and_stops_after_it() {
    let r = tool_assisted(WETLANDS)[0].clone()
    let ticks = r.ticks
    var w = watch(r.clone())
    w.speed = 4
    // Ten seconds of frames at 60 a second, four times as fast: the whole run and the fireworks.
    for _ in 0..600 {
        w.advance(1.0 / 60.0)
    }
    assert(w.world.finished == ticks, f"the goal at {w.world.finished}")
    assert(!w.playing && w.tick == w.end(), "it stops at its end")
    let (a, b, t) = w.between()
    assert(b.ticks == a.ticks && t == 0.0, "the clock stays at the goal")
}

@test
fn seeking_lands_where_playing_does() {
    let r = tool_assisted(WETLANDS)[1].clone()
    var w = watch(r.clone())
    w.seek(1500)
    let there = played(r, 1500)
    assert(w.tick == 1500 && w.world == started_at(there), "seeking forward")
    w.seek(200)
    assert(w.world == started_at(played(r, 200)), "and back")
    // Played on from there, a tick at a time, it's where the replay is.
    for _ in 0..120 {
        w.advance(STEP)
    }
    assert(w.world == started_at(played(r, 320)), f"at {w.tick}")
    w.seek(1500)
    assert(w.tick == 1500 && w.world == started_at(there), "forward again, playing on from there")
}

/// `w` as the watch's world, which isn't paused.
fn started_at(w: World) -> World {
    var out = w
    out.paused = false
    out
}
