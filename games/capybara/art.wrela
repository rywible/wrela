// How a frame is made, as a page of a picture book (ink.wrela):
//
// 1. The scene, on the sheet's target (`engine::sheet::Sheet::scene`): the sky and the zoo behind
//    (scenery.wrela), the ground and its grass (earth.wrela), the shadows, the things, the
//    creatures and the particles. Every shape is a wash with an ink line, drawn crisp, at the
//    render scale (`engine::sheet::Scale`): the screen's own size while the GPU keeps up with the
//    display, less while it doesn't.
// 2. A copy of it (`Sheet::copy_below`), which the water reads to bend what's under it a little.
// 3. The water, over the scene, then what goes in front of it.
// 4. The page, at the screen's own size: the scene stretched over it, its colours lifted a little, the corners darker as an old page's are;
//    and an iris that closes on the capybara when it dies and opens where it comes back. The paper
//    the page is painted on is the sky's (scenery.wrela): it lies behind the scene, not over it.
//
// The colours are display colours, as the paint is: nothing here is a light simulation, so
// there's no tone curve and no glow.

use engine::noise::noise2_wrapped
use engine::frame::full
use ink::{GRAIN_CELLS, INK, PAPER}
use shapes::blend
use std::gpu::{FragCoord, Rgba16Float, Sampler, Texture, begin_pass, draw, texture}

/// The grain's texels a cell (`ink::GRAIN`): enough that reading between them is the noise's own
/// smooth blend, near enough.
pub const GRAIN_TEXELS: u32 = 4

/// A texel of the grain: four of the engine's value noises at its middle, each its own pattern,
/// repeating every `GRAIN_CELLS` cells, so the tile wraps without a seam.
@fragment
pub fn bake_grain(pixel: FragCoord) -> vec4 {
    let p = pixel.position.xy / f32(GRAIN_TEXELS)
    let n = vec2i(i32(GRAIN_CELLS), i32(GRAIN_CELLS))
    vec4(
        noise2_wrapped(p, n),
        noise2_wrapped(p + vec2(17.0, 31.0), n),
        noise2_wrapped(p + vec2(41.0, 7.0), n),
        noise2_wrapped(p + vec2(23.0, 53.0), n),
    )
}

/// The grain, baked: a texture to draw into once, and the sampler that repeats it.
pub fn grain_texture() -> Texture<Rgba16Float> {
    let side = u32(GRAIN_CELLS) * GRAIN_TEXELS
    var t = texture(width: side, height: side)
    let p = begin_pass(mut t)
    draw(p, full.bind(z: 0.0), bake_grain, vertices: 3)
    p.end()
    t
}

/// Where the page lies on the plane of play: the view's middle and half its size (m); the
/// screen's size (px), which the scene, drawn at the render scale, is stretched over; and the iris:
/// its middle (m on the plane of play) and how open (0 shut, 1 open).
pub struct Page: Copy + GpuData {
    pub centre: vec2,
    pub half: vec2,
    pub iris: vec2,
    pub screen: vec2,
    pub open: f32,
    /// How much the page is washed over, under the pause's card (0 to 1).
    pub dim: f32 = 0.0,
}

/// The page: the scene, its colours a little more vivid, the corners darker, and the iris: outside
/// it, the page dark as ink, a ring of ink round its edge.
@fragment
pub fn finish(pixel: FragCoord, scene: Texture<Rgba16Float>, s: Sampler, page: Page) -> vec4 {
    let size = page.screen
    let uv = pixel.position.xy / size
    var c = scene.sample_level(s, uv).rgb
    // The paint a little more vivid, and a touch more contrast.
    let luma = dot(c, vec3(0.299, 0.587, 0.114))
    c = vec3(luma) + (c - vec3(luma)) * 1.3
    c = (c - vec3(0.5)) * 1.06 + vec3(0.5)
    let edge = (uv - vec2(0.5)) * vec2(size.x / size.y, 1.0)
    let corner = 1.0 - 0.14 * smoothstep(0.45, 1.05, length(edge))
    c = c * vec3(corner, corner, corner * 0.97)
    if page.open < 1.0 {
        let p = page.centre + vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) * page.half
        let px = 2.0 * page.half.y / size.y
        let r = page.open * 2.2 * 2.0 * page.half.y
        let d = length(p - page.iris) - r
        c = blend(c, vec3(0.2, 0.14, 0.1), smoothstep(-px, px, d))
        c = blend(c, INK, saturate(1.0 - abs(d) / (px * 2.5)) * step(0.001, page.open))
    }
    // Paused: a wash of the paper's cream over the page, the card on it.
    c = blend(c, PAPER * 0.93, page.dim * 0.55)
    vec4(saturate(c), 1.0)
}
