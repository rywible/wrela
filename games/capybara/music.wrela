/// The seagull: sneaking up on tiptoe, quietly, in short notes with chromatic steps, a cheeky
/// peck (B, C, B, A), and a run up to the chase.
const SEAGULL = score("the seagull", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "e5/8 !mp r f5 f#5 g5/4 r | bb5/8 r a5 g#5 g5/4 r |",
            "f5/8 r f#5 g5 a5 r c6 r | b5/8 ( c6 b5 a5 ) g5/4 r |",
            "e5/8 r f5 f#5 g5/4 r | c6/8 r b5 bb5 ab5/4 r |",
            "g5/8 r f5 d5 b4 r g4 r | r/4 g4/16 !< a4 b4 c5 d5 e5 f5 g5 a5 b5 c6 d6 !mf |",
        ],
    )
    .voice(
        "chords",
        [
            "r/4 <g3 c4 e4> r <g3 c4 e4> |",
            "r/4 <g3 bb3 e4> r <g3 bb3 e4> |",
            "r/4 <a3 c4 f4> r <a3 c4 f4> |",
            "r/4 <g3 b3 f4> r <g3 b3 f4> |",
            "r/4 <g3 c4 e4> r <g3 c4 e4> |",
            "r/4 <gb3 c4 eb4> r <gb3 c4 eb4> |",
            "r/4 <g3 b3 f4> r <g3 b3 f4> |",
            "r/8 <g3 b3 f4> r <g3 b3 f4> r <g3 b3 f4> r <g3 b3 f4> |",
        ],
    )
    .voice(
        "bass",
        [
            "c2/4 r g1 r | c#2 r g1 r | d2 r a1 r | g1 r d2 r |",
            "c2 r g1 r | ab1 r eb2 r | g1 r d2 r | g1 b1 d2 f2 |",
        ],
    )

/// The chase: determined, in repeated notes and a climbing sequence (F, G, E minor, A minor),
/// to forte on A7, the dominant of the lift's D major.
const CHASE = score("the chase", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "c6/8 c6 ( a5/4 ~ a5/8 g5 a5/4 ) | d6/8 d6 ( b5/4 ~ b5/8 a5 b5/4 ) |",
            "e6/8 e6 ( b5/4 ~ b5/8 a5 g5/4 ) | a5/8 ( b5 c6 a5 e5/4 ) r |",
            "c6/8 !< c6 ( a5/4 ~ a5/8 g5 a5/4 ) | d6/8 d6 ( b5/4 ~ b5/8 c6 d6/4 ) |",
            "e6/8 !f ( d6 a5 d6 e6/4 d6/8 a5 ) | c#6/8 ( a5 e5 a5 c#6 e6 ) r/8 a4 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> |",
            "r/8 <g3 b3 d4> r <g3 b3 d4> r <g3 b3 d4> r <g3 b3 d4> |",
            "r/8 <g3 b3 e4> r <g3 b3 e4> r <g3 b3 e4> r <g3 b3 e4> |",
            "r/8 <a3 c4 e4> r <a3 c4 e4> r <a3 c4 e4> r <a3 c4 e4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> |",
            "r/8 <g3 b3 d4> r <g3 b3 d4> r <g3 b3 d4> r <g3 b3 d4> |",
            "r/8 <g3 d4 e4> r <g3 d4 e4> r <g3 d4 e4> r <g3 d4 e4> |",
            "r/8 <g3 c#4 e4> r <g3 c#4 e4> r <g3 c#4 e4> r <g3 c#4 e4> |",
        ],
    )
    .voice(
        "bass",
        [
            "f1/4 c2 f2 c2 | g1 d2 g2 d2 | e2 b1 e2 b1 | a1 e2 a2 e2 |",
            "f1 c2 f2 c2 | g1 d2 g2 d2 | a1 e2 a2 e2 | a1 c#2 e2 g2 |",
        ],
    )

/// The lift's first eight bars: A's first half a whole step up, in D major.
const LIFT1 = score("the lift, first half", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "d5/8 !mf ( f#5 a5 d6 ~ d6/4 c#6/8 a5 ) | b5/8 ( a5 g5 b5 ~ b5/8 a5 e5/4 ) |",
            "f#5/8 ( a5 d6 f#6 ~ f#6/4 e6/8 d6 ) | e6/4 c#6/8 ( a5 ~ a5/4 ) r/8 a4 |",
            "d5/8 ( c#5 d5 f#5 b5/4 a5/8 f#5 ) | g5/8 ( f#5 g5 b5 d6/4 b5/8 g5 ) |",
            "g#5/8 ( b5 e6 g#5 b5 d6 ~ d6/4 ) | d6/8 ( c#6 b5 a5 g5 f#5 e5 c#5 ) |",
        ],
    )
    .voice(
        "chords",
        [
            "r/8 <a3 d4 f#4> r <a3 d4 f#4> r <a3 d4 f#4> r <a3 d4 f#4> |",
            "r/8 <b3 d4 g4> r <b3 d4 g4> r <a3 c#4 e4> r <a3 c#4 e4> |",
            "r/8 <a3 d4 f#4> r <a3 d4 f#4> r <a3 d4 f#4> r <a3 d4 f#4> |",
            "r/8 <a3 c#4 g4> r <a3 c#4 g4> r <a3 c#4 g4> r <a3 c#4 g4> |",
            "r/8 <b3 d4 f#4> r <b3 d4 f#4> r <b3 d4 f#4> r <b3 d4 f#4> |",
            "r/8 <b3 d4 g4> r <b3 d4 g4> r <b3 d4 g4> r <b3 d4 g4> |",
            "r/8 <b3 d4 g#4> r <b3 d4 g#4> r <b3 d4 g#4> r <b3 d4 g#4> |",
            "r/8 <a3 d4 e4> r <a3 d4 e4> r <a3 c#4 g4> r <a3 c#4 g4> |",
        ],
    )
    .voice(
        "bass",
        [
            "d2/4 a2 d3 a2 | g1 d2 a1 e2 | d2 a2 d3 a2 | a1 c#2 e2 g2 |",
            "b1 f#2 b2 f#2 | g1 d2 g2 d2 | e2 b2 e3 b2 | a1 e2 a2 c#2 |",
        ],
    )

/// The lift's second eight bars: A's second half a whole step up, to forte, and a big D major
/// hit.
const LIFT2 = score("the lift, second half", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "d5/8 ( f#5 a5 d6 ~ d6/4 c#6/8 a5 ) | b5/8 ( a5 g5 b5 ~ b5/8 a#5 c#6/4 ) |",
            "d6/8 ( c#6 b5 f#5 ~ f#5 d5 f#5 b5 ) | b5/8 ( g#5 e5 b5 ~ b5/4 d6/4 ) |",
            "d6/4 ( b5/8 g5 ~ g5 a5 b5 c#6 ) | d6/8 !< ( c#6 a5 f#5 ~ f#5 b5 d#6 f#6 ) |",
            "e6/8 !f ( d6 b5 g5 ~ g5 e5 a5 c#6 | d6/4 ) <f#5 a5 d6>/8 r/8 r/2 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/8 <a3 d4 f#4> r <a3 d4 f#4> r <a3 d4 f#4> r <a3 d4 f#4> |",
            "r/8 <b3 d4 g4> r <b3 d4 g4> r <a#3 c#4 e4> r <a#3 c#4 e4> |",
            "r/8 <b3 d4 f#4> r <b3 d4 f#4> r <b3 d4 f#4> r <b3 d4 f#4> |",
            "r/8 <b3 d4 g#4> r <b3 d4 g#4> r <b3 d4 g#4> r <b3 d4 g#4> |",
            "r/8 <b3 d4 g4> r <b3 d4 g4> r <a3 c#4 e4> r <a3 c#4 e4> |",
            "r/8 <a3 d4 f#4> r <a3 d4 f#4> r <a3 d#4 f#4> r <a3 d#4 f#4> |",
            "r/8 <b3 d4 g4> r <b3 d4 g4> r <a3 c#4 g4> r <a3 c#4 g4> |",
            "r/8 <a3 d4 f#4> <a3 d4 f#4> r/8 r/2 |",
        ],
    )
    .voice(
        "bass",
        [
            "d2/4 a2 d3 a2 | g1 d2 f#2 c#2 | b1 f#2 b2 f#2 | g#2 b2 e2 b2 |",
            "g1 d2 a1 e2 | f#2 a2 b1 d#2 | e2 b1 a1 c#2 | d2/4 <d2 d3>/8 r/8 r/2 |",
        ],
    )

/// The return: D7 and G7, with the yuzu's run up to F6, which lead back to the intro's C.
const RETURN = score("the return", meter(beats: 4, unit: 4))
    .voice("melody", ["f#5/8 !mf ( a5 c6 d6 ~ d6/4 c6/8 a5 ) | g5/8 ( b5 d6 f6 ~ f6/4 ) r |"])
    .voice(
        "chords",
        [
            "r/8 <a3 c4 f#4> r <a3 c4 f#4> r <a3 c4 f#4> r <a3 c4 f#4> |",
            "r/8 <g3 b3 f4> r <g3 b3 f4> r <g3 b3 f4> r <g3 b3 f4> |",
        ],
    )
    .voice("bass", ["d2/4 a2 d3 a2 | g1 b1 d2 f2 |"])

/// The ending, after the last pass: the fanfare's A flat to B flat push, and a C major hit.
const END = score("ending", meter(beats: 4, unit: 4))
    .voice("melody", ["<c5 eb5 ab5>/4. !mf <d5 f5 bb5> r/4 | <c5 e5 g5 c6>/4 r r/2 |"])
    .voice("chords", ["<ab3 c4 eb4>/4. <bb3 d4 f4> r/4 | <g3 c4 e4>/4 r r/2 |"])
    .voice("bass", ["<ab1 ab2>/4. <bb1 bb2> r/4 | <c2 c3>/4 r r/2 |"])

/// Bars in one pass of the piece.
pub const BARS: u32 = 54

/// Bars in the ending.
const END_BARS: u32 = 2

/// The first bars of the seagull and of the lift, in a pass.
const SEAGULL_BAR: u32 = 21
const LIFT_BAR: u32 = 37

/// One pass of the piece: the intro, A, the seagull, the chase, the lift and the return.
pub const SNACK_QUEST: Score = score("Snack Quest", meter(beats: 4, unit: 4))
    .with_tempo("Plucky and determined, at a march")
    .then(INTRO)
    .then(A1)
    .then(A2)
    .then(SEAGULL)
    .then(CHASE)
    .then(LIFT1)
    .then(LIFT2)
    .then(RETURN)

/// How many passes the game plays: 9 minutes of music.
pub const PASSES: u32 = 6

/// `passes` passes of the piece, one after another, then the ending.
pub fn looped(passes: u32) -> Score {
    var s = score("Snack Quest", meter(beats: 4, unit: 4)).with_tempo(SNACK_QUEST.tempo)
    for _ in 0..passes {
        s = take s.then(SNACK_QUEST)
    }
    take s.then(END)
}

/// The player's habits: a steady march pulse (no rubato, no phrase arches in time) with a
/// little weight on each bar's first beat; the melody sung legato over the accompaniment and a
/// little ahead of it; every note not under a slur (the bass, the off-beat chords, the seagull's
/// tiptoe) played at about half its length, so it bounces; high notes a little softer, so they
/// are not hard; and a light pedal, changed with each bass note.
pub fn taste() -> Taste {
    Taste {
        tempo: 144.0,
        lead: "melody",
        voicing: 1.12,
        under: 0.82,
        melody_lead: 0.006,
        bass: "bass",
        bass_weight: 1.0,
        arch_loudness: 0.06,
        arch_peak: 0.6,
        range: 0.75,
        metre: 0.08,
        high_loud: -0.04,
        legato: 0.02,
        detache: 0.45,
        pedal: Pedal::ByVoice { voice: "bass", catch: 0.05, depth: 0.4 },
        ring: 2.0,
        jitter_time: 0.003,
        jitter_velocity: 0.04,
        seed: 3,
    }
}

/// This performance's marks for `passes` passes: the last flourish's chords rolled a little,
/// and the last hit held.
pub fn marks(passes: u32) -> Vec<Mark> {
    var m: Vec<Mark> = Vec::new()
    let last = passes * BARS + END_BARS
    m.push(Mark::Roll { at: bar(last), spread: 0.02 })
    m.push(Mark::Hold { at: bar(last), by: 1.3 })
    m
}

/// The piece as the game plays it: `passes` passes and the ending, performed.
pub fn performance(passes: u32) -> Performance {
    let marks = marks(passes)
    perform(looped(passes), taste(), marks)
}

/// The music: `PASSES` passes of the piece on engine::piano's grand, made on the program's thread,
/// for the game's voice to play (sound.wrela).
pub fn music() -> Piano {
    piano(GRAND, performance(PASSES))
}

@test
fn the_music_is_fifty_four_bars_a_pass_in_three_voices() {
    assert(SNACK_QUEST.bars == BARS)
    assert(SNACK_QUEST.voices.len() == 3)
    assert(SNACK_QUEST.sections.len() == 8)
    assert(SNACK_QUEST.sections[3].first_bar == SEAGULL_BAR)
    assert(SNACK_QUEST.sections[5].first_bar == LIFT_BAR)
    assert(SNACK_QUEST.sections[7].first_bar + SNACK_QUEST.sections[7].bars - 1 == BARS)
    // The seagull starts quietly, on E5; the lift at mezzo-forte, on D5.
    let melody = SNACK_QUEST.voice_named("melody")
    for (at, key, level) in [(SEAGULL_BAR, 76, Level::MP), (LIFT_BAR, 74, Level::MF)] {
        let t = SNACK_QUEST.bar_start(at)
        var found = false
        for n in SNACK_QUEST.notes {
            if n.voice == melody && n.start == t {
                assert(n.key == key, f"bar {at}: {n.key}")
                found = true
            }
        }
        assert(found, f"the melody's note on bar {at}")
        assert(SNACK_QUEST.level_at(t) == level)
    }
}

@test
fn the_music_lifts_a_whole_step() {
    whole_step_up(A1, LIFT1)
    whole_step_up(A2, LIFT2)
}

/// Asserts that every note of `lift`, in every voice, is `a`'s at the same time, two semitones
/// higher.
fn whole_step_up(a: Score, lift: Score) {
    assert(a.bars == 8 && lift.bars == 8)
    assert(a.notes.len() == lift.notes.len(), f"{a.title}: {a.notes.len()} notes")
    for i in 0..a.notes.len() {
        let n = a.notes[i]
        let m = lift.notes[i]
        assert(a.voices[n.voice] == lift.voices[m.voice])
        assert(n.start == m.start && n.length == m.length, f"{a.title}, note {i}")
        assert(m.key == n.key + 2, f"{a.title}, note {i}: {n.key} and {m.key}")
    }
}

@test
fn the_music_lasts_nine_minutes_on_a_steady_pulse() {
    let p = performance(PASSES)
    let s = looped(PASSES)
    assert(s.bars == PASSES * BARS + END_BARS)
    assert(p.notes.len() == s.notes.len())
    // A steady pulse: every beat up to the last bar falls at 144 a minute.
    let beats = (PASSES * BARS + END_BARS - 1) * 4
    for b in 0..beats + 1 {
        let expected = f64(b) * 60.0 / 144.0
        assert(abs(p.beats[b] - expected) < 1e-6, f"beat {b}: {p.beats[b]} s, not {expected}")
    }
    assert(p.length > 540.0, "nine minutes")
    assert(p.length < p.beats[beats] + 8.0, f"{p.length} s")
}

@test
fn the_music_plays_on_the_piano_without_clipping() {
    // The loudest music, on the CPU, as the voice plays it: the lift's second half (forte at its
    // end, a little louder than the game plays it), to the end of its ring. Every sample is
    // finite, and the loudest well under full scale. (Some six bars more are past a test's
    // budget.)
    let loud = score("the loudest bars", meter(beats: 4, unit: 4)).then(LIFT2)
    let p = perform(loud, taste(), [Mark::Swell { over: bars(1, last: 8), by: 1.06 }])
    var voice = piano(GRAND, p)
    var l = [0.0; 128]
    var r = [0.0; 128]
    var peak = 0.0
    for _ in 0..u32(p.length * f64(SAMPLE_RATE) / 128.0) + 1 {
        play_piano(mut voice, mut l, mut r)
        for i in 0..128 {
            // Neither infinite nor not a number: its exponent isn't all ones.
            assert((bitcast_u32(l[i]) >> 23) & 255 != 255, "a finite sample")
            assert((bitcast_u32(r[i]) >> 23) & 255 != 255, "a finite sample")
            peak = max(peak, max(abs(l[i]), abs(r[i])))
        }
    }
    assert(peak > 0.1 && peak < 0.9, f"peak {peak}")
}
