    )
    .voice(
        "chords",
        [
            "r/8 <e3 g3 b3 d4> r <e3 g3 b3 d4> r <e3 g3 b3 d4> r <e3 g3 b3 d4> |",
            "r/8 <c3 e3 g3 b3> r <c3 e3 g3 b3> r <c3 e3 g3 b3> r <c3 e3 g3 b3> |",
            "r/8 <f3 a3 c4 e4> r <f3 a3 c4 e4> r <f3 a3 c4 e4> r <f3 a3 c4 e4> |",
            "r/8 <f3 b3 e4> r <f3 b3 e4> r <f3 b3 e4> r <f3 b3 e4> |",
            "r/8 <d3 g3 b3> r <d3 g3 b3> r <d3 g3 b3> r <d3 g3 b3> |",
            "r/8 <g3 c#4 e4> r <g3 c#4 e4> r <g3 c#4 e4> r <g3 c#4 e4> |",
            "r/8 <f3 a3 c4 e4> r <f3 a3 c4 e4> r <f3 b3 e4> r <f3 b3 e4> |",
