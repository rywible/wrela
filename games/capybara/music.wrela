            "<d5 d6>/2 r/8 <g4 g5>/8 <g#4 g#5> <a4 a5> |",
            "<c5 c6>/8 <b4 b5> <g4 g5>/4 <e4 e5>/2 |",
            "<f4 f5>/8 <e4 e5> <d4 d5>/4 <a4 a5>/4 <b4 b5>/4 |",
            "<c5 c6>/2. r/4 |",
