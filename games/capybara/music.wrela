// The game's music: "Snack Quest", an original piano piece by Claude for a capybara on a quest to
// get its snack back, played by engine::piano. It is an upbeat, groove-driven tune in C major at
// 150 quarter notes a minute, in 4/4, in the style of anime openings and Japanese game themes
// (Ryan, 2026-10-22: the last take had "no rhythm or groove ... generic elevator music"; "it needs
// a discernable rhythm and a real hook ... a central melody that the piece revolves around").
//
// The piece revolves around one hook, two bars long: a rest on the downbeat, "G G A" up to a high
// C, and a push tied over the bar line onto the next chord. Its chords are the "royal road"
// (IV, V, iii, vi), the progression of anime and J-pop choruses. The groove under it is the same
// all through: the bass plays 3 + 3 + 2 eighths (the tresillo), and the chords stab between the
// bass's notes (on 2, the "and" of 3 and the "and" of 4), so the hands lock into a bounce.
//
// One pass is 42 bars, 67 seconds:
// - the intro (4 bars): the hook, twice, plain;
// - the verse (8 bars): the hook's head ("rest, E E G") in a lower voice, asking and answering;
// - the pre-chorus (4 bars): a rising sequence of pushes over a pumping bass, to three hits;
// - the chorus (8 bars): the hook four times, in octaves, forte, to a stop on C;
// - the seagull (8 bars): the hook's rhythm in A minor, quiet and on tiptoe, then a run up;
// - the lift (8 bars): the chorus a whole step up, in D major;
// - the turn (2 bars): the hook's head over G7, back to the intro.
// The form is code (`looped`): the game plays `PASSES` passes (9 minutes), then the hook's head
// and a C major hit.
//
// The playing is tight and on the beat: the pushes accented, everything not tied short and
// bouncing, a light pedal.
//
// The game's main makes the music's piano once (`music`), on the program's thread, and gives it to
// the game's voice (sound.wrela), which plays it with the game's sounds over it.

use engine::perform::{Mark, Pedal, Performance, Taste, bar, bars, perform}
use engine::piano::{Piano, piano, play_piano}
use engine::piano_grand::GRAND
use engine::score::{Level, Score, meter, score}
use std::audio::SAMPLE_RATE
use std::collections::Vec

/// The intro: the hook twice (over F major 7, G, E minor, A minor 7), plain.
const INTRO = score("intro, the hook", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "r/8 g5 !mf g5 a5 c6/4 a5/8 c6 !accent ~ | c6/8 d6 !accent ~ d6 b5 g5/4 r |",
            "r/8 g5 g5 a5 b5/4 g5/8 b5 !accent ~ | b5/8 c6 !accent ~ c6 a5 e5/4 r |",
        ],
    )
    .voice(
        "chords",
        [
            "r/4 <a3 c4 e4>/8 r r <a3 c4 e4> !accent r <a3 c4 e4> |",
            "r/4 <b3 d4 g4>/8 r r <b3 d4 g4> !accent r <b3 d4 g4> |",
            "r/4 <g3 b3 e4>/8 r r <g3 b3 e4> !accent r <g3 b3 e4> |",
            "r/4 <g3 c4 e4>/8 r r <g3 c4 e4> !accent r <g3 c4 e4> |",
        ],
    )
    .voice(
        "bass",
        [
            "<f1 f2>/4. <f1 f2> <c2 c3>/4 | <g1 g2>/4. <g1 g2> <d2 d3>/4 |",
            "<e1 e2>/4. <e1 e2> <b1 b2>/4 | <a1 a2>/4. <a1 a2> <e2 e3>/4 |",
        ],
    )

/// The verse: the hook's head, lower, asking (C, A minor) and answering (F, G), twice, the second
/// time on to D minor 7 and G7 and a little run up.
const VERSE = score("verse", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "r/8 e5 e5 g5 c5/4 r | r/8 e5 e5 g5 a5 g5 e5/4 |",
            "r/8 f5 f5 a5 c6/4 a5/8 f5 | g5/4. d5/8 !accent ~ d5/4 r |",
            "r/8 e5 e5 g5 c5/4 r | r/8 e5 e5 g5 a5 c6 !accent ~ c6/4 |",
            "r/8 d6 c6 a5 f5/4 a5/8 c6 !accent ~ | c6/8 b5 !accent ~ b5/4 r/4 g4/16 a4 b4 d5 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/4 <g3 c4 e4> r <g3 c4 e4> | r <a3 c4 e4> r <a3 c4 e4> |",
            "r <a3 c4 f4> r <a3 c4 f4> | r <b3 d4 g4> r <b3 d4 g4> |",
            "r <g3 c4 e4> r <g3 c4 e4> | r <a3 c4 e4> r <a3 c4 e4> |",
            "r <a3 c4 d4 f4> r <a3 c4 d4 f4> | r <b3 d4 f4> r <b3 d4 f4> |",
        ],
    )
    .voice(
        "bass",
        [
            "c2/4. c2 g1/4 | a1/4. a1 e2/4 | f1/4. f1 c2/4 | g1/4. g1 d2/4 |",
            "c2/4. c2 g1/4 | a1/4. a1 e2/4 | d2/4. d2 a1/4 | g1/4 b1 d2 f2 |",
        ],
    )

/// The pre-chorus: a sequence of pushes climbing (D minor 7, E minor 7, F) over a pumping bass,
/// louder, to three hits on G.
const PRE = score("pre-chorus", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "d5/8 !mf !< f5 a5 a5 !accent ~ a5 g5 a5/4 | e5/8 g5 b5 b5 !accent ~ b5 a5 b5/4 |",
            "f5/8 a5 c6 c6 !accent ~ c6 b5 c6/4 | d6/8 !accent !! r d6 !accent r b5 !accent r r/4 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> |",
            "r/8 <b3 d4 g4> r <b3 d4 g4> r <b3 d4 g4> r <b3 d4 g4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> |",
            "<b3 d4 g4>/8 !accent r <b3 d4 g4> !accent r <b3 d4 g4> !accent r r/4 |",
        ],
    )
    .voice(
        "bass",
        [
            "d2/8 d3 d2 d3 d2 d3 d2 d3 | e2 e3 e2 e3 e2 e3 e2 e3 |",
            "f1 f2 f1 f2 f1 f2 f1 f2 | <g1 g2> r <g1 g2> r <g1 g2> r r/4 |",
        ],
    )

/// The chorus: the hook four times, in octaves, forte, over the royal road (F major 7, G,
/// E minor, A minor 7, twice), the last time climbing to F6 on G7 and down to a stop on C.
const CHORUS = score("chorus", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "r/8 <g4 g5> !f <g4 g5> <a4 a5> <c5 c6>/4 <a4 a5>/8 <c5 c6> !accent ~ |",
            "<c5 c6>/8 <d5 d6> !accent ~ <d5 d6> <b4 b5> <g4 g5>/4 r |",
            "r/8 <g4 g5> <g4 g5> <a4 a5> <b4 b5>/4 <g4 g5>/8 <b4 b5> !accent ~ |",
            "<b4 b5>/8 <c5 c6> !accent ~ <c5 c6> <a4 a5> <e4 e5>/4 r |",
            "r/8 <g4 g5> <g4 g5> <a4 a5> <c5 c6>/4 <a4 a5>/8 <c5 c6> !accent ~ |",
            "<c5 c6>/8 <d5 d6> !accent ~ <d5 d6> <e5 e6> <f5 f6>/4 <d5 d6> |",
            "<e5 e6>/4. !accent <d5 d6>/8 <c5 c6>/4 <g4 g5>/8 <c5 c6> !accent ~ |",
            "<c5 c6>/4 r r/2 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/4 <a3 c4 e4>/8 r r <a3 c4 e4> !accent r <a3 c4 e4> |",
            "r/4 <b3 d4 g4>/8 r r <b3 d4 g4> !accent r <b3 d4 g4> |",
            "r/4 <g3 b3 e4>/8 r r <g3 b3 e4> !accent r <g3 b3 e4> |",
            "r/4 <g3 c4 e4>/8 r r <g3 c4 e4> !accent r <g3 c4 e4> |",
            "r/4 <a3 c4 e4>/8 r r <a3 c4 e4> !accent r <a3 c4 e4> |",
            "r/4 <b3 d4 f4>/8 r r <b3 d4 f4> !accent r <b3 d4 f4> |",
            "r/4 <g3 c4 e4>/8 r r <g3 c4 e4> !accent r <g3 c4 e4> |",
            "<g3 c4 e4>/4 r r/2 |",
        ],
    )
    .voice(
        "bass",
        [
            "<f1 f2>/4. <f1 f2> <c2 c3>/4 | <g1 g2>/4. <g1 g2> <d2 d3>/4 |",
            "<e1 e2>/4. <e1 e2> <b1 b2>/4 | <a1 a2>/4. <a1 a2> <e2 e3>/4 |",
            "<f1 f2>/4. <f1 f2> <c2 c3>/4 | <g1 g2>/4. <g1 g2> <d2 d3>/4 |",
            "<c2 c3>/4. <c2 c3> <g1 g2>/4 | <c2 c3>/4 r r/2 |",
        ],
    )

/// The seagull: the hook's rhythm in A minor, quiet and on tiptoe (A minor, E7, F), the bass
/// plucked on 1 and 3, then a run up on A7 into the lift.
const SEAGULL = score("the seagull", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "r/8 a4 !mp a4 b4 c5 r a4 r | r g#4 g#4 a4 b4 r e4 r |",
            "r a4 a4 b4 c5 e5 a5 r | g#5 r e5 r d5 r b4 r |",
            "r c5 c5 d5 f5 r c5 r | r b4 b4 c5 d5 r b4 r |",
            "c5 b4 a4 g#4 a4 r e5 r | r/4 a4/16 !< b4 c#5 d5 e5 f#5 g5 a5 b5 c#6 d6 e6 !! |",
        ],
    )
    .voice(
        "chords",
        [
            "r/4 <a3 c4 e4> !staccato r <a3 c4 e4> !staccato |",
            "r <g#3 b3 d4> !staccato r <g#3 b3 d4> !staccato |",
            "r <a3 c4 e4> !staccato r <a3 c4 e4> !staccato |",
            "r <g#3 b3 d4> !staccato r <g#3 b3 d4> !staccato |",
            "r <a3 c4 f4> !staccato r <a3 c4 f4> !staccato |",
            "r <g#3 b3 d4> !staccato r <g#3 b3 d4> !staccato |",
            "r <a3 c4 e4> !staccato r <a3 c4 e4> !staccato |",
            "r <a3 c#4 g4> r <a3 c#4 g4> |",
        ],
    )
    .voice(
        "bass",
        [
            "a1/4 r e2 r | e2 r b1 r | a1 r e2 r | e2 r b1 r |",
            "f1 r c2 r | e2 r b1 r | a1 r e2 r | a1 c#2 e2 g2 |",
        ],
    )

/// The lift: the chorus a whole step up, in D major.
const LIFT = score("the lift", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "r/8 <a4 a5> !f <a4 a5> <b4 b5> <d5 d6>/4 <b4 b5>/8 <d5 d6> !accent ~ |",
            "<d5 d6>/8 <e5 e6> !accent ~ <e5 e6> <c#5 c#6> <a4 a5>/4 r |",
            "r/8 <a4 a5> <a4 a5> <b4 b5> <c#5 c#6>/4 <a4 a5>/8 <c#5 c#6> !accent ~ |",
            "<c#5 c#6>/8 <d5 d6> !accent ~ <d5 d6> <b4 b5> <f#4 f#5>/4 r |",
            "r/8 <a4 a5> <a4 a5> <b4 b5> <d5 d6>/4 <b4 b5>/8 <d5 d6> !accent ~ |",
            "<d5 d6>/8 <e5 e6> !accent ~ <e5 e6> <f#5 f#6> <g5 g6>/4 <e5 e6> |",
            "<f#5 f#6>/4. !accent <e5 e6>/8 <d5 d6>/4 <a4 a5>/8 <d5 d6> !accent ~ |",
            "<d5 d6>/4 r r/2 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/4 <b3 d4 f#4>/8 r r <b3 d4 f#4> !accent r <b3 d4 f#4> |",
            "r/4 <c#4 e4 a4>/8 r r <c#4 e4 a4> !accent r <c#4 e4 a4> |",
            "r/4 <a3 c#4 f#4>/8 r r <a3 c#4 f#4> !accent r <a3 c#4 f#4> |",
            "r/4 <a3 d4 f#4>/8 r r <a3 d4 f#4> !accent r <a3 d4 f#4> |",
            "r/4 <b3 d4 f#4>/8 r r <b3 d4 f#4> !accent r <b3 d4 f#4> |",
            "r/4 <c#4 e4 g4>/8 r r <c#4 e4 g4> !accent r <c#4 e4 g4> |",
            "r/4 <a3 d4 f#4>/8 r r <a3 d4 f#4> !accent r <a3 d4 f#4> |",
            "<a3 d4 f#4>/4 r r/2 |",
        ],
    )
    .voice(
        "bass",
        [
            "<g1 g2>/4. <g1 g2> <d2 d3>/4 | <a1 a2>/4. <a1 a2> <e2 e3>/4 |",
            "<f#1 f#2>/4. <f#1 f#2> <c#2 c#3>/4 | <b1 b2>/4. <b1 b2> <f#2 f#3>/4 |",
            "<g1 g2>/4. <g1 g2> <d2 d3>/4 | <a1 a2>/4. <a1 a2> <e2 e3>/4 |",
            "<d2 d3>/4. <d2 d3> <a1 a2>/4 | <d2 d3>/4 r r/2 |",
        ],
    )

/// The turn: the hook's head twice over G7, the bass pumping, back to the intro's C major.
const TURN = score("the turn", meter(beats: 4, unit: 4))
    .voice("melody", ["r/8 g5 !mf g5 a5 b5/4 g5 | r/8 g5 g5 a5 d6/4 f6 |"])
    .voice(
        "chords",
        [
            "r/4 <b3 d4 f4>/8 r r <b3 d4 f4> !accent r <b3 d4 f4> |",
            "r/4 <b3 d4 f4>/8 r r <b3 d4 f4> !accent r <b3 d4 f4> |",
        ],
    )
    .voice("bass", ["g1/8 g2 g1 g2 g1 g2 g1 g2 | g1 g2 g1 g2 b1 d2 f2 g2 |"])

/// The ending, after the last pass: the hook's head and a C major hit.
const END = score("ending", meter(beats: 4, unit: 4))
    .voice("melody", ["r/8 g5 !f g5 a5 <e5 g5 c6>/4 !accent r | <c5 e5 g5 c6>/4 !accent r r/2 |"])
    .voice("chords", ["r/2 <g3 c4 e4>/4 r | <g3 c4 e4>/4 r r/2 |"])
    .voice("bass", ["r/2 <c2 c3>/4 r | <c2 c3>/4 r r/2 |"])

/// Bars in one pass of the piece.
pub const BARS: u32 = 42

/// Bars in the ending.
const END_BARS: u32 = 2

/// The first bars of the chorus, the seagull and the lift, in a pass.
const CHORUS_BAR: u32 = 17
const SEAGULL_BAR: u32 = 25
const LIFT_BAR: u32 = 33

/// One pass of the piece: the intro, the verse, the pre-chorus, the chorus, the seagull, the lift
/// and the turn.
pub const SNACK_QUEST: Score = score("Snack Quest", meter(beats: 4, unit: 4))
    .with_tempo("Upbeat, with a bounce")
    .then(INTRO)
    .then(VERSE)
    .then(PRE)
    .then(CHORUS)
    .then(SEAGULL)
    .then(LIFT)
    .then(TURN)

/// How many passes the game plays: 9 minutes of music.
pub const PASSES: u32 = 8

/// `passes` passes of the piece, one after another, then the ending.
pub fn looped(passes: u32) -> Score {
    var s = score("Snack Quest", meter(beats: 4, unit: 4)).with_tempo(SNACK_QUEST.tempo)
    for _ in 0..passes {
        s = take s.then(SNACK_QUEST)
    }
    take s.then(END)
}

/// The player's habits: tight and on the beat (no rubato, no phrase arches in time, the melody
/// with the rest), a little weight on each bar's first beat and on the accented pushes; the
/// melody over the accompaniment; every note not tied or slurred played at about two thirds of
/// its length, so the groove bounces; high notes a little softer, so they are not hard; and a
/// light pedal, changed with each bass note.
pub fn taste() -> Taste {
    Taste {
        tempo: 150.0,
        lead: "melody",
        voicing: 1.1,
        under: 0.92,
        bass: "bass",
        bass_weight: 1.05,
        range: 0.75,
        metre: 0.1,
        high_loud: -0.05,
        accent: 0.3,
        legato: 0.02,
        detache: 0.35,
        pedal: Pedal::ByVoice { voice: "bass", catch: 0.04, depth: 0.25 },
        ring: 1.5,
        jitter_time: 0.002,
        jitter_velocity: 0.04,
        seed: 3,
    }
}

/// This performance's marks for `passes` passes: the last flourish's chords rolled a little,
/// and the last hit held.
pub fn marks(passes: u32) -> Vec<Mark> {
    var m: Vec<Mark> = Vec::new()
    let last = passes * BARS + END_BARS
    m.push(Mark::Roll { at: bar(last), spread: 0.02 })
    m.push(Mark::Hold { at: bar(last), by: 1.3 })
    m
}

/// The piece as the game plays it: `passes` passes and the ending, performed.
pub fn performance(passes: u32) -> Performance {
    let marks = marks(passes)
    perform(looped(passes), taste(), marks)
}

/// The music: `PASSES` passes of the piece on engine::piano's grand, made on the program's thread,
/// for the game's voice to play (sound.wrela).
pub fn music() -> Piano {
    piano(GRAND, performance(PASSES))
}

@test
fn the_music_is_forty_two_bars_a_pass_in_three_voices() {
    assert(SNACK_QUEST.bars == BARS)
    assert(SNACK_QUEST.voices.len() == 3)
    assert(SNACK_QUEST.sections.len() == 7)
    assert(SNACK_QUEST.sections[3].first_bar == CHORUS_BAR)
    assert(SNACK_QUEST.sections[4].first_bar == SEAGULL_BAR)
    assert(SNACK_QUEST.sections[5].first_bar == LIFT_BAR)
    assert(SNACK_QUEST.sections[6].first_bar + SNACK_QUEST.sections[6].bars - 1 == BARS)
    // Each starts with a rest, and its first note an eighth in: the chorus forte on G, the
    // seagull quiet on A, the lift forte on A.
    let melody = SNACK_QUEST.voice_named("melody")
    let eighth = SNACK_QUEST.meter.beat() / 2
    for (at, key, level) in [
        (CHORUS_BAR, 79, Level::F),
        (SEAGULL_BAR, 69, Level::MP),
        (LIFT_BAR, 81, Level::F),
    ] {
        let t = SNACK_QUEST.bar_start(at)
        var first = SNACK_QUEST.length()
        var top = 0
        for n in SNACK_QUEST.notes {
            if n.voice == melody && n.start >= t && n.start <= first {
                first = n.start
                top = max(top, n.key)
            }
        }
        assert(first == t + eighth, f"bar {at}: the first note at {first - t}")
        assert(top == key, f"bar {at}: {top}")
        assert(SNACK_QUEST.level_at(first) == level)
    }
}

@test
fn the_hook_opens_the_piece_and_is_its_chorus() {
    // Every note of the intro's melody is the chorus's, at the same time and for as long, in
    // octaves; and the lift's, a whole step up.
    assert(hooked(INTRO, CHORUS, up: 0) == 18)
    assert(hooked(INTRO, LIFT, up: 2) == 18)
}

/// How many notes of `hook`'s melody `passage` plays at the same time and for as long, `up`
/// semitones higher, in octaves; asserts that it plays them all.
fn hooked(hook: Score, passage: Score, up: u32) -> u32 {
    let melody = hook.voice_named("melody")
    var found = 0
    for n in hook.notes {
        if n.voice != melody {
            continue
        }
        var high = false
        var low = false
        for m in passage.notes {
            if m.start == n.start && m.length == n.length {
                high = high || m.key == n.key + up
                low = low || m.key + 12 == n.key + up
            }
        }
        assert(high && low, f"{passage.title}: the hook's note at {n.start}")
        found += 1
    }
    found
}

@test
fn the_music_lifts_a_whole_step() {
    whole_step_up(CHORUS, LIFT)
}

/// Asserts that every note of `lift`, in every voice, is `a`'s at the same time, two semitones
/// higher.
fn whole_step_up(a: Score, lift: Score) {
    assert(a.bars == 8 && lift.bars == 8)
    assert(a.notes.len() == lift.notes.len(), f"{a.title}: {a.notes.len()} notes")
    for i in 0..a.notes.len() {
        let n = a.notes[i]
        let m = lift.notes[i]
        assert(a.voices[n.voice] == lift.voices[m.voice])
        assert(n.start == m.start && n.length == m.length, f"{a.title}, note {i}")
        assert(m.key == n.key + 2, f"{a.title}, note {i}: {n.key} and {m.key}")
    }
}

@test
fn the_music_lasts_nine_minutes_on_a_steady_pulse() {
    let p = performance(PASSES)
    let s = looped(PASSES)
    assert(s.bars == PASSES * BARS + END_BARS)
    assert(p.notes.len() == s.notes.len())
    // A steady pulse: every beat up to the last bar falls at 150 a minute.
    let beats = (PASSES * BARS + END_BARS - 1) * 4
    for b in 0..beats + 1 {
        let expected = f64(b) * 60.0 / 150.0
        assert(abs(p.beats[b] - expected) < 1e-6, f"beat {b}: {p.beats[b]} s, not {expected}")
    }
    assert(p.length > 540.0, "nine minutes")
    assert(p.length < p.beats[beats] + 8.0, f"{p.length} s")
}

@test
fn the_music_plays_on_the_piano_without_clipping() {
    // The loudest music, on the CPU, as the voice plays it: the lift (forte, in octaves, a little
    // louder than the game plays it), to the end of its ring. Every sample is finite, and the
    // loudest well under full scale.
    let loud = score("the loudest bars", meter(beats: 4, unit: 4)).then(LIFT)
    let p = perform(loud, taste(), [Mark::Swell { over: bars(1, last: 8), by: 1.06 }])
    var voice = piano(GRAND, p)
    var l = [0.0; 128]
    var r = [0.0; 128]
    var peak = 0.0
    for _ in 0..u32(p.length * f64(SAMPLE_RATE) / 128.0) + 1 {
        play_piano(mut voice, mut l, mut r)
        for i in 0..128 {
            // Neither infinite nor not a number: its exponent isn't all ones.
            assert((bitcast_u32(l[i]) >> 23) & 255 != 255, "a finite sample")
            assert((bitcast_u32(r[i]) >> 23) & 255 != 255, "a finite sample")
            peak = max(peak, max(abs(l[i]), abs(r[i])))
        }
    }
    assert(peak > 0.1 && peak < 0.9, f"peak {peak}")
}
