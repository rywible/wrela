            "<e2 e3>/4. <e2 e3>/8 r/8 <b1 b2>/8 <e2 e3>/4 |",
            "<a1 a2>/4. <a1 a2>/8 r/8 <e2 e3>/8 <a1 a2>/4 |",
            "<d2 d3>/4. <d2 d3>/8 r/8 <g1 g2>/8 <g1 g2>/4 |",
            "<c2 c3>/4 r r/2 |",
        ],
    )
    .voice(
        "shimmer",
        [
            "r/1 | r/2 r/4 b6/16 d7 e7 g7 | r/1 | r/2 r/4 e7/16 d7 b6 f6 |",
            "r/1 | r/2 r/4 c#7/16 e7 g7 a7 | r/1 | r/2 r/4 d7/16 b6 g6 e6 |",
