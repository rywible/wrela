// The game's music: "Snack Quest", an original piano piece by Claude for a capybara on a quest to
// get its snack back, played by engine::piano. It is a bright, plucky adventure march in C major
// at 144 quarter notes a minute, in 4/4, in the style of the cheerful overworld themes of
// Japanese games and upbeat anime openings: a heroic, hummable hook with octave leaps, pushes
// tied over the beat and quick runs, over a bouncing bass on every beat and light chords on the
// off-beats, a gallop.
//
// The piece is 54 bars, 90 seconds:
// - the intro (4 bars): a fanfare. A C major hit, the yuzu (a sparkling run up to G6), and a
//   heroic A flat to B flat push;
// - A (16 bars, C major): the hook, twice, on to a big C major hit;
// - the seagull (8 bars): sneaky and quiet, a tiptoe figure in short notes with chromatic steps
//   (C sharp diminished, A flat 7), then a run up into the chase;
// - the chase (8 bars): determined, with repeated notes and a sequence that climbs F, G, E
//   minor, A minor, to forte on A7, which leads up a step;
// - the lift (16 bars): A again, a whole step up in D major, triumphant, to forte;
// - the return (2 bars): D7 and G7 with the yuzu's run, which lead back to the intro's C.
// The form is code (`looped`), so the return turns each pass round into the next, and the game
// plays `PASSES` passes (9 minutes) and a last flourish: the A flat to B flat push and a C major
// hit.
//
// The playing is mostly mezzo-forte with forte peaks, on a steady pulse: the melody legato and
// sung over the accompaniment, everything else detached and bouncy. High notes are a little
// softer, so they sparkle and are not hard.
//
// The game's main makes the music's piano once (`music`), on the program's thread, and gives it to
// the game's voice (sound.wrela), which plays it with the game's sounds over it.

use engine::perform::{Mark, Pedal, Performance, Taste, bar, bars, perform}
use engine::piano::{Piano, piano, play_piano}
use engine::piano_grand::GRAND
use engine::score::{Level, Score, meter, score}
use std::audio::SAMPLE_RATE
use std::collections::Vec

/// The intro: a fanfare (C, F over C, A flat to B flat, F to G7), with the yuzu's sparkling run.
/// It also turns each pass round into the next.
const INTRO = score("intro, the fanfare", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "<c5 e5 g5 c6>/8 !mf r r/4 g5/16 a5 b5 c6 e6/8 g6 |",
            "<f5 a5 c6>/8 r <e5 g5 c6> r r c6 d6 e6 |",
            "<c5 eb5 ab5>/4. <d5 f5 bb5> r/8 g5 | a5/8 ( g5 f5 a5 g5 f5 d5 b4 ) |",
        ],
    )
    .voice(
        "chords",
        [
            "<g3 c4 e4>/8 r r/4 r/2 |",
            "<a3 c4 f4>/8 r <g3 c4 e4> r r/2 |",
            "<ab3 c4 eb4>/4. <bb3 d4 f4> r/4 |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <g3 b3 f4> r <g3 b3 f4> |",
        ],
    )
    .voice(
        "bass",
        [
            "<c2 c3>/8 r r/4 r/2 | <f1 f2>/8 r <c2 c3> r r/2 | <ab1 ab2>/4. <bb1 bb2> r/4 | f1/4 c2 g1 d2 |",
        ],
    )

/// A's first eight bars: the hook (up the C major chord to an octave leap), then A minor, F, D7
/// and a run down on G7.
const A1 = score("A, first half", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "c5/8 !mf ( e5 g5 c6 ~ c6/4 b5/8 g5 ) | a5/8 ( g5 f5 a5 ~ a5/8 g5 d5/4 ) |",
            "e5/8 ( g5 c6 e6 ~ e6/4 d6/8 c6 ) | d6/4 b5/8 ( g5 ~ g5/4 ) r/8 g4 |",
            "c5/8 ( b4 c5 e5 a5/4 g5/8 e5 ) | f5/8 ( e5 f5 a5 c6/4 a5/8 f5 ) |",
            "f#5/8 ( a5 d6 f#5 a5 c6 ~ c6/4 ) | c6/8 ( b5 a5 g5 f5 e5 d5 b4 ) |",
        ],
    )
    .voice(
        "chords",
        [
            "r/8 <g3 c4 e4> r <g3 c4 e4> r <g3 c4 e4> r <g3 c4 e4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <g3 b3 d4> r <g3 b3 d4> |",
            "r/8 <g3 c4 e4> r <g3 c4 e4> r <g3 c4 e4> r <g3 c4 e4> |",
            "r/8 <g3 b3 f4> r <g3 b3 f4> r <g3 b3 f4> r <g3 b3 f4> |",
            "r/8 <a3 c4 e4> r <a3 c4 e4> r <a3 c4 e4> r <a3 c4 e4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> r <a3 c4 f4> |",
            "r/8 <a3 c4 f#4> r <a3 c4 f#4> r <a3 c4 f#4> r <a3 c4 f#4> |",
            "r/8 <g3 c4 d4> r <g3 c4 d4> r <g3 b3 f4> r <g3 b3 f4> |",
        ],
    )
    .voice(
        "bass",
        [
            "c2/4 g2 c3 g2 | f1 c2 g1 d2 | c2 g2 c3 g2 | g1 b1 d2 f2 |",
            "a1 e2 a2 e2 | f1 c2 f2 c2 | d2 a2 d3 a2 | g1 d2 g2 b1 |",
        ],
    )

/// A's second eight bars: the hook again, then round the circle of fifths (E7, A minor, D7, A7,
/// D minor 7, G7) to a big C major hit.
const A2 = score("A, second half", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "c5/8 ( e5 g5 c6 ~ c6/4 b5/8 g5 ) | a5/8 ( g5 f5 a5 ~ a5/8 g#5 b5/4 ) |",
            "c6/8 ( b5 a5 e5 ~ e5 c5 e5 a5 ) | a5/8 ( f#5 d5 a5 ~ a5/4 c6/4 ) |",
            "c6/4 ( a5/8 f5 ~ f5 g5 a5 b5 ) | c6/8 ( b5 g5 e5 ~ e5 a5 c#6 e6 ) |",
            "d6/8 ( c6 a5 f5 ~ f5 d5 g5 b5 | c6/4 ) <e5 g5 c6>/8 r/8 r/2 |",
        ],
    )
    .voice(
        "chords",
        [
            "r/8 <g3 c4 e4> r <g3 c4 e4> r <g3 c4 e4> r <g3 c4 e4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <g#3 b3 d4> r <g#3 b3 d4> |",
            "r/8 <a3 c4 e4> r <a3 c4 e4> r <a3 c4 e4> r <a3 c4 e4> |",
            "r/8 <a3 c4 f#4> r <a3 c4 f#4> r <a3 c4 f#4> r <a3 c4 f#4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <g3 b3 d4> r <g3 b3 d4> |",
            "r/8 <g3 c4 e4> r <g3 c4 e4> r <g3 c#4 e4> r <g3 c#4 e4> |",
            "r/8 <a3 c4 f4> r <a3 c4 f4> r <g3 b3 f4> r <g3 b3 f4> |",
            "r/8 <g3 c4 e4> <g3 c4 e4> r/8 r/2 |",
        ],
    )
    .voice(
        "bass",
        [
            "c2/4 g2 c3 g2 | f1 c2 e2 b1 | a1 e2 a2 e2 | f#2 a2 d2 a2 |",
            "f1 c2 g1 d2 | e2 g2 a1 c#2 | d2 a1 g1 b1 | c2/4 <c2 c3>/8 r/8 r/2 |",
        ],
