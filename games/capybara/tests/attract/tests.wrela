// The tool test: the capybara game's play build, built into `scratch/attract`, loaded on the CPU
// recording its commands, made to play itself as its address's `#attract` makes it, and its first
// frames' commands read back. The native host has no address to give (docs/toolchain-gaps.md), so
// the test calls the export that does what that answer does (main.wrela's `play_itself`).

use hosts::both::bytes_of
use hosts::steps::{built, recorded, stepped}
use std::input::Script
use std::tool::drive
use std::tool::drive::Step
use std::tool::toolchain
use std::tool::toolchain::Override

/// The frames driven: a few seconds of the first level.
const FRAMES: u32 = 240

/// The voice's quanta rendered: two seconds.
const QUANTA: u32 = 750

/// The host services the game playing itself may ask for: its address, what the host can do and
/// its pixel ratio, telling the console it's ready, and waiting for the console's call that lets
/// its run go.
const ASKS: [Text; 4] = ["nav/location", "environment", "surface/ready", "channel/receive"]

/// The game playing itself plays from its first whole frame, telling the console so, and asks for
/// nothing but that, its address, the host's environment and the console's call that lets its run
/// go: no storage read or written, nothing posted, nothing fetched but its own files, and no voice.
@test(tool, read: [("repo", "../../../..")], budget: 300)
fn the_game_playing_itself_says_its_ready_and_asks_for_no_storage_or_network() {
    var options = toolchain::options()
    for (name, dir) in [("engine", "engine"), ("ui", "ui"), ("platform", "platform")] {
        options.overrides.push(
            Override { name: String::from(name), dir: String::from(f"repo/{dir}") },
        )
    }
    built("repo/games/capybara", "scratch/attract", options, "the play build builds")
    var load = drive::cpu()
    load.record = true
    let Ok(it) = drive::load("scratch/attract", load).wait() else { panic("the build loads") }
    let h = it.build
    stepped(
        h,
        [
            Step::Init,
            Step::Call(String::from("play_itself"), Vec::new()),
            Step::Frames(FRAMES, Script::frames()),
        ],
        "its frames",
    )
    var ready = 0
    for c in recorded(h) {
        let kind = c.kind.as_str()
        let target = c.target.as_str()
        assert(kind != "StorageWrite" && kind != "StorageRead", f"{kind} of {target}")
        assert(kind != "Post", f"a post to {target}")
        assert(kind != "Fetch" || target.find("://").is_none(), f"a fetch of {target}")
        if kind == "HostRequest" {
            var known = false
            for ask in ASKS {
                if target == ask { known = true }
            }
            assert(known, f"a request of the host's `{target}`")
            if target == "surface/ready" { ready += 1 }
        }
    }
    assert(ready == 1, f"it said it's ready {ready} times")
    // No voice plays: two seconds of it, rendered, are silence, or there's none to render.
    let Ok(heard) = drive::steps(h, [Step::Audio(QUANTA, false)]).wait() else { return }
    if heard.trap.is_some() || heard.audio.is_empty() { return }
    for b in bytes_of(heard.audio[0].samples.clone()) { assert(b == 0, "a voice sounds") }
}
