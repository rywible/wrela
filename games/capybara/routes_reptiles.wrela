    hold(RIGHT | UP | JUMP, 6),
    hold(JUMP, 12),
    hold(RIGHT | UP | JUMP, 6),
    hold(JUMP, 6),
    hold(RIGHT | DOWN | JUMP, 12),
    hold(RIGHT | JUMP, 18),
    hold(RIGHT | UP | JUMP, 6),
    hold(RIGHT | JUMP, 18),
    hold(LEFT | DOWN, 1),
]

/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level reptiles --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 281.46, 172.65, 290.22, 172.65]

@test
fn the_searched_runs_of_reptiles_finish_in_their_times_without_a_death() {
    let every = course(REPTILES).every_snack()
    let any = play(REPTILES, ANY)
    let full = play(REPTILES, FULL)
    assert(any.finished == 3133 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 3631 && full.deaths == 0 && full.snacks == every)
    let human_any = play(REPTILES, HUMAN_ANY)
    let human_full = play(REPTILES, HUMAN_FULL)
    assert(human_any.finished == 3407 && human_any.deaths == 0)
    assert(human_full.finished == 3631 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
