// The leaderboard's search for a name (design.md, "Online play": searching names). Every name is
// drawn from platform/names.wrela's lists, a title, a noun made of two halves and an epithet, so
// each part completes from its list as it's typed ("wob" gives Wobblesnout), and a controller,
// which can't type, picks each part from its list instead. The console's server finds the names
// whose parts start with what the search holds (link.wrela's `Names`); this is only the typing.

use platform::names::{BACKS, EPITHETS, FRONTS, TITLES}

/// A name's parts, in the order the search holds them.
pub const TITLE: u32 = 0
pub const NOUN: u32 = 1
pub const EPITHET: u32 = 2
pub const PARTS: u32 = 3

/// The most bytes a part holds (wire.wrela's `MOST_PART`).
const MOST: u32 = 32

/// The search: what each part holds, as typed or picked, the part the keys go to, and which of
/// its completions is picked in place of what was typed (0: none, `n`: the `n`th).
pub struct Search: Clone {
    pub parts: Vec<String>,
    pub part: u32,
    pub pick: u32,
}

/// An empty search, on the title.
pub fn search() -> Search {
    Search { parts: Vec::from([String::new(), String::new(), String::new()]), part: TITLE, pick: 0 }
}

/// `s` in lower case, ASCII only.
fn lower(s: str) -> String {
    var out = String::new()
    for i in 0..s.len() {
        let b = s.byte(i)
        out.push_byte(if b >= 65 && b <= 90 { b + 32 } else { b })
    }
    out
}

/// Whether `s` starts with `prefix`, in any case.
fn starts(s: str, prefix: str) -> bool {
    s.len() >= prefix.len() && lower(s.slice(0, prefix.len())) == lower(prefix)
}

/// The entries of `list` that start with `typed`.
fn listed(list: [Text], typed: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for i in 0..list.len() {
        if starts(list[i], typed) {
            out.push(String::from(list[i]))
        }
    }
    out
}

/// What part `part` may be once it starts with `typed`, in its list's order. A noun's halves come
/// one at a time while more than one first half fits ("w" gives Wobble, Waddle...), and whole once
/// one does ("wob" gives Wobblesnout, Wobblepaw...), so a list to pick from stays short.
pub fn completions(part: u32, typed: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    if part == TITLE {
        return listed(TITLES, typed)
    } else if part == EPITHET {
        return listed(EPITHETS, typed)
    }
    var fronts: Vec<u32> = Vec::new()
    var whole = false
    for f in 0..FRONTS.len() {
        let front = FRONTS[f]
        if starts(front, typed) {
            fronts.push(f)
        } else if typed.len() > front.len() && starts(typed, front) {
            fronts.push(f)
            whole = true
        }
    }
    if fronts.len() > 1 && !whole {
        for f in fronts {
            out.push(String::from(FRONTS[f]))
        }
        return out
    }
    for f in fronts {
        for b in 0..BACKS.len() {
            let noun = f"{FRONTS[f]}{BACKS[b]}"
            if starts(noun.as_str(), typed) {
                out.push(take noun)
            }
        }
    }
    out
}

impl Search {
    /// What part `part` holds: as typed, or the completion picked for the part the keys are on.
    pub fn value(self, part: u32) -> String {
        if part == self.part && self.pick > 0 {
            let all = completions(part, self.parts[part].as_str())
            if self.pick <= all.len() {
                return all[self.pick - 1].clone()
            }
        }
        self.parts[part].clone()
    }

    /// What the first completion of the part the keys are on adds to what's typed, for a hint: none
    /// while one is picked, or when nothing is typed.
    pub fn hint(self) -> String {
        borrow typed = self.parts[self.part]
        if self.pick > 0 || typed.is_empty() {
            return String::new()
        }
        let all = completions(self.part, typed.as_str())
        if all.is_empty() || all[0].len() <= typed.len() {
            return String::new()
        }
        String::from(all[0].as_str().slice(typed.len(), all[0].len()))
    }

    /// The picked completion made what's typed.
    fn settle(mut self) {
        let v = self.value(self.part)
        self.parts[self.part] = take v
        self.pick = 0
    }

    /// A character typed: a letter or a hyphen goes on the part, and so does a space where a title
    /// goes on with one ("Head Keeper"); any other space takes the hint and moves on a part.
    /// Whether the search changed.
    pub fn typed(mut self, char: u32) -> bool {
        let letter = (char >= 65 && char <= 90) || (char >= 97 && char <= 122)
        if char == 32 {
            self.settle()
            borrow typed = self.parts[self.part]
            let spaced = f"{typed} "
            if self.part == TITLE &&
                !typed.is_empty() &&
                !completions(TITLE, spaced.as_str()).is_empty() {
                self.parts[self.part].push_byte(32)
                return true
            }
            return self.accept()
        }
        if !letter && char != 45 {
            return false
        }
        self.settle()
        if self.parts[self.part].len() >= MOST {
            return false
        }
        self.parts[self.part].push_byte(u8(char))
        true
    }

    /// Backspace: the part's last character goes; from an empty part, back to the one before.
    pub fn erase(mut self) -> bool {
        self.settle()
        let n = self.parts[self.part].len()
        if n > 0 {
            self.parts[self.part].truncate(n - 1)
            return true
        }
        if self.part > TITLE {
            self.part -= 1
        }
        false
    }

    /// The completion picked, or the first one, taken (in its list's case), and on to the next
    /// part.
    pub fn accept(mut self) -> bool {
        self.settle()
        let typed = self.parts[self.part].clone()
        if !typed.is_empty() {
            let all = completions(self.part, typed.as_str())
            if !all.is_empty() {
                self.parts[self.part] = all[0].clone()
            }
        }
        self.to(min(self.part + 1, PARTS - 1))
        true
    }

    /// The keys to part `part`, what was picked kept.
    pub fn to(mut self, part: u32) {
        self.settle()
        self.part = min(part, PARTS - 1)
    }

    /// The pick moved `by` along the part's completions, round through what was typed.
    pub fn turn(mut self, by: i32) -> bool {
        let n = i32(completions(self.part, self.parts[self.part].as_str()).len()) + 1
        if n == 1 {
            return false
        }
        self.pick = u32(((i32(self.pick) + by) % n + n) % n)
        true
    }

    /// Whether every part is empty.
    pub fn blank(self) -> bool {
        for p in 0..PARTS {
            if !self.value(p).is_empty() {
                return false
            }
        }
        true
    }
}

// ---- tests -------------------------------------------------------------------------------------

@test
fn each_part_completes_from_its_own_list() {
    let sirs = completions(TITLE, "s")
    assert(sirs[0] == String::from("Sir") && sirs.len() >= 3, "Sir, Squire, Sheriff...")
    for t in completions(TITLE, "HEAD") {
        assert(t.as_str().starts_with("Head"), "any case")
    }
    let unh = completions(EPITHET, "unh")
    assert(unh[0] == String::from("Unhurried"))
    assert(completions(EPITHET, "zzz").is_empty(), "nothing starts so")
    // A noun's first halves while several fit, then the whole nouns of the one that does.
    let w = completions(NOUN, "w")
    assert(w.len() > 1 && w[0] == String::from("Wobble"), "first halves")
    let wob = completions(NOUN, "wob")
    assert(
        wob[0] == String::from("Wobblesnout") && wob.len() == BACKS.len(),
        "wob gives Wobblesnout",
    )
    let paw = completions(NOUN, "wobblep")
    assert(paw[0] == String::from("Wobblepaw"), "past the first half")
    assert(completions(NOUN, "").len() == FRONTS.len(), "a controller picks from the halves")
}

@test
fn typing_a_name_takes_its_hints_and_a_controller_picks_from_the_lists() {
    var s = search()
    for c in [115, 105] {
        assert(s.typed(c))
    }
    assert(s.hint() == String::from("r"), "si gives Sir")
    assert(s.typed(32) && s.part == NOUN && s.value(TITLE) == String::from("Sir"), "space takes it")
    for c in [119, 111, 98] {
        assert(s.typed(c))
    }
    assert(s.hint() == String::from("blesnout"))
    assert(!s.typed(55) && !s.typed(33), "no digits, no marks")
    assert(s.erase() && s.value(NOUN) == String::from("wo"))
    s.parts[NOUN].clear()
    assert(!s.erase() && s.part == TITLE, "back from an empty part")
    // A title that goes on with a space keeps it.
    var h = search()
    for c in [104, 101, 97, 100, 32] {
        assert(h.typed(c))
    }
    assert(h.part == TITLE && h.value(TITLE) == String::from("head "), "Head Keeper")
    // Picking: round the epithets and back to what was typed.
    var p = search()
    p.to(EPITHET)
    assert(p.turn(1) && p.value(EPITHET) == String::from(EPITHETS[0]))
    assert(p.turn(-1) && p.value(EPITHET).is_empty() && p.blank())
    assert(p.turn(-1) && p.value(EPITHET) == String::from(EPITHETS[EPITHETS.len() - 1]))
    p.to(TITLE)
    assert(p.parts[EPITHET] == String::from(EPITHETS[EPITHETS.len() - 1]), "the pick kept")
}
