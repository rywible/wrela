@test
fn the_searched_runs_finish_in_their_times_without_a_death() {
    borrow c = course(LEVEL)
    let every = (1 << c.snacks.len()) - 1
    let any = play(LEVEL, ANY)
    let full = play(LEVEL, FULL)
    assert(any.finished == 1283 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 1999 && full.deaths == 0 && full.snacks == every)
    let human_any = play(LEVEL, HUMAN_ANY)
    let human_full = play(LEVEL, HUMAN_FULL)
    assert(human_any.finished == 1327 && human_any.deaths == 0)
    assert(human_full.finished == 1949 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
