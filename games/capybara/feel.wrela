// How the capybara moves, in numbers (design.md, "Movement"): one speed reached almost at once,
// a light-gravity rise while jump is held, a double jump, the slide and swimming. Ryan chose this
// feel (the lab's "snappy", with a touch more momentum and float) over a Mario-like one with a
// run button. Metres, seconds, and ticks of the sim's step.

/// The sim's step: 120 ticks a second (design.md, "Input").
pub const HZ: u32 = 120
pub const STEP: f32 = 1.0 / 120.0

pub struct Feel: Copy {
    /// The one top speed on the ground and in the air (m/s).
    pub speed: f32 = 9.0,
    /// Ground acceleration towards the top speed, braking against the motion (a skid), braking
    /// with no input, and slowing from above the top speed (m/s²).
    pub accel: f32 = 60.0,
    pub turn: f32 = 90.0,
    pub friction: f32 = 80.0,
    pub over: f32 = 30.0,
    /// Acceleration in the air (m/s²).
    pub air_accel: f32 = 55.0,
    /// A jump's upward speed, and a double jump's (m/s).
    pub launch: f32 = 15.2,
    pub air_launch: f32 = 13.0,
    /// The jumps it has in the air, after its first: refreshed on landing and by a dolphin leap.
    pub air_jumps: u32 = 1,
    /// Gravity rising with jump held, and otherwise (m/s²); the fastest fall (m/s).
    pub rise: f32 = 40.0,
    pub fall: f32 = 90.0,
    pub terminal: f32 = 24.0,
    /// Ticks a jump still counts after the ground falls away, and a press waits for the ground.
    pub coyote: u32 = 12,
    pub buffer: u32 = 12,
    // The slide.
    /// The least speed that slides rather than crouches (m/s), the least slope that slides from
    /// rest (its sine), and the speed below which a slide on flatter ground stops (m/s).
    pub slide_min: f32 = 1.5,
    pub slide_slope: f32 = 0.139,
    pub slide_stop: f32 = 0.5,
    /// Gravity along the slope while sliding, the friction that takes speed, and the cap.
    pub slide_gravity: f32 = 40.0,
    pub slide_friction: f32 = 2.5,
    pub slide_max: f32 = 22.0,
    // Swimming.
    /// A stroke's speed (m/s), the ticks between strokes, and the cap strokes reach (m/s).
    pub stroke: f32 = 6.0,
    pub stroke_cooldown: u32 = 12,
    pub swim_max: f32 = 13.0,
    /// Paddling with a direction held: its top speed (m/s) and acceleration (m/s²).
    pub paddle: f32 = 3.5,
    pub paddle_accel: f32 = 12.0,
    /// The middle floats this far under the surface; within `float_band` of the surface it's
    /// floating (m).
    pub float_depth: f32 = 0.15,
    pub float_band: f32 = 0.45,
    /// Buoyancy: acceleration per metre from the floating height, and its most (m/s²).
    pub buoyancy: f32 = 8.0,
    pub buoyancy_max: f32 = 6.0,
    /// Water's drag (1/s).
    pub drag: f32 = 1.4,
    /// The hop out of the water from floating (m/s).
    pub water_jump: f32 = 10.0,
    /// The least upward speed through the surface that leaps, and the least upward speed a leap
    /// leaves with (m/s): any swim up through the surface is a leap that clears a wall 1.6 m up.
    pub leap_min: f32 = 3.5,
    pub leap: f32 = 14.0,
}

/// The capybara's feel.
pub const FEEL = Feel {}
