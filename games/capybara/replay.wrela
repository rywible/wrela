// Replays: what a player did, as the pads of an attempt's ticks (design.md, "Input" and "Releases
// and replays"). The ticker records each attempt as it's played (world.wrela's `Live`); a finished
// one becomes a `Replay`, which plays exactly the same again on the sim (`world::play`), so it is
// its own proof: `verify` plays it and checks its time and what it found, as the leaderboards'
// server will. The player's progress (progress.wrela) keeps the best few of each category
// (`Board`); the game draws one beside the player as a ghost (`trail`), and plays any of them back
// to watch (main.wrela).
//
// A board belongs to one version of play (`BOARD`): a change to the sim or the courses that
// changes how a run plays starts a new one, and the runs of the old one are dropped.

use course::{COURSES, LEVELS, course}
use searched::searched
use feel::HZ
use pad::{Hold, pad_of}
use proofs::LAB_RUN
use std::collections::Vec
use std::serialize::Serialize
use world::{Snap, World, step, world}
use course::LAB_COURSE
use course::WETLANDS

/// The version of play the runs are for: 3 since a kick off the bottom of water waits the kicks'
/// cooldown.
pub const BOARD: u32 = 3

/// The categories (design.md, "Speedrunning"): any%, to the goal, and 100%, to the goal with
/// every snack. A 100% run counts for any% too.
pub const ANY: u32 = 0
pub const FULL: u32 = 1

/// Who made a run: the player; a program with any input (tool-assisted: the route search's fastest,
/// and proofs.wrela's recorded runs where it has none); or the route search within a person's
/// inputs (routes.wrela's human-possible runs, which a person could press and recover from a slip
/// in, though no person was tested on them).
pub const YOU: u32 = 0
pub const AUTOPILOT: u32 = 1
pub const HUMAN: u32 = 2

/// How many runs a category keeps.
pub const KEPT: u32 = 5

/// The longest attempt a replay may be: half an hour of ticks. A longer one isn't kept, so
/// verifying a stored run never plays more than this.
pub const MOST_TICKS: u32 = 30 * 60 * HZ

/// The most runs a board holds: the best `KEPT` of each course's two categories.
pub const MOST_RUNS: u32 = COURSES * 2 * KEPT

/// A finished attempt: its course, who made it, its time (the clock's ticks on reaching the goal),
/// the snacks it found (a bit each), its deaths, and its pads.
pub struct Replay: Clone + Serialize {
    pub course: u32,
    pub who: u32,
    pub ticks: u32,
    pub snacks: u32,
    pub deaths: u32,
    pub holds: Vec<Hold>,
}

/// The replay of the attempt in snapshot `s` (world.wrela's `present_live`), once it has reached
/// the goal: none before, if its run outgrew its record, or if it took longer than `MOST_TICKS`.
pub fn replay(s: Snap, who: u32) -> Option<Replay> {
    if s.finished == 0 || s.finished > MOST_TICKS || s.run.over == 1 {
        return None
    }
    Some(
        Replay {
            course: s.course,
            who,
            ticks: s.finished,
            snacks: s.snacks,
            deaths: s.deaths,
            holds: s.run.holds(),
        },
    )
}

/// The world after the first `ticks` ticks of `r` (all of it, past its end).
pub fn played(r: Replay, ticks: u32) -> World {
    var w = world(r.course)
    var t = 0
    for h in r.holds {
        for i in 0..h.ticks {
            if t == ticks {
                return w
            }
            step(mut w, pad_of(h, i))
            t += 1
        }
    }
    w
}

/// How many ticks `r`'s pads last: none past `MOST_TICKS`.
pub fn length(r: Replay) -> Option<u32> {
    var n = 0
    for h in r.holds {
        if h.ticks > MOST_TICKS - n {
            return None
        }
        n += h.ticks
    }
    Some(n)
}

/// Whether `r` could be a run, before it's played: of a course, of some ticks, no longer than
/// `MOST_TICKS`, and as long as its pads say.
pub fn plausible(r: Replay) -> bool {
    r.course < COURSES && r.ticks > 0 && length(r) == Some(r.ticks)
}

/// Whether `r` plays, on the sim, to the goal on the tick it says, with the snacks and the deaths
/// it says: what it claims is what the rules make of its pads. A run that isn't `plausible`
/// doesn't, and isn't played.
pub fn verify(r: Replay) -> bool {
    if r.who > HUMAN || !plausible(r) {
        return false
    }
    let w = played(r, r.ticks)
    w.finished == r.ticks && w.snacks == r.snacks && w.deaths == r.deaths
}

/// Whether `r` counts for `category`.
pub fn counts(r: Replay, category: u32) -> bool {
    let all = course(r.course).every_snack()
    category == ANY || (r.snacks & all) == all
}

/// The runs kept: the best few of each course and category.
pub struct Board: Clone + Serialize {
    pub version: u32,
    pub runs: Vec<Replay>,
}

/// A board with no runs.
pub fn board() -> Board {
    Board { version: BOARD, runs: Vec::new() }
}

impl Board {
    /// The best `KEPT` runs of course `c` that count for `category`, fastest first (the earlier
    /// kept first among equal times).
    pub fn ranked(self, c: u32, category: u32) -> Vec<Replay> {
        var out: Vec<Replay> = Vec::new()
        for r in self.runs {
            if r.course == c && counts(r, category) {
                out.push(r.clone())
            }
        }
        out.sort_by(|a, b| a.ticks < b.ticks)
        while out.len() > KEPT {
            let _ = out.pop()
        }
        out
    }

    /// Keeps `r` if it is among the best `KEPT` of a category it counts for, and lets go of runs
    /// that no longer are; whether it was kept.
    pub fn add(mut self, r: take Replay) -> bool {
        self.runs.push(take r)
        var kept = false
        var i = 0
        while i < self.runs.len() {
            if self.ranks(i) {
                kept = kept || i == self.runs.len() - 1
                i += 1
            } else {
                let _ = self.runs.remove(i)
            }
        }
        kept
    }

    /// Whether run `i` is among the best `KEPT` of a category it counts for: fewer than `KEPT`
    /// runs of its course and category are faster, or as fast and kept before it.
    fn ranks(self, i: u32) -> bool {
        borrow r = self.runs[i]
        for category in [ANY, FULL] {
            if counts(r, category) {
                var ahead = 0
                for j in 0..self.runs.len() {
                    borrow o = self.runs[j]
                    if j != i &&
                        o.course == r.course &&
                        counts(o, category) &&
                        (o.ticks < r.ticks || (o.ticks == r.ticks && j < i)) {
                        ahead += 1
                    }
                }
                if ahead < KEPT {
                    return true
                }
            }
        }
        false
    }
}

/// Board `b`'s runs that are of this version of play and that verify, the player's own: none for
/// another version, or for more runs than a board holds (each verified is played).
pub fn checked(b: Board) -> Board {
    var out = board()
    if b.version != BOARD || b.runs.len() > MOST_RUNS {
        return out
    }
    for r in b.runs {
        if r.who == YOU && verify(r) {
            let _ = out.add(r.clone())
        }
    }
    out
}

/// The tool-assisted runs of course `c`, as replays: a level's any% and 100% from the route
/// search (searched.wrela), its fastest and then its human-possible ones (none for a level not
/// searched yet), and the lab's autopilot recording (proofs.wrela).
pub fn tool_assisted(c: u32) -> Vec<Replay> {
    var out: Vec<Replay> = Vec::new()
    if c < LEVELS {
        let s = searched(c)
        if s.any.len() > 0 {
            out.push(recorded(c, s.any, AUTOPILOT))
            out.push(recorded(c, s.full, AUTOPILOT))
            out.push(recorded(c, s.human_any, HUMAN))
            out.push(recorded(c, s.human_full, HUMAN))
        }
    } else if c == LAB_COURSE {
        out.push(recorded(LAB_COURSE, LAB_RUN, AUTOPILOT))
    }
    out
}

/// A recorded run as `who`'s replay, cut at the goal.
fn recorded(c: u32, run: [Hold], who: u32) -> Replay {
    var holds: Vec<Hold> = Vec::new()
    var w = world(c)
    for h in run {
        var kept = 0
        for i in 0..h.ticks {
            if w.finished == 0 {
                step(mut w, pad_of(h, i))
                kept += 1
            }
        }
        if kept > 0 {
            holds.push(Hold { bits: h.bits, ticks: kept })
        }
    }
    Replay {
        course: c,
        who,
        ticks: w.finished,
        snacks: w.snacks,
        deaths: w.deaths,
        holds,
    }
}

// ---- the ghost ---------------------------------------------------------------------------------

/// Where a ghost is after a tick of its run: the capybara's middle, the way it faces, its mode (as
/// `Mode`'s discriminant), whether it's dying, how far it has walked (m, for its stride), and the
/// checkpoint it would come back to (for the splits).
pub struct Pose: Copy {
    pub at: vec2,
    pub facing: f32,
    pub mode: u32,
    pub dying: u32,
    pub walked: f32,
    pub checkpoint: u32,
}

/// The clock when the run whose poses are `trail` first reached each of its course's checkpoints,
/// in order, up to the last it reached: what a player's splits are compared with.
pub fn splits(trail: [Pose]) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    for t in 0..trail.len() {
        while trail[t].checkpoint > out.len() {
            out.push(t)
        }
    }
    out
}

/// Where an attempt lost the most time to the ghost's run, after it reached the goal: the stretch
/// (0 to the first checkpoint, `i` from checkpoint `i`; the last, from the last checkpoint both
/// reached to the goal) and the ticks it lost there, from the attempt's clock at each checkpoint
/// (`mine`) and at the goal (`finished`), and the ghost's (`theirs`, `splits`; `end`, its time).
/// None if it lost no time anywhere.
pub fn most_lost(mine: [u32], finished: u32, theirs: [u32], end: u32) -> Option<(u32, u32)> {
    let n = min(mine.len(), theirs.len())
    var best: Option<(u32, u32)> = None
    var was = 0
    var ghost_was = 0
    for i in 0..n + 1 {
        let (now, ghost_now) = if i < n { (mine[i], theirs[i]) } else { (finished, end) }
        let lost = (i32(now) - i32(was)) - (i32(ghost_now) - i32(ghost_was))
        var worse = lost > 0
        if let Some((_, most)) = best {
            worse = lost > i32(most)
        }
        if worse {
            best = Some((i, u32(lost)))
        }
        was = now
        ghost_was = ghost_now
    }
    best
}

/// The poses of `r`: the first before its first tick, then one after each tick to its end.
pub fn trail(r: Replay) -> Vec<Pose> {
    var out: Vec<Pose> = Vec::new()
    var w = world(r.course)
    var walked = 0.0
    out.push(pose(w, walked))
    for h in r.holds {
        for i in 0..h.ticks {
            let before = w.body.at
            step(mut w, pad_of(h, i))
            walked += distance(before, w.body.at)
            out.push(pose(w, walked))
        }
    }
    out
}

fn pose(w: World, walked: f32) -> Pose {
    Pose {
        at: w.body.at,
        facing: w.body.facing,
        mode: u32(w.body.mode),
        dying: w.dying,
        walked,
        checkpoint: w.checkpoint,
    }
}

// ---- tests -------------------------------------------------------------------------------------

use std::input::{Event, Key, Mods}
use engine::run::TickInput
use feel::STEP
use pad::{DOWN, JUMP, LEFT, PRESS, RIGHT, UP, hold}
use world::{live, present_live, tick_live}

/// A run of `who` at course `c` that claims `ticks` and these snacks, unchecked.
fn claimed(c: u32, ticks: u32, snacks: u32) -> Replay {
    Replay { course: c, who: YOU, ticks, snacks, deaths: 0, holds: Vec::new() }
}

@test
fn the_autopilots_runs_verify_and_a_doctored_one_does_not() {
    for c in [LAB_COURSE, WETLANDS] {
        for r in tool_assisted(c) {
            assert(verify(r), f"course {c}: {r.ticks} ticks")
            var faster = r.clone()
            faster.ticks -= 1
            assert(!verify(faster), "a run claiming a tick less")
            var more = r.clone()
            more.snacks = more.snacks | 1 << 7
            assert(!verify(more), "a run claiming a snack it didn't find")
        }
    }
    let full = tool_assisted(WETLANDS)[1].clone()
    assert(counts(full, FULL) && counts(full, ANY))
    assert(!counts(tool_assisted(WETLANDS)[0], FULL), "the any% run misses snacks")
}

@test
fn a_board_keeps_the_best_few_of_each_category_fastest_first() {
    var b = board()
    let all = course(WETLANDS).every_snack()
    // Seven any% runs, slowest first, then a slow 100% run.
    for k in 0..7 {
        let _ = b.add(claimed(WETLANDS, ticks: 4000 - k * 10, snacks: 0))
    }
    assert(b.add(claimed(WETLANDS, ticks: 5000, snacks: all)), "the only 100% run is kept")
    assert(!b.add(claimed(WETLANDS, ticks: 4100, snacks: 0)), "a slow any% run isn't")
    let any = b.ranked(WETLANDS, ANY)
    assert(any.len() == KEPT)
    assert(any[0].ticks == 3940 && any[KEPT - 1].ticks == 3980, f"{any[0].ticks}")
    let full = b.ranked(WETLANDS, FULL)
    assert(full.len() == 1 && full[0].ticks == 5000)
    assert(b.ranked(LAB_COURSE, ANY).len() == 0)
}

@test
fn a_board_keeps_only_the_runs_that_verify_on_this_version() {
    var b = board()
    let any = tool_assisted(WETLANDS)[0].clone()
    var mine = any.clone()
    mine.who = YOU
    let _ = b.add(mine.clone())
    var doctored = mine.clone()
    doctored.ticks -= 60
    let _ = b.add(take doctored)
    let back = checked(b)
    assert(back.runs.len() == 1 && back.runs[0].ticks == any.ticks, f"{back.runs.len()} runs")
    var old = board()
    old.version = BOARD + 1
    let _ = old.add(take mine)
    assert(checked(old).runs.len() == 0, "another version's runs are dropped")
}

@test
fn a_stored_run_of_no_ticks_too_many_or_too_long_isnt_played() {
    assert(!verify(claimed(LAB_COURSE, ticks: 0, snacks: 0)), "an empty run")
    var over = claimed(LAB_COURSE, ticks: 1, snacks: 0)
    over.holds = Vec::from([hold(bits: 0, ticks: 0xffffffff), hold(bits: 0, ticks: 1)])
    assert(!verify(over), "holds whose ticks overflow")
    var long = claimed(LAB_COURSE, ticks: MOST_TICKS + 1, snacks: 0)
    long.holds = Vec::from([hold(bits: 0, ticks: MOST_TICKS), hold(bits: 0, ticks: 1)])
    assert(!verify(long), "a run past the longest kept")
    var b = board()
    b.runs.push(claimed(LAB_COURSE, ticks: 0, snacks: 0))
    assert(checked(b).runs.len() == 0, "an empty run isn't read")
    var mine = tool_assisted(LAB_COURSE)[0].clone()
    mine.who = YOU
    var many = board()
    for _ in 0..MOST_RUNS + 1 {
        many.runs.push(mine.clone())
    }
    assert(checked(many).runs.len() == 0, "more runs than a board holds")
}

/// The key events that take the controls from holding `from` to holding `to` (pad.wrela's bits).
fn keys(from: u32, to: u32) -> Vec<Event> {
    var out: Vec<Event> = Vec::new()
    for (bit, key) in [
        (LEFT, Key::Left),
        (RIGHT, Key::Right),
        (UP, Key::Up),
        (DOWN, Key::Down),
        (JUMP, Key::Space),
    ] {
        let (was, is) = (from & bit != 0, to & bit != 0)
        if bit == JUMP && to & PRESS != 0 {
            // A press: down again, and up again in the same tick if it isn't held (a tap).
            if was {
                out.push(Event::KeyUp { key, mods: Mods {} })
            }
            out.push(Event::KeyDown { key, repeat: false, mods: Mods {} })
            if !is {
                out.push(Event::KeyUp { key, mods: Mods {} })
            }
        } else if was && !is {
            out.push(Event::KeyUp { key, mods: Mods {} })
        } else if is && !was {
            out.push(Event::KeyDown { key, repeat: false, mods: Mods {} })
        }
    }
    out
}

@test
fn a_live_attempt_played_from_keys_is_recorded_as_a_replay_that_plays_it_again() {
    // The lab's run, played as key presses through the ticker's step, from the pause it opens on.
    var l = live(LAB_COURSE)
    var tick = 0
    let go = Vec::from([Event::KeyDown { key: Key::Enter, repeat: false, mods: Mods {} }])
    tick_live(mut l, TickInput { tick, dt: STEP, records: go, answers: Vec::new() })
    tick += 1
    var bits = 0
    for h in LAB_RUN {
        for i in 0..h.ticks {
            let pad = pad_of(h, i).bits
            let records = keys(bits, pad)
            bits = pad
            tick_live(mut l, TickInput { tick, dt: STEP, records, answers: Vec::new() })
            tick += 1
        }
    }
    assert(l.world.finished > 0, "the lab's run reaches its goal")
    let Some(r) = replay(present_live(l), YOU) else { panic("a finished attempt has a replay") }
    assert(r.ticks == l.world.finished && length(r) == Some(r.ticks), f"{r.ticks} ticks")
    assert(verify(r), "it plays again to the same goal")
    // Its pads are the run's, tick for tick, to the goal.
    var given: Vec<u32> = Vec::new()
    for h in LAB_RUN {
        for i in 0..h.ticks {
            given.push(pad_of(h, i).bits)
        }
    }
    var t = 0
    for h in r.holds {
        for i in 0..h.ticks {
            assert(pad_of(h, i).bits == given[t], f"tick {t}")
            t += 1
        }
    }
    let ghost = trail(r)
    let w = played(r, r.ticks)
    assert(ghost.len() == r.ticks + 1 && ghost[r.ticks].at == w.body.at, "the ghost's trail")
}

@test
fn a_runs_splits_are_the_ticks_it_first_reached_each_checkpoint() {
    let r = tool_assisted(WETLANDS)[0].clone()
    let poses = trail(r)
    let at = splits(poses)
    assert(at.len() == course(WETLANDS).checkpoints.len(), f"{at.len()} splits")
    for i in 0..at.len() {
        assert(poses[at[i]].checkpoint == i + 1 && poses[at[i] - 1].checkpoint <= i, f"split {i}")
        if i > 0 {
            assert(at[i] > at[i - 1], "in order")
        }
    }
}

@test
fn where_the_most_time_went_is_the_stretch_that_lost_the_most() {
    // Ahead to the first flag, 30 ticks lost to the second, 96 lost from it to the goal.
    let mine = [100, 260]
    let theirs = [110, 240]
    assert(most_lost(mine, 400, theirs, 284) == Some((2, 96)), "the last stretch")
    assert(most_lost(mine, 300, theirs, 284) == Some((1, 30)), "the second")
    // Ahead the whole way, nothing lost.
    assert(most_lost([90, 200], 240, theirs, 284).is_none())
    // A checkpoint only one of them reached isn't compared; the goal is.
    assert(most_lost([100], 300, [], 250) == Some((0, 50)))
}
