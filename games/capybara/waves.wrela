// The water as it's drawn: each pool's surface a row of columns 0.1 m wide, each with its height
// and its speed, pulled by its neighbours (a wave equation, with a little spring back to rest and
// damping), so a plunge sends rings out across the pool and they come back off the banks. This
// is presentation: the sim's water is flat, and nothing here touches it.
//
// The water's shader draws each pool's shape (filled to the ground under it, as before) up to the
// moving surface: the scene behind it (a copy of it), bent by the surface's slope and a slow
// shimmer, losing its red then its green with depth, towards a deep blue-green; light rays from
// the sun slanting down through it; caustics, the surface's light focused, rippling over the
// floor; a bright line along the surface, white with foam where it moves fast, and glints where
// it catches the sun.

use art::SUN_COLOUR
use course::Course
use earth::{ground_top, lin, solids, top_at}
use engine::noise::noise2
use ground::triangulate
use std::gpu::{
    ClipPosition, FragCoord, Flat, Over, Rgba16Float, Sampler, Texture, VertexIndex, discard,
}

/// A column's width (m).
pub const COLUMN: f32 = 0.1

/// The most columns of all a course's pools.
pub const COLUMNS: u32 = 1024

/// How fast a wave runs (m/s), how fast a column springs back to rest (1/s²), and how fast its
/// motion dies away (1/s).
const SPEED: f32 = 3.2
const REST: f32 = 4.0
const DAMP: f32 = 1.1

/// The step the waves are stepped by (s).
const DT: f32 = 1.0 / 240.0

/// A course's pools: each one's left edge (m), first column, number of columns and surface (m),
/// and every column's height (m) and speed (m/s).
pub struct Waves {
    pub pools: Vec<vec4>,
    pub heights: Vec<f32>,
    speeds: Vec<f32>,
    /// What's left of the frame's time to step (s).
    owed: f32,
}

pub fn waves(c: Course) -> Waves {
    var pools: Vec<vec4> = Vec::new()
    var n = 0
    for w in c.waters {
        let count = u32(ceil((w.hi.x - w.lo.x) / COLUMN)) + 1
        pools.push(vec4(w.lo.x, f32(n), f32(count), w.surface()))
        n += count
    }
    assert(n <= COLUMNS, "the course's pools fit the columns")
    var heights: Vec<f32> = Vec::new()
    for _ in 0..n {
        heights.push(0.0)
    }
    Waves { pools, heights: heights.clone(), speeds: heights, owed: 0.0 }
}

/// The waves `dt` seconds on.
pub fn step_waves(w: mut Waves, dt: f32) {
    w.owed = min(w.owed + dt, 0.1)
    let k = SPEED * SPEED / (COLUMN * COLUMN)
    while w.owed >= DT {
        w.owed -= DT
        for pool in w.pools {
            let (first, count) = (u32(pool.y), u32(pool.z))
            for i in first..first + count {
                // The banks reflect: a missing neighbour is the column itself.
                let l = if i > first { w.heights[i - 1] } else { w.heights[i] }
                let r = if i + 1 < first + count { w.heights[i + 1] } else { w.heights[i] }
                let h = w.heights[i]
                let a = k * (l + r - 2.0 * h) - REST * h - DAMP * w.speeds[i]
                w.speeds[i] += a * DT
            }
            for i in first..first + count {
                w.heights[i] = clamp(w.heights[i] + w.speeds[i] * DT, -0.6, 0.6)
            }
        }
    }
}

/// The pool whose surface spans `x`, if one does: its index.
fn pool_at(w: Waves, x: f32) -> Option<u32> {
    for i in 0..w.pools.len() {
        let p = w.pools[i]
        if x >= p.x && x <= p.x + p.z * COLUMN {
            return Some(i)
        }
    }
    None
}

/// Pushes the surface `width` m either side of `x` with speed `kick` (m/s, up positive), most at
/// `x`, tapering to nothing at the edges.
pub fn disturb(w: mut Waves, x: f32, width: f32, kick: f32) {
    match pool_at(w, x) {
        Some(i) => {
            let p = w.pools[i]
            let (first, count) = (u32(p.y), u32(p.z))
            for j in first..first + count {
                let d = abs(p.x + f32(j - first) * COLUMN - x)
                if d < width {
                    w.speeds[j] += kick * 0.5 * (1.0 + cos(3.14159 * d / width))
                }
            }
        },
        None => {},
    }
}

/// The surface's height at `x` (m), if a pool spans it.
pub fn surface_at(w: Waves, x: f32) -> Option<f32> {
    match pool_at(w, x) {
        Some(i) => {
            let p = w.pools[i]
            let f = clamp((x - p.x) / COLUMN, 0.0, p.z - 1.001)
            let j = u32(p.y) + u32(f)
            let t = fract(f)
            Some(p.w + w.heights[j] * (1.0 - t) + w.heights[j + 1] * t)
        },
        None => None,
    }
}

// ---- the mesh -----------------------------------------------------------------------------------

/// How far apart the outline samples the ground under the water (m), and how far above the surface
/// the shape reaches, for the crests (m).
const OUTLINE_STEP: f32 = 0.2
const CREST: f32 = 0.7

/// Each pool's shape, filled to the ground under it, its top `CREST` above the surface: three
/// vertices a triangle, each its point and its pool's index.
pub fn water_mesh(c: Course) -> Vec<vec4> {
    let outlines = solids(c)
    var out: Vec<vec4> = Vec::new()
    for k in 0..c.waters.len() {
        let w = c.waters[k]
        let surface = w.surface()
        var floor: Vec<vec2> = Vec::new()
        var x = w.lo.x
        while x <= w.hi.x {
            let y = ground_top(outlines, x)
            if y < surface - 1.0e-3 {
                floor.push(vec2(x, max(y, w.lo.y) - 0.05))
            }
            x += OUTLINE_STEP
        }
        if floor.len() < 2 {
            continue
        }
        let (left, right) = (floor[0].x - OUTLINE_STEP, floor[floor.len() - 1].x + OUTLINE_STEP)
        var polygon: Vec<vec2> = Vec::new()
        polygon.push(vec2(left, surface + CREST))
        polygon.push(vec2(right, surface + CREST))
        var i = floor.len()
        while i > 0 {
            i -= 1
            polygon.push(floor[i])
        }
        for p in triangulate(polygon) {
            out.push(vec4(p, f32(k), 0.0))
        }
    }
    out
}

pub const LAB_WATER: Vec<vec4> = water_mesh(course::LAB)
pub const LEVEL_WATER: Vec<vec4> = water_mesh(course::LEVEL)

// ---- the shader ---------------------------------------------------------------------------------

/// What the water's shader is told: the camera's matrix, the view's middle and half-size (m), a
/// pixel's size (m) and the time (s).
pub struct Pond: Copy + GpuData {
    pub view_proj: mat4,
    pub centre: vec2,
    pub half: vec2,
    pub px: f32,
    pub time: f32,
    pub pad: vec2 = vec2(0.0),
}

pub struct Wetl: Copy {
    pub clip: ClipPosition,
    pub world: vec2,
    pub pool: Flat<u32>,
}

@vertex
pub fn water_vertex(v: VertexIndex, verts: [vec4], f: Pond) -> Wetl {
    let p = verts[v.index]
    Wetl {
        clip: ClipPosition { position: f.view_proj * vec4(p.xy, 0.5, 1.0) },
        world: p.xy,
        pool: Flat { value: u32(p.z) },
    }
}

/// A pool's surface offset at `x` (m): its columns', and a small ripple the wind keeps up.
fn lift(pool: vec4, heights: [f32], x: f32, time: f32) -> vec2 {
    let f = clamp((x - pool.x) / COLUMN, 0.0, pool.z - 1.001)
    let j = u32(pool.y) + u32(f)
    let t = fract(f)
    let h = heights[j] * (1.0 - t) + heights[j + 1] * t
    let ripple = 0.025 * sin(x * 2.3 + time * 2.1) +
        0.015 * sin(x * 4.1 - time * 2.9) +
        0.01 * sin(x * 7.3 + time * 4.3)
    let speed = abs(heights[j + 1] - heights[j]) / COLUMN
    vec2(h + ripple, speed)
}

@fragment
pub fn water(
    w: Wetl,
    pixel: FragCoord,
    f: Pond,
    pools: [vec4],
    heights: [f32],
    tops: [f32],
    below: Texture<Rgba16Float>,
    s: Sampler,
) -> Over {
    let p = w.world
    let pool = pools[w.pool.value]
    let here = lift(pool, heights, p.x, f.time)
    let surface = pool.w + here.x
    let depth = surface - p.y
    if depth < -f.px {
        discard()
    }
    let ahead = lift(pool, heights, p.x + 0.05, f.time).x
    let slope = (ahead - here.x) / 0.05
    // The scene behind, bent: by the surface's slope near it, and a slow shimmer.
    let shimmer = vec2(
        noise2(vec2(p.x * 1.7 + f.time * 0.6, p.y * 1.7)) - 0.5,
        noise2(vec2(p.x * 1.7, p.y * 1.7 - f.time * 0.5) + vec2(7.0)) - 0.5,
    )
    let bend = (vec2(slope * 0.25, 0.0) * exp(-depth * 1.5) + shimmer * 0.06) *
        min(depth * 2.0, 1.0)
    let size = vec2(f32(below.width()), f32(below.height()))
    let uv = pixel.position.xy / size + vec2(bend.x, -bend.y) / (f.half * 2.0)
    var c = below.sample_level(s, uv).rgb
    // Through the water: red goes first, then green, towards a deep blue-green lit from above.
    let floor = top_at(tops, p.x)
    let deep = lin(vec3(0.04, 0.26, 0.36)) * (0.3 + SUN_COLOUR * 0.32) * exp(-depth * 0.1)
    let through = exp(-max(depth, 0.0) * vec3(0.75, 0.3, 0.2))
    c = c * through + deep * (vec3(1.0) - through)
    // Caustics, rippling over the floor and what's near it.
    let q = p * 2.2
    let a = noise2(q + vec2(f.time * 0.5, f.time * 0.3))
    let b = noise2(q * 1.3 - vec2(f.time * 0.4, -f.time * 0.2) + vec2(4.0))
    let net = smoothstep(0.12, 0.0, abs(a - b))
    let near_floor = exp(-max(p.y - floor, 0.0) * 1.1)
    c += SUN_COLOUR * net * near_floor * exp(-depth * 0.18) * 0.35 * c
    // Light rays slanting down from the surface.
    let ray = noise2(vec2((p.x - depth * 0.45) * 1.2 + f.time * 0.12, f.time * 0.15))
    c += SUN_COLOUR *
        lin(vec3(0.6, 0.85, 0.9)) *
        smoothstep(0.55, 0.85, ray) *
        exp(-depth * 0.35) *
        0.18 *
        smoothstep(0.0, 0.4, depth)
    // Just under the surface, the sky's light; on it, a bright line, foamy where it moves, and
    // glints where it catches the sun.
    c = c + (lin(vec3(0.75, 0.9, 1.0)) * (0.6 + SUN_COLOUR * 0.4) - c) * 0.3 * exp(-depth * 5.0)
    let line = smoothstep(f.px * 2.5, 0.0, abs(depth - f.px * 1.2))
    let foam = saturate(here.y * 0.5 + 0.15)
    c = c +
        (lin(vec3(0.92, 0.97, 1.0)) * (0.7 + SUN_COLOUR * 0.5) * (1.0 + foam) - c) *
            line *
            (0.6 + 0.4 * foam)
    let glint = smoothstep(0.92, 1.0, noise2(vec2(p.x * 9.0, f.time * 3.0))) *
        smoothstep(f.px * 4.0, 0.0, depth)
    c += SUN_COLOUR * glint * 4.0
    Over { color: vec4(c, saturate(depth / f.px + 0.5)) }
}
