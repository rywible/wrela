    hold(RIGHT | JUMP | PRESS, 6),
    hold(RIGHT | DOWN | JUMP, 6),
    hold(bits: 0, ticks: 6),
    hold(RIGHT | UP, 6),
    hold(JUMP | PRESS, 6),
    hold(RIGHT | UP | JUMP, 12),
    hold(RIGHT | UP, 6),
    hold(bits: 0, ticks: 6),
    hold(RIGHT, 6),
    hold(bits: 0, ticks: 6),
    hold(RIGHT | DOWN, 6),
