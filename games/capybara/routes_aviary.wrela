/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level aviary --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 1.0e9, 1.0e9, 1.0e9, 1.0e9]

@test
fn the_searched_runs_of_aviary_finish_in_their_times_without_a_death() {
    let every = course(AVIARY).every_snack()
    let any = play(AVIARY, ANY)
    let full = play(AVIARY, FULL)
    assert(any.finished == 1375 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 2661 && full.deaths == 0 && full.snacks == every)
    let human_any = play(AVIARY, HUMAN_ANY)
    let human_full = play(AVIARY, HUMAN_FULL)
    assert(human_any.finished == 1368 && human_any.deaths == 0)
    assert(human_full.finished == 2684 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
