// What's behind the course, and the little in front of it: the sky and its clouds, the zoo in
// four layers back to front, each moved by its own fraction of the camera's motion (parallax);
// pollen and fronds in front. Each is drawn per pixel over the whole screen, as a field: its
// shapes' distances, unioned, the pixel inside where it's below 0. Nothing here is a picture:
// shapes, hashes and noise, placed in cells along the layer.
//
// - The far hills (0.06): blue ranges and a tree line, nearly the sky's colour.
// - The savanna (0.2): grassy rises, flat-topped acacias, and giraffes eating from them.
// - The zoo's path (0.42): round trees, lamp posts, a fence along the path, elephants behind it.
// - The bushes and the bamboo (0.68): flowering bushes and groves of bamboo, nearest and darkest.
//
// Each layer is drawn smaller the further it is, fades towards the sky's colour at its pixel
// (aerial perspective), and darkens below its ground (what a pit looks down into). It's lit by
// the sun: a brighter rim on the edges that face it, darker low down. The four are drawn at half
// the screen's size (art.wrela), soft as far things are; each shape's gradient, which only its
// rim needs, is found only near its edge.

use art::{SUN, SUN_AT, SUN_COLOUR}
use engine::noise::{hash2, noise2}
use std::derive::value_gradient_with
use std::field::smin
use std::gpu::{FragCoord, Over, discard}

/// What each of the screen's layers is told: the camera's point on the plane of play (m), half
/// the view's size (m), the screen's size (px) and the time (s).
pub struct View: Copy + GpuData {
    pub centre: vec2,
    pub half: vec2,
    pub screen: vec2,
    pub time: f32,
    pub pad: f32 = 0.0,
}

/// How soft a layer's edges are (m on the layer): a pixel and a half of the view it's drawn at.
fn blur(v: View, parallax: f32) -> f32 {
    3.0 * v.half.y / v.screen.y / (0.45 + 0.55 * parallax)
}

/// The layers' fractions of the camera's motion.
pub const FAR: f32 = 0.06
pub const SAVANNA: f32 = 0.2
pub const PATH: f32 = 0.42
pub const BAMBOO: f32 = 0.68

/// The point a pixel shows on a layer that moves by `parallax` of the camera's motion. A layer
/// further back is drawn smaller too, as it would look further off: its shapes at
/// `0.45 + 0.55 * parallax` of their size.
fn on_layer(pixel: FragCoord, v: View, parallax: f32) -> vec2 {
    let uv = pixel.position.xy / v.screen
    let offset = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) * v.half
    (v.centre * parallax + offset) / (0.45 + 0.55 * parallax)
}

fn blend(a: vec3, b: vec3, t: f32) -> vec3 {
    a + (b - a) * t
}

// ---- the sky -----------------------------------------------------------------------------------

/// The sky's colour at a pixel `uv` (0 to 1 across and down) for a camera at height `y`: deep blue
/// overhead to a warm haze at the horizon, and the sun's halo round it. The layers fade to it.
pub fn sky_colour(uv: vec2, aspect: f32, y: f32) -> vec3 {
    let up = 1.0 - uv.y
    let horizon = 0.3 - y * 0.008
    let t = saturate((up - horizon) / (1.0 - horizon))
    let zenith = vec3(0.05, 0.2, 0.62)
    let middle = vec3(0.24, 0.48, 0.86)
    let haze = vec3(0.8, 0.74, 0.62)
    var c = blend(haze, middle, smoothstep(0.0, 0.4, t))
    c = blend(c, zenith, smoothstep(0.4, 1.0, t))
    c = blend(c, haze * vec3(0.92, 0.95, 1.0), smoothstep(0.0, -0.25, up - horizon))
    let d = distance(vec2(uv.x * aspect, uv.y), vec2(SUN_AT.x * aspect, SUN_AT.y))
    c + SUN_COLOUR * (exp(-d * 7.0) * 0.5 + exp(-d * 2.2) * 0.2)
}

/// Fractal value noise: `octaves` of `noise2`, each twice as fine and half as strong, in 0 to 1.
fn fbm(p: vec2, octaves: u32) -> f32 {
    var sum = 0.0
    var weight = 0.5
    var q = p
    var total = 0.0
    for _ in 0..octaves {
        sum += noise2(q) * weight
        total += weight
        weight *= 0.5
        q = q * 2.03 + vec2(17.1, 9.3)
    }
    sum / total
}

/// How thick the clouds are at `q` (their layer's point, m): puffs in a band 4 to 11 m above the
/// layer's zero, drifting with the wind.
fn cloud_density(q: vec2, time: f32) -> f32 {
    let p = q * vec2(0.11, 0.18) + vec2(time * 0.012, 0.0)
    // Flat bottoms at 6 m, heaped tops thinning upwards.
    let base = smoothstep(5.6, 6.4, q.y)
    let n = fbm(p, 5) + 0.25 * noise2(vec2(q.x * 0.04 + time * 0.005, 1.0))
    saturate((n - 0.52 - (q.y - 6.0) * 0.035) * 4.0) * base
}

/// The sky and its clouds, the sun's disc and halo: what every other layer is drawn over.
@fragment
pub fn sky(pixel: FragCoord, v: View) -> vec4 {
    let uv = pixel.position.xy / v.screen
    let aspect = v.screen.x / v.screen.y
    var c = sky_colour(uv, aspect, v.centre.y)
    let d = distance(vec2(uv.x * aspect, uv.y), vec2(SUN_AT.x * aspect, SUN_AT.y))
    var cover = 0.0
    // The clouds: lit from the sun's side, their own shade where more cloud lies towards it, a
    // silver edge where they're thin before the sun.
    let q = on_layer(pixel, v, 0.03)
    let density = cloud_density(q, v.time)
    if density > 0.001 {
        let toward = normalize(vec2(SUN_AT.x * aspect, -SUN_AT.y) - vec2(uv.x * aspect, -uv.y))
        let shade = cloud_density(q + toward * 0.8, v.time) +
            cloud_density(q + toward * 1.8, v.time) * 0.6
        let lit = exp(-shade * 1.6) * (0.55 + 0.45 * smoothstep(6.0, 9.0, q.y))
        let base = blend(vec3(0.42, 0.48, 0.64), vec3(1.3, 1.22, 1.1), lit)
        let silver = exp(-d * 6.0) * (1.0 - density) * 2.5
        let cloud = base + SUN_COLOUR * silver
        cover = smoothstep(0.0, 0.35, density) * 0.97
        c = blend(c, cloud, cover)
    }
    // The sun's disc, shining through thin cloud.
    c += SUN_COLOUR * smoothstep(0.04, 0.034, d) * 14.0 * (1.0 - 0.8 * cover)
    vec4(c, 1.0)
}

// ---- shading a layer ---------------------------------------------------------------------------

/// A layer's colour where its field `d` (m, below 0 inside) with gradient `g` has albedo `albedo`:
/// lit by the sun and the sky, a bright rim along the edges that face the sun, darker towards the
/// layer's ground at `ground` (m). Faded towards the sky's colour `sky` by `haze`; its cover
/// smoothed over `soft` m.
fn shade(
    g: vec2,
    albedo: vec3,
    q: vec2,
    sky: vec3,
    d: f32,
    ground: f32,
    haze: f32,
    soft: f32,
) -> Over {
    let edge = saturate(1.0 + d / 0.12)
    let facing = saturate(dot(normalize(g + vec2(1.0e-5)), normalize(SUN.xy)))
    let low = smoothstep(ground - 0.5, ground + 2.5, q.y)
    let light = vec3(0.42, 0.48, 0.58) * (0.7 + 0.3 * low) + SUN_COLOUR * 0.55 * (0.6 + 0.4 * low)
    // The albedos are written as a colour picker gives them; light works in linear light.
    let a = albedo * albedo
    var c = a * light + SUN_COLOUR * a * edge * facing * 0.9
    // Below the layer's ground, into the dark: what a pit looks down into.
    let under = smoothstep(0.0, 4.0, ground - q.y)
    c *= 1.0 - 0.85 * under
    c = blend(c, sky * (1.0 - 0.8 * under), haze * (1.0 - 0.7 * under))
    Over { color: vec4(c, smoothstep(soft, -soft, d)) }
}

/// A box's distance (half-size `b`, corners rounded by `r`).
fn rbox(p: vec2, b: vec2, r: f32) -> f32 {
    let q = abs(p) - b + vec2(r)
    length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r
}

/// A segment's distance from `a` to `b`, `r` thick.
fn capsule(p: vec2, a: vec2, b: vec2, r: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = saturate(dot(pa, ba) / dot(ba, ba))
    length(pa - ba * h) - r
}

/// An ellipse's distance, approximately (exact on its axes; good enough for shapes this size).
fn ellipse(p: vec2, r: vec2) -> f32 {
    let k0 = length(p / r)
    let k1 = length(p / (r * r))
    k0 * (k0 - 1.0) / max(k1, 1.0e-5)
}

// ---- the far hills ------------------------------------------------------------------------------

fn far_field(q: vec2) -> (f32, vec3) {
    let ridge = 2.5 + 4.0 * fbm(vec2(q.x * 0.03, 3.0), 4) - 1.0
    let trees = 1.0 + 0.9 * fbm(vec2(q.x * 0.12, 9.0), 3) + 0.25 * noise2(vec2(q.x * 1.7, 2.0))
    let a = q.y - ridge
    let b = q.y - trees
    if b < a {
        (b, vec3(0.3, 0.42, 0.36))
    } else {
        (a, vec3(0.42, 0.5, 0.62))
    }
}

@fragment
pub fn far_hills(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, FAR)
    let (d, albedo) = far_field(q)
    // The gradient only near an edge: elsewhere the rim it lights is none.
    let g = if abs(d) < 0.15 {
        let (_, grad, _) = value_gradient_with(|p: vec2| far_field(p), q)
        grad
    } else {
        vec2(0.0, 1.0)
    }
    if d > 0.3 {
        discard()
    }
    let uv = pixel.position.xy / v.screen
    let sky = sky_colour(uv, v.screen.x / v.screen.y, v.centre.y)
    shade(g, albedo, q, sky, d: d, ground: 0.0, haze: 0.55, soft: max(0.03, blur(v, FAR)))
}

// ---- the savanna: acacias and giraffes -----------------------------------------------------------

/// The savanna's ground at `x` (m).
fn savanna_ground(x: f32) -> f32 {
    0.4 + 0.7 * sin(x * 0.07) + 0.5 * fbm(vec2(x * 0.05, 4.0), 3)
}

/// An acacia at `base`, `h` m tall: a thin trunk forking, and a flat, ragged crown.
fn acacia(p: vec2, base: vec2, h: f32, seed: f32) -> f32 {
    let q = p - base
    let fork = vec2(0.15, h * 0.55)
    var d = capsule(q, vec2(0.0), fork, 0.09)
    d = min(d, capsule(q, fork, vec2(-0.7, h * 0.9), 0.06))
    d = min(d, capsule(q, fork, vec2(0.9, h * 0.92), 0.06))
    let crown = q - vec2(0.1, h)
    let ragged = 0.18 * noise2(vec2(crown.x * 2.2 + seed * 10.0, 1.0)) - 0.06
    d = min(d, ellipse(crown, vec2(2.3, 0.38 + ragged)))
    min(d, ellipse(crown - vec2(-1.1, -0.15), vec2(1.0, 0.25)))
}

/// A giraffe at `base` facing `dir`, its neck stretched up to eat (`t`, the time, sways it).
fn giraffe(p: vec2, base: vec2, dir: f32, t: f32) -> f32 {
    let q = (p - base) * vec2(dir, 1.0)
    var d = ellipse(q - vec2(0.0, 2.15), vec2(0.85, 0.42))
    for x in [-0.6, -0.45, 0.45, 0.6] {
        d = min(d, capsule(q, vec2(x, 2.0), vec2(x + 0.04, 0.0), 0.06))
    }
    let sway = 0.15 * sin(t * 0.6 + base.x)
    let head = vec2(1.3 + sway, 4.1)
    d = smin(d, capsule(q, vec2(0.65, 2.3), head - vec2(0.15, 0.1), 0.13), 0.15)
    d = min(d, ellipse(q - head - vec2(0.15, 0.0), vec2(0.3, 0.13)))
    d = min(d, capsule(q, head + vec2(-0.05, 0.1), head + vec2(-0.1, 0.32), 0.035))
    min(d, capsule(q, vec2(-0.8, 2.2), vec2(-1.05, 1.5), 0.03))
}

fn savanna_field(q: vec2, time: f32) -> (f32, vec3) {
    let ground = savanna_ground(q.x)
    var d = q.y - ground
    var albedo = vec3(0.55, 0.6, 0.3)
    let cell = floor(q.x / 8.0)
    for k in -1..2 {
        let i = cell + f32(k)
        let h = hash2(i32(i), 11)
        let x = (i + 0.2 + 0.6 * hash2(i32(i), 12)) * 8.0
        if h < 0.7 && abs(q.x - x) < 2.6 && q.y < ground + 6.0 {
            let tree = acacia(q, vec2(x, savanna_ground(x) - 0.2), 3.2 + 1.4 * h, h)
            if tree < d {
                d = tree
                albedo = vec3(0.28, 0.42, 0.16)
            }
        }
    }
    let herd = floor(q.x / 27.0)
    for k in -1..2 {
        let i = herd + f32(k)
        let h = hash2(i32(i), 21)
        let x = (i + 0.3 + 0.4 * hash2(i32(i), 22)) * 27.0
        if h < 0.55 && abs(q.x - x) < 2.0 && q.y < ground + 5.0 {
            let dir = if hash2(i32(i), 23) < 0.5 { -1.0 } else { 1.0 }
            let animal = giraffe(q, vec2(x, savanna_ground(x) - 0.1), dir, time)
            if animal < d {
                d = animal
                albedo = vec3(0.85, 0.6, 0.3)
            }
        }
    }
    (d, albedo)
}

@fragment
pub fn savanna(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, SAVANNA)
    let (d, albedo) = savanna_field(q, v.time)
    // The gradient only near an edge: elsewhere the rim it lights is none.
    let g = if abs(d) < 0.15 {
        let (_, grad, _) = value_gradient_with(|p: vec2| savanna_field(p, v.time), q)
        grad
    } else {
        vec2(0.0, 1.0)
    }
    if d > 0.3 {
        discard()
    }
    let uv = pixel.position.xy / v.screen
    let sky = sky_colour(uv, v.screen.x / v.screen.y, v.centre.y)
    // A giraffe's patches: a cell pattern, dark between light.
    var a = albedo
    if albedo.x > 0.8 {
        let cell = fract(q * vec2(4.0, 4.5) + vec2(noise2(q * 6.0) * 0.4)) - vec2(0.5)
        let c = abs(cell)
        a = blend(albedo, vec3(0.5, 0.28, 0.12), smoothstep(0.44, 0.38, max(c.x, c.y)))
    }
    shade(
        g,
        a,
        q,
        sky,
        d: d,
        ground: savanna_ground(q.x),
        haze: 0.34,
        soft: max(0.02, blur(v, SAVANNA)),
    )
}

// ---- the zoo's path: trees, lamps, the fence and elephants ---------------------------------------

/// The path's ground at `x` (m).
fn path_ground(x: f32) -> f32 {
    -0.6 + 0.35 * sin(x * 0.11) + 0.2 * noise2(vec2(x * 0.3, 1.0))
}

/// A round tree at `base`, `h` m tall: a trunk and a crown of lumps.
fn round_tree(p: vec2, base: vec2, h: f32, seed: f32) -> (f32, f32) {
    let q = p - base
    let trunk = min(
        capsule(q, vec2(0.0), vec2(0.05, h * 0.7), 0.16),
        capsule(q, vec2(0.0, h * 0.45), vec2(0.6, h * 0.7), 0.08),
    )
    var crown = 1.0e3
    for k in 0..5 {
        let a = f32(k) * 1.3 + seed * 6.0
        let at = vec2(0.0, h) + vec2(cos(a) * 1.1, sin(a) * 0.6)
        crown = smin(crown, length(q - at) - (1.0 + 0.3 * sin(a * 2.7)), 0.4)
    }
    crown += 0.12 * noise2(q * 3.0 + vec2(seed * 40.0)) - 0.05
    (min(trunk, crown), if crown < trunk { 1.0 } else { 0.0 })
}

/// An elephant at `base` facing `dir`: a body, a head with its ear, a trunk swinging (`t`), legs.
fn elephant(p: vec2, base: vec2, dir: f32, t: f32) -> f32 {
    let q = (p - base) * vec2(dir, 1.0)
    var d = ellipse(q - vec2(0.0, 1.55), vec2(1.45, 0.95))
    for x in [-0.95, -0.6, 0.55, 0.9] {
        d = smin(d, rbox(q - vec2(x, 0.55), vec2(0.22, 0.6), 0.12), 0.1)
    }
    let head = vec2(1.45, 1.9)
    d = smin(d, length(q - head) - 0.62, 0.3)
    let swing = 0.25 * sin(t * 0.9 + base.x)
    d = smin(d, capsule(q, head + vec2(0.45, -0.1), head + vec2(0.75 + swing, -1.1), 0.14), 0.12)
    d = min(d, capsule(q, head + vec2(0.75 + swing, -1.1), head + vec2(0.95 + swing, -1.0), 0.1))
    d = min(d, ellipse(q - head - vec2(-0.45, 0.0), vec2(0.4, 0.55)))
    min(d, capsule(q, vec2(-1.4, 1.8), vec2(-1.65, 1.0), 0.04))
}

fn path_field(q: vec2, time: f32) -> (f32, vec3) {
    let ground = path_ground(q.x)
    var d = q.y - ground
    var albedo = vec3(0.42, 0.55, 0.24)
    // The trees.
    let cell = floor(q.x / 10.0)
    for k in -1..2 {
        let i = cell + f32(k)
        let h = hash2(i32(i), 31)
        let x = (i + 0.25 + 0.5 * hash2(i32(i), 32)) * 10.0
        if h < 0.75 && abs(q.x - x) < 3.0 && q.y < ground + 7.8 {
            let (tree, leaves) = round_tree(q, vec2(x, path_ground(x) - 0.2), 3.6 + 2.0 * h, h)
            if tree < d {
                d = tree
                albedo = if leaves > 0.5 {
                    // A crown is lit like a ball: brighter towards the sun.
                    let crown = vec2(x, path_ground(x) + 3.4 + 2.0 * h)
                    let towards = dot(normalize(q - crown), normalize(SUN.xy))
                    let ball = 0.7 + 0.45 * towards * saturate(length(q - crown) / 1.6)
                    blend(vec3(0.2, 0.42, 0.14), vec3(0.32, 0.5, 0.16), hash2(i32(i), 33)) * ball
                } else {
                    vec3(0.3, 0.22, 0.15)
                }
            }
        }
    }
    // The elephants, behind the fence.
    let herd = floor(q.x / 34.0)
    for k in -1..2 {
        let i = herd + f32(k)
        let x = (i + 0.3 + 0.4 * hash2(i32(i), 42)) * 34.0
        if hash2(i32(i), 41) < 0.6 && abs(q.x - x) < 2.9 && q.y < ground + 3.4 {
            let dir = if hash2(i32(i), 43) < 0.5 { -1.0 } else { 1.0 }
            let animal = elephant(q, vec2(x, path_ground(x) - 0.3), dir, time)
            if animal < d {
                d = animal
                albedo = vec3(0.36, 0.35, 0.38)
            }
        }
    }
    // The lamp posts.
    let lamp = floor(q.x / 15.0)
    let lx = (lamp + 0.5) * 15.0
    let lb = vec2(lx, path_ground(lx) - 0.1)
    let post = if abs(q.x - lx) > 0.7 { 1.0e3 } else {
        min(
            capsule(q, lb, lb + vec2(0.0, 3.2), 0.06),
            min(
                capsule(q, lb + vec2(0.0, 3.2), lb + vec2(0.35, 3.35), 0.04),
                length(q - lb - vec2(0.4, 3.2)) - 0.14,
            ),
        )
    }
    if post < d {
        d = post
        albedo = vec3(0.16, 0.2, 0.18)
    }
    // The fence along the path: posts and two rails.
    let fx = q.x - (floor(q.x / 2.2) + 0.5) * 2.2
    let fy = q.y - path_ground(q.x)
    var fence = rbox(vec2(fx, fy - 0.55), vec2(0.07, 0.62), 0.03)
    fence = min(fence, abs(fy - 0.95) - 0.05)
    fence = min(fence, abs(fy - 0.45) - 0.04)
    fence = max(fence, -fy - 0.1)
    if fence < d {
        d = fence
        albedo = vec3(0.55, 0.38, 0.22)
    }
    (d, albedo)
}

@fragment
pub fn path(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, PATH)
    let (d, albedo) = path_field(q, v.time)
    // The gradient only near an edge: elsewhere the rim it lights is none.
    let g = if abs(d) < 0.15 {
        let (_, grad, _) = value_gradient_with(|p: vec2| path_field(p, v.time), q)
        grad
    } else {
        vec2(0.0, 1.0)
    }
    if d > 0.3 {
        discard()
    }
    let uv = pixel.position.xy / v.screen
    let sky = sky_colour(uv, v.screen.x / v.screen.y, v.centre.y)
    let leafy = (noise2(q * 5.0) + noise2(q * 11.0 + vec2(3.0))) * 0.08
    shade(
        g,
        albedo * (0.91 + leafy),
        q,
        sky,
        d: d,
        ground: path_ground(q.x),
        haze: 0.17,
        soft: max(0.012, blur(v, PATH)),
    )
}

// ---- the bushes and the bamboo --------------------------------------------------------------------

fn near_ground(x: f32) -> f32 {
    -1.7 + 0.25 * sin(x * 0.17) + 0.2 * noise2(vec2(x * 0.5, 7.0))
}

/// A bamboo leaf from `at`, pointing `dir`, `l` long: narrow, pointed at both ends.
fn leaf(p: vec2, at: vec2, dir: vec2, l: f32) -> f32 {
    let q = p - at
    let t = clamp(dot(q, dir), 0.0, l)
    let w = 0.07 * sin(3.14159 * t / l) + 0.004
    length(q - dir * t) - w
}

/// A grove of bamboo at `x0`: stalks with dark rings every 0.6 m, fans of leaves at the upper
/// rings, swaying in the wind (`time`). Its distance, and 1 where it's leaf.
fn grove(q: vec2, x0: f32, ground: f32, cell: i32, time: f32) -> (f32, f32) {
    var d = 1.0e3
    var leafy = 0.0
    for s in 0..4 {
        let hs = hash2(cell * 7 + s, 53)
        let x = x0 + f32(s) * 0.42 + hs * 0.25
        let top = 4.0 + 2.5 * hs
        let up = (q.y - ground) / top
        let sway = 0.12 * sin(time * 0.8 + x * 1.3) * up * up
        let local = vec2(q.x - x - sway, q.y - ground)
        let ring = smoothstep(0.03, 0.0, abs(fract(local.y / 0.6) - 0.5) - 0.47)
        let stalk = max(abs(local.x) - 0.08 + ring * 0.015, max(local.y - top, -local.y))
        if stalk < d {
            d = stalk
            leafy = 0.0
        }
        if local.y < top * 0.5 - 0.7 || abs(local.x) > 1.5 {
            continue
        }
        for l in 0..5 {
            let hl = hash2(cell * 31 + s * 7 + l, 54)
            let y = top * (0.55 + 0.45 * f32(l) / 4.0)
            let side = if (l + s) % 2 == 0 { -1.0 } else { 1.0 }
            let base = vec2(
                x + 0.12 * sin(time * 0.8 + x * 1.3) * (y / top) * (y / top),
                ground + y,
            )
            let dir = normalize(vec2(side * cos(0.3 + 0.5 * hl), -sin(0.3 + 0.5 * hl) * 0.6 - 0.1))
            let leaf_d = min(
                leaf(q, base, dir, 0.9 + 0.4 * hl),
                leaf(q, base + vec2(0.0, 0.15), normalize(dir + vec2(0.0, 0.5)), 0.7),
            )
            if leaf_d < d {
                d = leaf_d
                leafy = 1.0
            }
        }
    }
    (d, leafy)
}

/// The nearest layer: bushes along the ground, lit on top, and groves of bamboo.
fn near_field(q: vec2, time: f32) -> (f32, vec3) {
    let ground = near_ground(q.x)
    // The bushes: mounds of round lumps, bigger and smaller.
    var d = q.y - ground - 0.4
    let lump = floor(q.x / 1.3)
    for k in -2..3 {
        let i = lump + f32(k)
        let h = hash2(i32(i), 61)
        let at = vec2((i + 0.5) * 1.3 + (h - 0.5) * 0.6, ground + 0.3 + 0.7 * h)
        d = smin(d, length(q - at) - (0.6 + 0.6 * hash2(i32(i), 62)), 0.35)
    }
    d += 0.06 * noise2(q * 6.0) - 0.03
    // Flowers in the bushes: hibiscus reds, pinks and yellows, here and there.
    let cell_f = floor(q / 0.32)
    let hf = hash2(i32(cell_f.x), i32(cell_f.y) + 500)
    let petal = length(q - (cell_f + vec2(0.5)) * 0.32) - 0.07
    let near_top = d < -0.08 && d > -0.7 && q.y > ground
    let flower = if hf < 0.07 && near_top { smoothstep(0.02, -0.02, petal) } else { 0.0 }
    let bloom = if hf < 0.035 {
        vec3(0.95, 0.25, 0.3)
    } else if hf < 0.05 {
        vec3(0.98, 0.6, 0.75)
    } else {
        vec3(1.0, 0.85, 0.3)
    }
    var albedo = blend(vec3(0.12, 0.27, 0.08), bloom, flower)
    let cell = floor(q.x / 9.0)
    for k in -1..2 {
        let i = cell + f32(k)
        let x0 = (i + 0.2 + 0.4 * hash2(i32(i), 52)) * 9.0
        let inside = q.x > x0 - 1.5 && q.x < x0 + 3.0 && q.y > ground + 0.2 && q.y < ground + 7.6
        if hash2(i32(i), 51) < 0.6 && inside {
            let (g, leafy) = grove(q, x0, near_ground(x0), i32(i), time)
            if g < d {
                d = g
                albedo = if leafy > 0.5 { vec3(0.2, 0.42, 0.1) } else { vec3(0.36, 0.5, 0.16) }
            }
        }
    }
    (d, albedo)
}

@fragment
pub fn bamboo(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, BAMBOO)
    let (d, albedo) = near_field(q, v.time)
    // The gradient only near an edge: elsewhere the rim it lights is none.
    let g = if abs(d) < 0.15 {
        let (_, grad, _) = value_gradient_with(|p: vec2| near_field(p, v.time), q)
        grad
    } else {
        vec2(0.0, 1.0)
    }
    if d > 0.3 {
        discard()
    }
    let uv = pixel.position.xy / v.screen
    let sky = sky_colour(uv, v.screen.x / v.screen.y, v.centre.y)
    // Leaves over the bushes: a dapple of lighter and darker.
    let dapple = 0.75 + 0.5 * noise2(q * 4.0) * noise2(q * 9.0 + vec2(3.0))
    shade(
        g,
        albedo * dapple,
        q,
        sky,
        d: d,
        ground: near_ground(q.x),
        haze: 0.12,
        soft: max(0.012, blur(v, BAMBOO)),
    )
}

// ---- in front: the pollen and the fronds ---------------------------------------------------------

/// Pollen drifting in the sunlight, on the plane of play: a mote in some of the cells 0.9 m
/// square, wandering round its cell's middle, twinkling.
@fragment
pub fn pollen(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, 1.0)
    let cell = floor(q / 0.9)
    let (cx, cy) = (i32(cell.x), i32(cell.y))
    let h = hash2(cx, cy + 300)
    if h > 0.07 {
        discard()
    }
    let t = v.time
    let wander = vec2(sin(t * 0.31 + h * 20.0), cos(t * 0.23 + h * 13.0)) * 0.3
    let centre = (cell + vec2(0.5) + wander) * 0.9
    let r = 0.006 + 0.01 * hash2(cx + 9, cy)
    let d = length(q - centre)
    let twinkle = 0.35 + 0.65 * pow(sin(t * 1.7 + h * 40.0) * 0.5 + 0.5, 2.0)
    let a = smoothstep(r * 3.0, 0.0, d) * twinkle
    if a < 0.01 {
        discard()
    }
    Over { color: vec4(SUN_COLOUR * vec3(1.3, 1.15, 0.8), a * 0.5) }
}

/// A segment's distance from `a` to `b`, `ra` thick at `a` and `rb` at `b`.
fn cone(p: vec2, a: vec2, b: vec2, ra: f32, rb: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = saturate(dot(pa, ba) / dot(ba, ba))
    length(pa - ba * h) - (ra + (rb - ra) * h)
}

/// A frond rising from `base`, `l` long, leaning `lean`: a tapering blade that bends over.
fn frond(p: vec2, base: vec2, l: f32, lean: f32) -> f32 {
    let mid = base + vec2(lean * 0.35, l * 0.6)
    let tip = base + vec2(lean, l)
    min(cone(p, base, mid, ra: 0.09, rb: 0.06), cone(p, mid, tip, ra: 0.06, rb: 0.005))
}

fn fronds_field(p: vec2, time: f32) -> (f32, vec3) {
    var d = 1.0e3
    let cell = floor(p.x / 6.0)
    for k in -1..2 {
        let i = cell + f32(k)
        if hash2(i32(i), 71) < 0.5 {
            let x0 = (i + 0.3 + 0.4 * hash2(i32(i), 72)) * 6.0
            for b in 0..6 {
                let hb = hash2(i32(i) * 11 + b, 73)
                let side = f32(b) - 2.5
                let sway = 0.08 * sin(time * 1.1 + x0 + f32(b))
                d = min(
                    d,
                    frond(p, vec2(x0 + side * 0.12, -0.25), 0.7 + 0.8 * hb, side * 0.22 + sway),
                )
            }
        }
    }
    (d, vec3(0.1, 0.2, 0.08))
}

/// Fronds along the bottom of the screen, nearer than the play (they move 1.4 times as fast as
/// the camera): dark and soft, rising from below the screen's edge, a frame for the view that
/// never covers more than its bottom eighth.
@fragment
pub fn fronds(pixel: FragCoord, v: View) -> Over {
    let uv = pixel.position.xy / v.screen
    let up = (1.0 - uv.y) * v.half.y * 2.0
    if up > 1.7 {
        discard()
    }
    let p = vec2(v.centre.x * 1.4 + (uv.x * 2.0 - 1.0) * v.half.x, up) / 1.3
    let (d, albedo) = fronds_field(p, v.time)
    // The gradient only near an edge: elsewhere the rim it lights is none.
    let g = if abs(d) < 0.15 {
        let (_, grad, _) = value_gradient_with(|q: vec2| fronds_field(q, v.time), p)
        grad
    } else {
        vec2(0.0, 1.0)
    }
    if d > 0.1 {
        discard()
    }
    shade(g, albedo, p, vec3(0.0), d: d, ground: -10.0, haze: 0.0, soft: 0.04)
}
