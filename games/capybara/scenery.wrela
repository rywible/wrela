// What's behind the course, painted as a picture book's backdrop (ink.wrela): the sky with its
// puffed clouds and the sun, and the zoo in four layers back to front, each moved by its own
// fraction of the camera's motion (parallax). Each is drawn per pixel over the
// screen as a field: its shapes' distances, unioned, the pixel inside where it's below 0, then a
// wash with an ink line. Nothing here is a picture: shapes, hashes and noise in cells along the
// layer.
//
// - The far hills (0.06): blue ranges and a tree line.
// - The savanna (0.2): rises of straw-coloured grass, flat-topped acacias, giraffes eating.
// - The zoo's path (0.42): its gate saying ZOO where the level starts, then a sight every 22 m
//   (a flamingo pond, zebras, an ice cream kiosk, an aviary, an elephant by its rock), trees,
//   lamps with bunting between some, and the fence.
// - The bushes and the bamboo (0.68): bushes, a few flowers, a grove of bamboo here and there.
//
// A layer further back is drawn smaller, paler (its washes and its ink fade towards the mist's
// colour) and with a finer line. Shading is the painter's: a second, darker wash on the side of
// a crown away from the sun, not light. Below its ground a layer darkens, so a pit looks down
// into shade. Each layer skips its shapes where none can be (above its tallest, below its
// ground), so it costs little where it shows only sky or fill.

use engine::noise::{hash2, noise2}
use ink::{INK, inked, pooled, wash}
use std::field::smin
use std::gpu::{FragCoord, Over, discard}

/// What each of the screen's layers is told: the camera's point on the plane of play (m), half
/// the view's size (m), the screen's size (px) and the time (s).
pub struct View: Copy + GpuData {
    pub centre: vec2,
    pub half: vec2,
    pub screen: vec2,
    pub time: f32,
    pub pad: f32 = 0.0,
}

/// The layers' fractions of the camera's motion.
pub const FAR: f32 = 0.06
pub const SAVANNA: f32 = 0.2
pub const PATH: f32 = 0.42
pub const BAMBOO: f32 = 0.68

/// The mist the far layers fade into.
const MIST = vec3(0.83, 0.88, 0.87)

/// The sun, from the side and above, as a direction on the page.
const SUN = vec2(0.57, 0.82)

/// How much smaller a layer is drawn, for its parallax.
fn zoom(parallax: f32) -> f32 {
    0.45 + 0.55 * parallax
}

/// The point a pixel shows on a layer that moves by `parallax` of the camera's motion.
fn on_layer(pixel: FragCoord, v: View, parallax: f32) -> vec2 {
    let uv = pixel.position.xy / v.screen
    let offset = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) * v.half
    (v.centre * parallax + offset) / zoom(parallax)
}

/// A pixel's size on a layer (m).
fn pixel_on(v: View, parallax: f32) -> f32 {
    2.0 * v.half.y / v.screen.y / zoom(parallax)
}

fn blend(a: vec3, b: vec3, t: f32) -> vec3 {
    a + (b - a) * t
}

/// A layer's shape painted: its wash, pooled at the edge, faded by `haze` into the mist, and
/// inked with a line `line` px wide.
fn paint(d: f32, albedo: vec3, q: vec2, px: f32, haze: f32, line: f32) -> Over {
    var c = pooled(wash(albedo, q), d, 0.12)
    c = blend(c, MIST, haze)
    let ink = blend(INK, MIST, min(haze * 1.7, 0.9))
    let o = inked(c, d, q, line * px, px, ink)
    if o.w <= 0.0 {
        discard()
    }
    Over { color: o }
}

/// What a layer is under its ground: its fill washed and darkening downwards into shade.
fn under(albedo: vec3, q: vec2, ground: f32, haze: f32) -> Over {
    let deep = smoothstep(0.0, 6.0, ground - q.y)
    let c = blend(wash(albedo, q), vec3(0.3, 0.4, 0.36), deep * 0.8)
    Over { color: vec4(blend(c, MIST, haze * (1.0 - deep)), 1.0) }
}

/// Fractal value noise: `octaves` of `noise2`, each twice as fine and half as strong, in 0 to 1.
fn fbm(p: vec2, octaves: u32) -> f32 {
    var sum = 0.0
    var weight = 0.5
    var q = p
    var total = 0.0
    for _ in 0..octaves {
        sum += noise2(q) * weight
        total += weight
        weight *= 0.5
        q = q * 2.03 + vec2(17.1, 9.3)
    }
    sum / total
}

// ---- shapes ----------------------------------------------------------------------------------

/// A box's distance (half-size `b`, corners rounded by `r`).
fn rbox(p: vec2, b: vec2, r: f32) -> f32 {
    let q = abs(p) - b + vec2(r)
    length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r
}

/// A segment's distance from `a` to `b`, `ra` thick at `a` and `rb` at `b`.
fn cone(p: vec2, a: vec2, b: vec2, ra: f32, rb: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = saturate(dot(pa, ba) / dot(ba, ba))
    length(pa - ba * h) - (ra + (rb - ra) * h)
}

fn capsule(p: vec2, a: vec2, b: vec2, r: f32) -> f32 {
    cone(p, a, b, ra: r, rb: r)
}

/// An ellipse's distance, approximately (exact on its axes).
fn ellipse(p: vec2, r: vec2) -> f32 {
    let k0 = length(p / r)
    let k1 = length(p / (r * r))
    k0 * (k0 - 1.0) / max(k1, 1.0e-5)
}

/// A crown's colour at `q`: its wash, and a darker one on the side away from the sun (`centre`
/// its middle, `r` its size), with a soft painted edge between.
fn crowned(lit: vec3, shade: vec3, q: vec2, centre: vec2, r: f32) -> vec3 {
    let away = dot(q - centre, SUN) / r + 0.15 * noise2(q * 3.0)
    blend(shade, lit, smoothstep(-0.35, -0.15, away))
}

// ---- the sky ---------------------------------------------------------------------------------

/// Where the sun stands on the screen: across, as a fraction of the screen's height from the
/// left; down, as a fraction of its height from the top.
const SUN_AT = vec2(0.8, 0.17)

/// A puffed cloud in its cell, at `q` on the cloud's layer: lumps on a flat bottom. Its
/// distance, and the height of its bottom.
fn cloud(q: vec2, time: f32) -> (f32, f32) {
    let x = q.x - time * 0.05
    let cell = floor(x / 16.0)
    var d = 1.0e3
    var base = 0.0
    for k in -1..2 {
        let i = cell + f32(k)
        let h = hash2(i32(i), 81)
        if h < 0.45 {
            let at = vec2((i + 0.5) * 16.0 + (h - 0.4) * 6.0, 6.0 + 3.0 * hash2(i32(i), 82))
            let size = 0.7 + 0.6 * hash2(i32(i), 83)
            var c = 1.0e3
            for j in 0..5 {
                let fj = f32(j) - 2.0
                let r = (1.3 - 0.22 * abs(fj)) * size * (0.85 + 0.3 * hash2(i32(i) * 7 + j, 84))
                c = smin(c, length(vec2(x, q.y) - at - vec2(fj * 1.05 * size, r * 0.45)) - r, 0.3)
            }
            c = max(c, at.y - q.y)
            if c < d {
                d = c
                base = at.y
            }
        }
    }
    (d, base)
}

/// The sky: a wash from soft blue overhead to cream at the horizon; the sun, a pale disc with
/// painted rings round it; puffed clouds, cream, shaded blue-grey underneath, lightly inked.
@fragment
pub fn sky(pixel: FragCoord, v: View) -> vec4 {
    let uv = pixel.position.xy / v.screen
    let aspect = v.screen.x / v.screen.y
    let up = 1.0 - uv.y + v.centre.y * 0.004
    let p = on_layer(pixel, v, 0.03)
    let px = pixel_on(v, 0.03)
    var c = blend(vec3(0.97, 0.92, 0.8), vec3(0.6, 0.78, 0.89), smoothstep(0.28, 0.95, up))
    c = wash(c, p * 0.25)
    let d = distance(vec2(uv.x * aspect, uv.y), vec2(SUN_AT.x * aspect, SUN_AT.y))
    let rings = smoothstep(0.16, 0.08, d) * 0.25
    c = blend(c, vec3(1.0, 0.95, 0.72), rings)
    let disc = inked(
        vec3(1.0, 0.86, 0.45),
        d - 0.045,
        p,
        width: 0.004,
        px: 1.0 / v.screen.y,
        ink: vec3(0.9, 0.55, 0.25),
    )
    c = blend(c, disc.xyz, disc.w)
    let (cd, base) = cloud(p, v.time)
    if cd < 0.2 {
        let low = smoothstep(base + 0.7, base, p.y)
        let fill = blend(vec3(1.0, 0.98, 0.93), vec3(0.83, 0.87, 0.93), low)
        let o = inked(
            pooled(wash(fill, p), cd, 0.25),
            cd,
            p,
            width: px * 1.4,
            px: px,
            ink: vec3(0.55, 0.62, 0.74),
        )
        c = blend(c, o.xyz, o.w)
    }
    vec4(c, 1.0)
}

// ---- the far hills ---------------------------------------------------------------------------

@fragment
pub fn far_hills(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, FAR)
    let px = pixel_on(v, FAR)
    if q.y > 7.0 {
        discard()
    }
    let ridge = 1.5 + 4.0 * fbm(vec2(q.x * 0.03, 3.0), 3)
    let trees = 1.0 +
        0.8 * fbm(vec2(q.x * 0.12, 9.0), 2) +
        0.3 * abs(sin(q.x * 2.1)) * noise2(vec2(q.x * 0.5, 2.0))
    let (a, b) = (q.y - ridge, q.y - trees)
    if b < a {
        paint(b, vec3(0.58, 0.72, 0.64), q, px, haze: 0.55, line: 0.6)
    } else {
        paint(a, vec3(0.66, 0.76, 0.84), q, px, haze: 0.6, line: 0.6)
    }
}

// ---- the savanna: acacias and giraffes --------------------------------------------------------

/// The savanna's ground at `x` (m).
fn savanna_ground(x: f32) -> f32 {
    0.4 + 0.7 * sin(x * 0.07) + 0.5 * noise2(vec2(x * 0.05, 4.0))
}

/// An acacia at `base`, `h` m tall: a thin trunk forking, and a flat, ragged crown. Its
/// distance, and 1 where it's crown.
fn acacia(p: vec2, base: vec2, h: f32, seed: f32) -> (f32, f32) {
    let q = p - base
    let fork = vec2(0.15, h * 0.55)
    var trunk = capsule(q, vec2(0.0), fork, 0.09)
    trunk = min(trunk, capsule(q, fork, vec2(-0.7, h * 0.9), 0.06))
    trunk = min(trunk, capsule(q, fork, vec2(0.9, h * 0.92), 0.06))
    let crown_at = q - vec2(0.1, h)
    let ragged = 0.18 * noise2(vec2(crown_at.x * 2.2 + seed * 10.0, 1.0)) - 0.06
    let crown = min(
        ellipse(crown_at, vec2(2.3, 0.38 + ragged)),
        ellipse(crown_at - vec2(-1.1, -0.15), vec2(1.0, 0.25)),
    )
    (min(trunk, crown), if crown < trunk { 1.0 } else { 0.0 })
}

/// A giraffe at `base` facing `dir`, its neck stretched up to eat (`t`, the time, sways it).
fn giraffe(p: vec2, base: vec2, dir: f32, t: f32) -> f32 {
    let q = (p - base) * vec2(dir, 1.0)
    var d = ellipse(q - vec2(0.0, 2.15), vec2(0.85, 0.42))
    for x in [-0.6, -0.45, 0.45, 0.6] {
        d = min(d, capsule(q, vec2(x, 2.0), vec2(x + 0.04, 0.0), 0.06))
    }
    let sway = 0.15 * sin(t * 0.6 + base.x)
    let head = vec2(1.3 + sway, 4.1)
    d = smin(d, capsule(q, vec2(0.65, 2.3), head - vec2(0.15, 0.1), 0.13), 0.15)
    d = min(d, ellipse(q - head - vec2(0.15, 0.0), vec2(0.3, 0.13)))
    d = min(d, capsule(q, head + vec2(-0.05, 0.1), head + vec2(-0.1, 0.32), 0.035))
    min(d, capsule(q, vec2(-0.8, 2.2), vec2(-1.05, 1.5), 0.03))
}

@fragment
pub fn savanna(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, SAVANNA)
    let px = pixel_on(v, SAVANNA)
    let ground = savanna_ground(q.x)
    let grass = vec3(0.88, 0.8, 0.52)
    if q.y > ground + 6.2 {
        discard()
    }
    if q.y < ground - 0.3 {
        return under(grass, q, ground, 0.3)
    }
    var d = q.y - ground
    var albedo = grass
    let cell = floor(q.x / 8.0)
    for k in -1..2 {
        let i = cell + f32(k)
        let h = hash2(i32(i), 11)
        let x = (i + 0.2 + 0.6 * hash2(i32(i), 12)) * 8.0
        if h < 0.4 && abs(q.x - x) < 2.6 {
            let base = vec2(x, savanna_ground(x) - 0.2)
            let (tree, leaves) = acacia(q, base, 3.2 + 1.4 * h, h)
            if tree < d {
                d = tree
                albedo = if leaves > 0.5 {
                    let top = base + vec2(0.1, 3.2 + 1.4 * h)
                    crowned(vec3(0.56, 0.68, 0.38), vec3(0.48, 0.61, 0.36), q, top, 2.0)
                } else {
                    vec3(0.56, 0.43, 0.32)
                }
            }
        }
    }
    let herd = floor(q.x / 27.0)
    for k in -1..2 {
        let i = herd + f32(k)
        let x = (i + 0.3 + 0.4 * hash2(i32(i), 22)) * 27.0
        if hash2(i32(i), 21) < 0.4 && abs(q.x - x) < 2.0 {
            let dir = if hash2(i32(i), 23) < 0.5 { -1.0 } else { 1.0 }
            let animal = giraffe(q, vec2(x, savanna_ground(x) - 0.1), dir, v.time)
            if animal < d {
                d = animal
                // Patches: a warped grid of brown, light lines between.
                let patch = abs(fract(q * vec2(4.0, 4.5) + vec2(noise2(q * 6.0) * 0.4)) - vec2(0.5))
                let dark = smoothstep(0.44, 0.39, max(patch.x, patch.y))
                albedo = blend(vec3(0.97, 0.82, 0.5), vec3(0.78, 0.5, 0.28), dark)
            }
        }
    }
    paint(d, albedo, q, px, haze: 0.45, line: 0.8)
}

// ---- the zoo's path: its gate, its sights, trees, lamps, bunting and the fence ------------------

/// The path's ground at `x` (m).
fn path_ground(x: f32) -> f32 {
    -0.6 + 0.35 * sin(x * 0.11) + 0.2 * noise2(vec2(x * 0.3, 1.0))
}

/// A round tree at `base`, `h` m tall: a trunk and a crown of lumps, scalloped at its edge.
/// Its distance, and 1 where it's crown.
fn round_tree(p: vec2, base: vec2, h: f32, seed: f32) -> (f32, f32) {
    let q = p - base
    let trunk = min(
        cone(q, vec2(0.0), vec2(0.05, h * 0.7), ra: 0.2, rb: 0.12),
        capsule(q, vec2(0.0, h * 0.45), vec2(0.6, h * 0.7), 0.07),
    )
    var crown = 1.0e3
    for k in 0..5 {
        let a = f32(k) * 1.3 + seed * 6.0
        let at = vec2(0.0, h) + vec2(cos(a) * 1.1, sin(a) * 0.6)
        crown = smin(crown, length(q - at) - (1.0 + 0.3 * sin(a * 2.7)), 0.3)
    }
    // Scallops round the edge, as a painter's leaves.
    crown += 0.06 * abs(sin(atan2(q.y - h, q.x) * 9.0 + seed * 20.0))
    (min(trunk, crown), if crown < trunk { 1.0 } else { 0.0 })
}

/// The nearer of two shapes, each a distance and a colour.
fn nearer(a: (f32, vec3), b: (f32, vec3)) -> (f32, vec3) {
    let (da, _) = a
    let (db, _) = b
    if db < da { b } else { a }
}

fn turn(p: vec2, a: f32) -> vec2 {
    let (c, s) = (cos(a), sin(a))
    vec2(p.x * c + p.y * s, -p.x * s + p.y * c)
}

/// An elephant facing `dir` (`q` from where it stands): a body, a head with its ear, a trunk
/// swinging (`t`), legs; and the rock it stands by.
fn elephant(q: vec2, dir: f32, t: f32) -> (f32, vec3) {
    let l = q * vec2(dir, 1.0)
    var d = ellipse(l - vec2(0.0, 1.55), vec2(1.45, 0.95))
    for x in [-0.95, -0.6, 0.55, 0.9] {
        d = smin(d, rbox(l - vec2(x, 0.55), vec2(0.22, 0.6), 0.12), 0.1)
    }
    let head = vec2(1.45, 1.9)
    d = smin(d, length(l - head) - 0.62, 0.3)
    let swing = 0.25 * sin(t * 0.9)
    d = smin(d, capsule(l, head + vec2(0.45, -0.1), head + vec2(0.75 + swing, -1.1), 0.14), 0.12)
    d = min(d, capsule(l, head + vec2(0.75 + swing, -1.1), head + vec2(0.95 + swing, -1.0), 0.1))
    d = min(d, ellipse(l - head - vec2(-0.45, 0.0), vec2(0.4, 0.55)))
    d = min(d, capsule(l, vec2(-1.4, 1.8), vec2(-1.65, 1.0), 0.04))
    let grey = crowned(vec3(0.7, 0.71, 0.78), vec3(0.6, 0.6, 0.7), l, vec2(0.3, 1.6), 1.4)
    let rock = ellipse(l - vec2(-2.6, 0.45), vec2(1.1, 0.75))
    nearer((d, grey), (rock, vec3(0.74, 0.66, 0.56)))
}

/// A flamingo standing on one leg (`l` from its foot), facing +x: pink, its neck an S, its beak
/// bent and dark at the tip.
fn flamingo(l: vec2) -> (f32, vec3) {
    let pink = vec3(0.98, 0.55, 0.62)
    var d = capsule(l, vec2(0.0), vec2(0.0, 1.25), 0.03)
    d = min(d, capsule(l, vec2(0.0, 0.85), vec2(-0.2, 1.0), 0.03))
    d = min(d, capsule(l, vec2(-0.2, 1.0), vec2(0.0, 1.15), 0.03))
    d = min(d, ellipse(turn(l - vec2(0.0, 1.45), 0.15), vec2(0.38, 0.2)))
    d = min(d, capsule(l, vec2(0.25, 1.5), vec2(0.42, 1.95), 0.045))
    d = min(d, capsule(l, vec2(0.42, 1.95), vec2(0.28, 2.35), 0.045))
    d = min(d, length(l - vec2(0.33, 2.42)) - 0.09)
    let beak = cone(l, vec2(0.4, 2.42), vec2(0.55, 2.27), ra: 0.045, rb: 0.018)
    let tip = if l.x > 0.49 { vec3(0.2, 0.15, 0.15) } else { vec3(0.98, 0.9, 0.85) }
    nearer((d, pink), (beak, tip))
}

/// The flamingo pond: a pool and three flamingos in it.
fn flamingos(q: vec2) -> (f32, vec3) {
    var best = (ellipse(q - vec2(0.0, 0.02), vec2(3.6, 0.26)), vec3(0.56, 0.8, 0.86))
    for (x, dir) in [(-1.9, 1.0), (0.3, -1.0), (2.2, 1.0)] {
        best = nearer(best, flamingo((q - vec2(x, 0.05)) * vec2(dir, 1.0)))
    }
    best
}

/// A zebra grazing (`l` from where it stands), facing +x, its stripes following its body.
fn zebra(l: vec2, t: f32) -> (f32, vec3) {
    let graze = 0.08 * sin(t * 0.8)
    var d = ellipse(l - vec2(0.0, 1.15), vec2(0.8, 0.38))
    for x in [-0.55, -0.38, 0.38, 0.55] {
        d = min(d, capsule(l, vec2(x, 1.0), vec2(x, 0.03), 0.065))
    }
    d = smin(d, cone(l, vec2(0.55, 1.3), vec2(0.95, 1.85), ra: 0.2, rb: 0.14), 0.08)
    d = smin(d, cone(l, vec2(0.95, 1.85), vec2(1.33, 1.5 - graze), ra: 0.16, rb: 0.1), 0.06)
    d = min(d, capsule(l, vec2(0.9, 1.98), vec2(0.86, 2.18), 0.04))
    d = min(d, capsule(l, vec2(-0.8, 1.3), vec2(-0.95, 0.75), 0.03))
    let stripe = if l.y < 0.9 {
        sin(l.y * 22.0)
    } else {
        sin(l.x * 13.0 + sin(l.y * 4.0) * 1.5)
    }
    let colour = if stripe > 0.2 { vec3(0.17, 0.16, 0.19) } else { vec3(0.98, 0.97, 0.93) }
    (d, colour)
}

/// The zebras' paddock: two grazing, facing each other.
fn zebras(q: vec2, t: f32) -> (f32, vec3) {
    nearer(zebra(q - vec2(-1.7, 0.0), t), zebra((q - vec2(1.8, 0.0)) * vec2(-1.0, 1.0), t + 2.0))
}

/// An ice cream kiosk: cream walls with a dark serving hatch, a red and white striped awning,
/// scalloped along its edge, and a round sign on top with a cone on it.
fn kiosk(q: vec2) -> (f32, vec3) {
    let walls = rbox(q - vec2(0.0, 1.0), vec2(1.3, 1.0), 0.05)
    let hatch = rbox(q - vec2(0.0, 1.2), vec2(0.8, 0.38), 0.05)
    var best = (walls, if hatch < 0.0 { vec3(0.42, 0.34, 0.36) } else { vec3(0.97, 0.91, 0.78) })
    let scallop = 0.09 * abs(sin(q.x * 3.14159 / 0.3))
    let awning = max(abs(q.x) - 1.5, max(q.y - 2.6, 2.05 - q.y + scallop))
    let stripe = fract(q.x / 0.6 + 0.25) < 0.5
    best = nearer(best, (awning, if stripe { vec3(0.92, 0.32, 0.32) } else {
        vec3(0.99, 0.96, 0.9)
    }))
    let sign = length(q - vec2(0.0, 3.05)) - 0.42
    let l = q - vec2(0.0, 3.05)
    let cone_icon = max(abs(l.x) - (l.y + 0.25) * 0.4, max(-l.y - 0.25, l.y - 0.02))
    let scoop = length(l - vec2(0.0, 0.08)) - 0.13
    let icon = if scoop < 0.0 {
        vec3(0.98, 0.6, 0.7)
    } else if cone_icon < 0.0 {
        vec3(0.88, 0.66, 0.36)
    } else {
        vec3(0.99, 0.96, 0.9)
    }
    nearer(best, (min(sign, capsule(q, vec2(0.0, 2.6), vec2(0.0, 2.7), 0.05)), icon))
}

/// An aviary: a glass dome on its ground, its frame a lattice of ribs and rings, a finial on top,
/// and bright birds inside.
fn aviary(q: vec2) -> (f32, vec3) {
    let dome = max(length(q) - 3.0, -q.y)
    let a = atan2(q.y, q.x)
    let rib = abs(fract(a / 0.2618) - 0.5) * 0.2618 * length(q)
    let ring = abs(fract(length(q) / 0.75) - 0.5) * 0.75
    let frame = min(rib, ring) < 0.035
    var colour = if frame { vec3(0.42, 0.5, 0.52) } else { vec3(0.82, 0.92, 0.93) }
    for (x, y, c) in [
        (-1.0, 1.2, vec3(0.92, 0.3, 0.28)),
        (0.7, 1.8, vec3(0.3, 0.55, 0.9)),
        (1.4, 0.9, vec3(0.98, 0.8, 0.25)),
    ] {
        if ellipse(q - vec2(x, y), vec2(0.18, 0.1)) < 0.0 {
            colour = c
        }
    }
    let finial = capsule(q, vec2(0.0, 2.9), vec2(0.0, 3.45), 0.06)
    nearer((dome, colour), (finial, vec3(0.42, 0.5, 0.52)))
}

/// The zoo's gate, at the start of the level: two stone pillars, and between them over the way
/// in, a green board saying ZOO.
fn gate(q: vec2) -> (f32, vec3) {
    let stone = vec3(0.9, 0.84, 0.72)
    var best = (rbox(q - vec2(-2.7, 1.8), vec2(0.35, 1.8), 0.06), stone)
    best = nearer(best, (rbox(q - vec2(2.7, 1.8), vec2(0.35, 1.8), 0.06), stone))
    best = nearer(best, (rbox(q - vec2(-2.7, 3.7), vec2(0.45, 0.12), 0.04), stone))
    best = nearer(best, (rbox(q - vec2(2.7, 3.7), vec2(0.45, 0.12), 0.04), stone))
    let board = rbox(q - vec2(0.0, 4.25), vec2(3.2, 0.6), 0.28)
    // The letters, cream on the green.
    let l = (q - vec2(0.0, 4.25)) / 0.75
    let z = l - vec2(-0.95, 0.0)
    let zed = min(
        min(
            capsule(z, vec2(-0.28, 0.32), vec2(0.28, 0.32), 0.09),
            capsule(z, vec2(0.28, 0.32), vec2(-0.28, -0.32), 0.09),
        ),
        capsule(z, vec2(-0.28, -0.32), vec2(0.28, -0.32), 0.09),
    )
    let o1 = abs(ellipse(l - vec2(0.05, 0.0), vec2(0.3, 0.38))) - 0.09
    let o2 = abs(ellipse(l - vec2(0.95, 0.0), vec2(0.3, 0.38))) - 0.09
    let letters = min(zed, min(o1, o2))
    let face = if letters < 0.0 { vec3(0.99, 0.95, 0.82) } else { vec3(0.32, 0.58, 0.42) }
    nearer(best, (board, face))
}

/// Where the gate stands on the path's layer: just ahead of where the level starts.
const GATE: f32 = 4.0

/// How far apart the path's sights are (m on its layer).
const SIGHTS: f32 = 22.0

@fragment
pub fn path(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, PATH)
    let px = pixel_on(v, PATH)
    let ground = path_ground(q.x)
    let lawn = vec3(0.64, 0.78, 0.42)
    if q.y > ground + 7.9 {
        discard()
    }
    if q.y < ground - 0.3 {
        return under(lawn, q, ground, 0.15)
    }
    var best = (q.y - ground, lawn)
    if abs(q.x - GATE) < 3.9 {
        best = nearer(best, gate(q - vec2(GATE, path_ground(GATE) - 0.1)))
    }
    // The sights, one in each stretch: a flamingo pond, zebras, an ice cream kiosk, an aviary,
    // an elephant by its rock; and a tree at each stretch's end, now and then.
    let cell = floor(q.x / SIGHTS)
    for k in -1..2 {
        let i = cell + f32(k)
        let centre = (i + 0.5) * SIGHTS
        let base = vec2(centre, path_ground(centre) - 0.1)
        if abs(q.x - centre) < 4.6 && q.y < ground + 4.6 && abs(centre - GATE) > 8.0 {
            let local = q - base
            let kind = i32(hash2(i32(i), 37) * 5.0)
            let sight = if kind == 0 {
                flamingos(local)
            } else if kind == 1 {
                zebras(local, v.time)
            } else if kind == 2 {
                kiosk(local)
            } else if kind == 3 {
                aviary(local)
            } else {
                elephant(local, if hash2(i32(i), 38) < 0.5 { -1.0 } else { 1.0 }, v.time)
            }
            best = nearer(best, sight)
        }
        let x = i * SIGHTS
        let h = hash2(i32(i), 31)
        if h < 0.6 && abs(q.x - x) < 3.0 {
            let foot = vec2(x, path_ground(x) - 0.2)
            let tall = 3.6 + 2.0 * h
            let (tree, leaves) = round_tree(q, foot, tall, h)
            let colour = if leaves > 0.5 {
                let lit = blend(vec3(0.42, 0.68, 0.34), vec3(0.52, 0.72, 0.34), hash2(i32(i), 33))
                crowned(lit, lit * vec3(0.86, 0.89, 0.93), q, foot + vec2(0.0, tall), 1.6)
            } else {
                vec3(0.58, 0.42, 0.28)
            }
            best = nearer(best, (tree, colour))
        }
    }
    // The lamps every 30 m, bunting strung between some of them.
    let lx = (floor(q.x / 30.0) + 0.5) * 30.0
    if abs(q.x - lx) < 0.7 {
        let lb = vec2(lx, path_ground(lx) - 0.1)
        let arm = capsule(q, lb + vec2(0.0, 3.2), lb + vec2(0.35, 3.35), 0.04)
        let post = min(
            capsule(q, lb, lb + vec2(0.0, 3.2), 0.06),
            min(arm, length(q - lb - vec2(0.4, 3.2)) - 0.14),
        )
        best = nearer(best, (post, vec3(0.3, 0.42, 0.4)))
    }
    let a = floor((q.x - 15.0) / 30.0) * 30.0 + 15.0
    if hash2(i32(a), 77) < 0.5 {
        let t = (q.x - a) / 30.0
        let ya = path_ground(a) + 3.0
        let yb = path_ground(a + 30.0) + 3.0
        let y = ya + (yb - ya) * t - 1.1 * 4.0 * t * (1.0 - t)
        let string = abs(q.y - y) - 0.015
        let n = floor((q.x - a) / 0.9)
        let u = (q.x - a) - (n + 0.5) * 0.9
        let flag = max(
            abs(u) - 0.2 * saturate((q.y - (y - 0.38)) / 0.38),
            max(q.y - y, y - 0.38 - q.y),
        )
        let colours = [
            vec3(0.92, 0.35, 0.32),
            vec3(0.98, 0.8, 0.3),
            vec3(0.35, 0.6, 0.85),
            vec3(0.45, 0.72, 0.4),
        ]
        let colour = colours[u32(abs(n)) % 4]
        best = nearer(best, (min(string, flag), if flag < string { colour } else {
            vec3(0.4, 0.34, 0.3)
        }))
    }
    let fx = q.x - (floor(q.x / 2.2) + 0.5) * 2.2
    let fy = q.y - ground
    var fence = rbox(vec2(fx, fy - 0.55), vec2(0.07, 0.62), 0.03)
    fence = min(fence, abs(fy - 0.95) - 0.05)
    fence = min(fence, abs(fy - 0.45) - 0.04)
    fence = max(fence, -fy - 0.1)
    best = nearer(best, (fence, vec3(0.88, 0.66, 0.42)))
    let (d, albedo) = best
    paint(d, albedo, q, px, haze: 0.22, line: 1.0)
}

// ---- the bushes and the bamboo ----------------------------------------------------------------

fn near_ground(x: f32) -> f32 {
    -1.7 + 0.25 * sin(x * 0.17) + 0.2 * noise2(vec2(x * 0.5, 7.0))
}

/// A bamboo leaf from `at`, pointing `dir`, `l` long: narrow, pointed at both ends.
fn leaf(p: vec2, at: vec2, dir: vec2, l: f32) -> f32 {
    let q = p - at
    let t = clamp(dot(q, dir), 0.0, l)
    let w = 0.07 * sin(3.14159 * t / l) + 0.004
    length(q - dir * t) - w
}

/// A grove of bamboo at `x0`: stalks ringed every 0.6 m, fans of leaves near their tops,
/// swaying in the wind (`time`). Its distance, and 1 where it's leaf.
fn grove(q: vec2, x0: f32, ground: f32, cell: i32, time: f32) -> (f32, f32) {
    var d = 1.0e3
    var leafy = 0.0
    for s in 0..4 {
        let hs = hash2(cell * 7 + s, 53)
        let x = x0 + f32(s) * 0.42 + hs * 0.25
        let top = 4.0 + 2.5 * hs
        let up = (q.y - ground) / top
        let sway = 0.12 * sin(time * 0.8 + x * 1.3) * up * up
        let local = vec2(q.x - x - sway, q.y - ground)
        let ring = smoothstep(0.03, 0.0, abs(fract(local.y / 0.6) - 0.5) - 0.47)
        let stalk = max(abs(local.x) - 0.08 + ring * 0.015, max(local.y - top, -local.y))
        if stalk < d {
            d = stalk
            leafy = 0.0
        }
        if local.y < top * 0.5 - 0.7 || abs(local.x) > 1.5 {
            continue
        }
        for l in 0..5 {
            let hl = hash2(cell * 31 + s * 7 + l, 54)
            let y = top * (0.55 + 0.45 * f32(l) / 4.0)
            let side = if (l + s) % 2 == 0 { -1.0 } else { 1.0 }
            let bend = 0.12 * sin(time * 0.8 + x * 1.3) * (y / top) * (y / top)
            let base = vec2(x + bend, ground + y)
            let dir = normalize(vec2(side * cos(0.3 + 0.5 * hl), -sin(0.3 + 0.5 * hl) * 0.6 - 0.1))
            let leaf_d = min(
                leaf(q, base, dir, 0.9 + 0.4 * hl),
                leaf(q, base + vec2(0.0, 0.15), normalize(dir + vec2(0.0, 0.5)), 0.7),
            )
            if leaf_d < d {
                d = leaf_d
                leafy = 1.0
            }
        }
    }
    (d, leafy)
}

@fragment
pub fn bamboo(pixel: FragCoord, v: View) -> Over {
    let q = on_layer(pixel, v, BAMBOO)
    let px = pixel_on(v, BAMBOO)
    let ground = near_ground(q.x)
    let bush = vec3(0.38, 0.58, 0.32)
    if q.y > ground + 7.6 {
        discard()
    }
    if q.y < ground + 0.1 {
        return under(bush, q, ground + 0.4, 0.14)
    }
    // The bushes: mounds of round lumps, shaded on the side away from the sun, with flowers.
    var d = q.y - ground - 0.4
    let lump = floor(q.x / 1.3)
    var centre = vec2(q.x, ground)
    for k in -2..3 {
        let i = lump + f32(k)
        let h = hash2(i32(i), 61)
        let at = vec2((i + 0.5) * 1.3 + (h - 0.5) * 0.6, ground + 0.3 + 0.7 * h)
        let l = length(q - at) - (0.6 + 0.6 * hash2(i32(i), 62))
        if l < d {
            centre = at
        }
        d = smin(d, l, 0.3)
    }
    var albedo = crowned(bush, bush * vec3(0.86, 0.89, 0.92), q, centre, 1.0)
    let cf = floor(q / 0.32)
    let hf = hash2(i32(cf.x), i32(cf.y) + 500)
    if hf < 0.025 && d < -0.08 && d > -0.7 {
        let petal = length(q - (cf + vec2(0.5)) * 0.32) - 0.07
        let bloom = if hf < 0.025 {
            vec3(0.93, 0.33, 0.33)
        } else if hf < 0.05 {
            vec3(0.97, 0.66, 0.78)
        } else {
            vec3(1.0, 0.87, 0.4)
        }
        albedo = blend(albedo, bloom, smoothstep(px, -px, petal))
    }
    let cell = floor(q.x / 9.0)
    for k in -1..2 {
        let i = cell + f32(k)
        let x0 = (i + 0.2 + 0.4 * hash2(i32(i), 52)) * 9.0
        if hash2(i32(i), 51) < 0.3 && q.x > x0 - 1.5 && q.x < x0 + 3.0 {
            let (g, leafy) = grove(q, x0, near_ground(x0), i32(i), v.time)
            if g < d {
                d = g
                albedo = if leafy > 0.5 { vec3(0.44, 0.64, 0.32) } else { vec3(0.66, 0.74, 0.4) }
            }
        }
    }
    paint(d, albedo, q, px, haze: 0.14, line: 1.2)
}
