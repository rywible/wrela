// What's behind the course, painted as a picture book's backdrop (ink.wrela): the first level's
// place in the zoo (design.md, "A map of the zoo"). The level is in the Capybara Wetlands, so the
// near layers are the wetlands and the far ones what lies beyond them on the zoo's map: the
// Savanna next door, over its wall, and the Aviary's dome on the skyline. The sky has puffed
// clouds and the sun. Each layer moves by its own fraction of the camera's motion (parallax) and
// is drawn per pixel over the screen as a field: its shapes' distances, unioned, the pixel inside
// where it's below 0, then a wash with an ink line. Nothing here is a picture: shapes, hashes and
// noise in cells along the layer.
//
// - The far hills (0.06): blue ranges, a tree line, and the Aviary's glass dome.
// - The Savanna next door (0.2): its wall, and over it flat-topped acacias and giraffes.
// - The wetlands (0.42): the capybaras' hot spring, the flamingos' lagoon, a tapir, rheas, a giant
//   anteater, trees, the boardwalk with its rope rail.
// - The marsh (0.68): marsh grass, cattails and papyrus at the water's edge, nearest.
//
// A layer further back is drawn smaller, paler (its washes and its ink fade towards the mist's
// colour) and with a finer line. Shading is the painter's: a second, darker wash on the side of
// a crown away from the sun, not light. Below its ground a layer darkens, so a pit looks down
// into shade. Each layer skips its shapes where none can be (above its tallest, below its
// ground, behind the Savanna's wall, above a marsh plant's height), and all of them are drawn in
// one pass, nearest first (`backdrop`), each only while what's nearer leaves the pixel uncovered,
// and none where the course's ground covers it.

use earth::surely_ground_below
use engine::noise::{hash2, noise2}
use ink::{INK, SUN, inked, paper, pooled, washed}
use shapes::{blend, capsule, cone, ellipse, rbox, turn}
use std::field::smin
use std::gpu::{FragCoord, Rgba16Float, Sampler, Texture, discard}

/// What each of the screen's layers is told: the camera's point on the plane of play (m), half
/// the view's size (m), the screen's size (px) and the time (s).
pub struct View: Copy + GpuData {
    pub centre: vec2,
    pub half: vec2,
    pub screen: vec2,
    pub time: f32,
    pub pad: f32 = 0.0,
}

/// The layers' fractions of the camera's motion.
pub const FAR: f32 = 0.06
pub const SAVANNA: f32 = 0.2
pub const PATH: f32 = 0.42
pub const BAMBOO: f32 = 0.68

/// The mist the far layers fade into.
const MIST = vec3(0.83, 0.88, 0.87)

/// How much smaller a layer is drawn, for its parallax.
fn zoom(parallax: f32) -> f32 {
    0.45 + 0.55 * parallax
}

/// The point a pixel shows on a layer that moves by `parallax` of the camera's motion.
fn on_layer(pixel: FragCoord, v: View, parallax: f32) -> vec2 {
    let uv = pixel.position.xy / v.screen
    let offset = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) * v.half
    (v.centre * parallax + offset) / zoom(parallax)
}

/// A pixel's size on a layer (m).
fn pixel_on(v: View, parallax: f32) -> f32 {
    2.0 * v.half.y / v.screen.y / zoom(parallax)
}

/// A layer's shape painted: its wash, pooled at the edge, faded by `haze` into the mist, and
/// inked with a line `line` px wide.
fn paint(
    g: Texture<Rgba16Float>,
    gs: Sampler,
    d: f32,
    albedo: vec3,
    q: vec2,
    px: f32,
    haze: f32,
    line: f32,
) -> vec4 {
    // Outside the shape and its line, nothing: no need to paint it.
    if d > max(line * px * 0.65, px * 0.4) + px {
        return vec4(0.0)
    }
    var c = pooled(washed(albedo, q, g, gs), d, 0.12)
    c = blend(c, MIST, haze)
    let ink = blend(INK, MIST, min(haze * 1.7, 0.9))
    let o = inked(c, d, q, line * px, px, ink)
    o
}

/// What a layer is under its ground: its fill washed and darkening downwards into shade.
fn under(
    g: Texture<Rgba16Float>,
    gs: Sampler,
    albedo: vec3,
    q: vec2,
    ground: f32,
    haze: f32,
) -> vec4 {
    let deep = smoothstep(0.0, 6.0, ground - q.y)
    let c = blend(washed(albedo, q, g, gs), vec3(0.3, 0.4, 0.36), deep * 0.8)
    vec4(blend(c, MIST, haze * (1.0 - deep)), 1.0)
}

/// Fractal value noise: `octaves` of `noise2`, each twice as fine and half as strong, in 0 to 1.
fn fbm(p: vec2, octaves: u32) -> f32 {
    var sum = 0.0
    var weight = 0.5
    var q = p
    var total = 0.0
    for _ in 0..octaves {
        sum += noise2(q) * weight
        total += weight
        weight *= 0.5
        q = q * 2.03 + vec2(17.1, 9.3)
    }
    sum / total
}

// ---- shapes ----------------------------------------------------------------------------------

/// A crown's colour at `q`: its wash, and a darker one on the side away from the sun (`centre`
/// its middle, `r` its size), with a soft painted edge between.
fn crowned(lit: vec3, shade: vec3, q: vec2, centre: vec2, r: f32) -> vec3 {
    let away = dot(q - centre, SUN) / r + 0.15 * noise2(q * 3.0)
    blend(shade, lit, smoothstep(-0.35, -0.15, away))
}

// ---- the sky ---------------------------------------------------------------------------------

/// Where the sun stands on the screen: across, as a fraction of the screen's height from the
/// left; down, as a fraction of its height from the top.
const SUN_AT = vec2(0.8, 0.17)

/// A puffed cloud in its cell, at `q` on the cloud's layer: lumps on a flat bottom. Its
/// distance, and the height of its bottom.
fn cloud(q: vec2, time: f32) -> (f32, f32) {
    let x = q.x - time * 0.05
    let cell = floor(x / 16.0)
    var d = 1.0e3
    var base = 0.0
    for k in -1..2 {
        let i = cell + f32(k)
        let h = hash2(i32(i), 81)
        if h < 0.45 {
            let at = vec2((i + 0.5) * 16.0 + (h - 0.4) * 6.0, 6.0 + 3.0 * hash2(i32(i), 82))
            let size = 0.7 + 0.6 * hash2(i32(i), 83)
            var c = 1.0e3
            for j in 0..5 {
                let fj = f32(j) - 2.0
                let r = (1.3 - 0.22 * abs(fj)) * size * (0.85 + 0.3 * hash2(i32(i) * 7 + j, 84))
                c = smin(c, length(vec2(x, q.y) - at - vec2(fj * 1.05 * size, r * 0.45)) - r, 0.3)
            }
            c = max(c, at.y - q.y)
            if c < d {
                d = c
                base = at.y
            }
        }
    }
    (d, base)
}

/// The sky: a wash from soft blue overhead to cream at the horizon; the sun, a pale disc with
/// painted rings round it; puffed clouds, cream, shaded blue-grey underneath, lightly inked.
fn sky(pixel: FragCoord, v: View, g: Texture<Rgba16Float>, gs: Sampler) -> vec4 {
    let uv = pixel.position.xy / v.screen
    let aspect = v.screen.x / v.screen.y
    let up = 1.0 - uv.y + v.centre.y * 0.004
    let p = on_layer(pixel, v, 0.03)
    let px = pixel_on(v, 0.03)
    var c = blend(vec3(0.97, 0.92, 0.8), vec3(0.6, 0.78, 0.89), smoothstep(0.28, 0.95, up))
    c = washed(c, p * 0.25, g, gs)
    let d = distance(vec2(uv.x * aspect, uv.y), vec2(SUN_AT.x * aspect, SUN_AT.y))
    let rings = smoothstep(0.16, 0.08, d) * 0.25
    c = blend(c, vec3(1.0, 0.95, 0.72), rings)
    let disc = inked(
        vec3(1.0, 0.86, 0.45),
        d - 0.045,
        p,
        width: 0.004,
        px: 1.0 / v.screen.y,
        ink: vec3(0.9, 0.55, 0.25),
    )
    c = blend(c, disc.xyz, disc.w)
    let (cd, base) = if p.y > 5.0 && p.y < 13.0 { cloud(p, v.time) } else { (1.0e3, 0.0) }
    if cd < 0.2 {
        let low = smoothstep(base + 0.7, base, p.y)
        let fill = blend(vec3(1.0, 0.98, 0.93), vec3(0.83, 0.87, 0.93), low)
        let o = inked(
            pooled(washed(fill, p, g, gs), cd, 0.25),
            cd,
            p,
            width: px * 1.4,
            px: px,
            ink: vec3(0.55, 0.62, 0.74),
        )
        c = blend(c, o.xyz, o.w)
    }
    // The paper the page is painted on, behind everything: its tooth and fibres, here.
    vec4(c * paper(p, px, g, gs), 1.0)
}

// ---- the far hills ---------------------------------------------------------------------------

fn far_hills(pixel: FragCoord, v: View, g: Texture<Rgba16Float>, gs: Sampler) -> vec4 {
    let q = on_layer(pixel, v, FAR)
    let px = pixel_on(v, FAR)
    if q.y > 7.0 {
        return vec4(0.0)
    }
    let ridge = 1.5 + 4.0 * fbm(vec2(q.x * 0.03, 3.0), 2)
    let trees = 1.0 +
        0.8 * fbm(vec2(q.x * 0.12, 9.0), 2) +
        0.3 * abs(sin(q.x * 2.1)) * noise2(vec2(q.x * 0.5, 2.0))
    let (a, b) = (q.y - ridge, q.y - trees)
    // The Aviary's dome, the one thing of the zoo that shows from everywhere: glass on a frame.
    let dome = max(length(q - vec2(30.0, 1.2)) - 2.4, 1.2 - q.y)
    if dome < min(a, b) {
        let l = q - vec2(30.0, 1.2)
        let rib = abs(fract(atan2(l.y, l.x) / 0.3927) - 0.5) * 0.3927 * length(l)
        let ring = abs(fract(length(l) / 0.8) - 0.5) * 0.8
        let glass = if min(rib, ring) < 0.05 { vec3(0.55, 0.62, 0.66) } else {
            vec3(0.82, 0.9, 0.93)
        }
        return paint(g, gs, dome, glass, q, px, haze: 0.5, line: 0.6)
    }
    if b < a {
        paint(g, gs, b, vec3(0.58, 0.72, 0.64), q, px, haze: 0.55, line: 0.6)
    } else {
        paint(g, gs, a, vec3(0.66, 0.76, 0.84), q, px, haze: 0.6, line: 0.6)
    }
}

// ---- the Savanna next door: its wall, acacias and giraffes over it --------------------------------------------------------

/// The savanna's ground at `x` (m).
fn savanna_ground(x: f32) -> f32 {
    0.4 + 0.7 * sin(x * 0.07) + 0.5 * noise2(vec2(x * 0.05, 4.0))
}

/// An acacia at `base`, `h` m tall: a thin trunk forking, and a flat, ragged crown. Its
/// distance, and 1 where it's crown.
fn acacia(p: vec2, base: vec2, h: f32, seed: f32) -> (f32, f32) {
    let q = p - base
    let fork = vec2(0.15, h * 0.55)
    var trunk = capsule(q, vec2(0.0), fork, 0.09)
    trunk = min(trunk, capsule(q, fork, vec2(-0.7, h * 0.9), 0.06))
    trunk = min(trunk, capsule(q, fork, vec2(0.9, h * 0.92), 0.06))
    let crown_at = q - vec2(0.1, h)
    let ragged = 0.18 * noise2(vec2(crown_at.x * 2.2 + seed * 10.0, 1.0)) - 0.06
    let crown = min(
        ellipse(crown_at, vec2(2.3, 0.38 + ragged)),
        ellipse(crown_at - vec2(-1.1, -0.15), vec2(1.0, 0.25)),
    )
    (min(trunk, crown), if crown < trunk { 1.0 } else { 0.0 })
}

/// A giraffe at `base` facing `dir`, its neck stretched up to eat (`t`, the time, sways it).
fn giraffe(p: vec2, base: vec2, dir: f32, t: f32) -> f32 {
    let q = (p - base) * vec2(dir, 1.0)
    var d = ellipse(q - vec2(0.0, 2.15), vec2(0.85, 0.42))
    for x in [-0.6, -0.45, 0.45, 0.6] {
        d = min(d, capsule(q, vec2(x, 2.0), vec2(x + 0.04, 0.0), 0.06))
    }
    let sway = 0.15 * sin(t * 0.6 + base.x)
    let head = vec2(1.3 + sway, 4.1)
    d = smin(d, capsule(q, vec2(0.65, 2.3), head - vec2(0.15, 0.1), 0.13), 0.15)
    d = min(d, ellipse(q - head - vec2(0.15, 0.0), vec2(0.3, 0.13)))
    d = min(d, capsule(q, head + vec2(-0.05, 0.1), head + vec2(-0.1, 0.32), 0.035))
    min(d, capsule(q, vec2(-0.8, 2.2), vec2(-1.05, 1.5), 0.03))
}

fn savanna(pixel: FragCoord, v: View, g: Texture<Rgba16Float>, gs: Sampler) -> vec4 {
    let q = on_layer(pixel, v, SAVANNA)
    let px = pixel_on(v, SAVANNA)
    let ground = savanna_ground(q.x)
    let grass = vec3(0.88, 0.8, 0.52)
    if q.y > ground + 6.2 {
        return vec4(0.0)
    }
    if q.y < ground - 0.3 {
        return under(g, gs, vec3(0.84, 0.74, 0.6), q, ground, 0.45)
    }
    // Well below the wall's top, only the wall shows: what's behind it isn't worked out.
    let wall = q.y - (ground + 1.0)
    if wall < -px * 3.0 {
        return savanna_wall(g, gs, q, wall, px)
    }
    var d = q.y - ground
    var albedo = grass
    let cell = floor(q.x / 8.0)
    for k in -1..2 {
        let i = cell + f32(k)
        let h = hash2(i32(i), 11)
        let x = (i + 0.2 + 0.6 * hash2(i32(i), 12)) * 8.0
        if h < 0.4 && abs(q.x - x) < 2.6 {
            let base = vec2(x, savanna_ground(x) - 0.2)
            let (tree, leaves) = acacia(q, base, 3.2 + 1.4 * h, h)
            if tree < d {
                d = tree
                albedo = if leaves > 0.5 {
                    let top = base + vec2(0.1, 3.2 + 1.4 * h)
                    crowned(vec3(0.56, 0.68, 0.38), vec3(0.48, 0.61, 0.36), q, top, 2.0)
                } else {
                    vec3(0.56, 0.43, 0.32)
                }
            }
        }
    }
    let herd = floor(q.x / 27.0)
    for k in -1..2 {
        let i = herd + f32(k)
        let x = (i + 0.3 + 0.4 * hash2(i32(i), 22)) * 27.0
        if hash2(i32(i), 21) < 0.55 && abs(q.x - x) < 2.0 {
            let dir = if hash2(i32(i), 23) < 0.5 { -1.0 } else { 1.0 }
            let animal = giraffe(q, vec2(x, savanna_ground(x) - 0.1), dir, v.time)
            if animal < d {
                d = animal
                // Patches: a warped grid of brown, light lines between.
                let patch = abs(fract(q * vec2(4.0, 4.5) + vec2(noise2(q * 6.0) * 0.4)) - vec2(0.5))
                let dark = smoothstep(0.44, 0.39, max(patch.x, patch.y))
                albedo = blend(vec3(0.97, 0.82, 0.5), vec3(0.78, 0.5, 0.28), dark)
            }
        }
    }
    if wall < 0.0 || wall < d {
        return savanna_wall(g, gs, q, wall, px)
    }
    paint(g, gs, d, albedo, q, px, haze: 0.45, line: 0.8)
}

/// The wall between the wetlands and the Savanna, `wall` m above its top (below 0 on it): what
/// shows over it is the Savanna.
fn savanna_wall(g: Texture<Rgba16Float>, gs: Sampler, q: vec2, wall: f32, px: f32) -> vec4 {
    let row = floor(q.y / 0.5)
    let block = abs(fract(q.x / 1.2 + row * 0.5) - 0.5) * 1.2
    let joint = min(block, abs(fract(q.y / 0.5) - 0.5) * 0.5)
    let stone = if joint > 0.03 { vec3(0.86, 0.72, 0.54) } else { vec3(0.66, 0.54, 0.42) }
    let coping = if wall > -0.12 { vec3(0.8, 0.72, 0.6) } else { stone }
    paint(g, gs, wall, coping, q, px, haze: 0.45, line: 0.8)
}

// ---- the wetlands: its residents, the hot spring, trees, the boardwalk ---------------------------

/// The path's ground at `x` (m).
fn path_ground(x: f32) -> f32 {
    -0.6 + 0.35 * sin(x * 0.11) + 0.2 * noise2(vec2(x * 0.3, 1.0))
}

/// A round tree at `base`, `h` m tall: a trunk and a crown of lumps, scalloped at its edge.
/// Its distance, and 1 where it's crown.
fn round_tree(p: vec2, base: vec2, h: f32, seed: f32) -> (f32, f32) {
    let q = p - base
    let trunk = min(
        cone(q, vec2(0.0), vec2(0.05, h * 0.7), ra: 0.2, rb: 0.12),
        capsule(q, vec2(0.0, h * 0.45), vec2(0.6, h * 0.7), 0.07),
    )
    var crown = 1.0e3
    for k in 0..5 {
        let a = f32(k) * 1.3 + seed * 6.0
        let at = vec2(0.0, h) + vec2(cos(a) * 1.1, sin(a) * 0.6)
        crown = smin(crown, length(q - at) - (1.0 + 0.3 * sin(a * 2.7)), 0.3)
    }
    // Scallops round the edge, as a painter's leaves.
    crown += 0.06 * abs(sin(atan2(q.y - h, q.x) * 9.0 + seed * 20.0))
    (min(trunk, crown), if crown < trunk { 1.0 } else { 0.0 })
}

/// The nearer of two shapes, each a distance and a colour.
fn nearer(a: (f32, vec3), b: (f32, vec3)) -> (f32, vec3) {
    let (da, _) = a
    let (db, _) = b
    if db < da { b } else { a }
}

/// The capybaras' hot spring: a pool in a ring of stones, steam curling up off it, three
/// capybaras soaking up to their chins, eyes shut, yuzus bobbing between them.
fn hot_spring(q: vec2, t: f32) -> (f32, vec3) {
    var best = (ellipse(q - vec2(0.0, 0.08), vec2(2.7, 0.3)), vec3(0.62, 0.86, 0.84))
    for k in 0..9 {
        let x = -2.8 + f32(k) * 0.7
        let stone = ellipse(q - vec2(x, 0.12 + 0.08 * sin(f32(k) * 2.3)), vec2(0.3, 0.18))
        if abs(x) > 2.2 {
            best = nearer(best, (stone, vec3(0.74, 0.72, 0.68)))
        }
    }
    let fur = vec3(0.84, 0.62, 0.42)
    for (x, dir) in [(-1.5, 1.0), (0.05, -1.0), (1.55, 1.0)] {
        // Each head as big again as a capybara's, so it reads from across the wetlands.
        let l = (q - vec2(x, 0.42)) * vec2(dir, 1.0) / 1.7
        let head = smin(
            rbox(turn(l, -0.08), vec2(0.26, 0.17), 0.11),
            length(l - vec2(-0.12, 0.2)) - 0.05,
            0.03,
        ) *
            1.7
        let shut = capsule(l, vec2(0.0, 0.07), vec2(0.07, 0.065), 0.012) < 0.0
        best = nearer(best, (head, if shut { vec3(0.3, 0.2, 0.14) } else { fur }))
    }
    for x in [-0.75, 0.82] {
        best = nearer(
            best,
            (length(q - vec2(x, 0.32 + 0.03 * sin(t * 1.5 + x))) - 0.16, vec3(1.0, 0.84, 0.25)),
        )
    }
    for x in [-1.8, -0.4, 1.0, 2.1] {
        let up = q.y - 0.7
        if up > 0.0 && up < 1.3 {
            let curl = abs(q.x - x - 0.12 * sin(q.y * 5.0 - t * 1.6 + x)) - 0.05 * (1.0 - up / 1.3)
            best = nearer(best, (curl, vec3(0.98, 0.97, 0.94)))
        }
    }
    best
}

/// A Chilean flamingo standing on one leg (`l` from its foot), facing +x: pink, its neck an S, its
/// beak bent and dark at the tip.
fn flamingo(l: vec2) -> (f32, vec3) {
    let pink = vec3(0.98, 0.58, 0.64)
    var d = capsule(l, vec2(0.0), vec2(0.0, 1.25), 0.03)
    d = min(d, capsule(l, vec2(0.0, 0.85), vec2(-0.2, 1.0), 0.03))
    d = min(d, capsule(l, vec2(-0.2, 1.0), vec2(0.0, 1.15), 0.03))
    d = min(d, ellipse(turn(l - vec2(0.0, 1.45), 0.15), vec2(0.38, 0.2)))
    d = min(d, capsule(l, vec2(0.25, 1.5), vec2(0.42, 1.95), 0.045))
    d = min(d, capsule(l, vec2(0.42, 1.95), vec2(0.28, 2.35), 0.045))
    d = min(d, length(l - vec2(0.33, 2.42)) - 0.09)
    let beak = cone(l, vec2(0.4, 2.42), vec2(0.55, 2.27), ra: 0.045, rb: 0.018)
    let tip = if l.x > 0.49 { vec3(0.2, 0.15, 0.15) } else { vec3(0.98, 0.9, 0.85) }
    nearer((d, pink), (beak, tip))
}

/// The flamingos' lagoon: a shallow pool and three flamingos in it.
fn flamingos(q: vec2) -> (f32, vec3) {
    var best = (ellipse(q - vec2(0.0, 0.02), vec2(3.6, 0.26)), vec3(0.6, 0.84, 0.86))
    for (x, dir) in [(-1.9, 1.0), (0.3, -1.0), (2.2, 1.0)] {
        best = nearer(best, flamingo((q - vec2(x, 0.05)) * vec2(dir, 1.0)))
    }
    best
}

/// A lowland tapir (`l` from where it stands), facing +x: a heavy brown body on short legs, a
/// short trunk of a snout, ears tipped pale, browsing at `t`.
fn tapir(l: vec2, t: f32) -> (f32, vec3) {
    let brown = vec3(0.5, 0.42, 0.38)
    let nod = 0.05 * sin(t * 0.7)
    var d = ellipse(l - vec2(0.0, 0.85), vec2(0.95, 0.5))
    for x in [-0.6, -0.4, 0.45, 0.65] {
        d = smin(d, rbox(l - vec2(x, 0.3), vec2(0.11, 0.32), 0.07), 0.08)
    }
    d = smin(d, ellipse(l - vec2(0.95, 0.85 - nod), vec2(0.38, 0.3)), 0.15)
    d = smin(d, cone(l, vec2(1.2, 0.8 - nod), vec2(1.48, 0.6 - nod), ra: 0.13, rb: 0.07), 0.05)
    let ear = length(l - vec2(0.82, 1.18 - nod)) - 0.09
    nearer((d, brown), (ear, vec3(0.86, 0.82, 0.76)))
}

/// A greater rhea (`l` from its feet), facing +x: a big shaggy grey body on long legs, a long
/// neck up to a small head.
fn rhea(l: vec2) -> (f32, vec3) {
    var d = ellipse(turn(l - vec2(0.0, 1.15), -0.1), vec2(0.5, 0.33))
    d = min(d, capsule(l, vec2(-0.05, 0.9), vec2(-0.12, 0.0), 0.04))
    d = min(d, capsule(l, vec2(0.1, 0.9), vec2(0.18, 0.0), 0.04))
    d = smin(d, cone(l, vec2(0.35, 1.3), vec2(0.5, 2.0), ra: 0.1, rb: 0.06), 0.06)
    d = min(d, ellipse(l - vec2(0.56, 2.05), vec2(0.11, 0.08)))
    d = min(d, cone(l, vec2(0.64, 2.04), vec2(0.78, 2.0), ra: 0.035, rb: 0.015))
    (d, vec3(0.74, 0.7, 0.64))
}

/// Two rheas, one leading.
fn rheas(q: vec2) -> (f32, vec3) {
    nearer(rhea(q - vec2(-1.2, 0.0)), rhea(q - vec2(1.0, 0.0)))
}

/// A giant anteater (`l` from where it stands), facing +x: a long tapering snout, a great bushy
/// tail, and its black stripe edged in white from its chest over its shoulder.
fn anteater(l: vec2) -> (f32, vec3) {
    var d = ellipse(l - vec2(0.0, 0.78), vec2(0.8, 0.38))
    for x in [-0.5, -0.35, 0.4, 0.55] {
        d = smin(d, rbox(l - vec2(x, 0.28), vec2(0.09, 0.3), 0.06), 0.06)
    }
    d = smin(d, cone(l, vec2(0.65, 0.85), vec2(1.65, 0.55), ra: 0.2, rb: 0.035), 0.12)
    let tail = ellipse(turn(l - vec2(-1.05, 0.95), 0.35), vec2(0.55, 0.32))
    let stripe = abs(dot(l - vec2(0.35, 0.8), normalize(vec2(1.0, 1.6)))) - 0.07
    let edge = abs(dot(l - vec2(0.35, 0.8), normalize(vec2(1.0, 1.6)))) - 0.11
    let colour = if stripe < 0.0 && l.y < 1.1 {
        vec3(0.18, 0.15, 0.14)
    } else if edge < 0.0 && l.y < 1.1 {
        vec3(0.95, 0.92, 0.86)
    } else {
        vec3(0.62, 0.56, 0.5)
    }
    nearer((d, colour), (tail, vec3(0.42, 0.36, 0.32)))
}

/// How far apart the wetland's sights are (m on its layer).
const SIGHTS: f32 = 22.0

fn path(pixel: FragCoord, v: View, g: Texture<Rgba16Float>, gs: Sampler) -> vec4 {
    let q = on_layer(pixel, v, PATH)
    let px = pixel_on(v, PATH)
    let ground = path_ground(q.x)
    let marsh = vec3(0.6, 0.76, 0.44)
    if q.y > ground + 7.9 {
        return vec4(0.0)
    }
    if q.y < ground - 0.3 {
        return under(g, gs, marsh, q, ground, 0.15)
    }
    var best = (q.y - ground, marsh)
    // The sights, one in each stretch: the capybaras' hot spring, the flamingos' lagoon, a tapir,
    // the rheas, a giant anteater; and a tree at each stretch's end, now and then.
    let cell = floor(q.x / SIGHTS)
    for k in -1..2 {
        let i = cell + f32(k)
        let centre = (i + 0.5) * SIGHTS
        let base = vec2(centre, path_ground(centre) - 0.1)
        if abs(q.x - centre) < 4.6 && q.y < ground + 4.6 {
            let local = q - base
            let dir = if hash2(i32(i), 38) < 0.5 { -1.0 } else { 1.0 }
            let kind = i32(hash2(i32(i), 37) * 5.0)
            let sight = if kind == 0 {
                hot_spring(local, v.time)
            } else if kind == 1 {
                flamingos(local)
            } else if kind == 2 {
                tapir(local * vec2(dir, 1.0), v.time)
            } else if kind == 3 {
                rheas(local * vec2(dir, 1.0))
            } else {
                anteater(local * vec2(dir, 1.0))
            }
            best = nearer(best, sight)
        }
        let x = i * SIGHTS
        let h = hash2(i32(i), 31)
        if h < 0.6 && abs(q.x - x) < 3.0 {
            let foot = vec2(x, path_ground(x) - 0.2)
            let tall = 3.6 + 2.0 * h
            let (tree, leaves) = round_tree(q, foot, tall, h)
            let colour = if leaves > 0.5 {
                let lit = blend(vec3(0.42, 0.68, 0.34), vec3(0.52, 0.72, 0.34), hash2(i32(i), 33))
                crowned(lit, lit * vec3(0.86, 0.89, 0.93), q, foot + vec2(0.0, tall), 1.6)
            } else {
                vec3(0.58, 0.42, 0.28)
            }
            best = nearer(best, (tree, colour))
        }
    }
    // The boardwalk the keepers and the visitors walk: its planks, its posts, a rope rail sagging
    // between them.
    let fy = q.y - ground
    let deck = max(abs(fy - 0.02) - 0.07, -1.0)
    let post_x = q.x - (floor(q.x / 2.6) + 0.5) * 2.6
    let post = max(rbox(vec2(post_x, fy - 0.5), vec2(0.07, 0.5), 0.05), -fy)
    let t = fract(q.x / 2.6 + 0.5)
    let rope = abs(fy - (0.9 - 0.5 * t * (1.0 - t))) - 0.022
    best = nearer(best, (min(deck, post), vec3(0.74, 0.56, 0.38)))
    best = nearer(best, (rope, vec3(0.9, 0.8, 0.6)))
    let (d, albedo) = best
    paint(g, gs, d, albedo, q, px, haze: 0.22, line: 1.0)
}

// ---- the marsh, nearest -------------------------------------------------------------------------

fn near_ground(x: f32) -> f32 {
    -1.7 + 0.25 * sin(x * 0.17) + 0.2 * noise2(vec2(x * 0.5, 7.0))
}

/// The marsh at the water's edge, nearest: clumps of spiky marsh grass, stands of cattails, and
/// now and then a spray of papyrus, swaying in the wind (`time`).
fn bamboo(pixel: FragCoord, v: View, g: Texture<Rgba16Float>, gs: Sampler) -> vec4 {
    let q = on_layer(pixel, v, BAMBOO)
    let px = pixel_on(v, BAMBOO)
    let ground = near_ground(q.x)
    let grass = vec3(0.42, 0.62, 0.32)
    if q.y > ground + 5.6 {
        return vec4(0.0)
    }
    if q.y < ground + 0.1 {
        return under(g, gs, grass * 0.9, q, ground + 0.3, 0.14)
    }
    let up = q.y - ground
    let sway = 0.1 * sin(v.time * 0.9 + q.x * 0.4) * up / 3.0
    var best = (up - 0.3, grass)
    // Marsh grass: a clump of pointed blades every 0.8 m. (Each kind of plant is worked out only
    // up to the height it can reach.)
    let tuft = floor(q.x / 0.8)
    for k in -1..select(if_false: -1, if_true: 2, cond: up < 1.5) {
        let i = tuft + f32(k)
        let h = hash2(i32(i), 61)
        let x0 = (i + 0.5) * 0.8
        for b in 0..5 {
            let s = f32(b) - 2.0
            let tall = 0.6 + 0.8 * h * (1.0 - abs(s) * 0.2)
            let blade = cone(
                q,
                vec2(x0 + s * 0.08, ground),
                vec2(x0 + s * 0.3 + sway * 3.0, ground + tall),
                ra: 0.1,
                rb: 0.0,
            )
            best = nearer(best, (blade, blend(grass, vec3(0.55, 0.72, 0.36), h)))
        }
    }
    // Cattails: stands of three stalks with brown heads.
    let stand = floor(q.x / 2.6)
    for k in -1..select(if_false: -1, if_true: 2, cond: up < 3.2) {
        let i = stand + f32(k)
        if hash2(i32(i), 62) < 0.55 {
            let x0 = (i + 0.3 + 0.4 * hash2(i32(i), 63)) * 2.6
            for s in 0..3 {
                let hs = hash2(i32(i) * 5 + s, 64)
                let x = x0 + f32(s) * 0.22
                let top = 1.8 + 1.0 * hs
                let lean = 0.1 * sin(v.time * 0.9 + x * 0.4) * top / 3.0
                let stalk = capsule(q, vec2(x, ground), vec2(x + lean, ground + top + 0.25), 0.025)
                let head = capsule(
                    q,
                    vec2(x + lean * 0.85, ground + top - 0.25),
                    vec2(x + lean * 0.95, ground + top),
                    0.06,
                )
                best = nearer(best, (stalk, vec3(0.5, 0.66, 0.34)))
                best = nearer(best, (head, vec3(0.5, 0.34, 0.22)))
            }
        }
    }
    // Papyrus: a spray of thin stalks, each topped with a fan.
    let spray = floor(q.x / 9.0)
    for k in -1..2 {
        let i = spray + f32(k)
        let x0 = (i + 0.3 + 0.4 * hash2(i32(i), 66)) * 9.0
        if hash2(i32(i), 65) < 0.45 && abs(q.x - x0) < 2.4 && up < 4.3 {
            for s in 0..5 {
                let a = (f32(s) - 2.0) * 0.18
                let top = vec2(x0 + sin(a) * 3.6 + sway * 2.0, ground + cos(a) * 3.6)
                let stalk = capsule(q, vec2(x0, ground), top, 0.03)
                let fan = max(length(q - top) - 0.55, -(q.y - top.y + 0.1) - abs(q.x - top.x) * 0.2)
                let fronds = fan + 0.04 * abs(sin(atan2(q.y - top.y, q.x - top.x) * 14.0))
                best = nearer(best, (stalk, vec3(0.5, 0.68, 0.34)))
                best = nearer(best, (fronds, vec3(0.46, 0.68, 0.32)))
            }
        }
    }
    let (d, albedo) = best
    paint(g, gs, d, albedo, q, px, haze: 0.14, line: 1.2)
}

// ---- the backdrop's pass ---------------------------------------------------------------------

/// `back` under `front` so far, `front` premultiplied (its colour times its cover).
fn under_of(front: vec4, back: vec4) -> vec4 {
    let left = 1.0 - front.w
    vec4(front.xyz + back.xyz * back.w * left, front.w + back.w * left)
}

/// The backdrop: the layers in one pass, nearest first, each worked out only while what's nearer
/// hasn't covered the pixel; and none where the course's ground (`tops`, its top) covers it. A
/// layer's shapes cost far more than this, so what's hidden costs almost nothing (Ryan,
/// 2026-10-22: "make it way more performant"): drawn in five passes, back to front, every layer
/// worked out every pixel.
@fragment
pub fn backdrop(
    pixel: FragCoord,
    v: View,
    tops: [f32],
    g: Texture<Rgba16Float>,
    gs: Sampler,
) -> vec4 {
    let w = on_layer(pixel, v, 1.0)
    if w.y < surely_ground_below(tops, w.x) - 0.05 {
        discard()
    }
    var c = under_of(vec4(0.0), bamboo(pixel, v, g, gs))
    if c.w < 0.999 {
        c = under_of(c, path(pixel, v, g, gs))
    }
    if c.w < 0.999 {
        c = under_of(c, savanna(pixel, v, g, gs))
    }
    if c.w < 0.999 {
        c = under_of(c, far_hills(pixel, v, g, gs))
    }
    if c.w < 0.999 {
        c = under_of(c, sky(pixel, v, g, gs))
    }
    vec4(c.xyz, 1.0)
}
