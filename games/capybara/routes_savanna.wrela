/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level savanna --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 1.0e9, 315.11, 1.0e9, 332.64]

@test
fn the_searched_runs_of_savanna_finish_in_their_times_without_a_death() {
    let every = course(SAVANNA).every_snack()
    let any = play(SAVANNA, ANY)
    let full = play(SAVANNA, FULL)
    assert(any.finished == 1408 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 1969 && full.deaths == 0 && full.snacks == every)
    let human_any = play(SAVANNA, HUMAN_ANY)
    let human_full = play(SAVANNA, HUMAN_FULL)
    assert(human_any.finished == 1403 && human_any.deaths == 0)
    assert(human_full.finished == 1968 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
