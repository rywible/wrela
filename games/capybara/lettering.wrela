// The capybara's lettering: O'Capy's own typeface, drawn in code (Ryan, 2026-11-01: "we should
// make our own custom font for the game"). Every letter is a few strokes of one round pen, `W`
// wide, its ends and joins round: lines and arcs of ellipses on a grid of ems (`X` the x-height,
// `C` the capitals' and the figures' height, `A` an ascender's, `D` a descender's), with a big
// x-height and open, round bowls, so it reads soft and friendly, as the capybara does, and
// stays legible on a sign at 16 pixels. The figures share one advance (`FIGURE`), so a clock's
// digits don't jitter.
//
// It's baked when the game is built as ui::ttf's `Baked`, the form a TrueType font is baked into:
// each Latin-1 character's signed distance field at `EM` pixels per em, the same value in all
// three channels (the pen's corners are round, so the median needs no sharp corners kept). The
// accented letters are their base letters with their marks (`MARKS`). The line metrics are
// Inter's (ui::text's `SANS`), whose place the lettering takes, so every layout made for Inter
// holds.

use ui::text::{Fonts, SANS}
use ui::ttf::{Baked, BakedGlyph, Kern, LATIN1, latin1}

/// The grid, in ems: the x-height, the capitals' height, an ascender's and a descender's.
pub const X: f32 = 0.52
pub const C: f32 = 0.70
pub const A: f32 = 0.75
pub const D: f32 = -0.21

/// The pen's width, and half of it: a stroke's middle lies `H` inside the ink's edge.
pub const W: f32 = 0.12
pub const H: f32 = 0.06

/// How much narrower the letters are drawn than their grid (the pen's width stays): the
/// game's rows and signs were laid out for Inter, which is narrower than round letters.
pub const NARROW: f32 = 0.88

/// The space each side of a letter's ink, the figures' one advance, and a space's (ems).
const SIDE: f32 = 0.045
pub const FIGURE: f32 = 0.6
const SPACE: f32 = 0.25

/// The field's pixels per em and its spread each way (pixels), as ui::text bakes Inter.
pub const EM: f32 = 32.0
pub const SPREAD: f32 = 4.0

/// The baked lettering.
@fuel(2 ** 38)
pub const LETTERS: Baked = bake()

/// The game's fonts: the lettering for both faces (its figures are as wide as each other, so
/// it's a clock's face too).
pub fn fonts() -> Fonts {
    Fonts::from_baked(LETTERS, LETTERS)
}

// ---- the pen -----------------------------------------------------------------------------------

/// A letter as strokes of the pen: paths of points, ems up from the baseline.
pub struct Strokes: Clone {
    pub paths: Vec<Vec<vec2>>,
}

impl Strokes {
    pub fn new() -> Strokes {
        Strokes { paths: Vec::new() }
    }

    fn line(mut self, a: vec2, b: vec2) {
        self.paths.push(Vec::from([a, b]))
    }

    fn poly(mut self, points: [vec2]) {
        self.paths.push(Vec::from(points))
    }

    /// A round dot of the pen.
    fn dot(mut self, p: vec2) {
        self.paths.push(Vec::from([p]))
    }

    /// An arc of the ellipse round `c` with radii `r`, over `span`: from its first to its second
    /// angle in degrees (anticlockwise from the right when the second is larger, clockwise when
    /// smaller).
    fn arc(mut self, c: vec2, r: vec2, span: vec2) {
        let n = max(4, u32(ceil(abs(span.y - span.x) / 6.0)))
        var points: Vec<vec2> = Vec::new()
        for i in 0..n + 1 {
            let a = (span.x + (span.y - span.x) * f32(i) / f32(n)) * 0.017453292
            points.push(c + vec2(cos(a), sin(a)) * r)
        }
        self.paths.push(take points)
    }

    fn ring(mut self, c: vec2, r: vec2) {
        self.arc(c, r, vec2(0.0, 360.0))
    }

    /// Another letter's strokes, scaled by `k` and moved by `by`.
    fn with(mut self, other: Strokes, k: f32, by: vec2) {
        for path in other.paths {
            var moved: Vec<vec2> = Vec::new()
            for p in path {
                moved.push(p * k + by)
            }
            self.paths.push(take moved)
        }
    }

    /// The ink's left and right edges.
    fn ink(self) -> vec2 {
        var lo = 1.0e9
        var hi = -1.0e9
        for path in self.paths {
            for p in path {
                lo = min(lo, p.x)
                hi = max(hi, p.x)
            }
        }
        vec2(lo - H, hi + H)
    }
}

// ---- the letters -------------------------------------------------------------------------------

/// A lowercase bowl's middle and radii: the o's, a little narrower.
const BOWL: vec2 = vec2(0.27, 0.26)
const ROUND: vec2 = vec2(0.21, 0.2)

/// Character `c`'s strokes.
pub fn strokes(c: u32) -> Strokes {
    var s = Strokes::new()
    if let Some((base, mark)) = marked(c) {
        let b = strokes(base)
        let ink = b.ink()
        s.with(b, 1.0, vec2(0.0))
        let top = if base >= 0x61 { X + 0.1 } else { C + 0.06 }
        mark_of(mut s, mark, (ink.x + ink.y) * 0.5, top)
        return s
    }
    draw(mut s, c)
    s
}

/// The ASCII letters, figures and signs, and Latin-1's others.
fn draw(s: mut Strokes, c: u32) {
    let h = H
    match c {
        // a to z
        0x61 => {
            s.ring(BOWL, ROUND)
            s.line(vec2(0.48, X - h), vec2(0.48, h))
        },
        0x62 => {
            s.line(vec2(h, A - h), vec2(h, h))
            s.ring(BOWL, ROUND)
        },
        0x63 => s.arc(BOWL, ROUND, vec2(45.0, 315.0)),
        0x64 => {
            s.ring(BOWL, ROUND)
            s.line(vec2(0.48, A - h), vec2(0.48, h))
        },
        0x65 => {
            s.line(vec2(0.07, 0.26), vec2(0.47, 0.26))
            s.arc(BOWL, ROUND, vec2(0.0, 320.0))
        },
        0x66 => {
            s.arc(vec2(0.3, 0.58), vec2(0.13, 0.11), vec2(20.0, 180.0))
            s.line(vec2(0.17, 0.58), vec2(0.17, h))
            s.line(vec2(h, X - h), vec2(0.36, X - h))
        },
        0x67 => {
            s.ring(BOWL, ROUND)
            s.line(vec2(0.48, X - h), vec2(0.48, -0.02))
            s.arc(vec2(0.27, -0.02), vec2(0.21, 0.13), vec2(0.0, -155.0))
        },
        0x68 => {
            s.line(vec2(h, A - h), vec2(h, h))
            s.arc(vec2(0.27, 0.27), vec2(0.21, 0.19), vec2(180.0, 0.0))
            s.line(vec2(0.48, 0.27), vec2(0.48, h))
        },
        0x69 => {
            s.line(vec2(h, X - h), vec2(h, h))
            s.dot(vec2(h, 0.64))
        },
        0x6A => {
            s.line(vec2(0.16, X - h), vec2(0.16, -0.03))
            s.arc(vec2(0.04, -0.03), vec2(0.12, 0.12), vec2(0.0, -140.0))
            s.dot(vec2(0.16, 0.64))
        },
        0x6B => {
            s.line(vec2(h, A - h), vec2(h, h))
            s.line(vec2(0.43, X - h), vec2(0.07, 0.19))
            s.line(vec2(0.19, 0.28), vec2(0.45, h))
        },
        0x6C => {
            s.line(vec2(h, A - h), vec2(h, 0.14))
            s.arc(vec2(0.15, 0.14), vec2(0.09, 0.08), vec2(180.0, 290.0))
        },
        0x6D => {
            s.line(vec2(h, X - h), vec2(h, h))
            s.arc(vec2(0.215, 0.31), vec2(0.155, 0.15), vec2(180.0, 0.0))
            s.line(vec2(0.37, 0.31), vec2(0.37, h))
            s.arc(vec2(0.525, 0.31), vec2(0.155, 0.15), vec2(180.0, 0.0))
            s.line(vec2(0.68, 0.31), vec2(0.68, h))
        },
        0x6E => {
            s.line(vec2(h, X - h), vec2(h, h))
            s.arc(vec2(0.27, 0.27), vec2(0.21, 0.19), vec2(180.0, 0.0))
            s.line(vec2(0.48, 0.27), vec2(0.48, h))
        },
        0x6F => s.ring(vec2(0.28, 0.26), vec2(0.22, 0.2)),
        0x70 => {
            s.line(vec2(h, X - h), vec2(h, D + h))
            s.ring(BOWL, ROUND)
        },
        0x71 => {
            s.ring(BOWL, ROUND)
            s.line(vec2(0.48, X - h), vec2(0.48, D + h))
        },
        0x72 => {
            s.line(vec2(h, X - h), vec2(h, h))
            s.arc(vec2(0.24, 0.29), vec2(0.18, 0.17), vec2(180.0, 60.0))
        },
        0x73 => {
            s.arc(vec2(0.22, 0.3575), vec2(0.16, 0.1025), vec2(30.0, 270.0))
            s.arc(vec2(0.22, 0.1575), vec2(0.17, 0.1025), vec2(90.0, -150.0))
        },
        0x74 => {
            s.line(vec2(0.16, 0.64), vec2(0.16, 0.15))
            s.arc(vec2(0.27, 0.15), vec2(0.11, 0.09), vec2(180.0, 300.0))
            s.line(vec2(h, X - h), vec2(0.36, X - h))
        },
        0x75 => {
            s.line(vec2(h, X - h), vec2(h, 0.25))
            s.arc(vec2(0.27, 0.25), vec2(0.21, 0.19), vec2(180.0, 360.0))
            s.line(vec2(0.48, X - h), vec2(0.48, h))
        },
        0x76 => s.poly([vec2(h, X - h), vec2(0.26, h), vec2(0.46, X - h)]),
        0x77 => s.poly(
            [vec2(h, X - h), vec2(0.2, h), vec2(0.35, 0.38), vec2(0.5, h), vec2(0.64, X - h)],
        ),
        0x78 => {
            s.line(vec2(h, X - h), vec2(0.44, h))
            s.line(vec2(h, h), vec2(0.44, X - h))
        },
        0x79 => {
            s.line(vec2(h, X - h), vec2(0.26, h))
            s.poly([vec2(0.46, X - h), vec2(0.21, -0.07), vec2(0.1, D + h)])
        },
        0x7A => s.poly([vec2(0.07, X - h), vec2(0.43, X - h), vec2(h, h), vec2(0.45, h)]),
        // A to Z
        0x41 => {
            s.poly([vec2(h, h), vec2(0.32, C - h), vec2(0.58, h)])
            s.line(vec2(0.16, 0.24), vec2(0.48, 0.24))
        },
        0x42 => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, C - h), vec2(0.3, C - h))
            s.arc(vec2(0.3, 0.4875), vec2(0.17, 0.1525), vec2(90.0, -90.0))
            s.line(vec2(0.3, 0.335), vec2(h, 0.335))
            s.line(vec2(h, 0.335), vec2(0.32, 0.335))
            s.arc(vec2(0.32, 0.1975), vec2(0.19, 0.1375), vec2(90.0, -90.0))
            s.line(vec2(0.32, h), vec2(h, h))
        },
        0x43 => s.arc(vec2(0.36, 0.35), vec2(0.3, 0.29), vec2(40.0, 320.0)),
        0x44 => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, C - h), vec2(0.26, C - h))
            s.arc(vec2(0.26, 0.35), vec2(0.32, 0.29), vec2(90.0, -90.0))
            s.line(vec2(0.26, h), vec2(h, h))
        },
        0x45 => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, C - h), vec2(0.46, C - h))
            s.line(vec2(h, 0.35), vec2(0.4, 0.35))
            s.line(vec2(h, h), vec2(0.47, h))
        },
        0x46 => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, C - h), vec2(0.46, C - h))
            s.line(vec2(h, 0.35), vec2(0.4, 0.35))
        },
        0x47 => {
            s.arc(vec2(0.37, 0.35), vec2(0.31, 0.29), vec2(45.0, 360.0))
            s.line(vec2(0.68, 0.35), vec2(0.46, 0.35))
        },
        0x48 => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(0.58, h), vec2(0.58, C - h))
            s.line(vec2(h, 0.35), vec2(0.58, 0.35))
        },
        0x49 => s.line(vec2(h, h), vec2(h, C - h)),
        0x4A => {
            s.line(vec2(0.4, C - h), vec2(0.4, 0.23))
            s.arc(vec2(0.23, 0.23), vec2(0.17, 0.17), vec2(0.0, -180.0))
        },
        0x4B => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(0.53, C - h), vec2(0.07, 0.24))
            s.line(vec2(0.21, 0.36), vec2(0.55, h))
        },
        0x4C => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, h), vec2(0.45, h))
        },
        0x4D => s.poly(
            [vec2(h, h), vec2(h, C - h), vec2(0.37, 0.22), vec2(0.68, C - h), vec2(0.68, h)],
        ),
        0x4E => s.poly([vec2(h, h), vec2(h, C - h), vec2(0.57, h), vec2(0.57, C - h)]),
        0x4F => s.ring(vec2(0.39, 0.35), vec2(0.33, 0.29)),
        0x50 => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, C - h), vec2(0.3, C - h))
            s.arc(vec2(0.3, 0.48), vec2(0.19, 0.16), vec2(90.0, -90.0))
            s.line(vec2(0.3, 0.32), vec2(h, 0.32))
        },
        0x51 => {
            s.ring(vec2(0.39, 0.35), vec2(0.33, 0.29))
            s.line(vec2(0.47, 0.17), vec2(0.74, -0.04))
        },
        0x52 => {
            draw(mut s, 0x50)
            s.line(vec2(0.3, 0.32), vec2(0.55, h))
        },
        0x53 => {
            s.arc(vec2(0.29, 0.4975), vec2(0.22, 0.1425), vec2(25.0, 270.0))
            s.arc(vec2(0.29, 0.2025), vec2(0.23, 0.1475), vec2(90.0, -155.0))
        },
        0x54 => {
            s.line(vec2(h, C - h), vec2(0.58, C - h))
            s.line(vec2(0.32, C - h), vec2(0.32, h))
        },
        0x55 => {
            s.line(vec2(h, C - h), vec2(h, 0.31))
            s.arc(vec2(0.31, 0.31), vec2(0.25, 0.25), vec2(180.0, 360.0))
            s.line(vec2(0.56, 0.31), vec2(0.56, C - h))
        },
        0x56 => s.poly([vec2(h, C - h), vec2(0.32, h), vec2(0.58, C - h)]),
        0x57 => s.poly(
            [vec2(h, C - h), vec2(0.22, h), vec2(0.43, 0.5), vec2(0.64, h), vec2(0.8, C - h)],
        ),
        0x58 => {
            s.line(vec2(h, C - h), vec2(0.56, h))
            s.line(vec2(h, h), vec2(0.56, C - h))
        },
        0x59 => {
            s.poly([vec2(h, C - h), vec2(0.31, 0.34), vec2(0.56, C - h)])
            s.line(vec2(0.31, 0.34), vec2(0.31, h))
        },
        0x5A => s.poly([vec2(0.07, C - h), vec2(0.54, C - h), vec2(h, h), vec2(0.56, h)]),
        // 0 to 9
        0x30 => s.ring(vec2(0.28, 0.35), vec2(0.22, 0.29)),
        0x31 => s.poly([vec2(0.08, 0.52), vec2(0.27, C - h), vec2(0.27, h)]),
        0x32 => {
            s.arc(vec2(0.26, 0.465), vec2(0.2, 0.175), vec2(165.0, -35.0))
            s.poly([vec2(0.424, 0.365), vec2(h, h), vec2(0.48, h)])
        },
        0x33 => {
            s.arc(vec2(0.25, 0.505), vec2(0.18, 0.135), vec2(150.0, -90.0))
            s.arc(vec2(0.26, 0.205), vec2(0.2, 0.15), vec2(90.0, -155.0))
        },
        0x34 => s.poly([vec2(0.38, h), vec2(0.38, C - h), vec2(h, 0.21), vec2(0.52, 0.21)]),
        0x35 => {
            s.poly([vec2(0.46, C - h), vec2(0.13, C - h), vec2(0.11, 0.37), vec2(0.135, 0.35)])
            s.arc(vec2(0.27, 0.22), vec2(0.21, 0.17), vec2(130.0, -150.0))
        },
        0x36 => {
            s.ring(vec2(0.27, 0.205), vec2(0.21, 0.15))
            s.arc(vec2(0.45, 0.205), vec2(0.39, 0.44), vec2(95.0, 180.0))
        },
        0x37 => s.poly([vec2(h, C - h), vec2(0.48, C - h), vec2(0.19, h)]),
        0x38 => {
            s.ring(vec2(0.27, 0.505), vec2(0.17, 0.135))
            s.ring(vec2(0.27, 0.2), vec2(0.2, 0.14))
        },
        0x39 => {
            s.ring(vec2(0.27, 0.495), vec2(0.21, 0.15))
            s.arc(vec2(0.09, 0.495), vec2(0.39, 0.44), vec2(275.0, 360.0))
        },
        // The signs.
        0x21 => {
            s.line(vec2(h, C - h), vec2(h, 0.24))
            s.dot(vec2(h, h))
        },
        0x22 => {
            s.line(vec2(h, 0.66), vec2(h, 0.5))
            s.line(vec2(0.18, 0.66), vec2(0.18, 0.5))
        },
        0x23 => {
            s.line(vec2(0.16, h), vec2(0.22, 0.6))
            s.line(vec2(0.36, h), vec2(0.42, 0.6))
            s.line(vec2(h, 0.22), vec2(0.5, 0.22))
            s.line(vec2(0.08, 0.44), vec2(0.52, 0.44))
        },
        0x24 => {
            s.arc(vec2(0.26, 0.47), vec2(0.18, 0.12), vec2(25.0, 270.0))
            s.arc(vec2(0.26, 0.23), vec2(0.19, 0.12), vec2(90.0, -155.0))
            s.line(vec2(0.26, 0.68), vec2(0.26, 0.02))
        },
        0x25 => {
            s.ring(vec2(0.14, 0.53), vec2(0.08, 0.1))
            s.ring(vec2(0.5, 0.17), vec2(0.08, 0.1))
            s.line(vec2(0.08, h), vec2(0.56, C - h))
        },
        0x26 => {
            s.arc(vec2(0.24, 0.53), vec2(0.115, 0.11), vec2(-50.0, 220.0))
            s.line(vec2(0.17, 0.45), vec2(0.55, h))
            s.arc(vec2(0.24, 0.19), vec2(0.18, 0.13), vec2(130.0, 345.0))
            s.line(vec2(0.414, 0.156), vec2(0.52, 0.3))
        },
        0x27 => s.line(vec2(h, 0.66), vec2(h, 0.5)),
        0x28 => s.arc(vec2(0.34, 0.26), vec2(0.28, 0.46), vec2(115.0, 245.0)),
        0x29 => s.arc(vec2(0.0, 0.26), vec2(0.28, 0.46), vec2(65.0, -65.0)),
        0x2A => {
            s.line(vec2(0.2, 0.66), vec2(0.2, 0.4))
            s.line(vec2(0.08, 0.6), vec2(0.32, 0.46))
            s.line(vec2(0.08, 0.46), vec2(0.32, 0.6))
        },
        0x2B => {
            s.line(vec2(h, 0.3), vec2(0.46, 0.3))
            s.line(vec2(0.26, 0.1), vec2(0.26, 0.5))
        },
        0x2C => s.line(vec2(0.08, h), vec2(0.04, -0.1)),
        0x2D | 0xAD => s.line(vec2(h, 0.28), vec2(0.3, 0.28)),
        0x2E => s.dot(vec2(h, h)),
        0x2F => s.line(vec2(h, -0.06), vec2(0.38, 0.7)),
        0x3A => {
            s.dot(vec2(h, h))
            s.dot(vec2(h, 0.42))
        },
        0x3B => {
            s.dot(vec2(0.08, 0.42))
            s.line(vec2(0.08, h), vec2(0.04, -0.1))
        },
        0x3C => s.poly([vec2(0.42, 0.52), vec2(h, 0.3), vec2(0.42, 0.08)]),
        0x3D => {
            s.line(vec2(h, 0.4), vec2(0.44, 0.4))
            s.line(vec2(h, 0.2), vec2(0.44, 0.2))
        },
        0x3E => s.poly([vec2(h, 0.52), vec2(0.42, 0.3), vec2(h, 0.08)]),
        0x3F => {
            s.arc(vec2(0.22, 0.5), vec2(0.16, 0.14), vec2(160.0, -60.0))
            s.poly([vec2(0.3, 0.379), vec2(0.22, 0.3), vec2(0.22, 0.24)])
            s.dot(vec2(0.22, h))
        },
        0x40 => {
            s.ring(vec2(0.38, 0.28), vec2(0.12, 0.13))
            s.line(vec2(0.5, 0.41), vec2(0.5, 0.19))
            s.arc(vec2(0.58, 0.19), vec2(0.08, 0.08), vec2(180.0, 360.0))
            s.line(vec2(0.66, 0.19), vec2(0.66, 0.28))
            s.arc(vec2(0.38, 0.28), vec2(0.28, 0.3), vec2(0.0, 320.0))
        },
        0x5B => s.poly([vec2(0.24, 0.7), vec2(h, 0.7), vec2(h, -0.14), vec2(0.24, -0.14)]),
        0x5C => s.line(vec2(h, 0.7), vec2(0.38, -0.06)),
        0x5D => s.poly([vec2(h, 0.7), vec2(0.24, 0.7), vec2(0.24, -0.14), vec2(h, -0.14)]),
        0x5E => s.poly([vec2(h, 0.42), vec2(0.22, C - h), vec2(0.38, 0.42)]),
        0x5F => s.line(vec2(h, -0.12), vec2(0.52, -0.12)),
        0x60 => s.line(vec2(h, 0.7), vec2(0.14, 0.6)),
        0x7B => s.poly(
            [
                vec2(0.3, 0.7),
                vec2(0.2, 0.68),
                vec2(0.18, 0.36),
                vec2(h, 0.28),
                vec2(0.18, 0.2),
                vec2(0.2, -0.12),
                vec2(0.3, -0.14),
            ],
        ),
        0x7C | 0xA6 => {
            if c == 0x7C {
                s.line(vec2(h, 0.74), vec2(h, -0.16))
            } else {
                s.line(vec2(h, 0.74), vec2(h, 0.36))
                s.line(vec2(h, 0.2), vec2(h, -0.16))
            }
        },
        0x7D => s.poly(
            [
                vec2(h, 0.7),
                vec2(0.16, 0.68),
                vec2(0.18, 0.36),
                vec2(0.3, 0.28),
                vec2(0.18, 0.2),
                vec2(0.16, -0.12),
                vec2(h, -0.14),
            ],
        ),
        0x7E => {
            s.arc(vec2(0.15, 0.28), vec2(0.09, 0.07), vec2(180.0, 0.0))
            s.arc(vec2(0.33, 0.28), vec2(0.09, 0.07), vec2(180.0, 360.0))
        },
        // Latin-1's signs.
        0xA1 => {
            s.dot(vec2(h, X - h))
            s.line(vec2(h, 0.28), vec2(h, D + 0.07))
        },
        0xA2 => {
            s.arc(BOWL, ROUND, vec2(45.0, 315.0))
            s.line(vec2(0.27, 0.56), vec2(0.27, -0.04))
        },
        0xA3 => {
            s.line(vec2(h, h), vec2(0.48, h))
            s.arc(vec2(0.3, 0.47), vec2(0.16, 0.17), vec2(20.0, 180.0))
            s.line(vec2(0.14, 0.47), vec2(0.12, h))
            s.line(vec2(h, 0.33), vec2(0.34, 0.33))
        },
        0xA4 => {
            s.ring(vec2(0.24, 0.3), vec2(0.13, 0.13))
            s.line(vec2(h, 0.48), vec2(0.13, 0.41))
            s.line(vec2(0.42, 0.48), vec2(0.35, 0.41))
            s.line(vec2(h, 0.12), vec2(0.13, 0.19))
            s.line(vec2(0.42, 0.12), vec2(0.35, 0.19))
        },
        0xA5 => {
            s.poly([vec2(h, C - h), vec2(0.29, 0.36), vec2(0.52, C - h)])
            s.line(vec2(0.29, 0.36), vec2(0.29, h))
            s.line(vec2(0.12, 0.3), vec2(0.46, 0.3))
            s.line(vec2(0.12, 0.17), vec2(0.46, 0.17))
        },
        0xA7 => {
            s.arc(vec2(0.22, 0.56), vec2(0.15, 0.1), vec2(30.0, 270.0))
            s.arc(vec2(0.22, 0.36), vec2(0.15, 0.1), vec2(90.0, -90.0))
            s.arc(vec2(0.22, 0.36), vec2(0.15, 0.1), vec2(90.0, 270.0))
            s.arc(vec2(0.22, 0.16), vec2(0.15, 0.1), vec2(90.0, -150.0))
        },
        0xA8 => {
            s.dot(vec2(h, 0.6))
            s.dot(vec2(0.24, 0.6))
        },
        0xA9 | 0xAE => {
            s.ring(vec2(0.38, 0.35), vec2(0.32, 0.32))
            if c == 0xA9 {
                s.arc(vec2(0.38, 0.35), vec2(0.14, 0.15), vec2(45.0, 315.0))
            } else {
                s.line(vec2(0.28, 0.18), vec2(0.28, 0.52))
                s.line(vec2(0.28, 0.52), vec2(0.4, 0.52))
                s.arc(vec2(0.4, 0.445), vec2(0.09, 0.075), vec2(90.0, -90.0))
                s.line(vec2(0.4, 0.37), vec2(0.28, 0.37))
                s.line(vec2(0.38, 0.37), vec2(0.49, 0.18))
            }
        },
        0xAA => {
            s.ring(vec2(0.17, 0.53), vec2(0.11, 0.1))
            s.line(vec2(0.28, 0.63), vec2(0.28, 0.43))
            s.line(vec2(h, 0.33), vec2(0.3, 0.33))
        },
        0xAB => {
            s.poly([vec2(0.24, 0.44), vec2(h, 0.28), vec2(0.24, 0.12)])
            s.poly([vec2(0.44, 0.44), vec2(0.26, 0.28), vec2(0.44, 0.12)])
        },
        0xAC => s.poly([vec2(h, 0.36), vec2(0.46, 0.36), vec2(0.46, 0.2)]),
        0xAF => s.line(vec2(h, 0.68), vec2(0.4, 0.68)),
        0xB0 => s.ring(vec2(0.14, 0.56), vec2(0.08, 0.08)),
        0xB1 => {
            s.line(vec2(h, 0.36), vec2(0.46, 0.36))
            s.line(vec2(0.26, 0.16), vec2(0.26, 0.56))
            s.line(vec2(h, h), vec2(0.46, h))
        },
        0xB2 => s.with(strokes(0x32), 0.55, vec2(0.0, 0.33)),
        0xB3 => s.with(strokes(0x33), 0.55, vec2(0.0, 0.33)),
        0xB9 => s.with(strokes(0x31), 0.55, vec2(0.0, 0.33)),
        0xB4 => s.line(vec2(h, 0.6), vec2(0.15, 0.71)),
        0xB5 => {
            s.line(vec2(h, X - h), vec2(h, D + h))
            s.arc(vec2(0.27, 0.25), vec2(0.21, 0.19), vec2(180.0, 360.0))
            s.line(vec2(0.48, X - h), vec2(0.48, h))
        },
        0xB6 => {
            s.line(vec2(0.3, C - h), vec2(0.3, -0.1))
            s.line(vec2(0.44, C - h), vec2(0.44, -0.1))
            s.line(vec2(0.3, C - h), vec2(0.46, C - h))
            s.ring(vec2(0.22, 0.48), vec2(0.09, 0.1))
            s.dot(vec2(0.22, 0.48))
        },
        0xB7 => s.dot(vec2(h, 0.28)),
        0xB8 => s.poly([vec2(0.1, 0.02), vec2(0.13, -0.07), vec2(h, -0.13)]),
        0xBA => {
            s.ring(vec2(0.16, 0.53), vec2(0.1, 0.1))
            s.line(vec2(h, 0.33), vec2(0.26, 0.33))
        },
        0xBB => {
            s.poly([vec2(h, 0.44), vec2(0.24, 0.28), vec2(h, 0.12)])
            s.poly([vec2(0.26, 0.44), vec2(0.44, 0.28), vec2(0.26, 0.12)])
        },
        0xBC | 0xBD | 0xBE => {
            let (top, bottom) = if c == 0xBC { (0x31, 0x34) } else if c == 0xBD {
                (0x31, 0x32)
            } else {
                (0x33, 0x34)
            }
            s.with(strokes(top), 0.5, vec2(0.0, 0.34))
            s.line(vec2(0.24, h), vec2(0.56, C - h))
            s.with(strokes(bottom), 0.5, vec2(0.46, 0.0))
        },
        0xBF => {
            var q = Strokes::new()
            draw(mut q, 0x3F)
            s.with(q, -1.0, vec2(0.44, 0.52))
        },
        0xC6 => {
            s.poly([vec2(h, h), vec2(0.38, C - h), vec2(0.82, C - h)])
            s.line(vec2(0.42, C - h), vec2(0.42, h))
            s.line(vec2(0.42, h), vec2(0.84, h))
            s.line(vec2(0.42, 0.35), vec2(0.78, 0.35))
            s.line(vec2(0.2, 0.26), vec2(0.42, 0.26))
        },
        0xD0 => {
            draw(mut s, 0x44)
            s.line(vec2(-0.04, 0.35), vec2(0.2, 0.35))
        },
        0xD7 => {
            s.line(vec2(h, 0.12), vec2(0.38, 0.44))
            s.line(vec2(h, 0.44), vec2(0.38, 0.12))
        },
        0xD8 => {
            s.ring(vec2(0.39, 0.35), vec2(0.33, 0.29))
            s.line(vec2(0.1, 0.02), vec2(0.68, 0.68))
        },
        0xDE => {
            s.line(vec2(h, h), vec2(h, C - h))
            s.line(vec2(h, 0.52), vec2(0.3, 0.52))
            s.arc(vec2(0.3, 0.37), vec2(0.18, 0.15), vec2(90.0, -90.0))
            s.line(vec2(0.3, 0.22), vec2(h, 0.22))
        },
        0xDF => {
            s.line(vec2(h, h), vec2(h, 0.55))
            s.arc(vec2(0.21, 0.55), vec2(0.15, 0.14), vec2(180.0, -50.0))
            s.arc(vec2(0.24, 0.24), vec2(0.2, 0.18), vec2(95.0, -150.0))
        },
        0xE6 => {
            s.ring(vec2(0.25, 0.26), vec2(0.19, 0.2))
            s.line(vec2(0.44, X - h), vec2(0.44, h))
            s.line(vec2(0.44, 0.26), vec2(0.8, 0.26))
            s.arc(vec2(0.62, 0.26), vec2(0.18, 0.2), vec2(0.0, 320.0))
        },
        0xF0 => {
            s.ring(vec2(0.27, 0.24), vec2(0.21, 0.19))
            s.arc(vec2(0.05, 0.25), vec2(0.43, 0.42), vec2(0.0, 65.0))
            s.line(vec2(0.2, 0.52), vec2(0.4, 0.64))
        },
        0xF7 => {
            s.line(vec2(h, 0.28), vec2(0.46, 0.28))
            s.dot(vec2(0.26, 0.48))
            s.dot(vec2(0.26, 0.08))
        },
        0xF8 => {
            s.ring(vec2(0.28, 0.26), vec2(0.22, 0.2))
            s.line(vec2(0.08, 0.02), vec2(0.48, 0.5))
        },
        0xFE => {
            s.line(vec2(h, A - h), vec2(h, D + h))
            s.ring(BOWL, ROUND)
        },
        0x131 => s.line(vec2(h, X - h), vec2(h, h)),
        _ => {},
    }
}

// ---- the marks ---------------------------------------------------------------------------------

/// The marks: grave, acute, circumflex, tilde, diaeresis, ring and cedilla.
pub const GRAVE: u32 = 1
pub const ACUTE: u32 = 2
pub const CIRCUMFLEX: u32 = 3
pub const TILDE: u32 = 4
pub const DIAERESIS: u32 = 5
pub const RING: u32 = 6
pub const CEDILLA: u32 = 7

/// Latin-1's accented letters: each one's base letter and mark (a lowercase i's base is the
/// dotless one, U+0131), in code order.
pub const MARKS: [(u32, u32, u32); 53] = [
    (0xC0, 0x41, GRAVE),
    (0xC1, 0x41, ACUTE),
    (0xC2, 0x41, CIRCUMFLEX),
    (0xC3, 0x41, TILDE),
    (0xC4, 0x41, DIAERESIS),
    (0xC5, 0x41, RING),
    (0xC7, 0x43, CEDILLA),
    (0xC8, 0x45, GRAVE),
    (0xC9, 0x45, ACUTE),
    (0xCA, 0x45, CIRCUMFLEX),
    (0xCB, 0x45, DIAERESIS),
    (0xCC, 0x49, GRAVE),
    (0xCD, 0x49, ACUTE),
    (0xCE, 0x49, CIRCUMFLEX),
    (0xCF, 0x49, DIAERESIS),
    (0xD1, 0x4E, TILDE),
    (0xD2, 0x4F, GRAVE),
    (0xD3, 0x4F, ACUTE),
    (0xD4, 0x4F, CIRCUMFLEX),
    (0xD5, 0x4F, TILDE),
    (0xD6, 0x4F, DIAERESIS),
    (0xD9, 0x55, GRAVE),
    (0xDA, 0x55, ACUTE),
    (0xDB, 0x55, CIRCUMFLEX),
    (0xDC, 0x55, DIAERESIS),
    (0xDD, 0x59, ACUTE),
    (0xE0, 0x61, GRAVE),
    (0xE1, 0x61, ACUTE),
    (0xE2, 0x61, CIRCUMFLEX),
    (0xE3, 0x61, TILDE),
    (0xE4, 0x61, DIAERESIS),
    (0xE5, 0x61, RING),
    (0xE7, 0x63, CEDILLA),
    (0xE8, 0x65, GRAVE),
    (0xE9, 0x65, ACUTE),
    (0xEA, 0x65, CIRCUMFLEX),
    (0xEB, 0x65, DIAERESIS),
    (0xEC, 0x131, GRAVE),
    (0xED, 0x131, ACUTE),
    (0xEE, 0x131, CIRCUMFLEX),
    (0xEF, 0x131, DIAERESIS),
    (0xF1, 0x6E, TILDE),
    (0xF2, 0x6F, GRAVE),
    (0xF3, 0x6F, ACUTE),
    (0xF4, 0x6F, CIRCUMFLEX),
    (0xF5, 0x6F, TILDE),
    (0xF6, 0x6F, DIAERESIS),
    (0xF9, 0x75, GRAVE),
    (0xFA, 0x75, ACUTE),
    (0xFB, 0x75, CIRCUMFLEX),
    (0xFC, 0x75, DIAERESIS),
    (0xFD, 0x79, ACUTE),
    (0xFF, 0x79, DIAERESIS),
]

/// Character `c`'s base letter and mark, if it's accented.
fn marked(c: u32) -> Option<(u32, u32)> {
    for (code, base, mark) in MARKS {
        if code == c {
            return Some((base, mark))
        }
    }
    None
}

/// Mark `mark` over (or, a cedilla, under) a letter whose ink's middle is `x`, its strokes from
/// `top` up.
fn mark_of(s: mut Strokes, mark: u32, x: f32, top: f32) {
    let b = top
    match mark {
        GRAVE => s.line(vec2(x - 0.05, b + 0.13), vec2(x + 0.04, b + 0.02)),
        ACUTE => s.line(vec2(x - 0.04, b + 0.02), vec2(x + 0.05, b + 0.13)),
        CIRCUMFLEX => s.poly([vec2(x - 0.1, b + 0.02), vec2(x, b + 0.12), vec2(x + 0.1, b + 0.02)]),
        TILDE => {
            s.arc(vec2(x - 0.06, b + 0.05), vec2(0.06, 0.045), vec2(180.0, 0.0))
            s.arc(vec2(x + 0.06, b + 0.05), vec2(0.06, 0.045), vec2(180.0, 360.0))
        },
        DIAERESIS => {
            s.dot(vec2(x - 0.09, b + 0.05))
            s.dot(vec2(x + 0.09, b + 0.05))
        },
        RING => s.ring(vec2(x, b + 0.07), vec2(0.055, 0.055)),
        CEDILLA => s.poly([vec2(x + 0.02, 0.02), vec2(x + 0.05, -0.07), vec2(x - 0.03, -0.13)]),
        _ => {},
    }
}

// ---- the bake ----------------------------------------------------------------------------------

/// A glyph's field to sample: its strokes' segments (pixels from the pen, up), its place and
/// size, and its bytes once sampled.
struct Job {
    segments: Vec<vec4>,
    left: f32,
    top: f32,
    width: u32,
    height: u32,
    bytes: Vec<u8>,
}

impl Job {
    /// The field round the strokes `s` (ems, moved to their place from the pen): their ink's
    /// bounds, the spread and a pixel more each way, as ui::ttf's fields are.
    fn around(s: Strokes) -> Job {
        var segments: Vec<vec4> = Vec::new()
        var lo = vec2(1.0e9)
        var hi = vec2(-1.0e9)
        for path in s.paths {
            for i in 0..path.len() {
                let a = path[i] * EM
                let b = if i + 1 < path.len() { path[i + 1] * EM } else { a }
                if i + 1 < path.len() || path.len() == 1 {
                    segments.push(vec4(a.x, a.y, b.x, b.y))
                }
                lo = min(lo, a)
                hi = max(hi, a)
            }
        }
        if segments.is_empty() {
            return Job { segments, left: 0.0, top: 0.0, width: 0, height: 0, bytes: Vec::new() }
        }
        let pad = ceil(SPREAD) + 1.0 + H * EM
        let (left, bottom) = (floor(lo.x - pad), floor(lo.y - pad))
        let (right, top) = (ceil(hi.x + pad), ceil(hi.y + pad))
        Job {
            segments,
            left,
            top,
            width: u32(right - left),
            height: u32(top - bottom),
            bytes: Vec::new(),
        }
    }

    /// Each texel's signed distance to the ink, positive inside, in all three channels.
    fn sample(mut self) {
        let half = H * EM
        var bytes: Vec<u8> = Vec::with_capacity(3 * self.width * self.height)
        for row in 0..self.height {
            let y = self.top - f32(row) - 0.5
            for col in 0..self.width {
                let q = vec2(self.left + f32(col) + 0.5, y)
                var d = 1.0e9
                for g in self.segments {
                    d = min(d, to_segment(q, g.xy, g.zw))
                }
                let v = clamp((half - d) / (2.0 * SPREAD) + 0.5, 0.0, 1.0)
                let byte = u8(floor(v * 255.0 + 0.5))
                bytes.push(byte)
                bytes.push(byte)
                bytes.push(byte)
            }
        }
        self.bytes = take bytes
    }
}

/// The distance from `q` to the segment from `a` to `b`.
pub fn to_segment(q: vec2, a: vec2, b: vec2) -> f32 {
    let ab = b - a
    let len2 = dot(ab, ab)
    let t = if len2 > 0.0 { clamp(dot(q - a, ab) / len2, 0.0, 1.0) } else { 0.0 }
    length(q - (a + ab * t))
}

/// Character `c`'s strokes moved to their place from the pen, and its advance (ems): its ink
/// with `SIDE` each side, a figure's centred in `FIGURE`, a space's `SPACE`.
pub fn placed(c: u32) -> (Strokes, f32) {
    var s = Strokes::new()
    s.with(strokes(c), 1.0, vec2(0.0))
    for k in 0..s.paths.len() {
        for i in 0..s.paths[k].len() {
            s.paths[k][i].x *= NARROW
        }
    }
    if s.paths.is_empty() {
        return (s, SPACE)
    }
    let ink = s.ink()
    let wide = ink.y - ink.x
    let figure = c >= 0x30 && c <= 0x39
    let advance = if figure { FIGURE } else { wide + 2.0 * SIDE }
    let from = if figure { (FIGURE - wide) * 0.5 } else { SIDE }
    var moved = Strokes::new()
    moved.with(s, 1.0, vec2(from - ink.x, 0.0))
    (moved, advance)
}

/// The lettering baked: each Latin-1 character's field and advance, Inter's line metrics.
fn bake() -> Baked {
    var jobs: Vec<Job> = Vec::new()
    var glyphs: Vec<BakedGlyph> = Vec::new()
    for i in 0..LATIN1 {
        let c = latin1(i)
        let (s, advance) = placed(c)
        jobs.push(Job::around(s))
        glyphs.push(
            BakedGlyph {
                codepoint: c,
                advance,
                left: 0.0,
                top: 0.0,
                width: 0,
                height: 0,
                offset: 0,
            },
        )
    }
    jobs.par_each_mut(|j| j.sample())
    var fields: Vec<u8> = Vec::new()
    for i in 0..LATIN1 {
        borrow j = jobs[i]
        glyphs[i].left = j.left
        glyphs[i].top = j.top
        glyphs[i].width = j.width
        glyphs[i].height = j.height
        glyphs[i].offset = fields.len()
        for v in j.bytes {
            fields.push(v)
        }
    }
    let kerning: Vec<Kern> = Vec::new()
    Baked {
        em: EM,
        spread: SPREAD,
        ascender: SANS.ascender,
        descender: SANS.descender,
        line_gap: SANS.line_gap,
        glyphs,
        kerning,
        fields,
    }
}

// ---- tests -------------------------------------------------------------------------------------

@test
fn every_latin1_character_but_the_spaces_has_ink() {
    for i in 0..LATIN1 {
        let c = latin1(i)
        let (s, advance) = placed(c)
        let space = c == 0x20 || c == 0xA0
        assert(s.paths.is_empty() == space, f"U+{c:04x} has ink: {!s.paths.is_empty()}")
        assert(advance > 0.1 && advance < 1.2, f"U+{c:04x}'s advance: {advance}")
    }
}

@test
fn the_figures_share_one_advance_and_the_marks_name_each_accented_letter_once() {
    for c in 0x30..0x3A {
        let (_, advance) = placed(c)
        assert(advance == FIGURE, f"{c}")
    }
    for i in 0..MARKS.len() {
        for j in 0..i {
            assert(MARKS[i].0 != MARKS[j].0, f"U+{MARKS[i].0:04x} marked twice")
        }
    }
}

@test
fn the_ink_stays_on_its_grid() {
    // No stroke reaches past the ascender's line with its marks, nor below the descender.
    for i in 0..LATIN1 {
        let c = latin1(i)
        let (s, _) = placed(c)
        for path in s.paths {
            for q in path {
                assert(q.y + H <= 0.98 && q.y - H >= D - 0.02, f"U+{c:04x} at {q}")
                assert(q.x - H >= SIDE - 1.0e-4 || (c >= 0x30 && c <= 0x39), f"U+{c:04x} at {q}")
            }
        }
    }
}
