/// Level `c`'s stroll (none for the lab).
pub fn stroll(c: u32) -> Vec<Hold> {
    match c {
        HOME => Vec::from(STROLL_HOME),
        WETLANDS => Vec::from(STROLL_WETLANDS),
        SAVANNA => Vec::from(STROLL_SAVANNA),
        RAINFOREST => Vec::from(STROLL_RAINFOREST),
        AVIARY => Vec::from(STROLL_AVIARY),
        REPTILES => Vec::from(STROLL_REPTILES),
        POLAR => Vec::from(STROLL_POLAR),
        FARM => Vec::from(STROLL_FARM),
        FOOD_COURT => Vec::from(STROLL_FOOD_COURT),
        _ => Vec::new(),
    }
}

@test
fn each_stroll_finishes_in_its_time_with_every_snack_and_no_death() {
    let home = play(HOME, STROLL_HOME)
    assert(home.finished == 1411 && home.deaths == 0, "home")
    assert(home.snacks == course(HOME).every_snack(), "home's snacks")
    let wetlands = play(WETLANDS, STROLL_WETLANDS)
    assert(wetlands.finished == 2400 && wetlands.deaths == 0, "wetlands")
    assert(wetlands.snacks == course(WETLANDS).every_snack(), "wetlands's snacks")
    let savanna = play(SAVANNA, STROLL_SAVANNA)
    assert(savanna.finished == 2283 && savanna.deaths == 0, "savanna")
    assert(savanna.snacks == course(SAVANNA).every_snack(), "savanna's snacks")
    let rainforest = play(RAINFOREST, STROLL_RAINFOREST)
    assert(rainforest.finished == 2519 && rainforest.deaths == 0, "rainforest")
    assert(rainforest.snacks == course(RAINFOREST).every_snack(), "rainforest's snacks")
    let aviary = play(AVIARY, STROLL_AVIARY)
    assert(aviary.finished == 2898 && aviary.deaths == 0, "aviary")
    assert(aviary.snacks == course(AVIARY).every_snack(), "aviary's snacks")
    let reptiles = play(REPTILES, STROLL_REPTILES)
    assert(reptiles.finished == 3656 && reptiles.deaths == 0, "reptiles")
    assert(reptiles.snacks == course(REPTILES).every_snack(), "reptiles's snacks")
    let polar = play(POLAR, STROLL_POLAR)
    assert(polar.finished == 3093 && polar.deaths == 0, "polar")
    assert(polar.snacks == course(POLAR).every_snack(), "polar's snacks")
    let farm = play(FARM, STROLL_FARM)
    assert(farm.finished == 4009 && farm.deaths == 0, "farm")
    assert(farm.snacks == course(FARM).every_snack(), "farm's snacks")
    let food_court = play(FOOD_COURT, STROLL_FOOD_COURT)
    assert(food_court.finished == 3595 && food_court.deaths == 0, "food_court")
    assert(food_court.snacks == course(FOOD_COURT).every_snack(), "food_court's snacks")
}
