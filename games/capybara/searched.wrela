// The route search's runs of each level (`wrela tool route -- --level <key>` writes them as
// routes_<key>.wrela, with their tests): any% and 100%, tool-assisted, and the same within a
// person's limits (design.md, "The agent loop"). The replays (replay.wrela's `tool_assisted`),
// the route tool and the levels' checks read them from here.

use course::{AVIARY, FARM, FOOD_COURT, HOME, LEVELS, POLAR, RAINFOREST, REPTILES, SAVANNA, WETLANDS}
use pad::Hold

/// The levels' keys, by number: what the route tool takes and names their runs' files by.
pub const KEYS: [Text; LEVELS] = [
    "home",
    "wetlands",
    "savanna",
    "rainforest",
    "aviary",
    "reptiles",
    "polar",
    "farm",
    "food_court",
]

/// A level's searched runs: any% and 100%, tool-assisted, then human-possible.
pub struct Searched: Clone {
    pub any: Vec<Hold>,
    pub full: Vec<Hold>,
    pub human_any: Vec<Hold>,
    pub human_full: Vec<Hold>,
    /// Where each move is first needed (m), by its bit's place (routes_<key>.wrela's `NEEDS`).
    pub needs: [f32; 5],
}

/// Level `c`'s searched runs (empty for a course with none: the lab, or a level not yet searched).
pub fn searched(c: u32) -> Searched {
    if c == HOME {
        Searched {
            any: Vec::from(routes_home::ANY),
            full: Vec::from(routes_home::FULL),
            human_any: Vec::from(routes_home::HUMAN_ANY),
            human_full: Vec::from(routes_home::HUMAN_FULL),
            needs: routes_home::NEEDS,
        }
    } else if c == WETLANDS {
        Searched {
            any: Vec::from(routes_wetlands::ANY),
            full: Vec::from(routes_wetlands::FULL),
            human_any: Vec::from(routes_wetlands::HUMAN_ANY),
            human_full: Vec::from(routes_wetlands::HUMAN_FULL),
            needs: routes_wetlands::NEEDS,
        }
    } else if c == SAVANNA {
        Searched {
            any: Vec::from(routes_savanna::ANY),
            full: Vec::from(routes_savanna::FULL),
            human_any: Vec::from(routes_savanna::HUMAN_ANY),
            human_full: Vec::from(routes_savanna::HUMAN_FULL),
            needs: routes_savanna::NEEDS,
        }
    } else if c == RAINFOREST {
        Searched {
            any: Vec::from(routes_rainforest::ANY),
            full: Vec::from(routes_rainforest::FULL),
            human_any: Vec::from(routes_rainforest::HUMAN_ANY),
            human_full: Vec::from(routes_rainforest::HUMAN_FULL),
            needs: routes_rainforest::NEEDS,
        }
    } else if c == AVIARY {
        Searched {
            any: Vec::from(routes_aviary::ANY),
            full: Vec::from(routes_aviary::FULL),
            human_any: Vec::from(routes_aviary::HUMAN_ANY),
            human_full: Vec::from(routes_aviary::HUMAN_FULL),
            needs: routes_aviary::NEEDS,
        }
    } else if c == REPTILES {
        Searched {
            any: Vec::from(routes_reptiles::ANY),
            full: Vec::from(routes_reptiles::FULL),
            human_any: Vec::from(routes_reptiles::HUMAN_ANY),
            human_full: Vec::from(routes_reptiles::HUMAN_FULL),
            needs: routes_reptiles::NEEDS,
        }
    } else if c == POLAR {
        Searched {
            any: Vec::from(routes_polar::ANY),
            full: Vec::from(routes_polar::FULL),
            human_any: Vec::from(routes_polar::HUMAN_ANY),
            human_full: Vec::from(routes_polar::HUMAN_FULL),
            needs: routes_polar::NEEDS,
        }
    } else if c == FARM {
        Searched {
            any: Vec::from(routes_farm::ANY),
            full: Vec::from(routes_farm::FULL),
            human_any: Vec::from(routes_farm::HUMAN_ANY),
            human_full: Vec::from(routes_farm::HUMAN_FULL),
            needs: routes_farm::NEEDS,
        }
    } else if c == FOOD_COURT {
        Searched {
            any: Vec::from(routes_food_court::ANY),
            full: Vec::from(routes_food_court::FULL),
            human_any: Vec::from(routes_food_court::HUMAN_ANY),
            human_full: Vec::from(routes_food_court::HUMAN_FULL),
            needs: routes_food_court::NEEDS,
        }
    } else {
        Searched {
            any: Vec::new(),
            full: Vec::new(),
            human_any: Vec::new(),
            human_full: Vec::new(),
            needs: [1.0e9; 5],
        }
    }
}

/// The level whose key is `key`, if one is.
pub fn level_of(key: str) -> Option<u32> {
    for i in 0..LEVELS {
        if KEYS[i] == key {
            return Some(i)
        }
    }
    None
}
