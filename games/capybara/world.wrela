// The sim's world: the course being played, the capybara, its foes, what it has found, the
// controls, and the attempt's clock in ticks (design.md, "Timing"). The ticker steps it from the
// host's records (`tick`); tests and searches step it from pads (`step`). It holds no course: a
// course is a constant, named by its number, so a world is a small value to clone, hash and
// compare.
//
// No lives (design.md, "Rules"): hurt or fallen out, the capybara goes back to its last
// checkpoint, the foes as they started, the clock running. A yuzu takes one hit instead. Going
// back isn't at once: for `DYING` ticks it stays where it was hurt or fell, taking no input, while
// the frames show it tumble away and the page close on it (Ryan, 2026-10-22: dying "just
// immediately clips back").
//
// Paused, the world stands still and its clock with it. The game opens paused on the level's title
// (`TITLE`): a jump's key, Enter, a click or a controller's A plays. Esc, P or a controller's Start
// pauses, on the pause's menu (`MENU`): resume, restart, the runs, the options and the controls.
// The menus are the sim's (engine::menu), so a restart chosen in one replays from the tick log:
// the arrows, the d-pad or the stick move the focus, a jump's key, Enter or A chooses, and Esc,
// Backspace or B backs out. A press on a menu's node (the frames publish each page's items as a
// semantic tree) chooses it too, by its number (`node`). The options (the music, the clock, the
// ghost) are the frames', kept in the game's storage: the sim counts the steps a player takes on
// each (`World::turns`), and the frames take them. On the runs' page the frames take the keys and
// clicks (replay.wrela's runs, to watch or race as a ghost), and the sim only closes it.
//
// The ticker steps a `Live`: the world, its attempt's run as it's played (pad.wrela's `Run`), so
// a finished attempt is a replay, and what happened, counted tick by tick for the frames (`Tally`).

use body::{Body, Mode, RADIUS, bounce, spawn}
use course::{COURSES, Course, HOME, LAB_COURSE, LEVELS, WETLANDS, course}
use engine::run::{Asks, TickInput}
use engine::sim::{SimState, Tick}
use feel::{FEEL, STEP}
use main::DEV
use foes::{Foe, MAX_FOES, NONE, RIDE, Touch, foe, half, knock, step_foe, touch}
use engine::menu::{Nav, Stick, moved}
use pad::{Controls, Hold, JUMP, NO_RUN, Pad, Run, pad_of}
use std::hash::StateHash
use std::input::{Assist, Event, Key, Mods, PadButton}
use std::serialize::Serialize

/// The movement lab's course number (course.wrela's `LAB_COURSE`).
pub const LAB: u32 = LAB_COURSE

/// Ticks between being hurt or falling out and coming back (1.1 s): the clock runs through them.
pub const DYING: u32 = 132

/// Ticks the capybara can't be hurt after coming back, and after a yuzu takes a hit.
const SPAWN_GRACE: u32 = 60
const YUZU_GRACE: u32 = 120

/// The pages the pause shows (`World::page`): the level's title, which the game opens on; the
/// pause's menu; and the pages the menu opens: the runs, the options, the controls and the levels
/// (the zoo's map, its focus on a level).
pub const TITLE: u32 = 0
pub const MENU: u32 = 1
pub const RUNS: u32 = 2
pub const OPTIONS: u32 = 3
pub const CONTROLS: u32 = 4
pub const MAP: u32 = 5

/// The menu's items, top to bottom.
pub const RESUME: u32 = 0
pub const RESTART: u32 = 1
pub const SEE_MAP: u32 = 2
pub const SEE_RUNS: u32 = 3
pub const SEE_OPTIONS: u32 = 4
pub const SEE_CONTROLS: u32 = 5
pub const MENU_ITEMS: u32 = 6

/// Ticks after the goal before its card shows, and a choice there plays the next level (1.6 s).
pub const CARD: u32 = 192

/// The options' items, top to bottom: the three the frames keep (`World::turns`), and back.
pub const MUSIC: u32 = 0
pub const CLOCK: u32 = 1
pub const GHOST: u32 = 2
pub const DONE: u32 = 3
pub const OPTION_ITEMS: u32 = 4

/// A page's own node, round its items, and how many node numbers each choice in the menus uses.
pub const PAGE_NODE: u32 = 15
const NODES: u32 = 128

/// The semantic node of item `item` (or `PAGE_NODE`) of page `page`, after `chosen` choices: a new
/// number after each choice. Toolchains before 0.5.1 kept the keys in a pressed node until it
/// went; `chosen` is in the sim's state, so the numbering stays.
pub fn node(chosen: u32, page: u32, item: u32) -> u32 {
    1 + (chosen % 1024) * NODES + page * 16 + item
}

/// The page and the item of node `n` (`node`).
pub fn item_of(n: u32) -> (u32, u32) {
    let k = (n - 1) % NODES
    (k / 16, k % 16)
}

/// How near the capybara's middle must come to a snack or a yuzu to take it (m).
const REACH: f32 = 0.8

pub struct World: Copy + Eq + StateHash + Serialize + SimState {
    pub course: u32,
    pub body: Body,
    pub foes: [Foe; MAX_FOES],
    pub controls: Controls,
    /// The attempt's clock: the level's ticks run, the first counted as 1.
    pub ticks: u32,
    /// The clock on the tick the capybara reached the goal; 0 until it has. And the ticks since,
    /// up to `CARD`.
    pub finished: u32,
    pub after: u32,
    /// The snacks found and the yuzus taken this attempt, a bit each, and whether it wears one.
    pub snacks: u32,
    pub yuzus: u32,
    pub yuzu: bool,
    /// The checkpoint it comes back to: 0 the start, `i + 1` the course's checkpoint `i`.
    pub checkpoint: u32,
    /// Ticks it can't be hurt.
    pub grace: u32,
    /// On a ride (foes.wrela's `Ride`): its foe's number + 1; 0 on its own feet.
    pub riding: u32,
    /// Times it was sent back to a checkpoint: hurt, or fallen out.
    pub deaths: u32,
    /// Ticks left until it comes back, while it's dying (0 otherwise), and whether it fell out
    /// (else it was hurt).
    pub dying: u32,
    pub fell: bool,
    /// The attempts begun: each restart begins one.
    pub attempt: u32,
    /// Paused: the world stands still, its clock too (a run's time is its play's). The game opens
    /// paused, on the level's title.
    pub paused: bool,
    /// Paused, the page shown (`TITLE`...), the item with the focus on the menu or the options,
    /// and the stick as the menus read it.
    pub page: u32,
    pub focus: u32,
    pub stick: Stick,
    /// The steps taken on the options the frames keep (`MUSIC`, `CLOCK`, `GHOST`): +1 on, -1
    /// back. And the choices made in the menus, which number their nodes (`node`).
    pub turns: [i32; 3],
    pub chosen: u32,
}

/// The course's foes as they start.
fn foes_of(c: Course) -> [Foe; MAX_FOES] {
    var foes = [NONE; MAX_FOES]
    for i in 0..c.foes.len() {
        foes[i] = foe(c.foes[i])
    }
    foes
}

/// A new attempt at course `c`: the course's start state.
pub fn world(c: u32) -> World {
    assert(c < COURSES)
    borrow at = course(c)
    World {
        course: c,
        body: spawn(at.start),
        foes: foes_of(at),
        controls: Controls {},
        ticks: 0,
        finished: 0,
        after: 0,
        snacks: 0,
        yuzus: 0,
        yuzu: false,
        checkpoint: 0,
        grace: 0,
        riding: 0,
        deaths: 0,
        dying: 0,
        fell: false,
        attempt: 0,
        paused: true,
        page: TITLE,
        focus: RESUME,
        stick: Stick {},
        turns: [0; 3],
        chosen: 0,
    }
}

/// Where the capybara comes back to: the start, or a checkpoint's flag.
fn comeback(w: World, c: Course) -> vec2 {
    if w.checkpoint == 0 { c.start } else { c.checkpoints[w.checkpoint - 1] + vec2(0.0, RADIUS) }
}

/// Hurt, or fallen out (`fell`): counted, and dying from now on.
fn die(w: mut World, fell: bool) {
    w.deaths += 1
    w.dying = DYING
    w.fell = fell
    w.body.vel = vec2(0.0)
}

/// Back to the last checkpoint, the foes as they started, its yuzu lost.
fn come_back(w: mut World, c: Course) {
    w.body = spawn(comeback(w, c))
    w.foes = foes_of(c)
    w.yuzu = false
    w.grace = SPAWN_GRACE
    w.riding = 0
}

/// Course `c`'s world just come back to its checkpoint `i` (0 its first flag), playing: as a
/// death leaves it, the foes as they started.
pub fn back_at(c: u32, i: u32) -> World {
    var w = world(c)
    w.paused = false
    w.checkpoint = i + 1
    come_back(mut w, course(c))
    w
}

/// One tick of the level from `pad`: the capybara, its foes and what touching them does, then
/// what it finds and where it is. After the goal, the capybara still moves but the clock stays.
@deterministic
pub fn step(w: mut World, pad: Pad) {
    borrow c = course(w.course)
    if w.finished == 0 {
        w.ticks += 1
    } else {
        w.after = min(w.after + 1, CARD)
    }
    if w.dying > 0 {
        // Dying: the foes go on; the capybara stays, then comes back.
        for i in 0..c.foes.len() {
            step_foe(mut w.foes[i], c)
        }
        w.dying -= 1
        if w.dying == 0 {
            come_back(mut w, c)
        }
        return
    }
    if w.riding > 0 {
        ride(mut w, pad, c)
    } else {
        body::step(mut w.body, pad, c, FEEL)
    }
    for i in 0..c.foes.len() {
        step_foe(mut w.foes[i], c)
    }
    w.grace = if w.grace > 0 { w.grace - 1 } else { 0 }
    let slide = if w.body.mode == Mode::Slide { w.body.speed } else { 0.0 }
    var hurt = false
    for i in 0..c.foes.len() {
        if w.riding > 0 {
            break
        }
        match touch(w.foes[i], w.body.at, w.body.vel, RADIUS, slide) {
            Touch::Stomp => {
                knock(mut w.foes[i])
                let under = c.water_at(w.body.at).is_some()
                bounce(mut w.body, pad.held(JUMP), FEEL, under)
            },
            Touch::Bowl => knock(mut w.foes[i]),
            Touch::Ride => {
                if w.body.mode != Mode::Swim {
                    w.riding = i + 1
                    w.foes[i].ridden = true
                }
            },
            Touch::Hurt => hurt = true,
            Touch::None => {},
        }
    }
    if hurt && w.grace == 0 {
        if w.yuzu {
            w.yuzu = false
            w.grace = YUZU_GRACE
        } else {
            die(mut w, fell: false)
            return
        }
    }
    if w.body.at.y < c.floor {
        die(mut w, fell: true)
        return
    }
    for i in 0..c.snacks.len() {
        if distance(w.body.at, c.snacks[i]) < REACH {
            w.snacks = w.snacks | (1 << i)
        }
    }
    for i in 0..c.yuzus.len() {
        if w.yuzus & (1 << i) == 0 && !w.yuzu && distance(w.body.at, c.yuzus[i]) < REACH {
            w.yuzus = w.yuzus | (1 << i)
            w.yuzu = true
        }
    }
    for i in w.checkpoint..c.checkpoints.len() {
        let flag = c.checkpoints[i]
        if abs(w.body.at.x - flag.x) < 1.0 &&
            w.body.at.y > flag.y - 1.0 &&
            w.body.at.y < flag.y + 4.0 {
            w.checkpoint = i + 1
        }
    }
    if w.finished == 0 && c.at_goal(w.body.at) {
        w.finished = w.ticks
    }
}

/// The level after course `c`, if there is one.
pub fn next(c: u32) -> Option<u32> {
    if c + 1 < LEVELS { Some(c + 1) } else { None }
}

/// A tick on a ride: the capybara sits on its back as it runs on, until a jump press leaps off,
/// as off a stomp with jump held, its double jump back.
fn ride(w: mut World, pad: Pad, c: Course) {
    let i = w.riding - 1
    let f = w.foes[i]
    if pad.pressed() {
        // Off: the ride wanders back home.
        w.riding = 0
        w.foes[i].ridden = false
        bounce(mut w.body, held: true, f: FEEL, under: false)
        w.body.vel.x = RIDE
        return
    }
    w.body.at = f.at + vec2(0.0, half(f.kind).y + RADIUS)
    w.body.vel = vec2(RIDE, 0.0)
    w.body.speed = RIDE
    w.body.facing = 1.0
    w.body.mode = Mode::Walk
    w.body.ground = vec2(0.0, 1.0)
}

/// A new attempt at course `c` in place of `w`, playing at once, keeping the controls as they're
/// held and what the menus keep.
fn restart(w: mut World, c: u32) {
    let (controls, attempt, stick, turns, chosen) = (
        w.controls,
        w.attempt,
        w.stick,
        w.turns,
        w.chosen,
    )
    w = world(c)
    w.controls = controls
    w.attempt = attempt + 1
    w.stick = stick
    w.turns = turns
    w.chosen = chosen
    w.paused = false
}

/// What event `e` does in the menus: the engine's (engine::menu), and the game's own keys besides:
/// a jump's other keys (Z, K) choose, and P pauses as Esc does.
fn nav_of(w: mut World, e: Event) -> Option<Nav> {
    let nav = w.stick.nav(e)
    if let Event::KeyDown { key, repeat, .. } = e {
        if !repeat && (key == Key::Z || key == Key::K) {
            return Some(Nav::Choose)
        } else if !repeat && key == Key::P {
            return Some(Nav::Pause)
        }
    }
    nav
}

/// Pauses `w`, on the menu.
fn pause(w: mut World) {
    w.paused = true
    w.page = MENU
    w.focus = RESUME
}

/// The menu's item `item` chosen.
fn choose(w: mut World, item: u32) {
    w.chosen += 1
    if item == RESUME {
        w.paused = false
    } else if item == RESTART {
        restart(mut w, w.course)
    } else if item == SEE_MAP {
        w.page = MAP
        w.focus = if w.course < LEVELS { w.course } else { 0 }
    } else if item == SEE_RUNS {
        w.page = RUNS
    } else if item == SEE_OPTIONS {
        w.page = OPTIONS
        w.focus = MUSIC
    } else if item == SEE_CONTROLS {
        w.page = CONTROLS
    }
}

/// Back from a page to the menu, the focus on `item`, the page's.
fn back(w: mut World, item: u32) {
    w.chosen += 1
    w.page = MENU
    w.focus = item
}

/// A step `by` (+1 or -1) on option `item`, or back from the options.
fn turn(w: mut World, item: u32, by: i32) {
    if item == DONE {
        back(mut w, SEE_OPTIONS)
        return
    }
    w.chosen += 1
    w.turns[item] += by
}

/// Paused, event `e` (`nav` in the menus) on the page shown.
fn paused(w: mut World, e: Event, nav: Option<Nav>) {
    // R and Tab work as they do in play, but on the runs, whose keys are the frames'.
    if w.page != RUNS {
        if let Event::KeyDown { key, repeat, .. } = e {
            if !repeat && key == Key::R {
                restart(mut w, w.course)
                return
            } else if DEV && !repeat && key == Key::Tab {
                restart(mut w, (w.course + 1) % COURSES)
                return
            }
        }
        if let Event::PadButton { pad, button, pressed, .. } = e {
            if pad == 0 && pressed && button == PadButton::Select {
                restart(mut w, w.course)
                return
            }
        }
    }
    // A press on one of the page's nodes, or a dismissal of the page.
    var pressed: Option<u32> = None
    var dismissed = false
    if let Event::Assist { node, action } = e {
        let (page, item) = item_of(node)
        if page != w.page || node == 0 {
            return
        }
        if action == Assist::Activate && item != PAGE_NODE {
            pressed = Some(item)
        } else if action == Assist::Focus && item != PAGE_NODE {
            w.focus = item
        } else if action == Assist::Dismiss {
            dismissed = true
        }
    }
    let back_out = dismissed || nav == Some(Nav::Back) || nav == Some(Nav::Pause)
    if w.page == TITLE {
        if let Event::PointerDown { .. } = e {
            w.paused = false
        } else if pressed.is_some() || nav == Some(Nav::Choose) {
            w.paused = false
        } else if nav == Some(Nav::Pause) {
            pause(mut w)
        }
    } else if w.page == MENU {
        if let Some(item) = pressed {
            choose(mut w, item)
        } else if back_out {
            choose(mut w, RESUME)
        } else if nav == Some(Nav::Choose) {
            choose(mut w, w.focus)
        } else if let Some(n) = nav {
            w.focus = moved(n, focus: w.focus, count: MENU_ITEMS)
        }
    } else if w.page == OPTIONS {
        if let Some(item) = pressed {
            turn(mut w, item, by: 1)
        } else if back_out {
            back(mut w, SEE_OPTIONS)
        } else if nav == Some(Nav::Choose) || nav == Some(Nav::Right) {
            turn(mut w, w.focus, by: 1)
        } else if nav == Some(Nav::Left) {
            if w.focus != DONE {
                turn(mut w, w.focus, by: -1)
            }
        } else if let Some(n) = nav {
            w.focus = moved(n, focus: w.focus, count: OPTION_ITEMS)
        }
    } else if w.page == CONTROLS {
        if back_out || pressed.is_some() || nav == Some(Nav::Choose) {
            back(mut w, SEE_CONTROLS)
        }
    } else if w.page == MAP {
        // The levels round the zoo: left and right (or up and down) step along them.
        if let Some(item) = pressed {
            if item < LEVELS {
                w.chosen += 1
                restart(mut w, item)
            }
        } else if back_out {
            back(mut w, SEE_MAP)
        } else if nav == Some(Nav::Choose) {
            w.chosen += 1
            restart(mut w, w.focus)
        } else if nav == Some(Nav::Left) {
            w.focus = moved(Nav::Up, focus: w.focus, count: LEVELS)
        } else if nav == Some(Nav::Right) {
            w.focus = moved(Nav::Down, focus: w.focus, count: LEVELS)
        } else if let Some(n) = nav {
            w.focus = moved(n, focus: w.focus, count: LEVELS)
        }
    } else if w.page == RUNS {
        // The runs' keys are the frames'; only backing out is the sim's.
        if back_out || pressed.is_some() {
            back(mut w, SEE_RUNS)
        }
    }
}

/// One tick from the host's records: playing, restart (R, or the controller's Select), the other
/// course (Tab: the lab or the level) and the pause; paused, the menus (`paused`); then the pad
/// they leave.
@deterministic
pub fn tick(w: mut World, input: TickInput<World>) {
    let _ = ticked(mut w, input.records)
}

/// One tick from `records`, as `tick`: the pad the world was stepped with, or none if it wasn't.
@deterministic
fn ticked(w: mut World, records: [Event]) -> Option<Pad> {
    // A tick that leaves the pause doesn't step, so the press that left it isn't also a jump.
    var held = w.paused
    for e in records {
        let nav = nav_of(mut w, e)
        if w.paused {
            paused(mut w, e, nav)
        } else if nav == Some(Nav::Pause) {
            pause(mut w)
            held = true
        } else if nav == Some(Nav::Choose) && w.after >= CARD && next(w.course).is_some() {
            // At the goal's card: on to the next level, the press not also a jump there.
            restart(mut w, next(w.course).expect("a next level"))
            held = true
        } else if let Event::KeyDown { key, repeat, .. } = e {
            if !repeat && key == Key::R {
                restart(mut w, w.course)
            } else if DEV && !repeat && key == Key::Tab {
                restart(mut w, (w.course + 1) % COURSES)
            }
        } else if let Event::PadButton { pad, button, pressed, .. } = e {
            if pad == 0 && pressed && button == PadButton::Select {
                restart(mut w, w.course)
            }
        }
        w.controls.update(e)
    }
    // The pad is read every tick, paused or not, so a press made in the pause is spent.
    let pad = w.controls.pad()
    if w.paused || held {
        return None
    }
    step(mut w, pad)
    Some(pad)
}

/// What happened in a world, counted tick by tick (`count`), for the frames. A frame sees a
/// snapshot only every tick or few (at 60 frames a second, every second tick; a run watched at
/// 4x, every eighth), so it reacts to a count that went up, not to a change between two
/// snapshots, which misses what lasts a tick: a jump pressed before landing is on the ground for
/// one. The ticker counts in `Live` and a watched run in its `Watch`, not in the world, so a world
/// stays the same value to the searches and the replays.
pub struct Tally: Copy + Eq + StateHash + Serialize + SimState + Plain {
    /// Landings from the air, and the latest one's feet and how fast it fell (m/s).
    pub landings: u32,
    pub landed: vec2,
    pub fall: f32,
    /// Jumps off the ground (in the air from it, rising faster than 2 m/s), and the latest one's
    /// feet.
    pub jumps: u32,
    pub left: vec2,
    /// Double jumps, and kicks in water (a rise of more than 3 m/s in a tick).
    pub doubles: u32,
    pub kicks: u32,
    /// Times the capybara was put somewhere at once: back at a checkpoint, a new attempt, the other
    /// course, or (a watched run) a seek.
    pub cuts: u32,
}

/// Nothing counted.
pub const NO_TALLY: Tally = Tally {
    landings: 0,
    landed: vec2(0.0),
    fall: 0.0,
    jumps: 0,
    left: vec2(0.0),
    doubles: 0,
    kicks: 0,
    cuts: 0,
}

impl Tally {
    /// The tick from `before` to `after`, counted.
    pub fn count(mut self, before: World, after: World) {
        if after.attempt != before.attempt ||
            after.course != before.course ||
            (before.dying > 0 && after.dying == 0) {
            self.cuts += 1
            return
        }
        let (was, now) = (before.body, after.body)
        let feet = now.at - now.ground * RADIUS
        if now.grounded() && was.mode == Mode::Air {
            self.landings += 1
            self.landed = feet
            self.fall = max(-was.vel.y, 0.0)
        }
        if now.mode == Mode::Air && was.grounded() && now.vel.y > 2.0 {
            self.jumps += 1
            self.left = feet
        }
        if now.flip > 0 && was.flip == 0 {
            self.doubles += 1
        }
        if now.mode == Mode::Swim && now.vel.y - was.vel.y > 3.0 {
            self.kicks += 1
        }
    }
}

/// One tick of `w` from `pad`, as `step`, counted in `t`.
pub fn step_counted(w: mut World, t: mut Tally, pad: Pad) {
    let before = w
    step(mut w, pad)
    t.count(before, w)
}

/// A whole-game run (design.md, "Timing": the levels in order in one sitting, its time the sum of
/// its levels' times, restarts and deaths included, menus and pauses not): whether one is on, its
/// ticks so far, and its time once the last level's goal is reached (0 before). One begins with
/// each attempt at the first level; going on to the next level from a goal's card keeps it on,
/// a restart too; any other way to another level ends it.
pub struct Game: Copy + Eq + StateHash + Serialize + SimState + Plain {
    pub on: bool,
    pub ticks: u32,
    pub done: u32,
}

/// What the ticker steps: the world, its attempt's run as it's played, what happened, and the
/// whole-game run, kept apart from the world so that searches and tests step a small value.
pub struct Live: Copy + Eq + StateHash + Serialize + SimState {
    pub world: World,
    pub run: Run,
    pub tally: Tally,
    pub game: Game,
}

/// A new game at course `c`.
pub fn live(c: u32) -> Live {
    Live {
        world: world(c),
        run: NO_RUN,
        tally: NO_TALLY,
        game: Game { on: c == HOME, ticks: 0, done: 0 },
    }
}

/// The whole-game run `g` after a tick from `before` to `after`.
fn game_after(g: mut Game, before: World, after: World) {
    let moved = after.attempt != before.attempt || after.course != before.course
    if moved {
        let onward = before.finished > 0 && next(before.course) == Some(after.course)
        if onward {
            // On to the next level from the goal's card: the run goes on.
        } else if after.course == HOME {
            g = Game { on: true, ticks: 0, done: 0 }
        } else if after.course != before.course {
            g.on = false
        }
        return
    }
    // The level's clock ran: so does the game's.
    if g.on && g.done == 0 && after.ticks > before.ticks {
        g.ticks += 1
        if after.finished > 0 && next(after.course).is_none() {
            g.done = g.ticks
        }
    }
}

/// One tick of `l`, as `tick`, recording each pad the world steps with until it reaches the goal:
/// a restart or another course starts a new run.
@deterministic
pub fn tick_live(l: mut Live, input: TickInput<Live>) {
    let before = l.world
    var done = before.finished > 0
    let pad = ticked(mut l.world, input.records)
    l.tally.count(before, l.world)
    game_after(mut l.game, before, l.world)
    if l.world.attempt != before.attempt || l.world.course != before.course {
        l.run = NO_RUN
        done = false
    }
    if let Some(p) = pad {
        if !done {
            l.run.record(p)
        }
    }
}

/// What the frames draw of `l`: its world's snapshot, with its run and its tally.
@deterministic
pub fn present_live(l: Live) -> Snap {
    var s = present(l.world)
    s.run = l.run
    s.tally = l.tally
    s.game = l.game.done
    s
}

impl Asks for Live {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

impl Asks for World {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

/// What the frames draw of a world: plain data, through the hand-off.
pub struct Snap: Copy + Plain {
    pub course: u32,
    pub at: vec2,
    pub vel: vec2,
    pub ground: vec2,
    pub speed: f32,
    pub facing: f32,
    /// The body's mode (`Mode`'s discriminant), and 1 tucked.
    pub mode: u32,
    pub tuck: u32,
    /// Ticks since a flip began, while in the air after it (`Body::flip`).
    pub flip: u32,
    /// Ticks of being wet left (`Body::wet`).
    pub wet: u32,
    /// Each foe: its middle, its kind's discriminant + 1 (negated once knocked out; 0 for an
    /// empty slot), and its way (or, knocked out, the ticks since).
    pub foes: [vec4; MAX_FOES],
    pub snacks: u32,
    pub yuzus: u32,
    pub yuzu: u32,
    pub grace: u32,
    pub checkpoint: u32,
    pub ticks: u32,
    pub finished: u32,
    pub attempt: u32,
    pub deaths: u32,
    /// Ticks left while dying (0 otherwise), and 1 if it fell out.
    pub dying: u32,
    pub fell: u32,
    /// 1 while paused; the page shown and the item with the focus (`World`'s); the options' steps;
    /// and the choices made in the menus.
    pub paused: u32,
    pub page: u32 = TITLE,
    pub focus: u32 = 0,
    pub turns: [i32; 3] = [0; 3],
    pub chosen: u32 = 0,
    /// Jumps left in the air (`Body::jumps`): a double jump while it's more than 0.
    pub jumps: u32 = 0,
    /// The attempt's run so far (`present_live`), or none.
    pub run: Run = NO_RUN,
    /// What happened, counted (`present_live`, or a watched run's), or nothing.
    pub tally: Tally = NO_TALLY,
    /// The whole-game run's time, once the last goal is reached in one (`Game::done`), or 0.
    pub game: u32 = 0,
}

@deterministic
pub fn present(w: World) -> Snap {
    let b = w.body
    var foes = [vec4(0.0); MAX_FOES]
    borrow c = course(w.course)
    for i in 0..c.foes.len() {
        let f = w.foes[i]
        let kind = f32(u32(f.kind) + 1)
        foes[i] = if f.alive {
            vec4(f.at, kind, f.dir)
        } else {
            vec4(f.at, -kind, f32(f.since))
        }
    }
    Snap {
        course: w.course,
        at: b.at,
        vel: b.vel,
        ground: b.ground,
        speed: b.speed,
        facing: b.facing,
        mode: u32(b.mode),
        tuck: if b.tuck { 1 } else { 0 },
        flip: b.flip,
        wet: b.wet,
        foes,
        snacks: w.snacks,
        yuzus: w.yuzus,
        yuzu: if w.yuzu { 1 } else { 0 },
        grace: w.grace,
        checkpoint: w.checkpoint,
        ticks: w.ticks,
        finished: w.finished,
        attempt: w.attempt,
        deaths: w.deaths,
        dying: w.dying,
        fell: if w.fell { 1 } else { 0 },
        paused: if w.paused { 1 } else { 0 },
        page: w.page,
        focus: w.focus,
        turns: w.turns,
        chosen: w.chosen,
        jumps: b.jumps,
    }
}

/// The world after playing `run` from a new attempt at course `c`.
pub fn play(c: u32, run: [Hold]) -> World {
    var w = world(c)
    for h in run {
        for i in 0..h.ticks {
            step(mut w, pad_of(h, i))
        }
    }
    w
}

// ---- the pause ---------------------------------------------------------------------------------

/// One tick of `w` with these events, as the ticker runs it.
fn tick_with(w: mut World, records: [Event]) {
    var events: Vec<Event> = Vec::new()
    for e in records {
        events.push(e)
    }
    tick(mut w, TickInput { tick: w.ticks, dt: STEP, records: events, answers: Vec::new() })
}

fn down(key: Key) -> Event {
    Event::KeyDown { key, repeat: false, mods: Mods {} }
}

fn up(key: Key) -> Event {
    Event::KeyUp { key, mods: Mods {} }
}

fn press(b: PadButton) -> Event {
    Event::PadButton { pad: 0, button: b, value: 1.0, pressed: true }
}

fn assist(n: u32, action: Assist) -> Event {
    Event::Assist { node: n, action }
}

/// One tick of `l` with these events, as the ticker runs it.
fn live_tick(l: mut Live, records: [Event]) {
    var events: Vec<Event> = Vec::new()
    for e in records {
        events.push(e)
    }
    tick_live(mut l, TickInput { tick: 0, dt: STEP, records: events, answers: Vec::new() })
}

/// `w` playing, from its title.
fn started(c: u32) -> World {
    var w = world(c)
    tick_with(mut w, [down(Key::Enter)])
    tick_with(mut w, [up(Key::Enter)])
    w
}

@test
fn the_game_opens_paused_on_its_title_and_stands_still_its_clock_too() {
    var w = world(WETLANDS)
    let at = w.body.at
    for _ in 0..30 {
        tick_with(mut w, [down(Key::D)])
    }
    assert(w.paused && w.page == TITLE && w.ticks == 0 && w.body.at == at, "nothing moves")
}

@test
fn the_title_plays_from_the_next_tick_and_esc_pauses_on_the_menu() {
    var w = world(WETLANDS)
    tick_with(mut w, [down(Key::Enter), down(Key::D)])
    assert(!w.paused && w.ticks == 0, "the tick that leaves the title doesn't step")
    tick_with(mut w, [up(Key::Enter)])
    assert(w.ticks == 1, "then the world steps")
    for _ in 0..20 {
        tick_with(mut w, [])
    }
    let (ticks, at) = (w.ticks, w.body.at)
    tick_with(mut w, [down(Key::P)])
    for _ in 0..20 {
        tick_with(mut w, [])
    }
    assert(w.paused && w.page == MENU && w.focus == RESUME, "paused, on the menu")
    assert(w.ticks == ticks && w.body.at == at, "the clock stopped")
}

@test
fn the_press_that_plays_isnt_also_a_jump() {
    for key in [Key::Space, Key::Z] {
        var w = world(WETLANDS)
        tick_with(mut w, [down(key)])
        assert(!w.paused, "a jump's key plays")
        for _ in 0..30 {
            tick_with(mut w, [])
        }
        assert(w.body.grounded(), "and the capybara didn't jump")
    }
    var w = world(WETLANDS)
    tick_with(mut w, [press(PadButton::South)])
    assert(!w.paused, "and so does a controller's A")
}

@test
fn esc_on_the_title_opens_the_menu_before_playing() {
    var w = world(WETLANDS)
    tick_with(mut w, [down(Key::Escape)])
    assert(w.paused && w.page == MENU && w.ticks == 0)
    tick_with(mut w, [down(Key::Escape)])
    assert(!w.paused, "Esc again plays")
}

@test
fn a_restart_plays_at_once() {
    var w = world(WETLANDS)
    tick_with(mut w, [down(Key::R)])
    tick_with(mut w, [up(Key::R)])
    assert(!w.paused && w.ticks == 1 && w.attempt == 1)
}

@test
fn the_menu_moves_its_focus_and_chooses_a_restart() {
    var w = started(WETLANDS)
    for _ in 0..60 {
        tick_with(mut w, [down(Key::D)])
    }
    tick_with(mut w, [down(Key::Escape)])
    tick_with(mut w, [down(Key::Down)])
    assert(w.focus == RESTART, "down a row")
    tick_with(mut w, [down(Key::Up)])
    tick_with(mut w, [down(Key::Up)])
    assert(w.focus == SEE_CONTROLS, "and round from the top")
    tick_with(mut w, [down(Key::Down)])
    tick_with(mut w, [down(Key::Down)])
    tick_with(mut w, [down(Key::Space)])
    assert(!w.paused && w.attempt == 1 && w.ticks == 0, "restarted, playing")
    assert(w.chosen == 1, "a choice")
}

@test
fn a_controller_and_its_stick_work_the_menu() {
    var w = started(WETLANDS)
    tick_with(mut w, [press(PadButton::Start)])
    assert(w.paused && w.page == MENU)
    let stick = |v: f32| Event::PadAxis { pad: 0, axis: std::input::PadAxis::LeftY, value: v }
    tick_with(mut w, [stick(0.9)])
    tick_with(mut w, [stick(1.0)])
    assert(w.focus == RESTART, "a push moves once")
    tick_with(mut w, [stick(0.0), press(PadButton::Down)])
    tick_with(mut w, [press(PadButton::Down)])
    tick_with(mut w, [press(PadButton::Down)])
    assert(w.focus == SEE_OPTIONS)
    tick_with(mut w, [press(PadButton::South)])
    assert(w.page == OPTIONS && w.focus == MUSIC)
    tick_with(mut w, [press(PadButton::East)])
    assert(w.page == MENU && w.focus == SEE_OPTIONS, "B backs out, to the item it came from")
    tick_with(mut w, [press(PadButton::East)])
    assert(!w.paused, "and from the menu, plays")
}

@test
fn the_options_count_their_steps_for_the_frames() {
    var w = started(WETLANDS)
    tick_with(mut w, [down(Key::Escape)])
    choose(mut w, SEE_OPTIONS)
    tick_with(mut w, [down(Key::Enter)])
    tick_with(mut w, [down(Key::Down)])
    tick_with(mut w, [down(Key::Right)])
    tick_with(mut w, [down(Key::Down)])
    tick_with(mut w, [down(Key::Left)])
    tick_with(mut w, [down(Key::Left)])
    assert(w.turns == [1, 1, -2], f"{w.turns[0]} {w.turns[1]} {w.turns[2]}")
    tick_with(mut w, [down(Key::Down), down(Key::Enter)])
    assert(w.page == MENU && w.focus == SEE_OPTIONS, "back from the options")
    tick_with(mut w, [down(Key::R)])
    assert(w.turns == [1, 1, -2], "a restart keeps them")
}

@test
fn a_press_on_a_node_chooses_it_and_an_old_page_s_node_does_nothing() {
    var w = started(WETLANDS)
    tick_with(mut w, [down(Key::Escape)])
    let options = node(w.chosen, MENU, SEE_OPTIONS)
    tick_with(mut w, [assist(node(w.chosen, OPTIONS, MUSIC), Assist::Activate)])
    assert(w.page == MENU && w.turns[0] == 0, "not the page shown")
    tick_with(mut w, [assist(options, Assist::Activate)])
    assert(w.page == OPTIONS, "pressed")
    tick_with(mut w, [assist(node(w.chosen, OPTIONS, CLOCK), Assist::Focus)])
    assert(w.focus == CLOCK, "a node focused")
    tick_with(mut w, [assist(node(w.chosen, OPTIONS, PAGE_NODE), Assist::Dismiss)])
    assert(w.page == MENU, "the page dismissed")
    assert(item_of(node(chosen: 3000, page: CONTROLS, item: PAGE_NODE)) == (CONTROLS, PAGE_NODE))
}

@test
fn on_the_runs_only_backing_out_is_the_sims() {
    var w = started(WETLANDS)
    tick_with(mut w, [down(Key::Escape)])
    choose(mut w, SEE_RUNS)
    for key in [Key::Space, Key::Enter, Key::R, Key::Tab, Key::Up, Key::Down] {
        tick_with(mut w, [down(key)])
        tick_with(mut w, [up(key)])
    }
    assert(
        w.paused && w.page == RUNS && w.attempt == 0 && w.course == WETLANDS,
        "the keys are the frames'",
    )
    tick_with(mut w, [down(Key::Backspace)])
    assert(w.paused && w.page == MENU && w.focus == SEE_RUNS, "Backspace backs out")
    choose(mut w, SEE_RUNS)
    tick_with(mut w, [down(Key::Escape)])
    assert(w.page == MENU, "and Esc")
}

@test
fn the_ticker_counts_a_comeback_and_a_restart_as_cuts() {
    var l = live(WETLANDS)
    l.world.paused = false
    // The last tick of dying: it comes back.
    l.world.dying = 1
    tick_live(mut l, TickInput { tick: 0, dt: STEP, records: Vec::new(), answers: Vec::new() })
    assert(l.world.dying == 0 && l.tally.cuts == 1, "coming back is a cut")
    let r = Vec::from([down(Key::R)])
    tick_live(mut l, TickInput { tick: 1, dt: STEP, records: r, answers: Vec::new() })
    assert(l.world.attempt == 1 && l.tally.cuts == 2, "and so is a restart")
    assert(present_live(l).tally == l.tally, "the frames see it")
}

@test
fn the_levels_map_moves_along_the_levels_and_plays_the_one_chosen() {
    var w = started(HOME)
    tick_with(mut w, [down(Key::Escape)])
    choose(mut w, SEE_MAP)
    assert(w.page == MAP && w.focus == HOME, "the map opens on the level being played")
    tick_with(mut w, [down(Key::Left)])
    assert(w.focus == LEVELS - 1, "left from the first goes round to the last")
    tick_with(mut w, [down(Key::Right)])
    tick_with(mut w, [down(Key::Right)])
    assert(w.focus == WETLANDS, "right steps along the loop")
    tick_with(mut w, [down(Key::Escape)])
    assert(w.page == MENU && w.focus == SEE_MAP, "Esc backs out to the menu")
    choose(mut w, SEE_MAP)
    tick_with(mut w, [down(Key::Right)])
    let attempt = w.attempt
    tick_with(mut w, [down(Key::Enter)])
    assert(w.course == WETLANDS && !w.paused && w.attempt == attempt + 1, "a new attempt there")
    assert(w.ticks == 0, "the press that chose it didn't step")
    // A press on a level's node plays it, by its number.
    tick_with(mut w, [down(Key::Escape)])
    choose(mut w, SEE_MAP)
    tick_with(mut w, [assist(node(w.chosen, MAP, HOME), Assist::Activate)])
    assert(w.course == HOME && !w.paused)
}

@test
fn at_the_goals_card_a_choice_plays_the_next_level_and_not_before() {
    var w = started(HOME)
    w.finished = w.ticks
    let attempt = w.attempt
    // Before the card shows, Enter does nothing.
    tick_with(mut w, [down(Key::Enter)])
    tick_with(mut w, [up(Key::Enter)])
    assert(w.course == HOME && w.attempt == attempt, "too soon")
    while w.after < CARD {
        tick_with(mut w, [])
    }
    tick_with(mut w, [down(Key::Space)])
    assert(w.course == WETLANDS && w.attempt == attempt + 1 && !w.paused, "the next level")
    for _ in 0..30 {
        tick_with(mut w, [])
    }
    assert(w.body.grounded(), "and the press that chose it wasn't a jump")
    assert(next(LEVELS - 1).is_none() && next(LAB).is_none(), "nothing after the last, or the lab")
}

@test
fn a_whole_game_counts_each_levels_clock_on_through_the_next_level_and_ends_at_another() {
    var l = live(HOME)
    live_tick(mut l, [down(Key::Enter)])
    live_tick(mut l, [up(Key::Enter)])
    for _ in 0..50 {
        live_tick(mut l, [])
    }
    assert(l.game.on && l.game.ticks == l.world.ticks, f"{l.game.ticks} of {l.world.ticks}")
    // At the goal (as if reached), its clock stops and so does the game's; on to the next level.
    l.world.finished = l.world.ticks
    while l.world.after < CARD {
        live_tick(mut l, [])
    }
    let at_goal = l.game.ticks
    assert(at_goal == l.world.ticks, "the goal's wait isn't counted")
    live_tick(mut l, [down(Key::Enter)])
    assert(l.world.course == WETLANDS && l.game.on, "on to the next level, the run on")
    for _ in 0..30 {
        live_tick(mut l, [])
    }
    assert(l.game.ticks == at_goal + l.world.ticks, "the next level's clock adds on")
    // A restart is part of the run; the map to another level ends it.
    live_tick(mut l, [down(Key::R)])
    assert(l.game.on && l.world.attempt == 2, "a restart keeps it on")
    live_tick(mut l, [up(Key::R)])
    live_tick(mut l, [down(Key::Escape)])
    choose(mut l.world, SEE_MAP)
    live_tick(mut l, [down(Key::Right)])
    live_tick(mut l, [down(Key::Enter)])
    assert(l.world.course == course::SAVANNA && !l.game.on, "chosen on the map: no run")
    assert(l.game.done == 0, "and never done")
}
