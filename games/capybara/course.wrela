// A course: its ground's pieces, its water, where the capybara starts and where the goal is, its
// foes, snacks, yuzus and checkpoints, and the contacts a circle makes with its ground. Two
// courses: the movement lab (course 0, the movement's test bed) and the first level (course 1).

use foes::{Kind, MAX_FOES, Spawn}
use ground::{Corner, Piece, build_chain, corner}

/// A body of water: a rectangle whose top is its flat surface, set inside solid ground that makes
/// its sides and bottom.
pub struct Water: Copy {
    pub lo: vec2,
    pub hi: vec2,
}

impl Water {
    pub fn surface(self) -> f32 {
        self.hi.y
    }

    pub fn holds(self, p: vec2) -> bool {
        p.x >= self.lo.x && p.x <= self.hi.x && p.y >= self.lo.y && p.y < self.hi.y
    }
}

pub struct Course: Clone {
    pub pieces: Vec<Piece>,
    /// Each chain's first piece, then one past the last chain's last: chain `i` is the pieces
    /// from `chains[i]` up to `chains[i + 1]`.
    pub chains: Vec<u32>,
    pub waters: Vec<Water>,
    /// Where the capybara's middle starts.
    pub start: vec2,
    /// The goal: the capybara reaches it when its middle is inside this box.
    pub goal_lo: vec2,
    pub goal_hi: vec2,
    /// Below this height the capybara has fallen out of the course (m).
    pub floor: f32,
    /// Its ends' faces, left and right (m): the view stops there (camera.wrela's `framed`), so
    /// what's past them is never seen.
    pub ends: vec2 = vec2(-1.0e4, 1.0e4),
    /// The foes, where they start; the snacks and the yuzus, where they sit; and the
    /// checkpoints, each a flag's foot on the ground, in the order they're reached.
    pub foes: Vec<Spawn>,
    pub snacks: Vec<vec2>,
    pub yuzus: Vec<vec2>,
    pub checkpoints: Vec<vec2>,
}

/// A circle's contact with the ground: the piece, its nearest point, the unit normal from that
/// point to the circle's middle, the distance, how far along the piece the point is, and whether
/// the point is a corner (past the piece's end), which is never ground.
pub struct Contact: Copy {
    pub piece: u32,
    pub point: vec2,
    pub normal: vec2,
    pub dist: f32,
    pub u: f32,
    pub corner: bool,
}

/// The steepest ground the capybara stands on: a contact's normal at most 50° from straight up
/// (the cosine of 50°).
pub const WALKABLE: f32 = 0.6427876

/// How far past an end a nearest point must be to count as a corner (m).
const CORNER_SLACK: f32 = 1.0e-5

impl Contact {
    /// Whether the capybara can stand on it.
    pub fn ground(self) -> bool {
        !self.corner && self.normal.y >= WALKABLE
    }

    /// The ground's tangent at the contact, left to right on a walkable top.
    pub fn tangent(self) -> vec2 {
        vec2(self.normal.y, -self.normal.x)
    }
}

impl Course {
    pub fn new(start: vec2, goal_lo: vec2, goal_hi: vec2, floor: f32) -> Course {
        Course {
            pieces: Vec::new(),
            chains: Vec::from([0]),
            waters: Vec::new(),
            start,
            goal_lo,
            goal_hi,
            floor,
            foes: Vec::new(),
            snacks: Vec::new(),
            yuzus: Vec::new(),
            checkpoints: Vec::new(),
            ends: vec2(-1.0e4, 1.0e4),
        }
    }

    /// Every snack's bit (`World::snacks`): what a 100% run finds.
    pub fn every_snack(self) -> u32 {
        (1 << self.snacks.len()) - 1
    }

    /// The course with its ends' faces at `ends` (left and right, m).
    pub fn ended(take self, ends: vec2) -> Course {
        var c = take self
        c.ends = ends
        c
    }

    /// Adds a foe of kind `kind` at `at`, patrolling `range` either side.
    pub fn foe(take self, kind: Kind, at: vec2, range: f32) -> Course {
        var c = take self
        c.foes.push(Spawn { kind, at, range })
        assert(c.foes.len() <= MAX_FOES, "too many foes")
        c
    }

    /// Adds a snack at `at`.
    pub fn snack(take self, at: vec2) -> Course {
        var c = take self
        c.snacks.push(at)
        assert(c.snacks.len() <= 32, "too many snacks")
        c
    }

    /// Adds a yuzu at `at`.
    pub fn yuzu(take self, at: vec2) -> Course {
        var c = take self
        c.yuzus.push(at)
        assert(c.yuzus.len() <= 32, "too many yuzus")
        c
    }

    /// Adds a checkpoint: its flag's foot at `at`.
    pub fn checkpoint(take self, at: vec2) -> Course {
        var c = take self
        c.checkpoints.push(at)
        c
    }

    /// The top of the ground under the vertical through `x`, at or below `below` (and a little
    /// above it): the highest point there of any piece, exactly. None if there's none.
    pub fn ground_at(self, x: f32, below: f32) -> Option<f32> {
        var best: Option<f32> = None
        let limit = below + 0.25
        for p in self.pieces {
            if x < p.lo.x || x > p.hi.x {
                continue
            }
            var ys: [f32; 2] = [-1.0e9, -1.0e9]
            if p.is_arc() {
                let dx = x - p.centre.x
                if abs(dx) <= p.radius {
                    let dy = sqrt(p.radius * p.radius - dx * dx)
                    ys = [p.centre.y + dy, p.centre.y - dy]
                }
            } else if p.b.x != p.a.x {
                ys[0] = p.a.y + (p.b.y - p.a.y) * (x - p.a.x) / (p.b.x - p.a.x)
            }
            for y in ys {
                if y < -1.0e8 || y > limit {
                    continue
                }
                // On the piece itself, not its circle's other side, and facing up.
                let q = vec2(x, y)
                let near = p.nearest(q)
                if distance(p.point(near.u), q) > 1.0e-3 || p.normal(near.u).y <= 0.0 {
                    continue
                }
                best = match best {
                    Some(b) => Some(max(b, y)),
                    None => Some(y),
                }
            }
        }
        best
    }

    fn chain(take self, corners: [Corner], closed: bool) -> Course {
        var c = take self
        let index = c.chains.len() - 1
        build_chain(mut c.pieces, corners, closed, chain: index)
        c.chains.push(c.pieces.len())
        c
    }

    /// Adds solid ground: a closed chain, clockwise.
    pub fn solid(take self, corners: [Corner]) -> Course {
        take self.chain(corners, closed: true)
    }

    /// Adds a one-way ledge: an open chain, left to right.
    pub fn ledge(take self, corners: [Corner]) -> Course {
        take self.chain(corners, closed: false)
    }

    /// Adds water from `lo` to `hi`.
    pub fn water(take self, lo: vec2, hi: vec2) -> Course {
        var c = take self
        c.waters.push(Water { lo, hi })
        c
    }

    /// The nearest contact of a circle of radius `body` whose middle is at `at`, within `reach` of
    /// the middle: of every piece (`ground` false), or of the ground it can stand on alone. A
    /// one-way ledge counts only if the middle was above it by the radius (less a little) at
    /// `from`, the tick's start. Of pieces at the same distance, the first in the course's order.
    pub fn contact(
        self,
        at: vec2,
        reach: f32,
        from: vec2,
        body: f32,
        ground: bool,
    ) -> Option<Contact> {
        var best: Option<Contact> = None
        var nearest = reach
        for i in 0..self.pieces.len() {
            let p = self.pieces[i]
            if at.x < p.lo.x - reach ||
                at.x > p.hi.x + reach ||
                at.y < p.lo.y - reach ||
                at.y > p.hi.y + reach {
                continue
            }
            let near = p.nearest(at)
            let q = p.point(near.u)
            let d = distance(at, q)
            if d >= nearest {
                continue
            }
            let corner = near.free < -CORNER_SLACK || near.free > p.length + CORNER_SLACK
            let normal = if d > 1.0e-6 { (at - q) / d } else { p.normal(near.u) }
            let k = Contact { piece: i, point: q, normal, dist: d, u: near.u, corner }
            if ground && !k.ground() {
                continue
            }
            if p.ledge {
                let was = p.nearest(from)
                let above = dot(from - p.point(was.u), p.normal(was.u))
                if above < body - 0.02 {
                    continue
                }
            }
            nearest = d
            best = Some(k)
        }
        best
    }

    /// The water that holds `p`, if any.
    pub fn water_at(self, p: vec2) -> Option<u32> {
        for i in 0..self.waters.len() {
            if self.waters[i].holds(p) {
                return Some(i)
            }
        }
        None
    }

    /// Whether a circle of radius `r` at `p` touches any water: a puddle wets the capybara's feet.
    pub fn touches_water(self, p: vec2, r: f32) -> bool {
        for w in self.waters {
            if p.x >= w.lo.x && p.x <= w.hi.x && p.y - r < w.hi.y && p.y + r > w.lo.y {
                return true
            }
        }
        false
    }

    pub fn at_goal(self, p: vec2) -> bool {
        p.x >= self.goal_lo.x &&
            p.x <= self.goal_hi.x &&
            p.y >= self.goal_lo.y &&
            p.y <= self.goal_hi.y
    }
}

// ---- the lab -----------------------------------------------------------------------------------

/// The courses, by number.
pub const COURSES: u32 = 2

/// Course `i`: 0 the lab, 1 the first level.
pub fn course(i: u32) -> borrow Course {
    assert(i < COURSES, "a course that doesn't exist")
    if i == 0 { LAB } else { LEVEL }
}

/// The movement lab: from the left, a runway with two one-way ledges above it (2 m and 3.5 m
/// up), a broad crest, a puddle in a shallow dip, gaps of 3 m and 4 m, steps 1.5 m up and 1.5 m
/// more, a deck that drops down a 29° slope into a valley with a puddle at its bottom and up a 45°
/// slope to a sharp lip 1 m up, a lake 37 m across and 6.5 m deep down a rounded bank, whose steep
/// far wall stands 1.6 m above the water, and the goal on the deck past it. Pits fall out below 8 m down. Water is the fast element: a puddle wets the
/// capybara for its speed, and the lake is a fast swim.
pub const LAB: Course = lab()

fn lab() -> Course {
    Course::new(
        start: vec2(1.0, 0.35),
        goal_lo: vec2(136.0, 1.6),
        goal_hi: vec2(138.0, 6.0),
        floor: -8.0,
    )
        .solid(
            [
                corner(vec2(-6.0, -20.0)),
                corner(vec2(-6.0, 10.0)),
                corner(vec2(-4.0, 10.0)),
                corner(vec2(-4.0, 0.0), 0.5),
                // The broad crest.
                corner(vec2(18.0, 0.0), 3.0),
                corner(vec2(23.0, 3.0), 4.0),
                corner(vec2(28.0, 0.0), 3.0),
                // The puddle: a shallow rounded dip.
                corner(vec2(29.5, 0.0), 1.5),
                corner(vec2(31.0, -0.3), 1.5),
                corner(vec2(33.0, -0.3), 1.5),
                corner(vec2(34.5, 0.0), 1.5),
                // The gaps.
                corner(vec2(36.0, 0.0)),
                corner(vec2(36.0, -12.0)),
                corner(vec2(39.0, -12.0)),
                corner(vec2(39.0, 0.0)),
                corner(vec2(45.0, 0.0)),
                corner(vec2(45.0, -12.0)),
                corner(vec2(49.0, -12.0)),
                corner(vec2(49.0, 0.0)),
                // The steps.
                corner(vec2(56.0, 0.0)),
                corner(vec2(56.0, 1.5)),
                corner(vec2(62.0, 1.5)),
                corner(vec2(62.0, 3.0)),
                // The slide: down into the valley and up to the lip.
                corner(vec2(70.0, 3.0), 2.0),
                corner(vec2(79.0, -2.0), 5.0),
                corner(vec2(85.0, -2.0), 5.0),
                corner(vec2(88.0, 1.0)),
                // The lake: a rounded bank down, a long floor, and a steep rounded far wall.
                corner(vec2(95.0, 1.0), 2.0),
                corner(vec2(102.0, -6.5), 6.0),
                corner(vec2(128.0, -6.5), 5.0),
                corner(vec2(131.5, 1.6), 1.5),
                // The goal's deck and the wall at the end.
                corner(vec2(140.0, 1.6)),
                corner(vec2(140.0, 12.0)),
                corner(vec2(142.0, 12.0)),
                corner(vec2(142.0, -20.0)),
            ],
        )
        .ended(vec2(-4.0, 140.0))
        .ledge([corner(vec2(6.0, 2.0)), corner(vec2(9.0, 2.0))])
        .ledge([corner(vec2(11.0, 3.5)), corner(vec2(14.0, 3.5))])
        .water(vec2(94.0, -6.5), vec2(133.0, 0.0))
        .water(vec2(29.5, -0.3), vec2(34.5, -0.05))
        .water(vec2(78.5, -2.0), vec2(84.5, -1.8))
}

// ---- the first level -----------------------------------------------------------------------------

/// The first level (a working name: the zoo's entrance), built round the movement: speed is the
/// fun (design.md), so its hazards ask for speed and its shortcuts reward it. Four sections, a
/// checkpoint after each of the first three:
///
/// 1. The gates (0 to 75 m): a goose on the runway to stomp or jump; a ledge 3.2 m up that only
///    a double jump reaches, a snack on it; a 3 m pit; a puddle in a dip; a hill, a goose past
///    it; a 4.5 m pit, a snack hanging inside it for the bold.
/// 2. The big slide (80 to 160 m): steps under a pigeon; a deck with a yuzu; a 30° ramp down into
///    a valley with a puddle and up to a lip over a 12 m pit. A slide-jump off the lip clears it,
///    past a snack high over its middle; two one-way ledges in the pit are the slow way. Two geese
///    on the landing, to bowl over sliding.
/// 3. The lake (160 to 225 m): down a bank into water 41 m across and 8.5 m deep, a caiman at
///    mid-depth and one by the floor guarding a snack; its far wall stands 3 m above the water,
///    so out is a breach and a double jump; a low pigeon on the deck past it.
/// 4. The gauntlet (225 to 330 m): mesas over pits, a goose on the first, a puddle on the second
///    for the speed to clear an 8 m gap, two geese on the third, a pigeon over the climb to a
///    tall fourth with a snack high above it, then a last hill to the goal.
pub const LEVEL: Course = level()

fn level() -> Course {
    Course::new(
        start: vec2(2.0, 0.35),
        goal_lo: vec2(322.0, 1.0),
        goal_hi: vec2(324.0, 6.0),
        floor: -12.0,
    )
        .solid(
            [
                corner(vec2(-6.0, -20.0)),
                corner(vec2(-6.0, 10.0)),
                corner(vec2(-4.0, 10.0)),
                corner(vec2(-4.0, 0.0), 0.5),
                // 1. The gates: the runway, the first pit.
                corner(vec2(28.0, 0.0)),
                corner(vec2(28.0, -16.0)),
                corner(vec2(31.0, -16.0)),
                corner(vec2(31.0, 0.0)),
                // The puddle's dip.
                corner(vec2(34.0, 0.0), 1.5),
                corner(vec2(35.5, -0.3), 1.5),
                corner(vec2(38.5, -0.3), 1.5),
                corner(vec2(40.0, 0.0), 1.5),
                // The hill.
                corner(vec2(44.0, 0.0), 4.0),
                corner(vec2(51.0, 3.0), 5.0),
                corner(vec2(58.0, 0.0), 4.0),
                // The second pit.
                corner(vec2(66.0, 0.0)),
                corner(vec2(66.0, -16.0)),
                corner(vec2(70.5, -16.0)),
                corner(vec2(70.5, 0.0)),
                // 2. The steps and the deck.
                corner(vec2(80.0, 0.0)),
                corner(vec2(80.0, 1.5)),
                corner(vec2(84.0, 1.5)),
                corner(vec2(84.0, 3.0)),
                // The big slide: down into the valley, up to the lip.
                corner(vec2(96.0, 3.0), 2.0),
                corner(vec2(110.0, -5.0), 7.0),
                corner(vec2(120.0, -5.0), 6.0),
                corner(vec2(128.0, -3.0)),
                // The big pit, and the landing.
                corner(vec2(128.0, -16.0)),
                corner(vec2(140.0, -16.0)),
                corner(vec2(140.0, -4.0)),
                corner(vec2(160.0, -4.0), 2.0),
                // 3. Up to the lake's bank, down into it, across, and up its far wall.
                corner(vec2(164.0, -1.0), 2.0),
                corner(vec2(172.0, -10.0), 7.0),
                corner(vec2(205.0, -10.0), 6.0),
                corner(vec2(209.0, 1.5), 1.5),
                // 4. The gauntlet: the deck's end, then mesas over pits.
                corner(vec2(226.0, 1.5)),
                corner(vec2(226.0, -16.0)),
                corner(vec2(230.0, -16.0)),
                corner(vec2(230.0, 2.5)),
                corner(vec2(236.0, 2.5)),
                corner(vec2(236.0, -16.0)),
                corner(vec2(241.0, -16.0)),
                corner(vec2(241.0, 1.0)),
                corner(vec2(242.0, 1.0), 1.0),
                corner(vec2(243.0, 0.7), 1.0),
                corner(vec2(247.0, 0.7), 1.0),
                corner(vec2(248.0, 1.0), 1.0),
                corner(vec2(250.0, 1.0)),
                corner(vec2(250.0, -16.0)),
                corner(vec2(258.0, -16.0)),
                corner(vec2(258.0, 0.0)),
                corner(vec2(270.0, 0.0)),
                corner(vec2(270.0, -16.0)),
                corner(vec2(275.0, -16.0)),
                corner(vec2(275.0, 4.0)),
                corner(vec2(283.0, 4.0), 3.0),
                corner(vec2(290.0, 1.0), 4.0),
                corner(vec2(300.0, 1.0), 4.0),
                corner(vec2(306.0, 4.0), 4.0),
                corner(vec2(312.0, 1.0), 4.0),
                // The goal's deck and the wall at the end.
                corner(vec2(328.0, 1.0)),
                corner(vec2(328.0, 14.0)),
                corner(vec2(330.0, 14.0)),
                corner(vec2(330.0, -20.0)),
            ],
        )
        .ended(vec2(-4.0, 328.0))
        .ledge([corner(vec2(10.0, 3.2)), corner(vec2(14.0, 3.2))])
        .ledge([corner(vec2(129.0, -5.0)), corner(vec2(131.0, -5.0))])
        .ledge([corner(vec2(133.5, -5.0)), corner(vec2(135.5, -5.0))])
        .water(vec2(34.0, -0.3), vec2(40.0, -0.05))
        .water(vec2(109.0, -5.0), vec2(121.0, -4.75))
        .water(vec2(164.0, -10.0), vec2(210.0, -1.5))
        .water(vec2(242.0, 0.7), vec2(248.0, 0.95))
        .foe(Kind::Goose, vec2(20.0, 0.45), 4.0)
        .foe(Kind::Goose, vec2(61.0, 0.45), 2.5)
        .foe(Kind::Pigeon, vec2(82.0, 5.0), 2.5)
        .foe(Kind::Goose, vec2(146.0, -3.55), 3.0)
        .foe(Kind::Goose, vec2(152.0, -3.55), 3.0)
        .foe(Kind::Caiman, vec2(180.0, -5.0), 6.0)
        .foe(Kind::Caiman, vec2(195.0, -8.0), 7.0)
        .foe(Kind::Pigeon, vec2(217.0, 3.0), 4.0)
        .foe(Kind::Goose, vec2(233.0, 2.95), 2.0)
        .foe(Kind::Goose, vec2(262.0, 0.45), 2.5)
        .foe(Kind::Goose, vec2(267.0, 0.45), 2.0)
        .foe(Kind::Pigeon, vec2(272.5, 5.5), 2.0)
        .snack(vec2(12.0, 3.9))
        .snack(vec2(67.6, -1.0))
        .snack(vec2(137.0, 3.0))
        .snack(vec2(200.0, -9.3))
        .snack(vec2(285.5, 9.0))
        .yuzu(vec2(90.0, 3.6))
        .yuzu(vec2(222.0, 2.2))
        .checkpoint(vec2(74.0, 0.0))
        .checkpoint(vec2(158.0, -4.0))
        .checkpoint(vec2(224.0, 1.5))
}

// ---- tests -------------------------------------------------------------------------------------

@test
fn the_labs_chains_close_and_join_and_its_start_stands_on_its_ground() {
    borrow c = course(0)
    assert(c.chains.len() == 4, "the ground and two ledges")
    for k in 0..c.chains.len() - 1 {
        let (first, last) = (c.chains[k], c.chains[k + 1])
        for i in first..last - 1 {
            let (a, b) = (c.pieces[i], c.pieces[i + 1])
            assert(distance(a.point(a.length), b.point(0.0)) < 1.0e-4, "pieces meet")
        }
    }
    let first = c.pieces[0]
    let last = c.pieces[c.chains[1] - 1]
    assert(distance(last.point(last.length), first.point(0.0)) < 1.0e-4, "the ground closes")
    let Some(k) = c.contact(c.start, 0.4, c.start, 0.35, ground: true) else {
        panic("the start has no ground")
    }
    assert(abs(k.dist - 0.35) < 1.0e-5 && k.normal == vec2(0.0, 1.0))
}

@test
fn a_corner_is_never_ground_and_a_ledge_holds_only_from_above() {
    borrow c = course(0)
    // Past the first gap's near edge (x 36), level with the top: only the corner is near.
    let past = vec2(36.2, 0.2)
    let Some(k) = c.contact(past, 0.35, past, 0.35, ground: false) else { panic("no contact") }
    assert(k.corner && !k.ground())
    assert(c.contact(past, 0.35, past, 0.35, ground: true).is_none())
    // Under the 2 m ledge, rising through it: no contact. Above it, coming down: it holds.
    let through = vec2(7.5, 1.9)
    assert(c.contact(through, 0.35, vec2(7.5, 1.5), 0.35, ground: false).is_none())
    let onto = vec2(7.5, 2.3)
    let Some(h) = c.contact(onto, 0.35, vec2(7.5, 2.5), 0.35, ground: true) else {
        panic("the ledge doesn't hold")
    }
    assert(abs(h.point.y - 2.0) < 1.0e-5)
}

@test
fn the_pool_holds_water_up_to_its_surface() {
    borrow c = course(0)
    assert(c.water_at(vec2(108.0, -1.0)) == Some(0))
    assert(c.water_at(vec2(108.0, 0.1)).is_none())
    assert(c.waters[0].surface() == 0.0)
    // A puddle 20 cm deep: the capybara standing in it touches it, but isn't in it.
    let standing = vec2(32.0, -0.3 + 0.35)
    assert(c.touches_water(standing, 0.35) && c.water_at(standing).is_none())
    assert(!c.touches_water(vec2(27.0, 0.35), 0.35))
}
