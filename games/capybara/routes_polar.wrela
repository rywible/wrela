/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level polar --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 1.0e9, 1.0e9, 1.0e9, 1.0e9]

@test
fn the_searched_runs_of_polar_finish_in_their_times_without_a_death() {
    let every = course(POLAR).every_snack()
    let any = play(POLAR, ANY)
    let full = play(POLAR, FULL)
    assert(any.finished == 2023 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 3142 && full.deaths == 0 && full.snacks == every)
    let human_any = play(POLAR, HUMAN_ANY)
    let human_full = play(POLAR, HUMAN_FULL)
    assert(human_any.finished == 2072 && human_any.deaths == 0)
    assert(human_full.finished == 3142 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
