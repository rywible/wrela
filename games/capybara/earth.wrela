// The ground as it's drawn: its cross-section's earth, the turf along every walkable top and the
// grass growing from it, a rocky rim along every cliff, and the ledges' planks.
//
// The earth is drawn per pixel from where the pixel is and how far below the top of the ground it
// is (a profile of the ground's top, sampled every `STEP` m, made when a course is shown): layers
// of soil that waver, pebbles lit as little domes, roots near the top, darker the deeper it is,
// and a shadow under the turf's lip.
//
// The grass is a band above each walkable top, cut per pixel into blades: each blade's place,
// height and lean from a hash of its number, swaying in a wind that gusts along the ground, bent
// away from the capybara and the geese as they pass, and pressed flat where the capybara slides.

use art::{SUN, SUN_COLOUR}
use course::{Course, WALKABLE}
use engine::noise::{hash2, noise2}
use ground::{left, outline, triangulate}
use std::gpu::{ClipPosition, Flat, Over, VertexIndex, discard}

/// Display colours (sRGB, as a colour picker gives them) in linear light, near enough.
pub fn lin(c: vec3) -> vec3 {
    c * c
}

fn blend(a: vec3, b: vec3, t: f32) -> vec3 {
    a + (b - a) * t
}

/// The materials of the ground's faces.
const SOIL: f32 = 0.0
const TURF: f32 = 1.0
const RIM: f32 = 2.0
const PLANK: f32 = 3.0

/// How deep the turf is under a walkable top, and the rim inside a cliff (m).
const TURF_DEPTH: f32 = 0.3
const RIM_DEPTH: f32 = 0.18

/// How thick a ledge's planks are (m).
const PLANK_THICK: f32 = 0.25

/// How tall the grass band above a walkable top is, and how far it reaches down into the turf (m).
const GRASS_TALL: f32 = 0.55
const GRASS_ROOT: f32 = 0.06

/// A vertex of the ground: its point, its material and how far across its band it is (0 at the
/// band's outer edge, 1 at its inner), then its side's outward normal (two vec4s).
fn vertex(out: mut Vec<vec4>, p: vec2, material: f32, band: f32, side: vec2) {
    out.push(vec4(p, material, band))
    out.push(vec4(side, 0.0, 0.0))
}

/// The ground's faces: each solid's cross-section filled with soil, a band of turf inside each
/// walkable side and of rim inside each cliff; each ledge's planks. Three vertices a triangle.
pub fn earth_mesh(c: Course) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for k in 0..c.chains.len() - 1 {
        let (first, last) = (c.chains[k], c.chains[k + 1])
        var points = outline(c.pieces, first, last)
        if c.pieces[first].ledge {
            let end = c.pieces[last - 1]
            points.push(end.point(end.length))
            for i in 0..points.len() - 1 {
                let (a, b) = (points[i], points[i + 1])
                let down = vec2(0.0, -PLANK_THICK)
                let side = normalize(left(b - a))
                for (p, band) in [
                    (a, 0.0),
                    (b, 0.0),
                    (b + down, 1.0),
                    (a, 0.0),
                    (b + down, 1.0),
                    (a + down, 1.0),
                ] {
                    vertex(mut out, p, material: PLANK, band: band, side: side)
                }
            }
            continue
        }
        for p in triangulate(points) {
            vertex(mut out, p, material: SOIL, band: 1.0, side: vec2(0.0, 1.0))
        }
        let n = points.len()
        for i in 0..n {
            let (a, b) = (points[i], points[(i + 1) % n])
            let side = normalize(left(b - a))
            let walkable = side.y >= WALKABLE
            let (material, depth) = if walkable { (TURF, TURF_DEPTH) } else { (RIM, RIM_DEPTH) }
            let inward = side * depth
            for (p, band) in [
                (a, 0.0),
                (b, 0.0),
                (b - inward, 1.0),
                (a, 0.0),
                (b - inward, 1.0),
                (a - inward, 1.0),
            ] {
                vertex(mut out, p, material: material, band: band, side: side)
            }
        }
    }
    out
}

/// The grass: a band above each walkable side of each solid, from a little below the side to
/// `GRASS_TALL` above it, each vertex its point and its height above the side (m), then the side's
/// outward normal. Three vertices a triangle.
pub fn grass_mesh(c: Course) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for k in 0..c.chains.len() - 1 {
        let (first, last) = (c.chains[k], c.chains[k + 1])
        if c.pieces[first].ledge {
            continue
        }
        let points = outline(c.pieces, first, last)
        let n = points.len()
        for i in 0..n {
            let (a, b) = (points[i], points[(i + 1) % n])
            let side = normalize(left(b - a))
            if side.y < WALKABLE {
                continue
            }
            let (up, down) = (side * GRASS_TALL, side * GRASS_ROOT)
            for (p, h) in [
                (a - down, -GRASS_ROOT),
                (b - down, -GRASS_ROOT),
                (b + up, GRASS_TALL),
                (a - down, -GRASS_ROOT),
                (b + up, GRASS_TALL),
                (a + up, GRASS_TALL),
            ] {
                out.push(vec4(p, h, 0.0))
                out.push(vec4(side, 0.0, 0.0))
            }
        }
    }
    out
}

pub const LAB_EARTH: Vec<vec4> = earth_mesh(course::LAB)
pub const LEVEL_EARTH: Vec<vec4> = earth_mesh(course::LEVEL)
pub const LAB_GRASS: Vec<vec4> = grass_mesh(course::LAB)
pub const LEVEL_GRASS: Vec<vec4> = grass_mesh(course::LEVEL)

// ---- the ground's top, sampled ----------------------------------------------------------------

/// The profile's first x and its spacing (m), and how many samples it has.
pub const FROM: f32 = -40.0
pub const STEP: f32 = 0.25
pub const SAMPLES: u32 = 1800

/// The top of the solid ground at `x` among `outlines` (each a solid's points): the highest point
/// where a side crosses the vertical through `x`, or far below where none does.
pub fn ground_top(outlines: [Vec<vec2>], x: f32) -> f32 {
    var top = -1.0e3
    for points in outlines {
        let n = points.len()
        for i in 0..n {
            let (a, b) = (points[i], points[(i + 1) % n])
            if (a.x <= x && x < b.x) || (b.x <= x && x < a.x) {
                top = max(top, a.y + (b.y - a.y) * (x - a.x) / (b.x - a.x))
            }
        }
    }
    top
}

/// Each solid's outline (not the ledges').
pub fn solids(c: Course) -> Vec<Vec<vec2>> {
    var out: Vec<Vec<vec2>> = Vec::new()
    for k in 0..c.chains.len() - 1 {
        if !c.pieces[c.chains[k]].ledge {
            out.push(outline(c.pieces, c.chains[k], c.chains[k + 1]))
        }
    }
    out
}

/// The top of the course's solid ground every `STEP` m from `FROM`.
pub fn profile(c: Course) -> Vec<f32> {
    let outlines = solids(c)
    var out: Vec<f32> = Vec::new()
    for i in 0..SAMPLES {
        out.push(ground_top(outlines, FROM + f32(i) * STEP))
    }
    out
}

/// The profile's top at `x`, between its samples.
pub fn top_at(tops: [f32], x: f32) -> f32 {
    let f = clamp((x - FROM) / STEP, 0.0, f32(SAMPLES - 2))
    let i = u32(f)
    let t = f - f32(i)
    tops[i] + (tops[i + 1] - tops[i]) * t
}

// ---- drawing ----------------------------------------------------------------------------------

/// What the ground's shaders are told: the camera's matrix, the size of a pixel (m), the time
/// (s), and what bends the grass: the capybara's feet, its velocity, whether it slides (1) and how
/// near the ground it is.
pub struct Field: Copy + GpuData {
    pub view_proj: mat4,
    pub feet: vec2,
    pub vel: vec2,
    pub px: f32,
    pub time: f32,
    pub sliding: f32,
    pub pad: f32 = 0.0,
}

pub struct Earthel: Copy {
    pub clip: ClipPosition,
    pub world: vec2,
    pub band: f32,
    pub material: Flat<f32>,
    pub side: Flat<vec2>,
}

@vertex
pub fn earth_vertex(v: VertexIndex, verts: [vec4], f: Field) -> Earthel {
    let a = verts[v.index * 2]
    let b = verts[v.index * 2 + 1]
    Earthel {
        clip: ClipPosition { position: f.view_proj * vec4(a.xy, 0.5, 1.0) },
        world: a.xy,
        band: a.w,
        material: Flat { value: a.z },
        side: Flat { value: b.xy },
    }
}

/// A pebble in the soil at `p`, if one is there: its colour and how much of the pixel it covers.
/// One may sit in each cell 0.32 m square, lit as a little dome by the sun.
fn pebble(p: vec2, px: f32) -> vec4 {
    let size = 0.32
    let cell = floor(p / size)
    let (cx, cy) = (i32(cell.x), i32(cell.y))
    let h = hash2(cx, cy)
    if h > 0.22 {
        return vec4(0.0)
    }
    let r = size * (0.12 + 0.22 * hash2(cx + 71, cy))
    let centre = (cell +
        vec2(0.5) +
        (vec2(hash2(cx, cy + 13), hash2(cx + 5, cy)) - vec2(0.5)) * 0.3) *
        size
    let l = (p - centre) / vec2(r, r * 0.75)
    let k = dot(l, l)
    if k >= 1.0 {
        return vec4(0.0)
    }
    let n = vec3(l, sqrt(1.0 - k))
    let lit = (0.4 + 0.75 * max(dot(n, normalize(SUN)), 0.0)) * smoothstep(0.0, 0.45, n.z)
    let stone = blend(
        lin(vec3(0.62, 0.58, 0.52)),
        lin(vec3(0.5, 0.44, 0.38)),
        hash2(cx + 3, cy + 9),
    )
    let cover = saturate((1.0 - sqrt(k)) * r / px)
    vec4(stone * lit, cover)
}

/// The soil at `p`, `depth` m below the top of the ground: layers that waver, roots near the top,
/// pebbles, darker the deeper it is.
fn soil(p: vec2, depth: f32, px: f32) -> vec3 {
    let warp = noise2(p * vec2(0.3, 0.7)) * 1.6 + noise2(p * 1.3) * 0.4
    let layer = noise2(vec2(p.x * 0.1, p.y * 0.9 + warp))
    var c = blend(lin(vec3(0.45, 0.33, 0.24)), lin(vec3(0.56, 0.42, 0.3)), layer)
    // Patches of redder clay and of darker loam.
    let clay = smoothstep(0.55, 0.75, noise2(p * vec2(0.25, 0.5) + vec2(31.0)))
    c = blend(c, lin(vec3(0.58, 0.38, 0.26)), clay * 0.5)
    let dark = smoothstep(0.6, 0.72, noise2(vec2(p.x * 0.06, p.y * 1.8 + warp * 0.6)))
    c = blend(c, lin(vec3(0.36, 0.26, 0.19)), dark * 0.45)
    let grain = noise2(p * 26.0) * 0.12 + noise2(p * 8.0) * 0.12 + noise2(p * 70.0) * 0.08
    c *= 0.84 + grain
    // Roots near the top.
    let root = abs(noise2(vec2(p.x * 2.6, p.y * 0.9 + noise2(p * 3.0))) - 0.5)
    let roots = smoothstep(0.03, 0.012, root) * smoothstep(1.2, 0.3, depth)
    c = blend(c, lin(vec3(0.3, 0.2, 0.13)), roots * 0.8)
    let stone = pebble(p, px)
    c = blend(c, stone.xyz, stone.w)
    // Light on the face: the sky's, falling off with depth, and the turf's shadow under its lip.
    let deep = mix(vec3(1.0), vec3(0.22, 0.24, 0.3), smoothstep(0.0, 8.0, depth))
    let lip = mix(0.4, 1.0, smoothstep(TURF_DEPTH - 0.02, TURF_DEPTH + 0.55, depth))
    c * (vec3(0.6, 0.62, 0.68) + SUN_COLOUR * 0.3) * deep * lip
}

/// The earth: soil, turf, a cliff's rim, or a ledge's planks.
@fragment
pub fn earth(e: Earthel, f: Field, tops: [f32]) -> vec4 {
    let p = e.world
    let m = e.material.value
    let depth = max(top_at(tops, p.x) - p.y, 0.0)
    if m == PLANK {
        // Planks a metre long, their grain along them; lit along the top, dark below.
        let seam = abs(fract(p.x + 0.5 * floor(p.y * 2.0)) - 0.5)
        let grain = noise2(vec2(p.x * 0.7, p.y * 30.0)) * 0.25 +
            noise2(vec2(p.x * 3.0, p.y * 60.0)) * 0.1
        var c = lin(vec3(0.72, 0.5, 0.3)) * (0.8 + grain)
        c *= mix(1.0, 0.35, smoothstep(0.49, 0.5, seam))
        let top = smoothstep(0.12, 0.0, e.band)
        let under = smoothstep(0.6, 1.0, e.band)
        c = c * (0.7 + SUN_COLOUR * 0.45 * (1.0 + top * 0.8)) * (1.0 - under * 0.55)
        return vec4(c, 1.0)
    }
    let below = soil(p, depth, f.px)
    if m == SOIL {
        return vec4(below, 1.0)
    }
    let across = e.band * if m == TURF { TURF_DEPTH } else { RIM_DEPTH }
    if m == TURF {
        // The turf: dense green, ragged where it gives way to the soil, lit from above.
        let edge = TURF_DEPTH * (0.55 + 0.35 * noise2(vec2(p.x * 5.0, 0.0))) +
            0.04 * noise2(p * 18.0)
        if across > edge {
            return vec4(below, 1.0)
        }
        let t = across / edge
        var c = blend(lin(vec3(0.42, 0.66, 0.2)), lin(vec3(0.2, 0.38, 0.1)), t)
        c *= 0.85 + 0.3 * noise2(p * vec2(30.0, 12.0))
        c *= vec3(0.55, 0.6, 0.62) + SUN_COLOUR * (0.55 - 0.3 * t)
        return vec4(c, 1.0)
    }
    // A cliff's rim: darker soil, its edge lit where it faces the sun.
    let side = e.side.value
    let facing = max(dot(side, normalize(SUN.xy)), 0.0)
    let edge = smoothstep(0.06, 0.0, across)
    let c = below * (0.75 + 0.25 * smoothstep(0.0, RIM_DEPTH, across)) +
        below * SUN_COLOUR * edge * facing * 0.8
    vec4(c, 1.0)
}

pub struct Blade: Copy {
    pub clip: ClipPosition,
    pub world: vec2,
    pub height: f32,
}

@vertex
pub fn grass_vertex(v: VertexIndex, verts: [vec4], f: Field) -> Blade {
    let a = verts[v.index * 2]
    Blade {
        clip: ClipPosition { position: f.view_proj * vec4(a.xy, 0.5, 1.0) },
        world: a.xy,
        height: a.z,
    }
}

/// How far apart the grass's blades grow (m).
const SPACING: f32 = 0.032

/// The grass: of the blades near the pixel, the front one that covers it, shaded from its dark
/// root to its sunlit tip.
@fragment
pub fn grass(b: Blade, f: Field) -> Over {
    let x = b.world.x
    let h = b.height
    if h < -GRASS_ROOT * 0.5 {
        discard()
    }
    let first = i32(floor(x / SPACING))
    var best = -1.0
    var colour = vec3(0.0)
    var cover = 0.0
    // Where the capybara stands near the grass, it parts the blades and, sliding, presses them.
    let near = smoothstep(1.4, 0.4, abs(f.feet.y - (b.world.y - h)))
    for k in -4..5 {
        let i = first + k
        let r1 = hash2(i, 1)
        let r2 = hash2(i, 2)
        let r3 = hash2(i, 3)
        let r4 = hash2(i, 4)
        let base = (f32(i) + r1) * SPACING
        let clump = 0.55 + 0.6 * noise2(vec2(base * 0.9, 5.0))
        var tall = (0.12 + 0.3 * r2) * clump
        let gust = noise2(vec2(base * 0.18 - f.time * 0.7, 2.0))
        var lean = (gust - 0.45) * 0.7 + 0.12 * sin(f.time * 2.6 + base * 2.1 + r3 * 6.0)
        let dx = base - f.feet.x
        let touch = smoothstep(0.75, 0.0, abs(dx)) * near
        lean += sign(dx) * touch * 1.6 + clamp(f.vel.x * 0.05, -0.6, 0.6) * touch
        tall *= 1.0 - touch * (0.35 + 0.4 * f.sliding)
        if h > tall {
            continue
        }
        let t = max(h, 0.0) / tall
        let centre = base + lean * t * t * tall
        let width = (0.007 + 0.008 * r3) * (1.0 - t * 0.85)
        let off = abs(x - centre)
        let edge = saturate((width - off) / f.px + 0.5)
        if edge > 0.0 && r4 > best {
            best = r4
            cover = edge
            let root = lin(vec3(0.12, 0.26, 0.06))
            let tip = blend(lin(vec3(0.55, 0.78, 0.22)), lin(vec3(0.78, 0.8, 0.32)), r1 * r2)
            var c = blend(root, tip, pow(t, 0.8))
            c *= 0.8 + 0.4 * r3
            let light = vec3(0.5, 0.56, 0.6) + SUN_COLOUR * (0.4 + 0.6 * t)
            colour = c * light + SUN_COLOUR * lin(vec3(0.5, 0.6, 0.2)) * t * t * 0.5
            // Now and then a flower at the tip.
            if r2 > 0.93 && t > 0.82 {
                colour = blend(lin(vec3(1.0, 0.95, 0.85)), lin(vec3(1.0, 0.8, 0.3)), r1) *
                    (0.6 + SUN_COLOUR * 0.6)
            }
        }
    }
    if cover <= 0.0 {
        discard()
    }
    Over { color: vec4(colour, cover) }
}
