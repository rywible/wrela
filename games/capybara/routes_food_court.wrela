/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level food_court --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 186.65, 1.0e9, 1.0e9, 1.0e9]

@test
fn the_searched_runs_of_food_court_finish_in_their_times_without_a_death() {
    let every = course(FOOD_COURT).every_snack()
    let any = play(FOOD_COURT, ANY)
    let full = play(FOOD_COURT, FULL)
    assert(any.finished == 1601 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 2698 && full.deaths == 0 && full.snacks == every)
    let human_any = play(FOOD_COURT, HUMAN_ANY)
    let human_full = play(FOOD_COURT, HUMAN_FULL)
    assert(human_any.finished == 1619 && human_any.deaths == 0)
    assert(human_full.finished == 3170 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
