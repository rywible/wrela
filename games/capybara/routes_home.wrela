/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level home --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 45.69, 1.0e9, 1.0e9, 1.0e9]

@test
fn the_searched_runs_of_home_finish_in_their_times_without_a_death() {
    let every = course(HOME).every_snack()
    let any = play(HOME, ANY)
    let full = play(HOME, FULL)
    assert(any.finished == 1000 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 1059 && full.deaths == 0 && full.snacks == every)
    let human_any = play(HOME, HUMAN_ANY)
    let human_full = play(HOME, HUMAN_FULL)
    assert(human_any.finished == 991 && human_any.deaths == 0)
    assert(human_full.finished == 1087 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
