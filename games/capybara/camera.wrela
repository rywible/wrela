// The camera: a fixed side view that scrolls both ways (design.md, "Movement", proposed). It
// looks a little ahead of the way the capybara faces, and further ahead only past the capybara's
// running speed (a slide, a leap), so starting and stopping don't swing it (Ryan, 2026-10-21: the
// rebound was too much when it led by the speed itself). On the ground it moves up or down only when
// the capybara lands at a new height; while the capybara swims, or flies or falls out of a band
// round the view's middle, it follows. It is presentation, stepped by the frame's time.

use body::Mode
use feel::FEEL
use world::Snap

/// How far the camera stands from the plane of play (m), and how wide it sees (rad): about 12.6 m
/// of the plane from top to bottom.
pub const DISTANCE: f32 = 16.0
pub const FOVY: f32 = 0.75

/// How far the camera's height may leave the height it keeps before it follows (m).
const BAND: f32 = 2.5

/// How far ahead of the way it faces the camera looks (m); how much further per m/s past the
/// running speed (s), and the most of that (m).
const FACING: f32 = 1.5
const LEAD: f32 = 0.25
const LEAD_MAX: f32 = 3.0

/// The capybara sits this far below the view's middle, so more is seen above it (m).
const ABOVE: f32 = 1.2

pub struct Camera: Copy {
    /// The point of the plane at the view's middle (m).
    pub at: vec2,
    /// The height it keeps: the capybara's middle when it last stood (m).
    pub level: f32,
    /// How far ahead it looks now (m).
    pub ahead: f32,
}

pub fn camera(start: vec2) -> Camera {
    Camera { at: start + vec2(0.0, ABOVE), level: start.y, ahead: 0.0 }
}

fn ease(rate: f32, dt: f32) -> f32 {
    1.0 - exp(-rate * dt)
}

/// The camera after `dt` seconds following snapshot `s`.
pub fn follow(c: mut Camera, s: Snap, dt: f32) {
    let mode = Mode::from_u32(s.mode)
    let grounded = mode == Some(Mode::Walk) ||
        mode == Some(Mode::Crouch) ||
        mode == Some(Mode::Slide)
    if grounded {
        c.level = s.at.y
    } else if mode == Some(Mode::Swim) || abs(s.at.y - c.level) > BAND {
        c.level += (s.at.y - c.level) * ease(6.0, dt)
    }
    let past = max(abs(s.vel.x) - FEEL.speed, 0.0) * sign(s.vel.x)
    let lead = s.facing * FACING + clamp(past * LEAD, -LEAD_MAX, LEAD_MAX)
    c.ahead += (lead - c.ahead) * ease(1.5, dt)
    let want = vec2(s.at.x + c.ahead, c.level + ABOVE)
    c.at += (want - c.at) * vec2(ease(8.0, dt), ease(4.0, dt))
}

/// Half the view's size on the plane of play (m), for a screen `aspect` wide to its height.
pub fn half_view(aspect: f32) -> vec2 {
    let h = DISTANCE * tan(FOVY * 0.5)
    vec2(h * aspect, h)
}

// ---- tests -------------------------------------------------------------------------------------

use course::LAB
use feel::STEP
use pad::{Hold, pad_of}
use proofs::LAB_RUN
use world::{present, step, world}

/// Whether the camera keeps the capybara in view, a metre and a half inside a 16:9 screen's
/// edges, through `run`.
fn keeps_in_view(run: [Hold]) -> bool {
    let half = half_view(16.0 / 9.0) - vec2(1.5)
    var w = world(0)
    var c = camera(LAB.start)
    for h in run {
        for i in 0..h.ticks {
            step(mut w, pad_of(h, i))
            let s = present(w)
            follow(mut c, s, STEP)
            let off = abs(s.at - c.at)
            if off.x >= half.x || off.y >= half.y {
                return false
            }
        }
    }
    true
}

@test
fn the_camera_keeps_the_capybara_in_view_through_the_whole_lab() {
    assert(keeps_in_view(LAB_RUN))
}

@test
fn starting_and_stopping_barely_move_the_camera_past_the_capybara() {
    // Run right from rest for a second, then stop: the view's lead over the capybara changes by
    // the easing alone, never by more than half a metre past the facing lead.
    var w = world(0)
    var c = camera(LAB.start)
    for i in 0..240 {
        let bits = if i < 120 { pad::RIGHT } else { 0 }
        step(mut w, pad::Pad { bits })
        let s = present(w)
        follow(mut c, s, STEP)
        assert(c.ahead <= FACING + 0.5, "no swing ahead at the running speed")
    }
}
