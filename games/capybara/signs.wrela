// The zoo's signs: the level teaches its moves where they're first needed, on signs a zoo would
// have, not on a card before play (Celeste's, Ori's and Hollow Knight's way, and Super Mario
// Bros.' 1-1 before them). Each stands on a post at the back of the play, its board high enough
// that the capybara runs under it, and says a move with the keys or the controller's buttons the
// player last used (screens.wrela's prompts). Once the player has made a move, its sign's prompt
// fades (`learned`; the game keeps what it has seen made, settings.wrela), and the sign stays,
// as the zoo's. Presentation only: the sim knows nothing of them.
//
// The signs stand on the plane of play, so they pass at the camera's speed (Ryan: "it's hard to
// read the instructions as they go by"). So a sign's prompt stays with the player: while the
// capybara is within a sign's reach and hasn't made its move, the sign's heading and buttons show
// on a card at the top of the screen, steady while the world moves (`Card`), until a second
// after the sign leaves the screen.
//
// The words, the card and its timing are proposed (design.md).

use body::Mode
use screens::{Act, INKED, act, act_width, card, centred, unit}
use sprites::{SIGN, Sprite}
use ui::draw::{DrawList, Rect}
use ui::glyphs::Device
use ui::text::{Face, Fonts}
use course::{AVIARY, FARM, FOOD_COURT, HOME, POLAR, RAINFOREST, REPTILES, SAVANNA, WETLANDS}
use world::Snap

/// The moves a sign teaches, a bit each.
pub const RUN_AND_JUMP: u32 = 1
pub const DOUBLE_JUMP: u32 = 2
pub const SPLASH: u32 = 4
pub const SLIDE: u32 = 8
pub const SWIM: u32 = 16

/// Where a sign's board is on its post: its middle above the post's foot, and its half-size (m).
/// Its cream panel, which the words keep inside, is `RIM` in from its edge.
pub const BOARD = vec2(0.0, 3.35)
pub const BOARD_HALF = vec2(1.9, 1.1)
const RIM: f32 = 0.11

/// The sizes of a sign's words (m): its heading, its buttons' glyphs and its note, and the space
/// between them; and how far in from the panel's sides they keep. The view is 2 ×
/// `camera::HALF_HEIGHT` m high, so on a 720 px screen the note is 16 px, the heading 21.
pub const HEADING: f32 = 0.37
pub const GLYPH: f32 = 0.5
pub const NOTE: f32 = 0.28
const SPACE: f32 = 0.1
const INSET: f32 = 0.15

/// How near its post a sign's reach is (m), and its card's times (s): how long it stays once the
/// sign has left the screen or its move is made, and how long it takes to fade.
pub const REACH: f32 = 6.0
pub const STAYS: f32 = 1.0
pub const FADES: f32 = 0.35

/// A sign: its post's foot, what it's headed, its prompts (none: only `line`), a line under
/// them, and the move it teaches.
pub struct Sign: Copy {
    pub at: vec2,
    pub heading: Text,
    pub first: Act,
    pub second: Act,
    pub prompts: u32,
    pub line: Text,
    pub teaches: u32,
}

/// None: the lab's signs.
const NO_SIGNS: [Sign; 0] = []

/// Course `c`'s signs, read in place: its level's; the lab has none.
pub fn signs(c: u32) -> borrow [Sign] {
    if c == HOME {
        return home::SIGNS
    } else if c == WETLANDS {
        return wetlands::SIGNS
    } else if c == SAVANNA {
        return savanna::SIGNS
    } else if c == RAINFOREST {
        return rainforest::SIGNS
    } else if c == AVIARY {
        return aviary::SIGNS
    } else if c == REPTILES {
        return reptiles::SIGNS
    } else if c == POLAR {
        return polar::SIGNS
    } else if c == FARM {
        return farm::SIGNS
    } else if c == FOOD_COURT {
        return food_court::SIGNS
    }
    NO_SIGNS
}

/// The moves snapshot `s` shows made: a jump, a double jump, a splash, a slide, a kick.
pub fn learned(s: Snap) -> u32 {
    var out = 0
    if s.tally.jumps > 0 {
        out = out | RUN_AND_JUMP
    }
    if s.tally.doubles > 0 {
        out = out | DOUBLE_JUMP
    }
    if s.wet > 0 {
        out = out | SPLASH
    }
    if Mode::from_u32(s.mode) == Some(Mode::Slide) {
        out = out | SLIDE
    }
    if s.tally.kicks > 0 {
        out = out | SWIM
    }
    out
}

/// Course `c`'s signs as sprites: a post, and the board the frames write on, its half-size and its
/// middle over the sprite's in `pose` (sprites.wrela's `sign`).
pub fn sign_sprites(c: u32, out: mut Vec<Sprite>) {
    let top = BOARD.y + BOARD_HALF.y + 0.1
    let middle = vec2(0.0, top * 0.5 - 0.05)
    for s in signs(c) {
        out.push(
            Sprite {
                pose: vec4(BOARD_HALF, BOARD.y - middle.y, RIM),
                more: vec4(0.0),
                at: s.at + middle,
                half: vec2(BOARD_HALF.x + 0.1, top * 0.5),
                angle: 0.0,
                facing: 1.0,
                kind: SIGN,
            },
        )
    }
}

/// Sign `s`'s note broken into lines on its board, `m` pixels a metre.
fn board_note(fonts: Fonts, s: Sign, m: f32) -> Vec<(u32, u32)> {
    let width = (BOARD_HALF.x - RIM - INSET) * 2.0 * m
    if s.line.len() > 0 { fonts.font(Face::Sans).wrap(s.line, NOTE * m, width) } else { Vec::new() }
}

/// How tall sign `s`'s words stand on its board (px), `m` pixels a metre, its note `lines` lines.
fn board_tall(fonts: Fonts, s: Sign, m: f32, lines: u32) -> f32 {
    borrow font = fonts.font(Face::Sans)
    let rows = (if s.prompts > 0 { (GLYPH + SPACE) * m } else {
        0.0
    }) + f32(lines) * font.line_height(NOTE * m)
    font.line_height(HEADING * m) + SPACE * m + rows
}

/// The signs' notes broken into lines, kept from frame to frame: the course they're of, and each
/// sign's lines on its board (`m` pixels a metre) and on the card (`u` the screens' unit), broken
/// again only when the course or a size changes.
pub struct Wraps {
    course: u32 = 0xffffffff,
    m: f32 = 0.0,
    boards: Vec<Vec<(u32, u32)>> = Vec::new(),
    u: f32 = 0.0,
    cards: Vec<Vec<(u32, u32)>> = Vec::new(),
}

impl Wraps {
    /// Course `c`'s notes, broken for boards `m` pixels a metre and a card in unit `u` if they
    /// aren't (either 0: kept as they are).
    fn update(mut self, fonts: Fonts, c: u32, m: f32, u: f32) {
        if c != self.course {
            self.course = c
            self.m = 0.0
            self.u = 0.0
        }
        if m > 0.0 && m != self.m {
            self.m = m
            self.boards.clear()
            for s in signs(c) {
                self.boards.push(board_note(fonts, s, m))
            }
        }
        if u > 0.0 && u != self.u {
            self.u = u
            self.cards.clear()
            for s in signs(c) {
                self.cards.push(card_note(fonts, s, u))
            }
        }
    }
}

/// How wide sign `s`'s prompts are for `device`, their glyphs `glyph` px high, and the space
/// between them.
fn prompts_width(fonts: Fonts, s: Sign, device: Device, glyph: f32) -> (f32, f32) {
    let a = act_width(fonts, s.first, device, glyph)
    let b = if s.prompts > 1 { act_width(fonts, s.second, device, glyph) } else { 0.0 }
    let space = if s.prompts > 1 { glyph * 0.32 } else { 0.0 }
    (a + b + space, space)
}

/// Sign `s`'s prompts, `glyph` px high, from `at` (their top left), `alpha` of their ink.
fn draw_prompts(
    list: mut DrawList,
    fonts: Fonts,
    s: Sign,
    device: Device,
    at: vec2,
    glyph: f32,
    alpha: f32,
) {
    let (_, space) = prompts_width(fonts, s, device, glyph)
    let x = at.x + act(mut list, fonts, s.first, device, at, glyph, alpha) + space
    if s.prompts > 1 {
        let _ = act(mut list, fonts, s.second, device, vec2(x, at.y), glyph, alpha)
    }
}

/// Course `c`'s signs' words and prompts, drawn on their boards into `list`, for the scene: its
/// middle at `eye` and half its size `half` (m), `screen` pixels, their notes' lines kept in
/// `wraps`. A sign whose move is in `learned` says its prompts faintly. The frames draw them over
/// the water (main.wrela), so it never bends them.
pub fn sign_words(
    list: mut DrawList,
    wraps: mut Wraps,
    fonts: Fonts,
    c: u32,
    learned: u32,
    device: Device,
    eye: vec2,
    half: vec2,
    screen: vec2,
) {
    let m = screen.y / (2.0 * half.y)
    wraps.update(fonts, c, m, 0.0)
    borrow all = signs(c)
    for i in 0..all.len() {
        let s = all[i]
        if !on_screen(s, eye, half) {
            continue
        }
        let mid = s.at + BOARD
        let at = vec2((mid.x - eye.x) * m + screen.x * 0.5, (eye.y - mid.y) * m + screen.y * 0.5)
        borrow lines = wraps.boards[i]
        let tall = board_tall(fonts, s, m, lines.len())
        borrow font = fonts.font(Face::Sans)
        let (size, glyph, note) = (HEADING * m, GLYPH * m, NOTE * m)
        var y = at.y - tall * 0.5
        centred(mut list, fonts, Face::Sans, s.heading, size, at.x, y, INKED)
        y += font.line_height(size) + SPACE * m
        let faint = if learned & s.teaches != 0 { 0.35 } else { 1.0 }
        if s.prompts > 0 {
            let (w, _) = prompts_width(fonts, s, device, glyph)
            draw_prompts(mut list, fonts, s, device, vec2(at.x - w * 0.5, y), glyph, faint)
            y += glyph + SPACE * m
        }
        for (a, b) in lines {
            centred(mut list, fonts, Face::Sans, s.line.slice(a, b), note, at.x, y, INKED)
            y += font.line_height(note)
        }
    }
}

/// Whether sign `s`'s board is on a screen whose middle is at `eye`, half its size `half` (m).
fn on_screen(s: Sign, eye: vec2, half: vec2) -> bool {
    abs(s.at.x + BOARD.x - eye.x) <= half.x + BOARD_HALF.x
}

// ---- the card ----------------------------------------------------------------------------------

/// The sign of course `c` whose reach the capybara at `x` (m) is in: the nearest, within `REACH`
/// of its post. Signs at least 2 × `REACH` apart have reaches that never meet.
pub fn reached(c: u32, x: f32) -> Option<u32> {
    var best: Option<u32> = None
    var near = REACH
    let all = signs(c)
    for i in 0..all.len() {
        let d = abs(all[i].at.x - x)
        if d <= near {
            best = Some(i)
            near = d
        }
    }
    best
}

/// The card that keeps a sign's prompt on the screen: the course it's of, the sign it shows, and
/// how long since that sign left the screen or its move was made (s).
pub struct Card: Copy {
    pub course: u32 = 0xffffffff,
    pub sign: Option<u32> = None,
    pub gone: f32 = 0.0,
}

impl Card {
    /// The card `dt` seconds on: the capybara at `at` on course `c`, the moves `learned` made, the
    /// screen's middle at `eye` and half its size `half` (m). A sign in reach whose move isn't
    /// made shows, steady. Once its move is made the card fades at once, and once the sign is off
    /// the screen it stays `STAYS`, then fades.
    pub fn next(mut self, c: u32, learned: u32, at: vec2, eye: vec2, half: vec2, dt: f32) {
        if c != self.course {
            self.course = c
            self.sign = None
        }
        let all = signs(c)
        if let Some(i) = reached(c, at.x) {
            if learned & all[i].teaches == 0 {
                self.sign = Some(i)
                self.gone = 0.0
                return
            }
        }
        let Some(i) = self.sign else {
            return
        }
        if learned & all[i].teaches != 0 {
            self.gone = max(self.gone, STAYS) + dt
        } else if on_screen(all[i], eye, half) {
            self.gone = 0.0
        } else {
            self.gone += dt
        }
        if self.gone >= STAYS + FADES {
            self.sign = None
        }
    }

    /// How much of the card shows, 0 to 1.
    pub fn alpha(self) -> f32 {
        if self.sign.is_none() { 0.0 } else { 1.0 - smoothstep(STAYS, STAYS + FADES, self.gone) }
    }
}

/// The card's sizes, in the screens' units: its heading, its buttons' glyphs, a note and how wide
/// a note runs before it wraps.
const CARD_HEADING: f32 = 4.0
const CARD_GLYPH: f32 = 5.0
const CARD_NOTE: f32 = 3.2
const CARD_WRAP: f32 = 56.0

/// A sign with no buttons: its note's lines on the card, `u` the screens' unit.
fn card_note(fonts: Fonts, s: Sign, u: f32) -> Vec<(u32, u32)> {
    if s.prompts > 0 || s.line.len() == 0 {
        return Vec::new()
    }
    fonts.font(Face::Sans).wrap(s.line, u * CARD_NOTE, u * CARD_WRAP)
}

/// Where card `k`'s paper is on `screen` (px), at the top in the middle, clear of the snacks' count
/// and the clock; none when it shows no sign.
pub fn card_rect(fonts: Fonts, k: Card, device: Device, screen: vec2) -> Option<Rect> {
    let Some(i) = k.sign else {
        return None
    }
    let s = signs(k.course)[i]
    Some(paper(fonts, s, device, screen, card_note(fonts, s, unit(screen))))
}

/// Where the card's paper is for sign `s`, its note `lines` lines (`card_note`).
fn paper(fonts: Fonts, s: Sign, device: Device, screen: vec2, lines: [(u32, u32)]) -> Rect {
    let u = unit(screen)
    borrow font = fonts.font(Face::Sans)
    var w = font.measure(s.heading, u * CARD_HEADING)
    var h = max(u * CARD_GLYPH, font.line_height(u * CARD_HEADING))
    if s.prompts > 0 {
        let (p, _) = prompts_width(fonts, s, device, u * CARD_GLYPH)
        w += u * 3.0 + p
    }
    for (a, b) in lines {
        w = max(w, font.measure(s.line.slice(a, b), u * CARD_NOTE))
        h += font.line_height(u * CARD_NOTE)
    }
    Rect::new((screen.x - w) * 0.5 - u * 3.5, u * 2.6, w + u * 7.0, h + u * 5.0)
}

/// Card `k` at the top of `screen`, `alpha` of it: its sign's heading with its buttons beside it,
/// for `device`; a sign with no buttons says its note under its heading instead, its lines kept
/// in `wraps`.
pub fn sign_card(
    list: mut DrawList,
    wraps: mut Wraps,
    fonts: Fonts,
    k: Card,
    device: Device,
    screen: vec2,
    alpha: f32,
) {
    let Some(i) = k.sign else {
        return
    }
    if alpha <= 0.0 {
        return
    }
    let s = signs(k.course)[i]
    let u = unit(screen)
    wraps.update(fonts, k.course, 0.0, u)
    borrow lines = wraps.cards[i]
    let r = paper(fonts, s, device, screen, lines)
    let (size, glyph, note) = (u * CARD_HEADING, u * CARD_GLYPH, u * CARD_NOTE)
    borrow font = fonts.font(Face::Sans)
    card(mut list, r, u, alpha)
    let ink = vec4(INKED.xyz, alpha)
    let top = r.y + u * 2.5
    let line = font.line_height(size)
    let tall = max(glyph, line)
    let heading = font.measure(s.heading, size)
    let (p, _) = prompts_width(fonts, s, device, glyph)
    let row = heading + if s.prompts > 0 { u * 3.0 + p } else { 0.0 }
    let x = r.x + (r.w - row) * 0.5
    let _ = list.text(fonts, Face::Sans, s.heading, size, vec2(x, top + (tall - line) * 0.5), ink)
    if s.prompts > 0 {
        let at = vec2(x + heading + u * 3.0, top + (tall - glyph) * 0.5)
        draw_prompts(mut list, fonts, s, device, at, glyph, alpha)
    }
    var y = top + tall
    for (a, b) in lines {
        centred(mut list, fonts, Face::Sans, s.line.slice(a, b), note, r.x + r.w * 0.5, y, ink)
        y += font.line_height(note)
    }
}

// ---- tests -------------------------------------------------------------------------------------

/// How many pixels a metre of the scene is on a screen 720 px high.
fn at_720() -> f32 {
    720.0 / (2.0 * camera::HALF_HEIGHT)
}

@test
fn each_of_the_levels_moves_has_a_sign_left_to_right_and_none_in_the_lab() {
    let all = signs(WETLANDS)
    var taught = 0
    for i in 0..all.len() {
        taught = taught | all[i].teaches
    }
    assert(taught == RUN_AND_JUMP | DOUBLE_JUMP | SPLASH | SLIDE | SWIM)
    assert(signs(course::LAB_COURSE).len() == 0)
}

@test
fn every_levels_signs_stand_8_m_apart_so_each_is_read_alone() {
    for c in 0..course::LEVELS {
        let all = signs(c)
        for i in 1..all.len() {
            let apart = all[i].at.x - all[i - 1].at.x
            assert(apart >= 8.0, f"course {c}: signs {i - 1} and {i} are {apart} m apart")
        }
    }
}

@test
fn a_signs_board_stands_clear_of_the_capybara_and_the_ground() {
    // The capybara stands about 1.3 m tall as drawn: the board's foot is well above it.
    assert(BOARD.y - BOARD_HALF.y > 2.0)
    for c in 0..course::LEVELS {
        borrow at = course::course(c)
        for s in signs(c) {
            let (lo, hi) = (s.at + BOARD - BOARD_HALF, s.at + BOARD + BOARD_HALF)
            for k in 0..9 {
                let x = mix(lo.x, hi.x, f32(k) / 8.0)
                if let Some(y) = at.ground_at(x, hi.y) {
                    assert(y < lo.y, f"course {c}: ground at {x} m, {y} m up, in the sign's board")
                }
            }
        }
    }
}

@test
fn a_signs_words_read_at_16_px_and_fit_its_board() {
    let m = at_720()
    assert(NOTE * m >= 16.0 && HEADING * m >= 20.0 && GLYPH * m >= 28.0, f"{NOTE * m} px")
    let fonts = Fonts::load()
    borrow font = fonts.font(Face::Sans)
    let panel = (BOARD_HALF - vec2(RIM + INSET, RIM)) * 2.0 * m
    for c in 0..course::LEVELS {
        for s in signs(c) {
            let tall = board_tall(fonts, s, m, board_note(fonts, s, m).len())
            assert(tall <= panel.y, f"{s.heading}: {tall} px tall on a {panel.y} px panel")
            assert(font.measure(s.heading, HEADING * m) <= panel.x, f"{s.heading}: too wide")
            for d in [Device::Keys, Device::Pad] {
                let (w, _) = prompts_width(fonts, s, d, GLYPH * m)
                assert(w <= panel.x, f"{s.heading}: its buttons too wide")
            }
        }
    }
}

@test
fn the_sign_nearest_the_capybara_within_its_reach_is_the_one_in_reach() {
    // The wetlands' run and jump at 0 m, the double jump at 8, the splash at 32.4.
    assert(reached(WETLANDS, course::course(WETLANDS).start.x) == Some(0), "at the start")
    assert(reached(WETLANDS, 3.9) == Some(0) && reached(WETLANDS, 4.1) == Some(1))
    assert(reached(WETLANDS, 20.0).is_none(), "between them, out of either's reach")
    assert(reached(WETLANDS, 27.0) == Some(2), "the splash's, before the pit")
    assert(reached(course::LAB_COURSE, 0.0).is_none())
}

@test
fn a_signs_card_shows_in_its_reach_until_its_move_is_made() {
    let half = camera::half_view(16.0 / 9.0)
    let at = vec2(2.0, 0.35)
    var k = Card {}
    k.next(WETLANDS, 0, at, at, half, 1.0 / 60.0)
    assert(k.sign == Some(0) && k.alpha() == 1.0, "run and jump, at the start")
    // Steady while in reach.
    for _ in 0..600 {
        k.next(WETLANDS, 0, at, at, half, 1.0 / 60.0)
    }
    assert(k.alpha() == 1.0, "steady")
    // A jump: the card fades, and is gone.
    k.next(WETLANDS, RUN_AND_JUMP, at, at, half, 1.0 / 60.0)
    assert(k.alpha() < 1.0 && k.alpha() > 0.0, f"fading, {k.alpha()}")
    for _ in 0..60 {
        k.next(WETLANDS, RUN_AND_JUMP, at, at, half, 1.0 / 60.0)
    }
    assert(k.sign.is_none() && k.alpha() == 0.0, "gone")
    // A move already made: its card never shows.
    var made = Card {}
    made.next(WETLANDS, RUN_AND_JUMP, at, at, half, 1.0 / 60.0)
    assert(made.sign.is_none())
    // A sign that teaches no move (the polar's ice) shows whatever's made.
    var ice = Card {}
    let beach = vec2(8.0, 0.35)
    ice.next(course::POLAR, 0xffffffff, beach, beach, half, 1.0 / 60.0)
    assert(ice.sign == Some(0))
}

@test
fn a_signs_card_stays_while_the_sign_shows_then_a_second_more() {
    let half = camera::half_view(16.0 / 9.0)
    var k = Card {}
    let dt = 1.0 / 60.0
    k.next(WETLANDS, RUN_AND_JUMP, vec2(5.0, 0.35), vec2(5.0, 0.35), half, dt)
    assert(k.sign == Some(1), "the double jump's")
    // Past its reach, the sign still on the screen: it stays.
    let past = vec2(16.0, 0.35)
    k.next(WETLANDS, RUN_AND_JUMP, past, past, half, 5.0)
    assert(k.sign == Some(1) && k.alpha() == 1.0, "on the screen")
    // The sign off the screen: a second at full, then it fades and goes.
    let far = vec2(8.0 + half.x + BOARD_HALF.x + 1.0, 0.35)
    k.next(WETLANDS, RUN_AND_JUMP, far, far, half, 0.9)
    assert(k.alpha() == 1.0, "a second after it's gone, still")
    k.next(WETLANDS, RUN_AND_JUMP, far, far, half, 0.3)
    assert(k.alpha() < 1.0, "then fading")
    k.next(WETLANDS, RUN_AND_JUMP, far, far, half, FADES)
    assert(k.sign.is_none(), "and gone")
    // A new level starts clear.
    k.next(WETLANDS, 0, vec2(2.0, 0.35), vec2(2.0, 0.35), half, dt)
    k.next(course::SAVANNA, 0, vec2(2.0, 0.35), vec2(2.0, 0.35), half, dt)
    assert(k.sign.is_none(), "the savanna has no signs")
}

@test
fn a_signs_card_sits_at_the_top_in_the_middle_clear_of_the_count_and_the_clock() {
    let fonts = Fonts::load()
    let screen = vec2(1280.0, 720.0)
    for c in 0..course::LEVELS {
        for i in 0..signs(c).len() {
            let k = Card { course: c, sign: Some(i) }
            for d in [Device::Keys, Device::Pad] {
                let r = card_rect(fonts, k, d, screen).unwrap()
                assert(abs(r.center().x - screen.x * 0.5) < 0.5 && r.y < screen.y * 0.1)
                // The count's carrots take the left quarter, the clock the right sixth.
                assert(r.x > screen.x * 0.25 && r.right() < screen.x * 0.75, f"course {c} sign {i}")
                assert(r.bottom() < screen.y * 0.3, "high, over the sky")
            }
        }
    }
    assert(card_rect(fonts, Card {}, Device::Keys, screen).is_none())
}

@test
fn playing_the_level_through_makes_every_move_a_sign_teaches() {
    var seen = 0
    var l = world::live(WETLANDS)
    l.world.paused = false
    for h in routes_wetlands::HUMAN_FULL {
        for i in 0..h.ticks {
            world::step_counted(mut l.world, mut l.tally, pad::pad_of(h, i))
            seen = seen | learned(world::present_live(l))
        }
    }
    assert(seen == RUN_AND_JUMP | DOUBLE_JUMP | SPLASH | SLIDE | SWIM, f"{seen}")
}
