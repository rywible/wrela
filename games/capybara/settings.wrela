// The player's settings, kept in the game's storage apart from the progress: the music on or off,
// the clock shown or not (off at first: Ryan, 2026-10-23, the clock is "stressful for normal
// players"), the ghost that runs beside the player (and whether they chose it), and the moves the zoo's signs have seen the
// player make (signs.wrela), so their prompts don't come back each visit.
//
// The options are changed in the pause's menus, which are the sim's (world.wrela): the sim counts
// the steps taken on each, and the frames apply the steps they haven't yet (`turned`).

use camera::Aspect

/// Where the settings are stored.
pub const SETTINGS: Text = "capybara/settings"

/// The stored settings' version (a store of the two before reads its settings, the aspect at
/// first in the first's, and the ghost as chosen unless it was the player's best; of another, as
/// the settings at first).
const VERSION: u8 = 3

/// The ghost that runs beside the player: none, their best any% run, the robot's (the route
/// search's fastest), the human line's, the world's run just above the account's place on the
/// course's any% board (online.wrela's `ghost_hash`), or the world record.
pub const NO_GHOST: u32 = 0
pub const BEST_GHOST: u32 = 1
pub const AUTOPILOT_GHOST: u32 = 2
pub const HUMAN_GHOST: u32 = 3
pub const ABOVE_GHOST: u32 = 4
pub const RECORD_GHOST: u32 = 5
pub const GHOSTS: u32 = 6

pub struct Settings: Copy + Eq {
    pub music: bool = true,
    pub clock: bool = false,
    pub ghost: u32 = BEST_GHOST,
    /// Whether the player chose the ghost: until they do, a player signed in with a place on the
    /// course's board races the run above it (`ghost_of`; Ryan: "you can click the ones right above
    /// you ... and not get discouraged by the tippy top").
    pub chosen: bool = false,
    /// The moves the signs have seen made, a bit each (signs.wrela's `RUN_AND_JUMP`...).
    pub learned: u32 = 0,
    /// The view's shape: the fixed play area, or the screen's (camera.wrela's `Aspect`). Stored;
    /// no option shows it yet (the options' steps are the sim's).
    pub aspect: Aspect = Aspect::Fixed,
}

/// The settings as stored.
pub fn encode(s: Settings) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    out.push(VERSION)
    out.push(if s.music { 1 } else { 0 })
    out.push(if s.clock { 1 } else { 0 })
    out.push(u8(s.ghost))
    for i in 0..4 {
        out.push(u8((s.learned >> (8 * i)) & 0xff))
    }
    out.push(if s.aspect == Aspect::Free { 1 } else { 0 })
    out.push(if s.chosen { 1 } else { 0 })
    out
}

/// The settings stored as `b`, or the settings at first if `b` isn't settings of this version.
pub fn decode(b: [u8]) -> Settings {
    let first = b.len() == 8 && b[0] == 1
    let second = b.len() == 9 && b[0] == 2
    if !first && !second && (b.len() != 10 || b[0] != VERSION) {
        return Settings {}
    }
    var learned = 0
    for i in 0..4 {
        learned = learned | (u32(b[4 + i]) << (8 * i))
    }
    Settings {
        music: b[1] == 1,
        clock: b[2] == 1,
        ghost: min(u32(b[3]), GHOSTS - 1),
        chosen: if first || second { u32(b[3]) != BEST_GHOST } else { b[9] == 1 },
        learned,
        aspect: if !first && b[8] == 1 { Aspect::Free } else { Aspect::Fixed },
    }
}

/// The ghost that runs, with the settings `s`, for a player who has a place on the course's world
/// board (`place`) or hasn't: the one chosen, or until one is, the run above that place.
pub fn ghost_of(s: Settings, place: bool) -> u32 {
    if !s.chosen && place { ABOVE_GHOST } else { s.ghost }
}

/// `s` after the steps taken on the options from `before` to `now` (world.wrela's `turns`: the
/// music's, the clock's and the ghost's): each step flips the music or the clock, and moves the
/// ghost on (or back) one from the one running (`ghost_of`, with `place`), which is then chosen.
/// Whether anything changed.
pub fn turned(s: mut Settings, before: [i32; 3], now: [i32; 3], place: bool = false) -> bool {
    let was = s
    if (now[0] - before[0]) % 2 != 0 {
        s.music = !s.music
    }
    if (now[1] - before[1]) % 2 != 0 {
        s.clock = !s.clock
    }
    let n = i32(GHOSTS)
    if now[2] != before[2] {
        let steps = ((now[2] - before[2]) % n + n) % n
        s.ghost = (ghost_of(s, place) + u32(steps)) % GHOSTS
        s.chosen = true
    }
    s != was
}

/// The ghost's name, as the options show it.
pub fn ghost_name(g: u32) -> Text {
    if g == NO_GHOST {
        "None"
    } else if g == BEST_GHOST {
        "Your best"
    } else if g == HUMAN_GHOST {
        "The human line"
    } else if g == ABOVE_GHOST {
        "The run above yours"
    } else if g == RECORD_GHOST { "The world record" } else { "The robot" }
}

// ---- tests -------------------------------------------------------------------------------------

@test
fn the_clock_is_off_and_the_music_on_at_first() {
    let s = Settings {}
    assert(!s.clock && s.music && s.ghost == BEST_GHOST && s.learned == 0 && !s.chosen)
}

@test
fn settings_are_stored_and_read_back_and_anything_else_reads_as_the_first() {
    let s = Settings {
        music: false,
        clock: true,
        ghost: HUMAN_GHOST,
        chosen: true,
        learned: 0x80000005,
        aspect: Aspect::Free,
    }
    assert(decode(encode(s)) == s)
    // The first version's (no aspect) reads as stored, in the fixed aspect; the second's ghost is
    // chosen unless it's the player's best, the one at first.
    let old = [1, 0, 1, u8(HUMAN_GHOST), 5, 0, 0, 0x80]
    assert(decode(old) == Settings { aspect: Aspect::Fixed, ..s }, "the first version's")
    let second = [2, 1, 0, u8(BEST_GHOST), 0, 0, 0, 0, 0]
    assert(decode(second) == Settings {}, "the second's, the ghost at first")
    assert(decode([]) == Settings {}, "nothing stored")
    var other = encode(s)
    other[0] = 9
    assert(decode(other) == Settings {}, "another version")
}

@test
fn steps_on_the_options_flip_and_move_them() {
    var s = Settings {}
    assert(turned(mut s, [0, 0, 0], [1, 2, -1]), "changed")
    assert(
        !s.music && !s.clock && s.ghost == NO_GHOST,
        "music off, the clock twice, the ghost back",
    )
    assert(turned(mut s, [1, 2, -1], [1, 3, 2]))
    assert(s.clock && s.ghost == HUMAN_GHOST, "three on from none")
    assert(!turned(mut s, [1, 3, 2], [1, 3, 2]), "no steps")
}

@test
fn the_ghost_races_the_run_above_once_theres_a_place_until_one_is_chosen() {
    let first = Settings {}
    assert(ghost_of(first, place: false) == BEST_GHOST, "no place: the player's best")
    assert(ghost_of(first, place: true) == ABOVE_GHOST, "a place: the run above it")
    assert(ghost_name(ABOVE_GHOST) == "The run above yours")
    assert(ghost_name(RECORD_GHOST) == "The world record")
    // A step goes on from the ghost running, and chooses it.
    var s = Settings {}
    assert(turned(mut s, [0, 0, 0], [0, 0, 1], place: true) && s.chosen)
    assert(s.ghost == RECORD_GHOST && ghost_of(s, place: true) == RECORD_GHOST, "on to the record")
    assert(turned(mut s, [0, 0, 1], [0, 0, 2], place: true) && s.ghost == NO_GHOST, "round to none")
    assert(ghost_of(s, place: true) == NO_GHOST, "chosen, it stays")
    // A step on the music alone chooses no ghost.
    var m = Settings {}
    assert(turned(mut m, [0, 0, 0], [1, 0, 0], place: true) && !m.chosen)
}
