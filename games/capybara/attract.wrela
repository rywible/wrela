// The game playing itself (the build `--set ATTRACT=true`, the release's `attract`), which the
// console's home shows behind its text once it has rested on the game (console/attract.wrela;
// the look is proposed until Ryan sees it). It plays the route search's human-possible any% run
// of each level (routes_<level>.wrela's `HUMAN_ANY`, never the tool-assisted one), one level
// after another and round again, watched as a run on the leaderboard is (watch.wrela), its
// fireworks and all. It shows no HUD and no menus, plays no sound, reads no input, stores
// nothing and asks nothing of the network: main.wrela leaves its voice, the world's boards,
// the stored progress and settings, the semantic tree and the console's link out of the build.
// It tells the console it's ready once its first whole frame is drawn. The console mutes it and
// gives it no input while it's shown behind; once the console stops showing it, it closes it.

use course::{HOME, LEVELS}
use replay::{HUMAN, Replay, recorded}
use searched::searched
use std::host
use std::io::Pending
use watch::{Watch, watch}

/// Where the game playing itself is: the level it plays next, and its word to the console that
/// it's ready, once sent.
pub struct Attract {
    pub next: u32,
    ready: Option<Pending<u8>>,
    pub said: bool,
}

pub fn attract() -> Attract {
    Attract { next: HOME, ready: None, said: false }
}

/// Level `c`'s human-possible any% run, as a replay cut at its goal.
pub fn line(c: u32) -> Replay {
    recorded(c, searched(c).human_any, HUMAN)
}

/// The level after `c`, round to the first after the last.
pub fn after(c: u32) -> u32 {
    (c + 1) % LEVELS
}

impl Attract {
    /// The run watched: the next level's line once there's none, or the one watched has played
    /// to its end.
    pub fn play(mut self, watching: mut Option<Watch>) {
        let done = match watching {
            Some(w) => !w.playing,
            None => true,
        }
        if done {
            watching = Some(watch(line(self.next)))
            self.next = after(self.next)
        }
    }

    /// Tells the console it's ready, once `drawn` (its first whole frame is): `host::ready`.
    pub fn ready(mut self, drawn: bool) {
        if drawn && !self.said {
            self.ready = Some(host::ready())
            self.said = true
        }
        match mut self.ready {
            Some(p) => { if p.poll().is_some() { self.ready = None } },
            None => {},
        }
    }
}

// ---- tests -------------------------------------------------------------------------------------

@test
fn each_level_plays_the_searchs_human_line_never_the_robots() {
    for c in 0..LEVELS {
        let r = line(c)
        let s = searched(c)
        assert(r.course == c && r.who == HUMAN)
        assert(r.ticks > 0, f"level {c} reaches its goal")
        // Its pads are the human line's (not the tool-assisted one's, where they differ), cut at
        // the goal.
        var kept = 0
        for h in r.holds { kept += h.ticks }
        assert(kept == r.ticks, f"level {c}: cut at the goal")
        for i in 0..r.holds.len() - 1 {
            assert(r.holds[i] == s.human_any[i], f"level {c}: hold {i}")
        }
    }
}

// The level the run watched is of, or `LEVELS` for none.
fn watched(w: Option<Watch>) -> u32 {
    match w {
        Some(x) => x.replay.course,
        None => LEVELS,
    }
}

@test
fn it_plays_each_level_to_its_end_then_the_next_and_round_again() {
    var a = attract()
    var watching: Option<Watch> = None
    a.play(mut watching)
    assert(watched(watching) == HOME && a.next == after(HOME))
    // Playing, it stays on its level.
    a.play(mut watching)
    assert(watched(watching) == HOME)
    // Played to its end, through its goal, the next level's line.
    match mut watching {
        Some(w) => {
            w.speed = 4
            for _ in 0..100000 {
                if !w.playing { break }
                w.advance(1.0 / 60.0)
            }
            assert(!w.playing && w.world.finished == w.replay.ticks, "to its goal")
        },
        None => panic("a run to watch"),
    }
    a.play(mut watching)
    assert(watched(watching) == after(HOME))
    // After the last level, the first again.
    a.next = LEVELS - 1
    watching = None
    a.play(mut watching)
    assert(watched(watching) == LEVELS - 1 && a.next == HOME)
}
