/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level rainforest --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 178.99, 237.72, 1.0e9, 1.0e9]

@test
fn the_searched_runs_of_rainforest_finish_in_their_times_without_a_death() {
    let every = course(RAINFOREST).every_snack()
    let any = play(RAINFOREST, ANY)
    let full = play(RAINFOREST, FULL)
    assert(any.finished == 1675 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 2157 && full.deaths == 0 && full.snacks == every)
    let human_any = play(RAINFOREST, HUMAN_ANY)
    let human_full = play(RAINFOREST, HUMAN_FULL)
    assert(human_any.finished == 1675 && human_any.deaths == 0)
    assert(human_full.finished == 2235 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
