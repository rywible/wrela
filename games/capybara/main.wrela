/// The most sprites drawn: the cast's and the particles'.
const SPRITES: u32 = 1024

/// The boards: the player's runs, and the tool-assisted runs (design.md: "a separate
/// tool-assisted board").
const PLAYERS: u32 = 0
const ASSISTED: u32 = 1

/// How far a watched run seeks at a press (ticks): five seconds.
const SEEK: u32 = 600

/// How long the watch's prompts stay after the last key (s), and how long after the goal its card
/// comes (s).
const IDLE: f32 = 3.0
const FINISH_CARD: f32 = 1.6

pub struct Lab {
    snaps: Snapshots<Snap>,
    /// Each course's ground, grass, water and the top of its ground (the lab's, the level's).
    earths: [GpuBuffer<vec4>; 2],
    grasses: [GpuBuffer<vec4>; 2],
    waters: [GpuBuffer<vec4>; 2],
    tops: [GpuBuffer<f32>; 2],
    /// The shown course's pools and its waves' heights.
    pools: GpuBuffer<vec4>,
    heights: GpuBuffer<f32>,
    sprites: GpuBuffer<Sprite>,
    /// The course the camera was last following, and its cast.
    shown: u32,
    cast: Cast,
    targets: Targets,
    linear: Sampler,
    /// The baked grain (ink.wrela) and the sampler that repeats it.
    grain: Texture<Rgba16Float>,
    repeat: Sampler,
    /// The scene's size (px) at the render scale, and the scale.
    width: u32,
    height: u32,
    scale: Scale,
    camera: Camera,
    last: Option<f32>,
    /// The ring to the voice (sound.wrela): none until it starts, on the first frame.
    voice: Option<RingWriter<Cue>>,
    /// The player's settings (settings.wrela), as they load from storage and are stored again;
    /// whether the voice was last told to play the music; and the options' steps taken in the
    /// sim that the settings have (none until the first snapshot).
    settings: Settings,
    loading_settings: Option<Pending<u8>>,
    saving_settings: Option<Pending<u8>>,
    storing_settings: Storing,
    music_on: bool,
    turns: Option<[i32; 3]>,
    /// The device the player last used, for the prompts.
    device: Device,
    /// Whether the readout shows (F3): the frame rate, the frame's time and the render scale. The
    /// frames' time (s), smoothed, for it.
    readout: bool,
    /// How much the capybara is on the ground and slides, eased (earth.wrela's `Field`).
    presence: f32,
    sliding: f32,
    frame_time: f32,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    /// The signs' words, drawn into the scene behind the cast (signs.wrela).
    signs: Renderer,
    sign_list: DrawList,
    /// What the host can do (its environment's capabilities), once it has said; the semantic tree
    /// last sent; and the requests to it still out.
    environment: Option<Pending<u8>>,
    capabilities: Option<u32>,
    tree: Sent,
    told: Vec<Pending<u8>>,
    /// The player's runs (replay.wrela), as they load from storage and are stored again, and when
    /// (`Storing`). The attempt whose finish was last kept (its course and attempt), so each is
    /// kept once.
    runs: Board,
    loading: Option<Pending<u8>>,
    saving: Option<Pending<u8>>,
    storing: Storing,
    kept: u32,
    /// The tool-assisted runs of every course, the board shown (`PLAYERS` or `ASSISTED`), and the
    /// run with the focus on it: its category's column and its row.
    assisted: Vec<Replay>,
    board: u32,
    column: u32,
    row: u32,
    /// The trail the ghost follows, the clock at each checkpoint it reached (its splits), and the
    /// course and ghost that trail is for (`follow_ghost`; 0 once the player's runs change, as
    /// their best may have).
    trail: Vec<Pose>,
    splits: Vec<u32>,
    trail_of: u32,
    /// The attempt the splits are of, the last checkpoint it reached, its latest split against the
    /// ghost's (ticks, below 0 ahead) and how long it has shown (s).
    split_attempt: u32,
    split_checkpoint: u32,
    split: Option<i32>,
    split_age: f32,
    /// How long since the attempt reached the goal (s; 0 before), which attempt that was, and the
    /// player's best time before it (0 without one).
    finish_age: f32,
    finish_key: u32,
    best_before: u32,
    /// The run being watched, whether the last frame drew one, how long since a key while
    /// watching (s), where the pointer is (px), and the menus' moves the frames read (the runs').
    watching: Option<Watch>,
    watched: bool,
    idle: f32,
    pointer: vec2,
    nav: Stick,
}

pub fn init() -> Lab {
    let latest = run(live(LEVEL), hz: HZ, step: tick_live, present: present_live)
    var assisted = tool_assisted(LAB)
    for r in tool_assisted(LEVEL) {
        assisted.push(r.clone())
    }
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    let signs = Renderer::new(fonts)
    let shown = cast(course(LEVEL))
    Lab {
        snaps: Snapshots::new(take latest, hz: HZ),
        earths: [buffer_of(LAB_EARTH), buffer_of(LEVEL_EARTH)],
        grasses: [buffer_of(LAB_GRASS), buffer_of(LEVEL_GRASS)],
        waters: [buffer_of(LAB_WATER), buffer_of(LEVEL_WATER)],
        tops: [buffer_of(LAB_TOPS), buffer_of(LEVEL_TOPS)],
        pools: buffer_of(shown.waves.pools, at_least: 8),
        heights: buffer(COLUMNS),
        sprites: buffer(SPRITES),
        shown: LEVEL,
        cast: shown,
        targets: targets(width: 4, height: 4),
        linear: sampler(),
        grain: grain_texture(),
        repeat: sampler(address: Address::Repeat),
        width: 0,
        height: 0,
        scale: Scale {},
        camera: camera(course(LEVEL).start),
        last: None,
        voice: None,
        settings: Settings {},
        loading_settings: Some(load(SETTINGS)),
        saving_settings: None,
        storing_settings: Storing {},
        music_on: true,
        turns: None,
        device: Device::Keys,
        readout: false,
        presence: 1.0,
        sliding: 0.0,
        frame_time: 0.0,
        fonts,
        renderer,
        list: DrawList::new(),
        signs,
        sign_list: DrawList::new(),
        environment: Some(host::environment()),
        capabilities: None,
        tree: Sent {},
        told: Vec::new(),
        runs: board(),
        loading: Some(load(SAVED)),
        saving: None,
        storing: Storing {},
        kept: 0xffffffff,
        assisted,
        board: PLAYERS,
        column: ANY,
        row: 0,
        trail: Vec::new(),
        splits: Vec::new(),
        trail_of: 0,
        split_attempt: 0,
        split_checkpoint: 0,
        split: None,
        split_age: 0.0,
        finish_age: 0.0,
        finish_key: 0xffffffff,
        best_before: 0,
        watching: None,
        watched: false,
        idle: 0.0,
        pointer: vec2(-1.0),
        nav: Stick {},
    }
}

/// The snapshot a frame draws, from the two round its time. Everything that moves is drawn between them, so motion is continuous at any refresh rate,
/// whatever the sim's: the capybara's middle, velocity, speed and the ground's normal under it, and
/// each foe's middle (and how long since it was knocked out). Its counters (a flip's ticks, a
/// death's) are the later snapshot's, and `lag` says how far before it the frame falls (ticks, 0
/// to 1), so they can be drawn between too. Where a foe has jumped (back to its start when the
/// capybara comes back), or changed whether it's knocked out, it isn't blended; nor is anything
/// across a cut (world.wrela's `Tally`), where the capybara was put somewhere at once.
fn drawn(s: Snapshots<Snap>, time: f32) -> (Snap, f32) {
    let b = s.at(s.sim_time(time))
    (mixed(b.a, b.b, b.alpha), if b.b.ticks > b.a.ticks { 1.0 - b.alpha } else { 0.0 })
}

/// Snapshot `b` with what moves drawn `t` of the way from `a` (as `drawn` says).
fn mixed(a: Snap, b: Snap, t: f32) -> Snap {
    var snap = b
    if a.tally.cuts != b.tally.cuts {
        return snap
    }
    snap.at = mix(a.at, b.at, vec2(t))
    snap.vel = mix(a.vel, b.vel, vec2(t))
    snap.speed = mix(a.speed, b.speed, t)
    let n = mix(a.ground, b.ground, vec2(t))
    if length(n) > 1.0e-3 {
        snap.ground = normalize(n)
    }
    for i in 0..snap.foes.len() {
        let (f, g) = (a.foes[i], b.foes[i])
        if sign(f.z) == sign(g.z) && distance(f.xy, g.xy) < 1.0 {
            snap.foes[i] = vec4(mix(f.xy, g.xy, vec2(t)), g.z, if g.z < 0.0 {
                mix(f.w, g.w, t)
            } else { g.w })
        }
    }
    snap
}

// ---- the frame ---------------------------------------------------------------------------------

pub fn frame(s: mut Lab, time: f32, width: u32, height: u32) {
    let dt = match s.last {
        Some(before) => clamp(time - before, 0.0, 0.1),
        None => 0.0,
    }
    s.last = Some(time)
    if s.voice.is_none() {
        s.voice = Some(sound::start(music::music()))
    }
    s.snaps.update()
    let screen = vec2(f32(width), f32(height))
    let (live_snap, live_lag) = drawn(s.snaps, time)
    host_answers(mut s)
    store_runs(mut s, dt)
    store_settings(mut s, dt)
    if live_snap.finished > 0 {
        // The best before this run, before it's kept among the runs.
        let key = live_snap.course << 16 | (live_snap.attempt & 0xffff)
        if key != s.finish_key {
            s.finish_key = key
            s.best_before = best(s, live_snap.course)
        }
    }
    keep_finished(mut s, live_snap)
    // F3 shows the readout, and M turns the music off and on. The frames' keys are their own: the
    // sim's ticks take theirs. On the runs, the sim leaves the keys and clicks to the frames: the
    // board's and the watch's.
    let browsing = live_snap.paused == 1 && live_snap.page == RUNS
    for e in events() {
        if let Some(d) = device_of(e) {
            s.device = d
        }
        if let Event::PointerMove { at, .. } = e {
            s.pointer = at
        }
        if let Event::KeyDown { key, repeat, .. } = e {
            if key == Key::F3 && !repeat {
                s.readout = !s.readout
            } else if key == Key::M && !repeat {
                s.settings.music = !s.settings.music
                s.storing_settings.unsaved = true
            }
        }
        if browsing {
            browse(mut s, e, live_snap.course, screen)
        } else {
            let _ = s.nav.nav(e)
        }
    }
    if !browsing {
        s.watching = None
    }
    settle(mut s, live_snap, dt)
    s.idle += dt
    // A watched run, or play.
    var snap = live_snap
    var lag = live_lag
    var opening: Option<Snap> = None
    match mut s.watching {
        Some(w) => {
            if !s.watched {
                // A run just opened to watch: its cast hears it from its first tick.
                let (_, first, _) = w.between()
                opening = Some(first)
            }
            w.advance(dt)
            let (a, b, t) = w.between()
            snap = mixed(a, b, t)
            lag = if b.ticks > a.ticks { 1.0 - t } else { 0.0 }
        },
        None => {},
    }
    let watching = s.watching.is_some()
    borrow c = course(snap.course)
    if snap.course != s.shown || watching != s.watched {
        s.camera = camera(snap.at)
        s.cast = cast(c, from: opening)
        s.pools = buffer_of(s.cast.waves.pools, at_least: 8)
        s.shown = snap.course
        s.watched = watching
    }
    follow(mut s.camera, snap, dt)
    // The scene is drawn at the render scale, the page and the HUD at the screen's size.
    pace(mut s.scale, dt)
    if dt > 0.0 && dt < 0.25 {
        s.frame_time = if s.frame_time == 0.0 { dt } else {
            s.frame_time + (dt - s.frame_time) * 0.05
        }
    }
    let (rw, rh) = render_size(s.scale, width, height)
    if rw != s.width || rh != s.height {
        s.targets = targets(width: rw, height: rh)
        s.width = rw
        s.height = rh
    }
    let aspect = f32(width) / f32(max(height, 1))
    let half = half_view(aspect)
    let eye = framed(s.camera, half, c.ends)
    react(mut s.cast, snap, c, dt, eye, half)
    // What happened, to the voice.
    match mut s.voice {
        Some(v) => {
            for cue in s.cast.cues {
                let _ = v.push(cue)
            }
        },
        None => {},
    }
    s.cast.cues.clear()
    // Where the snacks' count is, on the plane of play: found carrots fly there. It shows while
    // playing.
    let hud_at = eye + vec2(-half.x + 1.1, half.y - 0.85)
    let count = snap.paused == 0 && !watching
    let at = vec3(eye, 0.0)
    let view_proj = ortho(-half.x, half.x, -half.y, half.y, near: 1.0, far: 100.0) *
        look_at(at + vec3(0.0, 0.0, 50.0), at)
    let px = 2.0 * half.y / f32(rh)
    var back: Vec<Sprite> = Vec::new()
    var front: Vec<Sprite> = Vec::new()
    sprites(s.cast, snap, c, time, lag, hud_at, count, mut back, mut front)
    // The ghost, behind the cast, on the player's clock.
    if !watching {
        follow_ghost(mut s, snap.course)
        if s.trail.len() > 0 {
            let t = min(snap.ticks, s.trail.len() - 1)
            if let Some(g) = ghost(s.trail[max(t, 1) - 1], s.trail[t], if t == 0 { 0.0 } else {
                lag
            }) {
                back.push(g)
            }
        }
    }
    let behind = back.len()
    for f in front {
        back.push(f)
    }
    write(mut s.sprites, 0, back)
    write(mut s.heights, 0, s.cast.waves.heights)
    hud(mut s, snap, screen, time)
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    // The signs' words, at the scene's size.
    let scene_size = vec2(f32(rw), f32(rh))
    s.sign_list.clear(scene_size)
    sign_words(
        mut s.sign_list,
        s.fonts,
        snap.course,
        s.settings.learned,
        s.device,
        eye,
        half,
        scene_size,
    )
    s.signs.upload(s.sign_list)
    let (i, level) = (snap.course, snap.course == LEVEL)
    let view = View { centre: eye, half, screen: vec2(f32(rw), f32(rh)), time }
    // How much the capybara slides and is on the ground, eased, for the grass.
    let mode = Mode::from_u32(snap.mode)
    let on = grounded(mode)
    let ease = 1.0 - exp(-dt * 10.0)
    s.presence += (if on { 1.0 } else { 0.0 } - s.presence) * ease
    s.sliding += (if mode == Some(Mode::Slide) { 1.0 } else { 0.0 } - s.sliding) * ease
    let field = Field {
        view_proj,
        feet: snap.at - snap.ground * RADIUS,
        vel: snap.vel,
        px,
        time,
        sliding: s.sliding,
        presence: s.presence,
    }
    let stage = Stage { view_proj, px, time, first: 0 }
    // The scene: the sky and the zoo behind (one pass, nearest first); the ground and its grass; the
    // cast.
    let scene = begin_pass(mut s.targets.scene)
    draw(
        scene,
        full.bind(z: 0.0),
        scenery::backdrop.bind(v: view, tops: s.tops[i].items(), g: s.grain, gs: s.repeat),
        vertices: 3,
    )
    draw(
        scene,
        earth_vertex.bind(verts: s.earths[i].items(), f: field),
        earth.bind(
            f: field,
            tops: s.tops[i].items(),
            pools: s.pools.items(),
            g: s.grain,
            gs: s.repeat,
        ),
        vertices: if level { LEVEL_EARTH.len() / 2 } else { LAB_EARTH.len() / 2 },
    )
    draw(
        scene,
        grass_vertex.bind(verts: s.grasses[i].items(), f: field),
        grass.bind(f: field),
        vertices: if level { LEVEL_GRASS.len() / 2 } else { LAB_GRASS.len() / 2 },
    )
    draw(
        scene,
        sprite_vertex.bind(sprites: s.sprites.items(), st: stage),
        sprite.bind(sprites: s.sprites.items(), st: stage),
        vertices: 6,
        instances: behind,
    )
    s.signs.draw(scene, scene_size)
    scene.end()
    // The water reads a copy of the scene, bending what's behind it; the splashes go over it.
    let copied = begin_pass(mut s.targets.below)
    draw(copied, full.bind(z: 0.0), copy.bind(src: s.targets.scene, s: s.linear), vertices: 3)
    copied.end()
    let wet = begin_pass(mut s.targets.scene, keep: true)
    let pond = Pond { view_proj, centre: eye, half, px, time }
    draw(
        wet,
        water_vertex.bind(verts: s.waters[i].items(), f: pond),
        water.bind(
            f: pond,
            pools: s.pools.items(),
            heights: s.heights.items(),
            below: s.targets.below,
            s: s.linear,
        ),
        vertices: if level { LEVEL_WATER.len() } else { LAB_WATER.len() },
    )
    let ahead = Stage { first: behind, ..stage }
    draw(
        wet,
        sprite_vertex.bind(sprites: s.sprites.items(), st: ahead),
        sprite.bind(sprites: s.sprites.items(), st: ahead),
        vertices: 6,
        instances: back.len() - behind,
    )
    wet.end()
    let out = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    let (iris, open) = cast::iris(s.cast, snap, lag)
    let page = Page {
        centre: eye,
        half,
        iris,
        screen,
        open,
        // Washed over under the pause's pages, a little under the title.
        dim: if snap.paused == 0 || watching { 0.0 } else if snap.page == TITLE { 0.35 } else {
            1.0
        },
    }
    draw(
        out,
        full.bind(z: 0.0),
        finish.bind(scene: s.targets.scene, s: s.linear, page: page),
        vertices: 3,
    )
    s.renderer.draw(out, screen)
    out.present()
    publish(mut s, snap, screen)
}

/// Text in `colour` with a soft dark shadow under it, so it reads over the sky and the ground.
fn say(s: mut Lab, face: Face, text: str, size: f32, at: vec2, colour: vec4) {
    let shadow = vec4(0.02, 0.03, 0.05, 0.55 * colour.w)
    let _ = s.list.text(s.fonts, face, text, size, at + vec2(size * 0.07), shadow)
    let _ = s.list.text(s.fonts, face, text, size, at, colour)
}

/// The course's name, as its title says it.
fn course_name(c: u32) -> Text {
    if c == LEVEL { "The Capybara Wetlands" } else { "The lab" }
}

/// The player's best any% time on course `c` (ticks), or 0 without one.
fn best(s: Lab, c: u32) -> u32 {
    let runs = s.runs.ranked(c, ANY)
    if runs.len() > 0 { runs[0].ticks } else { 0 }
}

/// What the pause's facts say of snapshot `snap`'s attempt.
fn facts_of(s: Lab, snap: Snap) -> Facts {
    borrow c = course(snap.course)
    Facts {
        name: course_name(snap.course),
        ticks: if snap.finished > 0 { snap.finished } else { snap.ticks },
        found: (snap.snacks & c.every_snack()).count_ones(),
        snacks: c.snacks.len(),
        deaths: snap.deaths,
        best: best(s, snap.course),
    }
}

/// What the frames keep up with from the sim's snapshot `live`, `dt` seconds on: the options'
/// steps taken in the menus, the music as the settings say, the moves the signs have seen made,
/// the attempt's splits against the ghost's run, and how long since it reached the goal.
fn settle(s: mut Lab, live: Snap, dt: f32) {
    match s.turns {
        Some(before) => {
            if before != live.turns && turned(mut s.settings, before, live.turns) {
                s.storing_settings.unsaved = true
            }
        },
        None => {},
    }
    s.turns = Some(live.turns)
    if s.settings.music != s.music_on {
        s.music_on = s.settings.music
        let music = Cue { kind: sound::MUSIC, amount: if s.music_on { 1.0 } else { 0.0 } }
        match mut s.voice {
            Some(v) => {
                let _ = v.push(music)
            },
            None => {},
        }
    }
    let made = learned(live)
    if made & !s.settings.learned != 0 {
        s.settings.learned = s.settings.learned | made
        s.storing_settings.unsaved = true
    }
    // The splits: at each checkpoint the attempt reaches, how far ahead or behind the ghost's run.
    if live.attempt != s.split_attempt || live.course != s.shown {
        s.split_attempt = live.attempt
        s.split_checkpoint = 0
        s.split = None
    }
    if live.checkpoint > s.split_checkpoint {
        s.split_checkpoint = live.checkpoint
        if live.checkpoint <= s.splits.len() {
            s.split = Some(i32(live.ticks) - i32(s.splits[live.checkpoint - 1]))
            s.split_age = 0.0
        }
    }
    s.split_age += dt
    if live.finished > 0 {
        if s.finish_age == 0.0 && s.trail.len() > 1 {
            s.split = Some(i32(live.finished) - i32(s.trail.len() - 1))
            s.split_age = 0.0
        }
        s.finish_age += dt
    } else {
        s.finish_age = 0.0
    }
}

/// The host's answers: its environment (whether it shows a semantic tree), and the requests done.
fn host_answers(s: mut Lab) {
    var said = None
    match mut s.environment {
        Some(p) => said = p.poll(),
        None => {},
    }
    if let Some(result) = said {
        s.environment = None
        s.capabilities = Some(match result {
            Ok(b) => host::read_environment(b).capabilities,
            Err(_) => 0,
        })
    }
    var i = 0
    while i < s.told.len() {
        if s.told[i].poll().is_some() {
            let _ = s.told.remove(i)
        } else {
            i += 1
        }
    }
}

/// The page shown as a semantic tree (screens.wrela's `tree`), if the host shows one: its items,
/// so a click, the keyboard's Tab or a screen reader can choose them; none while playing.
fn publish(s: mut Lab, snap: Snap, screen: vec2) {
    let Some(capabilities) = s.capabilities else { return }
    if capabilities & host::SEMANTICS == 0 {
        return
    }
    var nodes: Vec<Node> = Vec::new()
    if snap.paused == 1 && s.watching.is_none() {
        let page = snap.page
        if page == TITLE {
            let start = start_rect(screen)
            nodes = tree(snap.chosen, page, course_name(snap.course), ["Start"], [start])
        } else if page == MENU {
            let (_, rects) = list_rects(screen, MENU)
            nodes = tree(snap.chosen, page, "Paused", MENU_LABELS, rects)
        } else if page == OPTIONS {
            let (_, rects) = list_rects(screen, OPTIONS)
            nodes = tree(snap.chosen, page, "Options", OPTION_LABELS, rects)
        } else if page == CONTROLS {
            let (_, back) = controls_rects(screen)
            nodes = tree(snap.chosen, page, "Controls", ["Back"], [back])
        } else if page == RUNS {
            nodes = tree(snap.chosen, page, "Runs", ["Back"], [back_rect(screen)])
        }
    }
    host::publish(mut s.told, mut s.tree, "Capybara", nodes, vec4(0.0, 0.0, screen.x, screen.y))
}

/// The item of list page `page` under the pointer, while the player uses the pointer.
fn hovered(s: Lab, screen: vec2, page: u32) -> Option<u32> {
    if s.device != Device::Keys {
        return None
    }
    let (_, rects) = list_rects(screen, page)
    for i in 0..rects.len() {
        if rects[i].contains(s.pointer) {
            return Some(i)
        }
    }
    None
}

/// The screens over the page (screens.wrela). Paused: the page shown, and the prompts for it.
/// Watching a run: its bar. Playing: the title fading as the first attempt begins, the clock if
/// the options show it, the card at the goal, and with F3 the readout. (The snacks' count is
/// drawn on the plane of play, in ink: cast.wrela.)
fn hud(s: mut Lab, snap: Snap, screen: vec2, time: f32) {
    s.list.clear(screen)
    let u = unit(screen)
    let d = s.device
    if s.watching.is_some() {
        watch_bar(mut s, screen)
        return
    }
    if snap.paused == 1 {
        let page = snap.page
        if page == TITLE {
            title(
                mut s.list,
                s.fonts,
                course_name(snap.course),
                screen,
                d,
                1.0,
                waiting: true,
                time: time,
            )
        } else if page == MENU {
            let hover = hovered(s, screen, MENU)
            screens::list(
                mut s.list,
                s.fonts,
                screen,
                MENU,
                "Paused",
                MENU_LABELS,
                [],
                snap.focus,
                hover,
            )
            facts(mut s.list, s.fonts, screen, facts_of(s, snap))
            footer(
                mut s.list,
                s.fonts,
                [
                    Prompt { act: Act::Move, say: "Move" },
                    Prompt { act: Act::Choose, say: "Choose" },
                    Prompt { act: Act::Back, say: "Resume" },
                ],
                d,
                screen,
            )
        } else if page == OPTIONS {
            let hover = hovered(s, screen, OPTIONS)
            let values = option_values(s.settings)
            screens::list(
                mut s.list,
                s.fonts,
                screen,
                OPTIONS,
                "Options",
                OPTION_LABELS,
                values,
                snap.focus,
                hover,
                note: option_about(snap.focus),
            )
            footer(
                mut s.list,
                s.fonts,
                [
                    Prompt { act: Act::Move, say: "Move" },
                    Prompt { act: Act::Change, say: "Change" },
                    Prompt { act: Act::Back, say: "Back" },
                ],
                d,
                screen,
            )
        } else if page == CONTROLS {
            let (_, back) = controls_rects(screen)
            let hover = d == Device::Keys && back.contains(s.pointer)
            controls(mut s.list, s.fonts, screen, d, hover)
        } else if page == RUNS {
            runs_card(mut s, snap.course, screen)
        }
        return
    }
    // The title, fading as the first attempt begins.
    let since = f32(snap.ticks) / f32(HZ)
    if snap.attempt == 0 && since < 2.4 {
        let alpha = 1.0 - smoothstep(0.6, 2.4, since)
        title(
            mut s.list,
            s.fonts,
            course_name(snap.course),
            screen,
            d,
            alpha,
            waiting: false,
            time: time,
        )
    }
    if s.settings.clock {
        let ticks = if snap.finished > 0 { snap.finished } else { snap.ticks }
        clock(mut s.list, s.fonts, screen, ticks, snap.finished > 0, s.split, s.split_age)
    }
    if snap.finished > 0 && s.finish_age > FINISH_CARD {
        let alpha = smoothstep(FINISH_CARD, FINISH_CARD + 0.5, s.finish_age)
        goal_card(mut s.list, s.fonts, screen, facts_of(s, snap), s.best_before, d, alpha)
    }
    if s.readout {
        // The frame rate, the frame's time, and the size the scene is drawn at: native (the
        // screen's own) or the render scale's.
        let ms = s.frame_time * 1000.0
        let fps = if s.frame_time > 0.0 { 1.0 / s.frame_time } else { 0.0 }
        let at = if s.scale.value >= 1.0 { f"native" } else { f"{s.scale.value * 100.0:.0}%" }
        let readout = f"{fps:.0} fps  {ms:.1} ms  {at} {s.width}x{s.height}"
        say(
            mut s,
            Face::Mono,
            readout.as_str(),
            u * 2.1,
            vec2(u * 2.6, u * 9.0),
            vec4(1.0, 0.98, 0.94, 0.75),
        )
    }
}

// ---- runs ----------------------------------------------------------------------------------------

/// Keeps the attempt in `snap` once it reaches the goal, if it's among the player's best, and
/// stores the runs.
fn keep_finished(s: mut Lab, snap: Snap) {
    let key = snap.course << 16 | (snap.attempt & 0xffff)
    if snap.finished == 0 || key == s.kept {
        return
    }
    s.kept = key
    if let Some(r) = replay(snap, YOU) {
        if verify(r) && s.runs.add(r.clone()) {
            s.storing.unsaved = true
            s.trail_of = 0
        }
    }
}

/// How long a load or a store of the runs that failed waits before it's made again (s).
const RETRY: f32 = 2.0

/// When the runs load and are stored: whether the stored ones have been read (or there were
/// none), seconds until a request that failed is made again, and whether the runs changed since
/// they were last stored.
struct Storing: Copy {
    read: bool = false,
    retry: f32 = 0.0,
    unsaved: bool = false,
}

impl Storing {
    /// After a load: of the stored runs, or of nothing stored, they're `read`; a load that failed
    /// otherwise is made again after `RETRY`.
    fn loaded(mut self, read: bool) {
        if read {
            self.read = true
        } else {
            self.retry = RETRY
        }
    }

    /// After a store: one that failed is made again after `RETRY`, of the runs as they are then.
    fn stored(mut self, ok: bool) {
        if !ok {
            self.unsaved = true
            self.retry = RETRY
        }
    }

    /// `dt` seconds on, with a load or a store still waiting or not: whether to load the runs now,
    /// and whether to store them now (they're then no longer unsaved). Never a store before the
    /// stored runs are read: storing over runs that couldn't be read would lose them.
    fn due(mut self, dt: f32, loading: bool, saving: bool) -> (bool, bool) {
        self.retry = max(self.retry - dt, 0.0)
        if self.retry > 0.0 {
            return (false, false)
        }
        let stores = self.read && self.unsaved && !saving
        if stores {
            self.unsaved = false
        }
        (!self.read && !loading, stores)
    }
}

/// Reads the stored runs once they load, `dt` seconds after the last frame, and stores them when
/// they've changed, one store at a time, and only once the stored ones are read or are known to
/// be none (`IoError::missing`). A load or a store that failed is made again (`Storing`).
fn store_runs(s: mut Lab, dt: f32) {
    var loaded = None
    match mut s.loading {
        Some(p) => loaded = p.poll(),
        None => {},
    }
    if let Some(result) = loaded {
        s.loading = None
        match result {
            Ok(b) => {
                let mine = s.runs.clone()
                s.runs = read(b.clone())
                for r in mine.runs {
                    let _ = s.runs.add(r.clone())
                }
                s.trail_of = 0
                s.storing.loaded(read: true)
            },
            Err(e) => s.storing.loaded(read: e.missing()),
        }
    }
    var stored = None
    match mut s.saving {
        Some(p) => stored = p.poll(),
        None => {},
    }
    if let Some(result) = stored {
        s.saving = None
        s.storing.stored(ok: result.is_ok())
    }
    let (loads, stores) = s.storing.due(
        dt,
        loading: s.loading.is_some(),
        saving: s.saving.is_some(),
    )
    if loads {
        s.loading = Some(load(SAVED))
    }
    if stores {
        s.saving = Some(store(SAVED, bytes(s.runs)))
    }
}

/// Reads the stored settings once they load, and stores them when they've changed, as the runs
/// are (`store_runs`). Settings changed before the stored ones are read stay as changed.
fn store_settings(s: mut Lab, dt: f32) {
    var loaded = None
    match mut s.loading_settings {
        Some(p) => loaded = p.poll(),
        None => {},
    }
    if let Some(result) = loaded {
        s.loading_settings = None
        match result {
            Ok(b) => {
                if !s.storing_settings.unsaved {
                    s.settings = decode(b)
                } else {
                    // A move learned or a key pressed before they loaded: keep both.
                    s.settings.learned = s.settings.learned | decode(b).learned
                }
                s.trail_of = 0
                s.storing_settings.loaded(read: true)
            },
            Err(e) => s.storing_settings.loaded(read: e.missing()),
        }
    }
    var stored = None
    match mut s.saving_settings {
        Some(p) => stored = p.poll(),
        None => {},
    }
    if let Some(result) = stored {
        s.saving_settings = None
        s.storing_settings.stored(ok: result.is_ok())
    }
    let (loads, stores) = s.storing_settings.due(
        dt,
        loading: s.loading_settings.is_some(),
        saving: s.saving_settings.is_some(),
    )
    if loads {
        s.loading_settings = Some(load(SETTINGS))
    }
    if stores {
        s.saving_settings = Some(store(SETTINGS, encode(s.settings)))
    }
}

/// The runs of course `c` that count for `category` on the board shown (the player's or the
/// tool-assisted ones), fastest first.
fn listed(s: Lab, c: u32, category: u32) -> Vec<Replay> {
    if s.board == PLAYERS {
        return s.runs.ranked(c, category)
    }
    assisted(s, c, category)
}

/// The tool-assisted runs of course `c` made for `category`, fastest first.
fn assisted(s: Lab, c: u32, category: u32) -> Vec<Replay> {
    var out: Vec<Replay> = Vec::new()
    for r in s.assisted {
        // Each searched run is for one category: a 100% run isn't listed again under any%.
        let own = category == FULL || !counts(r, FULL)
        if r.course == c && counts(r, category) && own {
            out.push(r.clone())
        }
    }
    out.sort_by(|a, b| a.ticks < b.ticks)
    out
}

/// The ghost's run on course `c` (the options' ghost): the player's best any% run, or the fastest
/// any% run of the robot or of the human line.
fn ghost_run(s: Lab, c: u32) -> Option<Replay> {
    let g = s.settings.ghost
    if g == BEST_GHOST {
        let best = s.runs.ranked(c, ANY)
        if best.len() > 0 {
            return Some(best[0].clone())
        }
    } else if g == AUTOPILOT_GHOST || g == HUMAN_GHOST {
        let who = if g == HUMAN_GHOST { HUMAN } else { AUTOPILOT }
        for r in assisted(s, c, ANY) {
            if r.who == who {
                return Some(r.clone())
            }
        }
    }
    None
}

/// Who made a run, as the board and the watch name them.
fn who_name(who: u32) -> Text {
    if who == YOU {
        "You"
    } else if who == HUMAN { "Human line" } else { "Robot" }
}

/// The trail of the ghost's run on course `c`, and its splits, worked out again when the course,
/// the ghost or the player's runs change.
fn follow_ghost(s: mut Lab, c: u32) {
    let key = (c + 1) << 8 | s.settings.ghost
    if key == s.trail_of {
        return
    }
    s.trail_of = key
    s.trail = match ghost_run(s, c) {
        Some(r) => trail(r),
        None => Vec::new(),
    }
    s.splits = splits(s.trail)
}

/// The runs card's size, for the screen: its rect and its text size.
fn runs_frame(screen: vec2) -> (Rect, f32) {
    let u = unit(screen)
    let size = u * 2.9
    let w = min(screen.x - u * 6.0, size * 40.0)
    let h = size * 22.5
    (Rect::new((screen.x - w) * 0.5, (screen.y - h) * 0.5 - u * 3.0, w, h), size)
}

/// Where board `b`'s name is on the runs card, which a click chooses.
fn board_rect(screen: vec2, b: u32) -> Rect {
    let (r, size) = runs_frame(screen)
    let w = size * 8.0
    let x = r.x + r.w * 0.5 - w - size * 0.3 + f32(b) * (w + size * 0.6)
    Rect::new(x, r.y + size * 3.2, w, size * 1.6)
}

/// Where row `i` of a category's list is on the runs card.
fn row_rect(screen: vec2, category: u32, i: u32) -> Rect {
    let (r, size) = runs_frame(screen)
    let w = (r.w - size * 3.0) * 0.5
    let x = r.x + size * 1.2 + f32(category) * (w + size * 0.6)
    Rect::new(x, r.y + size * 8.0 + f32(i) * size * 1.7, w, size * 1.5)
}

/// Where the runs card's back button is.
fn back_rect(screen: vec2) -> Rect {
    let (r, size) = runs_frame(screen)
    Rect::new(r.right() - size * 6.6, r.bottom() - size * 3.0, size * 5.4, size * 2.0)
}

/// A key or click while the runs are open (the sim leaves them to the frames, and only closes the
/// page). On the board: up and down move the focus along a category's runs, left and right
/// between the categories, Tab or a controller's shoulders switch boards, and choosing a run (or a
/// click on it) watches it. Watching: Space or A pauses and plays, left and right seek, up and down
/// change the speed, and R or X starts it again.
fn browse(s: mut Lab, e: Event, c: u32, screen: vec2) {
    let nav = s.nav.nav(e)
    var watched = false
    match mut s.watching {
        Some(w) => {
            watched = true
            if device_of(e).is_some() {
                s.idle = 0.0
            }
            let again = match e {
                Event::KeyDown { key, repeat, .. } => key == Key::R && !repeat,
                Event::PadButton { pad, button, pressed, .. } => {
                    pad == 0 && pressed && button == PadButton::West
                },
                _ => false,
            }
            if again {
                w.seek(0)
                w.playing = true
            } else if nav == Some(Nav::Choose) {
                if !w.playing && w.tick >= w.end() {
                    w.seek(0)
                }
                w.playing = !w.playing
            } else if nav == Some(Nav::Right) {
                w.seek(w.tick + SEEK)
            } else if nav == Some(Nav::Left) {
                w.seek(if w.tick > SEEK { w.tick - SEEK } else { 0 })
            } else if nav == Some(Nav::Up) {
                w.speed = min(w.speed + 1, SPEEDS.len() - 1)
            } else if nav == Some(Nav::Down) {
                w.speed = if w.speed > 0 { w.speed - 1 } else { 0 }
            }
        },
        None => {},
    }
    if watched {
        return
    }
    let switch = match e {
        Event::KeyDown { key, repeat, .. } => key == Key::Tab && !repeat,
        Event::PadButton { pad, button, pressed, .. } => {
            pad == 0 &&
                pressed &&
                (button == PadButton::LeftShoulder || button == PadButton::RightShoulder)
        },
        _ => false,
    }
    if switch {
        s.board = 1 - s.board
        s.row = 0
    } else if nav == Some(Nav::Up) {
        s.row = if s.row > 0 { s.row - 1 } else { 0 }
    } else if nav == Some(Nav::Down) {
        s.row += 1
    } else if nav == Some(Nav::Left) || nav == Some(Nav::Right) {
        s.column = if nav == Some(Nav::Left) { ANY } else { FULL }
    } else if nav == Some(Nav::Choose) {
        let runs = listed(s, c, s.column)
        if runs.len() > 0 {
            let i = min(s.row, runs.len() - 1)
            open_watch(mut s, runs[i].clone())
        }
    }
    s.row = min(s.row, max(listed(s, c, s.column).len(), 1) - 1)
    if let Event::PointerDown { at, .. } = e {
        s.pointer = at
        for b in [PLAYERS, ASSISTED] {
            if board_rect(screen, b).contains(at) {
                s.board = b
                s.row = 0
            }
        }
        for category in [ANY, FULL] {
            let runs = listed(s, c, category)
            for i in 0..runs.len() {
                if row_rect(screen, category, i).contains(at) {
                    s.column = category
                    s.row = i
                    open_watch(mut s, runs[i].clone())
                }
            }
        }
    }
}

/// Watches run `r` from its start.
fn open_watch(s: mut Lab, r: take Replay) {
    s.watching = Some(watch(take r))
    s.idle = 0.0
}

/// The runs card, over the paused page: the boards, each category's runs, fastest first, who
/// made each and its time, the one with the focus washed in yuzu; a back button; and how to use
/// them.
fn runs_card(s: mut Lab, c: u32, screen: vec2) {
    let (r, size) = runs_frame(screen)
    let u = unit(screen)
    let gold = vec4(0.62, 0.42, 0.08, 1.0)
    let lit = vec4(0.94, 0.88, 0.72, 1.0)
    let yuzu = vec4(1.0, 0.84, 0.32, 1.0)
    let pointing = s.device == Device::Keys
    card(mut s.list, r, u)
    let title = if c == LEVEL { "Runs: The Capybara Wetlands" } else { "Runs: the lab" }
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        title,
        size * 1.05,
        vec2(r.x + size * 1.2, r.y + size * 1.1),
        SOFT,
    )
    // The boards' names: the one shown filled in, the other lit under the pointer.
    for b in [PLAYERS, ASSISTED] {
        let tab = board_rect(screen, b)
        let name = if b == PLAYERS { "Players" } else { "Tool-assisted" }
        if b == s.board {
            s.list.rect(tab, INKED, radius: size * 0.8)
        } else if pointing && tab.contains(s.pointer) {
            s.list.rect(tab, lit, radius: size * 0.8)
        }
        let nw = s.fonts.font(Face::Sans).measure(name, size)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            name,
            size,
            vec2(tab.x + (tab.w - nw) * 0.5, tab.y + size * 0.3),
            if b == s.board { CARD } else { INKED },
        )
    }
    for category in [ANY, FULL] {
        let head = row_rect(screen, category, 0)
        let name = if category == ANY { "Any%" } else { "100%" }
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            name,
            size * 1.1,
            vec2(head.x + size * 0.4, head.y - size * 2.0),
            INKED,
        )
        let runs = listed(s, c, category)
        if runs.len() == 0 {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                if s.board == PLAYERS { "None yet: reach the goal" } else { "None" },
                size * 0.9,
                vec2(head.x + size * 0.4, head.y + size * 0.2),
                SOFT,
            )
        }
        for i in 0..runs.len() {
            let row = row_rect(screen, category, i)
            if category == s.column && i == s.row {
                s.list.rect(row, yuzu, radius: size * 0.4)
            } else if pointing && row.contains(s.pointer) {
                s.list.rect(row, lit, radius: size * 0.4)
            }
            borrow run = runs[i]
            let who = who_name(run.who)
            let colour = if i == 0 { gold } else { INKED }
            let y = row.y + size * 0.25
            let _ = s.list.text(
                s.fonts,
                Face::Mono,
                f"{i + 1}".as_str(),
                size,
                vec2(row.x + size * 0.5, y),
                SOFT,
            )
            let _ = s.list.text(s.fonts, Face::Sans, who, size, vec2(row.x + size * 1.9, y), colour)
            let time = seconds(run.ticks)
            let tw = s.fonts.font(Face::Mono).measure(time.as_str(), size)
            let _ = s.list.text(
                s.fonts,
                Face::Mono,
                time.as_str(),
                size,
                vec2(row.x + row.w - tw - size * 0.5, y),
                colour,
            )
        }
    }
    let back = back_rect(screen)
    s.list.rect(back, if pointing && back.contains(s.pointer) { lit } else {
        yuzu
    }, radius: size * 0.5)
    let bw = s.fonts.font(Face::Sans).measure("Back", size)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        "Back",
        size,
        vec2(back.x + (back.w - bw) * 0.5, back.y + size * 0.35),
        INKED,
    )
    footer(
        mut s.list,
        s.fonts,
        [
            Prompt { act: Act::Choose, say: "Watch" },
            Prompt { act: Act::Boards, say: "Boards" },
            Prompt { act: Act::Back, say: "Back" },
        ],
        s.device,
        screen,
    )
}

/// Watching: a bar at the foot of the page, as a video player's: who made the run, its category
/// and its time; whether it plays; how far through it is; its speed; and for a few seconds after
/// the last key, the prompts.
fn watch_bar(s: mut Lab, screen: vec2) {
    let u = unit(screen)
    let size = u * 2.6
    let (label, tick, end, playing, speed) = match s.watching {
        Some(w) => {
            let who = who_name(w.replay.who)
            let category = if counts(w.replay, FULL) { "100%" } else { "Any%" }
            (f"{who}  ·  {category}", w.tick, w.end(), w.playing, SPEEDS[w.speed])
        },
        None => return,
    }
    let w = min(screen.x - u * 6.0, u * 110.0)
    let r = Rect::new((screen.x - w) * 0.5, screen.y - u * 13.0, w, u * 8.6)
    card(mut s.list, r, u * 0.8, 0.94)
    // Play or pause.
    let c = vec2(r.x + u * 4.6, r.y + r.h * 0.5)
    let a = u * 1.6
    if playing {
        s.list.rect(Rect::new(c.x - a * 0.8, c.y - a, a * 0.55, a * 2.0), INKED, radius: u * 0.2)
        s.list.rect(Rect::new(c.x + a * 0.25, c.y - a, a * 0.55, a * 2.0), INKED, radius: u * 0.2)
    } else {
        s.list.triangle(
            vec2(c.x - a * 0.7, c.y - a),
            vec2(c.x + a, c.y),
            vec2(c.x - a * 0.7, c.y + a),
            INKED,
        )
    }
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        label.as_str(),
        size,
        vec2(r.x + u * 8.6, r.y + u * 1.4),
        INKED,
    )
    // How far through: a line, the part played inked.
    let left = r.x + u * 8.6
    let right = r.right() - u * 22.0
    let y = r.y + u * 6.0
    let done = left + (right - left) * saturate(f32(tick) / f32(max(end, 1)))
    s.list.line(vec2(left, y), vec2(right, y), vec4(INK, 0.25), width: u * 0.6)
    s.list.line(vec2(left, y), vec2(done, y), INKED, width: u * 0.6)
    s.list.ellipse(Rect::new(done - u * 0.9, y - u * 0.9, u * 1.8, u * 1.8), INKED)
    let run = end_of(s)
    let time = f"{seconds(min(tick, run))} / {seconds(run)}"
    let _ = s.list.text(
        s.fonts,
        Face::Mono,
        time.as_str(),
        size,
        vec2(right + u * 2.0, r.y + u * 1.4),
        INKED,
    )
    let _ = s.list.text(
        s.fonts,
        Face::Mono,
        f"{speed}x".as_str(),
        size,
        vec2(right + u * 2.0, r.y + u * 4.8),
        SOFT,
    )
    let alpha = 1.0 - smoothstep(IDLE, IDLE + 0.5, s.idle)
    if alpha > 0.0 {
        let _ = screens::prompts(
            mut s.list,
            s.fonts,
            [
                Prompt { act: Act::Choose, say: "Play" },
                Prompt { act: Act::Change, say: "Seek" },
                Prompt { act: Act::Move, say: "Speed" },
                Prompt { act: Act::Again, say: "Again" },
                Prompt { act: Act::Back, say: "Back" },
            ],
            s.device,
            vec2(screen.x * 0.5, r.y - u * 5.0),
            u * 3.6,
            alpha,
            backed: true,
        )
    }
}

/// The watched run's time (ticks), or 0.
fn end_of(s: Lab) -> u32 {
    match s.watching {
        Some(w) => w.replay.ticks,
        None => 0,
    }
}

/// The capybara's middle (x, y, m), its speed (m/s) and its mode, as the newest snapshot has them,
/// for `wrela trace --watch capybara`.
pub fn capybara(s: mut Lab) -> vec4 {
    let n = s.snaps.newest().snap
    vec4(n.at, length(n.vel), f32(n.mode))
}

// ---- tests -------------------------------------------------------------------------------------

/// Three seconds of the run script on the hardware GPU: the level draws, with its foes and things,
/// and the sim, ticking in lockstep, plays it, from the title it opens on (the script's Enter).
@test(frames: 180, gpu: true, input: scripts::RUN)
fn the_level_draws_and_its_sim_runs(s: Lab) {
    let n = s.snaps.newest()
    assert(n.ticks >= 358, "the ticker runs two ticks a frame")
    assert(n.snap.course == LEVEL && n.snap.paused == 0, "the level, playing")
    // Its clock is three ticks behind the ticks run: frame 0's two stood on the title the game
    // opens on, and the tick of the script's Enter (frame 1) left it without stepping.
    assert(n.snap.ticks + 3 == n.ticks, "its clock running")
    // The test's storage is empty: the stored runs are read as none, so new ones may be stored.
    assert(
        s.storing.read && s.loading.is_none() && s.runs.runs.len() == 0,
        "nothing stored is no runs",
    )
}

@test
fn a_load_or_a_store_that_failed_is_made_again_after_a_wait() {
    var st = Storing {}
    assert(st.due(0.016, loading: true, saving: false) == (false, false), "the first load waits")
    st.loaded(read: false)
    assert(st.due(1.0, loading: false, saving: false) == (false, false), "a failed load waits")
    assert(st.due(1.0, loading: false, saving: false) == (true, false), "then loads again")
    // A run kept before the stored ones are read isn't stored over them.
    st.unsaved = true
    assert(st.due(0.016, loading: true, saving: false) == (false, false))
    st.loaded(read: true)
    assert(st.due(0.016, loading: false, saving: false) == (false, true), "stored once read")
    assert(!st.unsaved)
    // Another run kept while that store waits is stored after it, and a failed store again.
    st.unsaved = true
    assert(st.due(0.016, loading: false, saving: true) == (false, false), "one store at a time")
    st.stored(ok: true)
    assert(st.due(0.016, loading: false, saving: false) == (false, true), "the newer runs")
    st.stored(ok: false)
    assert(st.unsaved, "a failed store's runs are unsaved again")
    assert(st.due(1.0, loading: false, saving: false) == (false, false), "and wait")
    assert(st.due(1.0, loading: false, saving: false) == (false, true), "then are stored again")
}

use world::{present, world}

@test
fn a_frame_isnt_drawn_between_two_places_across_a_cut() {
    // Thirty metres on, then back at the start: a frame halfway between draws the capybara at the
    // start if a cut came between (a restart, a comeback), and halfway if none did.
    let start = course(LEVEL).start
    var a = present(world(LEVEL))
    a.at = start + vec2(30.0, 0.0)
    var b = present(world(LEVEL))
    b.tally.cuts = 1
    assert(mixed(a, b, 0.5).at == start, "across a cut")
    b.tally.cuts = 0
    assert(mixed(a, b, 0.5).at == start + vec2(15.0, 0.0), "without one")
}
