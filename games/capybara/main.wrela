// The capybara game (a working title; design.md is its brief): the first level, and the movement
// lab beside it. The sim ticks 120 times a second on the ticker's thread (`engine::run`), and each
// frame draws the snapshots round its time as a flat 2D blockout, seen straight on: the clouds
// and two ranges of hills behind at their own parallax, the course's ground, the capybara, its
// foes, the snacks, yuzus, checkpoints and goal as boxes, the water over them, and a line of text
// with the clock, the snacks and the speed.
//
// Keys: the arrows or W A S D to move (down slides or crouches; in water up and down swim, and
// in turn dolphin kick), Space, Z or K to jump (again in the air for the double jump; in water,
// a kick), R to restart, Tab for the other course (the level or the lab). A controller: the
// stick or pad, South or East to jump, Start to restart, Select for the other course.
//
// For an agent: `wrela-host <build> --frames n --input script.json --png out.png` draws frame n
// on the GPU (scripts.wrela has scripts), and `capybara` exports the capybara's state for `wrela
// trace --watch capybara`, which needs a toolchain whose trace runs the ticker in lockstep.

use body::Mode
use camera::{Camera, camera, follow, half_view}
use course::{Course, course}
use engine::present::Snapshots
use engine::run::run
use feel::HZ
use feel::FEEL
use look::{
    CLOUDS, CLOUD_PARALLAX, FAR_HILLS, FAR_PARALLAX, LAB_GROUND, LAB_WATER, LEVEL_GROUND,
    LEVEL_WATER, NEAR_HILLS, NEAR_PARALLAX, PLAY_Z, Eye, Part, cel, ground_vertex, part_vertex,
    water, water_vertex,
}
use std::gpu::{
    Cull, DepthTexture, GpuBuffer, begin_screen_pass_with_depth, buffer, buffer_of, depth_texture,
    draw, write,
}
use std::math::{PI, TAU}
use std::transform::{look_at, ortho, rotate_x, rotate_y, rotate_z, scale, translate}
use ui::draw::{DrawList, Renderer}
use ui::text::{Face, Fonts}
use world::{LEVEL, Snap, present, tick, world}

/// The most boxes drawn: the capybara's, the foes', the things' and the goal's.
const PARTS: u32 = 256

pub struct Lab {
    snaps: Snapshots<Snap>,
    /// Each course's ground and water (the lab's, the level's), and the hills behind both.
    grounds: [GpuBuffer<vec4>; 2],
    waters: [GpuBuffer<vec4>; 2],
    /// The parallax layers: the near hills, the far hills, the clouds.
    layers: [GpuBuffer<vec4>; 3],
    /// The course the camera was last following.
    shown: u32,
    parts: GpuBuffer<Part>,
    depth: DepthTexture,
    width: u32,
    height: u32,
    camera: Camera,
    /// The gait's phase (rad): a stride per `STRIDE` m on the ground, a steady paddle in water.
    stride: f32,
    last: Option<f32>,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
}

pub fn init() -> Lab {
    let latest = run(world(LEVEL), hz: HZ, step: tick, present: present)
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    Lab {
        snaps: Snapshots::new(take latest, hz: HZ),
        grounds: [buffer_of(LAB_GROUND), buffer_of(LEVEL_GROUND)],
        waters: [buffer_of(LAB_WATER), buffer_of(LEVEL_WATER)],
        layers: [buffer_of(NEAR_HILLS), buffer_of(FAR_HILLS), buffer_of(CLOUDS)],
        shown: LEVEL,
        parts: buffer(PARTS),
        depth: depth_texture(width: 1, height: 1),
        width: 0,
        height: 0,
        camera: camera(course(LEVEL).start),
        stride: 0.0,
        last: None,
        fonts,
        renderer,
        list: DrawList::new(),
    }
}

/// The snapshot a frame draws: the two round its time, the capybara's middle and velocity
/// between them, the rest the later one's.
fn drawn(s: Snapshots<Snap>, time: f32) -> Snap {
    let b = s.at(s.sim_time(time))
    var snap = b.b
    snap.at = mix(b.a.at, b.b.at, vec2(b.alpha))
    snap.vel = mix(b.a.vel, b.b.vel, vec2(b.alpha))
    snap
}

// ---- the capybara and the goal -----------------------------------------------------------------

const FUR = vec4(0.45, 0.29, 0.16, 1.0)
const DARK = vec4(0.1, 0.07, 0.05, 1.0)
const SNOUT = vec4(0.33, 0.21, 0.12, 1.0)
const POST = vec4(0.85, 0.82, 0.75, 1.0)
const FLAG = vec4(0.95, 0.7, 0.2, 1.0)

/// A box from `centre` with half-sizes `half`, in the frame `frame`.
fn part(frame: mat4, centre: vec3, half: vec3, colour: vec4) -> Part {
    Part { model: frame * translate(centre) * scale(half), colour }
}

/// How far the capybara goes in one stride of its trot (m).
const STRIDE: f32 = 0.9

/// The capybara's boxes: a loaf of a body, a square head and snout, ears, eyes and short legs, in
/// its body's frame (x forward, y up, the collider's middle at the origin). It leans with the
/// ground, or with its velocity off it; it squashes as it slides, crouches or tucks. Walking, it
/// trots at the gait's phase `stride`: diagonal legs together, swinging and lifting, the body
/// bobbing, all by how fast it goes; sliding, its legs splay; in the air they tuck; in water they
/// paddle. Its fur darkens while it's wet.
fn capybara_parts(out: mut Vec<Part>, s: Snap, stride: f32) {
    let mode = Mode::from_u32(s.mode)
    let grounded = mode == Some(Mode::Walk) ||
        mode == Some(Mode::Crouch) ||
        mode == Some(Mode::Slide)
    let lean = if grounded {
        atan2(-s.ground.x, s.ground.y)
    } else if mode == Some(Mode::Swim) {
        clamp(s.vel.y * 0.08, -0.6, 0.6) * s.facing
    } else {
        clamp(s.vel.y * 0.03, -0.4, 0.4) * s.facing
    }
    // After a double jump it flips once, nose up and over, in half a second.
    let flip = if s.flip > 0 { -TAU * saturate(f32(s.flip) / f32(HZ / 2)) } else { 0.0 }
    let low = mode == Some(Mode::Crouch) || mode == Some(Mode::Slide) || (!grounded && s.tuck == 1)
    let squash = if low { vec3(1.12, 0.72, 1.0) } else { vec3(1.0) }
    let trotting = mode == Some(Mode::Walk)
    let pace = if trotting { saturate(abs(s.speed) / 6.0) } else { 0.0 }
    let bob = 0.045 * pace * abs(sin(stride))
    let pitch = 0.05 * pace * sin(2.0 * stride)
    let frame = translate(vec3(s.at + vec2(0.0, bob), PLAY_Z)) *
        rotate_z(lean + flip * s.facing + pitch * s.facing) *
        scale(vec3(s.facing, 1.0, 1.0) * squash)
    let wet = saturate(f32(s.wet) / (f32(FEEL.wet_ticks) * 0.5))
    let fur = vec4(FUR.xyz * (1.0 - 0.3 * wet), 1.0)
    out.push(part(frame, vec3(0.0, 0.0, 0.0), vec3(0.45, 0.24, 0.25), fur))
    out.push(
        part(
            frame,
            vec3(0.46, 0.1 + 0.02 * pace * sin(2.0 * stride + 1.0), 0.0),
            vec3(0.19, 0.17, 0.18),
            fur,
        ),
    )
    out.push(part(frame, vec3(0.66, 0.04, 0.0), vec3(0.07, 0.11, 0.14), SNOUT))
    if s.yuzu == 1 {
        // The yuzu on its head, as capybaras in hot springs wear them.
        out.push(part(frame, vec3(0.42, 0.38, 0.0), vec3(0.11, 0.11, 0.11), YUZU))
    }
    for z in [-0.11, 0.11] {
        out.push(part(frame, vec3(0.38, 0.3, z), vec3(0.04, 0.04, 0.03), DARK))
        out.push(part(frame, vec3(0.58, 0.16, z * 1.6), vec3(0.025, 0.025, 0.012), DARK))
    }
    for x in [-0.3, 0.3] {
        for z in [-0.15, 0.15] {
            // Diagonal legs move together.
            let phase = stride + if (x > 0.0) == (z > 0.0) { 0.0 } else { PI }
            let reach = if x > 0.0 { 1.0 } else { -1.0 }
            let leg = if mode == Some(Mode::Slide) {
                vec2(0.12 * reach, 0.07)
            } else if mode == Some(Mode::Air) {
                vec2(-0.08 * reach, 0.08)
            } else if mode == Some(Mode::Swim) {
                vec2(0.1 * sin(phase), 0.05 * cos(phase))
            } else if mode == Some(Mode::Crouch) {
                vec2(0.0, 0.05)
            } else {
                vec2(0.11 * pace * sin(phase), 0.08 * pace * max(cos(phase), 0.0))
            }
            out.push(part(frame, vec3(x + leg.x, -0.27 + leg.y, z), vec3(0.06, 0.08, 0.06), SNOUT))
        }
    }
}

/// The goal: a post and its flag, at the goal box's left side, standing on its floor.
fn goal(out: mut Vec<Part>, c: Course) {
    let base = vec3(c.goal_lo.x + 0.4, c.goal_lo.y, PLAY_Z)
    let frame = translate(base)
    out.push(part(frame, vec3(0.0, 1.6, 0.0), vec3(0.06, 1.6, 0.06), POST))
    out.push(part(frame, vec3(0.45, 2.85, 0.0), vec3(0.4, 0.28, 0.03), FLAG))
}

const WHITE = vec4(0.92, 0.9, 0.86, 1.0)
const BEAK = vec4(0.95, 0.55, 0.12, 1.0)
const GREY = vec4(0.52, 0.55, 0.6, 1.0)
const CAIMAN = vec4(0.25, 0.36, 0.2, 1.0)
const SNACK = vec4(0.95, 0.5, 0.1, 1.0)
const LEAF = vec4(0.3, 0.6, 0.2, 1.0)
const YUZU = vec4(0.98, 0.84, 0.2, 1.0)
const FLAG_DONE = vec4(0.35, 0.75, 0.35, 1.0)
const FLAG_AHEAD = vec4(0.6, 0.6, 0.62, 1.0)

/// The foes as boxes: a goose (a white body, a neck, a head and an orange beak), a pigeon (grey,
/// its wings flapping), a caiman (long and green, its snout forward). Knocked out, one tumbles up
/// and away for half a second.
fn foes_parts(out: mut Vec<Part>, s: Snap, time: f32) {
    for f in s.foes {
        let kind = u32(abs(f.z) + 0.5)
        if kind == 0 {
            continue
        }
        let knocked = f.z < 0.0
        let since = if knocked { f.w } else { 0.0 }
        if knocked && since > 60.0 {
            continue
        }
        let dir = if knocked { 1.0 } else { f.w }
        let t = since / f32(HZ)
        let tumble = translate(vec3(0.0, 6.0 * t - 20.0 * t * t, 0.0)) * rotate_z(since * 0.25)
        let frame = translate(vec3(f.xy, PLAY_Z)) * tumble * scale(vec3(dir, 1.0, 1.0))
        if kind == 1 {
            out.push(part(frame, vec3(0.0, -0.08, 0.0), vec3(0.42, 0.24, 0.24), WHITE))
            out.push(part(frame, vec3(0.27, 0.25, 0.0), vec3(0.07, 0.22, 0.07), WHITE))
            out.push(part(frame, vec3(0.34, 0.47, 0.0), vec3(0.13, 0.09, 0.09), WHITE))
            out.push(part(frame, vec3(0.5, 0.45, 0.0), vec3(0.08, 0.03, 0.05), BEAK))
            let step = sin(time * 14.0) * 0.08
            out.push(part(frame, vec3(-0.08 + step, -0.38, 0.1), vec3(0.03, 0.09, 0.03), BEAK))
            out.push(part(frame, vec3(-0.08 - step, -0.38, -0.1), vec3(0.03, 0.09, 0.03), BEAK))
        } else if kind == 2 {
            out.push(part(frame, vec3(0.0, 0.0, 0.0), vec3(0.3, 0.17, 0.17), GREY))
            out.push(part(frame, vec3(0.3, 0.1, 0.0), vec3(0.11, 0.1, 0.1), GREY))
            out.push(part(frame, vec3(0.43, 0.08, 0.0), vec3(0.05, 0.03, 0.03), BEAK))
            let flap = sin(time * 22.0) * 0.6
            for z in [-1.0, 1.0] {
                let wing = frame * translate(vec3(0.0, 0.1, 0.17 * z)) * rotate_x(flap * z)
                out.push(part(wing, vec3(0.0, 0.0, 0.25 * z), vec3(0.18, 0.02, 0.25), GREY))
            }
        } else {
            out.push(part(frame, vec3(0.0, 0.0, 0.0), vec3(0.9, 0.2, 0.3), CAIMAN))
            out.push(part(frame, vec3(1.15, -0.05, 0.0), vec3(0.35, 0.09, 0.2), CAIMAN))
            out.push(part(frame, vec3(-1.15, -0.05, 0.0), vec3(0.4, 0.08, 0.12), CAIMAN))
            for z in [-0.15, 0.15] {
                out.push(part(frame, vec3(0.8, 0.22, z), vec3(0.06, 0.05, 0.05), DARK))
            }
        }
    }
}

/// The snacks still to find (little carrots, bobbing), the yuzus still to take, and each
/// checkpoint's flag: green once reached, grey ahead.
fn things_parts(out: mut Vec<Part>, s: Snap, c: Course, time: f32) {
    let bob = vec3(0.0, 0.08 * sin(time * 3.0), 0.0)
    for i in 0..c.snacks.len() {
        if s.snacks & (1 << i) == 0 {
            let frame = translate(vec3(c.snacks[i], PLAY_Z) + bob) * rotate_y(time * 2.0)
            out.push(part(frame, vec3(0.0, 0.0, 0.0), vec3(0.09, 0.25, 0.09), SNACK))
            out.push(part(frame, vec3(0.0, 0.3, 0.0), vec3(0.06, 0.08, 0.06), LEAF))
        }
    }
    for i in 0..c.yuzus.len() {
        if s.yuzus & (1 << i) == 0 {
            let frame = translate(vec3(c.yuzus[i], PLAY_Z) + bob) * rotate_y(time)
            out.push(part(frame, vec3(0.0, 0.0, 0.0), vec3(0.2, 0.2, 0.2), YUZU))
            out.push(part(frame, vec3(0.0, 0.24, 0.0), vec3(0.06, 0.05, 0.03), LEAF))
        }
    }
    for i in 0..c.checkpoints.len() {
        let frame = translate(vec3(c.checkpoints[i], PLAY_Z))
        let colour = if s.checkpoint > i { FLAG_DONE } else { FLAG_AHEAD }
        out.push(part(frame, vec3(0.0, 1.2, 0.0), vec3(0.05, 1.2, 0.05), POST))
        out.push(part(frame, vec3(0.35, 2.1, 0.0), vec3(0.3, 0.22, 0.03), colour))
    }
}

// ---- the frame ---------------------------------------------------------------------------------

const SUN = vec3(0.45, 0.8, 0.4)
const SKY = vec4(0.6, 0.78, 0.92, 1.0)

pub fn frame(s: mut Lab, time: f32, width: u32, height: u32) {
    let dt = match s.last {
        Some(before) => clamp(time - before, 0.0, 0.1),
        None => 0.0,
    }
    s.last = Some(time)
    s.snaps.update()
    let snap = drawn(s.snaps, time)
    borrow c = course(snap.course)
    if snap.course != s.shown {
        s.camera = camera(c.start)
        s.shown = snap.course
    }
    follow(mut s.camera, snap, dt)
    let mode = Mode::from_u32(snap.mode)
    if mode == Some(Mode::Swim) {
        s.stride += dt * 9.0
    } else if mode == Some(Mode::Walk) {
        s.stride += abs(snap.speed) * dt / STRIDE * TAU
    }
    s.stride = s.stride % TAU
    if width != s.width || height != s.height {
        s.depth = depth_texture(width, height)
        s.width = width
        s.height = height
    }
    let aspect = f32(width) / f32(max(height, 1))
    let at = vec3(s.camera.at, 0.0)
    let from = at + vec3(0.0, 0.0, 50.0)
    let half = half_view(aspect)
    let eye = Eye {
        view_proj: ortho(-half.x, half.x, -half.y, half.y, near: 1.0, far: 100.0) *
            look_at(from, at),
        eye: from,
        sun: normalize(SUN),
    }
    var parts: Vec<Part> = Vec::new()
    // Hurt and not to be hurt again for a moment, it blinks.
    if snap.grace == 0 || (snap.grace / 6) % 2 == 0 {
        capybara_parts(mut parts, snap, s.stride)
    }
    foes_parts(mut parts, snap, time)
    things_parts(mut parts, snap, c, time)
    goal(mut parts, c)
    write(mut s.parts, 0, parts)
    let screen = vec2(f32(width), f32(height))
    hud(mut s, snap, screen)
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    let pass = begin_screen_pass_with_depth(mut s.depth, clear: SKY)
    // Behind, back to front: each layer moved by the part of the camera's motion it doesn't follow.
    let layers = [
        (2, CLOUD_PARALLAX, CLOUDS.len()),
        (1, FAR_PARALLAX, FAR_HILLS.len()),
        (0, NEAR_PARALLAX, NEAR_HILLS.len()),
    ]
    for (i, parallax, count) in layers {
        draw(
            pass,
            ground_vertex.bind(
                verts: s.layers[i].items(),
                eye: eye,
                shift: s.camera.at * (1.0 - parallax),
            ),
            cel.bind(eye: eye),
            vertices: count / 2,
            cull: Cull::None,
        )
    }
    draw(
        pass,
        ground_vertex.bind(verts: s.grounds[snap.course].items(), eye: eye, shift: vec2(0.0)),
        cel.bind(eye: eye),
        vertices: if snap.course == LEVEL { LEVEL_GROUND.len() / 2 } else { LAB_GROUND.len() / 2 },
        cull: Cull::None,
    )
    draw(
        pass,
        part_vertex.bind(parts: s.parts.items(), eye: eye),
        cel.bind(eye: eye),
        vertices: 36,
        instances: parts.len(),
        cull: Cull::None,
    )
    draw(
        pass,
        water_vertex.bind(verts: s.waters[snap.course].items(), eye: eye),
        water,
        vertices: if snap.course == LEVEL { LEVEL_WATER.len() } else { LAB_WATER.len() },
        cull: Cull::None,
    )
    s.renderer.draw(pass, screen)
    pass.present()
}

/// Ticks as seconds, to the hundredth.
fn seconds(ticks: u32) -> String {
    let hundredths = ticks * 100 / HZ
    let tail = hundredths % 100
    let pad = if tail < 10 { "0" } else { "" }
    f"{hundredths / 100}.{pad}{tail}"
}

fn hud(s: mut Lab, snap: Snap, screen: vec2) {
    s.list.clear(screen)
    let size = max(screen.y * 0.03, 12.0)
    let pad = size
    let ink = vec4(0.08, 0.1, 0.14, 1.0)
    let soft = vec4(0.08, 0.1, 0.14, 0.7)
    borrow c = course(snap.course)
    let name = if snap.course == LEVEL { "THE ZOO'S ENTRANCE" } else { "THE LAB" }
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        f"{name}   R: restart   Tab: the other course".as_str(),
        size,
        vec2(pad),
        ink,
    )
    if c.snacks.len() > 0 {
        let found = (snap.snacks & ((1 << c.snacks.len()) - 1)).count_ones()
        let yuzu = if snap.yuzu == 1 { "   YUZU" } else { "" }
        let things = f"snacks {found}/{c.snacks.len()}   back {snap.deaths}{yuzu}"
        let _ = s.list.text(s.fonts, Face::Mono, things.as_str(), size, vec2(pad, pad * 2.4), ink)
    }
    let clock = seconds(if snap.finished > 0 { snap.finished } else { snap.ticks })
    let time = if snap.finished > 0 {
        f"GOAL  {clock} s  ({snap.finished} ticks)"
    } else {
        f"{clock} s"
    }
    let _ = s.list.text(s.fonts, Face::Mono, time.as_str(), size, vec2(screen.x * 0.62, pad), ink)
    let mode = match Mode::from_u32(snap.mode) {
        Some(Mode::Walk) => "walk",
        Some(Mode::Crouch) => "crouch",
        Some(Mode::Slide) => "slide",
        Some(Mode::Air) => "air",
        Some(Mode::Swim) => "swim",
        None => "?",
    }
    let speed = length(snap.vel)
    let hint = if mode == "swim" {
        "   jump to kick, up to swim up, up and down in turn to dolphin kick"
    } else { "" }
    let hint = if snap.wet > 0 && mode != "swim" { "   wet: faster" } else { hint }
    let line = f"{mode}   {speed:.1} m/s{hint}"
    let _ = s.list.text(
        s.fonts,
        Face::Mono,
        line.as_str(),
        size * 0.85,
        vec2(pad, screen.y - pad * 2.2),
        soft,
    )
}

/// The capybara's middle (x, y, m), its speed (m/s) and its mode, as the newest snapshot has them,
/// for `wrela trace --watch capybara`.
pub fn capybara(s: mut Lab) -> vec4 {
    let n = s.snaps.newest().snap
    vec4(n.at, length(n.vel), f32(n.mode))
}

// ---- tests -------------------------------------------------------------------------------------

/// Three seconds of the run script on the hardware GPU: the level draws, with its foes and things,
/// and the sim, ticking in lockstep, plays it.
@test(frames: 180, gpu: true, input: scripts::RUN)
fn the_level_draws_and_its_sim_runs(s: Lab) {
    let n = s.snaps.newest()
    assert(n.ticks >= 358, "the ticker runs two ticks a frame")
    assert(n.snap.course == LEVEL && n.snap.ticks >= 358, "the level, its clock running")
}
