// The capybara game (a working title; design.md is its brief): the first level, and the movement
// lab beside it. The sim ticks 120 times a second on the ticker's thread (`engine::run`), and each
// frame draws the snapshots round its time in flat 2D, seen straight on (art.wrela has the
// passes): the sky and the zoo behind (scenery.wrela), the ground and its grass (earth.wrela),
// the cast and its particles (cast.wrela, sprites.wrela, dust.wrela), the water (waves.wrela),
// and the HUD: the snacks found, the clock, the course and the keys. The music (music.wrela)
// and the game's sounds (sound.wrela) start on the first frame.
//
// The game opens paused, on a card of the controls (Esc or P pauses again). F3 shows the frame rate
// and the render scale. Keys: the arrows or W A S D to move (down slides or
// crouches; in water up and down swim, and in turn dolphin kick), Space, Z or K to jump (again in
// the air for the double jump; in water, a kick), R to restart, Tab for the other course (the level
// or the lab). A controller: the stick or pad, South or East to jump, Start to restart, Select for
// the other course.
//
// For an agent: `wrela-host <build> --frames n --input script.json --png out.png` draws frame n
// on the GPU (scripts.wrela has scripts), and `capybara` exports the capybara's state for `wrela
// trace --watch capybara`, which needs a toolchain whose trace runs the ticker in lockstep.

use art::{Page, Scale, Targets, copy, finish, grain_texture, pace, render_size, targets}
use body::Mode
use camera::{Camera, camera, follow, framed, half_view}
use cast::{Cast, cast, react, sprites}
use course::course
use earth::{
    LAB_EARTH, LAB_GRASS, LEVEL_EARTH, LEVEL_GRASS, Field, earth, earth_vertex, grass, grass_vertex,
    profile,
}
use engine::plant::full
use engine::present::Snapshots
use engine::run::run
use feel::HZ
use scenery::View
use sound::Cue
use std::audio::RingWriter
use sprites::{Sprite, Stage, sprite, sprite_vertex}
use std::gpu::{
    Address, GpuBuffer, Rgba16Float, Sampler, Texture, begin_pass, begin_screen_pass, buffer,
    buffer_of, draw, sampler, write,
}
use std::transform::{look_at, ortho}
use ui::draw::{DrawList, Rect, Renderer}
use std::input::{Event, Key, events}
use ui::text::{Face, Fonts}
use waves::{COLUMNS, LAB_WATER, LEVEL_WATER, Pond, water, water_vertex}
use world::{LAB, LEVEL, Snap, present, tick, world}

/// The most sprites drawn: the cast's and the particles'.
const SPRITES: u32 = 1024

pub struct Lab {
    snaps: Snapshots<Snap>,
    /// Each course's ground, grass, water and the top of its ground (the lab's, the level's).
    earths: [GpuBuffer<vec4>; 2],
    grasses: [GpuBuffer<vec4>; 2],
    waters: [GpuBuffer<vec4>; 2],
    tops: [GpuBuffer<f32>; 2],
    /// The shown course's pools and its waves' heights.
    pools: GpuBuffer<vec4>,
    heights: GpuBuffer<f32>,
    sprites: GpuBuffer<Sprite>,
    /// The course the camera was last following, and its cast.
    shown: u32,
    cast: Cast,
    targets: Targets,
    linear: Sampler,
    /// The baked grain (ink.wrela) and the sampler that repeats it.
    grain: Texture<Rgba16Float>,
    repeat: Sampler,
    /// The scene's size (px) at the render scale, and the scale.
    width: u32,
    height: u32,
    scale: Scale,
    camera: Camera,
    last: Option<f32>,
    /// Whether the voice has started (on the first frame), and the ring to it (sound.wrela):
    /// none until it has.
    playing: bool,
    voice: Vec<RingWriter<Cue>>,
    /// Whether the readout shows (F3): the frame rate, the frame's time and the render scale. The
    /// frames' time (s), smoothed, for it.
    readout: bool,
    /// How much the capybara is on the ground and slides, eased (earth.wrela's `Field`).
    presence: f32,
    sliding: f32,
    frame_time: f32,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
}

pub fn init() -> Lab {
    let latest = run(world(LEVEL), hz: HZ, step: tick, present: present)
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    let shown = cast(course(LEVEL))
    Lab {
        snaps: Snapshots::new(take latest, hz: HZ),
        earths: [buffer_of(LAB_EARTH), buffer_of(LEVEL_EARTH)],
        grasses: [buffer_of(LAB_GRASS), buffer_of(LEVEL_GRASS)],
        waters: [buffer_of(LAB_WATER), buffer_of(LEVEL_WATER)],
        tops: [buffer_of(profile(course(LAB))), buffer_of(profile(course(LEVEL)))],
        pools: buffer_of(shown.waves.pools, at_least: 8),
        heights: buffer(COLUMNS),
        sprites: buffer(SPRITES),
        shown: LEVEL,
        cast: shown,
        targets: targets(width: 4, height: 4),
        linear: sampler(),
        grain: grain_texture(),
        repeat: sampler(address: Address::Repeat),
        width: 0,
        height: 0,
        scale: Scale {},
        camera: camera(course(LEVEL).start),
        last: None,
        playing: false,
        voice: Vec::new(),
        readout: false,
        presence: 1.0,
        sliding: 0.0,
        frame_time: 0.0,
        fonts,
        renderer,
        list: DrawList::new(),
    }
}

/// The snapshot a frame draws, from the two round its time. Everything that moves is drawn between them, so motion is continuous at any refresh rate,
/// whatever the sim's: the capybara's middle, velocity, speed and the ground's normal under it, and
/// each foe's middle (and how long since it was knocked out). Its counters (a flip's ticks, a
/// death's) are the later snapshot's, and `lag` says how far before it the frame falls (ticks, 0
/// to 1), so they can be drawn between too. Where a foe has jumped (back to its start when the
/// capybara comes back), or changed whether it's knocked out, it isn't blended.
fn drawn(s: Snapshots<Snap>, time: f32) -> (Snap, f32) {
    let b = s.at(s.sim_time(time))
    let t = b.alpha
    var snap = b.b
    snap.at = mix(b.a.at, b.b.at, vec2(t))
    snap.vel = mix(b.a.vel, b.b.vel, vec2(t))
    snap.speed = mix(b.a.speed, b.b.speed, t)
    let n = mix(b.a.ground, b.b.ground, vec2(t))
    if length(n) > 1.0e-3 {
        snap.ground = normalize(n)
    }
    for i in 0..snap.foes.len() {
        let (f, g) = (b.a.foes[i], b.b.foes[i])
        if sign(f.z) == sign(g.z) && distance(f.xy, g.xy) < 1.0 {
            snap.foes[i] = vec4(mix(f.xy, g.xy, vec2(t)), g.z, if g.z < 0.0 {
                mix(f.w, g.w, t)
            } else { g.w })
        }
    }
    (snap, if b.b.ticks > b.a.ticks { 1.0 - t } else { 0.0 })
}

// ---- the frame ---------------------------------------------------------------------------------

pub fn frame(s: mut Lab, time: f32, width: u32, height: u32) {
    let dt = match s.last {
        Some(before) => clamp(time - before, 0.0, 0.1),
        None => 0.0,
    }
    s.last = Some(time)
    if !s.playing {
        s.playing = true
        s.voice.push(sound::start(music::music()))
    }
    s.snaps.update()
    let (snap, lag) = drawn(s.snaps, time)
    borrow c = course(snap.course)
    if snap.course != s.shown {
        s.camera = camera(c.start)
        s.cast = cast(c)
        s.pools = buffer_of(s.cast.waves.pools, at_least: 8)
        s.shown = snap.course
    }
    follow(mut s.camera, snap, dt)
    // The scene is drawn at the render scale, the page and the HUD at the screen's size.
    pace(mut s.scale, dt)
    if dt > 0.0 && dt < 0.25 {
        s.frame_time = if s.frame_time == 0.0 { dt } else {
            s.frame_time + (dt - s.frame_time) * 0.05
        }
    }
    // F3 shows the readout. The frames' keys are their own: the sim's ticks take theirs.
    for e in events() {
        if let Event::KeyDown { key, repeat, .. } = e {
            if key == Key::F3 && !repeat {
                s.readout = !s.readout
            }
        }
    }
    let (rw, rh) = render_size(s.scale, width, height)
    if rw != s.width || rh != s.height {
        s.targets = targets(width: rw, height: rh)
        s.width = rw
        s.height = rh
    }
    let aspect = f32(width) / f32(max(height, 1))
    let half = half_view(aspect)
    let eye = framed(s.camera, half, c.ends)
    react(mut s.cast, snap, c, dt, eye, half)
    // What happened, to the voice.
    for cue in s.cast.cues {
        for i in 0..s.voice.len() {
            let _ = s.voice[i].push(cue)
        }
    }
    s.cast.cues.clear()
    // Where the snacks' count is, on the plane of play: found carrots fly there.
    let hud_at = eye + vec2(-half.x + 1.6, half.y - 0.9)
    let at = vec3(eye, 0.0)
    let view_proj = ortho(-half.x, half.x, -half.y, half.y, near: 1.0, far: 100.0) *
        look_at(at + vec3(0.0, 0.0, 50.0), at)
    let px = 2.0 * half.y / f32(rh)
    var back: Vec<Sprite> = Vec::new()
    var front: Vec<Sprite> = Vec::new()
    sprites(s.cast, snap, c, time, lag, hud_at, mut back, mut front)
    let behind = back.len()
    for f in front {
        back.push(f)
    }
    write(mut s.sprites, 0, back)
    write(mut s.heights, 0, s.cast.waves.heights)
    let screen = vec2(f32(width), f32(height))
    hud(mut s, snap, screen)
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    let (i, level) = (snap.course, snap.course == LEVEL)
    let view = View { centre: eye, half, screen: vec2(f32(rw), f32(rh)), time }
    // How much the capybara slides and is on the ground, eased, for the grass.
    let mode = Mode::from_u32(snap.mode)
    let on = mode == Some(Mode::Walk) || mode == Some(Mode::Crouch) || mode == Some(Mode::Slide)
    let ease = 1.0 - exp(-dt * 10.0)
    s.presence += (if on { 1.0 } else { 0.0 } - s.presence) * ease
    s.sliding += (if mode == Some(Mode::Slide) { 1.0 } else { 0.0 } - s.sliding) * ease
    let field = Field {
        view_proj,
        feet: snap.at - snap.ground * 0.35,
        vel: snap.vel,
        px,
        time,
        sliding: s.sliding,
        presence: s.presence,
    }
    let stage = Stage { view_proj, px, time, first: 0 }
    // The scene: the sky and the zoo behind (one pass, nearest first); the ground and its grass; the
    // cast.
    let scene = begin_pass(mut s.targets.scene)
    draw(
        scene,
        full.bind(z: 0.0),
        scenery::backdrop.bind(v: view, tops: s.tops[i].items(), g: s.grain, gs: s.repeat),
        vertices: 3,
    )
    draw(
        scene,
        earth_vertex.bind(verts: s.earths[i].items(), f: field),
        earth.bind(
            f: field,
            tops: s.tops[i].items(),
            pools: s.pools.items(),
            g: s.grain,
            gs: s.repeat,
        ),
        vertices: if level { LEVEL_EARTH.len() / 2 } else { LAB_EARTH.len() / 2 },
    )
    draw(
        scene,
        grass_vertex.bind(verts: s.grasses[i].items(), f: field),
        grass.bind(f: field),
        vertices: if level { LEVEL_GRASS.len() / 2 } else { LAB_GRASS.len() / 2 },
    )
    draw(
        scene,
        sprite_vertex.bind(sprites: s.sprites.items(), st: stage),
        sprite.bind(sprites: s.sprites.items(), st: stage),
        vertices: 6,
        instances: behind,
    )
    scene.end()
    // The water reads a copy of the scene, bending what's behind it; the splashes go over it.
    let copied = begin_pass(mut s.targets.below)
    draw(copied, full.bind(z: 0.0), copy.bind(src: s.targets.scene, s: s.linear), vertices: 3)
    copied.end()
    let wet = begin_pass(mut s.targets.scene, keep: true)
    let pond = Pond { view_proj, centre: eye, half, px, time }
    draw(
        wet,
        water_vertex.bind(verts: s.waters[i].items(), f: pond),
        water.bind(
            f: pond,
            pools: s.pools.items(),
            heights: s.heights.items(),
            below: s.targets.below,
            s: s.linear,
        ),
        vertices: if level { LEVEL_WATER.len() } else { LAB_WATER.len() },
    )
    let ahead = Stage { first: behind, ..stage }
    draw(
        wet,
        sprite_vertex.bind(sprites: s.sprites.items(), st: ahead),
        sprite.bind(sprites: s.sprites.items(), st: ahead),
        vertices: 6,
        instances: back.len() - behind,
    )
    wet.end()
    let out = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    let (iris, open) = cast::iris(s.cast, snap, lag)
    let page = Page {
        centre: eye,
        half,
        iris,
        screen,
        open,
        dim: f32(snap.paused),
    }
    draw(
        out,
        full.bind(z: 0.0),
        finish.bind(scene: s.targets.scene, s: s.linear, page: page),
        vertices: 3,
    )
    s.renderer.draw(out, screen)
    out.present()
}

/// Ticks as seconds, to the hundredth.
fn seconds(ticks: u32) -> String {
    let hundredths = ticks * 100 / HZ
    let tail = hundredths % 100
    let pad = if tail < 10 { "0" } else { "" }
    f"{hundredths / 100}.{pad}{tail}"
}

/// Text in `colour` with a soft dark shadow under it, so it reads over the sky and the ground.
fn say(s: mut Lab, face: Face, text: str, size: f32, at: vec2, colour: vec4) {
    let shadow = vec4(0.02, 0.03, 0.05, 0.55 * colour.w)
    let _ = s.list.text(s.fonts, face, text, size, at + vec2(size * 0.07), shadow)
    let _ = s.list.text(s.fonts, face, text, size, at, colour)
}

/// The HUD: the snacks found at the top left, the clock at the top right and under it how to
/// pause; with F3 the readout under the snacks. Paused, the pause's card instead.
fn hud(s: mut Lab, snap: Snap, screen: vec2) {
    s.list.clear(screen)
    let size = max(screen.y * 0.042, 14.0)
    let small = size * 0.5
    let pad = size * 0.7
    let white = vec4(1.0, 0.98, 0.94, 1.0)
    let gold = vec4(1.0, 0.78, 0.3, 1.0)
    let soft = vec4(1.0, 0.98, 0.94, 0.75)
    if snap.paused == 1 {
        card(mut s, snap, screen)
        return
    }
    borrow c = course(snap.course)
    if c.snacks.len() > 0 {
        let found = (snap.snacks & ((1 << c.snacks.len()) - 1)).count_ones()
        let colour = if found == c.snacks.len() { gold } else { white }
        // It pops as a found carrot arrives.
        let pop = 1.0 + 0.3 * exp(-s.cast.arrived * 7.0)
        let text = f"SNACKS {found}/{c.snacks.len()}"
        say(mut s, Face::Sans, text.as_str(), size * pop, vec2(pad), colour)
    }
    let clock = seconds(if snap.finished > 0 { snap.finished } else { snap.ticks })
    let time = if snap.finished > 0 { f"GOAL! {clock}" } else { take clock }
    let width = s.fonts.font(Face::Mono).measure(time.as_str(), size)
    say(
        mut s,
        Face::Mono,
        time.as_str(),
        size,
        vec2(screen.x - pad - width, pad),
        if snap.finished > 0 { gold } else { white },
    )
    let pause = "Esc  pause"
    let pw = s.fonts.font(Face::Sans).measure(pause, small * 1.2)
    say(mut s, Face::Sans, pause, small * 1.2, vec2(screen.x - pad - pw, pad + size * 1.3), soft)
    if s.readout {
        // The frame rate, the frame's time, and the size the scene is drawn at: native (the
        // screen's own) or the render scale's.
        let ms = s.frame_time * 1000.0
        let fps = if s.frame_time > 0.0 { 1.0 / s.frame_time } else { 0.0 }
        let at = if s.scale.value >= 1.0 { f"native" } else { f"{s.scale.value * 100.0:.0}%" }
        let readout = f"{fps:.0} fps  {ms:.1} ms  {at} {s.width}x{s.height}"
        say(mut s, Face::Mono, readout.as_str(), small, vec2(pad, pad + size * 1.3), soft)
    }
}

/// The pause's card, on the page washed over: the course's name (or "Paused" once it's begun), the
/// controls, and how to play on. A cream card with an ink border, as the book's.
fn card(s: mut Lab, snap: Snap, screen: vec2) {
    let size = max(screen.y * 0.03, 12.0)
    let ink = vec4(0.24, 0.16, 0.11, 1.0)
    let soft = vec4(0.24, 0.16, 0.11, 0.72)
    let w = min(screen.x * 0.9, size * 32.0)
    let h = size * 16.8
    let at = vec2((screen.x - w) * 0.5, (screen.y - h) * 0.5)
    s.list.rect(Rect::new(at.x - 3.0, at.y - 3.0, w + 6.0, h + 6.0), ink, radius: size * 0.9)
    s.list.rect(Rect::new(at.x, at.y, w, h), vec4(0.98, 0.95, 0.88, 1.0), radius: size * 0.8)
    let fresh = snap.ticks == 0 && snap.attempt == 0
    let title = if !fresh {
        "Paused"
    } else if snap.course == LEVEL {
        "The Capybara Wetlands"
    } else { "The lab" }
    let title_size = size * 1.6
    let tw = s.fonts.font(Face::Sans).measure(title, title_size)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        title,
        title_size,
        vec2(at.x + (w - tw) * 0.5, at.y + size * 1.1),
        ink,
    )
    var y = at.y + size * 4.2
    let left = at.x + size * 1.6
    let keys = left + size * 6.4
    // The controls, a row each: what, and the keys for it.
    let rows = [
        "Run",
        "Left and right arrows, or A and D",
        "Jump",
        "Space, again in the air to jump again",
        "Slide",
        "Down arrow or S while running",
        "Swim",
        "Space kicks, up and down swim, both in turn: dolphin kick",
        "Restart",
        "R",
        "Pause",
        "Esc or P",
        "Controller",
        "Stick, A to jump, Start to pause, Select to restart",
    ]
    for i in 0..7 {
        let _ = s.list.text(s.fonts, Face::Sans, rows[i * 2], size, vec2(left, y), ink)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            rows[i * 2 + 1],
            size * 0.85,
            vec2(keys, y + size * 0.1),
            soft,
        )
        y += size * 1.45
    }
    let go = if fresh { "Press Space to play" } else { "Press Space to play on" }
    let gw = s.fonts.font(Face::Sans).measure(go, size * 1.1)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        go,
        size * 1.1,
        vec2(at.x + (w - gw) * 0.5, at.y + h - size * 2.0),
        ink,
    )
}

/// The capybara's middle (x, y, m), its speed (m/s) and its mode, as the newest snapshot has them,
/// for `wrela trace --watch capybara`.
pub fn capybara(s: mut Lab) -> vec4 {
    let n = s.snaps.newest().snap
    vec4(n.at, length(n.vel), f32(n.mode))
}

// ---- tests -------------------------------------------------------------------------------------

/// Three seconds of the run script on the hardware GPU: the level draws, with its foes and things,
/// and the sim, ticking in lockstep, plays it, from the pause it opens on (the script's Esc).
@test(frames: 180, gpu: true, input: scripts::RUN)
fn the_level_draws_and_its_sim_runs(s: Lab) {
    let n = s.snaps.newest()
    assert(n.ticks >= 358, "the ticker runs two ticks a frame")
    assert(n.snap.course == LEVEL && n.snap.paused == 0, "the level, playing")
    // Its clock is three ticks behind the ticks run: frame 0's two stood in the pause the game
    // opens on, and the tick of the script's Esc (frame 1) left it without stepping.
    assert(n.snap.ticks + 3 == n.ticks, "its clock running")
}
