/// A developer's build (`wrela build games/capybara --set DEV=true`): Tab plays the next course,
/// the movement lab among them. A player's build has neither.
pub const DEV: bool = false

/// A build for still pictures (`wrela build games/capybara --set HERO=true`): the console's hero.
/// It plays itself as the address `#attract` makes it, on a host that has no address to give (the
/// native host), with nothing drawn over the scene (the snacks' count, the title, the clock, the
/// menus), and holds its run where it begins for good: its frames are the frame the console shows
/// behind its home until it lets the run go, the hero (attract.wrela).
pub const HERO: bool = false

/// The level the game playing itself begins on, standing in its stroll's first pause
/// (attract.wrela): the hero's scene. `--set` takes another, for the stills of each.
pub const ATTRACT_FROM: u32 = RAINFOREST

/// The course the game opens on: the first level.
const FIRST: u32 = HOME

/// The most sprites drawn: the cast's and the particles'.
const SPRITES: u32 = 1024

/// The leaderboard's boards after the world's and its search (online.wrela's `WORLD` and
/// `SEARCH`): the player's runs, and the tool-assisted runs (design.md: "a separate tool-assisted
/// board").
const PLAYERS: u32 = 2
const ASSISTED: u32 = 3

/// How long after the last key a search is asked for while it's typed (s).
const SEARCH_AFTER: f32 = 0.4

/// How far a watched run seeks at a press (ticks): five seconds.
const SEEK: u32 = 600

/// How long the watch's prompts stay after the last key (s), and how long after the goal its card
/// comes (s).
const IDLE: f32 = 3.0
const FINISH_CARD: f32 = f32(world::CARD) / f32(HZ)

/// A course's meshes, built when it's shown (`ground_of`), so the build ships its corners and not
/// its meshes: its ground and its grass (two vertices a point), its water, the top of its ground
/// (earth.wrela's `profile`), and how many vertices each draws.
struct Ground {
    earth: GpuBuffer<vec4>,
    grass: GpuBuffer<vec4>,
    water: GpuBuffer<vec4>,
    tops: GpuBuffer<f32>,
    floors: GpuBuffer<f32>,
    ice: GpuBuffer<vec4>,
    earth_n: u32,
    grass_n: u32,
    water_n: u32,
}

/// Course `c`'s meshes.
fn ground_of(c: Course) -> Ground {
    let (tops, floors) = profiles(c)
    let earth = earth_mesh(c)
    let grass = grass_mesh(c)
    let water = water_mesh(c)
    Ground {
        earth_n: earth.len() / 2,
        grass_n: grass.len() / 2,
        water_n: water.len(),
        earth: buffer_of(earth, at_least: 2),
        grass: buffer_of(grass, at_least: 2),
        water: buffer_of(water, at_least: 3),
        tops: buffer_of(tops),
        floors: buffer_of(floors),
        ice: buffer_of(ice_of(c), at_least: 1),
    }
}

/// Course `c`'s icy stretches, for the ground's shaders: each from its left to its right.
fn ice_of(c: Course) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for i in c.ice {
        out.push(vec4(i, 0.0, 0.0))
    }
    if out.is_empty() {
        // A buffer has an element at least: a stretch that holds no x, not one at 0.
        out.push(vec4(1.0e9, -1.0e9, 0.0, 0.0))
    }
    out
}

pub struct Lab {
    snaps: Snapshots<Snap>,
    /// The shown course's ground, grass, water and the top of its ground, built when it's shown.
    ground: Ground,
    /// The shown course's pools and its waves' heights.
    pools: GpuBuffer<vec4>,
    heights: GpuBuffer<f32>,
    sprites: GpuBuffer<Sprite>,
    /// The course the camera was last following, and its cast.
    shown: u32,
    cast: Cast,
    /// The scene, its copy under the water and the render scale (`engine::sheet`).
    sheet: Sheet,
    /// The backdrop's layers, cached (scenery.wrela's `Strips`).
    strips: Strips,
    linear: Sampler,
    /// The baked grain (ink.wrela) and the sampler that repeats it.
    grain: Texture<Rgba16Float>,
    repeat: Sampler,
    camera: Camera,
    last: Option<f32>,
    /// The ring to the voice (sound.wrela): none until it starts, on the first frame.
    voice: Option<RingWriter<Cue>>,
    /// The player's settings (settings.wrela), as they load from storage and are stored again;
    /// whether the voice was last told to play the music; and the options' steps taken in the
    /// sim that the settings have (none until the first snapshot).
    settings: Settings,
    loading_settings: Option<Pending<u8>>,
    saving_settings: Option<Pending<u8>>,
    storing_settings: Storing,
    music_on: bool,
    turns: Option<[i32; 3]>,
    /// The device the player last used, for the prompts.
    device: Device,
    /// Whether the readout shows (F3): the frame rate, the frame's time and the render scale. The
    /// frames' time (s), smoothed, for it.
    readout: bool,
    /// The frames drawn, and the first whose page was whole (its backdrop's strips drawn and its
    /// text's glyphs in), once it has been: when the game was playable (`playable`).
    frames: u32,
    playable_at: Option<u32>,
    /// How much the capybara is on the ground and slides, eased (earth.wrela's `Field`).
    presence: f32,
    sliding: f32,
    frame_time: f32,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    /// The signs' words, drawn into the scene over the water and behind the cast (signs.wrela),
    /// with the one renderer's atlas; and the card that keeps the sign in reach on the screen.
    signs: Uploaded,
    sign_list: DrawList,
    sign_card: Card,
    sign_wraps: Wraps,
    /// The frame's sprites: the cast's and the dust behind the water, and in front of it (kept
    /// from frame to frame, so no frame makes them).
    back: Vec<Sprite>,
    front: Vec<Sprite>,
    /// What the host can do (its environment's capabilities), once it has said; the semantic tree
    /// last sent; and the requests to it still out.
    environment: Option<Pending<u8>>,
    capabilities: Option<u32>,
    /// The device's pixels to a CSS pixel, as the host's environment says (1 until it has, or
    /// where it doesn't).
    ratio: f32,
    /// The pools in view, as rectangles of the scene's pixels (`wet_rects`): where the water's
    /// copy of the scene is made.
    wet: Vec<vec4>,
    tree: Sent,
    told: Vec<Pending<u8>>,
    /// The player's progress (progress.wrela: each course's record, the best whole game, their
    /// runs), as it loads from storage and is stored again, and when (`Storing`). The attempt
    /// whose finish was last kept (its course and attempt), so each is kept once.
    progress: Progress,
    loading: Option<Pending<u8>>,
    saving: Option<Pending<u8>>,
    /// Stored progress this build can't read (a later version's), as it was stored: never stored
    /// over, and stored back as it is when the game returns to the console.
    unread: Option<Vec<u8>>,
    storing: Storing,
    kept: u32,
    /// The tool-assisted runs of a course, and which (made when the runs' page or a ghost first
    /// asks: each is the sim playing the run, and making them delayed the first frame and each
    /// change of level), the board shown (online.wrela's `WORLD`..., `PLAYERS`, `ASSISTED`),
    /// whether the leaderboard was open the last frame, and the run with the focus on it: its
    /// category's column and its row.
    assisted: Vec<Replay>,
    assisted_of: Option<u32>,
    board: u32,
    browsed: bool,
    column: u32,
    row: u32,
    /// The trail the ghost follows, the clock at each checkpoint it reached (its splits), and the
    /// course and ghost that trail is for (`follow_ghost`; 0 once the player's runs change, as
    /// their best may have).
    trail: Vec<Pose>,
    splits: Vec<u32>,
    trail_of: u32,
    /// The attempt the splits are of, the last checkpoint it reached, its latest split against the
    /// ghost's (ticks, below 0 ahead) and how long it has shown (s).
    split_attempt: u32,
    split_checkpoint: u32,
    split: Option<i32>,
    split_age: f32,
    /// How long since the attempt reached the goal (s; 0 before), which attempt that was, and the
    /// player's best time before it (0 without one).
    finish_age: f32,
    finish_key: u32,
    best_before: u32,
    /// The run being watched, whether the last frame drew one, how long since a key while
    /// watching (s), where the pointer is (px), and the menus' moves the frames read (the runs').
    watching: Option<Watch>,
    watched: bool,
    idle: f32,
    pointer: vec2,
    nav: Stick,
    /// The link to the console that opened the game (`console`).
    console: Link,
    /// The world's boards and posts (online.wrela), and whose the run watched is and its place
    /// when it is the world's (empty and 0 for the player's own and the tool-assisted ones; 0 for
    /// a run the search found).
    online: online::Online,
    watch_name: String,
    watch_place: u32,
    /// The search for a name (search.wrela), whether it changed since it was last asked for and
    /// when, and whether the F that opens it is down (what it types isn't typed into it).
    search: Search,
    search_changed: bool,
    search_at: f32,
    opener: bool,
    /// The run raced (R on the leaderboard) and whose it is: the ghost on its course until another
    /// ghost is chosen; and a world's run to race whose replay is on its way (its hash, whose).
    race: Option<(Replay, String)>,
    race_wanted: Option<(Vec<u8>, String)>,
    /// The world's run the ghost follows, by its replay's hash (empty for none), and whose.
    ghost_hash: Vec<u8>,
    ghost_name: String,
    /// The attempt's clock at each checkpoint it reached, where the most time went against the
    /// ghost's run once it reached the goal, and its run's fingerprint once kept (empty before),
    /// for the card's word on its post.
    mine: Vec<u32>,
    lost: String,
    finished_print: Vec<u8>,
    /// The signed-in player's place on the live course's world board (any%; 0 for none), worked
    /// out once a frame; and the fingerprints of the player's runs of a course and category as
    /// the board lists them (online.wrela's `fingerprint`), worked out once until the runs change.
    place: u32,
    prints: Vec<(u32, u32, Vec<Vec<u8>>)>,
    /// The screen of what posting makes public, while it's up (online.wrela's `consenting`):
    /// whether its box is ticked and which control has the focus (screens.wrela's `POSTING_BOX`...),
    /// and its layout, for the screen size it was laid out at (`lay_posting`).
    posting_best: bool,
    posting_focus: u32,
    posting_laid: Option<(vec2, screens::Laid)>,
    /// The world's boards as the leaderboard shows them: around the account's place (`near`: the
    /// slice round it, or its page if the account is on it) or from the top; the first row shown
    /// of each category's (any%, 100%), and whether it has been put at the account's place yet.
    /// And whether the account has a place on the live course's board at all, numbered or not.
    near: bool,
    first: [u32; 2],
    anchored: [bool; 2],
    placed: bool,
    /// The rows of each category whose replays were last fetched ahead (`rows_key`).
    fetched: [u64; 2],
    /// Whether the screen of what posting makes public was up last frame, and how many times it has
    /// come up: its nodes are numbered anew each time, so the host starts each with the focus on
    /// Post, not where the last one's was left.
    consent_up: bool,
    consents: u32,
    /// Whether the reminder to save the recovery codes was shown since the attempt began.
    reminder_seen: bool,
    /// What the game is, decided once its address answers (attract.wrela's `Role`): until then
    /// nothing is drawn, played, stored or asked for. The game played (`Play`) or playing itself
    /// (`Attract`, opened at `#attract` behind the console's home).
    role: Role,
    address: Option<Pending<u8>>,
    attract: attract::Attract,
}

pub fn init() -> Lab {
    let latest = run(live(FIRST), hz: HZ, step: tick_live, present: present_live)
    let fonts = lettering::fonts()
    let renderer = Renderer::new(fonts)
    let shown = cast(course(FIRST))
    Lab {
        snaps: Snapshots::new(take latest, hz: HZ),
        ground: ground_of(course(FIRST)),
        pools: buffer_of(shown.waves.pools, at_least: 8),
        heights: buffer_of(shown.waves.heights, at_least: 8),
        sprites: buffer(SPRITES),
        shown: FIRST,
        cast: shown,
        sheet: sheet(),
        strips: strips(),
        linear: sampler(),
        grain: grain_texture(),
        repeat: sampler(address: Address::Repeat),
        camera: camera(course(FIRST).start),
        last: None,
        voice: None,
        settings: Settings {},
        // Loaded once the game is played (`store_settings`, `store_progress`).
        loading_settings: None,
        saving_settings: None,
        storing_settings: Storing {},
        music_on: true,
        turns: None,
        device: Device::Keys,
        readout: false,
        frames: 0,
        playable_at: None,
        presence: 1.0,
        sliding: 0.0,
        frame_time: 0.0,
        fonts,
        renderer,
        list: DrawList::new(),
        signs: Uploaded::new(),
        sign_list: DrawList::new(),
        sign_card: Card {},
        sign_wraps: Wraps {},
        back: Vec::with_capacity(SPRITES),
        front: Vec::with_capacity(SPRITES),
        environment: Some(host::environment()),
        capabilities: None,
        ratio: 1.0,
        wet: Vec::new(),
        tree: Sent {},
        told: Vec::new(),
        progress: progress::fresh(),
        loading: None,
        saving: None,
        unread: None,
        storing: Storing {},
        kept: 0xffffffff,
        assisted: Vec::new(),
        assisted_of: None,
        board: online::WORLD,
        browsed: false,
        column: ANY,
        row: 0,
        online: online::online(),
        watch_name: String::new(),
        watch_place: 0,
        search: search::search(),
        search_changed: false,
        search_at: 0.0,
        opener: false,
        race: None,
        race_wanted: None,
        ghost_hash: Vec::new(),
        ghost_name: String::new(),
        mine: Vec::new(),
        lost: String::new(),
        finished_print: Vec::new(),
        place: 0,
        prints: Vec::new(),
        posting_best: false,
        posting_focus: screens::POSTING_POST,
        posting_laid: None,
        near: true,
        first: [0; 2],
        anchored: [false; 2],
        placed: false,
        fetched: [0; 2],
        consent_up: false,
        consents: 0,
        reminder_seen: false,
        trail: Vec::new(),
        splits: Vec::new(),
        trail_of: 0,
        split_attempt: 0,
        split_checkpoint: 0,
        split: None,
        split_age: 0.0,
        finish_age: 0.0,
        finish_key: 0xffffffff,
        best_before: 0,
        watching: None,
        watched: false,
        idle: 0.0,
        pointer: vec2(-1.0),
        nav: Stick {},
        console: Link::new(),
        role: Role::Deciding,
        address: Some(host::address()),
        attract: attract::attract(ATTRACT_FROM),
    }
}

/// The snapshot a frame draws, from the two round its time. Everything that moves is drawn between them, so motion is continuous at any refresh rate,
/// whatever the sim's: the capybara's middle, velocity, speed and the ground's normal under it, and
/// each foe's middle (and how long since it was knocked out). Its counters (a flip's ticks, a
/// death's) are the later snapshot's, and `lag` says how far before it the frame falls (ticks, 0
/// to 1), so they can be drawn between too. Where a foe has jumped (back to its start when the
/// capybara comes back), or changed whether it's knocked out, it isn't blended; nor is anything
/// across a cut (world.wrela's `Tally`), where the capybara was put somewhere at once.
fn drawn(s: Snapshots<Snap>, time: f32) -> (Snap, f32) {
    let b = s.at(s.sim_time(time))
    (mixed(b.a, b.b, b.alpha), if b.b.ticks > b.a.ticks { 1.0 - b.alpha } else { 0.0 })
}

/// Snapshot `b` with what moves drawn `t` of the way from `a` (as `drawn` says).
fn mixed(a: Snap, b: Snap, t: f32) -> Snap {
    var snap = b
    if a.tally.cuts != b.tally.cuts {
        return snap
    }
    snap.at = mix(a.at, b.at, vec2(t))
    snap.vel = mix(a.vel, b.vel, vec2(t))
    snap.speed = mix(a.speed, b.speed, t)
    let n = mix(a.ground, b.ground, vec2(t))
    if length(n) > 1.0e-3 {
        snap.ground = normalize(n)
    }
    for i in 0..snap.foes.len() {
        let (f, g) = (a.foes[i], b.foes[i])
        if sign(f.z) == sign(g.z) && distance(f.xy, g.xy) < 1.0 {
            snap.foes[i] = vec4(mix(f.xy, g.xy, vec2(t)), g.z, if g.z < 0.0 {
                mix(f.w, g.w, t)
            } else { g.w })
        }
    }
    snap
}

// ---- the frame ---------------------------------------------------------------------------------

pub fn frame(s: mut Lab, time: f32, width: u32, height: u32) {
    let dt = match s.last {
        Some(before) => clamp(time - before, 0.0, 0.1),
        None => 0.0,
    }
    s.last = Some(time)
    // Until the address says what the game is, a frame of the margins' sky alone: no HUD, no
    // sound, nothing stored or asked.
    if !decided(mut s) {
        let out = begin_screen_pass(clear: MARGINS)
        out.present()
        return
    }
    // The sim's part of the frame: its snapshots read (engine::frame `PHASES`).
    phase("sim")
    s.snaps.update()
    // The play area (camera.wrela's `play_rect`): what the scene, the page and the screens are
    // laid out in (`screen`, its size), at `origin` on the screen; the margins round it the sky's.
    let play = play_rect(vec2(f32(width), f32(height)), s.settings.aspect)
    let screen = play.zw
    let origin = play.xy
    let (live_snap, live_lag) = drawn(s.snaps, time)
    host_answers(mut s)
    if s.role == Role::Attract {
        s.attract.play(mut s.watching)
    } else {
        played(mut s, live_snap, time, dt, origin, screen)
    }
    // A watched run, or play.
    var snap = live_snap
    var lag = live_lag
    var opening: Option<Snap> = None
    match mut s.watching {
        Some(w) => {
            if !s.watched {
                // A run just opened to watch: its cast hears it from its first tick.
                let (_, first, _) = w.between()
                opening = Some(first)
            }
            // Playing itself, the run holds on its first frame until the console shows it.
            let held = s.role == Role::Attract && (s.attract.held || HERO)
            w.advance(if held { 0.0 } else { dt })
            let (a, b, t) = w.between()
            snap = mixed(a, b, t)
            lag = if b.ticks > a.ticks { 1.0 - t } else { 0.0 }
        },
        None => {},
    }
    let watching = s.watching.is_some()
    borrow c = course(snap.course)
    if snap.course != s.shown || watching != s.watched {
        s.camera = camera(snap.at)
        s.cast = cast(c, from: opening)
        s.pools = buffer_of(s.cast.waves.pools, at_least: 8)
        s.heights = buffer_of(s.cast.waves.heights, at_least: 8)
        if snap.course != s.shown {
            s.ground = ground_of(c)
        }
        s.shown = snap.course
        s.watched = watching
    }
    follow(mut s.camera, snap, dt)
    // The scene is drawn at the render scale (paced by the frames), the page and the HUD at the
    // screen's size.
    let (rw, rh) = s.sheet.begin(dt, u32(screen.x), u32(screen.y), ratio: s.ratio)
    if dt > 0.0 && dt < 0.25 {
        s.frame_time = if s.frame_time == 0.0 { dt } else {
            s.frame_time + (dt - s.frame_time) * 0.05
        }
    }
    let aspect = screen.x / max(screen.y, 1.0)
    let half = half_view_in(aspect, s.settings.aspect)
    let eye = framed(s.camera, half, c.ends)
    react(mut s.cast, snap, c, dt, eye, half)
    if snap.paused == 0 && !watching {
        s.sign_card.next(snap.course, s.settings.learned, snap.at, eye, half, dt)
    }
    // What happened, to the voice.
    match mut s.voice {
        Some(v) => {
            for cue in s.cast.cues {
                let _ = v.push(cue)
            }
        },
        None => {},
    }
    s.cast.cues.clear()
    // Where the snacks' count is, on the plane of play: found carrots fly there. It shows while
    // playing.
    let hud_at = eye + vec2(-half.x + 1.1, half.y - 0.85)
    let count = snap.paused == 0 && !watching && !HERO
    let view_proj = flat_camera(eye, half)
    let px = 2.0 * half.y / f32(rh)
    s.back.clear()
    s.front.clear()
    sprites(s.cast, snap, c, time, lag, hud_at, count, mut s.back, mut s.front)
    // The ghost, behind the cast, on the player's clock.
    if !watching {
        follow_ghost(mut s, snap.course)
        if s.trail.len() > 0 {
            let t = min(snap.ticks, s.trail.len() - 1)
            if let Some(g) = ghost(s.trail[max(t, 1) - 1], s.trail[t], if t == 0 { 0.0 } else {
                lag
            }) {
                s.back.push(g)
            }
        }
    }
    // Those behind the water, then those over it.
    let behind = s.back.len()
    write(mut s.sprites, 0, s.back)
    write(mut s.sprites, behind, s.front)
    write(mut s.heights, 0, s.cast.waves.heights)
    hud(mut s, snap, screen, time)
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    // The signs' words, at the scene's size.
    let scene_size = vec2(f32(rw), f32(rh))
    s.sign_list.clear(scene_size)
    sign_words(
        mut s.sign_list,
        mut s.sign_wraps,
        s.fonts,
        snap.course,
        s.settings.learned,
        s.device,
        eye,
        half,
        scene_size,
    )
    s.signs.upload(s.sign_list)
    let habitat = habitat_of(snap.course)
    let view = View { centre: eye, half, screen: vec2(f32(rw), f32(rh)), time, habitat }
    // How much the capybara slides and is on the ground, eased, for the grass.
    let mode = Mode::from_u32(snap.mode)
    let on = grounded(mode)
    let ease = 1.0 - exp(-dt * 10.0)
    s.presence += (if on { 1.0 } else { 0.0 } - s.presence) * ease
    s.sliding += (if mode == Some(Mode::Slide) { 1.0 } else { 0.0 } - s.sliding) * ease
    let field = Field {
        view_proj,
        feet: snap.at - snap.ground * RADIUS,
        vel: snap.vel,
        px,
        time,
        sliding: s.sliding,
        presence: s.presence,
        habitat,
    }
    let stage = Stage { view_proj, px, time, first: 0 }
    // The scene: the sky and the zoo behind (one pass, nearest first); the ground and its grass; the
    // cast.
    label("strips")
    s.strips.update(view, s.grain, s.repeat)
    label("scene")
    let scene = begin_pass(mut s.sheet.scene)
    draw(
        scene,
        full.bind(z: 0.0),
        scenery::backdrop.bind(
            v: view,
            tops: s.ground.floors.items(),
            drawn: s.strips.drawn(),
            marsh: s.strips.strips[0],
            wetlands: s.strips.strips[1],
            savanna_strip: s.strips.strips[2],
            hills: s.strips.strips[3],
            s: s.linear,
            g: s.grain,
            gs: s.repeat,
        ),
        vertices: 3,
    )
    draw(
        scene,
        earth_vertex.bind(verts: s.ground.earth.items(), f: field),
        earth.bind(
            f: field,
            tops: s.ground.tops.items(),
            pools: s.pools.items(),
            ice: s.ground.ice.items(),
            g: s.grain,
            gs: s.repeat,
        ),
        vertices: s.ground.earth_n,
    )
    draw(
        scene,
        grass_vertex.bind(verts: s.ground.grass.items(), f: field),
        grass.bind(f: field),
        vertices: s.ground.grass_n,
    )
    draw(
        scene,
        quad_vertex.bind(sprites: s.sprites.items(), st: stage),
        sprite.bind(sprites: s.sprites.items(), st: stage),
        vertices: 6,
        instances: behind,
    )
    scene.end()
    // The water reads a copy of the scene, bending what's behind it; the splashes go over it.
    label("water copy")
    s.wet.clear()
    wet_rects(mut s.wet, c, eye, half, scene_size)
    s.sheet.copy_below(s.linear, s.wet)
    label("water")
    let wet = begin_pass(mut s.sheet.scene, keep: true)
    let pond = Pond { view_proj, centre: eye, half, px, time, habitat }
    draw(
        wet,
        water_vertex.bind(verts: s.ground.water.items(), f: pond),
        water.bind(
            f: pond,
            pools: s.pools.items(),
            heights: s.heights.items(),
            below: s.sheet.below,
            s: s.linear,
        ),
        vertices: s.ground.water_n,
    )
    // The signs' words over the water, so it never bends them, and behind the cast.
    s.renderer.draw_uploaded(wet, s.signs, scene_size)
    let ahead = Stage { first: behind, ..stage }
    draw(
        wet,
        quad_vertex.bind(sprites: s.sprites.items(), st: ahead),
        sprite.bind(sprites: s.sprites.items(), st: ahead),
        vertices: 6,
        instances: s.front.len(),
    )
    wet.end()
    label("page")
    let out = begin_screen_pass(clear: MARGINS)
    out.viewport(x: play.x, y: play.y, width: play.z, height: play.w)
    let (iris, open) = cast::iris(s.cast, snap, lag)
    let page = Page {
        centre: eye,
        half,
        iris,
        screen,
        origin,
        open,
        // Washed over under the pause's pages, a little under the title.
        dim: if snap.paused == 0 || watching { 0.0 } else if snap.page == TITLE { 0.35 } else {
            1.0
        },
    }
    draw(
        out,
        full.bind(z: 0.0),
        finish.bind(scene: s.sheet.scene, s: s.linear, page: page),
        vertices: 3,
    )
    s.renderer.draw(out, screen)
    out.present()
    playable(mut s)
    if s.role == Role::Attract {
        s.attract.ready(s.playable_at.is_some())
        s.attract.listen()
    } else {
        publish(mut s, snap, play)
        console(mut s)
    }
}

/// Whether the game knows what it is: once its address answers, it plays itself if the address
/// says `#attract` (attract.wrela's `role_of`), and is played otherwise, as it is where the host
/// can't say (the native host).
fn decided(s: mut Lab) -> bool {
    if s.role != Role::Deciding {
        return true
    }
    if HERO {
        begin(mut s, Role::Attract)
        return true
    }
    let Some(answer) = answer_of(mut s.address) else { return false }
    begin(
        mut s,
        match answer {
            Ok(bytes) => role_of(bytes),
            Err(_) => Role::Play,
        },
    )
    true
}

/// The game becomes `role`: played, its voice starts (its storage loads, and its link and the
/// world's boards start, as the frames go: `played`); playing itself, it has none of them.
fn begin(s: mut Lab, role: Role) {
    s.role = role
    s.address = None
    if role == Role::Play {
        s.voice = Some(sound::start(music::music()))
    }
}

/// Plays itself, as the address `#attract` makes it, for a host that has no address to give (the
/// native host and `std::tool::drive`'s: docs/toolchain-gaps.md): called before the first frame,
/// as the attract tool test does.
pub fn play_itself(s: mut Lab) {
    if s.role == Role::Deciding {
        begin(mut s, Role::Attract)
    }
}

/// The player's part of the frame, from the sim's snapshot `live_snap` at the host's `time`, `dt`
/// seconds on, the play area `screen` pixels at `origin`: the world's boards and the stored
/// progress and settings kept up, the finished run kept, the frames' keys and clicks, the search
/// asked once the typing pauses, a race's replay, the watch closed off the leaderboard, and what
/// the frames keep up with from the sim (`settle`).
fn played(s: mut Lab, live_snap: Snap, time: f32, dt: f32, origin: vec2, screen: vec2) {
    s.place = online::my_place(s.online, live_snap.course, ANY)
    s.placed = online::placed(s.online, live_snap.course, ANY)
    online::update(mut s.online, time)
    if let Some((r, name, place)) = online::take_watch(mut s.online) {
        open_watch(mut s, r.clone())
        s.watch_name = name.clone()
        s.watch_place = place
    }
    store_progress(mut s, dt)
    store_settings(mut s, dt)
    if live_snap.finished > 0 {
        // The best before this run, before it's kept among the runs.
        let key = live_snap.course << 16 | (live_snap.attempt & 0xffff)
        if key != s.finish_key {
            s.finish_key = key
            s.best_before = best(s, live_snap.course)
        }
    }
    keep_finished(mut s, live_snap)
    // F3 shows the readout, and M turns the music off and on. The frames' keys are their own: the
    // sim's ticks take theirs. On the runs, the sim leaves the keys and clicks to the frames: the
    // board's and the watch's.
    let browsing = live_snap.paused == 1 && live_snap.page == RUNS
    let finding = live_snap.paused == 1 && live_snap.page == FIND
    if (browsing || finding) && !s.browsed {
        // The leaderboard opens on the world's board; opened alone, with no world to show, on
        // the player's runs.
        s.board = if s.online.linked { online::WORLD } else { PLAYERS }
        to_board(mut s, s.board)
    }
    if finding {
        s.board = online::SEARCH
    }
    s.browsed = browsing || finding
    online::browsing(mut s.online, browsing)
    // The screen of what posting makes public comes up with its box unticked, the focus on Post.
    let consenting = browsing && s.online.consenting.is_some()
    if consenting && !s.consent_up {
        s.posting_best = false
        s.posting_focus = screens::POSTING_POST
        s.consents += 1
    }
    s.consent_up = consenting
    // The reminder to save the recovery codes, once seen, goes with the attempt it was seen on.
    if s.reminder_seen && !browsing && live_snap.finished == 0 {
        online::reminded(mut s.online)
        s.reminder_seen = false
    }
    for raw in events() {
        s.console.event(raw)
        let e = in_play(raw, origin)
        if let Some(d) = device_of(e) {
            s.device = d
        }
        if let Event::PointerMove { at, .. } = e {
            s.pointer = at
        }
        if let Event::KeyDown { key, repeat, .. } = e {
            if key == Key::F3 && !repeat {
                s.readout = !s.readout
            } else if key == Key::M && !repeat {
                s.settings.music = !s.settings.music
                s.storing_settings.unsaved = true
            }
        }
        if finding {
            find(mut s, e, screen, time)
        } else if browsing && s.online.consenting.is_some() {
            consenting_input(mut s, e, screen)
        } else if browsing {
            browse(mut s, e, live_snap.course, screen)
        } else {
            let _ = s.nav.nav(e)
        }
    }
    // The search asked for once the typing pauses.
    if s.search_changed && time - s.search_at > SEARCH_AFTER {
        ask_search(mut s)
    }
    // A world's run to race, once its replay has come; given up if it can't.
    let wanted = s.race_wanted.clone()
    if let Some((hash, name)) = wanted {
        if let Some(r) = online::held(s.online, hash) {
            s.race = Some((take r, name.clone()))
            s.race_wanted = None
            s.trail_of = 0
        } else if online::not_came(s.online, hash) {
            s.race_wanted = None
        }
    }
    // The ghost's replay, and the one a race waits for, stay held while they're used.
    match s.race_wanted {
        Some((hash, _)) => online::pin(mut s.online, s.ghost_hash, hash),
        None => online::pin(mut s.online, s.ghost_hash, Vec::new()),
    }
    if !browsing {
        s.watching = None
    }
    settle(mut s, live_snap, dt)
    s.idle += dt
}

/// The console's link (platform::presentation): the game tells it once it's playable, and goes
/// back to it when the player asks (F10, a controller's Home, or Select and Start held), its
/// progress stored first; not before the stored progress is read, so it isn't stored over, and
/// one writer at a time: a store of the progress under way finishes first, and none starts while
/// it returns (`store_progress`), so an older one can't land over the last.
fn console(s: mut Lab) {
    if s.playable_at.is_none() {
        return
    }
    s.console.presented()
    if s.console.returning && s.storing.read && s.saving.is_none() {
        let bytes = match s.unread {
            Some(b) => b.clone(),
            None => progress::encode(s.progress),
        }
        s.console.save_and_return(SAVE, bytes)
    }
}

/// The margins round the play area: the sky's colour at the top of the page, as the page's
/// finish draws it (art.wrela).
const MARGINS = vec4(0.56, 0.81, 0.96, 1.0)

/// `e` with its place (a pointer's) in the play area's pixels, its top left at `origin` on the
/// screen.
fn in_play(e: Event, origin: vec2) -> Event {
    match e {
        Event::PointerMove { at, mods } => Event::PointerMove { at: at - origin, mods },
        Event::PointerDown { at, button, mods } => {
            Event::PointerDown { at: at - origin, button, mods }
        },
        Event::PointerUp { at, button, mods } => Event::PointerUp { at: at - origin, button, mods },
        Event::Wheel { at, delta, mods } => Event::Wheel { at: at - origin, delta, mods },
        _ => e,
    }
}

/// `rects` (the play area's pixels) on the screen, the play area's top left at `origin`.
fn on_screen(rects: [Rect], origin: vec2) -> Vec<Rect> {
    var out: Vec<Rect> = Vec::with_capacity(rects.len())
    for r in rects {
        out.push(Rect::new(r.x + origin.x, r.y + origin.y, r.w, r.h))
    }
    out
}

/// How far round a pool its water reads the scene under it (m): the wobble's reach and a little
/// (`waves::water`), and how high its waves can rise over its surface.
const WET_MARGIN: f32 = 0.1
const WAVE_ROOM: f32 = 1.5

/// The pools of `c` in the view round `eye` (`half` its half size, m) as rectangles of a scene
/// `size` pixels (left, top, right, bottom), onto `out`: none off the screen.
fn wet_rects(out: mut Vec<vec4>, c: Course, eye: vec2, half: vec2, size: vec2) {
    for w in c.waters {
        let lo = (vec2(w.lo.x - WET_MARGIN, w.lo.y - WET_MARGIN) - eye) / half
        let hi = (vec2(w.hi.x + WET_MARGIN, w.hi.y + WAVE_ROOM) - eye) / half
        if hi.x < -1.0 || lo.x > 1.0 || hi.y < -1.0 || lo.y > 1.0 {
            continue
        }
        let a = vec2(lo.x * 0.5 + 0.5, 0.5 - hi.y * 0.5) * size
        let b = vec2(hi.x * 0.5 + 0.5, 0.5 - lo.y * 0.5) * size
        out.push(vec4(a - vec2(2.0), b + vec2(2.0)))
    }
}

/// Text in `colour` with a soft dark shadow under it, so it reads over the sky and the ground.
fn say(s: mut Lab, face: Face, text: str, size: f32, at: vec2, colour: vec4) {
    let shadow = vec4(0.02, 0.03, 0.05, 0.55 * colour.w)
    let _ = s.list.text(s.fonts, face, text, size, at + vec2(size * 0.07), shadow)
    let _ = s.list.text(s.fonts, face, text, size, at, colour)
}

/// The player's best any% time on course `c` (ticks), or 0 without one.
fn best(s: Lab, c: u32) -> u32 {
    s.progress.records[c].best
}

/// Level `c` on the levels' map, as the player's progress says: finished, the most snacks one run
/// found, and the best any% time.
fn stop_of(s: Lab, c: u32) -> Stop {
    let r = s.progress.records[c]
    Stop {
        name: course::name(c),
        done: r.best > 0,
        found: r.found.count_ones(),
        snacks: course(c).snacks.len(),
        best: r.best,
    }
}

/// The level on the map under the pointer, while the player uses the pointer.
fn map_hovered(s: Lab, screen: vec2) -> Option<u32> {
    if s.device != Device::Keys {
        return None
    }
    let (_, rects) = map_rects(screen, LEVELS)
    for i in 0..rects.len() {
        if rects[i].contains(s.pointer) {
            return Some(i)
        }
    }
    None
}

/// What the pause's facts say of snapshot `snap`'s attempt.
fn facts_of(s: Lab, snap: Snap) -> Facts {
    borrow c = course(snap.course)
    Facts {
        name: course::name(snap.course),
        ticks: if snap.finished > 0 { snap.finished } else { snap.ticks },
        found: (snap.snacks & c.every_snack()).count_ones(),
        snacks: c.snacks.len(),
        deaths: snap.deaths,
        best: best(s, snap.course),
        place: s.place,
    }
}

/// What the frames keep up with from the sim's snapshot `live`, `dt` seconds on: the options'
/// steps taken in the menus, the music as the settings say, the moves the signs have seen made,
/// the attempt's splits against the ghost's run, and how long since it reached the goal.
fn settle(s: mut Lab, live: Snap, dt: f32) {
    match s.turns {
        Some(before) => {
            let place = has_place(s)
            if before != live.turns && turned(mut s.settings, before, live.turns, place) {
                s.storing_settings.unsaved = true
                if before[2] != live.turns[2] {
                    // Another ghost chosen: the race is over.
                    s.race = None
                    s.race_wanted = None
                }
            }
        },
        None => {},
    }
    s.turns = Some(live.turns)
    if s.settings.music != s.music_on {
        s.music_on = s.settings.music
        let music = Cue { kind: sound::MUSIC, amount: if s.music_on { 1.0 } else { 0.0 } }
        match mut s.voice {
            Some(v) => {
                let _ = v.push(music)
            },
            None => {},
        }
    }
    // A whole game played through: its time, the best kept.
    if s.progress.whole_game(live.game) {
        s.storing.unsaved = true
    }
    let made = learned(live)
    if made & !s.settings.learned != 0 {
        s.settings.learned = s.settings.learned | made
        s.storing_settings.unsaved = true
    }
    // The splits: at each checkpoint the attempt reaches, how far ahead or behind the ghost's run.
    if live.attempt != s.split_attempt || live.course != s.shown {
        s.split_attempt = live.attempt
        s.split_checkpoint = 0
        s.split = None
        s.mine.clear()
    }
    if live.checkpoint > s.split_checkpoint {
        s.split_checkpoint = live.checkpoint
        while s.mine.len() < live.checkpoint {
            s.mine.push(live.ticks)
        }
        if live.checkpoint <= s.splits.len() {
            s.split = Some(i32(live.ticks) - i32(s.splits[live.checkpoint - 1]))
            s.split_age = 0.0
        }
    }
    s.split_age += dt
    if live.finished > 0 {
        if s.finish_age == 0.0 {
            s.lost = String::new()
            if s.trail.len() > 1 {
                let end = s.trail.len() - 1
                s.split = Some(i32(live.finished) - i32(end))
                s.split_age = 0.0
                s.lost = lost_words(
                    most_lost(s.mine, live.finished, s.splits, end),
                    min(s.mine.len(), s.splits.len()),
                )
            }
        }
        s.finish_age += dt
    } else {
        s.finish_age = 0.0
    }
}

/// Where the most time went against the ghost (`most_lost`: the stretch and the ticks), as the
/// goal's card says it, with `flags` checkpoints compared.
fn lost_words(lost: Option<(u32, u32)>, flags: u32) -> String {
    let Some((stretch, ticks)) = lost else {
        return String::from("You never fell behind the ghost")
    }
    let t = seconds(ticks)
    if flags == 0 {
        f"You finished {t} s behind the ghost"
    } else if stretch == 0 {
        f"You lost the most time before the first flag ({t} s)"
    } else if stretch == flags {
        f"You lost the most time after the last flag ({t} s)"
    } else {
        let flag = online::ordinal(stretch)
        f"You lost the most time after the {flag} flag ({t} s)"
    }
}

/// The frame counted, and the first whole one said, as engine::frame says it, for the bench's
/// cold and warm starts (docs/bench.md): its backdrop's strips drawn and its text's glyphs in.
fn playable(s: mut Lab) {
    s.frames += 1
    if s.playable_at.is_none() && s.strips.ready == [true; 4] && !s.renderer.waiting() {
        s.playable_at = Some(s.frames)
        print(f"playable at frame {s.frames}")
    }
}

/// The host's answers: its environment (whether it shows a semantic tree), and the requests done.
fn host_answers(s: mut Lab) {
    var said = None
    match mut s.environment {
        Some(p) => said = p.poll(),
        None => {},
    }
    if let Some(result) = said {
        s.environment = None
        match result {
            Ok(b) => {
                let environment = host::read_environment(b)
                s.capabilities = Some(environment.capabilities)
                s.ratio = environment.pixel_ratio.unwrap_or(1.0)
            },
            Err(_) => s.capabilities = Some(0),
        }
    }
    var i = 0
    while i < s.told.len() {
        if s.told[i].poll().is_some() {
            let _ = s.told.remove(i)
        } else {
            i += 1
        }
    }
}

/// The page shown as a semantic tree (screens.wrela's `tree`), if the host shows one: its items,
/// so a click, the keyboard's Tab or a screen reader can choose them; none while playing.
fn publish(s: mut Lab, snap: Snap, play: vec4) {
    let (screen, origin) = (play.zw, play.xy)
    let Some(capabilities) = s.capabilities else { return }
    if capabilities & host::SEMANTICS == 0 {
        return
    }
    var nodes: Vec<Node> = Vec::new()
    if snap.paused == 1 && (s.watching.is_none() || snap.page == RUNS) {
        let page = snap.page
        // The page's heading, its items' labels, and where they are in the play area.
        var parts: Option<(Text, Vec<Text>, Vec<Rect>)> = None
        if page == TITLE {
            let start = start_rect(screen)
            parts = Some((course::name(snap.course), Vec::from(["Start"]), Vec::from([start])))
        } else if page == MENU {
            let (_, rects) = list_rects(screen, MENU)
            parts = Some(("Paused", Vec::from(MENU_LABELS), take rects))
        } else if page == OPTIONS {
            let (_, rects) = list_rects(screen, OPTIONS)
            parts = Some(("Options", Vec::from(OPTION_LABELS), take rects))
        } else if page == CONTROLS {
            let (_, back) = controls_rects(screen)
            parts = Some(("Controls", Vec::from(["Back"]), Vec::from([back])))
        } else if page == RUNS && s.online.consenting.is_some() {
            // The screen of what posting makes public, a modal dialog over the leaderboard.
            lay_posting(mut s, screen)
            let Some((_, laid)) = s.posting_laid else { return }
            nodes = screens::posting_tree(
                snap.chosen + s.consents,
                laid,
                origin,
                best_runs: s.posting_best,
                focus: s.posting_focus,
            )
        } else if page == RUNS {
            // Back and the search's tab on the board, and its parts' boxes while it's shown; Race
            // while a run is watched (world.wrela's `RUNS_BACK`, `RUNS_RACE`, `RUNS_SEARCH`,
            // `RUNS_PART`). A press on the tab or a box opens the search.
            let none = Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0)
            var rects = Vec::from([none, none, none, none, none, none])
            if s.watching.is_some() {
                rects[RUNS_RACE] = race_rect(screen)
            } else {
                rects[RUNS_BACK] = back_rect(screen)
                rects[RUNS_SEARCH] = board_rect(screen, online::SEARCH)
                if s.board == online::SEARCH {
                    for p in 0..search::PARTS {
                        rects[RUNS_PART + p] = part_rect(screen, p)
                    }
                }
            }
            let labels = Vec::from(["Back", "Race", "Search names", "Title", "Name", "Epithet"])
            parts = Some(("Leaderboard", take labels, take rects))
        } else if page == FIND {
            // Its tab again searches, back on the board.
            let tab = board_rect(screen, online::SEARCH)
            parts = Some(("Search names", Vec::from(["Search"]), Vec::from([tab])))
        } else if page == MAP {
            let (_, rects) = map_rects(screen, LEVELS)
            var names: Vec<Text> = Vec::new()
            for c in 0..LEVELS {
                names.push(course::name(c))
            }
            parts = Some(("Levels", take names, take rects))
        }
        if let Some((heading, labels, rects)) = parts {
            nodes = tree(snap.chosen, page, heading, labels, on_screen(rects, origin))
        }
    }
    host::publish(mut s.told, mut s.tree, "O'Capy", nodes, play)
}

/// The item of list page `page` under the pointer, while the player uses the pointer.
fn hovered(s: Lab, screen: vec2, page: u32) -> Option<u32> {
    if s.device != Device::Keys {
        return None
    }
    let (_, rects) = list_rects(screen, page)
    for i in 0..rects.len() {
        if rects[i].contains(s.pointer) {
            return Some(i)
        }
    }
    None
}

/// The screens over the page (screens.wrela). Paused: the page shown, and the prompts for it.
/// Watching a run: its bar. Playing: the title fading as the first attempt begins, the clock if
/// the options show it, the card at the goal, and with F3 the readout. (The snacks' count is
/// drawn on the plane of play, in ink: cast.wrela.)
fn hud(s: mut Lab, snap: Snap, screen: vec2, time: f32) {
    s.list.clear(screen)
    if HERO || s.role == Role::Attract {
        return
    }
    let u = unit(screen)
    let d = s.device
    if s.watching.is_some() {
        watch_bar(mut s, screen)
        return
    }
    if snap.paused == 1 {
        let page = snap.page
        if page == TITLE {
            let over = over_title(s, snap.course)
            title(
                mut s.list,
                s.fonts,
                course::name(snap.course),
                screen,
                d,
                1.0,
                waiting: true,
                time: time,
                over: over.as_str(),
            )
        } else if page == MENU {
            // The course's world board, asked for while the menu shows in the background (only
            // for a player who is signed in, so play stays offline otherwise: online.wrela's
            // `By`): the facts say the player's place, and the leaderboard opens on it.
            online::want(mut s.online, snap.course, ANY, By::Background)
            let hover = hovered(s, screen, MENU)
            screens::list(
                mut s.list,
                s.fonts,
                screen,
                MENU,
                "Paused",
                MENU_LABELS,
                [],
                snap.focus,
                hover,
            )
            facts(mut s.list, s.fonts, screen, facts_of(s, snap))
            footer(
                mut s.list,
                s.fonts,
                [
                    Prompt { act: Act::Move, say: "Move" },
                    Prompt { act: Act::Choose, say: "Choose" },
                    Prompt { act: Act::Back, say: "Resume" },
                ],
                d,
                screen,
            )
        } else if page == OPTIONS {
            let hover = hovered(s, screen, OPTIONS)
            let values = option_values(s.settings, place: has_place(s))
            screens::list(
                mut s.list,
                s.fonts,
                screen,
                OPTIONS,
                "Options",
                OPTION_LABELS,
                values,
                snap.focus,
                hover,
                note: option_about(snap.focus),
            )
            footer(
                mut s.list,
                s.fonts,
                [
                    Prompt { act: Act::Move, say: "Move" },
                    Prompt { act: Act::Change, say: "Change" },
                    Prompt { act: Act::Back, say: "Back" },
                ],
                d,
                screen,
            )
        } else if page == CONTROLS {
            let (_, back) = controls_rects(screen)
            let hover = d == Device::Keys && back.contains(s.pointer)
            controls(mut s.list, s.fonts, screen, d, hover)
        } else if page == RUNS || page == FIND {
            runs_card(mut s, snap.course, screen, finding: page == FIND)
        } else if page == MAP {
            var stops: Vec<Stop> = Vec::new()
            for c in 0..LEVELS {
                stops.push(stop_of(s, c))
            }
            let hover = map_hovered(s, screen)
            map(mut s.list, s.fonts, screen, stops, snap.focus, hover)
            footer(
                mut s.list,
                s.fonts,
                [
                    Prompt { act: Act::Run, say: "Move" },
                    Prompt { act: Act::Choose, say: "Play" },
                    Prompt { act: Act::Back, say: "Back" },
                ],
                d,
                screen,
            )
        }
        return
    }
    // The title, fading as the first attempt begins, and as it goes, the card of the sign in
    // reach (signs.wrela).
    let since = f32(snap.ticks) / f32(HZ)
    let titled = if snap.attempt == 0 { 1.0 - smoothstep(0.6, 2.4, since) } else { 0.0 }
    if snap.finished == 0 {
        let alpha = s.sign_card.alpha() * (1.0 - titled)
        sign_card(mut s.list, mut s.sign_wraps, s.fonts, s.sign_card, d, screen, alpha)
    }
    if titled > 0.0 {
        let alpha = titled
        let over = over_title(s, snap.course)
        title(
            mut s.list,
            s.fonts,
            course::name(snap.course),
            screen,
            d,
            alpha,
            waiting: false,
            time: time,
            over: over.as_str(),
        )
    }
    if s.settings.clock {
        let ticks = if snap.finished > 0 { snap.finished } else { snap.ticks }
        clock(mut s.list, s.fonts, screen, ticks, snap.finished > 0, s.split, s.split_age)
    }
    if snap.finished > 0 && s.finish_age > FINISH_CARD {
        let alpha = smoothstep(FINISH_CARD, FINISH_CARD + 0.5, s.finish_age)
        let more = world::next(snap.course).is_some()
        var notes = goal_notes(s)
        if let Some(line) = online::reminder(s.online) {
            notes.push(String::from(line))
            s.reminder_seen = true
        }
        goal_card(
            mut s.list,
            s.fonts,
            screen,
            facts_of(s, snap),
            s.best_before,
            d,
            alpha,
            more: more,
            ending: cast::ending(snap),
            game: snap.game,
            best_game: s.progress.game,
            notes: notes,
        )
    }
    if s.readout {
        // The frame rate, the frame's time, and the size the scene is drawn at: native (the
        // screen's own) or the render scale's.
        let ms = s.frame_time * 1000.0
        let fps = if s.frame_time > 0.0 { 1.0 / s.frame_time } else { 0.0 }
        let at = if s.sheet.scale.value >= 1.0 { f"native" } else {
            f"{s.sheet.scale.value * 100.0:.0}%"
        }
        let readout = f"{fps:.0} fps  {ms:.1} ms  {at} {s.sheet.width}x{s.sheet.height}"
        say(
            mut s,
            Face::Mono,
            readout.as_str(),
            u * 2.1,
            vec2(u * 2.6, u * 9.0),
            vec4(1.0, 0.98, 0.94, 0.75),
        )
    }
}

/// The line over the level's title: whose run a race is against, or the game's.
fn over_title(s: Lab, c: u32) -> String {
    match s.race {
        Some((r, name)) => {
            if r.course == c {
                return f"Racing {name}"
            }
        },
        None => {},
    }
    // A world's run to race whose replay is on its way: given up if it can't come.
    if let Some((_, name)) = s.race_wanted {
        return f"Racing {name}"
    }
    String::from("A day at the zoo")
}

/// What the goal's card says under the snacks: against a ghost, where the most time went; and how
/// the run's post went, if it's being posted.
fn goal_notes(s: Lab) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    if !s.lost.is_empty() {
        out.push(s.lost.clone())
    }
    if !s.finished_print.is_empty() {
        let said = online::status(s.online, s.finished_print)
        if !said.is_empty() {
            out.push(take said)
        }
    }
    out
}

/// Whether the signed-in player has a place on the live course's world board (any%), as last
/// given.
fn has_place(s: Lab) -> bool {
    s.placed
}

// ---- runs ----------------------------------------------------------------------------------------

/// Keeps the attempt in `snap` once it reaches the goal: its course's record, and its run if it's
/// among the player's best; and stores the progress.
fn keep_finished(s: mut Lab, snap: Snap) {
    let key = snap.course << 16 | (snap.attempt & 0xffff)
    if snap.finished == 0 || key == s.kept {
        return
    }
    s.kept = key
    if s.progress.finished(snap.course, ticks: snap.finished, snacks: snap.snacks) {
        s.storing.unsaved = true
    }
    s.finished_print.clear()
    if let Some(r) = replay(snap, YOU) {
        if verify(r) {
            // To the world's board, if it beats the account's place there and the account posts
            // its best runs (or waiting until it can: online.wrela).
            online::finished(mut s.online, r.clone())
            s.finished_print = online::fingerprint(r)
            if s.progress.runs.add(take r) {
                s.storing.unsaved = true
                s.trail_of = 0
                s.prints.clear()
            }
        }
    }
}

/// How long a load or a store of the runs that failed waits before it's made again (s).
const RETRY: f32 = 2.0

/// When the runs load and are stored: whether the stored ones have been read (or there were
/// none), seconds until a request that failed is made again, and whether the runs changed since
/// they were last stored. The online state's stores keep to it too (online.wrela).
pub struct Storing: Copy {
    pub read: bool = false,
    retry: f32 = 0.0,
    pub unsaved: bool = false,
}

impl Storing {
    /// After a load: of the stored runs, or of nothing stored, they're `read`; a load that failed
    /// otherwise is made again after `RETRY`.
    pub fn loaded(mut self, read: bool) {
        if read {
            self.read = true
        } else {
            self.retry = RETRY
        }
    }

    /// After a store: one that failed is made again after `RETRY`, of the runs as they are then.
    pub fn stored(mut self, ok: bool) {
        if !ok {
            self.unsaved = true
            self.retry = RETRY
        }
    }

    /// `dt` seconds on, with a load or a store still waiting or not: whether to load the runs now,
    /// and whether to store them now (they're then no longer unsaved). Never a store before the
    /// stored runs are read: storing over runs that couldn't be read would lose them.
    pub fn due(mut self, dt: f32, loading: bool, saving: bool) -> (bool, bool) {
        self.retry = max(self.retry - dt, 0.0)
        if self.retry > 0.0 {
            return (false, false)
        }
        let stores = self.read && self.unsaved && !saving
        if stores {
            self.unsaved = false
        }
        (!self.read && !loading, stores)
    }
}

/// Reads the stored progress once it loads, `dt` seconds after the last frame, and stores it when
/// it's changed, one store at a time, and only once the stored ones are read or are known to
/// be none (`IoError::missing`). A load or a store that failed is made again (`Storing`).
fn store_progress(s: mut Lab, dt: f32) {
    var loaded = None
    match mut s.loading {
        Some(p) => loaded = p.poll(),
        None => {},
    }
    if let Some(result) = loaded {
        s.loading = None
        match result {
            Ok(b) => {
                let stored = progress::read(b.clone())
                if stored.is_none() && !b.is_empty() {
                    s.unread = Some(b.clone())
                }
                s.progress = progress::merged(stored, s.progress.clone())
                s.trail_of = 0
                s.prints.clear()
                s.storing.loaded(read: true)
            },
            Err(e) => s.storing.loaded(read: e.missing()),
        }
    }
    var stored = None
    match mut s.saving {
        Some(p) => stored = p.poll(),
        None => {},
    }
    if let Some(result) = stored {
        s.saving = None
        s.storing.stored(ok: result.is_ok())
    }
    // Returning to the console, its link's store is the one writer: a change waits, unsaved, and
    // is stored after if that store fails and the game stays.
    let (loads, stores) = s.storing.due(
        dt,
        loading: s.loading.is_some(),
        saving: s.saving.is_some() || s.console.returning || s.unread.is_some(),
    )
    if loads {
        s.loading = Some(load(SAVE))
    }
    if stores {
        s.saving = Some(store(SAVE, progress::encode(s.progress)))
    }
}

/// Reads the stored settings once they load, and stores them when they've changed, as the runs
/// are (`store_progress`). Settings changed before the stored ones are read stay as changed.
fn store_settings(s: mut Lab, dt: f32) {
    var loaded = None
    match mut s.loading_settings {
        Some(p) => loaded = p.poll(),
        None => {},
    }
    if let Some(result) = loaded {
        s.loading_settings = None
        match result {
            Ok(b) => {
                if !s.storing_settings.unsaved {
                    s.settings = decode(b)
                } else {
                    // A move learned or a key pressed before they loaded: keep both.
                    s.settings.learned = s.settings.learned | decode(b).learned
                }
                s.trail_of = 0
                s.storing_settings.loaded(read: true)
            },
            Err(e) => s.storing_settings.loaded(read: e.missing()),
        }
    }
    var stored = None
    match mut s.saving_settings {
        Some(p) => stored = p.poll(),
        None => {},
    }
    if let Some(result) = stored {
        s.saving_settings = None
        s.storing_settings.stored(ok: result.is_ok())
    }
    let (loads, stores) = s.storing_settings.due(
        dt,
        loading: s.loading_settings.is_some(),
        saving: s.saving_settings.is_some(),
    )
    if loads {
        s.loading_settings = Some(load(SETTINGS))
    }
    if stores {
        s.saving_settings = Some(store(SETTINGS, encode(s.settings)))
    }
}

/// The runs of course `c` that count for `category` on the board shown (the player's or the
/// tool-assisted ones), fastest first.
fn listed(s: Lab, c: u32, category: u32) -> Vec<Replay> {
    if s.board == PLAYERS {
        return s.progress.runs.ranked(c, category)
    }
    assisted(s, c, category)
}

/// Which of `s.prints` holds the fingerprints of the player's runs of course `c` that count for
/// `category`, in `listed`'s order: worked out the first time, and again once the runs change.
fn prints_of(s: mut Lab, c: u32, category: u32) -> u32 {
    for k in 0..s.prints.len() {
        if s.prints[k].0 == c && s.prints[k].1 == category {
            return k
        }
    }
    var hashes: Vec<Vec<u8>> = Vec::new()
    for r in s.progress.runs.ranked(c, category) {
        hashes.push(online::fingerprint(r))
    }
    s.prints.push((c, category, take hashes))
    s.prints.len() - 1
}

/// Course `c`'s tool-assisted runs made, if they aren't.
fn made_assisted(s: mut Lab, c: u32) {
    if s.assisted_of != Some(c) {
        s.assisted = tool_assisted(c)
        s.assisted_of = Some(c)
    }
}

/// The tool-assisted runs of course `c` made for `category`, fastest first.
fn assisted(s: Lab, c: u32, category: u32) -> Vec<Replay> {
    var out: Vec<Replay> = Vec::new()
    for r in s.assisted {
        // Each searched run is for one category: a 100% run isn't listed again under any%.
        let own = category == FULL || !counts(r, FULL)
        if r.course == c && counts(r, category) && own {
            out.push(r.clone())
        }
    }
    out.sort_by(|a, b| a.ticks < b.ticks)
    out
}

/// The ghost's run on course `c`: the run raced, or the options' ghost: the player's best any%
/// run, the fastest any% run of the robot or of the human line, or a world's run held (the record,
/// or the one above the player's place).
fn ghost_run(s: Lab, c: u32) -> Option<Replay> {
    match s.race {
        Some((r, _)) => {
            if r.course == c {
                return Some(r.clone())
            }
        },
        None => {},
    }
    let g = ghost_of(s.settings, has_place(s))
    if g == ABOVE_GHOST || g == RECORD_GHOST {
        if s.ghost_hash.is_empty() {
            return None
        }
        return online::held(s.online, s.ghost_hash)
    }
    if g == BEST_GHOST {
        let best = s.progress.runs.ranked(c, ANY)
        if best.len() > 0 {
            return Some(best[0].clone())
        }
    } else if g == AUTOPILOT_GHOST || g == HUMAN_GHOST {
        let who = if g == HUMAN_GHOST { HUMAN } else { AUTOPILOT }
        for r in assisted(s, c, ANY) {
            if r.who == who {
                return Some(r.clone())
            }
        }
    }
    None
}

/// Who made a run, as the board and the watch name them.
fn who_name(who: u32) -> Text {
    if who == YOU {
        "You"
    } else if who == HUMAN { "Human line" } else { "Robot" }
}

/// The trail of the ghost's run on course `c`, and its splits, worked out again when the course,
/// the ghost, the player's runs or the world's run it follows change. A world's ghost asks for its
/// board only for a player who is signed in (play stays offline otherwise), and for its run's
/// replay once the board names it: the trail is the run's own, and starts once it has come.
fn follow_ghost(s: mut Lab, c: u32) {
    match s.race {
        Some((r, _)) => {
            if r.course != c {
                s.race = None
            }
        },
        None => {},
    }
    let g = ghost_of(s.settings, has_place(s))
    var hash: Vec<u8> = Vec::new()
    // Signed in (online.wrela's `By::Background`), the course's board once: whether the player
    // has a place (the ghost at first is the run above it), and a world's ghost's run.
    let world_ghost = g == ABOVE_GHOST || g == RECORD_GHOST
    if world_ghost || !s.settings.chosen {
        online::want_once(mut s.online, c, ANY)
    }
    if s.race.is_none() && world_ghost {
        if let Some(h) = online::ghost_hash(s.online, c, record: g == RECORD_GHOST) {
            hash = h.clone()
            online::fetch_now(mut s.online, h)
        }
    }
    // A world's run counts once its replay is held.
    let ready = !hash.is_empty() && online::is_held(s.online, hash)
    let key = (c + 1) << 8 | g << 1 | if ready { 1 } else { 0 }
    if key == s.trail_of && hash == s.ghost_hash {
        return
    }
    s.trail_of = key
    s.ghost_name = match online::whose(s.online, c, hash) {
        Some((name, _)) => name.clone(),
        None => String::new(),
    }
    s.ghost_hash = take hash
    if g == AUTOPILOT_GHOST || g == HUMAN_GHOST {
        made_assisted(mut s, c)
    }
    s.trail = match ghost_run(s, c) {
        Some(r) => trail(r),
        None => Vec::new(),
    }
    s.splits = splits(s.trail)
}

/// The runs card's size, for the screen: its rect and its text size.
fn runs_frame(screen: vec2) -> (Rect, f32) {
    let u = unit(screen)
    let size = u * 2.9
    let w = min(screen.x - u * 6.0, size * 40.0)
    let h = size * 22.5
    (Rect::new((screen.x - w) * 0.5, (screen.y - h) * 0.5 - u * 3.0, w, h), size)
}

/// Where board `b`'s name is on the runs card, which a click chooses.
fn board_rect(screen: vec2, b: u32) -> Rect {
    let (r, size) = runs_frame(screen)
    let gap = size * 0.4
    let n = f32(online::BOARDS)
    let w = min(size * 8.0, (r.w - size * 2.4 - gap * (n - 1.0)) / n)
    let x = r.x + r.w * 0.5 - (w * n + gap * (n - 1.0)) * 0.5 + f32(b) * (w + gap)
    Rect::new(x, r.y + size * 3.2, w, size * 1.6)
}

/// The first row a board's places take: the search's line takes the first (online.wrela's
/// `shown_rows`).
fn first_row(board: u32) -> u32 {
    if board == online::SEARCH { 1 } else { 0 }
}

/// Where the search's part `part` is on the runs card: the title, the noun, and after "the", the
/// epithet.
fn part_rect(screen: vec2, part: u32) -> Rect {
    let (r, size) = runs_frame(screen)
    let gap = size * 0.5
    let the = size * 2.2
    let room = r.w - size * 2.4 - the - gap * 3.0
    let widths = [room * 0.3, room * 0.4, room * 0.3]
    var x = r.x + size * 1.2
    for p in 0..part {
        x += widths[p] + gap
        if p == search::NOUN {
            x += the + gap
        }
    }
    Rect::new(x, r.y + size * 5.4, widths[part], size * 1.9)
}

/// Where row `i` of a category's list is on the runs card.
fn row_rect(screen: vec2, category: u32, i: u32) -> Rect {
    let (r, size) = runs_frame(screen)
    let w = (r.w - size * 3.0) * 0.5
    let x = r.x + size * 1.2 + f32(category) * (w + size * 0.6)
    Rect::new(x, r.y + size * 8.0 + f32(i) * size * 1.7, w, size * 1.5)
}

/// Where the runs card's back button is.
fn back_rect(screen: vec2) -> Rect {
    let (r, size) = runs_frame(screen)
    Rect::new(r.right() - size * 6.6, r.bottom() - size * 3.0, size * 5.4, size * 2.0)
}

/// A key or click while the runs are open (the sim leaves them to the frames, and only closes the
/// page, opens the search and starts a race). On the board: up and down move the focus along a
/// category's runs, left and right between the categories, Tab or a controller's shoulders switch
/// boards, choosing a run (or a click on it) watches it, R or Select races it, and U or Y posts one
/// of the player's own. Watching: Space or A pauses and plays, left and right seek, up and down
/// change the speed, Home or Y starts it again, and R or Select races it.
fn browse(s: mut Lab, e: Event, c: u32, screen: vec2) {
    made_assisted(mut s, c)
    let nav = s.nav.nav(e)
    // F opens the search as it comes up (world.wrela's `finds`); while it's down, what it types
    // isn't typed into the search, whatever the keyboard's layout.
    if let Event::KeyDown { key, repeat, .. } = e {
        if key == Key::F && !repeat {
            s.opener = true
        }
    }
    if finds(e) {
        s.opener = false
        return
    }
    // A press on the search's tab or one of its boxes: the sim opens it, on that part.
    if pressed_node(s, e, RUNS_SEARCH) {
        s.board = online::SEARCH
        return
    }
    for p in 0..search::PARTS {
        if pressed_node(s, e, RUNS_PART + p) {
            s.board = online::SEARCH
            s.search.to(p)
            return
        }
    }
    if races(e) || pressed_node(s, e, RUNS_RACE) {
        race_focused(mut s, c)
        return
    }
    var watched = false
    match mut s.watching {
        Some(w) => {
            watched = true
            if device_of(e).is_some() {
                s.idle = 0.0
            }
            let again = match e {
                Event::KeyDown { key, repeat, .. } => key == Key::Home && !repeat,
                Event::PadButton { pad, button, pressed, .. } => {
                    pad == 0 && pressed && button == PadButton::North
                },
                _ => false,
            }
            if again {
                w.seek(0)
                w.playing = true
            } else if nav == Some(Nav::Choose) {
                if !w.playing && w.tick >= w.end() {
                    w.seek(0)
                }
                w.playing = !w.playing
            } else if nav == Some(Nav::Right) {
                w.seek(w.tick + SEEK)
            } else if nav == Some(Nav::Left) {
                w.seek(if w.tick > SEEK { w.tick - SEEK } else { 0 })
            } else if nav == Some(Nav::Up) {
                w.speed = min(w.speed + 1, SPEEDS.len() - 1)
            } else if nav == Some(Nav::Down) {
                w.speed = if w.speed > 0 { w.speed - 1 } else { 0 }
            }
        },
        None => {},
    }
    if watched {
        return
    }
    let switch = match e {
        Event::KeyDown { key, repeat, .. } => key == Key::Tab && !repeat,
        Event::PadButton { pad, button, pressed, .. } => {
            pad == 0 &&
                pressed &&
                (button == PadButton::LeftShoulder || button == PadButton::RightShoulder)
        },
        _ => false,
    }
    let post = match e {
        Event::KeyDown { key, repeat, .. } => key == Key::U && !repeat,
        Event::PadButton { pad, button, pressed, .. } => pad == 0 &&
            pressed &&
            button == PadButton::North,
        _ => false,
    }
    // Home or a controller's trigger: between the top of a world's board and the account's place.
    let jump = match e {
        Event::KeyDown { key, repeat, .. } => key == Key::Home && !repeat,
        Event::PadButton { pad, button, pressed, .. } => {
            pad == 0 &&
                pressed &&
                (button == PadButton::LeftTrigger || button == PadButton::RightTrigger)
        },
        _ => false,
    }
    let world = worldly(s.board)
    if switch {
        to_board(mut s, (s.board + 1) % online::BOARDS)
    } else if jump && jumps(s, c) {
        s.near = !s.near
        s.first = [0; 2]
        s.anchored = [false; 2]
        s.row = 0
    } else if post && s.board == PLAYERS {
        let runs = listed(s, c, s.column)
        if runs.len() > 0 {
            online::post(mut s.online, runs[min(s.row, runs.len() - 1)].clone())
        }
    } else if nav == Some(Nav::Choose) && world {
        let places = board_places(mut s, c, s.column)
        if places.len() > 0 {
            online::watch_place(mut s.online, places[min(s.row, places.len() - 1)].clone())
        }
    } else if nav == Some(Nav::Up) {
        if s.row > 0 {
            s.row -= 1
        } else if world && s.first[s.column] > 0 {
            // Past the top row shown: the board moves down one.
            s.first[s.column] -= 1
        }
    } else if nav == Some(Nav::Down) {
        if !world || s.row + 1 < rows(mut s, c, s.column) {
            s.row += 1
        } else {
            scroll_down(mut s, c)
        }
    } else if nav == Some(Nav::Left) || nav == Some(Nav::Right) {
        s.column = if nav == Some(Nav::Left) { ANY } else { FULL }
    } else if nav == Some(Nav::Choose) {
        let runs = listed(s, c, s.column)
        if runs.len() > 0 {
            let i = min(s.row, runs.len() - 1)
            open_watch(mut s, runs[i].clone())
        }
    }
    let (column, row) = (s.column, s.row)
    s.row = min(row, max(rows(mut s, c, column), 1) - 1)
    if let Event::PointerDown { at, .. } = e {
        s.pointer = at
        let first = first_row(s.board)
        if world {
            for category in [ANY, FULL] {
                let places = board_places(mut s, c, category)
                for i in 0..places.len() {
                    if row_rect(screen, category, i + first).contains(at) {
                        s.column = category
                        s.row = i
                        online::watch_place(mut s.online, places[i].clone())
                    }
                }
            }
        }
        for b in 0..online::BOARDS {
            if board_rect(screen, b).contains(at) {
                to_board(mut s, b)
            }
        }
        if !world {
            for category in [ANY, FULL] {
                let runs = listed(s, c, category)
                for i in 0..runs.len() {
                    if row_rect(screen, category, i).contains(at) {
                        s.column = category
                        s.row = i
                        open_watch(mut s, runs[i].clone())
                    }
                }
            }
        }
    }
}

/// A key, a click or a press on a node while the screen of what posting makes public is up, over
/// the leaderboard. In a browser the dialog takes the keyboard (screens.wrela's `posting_tree`):
/// its presses, focus and dismissal come as `Event::Assist`. Elsewhere, and on a controller, up and
/// down go between the box and the buttons, left and right between the buttons, and choosing (a
/// jump's key, Enter or A, or a click) ticks the box or presses the button; B leaves the
/// leaderboard, which is Not now. Post
/// records the player's agreement through the console (online.wrela's `consent`), and the run
/// goes.
fn consenting_input(s: mut Lab, e: Event, screen: vec2) {
    let nav = s.nav.nav(e)
    var chosen: Option<u32> = None
    if let Event::Assist { node, action } = e {
        let (page, item) = world::item_of(node)
        if node != 0 && page == world::POSTING {
            if item == world::PAGE_NODE && action == std::input::Assist::Dismiss {
                chosen = Some(screens::POSTING_NOT_NOW)
            } else if item < screens::POSTING_ITEMS {
                if action == std::input::Assist::Activate {
                    chosen = Some(item)
                } else if action == std::input::Assist::Focus {
                    s.posting_focus = item
                }
            }
        }
    }
    if let Event::PointerDown { at, .. } = e {
        s.pointer = at
        lay_posting(mut s, screen)
        let Some((_, laid)) = s.posting_laid else { return }
        let controls = laid.controls.clone()
        for i in 0..screens::POSTING_ITEMS {
            if controls[i].contains(at) {
                s.posting_focus = i
                chosen = Some(i)
            }
        }
    }
    let focus = s.posting_focus
    if nav == Some(Nav::Choose) {
        chosen = Some(focus)
    } else if nav == Some(Nav::Up) {
        s.posting_focus = screens::POSTING_BOX
    } else if nav == Some(Nav::Down) && focus == screens::POSTING_BOX {
        s.posting_focus = screens::POSTING_POST
    } else if nav == Some(Nav::Left) && focus == screens::POSTING_NOT_NOW {
        s.posting_focus = screens::POSTING_POST
    } else if nav == Some(Nav::Right) && focus == screens::POSTING_POST {
        s.posting_focus = screens::POSTING_NOT_NOW
    }
    match chosen {
        Some(i) => {
            if i == screens::POSTING_BOX {
                s.posting_best = !s.posting_best
            } else {
                online::consent(
                    mut s.online,
                    post: i == screens::POSTING_POST,
                    best_runs: s.posting_best,
                )
            }
        },
        None => {},
    }
}

/// The screen of what posting makes public laid out for `screen` (`posting_laid`): once a size,
/// not each time it's drawn, pressed or published.
fn lay_posting(s: mut Lab, screen: vec2) {
    let laid_for = match s.posting_laid {
        Some((at, _)) => at.x == screen.x && at.y == screen.y,
        None => false,
    }
    if !laid_for {
        s.posting_laid = Some((screen, screens::posting_laid(s.fonts, screen)))
    }
}

/// Whether event `e` is a press on the runs' page's node `item`, as the sim reads it.
fn pressed_node(s: Lab, e: Event, item: u32) -> bool {
    if let Event::Assist { node, action } = e {
        let (page, i) = world::item_of(node)
        return node != 0 && page == RUNS && i == item && action == std::input::Assist::Activate
    }
    false
}

/// Whether board `b` is one of the world's: its places come from the console's server.
fn worldly(b: u32) -> bool {
    b == online::WORLD || b == online::SEARCH || b == online::WHOLE_GAME
}

/// A race (the sim restarts the level on its title): the run watched, or the one with the focus,
/// as the ghost. A world's run whose replay isn't held yet is asked for, and becomes the ghost
/// when it comes.
fn race_focused(s: mut Lab, c: u32) {
    s.race_wanted = None
    var named = s.watch_name.clone()
    var chosen: Option<Replay> = None
    match s.watching {
        Some(w) => chosen = Some(w.replay.clone()),
        None => {},
    }
    if chosen.is_none() && worldly(s.board) {
        let places = board_places(mut s, c, s.column)
        if places.len() > 0 {
            borrow p = places[min(s.row, places.len() - 1)]
            named = p.name.clone()
            match online::held(s.online, p.replay) {
                Some(r) => chosen = Some(take r),
                None => {
                    if !p.replay.is_empty() {
                        s.race_wanted = Some((p.replay.clone(), p.name.clone()))
                        online::fetch_now(mut s.online, p.replay.clone())
                    }
                },
            }
        }
    } else if chosen.is_none() {
        let runs = listed(s, c, s.column)
        if runs.len() > 0 {
            let r = runs[min(s.row, runs.len() - 1)].clone()
            named = String::new()
            chosen = Some(take r)
        }
    }
    if let Some(r) = chosen {
        if r.course == c {
            if named.is_empty() {
                named = String::from(if r.who == YOU { "your run" } else if r.who == HUMAN {
                    "the human line"
                } else { "the robot" })
            }
            s.race = Some((r.clone(), take named))
        }
    }
    s.trail_of = 0
}

/// A key, a character or a click while the search is open (the sim leaves its keys to the frames,
/// and closes it on Esc, Enter, or a controller's A, B or Start). Typing goes to the part with the
/// focus, which completes from its list; Backspace takes a character off; up and down (or Tab) go
/// between the parts; left and right pick among the part's completions, as a controller does; and
/// closing it searches at once.
fn find(s: mut Lab, e: Event, screen: vec2, time: f32) {
    var changed = false
    match e {
        Event::Text { char } => {
            // What the F that opened the search typed, if it came after: not typed into it.
            if !s.opener {
                changed = s.search.typed(char)
            }
        },
        Event::KeyUp { key, .. } => {
            if key == Key::F {
                s.opener = false
            }
        },
        Event::KeyDown { key, repeat, .. } => {
            // Another key: what it types is the player's.
            s.opener = false
            if key == Key::Backspace {
                changed = s.search.erase()
            } else if key == Key::Up && s.search.part > 0 {
                s.search.to(s.search.part - 1)
            } else if key == Key::Down || (key == Key::Tab && !repeat) {
                s.search.to(if key == Key::Tab { (s.search.part + 1) % search::PARTS } else {
                    s.search.part + 1
                })
            } else if key == Key::Left || key == Key::Right {
                changed = s.search.turn(if key == Key::Left { -1 } else { 1 })
            }
        },
        Event::PadButton { pad, button, pressed, .. } => {
            if pad == 0 && pressed {
                if button == PadButton::Up && s.search.part > 0 {
                    s.search.to(s.search.part - 1)
                } else if button == PadButton::Down {
                    s.search.to(s.search.part + 1)
                } else if button == PadButton::Left || button == PadButton::Right {
                    changed = s.search.turn(if button == PadButton::Left { -1 } else { 1 })
                }
            }
        },
        Event::PointerDown { at, .. } => {
            s.pointer = at
            for p in 0..search::PARTS {
                if part_rect(screen, p).contains(at) {
                    s.search.to(p)
                }
            }
        },
        _ => {},
    }
    if changed {
        s.search_changed = true
        s.search_at = time
        s.row = 0
    }
    var done = leaves_find(e)
    if let Event::Assist { node, action } = e {
        let (page, _) = world::item_of(node)
        done = node != 0 && page == FIND && action == std::input::Assist::Activate
    }
    if done {
        s.search.to(s.search.part)
        ask_search(mut s)
        s.row = 0
    }
}

/// The search asked for, as its parts stand.
fn ask_search(s: mut Lab) {
    s.search_changed = false
    let (title, noun, epithet) = (
        s.search.value(search::TITLE),
        s.search.value(search::NOUN),
        s.search.value(search::EPITHET),
    )
    online::search(mut s.online, s.shown, title.as_str(), noun.as_str(), epithet.as_str())
}

/// Watches run `r` from its start.
fn open_watch(s: mut Lab, r: take Replay) {
    s.watching = Some(watch(take r))
    s.watch_name = String::new()
    s.watch_place = 0
    s.idle = 0.0
}

/// The leaderboard on board `b`: a world's board opens at the account's place, if it has one.
fn to_board(s: mut Lab, b: u32) {
    online::cancel_watch(mut s.online)
    s.board = b
    s.row = 0
    s.near = true
    s.first = [0; 2]
    s.anchored = [false; 2]
}

/// Whether the board shown can move between its top and the account's place: a world's board,
/// not its search, on which the account has a place, in the category with the focus.
fn jumps(s: Lab, c: u32) -> bool {
    if s.board != online::WORLD && s.board != online::WHOLE_GAME {
        return false
    }
    online::placed(s.online, online::board_course(s.board, c), s.column)
}

/// Down past the last row shown of a world's board: the board moves up one, asking for its next
/// page when the rows from the top run out.
fn scroll_down(s: mut Lab, c: u32) {
    let k = s.column
    let all = board_list(s, c, k)
    if s.first[k] + online::shown_rows(s.board) < all.len() {
        s.first[k] += 1
    } else if s.board != online::SEARCH && !near_slice(s, c, k) {
        online::more(mut s.online, online::board_course(s.board, c), k)
    }
}

/// Whether the world's board shown for `category` is the slice round the account's place.
fn near_slice(s: Lab, c: u32, category: u32) -> bool {
    s.near && !online::slice(s.online, online::board_course(s.board, c), category).is_empty()
}

/// How many rows the board shown has for course `c` and `category`.
fn rows(s: mut Lab, c: u32, category: u32) -> u32 {
    if worldly(s.board) {
        return board_places(mut s, c, category).len()
    }
    listed(s, c, category).len()
}

/// What the rows `places` are, for fetching their replays ahead only when they change: their
/// replays' bytes, and how many replays had been let go (online.wrela's `let_go`), as an FNV-1a
/// hash.
fn rows_key(o: online::Online, places: [Place]) -> u64 {
    let prime: u64 = 1099511628211
    var h: u64 = 14695981039346656037 ^ u64(online::let_go(o))
    for p in places {
        for b in p.replay {
            h = (h ^ u64(b)).wrapping_mul(prime)
        }
        h = (h ^ 256).wrapping_mul(prime)
    }
    h
}

/// All the places of the world's board shown for course `c` and `category`: its search's; or the
/// world's (or its whole game's) round the account's place when the leaderboard is near it and
/// the slice has come, else its pages from the top.
fn board_list(s: Lab, c: u32, category: u32) -> Vec<Place> {
    if s.board == online::SEARCH {
        return online::found_places(s.online, c, category)
    }
    let course = online::board_course(s.board, c)
    if near_slice(s, c, category) {
        return online::slice(s.online, course, category)
    }
    let (places, _) = online::places(s.online, course, category)
    places
}

/// The rows of the world's board shown for course `c` and `category`, as many as it shows from the
/// first (`first`): near the account's place, put there once it's among them.
fn board_places(s: mut Lab, c: u32, category: u32) -> Vec<Place> {
    let all = board_list(s, c, category)
    let shown = online::shown_rows(s.board)
    if s.near && !s.anchored[category] && s.board != online::SEARCH && s.online.account.signed_in {
        borrow name = s.online.account.name
        if let Some((first, mine)) = online::anchor(all, name.as_str(), s.board) {
            s.first[category] = first
            s.anchored[category] = true
            if category == s.column {
                s.row = mine - first
            }
        }
    }
    s.first[category] = min(s.first[category], max(all.len(), shown) - shown)
    online::window(all, s.first[category], s.board)
}

/// The world's board for course `c` (or the whole game) and `category` on the runs card: each
/// place's account name and time, fastest first, from the console's server (online.wrela). The
/// search's own note (what to type, that it's searching, or why it can't) is said once, across both
/// categories when neither has a run; and a search board says no note while its completions are
/// open (`finding`), so the list never covers it.
fn world_rows(s: mut Lab, c: u32, category: u32, screen: vec2, size: f32, finding: bool) {
    let first = first_row(s.board)
    var places: Vec<Place> = Vec::new()
    var note = String::new()
    var whole = false
    if s.board == online::SEARCH {
        places = online::found_places(s.online, c, category)
        let (names, said) = online::found(s.online)
        if !said.is_empty() || s.search.blank() {
            note = if s.search.blank() { String::from("Type a name to find its runs.") } else {
                said.clone()
            }
            whole = true
        } else if places.is_empty() && names > 0 {
            note = String::from("They haven't run this level yet.")
        }
        if finding && !s.search.completed.is_empty() {
            note.clear()
        }
    } else {
        let course = online::board_course(s.board, c)
        online::want(mut s.online, course, category, By::Player)
        note = online::board_note(s.online, course, category)
    }
    if !places.is_empty() || s.board != online::SEARCH {
        // The rows shown, from the first: each one's replay fetched ahead, so choosing it plays at
        // once; asked again only once the rows change, or a replay is let go.
        places = board_places(mut s, c, category)
        let key = rows_key(s.online, places)
        if key != s.fetched[category] {
            s.fetched[category] = key
            online::fetch_rows(mut s.online, places)
        }
    }
    let head = row_rect(screen, category, first)
    if places.is_empty() {
        var width = head.w
        if whole {
            if category != ANY {
                return
            }
            if online::found_places(s.online, c, FULL).is_empty() {
                width = row_rect(screen, FULL, first).right() - head.x
            }
        }
        let lines = wrap_note(s.fonts, note.as_str(), size * 0.8, width - size * 0.8)
        for k in 0..lines.len() {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                lines[k].as_str(),
                size * 0.8,
                vec2(head.x + size * 0.4, head.y + size * 0.2 + f32(k) * size * 1.1),
                SOFT,
            )
        }
        return
    }
    let gold = vec4(0.62, 0.42, 0.08, 1.0)
    let yuzu = vec4(1.0, 0.84, 0.32, 1.0)
    for i in 0..places.len() {
        let row = row_rect(screen, category, i + first)
        if category == s.column && i == s.row {
            s.list.rect(row, yuzu, radius: size * 0.4)
        }
        borrow p = places[i]
        let colour = if p.place == 1 { gold } else { INKED }
        let y = row.y + size * 0.25
        // A search knows no place: its rows are numbered by time. Past the first thousand a slice
        // numbers none.
        let number = if p.place > 0 { f"{p.place}" } else if s.board == online::SEARCH {
            f"{s.first[category] + i + 1}"
        } else { String::from("·") }
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            number.as_str(),
            size,
            vec2(row.x + size * 0.5, y),
            SOFT,
        )
        let time = seconds(p.ticks)
        let tw = s.fonts.font(Face::Mono).measure(time.as_str(), size)
        let room = row.w - tw - size * 3.0
        let nsize = min(
            size * 0.8,
            size *
                0.8 *
                room /
                max(s.fonts.font(Face::Sans).measure(p.name.as_str(), size * 0.8), 1.0),
        )
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            p.name.as_str(),
            nsize,
            vec2(row.x + size * 1.9, y + (size - nsize) * 0.5),
            colour,
        )
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            time.as_str(),
            size,
            vec2(row.x + row.w - tw - size * 0.5, y),
            colour,
        )
    }
}

/// `s` broken into lines no wider than `width` at `size`.
fn wrap_note(fonts: Fonts, s: str, size: f32, width: f32) -> Vec<String> {
    var lines: Vec<String> = Vec::new()
    var line = String::new()
    for (from, to) in s.split(" ") {
        var trial = line.clone()
        if !trial.is_empty() {
            trial.push_str(" ")
        }
        trial.push_str(s.slice(from, to))
        if !line.is_empty() && fonts.font(Face::Sans).measure(trial.as_str(), size) > width {
            lines.push(line.clone())
            line = String::from(s.slice(from, to))
        } else {
            line = take trial
        }
    }
    if !line.is_empty() {
        lines.push(take line)
    }
    lines
}

/// The leaderboard, over the paused page: the boards (the world's first, then its search, the
/// player's own and the tool-assisted, as filters of it, and the whole game), each category's runs,
/// fastest first, who made each and its time, the one with the focus washed in yuzu; the search's
/// line on its board (`finding`: typed in, with its part's completions; choosing its tab or a box
/// opens it, as F does); a back button; and how to use them.
fn runs_card(s: mut Lab, c: u32, screen: vec2, finding: bool) {
    made_assisted(mut s, c)
    let (r, size) = runs_frame(screen)
    let u = unit(screen)
    let gold = vec4(0.62, 0.42, 0.08, 1.0)
    let lit = vec4(0.94, 0.88, 0.72, 1.0)
    let yuzu = vec4(1.0, 0.84, 0.32, 1.0)
    let pointing = s.device == Device::Keys
    card(mut s.list, r, u)
    let title = f"Leaderboard  ·  {course::name(c)}"
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        title.as_str(),
        size * 1.05,
        vec2(r.x + size * 1.2, r.y + size * 1.1),
        SOFT,
    )
    // The boards' names: the one shown filled in, the other lit under the pointer.
    for b in 0..online::BOARDS {
        let tab = board_rect(screen, b)
        let name = board_name(b)
        if b == s.board {
            s.list.rect(tab, INKED, radius: size * 0.8)
        } else if pointing && tab.contains(s.pointer) {
            s.list.rect(tab, lit, radius: size * 0.8)
        }
        let nw = s.fonts.font(Face::Sans).measure(name, size)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            name,
            size,
            vec2(tab.x + (tab.w - nw) * 0.5, tab.y + size * 0.3),
            if b == s.board { CARD } else { INKED },
        )
    }
    if s.board == online::SEARCH {
        search_line(mut s, screen, size, finding)
    }
    for category in [ANY, FULL] {
        let head = row_rect(screen, category, first_row(s.board))
        let name = if category == ANY { "Any%" } else { "100%" }
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            name,
            size * 1.1,
            vec2(head.x + size * 0.4, head.y - size * 2.0),
            INKED,
        )
        if worldly(s.board) {
            world_rows(mut s, c, category, screen, size, finding)
            continue
        }
        let runs = listed(s, c, category)
        let printed = if s.board == PLAYERS { prints_of(mut s, c, category) } else { 0 }
        if runs.len() == 0 {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                if s.board == PLAYERS { "No runs yet. Reach the goal." } else {
                    "No tool-assisted runs yet"
                },
                size * 0.9,
                vec2(head.x + size * 0.4, head.y + size * 0.2),
                SOFT,
            )
        }
        for i in 0..runs.len() {
            let row = row_rect(screen, category, i)
            if category == s.column && i == s.row {
                s.list.rect(row, yuzu, radius: size * 0.4)
            } else if pointing && row.contains(s.pointer) {
                s.list.rect(row, lit, radius: size * 0.4)
            }
            borrow run = runs[i]
            let who = who_name(run.who)
            let colour = if i == 0 { gold } else { INKED }
            let y = row.y + size * 0.25
            let _ = s.list.text(
                s.fonts,
                Face::Mono,
                f"{i + 1}".as_str(),
                size,
                vec2(row.x + size * 0.5, y),
                SOFT,
            )
            let _ = s.list.text(s.fonts, Face::Sans, who, size, vec2(row.x + size * 1.9, y), colour)
            if s.board == PLAYERS && i < s.prints[printed].2.len() {
                // How its post went, if it was asked.
                let said = online::status(s.online, s.prints[printed].2[i])
                if !said.is_empty() {
                    let _ = s.list.text(
                        s.fonts,
                        Face::Sans,
                        said.as_str(),
                        size * 0.62,
                        vec2(row.x + size * 4.4, y + size * 0.22),
                        SOFT,
                    )
                }
            }
            let time = seconds(run.ticks)
            let tw = s.fonts.font(Face::Mono).measure(time.as_str(), size)
            let _ = s.list.text(
                s.fonts,
                Face::Mono,
                time.as_str(),
                size,
                vec2(row.x + row.w - tw - size * 0.5, y),
                colour,
            )
        }
    }
    let back = back_rect(screen)
    s.list.rect(back, if pointing && back.contains(s.pointer) { lit } else {
        yuzu
    }, radius: size * 0.5)
    let bw = s.fonts.font(Face::Sans).measure("Back", size)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        "Back",
        size,
        vec2(back.x + (back.w - bw) * 0.5, back.y + size * 0.35),
        INKED,
    )
    if finding {
        search_picks(mut s, screen, size)
        footer(
            mut s.list,
            s.fonts,
            [
                Prompt { act: Act::Change, say: "Pick" },
                Prompt { act: Act::Move, say: "Part" },
                Prompt { act: Act::Done, say: "Search" },
            ],
            s.device,
            screen,
        )
        return
    }
    if s.online.consenting.is_some() {
        lay_posting(mut s, screen)
        let Some((_, laid)) = s.posting_laid else { return }
        var hover: Option<u32> = None
        for i in 0..screens::POSTING_ITEMS {
            if pointing && laid.controls[i].contains(s.pointer) {
                hover = Some(i)
            }
        }
        screens::posting_card(
            mut s.list,
            s.fonts,
            screen,
            laid,
            best_runs: s.posting_best,
            focus: s.posting_focus,
            hover: hover,
        )
        footer(
            mut s.list,
            s.fonts,
            [
                // The keys go round the dialog in the host's tree, with Tab (`posting_tree`).
                Prompt {
                    act: if s.device == Device::Pad { Act::Move } else { Act::Boards },
                    say: "Move",
                },
                Prompt { act: Act::Choose, say: "Choose" },
                Prompt { act: Act::Back, say: "Not now" },
            ],
            s.device,
            screen,
        )
        return
    }
    runs_note(mut s, screen, size)
    var items = Vec::from(
        [Prompt { act: Act::Choose, say: "Watch" }, Prompt { act: Act::Race, say: "Race" }],
    )
    if s.board == PLAYERS {
        items.push(Prompt { act: Act::Post, say: "Post" })
    }
    if jumps(s, c) {
        items.push(Prompt { act: Act::Places, say: if s.near { "Top" } else { "Your place" } })
    }
    items.push(Prompt { act: Act::Find, say: "Search" })
    items.push(Prompt { act: Act::Boards, say: "Next board" })
    items.push(Prompt { act: Act::Back, say: "Back" })
    footer(mut s.list, s.fonts, items, s.device, screen)
}

/// What the runs card says at its foot, beside Back: that the run chosen is coming, or why it
/// didn't; else the reminder to save the account's recovery codes after a post, while they're
/// still to be saved.
fn runs_note(s: mut Lab, screen: vec2, size: f32) {
    var line = online::watch_note(s.online)
    if line.is_empty() {
        let Some(codes) = online::reminder(s.online) else { return }
        s.reminder_seen = true
        line = String::from(codes)
    }
    let (r, _) = runs_frame(screen)
    let back = back_rect(screen)
    let lines = wrap_note(s.fonts, line.as_str(), size * 0.75, back.x - r.x - size * 2.4)
    for k in 0..lines.len() {
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            lines[k].as_str(),
            size * 0.75,
            vec2(r.x + size * 1.2, back.y + size * 0.1 + f32(k) * size * 0.95),
            INKED,
        )
    }
}

/// The search's line on its board: each part's box, what it holds (or what it's for, soft), and
/// while it's typed in (`finding`), the part with the focus outlined, its hint and a caret.
fn search_line(s: mut Lab, screen: vec2, size: f32, finding: bool) {
    let yuzu = vec4(1.0, 0.84, 0.32, 1.0)
    let paper = vec4(1.0, 0.99, 0.96, 1.0)
    let text = size * 0.9
    for p in 0..search::PARTS {
        let box = part_rect(screen, p)
        let focused = finding && p == s.search.part
        if focused {
            s.list.rect(
                Rect::new(
                    box.x - size * 0.15,
                    box.y - size * 0.15,
                    box.w + size * 0.3,
                    box.h + size * 0.3,
                ),
                yuzu,
                radius: size * 0.55,
            )
        }
        s.list.rect(box, INKED, radius: size * 0.45)
        s.list.rect(box.shrink(max(size * 0.08, 1.5)), paper, radius: size * 0.4)
        let value = s.search.value(p)
        let at = vec2(box.x + size * 0.45, box.y + (box.h - text) * 0.5 - size * 0.05)
        if value.is_empty() && !focused {
            let what = if p == search::TITLE { "Title" } else if p == search::NOUN { "Name" } else {
                "Epithet"
            }
            let _ = s.list.text(s.fonts, Face::Sans, what, text, at, SOFT)
            continue
        }
        let vw = s.list.text(s.fonts, Face::Sans, value.as_str(), text, at, INKED)
        if focused {
            let hint = s.search.hint()
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                hint.as_str(),
                text,
                at + vec2(vw, 0.0),
                vec4(INK, 0.38),
            )
            let x = at.x + vw + size * 0.05
            if s.search.pick == 0 {
                s.list.line(
                    vec2(x, box.y + size * 0.35),
                    vec2(x, box.bottom() - size * 0.35),
                    INKED,
                    width: max(size * 0.08, 1.5),
                )
            }
        }
        if p == search::NOUN {
            let the = vec2(box.right() + size * 0.9, at.y)
            let _ = s.list.text(s.fonts, Face::Sans, "the", text, the, SOFT)
        }
    }
}

/// While the search is typed in, the completions of the part with the focus, under it: the first
/// few, the one picked washed in yuzu.
fn search_picks(s: mut Lab, screen: vec2, size: f32) {
    let part = s.search.part
    borrow all = s.search.completed
    if all.is_empty() {
        return
    }
    let u = unit(screen)
    let box = part_rect(screen, part)
    let shown = min(all.len(), 5)
    // The picks round the one picked, so a controller sees where it is in the list.
    let from = if s.search.pick > 3 { min(s.search.pick - 3, all.len() - shown) } else { 0 }
    let line = size * 1.35
    let r = Rect::new(
        box.x,
        box.bottom() + size * 0.3,
        max(box.w, size * 9.0),
        line * f32(shown) + size * 0.6,
    )
    card(mut s.list, r, u * 0.6)
    for k in 0..shown {
        let i = from + k
        let row = Rect::new(
            r.x + size * 0.3,
            r.y + size * 0.3 + f32(k) * line,
            r.w - size * 0.6,
            line,
        )
        if s.search.pick == i + 1 {
            s.list.rect(row, vec4(1.0, 0.84, 0.32, 1.0), radius: size * 0.35)
        }
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            all[i].as_str(),
            size * 0.85,
            vec2(row.x + size * 0.3, row.y + size * 0.2),
            INKED,
        )
    }
}

/// Board `b`'s name on the leaderboard.
fn board_name(b: u32) -> Text {
    if b == online::WORLD {
        "World"
    } else if b == online::SEARCH {
        "Search"
    } else if b == PLAYERS {
        "Yours"
    } else if b == ASSISTED { "Tool-assisted" } else { "Whole game" }
}

/// Watching: a bar at the foot of the page, as a video player's: who made the run (a world's run:
/// the account and its place), its category and its time; whether it plays; how far through it
/// is; its speed; and for a few seconds after the last key, the prompts (`watch_prompts`).
fn watch_bar(s: mut Lab, screen: vec2) {
    let u = unit(screen)
    let size = u * 2.6
    let named = s.watch_name.clone()
    let (label, tick, end, playing, speed) = match s.watching {
        Some(w) => {
            let who = if named.is_empty() { String::from(who_name(w.replay.who)) } else {
                named.clone()
            }
            let category = if counts(w.replay, FULL) { "100%" } else { "Any%" }
            let label = if s.watch_place > 0 {
                f"{who}  ·  {online::ordinal(s.watch_place)}  ·  {category}"
            } else { f"{who}  ·  {category}" }
            (take label, w.tick, w.end(), w.playing, SPEEDS[w.speed])
        },
        None => return,
    }
    let w = min(screen.x - u * 6.0, u * 110.0)
    let r = Rect::new((screen.x - w) * 0.5, screen.y - u * 13.0, w, u * 8.6)
    card(mut s.list, r, u * 0.8, 0.94)
    // Play or pause.
    let c = vec2(r.x + u * 4.6, r.y + r.h * 0.5)
    let a = u * 1.6
    if playing {
        s.list.rect(Rect::new(c.x - a * 0.8, c.y - a, a * 0.55, a * 2.0), INKED, radius: u * 0.2)
        s.list.rect(Rect::new(c.x + a * 0.25, c.y - a, a * 0.55, a * 2.0), INKED, radius: u * 0.2)
    } else {
        s.list.triangle(
            vec2(c.x - a * 0.7, c.y - a),
            vec2(c.x + a, c.y),
            vec2(c.x - a * 0.7, c.y + a),
            INKED,
        )
    }
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        label.as_str(),
        size,
        vec2(r.x + u * 8.6, r.y + u * 1.4),
        INKED,
    )
    // How far through: a line, the part played inked.
    let left = r.x + u * 8.6
    let right = r.right() - u * 37.0
    let y = r.y + u * 6.0
    let done = left + (right - left) * saturate(f32(tick) / f32(max(end, 1)))
    s.list.line(vec2(left, y), vec2(right, y), vec4(INK, 0.25), width: u * 0.6)
    s.list.line(vec2(left, y), vec2(done, y), INKED, width: u * 0.6)
    s.list.ellipse(Rect::new(done - u * 0.9, y - u * 0.9, u * 1.8, u * 1.8), INKED)
    let run = end_of(s)
    let time = f"{seconds(min(tick, run))} / {seconds(run)}"
    let _ = s.list.text(
        s.fonts,
        Face::Mono,
        time.as_str(),
        size,
        vec2(right + u * 2.0, r.y + u * 1.4),
        INKED,
    )
    let _ = s.list.text(
        s.fonts,
        Face::Mono,
        f"{speed}x".as_str(),
        size,
        vec2(right + u * 2.0, r.y + u * 4.8),
        SOFT,
    )
    // Race: the level again, this run the ghost (R, Select, or a click), its key or button on it.
    let race = race_rect(screen)
    let pointing = s.device == Device::Keys && race.contains(s.pointer)
    s.list.rect(race, if pointing { vec4(0.94, 0.88, 0.72, 1.0) } else {
        vec4(1.0, 0.84, 0.32, 1.0)
    }, radius: u * 1.4)
    let glyph = u * 3.0
    let gw = screens::act_width(s.fonts, Act::Race, s.device, glyph)
    let rw = s.fonts.font(Face::Sans).measure("Race", size)
    let gap = if gw > 0.0 { u * 1.0 } else { 0.0 }
    let left = race.x + (race.w - gw - gap - rw) * 0.5
    let _ = screens::act(
        mut s.list,
        s.fonts,
        Act::Race,
        s.device,
        vec2(left, race.y + (race.h - glyph) * 0.5),
        glyph,
    )
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        "Race",
        size,
        vec2(left + gw + gap, race.y + (race.h - size) * 0.5 - u * 0.2),
        INKED,
    )
    let alpha = 1.0 - smoothstep(IDLE, IDLE + 0.5, s.idle)
    if alpha > 0.0 {
        let _ = screens::prompts(
            mut s.list,
            s.fonts,
            watch_prompts(),
            s.device,
            vec2(screen.x * 0.5, r.y - u * 5.0),
            u * 3.6,
            alpha,
            backed: true,
        )
    }
}

/// Where the watch's race button is: at the bar's right end.
fn race_rect(screen: vec2) -> Rect {
    let u = unit(screen)
    let w = min(screen.x - u * 6.0, u * 110.0)
    let right = (screen.x + w) * 0.5
    Rect::new(right - u * 14.0, screen.y - u * 11.6, u * 12.4, u * 5.8)
}

/// What the watch's prompts offer: play, seek, the speed, again from the start, and back. The race
/// against the run as the ghost (docs/plan-online-play.md, step 6) is the bar's button, its key on it.
fn watch_prompts() -> Vec<Prompt> {
    Vec::from(
        [
            Prompt { act: Act::Choose, say: "Play" },
            Prompt { act: Act::Change, say: "Seek" },
            Prompt { act: Act::Move, say: "Speed" },
            Prompt { act: Act::Again, say: "Again" },
            Prompt { act: Act::Back, say: "Back" },
        ],
    )
}

/// The watched run's time (ticks), or 0.
fn end_of(s: Lab) -> u32 {
    match s.watching {
        Some(w) => w.replay.ticks,
        None => 0,
    }
}

/// The capybara's middle (x, y, m), its speed (m/s) and its mode, as the newest snapshot has them,
/// for `wrela trace --watch capybara`.
pub fn capybara(s: mut Lab) -> vec4 {
    let n = s.snaps.newest().snap
    vec4(n.at, length(n.vel), f32(n.mode))
}

// ---- tests -------------------------------------------------------------------------------------

/// Three seconds of the run script on the hardware GPU: the first level draws, with its foes and
/// things, and the sim, ticking in lockstep, plays it, from the title it opens on (the script's
/// Enter).
@test(frames: 180, gpu: true, input: scripts::RUN)
fn the_level_draws_and_its_sim_runs(s: Lab) {
    let n = s.snaps.newest()
    assert(n.ticks >= 358, "the ticker runs two ticks a frame")
    assert(n.snap.course == HOME && n.snap.paused == 0, "the first level, playing")
    let Some(at) = s.playable_at else { panic("never playable") }
    assert(at <= 10, f"playable at frame {at}")
    // Its clock is three ticks behind the ticks run: frame 0's two stood on the title the game
    // opens on, and the tick of the script's Enter (frame 1) left it without stepping.
    assert(n.snap.ticks + 3 == n.ticks, "its clock running")
    // The test's storage is empty: the stored runs are read as none, so new ones may be stored.
    assert(
        s.storing.read && s.loading.is_none() && s.progress.runs.runs.len() == 0,
        "nothing stored is no runs",
    )
}

@test
fn a_load_or_a_store_that_failed_is_made_again_after_a_wait() {
    var st = Storing {}
    assert(st.due(0.016, loading: true, saving: false) == (false, false), "the first load waits")
    st.loaded(read: false)
    assert(st.due(1.0, loading: false, saving: false) == (false, false), "a failed load waits")
    assert(st.due(1.0, loading: false, saving: false) == (true, false), "then loads again")
    // A run kept before the stored ones are read isn't stored over them.
    st.unsaved = true
    assert(st.due(0.016, loading: true, saving: false) == (false, false))
    st.loaded(read: true)
    assert(st.due(0.016, loading: false, saving: false) == (false, true), "stored once read")
    assert(!st.unsaved)
    // Another run kept while that store waits is stored after it, and a failed store again.
    st.unsaved = true
    assert(st.due(0.016, loading: false, saving: true) == (false, false), "one store at a time")
    st.stored(ok: true)
    assert(st.due(0.016, loading: false, saving: false) == (false, true), "the newer runs")
    // Returning to the console counts as a store under way: a change made then stays unsaved, so
    // it's stored if the return's store fails and the game stays.
    st.stored(ok: true)
    st.unsaved = true
    assert(st.due(0.016, loading: false, saving: true) == (false, false) && st.unsaved, "returning")
    assert(st.due(0.016, loading: false, saving: false) == (false, true), "stored after")
    st.stored(ok: false)
    assert(st.unsaved, "a failed store's runs are unsaved again")
    assert(st.due(1.0, loading: false, saving: false) == (false, false), "and wait")
    assert(st.due(1.0, loading: false, saving: false) == (false, true), "then are stored again")
}

use world::{present, world}

@test
fn a_frame_isnt_drawn_between_two_places_across_a_cut() {
    // Thirty metres on, then back at the start: a frame halfway between draws the capybara at the
    // start if a cut came between (a restart, a comeback), and halfway if none did.
    let start = course(WETLANDS).start
    var a = present(world(WETLANDS))
    a.at = start + vec2(30.0, 0.0)
    var b = present(world(WETLANDS))
    b.tally.cuts = 1
    assert(mixed(a, b, 0.5).at == start, "across a cut")
    b.tally.cuts = 0
    assert(mixed(a, b, 0.5).at == start + vec2(15.0, 0.0), "without one")
}

@test
fn the_watch_offers_race_once_on_its_bars_button_not_in_its_prompts() {
    for p in watch_prompts() {
        assert(p.act != Act::Race, f"{p.say}: the bar's button is the race")
    }
    let r = race_rect(vec2(1280.0, 720.0))
    assert(r.w > 0.0 && r.right() <= 1280.0 && r.bottom() <= 720.0, "the button, on the screen")
}
