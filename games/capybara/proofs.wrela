    hold(RIGHT | RUN, 575),
    hold(RIGHT | JUMP | RUN | PRESS, 1),
    hold(RIGHT | JUMP | RUN, 134),
    hold(RIGHT | JUMP | RUN | PRESS, 1),
    hold(RIGHT | JUMP | RUN, 158),
    hold(RIGHT | JUMP | RUN | PRESS, 1),
