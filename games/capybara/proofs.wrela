// The proofs and the feel's metrics (design.md, "The agent loop"). A proof is a recorded run:
// pads and how long each is held, from a course's start state. Each must keep reaching its goal
// in exactly the ticks it took when it was recorded, so a change to the movement that breaks a
// route, or moves its time, fails here; re-record a proof only when the change is meant. The
// metrics measure the movement in metres and ticks, against the ranges the feel is held to. The
// contract tests check the rules of design.md's contracts one at a time.

use body::{Body, Mode, RADIUS, spawn}
use course::LAB
use feel::{FEEL, STEP}
use pad::{DOWN, Hold, JUMP, PRESS, Pad, RIGHT, UP, hold}
use std::hash::state_hash
use std::io::print
use world::{play, step, world}

// ---- proofs ------------------------------------------------------------------------------------

/// The lab from its start to its goal: over the crest, through the puddle (wet, so fast), both
/// gaps and both steps, down the slide through the valley's puddle and off its lip, across the
/// lake fast, and a swim up into a dolphin leap over its far wall. Recorded from an autopilot.
pub const LAB_RUN: [Hold; 19] = [
    hold(RIGHT, 466),
    hold(RIGHT | JUMP | PRESS, 1),
    hold(RIGHT | JUMP, 45),
    hold(RIGHT, 34),
    hold(RIGHT | JUMP | PRESS, 1),
    hold(RIGHT | JUMP, 45),
    hold(RIGHT, 52),
    hold(RIGHT | JUMP | PRESS, 1),
    hold(RIGHT | JUMP, 45),
    hold(RIGHT, 43),
    hold(RIGHT | JUMP | PRESS, 1),
    hold(RIGHT | JUMP, 49),
    hold(RIGHT, 64),
    hold(RIGHT | DOWN, 153),
    hold(RIGHT, 318),
    hold(RIGHT | UP, 60),
    hold(RIGHT, 1),
    hold(RIGHT | UP, 35),
    hold(RIGHT, 54),
]

/// Up through the 2 m one-way ledge from below, then a jump to the 3.5 m ledge.
pub const LEDGES: [Hold; 9] = [
    hold(RIGHT, 80),
    hold(bits: 0, ticks: 30),
    hold(JUMP | PRESS, 1),
    hold(JUMP, 40),
    hold(bits: 0, ticks: 20),
    hold(RIGHT, 15),
    hold(RIGHT | JUMP | PRESS, 1),
    hold(RIGHT | JUMP, 40),
    hold(bits: 0, ticks: 60),
]

/// From the ground to the 3.5 m ledge with a double jump, out of reach of one jump.
pub const DOUBLE_JUMP: [Hold; 7] = [
    hold(RIGHT, 145),
    hold(bits: 0, ticks: 30),
    hold(JUMP | PRESS, 1),
    hold(JUMP, 15),
    hold(JUMP | PRESS, 1),
    hold(JUMP, 40),
    hold(bits: 0, ticks: 60),
]

@test
fn the_lab_is_finished_by_its_recorded_run_in_its_recorded_time() {
    let w = play(0, LAB_RUN)
    print(f"the lab: {w.finished} ticks")
    assert(w.finished == 1468 && w.falls == 0, "the run's time moved")
}

/// Whether `run` ends standing on the 3.5 m ledge.
fn on_high_ledge(run: [Hold]) -> bool {
    let w = play(0, run)
    w.body.grounded() &&
        abs(w.body.at.y - (3.5 + RADIUS)) < 1.0e-4 &&
        w.body.at.x > 11.0 &&
        w.body.at.x < 14.0
}

@test
fn the_one_way_ledge_is_jumped_through_and_the_higher_one_reached() {
    assert(on_high_ledge(LEDGES))
}

@test
fn a_double_jump_reaches_the_ledge_one_jump_cant() {
    assert(3.5 > FEEL.launch * FEEL.launch / (2.0 * FEEL.rise), "one jump falls short")
    assert(on_high_ledge(DOUBLE_JUMP))
}

@test
fn a_run_replays_to_the_same_state_hash() {
    let a = play(0, LAB_RUN)
    let b = play(0, LAB_RUN)
    assert(state_hash(a) == state_hash(b) && a == b)
}

// ---- contracts ---------------------------------------------------------------------------------

/// The lab's broad crest: the arc that rounds the corner at (23, 3).
fn crest() -> u32 {
    for i in 0..LAB.pieces.len() {
        let p = LAB.pieces[i]
        if p.convex() && p.a.x > 20.0 && p.b.x < 26.0 {
            return i
        }
    }
    panic("the lab has no crest")
}

/// A body sliding at `speed` over the top of the crest.
fn on_crest(speed: f32) -> Body {
    let i = crest()
    let p = LAB.pieces[i]
    var b = spawn(p.centre + vec2(0.0, p.radius + RADIUS))
    b.mode = Mode::Slide
    b.speed = speed
    b.piece = i
    b
}

@test
fn a_crest_is_followed_below_its_launch_speed_and_left_above_it() {
    let p = LAB.pieces[crest()]
    // At the top the slope is 0: it leaves when v² / (r + R) > g.
    let launch = sqrt(FEEL.fall * (p.radius + RADIUS))
    for k in [0.5, 0.9, 0.98] {
        var b = on_crest(launch * k)
        body::step(mut b, Pad { bits: DOWN }, LAB, FEEL)
        assert(b.grounded(), "below the launch speed it follows the crest")
    }
    for k in [1.02, 1.1, 1.5] {
        var b = on_crest(launch * k)
        body::step(mut b, Pad { bits: DOWN }, LAB, FEEL)
        assert(b.mode == Mode::Air, "above, it leaves along the tangent")
    }
}

@test
fn walking_off_a_sharp_edge_leaves_at_the_edge_and_falls() {
    var w = world(0)
    w.body = spawn(vec2(35.6, RADIUS))
    var left = 0.0
    var lowest = RADIUS
    for _ in 0..50 {
        step(mut w, Pad { bits: RIGHT })
        if w.body.mode == Mode::Air && left == 0.0 {
            left = w.body.at.x
        }
        lowest = min(lowest, w.body.at.y)
    }
    assert(left >= 36.0 && left < 36.0 + 0.05, "it leaves where its middle passes the edge")
    assert(lowest < -1.0 && w.falls == 0, "and rolls off the corner into the pit")
}

/// The lab's 29° slope, at x 74: its point, tangent (down to the right) and normal.
fn slope() -> (vec2, vec2, vec2) {
    let t = normalize(vec2(9.0, -5.0))
    let point = vec2(74.0, 3.0 - 4.0 * 5.0 / 9.0)
    (point, t, vec2(-t.y, t.x))
}

@test
fn a_landing_keeps_the_velocitys_part_along_the_ground() {
    let (point, t, n) = slope()
    let f = FEEL
    for angle in [15.0, 30.0, 45.0, 60.0, 75.0, 90.0] {
        let a = angle * std::math::PI / 180.0
        let v = (t * cos(a) - n * sin(a)) * 12.0
        var b = spawn(point + n * (RADIUS + 0.001))
        b.mode = Mode::Air
        b.vel = v
        body::step(mut b, Pad { bits: DOWN }, LAB, f)
        // Gravity acts for the tick before the body moves.
        let expected = dot(v - vec2(0.0, f.fall * STEP), t)
        assert(b.grounded(), "it lands")
        assert(abs(b.speed - expected) < 1.0e-3, "the speed is the velocity along the tangent")
        assert(b.mode == Mode::Slide, "down held on a slope slides")
    }
}

@test
fn a_jump_out_of_a_slide_keeps_the_slides_speed() {
    let (point, t, n) = slope()
    var b = spawn(point + n * RADIUS)
    b.mode = Mode::Slide
    b.speed = 15.0
    body::step(mut b, Pad { bits: DOWN | JUMP | PRESS }, LAB, FEEL)
    assert(b.mode == Mode::Air)
    assert(abs(b.vel.x - t.x * 15.0) < 1.0e-3, "the slide's speed carries into the jump")
    // All of it: down the slope, the jump starts lower than a running one.
    assert(abs(b.vel.y - (t.y * 15.0 + FEEL.launch - FEEL.rise * STEP)) < 1.0e-3)
}

/// How high a running jump at the top speed rises above where it left the ground, from the body
/// at `at` on the ground there, its jump held.
fn running_jump(at: vec2) -> f32 {
    var w = world(0)
    w.body = spawn(at)
    w.body.speed = FEEL.speed
    step(mut w, Pad { bits: RIGHT })
    let from = w.body.at.y
    step(mut w, Pad { bits: RIGHT | JUMP | PRESS })
    var top = from
    for _ in 0..60 {
        step(mut w, Pad { bits: RIGHT | JUMP })
        top = max(top, w.body.at.y)
    }
    top - from
}

@test
fn a_running_jump_is_as_high_up_a_slope_as_on_the_flat() {
    // On the runway, and on the crest's 31° upslope: the slope's speed doesn't lift a running
    // jump (Ryan, 2026-10-21: jumps there came out higher and read as random).
    let flat = running_jump(vec2(2.0, RADIUS))
    let up = vec2(5.0, 3.0) / length(vec2(5.0, 3.0))
    let on_slope = vec2(18.0, 0.0) + up * 2.5 + vec2(-up.y, up.x) * RADIUS
    let sloped = running_jump(on_slope)
    assert(abs(flat - sloped) < 0.05, "the same height")
}

/// A body swimming in the lab's pool at `at`, moving at `vel`.
fn in_pool(at: vec2, vel: vec2) -> Body {
    var b = spawn(at)
    b.mode = Mode::Swim
    b.vel = vel
    b
}

@test
fn in_water_the_capybara_is_faster_and_a_puddle_wets_it_for_a_while() {
    var swim = in_pool(vec2(104.0, -2.0), vec2(0.0))
    for _ in 0..60 {
        body::step(mut swim, Pad { bits: RIGHT }, LAB, FEEL)
    }
    assert(abs(swim.vel.x - FEEL.wet_speed) < 1.0e-3, "the wet speed in the pool")
    // Through the puddle after the crest at the dry top speed: wet, it speeds up past it.
    var w = world(0)
    w.body = spawn(vec2(27.0, RADIUS))
    w.body.speed = FEEL.speed
    var fastest = 0.0
    var soaked = false
    while w.body.at.x < 34.4 {
        step(mut w, Pad { bits: RIGHT })
        fastest = max(fastest, w.body.speed)
        soaked = soaked || w.body.wet == FEEL.wet_ticks
    }
    assert(soaked && fastest > FEEL.speed + 2.0, "wet in the puddle, and faster")
    // Out of the water, the boost lasts half the wet time, then eases back to the dry speed, and
    // the speed follows it down without a jolt: on the runway, wet, at the wet speed.
    var dry = world(0)
    dry.body = spawn(vec2(1.0, RADIUS))
    dry.body.wet = FEEL.wet_ticks
    dry.body.speed = FEEL.wet_speed
    for i in 0..FEEL.wet_ticks {
        let before = dry.body.speed
        step(mut dry, Pad { bits: RIGHT })
        if i < FEEL.wet_ticks / 2 - 1 {
            assert(abs(body::top(dry.body, FEEL) - FEEL.wet_speed) < 1.0e-3, "still the wet speed")
        }
        assert(before - dry.body.speed <= FEEL.over * STEP + 1.0e-4, "no jolt")
    }
    assert(dry.body.wet == 0 && abs(dry.body.speed - FEEL.speed) < 0.1, "dry again")
}

@test
fn a_jump_press_in_water_kicks_and_a_press_too_soon_waits_its_turn() {
    var b = in_pool(vec2(108.0, -3.0), vec2(0.0, -2.0))
    body::step(mut b, Pad { bits: JUMP | PRESS }, LAB, FEEL)
    assert(b.vel.y > FEEL.kick - 1.0 && b.cooldown == FEEL.kick_cooldown, "a kick")
    body::step(mut b, Pad { bits: JUMP | PRESS }, LAB, FEEL)
    assert(b.cooldown == FEEL.kick_cooldown - 1 && b.buffer > 0, "too soon: it waits")
    var kicked = 0
    for i in 0..FEEL.kick_cooldown {
        body::step(mut b, Pad { bits: JUMP }, LAB, FEEL)
        if b.cooldown == FEEL.kick_cooldown && kicked == 0 {
            kicked = i + 2
        }
    }
    assert(kicked == FEEL.kick_cooldown, "and kicks on the tick the cooldown ends")
}

@test
fn a_dive_slows_to_the_sinking_speed() {
    var b = in_pool(vec2(108.0, -0.5), vec2(0.0, -20.0))
    for _ in 0..24 {
        body::step(mut b, Pad { bits: 0 }, LAB, FEEL)
    }
    assert(b.mode == Mode::Swim && abs(b.vel.y + FEEL.water_terminal) < 0.5)
}

@test
fn holding_up_swims_up_and_out_in_a_leap() {
    var b = in_pool(vec2(110.0, -5.0), vec2(0.0))
    var fastest = 0.0
    while b.mode == Mode::Swim {
        body::step(mut b, Pad { bits: pad::UP }, LAB, FEEL)
        fastest = max(fastest, b.vel.y)
    }
    assert(abs(fastest - FEEL.leap) < 1.0e-3 && b.flip == 1, "up to the surface, and a leap")
}

@test
fn breaking_the_surface_fast_is_a_leap_and_slow_is_a_way_out() {
    var fast = in_pool(vec2(108.0, -0.02), vec2(3.0, 9.0))
    body::step(mut fast, Pad { bits: 0 }, LAB, FEEL)
    assert(fast.mode == Mode::Air && fast.vel.y >= FEEL.leap && fast.vel.x > 2.9, "a dolphin leap")
    assert(fast.flip == 1 && fast.jumps == FEEL.air_jumps, "with a flip, and the double jump back")
    var slow = in_pool(vec2(108.0, -0.005), vec2(0.0, 2.0))
    body::step(mut slow, Pad { bits: 0 }, LAB, FEEL)
    assert(slow.mode == Mode::Air && slow.vel.y < FEEL.leap_min && slow.leap == 0, "a way out")
}

@test
fn the_double_jump_is_once_in_the_air_and_comes_back_on_landing() {
    var w = world(0)
    step(mut w, Pad { bits: JUMP | PRESS })
    for _ in 0..20 {
        step(mut w, Pad { bits: JUMP })
    }
    assert(w.body.mode == Mode::Air && w.body.jumps == 1)
    step(mut w, Pad { bits: JUMP | PRESS })
    assert(w.body.jumps == 0 && w.body.flip == 1, "a double jump, with a flip")
    assert(abs(w.body.vel.y - (FEEL.air_launch - FEEL.rise * STEP)) < 1.0e-3, "at its own speed")
    for _ in 0..10 {
        step(mut w, Pad { bits: JUMP })
    }
    let before = w.body.vel.y
    step(mut w, Pad { bits: JUMP | PRESS })
    assert(w.body.vel.y < before, "no third jump")
    for _ in 0..240 {
        step(mut w, Pad { bits: 0 })
    }
    assert(w.body.grounded())
    step(mut w, Pad { bits: JUMP | PRESS })
    assert(w.body.mode == Mode::Air && w.body.jumps == FEEL.air_jumps, "back on landing")
}

@test
fn walking_off_an_edge_keeps_the_double_jump_for_after_the_coyote_time() {
    var w = world(0)
    w.body = spawn(vec2(35.6, RADIUS))
    while w.body.mode != Mode::Air {
        step(mut w, Pad { bits: RIGHT })
    }
    for _ in 0..FEEL.coyote + 2 {
        step(mut w, Pad { bits: RIGHT })
    }
    step(mut w, Pad { bits: RIGHT | JUMP | PRESS })
    assert(w.body.jumps == 0 && w.body.vel.y > 0.0, "past the coyote time, the double jump")
}

// ---- metrics -----------------------------------------------------------------------------------

/// How high the body's bottom rises from flat ground with jump held for `held` ticks, and with a
/// double jump at the top of the first if `double`.
fn jump_height(held: u32, double: bool) -> f32 {
    var w = world(0)
    step(mut w, Pad { bits: JUMP | PRESS })
    var top = 0.0
    var doubled = false
    for i in 0..300 {
        var bits = if i < held { JUMP } else { 0 }
        if double && !doubled && w.body.vel.y <= 0.0 {
            bits = JUMP | PRESS
            doubled = true
        }
        step(mut w, Pad { bits: bits })
        top = max(top, w.body.at.y - RADIUS)
    }
    top
}

@test
fn a_held_jumps_arc_is_exact_whatever_the_ticks() {
    // A tick moves the body by the mean of its velocities, so the peak is launch² / (2 rise) up
    // to where the peak falls between ticks (a few millimetres).
    let exact = FEEL.launch * FEEL.launch / (2.0 * FEEL.rise)
    assert(abs(jump_height(300, double: false) - exact) < 0.005)
}

/// Ticks from rest to the top speed.
fn ticks_to_top() -> u32 {
    var w = world(0)
    var t = 0
    while w.body.speed < FEEL.speed - 1.0e-3 {
        step(mut w, Pad { bits: RIGHT })
        t += 1
        assert(t < 1000)
    }
    t
}

/// How far a jump at the top speed from flat ground carries the body before it is back at the
/// same height, jump held throughout (m): from the flat between the gaps, dry, over the second.
fn reach() -> f32 {
    var w = world(0)
    w.body = spawn(vec2(39.4, RADIUS))
    w.body.speed = FEEL.speed
    let from = w.body.at
    step(mut w, Pad { bits: RIGHT | JUMP | PRESS })
    var x = from.x
    for _ in 0..240 {
        let before = w.body.at
        step(mut w, Pad { bits: RIGHT | JUMP })
        if w.body.at.y <= from.y && before.y > from.y {
            x = mix(before.x, w.body.at.x, (before.y - from.y) / (before.y - w.body.at.y))
            break
        }
    }
    x - from.x
}

fn within(x: f32, range: vec2) -> bool {
    x >= range.x && x <= range.y
}

/// The ranges the feel is held to: Ryan's "snappy, a touch more momentum and float, the full jump a
/// touch higher" (2026-10-21).
@test
fn the_feels_metrics_are_within_their_ranges() {
    let (held, tap, double) = (
        jump_height(300, double: false),
        jump_height(0, double: false),
        jump_height(300, double: true),
    )
    let (top, far) = (ticks_to_top(), reach())
    print(
        f"held jump {held} m, tapped {tap} m, double {double} m, top speed in {top} ticks, jump at speed {far} m",
    )
    assert(within(held, vec2(2.7, 3.1)), "the held jump's height")
    assert(within(tap, vec2(1.0, 1.5)), "the tapped jump's height")
    assert(within(double, vec2(4.6, 5.4)), "the double jump's height")
    assert(within(f32(top), vec2(36.0, 52.0)), "the ticks to top speed, eased")
    assert(within(far, vec2(5.2, 6.4)), "the jump's reach at speed")
}
