    hold(RIGHT | JUMP | RUN | PRESS, 1),
    hold(RIGHT | JUMP | RUN, 174),
    hold(RIGHT | DOWN | JUMP | RUN, 225),
    hold(RIGHT | JUMP | RUN, 180),
    hold(RIGHT, 39),
    hold(RIGHT | DOWN | JUMP | PRESS, 1),
    hold(RIGHT | DOWN, 18),
    hold(RIGHT | DOWN | JUMP | PRESS, 1),
    hold(RIGHT | DOWN, 18),
    hold(RIGHT | DOWN | JUMP | PRESS, 1),
    hold(RIGHT | DOWN, 183),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 18),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 18),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 18),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 1),
    hold(RIGHT | JUMP | RUN, 88),
    hold(UP | JUMP, 17),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 18),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 18),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 18),
    hold(UP | JUMP | PRESS, 1),
    hold(UP | JUMP, 5),
