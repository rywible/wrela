// Input scripts for running the lab without a person, as the native host and `wrela trace` take
// them (`wrela script games/capybara scripts::RUN -o run.json`).

use course::{AVIARY, FARM, FOOD_COURT, HOME, LEVELS, POLAR, RAINFOREST, REPTILES, SAVANNA, WETLANDS}
use pad::{DOWN, Hold, JUMP, LEFT, PRESS, RIGHT, UP}
use std::input::{Key, Script}

/// A run to the right from the start, at 60 frames a second (two ticks a frame), jumping the first
/// gap, then sliding: enough to see the runway, the crest, the puddle and a gap.
pub const RUN: Script = Script::frames()
    .key_down(1, Key::Enter)
    .key_down(1, Key::D)
    .key_up(2, Key::Enter)
    .key_down(281, Key::Space)
    .key_up(330, Key::Space)
    .key_down(350, Key::Space)
    .key_up(400, Key::Space)
    .key_down(573, Key::S)

/// The keys for a pad's bits.
const KEYS: [(u32, Key); 5] = [
    (LEFT, Key::A),
    (RIGHT, Key::D),
    (UP, Key::W),
    (DOWN, Key::S),
    (JUMP, Key::Space),
]

/// A recorded run of level `level` as a script of frames at 120 a second, one tick a frame: on the
/// first level, Enter on the first frame, to leave the title the game opens on (a tick that
/// doesn't step); on another, Esc, up twice and Enter to its levels' map, right to the level and
/// Enter. Then from the next frame each hold's keys go down or up where its bits change. A press
/// of jump held on is a release and a press in its frame, and a press not held on is a tap: down
/// and up in its frame. Run it with `--fps 120`.
pub fn script_of(level: u32, run: [Hold]) -> Script {
    if level == HOME {
        return keys_of(
            Script::frames().key_down(1, Key::Enter).key_up(2, Key::Enter),
            run,
            first: 2,
        )
    }
    var s = Script::frames()
    var f = 1
    for key in [Key::Escape, Key::Up, Key::Up, Key::Enter] {
        s = take s.key_down(f, key)
        s = take s.key_up(f + 1, key)
        f += 2
    }
    for _ in 0..level {
        s = take s.key_down(f, Key::Right)
        s = take s.key_up(f + 1, Key::Right)
        f += 2
    }
    s = take s.key_down(f, Key::Enter)
    s = take s.key_up(f + 1, Key::Enter)
    keys_of(take s, run, first: f + 1)
}

/// `s` with the keys of `run` from frame `first` on.
fn keys_of(s: take Script, run: [Hold], first: u32) -> Script {
    var s = take s
    var held = 0
    var frame = first
    for h in run {
        let bits = h.bits & !PRESS
        for (bit, key) in KEYS {
            let was = held & bit != 0
            let now = bits & bit != 0
            let again = bit == JUMP && h.bits & PRESS != 0
            if was && (!now || again) {
                s = take s.key_up(frame, key)
            }
            if now && (!was || again) {
                s = take s.key_down(frame, key)
            }
            if again && !now {
                s = take s.key_down(frame, key)
                s = take s.key_up(frame, key)
            }
        }
        held = bits
        frame += h.ticks
    }
    s
}

/// The Wetlands' recorded any% run (`proofs::LEVEL_ANY`) from start to goal, for stills and clips
/// of every part of the level: `wrela-host <build> --fps 120 --frames 3600 --input level.json`.
pub const LEVEL: Script = script_of(WETLANDS, proofs::LEVEL_ANY)

/// The level's recorded 100% run (`proofs::LEVEL_FULL`), as `LEVEL`: it dives under the lake's
/// deep caiman to the snack on its floor.
pub const LEVEL_FULL: Script = script_of(WETLANDS, proofs::LEVEL_FULL)

/// The lab's recorded run (`proofs::LAB_RUN`), after Tab steps past the levels to the lab (a
/// developer's build: main.wrela's `DEV`): at 120 frames a second, as `LEVEL`.
pub const LAB: Script = to_lab()

fn to_lab() -> Script {
    var s = Script::frames()
    for i in 0..LEVELS {
        s = take s.key_down(1 + 2 * i, Key::Tab)
        s = take s.key_up(2 + 2 * i, Key::Tab)
    }
    keys_of(take s, proofs::LAB_RUN, first: 2 * LEVELS + 2)
}

/// The runs, at 1280x720 and 60 frames a second: Esc opens the menu from the title the game opens
/// on, down twice and Enter choose the leaderboard (opened alone, it shows the player's runs), Tab
/// switches to the tool-assisted board, the pointer rests on its fastest any% run, then clicks it
/// to watch it.
pub const RUNS: Script = Script::frames()
    .key_down(1, Key::Escape)
    .key_up(2, Key::Escape)
    .key_down(3, Key::Down)
    .key_up(4, Key::Down)
    .key_down(5, Key::Down)
    .key_up(6, Key::Down)
    .key_down(9, Key::Enter)
    .key_up(10, Key::Enter)
    .key_down(12, Key::Tab)
    .key_up(13, Key::Tab)
    .move_to(30, vec2(440.0, 286.0))
    .down(60, vec2(440.0, 286.0))
    .up(61, vec2(440.0, 286.0))

/// The autopilot's ghost, at 60 frames a second: Esc opens the menu, down four times and Enter
/// choose the options, down twice to the ghost and right to the robot's (after the player's best),
/// Esc backs out and Esc again plays, and the capybara runs right beside it.
pub const GHOST: Script = Script::frames()
    .key_down(1, Key::Escape)
    .key_up(2, Key::Escape)
    .key_down(3, Key::Down)
    .key_up(4, Key::Down)
    .key_down(5, Key::Down)
    .key_up(6, Key::Down)
    .key_down(7, Key::Down)
    .key_up(8, Key::Down)
    .key_down(9, Key::Down)
    .key_up(10, Key::Down)
    .key_down(11, Key::Enter)
    .key_up(12, Key::Enter)
    .key_down(13, Key::Down)
    .key_up(14, Key::Down)
    .key_down(15, Key::Down)
    .key_up(16, Key::Down)
    .key_down(17, Key::Right)
    .key_up(18, Key::Right)
    .key_down(19, Key::Escape)
    .key_up(20, Key::Escape)
    .key_down(21, Key::Escape)
    .key_up(22, Key::Escape)
    .key_down(24, Key::D)

/// The leaderboard's search, at 60 frames a second: Esc, down twice and Enter open the
/// leaderboard, F opens the search, and "si", a space ("Sir"), "wob" are typed, its completions
/// under the noun. Opened alone, it says where the world's names are.
pub const SEARCH: Script = Script::frames()
    .press(1, Key::Escape)
    .press(3, Key::Down)
    .press(5, Key::Down)
    .press(9, Key::Enter)
    .press(12, Key::F)
    .text(16, "si")
    .text(18, " ")
    .text(20, "wob")

/// Watching a run, at 60 frames a second: the leaderboard as `SEARCH` opens it, Tab to the
/// tool-assisted runs, and Enter watches the fastest any%, its bar offering Race.
pub const WATCHED: Script = Script::frames()
    .press(1, Key::Escape)
    .press(3, Key::Down)
    .press(5, Key::Down)
    .press(9, Key::Enter)
    .press(12, Key::Tab)
    .press(15, Key::Enter)

/// A race, at 120 frames a second: the leaderboard's tool-assisted runs as `WATCHED` opens them,
/// down to the second fastest any%, R races it from the level's title, Enter starts it, and the
/// first level's searched human line plays to the goal, whose card says where it lost the most
/// time.
pub const RACE: Script = raced()

fn raced() -> Script {
    let s = Script::frames()
        .press(1, Key::Escape)
        .press(3, Key::Down)
        .press(5, Key::Down)
        .press(9, Key::Enter)
        .press(12, Key::Tab)
        .press(14, Key::Down)
        .press(15, Key::R)
        .key_down(18, Key::Enter)
        .key_up(19, Key::Enter)
    keys_of(take s, routes_home::HUMAN_ANY, first: 19)
}

/// Each level's searched human-possible any% run (searched.wrela), as `LEVEL`, for stills and
/// clips of the level: none until the level is searched.
pub const HOME_RUN: Script = script_of(HOME, routes_home::HUMAN_ANY)
pub const WETLANDS_RUN: Script = script_of(WETLANDS, routes_wetlands::HUMAN_ANY)
pub const SAVANNA_RUN: Script = script_of(SAVANNA, routes_savanna::HUMAN_ANY)
pub const RAINFOREST_RUN: Script = script_of(RAINFOREST, routes_rainforest::HUMAN_ANY)
pub const AVIARY_RUN: Script = script_of(AVIARY, routes_aviary::HUMAN_ANY)
pub const REPTILES_RUN: Script = script_of(REPTILES, routes_reptiles::HUMAN_ANY)
pub const POLAR_RUN: Script = script_of(POLAR, routes_polar::HUMAN_ANY)
pub const FARM_RUN: Script = script_of(FARM, routes_farm::HUMAN_ANY)
pub const FOOD_COURT_RUN: Script = script_of(FOOD_COURT, routes_food_court::HUMAN_ANY)
