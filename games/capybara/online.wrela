// The capybara online: its runs posted to the world's boards, those boards and a search of names
// on the leaderboard, and their runs held to watch and race (design.md, "Online play"). The game
// never talks to the server: the console that shows it carries its asks (platform/link.wrela), and
// gives it the account's name, a token that can only submit runs, and what the account chose of
// posting. Offline, or opened alone, every run stays in the game's own storage, and nothing is
// asked of the network unless the player is signed in or opened the World's board or the search.
//
// Posting is the player's choice. A post by hand waits in the game's storage (`WAITING`, beside
// `UPLOADED`) until it can go: until what the account chose of posting is known (never taken as a
// no meanwhile), then, if the account hasn't agreed to what posting makes public, on the game's
// own screen of it (platform/posting.wrela's words: `consenting`), whose Post the console records
// (`consent`, `Ask::Consent`). With "Post my best runs" on (`Account::post_best`), a finished run
// waits too, and goes once the account's places on each board it counts for are known (the slices
// around them; none there is its first) and it beats one. A post the server puts off
// (`Answer::Failed`) waits longer each time, its count kept with it; only a rejection drops it.
// The runs posted are kept by their replays' SHA-256, apart from the game's progress, so a posted
// run says so.
//
// A board's places come with their replays' hashes. The leaderboard opens a world's board at the
// account's place (the slice round it, or its page if it's on it), moves past the rows it shows a
// row at a time, asking for the board's next page from the top (`more`), and goes between the top
// and the account's place. Every row it shows has its replay fetched behind everything else
// (`fetch_rows`), and so do the three places above the account's, found by where it is among them
// (past the first thousand a slice numbers none), and they're held (at most `HELD`, the least
// recently used dropped first, never the ghost's or the race's), so choosing a row plays at once,
// and a world's ghost has its run.

use platform::link::{Account, Answer, Ask, FromGame, to_game}
use platform::posting
use platform::wire::{Found, Place, RunRef, WHOLE}
use replay::{ANY, BOARD, FULL, Replay, YOU, counts}
use std::hash::sha256::sha256
use std::host
use platform::session::answer_of
use std::io::{Pending, load, store}
use std::serialize::{LoadError, Serialize, save}
use main::Storing

/// The leaderboard's boards, in its order: the world's, for the course shown, first; the search
/// of the world's names; the player's own and the tool-assisted (main.wrela's `PLAYERS` and
/// `ASSISTED`); and the world's whole game (each account's best on every level, summed).
pub const WORLD: u32 = 0
pub const SEARCH: u32 = 1
pub const WHOLE_GAME: u32 = 4
pub const BOARDS: u32 = 5

/// Where the posted runs' fingerprints are kept, and the runs waiting to be posted.
const UPLOADED: Text = "capybara/uploaded"
const WAITING: Text = "capybara/posting"
/// A board shown is asked for again after this long (s); a post the console couldn't make (offline,
/// or signed out) waits this long before it's tried again (s); and one the server put off waits
/// longer each time it does, from `AGAIN` to `LONGEST` (`backoff`).
const STALE: f32 = 30.0
const AGAIN: f32 = 30.0
const LONGEST: f32 = 1800.0
/// The most replays held to watch and race (at most 48 KiB each, wire.wrela's `MOST_REPLAY`), the
/// rows of a board shown (main.wrela's `world_rows`, `shown_rows`: each is fetched ahead), and the
/// places above the account's fetched. Both categories of the world's board and of the search,
/// with the places above, the ghost's and a race's, are `HELD`: switching between them drops none.
pub const HELD: u32 = 40
pub const SHOWN: u32 = 8
const ABOVE: u32 = 3

struct Uploaded: Serialize {
    hashes: Vec<Vec<u8>>,
}

/// A run waiting to be posted, as it's stored: its replay, how many times the server put it off
/// (`Answer::Failed`: each wait after is longer, and the count is kept with it, so a closed tab
/// doesn't start over), and whether the player posted it by hand (it goes whatever the account's
/// place, and with "Post my best runs" off).
struct Wait: Clone + Serialize {
    run: Replay,
    tries: u32,
    chosen: bool,
}

struct Waiting: Serialize {
    runs: Vec<Wait>,
}

/// A waiting run: its fingerprint, as stored, and when it may next be tried (the host's time, s).
struct Queued: Clone {
    hash: Vec<u8>,
    wait: Wait,
    at: f32,
}

/// What an ask in flight was, to read its answer.
enum Asked: Clone + Eq {
    /// Run `run` posted (`hash` its fingerprint).
    Upload { run: Replay, hash: Vec<u8> },
    /// The player's Post on the screen of what posting makes public, recorded before `run` is
    /// posted.
    Consent { run: Replay },
    Board { course: u32, category: u32, from: u32 },
    Around { course: u32, category: u32 },
    Watch { name: String, place: u32 },
    Replay { hash: Vec<u8> },
    Names { query: Vec<String>, course: u32 },
}

/// A world's board as last given: its course (or `WHOLE`), category, places, how many it has,
/// and when. A slice around the account's place is one too, its `total` the account's place.
struct Shown: Clone {
    course: u32,
    category: u32,
    places: Vec<Place>,
    total: u32,
    at: f32,
    note: String,
}

pub struct Online {
    started: bool,
    incoming: Option<Pending<u8>>,
    call: Option<u32>,
    replying: Option<Pending<u8>>,
    /// The account, as the console says: who posts.
    pub account: Account,
    /// Whether a console has called at all: opened alone, nothing can be posted.
    pub linked: bool,
    /// The asks the player made, sent first, and the fetches behind them; the one in flight.
    asks: Vec<(Ask, Asked)>,
    fetches: Vec<(Ask, Asked)>,
    flying: Option<Asked>,
    boards: Vec<Shown>,
    slices: Vec<Shown>,
    /// The account's time on each board (course, category, ticks; 0 when it has no place there),
    /// where it's known.
    known: Vec<(u32, u32, u32)>,
    statuses: Vec<(Vec<u8>, String)>,
    /// The posted runs' fingerprints, and the runs waiting to be posted (the player's by hand
    /// first, then the best runs found: one a course for any% and one for 100%), each as stored
    /// and read (`Stored`).
    uploaded: Vec<Vec<u8>>,
    uploads: Stored,
    waiting: Vec<Queued>,
    waits: Stored,
    /// A post of a waiting run under way.
    posting: bool,
    /// The replays held, by their hashes, the least recently used first; those never dropped
    /// while in use (`pin`); and the one the player chose to watch, whose it is and its place.
    held: Vec<(Vec<u8>, Replay)>,
    pins: Vec<Vec<u8>>,
    wanted: Option<(Vec<u8>, String, u32)>,
    watch: Option<(Replay, String, u32)>,
    /// The search last asked for (its title, noun and epithet), how many names it found, their
    /// runs as boards (each course and category's, fastest first: `found_places`), and what to
    /// say.
    query: Vec<String>,
    found: u32,
    found_boards: Vec<Shown>,
    found_note: String,
    /// The run posted by hand while the account hasn't agreed to what posting makes public: the
    /// game shows posting.wrela's screen until the player chooses (`consent`).
    pub consenting: Option<Replay>,
    /// Whether the player is on the leaderboard (`browsing`): the screen of what posting makes
    /// public shows only there, and what the player asked for there goes when they leave.
    here: bool,
    /// Whether to remind the player to save the account's recovery codes: after a post, while
    /// they're still to be saved, until the player has seen it (`reminder`, `reminded`).
    remind: bool,
    time: f32,
}

/// One of the game's stores of its online state: its load and its store under way, and when each
/// is due (main.wrela's `Storing`: never a store over what couldn't be read, and a load or a store
/// that failed made again).
struct Stored {
    loading: Option<Pending<u8>>,
    saving: Option<Pending<u8>>,
    storing: Storing,
}

fn stored() -> Stored {
    Stored { loading: None, saving: None, storing: Storing {} }
}

impl Stored {
    /// What was stored, once its load answers: its bytes; none if nothing was, or if the load
    /// failed (it's made again, and nothing is stored over what it couldn't read meanwhile).
    fn loaded(mut self) -> Option<Vec<u8>> {
        let Some(result) = answer_of(mut self.loading) else { return None }
        match result {
            Ok(bytes) => {
                self.storing.loaded(read: true)
                Some(bytes.clone())
            },
            Err(e) => {
                self.storing.loaded(read: e.missing())
                None
            },
        }
    }

    /// `dt` seconds on: whether to load it (again), and whether to store it now.
    fn due(mut self, dt: f32) -> (bool, bool) {
        if let Some(result) = answer_of(mut self.saving) {
            self.storing.stored(ok: result.is_ok())
        }
        self.storing.due(dt, loading: self.loading.is_some(), saving: self.saving.is_some())
    }
}

pub fn online() -> Online {
    Online {
        started: false,
        incoming: None,
        call: None,
        replying: None,
        account: Account { signed_in: false, name: String::new(), token: Vec::new() },
        linked: false,
        asks: Vec::new(),
        fetches: Vec::new(),
        flying: None,
        boards: Vec::new(),
        slices: Vec::new(),
        known: Vec::new(),
        statuses: Vec::new(),
        uploaded: Vec::new(),
        uploads: stored(),
        waiting: Vec::new(),
        waits: stored(),
        posting: false,
        held: Vec::new(),
        pins: Vec::new(),
        wanted: None,
        watch: None,
        query: Vec::new(),
        found: 0,
        found_boards: Vec::new(),
        found_note: String::new(),
        consenting: None,
        here: false,
        remind: false,
        time: 0.0,
    }
}

/// A replay's fingerprint: the SHA-256 of its bytes, as the server names it too.
pub fn fingerprint(r: Replay) -> Vec<u8> {
    Vec::from(sha256(save(r)))
}

/// Each frame, at the host's time `time`: the stored runs read and stored, the console's call
/// read, a waiting run posted if one may be, and an ask sent if one waits.
pub fn update(o: mut Online, time: f32) {
    let dt = max(time - o.time, 0.0)
    o.time = time
    if !o.started {
        o.started = true
        o.incoming = Some(host::receive())
    }
    if let Some(bytes) = o.uploads.loaded() {
        let r: Result<Uploaded, LoadError> = std::serialize::load(take bytes)
        if let Ok(u) = r {
            for h in u.hashes {
                mark_uploaded(mut o, h.clone())
            }
        }
    }
    if let Some(bytes) = o.waits.loaded() {
        let r: Result<Waiting, LoadError> = std::serialize::load(take bytes)
        if let Ok(w) = r {
            restore(mut o, w)
        }
    }
    let (loads, stores) = o.uploads.due(dt)
    if loads {
        o.uploads.loading = Some(load(UPLOADED))
    }
    if stores {
        o.uploads.saving = Some(store(UPLOADED, save(Uploaded { hashes: o.uploaded.clone() })))
    }
    let (loads, stores) = o.waits.due(dt)
    if loads {
        o.waits.loading = Some(load(WAITING))
    }
    if stores {
        var runs: Vec<Wait> = Vec::with_capacity(o.waiting.len())
        for q in o.waiting {
            runs.push(q.wait.clone())
        }
        o.waits.saving = Some(store(WAITING, save(Waiting { runs })))
    }
    let _ = answer_of(mut o.replying)
    if let Some(result) = answer_of(mut o.incoming) {
        match result {
            Ok(bytes) => {
                if let Some(call) = host::read_call(bytes) {
                    if let Some(t) = to_game(call.bytes) {
                        o.linked = true
                        o.account = t.account.clone()
                        let flying = o.flying.clone()
                        o.flying = None
                        if let Some(asked) = flying {
                            answered(mut o, asked, t.answer.clone())
                        }
                        o.call = Some(call.id)
                    }
                }
            },
            // No console shows the game (or the channel closed): nothing to ask.
            Err(_) => o.linked = false,
        }
    }
    pump(mut o)
    if let Some(id) = o.call {
        if !o.asks.is_empty() || !o.fetches.is_empty() {
            let (ask, asked) = if !o.asks.is_empty() { o.asks.remove(0) } else {
                o.fetches.remove(0)
            }
            o.replying = Some(host::reply(id, save(FromGame { ask })))
            o.call = None
            o.flying = Some(take asked)
            o.incoming = Some(host::receive())
        }
    }
}

fn set_status(o: mut Online, hash: Vec<u8>, status: String) {
    for i in 0..o.statuses.len() {
        if o.statuses[i].0 == hash {
            o.statuses[i].1 = status.clone()
            return
        }
    }
    o.statuses.push((hash.clone(), status.clone()))
}

/// Whether `hash` is among `hashes`.
fn has_hash(hashes: [Vec<u8>], hash: Vec<u8>) -> bool {
    for h in hashes {
        if h == hash {
            return true
        }
    }
    false
}

/// Whether the run whose fingerprint is `hash` has been posted.
fn posted(o: Online, hash: Vec<u8>) -> bool {
    has_hash(o.uploaded, hash)
}

fn mark_uploaded(o: mut Online, hash: Vec<u8>) {
    if posted(o, hash) {
        return
    }
    o.uploaded.push(hash.clone())
    o.uploads.storing.unsaved = true
}

// ---- asking ------------------------------------------------------------------------------------

/// Who an ask is for, which says when it may be made (design.md, "Online play": play stays offline
/// unless the player is signed in or asks for the world).
pub enum By: Copy + Eq {
    /// The player asked for it, or for what brings it (a board's rows bring their replays): it
    /// needs a console.
    Player,
    /// Nobody asked: a board for the pause's facts or a ghost, the slice around the account's
    /// place, the recovery codes' reminder. It needs a signed-in account.
    Background,
    /// A post nobody asked for, of a run that beats the account's place: it needs an account that
    /// posts its best runs (`posts_alone`).
    Alone,
}

/// Whether an ask for `by` may be made now.
fn may(o: Online, by: By) -> bool {
    match by {
        By::Player => o.linked,
        By::Background => o.linked && o.account.signed_in && !o.account.name.is_empty(),
        By::Alone => posts_alone(o),
    }
}

/// Whether `asked` is asked already: in flight, or waiting.
fn asking(o: Online, asked: Asked) -> bool {
    if let Some(f) = o.flying {
        if f == asked {
            return true
        }
    }
    for (_, a) in o.asks {
        if a == asked {
            return true
        }
    }
    for (_, a) in o.fetches {
        if a == asked {
            return true
        }
    }
    false
}

/// Asks `ask` (`asked` to read its answer) for `by`, if `by` may and it isn't asked already: a
/// replay or a slice behind the player's asks, the rest before them. Whether it was asked.
fn ask(o: mut Online, ask: take Ask, asked: take Asked, by: By) -> bool {
    if !may(o, by) || asking(o, asked) {
        return false
    }
    let behind = match asked {
        Asked::Replay { .. } => true,
        Asked::Around { .. } => true,
        _ => false,
    }
    if behind {
        o.fetches.push((take ask, take asked))
    } else {
        o.asks.push((take ask, take asked))
    }
    true
}

// ---- posting -----------------------------------------------------------------------------------

/// Whether the game may post a run with nobody asking: linked to a signed-in account that has
/// agreed to what posting makes public and asked for its best runs to be posted.
fn posts_alone(o: Online) -> bool {
    o.linked &&
        o.account.signed_in &&
        !o.account.token.is_empty() &&
        o.account.may_post &&
        o.account.post_best
}

/// The account's time on board (`course`, `category`), if it's known: 0 when it has no place.
fn known(o: Online, course: u32, category: u32) -> Option<u32> {
    for (c, k, ticks) in o.known {
        if c == course && k == category {
            return Some(ticks)
        }
    }
    None
}

fn learn(o: mut Online, course: u32, category: u32, ticks: u32) {
    for i in 0..o.known.len() {
        if o.known[i].0 == course && o.known[i].1 == category {
            o.known[i].2 = ticks
            return
        }
    }
    o.known.push((course, category, ticks))
}

/// Whether run `r` would take a better place than the account's on a board it counts for: it has
/// none there, its time there isn't known, or `r` is faster.
pub fn beats(o: Online, r: Replay) -> bool {
    for category in [ANY, FULL] {
        if !counts(r, category) {
            continue
        }
        match known(o, r.course, category) {
            Some(ticks) => {
                if ticks == 0 || r.ticks < ticks {
                    return true
                }
            },
            None => return true,
        }
    }
    false
}

/// How long a run the server has put off `tries` times waits before it's tried again (s): twice as
/// long each time, from `AGAIN` up to `LONGEST`.
fn backoff(tries: u32) -> f32 {
    var wait = AGAIN
    for _ in 1..min(tries, 16) {
        wait = min(wait * 2.0, LONGEST)
    }
    wait
}

/// Which of the waiting runs has fingerprint `hash`, if one does.
fn queued(o: Online, hash: [u8]) -> Option<u32> {
    for i in 0..o.waiting.len() {
        if o.waiting[i].hash == Vec::from(hash) {
            return Some(i)
        }
    }
    None
}

/// `w` among the waiting runs, to be tried from `at`: one the player posted by hand ahead of the
/// rest, once; a best run found in its course and category's place, if it's the faster.
fn queue(o: mut Online, w: Wait, at: f32) {
    let hash = fingerprint(w.run)
    if let Some(i) = queued(o, hash) {
        if w.chosen && !o.waiting[i].wait.chosen {
            // Posted by hand now: it goes first, whatever its place.
            var q = o.waiting.remove(i)
            q.wait.chosen = true
            q.at = min(q.at, at)
            o.waiting.insert(0, take q)
            o.waits.storing.unsaved = true
        }
        return
    }
    if w.chosen {
        o.waiting.insert(0, Queued { hash, wait: w.clone(), at })
        o.waits.storing.unsaved = true
        return
    }
    let (course, full) = (w.run.course, counts(w.run, FULL))
    let slot = |q: Queued| !q.wait.chosen &&
        q.wait.run.course == course &&
        counts(q.wait.run, FULL) == full
    for q in o.waiting {
        if slot(q) && q.wait.run.ticks <= w.run.ticks {
            return
        }
    }
    o.waiting.retain(|q| !slot(q))
    o.waiting.push(Queued { hash, wait: w.clone(), at })
    o.waits.storing.unsaved = true
}

/// The waiting runs as stored, read: each put off before waits as long again as it last did.
fn restore(o: mut Online, w: Waiting) {
    for k in w.runs {
        let at = if k.tries > 0 { o.time + backoff(k.tries) } else { o.time }
        queue(mut o, k.clone(), at)
    }
}

/// Run `r` waiting to be posted: by hand (`chosen`), or as a best run found.
fn wait(o: mut Online, r: Replay, chosen: bool) {
    queue(mut o, Wait { run: r.clone(), tries: 0, chosen }, o.time)
}

fn unwait(o: mut Online, hash: Vec<u8>) {
    let before = o.waiting.len()
    o.waiting.retain(|q| q.hash != hash)
    if o.waiting.len() != before {
        o.waits.storing.unsaved = true
    }
}

/// The waiting run with fingerprint `hash` put off: the server's `retry_after` seconds at least,
/// and if the server put it off (`counted`), longer each time.
fn put_off(o: mut Online, hash: Vec<u8>, retry_after: f32, counted: bool) {
    let Some(i) = queued(o, hash) else { return }
    if counted {
        o.waiting[i].wait.tries += 1
        o.waits.storing.unsaved = true
    }
    let wait = if counted { backoff(o.waiting[i].wait.tries) } else { AGAIN }
    o.waiting[i].at = o.time + max(wait, retry_after)
}

/// A run the player has just finished (`r`, theirs and verified): it waits to be posted if it
/// may be, when it beats the account's place, or the account's place isn't known. A run made
/// while the game is linked to an account that doesn't post its best runs doesn't wait; one made
/// while what the account chose isn't known yet does.
pub fn finished(o: mut Online, r: Replay) {
    let hash = fingerprint(r)
    if r.who != YOU || posted(o, hash) || !beats(o, r) {
        return
    }
    if o.linked && o.account.signed_in && o.account.posting_known && !o.account.post_best {
        return
    }
    wait(mut o, r.clone(), chosen: false)
    if posts_alone(o) {
        set_status(mut o, hash, String::from("Posting…"))
    }
}

/// Whether the game can post now for its account: linked to one that's signed in, with a token,
/// whose choices of posting are known (until they are, nothing is taken as a choice).
fn can_post(o: Online) -> bool {
    o.linked && o.account.signed_in && !o.account.token.is_empty() && o.account.posting_known
}

/// The waiting runs posted, one at a time, each once it's due: one posted by hand as soon as the
/// account has agreed to what posting makes public (until then, the screen of it, while the player
/// is on the leaderboard: `consenting`); a best run found while the account posts its best runs,
/// once the account's places on each board it counts for are known (the slices around them), and
/// only if it beats one.
fn pump(o: mut Online) {
    if o.posting || !can_post(o) {
        return
    }
    for i in 0..o.waiting.len() {
        let q = o.waiting[i].clone()
        if q.at > o.time {
            continue
        }
        if posted(o, q.hash) {
            unwait(mut o, q.hash)
            return
        }
        borrow r = q.wait.run
        if q.wait.chosen {
            if !o.account.may_post {
                unwait(mut o, q.hash.clone())
                if o.here && o.consenting.is_none() {
                    o.consenting = Some(r.clone())
                } else {
                    set_status(mut o, q.hash, String::from("Not posted"))
                }
                return
            }
            upload(mut o, r, q.hash, By::Player)
            return
        }
        if !posts_alone(o) {
            continue
        }
        // Its places first, on each board it counts for, then whether it beats one.
        var unknown = false
        for category in [ANY, FULL] {
            if counts(r, category) && known(o, r.course, category).is_none() {
                unknown = true
                if !asking(o, Asked::Around { course: r.course, category }) &&
                    !around(mut o, r.course, category) {
                    put_off(mut o, q.hash.clone(), AGAIN, counted: false)
                }
            }
        }
        if unknown {
            return
        }
        if !beats(o, r) {
            unwait(mut o, q.hash)
            return
        }
        upload(mut o, r, q.hash, By::Alone)
        return
    }
}

/// Asks to post run `r` (its fingerprint `hash`) for `by`.
fn upload(o: mut Online, r: Replay, hash: Vec<u8>, by: By) {
    let upload = Ask::Upload { token: o.account.token.clone(), board: BOARD, replay: save(r) }
    if ask(mut o, take upload, Asked::Upload { run: r.clone(), hash: hash.clone() }, by) {
        o.posting = true
        set_status(mut o, hash, String::from("Posting…"))
    }
}

/// Posts run `r` at the player's choice, unless it has been: it waits, first of all, until it can
/// go (`pump`): the screen of what posting makes public first, until the account has agreed; and
/// if the server can't take it now, tried again later. Its status says how it went.
pub fn post(o: mut Online, r: Replay) {
    let hash = fingerprint(r)
    if posted(o, hash) {
        set_status(mut o, hash.clone(), String::from("Posted"))
        return
    }
    if !o.linked {
        set_status(mut o, hash, String::from("Open the game from wrela.dev to post."))
        return
    }
    if !o.account.signed_in || o.account.token.is_empty() {
        set_status(mut o, hash, String::from("Sign in at the console to post. Press F10."))
        return
    }
    set_status(mut o, hash.clone(), String::from("Posting…"))
    wait(mut o, r.clone(), chosen: true)
    pump(mut o)
}

/// The player's choice on the screen of what posting makes public, for the run it was shown for:
/// Post (`post`, with posting.wrela's `BEST_RUNS` box ticked or not) is recorded through the
/// console, then the run goes; Not now posts nothing.
pub fn consent(o: mut Online, post: bool, best_runs: bool) {
    let Some(r) = o.consenting.clone() else { return }
    o.consenting = None
    if !post {
        set_status(mut o, fingerprint(r), String::from("Not posted"))
        return
    }
    let agreed = Ask::Consent { version: posting::VERSION, best_runs }
    let _ = ask(mut o, take agreed, Asked::Consent { run: r }, By::Player)
}

/// Whether the player is on the leaderboard, each frame. Leaving it is Not now to the screen of
/// what posting makes public.
pub fn browsing(o: mut Online, on: bool) {
    if o.here && !on && o.consenting.is_some() {
        consent(mut o, post: false, best_runs: false)
    }
    o.here = on
}

/// The line to show after a post while the account's recovery codes are still to be saved
/// (posting.wrela's `SAVE_CODES`), until the player has seen it.
pub fn reminder(o: Online) -> Option<Text> {
    if o.remind && o.account.save_codes { Some(posting::SAVE_CODES) } else { None }
}

/// The reminder seen: it isn't shown again this time the game is open.
pub fn reminded(o: mut Online) {
    o.remind = false
}

/// What to say of the run whose fingerprint is `hash`: how its post went, or that it was posted;
/// empty if neither.
pub fn status(o: Online, hash: Vec<u8>) -> String {
    for (h, s) in o.statuses {
        if h == hash {
            return s.clone()
        }
    }
    if posted(o, hash) {
        return String::from("Posted")
    }
    String::new()
}

// ---- answers -----------------------------------------------------------------------------------

/// The console's answer to an ask: a run's post, a board or a slice, a replay, or names.
fn answered(o: mut Online, asked: Asked, answer: Answer) {
    match asked {
        Asked::Upload { run, hash } => {
            o.posting = false
            match answer {
                Answer::Verified { place, ticks, .. } => {
                    set_status(mut o, hash.clone(), f"{ordinal(place)} in the world")
                    mark_uploaded(mut o, hash.clone())
                    unwait(mut o, hash)
                    // The server's time for it, which it played: the account's best where it's
                    // better.
                    for category in [ANY, FULL] {
                        if counts(run, category) {
                            let before = known(o, run.course, category).unwrap_or(0)
                            if before == 0 || ticks < before {
                                learn(mut o, run.course, category, ticks)
                            }
                        }
                    }
                    if o.account.save_codes {
                        o.remind = true
                    }
                    // The boards are asked for again when next shown, kept meanwhile.
                    for i in 0..o.boards.len() {
                        o.boards[i].at = o.time - STALE
                    }
                },
                // For good: that replay can never go on this board.
                Answer::Rejected { why } => {
                    unwait(mut o, hash)
                    set_status(mut o, hash, why.clone())
                },
                // The console couldn't ask (offline, signed out): as it was, a while later.
                Answer::Offline { why } => {
                    put_off(mut o, hash.clone(), AGAIN, counted: false)
                    set_status(mut o, hash, why.clone())
                },
                // Not now: it waits, longer each time the server puts it off, and posting it
                // again hears what came of it if it went up after all.
                Answer::Failed { why, retry_after } => {
                    put_off(mut o, hash.clone(), f32(retry_after), counted: true)
                    set_status(mut o, hash, why.clone())
                },
                _ => put_off(mut o, hash, AGAIN, counted: false),
            }
        },
        Asked::Consent { run } => match answer {
            // The console's call carries the account as the player left it.
            Answer::Done => {
                if o.account.may_post {
                    post(mut o, run)
                } else {
                    set_status(mut o, fingerprint(run), String::from("Not posted"))
                }
            },
            Answer::Offline { why } => set_status(mut o, fingerprint(run), why.clone()),
            Answer::Rejected { why } => set_status(mut o, fingerprint(run), why.clone()),
            Answer::Failed { why, .. } => set_status(mut o, fingerprint(run), why.clone()),
            _ => {},
        },
        Asked::Board { course, category, from } => {
            let (places, total, note) = match answer {
                Answer::Board { places, total, .. } => (
                    places.clone(),
                    total,
                    if places.is_empty() {
                        String::from("Nobody's on this board yet. Be first.")
                    } else { String::new() },
                ),
                Answer::Offline { why } => (Vec::new(), 0, why.clone()),
                Answer::Rejected { why } => (Vec::new(), 0, why.clone()),
                _ => (Vec::new(), 0, String::new()),
            }
            if from > 0 {
                // A page further down, after the places shown: kept if they're still the ones it
                // follows.
                if let Some(i) = board_of(o.boards, course, category) {
                    if o.boards[i].places.len() == from && note.is_empty() {
                        for p in places {
                            o.boards[i].places.push(p.clone())
                        }
                        o.boards[i].total = total
                        fetch_rows(mut o, places)
                    }
                }
                return
            }
            o.boards.retain(|b| b.course != course || b.category != category)
            o.boards.push(Shown { course, category, places, total, at: o.time, note })
            rows_came(mut o, course, category)
        },
        Asked::Around { course, category } => match answer {
            Answer::Around { places, at } => {
                var mine = 0
                for p in places {
                    if p.name == o.account.name {
                        mine = p.ticks
                    }
                }
                learn(mut o, course, category, mine)
                o.slices.retain(|b| b.course != course || b.category != category)
                o.slices.push(
                    Shown {
                        course,
                        category,
                        places: places.clone(),
                        total: at,
                        at: o.time,
                        note: String::new(),
                    },
                )
                fetch_above(mut o, places)
            },
            // No place there yet: any run of the account's is its first.
            Answer::Unplaced => {
                learn(mut o, course, category, 0)
                o.slices.retain(|b| b.course != course || b.category != category)
            },
            // Not known: asked again when the run is next due.
            _ => {},
        },
        Asked::Watch { name, place } => match answer {
            Answer::Run { replay, .. } => {
                if let Ok(r) = boards::read(replay) {
                    o.watch = Some((take r, name.clone(), place))
                }
            },
            _ => {},
        },
        Asked::Replay { hash } => {
            if let Answer::Run { replay, .. } = answer {
                came(mut o, hash.clone(), replay)
            }
        },
        Asked::Names { query, course } => {
            if query != o.query {
                return
            }
            match answer {
                Answer::Names { found } => {
                    came_names(mut o, found, course)
                    o.found_note = if found.is_empty() {
                        String::from("Nobody by that name is on the boards yet.")
                    } else { String::new() }
                },
                Answer::Rejected { why } => {
                    clear_found(mut o)
                    o.found_note = why.clone()
                },
                Answer::Offline { why } => {
                    clear_found(mut o)
                    o.found_note = why.clone()
                },
                _ => {},
            }
        },
    }
}

/// `n` as a place: 1st, 2nd, 3rd, 4th...
pub fn ordinal(n: u32) -> String {
    let tail = if n % 100 >= 11 && n % 100 <= 13 { "th" } else if n % 10 == 1 { "st" } else if n %
        10 ==
        2 {
        "nd"
    } else if n % 10 == 3 { "rd" } else { "th" }
    f"{n}{tail}"
}

// ---- boards ------------------------------------------------------------------------------------

/// Which of `shown` is board (`course`, `category`), if one is.
fn board_of(shown: [Shown], course: u32, category: u32) -> Option<u32> {
    for i in 0..shown.len() {
        if shown[i].course == course && shown[i].category == category {
            return Some(i)
        }
    }
    None
}

/// The first place that `is` picks on a board of `shown` for course `course` (of `category`, or
/// of either with none): which board, and which of its places.
fn picked(
    shown: [Shown],
    course: u32,
    category: Option<u32>,
    is: fn(Place) -> bool,
) -> Option<(u32, u32)> {
    for b in 0..shown.len() {
        borrow board = shown[b]
        if board.course != course || (category.is_some() && category != Some(board.category)) {
            continue
        }
        for i in 0..board.places.len() {
            if is(board.places[i]) {
                return Some((b, i))
            }
        }
    }
    None
}

/// Asks for board (`course`, or `WHOLE`, and `category`) for `by`, if it isn't shown or is stale.
pub fn want(o: mut Online, course: u32, category: u32, by: By) {
    let shown = board_of(o.boards, course, category)
    if let Some(i) = shown {
        if o.time - o.boards[i].at < STALE {
            return
        }
    }
    let board = Ask::Board { course, category, from: 0 }
    if !ask(mut o, take board, Asked::Board { course, category, from: 0 }, by) {
        return
    }
    // Shown as loading until it comes; a board asked again keeps its places meanwhile.
    if shown.is_none() {
        o.boards.push(
            Shown {
                course,
                category,
                places: Vec::new(),
                total: 0,
                at: o.time,
                note: String::from("Loading the world's runs…"),
            },
        )
    }
}

/// Asks for board (`course`, `category`) once, for a ghost (in the background): if it has never
/// been shown.
pub fn want_once(o: mut Online, course: u32, category: u32) {
    if board_of(o.boards, course, category).is_some() {
        return
    }
    want(mut o, course, category, By::Background)
}

/// Board (`course`, `category`)'s places, and what to say if it has none.
pub fn places(o: Online, course: u32, category: u32) -> (Vec<Place>, String) {
    if !o.linked {
        return (Vec::new(), String::from("Open the game from wrela.dev to see the world's runs."))
    }
    match board_of(o.boards, course, category) {
        Some(i) => (o.boards[i].places.clone(), o.boards[i].note.clone()),
        None => (Vec::new(), String::from("Loading the world's runs…")),
    }
}

/// Asks for the next page of board (`course`, `category`), after the places it has, if it has more
/// and none is asked: for the player, who scrolled to the last row shown.
pub fn more(o: mut Online, course: u32, category: u32) {
    let Some(i) = board_of(o.boards, course, category) else { return }
    let from = o.boards[i].places.len()
    if from == 0 || from >= o.boards[i].total {
        return
    }
    let page = Ask::Board { course, category, from }
    let _ = ask(mut o, take page, Asked::Board { course, category, from }, By::Player)
}

/// The places around the account's on board (`course`, `category`), as the slice last gave them:
/// none if it hasn't come, or the account has no place there.
pub fn slice(o: Online, course: u32, category: u32) -> Vec<Place> {
    match board_of(o.slices, course, category) {
        Some(i) => o.slices[i].places.clone(),
        None => Vec::new(),
    }
}

/// How many of a board's rows the leaderboard shows at once: the search's line takes the first.
pub fn shown_rows(board: u32) -> u32 {
    if board == SEARCH { SHOWN - 1 } else { SHOWN }
}

/// The rows board `board` shows of `places`, from the one at `first`.
pub fn window(places: [Place], first: u32, board: u32) -> Vec<Place> {
    var out: Vec<Place> = Vec::new()
    for i in first..min(places.len(), first + shown_rows(board)) {
        out.push(places[i].clone())
    }
    out
}

/// Where `name` is among `places`, if it is.
fn index_of(places: [Place], name: str) -> Option<u32> {
    for i in 0..places.len() {
        if places[i].name.as_str() == name {
            return Some(i)
        }
    }
    None
}

/// The first row board `board` shows of `places` so that `name`'s is among them, with the places
/// just above it (`ABOVE`, the runs to race) over it, and where `name`'s is: none if it isn't
/// there.
pub fn anchor(places: [Place], name: str, board: u32) -> Option<(u32, u32)> {
    let Some(i) = index_of(places, name) else { return None }
    let last = max(places.len(), shown_rows(board)) - shown_rows(board)
    Some((min(max(i, ABOVE) - ABOVE, last), i))
}

/// Whether the signed-in account has a place on board (`course`, `category`), as its page or the
/// slice around it last said: numbered or not (past the first thousand a slice doesn't number).
pub fn placed(o: Online, course: u32, category: u32) -> bool {
    if !o.account.signed_in || o.account.name.is_empty() {
        return false
    }
    borrow name = o.account.name
    mine_in(o.boards, course, category, name).is_some() ||
        mine_in(o.slices, course, category, name).is_some()
}

/// Board (`course`, `category`) among `shown`, and where `name` is among its places, if it is.
fn mine_in(shown: [Shown], course: u32, category: u32, name: str) -> Option<(u32, u32)> {
    let Some(b) = board_of(shown, course, category) else { return None }
    match index_of(shown[b].places, name) {
        Some(i) => Some((b, i)),
        None => None,
    }
}

/// The signed-in account's place on board (`course`, `category`) as last given, by its page or the
/// slice around it: 0 if it has none there, or neither has come.
pub fn my_place(o: Online, course: u32, category: u32) -> u32 {
    if !o.account.signed_in || o.account.name.is_empty() {
        return 0
    }
    borrow name = o.account.name
    let mine = |p: Place| p.place > 0 && p.name == name
    if let Some((b, i)) = picked(o.boards, course, Some(category), mine) {
        return o.boards[b].places[i].place
    }
    match picked(o.slices, course, Some(category), mine) {
        Some((b, i)) => o.slices[b].places[i].place,
        None => 0,
    }
}

/// A board's rows came: the replays of those shown are fetched, and of the three places above the
/// account's, from the board's page or, past it, from the slice around its place.
fn rows_came(o: mut Online, course: u32, category: u32) {
    let Some(shown) = board_of(o.boards, course, category) else { return }
    let places = o.boards[shown].places.clone()
    let total = o.boards[shown].total
    fetch_rows(mut o, window(places, 0, WORLD))
    if !o.account.signed_in || o.account.name.is_empty() {
        return
    }
    var mine = 0
    for p in places {
        if p.name == o.account.name {
            mine = p.place
            learn(mut o, course, category, p.ticks)
        }
    }
    if mine > 0 {
        fetch_above(mut o, places)
    } else if total <= places.len() {
        learn(mut o, course, category, 0)
    } else if known(o, course, category) != Some(0) {
        let _ = around(mut o, course, category)
    }
}

/// The replays of the `ABOVE` places just above the account's among `places`, by where it is
/// (past the first thousand a slice numbers none).
fn fetch_above(o: mut Online, places: [Place]) {
    let Some(i) = index_of(places, o.account.name.as_str()) else { return }
    for k in max(i, ABOVE) - ABOVE..i {
        fetch(mut o, places[k].replay.clone())
    }
}

/// Asks, behind the player's asks, for the slice of board (`course`, `category`) around the
/// account's place, unless it's asked already. Whether it was asked.
fn around(o: mut Online, course: u32, category: u32) -> bool {
    let slice = Ask::Around { course, category, name: o.account.name.clone() }
    ask(mut o, take slice, Asked::Around { course, category }, By::Background)
}

/// The course the world's board asks for: the course shown, or a whole game's.
pub fn board_course(board: u32, course: u32) -> u32 {
    if board == WHOLE_GAME { WHOLE } else { course }
}

// ---- replays -----------------------------------------------------------------------------------

/// Which of the replays held has hash `hash`, if one does.
fn held_at(o: Online, hash: Vec<u8>) -> Option<u32> {
    for i in 0..o.held.len() {
        if o.held[i].0 == hash {
            return Some(i)
        }
    }
    None
}

/// Whether the replay whose hash is `hash` is held.
pub fn is_held(o: Online, hash: Vec<u8>) -> bool {
    held_at(o, hash).is_some()
}

/// The replay held whose hash is `hash`, if it is.
pub fn held(o: Online, hash: Vec<u8>) -> Option<Replay> {
    match held_at(o, hash) {
        Some(i) => Some(o.held[i].1.clone()),
        None => None,
    }
}

/// The replays held that are never dropped while they're in use: the ghost's, and the one a race
/// waits for (each empty for none).
pub fn pin(o: mut Online, ghost: Vec<u8>, race: Vec<u8>) {
    if o.pins.len() != 2 || o.pins[0] != ghost || o.pins[1] != race {
        o.pins = Vec::from([ghost.clone(), race.clone()])
    }
}

/// The replay held whose hash is `hash`, used now: the last to be dropped.
fn touch(o: mut Online, hash: Vec<u8>) {
    let Some(i) = held_at(o, hash) else { return }
    if i + 1 < o.held.len() {
        let used = o.held.remove(i)
        o.held.push(take used)
    }
}

/// Holds replay `r`, whose hash is `hash`, as the most recently used, dropping the least recently
/// used past `HELD` that isn't pinned.
fn hold(o: mut Online, hash: Vec<u8>, r: Replay) {
    if held_at(o, hash).is_some() {
        touch(mut o, hash)
        return
    }
    o.held.push((hash.clone(), r.clone()))
    while o.held.len() > HELD {
        var dropped = false
        for i in 0..o.held.len() {
            if !has_hash(o.pins, o.held[i].0) {
                let _ = o.held.remove(i)
                dropped = true
                break
            }
        }
        if !dropped {
            return
        }
    }
}

/// Asks for the replays of `places`, the rows shown, behind the player's asks.
pub fn fetch_rows(o: mut Online, places: [Place]) {
    for p in places {
        fetch(mut o, p.replay.clone())
    }
}

/// Asks for the replay whose hash is `hash`, behind the player's asks, unless it's held or asked:
/// for what the player asked brings (a board's rows, the places above the account's).
fn fetch(o: mut Online, hash: Vec<u8>) {
    if hash.len() != 32 || is_held(o, hash) {
        return
    }
    let Some(run) = run_of(o, hash) else { return }
    let _ = ask(mut o, Ask::Watch { run }, Asked::Replay { hash: hash.clone() }, By::Player)
}

/// The run whose replay's hash is `hash`, from the places shown (a board's, a slice's or a
/// search's), which the server reads it by.
fn run_of(o: Online, hash: [u8]) -> Option<RunRef> {
    let find = |shown: [Shown]| -> Option<RunRef> {
        for b in shown {
            for p in b.places {
                if p.replay == Vec::from(hash) && !p.run.is_none() {
                    return Some(p.run.clone())
                }
            }
        }
        None
    }
    if let Some(r) = find(o.boards) {
        return Some(r)
    }
    if let Some(r) = find(o.slices) {
        return Some(r)
    }
    find(o.found_boards)
}

/// Asks for the replay whose hash is `hash` before anything fetched behind, unless it's held or
/// already on its way: for a row chosen, a race or a ghost. One waiting behind is brought forward.
pub fn fetch_now(o: mut Online, hash: Vec<u8>) {
    if is_held(o, hash) {
        touch(mut o, hash)
        return
    }
    fetch(mut o, hash)
    let asked = Asked::Replay { hash: hash.clone() }
    for i in 0..o.fetches.len() {
        if o.fetches[i].1 == asked {
            let waiting = o.fetches.remove(i)
            o.asks.push(take waiting)
            return
        }
    }
}

/// A replay that came for `hash`: held if its bytes are the run's own (their SHA-256 is the hash)
/// and a run of this game; watched if it's the one the player chose.
fn came(o: mut Online, hash: Vec<u8>, bytes: [u8]) {
    if Vec::from(sha256(bytes)) != hash {
        return
    }
    let Ok(r) = boards::read(bytes) else { return }
    hold(mut o, hash, r)
    let wanted = o.wanted.clone()
    if let Some((h, name, place)) = wanted {
        if h == hash {
            o.wanted = None
            o.watch = Some((take r, name.clone(), place))
        }
    }
}

/// Watches the run at `place`: at once if its replay is held, else when it comes (a whole game's
/// place is several runs, and isn't watched).
pub fn watch_place(o: mut Online, place: Place) {
    if !place.replay.is_empty() {
        if let Some(r) = held(o, place.replay) {
            touch(mut o, place.replay)
            o.watch = Some((take r, place.name.clone(), place.place))
            return
        }
        o.wanted = Some((place.replay.clone(), place.name.clone(), place.place))
        fetch_now(mut o, place.replay.clone())
        return
    }
    if place.run.is_none() || o.flying.is_some() && o.asks.len() > 4 {
        return
    }
    let watched = Asked::Watch { name: place.name.clone(), place: place.place }
    let _ = ask(mut o, Ask::Watch { run: place.run.clone() }, take watched, By::Player)
}

/// A world's run that has come to watch, whose it is and its place, once.
pub fn take_watch(o: mut Online) -> Option<(Replay, String, u32)> {
    let w = o.watch.clone()
    o.watch = None
    w
}

/// The hash of the replay a world's ghost runs on course `course` (any%): the world record
/// (`record`), or the run just above the account's, found by where the account is among the places
/// shown (its board's page, or the slice around it, which past the first thousand numbers none);
/// the record, if the account holds it. None while the board, or the account's place on it, isn't
/// known.
pub fn ghost_hash(o: Online, course: u32, record: bool) -> Option<Vec<u8>> {
    if record {
        let first = |p: Place| p.place == 1 && !p.replay.is_empty()
        if let Some((b, i)) = picked(o.boards, course, Some(ANY), first) {
            return Some(o.boards[b].places[i].replay.clone())
        }
        return match picked(o.slices, course, Some(ANY), first) {
            Some((b, i)) => Some(o.slices[b].places[i].replay.clone()),
            None => None,
        }
    }
    if !o.account.signed_in || o.account.name.is_empty() {
        return None
    }
    borrow name = o.account.name
    if let Some(h) = above(o.boards, course, name) {
        return Some(h)
    }
    above(o.slices, course, name)
}

/// The replay's hash of the run just above `name`'s among board (`course`, any%) of `shown`, by
/// position; `name`'s own, if it's the first place.
fn above(shown: [Shown], course: u32, name: str) -> Option<Vec<u8>> {
    let Some((b, i)) = mine_in(shown, course, ANY, name) else { return None }
    borrow places = shown[b].places
    if i > 0 && !places[i - 1].replay.is_empty() {
        return Some(places[i - 1].replay.clone())
    }
    if i == 0 && places[0].place == 1 {
        return Some(places[0].replay.clone())
    }
    None
}

/// The place and name of the run whose replay's hash is `hash`, on a board or a slice of course
/// `course` shown: for the ghost's name.
pub fn whose(o: Online, course: u32, hash: Vec<u8>) -> Option<(String, u32)> {
    let run = |p: Place| p.replay == hash
    if let Some((b, i)) = picked(o.boards, course, None, run) {
        borrow p = o.boards[b].places[i]
        return Some((p.name.clone(), p.place))
    }
    match picked(o.slices, course, None, run) {
        Some((b, i)) => Some((o.slices[b].places[i].name.clone(), o.slices[b].places[i].place)),
        None => None,
    }
}

// ---- searching names ---------------------------------------------------------------------------

/// Searches the names whose parts start with `title`, `noun` and `epithet` (the player opened the
/// search, so it may ask) from the leaderboard of course `course`: unless it's what was last
/// asked. An empty search finds nothing.
pub fn search(o: mut Online, course: u32, title: str, noun: str, epithet: str) {
    let query = Vec::from([String::from(title), String::from(noun), String::from(epithet)])
    if title.is_empty() && noun.is_empty() && epithet.is_empty() {
        o.query.clear()
        clear_found(mut o)
        o.found_note = String::new()
        return
    }
    if query == o.query {
        return
    }
    // A newer search in the place of one still waiting.
    o.asks.retain(
        |a| match a.1 {
            Asked::Names { .. } => false,
            _ => true,
        },
    )
    let names = Ask::Names {
        title: String::from(title),
        noun: String::from(noun),
        epithet: String::from(epithet),
    }
    if !ask(mut o, take names, Asked::Names { query: query.clone(), course }, By::Player) {
        clear_found(mut o)
        o.found_note = String::from("Open the game from wrela.dev to search names.")
        return
    }
    o.query = take query
    o.found_note = String::from("Searching…")
}

fn clear_found(o: mut Online) {
    o.found = 0
    o.found_boards.clear()
}

/// The names a search found came, asked from the leaderboard of course `course`: their runs as
/// boards (numbered 0: a search knows no place), each fastest first, and the replays of the first
/// rows of `course`'s fetched.
fn came_names(o: mut Online, found: [Found], course: u32) {
    clear_found(mut o)
    o.found = found.len()
    for f in found {
        for st in f.standings {
            let row = Place {
                place: 0,
                name: f.name.clone(),
                ticks: st.ticks,
                run: st.run.clone(),
                replay: st.replay.clone(),
            }
            match board_of(o.found_boards, st.course, st.category) {
                Some(b) => o.found_boards[b].places.push(take row),
                None => o.found_boards.push(
                    Shown {
                        course: st.course,
                        category: st.category,
                        places: Vec::from([take row]),
                        total: 0,
                        at: o.time,
                        note: String::new(),
                    },
                ),
            }
        }
    }
    for b in 0..o.found_boards.len() {
        o.found_boards[b].places.sort_by(|x, y| x.ticks < y.ticks)
    }
    for category in [ANY, FULL] {
        let Some(b) = board_of(o.found_boards, course, category) else { continue }
        let shown = window(o.found_boards[b].places, 0, SEARCH)
        fetch_rows(mut o, shown)
    }
}

/// How many names the search found, and what to say of them.
pub fn found(o: Online) -> (u32, String) {
    (o.found, o.found_note.clone())
}

/// The runs the names found have on board (`course`, `category`), fastest first, as a board's
/// places (numbered 0: a search knows no place).
pub fn found_places(o: Online, course: u32, category: u32) -> Vec<Place> {
    match board_of(o.found_boards, course, category) {
        Some(b) => o.found_boards[b].places.clone(),
        None => Vec::new(),
    }
}

// ---- tests -------------------------------------------------------------------------------------

use replay::tool_assisted
use course::WETLANDS

const ME: Text = "Dame Puddlesnout the Damp"

fn signed_in() -> Online {
    var o = online()
    o.linked = true
    o.account = Account {
        signed_in: true,
        name: String::from(ME),
        token: Vec::from([3; 32]),
        may_post: true,
        posting_known: true,
    }
    o
}

/// A run of the player's on the first level, `ticks` long as far as the boards are told.
fn mine(ticks: u32) -> Replay {
    var r = tool_assisted(WETLANDS)[0].clone()
    r.who = YOU
    r.ticks = ticks
    r
}

/// A run of the player's that reads as one of this game's (`boards::read`), told apart by `n`.
fn real(n: u32) -> Replay {
    var r = tool_assisted(WETLANDS)[0].clone()
    r.who = YOU
    r.deaths = n
    r
}

/// A place on a board, its replay's hash made from its number.
fn place(n: u32, name: str, ticks: u32) -> Place {
    Place {
        place: n,
        name: String::from(name),
        ticks,
        run: RunRef { handle: Vec::filled(16, u8(n)), n },
        replay: Vec::filled(32, u8(n)),
    }
}

/// The asks waiting, the player's then the fetches.
fn all_asks(o: Online) -> Vec<Asked> {
    var out: Vec<Asked> = Vec::new()
    for (_, a) in o.asks {
        out.push(a.clone())
    }
    for (_, a) in o.fetches {
        out.push(a.clone())
    }
    out
}

/// Board (`WETLANDS`, any%) given as `places`, of `total`.
fn given(o: mut Online, places: Vec<Place>, total: u32) {
    want(mut o, WETLANDS, ANY, By::Player)
    var i = 0
    while i < o.asks.len() {
        var board = false
        if let Asked::Board { .. } = o.asks[i].1 {
            board = true
        }
        if board {
            let (_, asked) = o.asks.remove(i)
            answered(
                mut o,
                asked,
                Answer::Board { course: WETLANDS, category: ANY, places: places.clone(), total },
            )
            return
        }
        i += 1
    }
    panic("the board wasn't asked for")
}

@test
fn a_post_carries_the_games_token_and_its_answer_says_how_it_went() {
    var o = signed_in()
    let r = mine(991)
    post(mut o, r.clone())
    assert(o.asks.len() == 1 && status(o, fingerprint(r)) == String::from("Posting…"), "asked")
    let (ask, asked) = o.asks.remove(0)
    let Ask::Upload { token, board, replay } = ask else { panic("an upload") }
    assert(token == Vec::from([3; 32]) && replay == save(r), "the token and the replay")
    assert(board == BOARD, "this build's board")
    answered(
        mut o,
        asked.clone(),
        Answer::Verified {
            run: RunRef { handle: Vec::from([9; 16]), n: 9 },
            ticks: r.ticks,
            place: 2,
        },
    )
    assert(
        status(o, fingerprint(r)) == String::from("2nd in the world"),
        status(o, fingerprint(r)).as_str(),
    )
    // Once posted, it isn't again.
    post(mut o, r.clone())
    assert(o.asks.is_empty() && status(o, fingerprint(r)) == String::from("Posted"))
    assert(reminder(o).is_none(), "no codes to save, no reminder")
}

@test
fn after_a_post_the_recovery_codes_reminder_shows_until_its_seen() {
    var o = signed_in()
    o.account.save_codes = true
    assert(reminder(o).is_none(), "not before a post")
    post(mut o, mine(991))
    let (_, asked) = o.asks.remove(0)
    answered(mut o, asked, Answer::Verified { run: RunRef::none(), ticks: 991, place: 9 })
    assert(reminder(o) == Some(posting::SAVE_CODES), "after it")
    reminded(mut o)
    assert(reminder(o).is_none(), "once")
    // Saved meanwhile, it's not said.
    post(mut o, mine(990))
    let (_, asked) = o.asks.remove(0)
    o.account.save_codes = false
    answered(mut o, asked, Answer::Verified { run: RunRef::none(), ticks: 990, place: 8 })
    assert(reminder(o).is_none(), "saved")
}

@test
fn a_post_waits_on_the_players_consent_until_the_account_agrees() {
    var o = signed_in()
    o.account.may_post = false
    let r = mine(991)
    // Off the leaderboard (where the screen shows), a post by hand isn't asked about.
    post(mut o, r.clone())
    assert(o.consenting.is_none() && o.waiting.is_empty(), "not shown off the board")
    assert(status(o, fingerprint(r)) == String::from("Not posted"))
    browsing(mut o, on: true)
    post(mut o, r.clone())
    assert(o.asks.is_empty() && o.consenting.is_some(), "the screen first, nothing asked")
    consent(mut o, post: false, best_runs: true)
    assert(o.asks.is_empty() && status(o, fingerprint(r)) == String::from("Not posted"), "not now")
    post(mut o, r.clone())
    consent(mut o, post: true, best_runs: true)
    assert(o.asks.len() == 1 && o.consenting.is_none(), "one ask")
    let (ask, asked) = o.asks.remove(0)
    let Ask::Consent { version, best_runs } = ask else { panic("the choice, never the upload") }
    assert(version == posting::VERSION && best_runs, "what the player read and chose")
    answered(mut o, asked.clone(), Answer::Done)
    assert(o.asks.is_empty() && status(o, fingerprint(r)) == String::from("Not posted"), "refused")
    o.account.may_post = true
    o.account.post_best = true
    answered(mut o, asked, Answer::Done)
    assert(o.account.may_post && o.account.post_best, "agreed")
    let (ask, asked) = o.asks.remove(0)
    let Ask::Upload { .. } = ask else { panic("then the upload") }
    answered(mut o, asked, Answer::Verified { run: RunRef::none(), ticks: r.ticks, place: 3 })
    // Agreed, a post goes straight away.
    post(mut o, mine(992))
    let Ask::Upload { .. } = o.asks[0].0 else { panic("no screen again") }
    // Leaving the leaderboard with the screen up is Not now.
    var left = signed_in()
    left.account.may_post = false
    browsing(mut left, on: true)
    post(mut left, r.clone())
    browsing(mut left, on: false)
    assert(left.consenting.is_none() && left.asks.is_empty(), "gone with the board")
    assert(status(left, fingerprint(r)) == String::from("Not posted"))
}

@test
fn a_post_waits_while_what_the_account_chose_is_unknown_and_unknown_is_never_no() {
    var o = signed_in()
    o.account.may_post = false
    o.account.posting_known = false
    browsing(mut o, on: true)
    let r = mine(991)
    post(mut o, r.clone())
    assert(o.asks.is_empty() && o.consenting.is_none(), "neither asked nor refused")
    assert(o.waiting.len() == 1 && status(o, fingerprint(r)) == String::from("Posting…"))
    // Known, and agreed: it goes, with no screen.
    o.account.posting_known = true
    o.account.may_post = true
    pump(mut o)
    let Some((Ask::Upload { .. }, _)) = o.asks.pop() else { panic("posted once known") }
    // Known, and not agreed: the screen, on the board.
    var not = signed_in()
    not.account.may_post = false
    not.account.posting_known = false
    browsing(mut not, on: true)
    post(mut not, r.clone())
    not.account.posting_known = true
    pump(mut not)
    assert(not.consenting.is_some() && not.asks.is_empty(), "the screen once it's known")
}

@test
fn a_post_put_off_waits_longer_each_time_and_only_a_rejection_drops_it() {
    var o = signed_in()
    let r = mine(991)
    let hash = fingerprint(r)
    post(mut o, r.clone())
    let (_, asked) = o.asks.remove(0)
    let busy = Answer::Failed { why: String::from("Busy. Try again soon."), retry_after: 5 }
    answered(mut o, asked, busy.clone())
    assert(o.waiting.len() == 1 && o.waiting[0].wait.tries == 1, "kept, counted")
    assert(o.waits.storing.unsaved, "and stored, with its count")
    assert(o.waiting[0].at == AGAIN, "the first wait")
    o.time = AGAIN - 1.0
    pump(mut o)
    assert(o.asks.is_empty(), "not before it's due")
    o.time = AGAIN
    pump(mut o)
    let (_, asked) = o.asks.remove(0)
    answered(mut o, asked, busy)
    assert(o.waiting[0].wait.tries == 2 && o.waiting[0].at == AGAIN + 2.0 * AGAIN, "twice as long")
    // The console couldn't ask: tried again a while later, not counted against it.
    o.time = 3.0 * AGAIN
    pump(mut o)
    let (_, asked) = o.asks.remove(0)
    answered(mut o, asked, Answer::Offline { why: String::from("Can't reach the boards.") })
    assert(o.waiting[0].wait.tries == 2 && o.waiting[0].at == 4.0 * AGAIN, "as it was")
    // A closed tab keeps the count: read again, it waits as long as it last did.
    var again = signed_in()
    restore(mut again, Waiting { runs: Vec::from([o.waiting[0].wait.clone()]) })
    assert(again.waiting.len() == 1 && again.waiting[0].at == backoff(2), "kept waiting")
    assert(backoff(40) == LONGEST, "never longer than the longest")
    // Rejected for good: dropped.
    o.time = 4.0 * AGAIN
    pump(mut o)
    let (_, asked) = o.asks.remove(0)
    answered(mut o, asked, Answer::Rejected { why: String::from("That run broke a rule.") })
    assert(o.waiting.is_empty() && status(o, hash) == String::from("That run broke a rule."))
}

/// A run of the player's on the first level that counts for 100% too, `ticks` long.
fn mine_full(ticks: u32) -> Replay {
    var r = tool_assisted(WETLANDS)[1].clone()
    r.who = YOU
    r.ticks = ticks
    r
}

@test
fn a_best_run_waits_for_both_its_places_and_a_newcomers_first_post_goes() {
    var o = signed_in()
    o.account.post_best = true
    let r = mine_full(3600)
    assert(counts(r, FULL), "a 100% run")
    finished(mut o, r.clone())
    pump(mut o)
    var asked: Vec<u32> = Vec::new()
    for a in all_asks(o) {
        if let Asked::Around { category, .. } = a {
            asked.push(category)
        }
    }
    assert(asked == Vec::from([ANY, FULL]), "both its places asked")
    // No standing on either (the server's `Unplaced`): its first post.
    let (_, any) = o.fetches.remove(0)
    answered(mut o, any, Answer::Unplaced)
    pump(mut o)
    assert(o.asks.is_empty(), "not before its 100% place is known")
    let (_, full) = o.fetches.remove(0)
    answered(mut o, full, Answer::Unplaced)
    pump(mut o)
    let Some((Ask::Upload { replay, .. }, asked)) = o.asks.pop() else { panic("its first post") }
    assert(replay == save(r))
    answered(
        mut o,
        asked,
        Answer::Verified { run: RunRef::none(), ticks: 3590, place: 40 },
    )
    assert(known(o, WETLANDS, ANY) == Some(3590) && known(o, WETLANDS, FULL) == Some(3590))
    // A run slower on both boards than the account's places isn't posted.
    finished(mut o, mine_full(3595))
    assert(o.waiting.is_empty(), "beats neither")
    // One that beats the 100% place alone is.
    learn(mut o, WETLANDS, FULL, 3700)
    finished(mut o, mine_full(3650))
    pump(mut o)
    let Some((Ask::Upload { .. }, _)) = o.asks.pop() else { panic("a better 100%") }
}

@test
fn without_a_console_or_an_account_nothing_is_asked() {
    let r = mine(991)
    var alone = online()
    post(mut alone, r.clone())
    want(mut alone, WETLANDS, 0, By::Player)
    search(mut alone, WETLANDS, "Sir", "", "")
    assert(alone.asks.is_empty() && alone.fetches.is_empty(), "opened alone")
    assert(status(alone, fingerprint(r)).as_str().find("wrela.dev").is_some())
    var out = signed_in()
    out.account.signed_in = false
    post(mut out, r.clone())
    assert(out.asks.is_empty() && status(out, fingerprint(r)).as_str().find("Sign in").is_some())
}

@test
fn a_players_ask_needs_a_console_a_background_one_an_account_and_a_post_alone_its_setting() {
    // Who may ask, by the three rules: opened alone, linked signed out, signed in, posting alone.
    let state = |k: u32| {
        var o = if k < 2 { online() } else { signed_in() }
        o.linked = k > 0
        o.account.post_best = k == 3
        take o
    }
    let rules = [
        (By::Player, [false, true, true, true]),
        (By::Background, [false, false, true, true]),
        (By::Alone, [false, false, false, true]),
    ]
    for (by, allowed) in rules {
        for k in 0..4 {
            var o = state(k)
            let board = Ask::Board { course: WETLANDS, category: ANY, from: 0 }
            let asked = ask(
                mut o,
                take board,
                Asked::Board { course: WETLANDS, category: ANY, from: 0 },
                by,
            )
            assert(asked == allowed[k] && o.asks.len() == u32(asked), f"rule {k}")
        }
    }
    // Asked once: again while it waits, or while it's in flight, it isn't.
    var o = signed_in()
    want(mut o, WETLANDS, ANY, By::Player)
    o.boards.clear()
    want(mut o, WETLANDS, ANY, By::Background)
    assert(o.asks.len() == 1, "waiting")
    let (_, flying) = o.asks.remove(0)
    o.flying = Some(take flying)
    o.boards.clear()
    want(mut o, WETLANDS, ANY, By::Player)
    assert(o.asks.is_empty(), "in flight")
    // A replay fetched behind, then wanted now, is asked once, first: by the run of the place
    // shown with it.
    let hash = Vec::filled(32, u8(9))
    let row = place(9, "Sir Wobblesnout the Unhurried", 900)
    o.boards.push(
        Shown {
            course: WETLANDS,
            category: ANY,
            places: Vec::from([take row]),
            total: 1,
            at: o.time,
            note: String::new(),
        },
    )
    fetch(mut o, hash.clone())
    fetch(mut o, hash.clone())
    assert(o.fetches.len() == 1, "behind, once")
    fetch_now(mut o, hash.clone())
    assert(o.fetches.is_empty() && o.asks.len() == 1, "brought forward")
    fetch_now(mut o, hash)
    assert(o.asks.len() == 1, "not twice")
}

@test
fn a_better_run_waits_and_posts_and_a_worse_one_doesnt() {
    var o = signed_in()
    o.account.post_best = true
    given(mut o, Vec::from([place(1, "Sir Wobblesnout the Unhurried", 900), place(2, ME, 960)]), 2)
    o.fetches.clear()
    finished(mut o, mine(990))
    assert(o.waiting.is_empty(), "slower than the account's place")
    pump(mut o)
    assert(o.asks.is_empty(), "nothing posted")
    let better = mine(930)
    finished(mut o, better.clone())
    assert(o.waiting.len() == 1 && status(o, fingerprint(better)) == String::from("Posting…"))
    pump(mut o)
    assert(o.asks.len() == 1, "and posts")
    let (ask, asked) = o.asks.remove(0)
    let Ask::Upload { replay, .. } = ask else { panic("an upload") }
    assert(replay == save(better))
    pump(mut o)
    assert(o.asks.is_empty(), "one at a time")
    answered(
        mut o,
        asked,
        Answer::Verified { run: RunRef { handle: Vec::from([7; 16]), n: 7 }, ticks: 930, place: 2 },
    )
    assert(o.waiting.is_empty() && known(o, WETLANDS, ANY) == Some(930), "posted, the place known")
    // With the setting off, a finished run doesn't wait.
    o.account.post_best = false
    finished(mut o, mine(800))
    assert(o.waiting.is_empty(), "the setting off")
}

@test
fn runs_made_offline_wait_and_post_when_the_console_links() {
    var o = online()
    finished(mut o, mine(990))
    finished(mut o, mine(995))
    assert(o.waiting.len() == 1 && o.waiting[0].wait.run.ticks == 990, "the faster waits, stored")
    assert(
        o.waits.storing.unsaved && o.asks.is_empty() && o.fetches.is_empty(),
        "nothing asked offline",
    )
    pump(mut o)
    assert(o.asks.is_empty() && o.fetches.is_empty(), "not linked")
    // Linked, the setting on: the account's place first, then the post.
    o.linked = true
    o.account = Account {
        signed_in: true,
        name: String::from(ME),
        token: Vec::from([3; 32]),
        may_post: true,
        post_best: true,
        posting_known: true,
    }
    pump(mut o)
    assert(o.asks.is_empty() && o.fetches.len() == 1, "its place asked")
    let (ask, asked) = o.fetches.remove(0)
    let Ask::Around { name, .. } = ask else { panic("the slice around the account") }
    assert(name == String::from(ME))
    // The account has no place on that board yet (the server's `Unplaced`).
    answered(mut o, asked, Answer::Unplaced)
    pump(mut o)
    let Some((Ask::Upload { replay, .. }, _)) = o.asks.pop() else { panic("posted") }
    assert(replay == save(mine(990)))
    // One that turns out slower than the account's place, once it's known, isn't posted.
    var slower = online()
    finished(mut slower, mine(990))
    slower.linked = true
    slower.account = o.account.clone()
    pump(mut slower)
    let (_, asked) = slower.fetches.remove(0)
    let at = Vec::from([place(4, ME, 950)])
    answered(
        mut slower,
        asked,
        Answer::Around { places: at, at: 4 },
    )
    pump(mut slower)
    assert(slower.asks.is_empty() && slower.waiting.is_empty(), "the account's place is faster")
}

@test
fn a_boards_rows_fetch_their_replays_and_the_three_above_the_players_and_no_more_are_held() {
    var o = signed_in()
    var rows: Vec<Place> = Vec::new()
    for n in 1..14 {
        rows.push(place(n, if n == 13 { ME } else { "Sir Wobblesnout the Unhurried" }, 900 + n))
    }
    given(mut o, rows, 13)
    var fetched: Vec<u32> = Vec::new()
    for a in all_asks(o) {
        if let Asked::Replay { hash } = a {
            fetched.push(u32(hash[0]))
        }
    }
    // Every row shown, and places 10, 11 and 12, above the player's thirteenth.
    assert(fetched == Vec::from([1, 2, 3, 4, 5, 6, 7, 8, 10, 11, 12]), f"{fetched.len()} fetched")
    assert(window(o.boards[0].places, 0, WORLD).len() == SHOWN && SHOWN == 8, "the rows shown")
    // Every row shown of both categories of the world's board and of its search, the places above,
    // the ghost's and a race's are held at once.
    assert(HELD >= 2 * shown_rows(WORLD) + 2 * shown_rows(SEARCH) + ABOVE + 2, "held at once")
    for (_, a) in o.asks {
        if let Asked::Replay { .. } = a {
            panic("fetches wait behind the player's asks")
        }
    }
    // Held to a bound, the least recently used dropped first.
    for n in 0..HELD + 4 {
        let bytes = save(real(n))
        came(mut o, Vec::from(sha256(bytes)), bytes)
    }
    assert(o.held.len() == HELD, "bounded")
    assert(!is_held(o, fingerprint(real(0))) && !is_held(o, fingerprint(real(3))))
    assert(is_held(o, fingerprint(real(4))), "the newest kept")
    // A replay whose bytes aren't the hash's run isn't held.
    let bytes = save(real(1))
    came(mut o, Vec::filled(32, u8(7)), bytes)
    assert(held(o, Vec::filled(32, u8(7))).is_none(), "not the run's own")
}

/// Replay `real(n)` come.
fn came_run(o: mut Online, n: u32) {
    let bytes = save(real(n))
    came(mut o, Vec::from(sha256(bytes)), bytes)
}

@test
fn the_least_recently_used_replay_goes_first_and_the_ghosts_and_the_races_never() {
    var o = signed_in()
    let hash = |n: u32| fingerprint(real(n))
    for n in 0..HELD {
        came_run(mut o, n)
    }
    // The ghost's and the race's pinned, the third used again: the fourth is the least recently
    // used of the rest.
    pin(mut o, hash(0), hash(1))
    fetch_now(mut o, hash(2))
    assert(o.asks.is_empty() && o.fetches.is_empty(), "held: nothing asked")
    came_run(mut o, HELD)
    assert(o.held.len() == HELD, "bounded")
    assert(is_held(o, hash(0)) && is_held(o, hash(1)), "pinned")
    assert(is_held(o, hash(2)), "used again")
    assert(!is_held(o, hash(3)), "the least recently used")
    for n in HELD + 1..HELD * 2 {
        came_run(mut o, n)
    }
    assert(is_held(o, hash(0)) && is_held(o, hash(1)) && !is_held(o, hash(2)), "still pinned")
    // Unpinned, the ghost's goes in its turn.
    pin(mut o, Vec::new(), Vec::new())
    came_run(mut o, HELD * 2)
    assert(!is_held(o, hash(0)) && is_held(o, hash(1)), "the oldest first")
}

@test
fn a_held_row_plays_at_once_and_another_is_fetched_first() {
    var o = signed_in()
    let bytes = save(real(0))
    let hash = Vec::from(sha256(bytes))
    var row = place(3, "Sir Wobblesnout the Unhurried", 950)
    row.replay = hash.clone()
    // Fetched by its run, which a board shown gives with it.
    fetch(mut o, hash.clone())
    assert(o.fetches.is_empty(), "no run known for it yet")
    given(mut o, Vec::from([row.clone()]), 1)
    fetch(mut o, hash.clone())
    assert(o.fetches.len() == 1, "fetched behind")
    let Ask::Watch { run } = o.fetches[0].0.clone() else { panic("by its run") }
    assert(run == row.run, "the place's run")
    watch_place(mut o, row.clone())
    assert(take_watch(mut o).is_none() && o.fetches.is_empty() && o.asks.len() == 1, "asked first")
    let (_, asked) = o.asks.remove(0)
    answered(mut o, asked, Answer::Run { run: row.run.clone(), replay: bytes.clone() })
    let Some((_, name, at)) = take_watch(mut o) else { panic("watched when it came") }
    assert(name == String::from("Sir Wobblesnout the Unhurried") && at == 3)
    watch_place(mut o, row)
    assert(take_watch(mut o).is_some() && o.asks.is_empty(), "held: at once, nothing asked")
}

@test
fn the_world_ghosts_are_the_record_and_the_place_above_the_players() {
    var o = signed_in()
    assert(
        ghost_hash(o, WETLANDS, record: true).is_none(),
        "no board yet",
    )
    given(
        mut o,
        Vec::from(
            [
                place(1, "Sir Wobblesnout the Unhurried", 900),
                place(2, "Lord Snufflepaw the Plucky", 920),
                place(3, ME, 960),
            ],
        ),
        3,
    )
    assert(my_place(o, WETLANDS, ANY) == 3)
    assert(
        ghost_hash(o, WETLANDS, record: true) == Some(Vec::filled(32, u8(1))),
        "the record",
    )
    assert(
        ghost_hash(o, WETLANDS, record: false) == Some(Vec::filled(32, u8(2))),
        "the run above",
    )
    let Some((name, at)) = whose(o, WETLANDS, Vec::filled(32, u8(2))) else { panic("whose") }
    assert(at == 2 && name.as_str().starts_with("Lord"))
    o.account.name = String::from("Sir Wobblesnout the Unhurried")
    assert(
        ghost_hash(o, WETLANDS, record: false) == Some(Vec::filled(32, u8(1))),
        "first: the record",
    )
    o.account.name = String::from("Count Muddlenose the Serene")
    assert(
        ghost_hash(o, WETLANDS, record: false).is_none(),
        "no place, no run above",
    )
}

@test
fn a_search_asks_once_for_its_parts_and_lists_their_runs_on_the_level() {
    var o = signed_in()
    search(mut o, WETLANDS, "Sir", "wob", "")
    search(mut o, WETLANDS, "Sir", "wob", "")
    assert(o.asks.len() == 1, "once")
    search(mut o, WETLANDS, "Sir", "wobble", "")
    assert(o.asks.len() == 1, "the newer in its place")
    let (ask, asked) = o.asks.remove(0)
    let Ask::Names { noun, .. } = ask else { panic("names") }
    assert(noun == String::from("wobble"))
    let standing = platform::wire::Standing {
        course: WETLANDS,
        category: ANY,
        ticks: 900,
        run: RunRef { handle: Vec::filled(16, u8(4)), n: 4 },
        replay: Vec::filled(32, u8(4)),
    }
    let sir = Found {
        name: String::from("Sir Wobblesnout the Unhurried"),
        standings: Vec::from([take standing]),
    }
    answered(mut o, asked, Answer::Names { found: Vec::from([take sir]) })
    let rows = found_places(o, WETLANDS, ANY)
    assert(
        rows.len() == 1 && rows[0].ticks == 900 && found_places(o, WETLANDS, FULL).is_empty(),
    )
    let (names, note) = found(o)
    assert(names == 1 && note.is_empty())
    // The first rows' replays fetched as the names came, for the level searched from.
    var fetched = false
    for a in all_asks(o) {
        if let Asked::Replay { hash } = a {
            fetched = hash == Vec::filled(32, u8(4))
        }
    }
    assert(fetched, "its run's replay fetched ahead")
    // Every result shown is fetched ahead: the rows under the search's line.
    var many: Vec<Found> = Vec::new()
    for n in 0..12 {
        let standing = platform::wire::Standing {
            course: WETLANDS,
            category: ANY,
            ticks: 900 + n,
            run: RunRef { handle: Vec::filled(16, u8(40 + n)), n: 40 + n },
            replay: Vec::filled(32, u8(40 + n)),
        }
        many.push(
            Found { name: f"Sir Wobble{n} the Unhurried", standings: Vec::from([take standing]) },
        )
    }
    var wide = signed_in()
    came_names(mut wide, many, WETLANDS)
    assert(wide.fetches.len() == shown_rows(SEARCH) && shown_rows(SEARCH) == 7, "the rows shown")
    assert(
        ordinal(1) == String::from("1st") &&
            ordinal(12) == String::from("12th") &&
            ordinal(23) == String::from("23rd"),
    )
}

@test
fn the_leaderboard_opens_at_the_players_place_and_pages_on_past_the_rows_shown() {
    var o = signed_in()
    var top: Vec<Place> = Vec::new()
    for n in 1..21 {
        top.push(place(n, "Sir Wobblesnout the Unhurried", 900 + n))
    }
    given(mut o, top, 50)
    // Not on the first page: the slice round the account's place is asked.
    var slice_asked = false
    for a in all_asks(o) {
        if let Asked::Around { .. } = a {
            slice_asked = true
        }
    }
    assert(slice_asked && !placed(o, WETLANDS, ANY), "its place asked")
    var around: Vec<Place> = Vec::new()
    for n in 30..41 {
        around.push(place(n, if n == 35 { ME } else { "Lord Snufflepaw the Plucky" }, 900 + n))
    }
    o.fetches.retain(
        |f| match f.1 {
            Asked::Around { .. } => false,
            _ => true,
        },
    )
    answered(
        mut o,
        Asked::Around { course: WETLANDS, category: ANY },
        Answer::Around { places: around, at: 35 },
    )
    assert(placed(o, WETLANDS, ANY) && my_place(o, WETLANDS, ANY) == 35)
    let shown = slice(o, WETLANDS, ANY)
    let Some((first, mine)) = anchor(shown, ME, WORLD) else { panic("the account's row") }
    assert(first == 2 && mine == 5, "the three above it over it")
    let rows = window(shown, first, WORLD)
    assert(rows.len() == SHOWN && rows[mine - first].name == String::from(ME), "shown")
    // Near the top or the bottom, it starts or ends the rows shown.
    let near_top = anchor(top_of(n: 10, from: 1), "Count 2", WORLD)
    assert(near_top == Some((0, 1)), "near the top")
    let near_end = anchor(top_of(n: 20, from: 1), "Count 19", WORLD)
    assert(near_end == Some((12, 18)), "near the end")
    assert(anchor(shown, "Nobody", WORLD).is_none())
    // From the top, the next page is asked once the rows run out, and it follows the first.
    more(mut o, WETLANDS, ANY)
    more(mut o, WETLANDS, ANY)
    var pages: Vec<u32> = Vec::new()
    for a in all_asks(o) {
        if let Asked::Board { from, .. } = a {
            pages.push(from)
        }
    }
    assert(pages == Vec::from([20]), "once, from the 21st")
    let (_, asked) = o.asks.remove(0)
    answered(
        mut o,
        asked,
        Answer::Board {
            course: WETLANDS,
            category: ANY,
            places: top_of(n: 20, from: 21),
            total: 50,
        },
    )
    let (all, _) = places(o, WETLANDS, ANY)
    assert(all.len() == 40 && all[20].place == 21, "after the first")
    // A page that no longer follows (the board came again meanwhile) isn't put after it.
    answered(
        mut o,
        Asked::Board { course: WETLANDS, category: ANY, from: 20 },
        Answer::Board {
            course: WETLANDS,
            category: ANY,
            places: top_of(n: 20, from: 21),
            total: 50,
        },
    )
    let (all, _) = places(o, WETLANDS, ANY)
    assert(all.len() == 40, "not twice")
}

/// `n` places from place `from`, each named "Count <place>".
fn top_of(n: u32, from: u32) -> Vec<Place> {
    var out: Vec<Place> = Vec::new()
    for k in from..from + n {
        out.push(place(k % 256, f"Count {k}", 900 + k))
        out[out.len() - 1].place = k
    }
    out
}

@test
fn past_the_first_thousand_the_run_above_is_the_one_above_in_the_slice() {
    var o = signed_in()
    // The slice past the first thousand numbers none.
    var around: Vec<Place> = Vec::new()
    for k in 0..11 {
        var p = place(60 + k, if k == 5 { ME } else { "Lord Snufflepaw the Plucky" }, 5000 + k)
        p.place = 0
        around.push(take p)
    }
    answered(
        mut o,
        Asked::Around { course: WETLANDS, category: ANY },
        Answer::Around { places: around, at: 0 },
    )
    assert(my_place(o, WETLANDS, ANY) == 0 && placed(o, WETLANDS, ANY), "a place, unnumbered")
    assert(
        ghost_hash(o, WETLANDS, record: false) == Some(Vec::filled(32, u8(64))),
        "the run just above, by where it is",
    )
    assert(ghost_hash(o, WETLANDS, record: true).is_none(), "the record isn't in the slice")
    // Its replays, of the three above it, fetched ahead.
    var fetched: Vec<u32> = Vec::new()
    for a in all_asks(o) {
        if let Asked::Replay { hash } = a {
            fetched.push(u32(hash[0]))
        }
    }
    assert(fetched == Vec::from([62, 63, 64]), f"{fetched.len()} fetched")
}
