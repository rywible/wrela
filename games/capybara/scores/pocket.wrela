/// A piano audition with a two-bar hook, an answer, a quieter bridge and a final return.
pub const SCORE: Score = score("04 - Pocket", meter(beats: 4, unit: 4))
    .with_tempo("Straight eighths, with a light backbeat")
    .then(HOOK)
    .then(ANSWER)
    .then(BRIDGE)
    .then(RETURN)

/// Quarter notes per minute; 32 bars take about 66.2 seconds before the release tail.
pub const TEMPO: f32 = 116.0
