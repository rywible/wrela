/// Forty bars with a central riff, a half-time break and a final tonic release.
pub const SCORE: Score = score("03 - Sprint", meter(beats: 4, unit: 4))
    .with_tempo("Quick, clipped and buoyant")
    .then(HOOK)
    .then(DEVELOPMENT)
    .then(HALF_TIME)
    .then(RETURN)
    .then(FINISH)

/// Quarter notes per minute; the written score is sixty seconds long.
pub const TEMPO: f32 = 160.0
