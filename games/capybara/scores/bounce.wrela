        ],
    )
    .voice(
        "harmony",
        [
            "r/4 <g3 b3 e4> !staccato r <g3 b3 e4> !staccato |",
            "r/4 <a3 d#4 f#4> !staccato r <a3 d#4 f#4> !staccato |",
