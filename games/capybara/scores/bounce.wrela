            "a2/4 !staccato e3/4 !staccato g3/8 !staccato e3 !staccato c#3/4 !staccato |",
            "d3/2 !tenuto r/2 |",
        ],
    )

/// Thirty-two bars: the hook, its answer, a contrasting middle and a changed return.
pub const SCORE: Score = score("01 - Bounce", meter(beats: 4, unit: 4))
    .with_tempo("Bright and springy")
    .then(HOOK)
    .then(ANSWER)
    .then(BRIDGE)
    .then(RETURN)

/// Quarter notes per minute; the written bars span about 58.2 seconds.
pub const TEMPO: f32 = 132.0
