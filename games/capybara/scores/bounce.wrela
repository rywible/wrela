    .voice(
        "bass",
        [
            "d3/4 !staccato a2/8 !staccato r d3/4 !staccato f#3/8 !staccato a2 !staccato |",
            "b2/4 !staccato f#2/8 !staccato r b2/4 !staccato d3/8 !staccato f#2 !staccato |",
            "e3/4 !staccato b2/8 !staccato r e3/4 !staccato g3/8 !staccato b2 !staccato |",
            "a2/4 !staccato e3/8 !staccato r a2/4 !staccato c#3/8 !staccato e3 !staccato |",
