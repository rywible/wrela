            "a2/4 !staccato e3/8 !staccato r a2/4 !staccato b2/8 !staccato c#3 !staccato |",
            "d3/4 !staccato a2/8 !staccato r d3/4 !staccato f#3/8 !staccato a2 !staccato |",
            "b2/4 !staccato f#2/8 !staccato r b2/4 !staccato d3/8 !staccato f#2 !staccato |",
            "g2/4 !staccato d3/8 !staccato r g2/4 !staccato b2/8 !staccato d3 !staccato |",
            "a2/4 !staccato e3/8 !staccato r a2/4 !staccato b2/8 !staccato c#3 !staccato |",
        ],
    )

const ANSWER = score("the hook opens out", meter(beats: 4, unit: 4))
