            "r/4 <g3 c#4 e4> !staccato r <g3 c#4 e4> !staccato |",
            "r/4 <a3 d4 f#4> !staccato r <a3 d4 f#4> !staccato |",
            "r/4 <b3 d4 f#4> !staccato r <b3 d4 f#4> !staccato |",
            "r/8 <a3 c#4 e4> !staccato r <a3 c#4 e4> !staccato r <a3 c#4 e4> !staccato r/4 |",
        ],
    )
    .voice(
        "bass",
        [
            "e3/4 !staccato b2 !staccato e3 !staccato g3 !staccato |",
            "b2/4 !staccato f#2 !staccato b2 !staccato d#3 !staccato |",
            "e3/4 !staccato b2 !staccato e3 !staccato g3 !staccato |",
            "c3/4 !staccato g2 !staccato c3 !staccato e3 !staccato |",
