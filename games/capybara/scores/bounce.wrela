const RETURN = score("the hook returns", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "d5/8 !f !accent a4 d5/4 f#5/8 e5 d5/4 | b4/8 d5 b4/4 a4/8 f#4 a4/4 |",
            "g4/8 b4 e5/4 g5/8 f#5 e5/4 | a4/8 c#5 e5/4 a5/8 g5 e5/4 |",
            "d5/8 !accent a4 d5/4 f#5/8 e5 d5/4 | b4/8 d5 f#5/4 e5/8 d5 b4/4 |",
            "g5/8 f#5 e5 d5 c#5 e5 a5/4 | d5/2 !mf !tenuto r/2 |",
        ],
    )
    .voice(
        "harmony",
        [
            "r/8 <a3 d4 f#4> !staccato r <a3 d4 f#4> !staccato r <a3 d4 f#4> !staccato r <a3 d4 f#4> !staccato |",
