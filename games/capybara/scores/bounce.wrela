// "01 - Bounce": a brisk piano tune built round a leaping two-bar hook. Short offbeat
// chords and a root-and-fifth bass keep the pulse clear. The middle turns to E minor;
// the hook returns brighter, then lands on a clean D-major ending. No sustain pedal.

use engine::score::{Score, meter, score}

const HOOK = score("the hook", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "d5/8 !mf !accent a4 d5/4 f#5/8 e5 d5/4 | b4/8 d5 b4/4 a4/8 f#4 a4/4 |",
            "g4/8 b4 e5/4 d5/8 b4 g4/4 | a4/8 c#5 e5/4 d5/8 c#5 a4/4 |",
            "d5/8 !accent a4 d5/4 f#5/8 e5 d5/4 | b4/8 d5 f#5/4 e5/8 d5 b4/4 |",
            "g5/4 f#5/8 e5 d5/4 b4/8 g4 | a4/8 c#5 e5 g5 f#5/4 e5/8 c#5 |",
        ],
    )
    .voice(
        "harmony",
