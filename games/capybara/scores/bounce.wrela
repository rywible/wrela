const BRIDGE = score("a lighter step", meter(beats: 4, unit: 4))
    .voice(
        "melody",
        [
            "e5/4 !mp g5/8 f#5 e5/4 b4/4 | d#5/4 f#5/8 e5 d#5/4 b4/8 a4 |",
            "e5/4 g5/8 b5 a5/4 g5/8 e5 | e5/8 d5 c5/4 g4/8 c5 e5/4 |",
            "c#5/8 e5 a5/4 g5/8 e5 c#5/4 | d5/8 f#5 a5/4 f#5/8 e5 d5/4 |",
