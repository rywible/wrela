/// Where each move is first needed (m): how far a search gets with it forbidden (the run and jump,
/// the double jump, a splash, the slide, swimming; 1e9 for one never needed). `wrela tool route --
/// --level farm --needs` measures them.
pub const NEEDS: [f32; 5] = [1.0e9, 1.0e9, 178.04, 336.61, 178.04]

@test
fn the_searched_runs_of_farm_finish_in_their_times_without_a_death() {
    let every = course(FARM).every_snack()
    let any = play(FARM, ANY)
    let full = play(FARM, FULL)
    assert(any.finished == 1573 && any.deaths == 0, "the any% run's time moved")
    assert(full.finished == 3389 && full.deaths == 0 && full.snacks == every)
    let human_any = play(FARM, HUMAN_ANY)
    let human_full = play(FARM, HUMAN_FULL)
    assert(human_any.finished == 1863 && human_any.deaths == 0)
    assert(human_full.finished == 3541 && human_full.deaths == 0)
    assert(human_full.snacks == every)
}
