// The game's sound, synthesized as it plays: the open sea under everything (noise, filtered low,
// breathing with the swells), the rush of the board on the water as loud as it's fast, and a
// sound for each moment the frames send: a swell rising, a launch, a splash as hard as the
// landing, a chime for a clean one, a wipeout's bonk and the shell clattering, and the start's
// and the finish's notes, struck like a marimba.
use std::audio::{QUANTUM, RingReader, RingWriter, SAMPLE_RATE, play, ring}

// What the frames send, in a cue's low byte; LAND and RUSH carry a level in the next (0 to 255).
pub const RAISE: u32 = 1
pub const LAUNCH: u32 = 2
pub const LAND: u32 = 3
pub const CLEAN: u32 = 4
pub const WIPEOUT: u32 = 5
pub const REFUSED: u32 = 6
pub const START: u32 = 7
pub const FINISH: u32 = 8
pub const RUSH: u32 = 9

const TONES: u32 = 16
const SINE: u32 = 0
const TRIANGLE: u32 = 1
// Noise through a low-pass whose cutoff slides like a tone's pitch.
const NOISE: u32 = 2

struct Tone: Copy {
    // From `from` to `to` (hertz: the pitch, or the noise's cutoff) over `length` seconds,
    // starting `age` seconds ago (negative: not yet); `decay` shapes its fade (1 linear, more
    // sooner).
    from: f32,
    to: f32,
    length: f32,
    age: f32,
    wave: u32,
    gain: f32,
    decay: f32,
    phase: f32,
    low: f32,
}

fn silent() -> Tone {
    Tone {
        from: 1.0,
        to: 1.0,
        length: 0.0,
        age: 1.0,
        wave: 0,
        gain: 0.0,
        decay: 1.0,
        phase: 0.0,
        low: 0.0,
    }
}

pub struct Voice {
    events: RingReader<u32>,
    tones: [Tone; TONES],
    next: u32,
    noise: u32,
    // The sea's two low noises (left, right), its breath's phase, the rush's level and target,
    // and its filter.
    bed: vec2,
    breath: f32,
    rush: f32,
    rush_target: f32,
    hiss: f32,
}

// Starts the game's voice: the writer is how the frames send it cues.
pub fn start() -> RingWriter<u32> {
    let (writer, reader) = ring::<u32>(128)
    let voice = Voice {
        events: reader,
        tones: [silent(); TONES],
        next: 0,
        noise: 0x6d2b79f5,
        bed: vec2(0.0),
        breath: 0.0,
        rush: 0.0,
        rush_target: 0.0,
        hiss: 0.0,
    }
    play(take voice, render)
    writer
}

@audio
fn note(midi: f32) -> f32 {
    440.0 * pow(2.0, (midi - 69.0) / 12.0)
}

@audio
fn white(v: mut Voice) -> f32 {
    v.noise = v.noise.wrapping_mul(1664525).wrapping_add(1013904223)
    f32(v.noise >> 9) / 4194304.0 - 1.0
}

@audio
fn tone(
    v: mut Voice,
    from: f32,
    to: f32,
    length: f32,
    wave: u32,
    gain: f32,
    decay: f32 = 1.5,
    delay: f32 = 0.0,
) {
    let i = v.next
    v.next = (v.next + 1) % TONES
    v.tones[i] = Tone { from, to, length, age: -delay, wave, gain, decay, phase: 0.0, low: 0.0 }
}

// A marimba-ish note: a sine and its fourth partial, struck and quick to fade.
@audio
fn strike(v: mut Voice, midi: f32, gain: f32, delay: f32) {
    let f = note(midi)
    tone(mut v, from: f, to: f, length: 0.9, wave: SINE, gain: gain, decay: 4.0, delay: delay)
    tone(
        mut v,
        from: f * 4.0,
        to: f * 4.0,
        length: 0.15,
        wave: SINE,
        gain: gain * 0.3,
        decay: 3.0,
        delay: delay,
    )
}

@audio
fn cue(v: mut Voice, c: u32) {
    let kind = c & 255
    let level = f32((c >> 8) & 255) / 255.0
    if kind == RUSH { v.rush_target = level }
    if kind == RAISE {
        tone(mut v, from: 180.0, to: 900.0, length: 0.7, wave: NOISE, gain: 0.35, decay: 1.2)
        tone(mut v, from: 55.0, to: 82.0, length: 0.6, wave: SINE, gain: 0.25, decay: 1.5)
    }
    if kind == LAUNCH {
        tone(mut v, from: 600.0, to: 4000.0, length: 0.35, wave: NOISE, gain: 0.3, decay: 1.5)
        tone(mut v, from: 260.0, to: 520.0, length: 0.12, wave: TRIANGLE, gain: 0.18, decay: 2.0)
    }
    if kind == LAND {
        tone(
            mut v,
            from: 3000.0 + level * 3000.0,
            to: 400.0,
            length: 0.35 + level * 0.4,
            wave: NOISE,
            gain: 0.25 + level * 0.4,
            decay: 2.5,
        )
        tone(
            mut v,
            from: 90.0,
            to: 50.0,
            length: 0.18,
            wave: SINE,
            gain: 0.15 + level * 0.3,
            decay: 2.0,
        )
    }
    if kind == CLEAN {
        strike(mut v, midi: 81.0, gain: 0.16, delay: 0.0)
        strike(mut v, midi: 88.0, gain: 0.14, delay: 0.07)
    }
    if kind == WIPEOUT {
        tone(mut v, from: 230.0, to: 80.0, length: 0.35, wave: TRIANGLE, gain: 0.4, decay: 1.5)
        for k in 0..3 {
            tone(
                mut v,
                from: 2500.0,
                to: 1200.0,
                length: 0.05,
                wave: NOISE,
                gain: 0.25,
                decay: 2.0,
                delay: 0.08 + f32(k) * 0.11,
            )
        }
        tone(
            mut v,
            from: 5000.0,
            to: 300.0,
            length: 0.9,
            wave: NOISE,
            gain: 0.45,
            decay: 2.0,
            delay: 0.25,
        )
    }
    if kind == REFUSED {
        tone(mut v, from: 320.0, to: 260.0, length: 0.08, wave: TRIANGLE, gain: 0.1)
    }
    if kind == START {
        for k in 0..3 { strike(mut v, [69.0, 73.0, 76.0][k], 0.14, f32(k) * 0.09) }
    }
    if kind == FINISH {
        for k in 0..6 {
            strike(mut v, [69.0, 73.0, 76.0, 81.0, 76.0, 81.0][k], 0.16, f32(k) * 0.11)
        }
        strike(mut v, midi: 85.0, gain: 0.18, delay: 0.72)
    }
}

@audio
fn render(v: mut Voice, left: mut [f32], right: mut [f32]) {
    var more = true
    while more {
        match v.events.pop() {
            Some(c) => cue(mut v, c),
            None => more = false,
        }
    }
    let dt = 1.0 / f32(SAMPLE_RATE)
    for i in 0..QUANTUM {
        // The sea: brownish noise each side, breathing over about eight seconds.
        v.breath = fract(v.breath + dt / 7.8)
        let swell = 0.55 + 0.45 * sin(v.breath * 6.2831853)
        let a = white(mut v)
        let b = white(mut v)
        v.bed = v.bed * 0.9985 + vec2(a, b) * 0.02
        let sea = v.bed * (0.35 + 0.4 * swell)
        // The rush: brighter noise, as loud as the board is fast.
        v.rush += (v.rush_target - v.rush) * 0.0004
        let w = white(mut v)
        v.hiss += (w - v.hiss) * 0.25
        let rush = (w - v.hiss) * v.rush * 0.18
        var out = 0.0
        for k in 0..TONES {
            var t = v.tones[k]
            t.age += dt
            if t.age < 0.0 || t.age > t.length {
                v.tones[k] = t
                continue
            }
            let f = t.from * pow(t.to / t.from, t.age / t.length)
            var s = 0.0
            if t.wave == SINE {
                t.phase = fract(t.phase + f * dt)
                s = sin(t.phase * 6.2831853)
            } else if t.wave == TRIANGLE {
                t.phase = fract(t.phase + f * dt)
                s = 1.0 - 4.0 * abs(t.phase - 0.5)
            } else {
                // One-pole low-pass at the slid cutoff.
                let k = 1.0 - exp(-6.2831853 * f * dt)
                t.low += (white(mut v) - t.low) * k
                s = t.low
            }
            let attack = saturate(t.age / 0.004)
            let fade = pow(1.0 - t.age / t.length, t.decay)
            out += s * t.gain * attack * fade
            v.tones[k] = t
        }
        // A soft limit, so stacked sounds never clip.
        let l = out + sea.x + rush
        let r = out + sea.y + rush
        left[i] = l / (1.0 + abs(l))
        right[i] = r / (1.0 + abs(r))
    }
}
