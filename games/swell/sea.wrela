// The sea: one height over x and time, the same function for the sim (where the rider stands,
// its slope, how fast the water under it rises) and for the shader (where the water is drawn,
// and which way its surface faces). Its height is the open sea's swell, the rolling hills of
// the fixed course, and the swells the player raises.
use std::derive::value_and_gradient

/// How many swells can stand at once.
pub const SLOTS: u32 = 3

/// The open sea's swell, its hills and the player's swells, at sim time `time`. A swell is
/// `vec4(centre, half width, height, rate)`, and it travels at `drift[i]`: from `time`, its centre
/// moves at that speed and its height changes at `rate` a second.
/// `calm` scales the open sea's swell (0 for a flat sea in tests); `hills` is 1 on the fixed
/// course.
pub struct Sea: Copy + GpuData {
    pub swells: [vec4; SLOTS],
    pub drift: vec4,
    pub time: f32,
    pub calm: f32,
    pub hills: f32,
}

/// The fixed course's hills: one standing in the middle of each stretch of `SPACING`, of these
/// heights, each `HILL_WIDTH` either side of its middle, so neighbours roll into each other.
/// The rocks (course.wrela) stand in the troughs, 4.5 past the crest of a tall hill. The heights
/// and widths are a search's: the fewest wipeouts for the test bots on both courses.
pub const SPACING: f32 = 9.0
pub const HILL_WIDTH: f32 = 4.8
pub const HILLS: [f32; 30] = [
    0.0, 1.4, 1.8, 1.4, 2.4, 0.0, 1.4, 1.8, 1.4, 2.4, 0.0, 1.4, 1.8, 1.4, 2.4, 0.0, 1.4, 1.8, 1.4,
    2.4, 0.0, 1.4, 1.8, 1.4, 2.4, 0.0, 1.0, 0.8, 0.5, 0.0,
]

/// A smooth bump: 1 at its middle, 0 from `u = ±1` out, with no kink there (its slope and
/// curvature are 0 at its feet).
pub fn bump(u: f32) -> f32 {
    let k = max(1.0 - u * u, 0.0)
    k * k * k
}

/// The open sea's swell: three long waves running, low.
fn open(x: f32, t: f32) -> f32 {
    0.11 * sin(x * 0.55 - t * 1.1) +
        0.07 * sin(x * 1.13 + t * 0.7 + 1.3) +
        0.035 * sin(x * 2.3 - t * 1.9 + 4.1)
}

/// The sea's height at `p = vec2(x, t)`.
pub fn level(sea: Sea, p: vec2) -> f32 {
    var h = open(p.x, p.y) * sea.calm
    let dt = p.y - sea.time
    for i in 0..SLOTS {
        let s = sea.swells[i]
        let a = s.z + s.w * dt
        if a > 0.0 { h += a * bump((p.x - s.x - sea.drift[i] * dt) / s.y) }
    }
    if sea.hills > 0.5 { h += hills(p.x) }
    h
}

/// The fixed course's hills at `x`: the hill of `x`'s stretch and its two neighbours.
pub fn hills(x: f32) -> f32 {
    let i = i32(floor(x / SPACING))
    var h = 0.0
    for j in -1..2 {
        let k = clamp(i + j, 0, 29)
        let middle = (f32(k) + 0.5) * SPACING
        h += HILLS[k] * bump((x - middle) / HILL_WIDTH)
    }
    h
}

/// The surface at `x` now: its height, its slope (dh/dx) and how fast it rises (dh/dt).
pub struct Surface: Copy {
    pub height: f32,
    pub slope: f32,
    pub rise: f32,
}

pub fn surface(sea: Sea, x: f32) -> Surface {
    surface_at(sea, x, sea.time)
}

/// The surface at `x` at time `t`, the swells moving at their rates from the sea's time.
pub fn surface_at(sea: Sea, x: f32, t: f32) -> Surface {
    let (h, g) = value_and_gradient(|p: vec2| level(sea, p), vec2(x, t))
    Surface { height: h, slope: g.x, rise: g.y }
}

@test
fn a_swell_is_smooth_and_its_rate_is_the_waters_rise() {
    var sea = Sea {
        swells: [vec4(0.0); SLOTS],
        drift: vec4(0.0),
        time: 2.0,
        calm: 0.0,
        hills: 0.0,
    }
    sea.swells[0] = vec4(10.0, 3.0, 1.5, 2.0)
    let top = surface(sea, 10.0)
    assert(abs(top.height - 1.5) < 1e-5 && abs(top.slope) < 1e-5)
    assert(abs(top.rise - 2.0) < 1e-4, "the rise is the swell's rate")
    // A travelling swell rises ahead of its crest and falls behind it.
    sea.swells[0].w = 0.0
    sea.drift = vec4(5.0, 0.0, 0.0, 0.0)
    let front = surface(sea, 11.0)
    assert(front.rise > 0.0 && abs(front.rise + 5.0 * front.slope) < 1e-3)
    // Past its feet the sea is flat and still.
    let off = surface(sea, 13.5)
    assert(off.height == 0.0 && off.slope == 0.0 && off.rise == 0.0)
    // The derived slope agrees with the height's change.
    let at = 11.2
    let e = 1e-3
    let fd = (surface(sea, at + e).height - surface(sea, at - e).height) / (2.0 * e)
    assert(abs(surface(sea, at).slope - fd) < 1e-2)
}
