// The ride: a tortoise on a longboard on an endless breaking wave, stepped 120 times a second on
// the ticker's thread from the tick's input records alone, so a run is its records and replays
// to the same state in every host. Nothing here draws or sounds; the tally's counts tell the
// frames what happened.
//
// How the rider rides (the contact rule):
// - On the face it carves by heading: up the face (toward the lip) or down it, at a bounded turn
//   rate, the heading relaxing down the line when let be. Gravity along its heading slows it
//   climbing and speeds it dropping, the face's steepness pushes it on (the wave's energy), and
//   the water drags. It stays on the face (the one height function, wave.wrela).
// - The face ends at the lip line, fixed in the wave's frame. A rider whose step carries it across
//   the lip line (outward, relative to it) leaves the water there, once, rising as fast as the
//   face was rising under it (bounded).
// - In the air it falls, drifts back toward the face (the wave coming on under it), and can turn
//   its board. Holding the trick button pulls the tortoise into its shell and spins it (the
//   Shell Spin); letting go brings it out.
// - It lands when it meets the face again: cleanly if it's out of its shell, its spin is near a
//   whole turn and its board points down the line or the face, banking the trick's points times
//   the combo; else it bails, tumbling a moment, slowed, the combo lost.
// - The curl chases it down the line; the curl catching it, a closeout's lip pitching onto it, or
//   a rock or log in its way ends the run. How long it rides and its banked tricks are its score.
use course::{CLOSEOUT, LOG, ROCK, SEGMENT, corridor, difficulty, hazards, segment_of}
use engine::noise::rand
use engine::run::{Asks, TickInput}
use engine::sim::{SimState, Tick}
use std::hash::StateHash
use std::input::{Event, Key, PadAxis, PadButton}
use std::math::TAU
use std::serialize::Serialize
use wave::{Wave, face, height, lip}

pub const HZ: u32 = 120
pub const STEP: f32 = 1.0 / 120.0

// Gravity, on the face and in the air; how the face's steepness pushes the rider on; the water's
// drag, linear and quadratic; the top speed.
const G: f32 = 30.0
const G_AIR: f32 = 26.0
const PUSH: f32 = 4.2
const DRAG: f32 = 0.1
const QUAD: f32 = 0.004
pub const TOP_SPEED: f32 = 30.0
// Carving: the steepest heading up or down the face (radians from down the line), how fast it
// turns, and how fast it relaxes down the line when let be.
pub const STEEPEST: f32 = 1.0
pub const TURN: f32 = 2.6
const RELAX: f32 = 1.6
// Leaving the lip: the rise at most, and a pop on top of it.
const RISE_MOST: f32 = 15.0
const POP: f32 = 2.0
// In the air: the drift back toward the face, the board's turn, the Shell Spin's rate.
const PULL: f32 = 9.0
const AIR_TURN: f32 = 2.4
pub const SPIN: f32 = 12.0
// A clean landing: within this of a whole turn, out of the shell, the board pointing no more
// than this up the face.
const SQUARE: f32 = 0.6
const UP_MOST: f32 = 0.45
// A bail: how long it tumbles, and the speed it keeps.
const TUMBLE: f32 = 0.9
const KEPT: f32 = 0.35
// The curl: its speed, rising with the course's difficulty, and how close it may come.
const CURL_SPEED: f32 = 10.0
const CURL_RAMP: f32 = 5.0
const CATCH: f32 = 2.0
// The rider's body against hazards: its radius, and its height above the board.
pub const BODY: f32 = 0.45
const TALL: f32 = 1.0
// Where a run starts, and how far behind the curl starts.
pub const START: f32 = 20.0
const CURL_START: f32 = 32.0
// Points: per second aloft, per whole turn spun; the most the combo multiplies by.
const AIR_POINTS: f32 = 100.0
const TURN_POINTS: u32 = 500
const COMBO_MOST: u32 = 5

// ---- the controls ------------------------------------------------------------------------------

/// What the player holds, as the tick's records left it: keys and pad buttons as bits, and the
/// pad's stick.
pub struct Controls: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub keys: u32 = 0,
    pub pad: u32 = 0,
    pub stick: f32 = 0.0,
}

pub const UP: u32 = 1
pub const DOWN: u32 = 2
pub const TRICK: u32 = 4
pub const START_RUN: u32 = 8
pub const RESTART: u32 = 16

fn key_bit(k: Key) -> u32 {
    match k {
        Key::Up => UP,
        Key::W => UP,
        Key::Down => DOWN,
        Key::S => DOWN,
        Key::Space => TRICK,
        Key::Z => TRICK,
        Key::Enter => START_RUN,
        Key::R => RESTART,
        _ => 0,
    }
}

fn pad_bit(b: PadButton) -> u32 {
    match b {
        PadButton::Up => UP,
        PadButton::Down => DOWN,
        PadButton::South => TRICK,
        PadButton::East => TRICK,
        PadButton::Start => START_RUN,
        PadButton::Select => RESTART,
        _ => 0,
    }
}

impl Controls {
    /// After event `e` (the keyboard's and pad 0's).
    pub fn update(mut self, e: Event) {
        match e {
            Event::KeyDown { key, repeat, .. } => {
                if !repeat { self.keys = self.keys | key_bit(key) }
            },
            Event::KeyUp { key, .. } => self.keys = self.keys & !key_bit(key),
            Event::PadButton { pad, button, pressed, .. } => {
                if pad == 0 {
                    let bit = pad_bit(button)
                    self.pad = if pressed { self.pad | bit } else { self.pad & !bit }
                }
            },
            Event::PadAxis { pad, axis, value } => {
                // The pad's y is down positive.
                if pad == 0 && axis == PadAxis::LeftY { self.stick = -value }
            },
            _ => {},
        }
    }

    /// The bits held, the stick's tilt among them past its dead zone.
    pub fn held(self) -> u32 {
        var bits = self.keys | self.pad
        if self.stick > 0.4 { bits = bits | UP }
        if self.stick < -0.4 { bits = bits | DOWN }
        bits
    }
}

// ---- the world -----------------------------------------------------------------------------------

pub enum Phase: Copy + Eq + Plain + StateHash + Serialize + SimState + Fieldless {
    // The tortoise riding by itself, waiting for a press.
    Title,
    Riding,
    // The run is over: caught or wiped out.
    Over,
}

pub struct Rider: Copy + Eq + Plain + StateHash + Serialize + SimState {
    // Where its board is (x down the line, y up, z up the face), and its velocity.
    pub at: vec3 = vec3(0.0),
    pub vel: vec3 = vec3(0.0),
    // Its heading (radians up the face from down the line) and its speed along it, on the face.
    pub heading: f32 = 0.0,
    pub speed: f32 = 0.0,
    pub grounded: bool = true,
    // Seconds aloft; the spin so far (radians); in its shell, and seconds since it came out.
    pub aloft: f32 = 0.0,
    pub spin: f32 = 0.0,
    pub shell: bool = false,
    pub out: f32 = 1.0,
    // Seconds of tumbling left after a bail, and since it last landed.
    pub tumble: f32 = 0.0,
    pub landed: f32 = 1.0,
}

/// What has happened, counted: the frames compare counts to find the moments to show and sound.
pub struct Tally: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub runs: u32 = 0,
    pub launches: u32 = 0,
    pub landings: u32 = 0,
    pub clean: u32 = 0,
    pub turns: u32 = 0,
    pub bails: u32 = 0,
    pub wipeouts: u32 = 0,
    pub caught: u32 = 0,
}

pub struct World: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub phase: Phase = Phase::Title,
    pub controls: Controls = Controls {},
    pub rider: Rider = Rider {},
    // The curl's place down the line, and the run's seed.
    pub curl: f32 = 0.0,
    pub seed: u32 = 1,
    pub ticks: u32 = 0,
    // The run's time, and the time in this phase.
    pub clock: f32 = 0.0,
    pub since: f32 = 0.0,
    // The score: banked tricks plus distance; the combo; the last trick banked (its points and
    // whole turns); the best score.
    pub tricks: u32 = 0,
    pub combo: u32 = 0,
    pub last_points: u32 = 0,
    pub last_turns: u32 = 0,
    pub best: u32 = 0,
    pub tally: Tally = Tally {},
}

impl Asks for World {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

/// The wave as the world shapes it.
pub fn wave_of(w: World) -> Wave {
    Wave { curl: w.curl, seed: f32(w.seed % 1000) }
}

/// The game as it opens: the tortoise riding by itself.
pub fn spawn() -> World {
    var w = World {}
    w.rider = dropped_in(w, START)
    w.curl = START - CURL_START
    w
}

/// A rider dropping in at `x`, mid face, at a fair speed.
fn dropped_in(w: World, x: f32) -> Rider {
    let z = 4.0
    Rider { at: vec3(x, height(wave_of(w), vec2(x, z)), z), speed: 14.0 }
}

/// How far the run has gone.
pub fn distance(w: World) -> f32 {
    max(w.rider.at.x - START, 0.0)
}

/// The run's score: distance and banked tricks.
pub fn score(w: World) -> u32 {
    u32(distance(w)) + w.tricks
}

/// The present for the frames: the world itself.
@deterministic
pub fn present(w: World) -> World {
    w
}

// ---- the tick ------------------------------------------------------------------------------------

@deterministic
pub fn tick(w: mut World, input: TickInput<World>) {
    let pressed = read(mut w, input.records)
    step(mut w, pressed)
}

/// The tick's records into the controls: the bits pressed during the tick, each event's, so a
/// press and its release in one tick still count.
@deterministic
pub fn read(w: mut World, records: Vec<Event>) -> u32 {
    var pressed = 0
    for e in records {
        let before = w.controls.held()
        w.controls.update(e)
        pressed = pressed | (w.controls.held() & !before)
    }
    pressed
}

/// One tick, after its presses.
@deterministic
pub fn step(w: mut World, pressed: u32) {
    w.since += STEP
    match w.phase {
        Phase::Title => {
            if (pressed & (START_RUN | TRICK)) != 0 {
                start_run(mut w)
            } else {
                // It rides by itself, the curl kept back.
                ride(mut w, autopilot(w))
                w.curl = max(w.curl, w.rider.at.x - CURL_START)
                if w.phase != Phase::Title {
                    w.phase = Phase::Title
                    w.rider = dropped_in(w, w.rider.at.x + 10.0)
                    w.curl = w.rider.at.x - CURL_START
                }
            }
        },
        Phase::Riding => {
            if (pressed & RESTART) != 0 {
                start_run(mut w)
            } else {
                w.clock += STEP
                ride(mut w, w.controls.held())
            }
        },
        Phase::Over => {
            if w.since > 1.0 && (pressed & (START_RUN | TRICK | RESTART)) != 0 { start_run(mut w) }
        },
    }
    w.ticks += 1
}

fn start_run(w: mut World) {
    w.tally.runs += 1
    w.seed = (w.tally.runs.wrapping_mul(2654435761) ^ 0x9e3779b9) | 1
    w.phase = Phase::Riding
    w.since = 0.0
    w.clock = 0.0
    w.tricks = 0
    w.combo = 0
    w.last_points = 0
    w.last_turns = 0
    w.rider = dropped_in(w, START)
    w.curl = START - CURL_START
}

/// One step of the ride with `held` held: the curl, the rider, then what it meets.
fn ride(w: mut World, held: u32) {
    let d = difficulty(w.rider.at.x)
    w.curl += (CURL_SPEED + CURL_RAMP * d) * STEP
    if w.rider.grounded { carve(mut w, held) } else { fly(mut w, held) }
    meet(mut w)
}

fn toward(x: f32, target: f32, by: f32) -> f32 {
    if x < target { min(x + by, target) } else { max(x - by, target) }
}

/// On the face: carve, speed up or slow, move, and leave at the lip.
fn carve(w: mut World, held: u32) {
    let wv = wave_of(w)
    var r = w.rider
    let tumbling = r.tumble > 0.0
    if tumbling {
        r.tumble = max(r.tumble - STEP, 0.0)
        r.heading = toward(r.heading, 0.0, RELAX * STEP)
    } else if (held & UP) != 0 {
        r.heading = toward(r.heading, STEEPEST, TURN * STEP)
    } else if (held & DOWN) != 0 {
        r.heading = toward(r.heading, -STEEPEST, TURN * STEP)
    } else {
        r.heading = toward(r.heading, 0.0, RELAX * STEP)
    }
    let p = vec2(r.at.x, r.at.z)
    let f = face(wv, p)
    let along = vec2(cos(r.heading), sin(r.heading))
    let grade = dot(f.slope, along)
    let v = r.speed
    var a = -G * grade / sqrt(1.0 + grade * grade) + PUSH * max(f.slope.y, 0.0)
    a -= (DRAG * v + QUAD * v * v) * (if tumbling { 3.0 } else { 1.0 })
    r.speed = clamp(v + a * STEP, 0.0, TOP_SPEED)
    let flat = along * r.speed
    let next = p + flat * STEP
    let before = p.y - lip(wv, p.x)
    let after = next.y - lip(wv, next.x)
    if before < 0.0 && after >= 0.0 {
        // Across the lip line, outward relative to it: off the lip, once.
        let rise = min(max(dot(f.slope, flat), 0.0), RISE_MOST) + POP
        r.at = vec3(next.x, height(wv, next), next.y)
        r.vel = vec3(flat.x, rise, flat.y)
        r.grounded = false
        r.aloft = 0.0
        r.spin = 0.0
        w.tally.launches += 1
    } else {
        let y = height(wv, next)
        r.vel = vec3(flat.x, (y - r.at.y) / STEP, flat.y)
        r.at = vec3(next.x, y, next.y)
    }
    r.landed += STEP
    w.rider = r
}

/// In the air: fall, drift back to the face, turn, spin; land.
fn fly(w: mut World, held: u32) {
    let wv = wave_of(w)
    var r = w.rider
    r.aloft += STEP
    r.vel.y -= G_AIR * STEP
    r.vel.z -= PULL * STEP
    r.at += r.vel * STEP
    if (held & UP) != 0 { r.heading += AIR_TURN * STEP }
    if (held & DOWN) != 0 { r.heading -= AIR_TURN * STEP }
    r.heading = clamp(r.heading, -1.6, 1.6)
    if (held & TRICK) != 0 {
        r.shell = true
        r.spin += SPIN * STEP
    } else {
        if r.shell { r.out = 0.0 }
        r.shell = false
        r.out += STEP
    }
    let ground = height(wv, vec2(r.at.x, r.at.z))
    if r.at.y <= ground {
        land(mut w, mut r, wv)
    }
    w.rider = r
}

/// The rider meets the face from the air.
fn land(w: mut World, r: mut Rider, wv: Wave) {
    let turns = u32(round(r.spin / TAU))
    let off = abs(r.spin - f32(turns) * TAU)
    let clean = !r.shell && off < SQUARE && r.heading < UP_MOST && r.heading > -1.3
    w.tally.landings += 1
    if clean {
        w.combo = min(w.combo + 1, COMBO_MOST)
        let points = u32(r.aloft * AIR_POINTS) + turns * TURN_POINTS
        w.tricks += points * w.combo
        w.last_points = points * w.combo
        w.last_turns = turns
        w.tally.clean += 1
        w.tally.turns += turns
    } else {
        w.combo = 0
        r.tumble = TUMBLE
        w.tally.bails += 1
    }
    let flat = vec2(r.vel.x, r.vel.z)
    r.speed = min(length(flat), TOP_SPEED) * (if clean { 1.0 } else { KEPT })
    r.heading = if clean { clamp(r.heading, -STEEPEST, STEEPEST) } else { 0.0 }
    // Back on the face, never past its lip.
    r.at.z = min(r.at.z, lip(wv, r.at.x) - 0.2)
    r.at.y = height(wv, vec2(r.at.x, r.at.z))
    r.vel = vec3(flat.x, 0.0, flat.y)
    r.grounded = true
    r.aloft = 0.0
    r.spin = 0.0
    r.shell = false
    r.out = 1.0
    r.landed = 0.0
}

/// What the rider meets: the curl, closeouts, rocks and logs. Any of them ends the run.
fn meet(w: mut World) {
    let wv = wave_of(w)
    let r = w.rider
    let p = vec2(r.at.x, r.at.z)
    if r.at.x < w.curl + CATCH {
        over(mut w, caught: true)
        return
    }
    let k = segment_of(r.at.x)
    let first = if k > 0 { k - 1 } else { 0 }
    for s in first..k + 2 {
        let h = hazards(w.seed, wv, s)
        for i in 0..h.count {
            let z = h.items[i]
            if z.kind == ROCK {
                let top = height(wv, z.at) + z.size.y
                if length(p - z.at) < z.size.x * 0.5 + BODY && r.at.y < top {
                    over(mut w, caught: false)
                    return
                }
            } else if z.kind == LOG {
                let t = clamp(p.x - z.at.x, 0.0, z.size.y)
                let near = vec2(z.at.x + t, z.at.y)
                let top = height(wv, near) + z.size.x + 0.2
                if length(p - near) < z.size.x * 0.5 + BODY && r.at.y < top {
                    over(mut w, caught: false)
                    return
                }
            } else if z.kind == CLOSEOUT {
                let inside = p.x >= z.at.x && p.x <= z.at.x + z.size.y && p.y > z.at.y - 0.3
                if inside && r.at.y < height(wv, p) + TALL + 2.0 {
                    over(mut w, caught: true)
                    return
                }
            }
        }
    }
}

fn over(w: mut World, caught: bool) {
    w.phase = Phase::Over
    w.since = 0.0
    if caught { w.tally.caught += 1 } else { w.tally.wipeouts += 1 }
    w.best = max(w.best, score(w))
}

/// The title's rider, and the tests' bot: steer for the corridor's centre a quarter of a second
/// ahead (pure pursuit).
pub fn autopilot(w: World) -> u32 {
    let r = w.rider
    let ahead = max(r.speed * 0.25, 2.0)
    let want = corridor(w.seed, r.at.x + ahead).x
    let aim = clamp(atan2(want - r.at.z, ahead), -STEEPEST, STEEPEST)
    if r.heading < aim - 0.02 { UP } else if r.heading > aim + 0.02 { DOWN } else { 0 }
}

// ---- tests -----------------------------------------------------------------------------------------

// A run, riding, the rider at `(x, z)` on the face at `speed`, heading `heading`.
fn riding_at(x: f32, z: f32, speed: f32, heading: f32) -> World {
    var w = spawn()
    start_run(mut w)
    w.rider = Rider {
        at: vec3(x, height(wave_of(w), vec2(x, z)), z),
        speed,
        heading,
    }
    w.curl = x - 200.0
    w.seed = 3
    w
}

fn holding(w: mut World, bits: u32, ticks: u32) {
    w.controls.keys = bits
    for _ in 0..ticks { step(mut w, 0) }
}

@test
fn climbing_the_face_slows_and_dropping_speeds() {
    var up = riding_at(x: 40.0, z: 4.0, speed: 15.0, heading: 0.0)
    var down = up
    holding(mut up, UP, 45)
    holding(mut down, DOWN, 45)
    assert(up.rider.at.z > 5.0 && down.rider.at.z < 3.0, "carved up and down")
    assert(down.rider.speed > up.rider.speed + 4.0, f"{down.rider.speed} against {up.rider.speed}")
    // The heading never passes its steepest, and comes back down the line when let be.
    assert(up.rider.heading <= STEEPEST)
    holding(mut up, bits: 0, ticks: 120)
    assert(abs(up.rider.heading) < 0.01)
}

@test
fn crossing_the_lip_launches_once_and_riding_along_it_does_not() {
    // Up the face at speed: off the lip, once.
    var w = riding_at(x: 40.0, z: 6.0, speed: 20.0, heading: 0.8)
    holding(mut w, UP, 1)
    var launches = 0
    var was = true
    for _ in 0..240 {
        step(mut w, 0)
        if was && !w.rider.grounded { launches += 1 }
        was = w.rider.grounded
    }
    assert(launches == 1 && w.tally.launches == 1, f"{launches} launches")
    // Down the line just under the lip, never crossing it: never airborne, never past it.
    var along = riding_at(x: 40.0, z: 0.0, speed: 18.0, heading: 0.0)
    for _ in 0..240 {
        let wv = wave_of(along)
        along.rider.at.z = lip(wv, along.rider.at.x) - 0.3
        along.rider.heading = 0.0
        step(mut along, 0)
        assert(along.rider.grounded, "launched riding along the lip")
        assert(along.rider.at.z < lip(wave_of(along), along.rider.at.x), "past the lip")
    }
}

// Off the lip and into the air, the trick button held for `held` ticks of it (0 for none), the
// board turned down the face before it lands.
fn air(held: u32) -> World {
    var w = riding_at(x: 40.0, z: 6.0, speed: 20.0, heading: 0.8)
    w.controls.keys = UP
    while w.rider.grounded { step(mut w, 0) }
    w.controls.keys = TRICK
    for _ in 0..held { step(mut w, 0) }
    w.controls.keys = DOWN
    var guard = 0
    while !w.rider.grounded && guard < 600 {
        if w.rider.heading < 0.0 { w.controls.keys = 0 }
        step(mut w, 0)
        guard += 1
    }
    w
}

@test
fn a_whole_shell_spin_lands_clean_and_half_of_one_bails() {
    // A whole turn: the spin rate is 12 a second, so 63 ticks is 6.3 radians.
    let whole = air(held: 63)
    assert(whole.tally.clean == 1 && whole.tally.turns == 1, "a clean Shell Spin")
    assert(whole.tricks >= TURN_POINTS && whole.combo == 1)
    let half = air(held: 31)
    assert(half.tally.bails == 1 && half.combo == 0 && half.rider.tumble > 0.0, "half a turn bails")
    // No trick at all, the board turned down: clean, a little banked for the air.
    let plain = air(held: 0)
    assert(plain.tally.clean == 1 && plain.tricks > 0)
}

@test
fn landing_still_in_the_shell_bails() {
    var w = riding_at(x: 40.0, z: 6.0, speed: 20.0, heading: 0.8)
    w.controls.keys = UP
    while w.rider.grounded { step(mut w, 0) }
    w.controls.keys = TRICK
    var guard = 0
    while !w.rider.grounded && guard < 600 {
        step(mut w, 0)
        guard += 1
    }
    assert(w.tally.bails == 1 && w.tally.clean == 0)
}

@test
fn the_curl_catches_a_rider_who_falls_behind() {
    // Down in the flat water, slowing: caught.
    var slow = riding_at(x: 40.0, z: -4.0, speed: 6.0, heading: 0.0)
    slow.curl = 30.0
    holding(mut slow, 0, 120 * 8)
    assert(slow.phase == Phase::Over && slow.tally.caught == 1)
    // High on the face (before the first hazards), it keeps ahead.
    var fast = riding_at(x: 10.0, z: 6.5, speed: 18.0, heading: 0.0)
    fast.curl = 0.0
    for _ in 0..120 * 3 {
        let wv = wave_of(fast)
        fast.controls.keys = if fast.rider.at.z < lip(wv, fast.rider.at.x) * 0.7 { UP } else {
            DOWN
        }
        step(mut fast, 0)
    }
    assert(fast.phase == Phase::Riding, "kept ahead of the curl")
}

@test
fn the_rider_never_sinks_into_the_face() {
    var w = riding_at(x: 40.0, z: 4.0, speed: 15.0, heading: 0.0)
    var seed: u32 = 11
    for i in 0..3000 {
        seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
        if (seed >> 24) < 8 { w.controls.keys = (seed >> 8) & (UP | DOWN | TRICK) }
        step(mut w, 0)
        if w.phase != Phase::Riding {
            w = riding_at(x: w.rider.at.x + 30.0, z: 4.0, speed: 15.0, heading: 0.0)
        }
        let ground = height(wave_of(w), vec2(w.rider.at.x, w.rider.at.z))
        assert(w.rider.at.y >= ground - 1e-3, f"below the face at tick {i}")
    }
}

@test
fn a_bot_on_the_corridor_rides_the_hardest_course_without_harm() {
    // Following the corridor from deep in the run (where the course is at its hardest), at the
    // slowest speed the face sustains and at the top speed: no hazard, no closeout.
    for speed in [9.0, TOP_SPEED] {
        for seed in [3, 41, 977] {
            var w = riding_at(x: 2600.0, z: 4.0, speed: speed, heading: 0.0)
            w.seed = seed
            w.rider.at.z = corridor(seed, 2600.0).x
            for _ in 0..120 * 20 {
                w.controls.keys = autopilot(w)
                // Hold the speed where it's being tested, as a rider pumping or braking would.
                w.rider.speed = speed
                w.curl = w.rider.at.x - 100.0
                step(mut w, 0)
                assert(w.phase == Phase::Riding, f"hit something at {w.rider.at.x}, seed {seed}")
            }
        }
    }
}
