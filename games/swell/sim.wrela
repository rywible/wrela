// The ride: a tortoise on a board, riding a sea it raises. Stepped 120 times a second on the
// ticker's thread from the tick's input records alone, so a run is its records: it replays to
// the same state in every host. Nothing here draws or sounds; the tally's counts tell the frames
// what happened.
//
// How the rider meets the water (the contact rule):
// - On the water it follows the surface: its height is the sea's, and its rise is the sea's
//   over the step, so water rising under it carries it up.
// - It leaves the water when its path under gravity would be above the surface: off a crest at
//   speed, or when the water carrying it up stops rising (a released swell throws it).
// - Landing keeps the part of its velocity along the surface and loses the part into it; a
//   landing nearly along the surface is clean, and pays a little speed.
// - Gravity along the slope speeds it down a face and slows it up one; a face rising under it
//   (as it moves) pushes it down that face, as a wave pushes a surfer. Flat water drags it back
//   to paddling speed.
// - A held swell rises just behind the rider and keeps pace with it, so the rider surfs its
//   front face, up to `SURGE` faster than the rider was going when it raised it (a faster rider
//   outruns it); a swell held at its highest for a while lets go by itself. Let go, and the
//   swell surges forward, rising, until its crest has passed under the rider: passing fast, it
//   throws the rider into the air. Then it settles and slows.
// - One swell grows or snaps at a time, at a bounded rate up to a bounded height, travelling no
//   faster than the top speed; the others only settle. When every slot is taken, a press
//   raises nothing, and no standing swell is taken away.
// - On the fixed course (the playtest's control) the sea has hills of its own, and the button
//   dives instead: the rider is heavier on the water while it's held, gaining speed down a face
//   and holding to it over a crest; let go on a rising face to fly.
use course::{FINISH, ROCKS, RUNUP, START, rock_distance}
use engine::run::{Asks, TickInput}
use engine::sim::{SimState, Tick}
use sea::{SLOTS, Sea, Surface, level, surface, surface_at}
use std::hash::StateHash
use std::input::{Event, Key, PadAxis, PadButton}
use std::serialize::Serialize

pub const HZ: u32 = 120
pub const STEP: f32 = 1.0 / 120.0

// Gravity, on the water and in the air, and on the water while diving (the fixed course).
const G: f32 = 30.0
const DIVE: f32 = 4.0
// How hard a rising face pushes the rider down it, per unit of its rise.
const PUSH: f32 = 2.5
// Paddling: the speed the rider paddles back up to on flat water, and how hard.
pub const CRUISE: f32 = 6.0
const PADDLE: f32 = 6.0
// The water's drag, linear and quadratic in speed; tucked (right) less, braking (left) more.
const DRAG: f32 = 0.03
const QUAD: f32 = 0.004
const TUCK: f32 = 0.55
const BRAKE: f32 = 2.6
const TOP_SPEED: f32 = 30.0
// A swell: how fast a held one rises and how high it gets, and how long it's held there before
// it lets go by itself; its half width; how far behind the rider it rises, where behind the
// rider it keeps (and how firmly), and how much faster than the rider's speed when raised it can
// travel. Let go, it surges `THROW` faster than the rider and rises at `SNAP_RISE`, until its
// crest is past the rider or for `SNAP` seconds, then settles (a share of its height a second,
// and at least this rate), slowing by a share of its speed a second.
pub const RISE: f32 = 3.6
pub const HIGHEST: f32 = 2.2
const HOLD: f32 = 0.6
pub const HALF_WIDTH: f32 = 3.2
const BEHIND: f32 = 2.2
const KEEP: f32 = 1.7
const FIRM: f32 = 4.0
const SURGE: f32 = 5.0
const THROW: f32 = 12.0
const SNAP_RISE: f32 = 4.0
const SNAP: f32 = 0.6
const SETTLE: f32 = 1.4
const SETTLE_LEAST: f32 = 0.6
const SLOWING: f32 = 2.5
// The rider leaves the water only when its path clears it by this much: no flicker on ripples.
const CLEAR: f32 = 0.002
// A clean landing: into the water slower than this, after this long aloft, pays this speed.
const CLEAN: f32 = 3.0
const CLEAN_AIR: f32 = 0.35
const CLEAN_BOOST: f32 = 1.5
// The rider's body against rocks: a circle this far above its feet, this big.
pub const BODY_UP: f32 = 0.45
pub const BODY_RADIUS: f32 = 0.4
// A wipeout lasts this long before the rider starts again.
const WIPE: f32 = 1.6

// ---- the controls --------------------------------------------------------------------------------

/// What the player holds, as the tick's records left it: keys and pad buttons as bits, and the
/// pad's stick.
pub struct Controls: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub keys: u32 = 0,
    pub pad: u32 = 0,
    pub stick: f32 = 0.0,
}

pub const SWELL: u32 = 1
pub const RIGHT: u32 = 2
pub const LEFT: u32 = 4
pub const START_RUN: u32 = 8
pub const RESTART: u32 = 16
pub const VARIANT: u32 = 32

fn key_bit(k: Key) -> u32 {
    match k {
        Key::Space => SWELL,
        Key::Up => SWELL,
        Key::W => SWELL,
        Key::Z => SWELL,
        Key::Right => RIGHT,
        Key::D => RIGHT,
        Key::Left => LEFT,
        Key::A => LEFT,
        Key::Enter => START_RUN,
        Key::R => RESTART,
        Key::Tab => VARIANT,
        Key::V => VARIANT,
        _ => 0,
    }
}

fn pad_bit(b: PadButton) -> u32 {
    match b {
        PadButton::South => SWELL,
        PadButton::East => SWELL,
        PadButton::Right => RIGHT,
        PadButton::Left => LEFT,
        PadButton::Start => START_RUN,
        PadButton::Select => RESTART,
        PadButton::North => VARIANT,
        _ => 0,
    }
}

impl Controls {
    /// After event `e` (the keyboard's and pad 0's).
    pub fn update(mut self, e: Event) {
        match e {
            Event::KeyDown { key, repeat, .. } => {
                if !repeat { self.keys = self.keys | key_bit(key) }
            },
            Event::KeyUp { key, .. } => self.keys = self.keys & !key_bit(key),
            Event::PadButton { pad, button, pressed, .. } => {
                if pad == 0 {
                    let bit = pad_bit(button)
                    self.pad = if pressed { self.pad | bit } else { self.pad & !bit }
                }
            },
            Event::PadAxis { pad, axis, value } => {
                if pad == 0 && axis == PadAxis::LeftX { self.stick = value }
            },
            _ => {},
        }
    }

    /// The bits held, the stick's lean among them past its dead zone.
    pub fn held(self) -> u32 {
        var bits = self.keys | self.pad
        if self.stick > 0.4 { bits = bits | RIGHT }
        if self.stick < -0.4 { bits = bits | LEFT }
        bits
    }
}

// ---- the world -----------------------------------------------------------------------------------

pub enum Phase: Copy + Eq + Plain + StateHash + Serialize + SimState + Fieldless {
    // Bobbing at the start, waiting for a press.
    Title,
    Riding,
    // Hit a rock: tumbling, then back before it.
    Wiped,
    // Past the finish buoy.
    Finished,
}

pub struct Rider: Copy + Eq + Plain + StateHash + Serialize + SimState {
    // Where its feet are, and its velocity.
    pub at: vec2 = vec2(0.0),
    pub vel: vec2 = vec2(0.0),
    pub grounded: bool = true,
    // Seconds aloft, and since it last landed.
    pub aloft: f32 = 0.0,
    pub landed: f32 = 1.0,
    // The slope of the water under it when it last stood on it.
    pub slope: f32 = 0.0,
}

/// What has happened in the world, counted: the frames compare counts to find the moments to
/// show and sound. `impact` is the last landing's speed into the water.
pub struct Tally: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub runs: u32 = 0,
    pub raised: u32 = 0,
    pub refused: u32 = 0,
    pub landings: u32 = 0,
    pub clean: u32 = 0,
    pub wipeouts: u32 = 0,
    pub finishes: u32 = 0,
    pub impact: f32 = 0.0,
}

pub struct World: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub phase: Phase = Phase::Title,
    // The fixed course: hills stand in the sea, and the button dives.
    pub fixed: bool = false,
    pub controls: Controls = Controls {},
    pub rider: Rider = Rider {},
    // Each slot's swell, `vec4(centre, half width, height, rate)`, and its speed (sea.wrela);
    // empty at height 0. The one growing, or `SLOTS` for none, and each one's snap left.
    pub swells: [vec4; SLOTS] = [vec4(0.0); SLOTS],
    pub drift: vec4 = vec4(0.0),
    pub growing: u32 = SLOTS,
    pub snaps: vec4 = vec4(0.0),
    // How long the growing swell has been held at its highest, and its top speed.
    pub topped: f32 = 0.0,
    pub cap: f32 = 0.0,
    pub ticks: u32 = 0,
    // The run's time, and the time in this phase.
    pub clock: f32 = 0.0,
    pub since: f32 = 0.0,
    // How many rocks the rider has passed this run.
    pub cleared: u32 = 0,
    // The open sea's swell: 1 in play, 0 for a flat sea in tests.
    pub calm: f32 = 1.0,
    pub tally: Tally = Tally {},
}

impl Asks for World {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

/// The game as it opens: the rider bobbing at the start.
pub fn spawn() -> World {
    var w = World {}
    w.rider = afloat(w, START)
    w
}

/// The sea now.
pub fn sea_of(w: World) -> Sea {
    Sea {
        swells: w.swells,
        drift: w.drift,
        time: f32(w.ticks) * STEP,
        calm: w.calm,
        hills: if w.fixed { 1.0 } else { 0.0 },
    }
}

/// A rider standing still on the water at `x`.
fn afloat(w: World, x: f32) -> Rider {
    let s = surface(sea_of(w), x)
    Rider { at: vec2(x, s.height), slope: s.slope }
}

/// The present for the frames: the world itself.
@deterministic
pub fn present(w: World) -> World {
    w
}

// ---- the tick ------------------------------------------------------------------------------------

@deterministic
pub fn tick(w: mut World, input: TickInput<World>) {
    let pressed = read(mut w, input.records)
    step(mut w, pressed)
}

/// The tick's records into the controls: the bits pressed during the tick, each event's, so a
/// press and its release in one tick still count.
@deterministic
pub fn read(w: mut World, records: Vec<Event>) -> u32 {
    var pressed = 0
    for e in records {
        let before = w.controls.held()
        w.controls.update(e)
        pressed = pressed | (w.controls.held() & !before)
    }
    pressed
}

/// One tick, after its presses.
@deterministic
pub fn step(w: mut World, pressed: u32) {
    let held = w.controls.held()
    w.since += STEP
    match w.phase {
        Phase::Title => {
            if (pressed & VARIANT) != 0 { w.fixed = !w.fixed }
            if (pressed & (START_RUN | SWELL)) != 0 {
                start_run(mut w)
            } else {
                swells(mut w, pressed: 0, held: 0)
                ride(mut w, 0, paddling: false)
            }
        },
        Phase::Riding => {
            if (pressed & RESTART) != 0 {
                start_run(mut w)
            } else {
                w.clock += STEP
                swells(mut w, pressed, held)
                ride(mut w, held, paddling: true)
                rocks(mut w)
                if w.phase == Phase::Riding && w.rider.at.x >= FINISH {
                    w.phase = Phase::Finished
                    w.since = 0.0
                    w.tally.finishes += 1
                }
            }
        },
        Phase::Wiped => {
            swells(mut w, pressed: 0, held: 0)
            tumble(mut w)
            if w.since >= WIPE { come_back(mut w) }
        },
        Phase::Finished => {
            if w.since > 1.0 && (pressed & (START_RUN | SWELL | RESTART)) != 0 {
                start_run(mut w)
            } else {
                swells(mut w, pressed: 0, held: 0)
                ride(mut w, 0, paddling: false)
            }
        },
    }
    w.ticks += 1
}

fn start_run(w: mut World) {
    w.phase = Phase::Riding
    w.since = 0.0
    w.clock = 0.0
    w.cleared = 0
    w.swells = [vec4(0.0); SLOTS]
    w.drift = vec4(0.0)
    w.growing = SLOTS
    w.snaps = vec4(0.0)
    w.rider = afloat(w, START)
    w.rider.vel.x = CRUISE * 0.5
    w.tally.runs += 1
}

/// The swells' rates for this step: a press raises a new one where a slot is free; the held one
/// rises, a released one snaps and then settles. The step that follows moves them.
fn swells(w: mut World, pressed: u32, held: u32) {
    if (pressed & SWELL) != 0 && !w.fixed {
        var free = SLOTS
        for i in 0..SLOTS {
            if free == SLOTS && w.swells[i].z <= 0.0 && w.snaps[i] <= 0.0 { free = i }
        }
        if free < SLOTS {
            let r = w.rider
            w.swells[free] = vec4(r.at.x - BEHIND, HALF_WIDTH, 0.0, 0.0)
            w.drift[free] = r.vel.x
            w.growing = free
            w.topped = 0.0
            w.cap = min(r.vel.x + SURGE, TOP_SPEED)
            w.tally.raised += 1
        } else { w.tally.refused += 1 }
    }
    if w.growing < SLOTS && ((held & SWELL) == 0 || w.topped >= HOLD) {
        w.snaps[w.growing] = SNAP
        w.drift[w.growing] = min(w.rider.vel.x + THROW, TOP_SPEED)
        w.growing = SLOTS
    }
    for i in 0..SLOTS {
        var s = w.swells[i]
        if i == w.growing {
            s.w = min(RISE, (HIGHEST - s.z) / STEP)
            let r = w.rider
            w.drift[i] = clamp(r.vel.x + FIRM * (r.at.x - KEEP - s.x), 0.0, w.cap)
            if s.z >= HIGHEST { w.topped += STEP }
        } else if w.snaps[i] > 0.0 && s.x < w.rider.at.x + 0.5 {
            s.w = SNAP_RISE
        } else if s.z > 0.0 {
            s.w = -min(max(s.z * SETTLE, SETTLE_LEAST), s.z / STEP)
        } else {
            s = vec4(0.0)
            w.drift[i] = 0.0
        }
        w.swells[i] = s
    }
}

/// The swells after this step, at the rates `swells` set: moved, risen or settled, and slowed.
fn settle(w: mut World) {
    for i in 0..SLOTS {
        var s = w.swells[i]
        s.x += w.drift[i] * STEP
        s.z = max(s.z + s.w * STEP, 0.0)
        w.swells[i] = s
        if w.snaps[i] > 0.0 {
            // A surge ends when its crest is past the rider, or its time is up.
            w.snaps[i] = if s.x < w.rider.at.x + 0.5 { max(w.snaps[i] - STEP, 0.0) } else { 0.0 }
        } else if i != w.growing {
            w.drift[i] *= 1.0 - SLOWING * STEP
        }
    }
}

/// The rider over one step, then the swells. `held` leans it; a paddling rider paddles back up
/// to `CRUISE`.
fn ride(w: mut World, held: u32, paddling: bool) {
    let sea = sea_of(w)
    let t1 = sea.time + STEP
    var r = w.rider
    if r.grounded {
        let s = surface(sea, r.at.x)
        let k = s.slope
        let n2 = 1.0 + k * k
        let g = if w.fixed && (held & SWELL) != 0 { G * DIVE } else { G }
        let v = r.vel.x
        var ax = -g * k / n2 + PUSH * max(s.rise + k * v, 0.0) * -k / sqrt(n2)
        var drag = 1.0
        if (held & RIGHT) != 0 { drag = TUCK }
        if (held & LEFT) != 0 { drag = BRAKE }
        ax -= (DRAG * v + QUAD * v * v) * drag
        if paddling && v < CRUISE { ax += PADDLE * (CRUISE - v) / CRUISE }
        r.vel.x = clamp(v + ax * STEP, -TOP_SPEED, TOP_SPEED)
        r.at.x += r.vel.x * STEP
        let h1 = level(sea, vec2(r.at.x, t1))
        let up = r.vel.y - g * STEP
        let y = r.at.y + up * STEP
        if y > h1 + CLEAR {
            r.grounded = false
            r.aloft = 0.0
            r.at.y = y
            r.vel.y = up
        } else {
            r.vel.y = (h1 - r.at.y) / STEP
            r.at.y = h1
            r.slope = k
        }
    } else {
        r.vel.y -= G * STEP
        r.at += r.vel * STEP
        r.aloft += STEP
        let h1 = level(sea, vec2(r.at.x, t1))
        if r.at.y <= h1 {
            land(mut w, mut r, surface_at(sea, r.at.x, t1))
        }
    }
    r.landed += STEP
    w.rider = r
    settle(mut w)
}

/// The rider meets the water `s` from the air.
fn land(w: mut World, r: mut Rider, s: Surface) {
    let k = s.slope
    let n = sqrt(1.0 + k * k)
    let rel = vec2(r.vel.x, r.vel.y - s.rise)
    let along = (rel.x + k * rel.y) / n
    let into = (k * rel.x - rel.y) / n
    r.vel.x = clamp(along / n, -TOP_SPEED, TOP_SPEED)
    if r.aloft > 0.15 {
        w.tally.landings += 1
        w.tally.impact = into
        if into < CLEAN && r.aloft > CLEAN_AIR {
            r.vel.x = min(r.vel.x + CLEAN_BOOST, TOP_SPEED)
            w.tally.clean += 1
        }
        r.landed = 0.0
    }
    r.vel.y = s.rise + k * r.vel.x
    r.at.y = s.height
    r.slope = k
    r.grounded = true
    r.aloft = 0.0
}

/// Rocks: passing one counts it; touching one wipes the rider out.
fn rocks(w: mut World) {
    let body = w.rider.at + vec2(0.0, BODY_UP)
    for i in 0..5 {
        let r = ROCKS[i]
        if rock_distance(r, body) < BODY_RADIUS {
            w.phase = Phase::Wiped
            w.since = 0.0
            w.tally.wipeouts += 1
            w.rider.vel = vec2(-3.0, 7.0)
            w.rider.grounded = false
            w.growing = SLOTS
            return
        }
        if w.cleared == i && w.rider.at.x > r.x + r.z { w.cleared = i + 1 }
    }
}

/// A wiped-out rider: thrown back off the rock, then afloat where it falls.
fn tumble(w: mut World) {
    let sea = sea_of(w)
    var r = w.rider
    let h = level(sea, vec2(r.at.x, sea.time + STEP))
    if r.at.y > h || r.vel.y > 0.0 {
        r.vel.y -= G * STEP
        r.at += r.vel * STEP
        if r.at.y < h { r.vel = vec2(0.0) }
    }
    if r.at.y <= h { r.at.y = h }
    w.rider = r
    settle(mut w)
}

fn come_back(w: mut World) {
    let x = if w.cleared < 5 { ROCKS[w.cleared].x - RUNUP } else { START }
    w.phase = Phase::Riding
    w.since = 0.0
    w.swells = [vec4(0.0); SLOTS]
    w.drift = vec4(0.0)
    w.growing = SLOTS
    w.snaps = vec4(0.0)
    w.rider = afloat(w, x)
    w.rider.vel.x = CRUISE
}

// ---- tests -----------------------------------------------------------------------------------------

// A flat sea, riding, the rider at `x` at speed `v` on the water (before the course's first
// rock, for the tests at negative `x`).
fn calm_ride(x: f32, v: f32) -> World {
    var w = World { calm: 0.0 }
    start_run(mut w)
    w.rider = afloat(w, x)
    w.rider.vel.x = v
    w
}

fn holding(w: mut World, ticks: u32) {
    w.controls.keys = SWELL
    for i in 0..ticks { step(mut w, if i == 0 { SWELL } else { 0 }) }
}

fn letting_go(w: mut World, ticks: u32) {
    w.controls.keys = 0
    for _ in 0..ticks { step(mut w, 0) }
}

fn sea_height(w: World) -> f32 {
    surface(sea_of(w), w.rider.at.x).height
}

// Holds the rider still on top of the swell it raises, for `ticks` ticks.
fn held_on_top(w: mut World, ticks: u32) -> f32 {
    w.controls.keys = SWELL
    w.swells[0] = vec4(w.rider.at.x, HALF_WIDTH, 0.0, 0.0)
    w.drift = vec4(0.0)
    w.growing = 0
    let x = w.rider.at.x
    var top = 0.0
    for _ in 0..ticks {
        w.rider.vel.x = 0.0
        step(mut w, 0)
        w.rider.at.x = x
        top = max(top, w.rider.at.y)
        assert(w.rider.grounded, "carried, not thrown")
    }
    top
}

@test
fn water_rising_under_a_still_rider_carries_it_up() {
    var w = calm_ride(x: -100.0, v: 0.0)
    // 50 ticks of rising, short of the swell's highest (where the water stops, and throws it).
    let top = held_on_top(mut w, 50)
    assert(abs(top - RISE * 50.0 * STEP) < 1e-3, f"carried to the swell's top: {top}")
}

@test
fn surfing_a_held_swell_speeds_the_rider_and_letting_go_throws_it_high() {
    var w = calm_ride(x: -100.0, v: CRUISE)
    holding(mut w, 100)
    assert(w.rider.grounded && w.rider.vel.x > CRUISE + 3.0, f"surfed to {w.rider.vel.x}")
    let x = w.rider.at.x
    letting_go(mut w, 1)
    var peak = 0.0
    for _ in 0..240 {
        step(mut w, 0)
        peak = max(peak, w.rider.at.y)
    }
    // High enough to clear the tallest rock, and down again beyond the launch.
    assert(w.tally.landings == 1, f"landed {w.tally.landings} times")
    assert(peak > 3.5, f"the launch's peak {peak}")
    assert(w.rider.grounded && w.rider.at.x > x + 10.0)
}

@test
fn the_rider_never_sinks_into_the_water() {
    // Presses at seeded times on the open sea: the rider is never below the surface.
    var w = spawn()
    start_run(mut w)
    var seed: u32 = 77
    for i in 0..3000 {
        seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
        let roll = seed >> 24
        if roll < 6 { w.controls.keys = w.controls.keys ^ SWELL }
        let pressed = if roll < 6 && (w.controls.keys & SWELL) != 0 { SWELL } else { 0 }
        step(mut w, pressed)
        if w.phase != Phase::Riding { start_run(mut w) }
        assert(w.rider.at.y >= sea_height(w) - 1e-3, f"below the water at tick {i}")
    }
}

@test
fn a_press_with_every_slot_taken_raises_nothing_and_takes_nothing_away() {
    var w = calm_ride(x: -100.0, v: 8.0)
    for _ in 0..SLOTS {
        holding(mut w, 10)
        letting_go(mut w, 2)
    }
    assert(w.tally.raised == SLOTS && w.tally.refused == 0)
    holding(mut w, 1)
    assert(w.tally.refused == 1 && w.tally.raised == SLOTS, "refused")
    for i in 0..SLOTS { assert(w.swells[i].z > 0.0, "every swell still standing") }
    // A held swell stops at its highest, and lets go by itself after a while there.
    var w = calm_ride(x: -100.0, v: 0.0)
    holding(mut w, 100)
    assert(abs(w.swells[0].z - HIGHEST) < 1e-4 && w.growing == 0)
    for _ in 0..60 { step(mut w, 0) }
    assert(w.growing == SLOTS)
}

@test
fn a_press_and_its_release_in_one_tick_still_raise_a_swell() {
    var w = calm_ride(x: -100.0, v: 5.0)
    var records: Vec<Event> = Vec::new()
    records.push(Event::KeyDown { key: Key::Space, repeat: false, mods: std::input::Mods {} })
    records.push(Event::KeyUp { key: Key::Space, mods: std::input::Mods {} })
    let pressed = read(mut w, records)
    step(mut w, pressed)
    assert(w.tally.raised == 1 && w.growing == SLOTS)
}

@test
fn landing_along_a_face_keeps_speed_and_into_it_loses_speed() {
    // The same fall onto the far face of a fixed swell, and onto its near face.
    var down = calm_ride(x: 0.0, v: 0.0)
    down.swells[0] = vec4(30.0, HALF_WIDTH, 2.0, 0.0)
    var up = down
    // Just above the water, falling at the far face's slope, and at the near face.
    down.rider = Rider { at: vec2(30.6, 1.8), vel: vec2(8.0, -8.0), grounded: false, aloft: 0.5 }
    up.rider = Rider { at: vec2(28.0, 0.37), vel: vec2(8.0, -8.0), grounded: false, aloft: 0.5 }
    for _ in 0..30 {
        step(mut down, 0)
        step(mut up, 0)
    }
    assert(down.tally.clean == 1 && up.tally.clean == 0)
    assert(down.rider.vel.x > up.rider.vel.x + 2.0)
}

@test
fn hitting_a_rock_wipes_out_and_starts_again_before_it() {
    let r = ROCKS[0]
    var w = calm_ride(r.x - 4.0, 10.0)
    for _ in 0..120 { step(mut w, 0) }
    assert(w.tally.wipeouts == 1, "hit the rock")
    for _ in 0..240 { step(mut w, 0) }
    assert(w.phase == Phase::Riding && w.rider.at.x < r.x && w.rider.at.x > r.x - RUNUP - 1.0)
}

@test
fn the_fixed_course_raises_nothing_and_diving_down_a_hill_is_faster() {
    // From the top of the course's fifth hill, diving and not.
    let top = (4.0 + 0.5) * sea::SPACING
    var dive = World { calm: 0.0, fixed: true }
    start_run(mut dive)
    dive.rider = afloat(dive, top + 0.5)
    var coast = dive
    holding(mut dive, 40)
    letting_go(mut coast, 40)
    assert(dive.tally.raised == 0 && dive.tally.refused == 0)
    assert(dive.rider.vel.x > coast.rider.vel.x + 2.0)
}
