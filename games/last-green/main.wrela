// The Last Green's floor (#54): the program. The player at the gate, the sim stepping it on the
// ticker's thread (world.wrela); the floor drawn by the engine's frame (`engine::frame`: the scene
// jittered into a linear-light target with depth and tags, temporal AA up to the output, the
// look's passes to the screen), seen by the third person's camera; what it draws, casts and
// cooks is its stage (stage.wrela: its trees from the bake's tiles, fetched as files the build
// shipped). This is its sim, its player's climber and camera, its sound, its keys, the way back
// down to the stair, and its tests' exports.

use climber::body::{HEM_RADIUS, TRAIN_REACH}
use climber::cape::Plane
use climber::draw::{drawn, wolf_bones}
use climber::figure::{Figure, figure}
use climber::moves::{drift_rate, locomotion}
use climber::sounds::{Heard, cues, heard}
use engine::frame::{Aim, Change, Frame, Off, Quality, ShadowQuality, Shared}
use engine::shot::{MOVE, NO_CAST, SETTLE, Shots, place, shot_clock}
use land::stream::tile_distance
use tower::door::Exit
use engine::grass::Contact
use land::player::{Arm, Focus, Framing, follow}
use engine::present::Snapshots
use engine::run::run
use engine::shadow::Cascade
use engine::view::first_camera
use history::{BAKED, OBSTACLES}
use ground::{FIGHT, FIGHT_WAY, STONE_FEET, STONE_MARGIN, fought, unbuilt}
use platform::presentation::Link
use stage::{
    BARE, CARDS_TO, DOOR, FLOOR, GROWN, GROWN_LAND, SPECIMENS, SPECIMEN_LAND, Stage, System, VIEWS,
    air_for, air_of, bare_at, fields_clipmap, grown_at, height_at, level_at, look_of, look_view,
    of_world, origin_of, probe_grid, shot_count, source_of, stage, sun_light,
}
use std::collections::replace
use std::gpu::{GpuBuffer, buffer, dispatch, write}
use std::input::{Button, Event, Key, events}
use std::io::{Pending, print}
use std::serialize::save
use world::{World, present as snapshot, spawn_world, tick}

/// How far the player goes from the render origin before it moves (m), and the tiles it moves by
/// (a whole number of the clipmap's coarsest snaps and of its fields' blocks: what's cooked stays).
const RECENTRE: f32 = 3072.0
const RECENTRE_STEP: i32 = 6

/// How near the player the sim's fawn is drawn (m): past it, it's a few pixels.
const FAWN_DRAWN: f32 = 150.0

/// How long the camera takes to turn fully to the fight's wolf, or back from it (s).
const FOCUS_EASE: f32 = 0.6

/// The floor's world in the tower (tower::rule), the stair's build beside it, and the save.
const WORLD: u32 = 0
const WORLDS: u32 = 2
const STAIR_BUILD: Text = "../stair"
const SAVE: Text = "tower/save"

/// The ticks between the play harness's reports (2 s at 60 Hz).
const REPORT_TICKS: u32 = 120

/// The far static cascade: over the floor (the near follows the player: the frame's defaults).
const FAR_CASCADE = Cascade {
    centre: vec3(650.0, 0.0, -500.0),
    span: 2400.0,
    reach: 2600.0,
    side: 2048,
}

/// How the floor is drawn: the engine's defaults, which are the floor's, and its far cascade.
fn quality() -> Quality {
    Quality { shadows: ShadowQuality { far: FAR_CASCADE } }
}

pub struct Floor {
    console: Link,
    /// The way back down to the stair, and the tower's journey.
    exit: Exit,
    snaps: Snapshots<World>,
    /// The frame (the engine's: targets, light, shadows, probes, sky, readiness) and what it
    /// draws (stage.wrela).
    frame: Frame<Shared>,
    stage: Stage,
    /// Whether the floor's ready (its kinds cooked, the tiles round the player in and placed).
    ready: bool,
    /// What a test captured of the last frame (`test_capture`).
    captured: GpuBuffer<f32>,
    captured_exposure: GpuBuffer<engine::paint::Exposure>,
    framing: Framing,
    /// The camera's arm as it was last frame (`land::player::follow`).
    arm: Arm,
    /// How much the camera turns to the fight's wolf (`encounter::focus`, eased), and where the
    /// wolf is (world space).
    focus: f32,
    focus_at: vec3,
    /// The lookbook's shot the camera's held on (none: the player's), since when, and one being
    /// typed (`keys`).
    shots: Shots,
    /// The camera a test holds (eye, what it looks at), if one does.
    held: Option<(vec3, vec3)>,
    /// The climber, the player: its figure (its garment, whose hem burns) stepped each
    /// frame, and drawn (`climber::draw`, the stage's: its sword realized at the first frame); the
    /// frame's time it was last stepped to, and that step (s); its float's phase out of the
    /// fight (0 to 1); and its glide as last drawn: its velocity (m/s) and heading, and how fast
    /// it was speeding up (m/s²) and turning (rad/s), eased.
    climber: Figure,
    stepped: f32,
    dt: f32,
    drift: f32,
    glide_velocity: vec2,
    glide_heading: f32,
    glide_change: vec2,
    /// The last report's number (`REPORT_TICKS` apart); the last frame's time, and since the
    /// last report the longest between two frames (ms) and how many over 33 ms.
    reported: u32,
    last_time: f32,
    longest: f32,
    slow: u32,
    /// The tiles that were late (`late_tiles`), each told once, and the frame before which no
    /// tile counts as late (after a jump).
    late: Vec<vec2i>,
    settle_until: u32,
    /// The bake's files on their way, to be hashed (F9: `hash_bake`), and their hashes' sum,
    /// bytes and count so far.
    hashing: Vec<Pending<u8>>,
    hashed: vec3u,
    hash_sum: u64,
    /// Where the pointer went down, and a click (down and up in one place) to name what's under
    /// it (`provenance::click`), in the frame's pixels.
    press: Option<vec2>,
    clicked: Option<vec2>,
    /// The floor's ears, on the program's voice (sound.wrela).
    hearing: sound::Hearing,
    /// What the fight has sounded so far (`climber::sounds`).
    fight_heard: Heard,
}

pub fn init() -> Floor {
    let world = spawn_world()
    let start = world.player.at.world()
    let fight_heard = heard(world.fight.fight)
    let latest = run(take world, hz: 60, step: tick, present: snapshot)
    print(f"the floor: {BAKED.len()} files baked, {OBSTACLES.len()} obstacles")
    let eye = vec3(start.x, height_at(start) + 2.0, start.y)
    Floor {
        console: Link::new(),
        exit: Exit::begin(WORLD, WORLDS, SAVE, STAIR_BUILD, DOOR),
        snaps: Snapshots::new(take latest, hz: 60),
        frame: Frame::new(
            quality(),
            sun_light(),
            air_of(),
            fields_clipmap(),
            first_camera(eye, eye + vec3(0.0, 0.0, 1.0), 0.82, width: 960, height: 540),
            probe_grid(start, vec2(0.0), FLOOR),
            start,
        ),
        stage: stage(),
        ready: false,
        captured: buffer(1),
        captured_exposure: buffer(1),
        // Far enough back that the whole robe, its train and the licks at its hem are seen.
        framing: Framing { target: 1.4, behind: 5.0 },
        arm: Arm {},
        focus: 0.0,
        focus_at: vec3(0.0),
        shots: Shots {},
        held: None,
        climber: figure(),
        stepped: 0.0,
        dt: 0.0,
        drift: 0.0,
        glide_velocity: vec2(0.0),
        glide_heading: 0.0,
        glide_change: vec2(0.0),
        reported: 0,
        last_time: 0.0,
        longest: 0.0,
        slow: 0,
        late: Vec::new(),
        // No tile counts as late for 3 s from the start.
        settle_until: 180,
        hashing: Vec::new(),
        hashed: vec3u(0),
        hash_sum: 0,
        press: None,
        clicked: None,
        hearing: sound::start(),
        fight_heard,
    }
}

/// The world's source changed to `source` (`source_of`): the stage's part (its tiles' trees and
/// fields, the far layer, the water), then the frame's: the probes baked over its trees and its
/// land start again, its air's tables (`air_for`) and the sky's dome are cooked again, the
/// cascades drawn again, and the frames stay covered until the light round the eye is drawn.
fn restream(s: mut Floor, source: u32) {
    let began = std::time::now()
    stage::restream(mut s.stage, source, mut s.frame.clipmap)
    s.late = Vec::new()
    s.frame.restart_probes(s.stage)
    s.frame.set_air(air_for(source))
    s.frame.changed(Change::Casters)
    s.frame.arrive()
    print(
        f"the world's source is {source}: restreamed in {(std::time::now() - began) * 1000.0:.0} ms",
    )
}

/// The render origin moved to tile `to`: everything drawn moves with render space, keeping what
/// it cooked (the frame's and the stage's: `Frame::recentre`).
fn recentre(s: mut Floor, to: vec2i) {
    if to == s.stage.origin {
        return
    }
    s.stage.origin = to
    let o = vec2(to) * land::place::TILE
    s.frame.recentre(mut s.stage, vec3(o.x, 0.0, o.y))
    print(f"the render origin moved to tile {to.x}, {to.y}")
}

/// The keys the frames read (the sim reads the player's): F1–F5 leave a system out, F6 draws the
/// water's next look, F7 captures stills, F8 the next debug view of form, B the sun shafts, V
/// the frame as plain rendering; L, a shot's number and Enter hold the camera on a lookbook shot
/// (Escape lets it go).
fn keys(s: mut Floor, time: f32) {
    for e in events() {
        s.console.event(e)
        match e {
            Event::PointerDown { at, button, .. } => {
                if button == Button::Primary {
                    s.press = Some(at)
                }
            },
            Event::PointerUp { at, button, .. } => {
                if button == Button::Primary {
                    if let Some(from) = replace(mut s.press, None) {
                        if length(at - from) < 4.0 {
                            s.clicked = Some(at)
                        }
                    }
                }
            },
            _ => {},
        }
        if let Event::KeyDown { key, .. } = e {
            let chose = s.shots.key(key, shot_count(s.stage.view), time)
            if chose.chosen {
                // Every shot waits for its own view to load before its movement clock begins.
                // Captured stills also rebuild the dome round that eye.
                s.frame.arrive()
            }
            if chose.taken {
                continue
            }
            if key == Key::M {
                s.stage.map.toggle()
            }
            let system = match key {
                Key::F1 => Some(System::Trees),
                Key::F2 => Some(System::Grass),
                Key::F5 => Some(System::Water),
                _ => None,
            }
            if key == Key::F6 {
                s.stage.water_look = (s.stage.water_look + 1) % engine::water::LOOKS.len()
            }
            if key == Key::B {
                s.stage.shafts_on = !s.stage.shafts_on
            }
            // F7 stills and V plain rendering (no look, to tell the look's work from the
            // scene's): the frame's own keys.
            if s.frame.key(key) {
                continue
            }
            // F8: the next debug view of form (clay, silhouettes, the look), to judge the
            // forms alone.
            if key == Key::F8 {
                s.stage.view = (s.stage.view + 1) % VIEWS
                s.frame.light.clay = if s.stage.view == 1 { 1 } else { 0 }
                s.shots.held = None
                // The world's views cast other shadows (their land's): the cascades are drawn
                // again; and the grown view's trees, fields, far layer and water are its own.
                s.frame.changed(Change::Casters)
                let source = source_of(s.stage.view)
                if source != s.stage.source {
                    restream(mut s, source)
                }
            }
            if key == Key::F9 && s.hashing.is_empty() {
                for i in 0..BAKED.len() {
                    s.hashing.push(BAKED.fetch(i))
                }
                s.hashed = vec3u(0)
                s.hash_sum = 0
            }
            if key == Key::F3 {
                let on = s.frame.on(Off::Shadows)
                s.frame.set(Off::Shadows, on: !on)
            }
            if key == Key::F4 {
                let on = s.frame.on(Off::Terrain)
                s.frame.set(Off::Terrain, on: !on)
                s.frame.changed(Change::Casters)
            }
            if let Some(system) = system {
                s.stage.off = s.stage.off.toggled(system)
                s.frame.changed(Change::Casters)
            }
        }
    }
}

pub fn frame(s: mut Floor, time: f32, width: u32, height: u32) {
    keys(mut s, time)
    hash_bake(mut s)
    s.stage.map.poll()
    s.snaps.update()
    // The play harness's report, each 2 s of the sim's time (`world::report`).
    let newest = s.snaps.newest()
    // The frames since the last report, beside it: the longest between two frames' times, and
    // how many came more than 33 ms after the last (the host's: not in the report itself, which
    // is the same in both hosts).
    let gap = (time - s.last_time) * 1000.0
    s.last_time = time
    if s.frame.frames > 0 {
        s.longest = max(s.longest, gap)
        if gap > 33.4 {
            s.slow += 1
        }
    }
    if newest.ticks / REPORT_TICKS != s.reported {
        s.reported = newest.ticks / REPORT_TICKS
        print(world::report(newest.snap, newest.ticks))
        print(
            f"{{\"frames\": {s.reported * 2}, \"longest_ms\": {s.longest:.1}, \"over_33ms\": {s.slow}}}",
        )
        s.longest = 0.0
        s.slow = 0
    }
    let b = s.snaps.at(s.snaps.sim_time(time))
    let pa = b.a.player
    let pb = b.b.player
    // The render origin follows the player (or a test's held camera), in whole blocks of tiles.
    let near_tile = match s.held {
        Some(h) => land::place::tile_of(h.0.xz),
        None => pa.at.tile,
    }
    let from = vec2(near_tile - s.stage.origin) * land::place::TILE
    let before = s.stage.origin
    let o_was = origin_of(s.stage)
    if max(abs(from.x), abs(from.y)) > RECENTRE {
        let k = f32(RECENTRE_STEP)
        let t = vec2i(round(vec2(near_tile) / k) * k)
        recentre(mut s, t)
    }
    let o = origin_of(s.stage)
    let o2 = o.xz
    // The player's feet in render space, exact however far it is (`Place::from_tile`).
    let feet2 = pa.at.from_tile(s.stage.origin) + pa.at.to(pb.at) * b.alpha
    let feet = vec3(feet2.x, mix(pa.y, pb.y, b.alpha), feet2.y)
    // Stepping into the door goes back down to the stair; the stair is got ready while nothing
    // of the floor's own streaming waits.
    s.exit.update(
        allowed: s.stage.fetching.is_empty() &&
            s.stage.cooking.is_empty() &&
            s.stage.wood.is_some(),
    )
    if s.exit.stepped_in(feet2 + o2) {
        let _ = s.exit.leave(feet2 + o2)
    }
    let c = pb.controls
    if s.stage.drawn.is_none() {
        s.stage.drawn = Some(drawn())
    }
    let heading = engine::present::lerp_angle(pa.heading, pb.heading, b.alpha)
    // A shot that casts the characters stands them where it says (in render space), and the
    // moving shadow map goes round them.
    let cast = if of_world(s.stage.view) { None } else { held_cast(s.shots.held) }
    let on_ground = |c: vec3| vec3(c.x, height_at(c.xy), c.y) - o
    let (stood, facing) = match cast {
        Some(c) => (on_ground(c.player), c.player.z),
        None => (feet, heading),
    }
    // The climber's figure, stepped by the frame's time where it stands (carried as it is when
    // the render origin moves), on the ground as a plane through its feet with the ground's slope
    // there, in the wind.
    s.dt = clamp(time - s.stepped, 0.0, 0.1)
    s.stepped = time
    let moved = s.stage.origin != before
    if moved {
        s.climber.carry(o_was - o)
    }
    let w_at = stood.xz + o2
    let slope = vec2(
        height_at(w_at + vec2(0.3, 0.0)) - height_at(w_at - vec2(0.3, 0.0)),
        height_at(w_at + vec2(0.0, 0.3)) - height_at(w_at - vec2(0.0, 0.3)),
    ) /
        0.6
    let gust = stage::wind(time)
    let breeze = vec3(gust.dir.x, 0.0, gust.dir.y) * (0.5 + if s.stage.still { 0.0 } else {
        1.5 * gust.strength
    })
    // In the fight (in play), its pose, its swings and its blink are the fight's climber's; out
    // of it, it glides, floating as it goes.
    let fc = b.b.fight.fight.climber
    let fighting = cast.is_none() && b.b.fight.awake
    let velocity = mix(pa.velocity, pb.velocity, vec2(b.alpha))
    let speed = length(velocity)
    s.drift = fract(s.drift + drift_rate(speed) * s.dt)
    // How fast the glide speeds up along the way it faces, and turns, eased over a tenth of a
    // second so a tick's step doesn't jolt the body's lean.
    if s.dt > 1.0e-4 && !moved {
        let ahead = land::player::facing(facing)
        let change = vec2(
            dot(velocity - s.glide_velocity, ahead) / s.dt,
            engine::present::lerp_angle(0.0, facing - s.glide_heading, 1.0) / s.dt,
        )
        s.glide_change += (change - s.glide_change) * (1.0 - exp(-s.dt / 0.1))
    }
    s.glide_velocity = velocity
    s.glide_heading = facing
    let pose = if fighting { fc.pose(b.alpha) } else {
        // The blade rises into its guard as a fight comes near (as the camera turns to it).
        locomotion(
            ready: s.focus,
            speed: speed,
            accel: s.glide_change.x,
            turning: s.glide_change.y,
            drift: s.drift,
        )
    }
    let gone = fighting && fc.gone()
    s.climber.step(
        stood,
        facing,
        pose,
        gone: gone,
        ground: Plane { at: stood, slope },
        wind: breeze,
        dt: s.dt,
    )
    match mut s.stage.drawn {
        Some(d) => d.write(s.climber, stood, facing, pose, gone: gone, still: moved),
        None => {},
    }
    // The fawn: where a shot casts it, standing at rest; in play (no shot held), the sim's,
    // between the two ticks round the frame, where it's near enough the player to be seen. The
    // wolf: in play, where it's as near.
    match cast {
        Some(c) => {
            s.stage.fawn.pose(
                fawns::at_rest(on_ground(c.fawn), c.fawn.z),
                shadowed: true,
                moved: moved,
            )
        },
        None => {
            let f = behaviour::between(b.a.fawn, b.b.fawn, b.alpha)
            let apart = length(f.walker.root.pos - (feet + o))
            if s.shots.held.is_none() && apart < FAWN_DRAWN {
                s.stage.fawn.pose(
                    behaviour::palette(f, o),
                    shadowed: apart < s.frame.quality().shadows.moving_span,
                    moved: moved,
                )
            } else {
                s.stage.fawn.hide()
            }
        },
    }
    let (wa, wb) = (b.a.fight.fight.wolf, b.b.fight.fight.wolf)
    let wolf_apart = length(wb.pos() - (feet + o).xz)
    if cast.is_none() && s.shots.held.is_none() && !b.b.fight.gone && wolf_apart < FAWN_DRAWN {
        let bones = wolf_bones(wa, wb, b.alpha, origin: o)
        s.stage.wolf.pose(
            bones,
            shadowed: wolf_apart < s.frame.quality().shadows.moving_span,
            moved: moved,
        )
    } else {
        s.stage.wolf.hide()
    }
    // The cloak bends contacting stems round its hem and along its train; it never clears or
    // lowers the grass roots.
    s.stage.grass.contact = match s.climber.train_end() {
        Some(end) if !gone => Contact { at: vec4(stood, HEM_RADIUS), tail: vec4(end, TRAIN_REACH) },
        _ => Contact {},
    }
    // The fawn's planted footprint, each its place and reach.
    let feet_of = |c: vec3, reach: f32| {
        let p = on_ground(c)
        vec4(p.x, p.z, reach, 0.0)
    }
    write(
        mut s.stage.footprints,
        0,
        match cast {
            Some(c) => [stage::OFF_MAP, feet_of(c.fawn, 0.35)],
            None => [stage::OFF_MAP, stage::OFF_MAP],
        },
    )
    let moving_at = match cast {
        Some(c) => 0.5 * (on_ground(c.player) + on_ground(c.fawn)),
        None => feet,
    }
    // The fight's focus, between the ticks, its weight eased in and out over `FOCUS_EASE`.
    let (fa, _) = encounter::focus(b.a.fight, (feet + o).xz)
    let (fb, wanted) = encounter::focus(b.b.fight, (feet + o).xz)
    s.focus_at = mix(fa, fb, vec3(b.alpha))
    s.focus += clamp(wanted - s.focus, -s.dt / FOCUS_EASE, s.dt / FOCUS_EASE)
    let ground_r = |p: vec2| height_at(p + o2)
    s.shots.clock(time, covered: s.frame.ready.arriving)
    let view = s.stage.view
    let shot_t = s.shots.since(time)
    let (eye, at, fovy) = match s.shots.held {
        Some(i) if view == BARE => {
            let shot = geology::SHOTS[i]
            let (e, a) = place(shot, shot_t, bare_at)
            (e - o, a - o, shot.fovy)
        },
        Some(i) if view == GROWN => {
            let shot = growth::SHOTS.shots[i]
            let (e, a) = place(shot, shot_t, grown_at)
            (e - o, a - o, shot.fovy)
        },
        Some(i) if view == SPECIMENS => {
            let shot = specimens::shots()[i]
            let (e, a) = place(shot, shot_t, level_at)
            (e - o, a - o, shot.fovy)
        },
        Some(i) => {
            let shot = lookbook::SHOTS[i]
            let (e, a) = place(shot, shot_t, height_at)
            (e - o, a - o, shot.fovy)
        },
        None => {
            let (e, a) = follow(
                mut s.arm,
                gap / 1000.0,
                s.framing,
                feet,
                yaw: c.yaw,
                pitch: c.pitch,
                focus: Focus { at: s.focus_at - o, weight: s.focus },
                o: OBSTACLES,
                o_from: o2,
                height: ground_r,
            )
            (e, a, s.framing.fovy)
        },
    }
    // A test's held camera (given in the world).
    let (eye, at) = match s.held {
        Some(h) => (h.0 - o, h.1 - o),
        None => (eye, at),
    }
    // The look in this view (the bare view's without dabs, the grown view's glowing more) and
    // its debug view of form.
    s.frame.look = look_of(view)
    s.frame.debug.view = look_view(view)
    let aim = Aim { eye, at, fovy, moving_at }
    let cam = s.frame.begin(mut s.stage, aim, time, width, height)
    // A click names what's under it: a tree's kind and history, or the ground's cover and fields.
    if let Some(px) = replace(mut s.clicked, None) {
        let size = vec2(f32(width), f32(height))
        if s.stage.source == SPECIMEN_LAND {
            print(provenance::click(s.stage.grounds, cam, px, size, level_at))
        } else if s.stage.source == GROWN_LAND {
            print(provenance::click(s.stage.grounds, cam, px, size, grown_at))
        } else {
            print(provenance::click(s.stage.grounds, cam, px, size, height_at))
        }
    }
    let wind = engine::frame::Scene::wind(s.stage, cam, time)
    // Where the eye is in the world, for what's kept by tiles.
    let eye_w = eye + o
    // ---- The floor's sound (sound.wrela): the ears at the eye, the steps at the feet, in the world.
    let heard_at = sound::moment(eye_w, cam.forward.xz, feet + o, s.stage.grounds, wind, time)
    sound::frame(mut s.hearing, heard_at)
    // The fight's sounds, while it's on (in play).
    let bout = b.b.fight
    if bout.awake && cast.is_none() {
        for c in cues(mut s.fight_heard, bout.fight) {
            sound::cue(mut s.hearing, c)
        }
    } else {
        s.fight_heard = heard(bout.fight)
    }
    // ---- (the floor's sound ends)
    // The leaves between the camera and the player fade (#54 §5); on a shot, those along the first
    // 6 m of its view (a shot's eye is authored, and may stand in a bush).
    let (clear_to, clear_r) = if s.shots.held.is_some() { (eye + cam.forward * 3.0, 3.2) } else {
        (feet + vec3(0.0, s.framing.target, 0.0), 1.1)
    }
    match mut s.stage.wood {
        Some(w) => w.clear = vec4(clear_to, clear_r),
        None => {},
    }
    s.stage.feet = feet.xz + o2
    s.stage.heading = heading
    s.frame.draw(mut s.stage, aim)
    if !s.ready &&
        s.stage.wood.is_some() &&
        s.stage.fetching.is_empty() &&
        s.stage.arrived.is_empty() &&
        s.frame.sky.done() {
        s.ready = true
        print(f"the floor ready at frame {s.frame.frames - 1}")
    }
    let loaded = match s.stage.wood {
        Some(w) => w.loaded(),
        None => 0,
    }
    if (s.frame.frames - 1) % 60 == 0 {
        print(
            f"frame {s.frame.frames - 1}: the player at {feet.x + o.x:.1}, {feet.z + o.z:.1}; {s.stage.tiles_in} tiles come, {loaded} instances loaded",
        )
    }
    // A tile the player can see whose own trees aren't placed yet (#55 AC7's tiles on time):
    // within the cards' reach of the eye (past it, the far layer's crowns stand for them). Not
    // for 3 s after the eye jumps (a travel, a lookbook shot: not a pace streaming holds).
    if s.frame.jumped {
        s.settle_until = s.frame.frames + 180
    }
    if s.frame.ready.playable && s.frame.frames >= s.settle_until {
        late_tiles(mut s, eye_w.xz)
    }
    if !s.frame.ready.arriving {
        s.console.presented()
    }
    if s.console.returning {
        let bytes = save(s.exit.journey.carry)
        s.console.save_and_return(SAVE, bytes)
    }
}

/// The bake as this host reads it (#55 AC2's same bytes in both hosts), once F9 has fetched all
/// its files: each file's hash (`std::hash::Hasher`: its name, then its length and its bytes,
/// eight to a word), summed, printed.
fn hash_bake(s: mut Floor) {
    for i in 0..s.hashing.len() {
        match s.hashing[i].poll() {
            Some(Ok(b)) => {
                var h = std::hash::Hasher::new()
                h.write_str(BAKED.name(i))
                h.write_u32(b.len())
                var word: u64 = 0
                var k = 0
                for j in 0..b.len() {
                    word = word | (u64(b[j]) << (8 * k))
                    k += 1
                    if k == 8 {
                        h.write_u64(word)
                        word = 0
                        k = 0
                    }
                }
                if k > 0 {
                    h.write_u64(word)
                }
                s.hash_sum = s.hash_sum.wrapping_add(h.finish())
                s.hashed += vec3u(1, b.len(), 0)
            },
            Some(Err(_)) => {
                print(f"a file of the bake didn't come: {BAKED.name(i)}")
                s.hashed += vec3u(1, 0, 1)
            },
            None => {},
        }
    }
    if !s.hashing.is_empty() && s.hashed.x == s.hashing.len() {
        print(
            f"the bake's bytes: {s.hashed.x} files, {s.hashed.y} bytes, hash {s.hash_sum}, {s.hashed.z} missing",
        )
        s.hashing = Vec::new()
    }
}

/// The cast of the lookbook's shot the camera's held on (`shot`), if it casts the characters.
fn held_cast(shot: Option<u32>) -> Option<lookbook::Cast> {
    match shot {
        Some(i) if i < lookbook::SHOTS.len() && lookbook::SHOTS[i].cast != NO_CAST => Some(
            lookbook::CASTS[lookbook::SHOTS[i].cast],
        ),
        _ => None,
    }
}

/// Prints each tile within `CARDS_TO` of the eye whose own trees aren't placed: late (once).
fn late_tiles(s: mut Floor, eye: vec2) {
    let Some(w) = s.stage.wood else { return }
    let at = land::place::tile_of(eye)
    for j in (at.y - 1)..(at.y + 2) {
        for i in (at.x - 1)..(at.x + 2) {
            let t = vec2i(i, j)
            var told = false
            for l in s.late {
                told = told || l == t
            }
            if tile_distance(t, eye) < CARDS_TO && w.slot_of(t).is_none() && !told {
                s.late.push(t)
                print(f"late tile {t.x}, {t.y} at frame {s.frame.frames - 1}")
            }
        }
    }
}

// ---- tests ---------------------------------------------------------------------------------------

@test
fn a_lookbook_move_waits_for_its_loaded_view() {
    let shot = lookbook::SHOTS[0]
    var started = 0.0
    let flat = |_: vec2| 0.0
    let (first, _) = place(shot, 0.0, flat)
    // A long load exceeds the old fixed five-second preroll but must not advance the shot.
    for i in 0..601 {
        let time = f32(i) / 60.0
        started = shot_clock(started, time, covered: true)
        let (eye, _) = place(shot, time - started, flat)
        assert(eye == first, "the shot moved before its arrival was ready")
    }
    let time = started + SETTLE + MOVE * 0.5
    started = shot_clock(started, time, covered: false)
    let (eye, _) = place(shot, time - started, flat)
    assert(
        length(eye.xz - first.xz - shot.moves * 0.5) < 0.0001,
        "the shot did not resume its authored motion after readiness",
    )
}

