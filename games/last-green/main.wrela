/// The camera held at `eye`, looking at `at` (instead of the player's or a shot's).
@testing
pub fn test_hold(s: mut Floor, eye: vec3, at: vec3) {
    s.held = Some((eye, at))
}

/// What the last frame drew (`testing::Capture`), copied into a new buffer (the newest), and how
/// many elements.
@testing
pub fn test_capture(s: mut Floor, what: testing::Capture) -> u32 {
    borrow t = s.frame.targets
    match what {
        testing::Capture::Depth => {
            let n = u32(s.frame.cam.screen.x) * u32(s.frame.cam.screen.y)
            s.captured = buffer(n)
            dispatch(testing::copy_depth.bind(t.depth, out: mut s.captured), over: n)
            n
        },
        testing::Capture::Tags => {
            let n = t.history.width() * t.history.height()
            s.captured = buffer(n)
            dispatch(testing::copy_tags.bind(t.history, out: mut s.captured), over: n)
            n
        },
        testing::Capture::Exposure => {
            s.captured_exposure = buffer(1)
            std::gpu::copy(from: s.frame.exposure.items(), to: s.captured_exposure.items_mut())
            1
        },
    }
}

/// The camera the last frame was drawn by.
pub struct CameraReport: Copy {
    pub eye: vec3,
    pub forward: vec3,
    pub right: vec3,
    pub up: vec3,
    pub tan_half: f32,
    pub aspect: f32,
    pub near: f32,
    pub jitter: vec2,
    pub screen: vec2,
}

@testing
pub fn test_camera(s: Floor) -> CameraReport {
    let c = s.frame.cam
    CameraReport {
        // In the world (the render origin added back).
        eye: c.eye + c.origin,
        forward: c.forward,
        right: c.right,
        up: c.up,
        tan_half: c.tan_half,
        aspect: c.aspect,
        near: c.near,
        jitter: c.jitter,
        screen: c.screen,
    }
}

/// The ground's height at (x, z), as the floor draws it.
@testing
pub fn test_ground(x: f32, z: f32) -> f32 {
    height_at(vec2(x, z))
}

/// Whether the floor round the camera's eye has settled: the light round it drawn (`lit`: a
/// full frame there, the tiles round it placed, the near shadows drawn, the probes baked round
/// where the eye is, not where it was), nothing streaming in, the characters shown realized, and
/// no arrival under way.
@testing
pub fn test_settled(s: Floor) -> f32 {
    let eye = s.frame.cam.eye.xz
    let still = !engine::frame::Scene::loading(s.stage) &&
        (!s.stage.fawn.on || s.stage.fawn.realized.is_some()) &&
        (!s.stage.wolf.on || s.stage.wolf.realized.is_some()) &&
        !s.frame.ready.arriving
    if still && s.frame.lit(s.stage, eye, eye + s.frame.cam.origin.xz) { 1.0 } else { 0.0 }
}

/// Whether the floor's ready: its kinds cooked and the tiles round the player in and placed.
@testing
pub fn test_ready(s: Floor) -> f32 {
    let placed = s.stage.wood.is_some() &&
        s.stage.tiles_in > 0 &&
        !engine::frame::Scene::loading(s.stage)
    if placed { 1.0 } else { 0.0 }
}

/// The `i`th living tree placed near the player (of the tiles' own, not the far layer): its
/// crown's middle (where its levels' patterns are anchored), and its height.
@testing
pub fn test_crown(s: Floor, i: u32) -> vec4 {
    var k = 0
    for a in s.stage.own {
        for p in a.placed {
            if p.kind < trees::KINDS && p.kind != trees::GREAT {
                if k == i {
                    let top = s.stage.plants[p.kind].top() * p.at.scale
                    return vec4(p.at.at + vec3(0.0, top * 0.5, 0.0), top)
                }
                k += 1
            }
        }
    }
    vec4(0.0, 0.0, 0.0, -1.0)
}

/// The floor's first frames run on the native host's GPU, its tiles fetched.
@test(frames: 40, gpu: true)
fn the_first_frames_run(s: Floor) {
    assert(s.frame.frames == 40, f"{s.frame.frames} frames drawn")
}

/// The fight's ground (`fought`) is worn over its disc and the wolf's way out to the trail, and
/// nowhere else; its edge is ragged, not a circle.
@test
fn the_fight_wears_its_disc_and_the_way_out() {
    let c = FIGHT.xy
    assert(fought(c, 0.0) > 0.99, "the disc's middle is worn")
    assert(fought(FIGHT_WAY.xy, 0.0) > 0.99, "where the wolf waits is worn")
    assert(fought(FIGHT_WAY.zw, 0.0) > 0.99, "where the trail comes in is worn")
    assert(fought(c + vec2(0.0, -FIGHT.z - 4.0), 0.0) == 0.0, "the wood's side past it is not")
    assert(fought(FIGHT_WAY.zw + vec2(6.0, 0.0), 0.0) == 0.0, "nor the trail beyond")
    assert(fought(FIGHT_WAY.zw + vec2(0.0, 7.0), 0.0) == 0.0, "nor the glade beside the way")
    // Where the wear falls through a half, round the disc away from the way: a ragged edge.
    var near = 100.0
    var far = 0.0
    for i in 0..48 {
        let a = 2.2 + 4.3 * f32(i) / 48.0
        let d = vec2(cos(a), sin(a))
        var r = 0.0
        while fought(c + d * r, 0.0) > 0.5 && r < 20.0 {
            r += 0.05
        }
        near = min(near, r)
        far = max(far, r)
    }
    assert(near > FIGHT.z - 1.5 && far < FIGHT.z + 2.0, f"the edge from {near} m to {far} m")
    assert(far - near > 0.8, f"the edge a circle: {near} m to {far} m")
}

/// No trail wears under a built stone (`unbuilt`): none on a stone's foot, all of it a margin
/// past it, and every stone of the floor counted.
@test
fn trails_stop_at_built_stones() {
    var n = 0
    for s in STONE_FEET {
        if s.x < 1.0e8 {
            n += 1
            assert(unbuilt(s.xy) == 0.0, f"a trail wears under the stone at {s.xy}")
            let out = s.xy + vec2(s.z + STONE_MARGIN + 0.01, 0.0)
            assert(unbuilt(out) > 0.0, f"no trail beside the stone at {s.xy}")
        }
    }
    assert(n == stones::stones(map::map()).len(), f"{n} stones' feet kept")
    assert(unbuilt(vec2(0.0, 30.0)) == 1.0, "a trail away from the stones stopped")
}
