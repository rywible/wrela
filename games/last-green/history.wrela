// The floor's history (#54 §3): the map grown by `engine::grow`, at the bake's grain (2 m cells,
// 2-year steps), over the authored square and a margin; baked as a file a tile (`engine::bake`),
// shipped beside the program, and cached by the build while the map and the code it runs are
// unchanged (language.md §10). And the preview, the same history at the preview's grain (4 m
// cells, 10-year steps), for the map lens after each edit.

use engine::bake::{bake, unbake}
use engine::footing::{Obstacles, obstacles_of, walkable_of}
use engine::grow::{BAKE, Grain, Grid, History, Land, PREVIEW, Start, simulate, world}
use peoples::{Culture, Use, left_by, settle, told}
use engine::interest::{Evidence, FULL, Sight, check, nearest_first, report, views_bytes, walk_bytes}
use engine::place::{Kind, Map, TILE, tile_of}
use engine::water::Laid
use std::io::{Shipped, print, ship}
use std::string::String

/// The history's domain: the authored square and a margin, so the square's edges grow as its
/// middle does.
pub const MARGIN: f32 = 64.0

pub fn domain_lo() -> vec2 {
    map::LO - vec2(MARGIN)
}

pub fn domain_hi() -> vec2 {
    map::HI + vec2(MARGIN)
}

/// The tiles the floor streams in: those the authored square touches.
pub fn tiles_lo() -> vec2i {
    tile_of(map::LO)
}

pub fn tiles_hi() -> vec2i {
    tile_of(map::HI - vec2(0.01))
}

/// What the herd walks round: the floor's stones.
pub fn rocks() -> Vec<vec3> {
    stones::stones(map::map())
}

/// The history at a grain.
pub fn grown(grain: Grain) -> History {
    let m = map::map()
    simulate(
        ground::GROUND,
        m,
        species::HABITS,
        grain,
        domain_lo(),
        domain_hi(),
        rocks(),
        past,
    )
}

/// What the floor's past left the land as in `year`, when its history begins: the elves'
/// (`peoples`), who lived there five centuries until the plague.
pub fn past(land: Land, year: i32) -> Start {
    let elves = Culture {}
    var p = settle(land, elves, year - ELVES_LIVED, year)
    // The floor's wood pasture is the old wood they grazed under: it stands as it was, whatever
    // else they used the land round it for.
    let m = map::map()
    for c in 0..p.grid.cells() {
        if m.regions[m.region_of(p.grid.centre(c))].kind == Kind::WoodPasture {
            p.last[c] = u8(u32(Use::Wild))
        }
    }
    let s = left_by(p, land, species::HABITS, elves, year, world(m))
    print(told(p, s, land))
    s
}

/// How long the elves lived on the floor's land before the plague (years).
pub const ELVES_LIVED: i32 = 500

/// The bake: the floor's decisions, a file a tile and the far layer. Computed when the game is
/// built, on every core, and kept between builds while nothing it reads changes.
@fuel(2 ** 43)
pub const BAKED: Shipped = ship("floor", bake(forked(grown(BAKE)), tiles_lo(), tiles_hi()))

/// The history with each standing tree's fork chosen among its neighbours (`trees::forked`).
pub fn forked(h: take History) -> History {
    let all = h.trees.clone()
    History { trees: trees::forked(take all), ..h }
}

/// The bake read back: the floor's decisions.
pub fn decisions() -> engine::bake::Unbaked {
    unbake(BAKED, tiles_lo(), tiles_hi())
}

/// Raw fallen-tree records retained in the program. Shipped bytes can only be read at build
/// time; runtime collision jobs select these small tile lists and fit only nearby wood.
struct FallenTiles {
    lo: vec2i,
    n: vec2u,
    trees: Vec<Vec<engine::grow::Tree>>,
}

const FALLEN: FallenTiles = fallen_tiles(decisions().trees, tiles_lo(), tiles_hi())

fn fallen_tiles(trees: [engine::grow::Tree], lo: vec2i, hi: vec2i) -> FallenTiles {
    let n = vec2u(hi - lo + vec2i(1))
    var by_tile: Vec<Vec<engine::grow::Tree>> = Vec::from_fn(n.x * n.y, |_| Vec::new())
    for tree in trees {
        if tree.state == engine::grow::State::Log {
            let at = tile_of(tree.at) - lo
            if at.x >= 0 && at.y >= 0 && at.x < i32(n.x) && at.y < i32(n.y) {
                by_tile[u32(at.y) * n.x + u32(at.x)].push(tree)
            }
        }
    }
    FallenTiles { lo, n, trees: by_tile }
}

impl FallenTiles {
    fn at(self, tile: vec2i) -> Vec<engine::grow::Tree> {
        let at = tile - self.lo
        if at.x < 0 || at.y < 0 || at.x >= i32(self.n.x) || at.y >= i32(self.n.y) {
            return Vec::new()
        }
        self.trees[u32(at.y) * self.n.x + u32(at.x)].clone()
    }
}

pub fn fallen_in(tile: vec2i) -> Vec<engine::grow::Tree> {
    FALLEN.at(tile)
}

@test
fn authored_raw_logs_are_retained_in_their_runtime_tiles() {
    let log = engine::grow::Tree {
        at: vec2(1.0),
        kind: 0,
        born: 0,
        tall: 10.0,
        reach: 2.0,
        lean: vec2(0.0),
        girth: 0.4,
        light: 1.0,
        vigour: 1.0,
        state: engine::grow::State::Log,
        died: 10,
        fell: 11,
        fall: vec2(0.0, 1.0),
        cause: engine::grow::Cause::Wind,
        pinned: false,
        shaped: 0,
        lift: 0.0,
        fork: 0.0,
        seed: 1,
    }
    let next = engine::grow::Tree { at: vec2(TILE + 1.0, 1.0), seed: 2, ..log }
    let standing = engine::grow::Tree { state: engine::grow::State::Alive, ..log }
    let indexed = fallen_tiles([log, next, standing], vec2i(0), vec2i(1, 0))
    assert(
        indexed.at(vec2i(0)).len() == 1 && indexed.at(vec2i(0))[0].seed == 1,
        "runtime tile lost its log or retained a standing tree",
    )
    assert(
        indexed.at(vec2i(1, 0)).len() == 1 && indexed.at(vec2i(1, 0))[0].seed == 2,
        "runtime log tile indexed the wrong root",
    )
    assert(indexed.at(vec2i(-1, 0)).is_empty(), "outside tile returned authored wood")
}

/// Coarse whole-floor collision for creatures and sight, from the bake: its trunks (as they're drawn: `trees::as_drawn`),
/// thorn, big logs and streams, and the floor's stones and walls. In the program (the sim's collision is the same in every host and
/// every replay, wherever the tiles have streamed to).
pub const OBSTACLES: Obstacles = obstacles(decisions())

fn obstacles(u: engine::bake::Unbaked) -> Obstacles {
    let m = map::map()
    obstacles_of(
        trees::as_drawn(u.trees),
        species::HABITS,
        u.streams,
        stones::stones(m),
        stones::walls(m),
        domain_lo(),
        domain_hi(),
    )
}

/// The water (`engine::water`): the map's meres, springs and falls, and the bake's streams. Its
/// fall paths search the ground's relief (the rock's joints and beds), past the build's default fuel.
@fuel(2 ** 36)
pub const COURSES: Courses = courses_of(decisions())

/// The water's courses and pools (`engine::water::courses`): small, so the program holds them;
/// its mesh is laid from them when the program starts (`waters`), not shipped in it.
pub struct Courses: Clone {
    pub courses: Vec<engine::water::Course>,
    pub pools: Vec<vec4>,
}

fn courses_of(u: engine::bake::Unbaked) -> Courses {
    let (courses, pools) = engine::water::courses(ground::GROUND, map::map().water, u.streams)
    Courses { courses, pools }
}

/// Where the falls' mist hangs (`engine::water::mists`).
pub const MISTS: Vec<vec4> = engine::water::mists(ground::GROUND, COURSES.courses)

/// The water laid (`engine::water`): its courses and pools, and its mesh, laid over the ground.
pub fn waters() -> Laid {
    let mesh = engine::water::lay(
        ground::GROUND,
        map::map().water,
        COURSES.courses,
        COURSES.pools,
    )
    Laid { courses: COURSES.courses.clone(), pools: COURSES.pools.clone(), mesh }
}

/// The play harness's map: metres a pixel.
pub const MAP_PX: f32 = 4.0

// The walk's mask tests steep cells at five points (`footing::walkable_of`).
/// The interest check on the bake (#54 §4): its report (`report.json`) and its views
/// (`views.bin`), shipped for the map lens and the floor's tests; and the map with the check
/// (`map.bin`, `interest::map_image`), which the play harness shows (M).
@fuel(2 ** 43)
pub const CHECKED: Shipped = ship("check", checked())

fn checked() -> Vec<(String, Vec<u8>)> {
    let u = decisions()
    let m = map::map()
    let fields = Grid::over(u.wear_grid.lo, u.wear_grid.hi(), 2.0)
    var e = Evidence::of_decisions(
        take u.trees,
        species::HABITS,
        map::PRESENT,
        fields,
        u.wet_grid,
        take u.wet,
        u.wear_grid,
        take u.wear,
    )
    // The crowns the renderer draws, and what's built (AC3's calibration).
    e.crowns = trees::drawn_crowns(e.trees)
    e.solids = blockouts::solids(m)
    let c = check(ground::GROUND, m, species::HABITS, e, OBSTACLES, stones::stones(m), FULL)
    let text = report(ground::GROUND, m, c)
    // The floor's walk, on a walkable mask a metre a cell that knows the logs, walls and
    // thickets (the check's sight grid, 4 m a cell, doesn't), and the fallen wood a player
    // can't cross as the sim fits it (`solid_wood`).
    var mask = walkable_of(ground::GROUND, m.water, OBSTACLES, map::LO, map::HI, 1.0)
    mask.without(solid_wood(decisions().trees))
    let (walk, missed) = mask.tour(nearest_first(tour_stops()), 2.0)
    print(f"the floor's walk: {walk.len()} points; {missed.len()} stops it can't reach")
    for p in missed {
        print(f"  can't reach {p}")
    }
    // What a player can walk to from the gate on the fine mask: each critical site (within its
    // reach) and each relation's viewpoint (within its reach).
    let gate = engine::interest::gate_of(m)
    let reached = mask.reached_from(gate)
    var reach = String::from("{\n  \"sites\": [\n")
    var first = true
    for k in m.sites {
        if engine::interest::critical(k) {
            let ok = mask.reaches(reached, k.at, k.reach + 2.0)
            let sep = if first { "" } else { ",\n" }
            reach.push_str(f"{sep}    {{\"name\": \"{k.name}\", \"reached\": {ok}}}")
            first = false
        }
    }
    reach.push_str("\n  ],\n  \"relations\": [\n")
    first = true
    for r in m.relations {
        let ok = mask.reaches(reached, r.from(), r.within())
        let sep = if first { "" } else { ",\n" }
        reach.push_str(f"{sep}    {{\"name\": \"{r.name()}\", \"reached\": {ok}}}")
        first = false
    }
    reach.push_str("\n  ]\n}\n")
    let cal = calibration(c, m, mask)
    // Each lookbook shot's numbers (#54 §9): the check's view at its eye.
    var shots = String::from("[\n")
    for i in 0..lookbook::SHOTS.len() {
        let shot = lookbook::SHOTS[i]
        let v = engine::interest::view_at(c.sight, m, FULL, shot.eye.xz)
        let (seen, clear) = shot_valid(c.sight, shot)
        let sep = if i == 0 { "" } else { ",\n" }
        shots.push_str(
            f"{sep}  {{\"shot\": \"{shot.name}\", \"seen\": {seen}, \"clear\": {clear}, \"view\": {engine::interest::view_json(m, v)}}}",
        )
        if seen < SHOT_SEEN || clear < SHOT_CLEAR {
            print(
                f"shot {i} ({shot.name}): its subject {seen} seen, the eye {clear} m from a trunk",
            )
            let (eye, best) = clearest_eye(c.sight, shot)
            print(f"  the clearest eye near: ({eye.x}, {eye.y}), its subject {best} seen")
        }
    }
    shots.push_str("\n]\n")
    var tour_bytes: Vec<u8> = Vec::new()
    for p in walk {
        engine::bake::put_u32(mut tour_bytes, bitcast_u32(p.x))
        engine::bake::put_u32(mut tour_bytes, bitcast_u32(p.y))
    }
    Vec::from(
        [
            (String::from("report.json"), Vec::from(text.as_bytes())),
            (String::from("views.bin"), views_bytes(m, c, FULL)),
            (String::from("map.bin"), engine::interest::map_image(m, c, FULL, MAP_PX)),
            (String::from("walk.bin"), walk_bytes(c)),
            (String::from("tour.bin"), take tour_bytes),
            (String::from("reach.json"), Vec::from(reach.as_bytes())),
            (String::from("calibration.json"), Vec::from(cal.as_bytes())),
            (String::from("shots.json"), Vec::from(shots.as_bytes())),
        ],
    )
}

/// The fallen wood a player can't cross: each log's capsules as the sim fits them round the
/// player (`logs::obstacles`), as it meets them (`solid_colliders`). `OBSTACLES` holds only the
/// thicker logs, and coarsely: a way planned without these led the floor's walk into a log on a
/// slope it can't go round.
fn solid_wood(trees: [engine::grow::Tree]) -> Obstacles {
    var parts: Vec<WoodPart> = Vec::new()
    for t in trees {
        if t.state == engine::grow::State::Log {
            if parts.is_empty() || parts[parts.len() - 1].logs.len() == 256 {
                parts.push(WoodPart { logs: Vec::new(), solid: Vec::new() })
            }
            parts[parts.len() - 1].logs.push(t)
        }
    }
    parts.par_each_mut(|part| {
        borrow g = ground::GROUND
        part.solid = solid_colliders(
            logs::obstacles(part.logs, |at: vec2| engine::grow::Ground::height(g, at.x, at.y)),
        )
    })
    var all: Vec<engine::footing::Obstacle> = Vec::new()
    for mut part in parts {
        all.append(mut part.solid)
    }
    Obstacles::of(all, domain_lo(), domain_hi())
}

/// The colliders a player meets for fitted log capsules `capsules`, as the sim makes them: each
/// a local answer's circle round it (`wildwood::log_circle`, `world::answered`), those the
/// travel can't cross (higher than its clearance).
fn solid_colliders(capsules: [engine::footing::Obstacle]) -> Vec<engine::footing::Obstacle> {
    var out: Vec<engine::footing::Obstacle> = Vec::new()
    for o in capsules {
        let c = world::answered(wildwood::log_circle(o))
        if !c.cleared(world::TRAVEL.clearance) {
            out.push(c)
        }
    }
    out
}

/// Fallen trees, and the solid wood of theirs that `solid_wood` finds, a helper's share.
struct WoodPart {
    logs: Vec<engine::grow::Tree>,
    solid: Vec<engine::footing::Obstacle>,
}

/// A shot's least share of its subject seen (`interest::transmit` from its eye to what it looks
/// at, through the crowns and trunks as drawn) and its eye's least clearance from a trunk (m), at
/// its move's start, middle and end. (The town's eye stood inside a trunk: the lookdev reviews.)
pub fn shot_valid(s: Sight, shot: lookbook::Shot) -> (f32, f32) {
    eye_valid(s, shot, shot.eye.xz)
}

/// `shot_valid` for `shot` with its eye moved to `from` (its move the same).
fn eye_valid(s: Sight, shot: lookbook::Shot, from: vec2) -> (f32, f32) {
    var seen = 1.0
    var clear = 99.0
    for k in 0..3 {
        let e = from + shot.moves * (f32(k) * 0.5)
        let eye = vec3(e.x, engine::interest::ground_at(s, e) + shot.eye.y, e.y)
        let at = vec3(shot.at.x, engine::interest::ground_at(s, shot.at.xz) + shot.at.y, shot.at.z)
        seen = min(seen, engine::interest::transmit(s, eye, at, shot.reach))
        clear = min(clear, engine::interest::trunk_clearance(s, e))
    }
    (seen, clear)
}

/// The least a shot's subject is seen, and the least its eye clears a trunk by (m).
pub const SHOT_SEEN: f32 = 0.35
pub const SHOT_CLEAR: f32 = 1.0

/// The eye for `shot` that sees its subject best through its move, at 0.6 to 1.4 times its
/// distance from it, all round, clear of trunks by 2.5 m; nearer its own distance on a tie.
fn clearest_eye(s: Sight, shot: lookbook::Shot) -> (vec2, f32) {
    let at = shot.at.xz
    let dist = max(length(shot.eye.xz - at), 8.0)
    var best = vec2(0.0)
    var score = -1.0
    var got = 0.0
    for r in 0..5 {
        let d = dist * (0.6 + 0.2 * f32(r))
        for a in 0..48 {
            let ang = 6.2831855 * f32(a) / 48.0
            let e = at + vec2(cos(ang), sin(ang)) * d
            if !s.grid.holds(e) {
                continue
            }
            let (seen, clear) = eye_valid(s, shot, e)
            if clear < 2.5 {
                continue
            }
            let sc = seen - 0.05 * abs(d - dist) / dist
            if sc > score {
                score = sc
                best = e
                got = seen
            }
        }
    }
    (best, got)
}

/// AC3's calibration: how many places, how far out the model's sight is judged (m), and the views
/// all round each place it's judged in (each a sixth of the circle).
const CAL_PLACES: u32 = 24
const CAL_DIST: f32 = 40.0
const CAL_VIEWS: u32 = 6

/// What the renderer checks the model against (`calibration.json`, suite/last_green.rs): at
/// `CAL_PLACES` places spread over the floor (a lattice over its square, each point moved to the
/// nearest place a player can stand: the same places from one edit of the map to the next), how
/// much of the level view all round at the check's eye gets `CAL_DIST` out
/// (`interest::seen_beyond`, in `CAL_VIEWS` views); and for each landmark relation, the eye it's
/// judged from (`interest::relation_view`), its draw there, and its site (a crag's, its rock as
/// wide as its foot).
fn calibration(
    c: engine::interest::Checked,
    m: engine::place::Map,
    mask: engine::footing::Walkable,
) -> String {
    borrow g = ground::GROUND
    var out = String::from(
        f"{{\n  \"eye\": {FULL.eye},\n  \"dist\": {CAL_DIST},\n  \"views\": {CAL_VIEWS},\n  \"places\": [\n",
    )
    var found = 0
    for k in 0..CAL_PLACES {
        // A point of a 6 by 4 lattice; off the floor, moved toward its middle until it's on.
        var q = map::LO +
            (map::HI - map::LO) * (vec2(f32(k % 6), f32(k / 6)) + vec2(0.5)) / vec2(6.0, 4.0)
        var cell = mask.nearest(q)
        var tries = 0
        while (cell == engine::grow::NONE || !m.inside(mask.grid.centre(cell))) && tries < 8 {
            q = mix(q, 0.5 * (map::LO + map::HI), vec2(0.25))
            cell = mask.nearest(q)
            tries += 1
        }
        let p = mask.grid.centre(cell)
        // Its views' ways, turned from one place to the next (the golden angle).
        let yaw = 2.3999632 * f32(found)
        let half = 3.1415927 / f32(CAL_VIEWS)
        var seen = 0.0
        for v in 0..CAL_VIEWS {
            let a = yaw + 2.0 * half * f32(v)
            seen += engine::interest::seen_beyond(c.sight, p, a, half, CAL_DIST, FULL.eye)
        }
        seen = seen / f32(CAL_VIEWS)
        let y = engine::grow::Ground::height(g, p.x, p.y)
        let sep = if found == 0 { "" } else { ",\n" }
        out.push_str(
            f"{sep}    {{\"at\": [{p.x}, {p.y}], \"ground\": {y}, \"yaw\": {yaw}, \"seen\": {seen}}}",
        )
        found += 1
    }
    out.push_str("\n  ],\n  \"landmarks\": [\n")
    var first = true
    for r in m.relations {
        let landmark = match r {
            engine::place::Relation::Seen { landmark, .. } => landmark,
            _ => false,
        }
        if !landmark {
            continue
        }
        let (eye, draw) = engine::interest::relation_view(c.sight, m, FULL, r)
        let k = m.sites[r.to()]
        let e = vec3(eye.x, engine::grow::Ground::height(g, eye.x, eye.z) + FULL.eye, eye.z)
        let base = engine::grow::Ground::height(g, k.at.x, k.at.y)
        // Where the eye looks: a crag's top (its relief is the ground's), another's middle.
        let aim = if k.feature == engine::place::Feature::Crag { base + 1.0 } else {
            base + 0.6 * k.tall
        }
        // A crag's rock reaches as wide as its foot: the land's crag there.
        var reach = k.reach
        for cr in m.land.crags {
            if cr.w > 0.0 && length(cr.xy - k.at) < 5.0 {
                reach = cr.w
            }
        }
        let sep = if first { "" } else { ",\n" }
        out.push_str(
            f"{sep}    {{\"name\": \"{r.name()}\", \"eye\": [{e.x}, {e.y}, {e.z}], \"draw\": {draw}, \"site\": [{k.at.x}, {k.at.y}], \"aim\": {aim}, \"reach\": {reach}}}",
        )
        first = false
    }
    // AC10's trails: along the critical path's routes (the road and the trails), a place every
    // `TRAIL_EVERY` m, its eye on the route, and 20 m on, where the trodden line runs across it
    // (`bake::path_at`: the route's line, wandering) and the way across.
    out.push_str("\n  ],\n  \"trails\": [\n")
    first = true
    var all: Vec<u32> = Vec::new()
    for k in 0..m.routes.len() {
        all.push(k)
    }
    for k in 0..m.routes.len() {
        borrow r = m.routes[k]
        if r.kind == engine::place::RouteKind::Herd {
            continue
        }
        let len = r.length()
        var s = 30.0
        while s + 20.0 < len - 10.0 {
            let eye = r.along(s)
            let on = r.along(s + 20.0)
            let across = vec2(-on.w, on.z)
            // The trodden line's middle across the route's there: the middle of where it's most
            // trodden (its tread).
            var tread = [0.0; 81]
            var best = 0.0
            for i in 0..81 {
                let q = on.xy + across * (f32(i) * 0.1 - 4.0)
                tread[i] = engine::bake::path_at(m.routes, all, q, used: 1.0)
                best = max(best, tread[i])
            }
            var sum = vec2(0.0)
            var n = 0.0
            for i in 0..81 {
                if tread[i] >= 0.95 * best {
                    sum += on.xy + across * (f32(i) * 0.1 - 4.0)
                    n += 1.0
                }
            }
            let centre = sum / max(n, 1.0)
            if best > 0.5 && m.inside(eye.xy) && m.inside(centre) {
                let sep = if first { "" } else { ",\n" }
                out.push_str(
                    f"{sep}    {{\"route\": \"{r.name}\", \"eye\": [{eye.x}, {eye.y}], \"centre\": [{centre.x}, {centre.y}], \"across\": [{across.x}, {across.y}]}}",
                )
                first = false
            }
            s += TRAIL_EVERY
        }
    }
    out.push_str("\n  ]\n}\n")
    out
}

/// How far apart the trails' places are (m) along each route.
const TRAIL_EVERY: f32 = 80.0

/// What the floor's walk passes (#55's Method): the gate first; the critical path's sites,
/// each region's middle, the water (the mere's shore, the stream, the fall's lip) and each
/// lookbook place.
fn tour_stops() -> Vec<vec2> {
    let m = map::map()
    var out: Vec<vec2> = Vec::from([engine::interest::gate_of(m)])
    for k in m.sites {
        if engine::interest::critical(k) {
            out.push(k.at)
        }
    }
    for r in m.regions {
        out.push(r.at)
    }
    let mere = m.water.meres[0]
    out.push(mere.xy + vec2(0.0, mere.z * 1.15))
    out.push(m.water.falls[0] + vec2(18.0, -12.0))
    for s in lookbook::SHOTS {
        out.push(s.eye.xz)
    }
    var inside: Vec<vec2> = Vec::new()
    for p in out {
        if m.inside(p) {
            inside.push(p)
        }
    }
    inside
}

/// The check's views (`views.bin`): each place's strongest draw, a byte (0 to 1 as 0 to 254;
/// 255 where a player can't stand), over `VIEWS_GRID`, for the play harness's report.
pub const VIEWS: Vec<u8> = views_of(CHECKED)
pub const VIEWS_GRID: Grid = engine::interest::views_grid(map::map(), FULL)

fn views_of(files: Shipped) -> Vec<u8> {
    borrow b = files.bytes(files.find("views.bin").unwrap())
    var out: Vec<u8> = Vec::with_capacity(b.len() - 8)
    for k in 8..b.len() {
        out.push(b[k])
    }
    out
}

/// The strongest draw at `p` by the check (0 to 1), or -1 where a player can't stand or off the
/// map's square.
pub fn draw_at(p: vec2) -> f32 {
    if !VIEWS_GRID.holds(p) {
        return -1.0
    }
    let b = VIEWS[VIEWS_GRID.cell_at(p)]
    if b == 255 { -1.0 } else { f32(b) / 254.0 }
}

/// The floor's walk (#55's Method): a point every 2 m or so on the way from the gate past
/// `tour_stops`, worked out on the walkable mask (shipped with the check, `tour.bin`).
pub const TOUR: Vec<vec2> = tour_of(CHECKED)

fn tour_of(files: Shipped) -> Vec<vec2> {
    borrow b = files.bytes(files.find("tour.bin").unwrap())
    var out: Vec<vec2> = Vec::new()
    var k = 0
    while k + 8 <= b.len() {
        out.push(
            vec2(
                bitcast_f32(engine::bake::get_u32(b, k)),
                bitcast_f32(engine::bake::get_u32(b, k + 4)),
            ),
        )
        k += 8
    }
    out
}

/// The walk's mask leaves open no cell where a player would meet solid fallen wood: short solid
/// capsules (0.5 m, 0.1 m across, one 0.65 m from a cell's middle across it, the rest seeded at
/// any angle) taken out of an open mask (`solid_colliders`) leave each open cell's middle clear
/// of the colliders the sim makes of them round a player (`world::player_obstacles`).
@test
fn the_walks_mask_keeps_out_of_the_wood_a_player_meets() {
    var capsules: Vec<engine::footing::Obstacle> = Vec::new()
    let solid = |at: vec2, a: f32| engine::footing::Obstacle {
        a: at - vec2(cos(a), sin(a)) * 0.25,
        b: at + vec2(cos(a), sin(a)) * 0.25,
        r: 0.1,
        thing: engine::footing::Thing::Log,
        depth: 1.0 / 0.0,
    }
    capsules.push(solid(vec2(5.5, 6.15), 0.0))
    for k in 0..24 {
        let at = vec2(1.0) +
            vec2(engine::noise::rand(3, 2 * k), engine::noise::rand(3, 2 * k + 1)) * 14.0
        capsules.push(solid(at, engine::noise::rand(4, k) * 6.2831853))
    }
    let (lo, hi) = (vec2(0.0), vec2(16.0))
    let grid = Grid::over(lo, hi, 1.0)
    var mask = engine::footing::Walkable { grid, ok: Vec::filled(grid.cells(), value: true) }
    mask.without(Obstacles::of(solid_colliders(capsules), lo, hi))
    var wild = world::spawn_world().wild
    for i in 0..capsules.len() {
        wild.trunks[i] = wildwood::log_circle(capsules[i])
    }
    wild.count = capsules.len()
    let nothing: Vec<engine::footing::Obstacle> = Vec::new()
    var open = 0
    for c in 0..grid.cells() {
        if mask.ok[c] {
            let p = grid.centre(c)
            let met = world::player_obstacles(wild, p, Obstacles::of(nothing, lo, hi))
            assert(
                !met.blocked_over(p, engine::footing::BODY, world::TRAVEL.clearance),
                f"the mask is open at {p}, where a player meets solid wood",
            )
            open += 1
        }
    }
    assert(!mask.ok[grid.cell_at(vec2(5.5))], "the cell beside the short log is open")
    assert(open > 100, f"only {open} cells open")
}
