// The floor's built things (#54 §1, §9): a simple form at each site, a field realized at load as
// the stones are (`engine::stone`'s way, each a solid: `engine::realize::solid`): the tower's ruin on the
// Watch (developed: dressed granite in courses that vary, a door, one deep break that shows the
// wall's thickness, moss, blocks fallen below the break), the ring's and the Warden's arena's
// standing stones, waystones, rests' seats and the echoes' small stones, and the ruins' walls
// (blockouts: judged as composition).
// Where each stands is the map's (`stones.wrela` gives what a player walks round: the same).

use engine::creature::Creature
use engine::look::Mesh as Tolerance
use engine::realize::solid
use engine::noise::{noise3, rand}
use land::place::{Feature, Map, SiteKind}
use engine::stone::{
    Bed, Realized, Rock, ShapeTape, bed, grain, realize_bed, realize_rock, realize_stone, stone,
}
use std::derive::tape
use engine::sweep::wrap
use std::derive::Box3
use std::field::{Surface, cuboid}
use std::math::TAU
use std::transform::{rotate_y, scale, translate}

/// Moss's colour on the built things' stone.
const MOSS: vec3 = vec3(0.08, 0.12, 0.03)

// ---- the tower ----------------------------------------------------------------------------------

/// The tower's shape: its outer radius (over the batter at its foot), its wall's thickness and
/// its height (m).
pub struct Tower: Copy + GpuData {
    pub radius: f32,
    pub wall: f32,
    pub tall: f32,
}

/// The slits: (angle round the tower, height) of each.
const SLITS = [
    vec2(0.4, 6.0),
    vec2(2.0, 8.5),
    vec2(4.3, 11.0),
    vec2(1.3, 13.5),
    vec2(3.4, 16.0),
    vec2(5.2, 18.0),
]

/// The door's angle round the tower (up the hill's east slope, where the way to it comes: the
/// tower's foot's shot looks at it), and the break's: one bite out of the wall beside the door,
/// so the break shows the wall's thickness and the inner face across the tower through it.
const DOOR: f32 = 3.9
pub const BREAK: f32 = 2.85

/// The break: how deep it bites below the rim (m), and how wide it is each side of its middle
/// (radians: a gentler slope on one side, a steep one on the other).
const BITE: f32 = 12.5
const BITE_WIDE: vec2 = vec2(0.65, 1.2)

/// A smaller notch out of the rim across the tower from the break (toward the old road): its
/// angle round the tower and its depth (m).
const CHIP_AT: f32 = 5.6
const CHIP: f32 = 4.5

/// A course's mean height, and how many blocks round the tower (each about 0.8 m along its outer
/// face; a whole number, so the courses close).
const COURSE: f32 = 0.42
const BLOCKS: f32 = 36.0

/// How many courses up height `y` is: each course a little taller or shorter than the next
/// (from 0.32 to 0.63 m at the tower's mean of 0.42), as a mason fits the stones the quarry
/// gives. Its slope is never less than half the mean's, so it only rises.
pub fn course_at(y: f32, course: f32) -> f32 {
    y / course + 0.25 * sin(y * 1.3 + 0.7) + 0.15 * sin(y * 3.1 + 2.0)
}

/// `course_at`'s slope at `y`.
fn course_slope(y: f32, course: f32) -> f32 {
    1.0 / course + 0.325 * cos(y * 1.3 + 0.7) + 0.465 * cos(y * 3.1 + 2.0)
}

/// The height of the course joint at or just below `y` (one Newton step from `y`).
fn joint_below(y: f32, course: f32) -> f32 {
    let u = course_at(y, course)
    y - (u - floor(u)) / course_slope(y, course)
}

/// A 2D box's distance from `q` (its corner at the origin, `q` its offset past each face).
fn past(q: vec2) -> f32 {
    length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0)
}

/// Where a stone of a coursed wall is: its course `row`, its block's index along the course,
/// how far through its course and its block it is (0 to 1), and whether the block runs on into
/// the next (some neighbouring stones share a dressed face colour).
struct Coursed: Copy {
    pub row: f32,
    pub block: f32,
    pub up: f32,
    pub on: f32,
    pub id: u32,
    pub joint: f32,
}

/// The stone at height `y`, `along` blocks along its course (`n` blocks round, or 0 for a
/// straight wall): its row, its block and its mortar (0 on its face, 1 in a joint).
fn coursed(y: f32, along: f32, course: f32, n: f32) -> Coursed {
    let u = course_at(y, course)
    let row = floor(u)
    let b = along + 0.5 * (abs(row) % 2.0)
    var block = floor(b)
    let on = b - block
    if n > 0.0 {
        block = block % n
    }
    let key = u32((row + 64.0) * 131.0 + block + 4096.0)
    let last = u32((row + 64.0) * 131.0 + (if block < 1.0 && n > 0.0 { n - 1.0 } else {
        block - 1.0
    }) + 4096.0)
    let joined = rand(last, 1) < 0.22
    let bed = 1.0 - smoothstep(0.02, 0.09, min(u - row, 1.0 - (u - row)))
    // The ends' joints are thinner than the beds', so the courses lead.
    let end = 0.7 * (1.0 - smoothstep(0.01, 0.06, min(on, 1.0 - on)))
    Coursed {
        row,
        block,
        up: u - row,
        on,
        id: if joined { last } else { key },
        joint: max(bed, end),
    }
}

/// Course-scale relief shared by the mesh and its material. Every block meets the same
/// recessed mortar plane at its edges, so changing the stone's key cannot split the field.
fn masonry_relief(st: Coursed) -> f32 {
    // A narrow linear bevel meets a broad dressed plane. Multiplying rounded edge ramps
    // made each block swell at its corners; the nearer edge alone defines the bevel here.
    let bed = saturate((min(st.up, 1.0 - st.up) - 0.018) / 0.115)
    let end = saturate((min(st.on, 1.0 - st.on) - 0.008) / 0.06)
    -0.012 + min(bed, end) * (0.043 + 0.014 * rand(st.id, 12))
}

@test
fn masonry_faces_have_depth_and_share_recessed_joint_boundaries() {
    var low = 1.0
    var high = -1.0
    for y in 0..101 {
        let p = 5.0 + f32(y) * 0.01
        let relief = masonry_relief(coursed(p, 3.4, COURSE, BLOCKS))
        low = min(low, relief)
        high = max(high, relief)
    }
    assert(low < -0.009 && high > 0.025, "masonry courses lost their shallow geometric joints")
    assert(low >= -0.0121 && high <= 0.0451, "masonry relief projects beyond dressed stone scale")
    for id in 0..64 {
        let face = Coursed { row: 1.0, block: 2.0, up: 0.5, on: 0.5, id, joint: 0.0 }
        let near_edge = Coursed { up: 0.15, on: 0.08, ..face }
        assert(
            abs(masonry_relief(face) - masonry_relief(near_edge)) < 1.0e-6,
            "a broad stone face swells instead of staying planar up to its bevel",
        )
    }
    for row in 0..8 {
        let base = Coursed { row: f32(row), block: 2.0, up: 0.5, on: 0.0, id: row, joint: 1.0 }
        let next = Coursed { on: 1.0, id: row + 91, ..base }
        assert(masonry_relief(base) == masonry_relief(next), "stone keys split a head joint")
        let below = Coursed { up: 0.0, on: 0.5, ..base }
        let above = Coursed { up: 1.0, on: 0.5, id: row + 71, ..base }
        assert(masonry_relief(below) == masonry_relief(above), "stone keys split a bed joint")
    }
}

@test
fn fortress_masonry_keeps_a_solid_thick_core_and_open_hollow() {
    let t = tower()
    for i in 0..36 {
        let a = TAU * (f32(i) + 0.5) / 36.0
        let dir = vec2(cos(a - TAU * 0.5), sin(a - TAU * 0.5))
        let radius = t.radius - t.wall * 0.5
        // Sample the intact foot outside the doorway, below every broken column.
        if stones::apart(a, DOOR) < 0.5 { continue }
        let p = vec3(dir.x * radius, 0.5, dir.y * radius)
        // The union of neighbouring columns is a conservative field: its negative
        // magnitude can be limited by an internal column edge, not an exposed surface.
        // Test solid occupancy throughout a half-metre disc instead of treating that
        // magnitude as the exact distance to air.
        let tangent = vec2(-dir.y, dir.x)
        for radial in -2..3 {
            for across in -2..3 {
                let offset = vec2(f32(radial), f32(across)) * 0.25
                if dot(offset, offset) > 0.25 { continue }
                let q = p.xz + dir * offset.x + tangent * offset.y
                assert(
                    t.distance(vec3(q.x, p.y, q.y)) < 0.0,
                    "joint relief cut through the wall's half-metre structural core",
                )
            }
        }
        let inside = vec3(dir.x * (t.radius - t.wall - 0.2), 0.5, dir.y * (t.radius - t.wall - 0.2))
        assert(t.distance(inside) > 0.1, "masonry relief filled the tower's hollow")
    }
    let wall = Wall { half: vec3(3.0, 1.1, 0.45) }
    for x in 0..21 {
        for across in -3..4 {
            // Column union boundaries may be exactly zero inside the wall; positive
            // distance would be a real gap through this sixty-centimetre-thick core.
            assert(
                wall.distance(vec3(-2.0 + f32(x) * 0.2, 0.4, f32(across) * 0.1)) <= 0.0,
                "ruin joints split its lower masonry core",
            )
        }
    }
}

@test
fn tower_arch_relief_is_continuous_at_its_material_boundaries() {
    let t = tower()
    let r = t.radius - 0.05
    let e = 0.0001
    for i in 0..25 {
        // Crossing the spring line within the band of stone around the opening.
        let ds = 0.82 + f32(i) * 0.019
        let a = DOOR + ds / r
        let p = vec3(r * cos(a - TAU * 0.5), DOOR_SPRING, r * sin(a - TAU * 0.5))
        let below = t.relief(p - vec3(0.0, e, 0.0), a, r)
        let above = t.relief(p + vec3(0.0, e, 0.0), a, r)
        assert(abs(above - below) <= 2.0 * e * 9.0, "arch relief jumps across its spring")
        // Crossing the outer arch radius, at several angles of its upper semicircle.
        let angle = 0.15 + f32(i) * 0.117
        let side = (DOOR_HALF + 0.5) * cos(angle)
        let y = DOOR_SPRING + (DOOR_HALF + 0.5) * sin(angle)
        let a = DOOR + side / r
        let p = vec3(r * cos(a - TAU * 0.5), y, r * sin(a - TAU * 0.5))
        let inside = t.relief(p - vec3(0.0, e, 0.0), a, r)
        let outside = t.relief(p + vec3(0.0, e, 0.0), a, r)
        assert(abs(outside - inside) <= 2.0 * e * 9.0, "arch relief jumps across its outer edge")
    }
}

/// Dressed granite: a grain at two scales, each stone (`id`) its own, a little warmer or cooler,
/// paler or darker.
pub fn dressed(p: vec3, id: u32) -> vec3 {
    let q = p * 1.5
    let g = grain(q)
    var c = mix(vec3(0.33, 0.32, 0.30), vec3(0.50, 0.48, 0.44), vec3(g))
    c *= 0.92 + 0.16 * noise3(p * 9.0)
    // Each stone a little its own, inside a few broad masses of paler and darker stone.
    c *= (0.9 + 0.22 * rand(id, 2)) * (0.85 + 0.3 * noise3(p * 0.3 + vec3(3.0)))
    let warm = rand(id, 3)
    mix(c * vec3(0.93, 0.97, 1.04), c * vec3(1.08, 1.0, 0.86), vec3(warm))
}

impl Tower {
    /// Its outer radius at height `y`: battered out at its foot, narrowing a little upward.
    fn outer(self, y: f32) -> f32 {
        self.radius - 0.012 * y + stones::TOWER_BATTER * smoothstep(1.6, 0.0, y)
    }

    /// Column `j`'s top (0 to `BLOCKS`): the rim ragged by up to six courses, a little lower toward
    /// the break, and the break's one bite down the wall; at a course's joint, so the broken top
    /// steps in whole blocks.
    fn column_top(self, j: f32) -> f32 {
        let a = (j + 0.5) / BLOCKS * TAU
        let n = u32(j)
        let rim = self.tall - 2.0 * (0.5 + 0.5 * cos(a - BREAK)) - 2.6 * rand(n, 7) * rand(n, 9)
        let s = wrap(a - BREAK)
        let x = if s > 0.0 { s / BITE_WIDE.y } else { -s / BITE_WIDE.x }
        let bite = BITE * (1.0 - smoothstep(0.1, 1.0, x)) * (0.75 + 0.5 * rand(n, 8))
        // And a smaller notch across the tower, so its crown reads broken from the far side too.
        let notch = CHIP *
            (1.0 - smoothstep(0.1, 1.0, stones::apart(a, CHIP_AT) / 0.4)) *
            (0.6 + 0.8 * rand(n, 10))
        joint_below(rim - max(bite, notch), COURSE) + COURSE * (rand(n, 11) - 0.5) * 0.6
    }

    /// The broken top over angle `a`: the column's there.
    pub fn top(self, a: f32) -> f32 {
        self.column_top(floor(a / TAU * BLOCKS) % BLOCKS)
    }

    /// Geometry blends between the arch and ordinary courses. The material's discrete
    /// ownership boundary must not introduce a jump into the meshed distance field.
    fn relief(self, p: vec3, a: f32, r: f32) -> f32 {
        let ordinary = masonry_relief(coursed(p.y, a / TAU * BLOCKS, COURSE, BLOCKS))
        let v = vec2(wrap(a - DOOR) * r, p.y - DOOR_SPRING)
        let arch = smoothstep(0.0, 0.15, v.y) *
            (1.0 - smoothstep(DOOR_HALF + 0.32, DOOR_HALF + 0.5, length(v)))
        mix(ordinary, masonry_relief(self.stone_at(p, a, r)), arch)
    }

    /// The stone at `p` (angle `a` round the tower, `r` from its axis): its course and block, or
    /// round the door's arch, its voussoir (its joints radial to the arch).
    fn stone_at(self, p: vec3, a: f32, r: f32) -> Coursed {
        let v = vec2(wrap(a - DOOR) * r, p.y - DOOR_SPRING)
        let rr = length(v)
        if p.y > DOOR_SPRING && rr < DOOR_HALF + 0.5 {
            let t = atan2(v.y, v.x) / (0.5 * TAU) * 9.0
            let i = floor(t)
            let ring = smoothstep(DOOR_HALF + 0.42, DOOR_HALF + 0.48, rr)
            Coursed {
                row: -1.0,
                block: i,
                up: 0.5,
                on: t - i,
                id: u32(i + 9000.0),
                joint: max(ring, smoothstep(0.86, 0.98, t - i)),
            }
        } else {
            coursed(p.y, a / TAU * BLOCKS, COURSE, BLOCKS)
        }
    }
}

/// The door: its half width, and where its round arch springs (m).
const DOOR_HALF: f32 = 0.8
const DOOR_SPRING: f32 = 2.8

impl Surface for Tower {
    fn distance(self, p: vec3) -> f32 {
        let r = length(p.xz)
        let a = atan2(p.z, p.x) + TAU * 0.5
        let inner = self.radius - self.wall
        let relief = self.relief(p, a, r)
        var d = max(r - self.outer(p.y) - relief, inner - r - relief)
        d = max(d, -(p.y + 3.0))
        // The top: the union of the blocks' columns, each standing to its own top, its sides
        // measured round the tower at this radius (exact to the nearest five; past them, at
        // least two blocks off).
        let fj = a / TAU * BLOCKS
        let j = floor(fj)
        let reach = max(r, inner)
        var top = 2.0 * TAU / BLOCKS * reach
        for k in 0..5 {
            let jj = j + f32(k) - 2.0
            let side = max(jj - fj, fj - (jj + 1.0)) * TAU / BLOCKS * reach
            let column = (jj + BLOCKS) % BLOCKS
            // A fractured block slopes through the wall's thickness and along its face.
            // Neither face ends in the identical clean stair-step cut.
            let across = clamp((r - inner) / self.wall, 0.0, 1.0) - 0.5
            let fracture = 0.38 * across * (2.0 * rand(u32(column), 13) - 1.0) +
                0.22 * clamp(fj - jj - 0.5, -0.5, 0.5) * (2.0 * rand(u32(column), 14) - 1.0)
            let t = self.column_top(column) + fracture
            top = min(top, past(vec2(side, p.y - t)))
        }
        d = max(d, top)
        // The door, its round arch cut through the wall.
        let ds = wrap(a - DOOR) * r
        let door = min(
            past(vec2(abs(ds) - DOOR_HALF, p.y - DOOR_SPRING)),
            length(vec2(ds, p.y - DOOR_SPRING)) - DOOR_HALF,
        )
        d = max(d, -door)
        // The slits, splayed: narrow outside, wide inside.
        let depth = saturate((self.outer(p.y) - r) / self.wall)
        for s in SLITS {
            let slit = max(abs(wrap(a - s.x)) * r - (0.09 + 0.3 * depth), abs(p.y - s.y) - 0.6)
            d = max(d, -slit)
        }
        // The dressed faces retain broad planes; small weathering does not melt the joints.
        d - 0.008 * noise3(p * 3.0)
    }

    /// The top's columns, the door and the slits are distances (the slits' splay bends them
    /// by a third); the batter's slope and the weathering bend the field a little more.
    fn lipschitz(self, near: f32) -> f32 {
        9.0
    }
}

/// The tower's colour at `p`: dressed granite in its courses, the mortar darker, weather
/// streaks run down from its slits and rim, damp low on it, moss low on its north side and
/// along its broken top.
pub struct Masonry: Copy + GpuData {
    pub tower: Tower,
}

impl Masonry {
    pub fn at(self, p: vec3) -> Rock {
        let t = self.tower
        let r = length(p.xz)
        let a = atan2(p.z, p.x) + TAU * 0.5
        let st = t.stone_at(p, a, r)
        var c = dressed(p, st.id)
        c = mix(c, c * 0.6, vec3(st.joint * 0.6))
        let streak = noise3(vec3(a * 14.0, p.y * 0.12, 1.0))
        c *= 1.0 - 0.16 * st.joint * smoothstep(0.55, 0.85, streak)
        c *= mix(0.78, 1.0, smoothstep(0.0, 2.5, p.y))
        let north = smoothstep(-0.2, 0.8, p.z / max(r, 0.1))
        let top = t.top(a)
        let lip = smoothstep(1.6, 0.2, top - p.y) * (0.5 + 0.5 * noise3(p * 1.7))
        let damp = smoothstep(2.5, 0.0, p.y) * north
        let moss = max(damp * (0.25 + 0.75 * st.joint), lip * (0.3 + 0.7 * st.joint))
        Rock { albedo: mix(c, MOSS, vec3(moss * 0.6)) }
    }
}

/// A coursed wall's colour (a ruin's): dressed stone in courses `course` high along +x, dark
/// mortar between, moss low and high where its top is broken (`top`, the height moss reaches
/// from).
pub struct Courses: Copy + GpuData {
    pub top: f32,
    pub course: f32,
}

impl Courses {
    pub fn at(self, p: vec3) -> Rock {
        let st = coursed(p.y, p.x / 0.8, self.course, 0.0)
        var c = dressed(p, st.id)
        c = mix(c, c * 0.55, vec3(st.joint * 0.75))
        c *= mix(0.78, 1.0, smoothstep(0.0, 1.5, p.y))
        let moss = max(
            smoothstep(1.2, 0.0, p.y) * (0.5 + 0.5 * noise3(p * 1.3)),
            smoothstep(self.top - 1.0, self.top - 0.3, p.y) * 0.7,
        )
        Rock { albedo: mix(c, MOSS, vec3(moss * 0.75)) }
    }
}

/// The floor's tower.
pub fn tower() -> Tower {
    Tower { radius: stones::TOWER_RADIUS, wall: 1.65, tall: stones::TOWER_TALL }
}

/// The tower, a solid to realize (`engine::realize::solid`).
pub fn tower_creature(t: Tower) -> Creature<Rock> {
    let c = Masonry { tower: t }
    let m = stones::TOWER_FOOT + 0.2
    solid(
        t.with_at(|p| c.at(p)),
        Box3 { lo: vec3(-m, -3.2, -m), hi: vec3(m, t.tall + 0.5, m) },
        name: "tower",
    )
}

/// The tower, realized at `at` (its foot on the ground).
pub fn realize_tower(at: vec3) -> Realized {
    realize_tower_within(at, tolerance: 2cm, largest: 12cm)
}

/// The tower's distant representation: cells for a 10 cm tolerance (its courses' joints
/// are a pixel or less there), a twentieth of the near mesh's vertices.
pub fn realize_tower_far(at: vec3) -> Realized {
    realize_tower_within(at, tolerance: 10cm, largest: 40cm)
}

/// The tower's distant mesh takes over across this distance band (m).
pub const TOWER_BLEND: vec2 = vec2(64.0, 96.0)

pub fn tower_far_share(distance: f32) -> f32 {
    smoothstep(TOWER_BLEND.x, TOWER_BLEND.y, distance)
}

@test
fn the_tower_changes_mesh_over_a_band_without_a_threshold_jump() {
    assert(tower_far_share(TOWER_BLEND.x) == 0.0, "distant tower appears before its band")
    assert(tower_far_share(TOWER_BLEND.y) == 1.0, "near tower persists past its band")
    assert(abs(tower_far_share(80.0) - 0.5) < 0.0001, "the former hard switch is not blended")
    var previous = 0.0
    for step in 0..129 {
        let share = tower_far_share(TOWER_BLEND.x + f32(step) * 0.25)
        assert(
            share >= previous && share - previous < 0.012,
            "tower detail jumps within its transition band",
        )
        previous = share
    }
}

fn realize_tower_within(at: vec3, tolerance: f32, largest: f32) -> Realized {
    realized(tower_creature(tower()), tolerance, largest, cell: 4cm, at: translate(at), seed: 77)
}

/// Built thing `c` realized as one rigid mesh, its surface within `tolerance` (its cells at most
/// `largest`), its colours cooked a `cell` apart, placed by `at`.
fn realized<K: Creature<Rock>>(
    c: K,
    tolerance: f32,
    largest: f32,
    cell: f32,
    at: mat4,
    seed: u32,
) -> Realized {
    realize_rock(c, Tolerance { tolerance, largest }, cell, at, seed)
}

// ---- rubble -------------------------------------------------------------------------------------

/// A fallen block of dressed stone: `half` its size each way, tipped by `tilt` (radians about
/// x and z), its edges worn round and two corners broken off. A big one (longer than 1.2 m) is
/// a piece of walling that fell whole: two courses, a joint along it.
pub struct Block: Copy + GpuData {
    pub half: vec3,
    pub tilt: vec2,
    pub seed: u32,
}

impl Block {
    /// `p` in the block's own frame.
    fn local(self, p: vec3) -> vec3 {
        let (cx, sx) = (cos(self.tilt.x), sin(self.tilt.x))
        let (cz, sz) = (cos(self.tilt.y), sin(self.tilt.y))
        let q = vec3(p.x, cx * p.y - sx * p.z, sx * p.y + cx * p.z)
        vec3(cz * q.x - sz * q.y, sz * q.x + cz * q.y, q.z)
    }

    pub fn colour(self, p: vec3) -> Rock {
        let q = self.local(p)
        let upper = if q.y > 0.0 { 1.0 } else { 0.0 }
        let piece = if self.half.x > 0.6 { u32(floor(q.x / 0.8 + 4.0) + 8.0 * upper) } else { 0 }
        var c = dressed(p, self.seed * 7 + piece)
        if self.half.x > 0.6 {
            let bed = smoothstep(0.03, 0.0, abs(q.y))
            let end = smoothstep(0.06, 0.0, abs((q.x / 0.8 + 4.0 + 0.5 * upper) % 1.0 - 0.5) - 0.44)
            c = mix(c, c * 0.55, vec3(max(bed, end) * 0.75))
        }
        let damp = smoothstep(0.45, -0.45, p.y / max(self.half.y, 0.1))
        let moss = damp * smoothstep(0.45, 0.75, noise3(p * 3.0))
        Rock { albedo: mix(c, MOSS, vec3(moss * 0.55)) }
    }
}

impl Surface for Block {
    fn distance(self, p: vec3) -> f32 {
        let q = self.local(p)
        let round = 0.025
        var d = cuboid(self.half - vec3(round)).distance(q) - round
        for k in 0..2 {
            let n = normalize(
                vec3(
                    if rand(self.seed, 10 + k) < 0.5 { -1.0 } else { 1.0 },
                    if rand(self.seed, 12 + k) < 0.5 { -1.0 } else { 1.0 },
                    if rand(self.seed, 14 + k) < 0.5 { -1.0 } else { 1.0 },
                ) / self.half,
            )
            let corner = dot(abs(n), self.half)
            d = max(d, dot(q, n) - corner * (0.58 + 0.3 * rand(self.seed, 16 + k)))
        }
        d - 0.006 * noise3(p * 5.0)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.2
    }
}

/// A fallen block, a solid to realize (`engine::realize::solid`).
pub fn block_creature(b: Block) -> Creature<Rock> {
    let m = length(b.half) + 0.1
    solid(b.with_at(|p| b.colour(p)), Box3 { lo: vec3(-m), hi: vec3(m) }, name: "block")
}

/// A fallen block lying at `at` on the ground (sunk a third into it), turned by `turn`, realized.
pub fn realize_block(at: vec3, half: vec3, seed: u32, turn: f32) -> Realized {
    let tilt = vec2(rand(seed, 6) - 0.5, rand(seed, 7) - 0.5) * 0.5
    realized(
        block_creature(Block { half, tilt, seed }),
        tolerance: 1cm,
        largest: 6cm,
        cell: 2cm,
        at: translate(at + vec3(0.0, 0.6 * half.y, 0.0)) * rotate_y(turn),
        seed: seed,
    )
}

// ---- the waystone -------------------------------------------------------------------------------

/// A waystone: a dressed pillar `tall` high on a squat plinth, square and tapering, its edges
/// chamfered, its top a low pyramid, a band cut round it at two thirds of its height, and on
/// its road face the way's mark cut in (a ring over a stroke).
pub struct Waystone: Copy + GpuData {
    pub tall: f32,
    pub seed: f32,
}

impl Waystone {
    /// The shaft's half breadth (x) and half depth (z) at height `y`.
    fn breadth(self, y: f32) -> vec2 {
        let w = mix(0.3, 0.24, saturate(y / self.tall))
        vec2(w, 0.8 * w)
    }

    pub fn colour(self, p: vec3) -> Rock {
        var c = 1.25 * dressed(p, u32(self.seed * 10.0) + (if p.y < 0.13 { 1 } else { 0 }))
        // Paler where the weather has bleached its top; darker in its cuts.
        c *= 1.0 + 0.15 * smoothstep(0.4, 1.0, p.y / self.tall)
        let north = smoothstep(-0.2, 0.8, -p.z / 0.3)
        let moss = smoothstep(0.5, 0.0, p.y) * (0.4 + 0.6 * north) * (0.5 + 0.5 * noise3(p * 4.0))
        let lichen = smoothstep(0.7, 0.78, noise3(p * 6.0 + vec3(self.seed))) *
            smoothstep(0.5, 0.9, p.y / self.tall)
        c = mix(c, vec3(0.52, 0.50, 0.36), vec3(lichen * 0.6))
        Rock { albedo: mix(c, MOSS, vec3(moss * 0.7)) }
    }
}

impl Surface for Waystone {
    fn distance(self, p: vec3) -> f32 {
        let lean = vec3(0.04 * sin(self.seed), 0.0, 0.03 * cos(self.seed * 1.7)) * max(p.y, 0.0)
        let q = p - lean
        let h = self.tall
        let b = self.breadth(q.y)
        // The shaft, up to its cap's tip.
        let cap = h + 0.2
        var d = past(
            vec2(
                max(abs(q.x) - b.x, abs(q.z) - b.y),
                abs(q.y - 0.5 * (cap - 0.3)) - 0.5 * (cap + 0.3),
            ),
        )
        d = max(d, (abs(q.x) + abs(q.z) - (b.x + b.y) + 0.07) * 0.7071)
        // The cap: four faces up to a point 0.2 m over the shaft.
        d = max(d, (q.y - cap + abs(q.x) * 0.2 / b.x) / length(vec2(1.0, 0.2 / b.x)))
        d = max(d, (q.y - cap + abs(q.z) * 0.2 / b.y) / length(vec2(1.0, 0.2 / b.y)))
        // The band, and the mark on its road face (+z), each cut 2 cm in.
        let skin = -d - 0.02
        let band = abs(q.y - 0.68 * h) - 0.025
        let ring = abs(length(vec2(q.x, q.y - 0.45 * h)) - 0.08) - 0.016
        let stroke = max(abs(q.x) - 0.016, abs(q.y - 0.27 * h) - 0.09)
        let mark = max(min(ring, stroke), 0.05 - q.z)
        d = max(d, -max(min(band, mark), skin))
        // Its plinth.
        let plinth = cuboid(vec3(0.4, 0.17, 0.34)).distance(q - vec3(0.0, -0.05, 0.0)) - 0.04
        min(d, plinth) - 0.01 * noise3(p * 4.0 + vec3(self.seed))
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.6
    }
}

/// A waystone, a solid to realize (`engine::realize::solid`).
pub fn waystone_creature(w: Waystone) -> Creature<Rock> {
    solid(
        w.with_at(|p| w.colour(p)),
        Box3 { lo: vec3(-0.5, -0.4, -0.5), hi: vec3(0.5, w.tall + 0.4, 0.5) },
        name: "waystone",
    )
}

/// A waystone `tall` high standing at `at`, its road face turned by `turn`, realized.
pub fn realize_waystone(at: vec3, tall: f32, seed: u32, turn: f32) -> Realized {
    realized(
        waystone_creature(Waystone { tall, seed: f32(seed % 97) * 0.37 }),
        tolerance: 5mm,
        largest: 3cm,
        cell: 1cm,
        at: translate(at - vec3(0.0, 0.1, 0.0)) * rotate_y(turn),
        seed: seed,
    )
}

// ---- standing stones ----------------------------------------------------------------------------

/// A standing stone or a waystone: a slab `half` its size each way (taller than it's wide),
/// rounded, leaning a little, its top worn to a slope, its faces lumpy.
pub struct Slab: Copy + GpuData {
    pub half: vec3,
    pub seed: f32,
}

impl Surface for Slab {
    fn distance(self, p: vec3) -> f32 {
        let lean = vec3(0.06 * sin(self.seed), 0.0, 0.05 * cos(self.seed * 1.7)) * p.y
        let q = p - lean - vec3(0.0, self.half.y, 0.0)
        // Narrower toward the top.
        let taper = 1.0 - 0.18 * saturate(q.y / self.half.y)
        let h = vec3(self.half.x * taper, self.half.y, self.half.z * taper)
        let r = min(h.x, h.z) * 0.35
        var d = cuboid(h - vec3(r)).distance(q) - r
        // The top worn to a slope.
        d = max(d, q.y + 0.25 * q.x / self.half.x * self.half.y * 0.3 - self.half.y * 0.92)
        // A corner of its top split off, on one side or the other, a little or a lot.
        let side = if sin(self.seed * 5.3) > 0.0 { 1.0 } else { -1.0 }
        let n = normalize(vec3(side * 0.8, 1.0, 0.25 * cos(self.seed * 2.9)))
        let chip = 0.35 + 0.3 * (0.5 + 0.5 * sin(self.seed * 3.7))
        d = max(d, dot(q - vec3(side * self.half.x, self.half.y, 0.0) * (1.0 - chip), n))
        d - 0.04 * noise3(p * 3.0 + vec3(self.seed))
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// A standing stone's colour at `p`: grey granite with a grain, pale lichen in patches on its
/// upper half, and moss only at its foot (a boulder's `Stain` puts moss on its top, which on a
/// tall stone covered most of it and cast it green).
fn weathered(p: vec3, s: Slab) -> Rock {
    let q = p * 1.2 + vec3(s.seed)
    let g = grain(q)
    var c = mix(vec3(0.19, 0.185, 0.18), vec3(0.31, 0.295, 0.27), vec3(g))
    c *= 0.92 + 0.16 * noise3(p * 9.0 + vec3(s.seed))
    let up = saturate(p.y / (2.0 * s.half.y))
    let lichen = smoothstep(0.66, 0.74, noise3(p * 3.3 + vec3(5.0, 2.0, s.seed))) *
        smoothstep(0.3, 0.7, up)
    c = mix(c, vec3(0.42, 0.41, 0.33), vec3(lichen * 0.6))
    let moss = smoothstep(0.6, 0.0, p.y) * (0.5 + 0.5 * noise3(p * 2.5 + vec3(s.seed)))
    Rock { albedo: mix(c, MOSS, vec3(moss * 0.7)) }
}

/// A slab, a solid to realize (`engine::realize::solid`).
pub fn slab_creature(s: Slab) -> Creature<Rock> {
    let m = max(s.half.x, s.half.z) + 0.3
    solid(
        s.with_at(|p| weathered(p, s)),
        Box3 { lo: vec3(-m, -0.6, -m), hi: vec3(m, 2.0 * s.half.y + 0.3, m) },
        name: "slab",
    )
}

/// A slab standing at `at` (its foot on the ground, sunk a little: a lying one less), turned by
/// `turn`, realized.
pub fn realize_slab(at: vec3, half: vec3, seed: u32, turn: f32) -> Realized {
    realized(
        slab_creature(Slab { half, seed: f32(seed % 97) * 0.37 }),
        tolerance: 8mm,
        largest: 4cm,
        cell: 1cm,
        at: translate(at - vec3(0.0, min(0.25, 0.4 * half.y), 0.0)) * rotate_y(turn),
        seed: seed,
    )
}

// ---- walls ----------------------------------------------------------------------------------------

/// A wall's stretch: a box `half` its size each way (its length along +x), dressed stone.
pub struct Wall: Copy + GpuData {
    pub half: vec3,
}

impl Surface for Wall {
    fn distance(self, p: vec3) -> f32 {
        let st = coursed(p.y, p.x / 0.8, course: 0.3, n: 0.0)
        let relief = masonry_relief(st) * 0.7
        var d = max(abs(p.x) - self.half.x, abs(p.z) - self.half.z - relief)
        d = max(d, -p.y)
        let column = floor(p.x / 0.8)
        var top = 2.0
        for k in 0..3 {
            let j = column + f32(k) - 1.0
            let key = u32(j + 2048.0)
            let height = joint_below(2.0 * self.half.y * (0.58 + 0.42 * rand(key, 31)), 0.3)
            let fracture = 0.16 * p.z / self.half.z * (rand(key, 32) - 0.5)
            let side = max(j * 0.8 - p.x, p.x - (j + 1.0) * 0.8)
            top = min(top, past(vec2(side, p.y - height - fracture)))
        }
        max(d, top)
    }

    fn lipschitz(self, near: f32) -> f32 {
        5.0
    }
}

/// A wall's stretch, a solid to realize (`engine::realize::solid`).
pub fn wall_creature(w: Wall, tall: f32) -> Creature<Rock> {
    let c = Courses { top: tall, course: 0.3 }
    solid(
        w.with_at(|p| c.at(p)),
        Box3 { lo: vec3(-w.half.x - 0.2, -0.2, -0.7), hi: vec3(w.half.x + 0.2, tall + 0.3, 0.7) },
        name: "wall",
    )
}

/// A wall from `a` to `b` on the ground (x, z; `ya` and `yb` its ends' ground), `tall` high,
/// realized.
pub fn realize_wall(a: vec3, b: vec3, tall: f32, seed: u32) -> Realized {
    let along = b.xz - a.xz
    let len = length(along)
    let w = Wall { half: vec3(len * 0.5 + 0.4, tall * 0.5, 0.45) }
    let mid = (a + b) * 0.5
    let turn = -atan2(along.y, along.x)
    realized(
        wall_creature(w, tall),
        tolerance: 2cm,
        largest: 10cm,
        cell: 4cm,
        at: translate(vec3(mid.x, min(a.y, b.y) - 0.15, mid.z)) * rotate_y(turn),
        seed: seed,
    )
}

// ---- what's built where --------------------------------------------------------------------------

/// A thing to realize: a stone (at, radius, squash, seed), a standing slab (turned as its
/// builders set it: `slab_at` turns one at random), a fallen block, a waystone, the tower, a wall (two ends), or
/// a bed of a crag's rock (`Land::crag_beds`: its frame's origin in the world, and the bed).
pub enum Built: Copy {
    Stone { at: vec2, radius: f32, squash: vec3, seed: u32 },
    Standing { at: vec2, half: vec3, turn: f32, seed: u32 },
    Block { at: vec2, half: vec3, seed: u32 },
    Waystone { at: vec2, tall: f32, seed: u32 },
    Tower { at: vec2 },
    Wall { a: vec2, b: vec2, tall: f32, seed: u32 },
    Rock { at: vec3, bed: Bed },
}

/// `b`'s shape as a tape (`engine::stone::ShapeTape`): its creature's field at rest, in its own
/// space (what `realize` places by its `at`), for the distance volume
/// (`engine::distance::Shape`); `None` for one too long for a tape (the tower's 1,575
/// operations: tapes.wrela's table).
pub fn shape_tape(b: Built) -> Option<ShapeTape> {
    match b {
        Built::Stone { radius, squash, seed, .. } => taped_shape(stone(radius, squash, seed)),
        Built::Standing { half, seed, .. } => {
            taped_shape(slab_creature(Slab { half, seed: f32(seed % 97) * 0.37 }))
        },
        Built::Block { half, seed, .. } => {
            let tilt = vec2(rand(seed, 6) - 0.5, rand(seed, 7) - 0.5) * 0.5
            taped_shape(block_creature(Block { half, tilt, seed }))
        },
        Built::Waystone { tall, seed, .. } => {
            taped_shape(waystone_creature(Waystone { tall, seed: f32(seed % 97) * 0.37 }))
        },
        Built::Tower { .. } => None,
        Built::Wall { a, b, tall, .. } => {
            let w = Wall { half: vec3(length(b - a) * 0.5 + 0.4, tall * 0.5, 0.45) }
            taped_shape(wall_creature(w, tall))
        },
        Built::Rock { bed: r, .. } => taped_shape(bed(r)),
    }
}

fn taped_shape<C, K: Creature<C>>(k: K) -> Option<ShapeTape> {
    let f = k.field()
    tape(|q: vec3| f.distance(q)).resized()
}

/// A standing slab `half` its size each way, turned at random.
pub fn slab_at(at: vec2, half: vec3, seed: u32) -> Built {
    Built::Standing { at, half, turn: TAU * rand(seed, 5), seed }
}

/// Everything built on the floor's map, from its sites: a ring's standing stones
/// (`stones::ring`), a waystone, a seat or a cairn (a squat stone), the tower and the blocks
/// fallen from it, and a ruin's walls.
pub fn built(m: Map) -> Vec<Built> {
    var out: Vec<Built> = Vec::new()
    var seed = 500
    for k in m.sites {
        seed += 17
        match k.feature {
            Feature::Ring => {
                var i = 0
                for st in stones::ring(k) {
                    out.push(
                        Built::Standing { at: st.at, half: st.half, turn: st.turn, seed: seed + i },
                    )
                    i += 1
                }
            },
            Feature::Tower => {
                out.push(Built::Tower { at: k.at })
                // The break's fall: blocks fanned out below it, most and biggest near the wall
                // (three pieces of walling that fell whole), fewer and smaller farther out.
                let toward = BREAK - 0.5 * TAU
                for i in 0..24 {
                    let f = rand(seed + i, 2)
                    let a = toward + 0.8 * (rand(seed + i, 3) - 0.5) * (1.0 + f)
                    let r = stones::TOWER_FOOT + 0.3 + 6.0 * f * f
                    let half = if i < 5 {
                        vec3(
                            0.8 + 0.65 * rand(seed + i, 4),
                            0.32 + 0.25 * rand(seed + i, 5),
                            0.42 + 0.3 * rand(seed + i, 6),
                        )
                    } else {
                        vec3(
                            0.16 + 0.34 * rand(seed + i, 4),
                            0.10 + 0.16 * rand(seed + i, 5),
                            0.13 + 0.23 * rand(seed + i, 6),
                        )
                    }
                    out.push(
                        Built::Block {
                            at: k.at + vec2(cos(a), sin(a)) * r,
                            half,
                            seed: seed + 40 + i,
                        },
                    )
                }
                // And a few round the rest of its foot, fallen from the rim.
                for i in 0..7 {
                    let a = TAU * rand(seed + 70 + i, 2)
                    let r = stones::TOWER_RADIUS +
                        stones::TOWER_BATTER +
                        0.4 +
                        2.5 * rand(seed + 70 + i, 3)
                    let half = vec3(0.28 + 0.12 * rand(seed + 70 + i, 4), 0.17, 0.22)
                    out.push(
                        Built::Block {
                            at: k.at + vec2(cos(a), sin(a)) * r,
                            half,
                            seed: seed + 70 + i,
                        },
                    )
                }
            },
            Feature::Stone => {
                if k.tall <= 2.5 {
                    let r = 0.3 + 0.15 * k.tall
                    if k.kind == SiteKind::Waystone {
                        // Squat: a broad stone a little shorter than the site's mark.
                        out.push(Built::Waystone { at: k.at, tall: 0.8 * k.tall, seed })
                    } else {
                        out.push(
                            Built::Stone { at: k.at, radius: r, squash: vec3(1.3, 0.8, 1.1), seed },
                        )
                    }
                }
            },
            _ => {},
        }
    }
    for w in stones::walls(m) {
        seed += 3
        out.push(Built::Wall { a: w.xy, b: w.zw, tall: 2.2, seed })
    }
    out
}

/// Small partly buried stones along stream margins. Three stones make each irregular
/// patch; the total stays bounded even when the history produces long courses. Falls use
/// their cliff geometry instead. These low stones remain below the climber's floating lift.
pub const BANK_STONE_LIMIT: u32 = 384
const BANK_PATCH_STONES: u32 = 3

pub fn bank_stones(courses: [land::water::Course]) -> Vec<Built> {
    var total = 0.0
    for c in courses {
        if c.falls || c.points.len() < 2 {
            continue
        }
        for i in 0..c.points.len() - 1 {
            total += length(c.points[i + 1].xy - c.points[i].xy)
        }
    }
    let spacing = max(3.5, total / f32(BANK_STONE_LIMIT / BANK_PATCH_STONES))
    var out: Vec<Built> = Vec::new()
    var walked = 0.0
    var next = spacing * 0.35
    var patch = 0
    for c in courses {
        if c.falls || c.points.len() < 2 {
            continue
        }
        for i in 0..c.points.len() - 1 {
            let a = c.points[i]
            let b = c.points[i + 1]
            let length = length(b.xy - a.xy)
            if length <= 1.0e-4 {
                continue
            }
            let along = (b.xy - a.xy) / length
            let side = vec2(-along.y, along.x)
            while next < walked + length {
                if out.len() + BANK_PATCH_STONES > BANK_STONE_LIMIT {
                    return out
                }
                let q = mix(a, b, vec4(clamp((next - walked) / length, 0.0, 1.0)))
                let seed = 12000 + patch * 11
                let bank = if rand(seed, 1) < 0.5 { -1.0 } else { 1.0 }
                for k in 0..BANK_PATCH_STONES {
                    let radius = if k == 0 { 0.42 + 0.24 * rand(seed, 2) } else {
                        0.18 + 0.22 * rand(seed + k, 2)
                    }
                    let offset = (f32(k) - 1.0) * (0.65 + 0.5 * rand(seed + k, 3))
                    let across = 0.5 * max(q.z, 0.2) + radius * (0.2 + 0.9 * rand(seed + k, 4))
                    let at = q.xy + along * offset + side * (bank * across)
                    out.push(
                        Built::Stone {
                            at,
                            radius,
                            squash: vec3(
                                1.15 + 0.3 * rand(seed + k, 5),
                                0.65,
                                0.85 + 0.2 * rand(seed + k, 6),
                            ),
                            seed: seed + k,
                        },
                    )
                }
                patch += 1
                next += spacing * (0.8 + 0.4 * rand(seed, 7))
            }
            walked += length
        }
    }
    out
}

/// Three shared stones supply every bank patch; placement scale gives the authored size.
pub const BANK_PROTOTYPES: u32 = 3

/// Bank prototype `index`'s stone, as a field (its clusters' source: `engine::stone::ClusterStones`).
pub fn bank_creature(index: u32) -> engine::creature::Creature<engine::stone::Rock> {
    engine::stone::stone(1.0, vec3(1.0), bank_seed(index))
}

/// Bank prototype `index`'s stone's seed.
fn bank_seed(index: u32) -> u32 {
    12000 + index * 19
}

/// The finest cells of a bank prototype's clusters (in its own unit space, as its 2 cm
/// tolerance).
pub const BANK_CELL: f32 = 1.5cm

/// Bank prototype `index`'s stone (`bank_creature`) realized to a 2 cm tolerance, its colours
/// cooked a centimetre apart, unmoved (as `engine::stone::realize_stone_within` places it).
pub fn bank_prototype(index: u32) -> Realized {
    realize_rock(
        bank_creature(index),
        Tolerance { tolerance: 2cm, largest: 8cm },
        1cm,
        translate(vec3(0.0)) * rotate_y(0.0),
        bank_seed(index),
    )
}

pub fn bank_instances(
    courses: [land::water::Course],
    height: fn(vec2) -> f32,
) -> engine::stone::Instances {
    var placements: Vec<engine::stone::Placement> = Vec::new()
    for b in bank_stones(courses) {
        if let Built::Stone { at, radius, squash, seed } = b {
            let size = squash * radius
            // Loose stream stones settle on shelves, not halfway up an exposed cut bank.
            // Probe over the stone's footprint so a narrow ledge cannot hold a large boulder.
            let step = max(radius, 0.3)
            let slope = vec2(
                height(at + vec2(step, 0.0)) - height(at - vec2(step, 0.0)),
                height(at + vec2(0.0, step)) - height(at - vec2(0.0, step)),
            ) /
                (2.0 * step)
            if length(slope) > 1.0 {
                continue
            }
            let centre = vec3(at.x, height(at) + size.y * 0.35, at.y)
            let transform = translate(centre) * rotate_y(TAU * rand(seed, 4)) * scale(size)
            placements.push(
                engine::stone::Placement {
                    prototype: seed % BANK_PROTOTYPES,
                    at: transform,
                    normal_at: engine::stone::normal_matrix(transform),
                    // Unit prototype's field bounds are +/-1.22; a rotation preserves this
                    // corner radius. No placement copies a vertex, index or colour buffer.
                    reach: length(size * 1.22),
                    seed,
                },
            )
        }
    }
    engine::stone::Instances { prototypes: Vec::new(), placements }
}

@test
fn bank_instances_share_three_prototypes_and_enclose_their_scaled_bounds() {
    let c = land::water::Course {
        points: Vec::from([vec4(0.0, 0.0, 4.0, 0.4), vec4(0.0, 80.0, 4.0, 0.4)]),
        falls: false,
    }
    let bank = bank_instances([take c], |_p| 2.0)
    assert(bank.prototypes.is_empty(), "placement allocated a private GPU mesh")
    assert(bank.placements.len() > 30, "the instances lost the authored bank density")
    for p in bank.placements {
        assert(p.prototype < BANK_PROTOTYPES, "placement selected an absent prototype")
        var bottom = 1.0e9
        var top = -1.0e9
        for x in [-1.22, 1.22] {
            for y in [-1.22, 1.22] {
                for z in [-1.22, 1.22] {
                    let corner = (p.at * vec4(x, y, z, 1.0)).xyz
                    assert(
                        length(corner - p.at[3].xyz) <= p.reach + 1.0e-4,
                        "instance bound missed its mesh",
                    )
                    bottom = min(bottom, corner.y)
                    top = max(top, corner.y)
                }
            }
        }
        assert(
            bottom < 2.0 && top > 2.0 && top < 3.0,
            "bank stone was not partly buried below floating clearance",
        )
    }
}

@test
fn stream_bank_stones_follow_both_margins_with_a_fixed_bound() {
    let course = land::water::Course {
        points: Vec::from([vec4(0.0, 0.0, 4.0, 0.4), vec4(0.0, 80.0, 4.0, 0.4)]),
        falls: false,
    }
    let rocks = bank_stones([course.clone()])
    let again = bank_stones([course.clone()])
    assert(rocks.len() > 30 && rocks.len() <= BANK_STONE_LIMIT, "no useful bounded bank cover")
    assert(rocks.len() == again.len(), "bank placement count changed")
    var left = 0
    var right = 0
    for i in 0..rocks.len() {
        let p = place(rocks[i])
        assert(p == place(again[i]), "bank placement changed for the same course")
        assert(abs(p.x) >= 2.0 && abs(p.x) < 3.0, f"bank stone left its water margin at {p}")
        assert(p.y >= -2.0 && p.y <= 82.0, "bank stone went beyond the course")
        if p.x < 0.0 { left += 1 } else { right += 1 }
    }
    assert(left > 0 && right > 0, "only one creek bank received stones")
    let long = land::water::Course {
        points: Vec::from([vec4(0.0, 0.0, 4.0, 0.4), vec4(0.0, 100000.0, 4.0, 0.4)]),
        falls: false,
    }
    assert(
        bank_stones([take long]).len() <= BANK_STONE_LIMIT,
        "long water exceeded its geometry budget",
    )
    let fall = land::water::Course { falls: true, ..course }
    assert(bank_stones([take fall]).is_empty(), "bank stones float beside a waterfall")
}

/// What's built, as the interest check sees it (`interest::Evidence::solids`): each thing's
/// place, radius and height (x, z, radius, height): a stone or a slab, the tower, and a wall as
/// a post each metre along it.
pub fn solids(m: Map) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for b in built(m) {
        match b {
            Built::Stone { at, radius, squash, .. } => {
                out.push(vec4(at, radius * max(squash.x, squash.z), 2.0 * radius * squash.y))
            },
            Built::Standing { at, half, .. } => {
                out.push(vec4(at, max(half.x, half.z), 2.0 * half.y))
            },
            Built::Block { at, half, .. } => out.push(vec4(at, max(half.x, half.z), 1.6 * half.y)),
            Built::Waystone { at, tall, .. } => out.push(vec4(at, 0.4, tall + 0.2)),
            Built::Tower { at } => {
                out.push(vec4(at, stones::TOWER_FOOT, stones::TOWER_TALL))
            },
            Built::Wall { a, b, tall, .. } => {
                let n = u32(ceil(length(b - a)))
                for i in 0..(n + 1) {
                    out.push(vec4(mix(a, b, vec2(f32(i) / f32(max(n, 1)))), 0.45, tall))
                }
            },
            // (The heightfield holds a crag's rock for the check: its slabs only draw its faces.)
            Built::Rock { .. } => {},
        }
    }
    out
}

/// Where a built thing stands on the map (its middle).
pub fn place(b: Built) -> vec2 {
    match b {
        Built::Stone { at, .. } => at,
        Built::Standing { at, .. } => at,
        Built::Block { at, .. } => at,
        Built::Waystone { at, .. } => at,
        Built::Tower { at } => at,
        Built::Wall { a, b, .. } => 0.5 * (a + b),
        Built::Rock { at, .. } => at.xz,
    }
}

/// Which of `built` stands nearest `at` (its index; 0 if there are none).
pub fn nearest(built: Vec<Built>, at: vec2) -> u32 {
    var near = 0
    var best = 1.0e9
    for i in 0..built.len() {
        let d = length(place(built[i]) - at)
        if d < best {
            near = i
            best = d
        }
    }
    near
}

/// How far a built thing reaches from its place (m: its realized mesh's origin), for culling.
pub fn reach(b: Built) -> f32 {
    match b {
        Built::Stone { radius, squash, .. } => radius * max(squash.x, max(squash.y, squash.z)) +
            0.5,
        Built::Standing { half, .. } => 2.0 * max(half.x, max(half.y, half.z)) + 0.5,
        Built::Block { half, .. } => length(half) + 0.5,
        Built::Waystone { tall, .. } => tall + 0.7,
        Built::Tower { .. } => stones::TOWER_FOOT + stones::TOWER_TALL,
        Built::Wall { a, b, tall, .. } => 0.5 * length(b - a) + tall + 0.5,
        Built::Rock { bed, .. } => length(bed.hi - bed.lo),
    }
}

/// A coarser mesh of a built thing to draw from far off, for the tower alone.
pub fn realize_far(b: Built, height: fn(vec2) -> f32) -> Option<Realized> {
    match b {
        Built::Tower { at } => Some(realize_tower_far(vec3(at.x, height(at), at.y))),
        _ => None,
    }
}

/// Built thing `b` realized, standing on the ground (`height`).
pub fn realize(b: Built, height: fn(vec2) -> f32) -> Realized {
    match b {
        Built::Stone { at, radius, squash, seed } => {
            let y = height(at) + radius * squash.y * (if squash.y > 1.5 { 0.85 } else { 0.35 })
            realize_stone(
                radius: radius,
                squash: squash,
                seed: seed,
                at: vec3(at.x, y, at.y),
                turn: TAU * rand(seed, 4),
            )
        },
        Built::Standing { at, half, turn, seed } => realize_slab(
            vec3(at.x, height(at), at.y),
            half,
            seed,
            turn,
        ),
        Built::Block { at, half, seed } => realize_block(
            vec3(at.x, height(at), at.y),
            half,
            seed,
            TAU * rand(seed, 5),
        ),
        Built::Waystone { at, tall, seed } => realize_waystone(
            vec3(at.x, height(at), at.y),
            tall,
            seed,
            TAU * rand(seed, 5),
        ),
        Built::Tower { at } => realize_tower(vec3(at.x, height(at), at.y)),
        Built::Wall { a, b, tall, seed } => realize_wall(
            vec3(a.x, height(a), a.y),
            vec3(b.x, height(b), b.y),
            tall,
            seed,
        ),
        Built::Rock { at, bed } => realize_bed(bed, at),
    }
}

@test
fn bank_stones_settle_on_shelves_and_not_cut_faces() {
    let c = land::water::Course {
        points: Vec::from([vec4(0.0, 0.0, 4.0, 0.4), vec4(0.0, 80.0, 4.0, 0.4)]),
        falls: false,
    }
    let cliff = bank_instances([take c], |p| 2.0 * p.x)
    assert(cliff.placements.is_empty(), "loose stones perched on a cut bank")
}
