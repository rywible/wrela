// What the map lens (`wrela tool studio -- games/last-green`, #55 AC13) reads of the floor: its
// map as its literals say now, its ground, its preview (the history at the preview's grain,
// checked as the bake is: with the crowns as they're drawn and the built things), and its
// geology. The game never calls these, so none of it is in its build.

use engine::footing::obstacles_of
use engine::grow::{Ground, PREVIEW, simulate}
use engine::interest::{Evidence, Preview, QUICK, check}
use engine::landform::{Landscape, Survey}
use engine::place::Map

/// The floor's map.
pub fn map() -> Map {
    map::map()
}

/// The ground's height at `p`.
pub fn height(p: vec2) -> f32 {
    Ground::height(ground::GROUND, p.x, p.y)
}

/// The preview: the history at the preview's grain over the history's domain, and the check on
/// it (`interest::QUICK`), with the streams it found.
pub fn preview() -> Preview {
    let m = map::map()
    let lo = history::domain_lo()
    let hi = history::domain_hi()
    let st = stones::stones(m)
    let h = simulate(
        ground::GROUND,
        m,
        species::HABITS,
        PREVIEW,
        lo,
        hi,
        st,
        history::past,
    )
    let streams = h.streams.clone()
    let o = obstacles_of(h.trees, species::HABITS, h.streams, st, stones::walls(m), lo, hi)
    var e = Evidence::of(h)
    e.crowns = trees::drawn_crowns(e.trees)
    e.solids = blockouts::solids(m)
    Preview { checked: check(ground::GROUND, m, species::HABITS, e, o, st, QUICK), streams }
}

/// The floor's square as its making left it (`geology::square`), for the lens.
@fuel(2 ** 42)
const SQUARE_LAND: Landscape = geology::square(geology::WORLD.land.region)

/// The world's geology as an agent surveys it: the floor's square as its making left it, how much
/// each cell rose or was cut from the old land, the land as the bare view draws it over the same
/// cells, the floor's square's cells, and the places found in it.
pub fn geology() -> Survey {
    borrow w = geology::WORLD
    let grid = SQUARE_LAND.grid
    Survey {
        made: SQUARE_LAND.clone(),
        rise: Vec::from_fn(
            grid.cells(),
            |c| SQUARE_LAND.heights[c] - geology::old_land(grid.centre(c)),
        ),
        surface: Vec::from_fn(grid.cells(), |c| {
            let p = grid.centre(c)
            w.land.at(p.x, p.y)
        }),
        counted: Vec::from_fn(grid.cells(), |c| {
            let p = grid.centre(c)
            p.x >= map::LO.x && p.y >= map::LO.y && p.x < map::HI.x && p.y < map::HI.y
        }),
        places: w.places.clone(),
        names: w.names.clone(),
    }
}
