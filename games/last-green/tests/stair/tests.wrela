// The tool tests: the stair's and the floors' builds (test builds, with their `@testing`
// exports) written side by side into `scratch/<tour>/`, as a game ships them, and the stair
// loaded on the machine's hardware GPU with a 64 × 64 screen and its storage in
// `scratch/<tour>/store`. Each frame is at time 0; the stair's `report` says where the player
// is, and its doors; `running` says which build runs.

use hosts::steps::{replaced, text_of, written}
use std::tool::drive
use std::tool::drive::{Ran, Scalar, Seen, Step}
use std::tool::files
use std::tool::toolchain
use std::tool::toolchain::Override

/// The screen's size.
const SIZE: u32 = 64

/// The stair's report's doors: the first door's state times 4, plus the second's (0 shut, 1
/// open, 2 gone).
const SHUT: f32 = 4.0
const BOTH_OPEN: f32 = 5.0
const SECOND_GONE: f32 = 6.0

/// The workspace's packages a floor's build reads for its dependencies.
fn overrides() -> Vec<Override> {
    var out: Vec<Override> = Vec::new()
    out.push(Override { name: String::from("engine"), dir: String::from("repo/engine") })
    out.push(Override { name: String::from("platform"), dir: String::from("repo/platform") })
    out
}

/// The package at `pkg` built as a test build into `out`.
fn built(pkg: str, out: str) {
    var options = toolchain::options()
    options.testing = true
    options.overrides = overrides()
    hosts::steps::built(pkg, out, options, f"{pkg} builds")
}

/// The stair at `scratch/<tour>/stair`, loaded with its storage in `scratch/<tour>/store`, and
/// `init` run.
fn loaded(tour: str) -> drive::Build {
    let _ = files::make_dirs(f"scratch/{tour}/store").wait()
    var load = drive::gpu()
    load.width = SIZE
    load.height = SIZE
    load.storage = String::from(f"scratch/{tour}/store")
    let Ok(it) = drive::load(f"scratch/{tour}/stair", load).wait() else {
        panic("the stair loads on a hardware GPU")
    }
    stepped(it.build, [Step::Init], "init")
    it.build
}

/// `list` run on `h`, none of it trapping (`what` names it in a trap's message): what it saw.
fn stepped(h: drive::Build, list: [Step], what: str) -> Seen {
    let Ok(seen) = drive::steps(h, list).wait() else { panic(f"{what}'s request") }
    if let Some(trap) = seen.trap {
        panic(f"{what}: {trap.message.as_str()}")
    }
    seen
}

/// A call of the export `name` with `args`.
fn call(name: str, args: take Vec<Scalar>) -> Step {
    Step::Call(String::from(name), take args)
}

/// `before`, then `n` frames, each at time 0, then `after`.
fn framed(before: take Vec<Step>, n: u32, after: take Vec<Step>) -> Vec<Step> {
    var list = take before
    for _ in 0..n {
        list.push(Step::FrameAt(0.0))
    }
    var after = take after
    list.append(mut after)
    list
}

/// A call of `report`.
fn report() -> Step {
    call("report", Vec::new())
}

/// The results of a call, as `f32`s.
fn results(ran: Ran) -> Vec<f32> {
    var out: Vec<f32> = Vec::new()
    for r in ran.results {
        match r {
            Scalar::F32(x) => out.push(x),
            _ => panic("a call gives floats"),
        }
    }
    out
}

/// The results of the last call of `seen`'s steps, as `f32`s.
fn last(seen: Seen) -> Vec<f32> {
    results(seen.ran[seen.ran.len() - 1])
}

/// The last part of the root path of the build that runs, as `seen`'s `Running` step saw it.
fn running(seen: Seen) -> String {
    borrow at = seen.running[0]
    var start = 0
    for i in 0..at.len() {
        if at.byte(i) == 47 {
            start = i + 1
        }
    }
    String::from(at.as_str().slice(start, at.len()))
}

/// A call's arguments: `f32`s.
fn floats(xs: [f32]) -> Vec<Scalar> {
    var out: Vec<Scalar> = Vec::new()
    for x in xs {
        out.push(Scalar::F32(x))
    }
    out
}

/// A call's arguments: integers.
fn ints(xs: [i32]) -> Vec<Scalar> {
    var out: Vec<Scalar> = Vec::new()
    for x in xs {
        out.push(Scalar::I32(x))
    }
    out
}

/// A tour's builds: the test floor's and the stair's, side by side.
fn tower(tour: str) {
    built("repo/games/last-green/test-floor", f"scratch/{tour}/test-floor")
    built("repo/games/last-green/stair", f"scratch/{tour}/stair")
}

/// Frames until `wanted` holds of the report's door `door` (equal to `value`, or unequal if
/// not `equal`), for at most a minute of the build's time: the last report.
fn frames_until(h: drive::Build, door: u32, value: f32, equal: bool) -> Vec<f32> {
    var latest = last(stepped(h, [report()], "report"))
    var since = 0.0
    var first = true
    while (latest[door] == value) != equal {
        let seen = stepped(h, [Step::FrameAt(0.0), report()], "a frame")
        latest = last(seen)
        // When the frame ended, in seconds since the build loaded.
        let at = seen.ran[0].started + seen.ran[0].elapsed
        if first {
            since = at
            first = false
        } else if at - since > 60.0 {
            break
        }
    }
    latest
}

/// Up to the second door, through it, the floor freed, and back out.
fn walk_through_and_back(h: drive::Build) {
    let first = last(stepped(h, framed(Vec::new(), 2, Vec::from([report()])), "report"))
    assert(first[2] == SHUT, "a new tower: the first door opens, the second doesn't")
    let climbed = stepped(
        h,
        framed(
            Vec::from([call("climb", floats([32.0])), call("go_in", Vec::new())]),
            2,
            Vec::from([Step::Running]),
        ),
        "the climb",
    )
    assert(running(climbed).as_str() == "stair", "the second door is shut")
    let decided = stepped(
        h,
        framed(Vec::from([call("test_decide", ints([0, 1]))]), 1, Vec::from([report()])),
        "the decision",
    )
    assert(last(decided)[2] == BOTH_OPEN, "the first world preserved: the second door opens")
    let ready = frames_until(h, door: 3, value: 1.0, equal: true)
    assert(ready[3] == 1.0, "the test floor's build is ready")
    let inside = stepped(
        h,
        framed(Vec::from([call("go_in", Vec::new())]), 2, Vec::from([Step::Running, report()])),
        "going in",
    )
    let name = running(inside)
    assert(name.as_str() == "test-floor", f"{name.as_str()} runs, not the test floor")
    let arrived = last(inside)
    assert(arrived[2] == 1.0 && arrived[3] == 0.0, "arrived, the floor undecided")
    let out = stepped(
        h,
        framed(
            Vec::from([call("test_decide", ints([2])), call("go_out", Vec::new())]),
            2,
            Vec::from([Step::Running, report()]),
        ),
        "going out",
    )
    let back = running(out)
    assert(back.as_str() == "stair", f"{back.as_str()} runs, not the stair")
    let v = last(out)
    assert(
        v[0] == 32.0 && v[1] == 1.0 && v[2] == SECOND_GONE,
        "back at the second door, which is gone",
    )
    let again = stepped(
        h,
        framed(Vec::from([call("go_in", Vec::new())]), 2, Vec::from([Step::Running])),
        "going in again",
    )
    assert(running(again).as_str() == "stair", "a freed world can't be gone back to")
}

/// The tour `tour` built and the stair loaded.
fn toured(tour: str) -> drive::Build {
    tower(tour)
    loaded(tour)
}

/// The player climbs to the second door, which opens once the first world is decided, walks
/// through to the test floor, frees it, and walks back out; the freed world's door is gone.
@test(tool, read: [("repo", "../../../..")], budget: 300)
fn the_player_walks_through_the_second_door_and_back() {
    walk_through_and_back(toured("tower-walk"))
}

/// The tower is saved: after the walk (and frames for the save, written in the background), the
/// stair loaded again over the same storage stands at the last door, the world freed.
@test(tool, read: [("repo", "../../../..")], budget: 300)
fn the_tower_is_saved_over_a_reload() {
    let b = toured("tower-reload")
    walk_through_and_back(b)
    stepped(b, framed(Vec::new(), 4, Vec::new()), "the save's frames")
    let _ = drive::close(b).wait()
    let a = loaded("tower-reload")
    let v = frames_until(a, door: 2, value: SHUT, equal: false)
    assert(v[0] == 32.0 && v[2] == SECOND_GONE, "at the last door, the world freed")
}

/// The line of `text` that starts with `start`.
fn line_starting(text: str, start: str) -> String {
    var at = 0
    while at < text.len() {
        var end = at
        while end < text.len() && text.byte(end) != 10 {
            end += 1
        }
        let line = text.slice(at, end)
        if line.starts_with(start) {
            return String::from(line)
        }
        at = end + 1
    }
    panic(f"no line starts with `{start}`")
}

/// The first floor's real gate and door declarations and exit operation, on the small test
/// floor: the stair's first landing and round trip, without baking the floor's world.
@test(tool, read: [("repo", "../../../..")], budget: 300)
fn the_first_floor_door_returns_to_its_stair_landing() {
    var texts: Vec<String> = Vec::new()
    for file in ["main.wrela", "world.wrela", "test-floor/main.wrela"] {
        texts.push(String::from(f"repo/games/last-green/{file}"))
    }
    var read: Vec<String> = Vec::new()
    for k in 0..texts.len() {
        read.push(text_of(texts[k].as_str()))
    }
    let gate = line_starting(read[1].as_str(), "pub const GATE =")
    let door = line_starting(read[0].as_str(), "const DOOR =")
    let floor = read[0].as_str()
    let Some(at) = floor.find("pub fn test_leave(") else { panic("the floor's test_leave") }
    let after = floor.slice(at + 18, floor.len())
    let Some(end) = after.find("\n}") else { panic("test_leave's end") }
    let leave = String::from(after.slice(0, end))
    var source = replaced(read[2].as_str(), "const WORLD: u32 = 1", "const WORLD: u32 = 0")
    source = replaced(
        source.as_str(),
        "const DOOR = Doorway { at: vec2(0.0, 0.6), reach: 1.2 }",
        door.as_str(),
    )
    let main = String::from(
        f"{gate.as_str()}\n{source.as_str()}\n@testing\npub fn test_leave({leave.as_str()}\n}}\n",
    )
    written("scratch/first-floor-source/main.wrela", main)
    let manifest = String::from(
        "[package]\nname = \"first_floor\"\n\n[dependencies]\nengine = { workspace = true }\nplatform = { workspace = true }\n",
    )
    written("scratch/first-floor-source/wrela.toml", manifest)
    built("scratch/first-floor-source", "scratch/first-floor-tour/last-green")
    built("repo/games/last-green/stair", "scratch/first-floor-tour/stair")
    let h = loaded("first-floor-tour")
    let up = framed(
        Vec::new(),
        2,
        Vec::from([call("climb", floats([16.0])), call("go_in", Vec::new())]),
    )
    let climbed = stepped(h, framed(take up, 2, Vec::from([Step::Running])), "the climb")
    let name = running(climbed)
    assert(name.as_str() == "last-green", f"{name.as_str()} runs, not the first floor")
    // The gate is at (-1.5, -2.0); the door 5 m behind it.
    let checks = [
        (-1.5, -2.0, 0.0, "the gate isn't the door"),
        (-1.5, -7.0, 1.0, "the door goes back down"),
    ]
    var list: Vec<Step> = Vec::new()
    for k in 0..2 {
        let (x, z, _, _) = checks[k]
        list.push(call("test_leave", floats([x, z])))
    }
    let left = stepped(
        h,
        framed(take list, 2, Vec::from([Step::Running, report()])),
        "leaving",
    )
    for k in 0..2 {
        let (_, _, want, why) = checks[k]
        assert(results(left.ran[k])[0] == want, why)
    }
    let back = running(left)
    assert(back.as_str() == "stair", f"{back.as_str()} runs, not the stair")
    let v = last(left)
    assert(v[0] == 16.0 && v[1] == 1.0, "arrived back at the first door")
}
