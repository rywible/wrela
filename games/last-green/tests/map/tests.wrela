// The tool tests: each writes a package into `scratch` holding the floor's map files (and the
// modules its checks need) copied from games/last-green, and a main module, then runs its tests
// (each must pass, and as many must run as its files declare) or builds it, with the engine and
// the content it names read from the workspace.

use hosts::steps::{declared, text_of, written}
use std::tool::toolchain
use std::tool::toolchain::Override

/// The floor's files that make its map.
const MAP_FILES: [Text; 4] = ["map.wrela", "ground.wrela", "species.wrela", "stones.wrela"]

/// A main module that does nothing else.
const FRAME: Text = "pub fn frame(time: f32, width: u32, height: u32) {}\n"

/// The bounded history the simulation's package has in place of the game's: no baked wood, a short tour.
const HISTORY: [Text; 10] = [
    "",
    "use land::footing::Obstacles",
    "",
    "pub const OBSTACLES: Obstacles = Obstacles::of(Vec::new(), vec2(-128.0), vec2(128.0))",
    "pub const TOUR: Vec<vec2> = Vec::from([vec2(0.0, 16.0), vec2(16.0, 16.0)])",
    "",
    "pub fn tiles_lo() -> vec2i { vec2i(-1) }",
    "pub fn tiles_hi() -> vec2i { vec2i(1) }",
    "pub fn draw_at(at: vec2) -> f32 { 0.0 }",
    "",
]

/// The bounded wildwood the simulation's package has in place of the game's.
const WILDWOOD: [Text; 13] = [
    "",
    "pub const REACH: f32 = 60.0",
    "pub const MOST_TRUNKS: u32 = 512",
    "pub const EGG = vec2(32.0)",
    "pub const ROAD_START = vec2(16.0)",
    "",
    "pub fn road_points(every: f32) -> Vec<vec2> {",
    "    Vec::from([ROAD_START, EGG])",
    "}",
    "",
    "pub fn trunks_round(at: vec2, reach: f32) -> Vec<vec4> { Vec::new() }",
    "pub fn covered(last: vec4, count: u32, around: vec2) -> f32 { REACH }",
    "",
]

