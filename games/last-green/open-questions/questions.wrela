// The Last Green's open questions (wrela.toml): its tests that fail on what the game should do.
use std::io::print

/// AC9's where it lies: a stream's water is within 10 cm of a skin over the ground
/// (`engine::water::SKIN`) at every sample of its course (`tests::course_samples`), but in a
/// mere's reach.
///
/// The question: a stream of the history's (4 m wide) runs 2.9 m off its ravine's middle, where
/// the ravine's flat floor is 7.5 m wide, so its outer metre lies up the ravine's wall (the
/// ground rises 1.8 m over 0.8 m there). The water is laid a skin over the ground at each point
/// of its mesh, and between them it's 12 cm over it at (-33.1, -282.9): 1 of the 260 samples.
/// Should a stream keep to its ravine's floor (its course or its width), the ravine be cut where
/// the stream runs, or the water lie on the wall?
@test
fn a_streams_water_lies_a_skin_over_its_ground() {
    let w = last_green::map::map().water
    let laid = last_green::history::waters()
    let g = last_green::ground::GROUND
    var worst = 0.0
    var worst_at = vec2(0.0)
    var off = 0
    var samples = 0
    for (p, falls) in last_green::tests::course_samples(laid) {
        let ground = g.at(p.x, p.y)
        let in_mere = length(p - w.meres[0].xy) < w.meres[0].z * engine::water::MERE_REACH &&
            ground < w.meres[0].w
        if !falls && !in_mere {
            let skin = laid.surface(p) - ground - engine::water::SKIN
            if abs(skin) >= 0.1 {
                off += 1
            }
            if abs(skin) > abs(worst) {
                worst = skin
                worst_at = p
            }
            samples += 1
        }
    }
    print(
        f"{off} of {samples} points of the streams off their skin, the most {worst} m at {worst_at}",
    )
    assert(off == 0, f"a stream's water at {worst_at} is {worst} m off its skin")
}

/// The outside audit's point 6: each place on the floor with a sound of its own
/// (`tests::place_sounds`) is 3 dB or more from every other's in some band.
///
/// The question: the waterfall's place (the lookbook's shot, its eye on the bank 4 m from the
/// stream below the fall) is 64 m from the fall, which comes down into the gorge. In every band
/// it sounds within 2 dB of the mere's place (its shot wades in, 11 m from a stream) and within
/// 0.2 dB of the mere's shore, and those two are within 1.8 dB: a stream near each is what they
/// hear most. Should the waterfall's place stand nearer the fall, the fall's roar carry further,
/// the mere sound more its own, or these places sound alike?
@test
@fuel(2 ** 40)
fn each_place_on_the_floor_sounds_its_own() {
    let places = last_green::tests::place_sounds()
    var alike = 0
    for i in 0..places.len() {
        for j in (i + 1)..places.len() {
            let ((a, pa), (b, pb)) = (places[i], places[j])
            let d = abs(pa - pb)
            let most = max(max(d.x, d.y), max(d.z, d.w))
            if most < 3.0 {
                print(f"{a} and {b} sound alike: {most} dB apart at most")
                alike += 1
            }
        }
    }
    assert(alike == 0, f"{alike} pairs of the floor's places sound alike")
}
