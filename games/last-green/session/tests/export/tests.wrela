// The tool test: the session's main.wrela with `FIXTURE` after it (exports that set up a failed
// recovery, export it, answer the reply, and back up before a new game), built as a package of
// its own and loaded on the CPU for each case, recording its commands: which slot the export
// goes to and whether its reply succeeds.

use hosts::steps::{recorded, text_of, written}
use std::tool::drive
use std::tool::drive::{Scalar, Seen, Step}
use std::tool::toolchain
use std::tool::toolchain::Override

/// Each case: the export's other slot (0: `continue`, 1: `imported`), and whether its reply
/// succeeds.
const CASES: [(u32, u32); 3] = [(0, 0), (0, 1), (1, 1)]

/// What the fixture writes the backup to, and the request it says what it expects by.
const BACKUP: Text = "profiles/player-1/previous"
const EXPECTED: Text = "app/fixture/expected"

const FIXTURE: [Text; 73] = [
    "",
    "pub fn fixture_export(s: mut Session, other_slot: u32) {",
    "    s = failed_recovery_fixture()",
    "    let slot = if other_slot == 0 { \"continue\" } else { \"imported\" }",
    "    let request = Request::Export { profile: s.active.clone(), slot: slot.to_string() }",
    "    begin(mut s, request)",
    "    if s.phase == Phase::ReadSlot {",
    "        let file = SaveFile {",
    "            game: String::from(GAME),",
    "            version: 1,",
    "            saved: 17,",
    "            body: s.recovered.clone(),",
    "        }",
    "        answered(mut s, Ok(save(file)))",
    "    }",
    "    assert(s.phase == Phase::Reply)",
    "}",
    "",
    "pub fn fixture_reply(s: mut Session, succeeded: u32) -> u32 {",
    "    let recovered = s.recovered.clone()",
    "    let exported_recovery = match s.request {",
    "        Some(Request::Export { profile, slot }) => profile == s.active && slot == \"continue\",",
    "        _ => false,",
    "    }",
    "    if succeeded != 0 {",
    "        answered(mut s, Ok(Vec::new()))",
    "    } else {",
    "        var reply = None",
    "        match mut s.io {",
    "            Some(p) => reply = p.poll(),",
    "            None => {},",
    "        }",
    "        let Some(reply) = reply else { return 0 }",
    "        assert(reply.is_err(), \"the CPU host has no parent channel\")",
    "        answered(mut s, reply)",
    "    }",
    "    assert(s.phase == Phase::Idle)",
    "    assert(s.recovered == recovered, \"export must preserve recovery bytes\")",
    "    let request = Request::Prepare { profile: s.active.clone(), slot: String::new() }",
    "    begin(mut s, request)",
    "    if succeeded != 0 && exported_recovery {",
    "        if s.phase == Phase::Backup { 1 } else { 0 }",
    "    } else {",
    "        if s.phase == Phase::Reply { 1 } else { 0 }",
    "    }",
    "}",
    "",
    "pub fn fixture_backup(s: mut Session) {",
    "    assert(s.phase == Phase::Backup)",
    "    let stale = SaveFile {",
    "        game: String::from(GAME),",
    "        version: 1,",
    "        saved: 17,",
    "        body: save(",
    "            CarryFixture {",
    "                tower: tower::rule::Tower::new(2),",
    "                at: 0,",
    "                door: STAIR,",
    "                going: 0xFFFFFFFE,",
    "            },",
    "        ),",
    "    }",
    "    answered(mut s, Ok(save(stale)))",
    "    assert(s.phase == Phase::BackupSaved)",
    "    let expected = SaveFile {",
    "        game: String::from(GAME),",
    "        version: 1,",
    "        saved: s.saved,",
    "        body: s.recovered.clone(),",
    "    }",
    "    let _ = std::host::custom(\"fixture/expected\", save(expected))",
    "}",
    "",
]

/// The fixture package, written into `scratch/session` and built into `scratch/build`.
fn built() {
    var main = text_of("repo/games/last-green/session/main.wrela")
    for k in 0..FIXTURE.len() {
        if k > 0 {
            main.push_str("\n")
        }
        main.push_str(FIXTURE[k])
    }
    written("scratch/session/main.wrela", main)
    written("scratch/session/wrela.toml", text_of("repo/games/last-green/session/wrela.toml"))
    var options = toolchain::options()
    options.overrides.push(
        Override { name: String::from("tower"), dir: String::from("repo/games/last-green/tower") },
    )
    options.overrides.push(
        Override { name: String::from("platform"), dir: String::from("repo/platform") },
    )
    hosts::steps::built("scratch/session", "scratch/build", options, "the session fixture builds")
}

/// `list` run on `h`, none of it trapping: what it saw.
fn stepped(h: drive::Build, list: [Step]) -> Seen {
    let Ok(seen) = drive::steps(h, list).wait() else { panic("the steps' request") }
    if let Some(trap) = seen.trap {
        panic(f"{trap.message.as_str()} {trap.panic.as_str()}")
    }
    seen
}

/// A call of the export `name` with `args`.
fn call(name: str, args: take Vec<Scalar>) -> Step {
    Step::Call(String::from(name), take args)
}

/// Console policy is Wrela: exporting a recovered save acknowledges only a successful reply,
/// to either slot, and only an export of the recovery to `continue` that succeeds makes the next
/// new game back it up first; that backup is the current recovered continuation.
@test(tool, read: [("repo", "../../../../..")], budget: 300)
fn exporting_a_recovered_save_acknowledges_only_a_successful_reply() {
    built()
    for k in 0..CASES.len() {
        let (other_slot, succeeded) = CASES[k]
        // The build, loaded on the CPU recording its commands: `init`, the export, its reply.
        var load = drive::cpu()
        load.record = true
        let Ok(it) = drive::load("scratch/build", load).wait() else { panic("the session loads") }
        let h = it.build
        let seen = stepped(
            h,
            [
                Step::Init,
                call("fixture_export", Vec::from([Scalar::I32(i32(other_slot))])),
                call("fixture_reply", Vec::from([Scalar::I32(i32(succeeded))])),
            ],
        )
        let replied = match seen.ran[2].results[0] {
            Scalar::I32(x) => u32(x),
            _ => panic("fixture_reply gives a number"),
        }
        assert(replied == 1, f"other slot={other_slot}, successful reply={succeeded}")
        if other_slot == 0 && succeeded == 1 {
            // The commands until now, dropped; then the backup's.
            recorded(h)
            stepped(h, [call("fixture_backup", Vec::new())])
            let commands = recorded(h)
            var backup: Vec<Vec<u8>> = Vec::new()
            var expected: Vec<Vec<u8>> = Vec::new()
            for j in 0..commands.len() {
                let kind = commands[j].kind.as_str()
                let target = commands[j].target.as_str()
                if kind == "StorageWrite" && target == BACKUP {
                    backup.push(commands[j].bytes.clone())
                } else if kind == "HostRequest" && target == EXPECTED {
                    expected.push(commands[j].bytes.clone())
                }
            }
            assert(expected.len() == 1, "one current recovery envelope")
            assert(
                backup.len() == expected.len() && backup[0] == expected[0],
                "New game backs up the current recovered continuation",
            )
        }
    }
}
