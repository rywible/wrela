// The game's small session program: save policy before its renderer is loaded. The policy is
// platform's (`platform::session`); this program gives it the game's tower snapshot.
use engine::tower::{Carry, STAIR}
use platform::protocol::{Request, SaveFile}
use platform::session
// `begin` and `answered` are for the export tool test's fixtures (tests/export).
use platform::session::{Game, Phase, answered, begin, checked, slot_file}
use std::serialize::{LoadError, Serialize, load, save}

const GAME: Text = "last-green"

/// Last Green to its session program.
pub struct LastGreen: Copy {}

pub type Session = session::Session<LastGreen>

impl Game for LastGreen {
    fn name(self) -> Text {
        GAME
    }

    fn save_path(self) -> Text {
        "tower/save"
    }

    fn entry(self) -> Text {
        "../last-green"
    }

    fn foreign_import(self) -> Text {
        "This file is not a supported Last Green save."
    }

    /// Only this game interprets its tower snapshot: a carry at rest (`carry_at_rest`).
    fn body(self, bytes: Vec<u8>) -> Option<Vec<u8>> {
        let Some(carry) = carry_at_rest(bytes) else { return None }
        Some(save(carry))
    }

    fn description(self, body: Vec<u8>) -> String {
        let carry: Result<Carry, LoadError> = load(body.clone())
        let at = match carry {
            Ok(c) => c.at,
            Err(_) => STAIR,
        }
        if at == STAIR { String::from("Staircase") } else { f"World {at + 1}" }
    }

    /// The build of the carry's place: the stair, the test floor, or the game.
    fn resume(self, body: Vec<u8>) -> Option<Text> {
        let carry: Result<Carry, LoadError> = load(body.clone())
        let Ok(c) = carry else { return None }
        Some(if c.at == STAIR { "../stair" } else if c.at == 1 { "../test-floor" } else {
            "../last-green"
        })
    }
}

pub fn init() -> Session {
    session::init(LastGreen {})
}

pub fn frame(s: mut Session, time: f32, width: u32, height: u32) {
    session::frame(mut s)
}

fn valid_carry(carry: Carry) -> bool {
    carry.tower.worlds() == 2 &&
        (carry.at == STAIR || carry.tower.door_open(carry.at)) &&
        (carry.door == STAIR || carry.door < 2)
}

fn carry_at_rest(bytes: Vec<u8>) -> Option<Carry> {
    let loaded: Result<Carry, LoadError> = load(bytes.clone())
    let Ok(c) = loaded else { return None }
    var carry = c.clone()
    // A player can free this world, then return before walking through its exit.
    // Its tower decision is durable, but the next playable destination is the stair.
    if carry.tower.worlds() == 2 &&
        carry.at < 2 &&
        carry.tower.fate(carry.at) == engine::tower::Fate::Freed {
        if carry.at != 0 && carry.tower.fate(carry.at - 1) == engine::tower::Fate::Undecided {
            return None
        }
        carry.at = STAIR
    }
    if !valid_carry(carry) { return None }
    Some(carry)
}

@test
fn foreign_or_truncated_saves_are_rejected_before_writing() {
    let file = SaveFile {
        game: String::from("different-game"),
        version: 1,
        saved: 0,
        body: Vec::new(),
    }
    assert(checked(LastGreen {}, save(file)).is_none())
    assert(checked(LastGreen {}, Vec::new()).is_none())
    assert(checked(LastGreen {}, Vec::filled(12, 255)).is_none())
}

// A serialization fixture can name fields that game callers cannot construct directly.
struct CarryFixture: Serialize { tower: engine::tower::Tower, at: u32, door: u32, going: u32 }

@test
fn imports_reject_locked_worlds_and_invalid_doors() {
    let file = |at: u32, door: u32| save(
        SaveFile {
            game: String::from(GAME),
            version: 1,
            saved: 0,
            body: save(
                CarryFixture { tower: engine::tower::Tower::new(2), at, door, going: 0xFFFFFFFE },
            ),
        },
    )
    assert(checked(LastGreen {}, file(0, STAIR)).is_some())
    assert(checked(LastGreen {}, file(1, STAIR)).is_none())
    assert(checked(LastGreen {}, file(0, 5)).is_none())
    assert(checked(LastGreen {}, file(4, STAIR)).is_none())
}

/// A session whose recovered continuation (a carry on the stair) could not be filed. The export
/// tool test (tests/export) starts its fixtures from it too.
fn failed_recovery_fixture() -> Session {
    Session {
        game: LastGreen {},
        phase: Phase::ReadSlot,
        io: None,
        incoming: None,
        request: None,
        call: 1,
        profile: String::from("player-1"),
        active: String::from("player-1"),
        slot: String::new(),
        entries: Vec::new(),
        list_slot: 0,
        bytes: Vec::new(),
        saved: 99,
        environment: None,
        entry: String::new(),
        launch: false,
        prepared: false,
        interrupted: false,
        recovery_failed: true,
        recovery_exported: false,
        recovered: save(
            CarryFixture {
                tower: engine::tower::Tower::new(2),
                at: STAIR,
                door: 0,
                going: 0xFFFFFFFE,
            },
        ),
    }
}

@test
fn recovery_failure_preserves_exports_of_other_slots() {
    let body = save(
        CarryFixture { tower: engine::tower::Tower::new(2), at: 0, door: STAIR, going: 0xFFFFFFFE },
    )
    let file = SaveFile { game: String::from(GAME), version: 1, saved: 17, body: body.clone() }
    var s = failed_recovery_fixture()
    for slot in ["imported", "previous"] {
        s.slot = slot.to_string()
        s.request = Some(
            Request::Export { profile: s.profile.clone(), slot: slot.to_string() },
        )
        let Some(exported) = slot_file(s, Ok(save(file))) else {
            assert(false, "the requested save is readable")
            return
        }
        assert(exported.saved == 17 && exported.body == body, "export must keep the requested slot")
    }
    s.request = Some(Request::List { profile: s.profile.clone() })
    let Some(recovered) = slot_file(s, Ok(save(file))) else {
        assert(false, "the uncommitted continuation must remain visible")
        return
    }
    assert(recovered.saved == 99 && recovered.body == s.recovered)
    s.list_slot = 1
    let Some(imported) = slot_file(s, Ok(save(file))) else {
        assert(false, "a listed import is readable")
        return
    }
    assert(imported.saved == 17 && imported.body == body)
    s.recovery_exported = true
    s.request = Some(
        Request::Prepare { profile: s.profile.clone(), slot: String::from("continue") },
    )
    let Some(continued) = slot_file(s, Ok(save(file))) else {
        assert(false, "the exported recovery can be continued")
        return
    }
    assert(continued.saved == 99 && continued.body == s.recovered)
    s.request = Some(
        Request::Prepare { profile: s.profile.clone(), slot: String::from("imported") },
    )
    let Some(prepared) = slot_file(s, Ok(save(file))) else {
        assert(false, "another prepared slot remains readable")
        return
    }
    assert(prepared.saved == 17 && prepared.body == body)
}

@test
fn a_freed_current_world_resumes_on_the_stair() {
    var tower = engine::tower::Tower::new(2)
    assert(tower.decide(0, engine::tower::Fate::Preserved))
    assert(tower.decide(1, engine::tower::Fate::Freed))
    let body = save(CarryFixture { tower, at: 1, door: 1, going: 0xFFFFFFFE })
    let file = SaveFile { game: String::from(GAME), version: 1, saved: 17, body }
    let Some(file) = checked(LastGreen {}, save(file)) else {
        assert(false, "freeing the current world must keep its save")
        return
    }
    let carry: Result<Carry, LoadError> = load(file.body.clone())
    match carry {
        Ok(c) => {
            assert(c.at == STAIR && c.door == 1)
            assert(c.tower.fate(1) == engine::tower::Fate::Freed)
        },
        Err(_) => assert(false, "the normalized carry remains readable"),
    }
    var locked = engine::tower::Tower::new(2)
    assert(locked.decide(1, engine::tower::Fate::Freed))
    let body = save(CarryFixture { tower: locked, at: 1, door: 1, going: 0xFFFFFFFE })
    let file = SaveFile { game: String::from(GAME), version: 1, saved: 17, body }
    assert(checked(LastGreen {}, save(file)).is_none(), "a locked world remains invalid")
}
