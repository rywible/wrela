// The floor's trees (#54 §9): what the history left, drawn. Each species is cooked as a few kinds
// (`engine::plant`, spike 17's shapes): grown in the open (crown low and wide) or in the forest
// (crown high and narrow), young, standing dead, burnt, fallen. A tile's trees are placed as it
// streams in: an instance of a kind for each tree the bake kept, scaled to its height, turned so
// its crown leans the way the history leaned it.

use engine::grow::{Cause, State, Tree, log_rot}
use engine::interest::Drawn
use engine::noise::{hash2u, noise2, pick, rand}
use engine::plant::{
    Bark, Instance, Leaves, Plant, RINGS, SIDES, bend, limb_axis, limb_at_height, limb_corner,
    limb_point, limb_ring_axis, plant, tint_of, unbend,
}
use std::field::Tube
use engine::vegetation::Placed
use great_tree::tree::great_tree
use map::PRESENT
use species::Species
use std::math::{PI, TAU}

// ---- the kinds ---------------------------------------------------------------------------------

/// The history's species, by their index (`species::Species`).
const OAK: u32 = u32(Species::Oak)
const BEECH: u32 = u32(Species::Beech)
const BIRCH: u32 = u32(Species::Birch)
const THORN: u32 = u32(Species::Thorn)
const BLACKTHORN: u32 = u32(Species::Sloe)
const PINE: u32 = u32(Species::Pine)

pub const GREAT: u32 = 0
pub const OAK_OPEN: u32 = 1
pub const OAK_FOREST: u32 = 2
pub const BEECH_OPEN: u32 = 3
pub const BEECH_FOREST: u32 = 4
pub const BIRCH_OPEN: u32 = 5
pub const BIRCH_FOREST: u32 = 6
pub const PINE_OPEN: u32 = 7
pub const PINE_FOREST: u32 = 8
pub const ALDER_A: u32 = 9
pub const ALDER_B: u32 = 10
pub const HAWTHORN: u32 = 11
pub const SLOE: u32 = 12
pub const YOUNG_BROAD: u32 = 13
pub const YOUNG_PINE: u32 = 14
pub const SNAG_BROAD: u32 = 15
pub const SNAG_BURNT: u32 = 16
pub const SNAG_PINE: u32 = 17
pub const LOG_SHORT: u32 = 18
pub const LOG_LONG: u32 = 19
pub const FAR_A: u32 = 20
pub const FAR_B: u32 = 21
pub const SNAG_STUMP: u32 = 22
pub const SNAG_FORKED: u32 = 23
pub const KINDS: u32 = 24

/// Each kind's height as it's built (m): an instance is scaled to its tree's.
const BUILT = [
    16.0, 18.0, 18.0, 20.0, 20.0, 15.0, 15.0, 22.0, 22.0, 15.0, 15.0, 5.0, 3.0, 3.0, 3.0, 16.0,
    16.0, 18.0, 12.0, 20.0, 15.0, 15.0, 16.0, 11.0,
]

/// A broad-leaved tree, seed `s`, `tall` high, grown as a tree grows rather than as a ball of
/// leaves on a stick: roots flaring into the ground round a trunk that curves a little and leans
/// toward +z (the light, once placed); scaffold limbs leaving the trunk at different heights and
/// headings (3 to 5); branches from each scaffold to clumps of leaves gathered in masses round
/// its end, with gaps between the masses. The crown spans `base` (a share of its height) to its
/// top and `width` (a share of its height) each way; its clumps are `clump` across (varied from
/// half again smaller to a third larger), `count` of them, `limbs` with branches of their own.
/// (Playing round 2, the owner: every limb left the trunk's top together, a broom; the crowns
/// were even blobs; there were no roots.)
fn broadleaf(
    s: u32,
    tall: f32,
    base: f32,
    width: f32,
    clump: f32,
    count: u32,
    limbs: u32,
    girth: f32,
    leaves: Leaves,
    bark: Bark,
) -> Plant {
    var p = plant(leaves, bark)
    let crown_y = tall * base
    let lean = vec3(pick(s, 4, lo: -0.3, hi: 0.3), 0.0, tall * 0.05)
    let top = vec3(0.0, crown_y, 0.0) + lean
    let kink = vec3(pick(s, 5, lo: -0.4, hi: 0.4), 0.0, pick(s, 6, lo: -0.4, hi: 0.4)) * girth
    // The trunk: wide at its foot, a little crooked, tapering up well into the crown as its
    // leader (stopped short at the crown's foot, it read as a broken stump).
    p.tube(
        [
            vec3(0.0, -0.6, 0.0),
            vec3(0.0, 0.5, 0.0),
            top * 0.55 + kink,
            top + vec3(0.0, (tall - crown_y) * 0.55, 0.0) + lean * 0.3,
        ],
        [girth * 1.6, girth * 1.1, girth * 0.82, girth * 0.16],
    )
    // Roots, uneven in size and spacing (a sapling has none).
    if girth > 0.1 {
        let roots = 4 + s % 3
        for k in 0..roots {
            let a = TAU * (f32(k) + 0.6 * rand(s, 140 + k)) / f32(roots)
            let out = girth * pick(s, 150 + k, lo: 1.8, hi: 3.4)
            let dir = vec3(cos(a), 0.0, sin(a))
            let across = vec3(-dir.z, 0.0, dir.x) * (out * pick(s, 155 + k, lo: -0.25, hi: 0.25))
            p.root(
                vec3(0.0),
                dir,
                girth,
                out,
                across,
                r: girth * pick(s, 160 + k, lo: 0.5, hi: 0.7),
            )
        }
    }
    // The scaffolds: each from its own height on the trunk, its heading turned by about the
    // golden angle from the last, rising toward the crown's shell.
    let scaffolds = if limbs == 0 { 0 } else { min(3 + s % 3, limbs) }
    var tips: Vec<vec3> = Vec::new()
    var branches: Vec<Tube<4>> = Vec::new()
    let w = tall * width
    for j in 0..scaffolds {
        let h = pick(s, 170 + j, lo: 0.5, hi: 1.0)
        let (foot, axis, radius) = limb_at_height(p.limbs[0], crown_y * h)
        let a = 2.39996 * f32(j) + pick(s, 180 + j, lo: -0.5, hi: 0.5)
        let reach = w * pick(s, 190 + j, lo: 0.55, hi: 0.95)
        let rise = (tall - crown_y) * pick(s, 200 + j, lo: 0.35, hi: 0.8)
        let tip = foot + vec3(cos(a) * reach, rise, sin(a) * reach)
        p.branch(
            foot,
            axis,
            foot + axis * (reach * 0.24) + (tip - foot) * 0.28,
            tip,
            r_from: radius * pick(s, 220 + j, lo: 0.36, hi: 0.54),
            r_to: girth * 0.07,
        )
        tips.push(tip)
        branches.push(p.limbs[p.limbs.len() - 1])
    }
    // The crown's shell over the scaffolds (low limbs under it, bare, read as dead sticks:
    // specimens, round 2).
    crown_on(mut p, s, tips, branches, tall, crown_y, lean, w, clump, count, limbs)
    p
}

/// A broad-leaved crown on its limbs: `count` clumps about `clump` across over its shell, an
/// ellipsoid from `crown_y` to `tall` and `w` each way, bulging over each of `tips` (each grown
/// from its foot in `branches`) and falling back between them; spread evenly over it (by the
/// golden angle), its lowest part left open so the limbs show under it, some left out for the sky
/// to show through (`CROWN_HOLES`), some deeper in; the first `limbs` twice over with a branch of
/// their own from the nearest scaffold. A sapling's (no tips) is the same shell, round its trunk's
/// top. (Masses round each scaffold's end, with gaps between, read as topiary: a few puffballs
/// on bare limbs; and before them, even blobs: the playing rounds.)
fn crown_on(
    p: mut Plant,
    s: u32,
    tips: Vec<vec3>,
    branches: Vec<Tube<4>>,
    tall: f32,
    crown_y: f32,
    lean: vec3,
    w: f32,
    clump: f32,
    count: u32,
    limbs: u32,
) {
    let scaffolds = tips.len()
    // At least two thirds as deep as it's wide each way, hanging from the tree's top: a crown, not
    // a cap (as deep as its trunk left it, crowns were flat discs: specimens, round 1).
    let half = max((tall - crown_y) * 0.5, CROWN_DEPTH * w)
    let mid = vec3(0.0, tall - half, 0.0) + lean * 1.3
    let shape = vec3(w, half, w)
    if scaffolds > 0 {
        p.blend = MASS_BLEND
    }
    // Each scaffold's end, as a direction on the shell from its middle.
    var toward: Vec<vec3> = Vec::new()
    for t in tips {
        toward.push(normalize((t - mid) / shape + vec3(0.0, 1.0e-4, 0.0)))
    }
    var branched = 0
    for i in 0..count {
        if rand(s, 400 + i) < CROWN_HOLES {
            continue
        }
        // From the top down to the open underside, a turn of the golden angle each.
        let u = (f32(i) + 0.5) / f32(count)
        let y = mix(1.0, CROWN_OPEN, u)
        let ring = sqrt(max(1.0 - y * y, 0.0))
        let a = 2.39996 * f32(i) + pick(s, 20 + i, lo: -0.45, hi: 0.45)
        let dir = vec3(ring * cos(a), y, ring * sin(a))
        // The shell out over the scaffolds' ends, back between them.
        var bulge = 0.0
        var nearest = 0
        var best = -2.0
        for j in 0..scaffolds {
            let d = dot(dir, toward[j])
            bulge = max(bulge, smoothstep(0.55, 0.95, d))
            if d > best {
                best = d
                nearest = j
            }
        }
        let deep = if i % 5 == 4 { 0.7 } else { 1.0 }
        let out = (0.8 + 0.2 * bulge + pick(s, 40 + i, lo: -0.06, hi: 0.06)) * deep
        let r = clump * pick(s, 80 + i, lo: 0.6, hi: 0.95)
        let at = mid + dir * shape * out - dir * (r * 0.45)
        p.cushion(at, radius: r, squash: pick(s, 231 + i, lo: 0.62, hi: 0.9))
        // Its own branch from the nearest scaffold, as far as the limbs go.
        if scaffolds > 0 && branched < limbs * 2 {
            let parent = branches[nearest]
            let (from, axis, radius) = limb_axis(parent, pick(s, 100 + i, lo: 0.5, hi: 0.9))
            let reach = length(at - from)
            p.branch(
                from,
                axis,
                from + axis * (reach * 0.2) + (at - from) * 0.55,
                at - dir * (r * 0.3),
                r_from: radius * 0.38,
                r_to: min(radius * 0.08, 0.018),
            )
            branched += 1
        }
    }
}

/// The share of a crown's clumps left out, for the sky to show through it (its clumps fine, about
/// a hundred over a big tree's shell, so its edge breaks up as leaves' do, not as balls'); and how far down its
/// shell its clumps go (the shell's height there, -1 its foot: below, it's open, and its limbs
/// show).
const CROWN_HOLES: f32 = 0.14
const CROWN_OPEN: f32 = -0.6

/// How deep a crown's shell is against its width (each way from its middle).
const CROWN_DEPTH: f32 = 0.65

/// How softly a crown's clumps blend (per metre, `Plant::blend`: softer than a plant's own, so
/// its clumps merge into one crown and its light turns over it as one form).
const MASS_BLEND: f32 = 1.35

/// A pine, seed `s`, `tall` high: a straight trunk, bare low, and a flat-topped crown of dark
/// clumps; grown in the open (`open`), its crown reaches lower and wider.
fn pine(s: u32, tall: f32, open: bool) -> Plant {
    let leaves = Leaves {
        young: vec3(0.07, 0.12, 0.06),
        old: vec3(0.02, 0.045, 0.03),
        through: vec3(0.05, 0.08, 0.03),
        size: 0.75,
        cover: 1.5,
    }
    // Scales: warm plates with dark cracks between.
    let bark = Bark {
        dark: vec3(0.11, 0.065, 0.045),
        light: vec3(0.50, 0.28, 0.14),
        grain: vec3(0.2, 0.8, 0.0),
        relief: 1.1,
    }
    var p = plant(leaves, bark)
    let lean = vec3(0.0, 0.0, tall * 0.03)
    p.tube(
        [
            vec3(0.0, -0.6, 0.0),
            vec3(0.0, 0.5, 0.0),
            vec3(0.0, tall * 0.5, 0.0) + lean * 0.5,
            vec3(0.0, tall * 0.92, 0.0) + lean,
        ],
        [0.42, 0.3, 0.22, 0.08],
    )
    // Its crown: whorls of limbs, near level, shorter up the stem, each carrying flat plates of
    // needles along most of it (only on its outer half, its limbs read as a pole's cross-arms);
    // flat on top (a Scots pine's: clumps round the stem read as a
    // pom-pom on a pole: specimens, round 2).
    let from = if open { 0.42 } else { 0.66 }
    let width = if open { 0.32 } else { 0.21 }
    let whorls = if open { 10 } else { 8 }
    for i in 0..whorls {
        let u = (f32(i) + pick(s, 10 + i, lo: 0.0, hi: 0.8)) / f32(whorls)
        let h = mix(from, 0.94, u)
        let stem = vec3(0.0, tall * h, 0.0) + lean * h
        // Longest a third of the way up the crown, short at its top; unequal.
        let reach = tall *
            width *
            (0.45 + 0.55 * sin(PI * min(u * 1.4 + 0.15, 1.0))) *
            pick(s, 30 + i, lo: 0.6, hi: 1.1)
        let a = 2.39996 * f32(i) + pick(s, 50 + i, lo: -0.5, hi: 0.5)
        let dir = vec3(cos(a), pick(s, 60 + i, lo: -0.05, hi: 0.18), sin(a))
        let tip = stem + dir * reach
        p.straight(stem, tip, r_from: 0.05 + 0.04 * (1.0 - u), r_to: 0.02)
        let plates = 3
        for q in 0..plates {
            let along = mix(0.25, 1.0, (f32(q) + 0.5) / f32(plates))
            let at = stem + dir * reach * along + vec3(0.0, 0.25, 0.0)
            p.cushion(at, radius: pick(s, 70 + 4 * i + q, lo: 1.0, hi: 1.6), squash: 0.42)
        }
    }
    // Its top: a flat head over the last whorl.
    for q in 0..3 {
        let a = TAU * (f32(q) / 3.0 + rand(s, 90 + q))
        let at = vec3(cos(a) * 0.9, tall * 0.96, sin(a) * 0.9) + lean
        p.cushion(at, radius: pick(s, 95 + q, lo: 1.1, hi: 1.5), squash: 0.5)
    }
    p
}

/// A shrub, seed `s`: a mound of clumps on a few crooked stems.
fn shrub(s: u32, size: f32, count: u32, leaves: Leaves, stems: u32) -> Plant {
    var p = plant(
        leaves,
        bark: Bark { dark: vec3(0.10, 0.08, 0.06), light: vec3(0.22, 0.18, 0.13) },
    )
    // A thicket: its stems from the ground, out and up, each its own length; its leaves in
    // clusters round their tops and down their outer sides, unevenly (one dome of clumps read as
    // a ball: specimens, round 2).
    var tops: Vec<vec3> = Vec::new()
    var outs: Vec<vec3> = Vec::new()
    for j in 0..stems {
        let a = 2.39996 * f32(j) + pick(s, 5 + j, lo: -0.6, hi: 0.6)
        let out = vec3(cos(a), 0.0, sin(a))
        let top = out * size * pick(s, 15 + j, lo: 0.3, hi: 0.95) +
            vec3(0.0, size * pick(s, 25 + j, lo: 0.55, hi: 1.0), 0.0)
        p.limb(
            out * size * 0.06,
            top * 0.45 + vec3(0.0, size * 0.1, 0.0),
            top,
            r_from: 0.03 + 0.012 * size,
            r_to: 0.015,
        )
        tops.push(top)
        outs.push(out)
    }
    for i in 0..count {
        let j = i % stems
        let a = TAU * rand(s, 10 + i)
        let up = pick(s, 20 + i, lo: -0.4, hi: 0.9)
        let ring = sqrt(max(1.0 - up * up, 0.0))
        let d = normalize(vec3(ring * cos(a), up, ring * sin(a)) + outs[j] * 0.6)
        let at = tops[j] + d * size * pick(s, 30 + i, lo: 0.08, hi: 0.4)
        p.cushion(
            at,
            radius: size * pick(s, 40 + i, lo: 0.2, hi: 0.36),
            squash: pick(s, 50 + i, lo: 0.7, hi: 0.95),
        )
    }
    p
}

/// A dead tree standing, seed `s`, `tall` high: a trunk broken off below its old top and a few
/// bare limbs; burnt (`burnt`), black and nearly bare. Its `form` sets its silhouette, so a stand
/// of them isn't one pole repeated (the arbiter's G3: the burn's trunks as uniform poles ending
/// in points): 0, tall and leaning, broken high; 1, a stump broken low with a long shard of its
/// side leaning out from the break; 2, crooked, forked into two broken leaders.
fn snag(s: u32, tall: f32, burnt: bool, conifer: bool, form: u32) -> Plant {
    let bark = if burnt {
        // Charcoal: near black, in long blocks between furrows (in even tones, the burn's snags
        // read as brown poles).
        Bark {
            dark: vec3(0.006, 0.006, 0.007),
            light: vec3(0.04, 0.037, 0.04),
            moss: vec3(0.05, 0.05, 0.04),
            grain: vec3(0.7, 0.3, 0.0),
            relief: 1.4,
        }
    } else {
        // Weathered to silver-grey (paler than living bark, but no white: at 0.48 a sunlit snag
        // read as a white post), split along its grain.
        Bark {
            dark: vec3(0.065, 0.07, 0.066),
            light: vec3(0.24, 0.23, 0.215),
            grain: vec3(0.75, 0.25, 0.0),
            relief: 1.2,
        }
    }
    // No leaves: its limbs alone.
    var p = plant(leaves: Leaves { size: 0.2 }, bark: bark)
    let girth = if conifer { 0.32 } else { 0.4 }
    let lean = vec3(pick(s, 4, lo: -0.9, hi: 0.9), 0.0, pick(s, 5, lo: -0.9, hi: 0.9)) *
        if form == 0 { 1.6 } else { 1.0 }
    // Fire takes a crown lower than rot does.
    let broke = tall * if form == 1 { pick(s, 6, lo: 0.25, hi: 0.4) } else if burnt {
        pick(s, 6, lo: 0.55, hi: 0.85)
    } else {
        pick(s, 6, lo: 0.75, hi: 0.95)
    }
    // A crook partway up: the trunk bends one way, then on.
    let crook = vec3(pick(s, 7, lo: -1.0, hi: 1.0), 0.0, pick(s, 8, lo: -1.0, hi: 1.0)) *
        if form == 2 { girth * 1.6 } else { girth * 0.6 }
    // The trunk, snapped: its last piece short, so it closes over a few centimetres (a blunt
    // break, not a spike: round 5's stills read the old tapered tops as tridents, and at 0.5 m
    // the lookdev's round 2 read them as pencil points). It flares at its foot and tapers.
    let fork = if form == 2 { 0.55 } else { 1.0 }
    let trunk_top = vec3(0.0, broke * fork, 0.0) + lean * fork + crook * (1.0 - fork)
    p.tube(
        [
            vec3(0.0, -0.6, 0.0),
            vec3(0.0, broke * fork * 0.5, 0.0) + lean * (fork * 0.4) + crook,
            trunk_top - vec3(0.0, girth * 0.25, 0.0),
            trunk_top,
        ],
        [girth * 1.5, girth * 0.83, girth * if form == 2 { 0.6 } else {
            0.5
        }, girth * if form == 2 { 0.6 } else { 0.5 }],
    )
    // Roots, as a living tree's (`broadleaf`).
    for k in 0..(3 + s % 2) {
        let a = TAU * (f32(k) + 0.6 * rand(s, 140 + k)) / f32(3 + s % 2)
        let dir = vec3(cos(a), 0.0, sin(a))
        let out = girth * pick(s, 150 + k, lo: 1.8, hi: 3.0)
        p.root(
            vec3(0.0),
            dir,
            girth,
            out,
            vec3(0.0),
            r: girth * pick(s, 160 + k, lo: 0.45, hi: 0.65),
        )
    }
    // Form 2: two leaders from the fork, each broken off.
    var breaks = [trunk_top; 2]
    var n_breaks = 1
    if form == 2 {
        for k in 0..2 {
            let a = TAU * rand(s, 80 + k) * 0.25 + f32(k) * 3.1416
            let out = vec3(cos(a), 0.0, sin(a))
            let end = trunk_top +
                out * (broke * pick(s, 82 + k, lo: 0.12, hi: 0.2)) +
                vec3(0.0, broke * (1.0 - fork) * pick(s, 84 + k, lo: 0.6, hi: 1.0), 0.0)
            p.tube(
                [
                    trunk_top - vec3(0.0, girth, 0.0),
                    trunk_top + out * girth * 0.3,
                    end - normalize(end - trunk_top) * (girth * 0.16),
                    end,
                ],
                [girth * 0.5, girth * 0.45, girth * 0.32, girth * 0.32],
            )
            breaks[k] = end
        }
        n_breaks = 2
    }
    // The break: one shard of the trunk's side standing from it, wide and flattened against the
    // trunk's rim, and a short one beside it. (Two or three thin spikes from its middle read as
    // tridents, and in the beech wood as living trunks ending in splinters: the lookdev
    // reviews' 02.) A low break's shard is long and leans out: what's left of the fallen top.
    for k in 0..n_breaks {
        let at = breaks[k]
        let w = if form == 2 { girth * 0.6 } else { girth }
        let a = TAU * rand(s, 60 + k)
        let rim = vec3(cos(a), 0.0, sin(a)) * w * 0.3
        let shard = if form == 1 { pick(s, 70, lo: 0.45, hi: 1.0) } else if burnt {
            pick(s, 70 + k, lo: 0.12, hi: 0.3)
        } else {
            pick(s, 70 + k, lo: 0.18, hi: 0.45)
        }
        let out = if form == 1 { rim * (shard * 1.4 / max(w * 0.3, 0.01)) * 0.35 } else {
            rim * 0.4
        }
        p.limb(
            at - vec3(0.0, 0.4, 0.0) + rim,
            at + rim * 1.15 + out * 0.4 + vec3(0.0, shard * 0.4, 0.0),
            at + rim * 1.15 + out + vec3(0.0, shard, 0.0),
            r_from: w * if form == 1 { 0.4 } else { 0.3 },
            r_to: w * 0.06,
        )
        let b = a + pick(s, 61 + k, lo: 1.6, hi: 2.6)
        let rim2 = vec3(cos(b), 0.0, sin(b)) * w * 0.3
        p.straight(
            at - vec3(0.0, 0.3, 0.0) + rim2,
            at + rim2 * 1.2 + vec3(0.0, shard * 0.3, 0.0),
            r_from: w * 0.2,
            r_to: w * 0.05,
        )
    }
    // Its limbs: what's left of them, short and crooked, some snapped to stubs.
    let n = if form == 1 { 2 } else if burnt { 5 } else if conifer { 6 } else { 5 }
    let high = broke * fork
    for i in 0..n {
        let h = pick(s, 10 + i, lo: 0.4, hi: 0.95) * high
        let a = TAU * rand(s, 20 + i)
        let out = vec3(cos(a), 0.0, sin(a))
        let across = vec3(-out.z, 0.0, out.x)
        let (from, axis, radius) = limb_at_height(p.limbs[0], h)
        // A burnt one's limbs are all burnt back to stubs (long and thin, they read as thorns).
        let stub = burnt || rand(s, 50 + i) < 0.4
        let len = if conifer { tall * pick(s, 30 + i, lo: 0.025, hi: 0.085) } else if stub {
            tall * pick(s, 30 + i, lo: 0.015, hi: 0.08)
        } else {
            tall * pick(s, 30 + i, lo: 0.08, hi: 0.16)
        }
        let rise = if conifer { pick(s, 40 + i, lo: -0.35, hi: 0.12) } else {
            pick(s, 40 + i, lo: -0.2, hi: 0.7)
        }
        let tip = from + out * len + vec3(0.0, len * rise, 0.0)
        let bend = from +
            axis * (len * 0.16) +
            (tip - from) * 0.4 +
            across * (len * pick(s, 45 + i, lo: -0.3, hi: 0.3))
        let base_radius = radius * pick(s, 47 + i, lo: 0.25, hi: 0.5)
        let end_radius = base_radius * pick(s, 49 + i, lo: 0.4, hi: 0.65)
        p.branch(from, axis, bend, tip, r_from: base_radius, r_to: end_radius)
    }
    p
}

/// A fallen trunk `long` metres along +z from its foot, lying on the ground, `girth` its
/// radius at the foot: crooked a little, its torn roots or stump at the foot.
fn log(s: u32, long: f32, girth: f32) -> Plant {
    let bark = Bark {
        dark: vec3(0.11, 0.09, 0.07),
        light: vec3(0.30, 0.26, 0.20),
        moss: vec3(0.07, 0.11, 0.03),
        grain: vec3(0.6, 0.2, 0.2),
    }
    // No leaves: its trunk and its root plate alone.
    var p = plant(leaves: Leaves { size: 0.2 }, bark: bark)
    let bow = pick(s, 1, lo: -0.6, hi: 0.6)
    // Its foot closed by a short piece swelling from a stub (a tube's start is open: its rim
    // showed as a white ring: round 5). The far end is a short break: closing a final
    // piece 40% of the log's length made a several-metre needle hovering over the slope.
    p.tube(
        [
            vec3(0.0, girth, -girth * 0.25),
            vec3(0.0, girth, girth * 0.35),
            vec3(bow * 0.6, girth * 0.5, long - girth * 0.5),
            vec3(bow * 0.6, girth * 0.5, long),
        ],
        [girth * 0.35, girth, girth * 0.4, girth * 0.4],
    )
    // The root plate's stubs at the foot.
    for i in 0..4 {
        let a = TAU * (f32(i) + rand(s, 10 + i)) / 4.0
        let tip = vec3(cos(a) * girth * 2.4, girth + sin(a) * girth * 2.4, -girth * 0.6)
        p.straight(vec3(0.0, girth, 0.2), tip, r_from: girth * 0.35, r_to: girth * 0.1)
    }
    p
}

/// A far tree, seed `s`: one crown of three clumps, no trunk to see.
fn far_tree(s: u32) -> Plant {
    var p = plant(leaves: Leaves { size: 2.4, cover: 1.2 }, bark: Bark {})
    let tall = pick(s, 1, lo: 12.0, hi: 18.0)
    for i in 0..3 {
        let at = vec3(
            pick(s, 10 + i, lo: -2.0, hi: 2.0),
            tall * pick(s, 20 + i, lo: 0.55, hi: 0.8),
            pick(s, 30 + i, lo: -2.0, hi: 2.0),
        )
        p.clump(at, radius: pick(s, 40 + i, lo: 2.6, hi: 3.6))
    }
    p
}

/// Kind `k`'s plant.
pub fn kind_plant(k: u32) -> Plant {
    let oak_leaves = Leaves {
        young: vec3(0.105, 0.16, 0.055),
        old: vec3(0.055, 0.095, 0.035),
        size: 0.26,
        cover: 1.0,
    }
    // Bark per species (the lookdev reviews' A13): oak's deep furrows broken into blocks;
    // beech's smooth silver-grey, mottled, a little cool so a green wood's light doesn't turn it
    // olive (A6, P5); birch's white, banded with dark lenticels; alder's dark fissures.
    let oak_bark = Bark {
        dark: vec3(0.07, 0.055, 0.042),
        light: vec3(0.25, 0.205, 0.155),
        grain: vec3(0.7, 0.3, 0.0),
        relief: 1.4,
    }
    let beech_leaves = Leaves {
        young: vec3(0.13, 0.20, 0.065),
        old: vec3(0.075, 0.115, 0.05),
        size: 0.25,
        cover: 1.05,
    }
    let beech_bark = Bark {
        dark: vec3(0.07, 0.075, 0.07),
        light: vec3(0.25, 0.26, 0.245),
        moss: vec3(0.13, 0.13, 0.10),
        grain: vec3(0.0, 0.0, 1.0),
        relief: 0.6,
    }
    let birch_leaves = Leaves {
        young: vec3(0.16, 0.23, 0.075),
        old: vec3(0.08, 0.125, 0.06),
        size: 0.19,
        cover: 0.85,
    }
    let birch_bark = Bark {
        dark: vec3(0.05, 0.045, 0.045),
        light: vec3(0.64, 0.62, 0.58),
        grain: vec3(0.1, 0.0, 0.9),
        bands: 0.95,
        relief: 0.2,
    }
    let alder_leaves = Leaves {
        young: vec3(0.09, 0.17, 0.04),
        old: vec3(0.025, 0.07, 0.02),
        size: 0.42,
        cover: 1.0,
    }
    let alder_bark = Bark {
        dark: vec3(0.07, 0.063, 0.058),
        light: vec3(0.24, 0.215, 0.195),
        grain: vec3(0.7, 0.3, 0.0),
        relief: 1.1,
    }
    // (Each species' cover is per clump: a crown's shell of overlapping clumps, `crown_on`, covers
    // its outside more than once at lower cover; at the floor's earlier cover its cards cost a
    // third more of the frame: lookdev round 3's profile.)
    if k == GREAT {
        great_tree()
    } else if k == OAK_OPEN {
        broadleaf(
            101,
            tall: 18.0,
            base: 0.28,
            width: 0.52,
            clump: 1.87,
            count: 108,
            limbs: 8,
            girth: 0.55,
            leaves: oak_leaves,
            bark: oak_bark,
        )
    } else if k == OAK_FOREST {
        broadleaf(
            102,
            tall: 18.0,
            base: 0.52,
            width: 0.36,
            clump: 1.66,
            count: 84,
            limbs: 6,
            girth: 0.42,
            leaves: oak_leaves,
            bark: oak_bark,
        )
    } else if k == BEECH_OPEN {
        broadleaf(
            103,
            tall: 20.0,
            base: 0.22,
            width: 0.5,
            clump: 1.8,
            count: 112,
            limbs: 6,
            girth: 0.45,
            leaves: beech_leaves,
            bark: beech_bark,
        )
    } else if k == BEECH_FOREST {
        broadleaf(
            104,
            tall: 20.0,
            base: 0.6,
            width: 0.3,
            clump: 1.58,
            count: 80,
            limbs: 5,
            girth: 0.36,
            leaves: beech_leaves,
            bark: beech_bark,
        )
    } else if k == BIRCH_OPEN {
        broadleaf(
            105,
            tall: 15.0,
            base: 0.35,
            width: 0.24,
            clump: 1.08,
            count: 72,
            limbs: 5,
            girth: 0.17,
            leaves: birch_leaves,
            bark: birch_bark,
        )
    } else if k == BIRCH_FOREST {
        broadleaf(
            106,
            tall: 15.0,
            base: 0.6,
            width: 0.18,
            clump: 1.01,
            count: 52,
            limbs: 4,
            girth: 0.14,
            leaves: birch_leaves,
            bark: birch_bark,
        )
    } else if k == PINE_OPEN {
        pine(107, 22.0, open: true)
    } else if k == PINE_FOREST {
        pine(108, 22.0, open: false)
    } else if k == ALDER_A {
        broadleaf(
            109,
            tall: 15.0,
            base: 0.38,
            width: 0.26,
            clump: 1.22,
            count: 72,
            limbs: 5,
            girth: 0.22,
            leaves: alder_leaves,
            bark: alder_bark,
        )
    } else if k == ALDER_B {
        broadleaf(
            110,
            tall: 15.0,
            base: 0.42,
            width: 0.22,
            clump: 1.15,
            count: 72,
            limbs: 4,
            girth: 0.2,
            leaves: alder_leaves,
            bark: alder_bark,
        )
    } else if k == HAWTHORN {
        shrub(
            111,
            5.0,
            34,
            Leaves {
                young: vec3(0.11, 0.18, 0.04),
                old: vec3(0.03, 0.07, 0.02),
                size: 0.36,
                cover: 1.8,
            },
            6,
        )
    } else if k == SLOE {
        shrub(
            112,
            3.0,
            30,
            Leaves {
                young: vec3(0.07, 0.12, 0.03),
                old: vec3(0.02, 0.05, 0.02),
                size: 0.32,
                cover: 2.0,
            },
            7,
        )
    } else if k == YOUNG_BROAD {
        broadleaf(
            113,
            tall: 3.0,
            base: 0.3,
            width: 0.3,
            clump: 0.43,
            count: 32,
            limbs: 3,
            girth: 0.04,
            leaves: beech_leaves,
            bark: beech_bark,
        )
    } else if k == YOUNG_PINE {
        pine(114, 3.0, open: true)
    } else if k == SNAG_BROAD {
        snag(115, 16.0, burnt: false, conifer: false, form: 0)
    } else if k == SNAG_BURNT {
        snag(116, 16.0, burnt: true, conifer: false, form: 0)
    } else if k == SNAG_PINE {
        snag(117, 18.0, burnt: false, conifer: true, form: 0)
    } else if k == LOG_SHORT {
        log(118, long: 12.0, girth: 0.28)
    } else if k == LOG_LONG {
        log(119, long: 20.0, girth: 0.5)
    } else if k == FAR_A {
        far_tree(120)
    } else if k == FAR_B {
        far_tree(121)
    } else if k == SNAG_STUMP {
        snag(122, 16.0, burnt: true, conifer: false, form: 1)
    } else if k == SNAG_FORKED {
        snag(123, 11.0, burnt: true, conifer: false, form: 2)
    } else {
        // Not a kind: drawn as a far tree.
        far_tree(121)
    }
}

// ---- placing the history's trees ---------------------------------------------------------------

/// A small tint for an instance: its leaves a little warmer or cooler.
fn tint(s: u32) -> vec2 {
    vec2(pick(s, 6, lo: -0.05, hi: 0.06), pick(s, 7, lo: -0.06, hi: 0.04))
}

/// A living tree's tint at `p` (seed `s`), `height(p)` the ground's height: its wood's by the
/// landform, woods on a rise lighter and warmer (sunlit, thinner), woods in a hollow cooler, the
/// woods' greens varying from yellow to blue over stands about `STAND` m across; and a little of
/// its own (`tint`). (M6's lookdev pass 1: each tree's own tint, drawn at random, read as noise
/// over the far forest, not as woods grouped by the land.)
fn stand_tint(p: vec2, height: fn(vec2) -> f32, s: u32) -> vec2 {
    var ring = 0.0
    for k in 0..4 {
        let a = TAU * (f32(k) + 0.125) / 4.0
        ring += height(p + vec2(cos(a), sin(a)) * RELIEF_R)
    }
    let relief = clamp((height(p) - ring * 0.25) / RELIEF_H, -1.0, 1.0)
    // In a hollow, cooler, not much darker (darker, the mere's woods went murk: round 1).
    let land = if relief > 0.0 { vec2(0.035, 0.03) * relief } else { vec2(0.03, 0.01) * relief }
    let stand = noise2(p / STAND + vec2(17.3, 5.1)) * 2.0 - 1.0
    land + vec2(0.04, 0.012) * stand + tint(s) * 0.3
}

/// How far round a tree `stand_tint` reads the land (m), and the rise or fall over it (m) that
/// is a full ridge or hollow; how wide a stand of one green is (m).
const RELIEF_R: f32 = 60.0
const RELIEF_H: f32 = 8.0
const STAND: f32 = 220.0

/// How wide a group of far crowns of about one size is (m, `far_placed`).
const GROUP: f32 = 60.0

/// An instance of kind `kind` at `p` on the ground (`ground_y` high there), scaled to `tall`, its
/// +z turned toward `toward` (or turned at random by seed `s`, if `toward` is nothing), sunk
/// `sink` into the ground, forking `fork` higher than its kind (`engine::plant::bend`), its crown
/// `wide` of its kind's across (`crown_wide`).
fn instance(
    kind: u32,
    p: vec2,
    ground_y: f32,
    tall: f32,
    toward: vec2,
    s: u32,
    sink: f32,
    fork: f32,
    wide: f32,
    tint: vec2,
) -> Placed {
    let yaw = if length(toward) > 0.05 { atan2(toward.x, toward.y) } else { TAU * rand(s, 90) }
    Placed {
        kind,
        at: Instance {
            at: vec3(p.x, ground_y - sink, p.y),
            yaw,
            tint: tint_of(tint),
            scale: scale_of(kind, tall),
            fork,
            wide,
        },
    }
}

/// The lowest a plant's branches or leaves come (m, as it's built): its limbs' (not its trunk's,
/// the first, nor its roots', which reach into the ground) and its clumps'. (Its roots counted,
/// every broad-leaved kind's lowest branch was under the ground, and a browsed tree was always
/// drawn in its forest form.)
fn lowest(p: Plant) -> f32 {
    var low = 1.0e9
    for i in 1..p.limbs.len() {
        let l = p.limbs[i]
        if l.points[3].y < 0.0 {
            continue
        }
        for k in 0..4 {
            low = min(low, l.points[k].y - l.radii[k])
        }
    }
    for i in 0..p.clumps.len() {
        let c = p.clumps[i]
        low = min(low, c.centre.y - c.radius * c.squash)
    }
    low
}

/// Each kind's lowest branch (`lowest`), as it's built (the great oak's isn't needed: it's kept).
pub const LOWEST: [f32; KINDS] = lowest_of_kinds()

fn lowest_of_kinds() -> [f32; KINDS] {
    var out = [0.0; KINDS]
    for k in 1..KINDS {
        out[k] = lowest(kind_plant(k))
    }
    out
}

/// The lowest branch of kind `k` placed `tall` high and forking `fork` higher (m).
pub fn lowest_placed(k: u32, tall: f32, fork: f32) -> f32 {
    bend(LOWEST[k], fork) * scale_of(k, tall)
}

/// Each kind's trunk (its first limb), as it's built (the great oak's isn't needed: it's kept).
const TRUNKS: [Tube<4>; KINDS] = trunks_of_kinds()

fn trunks_of_kinds() -> [Tube<4>; KINDS] {
    var out = [Tube { points: [vec3(0.0); 4], radii: [0.0; 4] }; KINDS]
    for k in 1..KINDS {
        let p = kind_plant(k)
        if p.limbs.len() > 0 {
            out[k] = p.limbs[0]
        }
    }
    out
}

/// The radius kind `k`'s trunk is drawn at `h` m over the ground, placed `tall` high and forking
/// `fork` higher: between its trunk's points, scaled to the tree.
pub fn trunk_at(k: u32, tall: f32, h: f32, fork: f32) -> f32 {
    let t = TRUNKS[k]
    let s = scale_of(k, tall)
    let y = unbend(h / s, fork)
    var r = t.radii[3]
    for i in 0..3 {
        if y >= t.points[i].y && y <= t.points[i + 1].y {
            let f = (y - t.points[i].y) / max(t.points[i + 1].y - t.points[i].y, 1.0e-4)
            r = mix(t.radii[i], t.radii[i + 1], f)
        }
    }
    r * s
}

// ---- the crowns as they're drawn ---------------------------------------------------------------

/// Each kind's crown as it's built (m), as the eye sees it: its radius, the farthest its clumps'
/// middles stand from its trunk and half a clump; its base, halfway between its lowest leaves
/// and the lowest middle less half a clump; and its top, the highest middle and half a clump (a
/// clump's edge is leaves with gaps between, which the eye sees through: calibrated against the
/// renderer's depth, #55 AC3).
const CROWN_R: [f32; KINDS] = crowns_of_kinds(0)
const CROWN_BASE: [f32; KINDS] = crowns_of_kinds(1)
const CROWN_TOP: [f32; KINDS] = crowns_of_kinds(2)

fn crowns_of_kinds(which: u32) -> [f32; KINDS] {
    var out = [0.0; KINDS]
    for k in 0..KINDS {
        let p = kind_plant(k)
        var reach = 0.0
        var low = 1.0e9
        var high = 0.0
        for i in 0..p.clumps.len() {
            let c = p.clumps[i]
            reach = max(reach, length(c.centre.xz) + 0.5 * c.radius)
            low = min(low, c.centre.y - 0.5 * c.radius * c.squash)
            high = max(high, c.centre.y + 0.5 * c.radius * c.squash)
        }
        out[k] = if p.clumps.len() == 0 { 0.0 } else if which == 0 { reach } else if which == 1 {
            0.5 * (low + lowest(p))
        } else { high }
    }
    out
}

/// How tall a living tree of the history `tall` high is drawn as kind `k`: a thorn at least
/// 1.5 m.
pub fn drawn_tall(k: u32, tall: f32) -> f32 {
    if k == HAWTHORN || k == SLOE { max(tall, 1.5) } else { tall }
}

/// How wide a living tree's crown is drawn against its kind's (`Instance::wide`), drawn as kind
/// `k`, `tall` high: by how wide the history grew it (its reach, held by its neighbours'), its
/// leaves spreading half as far again (crowns interlock), to half its kind's at the least.
pub fn crown_wide(t: Tree, k: u32, tall: f32) -> f32 {
    clamp(SPREAD * t.reach / max(CROWN_R[k] * scale_of(k, tall), 0.1), 0.5, 1.0)
}

/// How far past the history's reach a crown's leaves spread (`crown_wide`).
const SPREAD: f32 = 1.5

/// Each tree as it's drawn, for the interest check (`interest::Evidence::crowns`): its crown as
/// the eye sees it (`CROWN_BASE`, `CROWN_TOP`, `CROWN_R`: its kind's, placed at its height and
/// fork and as wide as it's drawn, denser for being narrower; the kept tree's as it's built;
/// none for a snag or a log), and its trunk's radius at the eye (`as_drawn`'s girth, at 2 m).
pub fn drawn_crowns(trees: [Tree]) -> Vec<Drawn> {
    var out: Vec<Drawn> = Vec::with_capacity(trees.len())
    for t in trees {
        let standing = t.state == State::Alive || t.state == State::Snag
        let trunk = if standing && !t.pinned && t.tall > 2.0 {
            max(t.girth, trunk_at(kind_of(t), t.tall, h: 2.0, fork: t.fork))
        } else { t.girth }
        if t.state != State::Alive {
            out.push(Drawn { base: 0.0, top: 0.0, reach: 0.0, dense: 1.0, trunk })
        } else if t.pinned {
            out.push(
                Drawn {
                    base: CROWN_BASE[GREAT],
                    top: CROWN_TOP[GREAT],
                    reach: CROWN_R[GREAT],
                    dense: 1.0,
                    trunk,
                },
            )
        } else {
            let k = drawn_kind(t)
            let tall = drawn_tall(k, t.tall)
            let s = scale_of(k, tall)
            let wide = crown_wide(t, k, tall)
            out.push(
                Drawn {
                    base: bend(CROWN_BASE[k], t.fork) * s,
                    top: bend(CROWN_TOP[k], t.fork) * s,
                    reach: CROWN_R[k] * s * wide,
                    dense: 1.0 / wide,
                    trunk,
                },
            )
        }
    }
    out
}

// ---- each tree's fork --------------------------------------------------------------------------

/// Where each kind's trunk first forks, as it's built (m): its lowest limb's foot (its first
/// limb is its trunk); 0 for a kind with no limbs.
const FORK_Y: [f32; KINDS] = forks_of_kinds()

fn forks_of_kinds() -> [f32; KINDS] {
    var out = [0.0; KINDS]
    for k in 1..KINDS {
        let p = kind_plant(k)
        for i in 1..p.limbs.len() {
            // Not a root (a limb into the ground).
            if p.limbs[i].points[3].y < 0.0 {
                continue
            }
            let y = p.limbs[i].points[0].y
            out[k] = if out[k] == 0.0 { y } else { min(out[k], y) }
        }
    }
    out
}

/// How high a tree of kind `k`, placed `tall` high and forking `fork` higher than its kind,
/// first forks (m over the ground).
pub fn fork_height(k: u32, tall: f32, fork: f32) -> f32 {
    bend(FORK_Y[k], fork) * scale_of(k, tall)
}

/// The forks a standing tree may take (`Tree::fork`), and how far apart the first fork's heights
/// of neighbours of a kind are kept (a share of the higher).
const FORKS = [
    -0.48, -0.42, -0.36, -0.30, -0.24, -0.18, -0.12, -0.06, 0.0, 0.06, 0.12, 0.18, 0.24, 0.30, 0.36,
    0.42, 0.48,
]
pub const FORK_APART: f32 = 0.05

/// The forks a browsed tree may take as well (`choose_fork`): between the high ones, to the
/// highest the bake keeps (`engine::bake`'s ±0.508).
const LIFTED_FORKS = [0.27, 0.33, 0.39, 0.45, 0.508]

/// Whether two trees are neighbours: their crowns touch (their trunks are nearer than their
/// crowns' radii together).
pub fn neighbours(a: Tree, b: Tree) -> bool {
    length(a.at - b.at) < a.reach + b.reach
}

/// The farthest apart two neighbours' trunks stand (m): twice the widest crown a history grows.
pub const NEIGHBOURS_WITHIN: f32 = 24.0

/// Whether two first forks' heights are apart (`FORK_APART`).
pub fn forks_apart(a: f32, b: f32) -> bool {
    abs(a - b) >= FORK_APART * max(a, b)
}

/// No kind chosen yet.
const UNCHOSEN: u32 = 4294967295

/// Whether a tree's fork is chosen: a standing tree's (living or dead) drawn as a kind with limbs.
pub fn forks(t: Tree) -> bool {
    !t.pinned &&
        (t.state == State::Alive || t.state == State::Snag) &&
        t.tall > 1.2 &&
        FORK_Y[kind_of(t)] > 0.0
}

/// How many times the choice goes over the trees again, each tree whose fork is still at a
/// neighbour's taking the fork that stands farthest from all of its neighbours'.
const FORK_PASSES: u32 = 24

/// The trees with each standing tree's fork chosen (#54 §9: no two neighbours of a kind fork at
/// the same height). In their order, each takes the first of `FORKS` (from one its seed picks)
/// whose height is apart (`forks_apart`) from those of its neighbours of its kind that chose
/// before it; or, if none is, the one that stands farthest from them (as a share). Then, over
/// `FORK_PASSES` passes, each tree whose fork isn't apart from a neighbour's chooses again among
/// all its neighbours. Each tree is judged as the bake will keep it (`bake::as_baked`): its kind
/// is then the one it's drawn as.
pub fn forked(trees: take Vec<Tree>) -> Vec<Tree> {
    var kept = take trees
    var out: Vec<Tree> = Vec::with_capacity(kept.len())
    for t in kept {
        out.push(engine::bake::as_baked(t))
    }
    let n = out.len()
    if n == 0 {
        return out
    }
    var lo = out[0].at
    var hi = out[0].at
    for t in out {
        lo = min(lo, t.at)
        hi = max(hi, t.at)
    }
    let g = engine::grow::Grid::over(lo, hi + vec2(0.01), NEIGHBOURS_WITHIN)
    // The trees' indices sorted by cell: cell `c`'s from `start[c]` to `start[c + 1]`.
    let cells = g.cells()
    var start: Vec<u32> = Vec::filled(cells + 1, 0)
    for t in out {
        start[g.cell_at(t.at) + 1] += 1
    }
    for c in 0..cells {
        let before = start[c]
        start[c + 1] += before
    }
    var cursor = start.clone()
    var sorted: Vec<u32> = Vec::filled(n, 0)
    for i in 0..n {
        let c = g.cell_at(out[i].at)
        sorted[cursor[c]] = i
        cursor[c] += 1
    }
    let near = Near { g, start, sorted }
    // Each tree's kind and fork's height, once it has chosen.
    var kinds: Vec<u32> = Vec::filled(n, UNCHOSEN)
    var heights: Vec<f32> = Vec::filled(n, 0.0)
    for i in 0..n {
        if forks(out[i]) {
            choose_fork(mut out, mut kinds, mut heights, near, i, first: true)
        }
    }
    for _ in 0..FORK_PASSES {
        var moved = 0
        for i in 0..n {
            if kinds[i] != UNCHOSEN &&
                fork_gap(out, kinds, heights, near, i, kinds[i], heights[i]) < FORK_APART {
                choose_fork(mut out, mut kinds, mut heights, near, i, first: false)
                moved += 1
            }
        }
        if moved == 0 {
            break
        }
    }
    for i in 0..n {
        kept[i].fork = out[i].fork
    }
    kept
}

/// The trees' places sorted by cell, for finding a tree's neighbours.
struct Near {
    g: engine::grow::Grid,
    start: Vec<u32>,
    sorted: Vec<u32>,
}

/// The least gap (a share of the higher) between a first fork at `h` of tree `i` drawn as kind
/// `k` and those of its neighbours of that kind that have chosen; a large number for none.
fn fork_gap(
    trees: [Tree],
    kinds: [u32],
    heights: [f32],
    near: Near,
    i: u32,
    k: u32,
    h: f32,
) -> f32 {
    let t = trees[i]
    let c = near.g.ij(t.at)
    var gap = 1.0e9
    for dj in 0..3 {
        for di in 0..3 {
            let x = c.x + di - 1
            let z = c.y + dj - 1
            if x >= 0 && z >= 0 && x < i32(near.g.nx) && z < i32(near.g.nz) {
                let b = u32(z) * near.g.nx + u32(x)
                for q in near.start[b]..near.start[b + 1] {
                    let j = near.sorted[q]
                    if j != i && kinds[j] == k && neighbours(trees[j], t) {
                        gap = min(gap, abs(heights[j] - h) / max(max(heights[j], h), 0.01))
                    }
                }
            }
        }
    }
    gap
}

/// Whether tree `t`, forking `f` higher than its kind, keeps its branches above its browse line
/// (`Tree::lift`) as it's drawn.
fn clears(t: Tree, f: f32) -> bool {
    var tf = t
    tf.fork = f
    let k = kind_of(tf)
    t.lift <= 0.0 || t.state != State::Alive || lowest_placed(k, t.tall, f) >= t.lift
}

/// Tree `i` chooses its fork: the first of `FORKS` (from one its seed picks) apart from its
/// neighbours' (`first`: the first choice, when it takes the first that is), else the one
/// farthest from them.
fn choose_fork(
    trees: mut Vec<Tree>,
    kinds: mut Vec<u32>,
    heights: mut Vec<f32>,
    near: Near,
    i: u32,
    first: bool,
) {
    let t = trees[i]
    // Under a browse line, only the forks whose branches clear it, if any do (a small tree's
    // forest form can still come below it: AC2's head room); and between the high forks too,
    // so two browsed neighbours that clear it only high still have heights apart to choose from.
    let from = t.seed % FORKS.len()
    var choices: Vec<f32> = Vec::new()
    for m in 0..FORKS.len() {
        choices.push(FORKS[(from + m) % FORKS.len()])
    }
    if t.lift > 0.0 {
        for f in LIFTED_FORKS {
            choices.push(f)
        }
    }
    var any_clear = false
    for f in choices {
        any_clear = any_clear || clears(t, f)
    }
    var best = t.fork
    var best_gap = -1.0
    for f in choices {
        if any_clear && !clears(t, f) {
            continue
        }
        var tf = t
        tf.fork = f
        let k = kind_of(tf)
        let gap = fork_gap(trees, kinds, heights, near, i, k, fork_height(k, t.tall, f))
        if gap > best_gap {
            best_gap = gap
            best = f
        }
        if first && gap >= FORK_APART {
            break
        }
    }
    trees[i].fork = best
    let k = kind_of(trees[i])
    kinds[i] = k
    heights[i] = fork_height(k, t.tall, best)
}

/// What a player walks round of the history's trees, as they're drawn: each standing tree's
/// girth the larger of the history's and its drawn trunk's at a chest's height (1.2 m), so the
/// player stops where the trunk is seen.
pub fn as_drawn(trees: [Tree]) -> Vec<Tree> {
    var out: Vec<Tree> = Vec::with_capacity(trees.len())
    for t in trees {
        var d = t
        if (t.state == State::Alive || t.state == State::Snag) && !t.pinned && t.tall > 2.0 {
            d.girth = max(t.girth, trunk_at(kind_of(t), t.tall, 1.2, t.fork))
        }
        out.push(d)
    }
    out
}

/// The scale an instance of kind `k` is placed at to stand `tall` high.
pub fn scale_of(k: u32, tall: f32) -> f32 {
    clamp(tall / BUILT[k], 0.15, 2.6)
}

/// How thick a living tree's trunk and limbs are drawn against its kind's at its height
/// (`engine::plant::Instance::thick`): as thick as its history grew it at breast height, never
/// thinner than its kind's, to `THICKEST` times (an ancient's trunk, its kind's scaled to its
/// height, was a pole: the owner's ancients, larger than life).
pub fn thickness(t: Tree, k: u32) -> f32 {
    let kinds = trunk_at(k, drawn_tall(k, t.tall), 1.2, t.fork)
    clamp(t.girth / max(kinds, 1.0e-3), 1.0, THICKEST)
}

const THICKEST: f32 = 3.0

/// The kind a standing tree (living, or a snag) is drawn as.
pub fn kind_of(t: Tree) -> u32 {
    if t.state == State::Snag {
        snag_kind(t)
    } else {
        drawn_kind(t)
    }
}

/// The kind a snag is drawn as: burnt, a pine's, or a broad-leaved tree's.
fn snag_kind(t: Tree) -> u32 {
    if t.cause == Cause::Fire {
        // Three silhouettes, by its seed: tall, a low stump with its shard, forked.
        [SNAG_BURNT, SNAG_STUMP, SNAG_FORKED][t.seed % 3]
    } else if t.kind == PINE {
        SNAG_PINE
    } else {
        SNAG_BROAD
    }
}

/// The kind a living tree is drawn as: its species, grown in the open or in the forest (by the
/// light its crown had), or young; and where browsing keeps its branches above a line (its
/// `lift`), the forest's form when the open one's would come below it.
pub fn drawn_kind(t: Tree) -> u32 {
    let k = crowded_form(t, living_kind(t))
    if t.lift <= 0.0 || lowest_placed(k, t.tall, t.fork) >= t.lift {
        k
    } else if k == OAK_OPEN {
        OAK_FOREST
    } else if k == BEECH_OPEN {
        BEECH_FOREST
    } else if k == BIRCH_OPEN {
        BIRCH_FOREST
    } else if k == PINE_OPEN {
        PINE_FOREST
    } else {
        k
    }
}

/// Whether tree `t`'s neighbours crowd it: its crown narrower than its species' in the open at its
/// height (`Habit::crown`) by more than `UNCROWDED`.
pub fn crowded(t: Tree) -> bool {
    t.reach < UNCROWDED * species::habits()[t.kind].crown * t.tall
}

/// How wide a crown is, against its species' in the open at its height, that its neighbours
/// don't crowd: all but as wide (at 0.8, a third of the woods' broadleaves were drawn open, their
/// low wide crowns closing the views and costing a tenth more of the frame).
const UNCROWDED: f32 = 0.95

/// An open-grown kind drawn in its forest form where its neighbours crowd it (its crown narrower
/// than its species' in the open at its height, `UNCROWDED`; against its kind's drawn crown,
/// wider than any the history grows, even a lone oak was crowded: specimens, round 1): a canopy tree whose crown top reaches the light is
/// still a forest tree below it, with no wide, low crown and no limbs at the eye's height (the
/// shots item's exploration check: open forms in closed woods closed the views, dead 27% of the
/// floor and 53% of the beech wood). Where browsing keeps a line (its `lift`: the wood pasture,
/// the edge), an open tree keeps its open form: the pasture's spreading oaks are its subject.
pub fn crowded_form(t: Tree, k: u32) -> u32 {
    let open = k == OAK_OPEN || k == BEECH_OPEN || k == BIRCH_OPEN
    if !open || t.lift > 0.0 || !crowded(t) {
        k
    } else if k == OAK_OPEN {
        OAK_FOREST
    } else if k == BEECH_OPEN {
        BEECH_FOREST
    } else {
        BIRCH_FOREST
    }
}

fn living_kind(t: Tree) -> u32 {
    let open = t.light > 0.55
    if (t.kind == OAK || t.kind == BEECH) && t.girth >= VETERAN {
        GREAT
    } else if t.kind == THORN {
        HAWTHORN
    } else if t.kind == BLACKTHORN {
        SLOE
    } else if t.tall < 3.5 {
        if t.kind == PINE { YOUNG_PINE } else { YOUNG_BROAD }
    } else if t.kind == OAK {
        if open { OAK_OPEN } else { OAK_FOREST }
    } else if t.kind == BEECH {
        if open { BEECH_OPEN } else { BEECH_FOREST }
    } else if t.kind == BIRCH {
        if open { BIRCH_OPEN } else { BIRCH_FOREST }
    } else if t.kind == PINE {
        if open { PINE_OPEN } else { PINE_FOREST }
    } else {
        if t.seed % 2 == 0 { ALDER_A } else { ALDER_B }
    }
}

/// How thick an oak's or a beech's trunk is (its radius, m) that it's drawn as the great tree
/// (`GREAT`, `examples/great-tree`): a veteran of the grown world's ancient wood (`species::ancient`),
/// broad and spreading over its younger neighbours.
const VETERAN: f32 = 1.2

/// Lowest point of a trunk section, including its tilt. Its circular section stays round.
fn log_support(inst: Instance, trunk: Tube<4>, t: f32) -> vec3 {
    let (centre, tangent, radius) = limb_axis(trunk, mix(1.0 / 3.0, 2.0 / 3.0, t))
    let axis = inst.turn(tangent)
    let down = vec3(0.0, -1.0, 0.0) + axis * axis.y
    inst.place(centre) + down / max(length(down), 1.0e-5) * (radius * inst.scale)
}

/// Fit the two ends of the solid trunk to the terrain, then raise it only enough to rest on
/// intervening high ground. A rigid log can bridge a hollow; it cannot hang horizontally
/// from its uphill root. Decay's shallow burial is applied after finding its supports.
fn settle_log(inst: Instance, trunk: Tube<4>, height: fn(vec2) -> f32, sink: f32) -> Instance {
    var out = inst
    for _ in 0..6 {
        let a = log_support(out, trunk, 0.0)
        let b = log_support(out, trunk, 1.0)
        let da = height(a.xz) - a.y
        let db = height(b.xz) - b.y
        out.at.y += da
        out.pitch = clamp(out.pitch + atan2(db - da, max(length(b.xz - a.xz), 0.1)), -1.1, 1.1)
    }
    var lift = -1.0e6
    for i in 0..17 {
        let p = log_support(out, trunk, f32(i) / 16.0)
        lift = max(lift, height(p.xz) - p.y)
    }
    out.at.y += lift - sink
    out
}

/// The same decayed, terrain-supported fallen tree for drawing and collision.
pub fn fallen_placement(t: Tree, height: fn(vec2) -> f32) -> Placed {
    let rot = clamp(f32(PRESENT - t.fell) / (2.0 * t.tall + 4.0), 0.0, 1.0)
    let len = t.tall * 0.85 * (1.0 - 0.3 * rot)
    let kind = if t.girth > 0.35 { LOG_LONG } else { LOG_SHORT }
    var p = instance(
        kind,
        t.at,
        height(t.at),
        len,
        t.fall,
        t.seed,
        sink: 0.0,
        fork: 0.0,
        wide: 1.0,
        tint: tint(t.seed),
    )
    p.at.scale = clamp(len / BUILT[kind], 0.25, 1.8)
    p.at = settle_log(p.at, TRUNKS[kind], height, 0.3 * rot * t.girth)
    p
}

const FALLEN_LIMBS = [kind_plant(LOG_SHORT).limbs, kind_plant(LOG_LONG).limbs]

/// All of a placed log's wood in the world, including its root plate. Collision samples the
/// same curved axes and radii as the renderer, including decay, scale, yaw and terrain pitch.
pub fn fallen_limbs(p: Placed) -> Bounded<Tube<4>, engine::plant::MAX_LIMBS> {
    var limbs = FALLEN_LIMBS[if p.kind == LOG_LONG { 1 } else { 0 }]
    for i in 0..limbs.len() {
        var limb = limbs[i]
        for j in 0..4 {
            limb.points[j] = p.at.place(limb.points[j])
            limb.radii[j] *= p.at.scale
        }
        limbs[i] = limb
    }
    limbs
}

/// The instances of a tile's trees, `height(p)` the ground's height: the great oak (the kept
/// tree), each tree the history kept, living, standing dead or fallen.
pub fn placed(trees: [Tree], height: fn(vec2) -> f32) -> Vec<Placed> {
    var out: Vec<Placed> = Vec::new()
    for t in trees {
        let y = height(t.at)
        if t.pinned {
            out.push(
                Placed {
                    kind: GREAT,
                    at: Instance {
                        at: vec3(t.at.x, y, t.at.y),
                        yaw: 0.0,
                        tint: tint_of(vec2(0.0)),
                        scale: 1.0,
                        fork: 0.0,
                        wide: 1.0,
                    },
                },
            )
        } else if t.state == State::Alive {
            if t.tall > 1.2 {
                let k = drawn_kind(t)
                let tall = drawn_tall(k, t.tall)
                let wide = crown_wide(t, k, tall)
                let tint = stand_tint(t.at, height, t.seed)
                var p = instance(
                    k,
                    t.at,
                    y,
                    tall,
                    t.lean,
                    t.seed,
                    sink: 0.0,
                    fork: t.fork,
                    wide: wide,
                    tint: tint,
                )
                p.at.thick = thickness(t, k)
                out.push(p)
            }
        } else if t.state == State::Snag {
            let k = snag_kind(t)
            out.push(
                instance(
                    k,
                    t.at,
                    y,
                    t.tall,
                    vec2(0.0),
                    t.seed,
                    sink: 0.0,
                    fork: t.fork,
                    wide: 1.0,
                    tint: tint(t.seed),
                ),
            )
        } else if t.state == State::Log {
            out.push(fallen_placement(t, height))
        }
    }
    out
}

/// Each kind's plant.
pub fn plants() -> Vec<Plant> {
    var out: Vec<Plant> = Vec::new()
    for k in 0..KINDS {
        out.push(kind_plant(k))
    }
    out
}

/// The far kinds (`engine::wood::Wood::far_kinds`): each species' forest kind, drawn only far, in
/// the species' order (map.wrela's).
pub fn far_kinds() -> Vec<u32> {
    Vec::from([OAK_FOREST, BEECH_FOREST, BIRCH_FOREST, HAWTHORN, SLOE, PINE_FOREST, ALDER_A])
}

/// The far layer's instances in tile `t` (`engine::bake::Far`): each cell's tallest crown (of
/// each `step` by `step` cells, a coarser layer for afar). A coarse group retains its tallest
/// fine crown's position, height and turn; its width represents only occupied members. Empty
/// cells do not move or inflate surviving crowns. World-cell seeds agree across bake extents.
pub fn far_placed(
    far: engine::bake::Far,
    t: vec2i,
    height: fn(vec2) -> f32,
    step: u32,
) -> Vec<Placed> {
    var out: Vec<Placed> = Vec::new()
    let cells = u32(engine::place::TILE / engine::bake::FAR_CELL)
    let at = vec2u(t - far.lo) * cells
    let kinds = far_kinds()
    var j = 0
    while j < cells {
        var i = 0
        while i < cells {
            // The tallest crown of the step's cells.
            var k = far.nx * far.nz
            var occupied = 0
            for dj in 0..step {
                for di in 0..step {
                    let x = at.x + i + di
                    let z = at.y + j + dj
                    if x < far.nx && z < far.nz {
                        let c = z * far.nx + x
                        if far.kind[c] < kinds.len() && far.tall[c] >= 3.0 {
                            occupied += 1
                            if k == far.nx * far.nz || far.tall[c] > far.tall[k] {
                                k = c
                            }
                        }
                    }
                }
            }
            i += step
            if k == far.nx * far.nz {
                continue
            }
            let species = far.kind[k]
            if far.tall[k] < 3.0 || species >= kinds.len() {
                continue
            }
            let cell = far.lo * i32(cells) + vec2i(i32(k % far.nx), i32(k / far.nx))
            let s = hash2u(cell.x, cell.y, 731)
            let p = (vec2(cell) + vec2(0.05 + 0.9 * rand(s, 1), 0.05 + 0.9 * rand(s, 2))) *
                engine::bake::FAR_CELL
            let kind = kinds[species]
            // Crowns in groups: larger together in some places, smaller in others, over about
            // `GROUP` m (even in size, the far crowns read as an orchard: round 1).
            let group = 0.85 + 0.3 * noise2(p / GROUP + vec2(3.7, 11.2))
            let widen = group * sqrt(1.0 + 0.275 * f32(occupied - 1))
            out.push(
                Placed {
                    kind: KINDS + species,
                    at: Instance {
                        at: vec3(p.x, height(p), p.y),
                        yaw: TAU * rand(s, 3),
                        tint: tint_of(stand_tint(p, height, s)),
                        scale: clamp(far.tall[k] / BUILT[kind], 0.15, 2.4),
                        fork: 0.0,
                        wide: widen,
                    },
                },
            )
        }
        j += step
    }
    out
}

/// Keep the existing straight inner capsule inside curved wood. Narrow curved twigs can
/// have no straight core; omit those instead of straightening their rendered silhouette.
fn inner_wood_capsule(limb: Tube<4>, piece: u32, at: Instance) -> (vec3, vec3, f32) {
    let a = at.place(limb.points[piece])
    let b = at.place(limb.points[piece + 1])
    let span = length(b - a)
    let dir = (b - a) / max(span, 1.0e-6)
    var alignment = 1.0
    for ring in 0..(RINGS + 1) {
        let (_, axis, _) = limb_ring_axis(limb, piece * RINGS + ring)
        // place_round keeps girth round even where the centreline is narrowed or bent.
        alignment = min(alignment, abs(dot(at.turn(axis), dir)))
    }
    let core = 0.6 * min(limb.radii[piece], limb.radii[piece + 1]) * at.scale
    // Keep both capsule spheres behind the open ring planes, and exclude the closed tip.
    let (last, _, _) = limb_ring_axis(limb, (piece + 1) * RINGS - 1)
    let cap = if piece == 2 { length(b - at.place(last)) } else { 0.0 }
    var radius = min(core, max(span - cap, 0.0) * 0.2 * alignment)
    let inset = radius / max(alignment, 1.0e-6)
    let a = a + dir * inset
    let b = b - dir * (inset + cap)
    // Fit the straight core against the actual curved, tapered triangle planes. A radius
    // allowance from centreline error alone misses oblique rings. This runs only while
    // preparing probe occluders and adds no capsules or rendered geometry.
    var vertices: Vec<vec3> = Vec::with_capacity((RINGS + 1) * (SIDES + 1))
    var normals: Vec<vec3> = Vec::with_capacity((RINGS + 1) * (SIDES + 1))
    let first = piece * (RINGS + 1) * (SIDES + 1)
    for v in 0..((RINGS + 1) * (SIDES + 1)) {
        let (centre, normal, r, _) = limb_point(limb, first + v)
        vertices.push(at.place_round(centre, normal * r))
        normals.push(at.turn(normal))
    }
    for triangle in 0..(RINGS * SIDES * 2) {
        let v = piece * RINGS * SIDES * 6 + triangle * 3
        let i = limb_corner(v) - first
        let j = limb_corner(v + 1) - first
        let k = limb_corner(v + 2) - first
        let face = cross(vertices[j] - vertices[i], vertices[k] - vertices[i])
        let size = length(face)
        if size <= 1.0e-7 { continue }
        let outward = normals[i] + normals[j] + normals[k]
        let n = face / size * if dot(face, outward) < 0.0 { -1.0 } else { 1.0 }
        let margin = -max(dot(a - vertices[i], n), dot(b - vertices[i], n))
        radius = min(radius, margin - 1.0e-5)
        if radius <= 0.0 { return (a, b, 0.0) }
    }
    (a, b, radius)
}

/// What the probes' occluder volume is cooked from, within `lo` to `hi` on the plane: each
/// instance's clumps (leaves) and limbs (wood), placed (the clearing's).
pub fn occluders(
    placed: [Placed],
    plants: [Plant],
    lo: vec2,
    hi: vec2,
) -> Vec<engine::probes::Occluder> {
    var out: Vec<engine::probes::Occluder> = Vec::new()
    for p in placed {
        let at = p.at
        if p.kind >= KINDS ||
            at.at.x < lo.x - 20.0 ||
            at.at.z < lo.y - 20.0 ||
            at.at.x > hi.x + 20.0 ||
            at.at.z > hi.y + 20.0 {
            continue
        }
        let plant = plants[p.kind]
        for i in 0..plant.clumps.len() {
            let c = plant.clumps[i]
            // A cushion (`Clump::squash`) as two capsules crossed in its plane, as tall as it.
            let r = c.radius * c.squash
            let reach = c.radius - r
            for side in [vec3(1.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0)] {
                out.push(
                    engine::probes::Occluder {
                        a: at.place(c.centre - side * reach),
                        radius: r * at.scale,
                        b: at.place(c.centre + side * reach),
                        solid: 0.0,
                    },
                )
                if reach <= 0.0 {
                    break
                }
            }
        }
        for i in 0..plant.limbs.len() {
            let l = plant.limbs[i]
            for k in 0..3 {
                let (a, b, radius) = inner_wood_capsule(l, k, at)
                if radius > 0.0 {
                    out.push(
                        engine::probes::Occluder {
                            a,
                            radius,
                            b,
                            solid: 1.0,
                        },
                    )
                }
            }
        }
    }
    out
}

/// Every new limb starts inside older wood. This catches chord-based attachments that leave
/// visible gaps where a trunk or scaffold curves.
@test
fn living_branches_join_the_parent_wood() {
    for kind in [OAK_OPEN, OAK_FOREST, BEECH_OPEN, BEECH_FOREST, BIRCH_OPEN, ALDER_A] {
        let p = kind_plant(kind)
        for i in 1..p.limbs.len() {
            let child = p.limbs[i]
            if child.points[0].y < 0.1 {
                continue
            }
            var nearest = 1.0e6
            for j in 0..i {
                for piece in 0..24 {
                    let parent = p.limbs[j]
                    let (a, _, ar) = limb_axis(parent, f32(piece) / 24.0)
                    let (b, _, br) = limb_axis(parent, f32(piece + 1) / 24.0)
                    let t = saturate(dot(child.points[0] - a, b - a) / dot(b - a, b - a))
                    let d = length(child.points[0] - mix(a, b, vec3(t))) - mix(ar, br, t)
                    nearest = min(nearest, d)
                }
            }
            assert(nearest <= 0.005, f"kind {kind} branch {i} is detached by {nearest} m")
        }
    }
}

@test
fn fallen_trunks_end_in_a_short_break_not_a_long_needle() {
    for kind in [LOG_SHORT, LOG_LONG] {
        let p = kind_plant(kind)
        let trunk = p.limbs[0]
        let cap = length(trunk.points[3] - trunk.points[2])
        assert(cap <= trunk.radii[1] * 0.6, f"log {kind} has a {cap} m pointed end")
        assert(abs(trunk.radii[2] - trunk.radii[3]) < 1.0e-6, "log narrows before its broken end")
    }
}

@test
fn fallen_logs_rest_on_slopes_and_clear_intervening_ground() {
    for kind in [LOG_SHORT, LOG_LONG] {
        let trunk = TRUNKS[kind]
        for slope in [-0.45, 0.0, 0.45] {
            for yaw in [0.0, 0.8, 2.7] {
                let height = |p: vec2| 2.0 + slope * (sin(yaw) * p.x + cos(yaw) * p.y)
                var inst = engine::plant::NO_INSTANCE
                inst.at = vec3(5.0, 2.0, -3.0)
                inst.scale = 1.2
                inst.yaw = yaw
                let fitted = settle_log(inst, trunk, height, 0.0)
                for t in [0.0, 1.0] {
                    let p = log_support(fitted, trunk, t)
                    let gap = p.y - height(p.xz)
                    assert(abs(gap) < 0.06, f"log {kind} end {t} hangs {gap} m above slope {slope}")
                }
                for i in 0..17 {
                    let p = log_support(fitted, trunk, f32(i) / 16.0)
                    assert(p.y >= height(p.xz) - 0.001, "log intersects its slope")
                }
            }
        }
        var inst = engine::plant::NO_INSTANCE
        inst.scale = 1.0
        let mound = |p: vec2| 0.7 * exp(-pow((p.y - BUILT[kind] * 0.5) / 2.0, 2.0))
        let fitted = settle_log(inst, trunk, mound, 0.0)
        var closest = 1.0e6
        for i in 0..17 {
            let p = log_support(fitted, trunk, f32(i) / 16.0)
            let gap = p.y - mound(p.xz)
            closest = min(closest, gap)
            assert(gap >= -0.001, "log cuts through an intervening mound")
        }
        assert(abs(closest) < 0.001, "log has no ground support")
    }
}

@test
fn fallen_collision_wood_matches_the_rendered_root_plate_and_trunk() {
    for kind in [LOG_SHORT, LOG_LONG] {
        var inst = engine::plant::NO_INSTANCE
        inst.at = vec3(16.0, 5.0, -11.0)
        inst.scale = 1.4
        inst.yaw = 0.8
        inst.pitch = -0.37
        let placed = Placed { kind, at: inst }
        let world = fallen_limbs(placed)
        let local = kind_plant(kind).limbs
        assert(world.len() == local.len() && world.len() > 1, "fallen root plate is missing")
        for i in 0..world.len() {
            for step in 0..13 {
                let t = f32(step) / 12.0
                let (a, an, ar) = limb_axis(local[i], t)
                let (b, bn, br) = limb_axis(world[i], t)
                assert(
                    length(inst.place(a) - b) < 0.001,
                    "collision axis differs from rendered log",
                )
                assert(
                    length(inst.turn(an) - bn) < 0.001,
                    "collision tangent differs from rendered log",
                )
                assert(
                    abs(ar * inst.scale - br) < 1.0e-5,
                    "collision girth differs from rendered log",
                )
            }
        }
    }
}

@test
fn broadleaf_crowns_have_unequal_vertical_sprays() {
    for kind in [OAK_OPEN, OAK_FOREST, BEECH_OPEN, BEECH_FOREST, BIRCH_OPEN, ALDER_A] {
        let p = kind_plant(kind)
        var lo = 2.0
        var hi = 0.0
        var small = 1.0e6
        var large = 0.0
        for i in 0..p.clumps.len() {
            let c = p.clumps[i]
            lo = min(lo, c.squash)
            hi = max(hi, c.squash)
            small = min(small, c.radius)
            large = max(large, c.radius)
        }
        assert(hi - lo > 0.2, f"kind {kind} forms identical flat canopy pads")
        assert(large > small * 1.5, f"kind {kind} has no hierarchy of foliage sprays")
        assert(
            !p.clumps.is_full() && !p.limbs.is_full(),
            f"kind {kind} silently drops authored structure",
        )
    }
}

@test
fn dead_trunks_and_branches_close_over_short_breaks() {
    for form in 0..3 {
        let p = snag(s: 31, tall: 16.0, burnt: false, conifer: false, form: form)
        let trunk = p.limbs[0]
        assert(
            length(trunk.points[3] - trunk.points[2]) < trunk.radii[3],
            "dead trunk closes into a long needle",
        )
        assert(trunk.radii[2] == trunk.radii[3], "dead trunk tapers before its break")
        let branches = if form == 1 { 2 } else { 5 }
        for i in (p.limbs.len() - branches)..p.limbs.len() {
            let limb = p.limbs[i]
            let last = (2 * (RINGS + 1) + RINGS - 1) * (SIDES + 1)
            let (solid, _, radius, _) = limb_point(limb, last)
            let (end, _, tip_radius, _) = limb_point(limb, last + SIDES + 1)
            assert(
                length(end - solid) < limb.radii[3] && radius >= limb.radii[3] && tip_radius == 0.0,
                "dead branch ends as a horn",
            )
            for joint in 0..2 {
                let a = normalize(limb.points[joint + 1] - limb.points[joint])
                let b = normalize(limb.points[joint + 2] - limb.points[joint + 1])
                assert(dot(a, b) > 0.75, "dead branch has a sharp authored elbow")
            }
        }
        if form == 2 {
            for i in 5..7 {
                let limb = p.limbs[i]
                assert(
                    length(limb.points[3] - limb.points[2]) < limb.radii[3],
                    "forked snag leader ends as a needle",
                )
            }
        }
    }
}

@test
fn far_groups_widen_without_changing_grown_height() {
    let far = engine::bake::Far {
        lo: vec2i(0),
        nx: 2,
        nz: 2,
        tall: Vec::filled(4, 20.0),
        kind: Vec::filled(n: 4, value: 0),
    }
    let fine = far_placed(far, vec2i(0), |_p: vec2| 0.0, step: 1)
    let coarse = far_placed(far, vec2i(0), |_p: vec2| 0.0, step: 2)
    assert(fine.len() == 4 && coarse.len() == 1, "far group fixture did not retain its crowns")
    for p in fine {
        assert(abs(p.at.scale - coarse[0].at.scale) < 1.0e-6, "coarse group changed tree height")
        assert(
            abs(p.at.scale * BUILT[OAK_FOREST] - 20.0) < 1.0e-4,
            "stand variation changed grown height",
        )
    }
    assert(coarse[0].at.wide > 1.0, "coarse group did not cover its wider cell")
}

@test
fn far_groups_retain_fine_anchors_and_do_not_fill_empty_cells() {
    var far = engine::bake::Far {
        lo: vec2i(-2, 3),
        nx: 4,
        nz: 4,
        tall: Vec::filled(16, 0.0),
        kind: Vec::filled(n: 16, value: 255),
    }
    // One sparse group and one dense group, separated by two empty groups.
    for k in [1, 10, 11, 14, 15] {
        far.tall[k] = 12.0 + f32(k)
        far.kind[k] = 0
    }
    let fine = far_placed(far, far.lo, |_p: vec2| 0.0, step: 1)
    let coarse = far_placed(far, far.lo, |_p: vec2| 0.0, step: 2)
    assert(fine.len() == 5 && coarse.len() == 2, "empty groups gained crowns")
    // The same world cells packaged inside a wider bake retain their seeded anchors.
    var wider = engine::bake::Far {
        lo: vec2i(-3, 3),
        nx: 36,
        nz: 4,
        tall: Vec::filled(144, 0.0),
        kind: Vec::filled(n: 144, value: 255),
    }
    for k in [1, 10, 11, 14, 15] {
        let c = (k / 4) * 36 + 32 + k % 4
        wider.tall[c] = far.tall[k]
        wider.kind[c] = far.kind[k]
    }
    let shifted = far_placed(wider, far.lo, |_p: vec2| 0.0, step: 1)
    assert(shifted.len() == fine.len(), "bake extent changed the occupied cell count")
    for i in 0..fine.len() {
        assert(
            shifted[i].at.at == fine[i].at.at && shifted[i].at.yaw == fine[i].at.yaw,
            "bake extent changed a world cell's seeded anchor",
        )
    }
    for p in coarse {
        var matches = 0
        for f in fine {
            if p.at.at == f.at.at {
                matches += 1
                assert(
                    p.at.scale == f.at.scale && p.at.yaw == f.at.yaw,
                    "coarse crown changed its source",
                )
                if p.at.at.x < -496.0 {
                    assert(p.at.wide == f.at.wide, "one surviving crown expanded into empty cells")
                } else {
                    assert(p.at.wide > f.at.wide, "dense group lost its combined coverage")
                }
            }
        }
        assert(matches == 1, "coarse crown relocated away from its fine anchor")
    }
}

@test
fn curved_wood_reduces_inner_capsules_instead_of_flattening_branches() {
    var omitted = 0
    var retained = 0
    for kind in [OAK_OPEN, OAK_FOREST, SNAG_BROAD, LOG_LONG] {
        let p = kind_plant(kind)
        for fork in [-0.4, 0.0, 0.4] {
            let inst = Instance {
                at: vec3(11.0, 3.0, -7.0),
                yaw: 0.73,
                pitch: 0.2,
                scale: 1.3,
                wide: 0.65,
                fork,
                tint: tint_of(vec2(0.0)),
            }
            for limb in p.limbs {
                for piece in 0..3 {
                    let (a, b, radius) = inner_wood_capsule(limb, piece, inst)
                    if radius <= 0.0 {
                        omitted += 1
                        continue
                    }
                    retained += 1
                    // A capsule's support against every actual mesh triangle plane must lie
                    // inside. This covers tilted rings and the final cap, not just its axis.
                    for triangle in 0..(RINGS * SIDES * 2) {
                        var vertices = [vec3(0.0); 3]
                        var outward = vec3(0.0)
                        for corner in 0..3 {
                            let v = piece * RINGS * SIDES * 6 + triangle * 3 + corner
                            let (centre, normal, r, _) = limb_point(limb, limb_corner(v))
                            vertices[corner] = inst.place_round(centre, normal * r)
                            outward += inst.turn(normal)
                        }
                        let cross_normal = cross(
                            vertices[1] - vertices[0],
                            vertices[2] - vertices[0],
                        )
                        if length(cross_normal) <= 1.0e-7 { continue }
                        let n = normalize(cross_normal) * if dot(cross_normal, outward) < 0.0 {
                            -1.0
                        } else { 1.0 }
                        let support = max(dot(a - vertices[0], n), dot(b - vertices[0], n)) + radius
                        assert(
                            support <= 0.002,
                            f"kind {kind} piece {piece}: capsule crosses bark by {support}",
                        )
                    }
                }
            }
        }
    }
    assert(retained > 0 && omitted > 0, "curved twig cores were neither bounded nor omitted")
}
