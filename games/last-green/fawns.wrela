// The floor's fawn as drawn (D40, §H1): the hand's (`fawn::character`, M5's young deer), or with
// `main::GROWN_FAWN` the roe grown from its genome as the vale's grazer (plan three's §F:
// `kit::roe` at `kit::roe::VALE_AGE`, its muscles sized from its walk and its coat grown at that
// age, `kit::grown`), the other not built. Where a shot casts it, it stands where the shot puts
// it; in play the grown one walks after the sim's fawn (`behaviour::Fawn`), its own walker stepped
// toward where the sim's stands at the sim's pace, and its face attends to the player as the sim's
// senses notice them (F8: its ears and eyes turned, `kit::roe::attended_to`).

use behaviour::{Ahead, Fawn, turn_toward}
use engine::character::{Cast, PartOf, cast}
use engine::creature::MAX_BONES
use engine::gait::{Walker, palette, shifted, stand, step}
use engine::lit::Lighting
use engine::present::short_way
use engine::style::Style
use engine::switches::Switches
use engine::view::Camera
use ground::GROUND
use kit::gaits::{DT, body_of}
use kit::genome::{ROE, quadruped_at}
use kit::grown::{VALE_COAT, VALE_MUSCLES}
use kit::quadruped::skeleton
use kit::roe::{
    CoatLook, Face, Hide, REALIZED, Roe, SLICES, VALE_AGE, attended_to, look_of, roe, walk_at,
}
use kit::walks::WALKS
use std::gpu::RenderPass
use std::math::TAU

/// The grown fawn's proportions, its skeleton, its walk (the optimized walk on level ground at
/// its age) and the walker's body of it, as the vale's grazer's.
const QUADRUPED = quadruped_at(ROE, VALE_AGE)
const SKELETON = skeleton(QUADRUPED)
const WALK = walk_at(ROE, WALKS[0], VALE_AGE)
const BODY = body_of(QUADRUPED, WALK)

/// How far behind the sim's fawn it may fall before it's stood where that one is (m).
const FALLS_BEHIND: f32 = 1.5

/// How near the sim's fawn it stops (m).
const ARRIVED: f32 = 0.15

/// How far it turns standing before it sets its feet again (radians, **proposed**: about 20°): the
/// gait sets them only as it moves, and its legs twist past this.
const REPLANT: f32 = 0.35

/// The most of a pause it catches up on, its walker's steps and its face's easing (s): a held
/// shot, a frozen frame or a hidden tab isn't walked through in one frame.
const CATCH_UP: f32 = 0.25

/// The grown fawn's walker and face as it follows the sim's, the time (s) it's been stepped to,
/// and the time it was last drawn at.
struct Following: Copy {
    walker: Option<Walker> = None,
    /// The heading its feet were last set at.
    planted: f32 = 0.0,
    face: Face = Face {},
    stepped: f32 = 0.0,
    drawn: f32 = 0.0,
}

/// The floor's fawn: the one `main::GROWN_FAWN` chooses, posed, drawn and realized as a cast (each
/// kind's list holds it or nothing: the stage holds no room for a cast on the stack, where the
/// floor's init has little to spare).
pub struct Fawns {
    hand: Vec<Cast<fawn::creature::Coat, fawn::character::Grown, fawn::character::FawnLook>>,
    grown: Vec<Cast<Hide, Roe, CoatLook>>,
    following: Following,
}

/// The floor's fawn, as `main::GROWN_FAWN` chooses.
pub fn fawns() -> Fawns {
    var out = Fawns { hand: Vec::new(), grown: Vec::new(), following: Following {} }
    if main::GROWN_FAWN {
        out.grown.push(
            cast(
                roe(ROE, VALE_AGE, VALE_MUSCLES),
                look_of(ROE, VALE_AGE, VALE_COAT),
                REALIZED,
                SLICES,
            ),
        )
    } else {
        out.hand.push(
            cast(
                fawn::character::grown(),
                fawn::character::FawnLook {},
                fawn::character::REALIZED,
                fawn::character::SLICES,
            ),
        )
    }
    out
}

impl Fawns {
    /// Whether it's drawn this frame and not yet realized (a slice of its mesh is due).
    pub fn realizing(self) -> bool {
        if main::GROWN_FAWN {
            return self.grown.len() > 0 && self.grown[0].realizing()
        }
        self.hand.len() > 0 && self.hand[0].realizing()
    }

    /// A slice of its mesh realized (each kind's realizer built only for the kind chosen).
    pub fn realize(mut self) {
        if main::GROWN_FAWN {
            for i in 0..self.grown.len() {
                self.grown[i].realize()
            }
        } else {
            for i in 0..self.hand.len() {
                self.hand[i].realize()
            }
        }
    }

    /// Its mesh's and its palettes' bytes.
    pub fn bytes(self) -> u64 {
        var out: u64 = 0
        for c in self.hand {
            out += c.bytes()
        }
        for c in self.grown {
            out += c.bytes()
        }
        out
    }

    /// Not drawn this frame.
    pub fn hide(mut self) {
        for i in 0..self.hand.len() {
            self.hand[i].hide()
        }
        for i in 0..self.grown.len() {
            self.grown[i].hide()
        }
        self.following.walker = None
    }

    /// This frame's palette `bones` (render space), and whether it's in the moving shadow map.
    fn pose(mut self, bones: [mat4; MAX_BONES], shadowed: bool, moved: bool) {
        for i in 0..self.hand.len() {
            self.hand[i].pose(bones, shadowed: shadowed, moved: moved)
        }
        for i in 0..self.grown.len() {
            self.grown[i].pose(bones, shadowed: shadowed, moved: moved)
        }
    }

    /// Standing at rest where a shot casts it, its feet at `feet` (render space, the render
    /// space's origin `origin`), facing `heading` (radians from +z toward +x), its face attending
    /// to the eye at `eye` (world space) at the frame's time `time` (s).
    pub fn at_rest(
        mut self,
        feet: vec3,
        heading: f32,
        eye: vec3,
        time: f32,
        origin: vec3,
        moved: bool,
    ) {
        let bones = if main::GROWN_FAWN {
            // In play again after the shot, it stands where the sim's fawn is.
            self.following.walker = None
            let w = stand(GROUND, BODY, (feet + origin).xz, heading)
            self.facing(palette(SKELETON, BODY, w).bones, Some(eye), time, origin)
        } else { fawn::character::at_rest(feet, heading) }
        self.pose(bones, shadowed: true, moved: moved)
    }

    /// As the sim's fawn `f` is this frame (between its ticks), at the frame's time `time` (s),
    /// the player's eyes at `player` (world space); `origin` the render space's.
    pub fn following(
        mut self,
        f: Fawn,
        player: vec3,
        time: f32,
        origin: vec3,
        shadowed: bool,
        moved: bool,
    ) {
        let bones = if main::GROWN_FAWN { self.followed(f, player, time, origin) } else {
            behaviour::palette(f, origin)
        }
        self.pose(bones, shadowed: shadowed, moved: moved)
    }

    /// The grown fawn's palette (render space) after the sim's fawn `f`: stood where it is when it's
    /// first drawn or has fallen `FALLS_BEHIND` behind, else stepped at the walker's rate until the
    /// frame's time (the same steps whatever the frame rate, `CATCH_UP` s of them at most) toward
    /// it at its pace, or turning its way on the spot once there; its way straight ahead and
    /// unending, as the sim's own (`behaviour::Ahead`).
    fn followed(mut self, f: Fawn, player: vec3, time: f32, origin: vec3) -> [mat4; MAX_BONES] {
        let root = f.walker.root
        let to = root.pos.xz
        var walker = match self.following.walker {
            Some(w) if length(w.root.pos.xz - to) <= FALLS_BEHIND => w,
            _ => {
                self.following.stepped = time
                self.following.planted = root.heading
                stand(GROUND, BODY, to, root.heading)
            },
        }
        // At most `CATCH_UP` s behind the frame's time, and never ahead of it (a frozen frame's time
        // giving way to an earlier one).
        self.following.stepped = clamp(self.following.stepped, time - CATCH_UP, time)
        var walk = WALK.walk
        walk.speed = max(f.walker.speed, walk.speed)
        while self.following.stepped + DT <= time {
            let from = walker.root.pos.xz
            let go = length(to - from) > ARRIVED
            let dir = if go { normalize(to - from) } else { root.forward().xz }
            if go {
                // The sim's pace, but not past where it stands this step.
                walker.speed = min(max(walker.speed, f.walker.speed), length(to - from) / DT)
                self.following.planted = walker.root.heading
            } else {
                // Standing, the gait doesn't turn it: it pivots to the sim's way as the sim's does,
                // its feet set again under it each `REPLANT` of the turn.
                turn_toward(mut walker, root.heading, DT)
                if abs(short_way(walker.root.heading - self.following.planted, TAU)) > REPLANT {
                    walker = stand(GROUND, BODY, walker.root.pos.xz, walker.root.heading)
                    self.following.planted = walker.root.heading
                }
            }
            walker.along = 0.0
            step(mut walker, GROUND, Ahead { from, dir }, BODY, walk, go: go, dt: DT)
            self.following.stepped += DT
        }
        self.following.walker = Some(walker)
        // Its face to the player while the sim's senses notice them.
        let toward = if f.aware.level > land::senses::FAINT { Some(player) } else { None }
        self.facing(palette(SKELETON, BODY, walker).bones, toward, time, origin)
    }

    /// `bones` (world space) with the grown fawn's face turned toward `toward` (world space) where
    /// it's given, eased since it was last drawn (`CATCH_UP` s at most), less the render space's
    /// origin `origin`.
    fn facing(
        mut self,
        bones: [mat4; MAX_BONES],
        toward: Option<vec3>,
        time: f32,
        origin: vec3,
    ) -> [mat4; MAX_BONES] {
        let dt = clamp(time - self.following.drawn, 0.0, CATCH_UP)
        self.following.drawn = time
        shifted(
            attended_to(mut self.following.face, bones, SKELETON, QUADRUPED, toward, dt),
            origin,
        )
    }

    /// In the moving shadow map.
    pub fn shadow<P: RenderPass>(self, pass: P, view: mat4) {
        for c in self.hand {
            c.shadow(pass, view)
        }
        for c in self.grown {
            c.shadow(pass, view)
        }
    }

    /// In the scene, lit by `lt`.
    pub fn draw<P: RenderPass, Q: Switches, Y: Style>(self, pass: P, lt: Lighting<Q, Y>) {
        for c in self.hand {
            c.draw(pass, lt, lt.cam, PartOf { of: [0; 64] })
        }
        for c in self.grown {
            c.draw(pass, lt, lt.cam, PartOf { of: [0; 64] })
        }
    }

    /// Its motion: its palette against its last.
    pub fn motion<P: RenderPass>(self, pass: P, cam: Camera) {
        for c in self.hand {
            c.motion(pass, cam)
        }
        for c in self.grown {
            c.motion(pass, cam)
        }
    }
}
