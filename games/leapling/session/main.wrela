// Leapling's small session program: save policy before its renderer is loaded. The game keeps
// its progress in `SAVE` when it returns to the console; this program files it under the
// player's profile, backs it up before a new game, and hands it to the game it starts. The
// policy is platform's (`platform::session`); this program gives it the game's progress.
use leapling::progress::{Progress, SAVE, describe, read}
use platform::protocol::SaveFile
use platform::session
use platform::session::{Game, checked, summary}
use std::serialize::save

const GAME: Text = "leapling"

/// Leapling to its session program.
pub struct Leapling: Copy {}

pub type Session = session::Session<Leapling>

impl Game for Leapling {
    fn name(self) -> Text {
        GAME
    }

    fn save_path(self) -> Text {
        SAVE
    }

    fn entry(self) -> Text {
        "../leapling"
    }

    fn foreign_import(self) -> Text {
        "This file is not a Leapling save."
    }

    /// Only this game reads its progress.
    fn body(self, bytes: Vec<u8>) -> Option<Vec<u8>> {
        let Some(progress) = read(bytes.clone()) else { return None }
        Some(save(progress))
    }

    fn description(self, body: Vec<u8>) -> String {
        match read(body.clone()) {
            Some(p) => describe(p),
            None => String::new(),
        }
    }
}

pub fn init() -> Session {
    session::init(Leapling {})
}

pub fn frame(s: mut Session, time: f32, width: u32, height: u32) {
    session::frame(mut s)
}

@test
fn foreign_truncated_or_impossible_saves_are_rejected_before_writing() {
    let foreign = SaveFile {
        game: String::from("different-game"),
        version: 1,
        saved: 0,
        body: save(leapling::progress::fresh()),
    }
    assert(checked(Leapling {}, save(foreign)).is_none())
    assert(checked(Leapling {}, Vec::new()).is_none())
    assert(checked(Leapling {}, Vec::filled(12, 255)).is_none())
    let impossible = SaveFile {
        game: String::from(GAME),
        version: 1,
        saved: 0,
        body: save(Progress { cleared: 40, coins: 0, best: 0.0 }),
    }
    assert(checked(Leapling {}, save(impossible)).is_none())
    let good = SaveFile {
        game: String::from(GAME),
        version: 1,
        saved: 7,
        body: save(Progress { cleared: 1, coins: 31, best: 72.5 }),
    }
    let Some(file) = checked(Leapling {}, save(good)) else {
        assert(false, "a Leapling save imports")
        return
    }
    let info = summary(Leapling {}, file, "continue")
    assert(info.label == "Continue" && info.saved == 7)
    assert(info.description == "Course cleared, best 1:12.5, 31 coins")
}
