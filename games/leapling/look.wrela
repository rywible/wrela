// How the game looks: one fragment shader that draws the whole screen as fields over it. A dusk
// sky with its sun, three ridges behind the course at their own depths, the course's cells, the
// things in it, the hero, sparks, and the type over all. The hero's antenna and the gate light
// what is near them.
use std::gpu::FragCoord

// What the shader is told each frame. Counts are floats, as the GPU reads them.
pub struct View: Copy + GpuData {
    pub screen: vec2,
    // The course point at the screen's middle, and pixels to a cell.
    pub camera: vec2,
    pub scale: f32,
    pub time: f32,
    pub width: f32,
    pub things: f32,
    pub sparks: f32,
    pub bumps: f32,
    pub runs: f32,
    // The hero: where its feet are, which way it faces, and how it is squashed (negative:
    // stretched).
    pub hero: vec4,
    // Its velocity, how much of its grace is left, and 1 while it is hurt.
    pub motion: vec4,
    // How lit the screen is (0 black), how bright the gate is, how dim the title makes the
    // course, and 1 to hide the hero.
    pub mood: vec4,
}

// The cells, four to a vec4; things, sparks and bumps two vec4s each; type runs two vec4s each
// (their box, then the first of their segments, how many, a grey, and a glow); type segments
// one each.
@fragment
pub fn shade(
    pixel: FragCoord,
    view: View,
    cells: [vec4],
    things: [vec4],
    sparks: [vec4],
    bumps: [vec4],
    runs: [vec4],
    segments: [vec4],
) -> vec4 {
    let px = pixel.position.xy
    let p = view.camera + vec2(px.x - view.screen.x * 0.5, view.screen.y * 0.5 - px.y) / view.scale
    // One course cell in pixels, for edges a pixel wide.
    let aa = 1.0 / view.scale
    var col = backdrop(px, view)
    let lit = light(p, view)
    col = course(col, p, view, cells, bumps, lit, aa)
    col = things_over(col, p, view, things, lit, aa)
    if view.mood.w < 0.5 { col = hero_over(col, p, view, lit, aa) }
    col = sparks_over(col, p, view, sparks, aa)
    // The title dims the course behind it.
    col = mix(col, col * vec3(0.32, 0.3, 0.42), view.mood.z)
    col = type_over(col, px, view, runs, segments)
    // A soft vignette, and a little grain so the gradients don't band.
    let uv = px / view.screen
    let v = uv * (vec2(1.0) - uv)
    col *= pow(saturate(v.x * v.y * 18.0), 0.22)
    col += vec3((hash(px + vec2(view.time * 61.0, 0.0)) - 0.5) / 255.0)
    vec4(col * view.mood.x, 1.0)
}

// ---- noise -------------------------------------------------------------------------------------

fn hash(p: vec2) -> f32 {
    fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

fn hash1(x: f32) -> f32 {
    fract(sin(x * 91.3458) * 47453.5453)
}

fn noise1(x: f32) -> f32 {
    let i = floor(x)
    let f = x - i
    let u = f * f * (3.0 - 2.0 * f)
    mix(hash1(i), hash1(i + 1.0), u)
}

fn ridge(x: f32, seed: f32) -> f32 {
    noise1(x + seed) * 0.55 + noise1(x * 2.1 + seed * 1.7) * 0.28 + noise1(x * 4.3 + seed) * 0.17
}

// ---- the sky and the ridges ----------------------------------------------------------------------

fn backdrop(px: vec2, view: View) -> vec3 {
    let h = view.screen.y
    let s = view.scale
    let up = 1.0 - px.y / h
    // From the indigo overhead through magenta to a hot band at the horizon.
    var col = vec3(1.0, 0.8, 0.48)
    col = mix(col, vec3(1.0, 0.44, 0.3), smoothstep(0.16, 0.34, up))
    col = mix(col, vec3(0.66, 0.17, 0.44), smoothstep(0.3, 0.5, up))
    col = mix(col, vec3(0.22, 0.07, 0.34), smoothstep(0.48, 0.72, up))
    col = mix(col, vec3(0.04, 0.03, 0.14), smoothstep(0.7, 1.0, up))
    // Stars overhead, twinkling.
    let star = hash(floor(px / 3.0))
    if star > 0.996 && up > 0.5 {
        let twinkle = 0.5 + 0.5 * sin(view.time * (1.5 + star * 4.0) + star * 40.0)
        col += vec3(0.8, 0.85, 1.0) * twinkle * smoothstep(0.5, 0.85, up) * 0.7
    }
    // The setting sun, large, drifting a little with the view, its light raying out.
    let sun = vec2(view.screen.x * 0.7 - view.camera.x * s * 0.01, h * 0.47)
    let r = h * 0.12
    let d = length(px - sun)
    let ang = atan2(px.y - sun.y, px.x - sun.x)
    let rays = 0.5 + 0.5 * sin(ang * 12.0 + sin(ang * 5.0 + view.time * 0.1) * 2.0)
    col += vec3(1.0, 0.55, 0.3) * exp(-d / (h * 0.3)) * (0.3 + 0.2 * rays)
    col = mix(col, vec3(1.0, 0.95, 0.8), saturate(r - d + 0.5))
    // Bands of cloud across it, lit from below.
    let cx = (px.x - view.screen.x * 0.5) / s * 0.15 + view.camera.x * 0.04 + view.time * 0.03
    for k in 0..2 {
        let at = 0.6 + f32(k) * 0.12
        let band = noise1(cx * (0.5 + f32(k) * 0.3) + f32(k) * 7.0)
        let cy = (up - at - band * 0.06) * (12.0 + f32(k) * 6.0)
        let cloud = exp(-cy * cy) * smoothstep(0.3, 0.8, band)
        let lit_cloud = mix(vec3(1.0, 0.55, 0.5), vec3(0.55, 0.2, 0.5), f32(k))
        col = mix(col, lit_cloud, cloud * 0.55)
    }
    // Three ridges, far to near: each moves with the view at its own depth, each a darker
    // silhouette, its crest catching the sun; the nearest is wooded.
    let from_bottom = (h - px.y) / s
    let depth = [0.15, 0.35, 0.6]
    let base = [4.4, 3.4, 2.4]
    let rise = [2.8, 2.0, 1.0]
    let tone = [vec3(0.5, 0.17, 0.4), vec3(0.25, 0.08, 0.28), vec3(0.1, 0.04, 0.16)]
    for k in 0..3 {
        let x = (px.x - view.screen.x * 0.5) / s + view.camera.x * depth[k]
        let y = from_bottom + (view.camera.y - 5.25) * depth[k]
        var crest = base[k] + ridge(x * 0.09, f32(k) * 17.0 + 3.0) * rise[k]
        if k == 2 {
            // Pines, of uneven heights.
            let t = fract(x * 0.8)
            let tree = hash1(floor(x * 0.8))
            if tree > 0.25 { crest += (1.0 - abs(t * 2.0 - 1.0)) * (0.6 + tree * 1.6) }
        }
        if y < crest {
            var c = tone[k]
            // Haze thickens towards each crest's foot, and the crest catches the sun.
            c = mix(c, col, exp(-(crest - y) * 0.9) * (0.25 - f32(k) * 0.07))
            c += vec3(1.0, 0.5, 0.35) * exp(-(crest - y) * 7.0) * (0.5 - f32(k) * 0.14)
            col = mix(col, c, saturate((crest - y) * s * 0.7))
        }
    }
    // Fireflies drifting in front of the near ridge.
    let fx = (px.x - view.screen.x * 0.5) / s + view.camera.x * 0.8
    let cell = floor(vec2(fx, from_bottom) / 1.7)
    let seed = hash(cell)
    if seed > 0.86 && from_bottom < 7.0 {
        let wobble = vec2(
            sin(view.time * (0.6 + seed) + seed * 30.0),
            cos(view.time * (0.5 + seed) + seed * 11.0),
        ) *
            0.45
        let at = (cell + vec2(0.5) + wobble * 0.5) * 1.7
        let fly = length(vec2(fx, from_bottom) - at)
        let pulse = 0.5 + 0.5 * sin(view.time * 2.0 + seed * 20.0)
        col += vec3(0.45, 1.0, 0.75) * exp(-fly * 14.0) * pulse * 0.8
    }
    col
}

// ---- light -------------------------------------------------------------------------------------

// The light at course point `p`: the dusk all round, the hero's antenna and the gate.
fn light(p: vec2, view: View) -> vec3 {
    var l = vec3(0.62, 0.52, 0.75)
    let bulb = view.hero.xy + vec2(-view.hero.z * 0.18, 1.25)
    let d = length(p - bulb)
    l += vec3(0.45, 1.0, 0.85) * exp(-d * d * 0.09) * 0.75
    l
}

// ---- the course --------------------------------------------------------------------------------

fn cell_at(cells: [vec4], width: f32, x: f32, y: f32) -> f32 {
    if x < 0.0 || x >= width { return 1.0 }
    if y < 0.0 || y >= 15.0 { return 0.0 }
    let i = u32(y) * u32(width) + u32(x)
    cells[i >> 2][i & 3]
}

fn solid(c: f32) -> bool {
    c > 0.5 && c < 4.5
}

fn box(q: vec2, half: vec2, r: f32) -> f32 {
    let d = abs(q) - half + vec2(r)
    length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0) - r
}

fn over(col: vec3, c: vec3, a: f32) -> vec3 {
    mix(col, c, saturate(a))
}

fn course(
    col: vec3,
    p: vec2,
    view: View,
    cells: [vec4],
    bumps: [vec4],
    lit: vec3,
    aa: f32,
) -> vec3 {
    // A struck cell jumps up a little: draw it raised, and the space it left empty.
    var at = p
    for i in 0..u32(view.bumps) {
        let b = bumps[i]
        let rise = sin(saturate(b.z / 0.25) * 3.1415927) * 0.28
        if p.x >= b.x && p.x < b.x + 1.0 && p.y >= b.y + rise && p.y < b.y + 1.0 + rise {
            at = vec2(p.x, p.y - rise)
        }
    }
    let x = floor(at.x)
    let y = floor(at.y)
    let c = cell_at(cells, view.width, x, y)
    if c < 0.5 { return col }
    let q = at - vec2(x, y)
    let above = cell_at(cells, view.width, x, y + 1.0)
    if c < 1.5 {
        // Ground: deep violet earth in strata, darker the deeper it lies, a glowing lip of
        // grass where it meets the air.
        var depth = 0.0
        if solid(above) { depth = 1.0 }
        if solid(above) && solid(cell_at(cells, view.width, x, y + 2.0)) { depth = 2.0 }
        let strata = 0.5 + 0.5 * sin(at.y * 7.0 + noise1(at.x * 1.3) * 3.0)
        var base = mix(vec3(0.2, 0.13, 0.3), vec3(0.26, 0.17, 0.36), strata * 0.6)
        base *= 1.0 - (depth + 1.0 - q.y) * 0.12
        // Pebbles.
        let pebble = hash(floor(at * 5.0))
        if pebble > 0.93 { base *= 1.25 }
        var out = base * lit
        // Edges to the air catch the light.
        let left = cell_at(cells, view.width, x - 1.0, y)
        let right = cell_at(cells, view.width, x + 1.0, y)
        if !solid(left) { out += vec3(0.35, 0.22, 0.4) * exp(-q.x * 12.0) * 0.6 }
        if !solid(right) { out *= 1.0 - exp(-(1.0 - q.x) * 10.0) * 0.4 }
        if !solid(above) {
            let blade = 0.06 * (0.5 + 0.5 * sin(at.x * 23.0 + sin(at.x * 7.0) * 2.0))
            let lip = 0.8 - blade
            if q.y > lip {
                let g = mix(vec3(0.2, 0.75, 0.6), vec3(0.55, 1.0, 0.82), (q.y - lip) / (1.0 - lip))
                out = g * (lit * 0.6 + vec3(0.5))
            } else { out *= 1.0 - exp(-(lip - q.y) * 9.0) * 0.45 }
        }
        return out
    }
    if c < 2.5 {
        // Brick: warm clay, mortar between, each brick bevelled.
        let row = floor(q.y * 2.0)
        let shift = if row > 0.5 { 0.5 } else { 0.0 }
        let bx = fract(q.x * 2.0 + shift)
        let by = fract(q.y * 2.0)
        let mortar = min(min(bx, 1.0 - bx), min(by, 1.0 - by))
        var b = vec3(0.78, 0.33, 0.24) *
            (0.85 + 0.3 * hash(floor(vec2(q.x * 2.0 + shift, row) + vec2(x * 3.0, y))))
        b *= 0.75 + 0.35 * saturate(by)
        let face = mix(vec3(0.25, 0.1, 0.12), b, smoothstep(0.04, 0.09, mortar))
        return face * lit
    }
    if c < 3.5 {
        // A prize block: gold, rounded, a diamond pulsing in it.
        let d = box(q - vec2(0.5), vec2(0.47), 0.1)
        let pulse = 0.5 + 0.5 * sin(view.time * 4.0)
        var g = mix(vec3(1.0, 0.62, 0.15), vec3(1.0, 0.85, 0.35), saturate(q.y))
        g *= 0.8 + 0.25 * saturate(1.0 - q.x)
        let gem = abs(q.x - 0.5) + abs(q.y - 0.5)
        g = mix(g, vec3(1.0, 1.0, 0.85), saturate((0.2 - gem) / aa) * (0.6 + 0.4 * pulse))
        g = mix(g, vec3(0.55, 0.25, 0.05), saturate((abs(gem - 0.26) - 0.025) / -aa) * 0.8)
        g += vec3(1.0, 0.7, 0.2) * pulse * 0.15
        return over(col, g * (lit * 0.5 + vec3(0.6)), saturate(-d / aa))
    }
    if c < 4.5 {
        // A used block: dark bronze, riveted.
        let d = box(q - vec2(0.5), vec2(0.47), 0.1)
        var u = vec3(0.32, 0.22, 0.17) * (0.8 + 0.3 * q.y)
        let corner = vec2(abs(q.x - 0.5) - 0.32, abs(q.y - 0.5) - 0.32)
        if length(corner) < 0.06 { u = vec3(0.5, 0.38, 0.28) }
        return over(col, u * lit, saturate(-d / aa))
    }
    if c < 5.5 {
        // A ledge: a thin bar of metal, a strip of light under it.
        let d = box(q - vec2(0.5, 0.86), vec2(0.52, 0.12), 0.05)
        var m = mix(vec3(0.42, 0.45, 0.6), vec3(0.85, 0.88, 1.0), smoothstep(0.78, 0.98, q.y))
        m *= lit
        var out = over(col, m, saturate(-d / aa))
        let glow = exp(-abs(q.y - 0.72) * 30.0) * (0.5 + 0.5 * sin(at.x * 8.0 - view.time * 3.0))
        out += vec3(0.3, 0.95, 1.0) * glow * 0.35 * saturate(1.0 - d * 3.0)
        return out
    }
    // Spikes: three silver teeth, their tips hot.
    let k = fract(q.x * 3.0)
    let tooth = q.y - (0.75 - abs(k - 0.5) * 1.5)
    if tooth < 0.0 {
        var s = mix(
            vec3(0.45, 0.47, 0.6),
            vec3(0.95, 0.95, 1.0),
            smoothstep(0.3, 0.5, abs(k - 0.5)),
        )
        s *= lit
        s = mix(s, vec3(1.0, 0.35, 0.3), smoothstep(0.5, 0.72, q.y))
        return over(col, s, saturate(-tooth / aa))
    }
    col
}

// ---- things ------------------------------------------------------------------------------------

fn ellipse(q: vec2, r: vec2) -> f32 {
    (length(q / r) - 1.0) * min(r.x, r.y)
}

fn things_over(col: vec3, p: vec2, view: View, things: [vec4], lit: vec3, aa: f32) -> vec3 {
    var out = col
    for i in 0..u32(view.things) {
        let a = things[i * 2]
        let b = things[i * 2 + 1]
        let kind = a.x
        let at = a.yz
        let since = a.w
        if length(p - at) > 3.2 { continue }
        let q = p - at
        let phase = at.x * 1.7
        if kind < 1.5 {
            // A coin, spinning, bobbing; taken, it leaps up and fades. Popped from a block, it
            // flies up by itself.
            let taken = if since > 0.0 { saturate(since / 0.3) } else { 0.0 }
            let lift = taken * 0.8 + sin(view.time * 3.0 + phase) * 0.05
            let c = q - vec2(0.0, 0.5 + lift)
            let spin = max(abs(cos(view.time * 3.5 + phase)), 0.12)
            let d = ellipse(c, vec2(0.28 * spin, 0.32))
            let alpha = 1.0 - taken
            var g = mix(
                vec3(1.0, 0.63, 0.12),
                vec3(1.0, 0.92, 0.5),
                saturate(0.5 + c.y * 1.5 - c.x),
            )
            let inner = ellipse(c, vec2(0.17 * spin, 0.21))
            g = mix(g, vec3(0.9, 0.5, 0.08), saturate(-inner / aa) * 0.5)
            out = over(out, g, saturate(-d / aa) * alpha)
            out += vec3(1.0, 0.75, 0.3) * exp(-max(length(c) - 0.3, 0.0) * 8.0) * 0.35 * alpha
        } else if kind < 2.5 {
            // A walker: a round coral creature on two feet, eyes on where it goes. Stomped, it
            // flattens.
            let squash = if since > 0.0 { saturate(since * 6.0) } else { 0.0 }
            let step = view.time * 9.0 + phase
            let ry = mix(0.36, 0.12, squash)
            let body = q - vec2(0.0, ry)
            let d = ellipse(body, vec2(mix(0.42, 0.52, squash), ry))
            var c = mix(
                vec3(0.95, 0.38, 0.4),
                vec3(1.0, 0.6, 0.55),
                saturate(body.y / ry * 0.5 + 0.5),
            )
            c *= lit
            // Its feet.
            for f in 0..2 {
                let side = f32(f) * 2.0 - 1.0
                let lift = max(sin(step + f32(f) * 3.14), 0.0) * 0.06 * (1.0 - squash)
                let foot = ellipse(q - vec2(side * 0.2, 0.04 + lift), vec2(0.13, 0.07))
                out = over(out, vec3(0.35, 0.12, 0.18) * lit, saturate(-foot / aa))
            }
            out = over(out, vec3(0.22, 0.05, 0.14), saturate(-(d - 0.04) / aa))
            out = over(out, c, saturate(-d / aa))
            if squash < 0.5 {
                for e in 0..2 {
                    let side = f32(e) * 2.0 - 1.0
                    let eye = body - vec2(b.x * 0.14 + side * 0.13, 0.06)
                    out = over(out, vec3(1.0), saturate(-ellipse(eye, vec2(0.085, 0.11)) / aa))
                    let pupil = eye - vec2(b.x * 0.03, -0.01)
                    out = over(
                        out,
                        vec3(0.08, 0.04, 0.12),
                        saturate(-ellipse(pupil, vec2(0.045, 0.065)) / aa),
                    )
                    // A frown over each eye.
                    let brow = eye - vec2(0.0, 0.13)
                    let tilt = brow.y + side * brow.x * 0.6
                    if abs(tilt) < 0.025 && abs(brow.x) < 0.09 { out = vec3(0.3, 0.08, 0.12) }
                }
            }
        } else if kind < 3.5 {
            // A spiker: a dark sphere bristling, one red eye. Not to be stood on.
            let c = q - vec2(0.0, 0.42)
            let ang = atan2(c.y, c.x) + view.time * b.x * 1.5
            let r = 0.32 + 0.11 * pow(max(cos(ang * 8.0), 0.0), 3.0)
            let d = length(c) - r
            var s = mix(vec3(0.1, 0.1, 0.22), vec3(0.38, 0.36, 0.62), saturate(c.y * 2.0 + 0.5))
            s *= lit
            out = over(out, vec3(0.9, 0.5, 0.6), saturate(-(d - 0.025) / aa))
            out = over(out, s, saturate(-d / aa))
            let eye = length(c - vec2(b.x * 0.12, 0.05)) - 0.09
            out = over(out, vec3(1.0, 0.25, 0.25), saturate(-eye / aa))
            out += vec3(1.0, 0.2, 0.15) * exp(-max(eye, 0.0) * 18.0) * 0.4
        } else if kind < 4.5 {
            // A spring: a plate, a coil, a pad that drops when it throws.
            let squeeze = if since > 0.0 { exp(-since * 10.0) } else { 0.0 }
            let top = mix(0.6, 0.3, squeeze)
            let plate = box(q - vec2(0.0, 0.05), vec2(0.4, 0.05), 0.03)
            out = over(out, vec3(0.3, 0.32, 0.45) * lit, saturate(-plate / aa))
            if q.y > 0.1 && q.y < top {
                let wave = sin((q.y - 0.1) / (top - 0.1) * 18.85) * 0.22
                if abs(q.x - wave) < 0.05 { out = vec3(0.85, 0.85, 0.95) * lit }
            }
            let pad = box(q - vec2(0.0, top), vec2(0.42, 0.07), 0.05)
            out = over(out, vec3(1.0, 0.35, 0.45) * lit, saturate(-pad / aa))
        } else if kind < 5.5 {
            // A checkpoint: a pole with a lantern, dark until the hero passes it.
            let on = if since > 0.0 { saturate(since * 3.0) } else { 0.0 }
            if abs(q.x) < 0.05 && q.y > 0.0 && q.y < 2.0 { out = vec3(0.35, 0.33, 0.45) * lit }
            let lamp = q - vec2(0.0, 2.2)
            let d = ellipse(lamp, vec2(0.2, 0.26))
            let flame = 0.8 + 0.2 * sin(view.time * 13.0 + phase)
            let c = mix(vec3(0.3, 0.3, 0.38), vec3(0.6, 1.0, 0.85) * flame, on)
            out = over(out, c, saturate(-d / aa))
            out += vec3(0.4, 1.0, 0.8) * exp(-max(d, 0.0) * 4.0) * 0.5 * on
        } else {
            // The gate: an octagonal ring of light, turning, its middle swirling.
            let c = q - vec2(0.0, 1.35)
            let ang = atan2(c.y, c.x)
            let sector = 0.7853982
            let r = length(c) * cos(ang - (floor(ang / sector + 0.5) * sector))
            let ring = abs(r - 1.0) - 0.1
            let bright = 1.0 + view.mood.y * 2.0
            let swirl = 0.5 + 0.5 * sin(ang * 3.0 - view.time * 3.0 + length(c) * 9.0)
            if r < 0.9 {
                let inner = mix(vec3(0.1, 0.35, 0.45), vec3(0.6, 1.0, 0.95), swirl * (1.0 - r))
                out = mix(out, inner * bright, 0.75)
            }
            out = over(out, vec3(0.85, 1.0, 0.98), saturate(-ring / aa))
            out += vec3(0.3, 1.0, 0.85) * exp(-max(ring, 0.0) * 5.0) * 0.6 * bright
        }
    }
    out
}

// ---- the hero ----------------------------------------------------------------------------------

fn hero_over(col: vec3, p: vec2, view: View, lit: vec3, aa: f32) -> vec3 {
    let at = view.hero.xy
    if length(p - at) > 2.5 { return col }
    let facing = view.hero.z
    let squash = view.hero.w
    let hurt = view.motion.w
    // It flickers while it can't be hurt.
    if view.motion.z > 0.0 && fract(view.motion.z * 8.0) < 0.35 { return col }
    let size = vec2(0.4 * (1.0 + squash * 0.6), 0.42 * (1.0 - squash * 0.6))
    let centre = at + vec2(0.0, size.y)
    let q = p - centre
    var out = col
    // A shadow under it on the ground.
    let shadow = ellipse(p - vec2(at.x, at.y + 0.01), vec2(0.36, 0.06))
    out *= 1.0 - saturate(-shadow / aa) * 0.3
    // Its antenna: a stalk leaning back from the way it moves, a bulb of light at the end.
    let lean = -clamp(view.motion.x * 0.04, -0.3, 0.3) - facing * 0.08
    let base = vec2(0.0, size.y * 0.85)
    let tip = vec2(lean * 1.5, size.y + 0.42)
    let stalk_t = saturate(dot(q - base, tip - base) / dot(tip - base, tip - base))
    let stalk = length(q - base - (tip - base) * stalk_t) - 0.03
    out = over(out, vec3(0.35, 0.3, 0.42), saturate(-stalk / aa))
    let bulb = length(q - tip) - 0.09
    out = over(out, vec3(0.75, 1.0, 0.9), saturate(-bulb / aa))
    out += vec3(0.35, 1.0, 0.8) * exp(-max(bulb, 0.0) * 7.0) * 0.6
    // Its body: soft and round, cream, lit from the front.
    let d = ellipse(q, size)
    var skin = mix(vec3(1.0, 0.86, 0.72), vec3(1.0, 0.97, 0.9), saturate(q.y / size.y * 0.6 + 0.5))
    if hurt > 0.5 { skin = mix(skin, vec3(1.0, 0.45, 0.45), 0.5) }
    let rim = exp(-abs(d) * 30.0) * 0.25
    out = over(out, vec3(0.16, 0.07, 0.2), saturate(-(d - 0.04) / aa))
    out += vec3(0.4, 1.0, 0.85) * exp(-max(d, 0.0) * 10.0) * 0.12
    out = over(out, skin * (lit * 0.55 + vec3(0.5)) - vec3(rim), saturate(-d / aa))
    // Cheeks.
    for s in 0..2 {
        let side = f32(s) * 2.0 - 1.0
        let cheek = ellipse(q - vec2(facing * 0.1 + side * 0.22, -0.08), vec2(0.07, 0.045))
        out = over(out, vec3(1.0, 0.55, 0.6), saturate(-cheek / aa) * 0.7)
    }
    // Eyes, looking where it goes; closed tight when hurt.
    for e in 0..2 {
        let side = f32(e) * 2.0 - 1.0
        let eye = q - vec2(facing * 0.12 + side * 0.12, 0.06)
        if hurt > 0.5 {
            let a = abs(abs(eye.x) - abs(eye.y)) - 0.012
            if abs(eye.x) < 0.06 && abs(eye.y) < 0.06 && a < 0.0 { out = vec3(0.15, 0.08, 0.15) }
        } else {
            let blink = if fract(view.time * 0.23) > 0.97 { 0.15 } else { 1.0 }
            let d = ellipse(eye, vec2(0.06, 0.1 * blink))
            out = over(out, vec3(0.08, 0.05, 0.12), saturate(-d / aa))
            let glint = length(eye - vec2(0.02, 0.04)) - 0.022
            out = over(out, vec3(1.0), saturate(-glint / aa) * blink)
        }
    }
    out
}

// ---- sparks ------------------------------------------------------------------------------------

fn sparks_over(col: vec3, p: vec2, view: View, sparks: [vec4], aa: f32) -> vec3 {
    var out = col
    for i in 0..u32(view.sparks) {
        let a = sparks[i * 2]
        let b = sparks[i * 2 + 1]
        let q = p - a.xy
        if abs(q.x) > 0.6 || abs(q.y) > 0.6 { continue }
        let fade = 1.0 - b.x
        let kind = a.w
        let size = a.z * (0.4 + 0.6 * fade)
        if kind < 0.5 {
            let d = length(q) - size
            out = over(out, vec3(0.85, 0.8, 0.9), saturate(-d / aa) * fade * 0.6)
        } else if kind < 1.5 {
            let star = min(abs(q.x) * 4.0 + abs(q.y), abs(q.y) * 4.0 + abs(q.x)) - size
            out += vec3(1.0, 0.8, 0.35) * saturate(-star / aa) * fade
            out += vec3(1.0, 0.7, 0.3) * exp(-length(q) * 14.0) * fade * 0.3
        } else if kind < 2.5 {
            let d = box(q, vec2(size * 0.8), 0.01)
            out = over(out, vec3(0.95, 0.4, 0.42), saturate(-d / aa) * fade)
        } else {
            let turn = b.y * 6.0 + b.x * 9.0
            let r = vec2(q.x * cos(turn) - q.y * sin(turn), q.x * sin(turn) + q.y * cos(turn))
            let d = box(r, vec2(size, size * 0.45), 0.0)
            let hue = fract(b.y * 7.13)
            let c = if hue < 0.33 { vec3(1.0, 0.45, 0.5) } else if hue < 0.66 {
                vec3(0.45, 1.0, 0.8)
            } else { vec3(1.0, 0.85, 0.35) }
            out = over(out, c, saturate(-d / aa) * fade)
        }
    }
    out
}

// ---- type --------------------------------------------------------------------------------------

fn type_over(col: vec3, px: vec2, view: View, runs: [vec4], segments: [vec4]) -> vec3 {
    var out = col
    let n = u32(view.runs)
    for r in 0..n {
        let bounds = runs[r * 2]
        let style = runs[r * 2 + 1]
        if style.y < 0.5 { continue }
        let reach = style.w * 3.0 + 4.0
        if px.x < bounds.x - reach ||
            px.y < bounds.y - reach ||
            px.x > bounds.z + reach ||
            px.y > bounds.w + reach {
            continue
        }
        let width = segments[u32(style.x)].x
        var d = 1.0e9
        var shade = 1.0e9
        for k in 0..u32(style.y) {
            let s = segments[u32(style.x) + 1 + k]
            let ab = s.zw - s.xy
            let t = saturate(dot(px - s.xy, ab) / max(dot(ab, ab), 0.0001))
            d = min(d, length(px - s.xy - ab * t))
            let o = px - vec2(0.0, width * 0.9) - s.xy
            let u = saturate(dot(o, ab) / max(dot(ab, ab), 0.0001))
            shade = min(shade, length(o - ab * u))
        }
        let grey = style.z
        let tint = segments[u32(style.x)].yzw
        // A shadow below, the strokes, and their glow.
        out = mix(out, out * 0.25, saturate(width - shade + 0.5) * 0.8)
        out += tint * exp(-max(d - width, 0.0) / max(style.w, 0.001)) * 0.35 * min(style.w, 1.0)
        out = mix(out, tint * grey, saturate(width - d + 0.5))
    }
    out
}
