// An `impl` of a trait that leaves out a method (or an associated type) the trait declares
// without a default.
// ---- wrong
trait Shape {
    fn area(self) -> f32
    fn perimeter(self) -> f32
}

struct Square {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
trait Shape {
    fn area(self) -> f32
    fn perimeter(self) -> f32
}

struct Square {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }

    fn perimeter(self) -> f32 {
        4.0 * self.side
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
