// A function returns a projection (`-> borrow T` or `-> mut T`) of something that isn't one
// of its `borrow` or `mut` parameters: a local, or a `take` parameter, which ends with the call.
// A projection must point into a place the caller owns.
// ---- wrong
struct World {
    values: [f32; 4],
}

fn first() -> borrow f32 {
    let w = World { values: [0.0; 4] }
    w.values[0]
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
struct World {
    values: [f32; 4],
}

fn first(w: World) -> borrow f32 {
    w.values[0]
}

pub fn frame(time: f32, width: u32, height: u32) {}
