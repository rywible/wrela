// An entry point (`@compute`, `@vertex`, `@fragment`) called like a function. The GPU runs it:
// CPU code records `dispatch(kernel.bind(...), groups: n)` or `draw(vs, fs.bind(...), ...)`. To share code, call a plain
// function from the entry point.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn fill(value: f32, out: mut Slots<f32>, id: GlobalId) {
    out[id] = value
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    fill(time, mut out, GlobalId { x: 0, y: 0, z: 0 })
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn fill(value: f32, out: mut Slots<f32>, id: GlobalId) {
    out[id] = value
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(fill.bind(time, mut out), groups: 1)
}
