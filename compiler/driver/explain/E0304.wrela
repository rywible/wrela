// A call gives one parameter twice: by position and by name, or by name twice.
// ---- wrong
fn area(width: f32, height: f32) -> f32 {
    width * height
}

fn wall() -> f32 {
    area(3.0, width: 2.0)
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
fn area(width: f32, height: f32) -> f32 {
    width * height
}

fn wall() -> f32 {
    area(3.0, height: 2.0)
}

pub fn frame(time: f32, width: u32, height: u32) {}
