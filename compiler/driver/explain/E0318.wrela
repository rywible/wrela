// A type that contains itself, so it has no size: `struct Node { next: Node }`. Hold the other
// value through a handle (`Handle<Node>` into an `Arena<Node>`), a `Vec`, or a `Box`.
// ---- wrong
struct Node {
    value: f32,
    next: Option<Node>,
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
struct Node {
    value: f32,
    next: Option<Box<Node>>,
}

pub fn frame(time: f32, width: u32, height: u32) {}
