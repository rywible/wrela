// A shipped build with a pipeline whose WGSL is over 256 KiB (vision.md's budget: a browser
// compiles each pipeline's shader while the scene loads, and the GPU's compiler takes longer
// than in proportion as a shader grows). The error is at the command that records the large
// pipeline. A test, debug or lifted build isn't checked. Move work its own pass can do there,
// keep a big function a call (`ir::opt`), or read a large table from a buffer: a constant's
// elements are written out in the WGSL of every pipeline that reads it. (How long a scene's
// pipelines take to create is measured, not counted: `clearing::the_clearing_is_playable_cold_within_its_budget`.)
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// A table the kernel reads, each of its numbers written out in the WGSL.
const TABLE: [f32; 50000] = [0.5; 50000]

@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    out[id] = TABLE[id.x % 50000]
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64)
}
// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch, write}

/// The same table, in a buffer the kernel reads.
@compute(64)
fn look(table: [f32], out: mut Slots<f32>, id: GlobalId) {
    out[id] = table[id.x % table.len()]
}

pub fn frame(time: f32, width: u32, height: u32) {
    var table: GpuBuffer<f32> = buffer(50000)
    write(mut table, 0, [0.5; 50000])
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(table, mut out), over: 64)
}
