// ---- fixed
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// The sum of `xs`, of any length: one pipeline.
@compute(64)
fn sum(xs: [u32], out: mut Slots<u32>, id: GlobalId) {
    var t = 0
    for x in xs {
        t += x
    }
    out[id] = t
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<u32> = buffer(64)
    let xs: GpuBuffer<u32> = buffer(65)
    dispatch(sum.bind(xs.span(start: 0, count: 1), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 2), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 3), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 4), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 5), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 6), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 7), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 8), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 9), mut out), over: 64)
    dispatch(sum.bind(xs.span(start: 0, count: 10), mut out), over: 64)
