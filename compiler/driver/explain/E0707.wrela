// A shipped build over one of the scene's budgets: more than 64 pipelines (those that run only
// at load count too), or a pipeline whose WGSL is over 256 KiB (vision.md's budgets; a browser
// makes and compiles them while the scene loads). The error is at the command that records the
// 65th pipeline, or the large one. A test, debug or lifted build isn't checked. Record the work
// with fewer entry points or instantiations: a kernel generic over a length is a pipeline for
// each length it's dispatched with, and one that takes a run is one pipeline for every length.
// ---- wrong
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// The sum of `xs`: a pipeline for each length.
@compute(64)
fn sum<const N: u32>(xs: [u32; N], out: mut Slots<u32>, id: GlobalId) {
    var t = 0
    for x in xs {
        t += x
    }
    out[id] = t
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<u32> = buffer(64)
    dispatch(sum.bind([1; 1], mut out), over: 64)
    dispatch(sum.bind([1; 2], mut out), over: 64)
    dispatch(sum.bind([1; 3], mut out), over: 64)
    dispatch(sum.bind([1; 4], mut out), over: 64)
    dispatch(sum.bind([1; 5], mut out), over: 64)
