// A binding that keeps a projection of a temporary. A temporary lives until the end of the
// statement that makes it (§6.1), so `let name = made().as_str()`, `borrow v = made()` or
// `let View { s } = view(made())` would point into a value that is already gone when the
// binding is used. Within one statement a projection of a temporary is fine:
// `made().as_str().len()`. Bind the owner first, in a statement of its own, and project it.
// ---- wrong
fn made(s: str) -> String {
    var out = String::new()
    out.push_str(s)
    out
}

pub fn frame(time: f32, width: u32, height: u32) {
    let name = made("ab").as_str()
    let _ = name.len()
}
// ---- fixed
fn made(s: str) -> String {
    var out = String::new()
    out.push_str(s)
    out
}

pub fn frame(time: f32, width: u32, height: u32) {
    let owned = made("ab")
    let name = owned.as_str()
    let _ = name.len()
}
