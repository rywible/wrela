// A closure that would outlive what it borrows: one that captures a projection (a borrowed
// parameter, or a place it changes), stored in a struct's field, returned, or passed where
// it's kept (a `take` parameter of a function type). A closure that captures only copies of
// values can be kept; one that borrows is called only while what it borrows lives. Capture a
// copy (`let k = c.k`), or pass the closure down to a parameter that calls it and lets it go.
// ---- wrong
struct Config {
    k: f32,
}

struct Holder {
    f: fn(f32) -> f32,
}

fn apply(h: Holder, x: f32) -> f32 {
    let f = h.f
    f(x)
}

fn scaled(c: Config, x: f32) -> f32 {
    apply(Holder { f: |y| y * c.k }, x)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let _ = scaled(Config { k: 2.0 }, time)
}
// ---- fixed
struct Config {
    k: f32,
}

struct Holder {
    f: fn(f32) -> f32,
}

fn apply(h: Holder, x: f32) -> f32 {
    let f = h.f
    f(x)
}

fn scaled(c: Config, x: f32) -> f32 {
    let k = c.k
    apply(Holder { f: |y| y * k }, x)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let _ = scaled(Config { k: 2.0 }, time)
}
