// A struct literal or pattern gives one field twice.
// ---- wrong
struct Ball {
    pos: vec2,
    radius: f32,
}

fn ball() -> Ball {
    Ball { pos: vec2(0.0), radius: 1.0, radius: 2.0 }
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
struct Ball {
    pos: vec2,
    radius: f32,
}

fn ball() -> Ball {
    Ball { pos: vec2(0.0), radius: 2.0 }
}

pub fn frame(time: f32, width: u32, height: u32) {}
