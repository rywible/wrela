// A GPU feature where it doesn't exist: `dpdx`, `fwidth`, sampling a texture or an entry
// point's inputs in CPU code, which exist where the GPU runs the code; `discard()` anywhere but
// a fragment shader, which alone has a fragment to drop.
// ---- wrong
pub fn frame(time: f32, width: u32, height: u32) {
    let rate = dpdx(time)
}
// ---- fixed
use std::gpu::FragCoord

@fragment
fn edge(pixel: FragCoord) -> vec4 {
    vec4(fwidth(pixel.position.x))
}

pub fn frame(time: f32, width: u32, height: u32) {}
