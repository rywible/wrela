// A generic function whose instances never end: each call makes a new, larger type argument
// (`grow((x, x))` inside `grow`), so there would be no last instance to compile. Use a value whose
// type stays the same, such as a `Vec`.
// ---- wrong
struct Pair<T>: Copy {
    a: T,
    b: T,
}

fn grow<T: Copy>(x: T, n: u32) -> u32 {
    if n == 0 {
        return 1
    }
    grow(Pair { a: x, b: x }, n - 1)
}

pub fn poly() -> u32 {
    grow(1, 3)
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
fn grow(xs: mut Vec<u32>, n: u32) -> u32 {
    if n == 0 {
        return xs.len()
    }
    let k = xs.len()
    for i in 0..k {
        let x = xs[i]
        xs.push(x)
    }
    grow(mut xs, n - 1)
}

pub fn poly() -> u32 {
    var xs: Vec<u32> = Vec::new()
    xs.push(1)
    grow(mut xs, 3)
}

pub fn frame(time: f32, width: u32, height: u32) {}
