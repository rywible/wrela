// `else` starts a new line. The line break after `}` ends the `if` statement, so `else` would
// start a new one. Write `} else {` on one line.
// ---- wrong
fn sign(x: f32) -> f32 {
    if x < 0.0 {
        -1.0
    }
    else {
        1.0
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
fn sign(x: f32) -> f32 {
    if x < 0.0 {
        -1.0
    } else {
        1.0
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
