// A move out of a place that a function only lends: a parameter that isn't `take`, a
// constant, a `borrow` binding. The owner keeps it; move a `.clone()`, or make the parameter
// `take`.
// ---- wrong
struct Log {
    lines: Vec<Text>,
}

fn archive(log: take Log) -> u32 {
    log.lines.len()
}

fn pass_on(log: Log) -> u32 {
    archive(take log)
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
struct Log {
    lines: Vec<Text>,
}

fn archive(log: take Log) -> u32 {
    log.lines.len()
}

fn pass_on(log: take Log) -> u32 {
    archive(take log)
}

pub fn frame(time: f32, width: u32, height: u32) {}
