// Two `impl`s of one trait that could apply to the same type: the program would have two
// answers for one call.
// ---- wrong
trait Shape {
    fn area(self) -> f32
}

struct Square {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

impl Shape for Square {
    fn area(self) -> f32 {
        0.0
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
trait Shape {
    fn area(self) -> f32
}

struct Square {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
