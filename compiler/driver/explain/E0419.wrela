// A trait set where one trait is needed: in an `impl`. A set is only a name for its traits;
// implement each trait, or declare the set where a type opts in to traits.
// ---- wrong
trait Shape = Copy + Area

trait Area {
    fn area(self) -> f32
}

struct Square: Copy {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
trait Shape = Copy + Area

trait Area {
    fn area(self) -> f32
}

struct Square: Copy {
    side: f32,
}

impl Area for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

fn total(a: Shape, b: Shape) -> f32 {
    a.area() + b.area()
}

pub fn frame(time: f32, width: u32, height: u32) {}
