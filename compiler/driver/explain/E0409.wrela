// A function whose return type names a trait, but no single type: every path returns a value
// whose type is only the trait, so there's nothing to find the type from (a function that only
// calls itself, or two that only call each other). Return a value of a concrete type.
// ---- wrong
trait Shape {
    fn area(self) -> f32
}

struct Square {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

fn forever(n: u32) -> Shape {
    forever(n + 1)
}

pub fn frame(time: f32, width: u32, height: u32) {}
// ---- fixed
trait Shape {
    fn area(self) -> f32
}

struct Square {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

fn unit_square(n: u32) -> Shape {
    Square { side: 1.0 }
}

pub fn frame(time: f32, width: u32, height: u32) {}
