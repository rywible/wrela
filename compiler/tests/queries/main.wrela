// A query that takes a closure against the same loop written by hand (AC12, language.md §6.6;
// compiler/tests/tests/suite/queries.rs times them). A grid of 4096 points in cells, sorted by
// cell; `each_within` calls a closure for each point within a radius, and `count_by_hand`
// is its loop with the closure's body written in. Both run on the CPU, and on the GPU in a
// kernel, one query per invocation.

use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch, write}

const N: u32 = 4096
const CELL: f32 = 4.0
const SIDE: u32 = 16 // cells per side: a 64 m square
const CELLS: u32 = 256

/// Points sorted by cell, and where each cell's points start.
pub struct Grid: Copy + GpuData {
    pub cell: f32,
    pub side: u32,
}

/// SplitMix-like hash: the points, the same every run.
fn hash(x: u32) -> u32 {
    var z = x.wrapping_mul(0x9e3779b9)
    z = (z ^ (z >> 16)).wrapping_mul(0x85ebca6b)
    z = (z ^ (z >> 13)).wrapping_mul(0xc2b2ae35)
    z ^ (z >> 16)
}

fn point(i: u32) -> vec2 {
    vec2(f32(hash(2 * i) % 6400), f32(hash(2 * i + 1) % 6400)) / 100.0
}

fn cell_of(p: vec2) -> u32 {
    let c = min(vec2(f32(SIDE - 1)), floor(p / CELL))
    u32(c.x) + SIDE * u32(c.y)
}

/// The points sorted by cell (a counting sort), and each cell's start (CELLS + 1 entries).
fn build() -> (Vec<vec2>, Vec<u32>) {
    var counts: Vec<u32> = Vec::new()
    for _ in 0..CELLS + 1 {
        counts.push(0)
    }
    for i in 0..N {
        counts[cell_of(point(i)) + 1] += 1
    }
    for c in 0..CELLS {
        counts[c + 1] += counts[c]
    }
    var next = counts.clone()
    var points: Vec<vec2> = Vec::new()
    for _ in 0..N {
        points.push(vec2(0.0))
    }
    for i in 0..N {
        let p = point(i)
        let c = cell_of(p)
        points[next[c]] = p
        next[c] += 1
    }
    (points, counts)
}

impl Grid {
    /// Calls `f` with each point within `radius` of `p`, cell by cell.
    pub fn each_within(self, points: [vec2], starts: [u32], p: vec2, radius: f32, f: fn(vec2)) {
        let lo = max(vec2(0.0), floor((p - radius) / self.cell))
        let hi = min(vec2(f32(self.side - 1)), floor((p + radius) / self.cell))
        let r2 = radius * radius
        for y in u32(lo.y)..u32(hi.y) + 1 {
            for x in u32(lo.x)..u32(hi.x) + 1 {
                let c = x + self.side * y
                for i in starts[c]..starts[c + 1] {
                    let d = points[i] - p
                    if dot(d, d) <= r2 {
                        f(points[i])
                    }
                }
            }
        }
    }

    /// `each_within`'s loop with the closure's body, a count, written in.
    pub fn count_by_hand(self, points: [vec2], starts: [u32], p: vec2, radius: f32) -> u32 {
        var count = 0
        let lo = max(vec2(0.0), floor((p - radius) / self.cell))
        let hi = min(vec2(f32(self.side - 1)), floor((p + radius) / self.cell))
        let r2 = radius * radius
        for y in u32(lo.y)..u32(hi.y) + 1 {
            for x in u32(lo.x)..u32(hi.x) + 1 {
                let c = x + self.side * y
                for i in starts[c]..starts[c + 1] {
                    let d = points[i] - p
                    if dot(d, d) <= r2 {
                        count += 1
                    }
                }
            }
        }
        count
    }

    pub fn count_with_closure(self, points: [vec2], starts: [u32], p: vec2, radius: f32) -> u32 {
        var count = 0
        self.each_within(points, starts, p, radius, |q| { count += 1 })
        count
    }
}

pub struct Bench {
    points: Vec<vec2>,
    starts: Vec<u32>,
    gpu_points: GpuBuffer<vec2>,
    gpu_starts: GpuBuffer<u32>,
    out: GpuBuffer<u32>,
}

const GRID: Grid = Grid { cell: CELL, side: SIDE }

pub fn init() -> Bench {
    let (points, starts) = build()
    var gpu_points: GpuBuffer<vec2> = buffer(N)
    write(mut gpu_points, 0, points)
    var gpu_starts: GpuBuffer<u32> = buffer(CELLS + 1)
    write(mut gpu_starts, 0, starts)
    Bench { points: take points, starts: take starts, gpu_points, gpu_starts, out: buffer(N) }
}

/// Every point's neighbours within 6 m, `reps` times: with the closure.
pub fn closure_queries(state: Bench, reps: u32) -> u32 {
    var total = 0
    for _ in 0..reps {
        for i in 0..N {
            total += GRID.count_with_closure(state.points, state.starts, state.points[i], 6.0)
        }
    }
    total
}

/// The same, by hand.
pub fn hand_queries(state: Bench, reps: u32) -> u32 {
    var total = 0
    for _ in 0..reps {
        for i in 0..N {
            total += GRID.count_by_hand(state.points, state.starts, state.points[i], 6.0)
        }
    }
    total
}

@compute(64)
fn closure_kernel(grid: Grid, points: [vec2], starts: [u32], out: mut Slots<u32>, id: GlobalId) {
    out[id] = grid.count_with_closure(points, starts, points[id.x], 6.0)
}

@compute(64)
fn hand_kernel(grid: Grid, points: [vec2], starts: [u32], out: mut Slots<u32>, id: GlobalId) {
    out[id] = grid.count_by_hand(points, starts, points[id.x], 6.0)
}

/// Both kernels once each frame (queries.rs times them on the GPU).
pub fn frame(state: mut Bench, time: f32, width: u32, height: u32) {
    dispatch(
        closure_kernel.bind(
            grid: GRID,
            points: state.gpu_points,
            starts: state.gpu_starts,
            out: mut state.out,
        ),
        groups: N / 64,
    )
    dispatch(
        hand_kernel.bind(
            grid: GRID,
            points: state.gpu_points,
            starts: state.gpu_starts,
            out: mut state.out,
        ),
        groups: N / 64,
    )
}
