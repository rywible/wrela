// engine::sound's mixer at its busiest (compiler/tests/tests/suite/audio.rs): every source it
// has sounds at once, from the first sample to the last. The listener, the wind, four waters,
// both brushes, four steps, two impacts and two whooshes are cued before the voice starts, so
// the samples don't depend on when the audio thread runs: Chrome's AudioWorklet and the native
// host's offline run give the same ones, bit for bit. The steps, impacts and whooshes ring for a
// minute (a palette no world would have), so each is on for the whole render: `wrela audio
// compiler/tests/mixer speed` times the worst quantum.

use engine::sound::{Babble, Breath, Cue, Palette, Surface, Swish, mix, mixer}
use std::audio::{QUANTUM, RingWriter, play}

const PALETTE: Palette = Palette {
    surfaces: [
        Surface {
            knock_hz: 80.0,
            knock_t60: 60.0,
            knock: 0.05,
            grit_hz: 3000.0,
            grit_t60: 60.0,
            grit: 0.05,
        },
        Surface {
            knock_hz: 120.0,
            knock_t60: 60.0,
            knock: 0.05,
            grit_hz: 5000.0,
            grit_q: 1.5,
            grit_t60: 60.0,
            grit: 0.05,
        },
        Surface {},
        Surface {},
        Surface {},
        Surface {},
        Surface {},
        Surface {},
    ],
    waters: [
        Babble { lo_hz: 150.0, hi_hz: 900.0, level: 0.05, rate: 0.6, depth: 0.9 },
        Babble { lo_hz: 500.0, hi_hz: 5000.0, level: 0.08, rate: 6.0, depth: 0.6 },
        Babble { lo_hz: 120.0, hi_hz: 3500.0, level: 0.3, rate: 1.5, depth: 0.15 },
        Babble { lo_hz: 900.0, hi_hz: 6000.0, level: 0.03, rate: 8.0, depth: 0.8 },
    ],
    brushes: [
        Babble { lo_hz: 1800.0, hi_hz: 8000.0, level: 0.06, rate: 3.0, depth: 0.5 },
        Babble { lo_hz: 250.0, hi_hz: 2200.0, level: 0.12, rate: 2.5, depth: 0.6 },
    ],
    impacts: [
        Surface {
            knock_hz: 85.0,
            knock_t60: 60.0,
            knock: 0.04,
            grit_hz: 1800.0,
            grit_t60: 60.0,
            grit: 0.04,
        },
        Surface {
            knock_hz: 220.0,
            knock_t60: 60.0,
            knock: 0.03,
            grit_hz: 3200.0,
            grit_q: 1.2,
            grit_t60: 60.0,
            grit: 0.04,
        },
        Surface {},
        Surface {},
    ],
    whooshes: [
        Swish { hz: 700.0, attack: 0.16, t60: 60.0, level: 0.04 },
        Swish { hz: 1800.0, q: 0.6, attack: 0.03, t60: 60.0, level: 0.03 },
    ],
    wind: Breath { rush: 0.05, leaves: 0.035 },
}

pub struct Game {
    cues: RingWriter<Cue>,
}

pub fn init() -> Game {
    let (writer, m) = mixer(PALETTE, seed: 3)
    var cues = take writer
    let _ = cues.push(Cue::Listen { at: vec3(0.0, 1.7, 0.0), forward: vec2(0.6, 0.8) })
    let _ = cues.push(Cue::Wind { gust: 0.9, toward: vec2(-0.8, 0.6), leaves: 0.5 })
    for i in 0..4 {
        let a = 1.7 * f32(i)
        let at = vec3(
            6.0 * f32(i + 1) * std::math::cos(a),
            0.0,
            6.0 * f32(i + 1) * std::math::sin(a),
        )
        let _ = cues.push(Cue::Water { slot: i, at, kind: i, flow: 0.8 })
        let _ = cues.push(
            Cue::Step {
                at: vec3(0.3 * f32(i), 0.0, 0.5),
                surface: i % 2,
                weight: 0.5 + 0.1 * f32(i),
                seed: i,
            },
        )
    }
    let _ = cues.push(Cue::Brush { brush: 0, at: vec3(0.0), amount: 0.7 })
    let _ = cues.push(Cue::Brush { brush: 1, at: vec3(0.0), amount: 0.4 })
    for k in 0..2 {
        // All to one side of the listener, so the mix stays louder on one side.
        let at = vec3(3.0, 1.0 - f32(k), -1.0 - f32(k))
        let _ = cues.push(Cue::Impact { at, kind: k, strength: 0.9, seed: 7 + k })
        let _ = cues.push(Cue::Whoosh { at: at * 0.8, kind: k, amount: 0.6, seed: 11 + k })
    }
    play(take m, mix)
    Game { cues }
}

pub fn frame(state: mut Game, time: f32, width: u32, height: u32) {}

/// How many samples one call to the voice renders.
pub fn quantum() -> u32 {
    QUANTUM
}
