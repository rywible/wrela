// mistake: a dispatch that doesn't pass a kernel parameter
// expect: E0303
// fix: no
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn fill(scale: f32, out: mut Slots<f32>, id: GlobalId) {
    out[id] = scale
}

pub fn frame(time: f32, width: u32, height: u32) {
    let out: GpuBuffer<f32> = buffer(64)
    dispatch(fill.bind(out: mut out), groups: 1)
}
