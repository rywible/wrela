// mistake: passing overlapping places, one of them `mut`
// expect: E0513
// fix: no
struct Log {
    items: Vec<f32>,
}

fn merge(into: mut Log, from: Log) {
    for x in from.items {
        into.items.push(x)
    }
}

struct World {
    log: Log,
}

fn f(w: mut World) {
    merge(mut w.log, w.log)
}
