// mistake: a kernel bound to its arguments, kept, while its buffer is bound to another dispatch
// expect: E0506
// fix: no
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn fill(value: f32, out: mut Slots<f32>, id: GlobalId) {
    out[id] = value
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    let job = fill.bind(time, mut out)
    dispatch(fill.bind(time, mut out), groups: 1)
    dispatch(job, groups: 1)
}
