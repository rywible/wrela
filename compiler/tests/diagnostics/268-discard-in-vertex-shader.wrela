// mistake: cutting a card in its vertex shader with `discard()`
// expect: E0607
// fix: no
use std::gpu::{ClipPosition, VertexIndex, discard}

struct Card: Copy {
    clip: ClipPosition,
    uv: vec2,
}

@vertex
fn card(v: VertexIndex, cut: f32) -> Card {
    let corners = [vec2(-1.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 1.0)]
    let c = corners[v.index % 3]
    if length(c) > cut {
        discard()
    }
    Card { clip: ClipPosition { position: vec4(c, 0.5, 1.0) }, uv: c }
}

@fragment
fn leaf(c: Card) -> vec4 {
    vec4(c.uv, 0.0, 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    std::gpu::begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    std::gpu::draw(card.bind(cut: 1.2), leaf, vertices: 3)
    std::gpu::present()
}
