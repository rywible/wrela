// mistake: moving a value from outside a loop inside it
// expect: E0515
// fix: no
struct Log {
    count: u32,
}

fn archive(log: take Log) -> u32 {
    log.count
}

fn f() -> u32 {
    let log = Log { count: 1 }
    var total = 0
    for i in 0..3 {
        total += archive(take log)
    }
    total
}
