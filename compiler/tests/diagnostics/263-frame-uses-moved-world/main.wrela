// mistake: #43 §11: `frame`'s code touching the world after `run` moved it to the ticker
// expect: E0500
// fix: no
use engine::run::{Asks, TickInput, run}
use engine::sim::{Sim, Tick}

pub struct World: Sim {
    pub tick: Tick,
}

impl Asks for World {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

@deterministic
fn step(w: mut World, input: TickInput<World>) {
    w.tick += 1
}

@deterministic
fn snap(w: World) -> u32 {
    w.tick
}

pub fn init() -> u32 {
    let world = World { tick: 0 }
    let _ = run(take world, hz: 60, step: step, present: snap)
    world.tick
}

pub fn frame(state: mut u32, time: f32, width: u32, height: u32) {}
