// mistake: sampling a texture in a vertex shader
// expect: E0607
// fix: no
use std::gpu::{
    ClipPosition, FragCoord, Sampler, Texture, VertexIndex, begin_screen_pass, draw, present,
    sampler, texture,
}

@vertex
fn cover(v: VertexIndex, heights: Texture, s: Sampler) -> ClipPosition {
    let h = heights.sample(s, vec2(0.5, 0.5)).x
    ClipPosition { position: vec4(f32(v.index % 2), f32(v.index / 2), h, 1.0) }
}

@fragment
fn paint(pixel: FragCoord) -> vec4 {
    vec4(1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    let heights = texture(width: 4, height: 4)
    let s = sampler()
    begin_screen_pass(clear: vec4(0.0))
    draw(cover.bind(heights: heights, s: s), paint, vertices: 3)
    present()
}
