// mistake: #43 §11: a snapshot that isn't `Plain`
// expect: E0400
// fix: no
use engine::run::{Asks, TickInput, run}
use engine::sim::{Sim, Tick}

pub struct World: Sim {
    pub tick: Tick,
}

impl Asks for World {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

pub struct Snap: Copy {
    pub ticks: u32,
}

@deterministic
fn step(w: mut World, input: TickInput<World>) {
    w.tick += 1
}

@deterministic
fn snap(w: World) -> Snap {
    Snap { ticks: w.tick }
}

pub fn init() -> u32 {
    let _ = run(World { tick: 0 }, hz: 60, step: step, present: snap)
    0
}

pub fn frame(state: mut u32, time: f32, width: u32, height: u32) {}
