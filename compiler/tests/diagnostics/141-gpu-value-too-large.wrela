// mistake: a GPU local larger than WGSL allows
// expect: E0702
// fix: no
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

@compute(64)
fn fill(out: mut Slots<f32>, id: GlobalId) {
    let xs = [1.0; 2000000000]
    out[id] = xs[id.x]
}

pub fn frame(time: f32, width: u32, height: u32) {
    let out: GpuBuffer<f32> = buffer(64)
    dispatch(fill, groups: 1, out: out)
}
