// mistake: a `borrow` binding whose `if` makes a value in one branch, not a place
// expect: E0502
// fix: no
struct Log: Clone {
    lines: Vec<Text>,
}

struct World {
    day: Log,
    night: Log,
}

fn count(w: World, dark: bool) -> u32 {
    borrow log = if dark { w.night } else { Log { lines: Vec::new() } }
    log.lines.len()
}
