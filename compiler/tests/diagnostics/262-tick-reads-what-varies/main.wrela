// mistake: #43 §11: `@deterministic` functions, as a tick's are, reading the sim clock, a hand-off's newest value, whether a job is done, and a GPU result
// expect: E0600 E0600 E0600 E0600
// fix: no
use engine::run::{Asks, TickInput, run}
use engine::sim::{Sim, Tick}
use std::gpu::{GpuBuffer, read}
use std::handoff::{Latest, handoff}
use std::par::{Task, spawn}
use std::tick::origin

pub struct World: Sim {
    pub tick: Tick,
}

impl Asks for World {
    type Ask = u32
    type Answer = u32

    @deterministic
    fn asks(self, tick: Tick) -> Vec<(u32, Tick)> {
        Vec::new()
    }

    @deterministic
    fn work(ask: u32) -> u32 {
        ask
    }
}

@deterministic
fn clock() -> f64 {
    origin()
}

@deterministic
fn peek(seen: mut Latest<u32>) -> u32 {
    seen.read()
}

@deterministic
fn finished(pending: Task<u32>) -> bool {
    pending.done()
}

@deterministic
fn gpu(counts: GpuBuffer<u32>) -> u32 {
    let _ = read(counts.span(0, 1))
    0
}

@deterministic
fn twice(x: take u32) -> u32 {
    x * 2
}

@deterministic
fn step(w: mut World, input: TickInput<World>) {
    w.tick += 1
}

@deterministic
fn snap(w: World) -> u32 {
    w.tick
}

pub fn init() -> u32 {
    let (_, first) = handoff(0)
    var latest = take first
    let _ = peek(mut latest)
    let _ = clock()
    let pending = spawn(4, twice)
    let _ = finished(pending)
    let _ = take pending.join()
    let _ = run(World { tick: 0 }, hz: 60, step: step, present: snap)
    0
}

pub fn frame(state: mut u32, time: f32, width: u32, height: u32) {}
