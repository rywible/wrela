// rejects: gen.bounds
struct S: Copy + Clone {
    k: i32,
}

impl S {
    fn make<T: Copy>(self, x: T) -> T {
        x
    }
}

fn f(s: S) -> i32 {
    let y = s.make::<f32>(1)
    let z: i32 = y //~ E0300
    let w = s.make::<f32, f32, bool>(7) //~ E0322
    let n = s.k.abs::<f32>() //~ E0322
    z
}
