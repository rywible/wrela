// accepts: trait.items trait.orphan
trait Shape {
    type Measure

    fn area(self) -> f32

    fn double(self) -> f32 {
        2.0 * self.area()
    }
}

struct Square {
    side: f32,
}

impl Shape for Square {
    type Measure = f32

    fn area(self) -> f32 {
        self.side * self.side
    }
}

// A local trait for a std type: the trait is local.
trait Doubled {
    fn doubled(self) -> f32
}

impl Doubled for f32 {
    fn doubled(self) -> f32 {
        2.0 * self
    }
}

fn f(s: Square) -> f32 {
    s.double() + s.area().doubled()
}
