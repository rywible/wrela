// accepts: trait.items trait.orphan
trait Shape {
    type Measure

    fn area(self) -> f32

    fn double(self) -> f32 {
        2.0 * self.area()
    }
}

struct Square {
    side: f32,
}

impl Shape for Square {
    type Measure = f32

    fn area(self) -> f32 {
        self.side * self.side
    }
}

// A local trait for a std type: the trait is local.
trait Doubled {
    fn doubled(self) -> f32
}

impl Doubled for f32 {
    fn doubled(self) -> f32 {
        2.0 * self
    }
}

fn f(s: Square) -> f32 {
    s.double() + s.area().doubled()
}

// A parameter stands for one type: `(T, T)` is never `(i32, f32)`, nor `Mix<T> for T` the
// same impl as `Mix<i32> for f32`.
trait Pairish {
    fn tag(self) -> u32
}

impl<T> Pairish for (T, T) {
    fn tag(self) -> u32 {
        1
    }
}

impl Pairish for (i32, f32) {
    fn tag(self) -> u32 {
        2
    }
}

trait Mix<U> {
    fn mix(self) -> u32
}

impl<T> Mix<T> for T {
    fn mix(self) -> u32 {
        3
    }
}

impl Mix<i32> for f32 {
    fn mix(self) -> u32 {
        4
    }
}
