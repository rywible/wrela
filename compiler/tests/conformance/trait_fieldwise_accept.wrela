// accepts: trait.fieldwise trait.eq-ord
// A `@fieldwise` trait is derived for every type that declares it: each method field by field,
// with hooks that see each field's name and each variant.
@fieldwise
trait Count {
    fn count(self, n: mut u32)

    fn count_field(name: Text, n: mut u32) {
        n += 1
    }

    fn count_variant(index: u32, name: Text, n: mut u32) {
        n += 100
    }
}

impl Count for f32 {
    fn count(self, n: mut u32) {}
}

struct Pair: Count + Eq + Ord {
    a: f32,
    b: f32,
}

enum Choice: Count + Eq {
    One { x: f32 },
    Two { x: f32, y: f32 },
}

fn f() -> u32 {
    var n = 0
    Pair { a: 1.0, b: 2.0 }.count(mut n)
    Choice::Two { x: 1.0, y: 2.0 }.count(mut n)
    let p = Pair { a: 1.0, b: 2.0 }
    let q = Pair { a: 1.0, b: 3.0 }
    if p < q && p != q {
        n += 1000
    }
    n
}
