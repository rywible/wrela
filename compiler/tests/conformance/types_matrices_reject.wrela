// rejects: ty.vectors
// A `matCxR` has C columns of R rows: `M * v` takes C components, `v * M` takes R, and `A * B`
// needs A's columns to be B's rows.
fn shapes() -> f32 {
    let m = mat4x3(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), vec3(0.0))
    let a = m * vec3(1.0, 2.0, 3.0) //~ E0305
    let b = vec4(1.0, 2.0, 3.0, 4.0) * m //~ E0305
    let c = m * m //~ E0305
    let d = m[4] //~ E0312
    let e = mat3x2(vec2(1.0, 0.0), vec2(0.0, 1.0)) //~ E0323
    let f = mat2x3(vec3(1.0, 0.0, 0.0), vec2(0.0, 1.0)) //~ E0300
    m[3].z
}
