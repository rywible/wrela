// rejects: trait.fieldwise-walk
@fieldwise
trait Parts: Copy {
    fn count(self) -> u32 {
        var n = 0
        for part in fields(self) {
            if part.count() == 0 {
                break //~ E0315
            }
            n += part.count()
        }
        n
    }

    fn scaled(self, k: f32) -> f32 {
        var t = 0.0
        for part in fields(self) {
            let f = |x: f32| x * k //~ E0337
            t += f(part.scaled(k))
        }
        t
    }
}

struct Ball: Copy {
    r: f32,
}

// Written by hand, it gives each method whose body walks the fields.
impl Parts for Ball { //~ E0401
    fn count(self) -> u32 {
        1
    }
}

trait Plain {
    fn total(self) -> u32 {
        var n = 0
        for part in fields(self) { //~ E0337
            n += 1
        }
        n
    }
}

pub fn frame(time: f32, width: u32, height: u32) {}
