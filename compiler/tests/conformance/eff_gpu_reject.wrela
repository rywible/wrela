// rejects: eff.gpu
// The error is at what does it, with the chain of calls from the entry point.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer}

fn record() -> u32 {
    let b: GpuBuffer<f32> = buffer(4) //~ E0600
    1
}

fn helper() -> u32 {
    record()
}

fn fact(n: u32) -> u32 {
    if n == 0 { 1 } else { n * fact(n - 1) } //~ E0600
}

@compute(64)
fn k(out: mut Slots<u32>, id: GlobalId) {
    out[id] = helper() + fact(id.x)
}
