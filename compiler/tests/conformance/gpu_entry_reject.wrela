// rejects: gpu.entry
use std::gpu::{ClipPosition, Flat, GlobalId, Slots, VertexIndex}

@compute(64)
fn returns(id: GlobalId) -> f32 { //~ E0602
    1.0
}

@vertex
fn nothing(x: f32) -> f32 { //~ E0602
    x
}

// A vertex shader passes numbers, vectors and matrices on, and structs of them, not bools or
// arrays.
struct Corner: Copy {
    pos: ClipPosition,
    parts: [f32; 2], //~ E0602
    seen: Flat<bool>, //~ E0602
}

@vertex
fn corner(v: VertexIndex) -> Corner {
    Corner {
        pos: ClipPosition { position: vec4(0.0) },
        parts: [1.0, 2.0],
        seen: Flat { value: true },
    }
}

@gpu(1, 2) //~ E0602
fn helper(x: f32) -> f32 {
    x
}
