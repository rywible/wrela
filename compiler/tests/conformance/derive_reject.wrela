// rejects: derive.gradient derive.interval eff.derived
use std::derive::{Interval, gradient, interval}


fn wobble(t: f32) -> f32 {
    var x = t
    while x > 0.0 { //~ E0701
        x -= 1.0
    }
    x
}

pub fn b(x: f32) -> f32 {
    interval(wobble, Interval { lo: x, hi: x + 1.0 }).lo
}

fn outer(x: f32) -> f32 {
    let y = x * 2.0
    wobble(y) + y
}

pub fn c(x: f32) -> f32 {
    interval(outer, Interval { lo: x, hi: x + 1.0 }).lo
}

/// A failure inside a callee, asked for twice: the second request mustn't find the first's
/// half-built derivation (it reports the loop again, not an internal error).
fn doubled(t: f32) -> f32 {
    wobble(t) * 2.0
}

pub fn d(x: f32) -> f32 {
    interval(|t: f32| doubled(t), Interval { lo: x, hi: x + 1.0 }).lo
}

pub fn e(x: f32) -> f32 {
    interval(|t: f32| doubled(t) + 1.0, Interval { lo: x, hi: x + 1.0 }).lo
}

/// How often this recurses depends on x: an interval runs both sides of the branch, so its
/// recursion might not end.
fn halve(x: f32) -> f32 {
    if x > 1.0 {
        return halve(x * 0.5) //~ E0701
    }
    x
}

pub fn f(x: f32) -> f32 {
    interval(halve, Interval { lo: x, hi: x + 1.0 }).lo
}

/// Its gradient uses its own gradient, and that one the next, without end.
fn tower(x: f32) -> f32 {
    if x > 10.0 {
        return x
    }
    gradient(tower, x + 1.0) //~ E0700
}

pub fn g(x: f32) -> f32 {
    tower(x)
}

struct Cell: Copy {
    a: f32,
    b: f32,
}

/// Which place this is depends on x. An interval runs both sides of the branch, so a write
/// through it would be to either place, which a range of one pointer can't say.
fn either(c: mut Cell, x: f32) -> mut f32 {
    if x > 0.5 { //~ E0700
        return mut c.a
    }
    mut c.b
}

fn through(x: f32) -> f32 {
    var c = Cell { a: 0.0, b: 0.0 }
    either(mut c, x) = x
    c.a + c.b
}

pub fn h(x: f32) -> f32 {
    interval(through, Interval { lo: x, hi: x + 1.0 }).hi
}

/// A range can't be written to a captured variable.
pub fn k(x: f32) -> f32 {
    var last = 0.0
    let r = interval(|t: f32| { //~ E0700
        last = t
        t * 2.0
    }, Interval { lo: x, hi: x + 1.0 })
    r.lo + last
}

// Two functions that each use the other's gradient: each derivation would need the other's.
fn ping(x: f32) -> f32 {
    gradient(pong, x) + x //~ E0700
}

fn pong(x: f32) -> f32 {
    gradient(ping, x) * x //~ E0700
}

pub fn rally(x: f32) -> f32 {
    ping(x)
}

// Values that depend on the input, passed as a run: not yet.
fn sum_of(xs: [f32]) -> f32 {
    var s = 0.0
    for x in xs {
        s += x
    }
    s
}

fn spread(x: f32) -> f32 {
    let a = [x, 2.0 * x]
    sum_of(a) //~ E0700
}

pub fn spread_slope(x: f32) -> f32 {
    gradient(spread, x)
}
