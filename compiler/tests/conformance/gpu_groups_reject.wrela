// rejects: gpu.groups
// A group passes what the GPU reads: a field it writes, a run of the CPU's memory and a value
// that isn't `GpuData` can't be in one an entry point takes.
use std::gpu::{
    ClipPosition, FragCoord, GpuSpan, GpuSpanMut, Rgba16Float, Sampler, Texture, VertexIndex,
}

struct Plain: Copy {
    on: bool,
}

borrow struct Writes {
    out: GpuSpanMut<f32>,
}

borrow struct Runs {
    xs: [f32],
}

borrow struct NotData {
    p: Plain,
}

borrow struct Fine {
    t: borrow Texture<Rgba16Float>,
    s: borrow Sampler,
    xs: GpuSpan<f32>,
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    ClipPosition { position: vec4(f32(v.index), 0.0, 0.5, 1.0) }
}

@fragment
fn writes(p: FragCoord, g: Writes) -> vec4 { //~ E0602
    vec4(1.0)
}

@fragment
fn runs(p: FragCoord, g: Runs) -> vec4 { //~ E0602
    vec4(1.0)
}

@fragment
fn not_data(p: FragCoord, g: NotData) -> vec4 { //~ E0604
    vec4(1.0)
}

@fragment
fn fine(p: FragCoord, g: Fine) -> vec4 {
    g.t.sample_level(g.s, p.position.xy, level: 0.0) * g.xs[0]
}

pub fn frame(time: f32, width: u32, height: u32) {}
