// accepts: mem.closures
fn apply(f: fn(f32) -> f32, x: f32) -> f32 {
    f(x)
}

fn f(scale: f32) -> f32 {
    let k = 2.0
    apply(|x| x * k * scale, 3.0) + apply(|x| x + 1.0, 1.0)
}

fn triple(x: f32) -> f32 {
    x * 3.0
}

// A closure or a named function bound with `let`, bound again, and called.
fn named(x: f32) -> f32 {
    let h = triple
    let c = |v: f32| h(v) + 1.0
    let d = c
    h(x) + d(x) + apply(h, x)
}

fn twice(f: fn(u32)) {
    f(0)
    f(1)
}

// A closure borrows what its body uses of a capture: `v.y` here, apart from `p`'s `v.x`.
fn parts() -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut p = v.x
    twice(|i: u32| {
        p += 1.0
        v.y += 1.0
    })
    v.x + v.y
}
