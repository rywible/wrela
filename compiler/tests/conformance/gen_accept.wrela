// accepts: gen.bounds gen.impl-trait
trait Shape {
    fn area(self) -> f32
}

struct Square: Copy {
    side: f32,
}

impl Shape for Square {
    fn area(self) -> f32 {
        self.side * self.side
    }
}

fn total<S: Shape>(a: S, b: S) -> f32 {
    a.area() + b.area()
}

fn one(s: Shape) -> f32 {
    s.area()
}

fn pick<T: Copy>(c: bool, a: T, b: T) -> T {
    if c { a } else { b }
}

fn f() -> f32 {
    let s = Square { side: 2.0 }
    total(s, s) + one(s) + pick(c: true, a: 1.0, b: 2.0) + f32(pick(c: false, a: 1, b: 2))
}
