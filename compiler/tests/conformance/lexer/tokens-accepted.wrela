//@ check-pass
// Everything the lexer accepts: identifiers, numbers, operators, punctuation and comments.
// Comments may hold anything: $ π “quotes” /* not a block comment */  

/// A doc comment.
@compute(64)
pub fn mix_all(a: f32, b: mut vec3, c: take Grid<u32, 4>) -> borrow f32 {
    let n = 1_000 + 0xFF + 0b1010 + 0o17
    var x = 1.5e-3 * 2.0e+9 / 3.25 % 7.0 ** 2.0
    x += 1; x -= 1; x *= 2; x /= 2; x %= 3; x **= 2
    let bits = (n & 3) | (n ^ 5) << 2 >> 1
    let ok = !(a == b.x) && a != 0.0 || a <= 1.0 && a >= -1.0 && a < 2.0 && a > -2.0
    let t = (1, 2).0
    for i in 0..10 { }
    for i in 0..=10 { }
    let f = |p: f32| p * 2.0
    match t { 0 => a, _ => b.x }
    std::math::sqrt::<f32>(x)
}
