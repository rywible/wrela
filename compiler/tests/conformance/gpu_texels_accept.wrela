// accepts: gpu.textures gpu.kernel-mut
// A kernel writes a texture made `writable`, each invocation its own texel, and a pass reads
// it.
use std::gpu::{
    ClipPosition, FragCoord, GlobalId, Rgba16Float, Texels, Texture, VertexIndex, begin_screen_pass,
    dispatch, draw, texture, writable_texture,
}

struct State {
    t: Texture<Rgba16Float>,
}

@compute(8, 8)
fn fill(out: mut Texels<Rgba16Float>, id: GlobalId) {
    out.store(id, vec4(f32(id.x) / 16.0, f32(id.y) / 16.0, 0.5, 1.0))
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}

@fragment
fn show(p: FragCoord, t: Texture<Rgba16Float>) -> vec4 {
    t.load(x: u32(p.position.x) % 16, y: u32(p.position.y) % 16)
}

pub fn init() -> State {
    State { t: writable_texture::<Rgba16Float>(width: 16, height: 16) }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    dispatch(fill.bind(mut s.t), groups: (2, 2, 1))
    let screen = begin_screen_pass(clear: vec4(0.0))
    draw(screen, cover, show.bind(s.t), vertices: 3)
    screen.present()
}
