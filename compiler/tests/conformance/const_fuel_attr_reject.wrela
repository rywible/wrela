// rejects: const.fuel
// `@fuel` is a whole number of units, at most 2^46, on a `const`, set once (§10).
@fuel(0) //~ E0108
const ZERO: u32 = 1

@fuel(2 ** 50) //~ E0108
const TOO_MUCH: u32 = 2

@fuel(2 ** 20)
@fuel(2 ** 21) //~ E0108
const TWICE: u32 = 3

@fuel(2 ** 20) //~ E0108
fn not_a_constant() -> u32 {
    4
}
