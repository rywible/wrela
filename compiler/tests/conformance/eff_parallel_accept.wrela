// accepts: eff.parallel
// A `@parallel fn` writes its own element and reads what it captures; `par_map_reduce`
// combines a value from each element.
@deterministic
fn step(x: mut f32, dt: f32) {
    x += dt * 2.0
}

fn double(x: mut f32) {
    x *= 2.0
}

fn run(xs: mut Vec<f32>, dt: f32) -> f32 {
    let scale = 0.5
    xs.par_each_mut(|x| step(mut x, dt * scale))
    xs.par_each_mut(double)
    xs.par_map_reduce(0.0, |x| x * x, |a, b| a + b)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var xs: Vec<f32> = Vec::new()
    xs.push(time)
    let _ = run(mut xs, 1.0 / 60.0)
}
