// accepts: gpu.uniformity
// Derivatives where every pixel reaches them together: before a branch, after branches that
// meet again, in a branch on a uniform value, and after a loop.
use std::gpu::{ClipPosition, FragCoord, VertexIndex, begin_screen_pass, draw, present}

struct Look: Copy + Clone + GpuData {
    edge: f32,
    steps: u32,
}

fn ring(p: vec2) -> f32 {
    length(p - vec2(8.0, 2.0)) - 3.0
}

@vertex
fn cover(v: VertexIndex) -> ClipPosition {
    let x = if v.index == 1 { 3.0 } else { -1.0 }
    let y = if v.index == 2 { 3.0 } else { -1.0 }
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

@fragment
fn paint(pixel: FragCoord, look: Look) -> vec4 {
    let d = ring(pixel.position.xy)
    let aa = fwidth(d)
    var inside = 0.0
    if d < 0.0 {
        inside = 1.0
    }
    let w = dpdx(inside)
    var e = 0.0
    if look.edge > 0.5 {
        e = dpdy(d)
    }
    var x = d
    var n: u32 = 0
    while n < look.steps {
        if x > 100.0 {
            break
        }
        x = x * 2.0
        n += 1
    }
    let g = fwidth(x)
    vec4(smoothstep(-aa, aa, d) + w + e, g, inside, 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(cover, paint, vertices: 3, look: Look { edge: 1.0, steps: 4 })
    present()
}
