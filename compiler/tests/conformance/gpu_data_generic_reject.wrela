// rejects: gpu.data
use std::gpu::{GlobalId, GpuBuffer, Slots, WorkgroupId, buffer, dispatch}

// A parameter of a generic type is the caller's data, whatever the type: a `WorkgroupId` given for
// it is a value to send (not the invocation's id), and it isn't `GpuData`.
@compute(64)
fn generic<T: Copy>(x: T, out: mut Slots<f32>, id: GlobalId) { //~ E0604
    let y = x
    out[id] = 1.0
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(generic.bind(x: WorkgroupId { x: 7, y: 9, z: 0 }, out: mut out), groups: 1)
}
