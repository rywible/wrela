// rejects: mem.exclusivity
struct Log {
    count: u32,
}

struct World {
    log: Log,
    values: [f32; 4],
}

fn pair(a: mut f32, b: mut f32) {
    a += b
}

fn read(w: World) -> u32 {
    w.log.count
}

fn f(w: mut World) -> u32 {
    mut v = w.values[0]
    let c = read(w) //~ E0506
    v += 1.0
    pair(mut w.values[1], mut w.values[2]) //~ E0513
    borrow l = w.log
    w.log = Log { count: 0 } //~ E0507
    c + l.count
}

enum Phase: Copy {
    Start,
    Done,
}

struct Job {
    phase: Phase,
}

fn finish(j: mut Job) -> bool {
    j.phase = Phase::Done
    false
}

// A guard can't change what a later arm tests: the `match` borrows it until an arm is chosen.
fn stage(j: mut Job) -> u32 {
    match j.phase {
        Phase::Start if finish(mut j) => 1, //~ E0507
        Phase::Start => 2,
        Phase::Done => 3,
    }
}
