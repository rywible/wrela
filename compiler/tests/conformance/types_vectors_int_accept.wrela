// accepts: ty.vectors
// Vectors of i32s, u32s and f64s: grid cells and keys, and f64 geometry.
fn cell_of(p: vec3, size: f32) -> vec3i {
    vec3i(floor(p / size))
}

fn key(c: vec3i) -> u32 {
    let u = vec3u(c) * vec3u(73856093, 19349663, 83492791)
    u.x ^ u.y ^ (u.z >> 1)
}

fn neighbours(c: vec3i) -> [vec3i; 2] {
    [c + vec3i(1, 0, 0), c - vec3i(x: 0, y: 1, z: 0)]
}

fn centre(c: vec3i, size: f32) -> vec3 {
    (vec3(c) + 0.5) * size
}

fn far(a: vec3d, b: vec3d) -> f64 {
    let d = a - b
    length(cross(d, vec3d(0.0, 1.0, 0.0))) + dot(d, d) + d.xy.y
}

fn bits(m: vec4u) -> vec4u {
    (m & vec4u(255)) | (m << 2) | min(m, vec4u(7))
}
