// rejects: ty.option
struct A: Clone { //~ E0318
    next: Option<A>,
}

struct B { //~ E0318
    c: C,
}

struct C {
    bs: [B; 2],
}

enum List {
    Cons { head: i32, tail: List }, //~^ E0318
    Nil,
}

struct Wrap<T> {
    t: T,
}

struct W { //~ E0318
    inner: Wrap<W>,
}

// Through an associated type: `Holder<Loop>` holds a `Loop::K`, which is a `Loop`.
trait Keyed {
    type K
}

struct Holder<T: Keyed> {
    k: T::K,
}

struct Loop { //~ E0318
    h: Holder<Loop>,
}

impl Keyed for Loop {
    type K = Loop
}

// Not recursive: a parameter the type doesn't hold.
struct Fine {
    w: Wrap<i32>,
}

fn f(a: A) -> i32 {
    0
}
