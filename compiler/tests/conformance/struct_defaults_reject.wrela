// rejects: struct.defaults
struct Look {
    tolerance: f32 = true, //~ E0300
    resolution: u32 = 2 + 2,
    soft: bool,
}

struct Ring<T> {
    first: T = zero(), //~ E0324
}

fn zero<T>() -> T {
    panic("no zero")
}

fn f() -> f32 {
    let l = Look { tolerance: 0.5 } //~ E0307
    l.tolerance
}

fn g() -> f32 {
    let l = Look { tolerance: 0.5, resolution: 1, soft: true, soft: false } //~ E0308
    l.tolerance
}
