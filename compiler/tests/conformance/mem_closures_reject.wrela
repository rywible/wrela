// rejects: mem.closures
struct Holder {
    f: fn(f32) -> f32, //~ E0510
}

fn make(k: f32) -> fn(f32) -> f32 { //~ E0510
    |x| x * k
}

struct Big {
    a: i32,
    b: i32,
}

enum E {
    One { big: Big },
    Two { f: f32 },
}

struct V {
    x: f32,
    y: f32,
}

struct Box<T> {
    item: T,
}

fn run(f: fn()) {
    f()
}

fn apply(f: fn(f32) -> f32, x: f32) -> f32 {
    f(x)
}

fn pass<T>(v: take T) -> T {
    v
}

fn pair(a: mut i32, b: mut i32) {
    a += 1
    b += 1
}

fn eat(v: take V) -> f32 {
    v.x
}

fn bump(x: mut i32, f: fn()) {
    x += 1
    f()
}

// `select` would choose a closure at run time.
fn selected(c: bool) -> i32 {
    var count = 0
    let inc = || { count += 10 }
    let g = select(if_false: inc, if_true: inc, cond: c) //~ E0702
    bump(mut count, g)
    count
}

// A closure kept after its block can't borrow what the block declared.
fn kept_after_block() -> f32 {
    let c = {
        let v = V { x: 1.0, y: 2.0 }
        |k: f32| v.x * k //~ E0510
    }
    apply(c, 2.0)
}

// A closure moved into another local (`take`) still holds what it captured.
fn taken_closure() -> i32 {
    var count = 0
    let inc = || { count += 10 }
    let g = take inc
    bump(mut count, g) //~ E0506
    count
}

// A `mut` projection inside a closure writes what it captured.
fn through_let() -> f32 {
    let v = V { x: 1.0, y: 2.0 }
    run(|| { //~ E0512
        mut p = v.x
        p = 42.0
    })
    v.x
}

fn through_borrowed(a: V) -> f32 {
    run(|| { //~ E0512
        mut p = a
        p.x = 99.0
    })
    a.x
}

// Inside a closure, its own projections and arguments still can't overlap what it captured.
fn captured_overlap() -> i32 {
    var x = 1
    run(|| { pair(mut x, mut x) }) //~ E0513
    x
}

// A projection the closure captures reaches what it aliased where the closure was made.
fn captured_projection() -> i32 {
    var x = 1
    mut p = x
    run(|| { pair(mut p, mut p) }) //~ E0513
    x
}

fn captured_requote() -> f32 {
    var v = V { x: 1.0, y: 2.0 }
    mut p = v
    run(|| {
        mut q = p
        p.x = 10.0 //~ E0506
        q.x += 1.0
    })
    v.x
}

fn captured_confusion() -> i32 {
    var e = E::One { big: Big { a: 7, b: 8 } }
    var out = 0
    run(|| {
        out = match e {
            E::One { big } => {
                e = E::Two { f: 1.5 } //~ E0507
                big.a
            }
            E::Two { f: _f } => 0
        }
    })
    out
}

// A closure isn't projected with `mut`.
fn mut_closure() -> f32 {
    var v = V { x: 1.0, y: 2.0 }
    mut c = || { v.x = 5.0 } //~ E0512
    let r = eat(take v) //~ E0506
    c()
    r
}

// A closure that captures a projection (here `log`, which isn't `Copy`) can't be stored, or go
// through a generic that could return or store it.
fn stored(log: Log) -> f32 {
    let t = (|x: f32| x * log.k, 9) //~ E0510
    let o = Some(|x: f32| x * log.k) //~ E0510
    let b = Box { item: |x: f32| x * log.k } //~ E0510
    let f = pass(|x: f32| x * log.k) //~ E0510
    apply(f, 1.0)
}

struct Log {
    k: f32,
    entries: [u32; 2],
}

// The body uses `v.x`, which `p` already projects mutably.
fn same_part() -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut p = v.x
    run(|| { //~ E0506
        p += 1.0
        v.x += 1.0
    })
    v.x
}
