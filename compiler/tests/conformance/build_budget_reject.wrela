// rejects: build.budget
// A shipped build's pipeline has at most 256 KiB of WGSL: one over it is E0707, at the command
// that records it.
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch}

/// A table the kernel reads, each of its numbers written out in the WGSL: about 300 KiB.
const TABLE: [f32; 50000] = [0.5; 50000]

@compute(64)
fn look(out: mut Slots<f32>, id: GlobalId) {
    out[id] = TABLE[id.x % 50000]
}

pub fn frame(time: f32, width: u32, height: u32) {
    var out: GpuBuffer<f32> = buffer(64)
    dispatch(look.bind(mut out), over: 64) //~ E0707
}
