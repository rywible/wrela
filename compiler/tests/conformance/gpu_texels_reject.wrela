// rejects: gpu.textures gpu.kernel-mut
// Texels are written through, so they're `mut`, passed `mut`, and a kernel's.
use std::gpu::{
    ClipPosition, GlobalId, Rgba16Float, Texels, VertexIndex, dispatch, texture, writable_texture,
}

@compute(8, 8)
fn read_only(out: Texels<Rgba16Float>, id: GlobalId) { //~ E0602
}

@compute(8, 8)
fn fill(out: mut Texels<Rgba16Float>, id: GlobalId) {
    out.store(id, vec4(1.0))
}

@vertex
fn corner(v: VertexIndex, out: mut Texels<Rgba16Float>) -> ClipPosition { //~ E0602
    ClipPosition { position: vec4(0.0, 0.0, 0.0, 1.0) }
}

pub fn frame(time: f32, width: u32, height: u32) {
    let t = writable_texture::<Rgba16Float>(width: 8, height: 8)
    dispatch(fill.bind(t), groups: 1) //~ E0503
}
