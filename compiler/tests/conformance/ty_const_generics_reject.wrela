// rejects: ty.const-generics
fn scale<const K: f32>(x: f32) -> f32 { //~ E0331
    x
}

fn length() -> u32 {
    4
}

fn table() -> [f32; length()] { //~ E0325
    [0.0; 4]
}

struct Window<const N: u32> {
    xs: [f32; N],
}

// A length argument is a number or a constant holding one, as an array's is.
const TWICE: u32 = 2 * 4

fn window() -> u32 {
    let w: Window<TWICE> = Window { xs: [0.0; 8] } //~ E0325
    8
}

struct Holder<T> {
    value: T,
}

fn kind_mismatches<T, const M: u32>(a: Window<T>, b: Holder<M>) { //~ E0212 E0212
}

fn value<const M: u32>() -> u32 {
    M
}

fn explicit_kind_mismatch() -> u32 {
    let a = value::<u32>() //~ E0212
    a + Window::<u32>::length() //~ E0212
}

impl<const N: u32> Window<N> {
    fn length() -> u32 { N }
}
