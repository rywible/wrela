// rejects: fn.values
trait Rate {
    fn per_second(ticks: u32) -> f32
}

struct Sim {}

impl Rate for Sim {
    fn per_second(ticks: u32) -> f32 {
        f32(ticks) * 60.0
    }
}

fn apply(f: fn(u32) -> f32, x: u32) -> f32 {
    f(x)
}

fn values() -> f32 {
    // A trait's function as a value needs the type whose implementation it is: `Sim::per_second`.
    let a = apply(Rate::per_second, 1) //~ E0212
    let b = apply(Sim::per_minute, 1) //~ E0207
    a + b
}

trait TakesCallable {
    fn tag(self) -> u32
}

impl<F: fn(take u32)> TakesCallable for F {
    fn tag(self) -> u32 { 1 }
}

fn borrows(x: u32) {}

fn callable_modes_must_match() -> u32 {
    borrows.tag() //~ E0207
}

fn bounded_modes_must_match(g: fn(u32)) -> u32 {
    g.tag() //~ E0207
}

trait DeterministicCallable {
    fn deterministic_tag(self) -> u32
}

impl<F: @deterministic fn(u32) -> u32> DeterministicCallable for F {
    fn deterministic_tag(self) -> u32 { 1 }
}

fn weaker_attributes_do_not_fit(g: fn(u32) -> u32) -> u32 {
    g.deterministic_tag() //~ E0207
}
