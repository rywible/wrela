// rejects: mod.use
struct Point {
    x: f32,
}

pub fn first(p: Point) -> f32 { //~ E0703
    p.x
}

// A result crosses as its numbers; an enum, or text, has none of its own.
pub fn pair(a: f32) -> Option<f32> { //~ E0703
    Some(a)
}

pub fn named(a: f32) -> (f32, Text) { //~ E0703
    (a, "a")
}

pub fn frame(time: f32, width: u32, height: u32) {}

// The host can't choose a generic function's types, nor hold a projection.
pub fn same<T: Copy>(x: T) -> T { //~ E0703
    x
}

pub fn view(x: f32) -> borrow f32 { //~ E0703
    x
}
