// A primitive whose stated bound is wrong (compiler/tests/tests/suite/lipschitz.rs): a sphere's
// gradient has length 1, but `Understated` says 0.5. A release build trusts it; a debug build
// checks it against the derived gradient when `to_bound` uses it, and panics.
use std::field::Surface

struct Understated: Copy + GpuData {
    radius: f32,
}

impl Surface for Understated {
    fn distance(self, p: vec3) -> f32 {
        length(p) - self.radius
    }

    fn lipschitz(self, near: f32) -> f32 {
        0.5
    }
}


/// The bound field's value at a point two radii out: 0.1 held, divided by 0.5.
pub fn bound_at() -> f32 {
    Understated { radius: 1.0 }.to_bound(0.1).distance(vec3(2.0, 0.0, 0.0))
}

pub fn frame(time: f32, width: u32, height: u32) {
}
