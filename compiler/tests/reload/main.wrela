// Hot reload (language.md §22), run by compiler/tests/tests/suite/reload.rs: a literal the CPU
// and the GPU read each frame (the screen's colour); a value cooked from literals at load and
// cooked again when one it reads changes (`std::lift::Watch`); what the program carries across a
// reload (`std::reload`); a ticker, whose ticks a new build runs again with their records; and a
// file the build ships, fetched every two seconds (a new build's from its own files).

use std::gpu::{ClipPosition, VertexIndex, begin_screen_pass, draw}
use std::handoff::{Latest, Publisher, handoff}
use std::hash::{StateHash, state_hash}
use std::input::{Event, Key}
use std::io::{Pending, Shipped, print, ship}
use std::string::String
use std::lift::{Watch, generation, reads}
use std::reload::{keep, kept}
use std::serialize::{LoadError, Serialize, load, save}
use std::tick::{Ticked, start}

/// What the ticker owns.
struct Sim {
    world: World,
    out: Publisher<Snap>,
}

struct World: Clone + StateHash {
    ticks: u32,
    spaces: u32,
    sum: u32,
}

struct Snap: Copy + Plain {
    ticks: u32,
    spaces: u32,
    sum: u32,
}

/// How much a Space press weighs in the sum.
const WEIGHT: u32 = 7

@deterministic
fn step(sim: mut Sim, t: Ticked) {
    for e in t.records {
        if let Event::KeyDown { key, .. } = e {
            if key == Key::Space {
                sim.world.spaces += 1
            }
        }
    }
    sim.world.ticks += 1
    sim.world.sum = sim.world.sum.wrapping_mul(31).wrapping_add(t.tick + WEIGHT * sim.world.spaces)
    sim.out.publish(Snap { ticks: sim.world.ticks, spaces: sim.world.spaces, sum: sim.world.sum })
}

@deterministic
fn hash(sim: Sim) -> u64 {
    state_hash(sim.world)
}

/// A file the build ships, fetched now and then.
const NOTES: Shipped = ship("notes", notes())

fn notes() -> Vec<(String, Vec<u8>)> {
    Vec::from([(String::from("note.txt"), Vec::from(String::from("a shipped file").as_bytes()))])
}

/// What the program carries across a reload.
struct Carried: Clone + Serialize {
    frames: u32,
    mark: f32,
}

pub struct Game {
    latest: Latest<Snap>,
    carried: Carried,
    /// Whether `init` found what a replaced build kept.
    restored: bool,
    /// Cooked from literals at load, and again when one it reads changes.
    cooked: f32,
    cooks: u32,
    watch: Watch,
    /// The shipped file on its way, if it's being fetched.
    fetching: Option<Pending<u8>>,
}

/// The screen's colour: the CPU clears to it, and the GPU draws its left half with it.
fn tint() -> vec3 {
    vec3(0.25, 0.5, 0.75)
}

/// What's cooked: read only when it's cooked.
fn cook() -> f32 {
    1.5 * 2.0
}

pub fn init() -> Game {
    let (out, latest) = handoff(Snap { ticks: 0, spaces: 0, sum: 0 })
    let world = World { ticks: 0, spaces: 0, sum: 0 }
    start(Sim { world: take world, out: take out }, hz: 60, step: step, hash: hash)
    let back: Result<Carried, LoadError> = load(kept())
    let restored = back.is_ok()
    let carried = match back {
        Ok(c) => c.clone(),
        Err(_) => Carried { frames: 0, mark: 0.0 },
    }
    Game {
        latest,
        carried,
        restored,
        cooked: cook(),
        cooks: 1,
        watch: Watch::new(reads(cook)),
        fetching: None,
    }
}

@vertex
pub fn half(v: VertexIndex) -> ClipPosition {
    let x = if v.index == 1 || v.index >= 4 { 0.0 } else { -1.0 }
    let y = if v.index == 2 || v.index == 4 || v.index == 5 { 1.0 } else { -1.0 }
    ClipPosition { position: vec4(x, y, 0.5, 1.0) }
}

@fragment
pub fn tinted() -> vec4 {
    vec4(tint(), 1.0)
}

pub fn frame(g: mut Game, time: f32, width: u32, height: u32) {
    if g.watch.changed() {
        g.cooked = cook()
        g.cooks += 1
    }
    g.carried.frames += 1
    // The sim, now and then: a browser's run prints it, to compare with the native host's.
    if g.carried.frames % 30 == 0 {
        borrow s = g.latest.read()
        print(f"frame {g.carried.frames}: ticks {s.ticks}, spaces {s.spaces}, sum {s.sum}")
    }
    // The shipped file, every 120 frames: whether it came.
    if g.carried.frames % 120 == 0 && g.fetching.is_none() {
        g.fetching = Some(NOTES.fetch(0))
    }
    let came = match mut g.fetching {
        Some(p) => p.poll(),
        None => None,
    }
    match take came {
        Some(Ok(b)) => {
            print(f"fetched {b.len()} bytes")
            g.fetching = None
        },
        Some(Err(_)) => {
            print("a shipped file didn't come")
            g.fetching = None
        },
        None => {},
    }
    let bytes = save(g.carried)
    keep(bytes)
    let screen = begin_screen_pass(clear: vec4(tint() * 0.5, 1.0))
    draw(screen, half, tinted, vertices: 6)
    screen.present()
}

/// The sim's newest snapshot and the table's changes: ticks, Space presses, the sum (its low
/// 16 bits), the generation.
pub fn report(g: mut Game) -> vec4 {
    borrow s = g.latest.read()
    vec4(f32(s.ticks), f32(s.spaces), f32(s.sum % 65536), f32(generation()))
}

/// What's carried, whether it was restored, and what's cooked: frames, mark, restored, cooked.
pub fn carried(g: Game) -> vec4 {
    vec4(f32(g.carried.frames), g.carried.mark, if g.restored { 1.0 } else { 0.0 }, g.cooked)
}

pub fn cooks(g: Game) -> u32 {
    g.cooks
}

pub fn set_mark(g: mut Game, mark: f32) {
    g.carried.mark = mark
}
