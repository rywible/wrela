// The herd's grazers realized one at a time, at any cell size, by the engine's `record` (#42
// AC2): into a mesh with room for the most its grid could hold, so nothing overflows. The test
// reads the mesh's buffers back (the newest the program holds: the vertices' count and items,
// the quads' count and items, the draw's and the skin pass's arguments, the holes and the
// tally) and times the passes.

use engine::creature::{ALL, Parts}
use engine::realize::{Grid, Mesh, Room, Scratch, record, record_cull, record_finish, record_slice}
use herd::grazer::{FALLOFF, Grazer, field_of, grazer}
use herd::herd::HERD
use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch, write}

pub struct Game {
    scratch: Scratch,
    mesh: Mesh,
    points: GpuBuffer<vec4>,
    dist: GpuBuffer<f32>,
    samp: GpuBuffer<vec4>,
    herd: Vec<Mesh>,
}

pub fn init() -> Game {
    Game {
        scratch: Scratch::new(1),
        mesh: Mesh::new(Room { vertices: 1, quads: 1 }),
        points: buffer(1),
        dist: buffer(1),
        samp: buffer(1),
        herd: Vec::new(),
    }
}

// ---- the field at points (AC7, and its cost against field.wgsl's) -------------------------------

/// The distance at each point, every part in.
@compute(64)
fn distances<C, F: Parts<C>>(field: F, points: [vec4], out: mut Slots<f32>, id: GlobalId) {
    out[id] = field.distance_masked(points[id.x].xyz, ALL, 0.0)
}

/// The distance and gradient at each point.
@compute(64)
fn samples<C, F: Parts<C>>(field: F, points: [vec4], out: mut Slots<vec4>, id: GlobalId) {
    let p = points[id.x].xyz
    let s = field.sample(p)
    out[id] = vec4(s.0, s.1)
}

/// Seed `s`'s field at `n` points (a multiple of 64) scattered over its bounds by xorshift
/// 12345: three new buffers, the newest the program holds: the points, the distances, and the
/// distances and gradients.
pub fn evaluate(game: mut Game, s: u32, n: u32) {
    let g = grazer(s)
    let b = g.bounds()
    var r = herd::terrain::XorShift { state: 12345 }
    var pts: Vec<vec4> = Vec::new()
    for _ in 0..n {
        pts.push(vec4(r.point(b.lo, b.hi), 0.0))
    }
    game.points = buffer(n)
    write(mut game.points, 0, pts)
    game.dist = buffer(n)
    game.samp = buffer(n)
    let field = g.field()
    dispatch(
        distances.bind(field: field, points: game.points.span(0, n), out: mut game.dist),
        groups: n / 64,
    )
    dispatch(
        samples.bind(field: field, points: game.points.span(0, n), out: mut game.samp),
        groups: n / 64,
    )
}

/// The distance and channels (torso-ness, hoof-ness) at each point, every part in.
@compute(64)
fn channel_samples(
    field: herd::grazer::GrazerField,
    points: [vec4],
    out: mut Slots<vec4>,
    id: GlobalId,
) {
    let (d, c) = field.distance_and_channels(points[id.x].xyz)
    out[id] = vec4(d, c.torso, c.hoof, 0.0)
}

/// `n` points near seed `s`'s surface (#42 AC7): `Box3::sample`'s points over its bounds, in
/// order, those within 2 cm of its surface by the CPU's distance. Three new buffers: the points,
/// and at each, the GPU's distance, and its distance and channels.
pub fn near_surface(game: mut Game, s: u32, n: u32) {
    let g = grazer(s)
    let b = g.bounds()
    var pts: Vec<vec4> = Vec::new()
    var i = 0
    while pts.len() < n {
        let p = b.sample(1, i)
        if abs(g.distance(p)) < 0.02 {
            pts.push(vec4(p, 0.0))
        }
        i += 1
    }
    game.points = buffer(n)
    write(mut game.points, 0, pts)
    game.dist = buffer(n)
    game.samp = buffer(n)
    let field = field_of(g)
    dispatch(
        distances.bind(field: field, points: game.points.span(0, n), out: mut game.dist),
        groups: n / 64,
    )
    dispatch(
        channel_samples.bind(field: field, points: game.points.span(0, n), out: mut game.samp),
        groups: n / 64,
    )
}

/// The grid seed `s` is realized on at `cell`: its blocks along x, y and z, and the cell.
pub fn grid(s: u32, cell: f32) -> (vec3u, f32) {
    let g = Grid::around(grazer(s).bounds(), cell)
    (g.size, g.cell)
}

/// Seed `s` and its grid at `cell`, with a new mesh that has room for the most the grid could
/// hold: the scratch fitted first, so the mesh's buffers are the newest.
fn prepare(game: mut Game, s: u32, cell: f32) -> (Grazer, Grid) {
    let g = grazer(s)
    let grid = Grid::around(g.bounds(), cell)
    game.scratch.fit(grid.blocks)
    game.mesh = Mesh::new(Room { vertices: grid.blocks * 8, quads: grid.blocks * 8 })
    (g, grid)
}

/// Realizes seed `s` at `cell` into a mesh of its own: the mesh's buffers are the newest.
pub fn realize(game: mut Game, s: u32, cell: f32) {
    let (g, grid) = prepare(mut game, s, cell)
    record(g.field(), grid, FALLOFF, mut game.scratch, mut game.mesh)
}

/// Realizes seed `s` at `cell` as a `Realizer` spreads a level change over frames, in `slices`
/// slices of its live blocks, into a mesh of its own: the mesh's buffers are the newest.
pub fn realize_sliced(game: mut Game, s: u32, cell: f32, slices: u32) {
    let (g, grid) = prepare(mut game, s, cell)
    let field = g.field()
    record_cull(field, grid, mut game.scratch, mut game.mesh)
    for k in 0..slices {
        record_slice(
            field,
            grid,
            slice: k,
            slices: slices,
            scratch: mut game.scratch,
            mesh: mut game.mesh,
        )
    }
    record_finish(field, grid, FALLOFF, mut game.scratch, mut game.mesh)
}

/// Realizes seed `s` at `cell` into scratch of its own, whose probe, in a debug build, holds each
/// boundary corner's value as each live block evaluated it (#42 AC2): the probe is the ninth
/// newest buffer (the mesh's eight are newer).
pub fn probe_corners(game: mut Game, s: u32, cell: f32) {
    game.scratch = Scratch::new(Grid::around(grazer(s).bounds(), cell).blocks)
    realize(mut game, s, cell)
}

pub fn frame(game: mut Game, time: f32, width: u32, height: u32) {}

/// Seeds 1 to 40 realized at `cell` back to back, each into a mesh of its own with room for
/// `vertices` and `quads` (the spike's harness sizes them by a calibration): the 40 meshes are the
/// newest buffers, five each (the vertices' count and items, the quads' count and items, the
/// draw's arguments), in seed order.
pub fn realize_herd(game: mut Game, cell: f32, vertices: u32, quads: u32) {
    var most = 0
    for s in 1..=HERD {
        most = max(most, Grid::around(grazer(s).bounds(), cell).blocks)
    }
    game.scratch.fit(most)
    var meshes: Vec<Mesh> = Vec::new()
    for s in 1..=HERD {
        var mesh = Mesh::new(Room { vertices, quads })
        let g = grazer(s)
        record(g.field(), Grid::around(g.bounds(), cell), FALLOFF, mut game.scratch, mut mesh)
        meshes.push(take mesh)
    }
    game.herd = take meshes
}
