// Five panels check the production plant field on hardware: the clump's centre, a distant
// crown, a hard blend deep inside, and part offsets at those same distant and deep points.
// The deep panel also checks the derived gradient at a symmetric pair of tied clumps.
use engine::plant::{Bark, Leaves, Plant, full, plant}
use std::field::Surface
use std::gpu::{FragCoord, GpuBuffer, begin_screen_pass, buffer_of, draw}

struct State {
    models: GpuBuffer<Plant>,
}

pub fn init() -> State {
    var plain = plant(Leaves {}, Bark {})
    plain.clump(vec3(0.0), radius: 2.0)
    var hard = plant(Leaves {}, Bark {})
    hard.blend = 100.0
    hard.clump(vec3(10.0, 0.0, 0.0), radius: 1.0)
    hard.clump(vec3(0.0), radius: 2.0)
    hard.clump(vec3(0.0), radius: 2.0)
    var pair = plant(Leaves {}, Bark {})
    pair.clump(vec3(-2.0, 0.0, 0.0), radius: 1.0)
    pair.clump(vec3(2.0, 0.0, 0.0), radius: 1.0)
    State { models: buffer_of([plain, hard, pair]) }
}

@fragment
fn check(pixel: FragCoord, models: [Plant]) -> vec4 {
    let panel = u32(pixel.position.x) / 16
    var ok = false
    if panel == 0 {
        ok = abs(models[0].clumps[0].distance(vec3(0.0)) + 2.0) < 1.0e-5
    } else if panel == 1 {
        let (d, n) = models[0].crown(vec3(1000.0, 0.0, 0.0))
        ok = abs(d - 998.0) < 1.0e-3 && length(n - vec3(1.0, 0.0, 0.0)) < 1.0e-5
    } else if panel == 2 {
        let (d, n) = models[1].crown(vec3(0.0))
        let pair = models[2]
        let derived = std::derive::gradient(|q: vec3| pair.distance(q), vec3(0.0))
        let weight = std::derive::gradient(|by: f32| pair.part_offset(vec3(0.0), 0, by), 0.0)
        ok = abs(d - (-2.0 - log(2.0) / 100.0)) < 1.0e-5 &&
            abs(length(n) - 1.0) < 1.0e-5 &&
            length(derived) < 1.0e-5 &&
            abs(weight - 0.5) < 1.0e-5
    } else if panel == 3 {
        let d = models[0].part_offset(vec3(1000.0, 0.0, 0.0), 0, by: 10.0)
        ok = abs(d - 1008.0) < 1.0e-3
    } else {
        let d = models[1].part_offset(vec3(0.0), 1, by: 0.01)
        ok = abs(d - (-2.0 - log(1.0 + exp(-1.0)) / 100.0)) < 1.0e-5
    }
    if ok { vec4(0.0, 1.0, 0.0, 1.0) } else { vec4(1.0, 0.0, 0.0, 1.0) }
}

pub fn frame(state: mut State, time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    draw(screen, full.bind(z: 0.5), check.bind(models: state.models), vertices: 3)
    screen.present()
}
