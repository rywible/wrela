// Memory one thread grew, used by the others. In Chrome, a helper whose instance started while
// the program's thread was growing the shared memory went on seeing an old size, so a block std's
// allocator gave it from memory grown since was out of bounds to it (a program whose `init`
// grew the heap for its fonts and renderer while the helpers started, and the helpers that ran
// its parallel jobs trapped). compiler/tests/tests/suite/threads.rs runs it.

use std::io::print
use std::par::{Task, spawn}

pub struct State {
    pub job: Option<Task<u32>>,
    pub done: bool,
    pub frames: u32,
}

/// A helper grows 12 MiB while the other helpers sleep. Keep those blocks alive while the
/// parallel rows allocate and write beyond them, so old per-instance memory sizes fail.
@deterministic
fn grow(n: take u32) -> u32 {
    var sum: u32 = 0
    for k in 0..n {
        var blocks: Vec<Vec<u8>> = Vec::new()
        for b in 0..48 {
            blocks.push(Vec::filled(256 << 10, u8((k + b) % 256)))
        }
        var rows: Vec<Vec<u32>> = Vec::from_fn(256, |_| Vec::new())
        rows.par_each_mut(|r| {
            for i in 0..256 {
                r.push(i)
            }
        })
        for r in rows {
            sum += r[255] % 7
        }
        for b in blocks {
            sum += u32(b[7])
        }
    }
    sum
}

/// Grow the initial heap in 64 steps (4 MiB total) while the host starts the helpers.
pub fn init() -> State {
    var blocks: Vec<Vec<u8>> = Vec::new()
    for b in 0..64 {
        blocks.push(Vec::filled(64 << 10, u8(b)))
    }
    State { job: Some(spawn(2, grow)), done: false, frames: 0 }
}

/// Until the helper finishes, grow on this thread too; then write and read each page of a
/// fresh 16 MiB block, beyond the memory available when the helpers started.
pub fn frame(state: mut State, time: f32, width: u32, height: u32) {
    if state.done {
        return
    }
    let ready = match state.job {
        Some(j) => j.done(),
        None => false,
    }
    if !ready {
        // While the helpers work, this thread grows the heap too, a block larger each frame,
        // freed: the helpers' blocks come from memory it grew.
        state.frames += 1
        let big: Vec<u8> = Vec::filled((state.frames % 64 + 1) << 16, 3)
        if big[5] != 3 {
            print("the block lost its bytes")
        }
        return
    }
    let job = std::collections::replace(mut state.job, None)
    let Some(j) = take job else { return }
    let grown = take j.join()
    var b: Vec<u8> = Vec::filled(16 << 20, 1)
    var sum: u32 = 0
    var i: u32 = 0
    while i < b.len() {
        b[i] = 2
        sum += u32(b[i])
        i += 65536
    }
    print(f"used {grown} {sum}")
    state.done = true
}
