// The AC2 and AC3 harness for the grazer (compiler/tests/tests/suite/grazer.rs drives it): GPU
// evaluation at scattered points, for comparison with spike 01's hand-written kernel, and
// block culling on the spike's grid, with the derived interval and with the spike's
// hand-written Lipschitz bound. Also AC3's corpus (compiler/tests/tests/suite/derive.rs).
use corpus::{
    Branchy, Cells, Hyperbolic, Logs, Noise, Pieces, Powers, Rational, Trig, Vectors, Waves, blob_,
    blob_spheres, blob_tape, closures_, cone_, creature, ellipsoid_, fbm_, grazer_, hoof_, oval_,
    sphere_, sphere_tape, table_, tube_, waves_tape,
}
use grazer::{Grazer, P3, PARAM_FLOATS, bounds, grazer, grazer_from, p3, params}
use std::derive::{Box3, interval}
use std::field::{Lipschitz, Surface, check_lipschitz, hash_u32}
use std::gpu::{
    ClipPosition, FragCoord, GlobalId, GpuBuffer, Slots, VertexIndex, begin_screen_pass, buffer,
    dispatch, draw, present,
}

// ---- the program's state: the buffers the tests read back --------------------------------------
/// What the last `evaluate`, `cull` and `check_gpu` wrote. A buffer lives as long as the state
/// holds it, so the tests can read it back after the call.
pub struct Results {
    points: GpuBuffer<vec4>,
    dist: GpuBuffer<f32>,
    samp: GpuBuffer<vec4>,
    live: GpuBuffer<u32>,
    out: GpuBuffer<u32>,
    dist2: GpuBuffer<f32>,
}

pub fn init() -> Results {
    Results {
        points: buffer(0),
        dist: buffer(0),
        samp: buffer(0),
        live: buffer(0),
        out: buffer(0),
        dist2: buffer(0),
    }
}

// ---- a look at it ------------------------------------------------------------------------------
struct Camera: Copy + GpuData {
    resolution: vec2,
    eye: vec3,
}

@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// Sphere-traced, lit by the derived gradient.
@fragment
fn shade<F: Surface>(pixel: FragCoord, camera: Camera, field: F) -> vec4 {
    let uv = (pixel.position.xy * 2.0 - camera.resolution) / camera.resolution.y
    let forward = normalize(vec3(0.0, 1.0, 0.6) - camera.eye)
    let right = normalize(cross(forward, vec3(y: 1.0)))
    let up = cross(right, forward)
    let dir = normalize(forward * 1.8 + right * uv.x - up * uv.y)
    var t = 0.0
    var hit = false
    var i = 0
    while i < 128 && !hit && t < 12.0 {
        let d = field.distance(camera.eye + dir * t)
        if d < 0.0005 {
            hit = true
        } else {
            t += d * 0.8
        }
        i += 1
    }
    let sky = mix(vec3(0.7, 0.78, 0.86), vec3(0.3, 0.38, 0.5), clamp(0.5 - 0.5 * dir.y, 0.0, 1.0))
    if !hit {
        return vec4(sky, 1.0)
    }
    let n = normalize(field.gradient(camera.eye + dir * t))
    let diffuse = max(dot(n, normalize(vec3(0.5, 0.8, 0.4))), 0.0)
    vec4(vec3(0.55, 0.43, 0.32) * (0.2 + 0.8 * diffuse), 1.0)
}

/// Grazer 1, turning slowly.
pub fn frame(state: mut Results, time: f32, width: u32, height: u32) {
    let a = 0.3 * time + 1.0
    let camera = Camera {
        resolution: vec2(f32(width), f32(height)),
        eye: vec3(4.0 * sin(a), 1.6, 0.6 + 4.0 * cos(a)),
    }
    begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(cover, shade.bind(camera: camera, field: grazer(1)), vertices: 3)
    present()
}

// ---- the tests' exports -----------------------------------------------------------------------
/// One of the spike's parameters (its `Grazer` uniform, flattened) for an individual.
pub fn param(seed: u32, i: u32) -> f32 {
    params(seed)[i]
}

// ---- evaluation at scattered points (AC2) -----------------------------------------------------
struct Scatter: Copy + GpuData {
    lo: vec3,
    size: vec3,
    seed: u32,
}

/// A float in [0, 1) from a hash's top 24 bits.
fn unit(h: u32) -> f32 {
    f32(h >> 8) * (1.0 / 16777216.0)
}

/// Uniform points in a box.
@compute(64)
fn scatter(s: Scatter, out: mut Slots<vec4>, id: GlobalId) {
    let h0 = hash_u32(id.x ^ s.seed)
    let h1 = hash_u32(h0)
    let h2 = hash_u32(h1)
    out[id] = vec4(s.lo + vec3(unit(h0), unit(h1), unit(h2)) * s.size, 0.0)
}

@compute(64)
fn distances<F: Surface>(field: F, points: [vec4], out: mut Slots<f32>, id: GlobalId) {
    out[id] = field.distance(points[id.x].xyz)
}

@compute(64)
fn samples<F: Surface>(field: F, points: [vec4], out: mut Slots<vec4>, id: GlobalId) {
    let s = field.sample(points[id.x].xyz)
    out[id] = vec4(s.0, s.1)
}

fn v(p: P3) -> vec3 {
    vec3(f32(p.x), f32(p.y), f32(p.z))
}

/// Scatters `n` points (a multiple of 64) over the individual's bounds into a new buffer.
fn scattered(seed: u32, n: u32, a: [f32; PARAM_FLOATS]) -> GpuBuffer<vec4> {
    let b = bounds(a)
    var points: GpuBuffer<vec4> = buffer(n)
    let lo = v(b.lo)
    dispatch(
        scatter.bind(s: Scatter { lo, size: v(b.hi) - lo, seed }, out: mut points),
        groups: n / 64,
    )
    points
}

/// Scatters `n` points over the individual's bounds into three new buffers, kept in the state:
/// the points, the distance at each, and the distance and gradient at each.
pub fn evaluate(state: mut Results, seed: u32, n: u32) {
    let a = params(seed)
    let g = grazer_from(a)
    state.points = scattered(seed, n, a)
    state.dist = buffer(n)
    state.samp = buffer(n)
    dispatch(distances.bind(field: g, points: state.points, out: mut state.dist), groups: n / 64)
    dispatch(samples.bind(field: g, points: state.points, out: mut state.samp), groups: n / 64)
}

// ---- block culling on the spike's grid (AC3) -------------------------------------------------
/// Spike 01's extraction grid: blocks of 4×4×4 cells over the individual's padded bounds.
struct Grid: Copy + GpuData {
    origin: vec3,
    cell: f32,
    dx: u32,
    dy: u32,
    dz: u32,
    blocks: u32,
}

/// The spike's `gridFor`, in f64 as in JavaScript.
fn grid_for(a: [f32; PARAM_FLOATS], cell: f64) -> Grid {
    let b = bounds(a)
    let pad = 2.0 * cell
    let o = p3(b.lo.x - pad, b.lo.y - pad, b.lo.z - pad)
    let dx = u32(ceil((b.hi.x + pad - o.x) / (4.0 * cell)))
    let dy = u32(ceil((b.hi.y + pad - o.y) / (4.0 * cell)))
    let dz = u32(ceil((b.hi.z + pad - o.z) / (4.0 * cell)))
    Grid { origin: v(o), cell: f32(cell), dx, dy, dz, blocks: dx * dy * dz }
}

/// A block's centre, and the half-size of the block grown by one cell.
fn block(grid: Grid, b: u32) -> (vec3, f32) {
    let size = grid.cell * 4.0
    let c = vec3(f32(b % grid.dx), f32((b / grid.dx) % grid.dy), f32(b / (grid.dx * grid.dy)))
    (grid.origin + (c + 0.5) * size, 0.5 * size + grid.cell)
}

/// Keeps a block when the derived interval over it holds zero.
@compute(64)
fn cull_interval<F: Surface>(field: F, grid: Grid, live: mut Slots<u32>, id: GlobalId) {
    if id.x < grid.blocks {
        let b = block(grid, id.x)
        let r = field.interval(Box3 { lo: b.0 - b.1, hi: b.0 + b.1 })
        live[id] = if r.lo > 0.0 || r.hi < 0.0 { 0 } else { 1 }
    }
}

/// The spike's hand-written rule (extract.wgsl, `cull_blocks`): each part's distance at the
/// block's centre plus its Lipschitz constant times the grown block's radius, folded with
/// smin's interval rule.
fn lipschitz_live(g: Grazer, center: vec3, r: f32) -> bool {
    let k = g.k
    let amp = g.torso.amp * 1.875
    var lo = [0.0; 20]
    var hi = [0.0; 20]
    var min_hi = 1000000.0
    for i in 0..20 {
        var d = 0.0
        var spread = r
        if i == 0 {
            d = g.torso.inner.distance(center)
            spread = 1.25 * r + amp
        } else if i == 1 {
            d = g.neck.distance(center)
        } else if i == 2 {
            d = g.head.distance(center)
            spread = 1.25 * r
        } else if i == 3 {
            d = g.tail.distance(center)
        } else if i < 16 {
            d = g.legs[i - 4].distance(center)
        } else {
            d = g.hooves[i - 16].distance(center)
        }
        lo[i] = d - spread
        hi[i] = d + spread
        min_hi = min(min_hi, hi[i])
    }
    var rlo = 1000000.0
    var rhi = 1000000.0
    for i in 0..20 {
        if lo[i] < min_hi + k {
            let apart = lo[i] >= rhi + k || rlo >= hi[i] + k
            rlo = min(rlo, lo[i]) - if apart { 0.0 } else { 0.25 * k }
            rhi = min(rhi, hi[i])
        }
    }
    !(rlo > 0.0 || rhi < 0.0)
}

@compute(64)
fn cull_lipschitz(field: Grazer, grid: Grid, live: mut Slots<u32>, id: GlobalId) {
    if id.x < grid.blocks {
        let b = block(grid, id.x)
        let r = length(vec3(b.1))
        live[id] = if lipschitz_live(field, b.0, r) { 1 } else { 0 }
    }
}

/// Culls the individual's blocks at `cell` metres into a new buffer, kept in the state, by the
/// derived interval (`lipschitz` 0) or the spike's rule (1). Returns the number of blocks.
pub fn cull(state: mut Results, seed: u32, cell: f32, lipschitz: u32) -> u32 {
    let a = params(seed)
    let g = grazer_from(a)
    let grid = grid_for(a, f64(cell))
    state.live = buffer(grid.blocks)
    let groups = (grid.blocks + 63) / 64
    if lipschitz == 0 {
        dispatch(cull_interval.bind(field: g, grid: grid, live: mut state.live), groups: groups)
    } else {
        dispatch(cull_lipschitz.bind(field: g, grid: grid, live: mut state.live), groups: groups)
    }
    grid.blocks
}

// ---- AC3: the corpus ---------------------------------------------------------------------------
/// A float in [0, 1) for box `i`, draw `k`.
fn rnd(seed: u32, i: u32, k: u32) -> f32 {
    unit(hash_u32(hash_u32(i.wrapping_mul(16).wrapping_add(k)) ^ seed))
}

/// Box `i`: a centre in [-2, 2]³ and half-sizes from 10⁻⁴ to 2, log-uniform, each axis
/// collapsed to a point one time in eight.
fn random_box(seed: u32, i: u32) -> Box3 {
    let c = vec3(rnd(seed, i, 0), rnd(seed, i, 1), rnd(seed, i, 2)) * 4.0 - 2.0
    let e = vec3(rnd(seed, i, 3), rnd(seed, i, 4), rnd(seed, i, 5)) * 4.3 - 4.0
    var h = vec3(pow(10.0, e.x), pow(10.0, e.y), pow(10.0, e.z))
    if rnd(seed, i, 6) < 0.125 {
        h.x = 0.0
    }
    if rnd(seed, i, 7) < 0.125 {
        h.y = 0.0
    }
    if rnd(seed, i, 8) < 0.125 {
        h.z = 0.0
    }
    Box3 { lo: c - h, hi: c + h }
}

/// How many of 16 points of box `i` (its corners and 8 inside) fall outside the derived
/// interval.
fn misses<F: Surface>(f: F, b: Box3, seed: u32, i: u32) -> u32 {
    let r = f.interval(b)
    var miss = 0
    for k in 0..16 {
        var p = vec3(
            if (k & 1) == 0 { b.lo.x } else { b.hi.x },
            if (k & 2) == 0 { b.lo.y } else { b.hi.y },
            if (k & 4) == 0 { b.lo.z } else { b.hi.z },
        )
        if k >= 8 {
            let u = vec3(
                rnd(seed, i, 9 + 3 * k),
                rnd(seed, i, 10 + 3 * k),
                rnd(seed, i, 11 + 3 * k),
            )
            p = clamp(b.lo + (b.hi - b.lo) * u, b.lo, b.hi)
        }
        let d = f.distance(p)
        if !(r.lo <= d && d <= r.hi) {
            miss += 1
        }
    }
    miss
}

/// Whether the interval over a single point fails to hold the point's value strictly inside:
/// both ends must be widened past it.
fn unwidened<F: Surface>(f: F, b: Box3) -> u32 {
    let r = f.interval(Box3 { lo: b.lo, hi: b.lo })
    let d = f.distance(b.lo)
    if r.lo < d && d < r.hi { 0 } else { 1 }
}

/// Something done with one function of the corpus, whatever the function's type.
trait Visit {
    type Out

    fn visit<F: Surface>(self, f: F) -> Self::Out
}

/// `v` done with corpus function `fi`. The order is the tests' (derive.rs, `NAMES`).
fn with_function<V: Visit>(fi: u32, v: V) -> V::Out {
    match fi {
        0 => v.visit(sphere_()),
        1 => v.visit(ellipsoid_()),
        2 => v.visit(cone_()),
        3 => v.visit(hoof_()),
        4 => v.visit(blob_()),
        5 => v.visit(Noise { freq: 2.5 }),
        6 => v.visit(fbm_()),
        7 => v.visit(creature()),
        8 => v.visit(grazer_()),
        9 => v.visit(Waves { s: 3.0 }),
        10 => v.visit(Logs { s: 2.3 }),
        11 => v.visit(Trig { s: 0.35 }),
        12 => v.visit(Rational { s: 0.2 }),
        13 => v.visit(Pieces { s: 2.0 }),
        14 => v.visit(Vectors { c: vec3(0.3, 0.3, 0.3) }),
        15 => v.visit(Branchy { n: 3 }),
        16 => v.visit(Cells { s: 3.0 }),
        17 => v.visit(sphere_tape()),
        18 => v.visit(waves_tape(3.0)),
        19 => v.visit(blob_tape()),
        20 => v.visit(closures_(5.0)),
        21 => v.visit(table_()),
        22 => v.visit(Hyperbolic { s: 1.7 }),
        _ => v.visit(Powers { n: 2.4 }),
    }
}

/// `misses` in box `i`.
struct Misses: Copy {
    b: Box3,
    seed: u32,
    i: u32,
}

impl Visit for Misses {
    type Out = u32

    fn visit<F: Surface>(self, f: F) -> u32 {
        misses(f, self.b, self.seed, self.i)
    }
}

/// `unwidened` at a box's low corner.
struct Unwidened: Copy {
    b: Box3,
}

impl Visit for Unwidened {
    type Out = u32

    fn visit<F: Surface>(self, f: F) -> u32 {
        unwidened(f, self.b)
    }
}

/// On the CPU: over random boxes `first..first + count`, how many sampled values function
/// `fi`'s interval misses.
pub fn misses_cpu(fi: u32, seed: u32, first: u32, count: u32) -> u32 {
    var total = 0
    for i in first..first + count {
        // Bound first, with its type: `+=` doesn't yet see that `Misses::Out` is `u32` (E0305).
        let missed: u32 = with_function(fi, Misses { b: random_box(seed, i), seed, i })
        total += missed
    }
    total
}

/// On the CPU: over `n` random points, how many intervals over a single point don't hold its
/// value strictly inside.
pub fn unwidened_cpu(fi: u32, seed: u32, n: u32) -> u32 {
    var total = 0
    for i in 0..n {
        let failed: u32 = with_function(fi, Unwidened { b: random_box(seed, i) })
        total += failed
    }
    total
}

struct Boxes: Copy + GpuData {
    seed: u32,
    count: u32,
}

@compute(64)
fn misses_gpu<F: Surface>(f: F, boxes: Boxes, out: mut Slots<u32>, id: GlobalId) {
    if id.x < boxes.count {
        let b = random_box(boxes.seed, id.x)
        out[id] = misses(f, b, boxes.seed, id.x) + 256 * unwidened(f, b)
    }
}

/// A dispatch of `misses_gpu`, into a new buffer.
struct CheckGpu: Copy {
    boxes: Boxes,
    groups: u32,
}

impl Visit for CheckGpu {
    type Out = GpuBuffer<u32>

    fn visit<F: Surface>(self, f: F) -> GpuBuffer<u32> {
        var out: GpuBuffer<u32> = buffer(self.boxes.count)
        dispatch(misses_gpu.bind(f: f, boxes: self.boxes, out: mut out), groups: self.groups)
        out
    }
}

/// On the GPU: for each of `count` random boxes, into a new buffer kept in the state, how many
/// sampled values function `fi`'s interval misses, plus 256 if the interval over the box's low
/// corner doesn't hold that point's value strictly inside.
pub fn check_gpu(state: mut Results, fi: u32, seed: u32, count: u32) {
    state.out = with_function(
        fi,
        CheckGpu { boxes: Boxes { seed, count }, groups: (count + 63) / 64 },
    )
}

/// A function's value at a point.
struct Distance: Copy {
    p: vec3,
}

impl Visit for Distance {
    type Out = f32

    fn visit<F: Surface>(self, f: F) -> f32 {
        f.distance(self.p)
    }
}

/// A function's derived gradient at a point.
struct Gradient: Copy {
    p: vec3,
}

impl Visit for Gradient {
    type Out = vec3

    fn visit<F: Surface>(self, f: F) -> vec3 {
        f.gradient(self.p)
    }
}

/// Function `fi` at a point, on the CPU.
pub fn value(fi: u32, x: f32, y: f32, z: f32) -> f32 {
    with_function(fi, Distance { p: vec3(x, y, z) })
}

/// Function `fi`'s derived gradient at a point, on the CPU.
pub fn gradient(fi: u32, x: f32, y: f32, z: f32) -> vec3 {
    with_function(fi, Gradient { p: vec3(x, y, z) })
}

// ---- fields built at runtime against their compiled twins (std::stage) ------------------------
/// Twin `k`'s two fields: a tape and the compiled field it was built to match.
fn twin<V: Visit>(k: u32, tape: bool, v: V) -> V::Out {
    match (k, tape) {
        (0, false) => v.visit(sphere_()),
        (0, true) => v.visit(sphere_tape()),
        (1, false) => v.visit(Waves { s: 3.0 }),
        (1, true) => v.visit(waves_tape(3.0)),
        (_, false) => v.visit(blob_spheres()),
        (_, true) => v.visit(blob_tape()),
    }
}

/// A point in [-2, 2]³, the `i`th for `seed`.
fn sample_point(seed: u32, i: u32) -> vec3 {
    let h0 = hash_u32(i ^ seed)
    let h1 = hash_u32(h0)
    let h2 = hash_u32(h1)
    vec3(unit(h0), unit(h1), unit(h2)) * 4.0 - vec3(2.0)
}

/// On the CPU: the largest difference between twin `k`'s tape and its compiled field over
/// `n` sampled points.
pub fn tape_error_cpu(k: u32, seed: u32, n: u32) -> f32 {
    var worst = 0.0
    for i in 0..n {
        let p = sample_point(seed, i)
        let a: f32 = twin(k, tape: true, v: Distance { p })
        let b: f32 = twin(k, tape: false, v: Distance { p })
        worst = max(worst, abs(a - b))
    }
    worst
}

@compute(64)
fn twin_values<F: Surface>(f: F, n: u32, seed: u32, out: mut Slots<f32>, id: GlobalId) {
    if id.x < n {
        out[id] = f.distance(sample_point(seed, id.x))
    }
}

/// A dispatch of `twin_values` into a buffer.
struct TwinGpu: Copy {
    n: u32,
    seed: u32,
}

impl Visit for TwinGpu {
    type Out = GpuBuffer<f32>

    fn visit<F: Surface>(self, f: F) -> GpuBuffer<f32> {
        var out: GpuBuffer<f32> = buffer(self.n)
        dispatch(
            twin_values.bind(f: f, n: self.n, seed: self.seed, out: mut out),
            groups: (self.n + 63) / 64,
        )
        out
    }
}

/// On the GPU: twin `k`'s tape's values at `n` sampled points, into the state's `dist`, and
/// its compiled field's, into `out` (as `f32` bits).
pub fn tape_values_gpu(state: mut Results, k: u32, seed: u32, n: u32) {
    state.dist = twin(k, tape: true, v: TwinGpu { n, seed })
    let compiled: GpuBuffer<f32> = twin(k, tape: false, v: TwinGpu { n, seed })
    state.dist2 = take compiled
}

/// Pruning the blob's tape to box `b`: how long the pruned tape is, and at how many of `n`
/// points in the box its value differs from the whole tape's (as `len * 65536 + differences`).
/// Box 0 is beside the first and third spheres, far from the second; box 1 is inside the third.
pub fn prune_blob(b: u32, n: u32) -> u32 {
    let t = blob_tape()
    let over = if b == 0 {
        Box3 { lo: vec3(-0.75, 0.55, -0.05), hi: vec3(-0.55, 0.75, 0.15) }
    } else {
        Box3 { lo: vec3(-0.35, 0.35, 0.15), hi: vec3(-0.25, 0.45, 0.25) }
    }
    let pruned = t.prune(over)
    var differ = 0
    for i in 0..n {
        let p = over.lo + (over.hi - over.lo) * (sample_point(7, i) + vec3(2.0)) * 0.25
        if pruned.distance(p) != t.distance(p) {
            differ += 1
        }
    }
    pruned.len() * 65536 + differ
}

/// The blob tape's length.
pub fn blob_tape_len() -> u32 {
    blob_tape().len()
}

// ---- Lipschitz bounds (AC5) --------------------------------------------------------------------
/// What can be done with any of the corpus's surfaces that bound their gradient.
trait VisitLipschitz {
    type Out

    fn visit<F: Lipschitz>(self, f: F) -> Self::Out
}

/// The corpus's `Lipschitz` surfaces: 0 sphere, 1 ellipsoid, 2 round cone, 3 hoof, 4 blob,
/// 5 fbm, 6 creature, 7 grazer, 8 oval, 9 tube.
fn with_lipschitz<V: VisitLipschitz>(i: u32, v: V) -> V::Out {
    match i {
        0 => v.visit(sphere_()),
        1 => v.visit(ellipsoid_()),
        2 => v.visit(cone_()),
        3 => v.visit(hoof_()),
        4 => v.visit(blob_()),
        5 => v.visit(fbm_()),
        6 => v.visit(creature()),
        7 => v.visit(grazer_()),
        8 => v.visit(oval_()),
        _ => v.visit(tube_()),
    }
}

struct Bound: Copy {
    near: f32,
}

impl VisitLipschitz for Bound {
    type Out = f32

    fn visit<F: Lipschitz>(self, f: F) -> f32 {
        f.lipschitz(self.near)
    }
}

/// Surface `i`'s stated bound for `|distance| < near`.
pub fn lipschitz_of(i: u32, near: f32) -> f32 {
    with_lipschitz(i, Bound { near })
}

/// Over `n` points in [-2, 2]³, the largest |gradient| / bound where |distance| < near (at most
/// 1 if the bound holds), and how many points were in scope (as `ratio * 1e6 + in scope`: the
/// ratio to 4 decimals, the count below 10⁶).
struct Ratio: Copy {
    near: f32,
    seed: u32,
    n: u32,
    // The points are in [-2, 2]³ times this.
    scale: f32,
}

impl VisitLipschitz for Ratio {
    type Out = vec2

    fn visit<F: Lipschitz>(self, f: F) -> vec2 {
        let l = f.lipschitz(self.near)
        var worst = 0.0
        var count = 0.0
        for i in 0..self.n {
            let p = sample_point(self.seed, i) * self.scale
            let s = f.sample(p)
            if abs(s.0) < self.near {
                worst = max(worst, length(s.1) / l)
                count += 1.0
            }
        }
        vec2(worst, count)
    }
}

pub fn gradient_ratio(i: u32, near: f32, seed: u32, n: u32, scale: f32) -> vec2 {
    with_lipschitz(i, Ratio { near, seed, n, scale })
}

/// Panics if the derived gradient proves surface `i`'s bound wrong (std's debug-build check).
struct Check: Copy {
    near: f32,
}

impl VisitLipschitz for Check {
    type Out = u32

    fn visit<F: Lipschitz>(self, f: F) -> u32 {
        check_lipschitz(f, self.near, f.lipschitz(self.near))
        0
    }
}

pub fn check_bound(i: u32, near: f32) -> u32 {
    with_lipschitz(i, Check { near })
}

/// Sphere tracing's safety: over `n` points, how many have a point of the other sign within the
/// ball `to_bound(near)` says is clear, of 16 points tried in each ball (and how many balls were
/// tried, as `violations * 65536 + balls`).
struct Steps: Copy {
    near: f32,
    seed: u32,
    n: u32,
}

impl VisitLipschitz for Steps {
    type Out = u32

    fn visit<F: Lipschitz>(self, f: F) -> u32 {
        let b = f.to_bound(self.near)
        var bad = 0
        var balls = 0
        for i in 0..self.n {
            let p = sample_point(self.seed, i) * 0.6
            let r = b.distance(p)
            if r != 0.0 && abs(r) < 1.0e30 {
                balls += 1
                let inside = f.distance(p) < 0.0
                for k in 0..16 {
                    let dir = sample_point(self.seed ^ 0x5bd1e995, i * 16 + k) * 0.5
                    let q = p +
                        dir *
                            (abs(r) * 0.999 / max(length(dir), 0.000001)) *
                            unit(hash_u32(i * 16 + k))
                    if (f.distance(q) < 0.0) != inside && f.distance(q) != 0.0 {
                        bad += 1
                    }
                }
            }
        }
        bad * 65536 + balls
    }
}

pub fn step_violations(i: u32, near: f32, seed: u32, n: u32) -> u32 {
    with_lipschitz(i, Steps { near, seed, n })
}

// ---- the interval of a vector (AC12) -----------------------------------------------------------
/// 1 where the box of the creature's gradient over box `i` equals its three components'
/// intervals, each from a derived function of its own.
@compute(64)
fn vector_intervals(boxes: Boxes, out: mut Slots<u32>, id: GlobalId) {
    if id.x < boxes.count {
        let b = random_box(boxes.seed, id.x)
        let f = creature()
        let all = interval(|q: vec3| f.gradient(q), b)
        let x = interval(|q: vec3| f.gradient(q).x, b)
        let y = interval(|q: vec3| f.gradient(q).y, b)
        let z = interval(|q: vec3| f.gradient(q).z, b)
        let same = all.lo.x == x.lo &&
            all.lo.y == y.lo &&
            all.lo.z == z.lo &&
            all.hi.x == x.hi &&
            all.hi.y == y.hi &&
            all.hi.z == z.hi
        out[id] = if same { 1 } else { 0 }
    }
}

/// `vector_intervals` over `count` boxes, into the state's `out`.
pub fn check_vector_intervals(state: mut Results, seed: u32, count: u32) {
    var out: GpuBuffer<u32> = buffer(count)
    dispatch(
        vector_intervals.bind(boxes: Boxes { seed, count }, out: mut out),
        groups: (count + 63) / 64,
    )
    state.out = take out
}
