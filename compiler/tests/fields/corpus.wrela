// AC3's test corpus: functions over 3D space whose gradients and intervals the compiler
// derives. The fields are std's primitives and combinators, hello-field's creature and the
// grazer; the rest exercise every operation the interval and gradient rules cover, including
// branches on the input, early returns, loops and integer arithmetic. Each is a `Surface`, so
// `gradient` and `interval` come from the trait's defaults.
use grazer::{Grazer, grazer}
use std::field::{
    Lipschitz, Surface, ellipsoid, fbm, half_space, hash_u32, oval, round_cone, sphere, tube,
    value_noise,
}
use std::stage::Tape

/// The creature from examples/hello-field (shape.wrela), mid-breath.
pub fn creature() -> Lipschitz {
    let body = ellipsoid(vec3(0.62, 0.435, 0.42))
    let neck = round_cone(vec3(0.35, 0.15, 0.0), vec3(0.75, 0.62, 0.0), r_top: 0.16, r_bottom: 0.1)
    let head = sphere(radius: 0.2).translate(vec3(0.82, 0.72, 0.0))
    body
        .smooth_union(neck, k: 0.12)
        .smooth_union(head, k: 0.08)
        .displace(fbm(freq: 6.0, octaves: 3, offset: vec3(3.0, 1.0, 7.0)), amp: 0.015)
}

/// Value noise at a frequency.
pub struct Noise: Copy + GpuData {
    pub freq: f32,
}

impl Surface for Noise {
    fn distance(self, p: vec3) -> f32 {
        value_noise(p * self.freq)
    }
}

/// sin, cos, exp, sqrt.
pub struct Waves: Copy + GpuData {
    pub s: f32,
}

impl Surface for Waves {
    fn distance(self, p: vec3) -> f32 {
        sin(self.s * p.x) * cos(2.0 * p.y) + exp(0.3 * p.z) - sqrt(p.x * p.x + 1.0)
    }
}

/// log, log2, pow, exp2, inverseSqrt.
pub struct Logs: Copy + GpuData {
    pub s: f32,
}

impl Surface for Logs {
    fn distance(self, p: vec3) -> f32 {
        log(1.0 + p.x * p.x) +
            log2(2.0 + sin(p.y)) * pow(1.5 + 0.5 * cos(p.z), self.s) +
            exp2(0.5 * p.y) -
            inverse_sqrt(1.0 + p.z * p.z)
    }
}

/// tan, atan, atan2, asin, acos.
pub struct Trig: Copy + GpuData {
    pub s: f32,
}

impl Surface for Trig {
    fn distance(self, p: vec3) -> f32 {
        tan(self.s * p.x) +
            atan(p.y) +
            0.3 * atan2(p.y, p.x + 3.0) +
            asin(clamp(0.4 * p.z, -1.0, 1.0)) +
            acos(0.5 * sin(p.x))
    }
}

/// Division, products of the input with itself, remainders.
pub struct Rational: Copy + GpuData {
    pub s: f32,
}

impl Surface for Rational {
    fn distance(self, p: vec3) -> f32 {
        (p.x * p.y - p.z) / (1.0 + p.x * p.x + p.y * p.y) +
            self.s * p.x * p.y * p.z +
            0.1 * ((p.x + 5.0) % 0.7)
    }
}

/// The piecewise built-ins: smoothstep, mix with a varying weight, clamp, step, abs, floor,
/// fract, sign, min, max.
pub struct Pieces: Copy + GpuData {
    pub s: f32,
}

impl Surface for Pieces {
    fn distance(self, p: vec3) -> f32 {
        smoothstep(-1.0, 1.0, p.x) * mix(p.y, p.z, smoothstep(0.0, 1.0, p.x * p.x)) +
            clamp(p.z, -0.5, 0.5) +
            0.2 * step(0.3, p.y) +
            abs(p.x - p.y) +
            0.1 * floor(2.0 * p.z) +
            0.1 * fract(self.s * p.x) +
            0.05 * sign(p.x) +
            min(p.x, p.z) -
            max(p.y, 0.5 * p.z) +
            saturate(p.y)
    }
}

/// The vector built-ins: length, dot, normalize, cross, distance, swizzles, mix of vectors.
pub struct Vectors: Copy + GpuData {
    pub c: vec3,
}

impl Surface for Vectors {
    fn distance(self, p: vec3) -> f32 {
        let n = normalize(p + vec3(3.0, 0.5, 0.0))
        length(p - self.c) +
            dot(n, vec3(1.0, 2.0, 3.0)) +
            cross(p, vec3(0.2, 1.0, 0.4)).x +
            0.5 * distance(p, vec3(1.0, 1.0, 1.0)) +
            dot(p.zxy, mix(p, p.yzx, vec3(0.25)))
    }
}

/// Branches on the input, an early return, and a loop of fixed length.
pub struct Branchy: Copy + GpuData {
    pub n: u32,
}

impl Surface for Branchy {
    fn distance(self, p: vec3) -> f32 {
        if p.z > 1.0 {
            return 2.0 * p.z - p.x
        }
        var s = if p.x > p.y { p.x * p.x - p.z } else { sin(p.y) + p.z }
        for i in 0..self.n {
            if s < 0.0 {
                s = s + 0.25 * f32(i) * p.x
            } else {
                s = 0.5 * s - p.y
            }
        }
        s
    }
}

/// Integer arithmetic on the input: lattice cells and hashes, as value noise does.
pub struct Cells: Copy + GpuData {
    pub s: f32,
}

impl Surface for Cells {
    fn distance(self, p: vec3) -> f32 {
        let i = i32(floor(self.s * p.x))
        let j = i32(floor(self.s * p.y)) * 3 + i
        let h = hash_u32(u32(j + 1000))
        0.1 * f32(h % 7) + 0.05 * f32(i) - p.z + f32(j >> 1) * 0.01
    }
}

/// Table reads at indices that depend on the input, as a loft's radii are read: a radius per
/// band along z and angle around it, interpolated, with a `u32` index and an `i32` one.
pub struct Table: Copy + GpuData {
    pub radii: [f32; 48],
    pub bands: [f32; 6],
}

impl Surface for Table {
    fn distance(self, p: vec3) -> f32 {
        let ts = saturate(p.z * 0.5 + 0.5) * 5.0
        let i0 = min(u32(ts), 4)
        let f = saturate(ts - f32(i0))
        let a = fract(atan2(p.y, p.x) / 6.2831855) * 8.0
        let j0 = min(u32(a), 7)
        let g = saturate(a - f32(j0))
        let j1 = (j0 + 1) % 8
        let near = mix(self.radii[i0 * 8 + j0], self.radii[i0 * 8 + j1], g)
        let far = mix(self.radii[i0 * 8 + 8 + j0], self.radii[i0 * 8 + 8 + j1], g)
        let band = self.bands[clamp(i32(floor(p.z * 3.0)) + 3, 0, 5)]
        length(vec2(p.x, p.y)) - mix(near, far, f) + band
    }
}

/// Powers of ranges that reach 0 (a superellipse's |cos θ|ⁿ): on the CPU, the derived interval's
/// corners never take a power of a base below 0, which is NaN (a debug build traps it, chosen or
/// not); on the GPU, a base at 0 (its log -∞) no longer makes the widening's tolerance ∞, and
/// the interval NaN (it missed a fifth of the samples).
pub struct Powers: Copy + GpuData {
    pub n: f32,
}

impl Surface for Powers {
    fn distance(self, p: vec3) -> f32 {
        let x = pow(abs(sin(3.0 * p.x)), self.n)
        let y = pow(abs(cos(2.0 * p.y)) / 0.9, 1.5)
        length(p) - 0.5 - 0.1 * x - 0.05 * y + 0.02 * log2(1.0 + abs(p.z))
    }
}

pub fn table_() -> Table {
    var radii = [0.0; 48]
    for i in 0..48 {
        radii[i] = 0.4 + 0.15 * sin(f32(i) * 1.7)
    }
    Table { radii, bands: [0.0, 0.05, -0.03, 0.02, 0.0, -0.04] }
}

pub fn sphere_() -> Lipschitz {
    sphere(0.7)
}

pub fn ellipsoid_() -> Lipschitz {
    ellipsoid(vec3(0.5, 0.3, 0.8))
}

/// The ellipsoid's radii as an oval: its distance's gradient stays under 1 inside.
pub fn oval_() -> Lipschitz {
    oval(vec3(0.5, 0.3, 0.8))
}

/// A bent tube that thickens and thins: a leg's shape.
pub fn tube_() -> Lipschitz {
    tube(
        [vec3(0.0, 0.8, 0.0), vec3(0.1, 0.2, 0.15), vec3(-0.1, -0.3, 0.0), vec3(0.0, -0.8, 0.3)],
        [0.25, 0.12, 0.18, 0.06],
    )
}

pub fn cone_() -> Lipschitz {
    round_cone(vec3(0.1, -0.5, 0.0), vec3(-0.2, 0.6, 0.3), r_top: 0.3, r_bottom: 0.1)
}

pub fn hoof_() -> Lipschitz {
    round_cone(vec3(), vec3(y: -0.08), r_top: 0.06, r_bottom: 0.07).intersect(
        half_space(vec3(y: -1.0), 0.07),
    )
}

pub fn blob_() -> Lipschitz {
    sphere(radius: 0.5)
        .smooth_union(round_cone(vec3(), vec3(y: 1.0), r_top: 0.3, r_bottom: 0.1), k: 0.1)
        .smooth_union(ellipsoid(vec3(0.3, 0.2, 0.4)).translate(vec3(0.4, 0.1, 0.0)), k: 0.05)
}

pub fn fbm_() -> Lipschitz {
    sphere(0.6).displace(fbm(freq: 3.0, octaves: 4), amp: 0.2)
}

pub fn grazer_() -> Grazer {
    grazer(1)
}

// ---- fields built at runtime (std::stage), each with its compiled twin ------------------------
/// `sphere_()`, as a tape.
pub fn sphere_tape() -> Tape {
    var t = Tape::new()
    let _ = t.sphere(vec3(), 0.7)
    t
}

/// `Waves { s }`, as a tape.
pub fn waves_tape(s: f32) -> Tape {
    var t = Tape::new()
    let x = t.x()
    let y = t.y()
    let z = t.z()
    // sin(s x) cos(2 y) + exp(0.3 z) - sqrt(x x + 1), in the compiled field's order.
    let s_ = t.constant(s)
    let sx = t.mul(s_, x)
    let sin_sx = t.sin(sx)
    let two = t.constant(2.0)
    let two_y = t.mul(two, y)
    let cos_2y = t.cos(two_y)
    let a = t.mul(sin_sx, cos_2y)
    let k = t.constant(0.3)
    let kz = t.mul(k, z)
    let e = t.exp(kz)
    let b = t.add(a, e)
    let xx = t.mul(x, x)
    let one = t.constant(1.0)
    let xx1 = t.add(xx, one)
    let r = t.sqrt(xx1)
    let _ = t.sub(b, r)
    t
}

/// Three spheres joined with smooth unions: an edit log, as a sculpting tool keeps one.
/// A field written as closures: the outer one captures the two inner ones (§6.7), and a closure
/// of a point is a `Surface`.
pub fn closures_(s: f32) -> Surface {
    let ball = |p: vec3| length(p) - 0.6
    let ripple = |p: vec3| sin(p.x * s) * 0.05
    |p: vec3| ball(p) + ripple(p)
}

pub fn blob_spheres() -> Surface {
    sphere(0.5)
        .smooth_union(sphere(0.3).translate(vec3(0.4, 0.1, 0.0)), k: 0.1)
        .smooth_union(sphere(0.25).translate(vec3(-0.3, 0.4, 0.2)), k: 0.05)
}

/// `blob_spheres()`, as a tape built from the edits.
pub fn blob_tape() -> Tape {
    let centers = [vec3(), vec3(0.4, 0.1, 0.0), vec3(-0.3, 0.4, 0.2)]
    let radii = [0.5, 0.3, 0.25]
    let ks = [0.0, 0.1, 0.05]
    var t = Tape::new()
    var d = t.sphere(centers[0], radii[0])
    for i in 1..3 {
        let s = t.sphere(centers[i], radii[i])
        d = t.smooth_min(d, s, ks[i])
    }
    t
}
