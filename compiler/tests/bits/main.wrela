// Bit counts (`count_ones`, `leading_zeros`, `trailing_zeros`) on the CPU and the GPU
// (compiler/tests/tests/suite/numerics.rs). The first frame counts the bits of `INPUTS` inputs
// on the GPU into the program's newest buffer: a `Counts` for each.

use std::gpu::{GlobalId, GpuBuffer, Slots, buffer, dispatch, write}

pub const INPUTS: u32 = 256

/// Input `i`: 0, 1, the top bit, every bit, then xorshift's values.
pub fn input(i: u32) -> u32 {
    if i < 4 {
        return [0, 1, 2147483648, 4294967295][i]
    }
    var x: u32 = 2463534242 ^ i
    for _ in 0..3 {
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
    }
    x >> (i % 29)
}

pub fn ones_u32(x: u32) -> u32 {
    x.count_ones()
}

pub fn leading_u32(x: u32) -> u32 {
    x.leading_zeros()
}

pub fn trailing_u32(x: u32) -> u32 {
    x.trailing_zeros()
}

pub fn ones_i32(x: i32) -> u32 {
    x.count_ones()
}

pub fn leading_i32(x: i32) -> u32 {
    x.leading_zeros()
}

pub fn trailing_i32(x: i32) -> u32 {
    x.trailing_zeros()
}

pub fn ones_u64(x: u64) -> u32 {
    x.count_ones()
}

pub fn leading_u64(x: u64) -> u32 {
    x.leading_zeros()
}

pub fn trailing_i64(x: i64) -> u32 {
    x.trailing_zeros()
}

/// An input's counts as a `u32`, then as an `i32`: 24 bytes.
struct Counts: Copy + GpuData {
    ones: u32,
    leading: u32,
    trailing: u32,
    ones_i: u32,
    leading_i: u32,
    trailing_i: u32,
}

@compute(64)
fn counts(inputs: [u32], out: mut Slots<Counts>, id: GlobalId) {
    let x = inputs[id.x]
    let y = bitcast_i32(bitcast_f32(x))
    out[id] = Counts {
        ones: x.count_ones(),
        leading: x.leading_zeros(),
        trailing: x.trailing_zeros(),
        ones_i: y.count_ones(),
        leading_i: y.leading_zeros(),
        trailing_i: y.trailing_zeros(),
    }
}

pub struct Game {
    inputs: GpuBuffer<u32>,
    out: GpuBuffer<Counts>,
    done: bool,
}

pub fn init() -> Game {
    Game { inputs: buffer(INPUTS), out: buffer(INPUTS), done: false }
}

pub fn frame(game: mut Game, time: f32, width: u32, height: u32) {
    if game.done {
        return
    }
    var xs: Vec<u32> = Vec::new()
    for i in 0..INPUTS {
        xs.push(input(i))
    }
    write(mut game.inputs, 0, xs)
    dispatch(
        counts.bind(inputs: game.inputs.span(0, INPUTS), out: mut game.out),
        groups: INPUTS / 64,
    )
    game.done = true
}
