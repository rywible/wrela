// Reading the data files when the game is built: their lines, and the trimmed columns of a
// line. A panic here, in a constant, fails the build with the call chain (§10).

/// An embedded file's text.
pub fn file_text(b: Bytes, name: Text) -> String {
    var bytes: Vec<u8> = Vec::with_capacity(b.len())
    for i in 0..b.len() {
        bytes.push(b.at(i))
    }
    let Some(s) = String::from_utf8(take bytes) else { panic(f"{name} isn't UTF-8") }
    s
}

/// The file's lines that hold something: neither blank nor a `#` comment. Each line's text,
/// with its number from 1.
pub fn rows(text: str) -> Vec<(u32, String)> {
    var out: Vec<(u32, String)> = Vec::new()
    let lines = text.lines()
    for i in 0..lines.len() {
        let (a, b) = lines[i]
        borrow line = text.slice(a, b)
        borrow t = line.trim()
        if t.len() > 0 && !t.starts_with("#") {
            out.push((i + 1, line.to_string()))
        }
    }
    out
}

/// A line's columns, split at `sep` and trimmed.
pub fn columns(line: str, sep: str) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for r in line.split(sep) {
        out.push(line.slice(r.0, r.1).trim().to_string())
    }
    out
}

/// How deep a line is indented, in spaces.
pub fn indent(line: str) -> u32 {
    var n = 0
    while n < line.len() && line.byte(n) == 32 {
        n += 1
    }
    n
}

/// A line being read: its text, where the next token starts, and where it came from (for
/// errors, which fail the build).
pub struct Words {
    text: String,
    at: u32,
    pub row: u32,
    file: Text,
}

impl Words {
    pub fn new(line: str, row: u32, file: Text) -> Words {
        Words { text: line.to_string(), at: 0, row, file }
    }

    pub fn skip_space(mut self) {
        while self.at < self.text.len() && self.text.byte(self.at) == 32 {
            self.at += 1
        }
    }

    pub fn done(mut self) -> bool {
        self.skip_space()
        self.at >= self.text.len()
    }

    /// The next token: a word of letters, digits, `_` and `.`, or one punctuation character.
    pub fn next(mut self) -> String {
        self.skip_space()
        let start = self.at
        let word = |b: u8| (b >= 97 && b <= 122) ||
            (b >= 65 && b <= 90) ||
            (b >= 48 && b <= 57) ||
            b == 95 ||
            b == 46
        if self.at < self.text.len() && word(self.text.byte(self.at)) {
            while self.at < self.text.len() && word(self.text.byte(self.at)) {
                self.at += 1
            }
        } else if self.at + 1 < self.text.len() &&
            self.text.byte(self.at) == 45 &&
            self.text.byte(self.at + 1) == 62 {
            self.at += 2 // `->`
        } else if self.at < self.text.len() {
            self.at += 1
        }
        self.text.slice(start, self.at).to_string()
    }

    pub fn peek(mut self) -> String {
        let at = self.at
        let w = self.next()
        self.at = at
        w
    }

    /// Takes `word` if it's next.
    pub fn eat(mut self, word: str) -> bool {
        if self.peek() == word {
            let _ = self.next()
            true
        } else {
            false
        }
    }

    pub fn expect(mut self, word: str) {
        if !self.eat(word) {
            self.stop(f"expected `{word}`")
        }
    }

    /// Fails the build: what's wrong, and where. (Where a value is wanted: `fail`.)
    pub fn stop(self, why: str) {
        panic(f"{self.file}, line {self.row}: {why}")
    }

    /// `stop`, where a value of any type is wanted.
    pub fn fail<T>(self, why: str) -> T {
        panic(f"{self.file}, line {self.row}: {why}")
    }

    /// A quoted string.
    pub fn quoted(mut self) -> String {
        self.skip_space()
        if self.at >= self.text.len() || self.text.byte(self.at) != 34 {
            self.stop("expected a quoted string")
        }
        let start = self.at + 1
        var end = start
        while end < self.text.len() && self.text.byte(end) != 34 {
            end += 1
        }
        self.at = end + 1
        self.text.slice(start, end).to_string()
    }

    pub fn count(mut self) -> u32 {
        let w = self.next()
        let Some(n) = w.parse_u32() else { return self.fail(f"`{w}` isn't a count") }
        n
    }

    /// `name(arg[, count])`: the argument, and the count (1 if none).
    pub fn call_args(mut self) -> (String, u32) {
        self.expect("(")
        let name = self.next()
        let n = if self.eat(",") { self.count() } else { 1 }
        self.expect(")")
        (name, n)
    }
}
