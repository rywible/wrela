// Sketch 02, "drawing the grazer" (design-archive-2026-10: docs/design/sketches/
// 02-drawing-the-grazer.md). The sketch is engine code: its look settings are
// engine/look.wrela, its extraction engine/realize.wrela and its drawing engine/render.wrela,
// rebuilt since to #43 §7–§8. This program realizes sketch 01's grazer once, at init,
// and draws it each frame: skinned by a palette that sways its neck, and shaded per pixel by
// its field's channels and gradient (compiler/tests/tests/suite/sketches.rs runs it in both
// hosts).

use engine::creature::Creature
use engine::realize::{Mesh, realize_once}
use engine::render::{ByChannels, Lights, MAX_BONES, Palette, View, shade, skin, unlit_shadow, view}
use engine::rng::seed
use grazer::sketch::{GRAZER_LOOK, grazer}
use std::gpu::{
    ComparisonSampler, Cull, DepthTexture, GpuBuffer, begin_screen_pass_with_depth, buffer,
    comparison_sampler, depth_texture, draw, write,
}

pub struct Scene {
    /// Two grazers, two seeds: one type, so the same pipelines (sketch 02 §5).
    meshes: Vec<Mesh>,
    palettes: GpuBuffer<mat4>,
    depth: DepthTexture,
    shadow: DepthTexture,
    shadow_sampler: ComparisonSampler,
    width: u32,
    height: u32,
}

pub fn init() -> Scene {
    // Realization: when the engine realizes an individual (here, at load), then kept.
    var meshes: Vec<Mesh> = Vec::new()
    for i in 0..2 {
        meshes.push(realize_once(grazer(seed(i + 1)), GRAZER_LOOK))
    }
    // No shadows.
    let shadow = unlit_shadow()
    Scene {
        meshes,
        palettes: buffer(2 * MAX_BONES),
        depth: depth_texture(width: 1, height: 1),
        shadow: take shadow,
        shadow_sampler: comparison_sampler(),
        width: 1,
        height: 1,
    }
}

/// A camera looking at the grazer from its side and a little ahead, `aspect` wide, 45° high.
fn camera(aspect: f32) -> View {
    view(
        eye: vec3(4.6, 2.0, 1.3),
        at: vec3(0.0, 1.1, 0.6),
        fovy: 0.7853982,
        aspect: aspect,
        sun: vec3(0.4, 1.0, 0.3),
        extent: 4.0,
    )
}

const LIGHTS = Lights {
    sun_colour: vec3(1.6, 1.5, 1.35),
    sky: vec3(0.55, 0.65, 0.8),
    ground: vec3(0.3, 0.27, 0.22),
    ambient: 0.6,
    exposure: 0.9,
    f0: 0.04,
    normal_offset: 0.03,
    compare_bias: 0.002,
}

/// The rest pose moved by `at`, with the neck's and head's bones (3 to 7) turned a little
/// about the neck's base: a palette of bone matrices.
fn pose(time: f32, at: vec3) -> Palette {
    var bones = [mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(at, 1.0),
    ); MAX_BONES]
    let a = 0.15 * sin(time * 2.0)
    let (c, s) = (cos(a), sin(a))
    let pivot = vec3(0.0, 1.5, 1.55)
    // Rotation about x through the pivot: translate(pivot) R translate(-pivot).
    let rot = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, c, s, 0.0),
        vec4(0.0, -s, c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    let back = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(-pivot, 1.0),
    )
    let there = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(pivot, 1.0),
    )
    for i in 3..8 {
        bones[i] = bones[0] * there * rot * back
    }
    Palette { bones }
}

pub fn frame(state: mut Scene, time: f32, width: u32, height: u32) {
    if width != state.width || height != state.height {
        state.depth = depth_texture(width, height)
        state.width = width
        state.height = height
    }
    let v = camera(f32(width) / f32(height))
    for i in 0..2 {
        let at = vec3(-2.2 * f32(i), 0.0, -1.5 * f32(i))
        write(mut state.palettes, i * MAX_BONES, pose(time + f32(i), at).bones)
    }
    let pass = begin_screen_pass_with_depth(mut state.depth, clear: vec4(0.55, 0.7, 0.85, 1.0))
    var i = 0
    for mesh in state.meshes {
        // The field's numbers are this individual's; its structure, and so the pipelines, the
        // herd's.
        let field = grazer(seed(i + 1)).field()
        draw(
            skin.bind(
                verts: mesh.verts.items(),
                palettes: state.palettes.span(start: 0, count: 2 * MAX_BONES),
                first: i * MAX_BONES,
                view: v,
            ),
            shade.bind(
                field: field,
                look: ByChannels {},
                view: v,
                lights: LIGHTS,
                shadow: state.shadow,
                shadow_sampler: state.shadow_sampler,
            ),
            indices: mesh.quads.items(),
            indirect: mesh.draw.items(),
            cull: Cull::Back,
        )
        i += 1
    }
    pass.present()
}
