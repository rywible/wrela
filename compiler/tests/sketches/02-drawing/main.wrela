// Sketch 02, "drawing the grazer" (design-archive-2026-10: docs/design/sketches/
// 02-drawing-the-grazer.md). The sketch is engine code: its look settings are
// engine/look.wrela and its extraction and drawing engine/render.wrela, each change from the
// sketch noted there ("Changed:"). This program realizes sketch 01's grazer once, at init,
// and draws it each frame: skinned by a palette that sways its neck, and shaded per pixel by
// its field's channels and gradient (compiler/tests/tests/suite/sketches.rs runs it in both
// hosts).

use engine::creature::Creature
use engine::look::Shading
use engine::render::{Lights, Palette, SkinnedMesh, View, realize_mesh, shade, skin}
use engine::rng::seed
use grazer::sketch::{GRAZER_LOOK, Tissue, grazer}
use std::gpu::{DepthTexture, begin_screen_pass_with_depth, depth_texture, draw}

pub struct Scene {
    /// Two grazers, two seeds: one type, so the same pipelines (sketch 02 §5).
    meshes: Vec<SkinnedMesh>,
    depth: DepthTexture,
    width: u32,
    height: u32,
}

pub fn init() -> Scene {
    // Realization: when the engine realizes an individual (here, at load), then kept.
    var meshes: Vec<SkinnedMesh> = Vec::new()
    for i in 0..2 {
        meshes.push(realize_mesh(grazer(seed(i + 1)), GRAZER_LOOK))
    }
    Scene { meshes, depth: depth_texture(width: 1, height: 1), width: 1, height: 1 }
}

/// A camera looking at the grazer from its side and a little ahead, `aspect` wide.
fn camera(aspect: f32) -> View {
    let eye = vec3(4.6, 2.0, 1.3)
    let at = vec3(0.0, 1.1, 0.6)
    let f = normalize(at - eye)
    let r = normalize(cross(f, vec3(0.0, 1.0, 0.0)))
    let u = cross(r, f)
    let view = mat4(
        vec4(r.x, u.x, -f.x, 0.0),
        vec4(r.y, u.y, -f.y, 0.0),
        vec4(r.z, u.z, -f.z, 0.0),
        vec4(-dot(r, eye), -dot(u, eye), dot(f, eye), 1.0),
    )
    // A perspective projection, 45° high, depth 0 at 0.1 m to 1 at 50 m (WebGPU's range).
    let (near, far) = (0.1, 50.0)
    let t = 1.0 / tan(0.3926991)
    let proj = mat4(
        vec4(t / aspect, 0.0, 0.0, 0.0),
        vec4(0.0, t, 0.0, 0.0),
        vec4(0.0, 0.0, far / (near - far), -1.0),
        vec4(0.0, 0.0, near * far / (near - far), 0.0),
    )
    View { view_proj: proj * view }
}

/// The rest pose moved by `at`, with the neck's and head's bones (3 to 7) turned a little
/// about the neck's base: a palette of bone matrices.
fn pose(time: f32, at: vec3) -> Palette {
    var bones = [mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(at, 1.0),
    ); 32]
    let a = 0.15 * sin(time * 2.0)
    let (c, s) = (cos(a), sin(a))
    let pivot = vec3(0.0, 1.5, 1.55)
    // Rotation about x through the pivot: translate(pivot) R translate(-pivot).
    let rot = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, c, s, 0.0),
        vec4(0.0, -s, c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    let back = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(-pivot, 1.0),
    )
    let there = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(pivot, 1.0),
    )
    for i in 3..8 {
        bones[i] = bones[0] * there * rot * back
    }
    Palette { bones }
}

pub fn frame(state: mut Scene, time: f32, width: u32, height: u32) {
    if width != state.width || height != state.height {
        state.depth = depth_texture(width, height)
        state.width = width
        state.height = height
    }
    let view = camera(f32(width) / f32(height))
    let lights = Lights {
        sun: normalize(vec3(-0.4, -1.0, -0.3)),
        sun_colour: vec3(1.0, 0.95, 0.85),
        sky: vec3(0.25, 0.3, 0.4),
    }
    let pass = begin_screen_pass_with_depth(mut state.depth, clear: vec4(0.55, 0.7, 0.85, 1.0))
    var i = 0
    for mesh in state.meshes {
        // The field's numbers are this individual's; its structure, and so the pipelines, the
        // herd's.
        let field = grazer(seed(i + 1)).field()
        let at = vec3(-2.2 * f32(i), 0.0, -1.5 * f32(i))
        draw(
            skin.bind(
                verts: mesh.verts.items(),
                weights: mesh.weights,
                quads: mesh.quads.items(),
                palette: pose(time + f32(i), at),
                view: view,
            ),
            shade.bind(field: field, shading: Shading::PerPixel, lights: lights),
            indirect: mesh.draw.span(start: 0, count: 4),
        )
        i += 1
    }
    pass.present()
}
