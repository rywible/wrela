// run: `@fieldwise` traits are derived field by field: `Eq` and `Ord` on structs, enums,
// generic types and a type that holds itself
// expect: points_equal() = true
// expect: points_differ() = false
// expect: order(1, 2) = -1
// expect: order(2, 2) = 0
// expect: order(3, 2) = 1
// expect: shapes() = 3
// expect: options() = true
// expect: trees() = true
// expect: texts() = true
// expect: vecs() = true

struct Point: Copy + Eq + Ord {
    x: i32,
    y: i32,
}

pub fn points_equal() -> bool {
    Point { x: 1, y: 2 } == Point { x: 1, y: 2 }
}

pub fn points_differ() -> bool {
    Point { x: 1, y: 2 } == Point { x: 1, y: 3 }
}

pub fn order(a: i32, b: i32) -> i32 {
    let p = Point { x: 0, y: a }
    let q = Point { x: 0, y: b }
    if p < q {
        -1
    } else if p > q {
        1
    } else {
        0
    }
}

enum Shape: Clone + Eq + Ord {
    Dot,
    Circle { r: f32 },
    Box { w: f32, h: f32 },
}

pub fn shapes() -> i32 {
    let (dot, small, big) = (Shape::Dot, Shape::Circle { r: 1.0 }, Shape::Circle { r: 2.0 })
    let b = Shape::Box { w: 1.0, h: 2.0 }
    let b2 = Shape::Box { w: 1.0, h: 2.0 }
    var n = 0
    if dot < small {
        n += 1
    }
    if small < big {
        n += 1
    }
    if b == b2 {
        n += 1
    }
    if b == dot {
        n += 100
    }
    n
}

pub fn options() -> bool {
    let a: Option<i32> = None
    let b = Some(3)
    a < b && b == Some(3) && Some(2) < b
}

enum Tree: Clone + Eq {
    Leaf(i32),
    Node(Box<Tree>, Box<Tree>),
}

pub fn trees() -> bool {
    let a = Tree::Node(Box::new(Tree::Leaf(1)), Box::new(Tree::Leaf(2)))
    let b = a.clone()
    let c = Tree::Node(Box::new(Tree::Leaf(1)), Box::new(Tree::Leaf(3)))
    a == b && a != c
}

pub fn texts() -> bool {
    let a = "apple"
    let b = "banana"
    var s = String::new()
    s.push_str("apple")
    a < b && a == s && s < b && "app" < a
}

pub fn vecs() -> bool {
    var a = Vec::new()
    a.push(1)
    a.push(2)
    var b = a.clone()
    let same = a == b
    b.push(0)
    same && a < b && [1, 2] < [1, 3] && (1, 2) < (2, 0)
}
