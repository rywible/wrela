// run: edges a review found: `value_gradient_with` of a function whose extra result has no
// value (`()`); an interval of `%` over a divisor that may be zero, which holds the NaN there
// (unbounded, as division's is); and a unit's power past an `i8`'s exponents, which the unit
// check leaves alone rather than overflow
// expect: slope(3.0) = 15.0
// expect: rem_unbounded() = true
// expect: rem_bounded() = true
// expect: energy() = 1.0
use std::derive::{Interval, interval, value_gradient_with}
use std::units::J

fn sq(x: f32) -> (f32, ()) {
    (x * x, ())
}

/// x² and its slope, 2x, at x.
pub fn slope(x: f32) -> f32 {
    let (v, g, _) = value_gradient_with(sq, x)
    v + g
}

/// 1 % d for d in [-1, 1]: NaN at 0, so no finite range holds it.
pub fn rem_unbounded() -> bool {
    let r = interval(|d: f32| 1.0 % d, Interval { lo: -1.0, hi: 1.0 })
    r.lo < -1.0e30 && r.hi > 1.0e30
}

/// 1 % d for d in [2, 3]: 1 every time, within the range.
pub fn rem_bounded() -> bool {
    let r = interval(|d: f32| 1.0 % d, Interval { lo: 2.0, hi: 3.0 })
    r.lo <= 1.0 && r.hi >= 1.0 && r.hi < 10.0
}

pub fn energy() -> f32 {
    1J ** 100 + 0.0
}
