// run: `..base` is evaluated once
// expect: base_once() = 10110
// expect: base_fields() = 723

struct P: Copy + Clone {
    x: i32,
    y: i32,
    z: i32,
}

fn make(n: mut [i32; 1]) -> P {
    n[0] += 1
    P { x: n[0], y: n[0] * 10, z: n[0] * 100 }
}

pub fn base_once() -> i32 {
    var n = [0]
    let p = P { x: 7, ..make(mut n) }
    n[0] * 10000 + p.y + p.z
}

pub fn base_fields() -> i32 {
    let a = P { x: 1, y: 2, z: 7 }
    let b = P { x: 3, ..a }
    b.z * 100 + b.y * 10 + b.x
}
