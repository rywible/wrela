// run: swizzles as places: projections of several components, and indexes into them
// expect: bind_assign(10.0) = 23.0
// expect: bind_comp(10.0) = 15.0
// expect: bind_compound(10.0) = 26.0
// expect: index_read(0) = 3.0
// expect: index_read(2) = 1.0
// expect: index_read(3) traps
// expect: index_write(0) = 129.0
// expect: index_compound(1) = 173.0
// expect: index_compound(2) traps
// expect: bind_index_read(0) = 4.0
// expect: bind_index_write(1) = 193.0
// expect: bind_index_mut_arg(0) = 124.0
// expect: index_select(0, false) = 3.0
// expect: index_select(2, true) = 9.0
// expect: arg_copy(1) = 2.0
// expect: closure_swizzle() = (21.0, 12.0, 3.0)
// expect: named_swizzle() = (21.0, 12.0, 3.0)
// expect: erased_mutable_closure() = 7

pub fn bind_assign(a: f32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut b = v.xy
    b = vec2(a, a)
    v.x + v.y + v.z
}

pub fn bind_comp(a: f32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut b = v.xy
    b.x = a
    v.x + v.y + v.z
}

pub fn bind_compound(a: f32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut b = v.zx
    b += vec2(a, a)
    v.x + v.y + v.z
}

pub fn index_read(i: u32) -> f32 {
    let v = vec3(1.0, 2.0, 3.0)
    v.zyx[i]
}

pub fn index_write(i: u32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    v.zyx[i] = 9.0
    v.x * 100.0 + v.y * 10.0 + v.z
}

pub fn index_compound(i: u32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    v.zy[i] += 5.0
    v.x * 100.0 + v.y * 10.0 + v.z
}

pub fn bind_index_read(i: u32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut s = v.zy
    s.x = 4.0
    s[i]
}

pub fn bind_index_write(i: u32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut s = v.zy
    s[i] = 9.0
    v.x * 100.0 + v.y * 10.0 + v.z
}

fn bump(x: mut f32) {
    x += 1.0
}

pub fn bind_index_mut_arg(i: u32) -> f32 {
    var v = vec3(1.0, 2.0, 3.0)
    mut s = v.zy
    bump(mut s[i])
    v.x * 100.0 + v.y * 10.0 + v.z
}

pub fn index_select(i: u32, c: bool) -> f32 {
    let v = vec3(1.0, 2.0, 3.0)
    select(if_false: v.zyx[i], if_true: 9.0, cond: c)
}

fn get(v: vec3, i: u32) -> f32 {
    v[i]
}

pub fn arg_copy(i: u32) -> f32 {
    let v = vec3(1.0, 2.0, 3.0)
    get(v.zyx, i)
}

fn apply_swizzle(v: mut vec3, update: fn(mut vec2)) {
    update(mut v.yx)
}

fn update_components(v: mut vec2) {
    v += vec2(10.0, 20.0)
}

pub fn closure_swizzle() -> vec3 {
    var v = vec3(1.0, 2.0, 3.0)
    apply_swizzle(mut v, |p| { p += vec2(10.0, 20.0) })
    v
}

pub fn named_swizzle() -> vec3 {
    var v = vec3(1.0, 2.0, 3.0)
    apply_swizzle(mut v, update_components)
    v
}

fn invoke_unit(value: mut (), callback: fn(mut ()) -> u32) -> u32 {
    callback(mut value)
}

pub fn erased_mutable_closure() -> u32 {
    var unit = ()
    invoke_unit(mut unit, |_| 7)
}
