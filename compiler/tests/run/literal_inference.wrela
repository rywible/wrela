// run: literals agree across a built-in's arguments, and a match's arms pass as a run
// expect: max_mixed() = 0.5
// expect: min_mixed() = 1.0
// expect: select_mixed(1.0) = 1.5
// expect: select_mixed(-1.0) = 0.0
// expect: max_ints() = 7
// expect: match_run(0) = 3.0
// expect: match_run(1) = 7.0
// expect: min_open() = 10
// expect: sqrt_open() = 6.0
// expect: sqrt_int() = 2.0
// expect: select_ints(1) = 9
// expect: select_arrays(1) = 3.0
// expect: select_arrays(0) = 1.0

fn sum(xs: [f32]) -> f32 {
    var s = 0.0
    for x in xs {
        s += x
    }
    s
}

pub fn max_mixed() -> f32 {
    max(0, 0.5)
}

pub fn min_mixed() -> f32 {
    min(1, 2.5)
}

pub fn select_mixed(s: f32) -> f32 {
    select(0, 1.5, s > 0.0)
}

pub fn max_ints() -> i32 {
    max(3, 7)
}

pub fn match_run(c: i32) -> f32 {
    sum(match c {
        0 => [1.0, 2.0],
        _ => [3.0, 4.0],
    })
}

// A built-in leaves a literal's type open, as an operator does: later uses settle it.
pub fn min_open() -> u32 {
    let n = 7
    let m = min(n, 3)
    let k: u32 = n
    k + m
}

pub fn sqrt_open() -> f64 {
    let x = 4.0
    let y = x.sqrt()
    let z: f64 = x
    z + y
}

pub fn sqrt_int() -> f32 {
    sqrt(4)
}

pub fn select_ints(c: i32) -> u32 {
    let a = 5
    let b = 9
    let r = select(a, b, c > 0)
    let k: u32 = a
    r
}

// `select` chooses whole values too; the literals in both arrays settle as one type.
pub fn select_arrays(c: i32) -> f32 {
    let x = [1.0, 2.0]
    let y = [3.0, 4.0]
    let z = select(x, y, c > 0)
    z[0]
}
