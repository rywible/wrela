// run: a nested derivation is built after what it derives from, whatever order the functions
// come in (here `plain`, which asks for `g`'s gradient, comes before the gradient of `g`)
// expect: plain_x(1.0, 1.0) = 0.70710677
// expect: hess(1.0, 1.0) = -0.35355335
// expect: value_x(1.0, 1.0) = 0.70710677
// expect: encloses() = true
use std::derive::{Box3, gradient, interval, value_and_gradient}

fn f(p: vec3) -> f32 {
    length(p) - 1.0
}

fn g(p: vec3) -> vec3 {
    gradient(|q: vec3| f(q), p)
}

fn hrow(p: vec3) -> f32 {
    gradient(|q: vec3| g(q).x, p).y
}

fn row(p: vec3) -> f32 {
    let (v, _) = value_and_gradient(|q: vec3| g(q).x, p)
    v
}

fn nx_range(lo: vec3, hi: vec3) -> vec2 {
    let r = interval(|q: vec3| g(q).x, Box3 { lo: lo, hi: hi })
    vec2(r.lo, r.hi)
}

pub fn plain(x: f32, y: f32) -> vec3 {
    g(vec3(x, y, 0.0))
}

pub fn plain_x(x: f32, y: f32) -> f32 {
    plain(x, y).x
}

/// ∂²f/∂x∂y = -xy / |p|³: -1 / 2^1.5 at (1, 1, 0).
pub fn hess(x: f32, y: f32) -> f32 {
    hrow(vec3(x, y, 0.0))
}

pub fn value_x(x: f32, y: f32) -> f32 {
    row(vec3(x, y, 0.0))
}

/// x / |p| over [1, 1.1]² × [0, 0.1] is in [1 / √2.22, 1.1 / √2.21] = [0.671156, 0.739940]:
/// the derived range holds it, and is within 1% of it.
pub fn encloses() -> bool {
    let r = nx_range(vec3(1.0, 1.0, 0.0), vec3(1.1, 1.1, 0.1))
    r.x <= 0.671156 && r.y >= 0.73994 && r.x > 0.6645 && r.y < 0.7474
}
