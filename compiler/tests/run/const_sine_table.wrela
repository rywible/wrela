// run: a table computed by the build, indexed at run time
// expect: lookup(3) = 0.29552022
// expect: lookup(19) = 0.29552022

const N: u32 = 16

fn sine_table() -> [f32; 16] {
    var t = [0.0; 16]
    for i in 0..N {
        t[i] = sin(f32(i) * 0.1)
    }
    t
}

const TABLE: [f32; 16] = sine_table()

pub fn lookup(i: u32) -> f32 {
    TABLE[i % N]
}

pub fn frame(time: f32, width: u32, height: u32) {}
