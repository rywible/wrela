// Strict CPU numerics (language.md §11, AC7), exported for compiler/tests/tests/suite/numerics.rs:
// overflow, division by zero and long shifts trap, wrapping arithmetic and bit conversions don't,
// out-of-range float-to-int conversions trap, float `%` is exact, and small parameters wrap.
pub fn frame(time: f32, width: u32, height: u32) {}

pub fn add_i32(a: i32, b: i32) -> i32 {
    a + b
}

pub fn sub_u32(a: u32, b: u32) -> u32 {
    a - b
}

pub fn mul_i32(a: i32, b: i32) -> i32 {
    a * b
}

pub fn mul_i64(a: i64, b: i64) -> i64 {
    a * b
}

pub fn neg_i32(a: i32) -> i32 {
    -a
}

pub fn div_i32(a: i32, b: i32) -> i32 {
    a / b
}

pub fn rem_u32(a: u32, b: u32) -> u32 {
    a % b
}

pub fn shl_u32(a: u32, b: u32) -> u32 {
    a << b
}

pub fn add_u8(a: u32, b: u32) -> u32 {
    u32(u8(a) + u8(b))
}

pub fn wrapping_add_i32(a: i32, b: i32) -> i32 {
    a.wrapping_add(b)
}

pub fn wrapping_mul_u32(a: u32, b: u32) -> u32 {
    a.wrapping_mul(b)
}

pub fn to_i32(x: f32) -> i32 {
    i32(x)
}

pub fn to_u32(x: f32) -> u32 {
    u32(x)
}

pub fn bits(x: i32) -> u32 {
    u32(x)
}

pub fn index(i: u32) -> f32 {
    let a = [1.0, 2.0, 3.0]
    a[i]
}

pub fn rem_f32(a: f32, b: f32) -> f32 {
    a % b
}

pub fn rem_f64(a: f64, b: f64) -> f64 {
    a % b
}

pub fn rem_vec3(a: vec3, b: vec3) -> vec3 {
    a % b
}

pub fn widen_u8(x: u8) -> u32 {
    u32(x)
}

pub fn widen_i8(x: i8) -> i32 {
    i32(x)
}

pub fn widen_u16(x: u16) -> u32 {
    u32(x)
}

pub fn widen_i16(x: i16) -> i32 {
    i32(x)
}

pub fn is_true(b: bool) -> u32 {
    if b == true { 1 } else { 0 }
}
