// Collections (language.md §6.9, §17): `Vec`, and moving values out of places with `swap` and
// `replace`. A collection owns its elements, frees them when it's dropped, and iterates in an
// order that doesn't depend on addresses (D-015).

use std::alloc::{alloc, free, realloc}
use std::par::{chunks_for, par_each}
use std::mem::{
    Drop, align_of, at, at_mut, at_mut_pair, copy, drop_at, read, size_of, take_answer, take_input,
    write, zeroed,
}
pub use std::mem::Pair

/// The runs a sort sorts by insertion before it merges them.
const SORT_RUN: u32 = 16

/// A growable array of `T`s on the heap. `v[i]` projects element `i`, and an index past the end
/// panics; `for x in v` walks the elements in order. Dropping it drops its elements and frees
/// its memory. To avoid allocating every frame, keep one and `clear()` it: it keeps its
/// capacity.
///
/// ```wrela
/// var v: Vec<f32> = Vec::new()
/// v.push(1.5)
/// v.push(2.5)
/// var sum = 0.0
/// for x in v {
///     sum += x
/// }
/// assert(sum == 4.0 && v.len() == 2)
/// ```
pub struct Vec<T>: Clone {
    // The compiler indexes `Vec` in place: these three fields, in this order.
    data: u32,
    len: u32,
    cap: u32,
}

impl<T: Plain> Vec<T> {
    /// For std's requests: the `bytes` bytes of request `request`'s answer, as `T`s. Any bytes
    /// are a `Plain` value; a partial last element is dropped.
    pub(package) fn from_answer(request: u32, bytes: u32) -> Vec<T> {
        let n = bytes / size_of::<T>()
        var v: Vec<T> = Vec::with_capacity(max(n, 1))
        unsafe {
            if n * size_of::<T>() == bytes {
                take_answer(request, v.data)
            } else {
                // Room for the whole answer, then only whole elements kept.
                let raw: Vec<u8> = Vec::with_capacity(bytes)
                take_answer(request, raw.data)
                copy(v.data, raw.data, n * size_of::<T>())
            }
        }
        v.len = n
        v
    }
}

impl<T: Plain> Vec<T> {
    /// For `std::input`: every input event the host has queued, each a `T` of 24 bytes.
    pub(package) fn from_input() -> Vec<T> {
        var v: Vec<T> = Vec::new()
        loop {
            v.reserve(64)
            let room = v.cap - v.len
            let n = unsafe { take_input(v.data + v.len * size_of::<T>(), room) }
            v.len += n
            if n < room {
                break
            }
        }
        v
    }
}

impl<T> Vec<T> {
    /// An empty `Vec`, which allocates nothing until an element is pushed.
    pub fn new() -> Vec<T> {
        Vec { data: 0, len: 0, cap: 0 }
    }

    /// An empty `Vec` with room for `n` elements.
    pub fn with_capacity(n: u32) -> Vec<T> {
        var v = Vec::new()
        v.reserve(n)
        v
    }

    /// How many elements it holds.
    pub fn len(self) -> u32 {
        self.len
    }

    /// Whether it holds no elements.
    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    /// How many elements it has room for before it grows.
    pub fn capacity(self) -> u32 {
        self.cap
    }

    /// Adds `value` at the end.
    pub fn push(mut self, value: take T) {
        if self.len == self.cap {
            self.grow(self.len + 1)
        }
        unsafe {
            write::<T>(self.slot(self.len), take value)
        }
        self.len += 1
    }

    /// Removes the last element and returns it; `None` when it's empty.
    pub fn pop(mut self) -> Option<T> {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        unsafe { Some(read::<T>(self.slot(self.len))) }
    }

    /// Drops every element. The capacity stays.
    pub fn clear(mut self) {
        self.truncate(0)
    }

    /// Drops the elements from `n` on, if there are more than `n`.
    pub fn truncate(mut self, n: u32) {
        while self.len > n {
            self.len -= 1
            unsafe {
                drop_at::<T>(self.slot(self.len))
            }
        }
    }

    /// Makes room for at least `more` more elements.
    pub fn reserve(mut self, more: u32) {
        if self.cap - self.len < more {
            self.grow(self.len + more)
        }
    }

    /// Puts `value` at `i`, moving the elements from `i` on one place up. `i` may be the length.
    pub fn insert(mut self, i: u32, value: take T) {
        if i > self.len {
            panic("insert: the index is past the end")
        }
        if self.len == self.cap {
            self.grow(self.len + 1)
        }
        unsafe {
            copy(self.slot(i + 1), self.slot(i), (self.len - i) * size_of::<T>())
            write::<T>(self.slot(i), take value)
        }
        self.len += 1
    }

    /// Takes the element at `i` out, moving the ones after it down.
    pub fn remove(mut self, i: u32) -> T {
        if i >= self.len {
            panic("remove: the index is past the end")
        }
        unsafe {
            let value = read::<T>(self.slot(i))
            copy(self.slot(i), self.slot(i + 1), (self.len - i - 1) * size_of::<T>())
            self.len -= 1
            value
        }
    }

    /// Takes the element at `i` out, putting the last element in its place: no moving, but the
    /// order changes.
    pub fn swap_remove(mut self, i: u32) -> T {
        if i >= self.len {
            panic("swap_remove: the index is past the end")
        }
        unsafe {
            let value = read::<T>(self.slot(i))
            self.len -= 1
            copy(self.slot(i), self.slot(self.len), size_of::<T>())
            value
        }
    }

    /// Exchanges the elements at `a` and `b`.
    pub fn swap(mut self, a: u32, b: u32) {
        if a >= self.len || b >= self.len {
            panic("swap: an index is past the end")
        }
        if a != b {
            unsafe {
                let x = read::<T>(self.slot(a))
                copy(self.slot(a), self.slot(b), size_of::<T>())
                write::<T>(self.slot(b), take x)
            }
        }
    }

    /// Removes the first `n` elements and returns them, in order, as a `Vec` of their own.
    pub fn drain_front(mut self, n: u32) -> Vec<T> {
        let n = min(n, self.len)
        var out = Vec::with_capacity(n)
        unsafe {
            copy(out.data, self.data, n * size_of::<T>())
            copy(self.data, self.slot(n), (self.len - n) * size_of::<T>())
        }
        out.len = n
        self.len -= n
        out
    }

    /// Moves every element of `other` to the end of this one, leaving `other` empty.
    pub fn append(mut self, other: mut Vec<T>) {
        self.reserve(other.len)
        unsafe {
            copy(self.slot(self.len), other.data, other.len * size_of::<T>())
        }
        self.len += other.len
        other.len = 0
    }

    /// Keeps the elements for which `keep` is true, in order, and drops the rest.
    pub fn retain(mut self, keep: fn(T) -> bool) {
        var kept = 0
        for i in 0..self.len {
            if keep(self[i]) {
                if kept != i {
                    unsafe {
                        copy(self.slot(kept), self.slot(i), size_of::<T>())
                    }
                }
                kept += 1
            } else {
                unsafe {
                    drop_at::<T>(self.slot(i))
                }
            }
        }
        self.len = kept
    }

    /// `n` elements, element `i` made by `make(i)`: for a `T` that can't be cloned, which
    /// `filled` needs.
    ///
    /// ```wrela
    /// let squares = Vec::from_fn(4, |i| i * i)
    /// assert(squares[3] == 9)
    /// ```
    pub fn from_fn(n: u32, make: fn(u32) -> T) -> Vec<T> {
        var v = Vec::with_capacity(n)
        for i in 0..n {
            v.push(make(i))
        }
        v
    }

    /// Sorts the elements by `before`, which says whether its first argument goes before its
    /// second. Stable: equal elements keep their order. A merge sort, O(n log n): its room, as
    /// many bytes as the elements take, is allocated for the call (`sort_by_in` keeps it).
    ///
    /// ```wrela
    /// var v: Vec<u32> = Vec::new()
    /// for x in [5, 3, 9, 1] {
    ///     v.push(x)
    /// }
    /// v.sort_by(|a, b| a < b)
    /// assert(v[0] == 1 && v[3] == 9)
    /// ```
    pub fn sort_by(mut self, before: fn(T, T) -> bool) {
        var room: Vec<u8> = Vec::new()
        self.sort_by_in(before, mut room)
    }

    /// `sort_by`, with its room in `room`, which keeps it: once `room` has grown to the
    /// elements' bytes, a sort allocates nothing (a tick's, §6.17).
    pub fn sort_by_in(mut self, before: fn(T, T) -> bool, room: mut Vec<u8>) {
        let n = self.len
        // Runs of `SORT_RUN` elements, each sorted in place by insertion.
        var lo = 0
        while lo < n {
            let hi = min(lo + SORT_RUN, n)
            for i in lo + 1..hi {
                var j = i
                while j > lo && before(self[j], self[j - 1]) {
                    self.swap(j, j - 1)
                    j -= 1
                }
            }
            lo = hi
        }
        if n <= SORT_RUN {
            return
        }
        // Then merged in pairs, from one buffer to the other, each element moved bitwise
        // (so none is dropped or copied), until one run is left.
        let size = size_of::<T>()
        room.clear()
        room.reserve(n * size)
        var src = self.data
        var dst = room.data
        var width = SORT_RUN
        while width < n {
            var lo = 0
            while lo < n {
                let mid = min(lo + width, n)
                let hi = min(lo + 2 * width, n)
                var i = lo
                var j = mid
                for k in lo..hi {
                    // The left run's element while it's not after the right run's: stable.
                    let left = i < mid && (j >= hi || !unsafe {
                        before(
                            at::<T, Vec<T>>(self, src + j * size),
                            at::<T, Vec<T>>(self, src + i * size),
                        )
                    })
                    unsafe {
                        if left {
                            copy(dst + k * size, src + i * size, size)
                            i += 1
                        } else {
                            copy(dst + k * size, src + j * size, size)
                            j += 1
                        }
                    }
                }
                lo = hi
            }
            let t = src
            src = dst
            dst = t
            width = 2 * width
        }
        if src != self.data {
            unsafe {
                copy(self.data, src, n * size)
            }
        }
    }

    /// The address of element `i`.
    fn slot(self, i: u32) -> u32 {
        self.data + i * size_of::<T>()
    }

    /// Calls `f` on each element, which it may change, in parallel: on this thread and the
    /// program's workers (§6.12). The elements are split into chunks by their number alone, so
    /// what `f` does doesn't depend on how many workers there are. `f` sees its element and
    /// reads what it captures: it can't write captured data (E0520), or do IO, record GPU work
    /// or be non-deterministic (E0600).
    pub fn par_each_mut(mut self, f: @parallel fn(mut T)) {
        let chunks = chunks_for(self.len)
        if chunks > 0 {
            par_each(chunks, mut self, f)
        }
    }

    /// `map`s each element and `reduce`s the results, in parallel: on this thread and the
    /// program's workers (§6.12). The elements are split into chunks by their number alone, each
    /// chunk folds its elements from `init` in order, and the chunks' results are folded from
    /// `init` in order, so the result doesn't depend on how many workers there are (for a
    /// `reduce` that `init` is an identity of, it's the sequential fold's when `reduce` is
    /// associative). Like `par_each_mut`'s, the functions only read what they capture.
    pub fn par_map_reduce<R: Clone>(
        self,
        init: R,
        map: @parallel fn(T) -> R,
        reduce: @parallel fn(R, R) -> R,
    ) -> R {
        let chunks = chunks_for(self.len)
        var partial: Vec<R> = Vec::with_capacity(chunks)
        for _ in 0..chunks {
            partial.push(init.clone())
        }
        if chunks > 0 {
            std::par::par_map_reduce(chunks, self, init, map, reduce, mut partial)
        }
        var out = init.clone()
        for c in 0..chunks {
            out = reduce(out, partial[c].clone())
        }
        out
    }

    /// Elements `i` and `j`, both to change at once. Exclusivity is checked here, at run time
    /// (§6.5): `i == j` panics, and so does an index past the end.
    pub fn pair_mut(mut self, i: u32, j: u32) -> Pair<T> {
        if i == j {
            panic("pair_mut: both indices name one element")
        }
        if i >= self.len || j >= self.len {
            panic("pair_mut: an index is past the end")
        }
        unsafe { at_mut_pair::<T, Vec<T>>(mut self, self.slot(i), self.slot(j)) }
    }

    /// Grows the capacity to at least `need`: doubling, so pushes take constant time on
    /// average.
    fn grow(mut self, need: u32) {
        let cap = max(need, max(4, self.cap * 2))
        unsafe {
            let size = size_of::<T>()
            self.data = realloc(self.data, self.cap * size, cap * size, align_of::<T>())
        }
        self.cap = cap
    }
}

/// A list of at most `N` values, held in place: an array and how many of it are in use. It's
/// `Copy`, and `Plain` and `GpuData` where `T` is, so it can be in a snapshot (§6.12) or on the
/// GPU, where a `Vec` can't. `b[i]` projects element `i` (on the CPU, an index at or past
/// `len()` panics), and `for x in b` walks the elements in use. It hashes, saves and compares
/// only those.
///
/// ```wrela
/// var b: Bounded<u32, 4> = Bounded::new()
/// b.push(3)
/// b.push(5)
/// b[0] += 1
/// var sum = 0
/// for x in b {
///     sum += x
/// }
/// assert(sum == 9 && b.len() == 2 && !b.is_full())
/// ```
pub struct Bounded<T, const N: u32>: Copy + Plain + GpuData {
    // The compiler indexes `Bounded` in place: these two fields, in this order.
    items: [T; N],
    len: u32,
}

impl<T, const N: u32> Bounded<T, N> {
    /// How many elements are in use.
    pub fn len(self) -> u32 {
        self.len
    }

    /// Whether none is.
    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    /// Whether all `N` are.
    pub fn is_full(self) -> bool {
        self.len == N
    }

    /// `N`: how many it can hold.
    pub fn capacity(self) -> u32 {
        N
    }
}

impl<T: Copy, const N: u32> Bounded<T, N> {
    /// An empty list.
    pub fn new() -> Bounded<T, N> {
        // The elements past `len` are never read: each is written by `push` first.
        Bounded { items: unsafe { zeroed() }, len: 0 }
    }

    /// A list of `xs`' elements, in order: at most `N` of them (more panic).
    pub fn from(xs: [T]) -> Bounded<T, N> {
        var b = Bounded::new()
        for x in xs {
            b.push(x)
        }
        b
    }

    /// Adds `value` at the end. A full list panics.
    pub fn push(mut self, value: T) {
        if self.len == N {
            panic("push: the `Bounded` is full")
        }
        self.items[self.len] = value
        self.len += 1
    }

    /// The last element, removed; `None` if it's empty.
    pub fn pop(mut self) -> Option<T> {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        Some(self.items[self.len])
    }

    /// Element `i`, removed: the ones after it move down one. An index at or past `len()`
    /// panics.
    pub fn remove(mut self, i: u32) -> T {
        let x = self[i]
        for k in i + 1..self.len {
            self.items[k - 1] = self.items[k]
        }
        self.len -= 1
        x
    }

    /// Removes every element.
    pub fn clear(mut self) {
        self.len = 0
    }
}

impl<T: Eq, const N: u32> Eq for Bounded<T, N> {
    fn eq(self, other: Bounded<T, N>) -> bool {
        if self.len != other.len {
            return false
        }
        for i in 0..self.len {
            if self.items[i] != other.items[i] {
                return false
            }
        }
        true
    }
}

/// Sorts `xs`, an array's elements or a run's, by `before`, which says whether its first
/// argument goes before its second. Stable, O(n log n): a merge sort, whose room, a copy of
/// the elements, is allocated for the call. (`Vec::sort_by` sorts a `Vec`, of any `T`.)
///
/// ```wrela
/// use std::collections::sort_by
///
/// var xs = [2.5, -1.0, 7.0, 0.5]
/// sort_by(mut xs, |a, b| a < b)
/// assert(xs[0] == -1.0 && xs[3] == 7.0)
/// ```
pub fn sort_by<T: Copy>(xs: mut [T], before: fn(T, T) -> bool) {
    let n = xs.len()
    // Runs of `SORT_RUN` elements, each sorted by insertion.
    var lo = 0
    while lo < n {
        let hi = min(lo + SORT_RUN, n)
        for i in lo + 1..hi {
            let x = xs[i]
            var j = i
            while j > lo && before(x, xs[j - 1]) {
                xs[j] = xs[j - 1]
                j -= 1
            }
            xs[j] = x
        }
        lo = hi
    }
    if n <= SORT_RUN {
        return
    }
    // Then merged in pairs into the room, and back, until one run is left.
    var room: Vec<T> = Vec::with_capacity(n)
    var width = SORT_RUN
    while width < n {
        room.clear()
        var lo = 0
        while lo < n {
            let mid = min(lo + width, n)
            let hi = min(lo + 2 * width, n)
            var i = lo
            var j = mid
            while i < mid || j < hi {
                if i < mid && (j >= hi || !before(xs[j], xs[i])) {
                    room.push(xs[i])
                    i += 1
                } else {
                    room.push(xs[j])
                    j += 1
                }
            }
            lo = hi
        }
        for k in 0..n {
            xs[k] = room[k]
        }
        width = 2 * width
    }
}

impl<T> Drop for Vec<T> {
    fn drop(mut self) {
        self.clear()
        unsafe {
            free(self.data, self.cap * size_of::<T>())
        }
    }
}

impl<T: Clone> Vec<T> {
    /// `n` copies of `value`.
    ///
    /// ```wrela
    /// let v = Vec::filled(3, 0.5)
    /// assert(v.len() == 3 && v[2] == 0.5)
    /// ```
    pub fn filled(n: u32, value: T) -> Vec<T> {
        var v = Vec::with_capacity(n)
        for _ in 0..n {
            v.push(value.clone())
        }
        v
    }

    /// A `Vec` of a copy of each of `xs`: `Vec::from([1.0, 2.0])`.
    pub fn from(xs: [T]) -> Vec<T> {
        var out = Vec::with_capacity(xs.len())
        for x in xs {
            out.push(x.clone())
        }
        out
    }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(self) -> Vec<T> {
        var out = Vec::with_capacity(self.len)
        for x in self {
            out.push(x.clone())
        }
        out
    }

    /// Reuses `into`'s buffer: no allocation once it has grown to size.
    fn clone_into(self, into: mut Vec<T>) {
        into.truncate(self.len)
        for i in 0..into.len {
            self[i].clone_into(mut into[i])
        }
        for i in into.len..self.len {
            into.push(self[i].clone())
        }
    }
}

impl<T: Eq> Eq for Vec<T> {
    fn eq(self, other: Vec<T>) -> bool {
        if self.len != other.len {
            return false
        }
        for i in 0..self.len {
            if self[i] != other[i] {
                return false
            }
        }
        true
    }
}

/// Element by element, then the shorter first.
impl<T: Ord> Ord for Vec<T> {
    fn cmp(self, other: Vec<T>) -> Ordering {
        let n = min(self.len, other.len)
        for i in 0..n {
            let o = self[i].cmp(other[i])
            if o != Ordering::Equal {
                return o
            }
        }
        self.len.cmp(other.len)
    }
}

/// Exchanges the values of two places, which mustn't overlap.
@intrinsic
pub fn swap<T>(a: mut T, b: mut T) {}

/// Puts `value` in `place` and returns what was there: how to move a value out of a place you
/// can only borrow, as `replace(mut slot, None)` empties an `Option` slot.
@intrinsic
pub fn replace<T>(place: mut T, value: take T) -> T {}

/// A value on the heap: how a type holds itself (a tree's children), which it can't inline.
/// `b.get()` reads the value in place and `b.get_mut()` changes it; dropping the box drops the
/// value and frees its memory.
pub struct Box<T>: Clone {
    // The value's address.
    addr: u32,
}

impl<T> Box<T> {
    /// Moves `value` to the heap.
    pub fn new(value: take T) -> Box<T> {
        unsafe {
            let a = alloc(size_of::<T>(), align_of::<T>())
            write::<T>(a, take value)
            Box { addr: a }
        }
    }

    /// The value, in place.
    pub fn get(self) -> borrow T {
        unsafe { at::<T, Box<T>>(self, self.addr) }
    }

    /// The value, to change in place.
    pub fn get_mut(mut self) -> mut T {
        unsafe { mut at_mut::<T, Box<T>>(mut self, self.addr) }
    }

    /// The value, moved off the heap.
    pub fn into_inner(take self) -> T {
        var b = take self
        unsafe {
            let value = read::<T>(b.addr)
            free(b.addr, size_of::<T>())
            b.addr = 0
            value
        }
    }
}

impl<T> Drop for Box<T> {
    fn drop(mut self) {
        if self.addr != 0 {
            unsafe {
                drop_at::<T>(self.addr)
                free(self.addr, size_of::<T>())
            }
        }
    }
}

impl<T: Clone> Clone for Box<T> {
    fn clone(self) -> Box<T> {
        Box::new(self.get().clone())
    }

    /// Reuses `into`'s block, and what its value owns.
    fn clone_into(self, into: mut Box<T>) {
        self.get().clone_into(mut into.get_mut())
    }
}

impl<T: Eq> Eq for Box<T> {
    fn eq(self, other: Box<T>) -> bool {
        self.get() == other.get()
    }
}

impl<T: Ord> Ord for Box<T> {
    fn cmp(self, other: Box<T>) -> Ordering {
        self.get().cmp(other.get())
    }
}

// ---- tests ------------------------------------------------------------------------------------

struct Keyed {
    key: u32,
    order: u32,
    owned: Vec<u32>,
}

@test
fn a_vec_sorts_stably_whatever_its_length() {
    for n in [0, 1, 2, 15, 16, 17, 31, 32, 33, 100, 1000, 4097] {
        var v: Vec<Keyed> = Vec::new()
        var s = n + 7
        for i in 0..n {
            s = s.wrapping_mul(1664525).wrapping_add(1013904223)
            var owned = Vec::new()
            owned.push(i)
            v.push(Keyed { key: (s >> 16) % 50, order: i, owned: take owned })
        }
        v.sort_by(|a, b| a.key < b.key)
        assert(v.len() == n)
        for i in 1..n {
            let (a, b) = (v[i - 1].key, v[i].key)
            assert(a < b || (a == b && v[i - 1].order < v[i].order))
            // Each element moved whole: what it owns came with it.
            assert(v[i].owned[0] == v[i].order)
        }
    }
}

@test
fn a_sort_in_its_room_allocates_nothing_more() {
    var room: Vec<u8> = Vec::new()
    var v: Vec<u32> = Vec::new()
    for i in 0..300 {
        v.push((i * 7919) % 300)
    }
    v.sort_by_in(|a, b| a < b, mut room)
    let cap = room.capacity()
    v.sort_by_in(|a, b| a > b, mut room)
    assert(room.capacity() == cap && v[0] == 299 && v[299] == 0)
}

@test
fn an_array_sorts_stably() {
    var pairs = [(0, 0); 40]
    for i in 0..40 {
        pairs[i] = ((i * 17) % 5, i)
    }
    sort_by(mut pairs, |a, b| a.0 < b.0)
    for i in 1..40 {
        let (a, b) = (pairs[i - 1], pairs[i])
        assert(a.0 < b.0 || (a.0 == b.0 && a.1 < b.1))
    }
}

@test
fn a_bounded_list_holds_what_was_pushed() {
    var b: Bounded<(u32, f32), 3> = Bounded::new()
    assert(b.is_empty() && b.capacity() == 3)
    b.push((1, 0.5))
    b.push((2, 1.5))
    b[1].1 += 1.0
    assert(b.len() == 2 && b[1].1 == 2.5)
    var keys = 0
    for (k, _) in b {
        keys += k
    }
    assert(keys == 3)
    // Equal by their elements in use, whatever the rest of the array held.
    var c = Bounded::from([(1, 0.5), (2, 2.5), (9, 9.0)])
    assert(c.pop() == Some((9, 9.0)))
    assert(b == c)
    b.clear()
    assert(b.is_empty() && b != c)
    // Removing moves the rest down, in order.
    var d: Bounded<u32, 4> = Bounded::from([1, 2, 3, 4])
    assert(d.is_full() && d.remove(1) == 2 && d.len() == 3 && d[1] == 3 && d[2] == 4)
}
