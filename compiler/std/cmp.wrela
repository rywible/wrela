            Ordering::Less
        } else if self > other {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Ord for f32 {
    /// NaN compares equal to everything, as no `<` or `>` holds with it.
    fn cmp(self, other: f32) -> Ordering {
        if self < other {
            Ordering::Less
        } else if self > other {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

impl Ord for f64 {
    /// NaN compares equal to everything, as no `<` or `>` holds with it.
    fn cmp(self, other: f64) -> Ordering {
        if self < other {
            Ordering::Less
        } else if self > other {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }
}

