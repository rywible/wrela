        self == other
    }
}

// Arrays and tuples compare element by element, in order.

impl<T: Eq, const N: u32> Eq for [T; N] {
    fn eq(self, other: [T; N]) -> bool {
        for i in 0..N {
            if self[i] != other[i] {
                return false
            }
        }
        true
    }
}

impl<T: Ord, const N: u32> Ord for [T; N] {
    fn cmp(self, other: [T; N]) -> Ordering {
        for i in 0..N {
            let o = self[i].cmp(other[i])
            if o != Ordering::Equal {
                return o
            }
        }
        Ordering::Equal
    }
}

impl<A: Eq, B: Eq> Eq for (A, B) {
    fn eq(self, other: (A, B)) -> bool {
        self.0 == other.0 && self.1 == other.1
    }
}

impl<A: Ord, B: Ord> Ord for (A, B) {
    fn cmp(self, other: (A, B)) -> Ordering {
        self.0.cmp(other.0).then(self.1.cmp(other.1))
    }
}

impl<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {
    fn eq(self, other: (A, B, C)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2
    }
}

impl<A: Ord, B: Ord, C: Ord> Ord for (A, B, C) {
    fn cmp(self, other: (A, B, C)) -> Ordering {
        self.0.cmp(other.0).then(self.1.cmp(other.1)).then(self.2.cmp(other.2))
    }
}

impl<A: Eq, B: Eq, C: Eq, D: Eq> Eq for (A, B, C, D) {
    fn eq(self, other: (A, B, C, D)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3
    }
}

impl<A: Ord, B: Ord, C: Ord, D: Ord> Ord for (A, B, C, D) {
    fn cmp(self, other: (A, B, C, D)) -> Ordering {
        self.0
            .cmp(other.0)
            .then(self.1.cmp(other.1))
            .then(self.2.cmp(other.2))
            .then(self.3.cmp(other.3))
    }
}
