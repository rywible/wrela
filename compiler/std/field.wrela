// Fields: functions over space (language.md §17). A field's structure is its type and its
// numbers are data (D-070): `sphere(1.0).smooth_union(round_cone(...), k: 0.1)` has the type
// `SmoothUnion<Sphere, RoundCone>`, whose value is a few floats that reach the GPU as a uniform.
//
// A `Surface` is a signed distance. A `Field<C>` is a surface whose points also carry channels
// `C` (D-002), which the combinators blend where surfaces blend (`Blend`). A `Lipschitz`
// surface states a bound on its gradient, near the surface (D-092), so sphere tracing can step
// by it (`to_bound`). A `Noise` states its range, its gradient's bound and its bandlimit.
//
// A surface's parts are the leaves of its tree of combinators (language.md §22): each knows
// which part decides its distance at a point (`part_at`), each part's own distance, and its
// name, so a tool can say what a point belongs to without knowing what made the surface.

use std::collections::Vec
use std::derive::{Box3, Interval, gradient, interval, value_and_gradient}
use std::quat::Quat
use std::hash::StateHash
use std::mem::debug_build

/// A signed distance over 3D space: negative inside, positive outside.
///
/// ```wrela
/// use std::field::{Surface, round_cone, sphere}
///
/// fn blob() -> Surface {
///     let cone = round_cone(vec3(), vec3(y: 1.0), r_top: 0.3, r_bottom: 0.1)
///     sphere(0.5).smooth_union(cone, k: 0.1)
/// }
///
/// assert(blob().distance(vec3(0.0, 0.5, 0.0)) < 0.0)    // inside
/// assert(blob().distance(vec3(2.0, 0.0, 0.0)) > 0.0)    // outside
/// ```
pub trait Surface: Copy + GpuData {
    /// The signed distance from `p` to the surface.
    fn distance(self, p: vec3) -> f32

    /// The gradient of `distance`, derived by the compiler (§13): the surface normal, not
    /// normalized.
    fn gradient(self, p: vec3) -> vec3 {
        gradient(|q| self.distance(q), p)
    }

    /// The distance and its gradient, from one derived evaluation.
    fn sample(self, p: vec3) -> (f32, vec3) {
        value_and_gradient(|q| self.distance(q), p)
    }

    /// Its distance at `p` as something `footprint` wide sees it (a pixel's or a cell's span):
    /// detail finer than the footprint fades to its mean instead of aliasing (D-077). A
    /// displacement filters its noise (`Noise::filtered`), and every combinator passes the
    /// footprint on, so detail anywhere in a surface's tree is filtered. The default is the
    /// distance itself: a surface with no detail finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.distance(p)
    }

    /// A range holding every distance in `over`, derived by interval arithmetic.
    fn interval(self, over: Box3) -> Interval {
        interval(|q| self.distance(q), over)
    }

    /// Every point inside either surface: the smaller distance.
    fn union<B: Surface>(self, b: B) -> Union<Self, B> {
        Union { a: self, b }
    }

    /// A union whose seam is rounded over a width of about `k`.
    fn smooth_union<B: Surface>(self, b: B, k: f32) -> SmoothUnion<Self, B> {
        SmoothUnion { a: self, b, k }
    }

    /// Every point inside both surfaces: the larger distance.
    fn intersect<B: Surface>(self, b: B) -> Intersect<Self, B> {
        Intersect { a: self, b }
    }

    /// The same surface, moved by `by`.
    fn translate(self, by: vec3) -> Translate<Self> {
        Translate { inner: self, by }
    }

    /// Adds `amp` times a noise to the distance: wrinkles, bark, terrain.
    fn displace<N: Noise>(self, noise: N, amp: f32) -> Displace<Self, N> {
        Displace { inner: self, noise, amp }
    }

    /// The same surface, every point of which carries the channels `value`.
    fn with<C: Copy + GpuData>(self, value: C) -> With<Self, C> {
        With { inner: self, value }
    }

    /// The same surface, whose channels at `p` are `at(p)`: `.with_at(|p| Tissue { albedo:
    /// dapple(p, seed), ..HIDE })`. The closure is stored in the field, so it captures values
    /// only (§6.7).
    fn with_at<C, F: Copy + GpuData + fn(vec3) -> C>(self, at: F) -> WithAt<Self, F> {
        WithAt { inner: self, at }
    }

    /// `a` with `b` cut out of it, the cut's edge rounded over a width of about `k`.
    fn smooth_subtract<B: Surface>(self, b: B, k: f32) -> SmoothSubtract<Self, B> {
        SmoothSubtract { a: self, b, k }
    }

    /// What `a` and `b` hold in common, the edge rounded over a width of about `k`.
    fn smooth_intersect<B: Surface>(self, b: B, k: f32) -> SmoothIntersect<Self, B> {
        SmoothIntersect { a: self, b, k }
    }

    /// The same surface, turned by `by` about the origin.
    fn rotate(self, by: Quat) -> Rotate<Self> {
        Rotate { inner: self, to_local: by.inverse().to_mat3() }
    }

    /// The same surface, `by` times the size, about the origin.
    fn scale(self, by: f32) -> Scale<Self> {
        Scale { inner: self, by }
    }

    /// The surface and its mirror image in the plane x = 0: what it is at `p`, it is at
    /// `(-p.x, p.y, p.z)`. Written for x ≥ 0, its parts are twice its own: those at x ≥ 0, then
    /// their images.
    fn mirror_x(self) -> Mirror<Self> {
        Mirror { inner: self }
    }

    /// The same surface, one part with a name: tools say where a point is by it (§22).
    fn named(self, name: Text) -> Named<Self> {
        Named { inner: self, name }
    }

    // ---- provenance (§22) ----

    /// How many parts it has: the leaves of its tree of combinators. A primitive, a closure
    /// and a `named` surface are one part each.
    fn parts(self) -> u32 {
        1
    }

    /// Its distance at `p` (the same as `distance`), and the part that decides it: through each
    /// combinator, the operand whose distance the result follows. For a union or a blend that's
    /// the nearer, for an intersection the farther, and for a cut the cutter where the cut is
    /// the surface. Parts are numbered from 0, in the order the tree's leaves are written.
    fn part_at(self, p: vec3) -> (f32, u32) {
        (self.distance(p), 0)
    }

    /// Part `i`'s own distance at `p`: that part as if it were the whole surface, moved, turned,
    /// scaled and displaced as the combinators above it move, turn, scale and displace it.
    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.distance(p)
    }

    /// Part `i`'s name: empty where nothing names it.
    fn part_name(self, i: u32) -> PartName {
        unnamed()
    }

    /// The distance at `p` if part `i`'s own distance were `by` more: through each combinator,
    /// that operand raised and the others as they are. Where part `i` doesn't decide the
    /// distance (another part is nearer by more than the width of any blend between them) it's
    /// the distance itself; `part_share` is how much it changes.
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.distance(p) + by
    }
}

/// How much part `i` decides `field`'s distance at `p`: how much the distance changes where
/// the part's own distance does (`part_offset`, by 0.1 mm), from 0 (another part decides it:
/// the part can change without moving the surface there) to 1 (the part alone decides it), and
/// between in a blend.
pub fn part_share<S: Surface>(field: S, p: vec3, i: u32) -> f32 {
    (field.part_offset(p, i, by: 0.0001) - field.distance(p)) / 0.0001
}

// ---- measures (§22) ----------------------------------------------------------------------
//
// Where a surface is, as numbers a spec can hold it to (std::lift's `Checks`). Each searches
// with values, then takes one Newton step along its ray, so its derivative by anything the
// field reads (a lifted literal, `std::lift::gradient`) is the exact one: the search's own
// change cancels in the step.

/// How far along the ray from `o` in direction `dir` (a unit vector) it first meets `field`'s
/// surface, within `far`; -1 if it doesn't.
pub fn hit<S: Surface>(field: S, o: vec3, dir: vec3, far: f32 = 10.0) -> f32 {
    var t = 0.0
    var found = false
    for _ in 0..512 {
        let d = field.distance(o + dir * t)
        if abs(d) < 0.00005 {
            found = true
            break
        }
        t += max(d * 0.8, 0.00005)
        if t > far {
            break
        }
    }
    if !found {
        return -1.0
    }
    // One Newton step: the root's derivative, from the slope along the ray.
    let h = 0.0001
    let p = o + dir * t
    let slope = (field.distance(p + dir * h) - field.distance(p - dir * h)) / (2.0 * h)
    if abs(slope) < 0.05 {
        return t
    }
    t - field.distance(p) / slope
}

/// The height of the surface's top above the ground point (`x`, `z`): where a ray from 10 m
/// up meets it, going down; 0 if nothing is above that point.
pub fn top<S: Surface>(field: S, x: f32, z: f32) -> f32 {
    let t = hit(field, vec3(x, 10.0, z), vec3(0.0, -1.0, 0.0), far: 20.0)
    if t < 0.0 { 0.0 } else { 10.0 - t }
}

/// The height of the surface's underside above the ground point (`x`, `z`): where a ray from
/// 10 m down meets it, going up; 0 if nothing is there.
pub fn bottom<S: Surface>(field: S, x: f32, z: f32) -> f32 {
    let t = hit(field, vec3(x, -10.0, z), vec3(0.0, 1.0, 0.0), far: 20.0)
    if t < 0.0 { 0.0 } else { t - 10.0 }
}

/// How wide the surface is across x along the line at height `y` and depth `z`: from where
/// a ray from the left meets it to where one from the right does; 0 if neither does.
pub fn width<S: Surface>(field: S, y: f32, z: f32) -> f32 {
    let a = hit(field, vec3(10.0, y, z), vec3(-1.0, 0.0, 0.0), far: 20.0)
    let b = hit(field, vec3(-10.0, y, z), vec3(1.0, 0.0, 0.0), far: 20.0)
    if a < 0.0 || b < 0.0 { 0.0 } else { (10.0 - a) - (b - 10.0) }
}

/// The surface's front along z at height `y`, `x` from the middle: where a ray from 10 m in
/// front (+z) meets it, going back; -10 if nothing is there.
pub fn front<S: Surface>(field: S, x: f32, y: f32) -> f32 {
    let t = hit(field, vec3(x, y, 10.0), vec3(0.0, 0.0, -1.0), far: 20.0)
    if t < 0.0 { -10.0 } else { 10.0 - t }
}

/// The surface's back along z at height `y`, `x` from the middle (`front`, from behind); 10
/// if nothing is there.
pub fn back<S: Surface>(field: S, x: f32, y: f32) -> f32 {
    let t = hit(field, vec3(x, y, -10.0), vec3(0.0, 0.0, 1.0), far: 20.0)
    if t < 0.0 { 10.0 } else { t - 10.0 }
}

/// How far the surface reaches in direction `dir` (a unit vector) within `region`: the
/// largest p · dir over the surface there. Rays along −dir sweep the region's cross-section,
/// 16 by 16, then twice more 8 by 8 around the best, each from where it enters the region, so
/// the surface outside it hides nothing. The measure is the best ray's hit, so its derivative
/// is that point's; where the surface fills the region's edge, it's the edge. -10⁹ if the
/// region holds no surface.
pub fn farthest<S: Surface>(field: S, dir: vec3, region: Box3) -> f32 {
    let c = 0.5 * (region.lo + region.hi)
    let e = region.hi - region.lo
    let reach = length(e)
    // Two axes across `dir`.
    let helper = if abs(dir.y) < 0.9 { vec3(0.0, 1.0, 0.0) } else { vec3(1.0, 0.0, 0.0) }
    let u = normalize(cross(helper, dir))
    let v = cross(dir, u)
    // The rays' way, and its inverse for the region's slabs.
    let w = -dir
    let inv = vec3(slab_inverse(w.x), slab_inverse(w.y), slab_inverse(w.z))
    var centre = vec2(0.0)
    var half = 0.5 * reach
    var best = -1.0e9
    for round in 0..3 {
        let n = if round == 0 { 16 } else { 8 }
        var found = centre
        for i in 0..n {
            for j in 0..n {
                let a = centre +
                    vec2((f32(i) + 0.5) / f32(n) * 2.0 - 1.0, (f32(j) + 0.5) / f32(n) * 2.0 - 1.0) *
                        half
                let o = c + u * a.x + v * a.y + dir * reach
                // Where the ray enters the region and leaves it.
                let t_lo = (region.lo - o) * inv
                let t_hi = (region.hi - o) * inv
                let near = min(t_lo, t_hi)
                let far = max(t_lo, t_hi)
                let t0 = max(max(near.x, near.y), max(near.z, 0.0))
                let t1 = min(far.x, min(far.y, far.z))
                if t0 < t1 {
                    let p0 = o + w * t0
                    var m = -1.0e9
                    if field.distance(p0) <= 0.0 {
                        m = dot(p0, dir)
                    } else {
                        let t = hit(field, p0, w, far: t1 - t0)
                        if t >= 0.0 {
                            m = dot(p0 + w * t, dir)
                        }
                    }
                    if m > best {
                        best = m
                        found = a
                    }
                }
            }
        }
        centre = found
        half = half * 2.5 / f32(n)
    }
    best
}

/// 1 / x for a ray's slab test, large and finite where x is 0, so no NaN comes of 0 / 0.
fn slab_inverse(x: f32) -> f32 {
    if abs(x) < 0.000001 { 1.0e6 } else { 1.0 / x }
}

/// The index of the part named `name` (`part_name(i).name`): the first, if several share it,
/// and `parts()` if none does.
pub fn part_named<S: Surface>(field: S, name: str) -> u32 {
    for i in 0..field.parts() {
        if field.part_name(i).name == name {
            return i
        }
    }
    field.parts()
}

/// Part `i`'s family: the first part with its name in its group, so a part and its mirror
/// image are one family. An unnamed part is its own.
pub fn part_family<S: Surface>(field: S, i: u32) -> u32 {
    let a = field.part_name(i)
    if a.name.len() == 0 {
        return i
    }
    for j in 0..i {
        let b = field.part_name(j)
        if b.name == a.name && b.group == a.group {
            return j
        }
    }
    i
}

/// Each part's family (`part_family`), by index.
pub fn part_families<S: Surface>(field: S) -> Vec<u32> {
    let n = field.parts()
    var out: Vec<u32> = Vec::with_capacity(n)
    for i in 0..n {
        out.push(part_family(field, i))
    }
    out
}

/// Part `i`'s mirror image: the part with its name in its group, mirrored the other way; `i`
/// itself if it has none, or no name.
pub fn part_image<S: Surface>(field: S, i: u32) -> u32 {
    let a = field.part_name(i)
    if a.name.len() == 0 {
        return i
    }
    for j in 0..field.parts() {
        let b = field.part_name(j)
        if j != i && b.name == a.name && b.group == a.group && b.mirrored != a.mirrored {
            return j
        }
    }
    i
}

// ---- certified checks (§22) ------------------------------------------------------------

/// What a certified check of a region found: the property holds at every point of it (proved by
/// derived intervals, §13), it fails at a point (a counterexample), or the intervals couldn't
/// tell within the depth asked, first in the box given.
pub enum Certified: Copy {
    Holds,
    Fails(vec3),
    Unknown(Box3),
}

impl Certified {
    /// Whether the check proved the property: `Holds`.
    pub fn holds(self) -> bool {
        match self {
            Certified::Holds => true,
            _ => false,
        }
    }
}

/// Whether `f` is positive everywhere in `region`: its derived interval over each box (the
/// region, then its octree, `depth` levels at most) is above 0 there, or a point where it isn't.
/// Each box is checked at its centre too, so a failure is found as a point, not just a box.
///
/// ```wrela
/// use std::derive::Box3
/// use std::field::{Surface, certify_positive, sphere}
///
/// let s = sphere(0.5).translate(vec3(0.0, 0.6, 0.0))
/// let below = Box3 { lo: vec3(-2.0, -1.0, -2.0), hi: vec3(2.0, 0.0, 2.0) }
/// assert(certify_positive(|p: vec3| s.distance(p), below, depth: 6).holds())
/// ```
pub fn certify_positive(f: fn(vec3) -> f32, region: Box3, depth: u32) -> Certified {
    var stack: Vec<(Box3, u32)> = Vec::new()
    stack.push((region, 0))
    var unknown: Option<Box3> = None
    while stack.len() > 0 {
        let Some(item) = stack.pop() else { break }
        let (b, d) = item
        let r = interval(f, b)
        if r.lo > 0.0 {
            continue
        }
        let c = 0.5 * (b.lo + b.hi)
        if r.hi <= 0.0 || !(f(c) > 0.0) {
            return Certified::Fails(c)
        }
        if d >= depth {
            if unknown.is_none() {
                unknown = Some(b)
            }
            continue
        }
        let h = 0.5 * (b.hi - b.lo)
        for j in 0..8 {
            let o = vec3(f32(j & 1), f32((j >> 1) & 1), f32((j >> 2) & 1)) * h
            stack.push((Box3 { lo: b.lo + o, hi: b.lo + o + h }, d + 1))
        }
    }
    match unknown {
        Some(b) => Certified::Unknown(b),
        None => Certified::Holds,
    }
}

/// Whether nothing of `field`'s inside is in `region` (its distance is positive everywhere
/// there): for example, nothing below the ground.
pub fn certify_clear<S: Surface>(field: S, region: Box3, depth: u32) -> Certified {
    certify_positive(|p: vec3| field.distance(p), region, depth)
}

/// Whether parts `a` and `b` of `field` don't overlap anywhere in `region`: at every point at
/// least one of them is outside (the larger of their own distances is positive).
pub fn certify_apart<S: Surface>(field: S, a: u32, b: u32, region: Box3, depth: u32) -> Certified {
    certify_positive(
        |p: vec3| max(field.part_distance(p, a), field.part_distance(p, b)),
        region,
        depth,
    )
}

/// A part's name, for tools (§22): the name its author gave it, the name of the group it's in,
/// the name of the space it's placed in (an engine's creature places parts on bones), and
/// whether it's the mirror image of the part as written. Each name is empty where nothing gives
/// one.
pub struct PartName: Copy {
    pub name: Text,
    pub group: Text,
    pub frame: Text,
    pub mirrored: bool,
}

/// A part with no name.
pub fn unnamed() -> PartName {
    PartName { name: "", group: "", frame: "", mirrored: false }
}

/// A scalar function over 3D space, used to displace surfaces.
pub trait Noise: Copy + GpuData {
    /// The noise's value at `p`.
    fn value(self, p: vec3) -> f32

    /// Every value it takes.
    fn range(self) -> Interval

    /// A bound on its gradient's length, everywhere.
    fn lipschitz(self) -> f32

    /// Its highest frequency, in cycles per unit: detail finer than `1 / bandlimit()` is all
    /// there is above it (D-077).
    fn bandlimit(self) -> f32

    /// Its value averaged over the box `p ± footprint / 2`, each component a width (0 samples
    /// that axis): what a pixel whose footprint spans that box sees. Detail finer than the
    /// footprint fades to its mean instead of aliasing (D-077). The default is the value itself,
    /// which is right for a noise with no detail finer than the footprints it's seen at.
    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        self.value(p)
    }
}

// ---- primitives ---------------------------------------------------------------------------------

/// A closure or function of a point is a surface too, its value the distance: `|p| length(p)
/// - r`, written where it's used (§6.7). Its gradient and interval are derived as any
/// surface's are; it has no Lipschitz bound of its own (§13).
impl<F: Copy + GpuData + fn(vec3) -> f32> Surface for F {
    fn distance(self, p: vec3) -> f32 {
        self(p)
    }
}

/// A sphere centred at the origin. Exact.
pub struct Sphere: Copy + GpuData {
    pub radius: f32,
}

/// A sphere of radius `radius`, centred at the origin.
pub fn sphere(radius: f32) -> Sphere {
    Sphere { radius }
}

impl Surface for Sphere {
    fn distance(self, p: vec3) -> f32 {
        length(p) - self.radius
    }
}

/// An ellipsoid centred at the origin. No exact distance exists; this is the usual bound.
pub struct Ellipsoid: Copy + GpuData {
    pub radii: vec3,
}

/// An ellipsoid with half-axes `radii`, centred at the origin.
pub fn ellipsoid(radii: vec3) -> Ellipsoid {
    Ellipsoid { radii }
}

impl Surface for Ellipsoid {
    fn distance(self, p: vec3) -> f32 {
        let k0 = length(p / self.radii)
        let k1 = length(p / (self.radii * self.radii))
        // At the centre the bound is 0 / 0; the distance there is minus the smallest radius.
        if k1 == 0.0 {
            return -min(self.radii.x, min(self.radii.y, self.radii.z))
        }
        k0 * (k0 - 1.0) / max(k1, 0.000000001)
    }
}

/// An ellipsoid whose distance stays well behaved: outside it's `Ellipsoid`'s, which is near
/// the true distance; inside it's (k0 − 1) times the smallest radius, whose gradient is never
/// more than 1, where `Ellipsoid`'s grows without bound towards the centre (3 to 25 in thin or
/// blended ellipsoids). The surface is the same. Prefer it for parts that blend.
pub struct Oval: Copy + GpuData {
    pub radii: vec3,
}

/// An oval with half-axes `radii`, centred at the origin (`Oval`).
pub fn oval(radii: vec3) -> Oval {
    Oval { radii }
}

impl Surface for Oval {
    fn distance(self, p: vec3) -> f32 {
        let k0 = length(p / self.radii)
        if k0 < 1.0 {
            return (k0 - 1.0) * min(self.radii.x, min(self.radii.y, self.radii.z))
        }
        let k1 = length(p / (self.radii * self.radii))
        k0 * (k0 - 1.0) / max(k1, 0.000000001)
    }
}

/// Round cones through `points`, each `radii` thick there, joined end to end: a limb, a neck
/// or a tail that bends at its points. Consecutive cones share the sphere at their joint, so
/// their union is smooth there and swells nothing (a smooth seam between segments bulges by a
/// quarter of its width). Exact.
pub struct Tube<const N: u32>: Copy + GpuData {
    pub points: [vec3; N],
    pub radii: [f32; N],
}

/// A tube through `points`, `radii` thick at each (`Tube`).
pub fn tube<const N: u32>(points: [vec3; N], radii: [f32; N]) -> Tube<N> {
    Tube { points, radii }
}

impl<const N: u32> Surface for Tube<N> {
    fn distance(self, p: vec3) -> f32 {
        var d = length(p - self.points[0]) - self.radii[0]
        for i in 1..N {
            let c = round_cone(
                self.points[i - 1],
                self.points[i],
                r_top: self.radii[i - 1],
                r_bottom: self.radii[i],
            )
            d = min(d, c.distance(p))
        }
        d
    }
}

/// The hull of two spheres, centred at `a` with radius `r1` and at `b` with radius `r2`.
/// Exact, also where one sphere holds the other (the hull is then the larger sphere).
pub struct RoundCone: Copy + GpuData {
    pub a: vec3,
    pub b: vec3,
    pub r1: f32,
    pub r2: f32,
}

/// The hull of a sphere of radius `r_top` at `a` and one of radius `r_bottom` at `b`.
pub fn round_cone(a: vec3, b: vec3, r_top: f32, r_bottom: f32) -> RoundCone {
    RoundCone { a, b, r1: r_top, r2: r_bottom }
}

impl Surface for RoundCone {
    fn distance(self, p: vec3) -> f32 {
        let ba = self.b - self.a
        let l = length(ba)
        let rr = self.r1 - self.r2
        // Where |r1 - r2| >= |b - a| (a == b too), one sphere holds the other, and the hull is
        // the larger one.
        if l <= abs(rr) {
            length(p - select(if_false: self.b, if_true: self.a, cond: rr >= 0.0)) -
                max(self.r1, self.r2)
        } else {
            // Inigo Quilez's round cone, written with the axis's direction u and q, the radii's
            // difference per unit of length: each term is about |p - a|². (The usual form's
            // terms grow as |b - a|⁶, and leave f32's range for ends closer than about 10⁻⁷.)
            let u = ba / l
            let q = rr / l
            let a2 = 1.0 - q * q
            let pa = p - self.a
            let y = dot(pa, u)
            let z = y - l
            let xv = pa - u * y
            let x2 = dot(xv, xv)
            let k = sign(q) * q * q * x2
            if sign(z) * a2 * z * z > k {
                sqrt(x2 + z * z) - self.r2
            } else if sign(y) * a2 * y * y < k {
                sqrt(x2 + y * y) - self.r1
            } else {
                sqrt(x2 * a2) + y * q - self.r1
            }
        }
    }
}

/// A box centred at the origin, with half-extents `half`. Exact.
pub struct Cuboid: Copy + GpuData {
    pub half: vec3,
}

/// A box with half-extents `half`, centred at the origin.
pub fn cuboid(half: vec3) -> Cuboid {
    Cuboid { half }
}

impl Surface for Cuboid {
    /// Outside, the distance to the nearest point of the box; inside, minus the distance to
    /// the nearest face. One branch on which, so what's derived from it knows the side: on a
    /// face, the interval of the gradient is the face's normal (spike 13).
    fn distance(self, p: vec3) -> f32 {
        let q = abs(p) - self.half
        let m = max(q.x, max(q.y, q.z))
        if m > 0.0 { length(max(q, vec3(0.0))) } else { m }
    }
}

/// Everything on the negative side of a plane: `dot(p, normal) < offset`. The distance is
/// exact when `normal` is a unit vector, as `half_space` makes it.
pub struct HalfSpace: Copy + GpuData {
    pub normal: vec3,
    pub offset: f32,
}

/// The half-space `dot(p, normal) < offset`, for a nonzero `normal` of any length: both are
/// divided by its length, which leaves the same half-space.
pub fn half_space(normal: vec3, offset: f32) -> HalfSpace {
    // Scaled by its largest component first, so its length neither overflows nor underflows.
    let m = max(max(abs(normal.x), abs(normal.y)), abs(normal.z))
    let n = normal / m
    let l = length(n)
    HalfSpace { normal: n / l, offset: offset / m / l }
}

impl Surface for HalfSpace {
    fn distance(self, p: vec3) -> f32 {
        dot(p, self.normal) - self.offset
    }
}

// ---- combinators --------------------------------------------------------------------------------

/// The smooth minimum of two distances: where they're `k` or more apart it's exactly the
/// smaller. With `k <= 0` it's `min(a, b)`.
///
/// This is the usual polynomial blend, `mix(b, a, h) - k h (1 - h)` with
/// `h = clamp(0.5 + 0.5 (b - a) / k, 0, 1)`, rearranged (it's the same function, up to
/// rounding) so that what the compiler derives from it is cheap: its gradient doesn't carry
/// terms that cancel, and its interval is the smaller distance's, less at most `k / 4`. It
/// chooses the smaller distance once, with one branch, so an interval that can't decide which
/// runs each side knowing it, and the interval of its gradient stays between its parts' on a
/// blend's seam (spike 13).
pub fn smin(a: f32, b: f32, k: f32) -> f32 {
    // The smallest normal f32 keeps `0.25 / k` finite, and `m` is 0 for `k <= 0`. `m` times
    // at most a quarter doesn't overflow where `m * m` would. (A derived interval with `k = 0`
    // can multiply that huge `s` into an infinity, and the infinity by 0: a caller whose `k`
    // can be 0 chooses `min` itself, as the engine's seams do. A branch here would cost a
    // derived gradient a sixth of its speed: the grazer's, `grazer.rs`.)
    let s = 0.25 / max(k, 1.1754944e-38)
    let d = b - a
    if d > 0.0 {
        let m = max(k - d, 0.0)
        a - m * (m * s)
    } else {
        // `k + d` is `k - |a - b|` here, and at a tie it still carries `d`'s derivative, so
        // the seam's gradient is half each side's. Two equal infinite distances (an empty
        // surface's) are 0 apart, though their difference is NaN; a NaN still makes a NaN.
        let m = max(k + select(if_false: d, if_true: 0.0, cond: a == b && d != d), 0.0)
        b - m * (m * s)
    }
}

// Provenance (§22) through a combinator of two surfaces, whose parts are `a`'s then `b`'s, and
// through one of an array of surfaces: what the combinators share. Each has its own `part_at`.

/// The distances of `a` and `b` at `p`, part `i` of the two raised by `by` (`part_offset`).
fn pair_offsets<A: Surface, B: Surface>(a: A, b: B, p: vec3, i: u32, by: f32) -> (f32, f32) {
    let n = a.parts()
    if i < n { (a.part_offset(p, i, by), b.distance(p)) } else {
        (a.distance(p), b.part_offset(p, i - n, by))
    }
}

fn pair_parts<A: Surface, B: Surface>(a: A, b: B) -> u32 {
    a.parts() + b.parts()
}

fn pair_part_distance<A: Surface, B: Surface>(a: A, b: B, p: vec3, i: u32) -> f32 {
    let n = a.parts()
    if i < n { a.part_distance(p, i) } else { b.part_distance(p, i - n) }
}

fn pair_part_name<A: Surface, B: Surface>(a: A, b: B, i: u32) -> PartName {
    let n = a.parts()
    if i < n { a.part_name(i) } else { b.part_name(i - n) }
}

/// Which of `parts` holds part `i` of them all, and its number there; `N` where none does.
fn locate<S: Surface, const N: u32>(parts: [S; N], i: u32) -> (u32, u32) {
    var first = 0
    for k in 0..N {
        let n = parts[k].parts()
        if i < first + n {
            return (k, i - first)
        }
        first += n
    }
    (N, 0)
}

fn array_parts<S: Surface, const N: u32>(parts: [S; N]) -> u32 {
    var n = 0
    for i in 0..N {
        n += parts[i].parts()
    }
    n
}

fn array_part_distance<S: Surface, const N: u32>(parts: [S; N], p: vec3, i: u32) -> f32 {
    let (k, j) = locate(parts, i)
    if k < N { parts[k].part_distance(p, j) } else { EMPTY }
}

fn array_part_name<S: Surface, const N: u32>(parts: [S; N], i: u32) -> PartName {
    let (k, j) = locate(parts, i)
    if k < N { parts[k].part_name(j) } else { unnamed() }
}

/// Two surfaces joined: `a.union(b)`.
pub struct Union<A, B>: Copy + GpuData {
    pub a: A,
    pub b: B,
}

impl<A: Surface, B: Surface> Surface for Union<A, B> {
    fn distance(self, p: vec3) -> f32 {
        min(self.a.distance(p), self.b.distance(p))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        min(self.a.filtered(p, footprint), self.b.filtered(p, footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        min(da, db)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The nearer operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (min(da, db), if da <= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }
}

/// Two surfaces joined by a rounded seam: `a.smooth_union(b, k)`.
pub struct SmoothUnion<A, B>: Copy + GpuData {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothUnion<A, B> {
    fn distance(self, p: vec3) -> f32 {
        smin(self.a.distance(p), self.b.distance(p), self.k)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smin(self.a.filtered(p, footprint), self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smin(da, db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The nearer operand's part: the one whose distance the blend follows most.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smin(da, db, self.k), if da <= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }
}

/// The parts of a fixed array of surfaces of one type, joined (§17): `legs.union()`,
/// `legs.smooth_union(k: 6cm)`. Each folds the parts in order, so `[a, b, c].union()` is
/// `a.union(b).union(c)`.
impl<S: Surface, const N: u32> [S; N] {
    /// The parts joined.
    pub fn union(self) -> UnionAll<S, N> {
        UnionAll { parts: self }
    }

    /// A union whose seams are rounded over a width of about `k`.
    pub fn smooth_union(self, k: f32) -> SmoothUnionAll<S, N> {
        SmoothUnionAll { parts: self, k }
    }
}

/// A fixed array of surfaces joined: `parts.union()`.
pub struct UnionAll<S, const N: u32>: Copy + GpuData {
    pub parts: [S; N],
}

impl<S: Surface, const N: u32> Surface for UnionAll<S, N> {
    /// The nearest part's distance; with no parts, nowhere near (`EMPTY`).
    fn distance(self, p: vec3) -> f32 {
        var d = EMPTY
        for i in 0..N {
            d = min(d, self.parts[i].distance(p))
        }
        d
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        var d = EMPTY
        for i in 0..N {
            d = min(d, self.parts[i].filtered(p, footprint))
        }
        d
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (m, j) = locate(self.parts, i)
        var d = EMPTY
        for k in 0..N {
            let dk = if k == m { self.parts[k].part_offset(p, j, by) } else {
                self.parts[k].distance(p)
            }
            d = min(d, dk)
        }
        d
    }

    fn parts(self) -> u32 {
        array_parts(self.parts)
    }

    /// The nearest operand's part; a tie takes the earlier's.
    fn part_at(self, p: vec3) -> (f32, u32) {
        var d = EMPTY
        var part = 0
        var first = 0
        for i in 0..N {
            let (di, pi) = self.parts[i].part_at(p)
            if di < d {
                part = first + pi
            }
            d = min(d, di)
            first += self.parts[i].parts()
        }
        (d, part)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        array_part_distance(self.parts, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        array_part_name(self.parts, i)
    }
}

/// A fixed array of surfaces joined by rounded seams: `parts.smooth_union(k)`.
pub struct SmoothUnionAll<S, const N: u32>: Copy + GpuData {
    pub parts: [S; N],
    pub k: f32,
}

impl<S: Surface, const N: u32> Surface for SmoothUnionAll<S, N> {
    fn distance(self, p: vec3) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].distance(p)
        for i in 1..N {
            d = smin(d, self.parts[i].distance(p), self.k)
        }
        d
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        if N == 0 {
            return EMPTY
        }
        var d = self.parts[0].filtered(p, footprint)
        for i in 1..N {
            d = smin(d, self.parts[i].filtered(p, footprint), self.k)
        }
        d
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (m, j) = locate(self.parts, i)
        var d = EMPTY
        for k in 0..N {
            let dk = if k == m { self.parts[k].part_offset(p, j, by) } else {
                self.parts[k].distance(p)
            }
            d = if k == 0 { dk } else { smin(d, dk, self.k) }
        }
        d
    }

    fn parts(self) -> u32 {
        array_parts(self.parts)
    }

    /// The part of the operand nearest `p`, as the blend weighs them.
    fn part_at(self, p: vec3) -> (f32, u32) {
        if N == 0 {
            return (EMPTY, 0)
        }
        let (d0, p0) = self.parts[0].part_at(p)
        var d = d0
        var nearest = d0
        var part = p0
        var first = self.parts[0].parts()
        for i in 1..N {
            let (di, pi) = self.parts[i].part_at(p)
            if di < nearest {
                nearest = di
                part = first + pi
            }
            d = smin(d, di, self.k)
            first += self.parts[i].parts()
        }
        (d, part)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        array_part_distance(self.parts, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        array_part_name(self.parts, i)
    }
}

/// The distance of a union of no parts: farther than anything a scene holds.
pub const EMPTY: f32 = 1.0e30

/// What two surfaces hold in common: `a.intersect(b)`.
pub struct Intersect<A, B>: Copy + GpuData {
    pub a: A,
    pub b: B,
}

impl<A: Surface, B: Surface> Surface for Intersect<A, B> {
    fn distance(self, p: vec3) -> f32 {
        max(self.a.distance(p), self.b.distance(p))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        max(self.a.filtered(p, footprint), self.b.filtered(p, footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        max(da, db)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The farther operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (max(da, db), if da >= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }
}

/// A surface moved: `s.translate(by)`.
pub struct Translate<S>: Copy + GpuData {
    pub inner: S,
    pub by: vec3,
}

impl<S: Surface> Surface for Translate<S> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p - self.by)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p - self.by, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p - self.by, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p - self.by)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p - self.by, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

/// A surface with noise added to its distance: `s.displace(noise, amp)`.
pub struct Displace<S, N>: Copy + GpuData {
    pub inner: S,
    pub noise: N,
    pub amp: f32,
}

impl<S: Surface, N: Noise> Surface for Displace<S, N> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p) + self.amp * self.noise.value(p)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint) + self.amp * self.noise.filtered(p, vec3(footprint))
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by) + self.amp * self.noise.value(p)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p)
        (d + self.amp * self.noise.value(p), i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i) + self.amp * self.noise.value(p)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

/// The smooth maximum of two distances: `-smin(-a, -b, k)`. Where they're `k` or more apart
/// it's exactly the larger; with `k <= 0` it's `max(a, b)`.
pub fn smax(a: f32, b: f32, k: f32) -> f32 {
    -smin(-a, -b, k)
}

/// `a` with `b` cut out of it: `a.smooth_subtract(b, k)`.
pub struct SmoothSubtract<A, B>: Copy + GpuData {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothSubtract<A, B> {
    fn distance(self, p: vec3) -> f32 {
        smax(self.a.distance(p), -self.b.distance(p), self.k)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smax(self.a.filtered(p, footprint), -self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smax(da, -db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The cutter's part where the cut is the surface (inside `b`, farther than `a`), else
    /// `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smax(da, -db, self.k), if da >= -db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }
}

/// What two surfaces hold in common, rounded: `a.smooth_intersect(b, k)`.
pub struct SmoothIntersect<A, B>: Copy + GpuData {
    pub a: A,
    pub b: B,
    pub k: f32,
}

impl<A: Surface, B: Surface> Surface for SmoothIntersect<A, B> {
    fn distance(self, p: vec3) -> f32 {
        smax(self.a.distance(p), self.b.distance(p), self.k)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        smax(self.a.filtered(p, footprint), self.b.filtered(p, footprint), self.k)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let (da, db) = pair_offsets(self.a, self.b, p, i, by)
        smax(da, db, self.k)
    }

    fn parts(self) -> u32 {
        pair_parts(self.a, self.b)
    }

    /// The farther operand's part; a tie takes `a`'s.
    fn part_at(self, p: vec3) -> (f32, u32) {
        let (da, ia) = self.a.part_at(p)
        let (db, ib) = self.b.part_at(p)
        (smax(da, db, self.k), if da >= db { ia } else { self.a.parts() + ib })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        pair_part_distance(self.a, self.b, p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        pair_part_name(self.a, self.b, i)
    }
}

/// A surface turned about the origin: `s.rotate(by)`. It keeps the rotation that takes a point
/// into the surface's own space.
pub struct Rotate<S>: Copy + GpuData {
    pub inner: S,
    pub to_local: mat3,
}

impl<S> Rotate<S> {
    /// `p` in the surface's own space: column by column, as a derived interval needs (it has
    /// no matrix arithmetic).
    fn local(self, p: vec3) -> vec3 {
        let m = self.to_local
        m[0] * p.x + m[1] * p.y + m[2] * p.z
    }
}

impl<S: Surface> Surface for Rotate<S> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(self.local(p))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(self.local(p), footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(self.local(p), i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(self.local(p))
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(self.local(p), i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

/// A surface scaled about the origin: `s.scale(by)`. Distances scale with it, so a distance
/// stays a distance.
pub struct Scale<S>: Copy + GpuData {
    pub inner: S,
    pub by: f32,
}

impl<S: Surface> Surface for Scale<S> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p / self.by) * self.by
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p / self.by, footprint / abs(self.by)) * self.by
    }

    /// `by` is in this surface's units: the inner surface's part is raised by `by / self.by`.
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p / self.by, i, by / self.by) * self.by
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p / self.by)
        (d * self.by, i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p / self.by, i) * self.by
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

/// A surface and its mirror image in x = 0: `s.mirror_x()`.
pub struct Mirror<S>: Copy + GpuData {
    pub inner: S,
}

/// `p` reflected into x ≥ 0, where a mirrored surface is written.
fn mirrored(p: vec3) -> vec3 {
    vec3(abs(p.x), p.y, p.z)
}

impl<S: Surface> Surface for Mirror<S> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(mirrored(p))
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(mirrored(p), footprint)
    }

    /// A part as written decides at x ≥ 0, its image at x < 0 (as `part_at` has it).
    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        let n = self.inner.parts()
        let image = p.x < 0.0
        if (i < n) != image {
            self.inner.part_offset(mirrored(p), i % n, by)
        } else {
            self.inner.distance(mirrored(p))
        }
    }

    /// Its own parts, as written (at x ≥ 0), then their images.
    fn parts(self) -> u32 {
        2 * self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(mirrored(p))
        (d, if p.x < 0.0 { self.inner.parts() + i } else { i })
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        let n = self.inner.parts()
        if i < n {
            self.inner.part_distance(p, i)
        } else {
            self.inner.part_distance(vec3(-p.x, p.y, p.z), i - n)
        }
    }

    fn part_name(self, i: u32) -> PartName {
        let n = self.inner.parts()
        if i < n {
            self.inner.part_name(i)
        } else {
            var name = self.inner.part_name(i - n)
            name.mirrored = !name.mirrored
            name
        }
    }
}

/// A surface that is one part, named: `s.named(name)`.
pub struct Named<S>: Copy + GpuData {
    pub inner: S,
    pub name: Text,
}

impl<S: Surface> Surface for Named<S> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_name(self, i: u32) -> PartName {
        PartName { name: self.name, group: "", frame: "", mirrored: false }
    }
}

// ---- noise --------------------------------------------------------------------------------------

/// A 32-bit integer hash (PCG-style), the same bits on the CPU and the GPU.
pub fn hash_u32(x: u32) -> u32 {
    var h = x.wrapping_mul(747796405).wrapping_add(2891336453)
    h = ((h >> ((h >> 28) + 4)) ^ h).wrapping_mul(277803737)
    (h >> 22) ^ h
}

/// `i32(x)` for a whole number `x`, wrapped to 32 bits as the lattice's hash wraps its
/// coordinates: `x`'s low 32 bits beyond the i32 range, and 0 for inf or NaN.
fn lattice_coord(x: f32) -> i32 {
    if abs(x) < 2147483648.0 {
        return i32(x)
    }
    // Exact: at |x| >= 2^31 an f32 is a multiple of 2^8, and so is this, which is below 2^32.
    let low = x - 4294967296.0 * floor(x / 4294967296.0)
    if low == low {
        i32(u32(low))
    } else {
        0
    }
}

/// A pseudo-random value in [-1, 1] for an integer lattice point.
pub fn lattice(x: i32, y: i32, z: i32) -> f32 {
    let h = hash_u32(u32(x).wrapping_add(hash_u32(u32(y).wrapping_add(hash_u32(u32(z))))))
    f32(h) * (2.0 / 4294967295.0) - 1.0
}

/// Value noise with a quintic fade: in [-1, 1], smooth, one lattice cell per unit. NaN where a
/// coordinate is infinite or NaN.
pub fn value_noise(p: vec3) -> f32 {
    let fl = floor(p)
    let ix = lattice_coord(fl.x)
    let iy = lattice_coord(fl.y)
    let iz = lattice_coord(fl.z)
    let f = p - fl
    // `saturate` changes no value (the fade maps [0, 1] onto itself), but it tells an interval
    // the fade stays in [0, 1] even across a cell boundary, where `f` alone can't.
    let u = saturate(f * f * f * (f * (f * 6.0 - 15.0) + 10.0))
    let (jx, jy, jz) = (ix.wrapping_add(1), iy.wrapping_add(1), iz.wrapping_add(1))
    let a = lattice(ix, iy, iz)
    let b = lattice(jx, iy, iz)
    let c = lattice(ix, jy, iz)
    let d = lattice(jx, jy, iz)
    let e = lattice(ix, iy, jz)
    let f1 = lattice(jx, iy, jz)
    let g = lattice(ix, jy, jz)
    let h = lattice(jx, jy, jz)
    mix(mix(mix(a, b, u.x), mix(c, d, u.x), u.y), mix(mix(e, f1, u.x), mix(g, h, u.x), u.y), u.z)
}

/// The integral of value noise's interpolation kernel, K(t) = fade(1 − |t|), from 0 to t: odd,
/// and ±1/2 from |t| = 1 on. With U(v) = v⁶ − 3v⁵ + 5/2 v⁴, the quintic fade's antiderivative,
/// it's U(1) − U(1 − |t|).
fn kernel_integral(t: f32) -> f32 {
    let v = 1.0 - min(abs(t), 1.0)
    let g = 0.5 - v * v * v * v * (v * (v - 3.0) + 2.5)
    if t < 0.0 { -g } else { g }
}

/// The weight lattice coordinate `i` gives the average of value noise over `[x − h, x + h]` on
/// one axis: its kernel's integral over the interval, divided by its width; for `h` = 0, the
/// kernel's value at `x`.
fn box_weight(x: f32, h: f32, i: f32) -> f32 {
    if h <= 0.0 {
        let t = 1.0 - min(abs(x - i), 1.0)
        t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
    } else {
        (kernel_integral(x + h - i) - kernel_integral(x - h - i)) / (2.0 * h)
    }
}

/// Value noise averaged over the box `p ± half`, exactly (up to rounding): each axis's half
/// width may be 0, which samples it. Value noise is a sum of lattice values, each times a
/// kernel that's a product over the axes, so its average is a sum over the lattice points the
/// box reaches, each times its kernel's average on each axis.
pub fn value_noise_box(p: vec3, half: vec3) -> f32 {
    let h = abs(half)
    let lo = floor(p - h)
    let n = floor(p + h) - lo + 2.0
    let (nx, ny, nz) = (u32(n.x), u32(n.y), u32(n.z))
    let (ix, iy, iz) = (lattice_coord(lo.x), lattice_coord(lo.y), lattice_coord(lo.z))
    var s = 0.0
    for k in 0..nz {
        let wz = box_weight(p.z, h.z, lo.z + f32(k))
        if wz != 0.0 {
            for j in 0..ny {
                let wyz = wz * box_weight(p.y, h.y, lo.y + f32(j))
                if wyz != 0.0 {
                    for i in 0..nx {
                        let w = wyz * box_weight(p.x, h.x, lo.x + f32(i))
                        let v = lattice(
                            ix.wrapping_add(i32(i)),
                            iy.wrapping_add(i32(j)),
                            iz.wrapping_add(i32(k)),
                        )
                        s += w * v
                    }
                }
            }
        }
    }
    s
}

/// Fractal noise: `octaves` layers of value noise, each at twice the frequency and half the
/// amplitude of the last, sampled at `p + offset`.
pub struct Fbm: Copy + GpuData {
    pub freq: f32,
    pub octaves: u32,
    pub offset: vec3,
}

/// Fractal noise at base frequency `freq`, with `octaves` layers, sampled at `p + offset`.
pub fn fbm(freq: f32, octaves: u32, offset: vec3 = vec3()) -> Fbm {
    Fbm { freq, octaves, offset }
}

impl Noise for Fbm {
    fn value(self, p: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..self.octaves {
            s += a * value_noise(q * fr + f32(o) * 17.0)
            a *= 0.5
            fr *= 2.0
        }
        s
    }

    /// The sum of the octaves' amplitudes, each way: 2 − 2^(1 − octaves).
    fn range(self) -> Interval {
        var r = 0.0
        var a = 1.0
        for _o in 0..self.octaves {
            r += a
            a *= 0.5
        }
        Interval { lo: -r, hi: r }
    }

    /// Each octave's gradient is at most its amplitude times its frequency (which is `freq`
    /// for every octave) times value noise's bound.
    fn lipschitz(self) -> f32 {
        f32(self.octaves) * abs(self.freq) * VALUE_NOISE_LIPSCHITZ
    }

    /// The finest octave's lattice frequency.
    fn bandlimit(self) -> f32 {
        if self.octaves == 0 { 0.0 } else { abs(self.freq) * exp2(f32(self.octaves - 1)) }
    }

    /// Each octave by its size against the footprint: sampled where its cells are 16 or more
    /// footprints across, averaged over the footprint exactly (`value_noise_box`) where they're
    /// down to a quarter of one, and its mean, 0, where they're finer still.
    fn filtered(self, p: vec3, footprint: vec3) -> f32 {
        let q = p + self.offset
        var s = 0.0
        var a = 1.0
        var fr = self.freq
        for o in 0..self.octaves {
            let half = abs(footprint) * (0.5 * abs(fr))
            let r = 2.0 * max(half.x, max(half.y, half.z))
            let at = q * fr + f32(o) * 17.0
            if r < 0.0625 {
                s += a * value_noise(at)
            } else if r <= 4.0 {
                s += a * value_noise_box(at, half)
            }
            a *= 0.5
            fr *= 2.0
        }
        s
    }
}

/// A bound on value noise's gradient: the quintic fade's slope is at most 30/16, the lattice
/// values differ by at most 2, so each component is at most 3.75, and the length at most
/// 3.75 √3 (with room for rounding).
pub const VALUE_NOISE_LIPSCHITZ: f32 = 6.5

// ---- Lipschitz bounds ---------------------------------------------------------------------------

/// A surface that bounds its own gradient near itself, so sphere tracing can step by it (§17,
/// D-092). Primitives state their bound; combinators compose their parts' in ordinary code, and
/// pass the scope on.
pub trait Lipschitz: Surface {
    /// A bound on the length of `distance`'s gradient wherever |distance| < `near`. A consumer
    /// passes the scope it needs: a step of at most `near` (`to_bound`), or an interval test
    /// over a block that straddles the surface, at least the block's radius.
    fn lipschitz(self, near: f32) -> f32

    /// The distance, held within ±`near` and divided by `lipschitz(near)`: never more than the
    /// distance to the surface, so sphere tracing can step by it. A debug build checks the
    /// bound against the derived gradient first (`check_lipschitz`).
    fn to_bound(self, near: f32) -> ToBound<Self> {
        let l = self.lipschitz(near)
        if debug_build() {
            check_lipschitz(self, near, l)
        }
        ToBound { inner: self, near, scale: 1.0 / l }
    }
}

/// A surface divided by its Lipschitz bound: `.to_bound(near)`.
pub struct ToBound<S>: Copy + GpuData {
    pub inner: S,
    pub near: f32,
    pub scale: f32,
}

impl<S: Surface> Surface for ToBound<S> {
    fn distance(self, p: vec3) -> f32 {
        clamp(self.inner.distance(p), -self.near, self.near) * self.scale
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        clamp(self.inner.filtered(p, footprint), -self.near, self.near) * self.scale
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        clamp(self.inner.part_offset(p, i, by / self.scale), -self.near, self.near) * self.scale
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        let (d, i) = self.inner.part_at(p)
        (clamp(d, -self.near, self.near) * self.scale, i)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        clamp(self.inner.part_distance(p, i), -self.near, self.near) * self.scale
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

impl<S: Surface> Lipschitz for ToBound<S> {
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl<C, S: Field<C>> Field<C> for ToBound<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p)
        (clamp(d, -self.near, self.near) * self.scale, c)
    }
}

impl Lipschitz for Sphere {
    /// Exact: its gradient is a unit vector.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl Lipschitz for RoundCone {
    /// Exact.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl Lipschitz for Cuboid {
    /// Exact.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl Lipschitz for HalfSpace {
    /// Exact: `half_space` makes its normal a unit vector.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl Lipschitz for Oval {
    /// Inside, 1. Outside, within `near` (e = near / min(r)): the first term of `Ellipsoid`'s
    /// gradient is at most 2 − 1 / (1 + e), and the second, from k1's change, e (max(r) /
    /// min(r))² / (1 + e).
    fn lipschitz(self, near: f32) -> f32 {
        let lo = min(self.radii.x, min(self.radii.y, self.radii.z))
        let hi = max(self.radii.x, max(self.radii.y, self.radii.z))
        let e = max(near, 0.0) / lo
        let r = hi / lo
        max(1.0, 2.0 - 1.0 / (1.0 + e) + e * r * r / (1.0 + e)) * 1.001
    }
}

impl<const N: u32> Lipschitz for Tube<N> {
    /// A union of exact distances: 1.
    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

impl Lipschitz for Ellipsoid {
    /// The bound k0 (k0 − 1) / k1, with k0 = |p / r| and k1 = |p / r²|, has a gradient that
    /// grows without bound at the centre. Where |distance| < near, |k0 − 1| < e = near /
    /// min(r), and its gradient is at most max(2 − 1 / (1 + e), 1 / (1 − e) − 2) +
    /// e (max(r) / min(r))² / (1 − e). Infinite from e = 1 on, where the centre is in scope.
    fn lipschitz(self, near: f32) -> f32 {
        let lo = min(self.radii.x, min(self.radii.y, self.radii.z))
        let hi = max(self.radii.x, max(self.radii.y, self.radii.z))
        let e = max(near, 0.0) / lo
        if e >= 1.0 {
            return 1.0 / 0.0
        }
        let first = max(2.0 - 1.0 / (1.0 + e), 1.0 / (1.0 - e) - 2.0)
        let r = hi / lo
        (first + e * r * r / (1.0 - e)) * 1.001
    }
}

impl<A: Lipschitz, B: Lipschitz> Lipschitz for Union<A, B> {
    /// The smaller distance's: where it's within `near`, so is the part's.
    fn lipschitz(self, near: f32) -> f32 {
        max(self.a.lipschitz(near), self.b.lipschitz(near))
    }
}

impl<S: Lipschitz, const N: u32> Lipschitz for UnionAll<S, N> {
    fn lipschitz(self, near: f32) -> f32 {
        var l = 0.0
        for i in 0..N {
            l = max(l, self.parts[i].lipschitz(near))
        }
        l
    }
}

impl<S: Lipschitz, const N: u32> Lipschitz for SmoothUnionAll<S, N> {
    /// As `SmoothUnion`'s, with the scope widened by `1.25 k` for each `smin` a part goes
    /// through: at most `N - 1`.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0) * f32(max(N, 1) - 1)
        var l = 0.0
        for i in 0..N {
            l = max(l, self.parts[i].lipschitz(scope))
        }
        l
    }
}

impl<A: Lipschitz, B: Lipschitz> Lipschitz for Intersect<A, B> {
    fn lipschitz(self, near: f32) -> f32 {
        max(self.a.lipschitz(near), self.b.lipschitz(near))
    }
}

impl<A: Lipschitz, B: Lipschitz> Lipschitz for SmoothUnion<A, B> {
    /// `smin`'s gradient mixes its parts' with weights that add up to 1. Where it's within
    /// `near`, the parts are within `near + 1.25 k`: the smaller is at most `k / 4` above it,
    /// and they blend only where they're less than `k` apart.
    fn lipschitz(self, near: f32) -> f32 {
        let scope = near + 1.25 * max(self.k, 0.0)
        max(self.a.lipschitz(scope), self.b.lipschitz(scope))
    }
}

impl<S: Lipschitz> Lipschitz for Translate<S> {
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

impl<S: Lipschitz, N: Noise> Lipschitz for Displace<S, N> {
    /// The inner surface's bound, where it's within `near` plus the displacement's reach, and
    /// the noise's, scaled by the amplitude.
    fn lipschitz(self, near: f32) -> f32 {
        let r = self.noise.range()
        let reach = abs(self.amp) * max(abs(r.lo), abs(r.hi))
        self.inner.lipschitz(near + reach) + abs(self.amp) * self.noise.lipschitz()
    }
}

impl<A: Lipschitz, B: Lipschitz> Lipschitz for SmoothSubtract<A, B> {
    /// A smooth maximum's gradient is a weighted mean of its operands', so the larger bound,
    /// each within `near` plus the blend's reach (`k / 4`).
    fn lipschitz(self, near: f32) -> f32 {
        let n = near + 0.25 * max(self.k, 0.0)
        max(self.a.lipschitz(n), self.b.lipschitz(n))
    }
}

impl<A: Lipschitz, B: Lipschitz> Lipschitz for SmoothIntersect<A, B> {
    fn lipschitz(self, near: f32) -> f32 {
        let n = near + 0.25 * max(self.k, 0.0)
        max(self.a.lipschitz(n), self.b.lipschitz(n))
    }
}

impl<S: Lipschitz> Lipschitz for Rotate<S> {
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

impl<S: Lipschitz> Lipschitz for Scale<S> {
    /// Scaling keeps a gradient's length; `near` is the inner surface's `near / by`.
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near / abs(self.by))
    }
}

impl<S: Lipschitz> Lipschitz for Mirror<S> {
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

impl<S: Lipschitz> Lipschitz for Named<S> {
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

impl<S: Lipschitz, C: Copy + GpuData> Lipschitz for With<S, C> {
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

impl<S: Lipschitz, F: Copy + GpuData> Lipschitz for WithAt<S, F> {
    fn lipschitz(self, near: f32) -> f32 {
        self.inner.lipschitz(near)
    }
}

/// A debug build's check of a stated bound (§13): over the boxes in [-16, 16]³ where the
/// distance can be within ±`near`, refined to boxes about `near` wide, the derived gradient's
/// interval must allow a gradient no longer than `l`. A box whose every gradient is longer
/// panics: `l` understates the gradient there. (A box can only prove a bound wrong, not right,
/// so a bound that's wrong only between the boxes' samples can pass.)
pub fn check_lipschitz<S: Surface>(s: S, near: f32, l: f32) {
    var stack: Vec<Box3> = Vec::new()
    stack.push(Box3 { lo: vec3(-16.0), hi: vec3(16.0) })
    var visited = 0
    while stack.len() > 0 && visited < 20000 {
        visited += 1
        let b = stack.pop().unwrap()
        let d = interval(|q| s.distance(q), b)
        if d.lo >= near || d.hi <= -near {
            continue
        }
        let size = b.hi.x - b.lo.x
        if size > max(near, 1.0 / 64.0) {
            let mid = (b.lo + b.hi) * 0.5
            for i in 0..8 {
                let lo = vec3(
                    if i & 1 == 0 { b.lo.x } else { mid.x },
                    if i & 2 == 0 { b.lo.y } else { mid.y },
                    if i & 4 == 0 { b.lo.z } else { mid.z },
                )
                stack.push(Box3 { lo, hi: lo + (mid - b.lo) })
            }
            continue
        }
        let gx = interval(|q| gradient(|r| s.distance(r), q).x, b)
        let gy = interval(|q| gradient(|r| s.distance(r), q).y, b)
        let gz = interval(|q| gradient(|r| s.distance(r), q).z, b)
        let least = vec3(least_abs(gx), least_abs(gy), least_abs(gz))
        let g = length(least)
        if g > l * 1.001 + 1.0e-6 {
            panic(
                f"a Lipschitz bound of {l} for |distance| < {near} is too small: the derived gradient is at least {g} over the box from ({b.lo.x}, {b.lo.y}, {b.lo.z}) to ({b.hi.x}, {b.hi.y}, {b.hi.z})",
            )
        }
    }
}

/// The least |x| for x in `i`.
fn least_abs(i: Interval) -> f32 {
    if i.lo > 0.0 { i.lo } else if i.hi < 0.0 { -i.hi } else { 0.0 }
}

// ---- channels -----------------------------------------------------------------------------------

/// A surface whose points carry channels `C` besides their distance (D-002): what a point knows
/// about itself, such as its colour or its density. `.with(...)` and `.with_at(...)` give a
/// surface channels, and the combinators blend them where they blend the surfaces.
pub trait Field<C>: Surface {
    /// The channels at `p`.
    fn channels(self, p: vec3) -> C

    /// The distance and the channels at `p` together, with each part of the field evaluated
    /// once: std's combinators blend their parts' channels by their distances, so they compute
    /// both here, and their `channels` is this one's second half. The distance is the same as
    /// `distance(p)`, bit for bit.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        (self.distance(p), self.channels(p))
    }
}

/// How channels mix where surfaces blend. A channel struct declares it and gets it field by
/// field, so each member's type decides how it mixes (D-026).
@fieldwise
pub trait Blend {
    /// `self` where `t` is 0, `other` where it's 1, and a mix between.
    fn blend(self, other: Self, t: f32) -> Self
}

impl Blend for f32 {
    fn blend(self, other: f32, t: f32) -> f32 {
        mix(self, other, t)
    }
}

impl Blend for vec2 {
    fn blend(self, other: vec2, t: f32) -> vec2 {
        mix(self, other, vec2(t))
    }
}

impl Blend for vec3 {
    fn blend(self, other: vec3, t: f32) -> vec3 {
        mix(self, other, vec3(t))
    }
}

impl Blend for vec4 {
    fn blend(self, other: vec4, t: f32) -> vec4 {
        mix(self, other, vec4(t))
    }
}

impl Blend for Quat {
    fn blend(self, other: Quat, t: f32) -> Quat {
        self.nlerp(other, t)
    }
}

/// A colour in linear RGB, which blends linearly.
pub struct Color: Copy + GpuData + Blend + StateHash {
    pub r: f32,
    pub g: f32,
    pub b: f32,
}

/// A colour from linear RGB.
pub fn rgb(r: f32, g: f32, b: f32) -> Color {
    Color { r, g, b }
}

/// A direction, which blends along the sphere: mixed, then made unit length again.
pub struct UnitVec3: Copy + GpuData + StateHash {
    pub v: vec3,
}

/// `v`'s direction.
pub fn unit_vec3(v: vec3) -> UnitVec3 {
    UnitVec3 { v: normalize(v) }
}

impl Blend for UnitVec3 {
    fn blend(self, other: UnitVec3, t: f32) -> UnitVec3 {
        let m = mix(self.v, other.v, vec3(t))
        // Opposite directions mixed half and half cancel: keep the nearer one.
        if dot(m, m) < 1.0e-12 {
            if t < 0.5 { self } else { other }
        } else {
            UnitVec3 { v: normalize(m) }
        }
    }
}

/// A categorical channel, such as a material: never averaged, but taken whole from whichever
/// surface weighs more where two blend (D-026).
pub struct Cat<T>: Copy + GpuData + StateHash {
    pub value: T,
}

/// `value` as a categorical channel.
pub fn cat<T: Copy>(value: T) -> Cat<T> {
    Cat { value }
}

impl<T: Copy> Blend for Cat<T> {
    fn blend(self, other: Cat<T>, t: f32) -> Cat<T> {
        if t <= 0.5 { self } else { other }
    }
}

/// A surface whose points all carry the channels `value`: `.with(...)`.
pub struct With<S, C>: Copy + GpuData {
    pub inner: S,
    pub value: C,
}

impl<S: Surface, C: Copy + GpuData> Surface for With<S, C> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

impl<S: Surface, C: Copy + GpuData> Field<C> for With<S, C> {
    fn channels(self, p: vec3) -> C {
        self.value
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        (self.inner.distance(p), self.value)
    }
}

/// A surface whose channels a function computes at each point: `.with_at(...)`.
pub struct WithAt<S, F>: Copy + GpuData {
    pub inner: S,
    pub at: F,
}

impl<S: Surface, F: Copy + GpuData> Surface for WithAt<S, F> {
    fn distance(self, p: vec3) -> f32 {
        self.inner.distance(p)
    }

    fn filtered(self, p: vec3, footprint: f32) -> f32 {
        self.inner.filtered(p, footprint)
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        self.inner.part_offset(p, i, by)
    }

    fn parts(self) -> u32 {
        self.inner.parts()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        self.inner.part_at(p)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        self.inner.part_distance(p, i)
    }

    fn part_name(self, i: u32) -> PartName {
        self.inner.part_name(i)
    }
}

impl<S: Surface, C, F: Copy + GpuData + fn(vec3) -> C> Field<C> for WithAt<S, F> {
    fn channels(self, p: vec3) -> C {
        (self.at)(p)
    }
}

/// How much of `b` a smooth union of distances `a` and `b` takes, from 0 to 1: the weight
/// `smin`'s gradient gives `b`'s, which a field's channels blend by too.
pub fn smin_weight(a: f32, b: f32, k: f32) -> f32 {
    let m = max(k - select(if_false: abs(a - b), if_true: 0.0, cond: a == b), 0.0)
    let w = m * (0.5 / max(k, 1.1754944e-38))
    if a < b { w } else { 1.0 - w }
}

// The combinators evaluate each part once, for its distance and its channels together: asking
// each part for its channels after its distance would evaluate a chain of n blended parts
// O(n²) times.

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for Union<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The nearer part's channels; a tie takes `a`'s.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (min(da, db), if da <= db { ca } else { cb })
    }
}

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for SmoothUnion<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The parts' channels blended by `smin_weight`.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (smin(da, db, self.k), ca.blend(cb, smin_weight(da, db, self.k)))
    }
}

impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for Intersect<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    /// The farther part's channels; a tie takes `a`'s.
    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (max(da, db), if da >= db { ca } else { cb })
    }
}

impl<C, S: Field<C>> Field<C> for Translate<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p - self.by)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(p - self.by)
    }
}

impl<C, S: Field<C>, N: Noise> Field<C> for Displace<S, N> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p)
        (d + self.amp * self.noise.value(p), c)
    }
}

/// The nearest part's channels; a tie takes the earlier part's, as `a.union(b)` does. A union
/// of no parts has no channels: asking for them indexes past the end (§11).
impl<C: Blend, S: Field<C>, const N: u32> Field<C> for UnionAll<S, N> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d0, c0) = self.parts[0].distance_and_channels(p)
        // The same `min`s, in the same order, as `distance`.
        var d = min(EMPTY, d0)
        var c = take c0
        for i in 1..N {
            let (di, ci) = self.parts[i].distance_and_channels(p)
            if di < d {
                c = take ci
            }
            d = min(d, di)
        }
        (d, c)
    }
}

/// The parts' channels blended in order, each by `smin_weight`, as `a.smooth_union(b, k)
/// .smooth_union(c, k)` blends them. A union of no parts has no channels: asking for them
/// indexes past the end (§11).
impl<C: Blend, S: Field<C>, const N: u32> Field<C> for SmoothUnionAll<S, N> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d0, c0) = self.parts[0].distance_and_channels(p)
        var d = d0
        var c = take c0
        for i in 1..N {
            let (di, ci) = self.parts[i].distance_and_channels(p)
            c = c.blend(ci, smin_weight(d, di, self.k))
            d = smin(d, di, self.k)
        }
        (d, c)
    }
}

/// `a`'s channels: the cut takes away, and its face is `a`'s.
impl<C, A: Field<C>, B: Surface> Field<C> for SmoothSubtract<A, B> {
    fn channels(self, p: vec3) -> C {
        self.a.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        (smax(da, -self.b.distance(p), self.k), ca)
    }
}

/// The operands' channels blended as the smooth maximum weighs them.
impl<C: Blend, A: Field<C>, B: Field<C>> Field<C> for SmoothIntersect<A, B> {
    fn channels(self, p: vec3) -> C {
        self.distance_and_channels(p).1
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (da, ca) = self.a.distance_and_channels(p)
        let (db, cb) = self.b.distance_and_channels(p)
        (smax(da, db, self.k), ca.blend(cb, smin_weight(-da, -db, self.k)))
    }
}

impl<C, S: Field<C>> Field<C> for Rotate<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(self.local(p))
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(self.local(p))
    }
}

impl<C, S: Field<C>> Field<C> for Scale<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p / self.by)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        let (d, c) = self.inner.distance_and_channels(p / self.by)
        (d * self.by, c)
    }
}

impl<C, S: Field<C>> Field<C> for Mirror<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(mirrored(p))
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(mirrored(p))
    }
}

impl<C, S: Field<C>> Field<C> for Named<S> {
    fn channels(self, p: vec3) -> C {
        self.inner.channels(p)
    }

    fn distance_and_channels(self, p: vec3) -> (f32, C) {
        self.inner.distance_and_channels(p)
    }
}

// ---- tests (the suite runs std's: `std_tests_pass`) --------------------------------------------

/// A blob of every primitive, smooth-unioned, and displaced by noise: what std's field tests
/// check.
fn test_blob() -> Lipschitz {
    let body = ellipsoid(vec3(1.0, 0.6, 0.8))
    let limb = round_cone(vec3(0.5, -0.2, 0.0), vec3(1.4, 0.6, 0.2), r_top: 0.15, r_bottom: 0.3)
    let block = cuboid(vec3(0.3)).translate(vec3(-0.9, 0.4, 0.1))
    body.smooth_union(limb, k: 0.2).smooth_union(block, k: 0.1).displace(fbm(4.0, 3), amp: 0.01)
}

@test
fn derived_gradients_agree_with_finite_differences() {
    let f = test_blob()
    let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    let h = 1.0e-3
    for i in 0..256 {
        let p = b.sample(1, i)
        let g = gradient(|q: vec3| f.distance(q), p)
        let dx = f.distance(p + vec3(x: h)) - f.distance(p - vec3(x: h))
        let dy = f.distance(p + vec3(y: h)) - f.distance(p - vec3(y: h))
        let dz = f.distance(p + vec3(z: h)) - f.distance(p - vec3(z: h))
        let off = length(g - vec3(dx, dy, dz) / (2.0 * h))
        assert(off < 0.02, f"at ({p.x}, {p.y}, {p.z})")
    }
}

@test
fn derived_intervals_enclose_the_distances_in_their_boxes() {
    let f = test_blob()
    let space = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    for i in 0..64 {
        let c = space.sample(2, i)
        let b = Box3 { lo: c - vec3(0.1), hi: c + vec3(0.1) }
        let r = interval(|q: vec3| f.distance(q), b)
        for j in 0..16 {
            let d = f.distance(b.sample(3, j))
            assert(r.lo <= d && d <= r.hi, f"a box at ({c.x}, {c.y}, {c.z})")
        }
    }
}

@test
fn stated_bounds_hold_near_the_surface() {
    let f = test_blob()
    let near = 0.1
    let l = f.lipschitz(near)
    let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    var checked = 0
    for i in 0..4096 {
        let p = b.sample(4, i)
        if abs(f.distance(p)) < near {
            checked += 1
            let g = length(gradient(|q: vec3| f.distance(q), p))
            assert(g <= l, f"at ({p.x}, {p.y}, {p.z})")
        }
    }
    assert(checked > 50, "too few samples near the surface")
}

/// A body, a knob and its mirror image, and a cut: four parts, each found where it decides the
/// distance, with the distance `distance` gives.
fn test_parts() -> Surface {
    let knob = sphere(0.2).translate(vec3(0.6, 0.0, 0.0)).named("knob").mirror_x()
    sphere(0.5)
        .named("body")
        .smooth_union(knob, k: 0.05)
        .smooth_subtract(
            cuboid(half: vec3(0.1)).translate(vec3(0.0, 0.5, 0.0)).named("notch"),
            k: 0.02,
        )
}

@test
fn each_part_is_found_where_it_decides_the_distance() {
    let s = test_parts()
    assert(s.parts() == 4)
    let at = |p: vec3| s.part_at(p).1
    assert(at(vec3(0.0, -0.3, 0.0)) == 0)
    assert(at(vec3(0.7, 0.0, 0.0)) == 1)
    assert(at(vec3(-0.7, 0.0, 0.0)) == 2)
    assert(at(vec3(0.0, 0.45, 0.0)) == 3)
    assert(s.part_name(1).name == "knob" && !s.part_name(1).mirrored)
    assert(s.part_name(2).name == "knob" && s.part_name(2).mirrored)
    assert(s.part_name(3).name == "notch")
    // The image's own distance is the knob's, reflected.
    let p = vec3(-0.75, 0.1, 0.05)
    assert(abs(s.part_distance(p, 2) - s.part_distance(vec3(0.75, 0.1, 0.05), 1)) < 1.0e-6)
    let b = Box3 { lo: vec3(-1.0), hi: vec3(1.0) }
    for i in 0..1024 {
        let q = b.sample(5, i)
        assert(s.part_at(q).0 == s.distance(q), f"at ({q.x}, {q.y}, {q.z})")
    }
}

@test
fn a_part_shares_the_distance_where_it_decides_it_and_in_its_blends() {
    let s = test_parts()
    // On the body, away from the knobs and the notch: the body alone.
    let low = vec3(0.0, -0.5, 0.0)
    assert(abs(part_share(s, low, 0) - 1.0) < 1.0e-3)
    for i in 1..4 {
        assert(part_share(s, low, i) == 0.0, f"part {i}")
    }
    // The knob as written decides at x > 0, its image at x < 0.
    let knob = vec3(0.8, 0.0, 0.0)
    assert(abs(part_share(s, knob, 1) - 1.0) < 1.0e-3)
    assert(part_share(s, knob, 2) == 0.0)
    assert(part_share(s, vec3(-0.8, 0.0, 0.0), 2) > 0.999)
    // Where the knob meets the body (the circle where both spheres' surfaces cross), within
    // the blend's width, both share it.
    let seam = vec3(0.475, 0.156, 0.0)
    let (a, k) = (part_share(s, seam, 0), part_share(s, seam, 1))
    assert(a > 0.0 && a < 1.0 && k > 0.0 && k < 1.0, f"body {a}, knob {k}")
    assert(abs(a + k - 1.0) < 1.0e-2)
    // Raising a part where it decides raises the distance as much.
    assert(abs(s.part_offset(low, 0, by: 0.01) - (s.distance(low) + 0.01)) < 1.0e-6)
    // Scaled, an offset is in the scaled surface's units.
    let big = s.scale(2.0)
    assert(abs(big.part_offset(2.0 * low, 0, by: 0.01) - (big.distance(2.0 * low) + 0.01)) < 1.0e-6)
}

@test
fn certified_checks_prove_what_holds_and_find_what_fails() {
    let below = Box3 { lo: vec3(-2.0, -1.0, -2.0), hi: vec3(2.0, 0.0, 2.0) }
    // Clear of the ground: proved.
    let up = sphere(0.5).translate(vec3(0.0, 0.6, 0.0))
    assert(certify_clear(up, below, depth: 6).holds())
    // Sunk 10 cm: a point below the ground inside it.
    let sunk = sphere(0.5).translate(vec3(0.0, 0.4, 0.0))
    match certify_clear(sunk, below, depth: 6) {
        Certified::Fails(p) => assert(
            p.y <= 0.0 && sunk.distance(p) <= 0.0,
            f"at ({p.x}, {p.y}, {p.z})",
        ),
        _ => assert(false, "a sunk sphere is found"),
    }
    // Touching the ground at a point: no interval can prove it clear, and no point fails.
    let touching = sphere(0.5).translate(vec3(0.0, 0.5, 0.0))
    match certify_clear(touching, below, depth: 5) {
        Certified::Unknown(b) => assert(
            b.lo.y < 0.0001 && b.hi.y > -0.5,
            "the box is at the touch",
        ),
        Certified::Holds => assert(false, "a touching sphere isn't proved clear"),
        Certified::Fails(p) => assert(false, f"no point is inside: ({p.x}, {p.y}, {p.z})"),
    }
    // Two parts apart, and two that overlap.
    let pair = sphere(0.3).named("a").union(sphere(0.3).translate(vec3(1.0, 0.0, 0.0)).named("b"))
    let around = Box3 { lo: vec3(-1.0), hi: vec3(2.0, 1.0, 1.0) }
    assert(certify_apart(pair, a: 0, b: 1, region: around, depth: 6).holds())
    let close = sphere(0.3).named("a").union(sphere(0.3).translate(vec3(0.5, 0.0, 0.0)).named("b"))
    match certify_apart(close, a: 0, b: 1, region: around, depth: 6) {
        Certified::Fails(p) => assert(
            close.part_distance(p, 0) <= 0.0 && close.part_distance(p, 1) <= 0.0,
        ),
        _ => assert(false, "overlapping parts are found"),
    }
}
