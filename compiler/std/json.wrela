// JSON, read (RFC 8259): a document read into an arena of nodes, each found by its index; a
// number keeps the text it was written with, so an answer a program passes on reads as it was
// written, and `number_of` reads it as the nearest f64. Strings are UTF-8, JSON's escapes and
// surrogate pairs unescaped; a raw control character, another escape, a number outside JSON's
// grammar (`+1`, `01`, `.5`, `5.`) or past an f64's range, and nesting deeper than `MOST_DEPTH`
// are malformed. A malformed document is `None`, never a panic. Reading a node borrows it, so a
// walk over a document allocates nothing. `std::fmt`'s `json_text` and `json_number` write JSON.

use std::collections::Vec
use std::fmt::json_text
use std::string::String
use std::string::parse_f64_at

/// What a node is.
pub enum Kind: Copy + Eq {
    Null,
    Bool,
    Num,
    Text,
    List,
    Obj,
}

/// A value of a document: its kind, its text (a number's as written, a text's unescaped, a
/// bool's `true` or `false`), and a list's or an object's members (each a node's index, and for
/// an object its key).
struct Node: Clone {
    kind: Kind,
    text: String,
    keys: Vec<String>,
    kids: Vec<u32>,
}

/// A JSON document: its values, the first of them its top.
pub struct Doc: Clone {
    nodes: Vec<Node>,
}

/// The top of a document.
pub const TOP: u32 = 0

/// How deeply lists and objects may nest: the top is at depth 0, so a document holds at most
/// `MOST_DEPTH + 1` brackets one inside another.
pub const MOST_DEPTH: u32 = 64

/// The document `text` holds, or `None` if it isn't one JSON value.
pub fn parse(text: str) -> Option<Doc> {
    var d = Doc { nodes: Vec::new() }
    var at = 0
    value(mut d, text, mut at, 0)?
    at = blanks(text, at)
    if at != text.len() {
        return None
    }
    Some(d)
}

fn blanks(t: str, at: u32) -> u32 {
    var i = at
    while i < t.len() {
        let b = t.byte(i)
        if b != 32 && b != 9 && b != 10 && b != 13 {
            break
        }
        i += 1
    }
    i
}

fn node(d: mut Doc, kind: Kind, text: take String) -> u32 {
    let i = d.nodes.len()
    d.nodes.push(Node { kind, text, keys: Vec::new(), kids: Vec::new() })
    i
}

/// Reads one value of `t` from `at` into `d`: its node's index.
fn value(d: mut Doc, t: str, at: mut u32, depth: u32) -> Option<u32> {
    if depth > MOST_DEPTH {
        return None
    }
    at = blanks(t, at)
    if at >= t.len() {
        return None
    }
    let b = t.byte(at)
    if b == 123 {
        let me = node(mut d, Kind::Obj, String::new())
        at += 1
        at = blanks(t, at)
        if at < t.len() && t.byte(at) == 125 {
            at += 1
            return Some(me)
        }
        loop {
            at = blanks(t, at)
            let key = string(t, mut at)?
            at = blanks(t, at)
            if at >= t.len() || t.byte(at) != 58 {
                return None
            }
            at += 1
            let kid = value(mut d, t, mut at, depth + 1)?
            d.nodes[me].keys.push(take key)
            d.nodes[me].kids.push(kid)
            at = blanks(t, at)
            if at >= t.len() {
                return None
            }
            if t.byte(at) == 44 {
                at += 1
            } else if t.byte(at) == 125 {
                at += 1
                return Some(me)
            } else {
                return None
            }
        }
    }
    if b == 91 {
        let me = node(mut d, Kind::List, String::new())
        at += 1
        at = blanks(t, at)
        if at < t.len() && t.byte(at) == 93 {
            at += 1
            return Some(me)
        }
        loop {
            let kid = value(mut d, t, mut at, depth + 1)?
            d.nodes[me].kids.push(kid)
            at = blanks(t, at)
            if at >= t.len() {
                return None
            }
            if t.byte(at) == 44 {
                at += 1
            } else if t.byte(at) == 93 {
                at += 1
                return Some(me)
            } else {
                return None
            }
        }
    }
    if b == 34 {
        let s = string(t, mut at)?
        return Some(node(mut d, Kind::Text, take s))
    }
    for (word, kind) in [("true", Kind::Bool), ("false", Kind::Bool), ("null", Kind::Null)] {
        if t.slice(at, t.len()).starts_with(word) {
            at += word.len()
            return Some(node(mut d, kind, String::from(word)))
        }
    }
    let start = at
    at = number_end(t, at)?
    let text = t.slice(start, at)
    number_of(text)?
    Some(node(mut d, Kind::Num, String::from(text)))
}

fn digit(b: u8) -> bool {
    b >= 48 && b <= 57
}

/// Where the JSON number at `at` of `t` ends (`-? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]?
/// [0-9]+)?`), or `None` if none starts there.
fn number_end(t: str, at: u32) -> Option<u32> {
    let n = t.len()
    var i = at
    if i < n && t.byte(i) == 45 {
        i += 1
    }
    if i >= n || !digit(t.byte(i)) {
        return None
    }
    if t.byte(i) == 48 {
        i += 1
    } else {
        while i < n && digit(t.byte(i)) {
            i += 1
        }
    }
    if i < n && t.byte(i) == 46 {
        i += 1
        if i >= n || !digit(t.byte(i)) {
            return None
        }
        while i < n && digit(t.byte(i)) {
            i += 1
        }
    }
    if i < n && (t.byte(i) == 101 || t.byte(i) == 69) {
        i += 1
        if i < n && (t.byte(i) == 43 || t.byte(i) == 45) {
            i += 1
        }
        if i >= n || !digit(t.byte(i)) {
            return None
        }
        while i < n && digit(t.byte(i)) {
            i += 1
        }
    }
    Some(i)
}

/// The number the four hex digits of `t` at `at` spell.
fn hex4(t: str, at: u32) -> Option<u32> {
    var cp = 0
    for k in 0..4 {
        let h = t.byte(at + k)
        let v = if h >= 48 && h <= 57 {
            u32(h - 48)
        } else if h >= 97 && h <= 102 {
            u32(h - 87)
        } else if h >= 65 && h <= 70 {
            u32(h - 55)
        } else {
            return None
        }
        cp = cp * 16 + v
    }
    Some(cp)
}

/// A JSON string of `t` at `at` (its opening quote), unescaped; `at` moves past its end.
fn string(t: str, at: mut u32) -> Option<String> {
    if at >= t.len() || t.byte(at) != 34 {
        return None
    }
    at += 1
    var out = String::new()
    while at < t.len() {
        let b = t.byte(at)
        if b == 34 {
            at += 1
            return Some(out)
        }
        if b == 92 {
            if at + 1 >= t.len() {
                return None
            }
            let e = t.byte(at + 1)
            at += 2
            if e == 34 || e == 92 || e == 47 {
                out.push_byte(e)
            } else if e == 110 {
                out.push_byte(10)
            } else if e == 116 {
                out.push_byte(9)
            } else if e == 114 {
                out.push_byte(13)
            } else if e == 98 {
                out.push_byte(8)
            } else if e == 102 {
                out.push_byte(12)
            } else if e == 117 {
                if at + 4 > t.len() {
                    return None
                }
                var cp = hex4(t, at)?
                at += 4
                if cp >= 55296 && cp < 57344 {
                    // A surrogate: the high half, then `\u` and the low half.
                    if cp >= 56320 ||
                        at + 6 > t.len() ||
                        t.byte(at) != 92 ||
                        t.byte(at + 1) != 117 {
                        return None
                    }
                    let low = hex4(t, at + 2)?
                    if low < 56320 || low >= 57344 {
                        return None
                    }
                    cp = 65536 + ((cp - 55296) << 10) + (low - 56320)
                    at += 6
                }
                out.push_char(cp)
            } else {
                // Not one of JSON's escapes.
                return None
            }
            continue
        }
        if b < 32 {
            // A raw control character: JSON writes it escaped.
            return None
        }
        if b >= 128 {
            // A character of more than a byte, as it's written.
            let (cp, len) = t.char_at(at)?
            out.push_char(cp)
            at += len
            continue
        }
        out.push_byte(b)
        at += 1
    }
    None
}

/// The number a JSON number's text spells, as the nearest `f64`, or `None` if it isn't one (or
/// is past an f64's range).
pub fn number_of(text: str) -> Option<f64> {
    if number_end(text, 0) != Some(text.len()) {
        return None
    }
    let owned = String::from(text)
    parse_f64_at(owned.as_bytes(), 0, text.len())
}

impl Doc {
    /// What node `n` is.
    pub fn kind(self, n: u32) -> Kind {
        self.nodes[n].kind
    }

    /// Member `key` of object `n`, if it has one.
    pub fn get(self, n: u32, key: str) -> Option<u32> {
        borrow o = self.nodes[n]
        if o.kind != Kind::Obj {
            return None
        }
        for k in 0..o.keys.len() {
            if o.keys[k].as_str() == key {
                return Some(o.kids[k])
            }
        }
        None
    }

    /// Element `i` of list `n`, if it has one.
    pub fn at(self, n: u32, i: u32) -> Option<u32> {
        borrow o = self.nodes[n]
        if o.kind != Kind::List || i >= o.kids.len() {
            return None
        }
        Some(o.kids[i])
    }

    /// How many elements list `n` has (0 if it isn't one).
    pub fn count(self, n: u32) -> u32 {
        if self.nodes[n].kind == Kind::List { self.nodes[n].kids.len() } else { 0 }
    }

    /// Number `n`'s value, if it's a number.
    pub fn num(self, n: u32) -> Option<f64> {
        if self.nodes[n].kind != Kind::Num {
            return None
        }
        // Its text is a JSON number already: read where it is.
        borrow text = self.nodes[n].text
        parse_f64_at(text.as_bytes(), 0, text.len())
    }

    /// Text `n`'s text, if it's a text.
    pub fn text(self, n: u32) -> Option<String> {
        if self.nodes[n].kind != Kind::Text {
            return None
        }
        Some(self.nodes[n].text.clone())
    }

    /// Whether `n` is `true`.
    pub fn is_true(self, n: u32) -> bool {
        self.nodes[n].kind == Kind::Bool && self.nodes[n].text.as_str() == "true"
    }

    /// Node `n` written as JSON, compact, its numbers as they were written.
    pub fn write(self, n: u32) -> String {
        var out = String::new()
        self.write_into(n, mut out)
        out
    }

    fn write_into(self, n: u32, out: mut String) {
        borrow o = self.nodes[n]
        match o.kind {
            Kind::Null => out.push_str("null"),
            Kind::Bool | Kind::Num => out.push_str(o.text.as_str()),
            Kind::Text => {
                out.push_str("\"")
                json_text(mut out, o.text.as_str())
                out.push_str("\"")
            },
            Kind::List => {
                out.push_str("[")
                for k in 0..o.kids.len() {
                    if k > 0 {
                        out.push_str(",")
                    }
                    self.write_into(o.kids[k], mut out)
                }
                out.push_str("]")
            },
            Kind::Obj => {
                out.push_str("{")
                for k in 0..o.kids.len() {
                    if k > 0 {
                        out.push_str(",")
                    }
                    out.push_str("\"")
                    json_text(mut out, o.keys[k].as_str())
                    out.push_str("\":")
                    self.write_into(o.kids[k], mut out)
                }
                out.push_str("}")
            },
        }
    }
}

fn d_text(d: Doc, i: u32) -> Option<String> {
    d.text(d.at(TOP, i)?)
}

@test
fn a_document_reads_back_as_it_was_written() {
    let text = "{\"a\": [1, 2.50, -3e-2], \"b\": {\"c\": \"x\\\"y\\u00e9\"}, \"d\": true, \"e\": null}"
    let Some(d) = parse(text) else { panic("a document") }
    let Some(a) = d.get(TOP, "a") else { panic("a") }
    assert(d.count(a) == 3)
    let Some(second) = d.at(a, 1) else { panic("a[1]") }
    assert(d.num(second) == Some(2.5))
    let Some(third) = d.at(a, 2) else { panic("a[2]") }
    let Some(x) = d.num(third) else { panic("a number") }
    assert(abs(x + 0.03) < 1e-12)
    let Some(b) = d.get(TOP, "b") else { panic("b") }
    let Some(c) = d.get(b, "c") else { panic("c") }
    let Some(s) = d.text(c) else { panic("text") }
    assert(s.as_str() == "x\"yé")
    let Some(t) = d.get(TOP, "d") else { panic("d") }
    assert(d.is_true(t))
    assert(
        d.write(TOP).as_str() ==
            "{\"a\":[1,2.50,-3e-2],\"b\":{\"c\":\"x\\\"yé\"},\"d\":true,\"e\":null}",
    )
    // Characters past ASCII, as written and escaped, a surrogate pair's too.
    let Some(u) = parse("[\"Gymnopédie\", \"\\ud834\\udd1e\"]") else { panic("UTF-8") }
    let Some(gym) = d_text(u, 0) else { panic("a title") }
    assert(gym.as_str() == "Gymnopédie")
    let Some(clef) = d_text(u, 1) else { panic("a clef") }
    assert(clef.as_str() == "𝄞")
    for bad in ["", "{", "[1,]", "{\"a\" 1}", "1 2", "\"open", "-", "tru", "\"\\ud834\""] {
        assert(parse(bad).is_none(), bad)
    }
}

@test
fn malformed_documents_are_none_and_never_trap() {
    // An escape of a character past ASCII (bytes 34, 92, 195, 169, 34), and other escapes JSON
    // hasn't, in a value and in a key.
    let bad = [
        "\"\\é\"",
        "\"\\x\"",
        "\"\\a\"",
        "\"\\0\"",
        "{\"\\q\": 1}",
        "{\"k\\é\": 1}",
        // Raw control characters, in a value and in a key.
        "\"a\tb\"",
        "\"a\nb\"",
        // Numbers outside JSON's grammar.
        "+1",
        "01",
        "-01",
        ".5",
        "5.",
        "1.",
        "1e",
        "1e+",
        "-",
        "--1",
        "1.e5",
        "0x10",
        "[+1]",
        "{\"a\": 01}",
        // Past an f64's range.
        "1e400",
        // A lone or reversed surrogate, and a short `\u`.
        "\"\\udd1e\\ud834\"",
        "\"\\u12\"",
    ]
    for text in bad {
        assert(parse(text).is_none(), text)
    }
    // A control character inside a key.
    var key = String::from("{\"a")
    key.push_char(1)
    key.push_str("b\": 1}")
    assert(parse(key.as_str()).is_none(), "a control in a key")
    for n in ["+1", "01", ".5", "5.", "1.", "1e400", "1 "] {
        assert(number_of(n).is_none(), n)
    }
}

@test
fn valid_documents_read_as_json_says() {
    let good: [(Text, f64); 8] = [
        ("0", 0.0),
        ("-0", -0.0),
        ("0.5", 0.5),
        ("-12.25e+2", -1225.0),
        ("1E-3", 0.001),
        ("10e2", 1000.0),
        ("123456789", 123456789.0),
        ("2.5E0", 2.5),
    ]
    for (text, want) in good {
        let Some(d) = parse(text) else { panic(text) }
        assert(d.num(TOP) == Some(want), text)
        assert(number_of(text) == Some(want), text)
    }
    // Every escape JSON has, controls escaped, `\u` escapes and a surrogate pair.
    let Some(d) = parse("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0001\\u00e9\\ud834\\udd1e\"") else {
        panic("escapes")
    }
    let Some(s) = d.text(TOP) else { panic("a text") }
    var want = String::from("\"\\/")
    for c in [8, 12, 10, 13, 9, 1] {
        want.push_char(c)
    }
    want.push_str("é𝄞")
    assert(s.as_str() == want.as_str(), s.as_str())
}

/// `depth` lists, one inside another.
fn nested(depth: u32) -> String {
    var s = String::new()
    for _ in 0..depth {
        s.push_str("[")
    }
    for _ in 0..depth {
        s.push_str("]")
    }
    s
}

@test
fn nesting_stops_at_its_limit() {
    assert(parse(nested(MOST_DEPTH + 1).as_str()).is_some(), "the most brackets")
    assert(parse(nested(MOST_DEPTH + 2).as_str()).is_none(), "one more")
}

/// A list of `n` numbers, and the allocations of a walk over it, four times: each element
/// found and its kind read, and the list found by its key; then of reading each number.
fn walk_allocates(n: u32) -> (u32, u32) {
    var text = String::from("{\"a\": 1, \"list\": [")
    for i in 0..n {
        if i > 0 {
            text.push_str(",")
        }
        text.push_str(f"{i}")
    }
    text.push_str("]}")
    let Some(d) = parse(text.as_str()) else { panic("a list") }
    let before = std::alloc::allocations()
    var numbers = 0
    for _ in 0..4 {
        let Some(list) = d.get(TOP, "list") else { panic("the list") }
        for i in 0..d.count(list) {
            let Some(e) = d.at(list, i) else { panic("an element") }
            if d.kind(e) == Kind::Num {
                numbers += 1
            }
        }
    }
    let walked = std::alloc::allocations() - before
    assert(numbers == 4 * n)
    let Some(list) = d.get(TOP, "list") else { panic("the list") }
    let start = std::alloc::allocations()
    var sum = 0.0
    for i in 0..n {
        let Some(e) = d.at(list, i) else { panic("an element") }
        sum += d.num(e).unwrap_or(0.0)
    }
    assert(sum == f64(n) * f64(n - 1) / 2.0)
    (walked, std::alloc::allocations() - start)
}

@test
fn walking_a_document_allocates_nothing() {
    // Each lookup borrows its node: a walk costs its elements, not their copies, at any size;
    // reading a number allocates at most its digits, once.
    let (w1, r1) = walk_allocates(100)
    let (w4, r4) = walk_allocates(400)
    assert(w1 == 0 && w4 == 0, f"walks allocated {w1} and {w4}")
    assert(r1 <= 100 && r4 <= 400, f"reading numbers allocated {r1} and {r4}")
}
