impl Serialize for String {
    fn serialize(self, w: mut Writer) {
        w.write_str(self)
    }

    fn deserialize(r: mut Reader) -> Result<String, LoadError> {
        r.read_string()
    }
}

impl<T: Serialize> Serialize for Vec<T> {
    fn serialize(self, w: mut Writer) {
        w.write_u32(self.len())
        for x in self {
            x.serialize(mut w)
        }
    }

    fn deserialize(r: mut Reader) -> Result<Vec<T>, LoadError> {
        let at = r.at
        let n = r.read_u32()?
        // Each element takes at least a byte: a count past that is a corrupt save, not a reason
        // to allocate.
        if n > r.left() {
            return Err(LoadError { at, what: "a count is larger than the bytes left" })
        }
        var out = Vec::with_capacity(n)
        for _ in 0..n {
            out.push(T::deserialize(mut r)?)
        }
        Ok(out)
    }
}

/// The elements in use, as a `Vec`'s are: a `u32` count, then each.
impl<T: Serialize + Copy, const N: u32> Serialize for Bounded<T, N> {
    fn serialize(self, w: mut Writer) {
        w.write_u32(self.len())
        for x in self {
            x.serialize(mut w)
        }
    }

    fn deserialize(r: mut Reader) -> Result<Bounded<T, N>, LoadError> {
        let at = r.at
        let n = r.read_u32()?
        if n > N {
            return Err(LoadError { at, what: "more elements than the `Bounded` holds" })
        }
        var out = Bounded::new()
        for _ in 0..n {
            out.push(T::deserialize(mut r)?)
        }
        Ok(out)
    }
}

impl<T: Serialize> Serialize for Box<T> {
    fn serialize(self, w: mut Writer) {
        self.get().serialize(mut w)
    }

    fn deserialize(r: mut Reader) -> Result<Box<T>, LoadError> {
        Ok(Box::new(T::deserialize(mut r)?))
    }
}
