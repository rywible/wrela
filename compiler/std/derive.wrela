// Gradients and interval bounds of functions, which the compiler derives from each function's
// body (language.md §14), and the ranges and boxes they work over. Any function that qualifies
// has them; nothing here is specific to fields.

/// A closed range `[lo, hi]` of `f32` values.
pub struct Interval: Copy + GpuData {
    pub lo: f32,
    pub hi: f32,
}

impl Interval {
    /// Whether `x` is in the range, ends included.
    pub fn contains(self, x: f32) -> bool {
        self.lo <= x && x <= self.hi
    }

    /// `hi - lo`.
    pub fn width(self) -> f32 {
        self.hi - self.lo
    }

    /// Point `i` of a sequence that spreads evenly through the range: `seed` chooses the
    /// sequence. For checking a property at many points: `for i in 0..n { let x =
    /// range.sample(seed, i) ... }`. The same `seed` and `i` give the same point everywhere.
    /// The first 2ⁿ points split evenly when the range is halved, and halved again, up to n
    /// times (`sobol`).
    pub fn sample(self, seed: u32, i: u32) -> f32 {
        self.lo + (self.hi - self.lo) * sobol(seed, 0, i)
    }
}

/// An axis-aligned box in 2D.
pub struct Box2: Copy + GpuData {
    pub lo: vec2,
    pub hi: vec2,
}

/// An axis-aligned box in 3D.
pub struct Box3: Copy + GpuData {
    pub lo: vec3,
    pub hi: vec3,
}

impl Box2 {
    /// Point `i` of a sequence that spreads evenly through the box: `seed` chooses the sequence
    /// (`Interval::sample`).
    pub fn sample(self, seed: u32, i: u32) -> vec2 {
        let t = vec2(sobol(seed, 0, i), sobol(seed, 1, i))
        self.lo + (self.hi - self.lo) * t
    }
}

impl Box3 {
    /// Point `i` of a sequence that spreads evenly through the box: `seed` chooses the sequence
    /// (`Interval::sample`). For checking a field at many points:
    ///
    /// ```wrela
    /// use std::derive::{Box3, gradient}
    /// use std::field::{Surface, sphere}
    ///
    /// fn gradients_are_unit() -> bool {
    ///     let ball = sphere(1.0)
    ///     let b = Box3 { lo: vec3(-2.0), hi: vec3(2.0) }
    ///     for i in 0..64 {
    ///         let p = b.sample(7, i)
    ///         if abs(length(gradient(|q: vec3| ball.distance(q), p)) - 1.0) > 1.0e-4 {
    ///             return false
    ///         }
    ///     }
    ///     true
    /// }
    /// ```
    pub fn sample(self, seed: u32, i: u32) -> vec3 {
        let t = vec3(sobol(seed, 0, i), sobol(seed, 1, i), sobol(seed, 2, i))
        self.lo + (self.hi - self.lo) * t
    }
}

/// Point `i` of Sobol's sequence on `axis` (0, 1 or 2), in [0, 1), with the axis shifted by
/// XOR with a hash of `seed` (a digital shift, which keeps how evenly the points spread). The
/// first 2ⁿ points split evenly among the cells of a box cut in halves along each axis, as
/// many times as the sequence allows: 4096 points put 8 in each of 8 × 8 × 8 cells. The same
/// bits on the CPU and the GPU.
fn sobol(seed: u32, axis: u32, i: u32) -> f32 {
    var x: u32 = 0
    // Direction number b is m(b) << (31 - b), m from the axis's primitive polynomial: none
    // (axis 0), x + 1 and x² + x + 1, with m(0) = 1 and m(1) = 3.
    var m1: u32 = 1
    var m2: u32 = 0
    for b in 0..32 {
        if i >> b == 0 {
            break
        }
        var m: u32 = 1
        if axis == 1 && b > 0 {
            m = (m1 << 1) ^ m1
        } else if axis == 2 && b == 1 {
            m = 3
        } else if axis == 2 && b > 1 {
            m = (m1 << 1) ^ (m2 << 2) ^ m2
        }
        m2 = m1
        m1 = m
        if (i >> b) & 1 == 1 {
            x = x ^ (if axis == 0 { 1 } else { m }) << (31 - b)
        }
    }
    f32((x ^ scramble(seed.wrapping_mul(4).wrapping_add(axis))) >> 8) * (1.0 / 16777216.0)
}

/// A 32-bit integer hash (`lowbias32`).
fn scramble(x: u32) -> u32 {
    var h = x ^ (x >> 16)
    h = h.wrapping_mul(2146121005)
    h = h ^ (h >> 15)
    h = h.wrapping_mul(2221713035)
    h ^ (h >> 16)
}

/// An axis-aligned box in 4D.
pub struct Box4: Copy + GpuData {
    pub lo: vec4,
    pub hi: vec4,
}

/// What a derived function can take: `f32` and the float vectors, each with its box type.
pub trait Domain {
    type Box
}

impl Domain for f32 {
    type Box = Interval
}

impl Domain for vec2 {
    type Box = Box2
}

impl Domain for vec3 {
    type Box = Box3
}

impl Domain for vec4 {
    type Box = Box4
}

/// The gradient of `f` at `at`, by forward-mode differentiation of `f`'s body.
@intrinsic
pub fn gradient<X: Domain>(f: fn(X) -> f32, at: X) -> X {}

/// `f(at)` and its gradient, from one derived evaluation.
@intrinsic
pub fn value_and_gradient<X: Domain>(f: fn(X) -> f32, at: X) -> (f32, X) {}

/// `f(at)`'s value, its gradient, and the rest of what `f` returns, from one derived
/// evaluation: a field's channels beside its distance and normal, where computing them apart
/// would compute the distance twice. Only the value is differentiated.
@intrinsic
pub fn value_gradient_with<X: Domain, T>(f: fn(X) -> (f32, T), at: X) -> (f32, X, T) {}

/// A range that contains `f(x)` for every `x` in `over`, by interval arithmetic over `f`'s
/// body: an `Interval` for an `f32`, and a box for a vector, each component's range from one
/// derived function. On the GPU each operation widens its result outward by its error bound.
@intrinsic
pub fn interval<X: Domain, Y: Domain>(f: fn(X) -> Y, over: X::Box) -> Y::Box {}

/// `f(at)` box-filtered over a footprint `width` wide along each of `at`'s components (a pixel's
/// spread in `f`'s input, say): each `fract`, `floor`, `ceil`, `round`, `trunc`, `step`, `sign`,
/// `abs`, `min`, `max`, `clamp` and `saturate` on the input's path is replaced by its average
/// over the range its operand spans in the footprint (to first order: the operand's derivative
/// along each component, times the width there, summed in size). A point sample of a stripe or
/// a checker aliases where its stripes are finer than a pixel; this one fades them to their
/// mean. What a branch on the input chooses isn't filtered: write it with `step` or `mix`. Each
/// value is averaged alone, to first order: a product of patterns along different components
/// averages exactly, but `abs` of a difference of two averaged patterns doesn't (a checker is
/// best a product of its stripes).
@intrinsic
pub fn filtered<X: Domain>(f: fn(X) -> f32, at: X, width: X) -> f32 {}

// ---- tests (the suite runs std's: `std_tests_pass`) --------------------------------------------

@test
fn a_gradient_carries_the_rest_of_the_result() {
    let p = vec3(0.3, -0.4, 1.2)
    let f = |q: vec3| (length(q) - 1.0, (q.x * q.y, vec2(q.z, 2.0)))
    let (d, g, rest) = value_gradient_with(f, p)
    let (d2, g2) = value_and_gradient(|q: vec3| length(q) - 1.0, p)
    assert(d == d2 && g == g2, "the value and gradient are value_and_gradient's")
    assert(rest.0 == p.x * p.y && rest.1 == vec2(p.z, 2.0), "the rest is the function's")
}

@test
fn samples_spread_evenly_through_their_box() {
    let b = Box3 { lo: vec3(-1.0, 2.0, 0.0), hi: vec3(3.0, 2.5, 10.0) }
    // 4096 points over 8 × 8 × 8 cells: exactly 8 in each (random points would vary by ±3).
    var cells = [0; 512]
    for i in 0..4096 {
        let p = b.sample(11, i)
        assert(p.x >= b.lo.x && p.y >= b.lo.y && p.z >= b.lo.z, "a sample is below the box")
        assert(p.x < b.hi.x && p.y < b.hi.y && p.z < b.hi.z, "a sample is above the box")
        let c = (p - b.lo) / (b.hi - b.lo) * 8.0
        cells[u32(c.x) + 8 * u32(c.y) + 64 * u32(c.z)] += 1
    }
    for k in 0..512 {
        assert(cells[k] == 8, f"cell {k}")
    }
    let (a, c) = (b.sample(seed: 11, i: 5), b.sample(seed: 12, i: 5))
    assert(a != c, "the seed doesn't change the sequence")
}

@test
fn samples_of_a_range_and_a_rectangle_stay_in_them() {
    let r = Interval { lo: -2.0, hi: 6.0 }
    let b = Box2 { lo: vec2(0.0, -1.0), hi: vec2(1.0, 1.0) }
    for i in 0..1024 {
        let x = r.sample(3, i)
        assert(r.lo <= x && x < r.hi, "a sample is outside its range")
        let p = b.sample(3, i)
        assert(p.x >= b.lo.x && p.y >= b.lo.y && p.x < b.hi.x && p.y < b.hi.y)
    }
}

/// A footprint's mean of `f`, from `n` samples spread evenly across `[x - w/2, x + w/2]`.
fn mean_over(f: fn(f32) -> f32, x: f32, w: f32, n: u32) -> f32 {
    var s = 0.0
    for i in 0..n {
        s += f(x + w * ((f32(i) + 0.5) / f32(n) - 0.5))
    }
    s / f32(n)
}

/// Filtered stripes are near their footprint's mean, at every width: a point sample of stripes
/// finer than the footprint is all one or all the other, the filtered value a share between.
/// Over 64 points and widths from a thousandth of a stripe to many stripes, its error from a
/// 4096-sample mean is at most a fifth of a point sample's, and under 0.05 on average.
@test
fn filtered_stripes_are_near_their_footprints_mean() {
    let stripes = |u: f32| step(0.5, fract(u * 4.0))
    var filtered_error = 0.0
    var point_error = 0.0
    var n = 0
    for i in 0..64 {
        let x = Interval { lo: -3.0, hi: 3.0 }.sample(3, i)
        for w in [0.0005, 0.02, 0.1, 0.3, 1.0, 5.0] {
            let mean = mean_over(stripes, x, w, 4096)
            filtered_error += abs(filtered(stripes, x, w) - mean)
            point_error += abs(stripes(x) - mean)
            n += 1
        }
    }
    assert(filtered_error <= 0.2 * point_error, f"{filtered_error} against {point_error}")
    assert(filtered_error / f32(n) < 0.05, f"{filtered_error / f32(n)} on average")
}

/// A footprint of no width keeps the point's own value exactly; one wide over a checker of unit
/// squares gives about half. The checker is written as a product of its two axes' stripes,
/// which a box footprint averages exactly; `abs` of their difference would give 0 far off (each
/// stripe's mean is a half, and the difference of the means is 0).
@test
fn filtered_checkers_are_the_point_up_close_and_grey_far_off() {
    let checker = |p: vec2| {
        0.5 - 0.5 * (1.0 - 2.0 * step(0.5, fract(p.x))) * (1.0 - 2.0 * step(0.5, fract(p.y)))
    }
    for i in 0..32 {
        let p = Box2 { lo: vec2(-4.0), hi: vec2(4.0) }.sample(5, i)
        assert(filtered(checker, p, vec2(0.0)) == checker(p), "a point's footprint changed it")
        let far = filtered(checker, p, vec2(16.0))
        assert(abs(far - 0.5) < 0.1, f"a wide footprint of a checker gave {far}")
    }
}

fn near(got: f32, want: f32, what: str) {
    assert(abs(got - want) <= 1.0e-5, f"{what}: {got}, not {want}")
}

/// Each builtin `filtered` box-filters, over a footprint of `x` itself, against its average
/// worked out by hand: across a kink or a jump, beside one (a footprint that misses it keeps the
/// point's value exactly, however large `x`), and just past fract's jump with a footprint of a
/// few ulps (f32's own: `1 - 2⁻²⁴` and `2⁻¹⁹`, where `f + w/2 - 1` rounds). A clamp whose low
/// bound moves with `x` has no kink there.
@test
fn filtered_builtins_are_their_footprints_average() {
    let trunc_of = |u: f32| trunc(u)
    near(filtered(trunc_of, at: 0.0, width: 1.0), 0.0, "trunc across 0")
    near(filtered(trunc_of, at: 1.0, width: 1.0), 0.5, "trunc across 1")
    near(filtered(trunc_of, at: -1.0, width: 1.0), -0.5, "trunc across -1")
    near(filtered(trunc_of, at: -0.5, width: 1.0), 0.0, "trunc below 0")
    let floor_of = |u: f32| floor(u)
    near(filtered(floor_of, at: 0.0, width: 1.0), -0.5, "floor across 0")
    assert(filtered(floor_of, at: 2.5, width: 0.5) == 2.0, "floor beside no jump")
    let ceil_of = |u: f32| ceil(u)
    near(filtered(ceil_of, at: 0.0, width: 1.0), 0.5, "ceil across 0")
    let round_of = |u: f32| round(u)
    near(filtered(round_of, at: 0.5, width: 1.0), 0.5, "round across a half")
    let fract_of = |u: f32| fract(u)
    near(filtered(fract_of, at: 1000.25, width: 0.1), 0.25, "fract far off")
    near(filtered(fract_of, at: 0.0, width: 1.0), 0.5, "fract across 0")
    near(
        filtered(fract_of, at: 1.0 - 1.0 / 16777216.0, width: 1.0 / 524288.0),
        0.53124994,
        "fract by ulps",
    )
    let abs_of = |u: f32| abs(u)
    assert(filtered(abs_of, at: 1000000.0, width: 0.01) == 1000000.0, "abs far from its kink")
    near(filtered(abs_of, at: 0.0, width: 1.0), 0.25, "abs across 0")
    near(filtered(abs_of, at: 0.25, width: 1.0), 0.3125, "abs beside 0")
    let min_of = |u: f32| min(u, 0.0)
    let max_of = |u: f32| max(u, 0.0)
    assert(filtered(min_of, at: 1000000.0, width: 1.0) == 0.0, "min far from its kink")
    near(filtered(min_of, at: 0.0, width: 1.0), -0.125, "min across 0")
    near(filtered(max_of, at: 0.0, width: 1.0), 0.125, "max across 0")
    let saturate_of = |u: f32| saturate(u)
    assert(filtered(saturate_of, at: 1000000.0, width: 1.0) == 1.0, "saturate far from its kinks")
    near(filtered(saturate_of, at: 0.0, width: 1.0), 0.125, "saturate across 0")
    let clamp_of = |u: f32| clamp(u, -1.0, 1.0)
    near(filtered(clamp_of, at: 1.0, width: 1.0), 0.875, "clamp across its top")
    let moving = |u: f32| clamp(u, u - 0.25, 1.0)
    near(filtered(moving, at: 1.0, width: 1.0), 0.875, "a clamp whose low bound moves with x")
    let sign_of = |u: f32| sign(u)
    near(filtered(sign_of, at: 0.0, width: 1.0), 0.0, "sign across 0")
    near(filtered(sign_of, at: 0.25, width: 1.0), 0.5, "sign beside 0")
    let step_of = |u: f32| step(0.0, u)
    near(filtered(step_of, at: 0.25, width: 1.0), 0.75, "step beside 0")
}
