// std's allocator: the heap that `Vec`, `String` and `Box` live in (language.md §6.9).
//
// Blocks of up to 1 MiB come in size classes, the powers of two from 16 bytes, each with a list
// of freed blocks to reuse. Larger blocks are whole multiples of 64 KiB, on a list of their own
// in address order: a request takes the best fit, split if it's bigger (its rest stays freed),
// and a freed block is joined to the freed blocks it touches, or given back to the bump pointer
// when it ends there. So a long run that frees large blocks and asks for others of other sizes
// reuses them (whole, a freed block's tail was lost each time a smaller request took it: the
// floor's walk into the wildwood ran out of memory). Fresh memory comes from a bump pointer,
// which grows the memory as it needs.
// Every block is 16-byte aligned. Callers say a block's size when they free it, so blocks carry
// no header. Addresses never reach a program's results, so where a block lands can't change
// what a program computes.
//
// The state lives at wrela_abi::memory::ALLOC_STATE (16): the bump pointer (0 until the first
// allocation), where the memory ends, a lock word, the large blocks' list, and one list head
// per size class. How many blocks `alloc` has returned is counted in each thread's block, so
// what one thread counts doesn't depend on another's timing. So are the times a thread found the
// lock taken, and the tries it spun before it got it: hosts measure the waits with them.

use std::abi::{ALLOCATIONS, ALLOC_STATE, LOCK_SPINS, LOCK_WAITS}
use std::mem::{
    align_of, atomic_load, compare_swap, copy, count, heap_base, load_u32, memory_grow,
    memory_pages, notify, size_of, store_u32, thread_block, wait, write,
}

// The allocator's words, from ALLOC_STATE on.
const BUMP: u32 = ALLOC_STATE
const END: u32 = ALLOC_STATE + 4
const LOCK: u32 = ALLOC_STATE + 8
const LARGE: u32 = ALLOC_STATE + 12
const HEADS: u32 = ALLOC_STATE + 16
const CLASSES: u32 = 17
const SMALLEST: u32 = 16
const PAGE: u32 = 65536
/// The largest block there can be: the memory's most (1 GiB), so a size's rounding to a page
/// can't overflow.
const MOST: u32 = 1073741824

/// A block of at least `size` bytes, aligned to `align` (at most 16), or 0 when `size` is 0.
/// Running out of memory panics.
///
/// Nothing panics or traps while the lock is held: a thread that did would hold it for good,
/// and every other thread would wait on it forever (spike 17's bake: a job ran out of memory,
/// and the thread that would have joined it spun until its count of tries overflowed, which hid
/// the job's panic). A request that can't be met is found under the lock and panics after it.
pub fn alloc(size: u32, align: u32) -> u32 {
    if size == 0 {
        return 0
    }
    if align > SMALLEST {
        panic("std's allocator aligns blocks to at most 16 bytes")
    }
    if size > MOST {
        panic("out of memory: a block larger than the heap can grow to (1 GiB)")
    }
    lock()
    let k = class(size)
    let block = if k < CLASSES {
        unsafe {
            let head = load_u32(HEADS + 4 * k)
            if head != 0 {
                store_u32(HEADS + 4 * k, load_u32(head))
                head
            } else {
                carve(SMALLEST << k)
            }
        }
    } else {
        large(round_up(size, PAGE))
    }
    unlock()
    if block == 0 {
        panic("out of memory: the heap can't grow past 1 GiB")
    }
    unsafe {
        count(ALLOCATIONS, 1)
    }
    block
}

/// Moves `value` to a block of its own: the block's address. Whoever frees the block, with
/// `size_of::<T>()`, moves the value out or drops it first.
pub(package) fn place<T>(value: take T) -> u32 {
    unsafe {
        let at = alloc(size_of::<T>(), align_of::<T>())
        write(at, take value)
        at
    }
}

/// How many blocks the allocator has handed out to this thread since the program started,
/// wrapping at 2³²: for checking that code doesn't allocate (a `Vec` that grows, an f-string,
/// a `clone`). A `realloc` that keeps its block doesn't count. Each thread counts its own, so
/// the count doesn't depend on what other threads do, or when.
pub fn allocations() -> u32 {
    unsafe { load_u32(thread_block() + ALLOCATIONS) }
}

/// Frees a block that `alloc` returned for `size` bytes. Freeing 0 does nothing.
pub fn free(addr: u32, size: u32) {
    if addr == 0 {
        return
    }
    lock()
    let k = class(size)
    unsafe {
        if k < CLASSES {
            store_u32(addr, load_u32(HEADS + 4 * k))
            store_u32(HEADS + 4 * k, addr)
        } else {
            free_large(addr, round_up(size, PAGE))
        }
    }
    unlock()
}

/// A block of `new` bytes holding the first `min(old, new)` bytes of `addr`'s, which was
/// `old` bytes: the same block when it has room.
pub fn realloc(addr: u32, old: u32, new: u32, align: u32) -> u32 {
    if addr != 0 && new != 0 && class(old) < CLASSES && class(old) == class(new) {
        return addr
    }
    unsafe {
        let to = alloc(new, align)
        if addr != 0 {
            copy(to, addr, min(old, new))
            free(addr, old)
        }
        to
    }
}

/// The size class of `size` bytes: the smallest `k` with `16 << k >= size`; `CLASSES` and up
/// for a large block.
fn class(size: u32) -> u32 {
    var k = 0
    while k < CLASSES && SMALLEST << k < size {
        k += 1
    }
    k
}

fn round_up(n: u32, to: u32) -> u32 {
    (n + to - 1) / to * to
}

/// A large block of `n` bytes, a multiple of 64 KiB: the smallest freed one big enough (if it's
/// bigger, its rest stays freed in its place), else fresh. A freed large block's list node is
/// its first two words: the next freed block, then its size.
fn large(n: u32) -> u32 {
    unsafe {
        var best = 0
        var best_link = LARGE
        var best_size = 4294967295
        var link = LARGE
        var at = load_u32(LARGE)
        while at != 0 {
            let size = load_u32(at + 4)
            if size >= n && size < best_size {
                best = at
                best_link = link
                best_size = size
            }
            link = at
            at = load_u32(at)
        }
        if best != 0 {
            if best_size > n {
                // Its rest keeps its place in the list: it's after `best`, and before the next.
                let rest = best + n
                store_u32(rest, load_u32(best))
                store_u32(rest + 4, best_size - n)
                store_u32(best_link, rest)
            } else {
                store_u32(best_link, load_u32(best))
            }
            return best
        }
    }
    carve(n)
}

/// Puts a large block of `size` bytes back on the freed list (in address order), joined to the
/// freed blocks either side that it touches; or, if it then ends where fresh memory starts, gives
/// it back to the bump pointer.
fn free_large(addr: u32, size: u32) {
    unsafe {
        // The freed blocks before and after it, and the word that points at the one before.
        var prev = 0
        var prev_link = LARGE
        var next = load_u32(LARGE)
        while next != 0 && next < addr {
            prev_link = if prev == 0 { LARGE } else { prev }
            prev = next
            next = load_u32(next)
        }
        var start = addr
        var len = size
        if next != 0 && addr + size == next {
            len += load_u32(next + 4)
            next = load_u32(next)
        }
        // The word that points at the block: the list's head, or the freed block before it.
        var link = if prev == 0 { LARGE } else { prev }
        if prev != 0 && prev + load_u32(prev + 4) == addr {
            start = prev
            len += load_u32(prev + 4)
            link = prev_link
        }
        if start + len == load_u32(BUMP) {
            store_u32(link, next)
            store_u32(BUMP, start)
        } else {
            store_u32(start, next)
            store_u32(start + 4, len)
            store_u32(link, start)
        }
    }
}

/// `n` fresh bytes from the bump pointer, growing the memory if it must; 0 if it can't grow (the
/// caller panics, once it has let the lock go).
fn carve(n: u32) -> u32 {
    unsafe {
        var bump = load_u32(BUMP)
        if bump == 0 {
            bump = heap_base()
            store_u32(END, memory_pages() * PAGE)
        }
        let end = load_u32(END)
        if n > end - bump {
            let pages = (n - (end - bump) + PAGE - 1) / PAGE
            if memory_grow(pages) == 4294967295 {
                return 0
            }
            store_u32(END, end + pages * PAGE)
        }
        store_u32(BUMP, bump + n)
        bump
    }
}

/// Takes the allocator's lock: workers share the heap. The lock's word is 0 when it's free, 1
/// when a thread holds it, and 2 when a thread holds it and another may be asleep on it. A thread
/// that finds it taken spins a while (holds are short), then marks it 2 and sleeps until the
/// holder lets go (`unlock` wakes a sleeper). It counts the wait and its tries (only this thread
/// writes its counts, wrapping).
fn lock() {
    unsafe {
        if compare_swap(LOCK, expected: 0, new: 1) == 0 {
            return
        }
        var spins: u32 = 1
        loop {
            if spins < SPINS_BEFORE_SLEEPING {
                if compare_swap(LOCK, expected: 0, new: 1) == 0 {
                    break
                }
            } else {
                // Taken with the mark of a sleeper on it: whoever lets it go wakes one.
                if exchange_lock(2) == 0 {
                    break
                }
                let _ = wait(LOCK, 2)
            }
            spins = spins.wrapping_add(1)
        }
        count(LOCK_WAITS, 1)
        count(LOCK_SPINS, spins)
    }
}

/// Lets the allocator's lock go, waking a thread asleep on it if one may be.
fn unlock() {
    unsafe {
        if exchange_lock(0) == 2 {
            let _ = notify(LOCK, 1)
        }
    }
}

/// Puts `new` in the lock's word, atomically: what was there.
fn exchange_lock(new: u32) -> u32 {
    unsafe {
        loop {
            let old = atomic_load(LOCK)
            if compare_swap(LOCK, expected: old, new: new) == old {
                return old
            }
        }
    }
}

/// How many tries a thread spins on the lock before it sleeps on it.
const SPINS_BEFORE_SLEEPING: u32 = 2048
