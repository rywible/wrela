@test
fn the_f64_functions_are_within_an_ulp_of_libm_where_sampled() {
    for (k, xb, yb, want_bits) in LIBM {
        let x = bitcast_f64(xb)
        let y = bitcast_f64(yb)
        let got = match k {
            0 => sin_f64(x),
            1 => cos_f64(x),
            2 => atan_f64(x),
            3 => atan2_f64(y: x, x: y),
            4 => exp_f64(x),
            5 => log_f64(x),
            6 => log10_f64(x),
            7 => log2_f64(x),
            _ => pow_f64(x, y: y),
        }
        let want = bitcast_f64(want_bits)
        assert(d_ulps(got, want) <= 1.0, f"function {k} of {x}, {y}: {got} against libm's {want}")
    }
}
