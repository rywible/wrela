// Trigonometric, hyperbolic, exponential and logarithmic functions, their inverses and powers,
// for CPU code, with the constants π and 2π. They are compiled to WASM with the program, never
// taken from the host, so every host computes the same bits (language.md §11). GPU code uses
// WGSL's own.
//
// Each function widens its f32 argument to f64, works there, and rounds once to f32. Sine,
// cosine and tangent of |x| >= 2^20 use an integer range reduction with 192 bits of 4/π.
// Accuracy (an estimate, not proved): within 1 ulp of the true f32 result.

// Credit (MIT licence): the algorithms and coefficients follow musl's libm (FreeBSD msun before
// it): __sindf, __cosdf and __tandf for sin, cos and tan; atan's table and polynomial; and
// textbook series for exp and log. The range reduction for |x| >= 2^20 is ARM's
// optimized-routines'.

const INV_PIO2: f64 = 0.636619772367581382433
// pi/2 split in two: the first 33 bits, then the rest.
const PIO2_HI: f64 = 1.57079631090164184570
const PIO2_LO: f64 = 0.0000000158932547735281966916

/// π, to f32's precision.
pub const PI: f32 = 3.14159265

/// 2π, to f32's precision.
pub const TAU: f32 = 6.28318531
const LN2: f64 = 0.693147180559945286227
const LOG2E: f64 = 1.44269504088896338700
const HALF_LN2: f64 = 0.346573590279972643113
const SQRT2: f64 = 1.41421356237309514547

const S1: f64 = -0.166666666416265235595
const S2: f64 = 0.0083333293858894631756
const S3: f64 = -0.000198393348360966317347
const S4: f64 = 0.0000027183114939898219064
const C0: f64 = -0.499999997251031003120
const C1: f64 = 0.0416666233237390631894
const C2: f64 = -0.00138867637746099294692
const C3: f64 = 0.0000243904487962774090654
// 4/π's bits, each entry the 32 after the previous one's first 8 (optimized-routines'
// `__inv_pio4`).
const INV_PIO4: [u32; 24] = [
    0xa2, 0xa2f9, 0xa2f983, 0xa2f9836e, 0xf9836e4e, 0x836e4e44, 0x6e4e4415, 0x4e441529, 0x441529fc,
    0x1529fc27, 0x29fc2757, 0xfc2757d1, 0x2757d1f5, 0x57d1f534, 0xd1f534dd, 0xf534ddc0, 0x34ddc0db,
    0xddc0db62, 0xc0db6295, 0xdb629599, 0x6295993c, 0x95993c43, 0x993c4390, 0x3c439041,
]
// π/2 · 2^-62.
const PIO2_2N62: f64 = 3.4061215800865545e-19

const T: [f64; 6] = [
    0.333331395030791399758,
    0.133392002712976742718,
    0.0533812378445670393523,
    0.0245283181166547278873,
    0.00297435743359967304927,
    0.00946564784943673166728,
]

const ATAN_HI: [f64; 4] = [
    0.463647609000806093515,
    0.785398163397448278999,
    0.982793723247329054082,
    1.57079632679489655800,
]
const ATAN_LO: [f64; 4] = [
    0.0000000000000000226987774529616870924,
    0.0000000000000000306161699786838301793,
    0.0000000000000000139033110312309984516,
    0.0000000000000000612323399573676603587,
]
const AT: [f64; 11] = [
    0.333333333333329318027,
    -0.199999999998764832476,
    0.142857142725034663711,
    -0.111111104054623557880,
    0.0909088713343650656196,
    -0.0769187620504482999495,
    0.0666107313738753120669,
    -0.0583357013379057348645,
    0.0497687799461593236017,
    -0.0365315727442169155270,
    0.0162858201153657823623,
]

const F32_MAX: f32 = 340282346638528859811704183484516925440.0

fn is_nan(x: f32) -> bool {
    x != x
}

fn is_inf(x: f32) -> bool {
    abs(x) > F32_MAX
}

/// Whether `x` is a number: not a NaN, not an infinity.
pub fn is_finite(x: f32) -> bool {
    abs(x) <= F32_MAX
}

/// A finite `x` reduced to `y = x - n * pi/2` with |y| <= pi/4, and `n`: exact for |x| < 2^20,
/// and beyond that only its last two bits (the quadrant), since `n` can be far beyond an i32.
fn reduce(x: f32) -> (f64, i32) {
    if abs(x) >= 1048576.0 {
        let (y, q) = reduce_large(x)
        return if x < 0.0 { (-y, -q) } else { (y, q) }
    }
    // |n| < 2^20, so `n * PIO2_HI` is exact.
    let xd = f64(x)
    let n = round(xd * INV_PIO2)
    ((xd - n * PIO2_HI) - n * PIO2_LO, i32(n))
}

/// `reduce` of |x| for |x| >= 2: |x| * 2/π modulo 4, in fixed point with 62 bits after the
/// point, from the 96 bits of 4/π that matter at x's exponent (the bits before them give
/// multiples of 4, and the bits after them less than 2^-62). Accurate to 33 bits.
fn reduce_large(x: f32) -> (f64, i32) {
    let xi = bitcast_u32(x)
    let k = (xi >> 26) & 15
    let m = ((xi & 0x7fffff) | 0x800000) << ((xi >> 23) & 7)
    var r = (u64(m.wrapping_mul(INV_PIO4[k])) << 32) | ((u64(m) * u64(INV_PIO4[k + 8])) >> 32)
    r = r.wrapping_add(u64(m) * u64(INV_PIO4[k + 4]))
    // The quadrant is the top two bits, rounded; the rest is y, signed.
    let n = r.wrapping_add(0x2000000000000000) >> 62
    r = r.wrapping_sub(n << 62)
    (f64(i64(r)) * PIO2_2N62, i32(n))
}

fn sin_kernel(x: f64) -> f64 {
    let z = x * x
    let w = z * z
    let r = S3 + z * S4
    let s = z * x
    (x + s * (S1 + z * S2)) + s * w * r
}

fn cos_kernel(x: f64) -> f64 {
    let z = x * x
    let w = z * z
    let r = C2 + z * C3
    ((1.0 + z * C0) + w * C1) + (w * z) * r
}

/// sin(y + q·π/2) for a reduced `y`, rounded to f32: `q & 3` picks the kernel and the sign.
fn sin_quadrant(y: f64, q: i32) -> f32 {
    let k = q & 3
    let r = if k == 0 {
        sin_kernel(y)
    } else if k == 1 {
        cos_kernel(y)
    } else if k == 2 {
        -sin_kernel(y)
    } else {
        -cos_kernel(y)
    }
    f32(r)
}

/// The sine of `x`, in radians.
pub fn sin(x: f32) -> f32 {
    if is_nan(x) || is_inf(x) {
        return x - x
    }
    // sin(x) rounds to x, keeping -0's sign.
    if abs(x) < 0.000244140625 {
        return x
    }
    let (y, n) = reduce(x)
    sin_quadrant(y, n)
}

/// The cosine of `x`, in radians: sin(x + π/2), one quadrant on.
pub fn cos(x: f32) -> f32 {
    if is_nan(x) || is_inf(x) {
        return x - x
    }
    let (y, n) = reduce(x)
    // `& 3` before `+ 1`, so the sum can't overflow.
    sin_quadrant(y, (n & 3) + 1)
}

/// The tangent of `x`, in radians.
pub fn tan(x: f32) -> f32 {
    if is_nan(x) || is_inf(x) {
        return x - x
    }
    // tan(x) rounds to x, keeping -0's sign.
    if abs(x) < 0.000244140625 {
        return x
    }
    let (y, n) = reduce(x)
    let z = y * y
    var r = T[4] + z * T[5]
    let t = T[2] + z * T[3]
    let w = z * z
    let s = z * y
    let u = T[0] + z * T[1]
    r = (y + s * u) + (s * w) * (t + w * r)
    if (n & 1) == 1 {
        f32(-1.0 / r)
    } else {
        f32(r)
    }
}

/// e^r for |r| <= ln(2)/2, by its Taylor series to degree 11.
fn exp_poly(r: f64) -> f64 {
    1.0 + r * exp_tail(r)
}

/// (e^r - 1) / r for |r| <= ln(2)/2: `exp_poly`'s series after its 1, divided by r.
fn exp_tail(r: f64) -> f64 {
    // Horner's rule, from the highest degree down.
    var p = 0.0000000250521083854417188
    p = 0.000000275573192239858907 + r * p
    p = 0.00000275573192239858907 + r * p
    p = 0.0000248015873015873016 + r * p
    p = 0.000198412698412698413 + r * p
    p = 0.00138888888888888889 + r * p
    p = 0.00833333333333333333 + r * p
    p = 0.0416666666666666667 + r * p
    p = 0.166666666666666667 + r * p
    p = 0.5 + r * p
    1.0 + r * p
}

/// e^x for an f64 `x`, |x| <= 700.
fn wide_exp(x: f64) -> f64 {
    let n = round(x * LOG2E)
    exp_poly(x - n * LN2) * pow2(i32(n))
}

/// e^x - 1 for an f64 `x`, |x| <= 700: near 0, without the cancellation of `e^x - 1`.
fn wide_expm1(x: f64) -> f64 {
    if abs(x) <= HALF_LN2 {
        x * exp_tail(x)
    } else {
        wide_exp(x) - 1.0
    }
}

/// 2^n as an f64, for -1022 <= n <= 1023.
fn pow2(n: i32) -> f64 {
    bitcast_f64(u64(n + 1023) << 52)
}

/// 2^x for an f64 `x`; overflows to infinity and underflows to 0 at f32's limits.
fn wide_exp2(x: f64) -> f64 {
    if x > 129.0 {
        return 1.0 / 0.0
    }
    if x < -151.0 {
        return 0.0
    }
    let n = round(x)
    exp_poly((x - n) * LN2) * pow2(i32(n))
}

/// e to the power `x`.
pub fn exp(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    let xd = f64(x)
    if xd > 89.0 {
        return f32(1.0 / 0.0)
    }
    if xd < -104.0 {
        return 0.0
    }
    f32(wide_exp(xd))
}

/// The hyperbolic sine of `x`, (e^x - e^-x) / 2.
pub fn sinh(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    // Odd: from |x|, then x's sign (by its bit, so -0 stays -0).
    let a = abs(f64(x))
    if a > 90.0 {
        return with_sign_of(1.0 / 0.0, x)
    }
    // With E = e^a - 1, e^a - e^-a = E + E / (E + 1): no cancellation near 0.
    let e = wide_expm1(a)
    with_sign_of(f32(0.5 * (e + e / (e + 1.0))), x)
}

/// The hyperbolic cosine of `x`, (e^x + e^-x) / 2.
pub fn cosh(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    let a = abs(f64(x))
    if a > 90.0 {
        return f32(1.0 / 0.0)
    }
    let e = wide_exp(a)
    f32(0.5 * (e + 1.0 / e))
}

/// The hyperbolic tangent of `x`, sinh(x) / cosh(x), in [-1, 1].
pub fn tanh(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    // Odd: from |x|, then x's sign. Past 20 it's 1 to within f64's precision.
    let a = abs(f64(x))
    if a > 20.0 {
        return with_sign_of(1.0, x)
    }
    // With E = e^(2a) - 1, (e^(2a) - 1) / (e^(2a) + 1) = E / (E + 2).
    let e = wide_expm1(2.0 * a)
    with_sign_of(f32(e / (e + 2.0)), x)
}

/// `r`, a magnitude, with the sign of `x`.
fn with_sign_of(r: f32, x: f32) -> f32 {
    if (bitcast_u32(x) >> 31) == 1 { -r } else { r }
}

/// 2 to the power `x`.
pub fn exp2(x: f32) -> f32 {
    if is_nan(x) {
        return x
    }
    f32(wide_exp2(f64(x)))
}

/// log2 of a positive, finite f64: the exponent plus log2 of the mantissa.
fn wide_log2(x: f64) -> f64 {
    let bits = bitcast_u64(x)
    var e = i32((bits >> 52) & 2047) - 1023
    var m = bitcast_f64((bits & 4503599627370495) | 4607182418800017408)
    if m > SQRT2 {
        m = m * 0.5
        e = e + 1
    }
    // log(1 + f) = 2 atanh(s) with s = f / (2 + f): |s| <= 0.172.
    let f = m - 1.0
    let s = f / (2.0 + f)
    let z = s * s
    var q = 0.0769230769230769231
    q = 0.0909090909090909091 + z * q
    q = 0.111111111111111111 + z * q
    q = 0.142857142857142857 + z * q
    q = 0.2 + z * q
    q = 0.333333333333333333 + z * q
    let ln = 2.0 * s * (1.0 + z * q)
    f64(e) + ln * LOG2E
}

/// log2(x) times `scale`, rounded once to f32.
fn log2_scaled(x: f32, scale: f64) -> f32 {
    if is_nan(x) || x < 0.0 {
        return (x - x) / (x - x)
    }
    if x == 0.0 {
        return -1.0 / 0.0
    }
    if is_inf(x) {
        return x
    }
    f32(wide_log2(f64(x)) * scale)
}

/// The base-2 logarithm of `x`: minus infinity at 0, and NaN below 0.
pub fn log2(x: f32) -> f32 {
    log2_scaled(x, 1.0)
}

/// The natural logarithm of `x`: minus infinity at 0, and NaN below 0.
pub fn log(x: f32) -> f32 {
    log2_scaled(x, LN2)
}

/// Whether `y` is an odd integer (every f32 of magnitude 2^24 or more is even).
fn is_odd(y: f32) -> bool {
    abs(y) < 16777216.0 && floor(y) == y && (i32(y) & 1) == 1
}

/// `x` to the power `y`, with the values C and IEEE 754 give at zeros, infinities and NaNs.
pub fn pow(x: f32, y: f32) -> f32 {
    if y == 0.0 || x == 1.0 {
        return 1.0
    }
    if is_nan(x) || is_nan(y) {
        return x + y
    }
    let inf = 1.0 / 0.0
    if is_inf(y) {
        if x == -1.0 {
            return 1.0
        }
        // |x| < 1 goes to 0 as y goes to +inf, and |x| > 1 to inf; the other way for -inf.
        return if (abs(x) < 1.0) == (y > 0.0) { 0.0 } else { inf }
    }
    // A negative base (-0 too) gives an odd power its sign.
    let neg = sign_bit(f64(x)) && is_odd(y)
    if x == 0.0 || is_inf(x) {
        let r = if (x == 0.0) == (y > 0.0) { 0.0 } else { inf }
        return if neg { -r } else { r }
    }
    if x < 0.0 && floor(y) != y {
        return (x - x) / (x - x)
    }
    let r = f32(wide_exp2(f64(y) * wide_log2(abs(f64(x)))))
    if neg {
        -r
    } else {
        r
    }
}

/// atan of an f64, by a reduction to |a| < 7/16 and an odd polynomial.
fn wide_atan(x: f64) -> f64 {
    if x != x {
        return x
    }
    let neg = x < 0.0
    var a = abs(x)
    if a > 100000000000000000000.0 {
        return if neg { -ATAN_HI[3] } else { ATAN_HI[3] }
    }
    var id: i32 = -1
    if a >= 0.4375 {
        if a < 0.6875 {
            id = 0
            a = (2.0 * a - 1.0) / (2.0 + a)
        } else if a < 1.1875 {
            id = 1
            a = (a - 1.0) / (a + 1.0)
        } else if a < 2.4375 {
            id = 2
            a = (a - 1.5) / (1.0 + 1.5 * a)
        } else {
            id = 3
            a = -1.0 / a
        }
    }
    let z = a * a
    let w = z * z
    let s1 = z * (AT[0] + w * (AT[2] + w * (AT[4] + w * (AT[6] + w * (AT[8] + w * AT[10])))))
    let s2 = w * (AT[1] + w * (AT[3] + w * (AT[5] + w * (AT[7] + w * AT[9]))))
    let r = if id < 0 {
        a - a * (s1 + s2)
    } else {
        ATAN_HI[u32(id)] - ((a * (s1 + s2) - ATAN_LO[u32(id)]) - a)
    }
    if neg {
        -r
    } else {
        r
    }
}

/// Whether an f64's sign bit is set (true for -0.0).
fn sign_bit(x: f64) -> bool {
    (bitcast_u64(x) >> 63) == 1
}

fn wide_atan2(y: f64, x: f64) -> f64 {
    if x != x || y != y {
        return x + y
    }
    let big = 1.0e300
    if y == 0.0 {
        if sign_bit(x) {
            return if sign_bit(y) { -PI_F64 } else { PI_F64 }
        }
        return y
    }
    if x == 0.0 {
        return if y > 0.0 { PI_F64 * 0.5 } else { -PI_F64 * 0.5 }
    }
    if abs(x) > big && abs(y) > big {
        let q = if x > 0.0 { PI_F64 * 0.25 } else { PI_F64 * 0.75 }
        return if y > 0.0 { q } else { -q }
    }
    let t = wide_atan(abs(y / x))
    let r = if x > 0.0 {
        t
    } else {
        PI_F64 - t
    }
    if y < 0.0 {
        -r
    } else {
        r
    }
}

/// The angle whose tangent is `x`, in [-π/2, π/2].
pub fn atan(x: f32) -> f32 {
    // Keeps -0's sign.
    if x == 0.0 {
        return x
    }
    f32(wide_atan(f64(x)))
}

/// The angle from the positive x axis to the point `(x, y)`, in [-π, π].
pub fn atan2(y: f32, x: f32) -> f32 {
    f32(wide_atan2(f64(y), f64(x)))
}

/// The angle whose sine is `x`, in [-π/2, π/2]; NaN outside [-1, 1].
pub fn asin(x: f32) -> f32 {
    let xd = f64(x)
    f32(wide_atan2(xd, sqrt((1.0 - xd) * (1.0 + xd))))
}

/// The angle whose cosine is `x`, in [0, π]; NaN outside [-1, 1].
pub fn acos(x: f32) -> f32 {
    let xd = f64(x)
    f32(wide_atan2(sqrt((1.0 - xd) * (1.0 + xd)), xd))
}

// ---- f64 ----------------------------------------------------------------------------------
//
// The same functions of f64s, for CPU code that measures in f64 (a tool's spectra, a mesh's
// rays): `sin_f64`, `cos_f64`, `atan_f64`, `atan2_f64`, `exp_f64`, `log_f64`, `log10_f64`,
// `log2_f64` and `pow_f64`, with `PI_F64` and `TAU_F64`. The built-in transcendentals of an f64
// are E0702 (§11.4); these are ordinary functions, over the ranges they say: `sin_f64` and
// `cos_f64` of |x| below 2^20·π/2, `pow_f64` of a positive, finite base. Each is within an ulp
// of libm where sampled (300,000 points of each against macOS's libm, outside the repository,
// and the points in `LIBM`), but `pow_f64` near overflow, within two; `pow_f64` is an infinity
// or 0 past f64's range, and exact where a correctly rounded libm is (x¹, x², x⁻¹, √x and 2ⁿ),
// and `log10_f64` and `log2_f64` at the powers of their bases.
//
// Credit (MIT licence): the algorithms and coefficients follow musl's libm (FreeBSD msun, and
// Sun's fdlibm before it): __sin and __cos, __rem_pio2's medium range reduction, atan and
// atan2, exp and log. `pow` is e^(y·log x) with log x and the product carried in two f64s
// (Dekker's products), so its error is exp's; x¹, x², x⁻¹, √x and 2ⁿ are exact, as a correctly
// rounded libm's are.

// π/2's reduction (__rem_pio2): 1.5 / f64's epsilon rounds to an integer when added and taken
// away; 2/π; π/2 in three parts of 33 bits, each with the rest after it; π/4.
const D_TOINT: f64 = 6755399441055744.0
const D_INV_PIO2: f64 = bitcast_f64(u64(0x3FE45F306DC9C883))
const D_PIO2_1: f64 = bitcast_f64(u64(0x3FF921FB54400000))
const D_PIO2_1T: f64 = bitcast_f64(u64(0x3DD0B4611A626331))
const D_PIO2_2: f64 = bitcast_f64(u64(0x3DD0B4611A600000))
const D_PIO2_2T: f64 = bitcast_f64(u64(0x3BA3198A2E037073))
const D_PIO2_3: f64 = bitcast_f64(u64(0x3BA3198A2E000000))
const D_PIO2_3T: f64 = bitcast_f64(u64(0x397B839A252049C1))
const D_PIO4: f64 = bitcast_f64(u64(0x3FE921FB54442D18))

/// π, and the rest of it past an f64.
pub const PI_F64: f64 = bitcast_f64(u64(0x400921FB54442D18))
const D_PI_LO: f64 = bitcast_f64(u64(0x3CA1A62633145C07))

/// 2π.
pub const TAU_F64: f64 = bitcast_f64(u64(0x401921FB54442D18))

// __sin's and __cos's polynomials.
const D_S1: f64 = bitcast_f64(u64(0xBFC5555555555549))
const D_S2: f64 = bitcast_f64(u64(0x3F8111111110F8A6))
const D_S3: f64 = bitcast_f64(u64(0xBF2A01A019C161D5))
const D_S4: f64 = bitcast_f64(u64(0x3EC71DE357B1FE7D))
const D_S5: f64 = bitcast_f64(u64(0xBE5AE5E68A2B9CEB))
const D_S6: f64 = bitcast_f64(u64(0x3DE5D93A5ACFD57C))
const D_C1: f64 = bitcast_f64(u64(0x3FA555555555554C))
const D_C2: f64 = bitcast_f64(u64(0xBF56C16C16C15177))
const D_C3: f64 = bitcast_f64(u64(0x3EFA01A019CB1590))
const D_C4: f64 = bitcast_f64(u64(0xBE927E4F809C52AD))
const D_C5: f64 = bitcast_f64(u64(0x3E21EE9EBDB4B1C4))
const D_C6: f64 = bitcast_f64(u64(0xBDA8FAE9BE8838D4))

// atan's table (atan of 0.5, 1, 1.5 and ∞, each in two parts) and polynomial.
const D_ATAN_HI: [f64; 4] = [
    0.463647609000806093515,
    0.785398163397448278999,
    0.982793723247329054082,
    1.57079632679489655800,
]
const D_ATAN_LO: [f64; 4] = [
    0.0000000000000000226987774529616870924,
    0.0000000000000000306161699786838301793,
    0.0000000000000000139033110312309984516,
    0.0000000000000000612323399573676603587,
]
const D_AT: [f64; 11] = [
    0.333333333333329318027,
    -0.199999999998764832476,
    0.142857142725034663711,
    -0.111111104054623557880,
    0.0909088713343650656196,
    -0.0769187620504482999495,
    0.0666107313738753120669,
    -0.0583357013379057348645,
    0.0497687799461593236017,
    -0.0365315727442169155270,
    0.0162858201153657823623,
]

// exp's and log's: ln 2 in two parts (the first with 32 bits to spare), 1/ln 2, and their
// polynomials.
const D_LN2_HI: f64 = bitcast_f64(u64(0x3FE62E42FEE00000))
const D_LN2_LO: f64 = bitcast_f64(u64(0x3DEA39EF35793C76))
const D_INV_LN2: f64 = bitcast_f64(u64(0x3FF71547652B82FE))
const D_INV_LN2_LO: f64 = bitcast_f64(u64(0x3C7777D0FFDA0D24))

// 1/ln 10, in two parts.
const D_INV_LN10: f64 = bitcast_f64(u64(0x3FDBCB7B1526E50E))
const D_INV_LN10_LO: f64 = bitcast_f64(u64(0x3C695355BAAAFAD3))
const D_P1: f64 = bitcast_f64(u64(0x3FC555555555553E))
const D_P2: f64 = bitcast_f64(u64(0xBF66C16C16BEBD93))
const D_P3: f64 = bitcast_f64(u64(0x3F11566AAF25DE2C))
const D_P4: f64 = bitcast_f64(u64(0xBEBBBD41C5D26BF1))
const D_P5: f64 = bitcast_f64(u64(0x3E66376972BEA4D0))
const D_LG1: f64 = bitcast_f64(u64(0x3FE5555555555593))
const D_LG2: f64 = bitcast_f64(u64(0x3FD999999997FA04))
const D_LG3: f64 = bitcast_f64(u64(0x3FD2492494229359))
const D_LG4: f64 = bitcast_f64(u64(0x3FCC71C51D8E78AF))
const D_LG5: f64 = bitcast_f64(u64(0x3FC7466496CB03DE))
const D_LG6: f64 = bitcast_f64(u64(0x3FC39A09D078C69F))
const D_LG7: f64 = bitcast_f64(u64(0x3FC2F112DF3E5244))

/// The high 32 bits of `x`'s magnitude.
fn d_high(x: f64) -> u32 {
    u32((bitcast_u64(x) >> 32) & 0x7fffffff)
}

fn d_sin_kernel(x: f64, y: f64, tail: bool) -> f64 {
    let z = x * x
    let w = z * z
    let r = D_S2 + z * (D_S3 + z * D_S4) + z * w * (D_S5 + z * D_S6)
    let v = z * x
    if !tail {
        x + v * (D_S1 + z * r)
    } else {
        x - ((z * (0.5 * y - v * r) - y) - v * D_S1)
    }
}

fn d_cos_kernel(x: f64, y: f64) -> f64 {
    let z = x * x
    let w = z * z
    let r = z * (D_C1 + z * (D_C2 + z * D_C3)) + w * w * (D_C4 + z * (D_C5 + z * D_C6))
    let hz = 0.5 * z
    let one = 1.0 - hz
    one + (((1.0 - one) - hz) + (z * r - x * y))
}

/// `x` less the nearest multiple `n` of π/2, as two f64s (y0 + y1, |y0| <= π/4 about), and
/// `n`: __rem_pio2's reduction for |x| < 2^20·π/2.
fn d_reduce(x: f64) -> (f64, f64, i32) {
    assert(d_high(x) < 0x413921fb, f"sin_f64 and cos_f64 take |x| < 2^20·π/2, not {x}")
    var fn_ = x * D_INV_PIO2 + D_TOINT - D_TOINT
    var n = i32(fn_)
    var r = x - fn_ * D_PIO2_1
    var w = fn_ * D_PIO2_1T
    if r - w < -D_PIO4 {
        n -= 1
        fn_ -= 1.0
        r = x - fn_ * D_PIO2_1
        w = fn_ * D_PIO2_1T
    } else if r - w > D_PIO4 {
        n += 1
        fn_ += 1.0
        r = x - fn_ * D_PIO2_1
        w = fn_ * D_PIO2_1T
    }
    var y0 = r - w
    let ex = d_high(x) >> 20
    var ey = u32((bitcast_u64(y0) >> 52) & 0x7ff)
    if ex > ey + 16 {
        var t = r
        w = fn_ * D_PIO2_2
        r = t - w
        w = fn_ * D_PIO2_2T - ((t - r) - w)
        y0 = r - w
        ey = u32((bitcast_u64(y0) >> 52) & 0x7ff)
        if ex > ey + 49 {
            t = r
            w = fn_ * D_PIO2_3
            r = t - w
            w = fn_ * D_PIO2_3T - ((t - r) - w)
            y0 = r - w
        }
    }
    (y0, (r - y0) - w, n)
}

/// The sine of `x`, in radians, |x| < 2^20·π/2.
pub fn sin_f64(x: f64) -> f64 {
    if d_high(x) <= 0x3fe921fb {
        if d_high(x) < 0x3e500000 {
            return x
        }
        return d_sin_kernel(x, 0.0, tail: false)
    }
    let (a, b, n) = d_reduce(x)
    let q = n & 3
    if q == 0 {
        d_sin_kernel(a, b, tail: true)
    } else if q == 1 {
        d_cos_kernel(a, b)
    } else if q == 2 {
        -d_sin_kernel(a, b, tail: true)
    } else {
        -d_cos_kernel(a, b)
    }
}

/// The cosine of `x`, in radians, |x| < 2^20·π/2.
pub fn cos_f64(x: f64) -> f64 {
    if d_high(x) <= 0x3fe921fb {
        if d_high(x) < 0x3e46a09e {
            return 1.0
        }
        return d_cos_kernel(x, 0.0)
    }
    let (a, b, n) = d_reduce(x)
    let q = n & 3
    if q == 0 {
        d_cos_kernel(a, b)
    } else if q == 1 {
        -d_sin_kernel(a, b, tail: true)
    } else if q == 2 {
        -d_cos_kernel(a, b)
    } else {
        d_sin_kernel(a, b, tail: true)
    }
}

/// The angle whose tangent is `x`, in [-π/2, π/2].
pub fn atan_f64(x: f64) -> f64 {
    if x != x {
        return x
    }
    let neg = x < 0.0
    var a = abs(x)
    if a > 100000000000000000000.0 {
        return if neg { -D_ATAN_HI[3] } else { D_ATAN_HI[3] }
    }
    if a < 0.0000000074505805969238281 {
        return x
    }
    var id: i32 = -1
    if a >= 0.4375 {
        if a < 0.6875 {
            id = 0
            a = (2.0 * a - 1.0) / (2.0 + a)
        } else if a < 1.1875 {
            id = 1
            a = (a - 1.0) / (a + 1.0)
        } else if a < 2.4375 {
            id = 2
            a = (a - 1.5) / (1.0 + 1.5 * a)
        } else {
            id = 3
            a = -1.0 / a
        }
    }
    let z = a * a
    let w = z * z
    let s1 = z *
        (D_AT[0] + w * (D_AT[2] + w * (D_AT[4] + w * (D_AT[6] + w * (D_AT[8] + w * D_AT[10])))))
    let s2 = w * (D_AT[1] + w * (D_AT[3] + w * (D_AT[5] + w * (D_AT[7] + w * D_AT[9]))))
    let r = if id < 0 {
        a - a * (s1 + s2)
    } else {
        D_ATAN_HI[u32(id)] - ((a * (s1 + s2) - D_ATAN_LO[u32(id)]) - a)
    }
    if neg {
        -r
    } else {
        r
    }
}

fn d_sign_bit(x: f64) -> bool {
    (bitcast_u64(x) >> 63) == 1
}

/// The angle from the positive x axis to the point (`x`, `y`), in [-π, π].
pub fn atan2_f64(y: f64, x: f64) -> f64 {
    if x != x || y != y {
        return x + y
    }
    if x == 1.0 {
        return atan_f64(y)
    }
    if y == 0.0 {
        if !d_sign_bit(x) {
            return y
        }
        return if d_sign_bit(y) { -PI_F64 } else { PI_F64 }
    }
    if x == 0.0 {
        return if y > 0.0 { 0.5 * PI_F64 } else { -0.5 * PI_F64 }
    }
    let inf = 1.0 / 0.0
    if abs(x) == inf {
        if abs(y) == inf {
            let q = if x > 0.0 { 0.25 * PI_F64 } else { 0.75 * PI_F64 }
            return if y > 0.0 { q } else { -q }
        }
        let q = if x > 0.0 { 0.0 } else { PI_F64 }
        return if y > 0.0 { q } else { -q }
    }
    if abs(y) == inf {
        return if y > 0.0 { 0.5 * PI_F64 } else { -0.5 * PI_F64 }
    }
    let ex = d_high(x) >> 20
    let ey = d_high(y) >> 20
    // |y/x| past 2^60, or below 2^-60 with x < 0: atan's own limits.
    let z = if ey > ex + 60 {
        0.5 * PI_F64 + 0.5 * D_PI_LO
    } else if x < 0.0 && ex > ey + 60 {
        0.0
    } else {
        atan_f64(abs(y / x))
    }
    if x > 0.0 {
        return if y > 0.0 { z } else { -z }
    }
    if y > 0.0 {
        PI_F64 - (z - D_PI_LO)
    } else {
        (z - D_PI_LO) - PI_F64
    }
}

/// `y` times 2^`n`.
fn d_scaled(y: f64, n: i32) -> f64 {
    var v = y
    var k = n
    if k > 1023 {
        v *= bitcast_f64(u64(0x7FE0000000000000))
        k -= 1023
        if k > 1023 {
            v *= bitcast_f64(u64(0x7FE0000000000000))
            k = min(k - 1023, 1023)
        }
    } else if k < -1022 {
        // 2^-1022 · 2^53, so a subnormal result is rounded once.
        v *= bitcast_f64(u64(0x0360000000000000))
        k += 969
        if k < -1022 {
            v *= bitcast_f64(u64(0x0360000000000000))
            k = max(k + 969, -1022)
        }
    }
    v * bitcast_f64(u64(k + 1023) << 52)
}

/// e to the power `x`.
pub fn exp_f64(x: f64) -> f64 {
    if x != x {
        return x
    }
    if x > 709.782712893383973096 {
        return 1.0 / 0.0
    }
    if x < -745.13321910194110842 {
        return 0.0
    }
    let ax = abs(x)
    var k: i32 = 0
    var hi = x
    var lo = 0.0
    var r = x
    if ax > 0.5 * 0.693147180559945286227 {
        if ax >= 1.5 * 0.693147180559945286227 {
            k = i32(D_INV_LN2 * x + if x < 0.0 { -0.5 } else { 0.5 })
        } else {
            k = if x < 0.0 { -1 } else { 1 }
        }
        hi = x - f64(k) * D_LN2_HI
        lo = f64(k) * D_LN2_LO
        r = hi - lo
    } else if ax <= 0.0000000037252902984619141 {
        return 1.0 + x
    }
    let xx = r * r
    let c = r - xx * (D_P1 + xx * (D_P2 + xx * (D_P3 + xx * (D_P4 + xx * D_P5))))
    let y = 1.0 + (r * c / (2.0 - c) - lo + hi)
    if k == 0 {
        y
    } else {
        d_scaled(y, k)
    }
}

/// `a` as two halves of 26 bits (Veltkamp's split), for exact products.
fn d_split(a: f64) -> (f64, f64) {
    let c = 134217729.0 * a
    let hi = c - (c - a)
    (hi, a - hi)
}

/// `a * b`, and its rounding error: the two sum to the exact product (Dekker).
fn d_two_product(a: f64, b: f64) -> (f64, f64) {
    let p = a * b
    let (ah, al) = d_split(a)
    let (bh, bl) = d_split(b)
    (p, ((ah * bh - p) + ah * bl + al * bh) + al * bl)
}

/// `a + b`, and its rounding error (Knuth).
fn d_two_sum(a: f64, b: f64) -> (f64, f64) {
    let s = a + b
    let bb = s - a
    (s, (a - (s - bb)) + (b - bb))
}

/// The natural logarithm of a positive, finite `x`, as two f64s whose sum is within about 2^-62
/// of it, relatively: log's reduction to 2^k (1 + f), with f - f²/2 and the sum carried exactly.
fn d_log_parts(x: f64) -> (f64, f64) {
    var bits = bitcast_u64(x)
    var hx = u32(bits >> 32)
    var k: i32 = 0
    if hx < 0x00100000 {
        // A subnormal: scaled up by 2^54 first.
        k -= 54
        bits = bitcast_u64(x * 18014398509481984.0)
        hx = u32(bits >> 32)
    }
    hx += 0x3ff00000 - 0x3fe6a09e
    k += i32(hx >> 20) - 0x3ff
    hx = (hx & 0x000fffff) + 0x3fe6a09e
    let m = bitcast_f64((u64(hx) << 32) | (bits & 0xffffffff))
    let f = m - 1.0
    let (ff, ffe) = d_two_product(f, f)
    let hfsq = 0.5 * ff
    let s = f / (2.0 + f)
    let z = s * s
    let w = z * z
    let t1 = w * (D_LG2 + w * (D_LG4 + w * D_LG6))
    let t2 = z * (D_LG1 + w * (D_LG3 + w * (D_LG5 + w * D_LG7)))
    let dk = f64(k)
    let small = s * (hfsq + t2 + t1) + dk * D_LN2_LO
    let (a, ae) = d_two_sum(f, -hfsq)
    let (b, be) = d_two_sum(dk * D_LN2_HI, a)
    d_two_sum(b, be + ae - 0.5 * ffe + small)
}

/// The natural logarithm of `x`: minus infinity at 0, NaN below 0.
pub fn log_f64(x: f64) -> f64 {
    if x != x || x == 1.0 / 0.0 {
        return x
    }
    if x == 0.0 {
        return -1.0 / 0.0
    }
    if x < 0.0 {
        return (x - x) / (x - x)
    }
    let (hi, lo) = d_log_parts(x)
    hi + lo
}

/// log's two parts times `c` (in two parts too): the product rounded once.
fn d_log_times(x: f64, c: f64, c_lo: f64) -> f64 {
    if x != x || x == 1.0 / 0.0 || x <= 0.0 {
        return log_f64(x)
    }
    let (hi, lo) = d_log_parts(x)
    let (p, pe) = d_two_product(hi, c)
    p + (pe + hi * c_lo + lo * c)
}

/// The logarithm of `x` to base 10: minus infinity at 0, NaN below 0; exact at the powers of 10.
pub fn log10_f64(x: f64) -> f64 {
    d_log_times(x, D_INV_LN10, D_INV_LN10_LO)
}

/// The logarithm of `x` to base 2: minus infinity at 0, NaN below 0; exact at the powers of 2.
pub fn log2_f64(x: f64) -> f64 {
    d_log_times(x, D_INV_LN2, D_INV_LN2_LO)
}

/// `x` to the power `y`, for a positive, finite `x` and a finite `y`: an infinity past f64's
/// range, 0 below it. Its error is exp's, and log's 2^-62 times |y ln x|: within an ulp while
/// |y ln x| is below about 300, within two up to the overflow.
pub fn pow_f64(x: f64, y: f64) -> f64 {
    assert(x > 0.0 && x < 1.0 / 0.0, f"pow_f64 takes a positive, finite base, not {x}")
    if y == 0.0 || x == 1.0 {
        return 1.0
    }
    // The powers a correctly rounded libm gives exactly, given so: a section's squareness is
    // often held at 1 or 2, and its quadrants' floor is a power of two. Within an ulp of them,
    // fits that turn on the last bits went their own way (the wolf's hind leg, 62% of its
    // surface within 2 mm where the host's libm gave 84%).
    if y == 1.0 {
        return x
    }
    if y == 2.0 {
        return x * x
    }
    if y == -1.0 {
        return 1.0 / x
    }
    if y == 0.5 {
        return sqrt(x)
    }
    if x == 2.0 && y == trunc(y) && abs(y) <= 1000.0 {
        return d_scaled(1.0, i32(y))
    }
    let (hi, lo) = d_log_parts(x)
    // Past exp's range, the power is too: an infinity or 0, before the compensated product,
    // whose splits would overflow (y beyond 2^996 or so) and make a NaN of it.
    let rough = y * hi
    if rough > 710.0 {
        return 1.0 / 0.0
    }
    if rough < -746.0 {
        return 0.0
    }
    let (p, pe) = d_two_product(y, hi)
    let (q, qe) = d_two_sum(p, pe + y * lo)
    let e = exp_f64(q)
    // Overflowed or flushed to 0 at the boundary: the correction would make inf · 0 a NaN.
    if e == 1.0 / 0.0 || e == 0.0 {
        return e
    }
    e + e * qe
}

/// How many representable f64s apart `a` and `b` are, if they have one sign (else the most).
fn d_apart(a: f64, b: f64) -> u64 {
    let x = bitcast_u64(a)
    let y = bitcast_u64(b)
    if (x >> 63) != (y >> 63) {
        return if a == 0.0 && b == 0.0 { 0 } else { 18446744073709551615 }
    }
    if x > y { x - y } else { y - x }
}

@test
fn powers_past_the_range_are_infinite_or_zero() {
    let inf = 1.0 / 0.0
    let cases: [(f64, f64, f64); 9] = [
        (10.0, 400.0, inf),
        (2.0, 1025.0, inf),
        (2.0, 1e308, inf),
        (0.5, -1e308, inf),
        (10.0, -400.0, 0.0),
        (2.0, -1e308, 0.0),
        (0.5, 1e308, 0.0),
        (1.0000001, 1e300, inf),
        (1.0000001, -1e300, 0.0),
    ]
    for (x, y, want) in cases {
        let got = pow_f64(x, y: y)
        assert(got == want, f"{x}^{y}: {got}")
    }
    // Near the overflow and the subnormal boundaries, libm's (macOS's) values: to a bit, or two
    // where |y ln x| nears 709 (log's 2^-62 error, times y).
    let near: [(f64, f64, u64); 12] = [
        (10.0, 308.25, u64(0x7FEFA788589D81D3)),
        (10.0, -307.9, u64(0x00090D7A3A04564B)),
        (10.0, -310.0, u64(0x000012688B70E62B)),
        (10.0, -323.5, u64(0x0000000000000001)),
        (2.0, -1074.0, u64(0x0000000000000001)),
        (2.0, 1023.9, u64(0x7FEDDB680117AA8E)),
        (1.0000001, 7000000000.0, u64(0x7F0D941AE6E762D4)),
        (0.9999999, 7000000000.0, u64(0x00D14F03C6DBC57F)),
        (7.0, 364.7, u64(0x7FECAFF29E2D5797)),
        (7.0, -382.5, u64(0x0000000000000001)),
        (3.0, 646.0, u64(0x7FED906A378B5987)),
        (3.0, -679.0, u64(0x0000000000000000)),
    ]
    for (x, y, bits) in near {
        let got = pow_f64(x, y: y)
        assert(d_apart(got, bitcast_f64(bits)) <= 2, f"{x}^{y}: {got} against {bitcast_f64(bits)}")
    }
}

/// How many of `want`'s ulps `got` is from it.
fn d_ulps(got: f64, want: f64) -> f64 {
    abs(got - want) / max(abs(want) * 0.0000000000000002220446049250313, 0.0)
}

@test
fn the_f64_functions_are_within_an_ulp_of_their_values() {
    // Each against the nearest f64 to the true value.
    let cases = [
        (sin_f64(0.5), 0.479425538604203),
        (cos_f64(0.5), 0.8775825618903728),
        (sin_f64(TAU_F64 * 7.0 / 48.0), 0.7933533402912352),
        (cos_f64(100.0), 0.8623188722876839),
        (sin_f64(-3.0), -0.1411200080598672),
        (cos_f64(1000000.0), 0.9367521275331447),
        (atan2_f64(y: 1.0, x: 1.0), 0.7853981633974483),
        (atan2_f64(y: -1.0, x: -2.0), -2.677945044588987),
        (atan2_f64(y: 0.0, x: -1.0), PI_F64),
        (exp_f64(1.0), 2.718281828459045),
        (exp_f64(-700.0), 9.85967654375977e-305),
        (log_f64(10.0), 2.302585092994046),
        (log10_f64(2.0), 0.3010299956639812),
        (log10_f64(0.00007), -4.154901959985743),
        (log2_f64(10.0), 3.321928094887362),
        (log2_f64(1.5), 0.5849625007211562),
        (pow_f64(x: 2.0, y: 0.5), 1.4142135623730951),
        (pow_f64(x: 0.001, y: 3.5), 0.000000000031622776601683794),
        (pow_f64(x: 7.0, y: -2.25), 0.012546696999005395),
    ]
    for (got, want) in cases {
        assert(d_ulps(got, want) <= 1.0, f"{got} against {want}")
    }
    assert(sin_f64(0.0) == 0.0 && cos_f64(0.0) == 1.0 && exp_f64(0.0) == 1.0 && log_f64(1.0) == 0.0)
    assert(log10_f64(1000.0) == 3.0 && log10_f64(0.01) == -2.0 && log2_f64(1024.0) == 10.0)
    assert(log10_f64(0.0) == -1.0 / 0.0 && log2_f64(0.125) == -3.0)
    // Exact where the power is.
    let x = 0.123456789
    assert(pow_f64(x, y: 1.0) == x && pow_f64(x, y: 2.0) == x * x && pow_f64(x, y: -1.0) == 1.0 / x)
    assert(
        pow_f64(x, y: 0.5) == sqrt(x) &&
            pow_f64(2.0, y: -3.0) == 0.125 &&
            pow_f64(2.0, y: 10.0) == 1024.0,
    )
}

