// Parallel work (language.md §6.12, §6.17, D-062). A parallel job's chunks run on the thread that
// starts it and on the program's helpers; a task (`spawn`) runs on a helper, or on the thread
// that takes it. Every thread runs its own instance of the program, and they share memory
// (wrela_abi::memory's threads).
//
// - Each thread that starts a parallel job has its own descriptor, in its block, so the jobs
//   that the program's thread and its ticker start at once don't collide. Helpers claim a job's
//   chunks with a compare-and-swap on its ticket (the generation's low 16 bits, then the next
//   chunk), so a late helper can't claim another job's chunk.
// - Results don't depend on the helpers: a job's chunks are fixed by its size alone, each
//   writes only its own part, and what's reduced is combined in chunk order.
// - A parallel job started inside a chunk runs on that thread alone, chunk after chunk.
// - A task waits in a slot until a helper starts it, or the thread that joins it does. A
//   trap in a task on a helper is kept in its slot, and `join` raises it.
//
// The words hosts use are wrela_abi's (`std::abi`).

use std::abi::{
    DEPTH, JOB_CHUNKS, JOB_CONTEXT, JOB_DONE, JOB_DONE_FAILED, JOB_FAILED, JOB_GENERATION,
    TASK_SLOTS, TASK_SLOT_COUNT, TASK_SLOT_SIZE, JOB_TASK, JOB_TICKET, JOIN_WAITS, PAR_HELPED,
    PAR_HOLD, PAR_SHUTDOWN, PAR_WAKE, RUNNING, SLOT_FAILED, SLOT_FREE, SLOT_THREAD, THREADS,
    THREAD_BLOCKS, THREAD_BLOCK_SIZE,
}
use std::alloc::{free, place}
use std::collections::replace
use std::mem::{
    abort_from, atomic_add, atomic_load, atomic_store, compare_swap, count, load_u32, notify, read,
    run_task, size_of, store_u32, task, thread_block, wait, wait_for, write,
}

// A task's slot: its words and states that are std's own (the state is its first word).
const SLOT_TASK: u32 = 4
const SLOT_CONTEXT: u32 = 8
const FILLING: u32 = 1
const QUEUED: u32 = 2
const STARTED: u32 = 3
const FINISHED: u32 = 4

/// The most chunks a job has: the ticket counts them in 16 bits.
pub(package) const MAX_CHUNKS: u32 = 4096

/// Runs `par_each_chunk(chunk, chunks, xs, f)` for each chunk below `chunks` (at most
/// `MAX_CHUNKS`), on this thread and on the helpers, and returns when every one is done. The
/// compiler makes a task of it, which reads its arguments (`f`'s captures among them) from a
/// context on this thread's stack.
@intrinsic
pub(package) fn par_each<T>(chunks: u32, xs: mut Vec<T>, f: @parallel fn(mut T)) {}

/// Chunk `chunk` of `chunks` of a `par_each`: its elements, each `f`'d in order.
pub(package) fn par_each_chunk<T>(chunk: u32, chunks: u32, xs: mut Vec<T>, f: @parallel fn(mut T)) {
    let n = xs.len()
    let size = (n + chunks - 1) / chunks
    let end = min(n, (chunk + 1) * size)
    for i in chunk * size..end {
        f(mut xs[i])
    }
}

/// As `par_each`, for `par_map_reduce_chunk`.
@intrinsic
pub(package) fn par_map_reduce<T, R: Clone>(
    chunks: u32,
    xs: Vec<T>,
    init: R,
    map: @parallel fn(T) -> R,
    reduce: @parallel fn(R, R) -> R,
    partial: mut Vec<R>,
) {}

/// Chunk `chunk` of `chunks` of a `par_map_reduce`: its elements `map`ped and folded from
/// `init` in order, into `partial[chunk]`.
pub(package) fn par_map_reduce_chunk<T, R: Clone>(
    chunk: u32,
    chunks: u32,
    xs: Vec<T>,
    init: R,
    map: @parallel fn(T) -> R,
    reduce: @parallel fn(R, R) -> R,
    partial: mut Vec<R>,
) {
    let n = xs.len()
    let size = (n + chunks - 1) / chunks
    var acc = init.clone()
    let end = min(n, (chunk + 1) * size)
    for i in chunk * size..end {
        acc = reduce(acc, map(xs[i]))
    }
    partial[chunk] = take acc
}

/// Wakes the helpers: work has appeared.
fn wake() {
    unsafe {
        let _ = atomic_add(PAR_WAKE, 1)
        let _ = notify(PAR_WAKE, 4294967295)
    }
}

/// The job a `par_each` or `par_map_reduce` starts: task `task`, with its context at `ctx`,
/// on chunks below `n`.
pub(package) fn run_chunks(task: u32, ctx: u32, n: u32) {
    if n == 0 {
        return
    }
    unsafe {
        let me = thread_block()
        if load_u32(me + DEPTH) > 0 {
            // Inside another job's chunk: this thread alone, chunk after chunk.
            for c in 0..n {
                run_task(task, ctx, c)
            }
            return
        }
        let gen = atomic_load(me + JOB_GENERATION) + 1
        // The new ticket first: a late helper's claim on this thread's last job fails from
        // here on.
        atomic_store(me + JOB_TICKET, (gen & 65535) << 16)
        atomic_store(me + JOB_TASK, task)
        atomic_store(me + JOB_CONTEXT, ctx)
        atomic_store(me + JOB_CHUNKS, n)
        atomic_store(me + JOB_DONE, 0)
        atomic_store(me + JOB_GENERATION, gen)
        wake()
        let _ = claim(me, helping: false)
        loop {
            let done = atomic_load(me + JOB_DONE)
            // A helper trapped: its host set JOB_FAILED, then the top bit of JOB_DONE, so this
            // sees it before it could wait. Its panic message is the program's.
            if done >= JOB_DONE_FAILED {
                abort_from(atomic_load(me + JOB_FAILED) - 1)
            }
            if done >= n {
                return
            }
            let _ = wait(me + JOB_DONE, done)
        }
    }
}

/// Claims and runs the chunks of the parallel job in the block at `owner` until none are left,
/// or it has started another. A helper counts the chunks it runs. Whether it ran any.
fn claim(owner: u32, helping: bool) -> bool {
    unsafe {
        let me = thread_block()
        let g16 = atomic_load(owner + JOB_GENERATION) & 65535
        var ran = false
        loop {
            let t = atomic_load(owner + JOB_TICKET)
            if t >> 16 != g16 || t & 65535 >= atomic_load(owner + JOB_CHUNKS) {
                return ran
            }
            if compare_swap(owner + JOB_TICKET, t, t + 1) == t {
                // Only this thread writes its own depth.
                store_u32(me + DEPTH, load_u32(me + DEPTH) + 1)
                atomic_store(me + RUNNING, owner)
                run_task(atomic_load(owner + JOB_TASK), atomic_load(owner + JOB_CONTEXT), t & 65535)
                atomic_store(me + RUNNING, 0)
                store_u32(me + DEPTH, load_u32(me + DEPTH) - 1)
                if helping {
                    let _ = atomic_add(PAR_HELPED, 1)
                }
                let _ = atomic_add(owner + JOB_DONE, 1)
                let _ = notify(owner + JOB_DONE, 1)
                ran = true
            }
        }
    }
}

/// A helper's life (wrela_abi's `__worker`): wait for work, run it, until the host shuts it
/// down.
@thread_entry
pub(package) fn worker(thread: u32) {
    unsafe {
        loop {
            // Before each wait too: a helper that starts after the host shut it down would
            // otherwise wait for good.
            if atomic_load(PAR_SHUTDOWN) != 0 {
                return
            }
            let seen = atomic_load(PAR_WAKE)
            if !find_work() {
                if atomic_load(PAR_SHUTDOWN) != 0 {
                    return
                }
                let _ = wait(PAR_WAKE, seen)
            }
        }
    }
}

/// Runs work that's waiting: chunks of any thread's parallel job first (a frame or a tick waits
/// for them), else one task. Whether there was any.
fn find_work() -> bool {
    var ran = false
    for t in 0..THREADS {
        ran = claim(THREAD_BLOCKS + t * THREAD_BLOCK_SIZE, helping: true) || ran
    }
    if ran {
        return true
    }
    unsafe {
        for s in 0..TASK_SLOT_COUNT {
            let slot = TASK_SLOTS + s * TASK_SLOT_SIZE
            if atomic_load(slot) == QUEUED && compare_swap(slot, QUEUED, STARTED) == QUEUED {
                run_spawned(slot, held: true)
                return true
            }
        }
    }
    false
}

/// Runs the task in `slot`, which this thread has started, and marks it finished. A helper
/// holds its result back for as long as the host asks (`PAR_HOLD`, microseconds: tests slow jobs).
fn run_spawned(slot: u32, held: bool) {
    unsafe {
        let me = thread_block()
        atomic_store(slot + SLOT_THREAD, (me - THREAD_BLOCKS) / THREAD_BLOCK_SIZE)
        atomic_store(me + RUNNING, slot)
        run_task(atomic_load(slot + SLOT_TASK), atomic_load(slot + SLOT_CONTEXT), 0)
        atomic_store(me + RUNNING, 0)
        let hold = atomic_load(PAR_HOLD)
        if held && hold > 0 {
            // Nothing notifies the slot while it's started: a sleep.
            let _ = wait_for(slot, STARTED, hold)
        }
        atomic_store(slot, FINISHED)
        let _ = notify(slot, 4294967295)
    }
}

/// A task's input, its function and where its result goes, on the heap.
struct TaskContext<I, O, F> {
    input: Option<I>,
    f: Option<F>,
    out: u32,
}

/// A task: `f(input)`, running on a helper. `join` gives its result.
pub struct Task<O> {
    /// Its slot's address, or 0 if it ran when it was made (every slot was taken).
    slot: u32,
    context: u32,
    context_size: u32,
    /// Where its result goes: an `Option<O>`.
    out: u32,
}

/// Starts `f(input)` on a helper: a task, which holds that helper while it runs. Its result
/// is a function of `input` alone (`f` is `@deterministic`), whichever thread runs it and
/// whenever; `join` it. A task no helper has started yet runs inside `join`, so with no helpers
/// every task runs there, and a task that joins another can't deadlock.
///
/// ```wrela
/// use std::par::spawn
///
/// fn checksum(data: take Vec<u32>) -> u32 {
///     var h: u32 = 2166136261
///     for x in data {
///         h = (h ^ x).wrapping_mul(16777619)
///     }
///     h
/// }
///
/// pub fn verify() -> u32 {
///     var data: Vec<u32> = Vec::new()
///     for i in 0..100000 {
///         data.push(i)
///     }
///     let pending = spawn(take data, checksum)   // a helper hashes while this thread goes on
///     take pending.join()
/// }
/// ```
pub fn spawn<I, O, F: @deterministic fn(take I) -> O>(input: take I, f: F) -> Task<O> {
    unsafe {
        let none: Option<O> = None
        let out = place(take none)
        let c: TaskContext<I, O, F> = TaskContext { input: Some(take input), f: Some(f), out }
        let context = place(take c)
        let size = size_of::<TaskContext<I, O, F>>()
        let t = task(run_task_context::<I, O, F>)
        for s in 0..TASK_SLOT_COUNT {
            let slot = TASK_SLOTS + s * TASK_SLOT_SIZE
            if compare_swap(slot, SLOT_FREE, FILLING) == SLOT_FREE {
                atomic_store(slot + SLOT_TASK, t)
                atomic_store(slot + SLOT_CONTEXT, context)
                atomic_store(slot, QUEUED)
                wake()
                return Task { slot, context, context_size: size, out }
            }
        }
        // Every slot is taken: it runs now, here.
        run_task(t, context, 0)
        Task { slot: 0, context, context_size: size, out }
    }
}

/// A task's work: its function on its input, the result where it goes. Its input and
/// function are dropped here, so its context owns nothing after.
fn run_task_context<I, O, F: @deterministic fn(take I) -> O>(
    chunk: u32,
    c: mut TaskContext<I, O, F>,
) {
    let Some(input) = replace(mut c.input, None) else {
        panic("a job ran twice")
    }
    let Some(f) = replace(mut c.f, None) else {
        panic("a job ran twice")
    }
    let result: Option<O> = Some(f(take input))
    unsafe {
        write(c.out, take result)
    }
}

impl<O> Task<O> {
    /// Whether the task has finished. It's `nondet` (§8): it depends on when a helper ran it.
    @effects(nondet)
    pub fn done(self) -> bool {
        unsafe { self.slot == 0 || atomic_load(self.slot) >= FINISHED }
    }

    /// The task's result, once it's finished: this thread waits for it, and runs it here if no
    /// helper has started it. Its value doesn't depend on timing. A trap in the task is the
    /// program's panic, here.
    pub fn join(take self) -> O {
        unsafe {
            if self.slot != 0 {
                loop {
                    let state = atomic_load(self.slot)
                    if state == QUEUED {
                        if compare_swap(self.slot, QUEUED, STARTED) == QUEUED {
                            run_spawned(self.slot, held: false)
                        }
                    } else if state == STARTED {
                        // Counted for the hosts, which log a ticker's waits.
                        count(JOIN_WAITS, 1)
                        let _ = wait(self.slot, STARTED)
                    } else if state == SLOT_FAILED {
                        // Its host wrote the helper's number, and the helper's panic message is
                        // still in its block: it runs nothing more.
                        abort_from(atomic_load(self.slot + SLOT_THREAD))
                    } else {
                        break
                    }
                }
                atomic_store(self.slot, SLOT_FREE)
            }
            let result = read::<Option<O>>(self.out)
            free(self.out, size_of::<Option<O>>())
            free(self.context, self.context_size)
            match take result {
                Some(x) => x,
                None => panic("a job finished with no result"),
            }
        }
    }
}

/// How many chunks a job over `n` elements has: about 64 elements each, at most `MAX_CHUNKS`.
/// It depends on `n` alone, so a job's results don't depend on how many helpers there are.
pub(package) fn chunks_for(n: u32) -> u32 {
    let k = (n + 63) / 64
    if k > MAX_CHUNKS { MAX_CHUNKS } else { k }
}
