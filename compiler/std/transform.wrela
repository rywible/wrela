// Transforms as matrices, on the CPU and the GPU alike: what a skeleton, a camera or a shadow
// map is built from. WebGPU's conventions: a right-handed world with +y up; column-major
// matrices that multiply column vectors, so `a * b` applies `b` first and a point is
// `m * vec4(p, 1.0)`; clip space x and y in [-1, 1] and depth in [0, 1].

use std::quat::Quat

/// No change.
pub fn identity() -> mat4 {
    mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
}

/// A translation by `t`.
pub fn translate(t: vec3) -> mat4 {
    mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(t, 1.0))
}

/// A scale by `s` along each axis.
pub fn scale(s: vec3) -> mat4 {
    mat4(
        vec4(s.x, 0.0, 0.0, 0.0),
        vec4(0.0, s.y, 0.0, 0.0),
        vec4(0.0, 0.0, s.z, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
}

/// A rotation by `angle` radians about +x, right-handed: +y turns toward +z.
pub fn rotate_x(angle: f32) -> mat4 {
    let (c, s) = (cos(angle), sin(angle))
    mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, c, s, 0.0),
        vec4(0.0, -s, c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
}

/// A rotation by `angle` radians about +y, right-handed: +z turns toward +x.
pub fn rotate_y(angle: f32) -> mat4 {
    let (c, s) = (cos(angle), sin(angle))
    mat4(
        vec4(c, 0.0, -s, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(s, 0.0, c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
}

/// A rotation by `angle` radians about +z, right-handed: +x turns toward +y.
pub fn rotate_z(angle: f32) -> mat4 {
    let (c, s) = (cos(angle), sin(angle))
    mat4(
        vec4(c, s, 0.0, 0.0),
        vec4(-s, c, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
}

/// A rotation by `angle` radians about `axis` (any nonzero length), right-handed.
pub fn rotate(axis: vec3, angle: f32) -> mat4 {
    from_mat3(Quat::axis_angle(axis, angle).to_mat3())
}

/// `m`, a rotation or a scale, as a transform that moves nothing.
pub fn from_mat3(m: mat3) -> mat4 {
    mat4(vec4(m[0], 0.0), vec4(m[1], 0.0), vec4(m[2], 0.0), vec4(0.0, 0.0, 0.0, 1.0))
}

/// The view from `eye` toward `at`, with `up` up: world space to a camera's, which looks
/// along its -z with +y up.
pub fn look_at(eye: vec3, at: vec3, up: vec3 = vec3(0.0, 1.0, 0.0)) -> mat4 {
    let z = normalize(eye - at)
    let x = normalize(cross(up, z))
    let y = cross(z, x)
    mat4(
        vec4(x.x, y.x, z.x, 0.0),
        vec4(x.y, y.y, z.y, 0.0),
        vec4(x.z, y.z, z.z, 0.0),
        vec4(-dot(x, eye), -dot(y, eye), -dot(z, eye), 1.0),
    )
}

/// A perspective projection `fovy` radians high and `aspect` times as wide: depth 0 at `near`,
/// 1 at `far`.
pub fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4 {
    let f = 1.0 / tan(fovy / 2.0)
    mat4(
        vec4(f / aspect, 0.0, 0.0, 0.0),
        vec4(0.0, f, 0.0, 0.0),
        vec4(0.0, 0.0, far / (near - far), -1.0),
        vec4(0.0, 0.0, near * far / (near - far), 0.0),
    )
}

/// An orthographic projection of the box from (`left`, `bottom`, -`near`) to (`right`, `top`,
/// -`far`): depth 0 at `near`, 1 at `far`.
pub fn ortho(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) -> mat4 {
    mat4(
        vec4(2.0 / (right - left), 0.0, 0.0, 0.0),
        vec4(0.0, 2.0 / (top - bottom), 0.0, 0.0),
        vec4(0.0, 0.0, 1.0 / (near - far), 0.0),
        vec4(
            -(right + left) / (right - left),
            -(top + bottom) / (top - bottom),
            near / (near - far),
            1.0,
        ),
    )
}

// ---- tests ------------------------------------------------------------------------------------

fn near(a: vec3, b: vec3) -> bool {
    length(a - b) < 0.00001
}

/// `m` applied to the point `p`, divided through by w.
fn apply(m: mat4, p: vec3) -> vec3 {
    let q = m * vec4(p, 1.0)
    q.xyz / q.w
}

@test
fn the_rotations_are_right_handed() {
    let q = 1.5707963
    assert(near(apply(rotate_x(q), vec3(0.0, 1.0, 0.0)), vec3(0.0, 0.0, 1.0)))
    assert(near(apply(rotate_y(q), vec3(0.0, 0.0, 1.0)), vec3(1.0, 0.0, 0.0)))
    assert(near(apply(rotate_z(q), vec3(1.0, 0.0, 0.0)), vec3(0.0, 1.0, 0.0)))
    let p = vec3(0.3, -0.7, 1.1)
    assert(near(apply(rotate(vec3(2.0, 0.0, 0.0), 0.4), p), apply(rotate_x(0.4), p)))
    assert(near(apply(translate(p) * scale(vec3(2.0)) * identity(), vec3(1.0)), p + vec3(2.0)))
}

@test
fn a_camera_sees_along_its_minus_z() {
    let eye = vec3(3.0, 2.0, 5.0)
    let at = vec3(0.0, 1.0, 0.0)
    let v = look_at(eye, at)
    assert(near(apply(v, eye), vec3(0.0)))
    let d = apply(v, at)
    assert(abs(d.x) < 0.00001 && abs(d.y) < 0.00001 && d.z < 0.0)
    // Near maps to depth 0 and far to 1, at the edges of the view.
    let p = perspective(fovy: 1.0, aspect: 2.0, near: 0.5, far: 100.0)
    assert(abs(apply(p, vec3(0.0, 0.0, -0.5)).z) < 0.00001)
    assert(abs(apply(p, vec3(0.0, 0.0, -100.0)).z - 1.0) < 0.00001)
    let top = apply(p, vec3(0.0, tan(0.5) * 10.0, -10.0))
    assert(abs(top.y - 1.0) < 0.00001)
    let o = ortho(left: -2.0, right: 4.0, bottom: -1.0, top: 3.0, near: 1.0, far: 9.0)
    assert(near(apply(o, vec3(-2.0, -1.0, -1.0)), vec3(-1.0, -1.0, 0.0)))
    assert(near(apply(o, vec3(4.0, 3.0, -9.0)), vec3(1.0, 1.0, 1.0)))
}
