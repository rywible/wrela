// Arenas and handles, for long-lived relationships between values, and `SortedMap`, a map in
// key order (language.md §6.8). An `Arena<T>` owns values; a `Handle<T>` names one of them by
// index and generation, is `Copy` and `Plain`, and can be stored anywhere, saved and hashed.
// `arena[h]` projects the value (borrow or `mut`, by context), and a handle whose value was
// removed panics there; `arena.contains(h)` checks first.
//
// The values are kept one after another, so `for x in arena` walks them in a deterministic
// order: the order they were inserted, except that removing one moves the last into its place.
// Nothing depends on an address.

use std::hash::StateHash
use std::serialize::{LoadError, Reader, Serialize, Writer, load, save}
use std::collections::Pair

/// A value in an `Arena<T>`: which slot, and which use of that slot.
pub struct Handle<T>: Copy + Eq + Ord + StateHash + Plain {
    index: u32,
    gen: u32,
}

impl<T> Serialize for Handle<T> {
    fn serialize(self, w: mut Writer) {
        w.write_str("index")
        self.index.serialize(mut w)
        w.write_str("gen")
        self.gen.serialize(mut w)
    }

    fn deserialize(r: mut Reader) -> Result<Handle<T>, LoadError> {
        r.expect_name("index")?
        let index = u32::deserialize(mut r)?
        r.expect_name("gen")?
        let gen = u32::deserialize(mut r)?
        // Arenas use odd generations only while a slot owns a value. An even generation can
        // otherwise make `contains` accept a free slot after a hostile save is loaded.
        if gen & 1 == 0 {
            return Err(r.fail("a handle's saved generation isn't occupied"))
        }
        Ok(Handle { index, gen })
    }
}

impl<T> Handle<T> {
    /// The slot's number, for display and debugging.
    pub fn index(self) -> u32 {
        self.index
    }
}

/// A slot: its generation (odd while a value is in it), and where its value is (or, when it's
/// free, the next free slot plus one).
struct Slot: Copy + Eq + StateHash + Serialize {
    gen: u32,
    at: u32,
}

/// Values with handles. Iterates in a deterministic order.
///
/// ```wrela
/// struct Grazer: Clone {
///     age: f32,
/// }
///
/// var herd: Arena<Grazer> = Arena::new()
/// let h = herd.insert(Grazer { age: 0.0 })
/// herd[h].age += 1.0
/// for mut g in herd {
///     g.age += 1.0
/// }
/// let gone = herd.remove(h)
/// assert(gone.age == 2.0 && herd.is_empty())
/// ```
pub struct Arena<T>: Clone + StateHash {
    // The compiler indexes an arena in place: these fields, in this order.
    values: Vec<T>,
    slots: Vec<Slot>,
    /// Each value's slot, by position.
    owners: Vec<u32>,
    /// The first free slot plus one; 0 when there's none.
    free: u32,
}

impl<T: Serialize> Serialize for Arena<T> {
    fn serialize(self, w: mut Writer) {
        w.write_str("values")
        self.values.serialize(mut w)
        w.write_str("slots")
        self.slots.serialize(mut w)
        w.write_str("owners")
        self.owners.serialize(mut w)
        w.write_str("free")
        self.free.serialize(mut w)
    }

    fn deserialize(r: mut Reader) -> Result<Arena<T>, LoadError> {
        r.expect_name("values")?
        let values = Vec::<T>::deserialize(mut r)?
        r.expect_name("slots")?
        let slots = Vec::<Slot>::deserialize(mut r)?
        r.expect_name("owners")?
        let owners = Vec::<u32>::deserialize(mut r)?
        r.expect_name("free")?
        let free = u32::deserialize(mut r)?

        if values.len() != owners.len() || free > slots.len() {
            return Err(r.fail("the arena's saved indexes are inconsistent"))
        }
        for at in 0..owners.len() {
            let i = owners[at]
            if i >= slots.len() || slots[i].gen & 1 == 0 || slots[i].at != at {
                return Err(r.fail("the arena's saved indexes are inconsistent"))
            }
        }
        // Every occupied slot names its owner. Every free slot occurs exactly once in the
        // free-list chain: a repeated link eventually takes more steps than there are slots.
        var free_slots = 0
        for i in 0..slots.len() {
            if slots[i].gen & 1 != 0 {
                if slots[i].at >= owners.len() || owners[slots[i].at] != i {
                    return Err(r.fail("the arena's saved indexes are inconsistent"))
                }
            } else {
                free_slots += 1
            }
        }
        var linked = 0
        var next = free
        while next != 0 {
            let i = next - 1
            if i >= slots.len() || slots[i].gen & 1 != 0 || linked == slots.len() {
                return Err(r.fail("the arena's saved free list is inconsistent"))
            }
            linked += 1
            next = slots[i].at
        }
        if linked != free_slots {
            return Err(r.fail("the arena's saved free list is inconsistent"))
        }
        Ok(Arena { values, slots, owners, free })
    }
}

impl<T> Arena<T> {
    /// An empty arena.
    pub fn new() -> Arena<T> {
        Arena { values: Vec::new(), slots: Vec::new(), owners: Vec::new(), free: 0 }
    }

    /// How many values it holds.
    pub fn len(self) -> u32 {
        self.values.len()
    }

    /// Whether it holds no values.
    pub fn is_empty(self) -> bool {
        self.values.len() == 0
    }

    /// Adds `value`; its handle.
    pub fn insert(mut self, value: take T) -> Handle<T> {
        let at = self.values.len()
        self.values.push(take value)
        let index = if self.free != 0 {
            let i = self.free - 1
            self.free = self.slots[i].at
            i
        } else {
            self.slots.push(Slot { gen: 0, at: 0 })
            self.slots.len() - 1
        }
        let gen = self.slots[index].gen.wrapping_add(1)
        self.slots[index] = Slot { gen, at }
        self.owners.push(index)
        Handle { index, gen }
    }

    /// Whether `h`'s value is still here.
    pub fn contains(self, h: Handle<T>) -> bool {
        h.gen & 1 != 0 && h.index < self.slots.len() && self.slots[h.index].gen == h.gen
    }

    /// Takes `h`'s value out. A handle whose value is gone panics.
    pub fn remove(mut self, h: Handle<T>) -> T {
        if !self.contains(h) {
            panic("remove: the handle's value was removed")
        }
        let at = self.slots[h.index].at
        // The last value moves into the hole.
        let last = self.values.len() - 1
        let moved = self.owners[last]
        self.slots[moved].at = at
        self.owners[at] = moved
        let _ = self.owners.pop()
        self.slots[h.index] = Slot { gen: h.gen.wrapping_add(1), at: self.free }
        self.free = h.index + 1
        self.values.swap_remove(at)
    }

    /// Removes every value. Every handle goes stale.
    pub fn clear(mut self) {
        while self.values.len() > 0 {
            let h = self.handle_at(0)
            let _ = self.remove(h)
        }
    }

    /// The values of `a` and `b`, both to change at once. Exclusivity is checked here, at run
    /// time (§6.5): two handles of one value panic, and so does a handle whose value was removed.
    pub fn pair_mut(mut self, a: Handle<T>, b: Handle<T>) -> Pair<T> {
        if !self.contains(a) || !self.contains(b) {
            panic("pair_mut: a handle's value was removed")
        }
        if a.index == b.index {
            panic("pair_mut: both handles name one value")
        }
        self.values.pair_mut(self.slots[a.index].at, self.slots[b.index].at)
    }

    /// The handle of the value at `position` in iteration order.
    pub fn handle_at(self, position: u32) -> Handle<T> {
        let index = self.owners[position]
        Handle { index, gen: self.slots[index].gen }
    }

    /// Calls `f` on each value, which it may change, in parallel: `Vec::par_each_mut` over the
    /// values in iteration order (§6.12).
    pub fn par_each_mut(mut self, f: @parallel fn(mut T)) {
        self.values.par_each_mut(f)
    }

    /// `map`s each value and `reduce`s the results, in parallel: `Vec::par_map_reduce` over the
    /// values in iteration order (§6.12).
    pub fn par_map_reduce<R: Clone>(
        self,
        init: R,
        map: @parallel fn(T) -> R,
        reduce: @parallel fn(R, R) -> R,
    ) -> R {
        self.values.par_map_reduce(init, map, reduce)
    }

    /// Every value's handle, in iteration order.
    pub fn handles(self) -> Vec<Handle<T>> {
        Vec::from_fn(self.values.len(), |i| self.handle_at(i))
    }
}

/// A map that keeps its keys sorted: it iterates in key order, whatever order the keys came
/// in, so `@deterministic` code may use it. Lookups are a binary search.
///
/// ```wrela
/// var scores: SortedMap<u32, f32> = SortedMap::new()
/// let _ = scores.insert(3, 0.5)
/// let _ = scores.insert(1, 0.25)
/// assert(scores.keys()[0] == 1 && scores.at(3) == 0.5)
/// ```
pub struct SortedMap<K, V>: Clone + StateHash {
    keys: Vec<K>,
    values: Vec<V>,
}

impl<K: Ord + Serialize, V: Serialize> Serialize for SortedMap<K, V> {
    fn serialize(self, w: mut Writer) {
        w.write_str("keys")
        self.keys.serialize(mut w)
        w.write_str("values")
        self.values.serialize(mut w)
    }

    fn deserialize(r: mut Reader) -> Result<SortedMap<K, V>, LoadError> {
        r.expect_name("keys")?
        let keys = Vec::<K>::deserialize(mut r)?
        r.expect_name("values")?
        let values = Vec::<V>::deserialize(mut r)?
        if keys.len() != values.len() {
            return Err(r.fail("the sorted map's saved keys and values have different lengths"))
        }
        for i in 1..keys.len() {
            if keys[i - 1].cmp(keys[i]) != Ordering::Less {
                return Err(r.fail("the sorted map's saved keys aren't strictly ordered"))
            }
        }
        Ok(SortedMap { keys, values })
    }
}

impl<K: Ord, V> SortedMap<K, V> {
    /// An empty map.
    pub fn new() -> SortedMap<K, V> {
        SortedMap { keys: Vec::new(), values: Vec::new() }
    }

    /// How many keys it holds.
    pub fn len(self) -> u32 {
        self.keys.len()
    }

    /// Whether it holds no keys.
    pub fn is_empty(self) -> bool {
        self.keys.len() == 0
    }

    /// Where `key` is, or where it would go: `(position, found)`.
    fn search(self, key: K) -> (u32, bool) {
        var lo = 0
        var hi = self.keys.len()
        while lo < hi {
            let mid = lo + (hi - lo) / 2
            let o = self.keys[mid].cmp(key)
            if o == Ordering::Less {
                lo = mid + 1
            } else if o == Ordering::Greater {
                hi = mid
            } else {
                return (mid, true)
            }
        }
        (lo, false)
    }

    /// Puts `value` under `key`: what was there before, if anything.
    pub fn insert(mut self, key: take K, value: take V) -> Option<V> {
        let (at, found) = self.search(key)
        if found {
            return Some(replace(mut self.values[at], take value))
        }
        self.keys.insert(at, take key)
        self.values.insert(at, take value)
        None
    }

    /// Takes `key`'s value out, if it has one.
    pub fn remove(mut self, key: K) -> Option<V> {
        let (at, found) = self.search(key)
        if !found {
            return None
        }
        let _ = self.keys.remove(at)
        Some(self.values.remove(at))
    }

    /// Whether `key` has a value.
    pub fn contains(self, key: K) -> bool {
        self.search(key).1
    }

    /// Where `key` is in key order, if it's there.
    pub fn find(self, key: K) -> Option<u32> {
        let (at, found) = self.search(key)
        if found { Some(at) } else { None }
    }

    /// `key`'s value; a key that isn't there panics (`contains` checks first).
    pub fn at(self, key: K) -> borrow V {
        let (i, found) = self.search(key)
        if !found {
            panic("at: the key isn't in the map")
        }
        self.values[i]
    }

    /// `key`'s value, to change; a key that isn't there panics.
    pub fn at_mut(mut self, key: K) -> mut V {
        let (i, found) = self.search(key)
        if !found {
            panic("at_mut: the key isn't in the map")
        }
        mut self.values[i]
    }

    /// The keys, in order.
    pub fn keys(self) -> [K] {
        self.keys
    }

    /// The values, in their keys' order.
    pub fn values(self) -> [V] {
        self.values
    }

    /// The values, in their keys' order, to change.
    pub fn values_mut(mut self) -> mut [V] {
        mut self.values
    }

    /// Removes every key and its value.
    pub fn clear(mut self) {
        self.keys.clear()
        self.values.clear()
    }
}

impl<K: Ord, V: Clone> SortedMap<K, V> {
    /// A copy of `key`'s value, if it has one.
    pub fn get(self, key: K) -> Option<V> {
        let (i, found) = self.search(key)
        if found { Some(self.values[i].clone()) } else { None }
    }
}

// ---- tests ------------------------------------------------------------------------------------

@test
fn saved_arenas_validate_their_indexes() {
    var original = Arena::new()
    let removed = original.insert(5)
    let kept = original.insert(7)
    let _ = original.remove(removed)
    let round_trip: Result<Arena<u32>, LoadError> = load(save(original))
    match take round_trip {
        Ok(a) => {
            var loaded = take a
            assert(loaded.len() == 1 && loaded.contains(kept) && loaded[kept] == 7)
            let added = loaded.insert(9)
            assert(loaded.len() == 2 && loaded[added] == 9)
        },
        Err(e) => panic(e.what),
    }

    var w = Writer::new()
    w.write_str("values")
    Vec::from([7]).serialize(mut w)
    w.write_str("slots")
    Vec::from([Slot { gen: 1, at: 0 }]).serialize(mut w)
    w.write_str("owners")
    Vec::from([1]).serialize(mut w)
    w.write_str("free")
    0.serialize(mut w)
    var loaded: Result<Arena<u32>, LoadError> = load(take w.into_bytes())
    match take loaded {
        Ok(_) => panic("an arena with a dangling owner was loaded"),
        Err(_) => {},
    }

    var handle = Writer::new()
    handle.write_str("index")
    handle.write_u32(0)
    handle.write_str("gen")
    handle.write_u32(0)
    let loaded_handle: Result<Handle<u32>, LoadError> = load(take handle.into_bytes())
    match loaded_handle {
        Ok(_) => panic("a handle with a free generation was loaded"),
        Err(_) => {},
    }
}

@test
fn a_loaded_max_generation_can_be_removed_and_reused() {
    var w = Writer::new()
    w.write_str("values")
    Vec::from([7]).serialize(mut w)
    w.write_str("slots")
    Vec::from([Slot { gen: 4294967295, at: 0 }]).serialize(mut w)
    w.write_str("owners")
    Vec::from([0]).serialize(mut w)
    w.write_str("free")
    0.serialize(mut w)

    let loaded: Result<Arena<u32>, LoadError> = load(take w.into_bytes())
    match loaded {
        Ok(a) => {
            var arena = a.clone()
            let old = Handle { index: 0, gen: 4294967295 }
            assert(arena.remove(old) == 7)
            let fresh = arena.insert(9)
            assert(arena.contains(fresh) && arena[fresh] == 9 && !arena.contains(old))
        },
        Err(e) => panic(e.what),
    }
}

@test
fn saved_sorted_maps_validate_their_order() {
    var original = SortedMap::new()
    let _ = original.insert(2, 20)
    let _ = original.insert(1, 10)
    let round_trip: Result<SortedMap<u32, u32>, LoadError> = load(save(original))
    match round_trip {
        Ok(m) => assert(m.len() == 2 && m.at(1) == 10 && m.at(2) == 20),
        Err(e) => panic(e.what),
    }

    var w = Writer::new()
    w.write_str("keys")
    Vec::from([2, 1]).serialize(mut w)
    w.write_str("values")
    Vec::from([20, 10]).serialize(mut w)
    let loaded: Result<SortedMap<u32, u32>, LoadError> = load(take w.into_bytes())
    match loaded {
        Ok(_) => panic("an out-of-order sorted map was loaded"),
        Err(_) => {},
    }
}
