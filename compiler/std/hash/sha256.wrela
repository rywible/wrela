// SHA-256 (FIPS 180-4): a digest of bytes, for checking that a file, a download or a build is
// the one expected. A `Sha256` takes bytes a run at a time (`update`), so a tool can hash a
// blob larger than memory holds at once, a chunk of `blob::read` at a time; `sha256` hashes one
// run of bytes. `hex` writes a digest as text, two lowercase digits a byte.
//
// ```wrela
// use std::hash::sha256::{Sha256, hex, sha256}
//
// let abc = String::from("abc")
// let whole = sha256(abc.as_bytes())
// var h = Sha256::new()
// h.update(abc.as_bytes())
// assert(h.finish() == whole)
// let text = hex(whole)
// assert(text.as_str() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
// ```

/// The 64 round constants: the first 32 bits of the fractional parts of the cube roots of the
/// first 64 primes.
const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

/// The state before any bytes: the first 32 bits of the fractional parts of the square roots of
/// the first 8 primes.
const START: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
]

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

/// A SHA-256 digest being computed: the state, the bytes of the block not yet full, and how
/// many bytes it has been given.
pub struct Sha256: Clone {
    state: [u32; 8],
    block: [u8; 64],
    used: u32,
    total: u64,
}

impl Sha256 {
    /// A digest of no bytes yet.
    pub fn new() -> Sha256 {
        Sha256 { state: START, block: [0; 64], used: 0, total: 0 }
    }

    /// Adds `bytes` to what is hashed, after the bytes given before.
    pub fn update(mut self, bytes: [u8]) {
        for b in bytes {
            self.block[self.used] = b
            self.used += 1
            if self.used == 64 {
                self.compress()
                self.used = 0
            }
        }
        self.total += u64(bytes.len())
    }

    /// The digest of all the bytes given: 32 bytes. The padding is a 1 bit, zeros, then the
    /// length in bits, so it ends a block.
    pub fn finish(self) -> [u8; 32] {
        var h = self.clone()
        let bits = h.total * 8
        h.block[h.used] = 0x80
        h.used += 1
        if h.used > 56 {
            while h.used < 64 {
                h.block[h.used] = 0
                h.used += 1
            }
            h.compress()
            h.used = 0
        }
        while h.used < 56 {
            h.block[h.used] = 0
            h.used += 1
        }
        for k in 0..8 {
            h.block[56 + k] = u8((bits >> (56 - 8 * k)) & 255)
        }
        h.compress()
        var out: [u8; 32] = [0; 32]
        for i in 0..8 {
            let w = h.state[i]
            for k in 0..4 {
                out[4 * i + k] = u8((w >> (24 - 8 * k)) & 255)
            }
        }
        out
    }

    /// Mixes the full block into the state: 64 rounds.
    fn compress(mut self) {
        var w: [u32; 64] = [0; 64]
        for i in 0..16 {
            let at = 4 * i
            w[i] = (u32(self.block[at]) << 24) |
                (u32(self.block[at + 1]) << 16) |
                (u32(self.block[at + 2]) << 8) |
                u32(self.block[at + 3])
        }
        for i in 16..64 {
            let a = w[i - 15]
            let b = w[i - 2]
            let s0 = rotr(a, 7) ^ rotr(a, 18) ^ (a >> 3)
            let s1 = rotr(b, 17) ^ rotr(b, 19) ^ (b >> 10)
            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1)
        }
        var a = self.state[0]
        var b = self.state[1]
        var c = self.state[2]
        var d = self.state[3]
        var e = self.state[4]
        var f = self.state[5]
        var g = self.state[6]
        var h = self.state[7]
        for i in 0..64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let choose = (e & f) ^ ((e ^ 0xffffffff) & g)
            let t1 = h.wrapping_add(s1).wrapping_add(choose).wrapping_add(K[i]).wrapping_add(w[i])
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let majority = (a & b) ^ (a & c) ^ (b & c)
            let t2 = s0.wrapping_add(majority)
            h = g
            g = f
            f = e
            e = d.wrapping_add(t1)
            d = c
            c = b
            b = a
            a = t1.wrapping_add(t2)
        }
        self.state[0] = self.state[0].wrapping_add(a)
        self.state[1] = self.state[1].wrapping_add(b)
        self.state[2] = self.state[2].wrapping_add(c)
        self.state[3] = self.state[3].wrapping_add(d)
        self.state[4] = self.state[4].wrapping_add(e)
        self.state[5] = self.state[5].wrapping_add(f)
        self.state[6] = self.state[6].wrapping_add(g)
        self.state[7] = self.state[7].wrapping_add(h)
    }
}

/// The SHA-256 digest of `bytes`.
pub fn sha256(bytes: [u8]) -> [u8; 32] {
    var h = Sha256::new()
    h.update(bytes)
    h.finish()
}

/// `bytes` as text, two lowercase hexadecimal digits a byte: how a digest is usually written.
pub fn hex(bytes: [u8]) -> String {
    let digits = "0123456789abcdef"
    var out = String::new()
    for b in bytes {
        out.push_byte(digits.byte(u32(b >> 4)))
        out.push_byte(digits.byte(u32(b & 15)))
    }
    out
}

// The vectors of NIST's examples for SHA-256 (FIPS 180-4's, and the CAVP's short and long
// messages), and the same digests made a few bytes at a time.

/// Whether `digest` is `want` in hexadecimal, as `hex` writes it.
fn digest_is(digest: [u8; 32], want: str) -> bool {
    let text = hex(digest)
    text.as_str() == want
}

/// The UTF-8 of `s`, as bytes to hash.
fn utf8(s: str) -> Vec<u8> {
    var out: Vec<u8> = Vec::with_capacity(s.len())
    for i in 0..s.len() {
        out.push(s.byte(i))
    }
    out
}

@test
fn the_nist_vectors_hash_to_their_digests() {
    assert(
        digest_is(
            sha256(utf8("abc")),
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        ),
    )
    assert(
        digest_is(
            sha256(utf8("")),
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        ),
    )
    let two_blocks = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    assert(
        digest_is(
            sha256(utf8(two_blocks)),
            "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
        ),
    )
    let long = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    assert(
        digest_is(
            sha256(utf8(long)),
            "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
        ),
    )
    // The CAVP's one-byte message 0xd3, and 55 and 56 bytes, either side of the padding's
    // spill into a second block.
    assert(
        digest_is(
            sha256([u8(0xd3)]),
            "28969cdfa74a12c82f3bad960b0b000aca2ac329deea5c2328ebc6f2ba9802c1",
        ),
    )
    assert(
        digest_is(
            sha256(Vec::filled(55, u8(97))),
            "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318",
        ),
    )
    assert(
        digest_is(
            sha256(Vec::filled(56, u8(97))),
            "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a",
        ),
    )
}

@test
fn a_million_as_hash_to_their_digest_a_chunk_at_a_time() {
    // FIPS 180-4's third example: a million `a`s, here given in uneven chunks.
    var h = Sha256::new()
    for i in 0..1000 {
        let n = 1 + (i * 7) % 999
        h.update(Vec::filled(n, u8(97)))
        h.update(Vec::filled(1000 - n, u8(97)))
    }
    assert(
        digest_is(h.finish(), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"),
    )
}

@test
fn finishing_leaves_the_digest_going_on() {
    var h = Sha256::new()
    h.update(utf8("ab"))
    let partial = h.finish()
    h.update(utf8("c"))
    assert(partial == sha256(utf8("ab")))
    assert(h.finish() == sha256(utf8("abc")))
}
