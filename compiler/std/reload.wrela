// One build in place of another, in the same page or process (language.md §22). A tool does it
// in a hot reload; a program does it itself with `hand_over`, to give its place to another
// build: a game made of several builds, each loaded when the player reaches it. Either way the
// new build starts with `init`, as any program does. What the old build kept with `keep` is
// what the new one's `kept` gives, so a program carries across what it wants to: where the
// camera is, what the player chose. Bytes, so a program says how (`std::serialize`'s `save`
// and `load`, which fail cleanly when the type has changed). A program started anew kept
// nothing.
//
// ```wrela
// use std::reload::{keep, kept}
// use std::serialize::{load, save}
//
// pub fn init() -> Game {
//     var g = Game::new()
//     if let Ok(view) = load::<View>(kept()) {
//         g.view = view
//     }
//     g
// }
//
// pub fn frame(g: mut Game, time: f32, width: u32, height: u32) {
//     keep(save(g.view).as_slice())
// }
// ```

use std::io::{Pending, next_request, path_problem}

/// Keeps `bytes` for the build that replaces this one: the host holds them, in place of what
/// this build kept before. Cheap enough for each frame (a copy of the bytes).
pub fn keep(bytes: [u8]) {
    Vec::keep(bytes)
}

/// What the build this one replaced last kept: no bytes if it kept none, or this build
/// replaced none.
pub fn kept() -> Vec<u8> {
    Vec::from_kept()
}

/// Gets the build at `path` (relative to this program's build, as `fetch`'s URLs are, but it
/// may start with `..` parts) ready to take this program's place: its files fetched, its code
/// compiled and its pipelines built, in the background, while this program runs. The answer
/// is no bytes, when it's ready; a build that can't be got ready fails the request. A
/// `hand_over` to a build that's ready starts it at once; to one that isn't, it gets it ready
/// first, and the screen keeps this program's last frame meanwhile.
pub fn prepare(path: str) -> Pending<u8> {
    check_build_path("prepare", path)
    let request = next_request()
    prepare_command(request, path)
    Pending::new(request)
}

/// Lets go of what `prepare` got ready for the build at `path`, if anything: the memory its
/// code and pipelines hold, but for the pipelines the running build uses too.
pub fn unprepare(path: str) {
    check_build_path("unprepare", path)
    unprepare_command(path)
}

/// Gives this program's place to the build at `path` (as `prepare` names it) after this call:
/// the host stops this program, starts that build with `init`, and its `kept()` gives what this
/// program kept last. Its ticker, if it starts one, starts from its first tick, and the input
/// this program hadn't read is its. If the build can't be started (it isn't there, its code or
/// a pipeline doesn't build), this program goes on, and the request fails: it's answered only
/// then. If it starts and its `init` fails, the host starts this program's build again in its
/// place, with the same bytes kept, so the screen never goes black.
pub fn hand_over(path: str) -> Pending<u8> {
    check_build_path("hand_over", path)
    let request = next_request()
    hand_over_command(request, path)
    Pending::new(request)
}

/// What's wrong with the path of a build, if anything: as a fetched URL's, but it may start
/// with one `..` part, to name a build beside this one, and climbs no further (the hosts check
/// the same).
fn build_path_problem(path: str) -> Option<Text> {
    let start = if starts_up(path, 0) { 3 } else { 0 }
    if starts_up(path, start) ||
        start + 2 == path.len() && path.byte(start) == 46 && path.byte(start + 1) == 46 {
        return Some("climbs more than one directory: a build names its own or one beside it")
    }
    path_problem(path.slice(start, path.len()))
}

/// Whether `path` has `../` at byte `at`.
fn starts_up(path: str, at: u32) -> bool {
    at + 3 <= path.len() &&
        path.byte(at) == 46 &&
        path.byte(at + 1) == 46 &&
        path.byte(at + 2) == 47
}

fn check_build_path(what: Text, path: str) {
    if let Some(why) = build_path_problem(path) {
        panic(f"{what}: the build path `{path}` {why}")
    }
}

@intrinsic
fn prepare_command(request: u32, path: str) {}

@intrinsic
fn unprepare_command(path: str) {}

@intrinsic
fn hand_over_command(request: u32, path: str) {}

@test
fn a_build_path_climbs_one_directory_at_most() {
    assert(build_path_problem("../floor-2").is_none() && build_path_problem("floors/2").is_none())
    assert(build_path_problem("../../x").is_some() && build_path_problem("../..").is_some())
    assert(build_path_problem("..").is_some() && build_path_problem("a/../b").is_some())
}
