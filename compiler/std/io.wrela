// Requests to the host (language.md §6.15): the program's storage ("bytes at a path") and
// fetching files of its build. A request is made at once and answered on a later call: the
// `Pending` it gives is polled, as is a GPU readback's (`std::gpu::read`). Making a request is
// the `io` effect, and polling one `nondet`, so `@deterministic` code does neither: an answer
// reaches the simulation only through a tick's input.

use std::abi::{REQUEST_FAILED, REQUEST_PENDING}

/// Why a request failed.
pub struct IoError: Clone {
    message: String,
}

impl IoError {
    /// What the host said, in its words.
    pub fn message(self) -> borrow str {
        self.message
    }
}

/// A request the host answers on a later call. Its answer is a run of `T`s: bytes (`T` is
/// `u8`) for storage and fetch, a buffer's elements for a readback. A `Pending` is an ordinary
/// value: keep it in the program's state and poll it each frame.
pub struct Pending<T>: Clone {
    request: u32,
    done: bool,
}

impl<T> Pending<T> {
    /// The handle of request `request`, just made.
    pub(package) fn new(request: u32) -> Pending<T> {
        Pending { request, done: false }
    }
}

impl<T: Plain> Pending<T> {
    /// The answer, once it has arrived: `None` before that, `Some` once, then `None` again.
    pub fn poll(mut self) -> Option<Result<Vec<T>, IoError>> {
        if self.done {
            return None
        }
        let status = request_status(self.request)
        if status == REQUEST_PENDING {
            return None
        }
        self.done = true
        if status == REQUEST_FAILED {
            // Forgets the request.
            let _gone: Vec<u8> = Vec::from_answer(self.request, 0)
            return Some(
                Err(IoError { message: String::from("the host couldn't answer the request") }),
            )
        }
        Some(Ok(Vec::from_answer(self.request, u32(status))))
    }

    /// Whether `poll` has given the answer.
    pub fn is_done(self) -> bool {
        self.done
    }
}

/// What's wrong with a storage path or a URL, if anything: it's relative, with `/` between its
/// parts, and none of them empty, `.` or `..` (the hosts check the same).
fn path_problem(path: str) -> Option<Text> {
    if path.is_empty() {
        return Some("is empty")
    }
    // `/` first, `\`, `:`, `?` and `#` anywhere.
    for i in 0..path.len() {
        let b = path.byte(i)
        if (i == 0 && b == 47) || b == 92 || b == 58 || b == 63 || b == 35 {
            return Some("must be relative, with `/` between its parts")
        }
    }
    var start = 0
    for i in 0..path.len() + 1 {
        if i == path.len() || path.byte(i) == 47 {
            let n = i - start
            let dot = |k: u32| path.byte(start + k) == 46
            if n == 0 || (n == 1 && dot(0)) || (n == 2 && dot(0) && dot(1)) {
                return Some("has an empty, `.` or `..` part")
            }
            start = i + 1
        }
    }
    None
}

fn check_path(what: Text, path: str) {
    if let Some(why) = path_problem(path) {
        panic(f"{what}: the path `{path}` {why}")
    }
}

/// Reads the bytes stored at `path` in the program's storage: the host's files in the native
/// host, the origin's private file system in a browser.
pub fn load(path: str) -> Pending<u8> {
    check_path("load", path)
    let request = next_request()
    storage_read_command(request, path)
    Pending::new(request)
}

/// Stores `bytes` at `path` in the program's storage, replacing what was there. The answer is
/// The most bytes a request's path and data (or URL and body) hold together: a command is at most
/// the host's command buffer (1 MiB, wrela_abi `CMD_CAP`), less its words.
const MOST_BYTES: u32 = 1048576 - 64

/// no bytes.
pub fn store(path: str, bytes: [u8]) -> Pending<u8> {
    check_path("store", path)
    if bytes.len() + path.len() > MOST_BYTES {
        panic(
            "store: the bytes and the path are more than one request carries (1 MiB): store the file in pieces",
        )
    }
    let request = next_request()
    storage_write_command(request, path, bytes)
    Pending::new(request)
}

/// Fetches the file at `url`, relative to the program's build.
pub fn fetch(url: str) -> Pending<u8> {
    check_path("fetch", url)
    let request = next_request()
    fetch_command(request, url)
    Pending::new(request)
}

/// Sends `bytes` to the host that serves the program, at `url`, relative to its build: the
/// answer is the host's reply. A browser posts to the build's own origin only; the native host
/// answers with what its user gives it, and fails the request otherwise.
pub fn post(url: str, bytes: [u8]) -> Pending<u8> {
    check_path("post", url)
    if bytes.len() + url.len() > MOST_BYTES {
        panic(
            "post: the body and the URL are more than one request carries (1 MiB): post it in pieces",
        )
    }
    let request = next_request()
    post_command(request, url, bytes)
    Pending::new(request)
}

/// Shows `line` on the host's console now: the terminal that runs the native host or the build,
/// the browser's developer console. For finding out what a program does while writing it; a
/// player doesn't see it. The program never reads it back, so it's the `trace` effect, not `io`
/// (§8): a constant, a test, `@deterministic` code and a parallel job's chunk print too (a tick
/// run again prints again), and GPU and `@audio` code don't. A constant's lines are shown as it
/// runs, after its name: the progress of a computation that takes hours.
///
/// ```wrela
/// use std::io::print
///
/// let n = 3
/// print(f"{n} grazers, {0.5:.2} m apart")
/// ```
pub fn print(line: str) {
    print_command(line)
}

/// A new request number.
@intrinsic
pub(package) fn next_request() -> u32 {}

/// -1 while request `request` is pending, -2 if it failed, else its answer's length in bytes.
@intrinsic
pub(package) fn request_status(request: u32) -> i32 {}

@intrinsic
fn storage_read_command(request: u32, path: str) {}

@intrinsic
fn storage_write_command(request: u32, path: str, bytes: [u8]) {}

@intrinsic
fn fetch_command(request: u32, url: str) {}

@intrinsic
fn print_command(line: str) {}

@intrinsic
fn post_command(request: u32, url: str, bytes: [u8]) {}

// ---- files a build ships (M6) -------------------------------------------------------------------

/// Files a build ships beside the program, for data too large to load before the first frame (a
/// world streamed in tiles): a constant of this type is written as files of the build, under
/// `files/<dir>/`, and the program fetches each as it needs it (`fetch`). The program's copy of
/// the constant keeps each file's name and size, not its bytes: build-time code (another constant,
/// a test) reads them in place (`bytes`).
pub struct Shipped: Clone {
    // The build reads these four fields, in this order (`wrela_driver`'s shipping).
    dir: String,
    names: Vec<String>,
    sizes: Vec<u32>,
    bytes: Vec<Vec<u8>>,
}

/// Files to ship under `dir` (`files/<dir>/` of the build): each a name and its bytes. A name is
/// letters, digits, `_`, `-` and `.`, and `dir` the same, so a file lands where it says; another
/// panics, which fails the build that computes the constant.
pub fn ship(dir: str, files: take Vec<(String, Vec<u8>)>) -> Shipped {
    check_name("ship", dir)
    var names: Vec<String> = Vec::new()
    var sizes: Vec<u32> = Vec::new()
    var bytes: Vec<Vec<u8>> = Vec::new()
    var rest = take files
    while !rest.is_empty() {
        let (name, b) = rest.remove(0)
        check_name("ship", name.as_str())
        sizes.push(b.len())
        names.push(take name)
        bytes.push(take b)
    }
    Shipped { dir: String::from(dir), names, sizes, bytes }
}

/// Panics unless `name` is a file's name a build can ship: letters, digits, `_`, `-` and `.`, not
/// empty, and not `.` or `..`.
fn check_name(what: str, name: str) {
    let n = name.len()
    if n == 0 || name == "." || name == ".." {
        panic(f"{what}: `{name}` isn't a file's name")
    }
    for i in 0..n {
        let b = name.byte(i)
        let ok = (b >= 48 && b <= 57) ||
            (b >= 65 && b <= 90) ||
            (b >= 97 && b <= 122) ||
            b == 95 ||
            b == 45 ||
            b == 46
        if !ok {
            panic(
                f"{what}: `{name}` has a character a shipped file's name can't: letters, digits, `_`, `-` and `.`",
            )
        }
    }
}

impl Shipped {
    /// How many files it ships.
    pub fn len(self) -> u32 {
        self.names.len()
    }

    /// File `i`'s name.
    pub fn name(self, i: u32) -> str {
        self.names[i].as_str()
    }

    /// File `i`'s size in bytes.
    pub fn size(self, i: u32) -> u32 {
        self.sizes[i]
    }

    /// The index of the file named `name`, if it ships one.
    pub fn find(self, name: str) -> Option<u32> {
        var i = 0
        for n in self.names {
            if n.as_str() == name {
                return Some(i)
            }
            i += 1
        }
        None
    }

    /// Fetches file `i` from the build.
    pub fn fetch(self, i: u32) -> Pending<u8> {
        fetch(f"files/{self.dir}/{self.names[i]}".as_str())
    }

    /// File `i`'s bytes, where they're in hand: in the build's own code (a constant computed from
    /// this one, a test). A program a build ships has fetched them (`fetch`): this panics there.
    pub fn bytes(self, i: u32) -> borrow [u8] {
        if self.bytes.len() <= i {
            panic("Shipped::bytes: the build shipped this file: fetch it")
        }
        self.bytes[i]
    }
}
