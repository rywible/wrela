// Text (language.md §4): `Text`, the type of string literals, a `Copy` handle to UTF-8 in the
// build; `String`, UTF-8 on the heap, which can grow; and `str`, a borrowed run of UTF-8, which
// either passes as. Every string is UTF-8, and is measured and indexed in bytes.

use std::collections::Vec
use std::mem::load_u8

/// Text known when the program is built: a string literal, or text a build-time constant made.
/// A `Copy` handle to read-only UTF-8, so it can be stored anywhere.
pub struct Text: Copy {
    // The compiler builds literals as these two fields, in this order.
    addr: u32,
    len: u32,
}

/// Bytes known when the program is built: a file `embed` read (language.md §10). A `Copy`
/// handle to read-only data, so it can be stored anywhere. It passes as a `[u8]` where one is
/// expected.
pub struct Bytes: Copy {
    // The compiler builds these as these two fields, in this order.
    addr: u32,
    len: u32,
}

impl Bytes {
    /// How many bytes it holds.
    pub fn len(self) -> u32 {
        self.len
    }

    /// Whether it holds no bytes.
    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    /// Byte `i`. An index past the end panics.
    pub fn at(self, i: u32) -> u8 {
        if i >= self.len {
            panic("at: the index is past the end of the bytes")
        }
        unsafe { load_u8(self.addr + i) }
    }
}

/// UTF-8 on the heap, which can grow. It passes as a `str` where one is expected.
///
/// ```wrela
/// var s = String::from("herd")
/// s.push_str(" of 3")
/// assert(s.len() == 9 && f"{s}!" == "herd of 3!")
/// ```
pub struct String: Clone {
    bytes: Vec<u8>,
}

impl Text {
    /// Its length in bytes.
    pub fn len(self) -> u32 {
        self.len
    }

    /// Whether it holds no bytes.
    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    /// The same text, owned and on the heap.
    pub fn to_string(self) -> String {
        String::from(self)
    }
}

impl String {
    /// An empty string.
    pub fn new() -> String {
        String { bytes: Vec::new() }
    }

    /// A copy of `s`.
    pub fn from(s: str) -> String {
        var out = String::new()
        out.push_str(s)
        out
    }

    /// Its length in bytes.
    pub fn len(self) -> u32 {
        self.bytes.len()
    }

    /// Whether it holds no bytes.
    pub fn is_empty(self) -> bool {
        self.bytes.len() == 0
    }

    /// Adds `s` at the end.
    pub fn push_str(mut self, s: str) {
        let n = s.len()
        self.bytes.reserve(n)
        for i in 0..n {
            self.bytes.push(s.byte(i))
        }
    }

    /// Adds one byte, which must keep the text UTF-8: an ASCII character's code.
    pub fn push_byte(mut self, b: u8) {
        if b >= 128 {
            panic("push_byte: only ASCII keeps a string UTF-8")
        }
        self.bytes.push(b)
    }

    /// Empties it; the capacity stays.
    pub fn clear(mut self) {
        self.bytes.clear()
    }

    /// Cuts it to its first `n` bytes, which must end on a character's boundary.
    pub fn truncate(mut self, n: u32) {
        self.bytes.truncate(n)
    }

    /// The text `bytes` hold, if they're UTF-8.
    pub fn from_utf8(bytes: take Vec<u8>) -> Option<String> {
        if !is_utf8(bytes) {
            return None
        }
        Some(String { bytes: take bytes })
    }
}

/// Whether `b` is UTF-8: no stray continuation bytes, no overlong forms, no surrogates, nothing
/// past U+10FFFF.
fn is_utf8(b: [u8]) -> bool {
    let n = b.len()
    var i = 0
    while i < n {
        let c = b[i]
        if c < 128 {
            i += 1
            continue
        }
        // How many continuation bytes follow, and the range the first of them must be in.
        var k = 0
        var lo = 128
        var hi = 191
        if c >= 194 && c <= 223 {
            k = 1
        } else if c >= 224 && c <= 239 {
            k = 2
            if c == 224 {
                lo = 160
            }
            if c == 237 {
                hi = 159
            }
        } else if c >= 240 && c <= 244 {
            k = 3
            if c == 240 {
                lo = 144
            }
            if c == 244 {
                hi = 143
            }
        } else {
            return false
        }
        if i + k >= n {
            return false
        }
        let first = b[i + 1]
        if first < lo || first > hi {
            return false
        }
        for j in 2..k + 1 {
            let x = b[i + j]
            if x < 128 || x > 191 {
                return false
            }
        }
        i += k + 1
    }
    true
}

impl str {
    /// Its length in bytes.
    pub fn len(self) -> u32 {
        str_len(self)
    }

    /// Whether it holds no bytes.
    pub fn is_empty(self) -> bool {
        str_len(self) == 0
    }

    /// Byte `i`; an index past the end panics.
    pub fn byte(self, i: u32) -> u8 {
        if i >= str_len(self) {
            panic("byte: the index is past the end")
        }
        unsafe { load_u8(str_addr(self) + i) }
    }

    /// Whether it starts with `prefix`.
    pub fn starts_with(self, prefix: str) -> bool {
        let n = prefix.len()
        if n > self.len() {
            return false
        }
        for i in 0..n {
            if self.byte(i) != prefix.byte(i) {
                return false
            }
        }
        true
    }

    /// Whether it ends with `suffix`.
    pub fn ends_with(self, suffix: str) -> bool {
        let n = suffix.len()
        let m = self.len()
        if n > m {
            return false
        }
        for i in 0..n {
            if self.byte(m - n + i) != suffix.byte(i) {
                return false
            }
        }
        true
    }

    /// Where `needle` first occurs, in bytes; `None` if it doesn't.
    pub fn find(self, needle: str) -> Option<u32> {
        let (n, m) = (needle.len(), self.len())
        if n > m {
            return None
        }
        for i in 0..m - n + 1 {
            var hit = true
            for j in 0..n {
                if self.byte(i + j) != needle.byte(j) {
                    hit = false
                    break
                }
            }
            if hit {
                return Some(i)
            }
        }
        None
    }

    /// Bytes `from` to `to` (not included), which must fall on characters' boundaries.
    pub fn slice(self, from: u32, to: u32) -> borrow str {
        if from > to || to > self.len() {
            panic("slice: the range isn't inside the string")
        }
        str_part(self, from, to)
    }

    /// Without the spaces, tabs and line breaks at either end.
    pub fn trim(self) -> borrow str {
        var from = 0
        var to = self.len()
        while from < to && is_space(self.byte(from)) {
            from += 1
        }
        while to > from && is_space(self.byte(to - 1)) {
            to -= 1
        }
        str_part(self, from, to)
    }

    /// The parts between each `sep`, as each part's byte range `(from, to)`.
    pub fn split(self, sep: str) -> Vec<(u32, u32)> {
        var out = Vec::new()
        var from = 0
        let n = sep.len()
        var i = 0
        while n > 0 && i + n <= self.len() {
            if self.slice(i, i + n) == sep {
                out.push((from, i))
                i += n
                from = i
            } else {
                i += 1
            }
        }
        out.push((from, self.len()))
        out
    }

    /// Each line's byte range `(from, to)`, without its line break (`\n` or `\r\n`).
    pub fn lines(self) -> Vec<(u32, u32)> {
        var out = Vec::new()
        var from = 0
        let n = self.len()
        for i in 0..n {
            if self.byte(i) == 10 {
                let end = if i > from && self.byte(i - 1) == 13 { i - 1 } else { i }
                out.push((from, end))
                from = i + 1
            }
        }
        if from < n {
            out.push((from, n))
        }
        out
    }

    /// An owned copy.
    pub fn to_string(self) -> String {
        String::from(self)
    }

    /// The `u32` it spells in decimal, with no sign or spaces; `None` if it isn't one.
    pub fn parse_u32(self) -> Option<u32> {
        let n = self.len()
        if n == 0 {
            return None
        }
        var v: u64 = 0
        for i in 0..n {
            let d = self.byte(i)
            if d < 48 || d > 57 {
                return None
            }
            v = v * 10 + u64(d - 48)
            if v > 4294967295 {
                return None
            }
        }
        Some(u32(v))
    }

    /// The `i32` it spells in decimal, with an optional `-`; `None` if it isn't one.
    pub fn parse_i32(self) -> Option<i32> {
        if self.starts_with("-") {
            let m = self.slice(1, self.len()).parse_u32()?
            if m > 2147483648 {
                return None
            }
            return Some(i32(0 - i64(m)))
        }
        let m = self.parse_u32()?
        if m > 2147483647 {
            return None
        }
        Some(i32(m))
    }

    /// The `f32` it spells (digits, an optional `-`, `.` and exponent); `None` if it isn't one.
    /// Decimal digits are read into an `f64` and rounded once.
    pub fn parse_f32(self) -> Option<f32> {
        let n = self.len()
        var i = 0
        var neg = false
        if i < n && self.byte(i) == 45 {
            neg = true
            i += 1
        }
        var mant: f64 = 0.0
        var digits = 0
        var scale = 0
        while i < n && self.byte(i) >= 48 && self.byte(i) <= 57 {
            mant = mant * 10.0 + f64(self.byte(i) - 48)
            digits += 1
            i += 1
        }
        if i < n && self.byte(i) == 46 {
            i += 1
            while i < n && self.byte(i) >= 48 && self.byte(i) <= 57 {
                mant = mant * 10.0 + f64(self.byte(i) - 48)
                scale -= 1
                digits += 1
                i += 1
            }
        }
        if digits == 0 {
            return None
        }
        if i < n && (self.byte(i) == 101 || self.byte(i) == 69) {
            let e = self.slice(i + 1, n).parse_i32()?
            scale += e
            i = n
        }
        if i != n {
            return None
        }
        var v = mant
        var k = scale
        while k > 0 {
            v = v * 10.0
            k -= 1
        }
        while k < 0 {
            v = v / 10.0
            k += 1
        }
        Some(if neg { -f32(v) } else { f32(v) })
    }
}

impl Eq for str {
    fn eq(self, other: str) -> bool {
        let n = self.len()
        if n != other.len() {
            return false
        }
        for i in 0..n {
            if self.byte(i) != other.byte(i) {
                return false
            }
        }
        true
    }
}

impl Eq for Text {
    fn eq(self, other: Text) -> bool {
        str_eq(self, other)
    }
}

impl Eq for String {
    fn eq(self, other: String) -> bool {
        str_eq(self, other)
    }
}

fn str_eq(a: str, b: str) -> bool {
    a == b
}

/// Byte by byte (so code point by code point), then the shorter first.
impl Ord for str {
    fn cmp(self, other: str) -> Ordering {
        let (m, n) = (self.len(), other.len())
        for i in 0..min(m, n) {
            let (a, b) = (self.byte(i), other.byte(i))
            if a != b {
                return a.cmp(b)
            }
        }
        m.cmp(n)
    }
}

impl Ord for Text {
    fn cmp(self, other: Text) -> Ordering {
        str_cmp(self, other)
    }
}

impl Ord for String {
    fn cmp(self, other: String) -> Ordering {
        str_cmp(self, other)
    }
}

fn str_cmp(a: str, b: str) -> Ordering {
    a.cmp(b)
}

fn is_space(b: u8) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

/// A run's address and length: the compiler lays a `str` out as these two words.
@intrinsic
fn str_addr(s: str) -> u32 {}

@intrinsic
fn str_len(s: str) -> u32 {}

/// Bytes `from` to `to` of `s`, unchecked.
@intrinsic
fn str_part(s: str, from: u32, to: u32) -> borrow str {}
