// A tool's programs (language.md §15.5): a program that `wrela tool --allow-run NAME` grants,
// run as a process of its own, with arguments, standard input and a working directory, and its
// exit status and output given back. No shell runs it.
//
// A granted program runs natively, with the user's authority: its working directory, a write
// root the request names, is where it starts, not a confinement. It gets an empty environment
// and a fixed baseline: `PATH` as it was when the grants were made, `HOME` a directory the host
// owns for the run, and `LANG=C.UTF-8`; then the request's variables, and the granted secrets it
// names. The host kills its process group when it ends, past its deadline (60 s unless it asks
// for another, at most 600 s), past 256 MiB of output, or when the tool ends.
//
// `--allow-run NAME=tool:DIR` grants a tool package instead: `wrela tool` runs its tool build,
// with the request's working directory as its one write root, under the same name. A tool test
// fakes its programs this way (§13.2).

use std::io::{IoError, Pending}
use std::serialize::{Reader, Writer}
use std::tool::{ToolError, answer, ask, malformed}
use std::tool::blob::{Data, read_data, write_data}

/// An environment variable a program gets: its name and value.
pub struct Var: Clone {
    pub name: String,
    pub value: String,
}

/// What to run: the granted program's name, its arguments, its standard input, its variables,
/// the granted secrets it gets as variables of their names, the write root it works in, and how
/// long it may take in seconds (0: 60 s).
pub struct Command: Clone {
    pub program: String,
    pub args: Vec<String>,
    pub stdin: Data,
    pub env: Vec<Var>,
    pub secrets: Vec<String>,
    pub cwd: String,
    pub timeout: f64,
}

/// A command that runs `program` in the write root `cwd`, with no arguments, input or variables.
pub fn command(program: str, cwd: str) -> Command {
    Command {
        program: String::from(program),
        args: Vec::new(),
        stdin: Data::empty(),
        env: Vec::new(),
        secrets: Vec::new(),
        cwd: String::from(cwd),
        timeout: 0.0,
    }
}

/// How a program ended: its exit status (minus the signal that ended it, if one did), and what
/// it wrote to its standard output and its standard error.
pub struct Ran: Clone {
    pub status: i32,
    pub stdout: Data,
    pub stderr: Data,
}

/// Runs `command`: `read_ran` reads the answer. Standard input of bytes over 512 KiB panics:
/// give it as a blob.
@tool
pub fn run(command: Command) -> Pending<u8> {
    var w = Writer::new()
    w.write_str(command.program.as_str())
    w.write_u32(command.args.len())
    for a in command.args {
        w.write_str(a.as_str())
    }
    write_data(mut w, command.stdin)
    w.write_u32(command.env.len())
    for v in command.env {
        w.write_str(v.name.as_str())
        w.write_str(v.value.as_str())
    }
    w.write_u32(command.secrets.len())
    for s in command.secrets {
        w.write_str(s.as_str())
    }
    w.write_str(command.cwd.as_str())
    w.write_u64(bitcast_u64(command.timeout))
    ask("run/run", take w.into_bytes())
}

/// Reads a `run` answer: the status (an `i32`'s bits), then the standard output and error
/// (`blob::Data`).
pub fn read_ran(polled: take Result<Vec<u8>, IoError>) -> Result<Ran, ToolError> {
    var r = Reader::new(answer(take polled)?)
    let Ok(status) = r.read_u32() else { return Err(malformed("run/run")) }
    let Some(stdout) = read_data(mut r) else { return Err(malformed("run/run")) }
    let Some(stderr) = read_data(mut r) else { return Err(malformed("run/run")) }
    if !r.at_end() {
        return Err(malformed("run/run"))
    }
    Ok(Ran { status: i32(status), stdout, stderr })
}

@test
fn a_ran_reads_back() {
    var w = Writer::new()
    w.write_u8(0)
    w.write_u32(4294967287)
    write_data(mut w, Data::Bytes(Vec::from([u8(104), 105])))
    write_data(mut w, Data::empty())
    let Ok(ran) = read_ran(Ok(take w.into_bytes())) else { panic("a ran") }
    assert(ran.status == -9, "minus the signal")
    let Data::Bytes(out) = ran.stdout else { panic("bytes") }
    assert(out.len() == 2 && out[0] == 104)
}
