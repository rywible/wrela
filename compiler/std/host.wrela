// Requests to a named service of the host, such as the clipboard or the page's address: bytes
// out, bytes back. A request carries a service name and bytes that only the service reads; the
// host knows nothing more of them. What each service's bytes mean is Wrela code's
// (`platform::host`). The answer comes on a `Pending`, as any request's does (`std::io`).

use std::io::{Pending, next_request, path_problem}

/// Sends `bytes` to the host's service `service`, a relative path such as `clipboard/offer`. The
/// request and answer bytes are the service's own. A host without the service fails the request,
/// as any failed request fails.
pub fn request(service: str, bytes: [u8]) -> Pending<u8> {
    if let Some(why) = path_problem(service) {
        panic(f"host service `{service}` {why}")
    }
    if service.len() + bytes.len() > 1048576 - 128 {
        panic("host request is larger than the command buffer permits")
    }
    let id = next_request()
    host_command(id, service, bytes)
    Pending::new(id)
}

@intrinsic
fn host_command(request: u32, service: str, bytes: [u8]) {}
