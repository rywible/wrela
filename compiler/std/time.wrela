// The clock (M6): how long the program's work takes, read while it runs. It's `nondet` (§8): what
// it reads depends on the machine and when the code runs, so `@deterministic` code, a constant
// and a test can't read it (D-052). A simulation takes its time as data, a tick's length.
//
// The hosts give it through `wrela.clock` (runtime/abi): seconds on the host's clock, an `f64`
// that never goes back, the same clock on every thread. Where it starts is the host's: a time is
// for comparing with another time the program read.

use std::abi::CLOCK
use std::mem::{read, read_clock, thread_block}

/// Seconds on the host's clock, which never goes back: for timing a phase of work, `let t =
/// now()` before it and `since(t)` after.
pub fn now() -> f64 {
    unsafe {
        let at = thread_block() + CLOCK
        read_clock(at)
        read::<f64>(at)
    }
}

/// The seconds since `start` (a time `now` gave), as an `f32`: a phase's length, for a report.
pub fn since(start: f64) -> f32 {
    f32(now() - start)
}
