// The prelude: in scope in every module, with the built-in types and functions.

pub use std::cmp::{Eq, Ord, Ordering}
pub use std::collections::{Bounded, Box, Vec, replace, swap}
pub use std::string::{Bytes, String, Text}
pub use std::arena::{Arena, Handle, SortedMap}
pub use std::quat::Quat
use std::hash::StateHash
use std::serialize::Serialize

/// A value that may be absent. There's no null (language.md §6.1).
pub enum Option<T>: Copy + Eq + Ord + StateHash + Serialize + Plain {
    None,
    Some(T),
}

/// The outcome of something that can fail: its value, or an error (§15). `x?` is `x`'s value,
/// or returns its `Err` from the function.
pub enum Result<T, E>: Copy + Eq + Ord + StateHash + Serialize {
    Ok(T),
    Err(E),
}

impl<T> Option<T> {
    /// Whether it holds a value.
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    /// Whether it's `None`.
    pub fn is_none(self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }

    /// Its value; panics if it's `None`.
    pub fn unwrap(take self) -> T {
        match take self {
            Some(x) => x,
            None => panic("unwrap of `None`"),
        }
    }

    /// Its value; panics with `message` if it's `None`.
    pub fn expect(take self, message: str) -> T {
        match take self {
            Some(x) => x,
            None => panic(message),
        }
    }

    /// Its value, or `default` if it's `None`.
    pub fn unwrap_or(take self, default: take T) -> T {
        match take self {
            Some(x) => x,
            None => take default,
        }
    }
}

impl<T, E> Result<T, E> {
    /// Whether it's `Ok`.
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    /// Whether it's `Err`.
    pub fn is_err(self) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }

    /// Its value; panics if it's an `Err`.
    pub fn unwrap(take self) -> T {
        match take self {
            Ok(x) => x,
            Err(_) => panic("unwrap of an `Err`"),
        }
    }

    /// Its value, or `None` if it's an `Err`.
    pub fn ok(take self) -> Option<T> {
        match take self {
            Ok(x) => Some(x),
            Err(_) => None,
        }
    }
}

/// Deep-copied with `.clone()` (§6.1). A type declares it, `struct S: Clone { ... }`, and the
/// compiler derives it field by field; declaring `Copy` declares it too.
@fieldwise
pub trait Clone {
    /// A deep copy.
    fn clone(self) -> Self

    /// Copies this into `into`, reusing what `into` owns: a `Vec` keeps its buffer, so once
    /// `into` has grown to size, nothing is allocated (§6.11).
    fn clone_into(self, into: mut Self) {
        into = self.clone()
    }
}

/// Copied implicitly (§6.1). Opted in like `Clone`; every field must be `Copy`.
pub trait Copy: Clone {}

/// Laid out by WGSL's rules everywhere, so its bytes are the same on the CPU and the GPU
/// (§6.10). Opted in; every field must be `GpuData`.
pub trait GpuData {}

/// An enum whose variants hold nothing: each is its discriminant, which `u32(e)` gives and
/// `E::from_u32(n)` reads back (§3). Declared like `Copy`, and checked: no variant has fields.
/// Generic code over one (`std::collections::Flags`) converts it as a concrete one does, both
/// ways: `u32(t)` and `T::from_u32(n)`.
pub trait Fieldless {
    /// The variant whose discriminant `n` is, or `None`.
    fn from_u32(n: u32) -> Option<Self> {
        if is_discriminant::<Self>(n) { Some(of_discriminant::<Self>(n)) } else { None }
    }
}

/// Whether `n` is the discriminant of one of `E`'s variants.
@intrinsic
fn is_discriminant<E: Fieldless>(n: u32) -> bool {}

/// `E`'s variant whose discriminant `n` is (`is_discriminant::<E>(n)`).
@intrinsic
fn of_discriminant<E: Fieldless>(n: u32) -> E {}

/// A struct packed into one `u32` (§3): each field a `Bits<N>`, the first in the low bits. A
/// field reads as a `u32`, and takes one that fits its bits: one that doesn't traps on the CPU,
/// and the GPU keeps its low bits, as its integers wrap. `u32(p)` is its word, and
/// `T::of_bits(w)` the struct a word holds. Declared like `Copy`, and checked (E0407).
pub trait Packed {
    /// The struct the word `w` holds.
    fn of_bits(w: u32) -> Self {
        packed_of::<Self>(w)
    }
}

/// The `Packed` struct `P` whose word `w` is.
@intrinsic
fn packed_of<P: Packed>(w: u32) -> P {}

/// `N` bits of a `Packed` struct's word: a field's width, 1 to 32 (§3).
pub struct Bits<const N: u32> {}

/// `v`, which fits in `n` bits: a `Packed` field's value. One that doesn't traps on the CPU; the
/// GPU keeps its low `n` bits.
@intrinsic
fn packed_fit(v: u32, n: u32) -> u32 {}

/// Data that can be handled as raw bytes: no pointers, padding zeroed, NaNs canonical, so a
/// value's bytes are a function of its fields (§6.10). Declared like `Copy`, and checked: every
/// field must be `Plain`. `Vec`, `String` and `Box` aren't.
@fieldwise
pub trait Plain {}

impl Plain for bool {}

impl Plain for u8 {}

impl Plain for i8 {}

impl Plain for u16 {}

impl Plain for i16 {}

impl Plain for u32 {}

impl Plain for i32 {}

impl Plain for u64 {}

impl Plain for i64 {}

impl Plain for f32 {}

impl Plain for f64 {}

impl Plain for vec2 {}

impl Plain for vec3 {}

impl Plain for vec4 {}

impl Plain for vec2i {}

impl Plain for vec3i {}

impl Plain for vec4i {}

impl Plain for vec2u {}

impl Plain for vec3u {}

impl Plain for vec4u {}

impl Plain for vec2d {}

impl Plain for vec3d {}

impl Plain for vec4d {}

impl Plain for mat2 {}

impl Plain for mat3 {}

impl Plain for mat4 {}

impl Plain for Text {}

impl Plain for Bytes {}
