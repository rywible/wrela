// Raw memory: what std's unsafe core is built on (language.md §6.14). Addresses are `u32`s, and
// nothing here is checked: a wrong address or size breaks the program's memory. Each function
// can be called only inside `unsafe`, which only std's core uses.

use std::abi::{PANIC, THREAD_BLOCKS, THREAD_BLOCK_SIZE}

/// A destructor: what dropping a value does besides dropping its fields. Only std's core
/// implements it (§18), for the types that own memory: `Vec`, `Box`.
pub trait Drop {
    /// Frees what the value owns. The compiler calls it once, when the value is dropped.
    fn drop(mut self)
}

/// The bytes a `T` takes, padding included: the distance between neighbours in an array.
@intrinsic
pub fn size_of<T>() -> u32 {}

/// The alignment of a `T`, in bytes.
@intrinsic
pub fn align_of<T>() -> u32 {}

/// Whether dropping a `T` does anything: whether it holds memory to free.
@intrinsic
pub fn needs_drop<T>() -> bool {}

/// The `T` at `addr`, moved out. The memory is left as it was: what's there mustn't be dropped
/// again.
@intrinsic
pub fn read<T>(addr: u32) -> T {}

/// A `T` whose bytes are all zero: for a place that's written before it's read (a `Bounded`'s
/// unused elements), since not every type's zero is a value it can hold.
@intrinsic
pub fn zeroed<T>() -> T {}

/// Moves `value` to `addr`. What was there isn't dropped.
@intrinsic
pub fn write<T>(addr: u32, value: take T) {}

/// Drops the `T` at `addr`, and leaves zeros there.
@intrinsic
pub fn drop_at<T>(addr: u32) {}

/// A read-only projection of the `T` at `addr`, which borrows `owner`, the value that owns the
/// memory.
@intrinsic
pub fn at<T, O>(owner: O, addr: u32) -> borrow T {}

/// A mutable projection of the `T` at `addr`, which borrows `owner` mutably.
@intrinsic
pub fn at_mut<T, O>(owner: mut O, addr: u32) -> mut T {}

/// Two values to change at once: what `pair_mut` gives (`Vec`'s, `Arena`'s). Each field is a
/// `mut` projection, and the two never overlap.
pub borrow struct Pair<T> {
    pub a: mut T,
    pub b: mut T,
}

/// Mutable projections of the `T`s at `a` and `b`, which must not overlap, both borrowing
/// `owner` mutably.
@intrinsic
pub fn at_mut_pair<T, O>(owner: mut O, a: u32, b: u32) -> Pair<T> {}

/// Where the heap starts: the first page after the program's constants.
@intrinsic
pub fn heap_base() -> u32 {}

/// The memory's size, in 64 KiB pages.
@intrinsic
pub fn memory_pages() -> u32 {}

/// Grows the memory by `pages` pages: its old size in pages, or `u32::MAX` if it can't grow.
@intrinsic
pub fn memory_grow(pages: u32) -> u32 {}

/// The `u32` at `addr`, little-endian.
@intrinsic
pub fn load_u32(addr: u32) -> u32 {}

/// Writes `value` at `addr`, little-endian.
@intrinsic
pub fn store_u32(addr: u32, value: u32) {}

/// The byte at `addr`.
@intrinsic
pub fn load_u8(addr: u32) -> u8 {}

/// Writes the byte `value` at `addr`.
@intrinsic
pub fn store_u8(addr: u32, value: u8) {}

/// Copies `bytes` bytes from `src` to `dst`; the ranges may overlap.
@intrinsic
pub fn copy(dst: u32, src: u32, bytes: u32) {}

/// Sets `bytes` bytes at `dst` to `byte`.
@intrinsic
pub fn fill(dst: u32, byte: u32, bytes: u32) {}

/// Compares the `u32` at `addr` with `expected` and, if they're equal, replaces it with `new`:
/// the value that was there. Atomic once workers share the memory.
@intrinsic
pub fn compare_swap(addr: u32, expected: u32, new: u32) -> u32 {}

/// Copies request `request`'s answer, which the host holds, to `addr`, and forgets the request
/// (`wrela.request_take`). The caller makes room for the bytes `std::io::request_status` gave.
@intrinsic
pub fn take_answer(request: u32, addr: u32) {}

/// Copies up to `cap` of the input events the host has queued to `addr`, oldest first, 24
/// bytes each (`wrela.input`): how many it copied. The caller makes room for `cap` of them.
@intrinsic
pub fn take_input(addr: u32, cap: u32) -> u32 {}

/// Gives the host `bytes` to keep for the build that replaces this one (`wrela.keep`,
/// `std::reload`): they replace what it kept before.
@intrinsic
pub fn keep_bytes(bytes: [u8]) {}

/// Writes the seconds on the host's clock to `addr`, an `f64` that never goes back
/// (`wrela.clock`).
@intrinsic
pub fn read_clock(addr: u32) {}

/// Copies up to `cap` of the bytes the build this one replaced kept to `addr`
/// (`wrela.kept`): how many it kept, all of them, which may be more than `cap`.
@intrinsic
pub fn kept_bytes(addr: u32, cap: u32) -> u32 {}

/// Adds `value` to the `u32` at `addr`, atomically: the old value. Workers share the memory.
@intrinsic
pub fn atomic_add(addr: u32, value: u32) -> u32 {}

/// The `u32` at `addr`, read atomically.
@intrinsic
pub fn atomic_load(addr: u32) -> u32 {}

/// Stores `value` at `addr`, atomically.
@intrinsic
pub fn atomic_store(addr: u32, value: u32) {}

/// Waits while the `u32` at `addr` is `expected` (until another thread `notify`s it): 0 when
/// woken, 1 when it wasn't `expected`.
@intrinsic
pub fn wait(addr: u32, expected: u32) -> u32 {}

/// Wakes up to `count` threads waiting at `addr`: how many it woke.
@intrinsic
pub fn notify(addr: u32, count: u32) -> u32 {}

/// Runs task `task` (`task`'s number) on chunk `chunk`, with its context at `ctx`.
@intrinsic
pub fn run_task(task: u32, ctx: u32, chunk: u32) {}

/// The number of a task: a function the module calls by number (`run_task`, a host's thread
/// entries) with a chunk and a context's address, which runs `run(chunk, mut context)`, the
/// context being the `C` there. `run` is a named function: what runs on another thread has no
/// captures of this one's.
@intrinsic
pub fn task<C>(run: fn(u32, mut C)) -> u32 {}

/// The running thread's block's address: the program's thread's, or the one a thread entry
/// was given. A block holds the thread's parallel job, what it runs for others, its counts and
/// its panic message (wrela_abi::memory's threads).
@intrinsic
pub fn thread_block() -> u32 {}

/// Adds `by` to the count at `word` in this thread's block, wrapping at 2³²: only this thread
/// writes its counts. (`word` is taken, so a constant comes as its value: one that's borrowed is
/// read from memory.)
pub(package) fn count(word: take u32, by: u32) {
    unsafe {
        let at = thread_block() + word
        store_u32(at, load_u32(at).wrapping_add(by))
    }
}

/// Waits as `wait` does, for at most `micros` microseconds: 0 when woken, 1 when it wasn't
/// `expected`, 2 when the time ran out.
@intrinsic
pub fn wait_for(addr: u32, expected: u32, micros: u32) -> u32 {}

/// Traps, keeping the panic message this thread's block has (another thread's, copied there).
@intrinsic
pub fn abort() {}

/// Traps with the panic message thread `thread` left: the program panics with another thread's
/// panic (`std::par`'s helpers).
pub fn abort_from(thread: u32) {
    unsafe {
        let from = THREAD_BLOCKS + thread * THREAD_BLOCK_SIZE + PANIC
        let to = thread_block() + PANIC
        if from != to {
            copy(to, from, THREAD_BLOCK_SIZE - PANIC)
        }
        abort()
    }
}

/// Whether this is a debug build (`wrela build --debug`, and `wrela test`), which pays for
/// checks a release build doesn't make: a constant, so a release build has no trace of them,
/// nor of the functions only they call. GPU code can ask too.
@intrinsic
pub fn debug_build() -> bool {}

/// Whether this is a test build (`wrela build --testing`, a test harness's, and `wrela test`),
/// which has the program's `@testing` exports (§9): a constant, so a shipped build has no trace
/// of what only tests do, such as a view only tests show, nor of the pipelines only it draws.
@intrinsic
pub fn test_build() -> bool {}
