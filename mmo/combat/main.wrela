// A party's fight as a room (std::net): what the room orders is only the fight's start and, at its
// end, each player's input log; it never sees the live inputs, which go between the players over
// the room's relay (std::net::relay, codec.wrela). Every peer and the room run the fight again from
// the logs (sim::run, in the reducer), so the outcome is the same everywhere, and a player whose
// own run disagrees knows its inputs didn't arrive as it sent them. What's written is the outcome
// alone: one store row a fight, and a journal row for its start and each log.
//
// Players wait for a fight in the room's lobby (`Join`), and one of them begins it for whoever is
// waiting. When a fight ends, its players who played it wait for the next at once, after anyone who
// waited during it, so a party that fell is one press from going again (`Fight::finish`).
//
// Who the players are comes from their accounts, as on the island (mmo/island): a player joins
// wearing its character's card with the pass its account signed, which the server checks before
// the room sees the join, and the room keeps who each player is. When a party wins, the server
// writes each winner down, by name, where the rooms' store keeps it (platform/progress.wrela),
// and the winner's account counts it when its client asks (`Request::Record`, by `Fight::id`).
// A guest (no card, or one its account didn't sign) fights all the same, and nothing is written.
//
// A signed player whose page reloads mid-fight (or whose connection was lost) comes back to its
// slot as the new peer it is (`Rejoin`). Its inputs so far are known only to the others, who heard
// them: the first to answer hands them to the room (`Handoff`), which keeps them as that slot's
// log until the frame it was handed at, and the player's own log carries on from there. Every
// peer runs the slot from that log, so all of them, and the room, agree again. Alone, no one heard
// it, and the fight ends as it stands.
//
// The costs this shape is for (the server design doc's budget): a fight of four is five proposals
// and one store write, however long it lasts; its inputs cost the room nothing.

use island::main::{Card, NOBODY, Seal, pass_of, sealed}
use platform::pass
use platform::progress
use sim::{Change, LONGSWORD, Log, MAX_CHANGES, MAX_FRAMES, MAX_PARTY, Outcome, WEAPONS, Winner}
use std::input::{Event, events, payload}
use std::net::{COMPACT_AFTER, Entry, JOURNAL, POISONED, Record, Reduce, Room, Up, Verdict}
use std::net::{carry_out, compact, room}
use std::pack::{Pack, pack, unpack}
use std::server::secret
use std::store
use std::time::unix_now

/// How long after the first log the rest may take, in ms, before anyone may settle the fight
/// without them (a player who left counts as standing still).
pub const SETTLE_MS: u64 = 30000

// Why the room refuses a decision.
/// A fight is on already, or none is.
pub const NOT_NOW: u32 = 1
/// A party that isn't one: empty, too big, the same peer twice, or without its proposer.
pub const BAD_PARTY: u32 = 2
/// A log from a peer not in the fight, a second one, or one no player could send.
pub const BAD_LOG: u32 = 3
/// A settle before `SETTLE_MS` after the first log, or before any log while the fight could
/// still be on.
pub const TOO_SOON: u32 = 4
/// A join to a full lobby; a leave, or a begin, by a peer not in it.
pub const NOT_WAITING: u32 = 5
/// A log longer than a player's share of what the room's state holds (`PLAYER_CHANGES`).
pub const TOO_LONG: u32 = 6
/// A join with a weapon that isn't one (`sim::WEAPONS`).
pub const BAD_WEAPON: u32 = 7
/// A join with a card whose name the lists don't make, or whose look isn't one of the choices.
pub const BAD_CARD: u32 = 8
/// A rejoin as no player of the fight still to send its log (or by one in it), or a handoff for
/// a slot that doesn't wait for one.
pub const NOT_YOURS: u32 = 9
/// A delayed decision for another round of this room.
pub const STALE_FIGHT: u32 = 10

/// A slot's `cuts` while its player never left: its log is its own.
pub const UNCUT: u32 = 4294967295
/// A slot's `cuts` while its player came back and the room waits for another player to hand it
/// what was heard of it (`Act::Handoff`).
pub const HANDING: u32 = 4294967294
/// How long, in room ms, a player who came back waits for its log to be handed to it before it
/// may settle the fight (no one else is left to hand it).
pub const HANDOFF_MS: u64 = 10000
/// Frames a handoff may run ahead of the room's clock (a player's clock runs a little ahead).
pub const HANDOFF_SLACK: u32 = 300

/// The bosses, by the number an account's progress counts them by (platform/wire.wrela's
/// `Beaten`): the cathedral's idol, the only one yet.
pub const IDOL: u32 = 1

/// How long a peer waits in the lobby, in room ms, unless it joins again: a peer that left
/// without a word stops counting once it's past.
pub const LOBBY_MS: u64 = 60000
/// The most changes the logs of one fight hold together. A peer far behind is sent the room's
/// state whole, in one message of at most 64 KiB, and a change packs into about 5 bytes.
pub const MAX_LOGGED: u32 = 11000
/// The most changes one player's log holds, so every player's fits with the others'.
pub const PLAYER_CHANGES: u32 = MAX_LOGGED / MAX_PARTY

/// The longest a fight can last, in room ms: past it and `SETTLE_MS` more, anyone may settle it,
/// logs or none, so a party that left (or one that never fought) can't hold the room.
pub const FIGHT_MS: u64 = 600000
/// How long a player who played a fight waits for the next one when it ends, in room ms, unless
/// its client joins again (`Join`) to say it's still there: then `LOBBY_MS`, as any join.
pub const AGAIN_MS: u64 = 15000
/// No peer's id: a room gives peers ids from 1.
const NONE_PEER: u32 = 0

/// Where `peer` is in `peers`, if it is.
fn slot_in(peers: [u32], peer: u32) -> Option<u32> {
    for i in 0..peers.len() {
        if peers[i] == peer {
            return Some(i)
        }
    }
    None
}

/// Who waits, as `Fight`'s lobby keeps it, in parallel.
struct Lobby {
    peers: Vec<u32>,
    times: Vec<u64>,
    weapons: Vec<u32>,
    cards: Vec<Card>,
    signed: Vec<bool>,
}

fn no_one() -> Lobby {
    Lobby {
        peers: Vec::new(),
        times: Vec::new(),
        weapons: Vec::new(),
        cards: Vec::new(),
        signed: Vec::new(),
    }
}

impl Lobby {
    fn add(mut self, peer: u32, at: u64, weapon: u32, card: Card, signed: bool) {
        self.peers.push(peer)
        self.times.push(at)
        self.weapons.push(weapon)
        self.cards.push(card)
        self.signed.push(signed)
    }
}

/// A peer's message as the room is to see it: a join has its seal checked against `keys` at `now`
/// (Unix milliseconds) and its pass taken off; anything else is as it came, a message that isn't
/// the protocol's included (the room refuses it).
pub fn checked_message(bytes: take Vec<u8>, keys: [[u8; 32]], now: u64) -> Vec<u8> {
    let Ok(up) = unpack::<Up<Act>>(bytes.clone()) else { return take bytes }
    match up {
        Up::Propose { peer, session, counter, value: Act::Join { weapon, card, seal } } => {
            let ok = card != NOBODY && pass::opens(keys, pass_of(card, seal), now)
            let value = Act::Join { weapon, card, seal: sealed(ok) }
            pack(Up::<Act>::Propose { peer, session, counter, value })
        },
        Up::Propose { peer, session, counter, value: Act::Rejoin { began, round, card, seal } } => {
            let ok = card != NOBODY && pass::opens(keys, pass_of(card, seal), now)
            let value = Act::Rejoin { began, round, card, seal: sealed(ok) }
            pack(Up::<Act>::Propose { peer, session, counter, value })
        },
        _ => take bytes,
    }
}

/// The room's state: who's waiting to fight, the fight on (or the last one), and how many it has
/// finished.
pub struct Fight: Clone + Pack {
    /// The peers waiting for the next fight, in the order they joined, and when each last
    /// joined (at most `MAX_PARTY` of them within `LOBBY_MS`).
    pub lobby: Vec<u32>,
    pub joined: Vec<u64>,
    /// The weapon each brings (`sim::WEAPONS`).
    pub wielding: Vec<u32>,
    /// Who each is (`NOBODY`, a guest), and whether its account signed it (the server checked).
    pub cards: Vec<Card>,
    pub signed: Vec<bool>,
    /// The players, by peer, in their slots (empty: none yet), their weapons, who each is and
    /// whether its account signed it.
    pub party: Vec<u32>,
    pub armed: Vec<u32>,
    pub faces: Vec<Card>,
    pub named: Vec<bool>,
    pub logs: Vec<Log>,
    pub sent: Vec<bool>,
    /// Once settled, whether each player played it: its log came, with inputs in it.
    pub played: Vec<bool>,
    /// For each slot whose player came back (`Rejoin`): `HANDING` while the room waits for its
    /// log so far, then the frame that log stands until (`logs` holds it, and the player's own log
    /// carries on from there); `UNCUT` for a player who never left. And when it came back.
    pub cuts: Vec<u32>,
    pub rejoined_at: Vec<u64>,
    /// When the fight began (room ms).
    pub began_at: u64,
    /// When the first log came (room ms).
    pub first_at: u64,
    /// Whether the last fight is settled: then its outcome is `outcome`, and a new one may begin.
    pub settled: bool,
    pub outcome: Outcome,
    pub fights: u32,
    pub finished_at: u64,
}

/// A peer's decision. A log, rejoin or handoff names its fight by `(began, round)`, where `round`
/// is `Fight::fights` before that fight settles: a late proposal cannot change the next fight.
pub enum Act: Clone + Pack {
    /// The proposer waits for the next fight, bringing weapon `weapon` (`sim::WEAPONS`), as
    /// `card` (its character's, or `NOBODY`), worn with its account's pass (`seal`), which the
    /// server checks (`checked_message`).
    Join { weapon: u32, card: Card, seal: Seal },
    /// The proposer stops waiting.
    Leave,
    /// A fight starts, for whoever waits (the proposer among them).
    Begin,
    /// The proposer's input log, the fight having ended at frame `end` as it saw it.
    Log { began: u64, round: u32, changes: Vec<Change>, end: u32 },
    /// The fight is settled without the logs that didn't come.
    Settle,
    /// The proposer is the player wearing `card` (with its account's pass, `seal`, checked as a
    /// join's is) back in the fight it left (a page reloaded, a connection lost): it takes its
    /// slot again, and waits for another player to hand it its log so far.
    Rejoin { began: u64, round: u32, card: Card, seal: Seal },
    /// The log of the player in slot `slot` who came back, as the proposer heard it, standing
    /// until frame `upto`: the room keeps it, and the player's log carries on from there.
    Handoff { began: u64, round: u32, slot: u32, changes: Vec<Change>, upto: u32 },
}

impl Fight {
    pub fn empty() -> Fight {
        Fight {
            lobby: Vec::new(),
            joined: Vec::new(),
            wielding: Vec::new(),
            cards: Vec::new(),
            signed: Vec::new(),
            party: Vec::new(),
            armed: Vec::new(),
            faces: Vec::new(),
            named: Vec::new(),
            logs: Vec::new(),
            sent: Vec::new(),
            played: Vec::new(),
            cuts: Vec::new(),
            rejoined_at: Vec::new(),
            began_at: 0,
            first_at: 0,
            settled: false,
            outcome: Outcome { winner: Winner::Draw, frames: 0, dealt: Vec::new(), boss_hp: 0 },
            fights: 0,
            finished_at: 0,
        }
    }

    /// Whether a fight is on.
    pub fn on(self) -> bool {
        self.party.len() > 0 && !self.settled
    }

    fn slot(self, peer: u32) -> Option<u32> {
        for i in 0..self.party.len() {
            if self.party[i] == peer {
                return Some(i)
            }
        }
        None
    }

    /// The slot of the fight on whose player has `card`'s name (its account signed it) and hasn't
    /// sent its log: a cosmetic change on another page doesn't change who owns the slot.
    pub fn seat_of(self, card: Card) -> Option<u32> {
        if !self.on() || card == NOBODY {
            return None
        }
        for i in 0..self.party.len() {
            if self.named[i] && self.faces[i].name() == card.name() && !self.sent[i] {
                return Some(i)
            }
        }
        None
    }

    /// Slot `s`'s log with `changes` (its player's own, the fight having ended at `end`): after
    /// what was handed to it, if its player came back.
    fn log_of(self, s: u32, changes: [Change], end: u32) -> Vec<Change> {
        if self.cuts[s] == UNCUT {
            return Vec::from(changes)
        }
        sim::spliced(self.logs[s].changes, self.cuts[s], changes, end)
    }

    /// Whether `peer` waits for the next fight (as a client sees it: however long ago it joined).
    pub fn waiting(self, peer: u32) -> bool {
        for p in self.lobby {
            if p == peer {
                return true
            }
        }
        false
    }

    /// Whether `peer` waits at room time `at`: it joined within `LOBBY_MS`.
    fn waits(self, peer: u32, at: u64) -> bool {
        for i in 0..self.lobby.len() {
            if self.lobby[i] == peer && at.wrapping_sub(self.joined[i]) < LOBBY_MS {
                return true
            }
        }
        false
    }

    /// The lobby at room time `at`: who joined within `LOBBY_MS`, but `without`.
    fn fresh(self, at: u64, without: u32) -> Lobby {
        var l = no_one()
        for i in 0..self.lobby.len() {
            if self.lobby[i] != without && at.wrapping_sub(self.joined[i]) < LOBBY_MS {
                l.add(
                    self.lobby[i],
                    self.joined[i],
                    self.wielding[i],
                    self.cards[i],
                    self.signed[i],
                )
            }
        }
        l
    }

    /// How many other peers are still waiting: validation needs no parallel lobby vectors.
    fn fresh_count(self, at: u64, without: u32) -> u32 {
        var count: u32 = 0
        for i in 0..self.lobby.len() {
            if self.lobby[i] != without && at.wrapping_sub(self.joined[i]) < LOBBY_MS {
                count += 1
            }
        }
        count
    }

    fn wait_as(mut self, l: take Lobby) {
        let w = take l
        self.lobby = take w.peers
        self.joined = take w.times
        self.wielding = take w.weapons
        self.cards = take w.cards
        self.signed = take w.signed
    }

    fn any_sent(self) -> bool {
        for s in self.sent {
            if s {
                return true
            }
        }
        false
    }

    fn finish(mut self, at: u64) {
        self.outcome = sim::run_armed(self.armed, self.logs)
        // Whoever waited during the fight keeps its place. Then the players who played it (their
        // logs came, with inputs in them) wait for the next one, with the weapons they fought
        // with, while there's room, so a party that fell is one press from going again. Each is
        // back for `AGAIN_MS` only, unless its client joins again to say it's still there: a
        // player who closed its tab, or stood still, isn't drafted into the next fight.
        self.played = Vec::new()
        for i in 0..self.party.len() {
            self.played.push(self.sent[i] && self.logs[i].changes.len() > 0)
        }
        var lobby = self.fresh(at, NONE_PEER)
        for i in 0..self.party.len() {
            if self.played[i] &&
                lobby.peers.len() < MAX_PARTY &&
                slot_in(lobby.peers, self.party[i]).is_none() {
                // A short wait may begin before room time zero. Keep its offset modulo u64;
                // `waits` and `fresh` compare elapsed time, so a new room gets the same expiry.
                let since = at.wrapping_add(AGAIN_MS).wrapping_sub(LOBBY_MS)
                lobby.add(self.party[i], since, self.armed[i], self.faces[i], self.named[i])
            }
        }
        self.wait_as(take lobby)
        // The outcome is what's kept: the logs would make the state too big to send a peer.
        self.logs = Vec::new()
        self.settled = true
        self.fights += 1
        self.finished_at = at
    }

    /// The last fight's id (platform/progress.wrela's `fight_id`) in room `room`: what a winner's
    /// client asks its account to record.
    pub fn id(self, room: str) -> Vec<u8> {
        progress::fight_id(room, self.began_at, self.fights)
    }

    /// Who won the last fight, if its party did: each player who played it (`played`) and whose
    /// account signed who it is.
    pub fn winners(self) -> Vec<Card> {
        var out: Vec<Card> = Vec::new()
        if !self.settled || self.outcome.winner != Winner::Party {
            return out
        }
        for i in 0..self.party.len() {
            if self.named[i] && self.played[i] {
                out.push(self.faces[i])
            }
        }
        out
    }

    /// Whether `peer` fought the last fight to its end (its log came): the room may have put it
    /// back in the lobby.
    pub fn fought_last(self, peer: u32) -> bool {
        if !self.settled {
            return false
        }
        let Some(s) = self.slot(peer) else { return false }
        self.sent[s]
    }
}

impl Reduce<Act> for Fight {
    fn check(self, entry: Entry<Act>) -> Verdict {
        let peer = entry.id.peer
        match entry.value {
            Act::Join { weapon, card, .. } => {
                if weapon >= WEAPONS.len() {
                    return Verdict::Reject(BAD_WEAPON)
                }
                if card != NOBODY && !card.valid() {
                    return Verdict::Reject(BAD_CARD)
                }
                // Joining again keeps a peer waiting (with the weapon it brings now).
                if self.fresh_count(entry.at, peer) >= MAX_PARTY {
                    Verdict::Reject(NOT_WAITING)
                } else {
                    Verdict::Accept
                }
            },
            Act::Leave => if self.waiting(peer) { Verdict::Accept } else {
                Verdict::Reject(NOT_WAITING)
            },
            Act::Begin => {
                if self.on() {
                    return Verdict::Reject(NOT_NOW)
                }
                if self.waits(peer, entry.at) { Verdict::Accept } else {
                    Verdict::Reject(NOT_WAITING)
                }
            },
            Act::Log { began, round, changes, end } => {
                if !self.on() {
                    return Verdict::Reject(NOT_NOW)
                }
                if began != self.began_at || round != self.fights {
                    return Verdict::Reject(STALE_FIGHT)
                }
                let Some(s) = self.slot(peer) else { return Verdict::Reject(BAD_LOG) }
                // A player who came back carries on from the input it was handed.
                let before = if self.cuts[s] == UNCUT || self.cuts[s] == HANDING { 0 } else {
                    sim::input_before(self.logs[s].changes, self.cuts[s])
                }
                if self.sent[s] ||
                    self.cuts[s] == HANDING ||
                    end > MAX_FRAMES ||
                    !sim::well_formed(changes, end, MAX_CHANGES, before) {
                    return Verdict::Reject(BAD_LOG)
                }
                // An uninterrupted log is already the final sequence: count it without copying
                // every change into a temporary vector that validation immediately discards.
                let count = if self.cuts[s] == UNCUT { changes.len() } else {
                    self.log_of(s, changes, end).len()
                }
                if count > PLAYER_CHANGES {
                    return Verdict::Reject(TOO_LONG)
                }
                Verdict::Accept
            },
            Act::Settle => {
                if !self.on() {
                    return Verdict::Reject(NOT_NOW)
                }
                // A player who came back and wasn't handed its log in a while: no one else is left.
                if let Some(s) = self.slot(peer) {
                    if self.cuts[s] == HANDING && entry.at >= self.rejoined_at[s] + HANDOFF_MS {
                        return Verdict::Accept
                    }
                }
                // Past the longest fight, anyone may settle it; before, a player in it, once a log
                // came and the rest had their time.
                if entry.at >= self.began_at + FIGHT_MS + SETTLE_MS {
                    return Verdict::Accept
                }
                if self.slot(peer).is_none() {
                    return Verdict::Reject(BAD_LOG)
                }
                if !self.any_sent() || entry.at < self.first_at + SETTLE_MS {
                    return Verdict::Reject(TOO_SOON)
                }
                Verdict::Accept
            },
            Act::Rejoin { began, round, card, seal } => {
                if !self.on() {
                    return Verdict::Reject(NOT_NOW)
                }
                if began != self.began_at || round != self.fights {
                    return Verdict::Reject(STALE_FIGHT)
                }
                // Only the server's finding is believed, as for a join.
                if !seal.checked || self.slot(peer).is_some() || self.seat_of(card).is_none() {
                    return Verdict::Reject(NOT_YOURS)
                }
                Verdict::Accept
            },
            Act::Handoff { began, round, slot, changes, upto } => {
                if !self.on() {
                    return Verdict::Reject(NOT_NOW)
                }
                if began != self.began_at || round != self.fights {
                    return Verdict::Reject(STALE_FIGHT)
                }
                let Some(h) = self.slot(peer) else { return Verdict::Reject(BAD_LOG) }
                // Only a player its account signed hands a log on, so who did is known.
                if slot >= self.party.len() ||
                    slot == h ||
                    !self.named[h] ||
                    self.cuts[slot] != HANDING {
                    return Verdict::Reject(NOT_YOURS)
                }
                // Nothing past the frame the fight can be at, by the room's clock, and a little.
                let elapsed = if entry.at > self.began_at { entry.at - self.began_at } else { 0 }
                let most = min(u64(MAX_FRAMES), elapsed * u64(sim::HZ) / 1000 + u64(HANDOFF_SLACK))
                if u64(upto) > most || !sim::well_formed(changes, upto, MAX_CHANGES) {
                    return Verdict::Reject(BAD_LOG)
                }
                if changes.len() > PLAYER_CHANGES {
                    return Verdict::Reject(TOO_LONG)
                }
                Verdict::Accept
            },
        }
    }

    fn apply(mut self, entry: Entry<Act>) {
        let at = entry.at
        let peer = entry.id.peer
        match entry.value {
            Act::Join { weapon, card, seal } => {
                var l = self.fresh(at, peer)
                // Only the server's finding is believed: a peer's own `checked` never reaches
                // the log (`checked_message`).
                let signed = seal.checked && card != NOBODY
                l.add(peer, at, weapon, if signed { card } else { NOBODY }, signed)
                self.wait_as(take l)
            },
            Act::Leave => self.wait_as(self.fresh(at, peer)),
            Act::Begin => {
                // Whoever waits fights now, with what each brought, as who each is.
                let l = self.fresh(at, NONE_PEER)
                let n = l.peers.len()
                self.wait_as(no_one())
                self.party = take l.peers
                self.armed = take l.weapons
                self.faces = take l.cards
                self.named = take l.signed
                self.logs = Vec::new()
                self.sent = Vec::new()
                self.played = Vec::new()
                self.cuts = Vec::new()
                self.rejoined_at = Vec::new()
                for _ in 0..n {
                    self.logs.push(Log { changes: Vec::new() })
                    self.sent.push(false)
                    self.cuts.push(UNCUT)
                    self.rejoined_at.push(0)
                }
                self.settled = false
                self.began_at = at
                self.first_at = 0
            },
            Act::Log { changes, end, .. } => {
                let Some(s) = self.slot(peer) else { return }
                if !self.any_sent() {
                    self.first_at = at
                }
                self.logs[s] = Log { changes: self.log_of(s, changes, end) }
                self.sent[s] = true
                var all = true
                for x in self.sent {
                    if !x {
                        all = false
                    }
                }
                if all {
                    self.finish(at)
                }
            },
            Act::Settle => self.finish(at),
            Act::Rejoin { card, .. } => {
                let Some(s) = self.seat_of(card) else { return }
                self.party[s] = peer
                self.wait_as(self.fresh(at, peer))
                // Alone, no one heard its inputs to hand them back: the fight ends as it stands.
                if self.party.len() == 1 {
                    self.finish(at)
                    return
                }
                self.cuts[s] = HANDING
                self.rejoined_at[s] = at
            },
            Act::Handoff { slot, changes, upto, .. } => {
                self.logs[slot] = Log { changes: changes.clone() }
                self.cuts[slot] = upto
            },
        }
    }
}

/// Where a finished fight's outcome is kept: `fights/`, the room's name, the room's time it
/// began, and its number in the room. Both come from the journal, so writing it again (a call
/// retried) writes the same row.
pub fn key_of(name: str, at: u64, n: u32) -> Vec<u8> {
    var k: Vec<u8> = Vec::new()
    let prefix = "fights/"
    for i in 0..prefix.len() {
        k.push(prefix.byte(i))
    }
    for i in 0..name.len() {
        k.push(name.byte(i))
    }
    k.push(47)
    for i in 0..8 {
        k.push(u8((at >> (8 * (7 - i))) & 255))
    }
    for i in 0..4 {
        k.push(u8((n >> (8 * (3 - i))) & 255))
    }
    k
}

// ---- the server ---------------------------------------------------------------------------------

pub struct Server {
    room: Room<Fight, Act>,
    /// The fights whose outcome is in the store.
    written: u32,
    /// Whether the keys were read (`keys`, those long enough: none, and no pass checks).
    keyed: bool,
    keys: Vec<[u8; 32]>,
    /// The Unix milliseconds at the room's time 0, as the wall clock said when the keys came.
    epoch: u64,
}

pub fn serve_init() -> Server {
    Server { room: Room::new(Fight::empty()), written: 0, keyed: false, keys: Vec::new(), epoch: 0 }
}

/// Reads the pass keys (platform/pass.wrela's `SECRETS`) and the wall clock, once, as the island
/// does: a secret that isn't there, or is too short, makes no key, and a clock that didn't answer
/// leaves every pass expired.
fn read_keys(s: mut Server, at: u64) {
    if s.keyed {
        return
    }
    s.keyed = true
    for name in pass::SECRETS {
        if let Some(bytes) = secret(name) {
            if let Some(k) = pass::key_of(bytes) {
                s.keys.push(k)
            }
        }
    }
    if let Some(ms) = unix_now() {
        s.epoch = if ms > at { ms - at } else { 0 }
    }
}

pub fn serve(s: mut Server, time: f32) {
    let at = u64(time * 1000.0)
    var replayed = false
    for e in events() {
        match e {
            Event::Message { conn, .. } => {
                let Some(bytes) = payload(e) else { continue }
                if conn == JOURNAL {
                    // The room started again on this build: its outcomes were written as they came.
                    match unpack::<Record<Fight, Act>>(take bytes) {
                        Ok(r) => s.room.restore(r),
                        Err(_) => panic("a journal record this program can't read"),
                    }
                    replayed = true
                } else {
                    // Journal replay is served at time zero, while the room's live clock keeps
                    // its age across restarts. Calibrate Unix time only from that live clock.
                    read_keys(mut s, at)
                    // A message decides one proposal at most, so it finishes one fight at most:
                    // its outcome is written before the next can replace it.
                    if conn >= POISONED {
                        carry_out(s.room.poisoned(conn - POISONED, take bytes))
                    } else {
                        let seen = checked_message(take bytes, s.keys, s.epoch + at)
                        carry_out(s.room.receive(conn, take seen, at))
                    }
                    written(mut s)
                }
            },
            Event::Connection { conn, open, tag } => {
                if open {
                    s.room.opened(conn, tag)
                } else {
                    s.room.closed(conn)
                }
            },
            _ => {},
        }
    }
    if replayed {
        s.written = s.room.state().fights
    }
    if s.room.since_snapshot() > COMPACT_AFTER {
        compact(pack(s.room.compact()))
    }
}

/// A fight just finished: its outcome, one row, written with the call's records; and, won, a row
/// for each winner whose account signed who it is, for its account to count (`Request::Record`).
/// When it ended is the room's clock, and the same in a call retried, so a retry writes the
/// same rows.
fn written(s: mut Server) {
    borrow f = s.room.state()
    if f.fights != s.written && f.settled {
        let name = room()
        store::put(key_of(name.as_str(), f.began_at, f.fights), pack(f.outcome.clone()))
        let fight = f.id(name.as_str())
        let ended = s.epoch + f.finished_at
        for c in f.winners() {
            let row = progress::won_row(IDOL, f.outcome.frames, ended)
            store::put(progress::won_key(c.name(), fight), row)
        }
    }
    s.written = f.fights
}

// ---- tests --------------------------------------------------------------------------------------

/// A guest's join (no card), with weapon `weapon`.
fn joins(weapon: u32) -> Act {
    Act::Join { weapon, card: NOBODY, seal: sealed(false) }
}

fn entry(peer: u32, at: u64, value: take Act) -> Entry<Act> {
    Entry { seq: 2, id: std::net::ProposalId { peer, session: 1, counter: 1 }, at, value }
}

/// A fight begun at `at` by the first of `peers`, each having joined just before.
fn begun(fight: mut Fight, peers: [u32], at: u64) {
    for p in peers {
        fight.apply(entry(p, at, joins(LONGSWORD)))
    }
    let begin = entry(peers[0], at, Act::Begin)
    assert(fight.check(begin.clone()) == Verdict::Accept)
    fight.apply(begin)
}

/// A fight's logs, as two players who walk to the boss and swing at it, and their run.
fn two_logs() -> Vec<Log> {
    var a: Vec<Change> = Vec::new()
    var b: Vec<Change> = Vec::new()
    // Walk up (direction 4, full speed: 1 + 4 * 3 + 2), the first a little to the right too
    // (direction 3), so both stand where they reach the boss, then attack over and over.
    a.push(Change { frame: 0, input: 12 })
    b.push(Change { frame: 0, input: 15 })
    var f: u32 = 120
    while f < 3000 {
        a.push(Change { frame: f, input: 64 })
        a.push(Change { frame: f + 2, input: 0 })
        b.push(Change { frame: f + 5, input: 64 })
        b.push(Change { frame: f + 7, input: 0 })
        f += 40
    }
    var logs: Vec<Log> = Vec::new()
    logs.push(Log { changes: a })
    logs.push(Log { changes: b })
    logs
}

@test
fn the_same_logs_give_the_same_fight() {
    let logs = two_logs()
    let one = sim::run(2, logs.clone())
    let two = sim::run(2, logs.clone())
    assert(one == two)
    assert(one.dealt[0] > 0 && one.dealt[1] > 0, "both players' swings land")
    // A player who never swings gives another fight.
    var other = logs.clone()
    other[1].changes.truncate(1)
    assert(sim::run(2, other) != one)
}

@test
fn a_fight_begins_takes_each_log_once_and_settles_to_the_logs_run() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3), 5], 0)
    let logs = two_logs()
    // A peer not in the party can't send a log; one in it, once.
    let stranger = entry(
        9,
        10,
        Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 },
    )
    assert(fight.check(stranger) == Verdict::Reject(BAD_LOG))
    let first = entry(
        3,
        100,
        Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 },
    )
    assert(fight.check(first.clone()) == Verdict::Accept)
    fight.apply(first.clone())
    assert(fight.check(first) == Verdict::Reject(BAD_LOG))
    assert(!fight.settled)
    // Too soon to settle without the second.
    assert(fight.check(entry(3, 200, Act::Settle)) == Verdict::Reject(TOO_SOON))
    fight.apply(
        entry(5, 300, Act::Log { began: 0, round: 0, changes: logs[1].changes.clone(), end: 3000 }),
    )
    assert(fight.settled, "both logs in settle it")
    assert(fight.outcome == sim::run(2, logs))
    assert(fight.fights == 1 && !fight.on())
    assert(fight.logs.len() == 0, "a settled fight keeps its outcome, not its logs")
}

@test
fn a_missing_log_is_settled_as_standing_still() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3), 5], 0)
    let logs = two_logs()
    fight.apply(
        entry(
            3,
            1000,
            Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 },
        ),
    )
    assert(fight.check(entry(5, 1000 + SETTLE_MS, Act::Settle)) == Verdict::Accept)
    fight.apply(entry(5, 1000 + SETTLE_MS, Act::Settle))
    var only: Vec<Log> = Vec::new()
    only.push(logs[0].clone())
    only.push(Log { changes: Vec::new() })
    assert(fight.settled && fight.outcome == sim::run(2, only))
}

@test
fn the_players_who_played_a_fight_wait_for_the_next_at_once() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3), 5], 0)
    // Someone else waits in the room during the fight.
    fight.apply(entry(8, 500, joins(sim::FISTS)))
    let logs = two_logs()
    fight.apply(
        entry(
            3,
            1000,
            Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 },
        ),
    )
    fight.apply(
        entry(
            5,
            1100,
            Act::Log { began: 0, round: 0, changes: logs[1].changes.clone(), end: 3000 },
        ),
    )
    assert(fight.settled)
    // Who waited keeps its place; the fighters are back after it, with their weapons.
    assert(fight.lobby == Vec::from([u32(8), 3, 5]), "who waited, then the party")
    assert(fight.wielding == Vec::from([sim::FISTS, LONGSWORD, LONGSWORD]))
    assert(fight.fought_last(3) && fight.fought_last(5) && !fight.fought_last(8))
    // One press goes again, for all three.
    let again = entry(5, 4000, Act::Begin)
    assert(fight.check(again.clone()) == Verdict::Accept)
    fight.apply(again)
    assert(fight.on() && fight.party == Vec::from([u32(8), 3, 5]))
}

@test
fn a_fighter_is_back_only_a_while_unless_it_says_its_still_there() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3), 5], 0)
    let logs = two_logs()
    let end = 100000
    fight.apply(
        entry(3, end, Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 }),
    )
    fight.apply(
        entry(5, end, Act::Log { began: 0, round: 0, changes: logs[1].changes.clone(), end: 3000 }),
    )
    // 5's client joins again; 3's never does (its tab closed).
    fight.apply(entry(5, end + 1000, joins(LONGSWORD)))
    let late = end + AGAIN_MS + 1
    assert(fight.check(entry(3, late, Act::Begin)) == Verdict::Reject(NOT_WAITING), "3 let go")
    let begin = entry(5, late, Act::Begin)
    assert(fight.check(begin.clone()) == Verdict::Accept)
    fight.apply(begin)
    assert(fight.party == Vec::from([u32(5)]), "only who's still there fights")
}

@test
fn automatically_waiting_fighters_expire_even_when_the_room_is_new() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3)], 0)
    let end: u64 = 1000
    let changes = Vec::from([Change { frame: 0, input: 15 }])
    fight.apply(entry(3, end, Act::Log { began: 0, round: 0, changes, end: 1 }))
    assert(fight.settled && fight.waiting(3))
    assert(fight.check(entry(3, end + AGAIN_MS - 1, Act::Begin)) == Verdict::Accept)
    assert(
        fight.check(entry(3, end + AGAIN_MS, Act::Begin)) == Verdict::Reject(NOT_WAITING),
        "automatic waiting lasts AGAIN_MS even before room time LOBBY_MS",
    )
    fight.apply(entry(3, end + AGAIN_MS, joins(LONGSWORD)))
    assert(fight.check(entry(3, end + AGAIN_MS + LOBBY_MS - 1, Act::Begin)) == Verdict::Accept)
    assert(
        fight.check(entry(3, end + AGAIN_MS + LOBBY_MS, Act::Begin)) ==
            Verdict::Reject(NOT_WAITING),
        "an explicit join renews waiting for the full LOBBY_MS",
    )
}

@test
fn a_player_who_left_or_stood_still_isnt_brought_back() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3), 5, 6], 0)
    let logs = two_logs()
    fight.apply(
        entry(
            3,
            1000,
            Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 },
        ),
    )
    // 6 sent a log with nothing in it: it never touched its keys.
    fight.apply(entry(6, 1000, Act::Log { began: 0, round: 0, changes: Vec::new(), end: 3000 }))
    // 5 sent none: it left. The fight is settled without it.
    fight.apply(entry(3, 1000 + SETTLE_MS, Act::Settle))
    assert(fight.settled && fight.lobby == Vec::from([u32(3)]), "only 3 played it")
}

@test
fn a_full_lobby_keeps_who_waited_and_brings_back_fighters_while_theres_room() {
    var fight = Fight::empty()
    begun(mut fight, [u32(1), 2], 0)
    var p: u32 = 10
    while p < 10 + MAX_PARTY - 1 {
        fight.apply(entry(p, 500, joins(LONGSWORD)))
        p += 1
    }
    let logs = two_logs()
    fight.apply(
        entry(
            1,
            1000,
            Act::Log { began: 0, round: 0, changes: logs[0].changes.clone(), end: 3000 },
        ),
    )
    fight.apply(
        entry(
            2,
            1000,
            Act::Log { began: 0, round: 0, changes: logs[1].changes.clone(), end: 3000 },
        ),
    )
    assert(fight.lobby.len() == MAX_PARTY && fight.waiting(1) && !fight.waiting(2))
}

@test
fn a_log_no_player_could_send_is_refused() {
    var bad: Vec<Change> = Vec::new()
    bad.push(Change { frame: 5, input: 1 })
    bad.push(Change { frame: 5, input: 2 })
    assert(!sim::well_formed(bad, 100, MAX_CHANGES), "two changes on one frame")
    var stick: Vec<Change> = Vec::new()
    stick.push(Change { frame: 5, input: 49 })
    assert(!sim::well_formed(stick, 100, MAX_CHANGES), "a stick that isn't one")
    var late: Vec<Change> = Vec::new()
    late.push(Change { frame: 100, input: 1 })
    assert(!sim::well_formed(late, 100, MAX_CHANGES), "a change past the end")
    // The fight itself takes any input: a stick that isn't one is still.
    var wild: Vec<Log> = Vec::new()
    wild.push(Log { changes: stick })
    var odd: Vec<Change> = Vec::new()
    odd.push(Change { frame: 5, input: 63 })
    wild.push(Log { changes: odd })
    let _ = sim::run(2, wild)
}

@test
fn the_longest_log_fits_one_message() {
    // A message up to the room is at most 65472 bytes (the host's `MAX_UP`); a log of
    // `MAX_CHANGES` changes at the largest frames and inputs, with a proposal's framing, fits.
    var changes: Vec<Change> = Vec::new()
    for i in 0..MAX_CHANGES {
        changes.push(Change { frame: MAX_FRAMES - MAX_CHANGES + i, input: 16383 - (i & 1) })
    }
    let bytes = pack(
        Act::Log {
            began: 18446744073709551615,
            round: 4294967295,
            changes,
            end: MAX_FRAMES,
        },
    )
    assert(bytes.len() + 256 < 65472, "the longest log is one message")
}

@test
fn a_fight_no_one_finishes_is_settled_after_the_longest_fight() {
    var fight = Fight::empty()
    begun(mut fight, [u32(3)], 1000)
    // Its player leaves without a log: a stranger can't settle it yet, nor begin another.
    assert(fight.check(entry(9, 2000, Act::Settle)) == Verdict::Reject(BAD_LOG))
    fight.apply(entry(9, 2000, joins(LONGSWORD)))
    assert(fight.check(entry(9, 2000, Act::Begin)) == Verdict::Reject(NOT_NOW))
    let late = 1000 + FIGHT_MS + SETTLE_MS
    assert(fight.check(entry(9, late, Act::Settle)) == Verdict::Accept)
    fight.apply(entry(9, late, Act::Settle))
    fight.apply(entry(9, late, joins(LONGSWORD)))
    assert(fight.check(entry(9, late, Act::Begin)) == Verdict::Accept)
}

@test
fn players_wait_in_the_lobby_until_a_fight_begins() {
    var fight = Fight::empty()
    assert(fight.check(entry(3, 0, Act::Begin)) == Verdict::Reject(NOT_WAITING), "only a waiter")
    fight.apply(entry(3, 0, joins(LONGSWORD)))
    fight.apply(entry(3, 1, joins(LONGSWORD)))
    assert(fight.lobby.len() == 1, "joining again keeps one place")
    fight.apply(entry(5, 2, joins(LONGSWORD)))
    fight.apply(entry(7, 3, joins(LONGSWORD)))
    fight.apply(entry(7, 4, Act::Leave))
    assert(fight.check(entry(7, 5, Act::Leave)) == Verdict::Reject(NOT_WAITING))
    assert(fight.lobby.len() == 2)
    fight.apply(entry(3, 7, Act::Begin))
    assert(fight.on() && fight.party.len() == 2 && fight.lobby.len() == 0, "whoever waited")
    // Four waiting fill the lobby; one who joined a minute ago, and said nothing since, doesn't.
    for p in 10..14 {
        fight.apply(entry(p, 8, joins(LONGSWORD)))
    }
    assert(
        fight.check(entry(20, 9, joins(LONGSWORD))) == Verdict::Reject(NOT_WAITING),
        "a full lobby",
    )
    for p in 11..14 {
        fight.apply(entry(p, 30000, joins(LONGSWORD)))
    }
    let later = 8 + LOBBY_MS
    assert(
        fight.check(entry(20, later, joins(LONGSWORD))) == Verdict::Accept,
        "a place the silent left",
    )
    fight.apply(entry(20, later, joins(LONGSWORD)))
    fight.apply(entry(3, later, Act::Settle))
    assert(fight.check(entry(10, later, Act::Begin)) == Verdict::Reject(NOT_WAITING))
}

@test
fn the_logs_of_a_fight_fit_the_state_a_peer_is_sent() {
    var fight = Fight::empty()
    begun(mut fight, [u32(1), 2, 3, 4], 0)
    var changes: Vec<Change> = Vec::new()
    for i in 0..(PLAYER_CHANGES + 1) {
        changes.push(Change { frame: MAX_FRAMES - MAX_CHANGES + i, input: 15936 + (i & 1) * 48 })
    }
    let long = entry(
        1,
        10,
        Act::Log { began: 0, round: 0, changes: changes.clone(), end: MAX_FRAMES },
    )
    assert(fight.check(long) == Verdict::Reject(TOO_LONG), "past a player's share")
    let _ = changes.pop()
    for p in 1..5 {
        let e = entry(
            p,
            10,
            Act::Log { began: 0, round: 0, changes: changes.clone(), end: MAX_FRAMES },
        )
        if p == 4 {
            // The state whole, as a peer far behind is sent it, is one message.
            assert(fight.check(e.clone()) == Verdict::Accept)
            assert(pack(fight.clone()).len() + 256 < 65472, "the state is one message")
        }
        fight.apply(e)
    }
    assert(fight.settled)
}

@test
fn each_player_fights_with_the_weapon_it_brought() {
    var fight = Fight::empty()
    assert(
        fight.check(entry(3, 0, joins(WEAPONS.len()))) == Verdict::Reject(BAD_WEAPON),
        "a weapon that isn't one",
    )
    fight.apply(entry(3, 0, joins(sim::FISTS)))
    fight.apply(entry(5, 1, joins(LONGSWORD)))
    // Joining again changes what it brings.
    fight.apply(entry(3, 2, joins(LONGSWORD)))
    fight.apply(entry(3, 3, joins(sim::FISTS)))
    fight.apply(entry(5, 4, Act::Begin))
    assert(
        fight.party == Vec::from([u32(5), 3]) && fight.armed == Vec::from([LONGSWORD, sim::FISTS]),
    )
    let logs = two_logs()
    fight.apply(
        entry(5, 10, Act::Log { began: 4, round: 0, changes: logs[0].changes.clone(), end: 3000 }),
    )
    fight.apply(
        entry(3, 11, Act::Log { began: 4, round: 0, changes: logs[1].changes.clone(), end: 3000 }),
    )
    let armed: [u32; 2] = [LONGSWORD, sim::FISTS]
    assert(fight.outcome == sim::run_armed(armed, logs.clone()), "the fight its weapons give")
    assert(fight.outcome != sim::run(2, logs), "not the one all longswords give")
}

/// A join's bytes, as peer 3 proposes it, wearing `card` with `seal`.
fn join_bytes(card: Card, seal: Seal) -> Vec<u8> {
    let value = Act::Join { weapon: LONGSWORD, card, seal }
    pack(Up::<Act>::Propose { peer: 3, session: 1, counter: 2, value })
}

/// What the room is given for a join's bytes: its seal.
fn join_seal(bytes: take Vec<u8>) -> Seal {
    let Ok(Up::Propose { value: Act::Join { seal, .. }, .. }) = unpack::<Up<Act>>(take bytes) else {
        panic("still a join")
    }
    seal
}

fn test_key() -> [u8; 32] {
    var secret: Vec<u8> = Vec::new()
    for i in 0..40 {
        secret.push(u8(i))
    }
    let Some(key) = pass::key_of(secret) else { panic("a key") }
    key
}

@test
fn a_join_is_believed_only_with_a_pass_its_account_signed() {
    let key = test_key()
    let name = platform::names::Name { title: 1, front: 2, back: 3, epithet: 4 }
    let look = platform::wire::Look { build: 1, skin: 2, hair: 3, cloth: 4 }
    let now: u64 = 1_800_000_000_000
    let (card, seal) = island::main::worn(pass::sign(key, name, look, now + 1000))
    assert(join_seal(checked_message(join_bytes(card, seal), [key], now)) == sealed(true))
    var other = card
    other.hair = 5
    let forged = join_seal(checked_message(join_bytes(other, seal), [key], now))
    assert(forged == sealed(false), "the pass on another card isn't believed")
    let late = join_seal(checked_message(join_bytes(card, seal), [key], now + 1000))
    assert(late == sealed(false), "nor an expired pass")
    let guest = join_seal(checked_message(join_bytes(NOBODY, seal), [key], now))
    assert(guest == sealed(false), "nor one worn as nobody")
    let log = pack(
        Up::<Act>::Propose {
            peer: 3,
            session: 1,
            counter: 2,
            value: Act::Log { began: 0, round: 0, changes: Vec::new(), end: 0 },
        },
    )
    assert(checked_message(log.clone(), [key], now) == log, "anything else goes as it came")
}

@test
fn the_first_name_and_default_look_can_join_as_a_signed_character() {
    let key = test_key()
    let name = platform::names::Name { title: 0, front: 0, back: 0, epithet: 0 }
    let look = platform::wire::Look { build: 0, skin: 0, hair: 0, cloth: 0 }
    let now: u64 = 1_800_000_000_000
    let (card, seal) = island::main::worn(pass::sign(key, name, look, now + 1000))
    assert(card.valid())
    let checked = join_seal(checked_message(join_bytes(card, seal), [key], now))
    assert(checked == sealed(true), "a valid all-zero card is a character, too")
    var fight = Fight::empty()
    fight.apply(entry(3, 0, Act::Join { weapon: LONGSWORD, card, seal: checked }))
    fight.apply(entry(3, 1, Act::Begin))
    assert(fight.named[0] && fight.seat_of(card) == Some(0))
}

/// A card of name numbers `n`, a valid look.
fn card_of(n: u32) -> Card {
    Card::of(
        platform::names::Name { title: n, front: n, back: n, epithet: n },
        platform::wire::Look { build: 1, skin: 1, hair: 1, cloth: 1 },
    )
}

@test
fn a_won_fights_winners_are_the_signed_players_who_played_it() {
    var fight = Fight::empty()
    // 3 and 5 are signed; 7's card wasn't (its pass didn't check); 9 is a guest.
    fight.apply(entry(3, 0, Act::Join { weapon: LONGSWORD, card: card_of(1), seal: sealed(true) }))
    fight.apply(entry(5, 0, Act::Join { weapon: LONGSWORD, card: card_of(2), seal: sealed(true) }))
    fight.apply(entry(7, 0, Act::Join { weapon: LONGSWORD, card: card_of(3), seal: sealed(false) }))
    fight.apply(entry(9, 0, joins(LONGSWORD)))
    assert(fight.signed == Vec::from([true, true, false, false]) && fight.cards[2] == NOBODY)
    let bad = Act::Join { weapon: LONGSWORD, card: card_of(100000), seal: sealed(true) }
    assert(
        fight.check(entry(11, 0, take bad)) == Verdict::Reject(BAD_CARD),
        "a card past the lists",
    )
    fight.apply(entry(3, 1, Act::Begin))
    assert(fight.named == Vec::from([true, true, false, false]) && fight.faces[0] == card_of(1))
    let logs = two_logs()
    // 5 stood still: its log came, with nothing in it.
    fight.apply(
        entry(3, 100, Act::Log { began: 1, round: 0, changes: logs[0].changes.clone(), end: 3000 }),
    )
    fight.apply(entry(5, 100, Act::Log { began: 1, round: 0, changes: Vec::new(), end: 3000 }))
    fight.apply(
        entry(7, 100, Act::Log { began: 1, round: 0, changes: logs[1].changes.clone(), end: 3000 }),
    )
    fight.apply(
        entry(9, 100, Act::Log { began: 1, round: 0, changes: logs[1].changes.clone(), end: 3000 }),
    )
    assert(fight.settled)
    fight.outcome.winner = Winner::Party
    assert(fight.winners() == Vec::from([card_of(1)]), "only the signed player who played")
    fight.outcome.winner = Winner::Boss
    assert(fight.winners().is_empty(), "a party that fell won nothing")
    // Back at the doors, each is still who it was.
    assert(
        fight.lobby == Vec::from([u32(3), 7, 9]) && fight.cards[0] == card_of(1) && fight.signed[0],
    )
    assert(fight.id("fight-x") == progress::fight_id("fight-x", 1, 1))
}

/// A fight of 3 (card 1) and 5 (card 2), both signed, begun at 1.
fn signed_two() -> Fight {
    var fight = Fight::empty()
    fight.apply(entry(3, 0, Act::Join { weapon: LONGSWORD, card: card_of(1), seal: sealed(true) }))
    fight.apply(entry(5, 0, Act::Join { weapon: LONGSWORD, card: card_of(2), seal: sealed(true) }))
    fight.apply(entry(3, 1, Act::Begin))
    fight
}

@test
fn a_character_can_rejoin_after_changing_its_look_on_another_page() {
    var fight = signed_two()
    var changed = card_of(1)
    changed.hair = 2
    assert(fight.seat_of(changed) == Some(0), "the account's name owns its slot")
    let back = entry(
        11,
        20000,
        Act::Rejoin { began: 1, round: 0, card: changed, seal: sealed(true) },
    )
    assert(fight.check(back.clone()) == Verdict::Accept)
    fight.apply(back)
    assert(
        fight.party[0] == 11 && fight.faces[0] == card_of(1),
        "the fight keeps its original look",
    )
    assert(fight.seat_of(card_of(3)).is_none(), "another account has no slot")
}

/// `log`'s changes before frame `upto`.
fn before(log: Log, upto: u32) -> Vec<Change> {
    var out: Vec<Change> = Vec::new()
    for c in log.changes {
        if c.frame < upto {
            out.push(c.clone())
        }
    }
    out
}

@test
fn a_player_who_came_back_takes_its_slot_and_its_log_carries_on_from_what_was_heard() {
    var fight = signed_two()
    let logs = two_logs()
    // 3's page reloaded: it's peer 11 now, wearing its card again.
    let back = |card: Card, seal: Seal| Act::Rejoin { began: 1, round: 0, card, seal }
    assert(
        fight.check(entry(11, 20000, back(card_of(1), sealed(false)))) ==
            Verdict::Reject(NOT_YOURS),
    )
    assert(
        fight.check(entry(11, 20000, back(card_of(3), sealed(true)))) == Verdict::Reject(NOT_YOURS),
        "a card not in the fight",
    )
    assert(
        fight.check(entry(5, 20000, back(card_of(1), sealed(true)))) == Verdict::Reject(NOT_YOURS),
        "a player in the fight already",
    )
    fight.apply(entry(11, 20000, back(card_of(1), sealed(true))))
    assert(
        fight.party == Vec::from([u32(11), 5]) &&
            fight.cuts[0] == HANDING &&
            fight.cuts[1] == UNCUT,
    )
    let early = entry(11, 20050, Act::Log { began: 1, round: 0, changes: Vec::new(), end: 3000 })
    assert(fight.check(early) == Verdict::Reject(BAD_LOG), "no log before its log so far")
    // 5 heard it through frame 1500.
    let heard = before(logs[0], 1500)
    let own = Act::Handoff { began: 1, round: 0, slot: 0, changes: heard.clone(), upto: 1500 }
    assert(fight.check(entry(11, 25000, own.clone())) == Verdict::Reject(NOT_YOURS), "not its own")
    let late: Vec<Change> = Vec::from([Change { frame: 1600, input: 15 }])
    let past = Act::Handoff { began: 1, round: 0, slot: 0, changes: late, upto: 1500 }
    assert(
        fight.check(entry(5, 25000, take past)) == Verdict::Reject(BAD_LOG),
        "nothing past its frame",
    )
    let hand = Act::Handoff { began: 1, round: 0, slot: 0, changes: heard.clone(), upto: 1500 }
    let early = Act::Handoff { began: 1, round: 0, slot: 0, changes: heard.clone(), upto: 1500 }
    assert(
        fight.check(entry(5, 10000, take early)) == Verdict::Reject(BAD_LOG),
        "past the room's clock",
    )
    assert(fight.check(entry(5, 25000, hand.clone())) == Verdict::Accept)
    fight.apply(entry(5, 25000, hand.clone()))
    assert(
        fight.cuts[0] == 1500 &&
            fight.check(entry(5, 25100, take hand)) == Verdict::Reject(NOT_YOURS),
    )
    // Its own log from then on (what it sends from before the cut isn't taken), then 5's.
    var rest: Vec<Change> = Vec::new()
    rest.push(Change { frame: 1400, input: 3 })
    for c in logs[0].changes {
        if c.frame >= 1500 {
            rest.push(c.clone())
        }
    }
    fight.apply(entry(11, 40000, Act::Log { began: 1, round: 0, changes: rest, end: 3000 }))
    fight.apply(
        entry(
            5,
            40000,
            Act::Log { began: 1, round: 0, changes: logs[1].changes.clone(), end: 3000 },
        ),
    )
    assert(fight.settled && fight.outcome == sim::run(2, logs), "the fight it would have been")
    fight.outcome.winner = Winner::Party
    assert(fight.winners() == Vec::from([card_of(1), card_of(2)]), "a winner still")
}

@test
fn a_player_who_came_back_to_no_one_ends_the_fight() {
    // Alone: no one heard it, and the room ends the fight at once.
    var solo = Fight::empty()
    solo.apply(entry(3, 0, Act::Join { weapon: LONGSWORD, card: card_of(1), seal: sealed(true) }))
    solo.apply(entry(3, 1, Act::Begin))
    solo.apply(
        entry(11, 500, Act::Rejoin { began: 1, round: 0, card: card_of(1), seal: sealed(true) }),
    )
    assert(solo.settled && solo.party == Vec::from([u32(11)]))
    // With a party that left: it may settle once it waited a while for its log.
    var fight = signed_two()
    fight.apply(
        entry(11, 500, Act::Rejoin { began: 1, round: 0, card: card_of(1), seal: sealed(true) }),
    )
    assert(fight.check(entry(11, 600, Act::Settle)) == Verdict::Reject(TOO_SOON))
    assert(fight.check(entry(11, 500 + HANDOFF_MS, Act::Settle)) == Verdict::Accept)
    // A player who sent its log can't come back to it.
    var done = signed_two()
    let logs = two_logs()
    done.apply(
        entry(3, 100, Act::Log { began: 1, round: 0, changes: logs[0].changes.clone(), end: 3000 }),
    )
    let again = entry(
        11,
        200,
        Act::Rejoin { began: 1, round: 0, card: card_of(1), seal: sealed(true) },
    )
    assert(done.check(again) == Verdict::Reject(NOT_YOURS))
}

@test
fn a_rejoin_is_believed_only_with_a_pass_its_account_signed() {
    let key = test_key()
    let name = platform::names::Name { title: 1, front: 2, back: 3, epithet: 4 }
    let look = platform::wire::Look { build: 1, skin: 2, hair: 3, cloth: 4 }
    let now: u64 = 1_800_000_000_000
    let (card, seal) = island::main::worn(pass::sign(key, name, look, now + 1000))
    let seal_of = |card: Card, seal: Seal| -> Seal {
        let value = Act::Rejoin { began: 0, round: 0, card, seal }
        let bytes = pack(Up::<Act>::Propose { peer: 3, session: 1, counter: 2, value })
        let Ok(Up::Propose { value: Act::Rejoin { seal, .. }, .. }) = unpack::<Up<Act>>(
            checked_message(take bytes, [key], now),
        ) else {
            panic("still a rejoin")
        }
        seal
    }
    assert(seal_of(card, seal) == sealed(true))
    var other = card
    other.hair = 5
    assert(seal_of(other, seal) == sealed(false), "the pass on another card isn't believed")
    assert(seal_of(card, sealed(true)) == sealed(false), "nor a seal the peer made")
}

@test
fn a_spliced_log_keeps_each_change_once() {
    let a: Vec<Change> = Vec::from([Change { frame: 0, input: 15 }, Change { frame: 50, input: 3 }])
    let b: Vec<Change> = Vec::from(
        [
            Change { frame: 40, input: 9 },
            Change { frame: 60, input: 3 },
            Change { frame: 70, input: 0 },
        ],
    )
    let s = sim::spliced(a, 55, b, 65)
    assert(s == Vec::from([Change { frame: 0, input: 15 }, Change { frame: 50, input: 3 }]))
    let t = sim::spliced(a, 55, b, 3000)
    assert(
        t.len() == 3 &&
            t[2] == Change { frame: 70, input: 0 } &&
            sim::well_formed(t, end: 3000, most: 10),
    )
}

@test
fn delayed_fight_decisions_cannot_change_the_next_round() {
    var fight = signed_two()
    let logs = two_logs()
    let old_log = Act::Log { began: 1, round: 0, changes: logs[0].changes.clone(), end: 3000 }
    let old_rejoin = Act::Rejoin { began: 1, round: 0, card: card_of(1), seal: sealed(true) }
    let old_handoff = Act::Handoff {
        began: 1,
        round: 0,
        slot: 0,
        changes: before(logs[0], 1000),
        upto: 1000,
    }
    // Both peers queue for the next round, but only 5's log arrives before this one settles.
    for peer in [u32(3), 5] {
        fight.apply(entry(peer, 100, Act::Join {
            weapon: LONGSWORD,
            card: card_of(if peer == 3 { 1 } else { 2 }),
            seal: sealed(true),
        }))
    }
    fight.apply(
        entry(
            5,
            1000,
            Act::Log { began: 1, round: 0, changes: logs[1].changes.clone(), end: 3000 },
        ),
    )
    fight.apply(entry(3, 1000 + SETTLE_MS, Act::Settle))
    assert(fight.settled)
    let next = entry(3, 40000, Act::Begin)
    assert(fight.check(next.clone()) == Verdict::Accept)
    fight.apply(next)
    assert(
        fight.check(entry(3, 40001, take old_log)) == Verdict::Reject(STALE_FIGHT),
        "a final log delayed from the previous fight is not this fight's input",
    )
    assert(
        fight.check(entry(11, 40001, take old_rejoin)) == Verdict::Reject(STALE_FIGHT),
        "a delayed rejoin cannot replace a peer in its next fight",
    )
    let rejoin = entry(
        11,
        41000,
        Act::Rejoin { began: 40000, round: 1, card: card_of(1), seal: sealed(true) },
    )
    assert(fight.check(rejoin.clone()) == Verdict::Accept)
    fight.apply(rejoin)
    assert(
        fight.check(entry(5, 60000, take old_handoff)) == Verdict::Reject(STALE_FIGHT),
        "a delayed handoff cannot replace a later fight's history",
    )
    let handoff = entry(
        5,
        60000,
        Act::Handoff {
            began: 40000,
            round: 1,
            slot: 0,
            changes: before(logs[0], 1000),
            upto: 1000,
        },
    )
    assert(fight.check(handoff.clone()) == Verdict::Accept)
    fight.apply(handoff)
    let log = entry(11, 60001, Act::Log { began: 40000, round: 1, changes: Vec::new(), end: 3000 })
    assert(fight.check(log) == Verdict::Accept, "this round's own decisions still work")
}
