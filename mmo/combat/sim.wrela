// The fight: a party of up to `MAX_PARTY` players against one boss, stepped 60 times a second
// from each player's inputs and nothing else, in whole numbers, so every peer and the room get
// the same fight from the same inputs (`@deterministic`). A player's input is 14 bits: a stick (6
// bits: 0 is still, else 1 + direction * 3 + magnitude, 16 directions and 3 magnitudes) and 8
// buttons, of which the rules read three, each pressed when its bit flips (a toggle: letting go
// changes nothing, so it sends nothing). What a player sends is when its input changes
// (`Change`), and a fight's input logs are all of its changes.
//
// What the rules read of a player's input depends on what it's doing (`World::reads`): mid-swing,
// mid-dodge or staggered, nothing. A bit they don't read changes nothing, then or later, so a
// sender holds it and sends nothing (the bandwidth bench's "read-set masking": about a quarter
// fewer packets, and the same fight).
//
// The rules are the backbone of the combat plan: stamina, committed actions with windups the boss
// telegraphs, a parry that staggers, a dodge with invulnerable frames.

use std::pack::Pack

/// The most players in a fight.
pub const MAX_PARTY: u32 = 4
/// Frames a second.
pub const HZ: u32 = 60
/// The longest fight, in frames (ten minutes): past it, it's a draw.
pub const MAX_FRAMES: u32 = 36000
/// The most changes a player's log holds: about ten a second for the longest fight.
pub const MAX_CHANGES: u32 = 6000

/// Button bits.
pub const ATTACK: u32 = 1
pub const PARRY: u32 = 2
pub const DODGE: u32 = 4

/// Positions are in 1/64 of a metre.
const UNIT: i32 = 64
const ARENA: i32 = 20 * 64
const PLAYER_HP: i32 = 100
const STAMINA: i32 = 100
const BOSS_HP_EACH: i32 = 300

// A player's attack: stamina, its frames (windup, active, recovery), reach and damage.
const ATTACK_COST: i32 = 25
const ATTACK_WINDUP: u32 = 10
const ATTACK_ACTIVE: u32 = 4
const ATTACK_RECOVERY: u32 = 14
const ATTACK_REACH: i32 = 3 * 64
const ATTACK_DAMAGE: i32 = 8
// A parry: its window, then its recovery; a boss hit it meets staggers the boss.
const PARRY_COST: i32 = 10
const PARRY_WINDOW: u32 = 8
const PARRY_RECOVERY: u32 = 12
// A dodge: invulnerable while it lasts, moving fast.
const DODGE_COST: i32 = 20
const DODGE_FRAMES: u32 = 12
const DODGE_SPEED: i32 = 20
// The boss: its speed, its attack's frames (the windup is its tell), reach, damage, and stagger.
const BOSS_SPEED: i32 = 4
const BOSS_WINDUP: u32 = 24
const BOSS_ACTIVE: u32 = 6
const BOSS_RECOVERY: u32 = 30
const BOSS_REACH: i32 = 5 * 32
const BOSS_DAMAGE: i32 = 20
const STAGGER: u32 = 60

/// What a fighter is doing.
const IDLE: u32 = 0
const WINDUP: u32 = 1
const ACTIVE: u32 = 2
const RECOVER: u32 = 3
const PARRYING: u32 = 4
const DODGING: u32 = 5
const STAGGERED: u32 = 6

/// A player's input changed at `frame` to `input`.
pub struct Change: Clone + Pack + Eq {
    pub frame: u32,
    pub input: u32,
}

/// A player's input log: every change, in order.
pub struct Log: Clone + Pack + Eq {
    pub changes: Vec<Change>,
}

/// How a fight ended.
pub enum Winner: Clone + Pack + Eq {
    Party,
    Boss,
    Draw,
}

/// A fight's outcome: what the room keeps, and what a player's own run must match.
pub struct Outcome: Clone + Pack + Eq {
    pub winner: Winner,
    /// The frame it ended on.
    pub frames: u32,
    /// The damage each player dealt, in party order.
    pub dealt: Vec<u32>,
    pub boss_hp: i32,
}

struct Fighter: Clone + Eq {
    x: i32,
    z: i32,
    hp: i32,
    stamina: i32,
    act: u32,
    timer: u32,
    /// Whether this attack has hit already.
    landed: bool,
    dx: i32,
    dz: i32,
    dealt: u32,
}

impl Fighter {
    fn new(x: i32, z: i32, hp: i32) -> Fighter {
        Fighter {
            x,
            z,
            hp,
            stamina: STAMINA,
            act: IDLE,
            timer: 0,
            landed: false,
            dx: 0,
            dz: 0,
            dealt: 0,
        }
    }
}

/// The 16 directions, as steps of 64 (cos and sin, rounded).
const DIR_X: [i32; 16] = [64, 59, 45, 24, 0, -24, -45, -59, -64, -59, -45, -24, 0, 24, 45, 59]
const DIR_Z: [i32; 16] = [0, 24, 45, 59, 64, 59, 45, 24, 0, -24, -45, -59, -64, -59, -45, -24]
/// Speed at each magnitude, in units a frame.
const SPEED: [i32; 3] = [2, 4, 6]

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn abs(v: i32) -> i32 {
    if v < 0 { -v } else { v }
}

/// The distance between two points, as the larger of its two sides plus half the smaller (an
/// octagon: close to round, and whole numbers).
fn reach(ax: i32, az: i32, bx: i32, bz: i32) -> i32 {
    let dx = abs(ax - bx)
    let dz = abs(az - bz)
    if dx > dz { dx + dz / 2 } else { dz + dx / 2 }
}

/// Which bits of a player's input the rules read: its stick, and its buttons.
pub const STICK_BITS: u32 = 63
pub const BUTTON_BITS: u32 = 448

/// The fight at a frame: what each player and the boss are doing, each player's buttons as the
/// rules last took them, and whether it's over. Stepped one frame at a time (`step`), so a client
/// keeps it, rolls it back to a frame and steps it again when a late input arrives.
pub struct World: Clone + Eq {
    pub frame: u32,
    party: Vec<Fighter>,
    boss: Fighter,
    /// Each player's buttons as of the frame before.
    before: Vec<u32>,
    pub over: bool,
    pub winner: Winner,
}

/// A fighter as a client draws it: where it is, and what it's doing.
pub struct Seen: Copy {
    pub x: i32,
    pub z: i32,
    pub hp: i32,
    pub stamina: i32,
    /// 0 idle, 1 winding up, 2 striking, 3 recovering, 4 parrying, 5 dodging, 6 staggered.
    pub act: u32,
}

impl World {
    /// The fight's first frame, for a party of `players` (at most `MAX_PARTY`).
    pub fn start(players: u32) -> World {
        let n = if players > MAX_PARTY { MAX_PARTY } else { players }
        var party: Vec<Fighter> = Vec::new()
        var before: Vec<u32> = Vec::new()
        for i in 0..n {
            party.push(Fighter::new(-4 * UNIT + i32(i) * 2 * UNIT, -6 * UNIT, PLAYER_HP))
            before.push(0)
        }
        World {
            frame: 0,
            party,
            boss: Fighter::new(0, 6 * UNIT, BOSS_HP_EACH * i32(n)),
            before,
            over: false,
            winner: Winner::Draw,
        }
    }

    pub fn players(self) -> u32 {
        self.party.len()
    }

    /// Player `i` as a client draws it.
    pub fn player(self, i: u32) -> Seen {
        seen(self.party[i].clone())
    }

    pub fn boss(self) -> Seen {
        seen(self.boss.clone())
    }

    /// The bits of player `i`'s input that the next `step` reads (its read set): all of them while
    /// it stands idle, none while an action it committed to runs or once it's down. A bit outside
    /// it changes nothing in the fight, now or later, so a sender may hold it at its old value
    /// and send nothing (codec.wrela).
    pub fn reads(self, i: u32) -> u32 {
        if self.over || i >= self.party.len() {
            return 0
        }
        let p = self.party[i].clone()
        if p.hp > 0 && p.act == IDLE { STICK_BITS | BUTTON_BITS } else { 0 }
    }

    /// What the rules will read of player `i`'s input `frames` steps from now, if every input
    /// stays as `inputs` (the look-ahead): a sender sends a bit a little before it's read, so its
    /// peers have it by then, and holds it while it isn't.
    pub fn soon(self, i: u32, inputs: [u32], frames: u32) -> u32 {
        var w = self.clone()
        for _ in 0..frames {
            step(mut w, inputs)
        }
        w.reads(i)
    }

    /// The outcome so far: who dealt what, and the boss's health.
    pub fn outcome(self) -> Outcome {
        var dealt: Vec<u32> = Vec::new()
        for i in 0..self.party.len() {
            dealt.push(self.party[i].dealt)
        }
        Outcome {
            winner: self.winner.clone(),
            frames: self.frame,
            dealt,
            boss_hp: if self.boss.hp < 0 { 0 } else { self.boss.hp },
        }
    }
}

fn seen(f: Fighter) -> Seen {
    Seen { x: f.x, z: f.z, hp: f.hp, stamina: f.stamina, act: f.act }
}

/// One frame of the fight from each player's input (`inputs[i]`; a missing one is still). A
/// button is pressed when its bit flips (a press is a toggle, so letting go sends nothing); the
/// rules read only a player's read set (`World::reads`), and a flip outside it is spent.
@deterministic
pub fn step(w: mut World, inputs: [u32]) {
    if w.over {
        return
    }
    for i in 0..w.party.len() {
        let input = if i < inputs.len() { inputs[i] } else { 0 }
        let read = w.reads(i)
        let pressed = ((input ^ w.before[i]) & read & BUTTON_BITS) >> 6
        // A stick that isn't one (past 48) is still: any input gives a fight, never a trap.
        let raw = input & read & STICK_BITS
        let stick = if raw > 48 { 0 } else { raw }
        w.before[i] = input & BUTTON_BITS
        var p = w.party[i].clone()
        if p.hp <= 0 {
            continue
        }
        step_player(mut p, stick, pressed)
        if p.act == ACTIVE &&
            !p.landed &&
            w.boss.hp > 0 &&
            reach(p.x, p.z, w.boss.x, w.boss.z) <= ATTACK_REACH {
            p.landed = true
            w.boss.hp -= ATTACK_DAMAGE
            p.dealt += u32(ATTACK_DAMAGE)
        }
        w.party[i] = take p
    }
    step_boss(mut w.boss, mut w.party)
    w.frame += 1
    if w.boss.hp <= 0 {
        w.winner = Winner::Party
        w.over = true
        return
    }
    var standing = false
    for i in 0..w.party.len() {
        if w.party[i].hp > 0 {
            standing = true
        }
    }
    if !standing {
        w.winner = Winner::Boss
        w.over = true
    } else if w.frame >= MAX_FRAMES {
        w.over = true
    }
}

/// The fight, from its party's size and each player's input log: every frame stepped from the
/// last change at or before it.
@deterministic
pub fn run(players: u32, logs: [Log]) -> Outcome {
    var w = World::start(players)
    let n = w.players()
    var at: Vec<u32> = Vec::new()
    var inputs: Vec<u32> = Vec::new()
    for _ in 0..n {
        at.push(0)
        inputs.push(0)
    }
    while !w.over {
        for i in 0..n {
            if i < logs.len() {
                while at[i] < logs[i].changes.len() && logs[i].changes[at[i]].frame <= w.frame {
                    inputs[i] = logs[i].changes[at[i]].input
                    at[i] += 1
                }
            }
        }
        step(mut w, inputs)
    }
    w.outcome()
}

@deterministic
fn step_player(p: mut Fighter, stick: u32, pressed: u32) {
    // An action runs its frames out; a new one starts only from idle.
    if p.act != IDLE {
        if p.timer > 0 {
            p.timer -= 1
        }
        if p.timer == 0 {
            if p.act == WINDUP {
                p.act = ACTIVE
                p.timer = ATTACK_ACTIVE
            } else if p.act == ACTIVE {
                p.act = RECOVER
                p.timer = ATTACK_RECOVERY
            } else if p.act == PARRYING {
                p.act = RECOVER
                p.timer = PARRY_RECOVERY
            } else {
                p.act = IDLE
            }
        }
    } else {
        if pressed & ATTACK != 0 && p.stamina >= ATTACK_COST {
            p.stamina -= ATTACK_COST
            p.act = WINDUP
            p.timer = ATTACK_WINDUP
            p.landed = false
        } else if pressed & PARRY != 0 && p.stamina >= PARRY_COST {
            p.stamina -= PARRY_COST
            p.act = PARRYING
            p.timer = PARRY_WINDOW
        } else if pressed & DODGE != 0 && p.stamina >= DODGE_COST && stick != 0 {
            p.stamina -= DODGE_COST
            p.act = DODGING
            p.timer = DODGE_FRAMES
            let dir = (stick - 1) / 3
            p.dx = DIR_X[dir] * DODGE_SPEED / 64
            p.dz = DIR_Z[dir] * DODGE_SPEED / 64
        }
    }
    if p.act == IDLE {
        if p.stamina < STAMINA {
            p.stamina += 1
        }
        if stick != 0 {
            let dir = (stick - 1) / 3
            let speed = SPEED[(stick - 1) % 3]
            p.x += DIR_X[dir] * speed / 64
            p.z += DIR_Z[dir] * speed / 64
        }
    } else if p.act == DODGING {
        p.x += p.dx
        p.z += p.dz
    }
    p.x = clamp(p.x, -ARENA, ARENA)
    p.z = clamp(p.z, -ARENA, ARENA)
}

@deterministic
fn step_boss(boss: mut Fighter, party: mut Vec<Fighter>) {
    if boss.hp <= 0 {
        return
    }
    // The nearest standing player, the first of equals.
    var target: u32 = party.len()
    var best: i32 = 0
    for i in 0..party.len() {
        if party[i].hp > 0 {
            let d = reach(boss.x, boss.z, party[i].x, party[i].z)
            if target == party.len() || d < best {
                target = i
                best = d
            }
        }
    }
    if boss.act != IDLE {
        if boss.timer > 0 {
            boss.timer -= 1
        }
        if boss.act == ACTIVE && !boss.landed {
            // Its swing meets every player in reach once: a parry staggers it, a dodge passes.
            var parried = false
            for i in 0..party.len() {
                var p = party[i].clone()
                if p.hp > 0 && reach(boss.x, boss.z, p.x, p.z) <= BOSS_REACH {
                    if p.act == PARRYING {
                        parried = true
                    } else if p.act != DODGING {
                        p.hp -= BOSS_DAMAGE
                    }
                    party[i] = take p
                }
            }
            boss.landed = true
            if parried {
                boss.act = STAGGERED
                boss.timer = STAGGER
                return
            }
        }
        if boss.timer == 0 {
            if boss.act == WINDUP {
                boss.act = ACTIVE
                boss.timer = BOSS_ACTIVE
                boss.landed = false
            } else if boss.act == ACTIVE {
                boss.act = RECOVER
                boss.timer = BOSS_RECOVERY
            } else {
                boss.act = IDLE
            }
        }
        return
    }
    if target == party.len() {
        return
    }
    if best <= BOSS_REACH {
        boss.act = WINDUP
        boss.timer = BOSS_WINDUP
        return
    }
    let tx = party[target].x
    let tz = party[target].z
    boss.x += clamp(tx - boss.x, -BOSS_SPEED, BOSS_SPEED)
    boss.z += clamp(tz - boss.z, -BOSS_SPEED, BOSS_SPEED)
}

/// Whether `log` is a log a player could send: changes in order of their frames, each a change,
/// each an input of 14 bits with a stick that's one, before frame `end`, and at most `most` of them.
pub fn well_formed(log: [Change], end: u32, most: u32) -> bool {
    if log.len() > most {
        return false
    }
    var last: u32 = 0
    var prev: u32 = 0
    for i in 0..log.len() {
        let c = log[i].clone()
        if c.frame >= end ||
            (i > 0 && c.frame <= last) ||
            c.input >= 16384 ||
            (c.input & 63) > 48 ||
            c.input == prev {
            return false
        }
        last = c.frame
        prev = c.input
    }
    true
}

// ---- tests --------------------------------------------------------------------------------------

fn next(seed: mut u32) -> u32 {
    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
    seed >> 8
}

@test
fn a_bit_the_rules_dont_read_changes_nothing_then_or_later() {
    // Random fights of four; at each frame, every bit outside each player's read set flipped at
    // random gives the same world, at once and after 60 more frames of the same inputs.
    var seed: u32 = 12345
    var w = World::start(4)
    var inputs: Vec<u32> = Vec::new()
    for _ in 0..4 {
        inputs.push(0)
    }
    var checked: u32 = 0
    while w.frame < 3000 && !w.over {
        for i in 0..4 {
            if next(mut seed) % 5 == 0 {
                inputs[i] = (next(mut seed) & BUTTON_BITS) | (next(mut seed) % 49)
            }
        }
        var other = inputs.clone()
        for i in 0..4 {
            other[i] = other[i] ^ (next(mut seed) & (STICK_BITS | BUTTON_BITS) & !w.reads(i))
        }
        var a = w.clone()
        var b = w.clone()
        step(mut a, inputs)
        step(mut b, other)
        // What differs is only the buttons as last taken, which an unread flip spends.
        a.before = Vec::new()
        b.before = Vec::new()
        assert(a == b, "an unread bit changes nothing now")
        if w.frame % 50 == 0 {
            var c = w.clone()
            var d = w.clone()
            step(mut c, inputs)
            step(mut d, other)
            // Both then go on with what the sender actually holds: the same inputs, but each
            // with the buttons it has (a flip spent stays spent).
            var later = inputs.clone()
            for k in 0..60 {
                if k == 30 {
                    for i in 0..4 {
                        later[i] = later[i] ^ ATTACK << 6
                    }
                }
                var mine = later.clone()
                for i in 0..4 {
                    mine[i] = (mine[i] & !BUTTON_BITS) |
                        (d.before[i] ^ (later[i] ^ c.before[i]) & BUTTON_BITS)
                }
                step(mut c, later)
                step(mut d, mine)
            }
            c.before = Vec::new()
            d.before = Vec::new()
            assert(c == d, "an unread bit changes nothing later")
        }
        step(mut w, inputs)
        checked += 1
    }
    assert(checked > 1000, "the fight lasts")
}
