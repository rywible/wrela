/// Every boss, by number.
pub const BOSSES: [Boss; 1] = [
    Boss {
        hp_each: 300,
        speed: 4,
        // Sweep, sweep, palm, stomp, slam: a stomp only for anyone underfoot.
        calm: [0, 0, 1, 3, 2, 0, 1, 3],
        // Two sweeps and a palm, a stomp, then the slam.
        enraged: [4, 4, 6, 3, 5, 4, 6, 3],
        rage: 50,
    },
]
/// The cathedral's idol, the first boss.
pub const THE_IDOL: u32 = 0

/// What a fighter is doing.
pub const IDLE: u32 = 0
pub const WINDUP: u32 = 1
pub const ACTIVE: u32 = 2
pub const RECOVER: u32 = 3
pub const PARRYING: u32 = 4
pub const DODGING: u32 = 5
pub const STAGGERED: u32 = 6

/// A player's input changed at `frame` to `input`.
pub struct Change: Clone + Pack + Eq {
    pub frame: u32,
    pub input: u32,
}

/// A player's input log: every change, in order.
pub struct Log: Clone + Pack + Eq {
    pub changes: Vec<Change>,
}

/// How a fight ended.
pub enum Winner: Clone + Pack + Eq {
    Party,
    Boss,
    Draw,
}

/// A fight's outcome: what the room keeps, and what a player's own run must match.
pub struct Outcome: Clone + Pack + Eq {
    pub winner: Winner,
    /// The frame it ended on.
    pub frames: u32,
    /// The damage each player dealt, in party order.
    pub dealt: Vec<u32>,
    pub boss_hp: i32,
}

struct Fighter: Clone + Eq {
    x: i32,
    z: i32,
    hp: i32,
    stamina: i32,
    act: u32,
    timer: u32,
    /// Its weapon (`WEAPONS`), and the move it's making (`MOVES`; `NO_MOVE`: none).
    weapon: u32,
    move_: u32,
    /// Whether this attack has hit already.
    landed: bool,
    dx: i32,
    dz: i32,
    dealt: u32,
    /// The way it faces: one of the 16 directions (`DIR_X`, `DIR_Z`).
    facing: u32,
    /// The frames it's held still at a contact (`hold_of`), and a press it couldn't act on yet
    /// (buttons, as `ATTACK`), kept `kept` frames more (`BUFFER`).
    hold: u32,
    buffered: u32,
    kept: u32,
    /// What's left of a push a blow gave it (units), carried out once its hold breaks (`shoved`),
    /// and how far pushes have carried it in all (units), for a client to tell a push from a walk.
    shove_x: i32,
    shove_z: i32,
    carried_x: i32,
    carried_z: i32,
    /// Whether it's locked on to the foe (`LOCK_ON`): its facing the foe's way while it's free,
    /// its stick moving it without turning it.
    locked: bool,
}

impl Fighter {
    fn new(x: i32, z: i32, hp: i32, weapon: u32, facing: u32) -> Fighter {
        Fighter {
            x,
            z,
            hp,
            stamina: STAMINA,
            act: IDLE,
            timer: 0,
            weapon,
            move_: NO_MOVE,
            landed: false,
            dx: 0,
            dz: 0,
            dealt: 0,
            facing,
            hold: 0,
            buffered: 0,
            kept: 0,
            shove_x: 0,
            shove_z: 0,
            carried_x: 0,
            carried_z: 0,
            locked: false,
        }
    }
}

/// The 16 directions, as steps of 64 (cos and sin, rounded).
const DIR_X: [i32; 16] = [64, 59, 45, 24, 0, -24, -45, -59, -64, -59, -45, -24, 0, 24, 45, 59]
const DIR_Z: [i32; 16] = [0, 24, 45, 59, 64, 59, 45, 24, 0, -24, -45, -59, -64, -59, -45, -24]
/// Speed at each magnitude, in units a frame.
const SPEED: [i32; 3] = [2, 4, 6]

/// Lock-on (a trial, as knockback is): a player may lock on to the foe (`LOCK_ON`) and let go.
/// Locked, while it's free it faces the foe every frame, the nearest of the 16 ways to it, and its
/// stick moves it without turning it, at `LOCKED_SPEED`. `LOCKING` false turns it off: a press of
/// the button does nothing.
pub const LOCKING: bool = true
/// A locked-on fighter's speed at each of the stick's magnitudes (units a frame: 0.94 m/s, and
/// 1.9): the pace a body facing one way and going another goes at (100STYLE's Neutral sidestep
/// walk 0.6 m/s and run 1.6, its back walk 0.76 and run 1.5), as near as a whole unit a frame
/// comes.
pub const LOCKED_SPEED: [i32; 3] = [1, 1, 2]

/// The turn window (a trial, as knockback is): through the first `TURN_WINDOW` frames of a strike's
/// windup a player's facing may still turn, toward its stick or, locked on, toward the foe, one of
/// the 16 ways every `TURN_EVERY` frames at most; after the window it's committed. `TURNING` false
/// turns it off: the facing a strike begins with is the one it lands with.
///
/// The window is 6 frames (0.1 s): the shortest windup is 10 (the jab, the second cut), and the
/// window ends 4 frames before that strike, so what's turned to is seen turning before it lands.
/// (The idol stops turning `LOCK` frames before its blow, for the same reason.) A press made with
/// the stick still coming round, or at a foe who steps aside as it's pressed, is put right in it.
/// The rate, a way every 2 frames (675 degrees a second), turns 3 ways (67.5 degrees) at most
/// over the window: enough for a press aimed a way or two off, not enough to turn round and strike
/// behind, which would make every strike all-round.
pub const TURNING: bool = true
pub const TURN_WINDOW: u32 = 6
pub const TURN_EVERY: u32 = 2

/// How many frames into its windup `p` is.
fn into_windup(p: Fighter) -> u32 {
    if p.act != WINDUP || p.move_ == NO_MOVE { 0 } else { MOVES[p.move_].windup - p.timer }
}

/// Whether `p`'s facing may still turn: in its turn window.
fn turning(p: Fighter) -> bool {
    TURNING && p.act == WINDUP && p.move_ != NO_MOVE && into_windup(p) < TURN_WINDOW
}

/// `from` (one of the 16 ways) a way nearer `to` round the shorter side (none at `to`).
fn toward(from: u32, to: u32) -> u32 {
    let d = (to + 16 - from) % 16
    if d == 0 { from } else if d <= 8 { (from + 1) % 16 } else { (from + 15) % 16 }
}

/// The directions the party and the boss face as a fight begins: toward each other (+z, -z).
const AHEAD: u32 = 4
const BACK: u32 = 12

/// How many frames before its windup ends the boss stops turning to its target.
pub const LOCK: u32 = 10

/// The one of the 16 directions nearest (`dx`, `dz`) (the first of equals; ahead, `AHEAD`, for
/// none).
pub fn direction(dx: i32, dz: i32) -> u32 {
    if dx == 0 && dz == 0 {
        return AHEAD
    }
    var best: u32 = 0
    var most: i32 = -2147483647
    for d in 0..16 {
        let dot = DIR_X[d] * dx + DIR_Z[d] * dz
        if dot > most {
            most = dot
            best = d
        }
    }
    best
}

/// Whether (`dx`, `dz`) from a fighter facing `facing` is within `arc` of it: `arc` is the
/// cosine of half the arc's width, in 1024ths (1024 only straight ahead, 0 the half ahead, -1024
/// all round). In whole numbers: the angle's cosine against the arc's, both sides squared.
pub fn within(facing: u32, dx: i32, dz: i32, arc: i32) -> bool {
    if dx == 0 && dz == 0 {
        return true
    }
    let dot = i64(DIR_X[facing % 16]) * i64(dx) + i64(DIR_Z[facing % 16]) * i64(dz)
    let far = i64(dx) * i64(dx) + i64(dz) * i64(dz)
    let c = i64(arc)
    // cos = dot / (64 |d|) against arc / 1024: dot 16 against arc |d|, squared.
    let lhs = dot * dot * 256
    let rhs = c * c * far
    if c >= 0 { dot >= 0 && lhs >= rhs } else { dot >= 0 || lhs <= rhs }
}

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn abs(v: i32) -> i32 {
    if v < 0 { -v } else { v }
}

/// `f` pushed `units` along the way from (`x`, `z`) to it (one of the 16 directions): added to
/// what's left of any push it has.
fn pushed(f: mut Fighter, x: i32, z: i32, units: i32) {
    if units <= 0 {
        return
    }
    let d = direction(f.x - x, f.z - z)
    f.shove_x += DIR_X[d] * units / 64
    f.shove_z += DIR_Z[d] * units / 64
}

/// A third of `v`, at least one unit its way (none of none).
fn eased(v: i32) -> i32 {
    let t = v / PUSH_EASE
    if t != 0 { t } else if v > 0 { 1 } else if v < 0 { -1 } else { 0 }
}

/// `f` carried a frame on by what's left of its push, kept in the arena as a step is.
fn shoved(f: mut Fighter) {
    if f.shove_x == 0 && f.shove_z == 0 {
        return
    }
    let (sx, sz) = (eased(f.shove_x), eased(f.shove_z))
    let (x0, z0) = (f.x, f.z)
    f.x = clamp(f.x + sx, -ARENA, ARENA)
    f.z = clamp(f.z + sz, -ARENA, ARENA)
    f.carried_x += f.x - x0
    f.carried_z += f.z - z0
    f.shove_x -= sx
    f.shove_z -= sz
}

/// The distance between two points, as the larger of its two sides plus half the smaller (an
/// octagon: close to round, and whole numbers).
fn reach(ax: i32, az: i32, bx: i32, bz: i32) -> i32 {
    let dx = abs(ax - bx)
    let dz = abs(az - bz)
    if dx > dz { dx + dz / 2 } else { dz + dx / 2 }
}

/// Which bits of a player's input the rules read: its stick, and its buttons.
pub const STICK_BITS: u32 = 63
pub const BUTTON_BITS: u32 = 1984
/// The light attack's bit: what the rules read in a recovery a combo goes on from.
const CHAIN_BITS: u32 = ATTACK << 6

/// The fight at a frame: what each player and the boss are doing, each player's buttons as the
/// rules last took them, and whether it's over. Stepped one frame at a time (`step`), so a client
/// keeps it, rolls it back to a frame and steps it again when a late input arrives.
pub struct World: Clone + Eq {
    pub frame: u32,
    party: Vec<Fighter>,
    boss: Fighter,
    /// Which boss it is (`BOSSES`), its full health, and how far through its pattern it is.
    foe: u32,
    full: i32,
    made: u32,
    /// Each player's buttons as of the frame before.
    before: Vec<u32>,
    /// How long a press a player can't act on yet is kept (`BUFFER`, unless a bench asks another:
    /// `World::buffered`).
    buffer: u32,
    /// Whether the boss stands still, its own moves never made (`World::standing_still`): for a
    /// bench to strike at.
    still: bool,
    pub over: bool,
    pub winner: Winner,
}

/// A fighter as a client draws it: where it is, and what it's doing.
pub struct Seen: Copy {
    pub x: i32,
    pub z: i32,
    pub hp: i32,
    pub stamina: i32,
    /// 0 idle, 1 winding up, 2 striking, 3 recovering, 4 parrying, 5 dodging, 6 staggered.
    pub act: u32,
    /// The frames left of what it's doing, so a client draws how far into it it is.
    pub timer: u32,
    /// The move it's making (a player's in `MOVES`, the boss's in `ATTACKS`; `NO_MOVE`: none), so
    /// a client draws which it is.
    pub move_: u32,
    /// The way it faces: one of the 16 directions (`direction`).
    pub facing: u32,
    /// The frames it's held still at a contact (`hold_of`).
    pub hold: u32 = 0,
    /// How far pushes have carried it in all (units): what of its moves is a blow's push, not a
    /// walk.
    pub carried_x: i32 = 0,
    pub carried_z: i32 = 0,
    /// Whether it's locked on to the foe (`LOCK_ON`).
    pub locked: bool = false,
    /// Its weapon (`WEAPONS`: `FISTS`, `LONGSWORD`), so a client draws what it holds.
    pub weapon: u32 = 0,
}

impl World {
    /// The fight's first frame, for a party of `players` (at most `MAX_PARTY`), each with the
    /// longsword.
    pub fn start(players: u32) -> World {
        var weapons: Vec<u32> = Vec::new()
        for _ in 0..min(players, MAX_PARTY) {
            weapons.push(LONGSWORD)
        }
        World::armed(weapons)
    }

    /// The fight's first frame, for a party whose players bring `weapons` (one each, in party
    /// order; at most `MAX_PARTY`; one that isn't a weapon is fists).
    pub fn armed(weapons: [u32]) -> World {
        let n = if weapons.len() > MAX_PARTY { MAX_PARTY } else { weapons.len() }
        var party: Vec<Fighter> = Vec::new()
        var before: Vec<u32> = Vec::new()
        for i in 0..n {
            let w = if weapons[i] < WEAPONS.len() { weapons[i] } else { FISTS }
            party.push(Fighter::new(-4 * UNIT + i32(i) * 2 * UNIT, -6 * UNIT, PLAYER_HP, w, AHEAD))
            before.push(0)
        }
        World {
            frame: 0,
            party,
            boss: Fighter::new(0, 6 * UNIT, BOSSES[THE_IDOL].hp_each * i32(n), FISTS, BACK),
            foe: THE_IDOL,
            full: BOSSES[THE_IDOL].hp_each * i32(n),
            made: 0,
            before,
            buffer: BUFFER,
            still: false,
            over: false,
            winner: Winner::Draw,
        }
    }

    /// `self` with presses kept `frames` long instead of `BUFFER`: for a bench to try lengths.
    pub fn buffered(self, frames: u32) -> World {
        World { buffer: frames, ..self.clone() }
    }

    /// `self` with its boss standing still (it's held and pushed, but makes no move nor step of
    /// its own): for a bench to strike at.
    pub fn standing_still(self) -> World {
        World { still: true, ..self.clone() }
    }

    /// `self` with its boss making its own moves again (`standing_still` undone): for a script to
    /// let it strike once.
    pub fn let_go(self) -> World {
        World { still: false, ..self.clone() }
    }

    pub fn players(self) -> u32 {
        self.party.len()
    }

    /// Player `i` as a client draws it.
    pub fn player(self, i: u32) -> Seen {
        seen(self.party[i].clone())
    }

    pub fn boss(self) -> Seen {
        seen(self.boss.clone())
    }

    /// The attack the boss is making, from its windup (its tell) to the end of its recovery.
    pub fn boss_attack(self) -> Option<Attack> {
        if self.boss.move_ < ATTACKS.len() &&
            (self.boss.act == WINDUP || self.boss.act == ACTIVE || self.boss.act == RECOVER) {
            Some(ATTACKS[self.boss.move_])
        } else {
            None
        }
    }

    /// The bits of player `i`'s input that the next `step` reads (its read set): all of them while
    /// it stands idle, none while an action it committed to runs or once it's down. A bit outside
    /// it changes nothing in the fight, now or later, so a sender may hold it at its old value
    /// and send nothing (codec.wrela).
    pub fn reads(self, i: u32) -> u32 {
        if self.over || i >= self.party.len() {
            return 0
        }
        let p = self.party[i].clone()
        if p.hp <= 0 {
            return 0
        }
        if p.act == IDLE && p.hold == 0 {
            return STICK_BITS | BUTTON_BITS
        }
        // A button it can act on within the buffer's frames, kept till then; locking on, whatever
        // it's doing; and its stick through a strike's turn window.
        var read: u32 = LOCK_ON << 6
        if turning(p) && p.hold == 0 {
            read |= STICK_BITS
        }
        for b in [ATTACK, PARRY, DODGE, HEAVY] {
            if until(p, b) <= self.buffer {
                read |= b << 6
            }
        }
        read
    }

    /// What the rules will read of player `i`'s input `frames` steps from now, if every input
    /// stays as `inputs` (the look-ahead): a sender sends a bit a little before it's read, so its
    /// peers have it by then, and holds it while it isn't.
    pub fn soon(self, i: u32, inputs: [u32], frames: u32) -> u32 {
        var w = self.clone()
        for _ in 0..frames {
            step(mut w, inputs)
        }
        w.reads(i)
    }

    /// The outcome so far: who dealt what, and the boss's health.
    pub fn outcome(self) -> Outcome {
        var dealt: Vec<u32> = Vec::new()
        for i in 0..self.party.len() {
            dealt.push(self.party[i].dealt)
        }
        Outcome {
            winner: self.winner.clone(),
            frames: self.frame,
            dealt,
            boss_hp: if self.boss.hp < 0 { 0 } else { self.boss.hp },
        }
    }
}

fn seen(f: Fighter) -> Seen {
    Seen {
        x: f.x,
        z: f.z,
        hp: f.hp,
        stamina: f.stamina,
        act: f.act,
        timer: f.timer,
        move_: f.move_,
        facing: f.facing,
        hold: f.hold,
        carried_x: f.carried_x,
        carried_z: f.carried_z,
        locked: f.locked,
        weapon: f.weapon,
    }
}

/// How many frames until `p` can act on button `b` (`ATTACK` and the rest): a light press in an
/// attack that a combo goes on from, at its recovery; anything else once it's free.
fn until(p: Fighter, b: u32) -> u32 {
    let striking = p.move_ != NO_MOVE && (p.act == WINDUP || p.act == ACTIVE || p.act == RECOVER)
    let combo = b == ATTACK && striking && MOVES[p.move_].next != NO_MOVE
    let left = if p.act == IDLE { 0 } else if p.act == WINDUP {
        p.timer + MOVES[p.move_].active + if combo { 0 } else { MOVES[p.move_].recovery }
    } else if p.act == ACTIVE {
        p.timer + if combo { 0 } else { MOVES[p.move_].recovery }
    } else if p.act == RECOVER { if combo { 0 } else { p.timer } } else if p.act == PARRYING {
        p.timer + PARRY_RECOVERY
    } else { p.timer }
    left + p.hold
}

/// Whether `p` is in an attack's recovery that a combo goes on from.
fn chains(p: Fighter) -> bool {
    p.act == RECOVER && p.move_ != NO_MOVE && MOVES[p.move_].next != NO_MOVE
}

/// One frame of the fight from each player's input (`inputs[i]`; a missing one is still). A
/// button is pressed when its bit flips (a press is a toggle, so letting go sends nothing); the
/// rules read only a player's read set (`World::reads`), and a flip outside it is spent.
@deterministic
pub fn step(w: mut World, inputs: [u32]) {
    if w.over {
        return
    }
    // The hold the party's blows put on the boss, from after its own step (as theirs is), so a
    // hold of `n` is `n` frames still.
    var boss_hold: u32 = 0
    for i in 0..w.party.len() {
        // Buttons are toggles: zeroing an omitted input would press every button whose last
        // toggle was one. Missing input only releases the stick, leaving button toggles alone.
        let input = if i < inputs.len() { inputs[i] } else { w.before[i] }
        let read = w.reads(i)
        let pressed = ((input ^ w.before[i]) & read & BUTTON_BITS) >> 6
        // A stick that isn't one (past 48) is still: any input gives a fight, never a trap.
        let raw = input & read & STICK_BITS
        let stick = if raw > 48 { 0 } else { raw }
        w.before[i] = input & BUTTON_BITS
        var p = w.party[i].clone()
        if p.hp <= 0 {
            continue
        }
        if LOCKING && pressed & LOCK_ON != 0 {
            p.locked = !p.locked
        }
        let foe = (w.boss.x, w.boss.z)
        step_player(mut p, stick, pressed & !LOCK_ON, w.buffer, foe)
        if p.act == ACTIVE && !p.landed && w.boss.hp > 0 {
            let m = MOVES[p.move_]
            let (dx, dz) = (w.boss.x - p.x, w.boss.z - p.z)
            if reach(p.x, p.z, w.boss.x, w.boss.z) <= m.reach && within(p.facing, dx, dz, m.arc) {
                p.landed = true
                w.boss.hp -= m.damage
                p.dealt += u32(m.damage)
                // Both held at the contact; the boss not while it winds up or strikes, so a
                // party can't hold its blows off.
                p.hold = hold_of(m.damage)
                if w.boss.act != WINDUP && w.boss.act != ACTIVE {
                    boss_hold = max(boss_hold, hold_of(m.damage))
                }
                // Pushed away from its striker, a quarter as far as a man is.
                let (px, pz) = (p.x, p.z)
                pushed(mut w.boss, px, pz, push_of(hold_of(m.damage)) * IDOL_TAKES / 4)
            }
        }
        w.party[i] = take p
    }
    step_boss(BOSSES[w.foe], w.full, mut w.made, mut w.boss, mut w.party, w.still)
    w.boss.hold = max(w.boss.hold, boss_hold)
    w.frame += 1
    if w.boss.hp <= 0 {
        w.winner = Winner::Party
        w.over = true
        return
    }
    var standing = false
    for i in 0..w.party.len() {
        if w.party[i].hp > 0 {
            standing = true
        }
    }
    if !standing {
        w.winner = Winner::Boss
        w.over = true
    } else if w.frame >= MAX_FRAMES {
        w.over = true
    }
}

/// The fight, from its party's size and each player's input log, everyone with the longsword.
@deterministic
pub fn run(players: u32, logs: [Log]) -> Outcome {
    var weapons: Vec<u32> = Vec::new()
    for _ in 0..min(players, MAX_PARTY) {
        weapons.push(LONGSWORD)
    }
    run_armed(weapons, logs)
}

/// The fight, from the weapons its players bring and each player's input log: every frame
/// stepped from the last change at or before it.
@deterministic
pub fn run_armed(weapons: [u32], logs: [Log]) -> Outcome {
    var w = World::armed(weapons)
    let n = w.players()
    var at: Vec<u32> = Vec::new()
    var inputs: Vec<u32> = Vec::new()
    for _ in 0..n {
        at.push(0)
        inputs.push(0)
    }
    while !w.over {
        for i in 0..n {
            if i < logs.len() {
                while at[i] < logs[i].changes.len() && logs[i].changes[at[i]].frame <= w.frame {
                    inputs[i] = logs[i].changes[at[i]].input
                    at[i] += 1
                }
            }
        }
        step(mut w, inputs)
    }
    w.outcome()
}

/// Starts move `m` if `p` has the stamina for it: whether it did.
fn begin(p: mut Fighter, m: u32) -> bool {
    let mv = MOVES[m]
    if p.stamina < mv.cost {
        return false
    }
    p.stamina -= mv.cost
    p.act = WINDUP
    p.timer = mv.windup
    p.move_ = m
    p.landed = false
    true
}

@deterministic
fn step_player(p: mut Fighter, stick: u32, fresh: u32, buffer: u32, foe: (i32, i32)) {
    // A press it can't act on yet is kept (`buffer` frames), the latest over any before it: one
    // slot, which a combo's next cut is taken from as any other press is.
    if fresh != 0 {
        p.buffered = fresh
        p.kept = buffer
    } else if p.kept > 0 {
        p.kept -= 1
        if p.kept == 0 {
            p.buffered = 0
        }
    }
    // Held at a contact, it's still, and keeps its press.
    if p.hold > 0 {
        p.hold -= 1
        return
    }
    // Pushed by a blow, it's carried on whatever it does: a push takes no control away.
    shoved(mut p)
    let pressed = p.buffered
    // An action runs its frames out; a new one starts from idle, or a combo's next cut from the
    // recovery of the one before.
    if p.act != IDLE {
        // In its turn window it may still turn, toward its stick, or the foe locked on.
        if turning(p) && into_windup(p) % TURN_EVERY == 0 {
            let goal = if p.locked { direction(foe.0 - p.x, foe.1 - p.z) } else if stick != 0 {
                (stick - 1) / 3
            } else { p.facing }
            p.facing = toward(p.facing, goal)
        }
        if chains(p) && pressed & ATTACK != 0 {
            let next = MOVES[p.move_].next
            if begin(mut p, next) {
                p.buffered = 0
                p.kept = 0
                return
            }
        }
        // Striking, it's carried on by its move.
        if p.move_ != NO_MOVE && (p.act == WINDUP || p.act == ACTIVE || p.act == RECOVER) {
            let k = into_move(p)
            travels(mut p, k, foe)
        }
        if p.timer > 0 {
            p.timer -= 1
        }
        if p.timer == 0 {
            if p.act == WINDUP {
                p.act = ACTIVE
                p.timer = MOVES[p.move_].active
            } else if p.act == ACTIVE {
                p.act = RECOVER
                p.timer = MOVES[p.move_].recovery
            } else if p.act == PARRYING {
                p.act = RECOVER
                p.timer = PARRY_RECOVERY
                p.move_ = NO_MOVE
            } else {
                p.act = IDLE
                p.move_ = NO_MOVE
            }
        }
    } else {
        // Free, it faces where its stick points, and strikes or parries that way; a dodge goes
        // where the stick says without turning. Locked on, it faces the foe.
        if p.locked {
            p.facing = direction(foe.0 - p.x, foe.1 - p.z)
        } else if stick != 0 && pressed & DODGE == 0 {
            p.facing = (stick - 1) / 3
        }
        let weapon = WEAPONS[p.weapon]
        if pressed & ATTACK != 0 && begin(mut p, weapon.light) {} else if pressed & HEAVY != 0 &&
            begin(mut p, weapon.heavy) {} else if pressed & PARRY != 0 && p.stamina >= PARRY_COST {
            p.stamina -= PARRY_COST
            p.act = PARRYING
            p.timer = PARRY_WINDOW
        } else if pressed & DODGE != 0 && p.stamina >= DODGE_COST && stick != 0 {
            p.stamina -= DODGE_COST
            p.act = DODGING
            p.timer = DODGE_FRAMES
            let dir = (stick - 1) / 3
            p.dx = DIR_X[dir] * DODGE_SPEED / 64
            p.dz = DIR_Z[dir] * DODGE_SPEED / 64
        }
        // Free, it acts on a press at once or not at all.
        p.buffered = 0
        p.kept = 0
    }
    if p.act == IDLE {
        if p.stamina < STAMINA {
            p.stamina += 1
        }
        if stick != 0 {
            let dir = (stick - 1) / 3
            let speed = if p.locked { LOCKED_SPEED[(stick - 1) % 3] } else {
                SPEED[(stick - 1) % 3]
            }
            p.x += DIR_X[dir] * speed / 64
            p.z += DIR_Z[dir] * speed / 64
        }
    } else if p.act == DODGING {
        p.x += p.dx
        p.z += p.dz
    }
    p.x = clamp(p.x, -ARENA, ARENA)
    p.z = clamp(p.z, -ARENA, ARENA)
    // (Locked on and free, it faces the foe from where it's got to.)
    if p.locked && p.act == IDLE {
        p.facing = direction(foe.0 - p.x, foe.1 - p.z)
    }
}

/// The attack boss `b` makes next, its health `hp` of `full`, `made` places through its pattern,
/// its nearest player `d` away, and how many places on in the pattern that is: the next in its
/// pattern, past any that can't be made from there and that it doesn't walk in for. None while it
/// walks in for the next.
@deterministic
fn next_attack(b: Boss, hp: i32, full: i32, made: u32, d: i32) -> Option<(u32, u32)> {
    let pattern = if hp * 100 < full * b.rage { b.enraged } else { b.calm }
    for k in 0..PATTERN {
        let a = pattern[(made + k) % PATTERN]
        if a >= ATTACKS.len() {
            continue
        }
        let at = ATTACKS[a]
        if at.near <= d && d <= at.far {
            return Some((a, k + 1))
        }
        if at.walks_in && d > at.far {
            return None
        }
    }
    None
}

@deterministic
fn step_boss(
    b: Boss,
    full: i32,
    made: mut u32,
    boss: mut Fighter,
    party: mut Vec<Fighter>,
    still: bool,
) {
    if boss.hp <= 0 {
        return
    }
    // The nearest standing player, the first of equals.
    var target: u32 = party.len()
    var best: i32 = 0
    for i in 0..party.len() {
        if party[i].hp > 0 {
            let d = reach(boss.x, boss.z, party[i].x, party[i].z)
            if target == party.len() || d < best {
                target = i
                best = d
            }
        }
    }
    // Held at a contact, it's still.
    if boss.hold > 0 {
        boss.hold -= 1
        return
    }
    shoved(mut boss)
    if still {
        return
    }
    if boss.act != IDLE {
        if boss.timer > 0 {
            boss.timer -= 1
        }
        // It turns to its target through its windup, till `LOCK` frames before its end.
        if boss.act == WINDUP && boss.timer > LOCK && target < party.len() {
            boss.facing = direction(party[target].x - boss.x, party[target].z - boss.z)
        }
        let attack = if boss.move_ < ATTACKS.len() { ATTACKS[boss.move_] } else { ATTACKS[0] }
        if boss.act == ACTIVE && !boss.landed {
            // It meets every player where it reaches and within its arc, once: a parry staggers
            // it, if a parry meets it at all and the one parrying faces it; a dodge passes it.
            var parried = false
            var struck = false
            for i in 0..party.len() {
                var p = party[i].clone()
                let d = reach(boss.x, boss.z, p.x, p.z)
                let (dx, dz) = (p.x - boss.x, p.z - boss.z)
                let met = attack.near <= d &&
                    d <= attack.far &&
                    within(boss.facing, dx, dz, attack.arc)
                if p.hp > 0 && met {
                    let facing_it = within(p.facing, -dx, -dz, PARRY_ARC)
                    if p.act == PARRYING && attack.parried && facing_it {
                        parried = true
                        p.hold = hold_of(attack.damage)
                    } else if p.act != DODGING {
                        p.hp -= attack.damage
                        p.hold = hold_of(attack.damage)
                        // Pushed away from the idol, as far as the blow's heavy.
                        pushed(mut p, boss.x, boss.z, push_of(hold_of(attack.damage)))
                        // Struck, what it pressed is lost.
                        p.buffered = 0
                        p.kept = 0
                        struck = true
                    }
                    party[i] = take p
                }
            }
            boss.landed = true
            if struck || parried {
                boss.hold = hold_of(attack.damage)
            }
            if parried {
                boss.act = STAGGERED
                boss.timer = attack.stagger
                return
            }
        }
        if boss.timer == 0 {
            if boss.act == WINDUP {
                boss.act = ACTIVE
                boss.timer = attack.active
                boss.landed = false
            } else if boss.act == ACTIVE {
                boss.act = RECOVER
                boss.timer = attack.recovery
            } else {
                boss.act = IDLE
                boss.move_ = NO_MOVE
            }
        }
        return
    }
    if target == party.len() {
        return
    }
    // Free, it faces its target.
    boss.facing = direction(party[target].x - boss.x, party[target].z - boss.z)
    if let Some((a, on)) = next_attack(b, boss.hp, full, made, best) {
        made += on
        boss.act = WINDUP
        boss.move_ = a
        boss.timer = ATTACKS[a].windup
        return
    }
    let tx = party[target].x
    let tz = party[target].z
    boss.x += clamp(tx - boss.x, -b.speed, b.speed)
    boss.z += clamp(tz - boss.z, -b.speed, b.speed)
}

/// Whether `log` is a log a player could send: changes in order of their frames, each a change,
/// each an input of 14 bits with a stick that's one, before frame `end`, and at most `most` of them.
/// The input before the first is `before` (a log picked up again carries on from one).
pub fn well_formed(log: [Change], end: u32, most: u32, before: u32 = 0) -> bool {
    if log.len() > most {
        return false
    }
    var last: u32 = 0
    var prev = before
    for i in 0..log.len() {
        let c = log[i].clone()
        if c.frame >= end ||
            (i > 0 && c.frame <= last) ||
            c.input >= 16384 ||
            (c.input & 63) > 48 ||
            c.input == prev {
            return false
        }
        last = c.frame
        prev = c.input
    }
    true
}

/// The input `log` holds just before frame `cut`.
pub fn input_before(log: [Change], cut: u32) -> u32 {
    var input: u32 = 0
    for c in log {
        if c.frame < cut {
            input = c.input
        }
    }
    input
}

/// A player's log picked up again after it left: `before`'s changes before frame `cut` (what was
/// heard of it), then `after`'s from `cut` on (its own, since it came back), all before frame
/// `end`, each one a change.
pub fn spliced(before: [Change], cut: u32, after: [Change], end: u32) -> Vec<Change> {
    var out: Vec<Change> = Vec::new()
    var prev: u32 = 0
    for c in before {
        if c.frame < cut &&
            c.frame < end &&
            c.input != prev &&
            (out.is_empty() || c.frame > out[out.len() - 1].frame) {
            prev = c.input
            out.push(c.clone())
        }
    }
    for c in after {
        if c.frame >= cut &&
            c.frame < end &&
            c.input != prev &&
            (out.is_empty() || c.frame > out[out.len() - 1].frame) {
            prev = c.input
            out.push(c.clone())
        }
    }
    out
}

// ---- tests --------------------------------------------------------------------------------------

fn next(seed: mut u32) -> u32 {
    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
    seed >> 8
}

@test
fn oversized_party_counts_still_make_the_same_four_player_fight() {
    let w = World::start(1000000)
    assert(w == World::start(MAX_PARTY))
    let out = run(1000000, [])
    assert(out == run(MAX_PARTY, []))
}

@test
fn a_bit_the_rules_dont_read_changes_nothing_then_or_later() {
    // Random fights of four; at each frame, every bit outside each player's read set flipped at
    // random gives the same world, at once and after 60 more frames of the same inputs.
    var seed: u32 = 12345
    var w = World::start(4)
    var inputs: Vec<u32> = Vec::new()
    for _ in 0..4 {
        inputs.push(0)
    }
    var checked: u32 = 0
    while w.frame < 3000 && !w.over {
        for i in 0..4 {
            if next(mut seed) % 5 == 0 {
                inputs[i] = (next(mut seed) & BUTTON_BITS) | (next(mut seed) % 49)
            }
        }
        var other = inputs.clone()
        for i in 0..4 {
            other[i] = other[i] ^ (next(mut seed) & (STICK_BITS | BUTTON_BITS) & !w.reads(i))
        }
        var a = w.clone()
        var b = w.clone()
        step(mut a, inputs)
        step(mut b, other)
        // What differs is only the buttons as last taken, which an unread flip spends.
        a.before = Vec::new()
        b.before = Vec::new()
        assert(a == b, "an unread bit changes nothing now")
        if w.frame % 50 == 0 {
            var c = w.clone()
            var d = w.clone()
            step(mut c, inputs)
            step(mut d, other)
            // Both then go on with what the sender actually holds: the same inputs, but each
            // with the buttons it has (a flip spent stays spent).
            var later = inputs.clone()
            for k in 0..60 {
                if k == 30 {
                    for i in 0..4 {
                        later[i] = later[i] ^ ATTACK << 6
                    }
                }
                var mine = later.clone()
                for i in 0..4 {
                    mine[i] = (mine[i] & !BUTTON_BITS) |
                        (d.before[i] ^ (later[i] ^ c.before[i]) & BUTTON_BITS)
                }
                step(mut c, later)
                step(mut d, mine)
            }
            c.before = Vec::new()
            d.before = Vec::new()
            assert(c == d, "an unread bit changes nothing later")
        }
        step(mut w, inputs)
        checked += 1
    }
    assert(checked > 1000, "the fight lasts")
}

/// A world with one player of weapon `weapon` stood in reach of the boss, which stands still.
fn at_the_boss(weapon: u32) -> World {
    var w = World::armed([weapon])
    w.party[0].x = 0
    w.party[0].z = 6 * UNIT - 2 * UNIT
    w
}

/// Steps `w` `frames` times with `input` held, the boss kept still and unhurt but for its hp.
fn hold(w: mut World, input: u32, frames: u32) {
    for _ in 0..frames {
        w.boss.act = STAGGERED
        w.boss.timer = 2
        step(mut w, [input])
    }
}

@test
fn a_missing_input_stops_the_stick_without_pressing_a_button() {
    var w = at_the_boss(LONGSWORD)
    let first = MOVES[WEAPONS[LONGSWORD].light]
    let frames = 2 + first.windup + first.active + first.recovery + hold_of(first.damage)
    hold(mut w, input: ATTACK << 6, frames: frames)
    assert(w.party[0].act == IDLE, "the previous press has finished")
    step(mut w, [ATTACK << 6 | 3])
    let hp = w.boss.hp
    let x = w.party[0].x
    step(mut w, [])
    assert(w.party[0].act == IDLE, "no input presses no attack")
    assert(w.party[0].x == x && w.boss.hp == hp, "no input moves nowhere or attacks")
}

@test
fn a_light_press_in_a_cuts_recovery_goes_on_to_the_combos_next() {
    var w = at_the_boss(LONGSWORD)
    let hp = w.boss.hp
    // The first cut: pressed, then held through its windup and strike.
    hold(mut w, input: ATTACK << 6, frames: 1)
    let first = MOVES[2]
    // (Each held at its contact, `hold_of`.)
    hold(mut w, input: ATTACK << 6, frames: first.windup + first.active + hold_of(first.damage))
    assert(w.party[0].act == RECOVER && w.party[0].move_ == 2, "the first cut recovers")
    // (And locking on, read whenever it's up.)
    assert(w.reads(0) == CHAIN_BITS | (LOCK_ON << 6), "its recovery reads only the attacks")
    assert(w.boss.hp == hp - first.damage, "it landed")
    // Pressed again (the bit flips back): the second cut.
    hold(mut w, input: 0, frames: 1)
    assert(w.party[0].act == WINDUP && w.party[0].move_ == 3, "the second cut")
    let second = MOVES[3]
    hold(mut w, input: 0, frames: second.windup + second.active + hold_of(second.damage))
    hold(mut w, input: ATTACK << 6, frames: 1)
    assert(w.party[0].move_ == 4, "the third")
    let third = MOVES[4]
    hold(mut w, input: ATTACK << 6, frames: third.windup + third.active + hold_of(third.damage))
    assert(w.boss.hp == hp - first.damage - second.damage - third.damage, "all three land")
    assert(w.reads(0) == LOCK_ON << 6, "the combo's last cut goes on to nothing")
    hold(mut w, input: ATTACK << 6, frames: third.recovery + 1)
    assert(w.party[0].act == IDLE, "and it's done")
}

@test
fn each_weapon_fights_with_its_own_moves() {
    for weapon in [FISTS, LONGSWORD] {
        var w = at_the_boss(weapon)
        let hp = w.boss.hp
        let heavy = MOVES[WEAPONS[weapon].heavy]
        hold(mut w, input: HEAVY << 6, frames: 1 + heavy.windup + heavy.active)
        assert(w.boss.hp == hp - heavy.damage, "a heavy attack lands its weapon's damage")
        assert(w.party[0].stamina == STAMINA - heavy.cost, "and costs its stamina")
        assert(w.reads(0) == LOCK_ON << 6, "a heavy is no combo's start")
    }
    // A light press in a fists' jab's recovery starts nothing: its combo is one jab.
    var f = at_the_boss(FISTS)
    let jab = MOVES[0]
    hold(mut f, input: ATTACK << 6, frames: 1 + jab.windup + jab.active + hold_of(jab.damage))
    hold(mut f, input: 0, frames: 1)
    assert(f.party[0].act == RECOVER, "no next jab")
    // A weapon that isn't one is fists, so any party is a fight.
    assert(World::armed([77]).party[0].weapon == FISTS)
}

@test
fn every_bosss_patterns_name_its_attacks() {
    for b in BOSSES {
        for a in b.calm {
            assert(a < ATTACKS.len())
        }
        for a in b.enraged {
            assert(a < ATTACKS.len())
        }
        assert(b.hp_each > 0 && b.speed > 0 && b.rage > 0 && b.rage < 100)
        // Each pattern has an attack it walks in for that meets someone right by it: it never
        // stands still beside a player.
        let close = |pattern: [u32; 8]| -> bool {
            for a in pattern {
                if ATTACKS[a].walks_in && ATTACKS[a].near == 0 {
                    return true
                }
            }
            false
        }
        assert(close(b.calm) && close(b.enraged))
    }
    for a in ATTACKS {
        assert(a.near <= a.far && a.windup > 0 && a.active > 0 && (a.stagger > 0) == a.parried)
    }
}

@test
fn the_idol_makes_the_next_attack_in_its_pattern_that_reaches() {
    let idol = BOSSES[THE_IDOL]
    let full = idol.hp_each
    // Calm, from the start: a sweep for someone in front of it.
    assert(next_attack(idol, full, full, 0, 128) == Some((0, 1)))
    // Third in the pattern: the palm, which reaches past the sweeps.
    assert(next_attack(idol, full, full, 2, 240) == Some((1, 1)))
    // Fourth is the stomp, for someone underfoot; anyone farther gets the slam after it.
    assert(next_attack(idol, full, full, 3, 40) == Some((3, 1)))
    assert(next_attack(idol, full, full, 3, 150) == Some((2, 2)))
    // Out of the next one's reach: it walks in for it, even if another reaches.
    assert(next_attack(idol, full, full, 0, 400).is_none())
    assert(next_attack(idol, full, full, 0, 200).is_none(), "the sweep's next, not the palm")
    // The palm with someone too close: it goes on to the stomp.
    assert(next_attack(idol, full, full, 2, 40) == Some((3, 2)))
    // Below half its health, enraged: the quicker sweep.
    assert(next_attack(idol, full / 2 - 1, full, 0, 128) == Some((4, 1)))
}

@test
fn a_parry_meets_a_sweep_but_not_the_slam() {
    // Standing in front of it, parrying as its attack strikes.
    let struck = |attack: u32| -> World {
        var w = at_the_boss(LONGSWORD)
        w.boss.act = WINDUP
        w.boss.move_ = attack
        w.boss.timer = 1
        w.party[0].act = PARRYING
        w.party[0].timer = PARRY_WINDOW
        step(mut w, [0])
        step(mut w, [0])
        take w
    }
    let swept = struck(0)
    assert(swept.party[0].hp == PLAYER_HP && swept.boss.act == STAGGERED, "the sweep is parried")
    assert(swept.boss.timer + 1 >= ATTACKS[0].stagger)
    let slammed = struck(2)
    assert(slammed.party[0].hp == PLAYER_HP - ATTACKS[2].damage, "no parry holds the slam")
    assert(slammed.boss.act == ACTIVE || slammed.boss.act == RECOVER)
}

@test
fn the_idol_winds_up_its_tell_then_strikes() {
    var w = at_the_boss(LONGSWORD)
    // Nothing pressed: it walks up and sweeps, and the tell says so for the whole windup.
    var told: u32 = 0
    for _ in 0..200 {
        step(mut w, [0])
        if w.boss.act == WINDUP {
            let Some(a) = w.boss_attack() else { panic("its attack, in its windup") }
            assert(a.name == "Sweep")
            told += 1
        }
        if w.party[0].hp < PLAYER_HP {
            break
        }
    }
    assert(told == ATTACKS[0].windup && w.party[0].hp == PLAYER_HP - ATTACKS[0].damage)
}

/// The stick toward (`dx`, `dz`) at full speed (`away`: from it).
fn stick_to(dx: i32, dz: i32) -> u32 {
    var best: u32 = 0
    var most: i32 = -1000000
    for d in 0..16 {
        let dot = DIR_X[d] * dx + DIR_Z[d] * dz
        if dot > most {
            most = dot
            best = d
        }
    }
    1 + best * 3 + 2
}

/// A player who reads the idol's tells, `skill` of 100 of them (each tell read or missed once,
/// the same every run): parries what a parry meets, dodges what it doesn't, and cuts in the
/// openings, from `keep` away (a player who keeps close is stomped on). Its next input, from
/// `w`, its last `input`.
fn reader(w: World, i: u32, input: u32, skill: u32, keep: i32) -> u32 {
    let p = w.party[i].clone()
    let b = w.boss.clone()
    let d = reach(p.x, p.z, b.x, b.z)
    let buttons = input & BUTTON_BITS
    let toward = stick_to(b.x - p.x, b.z - p.z)
    let away = stick_to(p.x - b.x, p.z - b.z)
    let reads = (w.made * 7 + i * 3).wrapping_mul(2654435761) % 100 < skill
    if b.act == WINDUP && b.move_ < ATTACKS.len() {
        let a = ATTACKS[b.move_]
        let reached = a.near <= d && d <= a.far + 32
        if reached && b.timer <= 3 && p.act == IDLE && reads {
            if a.parried {
                return buttons ^ (PARRY << 6)
            }
            return (buttons ^ (DODGE << 6)) | away
        }
        // Out of its way, or waiting for it.
        return buttons | if d < keep + 5 { 0 } else { toward }
    }
    // An opening long enough for a cut to land and its recovery to end before the next tell.
    let open = (b.act == RECOVER || b.act == STAGGERED) && b.timer >= 20
    if open && d <= 170 && p.stamina >= 20 && p.act == IDLE {
        return buttons ^ (ATTACK << 6)
    }
    buttons | if d > keep { toward } else { 0 }
}

/// The fight of `n` readers of `skill`, the second keeping close, to its end; and how many times
/// the boss made each attack.
fn read_out(n: u32, skill: u32) -> (World, Vec<u32>) {
    var w = World::start(n)
    var inputs: Vec<u32> = Vec::new()
    for _ in 0..n {
        inputs.push(0)
    }
    var made: Vec<u32> = Vec::new()
    for _ in 0..ATTACKS.len() {
        made.push(0)
    }
    while !w.over {
        for i in 0..n {
            inputs[i] = reader(w, i, inputs[i], skill, if i == 1 { 40 } else { 160 })
        }
        let idle = w.boss.act != WINDUP
        step(mut w, inputs)
        if idle && w.boss.act == WINDUP && w.boss.move_ < ATTACKS.len() {
            made[w.boss.move_] += 1
        }
    }
    (w, made)
}

@test
fn the_idol_falls_to_a_party_that_reads_its_tells_and_not_to_one_that_doesnt() {
    // Every attack is made, enraged ones too: the palm at those who keep their distance, the
    // stomp on the one who keeps close.
    var all: Vec<u32> = Vec::new()
    for _ in 0..ATTACKS.len() {
        all.push(0)
    }
    for n in 1..4 {
        let (good, made) = read_out(n, 95)
        assert(good.winner == Winner::Party, f"{n} who read it win")
        let (poor, _) = read_out(n, 20)
        assert(poor.winner == Winner::Boss, f"{n} who miss most tells fall")
        for a in 0..ATTACKS.len() {
            all[a] += made[a]
        }
        std::io::print(
            f"{n}: read in {good.frame / 60} s; missed, fell in {poor.frame / 60} s; slams {made[2] + made[5]}, stomps {made[3]}",
        )
    }
    for a in 0..ATTACKS.len() {
        assert(all[a] > 0, f"attack {a} made")
    }
}

@test
fn an_arc_is_about_its_fighters_facing() {
    assert(within(AHEAD, dx: 0, dz: 100, arc: THRUST), "a thrust meets what's ahead")
    assert(!within(AHEAD, dx: 100, dz: 100, arc: THRUST), "and nothing 45 degrees off")
    assert(within(AHEAD, dx: 100, dz: 100, arc: CUT), "a cut meets 45 degrees off")
    assert(!within(AHEAD, dx: 100, dz: -10, arc: CUT), "but not what's beside and behind")
    assert(within(AHEAD, dx: 100, dz: 40, arc: SWEEP), "a sweep reaches round to the side")
    assert(!within(AHEAD, dx: 0, dz: -100, arc: SWEEP), "not behind")
    assert(within(AHEAD, dx: 0, dz: -100, arc: ALL_ROUND), "a stomp meets all round")
    assert(direction(dx: 0, dz: -5) == BACK && direction(dx: 5, dz: 0) == 0)
}

@test
fn a_cut_lands_on_what_its_wielder_faces() {
    let cut = MOVES[WEAPONS[LONGSWORD].light]
    var w = at_the_boss(LONGSWORD)
    let hp = w.boss.hp
    hold(mut w, input: ATTACK << 6, frames: cut.windup + 2)
    assert(w.boss.hp == hp - cut.damage, "facing the boss, it lands")
    var away = at_the_boss(LONGSWORD)
    away.party[0].facing = BACK
    hold(mut away, input: ATTACK << 6, frames: cut.windup + 2)
    assert(away.boss.hp == hp, "its back to the boss, it misses")
    // Pressed with the stick toward the boss, it turns as it cuts.
    var turned = at_the_boss(LONGSWORD)
    turned.party[0].facing = BACK
    hold(mut turned, input: (ATTACK << 6) | (1 + AHEAD * 3), frames: cut.windup + 2)
    assert(turned.party[0].facing == AHEAD && turned.boss.hp == hp - cut.damage, "turned, it lands")
}

@test
fn the_idol_misses_who_steps_out_of_its_arc_once_it_turns_no_more() {
    let palm = ATTACKS[1]
    // Its palm thrust at the player ahead, turned no more: the player ahead or stepped aside.
    let thrust = |aside: i32| -> World {
        var w = at_the_boss(LONGSWORD)
        w.party[0].z = 3 * UNIT
        w.party[0].x = aside
        w.boss.act = WINDUP
        w.boss.move_ = 1
        w.boss.timer = LOCK
        for _ in 0..(LOCK + 2) {
            step(mut w, [0])
        }
        take w
    }
    assert(thrust(0).party[0].hp == PLAYER_HP - palm.damage, "ahead, it's struck")
    assert(thrust(2 * UNIT).party[0].hp == PLAYER_HP, "a step aside, its thrust misses")
    // A parry meets what it faces: one turned away is swept.
    var w = at_the_boss(LONGSWORD)
    w.party[0].facing = BACK
    w.boss.act = WINDUP
    w.boss.move_ = 0
    w.boss.timer = 1
    w.party[0].act = PARRYING
    w.party[0].timer = PARRY_WINDOW
    step(mut w, [0])
    step(mut w, [0])
    assert(w.party[0].hp == PLAYER_HP - ATTACKS[0].damage, "a parry turned away doesn't meet it")
}

@test
fn a_blow_holds_both_at_its_contact_by_its_weight() {
    assert(hold_of(8) == 3 && hold_of(26) == 6 && hold_of(44) == 8, "heavier holds longer")
    let cut = MOVES[WEAPONS[LONGSWORD].light]
    var w = at_the_boss(LONGSWORD)
    w.boss.act = RECOVER
    w.boss.move_ = 0
    w.boss.timer = 60
    let pressed = 1 + cut.windup
    for _ in 0..pressed {
        step(mut w, [ATTACK << 6])
    }
    assert(w.party[0].act == ACTIVE && w.party[0].hold == hold_of(cut.damage), "the cut's held")
    assert(w.boss.hold == hold_of(cut.damage), "and so is what it struck")
    let (timer, boss_timer) = (w.party[0].timer, w.boss.timer)
    step(mut w, [ATTACK << 6])
    assert(w.party[0].timer == timer && w.boss.timer == boss_timer, "held, neither's clock runs")
    // A boss winding up isn't held: a party can't hold its blows off.
    var up = at_the_boss(LONGSWORD)
    up.boss.act = WINDUP
    up.boss.move_ = 2
    up.boss.timer = 40
    for _ in 0..pressed {
        step(mut up, [ATTACK << 6])
    }
    assert(up.party[0].hold > 0 && up.boss.hold == 0, "its windup runs on")
}

@test
fn a_press_made_a_little_early_is_kept_till_it_can_be_acted_on() {
    let jab = MOVES[0]
    let heavy = MOVES[WEAPONS[FISTS].heavy]
    let busy = jab.windup + jab.active + hold_of(jab.damage) + jab.recovery
    // A heavy pressed `early` frames before the jab's done.
    let early_heavy = |early: u32| -> World {
        var w = at_the_boss(FISTS)
        hold(mut w, input: ATTACK << 6, frames: 1 + busy - early)
        hold(mut w, input: (ATTACK | HEAVY) << 6, frames: early + 1)
        take w
    }
    let kept = early_heavy(BUFFER - 2)
    assert(kept.party[0].act == WINDUP && kept.party[0].move_ == WEAPONS[FISTS].heavy, "kept")
    assert(kept.party[0].timer == heavy.windup, "begun the frame it could be")
    let lost = early_heavy(BUFFER + 6)
    assert(lost.party[0].act == IDLE, "too early, it isn't read: the rules read nothing then")
}

@test
fn a_kept_press_is_lost_when_its_fighter_is_struck() {
    var w = at_the_boss(LONGSWORD)
    // Recovering from a parry, a heavy pressed and kept; then the sweep lands.
    w.party[0].act = RECOVER
    w.party[0].timer = 6
    step(mut w, [HEAVY << 6])
    assert(w.party[0].buffered == HEAVY && w.party[0].kept > 0, "kept")
    w.boss.act = WINDUP
    w.boss.move_ = 0
    w.boss.timer = 1
    step(mut w, [HEAVY << 6])
    step(mut w, [HEAVY << 6])
    assert(w.party[0].hp == PLAYER_HP - ATTACKS[0].damage, "struck")
    assert(w.party[0].buffered == 0 && w.party[0].kept == 0, "and the press is lost")
}

/// A world with one player 2 m in front of the idol, the idol's attack `a` landing on the next
/// step (its active frames begun, facing the player).
fn struck_by(a: u32) -> World {
    var w = at_the_boss(FISTS)
    w.boss.act = ACTIVE
    w.boss.move_ = a
    w.boss.timer = ATTACKS[a].active
    w.boss.landed = false
    w.boss.facing = BACK
    w
}

/// Knockback: a blow pushes the one it lands on away from its striker, as far as it's heavy, once
/// its hold breaks, fast and then easing; it takes no control away.
@test
fn a_blow_pushes_the_one_struck_by_its_weight() {
    // (The trial turned off, no blow pushes, and there's nothing more to hold here.)
    if !KNOCKBACK {
        assert(push_of(MOST_HOLD) == 0, "off, no blow pushes")
        return
    }
    assert(
        push_of(8) == PUSH && push_of(3) == PUSH / 36 && push_of(6) * 9 == PUSH * 4,
        "by the hold",
    )
    // The slam (held 8): still through its hold, then pushed back 2.1 m, half of it on its
    // first two frames.
    var w = struck_by(2)
    let z0 = w.party[0].z
    step(mut w, [0])
    assert(w.party[0].hp < PLAYER_HP && w.party[0].hold == hold_of(40), "the slam lands")
    for _ in 0..hold_of(40) {
        step(mut w, [0])
        assert(w.party[0].z == z0, "held, it's still")
    }
    step(mut w, [0])
    step(mut w, [0])
    let early = z0 - w.party[0].z
    for _ in 0..30 {
        step(mut w, [0])
    }
    let all = z0 - w.party[0].z
    assert(all >= PUSH - 2 && all <= PUSH, f"the slam pushes it {all} units")
    assert(early * 2 >= all, f"fast, then easing: {early} of {all} in two frames")
    // A sweep (held 5) pushes it less; a player pushed can act at once.
    var s = struck_by(0)
    step(mut s, [0])
    for _ in 0..hold_of(20) {
        step(mut s, [0])
    }
    step(mut s, [ATTACK << 6])
    assert(s.party[0].act == WINDUP, "pushed, it strikes")
    for _ in 0..30 {
        step(mut s, [ATTACK << 6])
    }
    let swept = z0 - s.party[0].z
    assert(swept > 0 && swept < all / 2, f"the sweep pushes it {swept} units")
}

/// No hit, no push: a parry that meets a blow and a dodge that passes it take none; the arena's
/// edge stops a push as it stops a step; the idol takes a quarter of a man's push.
@test
fn no_hit_no_push_and_the_edge_stops_it() {
    // (The trial turned off, no blow pushes, and there's nothing more to hold here.)
    if !KNOCKBACK {
        assert(push_of(MOST_HOLD) == 0, "off, no blow pushes")
        return
    }
    var p = struck_by(0)
    p.party[0].act = PARRYING
    p.party[0].timer = PARRY_WINDOW
    p.party[0].facing = AHEAD
    let z0 = p.party[0].z
    for _ in 0..30 {
        step(mut p, [0])
    }
    assert(p.boss.act == STAGGERED && p.party[0].z == z0, "a parry takes no push")
    assert(p.boss.shove_x == 0 && p.boss.shove_z == 0, "nor does the one parried")
    var d = struck_by(2)
    d.party[0].act = DODGING
    d.party[0].timer = DODGE_FRAMES
    d.party[0].dx = 0
    d.party[0].dz = 0
    step(mut d, [0])
    assert(d.party[0].hp == PLAYER_HP && d.party[0].shove_z == 0, "a dodge takes none")
    // At the arena's edge.
    var e = struck_by(2)
    e.boss.z = -ARENA + 2 * UNIT
    e.party[0].z = -ARENA + 4
    for _ in 0..30 {
        step(mut e, [0])
    }
    assert(e.party[0].z == -ARENA, f"the edge stops it at {e.party[0].z}")
    // The idol, struck by the overhead (held 6), standing still.
    var o = at_the_boss(LONGSWORD).standing_still()
    let bz = o.boss.z
    let heavy = MOVES[WEAPONS[LONGSWORD].heavy]
    for _ in 0..heavy.windup + 40 {
        step(mut o, [HEAVY << 6])
    }
    assert(o.boss.hp < o.full, "the overhead lands")
    let moved = o.boss.z - bz
    assert(moved == push_of(hold_of(heavy.damage)) / 4, f"the idol's pushed {moved} units")
}

/// Locked on (`LOCK_ON`, a press), a free fighter faces the foe every frame, the nearest of the 16
/// ways to it, and its stick moves it without turning it, at `LOCKED_SPEED`; a second press lets
/// go, and it faces where its stick points again. With `LOCKING` off a press does nothing.
@test
fn locked_on_a_fighter_faces_the_foe_and_goes_any_way() {
    var w = World::armed([LONGSWORD]).standing_still()
    let lock = LOCK_ON << 6
    // Round to the idol's left, the stick square to the line between them, at its slowest.
    let aside = 1 + 0 * 3
    step(mut w, [lock | aside])
    if !LOCKING {
        assert(!w.party[0].locked && w.party[0].facing == 0, "off, a press does nothing")
        return
    }
    assert(w.party[0].locked, "a press locks on")
    for _ in 0..120 {
        let x0 = w.party[0].x
        step(mut w, [lock | aside])
        let p = w.party[0].clone()
        let toward = direction(w.boss.x - p.x, w.boss.z - p.z)
        assert(p.facing == toward, f"it faces the foe: {p.facing}, the foe's way {toward}")
        assert(
            p.x - x0 == DIR_X[0] * LOCKED_SPEED[0] / 64,
            "and goes the stick's way at the locked pace",
        )
    }
    // Let go: it faces its stick again.
    step(mut w, [aside])
    step(mut w, [aside])
    assert(!w.party[0].locked && w.party[0].facing == 0, "a second press lets go")
}

/// A strike's facing may still turn through its turn window, toward the stick, a way every
/// `TURN_EVERY` frames at most, and is committed after it: pressed facing ahead with the stick
/// held a quarter round, the overhead turns three ways in its first 6 frames and no more.
@test
fn a_strike_turns_in_its_window_and_is_committed_after() {
    var w = at_the_boss(LONGSWORD).standing_still()
    // Facing ahead (+z, way 4), then the heavy pressed with the stick a quarter round (way 0).
    w.party[0].facing = AHEAD
    let aside = 1 + 0 * 3
    step(mut w, [HEAVY << 6])
    assert(w.party[0].act == WINDUP && w.party[0].facing == AHEAD, "the strike begins as it faced")
    for _ in 0..20 {
        step(mut w, [(HEAVY << 6) | aside])
    }
    let turned = (AHEAD + 16 - w.party[0].facing) % 16
    if !TURNING {
        assert(turned == 0, "off, it's committed as it begins")
        return
    }
    assert(turned == 3, f"it turned {turned} ways toward its stick, in its window and no more")
}

/// A strike carries its striker along the way it faces, as far by each frame as its move's
/// `TRAVEL`, and none across it; the foe's body stops it `NEAREST` off, and the arena's edge
/// stops it as it stops a step. With `TRAVELLING` off a striker stands where it began.
@test
fn a_strike_carries_its_striker_and_the_foe_and_the_edge_stop_it() {
    let jab = MOVES[WEAPONS[FISTS].light]
    let total = jab.windup + jab.active + jab.recovery
    // Far from the idol, facing it: carried frame by frame as its move goes.
    var w = World::armed([FISTS]).standing_still()
    let (x0, z0) = (w.party[0].x, w.party[0].z)
    step(mut w, [ATTACK << 6])
    for k in 0..total + 4 {
        assert(w.party[0].x == x0, "none across its way")
        let want = z0 + travelled(WEAPONS[FISTS].light, k)
        assert(w.party[0].z == want, f"frame {k}: at {w.party[0].z - z0}, its move {want - z0}")
        step(mut w, [ATTACK << 6])
    }
    let went = w.party[0].z - z0
    assert(if TRAVELLING { went == 32 } else { went == 0 }, f"the jab carried it {went} units")
    // Close by the idol: no nearer than `NEAREST`, and on to it when it travels.
    var n = World::armed([FISTS]).standing_still()
    n.party[0].x = n.boss.x
    n.party[0].z = n.boss.z - (NEAREST + 10)
    let start = reach(n.party[0].x, n.party[0].z, n.boss.x, n.boss.z)
    var nearest = start
    step(mut n, [ATTACK << 6])
    for _ in 0..total + 4 {
        nearest = min(nearest, reach(n.party[0].x, n.party[0].z, n.boss.x, n.boss.z))
        step(mut n, [ATTACK << 6])
    }
    assert(nearest >= NEAREST, f"it came {nearest} units from the idol")
    assert(if TRAVELLING { nearest == NEAREST } else {
        nearest == start
    }, f"the idol stops it {nearest} units off, from {start}")
    // At the arena's edge, facing out: no further.
    var e = World::armed([FISTS]).standing_still()
    e.boss.x = -ARENA
    e.boss.z = 0
    e.party[0].x = ARENA - 4 * UNIT
    e.party[0].z = ARENA - 4
    step(mut e, [ATTACK << 6])
    for _ in 0..total + 4 {
        assert(e.party[0].z <= ARENA, "within the arena")
        step(mut e, [ATTACK << 6])
    }
    assert(e.party[0].z == if TRAVELLING { ARENA } else { ARENA - 4 }, "the edge stops it")
}

/// A boss stood still (`World::standing_still`) makes no move of its own, however near a player
/// stands; let go (`World::let_go`), it makes its pattern's next again.
@test
fn a_boss_stood_still_and_let_go_strikes_again() {
    var w = World::armed([LONGSWORD]).standing_still()
    w.party[0].x = 0
    w.party[0].z = w.boss.z - 2 * UNIT
    for _ in 0..120 {
        step(mut w, [0])
    }
    assert(w.boss.act == IDLE && w.party[0].hp == PLAYER_HP, "still, it makes no move")
    var g = w.let_go()
    var moved = false
    for _ in 0..120 {
        step(mut g, [0])
        moved = moved || g.boss.act != IDLE
    }
    assert(moved, "let go, it strikes")
}
