// A fight played and watched (`wrela build mmo/watch`): two bots against the idol through the
// fight's real rules (mmo/combat's `sim`), drawn as the game draws a fight (mmo/game's
// `bodies::Ring`), from the first player's side. The second player is heard `LATE` frames late,
// as over a network: what's drawn is the first's client's prediction (the second's input held
// at the last one heard), corrected each frame as the late input comes, so the bodies show
// what a rollback's correction looks like.
//
// The bots (`bots`) stand round the idol, each on its own side, and answer its tell `REACT` frames in.
// With `TAKER` (`wrela build mmo/watch --set TAKER=1`, or `=2`) the first player is a bot that takes
// the idol's blows (`bots::taker`): what a blow does to a player is there to see, and each one
// that lands on it is named on screen with how far the rules pushed it. Alone (1), the idol's
// sweeps and its palm land on it; beside the fight's bot (2), its slam does.

use std::collections::Vec
use std::string::String
use bots::{bot, taker}
use combat::sim::{ATTACKS, FISTS, LONGSWORD, NO_MOVE, Seen, World, step}
use mmo::bodies::Ring
use ui::draw::{DrawList, Renderer}
use ui::text::{Face, Fonts}

/// How many frames late the second player is heard.
pub const LATE: u32 = 6
/// How many frames into the idol's windup the bots answer it.
pub const REACT: u32 = 15
/// A line drawn over the fight to say which it is (`--set TITLE="..."`; none by default).
pub const TITLE: Text = ""
/// Whether the first player is a bot that takes the idol's blows (`bots::taker`): 0 not, 1 alone
/// against the idol, 2 beside the fight's bot.
pub const TAKER: u32 = 0
/// What each bot fights with.
const WEAPONS_OF: [u32; 2] = [FISTS, LONGSWORD]

pub struct State {
    /// The fight as it is, and each of the last `LATE` frames' worlds before it.
    truth: World,
    past: Vec<World>,
    /// Each player's input, frame by frame.
    inputs: Vec<Vec<u32>>,
    ring: Ring,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    last: f32,
    /// The last blow that landed on the first player: what it was, when (s), and how far the
    /// rules pushed it (m).
    blow: String,
    blow_from: vec2,
    /// Whether the taker's on guard, and whether it's parried once.
    guard: bool,
    parried: bool,
}

pub fn init() -> State {
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    State {
        truth: if TAKER == 1 { World::armed([WEAPONS_OF[0]]) } else { World::armed(WEAPONS_OF) },
        past: Vec::new(),
        inputs: Vec::from([Vec::new(), Vec::new()]),
        ring: Ring::new(),
        fonts,
        renderer,
        list: DrawList::new(),
        last: 0.0,
        blow: String::new(),
        blow_from: vec2(0.0),
        guard: false,
        parried: false,
    }
}

/// The input player `i` gave at frame `f` (before its first, none).
fn input_at(s: State, i: u32, f: u32) -> u32 {
    if f < s.inputs[i].len() { s.inputs[i][f] } else { 0 }
}

/// The fight stepped on to frame `to`, the bots choosing as it goes.
fn play_to(s: mut State, to: u32) {
    while s.truth.frame < to && !s.truth.over {
        let f = s.truth.frame
        var ins: Vec<u32> = Vec::new()
        for i in 0..s.truth.players() {
            let before = if f > 0 { input_at(s, i, f - 1) } else { 0 }
            let x = if TAKER != 0 && i == 0 {
                taker(s.truth, i, before, WEAPONS_OF[i], s.guard)
            } else {
                bot(s.truth, i, before, WEAPONS_OF[i], REACT)
            }
            s.inputs[i].push(x)
            ins.push(x)
        }
        s.past.push(s.truth.clone())
        if s.past.len() > LATE {
            s.past.remove(0)
        }
        let (was, attack) = (s.truth.player(0), s.truth.boss().move_)
        let staggered = s.truth.boss().act == combat::sim::STAGGERED
        step(mut s.truth, ins)
        let now = s.truth.player(0)
        // (The taker's on guard once it's been hit, till it's parried once.)
        s.parried = s.parried || (!staggered && s.truth.boss().act == combat::sim::STAGGERED)
        s.guard = now.hp < 100 && !s.parried
        if now.hp < was.hp && attack != NO_MOVE {
            s.blow = String::from(
                f"{ATTACKS[attack].name} landed on P1 at {f32(s.truth.frame) / 60.0:.2} s",
            )
            s.blow_from = vec2(f32(now.carried_x), f32(now.carried_z))
        }
    }
}

/// What the first player's client shows: the fight from `LATE` frames back, the second's input
/// held at the last it heard.
fn predicted(s: State) -> World {
    if s.past.len() < LATE || s.truth.players() < 2 {
        return s.truth.clone()
    }
    var w = s.past[0].clone()
    let from = w.frame
    let heard = if from > 0 { input_at(s, 1, from - 1) } else { 0 }
    while w.frame < s.truth.frame {
        let f = w.frame
        step(mut w, [input_at(s, 0, f), heard])
    }
    w
}

fn line(s: mut State, text: str, y: f32) {
    let _ = s.list.text(s.fonts, Face::Mono, text, 15.0, vec2(24.0, y), vec4(0.1, 0.1, 0.12, 1.0))
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    let dt = clamp(time - s.last, 1.0e-4, 0.1)
    s.last = time
    play_to(mut s, u32(time * 60.0))
    let shown = predicted(s)
    s.list.clear(vec2(f32(width), f32(height)))
    for i in 0..shown.players() {
        let p: Seen = shown.player(i)
        line(
            mut s,
            String::from(f"P{i + 1}  {p.hp} hp  {p.stamina} stamina").as_str(),
            24.0 + 20.0 * f32(i),
        )
    }
    let b = shown.boss()
    line(mut s, String::from(f"Idol  {b.hp} hp").as_str(), 74.0)
    if TITLE != "" {
        line(mut s, TITLE, f32(height) - 40.0)
    }
    if s.blow.len() > 0 {
        let p = s.truth.player(0)
        let pushed = length(vec2(f32(p.carried_x), f32(p.carried_z)) - s.blow_from) / 64.0
        let said = String::from(f"{s.blow}: pushed {pushed:.2} m")
        line(mut s, said.as_str(), 94.0)
    }
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    s.ring.draw(shown, 0, time, dt, width, height, s.renderer)
}

// ---- tests --------------------------------------------------------------------------------------

/// The bots fight: in a minute of the real rules they wear the idol down, and the second, heard
/// late, still lands what the first's client predicts once its input comes.
@test
fn the_bots_fight_the_idol() {
    var w = World::armed([FISTS, LONGSWORD])
    var before = [u32(0), 0]
    for _ in 0..3600 {
        let ins = [bot(w, 0, before[0], FISTS, REACT), bot(w, 1, before[1], LONGSWORD, REACT)]
        before = ins
        step(mut w, ins)
    }
    let o = w.outcome()
    assert(o.dealt[0] > 0 && o.dealt[1] > 0, "both bots land blows")
}

/// The blows that land on the taker (`bots::taker`, the first player) in `frames` of the fight
/// `TAKER` plays: each one's frame, its name, and how far the rules pushed the taker for it (m,
/// read half a second on).
fn takers_blows(frames: u32, alone: bool) -> Vec<(u32, Text, f32)> {
    var w = if alone { World::armed([WEAPONS_OF[0]]) } else { World::armed(WEAPONS_OF) }
    var before = [u32(0), 0]
    var out: Vec<(u32, Text, f32)> = Vec::new()
    var open: Vec<(u32, Text, vec2)> = Vec::new()
    var guard = false
    var parried = false
    for _ in 0..frames {
        let second = if alone { 0 } else { bot(w, 1, before[1], WEAPONS_OF[1], REACT) }
        let ins = [taker(w, 0, before[0], WEAPONS_OF[0], guard), second]
        before = ins
        let (was, attack) = (w.player(0), w.boss().move_)
        let staggered = w.boss().act == combat::sim::STAGGERED
        if alone {
            step(mut w, [ins[0]])
        } else {
            step(mut w, ins)
        }
        let now = w.player(0)
        parried = parried || (!staggered && w.boss().act == combat::sim::STAGGERED)
        guard = now.hp < 100 && !parried
        let carried = vec2(f32(now.carried_x), f32(now.carried_z))
        if now.hp < was.hp && attack != NO_MOVE {
            open.push((w.frame, ATTACKS[attack].name, carried))
        }
        while open.len() > 0 && w.frame >= open[0].0 + 30 {
            let (f, name, from) = open[0]
            out.push((f, name, length(carried - from) / 64.0))
            let _ = open.remove(0)
        }
    }
    out
}

/// The taker takes the idol's blows, so a clip shows what knockback does (mmo/combat's
/// `push_of`): alone against it, a sweep, the palm and the slam each land on it, each pushing it as
/// far as its weight says (0.52, 0.94 and 2.11 m), all in the clip's 12 s.
@test
fn the_taker_takes_the_idols_blows() {
    if !combat::sim::KNOCKBACK {
        return
    }
    let blows = takers_blows(720, alone: true)
    for (f, n, pushed) in blows.clone() {
        std::io::print(f"  frame {f} ({f32(f) / 60.0:.2} s): {n}, pushed {pushed:.2} m")
    }
    for (name, push) in [("Sweep", 0.52), ("Palm", 0.94), ("Slam", 2.11)] {
        var seen = false
        for (_, n, pushed) in blows.clone() {
            if n == name && abs(pushed - push) < 0.05 {
                seen = true
            }
        }
        assert(seen, f"a {name} lands on the taker and pushes it {push} m")
    }
}
