// Bots that fight the fight's boss through its rules: each step they read the world (as a
// player reads the screen), walk to their own side of the boss (each its own, so a party stands
// round it, not on one spot), strike it there turned to face it, chain a combo, and answer its
// tell `react` frames into its windup (a person's reaction is some 12 to 24 frames at 60 a
// second) with a parry timed to meet the hit, or with a dodge across its reach when no parry
// holds it. A bot presses only when the rules read the press. For a fight to watch (this
// program) and a measure of how readable the boss's tells are (studio/feel).

use std::math::atan2
use combat::sim::{
    ATTACK, ATTACKS, BUTTON_BITS, DODGE, HEAVY, IDLE, MOVES, PARRY, PARRY_WINDOW, RECOVER, WEAPONS,
    WINDUP, World,
}

/// The stick toward (`dx`, `dz`) (the rules' units) at speed `speed` (0 to 2): one of the 16
/// directions, as the rules read it.
pub fn stick_to(dx: i32, dz: i32, speed: u32) -> u32 {
    let a = atan2(f32(dz), f32(dx))
    let dir = u32(i32(floor(a / 0.39269908 + 0.5)) + 16) % 16
    1 + dir * 3 + speed
}

/// How far apart two places are (the rules' units).
pub fn dist(dx: i32, dz: i32) -> i32 {
    i32(sqrt(f32(dx * dx + dz * dz)))
}

/// Bot `i`'s input for the next step of `w`, its last input `before`, wielding `weapon`
/// (`WEAPONS`), answering the boss's tell `react` frames into its windup: what it presses (a
/// press flips its button's bit) when the rules read it, and its stick.
/// Where bot `i` stands to fight the boss: on its own side of it, a quarter turn and more round
/// from the bot before (the first on the side the party comes from, -z), as far off as `reach`.
fn spot(i: u32, reach: i32) -> (i32, i32) {
    let sides: [(i32, i32); 4] = [(0, -1), (1, 0), (-1, 0), (0, 1)]
    let (sx, sz) = sides[i % 4]
    (sx * reach, sz * reach)
}

pub fn bot(w: World, i: u32, before: u32, weapon: u32, react: u32) -> u32 {
    let p = w.player(i)
    let b = w.boss()
    let held = before & BUTTON_BITS
    let reads = w.reads(i)
    let press = |button: u32| -> u32 { held ^ (button << 6) }
    let (dx, dz) = (b.x - p.x, b.z - p.z)
    let d = dist(dx, dz)
    if p.hp <= 0 || w.over {
        return held
    }
    if b.act == WINDUP && b.move_ < ATTACKS.len() {
        let a = ATTACKS[b.move_]
        let into = a.windup - min(b.timer, a.windup)
        let near = a.near - 32 <= d && d <= a.far + 64
        if near && into >= react && reads & (PARRY << 6) != 0 {
            // A parry's window held over the hit; a dodge at once.
            if a.parried && b.timer < PARRY_WINDOW {
                return press(PARRY) | stick_to(dx, dz, 0)
            }
            if !a.parried {
                return press(DODGE) | stick_to(-dz, dx, 2)
            }
        }
        if near {
            return held
        }
    }
    let reach = MOVES[WEAPONS[weapon].light].reach
    if p.act == RECOVER && reads & (ATTACK << 6) != 0 && d <= reach {
        return press(ATTACK)
    }
    if p.act == IDLE {
        // Its own side of the boss, a little inside its reach.
        let (ox, oz) = spot(i, reach - 40)
        let (tx, tz) = (b.x + ox - p.x, b.z + oz - p.z)
        if d <= reach - 16 && dist(tx, tz) <= 48 {
            // There, it strikes turned to the boss (the slowest stick turns it, and moves it no
            // further: it's striking); every third frame it's free, a heavy one.
            let turn = stick_to(dx, dz, 0)
            return if w.frame % 3 == 0 { press(HEAVY) | turn } else { press(ATTACK) | turn }
        }
        return held | stick_to(tx, tz, if dist(tx, tz) > 128 { 2 } else { 0 })
    }
    held
}
