// Bots that fight the fight's boss through its rules: each step they read the world (as a
// player reads the screen), walk to their own side of the boss (each its own, so a party stands
// round it, not on one spot), strike it there turned to face it, chain a combo, and answer its
// tell `react` frames into its windup (a person's reaction is some 12 to 24 frames at 60 a
// second) with a parry timed to meet the hit, or with a dodge across its reach when no parry
// holds it. It strikes only when the strike's over in time to answer the idol's soonest next
// tell, and through a tell it neither walks in nor strikes: so what it suffers is the rules'
// doing, not a strike it chose badly. A bot presses only when the rules read the press. For a fight to watch (this
// program) and a measure of how readable the boss's tells are (studio/feel).

use std::math::atan2
use combat::sim::{
    ATTACK, ATTACKS, BUTTON_BITS, DODGE, HEAVY, IDLE, LOCKING, LOCK_ON, MOVES, NO_MOVE, PARRY,
    PARRY_WINDOW, RECOVER, STAGGERED, SWORD, Seen, WEAPONS, WINDUP, World,
}

/// The stick toward (`dx`, `dz`) (the rules' units) at speed `speed` (0 to 2): one of the 16
/// directions, as the rules read it.
pub fn stick_to(dx: i32, dz: i32, speed: u32) -> u32 {
    let a = atan2(f32(dz), f32(dx))
    let dir = u32(i32(floor(a / 0.39269908 + 0.5)) + 16) % 16
    1 + dir * 3 + speed
}

/// How far apart two places are (the rules' units).
pub fn dist(dx: i32, dz: i32) -> i32 {
    i32(sqrt(f32(dx * dx + dz * dz)))
}

/// Bot `i`'s input for the next step of `w`, its last input `before`, wielding `weapon`
/// (`WEAPONS`), answering the boss's tell `react` frames into its windup: what it presses (a
/// press flips its button's bit) when the rules read it, and its stick.
/// Where bot `i` stands to fight the boss: on its own side of it, a quarter turn and more round
/// from the bot before (the first on the side the party comes from, -z), as far off as `reach`.
fn spot(i: u32, reach: i32) -> (i32, i32) {
    let sides: [(i32, i32); 4] = [(0, -1), (1, 0), (-1, 0), (0, 1)]
    let (sx, sz) = sides[i % 4]
    (sx * reach, sz * reach)
}

/// How many frames till boss `b` could land a hit at the soonest: what's left of its recovery or
/// its stagger, and then the shortest of its tells (its windup's left, if it's winding up).
fn soonest(b: Seen) -> u32 {
    var tell: u32 = 1000
    if b.man {
        let s = WEAPONS[SWORD]
        for m in [s.light, MOVES[s.light].next, s.heavy] {
            tell = min(tell, MOVES[m].windup)
        }
    } else {
        for a in ATTACKS {
            tell = min(tell, a.windup)
        }
    }
    if b.act == WINDUP {
        return b.timer
    }
    if b.act == RECOVER || b.act == STAGGERED {
        return b.timer + tell
    }
    // (Striking, it's landing now; idle, it may begin its tell at once.)
    if b.act == IDLE { tell } else { 0 }
}

/// Whether move `m` (its frames committed: windup, active and recovery) is over with time to
/// parry (`PARRY_WINDOW`) before boss `b` could land: a bot starts a strike only when it is, as a
/// player who knows the idol's rhythm does, so a strike never leaves it unable to answer a tell.
fn fits(m: u32, b: Seen) -> bool {
    if m == NO_MOVE {
        return false
    }
    let mv = MOVES[m]
    mv.windup + mv.active + mv.recovery + PARRY_WINDOW <= soonest(b)
}

/// How near the boss is under its feet (the rules' units): as far as its attacks reach that meet
/// only who's there, the ones it doesn't walk in for (the stomp's). The swordsman, a man, has no
/// such blow: nowhere's under his feet.
fn underfoot(b: Seen) -> i32 {
    if b.man {
        return 0
    }
    var far = 0
    for a in ATTACKS {
        if !a.walks_in {
            far = max(far, a.far)
        }
    }
    far
}

/// Whether move `m`, struck from `d` off the boss, lands in `reach` once its step's carried its
/// striker in (the rules' `travelled`; none with the rule off), and doesn't carry it in under the
/// boss's feet (`underfoot`; unless it's there already: then it carries it no nearer; or its reach
/// is too short to strike from outside them). A bot strikes from where its step leaves it in
/// reach, not nearer.
fn lands_in(m: u32, d: i32, reach: i32, b: Seen) -> bool {
    if m == NO_MOVE {
        return false
    }
    // (Where its step leaves it: the swordsman, a man, stops it where its sweep still meets him,
    // `sim::met_from`, as the rules do, and no nearer than it stands.)
    let stepped = d - combat::sim::travelled(m, MOVES[m].windup)
    let at = if b.man {
        min(d, max(stepped, combat::sim::met_from(m, 0, combat::sim::BODY)))
    } else {
        stepped
    }
    // (A weapon too short to strike from outside the boss's feet, the fists' sweep, strikes from as
    // far off as it can.)
    at <= reach && at >= min(d, min(underfoot(b) + 1, reach - 32))
}

pub fn bot(w: World, i: u32, before: u32, weapon: u32, react: u32) -> u32 {
    let p = w.player(i)
    let b = w.boss()
    // Locked on to the idol, if the rules lock on (`LOCKING`): a press of `LOCK_ON` once.
    let held = if LOCKING && !p.locked && !w.over { (before & BUTTON_BITS) ^ (LOCK_ON << 6) } else {
        before & BUTTON_BITS
    }
    let reads = w.reads(i)
    let press = |button: u32| -> u32 { held ^ (button << 6) }
    let (dx, dz) = (b.x - p.x, b.z - p.z)
    let d = dist(dx, dz)
    if p.hp <= 0 || w.over {
        return held
    }
    // (The tell it answers: the idol's attack, or the swordsman's strike, which a parry meets,
    // from as far as its step and sweep reach.)
    let telling = b.act == WINDUP && b.move_ != NO_MOVE && if b.man { b.move_ < MOVES.len() } else {
        b.move_ < ATTACKS.len()
    }
    if telling {
        let (windup, near, parried) = if b.man {
            let m = MOVES[b.move_]
            let far = combat::sim::reach_of(b.move_, combat::sim::BODY) +
                combat::sim::travelled(b.move_, m.windup)
            (m.windup, d <= far + 64, true)
        } else {
            let a = ATTACKS[b.move_]
            (a.windup, a.near - 32 <= d && d <= a.far + 64, a.parried)
        }
        let into = windup - min(b.timer, windup)
        // (The parry's window held over the hit: the idol's lands on its hit frame; the
        // swordsman's sweeps in, meeting what's straight ahead a frame or three into its active
        // frames, `sim::SWEPT`, so it's held over those as well.)
        let lead = if b.man { PARRY_WINDOW / 2 + 1 } else { PARRY_WINDOW }
        if near && into >= react && reads & (PARRY << 6) != 0 {
            // A parry's window held over the hit; a dodge at once.
            if parried && b.timer < lead {
                return press(PARRY) | stick_to(dx, dz, 0)
            }
            if !parried {
                return press(DODGE) | stick_to(-dz, dx, 2)
            }
        }
        // Through a tell, it neither walks into it nor strikes: it stands, turned to the idol.
        return held | stick_to(dx, dz, 0)
    }
    let body = if b.man { combat::sim::BODY } else { combat::sim::IDOL_BODY }
    let reach = combat::sim::reach_of(WEAPONS[weapon].light, body)
    let arms = WEAPONS[weapon]
    // (Its strike's step, which carries it in as it strikes: it stands back by it, so the step
    // lands it where it'd stand, a little inside its reach; and no strike of it, a combo's next
    // as much as its first, carries it in under the idol's feet.)
    let step = combat::sim::travelled(arms.light, MOVES[arms.light].windup)
    let next = if p.move_ != NO_MOVE { MOVES[p.move_].next } else { NO_MOVE }
    if p.act == RECOVER &&
        reads & (ATTACK << 6) != 0 &&
        lands_in(next, d, reach, b) &&
        fits(next, b) {
        return press(ATTACK)
    }
    // (Against the swordsman: stood too close for its cut to meet him, its blade passing beyond
    // him, it backs off at once, at a run, a frame or two.)
    if p.act == IDLE && b.man && d < combat::sim::met_from(arms.light, 0, combat::sim::BODY) {
        return held | stick_to(-dx, -dz, 2)
    }
    if p.act == IDLE {
        // Its own side of the boss, a little inside its reach once its step's carried it.
        let (ox, oz) = spot(i, reach - 40 + step)
        let (tx, tz) = (b.x + ox - p.x, b.z + oz - p.z)
        let in_reach = lands_in(arms.light, d, reach - 16, b)
        let there = in_reach && dist(tx, tz) <= 48
        // (An opening, the idol in reach, it takes from wherever it stands.)
        let opening = in_reach && fits(arms.light, b)
        if there || opening {
            // There, it strikes turned to the boss (the slowest stick turns it, and moves it no
            // further: it's striking); every third frame it's free, a heavy one. Only a strike
            // that's over in time to answer the idol's next tell.
            let turn = stick_to(dx, dz, 0)
            if w.frame % 3 == 0 && fits(arms.heavy, b) {
                return press(HEAVY) | turn
            }
            if fits(arms.light, b) {
                return press(ATTACK) | turn
            }
            return held | turn
        }
        return held | stick_to(tx, tz, if dist(tx, tz) > 128 { 2 } else { 0 })
    }
    held
}

/// Where the idol's sweep, palm and slam all meet a player (units off it: past the palm's near
/// edge, 96, within the sweep's far one, 160).
const MEETS: i32 = 128

/// A bot that takes the idol's blows: it walks to its own spot by the idol and strikes it from
/// there with its light attack whenever it's free, and answers no tell but one: on `guard` (its
/// caller's, once it's been hit and till it's parried once) it parries, so the slam that would
/// finish it lands on it standing. So
/// the idol's sweeps, palms and slams land on it, and what a blow does to a player (mmo/combat's
/// knockback) is there to see; pushed off, it walks straight back in and strikes. For a clip
/// (`TAKER` in this program), not a fighter's measure: the bench's bots are `bot`'s.
pub fn taker(w: World, i: u32, before: u32, weapon: u32, guard: bool) -> u32 {
    let p = w.player(i)
    let b = w.boss()
    let held = before & BUTTON_BITS
    let press = |button: u32| -> u32 { held ^ (button << 6) }
    let (dx, dz) = (b.x - p.x, b.z - p.z)
    let d = dist(dx, dz)
    if p.hp <= 0 || w.over {
        return held
    }
    if p.act != IDLE {
        return held
    }
    // On guard (`guard`: its caller's say, once it's been hit), it strikes no more, keeps to its
    // own side of the idol, and parries the next tell a parry meets.
    if guard {
        if b.act == WINDUP &&
            b.move_ < ATTACKS.len() &&
            ATTACKS[b.move_].parried &&
            b.timer < PARRY_WINDOW {
            return press(PARRY) | stick_to(dx, dz, 0)
        }
    }
    // It strikes from its spot, not nearer: a strike that carries its striker in (mmo/combat's
    // `TRAVELLING`) would take it on in under the idol's feet, strike by strike, where only the
    // stomp meets it. Its spot's where the sweep, the palm and the slam all meet it (`MEETS`, or
    // nearer if its reach is shorter), and it stands back by its strike's step, so the step lands
    // it there.
    let light = WEAPONS[weapon].light
    let reach = combat::sim::reach_of(light, combat::sim::IDOL_BODY)
    let step = combat::sim::travelled(light, MOVES[light].windup)
    let there = min(reach - 24, MEETS)
    let at = d - step
    if at <= min(there + 8, reach - 16) && at >= there - 16 && !guard {
        return press(ATTACK) | stick_to(dx, dz, 0)
    }
    let (ox, oz) = spot(i, there + step)
    let (tx, tz) = (b.x + ox - p.x, b.z + oz - p.z)
    held | stick_to(tx, tz, if dist(tx, tz) > 128 { 2 } else { 0 })
}
