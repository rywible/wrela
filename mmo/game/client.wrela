// The MMO's first client, drawn flat and plain: it proves the rooms and the relay, not the look.
// A player walks a shared island (the room `island-1`) and places marks there; waits in the fight
// room's lobby (`fight-1`) and begins a fight for whoever waits. A fight's live inputs go over the
// fight room's relay: each player runs the fight itself, predicting the others' inputs and rolling
// back when they arrive, and sends its own log to the room at the end, which runs the fight again
// to settle it. Its input layer is the bandwidth bench's four winners (combat::codec).
//
// The player plays as their wrela account's character (character.wrela), whose name and look the
// island shows to everyone there; a player who isn't signed in plays as a guest.
//
// Keys: WASD or the arrows walk and move; F waits for a fight (again: stops waiting); Enter begins
// it; E places a mark; C changes the character's look; P makes an invite link to a party's own
// fight room (`party-<code>`), which a friend's link opens too. In the maker, up and down choose a part,
// left and right its look, Enter saves and Escape leaves. In a fight, J or Space attacks, K parries, L or Shift dodges. A pad: the
// left stick, West attacks, North parries, South dodges, Start begins, Select waits.

use combat::codec::{Encoder, LOOK_AHEAD, Link, Pad}
use combat::main::{Fight, HANDING, PLAYER_CHANGES, UNCUT}
use std::math::{cos, sin}
use combat::sim::{
    ATTACK, Change, DODGE, HEAVY, LONGSWORD, MAX_FRAMES, PARRY, Seen, Winner, World, step,
}
use character::{Character, Stage, Why}
use island::main::{Card, Island, MAX_STEP}
use platform::names
use std::gpu::begin_screen_pass
use std::hash::Hasher
use std::input::{Button, Event, Key, PadAxis, PadButton, events, payload}
use std::net::{Log, OUTDATED, Reduce, Verdict, close, open, relay, send}
use ui::draw::{DrawList, Rect, Renderer}
use ui::kit
use ui::kit::{State, Variant}
use ui::text::{Face, Fonts}
use rooms::{CODE_LEN, CODE_LETTERS, FIGHT_ROOM, ISLAND_ROOM, party_code, party_room}

/// The wrela account, which the page that plays the client keeps (console/account.wrela): its chip
/// in the corner, and its pages (signing in, making an account, its name, its recovery codes)
/// over the game while they're open.
pub trait Account {
    /// Takes an input event, if it's the account's: every one while its pages are open.
    fn event(mut self, e: Event) -> bool
    /// Draws its chip, and its pages if they're open, over the game in `list`.
    fn draw(mut self, list: mut DrawList, fonts: Fonts, width: u32, height: u32)
    /// Opens its pages: to make an account (`create`), or to sign in.
    fn open(mut self, create: bool)
    /// Whether its pages are open.
    fn shown(self) -> bool
    /// Who is signed in, said so that it changes when someone signs in, out, or keeps a name.
    fn who(self) -> String
}

// The title's choices, for a player who isn't signed in.
const MAKE: u32 = 0
const SIGN_IN: u32 = 1
const AS_GUEST: u32 = 2
const CHOICES: [Text; 3] = ["Create an account", "Sign in", "Play as a guest"]

// Its connections.
const ISLAND: u32 = 1
const FIGHT: u32 = 2
const RELAY: u32 = 3

/// Seconds between a closed connection and the next try.
const RETRY: f32 = 2.0
/// Seconds between steps proposed on the island, and its walking speed in units a second.
const STEP_EVERY: f32 = 0.5
const WALK_SPEED: f32 = 40.0
/// Frames of fight kept to roll back to (four seconds).
const RING: u32 = 240
/// Frames between the worlds kept for a rollback older than `RING` (ten seconds).
const CHECKPOINT: u32 = 600
/// Seconds a fight's outcome stays on screen.
const OUTCOME_SECONDS: f32 = 5.0
/// The most fight frames a screen frame runs: a tab that fell behind catches up over a few.
const MOST_STEPS: u32 = 30
/// Frames run in one frame while a player who came back runs again what it played before.
const REPLAY_STEPS: u32 = 120
/// Seconds a player who came back waits for the others' logs before it runs the fight anyway,
/// and for its own log to be handed to it before it settles the fight (no one else is left:
/// the room's `HANDOFF_MS`, and a little).
const CATCH_UP_SECONDS: f32 = 20.0
const HANDOFF_SECONDS: f32 = 12.0
/// Seconds between a waiting player's joins (the lobby forgets one silent for a minute), and
/// between proposals to settle a fight that's taking too long (the room says when it may).
const REJOIN: f32 = 30.0
const SETTLE_EVERY: f32 = 15.0
/// Seconds between tellings of who this player is, until the island shows it.
const WEAR_EVERY: f32 = 3.0
/// Tellings of who this player is before giving up (the island refused it), until it changes.
const WEAR_TRIES: u32 = 5
/// Seconds between the island's "still here" steps (`island::main::HERE_MS`).
const HERE_EVERY: f32 = 45.0
const NONE: u32 = 4294967295

// Held keys and buttons, as bits.
const LEFT: u32 = 1
const RIGHT: u32 = 2
const UP: u32 = 4
const DOWN: u32 = 8
const HIT: u32 = 16
const GUARD: u32 = 32
const EVADE: u32 = 64
const STRONG: u32 = 128

const BG = vec4(0.06, 0.07, 0.09, 1.0)
const SEA = vec4(0.07, 0.16, 0.24, 1.0)
const SAND = vec4(0.55, 0.5, 0.36, 1.0)
const INK = vec4(0.95, 0.95, 0.95, 1.0)
const MUTED = vec4(0.65, 0.66, 0.7, 1.0)
const MINE = vec4(0.98, 0.78, 0.3, 1.0)
const OTHER = vec4(0.45, 0.75, 0.98, 1.0)
const MARK = vec4(0.9, 0.35, 0.3, 1.0)
const BOSS = vec4(0.62, 0.3, 0.75, 1.0)
const TELL = vec4(0.98, 0.25, 0.2, 1.0)

/// A connection's state.
struct Conn: Copy {
    open: bool,
    opening: bool,
    retry_at: f32,
}

fn closed_conn() -> Conn {
    Conn { open: false, opening: false, retry_at: 0.0 }
}

/// A fight this client plays in: the fight as it runs here, what it's kept to roll back, and its
/// inputs, sent and heard.
struct Play {
    began: u64,
    slot: u32,
    party: Vec<u32>,
    world: World,
    /// The frame next to step.
    frame: u32,
    /// The world before each of the last `RING` frames, and before every `CHECKPOINT`th.
    snaps: Vec<World>,
    checkpoints: Vec<World>,
    /// This player's input at each frame, and its changes (its log).
    mine: Vec<u32>,
    log: Vec<Change>,
    link: Link,
    enc: Encoder,
    prev: u32,
    /// The first frame whose inputs changed since it was stepped (`NONE`: none).
    back: u32,
    /// When this client began it (seconds): frame `n` is due `n / 60` seconds on.
    start: Option<f32>,
    logged: bool,
    /// When the room settled it (seconds), once it has.
    settled_at: Option<f32>,
    /// How the room settled it, once it has: what counts, whatever this client ran.
    settled: Option<Winner>,
    rollbacks: u32,
    /// Each slot's log as the room picked it up when its player came back (`Act::Rejoin`), and
    /// the frame it stands until (`cuts`): `UNCUT` while its player never left (what's heard is
    /// its log), `HANDING` while the room waits for it (what was heard before stands, `bases`).
    bases: Vec<Vec<Change>>,
    cuts: Vec<u32>,
    /// For each slot, when (room ms) the player who came back to it was handed its log by this
    /// one, so it's offered once.
    offered: Vec<u64>,
    /// Whether this player came back to the fight and waits for its own log to be handed to it
    /// (meanwhile it hands no one theirs: it hasn't heard them yet), sending acks at frame `idle`
    /// (what the others said they're at), since `waited` (seconds), and when it next may settle
    /// the fight if no one does (`settle_at`).
    waiting: bool,
    idle: u32,
    waited: Option<f32>,
    settle_at: f32,
    /// How many changes of its own log were handed back to it: the room's log of it holds them.
    kept: u32,
}

pub struct Client {
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    island: Option<Log<Island, island::main::Act>>,
    fight: Option<Log<Fight, combat::main::Act>>,
    island_conn: Conn,
    fight_conn: Conn,
    relay_conn: Conn,
    held: u32,
    stick: vec2,
    walk: vec2,
    step_at: f32,
    play: Option<Play>,
    last_began: u64,
    joined_at: f32,
    /// The room time the last fight this player played to its end finished at, once its client
    /// said it's still there for the next (`AGAIN_MS`), and whether it's back at the doors.
    again_for: u64,
    again: bool,
    settle_at: f32,
    /// When this page next asks to come back to a fight it left (`Act::Rejoin`).
    rejoin_at: f32,
    time: Option<f32>,
    note: String,
    character: Option<Character>,
    wear_at: f32,
    /// The card last told the island, and how many times.
    told: Option<Card>,
    tellings: u32,
    /// Who the account said is signed in (`Account::who`): the character is asked again when it
    /// changes.
    who: Option<String>,
    /// The title's choices: whether the player chose to play as a guest, the one focused, where
    /// each was drawn, and the pointer.
    guest: bool,
    focus: u32,
    choices: Vec<(u32, Rect)>,
    pointer: Option<vec2>,
    /// How far each choice's hover has eased in, the one the pointer pressed, whether the keyboard
    /// (or a pad) moved the focus last, so its ring shows, and the frame's seconds.
    hovers: Vec<f32>,
    pressed: Option<u32>,
    /// The maker's controls as last drawn (`MAKER_*`), and how far each one's hover has eased in.
    maker: Vec<(u32, Rect)>,
    maker_hovers: Vec<f32>,
    keyboard: bool,
    dt: f32,
    /// The account's pages are over the game: it draws without its words.
    hushed: bool,
    /// Whether it proposed something on the island this frame, and when it next says it's still
    /// there if it says nothing else.
    said: bool,
    here_at: f32,
    /// The page's origin, for an invite link (`https://wrela.dev`).
    origin: String,
    /// This page's token (`token_of`), and the party it fights with (its code; none: the shared
    /// fight room), and whether its fight connection is closing to change room, its messages
    /// dropped until it's closed.
    token: u64,
    party: Option<String>,
    switching: bool,
    /// The invite link made (P), shown until the party's fight begins, and its copy.
    invite: String,
    copying: Option<std::io::Pending<u8>>,
    copied: bool,
    /// Whether the server runs another build than this page (a deploy since it loaded,
    /// `std::net::OUTDATED`): no room opens again, so it stops trying, and the page reloads once
    /// no fight is being played (`reload_due`).
    outdated: bool,
    /// When it heard so: a fight being played ends `OUTDATED_FIGHT` seconds on, if not before,
    /// since the others' inputs can't come.
    outdated_at: f32,
    /// Whether the island connection opened and the room hasn't spoken on it yet.
    rejoined: bool,
}

/// How long a fight goes on once the room's build is another (`outdated`), in seconds.
const OUTDATED_FIGHT: f32 = 30.0

/// A client on the page at `origin` (`https://wrela.dev`), which its invite links start with.
pub fn init(origin: str) -> Client {
    let fonts = Fonts::load()
    let renderer = Renderer::new(fonts)
    Client {
        fonts,
        renderer,
        list: DrawList::new(),
        island: None,
        fight: None,
        island_conn: closed_conn(),
        fight_conn: closed_conn(),
        relay_conn: closed_conn(),
        held: 0,
        stick: vec2(0.0, 0.0),
        walk: vec2(0.0, 0.0),
        step_at: 0.0,
        play: None,
        last_began: 0,
        joined_at: 0.0,
        again_for: 0,
        again: false,
        settle_at: 0.0,
        rejoin_at: 0.0,
        time: None,
        note: String::from("Connecting…"),
        character: None,
        wear_at: 0.0,
        told: None,
        tellings: 0,
        who: None,
        guest: false,
        focus: MAKE,
        choices: Vec::new(),
        pointer: None,
        hovers: Vec::from([0.0, 0.0, 0.0]),
        pressed: None,
        maker: Vec::new(),
        maker_hovers: Vec::new(),
        keyboard: false,
        dt: 0.0,
        hushed: false,
        said: false,
        here_at: 0.0,
        origin: String::from(origin),
        token: 0,
        party: None,
        switching: false,
        invite: String::new(),
        copying: None,
        copied: false,
        outdated: false,
        outdated_at: 0.0,
        rejoined: false,
    }
}

/// Whether the page should load the new version now: the server runs another build
/// (`outdated`), and no fight is being played nor a character being made here.
pub fn reload_due(s: Client) -> bool {
    s.outdated && s.play.is_none() && !maker_open(s)
}

/// The party this client fights with, as an address's fragment (`#party-<code>`), so a reload
/// comes back to it; none for the shared fight room.
pub fn party_fragment(s: Client) -> Option<String> {
    match s.party.clone() {
        Some(code) => {
            let room = party_room(code.as_str())
            Some(String::from(f"#{room}"))
        },
        None => None,
    }
}

/// The fight room this client fights in: its party's, or the shared one.
fn fight_room(s: Client) -> String {
    match s.party {
        Some(code) => party_room(code.as_str()),
        None => String::from(FIGHT_ROOM),
    }
}

/// Fights with the party whose code is `code` (an invite link's) from now on, if it's a code and
/// no fight holds this client: its fight connection closes and opens to the party's room.
pub fn join_party(s: mut Client, code: str) -> bool {
    if !party_code(code) || s.play.is_some() {
        return false
    }
    if s.party == Some(String::from(code)) {
        return true
    }
    s.party = Some(String::from(code))
    if s.fight_conn.open || s.fight_conn.opening {
        // The old room's messages are dropped until its close comes; then a fresh log opens.
        s.switching = true
        close(FIGHT)
    } else if s.token != 0 {
        s.fight = Some(Log::new(Fight::empty(), s.token))
    }
    true
}

/// The fragment of an address that opens a party's room: `#party-<code>`, its code.
pub fn party_of_address(address: [u8]) -> Option<String> {
    var at = address.len()
    for i in 0..address.len() {
        if address[i] == 35 {
            at = i + 1
            break
        }
    }
    if at >= address.len() {
        return None
    }
    var tail: Vec<u8> = Vec::new()
    for i in at..address.len() {
        tail.push(address[i])
    }
    let Some(text) = String::from_utf8(take tail) else { return None }
    rooms::code_of(text.as_str())
}

/// A new party's code, from this page's token and the moment: `CODE_LEN` of `CODE_LETTERS`.
fn new_code(token: u64, time: f32) -> String {
    var h = Hasher::new()
    h.write_u64(token)
    h.write_u32(u32(fract(time) * 16777216.0))
    h.write_u32(u32(time * 1000.0))
    var x = h.finish()
    var out = String::new()
    for _ in 0..CODE_LEN {
        let k = u32(x & 31)
        out.push_str(CODE_LETTERS.slice(k, k + 1))
        x = x >> 5
    }
    out
}

/// P: a new party for this client, whose link it shows and copies for a friend to open.
fn invite(s: mut Client, time: f32) {
    let code = new_code(s.token, time)
    if !join_party(mut s, code.as_str()) {
        return
    }
    s.invite = String::from(f"{s.origin}/#{party_room(code.as_str())}")
    s.copied = false
    s.copying = Some(std::host::copy(s.invite.as_str()))
}

/// A token for this page: a number from the moment it started, which the rooms know it by while
/// it's open. (Accounts will give a player one that lasts.)
fn token_of(time: f32, width: u32, height: u32) -> u64 {
    var h = Hasher::new()
    h.write_u32(u32(fract(time) * 16777216.0))
    h.write_u32(u32(time * 1000.0))
    h.write_u32(width)
    h.write_u32(height)
    let t = h.finish()
    if t == 0 { 1 } else { t }
}

fn key_bit(key: Key) -> u32 {
    if key == Key::A || key == Key::Left {
        LEFT
    } else if key == Key::D || key == Key::Right {
        RIGHT
    } else if key == Key::W || key == Key::Up {
        UP
    } else if key == Key::S || key == Key::Down {
        DOWN
    } else if key == Key::J || key == Key::Space {
        HIT
    } else if key == Key::I {
        STRONG
    } else if key == Key::K {
        GUARD
    } else if key == Key::L || key == Key::ShiftLeft || key == Key::ShiftRight {
        EVADE
    } else {
        0
    }
}

fn pad_bit(button: PadButton) -> u32 {
    if button == PadButton::West {
        HIT
    } else if button == PadButton::East {
        STRONG
    } else if button == PadButton::North {
        GUARD
    } else if button == PadButton::South {
        EVADE
    } else if button == PadButton::Left {
        LEFT
    } else if button == PadButton::Right {
        RIGHT
    } else if button == PadButton::Up {
        UP
    } else if button == PadButton::Down {
        DOWN
    } else {
        0
    }
}

/// The pad as the fight reads it: the stick (keys or the left stick; `z` away from the player)
/// and the buttons held.
fn pad_of(held: u32, stick: vec2) -> Pad {
    var x = stick.x
    var z = -stick.y
    if held & LEFT != 0 {
        x -= 1.0
    }
    if held & RIGHT != 0 {
        x += 1.0
    }
    if held & UP != 0 {
        z += 1.0
    }
    if held & DOWN != 0 {
        z -= 1.0
    }
    let m = sqrt(x * x + z * z)
    if m > 1.0 {
        x = x / m
        z = z / m
    }
    var buttons: u32 = 0
    if held & HIT != 0 {
        buttons = buttons | ATTACK
    }
    if held & GUARD != 0 {
        buttons = buttons | PARRY
    }
    if held & EVADE != 0 {
        buttons = buttons | DODGE
    }
    if held & STRONG != 0 {
        buttons = buttons | HEAVY
    }
    Pad { x, z, held: buttons }
}

fn send_all(conn: u32, messages: Vec<Vec<u8>>) {
    for m in messages {
        send(conn, m)
    }
}

/// The party slot of peer `peer`.
fn slot_of(party: [u32], peer: u32) -> Option<u32> {
    for i in 0..party.len() {
        if party[i] == peer {
            return Some(i)
        }
    }
    None
}

// ---- a fight ------------------------------------------------------------------------------------

/// A fight that began at `began`, this player in `slot` of `party`, its players bringing `armed`
/// (the room's, so every peer's fight is the room's).
fn new_play(began: u64, slot: u32, party: take Vec<u32>, armed: [u32]) -> Play {
    let n = party.len()
    let world = World::armed(armed)
    var snaps: Vec<World> = Vec::new()
    for _ in 0..RING {
        snaps.push(world.clone())
    }
    Play {
        began,
        slot,
        party,
        world,
        frame: 0,
        snaps,
        checkpoints: Vec::new(),
        mine: Vec::new(),
        log: Vec::new(),
        link: Link::new(slot, n),
        enc: Encoder::new(),
        prev: 0,
        back: NONE,
        start: None,
        logged: false,
        settled_at: None,
        settled: None,
        rollbacks: 0,
        bases: fill(n, Vec::new()),
        cuts: fill(n, UNCUT),
        offered: fill(n, u64(0)),
        waiting: false,
        settle_at: 0.0,
        kept: 0,
        idle: 0,
        waited: None,
    }
}

/// `n` of `v`.
fn fill<T: Clone>(n: u32, v: T) -> Vec<T> {
    var out: Vec<T> = Vec::new()
    for _ in 0..n {
        out.push(v.clone())
    }
    out
}

/// The input of `log` at `frame`: its last change at or before it.
fn input_in(log: [Change], frame: u32) -> u32 {
    var lo: u32 = 0
    var hi = log.len()
    while lo < hi {
        let mid = (lo + hi) / 2
        if log[mid].frame <= frame {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == 0 { 0 } else { log[lo - 1].input }
}

/// Slot `j`'s input at frame `f` (another player's), as this client knows it: what's heard, or
/// for a player who came back, the log the room picked up, then what it sent since.
fn input_of(p: Play, j: u32, f: u32) -> u32 {
    let cut = p.cuts[j]
    if cut == UNCUT {
        return p.link.at(j, f)
    }
    if cut == HANDING || f < cut {
        return input_in(p.bases[j], f)
    }
    match p.link.change_at(j, f) {
        Some(c) => if c.frame >= cut { c.input } else { input_in(p.bases[j], f) },
        None => input_in(p.bases[j], f),
    }
}

/// Slot `j`'s log (another player's) before frame `upto`, as this client knows it.
fn history(p: Play, j: u32, upto: u32) -> Vec<Change> {
    let none: Vec<Change> = Vec::new()
    let cut = p.cuts[j]
    if cut == UNCUT {
        return combat::sim::spliced(p.link.log(j), NONE, none, upto)
    }
    if cut == HANDING {
        return combat::sim::spliced(p.bases[j], NONE, none, upto)
    }
    combat::sim::spliced(p.bases[j], cut, p.link.log(j), upto)
}

/// The first frame whose input differs between logs `a` and `b` (`NONE`: none).
fn first_difference(a: [Change], b: [Change]) -> u32 {
    var k: u32 = 0
    loop {
        let in_a = k < a.len()
        let in_b = k < b.len()
        if !in_a && !in_b {
            return NONE
        }
        if in_a && in_b && a[k] == b[k] {
            k += 1
            continue
        }
        var f = NONE
        if in_a {
            f = a[k].frame
        }
        if in_b && b[k].frame < f {
            f = b[k].frame
        }
        return f
    }
}

/// The fight as its room has it now (`room`, this player peer `me`): a player who came back to a
/// slot is heard from again and sent everything, and once its log is handed to the room, it's
/// what the fight runs from (rolling back if it isn't what was heard). Whether this player is
/// still in the fight (not if it came back to it on another page), and the handoff it offers, if
/// the room waits for one: what it heard of that player.
fn follow(p: mut Play, room: Fight, me: u32) -> (bool, Option<combat::main::Act>) {
    if room.began_at != p.began || !room.on() || room.party.len() != p.party.len() {
        return (true, None)
    }
    if room.party[p.slot] != me {
        return (false, None)
    }
    var offer: Option<combat::main::Act> = None
    for j in 0..p.party.len() {
        if j == p.slot {
            continue
        }
        if room.party[j] != p.party[j] {
            // Its player came back on a new page: what was heard of it stands until the room
            // picks its log up.
            let heard = history(p, j, NONE)
            p.bases[j] = take heard
            p.cuts[j] = HANDING
            p.party[j] = room.party[j]
            p.link.fresh(j)
        }
        let cut = room.cuts[j]
        if cut != HANDING && cut != UNCUT && p.cuts[j] != cut {
            let was = history(p, j, NONE)
            p.bases[j] = room.logs[j].changes.clone()
            p.cuts[j] = cut
            let now = history(p, j, NONE)
            let d = first_difference(was, now)
            if d < p.back {
                p.back = d
            }
        }
        if cut == HANDING && !p.waiting && offer.is_none() && p.offered[j] != room.rejoined_at[j] {
            p.offered[j] = room.rejoined_at[j]
            let upto = p.frame
            offer = Some(combat::main::Act::Handoff { slot: j, changes: history(p, j, upto), upto })
        }
    }
    (true, offer)
}

/// The frame the others said they're at: where a player who came back picks the fight up.
fn others_at(p: Play) -> u32 {
    var most: u32 = 0
    for j in 0..p.party.len() {
        if j != p.slot && p.link.through(j) > most {
            most = p.link.through(j)
        }
    }
    most
}

/// This player came back to the fight, and its log so far is `base`, standing until `cut`: it
/// runs the fight from the start, its own input as the log says until frame `from` (where the
/// others are), then from the pad again, clock time `time`.
fn pick_up(p: mut Play, base: [Change], cut: u32, time: f32) {
    let from = max(max(cut, p.idle), others_at(p))
    p.mine = Vec::new()
    for f in 0..from {
        p.mine.push(input_in(base, f))
    }
    p.prev = input_in(base, from)
    p.link.resume(from, p.prev)
    // The room's log of it holds the changes handed back too.
    p.kept = 0
    for c in base {
        if c.frame < cut {
            p.kept += 1
        }
    }
    p.start = Some(time - f32(from) / 60.0)
    p.waiting = false
}

/// Every player's input at frame `f`, as this client knows them.
fn inputs_at(p: Play, f: u32) -> Vec<u32> {
    var ins: Vec<u32> = Vec::new()
    for j in 0..p.party.len() {
        if j == p.slot {
            ins.push(if f < p.mine.len() { p.mine[f] } else { p.prev })
        } else {
            ins.push(input_of(p, j, f))
        }
    }
    ins
}

/// Keeps `w`, the world before frame `f`, to roll back to.
fn keep(p: mut Play, f: u32, w: World) {
    p.snaps[f % RING] = w.clone()
    if f % CHECKPOINT == 0 {
        let k = f / CHECKPOINT
        if k < p.checkpoints.len() {
            p.checkpoints[k] = w.clone()
        } else {
            p.checkpoints.push(w.clone())
        }
    }
}

/// The fight again from the first frame whose inputs changed: from the world kept before it, or
/// from the checkpoint before it if it's older than the ring (every input is still known).
fn roll_back(p: mut Play) {
    var from = p.back
    p.back = NONE
    if from >= p.frame {
        return
    }
    var w = if p.frame - from >= RING {
        from = from / CHECKPOINT * CHECKPOINT
        p.checkpoints[from / CHECKPOINT].clone()
    } else {
        p.snaps[from % RING].clone()
    }
    for g in from..p.frame {
        keep(mut p, g, w)
        let ins = inputs_at(p, g)
        step(mut w, ins)
    }
    p.world = take w
    p.rollbacks += 1
}

/// One frame of the fight: this player's input from the pad, then the step; the packet to send
/// on the relay, if one goes.
fn tick(p: mut Play, pad: Pad) -> Option<Vec<u8>> {
    let f = p.frame
    if f >= MAX_FRAMES {
        return None
    }
    // A player who came back runs again what it played before: its input is known, and was sent.
    if f < p.mine.len() {
        let w = p.world.clone()
        keep(mut p, f, w)
        let ins = inputs_at(p, f)
        step(mut p.world, ins)
        p.frame += 1
        return None
    }
    // Once it's over, the input stands: what's sent past the end isn't the fight's. So it does
    // once a log is full.
    var input = p.prev
    if !p.world.over && p.log.len() + p.kept < PLAYER_CHANGES {
        var now = inputs_at(p, f)
        now[p.slot] = p.prev
        let ready = p.world.reads(p.slot)
        let reads = ready | p.world.soon(p.slot, now, LOOK_AHEAD)
        input = p.enc.input(pad, prev: p.prev, reads: reads, now: ready)
    }
    if input != p.prev {
        p.log.push(Change { frame: f, input })
    }
    p.prev = input
    p.mine.push(input)
    let out = p.link.send(f, input)
    let w = p.world.clone()
    keep(mut p, f, w)
    let ins = inputs_at(p, f)
    step(mut p.world, ins)
    p.frame += 1
    out
}

/// A packet from slot `slot` on the relay: the fight rolls back to the first frame it changes.
fn heard(p: mut Play, slot: u32, bytes: [u8]) {
    if let Some(f) = p.link.heard(slot, bytes, p.frame) {
        // What's sent by a player who came back counts from where its log was picked up.
        let cut = p.cuts[slot]
        let g = if cut == UNCUT { f } else if cut == HANDING { NONE } else { max(f, cut) }
        if g < p.back {
            p.back = g
        }
    }
}

// ---- the frame ----------------------------------------------------------------------------------

/// Opens connection `conn` to `room` when it's due.
fn keep_open(c: mut Conn, conn: u32, room: str, now: f32) {
    if !c.open && !c.opening && now >= c.retry_at {
        c.opening = true
        open(conn, room)
    }
}

/// One frame of the client, `account` over it: whether the pointer is over a choice it can press,
/// for the page's cursor.
pub fn frame<A: Account>(
    s: mut Client,
    time: f32,
    width: u32,
    height: u32,
    account: mut A,
) -> Option<bool> {
    let dt = match s.time {
        Some(t) => clamp(time - t, 0.0, 0.25),
        None => 0.0,
    }
    s.time = Some(time)
    s.dt = dt
    if s.island.is_none() {
        let token = token_of(time, width, height)
        s.token = token
        s.island = Some(Log::new(Island::empty(), token))
        s.fight = Some(Log::new(Fight::empty(), token))
    }
    if s.character.is_none() {
        s.character = Some(character::start())
    }
    // Someone signed in, out, or kept their name: their character is asked for again.
    let who = account.who()
    let changed = match s.who {
        Some(w) => w != who,
        None => false,
    }
    if changed {
        s.character = Some(character::start())
        s.told = None
        s.guest = false
        s.focus = MAKE
    }
    s.who = Some(take who)
    match mut s.character {
        Some(c) => character::update(mut c),
        None => {},
    }
    let making = maker_open(s)
    let titled = title_shown(s)
    if !s.outdated {
        keep_open(mut s.island_conn, ISLAND, ISLAND_ROOM, time)
        let fight_name = fight_room(s)
        keep_open(mut s.fight_conn, FIGHT, fight_name.as_str(), time)
    }
    let copy = match mut s.copying {
        Some(p) => p.poll(),
        None => None,
    }
    if let Some(done) = copy {
        s.copying = None
        s.copied = done.is_ok()
    }
    var pressed_join = false
    var pressed_invite = false
    var pressed_begin = false
    var pressed_mark = false
    var pressed_change = false
    var maker_dx: i32 = 0
    var maker_dy: i32 = 0
    var maker_enter = false
    var maker_escape = false
    for e in events() {
        let net = match e {
            Event::Connection { .. } => true,
            Event::Message { .. } => true,
            _ => false,
        }
        // The account's pages take what's theirs (every input while open); the title, the rest.
        if !net && account.event(e) {
            continue
        }
        if !net && titled {
            title_event(mut s, e, mut account)
            continue
        }
        match e {
            Event::Connection { conn, open, tag } => {
                if !open && tag == OUTDATED && !s.outdated {
                    s.outdated = true
                    s.outdated_at = time
                }
                connection(mut s, conn, open, time)
            },
            Event::Message { conn, .. } => {
                let Some(bytes) = payload(e) else { continue }
                message(mut s, conn, take bytes)
            },
            Event::PointerMove { at, .. } if making => {
                s.pointer = Some(at)
                s.keyboard = false
            },
            Event::PointerDown { at, button: Button::Primary, .. } if making => {
                s.pressed = maker_at(s, at)
            },
            Event::PointerUp { at, button: Button::Primary, .. } if making => {
                let was = s.pressed
                s.pressed = None
                let on = maker_at(s, at)
                let Some(hit) = on else { continue }
                if was != on {
                    continue
                }
                let part = match s.character {
                    Some(c) => c.part,
                    None => 0,
                }
                // A click says what it means outright (this part, this change), so it doesn't
                // add up with another input of the same frame: the last says.
                if hit < MAKER_SAVE {
                    // A part's ‹ or ›: that part, one choice back or on.
                    maker_dy = i32(hit / 2) - i32(part)
                    maker_dx = if hit % 2 == 0 { -1 } else { 1 }
                } else if hit == MAKER_SAVE {
                    maker_enter = true
                } else if hit == MAKER_LEAVE {
                    maker_escape = true
                } else {
                    maker_dy = i32(hit - MAKER_ROW) - i32(part)
                    maker_dx = 0
                }
            },
            Event::KeyDown { key, .. } if making => {
                s.keyboard = true
                let bit = key_bit(key)
                if bit == LEFT {
                    maker_dx -= 1
                } else if bit == RIGHT {
                    maker_dx += 1
                } else if bit == UP {
                    maker_dy -= 1
                } else if bit == DOWN {
                    maker_dy += 1
                }
                if key == Key::Enter {
                    maker_enter = true
                }
                if key == Key::Escape {
                    maker_escape = true
                }
            },
            Event::KeyDown { key, repeat, .. } => {
                s.held = s.held | key_bit(key)
                if !repeat {
                    if key == Key::C {
                        pressed_change = true
                    }
                    if key == Key::F {
                        pressed_join = true
                    }
                    if key == Key::Enter {
                        pressed_begin = true
                    }
                    if key == Key::E {
                        pressed_mark = true
                    }
                    if key == Key::P {
                        pressed_invite = true
                    }
                }
            },
            Event::KeyUp { key, .. } => s.held = s.held & !key_bit(key),
            Event::PadButton { button, pressed, .. } => {
                let bit = pad_bit(button)
                s.held = if pressed { s.held | bit } else { s.held & !bit }
                if pressed && button == PadButton::Select {
                    pressed_join = true
                }
                if pressed && button == PadButton::Start {
                    pressed_begin = true
                }
                if pressed && button == PadButton::East {
                    pressed_mark = true
                }
            },
            Event::PadAxis { axis, value, .. } => {
                if axis == PadAxis::LeftX {
                    s.stick.x = value
                }
                if axis == PadAxis::LeftY {
                    s.stick.y = value
                }
            },
            _ => {},
        }
    }
    // The relay, once the fight room knows this peer.
    let known = match s.fight {
        Some(l) => l.peer() != 0,
        None => false,
    }
    if s.fight_conn.open &&
        known &&
        !s.relay_conn.open &&
        !s.relay_conn.opening &&
        time >= s.relay_conn.retry_at {
        s.relay_conn.opening = true
        relay(RELAY, FIGHT)
    }
    if account.shown() || titled {
        // Nothing walks or fights under the account's pages or the title.
        s.held = 0
        s.stick = vec2(0.0, 0.0)
    }
    if making {
        // The maker has the keys: nothing walks or fights meanwhile.
        s.held = 0
        match mut s.character {
            Some(c) => character::keys(mut c, maker_dx, maker_dy, maker_enter, maker_escape),
            None => {},
        }
    }
    // Not while waiting for a fight: the maker would hide one that begins.
    let waiting = match s.fight {
        Some(l) => l.view().waiting(l.peer()),
        None => false,
    }
    if pressed_invite && s.play.is_none() && !waiting && !maker_open(s) {
        invite(mut s, time)
    }
    if pressed_change && s.play.is_none() && !waiting {
        match mut s.character {
            Some(c) => character::change(mut c),
            None => {},
        }
    }
    let pad = pad_of(s.held, s.stick)
    if !maker_open(s) {
        if s.play.is_some() {
            fight_frame(mut s, pad, dt, time)
        } else {
            island_frame(mut s, pad, dt, time, pressed_join, pressed_begin, pressed_mark)
        }
    }
    still_here(mut s, time)
    draw(mut s, width, height, mut account)
    if account.shown() {
        return Some(false)
    }
    // A hand over what can be pressed: the title's choices, the maker's controls.
    let over = match s.pointer {
        Some(p) => if title_shown(s) { choice_at(s, p).is_some() } else if maker_open(s) {
            match maker_at(s, p) {
                Some(hit) => hit < MAKER_ROW,
                None => false,
            }
        } else { false },
        None => false,
    }
    Some(over)
}

// ---- the title ----------------------------------------------------------------------------------

/// Whether the title has the screen: while the client asks who the player is, and for a player
/// who isn't signed in until they choose to play as a guest.
fn title_shown(s: Client) -> bool {
    if s.guest {
        return false
    }
    match s.character {
        Some(c) => c.stage == Stage::Asking || (c.stage == Stage::Guest && c.why == Why::SignedOut),
        None => true,
    }
}

/// Whether the title shows its choices: once the client knows the player isn't signed in.
fn choosing(s: Client) -> bool {
    match s.character {
        Some(c) => c.stage == Stage::Guest,
        None => false,
    }
}

/// The choice drawn under `at`, if one is.
fn choice_at(s: Client, at: vec2) -> Option<u32> {
    for (c, r) in s.choices {
        if r.contains(at) {
            return Some(c)
        }
    }
    None
}

/// An input on the title: the pointer chooses, and so do the arrows (or a pad) and Enter.
fn title_event<A: Account>(s: mut Client, e: Event, account: mut A) {
    if !choosing(s) {
        return
    }
    var chosen: Option<u32> = None
    match e {
        Event::PointerMove { at, .. } => {
            s.pointer = Some(at)
            s.keyboard = false
        },
        Event::PointerDown { at, button: Button::Primary, .. } => {
            s.pressed = choice_at(s, at)
            if let Some(c) = s.pressed {
                // As a page's button takes the focus when clicked, without showing its ring.
                s.focus = c
            }
        },
        Event::PointerUp { at, button: Button::Primary, .. } => {
            let was = s.pressed
            s.pressed = None
            let on = choice_at(s, at)
            if on.is_some() && on == was {
                chosen = on
            }
        },
        Event::KeyDown { key, repeat, mods } => {
            s.keyboard = true
            if key == Key::Down || key == Key::S || (key == Key::Tab && !mods.shift) {
                s.focus = (s.focus + 1) % 3
            } else if key == Key::Up || key == Key::W || (key == Key::Tab && mods.shift) {
                s.focus = (s.focus + 2) % 3
            } else if (key == Key::Enter || key == Key::Space) && !repeat {
                chosen = Some(s.focus)
            }
        },
        Event::PadButton { button, pressed: true, .. } => {
            s.keyboard = true
            if button == PadButton::Down {
                s.focus = (s.focus + 1) % 3
            } else if button == PadButton::Up {
                s.focus = (s.focus + 2) % 3
            } else if button == PadButton::South || button == PadButton::Start {
                chosen = Some(s.focus)
            }
        },
        _ => {},
    }
    let Some(c) = chosen else { return }
    if c == MAKE {
        account.open(true)
    } else if c == SIGN_IN {
        account.open(false)
    } else if c == AS_GUEST {
        s.guest = true
    }
}

/// Tells the island this player is still there (a step of nothing) when it said nothing else for
/// a while, in the maker and in a fight too: a body quiet too long isn't shown (`Island::present`).
fn still_here(s: mut Client, time: f32) {
    if s.said {
        s.said = false
        s.here_at = time + HERE_EVERY
    } else if s.island_conn.open && time >= s.here_at && !title_shown(s) {
        propose_island(mut s, island::main::Act::Step { dx: 0, dz: 0 })
    }
}

/// Closes what the client opened: its rooms and the relay. The page shows something else.
pub fn close_all(s: mut Client) {
    if s.island_conn.open || s.island_conn.opening {
        close(ISLAND)
    }
    if s.fight_conn.open || s.fight_conn.opening {
        close(FIGHT)
    }
    if s.relay_conn.open || s.relay_conn.opening {
        close(RELAY)
    }
}

/// Whether the character maker has the screen.
/// The maker's controls: part `p`'s ‹ is `2p` and its › `2p + 1`; then saving, leaving, and the
/// rows themselves from `MAKER_ROW`.
const MAKER_SAVE: u32 = 8
const MAKER_LEAVE: u32 = 9
const MAKER_ROW: u32 = 10

/// The maker's control drawn under `at`, if one is.
fn maker_at(s: Client, at: vec2) -> Option<u32> {
    // Last drawn on top: the buttons before the rows they sit in.
    for (c, r) in s.maker {
        if r.contains(at) {
            return Some(c)
        }
    }
    None
}

fn maker_open(s: Client) -> bool {
    match s.character {
        Some(c) => c.stage == Stage::Making || c.stage == Stage::Saving,
        None => false,
    }
}

/// A join of the fight room: the longsword, worn as the character, with its account's pass, so
/// the room knows who won (or as a guest).
fn join_act(s: Client) -> combat::main::Act {
    let (card, seal) = match s.character {
        Some(c) => character::card(c).unwrap_or(
            (island::main::NOBODY, island::main::sealed(false)),
        ),
        None => (island::main::NOBODY, island::main::sealed(false)),
    }
    combat::main::Act::Join { weapon: LONGSWORD, card, seal }
}

/// Whether this player won the last fight as its character: the room wrote it down, so its
/// account can count it.
fn won_as_me(s: Client, room: Fight) -> bool {
    let Some((card, _)) = (match s.character {
        Some(c) => character::card(c),
        None => None,
    }) else { return false }
    for w in room.winners() {
        if w == card {
            return true
        }
    }
    false
}

/// Tells the island who this player is, until its view shows it: the character's card.
fn wear(s: mut Client, time: f32) {
    let Some((card, seal)) = (match s.character {
        Some(c) => character::card(c),
        None => None,
    }) else { return }
    let (me, worn) = match s.island {
        Some(l) => (l.peer(), worn_by(l.view(), l.peer())),
        None => return,
    }
    if me == 0 || !s.island_conn.open || worn == Some(card) || time < s.wear_at {
        return
    }
    if s.told != Some(card) {
        s.told = Some(card)
        s.tellings = 0
    }
    if s.tellings >= WEAR_TRIES {
        return
    }
    s.tellings += 1
    s.wear_at = time + WEAR_EVERY
    propose_island(mut s, island::main::Act::Wear { card, seal })
}

/// The card peer `peer` wears on `island`, if it said who it is.
fn worn_by(island: Island, peer: u32) -> Option<Card> {
    for b in island.bodies {
        if b.peer == peer && b.worn {
            return Some(b.card)
        }
    }
    None
}

fn connection(s: mut Client, conn: u32, is_open: bool, time: f32) {
    if conn == ISLAND {
        s.island_conn = Conn { open: is_open, opening: false, retry_at: time + RETRY }
        match mut s.island {
            Some(l) => if is_open { send_all(ISLAND, l.connect()) } else { l.disconnect() },
            None => {},
        }
        // A reconnect (after a long while, or to a room a deploy started fresh): once the room
        // answers (a socket that only opens to close, as another build's does, never does), the
        // pass it wears may have expired, so it fetches another, and says who it is again.
        s.rejoined = is_open
    } else if conn == FIGHT {
        if s.switching && !is_open {
            // Closed to change room: the party's room opens now, with a fresh log.
            s.switching = false
            s.fight_conn = Conn { open: false, opening: false, retry_at: time }
            s.fight = Some(Log::new(Fight::empty(), s.token))
            if s.relay_conn.open || s.relay_conn.opening {
                close(RELAY)
            }
            return
        }
        s.fight_conn = Conn { open: is_open, opening: false, retry_at: time + RETRY }
        match mut s.fight {
            Some(l) => if is_open { send_all(FIGHT, l.connect()) } else { l.disconnect() },
            None => {},
        }
    } else if conn == RELAY {
        // A relay may join four times a minute: a closed one waits longer.
        s.relay_conn = Conn { open: is_open, opening: false, retry_at: time + 4.0 * RETRY }
    }
}

fn message(s: mut Client, conn: u32, bytes: take Vec<u8>) {
    if conn == ISLAND {
        if s.rejoined {
            s.rejoined = false
            s.told = None
            match mut s.character {
                Some(c) => character::refresh(mut c),
                None => {},
            }
        }
        match mut s.island {
            Some(l) => match l.receive(take bytes) {
                Ok(out) => send_all(ISLAND, out),
                Err(_) => close(ISLAND),
            },
            None => {},
        }
    } else if conn == FIGHT {
        if s.switching {
            // The room it's leaving: nothing it says counts now.
            return
        }
        match mut s.fight {
            Some(l) => match l.receive(take bytes) {
                Ok(out) => send_all(FIGHT, out),
                Err(_) => close(FIGHT),
            },
            None => {},
        }
    } else if conn == RELAY && bytes.len() >= 4 {
        let tag = u32(bytes[0]) |
            (u32(bytes[1]) << 8) |
            (u32(bytes[2]) << 16) |
            (u32(bytes[3]) << 24)
        var body: Vec<u8> = Vec::new()
        for i in 4..bytes.len() {
            body.push(bytes[i])
        }
        match mut s.play {
            Some(p) => {
                if let Some(slot) = slot_of(p.party, tag) {
                    heard(mut p, slot, body)
                }
            },
            None => {},
        }
    }
}

fn propose_island(s: mut Client, act: take island::main::Act) {
    s.said = true
    match mut s.island {
        Some(l) => if let Ok(out) = l.propose(take act) { send_all(ISLAND, out) },
        None => {},
    }
}

fn propose_fight(s: mut Client, act: take combat::main::Act) {
    match mut s.fight {
        Some(l) => if let Ok(out) = l.propose(take act) { send_all(FIGHT, out) },
        None => {},
    }
}

fn island_frame(s: mut Client, pad: Pad, dt: f32, time: f32, join: bool, begin: bool, mark: bool) {
    // Walking: the stick's way, a step proposed every `STEP_EVERY` seconds while it moves.
    s.walk = s.walk + vec2(pad.x, pad.z) * WALK_SPEED * dt
    if time >= s.step_at && (abs(s.walk.x) >= 1.0 || abs(s.walk.y) >= 1.0) {
        let most = f32(MAX_STEP)
        let dx = clamp(round(s.walk.x), -most, most)
        let dz = clamp(round(s.walk.y), -most, most)
        s.walk = s.walk - vec2(dx, dz)
        s.step_at = time + STEP_EVERY
        propose_island(mut s, island::main::Act::Step { dx: i32(dx), dz: i32(dz) })
    }
    if pad.x == 0.0 && pad.z == 0.0 {
        s.walk = vec2(0.0, 0.0)
    }
    if mark && s.island_conn.open {
        propose_island(mut s, island::main::Act::Place)
    }
    wear(mut s, time)
    // The fight room: wait, stop waiting, begin; and a fight that began for this player.
    let (me, view, room) = match s.fight {
        Some(l) => (l.peer(), l.view().clone(), l.committed().clone()),
        None => return,
    }
    // The room put this player back at the doors after a fight it played: say it's still here,
    // or the room lets it go (`combat::main::AGAIN_MS`).
    if me != 0 && room.fought_last(me) && view.waiting(me) && room.finished_at != s.again_for {
        s.again_for = room.finished_at
        s.again = true
        s.joined_at = time
        propose_fight(mut s, join_act(s))
    }
    if join && me != 0 {
        s.again = false
        if view.waiting(me) {
            propose_fight(mut s, combat::main::Act::Leave)
        } else {
            s.joined_at = time
            propose_fight(mut s, join_act(s))
        }
    }
    if begin && me != 0 && view.waiting(me) && !view.on() {
        propose_fight(mut s, combat::main::Act::Begin)
    }
    // Waiting goes on while this page is open: the lobby forgets a player silent a minute.
    if me != 0 && view.waiting(me) && !view.on() && time - s.joined_at > REJOIN {
        s.joined_at = time
        propose_fight(mut s, join_act(s))
    }
    // A fight whose players left holds the room: past the longest fight, anyone may settle it.
    if me != 0 && room.on() && slot_of(room.party, me).is_none() && time >= s.settle_at {
        s.settle_at = time + 4.0 * SETTLE_EVERY
        propose_fight(mut s, combat::main::Act::Settle)
    }
    // A fight this page never played that its character is in, still to send its log: the page
    // was reloaded mid-fight (or its connection lost), and it takes its place again.
    if room.on() &&
        room.began_at != s.last_began &&
        me != 0 &&
        slot_of(room.party, me).is_none() &&
        time >= s.rejoin_at {
        if let Some((card, seal)) = (match s.character {
            Some(c) => character::card(c),
            None => None,
        }) {
            if room.seat_of(card).is_some() {
                s.rejoin_at = time + 2.0 * RETRY
                propose_fight(mut s, combat::main::Act::Rejoin { card, seal })
            }
        }
    }
    if room.on() && room.began_at != s.last_began && me != 0 {
        if let Some(slot) = slot_of(room.party, me) {
            s.last_began = room.began_at
            s.again = false
            var p = new_play(room.began_at, slot, room.party.clone(), room.armed.clone())
            if room.cuts[slot] != UNCUT {
                // Back in it: its log so far comes from the others, through the room.
                p.waiting = true
            }
            s.play = Some(take p)
            // The party's fight began: its invite was used.
            s.invite = String::new()
        }
    }
    s.note = if s.outdated {
        String::from("Wrela was updated. Loading the new version… (or reload the page)")
    } else if !s.island_conn.open || !s.fight_conn.open {
        String::from("Connecting…")
    } else if room.on() {
        String::from(f"A fight is on ({room.party.len()} fighting).")
    } else if view.waiting(me) && s.again {
        // Back at the doors after a fight: the party waits again, one press from the next.
        String::from(
            f"Back at the doors ({view.lobby.len()} ready). Enter goes again, F stops waiting.",
        )
    } else if view.waiting(me) {
        String::from(
            f"Waiting for a fight with {view.lobby.len()}. Enter begins it, F stops waiting.",
        )
    } else if s.party.is_some() {
        String::from(
            f"Your party's room: F waits for a fight ({view.lobby.len()} waiting). P makes a new invite.",
        )
    } else {
        String::from(
            f"F waits for a fight ({view.lobby.len()} waiting). P invites a friend. E places a mark.",
        )
    }
    let connected = s.island_conn.open && s.fight_conn.open
    let inviting = connected && !s.invite.is_empty() && !room.on() && !view.waiting(me)
    if inviting {
        // Short, and alone, so the link fits: it's what the player came for.
        let how = if s.copied { "Invite link copied, send it to a friend" } else {
            "Send a friend this invite link"
        }
        s.note = String::from(f"{how}: {s.invite}  F waits for a fight.")
        return
    }
    match s.character {
        Some(c) => {
            let who = character::line(c)
            let won = if c.recorded.is_empty() { String::new() } else {
                String::from(f"{c.recorded}  ")
            }
            s.note = String::from(f"{won}{who}  {s.note}")
        },
        None => {},
    }
}

fn fight_frame(s: mut Client, pad: Pad, dt: f32, time: f32) {
    let room = match s.fight {
        Some(l) => l.committed().clone(),
        None => Fight::empty(),
    }
    let relay_open = s.relay_conn.open
    let outdated = s.outdated
    let cut = outdated && time - s.outdated_at > OUTDATED_FIGHT
    var log: Option<combat::main::Act> = None
    var settle = false
    var done = false
    // This fight, if its room settled it won with this player among the winners: its id, for
    // the account to record, asked as the room settles it (the next may begin at once).
    let won = room.settled && won_as_me(s, room)
    var record: Option<Vec<u8>> = None
    let fight_name = fight_room(s)
    let me = match s.fight {
        Some(l) => l.peer(),
        None => 0,
    }
    var offer: Option<combat::main::Act> = None
    var lost = false
    match mut s.play {
        Some(p) => {
            let (still, handoff) = follow(mut p, room, me)
            lost = !still
            offer = take handoff
        },
        None => {},
    }
    // Back to a fight it left, this player waits for its log so far, then runs the fight again.
    var waiting = false
    match mut s.play {
        Some(p) if p.waiting && !lost => {
            waiting = true
            let at = others_at(p)
            if at > p.idle {
                p.idle = at
            }
            let idle = p.idle
            let held = p.prev
            if let Some(bytes) = p.link.send(idle, held) {
                send(RELAY, bytes)
            }
            let since = match p.waited {
                Some(t) => t,
                None => time,
            }
            p.waited = Some(since)
            let cut = if room.began_at == p.began && room.on() && p.slot < room.cuts.len() {
                room.cuts[p.slot]
            } else { HANDING }
            if cut != HANDING && cut != UNCUT {
                // Once the others' logs are heard (each resent whole to it), or a while on.
                let known = p.link.known()
                let heard_all = known == NONE || known + 1 >= p.idle
                if heard_all || time - since > CATCH_UP_SECONDS {
                    borrow base = room.logs[p.slot].changes
                    pick_up(mut p, base, cut, time)
                }
            } else if time - since > HANDOFF_SECONDS && time >= p.settle_at && room.on() {
                // No one handed it its log: no one else is left, and the fight is settled.
                p.settle_at = time + SETTLE_EVERY
                settle = true
            }
            if room.began_at != p.began || room.settled {
                done = true
            }
            s.note = String::from("Back in your fight: catching up with your party…")
        },
        _ => {},
    }
    match mut s.play {
        Some(p) if !waiting && !lost => {
            if p.back != NONE {
                roll_back(mut p)
            }
            // Frames keep to the clock, so a client that fell behind (a hidden tab, a hitch)
            // catches up rather than staying behind the others.
            let start = match p.start {
                Some(t) => t,
                None => time,
            }
            p.start = Some(start)
            let due = u32(max(time - start, 0.0) * 60.0)
            var steps: u32 = 0
            // What it played before it left runs quicker (nothing's sent): it catches up.
            let most = if p.frame < p.mine.len() { REPLAY_STEPS } else { MOST_STEPS }
            while p.frame < due && steps < most {
                if let Some(bytes) = tick(mut p, pad) {
                    send(RELAY, bytes)
                }
                steps += 1
            }
            // Over once every input it was run from is heard (before, a late one may undo it), or
            // five seconds on, when a player who's quiet has likely left.
            // A party of one hears no one: then nothing is waited for (`known` is `NONE`).
            let known = p.link.known()
            let heard_all = known == NONE || known + 1 >= p.world.frame
            if p.world.over && !p.logged && (heard_all || p.frame >= p.world.frame + 300) {
                p.logged = true
                // A change at or past the end, made while a late input hadn't ended it yet here,
                // isn't the fight's.
                var changes: Vec<Change> = Vec::new()
                for c in p.log.clone() {
                    if c.frame < p.world.frame {
                        changes.push(c.clone())
                    }
                }
                log = Some(combat::main::Act::Log { changes, end: p.world.frame })
            }
            // A player who left sends no log: once this one's is in, settle when the room lets.
            if p.logged && room.on() && room.began_at == p.began && time >= s.settle_at {
                settle = true
            }
            // The room settled this fight (or a later one began): its outcome shows a while.
            if room.began_at == p.began && room.settled && p.settled.is_none() {
                p.settled = Some(room.outcome.winner.clone())
                if won {
                    record = Some(room.id(fight_name.as_str()))
                }
            }
            // A deploy took the room: no one settles this fight, so its end ends it here.
            if room.began_at != p.began || room.settled || (outdated && (p.world.over || cut)) {
                if p.settled_at.is_none() {
                    p.settled_at = Some(time)
                }
            }
            if let Some(at) = p.settled_at {
                if time - at > OUTCOME_SECONDS {
                    done = true
                }
            }
            let relayed = if relay_open { "" } else { " (no relay: playing alone)" }
            s.note = if outdated {
                String::from(
                    "Wrela was updated: this fight can't be recorded. The new version loads in a moment.",
                )
            } else {
                String::from(
                    f"Frame {p.frame}, {p.rollbacks} rollbacks{relayed}. J cuts (again for the next), I swings heavy, K parries, L dodges.",
                )
            }
        },
        _ => {},
    }
    if lost {
        // It came back to this fight on another page: that one plays it now.
        s.play = None
        s.note = String::from("You're in this fight on another page.")
        return
    }
    match offer {
        Some(act) => propose_fight(mut s, act.clone()),
        None => {},
    }
    if let Some(fight) = record {
        match mut s.character {
            Some(c) => character::record(mut c, fight.clone()),
            None => {},
        }
    }
    match log {
        Some(act) => {
            s.settle_at = time + SETTLE_EVERY
            propose_fight(mut s, act.clone())
        },
        None => {},
    }
    if settle {
        s.settle_at = time + SETTLE_EVERY
        propose_fight(mut s, combat::main::Act::Settle)
    }
    if done {
        s.play = None
    }
}

// ---- drawing ------------------------------------------------------------------------------------

fn circle(list: mut DrawList, at: vec2, r: f32, color: vec4) {
    list.ellipse(Rect::new(x: at.x - r, y: at.y - r, w: 2.0 * r, h: 2.0 * r), color)
}

fn draw<A: Account>(s: mut Client, width: u32, height: u32, account: mut A) {
    s.hushed = account.shown()
    let w = f32(width)
    let h = f32(height)
    let screen = vec2(w, h)
    s.list.clear(screen)
    s.list.rect(Rect::new(x: 0.0, y: 0.0, w: w, h: h), BG)
    let size = min(w, h)
    let middle = vec2(w / 2.0, h / 2.0)
    let fight_on = s.play.is_some()
    let making = maker_open(s)
    if making {
        // Under the account's pages, the maker waits unseen: they come first.
        if !s.hushed {
            draw_maker(mut s, middle, size)
        }
    } else if fight_on {
        draw_fight(mut s, middle, size)
    } else {
        draw_island(mut s, middle, size)
    }
    if title_shown(s) {
        draw_title(mut s, w, h)
    } else if account.shown() {
        // The account's pages over the game: the game shows, but not its words.
        s.choices.clear()
    } else {
        s.choices.clear()
        let title = if making { "Your character" } else if fight_on { "The fight" } else {
            "The island"
        }
        let k = clamp(min(w, h) / 720.0, 0.7, 3.0)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            title,
            24.0 * k,
            vec2(24.0 * k, 24.0 * k),
            INK,
            weight: kit::SEMIBOLD,
        )
        let note = s.note.clone()
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            note.as_str(),
            14.0 * k,
            vec2(24.0 * k, h - 40.0 * k),
            MUTED,
        )
    }
    account.draw(mut s.list, s.fonts, width, height)
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    let pass = begin_screen_pass(clear: BG)
    s.renderer.draw(pass, screen)
    pass.present()
}

/// `text` at `size`, centred on `x` with its top at `y`.
fn centred(s: mut Client, text: str, size: f32, x: f32, y: f32, color: vec4) {
    let width = s.fonts.font(Face::Sans).measure(text, size)
    let _ = s.list.text(s.fonts, Face::Sans, text, size, vec2(round(x - width / 2.0), y), color)
}

/// The title over the island: the game's name, a line of it, and the choices of a player who
/// isn't signed in (or, while the client asks, that it's finding them).
fn draw_title(s: mut Client, w: f32, h: f32) {
    s.list.rect(Rect::new(x: 0.0, y: 0.0, w: w, h: h), vec4(BG.xyz, 0.92))
    let k = clamp(min(h / 720.0, w / 420.0), 0.7, 3.0)
    let x = w / 2.0
    var y = h * 0.5 - 200.0 * k
    centred(mut s, "WRELA", 76.0 * k, x, y, INK)
    y += 104.0 * k
    let line = "You wake on a skiff. The sea goes on forever."
    if s.fonts.font(Face::Sans).measure(line, 20.0 * k) <= w - 48.0 {
        centred(mut s, line, 20.0 * k, x, y, MUTED)
    } else {
        // Too narrow for one line (a phone): two.
        centred(mut s, "You wake on a skiff.", 20.0 * k, x, y, MUTED)
        y += 28.0 * k
        centred(mut s, "The sea goes on forever.", 20.0 * k, x, y, MUTED)
    }
    y += 64.0 * k
    s.choices.clear()
    if !choosing(s) {
        centred(mut s, "Finding you…", 18.0 * k, x, y + 14.0 * k, MUTED)
        return
    }
    // Full-width large buttons (`size="lg"`: 40 tall), the first primary, then outline, then
    // ghost: one clear thing to do, and the rest quieter.
    let bw = round(min(320.0 * k, w - 48.0))
    let bh = round(40.0 * k)
    for i in 0..3 {
        let r = Rect::new(x: round(x - bw / 2.0), y: round(y), w: bw, h: bh)
        s.choices.push((i, r))
        let over = match s.pointer {
            Some(p) => r.contains(p),
            None => false,
        }
        s.hovers[i] = kit::ease(s.hovers[i], if over && !s.keyboard { 1.0 } else { 0.0 }, s.dt)
        let st = State {
            hover: s.hovers[i],
            pressed: s.pressed == Some(i) && over,
            focused: s.keyboard && s.focus == i,
        }
        let v = if i == MAKE { Variant::Primary } else if i == SIGN_IN { Variant::Outline } else {
            Variant::Ghost
        }
        kit::button(mut s.list, s.fonts, r, CHOICES[i], v, st, k, size: 15.0)
        y += bh + 12.0 * k
    }
    y += 12.0 * k
    centred(mut s, "Passkeys only: no email, no password.", 13.0 * k, x, y, MUTED)
}

fn draw_island(s: mut Client, middle: vec2, size: f32) {
    // A unit is this many pixels; the island is a sandbar 160 units across.
    let px = size / 400.0
    circle(mut s.list, middle, size * 0.47, SEA)
    circle(mut s.list, middle, 80.0 * px * 2.0, SAND)
    let (me, view) = match s.island {
        Some(l) => (l.peer(), l.view().clone()),
        None => return,
    }
    // Under the title, the island is empty: it hasn't been joined yet.
    let titled = title_shown(s)
    let shown = view.present()
    for i in shown {
        if titled {
            break
        }
        borrow b = view.bodies[i]
        let at = middle + vec2(f32(b.x), -f32(b.z)) * px
        let ring = if b.peer == me { MINE } else { OTHER }
        if b.worn {
            // A ring at its feet says whose it is; its figure and name say who.
            s.list.ellipse(
                Rect::new(x: at.x - 12.0, y: at.y - 4.0, w: 24.0, h: 8.0),
                ring,
                width: 2.0,
            )
            character::figure(mut s.list, b.card.look(), at, 34.0)
            let name = names::text(b.card.name())
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                name.as_str(),
                13.0,
                at + vec2(-3.2 * f32(name.len()), -54.0),
                INK,
            )
        } else {
            circle(mut s.list, at, 9.0, ring)
        }
    }
    // Marks over the bodies: one is placed where its body stands.
    for m in view.marks {
        if titled {
            break
        }
        let at = middle + vec2(f32(m.x), -f32(m.z)) * px
        s.list.diamond(Rect::new(x: at.x - 8.0, y: at.y - 8.0, w: 16.0, h: 16.0), BG)
        s.list.diamond(Rect::new(x: at.x - 6.0, y: at.y - 6.0, w: 12.0, h: 12.0), MARK)
    }
    if title_shown(s) || s.hushed {
        return
    }
    let count = shown.len()
    let line = String::from(f"{count} on the island, {view.marks.len()} marks")
    let k = clamp(size / 720.0, 0.7, 3.0)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        line.as_str(),
        14.0 * k,
        vec2(24.0 * k, 60.0 * k),
        MUTED,
    )
}

fn draw_maker(s: mut Client, middle: vec2, size: f32) {
    let (cname, making, part, saving, message, made) = match s.character {
        Some(c) => (c.name, c.making, c.part, c.stage == Stage::Saving, c.message.clone(), c.made),
        None => return,
    }
    let k = clamp(size / 720.0, 0.7, 3.0)
    let name = names::text(cname)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        name.as_str(),
        16.0 * k,
        vec2(24.0 * k, 60.0 * k),
        MUTED,
    )
    // The figure, and beside it a panel: each part a row, its choice between a ‹ and a ›, the
    // part the arrow keys move marked; under them, making it, or leaving.
    let tall = size * 0.5
    let feet = middle + vec2(-size * 0.2, tall * 0.5)
    circle(mut s.list, feet, tall * 0.18, SAND)
    character::figure(mut s.list, making, feet, tall)
    s.maker.clear()
    while s.maker_hovers.len() < MAKER_ROW + character::PARTS {
        s.maker_hovers.push(0.0)
    }
    let pw = round(300.0 * k)
    let row_h = round(44.0 * k)
    let x = round(middle.x + size * 0.02)
    let top = round(middle.y - (f32(character::PARTS) * row_h + 16.0 * k + 2.0 * 40.0 * k) * 0.5)
    let icon = round(32.0 * k)
    for i in 0..character::PARTS {
        let y = top + f32(i) * row_h
        let row = Rect::new(x: x, y: y, w: pw, h: row_h - round(4.0 * k))
        let chosen = i == part
        // The row: an accent fill when it's the arrows' part (`bg-accent`).
        if chosen {
            s.list.rect(row, kit::ACCENT, radius: kit::RADIUS * k)
        }
        let label = character::PART_NAMES[i]
        let px = 14.0 * k
        let ty = kit::centred_top(s.fonts, row.y + row.h * 0.5, px)
        let ink = if chosen { kit::FG } else { kit::MUTED_FG }
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            label,
            px,
            vec2(row.x + 12.0 * k, ty),
            ink,
            weight: kit::MEDIUM,
        )
        let n = character::part_of(making, i) + 1
        let value = String::from(f"{n} of {platform::wire::LOOK_CHOICES}")
        let next = Rect::new(
            x: row.right() - round(6.0 * k) - icon,
            y: row.y + round((row.h - icon) * 0.5),
            w: icon,
            h: icon,
        )
        let prev = Rect::new(x: next.x - round(72.0 * k) - icon, y: next.y, w: icon, h: icon)
        let vw = s.fonts.font(Face::Sans).measure(value.as_str(), px)
        let vx = round(prev.right() + (next.x - prev.right() - vw) * 0.5)
        let _ = s.list.text(s.fonts, Face::Sans, value.as_str(), px, vec2(vx, ty), kit::FG)
        for (hit, r, back) in [(2 * i, prev, true), (2 * i + 1, next, false)] {
            s.maker.push((hit, r))
            let st = maker_look(mut s, hit, r)
            kit::button(mut s.list, s.fonts, r, "", Variant::Outline, st, k)
            chevron(mut s.list, r, back, k, if st.hover > 0.0 || st.pressed { kit::FG } else {
                kit::MUTED_FG
            })
        }
        s.maker.push((MAKER_ROW + i, row))
    }
    var y = top + f32(character::PARTS) * row_h + 12.0 * k
    let bh = round(36.0 * k)
    let save = Rect::new(x: x, y: round(y), w: pw, h: bh)
    s.maker.push((MAKER_SAVE, save))
    let label = if made { "Save" } else { "Make my character" }
    var st = maker_look(mut s, MAKER_SAVE, save)
    st.loading = saving
    st.time = match s.time {
        Some(t) => t,
        None => 0.0,
    }
    kit::button(mut s.list, s.fonts, save, if saving { "Saving…" } else {
        label
    }, Variant::Primary, st, k)
    y += bh + 8.0 * k
    let leave = Rect::new(x: x, y: round(y), w: pw, h: bh)
    s.maker.push((MAKER_LEAVE, leave))
    let st = maker_look(mut s, MAKER_LEAVE, leave)
    kit::button(mut s.list, s.fonts, leave, if made { "Cancel" } else {
        "Not now"
    }, Variant::Ghost, st, k)
    y += bh + 12.0 * k
    if !message.is_empty() {
        let _ = s.list.text(s.fonts, Face::Sans, message.as_str(), 13.0 * k, vec2(x, y), kit::ERROR)
    }
    s.note = String::from("The arrow keys choose too, and Enter makes it.")
}

/// How the maker's control `hit` over `r` looks this frame: its hover eased, pressed.
fn maker_look(s: mut Client, hit: u32, r: Rect) -> State {
    let over = match s.pointer {
        Some(p) => r.contains(p),
        None => false,
    }
    let i = hit
    s.maker_hovers[i] = kit::ease(s.maker_hovers[i], if over && !s.keyboard { 1.0 } else {
        0.0
    }, s.dt)
    State { hover: s.maker_hovers[i], pressed: s.pressed == Some(hit) && over }
}

/// A chevron in `r`, pointing back (left) or on (right): `ChevronLeft`'s two strokes.
fn chevron(list: mut DrawList, r: Rect, back: bool, k: f32, color: vec4) {
    let c = vec2(r.x + r.w * 0.5, r.y + r.h * 0.5)
    let a = 4.5 * k
    let side = if back { 1.0 } else { -1.0 }
    let tip = c + vec2(-side * a * 0.6, 0.0)
    let w = max(1.5 * k, 1.0)
    list.line(c + vec2(side * a * 0.6, -a), tip, color, w)
    list.line(tip, c + vec2(side * a * 0.6, a), color, w)
}

fn place(middle: vec2, px: f32, x: i32, z: i32) -> vec2 {
    middle + vec2(f32(x), -f32(z)) / 64.0 * px
}

fn fighter_color(seen: Seen, base: vec4) -> vec4 {
    if seen.hp <= 0 {
        vec4(0.3, 0.3, 0.32, 1.0)
    } else if seen.act == 5 {
        vec4(base.xyz, 0.45)
    } else if seen.act == 4 {
        INK
    } else if seen.act == 6 {
        vec4(0.5, 0.5, 0.55, 1.0)
    } else {
        base
    }
}

fn draw_fight(s: mut Client, middle: vec2, size: f32) {
    let (world, slot, settled) = match s.play {
        Some(p) => (p.world.clone(), p.slot, p.settled.clone()),
        None => return,
    }
    // A metre is this many pixels: the arena is 40 metres across.
    let px = size / 46.0
    circle(mut s.list, middle, 20.0 * px, SEA)
    let boss = world.boss()
    let boss_color = if boss.act == 1 { TELL } else { fighter_color(boss, BOSS) }
    circle(mut s.list, place(middle, px, boss.x, boss.z), 1.2 * px, boss_color)
    for i in 0..world.players() {
        let seen = world.player(i)
        let base = if i == slot { MINE } else { OTHER }
        circle(mut s.list, place(middle, px, seen.x, seen.z), 0.6 * px, fighter_color(seen, base))
        let line = String::from(f"P{i + 1}  {seen.hp} hp  {seen.stamina} stamina")
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            line.as_str(),
            15.0,
            vec2(24.0, 60.0 + 20.0 * f32(i)),
            base,
        )
    }
    let boss_line = String::from(f"Boss  {boss.hp} hp")
    let _ = s.list.text(s.fonts, Face::Mono, boss_line.as_str(), 15.0, vec2(24.0, 150.0), BOSS)
    // The room's word once it's settled; until then, this client's.
    let shown = match settled {
        Some(w) => Some(w.clone()),
        None => if world.over { Some(world.winner.clone()) } else { None },
    }
    if let Some(winner) = shown {
        let verdict = match winner {
            Winner::Party => "The party wins.",
            Winner::Boss => "The boss wins.",
            Winner::Draw => "A draw.",
        }
        let _ = s.list.text(s.fonts, Face::Sans, verdict, 32.0, middle - vec2(110.0, 20.0), INK)
    }
}

// ---- tests --------------------------------------------------------------------------------------

/// A packet on its way: from slot `from` to slot `to`, arriving at frame `at`.
struct Flight: Clone {
    at: u32,
    from: u32,
    to: u32,
    bytes: Vec<u8>,
}

/// A made-up player's hands: the stick swings, and a button is held a few frames now and then.
fn hands(seed: mut u32) -> Pad {
    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
    let r = seed >> 8
    let a = f32(r % 628) / 100.0
    let held = if (r >> 10) % 9 == 0 { 1 << ((r >> 14) % 4) } else { 0 }
    Pad { x: 0.9 * cos(a), z: 0.9 * sin(a) + 0.4, held }
}

/// A fight of `n` players, each running it as a client does, over a relay that delays each
/// packet `delay` frames and loses `loss` in 100: each one's fight at the end, and the fight the
/// room runs from their logs. The last player stalls `stall` frames from frame 300 (a hidden
/// tab), then catches up two frames at a time.
fn fight_of(n: u32, delay: u32, loss: u32, stall: u32 = 0) -> (Vec<Play>, combat::sim::Outcome) {
    var party: Vec<u32> = Vec::new()
    var armed: Vec<u32> = Vec::new()
    for i in 0..n {
        party.push(10 + i)
        // Weapons of each kind, so a fight of them agrees as one of a kind does.
        armed.push(if i % 2 == 0 { LONGSWORD } else { combat::sim::FISTS })
    }
    var plays: Vec<Play> = Vec::new()
    var seeds: Vec<u32> = Vec::new()
    for i in 0..n {
        plays.push(new_play(1, i, party.clone(), armed))
        seeds.push(3 + 17 * i)
    }
    var flights: Vec<Flight> = Vec::new()
    var seed: u32 = 77
    var held: Vec<Pad> = Vec::new()
    for _ in 0..n {
        held.push(Pad { x: 0.0, z: 0.0, held: 0 })
    }
    for f in 0..6000 {
        var later: Vec<Flight> = Vec::new()
        for fl in flights.clone() {
            if fl.at <= f {
                heard(mut plays[fl.to], fl.from, fl.bytes)
            } else {
                later.push(fl.clone())
            }
        }
        flights = take later
        for i in 0..n {
            if plays[i].back != NONE {
                roll_back(mut plays[i])
            }
            // A player keeps a pad the same for a while, as hands do.
            if f % 7 == 0 {
                var sd = seeds[i]
                held[i] = hands(mut sd)
                seeds[i] = sd
            }
            let stalled = i + 1 == n && f >= 300 && f < 300 + stall
            let runs = if stalled { 0 } else if plays[i].frame < f { 2 } else { 1 }
            for _ in 0..runs {
                let Some(bytes) = tick(mut plays[i], held[i]) else { continue }
                for j in 0..n {
                    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
                    if j != i && (seed >> 8) % 100 >= loss {
                        flights.push(Flight { at: f + delay, from: i, to: j, bytes: bytes.clone() })
                    }
                }
            }
        }
    }
    // The last packets land, and each player catches up.
    for fl in flights.clone() {
        heard(mut plays[fl.to], fl.from, fl.bytes)
    }
    var logs: Vec<combat::sim::Log> = Vec::new()
    for i in 0..n {
        if plays[i].back != NONE {
            roll_back(mut plays[i])
        }
        var changes: Vec<Change> = Vec::new()
        for c in plays[i].log.clone() {
            if c.frame < plays[i].world.frame {
                changes.push(c.clone())
            }
        }
        logs.push(combat::sim::Log { changes })
    }
    let outcome = combat::sim::run_armed(armed, logs)
    (plays, outcome)
}

@test
fn every_player_sees_the_fight_the_room_settles() {
    let (plays, outcome) = fight_of(n: 3, delay: 4, loss: 10)
    for p in plays {
        assert(p.world.over, "the fight ends")
        assert(p.world.outcome() == outcome, "each player's fight is the room's")
    }
    std::io::print(f"rollbacks: {plays[0].rollbacks}, frames {outcome.frames}")
}

@test
fn a_player_who_fell_far_behind_catches_up_and_agrees() {
    // Seven seconds stalled: past what the others keep to roll back to.
    let (plays, outcome) = fight_of(n: 2, delay: 3, loss: 5, stall: 400)
    for p in plays {
        assert(p.world.over && p.world.outcome() == outcome)
    }
}

@test
fn an_invite_link_names_a_partys_room() {
    let link = "https://wrela.dev/#party-ab23cd45"
    var b: Vec<u8> = Vec::new()
    for i in 0..link.len() {
        b.push(link.byte(i))
    }
    assert(party_of_address(b) == Some(String::from("ab23cd45")))
    assert(party_of_address(Vec::from([47, 35, 103])).is_none(), "another fragment")
    assert(party_of_address(Vec::from([47])).is_none(), "no fragment")
    let code = new_code(77, 1.5)
    assert(party_code(code.as_str()) && code != new_code(78, 1.5), code.as_str())
}

/// A packet on the way, from peer `peer`, to player `to`, landing at frame `at`.
struct Packet: Clone {
    at: u32,
    peer: u32,
    to: u32,
    bytes: Vec<u8>,
}

/// `value`, as peer `peer` proposed it at room time `at`.
fn proposed(
    peer: u32,
    at: u32,
    value: take combat::main::Act,
) -> std::net::Entry<combat::main::Act> {
    std::net::Entry {
        seq: 2,
        id: std::net::ProposalId { peer, session: 1, counter: 1 },
        at: u64(at),
        value,
    }
}

/// A card of name numbers `n`, a valid look.
fn card_of(n: u32) -> Card {
    Card::of(
        names::Name { title: n, front: n, back: n, epithet: n },
        platform::wire::Look { build: 1, skin: 1, hair: 1, cloth: 1 },
    )
}

@test
fn a_player_whose_page_reloaded_mid_fight_comes_back_and_everyone_agrees() {
    let n: u32 = 3
    var room = Fight::empty()
    for i in 0..n {
        let join = combat::main::Act::Join {
            weapon: LONGSWORD,
            card: card_of(i + 1),
            seal: island::main::sealed(true),
        }
        room.apply(proposed(10 + i, 0, take join))
    }
    room.apply(proposed(peer: 10, at: 0, value: combat::main::Act::Begin))
    let armed = room.armed.clone()
    var peers: Vec<u32> = Vec::from([u32(10), 11, 12])
    var plays: Vec<Play> = Vec::new()
    var seeds: Vec<u32> = Vec::new()
    var held: Vec<Pad> = Vec::new()
    for i in 0..n {
        plays.push(new_play(1, i, room.party.clone(), armed))
        seeds.push(5 + 31 * i)
        held.push(Pad { x: 0.0, z: 0.0, held: 0 })
    }
    room.began_at = 1
    // The last player's page reloads at frame 900, and it's back (as peer 20) at 1300.
    let gone_at: u32 = 900
    let back_at: u32 = 1300
    let delay: u32 = 4
    var flights: Vec<Packet> = Vec::new()
    var seed: u32 = 99
    var away = false
    for f in 0..6000 {
        if f == gone_at {
            away = true
        }
        if f == back_at {
            let card = card_of(n)
            let back = proposed(
                20,
                f * 1000 / 60,
                combat::main::Act::Rejoin { card, seal: island::main::sealed(true) },
            )
            assert(room.check(back.clone()) == Verdict::Accept)
            room.apply(back)
            peers[n - 1] = 20
            var p = new_play(1, n - 1, room.party.clone(), armed)
            p.waiting = true
            plays[n - 1] = take p
            away = false
        }
        var later: Vec<Packet> = Vec::new()
        for fl in flights.clone() {
            if fl.at > f {
                later.push(fl.clone())
                continue
            }
            // A page that's gone hears nothing, and what the old one sent goes nowhere now.
            if away && fl.to == n - 1 {
                continue
            }
            if let Some(slot) = slot_of(plays[fl.to].party, fl.peer) {
                heard(mut plays[fl.to], slot, fl.bytes)
            }
        }
        flights = take later
        for i in 0..n {
            if away && i == n - 1 {
                continue
            }
            let (still, offer) = follow(mut plays[i], room, peers[i])
            assert(still)
            if let Some(act) = offer {
                let e = proposed(peers[i], f * 1000 / 60, act.clone())
                if room.check(e.clone()) == Verdict::Accept {
                    room.apply(e)
                }
            }
            var out: Vec<Vec<u8>> = Vec::new()
            if plays[i].waiting {
                let at = others_at(plays[i])
                if at > plays[i].idle {
                    plays[i].idle = at
                }
                let idle = plays[i].idle
                let prev = plays[i].prev
                if let Some(bytes) = plays[i].link.send(idle, prev) {
                    out.push(bytes.clone())
                }
                let cut = room.cuts[i]
                let known = plays[i].link.known()
                if cut != HANDING && cut != UNCUT && known != NONE && known + 1 >= plays[i].idle {
                    let base = room.logs[i].changes.clone()
                    pick_up(mut plays[i], base, cut, 0.0)
                }
            } else {
                if plays[i].back != NONE {
                    roll_back(mut plays[i])
                }
                if f % 7 == 0 {
                    var sd = seeds[i]
                    held[i] = hands(mut sd)
                    seeds[i] = sd
                }
                // Back, it lets go of the stick it held as it left: its first change is to nothing.
                if i == n - 1 && f >= back_at {
                    held[i] = Pad { x: 0.0, z: 0.0, held: 0 }
                }
                let replaying = plays[i].frame < plays[i].mine.len()
                let runs = if replaying { REPLAY_STEPS } else if plays[i].frame < f { 2 } else { 1 }
                for _ in 0..runs {
                    if plays[i].frame > f {
                        break
                    }
                    if let Some(bytes) = tick(mut plays[i], held[i]) {
                        out.push(bytes.clone())
                    }
                }
            }
            for bytes in out {
                for j in 0..n {
                    seed = seed.wrapping_mul(1664525).wrapping_add(1013904223)
                    if j != i && (seed >> 8) % 100 >= 5 {
                        flights.push(
                            Packet { at: f + delay, peer: peers[i], to: j, bytes: bytes.clone() },
                        )
                    }
                }
            }
        }
    }
    for fl in flights.clone() {
        if let Some(slot) = slot_of(plays[fl.to].party, fl.peer) {
            heard(mut plays[fl.to], slot, fl.bytes)
        }
    }
    assert(room.cuts[n - 1] != HANDING && room.cuts[n - 1] != UNCUT, "its log was handed back")
    let handed = room.logs[n - 1].changes.clone()
    assert(handed.len() > 0 && handed[handed.len() - 1].frame < gone_at, "what it played before")
    let own = plays[n - 1].log.clone()
    assert(own.len() > 0 && own[0].frame >= back_at, "and it played on")
    for i in 0..n {
        if plays[i].back != NONE {
            roll_back(mut plays[i])
        }
        assert(plays[i].world.over, "the fight ends")
        var changes: Vec<Change> = Vec::new()
        for c in plays[i].log.clone() {
            if c.frame < plays[i].world.frame {
                changes.push(c.clone())
            }
        }
        let log = proposed(
            peers[i],
            7000,
            combat::main::Act::Log { changes, end: plays[i].world.frame },
        )
        assert(room.check(log.clone()) == Verdict::Accept)
        room.apply(log)
    }
    assert(room.settled)
    for p in plays {
        assert(p.world.outcome() == room.outcome, "each player's fight is the room's")
    }
    std::io::print(
        f"came back: frames {room.outcome.frames}, cut at {room.cuts[n - 1]}, held {input_in(handed, gone_at)}, then {own[0].input}",
    )
}
