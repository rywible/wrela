// The player's character: who the client plays as. It's the wrela account's (platform/wire.wrela's
// `Character`), asked of the console's server with the session the browser already holds (its
// cookie goes with a same-origin request; a change carries the session's CSRF token, which `Me`
// gives). A character carries its account's name, which nobody types (platform/names.wrela), and a
// look of a few parts, each one of `LOOK_CHOICES`: so nothing a player shows another was typed.
//
// Signed out, with a name not yet kept, or with the server out of reach, the player plays as a
// guest (a wanderer, unnamed) and is told why. Signed in with no character, the client opens the
// maker first; once it's made, the look can be changed again (C on the island).
//
// Its progress is the account's too (platform/progress.wrela): the bosses it beat, read once the
// character is ready, and a fight it won recorded as soon as its room settles it (`record`).

use island::main::{Card, Seal, worn}
use platform::names
use platform::pass::Pass
use platform::names::Name
use platform::wire::{ACCOUNTS, Beaten, LOOK_CHOICES, Look, Reply, Request}
use std::http::{Header, fetch, response}
use std::io::Pending
use std::pack::unpack
use std::serialize::{LoadError, load, save}
use ui::draw::{DrawList, Rect}

/// Refresh at half the pass lifetime, leaving time for failed requests before expiry.
const PASS_SECONDS: f64 = f64(platform::pass::LIFE_MS) / 1000.0
const REFRESH_EVERY: f64 = PASS_SECONDS * 0.5
const REFRESH_RETRY: f64 = 30.0

/// Where the character is.
pub enum Stage: Copy + Eq {
    /// Asking whose session this is, or the account's character.
    Asking,
    /// Playing without a character, for `Why`.
    Guest,
    /// The maker is open: a character to make, or a look to change.
    Making,
    /// Saving what the maker made.
    Saving,
    /// Playing as the character.
    Ready,
}

/// Why a player is a guest.
pub enum Why: Copy + Eq {
    SignedOut,
    NameNotKept,
    Unreachable,
    /// Signed in, but no character made yet (the maker was left).
    NotMade,
}

/// The parts of a look the maker changes, in its order.
pub const PARTS: u32 = 4
pub const PART_NAMES: [Text; 4] = ["Build", "Skin", "Hair", "Clothes"]

/// What the client knows of its character, and the request under way.
pub struct Character {
    pub stage: Stage,
    pub why: Why,
    csrf: Vec<u8>,
    pub name: Name,
    /// The look made, and the look in the maker.
    pub look: Look,
    pub making: Look,
    /// The part the maker has chosen, and whether a character was made before (the maker then
    /// changes its look, and can be left).
    pub part: u32,
    pub made: bool,
    pub message: String,
    /// The character's pass, from its account (platform/pass.wrela): the island believes the card
    /// only with it. None until a character is made, or if the server has no key.
    pass: Option<Pass>,
    /// Whether the request under way is a refresh (`refresh`): one that fails changes nothing.
    refreshing: bool,
    asked: Option<Pending<u8>>,
    /// The bosses it has beaten, as its account last said; and the progress request under way.
    pub beaten: Vec<Beaten>,
    progress: Option<Pending<u8>>,
    /// Whether the request under way records a fight won (then its answer is said); whether the
    /// bosses beaten are yet to be asked.
    recording: bool,
    wants_progress: bool,
    /// What came of the last fight won, for the player.
    pub recorded: String,
    time: f64 = 0.0,
    refresh_at: f64 = 0.0,
    pass_until: f64 = 0.0,
    record_fight: Option<Vec<u8>> = None,
    record_retry_at: f64 = 0.0,
    retry_at: f64 = 0.0,
}

pub fn start() -> Character {
    let look = Look { build: 0, skin: 0, hair: 0, cloth: 0 }
    var c = Character {
        stage: Stage::Asking,
        why: Why::Unreachable,
        csrf: Vec::new(),
        name: Name { title: 0, front: 0, back: 0, epithet: 0 },
        look,
        making: look,
        part: 0,
        made: false,
        message: String::new(),
        pass: None,
        refreshing: false,
        asked: None,
        beaten: Vec::new(),
        progress: None,
        recording: false,
        wants_progress: false,
        recorded: String::new(),
    }
    ask(mut c, Request::Me)
    c
}

fn posted(request: Request) -> Pending<u8> {
    let kind = Header {
        name: String::from("content-type"),
        value: String::from("application/octet-stream"),
    }
    fetch("POST", ACCOUNTS, [take kind], save(request))
}

fn ask(c: mut Character, request: Request) {
    c.refreshing = false
    c.asked = Some(posted(request))
}

/// Whether another receipt can be sent without replacing a progress request or a retry.
pub fn ready_to_record(c: Character) -> bool {
    c.stage == Stage::Ready &&
        !c.csrf.is_empty() &&
        c.progress.is_none() &&
        c.record_fight.is_none()
}

/// A verified win not yet acknowledged by the account. Its caller can retain it before a
/// session change replaces the character, then match its owner again after the new lookup.
pub fn pending_record(c: Character) -> Option<Vec<u8>> {
    c.record_fight.clone()
}

/// Asks the account to record fight `fight` (combat's `Fight::id`), which its room says this
/// character won. Keep the receipt until the account answers, without replacing another request.
pub fn record(c: mut Character, fight: Vec<u8>) {
    if let Some(request) = begin_record(mut c, fight) {
        c.progress = Some(posted(request))
    }
}

fn begin_record(c: mut Character, fight: Vec<u8>) -> Option<Request> {
    if !ready_to_record(c) {
        return None
    }
    c.record_fight = Some(fight.clone())
    c.recording = true
    c.recorded = String::from("Recording the win on your account…")
    Some(Request::Record { csrf: c.csrf.clone(), fight: fight.clone() })
}

/// What a fight's frames (`sim::HZ` a second) read as: minutes and seconds.
pub fn clock(frames: u32) -> String {
    let seconds = frames / combat::sim::HZ
    let s = seconds % 60
    let pad = if s < 10 { "0" } else { "" }
    String::from(f"{seconds / 60}:{pad}{s}")
}

/// What the player is told of its bosses beaten: the idol's wins and best time, if any.
pub fn beaten_line(beaten: [Beaten]) -> String {
    for b in beaten {
        if b.boss == 1 {
            let times = if b.wins == 1 { String::from("once") } else {
                String::from(f"{b.wins} times")
            }
            return String::from(f"Idol beaten {times}, best {clock(b.best)}.")
        }
    }
    String::new()
}

/// Polls the progress request under way.
fn update_progress(c: mut Character) {
    let answer = match mut c.progress {
        Some(p) => p.poll(),
        None => None,
    }
    let Some(result) = answer else { return }
    c.progress = None
    let reply = match result {
        Ok(bytes) => reply_of(bytes),
        Err(_) => None,
    }
    heard_progress(mut c, reply)
}

/// What a progress reply (or none: out of reach) does: the bosses beaten, and for a recording,
/// what came of it.
pub fn heard_progress(c: mut Character, reply: Option<Reply>) {
    let recording = c.recording
    c.recording = false
    match reply {
        Some(Reply::Progress { beaten }) => {
            c.beaten = beaten.clone()
            if recording {
                c.record_fight = None
                c.recorded = String::from("Win recorded on your account.")
            }
        },
        Some(Reply::Refused { why }) => if recording {
            c.record_fight = None
            c.recorded = String::from(f"The win wasn't recorded: {why}")
        },
        _ => if recording {
            // Transport failures and the account's typed RecordPending both leave this
            // receipt outstanding. The server deduplicates a retry that already landed.
            c.record_retry_at = c.time + REFRESH_RETRY
            c.recorded = String::from(
                "Your account couldn't be reached. The win will be tried again.",
            )
        },
    }
}

/// The card the island is told, with its pass: the character's, once it's ready and its account
/// signed it.
pub fn card(c: Character) -> Option<(Card, Seal)> {
    if c.stage != Stage::Ready || stale_pass(c) {
        return None
    }
    let Some(p) = c.pass else { return None }
    Some(worn(p))
}

/// The pass in a `Reply::Character`'s bytes, if it's one for the character named `name` that
/// looks `look`.
fn pass_for(bytes: [u8], name: Name, look: Look) -> Option<Pass> {
    let Ok(p) = unpack::<Pass>(Vec::from(bytes)) else { return None }
    if p.name() == name && p.look() == look { Some(p) } else { None }
}

/// Whether the pass must renew before another signed room join: the host clock advances while
/// the tab is hidden too, whereas the game's presentation clock need not.
pub fn stale_pass(c: Character) -> bool {
    c.stage == Stage::Ready && c.pass.is_some() && c.time >= c.pass_until
}

/// Polls the requests under way at the host's clock (`std::time::now`), not presentation time.
pub fn update(c: mut Character, time: f64 = 0.0) {
    c.time = time
    update_progress(mut c)
    let answer = match mut c.asked {
        Some(p) => p.poll(),
        None => None,
    }
    if let Some(result) = answer {
        c.asked = None
        let reply = match result {
            Ok(bytes) => reply_of(bytes),
            Err(_) => None,
        }
        if let Some(next) = heard(mut c, reply) {
            ask(mut c, next)
        }
    }
    match next_background(mut c) {
        Some(Request::Progress) => c.progress = Some(posted(Request::Progress)),
        Some(Request::Character) => refresh(mut c),
        Some(Request::Me) => ask(mut c, Request::Me),
        Some(request) => c.progress = Some(posted(request)),
        None => {},
    }
}

/// Work to begin while the foreground character request is idle.
fn next_background(c: mut Character) -> Option<Request> {
    if c.asked.is_some() { return None }
    if c.stage == Stage::Guest && c.why == Why::Unreachable && c.time >= c.retry_at {
        c.retry_at = c.time + REFRESH_RETRY
        return Some(Request::Me)
    }
    if c.stage == Stage::Ready &&
        c.progress.is_none() &&
        !c.recording &&
        c.time >= c.record_retry_at {
        if let Some(fight) = c.record_fight {
            let retry = fight.clone()
            c.recording = true
            c.recorded = String::from("Recording the win on your account…")
            return Some(Request::Record { csrf: c.csrf.clone(), fight: retry.clone() })
        }
    }
    if c.stage == Stage::Ready && c.time >= c.refresh_at {
        c.refresh_at = c.time + REFRESH_RETRY
        return Some(Request::Character)
    }
    if c.wants_progress && c.progress.is_none() {
        c.wants_progress = false
        return Some(Request::Progress)
    }
    None
}

/// The server's reply's bytes, read: none if it isn't one (the server out of reach, or no server).
fn reply_of(bytes: [u8]) -> Option<Reply> {
    let r = response(bytes)?
    if r.status != 200 {
        return None
    }
    let read: Result<Reply, LoadError> = load(r.body.clone())
    (take read).ok()
}

/// What a reply (or none: out of reach) does to where the character is: the request to make
/// next, if one is.
pub fn heard(c: mut Character, reply: Option<Reply>) -> Option<Request> {
    if c.refreshing {
        // A refresh keeps what it had unless the character came back made.
        c.refreshing = false
        let fresh = match reply {
            Some(Reply::Character { made: true, .. }) => true,
            _ => false,
        }
        // The maker may have opened since the background request began. Its current
        // choices belong to the player; an answer for the old look must not replace them.
        if !fresh || c.stage != Stage::Ready {
            return None
        }
    }
    let Some(reply) = reply else {
        if c.stage == Stage::Saving {
            c.stage = Stage::Making
            c.message = String::from("Couldn't save. Enter tries again.")
        } else {
            c.stage = Stage::Guest
            c.why = Why::Unreachable
            c.retry_at = c.time + REFRESH_RETRY
        }
        return None
    }
    var next: Option<Request> = None
    match reply {
        Reply::Welcome { me, csrf } => {
            c.csrf = csrf.clone()
            if !me.signed_in || me.must_add_passkey {
                c.stage = Stage::Guest
                c.why = Why::SignedOut
            } else if !me.fixed {
                c.stage = Stage::Guest
                c.why = Why::NameNotKept
            } else {
                next = Some(Request::Character)
            }
        },
        Reply::Character { made, name, look, pass } => {
            c.name = name
            c.made = made
            c.message = String::new()
            c.pass = if made { pass_for(pass, name, look) } else { None }
            if made {
                c.look = look
                c.making = look
                c.stage = Stage::Ready
                c.refresh_at = c.time + REFRESH_EVERY
                c.pass_until = c.time + PASS_SECONDS
                c.wants_progress = c.beaten.is_empty()
            } else {
                c.stage = Stage::Making
            }
        },
        Reply::Refused { why } => {
            if c.stage == Stage::Saving {
                c.stage = Stage::Making
                c.message = why.clone()
            } else {
                c.stage = Stage::Guest
                c.why = Why::Unreachable
                c.retry_at = c.time + REFRESH_RETRY
            }
        },
        _ => {
            c.stage = Stage::Guest
            c.why = Why::Unreachable
            c.retry_at = c.time + REFRESH_RETRY
        },
    }
    next
}

/// Asks for the character again, for a fresh pass, when it's ready and nothing is asked: a pass
/// expires (platform/pass.wrela's `LIFE_MS`), and a tab may stay open longer.
pub fn refresh(c: mut Character) {
    if c.stage == Stage::Ready && c.asked.is_none() {
        c.refresh_at = c.time + REFRESH_RETRY
        ask(mut c, Request::Character)
        c.refreshing = true
    }
}

/// Opens the maker on the character made, to change its look.
pub fn change(c: mut Character) {
    if c.stage == Stage::Ready || (c.stage == Stage::Guest && c.why == Why::NotMade) {
        c.making = c.look
        c.part = 0
        c.stage = Stage::Making
    }
}

/// The maker's keys, sending what they ask. A save left (Escape) is no longer waited on.
pub fn keys(c: mut Character, dx: i32, dy: i32, enter: bool, escape: bool) {
    let r = maker_input(mut c, dx, dy, enter, escape)
    if c.stage != Stage::Saving {
        c.asked = None
    }
    if let Some(r) = r {
        ask(mut c, r)
    }
}

/// The maker's keys: up and down choose a part (`dy`), left and right its choice (`dx`), Enter
/// saves, Escape leaves, while saving too: to the look made before, or as a guest who may come
/// back (C). The request to make, if one is.
pub fn maker_input(
    c: mut Character,
    dx: i32,
    dy: i32,
    enter: bool,
    escape: bool,
) -> Option<Request> {
    if escape && (c.stage == Stage::Making || c.stage == Stage::Saving) {
        c.making = c.look
        c.message = String::new()
        if c.made {
            c.stage = Stage::Ready
        } else {
            c.stage = Stage::Guest
            c.why = Why::NotMade
        }
        return None
    }
    if c.stage != Stage::Making {
        return None
    }
    if dy != 0 {
        c.part = u32((i32(c.part) + dy % i32(PARTS) + i32(PARTS)) % i32(PARTS))
    }
    if dx != 0 {
        let now = part_of(c.making, c.part)
        let next = u32((i32(now) + dx % i32(LOOK_CHOICES) + i32(LOOK_CHOICES)) % i32(LOOK_CHOICES))
        c.making = with_part(c.making, c.part, next)
    }
    if enter {
        c.stage = Stage::Saving
        c.message = String::new()
        return Some(Request::SaveCharacter { csrf: c.csrf.clone(), look: c.making })
    }
    None
}

pub fn part_of(look: Look, part: u32) -> u32 {
    if part == 0 {
        look.build
    } else if part == 1 {
        look.skin
    } else if part == 2 {
        look.hair
    } else {
        look.cloth
    }
}

pub fn with_part(look: Look, part: u32, choice: u32) -> Look {
    var l = look
    if part == 0 {
        l.build = choice
    } else if part == 1 {
        l.skin = choice
    } else if part == 2 {
        l.hair = choice
    } else {
        l.cloth = choice
    }
    l
}

/// What the player is told of who they play as.
pub fn line(c: Character) -> String {
    match c.stage {
        Stage::Asking => String::from("Finding your character…"),
        Stage::Guest => match c.why {
            Why::SignedOut => String::from(
                "Playing as a guest. Sign in, top right, to make your character.",
            ),
            Why::NameNotKept => String::from(
                "Playing as a guest. Keep your name, top right, to make your character.",
            ),
            Why::Unreachable => String::from(
                "Playing as a guest: your account couldn't be reached.",
            ),
            Why::NotMade => String::from("Playing as a guest. C makes your character."),
        },
        Stage::Making | Stage::Saving => String::from("Making your character"),
        Stage::Ready => {
            let beaten = beaten_line(c.beaten)
            let gap = if beaten.is_empty() { "" } else { " " }
            String::from(f"{names::text(c.name)}.{gap}{beaten} C changes your look.")
        },
    }
}

// ---- the look -----------------------------------------------------------------------------------

const SKINS: [vec4; 8] = [
    vec4(0.98, 0.86, 0.74, 1.0),
    vec4(0.94, 0.78, 0.62, 1.0),
    vec4(0.85, 0.66, 0.5, 1.0),
    vec4(0.74, 0.55, 0.4, 1.0),
    vec4(0.6, 0.42, 0.3, 1.0),
    vec4(0.47, 0.32, 0.22, 1.0),
    vec4(0.36, 0.24, 0.17, 1.0),
    vec4(0.26, 0.18, 0.13, 1.0),
]

const HAIRS: [vec4; 8] = [
    vec4(0.1, 0.08, 0.07, 1.0),
    vec4(0.3, 0.2, 0.12, 1.0),
    vec4(0.55, 0.36, 0.2, 1.0),
    vec4(0.85, 0.7, 0.42, 1.0),
    vec4(0.62, 0.22, 0.12, 1.0),
    vec4(0.82, 0.82, 0.84, 1.0),
    vec4(0.25, 0.32, 0.6, 1.0),
    vec4(0.75, 0.35, 0.55, 1.0),
]

const CLOTHS: [vec4; 8] = [
    vec4(0.85, 0.3, 0.25, 1.0),
    vec4(0.95, 0.62, 0.2, 1.0),
    vec4(0.88, 0.8, 0.3, 1.0),
    vec4(0.35, 0.65, 0.35, 1.0),
    vec4(0.25, 0.6, 0.7, 1.0),
    vec4(0.3, 0.4, 0.85, 1.0),
    vec4(0.55, 0.35, 0.75, 1.0),
    vec4(0.9, 0.9, 0.88, 1.0),
]

/// How broad a build is, against the slightest.
fn breadth(build: u32) -> f32 {
    0.8 + 0.08 * f32(build % LOOK_CHOICES)
}

pub fn skin(look: Look) -> vec4 {
    SKINS[look.skin % LOOK_CHOICES]
}

pub fn hair(look: Look) -> vec4 {
    HAIRS[look.hair % LOOK_CHOICES]
}

pub fn cloth(look: Look) -> vec4 {
    CLOTHS[look.cloth % LOOK_CHOICES]
}

/// A figure of `look`, standing on `feet`, `tall` pixels high: flat, as the client draws all.
pub fn figure(list: mut DrawList, look: Look, feet: vec2, tall: f32) {
    let wide = tall * 0.36 * breadth(look.build)
    let head = tall * 0.26
    // Legs, body, then head and hair.
    let legs = vec4(0.18, 0.18, 0.2, 1.0)
    list.rect(
        Rect::new(x: feet.x - wide * 0.38, y: feet.y - tall * 0.34, w: wide * 0.3, h: tall * 0.34),
        legs,
    )
    list.rect(
        Rect::new(x: feet.x + wide * 0.08, y: feet.y - tall * 0.34, w: wide * 0.3, h: tall * 0.34),
        legs,
    )
    list.rect(
        Rect::new(x: feet.x - wide / 2.0, y: feet.y - tall * 0.74, w: wide, h: tall * 0.42),
        cloth(look),
        radius: wide * 0.18,
    )
    let top = feet.y - tall
    list.ellipse(
        Rect::new(x: feet.x - head / 2.0, y: top + tall * 0.02, w: head, h: head),
        skin(look),
    )
    list.rect(
        Rect::new(x: feet.x - head * 0.55, y: top, w: head * 1.1, h: head * 0.42),
        hair(look),
        radius: head * 0.2,
    )
}

// ---- tests --------------------------------------------------------------------------------------

@test
fn character_maker_wraps_a_burst_of_keys_without_losing_its_part_or_look() {
    var c = blank()
    c.stage = Stage::Making
    let _ = maker_input(mut c, dx: -17, dy: -9, enter: false, escape: false)
    assert(c.part == PARTS - 1, "many Up presses still select a part")
    assert(c.making.cloth == LOOK_CHOICES - 1, "many Left presses still select a look")
    let _ = maker_input(mut c, dx: 19, dy: 13, enter: false, escape: false)
    assert(c.part == 0 && c.making.build == 3, "both directions wrap")
}

@test
fn character_refresh_does_not_close_the_character_maker() {
    var c = blank()
    c.stage = Stage::Ready
    c.made = true
    c.refreshing = true
    let before = c.look
    change(mut c)
    let _ = maker_input(mut c, dx: 1, dy: 0, enter: false, escape: false)
    // The island reconnected and asked for a pass before C opened the maker. Its answer
    // arrives at the next frame's update, before that frame can cancel the pending request.
    let _ = heard(
        mut c,
        Some(Reply::Character {
            made: true,
            name: c.name,
            look: before,
            pass: Vec::new(),
        }),
    )
    assert(c.stage == Stage::Making, "a refresh must not take away the maker")
    assert(c.making.build == 1 && c.look == before, "the unsaved choices are kept")
}

@test
fn character_passes_refresh_on_a_connected_page_and_back_off_after_failure() {
    var c = blank()
    c.time = 100.0
    let reply = Reply::Character { made: true, name: c.name, look: c.look, pass: Vec::new() }
    let _ = heard(mut c, Some(reply.clone()))
    c.wants_progress = false
    c.time = 100.0 + REFRESH_EVERY - 1.0
    assert(next_background(mut c).is_none(), "no needless refresh while the pass is fresh")
    c.time += 1.0
    let Some(Request::Character) = next_background(mut c) else {
        panic("a connected page refreshes before its pass expires")
    }
    // The scheduled request failed: retain the current character, then wait before retrying.
    c.refreshing = true
    let _ = heard(mut c, None)
    assert(c.stage == Stage::Ready, "a transient refresh failure does not discard the character")
    assert(next_background(mut c).is_none(), "a failed refresh is not retried every frame")
    c.time += REFRESH_RETRY
    let Some(Request::Character) = next_background(mut c) else { panic("retry is due") }
    c.time += 1.0
    let _ = heard(mut c, Some(take reply))
    c.wants_progress = false
    assert(next_background(mut c).is_none(), "a fresh reply starts a new lifetime")
    c.time += REFRESH_EVERY
    c.stage = Stage::Making
    assert(next_background(mut c).is_none(), "background refresh does not interrupt the maker")
}

@test
fn character_does_not_reuse_an_expired_pass_after_a_hidden_tab_returns() {
    var c = blank()
    c.time = 100.0
    let pass = platform::pass::sign([7; 32], c.name, c.look, 1000000)
    let reply = Reply::Character {
        made: true,
        name: c.name,
        look: c.look,
        pass: std::pack::pack(pass),
    }
    let _ = heard(mut c, Some(reply.clone()))
    c.wants_progress = false
    assert(!stale_pass(c) && card(c).is_some())
    // No visible frames ran for longer than a pass lives. The next host time jumps ahead.
    c.time += PASS_SECONDS + 1.0
    assert(stale_pass(c) && card(c).is_none(), "expired credentials are not worn into a room")
    let Some(Request::Character) = next_background(mut c) else { panic("renew immediately") }
    c.refreshing = true
    let _ = heard(mut c, Some(take reply))
    assert(!stale_pass(c) && card(c).is_some(), "the new pass releases the waiting room join")
}

@test
fn character_keeps_a_won_fight_until_a_transient_record_failure_can_retry() {
    var c = blank()
    c.stage = Stage::Ready
    c.csrf = Vec::from([7; 16])
    c.refresh_at = REFRESH_EVERY
    let fight = Vec::from([u8(1), 2, 3])
    let Some(Request::Record { fight: first, .. }) = begin_record(mut c, fight.clone()) else {
        panic("a receipt can be sent")
    }
    assert(first == fight)
    assert(pending_record(c) == Some(fight.clone()), "session changes can retain the receipt")
    c.time = 1.0
    heard_progress(mut c, None)
    assert(!ready_to_record(c), "a new win cannot replace the failed receipt")
    assert(next_background(mut c).is_none(), "a network failure backs off")
    c.time += REFRESH_RETRY
    let Some(Request::Record { fight: retry, .. }) = next_background(mut c) else {
        panic("the same win is retried after a transient failure")
    }
    assert(retry == fight)
    heard_progress(mut c, Some(Reply::RecordPending))
    assert(
        !ready_to_record(c) && next_background(mut c).is_none(),
        "a backend failure backs off too",
    )
    c.time += REFRESH_RETRY
    let Some(Request::Record { fight: backend_retry, .. }) = next_background(mut c) else {
        panic("a temporary account or room outage does not discard the win")
    }
    assert(backend_retry == fight)
    heard_progress(mut c, Some(Reply::Progress { beaten: Vec::new() }))
    assert(ready_to_record(c), "the queued next win can follow the successful receipt")
    assert(pending_record(c).is_none(), "an acknowledged receipt needs no session handover")
    assert(next_background(mut c).is_none(), "a successful record is not retried")
    let Some(_) = begin_record(mut c, fight) else { panic("another receipt") }
    heard_progress(mut c, Some(Reply::Refused { why: String::from("Not a winner.") }))
    assert(ready_to_record(c), "a semantic refusal is final")
    assert(next_background(mut c).is_none(), "a refused record is not retried")
}

@test
fn character_lookup_recovers_from_a_transient_initial_failure() {
    var c = blank()
    c.time = 100.0
    let _ = heard(mut c, None)
    assert(c.stage == Stage::Guest && c.why == Why::Unreachable)
    assert(next_background(mut c).is_none(), "an unavailable account backs off")
    c.time += REFRESH_RETRY
    let Some(Request::Me) = next_background(mut c) else { panic("the initial lookup retries") }
    assert(next_background(mut c).is_none(), "a retry is scheduled only once per interval")
    for why in [Why::SignedOut, Why::NameNotKept, Why::NotMade] {
        c.why = why
        c.time += REFRESH_RETRY
        assert(next_background(mut c).is_none(), "an intentional guest does not poll the account")
    }
}

fn me(signed_in: bool, fixed: bool) -> Reply {
    Reply::Welcome {
        me: platform::wire::Me {
            signed_in,
            name: String::from("Sir Somebody"),
            fixed,
            rerolls: 0,
            must_add_passkey: false,
        },
        csrf: Vec::from([7; 16]),
    }
}

fn blank() -> Character {
    let look = Look { build: 0, skin: 0, hair: 0, cloth: 0 }
    Character {
        stage: Stage::Asking,
        why: Why::Unreachable,
        csrf: Vec::new(),
        name: Name { title: 0, front: 0, back: 0, epithet: 0 },
        look,
        making: look,
        part: 0,
        made: false,
        message: String::new(),
        pass: None,
        refreshing: false,
        asked: None,
        beaten: Vec::new(),
        progress: None,
        recording: false,
        wants_progress: false,
        recorded: String::new(),
    }
}

@test
fn a_win_recorded_is_said_with_the_best_time() {
    var c = blank()
    c.stage = Stage::Ready
    let b = Beaten { boss: 1, wins: 2, best: 60 * 75, first: 1, last: 2 }
    assert(clock(60 * 75) == "1:15" && clock(60 * 5) == "0:05")
    c.recording = true
    heard_progress(mut c, Some(Reply::Progress { beaten: Vec::from([take b]) }))
    assert(c.recorded == "Win recorded on your account.", c.recorded.as_str())
    assert(line(c).find("Idol beaten 2 times").is_some(), "and it's in the line")
    c.recording = true
    heard_progress(mut c, Some(Reply::Refused { why: String::from("No.") }))
    assert(c.recorded == "The win wasn't recorded: No." && c.beaten.len() == 1, "kept")
    // A plain read says nothing of a recording.
    c.recorded = String::new()
    heard_progress(mut c, Some(Reply::Progress { beaten: Vec::new() }))
    assert(c.recorded.is_empty() && c.beaten.is_empty())
}

@test
fn a_guest_is_told_why() {
    var c = blank()
    let _ = heard(mut c, Some(me(signed_in: false, fixed: false)))
    assert(c.stage == Stage::Guest && c.why == Why::SignedOut)
    var c = blank()
    let _ = heard(mut c, Some(me(signed_in: true, fixed: false)))
    assert(c.stage == Stage::Guest && c.why == Why::NameNotKept)
    var c = blank()
    let _ = heard(mut c, None)
    assert(c.stage == Stage::Guest && c.why == Why::Unreachable && card(c).is_none())
}

@test
fn no_character_opens_the_maker_and_a_save_plays_as_it() {
    var c = blank()
    let next = heard(mut c, Some(me(signed_in: true, fixed: true)))
    assert(c.stage == Stage::Asking && c.csrf.len() == 16, "the character asked next")
    let Some(Request::Character) = next else { panic("asked") }
    let name = Name { title: 1, front: 2, back: 3, epithet: 4 }
    let none = Look { build: 0, skin: 0, hair: 0, cloth: 0 }
    let _ = heard(mut c, Some(Reply::Character { made: false, name, look: none, pass: Vec::new() }))
    assert(c.stage == Stage::Making && !c.made)
    // Escape leaves a maker with nothing made: a guest, who may come back.
    let _ = maker_input(mut c, dx: 0, dy: 0, enter: false, escape: true)
    assert(c.stage == Stage::Guest && c.why == Why::NotMade && card(c).is_none())
    change(mut c)
    assert(c.stage == Stage::Making)
    // Down to skin, two choices left (wrapping), then clothes, one right.
    let _ = maker_input(mut c, dx: 0, dy: 1, enter: false, escape: false)
    let _ = maker_input(mut c, dx: -2, dy: 0, enter: false, escape: false)
    let _ = maker_input(mut c, dx: 0, dy: 2, enter: false, escape: false)
    let save = maker_input(mut c, dx: 1, dy: 0, enter: true, escape: false)
    let Some(Request::SaveCharacter { csrf, look }) = save else { panic("saved") }
    assert(csrf.len() == 16 && look == c.making && c.stage == Stage::Saving)
    assert(c.making == Look { build: 0, skin: LOOK_CHOICES - 2, hair: 0, cloth: 1 })
    let _ = heard(mut c, Some(Reply::Refused { why: String::from("No.") }))
    assert(c.stage == Stage::Making && c.message.as_str() == "No.", "refused: the maker stays")
    // A save waited on can be left too.
    let _ = maker_input(mut c, dx: 0, dy: 0, enter: true, escape: false)
    let _ = maker_input(mut c, dx: 0, dy: 0, enter: false, escape: true)
    assert(c.stage == Stage::Guest, "left while saving")
    change(mut c)
    c.stage = Stage::Saving
    let saved = c.making
    let _ = heard(mut c, Some(Reply::Character { made: true, name, look: saved, pass: Vec::new() }))
    assert(c.stage == Stage::Ready && c.look == saved)
    assert(card(c).is_none(), "no pass: the island isn't told a card it won't believe")
    var secret: Vec<u8> = Vec::new()
    for i in 0..32 {
        secret.push(u8(i))
    }
    let Some(key) = platform::pass::key_of(secret) else { panic("a key") }
    let signed = std::pack::pack(platform::pass::sign(key, name, saved, 5000))
    let _ = heard(
        mut c,
        Some(Reply::Character { made: true, name, look: saved, pass: signed.clone() }),
    )
    let Some((k, seal)) = card(c) else { panic("a card") }
    assert(k.valid() && k.name() == name && k.look() == saved && seal.expires == 5000)
    let other = Look { build: 1, skin: 1, hair: 1, cloth: 1 }
    let _ = heard(mut c, Some(Reply::Character { made: true, name, look: other, pass: signed }))
    assert(card(c).is_none(), "a pass for another look isn't worn")
    let _ = heard(
        mut c,
        Some(
            Reply::Character {
                made: true,
                name,
                look: saved,
                pass: std::pack::pack(platform::pass::sign(key, name, saved, 5000)),
            },
        ),
    )
    // A refresh that fails keeps the character and its pass.
    c.refreshing = true
    let _ = heard(mut c, None)
    assert(c.stage == Stage::Ready && card(c).is_some(), "a failed refresh changes nothing")
    // Changing the look: Escape leaves it as it was.
    change(mut c)
    let _ = maker_input(mut c, dx: 1, dy: 0, enter: false, escape: false)
    let _ = maker_input(mut c, dx: 0, dy: 0, enter: false, escape: true)
    assert(c.stage == Stage::Ready && c.look == saved && c.making == saved)
}
