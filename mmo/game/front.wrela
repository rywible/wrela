// wrela.dev's front page: the opening (scenes/opening) plays live behind it, a skiff adrift on the
// open sea under the floating cathedral, and the game's name and its actions stand at the left,
// as the console's home stood over the capybara game playing itself (rywible/wrela#360). Play
// hands the skiff to the player where it floats, with no account and nothing online: the camera
// is the one the rowing uses, so the page's frame is the game's first. Play online goes to the
// MMO's client (client.wrela), whose title signs in or makes an account; the account's chip in
// the corner signs in from here too. Escape while rowing comes back to the page.
//
// The scene is drawn smaller than the screen when the device can't keep up (`budget`), then laid
// over the whole screen. Until its first drawing is ready a still stands in for it (`poster`), so
// the page never opens on black; and the page's veil, a shade in the bottom left corner under the
// words alone, eases away as the player takes the paddle.

use client::Account
use opening::played::{State as Scene, input, play, ready, release, scene, swung, way}
use std::gpu::{
    ClipPosition, FragCoord, Rgba8, Sampler, Texture, VertexIndex, begin_screen_pass, draw, sampler,
}
use std::input::{Button, Event, Key, PadButton, events}
use ui::draw::{DrawList, Rect, Renderer}
use ui::kit
use ui::kit::{State, Variant}
use ui::text::{Face, Fonts}

/// What the page is doing: showing its words over the scene, or the player rowing.
pub enum Stage: Copy + Eq { Page, Rowing }

/// What a frame of the page asks of the program it's in.
pub enum Next: Copy + Eq {
    /// Stay, with the pointer's shape: a hand over what can be pressed.
    Stay { hand: bool },
    /// The player chose to play online: the MMO's client takes the screen.
    Online,
}

// The page's actions.
const PLAY: u32 = 0
const ONLINE: u32 = 1
const ACTIONS: [Text; 2] = ["Play", "Play online"]
const NONE: u32 = 4294967295

/// The bands of rows a drawing of the scene is painted in, one a frame (`play`).
const BANDS: u32 = 2
/// Seconds the scene takes to come up from black, and the page's words after it.
const RISE: f32 = 1.6
const WORDS_AFTER: f32 = 0.35
/// Seconds from the page's first frame the words wait for the scene at most (over the poster).
const WORDS_WAIT: f32 = 0.4
/// Seconds the words take to go as the player takes the paddle, and to come back.
const LEAVE: f32 = 0.45
const RETURN: f32 = 0.6
/// Seconds the camera takes (as a time constant) to swing back to the page's bearing, and away.
const SWING: f32 = 0.6
/// Seconds the rowing's keys stay shown once the skiff has way on it.
const KEYS_FOR: f32 = 4.0

/// The tallest the scene is drawn (pixels), and the shortest the budget takes it to.
const TALLEST: f32 = 1080.0
const SHORTEST: f32 = 360.0
/// Seconds a frame may take, on average, before the scene is drawn smaller; and under which it
/// grows again. A screen slower than 60 a second raises both with its own frame (`base`).
const SLOW: f32 = 1.0 / 48.0
const QUICK: f32 = 1.0 / 57.0
/// Seconds a new size of the scene's must hold before it's drawn at it: a window being dragged
/// keeps the last drawing, stretched, instead of beginning one each frame and finishing none.
const SETTLE: f32 = 0.2

/// Where the horizon lies on the screen in the page's shot (a fraction of its height, from the
/// top): the name stands wholly under it where the screen is tall enough, so the sea's line
/// never cuts through its letters.
const HORIZON: f32 = 0.712

/// The page's colours: the name's warm ivory, Play's fill and its hover, and the ink on it.
const IVORY = vec4(0.957, 0.922, 0.867, 1.0)
const PLAY_FILL = vec4(0.965, 0.937, 0.890, 1.0)
const PLAY_HOVER = vec4(1.0, 0.969, 0.910, 1.0)
const PLAY_INK = vec4(0.090, 0.071, 0.047, 1.0)
/// The quieter action's glass: a dark fill and a faint edge, so it reads on any sky.
const GLASS = vec4(0.039, 0.047, 0.071, 0.45)
const GLASS_HOVER = vec4(0.039, 0.047, 0.071, 0.62)
const GLASS_EDGE = vec4(1.0, 1.0, 1.0, 0.18)

/// A screen narrower or shorter than this (logical pixels) is a phone's: the skiff needs keys.
const PHONE_SIDE: f32 = 520.0

/// What the veil's shader reads: the screen's size, how far the scene has come up over its
/// poster, and how much of the page's veil lies over it.
pub struct Veil: Copy + GpuData {
    pub size: vec2,
    pub shown: f32,
    pub veil: f32,
}

pub struct Front {
    scene: Scene,
    smp: Sampler,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    pub stage: Stage,
    /// The time the page began (s), and the frames it has drawn.
    began: Option<f32>,
    time: f32,
    dt: f32,
    drawings: u32,
    /// The scene has inked a drawing under a sky cooked whole: it may show.
    cooked: bool,
    /// How far the scene has come up over the poster (0 to 1), and the words are in (0 to 1),
    /// which is how much of the veil lies over it.
    shown: f32,
    words: f32,
    /// Seconds since the scene first showed.
    since: f32,
    /// The scene's height as the budget would draw it (pixels); the frames' average seconds, and
    /// the shortest a frame takes here (the screen's own pace, `budget`); and when the budget last
    /// changed the height.
    tall: f32,
    spent: f32,
    base: f32,
    quickest: f32,
    window_began: f32,
    resized_at: f32,
    /// The size the scene is drawn at, the size last asked for, and since when (`SETTLE`).
    drawn_at: (u32, u32),
    asked: (u32, u32),
    asked_since: f32,
    /// The size that last ran slow, kept under until `ceiling_until` (s).
    ceiling: f32,
    ceiling_until: f32,
    /// The actions' rectangles as last drawn, their hovers, the one pressed, the keyboard's focus
    /// (shown once the keyboard moves it), and the pointer.
    rects: Vec<Rect>,
    hovers: Vec<f32>,
    pressed: u32,
    focus: u32,
    keyboard: bool,
    pointer: Option<vec2>,
    /// How long the skiff has had way on it since Play, and how far the rowing's keys show.
    rowed: f32,
    keys: f32,
    /// How far the page swings the camera round the skiff (rad): back to the opening's bearing
    /// while the page shows, so the cathedral stands where it did wherever the player rowed.
    orbit: f32,
    reduced: bool,
}

/// The page, its scene not yet drawn, in `fonts`: the console's, whose second face
/// (`Face::Mono`) is its display face, Wrela Facet (ui/brand/facet.wrela), for the name.
pub fn init(fonts: take Fonts) -> Front {
    let renderer = Renderer::new(fonts)
    Front {
        scene: scene(width: 640, height: 360),
        smp: sampler(),
        fonts,
        renderer,
        list: DrawList::new(),
        stage: Stage::Page,
        began: None,
        time: 0.0,
        dt: 0.0,
        drawings: 0,
        cooked: false,
        shown: 0.0,
        words: 0.0,
        since: 0.0,
        tall: 720.0,
        spent: 1.0 / 60.0,
        base: 1.0 / 60.0,
        quickest: 1.0,
        window_began: 0.0,
        resized_at: 0.0,
        drawn_at: (0, 0),
        asked: (0, 0),
        asked_since: 0.0,
        ceiling: TALLEST,
        ceiling_until: 0.0,
        rects: Vec::new(),
        hovers: Vec::from([0.0, 0.0]),
        pressed: NONE,
        focus: PLAY,
        keyboard: false,
        pointer: None,
        rowed: 0.0,
        keys: 0.0,
        orbit: 0.0,
        reduced: false,
    }
}

/// One triangle that covers the screen.
@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// The still that stands in for the scene until its first drawing (a cold load compiles the
/// scene's shaders and cooks its sky first): the page's shot's colours, row by row at `y` (0 at
/// the top), taken from a drawing of it. Cool high sky, gold toward the sun on the horizon, and
/// the sea under it darkening toward the skiff.
fn poster(y: f32) -> vec3 {
    let high = vec3(0.576, 0.591, 0.668)
    let pale = vec3(0.697, 0.658, 0.623)
    let warm = vec3(0.817, 0.705, 0.515)
    let gold = vec3(0.916, 0.779, 0.488)
    let line = vec3(0.914, 0.748, 0.431)
    let near = vec3(0.714, 0.609, 0.46)
    let sea = vec3(0.575, 0.501, 0.395)
    let deep = vec3(0.291, 0.289, 0.302)
    var c = mix(high, pale, smoothstep(0.0, 0.2, y))
    c = mix(c, warm, smoothstep(0.2, 0.4, y))
    c = mix(c, gold, smoothstep(0.4, 0.6, y))
    c = mix(c, line, smoothstep(0.6, HORIZON, y))
    c = mix(c, near, smoothstep(HORIZON, HORIZON + 0.015, y))
    c = mix(c, sea, smoothstep(HORIZON + 0.015, 0.85, y))
    mix(c, deep, smoothstep(0.85, 1.0, y))
}

/// The scene laid over the screen, filtered up from its own size, over its poster until it has
/// come up, under the page's veil: a shade in the bottom left corner, where the words and the
/// actions stand, so they read on any sky. The rest of the shot is left as it is drawn: nothing
/// above the middle of the screen is darkened by more than a few hundredths.
@fragment
fn laid(pixel: FragCoord, v: Veil, image: Texture<Rgba8>, smp: Sampler) -> vec4 {
    let uv = pixel.position.xy / v.size
    let c = mix(poster(uv.y), image.sample(smp, uv).xyz, v.shown)
    // Measured from the bottom left, in screen heights, so a wide screen keeps its words' corner
    // as dark as a narrow one.
    let aspect = v.size.x / v.size.y
    let from = vec2(uv.x * aspect, 1.0 - uv.y)
    // An ellipse a screen's height and a bit wide and half of one tall, round the corner...
    let reach = length(from / vec2(1.15, 0.58))
    let corner = 0.72 * (1.0 - smoothstep(0.0, 1.0, reach))
    // ...and a low band along the bottom, under the actions.
    let low = 0.3 * (1.0 - smoothstep(0.0, 0.26, from.y))
    let dark = (1.0 - (1.0 - corner) * (1.0 - low)) * v.veil
    vec4(c * (1.0 - dark), 1.0)
}

/// Angle `a` (rad) brought within -π to π: the short way round.
fn wrapped(a: f32) -> f32 {
    a - 6.2831853 * floor((a + 3.1415927) / 6.2831853)
}

/// Whether the account's chip is there to press: on the page, once its words are in.
pub fn chip_live(f: Front) -> bool {
    f.stage == Stage::Page && f.words >= 0.5
}

/// Whether the screen, `w` by `h` logical pixels, is a phone's.
fn phone(w: f32, h: f32) -> bool {
    min(w, h) < PHONE_SIDE
}

/// The scene's height next: smaller when the frames have run slow, larger again when quick, in
/// steps, at least a second and a half after the last change to go smaller and three to grow.
/// A screen that shows fewer than 60 frames a second (`base`, its quickest frame) is held to its
/// own pace, not to one it can't show.
fn budget(f: mut Front, height: f32) {
    let slow = max(SLOW, f.base * 1.25)
    let quick = max(QUICK, f.base * 1.06)
    let most = min(height, TALLEST)
    let least = min(SHORTEST, most)
    // A size that ran slow isn't tried again for a while: the scene would only pop between two.
    let ceiling = if f.time < f.ceiling_until { min(f.ceiling, most) } else { most }
    let since = f.time - f.resized_at
    let was = f.tall
    if f.spent > slow && since > 1.5 {
        // Too slow: step well under, and stay under that for a minute, so the scene settles at a
        // size it keeps instead of climbing back to the edge and falling off it again.
        f.tall = max(least, round(f.tall * 0.85 / 8.0) * 8.0)
        f.ceiling = f.tall
        f.ceiling_until = f.time + 60.0
    } else if f.spent < quick && since > 3.0 && f.tall < ceiling {
        f.tall = min(ceiling, round(f.tall * 1.12 / 8.0) * 8.0)
    }
    f.tall = clamp(f.tall, least, most)
    if f.tall != was {
        f.resized_at = f.time
        f.spent = (slow + quick) * 0.5
    }
}

/// Plays the page or the player's rowing for a frame, `width` by `height` pixels, `zoom` device
/// pixels to a logical one, under `account`'s chip and pages (on the page alone).
pub fn frame<A: Account>(
    f: mut Front,
    time: f32,
    width: u32,
    height: u32,
    zoom: f32,
    reduced: bool,
    account: mut A,
) -> Next {
    let start = match f.began {
        Some(t) => t,
        None => {
            f.began = Some(time)
            time
        },
    }
    let dt = clamp(time - start - f.time, 0.0, 0.25)
    f.time = time - start
    f.dt = dt
    f.reduced = reduced
    if f.drawings > 2 && dt > 0.0 {
        f.spent += (dt - f.spent) * 0.1
        // The screen's own frame: the quickest of each second's frames, a second at a time.
        f.quickest = min(f.quickest, dt)
        if f.time - f.window_began >= 1.0 {
            f.base = f.quickest
            f.quickest = 1.0
            f.window_began = f.time
        }
    }
    let k = zoom
    let (w, h) = (max(f32(width), 1.0), max(f32(height), 1.0))
    let on_phone = phone(w / k, h / k)
    for e in events() {
        if f.stage == Stage::Rowing {
            match e {
                Event::KeyDown { key: Key::Escape, .. } => back_to_page(mut f),
                Event::PadButton { button: PadButton::Start, pressed: true, .. } => {
                    back_to_page(mut f)
                },
                _ => input(mut f.scene, e),
            }
            continue
        }
        // Nothing of the page's is pressed before it shows, the account's chip included; once
        // its pages are open, they take every input.
        if f.words < 0.5 && !account.shown() {
            continue
        }
        if account.event(e) || account.shown() {
            continue
        }
        var chosen = NONE
        match e {
            Event::PointerMove { at, .. } => {
                f.pointer = Some(at)
                f.keyboard = false
            },
            Event::PointerDown { at, button: Button::Primary, .. } => {
                f.pointer = Some(at)
                f.pressed = action_at(f, at)
            },
            Event::PointerUp { at, button: Button::Primary, .. } => {
                let on = action_at(f, at)
                if on != NONE && on == f.pressed { chosen = on }
                f.pressed = NONE
            },
            Event::KeyDown { key, repeat: false, .. } => {
                if key == Key::Enter || key == Key::Space {
                    chosen = f.focus
                } else if key == Key::Tab || key == Key::Left || key == Key::Right {
                    // The first press shows the ring where the focus is; the next moves it.
                    if f.keyboard && !on_phone { f.focus = 1 - f.focus }
                    f.keyboard = true
                } else if key == Key::W || key == Key::Up {
                    // Rowing from the page is playing.
                    chosen = PLAY
                }
            },
            Event::PadButton { button, pressed: true, .. } => {
                if button == PadButton::South { chosen = f.focus }
                if button == PadButton::Left || button == PadButton::Right {
                    if f.keyboard && !on_phone { f.focus = 1 - f.focus }
                    f.keyboard = true
                }
                if button == PadButton::Up { chosen = PLAY }
            },
            _ => {},
        }
        if chosen == ONLINE {
            return Next::Online
        }
        if chosen == PLAY && !on_phone {
            // At once, so the rest of this frame's input rows: and a stroke that chose it is
            // the first.
            f.stage = Stage::Rowing
            f.rowed = 0.0
            f.pressed = NONE
            input(mut f.scene, e)
        }
    }
    if on_phone { f.focus = ONLINE }
    // The scene, once the sky has cooked, comes up over its poster; the words just after it, or
    // over the poster if the scene is slow to come (a cold load compiles its shaders first).
    f.drawings += 1
    if f.cooked {
        f.since += dt
    }
    let rise = if reduced { 0.4 } else { RISE }
    f.shown = smoothstep(0.0, 1.0, clamp(f.since / rise, 0.0, 1.0))
    let due = f.since > rise * WORDS_AFTER || f.time > WORDS_WAIT
    // (Under the account's pages, the page's own words step back: one thing to read at a time.)
    let words_target = if f.stage == Stage::Page && due && !account.shown() { 1.0 } else { 0.0 }
    let pace = if words_target > f.words { if f.since < rise { rise * 0.8 } else { RETURN } } else {
        LEAVE
    }
    f.words = kit::ease(f.words, words_target, dt, seconds: pace)
    if f.stage == Stage::Rowing {
        if abs(way(f.scene)) > 0.25 { f.rowed += dt }
        let target = if f.rowed < KEYS_FOR && f.words < 0.05 { 1.0 } else { 0.0 }
        f.keys = kit::ease(f.keys, target, dt, seconds: 0.5)
    } else {
        f.keys = kit::ease(f.keys, 0.0, dt, seconds: 0.2)
    }
    budget(mut f, h)
    // A new size is drawn once it has held (`SETTLE`), or at once for the first drawing.
    let tall = f.tall
    let asked = (u32(max(round(tall * w / h), 1.0)), u32(tall))
    if asked != f.asked {
        f.asked = asked
        f.asked_since = f.time
    }
    if f.drawn_at == (0, 0) || f.time - f.asked_since > SETTLE {
        f.drawn_at = f.asked
    }
    let (wide, high) = f.drawn_at
    let bearing = if f.stage == Stage::Page { -swung(f.scene) } else { 0.0 }
    f.orbit = if reduced { bearing } else {
        f.orbit + wrapped(bearing - f.orbit) * (1.0 - exp(-dt / SWING))
    }
    if play(mut f.scene, f.time, wide, high, orbit: f.orbit, bands: BANDS) && ready(f.scene) {
        f.cooked = true
    }
    // The page's words, the actions, and the account's chip and pages over them.
    f.list.clear(vec2(w, h))
    var hand = false
    if f.words > 0.001 {
        hand = draw_page(mut f, w, h, k, on_phone)
    }
    if f.keys > 0.001 {
        draw_keys(mut f, w, h, k)
    }
    if f.stage == Stage::Page {
        // The chip comes and goes with the words; the pages, once opened, are wholly there.
        f.list.alpha = if account.shown() { 1.0 } else { clamp(f.words * 1.5, 0.0, 1.0) }
        account.draw(mut f.list, f.fonts, width, height)
        f.list.alpha = 1.0
    }
    f.renderer.fetch(mut f.fonts, f.list)
    f.renderer.upload(f.list)
    let veil = Veil { size: vec2(w, h), shown: f.shown, veil: f.words }
    let pass = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(pass, cover, laid.bind(v: veil, image: f.scene.image, smp: f.smp), vertices: 3)
    f.renderer.draw(pass, vec2(w, h))
    pass.present()
    Next::Stay { hand }
}

/// Back to the page from rowing: the hands off the paddle, the focus on Play.
fn back_to_page(f: mut Front) {
    release(mut f.scene)
    f.stage = Stage::Page
    f.focus = PLAY
    f.pressed = NONE
}

/// The action under `at`, or `NONE`.
fn action_at(f: Front, at: vec2) -> u32 {
    for i in 0..f.rects.len() {
        if f.rects[i].contains(at) { return i }
    }
    NONE
}

/// `text` in `face` at `size` with `tracking` ems between its letters, its top left at `at`:
/// its width.
fn spaced(
    f: mut Front,
    face: Face,
    text: str,
    size: f32,
    at: vec2,
    color: vec4,
    tracking: f32,
    weight: f32 = -1.0,
) -> f32 {
    var x = at.x
    for i in 0..text.len() {
        let letter = text.slice(i, i + 1)
        let advance = f.fonts.font(face).measure(letter, size)
        let _ = f.list.text(
            f.fonts,
            face,
            letter,
            size,
            vec2(round(x), at.y),
            color,
            weight: weight,
        )
        x += advance + (if i + 1 < text.len() { tracking * size } else { 0.0 })
    }
    x - at.x
}

/// One of the page's actions over `r`: Play solid in warm ivory, the one to press; Play online in
/// dark glass beside it. Its hover lifts it two pixels, and the keyboard's focus rings it in ivory.
fn action(f: mut Front, i: u32, r: Rect, label: str, k: f32) {
    let hover = f.hovers[i]
    let pressed = f.pressed == i && hover > 0.5
    let radius = kit::RADIUS * k
    let was = f.list.alpha
    let lifted = Rect::new(r.x, r.y - (if pressed { 0.0 } else {
        round(hover * 2.0 * k)
    }), r.w, r.h)
    let ink = if i == PLAY {
        // Its shadow comes with the hover, as if it rose off the page.
        f.list.alpha = was * hover
        kit::shadow(mut f.list, lifted, radius, k)
        f.list.alpha = was
        let fill = if pressed { PLAY_FILL * vec4(0.92, 0.92, 0.92, 1.0) } else {
            mix(PLAY_FILL, PLAY_HOVER, hover)
        }
        f.list.rect(lifted, fill, radius)
        PLAY_INK
    } else {
        f.list.rect(lifted, if pressed { GLASS } else { mix(GLASS, GLASS_HOVER, hover) }, radius)
        f.list.ring(lifted, GLASS_EDGE, radius, width: max(round(k), 1.0))
        IVORY
    }
    if f.keyboard && f.focus == i {
        let gap = round(4.0 * k)
        f.list.ring(lifted.shrink(-gap), IVORY, radius + gap, width: max(round(2.0 * k), 2.0))
    }
    let px = 16.0 * k
    let tw = f.fonts.font(Face::Sans).measure(label, px)
    let top = kit::centred_top(f.fonts, lifted.y + lifted.h * 0.5, px)
    let _ = f.list.text(
        f.fonts,
        Face::Sans,
        label,
        px,
        vec2(round(lifted.x + (lifted.w - tw) * 0.5), top),
        ink,
        weight: kit::SEMIBOLD,
    )
}

/// The page's words and actions at its bottom left, rising in as they come: the game's name in
/// Wrela Facet, wholly under the horizon; the line under it; and Play and Play online (on a
/// phone, Play online alone, and the line says where Play is). Whether the pointer is over an
/// action.
fn draw_page(f: mut Front, w: f32, h: f32, k: f32, on_phone: bool) -> bool {
    let fade = f.words
    let eased = fade * fade * (3.0 - 2.0 * fade)
    let lift = if f.reduced { 0.0 } else { (1.0 - eased) * 10.0 * k }
    f.list.alpha = eased
    let margin = round(clamp(min(w, h) * 0.075, 24.0 * k, 72.0 * k))
    let bottom = h - round(clamp(h * 0.05, 24.0 * k, 48.0 * k))
    // The actions, a row along the bottom.
    let bh = round(48.0 * k)
    let top = round(bottom - bh + lift)
    var hand = false
    f.rects.clear()
    var x = margin
    for i in 0..2 {
        if on_phone && i == PLAY {
            // Rowing needs keys: on a phone, Play isn't there to press.
            f.rects.push(Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0))
            continue
        }
        let label = ACTIONS[i]
        let tw = f.fonts.font(Face::Sans).measure(label, 16.0 * k)
        let bw = round(max(tw + 56.0 * k, (if i == PLAY { 156.0 } else { 0.0 }) * k))
        let r = Rect::new(x, top, bw, bh)
        f.rects.push(r)
        let over = match f.pointer {
            Some(p) => r.contains(p),
            None => false,
        }
        if over && !f.keyboard { hand = true }
        f.hovers[i] = kit::ease(f.hovers[i], if over && !f.keyboard { 1.0 } else { 0.0 }, f.dt)
        action(mut f, i, r, label, k)
        x += bw + round(12.0 * k)
    }
    // Above them, the line, and the name standing on it.
    let line_size = 17.0 * k
    let line_top = round(top - 18.0 * k - line_size * 1.2)
    let (long, short) = if on_phone {
        ("Play offline on a computer, with a keyboard or a gamepad.", "Play offline on a computer.")
    } else {
        ("You wake on a skiff. The sea goes on forever.", "The sea goes on forever.")
    }
    let fits = f.fonts.font(Face::Sans).measure(long, line_size) <= w - margin * 2.0
    let _ = f.list.text(
        f.fonts,
        Face::Sans,
        if fits { long } else { short },
        line_size,
        vec2(margin, line_top),
        vec4(IVORY.xyz, 0.86),
    )
    // The name: Facet's capitals stand 0.70 em on their baseline, with nothing under it. As large
    // as fits between the line and the horizon (with room to breathe under the sea's line) and
    // across the screen, up to a cap height of 100 pixels; sized where it rests, so it keeps its
    // size as it rises in. A screen too short for it under the horizon (a phone on its side)
    // sets it by its width alone, over the sea's line.
    let baseline = line_top - round(16.0 * k)
    let resting = baseline - round(lift)
    let horizon = h * HORIZON + 20.0 * k
    let width_at_one = f.fonts.font(Face::Mono).measure("WRELA", 1.0) + 4.0 * 0.02
    let across = (w - margin * 2.0) / width_at_one
    let under = (resting - horizon) / facet_cap()
    let room = if under >= 40.0 * k { min(under, across) } else { across }
    let size = round(clamp(room, 24.0 * k, 100.0 * k / facet_cap()))
    let name_top = baseline - f.fonts.font(Face::Mono).ascender * size
    // Facet sets its letters a little in from the pen: the W's foot lines up with the words.
    let at = vec2(margin - round(size * 0.095), name_top)
    let _ = spaced(mut f, Face::Mono, "WRELA", size, at, IVORY, 0.02)
    f.list.alpha = 1.0
    hand
}

/// Facet's capitals' height, in ems (ui/brand/facet.wrela's `CAP`).
fn facet_cap() -> f32 {
    0.70
}

/// The rowing's keys, bottom left, while the player finds them: each key in a small cap, and
/// what it does.
fn draw_keys(f: mut Front, w: f32, h: f32, k: f32) {
    let alpha = f.keys
    f.list.alpha = alpha
    let pairs: [(Text, Text); 4] = [
        ("W", "Row"),
        ("A  D", "Steer"),
        ("S", "Back water"),
        ("Esc", "Menu"),
    ]
    let size = 13.0 * k
    let cap_h = round(24.0 * k)
    let pad = 8.0 * k
    var total = 0.0
    for p in pairs {
        let kw = max(f.fonts.font(Face::Sans).measure(p.0, size) + pad * 2.0, cap_h)
        total += kw + 8.0 * k + f.fonts.font(Face::Sans).measure(p.1, size) + 22.0 * k
    }
    total -= 22.0 * k
    // At the bottom left, where the page's actions stood: the skiff is in the middle.
    let margin = round(clamp(min(w, h) * 0.075, 24.0 * k, 72.0 * k))
    let y = round(h - margin - cap_h + 10.0 * k)
    var x = margin + round(14.0 * k)
    // A quiet plate under them, so they read over bright water.
    let plate = Rect::new(x - 14.0 * k, y - 10.0 * k, total + 28.0 * k, cap_h + 20.0 * k)
    f.list.rect(plate, vec4(0.0, 0.0, 0.0, 0.42), kit::RADIUS * k + 4.0 * k)
    for p in pairs {
        let kw = round(max(f.fonts.font(Face::Sans).measure(p.0, size) + pad * 2.0, cap_h))
        let cap = Rect::new(x, y, kw, cap_h)
        f.list.rect(cap, vec4(1.0, 1.0, 1.0, 0.1), 5.0 * k)
        f.list.ring(cap, vec4(1.0, 1.0, 1.0, 0.22), 5.0 * k, width: max(round(k), 1.0))
        let tw = f.fonts.font(Face::Sans).measure(p.0, size)
        let top = kit::centred_top(f.fonts, y + cap_h * 0.5, size)
        let _ = f.list.text(
            f.fonts,
            Face::Sans,
            p.0,
            size,
            vec2(round(x + (kw - tw) * 0.5), top),
            kit::FG,
            weight: kit::MEDIUM,
        )
        x += kw + 8.0 * k
        let _ = f.list.text(
            f.fonts,
            Face::Sans,
            p.1,
            size,
            vec2(round(x), top),
            vec4(kit::FG.xyz, 0.8),
        )
        x += f.fonts.font(Face::Sans).measure(p.1, size) + 22.0 * k
    }
    f.list.alpha = 1.0
}
