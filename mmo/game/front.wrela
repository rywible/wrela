// wrela.dev's front page, which is the game's first screen: the opening (scenes/opening) plays
// live, a skiff adrift on the open sea under the floating cathedral, with the game's name and
// one action, Play (Continue once this device has a save), at the bottom left; the account's
// chip stands in the corner. There's no load screen: the page holds black until the scene's
// first drawing is ready, then the scene comes up out of it and the name after it.
//
// Play hands the skiff to the player where it floats, with no account and nothing online, and
// the camera rises from the page's shot to the player's, up behind the skiff (`Rig::framing`).
// Escape (or a pad's Start) pauses: a menu over the dimmed scene to resume, play online (the
// MMO's client, client.wrela, which signs in or makes an account), or go back to the title, and
// the controls. Where the skiff is, is saved on this device as the player rows (`SAVE`).
//
// The scene is drawn smaller than the screen when the device can't keep up (`budget`), then laid
// over the whole screen under the page's veil: a shade in the bottom left corner under the name
// while the page shows, and the scene dimmed under the pause menu.

use client::Account
use opening::played::{State as Scene, input, play, put, ready, release, scene, swung, whereabouts}
use platform::session::answer_of
use std::gpu::{
    ClipPosition, FragCoord, Rgba8, Sampler, Texture, VertexIndex, begin_screen_pass, draw, sampler,
}
use std::input::{Button, Event, Key, PadButton, events}
use std::collections::replace
use std::io::{Pending, load, store}
use ui::draw::{DrawList, Rect, Renderer}
use ui::kit
use ui::text::{Face, Fonts}
use brand::charter::CAP

/// What the page is doing: showing the title over the scene, the player rowing, or paused.
pub enum Stage: Copy + Eq { Page, Rowing, Paused }

/// What a frame of the page asks of the program it's in.
pub enum Next: Copy + Eq {
    /// Stay, with the pointer's shape: a hand over what can be pressed.
    Stay { hand: bool },
    /// The player chose to play online: the MMO's client takes the screen.
    Online,
}

// The actions, by what they do: the title's Play, and the pause menu's.
const PLAY: u32 = 0
const RESUME: u32 = 1
const ONLINE: u32 = 2
const TITLE: u32 = 3
const NONE: u32 = 4294967295
/// The pause menu's actions, top to bottom, and what each says.
const MENU: [u32; 3] = [RESUME, ONLINE, TITLE]
const MENU_LABELS: [Text; 3] = ["Resume", "Play online", "Title screen"]

/// The bands of rows a drawing of the scene is painted in, one a frame (`play`).
const BANDS: u32 = 1
/// The opening: the name comes up over black at once (`NAME_AT` seconds in), a title card while
/// the sky cooks; the scene then rises behind it (`RISE` seconds once its first drawing is
/// ready), and Play comes in `CONTROLS_AFTER` of the way through that, or over the black anyway
/// after `WORDS_GIVE_UP` seconds if the scene never does.
const NAME_AT: f32 = 0.35
const RISE: f32 = 2.4
const CONTROLS_AFTER: f32 = 0.55
const WORDS_GIVE_UP: f32 = 12.0
/// Seconds the name takes to come up over the black.
const NAME_IN: f32 = 1.4
/// Seconds the words take to go as the player takes the helm, and to come back.
const LEAVE: f32 = 0.45
const RETURN: f32 = 0.6
/// Seconds the camera takes to rise from the page's shot to the player's, and to come back down.
const DOLLY: f32 = 1.6
/// Seconds the camera takes (as a time constant) to swing back to the page's bearing, and away.
const SWING: f32 = 0.6
/// Seconds the pause menu takes to come and go.
const MENU_FADE: f32 = 0.18

/// Where the skiff's whereabouts are kept on this device ("x z heading", metres and radians), and
/// the seconds between saves while the player rows.
const SAVE: Text = "mmo/skiff"
const SAVE_EVERY: f32 = 10.0

/// The tallest the scene is drawn (pixels), and the shortest the budget takes it to.
const TALLEST: f32 = 1440.0
const SHORTEST: f32 = 360.0
/// Seconds a size that ran slow isn't tried again; doubled each time growing back to it fails
/// again, up to `CEILING_MOST`. And the seconds after a growth within which slow frames are put
/// down to it (`stepped`).
const CEILING: f32 = 60.0
const CEILING_MOST: f32 = 480.0
const PROBE: f32 = 10.0
/// Seconds late frames are counted over: three more in it than before a growth are a growth too
/// far, however quick the frames between them (`stepped`).
const LATE_WINDOW: f32 = 3.0
/// How much the scene's drawing is sharpened as it's laid over the screen (`laid`).
const SHARPEN: f32 = 0.45
/// Seconds a new size of the scene's must hold before it's drawn at it: a window being dragged
/// keeps the last drawing, stretched, instead of beginning one each frame and finishing none.
const SETTLE: f32 = 0.2

/// Where the horizon lies on the screen in the page's shot (a fraction of its height, from the
/// top): the name stands wholly under it where the screen is tall enough, so the sea's line
/// never cuts through its letters.
const HORIZON: f32 = 0.712

/// The page's colours: the name's warm ivory, the main action's fill and its hover, and the ink
/// on it.
const IVORY = vec4(0.957, 0.922, 0.867, 1.0)
const PLAY_FILL = vec4(0.965, 0.937, 0.890, 1.0)
const PLAY_HOVER = vec4(1.0, 0.969, 0.910, 1.0)
const PLAY_INK = vec4(0.090, 0.071, 0.047, 1.0)
/// The quieter actions' glass: a dark fill and a faint edge, so they read on any sky.
const GLASS = vec4(0.039, 0.047, 0.071, 0.45)
const GLASS_HOVER = vec4(0.039, 0.047, 0.071, 0.62)
const GLASS_EDGE = vec4(1.0, 1.0, 1.0, 0.18)
/// The pause menu's panel.
const PANEL = vec4(0.035, 0.039, 0.055, 0.82)
const MUTED = vec4(0.957, 0.922, 0.867, 0.62)

/// A screen narrower or shorter than this (logical pixels) is a phone's: the skiff needs keys.
const PHONE_SIDE: f32 = 520.0

/// What the veil's shader reads: the screen's size, how far the scene has come up out of black,
/// how much of the page's shade lies over it, and how far it's dimmed under the pause menu.
pub struct Veil: Copy + GpuData {
    pub size: vec2,
    pub shown: f32,
    pub veil: f32,
    pub dim: f32,
    /// A texel of the scene's drawing, across and down (in the screen's 0 to 1).
    pub texel: vec2,
}

/// How many of the latest frames the readout keeps (two seconds of a screen that shows 120).
const HEARD: u32 = 240
/// How often the readout's numbers are worked out afresh (s): often enough to follow, seldom
/// enough to read.
const READ_EVERY: f32 = 0.5

/// What the page's frames really did, for a person to read on the page itself (the backquote
/// key shows it): the time each of the latest frames took, and what they come to. Nothing of it
/// leaves the page.
pub struct Readout {
    shown: bool,
    /// The latest frames' times (s), the next written at `at`; how long since the numbers were
    /// last worked out (s).
    took: Vec<f32>,
    at: u32,
    since: f32,
    /// The numbers as last worked out.
    read: Read,
}

/// A readout's numbers: new images a second, the middle frame's time and the slow ones' (the
/// 95th of a hundred, the slowest; ms), and how many of the frames kept were late (took half
/// again the screen's own frame or more: a frame the screen showed twice).
pub struct Read: Copy {
    pub rate: f32,
    pub middle: f32,
    pub slow: f32,
    pub slowest: f32,
    pub late: u32,
    pub of: u32,
}

/// What frames that took `took` (s each, in any order) come to, on a screen whose own frame
/// takes `base` s.
pub fn read(took: Vec<f32>, base: f32) -> Read {
    let n = took.len()
    if n == 0 { return Read { rate: 0.0, middle: 0.0, slow: 0.0, slowest: 0.0, late: 0, of: 0 } }
    var sorted = took.clone()
    sorted.sort_by(|a, b| a < b)
    var sum = 0.0
    for t in sorted { sum += t }
    let middle = sorted[n / 2]
    var late = 0
    for t in sorted { if t >= base * 1.5 { late += 1 } }
    Read {
        rate: if sum > 0.0 { f32(n) / sum } else { 0.0 },
        middle: middle * 1000.0,
        slow: sorted[min(n * 95 / 100, n - 1)] * 1000.0,
        slowest: sorted[n - 1] * 1000.0,
        late,
        of: n,
    }
}

impl Readout {
    pub fn new() -> Readout {
        Readout {
            shown: false,
            took: Vec::new(),
            at: 0,
            since: READ_EVERY,
            read: read(Vec::new(), 1.0),
        }
    }

    /// A frame took `dt` s, on a screen whose own frame takes `base` s.
    pub fn hear(mut self, dt: f32, base: f32) {
        if self.took.len() < HEARD {
            self.took.push(dt)
        } else {
            self.took[self.at] = dt
            self.at = (self.at + 1) % HEARD
        }
        self.since += dt
        if self.shown && self.since >= READ_EVERY {
            self.read = read(self.took, base)
            self.since = 0.0
        }
    }

    /// Shown if it wasn't, hidden if it was: its numbers worked out as it comes.
    pub fn toggle(mut self, base: f32) {
        self.shown = !self.shown
        if self.shown {
            self.read = read(self.took, base)
            self.since = 0.0
        }
    }
}

@test
fn a_readout_reads_a_steady_pace_and_counts_its_late_frames() {
    // Two seconds on a screen that shows 120: every tenth frame of the first second takes two
    // frames' time, and the last twenty of the second take three.
    let base = 1.0 / 120.0
    var r = Readout::new()
    for i in 0..HEARD {
        r.hear(if i >= HEARD - 20 { 3.0 * base } else if i < 120 && i % 10 == 9 {
            2.0 * base
        } else {
            base
        }, base)
    }
    // (Hidden, it works nothing out; shown, at once.)
    assert(r.read.of == 0)
    r.toggle(base)
    let got = r.read
    assert(got.of == HEARD && got.late == 32, f"{got.late} late of {got.of}")
    assert(abs(got.middle - 1000.0 * base) < 0.01, f"{got.middle} ms")
    // The 95th of a hundred is among the twenty slowest (the 228th of 240), the two-frame ones
    // under it.
    assert(abs(got.slow - 3000.0 * base) < 0.01, f"{got.slow} ms")
    assert(abs(got.slowest - 3000.0 * base) < 0.01, f"{got.slowest} ms")
    assert(abs(got.rate - 240.0 / (292.0 * base)) < 0.1, f"{got.rate} a second")
    // It keeps only the latest: a steady 60 after that reads as 60, and on this screen every
    // one of those frames was shown twice.
    for _ in 0..HEARD { r.hear(2.0 * base, base) }
    let after = read(r.took, base)
    assert(abs(after.rate - 60.0) < 0.01 && after.late == HEARD, f"{after.rate} a second")
    // On a screen that shows 60, none is late.
    assert(read(r.took, 2.0 * base).late == 0)
}

pub struct Front {
    scene: Scene,
    smp: Sampler,
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    pub stage: Stage,
    /// The time the page began (s), and the frames it has drawn.
    began: Option<f32>,
    time: f32,
    dt: f32,
    drawings: u32,
    /// The scene has inked a drawing under a sky cooked whole: it may show.
    cooked: bool,
    /// How far the scene has come up out of black (0 to 1), the title is in (0 to 1, which is
    /// how much of the shade lies over the scene), and the pause menu.
    shown: f32,
    words: f32,
    menu: f32,
    /// How far the title's controls (Play, the account's chip) are in, 0 to 1: they come once the
    /// scene is up, after the name.
    controls: f32,
    /// Seconds since the scene first showed.
    since: f32,
    /// The budget of the scene's height (`stepped`), and the shortest a frame takes here (the
    /// screen's own pace, `budget`).
    budget: Budget,
    base: f32,
    quickest: f32,
    window_began: f32,
    window_frames: u32,
    /// The size the scene is drawn at, the size last asked for, and since when (`SETTLE`).
    drawn_at: (u32, u32),
    asked: (u32, u32),
    asked_since: f32,
    /// The actions as last drawn (each one's id and rectangle), their hovers by id, the one
    /// pressed, the keyboard's focus (shown once the keyboard moves it), and the pointer.
    rects: Vec<(u32, Rect)>,
    hovers: Vec<f32>,
    pressed: u32,
    focus: u32,
    keyboard: bool,
    pointer: Option<vec2>,
    /// Where the camera stands (`Rig::framing`: 0 the page's shot, 1 the player's), and how far
    /// the page swings it round the skiff (rad): back to the opening's bearing while the title
    /// shows, so the cathedral stands where it did wherever the player rowed.
    framing: f32,
    orbit: f32,
    /// This device's save: being read, being written, whether there was one (Play says
    /// Continue), and when it was last written (s).
    save_load: Option<Pending<u8>>,
    save_write: Option<Pending<u8>>,
    save_next: Option<Vec<u8>>,
    online: bool,
    saved: bool,
    saved_at: f32,
    reduced: bool,
    /// The readout (`Readout`), shown or not (the backquote key).
    readout: Readout,
}

/// The page, its scene not yet drawn, in `fonts`: the console's, whose third face
/// (`Face::Display`) is its display face, Wrela Charter (ui/brand/charter.wrela), for the name.
pub fn init(fonts: take Fonts) -> Front {
    let renderer = Renderer::new(fonts)
    Front {
        scene: scene(width: 640, height: 360),
        smp: sampler(),
        fonts,
        renderer,
        list: DrawList::new(),
        stage: Stage::Page,
        began: None,
        time: 0.0,
        dt: 0.0,
        drawings: 0,
        cooked: false,
        shown: 0.0,
        words: 0.0,
        menu: 0.0,
        controls: 0.0,
        since: 0.0,
        budget: Budget {
            tall: 720.0,
            spent: 1.0 / 60.0,
            dt: 1.0 / 60.0,
            before: 1.0 / 60.0,
            resized_at: 0.0,
            ceiling: TALLEST,
            ceiling_until: 0.0,
            ceiling_for: CEILING,
            grew_at: -PROBE,
            grew_from: 720.0,
            probing: false,
            late: 0,
            lately: 0,
            late_from: 0.0,
            peak: 0,
            noise: 0,
            fresh_at: 0.0,
        },
        base: 1.0 / 60.0,
        quickest: 1.0,
        window_began: 0.0,
        window_frames: 0,
        drawn_at: (0, 0),
        asked: (0, 0),
        asked_since: 0.0,
        rects: Vec::new(),
        hovers: Vec::from([0.0, 0.0, 0.0, 0.0]),
        pressed: NONE,
        focus: PLAY,
        keyboard: false,
        pointer: None,
        framing: 0.0,
        orbit: 0.0,
        save_load: Some(load(SAVE)),
        save_write: None,
        save_next: None,
        online: false,
        saved: false,
        saved_at: 0.0,
        reduced: false,
        readout: Readout::new(),
    }
}

/// One triangle that covers the screen.
@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// The scene laid over the screen, filtered up from its own size and sharpened, up out of black
/// as it comes, under the page's veil: a shade in the bottom left corner, where the name and
/// Play stand, so they read on any sky (the rest of the shot left as it's drawn: nothing above the middle of
/// the screen darkened by more than a few hundredths); and dimmed under the pause menu.
@fragment
fn laid(pixel: FragCoord, v: Veil, image: Texture<Rgba8>, smp: Sampler) -> vec4 {
    let uv = pixel.position.xy / v.size
    // Filtered up by Catmull-Rom's cubic (five bilinear reads, the corners' share dropped), which
    // keeps the cathedral's edges crisp drawn smaller than the screen where a straight bilinear
    // smears them; then sharpened a little against its neighbours a texel off, the more the
    // further it's stretched.
    let t = v.texel
    let at = uv / t - vec2(0.5)
    let base = floor(at)
    let f = at - base
    let w0 = f * (-0.5 + f * (1.0 - 0.5 * f))
    let w1 = 1.0 + f * f * (-2.5 + 1.5 * f)
    let w2 = f * (0.5 + f * (2.0 - 1.5 * f))
    let w3 = f * f * (-0.5 + 0.5 * f)
    let w12 = w1 + w2
    let o12 = w2 / w12
    let p0 = (base - vec2(0.5)) * t
    let p3 = (base + vec2(2.5)) * t
    let p12 = (base + vec2(0.5) + o12) * t
    let cubic = image.sample(smp, vec2(p12.x, p0.y)).xyz * (w12.x * w0.y) +
        image.sample(smp, vec2(p0.x, p12.y)).xyz * (w0.x * w12.y) +
        image.sample(smp, p12).xyz * (w12.x * w12.y) +
        image.sample(smp, vec2(p3.x, p12.y)).xyz * (w3.x * w12.y) +
        image.sample(smp, vec2(p12.x, p3.y)).xyz * (w12.x * w3.y)
    let middle = cubic / (w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y)
    let round_it = (image.sample(smp, uv + vec2(t.x, 0.0)).xyz +
        image.sample(smp, uv - vec2(t.x, 0.0)).xyz +
        image.sample(smp, uv + vec2(0.0, t.y)).xyz +
        image.sample(smp, uv - vec2(0.0, t.y)).xyz) *
        0.25
    let stretch = clamp(t.y * v.size.y - 1.0, 0.0, 1.0)
    let c = max(middle + (middle - round_it) * (SHARPEN * (0.5 + stretch)), vec3(0.0)) * v.shown
    // Measured from the bottom left, in screen heights, so a wide screen keeps its words' corner
    // as dark as a narrow one.
    let aspect = v.size.x / v.size.y
    let from = vec2(uv.x * aspect, 1.0 - uv.y)
    // An ellipse a screen's height and a bit wide and half of one tall, round the corner...
    let reach = length(from / vec2(1.15, 0.58))
    let corner = 0.62 * (1.0 - smoothstep(0.0, 1.0, reach))
    // ...and a low band along the bottom, under the action.
    let low = 0.25 * (1.0 - smoothstep(0.0, 0.22, from.y))
    let dark = (1.0 - (1.0 - corner) * (1.0 - low)) * v.veil
    vec4(c * (1.0 - dark) * (1.0 - 0.5 * v.dim), 1.0)
}

/// Angle `a` (rad) brought within -π to π: the short way round.
fn wrapped(a: f32) -> f32 {
    a - 6.2831853 * floor((a + 3.1415927) / 6.2831853)
}

/// Whether the account's chip is there to press: on the title, once its words are in.
pub fn chip_live(f: Front) -> bool {
    f.stage == Stage::Page && min(f.words, f.controls) >= 0.5
}

/// Whether the screen, `w` by `h` logical pixels, is a phone's.
fn phone(w: f32, h: f32) -> bool {
    min(w, h) < PHONE_SIDE
}

/// Whether a window of `frames` frames, its quickest `quickest` seconds, mostly kept that pace:
/// at least 85% of a second's worth of its frames.
fn kept_pace(frames: u32, quickest: f32) -> bool {
    f32(frames) * quickest >= 0.85
}

/// Calibrates to the first window, including a 30 Hz screen, then keeps the quickest cadence
/// observed: a heavier scene must not redefine its own slow frames as the screen's pace.
/// Frame times alone cannot distinguish a screen from rendering already slow at startup.
fn frame_base(base: f32, quickest: f32, first: bool) -> f32 {
    if first { quickest } else { min(base, quickest) }
}

/// The slow and quick frame limits for the observed screen cadence: the screen's own pace, a new
/// drawing every frame it shows, 120 a second on a screen that shows 120.
/// Under the title as rowing. (The title was held to 30 a second and drawn sharp instead. But
/// its slow limit was a steady 30's own frame time on a 60 Hz screen, which it could never keep
/// under: there the title shrank until it ran at 60, and only a 120 Hz screen showed it sharp
/// at 30 to 40. One rule for every screen, and no change of pace at Play.)
fn frame_limits(base: f32) -> (f32, f32) {
    (base * 1.25, base * 1.06)
}

@test
fn one_quick_frame_among_steady_sixty_is_not_the_screens_pace() {
    // A 60 Hz screen's window: 60 frames, one of them 12 ms (a late frame's follower).
    assert(!kept_pace(60, quickest: 0.012), "one quick frame doesn't make a 83 Hz screen")
    assert(kept_pace(60, quickest: 1.0 / 60.0), "a steady 60 is a 60 Hz screen")
    assert(kept_pace(118, quickest: 1.0 / 120.0), "a steady 120 is a 120 Hz screen")
    assert(kept_pace(30, quickest: 1.0 / 30.0), "a steady 30 is a 30 Hz screen")
}

@test
fn front_slow_rendering_cannot_relax_a_previously_observed_frame_budget() {
    let initial = 1.0 / 60.0
    // A native 30 Hz screen is calibrated by its first window, instead of being forced
    // to the initial 60 Hz guess and having its resolution needlessly reduced.
    let native30 = frame_base(initial, quickest: 1.0 / 30.0, first: true)
    assert(native30 == 1.0 / 30.0)
    let steady30 = frame_base(native30, quickest: 1.0 / 30.0, first: false)
    let (slow30, _) = frame_limits(steady30)
    assert(1.0 / 30.0 < slow30, "a steady 30 Hz screen is within its budget")
    // Once 60 Hz was seen, later windows taking 50 ms are slow rendering. The budget (the
    // title's and the rowing's are one) must reduce resolution, rather than growing it at the
    // new pace.
    var known60 = frame_base(initial, quickest: initial, first: true)
    for _ in 0..4 {
        known60 = frame_base(known60, quickest: 0.05, first: false)
    }
    let (slow, quick) = frame_limits(known60)
    assert(0.05 > slow && 0.05 > quick, "slow rendering must lower resolution")
    // And a title at 30 a second on that screen is slow too: it's drawn smaller, to keep 60.
    assert(1.0 / 30.0 > slow, "the title keeps the screen's pace")
}

/// The budget of the scene's height: the height it would draw the scene at (pixels); the frames'
/// average seconds, and the last two frames' own; when it last changed the height (s); the size
/// that last ran slow (kept under until `ceiling_until`, `ceiling_for` seconds at a time); its
/// last growth: when (s), from what height, and whether it's still on trial (`PROBE`); and the
/// late frames counted since `late_from` (s), in the `LATE_WINDOW` before, the most in one of
/// late (`peak`, one fewer each window), and before the last growth (`noise`: the late frames
/// that aren't the size's doing); and when it was begun afresh (s).
struct Budget: Copy {
    tall: f32,
    spent: f32,
    dt: f32,
    before: f32,
    resized_at: f32,
    ceiling: f32,
    ceiling_until: f32,
    ceiling_for: f32,
    grew_at: f32,
    grew_from: f32,
    probing: bool,
    late: u32,
    lately: u32,
    late_from: f32,
    peak: u32,
    noise: u32,
    fresh_at: f32,
}

/// A budget at `tall`, its frames so far taking `spent` seconds.
fn budget_at(tall: f32, spent: f32) -> Budget {
    Budget {
        tall,
        spent,
        dt: spent,
        before: spent,
        resized_at: -10.0,
        ceiling: TALLEST,
        ceiling_until: 0.0,
        ceiling_for: CEILING,
        grew_at: -PROBE,
        grew_from: tall,
        probing: false,
        late: 0,
        lately: 0,
        late_from: 0.0,
        peak: 0,
        noise: 0,
        fresh_at: -10.0,
    }
}

/// The budget once a frame has taken `dt` seconds, at `time` (s), against a pace whose slow
/// limit is `slow` (`frame_limits`).
/// A frame counts for 2.4 of the limit at most (three of the screen's): one long frame, a
/// tab come back to or a pause of the browser's, is not a slow scene, and counted whole it cut
/// the scene's size for a minute. And a frame a fifth over the limit (a whole frame of the
/// screen's over the pace) is counted late: a scene a little too slow can show as one late
/// frame among several on time, which the average takes for quick enough.
fn heard(from: Budget, dt: f32, slow: f32, time: f32) -> Budget {
    var b = from
    b.before = b.dt
    b.dt = dt
    b.spent += (min(dt, 2.4 * slow) - b.spent) * 0.1
    if time >= b.late_from {
        if time - b.late_from >= LATE_WINDOW {
            b.lately = b.late
            b.peak = max(b.late, if b.peak > 0 { b.peak - 1 } else { 0 })
            b.late = 0
            b.late_from = time
        }
        if dt > slow * 1.2 {
            b.late += 1
        }
    }
    b
}

/// The budget begun afresh at `time`, at the size it has: what ran slow in another shot (the
/// title's, or the rowing's) doesn't hold it under, and slow frames now aren't put down to a
/// growth made then. (It doesn't grow for two and a half seconds: its late frames are counted
/// first, to judge a growth by.)
fn afresh(from: Budget, time: f32) -> Budget {
    var b = from
    b.ceiling_until = 0.0
    b.ceiling_for = CEILING
    b.grew_at = time - PROBE
    b.probing = false
    b.late = 0
    b.lately = 0
    b.late_from = time
    b.peak = 0
    b.noise = 0
    b.fresh_at = time
    b
}

/// The budget kept as it is at `time` while the scene isn't shown yet, on a screen whose pace is
/// `base`: the frames of the load (the sky and the isle cooking) are the load's, not the scene's
/// at this size. Counted, at the screen's own pace they cut the title before it rose, and held
/// it small for its first minute. It's begun afresh when the scene shows, as on time so far.
fn waiting(from: Budget, time: f32, base: f32) -> Budget {
    var b = afresh(from, time)
    b.spent = base
    b.dt = base
    b.before = base
    b
}

/// The scene's height once frames at `tall` have taken `spent` seconds against a pace of `pace`:
/// cut by what the overrun asks, the drawing's cost taken to go as its pixels (the square of its
/// height), by no less than a step (0.85) and no more than 0.6 at once, to a multiple of 8.
/// (A step a second and a half apart, whatever the overrun, took a scene three times too slow,
/// as the title's size can be when Play is pressed, five steps to settle: six seconds of slow
/// frames.)
fn cut(tall: f32, spent: f32, pace: f32) -> f32 {
    let k = clamp(sqrt(pace / max(spent, pace)), 0.6, 0.85)
    round(tall * k / 8.0) * 8.0
}

/// The budget next, at `time` (s): the height smaller when the frames have run slower than `slow`
/// (`cut`), larger again by a step when quicker than `quick`, between `least` and `most`, at
/// least a second and a half after the last change to go smaller and three to grow. A growth
/// whose frames run late is taken back at once.
fn stepped(from: Budget, time: f32, slow: f32, quick: f32, least: f32, most: f32) -> Budget {
    var b = from
    // (A growth that has held is no longer on trial, and the next one that fails waits the
    // first wait again: the scene got cheaper, and what's above is a new edge.)
    if b.probing && time - b.grew_at >= PROBE {
        b.probing = false
        b.ceiling_for = CEILING
    }
    // A size that ran slow isn't tried again for a while: the scene would only pop between two.
    let ceiling = if time < b.ceiling_until { min(b.ceiling, most) } else { most }
    let since = time - b.resized_at
    let was = b.tall
    // (A growth is judged by its late frames, not the average alone: a scene up to a quarter too
    // slow can show one late frame in four or more, an average under `slow`, and a growth to
    // such a size stayed, stuttering. By more than there were before it, and half as many
    // again: late frames a smaller size wouldn't cure come unevenly, and counted against a
    // growth they kept a scene with room small for minutes.)
    let lates = max(b.late, b.lately)
    let late = lates > 2 + b.noise + b.noise / 2
    if b.probing && (late || b.spent > slow && since > 1.5) {
        // Slow just after growing: the growth was a step too far. Back to the size that held, not
        // a cut under it, and twice as long before it's tried again: tried every minute and cut
        // under, it was a second and a half of slow frames and two pops of the scene's size a
        // minute, for as long as the scene was up. (By its late frames, not the average's
        // second and a half: three are enough to know.)
        b.tall = min(b.tall, b.grew_from)
        if lates > 2 + b.noise {
            b.ceiling_for = min(b.ceiling_for * 2.0, CEILING_MOST)
        }
        b.ceiling = b.tall
        b.probing = false
        b.ceiling_until = time + b.ceiling_for
    } else if b.spent > slow && since > 1.5 {
        // How slow for sure: the average, but no slower than each of the last two frames was (a
        // frame's time is whole frames of the screen's, and the average right after it crosses
        // the limit or after one long frame says little).
        let sure = min(b.spent, min(b.dt, b.before))
        // Too slow: cut well under. It may grow back at once as far as a step under the size
        // that ran slow (a cut deeper than a step may have gone too far), and stays under that
        // for a while, so the scene settles at a size it keeps instead of climbing back to the
        // edge and falling off it again.
        b.ceiling = max(least, round(b.tall * 0.85 / 8.0) * 8.0)
        b.tall = max(least, cut(b.tall, sure, quick))
        b.ceiling_for = CEILING
        b.ceiling_until = time + b.ceiling_for
    } else if b.spent < quick && since > 3.0 && b.tall < ceiling && time - b.fresh_at >= 2.5 {
        if b.probing {
            // (Quick enough to grow again: the last growth held, and what's above is a new edge.)
            b.ceiling_for = CEILING
        }
        b.noise = max(lates, b.peak)
        b.grew_from = b.tall
        b.grew_at = time
        b.probing = true
        b.tall = min(ceiling, round(b.tall * 1.12 / 8.0) * 8.0)
    }
    b.tall = clamp(b.tall, least, most)
    if b.tall != was {
        b.resized_at = time
        b.spent = (slow + quick) * 0.5
        // (Late frames are counted anew, from half a second on: the first frames at a new size
        // make its images again.)
        b.late = 0
        b.lately = 0
        b.late_from = time + 0.5
    }
    b
}

/// A rehearsal of the budget: `seconds` of a screen that shows `hz` frames a second, the scene
/// costing `fixed + per * (tall / 1440)^2` seconds a drawing, with
/// one frame of `hitch` seconds every `every` seconds (none if 0; `uneven`, a quarter to seven
/// quarters of `every` apart). Each frame takes a whole
/// number of the screen's: as many as its drawing needs, or `mixed`, as many as the drawings so
/// far have fallen behind (a scene a third too slow then shows two frames on time and one late,
/// as a browser whose drawings queue does).
/// Gives the budget after, how many times the height changed, and the seconds spent in frames
/// that missed the screen's pace.
fn rehearsed(
    from: Budget,
    hz: f32,
    fixed: f32,
    per: f32,
    seconds: f32,
    hitch: f32 = 0.0,
    every: f32 = 0.0,
    mixed: bool = false,
    uneven: bool = false,
) -> (Budget, u32, f32) {
    var b = from
    let base = 1.0 / hz
    let (slow, quick) = frame_limits(base)
    var time = 0.0
    var next_hitch = every
    var hitches = 0.0
    var owed = 0.0
    var changes = 0
    var late = 0.0
    while time < seconds {
        let cost = fixed + per * (b.tall / 1440.0) * (b.tall / 1440.0)
        var dt = base * max(1.0, ceil(cost / base - 0.0001))
        if mixed {
            owed += cost
            dt = base * max(1.0, floor(owed / base + 0.0001))
            owed = max(0.0, owed - dt)
        }
        if every > 0.0 && time >= next_hitch {
            dt = hitch
            hitches += 1.0
            next_hitch += if uneven {
                every * (0.25 + 1.5 * fract(sin(hitches * 12.9898) * 43758.5453))
            } else { every }
        }
        time += dt
        b = heard(b, dt, slow, time)
        let was = b.tall
        b = stepped(b, time, slow, quick, least: 360.0, most: 1440.0)
        if b.tall != was {
            changes += 1
        }
        if dt > base * 1.5 {
            late += dt
        }
    }
    (b, changes, late)
}

@test
fn front_a_scene_twice_too_slow_is_cut_at_once_and_a_little_slow_by_a_step() {
    let pace = 1.06 / 60.0
    // Twice the pace: about 0.7 of the height (half the pixels), not a 0.85 step.
    let twice = cut(1440.0, spent: 2.0 / 60.0, pace: pace)
    assert(twice >= 1000.0 && twice <= 1056.0, f"twice too slow cuts to {twice}")
    // A little slow: a step.
    assert(cut(1440.0, spent: 1.3 / 60.0, pace: pace) == round(1440.0 * 0.85 / 8.0) * 8.0)
    // Far too slow: never under 0.6 at once.
    assert(cut(1440.0, spent: 0.2, pace: pace) == 864.0)
}

@test
fn front_play_at_a_size_three_times_too_slow_holds_the_pace_within_two_seconds() {
    // A 120 Hz screen, the scene at the title's 1440 costing 25 ms (3 ms and 22 by its pixels):
    // three frames of the screen's a drawing. Steps of 0.85 took five, six seconds, to 640.
    let from = budget_at(1440.0, spent: 0.025)
    let (soon, cuts, _) = rehearsed(from, hz: 120.0, fixed: 0.003, per: 0.022, seconds: 2.0)
    assert(cuts == 2 && soon.tall == 632.0, f"{cuts} cuts to {soon.tall} in two seconds")
    // Then it tries a little larger, and keeps the largest that holds (704: 8.3 ms).
    let (b, changes, late) = rehearsed(from, hz: 120.0, fixed: 0.003, per: 0.022, seconds: 60.0)
    assert(b.tall == 704.0, f"settled at {b.tall}")
    assert(changes <= 5, f"{changes} changes of size")
    assert(late < 3.5, f"{late} s of late frames")
}

@test
fn front_a_growth_that_fails_goes_back_to_the_size_that_held_and_waits_longer() {
    // A 60 Hz screen, the scene at a size it keeps (968: 12.9 ms), one step under one it doesn't
    // (1088: 15.6 ms holds, 1216: 18.7 ms doesn't). Ten minutes of it.
    let (b, changes, late) = rehearsed(
        budget_at(968.0, spent: 1.0 / 60.0),
        hz: 60.0,
        fixed: 0.003,
        per: 0.022,
        seconds: 600.0,
    )
    // It grows once to the size that holds, then tries the next at 3 s, 2 min, 6 min: up and back
    // each time, to the same size. (Tried every minute and cut under it, it changed size 25
    // times in ten minutes, with 15 s of late frames.)
    assert(b.tall == 1088.0, f"it keeps {b.tall}")
    assert(changes <= 9, f"{changes} changes of size")
    assert(late < 6.0, f"{late} s of late frames")
}

@test
fn front_one_long_frame_now_and_then_is_not_a_slow_scene() {
    // A scene that keeps 1440 with room (12 ms on a 60 Hz screen), a quarter-second frame every
    // minute and a half: a tab come back to. (Each one cut it to 1224 for a minute.)
    let (b, changes, _) = rehearsed(
        budget_at(1440.0, spent: 1.0 / 60.0),
        hz: 60.0,
        fixed: 0.002,
        per: 0.010,
        seconds: 600.0,
        hitch: 0.25,
        every: 90.0,
    )
    assert(changes == 0 && b.tall == 1440.0, f"{changes} changes of size, to {b.tall}")
}

@test
fn front_a_scene_that_gets_cheaper_grows_back_without_the_longer_wait() {
    // Held at 896 by an edge it failed twice (a 4 minute wait by then); the scene then gets
    // cheap enough for the full 1440 (14 ms). Each growth holds, so it is there inside a minute.
    var held = budget_at(896.0, spent: 1.0 / 60.0)
    held.ceiling = 896.0
    held.ceiling_until = 10.0
    held.ceiling_for = 240.0
    let (b, _, late) = rehearsed(held, hz: 60.0, fixed: 0.002, per: 0.012, seconds: 60.0)
    assert(b.tall == 1440.0, f"grew back to {b.tall}")
    assert(b.ceiling_for == CEILING, "and the next edge waits the first wait")
    assert(late == 0.0, f"{late} s of late frames")
}

@test
fn front_a_growth_past_one_that_held_is_a_new_edge_with_the_first_wait_doubled_once() {
    // Held at 896 by an edge it failed three times (an 8 minute wait); the scene then gets
    // cheaper: 1000 and 1120 hold (14.4 ms), 1256 doesn't (18.4 ms). The edge is a new one: two
    // minutes before 1256 is tried again, not sixteen.
    var held = budget_at(896.0, spent: 1.0 / 60.0)
    held.ceiling = 896.0
    held.ceiling_until = 2.0
    held.ceiling_for = CEILING_MOST
    let (b, _, _) = rehearsed(held, hz: 60.0, fixed: 0.002, per: 0.0215, seconds: 30.0)
    assert(b.tall == 1120.0, f"it keeps {b.tall}")
    assert(b.ceiling_for == CEILING * 2.0, f"and waits {b.ceiling_for} s")
}

@test
fn front_a_growth_a_little_too_far_shows_late_frames_among_quick_ones_and_is_taken_back() {
    // A 60 Hz screen whose drawings queue: at 1216 the scene costs 18.7 ms, one frame late in
    // eight, an average the limits take for quick enough. (It stuttered there for good.)
    let (b, changes, late) = rehearsed(
        budget_at(968.0, spent: 1.0 / 60.0),
        hz: 60.0,
        fixed: 0.003,
        per: 0.022,
        seconds: 600.0,
        mixed: true,
    )
    assert(b.tall == 1088.0, f"it keeps {b.tall}")
    assert(changes <= 9, f"{changes} changes of size")
    assert(late < 2.0, f"{late} s of late frames")
}

@test
fn front_late_frames_that_were_there_before_a_growth_dont_count_against_it() {
    // A scene with room at any size (12 ms on a 60 Hz screen) and a late frame every 0.7 s
    // whatever its size (the page's own work, not the drawing's): it still grows to the top.
    // (Begun afresh, as on Play: it counts its late frames before it grows.)
    let (b, _, _) = rehearsed(
        afresh(budget_at(968.0, spent: 1.0 / 60.0), time: 0.0),
        hz: 60.0,
        fixed: 0.002,
        per: 0.010,
        seconds: 60.0,
        hitch: 2.0 / 60.0,
        every: 0.7,
    )
    assert(b.tall == 1440.0, f"grew to {b.tall}")
    // And when they come unevenly, one a second or so, to a scene cut small by something that
    // passed (520, kept under 736 for a minute): back at the top well inside three minutes, on
    // a 60 Hz screen and a 120. (Each window with a few more of them than the one before took
    // a growth back and doubled its wait: ten minutes and more.)
    var small = budget_at(520.0, spent: 1.0 / 60.0)
    small.ceiling = 736.0
    small.ceiling_until = 60.0
    let (back, _, _) = rehearsed(
        small,
        hz: 60.0,
        fixed: 0.002,
        per: 0.010,
        seconds: 160.0,
        hitch: 2.0 / 60.0,
        every: 0.7,
        uneven: true,
    )
    assert(back.tall == 1440.0, f"back to {back.tall} at 60 Hz")
    let (quick, _, _) = rehearsed(
        small,
        hz: 120.0,
        fixed: 0.001,
        per: 0.005,
        seconds: 160.0,
        hitch: 2.0 / 120.0,
        every: 1.0,
        uneven: true,
    )
    assert(quick.tall == 1440.0, f"back to {quick.tall} at 120 Hz")
}

@test
fn front_a_scene_far_too_slow_is_cut_on_a_quick_screen_too() {
    // A 120 Hz screen, the drawing 100 ms whatever its size: twelve frames of the screen's, as
    // a title too heavy for the machine. Cut by what the overrun asks: at the least size in
    // five seconds, which a step at a time is not.
    let (b, _, _) = rehearsed(
        budget_at(720.0, spent: 1.0 / 120.0),
        hz: 120.0,
        fixed: 0.1,
        per: 0.0,
        seconds: 5.0,
    )
    assert(b.tall == 360.0, f"cut to {b.tall}")
}

@test
fn front_the_frames_of_the_load_dont_set_the_scenes_size() {
    // A 120 Hz screen, the load's frames 50 ms each for three seconds: the size stays as it
    // was, neither cut by them nor grown without a frame to go by.
    let base = 1.0 / 120.0
    let (slow, quick) = frame_limits(base)
    var b = budget_at(720.0, spent: 1.0 / 60.0)
    var time = 0.0
    while time < 3.0 {
        time += 0.05
        b = waiting(b, time, base)
        b = stepped(b, time, slow, quick, least: 360.0, most: 1440.0)
    }
    assert(b.tall == 720.0, f"the load left it at {b.tall}")
    // Shown, it's judged by its own frames: quick ones grow it, once it has counted them.
    while time < 6.5 {
        time += base
        b = heard(b, base, slow, time)
        b = stepped(b, time, slow, quick, least: 360.0, most: 1440.0)
    }
    assert(b.tall > 720.0, f"then it grew to {b.tall}")
}

@test
fn front_a_title_that_held_thirty_at_full_size_is_drawn_smaller_to_keep_the_screens_pace() {
    // The title at 1440 costing 30 ms (3 ms and 27 by its pixels): it ran sharp at 30 a second.
    // On a 60 Hz screen it's now cut to a size that keeps 60 (under 16.7 ms: 1024 at most),
    // within two seconds, and a minute on is at the largest that does, not cut to the least;
    // on a 120 Hz screen to one that keeps 120 (640 at most).
    let (soon, _, _) = rehearsed(
        budget_at(1440.0, spent: 0.03),
        hz: 60.0,
        fixed: 0.003,
        per: 0.027,
        seconds: 2.0,
    )
    assert(soon.tall >= 800.0 && soon.tall <= 1024.0, f"at 60 Hz it's cut to {soon.tall}")
    let (at60, _, _) = rehearsed(
        budget_at(1440.0, spent: 0.03),
        hz: 60.0,
        fixed: 0.003,
        per: 0.027,
        seconds: 60.0,
    )
    assert(at60.tall >= 896.0 && at60.tall <= 1024.0, f"at 60 Hz it keeps {at60.tall}")
    let (at120, _, late) = rehearsed(
        budget_at(1440.0, spent: 0.03),
        hz: 120.0,
        fixed: 0.003,
        per: 0.027,
        seconds: 60.0,
    )
    assert(at120.tall >= 560.0 && at120.tall <= 640.0, f"at 120 Hz it keeps {at120.tall}")
    assert(late < 4.0, f"{late} s of late frames")
}

@test
fn front_a_budget_begun_afresh_forgets_the_other_shots_ceiling_and_late_frames() {
    var b = budget_at(640.0, spent: 1.0 / 120.0)
    b.ceiling = 640.0
    b.ceiling_until = 500.0
    b.ceiling_for = CEILING_MOST
    b.probing = true
    b.grew_at = 99.0
    b.late = 5
    b.lately = 7
    let a = afresh(b, time: 100.0)
    assert(a.tall == 640.0, "at the size it has")
    assert(a.ceiling_until == 0.0 && a.ceiling_for == CEILING, "no ceiling from the other shot")
    assert(!a.probing && a.late == 0 && a.lately == 0, "no growth on trial, no late frames")
    // So it may grow when its frames are quick, once it has counted them.
    let soon = stepped(
        a,
        time: 101.0,
        slow: 1.25 / 120.0,
        quick: 1.06 / 120.0,
        least: 360.0,
        most: 1440.0,
    )
    assert(soon.tall == 640.0, "not before it has counted its late frames")
    let grown = stepped(
        a,
        time: 103.5,
        slow: 1.25 / 120.0,
        quick: 1.06 / 120.0,
        least: 360.0,
        most: 1440.0,
    )
    assert(grown.tall > 640.0, f"grew to {grown.tall}")
}

/// The scene's height next (`stepped`), by the frames' pace on this screen.
/// A screen that shows fewer than 60 frames a second (`base`, its quickest frame) is held to its
/// own pace, not to one it can't show.
fn budget(f: mut Front, height: f32) {
    let (slow, quick) = frame_limits(f.base)
    let most = min(height, TALLEST)
    let least = min(SHORTEST, most)
    f.budget = stepped(f.budget, f.time, slow, quick, least, most)
}

/// The save read back ("x z heading"), if it reads as one.
fn read_save(bytes: take Vec<u8>) -> Option<(vec2, f32)> {
    let text = match String::from_utf8(take bytes) {
        Some(t) => take t,
        None => return None,
    }
    let s = text.as_str().trim()
    let parts = s.split(" ")
    if parts.len() != 3 { return None }
    var v = [0.0, 0.0, 0.0]
    for i in 0..3 {
        let (from, to) = parts[i]
        match s.slice(from, to).parse_f32() {
            Some(x) => v[i] = x,
            None => return None,
        }
    }
    // (A save far out past any sea the game has drawn, or broken, isn't taken up.)
    if abs(v[0]) > 1.0e6 || abs(v[1]) > 1.0e6 || abs(v[2]) > 1.0e4 { return None }
    Some((vec2(v[0], v[1]), v[2]))
}

/// The latest save can start once the preceding write has answered. Taking it once also
/// bounds failures: a failed write is not retried every frame.
fn next_save(
    queued: mut Option<Vec<u8>>,
    writing: bool,
    snapshot: take Option<Vec<u8>>,
) -> Option<Vec<u8>> {
    if snapshot.is_some() { let _ = replace(mut queued, take snapshot) }
    if writing { return None }
    replace(mut queued, None)
}

/// Finishes the preceding write and starts the latest snapshot, if one is waiting.
fn flush_save(f: mut Front) {
    let _ = answer_of(mut f.save_write)
    if let Some(bytes) = next_save(mut f.save_next, f.save_write.is_some(), None) {
        f.save_write = Some(store(SAVE, bytes))
    }
}

/// Saves where the skiff is on this device, keeping the latest snapshot while another write
/// finishes: a pause or a return to the title must not lose its final position.
fn save(f: mut Front) {
    let (at, steer) = whereabouts(f.scene)
    let text = f"{at.x} {at.y} {steer}"
    let snapshot = Some(Vec::from(text.as_bytes()))
    if let Some(bytes) = next_save(mut f.save_next, f.save_write.is_some(), take snapshot) {
        f.save_write = Some(store(SAVE, bytes))
    }
    f.saved_at = f.time
}

@test
fn front_final_save_waits_for_a_pending_write_and_keeps_the_latest_snapshot() {
    var queued: Option<Vec<u8>> = None
    let first = Some(Vec::from([u8(1)]))
    assert(next_save(mut queued, writing: false, snapshot: take first) == Some(Vec::from([u8(1)])))
    // A periodic save is pending when pause saves, and title saves again. Only the latest
    // of those positions should follow it; neither may overwrite an unfinished write.
    assert(next_save(mut queued, writing: true, snapshot: Some(Vec::from([u8(2)]))).is_none())
    assert(next_save(mut queued, writing: true, snapshot: Some(Vec::from([u8(3)]))).is_none())
    assert(next_save(mut queued, writing: true, snapshot: None).is_none())
    assert(
        next_save(mut queued, writing: false, snapshot: None) == Some(Vec::from([u8(3)])),
        "the final save survives",
    )
    // The answer to that write, including an error, must not retry it forever.
    assert(next_save(mut queued, writing: false, snapshot: None).is_none())
    assert(queued.is_none())
}

/// Plays the title, the player's rowing or the pause menu for a frame, `width` by `height`
/// pixels, `zoom` device pixels to a logical one, under `account`'s chip and pages (on the
/// title alone).
pub fn frame<A: Account>(
    f: mut Front,
    time: f32,
    width: u32,
    height: u32,
    zoom: f32,
    reduced: bool,
    account: mut A,
) -> Next {
    let start = match f.began {
        Some(t) => t,
        None => {
            f.began = Some(time)
            time
        },
    }
    // (The frame's real time, for the readout: a stall is as long as it was.)
    let took = max(time - start - f.time, 0.0)
    let dt = clamp(took, 0.0, 0.25)
    f.time = time - start
    f.dt = dt
    f.reduced = reduced
    if f.drawings > 2 && dt > 0.0 {
        let (slow, _) = frame_limits(f.base)
        f.budget = if f.cooked { heard(f.budget, dt, slow, f.time) } else {
            waiting(f.budget, f.time, f.base)
        }
        f.readout.hear(took, f.base)
        // Infer the screen's pace from its fastest window; later rendering load must not
        // make a known faster display appear slower.
        f.quickest = min(f.quickest, dt)
        f.window_frames += 1
        if f.time - f.window_began >= 1.0 {
            // (Only a pace the window mostly kept: one quick frame among slow ones, a
            // timestamp's jitter, isn't the screen's.)
            if kept_pace(f.window_frames, f.quickest) {
                f.base = frame_base(f.base, f.quickest, first: f.window_began == 0.0)
            }
            f.quickest = 1.0
            f.window_frames = 0
            f.window_began = f.time
        }
    }
    // This device's save, read once at the start: the skiff where it was left, and Continue.
    if let Some(Ok(bytes)) = answer_of(mut f.save_load) {
        if f.stage == Stage::Page {
            if let Some((at, steer)) = read_save(take bytes) {
                put(mut f.scene, at, steer)
                f.saved = true
            }
        }
    }
    flush_save(mut f)
    // The front is dropped when it returns Online, so give its last queued save a chance to
    // finish first. An error still releases it; no failed write is retried without a new save.
    if f.online && f.save_write.is_none() { return Next::Online }
    let k = zoom
    let (w, h) = (max(f32(width), 1.0), max(f32(height), 1.0))
    let on_phone = phone(w / k, h / k)
    for e in events() {
        if f.online { break }
        // (The readout's key, wherever the page is, but not while the account's pages are open:
        // there it's a character someone may be typing. Nor with Command or Alt held: those
        // are the browser's and the desktop's.)
        if let Event::KeyDown { key: Key::Backquote, repeat: false, mods } = e {
            if !account.shown() && !mods.command() && !mods.alt {
                f.readout.toggle(f.base)
                continue
            }
        }
        if f.stage == Stage::Rowing {
            match e {
                Event::KeyDown { key: Key::Escape, .. } => pause(mut f),
                Event::PadButton { button: PadButton::Start, pressed: true, .. } => pause(mut f),
                _ => input(mut f.scene, e),
            }
            continue
        }
        if f.stage == Stage::Page {
            // Nothing of the title's is pressed before it shows, the account's chip included;
            // once its pages are open, they take every input.
            if min(f.words, f.controls) < 0.5 && !account.shown() {
                continue
            }
            if account.event(e) || account.shown() {
                continue
            }
        }
        let chosen = choice(mut f, e, on_phone)
        if chosen == ONLINE {
            save(mut f)
            f.online = true
            break
        }
        if chosen == PLAY && !on_phone {
            // At once, so the rest of this frame's input rows: and a stroke that chose it is
            // the first.
            f.stage = Stage::Rowing
            // (Rowing has its own shot: what ran slow under the title doesn't hold it under.)
            f.budget = afresh(f.budget, f.time)
            f.pressed = NONE
            f.keyboard = false
            input(mut f.scene, e)
        } else if chosen == RESUME {
            f.stage = Stage::Rowing
            f.pressed = NONE
        } else if chosen == TITLE {
            save(mut f)
            release(mut f.scene)
            f.stage = Stage::Page
            // (And the title its own: what ran slow rowing doesn't hold it under.)
            f.budget = afresh(f.budget, f.time)
            f.focus = PLAY
            f.pressed = NONE
            f.saved = true
        }
    }
    if f.stage == Stage::Rowing && f.time - f.saved_at > SAVE_EVERY {
        save(mut f)
    }
    // The name comes over black at once; the scene, once the sky has cooked, rises behind it,
    // and Play after.
    f.drawings += 1
    if f.cooked {
        f.since += dt
    }
    let rise = if reduced { 0.4 } else { RISE }
    f.shown = smoothstep(0.0, 1.0, clamp(f.since / rise, 0.0, 1.0))
    let due = f.time > NAME_AT || reduced
    let up = f.since > rise * CONTROLS_AFTER || f.time > WORDS_GIVE_UP
    // (Under the account's pages, the title's own words step back: one thing to read at a time.)
    let words_target = if f.stage == Stage::Page && due && !account.shown() { 1.0 } else { 0.0 }
    let opening = f.controls < 0.999
    let pace = if words_target <= f.words { LEAVE } else if opening { NAME_IN } else { RETURN }
    f.words = kit::ease(f.words, words_target, dt, seconds: (if reduced { 0.0 } else { pace }))
    f.controls = kit::ease(f.controls, if up { 1.0 } else { 0.0 }, dt, seconds: (if reduced {
        0.0
    } else { rise * 0.4 }))
    f.menu = kit::ease(f.menu, if f.stage == Stage::Paused { 1.0 } else {
        0.0
    }, dt, seconds: (if reduced { 0.0 } else { MENU_FADE }))
    // The camera: the player's while they play or pause, the title's shot under the title, and
    // swung round to face the cathedral there.
    let framing_target = if f.stage == Stage::Page { 0.0 } else { 1.0 }
    f.framing = if reduced { framing_target } else {
        kit::ease(f.framing, framing_target, dt, seconds: DOLLY)
    }
    let bearing = if f.stage == Stage::Page { -swung(f.scene) } else { 0.0 }
    f.orbit = if reduced { bearing } else {
        f.orbit + wrapped(bearing - f.orbit) * (1.0 - exp(-dt / SWING))
    }
    budget(mut f, h)
    // A new size is drawn once it has held (`SETTLE`), or at once for the first drawing.
    let tall = f.budget.tall
    let asked = (u32(max(round(tall * w / h), 1.0)), u32(tall))
    if asked != f.asked {
        f.asked = asked
        f.asked_since = f.time
    }
    if f.drawn_at == (0, 0) || f.time - f.asked_since > SETTLE {
        f.drawn_at = f.asked
    }
    let (wide, high) = f.drawn_at
    if play(
        mut f.scene,
        f.time,
        wide,
        high,
        orbit: f.orbit,
        framing: f.framing,
        bands: BANDS,
    ) &&
        ready(f.scene) {
        f.cooked = true
    }
    // The title, or the pause menu, and the account's chip and pages over the title.
    f.list.clear(vec2(w, h))
    f.rects.clear()
    var hand = false
    if f.words > 0.001 {
        hand = draw_title(mut f, w, h, k, on_phone)
    }
    if f.menu > 0.001 {
        hand = draw_menu(mut f, w, h, k) || hand
    }
    if f.stage == Stage::Page {
        // The chip comes and goes with the words; the pages, once opened, are wholly there.
        f.list.alpha = if account.shown() { 1.0 } else {
            clamp(min(f.words, f.controls) * 1.5, 0.0, 1.0)
        }
        account.draw(mut f.list, f.fonts, width, height)
        f.list.alpha = 1.0
    }
    if f.readout.shown {
        draw_readout(mut f, w, h, k)
    }
    f.renderer.fetch(mut f.fonts, f.list)
    f.renderer.upload(f.list)
    let veil = Veil {
        size: vec2(w, h),
        shown: f.shown,
        veil: f.words,
        dim: f.menu,
        texel: vec2(1.0 / f32(max(wide, 1)), 1.0 / f32(max(high, 1))),
    }
    let pass = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(pass, cover, laid.bind(v: veil, image: f.scene.image, smp: f.smp), vertices: 3)
    f.renderer.draw(pass, vec2(w, h))
    pass.present()
    Next::Stay { hand }
}

/// Paused: the hands off the keys, where the skiff is saved, the menu's focus on Resume.
fn pause(f: mut Front) {
    release(mut f.scene)
    save(mut f)
    f.stage = Stage::Paused
    f.focus = RESUME
    f.pressed = NONE
    f.keyboard = false
}

/// The action input event `e` chooses on the title or the pause menu (`NONE` if none), the
/// pointer's hover and press and the keyboard's focus kept as it goes.
fn choice(f: mut Front, e: Event, on_phone: bool) -> u32 {
    let paused = f.stage == Stage::Paused
    var chosen = NONE
    match e {
        Event::PointerMove { at, .. } => {
            f.pointer = Some(at)
            f.keyboard = false
        },
        Event::PointerDown { at, button: Button::Primary, .. } => {
            f.pointer = Some(at)
            f.pressed = action_at(f, at)
        },
        Event::PointerUp { at, button: Button::Primary, .. } => {
            let on = action_at(f, at)
            if on != NONE && on == f.pressed { chosen = on }
            f.pressed = NONE
        },
        Event::KeyDown { key, repeat: false, .. } => {
            if key == Key::Enter || key == Key::Space {
                chosen = f.focus
            } else if paused && key == Key::Escape {
                chosen = RESUME
            } else if paused && (key == Key::Up || key == Key::W) {
                step_focus(mut f, back: true)
            } else if paused && (key == Key::Down || key == Key::S || key == Key::Tab) {
                step_focus(mut f, back: false)
            } else if !paused && key == Key::Tab {
                f.keyboard = true
            } else if !paused && (key == Key::W || key == Key::Up) {
                // Rowing from the title is playing.
                chosen = PLAY
            }
        },
        Event::PadButton { button, pressed: true, .. } => {
            if button == PadButton::South {
                chosen = f.focus
            } else if paused && (button == PadButton::Start || button == PadButton::East) {
                chosen = RESUME
            } else if paused && button == PadButton::Up {
                step_focus(mut f, back: true)
            } else if paused && button == PadButton::Down {
                step_focus(mut f, back: false)
            } else if !paused && (button == PadButton::Up || button == PadButton::Start) {
                chosen = PLAY
            }
        },
        _ => {},
    }
    // (On a phone the title has no Play to choose.)
    if chosen == PLAY && (paused || on_phone) { return NONE }
    if chosen != PLAY && chosen != NONE && !paused { return NONE }
    chosen
}

/// The pause menu's focus moved one up (`back`) or down, round its ends, and shown.
fn step_focus(f: mut Front, back: bool) {
    var at = 0
    for i in 0..3 {
        if MENU[i] == f.focus { at = i }
    }
    let next = if !f.keyboard { at } else if back { (at + 2) % 3 } else { (at + 1) % 3 }
    f.focus = MENU[next]
    f.keyboard = true
}

/// The action under `at`, or `NONE`.
fn action_at(f: Front, at: vec2) -> u32 {
    for (id, r) in f.rects {
        if r.contains(at) { return id }
    }
    NONE
}

/// The action `id` over `r`, saying `label`, at `alpha`: the one to press (`main`) solid in
/// warm ivory, the others in dark glass. Its hover lifts it two pixels, and the keyboard's focus
/// rings it in ivory. Whether the pointer is over it.
fn action(f: mut Front, id: u32, r: Rect, label: str, main: bool, k: f32) -> bool {
    f.rects.push((id, r))
    let over = match f.pointer {
        Some(p) => r.contains(p),
        None => false,
    }
    f.hovers[id] = kit::ease(f.hovers[id], if over && !f.keyboard { 1.0 } else { 0.0 }, f.dt)
    let hover = f.hovers[id]
    let pressed = f.pressed == id && over
    let radius = kit::RADIUS * k
    let was = f.list.alpha
    let lifted = Rect::new(r.x, r.y - (if pressed { 0.0 } else {
        round(hover * 2.0 * k)
    }), r.w, r.h)
    let ink = if main {
        // Its shadow comes with the hover, as if it rose off the page.
        f.list.alpha = was * hover
        kit::shadow(mut f.list, lifted, radius, k)
        f.list.alpha = was
        let fill = if pressed { PLAY_FILL * vec4(0.92, 0.92, 0.92, 1.0) } else {
            mix(PLAY_FILL, PLAY_HOVER, hover)
        }
        f.list.rect(lifted, fill, radius)
        PLAY_INK
    } else {
        f.list.rect(lifted, if pressed { GLASS } else { mix(GLASS, GLASS_HOVER, hover) }, radius)
        f.list.ring(lifted, GLASS_EDGE, radius, width: max(round(k), 1.0))
        IVORY
    }
    if f.keyboard && f.focus == id {
        let gap = round(4.0 * k)
        f.list.ring(lifted.shrink(-gap), IVORY, radius + gap, width: max(round(2.0 * k), 2.0))
    }
    let px = 16.0 * k
    let tw = f.fonts.font(Face::Sans).measure(label, px)
    let top = kit::centred_top(f.fonts, lifted.y + lifted.h * 0.5, px)
    let _ = f.list.text(
        f.fonts,
        Face::Sans,
        label,
        px,
        vec2(round(lifted.x + (lifted.w - tw) * 0.5), top),
        ink,
        weight: kit::SEMIBOLD,
    )
    over && !f.keyboard
}

/// The title at the bottom left, rising in as it comes: the game's name in Wrela Charter, wholly
/// under the horizon, and Play under it (Continue once there's a save; on a phone, a line
/// saying what it plays with instead). Whether the pointer is over Play.
fn draw_title(f: mut Front, w: f32, h: f32, k: f32, on_phone: bool) -> bool {
    let fade = f.words
    let eased = fade * fade * (3.0 - 2.0 * fade)
    let lift = if f.reduced { 0.0 } else { (1.0 - eased) * 10.0 * k }
    f.list.alpha = eased
    let margin = round(clamp(min(w, h) * 0.075, 24.0 * k, 72.0 * k))
    let bottom = h - round(clamp(h * 0.06, 24.0 * k, 56.0 * k))
    var hand = false
    // Play, along the bottom, coming in once the scene is up (`controls`); on a phone, the line in
    // its place. The name sits over where they rest, rising with its own fade.
    let c = clamp(f.controls, 0.0, 1.0)
    let shown_c = c * c * (3.0 - 2.0 * c)
    let c_lift = if f.reduced { 0.0 } else { (1.0 - shown_c) * 8.0 * k }
    f.list.alpha = eased * shown_c
    let bh = round(48.0 * k)
    let top = round(bottom - bh + c_lift)
    var under_name = round(bottom - bh + lift)
    if on_phone {
        let size = 16.0 * k
        let line_top = round(bottom - size * 1.3 + c_lift)
        let _ = f.list.text(
            f.fonts,
            Face::Sans,
            "Wrela plays with a keyboard or a gamepad.",
            size,
            vec2(margin, line_top),
            MUTED,
        )
        under_name = round(bottom - size * 1.3 + lift)
    } else {
        let label = if f.saved { "Continue" } else { "Play" }
        let tw = f.fonts.font(Face::Sans).measure(label, 16.0 * k)
        let bw = round(max(tw + 64.0 * k, 168.0 * k))
        hand = action(mut f, PLAY, Rect::new(margin, top, bw, bh), label, main: true, k: k) &&
            c > 0.5
    }
    f.list.alpha = eased
    // The name, in Wrela Charter: its capitals stand `CAP` on their baseline, and the R's swash
    // runs `SWASH` under it. As large as fits between Play and the horizon (with room to breathe
    // under the sea's line) and across the screen, up to a cap height of 120 pixels; sized where
    // it rests, so it keeps its size as it rises in. A screen too short for it under the horizon
    // (a phone on its side) sets it by its width alone, over the sea's line.
    let floor = under_name - round(24.0 * k)
    let resting = floor - round(lift)
    let horizon = h * HORIZON + 20.0 * k
    let width_at_one = f.fonts.font(Face::Display).measure("WRELA", 1.0) + 4.0 * TRACKING
    let across = (w - margin * 2.0) / width_at_one
    let under = (resting - horizon) / (CAP + SWASH)
    let room = if under >= 40.0 * k { min(under, across) } else { across }
    let size = round(clamp(room, 24.0 * k, 120.0 * k / CAP))
    let baseline = floor - round(size * SWASH)
    let name_top = baseline - f.fonts.font(Face::Display).ascender * size
    // (The W's left serif lines up with Play.)
    let at = vec2(margin - round(size * 0.017), name_top)
    let _ = spaced(mut f, Face::Display, "WRELA", size, at, IVORY, TRACKING)
    f.list.alpha = 1.0
    hand
}

/// How far the R's swash runs under the baseline, in ems (ui/brand/fonts/charter.py), and the
/// name's letter spacing, in ems: set wide, as a chart's names are.
const SWASH: f32 = 0.15
const TRACKING: f32 = 0.06

/// `text` in `face` at `size` with `tracking` ems between its letters, its top left at `at`:
/// its width.
fn spaced(
    f: mut Front,
    face: Face,
    text: str,
    size: f32,
    at: vec2,
    color: vec4,
    tracking: f32,
) -> f32 {
    var x = at.x
    for i in 0..text.len() {
        let letter = text.slice(i, i + 1)
        let advance = f.fonts.font(face).measure(letter, size)
        let _ = f.list.text(f.fonts, face, letter, size, vec2(round(x), at.y), color)
        x += advance + (if i + 1 < text.len() { tracking * size } else { 0.0 })
    }
    x - at.x
}

/// A key's cap at `x`, its top at `y`, saying `key`: its width.
fn cap(f: mut Front, key: str, x: f32, y: f32, k: f32) -> f32 {
    let size = 13.0 * k
    let ch = round(24.0 * k)
    let kw = round(max(f.fonts.font(Face::Sans).measure(key, size) + 16.0 * k, ch))
    let r = Rect::new(x, y, kw, ch)
    f.list.rect(r, vec4(1.0, 1.0, 1.0, 0.08), 5.0 * k)
    f.list.ring(r, vec4(1.0, 1.0, 1.0, 0.2), 5.0 * k, width: max(round(k), 1.0))
    let tw = f.fonts.font(Face::Sans).measure(key, size)
    let top = kit::centred_top(f.fonts, y + ch * 0.5, size)
    let _ = f.list.text(
        f.fonts,
        Face::Sans,
        key,
        size,
        vec2(round(x + (kw - tw) * 0.5), top),
        IVORY,
        weight: kit::MEDIUM,
    )
    kw
}

/// The readout in the screen's corner: the pace the frames kept, the times they took, and the
/// size the scene is drawn at.
fn draw_readout(f: mut Front, w: f32, h: f32, k: f32) {
    let r = f.readout.read
    let (wide, high) = f.drawn_at
    let lines = [
        String::from(f"{r.rate:.0} new images a second (the screen shows {1.0 / f.base:.0})"),
        String::from(
            f"a frame takes {r.middle:.1} ms, 1 in 20 over {r.slow:.1}, the slowest {r.slowest:.1}",
        ),
        String::from(f"{r.late} late of the last {r.of}"),
        String::from(f"drawn {wide} x {high} on a screen of {w:.0} x {h:.0}"),
    ]
    let size = 13.0 * k
    let row = round(19.0 * k)
    let pad = round(10.0 * k)
    var wideness = 0.0
    for line in lines {
        wideness = max(wideness, f.fonts.font(Face::Sans).measure(line.as_str(), size))
    }
    let plate = Rect::new(
        pad,
        pad,
        round(wideness) + 2.0 * pad,
        f32(lines.len()) * row + 2.0 * pad - round(4.0 * k),
    )
    f.list.rect(plate, vec4(0.0, 0.0, 0.0, 0.72), radius: round(6.0 * k))
    var y = plate.y + pad
    for line in lines {
        let _ = f.list.text(f.fonts, Face::Sans, line.as_str(), size, vec2(plate.x + pad, y), IVORY)
        y += row
    }
}

/// The pause menu in the middle of the dimmed scene: Resume, Play online and the title, and
/// under them the controls, each with its keys. Whether the pointer is over an action.
fn draw_menu(f: mut Front, w: f32, h: f32, k: f32) -> bool {
    let fade = f.menu
    let eased = fade * fade * (3.0 - 2.0 * fade)
    f.list.alpha = eased
    let pad = round(28.0 * k)
    let pw = round(min(380.0 * k, w - 32.0 * k))
    let bh = round(44.0 * k)
    let gap = round(10.0 * k)
    let row = round(34.0 * k)
    let controls: [(Text, Text, Text); 4] = [
        ("Sheet in", "W", "Up"),
        ("Let the sail fly", "S", "Down"),
        ("Steer", "A", "D"),
        ("Pause", "Esc", ""),
    ]
    let heading = round(28.0 * k)
    let ph = pad +
        heading +
        round(20.0 * k) +
        (bh + gap) * 3.0 -
        gap +
        round(28.0 * k) +
        round(14.0 * k) +
        round(14.0 * k) +
        row * 4.0 +
        round(10.0 * k) +
        round(36.0 * k) +
        pad
    let lift = if f.reduced { 0.0 } else { (1.0 - eased) * 8.0 * k }
    let px = round((w - pw) * 0.5)
    let py = round(max((h - ph) * 0.5, 16.0 * k) + lift)
    let panel = Rect::new(px, py, pw, ph)
    kit::shadow(mut f.list, panel, kit::CARD_RADIUS * k, k)
    f.list.rect(panel, PANEL, kit::CARD_RADIUS * k)
    f.list.ring(panel, vec4(1.0, 1.0, 1.0, 0.1), kit::CARD_RADIUS * k, width: max(round(k), 1.0))
    var y = py + pad
    let _ = f.list.text(
        f.fonts,
        Face::Display,
        "Paused",
        heading,
        vec2(px + pad, y),
        IVORY,
    )
    y += heading + round(20.0 * k)
    var hand = false
    for i in 0..3 {
        let r = Rect::new(px + pad, y, pw - pad * 2.0, bh)
        if action(mut f, MENU[i], r, MENU_LABELS[i], main: i == 0, k: k) { hand = true }
        y += bh + gap
    }
    y += round(28.0 * k) - gap
    // The controls: a quiet heading, then each control and its keys.
    f.list.rect(
        Rect::new(px + pad, y - round(14.0 * k), pw - pad * 2.0, max(round(k), 1.0)),
        vec4(
            1.0,
            1.0,
            1.0,
            0.1,
        ),
    )
    let _ = f.list.text(
        f.fonts,
        Face::Sans,
        "CONTROLS",
        11.0 * k,
        vec2(px + pad, y),
        MUTED,
        weight: kit::SEMIBOLD,
    )
    y += round(14.0 * k) + round(14.0 * k)
    for (what, a, b) in controls {
        let size = 14.0 * k
        let ch = round(24.0 * k)
        let top = kit::centred_top(f.fonts, y + ch * 0.5, size)
        let _ = f.list.text(f.fonts, Face::Sans, what, size, vec2(px + pad, top), IVORY)
        // The keys at the right, the second (if any) before the first's left.
        var right = px + pw - pad
        let second = b.len() > 0
        if second {
            let size2 = 13.0 * k
            let bw = round(max(f.fonts.font(Face::Sans).measure(b, size2) + 16.0 * k, ch))
            right -= bw
            let _ = cap(mut f, b, right, y, k)
            right -= round(6.0 * k)
        }
        let size1 = 13.0 * k
        let aw = round(max(f.fonts.font(Face::Sans).measure(a, size1) + 16.0 * k, ch))
        let _ = cap(mut f, a, right - aw, y, k)
        y += row
    }
    y += round(10.0 * k)
    for line in [
        "On a gamepad: the left stick or the D-pad",
        "sails and steers, and Start pauses.",
    ] {
        let _ = f.list.text(f.fonts, Face::Sans, line, 12.5 * k, vec2(px + pad, y), MUTED)
        y += round(18.0 * k)
    }
    f.list.alpha = 1.0
    hand
}
