// The fight's bodies: each fighter's state in the rules (what it's doing, how far into it, its
// move, its place) drives a body through `engine::playback`, drawn as the combat lab draws its
// fighter (content/humanoid, `SHOW=12`): painted in 3D, then inked.
//
// The rules never read a pose. A body follows them: a move the rules begin begins on the body
// (cutting short what it was doing, as an inertial change), timed to the rules' frames so that
// what's seen to land lands when the rules say it hits; and its place is the rules' place, the
// difference a rollback makes taken up as the body's drift (`Mover::drift`), which dies away
// rather than jumping.
//
// The moves are stand-ins, every one hand-keyed or written in Wrela, each timed to its move's
// frames. A strike with the longsword is the slash (content/humanoid's `slash`), a fighter with it
// standing in the armed guard with the lab's stand-in in its hand (`armed`, `stick`); a strike
// with the fists is the cross, a player's thrown with a step (`stepping`; with
// `sim::TRAVELLING` off the standing cross, `solved`), and the idol's standing. Each player's
// strike steps as far as the rules carry it (`sim::TRAVEL`). The dodge is the roll
// (content/moves); a parry is the step back. A blow is no clip (`engine::contact`): both bodies
// are held still through the rules' hold, and as it breaks the one struck is knocked along the
// blow and the blow runs back up the striker's arm, each laid into its inertia; the camera's
// kicked along it. The idol is the same body, larger, in stone.

use std::collections::Vec
use std::gpu::{
    Cull, DepthTexture, GpuBuffer, Rgba16Float, Rgba8, Texture, begin_pass3_with_depth,
    begin_screen_pass, buffer_of, depth_texture, draw, texture, write,
}
use std::math::{atan2, cos, sin}
use std::transform::identity
use engine::anime
use engine::anime::{Anime, Drawer, LIGHT, Look, PLAIN, STRIKE}
use engine::humanoid::{Pose, palette}
use engine::playback
use engine::playback::{Gaits, Handling, Move, Mover}
use engine::contact
use engine::contact::{Give, Hit, Kick, Knock, Shock}
use engine::end::{End, RIGHT_FIST}
use engine::held
use engine::held::Held
use engine::humanoid::pose_world
use engine::view::first_camera
use engine::written::Beats
use humanoid::body::{GAITS_CODE, HERO, ROLL_CODE}
use humanoid::exchange::{X_STONE, X_TINT}
use humanoid::fists::{GUARD, STEP_OUT}
use humanoid::ink::ink
use humanoid::look::{SUN, Shot}
use humanoid::paint::{backdrop, body, ground, paint_backdrop, paint_body, paint_ground}
use humanoid::{armed, slash, solved, stepping, stick}
use combat::sim::{
    ACTIVE, ATTACKS, DODGE_FRAMES, DODGING, FISTS, HZ, IDLE, LONGSWORD, MAX_PARTY, MOVES, NO_MOVE,
    SWORD, PARRYING, PUSH, RECOVER, STAGGERED, Seen, TRAVEL, TRAVELLING, WEAPONS, WINDUP, World,
}
use ui::draw::Renderer

/// A metre is this many of the rules' units.
pub const UNIT: f32 = 64.0

/// The swordsman's tint (`Shot::tint`, its last slot): his clothes taken to a red, as the lab's
/// foe is, so he stands apart from the party (in blue, but this player) as the idol does in
/// stone.
pub const MAN_TINT: vec4 = vec4(0.95, 0.16, 0.12, 0.95)

/// How much larger than a man the idol is drawn.
pub const IDOL_SCALE: f32 = 1.6

/// The one-offs a body acts, by index: each player's move (`MOVES`), each of the boss's attacks
/// (from `BOSS_STRIKES`, `ATTACKS`), the dodge, the parry and the hit taken.
pub const BOSS_STRIKES: u32 = 9
pub const ACT_DODGE: u32 = 16
pub const ACT_PARRY: u32 = 17

/// The solved cross at a move's beats (`engine::written::Written::played`): its keys laid on
/// the move's frames, its contact on the frame the rules hit, the first of its active ones. (The
/// boss's rules meet the party a step after its windup ends, so its strikes are played with a
/// windup a frame longer and an active window a frame shorter: the same frames in all.)
fn struck_at(windup: u32, active: u32, recovery: u32) -> Move {
    solved::cross_at(Beats::of_frames(windup, active, recovery, f32(HZ)))
}

/// Which weapon (`WEAPONS`) makes move `m` (`MOVES`): the one whose light attack, its combo's
/// next on from it, or whose heavy one it is (`FISTS` for none).
pub fn weapon_of(m: u32) -> u32 {
    for w in 0..WEAPONS.len() {
        var k = WEAPONS[w].light
        for _ in 0..MOVES.len() {
            if k == m {
                return w
            }
            if k == NO_MOVE {
                break
            }
            k = MOVES[k].next
        }
        if WEAPONS[w].heavy == m {
            return w
        }
    }
    FISTS
}

/// Move `i` (`MOVES`) as its weapon's strike, at its frames: the longsword's the slash, the
/// fists' the cross (`stepped_at`); each stepping as the rules carry it (`TRAVELLING`), or not.
fn player_strike(i: u32) -> Move {
    let m = MOVES[i]
    if bladed(weapon_of(i)) {
        let beats = Beats::of_frames(m.windup, m.active, m.recovery, f32(HZ))
        if TRAVELLING { slash::slash_at(beats) } else { slash::standing_at(beats) }
    } else {
        stepped_at(m.windup, m.active, m.recovery)
    }
}

/// What a fighter with `weapon` holds: the longsword the stand-in, as the slash holds it.
pub fn held_of(weapon: u32) -> Held {
    if bladed(weapon) { slash::WIELD.held } else { held::NOTHING }
}

/// What strikes with `weapon`'s blows: the longsword the striking point along its blade
/// (`slash::STRIKE`), the fists the right fist.
pub fn strikes_with(weapon: u32) -> End {
    if bladed(weapon) { slash::STRIKE } else { RIGHT_FIST }
}

/// The part that strikes with `weapon` in a body posed `w` (its bones, the body's space): the
/// longsword's blade, from its cross to its point (`stick::CROSS_AT`); the fists' fist, a point.
pub fn striking_part(weapon: u32, w: [engine::humanoid::Rigid; 64]) -> (vec3, vec3) {
    if bladed(weapon) {
        let h = held_of(weapon)
        (h.at(stick::CROSS_AT / stick::LENGTH).in_pose(HERO.rig, w), h.at(1.0).in_pose(HERO.rig, w))
    } else {
        let f = RIGHT_FIST.in_pose(HERO.rig, w)
        (f, f)
    }
}

/// How tall a man stands (m): the top of the head at rest (the head bone, and a hand's width
/// over it). A blade higher passes over him.
pub fn man_top() -> f32 {
    borrow rig = HERO.rig
    rig.rest_world()[rig.find("head")].t.y + 0.12
}

/// The part of the line from `a` to `b` within a man's height (`man_top`), if any.
pub fn within_height(a: vec3, b: vec3) -> Option<(vec3, vec3)> {
    let top = man_top()
    var t0 = 0.0
    var t1 = 1.0
    let d = b.y - a.y
    if abs(d) < 1.0e-6 {
        if a.y < 0.0 || a.y > top {
            return None
        }
    } else {
        let (u, v) = ((0.0 - a.y) / d, (top - a.y) / d)
        t0 = max(t0, min(u, v))
        t1 = min(t1, max(u, v))
        if t0 > t1 {
            return None
        }
    }
    Some((a + (b - a) * t0, a + (b - a) * t1))
}

/// The striking part of player move `i` (`MOVES`) at `time` (s into it), about where the rules
/// have its striker on frame `frame` (its root's travel taken off there): within a man's height.
pub fn part_at(i: u32, time: f32, frame: u32) -> Option<(vec3, vec3)> {
    borrow mv = ACTS[i]
    let w = engine::humanoid::pose_world(HERO.rig, mv.pose(time))
    let r = mv.root_at(time).0 - mv.root_at(f32(frame) / f32(HZ)).0
    let (a, b) = striking_part(weapon_of(i), w)
    within_height(a + r, b + r)
}

/// Player move `i`'s sweep, as the rules hold it (`sim::SWEPT_SHAPES`): through each of its
/// active frames (the rules' frames into it, `windup` on), in `sim::PIECES` pieces from the frame
/// before to it, the four corners of what its striking part covers on the floor, across (to the
/// striker's left, the body's +x) and ahead (+z) of where the rules have the striker on that frame,
/// to the nearest unit; and whether any of it is within a man's height.
pub fn sweep_of(i: u32) -> [[i32; 9]; 12] {
    let m = MOVES[i]
    var out = [[0; 9]; 12]
    let n = f32(combat::sim::PIECES)
    let unit = |v: f32| -> i32 { i32(floor(v * UNIT + 0.5)) }
    for j in 0..min(m.active, 6) {
        let k = m.windup + j
        for p in 0..combat::sim::PIECES {
            let at = j * combat::sim::PIECES + p
            let t0 = (f32(k) - 1.0 + f32(p) / n) / f32(HZ)
            let t1 = t0 + 1.0 / (n * f32(HZ))
            let (s0, s1) = (part_at(i, t0, k), part_at(i, t1, k))
            // (A part out of a man's height at one end of the piece: the piece is the other's.)
            let (a, b) = match (s0, s1) {
                (Some(x), Some(y)) => (x, y),
                (Some(x), None) => (x, x),
                (None, Some(y)) => (y, y),
                (None, None) => continue,
            }
            out[at] = [
                unit(a.0.x),
                unit(a.0.z),
                unit(a.1.x),
                unit(a.1.z),
                unit(b.1.x),
                unit(b.1.z),
                unit(b.0.x),
                unit(b.0.z),
                1,
            ]
        }
    }
    out
}

/// Where a strike with `weapon` (the idol's, `boss`) puts what strikes on its contact, in place
/// (the body's space, as a played move's pose has it): the slash's, a player's stepping cross's
/// as `TRAVELLING` plays it, each less the step it's taken by then; else the standing cross's.
pub fn contact_of(weapon: u32, boss: bool) -> vec3 {
    if bladed(weapon) && !boss {
        let s = slash::slash()
        s.end(HERO.rig, slash::CONTACT) - s.root(HERO.rig, slash::CONTACT)
    } else if !boss && TRAVELLING {
        let s = stepping::cross()
        s.end(HERO.rig, stepping::CONTACT) - s.root(HERO.rig, stepping::CONTACT)
    } else {
        solved::cross().end(HERO.rig, solved::CONTACT)
    }
}

/// A player's strike at its move's frames: the stepping cross, whose step the rules carry it by
/// (`sim::TRAVEL`), or with `TRAVELLING` off the standing cross.
fn stepped_at(windup: u32, active: u32, recovery: u32) -> Move {
    if TRAVELLING {
        stepping::cross_at(Beats::of_frames(windup, active, recovery, f32(HZ)))
    } else {
        struck_at(windup, active, recovery)
    }
}

/// The roll squeezed to the dodge's frames and as many again to get up: the rules carry the
/// body (`DODGE_FRAMES` of them), and the body's on its feet soon after.
fn dodged() -> Move {
    let roll = ROLL_CODE.clone()
    let len = roll.length()
    playback::timed(roll, 0.5 * len, DODGE_FRAMES, 0, DODGE_FRAMES, hz: f32(HZ))
}

@fuel(2 ** 40)
pub const ACTS: [Move; 18] = acts()

fn acts() -> [Move; 18] {
    let m = |i: u32| -> Move {
        player_strike(i)
    }
    let b = |i: u32| -> Move {
        struck_at(ATTACKS[i].windup + 1, ATTACKS[i].active - 1, ATTACKS[i].recovery)
    }
    [
        m(0),
        m(1),
        m(2),
        m(3),
        m(4),
        m(5),
        m(6),
        m(7),
        m(8),
        b(0),
        b(1),
        b(2),
        b(3),
        b(4),
        b(5),
        b(6),
        dodged(),
        STEP_OUT.clone(),
    ]
}

/// How each is drawn: a hard strike as a strike (on twos, an impact frame), a light one lighter,
/// the rest as they play.
pub const LOOKS: [Look; 18] = [
    LIGHT,
    STRIKE,
    LIGHT,
    LIGHT,
    STRIKE,
    STRIKE,
    LIGHT,
    LIGHT,
    STRIKE,
    STRIKE,
    STRIKE,
    STRIKE,
    STRIKE,
    STRIKE,
    STRIKE,
    STRIKE,
    PLAIN,
    PLAIN,
]

/// The gaits a fighter stands, walks and runs with: its guard (`fists::GUARD`, a captured
/// boxer's bounce written as Wrela code), and the walk, run, start and stop written in Wrela
/// (content/moves). Nothing a model made is played in the game (docs/citations.md, "The rules").
@fuel(2 ** 40)
pub const GAITS: Gaits = Gaits {
    idle: GUARD.clone(),
    walk: GAITS_CODE.walk.clone(),
    run: GAITS_CODE.run.clone(),
    start: GAITS_CODE.start.clone(),
    stop: GAITS_CODE.stop.clone(),
    start_exit: GAITS_CODE.start_exit,
    stop_entry: GAITS_CODE.stop_entry,
    // (Locked on to the foe, it faces him and goes any way about him: content/humanoid's lock-on
    // gaits.)
    locked: humanoid::armed::LOCKED.clone(),
    holds: false,
}

/// The gaits a fighter with the longsword stands, walks and runs with: the armed guard
/// (`armed::GUARD`, Quaternius's sword idle over the slash's guard), its upper body held in it as
/// it goes, its legs the fight's walk and run.
@fuel(2 ** 40)
pub const ARMED: Gaits = Gaits { idle: armed::GUARD.clone(), holds: true, ..GAITS.clone() }

/// Each weapon's gaits (`WEAPONS`: the fists', the longsword's).
@fuel(2 ** 40)
pub const GAITS_OF: [Gaits; 3] = [GAITS.clone(), ARMED.clone(), ARMED.clone()]

/// Whether `weapon` is a blade (`WEAPONS`: the longsword, the swordsman's): held, struck with its
/// blade, played as the slash.
pub fn bladed(weapon: u32) -> bool {
    weapon == LONGSWORD || weapon == SWORD
}

/// How a fighting body follows its stick: it sets off and stops at once (the rules do), without
/// the actor's own first and last steps.
const HOW: Handling = Handling { clips: false, act_half: 0.03 }

/// How fast (m/s) a standing body is asked to go the way the rules face it: under what sets it
/// off, so it turns on the spot to face that way.
const FACE: f32 = 0.1

/// The heading (radians about up, from +z toward +x, as `engine::playback`'s) of the rules'
/// facing `facing`, one of their 16 directions (`combat::sim::direction`: the first +x, the
/// fourth +z).
pub fn heading_of(facing: u32) -> f32 {
    let a = f32(facing % 16) * 0.39269908
    atan2(cos(a), sin(a))
}

/// A fighter's body and what the rules last said of it.
pub struct Body: Copy {
    pub mover: Mover,
    pub drawer: Drawer,
    /// What it was doing, its move, its health and its place (m), as the rules last said.
    pub act: u32,
    pub move_: u32,
    pub hp: i32,
    pub at: vec3,
    /// The rules' frame it last followed.
    pub frame: u32,
    /// The boss's (its strikes are `BOSS_STRIKES` on, and it's drawn larger).
    pub boss: bool,
    /// The rules' hold on it as last seen, and a blow it struck or took that it gives to as the
    /// hold breaks (`STRUCK` or `STRIKER` in `role`; `NOTHING` none); how it's knocked by those
    /// it took (held out while the rules hold it staggered); and the shock of one it struck,
    /// running up its arm.
    pub hold: u32,
    pub hit: Hit,
    pub role: u32,
    pub knock: Knock,
    pub shock: Shock,
    /// How far the rules' pushes had carried it as last seen (m, along the floor).
    pub carried: vec3,
    /// Its weapon (`WEAPONS`), as the rules say: what it stands, holds and strikes with.
    pub weapon: u32,
}

/// What a body's pending blow is to it (`Body::role`).
pub const NOTHING: u32 = 0
pub const STRUCK: u32 = 1
pub const STRIKER: u32 = 2

/// How the fight's bodies take blows and give them (`engine::contact::Give`). A blow drives a body
/// no further than the rules push it (mmo/combat's knockback): a body is drawn where they put it,
/// its whole body's drive the rules' push (`Knock::carried`; drawn behind it at most two of the
/// heaviest pushes, `carry`) and none of its own (`back`), its head, trunk and guard giving as the
/// blow says, its lean at most a hand's width (`LEAN_MOST`) however many blows land.
pub const GIVE: Give = Give { back: 0.0, lean: 0.1, most: 1.0, carry: 2.0 * f32(PUSH) / UNIT }

/// How far a blow may lean a drawn body's head off where its moves have it (m): a hand's width.
pub const LEAN_MOST: f32 = 0.1

/// The most frames the rules hold a blow (mmo/combat's `hold_of`): a blow held that long is as
/// heavy as a fight's blows get.
const MOST_HOLD: u32 = 8

/// How far the rules' pushes have carried `seen` in all (m).
pub fn carried_of(seen: Seen) -> vec3 {
    vec3(f32(seen.carried_x) / UNIT, 0.0, f32(seen.carried_z) / UNIT)
}

/// Where the rules put `seen` (m).
pub fn place_of(seen: Seen) -> vec3 {
    vec3(f32(seen.x) / UNIT, 0.0, f32(seen.z) / UNIT)
}

impl Body {
    pub fn new(seen: Seen, boss: bool) -> Body {
        let at = place_of(seen)
        Body {
            mover: Mover::standing(at, heading_of(seen.facing), GAITS_OF[weapon_kept(seen)]),
            drawer: Drawer::new(),
            act: seen.act,
            move_: seen.move_,
            hp: seen.hp,
            at,
            frame: 0,
            boss,
            hold: 0,
            hit: Hit { at: vec3(0.0), way: vec3(0.0, 0.0, 1.0), weight: 0.0, hold: 0.0 },
            role: NOTHING,
            knock: Knock::none(),
            shock: Shock::none(),
            carried: carried_of(seen),
            weapon: weapon_kept(seen),
        }
    }
}

/// `seen`'s weapon, one the bodies draw (`GAITS_OF`): another's drawn as fists.
fn weapon_kept(seen: Seen) -> u32 {
    if seen.weapon < GAITS_OF.len() { seen.weapon } else { FISTS }
}

/// Where body `b` is drawn (on the floor, m): the rules' place, its drift, and how far behind a
/// push the knock's drive still has it.
pub fn drawn_at(b: Body) -> vec3 {
    b.mover.place + b.mover.drift + b.mover.knocked
}

/// The one-off the rules have `seen` timing, and how far into it they are (s): a strike's
/// (its move's, or `BOSS_STRIKES` on for the boss's), or the dodge's; `NONE` for none.
pub fn timed_by_rules(boss: bool, seen: Seen) -> (u32, f32) {
    let hz = f32(HZ)
    if seen.act == DODGING {
        return (ACT_DODGE, f32(DODGE_FRAMES - min(seen.timer, DODGE_FRAMES)) / hz)
    }
    let striking = seen.act == WINDUP || seen.act == ACTIVE || seen.act == RECOVER
    if !striking || seen.move_ == NO_MOVE {
        return (engine::humanoid::NONE, 0.0)
    }
    let (act, w, a, r) = if boss {
        let k = ATTACKS[seen.move_]
        (BOSS_STRIKES + seen.move_, k.windup, k.active, k.recovery)
    } else {
        let k = MOVES[seen.move_]
        (seen.move_, k.windup, k.active, k.recovery)
    }
    let end = if seen.act == WINDUP { w } else if seen.act == ACTIVE { w + a } else { w + a + r }
    (act, f32(end - min(seen.timer, end)) / hz)
}

/// The one-off the rules begin as they go from what `b` last saw to `seen`, and how far into it
/// they are (s): `NONE` for none.
pub fn begun(b: Body, seen: Seen) -> (u32, f32) {
    let fresh = seen.act != b.act || seen.move_ != b.move_
    if seen.act == WINDUP && fresh && seen.move_ != NO_MOVE {
        return timed_by_rules(b.boss, seen)
    }
    if seen.act == DODGING && b.act != DODGING {
        return timed_by_rules(b.boss, seen)
    }
    if seen.act == PARRYING && b.act != PARRYING {
        return (ACT_PARRY, 0.0)
    }
    (engine::humanoid::NONE, 0.0)
}

/// One drawn frame of body `b` following `seen` at the rules' frame `frame`, `dt` (s) on: its
/// pose and where it's drawn. It faces the way the rules face it.
pub fn follow(b: mut Body, seen: Seen, frame: u32, mask: [f32; 64], dt: f32) -> (Pose, mat4) {
    let at = place_of(seen)
    let (act, into) = begun(b, seen)
    // Going where the rules took it, as fast as they did; standing, turned the way they face it.
    let facing = heading_of(seen.facing)
    let steps = if frame > b.frame { f32(frame - b.frame) } else { 0.0 }
    // What of its move is the rules' push, not a walk: drawn as the blow's drive (`Knock`).
    let pushed = carried_of(seen) - b.carried
    let moved = at - b.at - pushed
    var stick = if seen.act == IDLE && steps > 0.0 { moved * (f32(HZ) / steps) } else {
        vec3(0.0)
    }
    if length(stick) > 8.0 {
        // (A rollback's jump isn't a speed.)
        stick = vec3(0.0)
    }
    if length(stick) < 0.05 {
        stick = vec3(sin(facing), 0.0, cos(facing)) * FACE
    }
    if act != engine::humanoid::NONE {
        // What the rules begin cuts short what the body was doing.
        b.mover.acting = engine::humanoid::NONE
    } else if frame > b.frame {
        // A move under way keeps the rules' time, each frame they step: what's drawn landing
        // is drawn on the frame they hit, whatever frames the drawing kept.
        let (going, t) = timed_by_rules(b.boss, seen)
        if going != engine::humanoid::NONE && going == b.mover.acting {
            b.mover.act_time = t - dt
        }
    }
    // Locked on in the rules, it faces the way they face it and goes where they take it, its
    // feet going any way about the way it faces (`playback`'s locked gaits); else it turns to
    // face where it goes.
    if seen.locked {
        b.mover.facing(facing)
    } else {
        b.mover.unlocked()
    }
    // Held at a blow, it's still; as the hold breaks it gives to the blow.
    let held = seen.hold > 0
    if !held && b.role != NOTHING {
        if b.role == STRUCK {
            b.knock.struck(b.mover, b.hit, GIVE)
        } else {
            // (A cut sends nothing back up the arm: it goes on through.)
            if !b.hit.cuts {
                b.shock = Shock::struck(b.hit, end: strikes_with(b.weapon))
            }
        }
        b.role = NOTHING
    }
    // Reeling, it's held out for as long as the rules hold it staggered.
    b.knock.reeling(seen.act == STAGGERED)
    // (The push moves its place and is held back by its drive at once, so it's drawn where it was
    // and goes there at the drive's pace.)
    b.mover.place += pushed
    b.knock.carried(pushed)
    let still = if held { 0.0 } else { dt }
    b.knock.step(mut b.mover, GIVE, still)
    b.shock.step(GIVE, still)
    let moved = playback::step(
        mut b.mover,
        GAITS_OF[b.weapon],
        ACTS,
        HERO.rig,
        mask,
        stick,
        act,
        upper: false,
        how: HOW,
        dt: contact::paced(dt, held: held, grind: 0.0),
    )
    let pose = b.shock.over(b.mover, HERO.rig, b.knock.over(HERO.rig, moved, GIVE))
    if act != engine::humanoid::NONE && into > b.mover.act_time {
        // (Begun on a frame already past, as a rollback finds it: it catches up.)
        b.mover.act_time = into
    }
    // Acting, it doesn't steer itself: it turns the way the rules face it (a strike turned as it
    // begins, the boss tracking its target through its windup), as a standing body turns.
    if b.mover.acting != engine::humanoid::NONE {
        let goal = b.mover.heading + playback::wrapped(facing - b.mover.heading)
        let (h, spin) = playback::sprung(b.mover.heading, b.mover.spin, goal, HOW.turn_half, dt)
        b.mover.heading = playback::wrapped(h)
        b.mover.spin = spin
    }
    // Its place is the rules': what it's off by is drift, which dies away (a push, the knock's
    // drive, laid in above).
    let off = at - b.mover.place
    b.mover.place = at
    b.mover.drift -= vec3(off.x, 0.0, off.z)
    b.carried = carried_of(seen)
    b.act = seen.act
    b.move_ = seen.move_
    b.hp = seen.hp
    b.hold = seen.hold
    b.at = at
    b.frame = frame
    let placed = playback::placed(b.mover)
    let s = if b.boss { IDOL_SCALE } else { 1.0 }
    let scale = mat4(
        vec4(s, 0.0, 0.0, 0.0),
        vec4(0.0, s, 0.0, 0.0),
        vec4(0.0, 0.0, s, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    (pose, placed * scale)
}

/// What a body shows on a drawn frame, as it's drawn (a strike on twos, smeared): its pose, where
/// it's drawn, its palette, and how kinetic it is and where its strike's force runs.
pub struct Shown: Copy {
    pub pose: Pose,
    pub place: mat4,
    pub palette: [mat4; 64],
    pub impact: f32,
    pub force: anime::Force,
}

/// One drawn frame of body `b` following `seen` (`follow`), as it's drawn.
pub fn shown(b: mut Body, seen: Seen, frame: u32, mask: [f32; 64], dt: f32) -> Shown {
    let (pose, place) = follow(mut b, seen, frame, mask, dt)
    let d = anime::drawn(
        mut b.drawer,
        b.mover,
        ACTS,
        LOOKS,
        HERO.rig,
        mask,
        pose,
        place,
        Anime { smear: 0.6, held: held_of(b.weapon) },
        dt,
    )
    Shown {
        pose: d.pose,
        place: d.place,
        palette: anime::drawn_palette(
            palette(HERO.rig, d.pose, d.place),
            HERO.rig,
            d,
            held_of(b.weapon),
        ),
        impact: d.impact,
        force: d.force,
    }
}

/// The fight's bodies, the boss's first, then each player's: no GPU, so a tool steps them too.
pub struct Bodies: Clone {
    bodies: Vec<Body>,
    mask: [f32; 64],
    /// The camera's kick from the fight's blows, and how many blows have landed.
    kick: Kick,
    pub blows: u32,
}

impl Bodies {
    pub fn new() -> Bodies {
        Bodies {
            bodies: Vec::new(),
            mask: playback::upper_body(HERO.rig),
            kick: Kick::none(),
            blows: 0,
        }
    }

    /// Each body stepped `dt` (s) on, following `w`: what each shows, the boss's first. A fight
    /// begun anew (a body more or fewer, or its first frame) stands them where the rules do.
    pub fn follow(mut self, w: World, dt: f32) -> Vec<Shown> {
        let n = w.players() + 1
        if self.bodies.len() != n || w.frame < self.bodies[0].frame {
            self.bodies.clear()
            // (The idol drawn as the idol; the swordsman, a man, as a player is.)
            self.bodies.push(Body::new(w.boss(), boss: !w.against_man()))
            for i in 0..w.players() {
                self.bodies.push(Body::new(w.player(i), boss: false))
            }
        }
        self.contacts(w)
        self.kick.step(GIVE, dt)
        var out: Vec<Shown> = Vec::new()
        for k in 0..n {
            let seen = if k == 0 { w.boss() } else { w.player(k - 1) }
            var b = self.bodies[k]
            out.push(shown(mut b, seen, w.frame, self.mask, dt))
            self.bodies[k] = b
        }
        out
    }

    /// The blows the rules land as they go from what the bodies last saw to `w`: a striker (its
    /// strike active, its hold begun) and each it struck (its health down, or staggered: a
    /// parried blow), the blow from where the striker's fist is drawn, along the way from it to
    /// the one struck, as heavy as the rules hold it. Each gives to it as its hold breaks; the
    /// camera's kicked at once.
    fn contacts(mut self, w: World) {
        let n = self.bodies.len()
        borrow rig = HERO.rig
        for k in 0..n {
            let seen = if k == 0 { w.boss() } else { w.player(k - 1) }
            let b = self.bodies[k]
            let struck = seen.hp < b.hp || (seen.act == STAGGERED && b.act != STAGGERED)
            if !struck || w.frame == b.frame {
                continue
            }
            // Its striker: the boss for a player, the nearest player striking for the boss.
            var from = n
            var best = 1.0e9
            for j in 0..n {
                if (k == 0) == (j == 0) {
                    continue
                }
                let s = if j == 0 { w.boss() } else { w.player(j - 1) }
                let d = length(drawn_at(self.bodies[j]) - drawn_at(b))
                // (A player staggered by the swordsman's parry: he's what struck it back.)
                let parrying = seen.act == STAGGERED && s.act == PARRYING
                if (s.act == ACTIVE || s.act == RECOVER || parrying) && d < best {
                    best = d
                    from = j
                }
            }
            if from == n {
                continue
            }
            let striker = if from == 0 { w.boss() } else { w.player(from - 1) }
            let a = self.bodies[from]
            let scale = if a.boss { IDOL_SCALE } else { 1.0 }
            let fist = playback::placed(a.mover) *
                vec4(
                    strikes_with(a.weapon).in_pose(rig, pose_world(rig, a.mover.shown)) * scale,
                    1.0,
                )
            let way = drawn_at(b) - drawn_at(a)
            // (A parried blow staggers what threw it: it's struck back as hard as blows go.)
            let parried = seen.act == STAGGERED
            let frames = max(max(striker.hold, seen.hold), 1)
            let hit = Hit {
                at: fist.xyz,
                way: if parried { -way } else { way },
                weight: if parried { 1.0 } else {
                    contact::weight_of(hold: f32(frames), most: f32(MOST_HOLD))
                },
                hold: f32(frames) / f32(HZ),
                cuts: !parried && held_of(a.weapon).cuts,
            }
            self.bodies[k].hit = hit
            self.bodies[k].role = STRUCK
            if !parried {
                self.bodies[from].hit = hit
                self.bodies[from].role = STRIKER
            }
            self.kick.kicked(hit, GIVE)
            self.blows += 1
        }
    }

    /// Where the camera's kicked to by the fight's blows (m, the world).
    pub fn kicked(self) -> vec3 {
        self.kick.at
    }

    /// Body `k`'s (the boss's 0, player `i`'s `i + 1`), as last followed.
    pub fn body(self, k: u32) -> Body {
        self.bodies[k]
    }

    pub fn mask(self) -> [f32; 64] {
        self.mask
    }
}

/// The fight drawn: its bodies, the camera across the line from this player to the boss, and the
/// textures the paint pass writes and the ink reads.
pub struct Ring {
    verts: GpuBuffer<engine::humanoid::BodyVertex>,
    indices: GpuBuffer<u32>,
    /// The stand-in's triangles, on after the body's vertices (`stick::on_body`): drawn with a
    /// body that holds it.
    held: GpuBuffer<u32>,
    held_count: u32,
    palettes: Vec<GpuBuffer<mat4>>,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
    depth: DepthTexture,
    width: u32,
    height: u32,
    bodies: Bodies,
    /// The camera's eye and where it looks, eased after where they'd be.
    eye: vec3,
    look: vec3,
}

/// The camera sees the fight at three-quarters to the line from this player to the foe: across
/// it (`ACROSS`) and behind this player (`BEHIND`), so the foe stands apart from the players
/// and the players side by side apart from each other, and from above (`RISE`), so who's
/// nearer stands lower on the screen. It's at least `NEAREST` metres off and far enough back to
/// hold every fighter (each fighter's distance from the middle `HOLD` times over), and eases
/// after where it'd be by `STEADY` (s: half the way in that time), so it holds steady as
/// fighters step, keeping to the side of the line it's on.
const ACROSS: f32 = 0.75
const BEHIND: f32 = 0.65
const RISE: f32 = 0.42
const NEAREST: f32 = 6.5
const HOLD: f32 = 2.4
const STEADY: f32 = 0.6
/// Where it looks: this high over the middle of the fight (m).
const FOCUS: f32 = 1.3

impl Ring {
    pub fn new() -> Ring {
        var palettes: Vec<GpuBuffer<mat4>> = Vec::new()
        for _ in 0..(MAX_PARTY + 1) {
            palettes.push(buffer_of([identity(); 64]))
        }
        let (sv, st) = stick::on_body(HERO.verts.len())
        var verts = HERO.verts.clone()
        for v in sv {
            verts.push(v)
        }
        Ring {
            verts: buffer_of(verts),
            indices: buffer_of(HERO.indices),
            held: buffer_of(st.clone()),
            held_count: st.len(),
            palettes,
            colour: texture(width: 640, height: 360),
            marks: texture(width: 640, height: 360),
            normal: texture(width: 640, height: 360),
            depth: depth_texture(width: 640, height: 360),
            width: 640,
            height: 360,
            bodies: Bodies::new(),
            eye: vec3(0.0),
            look: vec3(0.0),
        }
    }

    /// The fight drawn at `time` (s), `dt` on, from player `me`'s side, at `width` by `height`,
    /// with `ui` drawn over it; and presented.
    pub fn draw(
        mut self,
        w: World,
        me: u32,
        time: f32,
        dt: f32,
        width: u32,
        height: u32,
        ui: Renderer,
    ) {
        if width != self.width || height != self.height {
            self.colour = texture(width: width, height: height)
            self.marks = texture(width: width, height: height)
            self.normal = texture(width: width, height: height)
            self.depth = depth_texture(width, height)
            self.width = width
            self.height = height
        }
        let shown = self.bodies.follow(w, dt)
        var kinetic = 0.0
        var force = anime::Force::none()
        for d in shown {
            kinetic = max(kinetic, d.impact)
            if d.force.by > force.by {
                force = d.force
            }
        }
        let mine = if me < w.players() { me } else { 0 }
        let my_at = drawn_at(self.bodies.body(mine + 1))
        let boss_at = drawn_at(self.bodies.body(0))
        // The middle of every fighter standing, and how far the furthest is from it.
        let n = shown.len()
        var middle = vec3(0.0)
        for k in 0..n {
            middle += drawn_at(self.bodies.body(k))
        }
        middle = middle / f32(n)
        var spread = 0.0
        for k in 0..n {
            spread = max(spread, length(drawn_at(self.bodies.body(k)) - middle))
        }
        // Across the line from this player to the foe, a little behind this player, on the side
        // it's on already (at first, the left).
        let to = vec3(boss_at.x - my_at.x, 0.0, boss_at.z - my_at.z)
        let ahead = if length(to) > 0.01 { normalize(to) } else { vec3(0.0, 0.0, 1.0) }
        var across = vec3(ahead.z, 0.0, -ahead.x)
        let first = self.eye == vec3(0.0)
        if !first && dot(across, self.eye - self.look) < 0.0 {
            across = -across
        }
        let way = normalize(across * ACROSS - ahead * BEHIND + vec3(0.0, RISE, 0.0))
        let far = max(NEAREST, spread * HOLD + 3.0)
        let want_look = middle + vec3(0.0, FOCUS, 0.0)
        let want_eye = want_look + way * far
        let k = if first { 1.0 } else { 1.0 - pow(0.5, clamp(dt, 0.0, 0.1) / STEADY) }
        // (A blow kicks it along the way it goes, and it's sprung back: `engine::contact::Kick`.)
        let kick = self.bodies.kicked()
        self.look = mix(self.look, want_look, vec3(k))
        // (The eye eased about where it looks, so the distance eases, not the chord.)
        let off = mix(self.eye - self.look, want_eye - want_look, vec3(k))
        self.eye = self.look + off
        let left = normalize((shown[mine + 1].palette[0] * vec4(1.0, 0.0, 0.0, 0.0)).xyz)
        let shot = Shot {
            resolution: vec2(f32(width), f32(height)),
            held: floor(time * 12.0) / 12.0,
            kinetic,
            cam: first_camera(self.eye + kick, self.look + kick, 0.62, width, height),
            sun: normalize(SUN),
            feet: my_at,
            left,
            force_from: vec4(force.from, if force.heavy { 1.0 } else { 0.0 }),
            force_to: vec4(force.to, force.by),
            tint: vec4(0.0),
            blast: vec4(0.0, 0.0, 0.0, -1.0),
            blast_dir: vec4(0.0),
            pair_a: vec4(my_at.x, 0.0, my_at.z, 2.0),
            pair_b: vec4(boss_at.x, 0.0, boss_at.z, 2.0),
        }
        let shown_man = w.against_man()
        for k in 0..shown.len() {
            var m = shown[k].palette
            // (Its tint and its own left in the palette's last slot: the idol in stone, the
            // others' bodies in blue, this player's as it is.)
            let tint = if k == 0 {
                if shown_man { MAN_TINT } else { X_STONE }
            } else if k == mine + 1 { vec4(0.0) } else { X_TINT }
            m[63] = mat4(
                tint,
                vec4(normalize((m[0] * vec4(1.0, 0.0, 0.0, 0.0)).xyz), 1.0),
                vec4(0.0),
                vec4(0.0),
            )
            write(mut self.palettes[k], 0, m)
        }
        let p = begin_pass3_with_depth(
            mut self.colour,
            mut self.marks,
            mut self.normal,
            mut self.depth,
            clear: vec4(0.0),
            clear_depth: 0.0,
        )
        draw(
            p,
            backdrop,
            paint_backdrop.bind(shot: shot),
            vertices: 3,
            depth: engine::view::NEAREST,
        )
        draw(
            p,
            ground.bind(shot: shot),
            paint_ground.bind(shot: shot),
            vertices: 6,
            depth: engine::view::NEAREST,
        )
        for k in 0..shown.len() {
            draw(
                p,
                body.bind(verts: self.verts.items(), palette: self.palettes[k].items(), shot: shot),
                paint_body.bind(shot: shot),
                indices: self.indices,
                index_count: HERO.indices.len(),
                cull: Cull::Back,
                depth: engine::view::NEAREST,
            )
            if bladed(self.bodies.body(k).weapon) {
                draw(
                    p,
                    body.bind(
                        verts: self.verts.items(),
                        palette: self.palettes[k].items(),
                        shot: shot,
                    ),
                    paint_body.bind(shot: shot),
                    indices: self.held,
                    index_count: self.held_count,
                    cull: Cull::Back,
                    depth: engine::view::NEAREST,
                )
            }
        }
        p.end()
        let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
        draw(
            screen,
            backdrop,
            ink.bind(shot: shot, colour: self.colour, marks: self.marks, normal: self.normal),
            vertices: 3,
        )
        ui.draw(screen, vec2(f32(width), f32(height)))
        screen.present()
    }
}

// ---- tests --------------------------------------------------------------------------------------

/// A fighter `x` units along, doing `act`.
fn seen_at(x: i32, act: u32, timer: u32, move_: u32) -> Seen {
    Seen { x, z: 0, hp: 100, stamina: 100, act, timer, move_, facing: 4 }
}

/// A rollback that moves a fighter a metre moves its body there by drift: the drawn place
/// doesn't jump, and within a second it's where the rules say.
@test
fn a_rollbacks_jump_is_eased_not_drawn() {
    let mask = playback::upper_body(HERO.rig)
    var b = Body::new(seen_at(0, act: IDLE, timer: 0, move_: NO_MOVE), boss: false)
    let _ = follow(mut b, seen_at(0, act: IDLE, timer: 0, move_: NO_MOVE), 1, mask, 1.0 / 60.0)
    let before = drawn_at(b)
    let _ = follow(
        mut b,
        seen_at(64, act: IDLE, timer: 0, move_: NO_MOVE),
        2,
        mask,
        1.0 / 60.0,
    )
    assert(length(drawn_at(b) - before) < 0.15, "the drawn body doesn't jump with the rules")
    for f in 3..63 {
        let _ = follow(
            mut b,
            seen_at(64, act: IDLE, timer: 0, move_: NO_MOVE),
            f,
            mask,
            1.0 / 60.0,
        )
    }
    assert(length(drawn_at(b) - vec3(1.0, 0.0, 0.0)) < 0.02, "and it's where they say a second on")
}

/// A strike the rules begin begins on the body, cutting short what it was doing; and every
/// strike's fist lands (its active window opens) on the frame the rules hit.
@test
fn a_strike_begins_when_the_rules_say_and_lands_when_they_hit() {
    let mask = playback::upper_body(HERO.rig)
    var b = Body::new(seen_at(0, act: IDLE, timer: 0, move_: NO_MOVE), boss: false)
    let _ = follow(
        mut b,
        seen_at(0, act: PARRYING, timer: 8, move_: NO_MOVE),
        1,
        mask,
        1.0 / 60.0,
    )
    assert(b.mover.acting == ACT_PARRY, "a parry begins the step back")
    let _ = follow(
        mut b,
        seen_at(0, act: WINDUP, timer: MOVES[1].windup, move_: 1),
        2,
        mask,
        1.0 / 60.0,
    )
    assert(b.mover.acting == 1, "the strike cuts the parry short")
    // The rules turn it as it strikes (its stick pressed the other way): it turns that way.
    var turned = seen_at(0, act: WINDUP, timer: MOVES[1].windup - 1, move_: 1)
    turned.facing = 0
    for f in 3..33 {
        let _ = follow(mut b, turned, f, mask, 1.0 / 60.0)
        turned.timer = max(turned.timer, 2) - 1
    }
    let off = playback::wrapped(b.mover.heading - heading_of(0))
    assert(abs(off) < 0.05, "it faces the way the rules face it")
    for i in 0..MOVES.len() {
        let Some(a) = ACTS[i].mark(playback::ACTIVE) else { panic("a strike has its window") }
        assert(abs(a.from - f32(MOVES[i].windup) / f32(HZ)) < 1.0e-4, "it lands as the rules hit")
    }
    for i in 0..ATTACKS.len() {
        let Some(a) = ACTS[BOSS_STRIKES + i].mark(playback::ACTIVE) else { panic("a window") }
        // (Its rules meet the party a step after its windup ends.)
        let hit = f32(ATTACKS[i].windup + 1) / f32(HZ)
        assert(abs(a.from - hit) < 1.0e-4, "the idol's too")
    }
}

/// Every strike the rules have (each of `MOVES`, and each of `ATTACKS` with its extra frame) is
/// played with its fist on its written contact on the frame the rules hit: within 2 cm of it
/// there, and no nearer on any other frame.
@test
fn every_strike_puts_its_fist_on_its_contact_on_the_frame_the_rules_hit() {
    borrow rig = HERO.rig
    for k in 0..(MOVES.len() + ATTACKS.len()) {
        // (What strikes, and where it's written to be on its contact: the longsword's point
        // along its blade, the fists' fist.)
        let weapon = if k < MOVES.len() { weapon_of(k) } else { FISTS }
        let (end, target) = (strikes_with(weapon), contact_of(weapon, boss: k >= MOVES.len()))
        let (act, hit, total) = if k < MOVES.len() {
            let m = MOVES[k]
            (k, m.windup, m.windup + m.active + m.recovery)
        } else {
            let a = ATTACKS[k - MOVES.len()]
            (BOSS_STRIKES + k - MOVES.len(), a.windup + 1, a.windup + a.active + a.recovery)
        }
        let off = |f: u32| -> f32 {
            length(
                end.in_pose(rig, engine::humanoid::pose_world(rig, ACTS[act].pose(f32(f) / 60.0))) -
                    target,
            )
        }
        let on = off(hit)
        assert(on < 0.02, f"strike {k}: {on} m from its contact on the hit frame")
        for f in 0..total + 1 {
            assert(f == hit || off(f) >= on, f"strike {k}: nearer its contact on frame {f}")
        }
    }
}

/// A fight's blows are laid into the bodies: the idol struck by a jab gives as the hold breaks
/// (its head turned off what its guard gives it), and the jab's arm shocked. And through blow on
/// blow, no body is drawn further behind the rules' pushes than `GIVE.carry`, nor its head
/// leaned more than a hand's width (`LEAN_MOST`).
@test
fn a_blow_the_rules_land_knocks_the_one_struck_and_shocks_the_striker() {
    var w = World::armed([combat::sim::FISTS])
    var b = Bodies::new()
    let dt = 1.0 / 60.0
    // (The idol walks in; the player jabs it when it's near.)
    var knocked = 0.0
    var shocked = 0.0
    var off = 0.0
    var lean = 0.0
    var drawn = 0.0
    var input: u32 = 0
    for _ in 0..900 {
        let p = w.player(0)
        let i = w.boss()
        let d = length(place_of(p) - place_of(i))
        if d < 2.6 && p.act == IDLE && w.reads(0) & (combat::sim::ATTACK << 6) != 0 {
            input = input ^ (combat::sim::ATTACK << 6)
        }
        combat::sim::step(mut w, [input])
        let _ = b.follow(w, dt)
        let head = HERO.rig.find("head")
        let arm = HERO.rig.find("rightLowerArm")
        knocked = max(knocked, length(b.body(0).knock.head.x))
        shocked = max(shocked, b.body(1).shock.joints[0].x.x)
        let _ = arm
        for k in 0..2 {
            let body = b.body(k)
            off = max(off, length(body.mover.knocked))
            // (Off the rules' place by drift: what's drawn there less the knock's drive behind
            // its push, which `GIVE.carry` bounds above.)
            drawn = max(drawn, length(drawn_at(body) - body.mover.knocked - body.at))
            let w0 = pose_world(HERO.rig, body.mover.shown)
            let w1 = pose_world(HERO.rig, body.knock.over(HERO.rig, body.mover.shown, GIVE))
            lean = max(lean, length(w1[head].t - w0[head].t))
        }
    }
    assert(b.blows > 3, f"blows land: {b.blows}")
    assert(off <= GIVE.carry, f"a body's drawn {off} m behind the rules' pushes")
    assert(lean <= LEAN_MOST, f"a body's head leaned {lean} m by blows")
    // (Drawn off the rules' place by the drift a change of move leaves, past the knock behind a
    // push: no more than main's fight ever was, 0.535 m on `wrela tool feel`'s bench.)
    assert(drawn < 0.6, f"a body's drifted {drawn} m off the rules' place")
    assert(knocked > 0.02, f"the idol's head knocked {knocked} rad")
    assert(shocked > 0.02, f"the jab's arm shocked {shocked} rad")
}

/// A player the idol's slam lands on is pushed by the rules (mmo/combat's knockback), and drawn
/// so: held where it stood through the hold, then carried to where the rules put it by the knock's
/// drive, its feet stepping after it; it doesn't walk there (its push isn't read as a stick), and
/// it ends on the rules' place.
@test
fn a_push_the_rules_give_is_drawn_as_the_knocks_drive() {
    // (The trial turned off, the rules push nothing, and there's nothing to draw.)
    if !combat::sim::KNOCKBACK {
        return
    }
    var w = World::armed([combat::sim::FISTS])
    var b = Bodies::new()
    let dt = 1.0 / 60.0
    var input: u32 = 0
    var pushed = 0.0
    var walked = false
    var stepped = false
    // (The player stands; the idol walks in and makes its pattern till a slam lands.)
    for _ in 0..2400 {
        combat::sim::step(mut w, [input])
        let _ = b.follow(w, dt)
        let body = b.body(1)
        let p = w.player(0)
        if length(carried_of(p)) > 0.3 && pushed == 0.0 {
            pushed = length(carried_of(p))
        }
        if pushed > 0.0 {
            walked = walked || body.mover.doing != playback::STANDING
            stepped = stepped || body.mover.feet[0].step > 0.0 || body.mover.feet[1].step > 0.0
        }
        if pushed > 0.0 && body.knock.still() && length(body.mover.knocked) < 0.01 {
            break
        }
        let _ = input
        input = 0
    }
    assert(pushed > 0.3, f"a heavy blow pushes the player {pushed} m")
    let body = b.body(1)
    assert(
        length(drawn_at(body) - place_of(w.player(0))) < 0.05,
        "and it's drawn on the rules' place",
    )
    assert(!walked, "carried, not walking")
    assert(stepped, "its feet stepping after it")
}

/// The rules carry a striker as its drawn strike steps: each move's travel by each frame
/// (`sim::TRAVEL`) is the root's of the strike the game plays for it (`ACTS`), to the nearest unit,
/// along the way it faces, and none across it. So the body the rules place is where the strike's
/// feet put it.
@test
fn the_rules_carry_a_striker_as_its_strike_steps() {
    var table = String::from("")
    var same = true
    for i in 0..MOVES.len() {
        let m = MOVES[i]
        let total = m.windup + m.active + m.recovery
        table.push_str("    [")
        for k in 0..64 {
            let f = min(k, total)
            let r = if TRAVELLING { ACTS[i].root_at(f32(f) / f32(HZ)).0 } else { vec3(0.0) }
            let units = i32(floor(r.z * UNIT + 0.5))
            assert(abs(r.x) * UNIT < 0.5, f"move {i} goes {r.x} m across its way")
            same = same && (!TRAVELLING || units == TRAVEL[i][k])
            table.push_str(f"{units}{if k < 63 { ", " } else { "" }}".as_str())
        }
        table.push_str("],\n")
    }
    if !same {
        std::io::print(f"sim::TRAVEL, as the strikes step:\n{table}")
    }
    assert(same, "each move's travel is its strike's step")
}

/// The nearest a strike carries its striker to the foe (`sim::NEAREST`) is a man and the idol
/// side by side: each a circle as wide as its shoulders, out to the outside of its upper arms
/// (5 cm thick, as `engine::arms` takes an arm), the idol `IDOL_SCALE` times a man.
@test
fn the_nearest_a_strike_goes_is_two_bodies_side_by_side() {
    borrow rig = HERO.rig
    let w = rig.rest_world()
    let half = 0.5 * length(w[rig.find("leftUpperArm")].t - w[rig.find("rightUpperArm")].t) + 0.05
    let nearest = i32(floor(half * (1.0 + IDOL_SCALE) * UNIT + 0.5))
    std::io::print(f"a man's half-width {half} m: the nearest {nearest} units")
    assert(
        combat::sim::NEAREST == nearest,
        f"sim::NEAREST is {combat::sim::NEAREST}, the bodies {nearest}",
    )
}

/// The rules hit what the drawn strike sweeps: each move's sweep (`sim::SWEPT_SHAPES`) is what its
/// striking part covers on the floor through its active frames as the game draws it
/// (`sweep_of`), piece by piece, to the nearest unit. If the strike's written again, the test
/// prints the new shapes.
@test
fn the_rules_hit_what_the_drawn_strike_sweeps() {
    // (Cooked from the moves as they travel, `sim::TRAVELLING`: each blow's first piece carries
    // the last of its step. With the step off, the sweep's off too, `sim::SWEEPING`, and the shapes
    // aren't read.)
    if !TRAVELLING {
        return
    }
    var table = String::from("")
    var same = true
    for i in 0..MOVES.len() {
        let q = sweep_of(i)
        table.push_str("    [\n")
        for k in 0..12 {
            same = same && q[k] == combat::sim::SWEPT_SHAPES[i][k]
            table.push_str(
                f"        [{q[k][0]}, {q[k][1]}, {q[k][2]}, {q[k][3]}, {q[k][4]}, {q[k][5]}, {q[k][6]}, {q[k][7]}, {q[k][8]}],\n".as_str(),
            )
        }
        table.push_str("    ],\n")
    }
    if !same {
        std::io::print(f"sim::SWEPT_SHAPES, as the strikes sweep:\n{table}")
    }
    assert(same, "each move's sweep is its drawn strike's")
}

/// A body as the rules take it (`sim::BODY`, `sim::IDOL_BODY`): a circle as wide as a man's
/// shoulders out to the outside of his upper arms, as `the_nearest_a_strike_goes_is_two_bodies_
/// side_by_side` measures it, and the idol `IDOL_SCALE` times that.
@test
fn a_body_is_as_wide_as_its_shoulders() {
    borrow rig = HERO.rig
    let w = rig.rest_world()
    let half = 0.5 * length(w[rig.find("leftUpperArm")].t - w[rig.find("rightUpperArm")].t) + 0.05
    let (man, idol) = (i32(floor(half * UNIT + 0.5)), i32(floor(half * IDOL_SCALE * UNIT + 0.5)))
    assert(
        combat::sim::BODY == man && combat::sim::IDOL_BODY == idol,
        f"the rules' bodies {combat::sim::BODY} and {combat::sim::IDOL_BODY}, the drawn {man} and {idol}",
    )
}

/// The swordsman (`sim::THE_SWORDSMAN`) is drawn as a man: at a man's size, armed, his strikes
/// the slash. Parried, he reels for as long as the rules stagger him, his guard knocked open and
/// held out (`Knock::reeling`), his hands knocked off it; and a player his cut lands on takes its
/// hands off its guard with the blow, as a struck man does (#453's: they don't stay where the
/// guard holds them).
@test
fn the_swordsman_parried_reels_his_guard_open() {
    borrow rig = HERO.rig
    var w = World::against(combat::sim::THE_SWORDSMAN, [LONGSWORD])
    var b = Bodies::new()
    let dt = 1.0 / 60.0
    let hands = [rig.find("leftHand"), rig.find("rightHand")]
    // How far the knock takes each body's hands off where its guard holds them, as it's drawn
    // (the most of the two).
    let off_guard = |body: Body| -> f32 {
        let (g, k) = (
            pose_world(rig, body.mover.shown),
            pose_world(rig, body.knock.over(rig, body.mover.shown, GIVE)),
        )
        max(length(k[hands[0]].t - g[hands[0]].t), length(k[hands[1]].t - g[hands[1]].t))
    }
    let _ = b.follow(w, dt)
    var input: u32 = 0
    var staggered = 0
    var open_at_end = 0.0
    var off_reeling = 0.0
    for _ in 0..1200 {
        let to = combat::sim::direction(w.boss().x - w.player(0).x, w.boss().z - w.player(0).z)
        let man = w.boss()
        if man.act == WINDUP && man.timer == 4 && w.player(0).act == IDLE {
            input = input ^ (combat::sim::PARRY << 6)
        }
        combat::sim::step(mut w, [(input & combat::sim::BUTTON_BITS) | (1 + to * 3)])
        let _ = b.follow(w, dt)
        if w.boss().act == STAGGERED {
            staggered += 1
            open_at_end = length(b.body(0).knock.guard.x)
            off_reeling = max(off_reeling, off_guard(b.body(0)))
        } else if staggered > 0 {
            break
        }
    }
    assert(b.body(0).boss == false, "drawn as a man, not the idol")
    assert(staggered >= combat::sim::SWORDSMAN_STAGGER, f"staggered {staggered} frames")
    assert(open_at_end > 0.1, f"his guard's still knocked open as he reels: {open_at_end} rad")
    assert(off_reeling > 0.05, f"his hands knocked {off_reeling} m off his guard")
    // His cut landing on a player who doesn't answer: its hands come off its guard.
    var v = World::against(combat::sim::THE_SWORDSMAN, [LONGSWORD])
    var c = Bodies::new()
    var after = 0.0
    var struck = false
    let _ = c.follow(v, dt)
    for _ in 0..1500 {
        combat::sim::step(mut v, [0])
        let _ = c.follow(v, dt)
        if v.player(0).hp < 100 {
            struck = true
        }
        if struck {
            after = max(after, off_guard(c.body(1)))
            if v.player(0).hold == 0 && length(c.body(1).knock.guard.x) < 0.01 {
                break
            }
        }
    }
    assert(struck, "his cut lands")
    assert(after > 0.05, f"a struck man's hands come off his guard: {after} m")
}
