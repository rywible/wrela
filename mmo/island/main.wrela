// An island a party shares: a room (`std::net`) named `island-<id>`, whose peers walk and place
// marks. What the party does in a visit is the room's log; what the island keeps between visits,
// its marks, is the store's, under `island/<room>`, in a versioned save that outlives a build. A
// room's journal is its build's alone, so after a deploy the new build's room starts with an empty
// journal: it reads the save first, holding its peers' events until the store answers, then
// starts its log from the save.
//
// What crosses the network is decisions (`Act`), and what's written is outcomes: the save is put
// only when a mark is placed, never for a step.
//
// Who a body is comes from its account: a peer wears its character's card with the pass its
// account signed (platform/pass.wrela), and the server checks the pass before the room sees the
// decision, with the Worker's ceremony keys (`std::server::secret`). It writes what it found into
// the decision (`Seal::checked`) and takes the tag off, so the log tells every peer whether the
// card is the account's and shows no one a pass to copy. The host answers the keys at once, so
// nothing waits for them.

use platform::names
use platform::names::Name
use platform::pass
use platform::pass::{NO_TAG, Pass, Tag}
use platform::wire::Look
use std::input::{Event, events, payload}
use std::io::Pending
use std::net::{
    COMPACT_AFTER, Entry, JOURNAL, POISONED, ProposalId, Record, Reduce, Room, Up, Verdict,
}
use std::net::{carry_out, close, compact, room}
use std::pack::{Pack, pack, unpack}
use std::server::secret
use std::store
use std::time::unix_now

/// The save's format: its first byte. A save of another version is read by a migration, or the
/// island starts empty.
pub const SAVE_VERSION: u8 = 1
/// The most marks an island holds.
pub const MAX_MARKS: u32 = 256
/// The longest step a peer takes in one decision, each way.
pub const MAX_STEP: i32 = 24

// Why the island refuses a decision.
/// A step longer than `MAX_STEP`.
pub const TOO_FAR: u32 = 1
/// A mark past `MAX_MARKS`.
pub const FULL: u32 = 2
/// A step past `MAX_REACH` from the island's middle.
pub const OFF_ISLAND: u32 = 3
/// The most bodies an island holds in a visit: with its marks, its state stays well inside one
/// message (64 KiB), which a peer far behind is sent. A newcomer past it takes the place of the
/// body that acted longest ago (one whose peer has most likely left), so no crowd of peers that
/// came and went, nor one that keeps coming, shuts anyone out.
pub const MAX_BODIES: u32 = 512
/// A card whose name the lists don't make, or whose look isn't one of the choices.
pub const NO_SUCH_CARD: u32 = 4
/// How far from the middle a peer may stand, each way: a position never overflows.
pub const MAX_REACH: i32 = 1000000
/// The most events held while the save is read; a connection past it is closed, to come back.
pub const MAX_HELD: u32 = 1024
/// The most message bytes held during the save read: an event-count limit alone can retain
/// tens of MiB of untrusted payloads before any are checked by the room.
pub const MAX_HELD_BYTES: u32 = 1048576
/// Failed reads of the save in a row before the held peers are let go.
pub const MAX_TRIES: u32 = 3
/// A card whose pass its account didn't sign (or that expired): the body stays a wanderer.
pub const NOT_SIGNED: u32 = 5

/// Who a body is: its character's name, by its four numbers into the name lists (so it says
/// nothing anyone typed: platform/names.wrela), and how it looks, a choice of each part
/// (platform/wire.wrela's `Look`). It's worn with a pass (`Seal`), which the server checks.
pub struct Card: Copy + Eq + Pack {
    pub title: u32,
    pub front: u32,
    pub back: u32,
    pub epithet: u32,
    pub build: u32,
    pub skin: u32,
    pub hair: u32,
    pub cloth: u32,
}

impl Card {
    /// The card of a character whose name is `name` and whose look is `look`.
    pub fn of(name: Name, look: Look) -> Card {
        Card {
            title: name.title,
            front: name.front,
            back: name.back,
            epithet: name.epithet,
            build: look.build,
            skin: look.skin,
            hair: look.hair,
            cloth: look.cloth,
        }
    }

    pub fn name(self) -> Name {
        Name { title: self.title, front: self.front, back: self.back, epithet: self.epithet }
    }

    pub fn look(self) -> Look {
        Look { build: self.build, skin: self.skin, hair: self.hair, cloth: self.cloth }
    }

    /// Whether its name is one the lists make and each part of its look one of the choices.
    pub fn valid(self) -> bool {
        names::valid(self.name()) && self.look().valid()
    }
}

/// A peer on the island, and where it stands; and who it is, once it said (`worn`).
pub struct Body: Clone + Pack {
    pub peer: u32,
    pub x: i32,
    pub z: i32,
    pub worn: bool = false,
    pub card: Card = NOBODY,
    /// When it last acted, by the room's clock (`Entry::at`).
    pub seen: u64 = 0,
}

/// The card of a body that hasn't said who it is: an invalid name, so no real character's
/// choice of name and look can be mistaken for a guest.
pub const NOBODY: Card = Card {
    title: 4294967295,
    front: 0,
    back: 0,
    epithet: 0,
    build: 0,
    skin: 0,
    hair: 0,
    cloth: 0,
}

/// A mark a peer placed: what the island keeps.
pub struct Mark: Clone + Pack {
    pub by: u32,
    pub x: i32,
    pub z: i32,
}

/// The island in a visit: who's here (for this visit only) and its marks (kept).
pub struct Island: Clone + Pack {
    pub bodies: Vec<Body>,
    pub marks: Vec<Mark>,
    /// An unreadable store save must survive this build, including its journal's restarts.
    pub protected: bool = false,
}

/// The pass a card is worn with, as a peer sends it (when it expires and its tag: pass.wrela's
/// `Pass`), and as the room commits it: `checked` is the server's finding, and the expiry and tag
/// are taken off. A peer's own `checked` is never believed.
pub struct Seal: Copy + Eq + Pack {
    pub expires: u64,
    pub tag: Tag,
    pub checked: bool,
}

/// A seal as the server leaves it: its finding alone.
pub fn sealed(checked: bool) -> Seal {
    Seal { expires: 0, tag: NO_TAG, checked }
}

/// A peer's decision.
pub enum Act: Clone + Pack {
    /// Walk by (`dx`, `dz`).
    Step { dx: i32, dz: i32 },
    /// Place a mark where it stands.
    Place,
    /// Say who it is: its character, with its account's pass.
    Wear { card: Card, seal: Seal },
}

/// The pass of a card worn with `seal`.
pub fn pass_of(card: Card, seal: Seal) -> Pass {
    Pass {
        title: card.title,
        front: card.front,
        back: card.back,
        epithet: card.epithet,
        build: card.build,
        skin: card.skin,
        hair: card.hair,
        cloth: card.cloth,
        expires: seal.expires,
        tag: seal.tag,
    }
}

/// The card and seal a peer wears for `pass` (its account's): what `Act::Wear` carries.
pub fn worn(pass: Pass) -> (Card, Seal) {
    (
        Card::of(pass.name(), pass.look()),
        Seal { expires: pass.expires, tag: pass.tag, checked: true },
    )
}

/// A peer's message as the room is to see it: a proposal to wear a card has its seal checked
/// against `keys` at `now` (Unix milliseconds) and its pass taken off; anything else is as it
/// came, a message that isn't the protocol's included (the room refuses it).
pub fn checked_message(bytes: take Vec<u8>, keys: [[u8; 32]], now: u64) -> Vec<u8> {
    let Ok(up) = unpack::<Up<Act>>(bytes.clone()) else { return take bytes }
    match up {
        Up::Propose { peer, session, counter, value: Act::Wear { card, seal } } => {
            let ok = pass::opens(keys, pass_of(card, seal), now)
            let value = Act::Wear { card, seal: sealed(ok) }
            pack(Up::<Act>::Propose { peer, session, counter, value })
        },
        _ => take bytes,
    }
}

/// A client on the island says it's still there this often (a step of nothing), and a body that
/// hasn't acted for `AWAY_MS` is taken to have left: shown no more (`Island::present`).
pub const HERE_MS: u64 = 45000
pub const AWAY_MS: u64 = 120000

impl Island {
    pub fn empty() -> Island {
        Island { bodies: Vec::new(), marks: Vec::new() }
    }

    /// The bodies to show, by index: those that acted within `AWAY_MS` of the latest act (a
    /// player on the island says it's there at least every `HERE_MS`), and of those with the same
    /// character's name, only the one that acted last (the same account in a reloaded tab).
    pub fn present(self) -> Vec<u32> {
        var latest: u64 = 0
        for b in self.bodies {
            latest = max(latest, b.seen)
        }
        var shown: Vec<u32> = Vec::new()
        var named: Vec<u32> = Vec::new()
        for i in 0..self.bodies.len() {
            borrow b = self.bodies[i]
            if latest - b.seen > AWAY_MS {
                continue
            }
            if b.worn {
                named.push(i)
            } else {
                shown.push(u32(i))
            }
        }
        if named.is_empty() { return shown }
        // Group each name's bodies, newest first, instead of scanning the entire island for
        // every signed player. Sorting indices keeps the temporary state small.
        named.sort_by(|a: u32, b: u32| {
            borrow left = self.bodies[a]
            borrow right = self.bodies[b]
            let an = left.card.name()
            let bn = right.card.name()
            if an != bn { name_before(an, bn) } else {
                left.seen > right.seen || (left.seen == right.seen && a > b)
            }
        })
        var previous: Option<Name> = None
        for i in named {
            let name = self.bodies[i].card.name()
            if previous != Some(name) {
                shown.push(i)
                previous = Some(name)
            }
        }
        // Drawing order is still the bodies' original order, including unnamed guests.
        shown.sort_by(|a: u32, b: u32| a < b)
        shown
    }

    fn body_at(self, peer: u32) -> Option<u32> {
        for i in 0..self.bodies.len() {
            if self.bodies[i].peer == peer {
                return Some(i)
            }
        }
        None
    }
}

fn name_before(a: Name, b: Name) -> bool {
    a.title < b.title ||
        (a.title == b.title &&
            (a.front < b.front ||
                (a.front == b.front &&
                    (a.back < b.back || (a.back == b.back && a.epithet < b.epithet)))))
}

impl Reduce<Act> for Island {
    fn check(self, entry: Entry<Act>) -> Verdict {
        match entry.value {
            Act::Step { dx, dz } => {
                if dx < -MAX_STEP || dx > MAX_STEP || dz < -MAX_STEP || dz > MAX_STEP {
                    return Verdict::Reject(TOO_FAR)
                }
                var x = 0
                var z = 0
                if let Some(i) = self.body_at(entry.id.peer) {
                    x = self.bodies[i].x
                    z = self.bodies[i].z
                }
                let (nx, nz) = (x + dx, z + dz)
                if nx < -MAX_REACH || nx > MAX_REACH || nz < -MAX_REACH || nz > MAX_REACH {
                    Verdict::Reject(OFF_ISLAND)
                } else {
                    Verdict::Accept
                }
            },
            Act::Place => if self.marks.len() >= MAX_MARKS { Verdict::Reject(FULL) } else {
                Verdict::Accept
            },
            Act::Wear { card, seal } => if !card.valid() {
                Verdict::Reject(NO_SUCH_CARD)
            } else if !seal.checked {
                Verdict::Reject(NOT_SIGNED)
            } else {
                Verdict::Accept
            },
        }
    }

    fn apply(mut self, entry: Entry<Act>) {
        let peer = entry.id.peer
        var i = self.bodies.len()
        if let Some(k) = self.body_at(peer) {
            i = k
        } else if self.bodies.len() < MAX_BODIES {
            self.bodies.push(Body { peer, x: 0, z: 0 })
        } else {
            // Full: the body that acted longest ago (the first such) gives its place.
            var oldest = 0
            for k in 1..self.bodies.len() {
                if self.bodies[k].seen < self.bodies[oldest].seen {
                    oldest = k
                }
            }
            self.bodies[oldest] = Body { peer, x: 0, z: 0 }
            i = oldest
        }
        self.bodies[i].seen = entry.at
        match entry.value {
            Act::Step { dx, dz } => {
                self.bodies[i].x += dx
                self.bodies[i].z += dz
            },
            Act::Place => {
                let x = self.bodies[i].x
                let z = self.bodies[i].z
                self.marks.push(Mark { by: peer, x, z })
            },
            Act::Wear { card, .. } => {
                self.bodies[i].worn = true
                self.bodies[i].card = card
            },
        }
    }
}

/// What the store keeps of an island: its marks.
pub struct Save: Clone + Pack {
    pub marks: Vec<Mark>,
}

/// The island's save: `SAVE_VERSION`, then its marks packed.
pub fn save_bytes(island: Island) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    out.push(SAVE_VERSION)
    for b in pack(Save { marks: island.marks.clone() }) {
        out.push(b)
    }
    out
}

/// The island a save holds, with no one on it: empty for no save, and `None` for a save this
/// build can't read (another version, or malformed), which it must not write over.
pub fn load(bytes: Option<Vec<u8>>) -> Option<Island> {
    let Some(b) = bytes else { return Some(Island::empty()) }
    if b.len() == 0 || b[0] != SAVE_VERSION {
        return None
    }
    var rest: Vec<u8> = Vec::with_capacity(b.len() - 1)
    for i in 1..b.len() {
        rest.push(b[i])
    }
    match unpack::<Save>(take rest) {
        Ok(s) => {
            // A well-formed encoding can still violate this build's state bounds. Treat it as
            // unreadable too, so neither an oversized snapshot nor a corrupt position goes live.
            if s.marks.len() > MAX_MARKS { return None }
            for m in s.marks {
                if m.x < -MAX_REACH || m.x > MAX_REACH || m.z < -MAX_REACH || m.z > MAX_REACH {
                    return None
                }
            }
            Some(Island { bodies: Vec::new(), marks: s.marks.clone() })
        },
        Err(_) => None,
    }
}

/// The island's key in the store: `island/` and the room's name.
pub fn key_of(name: str) -> Vec<u8> {
    var k: Vec<u8> = Vec::new()
    let prefix = "island/"
    for i in 0..prefix.len() {
        k.push(prefix.byte(i))
    }
    for i in 0..name.len() {
        k.push(name.byte(i))
    }
    k
}

// ---- the server ---------------------------------------------------------------------------------

/// An event held while the island's save is read.
enum Held: Clone {
    Opened { conn: u32, tag: u32 },
    Closed { conn: u32 },
    Message { conn: u32, bytes: Vec<u8> },
}

fn held_size(h: Held) -> u32 {
    match h {
        Held::Message { bytes, .. } => bytes.len(),
        _ => 0,
    }
}

/// Not started: no journal read back, no save asked for.
const FRESH: u32 = 0
/// The save is asked for; events wait.
const LOADING: u32 = 1
/// The log is running.
const LIVE: u32 = 2

/// The island's server: its room, and where it is in starting.
pub struct Server {
    phase: u32,
    /// The save's read, while `LOADING` (one at most).
    asked: Vec<Pending<u8>>,
    held: Vec<Held>,
    held_bytes: u32,
    room: Room<Island, Act>,
    /// How many marks the store's save holds.
    saved: u32,
    /// Failed reads of the save in a row.
    tries: u32,
    /// Whether the keys were read (`keys`, those long enough: none, and no pass checks).
    keyed: bool,
    keys: Vec<[u8; 32]>,
    /// The Unix milliseconds at the room's time 0, as the wall clock said when the keys came.
    epoch: u64,
}

impl Server {
    pub fn new() -> Server {
        Server {
            phase: FRESH,
            asked: Vec::new(),
            held: Vec::new(),
            held_bytes: 0,
            room: Room::new(Island::empty()),
            saved: 0,
            tries: 0,
            keyed: false,
            keys: Vec::new(),
            epoch: 0,
        }
    }

    /// The island's state, its log applied.
    pub fn island(self) -> borrow Island {
        self.room.state()
    }

    /// Reads the pass keys (`pass::SECRETS`) and the wall clock, once, in the call that asks
    /// (the host answers both at once): a secret that isn't there, or is too short, makes no
    /// key, and a clock that didn't answer leaves every pass expired.
    fn read_keys(mut self, at: u64) {
        if self.keyed {
            return
        }
        self.keyed = true
        for name in pass::SECRETS {
            if let Some(bytes) = secret(name) {
                if let Some(k) = pass::key_of(bytes) {
                    self.keys.push(k)
                }
            }
        }
        if let Some(ms) = unix_now() {
            self.epoch = if ms > at { ms - at } else { 0 }
        }
    }

    /// An event: taken by the room once it's live, held before.
    fn arrive(mut self, h: take Held, at: u64) {
        if self.phase == FRESH {
            self.phase = LOADING
            self.asked.push(store::get(key_of(room().as_str())))
        }
        if self.phase == LOADING {
            if let Some(conn) = self.hold(take h) {
                close(conn)
            }
        } else {
            self.feed(take h, at)
        }
    }

    /// Queues an event until the save answers, or names the connection to close. The peer can
    /// retry its unacknowledged proposals after reconnecting; a full queue drops no accepted work.
    fn hold(mut self, h: take Held) -> Option<u32> {
        let bytes = held_size(h)
        if self.held.len() >= MAX_HELD || bytes > MAX_HELD_BYTES - self.held_bytes {
            match h {
                Held::Closed { conn } => self.close_held(conn),
                Held::Opened { conn, .. } => return Some(conn),
                Held::Message { conn, .. } => if conn < POISONED { return Some(conn) },
            }
            return None
        }
        self.held_bytes += bytes
        self.held.push(take h)
        None
    }

    fn close_held(mut self, conn: u32) {
        self.held.retain(|h: Held| match h {
            Held::Opened { conn: other, .. } => other != conn,
            Held::Closed { conn: other } => other != conn,
            Held::Message { conn: other, .. } => other != conn,
        })
        self.held_bytes = 0
        for h in self.held { self.held_bytes += held_size(h) }
    }

    fn take_held(mut self) -> Vec<Held> {
        self.held_bytes = 0
        replace(mut self.held, Vec::new())
    }

    fn feed(mut self, h: take Held, at: u64) {
        match take h {
            Held::Opened { conn, tag } => self.room.opened(conn, tag),
            Held::Closed { conn } => self.room.closed(conn),
            Held::Message { conn, bytes } => {
                if conn >= POISONED {
                    carry_out(self.room.poisoned(conn - POISONED, take bytes))
                } else {
                    // Journal replay calls `serve(0)`, even for an old room. Only a live
                    // message has the room's actual age to calibrate the Unix epoch against.
                    self.read_keys(at)
                    let seen = checked_message(take bytes, self.keys, self.epoch + at)
                    carry_out(self.room.receive(conn, take seen, at))
                }
            },
        }
    }

    /// The save's answer, if it came: the log starts from the island it holds, kept as the
    /// journal's first record, and the held events go to the room. A failed read asks again, at
    /// most `MAX_TRIES` times in a row; then the held peers are let go, to come back later.
    fn loaded(mut self, at: u64) {
        if self.phase != LOADING {
            return
        }
        let Some(answer) = self.asked[0].poll() else { return }
        self.asked.clear()
        let Ok(bytes) = answer else {
            self.tries += 1
            if self.tries < MAX_TRIES {
                self.asked.push(store::get(key_of(room().as_str())))
                return
            }
            self.tries = 0
            self.phase = FRESH
            let held = self.take_held()
            for h in held {
                match h {
                    Held::Opened { conn, .. } => close(conn),
                    _ => {},
                }
            }
            return
        }
        self.tries = 0
        let start = self.begin(load(store::value(bytes)))
        compact(pack(start))
        let held = self.take_held()
        for h in held {
            self.feed(h.clone(), at)
        }
    }

    /// Starts a build's journal from its stored save, without overwriting an unreadable save.
    fn begin(mut self, loaded: take Option<Island>) -> Record<Island, Act> {
        var island = Island::empty()
        match take loaded {
            Some(i) => island = take i,
            None => island.protected = true,
        }
        self.saved = island.marks.len()
        // Entry 1 is the save: a peer with less of the log is sent the state.
        let start: Record<Island, Act> = Record::Snapshot {
            seq: 1,
            state: island,
            peers: Vec::new(),
            next_peer: 1,
        }
        var fresh = Room::new(Island::empty())
        fresh.restore(start.clone())
        self.room = take fresh
        self.phase = LIVE
        start
    }

    fn restore(mut self, record: Record<Island, Act>) {
        self.phase = LIVE
        self.room.restore(record)
        self.saved = self.room.state().marks.len()
    }

    fn may_write(self) -> bool {
        !self.room.state().protected
    }

    /// The save put again once the marks changed: an outcome, so it's written with the call's
    /// records.
    fn checkpoint(mut self) {
        let n = self.room.state().marks.len()
        if n != self.saved && self.may_write() {
            store::put(key_of(room().as_str()), save_bytes(self.room.state()))
            self.saved = n
        }
    }
}

pub fn serve_init() -> Server {
    Server::new()
}

pub fn serve(s: mut Server, time: f32) {
    let at = u64(time * 1000.0)
    s.loaded(at)
    for e in events() {
        match e {
            Event::Message { conn, .. } => {
                let Some(bytes) = payload(e) else { continue }
                if conn == JOURNAL {
                    // The room started again on this build: its journal is the island.
                    // Its marks were saved as they were placed.
                    match unpack::<Record<Island, Act>>(take bytes) {
                        Ok(r) => s.restore(r),
                        Err(_) => panic("a journal record this program can't read"),
                    }
                } else {
                    s.arrive(Held::Message { conn, bytes }, at)
                }
            },
            Event::Connection { conn, open, tag } => {
                if open {
                    s.arrive(Held::Opened { conn, tag }, at)
                } else {
                    s.arrive(Held::Closed { conn }, at)
                }
            },
            _ => {},
        }
    }
    if s.phase == LIVE {
        s.checkpoint()
        if s.room.since_snapshot() > COMPACT_AFTER {
            compact(pack(s.room.compact()))
        }
    }
}

// ---- tests --------------------------------------------------------------------------------------

@test
fn a_save_reads_back_as_the_same_marks() {
    var island = Island::empty()
    island.marks.push(Mark { by: 1, x: 3, z: -4 })
    island.marks.push(Mark { by: 2, x: 0, z: 9 })
    island.bodies.push(Body { peer: 1, x: 3, z: -4 })
    let Some(back) = load(Some(save_bytes(island))) else { panic("its own save is readable") }
    assert(back.marks.len() == 2 && back.marks[0].z == -4 && back.marks[1].by == 2)
    assert(back.bodies.len() == 0, "who was here isn't kept")
}

@test
fn no_save_starts_empty_and_an_unreadable_one_is_kept_apart() {
    let Some(none) = load(None) else { panic("no save is an empty island") }
    assert(none.marks.len() == 0)
    assert(load(Some(Vec::from([9, 1, 2]))).is_none(), "another version isn't read")
    assert(load(Some(Vec::from([SAVE_VERSION, 255, 255, 255]))).is_none(), "nor a malformed one")
}

@test
fn an_island_save_must_keep_its_state_within_the_islands_limits() {
    var too_many = Island::empty()
    for i in 0..MAX_MARKS + 1 {
        too_many.marks.push(Mark { by: i, x: 0, z: 0 })
    }
    assert(load(Some(save_bytes(too_many))).is_none(), "an oversized save is unreadable")
    for outside in [-MAX_REACH - 1, MAX_REACH + 1] {
        for x in [false, true] {
            var far = Island::empty()
            far.marks.push(Mark {
                by: 1,
                x: if x { outside } else { 0 },
                z: if x { 0 } else { outside },
            })
            var server = Server::new()
            let _ = server.begin(load(Some(save_bytes(far))))
            assert(!server.may_write(), "an out-of-bounds save must not be silently overwritten")
        }
    }
    var edge = Island::empty()
    for i in 0..MAX_MARKS {
        edge.marks.push(Mark { by: i, x: -MAX_REACH, z: MAX_REACH })
    }
    assert(load(Some(save_bytes(edge))).is_some(), "a valid full save still loads")
}

@test
fn a_step_off_the_island_is_refused() {
    var island = Island::empty()
    island.bodies.push(Body { peer: 1, x: MAX_REACH - 2, z: 0 })
    let near = Entry {
        seq: 2,
        id: ProposalId { peer: 1, session: 1, counter: 1 },
        at: 0,
        value: Act::Step { dx: 2, dz: 0 },
    }
    let far = Entry {
        seq: 2,
        id: ProposalId { peer: 1, session: 1, counter: 1 },
        at: 0,
        value: Act::Step { dx: 3, dz: 0 },
    }
    assert(island.check(near) == Verdict::Accept)
    assert(island.check(far) == Verdict::Reject(OFF_ISLAND))
}

@test
fn a_body_wears_only_a_card_the_lists_and_choices_make() {
    var island = Island::empty()
    let wear = |card: Card| -> Entry<Act> {
        Entry {
            seq: 2,
            id: ProposalId { peer: 4, session: 1, counter: 1 },
            at: 0,
            value: Act::Wear { card, seal: sealed(true) },
        }
    }
    let good = Card::of(
        Name { title: 1, front: 2, back: 3, epithet: 4 },
        Look {
            build: 1,
            skin: 2,
            hair: 3,
            cloth: 7,
        },
    )
    var bad_name = good
    bad_name.epithet = u32(names::EPITHETS.len())
    var bad_look = good
    bad_look.cloth = platform::wire::LOOK_CHOICES
    assert(island.check(wear(bad_name)) == Verdict::Reject(NO_SUCH_CARD), "a name past the lists")
    assert(island.check(wear(bad_look)) == Verdict::Reject(NO_SUCH_CARD), "a look past the choices")
    assert(island.check(wear(good)) == Verdict::Accept)
    let unsigned = Entry {
        seq: 2,
        id: ProposalId { peer: 4, session: 1, counter: 1 },
        at: 0,
        value: Act::Wear { card: good, seal: sealed(false) },
    }
    assert(island.check(unsigned) == Verdict::Reject(NOT_SIGNED), "a card its account didn't sign")
    island.apply(wear(good))
    assert(island.bodies.len() == 1 && island.bodies[0].worn && island.bodies[0].card == good)
    assert(names::text(island.bodies[0].card.name()).len() > 0)
}

/// A peer's proposal to wear `card` with `seal`, as its bytes cross the network.
fn wear_bytes(card: Card, seal: Seal) -> Vec<u8> {
    pack(Up::<Act>::Propose { peer: 3, session: 1, counter: 2, value: Act::Wear { card, seal } })
}

/// What the room is given for a peer's message: its wear's seal.
fn seal_seen(bytes: take Vec<u8>) -> Seal {
    let Ok(
        Up::Propose { peer: 3, session: 1, counter: 2, value: Act::Wear { seal, .. } },
    ) = unpack::<Up<Act>>(take bytes) else { panic("still the proposal it was") }
    seal
}

@test
fn the_server_believes_only_a_pass_the_account_signed() {
    var secret: Vec<u8> = Vec::new()
    for i in 0..40 {
        secret.push(u8(i))
    }
    let Some(key) = pass::key_of(secret) else { panic("a key") }
    let name = Name { title: 1, front: 2, back: 3, epithet: 4 }
    let look = Look { build: 1, skin: 2, hair: 3, cloth: 4 }
    let now: u64 = 1_800_000_000_000
    let (card, seal) = worn(pass::sign(key, name, look, now + 1000))
    let seen = seal_seen(checked_message(wear_bytes(card, seal), [key], now))
    assert(seen == sealed(true), "the account's pass: checked, and its tag taken off")
    var other = card
    other.cloth = 5
    let forged = seal_seen(checked_message(wear_bytes(other, seal), [key], now))
    assert(forged == sealed(false), "the pass on another card isn't believed")
    let no_keys: [[u8; 32]; 0] = []
    let keyless = seal_seen(checked_message(wear_bytes(card, seal), no_keys, now))
    assert(!keyless.checked, "without the keys, nothing is")
    let late = seal_seen(checked_message(wear_bytes(card, seal), [key], now + 1000))
    assert(!late.checked, "nor an expired pass")
    let step = pack(
        Up::<Act>::Propose { peer: 3, session: 1, counter: 2, value: Act::Step { dx: 1, dz: 0 } },
    )
    assert(checked_message(step.clone(), [key], now) == step, "a step goes as it came")
    let junk = Vec::from([1, 2, 3])
    assert(
        checked_message(junk.clone(), [key], now) == junk,
        "and bytes that aren't the protocol's",
    )
}

@test
fn the_first_name_with_the_default_look_is_a_character() {
    let Some(key) = pass::key_of([u8(7); 32]) else { panic("a key") }
    let name = Name { title: 0, front: 0, back: 0, epithet: 0 }
    let look = Look { build: 0, skin: 0, hair: 0, cloth: 0 }
    let now: u64 = 1_800_000_000_000
    let (card, seal) = worn(pass::sign(key, name, look, now + 1000))
    assert(card.valid() && card != NOBODY, "every choice may be the first one")
    let seen = seal_seen(checked_message(wear_bytes(card, seal), [key], now))
    assert(seen == sealed(true), "the room believes its account's pass")
    var island = Island::empty()
    let wear = Entry {
        seq: 2,
        id: ProposalId { peer: 3, session: 1, counter: 2 },
        at: 0,
        value: Act::Wear { card, seal: seen },
    }
    assert(island.check(wear.clone()) == Verdict::Accept)
    island.apply(wear)
    assert(island.bodies[0].worn && island.bodies[0].card == card)
}

@test
fn a_full_island_fits_one_message() {
    var island = Island::empty()
    let card = Card::of(
        Name { title: 47, front: 63, back: 47, epithet: 127 },
        Look {
            build: 7,
            skin: 7,
            hair: 7,
            cloth: 7,
        },
    )
    for i in 0..MAX_BODIES {
        island.bodies.push(
            Body {
                peer: 4000000000 + i,
                x: -MAX_REACH,
                z: MAX_REACH,
                worn: true,
                card,
                seen: 1 << 50,
            },
        )
    }
    for i in 0..MAX_MARKS {
        island.marks.push(Mark { by: 4000000000 + i, x: -MAX_REACH, z: MAX_REACH })
    }
    let size = pack(island.clone()).len()
    assert(size < 60000, f"{size} bytes")
    // A newcomer takes the place of the body that acted longest ago.
    for i in 0..MAX_BODIES {
        island.bodies[i].seen = 1000 + u64(i)
    }
    island.bodies[7].seen = 5
    let newcomer = Entry {
        seq: 2,
        id: ProposalId { peer: 9, session: 1, counter: 1 },
        at: 9000,
        value: Act::Step { dx: 1, dz: 0 },
    }
    assert(island.check(newcomer) == Verdict::Accept)
    island.apply(newcomer)
    assert(island.bodies.len() == MAX_BODIES, "still full")
    let b = island.bodies[7].clone()
    assert(b.peer == 9 && b.x == 1 && !b.worn && b.seen == 9000, "in the stalest's place")
}

@test
fn the_key_is_the_rooms_name_under_island() {
    let k = key_of("island-a")
    assert(k.len() == 15 && k[0] == 105 && k[6] == 47 && k[14] == 97)
}

@test
fn a_body_long_quiet_or_worn_again_elsewhere_is_not_shown() {
    let card = Card::of(
        Name { title: 1, front: 2, back: 3, epithet: 4 },
        Look {
            build: 1,
            skin: 2,
            hair: 3,
            cloth: 4,
        },
    )
    var island = Island::empty()
    // 0: a guest, here; 1: gone quiet past `AWAY_MS`; 2 and 3: one account, reloaded as 3.
    island.bodies.push(Body { peer: 1, x: 0, z: 0, seen: 200000 })
    island.bodies.push(Body { peer: 2, x: 0, z: 0, seen: 200000 - AWAY_MS - 1 })
    island.bodies.push(Body { peer: 3, x: 0, z: 0, worn: true, card, seen: 150000 })
    island.bodies.push(Body { peer: 4, x: 0, z: 0, worn: true, card, seen: 190000 })
    let shown = island.present()
    assert(shown.len() == 2 && shown[0] == 0 && shown[1] == 3, f"{shown.len()} shown")
}

@test
fn a_changed_look_does_not_leave_another_body_for_the_same_account() {
    let card = Card::of(
        Name { title: 1, front: 2, back: 3, epithet: 4 },
        Look { build: 1, skin: 2, hair: 3, cloth: 4 },
    )
    var changed = card
    changed.cloth = 5
    var island = Island::empty()
    island.bodies.push(Body { peer: 1, x: 0, z: 0, worn: true, card, seen: 1000 })
    island.bodies.push(Body { peer: 2, x: 0, z: 0, worn: true, card: changed, seen: 2000 })
    let shown = island.present()
    assert(shown.len() == 1 && shown[0] == 1, "the account's newest body alone is shown")
}

@test
fn present_keeps_original_order_and_the_newest_body_among_many_names() {
    var island = Island::empty()
    for i in 0..128 {
        let card = Card::of(
            Name { title: i % 48, front: i / 48, back: i % 47, epithet: i % 127 },
            Look { build: 1, skin: 1, hair: 1, cloth: 1 },
        )
        island.bodies.push(Body { peer: i * 3 + 1, x: 0, z: 0, seen: 200000 })
        island.bodies.push(Body {
            peer: i * 3 + 2,
            x: 0,
            z: 0,
            seen: 200001,
            worn: true,
            card,
        })
        var changed = card
        changed.cloth = 2
        island.bodies.push(Body {
            peer: i * 3 + 3,
            x: 0,
            z: 0,
            seen: if i % 2 == 0 { 200001 } else { 200000 },
            worn: true,
            card: changed,
        })
    }
    island.bodies.push(Body { peer: 900, x: 0, z: 0, seen: 1 })
    let shown = island.present()
    assert(shown.len() == 256)
    for i in 0..128 {
        assert(shown[i * 2] == i * 3, "guests keep their place")
        assert(shown[i * 2 + 1] == i * 3 + (if i % 2 == 0 { 2 } else {
            1
        }), "time wins, then the later body breaks a tie")
    }
}

@test
fn present_does_not_expire_recent_bodies_when_the_room_clock_is_near_its_limit() {
    let latest: u64 = 18446744073709551610
    var island = Island::empty()
    island.bodies.push(Body { peer: 1, x: 0, z: 0, seen: latest })
    island.bodies.push(Body { peer: 2, x: 0, z: 0, seen: latest - AWAY_MS })
    island.bodies.push(Body { peer: 3, x: 0, z: 0, seen: latest - AWAY_MS - 1 })
    let shown = island.present()
    assert(shown == Vec::from([u32(0), 1]), "only elapsed time determines whether a body left")
}

@test
fn an_unreadable_save_stays_protected_after_a_journal_restart() {
    var first = Server::new()
    let start = first.begin(None)
    assert(!first.may_write())
    let Ok(back) = unpack::<Record<Island, Act>>(pack(start)) else { panic("its own journal") }
    var restarted = Server::new()
    restarted.restore(back)
    assert(!restarted.may_write(), "a restart must not let a mark overwrite the unreadable save")
}

@test
fn closing_connections_cannot_grow_a_full_loading_queue() {
    var server = Server::new()
    server.phase = LOADING
    server.held.push(Held::Opened { conn: 1, tag: 0 })
    server.held.push(Held::Message { conn: 1, bytes: Vec::from([1, 2, 3]) })
    for conn in 2..MAX_HELD {
        server.held.push(Held::Opened { conn, tag: 0 })
    }
    assert(server.held.len() == MAX_HELD)
    server.close_held(MAX_HELD + 1)
    assert(server.held.len() == MAX_HELD, "a refused connection's close needs no queue entry")
    server.close_held(1)
    assert(server.held.len() == MAX_HELD - 2, "the closed connection's unprocessed events go")
    match server.held[0] {
        Held::Opened { conn: 2, .. } => {},
        _ => panic("the other connections keep their order"),
    }
}

@test
fn pending_save_payloads_are_bounded_and_release_their_budget() {
    var server = Server::new()
    // The pinned room host takes at most 64 KiB minus its 64-byte protocol allowance.
    let message: u32 = 65472
    let count = MAX_HELD_BYTES / message
    for conn in 1..count + 1 {
        assert(server.hold(Held::Message { conn, bytes: Vec::filled(message, u8(1)) }).is_none())
    }
    assert(
        server
            .hold(
                Held::Message {
                    conn: 89,
                    bytes: Vec::filled(MAX_HELD_BYTES - count * message, u8(1)),
                },
            )
            .is_none(),
        "a final partial payload may use the exact budget",
    )
    assert(server.held_bytes == MAX_HELD_BYTES)
    assert(
        server.hold(Held::Message { conn: 90, bytes: Vec::from([u8(1)]) }) == Some(90),
        "payload bytes, not just event count, bound the queue",
    )
    assert(server.held.len() == count + 1 && server.held_bytes == MAX_HELD_BYTES)
    server.close_held(1)
    assert(server.held_bytes == MAX_HELD_BYTES - message, "closing releases only its bytes")
    assert(
        server.hold(Held::Message {
            conn: 91,
            bytes: Vec::filled(message, u8(2)),
        }).is_none(),
        "another peer can use the released budget",
    )
    let held = server.take_held()
    assert(
        held.len() == count + 1 && server.held.is_empty() && server.held_bytes == 0,
        "draining for success or failure releases the complete budget",
    )
}
