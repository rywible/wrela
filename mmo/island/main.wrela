// An island a party shares: a room (`std::net`) named `island-<id>`, whose peers walk and place
// marks. What the party does in a visit is the room's log; what the island keeps between visits,
// its marks, is the store's, under `island/<room>`, in a versioned save that outlives a build. A
// room's journal is its build's alone, so after a deploy the new build's room starts with an empty
// journal: it reads the save first, holding its peers' events until the store answers, then
// starts its log from the save.
//
// What crosses the network is decisions (`Act`), and what's written is outcomes: the save is put
// only when a mark is placed, never for a step.

use platform::names
use platform::names::Name
use platform::wire::Look
use std::input::{Event, events, payload}
use std::io::Pending
use std::net::{COMPACT_AFTER, Entry, JOURNAL, POISONED, ProposalId, Record, Reduce, Room, Verdict}
use std::net::{carry_out, close, compact, room}
use std::pack::{Pack, pack, unpack}
use std::store

/// The save's format: its first byte. A save of another version is read by a migration, or the
/// island starts empty.
pub const SAVE_VERSION: u8 = 1
/// The most marks an island holds.
pub const MAX_MARKS: u32 = 256
/// The longest step a peer takes in one decision, each way.
pub const MAX_STEP: i32 = 24

// Why the island refuses a decision.
/// A step longer than `MAX_STEP`.
pub const TOO_FAR: u32 = 1
/// A mark past `MAX_MARKS`.
pub const FULL: u32 = 2
/// A step past `MAX_REACH` from the island's middle.
pub const OFF_ISLAND: u32 = 3
/// The most bodies an island holds in a visit: with its marks, its state stays well inside one
/// message (64 KiB), which a peer far behind is sent. A newcomer past it takes the place of the
/// body that acted longest ago (one whose peer has most likely left), so no crowd of peers that
/// came and went, nor one that keeps coming, shuts anyone out.
pub const MAX_BODIES: u32 = 512
/// A card whose name the lists don't make, or whose look isn't one of the choices.
pub const NO_SUCH_CARD: u32 = 4
/// How far from the middle a peer may stand, each way: a position never overflows.
pub const MAX_REACH: i32 = 1000000
/// The most events held while the save is read; a connection past it is closed, to come back.
pub const MAX_HELD: u32 = 1024
/// Failed reads of the save in a row before the held peers are let go.
pub const MAX_TRIES: u32 = 3

/// Who a body is: its character's name, by its four numbers into the name lists (so it says
/// nothing anyone typed: platform/names.wrela), and how it looks, a choice of each part
/// (platform/wire.wrela's `Look`). Nothing yet checks it against an account: a pass from the
/// account will.
pub struct Card: Copy + Eq + Pack {
    pub title: u32,
    pub front: u32,
    pub back: u32,
    pub epithet: u32,
    pub build: u32,
    pub skin: u32,
    pub hair: u32,
    pub cloth: u32,
}

impl Card {
    /// The card of a character whose name is `name` and whose look is `look`.
    pub fn of(name: Name, look: Look) -> Card {
        Card {
            title: name.title,
            front: name.front,
            back: name.back,
            epithet: name.epithet,
            build: look.build,
            skin: look.skin,
            hair: look.hair,
            cloth: look.cloth,
        }
    }

    pub fn name(self) -> Name {
        Name { title: self.title, front: self.front, back: self.back, epithet: self.epithet }
    }

    pub fn look(self) -> Look {
        Look { build: self.build, skin: self.skin, hair: self.hair, cloth: self.cloth }
    }

    /// Whether its name is one the lists make and each part of its look one of the choices.
    pub fn valid(self) -> bool {
        names::valid(self.name()) && self.look().valid()
    }
}

/// A peer on the island, and where it stands; and who it is, once it said (`worn`).
pub struct Body: Clone + Pack {
    pub peer: u32,
    pub x: i32,
    pub z: i32,
    pub worn: bool = false,
    pub card: Card = NOBODY,
    /// When it last acted, by the room's clock (`Entry::at`).
    pub seen: u64 = 0,
}

/// The card of a body that hasn't said who it is.
pub const NOBODY: Card = Card {
    title: 0,
    front: 0,
    back: 0,
    epithet: 0,
    build: 0,
    skin: 0,
    hair: 0,
    cloth: 0,
}

/// A mark a peer placed: what the island keeps.
pub struct Mark: Clone + Pack {
    pub by: u32,
    pub x: i32,
    pub z: i32,
}

/// The island in a visit: who's here (for this visit only) and its marks (kept).
pub struct Island: Clone + Pack {
    pub bodies: Vec<Body>,
    pub marks: Vec<Mark>,
}

/// A peer's decision.
pub enum Act: Clone + Pack {
    /// Walk by (`dx`, `dz`).
    Step { dx: i32, dz: i32 },
    /// Place a mark where it stands.
    Place,
    /// Say who it is: its character.
    Wear { card: Card },
}

/// A client on the island says it's still there this often (a step of nothing), and a body that
/// hasn't acted for `AWAY_MS` is taken to have left: shown no more (`Island::present`).
pub const HERE_MS: u64 = 45000
pub const AWAY_MS: u64 = 120000

impl Island {
    pub fn empty() -> Island {
        Island { bodies: Vec::new(), marks: Vec::new() }
    }

    /// The bodies to show, by index: those that acted within `AWAY_MS` of the latest act (a
    /// player on the island says it's there at least every `HERE_MS`), and of those wearing one
    /// card, only the one that acted last (the same account in a reloaded tab).
    pub fn present(self) -> Vec<u32> {
        var latest: u64 = 0
        for b in self.bodies {
            latest = max(latest, b.seen)
        }
        var shown: Vec<u32> = Vec::new()
        for i in 0..self.bodies.len() {
            borrow b = self.bodies[i]
            if b.seen + AWAY_MS < latest {
                continue
            }
            var newer = false
            for k in 0..self.bodies.len() {
                borrow o = self.bodies[k]
                if k != i &&
                    b.worn &&
                    o.worn &&
                    o.card == b.card &&
                    (o.seen > b.seen || (o.seen == b.seen && k > i)) {
                    newer = true
                }
            }
            if !newer {
                shown.push(u32(i))
            }
        }
        shown
    }

    fn body_at(self, peer: u32) -> Option<u32> {
        for i in 0..self.bodies.len() {
            if self.bodies[i].peer == peer {
                return Some(i)
            }
        }
        None
    }
}

impl Reduce<Act> for Island {
    fn check(self, entry: Entry<Act>) -> Verdict {
        match entry.value {
            Act::Step { dx, dz } => {
                if dx < -MAX_STEP || dx > MAX_STEP || dz < -MAX_STEP || dz > MAX_STEP {
                    return Verdict::Reject(TOO_FAR)
                }
                var x = 0
                var z = 0
                if let Some(i) = self.body_at(entry.id.peer) {
                    x = self.bodies[i].x
                    z = self.bodies[i].z
                }
                let (nx, nz) = (x + dx, z + dz)
                if nx < -MAX_REACH || nx > MAX_REACH || nz < -MAX_REACH || nz > MAX_REACH {
                    Verdict::Reject(OFF_ISLAND)
                } else {
                    Verdict::Accept
                }
            },
            Act::Place => if self.marks.len() >= MAX_MARKS { Verdict::Reject(FULL) } else {
                Verdict::Accept
            },
            Act::Wear { card } => if card.valid() { Verdict::Accept } else {
                Verdict::Reject(NO_SUCH_CARD)
            },
        }
    }

    fn apply(mut self, entry: Entry<Act>) {
        let peer = entry.id.peer
        var i = self.bodies.len()
        if let Some(k) = self.body_at(peer) {
            i = k
        } else if self.bodies.len() < MAX_BODIES {
            self.bodies.push(Body { peer, x: 0, z: 0 })
        } else {
            // Full: the body that acted longest ago (the first such) gives its place.
            var oldest = 0
            for k in 1..self.bodies.len() {
                if self.bodies[k].seen < self.bodies[oldest].seen {
                    oldest = k
                }
            }
            self.bodies[oldest] = Body { peer, x: 0, z: 0 }
            i = oldest
        }
        self.bodies[i].seen = entry.at
        match entry.value {
            Act::Step { dx, dz } => {
                self.bodies[i].x += dx
                self.bodies[i].z += dz
            },
            Act::Place => {
                let x = self.bodies[i].x
                let z = self.bodies[i].z
                self.marks.push(Mark { by: peer, x, z })
            },
            Act::Wear { card } => {
                self.bodies[i].worn = true
                self.bodies[i].card = card
            },
        }
    }
}

/// What the store keeps of an island: its marks.
pub struct Save: Clone + Pack {
    pub marks: Vec<Mark>,
}

/// The island's save: `SAVE_VERSION`, then its marks packed.
pub fn save_bytes(island: Island) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    out.push(SAVE_VERSION)
    for b in pack(Save { marks: island.marks.clone() }) {
        out.push(b)
    }
    out
}

/// The island a save holds, with no one on it: empty for no save, and `None` for a save this
/// build can't read (another version, or malformed), which it must not write over.
pub fn load(bytes: Option<Vec<u8>>) -> Option<Island> {
    let Some(b) = bytes else { return Some(Island::empty()) }
    if b.len() == 0 || b[0] != SAVE_VERSION {
        return None
    }
    var rest: Vec<u8> = Vec::with_capacity(b.len() - 1)
    for i in 1..b.len() {
        rest.push(b[i])
    }
    match unpack::<Save>(take rest) {
        Ok(s) => Some(Island { bodies: Vec::new(), marks: s.marks.clone() }),
        Err(_) => None,
    }
}

/// The island's key in the store: `island/` and the room's name.
pub fn key_of(name: str) -> Vec<u8> {
    var k: Vec<u8> = Vec::new()
    let prefix = "island/"
    for i in 0..prefix.len() {
        k.push(prefix.byte(i))
    }
    for i in 0..name.len() {
        k.push(name.byte(i))
    }
    k
}

// ---- the server ---------------------------------------------------------------------------------

/// An event held while the island's save is read.
enum Held: Clone {
    Opened { conn: u32, tag: u32 },
    Closed { conn: u32 },
    Message { conn: u32, bytes: Vec<u8> },
}

/// Not started: no journal read back, no save asked for.
const FRESH: u32 = 0
/// The save is asked for; events wait.
const LOADING: u32 = 1
/// The log is running.
const LIVE: u32 = 2

/// The island's server: its room, and where it is in starting.
pub struct Server {
    phase: u32,
    /// The save's read, while `LOADING` (one at most).
    asked: Vec<Pending<u8>>,
    held: Vec<Held>,
    room: Room<Island, Act>,
    /// How many marks the store's save holds.
    saved: u32,
    /// Whether the store's save is one this build can't read: then it's never written over.
    unreadable: bool,
    /// Failed reads of the save in a row.
    tries: u32,
}

impl Server {
    pub fn new() -> Server {
        Server {
            phase: FRESH,
            asked: Vec::new(),
            held: Vec::new(),
            room: Room::new(Island::empty()),
            saved: 0,
            unreadable: false,
            tries: 0,
        }
    }

    /// The island's state, its log applied.
    pub fn island(self) -> borrow Island {
        self.room.state()
    }

    /// An event: taken by the room once it's live, held before.
    fn arrive(mut self, h: take Held, at: u64) {
        if self.phase == FRESH {
            self.phase = LOADING
            self.asked.push(store::get(key_of(room().as_str())))
        }
        if self.phase == LOADING {
            if self.held.len() >= MAX_HELD {
                // Too much waits: this connection goes, and its peer comes back (what it
                // proposed is proposed again, once). Its close is held like any other.
                match h {
                    Held::Closed { .. } => self.held.push(take h),
                    Held::Opened { conn, .. } => close(conn),
                    Held::Message { conn, .. } => if conn < POISONED { close(conn) },
                }
                return
            }
            self.held.push(take h)
        } else {
            self.feed(take h, at)
        }
    }

    fn feed(mut self, h: take Held, at: u64) {
        match take h {
            Held::Opened { conn, tag } => self.room.opened(conn, tag),
            Held::Closed { conn } => self.room.closed(conn),
            Held::Message { conn, bytes } => {
                if conn >= POISONED {
                    carry_out(self.room.poisoned(conn - POISONED, take bytes))
                } else {
                    carry_out(self.room.receive(conn, take bytes, at))
                }
            },
        }
    }

    /// The save's answer, if it came: the log starts from the island it holds, kept as the
    /// journal's first record, and the held events go to the room. A failed read asks again, at
    /// most `MAX_TRIES` times in a row; then the held peers are let go, to come back later.
    fn loaded(mut self, at: u64) {
        if self.phase != LOADING {
            return
        }
        let Some(answer) = self.asked[0].poll() else { return }
        self.asked.clear()
        let Ok(bytes) = answer else {
            self.tries += 1
            if self.tries < MAX_TRIES {
                self.asked.push(store::get(key_of(room().as_str())))
                return
            }
            self.tries = 0
            self.phase = FRESH
            let held = replace(mut self.held, Vec::new())
            for h in held {
                match h {
                    Held::Opened { conn, .. } => close(conn),
                    _ => {},
                }
            }
            return
        }
        self.tries = 0
        var island = Island::empty()
        match load(store::value(bytes)) {
            Some(i) => island = take i,
            None => self.unreadable = true,
        }
        self.saved = island.marks.len()
        // Entry 1 is the save: a peer with less of the log is sent the state.
        let start: Record<Island, Act> = Record::Snapshot {
            seq: 1,
            state: island,
            peers: Vec::new(),
            next_peer: 1,
        }
        var fresh = Room::new(Island::empty())
        fresh.restore(start.clone())
        compact(pack(start))
        self.room = take fresh
        self.phase = LIVE
        let held = replace(mut self.held, Vec::new())
        for h in held {
            self.feed(h.clone(), at)
        }
    }

    /// The save put again once the marks changed: an outcome, so it's written with the call's
    /// records.
    fn checkpoint(mut self) {
        let n = self.room.state().marks.len()
        if n != self.saved && !self.unreadable {
            store::put(key_of(room().as_str()), save_bytes(self.room.state()))
            self.saved = n
        }
    }
}

pub fn serve_init() -> Server {
    Server::new()
}

pub fn serve(s: mut Server, time: f32) {
    let at = u64(time * 1000.0)
    s.loaded(at)
    for e in events() {
        match e {
            Event::Message { conn, .. } => {
                let Some(bytes) = payload(e) else { continue }
                if conn == JOURNAL {
                    // The room started again on this build: its journal is the island.
                    // Its marks were saved as they were placed.
                    s.phase = LIVE
                    match unpack::<Record<Island, Act>>(take bytes) {
                        Ok(r) => s.room.restore(r),
                        Err(_) => panic("a journal record this program can't read"),
                    }
                    s.saved = s.room.state().marks.len()
                } else {
                    s.arrive(Held::Message { conn, bytes }, at)
                }
            },
            Event::Connection { conn, open, tag } => {
                if open {
                    s.arrive(Held::Opened { conn, tag }, at)
                } else {
                    s.arrive(Held::Closed { conn }, at)
                }
            },
            _ => {},
        }
    }
    if s.phase == LIVE {
        s.checkpoint()
        if s.room.since_snapshot() > COMPACT_AFTER {
            compact(pack(s.room.compact()))
        }
    }
}

// ---- tests --------------------------------------------------------------------------------------

@test
fn a_save_reads_back_as_the_same_marks() {
    var island = Island::empty()
    island.marks.push(Mark { by: 1, x: 3, z: -4 })
    island.marks.push(Mark { by: 2, x: 0, z: 9 })
    island.bodies.push(Body { peer: 1, x: 3, z: -4 })
    let Some(back) = load(Some(save_bytes(island))) else { panic("its own save is readable") }
    assert(back.marks.len() == 2 && back.marks[0].z == -4 && back.marks[1].by == 2)
    assert(back.bodies.len() == 0, "who was here isn't kept")
}

@test
fn no_save_starts_empty_and_an_unreadable_one_is_kept_apart() {
    let Some(none) = load(None) else { panic("no save is an empty island") }
    assert(none.marks.len() == 0)
    assert(load(Some(Vec::from([9, 1, 2]))).is_none(), "another version isn't read")
    assert(load(Some(Vec::from([SAVE_VERSION, 255, 255, 255]))).is_none(), "nor a malformed one")
}

@test
fn a_step_off_the_island_is_refused() {
    var island = Island::empty()
    island.bodies.push(Body { peer: 1, x: MAX_REACH - 2, z: 0 })
    let near = Entry {
        seq: 2,
        id: ProposalId { peer: 1, session: 1, counter: 1 },
        at: 0,
        value: Act::Step { dx: 2, dz: 0 },
    }
    let far = Entry {
        seq: 2,
        id: ProposalId { peer: 1, session: 1, counter: 1 },
        at: 0,
        value: Act::Step { dx: 3, dz: 0 },
    }
    assert(island.check(near) == Verdict::Accept)
    assert(island.check(far) == Verdict::Reject(OFF_ISLAND))
}

@test
fn a_body_wears_only_a_card_the_lists_and_choices_make() {
    var island = Island::empty()
    let wear = |card: Card| -> Entry<Act> {
        Entry {
            seq: 2,
            id: ProposalId { peer: 4, session: 1, counter: 1 },
            at: 0,
            value: Act::Wear { card },
        }
    }
    let good = Card::of(
        Name { title: 1, front: 2, back: 3, epithet: 4 },
        Look {
            build: 1,
            skin: 2,
            hair: 3,
            cloth: 7,
        },
    )
    var bad_name = good
    bad_name.epithet = u32(names::EPITHETS.len())
    var bad_look = good
    bad_look.cloth = platform::wire::LOOK_CHOICES
    assert(island.check(wear(bad_name)) == Verdict::Reject(NO_SUCH_CARD), "a name past the lists")
    assert(island.check(wear(bad_look)) == Verdict::Reject(NO_SUCH_CARD), "a look past the choices")
    assert(island.check(wear(good)) == Verdict::Accept)
    island.apply(wear(good))
    assert(island.bodies.len() == 1 && island.bodies[0].worn && island.bodies[0].card == good)
    assert(names::text(island.bodies[0].card.name()).len() > 0)
}

@test
fn a_full_island_fits_one_message() {
    var island = Island::empty()
    let card = Card::of(
        Name { title: 47, front: 63, back: 47, epithet: 127 },
        Look {
            build: 7,
            skin: 7,
            hair: 7,
            cloth: 7,
        },
    )
    for i in 0..MAX_BODIES {
        island.bodies.push(
            Body {
                peer: 4000000000 + i,
                x: -MAX_REACH,
                z: MAX_REACH,
                worn: true,
                card,
                seen: 1 << 50,
            },
        )
    }
    for i in 0..MAX_MARKS {
        island.marks.push(Mark { by: 4000000000 + i, x: -MAX_REACH, z: MAX_REACH })
    }
    let size = pack(island.clone()).len()
    assert(size < 60000, f"{size} bytes")
    // A newcomer takes the place of the body that acted longest ago.
    for i in 0..MAX_BODIES {
        island.bodies[i].seen = 1000 + u64(i)
    }
    island.bodies[7].seen = 5
    let newcomer = Entry {
        seq: 2,
        id: ProposalId { peer: 9, session: 1, counter: 1 },
        at: 9000,
        value: Act::Step { dx: 1, dz: 0 },
    }
    assert(island.check(newcomer) == Verdict::Accept)
    island.apply(newcomer)
    assert(island.bodies.len() == MAX_BODIES, "still full")
    let b = island.bodies[7].clone()
    assert(b.peer == 9 && b.x == 1 && !b.worn && b.seen == 9000, "in the stalest's place")
}

@test
fn the_key_is_the_rooms_name_under_island() {
    let k = key_of("island-a")
    assert(k.len() == 15 && k[0] == 105 && k[6] == 47 && k[14] == 97)
}

@test
fn a_body_long_quiet_or_worn_again_elsewhere_is_not_shown() {
    let card = Card::of(
        Name { title: 1, front: 2, back: 3, epithet: 4 },
        Look {
            build: 1,
            skin: 2,
            hair: 3,
            cloth: 4,
        },
    )
    var island = Island::empty()
    // 0: a guest, here; 1: gone quiet past `AWAY_MS`; 2 and 3: one account, reloaded as 3.
    island.bodies.push(Body { peer: 1, x: 0, z: 0, seen: 200000 })
    island.bodies.push(Body { peer: 2, x: 0, z: 0, seen: 200000 - AWAY_MS - 1 })
    island.bodies.push(Body { peer: 3, x: 0, z: 0, worn: true, card, seen: 150000 })
    island.bodies.push(Body { peer: 4, x: 0, z: 0, worn: true, card, seen: 190000 })
    let shown = island.present()
    assert(shown.len() == 2 && shown[0] == 0 && shown[1] == 3, f"{shown.len()} shown")
}
