// The grey-box boss fight's rules: one player, bare-fisted, against the Idol (the cathedral god's
// statue come alive: a giant of stone with three heads and three hands), stepped 60 times a
// second from the player's input and nothing else, in whole numbers, so a fight's input log
// plays the same fight again anywhere (`@deterministic`: the replay check mmo/combat's room does).
//
// The backbone is mmo/combat's rules moved onto the floor of a room in 3D: stamina, committed
// moves with windups, a parry that staggers, a dodge with invulnerable frames, a boss whose
// windups are its tells. What's new is what a fist needs against a giant. A fist reaches only
// what's low: the Idol's shins, always (its stone takes half); its three hands, while a slam
// leaves them stuck in the floor; and its chest and heads only when it's brought down, on its
// knees once its poise breaks (every blow to it wears its poise down) or reeling from a parry.
// So the fight is: stay alive under the giant, chip its legs, punish its slams, parry its
// swipes, and spend each knockdown on its heads.
//
// The player's input is 15 bits: the stick's heading (8 bits, 256 to a turn, 0 along +x and
// a quarter turn along +z) and how hard it's pushed (2 bits: 0 still, 1 walk, 2 run), four
// buttons, each pressed when its bit flips (a toggle, as mmo/combat's), and whether it's locked
// on (a state, not a press: the moves aim at the Idol when it is).

use std::pack::Pack

/// Frames a second.
pub const HZ: u32 = 60
/// The longest fight (ten minutes): past it, it's a draw.
pub const MAX_FRAMES: u32 = 36000

/// The input's fields.
pub const HEADING_BITS: u32 = 255
pub const PUSH_SHIFT: u32 = 8
pub const PUSH_BITS: u32 = 768
pub const JAB: u32 = 1024
pub const HEAVY: u32 = 2048
pub const PARRY: u32 = 4096
pub const DODGE: u32 = 8192
pub const LOCKED: u32 = 16384
pub const BUTTON_BITS: u32 = 15360
/// The inputs that are inputs: 15 bits.
pub const INPUT_BITS: u32 = 32767

/// Positions are in 1/256 of a metre.
pub const UNIT: i32 = 256
/// The nave's floor: 18 m either side of its middle, 30 m from its doors (-z) to the altar (+z).
pub const HALF_WIDTH: i32 = 18 * 256
pub const HALF_LENGTH: i32 = 30 * 256

pub const PLAYER_HP: i32 = 100
/// Stamina, in quarters (400 is 100).
pub const STAMINA: i32 = 400
pub const BOSS_HP: i32 = 1250
pub const BOSS_POISE: i32 = 130

// The player's moves, in frames. A jab: quick, cheap, chained up to three; a heavy: slow, a lunge,
// what breaks poise; a parry: a short window that sends a swipe back; a dodge: a roll whose
// first frames nothing touches.
pub const JAB_WINDUP: u32 = 5
pub const JAB_ACTIVE: u32 = 3
pub const JAB_RECOVERY: u32 = 13
pub const HEAVY_WINDUP: u32 = 18
pub const HEAVY_ACTIVE: u32 = 4
pub const HEAVY_RECOVERY: u32 = 24
pub const PARRY_STARTUP: u32 = 2
pub const PARRY_WINDOW: u32 = 10
pub const PARRY_RECOVERY: u32 = 18
pub const DODGE_FRAMES: u32 = 22
pub const DODGE_SAFE: u32 = 14
pub const HIT_FRAMES: u32 = 24
pub const DOWN_FRAMES: u32 = 56
const JAB_COST: i32 = 48
const HEAVY_COST: i32 = 112
const PARRY_COST: i32 = 32
const DODGE_COST: i32 = 80
/// Frames after a spend before stamina comes back, and how fast it does (quarters a frame).
const REST: u32 = 30
const REGAIN: i32 = 3
/// How many frames a press waits, made mid-move, for the move to let it go.
const BUFFER: u32 = 12
/// From which frame of a move's recovery the next move may cut it short: a jab into the next
/// jab or a heavy, anything into a dodge.
const JAB_CHAIN: u32 = 4
const DODGE_CANCEL: u32 = 10
/// How far a fist reaches from the body's middle (1/256 m), how far a move aims (it turns to
/// the Idol's nearest part within this), and the heavy's lunge (1/256 m a frame).
const FIST: i32 = 340
const HEAVY_FIST: i32 = 420
const AIM: i32 = 6 * 256
const LUNGE: i32 = 14
/// Damage of a jab and a heavy at full; poise each takes.
const JAB_DAMAGE: i32 = 10
const HEAVY_DAMAGE: i32 = 32
const JAB_POISE: i32 = 7
const HEAVY_POISE: i32 = 26
/// Speeds (1/256 m a frame): a walk 1.6 m/s, a run 4 m/s, a roll's first frames 6 m/s.
const WALK: i32 = 7
const RUN: i32 = 17
const ROLL: i32 = 26
/// The player's body and the Idol's (radii, 1/256 m).
const PLAYER_R: i32 = 100
const BOSS_R: i32 = 330

// What a body is doing.
pub const IDLE: u32 = 0
pub const WINDUP: u32 = 1
pub const ACTIVE: u32 = 2
pub const RECOVER: u32 = 3
pub const PARRYING: u32 = 4
pub const DODGING: u32 = 5
pub const HIT: u32 = 6
pub const DOWN: u32 = 7
pub const DEAD: u32 = 8
/// The Idol's own states: its slam's hands stuck in the floor, on its knees, reeling.
pub const STUCK: u32 = 9
pub const KNEEL: u32 = 10
pub const REEL: u32 = 11
pub const TURN: u32 = 12

/// The player's moves (`Player::move_`).
pub const NO_MOVE: u32 = 0
pub const MOVE_JAB: u32 = 1
pub const MOVE_HEAVY: u32 = 2

/// The Idol's attacks (`Boss::attack`): a side hand's swipe (left, right), the middle hand's palm
/// thrust straight ahead, all three hands slammed down, a stomp.
pub const SWIPE_LEFT: u32 = 1
pub const SWIPE_RIGHT: u32 = 2
pub const PALM: u32 = 3
pub const SLAM: u32 = 4
pub const STOMP: u32 = 5

/// An attack's frames, damage and reach (see `ATTACKS`).
pub struct Attack: Copy {
    pub windup: u32,
    pub active: u32,
    pub recovery: u32,
    pub damage: i32,
    pub parryable: bool,
    /// Whether it knocks the player down rather than staggering them.
    pub heavy: bool,
}

/// By `Boss::attack`; the swipes' tells are their arm drawn back across the body, the palm's the
/// middle hand pulled into the chest, the slam's all three raised overhead, the stomp's a knee
/// lifted.
pub const ATTACKS: [Attack; 6] = [
    Attack { windup: 0, active: 0, recovery: 0, damage: 0, parryable: false, heavy: false },
    Attack { windup: 36, active: 8, recovery: 34, damage: 22, parryable: true, heavy: false },
    Attack { windup: 36, active: 8, recovery: 34, damage: 22, parryable: true, heavy: false },
    Attack { windup: 30, active: 6, recovery: 40, damage: 26, parryable: true, heavy: false },
    Attack { windup: 54, active: 6, recovery: 18, damage: 40, parryable: false, heavy: true },
    Attack { windup: 26, active: 5, recovery: 30, damage: 16, parryable: false, heavy: true },
]
/// Frames the Idol's hands stay stuck after a slam, on its knees after its poise breaks, reeling
/// after a parry, and the least it waits between attacks (more at full health).
pub const STUCK_FRAMES: u32 = 96
pub const KNEEL_FRAMES: u32 = 170
pub const REEL_FRAMES: u32 = 110
const REST_LEAST: u32 = 26
/// How far its swipe reaches (from its middle) and how wide (its arc's half, 256 to a turn); its
/// palm's reach and half-width; where its slam lands ahead and how wide; its stomp's reach.
pub const SWIPE_REACH: i32 = 5 * 256
pub const SWIPE_ARC: i32 = 72
pub const PALM_REACH: i32 = 6 * 256
pub const PALM_HALF: i32 = 200
pub const SLAM_AHEAD: i32 = 3 * 256 + 64
pub const SLAM_R: i32 = 2 * 256 + 128
pub const STOMP_R: i32 = 3 * 256 + 64
/// The Idol walks at 1.5 m/s, and turns 2 a frame (of 256: 1.5 turns... 0.47 rad/s) winding up,
/// 4 standing.
const BOSS_WALK: i32 = 6
const BOSS_TURN: i32 = 4
const BOSS_TRACK: i32 = 2
/// Where its parts are, about its middle and the way it faces (1/256 m: x to its left, z ahead):
/// its shins, its hands stuck in the floor, its chest and heads when it's down.
const SHIN_X: i32 = 190
const SHIN_R: i32 = 130
const HANDS_R: i32 = 200
const CORE_AHEAD: i32 = 420
const CORE_R: i32 = 260
/// How much of a blow each part takes, in quarters: the shins half, the hands all, the heads
/// twice over.
const SHIN_SHARE: i32 = 2
const HANDS_SHARE: i32 = 4
const CORE_SHARE: i32 = 8
/// Frames the fight holds on a blow that lands (hit-stop): a jab, a heavy, a heavy to the heads.
const STOP_JAB: u32 = 3
const STOP_HEAVY: u32 = 7
const STOP_CRIT: u32 = 11
const STOP_HURT: u32 = 5

/// What the player's blow met (`World::struck`): nothing, the shins, the hands, the heads.
pub const STRUCK_NONE: u32 = 0
pub const STRUCK_SHIN: u32 = 1
pub const STRUCK_HANDS: u32 = 2
pub const STRUCK_CORE: u32 = 3

/// A change of the player's input at `frame` to `input`.
pub struct Change: Clone + Pack + Eq {
    pub frame: u32,
    pub input: u32,
}

/// How a fight ended.
pub enum Winner: Copy + Pack + Eq {
    Player,
    Boss,
    Draw,
}

/// The player: where (1/256 m), facing (256 to a turn), health, stamina (quarters), what it's
/// doing and for how many frames more, which move, how far into a chain of jabs, the press it
/// holds for later, and its push (a roll's, a lunge's, a blow's).
pub struct Player: Copy + Eq {
    pub x: i32,
    pub z: i32,
    pub facing: i32,
    pub hp: i32,
    pub stamina: i32,
    pub act: u32,
    pub timer: u32,
    pub move_: u32,
    pub chain: u32,
    pub landed: bool,
    pub rested: u32,
    pub buffered: u32,
    pub buffer_age: u32,
    pub vx: i32,
    pub vz: i32,
    /// How fast it went this frame (1/256 m), for the body drawn over it.
    pub moved: i32,
}

/// The Idol: where, facing, health, poise, what it's doing and for how many frames more, which
/// attack, where its slam lands, how many attacks it's chained, its dice.
pub struct Boss: Copy + Eq {
    pub x: i32,
    pub z: i32,
    pub facing: i32,
    pub hp: i32,
    pub poise: i32,
    pub calm: u32,
    pub act: u32,
    pub timer: u32,
    pub attack: u32,
    /// How long this windup is (a chained attack's is shorter): its tell's whole.
    pub wind: u32,
    pub landed: bool,
    pub at_x: i32,
    pub at_z: i32,
    pub combo: u32,
    pub rest: u32,
    pub behind: u32,
    pub dice: u32,
    pub moved: i32,
}

/// The fight at a frame.
pub struct World: Copy + Eq {
    pub frame: u32,
    /// Steps taken, hit-stops' held ones too: what a log's changes count.
    pub steps: u32,
    pub player: Player,
    pub boss: Boss,
    /// The buttons as the rules last took them.
    pub before: u32,
    /// Frames the fight is held for a blow (hit-stop).
    pub stop: u32,
    /// The last blow the player landed: where, on which frame, and how much it did; the last
    /// the player took.
    pub struck: u32,
    pub struck_at: u32,
    pub struck_for: i32,
    pub hurt_at: u32,
    pub parried_at: u32,
    pub over: bool,
    pub winner: Winner,
}

