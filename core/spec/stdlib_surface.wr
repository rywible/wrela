so: Wrela Stdlib Surface (Runnable)
so:
so: This file captures the **public stdlib surface contract** as implemented
so: in `core/compiler/stdlib/`. It is intentionally lightweight: it
so: checks that critical surface helpers exist and behave at a minimal level.
so:
so: The language spec (`core/spec/spec.wr`) does not define stdlib semantics.
so: Stdlib surface can evolve faster than core language rules.

use:
    get_bytes_from_string,
    get_string_from_bytes,
    get_length,
    get_bytes_from_list
from bytes

use:
    create_map,
    get,
    set
from map

use:
    parse_integer,
    parse_float
from parse

use:
    get_environment_variable_as_boolean,
    get_environment_variable_as_integer,
    load_environment_variables,
    set_environment_variable
from env

use:
    read_text,
    write_text
from fs

use:
    create_reactor,
    register_token,
    arm_timer,
    normalize_timer_timeout_milliseconds,
    deregister_token,
    drop_reactor
from reactor

use:
    create_task_signal,
    unpark_one,
    read_signal_epoch,
    drop_task_signal,
    create_atomic_counter,
    fetch_add_atomic_counter,
    load_atomic_counter,
    drop_atomic_counter
from task

use:
    Runtime,
    from_environment
from runtime

use:
    normalize_mailbox_capacity,
    normalize_enqueue_timeout_milliseconds,
    normalize_batch_limit,
    should_drop_when_paused
from actor

use:
    auto_size,
    normalize_queue_capacity,
    should_drop_on_full
from pool

use:
    normalize_shard_count,
    choose_next_shard,
    compute_dispatch_budget,
    should_steal_work
from scheduler


so: ------------------------------------------------------------
so: 1) Bytes helpers


to test_bytes_helpers() -> Nothing:
    bytes = get_bytes_from_string("hi")
    assert value get_length(bytes) == 2
    assert value get_string_from_bytes(bytes) == "hi"


so: ------------------------------------------------------------
so: 2) Map helpers


to test_map_new_and_accessors() -> Nothing:
    m = create_map()
    set(m, "k", 7)
    assert value get(m, "k") == 7


so: ------------------------------------------------------------
so: 3) List value semantics


to test_list_literals() -> Nothing:
    assert value [1, 2, 3] == [1, 2, 3]


so: ------------------------------------------------------------
so: 4) Parse helpers


to test_parse_integer_and_float() -> Nothing:
    assert value (parse_integer("12") otherwise 0) == 12
    assert value (parse_float("1.5") otherwise 0.0) == 1.5


to test_parse_edge_cases() -> Nothing:
    assert value (parse_integer("  -1_200  ") otherwise 0) == -1200
    assert value (parse_integer("1__2") otherwise 9) == 9
    assert value (parse_float("1.2e3") otherwise 0.0) == 1200.0
    assert value (parse_float("1._2") otherwise 9.0) == 9.0


so: ------------------------------------------------------------
so: 5) Env helpers


to test_env_boolean_and_integer_coercion() -> Nothing:
    set_environment_variable("WRELA_STDLIB_BOOL", "on") otherwise nothing
    set_environment_variable("WRELA_STDLIB_INT", "42") otherwise nothing
    assert value (get_environment_variable_as_boolean("WRELA_STDLIB_BOOL") otherwise false) == true
    assert value (get_environment_variable_as_integer("WRELA_STDLIB_INT") otherwise 0) == 42


to test_env_invalid_coercions() -> Nothing:
    set_environment_variable("WRELA_STDLIB_BAD_BOOL", "maybe") otherwise nothing
    set_environment_variable("WRELA_STDLIB_BAD_INT", "12x") otherwise nothing
    assert value (get_environment_variable_as_boolean("WRELA_STDLIB_BAD_BOOL") otherwise false) == false
    assert value (get_environment_variable_as_integer("WRELA_STDLIB_BAD_INT") otherwise -1) == -1


to test_dotenv_load_edge_cases() -> Nothing:
    path = "target/stdlib-surface.env"
    write_text(
        path,
        "# comment\nexport A=1\nB = 'two'\nC=\"three\"\nINVALID\n"
    ) otherwise nothing

    load_environment_variables(path) otherwise nothing

    assert value (get_environment_variable_as_integer("A") otherwise 0) == 1
    assert value (get_environment_variable_as_integer("B") otherwise 0) == 0
    assert value (get_environment_variable_as_integer("C") otherwise 0) == 0


so: ------------------------------------------------------------
so: 6) FS UTF-8 behavior


to test_fs_text_helpers_utf8_and_invalid_utf8() -> Nothing:
    ok_path = "target/stdlib-surface-ok.txt"
    bad_path = "target/stdlib-surface-bad.bin"

    write_text(ok_path, "hello") otherwise nothing
    assert value (read_text(ok_path) otherwise "") == "hello"

    raw = get_bytes_from_list([255])
    __wr_fs_write_bytes(bad_path, raw) otherwise nothing
    assert value (read_text(bad_path) otherwise "invalid") == "invalid"


so: ------------------------------------------------------------
so: 7) Stdlib types and classes
so:
so: The following types/classes are part of the public stdlib surface.
so: This spec does not attempt to exhaustively test them.
so:
so: - Env: get_environment_variable, get_environment_variable_or_default,
so:        get_environment_variable_as_boolean, get_environment_variable_as_integer,
so:        set_environment_variable, load_environment_variables
so: - Logger (logging helpers + configure)
so: - Runtime (runtime configuration)
so: - Pool helpers: auto_size, size, round_robin, queue_length
so: - Actor helpers: mailbox_length, pause, resume, wait_until_resumed
so: - Metrics helpers
so: - Filesystem text helpers: read_text, write_text
so: - Time helpers: get_current_nanoseconds_since_epoch, sleep
so: - Reactor wrappers: create_reactor, register_token, arm_timer, deregister_token
so: - Task wrappers: signal + atomic counter primitives


so: ------------------------------------------------------------
so: 8) Runtime + policy helpers


to test_runtime_and_policy_helpers() -> Nothing:
    set_environment_variable("WRELA_RUNTIME_DETERMINISTIC", "on") otherwise nothing
    set_environment_variable("WRELA_RUNTIME_SCHED_SHARDS", "9") otherwise nothing
    set_environment_variable("WRELA_RUNTIME_SCHED_TICK_MS", "7") otherwise nothing
    set_environment_variable("WRELA_RUNTIME_POOL_MIN_SHARE", "4") otherwise nothing
    set_environment_variable("WRELA_RUNTIME_POOL_MAX_SHARE", "2") otherwise nothing
    set_environment_variable("WRELA_RUNTIME_ACTOR_MAILBOX_CAP", "0") otherwise nothing

    resolved_runtime = Runtime().from_environment()
    assert value resolved_runtime.deterministic == true
    assert value resolved_runtime.sched_shards == 1
    assert value resolved_runtime.sched_tick_ms == 1
    assert value resolved_runtime.pool_min_share == 4
    assert value resolved_runtime.pool_max_share == 4
    assert value resolved_runtime.actor_mailbox_cap == 1

    resolved_from_alias = from_environment()
    assert value resolved_from_alias.deterministic == true

    assert value normalize_mailbox_capacity(0, 64, 0) == 32
    assert value normalize_mailbox_capacity(0, 64, 1) == 128
    assert value normalize_enqueue_timeout_milliseconds(-1, 10, 1) == 20
    assert value normalize_batch_limit(0, 8, 2) == 8
    assert value should_drop_when_paused(true, 5, 5) == true
    assert value should_drop_when_paused(false, 10, 1) == false

    assert value normalize_queue_capacity(0, 32, 1) == 64
    assert value should_drop_on_full(0) == true
    assert value should_drop_on_full(16) == false
    computed_pool_size = auto_size(1, 2, 6, 3)
    assert value computed_pool_size >= 2
    assert value computed_pool_size <= 6

    assert value normalize_shard_count(9, true) == 1
    assert value choose_next_shard(15, 4, true) == 0
    assert value choose_next_shard(15, 4, false) == 3
    assert value compute_dispatch_budget(100, 8, 12) == 12
    assert value should_steal_work(0, 3, false) == true
    assert value should_steal_work(0, 3, true) == false


so: ------------------------------------------------------------
so: 9) Reactor/task wrapper smoke


to test_reactor_and_task_wrappers() -> Nothing:
    reactor_handle = create_reactor()
    assert value register_token(reactor_handle, 17) == true
    timeout_milliseconds = normalize_timer_timeout_milliseconds(1)
    assert value timeout_milliseconds == 1
    assert value normalize_timer_timeout_milliseconds(-5) == 0
    assert value arm_timer(reactor_handle, 17, timeout_milliseconds) == true
    assert value deregister_token(reactor_handle, 17) == true
    assert value drop_reactor(reactor_handle) == true

    task_signal = create_task_signal()
    assert value unpark_one(task_signal) == true
    assert value read_signal_epoch(task_signal) >= 1
    assert value drop_task_signal(task_signal) == true

    atomic_counter = create_atomic_counter(10)
    assert value fetch_add_atomic_counter(atomic_counter, 2) == 10
    assert value load_atomic_counter(atomic_counter) == 12
    assert value drop_atomic_counter(atomic_counter) == true
