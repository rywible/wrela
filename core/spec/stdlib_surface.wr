so: Wrela Stdlib Surface (Runnable)
so:
so: This file captures the **public stdlib surface contract** as implemented
so: in `core/compiler/stdlib/`. It is intentionally lightweight: it
so: checks that critical surface helpers exist and behave at a minimal level.
so:
so: The language spec (`core/spec/spec.wr`) does not define stdlib semantics.
so: Stdlib surface can evolve faster than core language rules.

use:
    get_bytes_from_string,
    get_string_from_bytes,
    get_length
from bytes

use:
    create_map,
    get,
    set
from map

use push from list

use:
    parse_integer,
    parse_float
from parse

use:
    convert_integer_to_pointer,
    convert_pointer_to_integer,
    offset_pointer,
    get_size_of,
    get_alignment_of,
    get_address_of,
    copy_memory,
    fill_memory,
    compare_memory
from memory


so: ------------------------------------------------------------
so: 1) Bytes helpers


to test_bytes_helpers() -> Nothing:
    bytes = get_bytes_from_string("hi")
    assert value get_length(bytes) == 2
    assert value get_string_from_bytes(bytes) == "hi"


so: ------------------------------------------------------------
so: 2) Map helpers


to test_map_new_and_accessors() -> Nothing:
    m = create_map()
    set(m, "k", 7)
    assert value get(m, "k") == 7


so: ------------------------------------------------------------
so: 3) List helpers


to test_list_push_builtin() -> Nothing:
    items = [1, 2]
    push(items, 3)
    assert value items == [1, 2, 3]


so: ------------------------------------------------------------
so: 4) Parse helpers


to test_parse_integer_and_float() -> Nothing:
    assert value (parse_integer("12") otherwise 0) == 12
    assert value (parse_float("1.5") otherwise 0.0) == 1.5


so: ------------------------------------------------------------
so: 5) Memory helpers (unsafe)


to test_memory_helpers() -> Nothing:
    unsafe:
        left = 111
        right = 222
        left_ptr = get_address_of(left)
        right_ptr = get_address_of(right)
        copy_memory(right_ptr, left_ptr, 8)
        assert value compare_memory(left_ptr, right_ptr, 8) == 0
        fill_memory(left_ptr, 0, 8)
        assert value compare_memory(left_ptr, right_ptr, 8) != 0
        assert value get_size_of(left_ptr) == 8
        assert value get_alignment_of(left_ptr) == 8


so: ------------------------------------------------------------
so: 6) Stdlib types and classes
so:
so: The following types/classes are part of the public stdlib surface.
so: This spec does not attempt to exhaustively test them.
so:
so: - Env: get_environment_variable, get_environment_variable_or_default,
so:        get_environment_variable_as_boolean, get_environment_variable_as_integer,
so:        set_environment_variable, load_environment_variables
so: - AuthProvider: configure, create_user, verify_password, issue_jwt, verify_jwt,
so:        issue_email_token, verify_email_token, login_with_oauth
so: - RoleBasedAccessControlProvider: create_role, assign_role, check_permission, get_permissions_for
so: - FileSystem: upload_stream, generate_signed_url, get_metadata, delete, set_access_control_list
so: - JobManager: configure, enqueue, process, get_dead_letter
so: - Scheduler: register_cron_job, run_every, run_at
so: - SearchClient: index, remove, query
so: - RealtimeSocketProvider: configure, register_connection_handler, join_room,
so:        leave_room, broadcast_to_room, send_message
so: - PubSub: configure
so: - Logger (logging helpers + configure)
so: - Runtime (runtime configuration)
so: - RateLimiter: check_limit, get_ip
so: - Admin: enable
so: - StorageConfig + StorageClient (storage_* helpers)
so: - storage_open function
so: - HttpRequest + HttpResponse helpers
so: - HttpServer helpers
