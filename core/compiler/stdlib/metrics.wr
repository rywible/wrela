so:
    Metrics helpers.

so: Fetch a metric by id.
to get(id: Int) -> Int:
    return __wr_metrics_get(id)

so: Metric id for messages dropped due to pause.
to dropped_paused_id() -> Int:
    return __wr_metrics_dropped_paused_id()

so: Metric id for messages dropped overall.
to messages_dropped_id() -> Int:
    return __wr_metrics_messages_dropped_id()
