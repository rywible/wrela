so:
    Actor control helpers.

so: Get the mailbox length for an actor handle.
to get_mailbox_length(handle: Any) -> Integer:
    return __wr_actor_mailbox_len(handle)

so: Pause an actor.
to pause(handle: Any) -> Nothing:
    __wr_actor_pause(handle)
    return nothing

so: Resume an actor.
to resume(handle: Any) -> Nothing:
    __wr_actor_resume(handle)
    return nothing

so: Pause an actor and wait for the pause to take effect.
to pause_and_wait(handle: Any) -> Nothing:
    __wr_actor_pause_wait(handle)
    return nothing
