so:
    Environment variable helpers.


so: Get an environment variable by key.
to get_environment_variable(key: String) -> String:
    return __wr_env_get(key)

so: Get an environment variable or return the provided default.
to get_environment_variable_or_default(key: String, default: String) -> String:
    return __wr_env_get_or(key, default)

so: Read an environment variable and coerce it to Boolean.
to get_environment_variable_as_boolean(key: String) -> Boolean:
    return __wr_env_get_as_bool(key)

so: Read an environment variable and coerce it to Integer.
to get_environment_variable_as_integer(key: String) -> Integer:
    return __wr_env_get_as_int(key)

so: Set an environment variable.
to set_environment_variable(key: String, value: String) -> Boolean:
    return __wr_env_set(key, value)

so: Load environment variables from a file path.
to load_environment_variables(path: String) -> Boolean:
    return __wr_env_load(path)
