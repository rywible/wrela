so:
    Environment variable helpers.

so: Get an environment variable by key.
to get(key: String) -> String:
    return __wr_env_get(key)

so: Get an environment variable or return the provided default.
to get_or(key: String, default: String) -> String:
    return __wr_env_get_or(key, default)

so: Read an environment variable and coerce it to Bool.
to get_as_bool(key: String) -> Bool:
    return __wr_env_get_as_bool(key)

so: Read an environment variable and coerce it to Int.
to get_as_int(key: String) -> Int:
    return __wr_env_get_as_int(key)

so: Set an environment variable.
to set(key: String, value: String) -> Bool:
    return __wr_env_set(key, value)

so: Load environment variables from a file path.
to load(path: String) -> Bool:
    return __wr_env_load(path)

A Env:
    so: Get an environment variable by key.
    can get(key: String) -> String:
        return __wr_env_get(key)

    so: Get an environment variable or return the provided default.
    can get_or(key: String, default: String) -> String:
        return __wr_env_get_or(key, default)

    so: Read an environment variable and coerce it to Bool.
    can get_as_bool(key: String) -> Bool:
        return __wr_env_get_as_bool(key)

    so: Read an environment variable and coerce it to Int.
    can get_as_int(key: String) -> Int:
        return __wr_env_get_as_int(key)

    so: Set an environment variable.
    can set(key: String, value: String) -> Bool:
        return __wr_env_set(key, value)

    so: Load environment variables from a file path.
    can load(path: String) -> Bool:
        return __wr_env_load(path)
