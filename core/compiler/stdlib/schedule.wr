so:
    Scheduling helpers backed by storage.

use StorageClient from storage

A Scheduler:
    has:
        storage: StorageClient

    so: Register a cron job.
    can register_cron_job(expr: String, job: Any) -> Pending:
        return __wr_schedule_cron(its.storage, expr, job)

    so: Run a job every N seconds.
    can run_every(seconds: Integer, job: Any) -> Pending:
        return __wr_schedule_every(its.storage, seconds, job)

    so: Run a job at a timestamp (unix seconds).
    can run_at(timestamp: Integer, job: Any) -> Pending:
        return __wr_schedule_at(its.storage, timestamp, job)
