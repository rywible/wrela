so:
    Runtime configuration helpers.

A Runtime:
    has:
        actor_mailbox_cap: Number = 256
        actor_enqueue_timeout_ms: Number = 10
        actor_batch_limit: Number = 64
        pause_queue_cap: Number = 128
        deterministic: Boolean = false
        debug_actor: Boolean = false
        actor_watchdog_ms: Number = 0
        sched_watchdog_ms: Number = 0
        sched_shards: Number = nothing
        sched_tick_ms: Number = 1
        sched_ready_cap: Number = 1024
        sched_batch_limit: Number = 64
        pool_min_share: Number = 1
        pool_max_share: Number = nothing
        pool_queue_cap: Number = 256
        pool_auto_min: Number = 1
        pool_auto_max: Number = nothing
        diagnostics_enabled: Boolean = false

    so: Apply runtime configuration when fields are provided.
    can __configure__() -> Nothing:
        if its.actor_mailbox_cap != nothing or its.actor_enqueue_timeout_ms != nothing or its.actor_batch_limit != nothing or its.pause_queue_cap != nothing or its.deterministic != nothing or its.debug_actor != nothing or its.actor_watchdog_ms != nothing or its.sched_watchdog_ms != nothing or its.sched_shards != nothing or its.sched_tick_ms != nothing or its.sched_ready_cap != nothing or its.sched_batch_limit != nothing or its.pool_min_share != nothing or its.pool_max_share != nothing or its.pool_queue_cap != nothing or its.pool_auto_min != nothing or its.pool_auto_max != nothing or its.diagnostics_enabled != nothing:
            return __wr_runtime_configure(its)
        return nothing
