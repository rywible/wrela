so:
    Role-based access control helpers backed by storage.

use StorageClient from storage

A RoleBasedAccessControlProvider:
    has:
        storage: StorageClient

    so: Create a role with permissions in a scope.
    can create_role(scope: String, name: String, permissions: List[String]) -> Pending:
        return __wr_rbac_create_role(its.storage, scope, name, permissions)

    so: Assign a role to a user within a scope.
    can assign_role(user_id: String, role_id: String, scope_id: String) -> Pending:
        return __wr_rbac_assign_role(its.storage, user_id, role_id, scope_id)

    so: Check if a user has a permission in a scope.
    can check_permission(user_id: String, permission: String, scope_id: String) -> Pending:
        return __wr_rbac_check(its.storage, user_id, permission, scope_id)

    so: Fetch all permissions for a user in a scope.
    can get_permissions_for(user_id: String, scope_id: String) -> Pending:
        return __wr_rbac_permissions_for(its.storage, user_id, scope_id)
