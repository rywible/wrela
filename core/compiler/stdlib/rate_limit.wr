so:
    Rate limiting helpers backed by storage.

use StorageClient from storage
use HttpRequest from http

A RateLimiter:
    has:
        storage: StorageClient

    so: Check rate limits for a key with options.
    can check_limit(key: String, opts: Map) -> Pending:
        return __wr_rate_check(its.storage, key, opts)

    so: Extract the request IP for rate limiting.
    can get_ip(request: HttpRequest) -> String:
        return __wr_rate_ip(request)
