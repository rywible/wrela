so:
    Realtime socket helpers.

A RealtimeSocketProvider:
    has:
        socket_ttl_secs: Number = 0

    so: Apply realtime configuration when fields are provided.
    can __configure__() -> Nothing:
        if its.socket_ttl_secs != nothing:
            return __wr_realtime_configure(its)
        return nothing

    so: Register a connection handler.
    can register_connection_handler(handler: Any) -> Pending:
        return __wr_realtime_on_connect(handler)

    so: Join a socket to a room.
    can join_room(socket_id: String, room: String) -> Pending:
        return __wr_realtime_join(socket_id, room)

    so: Leave a room.
    can leave_room(socket_id: String, room: String) -> Pending:
        return __wr_realtime_leave(socket_id, room)

    so: Broadcast to a room.
    can broadcast_to_room(room: String, message: Any) -> Pending:
        return __wr_realtime_broadcast(room, message)

    so: Send a message to a socket.
    can send_message(socket_id: String, message: Any) -> Pending:
        return __wr_realtime_send(socket_id, message)
