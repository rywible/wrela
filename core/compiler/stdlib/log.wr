so:
    Logging helpers and configuration.

A Logger:
    has:
        level: String = "info"

    so: Apply logging configuration when fields are provided.
    can __configure__() -> Nothing:
        if its.level != nothing:
            return __wr_log_configure(its)
        return nothing

    so: Log a debug message.
    can debug(message: String) -> Boolean:
        return __wr_log("debug", message, __wr_map_new())

    so: Log an info message.
    can info(message: String) -> Boolean:
        return __wr_log("info", message, __wr_map_new())

    so: Log a warning message.
    can warn(message: String) -> Boolean:
        return __wr_log("warn", message, __wr_map_new())

    so: Log an error message.
    can err(message: String) -> Boolean:
        return __wr_log("error", message, __wr_map_new())

    so: Log a debug message with fields.
    can debug_with(message: String, fields: Map) -> Boolean:
        return __wr_log("debug", message, fields)

    so: Log an info message with fields.
    can info_with(message: String, fields: Map) -> Boolean:
        return __wr_log("info", message, fields)

    so: Log a warning message with fields.
    can warn_with(message: String, fields: Map) -> Boolean:
        return __wr_log("warn", message, fields)

    so: Log an error message with fields.
    can error_with(message: String, fields: Map) -> Boolean:
        return __wr_log("error", message, fields)

    so: Log a debug message.
    can log_debug(message: String) -> Boolean:
        return __wr_log("debug", message, __wr_map_new())

    so: Log an info message.
    can log_info(message: String) -> Boolean:
        return __wr_log("info", message, __wr_map_new())

    so: Log a warning message.
    can log_warn(message: String) -> Boolean:
        return __wr_log("warn", message, __wr_map_new())

    so: Log a warning message (alias).
    can log_warning(message: String) -> Boolean:
        return __wr_log("warn", message, __wr_map_new())

    so: Log an error message.
    can log_error(message: String) -> Boolean:
        return __wr_log("error", message, __wr_map_new())

    so: Log a debug message with fields.
    can log_debug_with(message: String, fields: Map) -> Boolean:
        return __wr_log("debug", message, fields)

    so: Log an info message with fields.
    can log_info_with(message: String, fields: Map) -> Boolean:
        return __wr_log("info", message, fields)

    so: Log a warning message with fields.
    can log_warn_with(message: String, fields: Map) -> Boolean:
        return __wr_log("warn", message, fields)

    so: Log a warning message with fields (alias).
    can log_warning_with(message: String, fields: Map) -> Boolean:
        return __wr_log("warn", message, fields)

    so: Log an error message with fields.
    can log_error_with(message: String, fields: Map) -> Boolean:
        return __wr_log("error", message, fields)
