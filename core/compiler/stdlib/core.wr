A Env:
    can get(key: String) -> String:
        return env_get(key)

    can get_or(key: String, default: String) -> String:
        return env_get_or(key, default)

    can get_as_bool(key: String) -> Bool:
        return env_get_as_bool(key)

    can get_as_int(key: String) -> Int:
        return env_get_as_int(key)

    can set(key: String, value: String) -> Bool:
        return env_set(key, value)

    can load(path: String) -> Bool:
        return env_load(path)

A Auth:
    has:
        storage: StorageClient
    can create_user(email: String, username: String, password: String) -> Pending:
        return auth_create_user(its.storage, email, username, password)

    can verify_password(user_id: String, password: String) -> Pending:
        return auth_verify_password(its.storage, user_id, password)

    can issue_jwt(user_id: String, claims: Map, ttl_secs: Int) -> Pending:
        return auth_issue_jwt(its.storage, user_id, claims, ttl_secs)

    can verify_jwt(token: String) -> Pending:
        return auth_verify_jwt(its.storage, token)

    can issue_email_token(user_id: String, ttl_secs: Int) -> Pending:
        return auth_issue_email_token(its.storage, user_id, ttl_secs)

    can verify_email_token(token: String) -> Pending:
        return auth_verify_email_token(its.storage, token)

    can oauth_login(provider: String, code: String) -> Pending:
        return auth_oauth_login(its.storage, provider, code)

A RBAC:
    has:
        storage: StorageClient
    can create_role(scope: String, name: String, permissions: List[String]) -> Pending:
        return rbac_create_role(its.storage, scope, name, permissions)

    can assign_role(user_id: String, role_id: String, scope_id: String) -> Pending:
        return rbac_assign_role(its.storage, user_id, role_id, scope_id)

    can check(user_id: String, permission: String, scope_id: String) -> Pending:
        return rbac_check(its.storage, user_id, permission, scope_id)

    can permissions_for(user_id: String, scope_id: String) -> Pending:
        return rbac_permissions_for(its.storage, user_id, scope_id)

A Files:
    has:
        storage: StorageClient
    can upload_stream(stream: Bytes, opts: Map) -> Pending:
        return files_upload_stream(its.storage, stream, opts)

    can signed_url(file_id: String, opts: Map) -> Pending:
        return files_signed_url(its.storage, file_id, opts)

    can metadata(file_id: String) -> Pending:
        return files_metadata(its.storage, file_id)

    can delete(file_id: String) -> Pending:
        return files_delete(its.storage, file_id)

    can set_acl(file_id: String, acl: String) -> Pending:
        return files_set_acl(its.storage, file_id, acl)

A Jobs:
    has:
        storage: StorageClient
    can enqueue(queue: String, payload: Map, opts: Map) -> Pending:
        return jobs_enqueue(its.storage, queue, payload, opts)

    can process(queue: String, handler: Any) -> Pending:
        return jobs_process(its.storage, queue, handler)

    can dead_letter(queue: String) -> Pending:
        return jobs_dead_letter(its.storage, queue)

A Schedule:
    has:
        storage: StorageClient
    can cron(expr: String, job: Any) -> Pending:
        return schedule_cron(its.storage, expr, job)

    can every(seconds: Int, job: Any) -> Pending:
        return schedule_every(its.storage, seconds, job)

    can at(timestamp: Int, job: Any) -> Pending:
        return schedule_at(its.storage, timestamp, job)

A Search:
    has:
        storage: StorageClient
    can index(collection: String, id: String, text: String, fields: Map) -> Pending:
        return search_index(its.storage, collection, id, text, fields)

    can remove(collection: String, id: String) -> Pending:
        return search_remove(its.storage, collection, id)

    can query(collection: String, query: String, opts: Map) -> Pending:
        return search_query(its.storage, collection, query, opts)

A Realtime:
    can on_connect(handler: Any) -> Pending:
        return realtime_on_connect(handler)

    can join(socket_id: String, room: String) -> Pending:
        return realtime_join(socket_id, room)

    can leave(socket_id: String, room: String) -> Pending:
        return realtime_leave(socket_id, room)

    can broadcast(room: String, message: Any) -> Pending:
        return realtime_broadcast(room, message)

    can send(socket_id: String, message: Any) -> Pending:
        return realtime_send(socket_id, message)

A Log:
    can debug(message: String) -> Bool:
        return log("debug", message, map_new())

    can info(message: String) -> Bool:
        return log("info", message, map_new())

    can warn(message: String) -> Bool:
        return log("warn", message, map_new())

    can error(message: String) -> Bool:
        return log("error", message, map_new())

    can debug_with(message: String, fields: Map) -> Bool:
        return log("debug", message, fields)

    can info_with(message: String, fields: Map) -> Bool:
        return log("info", message, fields)

    can warn_with(message: String, fields: Map) -> Bool:
        return log("warn", message, fields)

    can error_with(message: String, fields: Map) -> Bool:
        return log("error", message, fields)

A Logger:
    can log_debug(message: String) -> Bool:
        return log("debug", message, map_new())

    can log_info(message: String) -> Bool:
        return log("info", message, map_new())

    can log_warn(message: String) -> Bool:
        return log("warn", message, map_new())

    can log_warning(message: String) -> Bool:
        return log("warn", message, map_new())

    can log_error(message: String) -> Bool:
        return log("error", message, map_new())

    can log_debug_with(message: String, fields: Map) -> Bool:
        return log("debug", message, fields)

    can log_info_with(message: String, fields: Map) -> Bool:
        return log("info", message, fields)

    can log_warn_with(message: String, fields: Map) -> Bool:
        return log("warn", message, fields)

    can log_warning_with(message: String, fields: Map) -> Bool:
        return log("warn", message, fields)

    can log_error_with(message: String, fields: Map) -> Bool:
        return log("error", message, fields)

A RateLimit:
    has:
        storage: StorageClient
    can check(key: String, opts: Map) -> Pending:
        return rate_check(its.storage, key, opts)

    can ip(request: HttpRequest) -> String:
        return rate_ip(request)

A Admin:
    can enable(opts: Map) -> Pending:
        return admin_enable(opts)

A StorageConfig:
    has:
        s3_bucket: String
        s3_region: String
        s3_access_key: String
        s3_secret_key: String
        s3_endpoint: String
        s3_prefix: String
        file_path: String

A StorageClient:
    can get(key: String) -> Result:
        return await storage_get(key)

    can get_with_version(key: String) -> Result:
        return await storage_get_with_version(key)

    can scan(start: String, end: String, limit: Number) -> Result:
        return await storage_scan(start, end, limit)

    can list_prefix(prefix: String, limit: Number) -> Result:
        return await storage_list_prefix(prefix, limit)

    can set(key: String, value: String) -> Result:
        return await storage_set(key, value)

    can set_if_version(key: String, value: String, version: Number) -> Result:
        return await storage_set_if_version(key, value, version)

    can delete_if_version(key: String, version: Number) -> Result:
        return await storage_delete_if_version(key, version)

    can delete(key: String) -> Result:
        return await storage_delete(key)

    can batch_set(items: List[Map]) -> Result:
        return await storage_batch_set(items)

to storage_open(config: StorageConfig) -> Actor[StorageClient]:
    storage_configure(config) otherwise nil
    return detach StorageClient() * 1

A HttpRequest:
    has:
        method: String
        path: String
        headers: Map
        query: Map
        params: Map
        body: Bytes

    can header(name: String) -> String:
        return map_get(its.headers, name)

    can query_param(name: String) -> String:
        return map_get(its.query, name)

    can path_param(name: String) -> String:
        return map_get(its.params, name)

    can text() -> String:
        return bytes_to_string(its.body)

    can json() -> String:
        return bytes_to_string(its.body)

A HttpResponse:
    has:
        status: Number
        headers: Map
        body: Bytes

    can header(name: String, value: String) -> HttpResponse:
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, name, value)
        return it

    can ok(text: String) -> HttpResponse:
        its.status = 200
        its.body = bytes_from_string(text)
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, "content-type", "text/plain; charset=utf-8")
        return it

    can json(text: String) -> HttpResponse:
        its.status = 200
        its.body = bytes_from_string(text)
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, "content-type", "application/json")
        return it

    can text(text: String) -> HttpResponse:
        return its.ok(text)

    can text_with_status(text: String, status: Number) -> HttpResponse:
        its.status = status
        its.body = bytes_from_string(text)
        if its.headers == nil:
            its.headers = {}
        map_set(its.headers, "content-type", "text/plain; charset=utf-8")
        return it

    can empty() -> HttpResponse:
        its.status = 204
        its.body = bytes_from_string("")
        return it

    can empty_with_status(status: Number) -> HttpResponse:
        its.status = status
        its.body = bytes_from_string("")
        return it

A HttpServer:
    can serve_get_requests(path: String, handler: Any) -> Nothing:
        http_server_serve_get_requests(path, handler)

    can serve_post_requests(path: String, handler: Any) -> Nothing:
        http_server_serve_post_requests(path, handler)

    can serve_requests(method: String, path: String, handler: Any) -> Nothing:
        http_server_serve_requests(method, path, handler)

    can serve_on(addr: String) -> Nothing:
        http_server_serve_on(addr)

    can stop() -> Nothing:
        http_server_stop()
