// The tool test: the console built as it ships into `scratch/console`, each of its pipelines'
// WGSL files measured.

use std::tool::files
use std::tool::toolchain

/// A shipped pipeline's WGSL at most, in bytes.
const MOST_WGSL: u64 = 256 * 1024

/// The console builds as it ships, with shader pipelines, each within the shipped WGSL budget.
@test(tool, read: [("repo", "../../..")], budget: 300)
fn the_console_ships_within_its_shader_budget() {
    let built = toolchain::build("repo/console", "scratch/console", toolchain::options()).wait()
    let Ok(build) = built else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the console builds")
    var shaders = 0
    for k in 0..build.files.len() {
        let name = build.files[k].clone()
        if !name.as_str().ends_with(".wgsl") {
            continue
        }
        shaders += 1
        let stat = files::stat(f"scratch/console/{name.as_str()}").wait()
        let Ok(entry) = stat else { panic(f"{name.as_str()} is there") }
        assert(entry.size <= MOST_WGSL, f"{name.as_str()}: {entry.size} bytes over {MOST_WGSL}")
    }
    assert(shaders > 0, "the console has no shader pipelines")
}
