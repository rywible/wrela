// The console's legal pages: the Terms of Service, the Privacy Policy, the Credits and a health
// warning (photosensitive seizures). They are
// drafts in plain English, for a lawyer's review before launch, and each page says so at its top.
// They describe the accounts as they are built (platform/account.wrela, platform/server.wrela) and
// the lines Ryan chose not to cross, which keep the accounts outside COPPA's personal information
// (16 CFR 312, as amended in 2025): no age gate, generated names only, no stored IP addresses.
//
// A page is paragraphs: one that starts with "# " is a heading, "- " a point of a list. The
// Credits page shows the licences the release ships beside the console (studio/release): the MIT
// licence and each font's SIL Open Font License, fetched whole, so what it shows is what ships.

/// The pages.
pub const TERMS: u32 = 0
pub const PRIVACY: u32 = 1
pub const CREDITS: u32 = 2
pub const HEALTH: u32 = 3
pub const PAGES: u32 = 4

pub const TITLES: [Text; 4] = [
    "Terms of Service",
    "Privacy Policy",
    "Credits and licences",
    "Health warning",
]
/// Each page's name on its link.
pub const LINKS: [Text; 4] = ["Terms", "Privacy", "Credits", "Health"]

/// The banner every page carries.
pub const DRAFT: Text = "DRAFT for review by a lawyer. Not yet in force."

/// The licence files the Credits page shows, as the release names them beside the console.
pub const LICENCES: [Text; 4] = [
    "LICENSE",
    "fonts/OFL-Manrope.txt",
    "fonts/OFL-Inter.txt",
    "fonts/OFL-JetBrainsMono.txt",
]

