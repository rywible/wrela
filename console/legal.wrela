pub const HEALTH_TEXT: [Text; 9] = [
    "# Photosensitive seizures",
    "A very small number of people may have a seizure when they see certain visual images, including flashing lights, patterns or fast motion, such as those in video games. This can happen to people with no history of seizures or epilepsy.",
    "Stop playing at once and see a doctor if you or a child playing has any of these: lightheadedness, changed vision, eye or face twitching, jerking or shaking of the arms or legs, confusion, disorientation, or any involuntary movement or loss of awareness.",
    "Parents: watch your children while they play, and ask them about these symptoms. Children and teenagers are more likely than adults to have these seizures.",
    "# To lower the risk",
    "- Play in a well-lit room, sitting farther from the screen.",
    "- Don't play when you are drowsy or tired.",
    "- Take a break of at least 10 to 15 minutes every hour. Turning on your system's reduced-motion setting calms the console's motion.",
    "If you or anyone in your family has had seizures or epilepsy, talk to a doctor before playing. This page is a draft for a lawyer's review.",
]

/// Page `page`'s paragraphs.
pub fn paragraphs(page: u32) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    if page == TERMS {
        for p in TERMS_TEXT {
            out.push(String::from(p))
        }
    } else if page == PRIVACY {
        for p in PRIVACY_TEXT {
            out.push(String::from(p))
        }
    } else if page == HEALTH {
        for p in HEALTH_TEXT {
            out.push(String::from(p))
        }
    } else {
        for p in CREDITS_TEXT {
            out.push(String::from(p))
        }
    }
    out
}

@test
fn the_pages_are_drafts_and_promise_what_the_server_does() {
    for page in [TERMS, PRIVACY, HEALTH] {
        let ps = paragraphs(page)
        var all = String::new()
        for p in ps {
            all.push_str(p.as_str())
            all.push_str("\n")
        }
        assert(all.as_str().find("draft").is_some(), "says it's a draft")
    }
    var privacy = String::new()
    for p in PRIVACY_TEXT {
        privacy.push_str(p)
    }
    // What the server does, the policy says: sessions end after 90 days, game tokens after an hour,
    // ten recovery codes kept as hashes.
    assert(account_life_days() == 90 && privacy.as_str().find("90 days").is_some())
    assert(privacy.as_str().find("an hour").is_some())
    assert(
        privacy.as_str().find("Cloudflare").is_some() && privacy.as_str().find("Fly.io").is_none(),
    )
    assert(privacy.as_str().find("No IP addresses").is_some())
    assert(privacy.as_str().find("sells nothing").is_some(), "free, no ads, sells nothing")
    var terms = String::new()
    for p in TERMS_TEXT {
        terms.push_str(p)
    }
    for promise in ["\"as is\"", "not liable", "[operator", "Health warning"] {
        assert(terms.as_str().find(promise).is_some(), promise)
    }
}

fn account_life_days() -> u64 {
    platform::account::SESSION_LIFE / platform::account::DAY
}
