// Wrela's console. The catalog and game session protocol supply all title-specific content.
use catalog::{Card, parse}
use opening::{
    MARK_WIDTH, OPENING_SECONDS, RETURNING, artifact_place, clock_at, mark_place, moment,
    presentation_step, stage_light, turn_at,
}
use paint::{
    Edges, Emblem, Pool, Stage, block_corner, block_edge, block_face, block_line, emblem, pool,
    quad, stage,
}
use room::{Camera, MARGIN, artifact_spot, bounds, camera, place, row, row_place}
use tesseract::{Artifact, artifact, corners}
use brand::facet
use brand::facet::MarkRun
use brand::manrope::MANROPE
use std::host
use platform::protocol::{Reply, Request, SaveInfo, valid_key}
use std::gpu::{
    GpuBuffer, Rgba8, Rgba16Float, Sampler, Texture, begin_pass, begin_screen_pass, buffer,
    buffer_of, draw, sampler, texture, write,
}
use std::input::{Button, Event, Key, PadAxis, PadButton, events}
use std::io::{Pending, fetch, load as read_file, store}
use std::serialize::{LoadError, Serialize, load, save}
use ui::draw::{DrawList, Rect, Renderer}
use ui::text::{Face, Fonts, previous}

@fuel(2 ** 34)
const MARK_RUNS: Vec<MarkRun> = facet::mark_runs()
@fuel(2 ** 30)
const TESSERACT_EDGES: Vec<vec4> = tesseract::edges()
@fuel(2 ** 30)
const TESSERACT_FACES: Vec<vec4> = tesseract::faces()
// Colours and shapes after shadcn/ui's dark theme: near-white ink, muted grey text, quiet
// filled controls behind hairline borders, small radii, no glow.
const INK = vec4(0.98, 0.98, 0.98, 1.0)
const MUTED = vec4(0.63, 0.63, 0.66, 1.0)
const DARK = vec4(0.035, 0.035, 0.04, 1.0)
const SHEET = vec4(0.04, 0.04, 0.045, 0.98)
const WARN = vec4(0.95, 0.74, 0.6, 1.0)
const BORDER = vec4(1.0, 1.0, 1.0, 0.1)
const INPUT = vec4(1.0, 1.0, 1.0, 0.15)
const SECONDARY = vec4(0.15, 0.15, 0.16, 0.9)
const RAISED = vec4(0.21, 0.21, 0.22, 0.95)
const RADIUS: f32 = 8.0
// A button's label, in pixels.
const LABEL: f32 = 15.0
// Manrope's capital height, in ems.
const SANS_CAP: f32 = 0.72
// The mark's cap height in the header, in logical pixels.
const HEADER_CAP: f32 = 15.0
// The room and its artifact are traced at the screen's size divided by a whole number, to
// about this many pixels: at least one sample a CSS pixel on a 2x display.
const TRACED_PIXELS: f32 = 1600000.0
// A dropped request or connection is tried again after this pause, without a word.
const RETRY_SECONDS: f32 = 3.0
// Glyphs in the display face; the body face carries sentences.
const DISPLAY = Face::Mono

pub struct Profile: Clone + Serialize {
    version: u32,
    key: String,
    name: String,
    game: String,
    motion: bool,
}

enum Pane: Copy + Eq { Games, Saves, Settings }

enum PlayIntent: Copy + Eq { Selected, NewGame }

enum PlayPlan: Clone { Start, Prepare { slot: String } }

struct ExportPlan: Clone {
    game: String,
    profile: String,
    slot: String,
}

enum Step: Copy + Eq {
    Idle,
    Open,
    List,
    Prepare,
    Start,
    Frame,
    Show,
    Closed,
    Export,
    Download,
    PickFile,
    Import,
}

enum Action: Copy + Eq {
    Games,
    Settings,
    Continue,
    NewGame,
    Load,
    Export,
    Import,
    SaveProfile,
    Name,
    Game { index: u32 },
    Save { index: u32 },
    Page { first: u32 },
    Retry,
}

// How a focused control shows it: a ring slides to buttons and the settings button; tiles
// and rows light themselves.
enum Kind: Copy + Eq { Button, Tile, Row, Icon }

struct Control: Copy {
    action: Action,
    rect: Rect,
    row: u32,
    kind: Kind,
}

enum Move: Copy + Eq { Left, Right, Up, Down }

// Which hints the footer shows: the last input device used.
enum Input: Copy + Eq { Keys, Pad, Pointer }

struct Cover {
    image: Option<Texture<Rgba8>>,
    // The colour its art lends the room's light.
    tint: vec3,
    // The compressed art, fetched, then decoded by the host (`host::decode_image`).
    load: Option<Pending<u8>>,
    decode: Option<Pending<u8>>,
    requested: bool,
}

pub struct Console {
    fonts: Fonts,
    renderer: Renderer,
    draw: DrawList,
    linear: Sampler,
    blank: Texture<Rgba8>,
    room: Texture<Rgba16Float>,
    // The tesseract: its corners as the room sees it, and its struts and faces.
    room_corners: GpuBuffer<vec4>,
    edges: GpuBuffer<vec4>,
    faces: GpuBuffer<vec4>,
    mark: GpuBuffer<MarkRun>,
    covers: Vec<Cover>,
    placed: Vec<Placed>,
    // The save last chosen in the Load sheet: what Export writes.
    marked: u32,
    // Each game's eased place in the row (`room::row_place`).
    slots: Vec<f32>,
    // The camera's drift toward the pointer.
    sway: vec2,
    reveal: f32,
    sheet: f32,
    sheet_pane: Pane,
    dt: f32,
    ring: Rect,
    ring_alpha: f32,
    catalog_load: Option<Pending<u8>>,
    profile_load: Option<Pending<u8>>,
    profile_write: Option<Pending<u8>>,
    environment: Option<Pending<u8>>,
    // The page's address, read once: a game's name left in it (a reload, a link) is dropped,
    // since the console opens at its library.
    address: Option<Pending<u8>>,
    pending: Option<Pending<u8>>,
    closing: Option<Pending<u8>>,
    // The session answering is for a selection made before.
    stale: bool,
    cards: Vec<Card>,
    selected: u32,
    profile: Profile,
    profile_ready: bool,
    pane: Pane,
    step: Step,
    handle: Option<u32>,
    saves: Vec<SaveInfo>,
    picked: u32,
    prepared_slot: Option<String>,
    wanted_slot: String,
    exporting: Option<ExportPlan>,
    play_intent: Option<PlayIntent>,
    need_open: bool,
    message: String,
    pixel_ratio: f32,
    reduced: bool,
    intro_until: f32,
    focus: Action,
    controls: Vec<Control>,
    shown: Vec<Control>,
    activate: Option<Action>,
    enter: bool,
    input: Input,
    stick: vec2,
    clicked: Option<vec2>,
    pressed: Option<vec2>,
    // Where the pointer is (logical pixels), what it is over, and the cursor shown for it.
    pointer: Option<vec2>,
    hover: Option<Action>,
    // What glows (`glow`), and how far it has come on.
    glowing: Option<Action>,
    glow: f32,
    // The game whose title shows, and how far it has eased in (out, while another is chosen).
    title_shown: u32,
    title_in: f32,
    pointing: bool,
    cursor: Option<Pending<u8>>,
    // Whether this page load reloaded the tab, from the environment: a reload starts at the
    // library, and a visit plays the opening. The clock waits for the answer, briefly, in the
    // dark.
    reloaded: Option<bool>,
    decided: bool,
    waited: f32,
    // The games' files, fetched ahead of time once the library has settled
    // (`prefetch_games`): how many games are done, counting from which, and what is pending.
    prefetched: u32,
    prefetch_from: Option<u32>,
    prefetch_list: Option<Pending<u8>>,
    prefetching: Option<Pending<u8>>,
    // The room's light: the colour of the selected game's art, and how far it takes it.
    tint: vec4,
    // The page's icons, asked for once.
    icons: Vec<Pending<u8>>,
    retry_at: f32,
    zoom: f32,
    time: Option<f32>,
    presentation: f32,
}

// Asks the host to show the console's icons in the page's tab, bookmarks and home screen. A
// host without a page (the native one) declines, and nothing waits on it.
fn page_icons() -> Vec<Pending<u8>> {
    var out: Vec<Pending<u8>> = Vec::new()
    for i in 0..icon::ICONS.len() {
        let size = icon::SIZES[i]
        let rel = if size >= 180 { "apple-touch-icon" } else { "icon" }
        out.push(host::icon(rel, size, icon::ICONS.path(i).as_str()))
    }
    out
}

pub fn init() -> Console {
    var fonts = Fonts::from_baked(MANROPE, facet::FONT)
    // Manrope set a little closer and a little heavier, so short labels hold together.
    fonts.sans.tracking = -0.012
    fonts.sans.weight = 0.012
    let renderer = Renderer::new(fonts)
    Console {
        fonts,
        renderer,
        draw: DrawList::new(),
        linear: sampler(),
        blank: texture(width: 1, height: 1),
        room: texture(width: 1, height: 1),
        room_corners: buffer(16),
        edges: buffer_of(TESSERACT_EDGES),
        faces: buffer_of(TESSERACT_FACES),
        mark: buffer_of(MARK_RUNS),
        covers: Vec::new(),
        placed: Vec::new(),
        marked: 0,
        slots: Vec::new(),
        sway: vec2(0.0),
        reveal: 0.0,
        sheet: 0.0,
        sheet_pane: Pane::Saves,
        dt: 0.0,
        ring: Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0),
        ring_alpha: 0.0,
        catalog_load: Some(fetch("catalog.tsv")),
        profile_load: Some(read_file("console/profile")),
        profile_write: None,
        environment: Some(host::environment()),
        address: Some(host::address()),
        pending: None,
        closing: None,
        stale: false,
        cards: Vec::new(),
        selected: 0,
        profile: Profile {
            version: 1,
            key: String::from("player-1"),
            name: String::from("Player 1"),
            game: String::new(),
            motion: true,
        },
        profile_ready: false,
        pane: Pane::Games,
        step: Step::Idle,
        handle: None,
        saves: Vec::new(),
        picked: 0,
        prepared_slot: None,
        wanted_slot: String::new(),
        exporting: None,
        play_intent: None,
        need_open: false,
        message: String::new(),
        pixel_ratio: 1.0,
        reduced: false,
        intro_until: OPENING_SECONDS,
        focus: Action::Game { index: 0 },
        controls: Vec::new(),
        shown: Vec::new(),
        activate: None,
        enter: false,
        input: Input::Keys,
        stick: vec2(0.0),
        clicked: None,
        pressed: None,
        pointer: None,
        hover: None,
        glowing: None,
        glow: 0.0,
        title_shown: 0,
        title_in: 1.0,
        pointing: false,
        cursor: None,
        reloaded: None,
        decided: false,
        waited: 0.0,
        prefetched: 0,
        prefetch_from: None,
        prefetch_list: None,
        prefetching: None,
        tint: vec4(1.0, 1.0, 1.0, 0.0),
        icons: page_icons(),
        retry_at: 0.0,
        zoom: 1.0,
        time: None,
        presentation: 0.0,
    }
}

fn poll(pending: mut Option<Pending<u8>>) -> Option<Result<Vec<u8>, std::io::IoError>> {
    var answer = None
    match mut pending {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if answer.is_some() { pending = None }
    answer
}

fn call(s: mut Console, request: Request, step: Step) {
    let Some(id) = s.handle else { return }
    let bytes = save(request)
    s.pending = Some(host::send(id, bytes))
    s.step = step
}

fn list(s: mut Console) {
    let request = Request::List { profile: s.profile.key.clone() }
    call(mut s, request, Step::List)
}

fn prepare_game(s: mut Console, slot: String) {
    s.wanted_slot = slot.clone()
    let request = Request::Prepare { profile: s.profile.key.clone(), slot: slot.clone() }
    call(mut s, request, Step::Prepare)
}

fn start(s: mut Console) {
    call(mut s, Request::Start, Step::Start)
}

// A queued play always uses the latest explicit selection, even if a different slot finishes preparing.
fn play_plan(
    prepared: Option<String>,
    saves: [SaveInfo],
    picked: u32,
    intent: PlayIntent,
) -> PlayPlan {
    let slot = if intent == PlayIntent::NewGame || saves.len() == 0 { String::new() } else {
        saves[min(picked, saves.len() - 1)].slot.clone()
    }
    if let Some(ready) = prepared { if ready == slot { return PlayPlan::Start } }
    PlayPlan::Prepare { slot }
}

fn fulfill_play(s: mut Console) {
    let Some(intent) = s.play_intent else { return }
    if s.step != Step::Idle || s.closing.is_some() || s.cards.is_empty() { return }
    if s.handle.is_none() {
        s.need_open = true
        return
    }
    match play_plan(s.prepared_slot, s.saves, s.picked, intent) {
        PlayPlan::Start => start(mut s),
        PlayPlan::Prepare { slot } => prepare_game(mut s, slot.clone()),
    }
}

// Whether the console is only reading the selection's saves, so another may be selected: not
// while a game starts or shows, or a save moves.
fn browsing(step: Step) -> bool {
    step == Step::Idle || step == Step::Open || step == Step::List || step == Step::Prepare
}

// Drops the session of a selection made before, once its answer is in: `id` if it opened.
fn abandon(s: mut Console, id: Option<u32>) {
    s.stale = false
    s.step = Step::Idle
    s.prepared_slot = None
    match id {
        Some(id) => s.closing = Some(host::close(id)),
        None => s.need_open = true,
    }
    s.handle = None
}

fn open_selected(s: mut Console) {
    if s.cards.is_empty() { return }
    s.message.clear()
    s.saves.clear()
    s.picked = 0
    s.prepared_slot = None
    s.profile.game = s.cards[s.selected].id.clone()
    let bytes = save(s.profile)
    s.profile_write = Some(store("console/profile", bytes))
    s.pending = Some(host::open(s.cards[s.selected].session))
    s.step = Step::Open
    s.need_open = false
}

fn failed(s: mut Console, message: str) {
    s.message = message.to_string()
    s.play_intent = None
    s.step = Step::Idle
    s.prepared_slot = None
    s.exporting = None
}

// A dropped request or a connection that fails is tried again after a pause: nothing to
// read, nothing to press.
fn quietly_retry(s: mut Console) {
    s.play_intent = None
    s.step = Step::Idle
    s.prepared_slot = None
    s.exporting = None
    if let Some(id) = s.handle { s.closing = Some(host::close(id)) }
    s.handle = None
    s.need_open = false
    s.retry_at = s.presentation + RETRY_SECONDS
}

// A quiet retry reopens the session once its pause is over and the old one has closed.
fn retry_due(at: f32, now: f32, closing: bool) -> bool {
    at > 0.0 && now >= at && !closing
}

fn export_plan(game: str, profile: str, slot: str) -> ExportPlan {
    ExportPlan { game: game.to_string(), profile: profile.to_string(), slot: slot.to_string() }
}

fn export_name(plan: ExportPlan) -> String {
    f"wrela-{plan.game}-{plan.profile}-{plan.slot}.wrela-save"
}

fn answer(s: mut Console, bytes: take Vec<u8>) {
    if s.stale {
        let id = if s.step == Step::Open { host::read_surface(bytes) } else { s.handle }
        abandon(mut s, id)
        return
    }
    match s.step {
        Step::Open => {
            let Some(id) = host::read_surface(bytes) else {
                quietly_retry(mut s)
                return
            }
            s.handle = Some(id)
            list(mut s)
        },
        Step::List | Step::Prepare | Step::Start | Step::Export | Step::Import => {
            let result: Result<Reply, LoadError> = load(bytes.clone())
            let Ok(reply) = result else {
                failed(mut s, "The game sent an unsupported response.")
                return
            }
            match reply {
                Reply::Error { message } => failed(mut s, message),
                Reply::Saves { entries } => {
                    if entries.len() > 256 {
                        failed(mut s, "The game sent too many saves.")
                        return
                    }
                    for entry in entries {
                        if !valid_key(entry.slot) ||
                            entry.label.len() > 160 ||
                            entry.description.len() > 512 {
                            failed(mut s, "The game sent unsupported save details.")
                            return
                        }
                    }
                    s.saves = entries.clone()
                    s.picked = 0
                    let slot = if s.saves.is_empty() { String::new() } else {
                        s.saves[0].slot.clone()
                    }
                    prepare_game(mut s, slot)
                },
                Reply::Ready => {
                    s.prepared_slot = Some(s.wanted_slot.clone())
                    s.step = Step::Idle
                },
                Reply::Started => {
                    let Some(id) = s.handle else { return }
                    s.pending = Some(host::wait_ready(id))
                    s.step = Step::Frame
                },
                Reply::Exported { bytes } => {
                    let Some(plan) = s.exporting else {
                        failed(mut s, "The game sent an unsupported response.")
                        return
                    }
                    let name = export_name(plan)
                    s.pending = Some(host::export_file(name, bytes))
                    s.exporting = None
                    s.step = Step::Download
                },
                Reply::Imported => {
                    s.message = String::from("Save imported.")
                    list(mut s)
                },
            }
        },
        Step::Frame => {
            let Some(id) = s.handle else { return }
            s.pending = Some(host::show(id, s.profile.game))
            // Keep the closure request alive before the host suspends this console.
            s.closing = Some(host::wait_closed(id))
            s.step = Step::Show
        },
        Step::Show => {
            s.step = Step::Closed
            s.play_intent = None
        },
        Step::Download => {
            s.step = Step::Idle
            s.message = String::from("Save exported.")
        },
        Step::PickFile => {
            let request = Request::Import { profile: s.profile.key.clone(), bytes }
            call(mut s, request, Step::Import)
        },
        _ => s.step = Step::Idle,
    }
}

fn catalog_result(bytes: Vec<u8>) -> Result<Vec<Card>, String> {
    if let Some(text) = String::from_utf8(bytes.clone()) {
        if let Some(cards) = parse(text) {
            return Ok(cards.clone())
        } else { return Err(String::from("The game library could not be read.")) }
    }
    Err(String::from("The game library could not be read."))
}

// Albums within reach of the selection hold textures and requests: enough for a full row.
const COVER_REACH: u32 = 6

// The colour a cover's art lends the light: its colourful, bright parts averaged, at full
// brightness. Grey art lends white.
fn palette(bytes: Vec<u8>, width: u32, height: u32) -> vec3 {
    var sum = vec3(0.0)
    var weight = 0.0
    for y in 0..height / 4 {
        for x in 0..width / 4 {
            let i = (y * 4 * width + x * 4) * 4
            let c = vec3(f32(bytes[i]), f32(bytes[i + 1]), f32(bytes[i + 2])) / 255.0
            let top = max(c.x, max(c.y, c.z))
            let w = (top - min(c.x, min(c.y, c.z))) * top
            sum += c * w
            weight += w
        }
    }
    let top = max(sum.x, max(sum.y, sum.z))
    if top <= 0.0 { vec3(1.0) } else { sum / top }
}

fn near_cover(index: u32, selected: u32) -> bool {
    if index >= selected { index - selected <= COVER_REACH } else {
        selected - index <= COVER_REACH
    }
}

fn update(s: mut Console) {
    if let Some(Ok(bytes)) = poll(mut s.address) {
        // The answer to the replacement is empty, so this happens once.
        if let Some(kept) = without_fragment(bytes) {
            s.address = Some(host::replace_address(kept.as_str()))
        }
    }
    if let Some(result) = poll(mut s.environment) {
        s.reloaded = Some(false)
        if let Ok(bytes) = result {
            let env = host::read_environment(bytes)
            if !bytes.is_empty() { s.reduced = env.reduced_motion }
            s.reloaded = Some(env.reloaded)
            if let Some(ratio) = env.pixel_ratio { s.pixel_ratio = clamp(ratio, 0.5, 4.0) }
        }
    }
    if let Some(result) = poll(mut s.profile_load) {
        s.profile_ready = true
        if let Ok(bytes) = result {
            let profile: Result<Profile, LoadError> = load(bytes.clone())
            if let Ok(p) = profile {
                if p.version == 1 && valid_key(p.key) && p.name.len() <= 160 {
                    s.profile = p.clone()
                }
            }
        }
    }
    if let Some(result) = poll(mut s.catalog_load) {
        match result {
            Ok(bytes) => match catalog_result(bytes) {
                Ok(cards) => {
                    s.cards = cards.clone()
                    for _ in 0..cards.len() {
                        s.covers.push(
                            Cover {
                                image: None,
                                tint: vec3(1.0),
                                load: None,
                                decode: None,
                                requested: false,
                            },
                        )
                    }
                    s.need_open = true
                },
                Err(message) => s.message = message.clone(),
            },
            Err(_) => s.message = String::from(
                "The game library could not load. Check your connection and reload.",
            ),
        }
    }
    if s.need_open && s.profile_ready && s.step == Step::Idle {
        for i in 0..s.cards.len() { if s.cards[i].id == s.profile.game { s.selected = i } }
        open_selected(mut s)
    }
    // Only albums near the selection hold textures or requests.
    for i in 0..s.covers.len() {
        let visible = near_cover(i, s.selected)
        if !visible {
            s.covers[i].image = None
            s.covers[i].load = None
            s.covers[i].decode = None
            s.covers[i].requested = false
            continue
        }
        if !s.covers[i].requested {
            s.covers[i].load = Some(fetch(s.cards[i].cover))
            s.covers[i].requested = true
        }
        if let Some(result) = poll(mut s.covers[i].load) {
            if let Ok(bytes) = result {
                let card = s.cards[i].clone()
                s.covers[i].decode = Some(host::decode_image(bytes, card.width, card.height))
            }
        }
        if let Some(result) = poll(mut s.covers[i].decode) {
            if let Ok(bytes) = result {
                let card = s.cards[i].clone()
                // The host decodes only art of the size the catalog says.
                if bytes.len() == card.width * card.height * 4 {
                    s.covers[i].tint = palette(bytes, card.width, card.height)
                    var image = texture::<Rgba8>(width: card.width, height: card.height)
                    image.write(x: 0, y: 0, width: card.width, height: card.height, bytes: bytes)
                    s.covers[i].image = Some(take image)
                }
            }
        }
    }
    if let Some(result) = poll(mut s.profile_write) {
        if result.is_err() {
            s.message = String::from("Your profile could not be saved on this device.")
        }
    }
    if let Some(result) = poll(mut s.pending) {
        match result {
            Ok(bytes) => answer(mut s, bytes.clone()),
            Err(_) => if s.stale {
                let id = s.handle
                abandon(mut s, id)
            } else { quietly_retry(mut s) },
        }
    }
    if poll(mut s.closing).is_some() {
        // A game that was starting or playing has closed; a session closed only to change the
        // selection keeps a play already asked of the new one.
        if s.step != Step::Idle { s.play_intent = None }
        s.handle = None
        s.step = Step::Idle
        s.need_open = s.retry_at == 0.0
    }
    if retry_due(s.retry_at, s.presentation, s.closing.is_some()) {
        s.retry_at = 0.0
        s.need_open = true
    }
    let _ = poll(mut s.cursor)
    fulfill_play(mut s)
}

fn open_pane(s: mut Console, pane: Pane) {
    s.pane = pane
    s.focus = match pane {
        Pane::Games => Action::Game { index: s.selected },
        Pane::Saves => if s.saves.is_empty() { Action::Import } else { Action::Save { index: 0 } },
        Pane::Settings => Action::Name,
    }
}

fn play(s: mut Console, intent: PlayIntent) {
    if s.cards.is_empty() { return }
    s.play_intent = Some(intent)
    fulfill_play(mut s)
}

// The selected title's actions: Continue, New and Load once there are saves; only New before.
fn actions(has_saves: bool) -> Vec<Action> {
    var out: Vec<Action> = Vec::new()
    if has_saves { out.push(Action::Continue) }
    out.push(Action::NewGame)
    if has_saves { out.push(Action::Load) }
    out
}

fn act(s: mut Console, action: Action) {
    match action {
        Action::Games => open_pane(mut s, Pane::Games),
        Action::Load => open_pane(mut s, Pane::Saves),
        Action::Settings => {
            let pane = if s.pane == Pane::Settings { Pane::Games } else { Pane::Settings }
            open_pane(mut s, pane)
        },
        Action::Name => {},
        Action::SaveProfile => {
            if s.profile.name.trim().is_empty() {
                s.message = String::from("Enter a name for this profile.")
                return
            }
            let bytes = save(s.profile)
            s.profile_write = Some(store("console/profile", bytes))
            s.message = String::from("Profile saved.")
        },
        Action::Game { index } => {
            // The selected album's own action is to play it: continue, or begin.
            if index == s.selected {
                act(mut s, if s.saves.is_empty() { Action::NewGame } else { Action::Continue })
                return
            }
            if !browsing(s.step) { return }
            s.selected = index
            s.profile.game = s.cards[index].id.clone()
            s.saves.clear()
            s.play_intent = None
            s.retry_at = 0.0
            // A session still answering is the last selection's: it is closed when it answers,
            // and one closing already opens the selection's when it has closed.
            if s.step != Step::Idle {
                s.stale = true
            } else if s.closing.is_none() {
                s.need_open = s.handle.is_none()
                if let Some(id) = s.handle { s.closing = Some(host::close(id)) }
                s.handle = None
            }
        },
        // Loading a save plays it.
        Action::Save { index } => {
            if index != s.picked { s.prepared_slot = None }
            s.picked = index
            play(mut s, PlayIntent::Selected)
        },
        // Continue plays the most recent save; with none there is only a new game.
        Action::Continue => {
            if s.saves.is_empty() {
                play(mut s, PlayIntent::NewGame)
                return
            }
            if s.picked != 0 { s.prepared_slot = None }
            s.picked = 0
            play(mut s, PlayIntent::Selected)
        },
        Action::NewGame => play(mut s, PlayIntent::NewGame),
        Action::Page { first } => {
            s.marked = first
            s.focus = Action::Save { index: first }
        },
        Action::Export => {
            if s.step == Step::Idle && !s.saves.is_empty() {
                let plan = export_plan(
                    s.cards[s.selected].id,
                    s.profile.key,
                    s.saves[min(s.marked, s.saves.len() - 1)].slot,
                )
                s.exporting = Some(plan.clone())
                let request = Request::Export {
                    profile: plan.profile.clone(),
                    slot: plan.slot.clone(),
                }
                call(mut s, request, Step::Export)
            }
        },
        Action::Import => {
            if s.step == Step::Idle {
                s.pending = Some(host::import_file())
                s.step = Step::PickFile
            }
        },
        Action::Retry => {
            if s.step == Step::Idle && s.closing.is_none() {
                s.need_open = s.handle.is_none()
                if let Some(id) = s.handle { s.closing = Some(host::close(id)) }
                s.handle = None
            }
        },
    }
}

// ---- focus ---------------------------------------------------------------------------------

// The control a move reaches from `from`: across its row, or to the first control of the
// next row in that direction. Rows are counted top to bottom.
fn neighbour(controls: [Control], from: Action, to: Move) -> Option<Action> {
    let dx = match to {
        Move::Left => -1,
        Move::Right => 1,
        _ => 0,
    }
    let dy = match to {
        Move::Up => -1,
        Move::Down => 1,
        _ => 0,
    }
    var at = None
    for c in controls { if c.action == from { at = Some(c) } }
    let Some(here) = at else {
        if controls.len() == 0 { return None }
        return Some(controls[0].action)
    }
    let centre = here.rect.center()
    var best: Option<Action> = None
    var score = 1.0e9
    if dx != 0 {
        for c in controls {
            let ahead = (c.rect.center().x - centre.x) * f32(dx)
            if c.row == here.row && ahead > 1.0 && ahead < score {
                score = ahead
                best = Some(c.action)
            }
        }
        return best
    }
    var row = -1
    for c in controls {
        let gap = (i32(c.row) - i32(here.row)) * dy
        if gap > 0 && (row < 0 || gap < row) { row = gap }
    }
    if row < 0 { return None }
    // A row is entered at its first control: the main action leads each row.
    for c in controls {
        if (i32(c.row) - i32(here.row)) * dy == row {
            let d = c.rect.x
            if d < score {
                score = d
                best = Some(c.action)
            }
        }
    }
    best
}

fn under(controls: [Control], at: vec2) -> Option<Action> {
    var found = None
    for c in controls { if c.rect.contains(at) { found = Some(c.action) } }
    found
}

fn navigate(s: mut Console, to: Move) {
    let Some(next) = neighbour(s.shown, s.focus, to) else { return }
    s.focus = next
    // Moving along the album row selects the album, as a console does.
    match next {
        Action::Game { index } => if index != s.selected { act(mut s, next) },
        _ => {},
    }
    if s.pane == Pane::Games {
        match next {
            Action::Game { .. } => s.focus = Action::Game { index: s.selected },
            _ => {},
        }
    }
}

fn control(s: mut Console, action: Action, r: Rect, row: u32, kind: Kind) -> bool {
    s.controls.push(Control { action, rect: r, row, kind })
    let clicked = match (s.clicked, s.pressed) {
        (Some(up), Some(down)) => r.contains(up / s.zoom) && r.contains(down / s.zoom),
        _ => false,
    }
    let focus = s.focus == action
    if s.reveal > 0.95 && s.activate.is_none() && ((focus && s.enter) || clicked) {
        s.activate = Some(action)
    }
    lit(s, action)
}

// Which control shows as chosen: the one under the pointer while the pointer is in use,
// otherwise the one with focus.
fn lit(s: Console, action: Action) -> bool {
    if s.input == Input::Pointer { s.hover == Some(action) } else { s.focus == action }
}

// ---- drawing -------------------------------------------------------------------------------

fn text(s: mut Console, content: str, size: f32, at: vec2, color: vec4, face: Face = Face::Sans) {
    // Glyphs start on a whole device pixel, as a browser lays out text.
    let _ = s.draw.text(
        s.fonts,
        face,
        content,
        size * s.zoom,
        vec2(round(at.x * s.zoom), at.y * s.zoom),
        vec4(color.xyz, color.w * s.reveal),
    )
}

// A logical rectangle on whole device pixels: its edges, not its size, are rounded, so
// neighbouring shapes meet exactly and every edge is crisp.
fn snapped(r: Rect, zoom: f32) -> Rect {
    let x0 = round(r.x * zoom)
    let y0 = round(r.y * zoom)
    Rect::new(x0, y0, round(r.right() * zoom) - x0, round(r.bottom() * zoom) - y0)
}

fn ring(s: mut Console, r: Rect, color: vec4, radius: f32 = 0.0, width: f32 = 1.0) {
    s.draw.ring(
        snapped(r, s.zoom),
        vec4(color.xyz, color.w * s.reveal),
        radius: radius * s.zoom,
        width: max(round(width * s.zoom), 1.0),
    )
}

fn width_of(s: Console, content: str, size: f32, face: Face) -> f32 {
    s.fonts.font(face).measure(content, size)
}

// The size at most `size` that fits `content` in `room`.
fn fitted(s: Console, content: str, size: f32, room: f32, face: Face) -> f32 {
    min(size, size * room / max(width_of(s, content, size, face), 1.0))
}

fn centered(s: mut Console, content: str, size: f32, x: f32, y: f32, color: vec4, face: Face) {
    let w = width_of(s, content, size, face)
    text(mut s, content, size, vec2(x - w * 0.5, y), color, face)
}

fn rect(s: mut Console, r: Rect, color: vec4, radius: f32 = 0.0) {
    s.draw.rect(snapped(r, s.zoom), vec4(color.xyz, color.w * s.reveal), radius * s.zoom)
}

// Where a line of `face` at `size` starts so that its capitals stand centred on `middle`.
fn line_top(s: Console, face: Face, size: f32, middle: f32) -> f32 {
    let cap = if face == Face::Sans { SANS_CAP } else { facet::CAP }
    middle - (s.fonts.font(face).ascender - cap * 0.5) * size
}

fn button_width(s: Console, label: str) -> f32 {
    max(88.0, width_of(s, label, LABEL, Face::Sans) + 36.0)
}

// A button: the primary one solid, the rest quiet behind a hairline. Under the pointer it
// eases a shade toward the light (`glow`); with keys or a pad the focus ring marks it.
fn button(s: mut Console, action: Action, r: Rect, row: u32, label: str, primary: bool = false) {
    let _ = control(mut s, action, r, row, Kind::Button)
    let hover = if s.input == Input::Pointer { glow(s, action) } else { 0.0 }
    if primary {
        rect(mut s, r, mix(INK, vec4(0.9, 0.9, 0.91, 1.0), hover), RADIUS)
    } else {
        rect(mut s, r, mix(SECONDARY, RAISED, hover), RADIUS)
        ring(mut s, r, BORDER, RADIUS)
    }
    let c = r.center()
    let y = line_top(s, Face::Sans, LABEL, c.y)
    centered(mut s, label, LABEL, c.x, y, if primary { DARK } else { INK }, Face::Sans)
}

// The title showing, and how far it has eased in, `dt` seconds on with `selected` chosen: one
// that isn't the selection's eases out in an eighth of a second, then the selection's eases in
// over three tenths.
fn title_step(shown: u32, eased: f32, selected: u32, dt: f32) -> (u32, f32) {
    if shown == selected { return (shown, min(eased + dt / 0.3, 1.0)) }
    let out = max(eased - dt / 0.12, 0.0)
    if out == 0.0 { (selected, 0.0) } else { (shown, out) }
}

// How far the hover or focus on `action` has come on: from 0 when it arrives to 1 a quarter
// second later, eased, so it settles rather than snaps.
fn glow(s: Console, action: Action) -> f32 {
    if s.glowing == Some(action) { smoothstep(0.0, 1.0, s.glow) } else { 0.0 }
}

// A line `stroke` wide from `a` to `b`, level or upright.
fn stroke(s: mut Console, a: vec2, b: vec2, width: f32) {
    let lo = min(a, b) - vec2(width * 0.5)
    let hi = max(a, b) + vec2(width * 0.5)
    rect(mut s, Rect::new(lo.x, lo.y, hi.x - lo.x, hi.y - lo.y), INK, width * 0.5)
}

// Settings: a quiet square button holding two sliders, as Lucide draws its settings-2 icon
// on a 24-unit grid.
fn settings_button(s: mut Console, r: Rect) {
    let _ = control(mut s, Action::Settings, r, 0, Kind::Icon)
    let hover = if s.input == Input::Pointer { glow(s, Action::Settings) } else { 0.0 }
    let shown = if s.pane == Pane::Settings { 1.0 } else { hover }
    if shown > 0.0 { rect(mut s, r, vec4(RAISED.xyz, RAISED.w * shown), RADIUS) }
    let unit = 20.0 / 24.0
    let o = r.center() - vec2(12.0 * unit)
    let width = 1.75
    stroke(mut s, o + vec2(11.0, 7.0) * unit, o + vec2(20.0, 7.0) * unit, width)
    stroke(mut s, o + vec2(5.0, 17.0) * unit, o + vec2(14.0, 17.0) * unit, width)
    for centre in [vec2(7.0, 7.0), vec2(17.0, 17.0)] {
        let c = o + centre * unit
        let outer = 3.0 * unit + width * 0.5
        let disc = Rect::new(c.x - outer, c.y - outer, outer * 2.0, outer * 2.0)
        ring(mut s, disc, INK, outer, width)
    }
}

fn key_width(s: Console, cap: str) -> f32 {
    max(22.0, width_of(s, cap, 11.0, Face::Sans) + 12.0)
}

// A key hint: the key in a small bordered cap, then what it does. How wide it was.
fn keycap(s: mut Console, at: vec2, cap: str, label: str) -> f32 {
    let w = key_width(s, cap)
    let r = Rect::new(at.x, at.y, w, 22.0)
    rect(mut s, r, SECONDARY, 5.0)
    ring(mut s, r, BORDER, 5.0)
    let middle = r.center().y
    centered(
        mut s,
        cap,
        11.0,
        at.x + w * 0.5,
        line_top(s, Face::Sans, 11.0, middle),
        MUTED,
        Face::Sans,
    )
    text(mut s, label, 13.0, vec2(at.x + w + 8.0, line_top(s, Face::Sans, 13.0, middle)), MUTED)
    w + 8.0 + width_of(s, label, 13.0, Face::Sans) + 24.0
}

fn footer(s: mut Console, w: f32, h: f32, margin: f32) {
    if s.input == Input::Pointer || w < 560.0 { return }
    let (select, back) = if s.input == Input::Pad { ("A", "B") } else { ("Enter", "Esc") }
    let hints = if s.pane == Pane::Games {
        [(select, "Select"), ("< >", "Browse"), (back, "Back")]
    } else { [(select, "Select"), ("^ v", "Move"), (back, "Close")] }
    var total = -24.0
    for hint in hints {
        total += key_width(s, hint.0) + 8.0 + width_of(s, hint.1, 13.0, Face::Sans) + 24.0
    }
    var x = w - margin - total
    for hint in hints { x += keycap(mut s, vec2(x, h - 46.0), hint.0, hint.1) }
}

fn status(s: Console) -> String {
    if !s.message.is_empty() { return s.message.clone() }
    match s.step {
        Step::Start | Step::Frame | Step::Show => String::from("Opening game"),
        Step::PickFile | Step::Import => String::from("Importing save"),
        Step::Export | Step::Download => String::from("Exporting save"),
        _ => String::new(),
    }
}

fn empty_library_message(message: str) -> String {
    if message.is_empty() { String::from("Loading games") } else { message.to_string() }
}

struct Placed: Copy {
    index: u32,
    card: room::Card,
    art: bool,
}

fn action_label(a: Action, opening: bool) -> String {
    if opening { return String::from("Opening") }
    String::from(match a {
        Action::Continue => "Continue",
        Action::NewGame => "New",
        Action::Load => "Load",
        _ => "",
    })
}

// The library: cards in the room (drawn by the GPU) in a row along the bottom, and above the
// selection, from its left edge, its title, its state and its actions.
fn library(s: mut Console, w: f32, h: f32, cam: Camera, rest: Camera, margin: f32) {
    let row = row(rest)
    if s.cards.is_empty() {
        let label = empty_library_message(s.message)
        centered(mut s, label, 15.0, w * 0.5, h * 0.5, MUTED, Face::Sans)
        return
    }
    var slot = Rect::new(margin, h * 0.7, w: 0.0, h: 0.0)
    for i in 0..s.cards.len() {
        if s.slots[i] > 12.0 { continue }
        let art = s.covers[i].image.is_some()
        let target = f32(row_place(i, s.selected, s.cards.len()))
        // Under the pointer, a block's edges brighten, eased in; keys and pads move the
        // selection itself, so it needs no mark of its own.
        let pointing = s.input == Input::Pointer
        let hover = if pointing { glow(s, Action::Game { index: i }) } else { 0.0 }
        let card = place(place: s.slots[i], target: target, hover: hover, has_art: art, row: row)
        let b = bounds(cam, card) / s.zoom
        let r = Rect::new(b.x, b.y, b.z, b.w)
        s.placed.push(Placed { index: i, card, art })
        if i == s.selected { slot = r }
        if !art {
            // No art: the title, set on the card.
            let title = s.cards[i].title.clone()
            let size = fitted(s, title, clamp(r.w * 0.05, 9.0, 20.0), r.w * 0.8, DISPLAY)
            let shade = card.look.x * card.look.z
            text(
                mut s,
                title,
                size,
                vec2(r.x + r.w * 0.08, r.bottom() - r.h * 0.12 - size),
                vec4(INK.xyz, shade),
                DISPLAY,
            )
        }
    }
    // Nearer albums overlap farther ones, so they take the pointer first: the control pushed
    // last wins. Albums fading out at the left show but take no focus.
    for k in depth_order(s.placed) {
        let placed = s.placed[k]
        if placed.card.look.z > 0.5 {
            let b = bounds(cam, placed.card) / s.zoom
            let r = Rect::new(b.x, b.y, b.z, b.w)
            let _ = control(mut s, Action::Game { index: placed.index }, r, 2, Kind::Tile)
        }
    }
    // Choosing another game, its title and state ease out, and the new ones ease in, rising.
    let (shown, eased) = title_step(s.title_shown, s.title_in, s.selected, s.dt)
    s.title_shown = shown
    s.title_in = eased
    if s.reduced || s.reveal < 1.0 || s.title_shown >= s.cards.len() {
        s.title_shown = s.selected
        s.title_in = 1.0
    }
    let fade = smoothstep(0.0, 1.0, s.title_in)
    let lift = (1.0 - fade) * 8.0
    let card = s.cards[s.title_shown].clone()
    let continuing = !s.saves.is_empty()
    // The title and actions hold still at the margin, above where the selection rests, while
    // blocks tumble beneath them.
    // Laid out for the camera at rest, so its drift toward the pointer doesn't move them.
    let still = place(place: 0.0, target: 0.0, hover: 0.0, has_art: true, row: row)
    let resting = bounds(rest, still) / s.zoom
    slot = Rect::new(margin, resting.y, resting.z, resting.w)
    let x = slot.x
    let room = min(w - x - margin, 820.0)
    // From the row up: the actions, the state, the title.
    let top = slot.y - 30.0 - 40.0 - 14.0
    let picked = if continuing { s.saves[0].clone() } else {
        SaveInfo { slot: String::new(), label: String::new(), description: String::new(), saved: 0 }
    }
    let state = status(s)
    let meta = if !state.is_empty() { state.clone() } else if continuing {
        if picked.description.is_empty() { picked.label.clone() } else {
            f"{picked.label}  ·  {picked.description}"
        }
    } else { String::from("Not started") }
    let meta_size = fitted(s, meta, 15.0, room, Face::Sans)
    let meta_middle = top - 26.0
    let tone = if s.message.is_empty() { MUTED } else { WARN }
    text(
        mut s,
        meta,
        meta_size,
        vec2(x, line_top(s, Face::Sans, meta_size, meta_middle) + lift),
        vec4(tone.xyz, tone.w * fade),
    )
    let title_size = fitted(s, card.title, 48.0, room, DISPLAY)
    let title_middle = meta_middle -
        meta_size * SANS_CAP * 0.5 -
        20.0 -
        title_size * facet::CAP * 0.5
    text(
        mut s,
        card.title,
        title_size,
        vec2(x, line_top(s, DISPLAY, title_size, title_middle) + lift),
        vec4(INK.xyz, fade),
        DISPLAY,
    )
    // The actions in a line, the first the main one.
    let acts = actions(continuing)
    var at = x
    for i in 0..acts.len() {
        let a = acts[i]
        let label = action_label(a, s.play_intent.is_some() && i == 0)
        let width = button_width(s, label)
        button(mut s, a, Rect::new(at, top, width, 40.0), 1, label, primary: i == 0)
        at += width + 10.0
    }
    if !s.message.is_empty() {
        button(
            mut s,
            Action::Retry,
            Rect::new(at, top, button_width(s, "Try again"), 40.0),
            1,
            "Try again",
        )
    }
}

fn sheet_frame(s: mut Console, w: f32, h: f32, title: str) -> Rect {
    let open = s.sheet * s.sheet * (3.0 - 2.0 * s.sheet)
    rect(mut s, Rect::new(x: 0.0, y: 0.0, w: w, h: h), vec4(0.0, 0.0, 0.0, 0.6 * open))
    let width = min(w, 440.0)
    let r = Rect::new(w - width * open, 0.0, width, h)
    rect(mut s, r, SHEET)
    rect(mut s, Rect::new(r.x, y: 0.0, w: 1.0, h: h), BORDER)
    if s.pane != Pane::Games { focus_ring(mut s) }
    text(
        mut s,
        title,
        22.0,
        vec2(r.x + 32.0, line_top(s, DISPLAY, size: 22.0, middle: 56.0)),
        INK,
        DISPLAY,
    )
    button(
        mut s,
        Action::Games,
        Rect::new(r.right() - 32.0 - 80.0, y: 38.0, w: 80.0, h: 36.0),
        0,
        "Close",
    )
    r.shrink(32.0)
}

fn save_capacity(height: f32) -> u32 {
    u32(clamp(floor((height - 300.0) / 74.0), 1.0, 6.0))
}

// Load: every save, newest first. Choosing one plays it.
fn saves(s: mut Console, w: f32, h: f32) {
    let panel = sheet_frame(mut s, w, h, "Load")
    let x = panel.x
    let width = panel.w
    let top = 104.0
    if s.cards.is_empty() { return }
    let capacity = save_capacity(h)
    let first = s.marked / capacity * capacity
    let count = min(s.saves.len() - min(first, s.saves.len()), capacity)
    if count == 0 {
        text(mut s, if s.step == Step::Open || s.step == Step::List { "Reading saves" } else {
            "No saves yet"
        }, 14.0, vec2(x, top), MUTED)
    }
    for i in first..first + count {
        let r = Rect::new(x, top + f32(i - first) * 70.0, width, 62.0)
        let chosen = control(mut s, Action::Save { index: i }, r, 1 + i - first, Kind::Row)
        if chosen {
            s.marked = i
            rect(mut s, r, RAISED, RADIUS)
            ring(mut s, r, BORDER, RADIUS)
        }
        let save = s.saves[i].clone()
        let label_size = fitted(s, save.label, 15.0, width - 32.0, Face::Sans)
        text(mut s, save.label, label_size, vec2(r.x + 16.0, r.y + 12.0), INK)
        let size = fitted(s, save.description, 13.0, width - 32.0, Face::Sans)
        text(mut s, save.description, size, vec2(r.x + 16.0, r.y + 35.0), MUTED)
    }
    var y = top + f32(max(count, 1)) * 70.0 + 14.0
    let row = 2 + capacity
    if s.saves.len() > capacity {
        let next = if first + capacity < s.saves.len() { first + capacity } else { 0 }
        button(mut s, Action::Page { first: next }, Rect::new(x, y, width, 38.0), row, "More saves")
        y += 50.0
    }
    let cell = (width - 10.0) * 0.5
    button(mut s, Action::Export, Rect::new(x, y, cell, 38.0), row + 1, "Export")
    button(mut s, Action::Import, Rect::new(x + cell + 10.0, y, cell, 38.0), row + 1, "Import")
    let state = status(s)
    if !state.is_empty() {
        let size = fitted(s, state, 13.0, width, Face::Sans)
        text(mut s, state, size, vec2(x, y + 58.0), MUTED)
    }
}

fn settings(s: mut Console, w: f32, h: f32) {
    let panel = sheet_frame(mut s, w, h, "Settings")
    let x = panel.x
    let width = panel.w
    text(mut s, "Profile name", 13.0, vec2(x, 110.0), MUTED)
    let field = Rect::new(x, 134.0, width, 44.0)
    let editing = control(mut s, Action::Name, field, 1, Kind::Row)
    rect(mut s, field, vec4(1.0, 1.0, 1.0, 0.03), RADIUS)
    if editing {
        // As an input shows focus: a brighter border inside a soft ring.
        ring(mut s, field.shrink(-3.0), vec4(1.0, 1.0, 1.0, 0.16), RADIUS + 3.0, 3.0)
        ring(mut s, field, vec4(1.0, 1.0, 1.0, 0.55), RADIUS)
    } else { ring(mut s, field, INPUT, RADIUS) }
    let name = s.profile.name.clone()
    let size = fitted(s, name, 15.0, width - 32.0, Face::Sans)
    let middle = field.center().y
    text(mut s, name, size, vec2(x + 14.0, line_top(s, Face::Sans, size, middle)), INK)
    let blink = fract(s.presentation * 1.1) < 0.6
    if editing && blink {
        let caret = x + 15.0 + width_of(s, name, size, Face::Sans)
        rect(mut s, Rect::new(caret, middle - 9.0, w: 1.5, h: 18.0), INK)
    }
    button(
        mut s,
        Action::SaveProfile,
        Rect::new(x, y: 194.0, w: 120.0, h: 38.0),
        2,
        "Save",
        primary: true,
    )
    let state = status(s)
    if !state.is_empty() { text(mut s, state, 13.0, vec2(x, 252.0), MUTED) }
}

// The focus ring, with keys or a pad: a ring just outside the focused button, sliding from one
// to the next.
fn focus_ring(s: mut Console) {
    let dt = s.dt
    var target: Option<Rect> = None
    if s.input != Input::Pointer {
        for c in s.shown {
            if lit(s, c.action) && (c.kind == Kind::Button || c.kind == Kind::Icon) {
                target = Some(c.rect)
            }
        }
    }
    let k = if s.reduced { 1.0 } else { 1.0 - exp(-dt * 22.0) }
    match target {
        Some(r) => {
            if s.ring_alpha < 0.01 { s.ring = r }
            s.ring = Rect::new(
                mix(s.ring.x, r.x, k),
                mix(s.ring.y, r.y, k),
                mix(s.ring.w, r.w, k),
                mix(s.ring.h, r.h, k),
            )
            s.ring_alpha = mix(s.ring_alpha, 1.0, k)
        },
        None => s.ring_alpha = mix(s.ring_alpha, 0.0, k),
    }
    if s.ring_alpha < 0.01 { return }
    let r = s.ring.shrink(-3.0)
    ring(mut s, r, vec4(1.0, 1.0, 1.0, 0.9 * s.ring_alpha), RADIUS + 3.0, 2.0)
}

fn header(s: mut Console, w: f32, margin: f32) {
    settings_button(mut s, Rect::new(w - margin - 40.0, y: 22.0, w: 40.0, h: 40.0))
}

pub fn frame(s: mut Console, time: f32, width: u32, height: u32) {
    let dt = presentation_step(s.time, time)
    s.time = Some(time)
    update(mut s)
    if !s.decided {
        s.waited += dt
        if s.reloaded.is_some() || s.waited > 0.5 { decide_opening(mut s) }
    } else { s.presentation += dt }
    s.dt = dt
    s.zoom = s.pixel_ratio * clamp(f32(height) / s.pixel_ratio / 720.0, 0.7, 1.0)
    let w = f32(width) / s.zoom
    let h = f32(height) / s.zoom
    // Motion follows the system's reduced-motion setting alone.
    let motion = !s.reduced
    let was_opening = motion && s.presentation < s.intro_until
    s.enter = false
    s.clicked = None
    s.activate = None
    for event in events() {
        match event {
            Event::PointerMove { at, .. } => {
                s.pointer = Some(at / s.zoom)
                s.input = Input::Pointer
            },
            Event::PointerDown { at, button: Button::Primary, .. } => {
                s.pointer = Some(at / s.zoom)
                s.pressed = Some(at)
                s.intro_until = 0.0
                s.input = Input::Pointer
            },
            Event::PointerUp { at, button: Button::Primary, .. } => {
                s.clicked = Some(at)
                s.intro_until = 0.0
                s.input = Input::Pointer
            },
            Event::KeyDown { key, repeat, mods } => {
                s.input = Input::Keys
                s.intro_until = 0.0
                if key == Key::Enter && !repeat { s.enter = true }
                if key == Key::Right { navigate(mut s, Move::Right) }
                if key == Key::Left { navigate(mut s, Move::Left) }
                if key == Key::Down || (key == Key::Tab && !mods.shift) {
                    navigate(mut s, Move::Down)
                }
                if key == Key::Up || (key == Key::Tab && mods.shift) { navigate(mut s, Move::Up) }
                if key == Key::Escape { open_pane(mut s, Pane::Games) }
                if s.pane == Pane::Settings && key == Key::A && mods.command() {
                    s.profile.name.clear()
                }
                if s.pane == Pane::Settings && key == Key::Backspace {
                    let end = previous(s.profile.name, s.profile.name.len())
                    s.profile.name.truncate(end)
                }
            },
            Event::Text { char } => {
                if s.pane == Pane::Settings && s.profile.name.len() < 120 && char >= 32 {
                    s.profile.name.push_char(char)
                }
            },
            Event::PadButton { button, pressed: true, .. } => {
                s.input = Input::Pad
                s.intro_until = 0.0
                if button == PadButton::South { s.enter = true }
                if button == PadButton::East { open_pane(mut s, Pane::Games) }
                if button == PadButton::Start { act(mut s, Action::Settings) }
                if button == PadButton::Right { navigate(mut s, Move::Right) }
                if button == PadButton::Left { navigate(mut s, Move::Left) }
                if button == PadButton::Down { navigate(mut s, Move::Down) }
                if button == PadButton::Up { navigate(mut s, Move::Up) }
            },
            Event::PadAxis { axis, value, .. } => {
                // The left stick moves once each time it leaves the middle.
                let old = s.stick
                if axis == PadAxis::LeftX { s.stick.x = value }
                if axis == PadAxis::LeftY { s.stick.y = value }
                if abs(old.x) < 0.6 && abs(s.stick.x) >= 0.6 {
                    s.input = Input::Pad
                    navigate(mut s, if s.stick.x > 0.0 { Move::Right } else { Move::Left })
                }
                if abs(old.y) < 0.6 && abs(s.stick.y) >= 0.6 {
                    s.input = Input::Pad
                    navigate(mut s, if s.stick.y > 0.0 { Move::Down } else { Move::Up })
                }
            },
            _ => {},
        }
    }
    if was_opening {
        s.enter = false
        s.clicked = None
        s.pressed = None
    }
    // What the pointer is over, by where things were drawn last frame.
    s.hover = match s.pointer {
        Some(p) => under(s.shown, p),
        None => None,
    }
    // What the pointer is over, or with keys or a pad what has focus, glows in from nothing.
    let glowing = if s.input == Input::Pointer { s.hover } else { Some(s.focus) }
    if glowing != s.glowing {
        s.glowing = glowing
        s.glow = 0.0
    }
    s.glow = if s.reduced { 1.0 } else { min(s.glow + dt / 0.25, 1.0) }
    let intro = motion && s.presentation < s.intro_until
    let phase = moment(s.presentation, intro)
    // Nothing is fetched ahead of time until the opening is over and the library has come up,
    // so it never slows the console's own start.
    if phase.settled && phase.library >= 1.0 { prefetch_games(mut s) }
    s.reveal = phase.library
    let ease = |rate: f32| -> f32 { if motion { 1.0 - exp(-dt * rate) } else { 1.0 } }
    // Each game eases to its place in the row: slow enough to see the chosen block tumble
    // forward and the one it leaves tumble back. Until the library shows, they stand there.
    let count = s.cards.len()
    if s.slots.len() != count { s.slots = Vec::filled(count, 0.0) }
    for i in 0..count {
        let target = f32(row_place(i, s.selected, count))
        s.slots[i] = if phase.library == 0.0 { target } else { mix(s.slots[i], target, ease(5.0)) }
    }
    // Focus on the album row follows the selection, wherever the selection came from.
    match s.focus {
        Action::Game { index } => if index != s.selected {
            s.focus = Action::Game { index: s.selected }
        },
        _ => {},
    }
    s.sheet = mix(s.sheet, if s.pane == Pane::Games { 0.0 } else { 1.0 }, ease(14.0))
    // The camera leans a little toward the pointer, and breathes when nothing moves it. It
    // holds still through the opening's title, and takes up its lean in the dark after it.
    let toward = match s.pointer {
        Some(p) => vec2(p.x / w * 2.0 - 1.0, p.y / h * 2.0 - 1.0),
        None => vec2(0.0),
    }
    let breath = vec2(sin(s.presentation * 0.21), sin(s.presentation * 0.13) * 0.6) * 0.3
    let lean = if motion { toward * 0.7 + breath } else { vec2(0.0) }
    s.sway = if intro && !phase.settled { vec2(0.0) } else if intro && phase.library == 0.0 {
        lean
    } else {
        mix(s.sway, lean, ease(2.0))
    }
    let screen = vec2(f32(width), f32(height))
    let cam = camera(screen, s.sway)
    // The layout is fitted to the camera at rest, so the sway moves the cards against the
    // far artifact.
    let rest = camera(screen, vec2(0.0))
    let margin = w * MARGIN
    s.draw.clear(screen)
    s.controls.clear()
    s.placed.clear()
    if s.pane != Pane::Games { s.sheet_pane = s.pane }
    if phase.library > 0.0 {
        let games = s.pane == Pane::Games
        if games { focus_ring(mut s) }
        header(mut s, w, margin)
        library(mut s, w, h, cam, rest, margin)
        if games { footer(mut s, w, h, margin) }
        // A sheet takes the controls; the library behind it only shows. A closing sheet
        // only shows too.
        if !games { s.controls.clear() }
        if s.sheet > 0.01 {
            let before = s.controls.len()
            match s.sheet_pane {
                Pane::Saves => saves(mut s, w, h),
                Pane::Settings => settings(mut s, w, h),
                Pane::Games => {},
            }
            if games { s.controls.truncate(before) } else { footer(mut s, w, h, margin) }
        }
    }
    // Over anything it can press, the pointer becomes a hand.
    let over = match s.pointer {
        Some(p) => under(s.controls, p).is_some(),
        None => false,
    }
    if over != s.pointing {
        s.pointing = over
        s.cursor = Some(host::cursor(if over { "pointer" } else { "default" }))
    }
    s.renderer.upload(s.draw)
    // The artifact, where the opening or the room has it, traced for the room's camera.
    let place = artifact_place(phase, artifact_spot(rest))
    let size = traced_size(width, height, TRACED_PIXELS)
    if s.room.width() != size.0 || s.room.height() != size.1 {
        s.room = texture(width: size.0, height: size.1)
    }
    let target = vec2(f32(size.0), f32(size.1))
    let turn = if motion { turn_at(s.presentation, opening: intro) } else { 2.0 }
    let verts = corners(turn, place.xyz, place.w)
    // The room's light takes the colour of the selected game's art as the library comes up,
    // and eases to the next as the selection changes. The opening stays white.
    let wanted = if !s.cards.is_empty() && s.covers[s.selected].image.is_some() {
        vec4(s.covers[s.selected].tint, phase.library)
    } else { vec4(s.tint.xyz, 0.0) }
    s.tint = if s.tint.w == 0.0 { vec4(wanted.xyz, 0.0) } else { s.tint }
    s.tint = mix(s.tint, wanted, ease(2.5))
    write(mut s.room_corners, 0, verts)
    let space = begin_pass(mut s.room, clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        space,
        quad.bind(target, rect: vec4(0.0, 0.0, target)),
        artifact.bind(
            verts: s.room_corners,
            edges: s.edges,
            faces: s.faces,
            look: Artifact {
                screen: target,
                lens: cam.screen.z,
                eye: cam.eye,
                target: cam.target,
                place,
                // The tesseract at rest in the opening is still: no light or ripple moves on it.
                time: if motion { clock_at(s.presentation, opening: intro) } else {
                    s.presentation
                },
                // Dimmer in the library, as far off as it stands, so the games come first.
                light: if phase.settled { 0.72 } else { 1.0 },
                tint: s.tint,
            },
        ),
        vertices: 6,
    )
    space.end()
    let pass = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        pass,
        quad.bind(screen, rect: vec4(0.0, 0.0, screen)),
        stage.bind(
            room: s.room,
            linear: s.linear,
            camera: cam,
            look: Stage { reveal: stage_light(phase) },
        ),
        vertices: 6,
    )
    if phase.library > 0.0 {
        // The selection stands in a pool of its cover's light, as it settles.
        for placed in s.placed {
            if placed.index != s.selected { continue }
            let b = bounds(cam, placed.card)
            let foot = vec2(b.x + b.z * 0.5, b.y + b.w)
            let radii = vec2(b.z * 0.85, b.w * 0.32)
            let strength = 0.32 * placed.card.look.w * placed.card.look.w * phase.library
            draw(
                pass,
                quad.bind(screen, rect: vec4(foot - radii * 1.6, radii * 3.2)),
                pool.bind(
                    look: Pool { ellipse: vec4(foot, radii), color: vec4(s.tint.xyz, strength) },
                ),
                vertices: 6,
            )
        }
        for k in depth_order(s.placed) {
            let placed = s.placed[k]
            let card = room::Card {
                look: vec4(
                    placed.card.look.x * phase.library,
                    placed.card.look.y,
                    placed.card.look.z * phase.library,
                    placed.card.look.w,
                ),
                ..placed.card,
            }
            var drawn = false
            if placed.art {
                if let Some(t) = s.covers[placed.index].image {
                    draw(
                        pass,
                        block_corner.bind(camera: cam, card: card),
                        block_face.bind(art: t, linear: s.linear, card: card, has_art: 1.0),
                        vertices: 36,
                    )
                    drawn = true
                }
            }
            if !drawn {
                draw(
                    pass,
                    block_corner.bind(camera: cam, card: card),
                    block_face.bind(art: s.blank, linear: s.linear, card: card, has_art: 0.0),
                    vertices: 36,
                )
            }
            // Its edges over it: one CSS pixel wide, on any screen.
            let edges = Edges { width: max(s.pixel_ratio, 1.0) }
            draw(
                pass,
                block_edge.bind(camera: cam, card: card, look: edges),
                block_line.bind(card: card, look: edges),
                vertices: 72,
            )
        }
    }
    // The mark: large beneath the tesseract, a light passing along it as the tesseract comes
    // up, then going down into the dark with it; small in the header with the library.
    let big = mark_place(w, h)
    let header = vec3(
        margin + MARK_WIDTH * HEADER_CAP / facet::CAP * 0.5,
        42.0,
        HEADER_CAP / facet::CAP,
    )
    for (at, alpha, reveal) in [
        (big, phase.title, phase.reveal),
        (header, phase.library, 1.0),
    ] {
        if alpha <= 0.0 { continue }
        let ems = at.z * s.zoom
        let centre = at.xy * s.zoom
        let extent = vec2(MARK_WIDTH * ems + 16.0, ems * 1.6)
        draw(
            pass,
            quad.bind(screen, rect: vec4(centre - extent * 0.5, extent)),
            emblem.bind(
                runs: s.mark,
                look: Emblem {
                    centre,
                    ems,
                    alpha,
                    count: MARK_RUNS.len(),
                    reveal,
                    width: MARK_WIDTH,
                },
            ),
            vertices: 6,
        )
    }
    s.renderer.draw(pass, screen)
    pass.present()
    s.shown = s.controls.clone()
    if let Some(action) = s.activate {
        match action {
            Action::Game { index } => {
                s.focus = action
                act(mut s, action)
                if index != s.selected { s.focus = Action::Game { index: s.selected } }
            },
            _ => {
                s.focus = action
                act(mut s, action)
            },
        }
    }
    if s.clicked.is_some() { s.pressed = None }
}

// Fetches the games' files ahead of time, while the library waits: one game at a time, the
// selection first, then the rest in order, and never while a game is starting (the host
// stops it when a game opens). Each game's list is beside the catalog
// (studio/release/site.wrela's `prefetch_list`).
fn prefetch_games(s: mut Console) {
    if let Some(_) = poll(mut s.prefetching) { s.prefetched += 1 }
    if let Some(result) = poll(mut s.prefetch_list) {
        match result {
            Ok(bytes) => s.prefetching = Some(host::prefetch(bytes)),
            Err(_) => s.prefetched += 1,
        }
    }
    let n = s.cards.len()
    if s.step != Step::Idle || s.prefetched >= n { return }
    if s.prefetch_list.is_some() || s.prefetching.is_some() { return }
    if s.prefetch_from.is_none() { s.prefetch_from = Some(s.selected) }
    let from = s.prefetch_from.unwrap_or(0)
    let id = s.cards[prefetch_order(from, s.prefetched, n)].id.clone()
    s.prefetch_list = Some(fetch(f"prefetch-{id}.txt"))
}

// The `done`-th game to fetch ahead of time of `n`, starting from the selection, `from`.
fn prefetch_order(from: u32, done: u32, n: u32) -> u32 {
    (from + done) % n
}

// Whether this page load plays the opening: every visit does, and a reload of the tab starts
// at the library. Without an answer from the host, it plays.
fn decide_opening(s: mut Console) {
    s.decided = true
    if s.reloaded == Some(true) { s.presentation = max(s.presentation, RETURNING) }
}

// An address (`host::address`) without its fragment, if it has one: the path and query.
fn without_fragment(address: Vec<u8>) -> Option<String> {
    var kept: Vec<u8> = Vec::new()
    for b in address {
        if b == 35 { return String::from_utf8(take kept) }
        kept.push(b)
    }
    None
}

// Whether the environment (`host::environment`) says this page load reloaded the tab. A host
// that doesn't say gives a visit.
// A traced layer's size: the screen divided by a whole number, so its thin bright lines are
// not resampled into dashes, and about `budget` pixels.
fn traced_size(width: u32, height: u32, budget: f32) -> (u32, u32) {
    let divisor = max(u32(round(sqrt(f32(width) * f32(height) / budget))), 1)
    (max(width / divisor, 4), max(height / divisor, 4))
}

// The placed cards' order from farthest to nearest.
fn depth_order(placed: [Placed]) -> Vec<u32> {
    var order: Vec<u32> = Vec::new()
    for i in 0..placed.len() { order.push(i) }
    for i in 0..order.len() {
        for j in i + 1..order.len() {
            if placed[order[j]].card.centre.z < placed[order[i]].card.centre.z {
                let t = order[i]
                order[i] = order[j]
                order[j] = t
            }
        }
    }
    order
}

@test
fn cover_requests_stay_within_reach_of_the_selection() {
    for selected in 0..20 {
        var count = 0
        for index in 0..20 { if near_cover(index, selected) { count += 1 } }
        assert(count <= COVER_REACH * 2 + 1 && near_cover(selected, selected))
    }
    assert(!near_cover(index: 0, selected: 4294967295))
}

@test
fn a_title_offers_new_alone_until_it_has_saves() {
    let fresh = actions(has_saves: false)
    assert(fresh.len() == 1 && fresh[0] == Action::NewGame)
    let played = actions(has_saves: true)
    assert(played.len() == 3)
    assert(
        played[0] == Action::Continue && played[1] == Action::NewGame && played[2] == Action::Load,
    )
    assert(
        action_label(Action::NewGame, opening: false) == "New" &&
            action_label(Action::Load, opening: false) == "Load",
    )
}

@test
fn traced_layers_divide_the_screen_by_a_whole_number() {
    assert(traced_size(width: 1280, height: 720, budget: TRACED_PIXELS) == (1280, 720))
    assert(traced_size(width: 2560, height: 1440, budget: TRACED_PIXELS) == (1280, 720))
    assert(traced_size(width: 2880, height: 1800, budget: TRACED_PIXELS) == (1440, 900))
    assert(traced_size(width: 390, height: 844, budget: TRACED_PIXELS) == (390, 844))
}

@test
fn a_failed_request_retries_quietly_after_a_pause() {
    let at = 10.0 + RETRY_SECONDS
    assert(!retry_due(at, now: 12.0, closing: false), "not before the pause is over")
    assert(retry_due(at, now: 13.0, closing: false))
    assert(!retry_due(at, now: 14.0, closing: true), "not while the old session closes")
    assert(!retry_due(0.0, now: 14.0, closing: false), "nothing to retry")
}

@test
fn focus_moves_across_rows_and_along_them() {
    let row = |action: Action, x: f32, y: u32| -> Control {
        Control {
            action,
            rect: Rect::new(x, f32(y) * 100.0, w: 80.0, h: 40.0),
            row: y,
            kind: Kind::Button,
        }
    }
    let controls = [
        row(Action::Settings, 900.0, 0),
        row(Action::Game { index: 0 }, 50.0, 1),
        row(Action::Continue, 50.0, 2),
        row(Action::Load, 200.0, 2),
    ]
    assert(neighbour(controls, Action::Continue, Move::Right) == Some(Action::Load))
    assert(neighbour(controls, Action::Load, Move::Right).is_none())
    assert(neighbour(controls, Action::Continue, Move::Up) == Some(Action::Game { index: 0 }))
    assert(neighbour(controls, Action::Game { index: 0 }, Move::Up) == Some(Action::Settings))
    assert(neighbour(controls, Action::Continue, Move::Down).is_none())
    assert(neighbour(controls, Action::Retry, Move::Down) == Some(Action::Settings))
    // From an album far to the right, down still reaches the main action first.
    let wide = [
        row(Action::Game { index: 4 }, 900.0, 1),
        row(Action::Continue, 50.0, 2),
        row(Action::Retry, 400.0, 2),
    ]
    assert(neighbour(wide, Action::Game { index: 4 }, Move::Down) == Some(Action::Continue))
}

@test
fn shorter_save_sheets_page_the_rows_to_keep_actions_visible() {
    assert(save_capacity(720.0) == 5)
    assert(save_capacity(504.0) == 2)
    assert(save_capacity(300.0) == 1)
    assert(save_capacity(2000.0) == 6)
}

@test
fn a_queued_play_uses_the_current_save_or_explicit_new_game() {
    let saves = [
        SaveInfo {
            slot: String::from("continue"),
            label: String::new(),
            description: String::new(),
            saved: 0,
        },
        SaveInfo {
            slot: String::from("imported"),
            label: String::new(),
            description: String::new(),
            saved: 0,
        },
    ]
    match play_plan(Some(String::from("continue")), saves, 0, PlayIntent::NewGame) {
        PlayPlan::Prepare { slot } => assert(slot.is_empty()),
        _ => assert(false, "New game must not start a prepared continuation"),
    }
    match play_plan(Some(String::from("continue")), saves, 1, PlayIntent::Selected) {
        PlayPlan::Prepare { slot } => assert(slot == "imported"),
        _ => assert(false, "A changed selection needs its own preparation"),
    }
    match play_plan(Some(String::from("imported")), saves, 1, PlayIntent::Selected) {
        PlayPlan::Start => {},
        _ => assert(false, "Ready selection starts"),
    }
}

@test
fn an_export_keeps_the_requested_slot_when_selection_changes() {
    let slots = ["continue", "other"]
    var picked = 0
    let plan = export_plan("first", "player-1", slots[picked])
    picked = 1
    assert(slots[picked] == "other")
    assert(plan.slot == "continue")
    assert(export_name(plan) == "wrela-first-player-1-continue.wrela-save")
}

@test
fn an_invalid_utf8_catalog_finishes_with_an_error() {
    match catalog_result(Vec::<u8>::from([255])) {
        Err(message) => assert(message == "The game library could not be read."),
        Ok(_) => assert(false, "Invalid UTF-8 is a catalog completion error"),
    }
}

@test
fn every_valid_game_key_has_a_downloadable_export_name() {
    let cards = parse("-first\tFirst\turl\timage\t1\t1").unwrap()
    let plan = export_plan(cards[0].id, "player-1", "continue")
    assert(valid_key(plan.game))
    let name = export_name(plan)
    let first = name.byte(0)
    assert((first >= 97 && first <= 122) || (first >= 48 && first <= 57))
}

@test
fn an_empty_library_displays_its_error_instead_of_loading() {
    let message = "The game library could not be read."
    assert(empty_library_message(message) == message)
    assert(empty_library_message("") == "Loading games")
}

@test
fn a_new_title_waits_for_the_old_one_to_ease_out() {
    // Choosing the second game: the first's title eases out, then the second's in.
    var shown: u32 = 0
    var eased = 1.0
    var seen_out = false
    for _ in 0..30 {
        let (next_shown, next_eased) = title_step(shown, eased, selected: 1, dt: 1.0 / 60.0)
        if next_shown == 0 { assert(next_eased < eased, "the old title only fades") }
        if next_shown == 1 && shown == 0 {
            seen_out = true
            assert(next_eased == 0.0, "the new one starts unseen")
        }
        shown = next_shown
        eased = next_eased
    }
    assert(seen_out && shown == 1 && eased > 0.5)
}

@test
fn games_are_fetched_ahead_from_the_selection_round_to_the_rest() {
    var order: Vec<u32> = Vec::new()
    for done in 0..4 { order.push(prefetch_order(2, done, 4)) }
    assert(order[0] == 2 && order[1] == 3 && order[2] == 0 && order[3] == 1)
}

// `t`'s UTF-8 bytes, as a host gives an address.
fn bytes(t: str) -> Vec<u8> {
    var b: Vec<u8> = Vec::new()
    for i in 0..t.len() { b.push(t.byte(i)) }
    take b
}

@test
fn a_games_name_left_in_the_address_is_dropped_and_the_path_and_query_kept() {
    assert(without_fragment(bytes("/?from=link#leapling")) == Some(String::from("/?from=link")))
    assert(without_fragment(bytes("/#")) == Some(String::from("/")))
    assert(without_fragment(bytes("/")).is_none(), "no fragment: nothing to replace")
    assert(without_fragment(Vec::new()).is_none(), "the replacement's empty answer ends it")
}

@test
fn a_reload_starts_at_the_library_and_a_visit_plays_the_opening() {
    var visit: Vec<u8> = Vec::new()
    for _ in 0..10 { visit.push(u8(0)) }
    var reload = visit.clone()
    reload[9] = u8(1)
    assert(!host::read_environment(visit).reloaded, "a visit plays the opening")
    assert(host::read_environment(reload).reloaded)
    let short = host::read_environment([u8(1), u8(0), u8(0), u8(0), u8(0)])
    assert(!short.reloaded, "a host that doesn't say: a visit")
}

@test
fn a_cover_lends_its_colour_and_grey_art_lends_white() {
    var grey: Vec<u8> = Vec::new()
    var green: Vec<u8> = Vec::new()
    for i in 0..16 * 8 {
        for c in [128, 128, 128, 255] { grey.push(u8(c)) }
        // Mostly dark grass, with a few dull grey pixels that must not wash it out.
        let pixel = if i % 3 == 0 { [90, 90, 90, 255] } else { [40, 160, 60, 255] }
        for c in pixel { green.push(u8(c)) }
    }
    assert(palette(grey, width: 16, height: 8) == vec3(1.0))
    let t = palette(green, width: 16, height: 8)
    assert(t.y == 1.0 && t.x < 0.4 && t.z < 0.5)
}

@test
fn another_game_is_chosen_while_saves_are_read_but_not_while_one_starts() {
    for step in [Step::Idle, Step::Open, Step::List, Step::Prepare] { assert(browsing(step)) }
    for step in [
        Step::Start,
        Step::Frame,
        Step::Show,
        Step::Closed,
        Step::Export,
        Step::Download,
        Step::PickFile,
        Step::Import,
    ] { assert(!browsing(step)) }
}
