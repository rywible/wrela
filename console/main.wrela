// Wrela's console. The catalog and game session protocol supply all title-specific content.
use catalog::{Card, parse}
use paint::{Field, chamber, image, moment, quad, word_field}
use platform::host
use platform::protocol::{Reply, Request, SaveInfo, valid_key}
use std::gpu::{Rgba8, Sampler, Texture, begin_screen_pass, draw, sampler, texture}
use std::input::{Button, Event, Key, PadButton, events}
use std::io::{Pending, fetch, load as read_file, store}
use std::serialize::{LoadError, Serialize, load, save}
use ui::draw::{DrawList, Rect, Renderer}
use ui::text::{Face, Fonts, previous}
use ui::ttf::{Baked, bake}

@fuel(2 ** 38)
const BODY: Baked = bake(embed("fonts/Manrope-Medium.ttf"), em: 36.0, spread: 4.0)
@fuel(2 ** 38)
const DISPLAY: Baked = bake(embed("fonts/Barlow-Light.ttf"), em: 48.0, spread: 5.0)
const INK = vec4(0.945, 0.969, 0.992, 1.0)
const MUTED = vec4(0.48, 0.56, 0.59, 1.0)
const LIGHT = vec4(0.82, 0.91, 0.94, 1.0)
const SURFACE = vec4(0.035, 0.055, 0.065, 1.0)

pub struct Profile: Clone + Serialize {
    version: u32,
    key: String,
    name: String,
    game: String,
    motion: bool,
}

enum Pane: Copy + Eq { Games, Saves, Settings }

enum PlayIntent: Copy + Eq { Selected, NewGame }

enum PlayPlan: Clone { Start, Prepare { slot: String } }

struct ExportPlan: Clone {
    game: String,
    profile: String,
    slot: String,
}

enum Step: Copy + Eq {
    Idle,
    Open,
    List,
    Prepare,
    Start,
    Frame,
    Show,
    Closed,
    Export,
    Download,
    PickFile,
    Import,
}

enum Action: Copy + Eq {
    Games,
    Settings,
    Play,
    NewGame,
    ViewSaves,
    Export,
    Import,
    SaveProfile,
    Motion,
    Game { index: u32 },
    Save { index: u32 },
    Retry,
}

struct Cover {
    image: Option<Texture<Rgba8>>,
    load: Option<Pending<u8>>,
    requested: bool,
}

struct Panel: Copy {
    index: u32,
    rect: Rect,
    lean: f32,
    alpha: f32,
}

pub struct Console {
    fonts: Fonts,
    renderer: Renderer,
    draw: DrawList,
    linear: Sampler,
    letters: Texture<Rgba8>,
    covers: Vec<Cover>,
    panels: Vec<Panel>,
    album: f32,
    reveal: f32,
    catalog_load: Option<Pending<u8>>,
    profile_load: Option<Pending<u8>>,
    profile_write: Option<Pending<u8>>,
    environment: Option<Pending<u8>>,
    pending: Option<Pending<u8>>,
    closing: Option<Pending<u8>>,
    cards: Vec<Card>,
    selected: u32,
    profile: Profile,
    profile_ready: bool,
    pane: Pane,
    step: Step,
    handle: Option<u32>,
    saves: Vec<SaveInfo>,
    picked: u32,
    prepared_slot: Option<String>,
    wanted_slot: String,
    exporting: Option<ExportPlan>,
    play_intent: Option<PlayIntent>,
    need_open: bool,
    message: String,
    pixel_ratio: f32,
    reduced: bool,
    intro_until: f32,
    focus: u32,
    controls: u32,
    activate: Option<Action>,
    enter: bool,
    keyboard: bool,
    clicked: Option<vec2>,
    pressed: Option<vec2>,
    zoom: f32,
    time: f32,
}

pub fn init() -> Console {
    let fonts = Fonts::from_baked(BODY, DISPLAY)
    let renderer = Renderer::new(fonts)
    var letters = texture::<Rgba8>(width: 256, height: 96)
    letters.write(x: 0, y: 0, width: 256, height: 96, bytes: word_field(fonts.mono))
    Console {
        fonts,
        renderer,
        draw: DrawList::new(),
        linear: sampler(),
        letters,
        covers: Vec::new(),
        panels: Vec::new(),
        album: 0.0,
        reveal: 0.0,
        catalog_load: Some(fetch("catalog.tsv")),
        profile_load: Some(read_file("console/profile")),
        profile_write: None,
        environment: Some(host::environment()),
        pending: None,
        closing: None,
        cards: Vec::new(),
        selected: 0,
        profile: Profile {
            version: 1,
            key: String::from("player-1"),
            name: String::from("Player 1"),
            game: String::new(),
            motion: true,
        },
        profile_ready: false,
        pane: Pane::Games,
        step: Step::Idle,
        handle: None,
        saves: Vec::new(),
        picked: 0,
        prepared_slot: None,
        wanted_slot: String::new(),
        exporting: None,
        play_intent: None,
        need_open: false,
        message: String::new(),
        pixel_ratio: 1.0,
        reduced: false,
        intro_until: 6.6,
        focus: 1,
        controls: 0,
        activate: None,
        enter: false,
        keyboard: false,
        clicked: None,
        pressed: None,
        zoom: 1.0,
        time: 0.0,
    }
}

fn poll(pending: mut Option<Pending<u8>>) -> Option<Result<Vec<u8>, std::io::IoError>> {
    var answer = None
    match mut pending {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if answer.is_some() { pending = None }
    answer
}

fn call(s: mut Console, request: Request, step: Step) {
    let Some(id) = s.handle else { return }
    let bytes = save(request)
    s.pending = Some(host::send(id, bytes))
    s.step = step
}

fn list(s: mut Console) {
    let request = Request::List { profile: s.profile.key.clone() }
    call(mut s, request, Step::List)
}

fn prepare_game(s: mut Console, slot: String) {
    s.wanted_slot = slot.clone()
    let request = Request::Prepare { profile: s.profile.key.clone(), slot: slot.clone() }
    call(mut s, request, Step::Prepare)
}

fn start(s: mut Console) {
    call(mut s, Request::Start, Step::Start)
}

// A queued play always uses the latest explicit selection, even if a different slot finishes preparing.
fn play_plan(
    prepared: Option<String>,
    saves: [SaveInfo],
    picked: u32,
    intent: PlayIntent,
) -> PlayPlan {
    let slot = if intent == PlayIntent::NewGame || saves.len() == 0 { String::new() } else {
        saves[min(picked, saves.len() - 1)].slot.clone()
    }
    if let Some(ready) = prepared { if ready == slot { return PlayPlan::Start } }
    PlayPlan::Prepare { slot }
}

fn fulfill_play(s: mut Console) {
    let Some(intent) = s.play_intent else { return }
    if s.step != Step::Idle || s.closing.is_some() || s.cards.is_empty() { return }
    if s.handle.is_none() {
        s.need_open = true
        return
    }
    match play_plan(s.prepared_slot, s.saves, s.picked, intent) {
        PlayPlan::Start => start(mut s),
        PlayPlan::Prepare { slot } => prepare_game(mut s, slot.clone()),
    }
}

fn open_selected(s: mut Console) {
    if s.cards.is_empty() { return }
    s.message.clear()
    s.saves.clear()
    s.picked = 0
    s.prepared_slot = None
    s.profile.game = s.cards[s.selected].id.clone()
    let bytes = save(s.profile)
    s.profile_write = Some(store("console/profile", bytes))
    s.pending = Some(host::open(s.cards[s.selected].session))
    s.step = Step::Open
    s.need_open = false
}

fn failed(s: mut Console, message: str) {
    s.message = message.to_string()
    s.play_intent = None
    s.step = Step::Idle
    s.prepared_slot = None
    s.exporting = None
}

fn export_plan(game: str, profile: str, slot: str) -> ExportPlan {
    ExportPlan { game: game.to_string(), profile: profile.to_string(), slot: slot.to_string() }
}

fn export_name(plan: ExportPlan) -> String {
    f"wrela-{plan.game}-{plan.profile}-{plan.slot}.wrela-save"
}

fn answer(s: mut Console, bytes: take Vec<u8>) {
    match s.step {
        Step::Open => {
            let Some(id) = host::word(bytes) else {
                failed(mut s, "The game could not connect. Try again.")
                return
            }
            s.handle = Some(id)
            list(mut s)
        },
        Step::List | Step::Prepare | Step::Start | Step::Export | Step::Import => {
            let result: Result<Reply, LoadError> = load(bytes.clone())
            let Ok(reply) = result else {
                failed(mut s, "The game sent an unsupported response.")
                return
            }
            match reply {
                Reply::Error { message } => failed(mut s, message),
                Reply::Saves { entries } => {
                    if entries.len() > 256 {
                        failed(mut s, "The game sent too many saves.")
                        return
                    }
                    for entry in entries {
                        if !valid_key(entry.slot) ||
                            entry.label.len() > 160 ||
                            entry.description.len() > 512 {
                            failed(mut s, "The game sent unsupported save details.")
                            return
                        }
                    }
                    s.saves = entries.clone()
                    s.picked = 0
                    let slot = if s.saves.is_empty() { String::new() } else {
                        s.saves[0].slot.clone()
                    }
                    prepare_game(mut s, slot)
                },
                Reply::Ready => {
                    s.prepared_slot = Some(s.wanted_slot.clone())
                    s.step = Step::Idle
                },
                Reply::Started => {
                    let Some(id) = s.handle else { return }
                    s.pending = Some(host::surface("surface/frame", id))
                    s.step = Step::Frame
                },
                Reply::Exported { bytes } => {
                    let Some(plan) = s.exporting else {
                        failed(mut s, "The game sent an unsupported response.")
                        return
                    }
                    let name = export_name(plan)
                    s.pending = Some(host::export_file(name, bytes))
                    s.exporting = None
                    s.step = Step::Download
                },
                Reply::Imported => {
                    s.message = String::from("Save imported.")
                    list(mut s)
                },
            }
        },
        Step::Frame => {
            let Some(id) = s.handle else { return }
            s.pending = Some(host::surface("surface/show", id))
            // Keep the closure request alive before the host suspends this console.
            s.closing = Some(host::surface("surface/closed", id))
            s.step = Step::Show
        },
        Step::Show => {
            s.step = Step::Closed
            s.play_intent = None
        },
        Step::Download => {
            s.step = Step::Idle
            s.message = String::from("Save exported.")
        },
        Step::PickFile => {
            let request = Request::Import { profile: s.profile.key.clone(), bytes }
            call(mut s, request, Step::Import)
        },
        _ => s.step = Step::Idle,
    }
}

fn catalog_result(bytes: Vec<u8>) -> Result<Vec<Card>, String> {
    if let Some(text) = String::from_utf8(bytes.clone()) {
        if let Some(cards) = parse(text) {
            return Ok(cards.clone())
        } else { return Err(String::from("The game library could not be read.")) }
    }
    Err(String::from("The game library could not be read."))
}

fn near_cover(index: u32, selected: u32) -> bool {
    if index >= selected { index - selected <= 2 } else { selected - index <= 2 }
}

fn update(s: mut Console) {
    if let Some(result) = poll(mut s.environment) {
        if let Ok(bytes) = result {
            if !bytes.is_empty() { s.reduced = bytes[0] != 0 }
            if let Some(ratio) = host::word(bytes, 5) {
                s.pixel_ratio = clamp(f32(ratio) / 1024.0, 0.5, 4.0)
            }
        }
    }
    if let Some(result) = poll(mut s.profile_load) {
        s.profile_ready = true
        if let Ok(bytes) = result {
            let profile: Result<Profile, LoadError> = load(bytes.clone())
            if let Ok(p) = profile {
                if p.version == 1 && valid_key(p.key) && p.name.len() <= 160 {
                    s.profile = p.clone()
                }
            }
        }
    }
    if let Some(result) = poll(mut s.catalog_load) {
        match result {
            Ok(bytes) => match catalog_result(bytes) {
                Ok(cards) => {
                    s.cards = cards.clone()
                    for _ in 0..cards.len() {
                        s.covers.push(Cover { image: None, load: None, requested: false })
                    }
                    s.need_open = true
                },
                Err(message) => s.message = message.clone(),
            },
            Err(_) => s.message = String::from(
                "The game library could not load. Check your connection and reload.",
            ),
        }
    }
    if s.need_open && s.profile_ready && s.step == Step::Idle {
        for i in 0..s.cards.len() { if s.cards[i].id == s.profile.game { s.selected = i } }
        open_selected(mut s)
    }
    // Only the selected album and two neighbours on each side hold textures or requests.
    for i in 0..s.covers.len() {
        let visible = near_cover(i, s.selected)
        if !visible {
            s.covers[i].image = None
            s.covers[i].load = None
            s.covers[i].requested = false
            continue
        }
        if !s.covers[i].requested {
            s.covers[i].load = Some(fetch(s.cards[i].cover))
            s.covers[i].requested = true
        }
        if let Some(result) = poll(mut s.covers[i].load) {
            if let Ok(bytes) = result {
                let card = s.cards[i].clone()
                if bytes.len() == card.width * card.height * 4 {
                    var image = texture::<Rgba8>(width: card.width, height: card.height)
                    image.write(x: 0, y: 0, width: card.width, height: card.height, bytes: bytes)
                    s.covers[i].image = Some(take image)
                }
            }
        }
    }
    if let Some(result) = poll(mut s.profile_write) {
        if result.is_err() {
            s.message = String::from("Your profile could not be saved on this device.")
        }
    }
    if let Some(result) = poll(mut s.pending) {
        match result {
            Ok(bytes) => answer(mut s, bytes.clone()),
            Err(_) => failed(mut s, "The request could not finish. Try again."),
        }
    }
    if poll(mut s.closing).is_some() {
        s.handle = None
        s.step = Step::Idle
        s.need_open = true
        s.play_intent = None
    }
    fulfill_play(mut s)
}

fn act(s: mut Console, action: Action) {
    match action {
        Action::Games => {
            s.pane = Pane::Games
            s.focus = 1
        },
        Action::ViewSaves => {
            s.pane = Pane::Saves
            s.focus = 1
        },
        Action::Settings => {
            s.pane = if s.pane == Pane::Settings { Pane::Games } else { Pane::Settings }
            s.focus = 1
        },
        Action::Motion => s.profile.motion = !s.profile.motion,
        Action::SaveProfile => {
            if s.profile.name.trim().is_empty() {
                s.message = String::from("Enter a name for this profile.")
                return
            }
            let bytes = save(s.profile)
            s.profile_write = Some(store("console/profile", bytes))
            s.message = String::from("Profile saved.")
        },
        Action::Game { index } => {
            if s.step != Step::Idle || s.closing.is_some() || index == s.selected { return }
            s.need_open = s.handle.is_none()
            if let Some(id) = s.handle { s.closing = Some(host::surface("surface/close", id)) }
            s.handle = None
            s.selected = index
            s.profile.game = s.cards[index].id.clone()
        },
        Action::Save { index } => {
            s.picked = index
            s.prepared_slot = None
        },
        Action::Play | Action::NewGame => {
            if s.cards.is_empty() { return }
            s.play_intent = Some(if action == Action::NewGame { PlayIntent::NewGame } else {
                PlayIntent::Selected
            })
            fulfill_play(mut s)
        },
        Action::Export => {
            if s.step == Step::Idle && !s.saves.is_empty() {
                let plan = export_plan(
                    s.cards[s.selected].id,
                    s.profile.key,
                    s.saves[s.picked].slot,
                )
                s.exporting = Some(plan.clone())
                let request = Request::Export {
                    profile: plan.profile.clone(),
                    slot: plan.slot.clone(),
                }
                call(mut s, request, Step::Export)
            }
        },
        Action::Import => {
            if s.step == Step::Idle {
                s.pending = Some(host::import_file())
                s.step = Step::PickFile
            }
        },
        Action::Retry => {
            if s.step == Step::Idle && s.closing.is_none() {
                s.need_open = s.handle.is_none()
                if let Some(id) = s.handle { s.closing = Some(host::surface("surface/close", id)) }
                s.handle = None
            }
        },
    }
}

fn text(s: mut Console, content: str, size: f32, at: vec2, color: vec4, face: Face = Face::Sans) {
    let _ = s.draw.text(
        s.fonts,
        face,
        content,
        size * s.zoom,
        at * s.zoom,
        vec4(color.xyz, color.w * s.reveal),
    )
}

fn centered(
    s: mut Console,
    content: str,
    size: f32,
    x: f32,
    y: f32,
    color: vec4,
    face: Face = Face::Sans,
) {
    let width = s.fonts.font(face).measure(content, size)
    text(mut s, content, size, vec2(x - width * 0.5, y), color, face)
}

fn rect(s: mut Console, r: Rect, color: vec4, radius: f32 = 0.0) {
    s.draw.rect(
        Rect::new(r.x * s.zoom, r.y * s.zoom, r.w * s.zoom, r.h * s.zoom),
        vec4(color.xyz, color.w * s.reveal),
        radius * s.zoom,
    )
}

fn control(s: mut Console, action: Action, r: Rect) -> bool {
    let focus = s.focus == s.controls
    s.controls += 1
    let clicked = match (s.clicked, s.pressed) {
        (Some(up), Some(down)) => r.contains(up / s.zoom) && r.contains(down / s.zoom),
        _ => false,
    }
    if s.reveal > 0.95 && s.activate.is_none() && ((focus && s.enter) || clicked) {
        s.activate = Some(action)
    }
    focus && s.keyboard
}

fn button(s: mut Console, action: Action, r: Rect, label: str, primary: bool = false) {
    let focus = control(mut s, action, r)
    if primary {
        if focus {
            rect(
                mut s,
                Rect::new(r.x - 3.0, r.y - 3.0, r.w + 6.0, r.h + 6.0),
                vec4(LIGHT.xyz, 0.32),
                28.0,
            )
        }
        rect(mut s, r, LIGHT, 25.0)
    } else if focus { rect(mut s, r, vec4(LIGHT.xyz, 0.12), 12.0) }
    centered(mut s, label, 16.0, r.x + r.w * 0.5, r.y + (r.h - 20.0) * 0.5, if primary {
        vec4(0.015, 0.035, 0.045, 1.0)
    } else { INK })
}

fn cog(s: mut Console, w: f32, margin: f32) {
    let r = Rect::new(w - margin - 44.0, margin - 8.0, 44.0, 44.0)
    let focus = control(mut s, Action::Settings, r)
    if focus || s.pane == Pane::Settings { rect(mut s, r, vec4(LIGHT.xyz, 0.12), 22.0) }
    let c = r.center()
    for i in 0..8 {
        let a = f32(i) * 0.78539816
        let p = c + vec2(cos(a), sin(a)) * 9.0
        rect(mut s, Rect::new(p.x - 2.0, p.y - 2.0, 4.0, 4.0), INK, 1.0)
    }
    rect(mut s, Rect::new(c.x - 8.0, c.y - 8.0, 16.0, 16.0), INK, 8.0)
    rect(mut s, Rect::new(c.x - 5.5, c.y - 5.5, 11.0, 11.0), SURFACE, 6.0)
    rect(mut s, Rect::new(c.x - 2.0, c.y - 2.0, 4.0, 4.0), INK, 2.0)
}

fn status(s: Console) -> String {
    if !s.message.is_empty() { return s.message.clone() }
    match s.step {
        Step::Start | Step::Frame | Step::Show => String::from("Opening game"),
        Step::PickFile | Step::Import => String::from("Importing save"),
        Step::Export | Step::Download => String::from("Exporting save"),
        _ => String::new(),
    }
}

fn empty_library_message(message: str) -> String {
    if message.is_empty() { String::from("Loading games") } else { message.to_string() }
}

// Fit a landscape album to the actual viewport, without stretching its cover.
fn album_rect(w: f32, h: f32, aspect: f32) -> Rect {
    let width = min(320.0, w - 64.0)
    let height = min(width / aspect, h * 0.27)
    let fitted = min(width, height * aspect)
    Rect::new((w - fitted) * 0.5, h * 0.57 - height * 0.5, fitted, height)
}

fn panel_rect(base: Rect, w: f32, delta: f32, aspect: f32) -> Rect {
    let depth = min(abs(delta), 2.0)
    let scale = 1.0 / (1.0 + depth * 0.24)
    let height = min(base.h * scale, base.w * scale / aspect)
    let width = height * aspect
    let center = base.center() + vec2(delta * min(230.0, w * 0.46), depth * -10.0)
    Rect::new(center.x - width * 0.5, center.y - height * 0.5, width, height)
}

fn library(s: mut Console, w: f32, h: f32) {
    if s.cards.is_empty() {
        let label = empty_library_message(s.message)
        centered(mut s, label, 18.0, w * 0.5, h * 0.64, MUTED)
        return
    }
    let card = s.cards[s.selected].clone()
    let base = album_rect(w, h, f32(card.width) / f32(card.height))
    let selected_rect = panel_rect(
        base,
        w,
        f32(s.selected) - s.album,
        f32(card.width) / f32(card.height),
    )
    let selected_focus = control(mut s, Action::Play, selected_rect)
    // Test nearer albums first; draw them in the reverse order below.
    for offset in 0..3 {
        for side in 0..2 {
            let offset = i32(offset)
            let index = i32(s.selected) + if side == 0 { -offset } else { offset }
            if index < 0 || index >= i32(s.cards.len()) || (offset == 0 && side == 0) { continue }
            let delta = f32(index) - s.album
            let depth = min(abs(delta), 2.0)
            let r = panel_rect(
                base,
                w,
                delta,
                f32(s.cards[u32(index)].width) / f32(s.cards[u32(index)].height),
            )
            let alpha = 1.0 / (1.0 + depth * 0.85)
            let focus = if u32(index) == s.selected { selected_focus } else {
                control(mut s, Action::Game { index: u32(index) }, r)
            }
            if s.covers[u32(index)].image.is_none() { rect(mut s, r, SURFACE, 12.0) }
            if focus {
                rect(mut s, Rect::new(r.x - 4.0, r.y - 4.0, r.w + 8.0, 2.0), LIGHT, 1.0)
                rect(mut s, Rect::new(r.x - 4.0, r.bottom() + 2.0, r.w + 8.0, 2.0), LIGHT, 1.0)
            }
            s.panels.push(
                Panel {
                    index: u32(index),
                    rect: r,
                    lean: clamp(delta * -0.44, -0.75, 0.75),
                    alpha,
                },
            )
        }
    }
    let title_size = min(30.0, 30.0 * (w - 48.0) / max(s.fonts.mono.measure(card.title, 30.0), 1.0))
    centered(mut s, card.title, title_size, w * 0.5, base.bottom() + 20.0, INK, Face::Mono)
    let y = base.bottom() + 76.0
    let playing = s.play_intent.is_some()
    button(mut s, Action::Play, Rect::new(w * 0.5 - 72.0, y, 144.0, 48.0), if playing {
        "Opening..."
    } else if s.saves.is_empty() { "Play" } else { "Continue" }, true)
    button(mut s, Action::ViewSaves, Rect::new(w * 0.5 - 40.0, y + 57.0, 80.0, 36.0), "Saves")
    let state = status(s)
    if !state.is_empty() {
        centered(mut s, state, 14.0, w * 0.5, h - 52.0, MUTED)
        if !s.message.is_empty() {
            button(
                mut s,
                Action::Retry,
                Rect::new(w * 0.5 - 50.0, h - 32.0, 100.0, 28.0),
                "Try again",
            )
        }
    }
    if s.cards.len() > 1 {
        // Navigation is quiet and only exists when there is somewhere to go.
        if s.selected > 0 {
            button(
                mut s,
                Action::Game { index: s.selected - 1 },
                Rect::new(16.0, base.y + base.h * 0.5 - 22.0, 40.0, 44.0),
                "<",
            )
        }
        if s.selected + 1 < s.cards.len() {
            button(
                mut s,
                Action::Game { index: s.selected + 1 },
                Rect::new(w - 56.0, base.y + base.h * 0.5 - 22.0, 40.0, 44.0),
                ">",
            )
        }
    }
}

fn dialog(s: mut Console, w: f32, h: f32, title: str) -> Rect {
    rect(mut s, Rect::new(0.0, 0.0, w, h), vec4(0.0, 0.0, 0.0, 0.72))
    let r = Rect::new(
        max(20.0, (w - 620.0) * 0.5),
        max(48.0, (h - 590.0) * 0.5),
        min(w - 40.0, 620.0),
        min(h - 96.0, 590.0),
    )
    rect(mut s, r, vec4(0.022, 0.033, 0.041, 0.98), 20.0)
    text(mut s, title, 32.0, vec2(r.x + 28.0, r.y + 24.0), INK, Face::Mono)
    button(mut s, Action::Games, Rect::new(r.right() - 62.0, r.y + 22.0, 40.0, 40.0), "×")
    r
}

fn save_capacity(height: f32) -> u32 {
    u32(clamp(floor((height - 304.0) / 76.0), 1.0, 3.0))
}

fn saves(s: mut Console, w: f32, h: f32) {
    let panel = dialog(mut s, w, h, "Saves")
    let x = panel.x + 28.0
    let width = panel.w - 56.0
    let top = panel.y + 98.0
    if s.cards.is_empty() { return }
    let capacity = save_capacity(panel.h)
    let first = s.picked / capacity * capacity
    let count = min(s.saves.len() - first, capacity)
    if count == 0 {
        text(mut s, if s.step == Step::Open || s.step == Step::List { "Reading saves" } else {
            "No saves yet"
        }, 18.0, vec2(x, top), MUTED)
    }
    for i in first..first + count {
        let r = Rect::new(x, top + f32(i - first) * 76.0, width, 64.0)
        if i == s.picked { rect(mut s, r, SURFACE, 10.0) }
        let save = s.saves[i].clone()
        button(mut s, Action::Save { index: i }, Rect::new(r.x, r.y, r.w, 32.0), save.label)
        let size = min(
            13.0,
            13.0 * (width - 24.0) / max(s.fonts.sans.measure(save.description, 13.0), 1.0),
        )
        centered(mut s, save.description, size, r.center().x, r.y + 37.0, MUTED)
    }
    let y = top + f32(max(count, 1)) * 76.0 + 8.0
    if s.saves.len() > capacity {
        button(
            mut s,
            Action::Save { index: (first + capacity) % s.saves.len() },
            Rect::new(x, y - 12.0, width, 32.0),
            "More saves",
        )
    }
    let cell = (width - 12.0) * 0.5
    button(mut s, Action::Play, Rect::new(x, y + 26.0, cell, 46.0), if s.saves.is_empty() {
        "Play"
    } else { "Continue" }, true)
    button(mut s, Action::NewGame, Rect::new(x + cell + 12.0, y + 26.0, cell, 46.0), "New game")
    button(mut s, Action::Export, Rect::new(x, y + 91.0, cell, 36.0), "Export")
    button(mut s, Action::Import, Rect::new(x + cell + 12.0, y + 91.0, cell, 36.0), "Import")
    let state = status(s)
    if !state.is_empty() { centered(mut s, state, 13.0, w * 0.5, panel.bottom() - 20.0, MUTED) }
}

fn settings(s: mut Console, w: f32, h: f32) {
    let panel = dialog(mut s, w, h, "Settings")
    let x = panel.x + 28.0
    let width = panel.w - 56.0
    text(mut s, "Your name", 16.0, vec2(x, panel.y + 114.0), MUTED)
    rect(mut s, Rect::new(x, panel.y + 148.0, width, 60.0), SURFACE, 10.0)
    let name = s.profile.name.clone()
    let size = min(23.0, 23.0 * (width - 32.0) / max(s.fonts.sans.measure(name, 23.0), 1.0))
    text(mut s, name, size, vec2(x + 16.0, panel.y + 163.0), INK)
    button(mut s, Action::SaveProfile, Rect::new(x, panel.y + 242.0, 144.0, 48.0), "Save", true)
    button(mut s, Action::Motion, Rect::new(x, panel.y + 335.0, width, 48.0), if s.profile.motion {
        "Animation on"
    } else { "Animation off" })
    text(mut s, "Saves stay on this device", 14.0, vec2(x, panel.bottom() - 64.0), MUTED)
    let state = status(s)
    if !state.is_empty() { text(mut s, state, 13.0, vec2(x, panel.bottom() - 35.0), MUTED) }
}

pub fn frame(s: mut Console, time: f32, width: u32, height: u32) {
    let dt = clamp(time - s.time, 0.0, 0.05)
    s.time = time
    update(mut s)
    let logical = f32(width) / s.pixel_ratio
    s.zoom = s.pixel_ratio * clamp(f32(height) / s.pixel_ratio / 720.0, 0.7, 1.0)
    let w = f32(width) / s.zoom
    let h = f32(height) / s.zoom
    let was_opening = s.profile.motion && !s.reduced && time < s.intro_until
    s.enter = false
    s.clicked = None
    s.activate = None
    for event in events() {
        match event {
            Event::PointerDown { at, button: Button::Primary, .. } => {
                s.pressed = Some(at)
                s.intro_until = 0.0
                s.keyboard = false
            },
            Event::PointerUp { at, button: Button::Primary, .. } => {
                s.clicked = Some(at)
                s.intro_until = 0.0
                s.keyboard = false
            },
            Event::KeyDown { key, repeat, mods } => {
                s.keyboard = true
                s.intro_until = 0.0
                if key == Key::Enter && !repeat { s.enter = true }
                if key == Key::Tab || key == Key::Down {
                    s.focus = (s.focus + 1) % max(s.controls, 1)
                }
                if key == Key::Up {
                    s.focus = (s.focus + max(s.controls, 1) - 1) % max(s.controls, 1)
                }
                if key == Key::Right || key == Key::Left {
                    if s.pane == Pane::Games && s.cards.len() > 1 {
                        let delta = if key == Key::Right { 1 } else { -1 }
                        let index = u32(clamp(i32(s.selected) + delta, 0, i32(s.cards.len()) - 1))
                        act(mut s, Action::Game { index })
                    } else {
                        s.focus = if key == Key::Right { (s.focus + 1) % max(s.controls, 1) } else {
                            (s.focus + max(s.controls, 1) - 1) % max(s.controls, 1)
                        }
                    }
                }
                if key == Key::Escape {
                    s.pane = Pane::Games
                    s.focus = 1
                }
                if s.pane == Pane::Settings && key == Key::A && mods.command() {
                    s.profile.name.clear()
                }
                if s.pane == Pane::Settings && key == Key::Backspace {
                    let end = previous(s.profile.name, s.profile.name.len())
                    s.profile.name.truncate(end)
                }
            },
            Event::Text { char } => {
                if s.pane == Pane::Settings && s.profile.name.len() < 120 {
                    s.profile.name.push_char(char)
                }
            },
            Event::PadButton { button, pressed: true, .. } => {
                s.keyboard = true
                s.intro_until = 0.0
                if button == PadButton::South { s.enter = true }
                if button == PadButton::East {
                    s.pane = Pane::Games
                    s.focus = 1
                }
                if s.pane == Pane::Games &&
                    s.cards.len() > 1 &&
                    (button == PadButton::Right || button == PadButton::Left) {
                    let delta = if button == PadButton::Right { 1 } else { -1 }
                    let index = u32(clamp(i32(s.selected) + delta, 0, i32(s.cards.len()) - 1))
                    act(mut s, Action::Game { index })
                } else {
                    if button == PadButton::Right || button == PadButton::Down {
                        s.focus = (s.focus + 1) % max(s.controls, 1)
                    }
                    if button == PadButton::Left || button == PadButton::Up {
                        s.focus = (s.focus + max(s.controls, 1) - 1) % max(s.controls, 1)
                    }
                }
            },
            _ => {},
        }
    }
    if was_opening {
        s.enter = false
        s.clicked = None
        s.pressed = None
    }
    let opening = s.profile.motion && !s.reduced && time < s.intro_until
    let phase = moment(time, opening)
    s.reveal = phase.library
    s.album = mix(s.album, f32(s.selected), if s.reduced || !s.profile.motion { 1.0 } else {
        1.0 - exp(-dt * 12.0)
    })
    s.draw.clear(vec2(f32(width), f32(height)))
    s.controls = 0
    s.panels.clear()
    if phase.library > 0.0 {
        let margin = if logical < 800.0 { 24.0 } else { 40.0 }
        text(mut s, "Wrela", 26.0, vec2(margin, margin - 1.0), INK, Face::Mono)
        cog(mut s, w, margin)
        if w > 480.0 {
            let name = s.profile.name.clone()
            let measured = s.fonts.sans.measure(name, 14.0)
            text(mut s, name, 14.0, vec2(w - margin - 64.0 - measured, margin + 6.0), MUTED)
        }
        match s.pane {
            Pane::Games => library(mut s, w, h),
            Pane::Saves => saves(mut s, w, h),
            Pane::Settings => settings(mut s, w, h),
        }
    }
    s.renderer.upload(s.draw)
    let pass = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    let screen = vec2(f32(width), f32(height))
    draw(
        pass,
        quad.bind(screen, rect: vec4(0.0, 0.0, screen)),
        chamber.bind(field: Field { screen, time: if s.reduced || !s.profile.motion { 1.8 } else {
            time
        }, morph: if phase.library > 0.0 { 0.0 } else {
            phase.morph
        }, light: phase.light, library: phase.library }, letters: s.letters, linear: s.linear),
        vertices: 6,
    )
    for index in 0..s.panels.len() {
        let panel = s.panels[s.panels.len() - 1 - index]
        if let Some(t) = s.covers[panel.index].image {
            let r = panel.rect
            draw(
                pass,
                quad.bind(screen, rect: vec4(r.x, r.y, r.w, r.h) * s.zoom, lean: panel.lean),
                image.bind(
                    content: t,
                    linear: s.linear,
                    size: vec2(r.w, r.h) * s.zoom,
                    alpha: panel.alpha * s.reveal,
                ),
                vertices: 6,
            )
        }
    }
    s.renderer.draw(pass, screen)
    pass.present()
    if let Some(action) = s.activate { act(mut s, action) }
    if s.clicked.is_some() { s.pressed = None }
}

@test
fn cover_requests_stay_within_two_neighbours_and_album_hits_follow_the_animation() {
    for selected in 0..9 {
        var count = 0
        for index in 0..9 { if near_cover(index, selected) { count += 1 } }
        assert(count <= 5 && near_cover(selected, selected))
    }
    assert(!near_cover(0, 4294967295))
    let base = album_rect(1280.0, 720.0, 16.0 / 9.0)
    let moving = panel_rect(base, 1280.0, 1.0, 16.0 / 9.0)
    assert(moving.center().x > base.right())
    assert(!moving.contains(base.center()))
    let portrait = panel_rect(base, 1280.0, -1.0, 0.5)
    assert(abs(portrait.w / portrait.h - 0.5) < 0.001 && portrait.h < base.h)
}

@test
fn shorter_save_panels_page_the_rows_to_keep_actions_visible() {
    assert(save_capacity(590.0) == 3)
    assert(save_capacity(480.0) == 2)
    assert(save_capacity(332.0) == 1)
}

@test
fn albums_keep_the_cover_ratio_and_leave_room_for_the_play_action() {
    for size in [vec2(1280.0, 720.0), vec2(390.0, 844.0), vec2(780.0, 720.0)] {
        let r = album_rect(size.x, size.y, 16.0 / 9.0)
        assert(abs(r.w / r.h - 16.0 / 9.0) < 0.001)
        assert(r.x >= 24.0 && r.right() <= size.x - 24.0)
        assert(r.bottom() + 169.0 < size.y)
    }
}

@test
fn a_queued_play_uses_the_current_save_or_explicit_new_game() {
    let saves = [
        SaveInfo {
            slot: String::from("continue"),
            label: String::new(),
            description: String::new(),
            saved: 0,
        },
        SaveInfo {
            slot: String::from("imported"),
            label: String::new(),
            description: String::new(),
            saved: 0,
        },
    ]
    match play_plan(Some(String::from("continue")), saves, 0, PlayIntent::NewGame) {
        PlayPlan::Prepare { slot } => assert(slot.is_empty()),
        _ => assert(false, "New game must not start a prepared continuation"),
    }
    match play_plan(Some(String::from("continue")), saves, 1, PlayIntent::Selected) {
        PlayPlan::Prepare { slot } => assert(slot == "imported"),
        _ => assert(false, "A changed selection needs its own preparation"),
    }
    match play_plan(Some(String::from("imported")), saves, 1, PlayIntent::Selected) {
        PlayPlan::Start => {},
        _ => assert(false, "Ready selection starts"),
    }
}

@test
fn an_export_keeps_the_requested_slot_when_selection_changes() {
    let slots = ["continue", "other"]
    var picked = 0
    let plan = export_plan("first", "player-1", slots[picked])
    picked = 1
    assert(slots[picked] == "other")
    assert(plan.slot == "continue")
    assert(export_name(plan) == "wrela-first-player-1-continue.wrela-save")
}

@test
fn an_invalid_utf8_catalog_finishes_with_an_error() {
    match catalog_result(Vec::<u8>::from([255])) {
        Err(message) => assert(message == "The game library could not be read."),
        Ok(_) => assert(false, "Invalid UTF-8 is a catalog completion error"),
    }
}

@test
fn every_valid_game_key_has_a_downloadable_export_name() {
    let cards = parse("-first\tFirst\turl\timage\t1\t1").unwrap()
    let plan = export_plan(cards[0].id, "player-1", "continue")
    assert(valid_key(plan.game))
    let name = export_name(plan)
    let first = name.byte(0)
    assert((first >= 97 && first <= 122) || (first >= 48 && first <= 57))
}

@test
fn an_empty_library_displays_its_error_instead_of_loading() {
    let message = "The game library could not be read."
    assert(empty_library_message(message) == message)
    assert(empty_library_message("") == "Loading games")
}
