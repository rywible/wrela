// Wrela's console. The catalog and game session protocol supply all title-specific content.
use catalog::{Art, Card, parse}
use opening::{
    MARK_WIDTH, OPENING_SECONDS, RETURNING, artifact_place, clock_at, mark_place, moment,
    presentation_step, stage_light, turn_at,
}
use paint::{Backdrop, Emblem, Ink, Picture, Stage, backdrop, emblem, mark_ink, picture, quad, stage}
use room::{MARGIN, artifact_spot, camera}
use theme::{Cue, Theme}
use tesseract::{
    Artifact, EDGES, FACES, PANE_WORDS, STRUT_WORDS, artifact, corners, shapes, tile_grid, tiles,
}
use brand::facet
use brand::facet::MarkRun
use brand::manrope::MANROPE
use std::host
use platform::protocol::{Reply, Request, SaveInfo, valid_key}
use std::gpu::{
    Blend, GpuBuffer, RenderPass, Rgba8, Rgba16Float, Sampler, Texture, begin_pass,
    begin_screen_pass, buffer, buffer_of, draw, mip_levels, sampler, texture, write,
}
use std::audio::RingWriter
use std::input::{Button, Event, Key, PadAxis, PadButton, events}
use std::io::{Pending, fetch, load as read_file, store}
use std::serialize::{LoadError, Serialize, load, save}
use ui::draw::{DrawList, Rect, Renderer}
use ui::text::{Face, Fonts, previous}

@fuel(2 ** 34)
const MARK_RUNS: Vec<MarkRun> = facet::mark_runs()
// Colours and shapes after shadcn/ui's dark theme: near-white ink, muted grey text, quiet
// filled controls behind hairline borders, small radii, no glow.
const INK = vec4(0.98, 0.98, 0.98, 1.0)
const MUTED = vec4(0.63, 0.63, 0.66, 1.0)
const DARK = vec4(0.035, 0.035, 0.04, 1.0)
const SHEET = vec4(0.04, 0.04, 0.045, 0.98)
const WARN = vec4(0.95, 0.74, 0.6, 1.0)
const BORDER = vec4(1.0, 1.0, 1.0, 0.1)
const INPUT = vec4(1.0, 1.0, 1.0, 0.15)
const SECONDARY = vec4(0.15, 0.15, 0.16, 0.9)
const RAISED = vec4(0.21, 0.21, 0.22, 0.95)
const RADIUS: f32 = 8.0
// A button's label, in pixels.
const LABEL: f32 = 15.0
// Manrope's capital height, in ems.
const SANS_CAP: f32 = 0.72
// The mark's cap height in the header, in logical pixels.
const HEADER_CAP: f32 = 15.0
// The home's primary button's label, in pixels; the tagline's and the progress line's.
const CALL: f32 = 16.0
const TAGLINE_SIZE: f32 = 19.0
const PROGRESS: f32 = 15.0
// The title art's box at most, in logical pixels.
const LOGO_WIDE: f32 = 600.0
const LOGO_TALL: f32 = 240.0
// The room and its artifact are traced at the screen's size divided by a whole number, to
// about this many pixels: at least one sample a CSS pixel on a 2x display.
const TRACED_PIXELS: f32 = 1600000.0
// While only the tesseract's slow turn and the camera's breath move (the opening), the screen is
// drawn this many times a second; when nothing moves (the home, settled), not at all. Anything
// else that changes draws at once.
const IDLE_HZ: f32 = 30.0
// The most times a second the tesseract is traced again: the opening's, close to the eye, and
// the room's, far off and dim.
const OPENING_TRACE_HZ: f32 = 60.0
const ROOM_TRACE_HZ: f32 = 30.0
// Frames come a little early or late: a draw due at a rate is taken this many seconds early.
const SLACK: f32 = 0.004
// A device whose frames come slower than this, on average over `STRAIN_FRAMES` frames, traces
// the tesseract a step coarser (`trace_plan`), up to `COARSEST` steps.
const SLOW_FRAME: f32 = 1.0 / 24.0
const STRAIN_FRAMES: u32 = 90
const COARSEST: u32 = 3
// A dropped request or connection is tried again after this pause, without a word.
const RETRY_SECONDS: f32 = 3.0
// Glyphs in the display face; the body face carries sentences. A game's name is its own title
// art, or set in the body face: the display face is the console's.
const DISPLAY = Face::Mono
// Where the home's music setting is kept: a byte, 0 off.
const MUSIC: Text = "console/music"
// Seconds the theme's voice is given to fall quiet before it takes another game's theme: about
// 6% of its level is left (`theme::LEVEL_SECONDS`), which it lets go of as the new one comes.
const QUIET_SECONDS: f32 = 2.5

pub struct Profile: Clone + Serialize {
    version: u32,
    key: String,
    name: String,
    game: String,
    motion: bool,
}

enum Pane: Copy + Eq { Games, Saves, Settings }

enum PlayIntent: Copy + Eq { Selected, NewGame }

enum PlayPlan: Clone { Start, Prepare { slot: String } }

struct ExportPlan: Clone {
    game: String,
    profile: String,
    slot: String,
}

enum Step: Copy + Eq {
    Idle,
    Open,
    List,
    Prepare,
    Start,
    Frame,
    Show,
    Closed,
    Export,
    Download,
    PickFile,
    Import,
}

enum Action: Copy + Eq {
    Games,
    Settings,
    // The chosen game's call to action: continue its latest save, or begin.
    Play,
    NewGame,
    Load,
    Export,
    Import,
    SaveProfile,
    Name,
    Music,
    Game { index: u32 },
    Save { index: u32 },
    Page { first: u32 },
    Retry,
}

// How a focused control shows it: a ring slides to buttons and the settings button; tiles
// and rows light themselves.
enum Kind: Copy + Eq { Button, Tile, Row, Icon }

struct Control: Copy {
    action: Action,
    rect: Rect,
    row: u32,
    kind: Kind,
}

enum Move: Copy + Eq { Left, Right, Up, Down }

// Which hints the footer shows: the last input device used.
enum Input: Copy + Eq { Keys, Pad, Pointer }

// A picture of the catalog's, as it arrives: a cover, a hero or a title art.
struct Fetched {
    image: Option<Texture<Rgba8>>,
    // A cover's, a few pixels across, which blurred stands for its game's hero until it comes.
    small: Option<Texture<Rgba8>>,
    // The colour the art lends the home's light.
    tint: vec3,
    // The compressed art, fetched, then decoded by the host (`host::decode_image`).
    load: Option<Pending<u8>>,
    decode: Option<Pending<u8>>,
    requested: bool,
}

fn fetched() -> Fetched {
    Fetched {
        image: None,
        small: None,
        tint: vec3(1.0),
        load: None,
        decode: None,
        requested: false,
    }
}

// What a picture is to the home: a cover (on its tile, and its small copy and its colour standing
// for the hero), a hero (behind it all, lending its colour) or a title art.
enum Role: Copy + Eq { Cover, Hero, Title }

// A picture to draw over the backdrop this frame, in device pixels: whose art (a cover, or the
// title art), the game, where, how opaque, its corners' radius and how bright.
enum Layer: Copy + Eq { Cover, Logo }

struct Drawn: Copy {
    layer: Layer,
    index: u32,
    rect: Rect,
    alpha: f32,
    radius: f32,
    bright: f32,
}

pub struct Console {
    fonts: Fonts,
    renderer: Renderer,
    draw: DrawList,
    linear: Sampler,
    blank: Texture<Rgba8>,
    room: Texture<Rgba16Float>,
    // The tesseract's struts and panes as the tracer reads them (`tesseract::shapes`), and what
    // the room holds: its turn and look when it was traced, and when (host seconds).
    struts: GpuBuffer<vec4>,
    panes: GpuBuffer<vec4>,
    // Which of them each tile of the room can see (`tesseract::tiles`).
    tiles: GpuBuffer<vec4u>,
    traced: Option<(f32, Artifact)>,
    traced_at: f32,
    // The room shows an older tracing than the tesseract has turned to: one is due.
    behind: bool,
    mark: GpuBuffer<MarkRun>,
    // The marks' ink, the opening's and the header's (`ink`), and the centre and size each was
    // inked for (a size of 0: none).
    inks: Vec<Texture<Rgba8>>,
    inked: Vec<vec4>,
    covers: Vec<Fetched>,
    heroes: Vec<Fetched>,
    logos: Vec<Fetched>,
    // The pictures laid out this frame, drawn over the backdrop.
    drawn: Vec<Drawn>,
    // How far the chosen game's hero and title art have come in over what stands for them.
    hero_in: f32,
    logo_in: f32,
    // Each tile's light (0 to 1) as the selection and the pointer move, and how far the shelf
    // has slid to keep the selection in view (logical pixels).
    tiles_lit: Vec<f32>,
    shelf: f32,
    // The save last chosen in the Load sheet: what Export writes.
    marked: u32,
    // The camera's drift toward the pointer, which the hero follows a little.
    sway: vec2,
    reveal: f32,
    sheet: f32,
    sheet_pane: Pane,
    dt: f32,
    ring: Rect,
    ring_alpha: f32,
    catalog_load: Option<Pending<u8>>,
    profile_load: Option<Pending<u8>>,
    profile_write: Option<Pending<u8>>,
    environment: Option<Pending<u8>>,
    // The page's address, read once: a game's name left in it (a reload, a link) is dropped,
    // since the console opens at its library.
    address: Option<Pending<u8>>,
    pending: Option<Pending<u8>>,
    closing: Option<Pending<u8>>,
    // The session answering is for a selection made before.
    stale: bool,
    cards: Vec<Card>,
    selected: u32,
    profile: Profile,
    profile_ready: bool,
    pane: Pane,
    step: Step,
    handle: Option<u32>,
    saves: Vec<SaveInfo>,
    picked: u32,
    prepared_slot: Option<String>,
    wanted_slot: String,
    exporting: Option<ExportPlan>,
    play_intent: Option<PlayIntent>,
    need_open: bool,
    message: String,
    pixel_ratio: f32,
    reduced: bool,
    intro_until: f32,
    focus: Action,
    controls: Vec<Control>,
    shown: Vec<Control>,
    activate: Option<Action>,
    enter: bool,
    input: Input,
    stick: vec2,
    clicked: Option<vec2>,
    pressed: Option<vec2>,
    // Where the pointer is (logical pixels), what it is over, and the cursor shown for it.
    pointer: Option<vec2>,
    hover: Option<Action>,
    // What glows (`glow`), and how far it has come on.
    glowing: Option<Action>,
    glow: f32,
    // The game whose title shows, and how far it has eased in (out, while another is chosen).
    title_shown: u32,
    title_in: f32,
    pointing: bool,
    cursor: Option<Pending<u8>>,
    // Whether this page load reloaded the tab, from the environment: a reload starts at the
    // library, and a visit plays the opening. The clock waits for the answer, briefly, in the
    // dark.
    reloaded: Option<bool>,
    decided: bool,
    waited: f32,
    // The games' files, fetched ahead of time once the console has what it shows
    // (`prefetch_games`): which games are done, the one under way, and what is pending.
    prefetched: Vec<bool>,
    prefetch_game: u32,
    prefetch_list: Option<Pending<u8>>,
    prefetching: Option<Pending<u8>>,
    // The home's light: the colour of the selected game's art, and how far it takes it.
    tint: vec4,
    // The theme's voice, the selection's theme as it's fetched and read, which game's theme the
    // voice holds, the level last asked of it and when it was asked to fall quiet; and the music
    // setting, as it's read and written.
    voice: RingWriter<Cue>,
    theme_of: Option<u32>,
    theme_load: Option<Pending<u8>>,
    theme: Option<Theme>,
    theme_sent: Option<u32>,
    voice_level: f32,
    quiet_at: f32,
    music: bool,
    music_load: Option<Pending<u8>>,
    music_write: Option<Pending<u8>>,
    // The page's icons, asked for once.
    icons: Vec<Pending<u8>>,
    retry_at: f32,
    zoom: f32,
    time: Option<f32>,
    presentation: f32,
    // When the screen was last drawn (host seconds) and at what size; whether something has
    // changed since, and whether all that eases had settled when it was drawn (`due`).
    drawn_at: Option<f32>,
    drawn_presentation: f32,
    drawn_size: (u32, u32),
    dirty: bool,
    settled: bool,
    // How many steps coarser the tesseract is traced, and the frames counted toward the next
    // step and the seconds between them (`strained`).
    coarser: u32,
    counted: u32,
    spent: f32,
    // The account: sign-in, the knighting, the legal pages and the games' boards (account.wrela).
    account: account::Accounts,
}

// Asks the host to show the console's icons in the page's tab, bookmarks and home screen. A
// host without a page (the native one) declines, and nothing waits on it.
fn page_icons() -> Vec<Pending<u8>> {
    var out: Vec<Pending<u8>> = Vec::new()
    for i in 0..icon::ICONS.len() {
        let size = icon::SIZES[i]
        let rel = if size >= 180 { "apple-touch-icon" } else { "icon" }
        out.push(host::icon(rel, size, icon::ICONS.path(i).as_str()))
    }
    out
}

pub fn init() -> Console {
    var fonts = Fonts::from_baked(MANROPE, facet::FONT)
    // Manrope set a little closer and a little heavier, so short labels hold together.
    fonts.sans.tracking = -0.012
    fonts.sans.weight = 0.012
    let renderer = Renderer::new(fonts)
    Console {
        fonts,
        renderer,
        draw: DrawList::new(),
        linear: sampler(),
        blank: texture(width: 1, height: 1),
        room: texture(width: 1, height: 1),
        struts: buffer(EDGES * STRUT_WORDS),
        panes: buffer(FACES * PANE_WORDS),
        tiles: buffer(1),
        traced: None,
        traced_at: 0.0,
        behind: false,
        mark: buffer_of(MARK_RUNS),
        inks: Vec::from_fn(2, |_| texture::<Rgba8>(width: 1, height: 1)),
        inked: Vec::filled(2, value: vec4(0.0)),
        covers: Vec::new(),
        heroes: Vec::new(),
        logos: Vec::new(),
        drawn: Vec::new(),
        hero_in: 0.0,
        logo_in: 0.0,
        tiles_lit: Vec::new(),
        shelf: 0.0,
        marked: 0,
        sway: vec2(0.0),
        reveal: 0.0,
        sheet: 0.0,
        sheet_pane: Pane::Saves,
        dt: 0.0,
        ring: Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0),
        ring_alpha: 0.0,
        catalog_load: Some(fetch("catalog.tsv")),
        profile_load: Some(read_file("console/profile")),
        profile_write: None,
        environment: Some(host::environment()),
        address: Some(host::address()),
        pending: None,
        closing: None,
        stale: false,
        cards: Vec::new(),
        selected: 0,
        profile: Profile {
            version: 1,
            key: String::from("player-1"),
            name: String::from("Player 1"),
            game: String::new(),
            motion: true,
        },
        profile_ready: false,
        pane: Pane::Games,
        step: Step::Idle,
        handle: None,
        saves: Vec::new(),
        picked: 0,
        prepared_slot: None,
        wanted_slot: String::new(),
        exporting: None,
        play_intent: None,
        need_open: false,
        message: String::new(),
        pixel_ratio: 1.0,
        reduced: false,
        intro_until: OPENING_SECONDS,
        focus: Action::Play,
        controls: Vec::new(),
        shown: Vec::new(),
        activate: None,
        enter: false,
        input: Input::Keys,
        stick: vec2(0.0),
        clicked: None,
        pressed: None,
        pointer: None,
        hover: None,
        glowing: None,
        glow: 0.0,
        title_shown: 0,
        title_in: 1.0,
        pointing: false,
        cursor: None,
        reloaded: None,
        decided: false,
        waited: 0.0,
        prefetched: Vec::new(),
        prefetch_game: 0,
        prefetch_list: None,
        prefetching: None,
        tint: vec4(1.0, 1.0, 1.0, 0.0),
        voice: theme::start(),
        theme_of: None,
        theme_load: None,
        theme: None,
        theme_sent: None,
        voice_level: 0.0,
        quiet_at: -100.0,
        music: true,
        music_load: Some(read_file(MUSIC)),
        music_write: None,
        icons: page_icons(),
        retry_at: 0.0,
        zoom: 1.0,
        time: None,
        presentation: 0.0,
        drawn_at: None,
        drawn_presentation: 0.0,
        drawn_size: (0, 0),
        dirty: true,
        settled: false,
        coarser: 0,
        counted: 0,
        spent: 0.0,
        account: account::new(RP_ID),
    }
}

fn poll(pending: mut Option<Pending<u8>>) -> Option<Result<Vec<u8>, std::io::IoError>> {
    var answer = None
    match mut pending {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if answer.is_some() { pending = None }
    answer
}

fn call(s: mut Console, request: Request, step: Step) {
    let Some(id) = s.handle else { return }
    let bytes = save(request)
    s.pending = Some(host::send(id, bytes))
    s.step = step
}

fn list(s: mut Console) {
    let request = Request::List { profile: s.profile.key.clone() }
    call(mut s, request, Step::List)
}

fn prepare_game(s: mut Console, slot: String) {
    s.wanted_slot = slot.clone()
    let request = Request::Prepare { profile: s.profile.key.clone(), slot: slot.clone() }
    call(mut s, request, Step::Prepare)
}

fn start(s: mut Console) {
    call(mut s, Request::Start, Step::Start)
}

// A queued play always uses the latest explicit selection, even if a different slot finishes preparing.
fn play_plan(
    prepared: Option<String>,
    saves: [SaveInfo],
    picked: u32,
    intent: PlayIntent,
) -> PlayPlan {
    let slot = if intent == PlayIntent::NewGame || saves.len() == 0 { String::new() } else {
        saves[min(picked, saves.len() - 1)].slot.clone()
    }
    if let Some(ready) = prepared { if ready == slot { return PlayPlan::Start } }
    PlayPlan::Prepare { slot }
}

fn fulfill_play(s: mut Console) {
    let Some(intent) = s.play_intent else { return }
    if s.step != Step::Idle || s.closing.is_some() || s.cards.is_empty() { return }
    if s.handle.is_none() {
        s.need_open = true
        return
    }
    match play_plan(s.prepared_slot, s.saves, s.picked, intent) {
        PlayPlan::Start => start(mut s),
        PlayPlan::Prepare { slot } => prepare_game(mut s, slot.clone()),
    }
}

// Whether the console is only reading the selection's saves, so another may be selected: not
// while a game starts or shows, or a save moves.
fn browsing(step: Step) -> bool {
    step == Step::Idle || step == Step::Open || step == Step::List || step == Step::Prepare
}

// Drops the session of a selection made before, once its answer is in: `id` if it opened.
fn abandon(s: mut Console, id: Option<u32>) {
    s.stale = false
    s.step = Step::Idle
    s.prepared_slot = None
    match id {
        Some(id) => s.closing = Some(host::close(id)),
        None => s.need_open = true,
    }
    s.handle = None
}

fn open_selected(s: mut Console) {
    if s.cards.is_empty() { return }
    s.message.clear()
    s.saves.clear()
    s.picked = 0
    s.prepared_slot = None
    s.profile.game = s.cards[s.selected].id.clone()
    let bytes = save(s.profile)
    s.profile_write = Some(store("console/profile", bytes))
    // Opening takes the network from what is fetched ahead (the host stops it): the game under
    // way isn't done, and is fetched again, mostly from the browser's cache.
    s.prefetching = None
    s.pending = Some(host::open(s.cards[s.selected].session))
    s.step = Step::Open
    s.need_open = false
}

// Drops what was asked of the session: a play, the step under way, a prepared save, an export.
fn stop(s: mut Console) {
    s.play_intent = None
    s.step = Step::Idle
    s.prepared_slot = None
    s.exporting = None
}

fn failed(s: mut Console, message: str) {
    s.message = message.to_string()
    stop(mut s)
}

// A dropped request or a connection that fails is tried again after a pause: nothing to
// read, nothing to press.
fn quietly_retry(s: mut Console) {
    stop(mut s)
    if let Some(id) = s.handle { s.closing = Some(host::close(id)) }
    s.handle = None
    s.need_open = false
    s.retry_at = s.presentation + RETRY_SECONDS
}

// Closes the session, if one is open, so that the selection's opens: now, or once it has
// closed.
fn reopen(s: mut Console) {
    s.need_open = s.handle.is_none()
    if let Some(id) = s.handle { s.closing = Some(host::close(id)) }
    s.handle = None
}

// A quiet retry reopens the session once its pause is over and the old one has closed.
fn retry_due(at: f32, now: f32, closing: bool) -> bool {
    at > 0.0 && now >= at && !closing
}

fn export_plan(game: str, profile: str, slot: str) -> ExportPlan {
    ExportPlan { game: game.to_string(), profile: profile.to_string(), slot: slot.to_string() }
}

fn export_name(plan: ExportPlan) -> String {
    f"wrela-{plan.game}-{plan.profile}-{plan.slot}.wrela-save"
}

fn answer(s: mut Console, bytes: take Vec<u8>) {
    if s.stale {
        let id = if s.step == Step::Open { host::read_surface(bytes) } else { s.handle }
        abandon(mut s, id)
        return
    }
    match s.step {
        Step::Open => {
            let Some(id) = host::read_surface(bytes) else {
                quietly_retry(mut s)
                return
            }
            s.handle = Some(id)
            list(mut s)
        },
        Step::List | Step::Prepare | Step::Start | Step::Export | Step::Import => {
            let result: Result<Reply, LoadError> = load(bytes.clone())
            let Ok(reply) = result else {
                failed(mut s, "The game sent an unsupported response.")
                return
            }
            match reply {
                Reply::Error { message } => failed(mut s, message),
                Reply::Saves { entries } => {
                    if entries.len() > 256 {
                        failed(mut s, "The game sent too many saves.")
                        return
                    }
                    for entry in entries {
                        if !valid_key(entry.slot) ||
                            entry.label.len() > 160 ||
                            entry.description.len() > 512 {
                            failed(mut s, "The game sent unsupported save details.")
                            return
                        }
                    }
                    s.saves = entries.clone()
                    s.picked = 0
                    let slot = if s.saves.is_empty() { String::new() } else {
                        s.saves[0].slot.clone()
                    }
                    prepare_game(mut s, slot)
                },
                Reply::Ready => {
                    s.prepared_slot = Some(s.wanted_slot.clone())
                    s.step = Step::Idle
                },
                Reply::Started => {
                    let Some(id) = s.handle else { return }
                    s.pending = Some(host::wait_ready(id))
                    s.step = Step::Frame
                },
                Reply::Exported { bytes } => {
                    let Some(plan) = s.exporting else {
                        failed(mut s, "The game sent an unsupported response.")
                        return
                    }
                    let name = export_name(plan)
                    s.pending = Some(host::export_file(name, bytes))
                    s.exporting = None
                    s.step = Step::Download
                },
                Reply::Imported => {
                    s.message = String::from("Save imported.")
                    list(mut s)
                },
            }
        },
        Step::Frame => {
            let Some(id) = s.handle else { return }
            s.pending = Some(host::show(id, s.profile.game))
            account::game_shown(mut s.account, id, s.profile.game)
            // Keep the closure request alive before the host suspends this console.
            s.closing = Some(host::wait_closed(id))
            s.step = Step::Show
        },
        Step::Show => {
            s.step = Step::Closed
            s.play_intent = None
        },
        Step::Download => {
            s.step = Step::Idle
            s.message = String::from("Save exported.")
        },
        Step::PickFile => {
            let request = Request::Import { profile: s.profile.key.clone(), bytes }
            call(mut s, request, Step::Import)
        },
        _ => s.step = Step::Idle,
    }
}

fn catalog_result(bytes: Vec<u8>) -> Result<Vec<Card>, String> {
    if let Some(text) = String::from_utf8(bytes.clone()) {
        if let Some(cards) = parse(text) { return Ok(cards.clone()) }
    }
    Err(String::from("The game library could not be read."))
}

// Covers within reach of the selection hold textures and requests: enough for the shelf.
const COVER_REACH: u32 = 6

// The colour a cover's art lends the light: its colourful, bright parts averaged, at full
// brightness. Grey art lends white.
fn palette(bytes: Vec<u8>, width: u32, height: u32) -> vec3 {
    var sum = vec3(0.0)
    var weight = 0.0
    for y in 0..height / 4 {
        for x in 0..width / 4 {
            let i = (y * 4 * width + x * 4) * 4
            let c = vec3(f32(bytes[i]), f32(bytes[i + 1]), f32(bytes[i + 2])) / 255.0
            let top = max(c.x, max(c.y, c.z))
            let w = (top - min(c.x, min(c.y, c.z))) * top
            sum += c * w
            weight += w
        }
    }
    let top = max(sum.x, max(sum.y, sum.z))
    if top <= 0.0 { vec3(1.0) } else { sum / top }
}

// Fetches and decodes `art` into `f` while it's `wanted`, as its `role` needs it, and lets go of it
// when it isn't: whether it changed what shows. Art with no path is never fetched.
fn arrive(f: mut Fetched, art: Art, wanted: bool, role: Role) -> bool {
    if !wanted || art.path.is_empty() {
        let had = f.image.is_some()
        f.image = None
        f.small = None
        f.load = None
        f.decode = None
        f.requested = false
        return had
    }
    if !f.requested {
        f.load = Some(fetch(art.path))
        f.requested = true
    }
    if let Some(result) = poll(mut f.load) {
        if let Ok(bytes) = result {
            f.decode = Some(host::decode_image(bytes, art.width, art.height))
        }
    }
    let Some(result) = poll(mut f.decode) else { return false }
    if let Ok(bytes) = result {
        // The host decodes only art of the size the catalog says.
        if bytes.len() == art.width * art.height * 4 {
            if role != Role::Title { f.tint = palette(bytes, art.width, art.height) }
            if role == Role::Cover {
                let (w, h) = small_size(art.width, art.height)
                var small = texture::<Rgba8>(width: w, height: h)
                let shrunk = shrunk(bytes, art.width, art.height, to_width: w, to_height: h)
                small.write(x: 0, y: 0, width: w, height: h, bytes: shrunk)
                f.small = Some(take small)
            }
            if role == Role::Hero {
                var image = texture::<Rgba8>(width: art.width, height: art.height)
                image.write(x: 0, y: 0, width: art.width, height: art.height, bytes: bytes)
                f.image = Some(take image)
            } else { f.image = Some(picture_texture(bytes, art.width, art.height)) }
        }
    }
    true
}

// A small copy's size: 48 pixels across, its height keeping the aspect.
fn small_size(width: u32, height: u32) -> (u32, u32) {
    let w = min(width, 48)
    (w, max(u32(round(f32(height) * f32(w) / f32(width))), 1))
}

// `bytes`' RGBA pixels, `width` × `height`, shrunk to `to_width` × `to_height`: each pixel the
// mean of the box of pixels it covers.
fn shrunk(bytes: [u8], width: u32, height: u32, to_width: u32, to_height: u32) -> Vec<u8> {
    let (w, h) = (to_width, to_height)
    var out: Vec<u8> = Vec::new()
    for y in 0..h {
        for x in 0..w {
            let (x0, x1) = (x * width / w, max((x + 1) * width / w, x * width / w + 1))
            let (y0, y1) = (y * height / h, max((y + 1) * height / h, y * height / h + 1))
            var sum = vec4(0.0)
            for yy in y0..y1 {
                for xx in x0..x1 {
                    let i = (yy * width + xx) * 4
                    sum += vec4(
                        f32(bytes[i]),
                        f32(bytes[i + 1]),
                        f32(bytes[i + 2]),
                        f32(bytes[i + 3]),
                    )
                }
            }
            let mean = sum / f32((x1 - x0) * (y1 - y0))
            for c in [mean.x, mean.y, mean.z, mean.w] { out.push(u8(round(c))) }
        }
    }
    out
}

// A picture drawn smaller than it is, from `bytes`' RGBA pixels, `width` × `height`: premultiplied
// by its alpha, so its edges take none of the colour under its clear pixels as it's filtered, and
// with its whole mip chain, each level the mean of the one before (`paint::picture`).
fn picture_texture(bytes: [u8], width: u32, height: u32) -> Texture<Rgba8> {
    var level: Vec<u8> = Vec::new()
    for i in 0..width * height {
        let a = u32(bytes[i * 4 + 3])
        for c in 0..3 { level.push(u8((u32(bytes[i * 4 + c]) * a + 127) / 255)) }
        level.push(u8(a))
    }
    let levels = mip_levels(width, height)
    var image = texture::<Rgba8>(width: width, height: height, levels: levels)
    var w = width
    var h = height
    for k in 0..levels {
        if k > 0 {
            let (next_w, next_h) = (max(w / 2, 1), max(h / 2, 1))
            level = shrunk(level, w, h, to_width: next_w, to_height: next_h)
            w = next_w
            h = next_h
        }
        image.write(x: 0, y: 0, width: w, height: h, bytes: level, level: k)
    }
    image
}

fn near_cover(index: u32, selected: u32) -> bool {
    if index >= selected { index - selected <= COVER_REACH } else {
        selected - index <= COVER_REACH
    }
}

fn update(s: mut Console) {
    if let Some(Ok(bytes)) = poll(mut s.address) {
        // The answer to the replacement is empty, so this happens once.
        if let Some(kept) = without_fragment(bytes) {
            s.address = Some(host::replace_address(kept.as_str()))
        }
    }
    if let Some(result) = poll(mut s.environment) {
        s.dirty = true
        s.reloaded = Some(false)
        if let Ok(bytes) = result {
            let env = host::read_environment(bytes)
            if !bytes.is_empty() { s.reduced = env.reduced_motion }
            s.reloaded = Some(env.reloaded)
            if let Some(ratio) = env.pixel_ratio { s.pixel_ratio = clamp(ratio, 0.5, 4.0) }
        }
    }
    if let Some(result) = poll(mut s.profile_load) {
        s.dirty = true
        s.profile_ready = true
        if let Ok(bytes) = result {
            let profile: Result<Profile, LoadError> = load(bytes.clone())
            if let Ok(p) = profile {
                if p.version == 1 && valid_key(p.key) && p.name.len() <= 160 {
                    s.profile = p.clone()
                }
            }
        }
    }
    if let Some(result) = poll(mut s.catalog_load) {
        s.dirty = true
        match result {
            Ok(bytes) => match catalog_result(bytes) {
                Ok(cards) => {
                    s.cards = cards.clone()
                    s.prefetched = Vec::filled(cards.len(), value: false)
                    s.tiles_lit = Vec::filled(cards.len(), value: 0.0)
                    for _ in 0..cards.len() {
                        s.covers.push(fetched())
                        s.heroes.push(fetched())
                        s.logos.push(fetched())
                    }
                    s.need_open = true
                },
                Err(message) => s.message = message.clone(),
            },
            Err(_) => s.message = String::from(
                "The game library could not load. Check your connection and reload.",
            ),
        }
    }
    if s.need_open && s.profile_ready && s.step == Step::Idle {
        for i in 0..s.cards.len() { if s.cards[i].id == s.profile.game { s.selected = i } }
        open_selected(mut s)
    }
    // Only covers near the selection hold textures or requests, and only the chosen game's hero
    // and title art (and the one easing out's).
    for i in 0..s.cards.len() {
        borrow card = s.cards[i]
        let chosen = i == s.selected || i == s.title_shown
        let near = near_cover(i, s.selected)
        if arrive(mut s.covers[i], card.cover, near, Role::Cover) { s.dirty = true }
        if arrive(mut s.heroes[i], card.hero, chosen, Role::Hero) { s.dirty = true }
        if arrive(mut s.logos[i], card.logo, chosen, Role::Title) { s.dirty = true }
    }
    if let Some(Ok(bytes)) = poll(mut s.music_load) {
        s.music = bytes.is_empty() || bytes[0] != 0
    }
    let _ = poll(mut s.music_write)
    if let Some(result) = poll(mut s.profile_write) {
        if result.is_err() {
            s.dirty = true
            s.message = String::from("Your profile could not be saved on this device.")
        }
    }
    if let Some(result) = poll(mut s.pending) {
        s.dirty = true
        match result {
            Ok(bytes) => answer(mut s, bytes.clone()),
            Err(_) => if s.stale {
                let id = s.handle
                abandon(mut s, id)
            } else { quietly_retry(mut s) },
        }
    }
    if poll(mut s.closing).is_some() {
        s.dirty = true
        account::game_closed(mut s.account)
        // A game that was starting or playing has closed; a session closed only to change the
        // selection keeps a play already asked of the new one.
        if s.step != Step::Idle { s.play_intent = None }
        s.handle = None
        s.step = Step::Idle
        s.need_open = s.retry_at == 0.0
    }
    if retry_due(s.retry_at, s.presentation, s.closing.is_some()) {
        s.dirty = true
        s.retry_at = 0.0
        s.need_open = true
    }
    let _ = poll(mut s.cursor)
    fulfill_play(mut s)
    if account::update(mut s.account, s.presentation) { s.dirty = true }
}

fn open_pane(s: mut Console, pane: Pane) {
    s.pane = pane
    s.focus = match pane {
        Pane::Games => Action::Play,
        Pane::Saves => if s.saves.is_empty() { Action::Import } else { Action::Save { index: 0 } },
        Pane::Settings => Action::Name,
    }
}

fn play(s: mut Console, intent: PlayIntent) {
    if s.cards.is_empty() { return }
    s.play_intent = Some(intent)
    fulfill_play(mut s)
}

// The selected title's actions: Play (which continues once there are saves), then New game and
// Load once there are saves.
fn actions(has_saves: bool) -> Vec<Action> {
    var out: Vec<Action> = Vec::new()
    out.push(Action::Play)
    if has_saves {
        out.push(Action::NewGame)
        out.push(Action::Load)
    }
    out
}

fn act(s: mut Console, action: Action) {
    match action {
        Action::Games => open_pane(mut s, Pane::Games),
        Action::Load => open_pane(mut s, Pane::Saves),
        Action::Settings => {
            let pane = if s.pane == Pane::Settings { Pane::Games } else { Pane::Settings }
            open_pane(mut s, pane)
        },
        Action::Name => {},
        Action::Music => {
            // The stored setting, if it's still being read, is this one's now.
            s.music_load = None
            s.music = !s.music
            s.music_write = Some(store(MUSIC, [u8(if s.music { 1 } else { 0 })]))
        },
        Action::SaveProfile => {
            if s.profile.name.trim().is_empty() {
                s.message = String::from("Enter a name for this profile.")
                return
            }
            let bytes = save(s.profile)
            s.profile_write = Some(store("console/profile", bytes))
            s.message = String::from("Profile saved.")
        },
        Action::Game { index } => {
            // The selected game's own action is to play it: continue, or begin.
            if index == s.selected {
                act(mut s, Action::Play)
                return
            }
            if !browsing(s.step) { return }
            s.selected = index
            s.profile.game = s.cards[index].id.clone()
            s.saves.clear()
            s.play_intent = None
            s.retry_at = 0.0
            // A session still answering is the last selection's: it is closed when it answers,
            // and one closing already opens the selection's when it has closed.
            if s.step != Step::Idle {
                s.stale = true
            } else if s.closing.is_none() {
                reopen(mut s)
            }
        },
        // Loading a save plays it.
        Action::Save { index } => {
            if index != s.picked { s.prepared_slot = None }
            s.picked = index
            play(mut s, PlayIntent::Selected)
        },
        // Play continues the most recent save, once the saves are read; with none it begins
        // (`play_plan`).
        Action::Play => {
            if s.picked != 0 { s.prepared_slot = None }
            s.picked = 0
            play(mut s, PlayIntent::Selected)
        },
        Action::NewGame => play(mut s, PlayIntent::NewGame),
        Action::Page { first } => {
            s.marked = first
            s.focus = Action::Save { index: first }
        },
        Action::Export => {
            if s.step == Step::Idle && !s.saves.is_empty() {
                let plan = export_plan(
                    s.cards[s.selected].id,
                    s.profile.key,
                    s.saves[min(s.marked, s.saves.len() - 1)].slot,
                )
                s.exporting = Some(plan.clone())
                let request = Request::Export {
                    profile: plan.profile.clone(),
                    slot: plan.slot.clone(),
                }
                call(mut s, request, Step::Export)
            }
        },
        Action::Import => {
            if s.step == Step::Idle {
                s.pending = Some(host::import_file())
                s.step = Step::PickFile
            }
        },
        Action::Retry => { if s.step == Step::Idle && s.closing.is_none() { reopen(mut s) } },
    }
}

// ---- focus ---------------------------------------------------------------------------------

// The control a move reaches from `from`: across its row, or to the first control of the
// next row in that direction. Rows are counted top to bottom.
fn neighbour(controls: [Control], from: Action, to: Move) -> Option<Action> {
    let dx = match to {
        Move::Left => -1,
        Move::Right => 1,
        _ => 0,
    }
    let dy = match to {
        Move::Up => -1,
        Move::Down => 1,
        _ => 0,
    }
    var at = None
    for c in controls { if c.action == from { at = Some(c) } }
    let Some(here) = at else {
        if controls.len() == 0 { return None }
        return Some(controls[0].action)
    }
    let centre = here.rect.center()
    var best: Option<Action> = None
    var score = 1.0e9
    if dx != 0 {
        for c in controls {
            let ahead = (c.rect.center().x - centre.x) * f32(dx)
            if c.row == here.row && ahead > 1.0 && ahead < score {
                score = ahead
                best = Some(c.action)
            }
        }
        return best
    }
    var row = -1
    for c in controls {
        let gap = (i32(c.row) - i32(here.row)) * dy
        if gap > 0 && (row < 0 || gap < row) { row = gap }
    }
    if row < 0 { return None }
    // A row is entered at its first control: the main action leads each row.
    for c in controls {
        if (i32(c.row) - i32(here.row)) * dy == row {
            let d = c.rect.x
            if d < score {
                score = d
                best = Some(c.action)
            }
        }
    }
    best
}

fn under(controls: [Control], at: vec2) -> Option<Action> {
    var found = None
    for c in controls { if c.rect.contains(at) { found = Some(c.action) } }
    found
}

fn navigate(s: mut Console, to: Move) {
    let Some(next) = neighbour(s.shown, s.focus, to) else { return }
    let on_shelf = match s.focus {
        Action::Game { .. } => true,
        _ => false,
    }
    match next {
        Action::Game { index } => {
            // Coming onto the shelf lands on the chosen game; moving along it chooses, as a
            // console does.
            if on_shelf && index != s.selected { act(mut s, next) }
            s.focus = Action::Game { index: s.selected }
        },
        _ => s.focus = next,
    }
}

fn control(s: mut Console, action: Action, r: Rect, row: u32, kind: Kind) -> bool {
    s.controls.push(Control { action, rect: r, row, kind })
    let clicked = match (s.clicked, s.pressed) {
        (Some(up), Some(down)) => r.contains(up / s.zoom) && r.contains(down / s.zoom),
        _ => false,
    }
    let focus = s.focus == action
    if s.reveal > 0.95 && s.activate.is_none() && ((focus && s.enter) || clicked) {
        s.activate = Some(action)
    }
    lit(s, action)
}

// Which control shows as chosen: the one under the pointer while the pointer is in use,
// otherwise the one with focus.
fn lit(s: Console, action: Action) -> bool {
    if s.input == Input::Pointer { s.hover == Some(action) } else { s.focus == action }
}

// ---- drawing -------------------------------------------------------------------------------

fn text(s: mut Console, content: str, size: f32, at: vec2, color: vec4, face: Face = Face::Sans) {
    // Glyphs start on a whole device pixel, as a browser lays out text.
    let _ = s.draw.text(
        s.fonts,
        face,
        content,
        size * s.zoom,
        vec2(round(at.x * s.zoom), at.y * s.zoom),
        vec4(color.xyz, color.w * s.reveal),
    )
}

// A logical rectangle on whole device pixels: its edges, not its size, are rounded, so
// neighbouring shapes meet exactly and every edge is crisp.
fn snapped(r: Rect, zoom: f32) -> Rect {
    let x0 = round(r.x * zoom)
    let y0 = round(r.y * zoom)
    Rect::new(x0, y0, round(r.right() * zoom) - x0, round(r.bottom() * zoom) - y0)
}

fn ring(s: mut Console, r: Rect, color: vec4, radius: f32 = 0.0, width: f32 = 1.0) {
    s.draw.ring(
        snapped(r, s.zoom),
        vec4(color.xyz, color.w * s.reveal),
        radius: radius * s.zoom,
        width: max(round(width * s.zoom), 1.0),
    )
}

fn width_of(s: Console, content: str, size: f32, face: Face) -> f32 {
    s.fonts.font(face).measure(content, size)
}

// The size at most `size` that fits `content` in `room`.
fn fitted(s: Console, content: str, size: f32, room: f32, face: Face) -> f32 {
    min(size, size * room / max(width_of(s, content, size, face), 1.0))
}

fn centered(s: mut Console, content: str, size: f32, x: f32, y: f32, color: vec4, face: Face) {
    let w = width_of(s, content, size, face)
    text(mut s, content, size, vec2(x - w * 0.5, y), color, face)
}

fn rect(s: mut Console, r: Rect, color: vec4, radius: f32 = 0.0) {
    s.draw.rect(snapped(r, s.zoom), vec4(color.xyz, color.w * s.reveal), radius * s.zoom)
}

// Where a line of `face` at `size` starts so that its capitals stand centred on `middle`.
fn line_top(s: Console, face: Face, size: f32, middle: f32) -> f32 {
    let cap = if face == Face::Sans { SANS_CAP } else { facet::CAP }
    middle - (s.fonts.font(face).ascender - cap * 0.5) * size
}

// A button's width for `label`: the primary one's, its label larger, wider still; `tight`, only
// as wide as its label needs.
fn button_width(s: Console, label: str, primary: bool = false, tight: bool = false) -> f32 {
    let (size, pad, least) = if primary { (CALL, 44.0, 132.0) } else { (LABEL, 36.0, 88.0) }
    let need = width_of(s, label, size, Face::Sans) + pad
    if tight { need - 12.0 } else { max(least, need) }
}

// The width of a row of buttons labelled `labels`, the first the primary.
fn row_width(s: Console, labels: [String], tight: bool) -> f32 {
    var sum = f32(labels.len() - 1) * 10.0
    for i in 0..labels.len() { sum += button_width(s, labels[i], primary: i == 0, tight: tight) }
    sum
}

// A button: the primary one solid, the rest quiet behind a hairline. Under the pointer it
// eases a shade toward the light (`glow`); with keys or a pad the focus ring marks it.
fn button(s: mut Console, action: Action, r: Rect, row: u32, label: str, primary: bool = false) {
    let size = if primary { CALL } else { LABEL }
    let _ = control(mut s, action, r, row, Kind::Button)
    let hover = if s.input == Input::Pointer { glow(s, action) } else { 0.0 }
    if primary {
        rect(mut s, r, mix(INK, vec4(0.9, 0.9, 0.91, 1.0), hover), RADIUS)
    } else {
        rect(mut s, r, mix(SECONDARY, RAISED, hover), RADIUS)
        ring(mut s, r, BORDER, RADIUS)
    }
    let c = r.center()
    let y = line_top(s, Face::Sans, size, c.y)
    centered(mut s, label, size, c.x, y, if primary { DARK } else { INK }, Face::Sans)
}

// The title showing, and how far it has eased in, `dt` seconds on with `selected` chosen: one
// that isn't the selection's eases out in an eighth of a second, then the selection's eases in
// over three tenths.
fn title_step(shown: u32, eased: f32, selected: u32, dt: f32) -> (u32, f32) {
    if shown == selected { return (shown, min(eased + dt / 0.3, 1.0)) }
    let out = max(eased - dt / 0.12, 0.0)
    if out == 0.0 { (selected, 0.0) } else { (shown, out) }
}

// How far the hover or focus on `action` has come on: from 0 when it arrives to 1 a quarter
// second later, eased, so it settles rather than snaps.
fn glow(s: Console, action: Action) -> f32 {
    if s.glowing == Some(action) { smoothstep(0.0, 1.0, s.glow) } else { 0.0 }
}

// A line `stroke` wide from `a` to `b`, level or upright.
fn stroke(s: mut Console, a: vec2, b: vec2, width: f32) {
    let lo = min(a, b) - vec2(width * 0.5)
    let hi = max(a, b) + vec2(width * 0.5)
    rect(mut s, Rect::spanning(lo, hi), INK, width * 0.5)
}

// Settings: a quiet square button holding two sliders, as Lucide draws its settings-2 icon
// on a 24-unit grid.
fn settings_button(s: mut Console, r: Rect) {
    let _ = control(mut s, Action::Settings, r, 0, Kind::Icon)
    let hover = if s.input == Input::Pointer { glow(s, Action::Settings) } else { 0.0 }
    let shown = if s.pane == Pane::Settings { 1.0 } else { hover }
    if shown > 0.0 { rect(mut s, r, vec4(RAISED.xyz, RAISED.w * shown), RADIUS) }
    let unit = 20.0 / 24.0
    let o = r.center() - vec2(12.0 * unit)
    let width = 1.75
    stroke(mut s, o + vec2(11.0, 7.0) * unit, o + vec2(20.0, 7.0) * unit, width)
    stroke(mut s, o + vec2(5.0, 17.0) * unit, o + vec2(14.0, 17.0) * unit, width)
    for centre in [vec2(7.0, 7.0), vec2(17.0, 17.0)] {
        let c = o + centre * unit
        let outer = 3.0 * unit + width * 0.5
        let disc = Rect::new(c.x - outer, c.y - outer, outer * 2.0, outer * 2.0)
        ring(mut s, disc, INK, outer, width)
    }
}

fn key_width(s: Console, cap: str) -> f32 {
    max(22.0, width_of(s, cap, 11.0, Face::Sans) + 12.0)
}

// A key hint: the key in a small bordered cap, then what it does. How wide it was.
fn keycap(s: mut Console, at: vec2, cap: str, label: str) -> f32 {
    let w = key_width(s, cap)
    let r = Rect::new(at.x, at.y, w, 22.0)
    rect(mut s, r, SECONDARY, 5.0)
    ring(mut s, r, BORDER, 5.0)
    let middle = r.center().y
    centered(
        mut s,
        cap,
        11.0,
        at.x + w * 0.5,
        line_top(s, Face::Sans, 11.0, middle),
        MUTED,
        Face::Sans,
    )
    text(mut s, label, 13.0, vec2(at.x + w + 8.0, line_top(s, Face::Sans, 13.0, middle)), MUTED)
    w + 8.0 + width_of(s, label, 13.0, Face::Sans) + 24.0
}

fn footer(s: mut Console, w: f32, h: f32, margin: f32) {
    if s.input == Input::Pointer || w < 560.0 { return }
    let (select, back) = if s.input == Input::Pad { ("A", "B") } else { ("Enter", "Esc") }
    var hints: Vec<(Text, Text)> = Vec::new()
    hints.push((select, "Select"))
    if s.pane != Pane::Games {
        hints.push(("^ v", "Move"))
        hints.push((back, "Close"))
    } else if s.cards.len() > 1 {
        hints.push(("v", "Games"))
    }
    var total = -24.0
    for hint in hints {
        total += key_width(s, hint.0) + 8.0 + width_of(s, hint.1, 13.0, Face::Sans) + 24.0
    }
    var x = w - margin - total
    for hint in hints { x += keycap(mut s, vec2(x, h - 46.0), hint.0, hint.1) }
}

fn status(s: Console) -> String {
    if !s.message.is_empty() { return s.message.clone() }
    match s.step {
        Step::Start | Step::Frame | Step::Show => String::from("Opening game"),
        Step::PickFile | Step::Import => String::from("Importing save"),
        Step::Export | Step::Download => String::from("Exporting save"),
        _ => String::new(),
    }
}

fn empty_library_message(message: str) -> String {
    if message.is_empty() { String::from("Loading games") } else { message.to_string() }
}

// A button's label: Play's says where it continues (`SaveInfo::place`), once there's a save.
fn action_label(a: Action, opening: bool, continuing: Option<SaveInfo>) -> String {
    if opening { return String::from("Opening") }
    match a {
        Action::Play => match continuing {
            Some(save) => if save.place.is_empty() { String::from("Continue") } else {
                f"Continue: {save.place}"
            },
            None => String::from("Play"),
        },
        Action::NewGame => String::from("New game"),
        Action::Load => String::from("Load"),
        _ => String::new(),
    }
}

// The title art's box for a screen `w` wide with `margin`s: as wide as a third of it, but never
// so small a phone loses it, nor wider than it has room for.
fn logo_box(w: f32, h: f32, margin: f32) -> vec2 {
    vec2(min(min(w - margin * 2.0, max(w * 0.34, 300.0)), LOGO_WIDE), min(h * 0.3, LOGO_TALL))
}

// `size` fitted within `room`, keeping its aspect.
fn fit_within(size: vec2, room: vec2) -> vec2 {
    size * min(room.x / size.x, room.y / size.y)
}

// The shelf's tiles' height, for a screen `h` tall.
fn tile_height(h: f32) -> f32 {
    clamp(h * 0.12, 56.0, 120.0)
}

// How far the shelf slides so that tile `selected` of tiles `width` wide and `gap` apart, from the
// margin, ends within the screen.
fn shelf_offset(selected: u32, width: f32, gap: f32, w: f32, margin: f32) -> f32 {
    max(0.0, margin + f32(selected + 1) * (width + gap) - gap - (w - margin))
}

// The home: the chosen game owns the screen. Its hero fills it behind everything (drawn by the
// GPU, `backdrop`); at the left, from the bottom up, its actions, its progress, its tagline and its
// title art. With more than one game, a shelf of covers along the bottom chooses among them; with
// one, a quiet line says more are coming.
fn library(s: mut Console, w: f32, h: f32, margin: f32) {
    if s.cards.is_empty() {
        let label = empty_library_message(s.message)
        centered(mut s, label, 15.0, w * 0.5, h * 0.5, MUTED, Face::Sans)
        return
    }
    // Choosing another game, what it shows eases out, and the new game's eases in, rising.
    let (shown, eased) = title_step(s.title_shown, s.title_in, s.selected, s.dt)
    s.title_shown = shown
    s.title_in = eased
    if s.reduced || s.reveal < 1.0 || s.title_shown >= s.cards.len() {
        s.title_shown = s.selected
        s.title_in = 1.0
    }
    if s.title_in < 1.0 { s.settled = false }
    let fade = smoothstep(0.0, 1.0, s.title_in)
    let lift = (1.0 - fade) * 8.0
    let card = s.cards[s.title_shown].clone()
    let many = s.cards.len() > 1
    let tile_h = tile_height(h)
    let shelf_top = h - 56.0 - tile_h
    if many { shelf(mut s, w, margin, shelf_top, tile_h) } else {
        // One game: no shelf, only a quiet line where it would be.
        let middle = h - 35.0
        text(
            mut s,
            "More games soon",
            13.0,
            vec2(margin, line_top(s, Face::Sans, 13.0, middle)),
            MUTED,
        )
    }
    // From the bottom up: the actions, the progress, the tagline, the title art.
    let top = if many { shelf_top - 40.0 - 44.0 } else { min(h * 0.74, h - 92.0 - 44.0) }
    let room = min(w - margin * 2.0, 760.0)
    let continuing = if s.saves.is_empty() { None } else { Some(s.saves[0].clone()) }
    let state = status(s)
    let progress = if !state.is_empty() { state.clone() } else {
        match continuing {
            Some(save) => save.description.clone(),
            None => String::new(),
        }
    }
    var above = top
    if !progress.is_empty() {
        let size = fitted(s, progress, PROGRESS, room, Face::Sans)
        let middle = top - 28.0
        let tone = if s.message.is_empty() { vec4(INK.xyz, 0.72) } else { WARN }
        let at = vec2(margin, line_top(s, Face::Sans, size, middle) + lift)
        text(mut s, progress, size, at, vec4(tone.xyz, tone.w * fade))
        above = middle - size * SANS_CAP * 0.5
    }
    if !card.tagline.is_empty() {
        let size = fitted(s, card.tagline, TAGLINE_SIZE, room, Face::Sans)
        let middle = above - (if above == top { 30.0 } else { 17.0 }) - size * SANS_CAP * 0.5
        let at = vec2(margin, line_top(s, Face::Sans, size, middle) + lift)
        text(mut s, card.tagline, size, at, vec4(INK.xyz, 0.94 * fade))
        above = middle - size * SANS_CAP * 0.5
    }
    // The title art, standing on what's below it; until it comes, the title in its place.
    let bottom = above - 26.0
    let room_for = logo_box(w, h, margin)
    if s.logos[s.title_shown].image.is_some() {
        let size = fit_within(vec2(f32(card.logo.width), f32(card.logo.height)), room_for)
        let r = Rect::new(margin, bottom - size.y + lift, size.x, size.y)
        let alpha = fade * s.logo_in * s.reveal
        let index = s.title_shown
        s.drawn.push(Drawn { layer: Layer::Logo, index, rect: r, alpha, radius: 0.0, bright: 1.0 })
    }
    if s.logo_in < 1.0 {
        let size = fitted(s, card.title, 56.0, room_for.x, Face::Sans)
        let middle = bottom - size * SANS_CAP * 0.5
        let at = vec2(margin, line_top(s, Face::Sans, size, middle) + lift)
        text(mut s, card.title, size, at, vec4(INK.xyz, fade * (1.0 - s.logo_in)))
    }
    // The actions in a line, the first the call to action, then Try again after a failure. Too
    // wide for the screen, the call leaves out where it continues (the progress says), then the
    // buttons hug their labels, and then the quieter actions wait for Try again.
    var acts = actions(continuing.is_some())
    var labels: Vec<String> = Vec::new()
    for i in 0..acts.len() {
        labels.push(action_label(acts[i], s.play_intent.is_some() && i == 0, continuing))
    }
    if !s.message.is_empty() { labels.push(String::from("Try again")) }
    let span = w - margin * 2.0
    if row_width(s, labels, tight: false) > span && labels[0].starts_with("Continue") {
        labels[0] = String::from("Continue")
    }
    var tight = row_width(s, labels, tight: false) > span
    while tight && acts.len() > 1 && row_width(s, labels, tight: true) > span {
        let last = acts.len() - 1
        let _ = acts.remove(last)
        let _ = labels.remove(last)
    }
    tight = row_width(s, labels, tight: false) > span
    var at = margin
    for i in 0..labels.len() {
        let primary = i == 0
        let a = if i < acts.len() { acts[i] } else { Action::Retry }
        let r = Rect::new(at, top, button_width(s, labels[i], primary: primary, tight: tight), 44.0)
        button(mut s, a, r, 1, labels[i], primary: primary)
        at = r.right() + 10.0
    }
}

// The shelf: each game's cover on a flat tile along the bottom, in the catalog's order, the
// chosen one lit and ringed, the rest dimmed; it slides to keep the chosen one in view.
fn shelf(s: mut Console, w: f32, margin: f32, top: f32, tile_h: f32) {
    let width = tile_h * 16.0 / 9.0
    let gap = 14.0
    let k = if s.reduced { 1.0 } else { 1.0 - exp(-s.dt * 12.0) }
    let offset = shelf_offset(s.selected, width, gap, w, margin)
    s.shelf = mix(s.shelf, offset, k)
    if abs(s.shelf - offset) > 0.05 { s.settled = false }
    for i in 0..s.cards.len() {
        let r = Rect::new(margin + f32(i) * (width + gap) - s.shelf, top, width, tile_h)
        if r.right() < 0.0 || r.x > w { continue }
        let chosen = i == s.selected
        let lit = if chosen { 1.0 } else if s.input == Input::Pointer {
            glow(s, Action::Game { index: i }) * 0.5
        } else { 0.0 }
        s.tiles_lit[i] = mix(s.tiles_lit[i], lit, k)
        if abs(s.tiles_lit[i] - lit) > 0.002 { s.settled = false }
        let _ = control(mut s, Action::Game { index: i }, r, 2, Kind::Tile)
        let bright = mix(0.55, 1.0, s.tiles_lit[i])
        if s.covers[i].image.is_some() {
            let alpha = s.reveal
            s.drawn.push(
                Drawn { layer: Layer::Cover, index: i, rect: r, alpha, radius: 6.0, bright },
            )
        } else {
            // No cover yet: its title on a quiet tile.
            rect(mut s, r, vec4(SECONDARY.xyz, 0.85), 6.0)
            let title = s.cards[i].title.clone()
            let size = fitted(s, title, 13.0, r.w - 20.0, Face::Sans)
            let middle = r.center().y
            centered(
                mut s,
                title,
                size,
                r.center().x,
                line_top(s, Face::Sans, size, middle),
                vec4(INK.xyz, bright),
                Face::Sans,
            )
        }
        if chosen {
            let focused = s.input != Input::Pointer && s.focus == Action::Game { index: i }
            let alpha = if focused { 0.95 } else { 0.6 }
            ring(mut s, r.shrink(-4.0), vec4(1.0, 1.0, 1.0, alpha), radius: 9.0, width: 2.0)
        } else {
            ring(mut s, r, BORDER, 6.0)
        }
    }
}

fn sheet_frame(s: mut Console, w: f32, h: f32, title: str) -> Rect {
    let open = s.sheet * s.sheet * (3.0 - 2.0 * s.sheet)
    rect(mut s, Rect::new(x: 0.0, y: 0.0, w: w, h: h), vec4(0.0, 0.0, 0.0, 0.6 * open))
    let width = min(w, 440.0)
    let r = Rect::new(w - width * open, 0.0, width, h)
    rect(mut s, r, SHEET)
    rect(mut s, Rect::new(r.x, y: 0.0, w: 1.0, h: h), BORDER)
    if s.pane != Pane::Games { focus_ring(mut s) }
    text(
        mut s,
        title,
        22.0,
        vec2(r.x + 32.0, line_top(s, DISPLAY, size: 22.0, middle: 56.0)),
        INK,
        DISPLAY,
    )
    button(
        mut s,
        Action::Games,
        Rect::new(r.right() - 32.0 - 80.0, y: 38.0, w: 80.0, h: 36.0),
        0,
        "Close",
    )
    r.shrink(32.0)
}

fn save_capacity(height: f32) -> u32 {
    u32(clamp(floor((height - 300.0) / 74.0), 1.0, 6.0))
}

// Load: every save, newest first. Choosing one plays it.
fn saves(s: mut Console, w: f32, h: f32) {
    let panel = sheet_frame(mut s, w, h, "Load")
    let x = panel.x
    let width = panel.w
    let top = 104.0
    if s.cards.is_empty() { return }
    let capacity = save_capacity(h)
    let first = s.marked / capacity * capacity
    let count = min(s.saves.len() - min(first, s.saves.len()), capacity)
    if count == 0 {
        text(mut s, if s.step == Step::Open || s.step == Step::List { "Reading saves" } else {
            "No saves yet"
        }, 14.0, vec2(x, top), MUTED)
    }
    for i in first..first + count {
        let r = Rect::new(x, top + f32(i - first) * 70.0, width, 62.0)
        let chosen = control(mut s, Action::Save { index: i }, r, 1 + i - first, Kind::Row)
        if chosen {
            s.marked = i
            rect(mut s, r, RAISED, RADIUS)
            ring(mut s, r, BORDER, RADIUS)
        }
        let save = s.saves[i].clone()
        let label_size = fitted(s, save.label, 15.0, width - 32.0, Face::Sans)
        text(mut s, save.label, label_size, vec2(r.x + 16.0, r.y + 12.0), INK)
        let size = fitted(s, save.description, 13.0, width - 32.0, Face::Sans)
        text(mut s, save.description, size, vec2(r.x + 16.0, r.y + 35.0), MUTED)
    }
    var y = top + f32(max(count, 1)) * 70.0 + 14.0
    let row = 2 + capacity
    if s.saves.len() > capacity {
        let next = if first + capacity < s.saves.len() { first + capacity } else { 0 }
        button(mut s, Action::Page { first: next }, Rect::new(x, y, width, 38.0), row, "More saves")
        y += 50.0
    }
    let cell = (width - 10.0) * 0.5
    button(mut s, Action::Export, Rect::new(x, y, cell, 38.0), row + 1, "Export")
    button(mut s, Action::Import, Rect::new(x + cell + 10.0, y, cell, 38.0), row + 1, "Import")
    let state = status(s)
    if !state.is_empty() {
        let size = fitted(s, state, 13.0, width, Face::Sans)
        text(mut s, state, size, vec2(x, y + 58.0), MUTED)
    }
}

fn settings(s: mut Console, w: f32, h: f32) {
    let panel = sheet_frame(mut s, w, h, "Settings")
    let x = panel.x
    let width = panel.w
    text(mut s, "Profile name", 13.0, vec2(x, 110.0), MUTED)
    let field = Rect::new(x, 134.0, width, 44.0)
    let editing = control(mut s, Action::Name, field, 1, Kind::Row)
    rect(mut s, field, vec4(1.0, 1.0, 1.0, 0.03), RADIUS)
    if editing {
        // As an input shows focus: a brighter border inside a soft ring.
        ring(mut s, field.shrink(-3.0), vec4(1.0, 1.0, 1.0, 0.16), RADIUS + 3.0, 3.0)
        ring(mut s, field, vec4(1.0, 1.0, 1.0, 0.55), RADIUS)
    } else { ring(mut s, field, INPUT, RADIUS) }
    let name = s.profile.name.clone()
    let size = fitted(s, name, 15.0, width - 32.0, Face::Sans)
    let middle = field.center().y
    text(mut s, name, size, vec2(x + 14.0, line_top(s, Face::Sans, size, middle)), INK)
    let blink = fract(s.presentation * 1.1) < 0.6
    if editing && blink {
        let caret = x + 15.0 + width_of(s, name, size, Face::Sans)
        rect(mut s, Rect::new(caret, middle - 9.0, w: 1.5, h: 18.0), INK)
    }
    button(
        mut s,
        Action::SaveProfile,
        Rect::new(x, y: 194.0, w: 120.0, h: 38.0),
        2,
        "Save",
        primary: true,
    )
    // The home's music: the chosen game's theme, softly.
    text(mut s, "Music on the home screen", 13.0, vec2(x, 266.0), MUTED)
    let label = if s.music { "On" } else { "Off" }
    button(mut s, Action::Music, Rect::new(x, y: 290.0, w: 120.0, h: 38.0), 3, label)
    let state = status(s)
    if !state.is_empty() { text(mut s, state, 13.0, vec2(x, 348.0), MUTED) }
}

// The focus ring, with keys or a pad: a ring just outside the focused button, sliding from one
// to the next.
fn focus_ring(s: mut Console) {
    let dt = s.dt
    var target: Option<Rect> = None
    if s.input != Input::Pointer {
        for c in s.shown {
            if lit(s, c.action) && (c.kind == Kind::Button || c.kind == Kind::Icon) {
                target = Some(c.rect)
            }
        }
    }
    let k = if s.reduced { 1.0 } else { 1.0 - exp(-dt * 22.0) }
    match target {
        Some(r) => {
            if s.ring_alpha < 0.01 { s.ring = r }
            s.ring = Rect::new(
                mix(s.ring.x, r.x, k),
                mix(s.ring.y, r.y, k),
                mix(s.ring.w, r.w, k),
                mix(s.ring.h, r.h, k),
            )
            s.ring_alpha = mix(s.ring_alpha, 1.0, k)
        },
        None => s.ring_alpha = mix(s.ring_alpha, 0.0, k),
    }
    let moving = match target {
        Some(r) => {
            let off = abs(vec4(s.ring.x - r.x, s.ring.y - r.y, s.ring.w - r.w, s.ring.h - r.h))
            s.ring_alpha < 0.99 || off.x + off.y + off.z + off.w > 0.1
        },
        None => s.ring_alpha >= 0.01,
    }
    if moving { s.settled = false }
    if s.ring_alpha < 0.01 { return }
    let r = s.ring.shrink(-3.0)
    ring(mut s, r, vec4(1.0, 1.0, 1.0, 0.9 * s.ring_alpha), RADIUS + 3.0, 2.0)
}

fn header(s: mut Console, w: f32, margin: f32) {
    settings_button(mut s, Rect::new(w - margin - 40.0, y: 22.0, w: 40.0, h: 40.0))
}

pub fn frame(s: mut Console, time: f32, width: u32, height: u32) {
    let dt = presentation_step(s.time, time)
    if let Some(before) = s.time {
        let (coarser, counted, spent) = strained(s.coarser, s.counted, s.spent, time - before)
        s.coarser = coarser
        s.counted = counted
        s.spent = spent
    }
    s.time = Some(time)
    update(mut s)
    if !s.decided {
        s.waited += dt
        if s.reloaded.is_some() || s.waited > 0.5 { decide_opening(mut s) }
    } else { s.presentation += dt }
    s.zoom = s.pixel_ratio * clamp(f32(height) / s.pixel_ratio / 720.0, 0.7, 1.0)
    let w = f32(width) / s.zoom
    let h = f32(height) / s.zoom
    // Motion follows the system's reduced-motion setting alone.
    let motion = !s.reduced
    let was_opening = motion && s.presentation < s.intro_until
    s.enter = false
    s.clicked = None
    s.activate = None
    for event in events() {
        s.dirty = true
        if account::event(mut s.account, event, s.zoom) { continue }
        match event {
            Event::PointerMove { at, .. } => {
                s.pointer = Some(at / s.zoom)
                s.input = Input::Pointer
            },
            Event::PointerDown { at, button: Button::Primary, .. } => {
                s.pointer = Some(at / s.zoom)
                s.pressed = Some(at)
                s.intro_until = 0.0
                s.input = Input::Pointer
            },
            Event::PointerUp { at, button: Button::Primary, .. } => {
                s.clicked = Some(at)
                s.intro_until = 0.0
                s.input = Input::Pointer
            },
            Event::KeyDown { key, repeat, mods } => {
                s.input = Input::Keys
                s.intro_until = 0.0
                if key == Key::Enter && !repeat { s.enter = true }
                if key == Key::Right { navigate(mut s, Move::Right) }
                if key == Key::Left { navigate(mut s, Move::Left) }
                if key == Key::Down || (key == Key::Tab && !mods.shift) {
                    navigate(mut s, Move::Down)
                }
                if key == Key::Up || (key == Key::Tab && mods.shift) { navigate(mut s, Move::Up) }
                if key == Key::Escape { open_pane(mut s, Pane::Games) }
                if s.pane == Pane::Settings && key == Key::A && mods.command() {
                    s.profile.name.clear()
                }
                if s.pane == Pane::Settings && key == Key::Backspace {
                    let end = previous(s.profile.name, s.profile.name.len())
                    s.profile.name.truncate(end)
                }
            },
            Event::Text { char } => {
                if s.pane == Pane::Settings && s.profile.name.len() < 120 && char >= 32 {
                    s.profile.name.push_char(char)
                }
            },
            Event::PadButton { button, pressed: true, .. } => {
                s.input = Input::Pad
                s.intro_until = 0.0
                if button == PadButton::South { s.enter = true }
                if button == PadButton::East { open_pane(mut s, Pane::Games) }
                if button == PadButton::Start { act(mut s, Action::Settings) }
                if button == PadButton::Right { navigate(mut s, Move::Right) }
                if button == PadButton::Left { navigate(mut s, Move::Left) }
                if button == PadButton::Down { navigate(mut s, Move::Down) }
                if button == PadButton::Up { navigate(mut s, Move::Up) }
            },
            Event::PadAxis { axis, value, .. } => {
                // The left stick moves once each time it leaves the middle.
                let old = s.stick
                if axis == PadAxis::LeftX { s.stick.x = value }
                if axis == PadAxis::LeftY { s.stick.y = value }
                if abs(old.x) < 0.6 && abs(s.stick.x) >= 0.6 {
                    s.input = Input::Pad
                    navigate(mut s, if s.stick.x > 0.0 { Move::Right } else { Move::Left })
                }
                if abs(old.y) < 0.6 && abs(s.stick.y) >= 0.6 {
                    s.input = Input::Pad
                    navigate(mut s, if s.stick.y > 0.0 { Move::Down } else { Move::Up })
                }
            },
            _ => {},
        }
    }
    if was_opening {
        s.enter = false
        s.clicked = None
        s.pressed = None
    }
    // What the pointer is over, by where things were drawn last frame.
    s.hover = match s.pointer {
        Some(p) => under(s.shown, p),
        None => None,
    }
    // What the pointer is over, or with keys or a pad what has focus, glows in from nothing.
    let glowing = if s.input == Input::Pointer { s.hover } else { Some(s.focus) }
    if glowing != s.glowing {
        s.glowing = glowing
        s.glow = 0.0
    }
    s.glow = if s.reduced { 1.0 } else { min(s.glow + dt / 0.25, 1.0) }
    let intro = motion && s.presentation < s.intro_until
    let phase = moment(s.presentation, intro)
    prefetch_games(mut s)
    s.reveal = phase.library
    let ease = |rate: f32| -> f32 { if motion { 1.0 - exp(-dt * rate) } else { 1.0 } }
    // Whether all that eases before drawing has come to rest.
    var eased = s.glow >= 1.0 || s.glowing.is_none()
    // Focus on the shelf follows the selection, wherever the selection came from.
    match s.focus {
        Action::Game { index } => if index != s.selected {
            s.focus = Action::Game { index: s.selected }
        },
        _ => {},
    }
    let sheet = if s.pane == Pane::Games { 0.0 } else { 1.0 }
    s.sheet = mix(s.sheet, sheet, ease(14.0))
    if abs(s.sheet - sheet) > 0.001 { eased = false }
    // The camera leans a little toward the pointer, and breathes in the opening. It holds still
    // through the opening's title, and takes up its lean in the dark after it. On the home, the
    // hero drifts with the lean alone, so a still pointer leaves a still screen.
    let toward = match s.pointer {
        Some(p) => vec2(p.x / w * 2.0 - 1.0, p.y / h * 2.0 - 1.0),
        None => vec2(0.0),
    }
    let breath = vec2(sin(s.presentation * 0.21), sin(s.presentation * 0.13) * 0.6) * 0.3
    let room_shows = !phase.settled || s.cards.is_empty()
    let lean = if !motion { vec2(0.0) } else if room_shows { toward * 0.7 + breath } else {
        toward * 0.7
    }
    s.sway = if intro && !phase.settled { vec2(0.0) } else if intro && phase.library == 0.0 {
        lean
    } else {
        mix(s.sway, lean, ease(2.0))
    }
    // The room's breath never comes to rest: it draws at the idle rate (`due`), not as it eases.
    if !room_shows && length(s.sway - lean) > 0.001 { eased = false }
    // The home's light takes the colour of the chosen game's hero (or its cover) as the home
    // comes up, and eases to the next as the selection changes.
    let art_tint = if s.cards.is_empty() { None } else if s.heroes[s.selected].image.is_some() {
        Some(s.heroes[s.selected].tint)
    } else if s.covers[s.selected].image.is_some() { Some(s.covers[s.selected].tint) } else { None }
    let wanted = match art_tint {
        Some(t) => vec4(t, phase.library),
        None => vec4(s.tint.xyz, 0.0),
    }
    s.tint = if s.tint.w == 0.0 { vec4(wanted.xyz, 0.0) } else { s.tint }
    s.tint = mix(s.tint, wanted, ease(2.5))
    if length(s.tint - wanted) > 0.002 { eased = false }
    // The chosen game's hero and title art come in over what stands for them as they arrive.
    if !s.cards.is_empty() {
        let hero = if s.heroes[s.title_shown].image.is_some() { 1.0 } else { 0.0 }
        let logo = if s.logos[s.title_shown].image.is_some() { 1.0 } else { 0.0 }
        s.hero_in = if hero == 0.0 { 0.0 } else { mix(s.hero_in, 1.0, ease(4.0)) }
        s.logo_in = if logo == 0.0 { 0.0 } else { mix(s.logo_in, 1.0, ease(6.0)) }
        // Come in, they're in: the backdrop stops blurring what the hero hides.
        if abs(s.hero_in - hero) <= 0.002 { s.hero_in = hero }
        if abs(s.logo_in - logo) <= 0.002 { s.logo_in = logo }
        if s.hero_in != hero || s.logo_in != logo { eased = false }
    }
    drive_theme(mut s, phase.library)
    // Drawn only when it shows something new (`due`): what eases is drawn as it eases, and
    // the opening's slow turn and the camera's breath at the idle rate. The canvas keeps the last
    // frame, so a settled home draws nothing.
    let busy = s.dirty ||
        !s.settled ||
        !eased ||
        intro ||
        (width, height) != s.drawn_size ||
        account::animating(s.account)
    let editing = s.pane == Pane::Settings && s.focus == Action::Name
    let since = match s.drawn_at {
        Some(at) => Some(time - at),
        None => None,
    }
    if !due(since, busy, moving: (motion && room_shows) || editing || s.behind) { return }
    s.dirty = false
    s.settled = true
    s.drawn_at = Some(time)
    s.drawn_size = (width, height)
    // What eases as it is drawn eases by the time since the last drawing.
    s.dt = min(s.presentation - s.drawn_presentation, 1.0 / 30.0)
    s.drawn_presentation = s.presentation
    let screen = vec2(f32(width), f32(height))
    let cam = camera(screen, s.sway)
    // The artifact's place is fitted to the camera at rest, so the sway moves it a little.
    let rest = camera(screen, vec2(0.0))
    let margin = w * MARGIN
    s.draw.clear(screen)
    s.controls.clear()
    s.drawn.clear()
    if s.pane != Pane::Games { s.sheet_pane = s.pane }
    if phase.library > 0.0 {
        let games = s.pane == Pane::Games
        if games { focus_ring(mut s) }
        header(mut s, w, margin)
        library(mut s, w, h, margin)
        if games { footer(mut s, w, h, margin) }
        // A sheet takes the controls; the library behind it only shows. A closing sheet
        // only shows too.
        if !games { s.controls.clear() }
        if s.sheet > 0.01 {
            let before = s.controls.len()
            match s.sheet_pane {
                Pane::Saves => saves(mut s, w, h),
                Pane::Settings => settings(mut s, w, h),
                Pane::Games => {},
            }
            if games { s.controls.truncate(before) } else { footer(mut s, w, h, margin) }
        }
        account::draw(mut s.account, mut s.draw, s.fonts, w, h, margin, s.zoom, s.reduced)
    }
    // Over anything it can press, the pointer becomes a hand.
    let over = match s.pointer {
        Some(p) => under(s.controls, p).is_some(),
        None => false,
    }
    if over != s.pointing {
        s.pointing = over
        s.cursor = Some(host::cursor(if over { "pointer" } else { "default" }))
    }
    s.renderer.upload(s.draw)
    // The artifact, where the opening or the room has it, traced for the room's camera: only
    // while the room shows, the opening's or, with no game to show yet, the home's.
    if room_shows { trace_room(mut s, phase, cam, rest, width, height, time, motion, intro) } else {
        // Nothing is traced, so no tracing is due.
        s.behind = false
    }
    // The mark: large beneath the tesseract, a light passing along it as the tesseract comes
    // up, then going down into the dark with it; small in the header with the library.
    let marks = [
        (mark_place(w, h), phase.title, phase.reveal),
        (
            vec3(
                margin + MARK_WIDTH * HEADER_CAP / facet::CAP * 0.5,
                42.0,
                HEADER_CAP / facet::CAP,
            ),
            phase.library,
            1.0,
        ),
    ]
    for k in 0..2 {
        if marks[k].1 > 0.0 {
            ink(mut s, k, marks[k].0)
        } else if phase.settled && s.inked[k].z > 0.0 {
            // Gone for good: the opening's mark is not shown again.
            s.inks[k] = texture(width: 1, height: 1)
            s.inked[k] = vec4(0.0)
        }
    }
    let pass = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    if room_shows {
        draw(
            pass,
            quad.bind(screen, rect: vec4(0.0, 0.0, screen)),
            stage.bind(
                room: s.room,
                linear: s.linear,
                camera: cam,
                look: Stage { reveal: stage_light(phase) },
            ),
            vertices: 6,
        )
    } else {
        // The chosen game's hero, or what stands for it, darkened behind the text.
        let i = s.title_shown
        let fade = smoothstep(0.0, 1.0, s.title_in)
        let aspect = screen.x / screen.y
        let many = s.cards.len() > 1
        let hero_size = if s.heroes[i].image.is_some() {
            vec2(f32(s.cards[i].hero.width), f32(s.cards[i].hero.height))
        } else { vec2(0.0) }
        let thumb = if s.covers[i].small.is_some() {
            let (w, h) = small_size(s.cards[i].cover.width, s.cards[i].cover.height)
            vec2(f32(w), f32(h))
        } else { vec2(0.0) }
        let look = Backdrop {
            sizes: vec4(hero_size, thumb),
            look: vec4(
                s.hero_in,
                phase.library * mix(0.4, 1.0, fade),
                -s.sway * 10.0 * s.zoom,
            ),
            tint: s.tint,
            screen: vec4(
                screen,
                if aspect >= 1.2 { 0.62 } else { 1.2 },
                if many || aspect < 1.2 { 0.62 } else { 0.5 },
            ),
        }
        if let Some(hero) = s.heroes[i].image {
            if let Some(cover) = s.covers[i].small {
                lay_backdrop(pass, screen, hero, cover, s.linear, look)
            } else { lay_backdrop(pass, screen, hero, s.blank, s.linear, look) }
        } else if let Some(cover) = s.covers[i].small {
            lay_backdrop(pass, screen, s.blank, cover, s.linear, look)
        } else { lay_backdrop(pass, screen, s.blank, s.blank, s.linear, look) }
        // The title art and the covers on the shelf over it.
        for d in s.drawn {
            let r = snapped(d.rect, s.zoom)
            let rect = vec4(r.x, r.y, r.w, r.h)
            let look = Picture { rect, look: vec4(d.alpha, d.radius * s.zoom, d.bright, 0.0) }
            if d.layer == Layer::Cover {
                if let Some(t) = s.covers[d.index].image {
                    lay_picture(pass, screen, t, s.linear, look)
                }
            } else if let Some(t) = s.logos[d.index].image {
                lay_picture(pass, screen, t, s.linear, look)
            }
        }
    }
    for k in 0..2 {
        let (at, alpha, reveal) = marks[k]
        if alpha <= 0.0 { continue }
        let (centre, ems, origin, size) = mark_frame(at, s.zoom)
        draw(
            pass,
            quad.bind(screen, rect: vec4(origin, size)),
            emblem.bind(
                ink: s.inks[k],
                look: Emblem { centre, origin, ems, alpha, reveal, width: MARK_WIDTH },
            ),
            vertices: 6,
        )
    }
    s.renderer.draw(pass, screen)
    pass.present()
    s.shown = s.controls.clone()
    if let Some(action) = s.activate {
        s.focus = action
        act(mut s, action)
        match action {
            Action::Game { index } => if index != s.selected {
                s.focus = Action::Game { index: s.selected }
            },
            _ => {},
        }
    }
    if s.clicked.is_some() { s.pressed = None }
}

fn lay_backdrop<P: RenderPass>(
    pass: P,
    screen: vec2,
    hero: Texture<Rgba8>,
    cover: Texture<Rgba8>,
    linear: Sampler,
    look: Backdrop,
) {
    draw(
        pass,
        quad.bind(screen, rect: vec4(0.0, 0.0, screen)),
        backdrop.bind(hero: hero, cover: cover, linear: linear, look: look),
        vertices: 6,
    )
}

fn lay_picture<P: RenderPass>(
    pass: P,
    screen: vec2,
    image: Texture<Rgba8>,
    linear: Sampler,
    look: Picture,
) {
    draw(
        pass,
        quad.bind(screen, rect: look.rect),
        picture.bind(image: image, linear: linear, look: look),
        vertices: 6,
        blend: Blend::Premultiplied,
    )
}

// Traces the artifact into the room's layer, where the opening (or the room, with no game to
// show) has it, if it would look different from the last tracing and its rate allows.
fn trace_room(
    s: mut Console,
    phase: opening::Moment,
    cam: room::Camera,
    rest: room::Camera,
    width: u32,
    height: u32,
    time: f32,
    motion: bool,
    intro: bool,
) {
    let place = artifact_place(phase, artifact_spot(rest))
    let (coarser, rays) = trace_plan(s.coarser)
    let size = traced_size(width, height, TRACED_PIXELS, coarser)
    let grid = tile_grid(width: size.0, height: size.1)
    if s.room.width() != size.0 || s.room.height() != size.1 {
        s.room = texture(width: size.0, height: size.1)
        s.tiles = buffer(grid.0 * grid.1)
        s.traced = None
    }
    let target = vec2(f32(size.0), f32(size.1))
    let turn = if motion { turn_at(s.presentation, opening: intro) } else { 2.0 }
    let look = Artifact {
        screen: target,
        lens: cam.screen.z,
        eye: cam.eye,
        target: cam.target,
        place,
        // The tesseract at rest in the opening is still: no light or ripple moves on it. Without
        // motion, nothing moves on it at all.
        time: if motion { clock_at(s.presentation, opening: intro) } else { 7.0 },
        // Dimmer in the room, as far off as it stands.
        light: if phase.settled { 0.72 } else { 1.0 },
        rays,
        columns: grid.0,
    }
    // Traced again only when it would look different, and at most at its rate: the room keeps
    // the last tracing meanwhile.
    let changed = match s.traced {
        Some((t, l)) => t != turn || !same_look(l, look),
        None => true,
    }
    let hz = if phase.settled { ROOM_TRACE_HZ } else { OPENING_TRACE_HZ }
    s.behind = changed && s.traced.is_some() && time - s.traced_at < 1.0 / hz - SLACK
    if changed && !s.behind {
        let verts = corners(turn, place.xyz, place.w)
        let shapes = shapes(verts, place.w)
        write(mut s.struts, 0, shapes.struts)
        write(mut s.panes, 0, shapes.panes)
        write(mut s.tiles, 0, tiles(look, verts, shapes.struts, shapes.panes))
        let space = begin_pass(mut s.room, clear: vec4(0.0, 0.0, 0.0, 1.0))
        draw(
            space,
            quad.bind(target, rect: vec4(0.0, 0.0, target)),
            artifact.bind(struts: s.struts, panes: s.panes, tiles: s.tiles, look: look),
            vertices: 6,
        )
        space.end()
        s.traced = Some((turn, look))
        s.traced_at = time
    }
}

// Plays the chosen game's theme softly while the home shows it: fetched and read once it's
// chosen, given to the voice once the voice has fallen quiet from the last game's, and its level
// eased up or down. Quiet while a game opens or plays, with the music setting off, or with no
// theme.
fn drive_theme(s: mut Console, library: f32) {
    if s.cards.is_empty() { return }
    let chosen = s.selected
    if s.theme_of != Some(chosen) {
        s.theme_of = Some(chosen)
        s.theme = None
        borrow path = s.cards[chosen].theme
        s.theme_load = if path.is_empty() { None } else { Some(fetch(path)) }
    }
    if let Some(Ok(bytes)) = poll(mut s.theme_load) {
        if let Some(text) = String::from_utf8(bytes.clone()) { s.theme = theme::read(text) }
    }
    let wanted = if s.music && library >= 1.0 && browsing(s.step) && s.closing.is_none() {
        1.0
    } else { 0.0 }
    if s.theme_sent != Some(chosen) {
        if let Some(t) = s.theme {
            if s.voice_level > 0.0 {
                if theme::level(mut s.voice, 0.0) {
                    s.voice_level = 0.0
                    s.quiet_at = s.presentation
                }
            } else if s.presentation - s.quiet_at >= QUIET_SECONDS {
                if theme::send(mut s.voice, t) { s.theme_sent = Some(chosen) }
            }
        }
    }
    let level = if s.theme_sent == Some(chosen) { wanted } else { 0.0 }
    if level != s.voice_level && theme::level(mut s.voice, level) {
        if level == 0.0 { s.quiet_at = s.presentation }
        s.voice_level = level
    }
}

// Where mark `at` (its centre and pixels per em, logical) is on a screen at `zoom`: its centre
// and pixels per em, and the whole screen pixels its layer covers, from and across.
fn mark_frame(at: vec3, zoom: f32) -> (vec2, f32, vec2, vec2) {
    let ems = at.z * zoom
    let centre = at.xy * zoom
    let extent = vec2(MARK_WIDTH * ems + 16.0, ems * 1.6)
    let origin = floor(centre - extent * 0.5)
    (centre, ems, origin, ceil(centre + extent * 0.5) - origin)
}

// Inks mark `k` at `at` into its layer, unless it holds it at that size already: once a size,
// since the mark's field is all of its cost.
fn ink(s: mut Console, k: u32, at: vec3) {
    let (centre, ems, origin, size) = mark_frame(at, s.zoom)
    let key = vec4(centre, ems, size.x)
    if s.inked[k] == key { return }
    s.inked[k] = key
    s.inks[k] = texture(width: u32(size.x), height: u32(size.y))
    let space = begin_pass(mut s.inks[k], clear: vec4(0.0))
    draw(
        space,
        quad.bind(size, rect: vec4(vec2(0.0), size)),
        mark_ink.bind(
            runs: s.mark,
            look: Ink { centre, origin, ems, count: MARK_RUNS.len() },
        ),
        vertices: 6,
    )
    space.end()
}

// Fetches the games' files ahead of time, at the browser's low priority, once the console
// has the covers it shows, so it never slows them: one game at a time, each once, the
// selection first, and whichever is chosen next before the rest. While the library is
// browsed, not while a game starts. Each game's list is beside the catalog
// (studio/release/site.wrela's `prefetch_list`).
fn prefetch_games(s: mut Console) {
    if let Some(_) = poll(mut s.prefetching) { s.prefetched[s.prefetch_game] = true }
    if let Some(result) = poll(mut s.prefetch_list) {
        match result {
            Ok(bytes) => s.prefetching = Some(host::prefetch(bytes)),
            Err(_) => s.prefetched[s.prefetch_game] = true,
        }
    }
    if !browsing(s.step) || s.prefetch_list.is_some() || s.prefetching.is_some() { return }
    for i in 0..s.covers.len() {
        borrow c = s.covers[i]
        if near_cover(i, s.selected) && (!c.requested || c.load.is_some() || c.decode.is_some()) {
            return
        }
    }
    let Some(next) = next_prefetch(s.prefetched, s.selected) else { return }
    s.prefetch_game = next
    s.prefetch_list = Some(fetch(f"prefetch-{s.cards[next].id}.txt"))
}

// The next game to fetch ahead of time: the selection, or the first after it not yet done.
fn next_prefetch(done: [bool], selected: u32) -> Option<u32> {
    let n = done.len()
    for k in 0..n {
        let i = (selected + k) % n
        if !done[i] { return Some(i) }
    }
    None
}

// Whether this page load plays the opening: every visit does, and a reload of the tab starts
// at the library. Without an answer from the host, it plays.
fn decide_opening(s: mut Console) {
    s.decided = true
    if s.reloaded == Some(true) { s.presentation = max(s.presentation, RETURNING) }
}

// An address (`host::address`) without its fragment, if it has one: the path and query.
fn without_fragment(address: Vec<u8>) -> Option<String> {
    var kept: Vec<u8> = Vec::new()
    for b in address {
        if b == 35 { return String::from_utf8(take kept) }
        kept.push(b)
    }
    None
}

// A traced layer's size: the screen divided by a whole number, so its thin bright lines are
// not resampled into dashes, and about `budget` pixels; `coarser` divides it by that much more.
fn traced_size(width: u32, height: u32, budget: f32, coarser: u32) -> (u32, u32) {
    let divisor = max(u32(round(sqrt(f32(width) * f32(height) / budget))), 1) + coarser
    (max(width / divisor, 4), max(height / divisor, 4))
}

// How the tesseract is traced `steps` steps below its full detail: how much coarser than the
// screen allows (`traced_size`), and the most rays a pixel. The first step gives up the four
// rays, which cost the room's far tesseract most; the rest coarsen it.
fn trace_plan(steps: u32) -> (u32, u32) {
    if steps == 0 { (0, 4) } else { (steps - 1, 1) }
}

// The steps below full detail, and the frames counted and the seconds they took, after a
// frame `interval` seconds after the last. A browser holds frames back while the GPU is behind,
// unevenly, so a device whose frames come slower than `SLOW_FRAME` on average over
// `STRAIN_FRAMES` takes a step down; it never steps back up, so it doesn't waver. A stall (a
// hidden tab, a pipeline being built) says nothing of the device.
fn strained(steps: u32, counted: u32, spent: f32, interval: f32) -> (u32, u32, f32) {
    if interval <= 0.0 || interval > 0.25 || steps >= COARSEST { return (steps, counted, spent) }
    let counted = counted + 1
    let spent = spent + interval
    if counted < STRAIN_FRAMES { return (steps, counted, spent) }
    if spent > SLOW_FRAME * f32(counted) { (steps + 1, 0, 0.0) } else { (steps, 0, 0.0) }
}

// Whether a frame is drawn, `since` seconds after the last one (None: never drawn): at once
// when something has changed or still eases (`busy`), and when only the slow turn and the
// camera's breath move, at `IDLE_HZ`. A still screen isn't drawn again.
fn due(since: Option<f32>, busy: bool, moving: bool) -> bool {
    match since {
        Some(t) => busy || (moving && t >= 1.0 / IDLE_HZ - SLACK),
        None => true,
    }
}

// Whether two tracings of the tesseract at one turn look the same.
fn same_look(a: Artifact, b: Artifact) -> bool {
    a.screen == b.screen &&
        a.lens == b.lens &&
        a.eye == b.eye &&
        a.target == b.target &&
        a.place == b.place &&
        a.time == b.time &&
        a.light == b.light &&
        a.rays == b.rays
}

@test
fn cover_requests_stay_within_reach_of_the_selection() {
    for selected in 0..20 {
        var count = 0
        for index in 0..20 { if near_cover(index, selected) { count += 1 } }
        assert(count <= COVER_REACH * 2 + 1 && near_cover(selected, selected))
    }
    assert(!near_cover(index: 0, selected: 4294967295))
}

@test
fn a_title_offers_play_alone_until_it_has_saves_and_continue_names_where() {
    let fresh = actions(has_saves: false)
    assert(fresh.len() == 1 && fresh[0] == Action::Play)
    assert(action_label(Action::Play, opening: false, continuing: None) == "Play")
    let played = actions(has_saves: true)
    assert(played.len() == 3)
    assert(
        played[0] == Action::Play && played[1] == Action::NewGame && played[2] == Action::Load,
    )
    let save = |place: Text| SaveInfo {
        slot: String::from("continue"),
        label: String::from("Continue"),
        description: String::from("3 of 9 levels"),
        place: String::from(place),
        saved: 0,
    }
    let continuing = |place: Text| action_label(
        Action::Play,
        opening: false,
        continuing: Some(save(place)),
    )
    assert(continuing("The Wetlands") == "Continue: The Wetlands")
    assert(continuing("") == "Continue", "no place, no colon")
    assert(action_label(Action::Play, opening: true, continuing: None) == "Opening")
    assert(
        action_label(Action::NewGame, opening: false, continuing: None) == "New game" &&
            action_label(Action::Load, opening: false, continuing: None) == "Load",
    )
}

@test
fn traced_layers_divide_the_screen_by_a_whole_number() {
    let size = |w: u32, h: u32, coarser: u32| -> (u32, u32) {
        traced_size(w, h, TRACED_PIXELS, coarser)
    }
    assert(size(1280, 720, 0) == (1280, 720))
    assert(size(2560, 1440, 0) == (1280, 720))
    assert(size(2880, 1800, 0) == (1440, 900))
    assert(size(390, 844, 0) == (390, 844))
    assert(size(2560, 1440, 1) == (853, 480), "a step coarser divides by one more")
}

@test
fn a_failed_request_retries_quietly_after_a_pause() {
    let at = 10.0 + RETRY_SECONDS
    assert(!retry_due(at, now: 12.0, closing: false), "not before the pause is over")
    assert(retry_due(at, now: 13.0, closing: false))
    assert(!retry_due(at, now: 14.0, closing: true), "not while the old session closes")
    assert(!retry_due(0.0, now: 14.0, closing: false), "nothing to retry")
}

@test
fn focus_moves_across_rows_and_along_them() {
    let row = |action: Action, x: f32, y: u32| -> Control {
        Control {
            action,
            rect: Rect::new(x, f32(y) * 100.0, w: 80.0, h: 40.0),
            row: y,
            kind: Kind::Button,
        }
    }
    let controls = [
        row(Action::Settings, 900.0, 0),
        row(Action::Game { index: 0 }, 50.0, 1),
        row(Action::Play, 50.0, 2),
        row(Action::Load, 200.0, 2),
    ]
    assert(neighbour(controls, Action::Play, Move::Right) == Some(Action::Load))
    assert(neighbour(controls, Action::Load, Move::Right).is_none())
    assert(neighbour(controls, Action::Play, Move::Up) == Some(Action::Game { index: 0 }))
    assert(neighbour(controls, Action::Game { index: 0 }, Move::Up) == Some(Action::Settings))
    assert(neighbour(controls, Action::Play, Move::Down).is_none())
    assert(neighbour(controls, Action::Retry, Move::Down) == Some(Action::Settings))
    // From a tile far to the right, down still reaches the main action first.
    let wide = [
        row(Action::Game { index: 4 }, 900.0, 1),
        row(Action::Play, 50.0, 2),
        row(Action::Retry, 400.0, 2),
    ]
    assert(neighbour(wide, Action::Game { index: 4 }, Move::Down) == Some(Action::Play))
}

@test
fn shorter_save_sheets_page_the_rows_to_keep_actions_visible() {
    assert(save_capacity(720.0) == 5)
    assert(save_capacity(504.0) == 2)
    assert(save_capacity(300.0) == 1)
    assert(save_capacity(2000.0) == 6)
}

@test
fn a_queued_play_uses_the_current_save_or_explicit_new_game() {
    let saves = [
        SaveInfo {
            slot: String::from("continue"),
            label: String::new(),
            description: String::new(),
            place: String::new(),
            saved: 0,
        },
        SaveInfo {
            slot: String::from("imported"),
            label: String::new(),
            description: String::new(),
            place: String::new(),
            saved: 0,
        },
    ]
    match play_plan(Some(String::from("continue")), saves, 0, PlayIntent::NewGame) {
        PlayPlan::Prepare { slot } => assert(slot.is_empty()),
        _ => assert(false, "New game must not start a prepared continuation"),
    }
    match play_plan(Some(String::from("continue")), saves, 1, PlayIntent::Selected) {
        PlayPlan::Prepare { slot } => assert(slot == "imported"),
        _ => assert(false, "A changed selection needs its own preparation"),
    }
    match play_plan(Some(String::from("imported")), saves, 1, PlayIntent::Selected) {
        PlayPlan::Start => {},
        _ => assert(false, "Ready selection starts"),
    }
}

@test
fn an_export_keeps_the_requested_slot_when_selection_changes() {
    let slots = ["continue", "other"]
    var picked = 0
    let plan = export_plan("first", "player-1", slots[picked])
    picked = 1
    assert(slots[picked] == "other")
    assert(plan.slot == "continue")
    assert(export_name(plan) == "wrela-first-player-1-continue.wrela-save")
}

@test
fn an_invalid_utf8_catalog_finishes_with_an_error() {
    match catalog_result(Vec::<u8>::from([255])) {
        Err(message) => assert(message == "The game library could not be read."),
        Ok(_) => assert(false, "Invalid UTF-8 is a catalog completion error"),
    }
}

@test
fn every_valid_game_key_has_a_downloadable_export_name() {
    let cards = parse("-first\tFirst\turl\timage\t1\t1\t\t0\t0\t\t0\t0\t\t").unwrap()
    let plan = export_plan(cards[0].id, "player-1", "continue")
    assert(valid_key(plan.game))
    let name = export_name(plan)
    let first = name.byte(0)
    assert((first >= 97 && first <= 122) || (first >= 48 && first <= 57))
}

@test
fn an_empty_library_displays_its_error_instead_of_loading() {
    let message = "The game library could not be read."
    assert(empty_library_message(message) == message)
    assert(empty_library_message("") == "Loading games")
}

@test
fn a_new_title_waits_for_the_old_one_to_ease_out() {
    // Choosing the second game: the first's title eases out, then the second's in.
    var shown: u32 = 0
    var eased = 1.0
    var seen_out = false
    for _ in 0..30 {
        let (next_shown, next_eased) = title_step(shown, eased, selected: 1, dt: 1.0 / 60.0)
        if next_shown == 0 { assert(next_eased < eased, "the old title only fades") }
        if next_shown == 1 && shown == 0 {
            seen_out = true
            assert(next_eased == 0.0, "the new one starts unseen")
        }
        shown = next_shown
        eased = next_eased
    }
    assert(seen_out && shown == 1 && eased > 0.5)
}

@test
fn games_are_fetched_ahead_from_the_selection_round_to_the_rest() {
    var done = [false; 4]
    var order: Vec<u32> = Vec::new()
    while let Some(next) = next_prefetch(done, 2) {
        order.push(next)
        done[next] = true
    }
    assert(order.len() == 4 && order[0] == 2 && order[1] == 3 && order[2] == 0 && order[3] == 1)
    // A game chosen meanwhile is fetched next, and one done isn't fetched again.
    let some = [true, false, false, true]
    assert(next_prefetch(some, 3) == Some(1) && next_prefetch(some, 2) == Some(2))
    assert(next_prefetch([true, true], 0).is_none())
}

@test
fn the_screen_is_drawn_when_it_changes_and_at_the_idle_rate_while_the_tesseract_turns() {
    assert(due(None, busy: false, moving: false), "the first frame")
    assert(due(Some(0.008), busy: true, moving: false), "a change, at once")
    assert(!due(Some(0.017), busy: false, moving: true), "not faster than the idle rate")
    assert(due(Some(0.0333), busy: false, moving: true), "two frames of 60 Hz")
    assert(due(Some(0.0333), busy: false, moving: true), "four of 120 Hz")
    assert(!due(Some(60.0), busy: false, moving: false), "a still screen, never again")
}

@test
fn a_device_that_cant_keep_up_traces_coarser_and_never_wavers() {
    // Steady 60 Hz frames, and 30 Hz ones (a browser saving power): no change.
    var state = (0, 0, 0.0)
    for i in 0..1000 {
        let interval = if i < 500 { 1.0 / 60.0 } else { 1.0 / 30.0 }
        state = strained(state.0, state.1, state.2, interval)
    }
    assert(state.0 == 0)
    // Slow frames, held back unevenly, step it down once a window, to the coarsest.
    for i in 0..STRAIN_FRAMES {
        let interval = if i % 3 == 0 { 0.12 } else { 0.017 }
        state = strained(state.0, state.1, state.2, interval)
    }
    assert(state.0 == 1)
    for _ in 0..STRAIN_FRAMES * 10 { state = strained(state.0, state.1, state.2, 0.07) }
    assert(state.0 == COARSEST)
    // A few slow frames are not enough, and stalls count for nothing.
    var mixed = (0, 0, 0.0)
    for i in 0..900 {
        let interval = if i % 10 == 0 { 0.07 } else if i % 7 == 0 { 3.0 } else { 1.0 / 60.0 }
        mixed = strained(mixed.0, mixed.1, mixed.2, interval)
    }
    assert(mixed.0 == 0)
    // The first step gives up the four rays a pixel; the next ones coarsen the tracing.
    assert(trace_plan(0) == (0, 4) && trace_plan(1) == (0, 1) && trace_plan(3) == (2, 1))
}

// `t`'s UTF-8 bytes, as a host gives an address.
fn bytes(t: str) -> Vec<u8> {
    var b: Vec<u8> = Vec::new()
    for i in 0..t.len() { b.push(t.byte(i)) }
    take b
}

@test
fn a_games_name_left_in_the_address_is_dropped_and_the_path_and_query_kept() {
    assert(without_fragment(bytes("/?from=link#leapling")) == Some(String::from("/?from=link")))
    assert(without_fragment(bytes("/#")) == Some(String::from("/")))
    assert(without_fragment(bytes("/")).is_none(), "no fragment: nothing to replace")
    assert(without_fragment(Vec::new()).is_none(), "the replacement's empty answer ends it")
}

@test
fn a_reload_starts_at_the_library_and_a_visit_plays_the_opening() {
    var visit: Vec<u8> = Vec::new()
    for _ in 0..10 { visit.push(u8(0)) }
    var reload = visit.clone()
    reload[9] = u8(1)
    assert(!host::read_environment(visit).reloaded, "a visit plays the opening")
    assert(host::read_environment(reload).reloaded)
    let short = host::read_environment([u8(1), u8(0), u8(0), u8(0), u8(0)])
    assert(!short.reloaded, "a host that doesn't say: a visit")
}

@test
fn a_small_copy_keeps_the_aspect_and_averages_its_boxes() {
    assert(small_size(width: 960, height: 540) == (48, 27))
    assert(small_size(width: 20, height: 10) == (20, 10))
    // Two by one: a black pixel and a white one, and of a 96 × 2 of halves, each box's mean.
    var halves: Vec<u8> = Vec::new()
    for _ in 0..2 {
        for x in 0..96 {
            let v = if x < 48 { 0 } else { 200 }
            for c in [v, v, v, 255] { halves.push(u8(c)) }
        }
    }
    let small = shrunk(halves, width: 96, height: 2, to_width: 48, to_height: 1)
    assert(small.len() == 48 * 1 * 4)
    assert(small[0] == 0 && small[47 * 4] == 200 && small[3] == 255)
}

@test
fn a_cover_lends_its_colour_and_grey_art_lends_white() {
    var grey: Vec<u8> = Vec::new()
    var green: Vec<u8> = Vec::new()
    for i in 0..16 * 8 {
        for c in [128, 128, 128, 255] { grey.push(u8(c)) }
        // Mostly dark grass, with a few dull grey pixels that must not wash it out.
        let pixel = if i % 3 == 0 { [90, 90, 90, 255] } else { [40, 160, 60, 255] }
        for c in pixel { green.push(u8(c)) }
    }
    assert(palette(grey, width: 16, height: 8) == vec3(1.0))
    let t = palette(green, width: 16, height: 8)
    assert(t.y == 1.0 && t.x < 0.4 && t.z < 0.5)
}

@test
fn another_game_is_chosen_while_saves_are_read_but_not_while_one_starts() {
    for step in [Step::Idle, Step::Open, Step::List, Step::Prepare] { assert(browsing(step)) }
    for step in [
        Step::Start,
        Step::Frame,
        Step::Show,
        Step::Closed,
        Step::Export,
        Step::Download,
        Step::PickFile,
        Step::Import,
    ] { assert(!browsing(step)) }
}

// ---- the server ----------------------------------------------------------------------------

// The console's server build: accounts and the games' boards (console/server). Its passkeys are
// for wrela.dev from the console's origin; a local build sets its own (docs/toolchain.md, "The
// console's server").
pub const RP_ID: Text = "wrela.dev"
pub const ORIGIN: Text = "https://wrela.dev"

pub fn serve_init() -> console_server::serve::Server {
    console_server::serve::init(RP_ID, ORIGIN)
}

pub fn serve(s: mut console_server::serve::Server, time: f32) {
    console_server::serve::serve(mut s, time)
}
