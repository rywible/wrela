// The artifact: a tesseract of polished black and silver struts with faces of rippling
// smoked mirror glass, turning through the fourth dimension. Seen from a 4D eye close by, its
// near cell swells and its far cell shrinks, and each strut tapers between them, heavy where
// it is near in the fourth dimension and a needle where it is far. Its struts shade from
// satin silver (far) to black chrome (near). Rays meet struts and faces exactly (no stepping), so
// edges stay sharp. Where the glass mirrors the studio, each colour sees it a little
// shifted along the glass's folds, so its edges fringe into a spectrum, and nothing else does.
// The glass bends only the studio it mirrors: struts seen through it or in it stay straight.
// So a pixel's rays run along one line through every pane they cross, and the pixel finds the
// struts and panes near that line once (`near`); its rays and their bounces test only those.
use std::gpu::{FragCoord}

pub const EDGES: u32 = 32
pub const FACES: u32 = 24
// The vec4s a strut and a pane take in the buffers the tracer reads (`shapes`).
pub const STRUT_WORDS: u32 = 3
pub const PANE_WORDS: u32 = 6
const BOUNCES: u32 = 4
// Every strut, as a mask.
const ALL: u32 = 4294967295
// A strut's radius where it is at w = 0. At each corner it is scaled as the corner is, so the
// struts that meet there share one radius and weld seamlessly.
const STRUT: f32 = 0.022
// The 4D eye stands this far along w. A corner at `w` is drawn `EYE / (EYE - w)` times as far
// out: nested, the near cell is drawn 2.4 times the far one. A corner can turn to w = 1, six
// times as far out, but it is then at the middle in 3D: no corner is drawn farther out than
// 1.81 times its distance from the centre.
const EYE: f32 = 1.2
// Struts are drawn no thicker than this many times `STRUT`, so a corner turned almost to the
// eye does not balloon.
const THICKEST: f32 = 2.4
// The corners' spread in 3D: the farthest corner reaches 1.62 times the size, as it did with
// the eye at 2.
const SPREAD: f32 = 0.895
// However it turns, the tesseract stays inside a sphere this many times its size.
const REACH: f32 = 1.7

// Where and how it is drawn: the camera, the tesseract's place and size, and the light.
pub struct Artifact: Copy + GpuData {
    pub eye: vec4,
    pub target: vec4,
    // Centre and size.
    pub place: vec4,
    // The colour its studio's lights take (at full brightness), and how far they take it.
    pub tint: vec4,
    pub screen: vec2,
    pub lens: f32,
    pub time: f32,
    pub light: f32,
    // The most rays a pixel: 4, or 1 on a device that can't keep up (`samples`).
    pub rays: u32,
}

fn corner(i: u32) -> vec4 {
    vec4(
        if (i & 1) == 0 { -1.0 } else { 1.0 },
        if (i & 2) == 0 { -1.0 } else { 1.0 },
        if (i & 4) == 0 { -1.0 } else { 1.0 },
        if (i & 8) == 0 { -1.0 } else { 1.0 },
    )
}

// The 32 struts: corners that differ in one coordinate.
pub fn edges() -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for i in 0..16 {
        for bit in [1, 2, 4, 8] {
            if (i & bit) == 0 { out.push(vec4(f32(i), f32(i | bit), 0.0, 0.0)) }
        }
    }
    out
}

// The 24 square faces, their corners in order around each.
pub fn faces() -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    let bits = [1, 2, 4, 8]
    for a in 0..4 {
        for b in a + 1..4 {
            let (ba, bb) = (bits[a], bits[b])
            for rest in 0..16 {
                if (rest & ba) != 0 || (rest & bb) != 0 { continue }
                out.push(vec4(f32(rest), f32(rest | ba), f32(rest | ba | bb), f32(rest | bb)))
            }
        }
    }
    out
}

fn plane(q: vec4, angle: f32, a: u32, b: u32) -> vec4 {
    var v = q
    let c = cos(angle)
    let s = sin(angle)
    let x = v[a]
    let y = v[b]
    v[a] = c * x - s * y
    v[b] = s * x + c * y
    v
}

// How large a corner at `w` is drawn.
pub fn swell(w: f32) -> f32 {
    EYE / (EYE - w)
}

// How thick a strut is drawn at a corner at `w`, against `STRUT`.
pub fn thickness(w: f32) -> f32 {
    min(swell(w), THICKEST)
}

// Steady turns in four planes at once, as only four dimensions allow. The x–w turn passes the
// cells through each other and turns them inside out; the y–z turn beside it, at another rate,
// unbalances the eversion; a y–w turn slowly carries the eversion round to new directions; a
// yaw and a fixed tilt show its depth. The rates share no common period, so it never repeats,
// and every corner moves at a steady speed throughout.
//
// At `t` = 0, w is w, so the two cells nest exactly, one inside the other, and the whole is
// seen three-quarters on.
fn spin(q: vec4, t: f32) -> vec4 {
    let everted = plane(plane(q, t * 1.19, a: 0, b: 3), t * 0.735, a: 1, b: 2)
    let carried = plane(everted, t * 0.493, a: 1, b: 3)
    plane(plane(carried, t * 0.357 + 0.62, a: 0, b: 2), 0.42, a: 1, b: 2)
}

// The sixteen corners at `turn` (radians of the slow rotation), seen from a 4D eye and placed
// at `centre` at `size`: world position, and 4D depth in `w` (-1 far, 1 near).
pub fn corners(turn: f32, centre: vec3, size: f32) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for i in 0..16 {
        let q = spin(corner(i) * 0.5, turn)
        out.push(vec4(centre + q.xyz * (swell(q.w) * SPREAD * size), q.w))
    }
    out
}

@fuel(2 ** 30)
const STRUT_ENDS: Vec<vec4> = edges()
@fuel(2 ** 30)
const PANE_CORNERS: Vec<vec4> = faces()

// What the tracer reads of the tesseract placed at `verts` (`corners`) at `size`, worked out
// once a frame instead of in every ray. Each strut: its ends with their radii, and their
// depths in w with its half length. Each pane: its plane (unit normal and offset), the four
// planes through its edges, upright to it and facing in, and the sphere round its diagonal.
pub struct Shapes {
    pub struts: Vec<vec4>,
    pub panes: Vec<vec4>,
}

pub fn shapes(verts: [vec4], size: f32) -> Shapes {
    var struts: Vec<vec4> = Vec::new()
    for edge in STRUT_ENDS {
        let a = verts[u32(edge.x)]
        let b = verts[u32(edge.y)]
        let radius = STRUT * size
        struts.push(vec4(a.xyz, radius * thickness(a.w)))
        struts.push(vec4(b.xyz, radius * thickness(b.w)))
        struts.push(vec4(a.w, b.w, length(b.xyz - a.xyz) * 0.5, 0.0))
    }
    var panes: Vec<vec4> = Vec::new()
    for q in PANE_CORNERS {
        let c = [verts[u32(q.x)].xyz, verts[u32(q.y)].xyz, verts[u32(q.z)].xyz, verts[u32(q.w)].xyz]
        let n = normalize(cross(c[1] - c[0], c[3] - c[0]))
        panes.push(vec4(n, dot(n, c[0])))
        for i in 0..4 {
            let m = cross(n, normalize(c[(i + 1) % 4] - c[i]))
            panes.push(vec4(m, dot(m, c[i])))
        }
        panes.push(vec4((c[0] + c[2]) * 0.5, length(c[2] - c[0]) * 0.5))
    }
    Shapes { struts, panes }
}

// ---- exact ray tests -----------------------------------------------------------------------

// Where a ray enters a round cone (a tapered strut: spheres of radius `ra` at `pa` and `rb`
// at `pb` and the cone that wraps them), and the normal there; `x` -1 for a miss. After Inigo
// Quilez's ray-surface intersectors (MIT licence).
fn round_cone(ro: vec3, rd: vec3, pa: vec3, pb: vec3, ra: f32, rb: f32) -> vec4 {
    let ba = pb - pa
    let oa = ro - pa
    let ob = ro - pb
    let rr = ra - rb
    let m0 = dot(ba, ba)
    let m1 = dot(ba, oa)
    let m2 = dot(ba, rd)
    let m3 = dot(rd, oa)
    let m5 = dot(oa, oa)
    let m6 = dot(ob, rd)
    let m7 = dot(ob, ob)
    // The cone's side.
    let d2 = m0 - rr * rr
    let k2 = d2 - m2 * m2
    let k1 = d2 * m3 - m1 * m2 + m2 * rr * ra
    let k0 = d2 * m5 - m1 * m1 + m1 * rr * ra * 2.0 - m0 * ra * ra
    let h = k1 * k1 - k0 * k2
    if h < 0.0 { return vec4(-1.0) }
    let t = (-sqrt(h) - k1) / k2
    let y = m1 - ra * rr + t * m2
    if y > 0.0 && y < d2 { return vec4(t, normalize((oa + rd * t) * d2 - ba * y)) }
    // Its two round ends.
    let h1 = m3 * m3 - m5 + ra * ra
    let h2 = m6 * m6 - m7 + rb * rb
    var best = vec4(-1.0)
    if h1 > 0.0 {
        let t1 = -m3 - sqrt(h1)
        best = vec4(t1, (oa + rd * t1) / ra)
    }
    if h2 > 0.0 {
        let t2 = -m6 - sqrt(h2)
        if best.x < 0.0 || t2 < best.x { best = vec4(t2, (ob + rd * t2) / rb) }
    }
    best
}

// Where a ray crosses pane `f` at least `inset` inside its edges, or -1. The glass of a face
// starts where its struts' surfaces are, not at their centrelines under the metal.
fn pane(ro: vec3, rd: vec3, panes: [vec4], f: u32, inset: f32) -> f32 {
    let at = f * PANE_WORDS
    let plane = panes[at]
    let denom = dot(rd, plane.xyz)
    if abs(denom) < 0.000001 { return -1.0 }
    let t = (plane.w - dot(ro, plane.xyz)) / denom
    if t <= 0.0 { return -1.0 }
    let p = ro + rd * t
    // Each edge's signed distance to the point, in the face's plane.
    let s1 = dot(p, panes[at + 1].xyz) - panes[at + 1].w
    let s2 = dot(p, panes[at + 2].xyz) - panes[at + 2].w
    let s3 = dot(p, panes[at + 3].xyz) - panes[at + 3].w
    let s4 = dot(p, panes[at + 4].xyz) - panes[at + 4].w
    if min(min(s1, s2), min(s3, s4)) >= inset || max(max(s1, s2), max(s3, s4)) <= -inset {
        return t
    }
    -1.0
}

pub struct Hit: Copy {
    pub at: f32,
    pub normal: vec3,
    pub depth: f32,
    // How much of the pixel the strut covers, and which strut it is.
    pub cover: f32,
    pub strut: f32,
}

// The nearest strut of `mask` other than `skip` that covers some of the pixel. A pixel's
// footprint is `cone.x` wide where the ray starts and widens by `cone.y` for each unit it
// travels. A strut counts for the share of that footprint it covers, so one far away, or seen
// in the glass, thins to a faint line instead of breaking into dashes between pixels.
fn metal_hit(ro: vec3, rd: vec3, struts: [vec4], cone: vec2, skip: f32, mask: u32) -> Hit {
    var hit = Hit { at: 1.0e9, normal: vec3(0.0), depth: 0.0, cover: 0.0, strut: -1.0 }
    var left = mask
    while left != 0 {
        let e = left.trailing_zeros()
        left = left & (left - 1)
        if f32(e) == skip { continue }
        let a = struts[e * STRUT_WORDS]
        let b = struts[e * STRUT_WORDS + 1]
        let ends = struts[e * STRUT_WORDS + 2]
        let (ra, rb, half) = (a.w, b.w, ends.z)
        let ba = b.xyz - a.xyz
        // Most struts are nowhere near the ray: a sphere about each rules it out cheaply.
        let mid = (a.xyz + b.xyz) * 0.5 - ro
        let along = dot(mid, rd)
        let reach = half + max(ra, rb) + cone.x + cone.y * max(along + half, 0.0)
        if dot(mid, mid) - along * along > reach * reach || along < -reach { continue }
        // Where the ray passes closest to the strut's centreline.
        let oa = ro - a.xyz
        let baba = dot(ba, ba)
        let bard = dot(ba, rd)
        let rdoa = dot(rd, oa)
        let skew = baba - bard * bard
        var h = if skew > 0.000001 { saturate((dot(ba, oa) - rdoa * bard) / skew) } else { 0.5 }
        let t = max(h * bard - rdoa, 0.0)
        h = saturate(dot(oa + rd * t, ba) / baba)
        let off = oa + rd * t - ba * h
        let gap = length(off)
        // The strut's radius where the ray passes it.
        let r = mix(ra, rb, h)
        let footprint = cone.x + cone.y * t
        let cover = saturate(0.5 - (gap - r) / footprint)
        if cover <= 0.0 { continue }
        // Inside the strut, the ray meets its surface; beside it, the pixel catches its rim.
        let surface = if gap < r { round_cone(ro, rd, a.xyz, b.xyz, ra, rb) } else {
            vec4(t, off / max(gap, 0.000001))
        }
        let at = surface.x
        if at > 0.0001 && at < hit.at {
            let p = ro + rd * at
            let k = saturate(dot(p - a.xyz, ba) / baba)
            var normal = surface.yzw
            // A pixel across the strut's edge sees the band of it between the edge and the
            // pixel's inner side, not the edge alone, where it would mirror whatever is behind
            // the strut in a hairline that flickers as the edge crosses pixels.
            if gap + footprint * 0.5 > r {
                let x = clamp((max(gap - footprint * 0.5, -r) + r) * 0.5, 0.0, r)
                let axis = ba / sqrt(baba)
                let toward = normalize(rd * -1.0 + axis * dot(rd, axis))
                normal = normalize(off / max(gap, 0.000001) * x + toward * sqrt(r * r - x * x))
            }
            hit = Hit {
                at: at,
                normal,
                depth: mix(ends.x, ends.y, k),
                cover: cover,
                strut: f32(e),
            }
        }
    }
    hit
}

// The nearest pane of `mask` other than `skip`: distance and which (-1 for none).
fn face_hit(ro: vec3, rd: vec3, skip: f32, panes: [vec4], inset: f32, mask: u32) -> vec2 {
    var best = 1.0e9
    var which = -1.0
    var left = mask
    while left != 0 {
        let f = left.trailing_zeros()
        left = left & (left - 1)
        if f32(f) == skip { continue }
        let bound = panes[f * PANE_WORDS + 5]
        let mid = bound.xyz - ro
        let along = dot(mid, rd)
        if dot(mid, mid) - along * along > bound.w * bound.w || along < -bound.w { continue }
        let t = pane(ro, rd, panes, f, inset)
        if t > 0.0002 && t < best {
            best = t
            which = f32(f)
        }
    }
    vec2(best, which)
}

// The struts and the panes that a pixel's rays, from `ro` along about `rd`, can come near:
// the struts whose centrelines the line passes within their radius and `margin`, and the
// panes it crosses within `margin` of their edges (all it runs nearly along). Each of the
// pixel's rays runs along that line, past each pane it crosses, so it needs test no others.
fn near(ro: vec3, rd: vec3, struts: [vec4], panes: [vec4], margin: f32) -> vec2u {
    var metal: u32 = 0
    for e in 0..EDGES {
        let a = struts[e * STRUT_WORDS]
        let b = struts[e * STRUT_WORDS + 1]
        // The squared distance from the line to the centreline's point `h` along it is
        // quadratic in `h`: least at `h`, held to the strut.
        let ba = b.xyz - a.xyz
        let w = a.xyz - ro
        let bard = dot(ba, rd)
        let wrd = dot(w, rd)
        let k2 = dot(ba, ba) - bard * bard
        let k1 = dot(w, ba) - wrd * bard
        let h = if k2 > 0.000001 { saturate(-k1 / k2) } else { 0.5 }
        let gap = dot(w, w) - wrd * wrd + h * (2.0 * k1 + h * k2)
        let reach = max(a.w, b.w) + margin
        if gap <= reach * reach { metal = metal | (u32(1) << e) }
    }
    var glass: u32 = 0
    for f in 0..FACES {
        let at = f * PANE_WORDS
        let plane = panes[at]
        let denom = dot(rd, plane.xyz)
        var crossed = abs(denom) < 0.05
        if !crossed {
            let p = ro + rd * ((plane.w - dot(ro, plane.xyz)) / denom)
            // A ray that leaves the line by `margin` meets the plane this far off, at most.
            let off = margin / abs(denom)
            let s1 = dot(p, panes[at + 1].xyz) - panes[at + 1].w
            let s2 = dot(p, panes[at + 2].xyz) - panes[at + 2].w
            let s3 = dot(p, panes[at + 3].xyz) - panes[at + 3].w
            let s4 = dot(p, panes[at + 4].xyz) - panes[at + 4].w
            crossed = min(min(s1, s2), min(s3, s4)) >= -off || max(max(s1, s2), max(s3, s4)) <= off
        }
        if crossed { glass = glass | (u32(1) << f) }
    }
    vec2u(metal, glass)
}

// ---- light ---------------------------------------------------------------------------------

fn panel(d: vec3, axis: vec3, size: vec2, soft: f32) -> f32 {
    let facing = dot(d, axis)
    if facing <= 0.0 { return 0.0 }
    let side = normalize(cross(axis, vec3(0.0, 1.0, 0.0)))
    let up = cross(side, axis)
    let at = vec2(dot(d, side), dot(d, up)) / facing
    let edge = abs(at) - size
    saturate(1.0 - max(edge.x, edge.y) / soft)
}

// A light's colour `base`, taken `k` of the way toward the tint.
fn hued(base: vec3, tint: vec4, k: f32) -> vec3 {
    mix(base, tint.xyz, tint.w * k)
}

// The studio's soft room, lighter overhead and faintly lit low down, so metal always has
// something to show.
fn room(d: vec3) -> vec3 {
    vec3(0.095) * smoothstep(-0.25, 0.9, d.y) + vec3(0.04) * smoothstep(0.1, -0.6, d.y)
}

// The studio as polished things see it: a broad key overhead, two tall strips
// behind, a low fill, a band behind, and a soft room so metal always has something to show.
// Across one pixel a strut's reflection sweeps about 0.4 radians of it, so no softbox is
// narrower or harder-edged than that: a finer one would break into dashes along the struts.
// The tint colours the strips, the band and the room most, and the key least, so the
// tesseract keeps its white highlights.
pub fn studio(d: vec3, tint: vec4) -> vec3 {
    let key = panel(d, normalize(vec3(-0.35, 0.9, 0.35)), vec2(0.6, 0.32), 0.35)
    let left = panel(d, normalize(vec3(-0.92, 0.12, -0.38)), vec2(0.16, 0.95), 0.3)
    let right = panel(d, normalize(vec3(0.9, 0.18, -0.4)), vec2(0.14, 0.95), 0.3)
    let fill = panel(d, normalize(vec3(0.6, -0.05, 0.8)), vec2(0.6, 0.22), 0.3)
    let back = panel(d, normalize(vec3(0.0, 0.25, -1.0)), vec2(0.9, 0.12), 0.25)
    hued(vec3(1.0, 0.99, 0.98), tint, 0.4) * key * 1.8 +
        hued(vec3(0.9, 0.94, 1.0), tint, 0.85) * (left * 1.3 + right * 1.1) +
        hued(vec3(0.95, 0.95, 1.0), tint, 0.5) * fill * 0.45 +
        hued(vec3(0.95, 0.96, 1.0), tint, 0.85) * back * 0.6 +
        room(d) * hued(vec3(1.0), tint, 0.85)
}

// The studio blurred, as a strut too thin to resolve its softboxes sees it: each softbox a
// broad lobe toward it.
fn blurred(d: vec3, tint: vec4) -> vec3 {
    let lobe = |axis: vec3, k: f32| -> f32 { pow(saturate(dot(d, normalize(axis))), k) }
    hued(vec3(1.0, 0.99, 0.98), tint, 0.4) * lobe(vec3(-0.35, 0.9, 0.35), 3.0) * 1.0 +
        hued(vec3(0.9, 0.94, 1.0), tint, 0.85) *
            (lobe(vec3(-0.92, 0.12, -0.38), 4.0) * 0.45 + lobe(vec3(0.9, 0.18, -0.4), 4.0) * 0.4) +
        hued(vec3(0.95, 0.95, 1.0), tint, 0.5) * lobe(vec3(0.6, -0.05, 0.8), 2.0) * 0.25 +
        hued(vec3(0.95, 0.96, 1.0), tint, 0.85) * lobe(vec3(0.0, 0.25, -1.0), 3.0) * 0.25 +
        room(d) * hued(vec3(1.0), tint, 0.85)
}

// The dark the camera sees straight on: no softboxes, a faint glow low down. A tint colours
// the glow and spreads it a little higher.
pub fn darkness(d: vec3, tint: vec4) -> vec3 {
    let low = exp(-abs(d.y + 0.05) * mix(6.0, 3.0, tint.w))
    vec3(0.004, 0.0042, 0.0052) * hued(vec3(1.0), tint, 0.6) +
        mix(vec3(0.012, 0.012, 0.013), tint.xyz * 0.03, tint.w) * low
}

// A spotlight in the tint's colour, seen in the haze along a ray from `ro`: a beam from high
// above and a little behind that shines down through the tesseract and widens and fades
// below it, and a soft glow behind it.
fn beam(ro: vec3, rd: vec3, look: Artifact) -> vec3 {
    if look.tint.w <= 0.0 { return vec3(0.0) }
    let size = look.place.w
    let centre = look.place.xyz
    let source = centre + vec3(-0.5, 5.0, -1.6) * size
    let axis = normalize(centre - source)
    // Where the ray passes nearest the beam's axis.
    let w0 = ro - source
    let b = dot(rd, axis)
    let d = dot(rd, w0)
    let e = dot(axis, w0)
    let across = max(1.0 - b * b, 0.0001)
    let t = max((b * e - d) / across, 0.0)
    let s = max((e - b * d) / across, 0.0)
    let miss = length(w0 + rd * t - axis * s)
    let through = length(centre - source)
    let radius = size * 0.45 + s * 0.16
    let lit = smoothstep(0.0, through * 0.6, s) * exp(-max(s - through, 0.0) / (size * 3.0))
    let shaft = exp(-miss * miss / (radius * radius)) * lit * 0.035
    let to = centre - ro
    let off = length(cross(rd, normalize(to))) * length(to) / (size * REACH)
    let glow = exp(-off * off * 0.9) * 0.035
    look.tint.xyz * (shaft + glow) * look.tint.w
}

// Heavy struts near in the fourth dimension are black chrome; the needles far inside are
// satin silver, so they still show against the dark.
pub fn metal(depth: f32) -> vec3 {
    mix(vec3(0.5, 0.51, 0.53), vec3(0.08, 0.082, 0.088), smoothstep(-0.5, 0.5, depth))
}

// A band of light that passes through the fourth dimension, from the near cell to the far one
// every 8 seconds: it catches everything at one depth in w at once, however far apart in 3D,
// and slides along the struts that cross that depth.
pub fn glint(depth: f32, time: f32) -> f32 {
    pow(saturate(sin(depth * 2.4 + time * 0.8) * 0.5 + 0.5), 30.0) * 0.55
}

// Polished metal at 4D depth `depth` under the studio. `rough` (0 to 1) blurs what it mirrors,
// for struts too thin on screen to show it sharply.
pub fn polished(depth: f32, n: vec3, rd: vec3, time: f32, rough: f32, tint: vec4) -> vec3 {
    let f0 = metal(depth)
    let cosv = saturate(-dot(rd, n))
    // A strut's silhouette is thinner than a pixel at grazing angles; a full white rim there
    // would sparkle, so the rim stays mostly the metal's own colour.
    let fresnel = f0 + (vec3(1.0) - f0) * pow(1.0 - cosv, 5.0) * 0.25
    let r = rd - n * (2.0 * dot(rd, n))
    let key = normalize(vec3(-0.35, 0.9, 0.35))
    let sharp = studio(r, tint) + pow(saturate(dot(r, key)), 12.0) * 0.5
    mix(sharp, blurred(r, tint), rough) * fresnel +
        f0 * 0.04 +
        (f0 + vec3(0.1)) * glint(depth, time)
}

// The glass ripples slowly, in broad folds.
fn ripple(p: vec3, n: vec3, time: f32, size: f32) -> vec3 {
    let q = p / size
    let w = vec3(
        sin(dot(q, vec3(2.3, 1.7, -1.1)) + time * 0.6),
        sin(dot(q, vec3(-1.5, 2.6, 1.9)) + time * 0.5),
        sin(dot(q, vec3(2.0, -1.3, 2.4)) - time * 0.7),
    )
    normalize(n + (w - n * dot(w, n)) * 0.16)
}

// One path of light from the eye: its colour.
fn trace(
    start: vec3,
    dir: vec3,
    struts: [vec4],
    panes: [vec4],
    nearby: vec2u,
    look: Artifact,
    spread: f32,
    rough: f32,
) -> vec3 {
    var ro = start
    let rd = dir
    var gathered = vec3(0.0)
    var through = vec3(1.0)
    var skip = -1.0
    var past = -1.0
    // A pixel's footprint where the ray starts, and how fast it widens.
    var cone = vec2(0.0, spread)
    let size = look.place.w
    let radius = STRUT * size
    for _ in 0..BOUNCES {
        let m = metal_hit(ro, rd, struts, cone, past, nearby.x)
        let f = face_hit(ro, rd, skip, panes, radius * thickness(-1.0), nearby.y)
        if m.at < f.x {
            let shine = polished(m.depth, m.normal, rd, look.time, rough, look.tint)
            gathered += through * shine * m.cover
            if m.cover >= 1.0 { return gathered }
            // A strut's rim covers part of the pixel; the rest sees on past it.
            through *= 1.0 - m.cover
            past = m.strut
            continue
        }
        past = -1.0
        if f.y >= 0.0 {
            let p = ro + rd * f.x
            var n = panes[u32(f.y) * PANE_WORDS].xyz
            if dot(n, rd) > 0.0 { n = -n }
            let warped = ripple(p - look.place.xyz, n, look.time, size)
            let fresnel = 0.04 + 0.96 * pow(1.0 - saturate(-dot(rd, warped)), 5.0)
            let at_glass = vec2(cone.x + cone.y * f.x, cone.y)
            // A soft mirror toward the edges, faint face-on: the studio and the struts it faces.
            let r = rd - warped * (2.0 * dot(rd, warped))
            // Where it mirrors the studio, each colour sees it a little shifted along the
            // fold: the spectrum at the glass's edges.
            let fold = warped - n
            var mirrored = vec3(
                studio(normalize(r - fold * 0.05), look.tint).x,
                studio(r, look.tint).y,
                studio(normalize(r + fold * 0.05), look.tint).z,
            )
            // Only the nearest glass mirrors the struts: deeper layers are dim behind it, and
            // tracing their reflections too would cost as much again. It mirrors them as flat
            // glass, so they stay straight.
            let flat = rd - n * (2.0 * dot(rd, n))
            let seen = if skip < 0.0 {
                metal_hit(p + flat * 0.001, flat, struts, at_glass, -1.0, ALL)
            } else {
                Hit { at: 1.0e9, normal: vec3(0.0), depth: 0.0, cover: 0.0, strut: -1.0 }
            }
            if seen.at < 1.0e8 {
                let strut_seen = polished(
                    seen.depth,
                    seen.normal,
                    flat,
                    look.time,
                    rough,
                    look.tint,
                )
                mirrored = mix(mirrored, strut_seen, seen.cover)
            }
            let silvered = 0.03 + 0.55 * fresnel
            gathered += through * mirrored * silvered * 0.7
            // Smoked glass: what lies behind it darkens through each face.
            through *= (1.0 - silvered) * 0.6
            cone = at_glass
            ro = p
            skip = f.y
            continue
        }
        return gathered + through * (darkness(rd, look.tint) + beam(ro, rd, look))
    }
    gathered
}

// The ray through a pixel of this camera.
fn direction(look: Artifact, at: vec2) -> vec3 {
    let forward = normalize(look.target.xyz - look.eye.xyz)
    let side = normalize(cross(forward, vec3(0.0, 1.0, 0.0)))
    let up = cross(side, forward)
    let ndc = (at / look.screen) * 2.0 - vec2(1.0)
    normalize(forward + (side * ndc.x * (look.screen.x / look.screen.y) - up * ndc.y) * look.lens)
}

@fragment
pub fn artifact(pixel: FragCoord, struts: [vec4], panes: [vec4], look: Artifact) -> vec4 {
    let ro = look.eye.xyz
    // Rays that pass clear of it see only the dark.
    let reach = look.place.w * (REACH + STRUT * THICKEST)
    let rd = direction(look, pixel.position.xy)
    let o = ro - look.place.xyz
    let b = dot(o, rd)
    if look.place.w <= 0.001 || b * b - dot(o, o) + reach * reach <= 0.0 {
        return vec4((darkness(rd, look.tint) + beam(ro, rd, look)) * look.light, 1.0)
    }
    let spread = 2.0 * look.lens / look.screen.y
    // Struts at w = 0 decide how finely to sample: deciding by the far needles would take four
    // rays over the whole close tesseract in the opening.
    let across = STRUT * look.place.w / (spread * length(o))
    let n = samples(across, look.rays)
    let rough = roughness(across)
    // A ray's footprint is never wider than a pixel's, and the four rays leave the pixel's
    // middle by less than half a pixel, each no farther from the eye than across the sphere and
    // back: a pixel's line, widened by half again that much, passes near all that they can.
    let nearby = near(ro, rd, struts, panes, spread * (length(o) + reach * 2.0) * 1.5)
    if n == 1 {
        return vec4(trace(ro, rd, struts, panes, nearby, look, spread, rough) * look.light, 1.0)
    }
    let offsets = [vec2(0.25, -0.25), vec2(-0.25, 0.25), vec2(0.25, 0.25), vec2(-0.25, -0.25)]
    var c = vec3(0.0)
    for k in 0..n {
        // Each of the four rays covers half a pixel each way.
        let d = direction(look, pixel.position.xy + offsets[k])
        c += trace(ro, d, struts, panes, nearby, look, spread * 0.5, rough)
    }
    vec4(c / f32(n) * look.light, 1.0)
}

// Rays a pixel for struts `radius` pixels in radius, at most `most`. Struts cover pixels
// analytically, but the studio they mirror does not: across one pixel a thin strut's reflection
// sweeps more of it than the softboxes are wide, and breaks into dashes. Far away, four rays
// share that sweep.
pub fn samples(radius: f32, most: u32) -> u32 {
    if radius < 2.5 && most >= 4 { 4 } else { 1 }
}

// How blurred struts `radius` pixels in radius see the studio: below about four pixels its
// softboxes are narrower than the rays between them.
pub fn roughness(radius: f32) -> f32 {
    saturate((4.0 - radius) / 1.5)
}

@test
fn every_corner_meets_four_struts_and_six_faces() {
    let e = edges()
    let f = faces()
    assert(e.len() == EDGES && f.len() == FACES)
    for v in 0..16 {
        var struts = 0
        for edge in e { if u32(edge.x) == v || u32(edge.y) == v { struts += 1 } }
        var squares = 0
        for q in f {
            if u32(q.x) == v || u32(q.y) == v || u32(q.z) == v || u32(q.w) == v {
                squares += 1
            }
        }
        assert(struts == 4 && squares == 6)
    }
    // Each face's corners run round the square: neighbours differ in one coordinate.
    for q in f {
        let c = [u32(q.x), u32(q.y), u32(q.z), u32(q.w)]
        for i in 0..4 { assert((c[i] ^ c[(i + 1) % 4]).count_ones() == 1) }
    }
}

@test
fn the_tesseract_stays_within_its_reach_however_it_turns() {
    for i in 0..400 {
        let turn = f32(i) * 0.37
        for p in corners(turn, vec3(1.0, 2.0, 3.0), 1.4) {
            assert(length(p.xyz - vec3(1.0, 2.0, 3.0)) < 1.4 * REACH, "inside the traced sphere")
            assert(p.w >= -1.01 && p.w <= 1.01)
        }
    }
    let a = corners(0.0, vec3(0.0), 1.0)
    let b = corners(0.5, vec3(0.0), 1.0)
    var moved = 0.0
    for i in 0..16 { moved += length(a[i].xyz - b[i].xyz) }
    assert(moved > 0.5, "it turns")
}

@test
fn far_struts_take_more_rays_than_near_ones() {
    // The opening holds it close, struts about three pixels in radius at w = 0; the room far
    // back, about two.
    assert(samples(2.9, most: 4) == 1 && samples(2.0, most: 4) == 4)
    assert(samples(2.0, most: 1) == 1, "one ray on a device that can't keep up")
    // And see the studio blurred, where the opening sees it sharp.
    assert(roughness(2.9) < 0.8 && roughness(2.0) == 1.0)
}

@test
fn a_strut_covers_the_share_of_a_pixel_it_fills() {
    // Look straight at the outermost strut from just outside it.
    let verts = corners(0.0, vec3(0.0), 1.0)
    let edges = edges()
    var outer = 0
    var far = 0.0
    for e in 0..EDGES {
        let mid = (verts[u32(edges[e].x)].xyz + verts[u32(edges[e].y)].xyz) * 0.5
        if length(mid) > far {
            far = length(mid)
            outer = e
        }
    }
    let ends = (verts[u32(edges[outer].x)], verts[u32(edges[outer].y)])
    let a = ends.0.xyz
    let b = ends.1.xyz
    let mid = (a + b) * 0.5
    let axis = normalize(b - a)
    let out = normalize(mid - axis * dot(mid, axis))
    let eye = mid + out * 0.6
    let side = normalize(cross(axis, out))
    // Its radius at its middle, between those at its two corners.
    let radius = STRUT * (thickness(ends.0.w) + thickness(ends.1.w)) * 0.5
    let footprint = radius * 0.5
    let struts = shapes(verts, size: 1.0).struts
    let cover = |offset: f32| -> f32 {
        let toward = normalize(mid + side * offset - eye)
        let hit = metal_hit(eye, toward, struts, vec2(footprint, 0.0), -1.0, ALL)
        if hit.strut == f32(outer) { hit.cover } else { 0.0 }
    }
    assert(cover(0.0) == 1.0, "through the middle")
    assert(abs(cover(radius) - 0.5) < 0.05, "half on its rim")
    assert(abs(cover(radius + footprint * 0.25) - 0.25) < 0.05, "a little beside it")
    assert(cover(radius + footprint) == 0.0, "clear of it")
}

@test
fn a_pane_is_met_inside_its_edges_and_missed_outside_them() {
    let verts = corners(0.7, vec3(0.0), 1.0)
    let panes = shapes(verts, size: 1.0).panes
    let f = faces()
    for k in 0..FACES {
        let c = [
            verts[u32(f[k].x)].xyz,
            verts[u32(f[k].y)].xyz,
            verts[u32(f[k].z)].xyz,
            verts[u32(f[k].w)].xyz,
        ]
        let middle = (c[0] + c[1] + c[2] + c[3]) * 0.25
        let n = panes[k * PANE_WORDS].xyz
        // A face's corners lie in its plane: a 4D square seen in perspective stays flat.
        for corner in c { assert(abs(dot(corner - middle, n)) < 0.0001) }
        let eye = middle + n * 3.0
        let t = pane(eye, n * -1.0, panes, k, inset: 0.0)
        assert(abs(t - 3.0) < 0.001, "through its middle")
        // Past the middle of an edge, a little outside it.
        let outside = (c[0] + c[1]) * 0.5 + ((c[0] + c[1]) * 0.5 - middle) * 0.05
        assert(pane(eye, normalize(outside - eye), panes, k, inset: 0.0) < 0.0, "beside it")
        let inside = (c[0] + c[1]) * 0.5 - ((c[0] + c[1]) * 0.5 - middle) * 0.05
        assert(pane(eye, normalize(inside - eye), panes, k, inset: 0.0) > 0.0, "within it")
        assert(pane(eye, normalize(inside - eye), panes, k, inset: 0.2) < 0.0, "inside the inset")
    }
}

@test
fn a_pixel_traces_the_same_with_only_the_struts_and_panes_near_its_line() {
    // The opening's close tesseract and the room's far one, seen across the sphere round it.
    for (eye, centre, size, turn) in [
        (vec3(0.0, 1.75, 6.4), vec3(0.0, 1.95, 1.4), 0.66, 0.0),
        (vec3(0.3, 1.7, 6.4), vec3(4.0, 9.0, -32.0), 2.8, 3.1),
    ] {
        let s = shapes(corners(turn, centre, size), size)
        let screen = vec2(160.0, 90.0)
        let look = Artifact {
            screen,
            lens: 0.36,
            eye: vec4(eye, 0.0),
            target: vec4(centre, 0.0),
            place: vec4(centre, size),
            time: 1.3,
            light: 1.0,
            tint: vec4(0.4, 0.8, 1.0, 0.7),
            rays: 4,
        }
        let spread = 2.0 * look.lens / screen.y
        let reach = size * (REACH + STRUT * THICKEST)
        let margin = spread * (length(eye - centre) + reach * 2.0) * 1.5
        var tested = 0
        for y in 0..90 {
            for x in 0..160 {
                let at = vec2(f32(x), f32(y)) + vec2(0.5)
                let rd = direction(look, at)
                let nearby = near(eye, rd, s.struts, s.panes, margin)
                // A pixel's single ray, and one of its four.
                let d = direction(look, at + vec2(0.25, -0.25))
                for (ray, cone) in [(rd, spread), (d, spread * 0.5)] {
                    let all = vec2u(ALL, (u32(1) << FACES) - 1)
                    let whole = trace(eye, ray, s.struts, s.panes, all, look, cone, 0.5)
                    let culled = trace(eye, ray, s.struts, s.panes, nearby, look, cone, 0.5)
                    assert(whole == culled, f"pixel {x}, {y}")
                }
                if nearby.x != 0 { tested += 1 }
            }
        }
        assert(tested > 200, "the rays cross the tesseract")
    }
}

@test
fn a_tapered_strut_is_met_on_its_surface() {
    // Along x, radius 0.2 at x = -1 tapering to 0.1 at x = 1, seen from above.
    let a = vec3(-1.0, 0.0, 0.0)
    let b = vec3(1.0, 0.0, 0.0)
    let down = vec3(0.0, 0.0, -1.0)
    let middle = round_cone(vec3(0.0, 0.0, 5.0), down, a, b, ra: 0.2, rb: 0.1)
    assert(abs(5.0 - middle.x - 0.15) < 0.01 && middle.w > 0.99, "halfway, halfway thick")
    let thin = round_cone(vec3(1.0, 0.0, 5.0), down, a, b, ra: 0.2, rb: 0.1)
    assert(abs(5.0 - thin.x - 0.1) < 0.001, "the thin end")
    let thick = round_cone(vec3(-1.0, 0.0, 5.0), down, a, b, ra: 0.2, rb: 0.1)
    assert(abs(5.0 - thick.x - 0.2) < 0.001, "the thick end")
    assert(round_cone(vec3(0.0, 0.5, 5.0), down, a, b, ra: 0.2, rb: 0.1).x < 0.0, "a miss")
    // Struts meeting at a corner share its radius, so they weld; near corners are thicker.
    assert(swell(1.0) > 1.9 && swell(-1.0) < 0.7 && swell(0.0) == 1.0)
    // Nested, the near cell is drawn well over twice the far one.
    assert(swell(0.5) / swell(-0.5) > 2.4)
}

@test
fn the_glint_passes_from_the_near_cell_to_the_far_one() {
    // Where the glint is brightest moves steadily toward -w, and lights one depth at a time.
    var last = 1.0
    for i in 0..20 {
        let time = 6.9 + f32(i) * 0.3
        var brightest = -1.0
        var best = 0.0
        var lit = 0
        for k in 0..201 {
            let depth = 1.0 - f32(k) * 0.01
            let g = glint(depth, time)
            if g > best {
                best = g
                brightest = depth
            }
            if g > 0.4 { lit += 1 }
        }
        assert(brightest < last + 0.011, "always toward the far cell")
        assert(lit < 30, "a narrow band")
        last = brightest
    }
    assert(last < -0.8)
}

@test
fn the_tesseract_turns_at_one_steady_rate() {
    // With no easing, the corners move as far in each step, wherever the turn is.
    let step = 0.05
    var least = 1.0e9
    var most = 0.0
    for i in 0..200 {
        let t = f32(i) * 0.37
        var moved = 0.0
        for c in 0..16 {
            moved += length(
                spin(corner(c), t + step) - spin(corner(c), t),
            )
        }
        least = min(least, moved)
        most = max(most, moved)
    }
    assert(most < least * 1.05)
}

@test
fn at_rest_the_tesseract_is_a_cube_inside_a_cube() {
    let centre = vec3(1.0, 2.0, 3.0)
    let rest = corners(turn: 0.0, centre: centre, size: 1.3)
    // The far cell is the near one drawn smaller about the centre: each far corner lies on the
    // line from the centre to its near twin.
    let inner = swell(-0.5) / swell(0.5)
    for i in 0..8 {
        let far = rest[i]
        let near = rest[i + 8]
        assert(abs(far.w + 0.5) < 0.0001 && abs(near.w - 0.5) < 0.0001)
        assert(length((far.xyz - centre) - (near.xyz - centre) * inner) < 0.0001)
    }
    // Each cell is a true cube: its struts are one length and meet square.
    let edge = |a: u32, b: u32| -> vec3 { rest[b].xyz - rest[a].xyz }
    let side = length(edge(8, 9))
    for (a, b) in [(8, 9), (8, 10), (8, 12), (11, 15), (13, 15), (14, 15)] {
        assert(abs(length(edge(a, b)) - side) < 0.0001)
    }
    assert(
        abs(dot(edge(8, 9), edge(8, 10))) < 0.0001 && abs(dot(edge(8, 10), edge(8, 12))) < 0.0001,
    )
}

@test
fn the_turn_carries_every_corner_toward_the_eye_in_turn() {
    // One double rotation keeps corners within 0.71 of w = 0, and repeats. The turn carried
    // round through y–w brings each corner, in time, almost to the eye.
    var nearest = [0.0; 16]
    for i in 0..2000 {
        let t = f32(i) * 0.1
        for c in 0..16 {
            nearest[c] = max(nearest[c], spin(corner(c) * 0.5, t).w)
        }
    }
    for c in 0..16 { assert(nearest[c] > 0.9) }
    // However near, its struts stay no thicker than they were.
    assert(thickness(0.99) == THICKEST && thickness(0.0) == 1.0)
}
