// The console's GPU work: the void around the traced artifact in the opening, the chosen game's
// hero behind the home, its title art and the games' covers, and the flat mark.
use room::Camera
use std::gpu::{ClipPosition, FragCoord, Over, Rgba8, Rgba16Float, Sampler, Texture, VertexIndex}
use brand::facet::{CAP, MARK_HALF, MarkRun, mark_distance}

pub struct Vertex {
    pub position: ClipPosition,
    pub uv: vec2,
    pub pixel: vec2,
}

@vertex
pub fn quad(v: VertexIndex, screen: vec2, rect: vec4) -> Vertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    let uv = corners[v.index]
    let p = rect.xy + rect.zw * uv
    Vertex {
        position: ClipPosition {
            position: vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0),
        },
        uv,
        pixel: p,
    }
}

fn tone(x: vec3) -> vec3 {
    saturate((x * (x * 2.51 + vec3(0.03))) / (x * (x * 2.43 + vec3(0.59)) + vec3(0.14)))
}

// How much of the room shows: the opening's light.
pub struct Stage: Copy + GpuData {
    pub reveal: f32,
}

// The opening's room: the artifact turning in the void.
@fragment
pub fn stage(
    v: Vertex,
    room: Texture<Rgba16Float>,
    linear: Sampler,
    camera: Camera,
    look: Stage,
) -> vec4 {
    let seen = room.sample_level(linear, v.pixel / camera.screen.xy, 0.0)
    vec4(tone(seen.xyz * 1.6) * look.reveal, 1.0)
}

// The home behind the text: the chosen game's hero, filling the screen, darkened behind the text
// by a soft gradient in its own colour. Until its hero comes, its cover blurred in its place, and
// before that its colour: never an empty dark. With the game playing itself behind the console
// (attract.wrela), the hero fades out over it: the screen is see-through where the hero was, and
// the gradient's dark stays over the game, so the text reads as it did.
pub struct Backdrop: Copy + GpuData {
    // The hero's size and the cover's small copy's, in pixels: 0 while it isn't there.
    pub sizes: vec4,
    // How far the hero has come in over what stands in for it, how lit it all is, and how far
    // what stands in for it has drifted, in pixels.
    pub look: vec4,
    // The game's colour, and how much of the gradient's dark takes it.
    pub tint: vec4,
    // The screen's size, how far across the text's side darkens (a fraction of the width), and
    // how high the dark along the bottom reaches (a fraction of the height).
    pub screen: vec4,
    // How far the hero has faded out over the game behind (0: the hero alone, as without one);
    // the rest unused.
    pub behind: vec4,
}

// The pixel of an image of `size` that fills the screen (cropping its overflow, centred) at
// screen pixel `p`, `over` times larger than the screen so a drift of `drift` pixels never shows
// an edge; as a fraction of the image.
fn filling(p: vec2, screen: vec2, size: vec2, drift: vec2, over: f32) -> vec2 {
    let scale = max(screen.x / size.x, screen.y / size.y) * over
    ((p - drift - screen * 0.5) / scale + size * 0.5) / size
}

// A cheap hash of a pixel, 0 to 1, to dither the gradient's long, smooth ramps.
fn grain(p: vec2) -> f32 {
    fract(sin(dot(floor(p), vec2(12.9898, 78.233))) * 43758.547)
}

@fragment
pub fn backdrop(
    v: Vertex,
    hero: Texture<Rgba8>,
    cover: Texture<Rgba8>,
    linear: Sampler,
    look: Backdrop,
) -> vec4 {
    let screen = look.screen.xy
    let p = v.pixel
    let drift = look.look.zw
    // What stands in for the hero: its colour, lit from above, and over it, once it's here, the
    // cover's small copy, blurred over a disc of 13 taps and dimmed, so it reads as colour and
    // shape, not as a picture. Before any art, a near black, which takes the art's colour as it
    // comes.
    let colour = mix(vec3(0.16), look.tint.xyz, look.tint.w)
    var stand = colour * mix(0.42, 0.18, p.y / screen.y)
    // Once the hero is all in, it hides the stand-in: no blur.
    if look.sizes.z > 0.0 && look.look.x < 1.0 {
        let at = filling(p, screen, look.sizes.zw, drift * 0.6, 1.03)
        let reach = vec2(1.6 / look.sizes.z, 1.6 / look.sizes.w)
        var sum = cover.sample_level(linear, at, 0.0).xyz
        for k in 0..12 {
            let a = f32(k) * 2.3999632
            let r = sqrt((f32(k) + 0.5) / 12.0)
            sum += cover.sample_level(linear, at + vec2(cos(a), sin(a)) * reach * r, 0.0).xyz
        }
        stand = sum / 13.0 * 0.78
    }
    var color = stand
    // The hero holds still, filling the screen exactly: it's the first frame of the game playing
    // itself behind (attract.wrela), which takes its place without a shift as it fades.
    if look.sizes.x > 0.0 {
        let at = filling(p, screen, look.sizes.xy, vec2(0.0), 1.0)
        color = mix(stand, hero.sample_level(linear, at, 0.0).xyz, look.look.x)
    }
    // The dark behind the text: across from the left, up from the bottom, and a little under the
    // header, each a soft ramp, together as layers of shade over each other.
    let x = p.x / screen.x
    let y = p.y / screen.y
    let across = 1.0 - smoothstep(0.0, look.screen.z, x)
    let side = 0.86 * across * across * (3.0 - 2.0 * across)
    let low = 0.78 * smoothstep(1.0 - look.screen.w, 1.0, y)
    let high = 0.4 * (1.0 - smoothstep(0.0, 0.14, y))
    let shade = 1.0 - (1.0 - side) * (1.0 - low) * (1.0 - high)
    let dark = look.tint.xyz * 0.05 * look.tint.w
    // Premultiplied: where the hero fades (`gone`), the game behind shows through as the hero
    // did, under the same dark and light, `mix(game, dark, shade) * lit`; with none, opaque.
    let gone = smoothstep(0.0, 1.0, look.behind.x)
    let lit = look.look.y
    let shaded = (mix(color, dark, shade) * (1.0 - gone) + dark * shade * gone) * lit
    vec4(shaded + vec3((grain(p) - 0.5) / 255.0), 1.0 - gone * (1.0 - shade) * lit)
}

// A picture in a rectangle: a game's title art, or its cover on a tile.
pub struct Picture: Copy + GpuData {
    // Where it's drawn, in pixels: its corner and size.
    pub rect: vec4,
    // How opaque it is, the radius of its corners in pixels, and how bright.
    pub look: vec4,
}

// Its image premultiplied, with its mip chain (`main::picture_texture`); drawn premultiplied.
@fragment
pub fn picture(v: Vertex, image: Texture<Rgba8>, linear: Sampler, look: Picture) -> vec4 {
    let size = look.rect.zw
    let uv = (v.pixel - look.rect.xy) / size
    let seen = image.sample(linear, uv)
    // Its corners rounded, their edges smoothed over a pixel.
    let radius = look.look.y
    let q = abs(v.pixel - look.rect.xy - size * 0.5) - (size * 0.5 - vec2(radius))
    let d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius
    let inside = saturate(0.5 - d)
    let cover = inside * look.look.x
    vec4(seen.xyz * look.look.z * cover, seen.w * cover)
}

// The mark's ink: how much of each pixel the mark covers, drawn once a size into a layer
// (`mark_ink`), which the screen then shows each frame (`emblem`).
pub struct Ink: Copy + GpuData {
    // The mark's centre on the screen, the screen pixel the layer starts at, and pixels per em.
    pub centre: vec2,
    pub origin: vec2,
    pub ems: f32,
    pub count: u32,
}

pub struct Emblem: Copy + GpuData {
    // The mark's centre on the screen, the screen pixel its ink's layer starts at, and pixels per
    // em.
    pub centre: vec2,
    pub origin: vec2,
    pub ems: f32,
    pub alpha: f32,
    // The light passing along it: 0 before the mark, 1 once it has crossed.
    pub reveal: f32,
    pub width: f32,
}

// Where screen pixel `pixel` is on the mark: ems from its middle, its baseline at 0.
fn on_mark(pixel: vec2, centre: vec2, ems: f32) -> vec2 {
    vec2(pixel.x - centre.x, centre.y - pixel.y) / ems + vec2(0.0, CAP * 0.5)
}

// How far (ems) past the box round a run's centreline its ink can reach: its half stroke, out
// to the point of its sharpest mitre.
const MITRE: f32 = MARK_HALF * 8.0

// The mark's field at `p` (ems) where it is under `edge`: the nearest run's. A run whose box,
// grown by `MITRE` and `edge`, doesn't hold `p` is no nearer than `edge`, so most pixels test
// a run or two, not all of them.
pub fn mark_field(p: vec2, runs: [MarkRun], count: u32, edge: f32) -> f32 {
    let pad = vec2(MITRE + edge)
    var d = 100.0
    for i in 0..count {
        let lo = min(runs[i].ab.xy, runs[i].ab.zw) - pad
        let hi = max(runs[i].ab.xy, runs[i].ab.zw) + pad
        if p.x < lo.x || p.y < lo.y || p.x > hi.x || p.y > hi.y { continue }
        d = min(d, mark_distance(p, runs[i]))
    }
    d
}

// The mark's ink in its layer, whose pixel `v.pixel` is the screen's `v.pixel + origin`.
@fragment
pub fn mark_ink(v: Vertex, runs: [MarkRun], look: Ink) -> vec4 {
    let p = on_mark(v.pixel + look.origin, look.centre, look.ems)
    vec4(saturate(0.5 - mark_field(p, runs, look.count, 0.5 / look.ems) * look.ems), 0.0, 0.0, 1.0)
}

// The flat mark, its ink read from its layer. As the light passes, each part of it comes up
// softly behind a broad glint.
@fragment
pub fn emblem(v: Vertex, ink: Texture<Rgba8>, look: Emblem) -> Over {
    let p = on_mark(v.pixel, look.centre, look.ems)
    let texel = vec2u(v.pixel - look.origin)
    let coverage = ink.load(texel.x, texel.y).x
    let across = p.x / look.width + 0.5
    let front = look.reveal * 1.45 - 0.15
    let shown = saturate((front - across) / 0.25)
    // Squared by hand: WGSL leaves `pow` undefined for a negative base, which blacked out the
    // letters the light had passed.
    let off = (across - front) * 9.0
    let edge = exp(-off * off)
    let color = mix(vec3(0.9, 0.91, 0.92), vec3(1.0), edge)
    Over { color: vec4(color, coverage * max(shown, edge) * look.alpha) }
}

@test
fn the_mark_is_drawn_the_same_testing_only_the_runs_near_each_pixel() {
    let runs = brand::facet::mark_runs()
    let width = brand::facet::mark_width()
    // From the header's small mark to the opening's large one: each pixel covered alike.
    for ems in [8.0, 21.0, 60.0, 150.0] {
        let edge = 0.5 / ems
        for y in 0..140 {
            for x in 0..i32(width * 100.0) + 60 {
                let p = vec2(f32(x) * 0.01 - width * 0.5 - 0.3, f32(y) * 0.01 - 0.35)
                var d = 100.0
                for r in runs { d = min(d, mark_distance(p, r)) }
                let whole = saturate(0.5 - d * ems)
                let near = saturate(0.5 - mark_field(p, runs, runs.len(), edge) * ems)
                assert(whole == near, f"at {p.x}, {p.y}, {ems} pixels an em")
            }
        }
    }
}
