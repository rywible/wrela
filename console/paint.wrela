// The console's GPU work: the void around the traced artifact, the album cards in
// perspective, and the flat mark.
use room::{Camera, Card, corner, project}
use std::gpu::{ClipPosition, FragCoord, Over, Rgba8, Rgba16Float, Sampler, Texture, VertexIndex}
use facet::{CAP, MarkRun, mark_distance}

pub struct Vertex {
    pub position: ClipPosition,
    pub uv: vec2,
    pub pixel: vec2,
}

@vertex
pub fn quad(v: VertexIndex, screen: vec2, rect: vec4) -> Vertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    let uv = corners[v.index]
    let p = rect.xy + rect.zw * uv
    Vertex {
        position: ClipPosition {
            position: vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0),
        },
        uv,
        pixel: p,
    }
}

fn tone(x: vec3) -> vec3 {
    saturate((x * (x * 2.51 + vec3(0.03))) / (x * (x * 2.43 + vec3(0.59)) + vec3(0.14)))
}

// How much of the room shows: the opening's light.
pub struct Stage: Copy + GpuData {
    pub reveal: f32,
}

// Everything behind the cards: the artifact turning in the void.
@fragment
pub fn stage(
    v: Vertex,
    room: Texture<Rgba16Float>,
    linear: Sampler,
    camera: Camera,
    look: Stage,
) -> vec4 {
    let seen = room.sample_level(linear, v.pixel / camera.screen.xy, 0.0)
    vec4(tone(seen.xyz * 1.6) * look.reveal, 1.0)
}

pub struct CardVertex {
    pub position: ClipPosition,
    // From 0 to 1 across the art; beyond, in the margin that holds the ring.
    pub uv: vec2,
}

@vertex
pub fn card_corner(v: VertexIndex, camera: Camera, card: Card) -> CardVertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    let margin = vec2(card.size.w) / card.size.xy
    let uv = mix(-margin, vec2(1.0) + margin, corners[v.index])
    let s = project(camera, corner(card, uv))
    let ndc = vec2(s.x / camera.screen.x * 2.0 - 1.0, 1.0 - s.y / camera.screen.y * 2.0)
    // Clip w is the depth, so the art is interpolated in perspective.
    CardVertex { position: ClipPosition { position: vec4(ndc * s.z, 0.5, s.z) }, uv }
}

// An album card: art with rounded corners and a faint hairline edge, with a ring when it has
// focus.

@fragment
pub fn card_face(
    v: CardVertex,
    art: Texture<Rgba8>,
    linear: Sampler,
    card: Card,
    has_art: f32,
) -> Over {
    let size = card.size.xy
    let local = (v.uv - vec2(0.5)) * size
    let radius = card.size.z
    let q = abs(local) - size * 0.5 + vec2(radius)
    let d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius
    let pixel = max(fwidth(d), 0.00001)
    let inside = saturate(0.5 - d / pixel)
    let sampled = art.sample_level(linear, saturate(v.uv), 0.0).xyz
    let base = mix(vec3(0.11, 0.11, 0.12), sampled, has_art)
    // A hairline just inside the edge, so dark art still has a shape against the dark.
    let hairline = saturate(1.0 - abs(d + pixel) / pixel) * 0.1
    let lit = mix(base, vec3(1.0), hairline) * card.look.x
    let gap = card.size.w * 0.5
    let band = saturate(1.0 - abs(d - gap) / pixel / 1.6) * card.look.y
    let alpha = max(inside, band) * card.look.z
    let color = lit * inside + vec3(0.97) * band
    Over { color: vec4(color / max(max(inside, band), 0.0001), alpha) }
}

pub struct Emblem: Copy + GpuData {
    // The mark's centre in pixels, and pixels per em.
    pub centre: vec2,
    pub ems: f32,
    pub alpha: f32,
    pub count: u32,
    // The light passing along it: 0 before the mark, 1 once it has crossed.
    pub reveal: f32,
    pub width: f32,
}

// The flat mark. As the light passes, each part of it comes up softly behind a broad glint.
@fragment
pub fn emblem(v: Vertex, runs: [MarkRun], look: Emblem) -> Over {
    let p = vec2(v.pixel.x - look.centre.x, look.centre.y - v.pixel.y) / look.ems +
        vec2(0.0, CAP * 0.5)
    var d = 100.0
    for i in 0..look.count { d = min(d, mark_distance(p, runs[i])) }
    let coverage = saturate(0.5 - d * look.ems)
    let across = p.x / look.width + 0.5
    let front = look.reveal * 1.45 - 0.15
    let shown = saturate((front - across) / 0.25)
    // Squared by hand: WGSL leaves `pow` undefined for a negative base, which blacked out the
    // letters the light had passed.
    let off = (across - front) * 9.0
    let edge = exp(-off * off)
    let color = mix(vec3(0.9, 0.91, 0.92), vec3(1.0), edge)
    Over { color: vec4(color, coverage * max(shown, edge) * look.alpha) }
}

// The selected game's art behind the library, filling the screen as a console's home does:
// softened, drifting slowly, and darkened where the title, the actions and the row sit over
// it. `alpha` fades it in and out as the selection changes.
pub struct Backdrop: Copy + GpuData {
    pub screen: vec2,
    pub art: vec2,
    pub alpha: f32,
    pub time: f32,
}

@fragment
pub fn backdrop(v: Vertex, art: Texture<Rgba8>, linear: Sampler, look: Backdrop) -> Over {
    let s = look.screen
    let fill = max(s.x / look.art.x, s.y / look.art.y)
    let size = look.art * fill
    var uv = (v.pixel - (s - size) * vec2(0.5, 0.3)) / size
    // A slow drift and breath, so the art is alive behind the still interface.
    let zoom = 1.06 + 0.02 * sin(look.time * 0.05)
    uv = (uv - vec2(0.5)) / zoom +
        vec2(0.5) +
        vec2(sin(look.time * 0.031), cos(look.time * 0.023)) * 0.006
    // Softened: a ring of samples a couple of the art's pixels round each.
    let step = vec2(1.5) / look.art
    var c = art.sample_level(linear, uv, 0.0).xyz * 0.2
    for k in 0..8 {
        let a = f32(k) * 0.7853982
        c += art.sample_level(linear, uv + vec2(cos(a), sin(a)) * step * 2.0, 0.0).xyz * 0.1
    }
    let p = v.pixel / s
    // Darker toward the left, where the title and actions are; toward the bottom, where the
    // row is; and a little at the top, under the header.
    let left = smoothstep(0.62, 0.0, p.x)
    let bottom = smoothstep(0.45, 1.0, p.y)
    let top = smoothstep(0.16, 0.0, p.y)
    var shade = 1.0 - left * 0.72
    shade *= 1.0 - bottom * 0.8
    shade *= 1.0 - top * 0.5
    let edge = p * (vec2(1.0) - p)
    shade *= pow(saturate(edge.x * edge.y * 16.0), 0.18)
    Over { color: vec4(c * shade, look.alpha) }
}
