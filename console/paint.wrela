// A suspended, sculpted field and a font extrusion. The entire opening is Wrela.
use std::gpu::{ClipPosition, FragCoord, Over, Rgba8, Sampler, Texture, VertexIndex}
use ui::text::Font

pub struct Vertex {
    pub position: ClipPosition,
    pub uv: vec2,
    pub pixel: vec2,
}

@vertex
pub fn quad(v: VertexIndex, screen: vec2, rect: vec4, lean: f32 = 0.0) -> Vertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    let uv = corners[v.index]
    let local = (uv - vec2(0.5)) * rect.zw
    let perspective = 1.0 + local.x * sin(lean) / 700.0
    let p = rect.xy + rect.zw * 0.5 + vec2(local.x * cos(lean), local.y) / perspective
    Vertex {
        position: ClipPosition {
            position: vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0),
        },
        uv,
        pixel: p,
    }
}

pub struct Moment: Copy {
    pub morph: f32,
    pub light: f32,
    pub library: f32,
}

// One timeline controls the solid's transformation, its lights, and the library's reveal.
pub fn moment(time: f32, opening: bool) -> Moment {
    if !opening { return Moment { morph: 0.0, light: 0.7, library: 1.0 } }
    Moment {
        morph: smoothstep(2.5, 4.4, time),
        light: smoothstep(0.15, 1.25, time) * (1.0 - smoothstep(5.0, 5.7, time)),
        library: smoothstep(5.7, 6.6, time),
    }
}

// Assemble the actual supplied face's distance fields once, without raster or host policy.
pub fn word_field(font: Font) -> Vec<u8> {
    var bytes: Vec<u8> = Vec::filled(256 * 96 * 4, 0)
    let width = font.measure("Wrela", font.em)
    let _ = font.walk("Wrela", font.em, (256.0 - width) * 0.5, |_i, gi, pen| {
        let g = font.glyph(gi)
        let left = i32(round(pen + g.left))
        let top = i32(round(64.0 - g.top))
        for y in 0..g.height {
            for x in 0..g.width {
                let px = left + i32(x)
                let py = top + i32(y)
                if px >= 0 && px < 256 && py >= 0 && py < 96 {
                    let at = (u32(py) * 256 + u32(px)) * 4
                    let value = font.field_byte(gi, y * g.width + x)
                    bytes[at] = max(bytes[at], value)
                    bytes[at + 3] = 255
                }
            }
        }
        true
    })
    bytes
}

pub struct Field: Copy + GpuData {
    pub screen: vec2,
    pub time: f32,
    pub morph: f32,
    pub light: f32,
    pub library: f32,
}

fn turn(p: vec2, angle: f32) -> vec2 {
    let c = cos(angle)
    let s = sin(angle)
    vec2(c * p.x - s * p.y, s * p.x + c * p.y)
}

fn solid(p: vec3, field: Field, letters: Texture<Rgba8>, linear: Sampler) -> f32 {
    let m = field.morph
    let angle = (field.time * mix(0.6, 0.12, field.library) + 0.45) * (1.0 - m)
    let xz = turn(p.xz, angle)
    let yz = turn(vec2(p.y, xz.y), (0.5 + sin(field.time * 0.31) * 0.23) * (1.0 - m))
    let xy = turn(vec2(xz.x, yz.x), -0.2 * (1.0 - m))
    let q = vec3(xy.x / mix(1.0, 2.7, m), xy.y, yz.y)
    let a = atan2(q.y, q.x)
    let radius = 0.78 + 0.22 * cos(a * 3.0)
    let section = turn(vec2(length(q.xy) - radius, q.z - 0.32 * sin(a * 3.0)), a * 1.5)
    let tube = 0.19 + 0.035 * cos(a * 6.0 + field.time * 0.4)
    let knot = (length(section / vec2(0.52, 1.5)) - tube) * 0.27
    if m <= 0.001 { return knot }
    // The word spans 256/48 ems; the extrusion's bevel gives the letters real side faces.
    let word_xz = turn(p.xz, (0.12 + 0.14 * (1.0 - smoothstep(4.4, 5.7, field.time))) * m)
    let uv = vec2(word_xz.x / 8.0 + 0.5, 0.5 - p.y / 3.0)
    let sample = letters.sample_level(linear, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).x
    let ink = (0.5 - sample) * (10.0 / 48.0) * 1.5
    let bounds = abs(vec2(word_xz.x, p.y)) - vec2(4.0, 1.5)
    let outside = length(max(bounds, vec2(0.0))) + min(max(bounds.x, bounds.y), 0.0)
    let letter = max(max(ink, outside), abs(word_xz.y) - 0.11) - 0.012
    if m >= 0.999 { return letter }
    // Stretch the rotating solid before its mass resolves into the word's field.
    mix(knot, letter, m) - 0.20 * sin(m * 3.14159265)
}

fn normal(p: vec3, field: Field, letters: Texture<Rgba8>, linear: Sampler) -> vec3 {
    let e = 0.002
    let a = vec3(1.0, -1.0, -1.0)
    let b = vec3(-1.0, -1.0, 1.0)
    let c = vec3(-1.0, 1.0, -1.0)
    let d = vec3(1.0, 1.0, 1.0)
    normalize(
        a * solid(p + a * e, field, letters, linear) +
            b * solid(p + b * e, field, letters, linear) +
            c * solid(p + c * e, field, letters, linear) +
            d * solid(p + d * e, field, letters, linear),
    )
}

@fragment
pub fn chamber(pixel: FragCoord, field: Field, letters: Texture<Rgba8>, linear: Sampler) -> vec4 {
    let uv = pixel.position.xy / field.screen
    let aspect = field.screen.x / field.screen.y
    let center = vec2(0.5, mix(0.49, 0.27, field.library))
    let scale = max(1.0, mix(0.78, 1.18, field.morph) / aspect) * mix(1.0, 1.65, field.library)
    let xy = (uv - center) * vec2(aspect, -1.0) * 4.2 * scale
    let ro = vec3(0.0, 0.0, 7.0)
    let rd = normalize(vec3(xy, -7.0))
    // A black room, with light falling onto a ground plane under the suspended solid.
    let floor_uv = (uv - vec2(0.5, center.y + 0.22 / scale)) * vec2(aspect, 4.8)
    let pool = exp(-dot(floor_uv, floor_uv) * 8.0)
    let shadow = exp(-dot(floor_uv * vec2(1.8, 1.0), floor_uv * vec2(1.8, 1.0)) * 26.0)
    var color = vec3(0.005, 0.008, 0.011) * field.library +
        vec3(0.032, 0.052, 0.061) * pool * (1.0 - shadow * 0.78)
    var distance = 4.8
    var hit = false
    // Reject the empty room cheaply; the march is bounded even during the morph.
    if abs(xy.x) < mix(1.75, 3.3, field.morph) && abs(xy.y) < 1.5 {
        for _ in 0..88 {
            let p = ro + rd * distance
            let d = solid(p, field, letters, linear)
            if d < 0.0018 {
                hit = true
                break
            }
            distance += max(d * 0.8, 0.001)
            if distance > 9.0 { break }
        }
    }
    if hit {
        let p = ro + rd * distance
        let n = normal(p, field, letters, linear)
        let view = -rd
        let key = normalize(
            vec3(-3.0 + 6.0 * smoothstep(3.6, 5.0, field.time) * field.morph, 3.0, 5.0) - p,
        )
        let rim = normalize(vec3(0.9, 0.25, -0.6))
        let warm = normalize(vec3(-1.0, -0.4, 0.1))
        let diffuse = max(dot(n, key), 0.0)
        let fresnel = pow(1.0 - max(dot(n, view), 0.0), 3.0)
        let spec = pow(max(dot(n, normalize(key + view)), 0.0), 80.0)
        let strip = pow(max(dot(n, normalize(rim + view)), 0.0), 26.0)
        let edge = pow(max(dot(n, rim), 0.0), 3.0)
        let gold = pow(max(dot(n, warm), 0.0), 4.0)
        let grain = 0.985 + 0.015 * sin(p.y * 260.0 + p.x * 35.0)
        let broad = pow(max(dot(n, normalize(key + view)), 0.0), 16.0)
        color = mix(vec3(0.10, 0.16, 0.18), vec3(0.32, 0.43, 0.47), field.morph) *
            (0.1 + diffuse * 0.6) *
            grain +
            vec3(0.52, 0.66, 0.72) * broad * 0.46 +
            vec3(0.75, 0.89, 0.94) * spec * 1.65 +
            vec3(0.27, 0.62, 0.69) * (strip * 1.0 + edge * 0.45) +
            vec3(0.65, 0.45, 0.30) * gold * 0.6 +
            vec3(0.28, 0.43, 0.48) * fresnel * 0.55
        color = color / (vec3(1.0) + color)
        color = pow(color, vec3(0.78))
    }
    // The solid fades to black before a different, quieter instance lights the library.
    let exposure = mix(field.light, smoothstep(0.0, 1.0, field.library) * 0.65, field.library)
    vec4(color * exposure, 1.0)
}

@fragment
pub fn image(v: Vertex, content: Texture<Rgba8>, linear: Sampler, size: vec2, alpha: f32) -> Over {
    let p = abs((v.uv - vec2(0.5)) * size) - size * 0.5 + vec2(12.0)
    let d = length(max(p, vec2(0.0))) + min(max(p.x, p.y), 0.0) - 12.0
    let c = content.sample_level(linear, v.uv, 0.0)
    let shade = 1.0 - smoothstep(0.2, 1.0, v.uv.y) * 0.16
    Over { color: vec4(c.xyz * shade, c.w * saturate(0.5 - d) * alpha) }
}

@test
fn the_opening_has_black_bookends_and_a_resolved_word_before_the_library() {
    let start = moment(0.0, opening: true)
    assert(start.light == 0.0 && start.morph == 0.0 && start.library == 0.0)
    let solid = moment(2.0, opening: true)
    assert(solid.light == 1.0 && solid.morph == 0.0)
    let word = moment(4.8, opening: true)
    assert(word.morph == 1.0 && word.light == 1.0 && word.library == 0.0)
    let black = moment(5.7, opening: true)
    assert(black.light == 0.0 && black.library == 0.0)
    assert(moment(6.6, opening: true).library == 1.0)
    assert(moment(0.0, opening: false).library == 1.0)
}
