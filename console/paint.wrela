// The console's GPU work: the void around the traced artifact, the games' blocks in
// perspective, and the flat mark.
use room::{Camera, Card, corner, project, turned}
use std::gpu::{ClipPosition, FragCoord, Over, Rgba8, Rgba16Float, Sampler, Texture, VertexIndex}
use facet::{CAP, MarkRun, mark_distance}

pub struct Vertex {
    pub position: ClipPosition,
    pub uv: vec2,
    pub pixel: vec2,
}

@vertex
pub fn quad(v: VertexIndex, screen: vec2, rect: vec4) -> Vertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    let uv = corners[v.index]
    let p = rect.xy + rect.zw * uv
    Vertex {
        position: ClipPosition {
            position: vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0),
        },
        uv,
        pixel: p,
    }
}

fn tone(x: vec3) -> vec3 {
    saturate((x * (x * 2.51 + vec3(0.03))) / (x * (x * 2.43 + vec3(0.59)) + vec3(0.14)))
}

// How much of the room shows: the opening's light.
pub struct Stage: Copy + GpuData {
    pub reveal: f32,
}

// Everything behind the cards: the artifact turning in the void.
@fragment
pub fn stage(
    v: Vertex,
    room: Texture<Rgba16Float>,
    linear: Sampler,
    camera: Camera,
    look: Stage,
) -> vec4 {
    let seen = room.sample_level(linear, v.pixel / camera.screen.xy, 0.0)
    vec4(tone(seen.xyz * 1.6) * look.reveal, 1.0)
}

pub struct BlockVertex {
    pub position: ClipPosition,
    // Across its face from 0 to 1 (v down), and the face's width and height (world units).
    pub uv: vec2,
    pub extent: vec2,
    // The face: 0 to 3 the sides, from the front round to the right; 4 the top, 5 the bottom.
    pub face: f32,
    pub normal: vec3,
    // Which of its sides (u = 0 and 1, v = 0 and 1) are on the block's outline: 1 where the
    // face beyond is turned away.
    pub outline: vec4,
}

// A block's 36 corners: two triangles a face. A face turned away from the eye collapses, so
// the faces drawn never overlap: a block is convex.
@vertex
pub fn block_corner(v: VertexIndex, camera: Camera, card: Card) -> BlockVertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    // Each face's outward normal, the way across it and the way up it.
    let normals = [
        vec3(0.0, 0.0, 1.0),
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 0.0, -1.0),
        vec3(-1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, -1.0, 0.0),
    ]
    let acrosses = [
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 0.0, -1.0),
        vec3(-1.0, 0.0, 0.0),
        vec3(0.0, 0.0, 1.0),
        vec3(1.0, 0.0, 0.0),
        vec3(1.0, 0.0, 0.0),
    ]
    let ups = [
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, -1.0),
        vec3(0.0, 0.0, 1.0),
    ]
    let face = v.index / 6
    let uv = corners[v.index % 6]
    let (n, across, up) = (normals[face], acrosses[face], ups[face])
    let normal = turned(card, n)
    let eye = camera.eye.xyz
    let facing = dot(normal, eye - corner(card, n * 0.5)) > 0.0
    // A side is on the outline where the face beyond it is turned away from the eye.
    var outline = vec4(0.0)
    let beyond = [-across, across, up, -up]
    for k in 0..4 {
        let m = beyond[k]
        if dot(turned(card, m), eye - corner(card, m * 0.5)) <= 0.0 { outline[k] = 1.0 }
    }
    let s = project(camera, corner(card, n * 0.5 + across * (uv.x - 0.5) + up * (0.5 - uv.y)))
    let ndc = vec2(s.x / camera.screen.x * 2.0 - 1.0, 1.0 - s.y / camera.screen.y * 2.0)
    // Clip w is the depth, so the art is interpolated in perspective.
    let position = if facing { vec4(ndc * s.z, 0.5, s.z) } else { vec4(2.0, 2.0, 2.0, 1.0) }
    BlockVertex {
        position: ClipPosition { position },
        uv,
        extent: vec2(length(across * card.size.xyz), length(up * card.size.xyz)),
        face: f32(face),
        normal,
        outline,
    }
}

// A game's block: its cover on its sides, the middle of it as wide as each face allows, so the
// chosen block's front shows all of it; the top and bottom dark. Lit from above and in front,
// with a silver line a pixel wide along each edge, as the artifact's struts, brighter under
// the pointer, and its outline smoothed over the pixel it crosses.
@fragment
pub fn block_face(
    v: BlockVertex,
    art: Texture<Rgba8>,
    linear: Sampler,
    card: Card,
    has_art: f32,
) -> Over {
    let face = u32(v.face + 0.5)
    let shown = min(v.extent.x / v.extent.y * 0.5625, 1.0)
    let sampled = art.sample_level(linear, vec2(0.5 + (v.uv.x - 0.5) * shown, v.uv.y), 0.0).xyz
    let cover = mix(vec3(0.11, 0.11, 0.12), sampled, has_art)
    let surface = if face < 4 { cover } else { vec3(0.05, 0.05, 0.055) }
    let light = normalize(vec3(-0.35, 0.6, 0.75))
    var shade = 0.45 + 0.55 * saturate(dot(normalize(v.normal), light))
    // The chosen block's front (its back, after its half turn) shows its cover as it is.
    if face == 0 || face == 2 { shade = mix(shade, 1.0, card.look.w) }
    // Each side's distance in pixels, across and up the face.
    let across = v.uv.x * v.extent.x
    let up = v.uv.y * v.extent.y
    let pa = max(fwidth(across), 0.00001)
    let pu = max(fwidth(up), 0.00001)
    let sides = vec4(across / pa, (v.extent.x - across) / pa, up / pu, (v.extent.y - up) / pu)
    let nearest = min(min(sides.x, sides.y), min(sides.z, sides.w))
    // The line fills the pixel along the edge and stops: one pixel, sharp.
    let line = saturate(1.5 - nearest) * mix(0.6, 1.0, card.look.y)
    let silver = mix(vec3(0.78, 0.79, 0.82), vec3(1.0), card.look.y)
    let color = mix(surface * shade * card.look.x, silver, line)
    var cover = 1.0
    for k in 0..4 { if v.outline[k] > 0.5 { cover *= saturate(sides[k] + 0.5) } }
    Over { color: vec4(color, card.look.z * cover) }
}

// The light the selection stands in: an ellipse on the floor beneath it, in its cover's colour.
pub struct Pool: Copy + GpuData {
    // Its centre and its radii, in pixels; its colour and how strong it is.
    pub ellipse: vec4,
    pub color: vec4,
}

@fragment
pub fn pool(v: Vertex, look: Pool) -> Over {
    let d = length((v.pixel - look.ellipse.xy) / look.ellipse.zw)
    let light = exp(-d * d * 2.5) * look.color.w
    Over { color: vec4(look.color.xyz, light) }
}

pub struct Emblem: Copy + GpuData {
    // The mark's centre in pixels, and pixels per em.
    pub centre: vec2,
    pub ems: f32,
    pub alpha: f32,
    pub count: u32,
    // The light passing along it: 0 before the mark, 1 once it has crossed.
    pub reveal: f32,
    pub width: f32,
}

// The flat mark. As the light passes, each part of it comes up softly behind a broad glint.
@fragment
pub fn emblem(v: Vertex, runs: [MarkRun], look: Emblem) -> Over {
    let p = vec2(v.pixel.x - look.centre.x, look.centre.y - v.pixel.y) / look.ems +
        vec2(0.0, CAP * 0.5)
    var d = 100.0
    for i in 0..look.count { d = min(d, mark_distance(p, runs[i])) }
    let coverage = saturate(0.5 - d * look.ems)
    let across = p.x / look.width + 0.5
    let front = look.reveal * 1.45 - 0.15
    let shown = saturate((front - across) / 0.25)
    // Squared by hand: WGSL leaves `pow` undefined for a negative base, which blacked out the
    // letters the light had passed.
    let off = (across - front) * 9.0
    let edge = exp(-off * off)
    let color = mix(vec3(0.9, 0.91, 0.92), vec3(1.0), edge)
    Over { color: vec4(color, coverage * max(shown, edge) * look.alpha) }
}
