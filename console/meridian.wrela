fn path_distance(p: vec2, path: Path) -> f32 {
    var distance = 100.0
    let n = path.points.len()
    let open = length(path.points[0] - path.points[n - 1]) > 0.001
    for i in 0..n - 1 {
        let a = path.points[i]
        let b = path.points[i + 1]
        let v = b - a
        let t = saturate(dot(p - a, v) / max(dot(v, v), 0.00000001))
        var segment = length(p - mix(a, b, t)) - WEIGHT
        // Clip each terminal before the union: a bar ending at a stem must not cut it.
        if open && i == 0 { segment = max(segment, -dot(p - a, normalize(v))) }
        if open && i + 2 == n { segment = max(segment, dot(p - b, normalize(v))) }
        distance = min(distance, segment)
    }
    distance
}

// No font file or runtime outline processing: the compiler bakes the original drawings.
pub fn bake() -> Baked {
    let em = 64.0
    let spread = 5.0
    var glyphs: Vec<BakedGlyph> = Vec::new()
    var fields: Vec<u8> = Vec::new()
    for cp in 32..127 {
        let l = letter(cp)
        var lo = vec2(100.0)
        var hi = vec2(-100.0)
        for path in l.paths {
            for p in path.points {
                lo = min(lo, p)
                hi = max(hi, p)
            }
        }
        let empty = l.paths.is_empty()
        let left = if empty { 0.0 } else { floor((lo.x - WEIGHT) * em - spread) }
        let top = if empty { 0.0 } else { ceil((hi.y + WEIGHT) * em + spread) }
        let width = if empty { 0 } else { u32(ceil((hi.x + WEIGHT) * em + spread) - left) }
        let height = if empty { 0 } else { u32(top - floor((lo.y - WEIGHT) * em - spread)) }
        glyphs.push(
            BakedGlyph {
                codepoint: cp,
                advance: l.advance,
                left,
                top,
                width,
                height,
                offset: fields.len(),
            },
        )
        for y in 0..height {
            for x in 0..width {
                let p = vec2(left + f32(x) + 0.5, top - f32(y) - 0.5) / em
                var distance = 100.0
                for path in l.paths { distance = min(distance, path_distance(p, path)) }
                fields.push(u8(round(saturate(0.5 - distance * em / (2.0 * spread)) * 255.0)))
            }
        }
    }
    Baked {
        em,
        spread,
        ascender: 0.83,
        descender: -0.28,
        line_gap: 0.12,
        glyphs,
        kerning: Vec::new(),
        fields,
    }
}

@test
fn meridian_has_distinct_printable_ascii_and_bounded_fields() {
    borrow font = FONT
    assert(font.glyphs.len() == 95)
    var end = 0
    for i in 0..95 {
        let g = font.glyphs[i]
        assert(g.codepoint == i + 32 && g.advance > 0.0 && g.advance < 1.2)
        assert(g.offset == end)
        end += g.width * g.height
        assert(end <= font.fields.len())
        if i == 0 { assert(g.width == 0 && g.height == 0) } else {
            var ink = 0
            for k in g.offset..end { if font.fields[k] > 127 { ink += 1 } }
            assert(ink > 0, "every visible ASCII character has ink")
        }
    }
    assert(end == font.fields.len())
    assert(letter(87).advance > letter(77).advance)
    assert(letter(105).advance < letter(110).advance)
    // Lowercase has its own x-height, not scaled capitals.
    assert(letter(97).paths[0].points[0].y < letter(65).paths[0].points[1].y)
}

@test
fn a_cut_terminal_preserves_the_stroke_it_meets() {
    let e = letter(101)
    assert(path_distance(vec2(0.045, 0.27), e.paths[0]) < 0.0)
    let l = letter(108)
    assert(path_distance(vec2(0.24, 0.0), l.paths[0]) > 0.0)
    assert(path_distance(vec2(0.20, 0.0), l.paths[0]) < 0.0)
}
