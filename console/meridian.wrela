// Wrela Meridian: original centreline drawings, in ems, with a 0.052-em stroke.
// These paths supply both the display face and the opening's transforming metal vanes.
// Designed for Wrela; no external font outlines or raster assets are used here.
use ui::ttf::{Baked, BakedGlyph}

pub const WEIGHT: f32 = 0.026

@fuel(2 ** 38)
pub const FONT: Baked = bake()

pub struct Path: Clone {
    pub points: Vec<vec2>,
}

pub struct Letter: Clone {
    pub advance: f32,
    pub paths: Vec<Path>,
}

// Rounded corners retain long straight stems and flat terminals. The design points are
// hundredths of an em; small chamfers soften the cuts without rounding the whole face.
fn rail(points: [vec2]) -> Path {
    var out: Vec<vec2> = Vec::new()
    out.push(points[0] * 0.01 + vec2(0.055, 0.0))
    for i in 1..points.len() - 1 {
        let a = points[i - 1]
        let b = points[i]
        let c = points[i + 1]
        let radius = min(5.5, min(length(b - a), length(c - b)) * 0.3)
        let start = b + normalize(a - b) * radius
        let end = b + normalize(c - b) * radius
        out.push(start * 0.01 + vec2(0.055, 0.0))
        for j in 1..9 {
            let t = f32(j) / 8.0
            let p = mix(mix(start, b, t), mix(b, end, t), t)
            out.push(p * 0.01 + vec2(0.055, 0.0))
        }
    }
    out.push(points[points.len() - 1] * 0.01 + vec2(0.055, 0.0))
    Path { points: out }
}

pub fn letter(codepoint: u32) -> Letter {
    var paths: Vec<Path> = Vec::new()
    let advance = match codepoint {
        32 => { //
            0.32
        },
        33 => { // !
            paths.push(rail([vec2(5.0, 72.0), vec2(5.0, 23.0)]))
            paths.push(rail([vec2(5.0, 0.0), vec2(5.0, 5.0)]))
            0.26
        },
        34 => { // "
            paths.push(rail([vec2(0.0, 72.0), vec2(0.0, 55.0)]))
            paths.push(rail([vec2(20.0, 72.0), vec2(20.0, 55.0)]))
