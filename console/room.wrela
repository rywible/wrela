// The library's room: an endless dark. Each game is a cube in one row along the bottom of the
// screen, standing still, its cover on its sides. The selection, always at the left, tumbles
// forward to face the eye and widens into its whole cover; the one it leaves tumbles back into
// a cube and away. The artifact, a four-dimensional cube, turns far behind them, up in the
// middle. The CPU and the
// GPU place and project everything with the same code, so what is drawn is exactly what the
// pointer can hit.

// The camera: where it stands and looks, and the tangent of half its vertical view.
pub struct Camera: Copy + GpuData {
    pub eye: vec4,
    pub target: vec4,
    // The screen's size in pixels, and the lens.
    pub screen: vec4,
}

// A game's block in the room: its centre and its turn about the vertical (radians); its width,
// height and depth, and its tumble about the horizontal (radians); and its look.
pub struct Card: Copy + GpuData {
    pub centre: vec4,
    pub size: vec4,
    // Brightness, focus (0 to 1), opacity, and how chosen it is: 0 a cube, 1 the whole cover.
    pub look: vec4,
}

// Covers are 16:9. A block at rest is a cube as high as the selection, turned this far
// (radians) to show its depth; the next stands this far from it (in cube edges).
const ASPECT: f32 = 0.5625
const GAP: f32 = 0.6
const REST: f32 = 0.6
// How high (in cube edges) the chosen block hops as it tumbles, and how far it tips toward
// the eye at the top of the hop (radians).
const HOP: f32 = 0.15
const TIP: f32 = 0.35
// The left safe margin and the row's lower edge, as fractions of the screen.
pub const MARGIN: f32 = 0.055
const BASELINE: f32 = 0.88
// The artifact floats this deep, far behind the cards.
const ARTIFACT_DEPTH: f32 = -20.0

// The row fitted to a screen (world units on the cards' plane): the selected card's left
// edge, the row's middle, the selected card's width and the gap between cards.
pub struct Row: Copy {
    pub left: f32,
    pub middle: f32,
    pub width: f32,
    pub gap: f32,
}

pub fn camera(screen: vec2, sway: vec2) -> Camera {
    let aspect = screen.x / screen.y
    // Narrow screens step back so the selected card still fits.
    let back = max(0.0, (1.5 - aspect) * 2.4)
    Camera {
        eye: vec4(sway.x * 0.22, 1.75 - sway.y * 0.1, 6.4 + back, 0.0),
        target: vec4(sway.x * 0.06, 1.45, 0.0, 0.0),
        screen: vec4(screen, 0.36, 0.0),
    }
}

pub fn basis(c: Camera) -> (vec3, vec3, vec3) {
    let forward = normalize(c.target.xyz - c.eye.xyz)
    let side = normalize(cross(forward, vec3(0.0, 1.0, 0.0)))
    (forward, side, cross(side, forward))
}

// A world point on the screen: pixels from the top left, and its distance along the view.
pub fn project(c: Camera, p: vec3) -> vec3 {
    let (forward, side, up) = basis(c)
    let d = p - c.eye.xyz
    let depth = max(dot(d, forward), 0.001)
    let aspect = c.screen.x / c.screen.y
    let ndc = vec2(dot(d, side) / (depth * c.screen.z * aspect), dot(d, up) / (depth * c.screen.z))
    vec3((ndc.x * 0.5 + 0.5) * c.screen.x, (0.5 - ndc.y * 0.5) * c.screen.y, depth)
}

// The ray through a pixel.
pub fn ray(c: Camera, pixel: vec2) -> vec3 {
    let (forward, side, up) = basis(c)
    let ndc = vec2(pixel.x / c.screen.x * 2.0 - 1.0, 1.0 - pixel.y / c.screen.y * 2.0)
    let aspect = c.screen.x / c.screen.y
    normalize(forward + (side * ndc.x * aspect + up * ndc.y) * c.screen.z)
}

// The world point at `at` (fractions of the screen) on the plane `z` deep.
pub fn on_plane(c: Camera, at: vec2, z: f32) -> vec3 {
    let rd = ray(c, at * c.screen.xy)
    c.eye.xyz + rd * ((z - c.eye.z) / rd.z)
}

// The row for a camera at rest: the selection about a fifth of the screen high (less on a
// narrow screen, where it may take at most 62% of the width), at the left margin, its lower
// edge at the baseline.
pub fn row(c: Camera) -> Row {
    let aspect = c.screen.x / c.screen.y
    let wide = min(0.2 / ASPECT / aspect, 0.62)
    let low = on_plane(c, vec2(MARGIN, BASELINE), 0.0)
    let width = on_plane(c, vec2(MARGIN + wide, BASELINE), 0.0).x - low.x
    Row { left: low.x, middle: low.y + width * ASPECT * 0.5, width, gap: width * 0.07 }
}

// The artifact's centre and size for a camera at rest: up in the middle of the screen, about
// three tenths of its height across.
pub fn artifact_spot(c: Camera) -> vec4 {
    let aspect = c.screen.x / c.screen.y
    let at = vec2(0.5, 0.35)
    let centre = on_plane(c, at, ARTIFACT_DEPTH)
    let tall = on_plane(c, at + vec2(0.0, 0.145), ARTIFACT_DEPTH).y - centre.y
    vec4(centre, abs(tall) * min(aspect, 1.0))
}

// `v` in a block's frame turned as the block is: tipped about the horizontal, then turned
// about the vertical.
pub fn turned(card: Card, v: vec3) -> vec3 {
    let (tip, turn) = (card.size.w, card.centre.w)
    let t = vec3(v.x, v.y * cos(tip) - v.z * sin(tip), v.y * sin(tip) + v.z * cos(tip))
    vec3(t.x * cos(turn) + t.z * sin(turn), t.y, t.z * cos(turn) - t.x * sin(turn))
}

// A point of a block (each coordinate from -0.5 to 0.5 across it) in the world.
pub fn corner(card: Card, at: vec3) -> vec3 {
    card.centre.xyz + turned(card, at * card.size.xyz)
}

// How chosen block `index` is while the row is at `album` (its eased selection): 1 for the
// selection, falling to 0 a block away.
fn chosen(index: u32, album: f32) -> f32 {
    saturate(1.0 - abs(f32(index) - album))
}

// How far the left edge of block `index` is from the first's, the row at `album`.
fn reach(index: u32, album: f32, edge: f32) -> f32 {
    var x = 0.0
    for j in 0..index { x += edge * mix(1.0, 1.0 / ASPECT, chosen(j, album)) + edge * GAP }
    x
}

// Block `index` while the row is at `album` (its eased selection). The selection's front stands
// on the cards' plane at the left margin; the rest stand after it, a gap apart, and those
// before it slide off to the left and fade.
pub fn place(index: u32, album: f32, ring: f32, has_art: bool, row: Row) -> Card {
    let edge = row.width * ASPECT
    let c = chosen(index, album)
    let eased = smoothstep(0.0, 1.0, c)
    let below = u32(floor(max(album, 0.0)))
    let selection = mix(
        reach(below, album, edge),
        reach(below + 1, album, edge),
        album - f32(below),
    )
    let width = edge * mix(1.0, 1.0 / ASPECT, c)
    let x = row.left - selection + reach(index, album, edge) + width * 0.5
    // Becoming the selection, a cube hops, tips toward the eye and makes a half turn, from its
    // resting angle round to show its other face square to the eye.
    let hop = sin(c * 3.1415927)
    let shown = saturate((x + width * 0.5 - (row.left - edge * 0.25)) / (edge * 0.75))
    let lit = mix(0.42, 1.0, eased) * if has_art { 1.0 } else { 0.9 }
    Card {
        centre: vec4(x, row.middle + hop * HOP * edge, -edge * 0.5, mix(REST, -3.1415927, eased)),
        size: vec4(width, edge, edge, -hop * TIP),
        look: vec4(lit, ring, shown, c),
    }
}

// The screen rectangle that holds a block: what the pointer hits.
pub fn bounds(c: Camera, card: Card) -> vec4 {
    var lo = vec2(1.0e9)
    var hi = vec2(-1.0e9)
    for x in [-0.5, 0.5] {
        for y in [-0.5, 0.5] {
            for z in [-0.5, 0.5] {
                let s = project(c, corner(card, vec3(x, y, z))).xy
                lo = min(lo, s)
                hi = max(hi, s)
            }
        }
    }
    vec4(lo, hi - lo)
}

@test
fn projection_and_rays_agree() {
    let c = camera(vec2(1280.0, 720.0), vec2(0.3, -0.2))
    for p in [vec3(0.0, 1.0, 0.0), vec3(-2.0, 0.4, -1.5), vec3(1.7, 2.0, 0.6)] {
        let s = project(c, p)
        let d = ray(c, s.xy)
        assert(length(normalize(p - c.eye.xyz) - d) < 0.0005)
    }
}

@test
fn the_selection_faces_the_eye_at_the_margin_and_the_rest_are_cubes_beside_it() {
    for size in [
        vec2(1280.0, 720.0),
        vec2(1440.0, 900.0),
        vec2(390.0, 844.0),
        vec2(2560.0, 1080.0),
    ] {
        let c = camera(size, vec2(0.0))
        let r = row(c)
        let at = |i: u32, album: f32| place(i, album, ring: 0.0, has_art: true, row: r)
        for selected in [0, 1, 3] {
            // The chosen: square to the eye, its whole cover, at the margin on the baseline.
            let first = at(selected, f32(selected))
            assert(abs(sin(first.centre.w)) < 0.00001 && abs(first.size.w) < 0.00001)
            assert(first.look.w == 1.0 && abs(first.size.x * ASPECT - first.size.y) < 0.0001)
            let chosen = bounds(c, first)
            assert(abs(chosen.x - size.x * MARGIN) < size.x * 0.01, "at the margin")
            assert(abs(chosen.y + chosen.w - size.y * BASELINE) < size.y * 0.01, "on the baseline")
            assert(chosen.x + chosen.z < size.x * 0.7, "leaving room for the rest of the row")
            // The next: a still, turned cube a gap to the right; whole on a wide screen.
            let next = at(selected + 1, f32(selected))
            assert(
                next.size.x == next.size.y && next.size.y == next.size.z && next.centre.w == REST,
            )
            let b = bounds(c, next)
            assert(b.x > chosen.x + chosen.z && b.x < size.x)
            assert(size.x < size.y || b.x + b.z < size.x)
            assert(next.look.x < first.look.x, "dimmer than the selection")
            // The one before has slid off to the left, faded.
            if selected > 0 { assert(at(selected - 1, f32(selected)).look.z == 0.0) }
        }
        // Mid-move, the block hops and tips, between its two places.
        let moving = at(1, 0.5)
        let still = at(1, 0.0)
        assert(moving.centre.y > still.centre.y && moving.size.w < 0.0)
        let m = bounds(c, moving)
        assert(m.x > size.x * MARGIN * 0.5 && m.x < bounds(c, still).x)
    }
}

@test
fn a_block_keeps_its_size_as_it_turns_and_tips() {
    let r = row(camera(vec2(1280.0, 720.0), vec2(0.0)))
    let m = place(1, 0.5, ring: 0.0, has_art: true, row: r)
    let span = corner(m, vec3(0.5, 0.5, 0.5)) - corner(m, vec3(-0.5, -0.5, -0.5))
    assert(abs(length(span) - length(m.size.xyz)) < 0.0001)
}

@test
fn the_artifact_floats_behind_the_row_and_on_screen() {
    for size in [vec2(1280.0, 720.0), vec2(390.0, 844.0), vec2(2560.0, 1080.0)] {
        let c = camera(size, vec2(0.0))
        let spot = artifact_spot(c)
        let at = project(c, spot.xyz)
        assert(at.x > size.x * 0.45 && at.x < size.x * 0.8 && at.y < size.y * 0.4)
        assert(spot.z < -5.0 && spot.w > 0.3)
    }
}
