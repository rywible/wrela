// The library's room: an endless dark. Albums stand as cards in one row along the bottom of
// the screen, as in an album picker: the selection flat and full size at the left margin,
// the albums after it turned toward it and overlapping off to the right, and those before it
// turned the other way at the left edge. The artifact turns far behind them, up in the
// middle. The CPU and the GPU place and project everything with the same code, so what is
// drawn is exactly what the pointer can hit.

// The camera: where it stands and looks, and the tangent of half its vertical view.
pub struct Camera: Copy + GpuData {
    pub eye: vec4,
    pub target: vec4,
    // The screen's size in pixels, and the lens.
    pub screen: vec4,
}

// A card in the room: its centre and its turn about the vertical, its width and height, and
// how it is lit.
pub struct Card: Copy + GpuData {
    pub centre: vec4,
    // Width, height, corner radius (world units) and the ring's distance from the edge.
    pub size: vec4,
    // Brightness, ring (0 to 1) and opacity.
    pub look: vec4,
}

// Cards are 16:9; the others stand at this size beside the selection, turned this far
// toward it (radians), set back this far (in selected widths), and each a further one steps
// out by this share of its width as seen from the front, and back a little more.
const ASPECT: f32 = 0.5625
const SMALL: f32 = 0.78
const TURN: f32 = 0.8
const BACK: f32 = 0.3
const STEP: f32 = 0.5
// The left safe margin and the row's lower edge, as fractions of the screen.
pub const MARGIN: f32 = 0.055
const BASELINE: f32 = 0.88
// The artifact floats this deep, far behind the cards.
const ARTIFACT_DEPTH: f32 = -10.0

// The row fitted to a screen (world units on the cards' plane): the selected card's left
// edge, the row's middle, the selected card's width and the gap between cards.
pub struct Row: Copy {
    pub left: f32,
    pub middle: f32,
    pub width: f32,
    pub gap: f32,
}

pub fn camera(screen: vec2, sway: vec2) -> Camera {
    let aspect = screen.x / screen.y
    // Narrow screens step back so the selected card still fits.
    let back = max(0.0, (1.5 - aspect) * 2.4)
    Camera {
        eye: vec4(sway.x * 0.22, 1.75 - sway.y * 0.1, 6.4 + back, 0.0),
        target: vec4(sway.x * 0.06, 1.45, 0.0, 0.0),
        screen: vec4(screen, 0.36, 0.0),
    }
}

pub fn basis(c: Camera) -> (vec3, vec3, vec3) {
    let forward = normalize(c.target.xyz - c.eye.xyz)
    let side = normalize(cross(forward, vec3(0.0, 1.0, 0.0)))
    (forward, side, cross(side, forward))
}

// A world point on the screen: pixels from the top left, and its distance along the view.
pub fn project(c: Camera, p: vec3) -> vec3 {
    let (forward, side, up) = basis(c)
    let d = p - c.eye.xyz
    let depth = max(dot(d, forward), 0.001)
    let aspect = c.screen.x / c.screen.y
    let ndc = vec2(dot(d, side) / (depth * c.screen.z * aspect), dot(d, up) / (depth * c.screen.z))
    vec3((ndc.x * 0.5 + 0.5) * c.screen.x, (0.5 - ndc.y * 0.5) * c.screen.y, depth)
}

// The ray through a pixel.
pub fn ray(c: Camera, pixel: vec2) -> vec3 {
    let (forward, side, up) = basis(c)
    let ndc = vec2(pixel.x / c.screen.x * 2.0 - 1.0, 1.0 - pixel.y / c.screen.y * 2.0)
    let aspect = c.screen.x / c.screen.y
    normalize(forward + (side * ndc.x * aspect + up * ndc.y) * c.screen.z)
}

// The world point at `at` (fractions of the screen) on the plane `z` deep.
pub fn on_plane(c: Camera, at: vec2, z: f32) -> vec3 {
    let rd = ray(c, at * c.screen.xy)
    c.eye.xyz + rd * ((z - c.eye.z) / rd.z)
}

// The row for a camera at rest: the selection about a fifth of the screen high (less on a
// narrow screen, where it may take at most 62% of the width), at the left margin, its lower
// edge at the baseline.
pub fn row(c: Camera) -> Row {
    let aspect = c.screen.x / c.screen.y
    let wide = min(0.2 / ASPECT / aspect, 0.62)
    let low = on_plane(c, vec2(MARGIN, BASELINE), 0.0)
    let width = on_plane(c, vec2(MARGIN + wide, BASELINE), 0.0).x - low.x
    Row { left: low.x, middle: low.y + width * ASPECT * 0.5, width, gap: width * 0.07 }
}

// The artifact's centre and size for a camera at rest: up in the middle of the screen, about
// three tenths of its height across.
pub fn artifact_spot(c: Camera) -> vec4 {
    let aspect = c.screen.x / c.screen.y
    let at = vec2(0.5, 0.31)
    let centre = on_plane(c, at, ARTIFACT_DEPTH)
    let tall = on_plane(c, at + vec2(0.0, 0.145), ARTIFACT_DEPTH).y - centre.y
    vec4(centre, abs(tall) * min(aspect, 1.0))
}

// A card's corner (u and v from 0 to 1, v down) in the world.
pub fn corner(card: Card, uv: vec2) -> vec3 {
    let local = vec2(uv.x - 0.5, 0.5 - uv.y) * card.size.xy
    let turn = card.centre.w
    card.centre.xyz + vec3(cos(turn) * local.x, local.y, -sin(turn) * local.x)
}

// Album `index` while the row is at `album` (its eased selection): the selection flat and
// full size in its slot. The rest stand smaller, dimmer, set back and turned toward it, their
// outer edges nearest: those after it overlapping off to the right, each nearer one in front;
// those before it at the left edge, the nearest peeking in and the rest fading out beyond.
pub fn place(index: u32, album: f32, ring: f32, has_art: bool, row: Row) -> Card {
    let offset = f32(index) - album
    let side = if offset < 0.0 { -1.0 } else { 1.0 }
    let reach = min(abs(offset), 1.0)
    let beyond = max(abs(offset) - 1.0, 0.0)
    let width = row.width * mix(1.0, SMALL, reach)
    // A side album's width as seen from the front.
    let across = row.width * SMALL * cos(TURN)
    let slot = row.left + row.width * 0.5
    // The nearest stand just clear of the selection's edges, their inner edges tucked a
    // little behind it.
    let first = if side > 0.0 { row.left + row.width + across * 0.3 } else {
        row.left - across * 0.3
    }
    let x = mix(slot, first, reach) + side * beyond * across * STEP
    let z = -(reach * BACK + beyond * 0.05) * row.width
    let lit = mix(1.0, 0.55, reach) * if has_art { 1.0 } else { 0.9 }
    let shown = if side < 0.0 { saturate(1.0 - beyond * 1.5) } else { 1.0 }
    Card {
        centre: vec4(x, row.middle, z, -side * reach * TURN),
        size: vec4(width, width * ASPECT, width * 0.035, row.width * 0.016),
        look: vec4(lit, ring, shown, 0.0),
    }
}

// The screen rectangle that holds a card: what the pointer hits.
pub fn bounds(c: Camera, card: Card) -> vec4 {
    var lo = vec2(1.0e9)
    var hi = vec2(-1.0e9)
    for uv in [vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0)] {
        let s = project(c, corner(card, uv)).xy
        lo = min(lo, s)
        hi = max(hi, s)
    }
    vec4(lo, hi - lo)
}

@test
fn projection_and_rays_agree() {
    let c = camera(vec2(1280.0, 720.0), vec2(0.3, -0.2))
    for p in [vec3(0.0, 1.0, 0.0), vec3(-2.0, 0.4, -1.5), vec3(1.7, 2.0, 0.6)] {
        let s = project(c, p)
        let d = ray(c, s.xy)
        assert(length(normalize(p - c.eye.xyz) - d) < 0.0005)
    }
}

@test
fn the_selection_holds_its_slot_at_the_left_margin_on_any_screen() {
    for size in [
        vec2(1280.0, 720.0),
        vec2(1440.0, 900.0),
        vec2(390.0, 844.0),
        vec2(2560.0, 1080.0),
    ] {
        let c = camera(size, vec2(0.0))
        let r = row(c)
        let chosen = bounds(c, place(2, album: 2.0, ring: 1.0, has_art: true, row: r))
        assert(abs(chosen.x - size.x * MARGIN) < size.x * 0.01, "at the margin")
        assert(abs(chosen.y + chosen.w - size.y * BASELINE) < size.y * 0.01, "on the baseline")
        assert(chosen.x + chosen.z < size.x * 0.7, "leaving room for the rest of the row")
        assert(chosen.w > size.y * 0.12 && chosen.w < size.y * 0.21)
        // The next stands a gap to the right, smaller and turned, the one after it further
        // out, behind it.
        let next = place(3, album: 2.0, ring: 0.0, has_art: true, row: r)
        let after = place(4, album: 2.0, ring: 0.0, has_art: true, row: r)
        let b = bounds(c, next)
        assert(b.x + b.z > chosen.x + chosen.z + b.z * 0.5 && b.w < chosen.w && next.centre.w < 0.0)
        assert(bounds(c, after).x > b.x && after.centre.z < next.centre.z)
        // The one before peeks in at the left edge, still to be pointed at; the one before
        // that has faded out.
        let before = place(1, album: 2.0, ring: 0.0, has_art: true, row: r)
        let a = bounds(c, before)
        assert(before.look.z == 1.0 && before.centre.w > 0.0)
        assert(a.x + a.z > size.x * 0.03 && a.x < chosen.x, "in view, left of the slot")
        assert(place(0, album: 2.0, ring: 0.0, has_art: true, row: r).look.z == 0.0)
        // Mid-move, a card is between its two slots.
        let moving = bounds(c, place(3, album: 2.5, ring: 0.0, has_art: true, row: r))
        assert(moving.x > chosen.x && moving.x < b.x)
    }
}

@test
fn the_artifact_floats_behind_the_row_and_on_screen() {
    for size in [vec2(1280.0, 720.0), vec2(390.0, 844.0), vec2(2560.0, 1080.0)] {
        let c = camera(size, vec2(0.0))
        let spot = artifact_spot(c)
        let at = project(c, spot.xyz)
        assert(at.x > size.x * 0.45 && at.x < size.x * 0.8 && at.y < size.y * 0.4)
        assert(spot.z < -5.0 && spot.w > 0.3)
    }
}
