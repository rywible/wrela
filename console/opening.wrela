// The opening. The artifact, a black and silver tesseract, comes up out of the dark close to
// the eye while a light passes slowly along the WRΞLA mark beneath it. As the light finishes,
// the tesseract slows to rest with its cells nested, a cube inside a cube. It and the mark
// hold, then go down into the dark together, and the home comes up out of it: the chosen game's
// hero, which takes the tesseract's place. The tesseract never travels, and never turns faster than its steady
// rate.
use brand::facet

pub const OPENING_SECONDS: f32 = 7.7
// The tesseract starts to slow, and is at rest as the light finishes its pass along the mark.
const SLOWING: f32 = 2.5
const REST: f32 = 3.7
// The tesseract and the mark start to go down, and have gone dark.
const FADING: f32 = 4.9
const DARK: f32 = 6.1
// A reload of the tab starts here instead: in the dark, just before the library comes up.
pub const RETURNING: f32 = DARK
// Radians of the slow rotation a second: slow, so it stays in the background.
const TURNING: f32 = 0.28
// Where the tesseract turns while the mark resolves: up and toward the eye.
const HERO = vec3(0.0, 1.95, 1.4)
const HERO_SIZE: f32 = 0.66
@fuel(2 ** 30)
pub const MARK_WIDTH: f32 = facet::mark_width()

pub struct Moment: Copy {
    // How lit the opening's tesseract and mark are: up out of the dark, then down into it.
    pub title: f32,
    // The light passing along the mark: 0 before it, 1 once it has crossed.
    pub reveal: f32,
    // The opening has gone dark, and the tesseract has its place in the room.
    pub settled: bool,
    // The home: the chosen game's hero, its title and the controls.
    pub library: f32,
}

// A presentation clock, not simulation time. Initial compilation and a late frame must not
// skip the black opening or jump over a beat. It never catches up a loading stall.
pub fn presentation_step(previous: Option<f32>, now: f32) -> f32 {
    match previous {
        Some(before) => clamp(now - before, 0.0, 1.0 / 30.0),
        None => 0.0,
    }
}

pub fn moment(time: f32, opening: bool) -> Moment {
    if !opening {
        return Moment { title: 0.0, reveal: 1.0, settled: true, library: 1.0 }
    }
    let out = smoothstep(FADING, DARK, time)
    Moment {
        title: smoothstep(0.0, 1.4, time) * (1.0 - out),
        reveal: smoothstep(0.5, REST, time),
        settled: out >= 1.0,
        library: smoothstep(DARK + 0.2, OPENING_SECONDS, time),
    }
}

// The tesseract's clock, in seconds, at presentation time `time`: its turn and the light and
// ripples on it go by it. In the opening it runs with the presentation, then only slows,
// smoothly, to stand still at 0 as the light finishes its pass, and stays there until dark.
// It never runs faster. In the room it runs on.
pub fn clock_at(time: f32, opening: bool) -> f32 {
    if !opening || time >= DARK { return time + 5.0 }
    let span = REST - SLOWING
    // How far through the slowing, and how far it has gone at a speed falling as `1 - smoothstep`.
    let k = saturate((time - SLOWING) / span)
    let slowed = min(time, SLOWING) + span * (k - k * k * k + k * k * k * k * 0.5)
    slowed - (SLOWING + span * 0.5)
}

// The tesseract's turn, in radians of its slow rotation: at rest at 0, where its cells nest.
pub fn turn_at(time: f32, opening: bool) -> f32 {
    clock_at(time, opening) * TURNING
}

// How lit the room is: the opening's tesseract, then the room's, which shows only while there's
// no game to show.
pub fn stage_light(m: Moment) -> f32 {
    if m.settled { m.library } else { m.title }
}

// The tesseract's centre and size: close to the eye in the opening, else `spot`, its place
// in the room.
pub fn artifact_place(m: Moment, spot: vec4) -> vec4 {
    if m.settled { spot } else { vec4(HERO, HERO_SIZE) }
}

// The mark's centre and pixels per em (logical pixels), under the tesseract.
pub fn mark_place(w: f32, h: f32) -> vec3 {
    let ems = min(w * 0.42, h * 0.85) / MARK_WIDTH
    vec3(w * 0.5, h * 0.74, ems)
}

@test
fn the_opening_goes_dark_between_the_mark_and_the_library() {
    let start = moment(0.0, opening: true)
    assert(start.title == 0.0 && start.reveal == 0.0 && !start.settled && start.library == 0.0)
    // The light is still on its way along the mark when the tesseract is fully up.
    let up = moment(1.4, opening: true)
    assert(up.title == 1.0 && up.reveal > 0.1 && up.reveal < 0.4)
    let held = moment(4.6, opening: true)
    assert(held.title == 1.0 && held.reveal == 1.0 && held.library == 0.0, "the mark holds")
    // The tesseract comes to rest, nested, as the light finishes and stays at rest until dark,
    // never running faster than its rate.
    assert(turn_at(REST, opening: true) == 0.0 && turn_at(DARK - 0.01, opening: true) == 0.0)
    let step = 0.01
    // Up to the dark, where the room's turn takes over.
    for i in 0..605 {
        let t = f32(i) * step
        let moved = turn_at(t + step, opening: true) - turn_at(t, opening: true)
        assert(moved >= 0.0 && moved <= TURNING * step * 1.001)
        if t < SLOWING { assert(abs(moved - TURNING * step) < 0.0001, "steady until it slows") }
    }
    assert(turn_at(9.0, opening: true) == turn_at(9.0, opening: false))
    // The whole mark and the tesseract at rest hold, fully lit, for over a second.
    for i in 0..12 {
        let m = moment(REST + f32(i) * 0.1, opening: true)
        assert(
            m.title == 1.0 && m.reveal == 1.0 && turn_at(REST + f32(i) * 0.1, opening: true) == 0.0,
        )
    }
    // The mark and the tesseract go down together; the room stays dark until they are gone.
    let going = moment(5.2, opening: true)
    assert(going.title > 0.0 && going.title < 1.0 && !going.settled && going.library == 0.0)
    for i in 0..78 {
        let m = moment(f32(i) * 0.1, opening: true)
        assert(m.title == 0.0 || m.library == 0.0, "never both at once")
        assert(!m.settled || m.title == 0.0)
    }
    let done = moment(OPENING_SECONDS, opening: true)
    assert(done.settled && done.title == 0.0 && done.library == 1.0)
    let skipped = moment(0.0, opening: false)
    assert(skipped.settled && skipped.library == 1.0 && skipped.title == 0.0)
}

@test
fn the_light_passes_along_the_mark_slowly() {
    // Over three seconds, never faster than half again its mean.
    let step = 0.05
    var fastest = 0.0
    for i in 0..100 {
        let t = f32(i) * step
        fastest = max(
            fastest,
            moment(t + step, opening: true).reveal - moment(t, opening: true).reveal,
        )
    }
    assert(fastest / step <= 1.5 / 3.0)
}

@test
fn the_tesseract_holds_its_place_and_only_its_light_changes() {
    let spot = vec4(4.0, 3.0, -10.0, 1.3)
    for i in 0..78 {
        let m = moment(f32(i) * 0.1, opening: true)
        let place = artifact_place(m, spot)
        assert(place == spot || place == vec4(HERO, HERO_SIZE), "it never travels between them")
        // It is dark at the change of place.
        if m.settled { assert(stage_light(m) == m.library) }
    }
    assert(artifact_place(moment(0.0, opening: false), spot) == spot)
    assert(stage_light(moment(0.0, opening: false)) == 1.0)
    // The mark is centred and fits a phone.
    let opening = mark_place(w: 390.0, h: 844.0)
    assert(opening.x == 195.0 && MARK_WIDTH * opening.z < 390.0 * 0.5)
}

@test
fn a_late_first_frame_or_loading_stall_cannot_skip_the_presentation() {
    assert(presentation_step(None, 3.8) == 0.0)
    assert(abs(presentation_step(Some(3.8), 3.816) - 0.016) < 0.0001)
    assert(presentation_step(Some(3.8), 8.5) <= 1.0 / 30.0)
    assert(presentation_step(Some(8.5), 3.8) == 0.0)
}
