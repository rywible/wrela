// The opening. The artifact, a black and silver tesseract, comes up out of the dark close to
// the eye while a light passes along the WRΞLA mark beneath it; then the mark fades away and
// the tesseract draws back to float far behind the library as it comes up. One object, one camera, no cut.

pub const OPENING_SECONDS: f32 = 4.6
// Where the tesseract turns while the mark resolves: up and toward the eye.
const HERO = vec3(0.0, 1.95, 1.4)
const HERO_SIZE: f32 = 0.66
@fuel(2 ** 30)
pub const MARK_WIDTH: f32 = facet::mark_width()

pub struct Moment: Copy {
    // How lit the room is.
    pub light: f32,
    // The light passing along the mark: 0 before it, 1 once it has crossed.
    pub reveal: f32,
    // The mark fading away.
    pub fade: f32,
    // The tesseract from close to the eye (0) to far behind the library (1).
    pub settle: f32,
    // The cards and controls.
    pub library: f32,
}

// A presentation clock, not simulation time. Initial compilation and a late frame must not
// skip the black opening or jump over a beat. It never catches up a loading stall.
pub fn presentation_step(previous: Option<f32>, now: f32) -> f32 {
    match previous {
        Some(before) => clamp(now - before, 0.0, 1.0 / 30.0),
        None => 0.0,
    }
}

pub fn smoother(x: f32) -> f32 {
    let t = saturate(x)
    t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

pub fn moment(time: f32, opening: bool) -> Moment {
    if !opening { return Moment { light: 1.0, reveal: 1.0, fade: 1.0, settle: 1.0, library: 1.0 } }
    Moment {
        light: smoothstep(0.0, 0.6, time),
        reveal: smoother((time - 0.1) / 1.3),
        fade: smoothstep(2.5, 3.2, time),
        settle: smoother((time - 2.7) / 1.3),
        library: smoothstep(3.2, OPENING_SECONDS, time),
    }
}

// The tesseract's centre and size as it settles from the opening to `spot`, its place in the
// room.
pub fn artifact_place(settle: f32, spot: vec4) -> vec4 {
    vec4(mix(HERO, spot.xyz, settle), mix(HERO_SIZE, spot.w, settle))
}

// The mark's centre and pixels per em (logical pixels), under the tesseract.
pub fn mark_place(w: f32, h: f32) -> vec3 {
    let ems = min(w * 0.42, h * 0.85) / MARK_WIDTH
    vec3(w * 0.5, h * 0.74, ems)
}

@test
fn the_opening_has_a_black_start_a_resolved_mark_and_a_settled_room() {
    let start = moment(0.0, opening: true)
    assert(start.light == 0.0 && start.reveal == 0.0 && start.settle == 0.0 && start.library == 0.0)
    // The tesseract comes up as the light starts along the mark; both hold once it has crossed.
    let up = moment(0.6, opening: true)
    assert(up.light == 1.0 && up.reveal > 0.2 && up.reveal < 0.8 && up.fade == 0.0)
    let held = moment(2.5, opening: true)
    assert(held.reveal == 1.0 && held.fade == 0.0 && held.settle == 0.0, "the mark holds")
    // The mark is gone before the library is fully up.
    let gone = moment(3.2, opening: true)
    assert(gone.fade == 1.0 && gone.library < 1.0)
    let done = moment(OPENING_SECONDS, opening: true)
    assert(done.settle == 1.0 && done.library == 1.0)
    let skipped = moment(0.0, opening: false)
    assert(skipped.settle == 1.0 && skipped.library == 1.0 && skipped.fade == 1.0)
}

@test
fn the_tesseract_ends_where_the_library_has_it_and_the_mark_fits() {
    let spot = vec4(4.0, 3.0, -10.0, 1.3)
    let room = artifact_place(1.0, spot)
    assert(length(room - spot) < 0.0001)
    assert(length(artifact_place(0.0, spot).xyz - HERO) < 0.0001)
    // The mark is centred and fits a phone.
    let opening = mark_place(w: 390.0, h: 844.0)
    assert(opening.x == 195.0 && MARK_WIDTH * opening.z < 390.0 * 0.5)
}

@test
fn a_late_first_frame_or_loading_stall_cannot_skip_the_presentation() {
    assert(presentation_step(None, 3.8) == 0.0)
    assert(abs(presentation_step(Some(3.8), 3.816) - 0.016) < 0.0001)
    assert(presentation_step(Some(3.8), 8.5) <= 1.0 / 30.0)
    assert(presentation_step(Some(8.5), 3.8) == 0.0)
}
