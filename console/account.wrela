// The console's account: signing in with a passkey, or making an account once the player agrees to
// the Terms and the Privacy Policy and says they're 13 or older, the knighting (knighting.wrela),
// the account's page (its recovery codes to save, whether it posts its best runs, its passkeys,
// sessions, export and deletion), what posting makes public (shown once, before the first post),
// the legal pages (legal.wrela), and what a game shown in the console asks of the boards
// (platform/link.wrela). It asks the
// console's server (platform/server.wrela) over HTTP on the console's own origin (std::http::fetch,
// wire.wrela's paths), each request answered by one reply.
//
// It keeps to itself: the console's main.wrela only gives it its events, its time, a game shown
// and closed, and a place to draw (a chip by the settings button, and its pages over everything
// while open). While a page is open it takes the input, and publishes the page as a semantic tree
// (std::semantics, `publish`): a dialog of its text, its boxes with whether each is ticked, its
// links, and its buttons with whether each can be pressed, so the keyboard and a screen reader
// work on them as a page's own controls; their presses come back as `Event::Assist`.
//
// The session is a `__Host-` cookie the browser keeps and sends: HttpOnly, so no script reads it,
// not even the console's. The console holds only the session's CSRF token, in memory, which the
// server gives with each `Welcome`. A game, on its own origin, gets neither: only a token for its
// boards (wire.wrela's `Token`).
//
// A new account's recovery codes come after its sign-up, not in it: the server gives them once,
// and the console keeps them in memory only (never in storage) until the player says they're
// saved, offering them on the account's page meanwhile (a game is told they wait,
// `Account::save_codes`, and may remind the player to come here). Gone unsaved (the console
// closed), new ones take a fresh passkey sign-in.
//
// What posting makes public (platform/posting.wrela) is shown here, on the account's page, before
// "Post my best runs" is first turned on; a game shows the same words itself before a first post,
// since the console is hidden while a game shows, and asks the console only to record the player's
// choice (`Ask::Consent`).

use knighting::{AGAIN, LENGTH}
use platform::link::{Account as Linked, Answer, Ask, ToGame, from_game}
use platform::posting
use platform::session::answer_of
use platform::wire::{
    ACCOUNTS, ADD_PASSKEY, Agreed, Me, NOT_AGREED, PUBLIC, PasskeyView, REGISTER, Reply, Request,
    SIGN_IN, SessionView, public, run_path,
}
use std::hash::sha256::sha256
use std::host
use std::host::{PasskeyUser, create_passkey, read_new_passkey, read_passkey_use, use_passkey}
use std::http::{Header, response}
use std::input::{Assist, Button, Event, Key, PadButton}
use std::io::{Pending, fetch}
use std::semantics::{Field, FieldKind, Node, Role, Sent, read_field_state}
use ui::kit
use ui::kit::{State, Variant}
use std::serialize::{LoadError, load, save}
use std::webauthn::base64url
use ui::draw::{DrawList, Rect}
use ui::text::{Face, Fonts}

/// Seconds before the server is asked again after it couldn't be reached.
const RETRY: f32 = 5.0
/// Seconds a client past the host's rate limits waits: they count a minute (studio/release's
/// `RATE_LIMITS`).
const LIMITED: f32 = 60.0
/// How long the authenticator's prompt may wait for the person (WebAuthn's recommended default).
const PROMPT_MS: u32 = 300000
/// A game's token is asked for again this long before it expires (it lasts an hour).
const TOKEN_FRESH: f32 = 3000.0

// The console's look (main.wrela's): near-white ink on near-black, quiet controls.
// The look is ui::kit's (shadcn/ui's dark theme): text, muted text, an error's words; a control's
// corners, its label's size and the body text's; a control's height and the gap between two.
const INK = kit::FG
const MUTED = kit::MUTED_FG
const WARN = kit::ERROR
const BORDER = kit::BORDER
const RADIUS: f32 = kit::RADIUS
const LABEL: f32 = 14.0
const BODY: f32 = 14.0
const CONTROL: f32 = 36.0
const GAP: f32 = 8.0
/// A dialog's padding and width, and seconds it takes to fade in.
const PAD: f32 = 24.0
const SHEET_WIDTH: f32 = 440.0
const OPEN_SECONDS: f32 = 0.2

enum Page: Copy + Eq {
    Account,
    Choose,
    Create,
    Posting,
    Recover,
    Knighting,
    Codes,
    Manage,
    Delete,
    Legal,
}

enum Act: Copy + Eq {
    Chip,
    Close,
    SignIn,
    /// Opens the page that makes an account; its boxes; and the account made.
    Create,
    Agree,
    OfAge,
    CreateAccount,
    UseCode,
    SubmitCode,
    Keep,
    Reroll,
    CodesSaved,
    SaveCodes,
    /// The codes, downloaded as a text file to keep.
    DownloadCodes,
    /// Posting: the account's setting, the first post's screen's box, and its two choices.
    BestRuns,
    PostBest,
    Post,
    NotNow,
    Manage,
    AddPasskey,
    Remove { index: u32 },
    Revoke { index: u32 },
    NewCodes,
    Export,
    Delete,
    ConfirmDelete,
    SignOut,
    Back,
    Legal { page: u32 },
}

/// What a request to the server was for, where its reply is read differently: anything else is
/// `Other`.
enum Purpose: Copy + Eq {
    Other,
    /// What the account chose of posting (`Request::Posting`): its failure is said to no one.
    Posting,
    Name,
    Token,
    Export,
    Delete,
    Game,
    Consent,
    /// A game's `Ask::Consent`, carried to the server: its answer goes back to the game.
    GameConsent,
}

/// Whether the console knows what the account chose of posting: not yet (or the last ask failed),
/// asked, or told.
enum Known: Copy + Eq {
    Unknown,
    Asking,
    Known,
}

/// A game the console shows, and the call open to it.
struct GameLink {
    surface: u32,
    id: String,
    call: Option<Pending<u8>>,
    token: Vec<u8>,
    token_at: f32,
    /// An ask carried to the server, waiting for its answer (and whether it's an upload); and one
    /// waiting for a token.
    asking: bool,
    uploading: bool,
    waiting_token: bool,
    answer: Answer,
}

pub struct Accounts {
    rp_id: String,
    online: bool,
    /// Whether the server answered the last request, and when to ask again if it didn't.
    connected: bool,
    retry_at: f32,
    /// The requests under way, what each was for, the account it was made for (`epoch`), and its ID.
    waiting: Vec<(Pending<u8>, Purpose, u32, u32)>,
    request_serial: u32 = 0,
    /// Only the foreground request owning this ID may release the account's busy controls.
    busy_request: Option<u32> = None,
    /// Counted up each time the console's account becomes another (`identify`): a reply to a
    /// request made for the one before is dropped, but a game's own asks'.
    epoch: u32,
    /// The session's CSRF token, as the server last gave it.
    csrf: Vec<u8>,
    /// A fresh session for the same account must refresh the MMO's cached CSRF token too.
    session_revision: u32 = 0,
    pub me: Me,
    passkey: Option<Pending<u8>>,
    /// The ceremony under way: what it's for, its challenge and the handle it's for, which its
    /// finish carries back.
    ceremony: u32,
    challenge: Vec<u8>,
    handle: Vec<u8>,
    pub open: bool,
    page: Page,
    focus: u32,
    message: String,
    busy: bool,
    codes: Vec<String>,
    passkeys: Vec<PasskeyView>,
    sessions: Vec<SessionView>,
    typed: String,
    export: String,
    export_file: Option<Pending<u8>>,
    controls: Vec<(Act, Rect)>,
    shown: Vec<(Act, Rect)>,
    pointer: Option<vec2>,
    knight_t: f32,
    knight_again: bool,
    voice: bool,
    legal: u32,
    scroll: f32,
    licences: Vec<Option<Pending<u8>>>,
    licence_text: Vec<String>,
    game: Option<GameLink>,
    time: f32,
    dirty: bool,
    /// Making an account: its two boxes, ticked by the player.
    agree: bool,
    of_age: bool,
    /// The page a legal page goes back to, and the control whose request is under way.
    back: Page,
    doing: Option<Act>,
    /// Posting, as the server last said: whether it's known (and when to ask again after an ask
    /// failed), whether the account has agreed to what posting makes public, and whether it posts
    /// its best runs.
    posting: Known,
    posting_at: f32,
    may_post: bool,
    post_best: bool,
    /// What posting shares, shown before "Post my best runs" is first turned on: its box.
    consent_best: bool,
    /// The page as last drawn, as a semantic tree: its nodes (the dialog first), the control each
    /// acts as (an index of `shown`), and what was sent of it to the host.
    nodes: Vec<Node>,
    node_controls: Vec<Option<u32>>,
    tree: Sent,
    told: Vec<Pending<u8>>,
    /// Where the console shows it over the MMO (`set_view`): its zoom, reduced motion, whether
    /// the host reads a semantic tree; and whether it's the MMO's (its words are the game's, not
    /// the games' boards').
    view_zoom: f32 = 1.0,
    view_reduced: bool = false,
    view_semantics: bool = false,
    in_game: bool = false,
    /// The recovery code's field in the semantic tree (its node, 0: none), which holds the focus
    /// while the code is typed: the newest revision the host said it has, the newest read, the
    /// read under way, and the code last sent (it's sent once it's whole).
    code_node: u32 = 0,
    code_heard: u32 = 0,
    code_seen: u32 = 0,
    code_read: Option<Pending<u8>> = None,
    code_sent: String = String::new(),
    code_wanted: bool = false,
    /// How each control looks: its hover eased in (by its index in `controls`), the one the
    /// pointer pressed, and whether the keyboard moved the focus last (its ring shows only then).
    hover: Vec<f32> = Vec::new(),
    pressed: Option<Act> = None,
    keyboard: bool = false,
    /// Seconds since the frame before; how far the dialog has faded in; its height as eased
    /// toward its page's.
    dt: f32 = 0.0,
    shown_t: f32 = 0.0,
    sheet_h: f32 = 0.0,
    /// Where the sheet was last drawn (logical pixels): a control clipped outside it isn't hit.
    sheet_at: Rect = Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0),
    /// The recovery codes were downloaded: saving them is the next step.
    codes_kept: bool = false,
}

/// The console's account, its passkeys for relying party `rp_id`. It asks the server whose session
/// its cookie is on the first update, if the console has a server (`online`): without one, its chip
/// opens only the health warning and the legal pages, and a game hears the boards aren't open.
pub fn new(rp_id: str, online: bool) -> Accounts {
    Accounts {
        rp_id: rp_id.to_string(),
        online,
        connected: false,
        retry_at: 0.0,
        waiting: Vec::new(),
        epoch: 0,
        csrf: Vec::new(),
        me: Me {
            signed_in: false,
            name: String::new(),
            fixed: false,
            rerolls: 0,
            must_add_passkey: false,
        },
        passkey: None,
        ceremony: 0,
        challenge: Vec::new(),
        handle: Vec::new(),
        open: false,
        page: Page::Choose,
        focus: 0,
        message: String::new(),
        busy: false,
        codes: Vec::new(),
        passkeys: Vec::new(),
        sessions: Vec::new(),
        typed: String::new(),
        export: String::new(),
        export_file: None,
        controls: Vec::new(),
        shown: Vec::new(),
        pointer: None,
        knight_t: 0.0,
        knight_again: false,
        voice: false,
        legal: 0,
        scroll: 0.0,
        licences: Vec::new(),
        licence_text: Vec::new(),
        game: None,
        time: 0.0,
        dirty: true,
        agree: false,
        of_age: false,
        back: Page::Choose,
        doing: None,
        posting: Known::Unknown,
        posting_at: 0.0,
        may_post: false,
        post_best: false,
        consent_best: false,
        nodes: Vec::new(),
        node_controls: Vec::new(),
        tree: Sent {},
        told: Vec::new(),
    }
}

// ---- the server ------------------------------------------------------------------------------

/// Sends `request`, for `purpose`: a public read (a board, a slice, a search, a run) by a public
/// `GET`, with no cookie, so the browser's cache and the edge's may answer it, and anything else by
/// `POST`.
fn request(a: mut Accounts, request: Request, purpose: Purpose) {
    let id = request_started(mut a, request, purpose)
    let asked = if let Request::Watch { run } = request {
        // A run's replay at its own path, which never changes: kept a day.
        std::http::fetch_public(run_path(run).as_str(), [])
    } else if public(request) {
        let q = base64url(save(request))
        std::http::fetch_public(String::from(f"{PUBLIC}?q={q}").as_str(), [])
    } else {
        let kind = Header {
            name: String::from("content-type"),
            value: String::from("application/octet-stream"),
        }
        std::http::fetch("POST", ACCOUNTS, [take kind], save(request))
    }
    a.waiting.push((take asked, purpose, a.epoch, id))
}

/// Records which request owns a foreground action. Background reads and game requests may
/// finish during a passkey prompt or while a name is being saved, without ending that action.
fn request_started(a: mut Accounts, request: Request, purpose: Purpose) -> u32 {
    a.request_serial += 1
    let id = a.request_serial
    let foreground = match request {
        Request::Begin { .. } | Request::Register { .. } | Request::SignIn { .. } => true,
        Request::AddPasskey { .. } | Request::Recover { .. } | Request::Keep { .. } => true,
        Request::Reroll { .. } | Request::BestRuns { .. } | Request::NewCodes { .. } => true,
        Request::Delete { .. } => true,
        Request::Consent { .. } => purpose == Purpose::Consent,
        _ => false,
    }
    if foreground {
        a.busy_request = Some(id)
        a.busy = true
    }
    id
}

/// The request finished, including a failed or stale reply. A passkey challenge may immediately
/// put the action back under way, and its eventual submission takes a new request ID.
fn request_finished(a: mut Accounts, id: u32) {
    if a.busy_request == Some(id) {
        a.busy_request = None
        a.busy = false
    }
}

/// The console's account is `me` now: if it's another than it was (by its handle, whatever its
/// name), nothing of the one before stays (`another_account`).
fn identify(a: mut Accounts, me: take Me) {
    if me.handle != a.me.handle {
        another_account(mut a)
    }
    a.me = take me
}

fn keep_csrf(a: mut Accounts, csrf: Vec<u8>) {
    if a.csrf != csrf {
        a.session_revision += 1
    }
    a.csrf = csrf.clone()
}

/// The console's account became another (or none): what it knew of the one before goes (its
/// choices of posting, its codes still to save, its passkeys and sessions shown, an export under
/// way, the game's token), the new one's choices are asked for again, and replies to what was
/// asked for the one before are dropped.
fn another_account(a: mut Accounts) {
    a.epoch += 1
    a.posting = Known::Unknown
    a.posting_at = 0.0
    a.may_post = false
    a.post_best = false
    a.consent_best = false
    a.codes.clear()
    a.passkeys.clear()
    a.sessions.clear()
    a.export.clear()
    match mut a.game {
        Some(g) => {
            g.token.clear()
            g.token_at = -99999.0
            g.waiting_token = false
        },
        None => {},
    }
}

/// Whether a reply to a request for `purpose`, made for the account of `epoch`, is read: one made
/// for the account the console has, or a game's own ask (its board, its run's post with its own
/// token), whoever it was made for.
fn keeps(a: Accounts, purpose: Purpose, epoch: u32) -> bool {
    epoch == a.epoch || purpose == Purpose::Game
}

/// A reply to a request made for the account before (`another_account`): dropped. A game's
/// consent carried for it is said to the game as not taken, so it can be asked again.
fn dropped(a: mut Accounts, purpose: Purpose) {
    a.dirty = true
    if purpose == Purpose::GameConsent {
        let why = String::from("You're signed in to another account now. Post again to post as it.")
        answer_game(mut a, Answer::Failed { why, retry_after: u32(RETRY) })
    }
}

fn signed_out(a: mut Accounts) {
    keep_csrf(mut a, Vec::new())
    identify(
        mut a,
        Me {
            signed_in: false,
            name: String::new(),
            fixed: false,
            rerolls: 0,
            must_add_passkey: false,
        },
    )
    a.posting = Known::Unknown
    a.may_post = false
    a.post_best = false
    a.codes.clear()
    if a.page != Page::Legal {
        a.page = Page::Choose
        // Signed out in the game: back to its title, which offers signing in again.
        if a.in_game {
            a.open = false
        }
    }
    give_game_account(mut a)
}

/// A request's answer: its reply, or, if the server couldn't be reached or refused it before it
/// was read (a limit, the host's refusal), a failure said for a person, to be tried again.
fn answered(a: mut Accounts, purpose: Purpose, result: Result<Vec<u8>, std::io::IoError>) {
    let r = match result {
        Ok(bytes) => response(bytes),
        Err(_) => None,
    }
    if let Some(r) = r {
        if r.status == 429 {
            let why = String::from("Too many tries. Wait a minute, then try again.")
            a.connected = true
            failed(mut a, purpose, take why, LIMITED)
            return
        }
        if r.status == 200 {
            let read: Result<Reply, LoadError> = load(r.body.clone())
            if let Ok(reply) = read {
                a.connected = true
                replied(mut a, purpose, reply.clone())
                return
            }
        }
        // The server was reached but couldn't finish (its instance was dropped, or the answer took
        // too long): an upload may still be checked from its queue. Whose session it is is asked
        // again, as when it can't be reached.
        if r.status >= 500 {
            let why = String::from(
                "Something went wrong on wrela.dev. A run you posted may still go up. Check the board in a minute.",
            )
            a.connected = false
            a.retry_at = a.time + RETRY
            failed(mut a, purpose, take why, RETRY)
            return
        }
    }
    a.connected = false
    a.retry_at = a.time + RETRY
    let why = String::from("Can't reach wrela.dev. Check your connection and try again.")
    failed(mut a, purpose, take why, RETRY)
}

/// A request for `purpose` got no answer from the server (`why`, said for a person), to be tried
/// again no sooner than `after` seconds: a game hears that it may ask again, never that it was
/// refused; the console's own pages say why.
fn failed(a: mut Accounts, purpose: Purpose, why: take String, after: f32) {
    if purpose == Purpose::Game || purpose == Purpose::GameConsent {
        a.dirty = true
        answer_game(mut a, Answer::Failed { why, retry_after: u32(after) })
        return
    }
    replied(mut a, purpose, Reply::Refused { why })
}

/// The server's reply to a request for `purpose`.
fn replied(a: mut Accounts, purpose: Purpose, reply: Reply) {
    a.dirty = true
    if purpose == Purpose::Game {
        game_replied(mut a, reply)
        return
    }
    if purpose == Purpose::Posting {
        if posting_answered(mut a, reply) {
            give_game_account(mut a)
        }
        return
    }
    if purpose == Purpose::GameConsent {
        // The game's player agreed on its own screen: recorded, the game hears so with the account.
        if posting_read(mut a, reply) {
            give_game_account(mut a)
            answer_game(mut a, Answer::Done)
        } else {
            game_replied(mut a, reply)
        }
        return
    }
    match reply {
        Reply::Welcome { me, csrf } => {
            let was = a.me.signed_in
            identify(mut a, me.clone())
            keep_csrf(mut a, csrf.clone())
            if !me.signed_in {
                if was {
                    signed_out(mut a)
                }
            } else {
                a.message.clear()
                if a.page == Page::Knighting && purpose == Purpose::Name {
                    // A name kept: a new account's recovery codes next, which it must save; then
                    // back to the game, or the account's page.
                    if me.fixed {
                        if !a.codes.is_empty() {
                            a.page = Page::Codes
                        } else if a.in_game {
                            a.open = false
                        } else {
                            a.page = Page::Account
                        }
                    } else {
                        a.knight_again = true
                        a.knight_t = 0.0
                    }
                } else if a.page == Page::Recover ||
                    a.page == Page::Choose ||
                    a.page == Page::Create ||
                    a.page == Page::Manage {
                    // Signed in (or a passkey added after a recovery code) from the game: back
                    // to it.
                    if a.in_game && me.fixed && !me.must_add_passkey {
                        a.open = false
                    }
                    a.page = if me.fixed { Page::Account } else { Page::Knighting }
                    if a.page == Page::Knighting {
                        a.knight_again = true
                        a.knight_t = AGAIN
                    }
                }
                give_game_account(mut a)
            }
        },
        Reply::Challenge { ceremony, challenge, handle, exclude } => {
            a.ceremony = ceremony
            a.challenge = challenge.clone()
            a.handle = handle.clone()
            if ceremony == REGISTER {
                // The account's handle is random; its passkey is shown as the console's.
                let user = PasskeyUser {
                    id: handle.clone(),
                    name: String::from("wrela account"),
                    display_name: String::from("wrela account"),
                }
                a.passkey = Some(
                    create_passkey(
                        a.rp_id,
                        platform::account::RP_NAME,
                        user,
                        challenge,
                        [],
                        PROMPT_MS,
                    ),
                )
            } else if ceremony == ADD_PASSKEY {
                // A passkey added to an account is made for its handle, which the server gives.
                let user = PasskeyUser {
                    id: handle.clone(),
                    name: String::from("wrela account"),
                    display_name: String::from("wrela account"),
                }
                a.passkey = Some(
                    create_passkey(
                        a.rp_id,
                        platform::account::RP_NAME,
                        user,
                        challenge,
                        exclude,
                        PROMPT_MS,
                    ),
                )
            } else {
                a.passkey = Some(use_passkey(a.rp_id, challenge, [], PROMPT_MS))
            }
            a.busy = true
        },
        Reply::Session { csrf, me, codes } => {
            keep_csrf(mut a, csrf.clone())
            identify(mut a, me.clone())
            a.message.clear()
            if !codes.is_empty() {
                // A new account: knighted first, then its codes.
                a.codes = codes.clone()
                a.codes_kept = false
                a.page = Page::Knighting
                a.knight_again = false
                a.knight_t = 0.0
                knighting::sound(mut a.voice)
            } else if me.must_add_passkey {
                a.page = Page::Manage
                a.message = String::from(
                    "You signed in with a recovery code. Add a passkey now. Until you do, you can't do anything else.",
                )
            } else if me.fixed && a.in_game {
                // Signed in from the game: back to it.
                a.open = false
            } else {
                a.page = if me.fixed { Page::Account } else { Page::Knighting }
                if !me.fixed {
                    a.knight_again = true
                    a.knight_t = AGAIN
                }
            }
            give_game_account(mut a)
        },
        Reply::Codes { codes } => {
            a.codes = codes.clone()
            a.codes_kept = false
            a.page = Page::Codes
            give_game_account(mut a)
        },
        Reply::Posting { .. } => {
            let _ = posting_read(mut a, reply)
            if purpose == Purpose::Consent {
                open_page(mut a, Page::Account)
            }
            give_game_account(mut a)
        },
        Reply::Passkeys { passkeys } => a.passkeys = passkeys.clone(),
        Reply::Sessions { sessions } => a.sessions = sessions.clone(),
        Reply::Export { text, next, last } => {
            a.export.push_str(text.as_str())
            if last {
                let bytes = Vec::from(a.export.as_bytes())
                a.export_file = Some(host::export_file("wrela-account.json", bytes))
                a.export.clear()
                a.message = String::from("Your data is downloading as wrela-account.json.")
            } else {
                request(mut a, Request::Export { after: next.clone() }, Purpose::Export)
            }
        },
        Reply::Done => {
            if purpose == Purpose::Delete {
                signed_out(mut a)
                a.message = String::from("Your account is deleted, with everything we kept of it.")
            }
        },
        Reply::Token { token, .. } => {
            match mut a.game {
                Some(g) => {
                    g.token = token.clone()
                    g.token_at = a.time
                },
                None => {},
            }
            if let Some(g) = a.game {
                if g.waiting_token {
                    send_game(mut a)
                }
            }
        },
        Reply::Refused { why } => {
            a.message = why.clone()
            if purpose == Purpose::Export {
                a.export.clear()
            }
            if purpose == Purpose::Token {
                if let Some(g) = a.game {
                    if g.waiting_token {
                        send_game(mut a)
                    }
                }
            }
        },
        _ => {},
    }
}

/// What the account chose of posting, if `reply` says (`Reply::Posting`): whether it did.
fn posting_read(a: mut Accounts, reply: Reply) -> bool {
    let Reply::Posting { agreed, best_runs } = reply else { return false }
    a.may_post = agreed
    a.post_best = best_runs
    a.posting = Known::Known
    true
}

/// The answer to `Request::Posting`: whether it said what the account chose. If not (it couldn't
/// be reached, or refused), it stays unknown, asked again a little later, and is never taken as a
/// choice not to post.
fn posting_answered(a: mut Accounts, reply: Reply) -> bool {
    if posting_read(mut a, reply) {
        return true
    }
    a.posting = Known::Unknown
    a.posting_at = a.time + RETRY
    false
}

// ---- the game shown ------------------------------------------------------------------------

/// A game shows, in surface `surface`, its catalog key `id`: it's given the account.
/// Whether nothing of the account is under way or showing: its panel closed, no request, passkey
/// ceremony or export in flight. The console reloads onto a new release only then.
pub fn idle(a: Accounts) -> bool {
    !a.open && !a.busy && a.waiting.is_empty() && a.passkey.is_none() && a.export_file.is_none()
}

/// Whether its panel is open over the home.
pub fn shown(a: Accounts) -> bool {
    a.open
}

/// How it's shown over the MMO: the console's zoom, whether motion is reduced, and whether the
/// host reads a semantic tree.
pub fn set_view(a: mut Accounts, zoom: f32, reduced: bool, semantics: bool) {
    a.view_zoom = zoom
    a.view_reduced = reduced
    a.view_semantics = semantics
    a.in_game = true
}

/// Takes the program's one voice for the console's themes, if the knighting's fanfare hasn't:
/// then the fanfare stays silent, since a program that starts a second voice traps.
pub fn take_voice(a: mut Accounts) -> bool {
    if a.voice {
        return false
    }
    a.voice = true
    true
}

/// The page shows the games' home, not the MMO: the account's words and steps are the home's.
pub fn left_game(a: mut Accounts) {
    a.in_game = false
}

// The account over the MMO (mmo/game/client.wrela's `Account`): its chip in the corner, and its
// pages over the game while open, as over the home.
impl mmo::client::Account for Accounts {
    fn event(mut self, e: Event) -> bool {
        let zoom = self.view_zoom
        event(mut self, e, zoom)
    }

    fn draw(mut self, list: mut DrawList, fonts: Fonts, width: u32, height: u32) {
        let zoom = self.view_zoom
        let reduced = self.view_reduced
        let (w, h) = (f32(width) / zoom, f32(height) / zoom)
        draw(mut self, mut list, fonts, w, h, 24.0, zoom, reduced)
        if self.view_semantics {
            publish(mut self, vec4(0.0, 0.0, f32(width), f32(height)))
        }
    }

    fn open(mut self, create: bool) {
        if !self.online || self.me.signed_in {
            act(mut self, Act::Chip)
            return
        }
        self.open = true
        if create {
            act(mut self, Act::Create)
        } else {
            // Signing in asks for the passkey at once; its page stays, for a lost one.
            open_page(mut self, Page::Choose)
            act(mut self, Act::SignIn)
        }
    }

    fn shown(self) -> bool {
        self.open
    }

    fn who(self) -> String {
        let handle = std::hash::sha256::hex(self.me.handle)
        String::from(
            f"{self.me.signed_in}/{self.me.fixed}/{self.me.must_add_passkey}/{handle}/{self.session_revision}",
        )
    }
}

pub fn game_shown(a: mut Accounts, surface: u32, id: str) {
    a.game = Some(
        GameLink {
            surface,
            id: id.to_string(),
            call: None,
            token: Vec::new(),
            token_at: -99999.0,
            asking: false,
            uploading: false,
            waiting_token: false,
            answer: Answer::Nothing,
        },
    )
    send_game(mut a)
}

/// The game shown has closed.
pub fn game_closed(a: mut Accounts) {
    a.game = None
}

/// The account as the game shown may know it.
fn linked(a: Accounts) -> Linked {
    let token = match a.game {
        Some(g) => g.token.clone(),
        None => Vec::new(),
    }
    Linked {
        signed_in: a.me.signed_in && !a.me.must_add_passkey,
        id: game_id(a.me.handle),
        name: a.me.name.clone(),
        token,
        may_post: a.may_post,
        post_best: a.post_best,
        save_codes: !a.codes.is_empty(),
        posting_known: a.posting == Known::Known,
    }
}

/// Who the account is, as a game is told it (`Linked::id`): a digest of its handle, which says
/// nothing else of it (empty when signed out).
fn game_id(handle: [u8]) -> Vec<u8> {
    if handle.is_empty() {
        return Vec::new()
    }
    var m = Vec::from(String::from("wrela-game-account").as_bytes())
    for b in handle {
        m.push(b)
    }
    let d = sha256(m)
    var out: Vec<u8> = Vec::new()
    for i in 0..16 {
        out.push(d[i])
    }
    out
}

/// What `send_game` needs of the game shown to know whether to call it: its key, whether a call
/// or an ask is open, when its token came, and whether one is being fetched. The answer it's owed
/// is read only as a call goes.
struct Shown {
    id: String,
    open: bool,
    token_at: f32,
    waiting_token: bool,
}

fn shown_game(a: Accounts) -> Option<Shown> {
    match a.game {
        Some(g) => Some(
            Shown {
                id: g.id.clone(),
                open: g.call.is_some() || g.asking,
                token_at: g.token_at,
                waiting_token: g.waiting_token,
            },
        ),
        None => None,
    }
}

/// Calls the game with the account and the answer to its last ask, once its token is fresh.
fn send_game(a: mut Accounts) {
    let Some(g) = shown_game(a) else { return }
    if g.open {
        return
    }
    let wants_token = a.me.signed_in && a.me.fixed && !a.me.must_add_passkey
    if wants_token && a.time - g.token_at > TOKEN_FRESH && a.connected && !g.waiting_token {
        match mut a.game {
            Some(l) => l.waiting_token = true,
            None => {},
        }
        request(mut a, Request::Token { game: g.id.clone() }, Purpose::Token)
        return
    }
    let account = linked(a)
    match mut a.game {
        Some(l) => {
            let call = ToGame { account, answer: l.answer.clone() }
            l.waiting_token = false
            l.call = Some(host::send(l.surface, save(call)))
        },
        None => {},
    }
}

/// The account changed: the game hears of it with its next call, which comes now if none is
/// open (one is open while the game holds it, until it asks, or hands it back within
/// `link::HEARTBEAT` with nothing to ask).
fn give_game_account(a: mut Accounts) {
    match mut a.game {
        Some(g) => g.token_at = -99999.0,
        None => {},
    }
}

fn game_replied(a: mut Accounts, reply: Reply) {
    let (course, category, uploading) = match a.game {
        Some(g) => match g.answer {
            Answer::Board { course, category, .. } => (course, category, g.uploading),
            _ => (0, 0, g.uploading),
        },
        None => (0, 0, false),
    }
    answer_game(mut a, game_answer(reply, course, category, uploading))
}

/// What the server's `reply` to a game's ask tells the game: a board's page names its board
/// (`course`, `category`), which the reply doesn't. An upload the server refused (`uploading`)
/// can't be taken now, so it's tried again; one it rejected never goes up.
fn game_answer(reply: Reply, course: u32, category: u32, uploading: bool) -> Answer {
    match reply {
        Reply::Verified { run, ticks, place } => Answer::Verified {
            run: run.clone(),
            ticks,
            place,
        },
        Reply::Rejected { why } => Answer::Rejected { why: why.clone() },
        Reply::Refused { why } => {
            if uploading {
                Answer::Failed { why: why.clone(), retry_after: u32(RETRY) }
            } else { Answer::Rejected { why: why.clone() } }
        },
        Reply::Board { places, total, next } => {
            Answer::Board { course, category, places: places.clone(), total, next: next.clone() }
        },
        Reply::Run { run, replay, .. } => Answer::Run { run: run.clone(), replay: replay.clone() },
        Reply::Around { places, at } => Answer::Around { places: places.clone(), at },
        Reply::Unplaced => Answer::Unplaced,
        Reply::Names { found } => Answer::Names { found: found.clone() },
        _ => Answer::Offline {
            why: String::from("The boards sent something the console can't read."),
        },
    }
}

/// The answer to the game's ask: its next call takes it.
fn answer_game(a: mut Accounts, answer: take Answer) {
    match mut a.game {
        Some(g) => {
            g.asking = false
            g.answer = take answer
        },
        None => return,
    }
    send_game(mut a)
}

/// The game's ask, from its reply to the console's call: carried to the server, or answered at
/// once if the console can't.
fn game_asked(a: mut Accounts, bytes: [u8]) {
    let Some(g) = shown_game(a) else { return }
    let Some(ask) = from_game(bytes) else { return }
    if let Some(ans) = answer_now(a.me, a.online, a.connected, ask) {
        match mut a.game {
            Some(l) => l.answer = take ans,
            None => {},
        }
        send_game(mut a)
        return
    }
    if let Ask::Board { course, category, .. } = ask {
        // Its reply names no board: the answer kept says which.
        match mut a.game {
            Some(l) => {
                l.answer = Answer::Board {
                    course,
                    category,
                    places: Vec::new(),
                    total: 0,
                    next: Vec::new(),
                }
            },
            None => {},
        }
    }
    let (r, purpose) = carried(ask, g.id.as_str(), a.csrf)
    let uploading = match r {
        Request::Upload { .. } => true,
        _ => false,
    }
    match mut a.game {
        Some(l) => {
            l.asking = true
            l.uploading = uploading
        },
        None => {},
    }
    request(mut a, r, purpose)
}

/// The request that carries game `game`'s `ask` to the server, and what it's for: a session's
/// change (the consent) carries the session's CSRF token `csrf`.
fn carried(ask: Ask, game: str, csrf: [u8]) -> (Request, Purpose) {
    let id = String::from(game)
    let r = match ask {
        // Never carried: `answer_now` answers it.
        Ask::Nothing => Request::Me,
        Ask::Upload { token, board, replay } => Request::Upload {
            token: token.clone(),
            game: id,
            board,
            replay: replay.clone(),
        },
        Ask::Board { course, category, from, after } => Request::Board {
            game: id,
            course,
            category,
            from,
            after: after.clone(),
        },
        Ask::Watch { run } => Request::Watch { run: run.clone() },
        Ask::Around { course, category, name } => Request::Around {
            game: id,
            course,
            category,
            name: name.clone(),
        },
        Ask::Names { title, noun, epithet } => Request::Names {
            game: id,
            title: title.clone(),
            noun: noun.clone(),
            epithet: epithet.clone(),
        },
        // The player's choice on the game's own screen, recorded as the console's own is.
        Ask::Consent { version, best_runs } => {
            let r = Request::Consent { csrf: Vec::from(csrf), version, best_runs }
            return (take r, Purpose::GameConsent)
        },
    }
    (take r, Purpose::Game)
}

/// The answer to a game's `ask` that the console gives at once, without the server: no server yet,
/// offline, or an upload while signed out.
fn answer_now(me: Me, online: bool, connected: bool, ask: Ask) -> Option<Answer> {
    // The game handed the call back with nothing to ask: called again at once, with the account
    // as it is now.
    if let Ask::Nothing = ask {
        return Some(Answer::Nothing)
    }
    if !online {
        return Some(
            Answer::Offline {
                why: String::from(
                    "The world's boards open soon. Your runs are saved on this device.",
                ),
            },
        )
    }
    if !connected {
        return Some(
            Answer::Offline {
                why: String::from(
                    "Can't reach the boards. Your runs are saved on this device. Try again later.",
                ),
            },
        )
    }
    let posting = match ask {
        Ask::Upload { .. } | Ask::Consent { .. } => true,
        _ => false,
    }
    if posting && (!me.signed_in || !me.fixed || me.must_add_passkey) {
        return Some(
            Answer::Offline {
                why: String::from(posting::SIGN_IN),
            },
        )
    }
    None
}

// ---- each frame ----------------------------------------------------------------------------

/// Whether what the account chose of posting is to be asked at `time`: it's signed in, the server
/// can be reached, and it isn't known or asked, nor waiting after a failed ask.
fn wants_posting(a: Accounts, time: f32) -> bool {
    let whole = a.me.signed_in && !a.me.must_add_passkey
    a.online && a.connected && whole && a.posting == Known::Unknown && time >= a.posting_at
}

/// Polls what the account waits on, at the host's time `time`: whether anything it shows changed.
pub fn update(a: mut Accounts, time: f32) -> bool {
    let dt = max(time - a.time, 0.0)
    a.time = time
    a.dt = min(dt, 0.1)
    if a.open && a.shown_t < 1.0 {
        a.shown_t = kit::ease(a.shown_t, 1.0, a.dt, OPEN_SECONDS)
        a.dirty = true
    } else if !a.open {
        a.shown_t = 0.0
        a.sheet_h = 0.0
    }
    // Only controls drawn last frame ease: one gone (its page closed, its row removed) is still.
    for i in 0..min(a.hover.len(), a.shown.len()) {
        if a.hover[i] > 0.0 && a.hover[i] < 1.0 {
            a.dirty = true
        }
    }
    // Whose session the cookie is, asked first, and again while the server can't be reached.
    if a.online && !a.connected && a.waiting.is_empty() && time >= a.retry_at {
        request(mut a, Request::Me, Purpose::Other)
    }
    // What the account chose of posting, once it's signed in: asked until it's said.
    if wants_posting(a, time) {
        a.posting = Known::Asking
        request(mut a, Request::Posting, Purpose::Posting)
    }
    var i = 0
    while i < a.waiting.len() {
        match a.waiting[i].0.poll() {
            Some(result) => {
                let (_, purpose, epoch, id) = a.waiting.remove(i)
                request_finished(mut a, id)
                if keeps(a, purpose, epoch) {
                    answered(mut a, purpose, take result)
                } else {
                    dropped(mut a, purpose)
                }
            },
            None => i += 1,
        }
    }
    if let Some(result) = answer_of(mut a.passkey) {
        a.dirty = true
        a.busy = false
        match result {
            Ok(bytes) => {
                if a.ceremony == SIGN_IN {
                    if let Some(u) = read_passkey_use(bytes) {
                        let r = Request::SignIn {
                            challenge: a.challenge.clone(),
                            id: u.id.clone(),
                            client_data: u.client_data.clone(),
                            authenticator_data: u.authenticator_data.clone(),
                            signature: u.signature.clone(),
                            user: u.user.clone(),
                        }
                        request(mut a, r, Purpose::Other)
                        a.busy = true
                    }
                } else if let Some(p) = read_new_passkey(bytes) {
                    let r = if a.ceremony == REGISTER {
                        Request::Register {
                            handle: a.handle.clone(),
                            challenge: a.challenge.clone(),
                            agreed: agreed_now(),
                            id: p.id.clone(),
                            client_data: p.client_data.clone(),
                            attestation: p.attestation.clone(),
                        }
                    } else {
                        Request::AddPasskey {
                            csrf: a.csrf.clone(),
                            challenge: a.challenge.clone(),
                            id: p.id.clone(),
                            client_data: p.client_data.clone(),
                            attestation: p.attestation.clone(),
                        }
                    }
                    request(mut a, r, Purpose::Other)
                    a.busy = true
                }
            },
            Err(_) => a.message = String::from(
                "The passkey prompt closed, or this browser can't use passkeys. Try again, or use another browser.",
            ),
        }
    }
    read_code(mut a)
    let _ = answer_of(mut a.export_file)
    // What the semantic tree sent, done with.
    i = 0
    while i < a.told.len() {
        if a.told[i].poll().is_some() {
            let _ = a.told.remove(i)
        } else {
            i += 1
        }
    }
    // The game's reply to the console's call: its next ask.
    var asked: Option<Vec<u8>> = None
    var gone = false
    match mut a.game {
        Some(g) => {
            match answer_of(mut g.call) {
                Some(Ok(bytes)) => asked = Some(take bytes),
                Some(Err(_)) => gone = true,
                None => {},
            }
        },
        None => {},
    }
    if gone {
        a.game = None
    }
    if let Some(bytes) = asked {
        game_asked(mut a, bytes)
    }
    if a.game.is_some() {
        send_game(mut a)
    }
    for i in 0..a.licences.len() {
        if let Some(result) = answer_of(mut a.licences[i]) {
            a.dirty = true
            a.licence_text[i] = match result {
                Ok(bytes) => String::from_utf8(bytes.clone()).unwrap_or(String::new()),
                Err(_) => String::from(
                    f"({legal::LICENCES[i]} comes with the console in a release.)",
                ),
            }
        }
    }
    if a.page == Page::Knighting && a.open {
        a.knight_t += dt
        a.dirty = true
    }
    let changed = a.dirty
    a.dirty = false
    changed
}

/// Whether it is animating, so the console draws every frame.
pub fn animating(a: Accounts) -> bool {
    a.open && !a.view_reduced && a.page == Page::Knighting && a.knight_t < LENGTH + 0.2
}

const NO_FOCUS: u32 = 4294967295

/// The control after the focused one (the first, if none is focused).
fn next_focus(a: Accounts) -> u32 {
    if a.shown.is_empty() {
        0
    } else if a.focus == NO_FOCUS { 0 } else { (a.focus + 1) % a.shown.len() }
}

/// The control before the focused one (the last, if none is focused).
fn previous_focus(a: Accounts) -> u32 {
    if a.shown.is_empty() {
        0
    } else if a.focus == NO_FOCUS {
        a.shown.len() - 1
    } else { (a.focus + a.shown.len() - 1) % a.shown.len() }
}

fn open_page(a: mut Accounts, page: Page) {
    a.page = page
    a.hover.clear()
    a.pressed = None
    // The recovery code's page has its field focused, not a button.
    a.focus = if page == Page::Recover { NO_FOCUS } else { 0 }
    if page == Page::Recover {
        // A new field: its revisions start again.
        a.code_heard = 0
        a.code_seen = 0
        a.code_read = None
        a.code_sent.clear()
        a.code_wanted = false
    }
    a.message.clear()
    a.scroll = 0.0
    a.dirty = true
    if page == Page::Manage && a.me.signed_in {
        request(mut a, Request::Passkeys, Purpose::Other)
        request(mut a, Request::Sessions, Purpose::Other)
    }
}

/// Whether `x` sends a request whose answer it waits for: not again until it comes.
fn sends(x: Act) -> bool {
    match x {
        Act::SignIn | Act::CreateAccount | Act::SubmitCode | Act::AddPasskey | Act::ConfirmDelete => {
            true
        },
        Act::Post | Act::BestRuns | Act::Keep | Act::Reroll | Act::NewCodes => true,
        _ => false,
    }
}

/// What a control says while its request is under way.
fn under_way(x: Act) -> Text {
    match x {
        Act::SignIn | Act::AddPasskey => "Waiting for your passkey…",
        Act::CreateAccount => "Making your passkey…",
        Act::SubmitCode => "Checking your code…",
        Act::ConfirmDelete => "Deleting…",
        _ => "Saving…",
    }
}

/// The request that makes an account, if both its boxes are ticked: it carries the versions agreed
/// to, which the server checks against its own.
fn create_request(a: Accounts) -> Option<Request> {
    if !a.agree || !a.of_age {
        return None
    }
    Some(Request::Begin { ceremony: REGISTER, csrf: Vec::new(), agreed: agreed_now() })
}

/// What a player who ticked both boxes agrees to: this build's Terms and Privacy Policy, and that
/// they're 13 or older. A sign-up's finish carries it again, as its challenge was made for it.
const CHOOSE_BOARDS: Text = "With an account, your runs go on the world's leaderboards. You sign in with a passkey on this device. There's no email and no password. We give you a name."
const CHOOSE_GAME: Text = "Your account keeps your character and everything they carry. You sign in with a passkey on this device: no email, no password. The sea gives you your name."

fn agreed_now() -> Agreed {
    Agreed { terms: legal::TERMS_VERSION, privacy: legal::PRIVACY_VERSION, of_age: true }
}

/// Where Back goes from the page open: a legal page back where it was opened from (making an
/// account keeps its boxes), anything else to the account's page, or the first page signed out.
fn returns_to(a: Accounts) -> Page {
    if a.page == Page::Legal && a.back != Page::Legal {
        a.back
    } else if a.me.signed_in { Page::Account } else { Page::Choose }
}

/// The account page's buttons below its setting: its codes to save first, while they wait.
fn account_items(a: Accounts) -> Vec<(Act, Text, bool)> {
    var items: Vec<(Act, Text, bool)> = Vec::new()
    if !a.codes.is_empty() {
        items.push((Act::SaveCodes, "Save your recovery codes", true))
    }
    items.push((Act::Manage, "Passkeys and sessions", false))
    items.push((Act::Export, "Export my data", false))
    items.push((Act::SignOut, "Sign out", false))
    // Last and set apart, where it isn't pressed for another (`stack` draws it destructive).
    items.push((Act::Delete, "Delete account", false))
    items
}

/// Whether turning on "Post my best runs" shows what posting shares first: it does until the
/// account has agreed.
fn asks_consent_first(a: Accounts) -> bool {
    !a.may_post && !a.post_best
}

/// Whether press `x` goes on: one that sends a request doesn't while another is under way, and
/// marks one under way (`busy`, until its answer comes), so pressed twice it sends once.
fn press(a: mut Accounts, x: Act) -> bool {
    if !sends(x) {
        return true
    }
    if a.busy {
        return false
    }
    a.doing = Some(x)
    a.busy = true
    true
}

fn act(a: mut Accounts, x: Act) {
    a.dirty = true
    if !press(mut a, x) {
        return
    }
    match x {
        Act::Chip => {
            a.open = true
            if !a.online {
                act(mut a, Act::Legal { page: legal::HEALTH })
                return
            }
            let page = if !a.me.signed_in { Page::Choose } else if !a.me.fixed {
                Page::Knighting
            } else { Page::Account }
            open_page(mut a, page)
            if page == Page::Knighting {
                a.knight_again = true
                a.knight_t = AGAIN
            }
        },
        Act::Close => a.open = false,
        Act::SignIn => {
            a.message.clear()
            request(
                mut a,
                Request::Begin { ceremony: SIGN_IN, csrf: Vec::new(), agreed: NOT_AGREED },
                Purpose::Other,
            )
        },
        Act::Create => {
            a.agree = false
            a.of_age = false
            open_page(mut a, Page::Create)
        },
        Act::Agree => a.agree = !a.agree,
        Act::OfAge => a.of_age = !a.of_age,
        Act::CreateAccount => {
            let Some(r) = create_request(a) else {
                a.doing = None
                a.busy = false
                a.message = String::from("Tick both boxes to create your account.")
                return
            }
            a.message.clear()
            request(mut a, r, Purpose::Other)
        },
        Act::UseCode => {
            a.typed.clear()
            open_page(mut a, Page::Recover)
        },
        Act::SubmitCode => {
            if a.code_heard > a.code_seen || a.code_read.is_some() {
                // The field has text not yet read (a paste, a password manager): sent once read.
                a.doing = None
                a.busy = false
                a.code_wanted = true
                return
            }
            a.code_wanted = false
            a.code_sent = a.typed.clone()
            request(mut a, Request::Recover { code: a.typed.clone() }, Purpose::Other)
        },
        Act::Keep => {
            request(mut a, Request::Keep { csrf: a.csrf.clone() }, Purpose::Name)
        },
        Act::Reroll => {
            request(mut a, Request::Reroll { csrf: a.csrf.clone() }, Purpose::Name)
        },
        Act::CodesSaved => {
            a.codes.clear()
            give_game_account(mut a)
            if a.in_game {
                // Signed up in the game: back to it, where the character is made next.
                a.open = false
            } else {
                open_page(mut a, Page::Account)
            }
        },
        Act::SaveCodes => open_page(mut a, Page::Codes),
        Act::DownloadCodes => {
            var text = String::from(f"wrela recovery codes for {a.me.name}\n")
            text.push_str("Each code signs you in once if you lose your passkeys.\n\n")
            for c in a.codes {
                text.push_str(c.as_str())
                text.push_str("\n")
            }
            let bytes = Vec::from(text.as_bytes())
            a.export_file = Some(host::export_file("wrela-recovery-codes.txt", bytes))
            a.codes_kept = true
        },
        Act::BestRuns => {
            if asks_consent_first(a) {
                // Turned on before any post: what posting shares, first.
                a.doing = None
                a.busy = false
                a.consent_best = true
                open_page(mut a, Page::Posting)
                return
            }
            let r = Request::BestRuns { csrf: a.csrf.clone(), on: !a.post_best }
            request(mut a, r, Purpose::Other)
        },
        Act::PostBest => a.consent_best = !a.consent_best,
        Act::Post => {
            let r = Request::Consent {
                csrf: a.csrf.clone(),
                version: posting::VERSION,
                best_runs: a.consent_best,
            }
            request(mut a, r, Purpose::Consent)
        },
        Act::NotNow => open_page(mut a, Page::Account),
        Act::Manage => open_page(mut a, Page::Manage),
        Act::AddPasskey => {
            request(
                mut a,
                Request::Begin { ceremony: ADD_PASSKEY, csrf: a.csrf.clone(), agreed: NOT_AGREED },
                Purpose::Other,
            )
        },
        Act::Remove { index } => {
            if index < a.passkeys.len() {
                let id = a.passkeys[index].id.clone()
                request(
                    mut a,
                    Request::RemovePasskey { csrf: a.csrf.clone(), id },
                    Purpose::Other,
                )
            }
        },
        Act::Revoke { index } => {
            if index < a.sessions.len() {
                let id = a.sessions[index].id.clone()
                request(
                    mut a,
                    Request::Revoke { csrf: a.csrf.clone(), session: id },
                    Purpose::Other,
                )
            }
        },
        Act::NewCodes => {
            request(mut a, Request::NewCodes { csrf: a.csrf.clone() }, Purpose::Other)
        },
        Act::Export => {
            a.export.clear()
            request(mut a, Request::Export { after: Vec::new() }, Purpose::Export)
            a.message = String::from("Getting your data ready…")
        },
        Act::Delete => open_page(mut a, Page::Delete),
        Act::ConfirmDelete => {
            request(mut a, Request::Delete { csrf: a.csrf.clone() }, Purpose::Delete)
        },
        Act::SignOut => {
            request(mut a, Request::SignOut { csrf: a.csrf.clone() }, Purpose::Other)
        },
        Act::Back => {
            if !a.online {
                a.open = false
                return
            }
            let page = returns_to(a)
            if a.page == page || (a.page == Page::Account && a.me.signed_in) {
                a.open = false
            } else {
                open_page(mut a, page)
            }
        },
        Act::Legal { page } => {
            if a.page != Page::Legal {
                a.back = a.page
            }
            open_page(mut a, Page::Legal)
            a.legal = page
            if page == legal::CREDITS && a.licences.is_empty() {
                for path in legal::LICENCES {
                    a.licences.push(Some(fetch(path)))
                    a.licence_text.push(String::new())
                }
            }
        },
    }
}

/// Whether the knighting is still playing: its actions aren't shown or live until it finishes.
fn knighting(a: Accounts) -> bool {
    !a.view_reduced && a.page == Page::Knighting && a.knight_t < (if a.knight_again { AGAIN } else {
        LENGTH
    })
}

/// The live control at `p` in logical pixels: clipped controls and the knighting while it plays
/// take no clicks.
fn control_at(a: Accounts, p: vec2) -> Option<Act> {
    let knighting = a.open && knighting(a)
    for (x, r) in a.shown {
        let live = if a.open {
            x == Act::Chip || a.page == Page::Knighting || a.sheet_at.contains(p)
        } else { x == Act::Chip }
        if r.contains(p) && live && !knighting { return Some(x) }
    }
    None
}

/// Finishes this pointer's press even when it ends elsewhere. Activates only the control that
/// was pressed, so dragging a scene or selecting text cannot press an account action on release.
fn released(a: mut Accounts, at: vec2, zoom: f32) -> Option<Act> {
    let pressed = a.pressed
    a.pressed = None
    if pressed.is_some() { a.dirty = true }
    let over = control_at(a, at / zoom)
    if over == pressed { over } else { None }
}

/// Event `e` (positions in device pixels, `zoom` of them a logical pixel): whether the account
/// took it, so the console doesn't.
pub fn event(a: mut Accounts, e: Event, zoom: f32) -> bool {
    if let Event::PointerDown { at, button: Button::Primary, .. } = e {
        // Pressed: the control under it shows so until the press ends.
        a.keyboard = false
        a.pressed = control_at(a, at / zoom)
        a.dirty = true
        if !a.open { return a.pressed.is_some() }
    }
    if let Event::PointerUp { at, button: Button::Primary, .. } = e {
        if let Some(x) = released(mut a, at, zoom) {
            act(mut a, x)
            return true
        }
    }
    if let Event::KeyDown { key, .. } = e {
        if a.open &&
            (key == Key::Tab ||
                key == Key::Up ||
                key == Key::Down ||
                key == Key::Left ||
                key == Key::Right) {
            a.keyboard = true
        }
    }
    if !a.open {
        // Closed, the chip alone takes a click, and lights under the pointer.
        if let Event::PointerMove { at, .. } = e {
            let was = over_chip(a)
            a.pointer = Some(at / zoom)
            if over_chip(a) != was { a.dirty = true }
        }
        return false
    }
    a.dirty = true
    let knighting = knighting(a)
    match e {
        Event::PointerMove { at, .. } => {
            a.pointer = Some(at / zoom)
            a.keyboard = false
        },
        Event::Wheel { delta, .. } => a.scroll = max(a.scroll + delta.y / zoom, 0.0),
        Event::Assist { node, action } => {
            if !knighting {
                if let Some(x) = assisted(mut a, node, action) {
                    act(mut a, x)
                }
            }
        },
        Event::KeyDown { key, repeat, mods } => {
            if key == Key::Escape && !knighting {
                act(mut a, Act::Back)
            } else if key == Key::Enter && !repeat && !knighting {
                if a.focus == NO_FOCUS && a.page == Page::Recover {
                    // Enter in the code's field signs in.
                    act(mut a, Act::SubmitCode)
                } else if a.focus < a.shown.len() {
                    act(mut a, a.shown[a.focus].0)
                }
            } else if key == Key::Down || key == Key::Right || (key == Key::Tab && !mods.shift) {
                if a.page == Page::Legal && key == Key::Down {
                    a.scroll += 40.0
                } else {
                    a.focus = next_focus(a)
                }
            } else if key == Key::Up || key == Key::Left || (key == Key::Tab && mods.shift) {
                if a.page == Page::Legal && key == Key::Up {
                    a.scroll = max(a.scroll - 40.0, 0.0)
                } else if !a.shown.is_empty() {
                    a.focus = previous_focus(a)
                }
            } else if key == Key::Backspace && a.page == Page::Recover {
                let n = a.typed.len()
                if n > 0 {
                    a.typed.truncate(n - 1)
                }
            }
        },
        Event::Text { char } => {
            if a.page == Page::Recover {
                typed(mut a.typed, char)
            }
        },
        Event::Field { node, revision } => {
            if node == a.code_node && a.page == Page::Recover {
                a.code_heard = max(a.code_heard, revision)
            }
        },
        Event::PadButton { button, pressed: true, .. } => {
            // A pad moves the focus as the keyboard does: its ring shows.
            a.keyboard = true
            if button == PadButton::South && !knighting && a.focus < a.shown.len() {
                act(mut a, a.shown[a.focus].0)
            } else if button == PadButton::East && !knighting {
                act(mut a, Act::Back)
            } else if button == PadButton::Down || button == PadButton::Right {
                a.focus = next_focus(a)
            } else if button == PadButton::Up || button == PadButton::Left {
                if !a.shown.is_empty() {
                    a.focus = previous_focus(a)
                }
            }
        },
        _ => {},
    }
    true
}

/// What the keyboard or a screen reader did to node `node` of the page's tree (`action`): the
/// control to act as, if it pressed one (or dismissed the dialog: Back). A focus moved to a
/// control is the console's focus too.
fn assisted(a: mut Accounts, node: u32, action: Assist) -> Option<Act> {
    if node == 0 || node > a.node_controls.len() {
        return None
    }
    if node == 1 && action == Assist::Dismiss {
        return Some(Act::Back)
    }
    let Some(i) = a.node_controls[node - 1] else { return None }
    if i >= a.shown.len() {
        return None
    }
    if action == Assist::Focus {
        // The focus moving to another control is the keyboard's (or a screen reader's): a press
        // doesn't move it, and a dialog that opens focuses the control already focused. Its ring
        // shows.
        if i != a.focus {
            a.keyboard = true
        }
        a.focus = i
        return None
    }
    if action == Assist::Activate { Some(a.shown[i].0) } else { None }
}

/// Publishes the page as last drawn as the console's semantic tree, named as the page is
/// (`wrela`), with the canvas's view `view` (device pixels); none while no page is open.
pub fn publish(a: mut Accounts, view: vec4) {
    let nodes = if a.open { a.nodes.clone() } else { Vec::new() }
    host::publish(mut a.told, mut a.tree, "wrela", nodes, view)
}

// ---- drawing ---------------------------------------------------------------------------------

/// Adds a part of the page to its tree, in reading order under the dialog: what it is, its name,
/// where it is (logical pixels), and the control it acts as, if it's one.
fn said(
    a: mut Accounts,
    role: Role,
    label: str,
    r: Rect,
    zoom: f32,
    control: Option<u32> = None,
    checked: bool = false,
    disabled: bool = false,
    level: u32 = 0,
) {
    let at = z(r, zoom)
    let focused = match control {
        Some(i) => i == a.focus,
        None => false,
    }
    a.nodes.push(
        Node {
            id: a.nodes.len() + 1,
            parent: 1,
            role,
            label: String::from(label),
            rect: vec4(at.x, at.y, at.w, at.h),
            checked,
            disabled,
            focused,
            // Each control's ring is drawn here (`focus_ring`), when the keyboard put it there:
            // the host draws none of its own over it.
            ringed: control.is_some(),
            level,
        },
    )
    a.node_controls.push(control)
}

/// Writes `s` wrapped to `width` from `at`, as `paragraph` does, and adds it to the page's tree:
/// the height it took.
fn para(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    s: str,
    size: f32,
    at: vec2,
    width: f32,
    color: vec4,
    zoom: f32,
    face: Face = Face::Sans,
) -> f32 {
    let h = paragraph(mut d, fonts, s, size, at, width, color, zoom, face)
    said(mut a, Role::Text, s, Rect::new(at.x, at.y, width, h), zoom)
    h
}

/// What drawing needs: the list, the fonts, the zoom.
struct Pen {
    zoom: f32,
}

fn z(r: Rect, zoom: f32) -> Rect {
    let x0 = round(r.x * zoom)
    let y0 = round(r.y * zoom)
    Rect::new(x0, y0, round(r.right() * zoom) - x0, round(r.bottom() * zoom) - y0)
}

fn measure(fonts: Fonts, s: str, size: f32, face: Face) -> f32 {
    fonts.font(face).measure(s, size)
}

/// Writes `s` with its top-left at `at` (logical pixels).
fn write(
    d: mut DrawList,
    fonts: Fonts,
    s: str,
    size: f32,
    at: vec2,
    color: vec4,
    zoom: f32,
    face: Face = Face::Sans,
    weight: f32 = -1.0,
) {
    let at = vec2(round(at.x * zoom), round(at.y * zoom))
    let _ = d.text(fonts, face, s, size * zoom, at, color, weight: weight)
}

/// `s` broken into lines that fit `width` at `size`.
fn wrapped(fonts: Fonts, s: str, size: f32, width: f32, face: Face) -> Vec<String> {
    var lines: Vec<String> = Vec::new()
    var line = String::new()
    for (from, to) in s.split(" ") {
        let word = s.slice(from, to)
        let before = line.len()
        if before > 0 {
            line.push_str(" ")
        }
        line.push_str(word)
        if before > 0 && measure(fonts, line.as_str(), size, face) > width {
            // Test the actual line, then restore its prefix on wrapping: no full-line trial
            // clone per word, and no second copy when the finished line moves to the output.
            line.truncate(before)
            lines.push(take line)
            line = String::from(word)
        }
    }
    if !line.is_empty() || lines.is_empty() {
        lines.push(take line)
    }
    lines
}

/// Writes `s` wrapped to `width` from `at`: the height it took.
fn paragraph(
    d: mut DrawList,
    fonts: Fonts,
    s: str,
    size: f32,
    at: vec2,
    width: f32,
    color: vec4,
    zoom: f32,
    face: Face = Face::Sans,
) -> f32 {
    let lines = wrapped(fonts, s, size, width, face)
    let lh = size * 1.5
    for i in 0..lines.len() {
        write(mut d, fonts, lines[i].as_str(), size, at + vec2(0.0, f32(i) * lh), color, zoom, face)
    }
    f32(lines.len()) * lh
}

fn button(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    x: Act,
    r: Rect,
    label: str,
    zoom: f32,
    primary: bool = false,
    danger: bool = false,
    disabled: bool = false,
    ghost: bool = false,
    size: f32 = LABEL,
) {
    let index = a.controls.len()
    a.controls.push((x, r))
    let loading = a.busy && a.doing == Some(x)
    // While its request is under way, it says what's happening.
    let label = if loading { String::from(under_way(x)) } else { String::from(label) }
    said(mut a, Role::Button, label.as_str(), r, zoom, control: Some(index), disabled: disabled)
    let variant = if danger && ghost { Variant::DestructiveGhost } else if danger {
        Variant::Destructive
    } else if primary { Variant::Primary } else if ghost {
        Variant::Ghost
    } else { Variant::Outline }
    let st = look(mut a, index, r, disabled || (a.busy && !loading && sends(x)), loading)
    kit::button(mut d, fonts, z(r, zoom), label.as_str(), variant, st, zoom, size)
}

/// How control `index` over `r` looks this frame: its hover eased toward the pointer's, pressed,
/// focused by the keyboard, disabled or working.
fn look(a: mut Accounts, index: u32, r: Rect, disabled: bool, loading: bool) -> State {
    while a.hover.len() <= index {
        a.hover.push(0.0)
    }
    let over = match a.pointer {
        Some(p) => r.contains(p),
        None => false,
    }
    a.hover[index] = kit::ease(a.hover[index], if over && !a.keyboard { 1.0 } else { 0.0 }, a.dt)
    State {
        hover: a.hover[index],
        pressed: a.pressed == Some(a.controls[index].0) && over,
        focused: a.keyboard && index == a.focus,
        disabled,
        loading,
        time: a.time,
    }
}

/// Whether the pointer is over the chip, as last drawn: a hand over it, and its lighter fill.
pub fn over_chip(a: Accounts) -> bool {
    let Some(p) = a.pointer else { return false }
    for (x, r) in a.shown {
        if x == Act::Chip && r.contains(p) { return true }
    }
    false
}

/// Draws the focus ring around `r` if the keyboard put the focus on control `index`.
fn focus_ring(a: Accounts, d: mut DrawList, index: u32, r: Rect, zoom: f32) {
    if a.keyboard && index == a.focus {
        kit::focus_ring(mut d, z(r, zoom), 4.0 * zoom, zoom)
    }
}

/// A box the player ticks, `on` or not, with `label` after it, in a row of height 32 from `at`. A
/// box whose words are drawn apart (with links in them) is named by `spoken`.
fn checkbox(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    x: Act,
    at: vec2,
    w: f32,
    label: str,
    on: bool,
    zoom: f32,
    spoken: Text = "",
) {
    let r = Rect::new(at.x, at.y, w, 32.0)
    let index = a.controls.len()
    a.controls.push((x, r))
    let name = if label.is_empty() { String::from(spoken) } else { String::from(label) }
    said(mut a, Role::Checkbox, name.as_str(), r, zoom, control: Some(index), checked: on)
    let st = look(mut a, index, r, disabled: false, loading: false)
    let b = Rect::new(at.x, at.y + 8.0, w: 16.0, h: 16.0)
    kit::checkbox(mut d, z(b, zoom), on, st, zoom)
    let top = kit::centred_top(fonts, (at.y + 16.0) * zoom, BODY * zoom) / zoom
    write(mut d, fonts, label, BODY, vec2(at.x + 28.0, top), INK, zoom, weight: kit::MEDIUM)
}

/// A link: underlined words, `label` from `at` at `size`, which act as `x`: how wide it is.
fn link(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    x: Act,
    at: vec2,
    label: str,
    size: f32,
    zoom: f32,
    inline: bool = false,
) -> f32 {
    let w = measure(fonts, label, size * zoom, Face::Sans) / zoom
    let r = Rect::new(at.x - 2.0, at.y - 4.0, w + 4.0, size + 10.0)
    let index = a.controls.len()
    a.controls.push((x, r))
    said(mut a, Role::Link, label, r, zoom, control: Some(index))
    let st = look(mut a, index, r, disabled: false, loading: false)
    let lit = if st.pressed { 1.0 } else { st.hover }
    // A link in a sentence is the sentence's colour; one on its own is muted until pointed at.
    let rest = if inline { INK } else { MUTED }
    write(mut d, fonts, label, size, at, kit::mix(rest, INK, lit), zoom, weight: kit::MEDIUM)
    // Underlined 4 px below the words (`underline-offset-4`), stronger under the pointer.
    let base = round((at.y + size * 1.2) * zoom) + 0.5
    let thick = max(round(zoom), 1.0)
    let line = vec4(kit::mix(rest, INK, lit).xyz, 0.3 + 0.7 * lit)
    d.line(vec2(round(at.x * zoom), base), vec2(round((at.x + w) * zoom), base), line, thick)
    focus_ring(a, mut d, index, r, zoom)
    w
}

/// The dialog's close button in its top right corner (`DialogClose`): an X, faint until the
/// pointer is on it. Last in the focus order, as on the web.
fn close_x(a: mut Accounts, d: mut DrawList, sheet: Rect, zoom: f32) {
    let r = Rect::new(sheet.right() - 16.0 - 24.0, sheet.y + 16.0, w: 24.0, h: 24.0)
    let index = a.controls.len()
    a.controls.push((Act::Close, r))
    said(mut a, Role::Button, "Close", r, zoom, control: Some(index))
    let st = look(mut a, index, r, disabled: false, loading: false)
    let zr = z(r, zoom)
    d.rect(zr, vec4(kit::ACCENT.xyz, st.hover), 4.0 * zoom)
    let ink = kit::mix(MUTED, INK, if st.pressed { 1.0 } else { st.hover })
    let c = vec2(zr.x + zr.w * 0.5, zr.y + zr.h * 0.5)
    let k = 4.5 * zoom
    let w = max(1.5 * zoom, 1.0)
    d.line(c + vec2(-k, -k), c + vec2(k, k), ink, w)
    d.line(c + vec2(-k, k), c + vec2(k, -k), ink, w)
    focus_ring(a, mut d, index, r, zoom)
}

/// A column of buttons from `y`, each the sheet's width: where it ended.
fn stack(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    items: [(Act, Text, bool)],
    x: f32,
    y: f32,
    w: f32,
    zoom: f32,
) -> f32 {
    var at = y
    for (act_of, label, primary) in items {
        let danger = act_of == Act::ConfirmDelete
        if act_of == Act::Delete {
            // Set apart from the rest by a rule, and red only in its words (`text-destructive`).
            at += 12.0
            d.rect(z(Rect::new(x, at - 10.0, w, 1.0), zoom), BORDER)
        }
        let r = Rect::new(x, at, w, CONTROL)
        let quiet = act_of == Act::Delete
        button(
            mut a,
            mut d,
            fonts,
            act_of,
            r,
            label,
            zoom,
            primary,
            danger: danger || quiet,
            ghost: quiet,
        )
        at += CONTROL + GAP
    }
    at
}

/// The row of legal links at the dialog's foot: small ghost buttons, centred. Where it ended.
fn legal_row(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    x: f32,
    y: f32,
    w: f32,
    zoom: f32,
) -> f32 {
    let size = 12.0
    var widths: Vec<f32> = Vec::new()
    var total = 0.0
    for k in 0..legal::PAGES {
        let bw = measure(fonts, legal::LINKS[k], size * zoom, Face::Sans) / zoom + 16.0
        widths.push(bw)
        total += bw
    }
    var at = round(x + (w - total) * 0.5)
    for k in 0..legal::PAGES {
        let r = Rect::new(at, y, widths[k], 28.0)
        button(
            mut a,
            mut d,
            fonts,
            Act::Legal { page: k },
            r,
            legal::LINKS[k],
            zoom,
            ghost: true,
            size: size,
        )
        at += widths[k]
    }
    y + 28.0
}

/// Draws the chip, and the open page over everything (`w` by `h` logical pixels at `zoom`; the
/// header's margin `margin`). With `reduced`, the knighting doesn't move.
pub fn draw(
    a: mut Accounts,
    d: mut DrawList,
    fonts: Fonts,
    w: f32,
    h: f32,
    margin: f32,
    zoom: f32,
    reduced: bool,
) {
    // The home and MMO both draw this account. Input readiness must use the same motion
    // setting as the drawing, including the home which doesn't call `set_view`.
    a.view_reduced = reduced
    a.controls.clear()
    a.nodes.clear()
    a.node_controls.clear()
    // The chip, in the header's corner.
    let chip_label = if !a.online { String::from("Health and legal") } else if a.me.signed_in {
        a.me.name.clone()
    } else { String::from("Sign in") }
    // An outline button (`size="sm"`... at the default height), as wide as its words.
    let cw = min(
        measure(fonts, chip_label.as_str(), LABEL * zoom, Face::Sans) / zoom + 24.0,
        w * 0.45,
    )
    let chip = Rect::new(round(w - margin - cw), 24.0, round(cw), CONTROL)
    a.controls.push((Act::Chip, chip))
    if !a.open {
        let st = look(mut a, 0, chip, disabled: false, loading: false)
        let zc = z(chip, zoom)
        // Dark glass under the outline, so the chip reads over a pale sky as well as the dark.
        d.rect(zc, vec4(0.047, 0.055, 0.078, 0.55), kit::RADIUS * zoom)
        kit::button(mut d, fonts, zc, "", Variant::Outline, st, zoom)
        // Clipped at its sides only: a long name ends at the padding, and no descender is cut.
        d.push_clip(Rect::new(zc.x + 12.0 * zoom, zc.y, max(zc.w - 24.0 * zoom, 0.0), zc.h))
        let top = kit::centred_top(fonts, zc.y + zc.h * 0.5, LABEL * zoom) / zoom
        let label = chip_label.as_str()
        write(mut d, fonts, label, LABEL, vec2(chip.x + 12.0, top), INK, zoom, weight: kit::MEDIUM)
        d.pop_clip()
        a.shown = a.controls.clone()
        return
    }
    a.controls.clear()
    if a.page == Page::Knighting {
        // The tree's dialog, named by the name drawn.
        let name = a.me.name.clone()
        a.nodes.push(Node { id: 1, role: Role::Dialog, label: name, modal: true })
        a.node_controls.push(None)
        let again = a.knight_again
        knighting::draw(mut d, fonts, a.knight_t, a.me.name.as_str(), again, w, h, zoom, reduced)
        let done = reduced || a.knight_t >= (if again { AGAIN } else { LENGTH })
        if done {
            let bw = min(300.0, w - 48.0)
            let x = w * 0.5 - bw * 0.5
            var y = h * 0.58
            let note = "No one else on wrela will ever have this name."
            let nw = measure(fonts, note, BODY * zoom, Face::Sans) / zoom
            let at = vec2(w * 0.5 - min(nw, w - 48.0) * 0.5, y)
            write(mut d, fonts, note, BODY, at, MUTED, zoom)
            said(mut a, Role::Text, note, Rect::new(at.x, at.y, nw, BODY * 1.5), zoom)
            y += 36.0
            button(
                mut a,
                mut d,
                fonts,
                Act::Keep,
                Rect::new(x, y, bw, CONTROL),
                "Keep this name",
                zoom,
                primary: true,
            )
            if a.me.rerolls > 0 {
                let label = f"Draw again ({a.me.rerolls} left)"
                button(
                    mut a,
                    mut d,
                    fonts,
                    Act::Reroll,
                    Rect::new(x, y + CONTROL + GAP, bw, CONTROL),
                    label.as_str(),
                    zoom,
                )
            }
            if !a.message.is_empty() {
                let m = a.message.clone()
                write(
                    mut d,
                    fonts,
                    m.as_str(),
                    13.0,
                    vec2(x, y + 2.0 * (CONTROL + GAP) + 8.0),
                    WARN,
                    zoom,
                )
                said(
                    mut a,
                    Role::Text,
                    m.as_str(),
                    Rect::new(x, y + 2.0 * (CONTROL + GAP) + 8.0, bw, 20.0),
                    zoom,
                )
            }
        }
        a.shown = a.controls.clone()
        return
    }
    // A dialog over the dimmed page (shadcn's `Dialog`): it fades in and rises a little, and its
    // height is its page's (as last drawn), eased when the page changes.
    let t = if reduced { 1.0 } else { 1.0 - (1.0 - a.shown_t) * (1.0 - a.shown_t) }
    let was = d.alpha
    d.alpha = was * t
    d.rect(Rect::new(x: 0.0, y: 0.0, w: w * zoom, h: h * zoom), vec4(0.0, 0.0, 0.0, 0.6))
    let legal = a.page == Page::Legal
    let sw = min(if legal { 720.0 } else { SHEET_WIDTH }, w - 32.0)
    let wanted = if legal || a.sheet_h <= 0.0 { h - 48.0 } else { a.sheet_h }
    let sh = min(h - 48.0, wanted)
    let rise = (1.0 - t) * 8.0
    let sheet = Rect::new(
        round(w * 0.5 - sw * 0.5),
        round(h * 0.5 - sh * 0.5 + rise),
        round(sw),
        sh,
    )
    kit::shadow(mut d, z(sheet, zoom), kit::CARD_RADIUS * zoom, zoom)
    d.rect(z(sheet, zoom), kit::BG, kit::CARD_RADIUS * zoom)
    d.ring(z(sheet, zoom), BORDER, kit::CARD_RADIUS * zoom, max(round(zoom), 1.0))
    a.sheet_at = sheet
    d.push_clip(z(sheet, zoom))
    let x = sheet.x + PAD
    let iw = sw - 2.0 * PAD
    var y = sheet.y + PAD
    let title = match a.page {
        Page::Account => "Your account",
        Page::Choose => "Your account",
        Page::Create => "Create account",
        Page::Posting => posting::TITLE,
        Page::Recover => "Use a recovery code",
        Page::Codes => "Your recovery codes",
        Page::Manage => "Passkeys and sessions",
        Page::Delete => "Delete your account",
        Page::Legal => legal::TITLES[min(a.legal, legal::PAGES - 1)],
        Page::Knighting => "",
    }
    write(mut d, fonts, title, 18.0, vec2(x, y), INK, zoom, weight: kit::SEMIBOLD)
    // The tree: a dialog named by the page's title, its heading first.
    let sz = z(sheet, zoom)
    a.nodes.push(
        Node {
            id: 1,
            role: Role::Dialog,
            label: String::from(title),
            modal: true,
            rect: vec4(sz.x, sz.y, sz.w, sz.h),
        },
    )
    a.node_controls.push(None)
    said(mut a, Role::Heading, title, Rect::new(x, y, iw, 24.0), zoom, level: 1)
    y += 32.0
    match a.page {
        Page::Choose => {
            y += para(
                mut a,
                mut d,
                fonts,
                if a.in_game { CHOOSE_GAME } else { CHOOSE_BOARDS },
                BODY,
                vec2(x, y),
                iw,
                MUTED,
                zoom,
            )
            y += 18.0
            let items = [
                (Act::SignIn, "Sign in", true),
                (Act::Create, "Create account", false),
            ]
            y = stack(mut a, mut d, fonts, items, x, y, iw, zoom)
            let lost = "Lost your passkey?"
            let lw = measure(fonts, lost, 13.0 * zoom, Face::Sans) / zoom
            y += 4.0
            let _ = link(
                mut a,
                mut d,
                fonts,
                Act::UseCode,
                vec2(round(x + (iw - lw) * 0.5), y),
                lost,
                13.0,
                zoom,
            )
            y += 24.0
            close_x(mut a, mut d, sheet, zoom)
        },
        Page::Create => {
            y += para(
                mut a,
                mut d,
                fonts,
                "You'll make a passkey on this device, then we draw your name.",
                BODY,
                vec2(x, y),
                iw,
                MUTED,
                zoom,
            )
            y += 16.0
            // The first box's words hold the two pages' links, each opening its page and coming back.
            checkbox(
                mut a,
                mut d,
                fonts,
                Act::Agree,
                vec2(x, y),
                28.0,
                "",
                a.agree,
                zoom,
                spoken: "I agree to the Terms and the Privacy Policy",
            )
            // As a box's own label is set (`checkbox`): 28 from its left, centred on the box.
            let top = kit::centred_top(fonts, (y + 16.0) * zoom, BODY * zoom) / zoom
            let words = vec2(x + 28.0, top)
            var at = words.x
            let gap = |s: str| -> f32 { measure(fonts, s, BODY * zoom, Face::Sans) / zoom }
            write(
                mut d,
                fonts,
                "I agree to the",
                BODY,
                vec2(at, words.y),
                INK,
                zoom,
                weight: kit::MEDIUM,
            )
            at += gap("I agree to the ")
            at += link(
                mut a,
                mut d,
                fonts,
                Act::Legal { page: legal::TERMS },
                vec2(at, words.y),
                "Terms",
                BODY,
                zoom,
                inline: true,
            )
            write(mut d, fonts, " and the", BODY, vec2(at, words.y), INK, zoom, weight: kit::MEDIUM)
            at += gap(" and the ")
            var line = words.y
            if at + gap("Privacy Policy") > x + iw {
                at = words.x
                line += BODY * 1.5
            }
            let _ = link(
                mut a,
                mut d,
                fonts,
                Act::Legal { page: legal::PRIVACY },
                vec2(at, line),
                "Privacy Policy",
                BODY,
                zoom,
                inline: true,
            )
            y += 36.0 + (line - words.y)
            checkbox(
                mut a,
                mut d,
                fonts,
                Act::OfAge,
                vec2(x, y),
                iw,
                "I'm 13 or older",
                a.of_age,
                zoom,
            )
            y += 32.0 + 16.0
            let ready = a.agree && a.of_age
            button(
                mut a,
                mut d,
                fonts,
                Act::CreateAccount,
                Rect::new(x, y, iw, CONTROL),
                "Create account",
                zoom,
                primary: true,
                disabled: !ready,
            )
            y += CONTROL + GAP
            y = stack(mut a, mut d, fonts, [(Act::Back, "Back", false)], x, y, iw, zoom)
        },
        Page::Posting => {
            y += para(
                mut a,
                mut d,
                fonts,
                posting::LEAD,
                BODY,
                vec2(x, y),
                iw,
                MUTED,
                zoom,
            )
            y += 8.0
            for item in posting::SHARED {
                d.ellipse(z(Rect::new(x + 3.0, y + BODY * 0.55, w: 5.0, h: 5.0), zoom), INK)
                y += para(
                    mut a,
                    mut d,
                    fonts,
                    item,
                    BODY,
                    vec2(x + 16.0, y),
                    iw - 16.0,
                    INK,
                    zoom,
                ) +
                    4.0
            }
            y += 8.0
            y += para(mut a, mut d, fonts, posting::NEVER, BODY, vec2(x, y), iw, MUTED, zoom)
            y += 14.0
            checkbox(
                mut a,
                mut d,
                fonts,
                Act::PostBest,
                vec2(x, y),
                iw,
                posting::BEST_RUNS,
                a.consent_best,
                zoom,
            )
            y += 32.0
            y += para(
                mut a,
                mut d,
                fonts,
                posting::BEST_RUNS_NOTE,
                13.0,
                vec2(x + 32.0, y),
                iw - 32.0,
                MUTED,
                zoom,
            )
            y += 14.0
            let items = [(Act::Post, "Agree", true), (Act::NotNow, posting::NOT_NOW, false)]
            y = stack(mut a, mut d, fonts, items, x, y, iw, zoom)
        },
        Page::Account => {
            // Who is signed in, as the dialog's description.
            let name = a.me.name.clone()
            let who = String::from(f"Signed in as {name}")
            y += para(mut a, mut d, fonts, who.as_str(), BODY, vec2(x, y), iw, MUTED, zoom)
            y += 16.0
            if !a.in_game {
                checkbox(
                    mut a,
                    mut d,
                    fonts,
                    Act::BestRuns,
                    vec2(x, y),
                    iw,
                    "Post my best runs",
                    a.post_best,
                    zoom,
                )
                y += 44.0
            }
            let items = account_items(a)
            y = stack(mut a, mut d, fonts, items, x, y, iw, zoom)
            close_x(mut a, mut d, sheet, zoom)
        },
        Page::Recover => {
            y += para(
                mut a,
                mut d,
                fonts,
                "Type one of the ten codes you got when you made your account. Each code works once. It signs you out everywhere else, then you add a new passkey.",
                BODY,
                vec2(x, y),
                iw,
                MUTED,
                zoom,
            )
            y += 14.0
            let field = Rect::new(x, y, iw, CONTROL)
            // A field of the host's, focused: what's typed goes there, from a keyboard, a
            // paste or a password manager, and the page reads it back (`read_code`).
            let at = z(field, zoom)
            a.nodes.push(
                Node {
                    id: a.nodes.len() + 1,
                    parent: 1,
                    role: Role::Field,
                    label: String::from("Recovery code"),
                    rect: vec4(at.x, at.y, at.w, at.h),
                    focused: true,
                    field: Some(
                        Field {
                            kind: FieldKind::Text,
                            name: String::from("recovery-code"),
                            autocomplete: String::from("one-time-code"),
                        },
                    ),
                },
            )
            a.node_controls.push(None)
            a.code_node = a.nodes.len()
            // An input (`Input`): its fill and border, and while it has the focus (a field shows it
            // from a pointer too) the ring; the code in mono, or its shape as a placeholder; a
            // caret that blinks after it.
            let zf = z(field, zoom)
            let editing = a.focus == NO_FOCUS
            d.rect(zf, kit::INPUT_BG, RADIUS * zoom)
            if editing {
                kit::focus_ring(mut d, zf, RADIUS * zoom, zoom)
            } else {
                d.ring(zf, kit::INPUT, RADIUS * zoom, max(round(zoom), 1.0))
            }
            let size = 15.0
            let typed = a.typed.clone()
            let empty = typed.is_empty()
            let shown = if empty { String::from("XXXX-XXXX-XXXX-XXXX") } else { typed.clone() }
            let shown = shown.as_str()
            let top = kit::centred_top(fonts, zf.y + zf.h * 0.5, size * zoom, Face::Mono) / zoom
            write(mut d, fonts, shown, size, vec2(x + 12.0, top), if empty { MUTED } else {
                INK
            }, zoom, Face::Mono)
            if editing && fract(a.time) < 0.55 {
                let tw = if empty { 0.0 } else {
                    measure(fonts, shown, size * zoom, Face::Mono) / zoom
                }
                let cx = round((x + 12.0 + tw) * zoom) + 0.5
                let h = round(18.0 * zoom)
                let cy = round(zf.y + (zf.h - h) * 0.5)
                d.line(vec2(cx, cy), vec2(cx, cy + h), INK, max(round(zoom), 1.0))
            }
            y += CONTROL + 16.0
            let items = [(Act::SubmitCode, "Sign in", true), (Act::Back, "Back", false)]
            y = stack(mut a, mut d, fonts, items, x, y, iw, zoom)
        },
        Page::Codes => {
            y += para(
                mut a,
                mut d,
                fonts,
                "Keep these somewhere safe and away from this device, like on paper or in a password manager. If you lose your passkeys, each code signs you in once. After you save them, we won't show them again.",
                BODY,
                vec2(x, y),
                iw,
                MUTED,
                zoom,
            )
            y += 16.0
            // In a muted, bordered well (`bg-muted rounded-md`), two columns of mono, each
            // centred in its half, so they read as one thing to copy down.
            let rows = f32((a.codes.len() + 1) / 2)
            let well = Rect::new(x, y, iw, rows * 26.0 + 24.0)
            d.rect(z(well, zoom), kit::INPUT_BG, kit::RADIUS * zoom)
            d.ring(z(well, zoom), BORDER, kit::RADIUS * zoom, max(round(zoom), 1.0))
            let size = 14.0
            for i in 0..a.codes.len() {
                let half = (iw - 24.0) * 0.5
                let cw = measure(fonts, a.codes[i].as_str(), size * zoom, Face::Mono) / zoom
                let cx = x + 12.0 + f32(i % 2) * half + (half - cw) * 0.5
                let cy = y + 12.0 + f32(i / 2) * 26.0
                let code = a.codes[i].clone()
                said(mut a, Role::Text, code.as_str(), Rect::new(cx, cy, cw, 22.0), zoom)
                let top = kit::centred_top(fonts, (cy + 11.0) * zoom, size * zoom, Face::Mono) /
                    zoom
                write(mut d, fonts, code.as_str(), size, vec2(cx, top), INK, zoom, Face::Mono)
            }
            y += well.h + 24.0
            let items = [
                (Act::DownloadCodes, "Download them", !a.codes_kept),
                (Act::CodesSaved, "I've saved them", a.codes_kept),
            ]
            y = stack(mut a, mut d, fonts, items, x, y, iw, zoom)
        },
        Page::Manage => {
            write(mut d, fonts, "Passkeys", 13.0, vec2(x, y), MUTED, zoom)
            y += 24.0
            for i in 0..min(a.passkeys.len(), 6) {
                let label = f"Passkey {i + 1} ({std::hash::sha256::hex(short(a.passkeys[i].id))})"
                let top = kit::centred_top(fonts, (y + 16.0) * zoom, BODY * zoom) / zoom
                write(mut d, fonts, label.as_str(), BODY, vec2(x, top), INK, zoom)
                said(mut a, Role::Text, label.as_str(), Rect::new(x, y, iw - 100.0, 32.0), zoom)
                button(
                    mut a,
                    mut d,
                    fonts,
                    Act::Remove { index: i },
                    Rect::new(x + iw - 84.0, y, w: 84.0, h: 32.0),
                    "Remove",
                    zoom,
                    size: 13.0,
                )
                y += 40.0
            }
            y = stack(
                mut a,
                mut d,
                fonts,
                [(Act::AddPasskey, "Add a passkey", a.me.must_add_passkey)],
                x,
                y,
                iw,
                zoom,
            )
            write(mut d, fonts, "Sessions", 13.0, vec2(x, y + 4.0), MUTED, zoom)
            y += 28.0
            for i in 0..min(a.sessions.len(), 5) {
                let s = a.sessions[i].clone()
                let label = if s.this {
                    f"This device ({std::hash::sha256::hex(short(s.id))})"
                } else {
                    f"Session {std::hash::sha256::hex(short(s.id))}"
                }
                let top = kit::centred_top(fonts, (y + 16.0) * zoom, BODY * zoom) / zoom
                write(mut d, fonts, label.as_str(), BODY, vec2(x, top), INK, zoom)
                said(mut a, Role::Text, label.as_str(), Rect::new(x, y, iw - 100.0, 32.0), zoom)
                if !s.this {
                    button(
                        mut a,
                        mut d,
                        fonts,
                        Act::Revoke { index: i },
                        Rect::new(x + iw - 84.0, y, w: 84.0, h: 32.0),
                        "Sign out",
                        zoom,
                        size: 13.0,
                    )
                }
                y += 40.0
            }
            let items = [
                (Act::NewCodes, "New recovery codes", false),
                (Act::Back, "Back", false),
            ]
            y = stack(mut a, mut d, fonts, items, x, y + 6.0, iw, zoom)
        },
        Page::Delete => {
            y += para(
                mut a,
                mut d,
                fonts,
                "This deletes your account and everything in it. You can't undo it. Your saves on this device stay.",
                BODY,
                vec2(x, y),
                iw,
                MUTED,
                zoom,
            )
            y += 18.0
            // As an alert dialog has it: the way out first, and focused, so Enter never deletes;
            // the destructive one last.
            let items = [
                (Act::Back, "Cancel", false),
                (Act::SignIn, "Sign in again first", false),
                (Act::ConfirmDelete, "Delete everything", false),
            ]
            y = stack(mut a, mut d, fonts, items, x, y, iw, zoom)
        },
        Page::Legal => {
            write(mut d, fonts, legal::DRAFT, 13.0, vec2(x, y - 14.0), WARN, zoom)
            let body = Rect::new(x, y + 8.0, iw, sheet.bottom() - y - 70.0)
            d.push_clip(z(body, zoom))
            var py = body.y - a.scroll
            for p in legal::paragraphs(a.legal) {
                if p.as_str().starts_with("# ") {
                    py += 10.0
                    let heading = p.as_str().slice(2, p.len())
                    write(mut d, fonts, heading, 17.0, vec2(x, py), INK, zoom)
                    said(mut a, Role::Heading, heading, Rect::new(x, py, iw, 26.0), zoom, level: 2)
                    py += 30.0
                } else if p.as_str().starts_with("- ") {
                    // A point: a dot, as the fonts hold no bullet.
                    d.ellipse(z(Rect::new(x + 3.0, py + BODY * 0.55, w: 5.0, h: 5.0), zoom), MUTED)
                    py += para(
                        mut a,
                        mut d,
                        fonts,
                        p.as_str().slice(2, p.len()),
                        BODY,
                        vec2(x + 16.0, py),
                        iw - 16.0,
                        MUTED,
                        zoom,
                    ) +
                        4.0
                } else {
                    py += para(
                        mut a,
                        mut d,
                        fonts,
                        p.as_str(),
                        BODY,
                        vec2(x, py),
                        iw,
                        MUTED,
                        zoom,
                    ) +
                        8.0
                }
            }
            if a.legal == legal::CREDITS {
                for i in 0..a.licence_text.len() {
                    py += 10.0
                    write(mut d, fonts, legal::LICENCES[i], 15.0, vec2(x, py), INK, zoom)
                    py += 26.0
                    let text = a.licence_text[i].clone()
                    for (from, to) in text.as_str().lines() {
                        py += para(
                            mut a,
                            mut d,
                            fonts,
                            text.as_str().slice(from, to),
                            12.0,
                            vec2(x, py),
                            iw,
                            MUTED,
                            zoom,
                            Face::Mono,
                        )
                    }
                }
            }
            d.pop_clip()
            // Scrolled no further than the end.
            let end = py + a.scroll - body.y
            a.scroll = min(a.scroll, max(end - body.h + 20.0, 0.0))
            y = sheet.bottom() - 52.0
            let gap = 8.0
            let bw = (iw - 4.0 * gap) / 5.0
            for k in 0..legal::PAGES {
                let label = legal::LINKS[k]
                button(
                    mut a,
                    mut d,
                    fonts,
                    Act::Legal { page: k },
                    Rect::new(x + f32(k) * (bw + gap), y, bw, 34.0),
                    label,
                    zoom,
                    primary: k == a.legal,
                )
            }
            button(
                mut a,
                mut d,
                fonts,
                Act::Back,
                Rect::new(x + 4.0 * (bw + gap), y, bw, 34.0),
                "Back",
                zoom,
            )
        },
        Page::Knighting => {},
    }
    // A request under way says so on its button (a spinner and what it waits for).
    if !a.busy && !a.connected && a.page != Page::Legal {
        write(mut d, fonts, "Connecting…", 13.0, vec2(x, y + 4.0), MUTED, zoom)
        said(mut a, Role::Text, "Connecting…", Rect::new(x, y + 4.0, iw, 20.0), zoom)
        y += 24.0
    }
    if !a.message.is_empty() && a.page != Page::Legal {
        let m = a.message.clone()
        y += 4.0 + para(mut a, mut d, fonts, m.as_str(), 13.0, vec2(x, y + 4.0), iw, WARN, zoom)
    }
    if a.page != Page::Legal {
        y += 12.0
        y = legal_row(mut a, mut d, fonts, x, y, iw, zoom)
    }
    d.pop_clip()
    d.alpha = was
    // The height the page took: the dialog's next, eased there from the one before.
    let page_h = y + PAD - 4.0 - sheet.y
    a.sheet_h = if a.sheet_h <= 0.0 || reduced { page_h } else {
        let k = min(a.dt / 0.12, 1.0)
        let next = a.sheet_h + (page_h - a.sheet_h) * k
        if abs(next - page_h) < 0.5 { page_h } else { next }
    }
    if a.focus != NO_FOCUS {
        a.focus = min(a.focus, max(a.controls.len(), 1) - 1)
    }
    a.shown = a.controls.clone()
}

/// `char` typed into a recovery code: a code is letters, digits and hyphens, so nothing else can be
/// typed, here or anywhere in the console.
/// Reads the recovery code's field once the host says it changed, and sends the code once it's
/// whole (16 letters and digits), as a person would press Sign in.
fn read_code(a: mut Accounts) {
    if a.page != Page::Recover {
        a.code_read = None
        return
    }
    if let Some(Ok(bytes)) = answer_of(mut a.code_read) {
        if let Ok(state) = read_field_state(take bytes) {
            a.code_seen = max(a.code_seen, state.revision)
            a.typed.clear()
            for b in state.text.as_bytes() {
                typed(mut a.typed, u32(b))
            }
            a.dirty = true
        }
    }
    if a.code_read.is_none() && a.code_heard > a.code_seen {
        a.code_read = Some(host::field_state(a.code_node))
    }
    var letters = 0
    for b in a.typed.as_bytes() {
        if b != 45 {
            letters += 1
        }
    }
    let caught_up = a.code_read.is_none() && a.code_heard <= a.code_seen
    if caught_up && !a.busy && (a.code_wanted || (letters == 16 && a.typed != a.code_sent)) {
        act(mut a, Act::SubmitCode)
    }
}

fn typed(code: mut String, char: u32) {
    let c = if char >= 97 && char <= 122 { char - 32 } else { char }
    if code.len() < 24 && ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || c == 45) {
        code.push_char(c)
    }
}

/// The first four bytes of an ID, to name it.
fn short(id: [u8]) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    for i in 0..min(4, id.len()) {
        out.push(id[i])
    }
    out
}

@test
fn a_typed_recovery_code_takes_only_what_a_code_holds() {
    var code = String::new()
    for c in [97, 66, 45, 33, 32, 55, 0x1f600] {
        typed(mut code, c)
    }
    assert(code == String::from("AB-7"), code.as_str())
}

@test
fn a_game_is_told_at_once_when_the_console_cant_ask() {
    let me = Me {
        signed_in: true,
        name: String::from("Sir Wobblesnout the Unhurried"),
        fixed: true,
        rerolls: 0,
        must_add_passkey: false,
    }
    let up = Ask::Upload { token: Vec::from([5; 32]), board: 3, replay: Vec::from([1]) }
    let Some(Answer::Offline { .. }) = answer_now(
        me,
        online: true,
        connected: false,
        ask: up.clone(),
    ) else {
        panic("offline")
    }
    assert(
        answer_now(me, online: true, connected: true, ask: up.clone()).is_none(),
        "carried to the server",
    )
    var out = me.clone()
    out.signed_in = false
    let Some(Answer::Offline { .. }) = answer_now(
        out,
        online: true,
        connected: true,
        ask: up.clone(),
    ) else {
        panic("signed out")
    }
    var unknighted = me.clone()
    unknighted.fixed = false
    assert(
        answer_now(unknighted, online: true, connected: true, ask: up.clone()).is_some(),
        "not knighted yet",
    )
    assert(
        answer_now(
            out,
            online: true,
            connected: true,
            ask: Ask::Board { course: 0, category: 0, from: 0, after: Vec::new() },
        ).is_none(),
        "anyone may look at a board",
    )
    let Some(Answer::Offline { .. }) = answer_now(
        me,
        online: false,
        connected: true,
        ask: Ask::Board { course: 0, category: 0, from: 0, after: Vec::new() },
    ) else {
        panic("no server yet")
    }
}

@test
fn making_an_account_waits_for_both_boxes_and_carries_the_versions_agreed_to() {
    var a = new("wrela.dev", online: true)
    a.page = Page::Create
    assert(create_request(a).is_none(), "both unticked")
    a.agree = true
    assert(create_request(a).is_none(), "one box isn't both")
    a.agree = false
    a.of_age = true
    assert(create_request(a).is_none(), "nor the other")
    a.agree = true
    let Some(Request::Begin { ceremony, agreed, .. }) = create_request(a) else {
        panic("ready")
    }
    assert(ceremony == REGISTER && agreed.of_age)
    assert(agreed.terms == legal::TERMS_VERSION && agreed.privacy == legal::PRIVACY_VERSION)
    // A legal page opened from its link goes back to the page that opened it.
    a.back = Page::Create
    a.page = Page::Legal
    assert(returns_to(a) == Page::Create)
    a.back = Page::Legal
    assert(returns_to(a) == Page::Choose, "signed out, the first page")
    assert(sends(Act::CreateAccount) && sends(Act::Post) && !sends(Act::Agree), "sent once")
}

@test
fn recovery_codes_wait_on_the_account_page_until_saved() {
    var a = new("wrela.dev", online: true)
    a.me.signed_in = true
    a.me.fixed = true
    assert(account_items(a)[0].0 == Act::Manage && !linked(a).save_codes, "none to save")
    for k in 0..10 {
        a.codes.push(String::from(f"CODE-{k}"))
    }
    let items = account_items(a)
    assert(items[0].0 == Act::SaveCodes && items[0].2, "offered first")
    assert(linked(a).save_codes, "a game may remind")
}

@test
fn posting_waits_for_agreement_and_the_game_hears_it() {
    var a = new("wrela.dev", online: true)
    a.me.signed_in = true
    a.me.fixed = true
    assert(!linked(a).may_post && asks_consent_first(a), "not until agreed")
    a.may_post = true
    a.post_best = true
    assert(linked(a).may_post && linked(a).post_best && !asks_consent_first(a))
    let agreed = Ask::Consent { version: posting::VERSION, best_runs: true }
    let Some(Answer::Offline { .. }) = answer_now(
        a.me,
        online: true,
        connected: false,
        ask: agreed.clone(),
    ) else {
        panic("offline")
    }
    var out = a.me.clone()
    out.signed_in = false
    assert(
        answer_now(out, online: true, connected: true, ask: agreed.clone()).is_some(),
        "signed out",
    )
}

@test
fn a_games_consent_is_its_players_choice_recorded_without_the_consoles_page() {
    let ask = Ask::Consent { version: posting::VERSION, best_runs: true }
    let (r, purpose) = carried(ask, "capybara", [7, 7])
    let Request::Consent { csrf, version, best_runs } = r else { panic("the consent, relayed") }
    assert(purpose == Purpose::GameConsent && csrf == Vec::from([7, 7]))
    assert(version == posting::VERSION && best_runs, "what the player read and chose")
    let run = platform::wire::RunRef { handle: Vec::from([3; 16]), n: 3 }
    let (_, other) = carried(Ask::Watch { run }, "capybara", [7, 7])
    assert(other == Purpose::Game)
    // Recorded: the game's account says so, and the console's own pages stay closed (a game shown
    // hides the console).
    var a = new("wrela.dev", online: true)
    a.me.signed_in = true
    a.me.fixed = true
    assert(!posting_read(mut a, Reply::Done) && !linked(a).may_post, "not a choice")
    assert(posting_read(mut a, Reply::Posting { agreed: true, best_runs: true }))
    assert(linked(a).may_post && linked(a).post_best && !a.open, "agreed, nothing opened")
}

@test
fn posting_unknown_is_asked_until_its_known_and_never_an_opt_out() {
    var a = new("wrela.dev", online: true)
    a.me.signed_in = true
    a.me.fixed = true
    a.connected = true
    assert(wants_posting(a, 0.0) && !linked(a).posting_known, "asked, unknown meanwhile")
    a.posting = Known::Asking
    assert(!wants_posting(a, 0.0), "once at a time")
    // The ask failed (unreachable, refused): unknown again, and asked again after a while.
    a.time = 10.0
    assert(!posting_answered(mut a, Reply::Refused { why: String::from("Try again.") }))
    assert(a.posting == Known::Unknown && !linked(a).posting_known && a.message.is_empty())
    assert(!wants_posting(a, 10.0) && wants_posting(a, 10.0 + RETRY), "after a while")
    assert(posting_answered(mut a, Reply::Posting { agreed: true, best_runs: false }))
    let l = linked(a)
    assert(l.posting_known && l.may_post && !l.post_best && !wants_posting(a, 99.0), "known")
}

/// Account `h`'s `Me`, knighted, named `name`.
fn me_of(h: u8, name: Text) -> Me {
    Me {
        signed_in: true,
        name: String::from(name),
        fixed: true,
        rerolls: 0,
        must_add_passkey: false,
        handle: Vec::from([h; 16]),
    }
}

@test
fn another_account_signed_in_keeps_nothing_of_the_one_before() {
    var a = new("wrela.dev", online: true)
    a.connected = true
    a.game = Some(
        GameLink {
            surface: 1,
            id: String::from("capybara"),
            call: None,
            token: Vec::new(),
            token_at: 0.0,
            asking: false,
            uploading: false,
            waiting_token: false,
            answer: Answer::Nothing,
        },
    )
    // A new account, its codes still to save, posting its best runs, its game's token given.
    identify(mut a, me_of(1, "Sir Wobblesnout the Unhurried"))
    a.codes.push(String::from("CODE-1"))
    let was = a.epoch
    assert(posting_answered(mut a, Reply::Posting { agreed: true, best_runs: true }))
    match mut a.game {
        Some(g) => g.token = Vec::from([7; 48]),
        None => {},
    }
    let first = linked(a)
    assert(first.post_best && first.save_codes && !first.id.is_empty(), "the first's")
    // From "Sign in again first", another account's passkey: it agreed, but posts nothing alone.
    identify(mut a, me_of(2, "Dame Puddlefoot"))
    let l = linked(a)
    assert(!l.posting_known && !l.may_post && !l.post_best, "its choices not yet known")
    assert(!l.save_codes && l.token.is_empty() && l.id != first.id, "nothing of the first's")
    assert(wants_posting(a, a.time), "its choices asked for")
    // What was asked for the first is dropped as it comes; the game's own asks aren't.
    assert(!keeps(a, Purpose::Posting, was) && !keeps(a, Purpose::Other, was))
    assert(!keeps(a, Purpose::GameConsent, was) && keeps(a, Purpose::Game, was))
    assert(keeps(a, Purpose::Posting, a.epoch))
    assert(posting_answered(mut a, Reply::Posting { agreed: true, best_runs: false }))
    let l = linked(a)
    assert(l.posting_known && l.may_post && !l.post_best, "its own choices")
    // The same account again (a fresh sign-in) keeps what it had.
    identify(mut a, me_of(2, "Dame Puddlefoot"))
    assert(linked(a).posting_known && keeps(a, Purpose::Posting, a.epoch), "the same account")
}

@test
fn a_game_handing_its_call_back_is_called_again_with_the_account_heard_of_since() {
    var a = new("wrela.dev", online: true)
    // The game's call went before the console knew whose session it is: signed out.
    let held = linked(a)
    assert(!held.signed_in && !held.posting_known)
    // The session comes late, then its choices of posting, later still.
    a.connected = true
    identify(mut a, me_of(1, "Sir Wobblesnout the Unhurried"))
    assert(posting_answered(mut a, Reply::Posting { agreed: true, best_runs: true }))
    // The game hands its call back with nothing to ask: answered at once, with no request, and
    // the next call carries the account as it is now.
    let Some(back) = from_game(save(platform::link::FromGame { ask: Ask::Nothing })) else {
        panic("an ask")
    }
    let Some(Answer::Nothing) = answer_now(a.me, a.online, a.connected, back.clone()) else {
        panic("answered at once")
    }
    let Some(Answer::Nothing) = answer_now(a.me, a.online, connected: false, ask: back) else {
        panic("offline too")
    }
    let now = linked(a)
    assert(now.signed_in && now.posting_known && now.may_post && now.post_best, "as it is now")
}

@test
fn a_name_with_no_place_on_a_board_is_said_so_to_the_game() {
    let Answer::Unplaced = game_answer(
        Reply::Unplaced,
        course: 0,
        category: 0,
        uploading: false,
    ) else {
        panic("no place, said")
    }
    let Answer::Board { course, category, .. } = game_answer(
        Reply::Board { places: Vec::new(), total: 0, next: Vec::new() },
        course: 3,
        category: 1,
        uploading: false,
    ) else {
        panic("a board")
    }
    assert(course == 3 && category == 1, "the board asked for")
}

@test
fn an_upload_that_cant_be_taken_now_is_tried_again_and_a_rejected_one_isnt() {
    let busy = Reply::Refused { why: String::from("The boards are busy.") }
    let Answer::Failed { retry_after, .. } = game_answer(
        busy.clone(),
        course: 0,
        category: 0,
        uploading: true,
    ) else {
        panic("tried again")
    }
    assert(retry_after == u32(RETRY))
    let Answer::Rejected { .. } = game_answer(
        Reply::Rejected { why: String::from("That run's time doesn't match its moves.") },
        course: 0,
        category: 0,
        uploading: true,
    ) else {
        panic("for good")
    }
    // Another ask's refusal is said for the person (a search too wide, say).
    let Answer::Rejected { .. } = game_answer(busy, course: 0, category: 0, uploading: false) else {
        panic("said")
    }
}

/// The node of `a`'s tree whose role is `role` and whose name is `label`: its number.
fn node_of(a: Accounts, role: Role, label: Text) -> u32 {
    for n in a.nodes {
        if n.role == role && n.label.as_str() == label {
            return n.id
        }
    }
    0
}

@test
fn the_agreement_is_a_tree_of_boxes_links_and_buttons_a_screen_reader_can_use() {
    var a = new("wrela.dev", online: true)
    a.connected = true
    a.open = true
    a.page = Page::Create
    let fonts = Fonts::load()
    var d = DrawList::new()
    d.clear(vec2(1280.0, 720.0))
    draw(mut a, mut d, fonts, w: 1280.0, h: 720.0, margin: 24.0, zoom: 1.0, reduced: true)
    assert(a.nodes[0].role == Role::Dialog && a.nodes[0].label.as_str() == "Create account")
    let agree = node_of(a, Role::Checkbox, "I agree to the Terms and the Privacy Policy")
    let of_age = node_of(a, Role::Checkbox, "I'm 13 or older")
    let create = node_of(a, Role::Button, "Create account")
    assert(agree != 0 && of_age != 0 && create != 0, "named boxes and the button")
    assert(node_of(a, Role::Link, "Terms") != 0 && node_of(a, Role::Link, "Privacy Policy") != 0)
    assert(!a.nodes[agree - 1].checked && a.nodes[create - 1].disabled, "unticked, can't press")
    assert(std::semantics::problem(a.nodes).is_none(), "a tree the host takes")
    // Pressed by a screen reader, each box acts as a click does; ticked, the button can be pressed.
    let Some(Act::Agree) = assisted(mut a, agree, Assist::Activate) else { panic("the box") }
    let Some(Act::Legal { page }) = assisted(
        mut a,
        node_of(a, Role::Link, "Privacy Policy"),
        Assist::Activate,
    ) else {
        panic("the link")
    }
    assert(page == legal::PRIVACY)
    let _ = assisted(mut a, of_age, Assist::Focus)
    assert(a.shown[a.focus].0 == Act::OfAge, "its focus, the console's")
    let Some(Act::Back) = assisted(mut a, 1, Assist::Dismiss) else { panic("dismissed") }
    a.agree = true
    a.of_age = true
    draw(mut a, mut d, fonts, w: 1280.0, h: 720.0, margin: 24.0, zoom: 1.0, reduced: true)
    assert(a.nodes[agree - 1].checked && !a.nodes[create - 1].disabled, "ticked, can press")
    // The text of what posting shares, before the setting is first turned on.
    a.page = Page::Posting
    draw(mut a, mut d, fonts, w: 1280.0, h: 720.0, margin: 24.0, zoom: 1.0, reduced: true)
    assert(node_of(a, Role::Text, posting::NEVER) != 0 && node_of(a, Role::Button, "Agree") != 0)
}

@test
fn a_press_that_sends_a_request_sends_it_once_until_its_answer_comes() {
    for x in [Act::Keep, Act::Reroll, Act::NewCodes, Act::SignIn, Act::ConfirmDelete] {
        var a = new("wrela.dev", online: true)
        a.me = me_of(1, "Sir Wobblesnout the Unhurried")
        assert(press(mut a, x) && a.doing == Some(x), "the first goes")
        assert(!press(mut a, x), "the second sends nothing")
        // Its answer comes (`replied`, which does IO a test can't).
        a.busy = false
        assert(press(mut a, x), "again once answered")
    }
    var a = new("wrela.dev", online: true)
    assert(press(mut a, Act::Agree) && press(mut a, Act::Agree) && !a.busy, "a box sends nothing")
}

@test
fn an_account_click_must_begin_and_end_on_the_same_control() {
    var a = new("wrela.dev", online: true)
    a.open = true
    a.page = Page::Create
    a.sheet_at = Rect::new(x: 0.0, y: 0.0, w: 300.0, h: 300.0)
    a.shown.push((Act::Agree, Rect::new(x: 10.0, y: 10.0, w: 80.0, h: 30.0)))
    a.shown.push((Act::OfAge, Rect::new(x: 10.0, y: 60.0, w: 80.0, h: 30.0)))
    assert(released(mut a, vec2(20.0, 20.0), zoom: 1.0).is_none(), "no preceding press")
    a.pressed = Some(Act::Agree)
    assert(released(mut a, vec2(20.0, 70.0), zoom: 1.0).is_none(), "dragged to another box")
    a.pressed = Some(Act::Agree)
    assert(released(mut a, vec2(20.0, 20.0), zoom: 1.0) == Some(Act::Agree), "one click")
    assert(released(mut a, vec2(20.0, 20.0), zoom: 1.0).is_none(), "consumed once")
}

@test
fn background_and_stale_replies_cannot_unlock_an_account_action() {
    var a = new("wrela.dev", online: true)
    let startup = request_started(mut a, Request::Me, Purpose::Other)
    let posting = request_started(mut a, Request::Posting, Purpose::Posting)
    assert(press(mut a, Act::SignIn))
    let begin = Request::Begin { ceremony: SIGN_IN, csrf: Vec::new(), agreed: NOT_AGREED }
    let signing_in = request_started(mut a, begin, Purpose::Other)
    request_finished(mut a, startup)
    assert(!press(mut a, Act::SignIn), "the startup read does not finish sign-in")
    request_finished(mut a, posting)
    assert(!press(mut a, Act::SignIn), "posting's background read does not finish sign-in")
    let game = request_started(
        mut a,
        Request::Board {
            game: String::from("mmo"),
            course: 0,
            category: 0,
            from: 0,
            after: Vec::new(),
        },
        Purpose::Game,
    )
    request_finished(mut a, game)
    assert(!press(mut a, Act::SignIn), "a game's background read does not finish sign-in")
    request_finished(mut a, signing_in)
    // A challenge starts the authenticator prompt; no HTTP request owns that stage.
    a.busy = true
    let token = request_started(mut a, Request::Token { game: String::from("mmo") }, Purpose::Token)
    request_finished(mut a, token)
    assert(!press(mut a, Act::SignIn), "a background token cannot dismiss the passkey prompt")
    // The prompt answered: its submission now owns the gate, until that request answers.
    let submission = request_started(
        mut a,
        Request::SignIn {
            challenge: Vec::new(),
            id: Vec::new(),
            client_data: Vec::new(),
            authenticator_data: Vec::new(),
            signature: Vec::new(),
            user: Vec::new(),
        },
        Purpose::Other,
    )
    request_finished(mut a, signing_in)
    assert(!press(mut a, Act::SignIn), "a stale earlier completion cannot release the submission")
    request_finished(mut a, submission)
    assert(press(mut a, Act::Keep), "the action's own answer releases the controls")
    let keeping = request_started(mut a, Request::Keep { csrf: Vec::new() }, Purpose::Name)
    let consent = request_started(
        mut a,
        Request::Consent {
            csrf: Vec::new(),
            version: posting::VERSION,
            best_runs: true,
        },
        Purpose::GameConsent,
    )
    request_finished(mut a, consent)
    assert(!press(mut a, Act::Keep), "a game's consent cannot release the name being saved")
    request_finished(mut a, keeping)
    assert(press(mut a, Act::Keep), "the name's own answer releases it")
}

@test
fn reduced_motion_knighting_actions_are_live_as_soon_as_they_are_shown() {
    var a = new("wrela.dev", online: true)
    a.open = true
    a.page = Page::Knighting
    a.knight_t = 0.0
    let fonts = Fonts::load()
    var d = DrawList::new()
    d.clear(vec2(1280.0, 720.0))
    draw(mut a, mut d, fonts, w: 1280.0, h: 720.0, margin: 24.0, zoom: 1.0, reduced: true)
    var keep: Option<vec2> = None
    for (x, r) in a.shown {
        if x == Act::Keep { keep = Some(vec2(r.x + r.w * 0.5, r.y + r.h * 0.5)) }
    }
    let Some(at) = keep else { panic("reduced motion shows Keep immediately") }
    assert(control_at(a, at) == Some(Act::Keep), "a displayed Keep button can be clicked")
    assert(!knighting(a), "keys, pads and accessibility share the same ready state")
    assert(!animating(a), "reduced motion need not keep the animation frame loop awake")
}

@test
fn a_new_session_for_the_same_account_refreshes_the_games_character() {
    var a = new("wrela.dev", online: true)
    identify(mut a, me_of(1, "Sir Wobblesnout the Unhurried"))
    keep_csrf(mut a, Vec::from([u8(1); 16]))
    let before = mmo::client::Account::who(a)
    keep_csrf(mut a, Vec::from([u8(2); 16]))
    let fresh = mmo::client::Account::who(a)
    assert(before != fresh, "the client must discard the old session's character and CSRF token")
    keep_csrf(mut a, Vec::from([u8(2); 16]))
    assert(mmo::client::Account::who(a) == fresh, "a repeated session read changes nothing")
}
