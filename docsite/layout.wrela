// A page laid out at a width: its text as pieces placed on lines, the shapes behind and between
// them (code's ground, rules, a table's lines), where its links are, where each heading is, and
// its parts for screen readers, in reading order. Positions are pixels from the page's top left;
// the program draws only what's on screen, from this. A block of code that builds a field
// (live.wrela) has a figure under it, where the field is drawn, and its numbers that the field
// reads are marked as numbers to drag.
use markdown::{BOLD, Block, CODE, ITALIC, Kind, LINK, MUTED, Run, TAG, plain}
use highlight::{Token, spans}
use theme::{
    BODY, CODE as CODE_SIZE, CODE_LEADING, H1, H2, H3, HEADING, LEAD, LEADING, Palette, SMALL,
    STATEMENT, hex,
}
use theme::BOLD as BOLD_WEIGHT
use ui::draw::Rect
use ui::text::{Face, Fonts}

/// Text placed on a line: its top left, face, size, colour and weight.
pub struct Piece: Clone {
    pub at: vec2,
    pub text: String,
    pub face: Face,
    pub size: f32,
    pub color: vec4,
    pub weight: f32,
    /// How wide it is, and the block it's in.
    pub w: f32,
    pub block: u32,
}

pub struct Shape: Copy {
    pub rect: Rect,
    pub color: vec4,
    pub radius: f32,
}

/// A link's place, and where it leads (a Markdown link's target).
pub struct Spot: Clone {
    pub rect: Rect,
    pub target: String,
}

/// What a screen reader reads, in order: a heading (its level), text, a link or code.
pub enum Role: Copy + Eq {
    Heading,
    Text,
    Link,
    Code,
}

pub struct Part: Clone {
    pub role: Role,
    pub level: u32,
    pub rect: Rect,
    pub label: String,
    /// A link's target.
    pub target: String,
}

/// A block of code: its ground, its text as written, for a copy of it, and its block.
pub struct Snippet: Clone {
    pub rect: Rect,
    pub text: String,
    pub block: u32,
}

/// A number in a block of code that builds a field: its piece, its block, and its bytes in the
/// block's code. A drag changes it, and the field drawn under the block with it.
pub struct Knob: Copy {
    pub piece: u32,
    pub block: u32,
    pub start: u32,
    pub end: u32,
}

/// The place under a block of code where the field it builds is drawn, and the block.
pub struct Figure: Copy {
    pub rect: Rect,
    pub block: u32,
}

/// A heading with an anchor under the page's title: the anchor, where the heading is, how tall its
/// first line is, and its words.
pub struct Title: Clone {
    pub anchor: String,
    pub rect: Rect,
    pub line: f32,
    pub label: String,
}

pub struct Laid: Clone {
    pub pieces: Vec<Piece>,
    pub shapes: Vec<Shape>,
    pub spots: Vec<Spot>,
    pub anchors: Vec<(String, f32)>,
    pub parts: Vec<Part>,
    pub snippets: Vec<Snippet>,
    pub titles: Vec<Title>,
    pub knobs: Vec<Knob>,
    pub figures: Vec<Figure>,
    pub height: f32,
    /// The block being laid out.
    block: u32,
    /// Whether each block is code, whose lines join with line breaks.
    code_blocks: Vec<bool>,
}

impl Laid {
    pub fn empty() -> Laid {
        Laid {
            pieces: Vec::new(),
            shapes: Vec::new(),
            spots: Vec::new(),
            anchors: Vec::new(),
            parts: Vec::new(),
            snippets: Vec::new(),
            titles: Vec::new(),
            knobs: Vec::new(),
            figures: Vec::new(),
            height: 0.0,
            block: 0,
            code_blocks: Vec::new(),
        }
    }

    /// The page as plain text, as it's read and copied: pieces on a line joined as they're set,
    /// a prose line's end a space, a code line's a line break, and a blank line between blocks;
    /// and where each piece starts in it.
    pub fn text(self) -> (String, Vec<u32>) {
        var out = String::new()
        var starts: Vec<u32> = Vec::new()
        for i in 0..self.pieces.len() {
            borrow p = self.pieces[i]
            if i > 0 {
                borrow q = self.pieces[i - 1]
                if p.block != q.block {
                    out.push_str("\n\n")
                } else if abs(p.at.y - q.at.y) > q.size * 0.5 {
                    out.push_str(if self.code_blocks[p.block] { "\n" } else { " " })
                } else {
                    // Gaps on a line: a space a space's width, at least one.
                    let gap = p.at.x - (q.at.x + q.w)
                    if gap > q.size * 0.12 {
                        let spaces = if self.code_blocks[p.block] {
                            max(u32(gap / (q.size * 0.6) + 0.5), 1)
                        } else { 1 }
                        for _ in 0..spaces { out.push_str(" ") }
                    }
                }
            }
            starts.push(out.len())
            out.push_str(p.text.as_str())
        }
        (take out, take starts)
    }

    /// The piece and the byte in it nearest `at`: on the line `at` is on, else the nearest line.
    pub fn place_at(self, fonts: Fonts, at: vec2) -> Option<(u32, u32)> {
        var best: Option<(u32, f32)> = None
        for i in 0..self.pieces.len() {
            borrow p = self.pieces[i]
            let top = p.at.y - p.size * 0.3
            let bottom = p.at.y + p.size * 1.35
            let dy = if at.y < top { top - at.y } else if at.y > bottom { at.y - bottom } else {
                0.0
            }
            let dx = if at.x < p.at.x { p.at.x - at.x } else if at.x > p.at.x + p.w {
                at.x - p.at.x - p.w
            } else { 0.0 }
            let d = dy * 1000.0 + dx
            let better = match best {
                Some((_, b)) => d < b,
                None => true,
            }
            if better { best = Some((i, d)) }
        }
        let Some((i, _)) = best else { return None }
        borrow p = self.pieces[i]
        let k = fonts.font(p.face).offset_at(p.text.as_str(), p.size, at.x - p.at.x)
        Some((i, k))
    }
}

/// Lays out `blocks` `width` pixels wide, `u` pixels to the CSS pixel. On a module's page
/// (`code_headings`), item headings are set in the code face, as the names they are. A page's
/// first paragraph, under its title, is its lead, set larger: it's the page's summary. A first
/// paragraph with no title above it (the front page's) is a statement, larger still.
pub fn lay_out(
    blocks: [Block],
    fonts: Fonts,
    width: f32,
    u: f32,
    code_headings: bool,
    p: Palette,
) -> Laid {
    var laid = Laid::empty()
    let measure = min(width, theme::MEASURE * u)
    // Code and tables, and an item's kind and source at the right of its name, run wider.
    let wide = min(width, theme::WIDE * u)
    var y = 0.0
    var previous = Kind::Rule
    var under_title = false
    // The last heading's last line: its top, where its words end, and its height.
    var heading_line = vec3(0.0)
    for k in 0..blocks.len() {
        borrow b = blocks[k]
        laid.block = k
        laid.code_blocks.push(b.kind == Kind::Code)
        match b.kind {
            Kind::Heading => {
                let (size, above, face) = match b.level {
                    1 => (H1, 0.0, Face::Sans),
                    2 => (H2, 44.0, if code_headings { Face::Mono } else { Face::Sans }),
                    // A module's items follow one another closely: each is a few lines.
                    3 => (H3, if code_headings { 24.0 } else { 30.0 }, if code_headings {
                        Face::Mono
                    } else { Face::Sans }),
                    _ => (BODY, 22.0, Face::Sans),
                }
                if k > 0 { y += above * u }
                laid.anchors.push((b.anchor.clone(), y))
                let s = if face == Face::Mono { size * 0.86 } else { size }
                let start = y
                let first = laid.pieces.len()
                let runs = if face == Face::Mono { b.runs.clone() } else { numbered(b.runs) }
                y = flow(
                    mut laid,
                    p,
                    fonts,
                    runs,
                    0.0,
                    y,
                    measure,
                    s * u,
                    1.25,
                    face,
                    hex(p.strong),
                    HEADING,
                )
                let line = s * u * 1.25
                var right = 0.0
                for i in first..laid.pieces.len() {
                    borrow piece = laid.pieces[i]
                    if piece.at.y >= laid.pieces[laid.pieces.len() - 1].at.y - 0.5 {
                        right = max(right, piece.at.x + piece.w)
                    }
                }
                heading_line = vec3(y - line, right, line)
                if b.level >= 2 && !b.anchor.is_empty() {
                    laid.titles.push(
                        Title {
                            anchor: b.anchor.clone(),
                            rect: Rect::new(0.0, start, measure, y - start),
                            line,
                            label: plain(b.runs),
                        },
                    )
                }
                laid.parts.push(
                    Part {
                        role: Role::Heading,
                        level: b.level,
                        rect: Rect::new(0.0, start, measure, y - start),
                        label: plain(b.runs),
                        target: String::new(),
                    },
                )
                y += (if b.level == 1 { 18.0 } else { 10.0 }) * u
            },
            Kind::Meta => {
                // An item's kind, then its source, small and quiet: at the right of its heading's
                // line where they fit beside its name, else under it.
                let size = 13.0 * u
                let line = size * 1.5
                let kind = b.runs[0].text.as_str()
                let source = b.runs[2].text.as_str()
                let kw = fonts.font(Face::Mono).measure(kind, size)
                let both = kw + 12.0 * u + fonts.font(Face::Mono).measure(source, size)
                let beside = previous == Kind::Heading && heading_line.y + 24.0 * u + both <= wide
                let x0 = if beside { wide - both } else { 0.0 }
                let top = if beside { heading_line.x + (heading_line.z - line) * 0.5 } else {
                    y - 4.0 * u
                }
                let _ = put(
                    mut laid,
                    fonts,
                    kind,
                    x0,
                    top,
                    line,
                    size,
                    Face::Mono,
                    size,
                    Face::Mono,
                    hex(p.field),
                    0.0,
                )
                let sx = x0 + kw + 12.0 * u
                let sw = put(
                    mut laid,
                    fonts,
                    source,
                    sx,
                    top,
                    line,
                    size,
                    Face::Mono,
                    size,
                    Face::Mono,
                    hex(p.quiet),
                    0.0,
                )
                // The export links the source to its line at the release's commit.
                let link = b.runs[2].link.as_str()
                let target = if link.is_empty() { f"source:{source}" } else { link.to_string() }
                laid.spots.push(Spot { rect: Rect::new(sx, top, sw, line), target: target.clone() })
                // A faint line under the source says it's a link.
                laid.shapes.push(
                    Shape {
                        rect: Rect::new(sx, top + line * 0.5 + size * 0.62, sw, max(1.0, u)),
                        color: hex(p.quiet, 0.45),
                        radius: 0.0,
                    },
                )
                laid.parts.push(
                    Part {
                        role: Role::Link,
                        level: 0,
                        rect: Rect::new(sx, top, sw, line),
                        label: f"{kind}, defined at {source}",
                        target,
                    },
                )
                if !beside { y = top + line + 8.0 * u }
            },
            Kind::Paragraph | Kind::Quote => {
                if k > 0 && previous != Kind::Heading { y += 4.0 * u }
                let indent = if b.kind == Kind::Quote { 18.0 * u } else { 0.0 }
                let start = y
                let statement = k == 0 && b.kind == Kind::Paragraph
                let lead = under_title && b.kind == Kind::Paragraph
                let color = if b.kind == Kind::Quote { hex(p.quiet) } else if statement {
                    hex(p.strong)
                } else { hex(p.text) }
                let (size, leading, weight) = if statement {
                    (STATEMENT, 1.4, HEADING)
                } else if lead { (LEAD, 1.6, 0.0) } else { (BODY, LEADING, 0.0) }
                y = flow(
                    mut laid,
                    p,
                    fonts,
                    b.runs,
                    indent,
                    y,
                    measure - indent,
                    size * u,
                    leading,
                    Face::Sans,
                    color,
                    weight,
                )
                if statement || lead { y += 10.0 * u }
                if b.kind == Kind::Quote {
                    laid.shapes.push(
                        Shape {
                            rect: Rect::new(0.0, start + 4.0 * u, 3.0 * u, y - start - 8.0 * u),
                            color: hex(p.field, 0.5),
                            radius: 1.5 * u,
                        },
                    )
                }
                text_part(mut laid, b, Rect::new(0.0, start, measure, y - start))
                y += 12.0 * u
            },
            Kind::Item => {
                let indent = (22.0 + 22.0 * f32(b.level)) * u
                let start = y
                let line = BODY * u * LEADING
                if b.number > 0 {
                    let label = f"{b.number}."
                    let w = fonts.font(Face::Sans).measure(label.as_str(), BODY * u)
                    let _ = put(
                        mut laid,
                        fonts,
                        label.as_str(),
                        indent - w - 8.0 * u,
                        y,
                        line,
                        BODY * u,
                        Face::Sans,
                        BODY * u,
                        Face::Sans,
                        hex(p.quiet),
                        0.0,
                    )
                } else {
                    let r = 2.5 * u
                    let cy = y + line * 0.5
                    laid.shapes.push(
                        Shape {
                            rect: Rect::new(indent - 12.0 * u - r, cy - r, 2.0 * r, 2.0 * r),
                            color: hex(p.quiet),
                            radius: r,
                        },
                    )
                }
                y = flow(
                    mut laid,
                    p,
                    fonts,
                    b.runs,
                    indent,
                    y,
                    measure - indent,
                    BODY * u,
                    LEADING,
                    Face::Sans,
                    hex(p.text),
                    0.0,
                )
                text_part(mut laid, b, Rect::new(indent, start, measure - indent, y - start))
                let next_item = k + 1 < blocks.len() && blocks[k + 1].kind == Kind::Item
                y += (if next_item { 4.0 } else { 14.0 }) * u
            },
            Kind::Code => {
                if k > 0 && previous != Kind::Heading && previous != Kind::Meta { y += 4.0 * u }
                let read = if b.lang.is_empty() || b.lang.as_str() == "wrela" {
                    live::read(b.code.as_str(), 0.0)
                } else { None }
                let knobs = match read {
                    Some(r) => r.knobs.clone(),
                    None => Vec::new(),
                }
                y = code(mut laid, p, fonts, b.code.as_str(), y, wide, u, knobs)
                if read.is_some() { y = figure(mut laid, p, fonts, y, wide, u) }
                y += 16.0 * u
            },
            Kind::Table => {
                y += 4.0 * u
                y = table(mut laid, p, fonts, b, y, wide, u)
                y += 18.0 * u
            },
            Kind::Rule => {
                y += 18.0 * u
                laid.shapes.push(
                    Shape {
                        rect: Rect::new(0.0, y, measure, max(1.0, u)),
                        color: hex(p.rule),
                        radius: 0.0,
                    },
                )
                y += 26.0 * u
            },
        }
        under_title = b.kind == Kind::Heading && b.level == 1
        previous = b.kind
    }
    laid.height = y
    take laid
}

/// A heading's runs with its section number (`6.15`, `6.`) apart from its words, to be set
/// quieter: the number says where the section is, the words what it is.
fn numbered(runs: [Run]) -> Vec<Run> {
    var out: Vec<Run> = Vec::new()
    if runs.is_empty() || runs[0].style != 0 {
        for r in runs { out.push(r.clone()) }
        return out
    }
    let t = runs[0].text.as_str()
    var k = 0
    while k < t.len() && ((t.byte(k) >= 48 && t.byte(k) <= 57) || t.byte(k) == 46) { k += 1 }
    if k == 0 || k >= t.len() || t.byte(k) != 32 {
        for r in runs { out.push(r.clone()) }
        return out
    }
    out.push(Run { text: t.slice(from: 0, to: k).to_string(), style: MUTED })
    out.push(Run { text: t.slice(from: k, to: t.len()).to_string(), style: 0 })
    for i in 1..runs.len() { out.push(runs[i].clone()) }
    out
}

/// A block's text, for a screen reader, and each of its links after it, where its words are: a
/// link takes the pointer only over its own words, so a press beside it selects text.
fn text_part(laid: mut Laid, b: Block, rect: Rect) {
    laid.parts.push(
        Part { role: Role::Text, level: 0, rect, label: plain(b.runs), target: String::new() },
    )
    // The block's links' places: the last spots placed, which lie in it.
    var first = laid.spots.len()
    while first > 0 && laid.spots[first - 1].rect.y >= rect.y - 0.5 { first -= 1 }
    var next = first
    for r in b.runs {
        if r.style & LINK == 0 { continue }
        // The run's words: its spots, one a line where it wraps, as one place.
        var at = rect
        var found = false
        while next < laid.spots.len() && !found {
            if laid.spots[next].target == r.link {
                at = laid.spots[next].rect
                found = true
                while next + 1 < laid.spots.len() && laid.spots[next + 1].target == r.link {
                    next += 1
                    borrow more = laid.spots[next].rect
                    let x = min(at.x, more.x)
                    let y = min(at.y, more.y)
                    at = Rect::new(
                        x,
                        y,
                        max(at.right(), more.right()) - x,
                        max(at.bottom(), more.bottom()) - y,
                    )
                }
            }
            next += 1
        }
        laid.parts.push(
            Part {
                role: Role::Link,
                level: 0,
                rect: at,
                label: r.text.clone(),
                target: r.link.clone(),
            },
        )
    }
}

/// Places `text` in `face` at `size`, at `x` on the line whose top is `y`, `line` pixels tall:
/// its baseline is the line's, which `line_face` at `line_size` sets. How wide it is.
fn put(
    laid: mut Laid,
    fonts: Fonts,
    text: str,
    x: f32,
    y: f32,
    line: f32,
    line_size: f32,
    line_face: Face,
    size: f32,
    face: Face,
    color: vec4,
    weight: f32,
) -> f32 {
    borrow lf = fonts.font(line_face)
    let content = (lf.ascender - lf.descender) * line_size
    let baseline = y + (line - content) * 0.5 + lf.ascender * line_size
    borrow f = fonts.font(face)
    let w = f.measure(text, size)
    laid.pieces.push(
        Piece {
            at: vec2(x, baseline - f.ascender * size),
            text: text.to_string(),
            face,
            size,
            color,
            weight,
            w,
            block: laid.block,
        },
    )
    w
}

/// Sets `runs` from `x`, `y` on lines `width` wide, wrapping at spaces: the styles of the runs
/// give each piece its face, colour and weight. The bottom of the last line.
fn flow(
    laid: mut Laid,
    p: Palette,
    fonts: Fonts,
    runs: [Run],
    x: f32,
    y: f32,
    width: f32,
    size: f32,
    leading: f32,
    face: Face,
    color: vec4,
    weight: f32,
) -> f32 {
    let line = size * leading
    var pen = x
    var top = y
    var any = false
    // The first piece this text places, and whether the last run placed was plain text, whose
    // last word may go down to the next line with a word glued to it.
    let first = laid.pieces.len()
    var last_plain = false
    // Whether what was placed last ends in a space: a word after it may start a line.
    var after_space = true
    for r in runs {
        let code = r.style & CODE != 0
        let tag = r.style & TAG != 0
        let f = if code || tag { Face::Mono } else { face }
        let fs = if tag { size * 0.74 } else if code && face == Face::Sans { size * 0.88 } else {
            size
        }
        let c = if r.style & MUTED != 0 || tag { hex(p.quiet) } else if r.style & LINK != 0 {
            hex(p.strong)
        } else if code { hex(p.text) } else if r.style & (BOLD | ITALIC) != 0 {
            hex(p.strong)
        } else { color }
        let wt = if r.style & BOLD != 0 { BOLD_WEIGHT } else { weight }
        let text = r.text.as_str()
        // Each word, with the spaces after it, goes where it fits.
        var seg = String::new()
        var seg_x = pen
        var i = 0
        while i < text.len() {
            var j = i
            while j < text.len() && text.byte(j) == 32 { j += 1 }
            var e = j
            while e < text.len() && text.byte(e) != 32 { e += 1 }
            let spaces = text.slice(i, j)
            let word = text.slice(j, e)
            let sw = fonts.font(f).measure(spaces, fs)
            let ww = fonts.font(f).measure(word, fs)
            // Punctuation glued to the word before it (`mut`, then `,`) stays on its line; a longer
            // word glued to another breaks with it.
            let glued = spaces.is_empty() && !after_space && pen > x && ww <= fs * 0.9
            if pen > x && pen + sw + ww > x + width && !word.is_empty() && !glued {
                // To the next line: what's gathered stays on this one, without the spaces. A word
                // that starts this run with no space after the last run's text (`(`, then
                // `take`) takes that run's last word down with it.
                var carried = 0.0
                if spaces.is_empty() && !after_space && seg.is_empty() && last_plain {
                    carried = carry_down(mut laid, fonts, first, x, line)
                }
                end_segment(
                    mut laid,
                    p,
                    fonts,
                    mut seg,
                    seg_x,
                    top,
                    line,
                    size,
                    face,
                    fs,
                    f,
                    c,
                    wt,
                    r,
                )
                top += line
                pen = x + carried
                seg_x = pen
                seg.push_str(word)
                pen += ww
            } else {
                if pen > x || any { seg.push_str(spaces) } else { seg_x = pen }
                if pen > x || any { pen += sw }
                if seg.is_empty() { seg_x = pen }
                seg.push_str(word)
                pen += ww
            }
            if !word.is_empty() { any = true }
            if !word.is_empty() { after_space = false } else if !spaces.is_empty() {
                after_space = true
            }
            i = e
        }
        end_segment(mut laid, p, fonts, mut seg, seg_x, top, line, size, face, fs, f, c, wt, r)
        last_plain = r.style & (CODE | LINK | TAG) == 0 && !r.text.as_str().ends_with(" ")
    }
    top + line
}

/// Moves the last word of the last piece placed since piece `first` to the start of the next line
/// (at `x`, `line` lower), and says how wide it is: 0 where that piece is one word that starts its
/// line, as moving it would leave its line empty.
fn carry_down(laid: mut Laid, fonts: Fonts, first: u32, x: f32, line: f32) -> f32 {
    if laid.pieces.len() <= first { return 0.0 }
    let k = laid.pieces.len() - 1
    let text = laid.pieces[k].text.clone()
    let t = text.as_str()
    var space = t.len()
    while space > 0 && t.byte(space - 1) != 32 { space -= 1 }
    if space == 0 {
        if laid.pieces[k].at.x <= x { return 0.0 }
        laid.pieces[k].at.x = x
        laid.pieces[k].at.y += line
        return laid.pieces[k].w
    }
    var piece = laid.pieces[k].clone()
    borrow font = fonts.font(piece.face)
    var keep = space
    while keep > 0 && t.byte(keep - 1) == 32 { keep -= 1 }
    laid.pieces[k].text = t.slice(from: 0, to: keep).to_string()
    laid.pieces[k].w = font.measure(t.slice(from: 0, to: keep), piece.size)
    piece.text = t.slice(from: space, to: t.len()).to_string()
    piece.w = font.measure(piece.text.as_str(), piece.size)
    piece.at.x = x
    piece.at.y += line
    let w = piece.w
    laid.pieces.push(take piece)
    w
}

/// Places a run's gathered words, with code's ground behind them and a link's line under them.
fn end_segment(
    laid: mut Laid,
    p: Palette,
    fonts: Fonts,
    seg: mut String,
    x: f32,
    top: f32,
    line: f32,
    line_size: f32,
    line_face: Face,
    size: f32,
    face: Face,
    color: vec4,
    weight: f32,
    r: Run,
) {
    // Spaces that end a line aren't drawn.
    let t = seg.as_str()
    var end = t.len()
    while end > 0 && t.byte(end - 1) == 32 { end -= 1 }
    if end == 0 {
        seg.clear()
        return
    }
    let text = t.slice(0, end).to_string()
    seg.clear()
    let w = put(
        mut laid,
        fonts,
        text.as_str(),
        x,
        top,
        line,
        line_size,
        line_face,
        size,
        face,
        color,
        weight,
    )
    if r.style & CODE != 0 && line_face == Face::Sans {
        let h = line * 0.78
        laid.shapes.push(
            Shape {
                rect: Rect::new(
                    x - 3.0 * size / 16.0,
                    top + (line - h) * 0.5,
                    w + 6.0 * size / 16.0,
                    h,
                ),
                color: hex(p.surface),
                radius: 3.0 * size / 16.0,
            },
        )
    }
    if r.style & LINK != 0 {
        let under = top + line * 0.5 + line_size * 0.62
        laid.shapes.push(
            Shape {
                rect: Rect::new(x, under, w, max(1.0, line_size / 16.0)),
                color: hex(p.field, 0.55),
                radius: 0.0,
            },
        )
        laid.spots.push(Spot { rect: Rect::new(x, top, w, line), target: r.link.clone() })
    }
}

/// A block of code on its ground, coloured by its tokens, its long lines wrapped under
/// themselves. The bottom of its ground.
fn code(
    laid: mut Laid,
    p: Palette,
    fonts: Fonts,
    text: str,
    y: f32,
    width: f32,
    u: f32,
    knobs: [(u32, u32)],
) -> f32 {
    let size = CODE_SIZE * u
    let line = size * CODE_LEADING
    let pad = 14.0 * u
    let start = y
    let shape = laid.shapes.len()
    laid.shapes.push(
        Shape { rect: Rect::new(0.0, y, width, 0.0), color: hex(p.surface), radius: 6.0 * u },
    )
    borrow mono = fonts.font(Face::Mono)
    let advance = max(mono.measure("M", size), 1.0)
    let columns = max(u32((width - 2.0 * pad) / advance), 20)
    var top = y + pad
    for (a, b) in text.lines() {
        let src = text.slice(a, b)
        var col = 0
        var x = pad
        for (s, e, token) in spans(src) {
            let color = match token {
                Token::Keyword => hex(p.keyword),
                Token::Type => hex(p.kind),
                Token::Text => hex(p.string),
                Token::Number => hex(p.number),
                Token::Comment => hex(p.comment),
                Token::Plain => hex(p.text),
            }
            // A span past the line's end goes on under it, indented: whole, where it fits on a line
            // of its own, so a name or a number isn't cut.
            let whole = char_count(src, s, e)
            if col > 4 && col + whole > columns && whole <= columns - 4 && token != Token::Comment {
                top += line
                col = 4
                x = pad + 4.0 * advance
            }
            var from = s
            while from < e {
                let room = columns - col
                var to = from
                var count = 0
                while to < e && count < room {
                    to = next_char(src, to)
                    count += 1
                }
                let piece = src.slice(from, to)
                // A number the field reads: in the field's light, over a dotted line.
                var knob = false
                if token == Token::Number {
                    for (ks, ke) in knobs {
                        if ks == a + from && ke == a + to { knob = true }
                    }
                }
                if knob {
                    laid.knobs.push(
                        Knob {
                            piece: laid.pieces.len(),
                            block: laid.block,
                            start: a + from,
                            end: a + to,
                        },
                    )
                    let w = f32(count) * advance
                    var dx = 0.0
                    while dx < w {
                        laid.shapes.push(
                            Shape {
                                rect: Rect::new(
                                    x + dx,
                                    top + line - 2.0 * u,
                                    min(2.0 * u, w - dx),
                                    max(1.0, u),
                                ),
                                color: hex(p.field, 0.8),
                                radius: 0.0,
                            },
                        )
                        dx += 4.0 * u
                    }
                }
                if !piece.trim().is_empty() {
                    let _ = put(
                        mut laid,
                        fonts,
                        piece,
                        x,
                        top,
                        line,
                        size,
                        Face::Mono,
                        size,
                        Face::Mono,
                        if knob { hex(p.field) } else { color },
                        0.0,
                    )
                }
                x += f32(count) * advance
                col += count
                from = to
                if from < e && col >= columns {
                    top += line
                    col = 4
                    x = pad + 4.0 * advance
                }
            }
        }
        top += line
    }
    let bottom = top + pad - line * 0.15
    laid.shapes[shape].rect.h = bottom - start
    laid.snippets.push(
        Snippet {
            rect: Rect::new(0.0, start, width, bottom - start),
            text: text.to_string(),
            block: laid.block,
        },
    )
    laid.parts.push(
        Part {
            role: Role::Code,
            level: 0,
            rect: Rect::new(0.0, start, width, bottom - start),
            label: text.to_string(),
            target: String::new(),
        },
    )
    bottom
}

/// How many characters `s` has from byte `a` to byte `b`.
fn char_count(s: str, a: u32, b: u32) -> u32 {
    var n = 0
    var i = a
    while i < b {
        i = next_char(s, i)
        n += 1
    }
    n
}

fn next_char(s: str, i: u32) -> u32 {
    var j = i + 1
    while j < s.len() && s.byte(j) >= 128 && s.byte(j) < 192 { j += 1 }
    j
}

/// The figure under a block of code that builds a field, `width` wide, and the words under it
/// that say what it is and how to move it. The bottom of those words.
fn figure(laid: mut Laid, p: Palette, fonts: Fonts, y: f32, width: f32, u: f32) -> f32 {
    let top = y + 10.0 * u
    // Wide, a short band; on a phone, nearly square, as a field turned by a finger needs room.
    let h = if width < 560.0 * u { max(width * 0.85, 220.0 * u) } else {
        clamp(width * 0.5, 220.0 * u, 380.0 * u)
    }
    laid.figures.push(Figure { rect: Rect::new(0.0, top, width, h), block: laid.block })
    let words = "The field this code builds, drawn live. Drag a number in the code to change it, drag the field to turn it, or choose what the compiler derives from it."
    let runs = Vec::from([Run { text: words.to_string(), style: 0, link: String::new() }])
    let under = top + h + 8.0 * u
    let bottom = flow(
        mut laid,
        p,
        fonts,
        runs,
        0.0,
        under,
        width,
        13.0 * u,
        1.5,
        Face::Sans,
        hex(p.quiet),
        0.0,
    )
    laid.parts.push(
        Part {
            role: Role::Text,
            level: 0,
            rect: Rect::new(0.0, top, width, bottom - top),
            label: words.to_string(),
            target: String::new(),
        },
    )
    bottom
}

/// A table: its columns as wide as their cells need, narrowed together to fit `width`, the header
/// row strong over a rule. The bottom of its last row.
fn table(laid: mut Laid, p: Palette, fonts: Fonts, b: Block, y: f32, width: f32, u: f32) -> f32 {
    let cols = max(b.columns, 1)
    let rows = b.cells.len() / cols
    let size = SMALL * u
    let pad = 10.0 * u
    // Each column's widest cell, on one line, and its longest word, which can't wrap.
    var natural: Vec<f32> = Vec::filled(cols, 0.0)
    var word: Vec<f32> = Vec::filled(cols, 0.0)
    for i in 0..b.cells.len() {
        let w = runs_width(fonts, b.cells[i], size) + 2.0 * pad
        let lw = longest_word(fonts, b.cells[i], size) + 2.0 * pad
        let c = i % cols
        if w > natural[c] { natural[c] = w }
        if lw > word[c] { word[c] = lw }
    }
    var total = 0.0
    for w in natural { total += w }
    // Narrowed together to fit, none narrower than a short word, unless the table can't fit then.
    let least = min(72.0 * u, width / f32(cols) * 0.6)
    var widths: Vec<f32> = Vec::filled(cols, 0.0)
    for c in 0..cols {
        widths[c] = if total <= width { natural[c] } else { max(natural[c] * width / total, least) }
    }
    // A column narrower than its longest word takes that width from the others, as far as they
    // keep theirs.
    var short = 0.0
    var spare = 0.0
    for c in 0..cols {
        let need = min(word[c], width * 0.45)
        if widths[c] < need {
            short += need - widths[c]
            widths[c] = need
        } else { spare += widths[c] - min(word[c], widths[c]) }
    }
    if short > 0.0 && spare > 0.0 {
        let k = min(short / spare, 1.0)
        for c in 0..cols {
            let need = min(word[c], width * 0.45)
            if widths[c] > need { widths[c] -= (widths[c] - need) * k }
        }
    }
    var sum = 0.0
    for w in widths { sum += w }
    if sum > width {
        for c in 0..cols { widths[c] = widths[c] * width / sum }
    }
    var top = y
    for r in 0..rows {
        var x = 0.0
        var bottom = top
        let header = r == 0
        for c in 0..cols {
            borrow cell = b.cells[r * cols + c]
            let color = if header { hex(p.strong) } else { hex(p.text) }
            let end = flow(
                mut laid,
                p,
                fonts,
                cell,
                x + pad,
                top + pad * 0.6,
                widths[c] - 2.0 * pad,
                size,
                1.5,
                Face::Sans,
                color,
                if header { BOLD_WEIGHT } else { 0.0 },
            )
            if end > bottom { bottom = end }
            x += widths[c]
        }
        bottom += pad * 0.6
        laid.shapes.push(Shape { rect: Rect::new(0.0, bottom, x, max(1.0, u)), color: if header {
            hex(p.quiet, 0.6)
        } else { hex(p.rule) }, radius: 0.0 })
        var label = String::new()
        for c in 0..cols {
            if c > 0 { label.push_str(", ") }
            label.push_str(plain(b.cells[r * cols + c]).as_str())
        }
        let rect = Rect::new(0.0, top, x, bottom - top)
        laid.parts.push(Part { role: Role::Text, level: 0, rect, label, target: String::new() })
        // Its cells' links after it, as a paragraph's are.
        for c in 0..cols {
            for run in b.cells[r * cols + c] {
                if run.style & LINK != 0 {
                    laid.parts.push(
                        Part {
                            role: Role::Link,
                            level: 0,
                            rect,
                            label: run.text.clone(),
                            target: run.link.clone(),
                        },
                    )
                }
            }
        }
        top = bottom
    }
    top
}

/// How wide runs are on one line.
fn runs_width(fonts: Fonts, runs: [Run], size: f32) -> f32 {
    var w = 0.0
    for r in runs {
        let code = r.style & CODE != 0
        let f = if code { Face::Mono } else { Face::Sans }
        w += fonts.font(f).measure(r.text.as_str(), if code { size * 0.88 } else { size })
    }
    w
}

/// How wide the widest word of runs is: a run's text between spaces.
fn longest_word(fonts: Fonts, runs: [Run], size: f32) -> f32 {
    var most = 0.0
    for r in runs {
        let code = r.style & CODE != 0
        let f = if code { Face::Mono } else { Face::Sans }
        let fs = if code { size * 0.88 } else { size }
        let t = r.text.as_str()
        var a = 0
        while a < t.len() {
            var e = a
            while e < t.len() && t.byte(e) != 32 { e += 1 }
            if e > a { most = max(most, fonts.font(f).measure(t.slice(from: a, to: e), fs)) }
            a = e + 1
        }
    }
    most
}

fn laid(src: str, width: f32) -> Laid {
    let fonts = Fonts::from_baked(brand::manrope::MANROPE, ui::text::MONO)
    let blocks = markdown::parse(src)
    lay_out(blocks, fonts, width, u: 1.0, code_headings: false, p: theme::DARK)
}

@test
fn prose_stays_within_its_measure_and_punctuation_stays_with_its_word() {
    let page = laid(
        "A paragraph long enough to wrap a few times in a narrow column, calling a `mut self` method doesn't repeat `mut`, because the name says what it does.",
        260.0,
    )
    var lines = 0
    var last = -1.0
    for p in page.pieces {
        // Glued punctuation may pass the edge by its own width; nothing else does.
        assert(p.at.x + p.w <= 260.0 + p.size * 0.9, f"`{p.text.as_str()}` ends at {p.at.x + p.w}")
        if p.at.x == 0.0 {
            let first = p.text.as_str().byte(0)
            assert(first != 44 && first != 46, f"a line starts with `{p.text.as_str()}`")
        }
        if p.at.y != last {
            lines += 1
            last = p.at.y
        }
    }
    assert(lines >= 4, f"{lines} lines")
}

@test
fn the_page_reads_as_text_in_order_and_its_headings_are_in_its_parts() {
    let page = laid(
        "# Title\n\nSome `code` here.\n\n## Next\n\n```wrela\nlet a = 1\nlet b = 2\n```\n",
        600.0,
    )
    let (text, starts) = page.text()
    assert(
        text.as_str() == "Title\n\nSome code here.\n\nNext\n\nlet a = 1\nlet b = 2",
        f"[{text.as_str()}]",
    )
    assert(starts.len() == page.pieces.len() && starts[0] == 0)
    // The headings' anchors, down the page.
    assert(page.anchors.len() == 2 && page.anchors[0].1 < page.anchors[1].1)
    let roles: Vec<Role> = Vec::from_fn(page.parts.len(), |i| page.parts[i].role)
    assert(roles == Vec::from([Role::Heading, Role::Text, Role::Heading, Role::Code]))
    assert(page.parts[2].level == 2)
    // A point on the first line finds a byte in the title.
    let fonts = Fonts::from_baked(brand::manrope::MANROPE, ui::text::MONO)
    let at = page.place_at(fonts, vec2(page.pieces[0].at.x + 2.0, page.pieces[0].at.y + 4.0))
    assert(at == Some((0, 0)))
}

@test
fn a_block_of_code_keeps_its_text_and_a_section_its_place_for_a_link() {
    let page = laid(
        "# Title\n\n## Values, copies and moves\n\nText.\n\n```wrela\nlet a = 1\n    a + 1\n```\n",
        600.0,
    )
    // The code as written, indent and all, over its ground.
    assert(page.snippets.len() == 1 && page.snippets[0].text.as_str() == "let a = 1\n    a + 1")
    let ground = page.snippets[0].rect
    assert(ground.w == 600.0 && ground.h > 40.0 && ground.y > page.anchors[1].1)
    // The section, not the page's title, has a place for a link to it, at its heading.
    assert(page.titles.len() == 1, f"{page.titles.len()} titles")
    borrow t = page.titles[0]
    assert(t.anchor.as_str() == "values-copies-and-moves" && t.rect.y == page.anchors[1].1)
    assert(t.label.as_str() == "Values, copies and moves" && t.line > 20.0 && t.rect.h >= t.line)
}

@test
fn a_link_takes_only_its_own_words() {
    let page = laid("Some words, then [a link](io.md) and [another](arena.md) after them.\n", 600.0)
    var links: Vec<Part> = Vec::new()
    for p in page.parts {
        if p.role == Role::Link { links.push(p.clone()) }
    }
    assert(links.len() == 2 && links[0].target.as_str() == "io.md", f"{links.len()} links")
    // Each over its own words, the first before the second, and neither the paragraph's width.
    assert(links[0].rect.x > 50.0 && links[0].rect.w < 80.0, f"{links[0].rect.x} {links[0].rect.w}")
    assert(links[1].rect.x > links[0].rect.right() && links[1].rect.h < 40.0)
}

@test
fn a_long_line_of_code_wraps_between_its_tokens() {
    // About 30 columns: the line wraps, and each name and number stays whole on a line.
    let page = laid(
        "```wrela\nlet cone = round_cone(vec3(), vec3(y: 1.0), r_top: 0.3, r_bottom: 0.125)\n```\n",
        260.0,
    )
    var lines = 0
    var last = -1.0
    for p in page.pieces {
        if p.at.y != last {
            lines += 1
            last = p.at.y
        }
    }
    assert(lines >= 3, f"{lines} lines")
    for want in ["round_cone", "r_bottom", "0.125", "0.3"] {
        var whole = false
        for p in page.pieces {
            if p.text.as_str() == want { whole = true }
        }
        assert(whole, want)
    }
}

@test
fn an_opening_parenthesis_goes_down_with_the_code_after_it() {
    // At every width, a piece that ends in `(` has what follows it on its line.
    var width = 150.0
    while width < 420.0 {
        let page = laid(
            "A consuming method on a named place is marked: a call that moves it out is written (`take builder.finish()`) and a short one too (`x.y()`).",
            width,
        )
        for i in 0..page.pieces.len() - 1 {
            borrow a = page.pieces[i]
            if a.text.as_str().ends_with("(") {
                assert(
                    abs(page.pieces[i + 1].at.y - a.at.y) < a.size * 0.5,
                    f"at {width}: `{a.text.as_str()}` ends a line before `{page.pieces[i + 1].text.as_str()}`",
                )
            }
        }
        width += 7.0
    }
}

@test
fn an_items_kind_and_source_sit_beside_its_heading_where_they_fit() {
    let fonts = Fonts::from_baked(brand::manrope::MANROPE, ui::text::MONO)
    let src = "## Arena::len\n\n`method` · [`compiler/std/arena.wrela:150`](https://x.dev/a#L150)\n\n```wrela\npub fn len(self) -> u32\n```\n"
    let page = lay_out(
        markdown::parse(src),
        fonts,
        680.0,
        u: 1.0,
        code_headings: true,
        p: theme::DARK,
    )
    var name_y = -1.0
    var kind_y = -2.0
    for piece in page.pieces {
        if piece.text.as_str() == "Arena::len" { name_y = piece.at.y }
        if piece.text.as_str() == "method" { kind_y = piece.at.y }
    }
    // Beside: on the name's line, give or take the faces' baselines.
    assert(abs(kind_y - name_y) < 6.0, f"{kind_y} against {name_y}")
    // Too narrow for both: under it.
    let narrow = lay_out(
        markdown::parse(src),
        fonts,
        260.0,
        u: 1.0,
        code_headings: true,
        p: theme::DARK,
    )
    for piece in narrow.pieces {
        if piece.text.as_str() == "Arena::len" { name_y = piece.at.y }
        if piece.text.as_str() == "method" { kind_y = piece.at.y }
    }
    assert(kind_y > name_y + 10.0, f"{kind_y} against {name_y}")
}

@test
fn a_table_narrows_to_its_width() {
    let page = laid(
        "| Rule | Tier |\n|---|---|\n| A rule long enough that it would run far past the edge of a phone's screen | T0 |\n",
        300.0,
    )
    for p in page.pieces {
        assert(p.at.x + p.w <= 300.0 + 2.0, f"`{p.text.as_str()}` ends at {p.at.x + p.w}")
    }
}

@test
fn a_table_column_keeps_its_longest_word() {
    let page = laid(
        "| Page | What it gives |\n|---|---|\n| [engine::impostor](engine/impostor.md) | Trees far away: impostors in the mid-distance and density volumes beyond, each cooked at load from a plant kind's near representation and lit as its leaf cards are, so the levels match. |\n",
        600.0,
    )
    // The name ends before the summary, on its line, starts.
    var name_end = 0.0
    var summary_start = 1000.0
    for p in page.pieces {
        if p.text.as_str() == "engine::impostor" { name_end = p.at.x + p.w }
        if p.text.as_str().starts_with("Trees") { summary_start = p.at.x }
    }
    assert(name_end > 0.0 && name_end < summary_start, f"{name_end} against {summary_start}")
}
