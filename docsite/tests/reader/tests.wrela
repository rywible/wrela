// The tool tests: the site's test build in `scratch/<name>/page`, the guide's export beside it
// (none of the export's files replacing the site's), served, and opened in Chrome at the site's
// test fragment, where a browser script runs; the page's result must be `ok`.

use docsite::scripts::READER
use std::tool::browser
use std::input::Key
use std::tool::browser::{Element, Match, Script, Until}
use std::tool::files
use std::tool::files::Kind
use std::tool::serve
use std::tool::toolchain

/// The site's test run: 900 frames, 1400 × 900.
const FRAGMENT: Text = "#test&frames=900&width=1400&height=900"

/// Where the exported docs' sources are.
const REPOSITORY: Text = "https://github.com/rywible/wrela"

/// The text of `path`, or empty if it isn't there.
fn text_of(path: str) -> String {
    let Ok(bytes) = files::read(path).wait() else { return String::new() }
    let Some(text) = String::from_utf8(take bytes) else { return String::new() }
    text
}

/// Copies every file under `from` to the same path under `to`, none already there.
fn copy_into(from: str, to: str) {
    var todo: Vec<(String, String)> = Vec::new()
    todo.push((String::from(from), String::from(to)))
    while todo.len() > 0 {
        let Some(pair) = todo.pop() else { break }
        let src = pair.0.clone()
        let dest = pair.1.clone()
        let Ok(entries) = files::list(src.as_str()).wait() else { panic(f"{src.as_str()} lists") }
        for k in 0..entries.len() {
            let e = entries[k].clone()
            let s = String::from(f"{src.as_str()}/{e.name.as_str()}")
            let d = String::from(f"{dest.as_str()}/{e.name.as_str()}")
            if e.kind == Kind::Dir {
                let _ = files::make_dirs(d.as_str()).wait()
                todo.push((take s, take d))
                continue
            }
            assert(
                files::stat(d.as_str()).wait().is_err(),
                f"the export's {d.as_str()} would replace the site's",
            )
            let Ok(held) = files::read_blob(s.as_str()).wait() else { panic(f"{s.as_str()} reads") }
            assert(files::write_blob(d.as_str(), held).wait().is_ok(), f"{d.as_str()} is written")
        }
    }
}

/// `scratch/<name>/page`: the site's test build, the guide's export beside it.
fn docs_page(name: str) -> String {
    let page = String::from(f"scratch/{name}/page")
    let export = String::from(f"scratch/{name}/export")
    var options = toolchain::options()
    options.testing = true
    let Ok(build) = toolchain::build("repo/docsite", page.as_str(), options).wait() else {
        panic("the build's request")
    }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the site builds")
    var packages: Vec<String> = Vec::new()
    packages.push(String::from("repo/docsite/tests/reader/guide"))
    let exported = toolchain::doc_export(packages, export.as_str(), REPOSITORY, "").wait()
    let Ok(pages) = exported else { panic("the guide exports") }
    assert(pages > 0, "the export wrote pages")
    copy_into(export.as_str(), page.as_str())
    page
}

/// The page at `page` served and opened in Chrome, `script` run there and then its end waited
/// for, which must be `ok`: why it failed, if it did.
fn run(page: str, script: take Script) -> Result<(), String> {
    let Ok(srv) = serve::start(page).wait() else { panic("the site's server starts") }
    let url = f"{srv.origin.as_str()}/{FRAGMENT}"
    let Ok(b) = browser::open(url.as_str(), width: 1400, height: 900).wait() else {
        panic("Chrome opens the site")
    }
    let ran = browser::run(b, take script.wait(Until::done(), timeout: 300.0), 330.0).wait()
    var outcome: Result<(), String> = Ok(())
    match ran {
        Ok(_) => {
            let Ok(result) = browser::results(b).wait() else { panic("the site's result") }
            match result {
                Some(said) => {
                    if said.as_str() != "ok" {
                        outcome = Err(said.clone())
                    }
                },
                None => outcome = Err(String::from("the site wrote no result")),
            }
        },
        Err(e) => outcome = Err(String::from(e.message())),
    }
    let _ = browser::close(b).wait()
    let _ = serve::close(srv.server).wait()
    outcome
}

/// In Chrome, the exported docs are real links: search finds an item, whose result opens its
/// page, which names the tab, has its items as an outline's links and its next page as a link,
/// which opens that page; a copy button and the page's copy reach the clipboard; an item links
/// to itself. No tree is refused.
@test(tool, read: [("repo", "../../..")], browser: true, budget: 600)
fn the_exported_docs_in_chrome_are_links_an_outline_and_titles() {
    let page = docs_page("docs-chrome")
    if let Err(why) = run(page.as_str(), READER.clone()) {
        panic(f"the browser run failed: {why.as_str()}")
    }
    let log = text_of(f"{page.as_str()}/results/log.txt")
    assert(log.as_str().find("isn't sent").is_none(), log.as_str())
}

/// The reader script's expectations are checked: with the outline it waits for changed (its
/// second item `wander`, not `walk`), the run fails, saying what the page had.
@test(tool, read: [("repo", "../../..")], browser: true, budget: 600)
fn the_docs_scripts_outline_is_an_expectation_that_fails_when_wrong() {
    let page = docs_page("docs-chrome-wrong")
    let result = "docs_guide::paths::walk: Walks n steps, and [STEPS] more."
    // The reader's steps up to its outline, which it waits for wrong, for 3 s.
    let wrong = Script::new()
        .wait(Until::title(Match::is("Wrela docs")), timeout: 30.0)
        .press(Key::Slash)
        .wait(Until::active("input"))
        .insert_text("walk")
        .wait(Until::count(Element::css("[role=option]").with_text(result), 1))
        .click(Element::css("[role=option]").with_text(result))
        .wait(
            Until::title(Match::is("docs_guide::paths | Wrela docs"))
                .and(Until::hash(Match::starts("#docs_guide/paths"))),
        )
        .wait(Until::texts("[aria-label=\"On this page\"] a", ["STEPS", "wander"]), timeout: 3.0)
    let Err(failed) = run(page.as_str(), take wrong) else { panic("a wrong outline passed") }
    assert(
        failed.as_str().find("wander").is_some() && failed.as_str().find("\"walk\"").is_some(),
        failed.as_str(),
    )
}
