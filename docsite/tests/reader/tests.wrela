// The tool tests: the site's test build in `scratch/<name>/page`, the guide's export beside it
// (none of the export's files replacing the site's), served, and opened in Chrome at the site's
// test fragment, where a browser script runs; the page's result must be `ok`.

use docsite::scripts::READER
use std::collections::{Box, Vec}
use std::string::String
use std::tool::answer
use std::tool::blob
use std::tool::browser
use std::input::Key
use std::tool::browser::{Element, Match, Script, Until}
use std::tool::files
use std::tool::files::Kind
use std::tool::serve
use std::tool::toolchain
use toolkit::wait::{done, wait}

/// The site's test run: 900 frames, 1400 × 900.
const FRAGMENT: Text = "#test&frames=900&width=1400&height=900"

/// Where the exported docs' sources are.
const REPOSITORY: Text = "https://github.com/rywible/wrela"

/// The text of `path`, or empty if it isn't there.
@job
fn text_of(path: take String) -> String {
    var r = wait(files::read(path.as_str()))
    while !r.ready() { yield }
    let Ok(bytes) = answer(r.polled()) else { return String::new() }
    let Some(text) = String::from_utf8(take bytes) else { return String::new() }
    text
}

/// Copies every file under `from` to the same path under `to`, none already there.
@job
fn copy_into(from: take String, to: take String) {
    var todo: Vec<(String, String)> = Vec::new()
    todo.push((take from, take to))
    while todo.len() > 0 {
        let Some(pair) = todo.pop() else { break }
        let src = pair.0.clone()
        let dest = pair.1.clone()
        var l = wait(files::list(src.as_str()))
        while !l.ready() { yield }
        let Ok(entries) = files::read_list(l.polled()) else { panic(f"{src.as_str()} lists") }
        for k in 0..entries.len() {
            let e = entries[k].clone()
            let s = String::from(f"{src.as_str()}/{e.name.as_str()}")
            let d = String::from(f"{dest.as_str()}/{e.name.as_str()}")
            if e.kind == Kind::Dir {
                var m = wait(files::make_dirs(d.as_str()))
                while !m.ready() { yield }
                todo.push((take s, take d))
                continue
            }
            var st = wait(files::stat(d.as_str()))
            while !st.ready() { yield }
            assert(
                answer(st.polled()).is_err(),
                f"the export's {d.as_str()} would replace the site's",
            )
            var r = wait(files::read_blob(s.as_str()))
            while !r.ready() { yield }
            let Ok(held) = blob::read_handle(r.polled()) else { panic(f"{s.as_str()} reads") }
            var w = wait(files::write_blob(d.as_str(), held))
            while !w.ready() { yield }
            assert(answer(w.polled()).is_ok(), f"{d.as_str()} is written")
        }
    }
}

/// `scratch/<name>/page`: the site's test build, the guide's export beside it.
@job
fn docs_page(name: take String) -> String {
    let page = String::from(f"scratch/{name.as_str()}/page")
    let export = String::from(f"scratch/{name.as_str()}/export")
    var options = toolchain::options()
    options.testing = true
    var b = wait(toolchain::build("repo/docsite", page.as_str(), options))
    while !b.ready() { yield }
    let Ok(build) = toolchain::read_built(b.polled()) else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the site builds")
    var packages: Vec<String> = Vec::new()
    packages.push(String::from("repo/docsite/tests/reader/guide"))
    var x = wait(toolchain::doc_export(packages, export.as_str(), REPOSITORY, ""))
    while !x.ready() { yield }
    let Ok(pages) = toolchain::read_exported(x.polled()) else { panic("the guide exports") }
    assert(pages > 0, "the export wrote pages")
    var c = Box::new(copy_into.start(take export, page.clone()))
    while done(c.get_mut().resume()).is_none() { yield }
    page
}

/// The page at `page` served and opened in Chrome, `script` run there and then its end waited
/// for, which must be `ok`: why it failed, if it did.
@job
fn run(page: take String, script: take Script) -> Result<(), String> {
    var s = wait(serve::start(page.as_str()))
    while !s.ready() { yield }
    let Ok(srv) = serve::read_started(s.polled()) else { panic("the site's server starts") }
    var o = wait(
        browser::open(f"{srv.origin.as_str()}/{FRAGMENT}".as_str(), width: 1400, height: 900),
    )
    while !o.ready() { yield }
    let Ok(b) = browser::read_opened(o.polled()) else { panic("Chrome opens the site") }
    var r = wait(browser::run(b, take script.wait(Until::done(), timeout: 300.0), 330.0))
    while !r.ready() { yield }
    var outcome: Result<(), String> = Ok(())
    match answer(r.polled()) {
        Ok(_) => {
            var d = wait(browser::results(b))
            while !d.ready() { yield }
            let Ok(result) = browser::read_attribute(d.polled()) else { panic("the site's result") }
            match result {
                Some(said) => {
                    if said.as_str() != "ok" {
                        outcome = Err(said.clone())
                    }
                },
                None => outcome = Err(String::from("the site wrote no result")),
            }
        },
        Err(e) => outcome = Err(String::from(e.message())),
    }
    var shut = wait(browser::close(b))
    while !shut.ready() { yield }
    var stop = wait(serve::close(srv.server))
    while !stop.ready() { yield }
    outcome
}

/// In Chrome, the exported docs are real links: search finds an item, whose result opens its
/// page, which names the tab, has its items as an outline's links and its next page as a link,
/// which opens that page; a copy button and the page's copy reach the clipboard; an item links
/// to itself. No tree is refused.
@test(tool, read: [("repo", "../../..")], browser: true, budget: 600)
@job
fn the_exported_docs_in_chrome_are_links_an_outline_and_titles() {
    var p = Box::new(docs_page.start(String::from("docs-chrome")))
    var built = done(p.get_mut().resume())
    while built.is_none() {
        yield
        built = done(p.get_mut().resume())
    }
    let page = (take built).unwrap()
    var r = Box::new(run.start(page.clone(), READER.clone()))
    var ran = done(r.get_mut().resume())
    while ran.is_none() {
        yield
        ran = done(r.get_mut().resume())
    }
    if let Err(why) = (take ran).unwrap() { panic(f"the browser run failed: {why.as_str()}") }
    var l = Box::new(text_of.start(String::from(f"{page.as_str()}/results/log.txt")))
    var read = done(l.get_mut().resume())
    while read.is_none() {
        yield
        read = done(l.get_mut().resume())
    }
    let log = (take read).unwrap()
    assert(log.as_str().find("isn't sent").is_none(), log.as_str())
}

/// The reader script's expectations are checked: with the outline it waits for changed (its
/// second item `wander`, not `walk`), the run fails, saying what the page had.
@test(tool, read: [("repo", "../../..")], browser: true, budget: 600)
@job
fn the_docs_scripts_outline_is_an_expectation_that_fails_when_wrong() {
    var p = Box::new(docs_page.start(String::from("docs-chrome-wrong")))
    var built = done(p.get_mut().resume())
    while built.is_none() {
        yield
        built = done(p.get_mut().resume())
    }
    let page = (take built).unwrap()
    let result = "docs_guide::paths::walk: Walks n steps, and [STEPS] more."
    // The reader's steps up to its outline, which it waits for wrong, for 3 s.
    let wrong = Script::new()
        .wait(Until::title(Match::is("Wrela docs")), timeout: 30.0)
        .press(Key::Slash)
        .wait(Until::active("input"))
        .insert_text("walk")
        .wait(Until::count(Element::css("[role=option]").with_text(result), 1))
        .click(Element::css("[role=option]").with_text(result))
        .wait(
            Until::title(Match::is("docs_guide::paths | Wrela docs"))
                .and(Until::hash(Match::starts("#docs_guide/paths"))),
        )
        .wait(Until::texts("[aria-label=\"On this page\"] a", ["STEPS", "wander"]), timeout: 3.0)
    var r = Box::new(run.start(take page, take wrong))
    var ran = done(r.get_mut().resume())
    while ran.is_none() {
        yield
        ran = done(r.get_mut().resume())
    }
    let Err(failed) = (take ran).unwrap() else { panic("a wrong outline passed") }
    assert(
        failed.as_str().find("wander").is_some() && failed.as_str().find("\"walk\"").is_some(),
        failed.as_str(),
    )
}
