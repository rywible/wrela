// The docs' index (`index.json`, which `wrela doc --export` writes): the pages, every public
// item with its page and anchor, and every section of the spec's prose. Search ranks items by
// their names and sections by their headings, then both by their words.
use std::json
use std::json::{Doc, Kind, TOP}

pub struct Page: Clone {
    /// Where its Markdown is, beside the index: `std/arena.md`.
    pub path: String,
    pub title: String,
    pub summary: String,
    /// `spec` or `module`.
    pub kind: String,
}

pub struct Item: Clone {
    /// `std::arena::Arena::push`.
    pub path: String,
    pub kind: String,
    pub summary: String,
    pub page: String,
    pub anchor: String,
    pub source: String,
    pub line: u32,
    /// The path's last name, and the path and summary in lowercase, for search.
    name: String,
    lower: String,
    words: String,
}

pub struct Section: Clone {
    pub page: String,
    pub anchor: String,
    /// The headings from the page's down to it, the last its own.
    pub title: String,
    /// What it says, in its first sentence.
    pub summary: String,
    heading: String,
    words: String,
}

pub struct Index: Clone {
    pub version: String,
    pub commit: String,
    pub repository: String,
    /// Where std's source is and its commit (`toolchain` in the index): a toolchain release's
    /// own repository. Empty in an index that doesn't say, whose std is the packages'.
    pub toolchain_repository: String,
    pub toolchain_commit: String,
    pub pages: Vec<Page>,
    pub items: Vec<Item>,
    pub sections: Vec<Section>,
}

/// One search result: an item's or a section's number, and how well it matched.
pub struct Hit: Copy + Eq {
    pub item: bool,
    pub at: u32,
    pub score: u32,
}

impl Index {
    pub fn empty() -> Index {
        Index {
            version: String::new(),
            commit: String::new(),
            repository: String::new(),
            toolchain_repository: String::new(),
            toolchain_commit: String::new(),
            pages: Vec::new(),
            items: Vec::new(),
            sections: Vec::new(),
        }
    }

    /// The index `bytes` hold, or why they aren't one.
    pub fn read(bytes: take Vec<u8>) -> Result<Index, String> {
        let Some(text) = String::from_utf8(take bytes) else {
            return Err(String::from("the index isn't UTF-8"))
        }
        let Some(doc) = json::parse(text.as_str()) else {
            return Err(String::from("the index isn't JSON"))
        }
        if doc.kind(TOP) != Kind::Obj { return Err(String::from("the index isn't an object")) }
        var index = Index::empty()
        index.version = field(doc, TOP, "version")
        index.commit = field(doc, TOP, "commit")
        index.repository = field(doc, TOP, "repository")
        if let Some(t) = doc.get(TOP, "toolchain") {
            index.toolchain_repository = field(doc, t, "repository")
            index.toolchain_commit = field(doc, t, "commit")
        }
        let Some(pages) = doc.get(TOP, "pages") else {
            return Err(String::from("the index has no pages"))
        }
        for p in elements(doc, pages) {
            index.pages.push(
                Page {
                    path: field(doc, p, "path"),
                    title: field(doc, p, "title"),
                    summary: field(doc, p, "summary"),
                    kind: field(doc, p, "kind"),
                },
            )
        }
        if let Some(items) = doc.get(TOP, "items") {
            for v in elements(doc, items) {
                let path = field(doc, v, "path")
                let summary = field(doc, v, "summary")
                let name = lower(last_name(path.as_str()))
                let lower_path = lower(path.as_str())
                let words = lower(summary.as_str())
                index.items.push(
                    Item {
                        path,
                        kind: field(doc, v, "kind"),
                        summary,
                        page: field(doc, v, "page"),
                        anchor: field(doc, v, "anchor"),
                        source: field(doc, v, "source"),
                        line: whole(doc, doc.get(v, "line")),
                        name,
                        lower: lower_path,
                        words,
                    },
                )
            }
        }
        if let Some(sections) = doc.get(TOP, "sections") {
            for v in elements(doc, sections) {
                var title = String::new()
                var heading = String::new()
                if let Some(h) = doc.get(v, "headings") {
                    for k in elements(doc, h) {
                        let words = doc.text(k).unwrap_or(String::new())
                        if !title.is_empty() { title.push_str(" › ") }
                        title.push_str(words.as_str())
                        heading = lower(words.as_str())
                    }
                }
                let text = field(doc, v, "text")
                index.sections.push(
                    Section {
                        page: field(doc, v, "page"),
                        anchor: field(doc, v, "anchor"),
                        title,
                        summary: first_sentence(text.as_str()),
                        heading,
                        words: lower(text.as_str()),
                    },
                )
            }
        }
        Ok(take index)
    }

    /// Where the source file `path` is on its repository, at `line`: std's (`compiler/std/`) on
    /// the toolchain's, a package's on the packages'. Empty if the index doesn't say.
    pub fn source_url(self, path: str, line: str) -> String {
        let std = path.starts_with("compiler/std/") && !self.toolchain_repository.is_empty()
        let repository = if std { self.toolchain_repository.clone() } else {
            self.repository.clone()
        }
        let commit = if std { self.toolchain_commit.clone() } else { self.commit.clone() }
        if repository.is_empty() || commit.is_empty() { return String::new() }
        f"{repository.as_str()}/blob/{commit.as_str()}/{path}#L{line}"
    }

    /// The page at `path`, if there is one.
    pub fn page(self, path: str) -> Option<u32> {
        for i in 0..self.pages.len() {
            if self.pages[i].path.as_str() == path { return Some(i) }
        }
        None
    }

    /// The best `most` matches for `query`: every word of it must be in an item's path or
    /// summary, or a section's headings or text. A name that is the word, starts with it or holds
    /// it ranks first, then a path that holds it, then the words around it.
    pub fn search(self, query: str, most: u32) -> Vec<Hit> {
        let q = lower(query)
        let words = q.as_str().split(" ")
        var hits: Vec<Hit> = Vec::new()
        for i in 0..self.items.len() {
            borrow it = self.items[i]
            var score = 0
            var all = true
            for (a, b) in words {
                let w = q.as_str().slice(a, b)
                if w.is_empty() { continue }
                let name = it.name.as_str()
                let s = if name == w { 1000 } else if name.starts_with(w) { 800 } else if name
                    .find(w)
                    .is_some() {
                    600
                } else if it.lower.as_str().find(w).is_some() { 400 } else if it.words
                    .as_str()
                    .find(w)
                    .is_some() {
                    150
                } else { 0 }
                if s == 0 { all = false }
                score += s
            }
            if all && score > 0 {
                // Of two as good, std's first, then the shorter path: `Arena` before
                // `ArenaMap::push`.
                let short = if it.lower.len() < 60 { 60 - it.lower.len() } else { 0 }
                let std = if it.lower.as_str().starts_with("std::") { 128 } else { 0 }
                hits.push(Hit { item: true, at: i, score: score * 256 + std + short })
            }
        }
        for i in 0..self.sections.len() {
            borrow sec = self.sections[i]
            var score = 0
            var all = true
            for (a, b) in words {
                let w = q.as_str().slice(a, b)
                if w.is_empty() { continue }
                let s = if sec.heading.as_str().find(w).is_some() { 500 } else if sec.words
                    .as_str()
                    .find(w)
                    .is_some() {
                    100
                } else { 0 }
                if s == 0 { all = false }
                score += s
            }
            if all && score > 0 { hits.push(Hit { item: false, at: i, score: score * 256 }) }
        }
        hits.sort_by(|a, b| a.score > b.score)
        hits.truncate(min(most, hits.len()))
        take hits
    }
}

/// An object's text for `key`; empty if it has none.
fn field(doc: Doc, n: u32, key: str) -> String {
    match doc.get(n, key) {
        Some(v) => doc.text(v).unwrap_or(String::new()),
        None => String::new(),
    }
}

/// List `n`'s elements; none if it isn't a list.
fn elements(doc: Doc, n: u32) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    for i in 0..doc.count(n) {
        if let Some(e) = doc.at(n, i) { out.push(e) }
    }
    take out
}

/// Number `n` as a whole number, if it is one that fits; else 0.
fn whole(doc: Doc, n: Option<u32>) -> u32 {
    let Some(v) = n else { return 0 }
    let Some(x) = doc.num(v) else { return 0 }
    if x < 0.0 || x > 4294967295.0 || floor(x) != x { return 0 }
    u32(x)
}

/// A path's last name: `push` of `std::arena::Arena::push`, `insert` of `Arena::insert`.
pub fn last_name(path: str) -> borrow str {
    var k = path.len()
    while k >= 2 && !(path.byte(k - 1) == 58 && path.byte(k - 2) == 58) { k -= 1 }
    if k < 2 { path } else { path.slice(k, path.len()) }
}

/// `text` with its ASCII capitals made small.
pub fn lower(text: str) -> String {
    var out = String::new()
    var i = 0
    while i < text.len() {
        let b = text.byte(i)
        if b >= 65 && b <= 90 {
            out.push_byte(b + 32)
            i += 1
        } else if b < 128 {
            out.push_byte(b)
            i += 1
        } else {
            let len = match text.char_at(i) {
                Some((_, len)) => len,
                None => 1,
            }
            out.push_str(text.slice(i, i + len))
            i += len
        }
    }
    take out
}

fn fixture() -> Index {
    let doc = "{\"version\": \"0.1.0\", \"commit\": \"abcdef1\", \"repository\": \"https://github.com/rywible/wrela\", \"toolchain\": {\"version\": \"0.1.0\", \"repository\": \"https://github.com/rywible/wrela-compiler\", \"commit\": \"1234567\"}, \"pages\": [{\"path\": \"std/arena.md\", \"title\": \"std::arena\", \"summary\": \"Arenas.\", \"kind\": \"module\"}], \"items\": [{\"path\": \"std::arena::ArenaMap::push\", \"kind\": \"method\", \"summary\": \"Adds a value.\", \"page\": \"std/arena.md\", \"anchor\": \"arenamap-push\", \"source\": \"compiler/std/arena.wrela\", \"line\": 300}, {\"path\": \"std::arena::Arena\", \"kind\": \"struct\", \"summary\": \"Values by handle.\", \"page\": \"std/arena.md\", \"anchor\": \"arena\", \"source\": \"compiler/std/arena.wrela\", \"line\": 12}, {\"path\": \"std::arena::Arena::push\", \"kind\": \"method\", \"summary\": \"Adds a value and gives its handle.\", \"page\": \"std/arena.md\", \"anchor\": \"arena-push\", \"source\": \"compiler/std/arena.wrela\", \"line\": 40}], \"sections\": [{\"page\": \"spec/language/6-memory.md\", \"anchor\": \"6-8-handles-and-arenas\", \"headings\": [\"6. Memory\", \"6.8 Handles and arenas\"], \"text\": \"**Arenas** hold values without a garbage\\ncollector. Each is a `Vec`.\\n\\nMore.\"}]}"
    match read_text(doc) {
        Ok(i) => i,
        Err(e) => panic(e.as_str()),
    }
}

/// The index text `t` holds, or why it isn't one.
fn read_text(t: str) -> Result<Index, String> {
    Index::read(Vec::from(String::from(t).as_bytes()))
}

/// Markdown's first sentence of prose, on one line, without its bold: the first line that isn't
/// code, a table or a heading, and those after it in its paragraph, to the first full stop that
/// ends a sentence.
fn first_sentence(text: str) -> String {
    var out = String::new()
    var fenced = false
    for (a, b) in text.lines() {
        let line = text.slice(a, b).trim()
        if line.starts_with("```") {
            fenced = !fenced
            continue
        }
        if fenced || line.starts_with("|") || line.starts_with("#") { continue }
        if line.is_empty() {
            if out.is_empty() { continue } else { break }
        }
        let skip = if line.starts_with("- ") { 2 } else { 0 }
        if !out.is_empty() { out.push_str(" ") }
        out.push_str(line.slice(from: skip, to: line.len()))
        if out.as_str().find(". ").is_some() { break }
    }
    let t = out.as_str()
    let end = match t.find(". ") {
        Some(k) => k + 1,
        None => t.len(),
    }
    var plain = String::new()
    var from = 0
    while from < end {
        let rest = t.slice(from: from, to: end)
        match rest.find("**") {
            Some(k) => {
                plain.push_str(rest.slice(from: 0, to: k))
                from += k + 2
            },
            None => {
                plain.push_str(rest)
                from = end
            },
        }
    }
    take plain
}

@test
fn the_index_reads_its_pages_items_and_sections() {
    let index = fixture()
    assert(index.commit.as_str() == "abcdef1" && index.pages.len() == 1 && index.items.len() == 3)
    assert(index.items[2].line == 40 && index.items[2].anchor.as_str() == "arena-push")
    assert(index.sections[0].title.as_str() == "6. Memory › 6.8 Handles and arenas")
    borrow summary = index.sections[0].summary
    assert(summary.as_str() == "Arenas hold values without a garbage collector.", summary.as_str())
    assert(index.page("std/arena.md") == Some(0) && index.page("nope.md").is_none())
}

@test
fn an_index_that_isnt_one_says_why_and_a_line_is_a_whole_number() {
    for (doc, why) in [
        ("{\"pages\": [", "the index isn't JSON"),
        ("[]", "the index isn't an object"),
        ("{}", "the index has no pages"),
    ] {
        match read_text(doc) {
            Ok(_) => assert(false, doc),
            Err(e) => assert(e.as_str() == why, e.as_str()),
        }
    }
    let Err(e) = Index::read(Vec::from([u8(123), u8(255), u8(125)])) else {
        assert(false, "bytes that aren't UTF-8 aren't an index")
        return
    }
    assert(e.as_str() == "the index isn't UTF-8", e.as_str())
    // A line that isn't a whole number a `u32` holds is none.
    let Ok(lines) = read_text(
        "{\"pages\": [], \"items\": [{\"path\": \"a\", \"line\": 7}, {\"path\": \"b\", \"line\": 2.5}, {\"path\": \"c\", \"line\": 4294967296}, {\"path\": \"d\"}]}",
    ) else {
        assert(false, "the items read")
        return
    }
    assert(lines.items.len() == 4 && lines.items[0].line == 7)
    for k in 1..4 { assert(lines.items[k].line == 0, lines.items[k].path.as_str()) }
}

@test
fn std_s_source_is_on_the_toolchain_s_repository_and_a_package_s_on_the_packages() {
    var index = fixture()
    let std = index.source_url("compiler/std/arena.wrela", "12")
    assert(
        std.as_str() ==
            "https://github.com/rywible/wrela-compiler/blob/1234567/compiler/std/arena.wrela#L12",
        std.as_str(),
    )
    let engine = index.source_url("engine/creature.wrela", "3")
    assert(
        engine.as_str() == "https://github.com/rywible/wrela/blob/abcdef1/engine/creature.wrela#L3",
    )
    index.toolchain_repository = String::new()
    let older = index.source_url("compiler/std/arena.wrela", "12")
    assert(
        older.as_str() ==
            "https://github.com/rywible/wrela/blob/abcdef1/compiler/std/arena.wrela#L12",
    )
    index.commit = String::new()
    assert(index.source_url("engine/creature.wrela", "3").is_empty())
}

@test
fn a_name_ranks_before_a_path_and_a_path_before_words() {
    let index = fixture()
    let hits = index.search("Arena", 10)
    // The struct named so, then a section whose heading holds it, then the methods by their
    // paths, the shorter first.
    assert(hits[0] == Hit { item: true, at: 1, score: hits[0].score })
    assert(hits.len() == 4)
    let push = index.search("push", 10)
    assert(push.len() == 2 && push[0].at == 2, "the shorter path first")
    // Every word must match: "arena collector" finds only the section.
    let both = index.search("arena collector", 10)
    assert(both.len() == 1 && !both[0].item)
    assert(index.search("zebra", 10).is_empty() && index.search("", 10).is_empty())
}
