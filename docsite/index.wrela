// The docs' index (`index.json`, which `wrela doc --export` writes): the pages, every public
// item with its page and anchor, and every section of the spec's prose. Search ranks items by
// their names and sections by their headings, then both by their words.
use json::{Json, Kind}

pub struct Page: Clone {
    /// Where its Markdown is, beside the index: `std/arena.md`.
    pub path: String,
    pub title: String,
    pub summary: String,
    /// `spec` or `module`.
    pub kind: String,
}

pub struct Item: Clone {
    /// `std::arena::Arena::push`.
    pub path: String,
    pub kind: String,
    pub summary: String,
    pub page: String,
    pub anchor: String,
    pub source: String,
    pub line: u32,
    /// The path's last name, and the path and summary in lowercase, for search.
    name: String,
    lower: String,
    words: String,
}

pub struct Section: Clone {
    pub page: String,
    pub anchor: String,
    /// The headings from the page's down to it, the last its own.
    pub title: String,
    /// What it says, in its first sentence.
    pub summary: String,
    heading: String,
    words: String,
}

pub struct Index: Clone {
    pub version: String,
    pub commit: String,
    pub repository: String,
    pub pages: Vec<Page>,
    pub items: Vec<Item>,
    pub sections: Vec<Section>,
}

/// One search result: an item's or a section's number, and how well it matched.
pub struct Hit: Copy + Eq {
    pub item: bool,
    pub at: u32,
    pub score: u32,
}

impl Index {
    pub fn empty() -> Index {
        Index {
            version: String::new(),
            commit: String::new(),
            repository: String::new(),
            pages: Vec::new(),
            items: Vec::new(),
            sections: Vec::new(),
        }
    }

    /// The index `bytes` holds, or why it isn't one.
    pub fn read(bytes: [u8]) -> Result<Index, String> {
        let json = Json::read(bytes)?
        let root = json.root
        if json.kind(root) != Kind::Object { return Err(String::from("the index isn't an object")) }
        var index = Index::empty()
        index.version = json.field(root, "version").to_string()
        index.commit = json.field(root, "commit").to_string()
        index.repository = json.field(root, "repository").to_string()
        let Some(pages) = json.get(root, "pages") else {
            return Err(String::from("the index has no pages"))
        }
        for i in 0..json.count(pages) {
            let p = json.at(pages, i)
            index.pages.push(
                Page {
                    path: json.field(p, "path").to_string(),
                    title: json.field(p, "title").to_string(),
                    summary: json.field(p, "summary").to_string(),
                    kind: json.field(p, "kind").to_string(),
                },
            )
        }
        if let Some(items) = json.get(root, "items") {
            for i in 0..json.count(items) {
                let v = json.at(items, i)
                let path = json.field(v, "path").to_string()
                let summary = json.field(v, "summary").to_string()
                let name = lower(last_name(path.as_str()))
                let lower_path = lower(path.as_str())
                let words = lower(summary.as_str())
                let line = match json.get(v, "line") {
                    Some(l) => json.whole(l).unwrap_or(0),
                    None => 0,
                }
                index.items.push(
                    Item {
                        path,
                        kind: json.field(v, "kind").to_string(),
                        summary,
                        page: json.field(v, "page").to_string(),
                        anchor: json.field(v, "anchor").to_string(),
                        source: json.field(v, "source").to_string(),
                        line,
                        name,
                        lower: lower_path,
                        words,
                    },
                )
            }
        }
        if let Some(sections) = json.get(root, "sections") {
            for i in 0..json.count(sections) {
                let v = json.at(sections, i)
                var title = String::new()
                var heading = String::new()
                if let Some(h) = json.get(v, "headings") {
                    for k in 0..json.count(h) {
                        if !title.is_empty() { title.push_str(" › ") }
                        title.push_str(json.text(json.at(h, k)))
                        if k + 1 == json.count(h) { heading = lower(json.text(json.at(h, k))) }
                    }
                }
                index.sections.push(
                    Section {
                        page: json.field(v, "page").to_string(),
                        anchor: json.field(v, "anchor").to_string(),
                        title,
                        summary: first_sentence(json.field(v, "text")),
                        heading,
                        words: lower(json.field(v, "text")),
                    },
                )
            }
        }
        Ok(take index)
    }

    /// The page at `path`, if there is one.
    pub fn page(self, path: str) -> Option<u32> {
        for i in 0..self.pages.len() {
            if self.pages[i].path.as_str() == path { return Some(i) }
        }
        None
    }

    /// The best `most` matches for `query`: every word of it must be in an item's path or
    /// summary, or a section's headings or text. A name that is the word, starts with it or holds
    /// it ranks first, then a path that holds it, then the words around it.
    pub fn search(self, query: str, most: u32) -> Vec<Hit> {
        let q = lower(query)
        let words = q.as_str().split(" ")
        var hits: Vec<Hit> = Vec::new()
        for i in 0..self.items.len() {
            borrow it = self.items[i]
            var score = 0
            var all = true
            for (a, b) in words {
                let w = q.as_str().slice(a, b)
                if w.is_empty() { continue }
                let name = it.name.as_str()
                let s = if name == w { 1000 } else if name.starts_with(w) { 800 } else if name
                    .find(w)
                    .is_some() {
                    600
                } else if it.lower.as_str().find(w).is_some() { 400 } else if it.words
                    .as_str()
                    .find(w)
                    .is_some() {
                    150
                } else { 0 }
                if s == 0 { all = false }
                score += s
            }
            if all && score > 0 {
                // Of two as good, std's first, then the shorter path: `Arena` before
                // `ArenaMap::push`.
                let short = if it.lower.len() < 60 { 60 - it.lower.len() } else { 0 }
                let std = if it.lower.as_str().starts_with("std::") { 128 } else { 0 }
                hits.push(Hit { item: true, at: i, score: score * 256 + std + short })
            }
        }
        for i in 0..self.sections.len() {
            borrow sec = self.sections[i]
            var score = 0
            var all = true
            for (a, b) in words {
                let w = q.as_str().slice(a, b)
                if w.is_empty() { continue }
                let s = if sec.heading.as_str().find(w).is_some() { 500 } else if sec.words
                    .as_str()
                    .find(w)
                    .is_some() {
                    100
                } else { 0 }
                if s == 0 { all = false }
                score += s
            }
            if all && score > 0 { hits.push(Hit { item: false, at: i, score: score * 256 }) }
        }
        hits.sort_by(|a, b| a.score > b.score)
        hits.truncate(min(most, hits.len()))
        take hits
    }
}

/// A path's last name: `push` of `std::arena::Arena::push`.
fn last_name(path: str) -> borrow str {
    match path.find("::") {
        None => path,
        Some(_) => {
            var k = path.len()
            while k >= 2 && !(path.byte(k - 1) == 58 && path.byte(k - 2) == 58) { k -= 1 }
            path.slice(k, path.len())
        },
    }
}

/// `text` with its ASCII capitals made small.
pub fn lower(text: str) -> String {
    var out = String::new()
    var i = 0
    while i < text.len() {
        let b = text.byte(i)
        if b >= 65 && b <= 90 {
            out.push_byte(b + 32)
            i += 1
        } else if b < 128 {
            out.push_byte(b)
            i += 1
        } else {
            let len = match text.char_at(i) {
                Some((_, len)) => len,
                None => 1,
            }
            out.push_str(text.slice(i, i + len))
            i += len
        }
    }
    take out
}

fn fixture() -> Index {
    let doc = "{\"version\": \"0.1.0\", \"commit\": \"abcdef1\", \"repository\": \"https://github.com/rywible/wrela\", \"pages\": [{\"path\": \"std/arena.md\", \"title\": \"std::arena\", \"summary\": \"Arenas.\", \"kind\": \"module\"}], \"items\": [{\"path\": \"std::arena::ArenaMap::push\", \"kind\": \"method\", \"summary\": \"Adds a value.\", \"page\": \"std/arena.md\", \"anchor\": \"arenamap-push\", \"source\": \"compiler/std/arena.wrela\", \"line\": 300}, {\"path\": \"std::arena::Arena\", \"kind\": \"struct\", \"summary\": \"Values by handle.\", \"page\": \"std/arena.md\", \"anchor\": \"arena\", \"source\": \"compiler/std/arena.wrela\", \"line\": 12}, {\"path\": \"std::arena::Arena::push\", \"kind\": \"method\", \"summary\": \"Adds a value and gives its handle.\", \"page\": \"std/arena.md\", \"anchor\": \"arena-push\", \"source\": \"compiler/std/arena.wrela\", \"line\": 40}], \"sections\": [{\"page\": \"spec/language/6-memory.md\", \"anchor\": \"6-8-handles-and-arenas\", \"headings\": [\"6. Memory\", \"6.8 Handles and arenas\"], \"text\": \"**Arenas** hold values without a garbage\\ncollector. Each is a `Vec`.\\n\\nMore.\"}]}"
    var bytes: Vec<u8> = Vec::new()
    for i in 0..doc.len() { bytes.push(doc.byte(i)) }
    match Index::read(bytes) {
        Ok(i) => i,
        Err(e) => panic(e.as_str()),
    }
}

/// Markdown's first sentence of prose, on one line, without its bold: the first line that isn't
/// code, a table or a heading, and those after it in its paragraph, to the first full stop that
/// ends a sentence.
fn first_sentence(text: str) -> String {
    var out = String::new()
    var fenced = false
    for (a, b) in text.lines() {
        let line = text.slice(a, b).trim()
        if line.starts_with("```") {
            fenced = !fenced
            continue
        }
        if fenced || line.starts_with("|") || line.starts_with("#") { continue }
        if line.is_empty() {
            if out.is_empty() { continue } else { break }
        }
        let skip = if line.starts_with("- ") { 2 } else { 0 }
        if !out.is_empty() { out.push_str(" ") }
        out.push_str(line.slice(from: skip, to: line.len()))
        if out.as_str().find(". ").is_some() { break }
    }
    let t = out.as_str()
    let end = match t.find(". ") {
        Some(k) => k + 1,
        None => t.len(),
    }
    var plain = String::new()
    var from = 0
    while from < end {
        let rest = t.slice(from: from, to: end)
        match rest.find("**") {
            Some(k) => {
                plain.push_str(rest.slice(from: 0, to: k))
                from += k + 2
            },
            None => {
                plain.push_str(rest)
                from = end
            },
        }
    }
    take plain
}

@test
fn the_index_reads_its_pages_items_and_sections() {
    let index = fixture()
    assert(index.commit.as_str() == "abcdef1" && index.pages.len() == 1 && index.items.len() == 3)
    assert(index.items[2].line == 40 && index.items[2].anchor.as_str() == "arena-push")
    assert(index.sections[0].title.as_str() == "6. Memory › 6.8 Handles and arenas")
    let summary = index.sections[0].summary.clone()
    assert(summary.as_str() == "Arenas hold values without a garbage collector.", summary.as_str())
    assert(index.page("std/arena.md") == Some(0) && index.page("nope.md").is_none())
}

@test
fn a_name_ranks_before_a_path_and_a_path_before_words() {
    let index = fixture()
    let hits = index.search("Arena", 10)
    // The struct named so, then a section whose heading holds it, then the methods by their
    // paths, the shorter first.
    assert(hits[0] == Hit { item: true, at: 1, score: hits[0].score })
    assert(hits.len() == 4)
    let push = index.search("push", 10)
    assert(push.len() == 2 && push[0].at == 2, "the shorter path first")
    // Every word must match: "arena collector" finds only the section.
    let both = index.search("arena collector", 10)
    assert(both.len() == 1 && !both[0].item)
    assert(index.search("zebra", 10).is_empty() && index.search("", 10).is_empty())
}
