// The docs' look: the console's dark only in the header band, and under it a page in the reader's
// colour scheme: a quiet slate with silver text, or paper with ink, each with the mark's light for
// its field and for links. Sizes are CSS pixels; the program multiplies them by the display's
// pixel ratio.

/// A colour from its sRGB hex, as the screen takes it.
pub fn hex(rgb: u32, alpha: f32 = 1.0) -> vec4 {
    vec4(
        f32((rgb >> 16) & 255) / 255.0,
        f32((rgb >> 8) & 255) / 255.0,
        f32(rgb & 255) / 255.0,
        alpha,
    )
}

/// The ground of the header band and of the mark's field, in either scheme.
pub const VOID: u32 = 0x000000

/// A scheme's colours: the page, code's ground and a table's lines; text, headings and what's
/// quieter; links and the mark's light; a selection and a chosen row; and code's tokens
/// (keywords, types, strings, numbers, comments; the rest is `text`). Every colour of text keeps
/// 4.5:1 or more against `page` and `surface`.
pub struct Palette: Copy + Eq {
    pub page: u32,
    pub surface: u32,
    pub rule: u32,
    pub text: u32,
    pub strong: u32,
    pub quiet: u32,
    pub field: u32,
    pub selection: u32,
    pub chosen: u32,
    pub keyword: u32,
    pub kind: u32,
    pub string: u32,
    pub number: u32,
    pub comment: u32,
}

pub const DARK: Palette = Palette {
    page: 0x15171B,
    surface: 0x1C1F24,
    rule: 0x262A31,
    text: 0xC9CED5,
    strong: 0xF1F3F5,
    quiet: 0x8B929C,
    field: 0xA9BCD0,
    selection: 0x4D6A8C,
    chosen: 0x262A31,
    keyword: 0xC3B6EE,
    kind: 0x9ACBE5,
    string: 0xD9C597,
    number: 0xE6AD8A,
    comment: 0x828A95,
}

pub const LIGHT: Palette = Palette {
    page: 0xF8F9FB,
    surface: 0xEEF0F3,
    rule: 0xDCE0E5,
    text: 0x2E333B,
    strong: 0x0D1015,
    quiet: 0x5B636E,
    field: 0x2D5B88,
