}

// The type scale and its leading.
pub const BODY: f32 = 16.0
pub const SMALL: f32 = 14.0
pub const CODE: f32 = 13.5
pub const H1: f32 = 32.0
pub const H2: f32 = 24.0
pub const H3: f32 = 19.0
/// A page's lead (its first paragraph, its summary).
pub const LEAD: f32 = 17.0
pub const LEADING: f32 = 1.75
pub const CODE_LEADING: f32 = 1.6

// How much the weight thickens a face's strokes (`Font::weight`): bold, headings, a page's title.
pub const BOLD: f32 = 0.016
pub const HEADING: f32 = 0.017
pub const TITLE: f32 = 0.024

// The layout: the header, the list of pages, the text's measure and the room around it, and the
// outline of the page at its right where the screen has room.
pub const HEADER: f32 = 56.0
pub const NAV: f32 = 264.0
pub const MEASURE: f32 = 700.0
pub const WIDE: f32 = 760.0
pub const GUTTER: f32 = 48.0
pub const RAIL: f32 = 220.0
/// Rounded corners: a control's, and a card's or a block of code's.
pub const ROUND: f32 = 6.0
pub const CARD: f32 = 10.0
