// The docs' look: neutral greys in the reader's colour scheme, near black with light text or white
// with dark text, as a plain and careful web page has, a hairline between the parts, and the mark's
// light for what's chosen. Sizes are CSS pixels; the program multiplies them by the display's
// pixel ratio.

/// A colour from its sRGB hex, as the screen takes it.
pub fn hex(rgb: u32, alpha: f32 = 1.0) -> vec4 {
    vec4(
        f32((rgb >> 16) & 255) / 255.0,
        f32((rgb >> 8) & 255) / 255.0,
        f32(rgb & 255) / 255.0,
        alpha,
    )
}

/// What dims the page under a dialog or the list of pages open over it.
pub const VOID: u32 = 0x000000

/// A scheme's colours: the page, a quiet ground (inline code, a row under the pointer, a key), a
/// block of code's ground and the hairlines between parts; text, headings and what's quieter; the
/// mark's light, a selection and a chosen row; and code's tokens (keywords, types, strings,
/// numbers, comments; the rest is `text`). Every colour of text keeps 4.5:1 or more against
/// `page`, `surface` and `code`.
pub struct Palette: Copy + Eq {
    pub page: u32,
    pub surface: u32,
    pub code: u32,
    pub rule: u32,
    pub text: u32,
    pub strong: u32,
    pub quiet: u32,
    pub field: u32,
    pub selection: u32,
    pub chosen: u32,
    pub keyword: u32,
    pub kind: u32,
    pub string: u32,
    pub number: u32,
    pub comment: u32,
    /// A live field's body, which its rim takes `field` over.
    pub figure: u32,
}

pub const DARK: Palette = Palette {
    page: 0x09090B,
    surface: 0x18181B,
    code: 0x111113,
    rule: 0x27272A,
    text: 0xD4D4D8,
    strong: 0xFAFAFA,
    quiet: 0xA1A1AA,
    field: 0xA9BCD0,
    selection: 0x3B82F6,
    chosen: 0x27272A,
    keyword: 0xC3B6EE,
    kind: 0x9ACBE5,
    string: 0xD9C597,
    number: 0xE6AD8A,
    comment: 0x8B8B94,
    figure: 0xC9CFD8,
}

pub const LIGHT: Palette = Palette {
    page: 0xFFFFFF,
    surface: 0xF4F4F5,
    code: 0xFAFAFA,
    rule: 0xE4E4E7,
    text: 0x3F3F46,
    strong: 0x09090B,
    quiet: 0x71717A,
    field: 0x2D5B88,
    selection: 0x3B82F6,
