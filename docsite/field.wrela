// The WRΞLA mark in the header, drawn from its field: each pixel takes the mark's exact distance,
// so its edges stay sharp at any size and pixel ratio.
use brand::facet::{CAP, MarkRun, mark_distance}
use std::gpu::{ClipPosition, Over, VertexIndex}

pub struct Vertex {
    pub position: ClipPosition,
    pub pixel: vec2,
}

@vertex
pub fn quad(v: VertexIndex, screen: vec2, rect: vec4) -> Vertex {
    let corners = [
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, 1.0),
        vec2(0.0, 1.0),
        vec2(1.0, 0.0),
        vec2(1.0, 1.0),
    ]
    let p = rect.xy + rect.zw * corners[v.index]
    Vertex {
        position: ClipPosition {
            position: vec4(p.x / screen.x * 2.0 - 1.0, 1.0 - p.y / screen.y * 2.0, 0.0, 1.0),
        },
        pixel: p,
    }
}

pub struct Look: Copy + GpuData {
    /// The mark's centre in pixels, pixels per em, and how many runs it has.
    pub centre: vec2,
    pub ems: f32,
    pub count: u32,
    /// The ground's colour, and the mark's.
    pub ground: vec4,
    pub ink: vec4,
}

@fragment
pub fn field(v: Vertex, runs: [MarkRun], look: Look) -> Over {
    let p = vec2(v.pixel.x - look.centre.x, look.centre.y - v.pixel.y) / look.ems +
        vec2(0.0, CAP * 0.5)
    var exact = 100.0
    for i in 0..look.count { exact = min(exact, mark_distance(p, runs[i])) }
    let ink = saturate(0.5 - exact * look.ems)
    Over { color: vec4(mix(look.ground.xyz, look.ink.xyz, ink), 1.0) }
}
