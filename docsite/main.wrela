// docs.wrela.dev: the reference docs that `wrela doc --export` writes, beside this program in its
// build, read here. A band of the console's dark holds the WRΞLA mark as a field; under it, the
// pages listed at the left and the page being read, laid out from its Markdown and drawn from
// quads, with its outline at the right where there's room and its neighbours under it. Search
// finds items by name and the spec's rules by their words. The page's address says where the
// reader is, so Back, Forward and links work as on any page, and Back returns to the place the
// reader left; its title names the tab. A block of code has a button that copies it, a section's
// heading a link to it, and a page a copy of its Markdown, for an agent. A block that builds a
// field has the field drawn live under it (live.wrela): its numbers drag, and the field turns.
//
// Each frame: the host's answers (the display, the index, a page, the address), the input, the
// layout if the page or the width changed, the drawing, then what the host is told: the pointer's
// shape and the page's parts for screen readers. A frame draws only when the picture changes or
// something on it moves: a page left open costs the GPU nothing.

use brand::facet
use brand::facet::MarkRun
use brand::manrope::MANROPE
use field::{Look, field, quad}
use index::{Hit, Index, lower}
use layout::{Laid, Role, lay_out}
use live::{
    BOUNDS, DISTANCE, GRADIENT, Read, SURFACE, Shown, View, bounds_view, read, shown, slice_point,
    slice_view, view, with_number,
}
use markdown::{Block, Kind, parse, plain}
use platform::host
use route::{Route, Target, follow}
use std::gpu::{
    GpuBuffer, Rgba8, Sampler, Texture, begin_pass, begin_screen_pass, buffer_of, draw, sampler,
    texture,
}
use std::input::{Assist, Button, Event, Key, events}
use std::io::{Pending, fetch}
use std::semantics
use std::semantics::{Field, FieldKind, Node, Sent}
use theme::{BODY, DARK, GUTTER, HEADER, LIGHT, MEASURE, NAV, Palette, RAIL, SMALL, VOID, WIDE, hex}
use ui::draw::{DrawList, Rect, Renderer}
use ui::text::{Face, Fonts, MONO, previous_cluster}

const MARK_RUNS: Vec<MarkRun> = facet::mark_runs()
const MARK_WIDTH: f32 = facet::mark_width()

/// How many results search shows, and how many pages are kept read.
const RESULTS: u32 = 10
const KEPT: u32 = 24
/// The semantic tree's numbers: the page's parts from 0, search's results from `RESULT_NODES`,
/// in their list; search's and find's boxes.
const RESULT_NODES: u32 = 1000000
const RESULT_LIST: u32 = 999997
const SEARCH_FIELD: u32 = 999998
const FIND_FIELD: u32 = 999999
/// The list of pages (its pages from `NAV_NODES`, in a group for each group from `NAV_GROUPS`,
/// whose title is a button from `NAV_BUTTONS` that opens or closes it), the outline, and the
/// links beside and under the page (from `EXTRA_NODES`).
const NAV_LIST: u32 = 999996
const OUTLINE: u32 = 999995
const NAV_NODES: u32 = 2000000
const EXTRA_NODES: u32 = 3000000
const NAV_GROUPS: u32 = 4000000
const NAV_BUTTONS: u32 = 5000000
/// The controls over the page: each block of code's copy button and each section's link.
const CONTROL_NODES: u32 = 6000000
/// How long a copy's result shows, in seconds.
const SAID: f32 = 1.6
/// Who holds a figure: a mouse, which turns and tilts it; a finger, until its first move says
/// which way it goes; a finger that turns it; a finger that scrolls the page past it.
const HELD_BY_MOUSE: u32 = 0
const FINGER_UNSURE: u32 = 1
const FINGER_TURNS: u32 = 2
const FINGER_SCROLLS: u32 = 3
/// How far a finger moves before its way counts, in CSS pixels.
const FINGER_SLOP: f32 = 10.0

/// A live field's numbers, as sliders.
const KNOB_NODES: u32 = 7000000
/// Each figure's tabs: its list, then a tab for each of its views.
const TAB_LISTS: u32 = 8000000
const TABS: u32 = 8500000

pub struct Docs {
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    mark: GpuBuffer<MarkRun>,
    environment: Option<Pending<u8>>,
    /// Device pixels to the CSS pixel, whether the system asks for less motion, and what the host
    /// can do; the screen's size when they were last asked for, as a new size may come with a new
    /// pixel ratio.
    u: f32,
    reduced: bool,
    capabilities: u32,
    asked: vec2,
    /// The page's colours: the reader's scheme, dark unless the system asks for light.
    p: Palette,
    index_load: Option<Pending<u8>>,
    index: Index,
    trouble: String,
    /// The address without its fragment, and the reader's place.
    address: Option<Pending<u8>>,
    changed: Option<Pending<u8>>,
    base: Option<String>,
    route: Route,
    /// Where the reader was on each address they left, newest last, so Back and Forward return
    /// there; and that place, for the page on its way.
    places: Vec<(String, f32)>,
    restore: Option<f32>,
    /// The page being read: its blocks and its Markdown, laid out at a width, and how far down it
    /// is scrolled.
    page_load: Option<Pending<u8>>,
    loading: String,
    pages: Vec<(String, Vec<Block>, String)>,
    blocks: Vec<Block>,
    markdown: String,
    /// Why the page shown couldn't be opened, if it couldn't: its page says what may be it, once
    /// the index is read.
    missed: String,
    shown: String,
    laid: Laid,
    laid_width: f32,
    scroll: f32,
    nav_scroll: f32,
    /// Where to scroll to once the page is laid out: a heading's anchor.
    seek: Option<String>,
    /// Where the page glides to, a little each frame: a key's scroll, or a place on the page
    /// being read.
    glide: Option<f32>,
    screen: vec2,
    pointer: vec2,
    time: f32,
    /// Search: whether it's open, what's typed, what it found and which is chosen.
    searching: bool,
    query: String,
    hits: Vec<Hit>,
    chosen: u32,
    pasting: Option<Pending<u8>>,
    /// On a narrow screen, whether the list of pages is open over the page.
    nav_open: bool,
    /// The groups whose pages the list shows: the language's at first, and each page's own once
    /// it's shown; a group's title opens or closes it.
    open: Vec<String>,
    /// The list's rows as last laid out, whether they need laying out again, and the list's width
    /// and pixel ratio they were laid out for.
    nav: Vec<NavRow>,
    nav_dirty: bool,
    nav_for: vec2,
    /// Whether the list of pages should bring the page being read into view: a new page was shown.
    nav_follow: bool,
    told: Vec<Pending<u8>>,
    cursor: String,
    tree: Sent,
    /// Whether the host's text mode is on, for search's or find's box.
    texting: bool,
    /// Search's and find's boxes, where the host keeps them as fields, and a read of one on its way.
    search_box: Kept,
    find_box: Kept,
    reading: Option<Pending<u8>>,
    /// The caret in what search or find has typed (a byte of it), and the other end of what's
    /// selected there (the caret's byte when nothing is).
    caret: u32,
    other_end: u32,
    /// The page as plain text, its lowercase for find, and where each piece starts in it.
    text: String,
    lowered: String,
    starts: Vec<u32>,
    /// A selection: where it began and where it ends, each a byte of `text`.
    selected: Option<(u32, u32)>,
    /// The pointer's press on the page: where, whether it has moved, and the link under it.
    press: Option<(vec2, bool, String)>,
    /// A press that scrolls rather than selects (a finger's, which didn't hover first): the
    /// scroll it began at, and whether it scrolls the list of pages rather than the page; where
    /// the finger was in its last moments, and when; and a swipe let go while moving, which
    /// carries on and slows (its speed in pixels a second, and whether it's the list's).
    swipe: Option<(f32, bool)>,
    trail: Vec<(f32, f32)>,
    fling: Option<(f32, bool)>,
    offered: String,
    /// Find on the page: whether it's open, what's typed, where it matches and which is current.
    finding: bool,
    find: String,
    matches: Vec<u32>,
    current: u32,
    /// A copy to the clipboard: on its way, what it copied (a control's target), and when it was
    /// done and whether it worked, which shows for a moment.
    copying: Option<Pending<u8>>,
    copied: String,
    copied_at: f32,
    copy_ok: bool,
    /// A scrollbar's thumb held: where the press was, the scroll then, and whether it's the list's.
    thumb: Option<(f32, f32, bool)>,
    /// Whether the picture changed since it was last drawn: an answer, input, a new size.
    dirty: bool,
    /// The scrolls the semantic tree was last told of, and when.
    told_at: (f32, f32, f32),
    owed: bool,
    /// The pointer's disc in the mark's field: where it is, following the pointer, and how much
    /// it joins, rising while the pointer is over the field.
    hover_at: vec2,
    hover: f32,
    /// When the page being read was shown: it comes in over a moment.
    shown_at: f32,
    /// Each live figure's field, in the page's order; each figure's image as last drawn; and how
    /// many times a field has changed, which numbers each change.
    lives: Vec<Live>,
    images: Vec<FigureImage>,
    linear: Sampler,
    changes: u32,
    /// A number held, to drag: its knob, where the press was and its value then.
    knob_held: Option<(u32, vec2, f32, bool)>,
    /// A figure held, to turn: its figure, where the press was, its turn and tilt then, and who
    /// holds it (`HELD_BY_MOUSE`, or a finger before and after it shows its way).
    orbit: Option<(u32, vec2, f32, f32, u32)>,
    /// Whether the last press was a finger's: no pointer hovers after it.
    finger: bool,
}

/// A live figure's field: its block, its code as the reader's drags have changed it, what it
/// builds, and the camera's turn and tilt about it.
struct Live: Clone {
    block: u32,
    code: String,
    read: Option<Read>,
    turn: f32,
    tilt: f32,
    /// What it shows (live.wrela's `SURFACE`, `DISTANCE`, `GRADIENT`, `BOUNDS`).
    mode: u32,
    /// Which change of its field this is: its image is drawn again when it changes.
    version: u32,
}

/// A figure's image: the field drawn into a texture, which the screen shows where the figure is,
/// and what it was drawn for. A page that scrolls moves the image; it's drawn again only when
/// what it shows changes, as raymarching a field every frame costs a phone's GPU dearly.
struct FigureImage {
    block: u32,
    image: Texture<Rgba8>,
    key: ImageKey,
}

/// What a figure's image shows: its field's change, the camera, its view, the probe, its size in
/// texels, and the scheme.
struct ImageKey: Copy + Eq {
    version: u32,
    turn: f32,
    tilt: f32,
    mode: u32,
    probe: vec4,
    w: u32,
    h: u32,
    light: bool,
}

/// A box the host keeps as a field (std::semantics): the newest revision heard of, the newest read,
/// and the replacements of its text asked for.
struct Kept: Clone + Eq {
    heard: u32 = 0,
    seen: u32 = 0,
    replace: u32 = 0,
}

pub fn init() -> Docs {
    var fonts = Fonts::from_baked(MANROPE, MONO)
    // Manrope set a touch closer: it's wide for long reading.
    fonts.sans.tracking = -0.005
    let renderer = Renderer::new(fonts)
    var told: Vec<Pending<u8>> = Vec::new()
    // The browser's find finds nothing in a canvas: this program has its own.
    told.push(host::claim_find(true))
    Docs {
        fonts,
        renderer,
        list: DrawList::new(),
        mark: buffer_of(MARK_RUNS),
        environment: Some(host::environment()),
        u: 1.0,
        reduced: false,
        capabilities: 0,
        asked: vec2(0.0),
        p: DARK,
        index_load: Some(fetch("index.json")),
        index: Index::empty(),
        trouble: String::new(),
        address: Some(host::address()),
        changed: None,
        base: None,
        route: Route::front(),
        places: Vec::new(),
        restore: None,
        page_load: None,
        loading: String::new(),
        pages: Vec::new(),
        blocks: Vec::new(),
        markdown: String::new(),
        missed: String::new(),
        shown: String::from("?"),
        laid: Laid::empty(),
        laid_width: 0.0,
        scroll: 0.0,
        nav_scroll: 0.0,
        seek: None,
        glide: None,
        screen: vec2(1.0),
        pointer: vec2(-1.0),
        time: 0.0,
        searching: false,
        query: String::new(),
        hits: Vec::new(),
        chosen: 0,
        pasting: None,
        nav_open: false,
        open: Vec::from([String::from("spec")]),
        nav: Vec::new(),
        nav_dirty: true,
        nav_for: vec2(0.0),
        nav_follow: false,
        told,
        cursor: String::from("default"),
        tree: Sent {},
        texting: false,
        search_box: Kept {},
        find_box: Kept {},
        reading: None,
        caret: 0,
        other_end: 0,
        text: String::new(),
        lowered: String::new(),
        starts: Vec::new(),
        selected: None,
        press: None,
        swipe: None,
        trail: Vec::new(),
        fling: None,
        offered: String::new(),
        finding: false,
        find: String::new(),
        matches: Vec::new(),
        current: 0,
        copying: None,
        copied: String::new(),
        copied_at: -10.0,
        copy_ok: false,
        thumb: None,
        dirty: true,
        told_at: (-1.0, -1.0, -10.0),
        owed: false,
        hover_at: vec2(-1000.0),
        hover: 0.0,
        shown_at: -10.0,
        lives: Vec::new(),
        images: Vec::new(),
        linear: sampler(),
        changes: 0,
        knob_held: None,
        orbit: None,
        finger: false,
    }
}

pub fn frame(s: mut Docs, time: f32, width: u32, height: u32) {
    // A new size clears the canvas.
    if vec2(f32(width), f32(height)) != s.screen { s.dirty = true }
    s.screen = vec2(f32(width), f32(height))
    let dt = clamp(time - s.time, 0.0, 0.1)
    s.time = time
    // A new size, as when the page is zoomed or moved to another display, may come with a new
    // pixel ratio: ask again.
    if s.screen != s.asked && s.environment.is_none() {
        s.environment = Some(host::environment())
        s.asked = s.screen
    }
    answers(mut s)
    let frame = frame_of(s)
    for e in events() {
        s.dirty = true
        handle(mut s, e, frame)
    }
    keep_laid_out(mut s, frame)
    keep_lives(mut s, frame)
    glide_on(mut s, frame, dt)
    fling_on(mut s, frame, dt)
    keep_hover(mut s, frame, dt)
    keep_nav(mut s, frame)
    let changed = s.dirty || moving(s, frame)
    if changed {
        draw_all(mut s, frame)
        s.dirty = false
    }
    tell(mut s, frame, changed)
}

/// How long a page takes to come in, in seconds.
const APPEAR: f32 = 0.22

/// Whether the pointer is over a field of the mark's: the header's band, or the front page's
/// opening: its disc joins there.
fn hover_target(s: Docs, f: Frame) -> f32 {
    let p = s.pointer
    // A finger lifts and leaves no pointer behind.
    if p.x < 0.0 || s.reduced || s.finger { return 0.0 }
    let band = p.y < f.header && !f.search.contains(p)
    let opening = s.route.page.is_empty() &&
        p.y >= f.header &&
        p.y < f.header + opening_height(s, f.beside) - s.scroll &&
        (f.beside && p.x >= f.nav || !f.beside)
    if band || opening { 1.0 } else { 0.0 }
}

/// The pointer's disc follows the pointer, and rises or falls, over a moment.
fn keep_hover(s: mut Docs, f: Frame, dt: f32) {
    let target = hover_target(s, f)
    let rise = 1.0 - exp(-dt * 6.0)
    s.hover = if abs(target - s.hover) < 0.002 { target } else {
        s.hover + (target - s.hover) * rise
    }
    if s.hover_at.x < -999.0 || s.hover < 0.002 { s.hover_at = s.pointer } else {
        s.hover_at = s.hover_at + (s.pointer - s.hover_at) * (1.0 - exp(-dt * 14.0))
    }
}

/// Whether something on the screen moves, so each frame draws: the front page's lines while
/// they're in view, search's or find's caret, the bar of a page on its way, a glide, a copy's
/// word while it shows (and the frame after), glyphs on their way. The lines, the caret and the
/// bar stay still when the system asks for less motion.
fn moving(s: Docs, f: Frame) -> bool {
    let opening = s.route.page.is_empty() && s.scroll < opening_height(s, f.beside)
    let lively = opening ||
        s.searching ||
        s.finding ||
        s.page_load.is_some() ||
        s.time - s.shown_at < APPEAR + 0.05 ||
        abs(s.hover - hover_target(s, f)) > 0.002 ||
        (s.hover > 0.001 && length(s.hover_at - s.pointer) > 0.3)
    (lively && !s.reduced) ||
        (live_moves(s, f) && !s.reduced) ||
        s.glide.is_some() ||
        s.fling.is_some() ||
        s.time - s.copied_at < SAID + 0.25 ||
        s.renderer.waiting()
}

/// Where everything goes on this screen.
pub struct Frame: Copy {
    header: f32,
    /// The list of pages: its width, and whether it shows beside the page.
    nav: f32,
    beside: bool,
    /// The page's text: its left, its width, and where its top is (the front page's opening
    /// above it).
    x: f32,
    w: f32,
    top: f32,
    /// The search box.
    search: Rect,
    /// The page's outline, at the right of its text where the screen has room (else empty).
    rail: Rect,
}

fn frame_of(s: Docs) -> Frame {
    let u = s.u
    let header = HEADER * u
    let beside = s.screen.x >= 960.0 * u
    let nav = if beside { NAV * u } else { min(NAV * u, s.screen.x * 0.85) }
    let left = if beside { nav } else { 0.0 }
    let gutter = if beside { GUTTER * u } else { 20.0 * u }
    // A page has its outline at its right when the text keeps its measure beside it.
    let rail_w = RAIL * u
    let rail_gap = 40.0 * u
    let room = s.screen.x - left - 2.0 * gutter - rail_w - rail_gap
    let outlined = beside && !s.route.page.is_empty() && room >= MEASURE * u
    let w = if outlined { min(WIDE * u, room) } else {
        max(min(WIDE * u, s.screen.x - left - 2.0 * gutter), 120.0 * u)
    }
    // The text and its outline sit in the middle of the room right of the list, so a wide screen
    // has its space on both sides rather than all at the right.
    let used = w + (if outlined { rail_gap + rail_w } else { 0.0 })
    let x = left + max(gutter, (s.screen.x - left - used) * 0.5)
    let top = header + (if s.route.page.is_empty() { opening_height(s, beside) } else {
        40.0 * u
    })
    // Search keeps clear of the mark and the word beside it.
    let mark_end = (if beside { 28.0 } else { 64.0 }) * u + MARK_WIDTH * mark_ems(s) + 64.0 * u
    let sw = clamp(s.screen.x - mark_end - 20.0 * u, 120.0 * u, 320.0 * u)
    let search = Rect::new(s.screen.x - sw - 20.0 * u, 14.0 * u, sw, 36.0 * u)
    let rail = if outlined {
        Rect::new(x + w + rail_gap, header + 40.0 * u, rail_w, s.screen.y - header - 64.0 * u)
    } else { Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0) }
    Frame { header, nav, beside, x, w, top, search, rail }
}

/// How tall the front page's opening is: the mark large, in its field, short enough that what
/// Wrela is shows on the first screen; shorter on a phone.
fn opening_height(s: Docs, beside: bool) -> f32 {
    if beside { min(232.0 * s.u, s.screen.y * 0.3) } else { min(152.0 * s.u, s.screen.y * 0.22) }
}

/// How large the opening's mark is, in ems of the mark.
fn opening_ems(s: Docs, beside: bool) -> f32 {
    let most = if beside { 56.0 } else { 36.0 }
    min(most * s.u, s.screen.x / (MARK_WIDTH + 1.0) * 0.6) / facet::CAP
}

// ---- the host's answers ------------------------------------------------------------------------

fn answers(s: mut Docs) {
    if let Some(result) = poll(mut s.environment) {
        s.dirty = true
        if let Ok(bytes) = result {
            s.reduced = !bytes.is_empty() && bytes[0] != 0
            if let Some(ratio) = host::word(bytes, 5) { s.u = clamp(f32(ratio) / 1024.0, 0.5, 4.0) }
            s.capabilities = host::capabilities(bytes)
            let p = if host::prefers_light(bytes) { LIGHT } else { DARK }
            if p != s.p {
                s.p = p
                // The page's colours are laid out with it.
                s.laid_width = 0.0
            }
        }
    }
    if let Some(result) = poll(mut s.index_load) {
        s.dirty = true
        match result {
            Ok(bytes) => match Index::read(bytes) {
                Ok(index) => {
                    s.index = take index
                    // The language first, then std, then the packages: the order a reader learns
                    // them in. The sort keeps each group's own order.
                    s.index.pages.sort_by(
                        |a, b| rank(a.path.as_str(), a.kind.as_str()) <
                            rank(b.path.as_str(), b.kind.as_str()),
                    )
                    // The front page lists the pages, and the list now has them.
                    s.laid_width = 0.0
                    s.nav_dirty = true
                    s.nav_follow = true
                    open_shown_group(mut s)
                    // A page that couldn't be opened now lists what may be it.
                    if !s.missed.is_empty() {
                        let why = s.missed.clone()
                        let path = s.shown.clone()
                        let md = missing(s.index, path.as_str(), why.as_str())
                        show(mut s, path.as_str(), parse(md.as_str()), take md)
                        s.missed = take why
                    }
                },
                Err(e) => s.trouble = f"The index couldn't be read: {e.as_str()}",
            },
            Err(e) => s.trouble = f"The index couldn't be fetched: {e.message()}",
        }
    }
    if let Some(Ok(bytes)) = poll(mut s.address) {
        s.dirty = true
        if let Some(text) = String::from_utf8(take bytes) {
            let t = text.as_str()
            let k = t.find("#").unwrap_or(t.len())
            s.base = Some(t.slice(from: 0, to: k).to_string())
            go_to(mut s, Route::of(t), push: false)
        }
        s.changed = Some(host::address_changed())
    }
    if let Some(Ok(bytes)) = poll(mut s.changed) {
        s.dirty = true
        if let Some(text) = String::from_utf8(take bytes) {
            go_to(mut s, Route::of(text.as_str()), push: false)
        }
        s.changed = Some(host::address_changed())
    }
    if let Some(result) = poll(mut s.page_load) {
        s.dirty = true
        let path = s.loading.clone()
        match result {
            Ok(bytes) => match String::from_utf8(bytes.clone()) {
                Some(text) => {
                    let blocks = parse(text.as_str())
                    if s.pages.len() >= KEPT { let _ = s.pages.remove(0) }
                    s.pages.push((path.clone(), blocks.clone(), text.clone()))
                    if s.route.page == path { show(mut s, path.as_str(), take blocks, take text) }
                },
                None => s.trouble = f"{path.as_str()} isn't UTF-8",
            },
            Err(e) => if s.route.page == path {
                // A page that isn't there, as after a page moved: what may be it, and search.
                let md = missing(s.index, path.as_str(), e.message())
                let blocks = parse(md.as_str())
                show(mut s, path.as_str(), take blocks, take md)
                s.missed = e.message().to_string()
            },
        }
    }
    if let Some(Ok(bytes)) = poll(mut s.pasting) {
        s.dirty = true
        if let Ok(p) = host::read_pasted(take bytes) {
            if s.finding {
                put_typed(mut s.find, mut s.caret, mut s.other_end, first_line(p.text.as_str()))
                let f = frame_of(s)
                refresh_matches(mut s, f)
            } else {
                put_typed(mut s.query, mut s.caret, mut s.other_end, first_line(p.text.as_str()))
                refresh_hits(mut s)
            }
        }
    }
    if let Some(result) = poll(mut s.copying) {
        s.dirty = true
        s.copy_ok = result.is_ok()
        s.copied_at = s.time
        if s.capabilities & host::SEMANTICS != 0 {
            s.told.push(host::announce(if s.copy_ok { "Copied" } else { "Couldn't copy" }))
        }
    }
    if let Some(Ok(bytes)) = poll(mut s.reading) {
        s.dirty = true
        if let Ok(state) = semantics::read_field_state(take bytes) { typed(mut s, state) }
    }
    // A box changed since it was last read: read it.
    if s.reading.is_none() {
        if s.search_box.heard > s.search_box.seen {
            s.reading = Some(host::field_state(SEARCH_FIELD))
        } else if s.find_box.heard > s.find_box.seen {
            s.reading = Some(host::field_state(FIND_FIELD))
        }
    }
    var i = 0
    while i < s.told.len() {
        if s.told[i].poll().is_some() { let _ = s.told.remove(i) } else { i += 1 }
    }
}

/// What a person typed in search's or find's box, as the host's field has it.
fn typed(s: mut Docs, state: semantics::FieldState) {
    if state.node == SEARCH_FIELD {
        s.search_box.seen = max(s.search_box.seen, state.revision)
        if s.searching && state.text != s.query {
            s.query = state.text.clone()
            refresh_hits(mut s)
        }
    } else {
        s.find_box.seen = max(s.find_box.seen, state.revision)
        if s.finding && state.text != s.find {
            s.find = state.text.clone()
            let f = frame_of(s)
            refresh_matches(mut s, f)
        }
    }
    // The caret is the end the selection was made toward.
    s.caret = if state.backward { state.start } else { state.end }
    s.other_end = if state.backward { state.end } else { state.start }
}

fn poll(pending: mut Option<Pending<u8>>) -> Option<Result<Vec<u8>, std::io::IoError>> {
    var answer = None
    match mut pending {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if answer.is_some() { pending = None }
    answer
}

fn first_line(t: str) -> borrow str {
    var k = 0
    while k < t.len() && t.byte(k) != 10 && t.byte(k) != 13 { k += 1 }
    t.slice(from: 0, to: k)
}

// ---- where the reader is -----------------------------------------------------------------------

/// Takes the reader to `route`, and adds it to the page's history if `push`.
fn go_to(s: mut Docs, route: Route, push: bool) {
    // Where the reader leaves, and, for Back or Forward, where they were on the address they
    // return to.
    if s.shown == s.route.page { remember(mut s.places, s.route.fragment(), s.scroll) }
    let (seek, back) = arrival(route, push, s.places)
    let same_page = route.page == s.route.page && s.shown == route.page
    s.route = route.clone()
    s.searching = false
    s.nav_open = false
    s.trouble.clear()
    if push {
        let fragment = route.fragment()
        let address = if fragment.is_empty() {
            match s.base {
                Some(b) => b.clone(),
                None => String::from("#"),
            }
        } else { take fragment }
        s.told.push(host::push_address(address.as_str()))
    }
    s.seek = take seek
    s.restore = back
    if same_page {
        if s.seek.is_none() {
            s.glide = None
            s.scroll = s.restore.unwrap_or(0.0)
        }
        s.restore = None
        return
    }
    if route.page.is_empty() {
        show(mut s, "", Vec::new(), String::new())
        return
    }
    var kept: Option<(Vec<Block>, String)> = None
    for (path, blocks, md) in s.pages {
        if path == route.page { kept = Some((blocks.clone(), md.clone())) }
    }
    if let Some((blocks, md)) = take kept {
        show(mut s, route.page.as_str(), take blocks, take md)
        return
    }
    s.loading = route.page.clone()
    s.page_load = Some(fetch(route.page.as_str()))
}

/// Shows the page at `path` (`` for the front page), its blocks read from its Markdown, at its
/// top, its anchor, or the place the reader left it.
fn show(s: mut Docs, path: str, blocks: take Vec<Block>, markdown: take String) {
    s.blocks = take blocks
    s.markdown = take markdown
    s.missed.clear()
    s.shown = path.to_string()
    s.nav_follow = true
    open_shown_group(mut s)
    s.laid_width = 0.0
    s.glide = None
    s.shown_at = s.time
    if s.seek.is_none() { s.scroll = s.restore.unwrap_or(0.0) }
    s.restore = None
}

/// How many places the reader left are kept.
const PLACES: u32 = 64

/// Keeps `y`, where the reader is on address `here` (its fragment), in place of what was kept
/// for it.
fn remember(places: mut Vec<(String, f32)>, here: take String, y: f32) {
    places.retain(|p| p.0 != here)
    if places.len() >= PLACES { let _ = places.remove(0) }
    places.push((take here, y))
}

/// Where a reader arriving at `route` goes on its page: the anchor it names, to seek; or, by Back
/// or Forward (not `push`), the place they left it at, if they were there. Neither: its top.
fn arrival(route: Route, push: bool, places: [(String, f32)]) -> (Option<String>, Option<f32>) {
    if !push {
        let here = route.fragment()
        for (f, y) in places {
            if f == here { return (None, Some(y)) }
        }
    }
    (if route.anchor.is_empty() { None } else { Some(route.anchor.clone()) }, None)
}

/// The front page's Markdown: what Wrela is and which release these pages describe, a field in a
/// few lines, where to start, then each group of pages, each page with what it covers; the
/// engine's by topic.
fn front(index: Index) -> String {
    var md = String::from(
        "Wrela is a language, compiler and engine for games that run in the browser. One source compiles to WebAssembly for the CPU and to WGSL for the GPU.\n\n",
    )
    if !index.version.is_empty() {
        md.push_str(f"These pages describe Wrela {index.version.as_str()}")
        if index.commit.len() >= 7 {
            md.push_str(f", built from commit `{index.commit.as_str().slice(from: 0, to: 7)}`")
        }
        md.push_str(".\n\n")
    }
    md.push_str(
        "## Content is fields\n\nA field is a function over space, such as the distance from a point to a surface. `std::field` joins, cuts, moves and displaces fields, and the compiler derives each field's gradient and its bounds over a box from the field's own code ([§13](spec/language/13-derived-interpretations.md)). The field below is drawn live from its code, lit by that gradient, which nobody wrote; [a complete program](spec/language/19-a-complete-program.md) draws it with a shader of its own.\n\n```wrela\nlet cone = round_cone(vec3(), vec3(y: 1.0), r_top: 0.3, r_bottom: 0.1)\nlet blob = sphere(radius: 0.5).smooth_union(cone, k: 0.1)\n```\n\n## Where to start\n\n",
    )
    md.push_str(
        "- [Read the language](spec/language/how-wrela-differs-from-rust-and-typescript.md): how Wrela differs from Rust and TypeScript, then the spec's 20 sections in order.\n",
    )
    if !index.repository.is_empty() {
        md.push_str(
            f"- Run a program: in a clone of [the repository]({index.repository.as_str()}), `tools/wrela run examples/hello-field` builds the compiler and serves that program to your browser.\n",
        )
    }
    md.push_str(
        "- Look up an item: press `/` and type its name, such as `Arena`, `Pending` or `smooth_union`. Search finds the spec's rules by their words too.\n",
    )
    md.push_str(
        "- [Give the docs to an agent](llms.txt): `llms.txt` lists every page with its summary and says how to read them. [`spec/llms-full.txt`](spec/llms-full.txt) holds the whole language in one file, and each package has a file of its own; `index.json` lists every item with its signature and source line. Each page is Markdown at its own address, such as `std/io.md`, and its Copy as Markdown button puts it on the clipboard.\n",
    )
    for g in groups_in(index) {
        let (name, pkg) = group_title(g.as_str())
        if pkg.is_empty() {
            md.push_str(f"\n## {name.as_str()}\n\n")
        } else { md.push_str(f"\n## {name.as_str()}: `{pkg.as_str()}`\n\n") }
        for t in 0..TOPICS + 1 {
            if g.as_str() != "engine" && t > 0 { break }
            var listed = false
            for p in index.pages {
                if group_of(p.path.as_str(), p.kind.as_str()) != g.as_str() { continue }
                let label = nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str())
                if g.as_str() == "engine" && engine_topic(label.as_str()) != t { continue }
                if g.as_str() == "engine" && !listed {
                    md.push_str(f"\n### {topic_title(t).as_str()}\n\n")
                }
                listed = true
                md.push_str(f"- [{label.as_str()}]({p.path.as_str()}): {p.summary.as_str()}\n")
            }
        }
    }
    take md
}

/// The page shown for a page that couldn't be opened, at `path`: what went wrong, then the pages
/// that search finds for the path's last name, as a page that moved may be among them, and how
/// to search. Its links are relative to `path`.
fn missing(index: Index, path: str, why: str) -> String {
    let p = path.slice(from: 0, to: if path.ends_with(".md") { path.len() - 3 } else { path.len() })
    var md = f"# No page here\n\n`{p}` couldn't be opened ({why}).\n\n"
    // Up from the page's directory to the docs' root.
    var up = String::new()
    for i in 0..p.len() {
        if p.byte(i) == 47 { up.push_str("../") }
    }
    // The path's last name, as words (`6-memory-model`: `6 memory model`); if search finds nothing
    // for them all, its longest word.
    var name = String::new()
    var start = p.len()
    while start > 0 && p.byte(start - 1) != 47 { start -= 1 }
    for i in start..p.len() {
        let b = p.byte(i)
        name.push_char(if b == 45 || b == 95 { 32 } else { u32(b) })
    }
    var hits = index.search(name.as_str(), 8)
    if hits.is_empty() {
        var longest = String::new()
        for (a, b) in name.as_str().split(" ") {
            if b - a > longest.len() { longest = name.as_str().slice(a, b).to_string() }
        }
        hits = index.search(longest.as_str(), 8)
    }
    if hits.is_empty() {
        md.push_str("Press `/` and search for what you're looking for.\n")
        return md
    }
    // Pages of the missing page's own group (`spec`, `std`) first: it moved most likely there.
    let group = p.slice(from: 0, to: p.find("/").unwrap_or(p.len())).to_string()
    hits.sort_by(
        |a, b| page_of(index, a).as_str().starts_with(group.as_str()) &&
            !page_of(index, b).as_str().starts_with(group.as_str()),
    )
    md.push_str(
        "A page that moved may be one of these. Or press `/` and search for what you're looking for.\n\n## Pages that may be it\n\n",
    )
    for h in hits {
        let (title, under) = result_text(index, h)
        let (page, anchor) = if h.item {
            (index.items[h.at].page.clone(), index.items[h.at].anchor.clone())
        } else { (index.sections[h.at].page.clone(), index.sections[h.at].anchor.clone()) }
        let place = if anchor.is_empty() { String::new() } else { f"#{anchor.as_str()}" }
        md.push_str(
            f"- [{title.as_str()}]({up.as_str()}{page.as_str()}{place.as_str()}): {under.as_str()}\n",
        )
    }
    take md
}

/// The page a search result is on.
fn page_of(index: Index, h: Hit) -> String {
    if h.item { index.items[h.at].page.clone() } else { index.sections[h.at].page.clone() }
}

/// How many topics the engine's modules are listed under on the front page, so a reader finds the
/// renderer's modules, or the sim's, among the engine's many; then each topic's title and its
/// modules. A module not named in one is listed under "More", the topic after them.
const TOPICS: u32 = 7

fn topic_title(t: u32) -> String {
    String::from(match t {
        0 => "Rendering and light",
        1 => "Creatures",
        2 => "Forms and plants",
        3 => "The world",
        4 => "Histories",
        5 => "Simulation",
        6 => "Sound and music",
        _ => "More",
    })
}

fn topic_modules(t: u32) -> String {
    String::from(match t {
        0 => "air light lit lod impostor paint probes render shadow shafts sky temporal view",
        1 => "anatomy character creature digits gait look physique quadruped realize senses walk",
        2 => "grass loft plant stone sweep vegetation",
        3 => "construction floor footing landform place soil terrain water wild wood",
        4 => "bake events grow history interest",
        5 => "noise player present rng run sim spatial timeline timers tower",
        6 => "acoustics perform piano piano_grand score sound",
        _ => "",
    })
}

/// The topic engine module `module` is listed under.
fn engine_topic(module: str) -> u32 {
    for t in 0..TOPICS {
        let list = topic_modules(t)
        let modules = list.as_str()
        var a = 0
        while a < modules.len() {
            var e = a
            while e < modules.len() && modules.byte(e) != 32 { e += 1 }
            if modules.slice(from: a, to: e) == module { return t }
            a = e + 1
        }
    }
    TOPICS
}

/// The group a page is listed in: `spec`, or its package.
fn group_of(path: str, kind: str) -> borrow str {
    if kind == "spec" { return kind }
    let k = path.find("/").unwrap_or(path.len())
    path.slice(from: 0, to: k)
}

fn rank(path: str, kind: str) -> u32 {
    let g = group_of(path, kind)
    if g == "spec" { 0 } else if g == "std" { 1 } else { 2 }
}

/// A group's name, in the list and as its heading on the front page, and the package it is (none
/// for the language's).
fn group_title(g: str) -> (String, String) {
    let name = if g == "spec" { "The language" } else if g == "std" {
        "Standard library"
    } else if g == "engine" {
        "Engine"
    } else if g == "ui" { "Drawing and widgets" } else if g == "platform" { "Host services" } else {
        return (g.to_string(), g.to_string())
    }
    (name.to_string(), if g == "spec" { String::new() } else { g.to_string() })
}

// ---- input -------------------------------------------------------------------------------------

fn handle(s: mut Docs, e: Event, f: Frame) {
    let u = s.u
    match e {
        Event::PointerMove { at, .. } => {
            // A pointer that moves with nothing held is a mouse's.
            if s.press.is_none() &&
                s.knob_held.is_none() &&
                s.orbit.is_none() &&
                s.thumb.is_none() {
                s.finger = false
            }
            s.pointer = at
            // The pointer chooses the result it's over, as the arrow keys do.
            if s.searching {
                if let Some(i) = result_at(s, at, f) { s.chosen = i }
            }
            drag(mut s, at, f)
        },
        Event::PointerDown { at, button, .. } => {
            // A press stops a fling, as a finger stops a page that's still moving.
            s.fling = None
            if button != Button::Primary {
                s.pointer = at
                return
            }
            press(mut s, at, f)
            s.pointer = at
        },
        Event::PointerUp { at, button, .. } => if button == Button::Primary {
            s.thumb = None
            start_fling(mut s)
            if s.knob_held.is_some() || s.orbit.is_some() {
                s.knob_held = None
                s.orbit = None
                s.press = None
                s.swipe = None
            }
            release(mut s, at)
        },
        Event::Wheel { at, delta, .. } => {
            s.fling = None
            if over_nav(s, at, f) { s.nav_scroll += delta.y } else if !s.searching {
                scroll_by(mut s, delta.y, f)
            }
        },
        Event::KeyDown { key, mods, .. } => {
            // Find: Command-F opens it, and Command-G (or F3) goes to the next match, from anywhere.
            if mods.command() && key == Key::F {
                s.finding = true
                s.searching = false
                s.caret = s.find.len()
                s.other_end = s.caret
                return
            }
            if (mods.command() && key == Key::G) || key == Key::F3 {
                step_match(mut s, if mods.shift { -1 } else { 1 }, f)
                return
            }
            if s.searching {
                if key == Key::Escape { s.searching = false }
                if key == Key::Backspace {
                    erase(mut s.query, mut s.caret, mut s.other_end, mods.command())
                    refresh_hits(mut s)
                }
                if mods.command() && key == Key::A { select_all(mut s) }
                if key == Key::Down && s.chosen + 1 < s.hits.len() { s.chosen += 1 }
                if key == Key::Up && s.chosen > 0 { s.chosen -= 1 }
                if key == Key::Enter && s.chosen < s.hits.len() { choose(mut s, s.chosen) }
                return
            }
            if s.finding {
                if key == Key::Escape { s.finding = false }
                if key == Key::Backspace {
                    erase(mut s.find, mut s.caret, mut s.other_end, mods.command())
                    refresh_matches(mut s, f)
                }
                if mods.command() && key == Key::A { select_all(mut s) }
                if key == Key::Enter { step_match(mut s, if mods.shift { -1 } else { 1 }, f) }
                return
            }
            if mods.command() && key == Key::K { open_search(mut s) }
            if mods.command() && key == Key::A { s.selected = Some((0, s.text.len())) }
            if key == Key::Escape { s.selected = None }
            let page = s.screen.y - f.header - 80.0 * u
            if key == Key::Space || key == Key::PageDown {
                glide_by(mut s, if mods.shift {
                    -page
                } else { page }, f)
            }
            if key == Key::PageUp { glide_by(mut s, -page, f) }
            if key == Key::Down { glide_by(mut s, 48.0 * u, f) }
            if key == Key::Up { glide_by(mut s, -48.0 * u, f) }
            if key == Key::Home { s.glide = Some(0.0) }
            if key == Key::End { s.glide = Some(max_scroll(s, f)) }
            if key == Key::Escape { s.nav_open = false }
        },
        Event::Text { char } => {
            if s.finding {
                if char >= 32 && char != 127 && s.find.len() < 120 {
                    put_typed(mut s.find, mut s.caret, mut s.other_end, one(char).as_str())
                    refresh_matches(mut s, f)
                }
                return
            }
            if !s.searching {
                // `/` opens search, as on many sites.
                if char == 47 { open_search(mut s) }
                return
            }
            if char >= 32 && char != 127 && s.query.len() < 120 {
                put_typed(mut s.query, mut s.caret, mut s.other_end, one(char).as_str())
                refresh_hits(mut s)
            }
        },
        Event::Paste { serial } => if s.searching || s.finding {
            s.pasting = Some(host::pasted(serial))
        },
        Event::Assist { node, action } => assisted(mut s, node, action, f),
        Event::Field { node, revision } => {
            if node == SEARCH_FIELD { s.search_box.heard = max(s.search_box.heard, revision) }
            if node == FIND_FIELD { s.find_box.heard = max(s.find_box.heard, revision) }
        },
        _ => {},
    }
}

/// Takes the character before the caret from `q`, or all of it with Command; or, if something
/// is selected, that.
fn erase(q: mut String, caret: mut u32, other: mut u32, all: bool) {
    let lo = min(min(caret, other), q.len())
    let hi = min(max(caret, other), q.len())
    if all {
        q.clear()
        caret = 0
    } else if lo < hi {
        let rest = q.as_str().slice(from: hi, to: q.len()).to_string()
        q.truncate(lo)
        q.push_str(rest.as_str())
        caret = lo
    } else if lo > 0 {
        let k = previous_cluster(q.as_str(), lo)
        let rest = q.as_str().slice(from: lo, to: q.len()).to_string()
        q.truncate(k)
        q.push_str(rest.as_str())
        caret = k
    }
    other = caret
}

/// Puts `typed` in `q` in place of what's selected, or at the caret, and the caret after it.
fn put_typed(q: mut String, caret: mut u32, other: mut u32, typed: str) {
    let lo = min(min(caret, other), q.len())
    let hi = min(max(caret, other), q.len())
    let rest = q.as_str().slice(from: hi, to: q.len()).to_string()
    q.truncate(lo)
    q.push_str(typed)
    q.push_str(rest.as_str())
    caret = lo + typed.len()
    other = caret
}

/// A character as text.
fn one(char: u32) -> String {
    var t = String::new()
    t.push_char(char)
    take t
}

/// Selects all of what's typed in search's or find's box, in the host's field too.
fn select_all(s: mut Docs) {
    if s.finding {
        s.caret = s.find.len()
        s.find_box.replace += 1
    } else {
        s.caret = s.query.len()
        s.search_box.replace += 1
    }
    s.other_end = 0
}

/// Where find's query is on the page, and the match nearest the reader's place made current.
fn refresh_matches(s: mut Docs, f: Frame) {
    s.matches.clear()
    s.current = 0
    let q = lower(s.find.as_str())
    if q.is_empty() { return }
    var from = 0
    while from < s.lowered.len() {
        let Some(k) = s.lowered
            .as_str()
            .slice(from: from, to: s.lowered.len())
            .find(q.as_str()) else { break }
        s.matches.push(from + k)
        from = from + k + q.len()
    }
    // The first match below the top of what's on screen.
    for i in 0..s.matches.len() {
        if y_of(s, s.matches[i]) >= s.scroll {
            s.current = i
            break
        }
    }
    reveal(mut s, f)
}

/// The next match (`by` 1) or the one before (-1), round the page.
fn step_match(s: mut Docs, by: i32, f: Frame) {
    let n = s.matches.len()
    if n == 0 {
        s.finding = true
        return
    }
    s.current = if by > 0 { (s.current + 1) % n } else { (s.current + n - 1) % n }
    reveal(mut s, f)
}

/// Scrolls the current match into view.
fn reveal(s: mut Docs, f: Frame) {
    if s.current >= s.matches.len() { return }
    let y = y_of(s, s.matches[s.current])
    let view = s.screen.y - f.top
    if y < s.scroll + 40.0 * s.u || y > s.scroll + view - 80.0 * s.u {
        s.glide = None
        s.scroll = clamp(y - view * 0.35, 0.0, max_scroll(s, f))
    }
}

/// The top of the piece where byte `at` of the page's text is.
fn y_of(s: Docs, at: u32) -> f32 {
    let i = piece_of(s, at)
    if i < s.laid.pieces.len() { s.laid.pieces[i].at.y } else { 0.0 }
}

/// The piece that holds byte `at` of the page's text.
fn piece_of(s: Docs, at: u32) -> u32 {
    var lo = 0
    var hi = s.starts.len()
    while lo + 1 < hi {
        let mid = (lo + hi) / 2
        if s.starts[mid] <= at { lo = mid } else { hi = mid }
    }
    lo
}

fn open_search(s: mut Docs) {
    s.searching = true
    s.query.clear()
    // The host's field starts empty too.
    s.search_box.replace += 1
    s.caret = 0
    s.other_end = 0
    s.hits.clear()
    s.chosen = 0
}

fn refresh_hits(s: mut Docs) {
    s.hits = s.index.search(s.query.as_str(), RESULTS)
    s.chosen = 0
}

/// Goes to search result `i`.
fn choose(s: mut Docs, i: u32) {
    let h = s.hits[i]
    let route = if h.item {
        Route { page: s.index.items[h.at].page.clone(), anchor: s.index.items[h.at].anchor.clone() }
    } else {
        Route {
            page: s.index.sections[h.at].page.clone(),
            anchor: s.index.sections[h.at].anchor.clone(),
        }
    }
    go_to(mut s, route, push: true)
}

fn over_nav(s: Docs, at: vec2, f: Frame) -> bool {
    at.y > f.header && at.x < f.nav && (f.beside || s.nav_open)
}

fn scroll_by(s: mut Docs, dy: f32, f: Frame) {
    s.glide = None
    s.scroll = clamp(s.scroll + dy, 0.0, max_scroll(s, f))
}

/// Glides the page `dy` further than it's gliding to, or than it is.
fn glide_by(s: mut Docs, dy: f32, f: Frame) {
    let from = s.glide.unwrap_or(s.scroll)
    s.glide = Some(clamp(from + dy, 0.0, max_scroll(s, f)))
}

/// Moves the page toward where it glides, `dt` seconds on: most of the way in a tenth of a
/// second, and there at once when the system asks for less motion.
fn glide_on(s: mut Docs, f: Frame, dt: f32) {
    let Some(to) = s.glide else { return }
    let target = clamp(to, 0.0, max_scroll(s, f))
    s.scroll = glided(at: s.scroll, to: target, dt: dt, still: s.reduced)
    if s.scroll == target { s.glide = None }
}

/// Where a glide from `at` toward `to` is `dt` seconds on: there, where it's within half a pixel
/// or there's to be no motion.
fn glided(at: f32, to: f32, dt: f32, still: bool) -> f32 {
    if still || abs(to - at) < 0.5 { return to }
    at + (to - at) * (1.0 - exp(-dt * 20.0))
}

fn max_scroll(s: Docs, f: Frame) -> f32 {
    // Room under the text for its neighbours and its Markdown.
    max(f.top + s.laid.height + 200.0 * s.u - s.screen.y, 0.0)
}

fn press(s: mut Docs, at: vec2, f: Frame) {
    // Search: its box opens it; a result goes there; anywhere else closes it.
    if s.searching {
        if let Some(i) = result_at(s, at, f) {
            choose(mut s, i)
            return
        }
        // The panel's words and keys are no result, and leave search open.
        if results_panel(s, f).contains(at) { return }
        if !f.search.contains(at) {
            s.searching = false
            return
        }
    }
    if f.search.contains(at) {
        if !s.searching && !s.finding { open_search(mut s) }
        return
    }
    if at.y < f.header {
        // The mark goes to the front page; on a narrow screen, the button beside it opens the list.
        if !f.beside && at.x < 56.0 * s.u {
            s.nav_open = !s.nav_open
            // Open, it shows the page being read at its top, its sections under it.
            if s.nav_open { s.nav_follow = true }
            return
        }
        if at.x < mark_right(s, f) { go_to(mut s, Route::front(), push: true) }
        return
    }
    // A scrollbar: its thumb is held, and a press on its track brings the thumb there first.
    for nav in [false, true] {
        let Some((track, thumb)) = scrollbar(s, f, nav) else { continue }
        if !track.contains(at) { continue }
        if !thumb.contains(at) {
            let y = (at.y - track.y - thumb.h * 0.5) / max(track.h - thumb.h, 1.0)
            set_scroll(mut s, f, nav, clamp(y, 0.0, 1.0) * scroll_room(s, f, nav))
        }
        s.thumb = Some((at.y, if nav { s.nav_scroll } else { s.scroll }, nav))
        return
    }
    let hovered = length(s.pointer - at) < 2.0
    s.finger = !hovered
    if over_nav(s, at, f) {
        // A page of the list opens when the press lets go without moving; a finger's drag
        // scrolls the list.
        let held = nav_at(s, at, f).unwrap_or(String::new())
        s.press = Some((at, false, take held))
        if !hovered { s.swipe = Some((s.nav_scroll, true)) }
        return
    }
    if s.nav_open {
        s.nav_open = false
        return
    }
    if let Some(target) = extra_at(s, at, f) {
        s.press = Some((at, false, take target))
        return
    }
    for c in controls(s, f, at, all: false) {
        if c.rect.contains(at) {
            s.press = Some((at, false, c.target.clone()))
            return
        }
    }
    // A live field's number: it drags.
    for i in 0..s.laid.knobs.len() {
        if knob_rect(s, f, i).contains(at) {
            // A finger shows by its first move whether it drags the number or scrolls the page.
            s.knob_held = Some((i, at, knob_value(s, i), !hovered))
            return
        }
    }
    // A figure's tab: it shows that view.
    for i in 0..s.laid.figures.len() {
        for (r, mode, _) in figure_tabs(s, f, i) {
            if r.contains(at) {
                if let Some(l) = live_of(s, s.laid.figures[i].block) { s.lives[l].mode = mode }
                return
            }
        }
    }
    // A live figure: a mouse turns and tilts it, and over a slice shows what the field is where it
    // is. A finger's first move says its way: across, it turns the field or moves the slice's
    // probe; up or down, it scrolls the page.
    for i in 0..s.laid.figures.len() {
        if figure_rect(s, f, i).contains(at) {
            let (turn, tilt) = match live_of(s, s.laid.figures[i].block) {
                Some(l) => (s.lives[l].turn, s.lives[l].tilt),
                None => (0.0, 0.0),
            }
            s.orbit = Some((i, at, turn, tilt, if hovered { HELD_BY_MOUSE } else { FINGER_UNSURE }))
            if !hovered { s.swipe = Some((s.scroll, false)) }
            return
        }
    }
    let link = link_at(s, at, f).unwrap_or(String::new())
    // A mouse hovers where it presses; a finger lands without hovering, and its drag scrolls.
    s.press = Some((at, false, take link))
    if !hovered {
        s.swipe = Some((s.scroll, false))
        return
    }
    s.selected = match place(s, at, f) {
        Some(k) => Some((k, k)),
        None => None,
    }
}

/// Where `at` is in the page's text, as a byte.
fn place(s: Docs, at: vec2, f: Frame) -> Option<u32> {
    let p = vec2(at.x - f.x, at.y - f.top + s.scroll)
    match s.laid.place_at(s.fonts, p) {
        Some((i, k)) => Some(s.starts[i] + k),
        None => None,
    }
}

/// The pointer moved while it's held on the page: the selection goes to it.
fn drag(s: mut Docs, at: vec2, f: Frame) {
    if let Some((i, from, v0, unsure)) = s.knob_held {
        if unsure {
            let d = (at - from) / s.u
            if length(d) < FINGER_SLOP { return }
            if abs(d.y) > abs(d.x) {
                // Up or down: the page scrolls, as anywhere else.
                s.knob_held = None
                s.press = Some((from, true, String::new()))
                s.swipe = Some((s.scroll, false))
                drag(mut s, at, f)
                return
            }
            s.knob_held = Some((i, from, v0, false))
        }
        // A pixel's worth of drag: a 250th of the number's size, or of a quarter where it's small.
        let step = max(abs(v0), 0.25) * 0.004
        var v = v0 + (at.x - from.x) / s.u * step
        if v0 >= 0.0 { v = max(v, 0.0) }
        set_knob(mut s, i, v)
        return
    }
    if let Some((i, from, turn, tilt, by)) = s.orbit {
        let block = s.laid.figures[i].block
        let Some(l) = live_of(s, block) else { return }
        let d = (at - from) / s.u
        var held = by
        if held == FINGER_UNSURE {
            if length(d) < FINGER_SLOP { return }
            held = if abs(d.x) > abs(d.y) { FINGER_TURNS } else { FINGER_SCROLLS }
            s.orbit = Some((i, from, turn, tilt, held))
        }
        // A slice doesn't turn: the pointer is its probe.
        let surface = s.lives[l].mode == SURFACE
        if held != FINGER_SCROLLS && surface { s.lives[l].turn = turn - d.x * 0.008 }
        if held == HELD_BY_MOUSE && surface {
            s.lives[l].tilt = clamp(tilt + d.y * 0.006, 0.1, 1.3)
        }
        if held == FINGER_SCROLLS {
            s.glide = None
            if let Some((start, _)) = s.swipe {
                s.scroll = clamp(start - (at.y - from.y), 0.0, max_scroll(s, f))
                follow_finger(mut s, at.y)
            }
        }
        return
    }
    if let Some((from, start, nav)) = s.thumb {
        let Some((track, thumb)) = scrollbar(s, f, nav) else { return }
        let room = scroll_room(s, f, nav)
        set_scroll(mut s, f, nav, start + (at.y - from) * room / max(track.h - thumb.h, 1.0))
        return
    }
    let Some((from, moved, held)) = s.press else { return }
    let link = held.clone()
    // A finger wavers as it taps: it takes a longer move than a mouse's to be a drag.
    let slop = if s.swipe.is_some() { 10.0 } else { 4.0 }
    let far = length(at - from) > slop * s.u
    if !moved && !far { return }
    s.press = Some((from, true, link.clone()))
    if let Some((start, nav)) = s.swipe {
        if nav {
            s.nav_scroll = max(start - (at.y - from.y), 0.0)
        } else {
            s.glide = None
            s.scroll = clamp(start - (at.y - from.y), 0.0, max_scroll(s, f))
        }
        follow_finger(mut s, at.y)
        return
    }
    // A press on the list of pages selects nothing.
    if link.as_str().starts_with("nav:") ||
        link.as_str().starts_with("group:") ||
        s.selected.is_none() {
        return
    }
    let Some((start, _)) = s.selected else { return }
    if let Some(k) = place(s, at, f) { s.selected = Some((start, k)) }
}

/// Where a swiping finger is now, kept with the moments before it, a frame apart.
fn follow_finger(s: mut Docs, y: f32) {
    let n = s.trail.len()
    if n > 0 && s.trail[n - 1].1 == s.time {
        s.trail[n - 1].0 = y
    } else { s.trail.push((y, s.time)) }
    if s.trail.len() > 8 { let _ = s.trail.remove(0) }
}

/// A swipe let go: at the speed its finger had over its last tenth of a second, it carries on.
fn start_fling(s: mut Docs) {
    let trail = s.trail.clone()
    s.trail.clear()
    let Some((_, nav)) = s.swipe else { return }
    let moved = match s.press {
        Some((_, m, _)) => m,
        None => match s.orbit {
            Some((_, _, _, _, by)) => by == FINGER_SCROLLS,
            None => false,
        },
    }
    if !moved || trail.len() < 2 { return }
    let v = swipe_speed(trail, s.time)
    if abs(v) > 60.0 * s.u { s.fling = Some((v, nav)) }
}

/// The speed of a finger along `trail` (where it was, and when), in pixels a second that the page
/// scrolls: over its last tenth of a second before `now`, and none if it rested longer than that.
fn swipe_speed(trail: [(f32, f32)], now: f32) -> f32 {
    let n = trail.len()
    if n < 2 { return 0.0 }
    let (y1, t1) = trail[n - 1]
    if now - t1 > 0.1 { return 0.0 }
    var k = n - 1
    while k > 0 && t1 - trail[k - 1].1 <= 0.1 { k -= 1 }
    if k == n - 1 { k = n - 2 }
    let (y0, t0) = trail[k]
    if t1 - t0 < 0.005 { return 0.0 }
    -(y1 - y0) / (t1 - t0)
}

/// A fling carries the page, or the list of pages, on, slowing as a page on a phone does, and
/// stops at either end.
fn fling_on(s: mut Docs, f: Frame, dt: f32) {
    let Some((v, nav)) = s.fling else { return }
    let before = if nav { s.nav_scroll } else { s.scroll }
    set_scroll(mut s, f, nav, before + v * dt)
    let after = if nav { s.nav_scroll } else { s.scroll }
    let slower = v * exp(-dt * 2.4)
    s.fling = if abs(slower) < 12.0 * s.u || (dt > 0.0 && after == before) { None } else {
        Some((slower, nav))
    }
}

/// The pointer let go: a press that didn't move follows the link it was on, and selects nothing.
fn release(s: mut Docs, at: vec2) {
    let Some((_, moved, held)) = s.press else { return }
    let link = held.clone()
    let still = !moved
    s.press = None
    s.swipe = None
    let _ = at
    if !still { return }
    s.selected = None
    if !link.is_empty() { follow_link(mut s, link.as_str()) }
}

/// Where a link leads: another page, a place, out, or an item's source; a page of the list
/// (`nav:`), a section of this page (`here:`), or one of the docs' files, which opens as it is
/// (`file:`).
fn follow_link(s: mut Docs, target: str) {
    if target.starts_with("nav:") {
        let page = target.slice(from: 4, to: target.len()).to_string()
        go_to(mut s, Route { page, anchor: String::new() }, push: true)
        return
    }
    if target.starts_with("group:") {
        toggle_group(mut s, target.slice(from: 6, to: target.len()))
        return
    }
    if target.starts_with("here:") {
        let anchor = target.slice(from: 5, to: target.len()).to_string()
        go_to(mut s, Route { page: s.shown.clone(), anchor }, push: true)
        return
    }
    if target == "copy:page" {
        let md = s.markdown.clone()
        copy(mut s, target, md.as_str())
        return
    }
    if target.starts_with("copy:code:") {
        let i = parse_u32(target.slice(from: 10, to: target.len()))
        if i < s.laid.snippets.len() {
            let code = s.laid.snippets[i].text.clone()
            copy(mut s, target, code.as_str())
        }
        return
    }
    if target.starts_with("source:") || target.starts_with("file:") {
        let url = href_of(s, target)
        if !url.is_empty() { s.told.push(host::open_link(url.as_str())) }
        return
    }
    match follow(s.shown.as_str(), target) {
        Some(Target::Docs(route)) => go_to(mut s, route, push: true),
        Some(Target::File(path)) => s.told.push(host::open_link(path.as_str())),
        Some(Target::Out(url)) => s.told.push(host::open_link(url.as_str())),
        None => {},
    }
}

/// Puts `text` on the clipboard, for the control `what`, which says how that went.
fn copy(s: mut Docs, what: str, text: str) {
    if text.is_empty() { return }
    s.copying = Some(host::copy(text))
    s.copied = what.to_string()
    s.copied_at = -10.0
}

/// What control `what` says of its copy, for a moment after it: whether it worked.
fn copy_said(s: Docs, what: str) -> Option<String> {
    said(s.copied.as_str(), s.copied_at, s.copy_ok, s.time, what)
}

/// What control `what` says at time `now` of the last copy, by control `copied` at time `at`,
/// which worked or not (`ok`): for `SAID` seconds, whether it worked; then nothing.
fn said(copied: str, at: f32, ok: bool, now: f32, what: str) -> Option<String> {
    if copied != what || now < at || now - at > SAID { return None }
    Some(String::from(if ok { "Copied" } else { "Couldn't copy" }))
}

/// The number `t` writes in decimal digits; 0 for anything else.
fn parse_u32(t: str) -> u32 {
    var n = 0
    for i in 0..t.len() {
        let b = t.byte(i)
        if b < 48 || b > 57 || n > 100000000 { return 0 }
        n = n * 10 + u32(b - 48)
    }
    n
}

/// The link under `at` on the page, if there is one.
fn link_at(s: Docs, at: vec2, f: Frame) -> Option<String> {
    if at.y < f.header { return None }
    let p = vec2(at.x - f.x, at.y - f.top + s.scroll)
    for spot in s.laid.spots {
        if spot.rect.contains(p) { return Some(spot.target.clone()) }
    }
    None
}

/// An assistive technology acted on node `node`: a link is followed, and one it reaches is
/// brought into view.
fn assisted(s: mut Docs, node: u32, action: Assist, f: Frame) {
    // The focus reaching search's box opens search.
    if node == SEARCH_FIELD {
        if action == Assist::Focus && !s.searching && !s.finding { open_search(mut s) }
        return
    }
    if node >= TABS {
        let i = (node - TABS) / 4
        let mode = (node - TABS) % 4
        if i < s.laid.figures.len() && (action == Assist::Activate || action == Assist::Select) {
            if let Some(l) = live_of(s, s.laid.figures[i].block) { s.lives[l].mode = mode }
        }
        return
    }
    if node >= TAB_LISTS { return }
    if node >= KNOB_NODES {
        let i = node - KNOB_NODES
        if i < s.laid.knobs.len() && (action == Assist::Increment || action == Assist::Decrement) {
            let v = knob_value(s, i)
            let by = if action == Assist::Increment { knob_step(v) } else { -knob_step(v) }
            set_knob(mut s, i, if v >= 0.0 { max(v + by, 0.0) } else { v + by })
        }
        return
    }
    if node >= CONTROL_NODES {
        let all = controls(s, f, s.pointer, all: true)
        let i = node - CONTROL_NODES
        if action == Assist::Activate && i < all.len() {
            follow_link(mut s, all[i].target.as_str())
        }
        return
    }
    if node >= EXTRA_NODES {
        let ex = extras(s, f)
        let i = node - EXTRA_NODES
        if action == Assist::Activate && i < ex.len() { follow_link(mut s, ex[i].target.as_str()) }
        return
    }
    if node >= NAV_BUTTONS {
        let all = groups_in(s.index)
        let i = node - NAV_BUTTONS
        if action == Assist::Activate && i < all.len() { toggle_group(mut s, all[i].as_str()) }
        return
    }
    if node >= NAV_GROUPS { return }
    if node >= NAV_NODES {
        let i = node - NAV_NODES
        if action == Assist::Activate && i < s.index.pages.len() {
            go_to(
                mut s,
                Route { page: s.index.pages[i].path.clone(), anchor: String::new() },
                push: true,
            )
        }
        return
    }
    if node >= RESULT_NODES {
        let i = node - RESULT_NODES
        if i >= s.hits.len() { return }
        match action {
            Assist::Activate => choose(mut s, i),
            _ => s.chosen = i,
        }
        return
    }
    // The page's parts are numbered from 1: 0 is the tree's root.
    if node == 0 || node > s.laid.parts.len() { return }
    let target = s.laid.parts[node - 1].target.clone()
    let top = s.laid.parts[node - 1].rect.y
    match action {
        Assist::Activate => if !target.is_empty() { follow_link(mut s, target.as_str()) },
        _ => {
            let view = s.screen.y - f.top
            if top < s.scroll || top > s.scroll + view * 0.8 {
                s.scroll = clamp(top - 80.0 * s.u, 0.0, max_scroll(s, f))
            }
        },
    }
}

// ---- the list of pages -------------------------------------------------------------------------

/// A row of the list of pages: a group's title (no page) or a page, its label as the lines it
/// wraps to, its top from the list's top (unscrolled) and its height.
struct NavRow: Clone {
    group: String,
    path: String,
    lines: Vec<String>,
    y: f32,
    h: f32,
    /// A section of the page being read (its anchor), listed under it where the page has no
    /// outline beside it; empty for a page.
    anchor: String = String::new(),
}

/// Lays the list's rows out again when what they show or their room changed: each group's title,
/// then, if the group is open, its pages, each label wrapped to at most two lines. Keeps the
/// list's scroll within its rows.
fn keep_nav(s: mut Docs, f: Frame) {
    let u = s.u
    let room = vec2(f.nav, u)
    if s.nav_dirty || s.nav_for != room {
        s.nav_dirty = false
        s.nav_for = room
        var rows: Vec<NavRow> = Vec::new()
        var y = 16.0 * u
        var group = String::new()
        // Over the page, where a finger reads, the rows are a finger's height, and the page being
        // read has its sections under it: it has no outline beside it.
        let finger = !f.beside
        let pad = if finger { 22.0 } else { 8.0 }
        let title = if finger { 48.0 } else { 36.0 }
        for p in s.index.pages {
            let g = group_of(p.path.as_str(), p.kind.as_str())
            if g != group.as_str() {
                group = g.to_string()
                if !rows.is_empty() { y += 10.0 * u }
                let (name, _) = group_title(g)
                rows.push(
                    NavRow {
                        group: group.clone(),
                        path: String::new(),
                        lines: Vec::from([take name]),
                        y,
                        h: title * u,
                    },
                )
                y += title * u
            }
            if !is_open(s, g) { continue }
            let label = nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str())
            let lines = wrap(s.fonts, label.as_str(), SMALL * u, f.nav - 48.0 * u, 2)
            let h = (pad + 20.0 * f32(lines.len())) * u
            rows.push(NavRow { group: group.clone(), path: p.path.clone(), lines, y, h })
            y += h
            if finger && p.path == s.shown {
                for (label, anchor, _, level) in outline(s) {
                    if level > 2 && is_module(s) { continue }
                    let lines = wrap(s.fonts, label.as_str(), 13.0 * u, f.nav - 64.0 * u, 2)
                    let h = (18.0 + 18.0 * f32(lines.len())) * u
                    rows.push(
                        NavRow {
                            group: group.clone(),
                            path: p.path.clone(),
                            lines,
                            y,
                            h,
                            anchor: anchor.clone(),
                        },
                    )
                    y += h
                }
            }
        }
        s.nav = take rows
    }
    s.nav_scroll = clamp(s.nav_scroll, 0.0, scroll_room(s, f, nav: true))
}

/// The bottom of the list's last row, from the list's top, with room under it.
fn nav_end(s: Docs) -> f32 {
    if s.nav.is_empty() { return 0.0 }
    borrow last = s.nav[s.nav.len() - 1]
    last.y + last.h + 24.0 * s.u
}

/// The list's rows where they are on the screen now.
fn nav_rows(s: Docs, f: Frame) -> Vec<NavRow> {
    let top = f.header - s.nav_scroll
    Vec::from_fn(s.nav.len(), |i| {
        var row = s.nav[i].clone()
        row.y += top
        take row
    })
}

/// Whether group `g`'s pages are listed.
fn is_open(s: Docs, g: str) -> bool {
    for o in s.open {
        if o.as_str() == g { return true }
    }
    false
}

/// The list shows the page being read: its group opens.
fn open_shown_group(s: mut Docs) {
    var shown_group: Option<String> = None
    for p in s.index.pages {
        if p.path == s.shown {
            shown_group = Some(group_of(p.path.as_str(), p.kind.as_str()).to_string())
        }
    }
    if let Some(g) = shown_group {
        if !is_open(s, g.as_str()) { toggle_group(mut s, g.as_str()) }
    }
}

/// Opens group `g`'s pages in the list, or closes them.
fn toggle_group(s: mut Docs, g: str) {
    if is_open(s, g) {
        s.open.retain(|o| o.as_str() != g)
    } else { s.open.push(g.to_string()) }
    s.nav_dirty = true
}

/// The groups, in the list's order.
fn groups_in(index: Index) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for p in index.pages {
        let g = group_of(p.path.as_str(), p.kind.as_str())
        if out.is_empty() || out[out.len() - 1].as_str() != g { out.push(g.to_string()) }
    }
    take out
}

/// A page's name in the list and on the front page: a section of the spec by its title, a module
/// by its file's name (`arena` of `std/arena.md`, `builtins` of `std/builtins.md`), as its group
/// says whose it is.
fn nav_label(path: str, kind: str, title: str) -> String {
    if kind == "spec" { return title.to_string() }
    var start = path.len()
    while start > 0 && path.byte(start - 1) != 47 { start -= 1 }
    var end = path.len()
    if path.ends_with(".md") { end -= 3 }
    path.slice(from: start, to: max(start, end)).to_string()
}

/// `text` wrapped at spaces to lines at most `width` wide at `size`, at most `most` of them; the
/// last of those is cut with `…` if the text goes on.
fn wrap(fonts: Fonts, text: str, size: f32, width: f32, most: u32) -> Vec<String> {
    borrow font = fonts.font(Face::Sans)
    var lines: Vec<String> = Vec::new()
    var line = String::new()
    var line_start = 0
    var a = 0
    while a < text.len() {
        var e = a
        while e < text.len() && text.byte(e) != 32 { e += 1 }
        let word = text.slice(from: a, to: e)
        let tried = if line.is_empty() { word.to_string() } else { f"{line.as_str()} {word}" }
        if line.is_empty() || font.measure(tried.as_str(), size) <= width {
            if line.is_empty() { line_start = a }
            line = take tried
        } else {
            if lines.len() + 1 >= most {
                // The last line takes the rest, cut to fit.
                lines.push(fit(fonts, text.slice(from: line_start, to: text.len()), size, width))
                return lines
            }
            lines.push(take line)
            line = word.to_string()
            line_start = a
        }
        a = e + 1
    }
    if !line.is_empty() { lines.push(take line) }
    take lines
}

/// What's under `at` in the list: a page (`nav:` its path) or a group's title (`group:` its name).
fn nav_at(s: Docs, at: vec2, f: Frame) -> Option<String> {
    if at.y < f.header { return None }
    for row in nav_rows(s, f) {
        if at.y >= row.y && at.y < row.y + row.h {
            return Some(if row.path.is_empty() {
                f"group:{row.group.as_str()}"
            } else if !row.anchor
                .is_empty() {
                f"here:{row.anchor.as_str()}"
            } else { f"nav:{row.path.as_str()}" })
        }
    }
    None
}

fn result_at(s: Docs, at: vec2, f: Frame) -> Option<u32> {
    let panel = results_panel(s, f)
    if !panel.contains(at) { return None }
    let i = u32((at.y - panel.y - 4.0 * s.u) / (58.0 * s.u))
    if i < s.hits.len() { Some(i) } else { None }
}

/// Where search's results are: under its box, wider than it to its left, on the screen; with a
/// line under them that says which keys work, where there's a keyboard.
fn results_panel(s: Docs, f: Frame) -> Rect {
    let u = s.u
    let x = max(f.search.x - 200.0 * u, 12.0 * u)
    let n = s.hits.len()
    let h = if n == 0 { 52.0 * u } else { f32(n) * 58.0 * u + 8.0 * u }
    let keys = if f.beside { KEYS * u } else { 0.0 }
    Rect::new(x, f.search.bottom() + 8.0 * u, f.search.right() - x, h + keys)
}

/// How tall the line of keys under search's results is.
const KEYS: f32 = 40.0

// ---- the outline, and the links under the page --------------------------------------------------

/// A link drawn beside or under the page's text: where it is on the screen, where it leads, what
/// it says and what it is.
struct Extra: Clone {
    rect: Rect,
    target: String,
    label: String,
    kind: ExtraKind,
    /// An outline row's heading level: 2, or 3 for a module's item under its type.
    level: u32 = 2,
}

enum ExtraKind: Copy + Eq {
    /// A row of the page's outline, and whether it's the section being read.
    Outline(bool),
    Previous,
    Next,
    /// The page as the Markdown it's read from, and a copy of it, for an agent.
    Markdown,
    Copy,
}

/// The page's outline: a spec page's sections, or a module's items (its types and functions, and
/// under each type its own items, by their own names), each with its anchor, its top on the page
/// and its level.
fn outline(s: Docs) -> Vec<(String, String, f32, u32)> {
    var rows: Vec<(String, String, f32, u32)> = Vec::new()
    let module = is_module(s)
    for b in s.blocks {
        if b.kind != Kind::Heading || !(b.level == 2 || (module && b.level == 3)) { continue }
        for (a, y) in s.laid.anchors {
            if a == b.anchor {
                let words = plain(b.runs)
                let label = if b.level == 3 { last_name(words.as_str()).to_string() } else {
                    take words
                }
                rows.push((take label, a.clone(), y, b.level))
                break
            }
        }
    }
    take rows
}

/// Whether the page being read is a module's, whose headings are its items: not the spec's, nor
/// one that couldn't be opened.
fn is_module(s: Docs) -> bool {
    !s.shown.is_empty() && !s.shown.as_str().starts_with("spec/") && s.missed.is_empty()
}

/// A path's last name: `insert` of `Arena::insert`.
fn last_name(t: str) -> borrow str {
    var k = t.len()
    while k >= 2 && !(t.byte(k - 1) == 58 && t.byte(k - 2) == 58) { k -= 1 }
    if k < 2 { t } else { t.slice(from: k, to: t.len()) }
}

/// The pages before and after the one being read, in the list's order: each its title and path.
fn neighbours(s: Docs) -> (Option<(String, String)>, Option<(String, String)>) {
    borrow pages = s.index.pages
    for i in 0..pages.len() {
        if pages[i].path != s.shown { continue }
        let before = if i > 0 {
            Some((pages[i - 1].title.clone(), pages[i - 1].path.clone()))
        } else { None }
        let after = if i + 1 < pages.len() {
            Some((pages[i + 1].title.clone(), pages[i + 1].path.clone()))
        } else { None }
        return (before, after)
    }
    (None, None)
}

/// The page's extras on this screen: its outline at the right, where there's room, with the
/// section being read among the rows that fit; its neighbours under its text; and its Markdown,
/// under the outline or under the neighbours.
fn extras(s: Docs, f: Frame) -> Vec<Extra> {
    var out: Vec<Extra> = Vec::new()
    if s.shown.is_empty() || s.shown != s.route.page || s.blocks.is_empty() { return out }
    // A page that couldn't be opened has no neighbours and no Markdown.
    if s.index.page(s.shown.as_str()).is_none() { return out }
    let u = s.u
    let markdown = f"file:{s.shown.as_str()}"
    if f.rail.w > 0.0 {
        let rows = outline(s)
        let row = 26.0 * u
        let top = f.rail.y + 32.0 * u
        let fits = max(u32(max(f.rail.h - 88.0 * u, 0.0) / row), 1)
        // The section being read: the last whose heading is above the reader's eye; none above
        // the first.
        var here: Option<u32> = None
        for i in 0..rows.len() {
            if rows[i].2 <= s.scroll + 48.0 * u { here = Some(i) }
        }
        let at = here.unwrap_or(0)
        let first = if rows.len() <= fits { 0 } else {
            min(at - min(at, fits / 3), rows.len() - fits)
        }
        // Each row as tall as its label's lines, while they fit.
        var y = top
        var n = 0
        for i in first..rows.len() {
            let lines = outline_lines(s, rows[i].0.as_str(), rows[i].3, f.rail.w).len()
            let h = row + f32(lines - 1) * OUTLINE_LINE * u
            if n > 0 && y + h > top + f32(fits) * row { break }
            out.push(
                Extra {
                    rect: Rect::new(f.rail.x, y, f.rail.w, h),
                    target: f"here:{rows[i].1.as_str()}",
                    label: rows[i].0.clone(),
                    kind: ExtraKind::Outline(here == Some(i)),
                    level: rows[i].3,
                },
            )
            y += h
            n += 1
        }
        // Under the outline, or at its place where the page has no sections.
        let my = if n == 0 { f.rail.y } else { y + 20.0 * u }
        out.push(copy_page(s, Rect::new(f.rail.x, my, f.rail.w, row)))
        out.push(
            Extra {
                rect: Rect::new(f.rail.x, my + row, f.rail.w, row),
                target: markdown.clone(),
                label: String::from("Open as Markdown"),
                kind: ExtraKind::Markdown,
            },
        )
    }
    let foot = f.top + s.laid.height + 40.0 * u - s.scroll
    let w = min(f.w, MEASURE * u)
    let half = (w - 16.0 * u) * 0.5
    let (before, after) = neighbours(s)
    if let Some((title, path)) = before {
        out.push(
            Extra {
                rect: Rect::new(f.x, foot + 20.0 * u, half, 60.0 * u),
                target: f"nav:{path.as_str()}",
                label: title.clone(),
                kind: ExtraKind::Previous,
            },
        )
    }
    if let Some((title, path)) = after {
        out.push(
            Extra {
                rect: Rect::new(f.x + w - half, foot + 20.0 * u, half, 60.0 * u),
                target: f"nav:{path.as_str()}",
                label: title.clone(),
                kind: ExtraKind::Next,
            },
        )
    }
    if f.rail.w <= 0.0 {
        let half = min(w * 0.5, 200.0 * u)
        out.push(copy_page(s, Rect::new(f.x, foot + 100.0 * u, half, 26.0 * u)))
        out.push(
            Extra {
                rect: Rect::new(f.x + half, foot + 100.0 * u, half, 26.0 * u),
                target: markdown,
                label: String::from("Open as Markdown"),
                kind: ExtraKind::Markdown,
            },
        )
    }
    take out
}

/// The button that copies the page's Markdown, at `rect`, which says how its copy went.
fn copy_page(s: Docs, rect: Rect) -> Extra {
    Extra {
        rect,
        target: String::from("copy:page"),
        label: copy_said(s, "copy:page").unwrap_or(String::from("Copy as Markdown")),
        kind: ExtraKind::Copy,
    }
}

/// The extras: the outline under its title, with a hairline down it and the section being read
/// marked in the field's light; under the page, a rule, then its neighbours, each its title under
/// what it is; the page's Markdown as a link.
fn draw_extras(s: mut Docs, f: Frame) {
    let ex = extras(s, f)
    if ex.is_empty() { return }
    let u = s.u
    s.list.push_clip(Rect::new(0.0, f.header, s.screen.x, s.screen.y - f.header))
    var rows_top = -1.0
    var rows_bottom = 0.0
    var foot_top = -1.0
    for e in ex {
        match e.kind {
            ExtraKind::Outline(_) => {
                if rows_top < 0.0 { rows_top = e.rect.y }
                rows_bottom = e.rect.bottom()
            },
            ExtraKind::Previous | ExtraKind::Next => if foot_top < 0.0 { foot_top = e.rect.y },
            ExtraKind::Markdown | ExtraKind::Copy => {},
        }
    }
    if rows_top >= 0.0 {
        s.fonts.sans.weight = theme::BOLD
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            "On this page",
            12.5 * u,
            vec2(f.rail.x, f.rail.y + 4.0 * u),
            hex(s.p.quiet),
        )
        s.fonts.sans.weight = 0.0
        s.list.rect(
            Rect::new(f.rail.x, rows_top, max(1.0, u), rows_bottom - rows_top),
            hex(s.p.rule),
        )
    }
    // A rule over the neighbours, unless the page ends with its own.
    let ends_ruled = s.blocks.len() > 0 && s.blocks[s.blocks.len() - 1].kind == Kind::Rule
    if foot_top >= 0.0 && !ends_ruled {
        let w = min(f.w, MEASURE * u)
        s.list.rect(Rect::new(f.x, foot_top - 20.0 * u, w, max(1.0, u)), hex(s.p.rule))
    }
    for e in ex {
        let hover = e.rect.contains(s.pointer)
        match e.kind {
            ExtraKind::Outline(here) => {
                if here {
                    s.list.rect(
                        Rect::new(e.rect.x, e.rect.y + 4.0 * u, 2.0 * u, e.rect.h - 8.0 * u),
                        hex(s.p.field),
                        radius: u,
                    )
                }
                // A module's items are names, set in the code face; an item under its type is
                // indented under it. A section's long title takes two lines.
                let face = if is_module(s) { Face::Mono } else { Face::Sans }
                let size = (if face == Face::Mono { 12.5 } else { 13.5 }) * u
                let indent = (14.0 + (if e.level > 2 { 14.0 } else { 0.0 })) * u
                let color = if here { hex(s.p.strong) } else if hover { hex(s.p.text) } else {
                    hex(s.p.quiet)
                }
                let lines = outline_lines(s, e.label.as_str(), e.level, e.rect.w)
                for k in 0..lines.len() {
                    let _ = s.list.text(
                        s.fonts,
                        face,
                        lines[k].as_str(),
                        size,
                        vec2(
                            e.rect.x + indent,
                            e.rect.y + (4.0 + f32(k) * OUTLINE_LINE + (if face == Face::Mono {
                                1.0
                            } else { 0.0 })) * u,
                        ),
                        color,
                    )
                }
            },
            ExtraKind::Previous | ExtraKind::Next => {
                let next = e.kind == ExtraKind::Next
                let what = if next { "Next" } else { "Previous" }
                let title = fit(s.fonts, e.label.as_str(), BODY * u, e.rect.w)
                let ww = s.fonts.font(Face::Sans).measure(what, 13.0 * u)
                let tw = s.fonts.font(Face::Sans).measure(title.as_str(), BODY * u)
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    what,
                    13.0 * u,
                    vec2(if next { e.rect.right() - ww } else { e.rect.x }, e.rect.y + 6.0 * u),
                    hex(s.p.quiet),
                )
                s.fonts.sans.weight = theme::HEADING
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    title.as_str(),
                    BODY * u,
                    vec2(if next { e.rect.right() - tw } else { e.rect.x }, e.rect.y + 28.0 * u),
                    hex(if hover { s.p.field } else { s.p.strong }),
                )
                s.fonts.sans.weight = 0.0
            },
            ExtraKind::Markdown | ExtraKind::Copy => {
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    e.label.as_str(),
                    13.5 * u,
                    vec2(e.rect.x + (if f.rail.w > 0.0 { 14.0 * u } else {
                        0.0
                    }), e.rect.y + 4.0 * u),
                    hex(if hover { s.p.strong } else { s.p.field }),
                )
            },
        }
    }
    s.list.pop_clip()
}

/// How far apart an outline row's lines are.
const OUTLINE_LINE: f32 = 19.0

/// An outline row's label as the lines it's set on in a rail `width` wide: a module's item, a
/// name in the code face, on one line, cut if it must be; a section's title on up to two.
fn outline_lines(s: Docs, label: str, level: u32, width: f32) -> Vec<String> {
    let u = s.u
    let room = width - (14.0 + (if level > 2 { 14.0 } else { 0.0 })) * u - 2.0 * u
    if is_module(s) { return Vec::from([fit_in(s.fonts, Face::Mono, label, 12.5 * u, room)]) }
    wrap(s.fonts, label, 13.5 * u, room, 2)
}

/// The extra under `at`, if there is one: its target.
fn extra_at(s: Docs, at: vec2, f: Frame) -> Option<String> {
    if at.y < f.header { return None }
    for e in extras(s, f) {
        if e.rect.contains(at) { return Some(e.target.clone()) }
    }
    None
}

/// The page's title, as the browser's tab and history show it.
fn title_of(s: Docs) -> String {
    for p in s.index.pages {
        if p.path == s.shown { return f"{p.title.as_str()} | Wrela docs" }
    }
    String::from("Wrela docs")
}

// ---- layout and drawing ------------------------------------------------------------------------

fn keep_laid_out(s: mut Docs, f: Frame) {
    if s.laid_width == f.w {
        // A place on the page being read: it glides there.
        seek(mut s, f, glide: true)
        return
    }
    if s.shown.is_empty() {
        s.blocks = parse(front(s.index).as_str())
    }
    s.laid = lay_out(s.blocks, s.fonts, f.w, s.u, is_module(s), s.p)
    s.laid_width = f.w
    let (text, starts) = s.laid.text()
    s.lowered = lower(text.as_str())
    s.text = take text
    s.starts = take starts
    s.selected = None
    // Each figure's field, keeping its turn where the block is the same.
    var lives: Vec<Live> = Vec::new()
    for fig in s.laid.figures {
        let code = s.blocks[fig.block].code.clone()
        var turn = 0.7
        var tilt = 0.32
        var mode = SURFACE
        for l in s.lives {
            if l.block == fig.block {
                turn = l.turn
                tilt = l.tilt
                mode = l.mode
            }
        }
        let r = read(code.as_str(), 0.0)
        s.changes += 1
        lives.push(Live { block: fig.block, code, read: r, turn, tilt, mode, version: s.changes })
    }
    s.lives = take lives
    // Images of figures no longer on the page go.
    var kept: Vec<FigureImage> = Vec::new()
    while !s.images.is_empty() {
        let image = s.images.pop().unwrap()
        var shown = false
        for fig in s.laid.figures {
            if fig.block == image.block { shown = true }
        }
        if shown { kept.push(take image) }
    }
    s.images = take kept
    s.knob_held = None
    s.orbit = None
    // A place kept at another width may be past the page's end at this one.
    s.scroll = clamp(s.scroll, 0.0, max_scroll(s, f))
    // The list of pages lists the page's sections over the page.
    if !f.beside { s.nav_dirty = true }
    refresh_matches(mut s, f)
    seek(mut s, f, glide: false)
}

/// Scrolls to the anchor the reader asked for, once the page is laid out: gliding there on the
/// page being read, at once on a page just shown.
fn seek(s: mut Docs, f: Frame, glide: bool) {
    let Some(anchor) = s.seek else { return }
    if s.shown != s.route.page { return }
    for (a, y) in s.laid.anchors {
        if a == anchor {
            let to = clamp(y - 8.0 * s.u, 0.0, max_scroll(s, f))
            if glide { s.glide = Some(to) } else {
                s.scroll = to
                s.glide = None
            }
            break
        }
    }
    s.seek = None
}

fn mark_ems(s: Docs) -> f32 {
    15.0 * s.u / facet::CAP
}

fn mark_right(s: Docs, f: Frame) -> f32 {
    mark_left(s, f) + MARK_WIDTH * mark_ems(s) + 80.0 * s.u
}

fn mark_left(s: Docs, f: Frame) -> f32 {
    if f.beside { 28.0 * s.u } else { 64.0 * s.u }
}

fn draw_all(s: mut Docs, f: Frame) {
    let u = s.u
    let screen = s.screen
    s.list.clear(screen)
    // The page.
    s.list.push_clip(Rect::new(0.0, f.header, screen.x, screen.y - f.header))
    // A page just shown comes in: it rises a few pixels and its ink deepens.
    let appear = if s.reduced { 1.0 } else { smoothstep(0.0, APPEAR, s.time - s.shown_at) }
    let origin = vec2(f.x, f.top - s.scroll + (1.0 - appear) * 8.0 * u)
    for sh in s.laid.shapes {
        let r = Rect::new(sh.rect.x + origin.x, sh.rect.y + origin.y, sh.rect.w, sh.rect.h)
        if r.bottom() < f.header || r.y > screen.y { continue }
        s.list.rect(r, vec4(sh.color.xyz, sh.color.w * appear), radius: sh.radius)
    }
    if s.finding {
        let n = lower(s.find.as_str()).len()
        for i in 0..s.matches.len() {
            let a = s.matches[i]
            mark_range(mut s, a, a + n, origin, f, hex(s.p.field, if i == s.current { 0.55 } else {
                0.2
            }))
        }
    }
    if let Some((a, b)) = s.selected {
        if a != b { mark_range(mut s, min(a, b), max(a, b), origin, f, hex(s.p.selection, 0.55)) }
    }
    // The number under the pointer, or held, that drags.
    for i in 0..s.laid.knobs.len() {
        let held = match s.knob_held {
            Some((k, _, _, unsure)) => k == i && !unsure,
            None => false,
        }
        let r = knob_rect(s, f, i)
        if held || (s.knob_held.is_none() && r.contains(s.pointer)) {
            s.list.rect(r, hex(s.p.field, if held { 0.28 } else { 0.16 }), radius: 4.0 * u)
        }
    }
    for p in s.laid.pieces {
        let y = p.at.y + origin.y
        if y > screen.y || y + p.size * 2.0 < f.header { continue }
        s.fonts.font_mut(p.face).weight = p.weight
        let _ = s.list.text(
            s.fonts,
            p.face,
            p.text.as_str(),
            p.size,
            vec2(p.at.x + origin.x, y),
            vec4(p.color.xyz, p.color.w * appear),
        )
    }
    s.fonts.sans.weight = 0.0
    s.fonts.mono.weight = 0.0
    if !s.trouble.is_empty() {
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            s.trouble.as_str(),
            15.0 * u,
            vec2(f.x, f.header + 24.0 * u),
            hex(s.p.quiet),
        )
    } else if s.blocks.is_empty() && !s.loading.is_empty() && s.shown != s.route.page {
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            "Opening the page…",
            15.0 * u,
            vec2(f.x, f.top),
            hex(s.p.quiet),
        )
    }
    s.list.pop_clip()
    draw_figure_overlays(mut s, f)
    draw_controls(mut s, f)
    draw_extras(mut s, f)
    draw_scrollbar(mut s, f, nav: false)
    draw_nav(mut s, f)
    draw_header(mut s, f)
    if s.page_load.is_some() && s.trouble.is_empty() { draw_loading(mut s, f) }
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    // Figures whose image is out of date, into their images, before the screen's pass.
    draw_images(mut s, f)
    let pass = begin_screen_pass(clear: hex(s.p.page))
    // The fields first, under the quads: the front page's opening, then the header band.
    if s.route.page.is_empty() {
        let h = opening_height(s, f.beside)
        let ems = opening_ems(s, f.beside)
        let centre = vec2(f.x + MARK_WIDTH * ems * 0.5, f.header + h * 0.52 - s.scroll)
        let foot = f.header + h - s.scroll
        mark_field(
            s,
            pass,
            Rect::new(0.0, f.header - s.scroll, screen.x, h),
            centre,
            ems,
            11.0 * u,
            150.0 * u,
            0.42,
            foot,
            h * 0.45,
            moving: true,
            disc: 46.0 * u,
        )
    }
    let ems = mark_ems(s)
    let centre = vec2(mark_left(s, f) + MARK_WIDTH * ems * 0.5, f.header * 0.5)
    mark_field(
        s,
        pass,
        Rect::new(x: 0.0, y: 0.0, w: screen.x, h: f.header),
        centre,
        ems,
        6.0 * u,
        34.0 * u,
        0.3,
        f.header,
        0.0,
        moving: false,
        disc: 14.0 * u,
    )
    draw_figures(s, pass, f)
    s.renderer.draw(pass, screen)
    pass.present()
}

/// The mark at `centre` in its field, over `rect`: its lines `spacing` apart, fading over `reach`
/// and drawn at `strength`; its foot fading into the page over `soft` pixels above `foot`.
fn mark_field(
    s: Docs,
    pass: std::gpu::ScreenPass,
    rect: Rect,
    centre: vec2,
    ems: f32,
    spacing: f32,
    reach: f32,
    strength: f32,
    foot: f32,
    soft: f32,
    moving: bool,
    disc: f32,
) {
    // The front page's lines drift outward a spacing every four seconds, unless the system asks
    // for less motion; the header's stay still beside what's being read.
    let drift = if s.reduced || !moving { 0.0 } else { s.time * 0.25 }
    draw(
        pass,
        quad.bind(screen: s.screen, rect: vec4(rect.x, rect.y, rect.w, rect.h)),
        field.bind(
            runs: s.mark,
            look: Look {
                centre,
                ems,
                count: MARK_RUNS.len(),
                spacing,
                reach,
                drift,
                ground: hex(VOID),
                line: hex(DARK.field, strength),
                ink: hex(0xF4F5F7),
                pointer: vec4(s.hover_at, disc, s.hover),
                foot,
                soft,
                below: hex(s.p.page),
            },
        ),
        vertices: 6,
    )
}

/// While a page is on its way, a short bar of the field's light runs along the header's foot;
/// it stays still when the system asks for less motion.
fn draw_loading(s: mut Docs, f: Frame) {
    let u = s.u
    let w = s.screen.x * 0.25
    let t = if s.reduced { 0.5 } else { s.time * 0.8 - floor(s.time * 0.8) }
    let x = -w + (s.screen.x + w) * t
    s.list.rect(Rect::new(x, f.header - 2.0 * u, w, 2.0 * u), hex(DARK.field))
}

/// Marks bytes `a` to `b` of the page's text, piece by piece, behind the text.
fn mark_range(s: mut Docs, a: u32, b: u32, origin: vec2, f: Frame, color: vec4) {
    if a >= b || s.starts.is_empty() { return }
    var i = piece_of(s, a)
    while i < s.laid.pieces.len() && s.starts[i] < b {
        borrow p = s.laid.pieces[i]
        let start = s.starts[i]
        let end = start + p.text.len()
        if end > a {
            let from = if a > start { a - start } else { 0 }
            let to = if b < end { b - start } else { p.text.len() }
            borrow font = s.fonts.font(p.face)
            let x0 = font.caret_at(p.text.as_str(), p.size, from)
            let x1 = font.caret_at(p.text.as_str(), p.size, to)
            let y = p.at.y + origin.y
            if y < s.screen.y && y + p.size * 1.4 > f.header {
                let r = Rect::new(p.at.x + origin.x + x0, y - p.size * 0.12, x1 - x0, p.size * 1.32)
                s.list.rect(r, color, radius: 2.0 * s.u)
            }
        }
        i += 1
    }
}

/// The list of pages: each group's title strong, with its package and a chevron that says whether
/// it's open, over its pages; the page being read marked in the field's light. On a narrow screen
/// it opens over the page, which dims under it.
fn draw_nav(s: mut Docs, f: Frame) {
    if !f.beside && !s.nav_open { return }
    let u = s.u
    let screen = s.screen
    if !f.beside {
        s.list.rect(Rect::new(0.0, f.header, screen.x, screen.y - f.header), hex(VOID, 0.45))
    }
    let r = Rect::new(0.0, f.header, f.nav, screen.y - f.header)
    s.list.rect(r, hex(if f.beside { s.p.page } else { s.p.surface }))
    s.list.rect(
        Rect::new(f.nav - max(1.0, u), f.header, max(1.0, u), screen.y - f.header),
        hex(s.p.rule),
    )
    s.list.push_clip(r)
    // A page just shown is brought into the list's view, a third of the way down; over the page,
    // where its sections follow it, to the list's top.
    if s.nav_follow && !s.nav.is_empty() {
        s.nav_follow = false
        for row in nav_rows(s, f) {
            let out = row.y < f.header + 24.0 * u || row.y + row.h > screen.y - 40.0 * u
            if !row.path.is_empty() &&
                row.anchor.is_empty() &&
                row.path == s.shown &&
                (out || !f.beside) {
                let want = if f.beside { f.header + (screen.y - f.header) / 3.0 } else {
                    f.header + 12.0 * u
                }
                s.nav_scroll = max(s.nav_scroll + row.y - want, 0.0)
            }
        }
    }
    let over = s.pointer.x < f.nav && s.pointer.y > f.header
    for row in nav_rows(s, f) {
        if row.y > screen.y || row.y + row.h < f.header { continue }
        let hover = over && s.pointer.y >= row.y && s.pointer.y < row.y + row.h
        if row.path.is_empty() {
            let (name, pkg) = group_title(row.group.as_str())
            s.fonts.sans.weight = theme::BOLD
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                name.as_str(),
                SMALL * u,
                vec2(24.0 * u, row.y + 9.0 * u),
                hex(s.p.strong),
            )
            s.fonts.sans.weight = 0.0
            if !pkg.is_empty() {
                let nw = s.fonts.font(Face::Sans).measure(name.as_str(), SMALL * u)
                let _ = s.list.text(
                    s.fonts,
                    Face::Mono,
                    pkg.as_str(),
                    12.0 * u,
                    vec2(24.0 * u + nw + 8.0 * u, row.y + 11.0 * u),
                    hex(s.p.quiet),
                )
            }
            // The chevron: down when the group is open, right when it's closed.
            let c = vec2(f.nav - 28.0 * u, row.y + row.h * 0.5 + 0.5 * u)
            let k = 3.5 * u
            let color = hex(if hover { s.p.strong } else { s.p.quiet })
            if is_open(s, row.group.as_str()) {
                s.list.line(vec2(c.x - k, c.y - k * 0.5), vec2(c.x, c.y + k * 0.5), color, 1.5 * u)
                s.list.line(vec2(c.x, c.y + k * 0.5), vec2(c.x + k, c.y - k * 0.5), color, 1.5 * u)
            } else {
                s.list.line(vec2(c.x - k * 0.5, c.y - k), vec2(c.x + k * 0.5, c.y), color, 1.5 * u)
                s.list.line(vec2(c.x + k * 0.5, c.y), vec2(c.x - k * 0.5, c.y + k), color, 1.5 * u)
            }
            continue
        }
        // A section of the page being read: indented under it, smaller, along a hairline.
        if !row.anchor.is_empty() {
            s.list.rect(Rect::new(26.0 * u, row.y, max(1.0, u), row.h), hex(s.p.rule))
            for k in 0..row.lines.len() {
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    row.lines[k].as_str(),
                    13.0 * u,
                    vec2(
                        40.0 * u,
                        row.y + (row.h - 18.0 * u * f32(row.lines.len())) * 0.5 + f32(k) * 18.0 * u,
                    ),
                    hex(if hover { s.p.text } else { s.p.quiet }),
                )
            }
            continue
        }
        let here = row.path == s.shown
        if here {
            s.list.rect(
                Rect::new(14.0 * u, row.y + 5.0 * u, 2.0 * u, row.h - 10.0 * u),
                hex(s.p.field),
                radius: u,
            )
        }
        let color = if here { hex(s.p.strong) } else if hover { hex(s.p.text) } else {
            hex(s.p.quiet)
        }
        let top = (row.h - 20.0 * u * f32(row.lines.len())) * 0.5
        for k in 0..row.lines.len() {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                row.lines[k].as_str(),
                SMALL * u,
                vec2(24.0 * u, row.y + top + f32(k) * 20.0 * u),
                color,
            )
        }
    }
    s.list.pop_clip()
    draw_scrollbar(mut s, f, nav: true)
}

/// The header band, in the console's dark whatever the page's scheme: the mark and what this site
/// is, on a narrow screen the button that opens the list, and search's box, with what search
/// found under it.
fn draw_header(s: mut Docs, f: Frame) {
    let u = s.u
    let d = DARK
    let ems = mark_ems(s)
    let x = mark_left(s, f) + MARK_WIDTH * ems + 14.0 * u
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        "docs",
        15.0 * u,
        vec2(x, f.header * 0.5 - 10.5 * u),
        hex(d.quiet),
    )
    if !f.beside {
        // The button that opens the list of pages: three short lines.
        for k in 0..3 {
            s.list.rect(
                Rect::new(20.0 * u, f.header * 0.5 - 6.0 * u + f32(k) * 5.5 * u, 18.0 * u, 1.5 * u),
                hex(d.text),
                radius: u,
            )
        }
    }
    let b = f.search
    let hover = b.contains(s.pointer)
    s.list.rect(b, hex(0x101215), radius: 8.0 * u)
    s.list.ring(b, hex(if s.searching || s.finding { d.field } else if hover { 0x3A3F47 } else {
        d.rule
    }), radius: 8.0 * u, width: max(1.0, u))
    let tx = b.x + 14.0 * u
    let ty = b.y + b.h * 0.5 - 10.0 * u
    if !s.searching && !s.finding {
        // A short word where the box is narrow; the key that opens search where there's a keyboard
        // beside it.
        let wide = b.w >= 220.0 * u
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            if wide { "Search the docs" } else { "Search" },
            15.0 * u,
            vec2(tx, ty),
            hex(d.quiet),
        )
        if wide && f.beside {
            let _ = s.list.text(
                s.fonts,
                Face::Mono,
                "/",
                13.0 * u,
                vec2(b.right() - 26.0 * u, ty + 1.0 * u),
                hex(d.quiet),
            )
        }
        return
    }
    let text = if s.finding { s.find.clone() } else { s.query.clone() }
    // Find says how many matches, at the box's right.
    var right = b.right() - 14.0 * u
    if s.finding && !s.find.is_empty() {
        let count = if s.matches.is_empty() { String::from("No matches") } else {
            f"{s.current + 1} of {s.matches.len()}"
        }
        let cw = s.fonts.font(Face::Sans).measure(count.as_str(), 13.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            count.as_str(),
            13.0 * u,
            vec2(b.right() - cw - 14.0 * u, ty + 1.5 * u),
            hex(d.quiet),
        )
        right -= cw + 12.0 * u
    }
    // What's typed stays in the box: it slides left so the caret stays in view.
    let room = max(right - tx, 1.0)
    let caret = caret_x(s, text.as_str(), s.caret)
    let shift = max(caret + 3.0 * u - room, 0.0)
    s.list.push_clip(Rect::new(tx - 2.0 * u, b.y, room + 4.0 * u, b.h))
    if s.other_end != s.caret {
        let other = caret_x(s, text.as_str(), s.other_end)
        let x0 = tx - shift + min(caret, other)
        s.list.rect(
            Rect::new(x0, b.y + 8.0 * u, abs(caret - other), b.h - 16.0 * u),
            hex(d.selection, 0.8),
            radius: 2.0 * u,
        )
    }
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        text.as_str(),
        15.0 * u,
        vec2(tx - shift, ty),
        hex(d.strong),
    )
    draw_caret(mut s, tx - shift + caret, b, hex(d.field))
    s.list.pop_clip()
    if s.finding && s.find.is_empty() {
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            "Find on this page",
            15.0 * u,
            vec2(tx + 4.0 * u, ty),
            hex(d.quiet),
        )
    }
    if s.searching { draw_results(mut s, f) }
}

/// The caret in box `b`'s text, which starts at `tx`; steady when the system asks for less motion.
fn draw_caret(s: mut Docs, tx: f32, b: Rect, color: vec4) {
    let u = s.u
    let on = s.reduced || (s.time * 2.0) - floor(s.time * 2.0) < 0.6
    if on { s.list.rect(Rect::new(tx + 1.0 * u, b.y + 9.0 * u, 1.5 * u, b.h - 18.0 * u), color) }
}

/// How far into `text`, at the box's size, byte `at` is.
fn caret_x(s: Docs, text: str, at: u32) -> f32 {
    s.fonts.font(Face::Sans).measure(text.slice(from: 0, to: min(at, text.len())), 15.0 * s.u)
}

/// Search's results under its box: each its name, with the words searched for marked, what it is
/// at the right (an item's kind, or the spec), and under them what it says or where it is.
fn draw_results(s: mut Docs, f: Frame) {
    let u = s.u
    let row = 58.0 * u
    let panel = results_panel(s, f)
    let x = panel.x
    let w = panel.w
    let top = panel.y
    let n = s.hits.len()
    s.list.rect(panel, hex(s.p.surface), radius: 10.0 * u)
    s.list.ring(panel, hex(s.p.rule), radius: 10.0 * u, width: max(1.0, u))
    if f.beside { draw_keys(mut s, panel) }
    if n == 0 {
        let hint = if s.query.is_empty() {
            "Type a name, such as Arena or smooth_union, or words from the spec."
        } else { "Nothing matches. Try a name, like Arena, or a word from the spec." }
        let shown = fit(s.fonts, hint, 14.0 * u, w - 32.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            shown.as_str(),
            14.0 * u,
            vec2(x + 16.0 * u, top + 16.0 * u),
            hex(s.p.quiet),
        )
        return
    }
    let words = lower(s.query.as_str())
    s.list.push_clip(panel)
    for i in 0..n {
        let y = top + 4.0 * u + f32(i) * row
        let h = s.hits[i]
        if i == s.chosen {
            s.list.rect(
                Rect::new(x + 4.0 * u, y, w - 8.0 * u, row),
                hex(s.p.chosen),
                radius: 7.0 * u,
            )
        }
        let (title, under) = result_text(s.index, h)
        let what = if h.item { s.index.items[h.at].kind.clone() } else { String::from("spec") }
        let ww = s.fonts.font(Face::Mono).measure(what.as_str(), 12.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            what.as_str(),
            12.0 * u,
            vec2(x + w - 16.0 * u - ww, y + 11.0 * u),
            hex(s.p.quiet),
        )
        let face = if h.item { Face::Mono } else { Face::Sans }
        let size = (if h.item { 13.5 } else { 15.0 }) * u
        let name = fit_in(s.fonts, face, title.as_str(), size, w - 44.0 * u - ww)
        mark_words(
            mut s,
            name.as_str(),
            words.as_str(),
            face,
            size,
            vec2(x + 16.0 * u, y + 9.0 * u),
        )
        let _ = s.list.text(
            s.fonts,
            face,
            name.as_str(),
            size,
            vec2(x + 16.0 * u, y + 9.0 * u),
            hex(s.p.strong),
        )
        let shown = fit(s.fonts, under.as_str(), 13.0 * u, w - 32.0 * u)
        mark_words(
            mut s,
            shown.as_str(),
            words.as_str(),
            Face::Sans,
            13.0 * u,
            vec2(x + 16.0 * u, y + 32.0 * u),
        )
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            shown.as_str(),
            13.0 * u,
            vec2(x + 16.0 * u, y + 32.0 * u),
            hex(s.p.quiet),
        )
    }
    s.list.pop_clip()
}

/// The line at the foot of search's panel: the keys that choose a result, open it and close search,
/// each on a key's face.
fn draw_keys(s: mut Docs, panel: Rect) {
    let u = s.u
    let y = panel.bottom() - KEYS * u
    s.list.rect(Rect::new(panel.x, y, panel.w, max(1.0, u)), hex(s.p.rule))
    var x = panel.x + 16.0 * u
    let mid = y + KEYS * u * 0.5
    x = key_cap(mut s, x, mid, "up") + 4.0 * u
    x = key_cap(mut s, x, mid, "down") + 8.0 * u
    x = say(mut s, x, mid, "to choose") + 18.0 * u
    x = key_cap(mut s, x, mid, "Enter") + 8.0 * u
    x = say(mut s, x, mid, "to open") + 18.0 * u
    x = key_cap(mut s, x, mid, "Esc") + 8.0 * u
    let _ = say(mut s, x, mid, "to close")
}

/// A key's face from `x`, centred on `mid`: its name, or an arrow for `up` and `down`. Where it
/// ends.
fn key_cap(s: mut Docs, x: f32, mid: f32, key: str) -> f32 {
    let u = s.u
    let size = 11.5 * u
    let arrow = key == "up" || key == "down"
    let w = if arrow { 20.0 * u } else {
        s.fonts.font(Face::Mono).measure(key, size) + 12.0 * u
    }
    let cap = Rect::new(x, mid - 10.0 * u, w, 20.0 * u)
    s.list.rect(cap, hex(s.p.page), radius: 4.0 * u)
    s.list.ring(cap, hex(s.p.rule), radius: 4.0 * u, width: max(1.0, u))
    let color = hex(s.p.quiet)
    if arrow {
        let c = vec2(x + w * 0.5, mid)
        let k = 3.5 * u
        let d = if key == "up" { -1.0 } else { 1.0 }
        s.list.line(vec2(c.x - k, c.y - d * k * 0.5), vec2(c.x, c.y + d * k * 0.5), color, 1.5 * u)
        s.list.line(vec2(c.x, c.y + d * k * 0.5), vec2(c.x + k, c.y - d * k * 0.5), color, 1.5 * u)
    } else {
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            key,
            size,
            vec2(x + 6.0 * u, mid - size * 0.68),
            color,
        )
    }
    x + w
}

/// Words from `x`, centred on `mid`, quiet. Where they end.
fn say(s: mut Docs, x: f32, mid: f32, words: str) -> f32 {
    let size = 12.5 * s.u
    let _ = s.list.text(s.fonts, Face::Sans, words, size, vec2(x, mid - size * 0.7), hex(s.p.quiet))
    x + s.fonts.font(Face::Sans).measure(words, size)
}

/// Marks, behind `text` set at `at`, each place a word of `words` (lowercase, between spaces) is.
fn mark_words(s: mut Docs, text: str, words: str, face: Face, size: f32, at: vec2) {
    let low = lower(text)
    var a = 0
    while a < words.len() {
        var e = a
        while e < words.len() && words.byte(e) != 32 { e += 1 }
        if e > a {
            let word = words.slice(from: a, to: e)
            var from = 0
            while from < low.len() {
                let Some(k) = low.as_str().slice(from: from, to: low.len()).find(word) else {
                    break
                }
                let start = from + k
                let end = start + word.len()
                // The lowercase has the text's bytes where they're ASCII, as names and the spec's
                // words are.
                if end <= text.len() {
                    borrow font = s.fonts.font(face)
                    let x0 = font.measure(text.slice(from: 0, to: start), size)
                    let x1 = font.measure(text.slice(from: 0, to: end), size)
                    s.list.rect(
                        Rect::new(at.x + x0 - 1.0, at.y - size * 0.05, x1 - x0 + 2.0, size * 1.3),
                        hex(s.p.field, 0.22),
                        radius: 2.0 * s.u,
                    )
                }
                from = end
            }
        }
        a = e + 1
    }
}

/// A result's title, and what's under it: an item's summary, or the page a section is on. Code's
/// backticks go: the result is plain text.
fn result_text(index: Index, h: Hit) -> (String, String) {
    if h.item {
        (index.items[h.at].path.clone(), unticked(index.items[h.at].summary.as_str()))
    } else {
        let page = index.sections[h.at].page.as_str()
        let title = match index.page(page) {
            Some(p) => index.pages[p].title.clone(),
            None => page.to_string(),
        }
        // What the section says; where it is, if it says nothing first.
        let says = index.sections[h.at].summary.as_str()
        let under = if says.is_empty() { f"In {title.as_str()}" } else { unticked(says) }
        (index.sections[h.at].title.clone(), under)
    }
}

fn unticked(t: str) -> String {
    var out = String::new()
    var start = 0
    for i in 0..t.len() {
        if t.byte(i) == 96 {
            out.push_str(t.slice(from: start, to: i))
            start = i + 1
        }
    }
    out.push_str(t.slice(from: start, to: t.len()))
    take out
}

/// `text` as it fits in `width` at `size`: whole, or cut at a character with `…` after it.
fn fit(fonts: Fonts, text: str, size: f32, width: f32) -> String {
    fit_in(fonts, Face::Sans, text, size, width)
}

/// `text` in `face` as it fits in `width` at `size`.
fn fit_in(fonts: Fonts, face: Face, text: str, size: f32, width: f32) -> String {
    borrow font = fonts.font(face)
    if font.measure(text, size) <= width { return text.to_string() }
    var end = text.len()
    while end > 0 {
        end = previous_cluster(text, end)
        let cut = f"{text.slice(from: 0, to: end).trim()}…"
        if font.measure(cut.as_str(), size) <= width { return cut }
    }
    String::from("…")
}

// ---- the controls over the page ----------------------------------------------------------------

/// A control over the page: a block of code's copy button, or the link beside a section's heading
/// (`copy`, the target it follows, and what it says).
struct Control: Clone {
    rect: Rect,
    target: String,
    label: String,
    copy: bool,
}

/// The controls over the page, where they are on the screen. A section's link shows while the
/// pointer is at its heading, beside the list of pages, where the gutter has room for it; a copy
/// button shows while the pointer is on its code, or after a finger taps it, so it never hides
/// code that's being read. `all` gives every one, shown or not, for the semantic tree.
fn controls(s: Docs, f: Frame, at: vec2, all: bool) -> Vec<Control> {
    var out: Vec<Control> = Vec::new()
    if s.shown != s.route.page { return out }
    let u = s.u
    let origin = vec2(f.x, f.top - s.scroll)
    for i in 0..s.laid.snippets.len() {
        let r = s.laid.snippets[i].rect
        let ground = Rect::new(r.x + origin.x, r.y + origin.y, r.w, r.h)
        let target = f"copy:code:{i}"
        let said = copy_said(s, target.as_str())
        let on_screen = ground.bottom() > f.header && ground.y < s.screen.y
        // A finger's tap puts the pointer where it lands, so a tap on the code shows it too.
        if !all && !(on_screen && (said.is_some() || ground.contains(at))) { continue }
        let label = take said.unwrap_or(String::from("Copy"))
        let w = s.fonts.font(Face::Sans).measure(label.as_str(), 12.5 * u) + 20.0 * u
        let rect = Rect::new(ground.right() - w - 8.0 * u, ground.y + 8.0 * u, w, 26.0 * u)
        out.push(Control { rect, target, label, copy: true })
    }
    if !f.beside { return out }
    for t in s.laid.titles {
        let top = t.rect.y + origin.y
        let row = Rect::new(f.x - 36.0 * u, top, f.w + 36.0 * u, t.rect.h)
        if !all && (top < f.header || !row.contains(at)) { continue }
        out.push(
            Control {
                rect: Rect::new(f.x - 30.0 * u, top, 24.0 * u, t.line),
                target: f"here:{t.anchor.as_str()}",
                label: t.label.clone(),
                copy: false,
            },
        )
    }
    take out
}

/// The controls: a copy button on its code's ground, and `#` in the gutter beside a section's
/// heading, stronger under the pointer.
fn draw_controls(s: mut Docs, f: Frame) {
    let u = s.u
    s.list.push_clip(Rect::new(0.0, f.header, s.screen.x, s.screen.y - f.header))
    for c in controls(s, f, s.pointer, all: false) {
        let hover = c.rect.contains(s.pointer)
        if c.copy {
            s.list.rect(c.rect, hex(s.p.surface), radius: 6.0 * u)
            s.list.ring(
                c.rect,
                hex(if hover { s.p.quiet } else { s.p.rule }),
                radius: 6.0 * u,
                width: max(1.0, u),
            )
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                c.label.as_str(),
                12.5 * u,
                vec2(c.rect.x + 10.0 * u, c.rect.y + 5.0 * u),
                hex(if hover { s.p.strong } else { s.p.quiet }),
            )
        } else {
            let size = 17.0 * u
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                "#",
                size,
                vec2(c.rect.x + 6.0 * u, c.rect.y + (c.rect.h - size * 1.35) * 0.5),
                hex(if hover { s.p.field } else { s.p.quiet }),
            )
        }
    }
    s.list.pop_clip()
}

// ---- live fields --------------------------------------------------------------------------------

/// The live figure of block `block`, if it has one.
fn live_of(s: Docs, block: u32) -> Option<u32> {
    for i in 0..s.lives.len() {
        if s.lives[i].block == block { return Some(i) }
    }
    None
}

/// Where figure `i` is on the screen.
fn figure_rect(s: Docs, f: Frame, i: u32) -> Rect {
    let r = s.laid.figures[i].rect
    Rect::new(r.x + f.x, r.y + f.top - s.scroll, r.w, r.h)
}

/// Where knob `i`'s number is on the screen, with room around it for a finger.
fn knob_rect(s: Docs, f: Frame, i: u32) -> Rect {
    borrow p = s.laid.pieces[s.laid.knobs[i].piece]
    let pad = 3.0 * s.u
    Rect::new(
        p.at.x + f.x - pad,
        p.at.y + f.top - s.scroll - pad,
        p.w + 2.0 * pad,
        p.size * 1.35 + 2.0 * pad,
    )
}

/// How far a keyboard's step moves a number: a hundredth of it where it's 1 or more, else 0.01.
fn knob_step(v: f32) -> f32 {
    max(abs(v), 1.0) * 0.01
}

/// Knob `i`'s number, as its code says now.
fn knob_value(s: Docs, i: u32) -> f32 {
    let k = s.laid.knobs[i]
    let Some(l) = live_of(s, k.block) else { return 0.0 }
    live::number(s.lives[l].code.as_str().slice(from: k.start, to: k.end)).unwrap_or(0.0)
}

/// What knob `i` is to a screen reader: the name it's given in the code (`radius` of
/// `radius: 0.5`), or "number".
fn knob_name(s: Docs, i: u32) -> String {
    let k = s.laid.knobs[i]
    let Some(l) = live_of(s, k.block) else { return String::from("number") }
    let code = s.lives[l].code.as_str()
    var e = k.start
    while e > 0 && code.byte(e - 1) == 32 { e -= 1 }
    if e == 0 || code.byte(e - 1) != 58 { return String::from("number") }
    e -= 1
    var a = e
    while a > 0 && (live::is_word(code.byte(a - 1))) { a -= 1 }
    if a == e { String::from("number") } else { code.slice(from: a, to: e).to_string() }
}

/// Sets knob `i`'s number to `value`: in its code, in the piece that shows it (the pieces after it
/// on its line move with its width), in the block, so the page keeps it, and in the field drawn.
fn set_knob(s: mut Docs, i: u32, value: f32) {
    let k = s.laid.knobs[i]
    let Some(l) = live_of(s, k.block) else { return }
    let (code, end) = with_number(s.lives[l].code.as_str(), k.start, k.end, value)
    let grown = i32(end) - i32(k.end)
    let piece = k.piece
    let shown = code.as_str().slice(from: k.start, to: end).to_string()
    let old_w = s.laid.pieces[piece].w
    let new_w = s.fonts
        .font(s.laid.pieces[piece].face)
        .measure(shown.as_str(), s.laid.pieces[piece].size)
    s.laid.pieces[piece].text = take shown
    s.laid.pieces[piece].w = new_w
    let y = s.laid.pieces[piece].at.y
    for j in piece + 1..s.laid.pieces.len() {
        if s.laid.pieces[j].block != k.block || abs(s.laid.pieces[j].at.y - y) > 0.5 { break }
        s.laid.pieces[j].at.x += new_w - old_w
    }
    for j in 0..s.laid.knobs.len() {
        if s.laid.knobs[j].block == k.block && s.laid.knobs[j].start > k.start {
            s.laid.knobs[j].start = u32(i32(s.laid.knobs[j].start) + grown)
            s.laid.knobs[j].end = u32(i32(s.laid.knobs[j].end) + grown)
        }
    }
    s.laid.knobs[i].end = end
    for j in 0..s.laid.snippets.len() {
        if s.laid.snippets[j].block == k.block { s.laid.snippets[j].text = code.clone() }
    }
    s.blocks[k.block].code = code.clone()
    s.lives[l].read = read(code.as_str(), live_time(s))
    s.changes += 1
    s.lives[l].version = s.changes
    s.lives[l].code = take code
    let (text, starts) = s.laid.text()
    s.lowered = lower(text.as_str())
    s.text = take text
    s.starts = take starts
}

/// The time a moving field is read at: the program's, or still when the system asks for less
/// motion.
fn live_time(s: Docs) -> f32 {
    if s.reduced { 0.0 } else { s.time }
}

/// Whether a figure on the screen draws a field that moves with time.
fn live_moves(s: Docs, f: Frame) -> bool {
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        if let Some(rd) = s.lives[l].read {
            if rd.moves { return true }
        }
    }
    false
}

/// Reads again, at this frame's time, each field on the screen that moves with time.
fn keep_lives(s: mut Docs, f: Frame) {
    if s.reduced { return }
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        let moves = match s.lives[l].read {
            Some(rd) => rd.moves,
            None => false,
        }
        if moves {
            s.lives[l].read = read(s.lives[l].code.as_str(), s.time)
            s.changes += 1
            s.lives[l].version = s.changes
        }
    }
}

/// Each figure on the screen: its field, drawn under the page's text and clipped under the
/// header, its corners round.
fn draw_figures(s: Docs, pass: std::gpu::ScreenPass, f: Frame) {
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let block = s.laid.figures[i].block
        for k in 0..s.images.len() {
            if s.images[k].block != block { continue }
            let top = max(r.y, f.header)
            let visible = vec4(r.x, top, r.w, min(r.bottom(), s.screen.y) - top)
            let look = Shown { rect: vec4(r.x, r.y, r.w, r.h), round: 6.0 * s.u }
            draw(
                pass,
                quad.bind(screen: s.screen, rect: visible),
                shown.bind(image: s.images[k].image, linear: s.linear, look: look),
                vertices: 6,
            )
        }
    }
}

/// How finely a figure's image is drawn, in texels to the screen's pixel: the screen's own
/// up to twice the CSS pixel, and finer screens (a phone's three) a little softer, for less than
/// half the work; while a hand moves it, or while it moves with time, half as fine again, and
/// finely once it's still.
fn image_scale(u: f32, moving: bool) -> f32 {
    min(1.0, 2.0 / u) * (if moving { 0.5 } else { 1.0 })
}

/// Draws again, into its image, each figure on the screen whose field, camera, view, probe, size
/// or scheme changed since it was last drawn; before the screen's pass.
fn draw_images(s: mut Docs, f: Frame) {
    let light = s.p == theme::LIGHT
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let block = s.laid.figures[i].block
        let Some(l) = live_of(s, block) else { continue }
        let Some(rd) = s.lives[l].read.clone() else { continue }
        // Held: a number of its being dragged, or the figure turned.
        let held = match s.knob_held {
            Some((k, _, _, unsure)) => !unsure && s.laid.knobs[k].block == block,
            None => false,
        } || match s.orbit {
            Some((j, _, _, _, by)) => j == i && by != FINGER_SCROLLS,
            None => false,
        }
        // A field that moves with time is drawn each frame: softer, as a held one is.
        let scale = image_scale(s.u, held || (rd.moves && !s.reduced))
        let w = max(u32(r.w * scale), 1)
        let h = max(u32(r.h * scale), 1)
        let mode = s.lives[l].mode
        // A slice's probe is the pointer's place on it, where the pointer is over it.
        let probe = if mode != SURFACE && r.contains(s.pointer) && s.pointer.y > f.header {
            vec4(slice_point(vec4(r.x, r.y, r.w, r.h), rd.centre, rd.radius, s.pointer), 1.0)
        } else { vec4(0.0) }
        let key = ImageKey {
            version: s.lives[l].version,
            turn: s.lives[l].turn,
            tilt: s.lives[l].tilt,
            mode,
            probe,
            w,
            h,
            light,
        }
        var k = s.images.len()
        for j in 0..s.images.len() {
            if s.images[j].block == block { k = j }
        }
        if k < s.images.len() && s.images[k].key == key { continue }
        if k == s.images.len() || s.images[k].key.w != w || s.images[k].key.h != h {
            let image = FigureImage { block, image: texture::<Rgba8>(width: w, height: h), key }
            if k == s.images.len() { s.images.push(take image) } else { s.images[k] = take image }
        }
        s.images[k].key = key
        let look = View {
            rect: vec4(0.0, 0.0, f32(w), f32(h)),
            turn: key.turn,
            tilt: key.tilt,
            centre: rd.centre,
            radius: rd.radius,
            floor: rd.floor,
            u: s.u * scale,
            light: if light { 1.0 } else { 0.0 },
            ground: hex(s.p.surface),
            line: hex(s.p.field, if light { 0.55 } else { 0.5 }),
            body: hex(s.p.figure),
            rim: hex(s.p.field),
            mode,
            probe,
        }
        // Each view is a pipeline of its own.
        let p = begin_pass(mut s.images[k].image)
        let corners = quad.bind(screen: vec2(f32(w), f32(h)), rect: look.rect)
        if mode == SURFACE {
            draw(p, corners, view.bind(scene: rd.scene, look: look), vertices: 6)
        } else if mode == BOUNDS {
            draw(p, corners, bounds_view.bind(scene: rd.scene, look: look), vertices: 6)
        } else { draw(p, corners, slice_view.bind(scene: rd.scene, look: look), vertices: 6) }
        p.end()
    }
}

/// Figure `i`'s tabs, at its top left: each its place, its view and its name.
fn figure_tabs(s: Docs, f: Frame, i: u32) -> Vec<(Rect, u32, String)> {
    var out: Vec<(Rect, u32, String)> = Vec::new()
    let r = figure_rect(s, f, i)
    if r.bottom() < f.header || r.y > s.screen.y { return out }
    let u = s.u
    // A finger's size where the list isn't beside the page.
    let (size, h, pad, gap) = if f.beside { (12.5, 26.0, 20.0, 4.0) } else {
        (13.5, 34.0, 18.0, 6.0)
    }
    var x = r.x + 10.0 * u
    for (mode, name) in [
        (SURFACE, "Surface"),
        (DISTANCE, "Distance"),
        (GRADIENT, "Gradient"),
        (BOUNDS, "Bounds"),
    ] {
        let w = s.fonts.font(Face::Sans).measure(name, size * u) + pad * u
        out.push((Rect::new(x, r.y + 10.0 * u, w, h * u), mode, name.to_string()))
        x += w + gap * u
    }
    out
}

/// What each view shows, said under it.
fn view_note(mode: u32) -> String {
    String::from(match mode {
        DISTANCE => "The distance to the surface, on a slice through it. The circle at the pointer is as wide as the distance there, so it touches the surface.",
        GRADIENT => "The gradient the compiler derives from the field's code: it points away from the surface, and is shorter where a blend joins two parts.",
        BOUNDS => "The bounds the compiler derives over each box: a box wholly outside or inside the surface stops, and one the surface may cross is cut in four.",
        _ => "Lit by the gradient the compiler derives from the field's code; nobody wrote its normals.",
    })
}

/// Over each figure: its tabs, what its view shows, and at the pointer, on a slice, what the
/// field is there: its distance, its gradient, or its bounds over the box the pointer is in.
fn draw_figure_overlays(s: mut Docs, f: Frame) {
    let u = s.u
    s.list.push_clip(Rect::new(0.0, f.header, s.screen.x, s.screen.y - f.header))
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        let mode = s.lives[l].mode
        for (t, m, name) in figure_tabs(s, f, i) {
            let here = m == mode
            let hover = t.contains(s.pointer)
            s.list.rect(t, hex(if here { s.p.field } else { s.p.page }, if here { 0.9 } else {
                0.7
            }), radius: t.h * 0.5)
            let size = (if f.beside { 12.5 } else { 13.5 }) * u
            let tw = s.fonts.font(Face::Sans).measure(name.as_str(), size)
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                name.as_str(),
                size,
                vec2(t.x + (t.w - tw) * 0.5, t.y + (t.h - size * 1.35) * 0.5),
                hex(if here { s.p.page } else if hover { s.p.strong } else { s.p.text }),
            )
        }
        // What the view shows, at its foot.
        let lines = wrap(s.fonts, view_note(mode).as_str(), 12.5 * u, r.w - 40.0 * u, if f.beside {
            2
        } else { 4 })
        let h = f32(lines.len()) * 18.0 * u + 12.0 * u
        var widest = 0.0
        for line in lines {
            widest = max(widest, s.fonts.font(Face::Sans).measure(line.as_str(), 12.5 * u))
        }
        let note = Rect::new(r.x + 10.0 * u, r.bottom() - h - 10.0 * u, widest + 20.0 * u, h)
        s.list.rect(note, hex(s.p.page, 0.72), radius: 6.0 * u)
        for k in 0..lines.len() {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                lines[k].as_str(),
                12.5 * u,
                vec2(note.x + 10.0 * u, note.y + 6.0 * u + f32(k) * 18.0 * u),
                hex(s.p.text),
            )
        }
        if mode == SURFACE || !r.contains(s.pointer) { continue }
        let Some(rd) = s.lives[l].read else { continue }
        let q = slice_point(vec4(r.x, r.y, r.w, r.h), rd.centre, rd.radius, s.pointer)
        let scene = rd.scene
        let said = if mode == DISTANCE {
            f"distance {live::evaluate(scene, q):.3}"
        } else if mode == GRADIENT {
            let g = std::derive::gradient(|p: vec3| live::evaluate(scene, p), q)
            f"gradient ({g.x:.2}, {g.y:.2}, {g.z:.2}), length {length(g):.2}"
        } else {
            let (lo, hi) = live::box_bounds(scene, rd.centre, rd.radius, r.w / r.h, q)
            f"over this box: {lo:.3} to {hi:.3}"
        }
        let w = s.fonts.font(Face::Mono).measure(said.as_str(), 12.0 * u) + 16.0 * u
        let at = vec2(min(s.pointer.x + 14.0 * u, r.right() - w - 6.0 * u), s.pointer.y - 34.0 * u)
        let tag = Rect::new(at.x, at.y, w, 24.0 * u)
        s.list.rect(tag, hex(s.p.page, 0.85), radius: 5.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            said.as_str(),
            12.0 * u,
            vec2(tag.x + 8.0 * u, tag.y + 5.0 * u),
            hex(s.p.strong),
        )
    }
    s.list.pop_clip()
}

// ---- scrollbars --------------------------------------------------------------------------------

/// How far the page, or the list of pages (`nav`), scrolls: 0 where it fits on the screen.
fn scroll_room(s: Docs, f: Frame, nav: bool) -> f32 {
    if nav { max(nav_end(s) - (s.screen.y - f.header), 0.0) } else { max_scroll(s, f) }
}

fn set_scroll(s: mut Docs, f: Frame, nav: bool, y: f32) {
    let to = clamp(y, 0.0, scroll_room(s, f, nav))
    if nav { s.nav_scroll = to } else {
        s.scroll = to
        s.glide = None
    }
}

/// The page's scrollbar, or the list's (`nav`), where what it scrolls is longer than the screen:
/// its track, down the right of the page or of the list under the header, and its thumb, as long
/// as the share of it on the screen, where that share is.
fn scrollbar(s: Docs, f: Frame, nav: bool) -> Option<(Rect, Rect)> {
    // The list's where the list shows; the page's unless the list is open over it.
    let shown = if nav { f.beside || s.nav_open } else { f.beside || !s.nav_open }
    if !shown { return None }
    let room = scroll_room(s, f, nav)
    if room <= 0.0 { return None }
    let u = s.u
    let w = 12.0 * u
    let x = if nav { f.nav - w - max(1.0, u) } else { s.screen.x - w }
    let track = Rect::new(x, f.header, w, s.screen.y - f.header)
    Some((track, thumb(track, if nav { s.nav_scroll } else { s.scroll }, room, 40.0 * u)))
}

/// A scrollbar's thumb in `track`, for what's scrolled `at` of the `room` it scrolls: as long as
/// the share of it on the screen (the track's length), at least `least`, as far down as the
/// scroll is.
fn thumb(track: Rect, at: f32, room: f32, least: f32) -> Rect {
    let h = min(max(track.h * track.h / (track.h + room), least), track.h)
    let y = track.y + (track.h - h) * clamp(at / max(room, 0.001), 0.0, 1.0)
    Rect::new(track.x, y, track.w, h)
}

/// A scrollbar's thumb: thin at its track's edge, wider and stronger under the pointer or held.
fn draw_scrollbar(s: mut Docs, f: Frame, nav: bool) {
    let Some((track, thumb)) = scrollbar(s, f, nav) else { return }
    let u = s.u
    let held = match s.thumb {
        Some((_, _, n)) => n == nav,
        None => false,
    }
    let near = held || track.contains(s.pointer)
    let w = (if near { 7.0 } else { 4.0 }) * u
    s.list.rect(
        Rect::new(track.right() - w - 3.0 * u, thumb.y + 3.0 * u, w, thumb.h - 6.0 * u),
        hex(s.p.quiet, if near { 0.6 } else { 0.3 }),
        radius: w * 0.5,
    )
}

// ---- what the host is told ---------------------------------------------------------------------

fn tell(s: mut Docs, f: Frame, changed: bool) {
    var over_control = false
    for c in controls(s, f, s.pointer, all: false) {
        if c.rect.contains(s.pointer) { over_control = true }
    }
    var over_knob = s.knob_held.is_some()
    for i in 0..s.laid.knobs.len() {
        if knob_rect(s, f, i).contains(s.pointer) { over_knob = true }
    }
    // Over a figure: a hand that turns it, or over a slice the probe's crosshair.
    var over_figure = ""
    for i in 0..s.laid.figures.len() {
        if figure_rect(s, f, i).contains(s.pointer) && s.pointer.y > f.header {
            let flat = match live_of(s, s.laid.figures[i].block) {
                Some(l) => s.lives[l].mode != SURFACE,
                None => false,
            }
            over_figure = if flat { "crosshair" } else { "grab" }
        }
    }
    let over_link = link_at(s, s.pointer, f).is_some() ||
        extra_at(s, s.pointer, f).is_some() ||
        over_control ||
        (over_nav(s, s.pointer, f) && nav_at(s, s.pointer, f).is_some())
    let want = if over_knob { "ew-resize" } else if s.orbit.is_some() &&
        over_figure != "crosshair" {
        "grabbing"
    } else if over_link ||
        f.search.contains(s.pointer) ||
        (s.pointer.y < f.header && s.pointer.x < mark_right(s, f)) {
        "pointer"
    } else if !over_figure.is_empty() { over_figure } else { "default" }
    if s.cursor.as_str() != want {
        s.cursor = want.to_string()
        s.told.push(host::cursor(want))
    }
    // While search is open, its box is a text field: an input method composes there, and a
    // screen reader hears what's typed.
    let typing = s.searching || s.finding
    if typing != s.texting &&
        s.capabilities & host::TEXT_INPUT != 0 &&
        s.capabilities & host::SEMANTICS == 0 {
        let b = f.search
        s.told.push(
            host::text_input(
                typing,
                vec4(b.x + 14.0 * s.u, b.y + 8.0 * s.u, 1.0, b.h - 16.0 * s.u),
            ),
        )
        s.texting = typing
    }
    // A copy takes what's selected; the host has it before the keys that copy arrive.
    let words = match s.selected {
        Some((a, b)) => if a == b { String::new() } else {
            s.text.as_str().slice(from: min(a, b), to: max(a, b)).to_string()
        },
        None => String::new(),
    }
    if words != s.offered && s.capabilities & host::PASTE_EVENTS != 0 {
        s.told.push(host::offer(words.as_str(), ""))
        s.offered = take words
    }
    // The tree is told what changed, and only then; a change held back while the page moved is
    // told once it stops.
    if s.capabilities & host::SEMANTICS == 0 || !(changed || s.owed) { return }
    // While the page moves, its parts' places go to the host ten times a second, not each frame:
    // the host moves an element for each, on the thread a phone's touches arrive on.
    let moved = s.scroll != s.told_at.0 || s.nav_scroll != s.told_at.1
    let moving = s.fling.is_some() || s.swipe.is_some() || s.glide.is_some()
    if moved && moving && s.time - s.told_at.2 < 0.1 {
        s.owed = true
        return
    }
    s.owed = false
    s.told_at = (s.scroll, s.nav_scroll, s.time)
    let nodes = parts_tree(s, f)
    let view = vec4(0.0, 0.0, s.screen.x, s.screen.y)
    let title = title_of(s)
    host::publish(mut s.told, mut s.tree, title.as_str(), nodes, view)
}

/// The page's parts as a semantic tree, in reading order, whether or not they're on screen (a
/// node's number is its part's plus 1, and a link has its address); then search's and find's
/// boxes, as fields, search's results, as a list's options, the page's extras and the list of
/// pages.
fn parts_tree(s: Docs, f: Frame) -> Vec<Node> {
    var nodes: Vec<Node> = Vec::new()
    for i in 0..s.laid.parts.len() {
        borrow p = s.laid.parts[i]
        let rect = vec4(p.rect.x + f.x, p.rect.y + f.top - s.scroll, p.rect.w, p.rect.h)
        // The page's parts are under the header, which is drawn over them.
        let shown = semantics::clip(rect, page_view(s, f))
        let role = match p.role {
            Role::Heading => semantics::Role::Heading,
            Role::Text => semantics::Role::Text,
            Role::Link => semantics::Role::Link,
            Role::Code => semantics::Role::Code,
        }
        let href = if p.role == Role::Link { href_of(s, p.target.as_str()) } else { String::new() }
        nodes.push(
            Node { id: i + 1, role, level: p.level, rect: shown, label: p.label.clone(), href },
        )
    }
    let b = vec4(f.search.x, f.search.y, f.search.w, f.search.h)
    nodes.push(
        Node {
            id: SEARCH_FIELD,
            role: semantics::Role::Field,
            label: String::from("Search the docs"),
            rect: if s.finding { vec4(0.0) } else { b },
            focused: s.searching,
            field: Some(box_field(s.search_box, s.query.as_str(), s.caret, s.other_end)),
        },
    )
    if s.finding {
        nodes.push(
            Node {
                id: FIND_FIELD,
                role: semantics::Role::Field,
                label: String::from("Find on this page"),
                rect: b,
                focused: true,
                field: Some(box_field(s.find_box, s.find.as_str(), s.caret, s.other_end)),
            },
        )
    }
    if s.searching && !s.query.is_empty() {
        let row = 58.0 * s.u
        let panel = results_panel(s, f)
        let x = panel.x
        let top = panel.y + 4.0 * s.u
        nodes.push(
            Node {
                id: RESULT_LIST,
                role: semantics::Role::ListBox,
                label: String::from("Search results"),
            },
        )
        for i in 0..s.hits.len() {
            let (title, under) = result_text(s.index, s.hits[i])
            nodes.push(
                Node {
                    id: RESULT_NODES + i,
                    parent: RESULT_LIST,
                    role: semantics::Role::Option,
                    selected: i == s.chosen,
                    rect: vec4(x, top + f32(i) * row, f.search.right() - x, row),
                    label: f"{title.as_str()}: {under.as_str()}",
                },
            )
        }
    }
    // The page's neighbours and its Markdown, and its outline as a group of links.
    let page = page_view(s, f)
    let ex = extras(s, f)
    var outlined = false
    for i in 0..ex.len() {
        borrow e = ex[i]
        let rect = semantics::clip(vec4(e.rect.x, e.rect.y, e.rect.w, e.rect.h), page)
        let href = href_of(s, e.target.as_str())
        let (parent, label) = match e.kind {
            ExtraKind::Outline(_) => (OUTLINE, e.label.clone()),
            ExtraKind::Previous => (0, f"Previous page: {e.label.as_str()}"),
            ExtraKind::Next => (0, f"Next page: {e.label.as_str()}"),
            ExtraKind::Markdown | ExtraKind::Copy => (0, e.label.clone()),
        }
        if parent == OUTLINE && !outlined {
            nodes.push(
                Node {
                    id: OUTLINE,
                    role: semantics::Role::Group,
                    label: String::from("On this page"),
                },
            )
            outlined = true
        }
        let role = if e.kind == ExtraKind::Copy { semantics::Role::Button } else {
            semantics::Role::Link
        }
        let href = if e.kind == ExtraKind::Copy { String::new() } else { take href }
        nodes.push(Node { id: EXTRA_NODES + i, parent, role, label, href, rect })
    }
    // The controls over the page: copy buttons, and each section's link.
    let all = controls(s, f, s.pointer, all: true)
    for i in 0..all.len() {
        borrow c = all[i]
        let rect = semantics::clip(vec4(c.rect.x, c.rect.y, c.rect.w, c.rect.h), page)
        nodes.push(
            if c.copy {
                Node {
                    id: CONTROL_NODES + i,
                    role: semantics::Role::Button,
                    label: if c.label.as_str() == "Copy" { String::from("Copy code") } else {
                        c.label.clone()
                    },
                    rect,
                }
            } else {
                Node {
                    id: CONTROL_NODES + i,
                    role: semantics::Role::Link,
                    label: f"Link to {c.label.as_str()}",
                    href: href_of(s, c.target.as_str()),
                    rect,
                }
            },
        )
    }
    // Each figure's views, as tabs.
    for i in 0..s.laid.figures.len() {
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        let r = figure_rect(s, f, i)
        nodes.push(
            Node {
                id: TAB_LISTS + i,
                role: semantics::Role::TabList,
                label: String::from("What the figure shows"),
                rect: semantics::clip(vec4(r.x, r.y, r.w, r.h), page),
            },
        )
        let tabs = figure_tabs(s, f, i)
        for k in 0..4 {
            let (mode, name) = if k < tabs.len() { (tabs[k].1, tabs[k].2.clone()) } else {
                (k, String::from(["Surface", "Distance", "Gradient", "Bounds"][k]))
            }
            let rect = if k < tabs.len() {
                semantics::clip(vec4(tabs[k].0.x, tabs[k].0.y, tabs[k].0.w, tabs[k].0.h), page)
            } else { vec4(0.0) }
            nodes.push(
                Node {
                    id: TABS + i * 4 + k,
                    parent: TAB_LISTS + i,
                    role: semantics::Role::Tab,
                    label: name,
                    selected: s.lives[l].mode == mode,
                    rect,
                },
            )
        }
    }
    // A live field's numbers, as sliders a keyboard steps.
    for i in 0..s.laid.knobs.len() {
        let r = knob_rect(s, f, i)
        let v = knob_value(s, i)
        nodes.push(
            Node {
                id: KNOB_NODES + i,
                role: semantics::Role::Slider,
                label: knob_name(s, i),
                rect: semantics::clip(vec4(r.x, r.y, r.w, r.h), page),
                value: v,
                min: if v >= 0.0 { 0.0 } else { -100.0 },
                max: 100.0,
                step: knob_step(v),
            },
        )
    }
    // The list of pages: a group of each group's pages under a button that opens or closes it,
    // where the list is shown. A closed group's pages, and the list where it's closed, are still
    // in the tree, for the keyboard.
    nodes.push(Node { id: NAV_LIST, role: semantics::Role::Group, label: String::from("Pages") })
    let shown = f.beside || s.nav_open
    let list = vec4(0.0, f.header, f.nav, s.screen.y - f.header)
    let rows = nav_rows(s, f)
    let all = groups_in(s.index)
    for k in 0..all.len() {
        let g = all[k].as_str()
        let (name, _) = group_title(g)
        // Where the row for `path` (the group's title, for no path) is, within the list; empty
        // where the row isn't laid out, as a closed group's pages and a list not shown aren't.
        let rect_of = |path: str| -> vec4 {
            if !shown { return vec4(0.0) }
            for row in rows {
                if row.group.as_str() == g && row.path.as_str() == path {
                    return semantics::clip(vec4(0.0, row.y, f.nav, row.h), list)
                }
            }
            vec4(0.0)
        }
        nodes.push(
            Node {
                id: NAV_GROUPS + k,
                parent: NAV_LIST,
                role: semantics::Role::Group,
                label: name.clone(),
            },
        )
        nodes.push(
            Node {
                id: NAV_BUTTONS + k,
                parent: NAV_GROUPS + k,
                role: semantics::Role::Button,
                label: name,
                expanded: is_open(s, g),
                rect: rect_of(""),
            },
        )
        for i in 0..s.index.pages.len() {
            borrow p = s.index.pages[i]
            if group_of(p.path.as_str(), p.kind.as_str()) != g { continue }
            let label = nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str())
            let href = Route { page: p.path.clone(), anchor: String::new() }.fragment()
            nodes.push(
                Node {
                    id: NAV_NODES + i,
                    parent: NAV_GROUPS + k,
                    role: semantics::Role::Link,
                    label,
                    href,
                    rect: rect_of(p.path.as_str()),
                },
            )
        }
    }
    take nodes
}

/// A box as the host's field: its text and selection, set when a replacement is asked for.
fn box_field(k: Kept, text: str, caret: u32, other: u32) -> Field {
    Field {
        kind: FieldKind::Search,
        text: text.to_string(),
        start: min(min(caret, other), text.len()),
        end: min(max(caret, other), text.len()),
        replace: k.replace,
        seen: k.seen,
    }
}

/// The part of the screen the page is seen in: under the header, and right of the list of pages
/// where it's open over the page, so the page's links aren't under a finger that taps the list.
fn page_view(s: Docs, f: Frame) -> vec4 {
    let left = if !f.beside && s.nav_open { f.nav } else { 0.0 }
    vec4(left, f.header, s.screen.x - left, s.screen.y - f.header)
}

/// Where link `target` goes, as an address the browser can open in a new tab: a page of these
/// docs by its fragment, a source file on the repository, or the address itself.
fn href_of(s: Docs, target: str) -> String {
    if target.starts_with("source:") {
        if s.index.repository.is_empty() || s.index.commit.is_empty() { return String::new() }
        let at = target.slice(from: 7, to: target.len())
        let k = at.find(":").unwrap_or(at.len())
        let path = at.slice(from: 0, to: k)
        let line = at.slice(from: min(k + 1, at.len()), to: at.len())
        return f"{s.index.repository.as_str()}/blob/{s.index.commit.as_str()}/{path}#L{line}"
    }
    if target.starts_with("nav:") {
        let page = target.slice(from: 4, to: target.len()).to_string()
        return Route { page, anchor: String::new() }.fragment()
    }
    if target.starts_with("here:") {
        let anchor = target.slice(from: 5, to: target.len()).to_string()
        return Route { page: s.shown.clone(), anchor }.fragment()
    }
    if target.starts_with("file:") { return target.slice(from: 5, to: target.len()).to_string() }
    match follow(s.shown.as_str(), target) {
        // The front page has no fragment.
        Some(Target::Docs(route)) => if route.page.is_empty() { String::from("#") } else {
            route.fragment()
        },
        Some(Target::File(path)) => path,
        Some(Target::Out(url)) => url,
        None => String::new(),
    }
}

/// `/` opens search, which types what follows but not the `/`; Backspace takes a character back.
/// Command-F opens find in its place, which takes the typing then; Enter there doesn't leave it.
@test(frames: 12, input: "scripts/keys.json")
fn search_and_find_take_the_typing(docs: Docs) {
    assert(!docs.searching, "find took search's place")
    assert(docs.query.as_str() == "aren", docs.query.as_str())
    assert(docs.finding && docs.find.as_str() == "a", docs.find.as_str())
    // No index here: the program says so rather than failing.
    assert(!docs.trouble.is_empty())
}

@test
fn an_address_without_a_fragment_is_the_front_page_and_groups_rank_the_language_first() {
    assert(rank("spec/lexical.md", "spec") < rank("std/io.md", "module"))
    assert(rank("std/io.md", "module") < rank("engine/floor.md", "module"))
    let shown = fit(
        Fonts::from_baked(MANROPE, MONO),
        "How Wrela differs from Rust and TypeScript",
        size: 14.0,
        width: 120.0,
    )
    assert(shown.as_str().ends_with("…") && shown.len() < 42, shown.as_str())
    // A module is listed by its file's name, a spec section by its title.
    for (path, kind, title, want) in [
        ("std/arena.md", "module", "std::arena", "arena"),
        ("engine/grow.md", "module", "engine::grow", "grow"),
        ("std/builtins.md", "module", "Built-in functions", "builtins"),
        ("spec/language/6-memory.md", "spec", "6. Memory", "6. Memory"),
    ] {
        let got = nav_label(path, kind, title)
        assert(got.as_str() == want, got.as_str())
    }
    assert(last_name("Arena::insert") == "insert" && last_name("fetch") == "fetch")
    let plain = unticked("Adds `value` at `the` end.")
    assert(plain.as_str() == "Adds value at the end.", plain.as_str())
}

@test
fn a_long_label_wraps_to_two_lines_and_a_longer_one_is_cut() {
    let fonts = Fonts::from_baked(MANROPE, MONO)
    let two = wrap(
        fonts,
        "How Wrela differs from Rust and TypeScript",
        size: 14.0,
        width: 200.0,
        most: 2,
    )
    assert(two.len() == 2 && !two[1].as_str().ends_with("…"), two[0].as_str())
    let joined = f"{two[0].as_str()} {two[1].as_str()}"
    assert(joined.as_str() == "How Wrela differs from Rust and TypeScript", joined.as_str())
    let cut = wrap(
        fonts,
        "How Wrela differs from Rust and TypeScript",
        size: 14.0,
        width: 90.0,
        most: 2,
    )
    assert(cut.len() == 2 && cut[1].as_str().ends_with("…"), cut[1].as_str())
    for line in cut {
        assert(fonts.font(Face::Sans).measure(line.as_str(), 14.0) <= 90.0, line.as_str())
    }
    assert(wrap(fonts, "arena", size: 14.0, width: 200.0, most: 2).len() == 1)
}

@test
fn the_front_page_lists_each_group_and_the_engine_by_topic() {
    var index = Index::empty()
    for (path, title, kind) in [
        ("spec/language/6-memory.md", "6. Memory", "spec"),
        ("std/builtins.md", "Built-in functions", "module"),
        ("engine/air.md", "engine::air", "module"),
        ("engine/piano.md", "engine::piano", "module"),
        ("engine/lit.md", "engine::lit", "module"),
        ("engine/novel.md", "engine::novel", "module"),
    ] {
        index.pages.push(
            index::Page {
                path: path.to_string(),
                title: title.to_string(),
                summary: String::from("What it does."),
                kind: kind.to_string(),
            },
        )
    }
    let md = front(index)
    let page = md.as_str()
    // Where `t` first is in the page, or its end.
    let at = |t: str| -> u32 { page.find(t).unwrap_or(page.len()) }
    assert(
        at("## The language") < at("- [6. Memory](spec/language/6-memory.md)"),
    )
    assert(
        at("## Standard library: `std`") < at("- [builtins](std/builtins.md)"),
    )
    // The engine's modules under their topics, in the topics' order; one no topic names, last.
    assert(
        at("### Rendering and light") < at("- [air]") && at("- [air]") < at("- [lit]"),
    )
    assert(
        at("- [lit]") < at("### Sound and music") && at("### Sound and music") < at("- [piano]"),
    )
    assert(
        at("### More") < at("- [novel]") && at("- [piano]") < at("### More"),
    )
    assert(engine_topic("piano_grand") == 6 && engine_topic("novel") == TOPICS)
}

@test
fn typing_replaces_what_is_selected_and_backspace_takes_it() {
    var q = String::from("arena insert")
    var caret: u32 = 12
    var other: u32 = 0
    put_typed(mut q, mut caret, mut other, "grazer")
    assert(q.as_str() == "grazer" && caret == 6 && other == 6, q.as_str())
    caret = 3
    other = 3
    put_typed(mut q, mut caret, mut other, "Z")
    assert(q.as_str() == "graZzer" && caret == 4, q.as_str())
    other = 1
    erase(mut q, mut caret, mut other, all: false)
    assert(q.as_str() == "gzer" && caret == 1 && other == 1, q.as_str())
    erase(mut q, mut caret, mut other, all: false)
    assert(q.as_str() == "zer" && caret == 0, q.as_str())
    erase(mut q, mut caret, mut other, all: true)
    assert(q.is_empty() && caret == 0)
}

/// Back and Forward return to the place the reader left an address; a link opens its page at the
/// top, or at its anchor, wherever the reader last was on it.
@test
fn back_returns_to_where_the_reader_was() {
    var places: Vec<(String, f32)> = Vec::new()
    remember(mut places, String::from("#std/io"), 300.0)
    remember(mut places, String::from("#std/arena"), 50.0)
    remember(mut places, String::from("#std/io"), 320.0)
    assert(places.len() == 2 && places[1].1 == 320.0, "a place is kept once, newest last")
    let io = Route::of("/#std/io")
    assert(arrival(io, push: false, places: places) == (None, Some(320.0)))
    assert(arrival(io, push: true, places: places) == (None, None))
    let anchored = Route::of("/#std/io:fetch")
    assert(arrival(anchored, push: true, places: places) == (Some(String::from("fetch")), None))
    assert(arrival(anchored, push: false, places: places) == (Some(String::from("fetch")), None))
    assert(arrival(Route::front(), push: false, places: places) == (None, None))
    for i in 0..PLACES + 5 { remember(mut places, f"#p{i}", 1.0) }
    assert(places.len() == PLACES && arrival(io, push: false, places: places) == (None, None))
}

/// A scrollbar's thumb is as long as the share of the page on the screen, at the top at first and
/// at the foot at the end, and never shorter than a finger's width or longer than its track.
@test
fn a_scrollbars_thumb_is_the_share_on_screen_where_it_is() {
    let track = Rect::new(x: 1388.0, y: 64.0, w: 12.0, h: 836.0)
    let top = thumb(track, 0.0, room: 836.0, least: 40.0)
    assert(top.y == 64.0 && top.h == 418.0 && top.x == track.x, f"{top.y} {top.h}")
    let end = thumb(track, 836.0, room: 836.0, least: 40.0)
    assert(end.bottom() == track.bottom(), f"{end.bottom()}")
    let long = thumb(track, 0.0, room: 1000000.0, least: 40.0)
    assert(long.h == 40.0)
    assert(thumb(track, 5.0, room: 0.0, least: 40.0).h == track.h)
}

/// A copy button says how its copy went for a moment, then is a copy button again.
@test
fn a_copy_says_how_it_went_for_a_moment() {
    assert(
        said("copy:code:2", 10.0, ok: true, now: 10.5, what: "copy:code:2") ==
            Some(String::from("Copied")),
    )
    assert(said("copy:code:2", 10.0, ok: true, now: 10.5, what: "copy:code:1").is_none())
    assert(
        said("copy:page", 10.0, ok: false, now: 11.0, what: "copy:page") ==
            Some(String::from("Couldn't copy")),
    )
    assert(said("copy:page", 10.0, ok: true, now: 10.0 + SAID + 0.1, what: "copy:page").is_none())
    // A copy on its way says nothing yet.
    assert(said("copy:page", -10.0, ok: false, now: 3.0, what: "copy:page").is_none())
    assert(parse_u32("17") == 17 && parse_u32("1x") == 0 && parse_u32("") == 0)
}

/// A glide covers most of the way in a tenth of a second and ends there, with no overshoot; it is
/// there at once when the system asks for less motion.
@test
fn a_glide_eases_to_its_place_and_stops_there() {
    var at = 0.0
    var frames = 0
    while at != 1000.0 && frames < 120 {
        let next = glided(at, 1000.0, dt: 1.0 / 60.0, still: false)
        assert(next > at && next <= 1000.0, f"{next}")
        at = next
        frames += 1
    }
    assert(at == 1000.0 && frames > 6 && frames < 40, f"{frames} frames")
    assert(glided(at: 0.0, to: 1000.0, dt: 0.1, still: false) > 800.0)
    assert(glided(at: 0.0, to: 1000.0, dt: 1.0 / 60.0, still: true) == 1000.0)
    assert(glided(at: 500.0, to: 0.0, dt: 1.0 / 60.0, still: false) < 500.0)
}

/// A page that couldn't be opened says so, and lists what search finds for its last name, each a
/// link that leads from where it is to the page found.
@test
fn a_missing_page_lists_what_may_be_it() {
    let doc = "{\"pages\": [{\"path\": \"std/arena.md\", \"title\": \"std::arena\", \"summary\": \"Arenas.\", \"kind\": \"module\"}], \"items\": [{\"path\": \"std::arena::Arena\", \"kind\": \"struct\", \"summary\": \"Values with handles.\", \"page\": \"std/arena.md\", \"anchor\": \"arena\", \"source\": \"compiler/std/arena.wrela\", \"line\": 12}], \"sections\": [{\"page\": \"spec/language/6-memory.md\", \"anchor\": \"6-8-handles-and-arenas\", \"headings\": [\"6. Memory\", \"6.8 Handles and arenas\"], \"text\": \"An arena holds values.\"}]}"
    var bytes: Vec<u8> = Vec::new()
    for i in 0..doc.len() { bytes.push(doc.byte(i)) }
    let Ok(index) = Index::read(bytes) else {
        assert(false, "the index")
        return
    }
    let md = missing(index, "std/old/arena.md", "HTTP 404")
    let page = md.as_str()
    assert(
        page.starts_with(
            "# No page here\n\n`std/old/arena` couldn't be opened (HTTP 404).\n\nA page",
        ),
        page,
    )
    assert(
        page
            .find("- [std::arena::Arena](../../std/arena.md#arena): Values with handles.")
            .is_some(),
        page,
    )
    let link = follow("std/old/arena.md", "../../std/arena.md#arena")
    assert(
        link ==
            Some(
                Target::Docs(
                    Route { page: String::from("std/arena.md"), anchor: String::from("arena") },
                ),
            ),
    )
    // A page of the spec that moved finds the spec's sections first.
    let spec = missing(index, "spec/old/arena.md", "HTTP 404")
    let section = spec.as_str().find("(../../spec/language/6-memory.md#6-8-handles-and-arenas)")
    let item = spec.as_str().find("(../../std/arena.md#arena)")
    assert(section.is_some() && item.is_some() && section < item, spec.as_str())
    // A name of several words that finds nothing finds its longest word.
    let words = missing(index, "std/an-arena-of-ours.md", "HTTP 404")
    assert(
        words.as_str().find("- [std::arena::Arena](../std/arena.md#arena)").is_some(),
        words.as_str(),
    )
    // Nothing found: no list, only search.
    let none = missing(index, "spec/zzz.md", "HTTP 404")
    assert(
        none
            .as_str()
            .ends_with(
                "couldn't be opened (HTTP 404).\n\nPress `/` and search for what you're looking for.\n",
            ),
        none.as_str(),
    )
}

/// A swipe's speed is its finger's over its last tenth of a second: none if the finger rested
/// before letting go.
@test
fn a_swipe_carries_on_at_its_fingers_last_speed() {
    // Up 30 pixels a frame for a tenth of a second: the page scrolls down 1800 pixels a second.
    var trail: Vec<(f32, f32)> = Vec::new()
    for i in 0..8 { trail.push((600.0 - 30.0 * f32(i), 1.0 + f32(i) / 60.0)) }
    let v = swipe_speed(trail, now: 1.0 + 7.0 / 60.0)
    assert(abs(v - 1800.0) < 1.0, f"{v}")
    // Rested a fifth of a second: no fling.
    assert(swipe_speed(trail, now: 1.0 + 7.0 / 60.0 + 0.2) == 0.0)
    assert(swipe_speed(Vec::from([(1.0, 2.0)]), now: 2.0) == 0.0)
}

/// A figure's image is as fine as the screen up to twice the CSS pixel, softer on a phone's three,
/// and half as fine again while it moves.
@test
fn a_figures_image_is_finest_when_still() {
    assert(image_scale(1.0, moving: false) == 1.0 && image_scale(2.0, moving: false) == 1.0)
    assert(abs(image_scale(3.0, moving: false) - 2.0 / 3.0) < 0.0001)
    assert(abs(image_scale(3.0, moving: true) - 1.0 / 3.0) < 0.0001)
}
