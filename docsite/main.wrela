// docs.wrela.dev: the reference docs that `wrela doc --export` writes, beside this program in its
// build, read here. A header holds the WRΞLA mark and search; under it, the pages listed at the
// left and the page being read, laid out from its Markdown and drawn from quads, with its outline
// at the right where there's room and its neighbours under it. Search finds items by name and
// the spec's rules by their words, in a box over the page. The page's address says where the reader is, so Back,
// Forward and links work as on any page, and Back returns to the place the reader left; its title
// names the tab. A block of code has a button that copies it, a section's heading a link to it,
// and a page a copy of its Markdown, for an agent. A block that builds a field has the field drawn
// live under it (live.wrela): its numbers drag, and the field turns.
//
// It moves as a page should under a hand: a swipe carries on and slows, the page stretches at
// its ends and a pull past its top loads it again, a finger held on words selects them for a
// copy, and the highlight under the pointer glides from row to row.
//
// Each frame: the host's answers (the display, the index, a page, the address), the input, the
// layout if the page or the width changed, the drawing, then what the host is told: the pointer's
// shape and the page's parts for screen readers. A frame draws and tells only when the picture
// changes or something on it moves: a page left open costs the GPU nothing, and what costs most to
// draw, a live field, is drawn into an image once and moved after.

use brand::facet
use brand::facet::MarkRun
use field::{Look, field, quad}
use index::{Hit, Index, last_name, lower}
use layout::{BUTTON, CARD_LINK, Laid, MAIN, Role, lay_out}
use live::{
    DISTANCE, Read, SURFACE, Shown, View, read, shown, slice_point, slice_view, solid, view,
    with_number,
}
use markdown::{Block, Kind, Run, parse, plain}
use std::host
use route::{Route, Target, follow}
use std::gpu::{
    GpuBuffer, Rgba8, Sampler, Texture, begin_pass, begin_screen_pass, buffer_of, draw, sampler,
    texture,
}
use std::input::{Assist, Button, Event, Key, events}
use std::io::{Pending, fetch}
use std::semantics
use std::semantics::{Field, FieldKind, Node, Sent}
use theme::{
    BODY, CARD, DARK, GUTTER, HEADER, LIGHT, MEASURE, NAV, Palette, RAIL, ROUND, SMALL, VOID, WIDE,
    hex,
}
use ui::draw::{DrawList, Rect, Renderer}
use ui::text::{Face, Fonts, MONO, SANS, previous_cluster}

const MARK_RUNS: Vec<MarkRun> = facet::mark_runs()
const MARK_WIDTH: f32 = facet::mark_width()

/// How many results search shows, and how many pages are kept read.
const RESULTS: u32 = 10
const KEPT: u32 = 24
/// The semantic tree's numbers: the page's parts from 0, search's results from `RESULT_NODES`,
/// in their list; search's and find's boxes.
const RESULT_NODES: u32 = 1000000
const RESULT_LIST: u32 = 999997
const SEARCH_FIELD: u32 = 999998
const FIND_FIELD: u32 = 999999
/// The list of pages (its pages from `NAV_NODES`, in a group for each group from `NAV_GROUPS`,
/// whose title is a button from `NAV_BUTTONS` that opens or closes it), the outline, and the
/// links beside and under the page (from `EXTRA_NODES`).
const NAV_LIST: u32 = 999996
const OUTLINE: u32 = 999995
const NAV_NODES: u32 = 2000000
const EXTRA_NODES: u32 = 3000000
const NAV_GROUPS: u32 = 4000000
const NAV_BUTTONS: u32 = 5000000
/// The controls over the page: each block of code's copy button and each section's link; the
/// header's buttons; and the button that copies what a finger selected.
const CONTROL_NODES: u32 = 6000000
const HEADER_NODES: u32 = 6500000
const COPY_SELECTION: u32 = 6600000
/// How long a copy's result shows, in seconds.
const SAID: f32 = 1.6
/// Who holds a figure: a mouse, which turns and tilts it; a finger, until its first move says
/// which way it goes; a finger that turns it; a finger that scrolls the page past it.
const HELD_BY_MOUSE: u32 = 0
const FINGER_UNSURE: u32 = 1
const FINGER_TURNS: u32 = 2
const FINGER_SCROLLS: u32 = 3
/// How far a finger moves before its way counts, and before it drags the page, in CSS pixels.
const FINGER_SLOP: f32 = 10.0
const PAGE_SLOP: f32 = 8.0
/// How long a finger rests on words before it selects them, in seconds.
const HOLD: f32 = 0.45
/// How far past the page's top a finger pulls it to load it again, in CSS pixels.
const PULL: f32 = 72.0

/// A live field's numbers, as sliders.
const KNOB_NODES: u32 = 7000000
/// Each figure's tabs: its list, then a tab for each of its two views.
const TAB_LISTS: u32 = 8000000
const TABS: u32 = 8500000

pub struct Docs {
    fonts: Fonts,
    renderer: Renderer,
    list: DrawList,
    mark: GpuBuffer<MarkRun>,
    environment: Option<Pending<u8>>,
    /// Device pixels to the CSS pixel, whether the system asks for less motion, and what the host
    /// can do; the screen's size when they were last asked for, as a new size may come with a new
    /// pixel ratio.
    u: f32,
    reduced: bool,
    capabilities: u32,
    asked: vec2,
    /// The page's colours: the reader's scheme, dark unless the system asks for light.
    p: Palette,
    index_load: Option<Pending<u8>>,
    index: Index,
    trouble: String,
    /// The address without its fragment, and the reader's place.
    address: Option<Pending<u8>>,
    changed: Option<Pending<u8>>,
    base: Option<String>,
    route: Route,
    /// Where the reader was on each address they left, newest last, so Back and Forward return
    /// there; and that place, for the page on its way.
    places: Vec<(String, f32)>,
    restore: Option<f32>,
    /// The page being read: its blocks and its Markdown, laid out at a width, and how far down it
    /// is scrolled.
    page_load: Option<Pending<u8>>,
    loading: String,
    pages: Vec<(String, Vec<Block>, String)>,
    blocks: Vec<Block>,
    markdown: String,
    /// Why the page shown couldn't be opened, if it couldn't: its page says what may be it, once
    /// the index is read.
    missed: String,
    shown: String,
    laid: Laid,
    laid_width: f32,
    /// The page's outline as laid out: each row's label, anchor, top and level.
    outline: Vec<(String, String, f32, u32)>,
    scroll: f32,
    nav_scroll: f32,
    /// Where to scroll to once the page is laid out: a heading's anchor.
    seek: Option<String>,
    /// Where the page glides to, a little each frame: a key's scroll, or a place on the page
    /// being read.
    glide: Option<f32>,
    screen: vec2,
    pointer: vec2,
    time: f32,
    /// Search: whether it's open and since when, what's typed, what it found and which is chosen.
    searching: bool,
    search_at: f32,
    query: String,
    hits: Vec<Hit>,
    chosen: u32,
    pasting: Option<Pending<u8>>,
    /// On a narrow screen, whether the list of pages is open over the page, and since when.
    nav_open: bool,
    nav_at: f32,
    /// The groups whose pages the list shows: the language's at first, and each page's own once
    /// it's shown; a group's title opens or closes it.
    open: Vec<String>,
    /// The list's rows as last laid out, whether they need laying out again, and the list's width
    /// and pixel ratio they were laid out for.
    nav: Vec<NavRow>,
    nav_dirty: bool,
    nav_for: vec2,
    /// Whether the list of pages should bring the page being read into view: a new page was shown.
    nav_follow: bool,
    told: Vec<Pending<u8>>,
    cursor: String,
    tree: Sent,
    /// Whether the host's text mode is on, for search's or find's box.
    texting: bool,
    /// Search's and find's boxes, where the host keeps them as fields, and a read of one on its way.
    search_box: Kept,
    find_box: Kept,
    reading: Option<Pending<u8>>,
    /// The caret in what search or find has typed (a byte of it), and the other end of what's
    /// selected there (the caret's byte when nothing is).
    caret: u32,
    other_end: u32,
    /// The page as plain text, its lowercase for find, and where each piece starts in it.
    text: String,
    lowered: String,
    starts: Vec<u32>,
    /// A selection: where it began and where it ends, each a byte of `text`.
    selected: Option<(u32, u32)>,
    /// A finger's selection: whether one is being made or shown (its Copy button over it), and
    /// which of its ends a finger holds (0 none, 1 where it began, 2 where it ends).
    touch_selection: bool,
    handle: u32,
    /// The pointer's press on the page: where, whether it has moved, and the link under it; and
    /// when it began.
    press: Option<(vec2, bool, String)>,
    press_at: f32,
    /// A press that scrolls rather than selects (a finger's, which didn't hover first): the
    /// scroll it began at, and whether it scrolls the list of pages rather than the page; where
    /// the finger was in its last moments, and when; and a swipe let go while moving, which
    /// carries on and slows (its speed in pixels a second, and whether it's the list's).
    swipe: Option<(f32, bool)>,
    trail: Vec<(f32, f32)>,
    /// The way a finger moved before it counted as a drag: the page stays that far from it, as a
    /// phone's own pages do, rather than jump it or make it up.
    slop: f32,
    fling: Option<(f32, bool)>,
    /// How far a finger pulls past the page's top (above 0), or stretches it past its end (below
    /// 0), in pixels: let go, it springs back. A pull doesn't move the page; a stretch does.
    /// Whether a pull let go past `PULL` is fetching the page again, and since when.
    pull: f32,
    reloading: bool,
    refreshed_at: f32,
    offered: String,
    /// Find on the page: whether it's open, what's typed, where it matches and which is current.
    finding: bool,
    find: String,
    matches: Vec<u32>,
    current: u32,
    /// A copy to the clipboard: on its way, what it copied (a control's target), and when it was
    /// done and whether it worked, which shows for a moment.
    copying: Option<Pending<u8>>,
    copied: String,
    copied_at: f32,
    copy_ok: bool,
    /// A scrollbar's thumb held: where the press was, the scroll then, and whether it's the list's.
    thumb: Option<(f32, f32, bool)>,
    /// Whether the picture changed since it was last drawn: an answer, input, a new size.
    dirty: bool,
    /// The scrolls the semantic tree was last told of, and when.
    told_at: (f32, f32, f32),
    owed: bool,
    /// The highlights that glide to the row under the pointer: in the list of pages, and among
    /// search's results.
    nav_glow: Glow,
    result_glow: Glow,
    /// When the page being read was shown: it comes in over a moment.
    shown_at: f32,
    /// When the first frame was, and when the first page was shown (below 0: not yet).
    started: f32,
    opened_at: f32,
    /// The page drawn into images, a tile each, which the screen shows where the page is: a page
    /// that scrolls draws only its tiles, and a tile is drawn again only when the page's layout
    /// changes (`laid_version`). Their list, apart from the frame's.
    tiles: Vec<Tile>,
    tile_list: DrawList,
    laid_version: u32,
    /// Each live figure's field, in the page's order; each figure's image as last drawn; and how
    /// many times a field has changed, which numbers each change.
    lives: Vec<Live>,
    images: Vec<FigureImage>,
    linear: Sampler,
    changes: u32,
    /// A number held, to drag: its knob, where the press was and its value then.
    knob_held: Option<(u32, vec2, f32, bool)>,
    /// A figure held, to turn: its figure, where the press was, its turn and tilt then, and who
    /// holds it (`HELD_BY_MOUSE`, or a finger before and after it shows its way).
    orbit: Option<(u32, vec2, f32, f32, u32)>,
    /// Whether the last press was a finger's: no pointer hovers after it.
    finger: bool,
}

/// A live figure's field: its block, its code as the reader's drags have changed it, what it
/// builds, and the camera's turn and tilt about it.
struct Live: Clone {
    block: u32,
    code: String,
    read: Option<Read>,
    turn: f32,
    tilt: f32,
    /// What it shows (live.wrela's `SURFACE` or `DISTANCE`), and where the marker under its chosen
    /// tab is, gliding to it: 0 under the first, 1 under the second.
    mode: u32,
    marker: f32,
    /// Which change of its field this is: its image is drawn again when it changes.
    version: u32,
}

/// A figure's images: the field drawn into textures, which the screen shows where the figure is.
/// A page that scrolls moves them; they're drawn again only when what they show changes, as
/// raymarching a field costs a phone's GPU dearly. They're drawn a band a frame, from a screen
/// before the figure reaches the screen: the rough image, a quarter as fine, then the sharp one,
/// once nothing holds the figure. So no frame raymarches a whole figure finely, and a page that
/// scrolls to a figure finds it drawn. Once the rough image is whole, a change to what the figure
/// shows draws it again at once, so a figure that's dragged or turned follows.
struct FigureImage {
    block: u32,
    rough: Texture<Rgba8>,
    rough_shows: ImageKey,
    rough_size: vec2u,
    sharp: Texture<Rgba8>,
    sharp_shows: ImageKey,
    sharp_size: vec2u,
    /// How many of the rough and the sharp image's rows are drawn, from their tops.
    rough_rows: u32,
    rows: u32,
}

impl FigureImage {
    fn rough_done(self) -> bool {
        self.rough_rows >= self.rough_size.y
    }

    /// Whether the sharp image is whole and shows what the rough one does.
    fn sharp_done(self) -> bool {
        self.rows >= self.sharp_size.y && self.sharp_shows == self.rough_shows
    }
}

/// What a figure's image shows: its field's change, the camera, its view, the probe and the scheme.
struct ImageKey: Copy + Eq {
    version: u32,
    turn: f32,
    tilt: f32,
    mode: u32,
    probe: vec4,
    light: bool,
}

/// How many bands a figure's rough image is first drawn in, and its sharp one, a band a frame.
const ROUGH_BANDS: u32 = 8
const BANDS: u32 = 64

/// A tile of the page: rows `index * TILE` down to the next tile's, drawn into its image `w`
/// texels wide at the page's `version`; `waiting` while a glyph it drew is on its way from the
/// host, and it's drawn again.
struct Tile {
    image: Texture<Rgba8>,
    index: u32,
    version: u32,
    w: u32,
    waiting: bool,
}

/// How tall a tile is, in device pixels, and how many are kept.
const TILE: f32 = 1024.0
const TILES_KEPT: u32 = 8

/// A highlight that glides to the row under the pointer, and fades in and out there: where it
/// is, where it goes, and how strong it is.
struct Glow: Copy {
    rect: Rect,
    to: Rect,
    a: f32,
    on: bool,
}

impl Glow {
    fn none() -> Glow {
        let r = Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0)
        Glow { rect: r, to: r, a: 0.0, on: false }
    }

    /// Toward `to`, or out where there's no row (`on` false); at once when there's to be no motion.
    fn aim(mut self, to: Rect, on: bool) {
        // Arriving from nowhere, it starts where it's going.
        if on && self.a < 0.02 { self.rect = to }
        self.to = to
        self.on = on
    }

    fn step(mut self, dt: f32, still: bool) {
        let k = if still { 1.0 } else { 1.0 - exp(-dt * 26.0) }
        let r = self.rect
        let t = self.to
        self.rect = Rect::new(
            r.x + (t.x - r.x) * k,
            r.y + (t.y - r.y) * k,
            r.w + (t.w - r.w) * k,
            r.h + (t.h - r.h) * k,
        )
        let target = if self.on { 1.0 } else { 0.0 }
        let fade = if still { 1.0 } else { 1.0 - exp(-dt * 18.0) }
        self.a = if abs(target - self.a) < 0.01 { target } else {
            self.a + (target - self.a) * fade
        }
    }

    fn moving(self) -> bool {
        let target = if self.on { 1.0 } else { 0.0 }
        self.a != target ||
            (self.a > 0.0 &&
                (abs(self.rect.y - self.to.y) > 0.3 ||
                    abs(self.rect.x - self.to.x) > 0.3 ||
                    abs(self.rect.h - self.to.h) > 0.3))
    }
}

/// A box the host keeps as a field (std::semantics): the newest revision heard of, the newest read,
/// and the replacements of its text asked for.
struct Kept: Clone + Eq {
    heard: u32 = 0,
    seen: u32 = 0,
    replace: u32 = 0,
}

pub fn init() -> Docs {
    var fonts = Fonts::from_baked(SANS, MONO)
    // Inter set a touch closer, as it's meant to be at a text's sizes.
    fonts.sans.tracking = -0.011
    let renderer = Renderer::new(fonts)
    var told: Vec<Pending<u8>> = Vec::new()
    // The browser's find finds nothing in a canvas: this program has its own.
    told.push(host::claim_find(true))
    Docs {
        fonts,
        renderer,
        list: DrawList::new(),
        mark: buffer_of(MARK_RUNS),
        environment: Some(host::environment()),
        u: 1.0,
        reduced: false,
        capabilities: 0,
        asked: vec2(0.0),
        p: DARK,
        index_load: Some(fetch("index.json")),
        index: Index::empty(),
        trouble: String::new(),
        address: Some(host::address()),
        changed: None,
        base: None,
        route: Route::front(),
        places: Vec::new(),
        restore: None,
        page_load: None,
        loading: String::new(),
        pages: Vec::new(),
        blocks: Vec::new(),
        markdown: String::new(),
        missed: String::new(),
        shown: String::from("?"),
        laid: Laid::empty(),
        laid_width: 0.0,
        outline: Vec::new(),
        scroll: 0.0,
        nav_scroll: 0.0,
        seek: None,
        glide: None,
        screen: vec2(1.0),
        pointer: vec2(-1.0),
        time: 0.0,
        searching: false,
        search_at: -10.0,
        query: String::new(),
        hits: Vec::new(),
        chosen: 0,
        pasting: None,
        nav_open: false,
        nav_at: -10.0,
        open: Vec::from([String::from("spec")]),
        nav: Vec::new(),
        nav_dirty: true,
        nav_for: vec2(0.0),
        nav_follow: false,
        told,
        cursor: String::from("default"),
        tree: Sent {},
        texting: false,
        search_box: Kept {},
        find_box: Kept {},
        reading: None,
        caret: 0,
        other_end: 0,
        text: String::new(),
        lowered: String::new(),
        starts: Vec::new(),
        selected: None,
        touch_selection: false,
        handle: 0,
        press: None,
        press_at: 0.0,
        swipe: None,
        trail: Vec::new(),
        slop: 0.0,
        fling: None,
        pull: 0.0,
        reloading: false,
        refreshed_at: -10.0,
        offered: String::new(),
        finding: false,
        find: String::new(),
        matches: Vec::new(),
        current: 0,
        copying: None,
        copied: String::new(),
        copied_at: -10.0,
        copy_ok: false,
        thumb: None,
        dirty: true,
        told_at: (-1.0, -1.0, -10.0),
        owed: false,
        nav_glow: Glow::none(),
        result_glow: Glow::none(),
        shown_at: -10.0,
        started: -1.0,
        opened_at: -1.0,
        tiles: Vec::new(),
        tile_list: DrawList::new(),
        laid_version: 0,
        lives: Vec::new(),
        images: Vec::new(),
        linear: sampler(),
        changes: 0,
        knob_held: None,
        orbit: None,
        finger: false,
    }
}

pub fn frame(s: mut Docs, time: f32, width: u32, height: u32) {
    // A new size clears the canvas.
    if vec2(f32(width), f32(height)) != s.screen { s.dirty = true }
    s.screen = vec2(f32(width), f32(height))
    let dt = clamp(time - s.time, 0.0, 0.1)
    s.time = time
    if s.started < 0.0 { s.started = time }
    // A new size, as when the page is zoomed or moved to another display, may come with a new
    // pixel ratio: ask again.
    if s.screen != s.asked && s.environment.is_none() {
        s.environment = Some(host::environment())
        s.asked = s.screen
    }
    answers(mut s)
    let frame = frame_of(s)
    for e in events() {
        s.dirty = true
        handle(mut s, e, frame)
    }
    // Trouble opens the docs as a page does: to say so.
    if s.opened_at < 0.0 && !s.trouble.is_empty() { s.opened_at = s.time }
    keep_laid_out(mut s, frame)
    keep_lives(mut s, frame, dt)
    held_long(mut s, frame)
    glide_on(mut s, frame, dt)
    fling_on(mut s, frame, dt)
    spring_on(mut s, dt)
    keep_nav(mut s, frame)
    keep_glows(mut s, frame, dt)
    let changed = s.dirty || moving(s, frame)
    if changed {
        draw_all(mut s, frame)
        s.dirty = false
    }
    tell(mut s, frame, changed)
}

/// How long a page takes to come in, and search's box or the list of pages to open, in seconds.
const APPEAR: f32 = 0.22
const OPEN: f32 = 0.16
/// How long the docs show only the page's colour while their first page comes, at most, and how
/// long they take to come in from it, as a whole, in seconds.
const WAIT: f32 = 0.6
const OPENING: f32 = 0.4

/// When the docs open: as their first page is shown, or something's wrong, or `WAIT` after they
/// start while the page is still on its way, which they then say.
fn opens_at(s: Docs) -> f32 {
    let late = s.started + WAIT
    if s.opened_at >= 0.0 { min(s.opened_at, late) } else { late }
}

/// How much of a moment that began at `since` has passed by `now`, eased: 1 at once when there's
/// to be no motion.
fn eased(since: f32, now: f32, length: f32, still: bool) -> f32 {
    if still { 1.0 } else { smoothstep(0.0, length, now - since) }
}

/// Whether something on the screen moves, so each frame draws: search's or find's caret, the bar
/// of a page on its way, a glide, a fling, a stretch springing back, a copy's word while it shows
/// (and the frame after), a glow on its way, glyphs on their way. The caret and the bar stay still when the system asks for less
/// motion.
fn moving(s: Docs, f: Frame) -> bool {
    let lively = s.searching ||
        s.finding ||
        s.page_load.is_some() ||
        s.reloading ||
        s.time - s.shown_at < APPEAR + 0.05 ||
        s.time - opens_at(s) < OPENING + 0.05 ||
        s.time - s.search_at < OPEN + 0.05 ||
        s.time - s.nav_at < OPEN + 0.05
    (lively && !s.reduced) ||
        (live_moves(s, f) && !s.reduced) ||
        s.glide.is_some() ||
        s.fling.is_some() ||
        (s.pull != 0.0 && s.swipe.is_none()) ||
        s.nav_glow.moving() ||
        s.result_glow.moving() ||
        markers_moving(s) ||
        s.time - s.copied_at < SAID + 0.25 ||
        figures_drawing(s, f) ||
        s.renderer.waiting()
}

/// Where everything goes on this screen.
pub struct Frame: Copy {
    header: f32,
    /// The list of pages: its width, and whether it shows beside the page.
    nav: f32,
    beside: bool,
    /// The page's text: its left, its width, and where its top is.
    x: f32,
    w: f32,
    top: f32,
    /// The search button in the header.
    search: Rect,
    /// The page's outline, at the right of its text where the screen has room (else empty).
    rail: Rect,
    /// The screen under the header, where the page and what's over it are drawn.
    body: Rect,
}

fn frame_of(s: Docs) -> Frame {
    let u = s.u
    let header = HEADER * u
    let beside = s.screen.x >= 960.0 * u
    let nav = if beside { NAV * u } else { min(300.0 * u, s.screen.x * 0.86) }
    let left = if beside { nav } else { 0.0 }
    let gutter = if beside { GUTTER * u } else { 20.0 * u }
    // A page has its outline at its right when the text keeps its measure beside it.
    let rail_w = RAIL * u
    let rail_gap = 48.0 * u
    let room = s.screen.x - left - 2.0 * gutter - rail_w - rail_gap
    let outlined = beside && !s.route.page.is_empty() && room >= MEASURE * u
    let w = if outlined { min(WIDE * u, room) } else {
        max(min(WIDE * u, s.screen.x - left - 2.0 * gutter), 120.0 * u)
    }
    // The text and its outline sit in the middle of the room right of the list, so a wide screen
    // has its space on both sides rather than all at the right.
    let used = w + (if outlined { rail_gap + rail_w } else { 0.0 })
    let x = floor(left + max(gutter, (s.screen.x - left - used) * 0.5) + 0.5)
    // A page's top leaves room for where it is (its group, over its title).
    let top = header + (if s.route.page.is_empty() { if beside { 64.0 } else { 36.0 } } else {
        if beside { 76.0 } else { 64.0 }
    }) * u
    // Search: a wide button at the header's right, with the link to the repository after it;
    // a button of a finger's size on a phone.
    let search = if s.screen.x >= 640.0 * u {
        let w = clamp(s.screen.x * 0.22, 220.0 * u, 300.0 * u)
        Rect::new(s.screen.x - w - 104.0 * u, (header - 36.0 * u) * 0.5, w, 36.0 * u)
    } else { Rect::new(s.screen.x - 52.0 * u, (header - 40.0 * u) * 0.5, 40.0 * u, 40.0 * u) }
    let rail = if outlined {
        Rect::new(x + w + rail_gap, header + 40.0 * u, rail_w, s.screen.y - header - 64.0 * u)
    } else { Rect::new(x: 0.0, y: 0.0, w: 0.0, h: 0.0) }
    let body = Rect::new(0.0, header, s.screen.x, s.screen.y - header)
    Frame { header, nav, beside, x, w, top, search, rail, body }
}

// ---- the host's answers ------------------------------------------------------------------------

fn answers(s: mut Docs) {
    if let Some(result) = poll(mut s.environment) {
        s.dirty = true
        if let Ok(bytes) = result {
            let env = host::read_environment(bytes)
            s.reduced = env.reduced_motion
            if let Some(ratio) = env.pixel_ratio { s.u = clamp(ratio, 0.5, 4.0) }
            s.capabilities = env.capabilities
            let p = if env.prefers_light { LIGHT } else { DARK }
            if p != s.p {
                s.p = p
                // The page's colours are laid out with it.
                s.laid_width = 0.0
            }
        }
    }
    if let Some(result) = poll(mut s.index_load) {
        s.dirty = true
        match take result {
            Ok(bytes) => match Index::read(take bytes) {
                Ok(index) => {
                    s.index = take index
                    // The language first, then std, then the packages: the order a reader learns
                    // them in. The sort keeps each group's own order.
                    s.index.pages.sort_by(
                        |a, b| rank(a.path.as_str(), a.kind.as_str()) <
                            rank(b.path.as_str(), b.kind.as_str()),
                    )
                    // The front page lists the pages, and the list now has them.
                    s.laid_width = 0.0
                    s.nav_dirty = true
                    s.nav_follow = true
                    open_shown_group(mut s)
                    // A page that couldn't be opened now lists what may be it.
                    if !s.missed.is_empty() {
                        let why = s.missed.clone()
                        let path = s.shown.clone()
                        let md = missing(s.index, path.as_str(), why.as_str())
                        show(mut s, path.as_str(), parse(md.as_str()), take md)
                        s.missed = take why
                    }
                },
                Err(e) => s.trouble = f"The index couldn't be read: {e.as_str()}",
            },
            Err(e) => s.trouble = f"The index couldn't be fetched: {e.message()}",
        }
    }
    if let Some(Ok(bytes)) = poll(mut s.address) {
        s.dirty = true
        if let Some(text) = String::from_utf8(take bytes) {
            let t = text.as_str()
            let k = t.find("#").unwrap_or(t.len())
            s.base = Some(t.slice(from: 0, to: k).to_string())
            go_to(mut s, Route::of(t), push: false)
        }
        s.changed = Some(host::address_changed())
    }
    if let Some(Ok(bytes)) = poll(mut s.changed) {
        s.dirty = true
        if let Some(text) = String::from_utf8(take bytes) {
            go_to(mut s, Route::of(text.as_str()), push: false)
        }
        s.changed = Some(host::address_changed())
    }
    if let Some(result) = poll(mut s.page_load) {
        s.dirty = true
        let path = s.loading.clone()
        match take result {
            Ok(bytes) => match String::from_utf8(take bytes) {
                Some(text) => {
                    let blocks = parse(text.as_str())
                    if s.pages.len() >= KEPT { let _ = s.pages.remove(0) }
                    s.pages.push((path.clone(), blocks.clone(), text.clone()))
                    if s.route.page == path { show(mut s, path.as_str(), take blocks, take text) }
                },
                None => s.trouble = f"{path.as_str()} isn't UTF-8",
            },
            Err(e) => if s.route.page == path {
                // A page that isn't there, as after a page moved: what may be it, and search.
                let md = missing(s.index, path.as_str(), e.message())
                let blocks = parse(md.as_str())
                show(mut s, path.as_str(), take blocks, take md)
                s.missed = e.message().to_string()
            },
        }
    }
    if let Some(Ok(bytes)) = poll(mut s.pasting) {
        s.dirty = true
        if let Ok(p) = host::read_pasted(take bytes) {
            if s.finding {
                put_typed(mut s.find, mut s.caret, mut s.other_end, first_line(p.text.as_str()))
                let f = frame_of(s)
                refresh_matches(mut s, f)
            } else {
                put_typed(mut s.query, mut s.caret, mut s.other_end, first_line(p.text.as_str()))
                refresh_hits(mut s)
            }
        }
    }
    if let Some(result) = poll(mut s.copying) {
        s.dirty = true
        s.copy_ok = result.is_ok()
        s.copied_at = s.time
        if s.capabilities & host::SEMANTICS != 0 {
            s.told.push(host::announce(if s.copy_ok { "Copied" } else { "Couldn't copy" }))
        }
    }
    if let Some(Ok(bytes)) = poll(mut s.reading) {
        s.dirty = true
        if let Ok(state) = semantics::read_field_state(take bytes) { typed(mut s, state) }
    }
    // A box changed since it was last read: read it.
    if s.reading.is_none() {
        if s.search_box.heard > s.search_box.seen {
            s.reading = Some(host::field_state(SEARCH_FIELD))
        } else if s.find_box.heard > s.find_box.seen {
            s.reading = Some(host::field_state(FIND_FIELD))
        }
    }
    var i = 0
    while i < s.told.len() {
        if s.told[i].poll().is_some() { let _ = s.told.remove(i) } else { i += 1 }
    }
}

/// What a person typed in search's or find's box, as the host's field has it.
fn typed(s: mut Docs, state: semantics::FieldState) {
    if state.node == SEARCH_FIELD {
        s.search_box.seen = max(s.search_box.seen, state.revision)
        if s.searching && state.text != s.query {
            s.query = state.text.clone()
            refresh_hits(mut s)
        }
    } else {
        s.find_box.seen = max(s.find_box.seen, state.revision)
        if s.finding && state.text != s.find {
            s.find = state.text.clone()
            let f = frame_of(s)
            refresh_matches(mut s, f)
        }
    }
    // The caret is the end the selection was made toward.
    s.caret = if state.backward { state.start } else { state.end }
    s.other_end = if state.backward { state.end } else { state.start }
}

fn poll(pending: mut Option<Pending<u8>>) -> Option<Result<Vec<u8>, std::io::IoError>> {
    var answer = None
    match mut pending {
        Some(p) => answer = p.poll(),
        None => {},
    }
    if answer.is_some() { pending = None }
    answer
}

fn first_line(t: str) -> borrow str {
    var k = 0
    while k < t.len() && t.byte(k) != 10 && t.byte(k) != 13 { k += 1 }
    t.slice(from: 0, to: k)
}

// ---- where the reader is -----------------------------------------------------------------------

/// Takes the reader to `route`, and adds it to the page's history if `push`.
fn go_to(s: mut Docs, route: Route, push: bool) {
    // Where the reader leaves, and, for Back or Forward, where they were on the address they
    // return to.
    if s.shown == s.route.page { remember(mut s.places, s.route.fragment(), s.scroll) }
    let (seek, back) = arrival(route, push, s.places)
    let same_page = route.page == s.route.page && s.shown == route.page
    s.route = route.clone()
    s.searching = false
    s.nav_open = false
    s.trouble.clear()
    if push {
        let fragment = route.fragment()
        let address = if fragment.is_empty() { href_of(s, "home:") } else { take fragment }
        s.told.push(host::push_address(address.as_str()))
    }
    s.seek = take seek
    s.restore = back
    if same_page {
        if s.seek.is_none() {
            s.glide = None
            s.scroll = s.restore.unwrap_or(0.0)
        }
        s.restore = None
        return
    }
    if route.page.is_empty() {
        show(mut s, "", Vec::new(), String::new())
        return
    }
    var kept: Option<(Vec<Block>, String)> = None
    for (path, blocks, md) in s.pages {
        if path == route.page { kept = Some((blocks.clone(), md.clone())) }
    }
    if let Some((blocks, md)) = take kept {
        show(mut s, route.page.as_str(), take blocks, take md)
        return
    }
    s.loading = route.page.clone()
    s.page_load = Some(fetch(route.page.as_str()))
}

/// Shows the page at `path` (`` for the front page), its blocks read from its Markdown, at its
/// top, its anchor, or the place the reader left it.
fn show(s: mut Docs, path: str, blocks: take Vec<Block>, markdown: take String) {
    s.blocks = take blocks
    s.markdown = take markdown
    s.missed.clear()
    if appears(s.reloading, s.shown.as_str(), path) { s.shown_at = s.time }
    if s.opened_at < 0.0 { s.opened_at = s.time }
    s.shown = path.to_string()
    s.nav_follow = true
    open_shown_group(mut s)
    s.laid_width = 0.0
    s.glide = None
    if s.seek.is_none() { s.scroll = s.restore.unwrap_or(0.0) }
    s.restore = None
}

/// Whether the page at `path` appears, rising and fading in, as it's shown after `shown`: a page
/// loaded again in place by a refresh doesn't, as it was there all along.
fn appears(reloading: bool, shown: str, path: str) -> bool {
    !reloading || shown != path
}

/// How many places the reader left are kept.
const PLACES: u32 = 64

/// Keeps `y`, where the reader is on address `here` (its fragment), in place of what was kept
/// for it.
fn remember(places: mut Vec<(String, f32)>, here: take String, y: f32) {
    places.retain(|p| p.0 != here)
    if places.len() >= PLACES { let _ = places.remove(0) }
    places.push((take here, y))
}

/// Where a reader arriving at `route` goes on its page: the anchor it names, to seek; or, by Back
/// or Forward (not `push`), the place they left it at, if they were there. Neither: its top.
fn arrival(route: Route, push: bool, places: [(String, f32)]) -> (Option<String>, Option<f32>) {
    if !push {
        let here = route.fragment()
        for (f, y) in places {
            if f == here { return (None, Some(y)) }
        }
    }
    (if route.anchor.is_empty() { None } else { Some(route.anchor.clone()) }, None)
}

/// The front page: the release these pages describe, what Wrela is, buttons to start, a field in
/// a few lines drawn live, a card for each group of pages, then what an agent reads and each
/// group's pages, each with what it covers (`front`).
fn front_blocks(index: Index) -> Vec<Block> {
    var out: Vec<Block> = Vec::new()
    if !index.version.is_empty() {
        var tag = f"Wrela {index.version.as_str()}"
        if index.commit.len() >= 7 {
            tag.push_str(f" · built from {index.commit.as_str().slice(from: 0, to: 7)}")
        }
        out.push(Block { kind: Kind::Badge, runs: Vec::from([Run { text: tag, style: 0 }]) })
    }
    out.push(
        Block {
            kind: Kind::Display,
            runs: Vec::from([Run { text: String::from("Content is fields."), style: 0 }]),
        },
    )
    out.push(
        Block {
            kind: Kind::Paragraph,
            runs: Vec::from(
                [
                    Run {
                        text: String::from(
                            "Wrela is a language, compiler and engine for games that run in the browser. One source compiles to WebAssembly for the CPU and to WGSL for the GPU.",
                        ),
                        style: 0,
                    },
                ],
            ),
        },
    )
    let link = |text: str, to: str| -> Run {
        Run { text: text.to_string(), style: markdown::LINK, link: to.to_string() }
    }
    out.push(
        Block {
            kind: Kind::Actions,
            runs: Vec::from(
                [
                    link(
                        "Read the language",
                        "spec/language/how-wrela-differs-from-rust-and-typescript.md",
                    ),
                    link("Search the docs", "search:"),
                    link("llms.txt", "llms.txt"),
                ],
            ),
        },
    )
    let field = f"## A field, drawn live\n\nA field is a function over space, such as the distance from a point to a surface. `std::field` joins, cuts, moves and displaces fields, and the compiler derives each field's gradient and its bounds over a box from the field's own code ([§14](spec/language/14-derived-interpretations.md)). Below, a tesseract at rest, the console's artifact made of a few such fields, is drawn from this code as you change it; [a complete program](spec/language/22-a-complete-program.md) draws a field with a shader of its own.\n\n```wrela\n{live::tesseract().as_str()}```\n\n## Browse the docs\n"
    var parsed = parse(field.as_str())
    out.append(mut parsed)
    for g in groups_in(index) {
        let (name, pkg) = group_title(g.as_str())
        var count = 0
        for p in index.pages {
            if group_of(p.path.as_str(), p.kind.as_str()) == g.as_str() { count += 1 }
        }
        let heading = if pkg.is_empty() { name.clone() } else { f"{name.as_str()}: {pkg.as_str()}" }
        out.push(
            Block {
                kind: Kind::Card,
                runs: Vec::from(
                    [
                        link(
                            name.as_str(),
                            f"here:{markdown::slug(heading.as_str()).as_str()}".as_str(),
                        ),
                        Run { text: pkg, style: markdown::CODE },
                        Run { text: group_summary(index, g.as_str()), style: 0 },
                        Run { text: f"{count} pages", style: 0 },
                    ],
                ),
            },
        )
    }
    var listed = parse(front(index).as_str())
    out.append(mut listed)
    take out
}

/// What group `g`'s pages cover, said on its card: the groups this program knows by their own
/// words, another by its first modules' names.
fn group_summary(index: Index, g: str) -> String {
    if g == "spec" {
        return String::from("The specification, from what Wrela is to its tools, with its grammar.")
    }
    if g == "std" {
        return String::from("Memory, collections, strings, fields, the GPU, input, I/O and time.")
    }
    if g == "engine" {
        return String::from(
            "Rendering and light, creatures, plants, terrain, simulation and sound.",
        )
    }
    if g == "land" {
        return String::from(
            "A landscape round a player: its map, landforms, growth, water, footing and streaming.",
        )
    }
    if g == "ui" {
        return String::from("Quads, text drawn from signed distance fields, and widgets.")
    }
    if g == "platform" {
        return String::from(
            "What the host gives a program: its address, the network and how it's shown.",
        )
    }
    if g == "studio_tool" {
        return String::from(
            "The lens on a subject: `wrela tool studio`, its actions, its server and its headless runs.",
        )
    }
    var names: Vec<String> = Vec::new()
    for p in index.pages {
        if group_of(p.path.as_str(), p.kind.as_str()) != g || names.len() >= 4 { continue }
        names.push(nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str()))
    }
    var out = String::new()
    for i in 0..names.len() {
        if i > 0 { out.push_str(", ") }
        out.push_str(names[i].as_str())
    }
    take out
}

/// The front page's Markdown after its cards: what an agent reads, then each group of pages, each
/// page with what it covers; the engine's by topic.
fn front(index: Index) -> String {
    var md = String::from("## For agents\n\n")
    md.push_str(
        "- [`llms.txt`](llms.txt) lists every page with its summary and says how to read them. [`spec/llms-full.txt`](spec/llms-full.txt) holds the whole language in one file, and each package has a file of its own.\n",
    )
    md.push_str(
        "- Each page is Markdown at its own address, such as `std/io.md`, and its Copy page button puts it on the clipboard. `index.json` lists every item with its signature and source line.\n",
    )
    if !index.repository.is_empty() {
        let install = if index.toolchain_repository.is_empty() {
            String::from("install `wrela`")
        } else {
            f"install `wrela` from [a toolchain release]({index.toolchain_repository.as_str()}/releases)"
        }
        md.push_str(
            f"- To run a program: {install.as_str()}; then, in a clone of [the repository]({index.repository.as_str()}), `wrela run examples/hello-field` serves that program to your browser. `wrela` runs the toolchain release the repository pins.\n",
        )
    }
    for g in groups_in(index) {
        let (name, pkg) = group_title(g.as_str())
        if pkg.is_empty() {
            md.push_str(f"\n## {name.as_str()}\n\n")
        } else { md.push_str(f"\n## {name.as_str()}: `{pkg.as_str()}`\n\n") }
        for t in 0..TOPICS + 1 {
            if g.as_str() != "engine" && t > 0 { break }
            var listed = false
            for p in index.pages {
                if group_of(p.path.as_str(), p.kind.as_str()) != g.as_str() { continue }
                let label = nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str())
                if g.as_str() == "engine" && engine_topic(label.as_str()) != t { continue }
                if g.as_str() == "engine" && !listed {
                    md.push_str(f"\n### {topic_title(t).as_str()}\n\n")
                }
                listed = true
                md.push_str(f"- [{label.as_str()}]({p.path.as_str()}): {p.summary.as_str()}\n")
            }
        }
    }
    take md
}

/// The page shown for a page that couldn't be opened, at `path`: what went wrong, then the pages
/// that search finds for the path's last name, as a page that moved may be among them, and how
/// to search. Its links are relative to `path`.
fn missing(index: Index, path: str, why: str) -> String {
    let p = path.slice(from: 0, to: if path.ends_with(".md") { path.len() - 3 } else { path.len() })
    var md = f"# No page here\n\n`{p}` couldn't be opened ({why}).\n\n"
    // Up from the page's directory to the docs' root.
    var up = String::new()
    for i in 0..p.len() {
        if p.byte(i) == 47 { up.push_str("../") }
    }
    // The path's last name, as words (`6-memory-model`: `6 memory model`); if search finds nothing
    // for them all, its longest word.
    var name = String::new()
    var start = p.len()
    while start > 0 && p.byte(start - 1) != 47 { start -= 1 }
    for i in start..p.len() {
        let b = p.byte(i)
        name.push_char(if b == 45 || b == 95 { 32 } else { u32(b) })
    }
    var hits = index.search(name.as_str(), 8)
    if hits.is_empty() {
        var longest = String::new()
        for (a, b) in name.as_str().split(" ") {
            if b - a > longest.len() { longest = name.as_str().slice(a, b).to_string() }
        }
        hits = index.search(longest.as_str(), 8)
    }
    if hits.is_empty() {
        md.push_str("Press `/` and search for what you're looking for.\n")
        return md
    }
    // Pages of the missing page's own group (`spec`, `std`) first: it moved most likely there.
    let group = p.slice(from: 0, to: p.find("/").unwrap_or(p.len())).to_string()
    hits.sort_by(
        |a, b| page_of(index, a).as_str().starts_with(group.as_str()) &&
            !page_of(index, b).as_str().starts_with(group.as_str()),
    )
    md.push_str(
        "A page that moved may be one of these. Or press `/` and search for what you're looking for.\n\n## Pages that may be it\n\n",
    )
    for h in hits {
        let (title, under) = result_text(index, h)
        let (page, anchor) = if h.item {
            (index.items[h.at].page.clone(), index.items[h.at].anchor.clone())
        } else { (index.sections[h.at].page.clone(), index.sections[h.at].anchor.clone()) }
        let place = if anchor.is_empty() { String::new() } else { f"#{anchor.as_str()}" }
        md.push_str(
            f"- [{title.as_str()}]({up.as_str()}{page.as_str()}{place.as_str()}): {under.as_str()}\n",
        )
    }
    take md
}

/// The page a search result is on.
fn page_of(index: Index, h: Hit) -> String {
    if h.item { index.items[h.at].page.clone() } else { index.sections[h.at].page.clone() }
}

/// How many topics the engine's modules are listed under on the front page, so a reader finds the
/// renderer's modules, or the sim's, among the engine's many; then each topic's title and its
/// modules. A module not named in one is listed under "More", the topic after them.
const TOPICS: u32 = 6

fn topic_title(t: u32) -> String {
    String::from(match t {
        0 => "Rendering and light",
        1 => "Creatures",
        2 => "Forms and plants",
        3 => "The ground and water",
        4 => "Simulation",
        5 => "Sound and music",
        _ => "More",
    })
}

fn topic_modules(t: u32) -> String {
    String::from(match t {
        0 => "air cook frame light lit lod impostor paint plain probes shadow shafts sheet shot sky sprite temporal view",
        1 => "character creature gait look physique realize",
        2 => "grass loft plant stone sweep vegetation",
        3 => "terrain water wood",
        4 => "history noise present rng run sim spatial timeline",
        5 => "perform piano piano_grand score sound",
        _ => "",
    })
}

/// The topic engine module `module` is listed under.
fn engine_topic(module: str) -> u32 {
    for t in 0..TOPICS {
        let list = topic_modules(t)
        let modules = list.as_str()
        var a = 0
        while a < modules.len() {
            var e = a
            while e < modules.len() && modules.byte(e) != 32 { e += 1 }
            if modules.slice(from: a, to: e) == module { return t }
            a = e + 1
        }
    }
    TOPICS
}

/// The group a page is listed in: `spec`, or its package.
fn group_of(path: str, kind: str) -> borrow str {
    if kind == "spec" { return kind }
    let k = path.find("/").unwrap_or(path.len())
    path.slice(from: 0, to: k)
}

fn rank(path: str, kind: str) -> u32 {
    let g = group_of(path, kind)
    if g == "spec" { 0 } else if g == "std" { 1 } else { 2 }
}

/// A group's name, in the list and as its heading on the front page, and the package it is (none
/// for the language's).
fn group_title(g: str) -> (String, String) {
    let name = if g == "spec" { "The language" } else if g == "std" {
        "Standard library"
    } else if g == "engine" {
        "Engine"
    } else if g == "land" {
        "Landscapes"
    } else if g == "ui" { "Drawing and widgets" } else if g == "platform" {
        "Host services"
    } else if g == "studio_tool" {
        "The studio's tool"
    } else {
        return (g.to_string(), g.to_string())
    }
    (name.to_string(), if g == "spec" { String::new() } else { g.to_string() })
}

// ---- input -------------------------------------------------------------------------------------

fn handle(s: mut Docs, e: Event, f: Frame) {
    let u = s.u
    match e {
        Event::PointerMove { at, .. } => {
            // A pointer that moves with nothing held is a mouse's.
            if s.press.is_none() &&
                s.knob_held.is_none() &&
                s.orbit.is_none() &&
                s.thumb.is_none() {
                s.finger = false
            }
            s.pointer = at
            // The pointer chooses the result it's over, as the arrow keys do.
            if s.searching {
                if let Some(i) = result_at(s, at, f) { s.chosen = i }
            }
            drag(mut s, at, f)
        },
        Event::PointerDown { at, button, .. } => {
            // A press stops a fling, as a finger stops a page that's still moving.
            s.fling = None
            s.slop = 0.0
            if button != Button::Primary {
                s.pointer = at
                return
            }
            press(mut s, at, f)
            s.pointer = at
        },
        Event::PointerUp { at, button, .. } => if button == Button::Primary {
            s.pointer = at
            drag(mut s, at, f)
            s.thumb = None
            let_go(mut s)
            start_fling(mut s)
            if s.knob_held.is_some() || s.orbit.is_some() {
                s.knob_held = None
                s.orbit = None
                s.press = None
                s.swipe = None
            }
            release(mut s)
        },
        Event::Wheel { at, delta, .. } => {
            s.fling = None
            if over_nav(s, at, f) { s.nav_scroll += delta.y } else if !s.searching {
                scroll_by(mut s, delta.y, f)
            }
        },
        Event::KeyDown { key, mods, .. } => {
            // Find: Command-F opens it, and Command-G (or F3) goes to the next match, from anywhere.
            if mods.command() && key == Key::F {
                s.finding = true
                s.searching = false
                s.caret = s.find.len()
                s.other_end = s.caret
                return
            }
            if (mods.command() && key == Key::G) || key == Key::F3 {
                step_match(mut s, if mods.shift { -1 } else { 1 }, f)
                return
            }
            if s.searching {
                if key == Key::Escape { s.searching = false }
                if key == Key::Backspace {
                    erase(mut s.query, mut s.caret, mut s.other_end, mods.command())
                    refresh_hits(mut s)
                }
                if mods.command() && key == Key::A { select_all(mut s) }
                if key == Key::Down && s.chosen + 1 < s.hits.len() { s.chosen += 1 }
                if key == Key::Up && s.chosen > 0 { s.chosen -= 1 }
                if key == Key::Enter && s.chosen < s.hits.len() { choose(mut s, s.chosen) }
                return
            }
            if s.finding {
                if key == Key::Escape { s.finding = false }
                if key == Key::Backspace {
                    erase(mut s.find, mut s.caret, mut s.other_end, mods.command())
                    refresh_matches(mut s, f)
                }
                if mods.command() && key == Key::A { select_all(mut s) }
                if key == Key::Enter { step_match(mut s, if mods.shift { -1 } else { 1 }, f) }
                return
            }
            if mods.command() && key == Key::K { open_search(mut s) }
            if mods.command() && key == Key::A { s.selected = Some((0, s.text.len())) }
            if key == Key::Escape {
                s.selected = None
                s.touch_selection = false
            }
            let page = s.screen.y - f.header - 80.0 * u
            if key == Key::Space || key == Key::PageDown {
                glide_by(mut s, if mods.shift {
                    -page
                } else { page }, f)
            }
            if key == Key::PageUp { glide_by(mut s, -page, f) }
            if key == Key::Down { glide_by(mut s, 48.0 * u, f) }
            if key == Key::Up { glide_by(mut s, -48.0 * u, f) }
            if key == Key::Home { s.glide = Some(0.0) }
            if key == Key::End { s.glide = Some(max_scroll(s, f)) }
            if key == Key::Escape { s.nav_open = false }
        },
        Event::Text { char } => {
            if s.finding {
                if char >= 32 && char != 127 && s.find.len() < 120 {
                    put_typed(mut s.find, mut s.caret, mut s.other_end, one(char).as_str())
                    refresh_matches(mut s, f)
                }
                return
            }
            if !s.searching {
                // `/` opens search, as on many sites.
                if char == 47 { open_search(mut s) }
                return
            }
            if char >= 32 && char != 127 && s.query.len() < 120 {
                put_typed(mut s.query, mut s.caret, mut s.other_end, one(char).as_str())
                refresh_hits(mut s)
            }
        },
        Event::Paste { serial } => if s.searching || s.finding {
            s.pasting = Some(host::pasted(serial))
        },
        Event::Assist { node, action } => assisted(mut s, node, action, f),
        Event::Field { node, revision } => {
            if node == SEARCH_FIELD { s.search_box.heard = max(s.search_box.heard, revision) }
            if node == FIND_FIELD { s.find_box.heard = max(s.find_box.heard, revision) }
        },
        _ => {},
    }
}

/// Takes the character before the caret from `q`, or all of it with Command; or, if something
/// is selected, that.
fn erase(q: mut String, caret: mut u32, other: mut u32, all: bool) {
    let lo = min(min(caret, other), q.len())
    let hi = min(max(caret, other), q.len())
    if all {
        q.clear()
        caret = 0
    } else if lo < hi {
        let rest = q.as_str().slice(from: hi, to: q.len()).to_string()
        q.truncate(lo)
        q.push_str(rest.as_str())
        caret = lo
    } else if lo > 0 {
        let k = previous_cluster(q.as_str(), lo)
        let rest = q.as_str().slice(from: lo, to: q.len()).to_string()
        q.truncate(k)
        q.push_str(rest.as_str())
        caret = k
    }
    other = caret
}

/// Puts `typed` in `q` in place of what's selected, or at the caret, and the caret after it.
fn put_typed(q: mut String, caret: mut u32, other: mut u32, typed: str) {
    let lo = min(min(caret, other), q.len())
    let hi = min(max(caret, other), q.len())
    let rest = q.as_str().slice(from: hi, to: q.len()).to_string()
    q.truncate(lo)
    q.push_str(typed)
    q.push_str(rest.as_str())
    caret = lo + typed.len()
    other = caret
}

/// A character as text.
fn one(char: u32) -> String {
    var t = String::new()
    t.push_char(char)
    take t
}

/// Selects all of what's typed in search's or find's box, in the host's field too.
fn select_all(s: mut Docs) {
    if s.finding {
        s.caret = s.find.len()
        s.find_box.replace += 1
    } else {
        s.caret = s.query.len()
        s.search_box.replace += 1
    }
    s.other_end = 0
}

/// Where find's query is on the page, and the match nearest the reader's place made current.
fn refresh_matches(s: mut Docs, f: Frame) {
    s.matches.clear()
    s.current = 0
    let q = lower(s.find.as_str())
    if q.is_empty() { return }
    var from = 0
    while from < s.lowered.len() {
        let Some(k) = s.lowered
            .as_str()
            .slice(from: from, to: s.lowered.len())
            .find(q.as_str()) else { break }
        s.matches.push(from + k)
        from = from + k + q.len()
    }
    // The first match below the top of what's on screen.
    for i in 0..s.matches.len() {
        if y_of(s, s.matches[i]) >= s.scroll {
            s.current = i
            break
        }
    }
    reveal(mut s, f)
}

/// The next match (`by` 1) or the one before (-1), round the page.
fn step_match(s: mut Docs, by: i32, f: Frame) {
    let n = s.matches.len()
    if n == 0 {
        s.finding = true
        return
    }
    s.current = if by > 0 { (s.current + 1) % n } else { (s.current + n - 1) % n }
    reveal(mut s, f)
}

/// Scrolls the current match into view.
fn reveal(s: mut Docs, f: Frame) {
    if s.current >= s.matches.len() { return }
    let y = y_of(s, s.matches[s.current])
    let view = s.screen.y - f.top
    if y < s.scroll + 40.0 * s.u || y > s.scroll + view - 80.0 * s.u {
        s.glide = None
        s.scroll = clamp(y - view * 0.35, 0.0, max_scroll(s, f))
    }
}

/// The top of the piece where byte `at` of the page's text is.
fn y_of(s: Docs, at: u32) -> f32 {
    let i = piece_of(s, at)
    if i < s.laid.pieces.len() { s.laid.pieces[i].at.y } else { 0.0 }
}

/// The piece that holds byte `at` of the page's text.
fn piece_of(s: Docs, at: u32) -> u32 {
    var lo = 0
    var hi = s.starts.len()
    while lo + 1 < hi {
        let mid = (lo + hi) / 2
        if s.starts[mid] <= at { lo = mid } else { hi = mid }
    }
    lo
}

fn open_search(s: mut Docs) {
    if !s.searching { s.search_at = s.time }
    s.searching = true
    s.touch_selection = false
    s.query.clear()
    // The host's field starts empty too.
    s.search_box.replace += 1
    s.caret = 0
    s.other_end = 0
    s.hits.clear()
    s.chosen = 0
}

fn refresh_hits(s: mut Docs) {
    s.hits = s.index.search(s.query.as_str(), RESULTS)
    s.chosen = 0
}

/// Goes to search result `i`.
fn choose(s: mut Docs, i: u32) {
    let h = s.hits[i]
    let route = if h.item {
        Route { page: s.index.items[h.at].page.clone(), anchor: s.index.items[h.at].anchor.clone() }
    } else {
        Route {
            page: s.index.sections[h.at].page.clone(),
            anchor: s.index.sections[h.at].anchor.clone(),
        }
    }
    go_to(mut s, route, push: true)
}

fn over_nav(s: Docs, at: vec2, f: Frame) -> bool {
    at.y > f.header && at.x < f.nav && (f.beside || s.nav_open)
}

fn scroll_by(s: mut Docs, dy: f32, f: Frame) {
    s.glide = None
    s.scroll = clamp(s.scroll + dy, 0.0, max_scroll(s, f))
}

/// Glides the page `dy` further than it's gliding to, or than it is.
fn glide_by(s: mut Docs, dy: f32, f: Frame) {
    let from = s.glide.unwrap_or(s.scroll)
    s.glide = Some(clamp(from + dy, 0.0, max_scroll(s, f)))
}

/// Moves the page toward where it glides, `dt` seconds on: most of the way in a tenth of a
/// second, and there at once when the system asks for less motion.
fn glide_on(s: mut Docs, f: Frame, dt: f32) {
    let Some(to) = s.glide else { return }
    let target = clamp(to, 0.0, max_scroll(s, f))
    s.scroll = glided(at: s.scroll, to: target, dt: dt, still: s.reduced)
    if s.scroll == target { s.glide = None }
}

/// Where a glide from `at` toward `to` is `dt` seconds on: there, where it's within half a pixel
/// or there's to be no motion.
fn glided(at: f32, to: f32, dt: f32, still: bool) -> f32 {
    if still || abs(to - at) < 0.5 { return to }
    at + (to - at) * (1.0 - exp(-dt * 20.0))
}

fn max_scroll(s: Docs, f: Frame) -> f32 {
    // Room under the text for its neighbours and its Markdown.
    max(f.top + s.laid.height + 200.0 * s.u - s.screen.y, 0.0)
}

fn press(s: mut Docs, at: vec2, f: Frame) {
    let hovered = length(s.pointer - at) < 2.0
    // Search's box over the page: a result goes there, the box keeps search open, and a press
    // anywhere else closes it.
    if s.searching {
        if let Some(i) = result_at(s, at, f) {
            choose(mut s, i)
            return
        }
        if !dialog_rect(s, f).contains(at) { s.searching = false }
        return
    }
    // A finger's selection: its button copies it, a handle moves its end, and a press anywhere
    // else lets it go, as on any page.
    if s.touch_selection {
        if let Some(b) = copy_button(s, f) {
            if b.contains(at) {
                copy_selection(mut s)
                return
            }
        }
        if let Some(h) = handle_at(s, at, f) {
            s.handle = h
            s.finger = true
            return
        }
        s.touch_selection = false
        s.selected = None
        return
    }
    if f.search.contains(at) {
        if !s.finding { open_search(mut s) }
        return
    }
    if at.y < f.header {
        for (r, what) in header_buttons(s, f) {
            if !r.contains(at) { continue }
            header_button(mut s, what.as_str())
            // Open, the list shows the page being read at its top, its sections under it.
            if what.as_str() == "menu" && s.nav_open { s.nav_follow = true }
        }
        return
    }
    // A scrollbar: its thumb is held, and a press on its track brings the thumb there first.
    for nav in [false, true] {
        let Some((track, thumb)) = scrollbar(s, f, nav) else { continue }
        if !track.contains(at) { continue }
        if !thumb.contains(at) {
            let y = (at.y - track.y - thumb.h * 0.5) / max(track.h - thumb.h, 1.0)
            set_scroll(mut s, f, nav, clamp(y, 0.0, 1.0) * scroll_room(s, f, nav))
        }
        s.thumb = Some((at.y, if nav { s.nav_scroll } else { s.scroll }, nav))
        return
    }
    s.finger = !hovered
    s.press_at = s.time
    if over_nav(s, at, f) {
        // A page of the list opens when the press lets go without moving; a finger's drag
        // scrolls the list.
        let held = nav_at(s, at, f).unwrap_or(String::new())
        s.press = Some((at, false, take held))
        if !hovered { s.swipe = Some((s.nav_scroll, true)) }
        return
    }
    if s.nav_open {
        s.nav_open = false
        s.nav_at = s.time
        return
    }
    if let Some(target) = extra_at(s, at, f) {
        s.press = Some((at, false, take target))
        return
    }
    for c in controls(s, f, at, all: false) {
        if c.rect.contains(at) {
            s.press = Some((at, false, c.target.clone()))
            return
        }
    }
    // A live field's number: it drags.
    for i in 0..s.laid.knobs.len() {
        if knob_rect(s, f, i).contains(at) {
            // A finger shows by its first move whether it drags the number or scrolls the page.
            s.knob_held = Some((i, at, knob_value(s, i), !hovered))
            return
        }
    }
    // A figure's tab: it shows that view.
    for i in 0..s.laid.figures.len() {
        for (r, mode, _) in figure_tabs(s, f, i) {
            if r.contains(at) {
                if let Some(l) = live_of(s, s.laid.figures[i].block) { s.lives[l].mode = mode }
                return
            }
        }
    }
    // A live figure: a mouse turns and tilts it, and over a slice shows what the field is where it
    // is. A finger's first move says its way: across, it turns the field or moves the slice's
    // probe; up or down, it scrolls the page.
    for i in 0..s.laid.figures.len() {
        if figure_rect(s, f, i).contains(at) {
            let (turn, tilt) = match live_of(s, s.laid.figures[i].block) {
                Some(l) => (s.lives[l].turn, s.lives[l].tilt),
                None => (0.0, 0.0),
            }
            s.orbit = Some((i, at, turn, tilt, if hovered { HELD_BY_MOUSE } else { FINGER_UNSURE }))
            if !hovered { s.swipe = Some((s.scroll, false)) }
            return
        }
    }
    let link = link_at(s, at, f).unwrap_or(String::new())
    // A mouse hovers where it presses; a finger lands without hovering, and its drag scrolls, or
    // held still, it selects the words under it.
    s.press = Some((at, false, take link))
    if !hovered {
        s.swipe = Some((s.scroll, false))
        return
    }
    s.selected = match place(s, at, f) {
        Some(k) => Some((k, k)),
        None => None,
    }
}

/// A finger held still on the page's words for `HOLD` seconds selects the word under it, and
/// its moves from then on carry the selection's end, as on any page.
fn held_long(s: mut Docs, f: Frame) {
    let Some((from, moved, _)) = s.press else { return }
    if moved || !s.finger || !swipes_page(s) || s.time - s.press_at < HOLD { return }
    let Some(k) = place(s, from, f) else { return }
    let (a, b) = word_at(s.text.as_str(), k)
    if a == b { return }
    s.selected = Some((a, b))
    s.touch_selection = true
    s.handle = 2
    s.press = None
    s.swipe = None
    s.trail.clear()
    s.dirty = true
}

/// The word round byte `k` of `text`: its letters, digits, `_` and `:`, and the bytes past ASCII;
/// else the byte itself.
fn word_at(text: str, k: u32) -> (u32, u32) {
    let wordy = |b: u8| -> bool { highlight::is_word(b) || b >= 128 || b == 58 }
    if k >= text.len() { return (k, k) }
    if !wordy(text.byte(k)) { return (k, min(k + 1, text.len())) }
    var a = k
    while a > 0 && wordy(text.byte(a - 1)) { a -= 1 }
    var b = k
    while b < text.len() && wordy(text.byte(b)) { b += 1 }
    (a, b)
}

/// What's selected, as text.
fn selected_words(s: Docs) -> String {
    match s.selected {
        Some((a, b)) => if a == b { String::new() } else {
            s.text.as_str().slice(from: min(a, b), to: min(max(a, b), s.text.len())).to_string()
        },
        None => String::new(),
    }
}

/// Where byte `at` of the page's text is on the screen: its line's left and its top and bottom.
fn place_of(s: Docs, at: u32, f: Frame) -> Option<(f32, f32, f32)> {
    if s.starts.is_empty() { return None }
    let i = piece_of(s, at)
    if i >= s.laid.pieces.len() { return None }
    borrow p = s.laid.pieces[i]
    let k = min(at - min(s.starts[i], at), p.text.len())
    let x = s.fonts.font(p.face).caret_at(p.text.as_str(), p.size, k)
    let y = p.at.y + page_y(s, f)
    Some((p.at.x + f.x + x, y - p.size * 0.12, y + p.size * 1.2))
}

/// A finger's selection's handles, under each end: where they are, the one where it began first.
fn handles(s: Docs, f: Frame) -> Vec<(vec2, u32)> {
    var out: Vec<(vec2, u32)> = Vec::new()
    if !s.touch_selection { return out }
    let Some((a, b)) = s.selected else { return out }
    for (end, which) in [(a, 1), (b, 2)] {
        if let Some((x, _, bottom)) = place_of(s, end, f) { out.push((vec2(x, bottom), which)) }
    }
    out
}

/// The handle under `at`, with room round it for a finger.
fn handle_at(s: Docs, at: vec2, f: Frame) -> Option<u32> {
    for (c, which) in handles(s, f) {
        if length(at - (c + vec2(0.0, 8.0 * s.u))) < 26.0 * s.u { return Some(which) }
    }
    None
}

/// The button over a finger's selection that copies it, once the finger lets go: over the
/// selection's first line, or under its last where there's no room over it.
fn copy_button(s: Docs, f: Frame) -> Option<Rect> {
    if !s.touch_selection || s.handle != 0 { return None }
    let Some((a, b)) = s.selected else { return None }
    let Some((x0, top, _)) = place_of(s, min(a, b), f) else { return None }
    let Some((x1, _, bottom)) = place_of(s, max(a, b), f) else { return None }
    let u = s.u
    let w = 76.0 * u
    let h = 36.0 * u
    let x = clamp((x0 + x1) * 0.5 - w * 0.5, 8.0 * u, s.screen.x - w - 8.0 * u)
    let y = if top - h - 12.0 * u > f.header + 8.0 * u { top - h - 12.0 * u } else {
        min(bottom + 24.0 * u, s.screen.y - h - 8.0 * u)
    }
    Some(Rect::new(x, y, w, h))
}

/// Where `at` is in the page's text, as a byte.
fn place(s: Docs, at: vec2, f: Frame) -> Option<u32> {
    let p = vec2(at.x - f.x, at.y - page_y(s, f))
    match s.laid.place_at(s.fonts, p) {
        Some((i, k)) => Some(s.starts[i] + k),
        None => None,
    }
}

/// Whether the pointer is over the page's words, which a mouse selects.
fn over_text(s: Docs, f: Frame) -> bool {
    let p = vec2(s.pointer.x - f.x, s.pointer.y - page_y(s, f))
    for piece in s.laid.pieces {
        if p.y >= piece.at.y - piece.size * 0.2 &&
            p.y < piece.at.y + piece.size * 1.35 &&
            p.x >= piece.at.x &&
            p.x < piece.at.x + piece.w {
            return true
        }
    }
    false
}

/// The pointer moved while it's held on the page: the selection goes to it.
fn drag(s: mut Docs, at: vec2, f: Frame) {
    // A finger carrying a selection's end: the end goes to the words under it.
    if s.touch_selection && s.handle != 0 {
        let Some((a, b)) = s.selected else { return }
        if let Some(k) = place(s, at - vec2(0.0, 6.0 * s.u), f) {
            s.selected = Some(if s.handle == 1 { (k, b) } else { (a, k) })
        }
        return
    }
    if let Some((i, from, v0, unsure)) = s.knob_held {
        if unsure {
            let d = (at - from) / s.u
            if length(d) < FINGER_SLOP { return }
            if abs(d.y) > abs(d.x) {
                // Up or down: the page scrolls, as anywhere else.
                s.knob_held = None
                s.press = Some((from, true, String::new()))
                s.swipe = Some((s.scroll, false))
                s.slop = at.y - from.y
                drag(mut s, at, f)
                return
            }
            s.knob_held = Some((i, from, v0, false))
        }
        // A pixel's worth of drag: a 250th of the number's size, or of a quarter where it's small.
        let step = max(abs(v0), 0.25) * 0.004
        var v = v0 + (at.x - from.x) / s.u * step
        if v0 >= 0.0 { v = max(v, 0.0) }
        set_knob(mut s, i, v)
        return
    }
    if let Some((i, from, turn, tilt, by)) = s.orbit {
        let block = s.laid.figures[i].block
        let Some(l) = live_of(s, block) else { return }
        let d = (at - from) / s.u
        var held = by
        if held == FINGER_UNSURE {
            if length(d) < FINGER_SLOP { return }
            held = if abs(d.x) > abs(d.y) { FINGER_TURNS } else { FINGER_SCROLLS }
            if held == FINGER_SCROLLS { s.slop = at.y - from.y }
            s.orbit = Some((i, from, turn, tilt, held))
        }
        // A slice doesn't turn: the pointer is its probe.
        let surface = s.lives[l].mode == SURFACE
        if held != FINGER_SCROLLS && surface { s.lives[l].turn = turn - d.x * 0.008 }
        if held == HELD_BY_MOUSE && surface {
            s.lives[l].tilt = clamp(tilt + d.y * 0.006, 0.1, 1.3)
        }
        if held == FINGER_SCROLLS {
            if let Some((start, _)) = s.swipe {
                finger_drag(mut s, f, start, nav: false, dy: at.y - from.y)
                follow_finger(mut s, at.y)
            }
        }
        return
    }
    if let Some((from, start, nav)) = s.thumb {
        let Some((track, thumb)) = scrollbar(s, f, nav) else { return }
        let room = scroll_room(s, f, nav)
        set_scroll(mut s, f, nav, start + (at.y - from) * room / max(track.h - thumb.h, 1.0))
        return
    }
    let Some((from, moved, held)) = s.press else { return }
    let link = held.clone()
    // A finger wavers as it taps: it takes a longer move than a mouse's to be a drag.
    let slop = if s.swipe.is_some() { PAGE_SLOP } else { 4.0 }
    let far = length(at - from) > slop * s.u
    if !moved && !far { return }
    // The drag begins where it is: the page doesn't jump the way the finger came.
    if !moved && s.swipe.is_some() { s.slop = at.y - from.y }
    s.press = Some((from, true, link.clone()))
    if let Some((start, nav)) = s.swipe {
        finger_drag(mut s, f, start, nav, at.y - from.y)
        follow_finger(mut s, at.y)
        return
    }
    // A press on the list of pages selects nothing.
    if link.as_str().starts_with("nav:") ||
        link.as_str().starts_with("group:") ||
        s.selected.is_none() {
        return
    }
    let Some((start, _)) = s.selected else { return }
    if let Some(k) = place(s, at, f) { s.selected = Some((start, k)) }
}

/// A finger drags the page, or the list of pages (`nav`), from `start`, `dy` from where it pressed:
/// the page moves with it, pixel for pixel, the way it came before the drag began behind it.
fn finger_drag(s: mut Docs, f: Frame, start: f32, nav: bool, dy: f32) {
    let y = start - dy + s.slop
    if nav { s.nav_scroll = max(y, 0.0) } else { finger_scroll(mut s, f, y) }
}

/// A finger scrolls the page to `y`: within its ends, and past them it stretches, less the
/// farther it goes, as a page does under a finger.
fn finger_scroll(s: mut Docs, f: Frame, y: f32) {
    s.glide = None
    let room = max_scroll(s, f)
    s.scroll = clamp(y, 0.0, room)
    s.pull = if y < 0.0 { stretch(-y, s.screen.y) } else if y > room {
        -stretch(y - room, s.screen.y)
    } else { 0.0 }
}

/// How far a page `h` tall stretches when a finger pulls it `d` past its end.
fn stretch(d: f32, h: f32) -> f32 {
    d * 0.55 / (1.0 + d / (h * 0.5))
}

/// A finger let go: a pull past the page's top far enough fetches the page again.
fn let_go(s: mut Docs) {
    if swipes_page(s) && s.pull >= PULL * s.u && !s.reloading { refresh(mut s) }
}

/// Whether a finger's press scrolls the page, rather than the list of pages or nothing.
fn swipes_page(s: Docs) -> bool {
    match s.swipe {
        Some((_, nav)) => !nav,
        None => false,
    }
}

/// Fetches the index and the page being read again, in place: the page stays where the reader
/// is while they come, and is laid out again from them, at the same place.
fn refresh(s: mut Docs) {
    s.reloading = true
    s.refreshed_at = s.time
    s.index_load = Some(fetch("index.json"))
    if s.route.page.is_empty() { return }
    let page = s.route.page.clone()
    s.pages.retain(|p| p.0 != page)
    s.restore = Some(s.scroll)
    s.page_load = Some(fetch(page.as_str()))
    s.loading = take page
}

/// A stretch let go springs back; a pull that loads the page again rests where it shows that.
fn spring_on(s: mut Docs, dt: f32) {
    // A refresh shows until what it fetched has come, and for a moment at least.
    if s.reloading &&
        s.page_load.is_none() &&
        s.index_load.is_none() &&
        s.time - s.refreshed_at > 0.6 {
        s.reloading = false
    }
    if swipes_page(s) || s.pull == 0.0 { return }
    let rest = if s.reloading { PULL * s.u } else { 0.0 }
    let k = if s.reduced { 1.0 } else { 1.0 - exp(-dt * 14.0) }
    s.pull += (rest - s.pull) * k
    if abs(s.pull - rest) < 0.5 { s.pull = rest }
}

/// Where a swiping finger is now, kept with the moments before it, a frame apart.
fn follow_finger(s: mut Docs, y: f32) {
    let n = s.trail.len()
    if n > 0 && s.trail[n - 1].1 == s.time {
        s.trail[n - 1].0 = y
    } else { s.trail.push((y, s.time)) }
    if s.trail.len() > 8 { let _ = s.trail.remove(0) }
}

/// A swipe let go: at the speed its finger had over its last tenth of a second, it carries on.
fn start_fling(s: mut Docs) {
    let trail = s.trail.clone()
    s.trail.clear()
    let Some((_, nav)) = s.swipe else { return }
    let moved = match s.press {
        Some((_, m, _)) => m,
        None => match s.orbit {
            Some((_, _, _, _, by)) => by == FINGER_SCROLLS,
            None => false,
        },
    }
    if !moved || trail.len() < 2 || s.pull != 0.0 { return }
    let v = swipe_speed(trail, s.time)
    if abs(v) > 60.0 * s.u { s.fling = Some((v, nav)) }
}

/// The speed of a finger along `trail` (where it was, and when), in pixels a second that the page
/// scrolls: over its last tenth of a second before `now`, and none if it rested longer than that.
fn swipe_speed(trail: [(f32, f32)], now: f32) -> f32 {
    let n = trail.len()
    if n < 2 { return 0.0 }
    let (y1, t1) = trail[n - 1]
    if now - t1 > 0.1 { return 0.0 }
    var k = n - 1
    while k > 0 && t1 - trail[k - 1].1 <= 0.1 { k -= 1 }
    if k == n - 1 { k = n - 2 }
    let (y0, t0) = trail[k]
    if t1 - t0 < 0.005 { return 0.0 }
    -(y1 - y0) / (t1 - t0)
}

/// A fling carries the page, or the list of pages, on, slowing as a page on a phone does, and
/// stops at either end.
fn fling_on(s: mut Docs, f: Frame, dt: f32) {
    let Some((v, nav)) = s.fling else { return }
    let before = if nav { s.nav_scroll } else { s.scroll }
    set_scroll(mut s, f, nav, before + v * dt)
    let after = if nav { s.nav_scroll } else { s.scroll }
    let slower = v * exp(-dt * 2.4)
    let stopped = dt > 0.0 && after == before
    // The page meets its end still moving: it stretches past it a little, and springs back.
    if stopped && !nav && !s.reduced && v > 0.0 { s.pull = -min(v * 0.03, 48.0 * s.u) }
    s.fling = if abs(slower) < 12.0 * s.u || stopped { None } else { Some((slower, nav)) }
}

/// The pointer let go: a press that didn't move follows the link it was on, and selects nothing.
fn release(s: mut Docs) {
    if s.handle != 0 {
        s.handle = 0
        return
    }
    let Some((_, moved, held)) = s.press else { return }
    let link = held.clone()
    let still = !moved
    s.press = None
    s.swipe = None
    if !still { return }
    s.selected = None
    if !link.is_empty() { follow_link(mut s, link.as_str()) }
}

/// Where a link leads: another page, a place, out, or an item's source; a page of the list
/// (`nav:`), a section of this page (`here:`), or one of the docs' files, which opens as it is
/// (`file:`).
fn follow_link(s: mut Docs, target: str) {
    if target.starts_with("nav:") {
        let page = target.slice(from: 4, to: target.len()).to_string()
        go_to(mut s, Route { page, anchor: String::new() }, push: true)
        return
    }
    if target.starts_with("group:") {
        toggle_group(mut s, target.slice(from: 6, to: target.len()))
        return
    }
    if target.starts_with("here:") {
        let anchor = target.slice(from: 5, to: target.len()).to_string()
        go_to(mut s, Route { page: s.shown.clone(), anchor }, push: true)
        return
    }
    if target == "search:" {
        open_search(mut s)
        return
    }
    if target == "home:" {
        go_to(mut s, Route::front(), push: true)
        return
    }
    if target == "copy:page" {
        let md = s.markdown.clone()
        copy(mut s, target, md.as_str())
        return
    }
    if target.starts_with("copy:code:") {
        let i = parse_u32(target.slice(from: 10, to: target.len()))
        if i < s.laid.snippets.len() {
            let code = s.laid.snippets[i].text.clone()
            copy(mut s, target, code.as_str())
        }
        return
    }
    if target.starts_with("source:") || target.starts_with("file:") {
        let url = href_of(s, target)
        if !url.is_empty() { s.told.push(host::open_link(url.as_str())) }
        return
    }
    match follow(s.shown.as_str(), target) {
        Some(Target::Docs(route)) => go_to(mut s, route, push: true),
        Some(Target::File(path)) => s.told.push(host::open_link(path.as_str())),
        Some(Target::Out(url)) => s.told.push(host::open_link(url.as_str())),
        None => {},
    }
}

/// Puts `text` on the clipboard, for the control `what`, which says how that went.
fn copy(s: mut Docs, what: str, text: str) {
    if text.is_empty() { return }
    s.copying = Some(host::copy(text))
    s.copied = what.to_string()
    s.copied_at = -10.0
}

/// Copies what a finger selected, and lets the selection go.
fn copy_selection(s: mut Docs) {
    let words = selected_words(s)
    copy(mut s, "copy:selection", words.as_str())
    s.touch_selection = false
    s.selected = None
}

/// What header button `what` does (`header_buttons`): opens or closes the list of pages, goes to
/// the front page, or opens the repository.
fn header_button(s: mut Docs, what: str) {
    if what == "menu" {
        s.nav_open = !s.nav_open
        s.nav_at = s.time
    } else if what == "home" {
        go_to(mut s, Route::front(), push: true)
    } else if !s.index.repository.is_empty() {
        s.told.push(host::open_link(s.index.repository.as_str()))
    }
}

/// What control `what` says of its copy, for a moment after it: whether it worked.
fn copy_said(s: Docs, what: str) -> Option<String> {
    said(s.copied.as_str(), s.copied_at, s.copy_ok, s.time, what)
}

/// What control `what` says at time `now` of the last copy, by control `copied` at time `at`,
/// which worked or not (`ok`): for `SAID` seconds, whether it worked; then nothing.
fn said(copied: str, at: f32, ok: bool, now: f32, what: str) -> Option<String> {
    if copied != what || now < at || now - at > SAID { return None }
    Some(String::from(if ok { "Copied" } else { "Couldn't copy" }))
}

/// The number `t` writes in decimal digits; 0 for anything else.
fn parse_u32(t: str) -> u32 {
    var n = 0
    for i in 0..t.len() {
        let b = t.byte(i)
        if b < 48 || b > 57 || n > 100000000 { return 0 }
        n = n * 10 + u32(b - 48)
    }
    n
}

/// The link under `at` on the page, if there is one.
fn link_at(s: Docs, at: vec2, f: Frame) -> Option<String> {
    if at.y < f.header { return None }
    let p = vec2(at.x - f.x, at.y - page_y(s, f))
    for spot in s.laid.spots {
        if spot.rect.contains(p) { return Some(spot.target.clone()) }
    }
    None
}

/// An assistive technology acted on node `node`: a link is followed, and one it reaches is
/// brought into view.
fn assisted(s: mut Docs, node: u32, action: Assist, f: Frame) {
    // The focus reaching search's box opens search.
    if node == SEARCH_FIELD {
        if action == Assist::Focus && !s.searching && !s.finding { open_search(mut s) }
        return
    }
    if node >= TABS {
        let i = (node - TABS) / 2
        let mode = (node - TABS) % 2
        if i < s.laid.figures.len() && (action == Assist::Activate || action == Assist::Select) {
            if let Some(l) = live_of(s, s.laid.figures[i].block) { s.lives[l].mode = mode }
        }
        return
    }
    if node >= TAB_LISTS { return }
    if node == COPY_SELECTION {
        copy_selection(mut s)
        return
    }
    if node >= HEADER_NODES && node < COPY_SELECTION {
        let buttons = header_buttons(s, f)
        let i = node - HEADER_NODES
        if action == Assist::Activate && i < buttons.len() {
            header_button(mut s, buttons[i].1.as_str())
        }
        return
    }
    if node >= KNOB_NODES {
        let i = node - KNOB_NODES
        if i < s.laid.knobs.len() && (action == Assist::Increment || action == Assist::Decrement) {
            let v = knob_value(s, i)
            let by = if action == Assist::Increment { knob_step(v) } else { -knob_step(v) }
            set_knob(mut s, i, if v >= 0.0 { max(v + by, 0.0) } else { v + by })
        }
        return
    }
    if node >= CONTROL_NODES {
        let all = controls(s, f, s.pointer, all: true)
        let i = node - CONTROL_NODES
        if action == Assist::Activate && i < all.len() {
            follow_link(mut s, all[i].target.as_str())
        }
        return
    }
    if node >= EXTRA_NODES {
        let ex = extras(s, f)
        let i = node - EXTRA_NODES
        if action == Assist::Activate && i < ex.len() { follow_link(mut s, ex[i].target.as_str()) }
        return
    }
    if node >= NAV_BUTTONS {
        let all = groups_in(s.index)
        let i = node - NAV_BUTTONS
        if action == Assist::Activate && i < all.len() { toggle_group(mut s, all[i].as_str()) }
        return
    }
    if node >= NAV_GROUPS { return }
    if node >= NAV_NODES {
        let i = node - NAV_NODES
        if action == Assist::Activate && i < s.index.pages.len() {
            go_to(
                mut s,
                Route { page: s.index.pages[i].path.clone(), anchor: String::new() },
                push: true,
            )
        }
        return
    }
    if node >= RESULT_NODES {
        let i = node - RESULT_NODES
        if i >= s.hits.len() { return }
        match action {
            Assist::Activate => choose(mut s, i),
            _ => s.chosen = i,
        }
        return
    }
    // The page's parts are numbered from 1: 0 is the tree's root.
    if node == 0 || node > s.laid.parts.len() { return }
    let target = s.laid.parts[node - 1].target.clone()
    let top = s.laid.parts[node - 1].rect.y
    match action {
        Assist::Activate => if !target.is_empty() { follow_link(mut s, target.as_str()) },
        _ => {
            let view = s.screen.y - f.top
            if top < s.scroll || top > s.scroll + view * 0.8 {
                s.scroll = clamp(top - 80.0 * s.u, 0.0, max_scroll(s, f))
            }
        },
    }
}

// ---- the list of pages -------------------------------------------------------------------------

/// A row of the list of pages: a group's title (no page) or a page, its label as the lines it
/// wraps to, its top from the list's top (unscrolled) and its height.
struct NavRow: Clone {
    group: String,
    path: String,
    lines: Vec<String>,
    y: f32,
    h: f32,
    /// A section of the page being read (its anchor), listed under it where the page has no
    /// outline beside it; empty for a page.
    anchor: String = String::new(),
}

/// Lays the list's rows out again when what they show or their room changed: each group's title,
/// then, if the group is open, its pages, each label wrapped to at most two lines. Keeps the
/// list's scroll within its rows.
fn keep_nav(s: mut Docs, f: Frame) {
    let u = s.u
    let room = vec2(f.nav, u)
    if s.nav_dirty || s.nav_for != room {
        s.nav_dirty = false
        s.nav_for = room
        var rows: Vec<NavRow> = Vec::new()
        var y = 12.0 * u
        var group = String::new()
        // Over the page, where a finger reads, the rows are a finger's height, and the page being
        // read has its sections under it: it has no outline beside it.
        let finger = !f.beside
        let pad = if finger { 24.0 } else { 12.0 }
        let title = if finger { 44.0 } else { 36.0 }
        for p in s.index.pages {
            let g = group_of(p.path.as_str(), p.kind.as_str())
            if g != group.as_str() {
                group = g.to_string()
                if !rows.is_empty() { y += 14.0 * u }
                let (name, _) = group_title(g)
                rows.push(
                    NavRow {
                        group: group.clone(),
                        path: String::new(),
                        lines: Vec::from([take name]),
                        y,
                        h: title * u,
                    },
                )
                y += title * u
            }
            if !is_open(s, g) { continue }
            let label = nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str())
            let lines = wrap(s.fonts, label.as_str(), SMALL * u, f.nav - 48.0 * u, 2)
            let h = (pad + 20.0 * f32(lines.len())) * u
            rows.push(NavRow { group: group.clone(), path: p.path.clone(), lines, y, h })
            y += h
            if finger && p.path == s.shown {
                for (label, anchor, _, level) in s.outline {
                    if level > 2 && is_module(s) { continue }
                    let lines = wrap(s.fonts, label.as_str(), 13.5 * u, f.nav - 68.0 * u, 2)
                    let h = (18.0 + 19.0 * f32(lines.len())) * u
                    rows.push(
                        NavRow {
                            group: group.clone(),
                            path: p.path.clone(),
                            lines,
                            y,
                            h,
                            anchor: anchor.clone(),
                        },
                    )
                    y += h
                }
            }
        }
        s.nav = take rows
    }
    s.nav_scroll = clamp(s.nav_scroll, 0.0, scroll_room(s, f, nav: true))
}

/// The bottom of the list's last row, from the list's top, with room under it.
fn nav_end(s: Docs) -> f32 {
    if s.nav.is_empty() { return 0.0 }
    borrow last = s.nav[s.nav.len() - 1]
    last.y + last.h + 24.0 * s.u
}

/// The list's rows where they are on the screen now.
fn nav_rows(s: Docs, f: Frame) -> Vec<NavRow> {
    let top = f.header - s.nav_scroll
    Vec::from_fn(s.nav.len(), |i| {
        var row = s.nav[i].clone()
        row.y += top
        take row
    })
}

/// Whether group `g`'s pages are listed.
fn is_open(s: Docs, g: str) -> bool {
    for o in s.open {
        if o.as_str() == g { return true }
    }
    false
}

/// The list shows the page being read: its group opens.
fn open_shown_group(s: mut Docs) {
    let Some(i) = s.index.page(s.shown.as_str()) else { return }
    borrow p = s.index.pages[i]
    let g = group_of(p.path.as_str(), p.kind.as_str()).to_string()
    if !is_open(s, g.as_str()) { toggle_group(mut s, g.as_str()) }
}

/// Opens group `g`'s pages in the list, or closes them.
fn toggle_group(s: mut Docs, g: str) {
    if is_open(s, g) {
        s.open.retain(|o| o.as_str() != g)
    } else { s.open.push(g.to_string()) }
    s.nav_dirty = true
}

/// The groups, in the list's order.
fn groups_in(index: Index) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for p in index.pages {
        let g = group_of(p.path.as_str(), p.kind.as_str())
        if out.is_empty() || out[out.len() - 1].as_str() != g { out.push(g.to_string()) }
    }
    take out
}

/// A page's name in the list and on the front page: a section of the spec by its title, a module
/// by its file's name (`arena` of `std/arena.md`, `builtins` of `std/builtins.md`), as its group
/// says whose it is.
fn nav_label(path: str, kind: str, title: str) -> String {
    if kind == "spec" { return title.to_string() }
    var start = path.len()
    while start > 0 && path.byte(start - 1) != 47 { start -= 1 }
    var end = path.len()
    if path.ends_with(".md") { end -= 3 }
    path.slice(from: start, to: max(start, end)).to_string()
}

/// `text` wrapped at spaces to lines at most `width` wide at `size`, at most `most` of them; the
/// last of those is cut with `…` if the text goes on.
fn wrap(fonts: Fonts, text: str, size: f32, width: f32, most: u32) -> Vec<String> {
    borrow font = fonts.font(Face::Sans)
    var lines: Vec<String> = Vec::new()
    var line = String::new()
    var line_start = 0
    var a = 0
    while a < text.len() {
        var e = a
        while e < text.len() && text.byte(e) != 32 { e += 1 }
        let word = text.slice(from: a, to: e)
        let tried = if line.is_empty() { word.to_string() } else { f"{line.as_str()} {word}" }
        if line.is_empty() || font.measure(tried.as_str(), size) <= width {
            if line.is_empty() { line_start = a }
            line = take tried
        } else {
            if lines.len() + 1 >= most {
                // The last line takes the rest, cut to fit.
                lines.push(fit(fonts, text.slice(from: line_start, to: text.len()), size, width))
                return lines
            }
            lines.push(take line)
            line = word.to_string()
            line_start = a
        }
        a = e + 1
    }
    if !line.is_empty() { lines.push(take line) }
    take lines
}

/// What's under `at` in the list: a page (`nav:` its path) or a group's title (`group:` its name).
fn nav_at(s: Docs, at: vec2, f: Frame) -> Option<String> {
    if at.y < f.header { return None }
    for row in nav_rows(s, f) {
        if at.y >= row.y && at.y < row.y + row.h {
            return Some(if row.path.is_empty() {
                f"group:{row.group.as_str()}"
            } else if !row.anchor
                .is_empty() {
                f"here:{row.anchor.as_str()}"
            } else { f"nav:{row.path.as_str()}" })
        }
    }
    None
}

// ---- the outline, and the links under the page --------------------------------------------------

/// A link drawn beside or under the page's text: where it is on the screen, where it leads, what
/// it says and what it is.
struct Extra: Clone {
    rect: Rect,
    target: String,
    label: String,
    kind: ExtraKind,
    /// An outline row's heading level: 2, or 3 for a module's item under its type.
    level: u32 = 2,
}

enum ExtraKind: Copy + Eq {
    /// Where the page is: the front page's link, then its group (the label).
    Crumb,
    /// A row of the page's outline, and whether it's the section being read.
    Outline(bool),
    Previous,
    Next,
    /// The page as the Markdown it's read from, and a copy of it, for an agent.
    Markdown,
    Copy,
}

/// The page's outline: a spec page's sections, or a module's items (its types and functions, and
/// under each type its own items, by their own names), each with its anchor, its top on the page
/// and its level.
fn outline_of(s: Docs) -> Vec<(String, String, f32, u32)> {
    var rows: Vec<(String, String, f32, u32)> = Vec::new()
    let module = is_module(s)
    for b in s.blocks {
        if b.kind != Kind::Heading || !(b.level == 2 || (module && b.level == 3)) { continue }
        for (a, y) in s.laid.anchors {
            if a == b.anchor {
                let words = plain(b.runs)
                let label = if b.level == 3 { last_name(words.as_str()).to_string() } else {
                    take words
                }
                rows.push((take label, a.clone(), y, b.level))
                break
            }
        }
    }
    take rows
}

/// Whether the page being read is a module's, whose headings are its items: not the spec's, nor
/// one that couldn't be opened.
fn is_module(s: Docs) -> bool {
    !s.shown.is_empty() && !s.shown.as_str().starts_with("spec/") && s.missed.is_empty()
}

/// The pages before and after the one being read, in the list's order: each its title and path.
fn neighbours(s: Docs) -> (Option<(String, String)>, Option<(String, String)>) {
    borrow pages = s.index.pages
    for i in 0..pages.len() {
        if pages[i].path != s.shown { continue }
        let before = if i > 0 {
            Some((pages[i - 1].title.clone(), pages[i - 1].path.clone()))
        } else { None }
        let after = if i + 1 < pages.len() {
            Some((pages[i + 1].title.clone(), pages[i + 1].path.clone()))
        } else { None }
        return (before, after)
    }
    (None, None)
}

/// The page's extras on this screen: where it is (the front page, then its group) over its
/// title; its outline at the right, where there's room, with the section being read among the
/// rows that fit; its neighbours under its text; and its Markdown, under the outline or under
/// the neighbours.
fn extras(s: Docs, f: Frame) -> Vec<Extra> {
    var out: Vec<Extra> = Vec::new()
    if s.shown.is_empty() || s.shown != s.route.page || s.blocks.is_empty() { return out }
    // A page that couldn't be opened has no neighbours and no Markdown.
    let Some(at_page) = s.index.page(s.shown.as_str()) else { return out }
    let u = s.u
    let crumb_y = page_y(s, f) - (if f.beside { 40.0 } else { 36.0 }) * u
    let dw = s.fonts.font(Face::Sans).measure("Docs", 13.5 * u)
    borrow page = s.index.pages[at_page]
    let (group, _) = group_title(group_of(page.path.as_str(), page.kind.as_str()))
    out.push(
        Extra {
            rect: Rect::new(f.x - 4.0 * u, crumb_y - 2.0 * u, dw + 8.0 * u, 24.0 * u),
            target: String::from("home:"),
            label: group,
            kind: ExtraKind::Crumb,
        },
    )
    let markdown = f"file:{s.shown.as_str()}"
    if f.rail.w > 0.0 {
        borrow rows = s.outline
        let row = 28.0 * u
        let top = f.rail.y + 32.0 * u
        let fits = max(u32(max(f.rail.h - 120.0 * u, 0.0) / row), 1)
        // The section being read: the last whose heading is above the reader's eye; none above
        // the first.
        var here: Option<u32> = None
        for i in 0..rows.len() {
            if rows[i].2 <= s.scroll + 48.0 * u { here = Some(i) }
        }
        let at = here.unwrap_or(0)
        let first = if rows.len() <= fits { 0 } else {
            min(at - min(at, fits / 3), rows.len() - fits)
        }
        // Each row as tall as its label's lines, while they fit.
        var y = top
        var n = 0
        for i in first..rows.len() {
            let lines = outline_lines(s, rows[i].0.as_str(), rows[i].3, f.rail.w).len()
            let h = row + f32(lines - 1) * OUTLINE_LINE * u
            if n > 0 && y + h > top + f32(fits) * row { break }
            out.push(
                Extra {
                    rect: Rect::new(f.rail.x, y, f.rail.w, h),
                    target: f"here:{rows[i].1.as_str()}",
                    label: rows[i].0.clone(),
                    kind: ExtraKind::Outline(here == Some(i)),
                    level: rows[i].3,
                },
            )
            y += h
            n += 1
        }
        // Under the outline, or at its place where the page has no sections.
        let my = if n == 0 { f.rail.y } else { y + 24.0 * u }
        out.push(copy_page(s, Rect::new(f.rail.x, my, f.rail.w, 34.0 * u)))
        out.push(
            Extra {
                rect: Rect::new(f.rail.x, my + 42.0 * u, f.rail.w, 34.0 * u),
                target: markdown.clone(),
                label: String::from("View as Markdown"),
                kind: ExtraKind::Markdown,
            },
        )
    }
    let foot = f.top + s.laid.height + 40.0 * u - shift(s)
    let w = min(f.w, MEASURE * u)
    let half = (w - 14.0 * u) * 0.5
    let (before, after) = neighbours(s)
    if let Some((title, path)) = before {
        out.push(
            Extra {
                rect: Rect::new(f.x, foot + 20.0 * u, half, 76.0 * u),
                target: f"nav:{path.as_str()}",
                label: title.clone(),
                kind: ExtraKind::Previous,
            },
        )
    }
    if let Some((title, path)) = after {
        out.push(
            Extra {
                rect: Rect::new(f.x + w - half, foot + 20.0 * u, half, 76.0 * u),
                target: f"nav:{path.as_str()}",
                label: title.clone(),
                kind: ExtraKind::Next,
            },
        )
    }
    if f.rail.w <= 0.0 {
        let half = (w - 10.0 * u) * 0.5
        out.push(copy_page(s, Rect::new(f.x, foot + 112.0 * u, half, 36.0 * u)))
        out.push(
            Extra {
                rect: Rect::new(f.x + w - half, foot + 112.0 * u, half, 36.0 * u),
                target: markdown,
                label: String::from("View as Markdown"),
                kind: ExtraKind::Markdown,
            },
        )
    }
    take out
}

/// The button that copies the page's Markdown, at `rect`, which says how its copy went.
fn copy_page(s: Docs, rect: Rect) -> Extra {
    Extra {
        rect,
        target: String::from("copy:page"),
        label: copy_said(s, "copy:page").unwrap_or(String::from("Copy page")),
        kind: ExtraKind::Copy,
    }
}

/// The extras: where the page is, quiet over its title; the outline under its title, with a
/// hairline down it and the section being read marked on it; under the page, a card for each
/// neighbour; and buttons for the page's Markdown.
fn draw_extras(s: mut Docs, f: Frame) {
    let ex = extras(s, f)
    if ex.is_empty() { return }
    let u = s.u
    s.list.push_clip(f.body)
    var rows_top = -1.0
    var rows_bottom = 0.0
    for e in ex {
        if let ExtraKind::Outline(_) = e.kind {
            if rows_top < 0.0 { rows_top = e.rect.y }
            rows_bottom = e.rect.bottom()
        }
    }
    if rows_top >= 0.0 {
        s.fonts.sans.weight = theme::BOLD
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            "On this page",
            13.5 * u,
            vec2(f.rail.x, f.rail.y + 4.0 * u),
            hex(s.p.strong),
        )
        s.fonts.sans.weight = 0.0
        s.list.rect(Rect::new(f.rail.x, rows_top, hair(s), rows_bottom - rows_top), hex(s.p.rule))
    }
    let mouse = !s.finger && !s.searching
    for e in ex {
        let hover = mouse && e.rect.contains(s.pointer)
        match e.kind {
            ExtraKind::Crumb => {
                let size = 13.5 * u
                let y = e.rect.y + (e.rect.h - size * 1.2) * 0.5
                let x = e.rect.x + 4.0 * u
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    "Docs",
                    size,
                    vec2(x, y),
                    hex(if hover { s.p.strong } else { s.p.quiet }),
                )
                let cx = e.rect.right() + 8.0 * u
                chevron(mut s, vec2(cx, e.rect.y + e.rect.h * 0.5), 3.0 * u, 0, hex(s.p.quiet, 0.8))
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    e.label.as_str(),
                    size,
                    vec2(cx + 10.0 * u, y),
                    hex(s.p.text),
                )
            },
            ExtraKind::Outline(here) => {
                if here {
                    s.list.rect(
                        Rect::new(e.rect.x, e.rect.y + 4.0 * u, 2.0 * u, e.rect.h - 8.0 * u),
                        hex(s.p.strong),
                        radius: u,
                    )
                }
                // A module's items are names, set in the code face; an item under its type is
                // indented under it. A section's long title takes two lines.
                let face = if is_module(s) { Face::Mono } else { Face::Sans }
                let size = (if face == Face::Mono { 12.5 } else { 13.5 }) * u
                let indent = (14.0 + (if e.level > 2 { 14.0 } else { 0.0 })) * u
                let color = if here || hover { hex(s.p.strong) } else { hex(s.p.quiet) }
                let lines = outline_lines(s, e.label.as_str(), e.level, e.rect.w)
                for k in 0..lines.len() {
                    let _ = s.list.text(
                        s.fonts,
                        face,
                        lines[k].as_str(),
                        size,
                        vec2(
                            e.rect.x + indent,
                            e.rect.y + (5.0 + f32(k) * OUTLINE_LINE + (if face == Face::Mono {
                                1.0
                            } else { 0.0 })) * u,
                        ),
                        color,
                    )
                }
            },
            ExtraKind::Previous | ExtraKind::Next => {
                let next = e.kind == ExtraKind::Next
                let r = e.rect
                if hover { s.list.rect(r.shrink(hair(s)), hex(s.p.surface, 0.7), radius: CARD * u) }
                s.list.ring(r, hex(if hover { s.p.quiet } else { s.p.rule }, if hover { 0.5 } else {
                    1.0
                }), radius: CARD * u, width: hair(s))
                let what = if next { "Next" } else { "Previous" }
                let pad = 18.0 * u
                let title = fit(s.fonts, e.label.as_str(), 15.0 * u, r.w - 2.0 * pad)
                let ww = s.fonts.font(Face::Sans).measure(what, 13.0 * u)
                let tw = s.fonts.font(Face::Sans).measure(title.as_str(), 15.0 * u)
                let wy = r.y + 16.0 * u
                if next {
                    let _ = s.list.text(
                        s.fonts,
                        Face::Sans,
                        what,
                        13.0 * u,
                        vec2(r.right() - pad - ww - 12.0 * u, wy),
                        hex(s.p.quiet),
                    )
                    chevron(
                        mut s,
                        vec2(r.right() - pad - 3.0 * u, wy + 8.0 * u),
                        3.0 * u,
                        0,
                        hex(s.p.quiet),
                    )
                } else {
                    chevron(
                        mut s,
                        vec2(r.x + pad + 3.0 * u, wy + 8.0 * u),
                        3.0 * u,
                        2,
                        hex(s.p.quiet),
                    )
                    let _ = s.list.text(
                        s.fonts,
                        Face::Sans,
                        what,
                        13.0 * u,
                        vec2(r.x + pad + 12.0 * u, wy),
                        hex(s.p.quiet),
                    )
                }
                s.fonts.sans.weight = theme::HEADING
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    title.as_str(),
                    15.0 * u,
                    vec2(if next { r.right() - pad - tw } else { r.x + pad }, r.y + 40.0 * u),
                    hex(s.p.strong),
                )
                s.fonts.sans.weight = 0.0
            },
            ExtraKind::Markdown | ExtraKind::Copy => {
                let r = e.rect
                if hover { s.list.rect(r.shrink(hair(s)), hex(s.p.surface), radius: ROUND * u) }
                s.list.ring(r, hex(s.p.rule), radius: ROUND * u, width: hair(s))
                let ix = r.x + 14.0 * u
                let cy = r.y + r.h * 0.5
                let color = hex(s.p.strong)
                if e.kind == ExtraKind::Copy {
                    if e.label.as_str() == "Copied" {
                        check(mut s, vec2(ix + 6.0 * u, cy), color)
                    } else {
                        copy_icon(mut s, vec2(ix + 6.0 * u, cy), color)
                    }
                } else {
                    // A page's corner turned down: the file as it is.
                    let k = 5.0 * u
                    s.list.ring(
                        Rect::new(ix + 1.0 * u, cy - 1.3 * k, 1.8 * k, 2.6 * k),
                        color,
                        radius: 1.5 * u,
                        width: 1.4 * u,
                    )
                    s.list.line(
                        vec2(ix + 3.5 * u, cy - 1.0 * u),
                        vec2(ix + 8.5 * u, cy - 1.0 * u),
                        color,
                        1.2 * u,
                    )
                    s.list.line(
                        vec2(ix + 3.5 * u, cy + 2.5 * u),
                        vec2(ix + 8.5 * u, cy + 2.5 * u),
                        color,
                        1.2 * u,
                    )
                }
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    e.label.as_str(),
                    13.5 * u,
                    vec2(ix + 22.0 * u, r.y + (r.h - 13.5 * u * 1.2) * 0.5),
                    color,
                )
            },
        }
    }
    s.list.pop_clip()
}

/// Two pages, one over the other: a copy, centred on `c`.
fn copy_icon(s: mut Docs, c: vec2, color: vec4) {
    let u = s.u
    let k = 8.5 * u
    s.list.ring(
        Rect::new(c.x - k * 0.5 - 2.0 * u, c.y - k * 0.5 - 2.0 * u, k, k),
        color,
        radius: 2.0 * u,
        width: 1.4 * u,
    )
    s.list.ring(
        Rect::new(c.x - k * 0.5 + 2.0 * u, c.y - k * 0.5 + 2.0 * u, k, k),
        color,
        radius: 2.0 * u,
        width: 1.4 * u,
    )
}

/// A tick, centred on `c`: done.
fn check(s: mut Docs, c: vec2, color: vec4) {
    let u = s.u
    s.list.line(c + vec2(-4.5 * u, 0.0), c + vec2(-1.5 * u, 3.0 * u), color, 1.6 * u)
    s.list.line(c + vec2(-1.5 * u, 3.0 * u), c + vec2(4.5 * u, -3.5 * u), color, 1.6 * u)
}

/// How far apart an outline row's lines are.
const OUTLINE_LINE: f32 = 19.0

/// An outline row's label as the lines it's set on in a rail `width` wide: a module's item, a
/// name in the code face, on one line, cut if it must be; a section's title on up to two.
fn outline_lines(s: Docs, label: str, level: u32, width: f32) -> Vec<String> {
    let u = s.u
    let room = width - (14.0 + (if level > 2 { 14.0 } else { 0.0 })) * u - 2.0 * u
    if is_module(s) { return Vec::from([fit_in(s.fonts, Face::Mono, label, 12.5 * u, room)]) }
    wrap(s.fonts, label, 13.5 * u, room, 2)
}

/// The extra under `at`, if there is one: its target.
fn extra_at(s: Docs, at: vec2, f: Frame) -> Option<String> {
    if at.y < f.header { return None }
    for e in extras(s, f) {
        if e.rect.contains(at) { return Some(e.target.clone()) }
    }
    None
}

/// The page's title, as the browser's tab and history show it.
fn title_of(s: Docs) -> String {
    match s.index.page(s.shown.as_str()) {
        Some(i) => f"{s.index.pages[i].title.as_str()} | Wrela docs",
        None => String::from("Wrela docs"),
    }
}

// ---- layout and drawing ------------------------------------------------------------------------

fn keep_laid_out(s: mut Docs, f: Frame) {
    if s.laid_width == f.w {
        // A place on the page being read: it glides there.
        seek(mut s, f, glide: true)
        return
    }
    if s.shown.is_empty() { s.blocks = front_blocks(s.index) }
    s.laid = lay_out(s.blocks, s.fonts, f.w, s.u, is_module(s), s.p)
    s.laid_width = f.w
    s.laid_version += 1
    s.outline = outline_of(s)
    keep_text(mut s)
    s.selected = None
    // Each figure's field, keeping its turn where the block is the same.
    var lives: Vec<Live> = Vec::new()
    for fig in s.laid.figures {
        let code = s.blocks[fig.block].code.clone()
        var turn = 0.62
        var tilt = 0.42
        var mode = SURFACE
        for l in s.lives {
            if l.block == fig.block {
                turn = l.turn
                tilt = l.tilt
                mode = l.mode
            }
        }
        s.changes += 1
        lives.push(
            Live {
                block: fig.block,
                code,
                // The layout read the block at time 0 to find its figure.
                read: Some(fig.read.clone()),
                turn,
                tilt,
                mode,
                marker: f32(mode),
                version: s.changes,
            },
        )
    }
    s.lives = take lives
    // Images of figures no longer on the page go.
    var kept: Vec<FigureImage> = Vec::new()
    while !s.images.is_empty() {
        let image = s.images.pop().unwrap()
        var shown = false
        for fig in s.laid.figures {
            if fig.block == image.block { shown = true }
        }
        if shown { kept.push(take image) }
    }
    s.images = take kept
    s.knob_held = None
    s.orbit = None
    // A place kept at another width may be past the page's end at this one.
    s.scroll = clamp(s.scroll, 0.0, max_scroll(s, f))
    // The list of pages lists the page's sections over the page.
    if !f.beside { s.nav_dirty = true }
    refresh_matches(mut s, f)
    seek(mut s, f, glide: false)
}

/// The page as plain text, as it's laid out now, for selection, copies and find.
fn keep_text(s: mut Docs) {
    let (text, starts) = s.laid.text()
    s.lowered = lower(text.as_str())
    s.text = take text
    s.starts = take starts
}

/// Scrolls to the anchor the reader asked for, once the page is laid out: gliding there on the
/// page being read, at once on a page just shown.
fn seek(s: mut Docs, f: Frame, glide: bool) {
    let Some(anchor) = s.seek else { return }
    if s.shown != s.route.page { return }
    for (a, y) in s.laid.anchors {
        if a == anchor {
            let to = clamp(y - 8.0 * s.u, 0.0, max_scroll(s, f))
            if glide { s.glide = Some(to) } else {
                s.scroll = to
                s.glide = None
            }
            break
        }
    }
    s.seek = None
}

fn mark_ems(s: Docs) -> f32 {
    14.0 * s.u / facet::CAP
}

fn mark_left(s: Docs, f: Frame) -> f32 {
    if f.beside { 24.0 * s.u } else { 60.0 * s.u }
}

/// How far down the page's content is drawn: its scroll, and past its end how far it's stretched.
fn shift(s: Docs) -> f32 {
    s.scroll - min(s.pull, 0.0)
}

/// Where the page's top is on the screen now, on a whole pixel, and a little lower while it comes
/// in: its tiles are drawn there as they were drawn into their images, pixel for pixel.
fn page_y(s: Docs, f: Frame) -> f32 {
    floor(f.top - shift(s) + 0.5) + rise(s)
}

/// How far below its place a page just shown is, as it comes in: a few pixels, rising to none.
fn rise(s: Docs) -> f32 {
    floor((1.0 - eased(s.shown_at, s.time, APPEAR, s.reduced)) * 8.0 * s.u + 0.5)
}

/// A pixel's hairline: at least a device pixel.
fn hair(s: Docs) -> f32 {
    max(1.0, s.u)
}

/// The header's buttons, each its place and what it does: the one that opens the list of pages
/// on a narrow screen (`menu`), the mark and the word beside it, which go to the front page
/// (`home`), and the repository's link where there's room (`github`).
fn header_buttons(s: Docs, f: Frame) -> Vec<(Rect, String)> {
    let u = s.u
    var out: Vec<(Rect, String)> = Vec::new()
    if !f.beside {
        out.push(
            (
                Rect::new(10.0 * u, (f.header - 40.0 * u) * 0.5, 40.0 * u, 40.0 * u),
                String::from("menu"),
            ),
        )
    }
    let x = mark_left(s, f)
    let w = MARK_WIDTH * mark_ems(s) + 12.0 * u + s.fonts.font(Face::Sans).measure("docs", 15.0 * u)
    out.push(
        (
            Rect::new(x - 8.0 * u, (f.header - 36.0 * u) * 0.5, w + 16.0 * u, 36.0 * u),
            String::from("home"),
        ),
    )
    if s.screen.x >= 640.0 * u && !s.index.repository.is_empty() {
        out.push(
            (
                Rect::new(s.screen.x - 92.0 * u, (f.header - 36.0 * u) * 0.5, 76.0 * u, 36.0 * u),
                String::from("github"),
            ),
        )
    }
    out
}

fn draw_all(s: mut Docs, f: Frame) {
    let u = s.u
    let screen = s.screen
    // Before the docs open, only the page's colour.
    let opens = opens_at(s)
    if s.time < opens {
        let blank = begin_screen_pass(clear: hex(s.p.page))
        blank.present()
        return
    }
    s.list.clear(screen)
    // The page.
    s.list.push_clip(f.body)
    // A page just shown comes in: it rises a few pixels and its ink deepens.
    let appear = eased(s.shown_at, s.time, APPEAR, s.reduced)
    let origin = vec2(f.x, page_y(s, f))
    // A card or a button under a mouse lights up: a card's edge, a button's ground.
    if !s.finger && !s.searching && s.pointer.y > f.header {
        for spot in s.laid.spots {
            if spot.kind == layout::WORDS { continue }
            let r = Rect::new(
                spot.rect.x + origin.x,
                spot.rect.y + origin.y,
                spot.rect.w,
                spot.rect.h,
            )
            if !r.contains(s.pointer) { continue }
            if spot.kind == MAIN {
                s.list.rect(r, hex(s.p.page, 0.12), radius: spot.round)
            } else {
                s.list.ring(r, hex(s.p.quiet, 0.7), radius: spot.round, width: hair(s))
            }
        }
    }
    if s.finding {
        // A match is as long as what's typed: lowercase (`lower`) keeps a text's length.
        let n = s.find.len()
        for i in 0..s.matches.len() {
            let a = s.matches[i]
            mark_range(mut s, a, a + n, origin, f, hex(0xF5C542, if i == s.current { 0.45 } else {
                0.18
            }))
        }
    }
    if let Some((a, b)) = s.selected {
        if a != b {
            mark_range(mut s, min(a, b), max(a, b), origin, f, hex(s.p.selection, 0.32))
        }
    }
    // The number under the pointer, or held, that drags.
    for i in 0..s.laid.knobs.len() {
        let held = match s.knob_held {
            Some((k, _, _, unsure)) => k == i && !unsure,
            None => false,
        }
        let r = knob_rect(s, f, i)
        if held || (s.knob_held.is_none() && !s.finger && r.contains(s.pointer)) {
            s.list.rect(r, hex(s.p.field, if held { 0.24 } else { 0.14 }), radius: 4.0 * u)
        }
    }
    if !s.trouble.is_empty() {
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            s.trouble.as_str(),
            15.0 * u,
            vec2(f.x, f.header + 24.0 * u),
            hex(s.p.quiet),
        )
    } else if s.blocks.is_empty() && !s.loading.is_empty() && s.shown != s.route.page {
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            "Opening the page…",
            15.0 * u,
            vec2(f.x, f.top),
            hex(s.p.quiet),
        )
    }
    s.list.pop_clip()
    draw_figure_overlays(mut s, f)
    draw_controls(mut s, f)
    draw_extras(mut s, f)
    draw_scrollbar(mut s, f, nav: false)
    draw_pull(mut s, f)
    draw_selection(mut s, f)
    draw_nav(mut s, f)
    draw_header(mut s, f)
    if s.finding { draw_find(mut s, f) }
    if s.searching { draw_search(mut s, f) }
    draw_toast(mut s, f)
    if s.page_load.is_some() && s.trouble.is_empty() && !s.reloading { draw_loading(mut s, f) }
    let (first, last) = keep_tiles(mut s, f)
    s.renderer.fetch(mut s.fonts, s.list)
    s.renderer.upload(s.list)
    // Figures whose image is out of date, into their images, before the screen's pass.
    draw_images(mut s, f)
    let pass = begin_screen_pass(clear: hex(s.p.page))
    for i in first..last {
        for t in s.tiles {
            if t.index != i || t.version != s.laid_version { continue }
            let top = origin.y + f32(i) * TILE
            let left = tile_left(s, f)
            let from = max(top, f.header)
            let to = min(top + TILE, screen.y)
            if to <= from { continue }
            draw(
                pass,
                quad.bind(screen: screen, rect: vec4(left, from, f32(t.w), to - from)),
                shown.bind(
                    image: t.image,
                    linear: s.linear,
                    look: Shown {
                        rect: vec4(left, top, f32(t.w), TILE),
                        round: 0.0,
                        alpha: appear,
                    },
                ),
                vertices: 6,
            )
        }
    }
    draw_figures(s, pass, f)
    s.renderer.draw(pass, screen)
    // The header's mark, over the header, as dim as what dims it.
    let dim = if s.searching { eased(s.search_at, s.time, OPEN, s.reduced) * scrim(s) } else { 0.0 }
    let ems = mark_ems(s)
    let left = mark_left(s, f)
    let mw = MARK_WIDTH * ems
    mark_field(
        s.mark,
        pass,
        screen,
        Rect::new(left - 2.0 * u, f.header * 0.5 - 14.0 * u, mw + 4.0 * u, 28.0 * u),
        Look {
            centre: vec2(left + mw * 0.5, f.header * 0.5),
            ems,
            count: MARK_RUNS.len(),
            ground: mix(hex(s.p.page), hex(VOID), dim),
            ink: mix(hex(s.p.strong), hex(VOID), dim),
        },
    )
    // The docs opening: all of it comes in together, from the page's colour.
    let opening = eased(opens, s.time, OPENING, s.reduced)
    if opening < 1.0 {
        draw(
            pass,
            quad.bind(screen: screen, rect: vec4(0.0, 0.0, screen.x, screen.y)),
            solid.bind(color: hex(s.p.page, 1.0 - opening)),
            vertices: 6,
        )
    }
    pass.present()
}

/// How far left of the page's text a tile starts, and how wide it is: room for what reaches past
/// the text's edge (code's ground in a line, a quote's bar).
fn tile_left(s: Docs, f: Frame) -> f32 {
    f.x - floor(12.0 * s.u)
}

fn tile_width(s: Docs, f: Frame) -> u32 {
    u32(ceil(f.w + 2.0 * floor(12.0 * s.u)))
}

/// The tiles the page needs on the screen now, drawn where they're out of date, and one more past
/// them in the way the page moves, so a scroll finds it drawn; tiles far from the screen go. The
/// tiles on the screen: from `first` up to `last`.
fn keep_tiles(s: mut Docs, f: Frame) -> (u32, u32) {
    if s.laid.height <= 0.0 { return (0, 0) }
    let top = page_y(s, f)
    let lo = max(f.header - top, 0.0)
    let hi = min(s.screen.y - top, s.laid.height)
    if hi <= lo { return (0, 0) }
    let first = u32(lo / TILE)
    let last = u32(hi / TILE) + 1
    let w = tile_width(s, f)
    for i in first..last { keep_tile(mut s, f, i, w, first, last) }
    // One ahead: below while the page goes down, above while it goes up.
    let up = match s.fling {
        Some((v, nav)) => !nav && v < 0.0,
        None => s.trail.len() >= 2 && s.trail[s.trail.len() - 1].0 > s.trail[0].0,
    }
    let count = u32(ceil(s.laid.height / TILE))
    if up && first > 0 { keep_tile(mut s, f, first - 1, w, first, last) } else if !up &&
        last < count {
        keep_tile(mut s, f, last, w, first, last)
    }
    (first, last)
}

/// Tile `i` drawn at this layout, `w` wide: as it is, or drawn again in an image of its own or in
/// the image of a tile far from the screen (`first` to `last`).
fn keep_tile(s: mut Docs, f: Frame, i: u32, w: u32, first: u32, last: u32) {
    var k = s.tiles.len()
    for j in 0..s.tiles.len() {
        if s.tiles[j].index == i && s.tiles[j].w == w { k = j }
    }
    if k < s.tiles.len() && s.tiles[k].version == s.laid_version && !s.tiles[k].waiting { return }
    if k == s.tiles.len() {
        // The farthest tile from the screen gives up its image, once enough are kept.
        var far = s.tiles.len()
        var distance = 0
        for j in 0..s.tiles.len() {
            let t = s.tiles[j].index
            let d = if t < first { first - t } else if t >= last { t - last + 1 } else { 0 }
            let stale = s.tiles[j].w != w
            if (stale || d > 1) &&
                (stale || d > distance) &&
                (s.tiles.len() >= TILES_KEPT || stale) {
                far = j
                distance = if stale { 1000000 } else { d }
            }
        }
        if far < s.tiles.len() && s.tiles[far].w == w {
            k = far
            s.tiles[k].index = i
        } else {
            if far < s.tiles.len() { let _ = s.tiles.remove(far) }
            s.tiles.push(
                Tile {
                    image: texture::<Rgba8>(width: w, height: u32(TILE)),
                    index: i,
                    version: 0,
                    w,
                    waiting: false,
                },
            )
            k = s.tiles.len() - 1
        }
    }
    draw_tile(mut s, f, k)
}

/// Draws tile `k`: the page's shapes and words in its rows, on the page's ground.
fn draw_tile(s: mut Docs, f: Frame, k: u32) {
    let w = s.tiles[k].w
    let top = f32(s.tiles[k].index) * TILE
    let left = f.x - tile_left(s, f)
    s.tile_list.clear(vec2(f32(w), TILE))
    for sh in s.laid.shapes {
        let r = Rect::new(sh.rect.x + left, sh.rect.y - top, sh.rect.w, sh.rect.h)
        if r.bottom() < 0.0 || r.y > TILE { continue }
        if sh.ring > 0.0 { s.tile_list.ring(r, sh.color, radius: sh.radius, width: sh.ring) } else {
            s.tile_list.rect(r, sh.color, radius: sh.radius)
        }
    }
    for p in s.laid.pieces {
        let y = p.at.y - top
        if y > TILE || y + p.size * 2.0 < 0.0 { continue }
        s.fonts.font_mut(p.face).weight = p.weight
        let _ = s.tile_list.text(
            s.fonts,
            p.face,
            p.text.as_str(),
            p.size,
            vec2(p.at.x + left, y),
            p.color,
        )
    }
    s.fonts.sans.weight = 0.0
    s.fonts.mono.weight = 0.0
    s.renderer.fetch(mut s.fonts, s.tile_list)
    // A glyph on its way from the host shows as `?` until it comes: the tile is drawn again then.
    s.tiles[k].version = s.laid_version
    s.tiles[k].waiting = !s.tile_list.wanted.is_empty()
    s.renderer.upload(s.tile_list)
    let p = begin_pass(mut s.tiles[k].image, clear: hex(s.p.page))
    s.renderer.draw(p, vec2(f32(w), TILE))
    p.end()
}

/// How much a dialog's scrim darkens what's under it, in the reader's scheme.
fn scrim(s: Docs) -> f32 {
    if s.p == LIGHT { 0.32 } else { 0.62 }
}

/// The mark over `rect` of the screen, `screen` pixels wide and high.
fn mark_field(
    runs: GpuBuffer<MarkRun>,
    pass: std::gpu::ScreenPass,
    screen: vec2,
    rect: Rect,
    look: Look,
) {
    draw(
        pass,
        quad.bind(screen: screen, rect: vec4(rect.x, rect.y, rect.w, rect.h)),
        field.bind(runs: runs, look: look),
        vertices: 6,
    )
}

/// While a page is on its way, a short bar of the mark's light runs along the header's foot; it
/// stays still when the system asks for less motion.
fn draw_loading(s: mut Docs, f: Frame) {
    let u = s.u
    let w = s.screen.x * 0.25
    let t = if s.reduced { 0.5 } else { s.time * 0.8 - floor(s.time * 0.8) }
    let x = -w + (s.screen.x + w) * t
    s.list.rect(Rect::new(x, f.header - 2.0 * u, w, 2.0 * u), hex(s.p.field))
}

/// A pull past the page's top: a disc that comes down from under the header as the finger pulls,
/// over the page, which stays still; its arc grows as it comes, is whole once it's far enough to
/// let go, and turns while the page is fetched again.
fn draw_pull(s: mut Docs, f: Frame) {
    if s.pull <= 0.5 { return }
    let u = s.u
    let k = clamp(s.pull / (PULL * u), 0.0, 1.0)
    let left = if f.beside { f.nav } else { 0.0 }
    let r = 18.0 * u
    let c = vec2((left + s.screen.x) * 0.5, f.header - r + min(s.pull, PULL * u * 1.3) * 0.9)
    let disc = Rect::new(c.x - r, c.y - r, 2.0 * r, 2.0 * r)
    for i in 1..4 {
        let g = f32(i) * 2.0 * u
        s.list.rect(
            Rect::new(disc.x - g, disc.y - g + 2.0 * u, disc.w + 2.0 * g, disc.h + 2.0 * g),
            hex(VOID, 0.05 * k),
            radius: r + g,
        )
    }
    s.list.rect(disc, hex(s.p.page, k), radius: r)
    s.list.ring(disc, hex(s.p.rule, k), radius: r, width: hair(s))
    let ready = k >= 1.0
    let color = hex(if ready || s.reloading { s.p.strong } else { s.p.quiet }, k)
    let start = if s.reloading { s.time * 6.0 } else { -1.5708 + k * 1.2 }
    let span = if s.reloading { 4.4 } else { k * 5.2 }
    let a = 8.0 * u
    let n = 24
    var last = c + vec2(cos(start), sin(start)) * a
    for i in 1..n + 1 {
        let t = start + span * f32(i) / f32(n)
        let at = c + vec2(cos(t), sin(t)) * a
        s.list.line(last, at, color, 2.0 * u)
        last = at
    }
}

/// A finger's selection: a handle under each end, and once the finger lets go, a button over it
/// that copies it.
fn draw_selection(s: mut Docs, f: Frame) {
    let u = s.u
    s.list.push_clip(f.body)
    for (c, _) in handles(s, f) {
        s.list.rect(Rect::new(c.x - u, c.y - 22.0 * u, 2.0 * u, 22.0 * u), hex(s.p.selection))
        s.list.rect(
            Rect::new(c.x - 6.0 * u, c.y, 12.0 * u, 12.0 * u),
            hex(s.p.selection),
            radius: 6.0 * u,
        )
    }
    s.list.pop_clip()
    let Some(b) = copy_button(s, f) else { return }
    shadow(mut s, b, b.h * 0.5, 1.0)
    s.list.rect(b, hex(s.p.strong), radius: b.h * 0.5)
    s.fonts.sans.weight = theme::BOLD
    let tw = s.fonts.font(Face::Sans).measure("Copy", 14.0 * u)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        "Copy",
        14.0 * u,
        vec2(b.x + (b.w - tw) * 0.5, b.y + (b.h - 14.0 * u * 1.2) * 0.5),
        hex(s.p.page),
    )
    s.fonts.sans.weight = 0.0
}

/// What a copy of a finger's selection did, for a moment, at the screen's foot.
fn draw_toast(s: mut Docs, f: Frame) {
    let Some(said) = copy_said(s, "copy:selection") else { return }
    let u = s.u
    let t = s.time - s.copied_at
    let a = if s.reduced { 1.0 } else {
        smoothstep(0.0, 0.12, t) * (1.0 - smoothstep(SAID - 0.3, SAID, t))
    }
    let tw = s.fonts.font(Face::Sans).measure(said.as_str(), 14.0 * u)
    let left = if f.beside { f.nav } else { 0.0 }
    let b = Rect::new(
        (left + s.screen.x - tw) * 0.5 - 18.0 * u,
        s.screen.y - 64.0 * u + (1.0 - a) * 8.0 * u,
        tw + 36.0 * u,
        38.0 * u,
    )
    shadow(mut s, b, b.h * 0.5, a)
    s.list.rect(b, hex(s.p.strong, a), radius: b.h * 0.5)
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        said.as_str(),
        14.0 * u,
        vec2(b.x + 18.0 * u, b.y + (b.h - 14.0 * u * 1.2) * 0.5),
        hex(s.p.page, a),
    )
}

/// A soft shadow under `r`, its corners `round`, at strength `a`.
fn shadow(s: mut Docs, r: Rect, round: f32, a: f32) {
    let u = s.u
    let strength = if s.p == LIGHT { 0.035 } else { 0.12 }
    for i in 1..5 {
        let g = f32(i) * 3.0 * u
        s.list.rect(
            Rect::new(r.x - g, r.y - g + f32(i) * 1.5 * u, r.w + 2.0 * g, r.h + 2.0 * g),
            hex(VOID, strength * a),
            radius: round + g,
        )
    }
}

/// The glows: the list's to the row under a mouse, and search's to the chosen result.
fn keep_glows(s: mut Docs, f: Frame, dt: f32) {
    let u = s.u
    let shown = f.beside || s.nav_open
    var to: Option<Rect> = None
    if shown && !s.finger && over_nav(s, s.pointer, f) && !s.searching {
        let y = s.pointer.y - f.header + s.nav_scroll
        for row in s.nav {
            if y >= row.y && y < row.y + row.h {
                to = Some(Rect::new(12.0 * u, row.y, f.nav - 24.0 * u, row.h))
            }
        }
    }
    s.nav_glow.aim(to.unwrap_or(s.nav_glow.to), to.is_some())
    s.nav_glow.step(dt, s.reduced)
    let on = s.searching && !s.hits.is_empty()
    let row = Rect::new(
        8.0 * u,
        8.0 * u + f32(s.chosen) * RESULT_ROW * u,
        0.0,
        (RESULT_ROW - 4.0) * u,
    )
    s.result_glow.aim(row, on)
    s.result_glow.step(dt, s.reduced)
}

/// A chevron at `c`, `k` wide, pointing right (`d` 0), down (1), left (2) or up (3).
fn chevron(s: mut Docs, c: vec2, k: f32, d: u32, color: vec4) {
    let w = 1.5 * s.u
    let (a, m, b) = if d == 0 {
        (vec2(-0.5, -1.0), vec2(0.5, 0.0), vec2(-0.5, 1.0))
    } else if d == 1 {
        (vec2(-1.0, -0.5), vec2(0.0, 0.5), vec2(1.0, -0.5))
    } else if d == 2 {
        (vec2(0.5, -1.0), vec2(-0.5, 0.0), vec2(0.5, 1.0))
    } else { (vec2(-1.0, 0.5), vec2(0.0, -0.5), vec2(1.0, 0.5)) }
    s.list.line(c + a * k, c + m * k, color, w)
    s.list.line(c + m * k, c + b * k, color, w)
}

/// A magnifying glass at `c`, its lens `r` wide.
fn magnifier(s: mut Docs, c: vec2, r: f32, color: vec4) {
    let w = 1.6 * s.u
    s.list.ellipse(Rect::new(c.x - r, c.y - r, 2.0 * r, 2.0 * r), color, width: w)
    s.list.line(c + vec2(r * 0.72), c + vec2(r * 1.55), color, w)
}

/// The list of pages: each group's title quiet over its pages, with its package and a chevron
/// that says whether it's open; the page being read on a chosen ground. A glow follows a mouse
/// from row to row. On a narrow screen it slides in over the page, which dims under it.
fn draw_nav(s: mut Docs, f: Frame) {
    let u = s.u
    let screen = s.screen
    let a = if f.beside { 1.0 } else {
        let t = eased(s.nav_at, s.time, OPEN, s.reduced)
        if s.nav_open { t } else { 1.0 - t }
    }
    if a <= 0.0 { return }
    let dx = -(1.0 - a) * f.nav
    let r = Rect::new(dx, f.header, f.nav, screen.y - f.header)
    if !f.beside {
        s.list.rect(f.body, hex(VOID, scrim(s) * a))
        shadow(mut s, r, 0.0, a)
    }
    s.list.rect(r, hex(s.p.page))
    s.list.rect(
        Rect::new(dx + f.nav - hair(s), f.header, hair(s), screen.y - f.header),
        hex(s.p.rule),
    )
    s.list.push_clip(r)
    // A page just shown is brought into the list's view, a third of the way down; over the page,
    // where its sections follow it, to the list's top.
    if s.nav_follow && !s.nav.is_empty() {
        s.nav_follow = false
        for row in nav_rows(s, f) {
            let out = row.y < f.header + 24.0 * u || row.y + row.h > screen.y - 40.0 * u
            if !row.path.is_empty() &&
                row.anchor.is_empty() &&
                row.path == s.shown &&
                (out || !f.beside) {
                let want = if f.beside { f.header + (screen.y - f.header) / 3.0 } else {
                    f.header + 12.0 * u
                }
                s.nav_scroll = max(s.nav_scroll + row.y - want, 0.0)
            }
        }
    }
    let top = f.header - s.nav_scroll
    if s.nav_glow.a > 0.0 {
        let g = s.nav_glow.rect
        s.list.rect(
            Rect::new(g.x + dx, g.y + top, g.w, g.h),
            hex(s.p.surface, s.nav_glow.a),
            radius: ROUND * u,
        )
    }
    let over = !s.finger && s.pointer.x < f.nav && s.pointer.y > f.header
    for row in nav_rows(s, f) {
        if row.y > screen.y || row.y + row.h < f.header { continue }
        let hover = over && s.pointer.y >= row.y && s.pointer.y < row.y + row.h
        if row.path.is_empty() {
            let (name, pkg) = group_title(row.group.as_str())
            s.fonts.sans.weight = theme::BOLD
            let size = 12.5 * u
            let ty = row.y + (row.h - size * 1.2) * 0.5
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                name.as_str(),
                size,
                vec2(dx + 24.0 * u, ty),
                hex(if hover { s.p.strong } else { s.p.quiet }),
            )
            s.fonts.sans.weight = 0.0
            if !pkg.is_empty() {
                let nw = s.fonts.font(Face::Sans).measure(name.as_str(), size)
                let _ = s.list.text(
                    s.fonts,
                    Face::Mono,
                    pkg.as_str(),
                    11.5 * u,
                    vec2(dx + 24.0 * u + nw + 8.0 * u, ty + 0.5 * u),
                    hex(s.p.quiet, 0.7),
                )
            }
            chevron(
                mut s,
                vec2(dx + f.nav - 30.0 * u, row.y + row.h * 0.5),
                3.5 * u,
                if is_open(s, row.group.as_str()) { 1 } else { 0 },
                hex(if hover { s.p.strong } else { s.p.quiet }),
            )
            continue
        }
        // A section of the page being read: indented under it, smaller, along a hairline.
        if !row.anchor.is_empty() {
            s.list.rect(Rect::new(dx + 30.0 * u, row.y, hair(s), row.h), hex(s.p.rule))
            for k in 0..row.lines.len() {
                let _ = s.list.text(
                    s.fonts,
                    Face::Sans,
                    row.lines[k].as_str(),
                    13.5 * u,
                    vec2(
                        dx + 44.0 * u,
                        row.y + (row.h - 19.0 * u * f32(row.lines.len())) * 0.5 + f32(k) * 19.0 * u,
                    ),
                    hex(if hover { s.p.strong } else { s.p.quiet }),
                )
            }
            continue
        }
        let here = row.path == s.shown
        if here {
            s.list.rect(
                Rect::new(dx + 12.0 * u, row.y, f.nav - 24.0 * u, row.h),
                hex(s.p.chosen),
                radius: ROUND * u,
            )
        }
        let color = if here || hover { hex(s.p.strong) } else { hex(s.p.text) }
        if here { s.fonts.sans.weight = theme::BOLD }
        let line = 20.0 * u
        let ty = row.y + (row.h - line * f32(row.lines.len())) * 0.5 + 1.0 * u
        for k in 0..row.lines.len() {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                row.lines[k].as_str(),
                SMALL * u,
                vec2(dx + 24.0 * u, ty + f32(k) * line),
                color,
            )
        }
        s.fonts.sans.weight = 0.0
    }
    s.list.pop_clip()
    if f.beside || s.nav_open { draw_scrollbar(mut s, f, nav: true) }
}

/// The header: the page's own ground and a hairline under it; on a narrow screen the button that
/// opens the list, the mark (drawn as a field after) and what this site is, search's button, and
/// where there's room the repository's link.
fn draw_header(s: mut Docs, f: Frame) {
    let u = s.u
    let screen = s.screen
    s.list.rect(Rect::new(x: 0.0, y: 0.0, w: screen.x, h: f.header), hex(s.p.page))
    s.list.rect(Rect::new(0.0, f.header - hair(s), screen.x, hair(s)), hex(s.p.rule))
    let over = !s.finger && s.pointer.y >= 0.0 && s.pointer.y < f.header && !s.searching
    for (r, what) in header_buttons(s, f) {
        let hover = over && r.contains(s.pointer)
        let w = what.as_str()
        if hover && w != "home" { s.list.rect(r, hex(s.p.surface), radius: ROUND * u) }
        if w == "menu" {
            let c = r.center()
            let color = hex(s.p.strong)
            if s.nav_open {
                let k = 6.0 * u
                s.list.line(c - vec2(k), c + vec2(k), color, 1.6 * u)
                s.list.line(c + vec2(k, -k), c + vec2(-k, k), color, 1.6 * u)
            } else {
                for k in 0..3 {
                    let y = c.y + (f32(k) - 1.0) * 5.5 * u
                    s.list.line(vec2(c.x - 8.0 * u, y), vec2(c.x + 8.0 * u, y), color, 1.6 * u)
                }
            }
        } else if w == "home" {
            let x = mark_left(s, f) + MARK_WIDTH * mark_ems(s) + 12.0 * u
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                "docs",
                15.0 * u,
                vec2(x, f.header * 0.5 - 9.5 * u),
                hex(if hover { s.p.strong } else { s.p.quiet }),
            )
        } else {
            let tw = s.fonts.font(Face::Sans).measure("GitHub", 14.0 * u)
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                "GitHub",
                14.0 * u,
                vec2(r.x + (r.w - tw) * 0.5, r.y + (r.h - 14.0 * u * 1.2) * 0.5),
                hex(if hover { s.p.strong } else { s.p.text }),
            )
        }
    }
    let b = f.search
    let hover = over && b.contains(s.pointer)
    if b.w > 100.0 * u {
        s.list.rect(b, hex(s.p.surface, if hover { 1.0 } else { 0.55 }), radius: ROUND * u)
        s.list.ring(b, hex(s.p.rule), radius: ROUND * u, width: hair(s))
        magnifier(mut s, vec2(b.x + 16.0 * u, b.y + b.h * 0.5 - 1.0 * u), 5.0 * u, hex(s.p.quiet))
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            "Search the docs…",
            14.0 * u,
            vec2(b.x + 32.0 * u, b.y + (b.h - 14.0 * u * 1.2) * 0.5),
            hex(s.p.quiet),
        )
        let _ = key_cap(mut s, b.right() - 30.0 * u, b.y + b.h * 0.5, "/")
    } else {
        if hover { s.list.rect(b, hex(s.p.surface), radius: ROUND * u) }
        magnifier(
            mut s,
            vec2(b.x + b.w * 0.5 - 2.0 * u, b.y + b.h * 0.5 - 2.0 * u),
            6.5 * u,
            hex(s.p.strong),
        )
    }
}

/// Search's box over the page, as a dialog: the screen dims, and the box comes in a little from
/// above. What's typed, then what it found, the chosen result on a glow that follows the choice,
/// then where there's a keyboard the keys that work.
fn draw_search(s: mut Docs, f: Frame) {
    let u = s.u
    let a = eased(s.search_at, s.time, OPEN, s.reduced)
    s.list.rect(Rect::new(x: 0.0, y: 0.0, w: s.screen.x, h: s.screen.y), hex(VOID, scrim(s) * a))
    let d = dialog_rect(s, f)
    shadow(mut s, d, 12.0 * u, a)
    s.list.rect(d, hex(s.p.page, a), radius: 12.0 * u)
    s.list.ring(d, hex(s.p.rule, a), radius: 12.0 * u, width: hair(s))
    let input = search_input(s, f)
    magnifier(
        mut s,
        vec2(input.x + 22.0 * u, input.y + input.h * 0.5 - 1.0 * u),
        6.0 * u,
        hex(s.p.quiet, a),
    )
    let text = s.query.clone()
    let box = Rect::new(input.x + 42.0 * u, input.y, input.w - 42.0 * u - (if f.beside {
        60.0
    } else { 16.0 }) * u, input.h)
    draw_typed(mut s, box, text.as_str(), "Search the docs…")
    if f.beside { let _ = key_cap(mut s, input.right() - 44.0 * u, input.y + input.h * 0.5, "Esc") }
    s.list.rect(Rect::new(d.x, input.bottom(), d.w, hair(s)), hex(s.p.rule, a))
    let panel = results_panel(s, f)
    let n = s.hits.len()
    if n == 0 {
        let hint = if s.query.is_empty() {
            "Type a name, such as Arena or smooth_union, or words from the spec."
        } else { "Nothing matches. Try a name, like Arena, or a word from the spec." }
        let shown = fit(s.fonts, hint, 14.0 * u, panel.w - 40.0 * u)
        let tw = s.fonts.font(Face::Sans).measure(shown.as_str(), 14.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            shown.as_str(),
            14.0 * u,
            vec2(panel.x + (panel.w - tw) * 0.5, panel.y + 22.0 * u),
            hex(s.p.quiet, a),
        )
    } else {
        let words = lower(s.query.as_str())
        s.list.push_clip(panel)
        if s.result_glow.a > 0.0 {
            let g = s.result_glow.rect
            s.list.rect(
                Rect::new(panel.x + g.x, panel.y + g.y, panel.w - 16.0 * u, g.h),
                hex(s.p.chosen, s.result_glow.a * a),
                radius: 8.0 * u,
            )
        }
        for i in 0..n {
            let y = panel.y + 8.0 * u + f32(i) * RESULT_ROW * u
            let h = s.hits[i]
            let x = panel.x + 20.0 * u
            let w = panel.w - 40.0 * u
            let (title, under) = result_text(s.index, h)
            let what = if h.item { s.index.items[h.at].kind.clone() } else { String::from("spec") }
            let ww = s.fonts.font(Face::Mono).measure(what.as_str(), 11.5 * u)
            let _ = s.list.text(
                s.fonts,
                Face::Mono,
                what.as_str(),
                11.5 * u,
                vec2(x + w - ww, y + 10.0 * u),
                hex(s.p.quiet, a),
            )
            let face = if h.item { Face::Mono } else { Face::Sans }
            let size = (if h.item { 13.5 } else { 14.5 }) * u
            let name = fit_in(s.fonts, face, title.as_str(), size, w - ww - 16.0 * u)
            mark_words(mut s, name.as_str(), words.as_str(), face, size, vec2(x, y + 8.0 * u))
            if !h.item { s.fonts.sans.weight = theme::BOLD }
            let _ = s.list.text(
                s.fonts,
                face,
                name.as_str(),
                size,
                vec2(x, y + 8.0 * u),
                hex(s.p.strong, a),
            )
            s.fonts.sans.weight = 0.0
            let shown = fit(s.fonts, under.as_str(), 13.0 * u, w)
            mark_words(
                mut s,
                shown.as_str(),
                words.as_str(),
                Face::Sans,
                13.0 * u,
                vec2(x, y + 29.0 * u),
            )
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                shown.as_str(),
                13.0 * u,
                vec2(x, y + 29.0 * u),
                hex(s.p.quiet, a),
            )
        }
        s.list.pop_clip()
    }
    if f.beside {
        let y = d.bottom() - KEYS * u
        s.list.rect(Rect::new(d.x, y, d.w, hair(s)), hex(s.p.rule, a))
        var x = d.x + 18.0 * u
        let mid = y + KEYS * u * 0.5
        x = key_cap(mut s, x, mid, "up") + 4.0 * u
        x = key_cap(mut s, x, mid, "down") + 8.0 * u
        x = say(mut s, x, mid, "to choose") + 18.0 * u
        x = key_cap(mut s, x, mid, "Enter") + 8.0 * u
        x = say(mut s, x, mid, "to open") + 18.0 * u
        x = key_cap(mut s, x, mid, "Esc") + 8.0 * u
        let _ = say(mut s, x, mid, "to close")
    }
}

/// Find on the page: a box under the header at its right, with how many matches it found.
fn draw_find(s: mut Docs, f: Frame) {
    let u = s.u
    let b = find_rect(s, f)
    shadow(mut s, b, 10.0 * u, 1.0)
    s.list.rect(b, hex(s.p.page), radius: 10.0 * u)
    s.list.ring(b, hex(s.p.rule), radius: 10.0 * u, width: hair(s))
    var right = b.right() - 14.0 * u
    if !s.find.is_empty() {
        let count = if s.matches.is_empty() { String::from("No matches") } else {
            f"{s.current + 1} of {s.matches.len()}"
        }
        let cw = s.fonts.font(Face::Sans).measure(count.as_str(), 13.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Sans,
            count.as_str(),
            13.0 * u,
            vec2(b.right() - cw - 14.0 * u, b.y + (b.h - 13.0 * u * 1.2) * 0.5),
            hex(s.p.quiet),
        )
        right -= cw + 12.0 * u
    }
    let text = s.find.clone()
    draw_typed(
        mut s,
        Rect::new(b.x + 14.0 * u, b.y, right - b.x - 14.0 * u, b.h),
        text.as_str(),
        "Find on this page",
    )
}

/// What's typed in a box at `b`, with its selection and its caret; slid left so the caret stays
/// in view; `empty`, quiet, where nothing is.
fn draw_typed(s: mut Docs, b: Rect, text: str, empty: str) {
    let u = s.u
    let size = TYPED * u
    let ty = b.y + (b.h - size * 1.2) * 0.5
    let room = max(b.w, 1.0)
    let caret = caret_x(s, text, s.caret)
    let shift = max(caret + 3.0 * u - room, 0.0)
    s.list.push_clip(Rect::new(b.x - 2.0 * u, b.y, room + 4.0 * u, b.h))
    if s.other_end != s.caret {
        let other = caret_x(s, text, s.other_end)
        let x0 = b.x - shift + min(caret, other)
        s.list.rect(
            Rect::new(x0, ty - 2.0 * u, abs(caret - other), size * 1.2 + 4.0 * u),
            hex(s.p.selection, 0.45),
            radius: 2.0 * u,
        )
    }
    if text.is_empty() {
        let _ = s.list.text(s.fonts, Face::Sans, empty, size, vec2(b.x, ty), hex(s.p.quiet))
    }
    let _ = s.list.text(s.fonts, Face::Sans, text, size, vec2(b.x - shift, ty), hex(s.p.strong))
    let on = s.reduced || (s.time * 2.0) - floor(s.time * 2.0) < 0.6
    if on {
        s.list.rect(
            Rect::new(b.x - shift + caret, ty - 1.0 * u, 1.5 * u, size * 1.2 + 2.0 * u),
            hex(s.p.strong),
        )
    }
    s.list.pop_clip()
}

/// How large what's typed in search's and find's boxes is.
const TYPED: f32 = 16.0

/// How far into `text`, at the boxes' size, byte `at` is.
fn caret_x(s: Docs, text: str, at: u32) -> f32 {
    s.fonts.font(Face::Sans).measure(text.slice(from: 0, to: min(at, text.len())), TYPED * s.u)
}

/// How tall a row of search's results is, and the line of keys under them.
const RESULT_ROW: f32 = 56.0
const KEYS: f32 = 44.0

/// Search's dialog: in the middle of a wide screen, a fifth of the way down; under the header on
/// a phone; as tall as what it holds, within the screen.
fn dialog_rect(s: Docs, f: Frame) -> Rect {
    let u = s.u
    let w = min(620.0 * u, s.screen.x - 20.0 * u)
    let x = (s.screen.x - w) * 0.5
    let top = if s.screen.x >= 640.0 * u { max(s.screen.y * 0.14, f.header + 24.0 * u) } else {
        f.header + 8.0 * u
    }
    let n = s.hits.len()
    let rows = if n == 0 { 64.0 * u } else { f32(n) * RESULT_ROW * u + 12.0 * u }
    let keys = if f.beside { KEYS * u } else { 0.0 }
    let a = eased(s.search_at, s.time, OPEN, s.reduced)
    let h = min(SEARCH_INPUT * u + rows + keys, s.screen.y - top - 12.0 * u)
    Rect::new(x, top - (1.0 - a) * 10.0 * u, w, h)
}

/// How tall search's box is, at the dialog's top.
const SEARCH_INPUT: f32 = 56.0

fn search_input(s: Docs, f: Frame) -> Rect {
    let d = dialog_rect(s, f)
    Rect::new(d.x, d.y, d.w, SEARCH_INPUT * s.u)
}

/// Where search's results are: under its box, over the line of keys.
fn results_panel(s: Docs, f: Frame) -> Rect {
    let d = dialog_rect(s, f)
    let top = d.y + SEARCH_INPUT * s.u + hair(s)
    let keys = if f.beside { KEYS * s.u } else { 0.0 }
    Rect::new(d.x, top, d.w, max(d.bottom() - keys - top, 0.0))
}

fn result_at(s: Docs, at: vec2, f: Frame) -> Option<u32> {
    let panel = results_panel(s, f)
    if !panel.contains(at) || at.y < panel.y + 8.0 * s.u { return None }
    let i = u32((at.y - panel.y - 8.0 * s.u) / (RESULT_ROW * s.u))
    if i < s.hits.len() { Some(i) } else { None }
}

/// Find's box: under the header, at the right of a wide screen, across a phone's.
fn find_rect(s: Docs, f: Frame) -> Rect {
    let u = s.u
    let w = min(380.0 * u, s.screen.x - 20.0 * u)
    Rect::new(s.screen.x - w - 10.0 * u, f.header + 10.0 * u, w, 44.0 * u)
}

/// A key's face from `x`, centred on `mid`: its name, or an arrow for `up` and `down`. Where it
/// ends.
fn key_cap(s: mut Docs, x: f32, mid: f32, key: str) -> f32 {
    let u = s.u
    let size = 11.5 * u
    let arrow = key == "up" || key == "down"
    let w = if arrow { 22.0 * u } else {
        max(s.fonts.font(Face::Mono).measure(key, size) + 12.0 * u, 22.0 * u)
    }
    let cap = Rect::new(x, mid - 11.0 * u, w, 22.0 * u)
    s.list.rect(cap, hex(s.p.surface), radius: 4.0 * u)
    s.list.ring(cap, hex(s.p.rule), radius: 4.0 * u, width: hair(s))
    let color = hex(s.p.quiet)
    if arrow {
        chevron(mut s, cap.center(), 3.5 * u, if key == "up" { 3 } else { 1 }, color)
    } else {
        let kw = s.fonts.font(Face::Mono).measure(key, size)
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            key,
            size,
            vec2(x + (w - kw) * 0.5, mid - size * 0.62),
            color,
        )
    }
    x + w
}

/// Words from `x`, centred on `mid`, quiet. Where they end.
fn say(s: mut Docs, x: f32, mid: f32, words: str) -> f32 {
    let size = 12.5 * s.u
    let _ = s.list.text(
        s.fonts,
        Face::Sans,
        words,
        size,
        vec2(x, mid - size * 0.62),
        hex(s.p.quiet),
    )
    x + s.fonts.font(Face::Sans).measure(words, size)
}

/// Marks bytes `a` to `b` of the page's text, piece by piece, behind the text.
fn mark_range(s: mut Docs, a: u32, b: u32, origin: vec2, f: Frame, color: vec4) {
    if a >= b || s.starts.is_empty() { return }
    var i = piece_of(s, a)
    while i < s.laid.pieces.len() && s.starts[i] < b {
        borrow p = s.laid.pieces[i]
        let start = s.starts[i]
        let end = start + p.text.len()
        if end > a {
            let from = if a > start { a - start } else { 0 }
            let to = if b < end { b - start } else { p.text.len() }
            borrow font = s.fonts.font(p.face)
            let x0 = font.caret_at(p.text.as_str(), p.size, from)
            let x1 = font.caret_at(p.text.as_str(), p.size, to)
            let y = p.at.y + origin.y
            if y < s.screen.y && y + p.size * 1.4 > f.header {
                let r = Rect::new(p.at.x + origin.x + x0, y - p.size * 0.12, x1 - x0, p.size * 1.32)
                s.list.rect(r, color, radius: 2.0 * s.u)
            }
        }
        i += 1
    }
}

/// Marks, behind `text` set at `at`, each place a word of `words` (lowercase, between spaces) is.
fn mark_words(s: mut Docs, text: str, words: str, face: Face, size: f32, at: vec2) {
    let low = lower(text)
    var a = 0
    while a < words.len() {
        var e = a
        while e < words.len() && words.byte(e) != 32 { e += 1 }
        if e > a {
            let word = words.slice(from: a, to: e)
            var from = 0
            while from < low.len() {
                let Some(k) = low.as_str().slice(from: from, to: low.len()).find(word) else {
                    break
                }
                let start = from + k
                let end = start + word.len()
                // The lowercase has the text's bytes where they're ASCII, as names and the spec's
                // words are.
                if end <= text.len() {
                    borrow font = s.fonts.font(face)
                    let x0 = font.measure(text.slice(from: 0, to: start), size)
                    let x1 = font.measure(text.slice(from: 0, to: end), size)
                    s.list.rect(
                        Rect::new(at.x + x0 - 1.0, at.y - size * 0.05, x1 - x0 + 2.0, size * 1.3),
                        hex(s.p.field, 0.22),
                        radius: 2.0 * s.u,
                    )
                }
                from = end
            }
        }
        a = e + 1
    }
}

/// A result's title, and what's under it: an item's summary, or the page a section is on. Code's
/// backticks go: the result is plain text.
fn result_text(index: Index, h: Hit) -> (String, String) {
    if h.item {
        (index.items[h.at].path.clone(), unticked(index.items[h.at].summary.as_str()))
    } else {
        let page = index.sections[h.at].page.as_str()
        let title = match index.page(page) {
            Some(p) => index.pages[p].title.clone(),
            None => page.to_string(),
        }
        // What the section says; where it is, if it says nothing first.
        let says = index.sections[h.at].summary.as_str()
        let under = if says.is_empty() { f"In {title.as_str()}" } else { unticked(says) }
        (index.sections[h.at].title.clone(), under)
    }
}

fn unticked(t: str) -> String {
    var out = String::new()
    var start = 0
    for i in 0..t.len() {
        if t.byte(i) == 96 {
            out.push_str(t.slice(from: start, to: i))
            start = i + 1
        }
    }
    out.push_str(t.slice(from: start, to: t.len()))
    take out
}

/// `text` as it fits in `width` at `size`: whole, or cut at a character with `…` after it.
fn fit(fonts: Fonts, text: str, size: f32, width: f32) -> String {
    fit_in(fonts, Face::Sans, text, size, width)
}

/// `text` in `face` as it fits in `width` at `size`.
fn fit_in(fonts: Fonts, face: Face, text: str, size: f32, width: f32) -> String {
    borrow font = fonts.font(face)
    if font.measure(text, size) <= width { return text.to_string() }
    var end = text.len()
    while end > 0 {
        end = previous_cluster(text, end)
        let cut = f"{text.slice(from: 0, to: end).trim()}…"
        if font.measure(cut.as_str(), size) <= width { return cut }
    }
    String::from("…")
}

// ---- the controls over the page ----------------------------------------------------------------

/// A control over the page: a block of code's copy button, or the link beside a section's heading
/// (`copy`, the target it follows, and what it says).
struct Control: Clone {
    rect: Rect,
    target: String,
    label: String,
    copy: bool,
}

/// The controls over the page, where they are on the screen. A section's link shows while the
/// pointer is at its heading, beside the list of pages, where the gutter has room for it; a copy
/// button shows while the pointer is on its code, or after a finger taps it, so it never hides
/// code that's being read. `all` gives every one, shown or not, for the semantic tree.
fn controls(s: Docs, f: Frame, at: vec2, all: bool) -> Vec<Control> {
    var out: Vec<Control> = Vec::new()
    if s.shown != s.route.page { return out }
    let u = s.u
    let origin = vec2(f.x, page_y(s, f))
    for i in 0..s.laid.snippets.len() {
        let r = s.laid.snippets[i].rect
        let ground = Rect::new(r.x + origin.x, r.y + origin.y, r.w, r.h)
        let target = f"copy:code:{i}"
        let said = copy_said(s, target.as_str())
        let on_screen = ground.bottom() > f.header && ground.y < s.screen.y
        // A finger's tap puts the pointer where it lands, so a tap on the code shows it too.
        if !all && !(on_screen && (said.is_some() || ground.contains(at))) { continue }
        let label = take said.unwrap_or(String::from("Copy"))
        let rect = Rect::new(ground.right() - 40.0 * u, ground.y + 8.0 * u, 32.0 * u, 32.0 * u)
        out.push(Control { rect, target, label, copy: true })
    }
    if !f.beside { return out }
    for t in s.laid.titles {
        let top = t.rect.y + origin.y
        let row = Rect::new(f.x - 36.0 * u, top, f.w + 36.0 * u, t.rect.h)
        if !all && (top < f.header || !row.contains(at)) { continue }
        out.push(
            Control {
                rect: Rect::new(f.x - 30.0 * u, top, 24.0 * u, t.line),
                target: f"here:{t.anchor.as_str()}",
                label: t.label.clone(),
                copy: false,
            },
        )
    }
    take out
}

/// The controls: a copy button on its code's ground, a tick once it's copied; and `#` in the
/// gutter beside a section's heading, stronger under the pointer.
fn draw_controls(s: mut Docs, f: Frame) {
    let u = s.u
    s.list.push_clip(f.body)
    for c in controls(s, f, s.pointer, all: false) {
        let hover = !s.finger && c.rect.contains(s.pointer)
        if c.copy {
            s.list.rect(c.rect, hex(if hover { s.p.surface } else { s.p.code }), radius: ROUND * u)
            s.list.ring(c.rect, hex(s.p.rule), radius: ROUND * u, width: hair(s))
            let color = hex(if hover { s.p.strong } else { s.p.quiet })
            if c.label.as_str() == "Copied" {
                check(mut s, c.rect.center(), hex(s.p.strong))
            } else {
                copy_icon(mut s, c.rect.center(), color)
            }
        } else {
            let size = 17.0 * u
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                "#",
                size,
                vec2(c.rect.x + 6.0 * u, c.rect.y + (c.rect.h - size * 1.35) * 0.5),
                hex(if hover { s.p.strong } else { s.p.quiet }, if hover { 1.0 } else { 0.6 }),
            )
        }
    }
    s.list.pop_clip()
}

// ---- live fields --------------------------------------------------------------------------------

/// The live figure of block `block`, if it has one.
fn live_of(s: Docs, block: u32) -> Option<u32> {
    for i in 0..s.lives.len() {
        if s.lives[i].block == block { return Some(i) }
    }
    None
}

/// Where figure `i` is on the screen.
fn figure_rect(s: Docs, f: Frame, i: u32) -> Rect {
    let r = s.laid.figures[i].rect
    Rect::new(r.x + f.x, r.y + page_y(s, f), r.w, r.h)
}

/// Where knob `i`'s number is on the screen, with room around it for a finger.
fn knob_rect(s: Docs, f: Frame, i: u32) -> Rect {
    borrow p = s.laid.pieces[s.laid.knobs[i].piece]
    let pad = 3.0 * s.u
    Rect::new(
        p.at.x + f.x - pad,
        p.at.y + page_y(s, f) - pad,
        p.w + 2.0 * pad,
        p.size * 1.35 + 2.0 * pad,
    )
}

/// How far a keyboard's step moves a number: a hundredth of it where it's 1 or more, else 0.01.
fn knob_step(v: f32) -> f32 {
    max(abs(v), 1.0) * 0.01
}

/// Knob `i`'s number, as its code says now.
fn knob_value(s: Docs, i: u32) -> f32 {
    let k = s.laid.knobs[i]
    let Some(l) = live_of(s, k.block) else { return 0.0 }
    live::number(s.lives[l].code.as_str().slice(from: k.start, to: k.end)).unwrap_or(0.0)
}

/// What knob `i` is to a screen reader: the name it's given in the code (`radius` of
/// `radius: 0.5`), or "number".
fn knob_name(s: Docs, i: u32) -> String {
    let k = s.laid.knobs[i]
    let Some(l) = live_of(s, k.block) else { return String::from("number") }
    let code = s.lives[l].code.as_str()
    var e = k.start
    while e > 0 && code.byte(e - 1) == 32 { e -= 1 }
    if e == 0 || code.byte(e - 1) != 58 { return String::from("number") }
    e -= 1
    var a = e
    while a > 0 && highlight::is_word(code.byte(a - 1)) { a -= 1 }
    if a == e { String::from("number") } else { code.slice(from: a, to: e).to_string() }
}

/// Sets knob `i`'s number to `value`: in its code, in the piece that shows it (the pieces after it
/// on its line move with its width), in the block, so the page keeps it, and in the field drawn.
fn set_knob(s: mut Docs, i: u32, value: f32) {
    let k = s.laid.knobs[i]
    let Some(l) = live_of(s, k.block) else { return }
    let (code, end) = with_number(s.lives[l].code.as_str(), k.start, k.end, value)
    let grown = i32(end) - i32(k.end)
    let piece = k.piece
    let shown = code.as_str().slice(from: k.start, to: end).to_string()
    let old_w = s.laid.pieces[piece].w
    let new_w = s.fonts
        .font(s.laid.pieces[piece].face)
        .measure(shown.as_str(), s.laid.pieces[piece].size)
    s.laid.pieces[piece].text = take shown
    s.laid.pieces[piece].w = new_w
    let y = s.laid.pieces[piece].at.y
    for j in piece + 1..s.laid.pieces.len() {
        if s.laid.pieces[j].block != k.block || abs(s.laid.pieces[j].at.y - y) > 0.5 { break }
        s.laid.pieces[j].at.x += new_w - old_w
    }
    for j in 0..s.laid.knobs.len() {
        if s.laid.knobs[j].block == k.block && s.laid.knobs[j].start > k.start {
            s.laid.knobs[j].start = u32(i32(s.laid.knobs[j].start) + grown)
            s.laid.knobs[j].end = u32(i32(s.laid.knobs[j].end) + grown)
        }
    }
    s.laid.knobs[i].end = end
    for j in 0..s.laid.snippets.len() {
        if s.laid.snippets[j].block == k.block { s.laid.snippets[j].text = code.clone() }
    }
    s.blocks[k.block].code = code.clone()
    s.laid_version += 1
    s.lives[l].read = read(code.as_str(), live_time(s))
    s.changes += 1
    s.lives[l].version = s.changes
    s.lives[l].code = take code
    keep_text(mut s)
}

/// The time a moving field is read at: the program's, or still when the system asks for less
/// motion.
fn live_time(s: Docs) -> f32 {
    if s.reduced { 0.0 } else { s.time }
}

/// Whether a figure on the screen draws a field that moves with time.
fn live_moves(s: Docs, f: Frame) -> bool {
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        if let Some(rd) = s.lives[l].read {
            if rd.moves { return true }
        }
    }
    false
}

/// Whether a figure's tab marker is still gliding to its tab.
fn markers_moving(s: Docs) -> bool {
    for l in s.lives {
        if l.marker != f32(l.mode) { return true }
    }
    false
}

/// Each figure's tab marker glides to its chosen tab; each field on the screen that moves with
/// time is read again at this frame's time.
fn keep_lives(s: mut Docs, f: Frame, dt: f32) {
    for i in 0..s.lives.len() {
        let to = f32(s.lives[i].mode)
        let m = s.lives[i].marker
        s.lives[i].marker = if s.reduced || abs(to - m) < 0.002 { to } else {
            m + (to - m) * (1.0 - exp(-dt * 22.0))
        }
    }
    if s.reduced { return }
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        let moves = match s.lives[l].read {
            Some(rd) => rd.moves,
            None => false,
        }
        if moves {
            s.lives[l].read = read(s.lives[l].code.as_str(), s.time)
            s.changes += 1
            s.lives[l].version = s.changes
        }
    }
}

/// Each figure on the screen: its field, drawn under the page's text and clipped under the
/// header, its corners round.
fn draw_figures(s: Docs, pass: std::gpu::ScreenPass, f: Frame) {
    // A page just shown comes in, its figures with its text.
    let appear = eased(s.shown_at, s.time, APPEAR, s.reduced)
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        if r.bottom() < f.header || r.y > s.screen.y { continue }
        let block = s.laid.figures[i].block
        for k in 0..s.images.len() {
            if s.images[k].block != block { continue }
            let top = max(r.y, f.header)
            let visible = vec4(r.x, top, r.w, min(r.bottom(), s.screen.y) - top)
            let look = Shown { rect: vec4(r.x, r.y, r.w, r.h), round: CARD * s.u, alpha: appear }
            let corners = quad.bind(screen: s.screen, rect: visible)
            if !s.images[k].rough_done() { continue }
            if s.images[k].sharp_done() {
                draw(
                    pass,
                    corners,
                    shown.bind(image: s.images[k].sharp, linear: s.linear, look: look),
                    vertices: 6,
                )
            } else {
                draw(
                    pass,
                    corners,
                    shown.bind(image: s.images[k].rough, linear: s.linear, look: look),
                    vertices: 6,
                )
            }
        }
    }
}

/// How finely a figure's image is drawn, in texels to the screen's pixel: the sharp image as
/// finely as the screen up to twice the CSS pixel, and finer screens (a phone's three) a little
/// softer, for less than half the work; the rough one a quarter as finely, a sixteenth of the work.
fn image_scale(u: f32, rough: bool) -> f32 {
    min(1.0, 2.0 / u) * (if rough { 0.25 } else { 1.0 })
}

/// How many of an image's `h` rows a band of it is, in `bands` bands.
fn band_rows(h: u32, bands: u32) -> u32 {
    max((h + bands - 1) / bands, 1)
}

/// Whether figure `i` is within `reach` pixels of the screen, under the header.
fn figure_near(s: Docs, f: Frame, i: u32, reach: f32) -> bool {
    let r = figure_rect(s, f, i)
    r.bottom() >= f.header - reach && r.y <= s.screen.y + reach
}

/// Whether a figure on the screen, or within a screen of it, still has its images to draw.
fn figures_drawing(s: Docs, f: Frame) -> bool {
    for i in 0..s.laid.figures.len() {
        if !figure_near(s, f, i, reach: s.screen.y) { continue }
        let block = s.laid.figures[i].block
        let Some(l) = live_of(s, block) else { continue }
        let moves = match s.lives[l].read {
            Some(rd) => rd.moves,
            None => continue,
        }
        var drawn = false
        for image in s.images {
            if image.block == block {
                drawn = image.rough_done() && (image.sharp_done() || (moves && !s.reduced))
            }
        }
        if !drawn { return true }
    }
    false
}

/// Draws figures into their images, before the screen's pass: a figure's rough image again at once
/// wherever what it shows changed (its field, camera, view, probe or scheme), and of the rest one
/// band a frame, for the figures on the screen first, then those within a screen of it.
fn draw_images(s: mut Docs, f: Frame) {
    var band = true
    for ahead in [false, true] {
        for i in 0..s.laid.figures.len() {
            if figure_near(s, f, i, reach: 0.0) == ahead ||
                !figure_near(s, f, i, reach: s.screen.y) { continue }
            band = draw_figure_images(mut s, f, i, band) && band
        }
    }
}

/// Keeps figure `i`'s images current, and draws a band of them if `band`, where they want one.
/// Returns whether the band is still to be drawn.
fn draw_figure_images(s: mut Docs, f: Frame, i: u32, band: bool) -> bool {
    let r = figure_rect(s, f, i)
    let block = s.laid.figures[i].block
    let Some(l) = live_of(s, block) else { return band }
    let Some(rd) = s.lives[l].read.clone() else { return band }
    // Held: a number of its being dragged, or the figure turned.
    let held = match s.knob_held {
        Some((k, _, _, unsure)) => !unsure && s.laid.knobs[k].block == block,
        None => false,
    } || match s.orbit {
        Some((j, _, _, _, by)) => j == i && by != FINGER_SCROLLS,
        None => false,
    }
    let mode = s.lives[l].mode
    // A slice's probe is the pointer's place on it, where the pointer is over it.
    let probe = if mode != SURFACE && r.contains(s.pointer) && s.pointer.y > f.header {
        vec4(slice_point(vec4(r.x, r.y, r.w, r.h), rd.centre, rd.radius, s.pointer), 1.0)
    } else { vec4(0.0) }
    let shows = ImageKey {
        version: s.lives[l].version,
        turn: s.lives[l].turn,
        tilt: s.lives[l].tilt,
        mode,
        probe,
        light: s.p == theme::LIGHT,
    }
    let size = |rough: bool| -> vec2u {
        let scale = image_scale(s.u, rough)
        vec2u(max(u32(r.w * scale), 1), max(u32(r.h * scale), 1))
    }
    let rough_size = size(true)
    let sharp_size = size(false)
    var k = s.images.len()
    for j in 0..s.images.len() {
        if s.images[j].block == block { k = j }
    }
    if k == s.images.len() ||
        s.images[k].rough_size != rough_size ||
        s.images[k].sharp_size != sharp_size {
        let image = FigureImage {
            block,
            rough: texture::<Rgba8>(width: rough_size.x, height: rough_size.y),
            rough_shows: shows,
            rough_size,
            sharp: texture::<Rgba8>(width: sharp_size.x, height: sharp_size.y),
            sharp_shows: shows,
            sharp_size,
            rough_rows: 0,
            rows: 0,
        }
        if k == s.images.len() { s.images.push(take image) } else { s.images[k] = take image }
    } else if s.images[k].rough_shows != shows {
        s.images[k].rough_shows = shows
        if s.images[k].rough_done() {
            draw_image(mut s, k, rd, shows, rough: true, from: 0, to: rough_size.y)
        } else { s.images[k].rough_rows = 0 }
    }
    // The sharp image starts over for what the rough one shows, and goes on while the figure is
    // let be, and doesn't move with time.
    if s.images[k].sharp_shows != shows {
        s.images[k].sharp_shows = shows
        s.images[k].rows = 0
    }
    if !band { return false }
    let rough_rows = s.images[k].rough_rows
    if rough_rows < rough_size.y {
        let to = min(rough_rows + band_rows(rough_size.y, ROUGH_BANDS), rough_size.y)
        draw_image(mut s, k, rd, shows, rough: true, from: rough_rows, to: to)
        s.images[k].rough_rows = to
        return false
    }
    let rows = s.images[k].rows
    if held || (rd.moves && !s.reduced) || rows >= sharp_size.y { return true }
    let to = min(rows + band_rows(sharp_size.y, BANDS), sharp_size.y)
    draw_image(mut s, k, rd, shows, rough: false, from: rows, to: to)
    s.images[k].rows = to
    false
}

/// Draws rows `from` to `to` of figure image `k`'s rough or sharp image, of `rd`'s field as
/// `shows` says, keeping the rows drawn before.
fn draw_image(s: mut Docs, k: u32, rd: Read, shows: ImageKey, rough: bool, from: u32, to: u32) {
    let light = shows.light
    let size = if rough { s.images[k].rough_size } else { s.images[k].sharp_size }
    let look = View {
        rect: vec4(0.0, 0.0, f32(size.x), f32(size.y)),
        turn: shows.turn,
        tilt: shows.tilt,
        centre: rd.centre,
        radius: rd.radius,
        floor: rd.floor,
        u: s.u * image_scale(s.u, rough),
        light: if light { 1.0 } else { 0.0 },
        ground: hex(s.p.code),
        line: hex(s.p.field, if light { 0.45 } else { 0.38 }),
        body: hex(s.p.figure),
        rim: hex(s.p.field),
        mode: shows.mode,
        probe: shows.probe,
    }
    let band = vec4(0.0, f32(from), f32(size.x), f32(to - from))
    let corners = quad.bind(screen: vec2(f32(size.x), f32(size.y)), rect: band)
    let p = if rough { begin_pass(mut s.images[k].rough, keep: from > 0) } else {
        begin_pass(mut s.images[k].sharp, keep: from > 0)
    }
    // Each view is a pipeline of its own.
    if shows.mode == SURFACE {
        draw(p, corners, view.bind(scene: rd.scene, look: look), vertices: 6)
    } else { draw(p, corners, slice_view.bind(scene: rd.scene, look: look), vertices: 6) }
    p.end()
}

/// Figure `i`'s tabs, in the row over it: each its place, its view and its name.
fn figure_tabs(s: Docs, f: Frame, i: u32) -> Vec<(Rect, u32, String)> {
    var out: Vec<(Rect, u32, String)> = Vec::new()
    let row = tabs_rect(s, f, i)
    if row.bottom() < f.header || row.y > s.screen.y { return out }
    let u = s.u
    let w = (row.w - 6.0 * u) * 0.5
    for (k, mode, name) in [(0, SURFACE, "Shape"), (1, DISTANCE, "Distance")] {
        out.push(
            (
                Rect::new(row.x + 3.0 * u + f32(k) * w, row.y + 3.0 * u, w, row.h - 6.0 * u),
                mode,
                name.to_string(),
            ),
        )
    }
    out
}

/// Where figure `i`'s list of tabs is on the screen: at the left of the row over it.
fn tabs_rect(s: Docs, f: Frame, i: u32) -> Rect {
    let t = s.laid.figures[i].tabs
    let u = s.u
    Rect::new(t.x + f.x, t.y + page_y(s, f), min(220.0 * u, t.w), t.h)
}

/// What a reader does with view `mode`, said at the right of the row over its figure: by a
/// finger's words where the last press was a finger's.
fn hint(mode: u32, finger: bool) -> String {
    String::from(if mode == DISTANCE {
        if finger { "Touch to measure" } else { "Point to measure" }
    } else { "Drag to turn" })
}

/// Over each figure: its tabs, on a ground with a marker that glides to the chosen one; what to
/// do with it, at the row's right; what its view shows, under it; and on a slice, at the
/// pointer, the distance there.
fn draw_figure_overlays(s: mut Docs, f: Frame) {
    let u = s.u
    s.list.push_clip(f.body)
    for i in 0..s.laid.figures.len() {
        let r = figure_rect(s, f, i)
        let row = tabs_rect(s, f, i)
        let cap = s.laid.figures[i].caption
        if row.y > s.screen.y || r.bottom() + cap.h + 20.0 * u < f.header { continue }
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        // Its edge, over its image.
        s.list.ring(r, hex(s.p.rule), radius: CARD * u, width: hair(s))
        let mode = s.lives[l].mode
        let marker = s.lives[l].marker
        s.list.rect(row, hex(s.p.surface), radius: 8.0 * u)
        let tabs = figure_tabs(s, f, i)
        if tabs.len() == 2 {
            let t0 = tabs[0].0
            let m = Rect::new(t0.x + marker * t0.w, t0.y, t0.w, t0.h)
            if s.p == LIGHT { shadow(mut s, m, 6.0 * u, 0.6) }
            s.list.rect(m, hex(if s.p == LIGHT { s.p.page } else { s.p.chosen }), radius: 6.0 * u)
            if s.p != LIGHT { s.list.ring(m, hex(s.p.rule), radius: 6.0 * u, width: hair(s)) }
        }
        let size = 13.5 * u
        for (t, m, name) in tabs {
            let here = m == mode
            let hover = !s.finger && t.contains(s.pointer)
            s.fonts.sans.weight = theme::BOLD
            let tw = s.fonts.font(Face::Sans).measure(name.as_str(), size)
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                name.as_str(),
                size,
                vec2(t.x + (t.w - tw) * 0.5, t.y + (t.h - size * 1.2) * 0.5),
                hex(if here || hover { s.p.strong } else { s.p.quiet }),
            )
            s.fonts.sans.weight = 0.0
        }
        let said = hint(mode, s.finger)
        let row_end = f.x + s.laid.figures[i].tabs.w
        let hw = s.fonts.font(Face::Sans).measure(said.as_str(), 13.0 * u)
        if row_end - hw > row.right() + 12.0 * u {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                said.as_str(),
                13.0 * u,
                vec2(row_end - hw, row.y + (row.h - 13.0 * u * 1.2) * 0.5),
                hex(s.p.quiet),
            )
        }
        // What the view shows, under it.
        let lines = wrap(s.fonts, live::caption(mode).as_str(), 13.5 * u, cap.w, 6)
        for k in 0..lines.len() {
            let _ = s.list.text(
                s.fonts,
                Face::Sans,
                lines[k].as_str(),
                13.5 * u,
                vec2(cap.x + f.x, cap.y + page_y(s, f) + f32(k) * 13.5 * u * 1.55),
                hex(s.p.quiet),
            )
        }
        if mode == SURFACE || !r.contains(s.pointer) { continue }
        let Some(rd) = s.lives[l].read else { continue }
        let q = slice_point(vec4(r.x, r.y, r.w, r.h), rd.centre, rd.radius, s.pointer)
        let said = f"distance {live::evaluate(rd.scene, q):.3}"
        let w = s.fonts.font(Face::Mono).measure(said.as_str(), 12.0 * u) + 18.0 * u
        let at = vec2(
            clamp(s.pointer.x + 14.0 * u, r.x + 6.0 * u, r.right() - w - 6.0 * u),
            max(s.pointer.y - (if s.finger { 64.0 } else { 38.0 }) * u, r.y + 6.0 * u),
        )
        let tag = Rect::new(at.x, at.y, w, 26.0 * u)
        shadow(mut s, tag, 13.0 * u, 0.7)
        s.list.rect(tag, hex(s.p.strong), radius: 13.0 * u)
        let _ = s.list.text(
            s.fonts,
            Face::Mono,
            said.as_str(),
            12.0 * u,
            vec2(tag.x + 9.0 * u, tag.y + (tag.h - 12.0 * u * 1.3) * 0.5),
            hex(s.p.page),
        )
    }
    s.list.pop_clip()
}

// ---- scrollbars --------------------------------------------------------------------------------

/// How far the page, or the list of pages (`nav`), scrolls: 0 where it fits on the screen.
fn scroll_room(s: Docs, f: Frame, nav: bool) -> f32 {
    if nav { max(nav_end(s) - (s.screen.y - f.header), 0.0) } else { max_scroll(s, f) }
}

fn set_scroll(s: mut Docs, f: Frame, nav: bool, y: f32) {
    let to = clamp(y, 0.0, scroll_room(s, f, nav))
    if nav { s.nav_scroll = to } else {
        s.scroll = to
        s.glide = None
    }
}

/// The page's scrollbar, or the list's (`nav`), where what it scrolls is longer than the screen:
/// its track, down the right of the page or of the list under the header, and its thumb, as long
/// as the share of it on the screen, where that share is.
fn scrollbar(s: Docs, f: Frame, nav: bool) -> Option<(Rect, Rect)> {
    // The list's where the list shows; the page's unless the list is open over it.
    let shown = if nav { f.beside || s.nav_open } else { f.beside || !s.nav_open }
    if !shown { return None }
    let room = scroll_room(s, f, nav)
    if room <= 0.0 { return None }
    let u = s.u
    let w = 12.0 * u
    let x = if nav { f.nav - w - max(1.0, u) } else { s.screen.x - w }
    let track = Rect::new(x, f.header, w, s.screen.y - f.header)
    Some((track, thumb(track, if nav { s.nav_scroll } else { s.scroll }, room, 40.0 * u)))
}

/// A scrollbar's thumb in `track`, for what's scrolled `at` of the `room` it scrolls: as long as
/// the share of it on the screen (the track's length), at least `least`, as far down as the
/// scroll is.
fn thumb(track: Rect, at: f32, room: f32, least: f32) -> Rect {
    let h = min(max(track.h * track.h / (track.h + room), least), track.h)
    let y = track.y + (track.h - h) * clamp(at / max(room, 0.001), 0.0, 1.0)
    Rect::new(track.x, y, track.w, h)
}

/// A scrollbar's thumb: thin at its track's edge, wider and stronger under the pointer or held.
fn draw_scrollbar(s: mut Docs, f: Frame, nav: bool) {
    let Some((track, thumb)) = scrollbar(s, f, nav) else { return }
    let u = s.u
    let held = match s.thumb {
        Some((_, _, n)) => n == nav,
        None => false,
    }
    let near = held || track.contains(s.pointer)
    let w = (if near { 7.0 } else { 4.0 }) * u
    s.list.rect(
        Rect::new(track.right() - w - 3.0 * u, thumb.y + 3.0 * u, w, thumb.h - 6.0 * u),
        hex(s.p.quiet, if near { 0.55 } else { 0.22 }),
        radius: w * 0.5,
    )
}

// ---- what the host is told ---------------------------------------------------------------------

fn tell(s: mut Docs, f: Frame, changed: bool) {
    // What's under the pointer, the box being typed in and what's selected change only with input
    // or motion, which change the frame.
    if changed { tell_input(mut s, f) }
    // The tree is told what changed, and only then; a change held back while the page moved is
    // told once it stops.
    if s.capabilities & host::SEMANTICS == 0 || !(changed || s.owed) { return }
    // While a finger moves the page, or it carries on, glides or springs back, its parts' places
    // aren't told at all: the host moves an element for each, on the thread a phone's touches
    // arrive on, and a finger's press goes to this program whatever element it lands on. They're
    // told once the page is still. A mouse's wheel tells them ten times a second, as a mouse
    // clicks the elements themselves.
    let moved = s.scroll != s.told_at.0 || s.nav_scroll != s.told_at.1 || s.pull != 0.0
    let touched = s.fling.is_some() || s.swipe.is_some() || s.pull != 0.0 || s.handle != 0
    if moved && (touched || (s.glide.is_some() && s.time - s.told_at.2 < 0.1)) {
        s.owed = true
        return
    }
    s.owed = false
    s.told_at = (s.scroll, s.nav_scroll, s.time)
    let nodes = parts_tree(s, f)
    let view = vec4(0.0, 0.0, s.screen.x, s.screen.y)
    let title = title_of(s)
    host::publish(mut s.told, mut s.tree, title.as_str(), nodes, view)
}

/// Tells the host the pointer's shape over what's under it, whether search's or find's box takes
/// typing, and what a copy takes.
fn tell_input(s: mut Docs, f: Frame) {
    var over_control = false
    for c in controls(s, f, s.pointer, all: false) {
        if c.rect.contains(s.pointer) { over_control = true }
    }
    var over_knob = s.knob_held.is_some()
    for i in 0..s.laid.knobs.len() {
        if knob_rect(s, f, i).contains(s.pointer) { over_knob = true }
    }
    // Over a figure: a hand that turns it, or over a slice the probe's crosshair.
    var over_figure = ""
    for i in 0..s.laid.figures.len() {
        if figure_rect(s, f, i).contains(s.pointer) && s.pointer.y > f.header {
            let flat = match live_of(s, s.laid.figures[i].block) {
                Some(l) => s.lives[l].mode != SURFACE,
                None => false,
            }
            over_figure = if flat { "crosshair" } else { "grab" }
        }
    }
    var over_header = f.search.contains(s.pointer)
    for (r, _) in header_buttons(s, f) {
        if r.contains(s.pointer) { over_header = true }
    }
    for i in 0..s.laid.figures.len() {
        for (t, _, _) in figure_tabs(s, f, i) {
            if t.contains(s.pointer) { over_header = true }
        }
    }
    let over_link = link_at(s, s.pointer, f).is_some() ||
        extra_at(s, s.pointer, f).is_some() ||
        over_control ||
        (over_nav(s, s.pointer, f) && nav_at(s, s.pointer, f).is_some())
    let want = if s.searching {
        if result_at(s, s.pointer, f).is_some() { "pointer" } else if search_input(s, f)
            .contains(s.pointer) {
            "text"
        } else { "default" }
    } else if over_knob { "ew-resize" } else if s.orbit.is_some() && over_figure != "crosshair" {
        "grabbing"
    } else if over_link || over_header { "pointer" } else if !over_figure.is_empty() {
        over_figure
    } else if s.pointer.y > f.header && place(s, s.pointer, f).is_some() && over_text(s, f) {
        "text"
    } else { "default" }
    if s.cursor.as_str() != want {
        s.cursor = want.to_string()
        s.told.push(host::cursor(want))
    }
    // While search is open, its box is a text field: an input method composes there, and a
    // screen reader hears what's typed.
    let typing = s.searching || s.finding
    if typing != s.texting &&
        s.capabilities & host::TEXT_INPUT != 0 &&
        s.capabilities & host::SEMANTICS == 0 {
        let b = if s.finding { find_rect(s, f) } else { search_input(s, f) }
        s.told.push(
            host::text_input(
                typing,
                vec4(b.x + 14.0 * s.u, b.y + 8.0 * s.u, 1.0, b.h - 16.0 * s.u),
            ),
        )
        s.texting = typing
    }
    // A copy takes what's selected; the host has it before the keys that copy arrive.
    let words = selected_words(s)
    if words != s.offered && s.capabilities & host::PASTE_EVENTS != 0 {
        s.told.push(host::offer(words.as_str(), ""))
        s.offered = take words
    }
}

/// The page's parts as a semantic tree, in reading order, whether or not they're on screen (a
/// node's number is its part's plus 1, and a link has its address); then search's and find's
/// boxes, as fields, search's results, as a list's options, the page's extras and the list of
/// pages.
fn parts_tree(s: Docs, f: Frame) -> Vec<Node> {
    var nodes: Vec<Node> = Vec::new()
    for i in 0..s.laid.parts.len() {
        borrow p = s.laid.parts[i]
        let rect = vec4(p.rect.x + f.x, p.rect.y + page_y(s, f), p.rect.w, p.rect.h)
        // The page's parts are under the header, which is drawn over them.
        let shown = semantics::clip(rect, page_view(s, f))
        let role = match p.role {
            Role::Heading => semantics::Role::Heading,
            Role::Text => semantics::Role::Text,
            Role::Link => semantics::Role::Link,
            Role::Code => semantics::Role::Code,
        }
        let href = if p.role == Role::Link { href_of(s, p.target.as_str()) } else { String::new() }
        nodes.push(
            Node { id: i + 1, role, level: p.level, rect: shown, label: p.label.clone(), href },
        )
    }
    let input = search_input(s, f)
    let b = if s.searching { vec4(input.x, input.y, input.w, input.h) } else {
        vec4(f.search.x, f.search.y, f.search.w, f.search.h)
    }
    let found = find_rect(s, f)
    nodes.push(
        Node {
            id: SEARCH_FIELD,
            role: semantics::Role::Field,
            label: String::from("Search the docs"),
            rect: if s.finding { vec4(0.0) } else { b },
            focused: s.searching,
            field: Some(box_field(s.search_box, s.query.as_str(), s.caret, s.other_end)),
        },
    )
    if s.finding {
        nodes.push(
            Node {
                id: FIND_FIELD,
                role: semantics::Role::Field,
                label: String::from("Find on this page"),
                rect: vec4(found.x, found.y, found.w, found.h),
                focused: true,
                field: Some(box_field(s.find_box, s.find.as_str(), s.caret, s.other_end)),
            },
        )
    }
    if s.searching && !s.query.is_empty() {
        let row = RESULT_ROW * s.u
        let panel = results_panel(s, f)
        let x = panel.x
        let top = panel.y + 8.0 * s.u
        nodes.push(
            Node {
                id: RESULT_LIST,
                role: semantics::Role::ListBox,
                label: String::from("Search results"),
            },
        )
        for i in 0..s.hits.len() {
            let (title, under) = result_text(s.index, s.hits[i])
            nodes.push(
                Node {
                    id: RESULT_NODES + i,
                    parent: RESULT_LIST,
                    role: semantics::Role::Option,
                    selected: i == s.chosen,
                    rect: semantics::clip(
                        vec4(x, top + f32(i) * row, panel.w, row),
                        vec4(panel.x, panel.y, panel.w, panel.h),
                    ),
                    label: f"{title.as_str()}: {under.as_str()}",
                },
            )
        }
    }
    // The page's neighbours and its Markdown, and its outline as a group of links.
    let page = page_view(s, f)
    let ex = extras(s, f)
    var outlined = false
    for i in 0..ex.len() {
        borrow e = ex[i]
        let rect = semantics::clip(vec4(e.rect.x, e.rect.y, e.rect.w, e.rect.h), page)
        let href = href_of(s, e.target.as_str())
        let (parent, label) = match e.kind {
            ExtraKind::Outline(_) => (OUTLINE, e.label.clone()),
            ExtraKind::Previous => (0, f"Previous page: {e.label.as_str()}"),
            ExtraKind::Next => (0, f"Next page: {e.label.as_str()}"),
            ExtraKind::Markdown | ExtraKind::Copy => (0, e.label.clone()),
            ExtraKind::Crumb => (0, String::from("Docs")),
        }
        if parent == OUTLINE && !outlined {
            nodes.push(
                Node {
                    id: OUTLINE,
                    role: semantics::Role::Group,
                    label: String::from("On this page"),
                },
            )
            outlined = true
        }
        let role = if e.kind == ExtraKind::Copy { semantics::Role::Button } else {
            semantics::Role::Link
        }
        let href = if e.kind == ExtraKind::Copy { String::new() } else { take href }
        nodes.push(Node { id: EXTRA_NODES + i, parent, role, label, href, rect })
    }
    // The controls over the page: copy buttons, and each section's link.
    let all = controls(s, f, s.pointer, all: true)
    for i in 0..all.len() {
        borrow c = all[i]
        let rect = semantics::clip(vec4(c.rect.x, c.rect.y, c.rect.w, c.rect.h), page)
        nodes.push(
            if c.copy {
                Node {
                    id: CONTROL_NODES + i,
                    role: semantics::Role::Button,
                    label: if c.label.as_str() == "Copy" { String::from("Copy code") } else {
                        c.label.clone()
                    },
                    rect,
                }
            } else {
                Node {
                    id: CONTROL_NODES + i,
                    role: semantics::Role::Link,
                    label: f"Link to {c.label.as_str()}",
                    href: href_of(s, c.target.as_str()),
                    rect,
                }
            },
        )
    }
    // Each figure's views, as tabs.
    for i in 0..s.laid.figures.len() {
        let Some(l) = live_of(s, s.laid.figures[i].block) else { continue }
        let r = figure_rect(s, f, i)
        nodes.push(
            Node {
                id: TAB_LISTS + i,
                role: semantics::Role::TabList,
                label: String::from("What the figure shows"),
                rect: semantics::clip(vec4(r.x, r.y, r.w, r.h), page),
            },
        )
        let tabs = figure_tabs(s, f, i)
        for k in 0..2 {
            let (mode, name) = if k < tabs.len() { (tabs[k].1, tabs[k].2.clone()) } else {
                (k, String::from(["Shape", "Distance"][k]))
            }
            let rect = if k < tabs.len() {
                semantics::clip(vec4(tabs[k].0.x, tabs[k].0.y, tabs[k].0.w, tabs[k].0.h), page)
            } else { vec4(0.0) }
            nodes.push(
                Node {
                    id: TABS + i * 2 + k,
                    parent: TAB_LISTS + i,
                    role: semantics::Role::Tab,
                    label: name,
                    selected: s.lives[l].mode == mode,
                    rect,
                },
            )
        }
    }
    // A live field's numbers, as sliders a keyboard steps.
    for i in 0..s.laid.knobs.len() {
        let r = knob_rect(s, f, i)
        let v = knob_value(s, i)
        nodes.push(
            Node {
                id: KNOB_NODES + i,
                role: semantics::Role::Slider,
                label: knob_name(s, i),
                rect: semantics::clip(vec4(r.x, r.y, r.w, r.h), page),
                value: v,
                min: if v >= 0.0 { 0.0 } else { -100.0 },
                max: 100.0,
                step: knob_step(v),
            },
        )
    }
    // The header's buttons, and the button that copies what a finger selected.
    let buttons = header_buttons(s, f)
    for i in 0..buttons.len() {
        let (r, what) = buttons[i].clone()
        let label = if what.as_str() == "menu" { "Pages" } else if what.as_str() == "home" {
            "Wrela docs: the front page"
        } else { "Wrela on GitHub" }
        let href = if what.as_str() == "github" { s.index.repository.clone() } else if what
            .as_str() ==
            "home" {
            href_of(s, "home:")
        } else { String::new() }
        nodes.push(
            Node {
                id: HEADER_NODES + i,
                role: if href.is_empty() { semantics::Role::Button } else { semantics::Role::Link },
                label: String::from(label),
                href,
                expanded: what.as_str() == "menu" && s.nav_open,
                rect: vec4(r.x, r.y, r.w, r.h),
            },
        )
    }
    if let Some(b) = copy_button(s, f) {
        nodes.push(
            Node {
                id: COPY_SELECTION,
                role: semantics::Role::Button,
                label: String::from("Copy the selection"),
                rect: vec4(b.x, b.y, b.w, b.h),
            },
        )
    }
    // The list of pages: a group of each group's pages under a button that opens or closes it,
    // where the list is shown. A closed group's pages, and the list where it's closed, are still
    // in the tree, for the keyboard.
    nodes.push(Node { id: NAV_LIST, role: semantics::Role::Group, label: String::from("Pages") })
    let shown = f.beside || s.nav_open
    let list = vec4(0.0, f.header, f.nav, s.screen.y - f.header)
    let rows = nav_rows(s, f)
    let all = groups_in(s.index)
    for k in 0..all.len() {
        let g = all[k].as_str()
        let (name, _) = group_title(g)
        // Where the row for `path` (the group's title, for no path) is, within the list; empty
        // where the row isn't laid out, as a closed group's pages and a list not shown aren't.
        let rect_of = |path: str| -> vec4 {
            if !shown { return vec4(0.0) }
            for row in rows {
                if row.group.as_str() == g && row.path.as_str() == path {
                    return semantics::clip(vec4(0.0, row.y, f.nav, row.h), list)
                }
            }
            vec4(0.0)
        }
        nodes.push(
            Node {
                id: NAV_GROUPS + k,
                parent: NAV_LIST,
                role: semantics::Role::Group,
                label: name.clone(),
            },
        )
        nodes.push(
            Node {
                id: NAV_BUTTONS + k,
                parent: NAV_GROUPS + k,
                role: semantics::Role::Button,
                label: name,
                expanded: is_open(s, g),
                rect: rect_of(""),
            },
        )
        for i in 0..s.index.pages.len() {
            borrow p = s.index.pages[i]
            if group_of(p.path.as_str(), p.kind.as_str()) != g { continue }
            let label = nav_label(p.path.as_str(), p.kind.as_str(), p.title.as_str())
            let href = Route { page: p.path.clone(), anchor: String::new() }.fragment()
            nodes.push(
                Node {
                    id: NAV_NODES + i,
                    parent: NAV_GROUPS + k,
                    role: semantics::Role::Link,
                    label,
                    href,
                    rect: rect_of(p.path.as_str()),
                },
            )
        }
    }
    take nodes
}

/// A box as the host's field: its text and selection, set when a replacement is asked for.
fn box_field(k: Kept, text: str, caret: u32, other: u32) -> Field {
    Field {
        kind: FieldKind::Search,
        text: text.to_string(),
        start: min(min(caret, other), text.len()),
        end: min(max(caret, other), text.len()),
        replace: k.replace,
        seen: k.seen,
    }
}

/// The part of the screen the page is seen in: under the header, and right of the list of pages
/// where it's open over the page, so the page's links aren't under a finger that taps the list.
fn page_view(s: Docs, f: Frame) -> vec4 {
    let left = if !f.beside && s.nav_open { f.nav } else { 0.0 }
    vec4(left, f.header, s.screen.x - left, s.screen.y - f.header)
}

/// Where link `target` goes, as an address the browser can open in a new tab: a page of these
/// docs by its fragment, a source file on the repository, or the address itself.
fn href_of(s: Docs, target: str) -> String {
    if target.starts_with("source:") {
        let at = target.slice(from: 7, to: target.len())
        let k = at.find(":").unwrap_or(at.len())
        let line = at.slice(from: min(k + 1, at.len()), to: at.len())
        return s.index.source_url(at.slice(from: 0, to: k), line)
    }
    if target.starts_with("nav:") {
        let page = target.slice(from: 4, to: target.len()).to_string()
        return Route { page, anchor: String::new() }.fragment()
    }
    if target.starts_with("here:") {
        let anchor = target.slice(from: 5, to: target.len()).to_string()
        return Route { page: s.shown.clone(), anchor }.fragment()
    }
    if target.starts_with("file:") { return target.slice(from: 5, to: target.len()).to_string() }
    if target == "home:" {
        return match s.base {
            Some(b) => b.clone(),
            None => String::from("#"),
        }
    }
    if target == "search:" { return String::new() }
    match follow(s.shown.as_str(), target) {
        // The front page has no fragment.
        Some(Target::Docs(route)) => if route.page.is_empty() { String::from("#") } else {
            route.fragment()
        },
        Some(Target::File(path)) => path,
        Some(Target::Out(url)) => url,
        None => String::new(),
    }
}

/// `/` opens search, which types what follows but not the `/`; Backspace takes a character back.
/// Command-F opens find in its place, which takes the typing then; Enter there doesn't leave it.
@test(frames: 12, input: scripts::KEYS)
fn search_and_find_take_the_typing(docs: Docs) {
    assert(!docs.searching, "find took search's place")
    assert(docs.query.as_str() == "aren", docs.query.as_str())
    assert(docs.finding && docs.find.as_str() == "a", docs.find.as_str())
    // No index here: the program says so rather than failing.
    assert(!docs.trouble.is_empty())
}

@test
fn an_address_without_a_fragment_is_the_front_page_and_groups_rank_the_language_first() {
    assert(rank("spec/lexical.md", "spec") < rank("std/io.md", "module"))
    assert(rank("std/io.md", "module") < rank("engine/floor.md", "module"))
    let shown = fit(
        Fonts::from_baked(SANS, MONO),
        "How Wrela differs from Rust and TypeScript",
        size: 14.0,
        width: 120.0,
    )
    assert(shown.as_str().ends_with("…") && shown.len() < 42, shown.as_str())
    // A module is listed by its file's name, a spec section by its title.
    for (path, kind, title, want) in [
        ("std/arena.md", "module", "std::arena", "arena"),
        ("engine/grow.md", "module", "engine::grow", "grow"),
        ("std/builtins.md", "module", "Built-in functions", "builtins"),
        ("spec/language/6-memory.md", "spec", "6. Memory", "6. Memory"),
    ] {
        let got = nav_label(path, kind, title)
        assert(got.as_str() == want, got.as_str())
    }
    assert(last_name("Arena::insert") == "insert" && last_name("fetch") == "fetch")
    let plain = unticked("Adds `value` at `the` end.")
    assert(plain.as_str() == "Adds value at the end.", plain.as_str())
}

@test
fn a_long_label_wraps_to_two_lines_and_a_longer_one_is_cut() {
    let fonts = Fonts::from_baked(SANS, MONO)
    let two = wrap(
        fonts,
        "How Wrela differs from Rust and TypeScript",
        size: 14.0,
        width: 200.0,
        most: 2,
    )
    assert(two.len() == 2 && !two[1].as_str().ends_with("…"), two[0].as_str())
    let joined = f"{two[0].as_str()} {two[1].as_str()}"
    assert(joined.as_str() == "How Wrela differs from Rust and TypeScript", joined.as_str())
    let cut = wrap(
        fonts,
        "How Wrela differs from Rust and TypeScript",
        size: 14.0,
        width: 90.0,
        most: 2,
    )
    assert(cut.len() == 2 && cut[1].as_str().ends_with("…"), cut[1].as_str())
    for line in cut {
        assert(fonts.font(Face::Sans).measure(line.as_str(), 14.0) <= 90.0, line.as_str())
    }
    assert(wrap(fonts, "arena", size: 14.0, width: 200.0, most: 2).len() == 1)
}

@test
fn the_front_page_lists_each_group_and_the_engine_by_topic() {
    var index = Index::empty()
    for (path, title, kind) in [
        ("spec/language/6-memory.md", "6. Memory", "spec"),
        ("std/builtins.md", "Built-in functions", "module"),
        ("engine/air.md", "engine::air", "module"),
        ("engine/piano.md", "engine::piano", "module"),
        ("engine/lit.md", "engine::lit", "module"),
        ("engine/novel.md", "engine::novel", "module"),
    ] {
        index.pages.push(
            index::Page {
                path: path.to_string(),
                title: title.to_string(),
                summary: String::from("What it does."),
                kind: kind.to_string(),
            },
        )
    }
    let md = front(index)
    let page = md.as_str()
    // Where `t` first is in the page, or its end.
    let at = |t: str| -> u32 { page.find(t).unwrap_or(page.len()) }
    assert(
        at("## The language") < at("- [6. Memory](spec/language/6-memory.md)"),
    )
    assert(
        at("## Standard library: `std`") < at("- [builtins](std/builtins.md)"),
    )
    // The engine's modules under their topics, in the topics' order; one no topic names, last.
    assert(
        at("### Rendering and light") < at("- [air]") && at("- [air]") < at("- [lit]"),
    )
    assert(
        at("- [lit]") < at("### Sound and music") && at("### Sound and music") < at("- [piano]"),
    )
    assert(
        at("### More") < at("- [novel]") && at("- [piano]") < at("### More"),
    )
    assert(engine_topic("piano_grand") == 5 && engine_topic("novel") == TOPICS)
}

@test
fn typing_replaces_what_is_selected_and_backspace_takes_it() {
    var q = String::from("arena insert")
    var caret: u32 = 12
    var other: u32 = 0
    put_typed(mut q, mut caret, mut other, "grazer")
    assert(q.as_str() == "grazer" && caret == 6 && other == 6, q.as_str())
    caret = 3
    other = 3
    put_typed(mut q, mut caret, mut other, "Z")
    assert(q.as_str() == "graZzer" && caret == 4, q.as_str())
    other = 1
    erase(mut q, mut caret, mut other, all: false)
    assert(q.as_str() == "gzer" && caret == 1 && other == 1, q.as_str())
    erase(mut q, mut caret, mut other, all: false)
    assert(q.as_str() == "zer" && caret == 0, q.as_str())
    erase(mut q, mut caret, mut other, all: true)
    assert(q.is_empty() && caret == 0)
}

/// Back and Forward return to the place the reader left an address; a link opens its page at the
/// top, or at its anchor, wherever the reader last was on it.
@test
fn back_returns_to_where_the_reader_was() {
    var places: Vec<(String, f32)> = Vec::new()
    remember(mut places, String::from("#std/io"), 300.0)
    remember(mut places, String::from("#std/arena"), 50.0)
    remember(mut places, String::from("#std/io"), 320.0)
    assert(places.len() == 2 && places[1].1 == 320.0, "a place is kept once, newest last")
    let io = Route::of("/#std/io")
    assert(arrival(io, push: false, places: places) == (None, Some(320.0)))
    assert(arrival(io, push: true, places: places) == (None, None))
    let anchored = Route::of("/#std/io:fetch")
    assert(arrival(anchored, push: true, places: places) == (Some(String::from("fetch")), None))
    assert(arrival(anchored, push: false, places: places) == (Some(String::from("fetch")), None))
    assert(arrival(Route::front(), push: false, places: places) == (None, None))
    for i in 0..PLACES + 5 { remember(mut places, f"#p{i}", 1.0) }
    assert(places.len() == PLACES && arrival(io, push: false, places: places) == (None, None))
}

/// A scrollbar's thumb is as long as the share of the page on the screen, at the top at first and
/// at the foot at the end, and never shorter than a finger's width or longer than its track.
@test
fn a_scrollbars_thumb_is_the_share_on_screen_where_it_is() {
    let track = Rect::new(x: 1388.0, y: 64.0, w: 12.0, h: 836.0)
    let top = thumb(track, 0.0, room: 836.0, least: 40.0)
    assert(top.y == 64.0 && top.h == 418.0 && top.x == track.x, f"{top.y} {top.h}")
    let end = thumb(track, 836.0, room: 836.0, least: 40.0)
    assert(end.bottom() == track.bottom(), f"{end.bottom()}")
    let long = thumb(track, 0.0, room: 1000000.0, least: 40.0)
    assert(long.h == 40.0)
    assert(thumb(track, 5.0, room: 0.0, least: 40.0).h == track.h)
}

/// A copy button says how its copy went for a moment, then is a copy button again.
@test
fn a_copy_says_how_it_went_for_a_moment() {
    assert(
        said("copy:code:2", 10.0, ok: true, now: 10.5, what: "copy:code:2") ==
            Some(String::from("Copied")),
    )
    assert(said("copy:code:2", 10.0, ok: true, now: 10.5, what: "copy:code:1").is_none())
    assert(
        said("copy:page", 10.0, ok: false, now: 11.0, what: "copy:page") ==
            Some(String::from("Couldn't copy")),
    )
    assert(said("copy:page", 10.0, ok: true, now: 10.0 + SAID + 0.1, what: "copy:page").is_none())
    // A copy on its way says nothing yet.
    assert(said("copy:page", -10.0, ok: false, now: 3.0, what: "copy:page").is_none())
    assert(parse_u32("17") == 17 && parse_u32("1x") == 0 && parse_u32("") == 0)
}

/// A glide covers most of the way in a tenth of a second and ends there, with no overshoot; it is
/// there at once when the system asks for less motion.
@test
fn a_glide_eases_to_its_place_and_stops_there() {
    var at = 0.0
    var frames = 0
    while at != 1000.0 && frames < 120 {
        let next = glided(at, 1000.0, dt: 1.0 / 60.0, still: false)
        assert(next > at && next <= 1000.0, f"{next}")
        at = next
        frames += 1
    }
    assert(at == 1000.0 && frames > 6 && frames < 40, f"{frames} frames")
    assert(glided(at: 0.0, to: 1000.0, dt: 0.1, still: false) > 800.0)
    assert(glided(at: 0.0, to: 1000.0, dt: 1.0 / 60.0, still: true) == 1000.0)
    assert(glided(at: 500.0, to: 0.0, dt: 1.0 / 60.0, still: false) < 500.0)
}

/// A page that couldn't be opened says so, and lists what search finds for its last name, each a
/// link that leads from where it is to the page found.
@test
fn a_missing_page_lists_what_may_be_it() {
    let doc = "{\"pages\": [{\"path\": \"std/arena.md\", \"title\": \"std::arena\", \"summary\": \"Arenas.\", \"kind\": \"module\"}], \"items\": [{\"path\": \"std::arena::Arena\", \"kind\": \"struct\", \"summary\": \"Values with handles.\", \"page\": \"std/arena.md\", \"anchor\": \"arena\", \"source\": \"compiler/std/arena.wrela\", \"line\": 12}], \"sections\": [{\"page\": \"spec/language/6-memory.md\", \"anchor\": \"6-8-handles-and-arenas\", \"headings\": [\"6. Memory\", \"6.8 Handles and arenas\"], \"text\": \"An arena holds values.\"}]}"
    let Ok(index) = Index::read(Vec::from(String::from(doc).as_bytes())) else {
        assert(false, "the index")
        return
    }
    let md = missing(index, "std/old/arena.md", "HTTP 404")
    let page = md.as_str()
    assert(
        page.starts_with(
            "# No page here\n\n`std/old/arena` couldn't be opened (HTTP 404).\n\nA page",
        ),
        page,
    )
    assert(
        page
            .find("- [std::arena::Arena](../../std/arena.md#arena): Values with handles.")
            .is_some(),
        page,
    )
    let link = follow("std/old/arena.md", "../../std/arena.md#arena")
    assert(
        link ==
            Some(
                Target::Docs(
                    Route { page: String::from("std/arena.md"), anchor: String::from("arena") },
                ),
            ),
    )
    // A page of the spec that moved finds the spec's sections first.
    let spec = missing(index, "spec/old/arena.md", "HTTP 404")
    let section = spec.as_str().find("(../../spec/language/6-memory.md#6-8-handles-and-arenas)")
    let item = spec.as_str().find("(../../std/arena.md#arena)")
    assert(section.is_some() && item.is_some() && section < item, spec.as_str())
    // A name of several words that finds nothing finds its longest word.
    let words = missing(index, "std/an-arena-of-ours.md", "HTTP 404")
    assert(
        words.as_str().find("- [std::arena::Arena](../std/arena.md#arena)").is_some(),
        words.as_str(),
    )
    // Nothing found: no list, only search.
    let none = missing(index, "spec/zzz.md", "HTTP 404")
    assert(
        none
            .as_str()
            .ends_with(
                "couldn't be opened (HTTP 404).\n\nPress `/` and search for what you're looking for.\n",
            ),
        none.as_str(),
    )
}

/// A swipe's speed is its finger's over its last tenth of a second: none if the finger rested
/// before letting go.
@test
fn a_swipe_carries_on_at_its_fingers_last_speed() {
    // Up 30 pixels a frame for a tenth of a second: the page scrolls down 1800 pixels a second.
    var trail: Vec<(f32, f32)> = Vec::new()
    for i in 0..8 { trail.push((600.0 - 30.0 * f32(i), 1.0 + f32(i) / 60.0)) }
    let v = swipe_speed(trail, now: 1.0 + 7.0 / 60.0)
    assert(abs(v - 1800.0) < 1.0, f"{v}")
    // Rested a fifth of a second: no fling.
    assert(swipe_speed(trail, now: 1.0 + 7.0 / 60.0 + 0.2) == 0.0)
    assert(swipe_speed(Vec::from([(1.0, 2.0)]), now: 2.0) == 0.0)
}

@test(frames: 6, input: scripts::RELEASE)
fn a_pointer_release_updates_the_drag_before_ending_it(docs: Docs) {
    assert(docs.pointer == vec2(630.0, 300.0))
    assert(docs.slop == 100.0, f"{docs.slop}")
    assert(docs.thumb.is_none())
}

/// A finger's drag doesn't jump the way it came before it counted as a drag, nor make it up: the
/// page starts from where it was and stays that far from the finger, moving with it.
@test(frames: 40, input: scripts::DRAG)
fn a_drag_keeps_its_distance_from_its_finger(docs: Docs) {
    // The finger crossed the slop 20 pixels up, and went 20 more.
    assert(docs.slop == -20.0, f"{docs.slop}")
}

/// A page loaded again in place, by a pull, stays as it was; another page appears.
@test
fn a_refreshed_page_stays_and_another_appears() {
    assert(!appears(reloading: true, shown: "std/io", path: "std/io"))
    assert(appears(reloading: true, shown: "std/io", path: "std/arena"))
    assert(appears(reloading: false, shown: "std/io", path: "std/io"))
}

/// A figure's sharp image is as fine as the screen up to twice the CSS pixel, softer on a phone's
/// three; its rough one a quarter as fine. Each is drawn in bands, which cover it, whatever its
/// height.
@test
fn a_figures_image_is_sharp_in_bands_and_rough_at_once() {
    assert(image_scale(1.0, rough: false) == 1.0 && image_scale(2.0, rough: false) == 1.0)
    assert(abs(image_scale(3.0, rough: false) - 2.0 / 3.0) < 0.0001)
    assert(abs(image_scale(3.0, rough: true) - 1.0 / 6.0) < 0.0001)
    for bands in [ROUGH_BANDS, BANDS] {
        for h in [1, 7, 8, 9, 63, 64, 65, 646, 1000] {
            let rows = band_rows(h, bands)
            assert(rows * bands >= h && (rows - 1) * bands < h, f"{h} in {bands}: {rows}")
        }
    }
}
