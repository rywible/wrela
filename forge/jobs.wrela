// Checks of trees, run by a worker (spec/forge.md). A worker is a checkout (the `work` root) and
// the machine it's on: for each job, it makes the checkout hold the job's tree, writing only the
// files that differ from what it holds (so its build output stays warm), runs `tools/check.sh`
// with the job's check, and keeps the output as a blob and what it said as evidence. One job runs
// at a time on a worker; the oldest queued job runs next.

use blake3::Id
use codec::{Dec, Enc}
use core::Durable
use object::{File, Files}
use platform::service as host
use service::{For, Service, commit, load, wait}
use state::{Event, Run}
use std::io::{IoError, print}

pub const WORK: Text = "work"

/// The most output a check keeps, from each of stdout and stderr.
const OUTPUT: u32 = 16777216
/// How long a check may run: three hours.
const LIMIT_MS: u64 = 10800000

pub struct Worker: Clone {
    pub name: String,
    /// What its checkout holds, once its manifest has been read.
    pub held: Files,
    pub known: bool,
    /// The job it runs; 0 when it's idle.
    pub job: u64,
    /// What the job's tree holds.
    pub target: Files,
    /// The checkout's writes and removals not answered yet.
    pub left: u32,
    pub failed: String,
    /// When its checkout last held what `held` says (milliseconds since 1970), and the files a
    /// check changed since, found on disk before the next checkout.
    pub held_at: u64,
    pub changed: SortedMap<String, bool>,
}

pub fn worker(name: str) -> Worker {
    Worker {
        name: name.to_string(),
        held: SortedMap::new(),
        known: false,
        job: 0,
        target: SortedMap::new(),
        left: 0,
        failed: String::new(),
        held_at: 0,
        changed: SortedMap::new(),
    }
}

pub fn manifest_path(name: str) -> String {
    f"data/workers/{name}"
}

/// What a checkout holds, as its manifest's bytes.
pub fn manifest(files: Files) -> Vec<u8> {
    var e = Enc::new()
    e.u8(1)
    e.num(u64(files.len()))
    let keys = files.keys()
    let values = files.values()
    for i in 0..keys.len() {
        e.str(keys[i].as_str())
        e.bool(values[i].exec)
        e.id(values[i].id)
        e.num(values[i].size)
    }
    take e.bytes
}

pub fn manifest_of(b: take Vec<u8>) -> Option<Files> {
    var d = Dec::new(take b)
    if d.u8().ok() != Some(1) {
        return None
    }
    let n = d.small().ok()?
    var out: Files = SortedMap::new()
    for _ in 0..n {
        let path = d.string().ok()?
        let exec = d.bool().ok()?
        let id = d.id().ok()?
        let size = d.num().ok()?
        let _ = out.insert(take path, File { id, exec, size })
    }
    Some(out)
}

/// A worker's manifest (`workers/<name>`): the byte 2, when its checkout held its files, then
/// the files (`manifest`'s bytes) as a run.
pub fn worker_manifest(files: Files, at: u64) -> Vec<u8> {
    var e = Enc::new()
    e.u8(2)
    e.num(at)
    e.run(manifest(files))
    take e.bytes
}

/// A worker's manifest's files and time; one of the first version holds no time, so each of its
/// files is checked as one a check may have changed.
pub fn worker_manifest_of(b: take Vec<u8>) -> Option<(Files, u64)> {
    if b.is_empty() || b[0] != 2 {
        let files = manifest_of(take b)?
        return Some((files, 0))
    }
    var d = Dec::new(take b)
    let _ = d.u8().ok()?
    let at = d.num().ok()?
    let files = manifest_of(d.run().ok()?)?
    d.end().ok()?
    Some((files, at))
}

/// Whether a file on disk (`st`) is as the checkout last wrote it (`f`, by `at`): its kind and size
/// the same, and changed no later. A check that changed it is caught here.
pub fn as_written(st: host::Stat, f: File, at: u64) -> bool {
    let kind = if f.exec { host::Kind::Program } else { host::Kind::File }
    st.kind == kind && st.size == f.size && st.modified < at
}

pub fn manifest_read(s: mut Service, r: take Result<Vec<u8>, IoError>) {
    match take r {
        Ok(b) => match worker_manifest_of(take b) {
            Some((files, at)) => {
                s.worker.held = take files
                s.worker.held_at = at
            },
            None => print(
                "forge: the worker's manifest is malformed: its checkout is written whole",
            ),
        },
        // A worker with no manifest has an empty checkout, as far as forge knows.
        Err(_) => {},
    }
    s.worker.known = true
    service::started_one(mut s, "the worker's manifest", Ok(Vec::new()))
}

pub fn manifest_saved(s: mut Service, r: take Result<Vec<u8>, IoError>) {
    if let Err(e) = r {
        print(f"forge: the worker's manifest wasn't saved: {e.message()}")
    }
}

/// The files tree `tree` holds, read from the trees in memory; or the trees and blobs to load.
pub fn tree_files(c: core::Core, tree: Id) -> Result<Files, Vec<Id>> {
    var out: Files = SortedMap::new()
    var need: Vec<Id> = Vec::new()
    var dirs: Vec<(String, Id)> = Vec::from([(String::new(), tree)])
    while let Some((prefix, id)) = dirs.pop() {
        let Some(b) = c.blobs.get(id) else {
            need.push(id)
            continue
        }
        let Ok(entries) = object::entries(b) else {
            need.push(id)
            continue
        }
        for e in entries {
            let path = if prefix.is_empty() { e.name.clone() } else { f"{prefix}/{e.name}" }
            match e.kind {
                object::Kind::Dir => dirs.push((take path, e.id)),
                kind => {
                    if !c.blobs.contains(e.id) {
                        need.push(e.id)
                    }
                    let _ = out.insert(
                        take path,
                        File { id: e.id, exec: kind == object::Kind::Exec, size: e.size },
                    )
                },
            }
        }
    }
    if need.is_empty() { Ok(out) } else { Err(need) }
}

/// The jobs running on worker `name`.
pub fn running_on(s: Service, name: str) -> Vec<u64> {
    var out: Vec<u64> = Vec::new()
    for j in s.core.state.jobs.values() {
        if j.run == Run::Running && j.worker.as_str() == name {
            out.push(j.id)
        }
    }
    out
}

/// Sends back to the queue the jobs that ran 10 minutes past their limit (F23a): their worker is
/// gone, or lost them.
pub fn expire(s: mut Service) {
    let now = service::now(s)
    var events: Vec<Event> = Vec::new()
    for j in s.core.state.jobs.values() {
        if j.run == Run::Running && j.started + LIMIT_MS + 600000 < now {
            events.push(
                Event::Requeued {
                    job: j.id,
                    why: f"it ran past its limit on {j.worker}",
                    time: now,
                },
            )
        }
    }
    if !events.is_empty() {
        commit(mut s, Durable { objects: Vec::new(), events }, None)
    }
}

/// The oldest queued job.
fn next_job(s: Service) -> Option<state::Job> {
    for j in s.core.state.jobs.values() {
        if j.run == Run::Queued {
            return Some(j.clone())
        }
    }
    None
}

/// Starts the next job, if the worker is idle and one waits.
pub fn pump(s: mut Service) {
    if s.worker.job != 0 || !s.worker.known {
        return
    }
    let Some(job) = next_job(s) else { return }
    let files = match tree_files(s.core, job.tree) {
        Ok(f) => take f,
        Err(need) => {
            for id in need {
                let _ = load(mut s, id)
            }
            return
        },
    }
    let ev = Event::Started { job: job.id, worker: s.worker.name.clone(), time: service::now(s) }
    commit(mut s, Durable { objects: Vec::new(), events: Vec::from([take ev]) }, None)
    s.worker.job = job.id
    s.worker.failed = String::new()
    checkout(mut s, take files)
}

/// Makes the checkout hold `target`: first each file it would keep is looked at on disk (a check
/// may have changed it), then what differs is written, flushed, and what it no longer holds goes.
fn checkout(s: mut Service, target: take Files) {
    s.worker.changed = SortedMap::new()
    var left = 0
    let keys = target.keys()
    let values = target.values()
    for i in 0..keys.len() {
        if s.worker.held.get(keys[i].clone()) == Some(values[i]) {
            wait(mut s, host::stat(f"{WORK}/{keys[i]}".as_str()), For::Looked(keys[i].clone()))
            left += 1
        }
    }
    s.worker.target = take target
    s.worker.left = left
    if left == 0 {
        write_checkout(mut s)
    }
}

/// A file the checkout would keep, as it is on disk.
pub fn looked(s: mut Service, path: take String, r: take Result<Vec<u8>, IoError>) {
    let fine = match take r {
        Ok(b) => match host::stat_of(take b) {
            Some(st) => match s.worker.target.get(path.clone()) {
                Some(f) => as_written(st, f, s.worker.held_at),
                None => false,
            },
            None => false,
        },
        Err(_) => false,
    }
    if !fine {
        let _ = s.worker.changed.insert(take path, value: true)
    }
    s.worker.left -= 1
    if s.worker.left == 0 {
        write_checkout(mut s)
    }
}

fn write_checkout(s: mut Service) {
    if !s.worker.changed.is_empty() {
        print(
            f"forge: {s.worker.changed.len()} files of the checkout changed since it was written; writing them again",
        )
    }
    let target = s.worker.target.clone()
    var dirs: SortedMap<String, bool> = SortedMap::new()
    var writes: Vec<(String, File)> = Vec::new()
    let keys = target.keys()
    let values = target.values()
    for i in 0..keys.len() {
        let held = s.worker.held.get(keys[i].clone())
        if held != Some(values[i]) || s.worker.changed.contains(keys[i].clone()) {
            writes.push((keys[i].clone(), values[i]))
            let p = keys[i].as_str()
            var last = p.len()
            var k = 0
            while k < p.len() {
                if p.byte(k) == 47 {
                    last = k
                }
                k += 1
            }
            if last < p.len() {
                let _ = dirs.insert(p.slice(from: 0, to: last).to_string(), value: true)
            }
        }
    }
    var left = 0
    for d in dirs.keys() {
        wait(mut s, host::mkdir(f"{WORK}/{d}".as_str()), For::Checkout)
        left += 1
    }
    for (path, f) in writes {
        let Some(content) = s.core.blobs.get(f.id) else {
            s.worker.failed = f"the blob of {path} isn't in memory"
            continue
        }
        // Flushed, so a manifest saved after it never names a file a crash lost.
        let at = f"{WORK}/{path}"
        left += service::write_exec_file(mut s, at.as_str(), content, f.exec, For::Checkout)
    }
    var gone: Vec<String> = Vec::new()
    for p in s.worker.held.keys() {
        if !target.contains(p.clone()) {
            gone.push(p.clone())
        }
    }
    for p in gone {
        wait(mut s, host::remove(f"{WORK}/{p}".as_str(), all: false), For::Checkout)
        left += 1
    }
    s.worker.left = left
    if left == 0 {
        run(mut s)
    }
}

pub fn checkout_done(s: mut Service, r: take Result<Vec<u8>, IoError>) {
    if let Err(e) = r {
        if s.worker.failed.is_empty() {
            s.worker.failed = f"the checkout: {e.message()}"
        }
    }
    s.worker.left -= 1
    if s.worker.left == 0 {
        run(mut s)
    }
}

/// Runs the job, once the checkout holds its tree. The manifest names the tree only if the
/// checkout made it; after a failure, the next checkout writes every file again.
fn run(s: mut Service) {
    // The host's clock, not the call's: files are told apart from the checkout's own by it.
    wait(mut s, host::now(), For::Clock)
}

/// The time the checkout was made: its manifest is saved, and the check runs.
pub fn clocked(s: mut Service, r: take Result<Vec<u8>, IoError>) {
    let now = match take r {
        Ok(b) => host::millis_of(take b).unwrap_or(0),
        Err(_) => 0,
    }
    let job = s.worker.job
    if s.worker.failed.is_empty() && now > 0 {
        s.worker.held = s.worker.target.clone()
        s.worker.held_at = now
    } else {
        s.worker.held = SortedMap::new()
        s.worker.held_at = 0
    }
    let m = worker_manifest(s.worker.held, s.worker.held_at)
    wait(mut s, host::write(manifest_path(s.worker.name.as_str()).as_str(), m), For::ManifestSaved)
    if !s.worker.failed.is_empty() {
        let why = s.worker.failed.clone()
        return finish(
            mut s,
            job,
            -1,
            timed_out: false,
            ms: 0,
            output: bytes::of_str(f"forge couldn't make the checkout: {why}\n".as_str()),
        )
    }
    let check = s.core.state.jobs.at(job).check.clone()
    let argv = command(check.as_str())
    let r = host::Run {
        tag: job,
        argv,
        cwd: WORK.to_string(),
        env: Vec::from([(String::from("FORGE_JOB"), f"j{job}")]),
        limit_ms: LIMIT_MS,
        cap: OUTPUT,
        stdin: Vec::new(),
    }
    wait(mut s, host::run(r), For::Ran(job))
}

/// What a worker runs for check `check`: `tools/check.sh` with its name (none for `suite`), or for
/// `index:<package>`, the revision's own `tools/wrela index --json <package>`.
pub fn command(check: str) -> Vec<String> {
    if check.starts_with("index:") {
        return Vec::from(
            [
                String::from("tools/wrela"),
                String::from("index"),
                String::from("--json"),
                check.slice(from: 6, to: check.len()).to_string(),
            ],
        )
    }
    var argv: Vec<String> = Vec::from([String::from("tools/check.sh")])
    if check != "suite" {
        argv.push(check.to_string())
    }
    argv
}

pub fn ran(s: mut Service, job: u64, r: take Result<Vec<u8>, IoError>) {
    match take r {
        Ok(b) => match host::ran_of(take b) {
            Some(x) => {
                var out: Vec<u8> = Vec::new()
                bytes::push_run(mut out, x.stdout)
                if !x.stderr.is_empty() {
                    bytes::push_str(mut out, "\n---- stderr ----\n")
                    bytes::push_run(mut out, x.stderr)
                }
                if x.truncated {
                    bytes::push_str(mut out, "\n(output past 16 MiB was dropped)\n")
                }
                finish(mut s, job, x.status, x.timed_out, x.ms, take out)
            },
            None => finish(
                mut s,
                job,
                -1,
                timed_out: false,
                ms: 0,
                output: bytes::of_str("forge couldn't read the check's answer\n"),
            ),
        },
        Err(e) => finish(
            mut s,
            job,
            -1,
            timed_out: false,
            ms: 0,
            output: bytes::of_str(f"the check didn't run: {e.message()}\n".as_str()),
        ),
    }
}

/// Keeps what job `job` said: its output, its evidence, and that it finished.
fn finish(s: mut Service, job: u64, status: i32, timed_out: bool, ms: u64, output: take Vec<u8>) {
    s.worker.job = 0
    let j = s.core.state.jobs.at(job).clone()
    if j.run != Run::Running || j.worker.as_str() != s.worker.name.as_str() {
        // It went back to the queue while it ran: this try's word doesn't count (F23a).
        return print(f"forge: j{job} ended after it went back to the queue; its result is dropped")
    }
    let log = object::blob(output)
    let x = object::evidence(
        object::Evidence {
            check: j.check.clone(),
            tree: j.tree,
            machine: s.worker.name.clone(),
            status,
            timed_out,
            ms,
            log: log.id,
            time: service::now(s),
        },
    )
    let passed = status == 0 && !timed_out
    print(f"forge: j{job} ({j.check}) {if passed { "passed" } else { "failed" }} in {ms / 1000} s")
    let ev = Event::Finished { job, evidence: x.id, passed, time: service::now(s) }
    commit(
        mut s,
        Durable { objects: Vec::from([take log, take x]), events: Vec::from([take ev]) },
        None,
    )
}

fn json_reply(s: mut Service, conn: u32, status: u32, json: str) {
    service::reply(mut s, conn, status, "application/json", bytes::of_str(json))
}

/// A worker's call from another machine: `next` gives it the oldest queued check, with the files
/// of its tree; `done` keeps what the check said.
pub fn remote(s: mut Service, conn: u32, req: take http::Request) {
    let Ok(doc) = std::json::Json::read(req.body) else {
        return json_reply(mut s, conn, 400, "{\"error\":\"the body isn't JSON\"}")
    }
    let worker = doc.field(doc.root, "worker").to_string()
    if worker.is_empty() {
        return json_reply(mut s, conn, 400, "{\"error\":\"give the worker's name\"}")
    }
    // A worker on another machine is named for its node (`NODE`, or `NODE/...` for one of
    // several), so its evidence says truly where the check ran.
    let ctx = service::ctx_of(s, conn)
    let w = worker.as_str()
    if !service::names_its_own(ctx.clone(), w) {
        return json_reply(
            mut s,
            conn,
            403,
            f"{{\"error\":\"a worker on {ctx.node} is named {ctx.node} or {ctx.node}/...\"}}".as_str(),
        )
    }
    if req.path.as_str() == "/api/work/next" {
        // A worker that asks for work runs nothing: what it ran before it started again goes
        // back to the queue.
        let lost = running_on(s, w)
        if !lost.is_empty() {
            var events: Vec<Event> = Vec::new()
            for id in lost {
                events.push(
                    Event::Requeued {
                        job: id,
                        why: f"{w} asked for work again",
                        time: service::now(s),
                    },
                )
            }
            commit(mut s, Durable { objects: Vec::new(), events }, None)
        }
        let Some(job) = next_job(s) else {
            return service::reply(mut s, conn, 204, "application/json", [])
        }
        let files = match tree_files(s.core, job.tree) {
            Ok(f) => take f,
            Err(need) => {
                for id in need {
                    let _ = load(mut s, id)
                }
                return json_reply(
                    mut s,
                    conn,
                    503,
                    "{\"error\":\"the tree is loading: ask again\"}",
                )
            },
        }
        var j = out::Json::new()
        j.obj()
        j.knum("job", job.id)
        j.knum("attempt", u64(job.attempt))
        j.kstr("check", job.check.as_str())
        j.kstr("tree", job.tree.hex().as_str())
        j.key("files")
        j.arr()
        let keys = files.keys()
        let values = files.values()
        for i in 0..keys.len() {
            j.arr()
            j.str(keys[i].as_str())
            j.str(values[i].id.hex().as_str())
            j.num(if values[i].exec { 1 } else { 0 })
            j.num(values[i].size)
            j.end_arr()
        }
        j.end_arr()
        j.end_obj()
        let ev = Event::Started { job: job.id, worker: worker.clone(), time: service::now(s) }
        let reply = service::Reply {
            conn,
            status: 200,
            kind: "application/json",
            body: bytes::of_str(j.text.as_str()),
        }
        return commit(
            mut s,
            Durable { objects: Vec::new(), events: Vec::from([take ev]) },
            Some(take reply),
        )
    }
    if req.path.as_str() == "/api/work/done" {
        let job = doc.whole64(doc.get(doc.root, "job").unwrap_or(doc.root)).unwrap_or(0)
        if !s.core.state.jobs.contains(job) {
            return json_reply(mut s, conn, 404, "{\"error\":\"no such job\"}")
        }
        let j = s.core.state.jobs.at(job).clone()
        let attempt = doc.whole64(doc.get(doc.root, "attempt").unwrap_or(doc.root)).unwrap_or(0)
        if j.run != Run::Running ||
            j.worker.as_str() != worker.as_str() ||
            attempt != u64(j.attempt) {
            return json_reply(
                mut s,
                conn,
                409,
                "{\"error\":\"that job isn't this worker's to finish\"}",
            )
        }
        let Some(log) = Id::parse(doc.field(doc.root, "log")) else {
            return json_reply(mut s, conn, 400, "{\"error\":\"give the output's blob id\"}")
        }
        if !s.core.stored.contains(log) {
            return json_reply(
                mut s,
                conn,
                422,
                "{\"error\":\"send the output first (POST /api/object)\"}",
            )
        }
        let status = match doc.get(doc.root, "status") {
            Some(v) => {
                let t = doc.text(v)
                if t.starts_with("-") { -1 } else { i32(doc.whole(v).unwrap_or(1)) }
            },
            None => -1,
        }
        let timed_out = match doc.get(doc.root, "timed_out") {
            Some(v) => doc.is_true(v),
            None => false,
        }
        let ms = doc.whole64(doc.get(doc.root, "ms").unwrap_or(doc.root)).unwrap_or(0)
        let x = object::evidence(
            object::Evidence {
                check: j.check.clone(),
                tree: j.tree,
                machine: worker.clone(),
                status,
                timed_out,
                ms,
                log,
                time: service::now(s),
            },
        )
        let passed = status == 0 && !timed_out
        print(
            f"forge: j{job} ({j.check}) {if passed { "passed" } else { "failed" }} on {worker} in {ms / 1000} s",
        )
        let ev = Event::Finished { job, evidence: x.id, passed, time: service::now(s) }
        let reply = service::Reply {
            conn,
            status: 200,
            kind: "application/json",
            body: bytes::of_str("{\"kept\":true}"),
        }
        return commit(
            mut s,
            Durable { objects: Vec::from([take x]), events: Vec::from([take ev]) },
            Some(take reply),
        )
    }
    json_reply(mut s, conn, 404, "{\"error\":\"no such call\"}")
}

@test
fn a_check_names_what_a_worker_runs() {
    let suite = command("suite")
    assert(suite.len() == 1 && suite[0].as_str() == "tools/check.sh", "the suite")
    let one = command("wgsl")
    assert(one.len() == 2 && one[1].as_str() == "wgsl", "one check")
    let index = command("index:engine")
    assert(
        index.len() == 4 && index[0].as_str() == "tools/wrela" && index[3].as_str() == "engine",
        "an index",
    )
}

@test
fn a_manifest_reads_back() {
    var files: Files = SortedMap::new()
    let id = object::blob_id(bytes::of_str("x"))
    let _ = files.insert(String::from("tools/check.sh"), File { id, exec: true, size: 1 })
    let _ = files.insert(String::from("a/b"), File { id, exec: false, size: 1 })
    let Some((back, at)) = worker_manifest_of(worker_manifest(files, 77)) else { panic("it reads") }
    assert(at == 77, "its time")
    assert(
        back.len() == 2 &&
            back.get(String::from("tools/check.sh")) == Some(File { id, exec: true, size: 1 }),
        "both files",
    )
    assert(manifest_of(Vec::from([2])).is_none(), "another version")
}

@test
fn a_trees_files_are_read_from_memory_or_named_to_load() {
    var c = core::core("t")
    var files: Files = SortedMap::new()
    let a = object::blob(bytes::of_str("a"))
    let _ = files.insert(String::from("d/a"), File { id: a.id, exec: false, size: 1 })
    let trees = object::trees(files)
    let root = trees[trees.len() - 1].id
    match tree_files(c, root) {
        Err(need) => assert(need.len() == 1 && need[0] == root, "the root first"),
        Ok(_) => panic("nothing is in memory"),
    }
    var objects = take trees
    objects.push(take a)
    let Ok(()) = core::absorb(mut c, Durable { objects, events: Vec::new() }) else {
        panic("absorbed")
    }
    match tree_files(c, root) {
        Ok(f) => assert(f.len() == 1 && f.contains(String::from("d/a")), "d/a"),
        Err(_) => panic("everything is in memory"),
    }
}

@test
fn a_file_a_check_changed_isnt_taken_as_written() {
    let id = object::blob_id(bytes::of_str("x"))
    let f = File { id, exec: false, size: 1 }
    let st = host::Stat { kind: host::Kind::File, size: 1, modified: 100 }
    assert(as_written(st, f, at: 101), "as written")
    assert(!as_written(st, f, at: 100), "changed as it was written")
    assert(
        !as_written(host::Stat { kind: host::Kind::File, size: 1, modified: 101 }, f, at: 100),
        "changed after",
    )
    assert(
        !as_written(host::Stat { kind: host::Kind::File, size: 2, modified: 50 }, f, at: 100),
        "another size",
    )
    assert(
        !as_written(host::Stat { kind: host::Kind::Program, size: 1, modified: 50 }, f, at: 100),
        "made executable",
    )
    assert(
        !as_written(host::Stat { kind: host::Kind::Missing, size: 0, modified: 0 }, f, at: 100),
        "gone",
    )
}
