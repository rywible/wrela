// The Model Context Protocol (modelcontextprotocol.io), as forge serves it over HTTP: each POST to
// `/mcp` is one JSON-RPC 2.0 message, answered in the response's body as JSON (the protocol's
// "streamable HTTP" with no stream). forge's tools (core.wrela) are its tools; an agent with
// forge as an MCP server reads, edits and checks code with no checkout of its own.

use out::Json
use std::json::{Json as Doc, Kind}

/// What a message asks.
pub enum Asked: Clone {
    /// Answer with this JSON-RPC result (a JSON value), now.
    Result(String),
    /// Call tool `name` with the arguments at value `args` of the message; answer with its output.
    Tool { name: String, args: u32 },
    /// A notification: no answer but an empty 202.
    Notice,
    /// Answer with a JSON-RPC error.
    Error { code: i32, message: String },
}

/// A message read: its id (as JSON, to echo back), and what it asks.
pub struct Message: Clone {
    pub id: String,
    pub asked: Asked,
}

/// The JSON an id was sent as.
fn id_json(doc: Doc, v: u32) -> String {
    match doc.kind(v) {
        Kind::Number => doc.text(v).to_string(),
        Kind::Text => {
            var j = Json::new()
            j.str(doc.text(v))
            take j.text
        },
        _ => String::from("null"),
    }
}

/// The protocol version forge speaks if the client's isn't one it knows.
const VERSION: Text = "2025-06-18"

/// Reads message `doc`.
pub fn read(doc: Doc) -> Message {
    let root = doc.root
    if doc.kind(root) != Kind::Object {
        return Message {
            id: String::from("null"),
            asked: Asked::Error {
                code: -32600,
                message: String::from("a message is one JSON object"),
            },
        }
    }
    let id = match doc.get(root, "id") {
        Some(v) => id_json(doc, v),
        None => String::new(),
    }
    let method = doc.field(root, "method").to_string()
    let params = doc.get(root, "params")
    if id.is_empty() {
        return Message { id, asked: Asked::Notice }
    }
    let asked = match method.as_str() {
        "initialize" => {
            let wanted = match params {
                Some(p) => doc.field(p, "protocolVersion").to_string(),
                None => String::new(),
            }
            let version = if wanted.as_str() == "2025-03-26" ||
                wanted.as_str() == "2025-06-18" ||
                wanted.as_str() == "2024-11-05" {
                take wanted
            } else {
                VERSION.to_string()
            }
            var j = Json::new()
            j.obj()
            j.kstr("protocolVersion", version.as_str())
            j.key("capabilities")
            j.obj()
            j.key("tools")
            j.obj()
            j.end_obj()
            j.end_obj()
            j.key("serverInfo")
            j.obj()
            j.kstr("name", "forge")
            j.kstr("version", "0.1.0")
            j.end_obj()
            j.kstr(
                "instructions",
                "forge holds wrela's source. Open a change (forge_open) with its intent, then read, search, edit and write files in it: it sees main's newest files wherever it hasn't written. forge_check runs checks on the change's tree on a GPU worker while you work; forge_submit runs the suite, and the change can land once that passes on its exact tree.",
            )
            j.end_obj()
            Asked::Result(take j.text)
        },
        "ping" => Asked::Result(String::from("{}")),
        "tools/list" => Asked::Result(f"{{\"tools\":{core::tools()}}}"),
        "tools/call" => {
            match params {
                Some(p) => {
                    let name = doc.field(p, "name").to_string()
                    match doc.get(p, "arguments") {
                        Some(a) => Asked::Tool { name, args: a },
                        None => Asked::Error {
                            code: -32602,
                            message: String::from("tools/call needs `arguments`"),
                        },
                    }
                },
                None => Asked::Error {
                    code: -32602,
                    message: String::from("tools/call needs its params"),
                },
            }
        },
        _ => Asked::Error { code: -32601, message: f"forge has no method `{method}`" },
    }
    Message { id, asked }
}

/// The answer to message `id` with result `result` (JSON).
pub fn result(id: str, result: str) -> String {
    f"{{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":{result}}}"
}

/// The answer to message `id` with an error.
pub fn error(id: str, code: i32, message: str) -> String {
    var j = Json::new()
    j.str(message)
    f"{{\"jsonrpc\":\"2.0\",\"id\":{id},\"error\":{{\"code\":{code},\"message\":{j.text}}}}}"
}

/// A tool's output as a `tools/call` result: its JSON as text content.
pub fn tool_result(output: str, is_error: bool) -> String {
    var j = Json::new()
    j.obj()
    j.key("content")
    j.arr()
    j.obj()
    j.kstr("type", "text")
    j.kstr("text", output)
    j.end_obj()
    j.end_arr()
    j.kbool("isError", is_error)
    j.end_obj()
    take j.text
}

fn doc(s: str) -> Doc {
    match Doc::read(bytes::of_str(s)) {
        Ok(d) => d,
        Err(why) => panic(f"bad test JSON: {why}"),
    }
}

@test
fn initialize_names_forge_and_its_tools() {
    let m = read(
        doc(
            "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\"}}",
        ),
    )
    assert(m.id.as_str() == "1", "the id")
    match m.asked {
        Asked::Result(r) => {
            let d = doc(r.as_str())
            assert(d.field(d.root, "protocolVersion") == "2025-03-26", "the client's version")
            assert(d.get(d.root, "capabilities").is_some(), "capabilities")
        },
        _ => panic("a result"),
    }
    let listed = read(doc("{\"jsonrpc\":\"2.0\",\"id\":\"a\",\"method\":\"tools/list\"}"))
    assert(listed.id.as_str() == "\"a\"", "a string id")
    match listed.asked {
        Asked::Result(r) => {
            let d = doc(r.as_str())
            let tools = d.get(d.root, "tools").unwrap()
            assert(
                d.count(tools) >= 10 && d.field(d.at(tools, 0), "name") == "forge_open",
                "the tools",
            )
        },
        _ => panic("a list"),
    }
}

@test
fn a_tool_call_names_its_tool_and_a_notice_is_not_answered() {
    let d = doc(
        "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"forge_read\",\"arguments\":{\"path\":\"a\"}}}",
    )
    match read(d).asked {
        Asked::Tool { name, args } => assert(
            name.as_str() == "forge_read" && d.field(args, "path") == "a",
            "the call",
        ),
        _ => panic("a tool call"),
    }
    match read(doc("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}")).asked {
        Asked::Notice => {},
        _ => panic("a notice"),
    }
    match read(doc("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"nope\"}")).asked {
        Asked::Error { code, .. } => assert(code == -32601, "no such method"),
        _ => panic("an error"),
    }
    let e = error("2", -32601, "x")
    assert(
        e.as_str() ==
            "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32601,\"message\":\"x\"}}",
        e.as_str(),
    )
}
