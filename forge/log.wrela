// The store's log (spec/forge.md): what happened, as records appended to one file and flushed
// before forge says it happened. A record is its payload's length (4 bytes, little-endian), the
// payload, and the first 8 bytes of the payload's BLAKE3 hash. Reading the log back stops at the
// first record that isn't whole or whose hash differs: a crash can cut the last record short,
// and recovery cuts the file back to the records before it.

use blake3::{Id, hash}

/// The largest payload a record holds.
pub const MOST: u32 = 67108864

/// `payload` as a record.
pub fn record(payload: [u8]) -> Vec<u8> {
    var out: Vec<u8> = Vec::with_capacity(payload.len() + 12)
    let n = payload.len()
    for k in 0..4 {
        out.push(u8((n >> (8 * k)) & 255))
    }
    bytes::push_run(mut out, payload)
    let h = hash(payload).bytes()
    for k in 0..8 {
        out.push(h[k])
    }
    out
}

/// What a log's bytes hold: each whole record's payload, and how many bytes they take. Bytes past
/// them are a torn record (or not the log's), which recovery cuts off.
pub struct Read: Clone {
    pub payloads: Vec<Vec<u8>>,
    /// Where each record ends, from the bytes' start.
    pub ends: Vec<u32>,
    pub whole: u32,
}

pub fn read(b: [u8]) -> Read {
    var out = Read { payloads: Vec::new(), ends: Vec::new(), whole: 0 }
    var at = 0
    while at + 12 <= b.len() {
        var n: u32 = 0
        for k in 0..4 {
            n = n | (u32(b[at + k]) << (8 * k))
        }
        if n > MOST || b.len() - at - 12 < n {
            break
        }
        let payload = bytes::slice(b, at + 4, at + 4 + n)
        let h = hash(payload).bytes()
        var same = true
        for k in 0..8 {
            if b[at + 4 + n + k] != h[k] {
                same = false
            }
        }
        if !same {
            break
        }
        out.payloads.push(take payload)
        at += n + 12
        out.ends.push(at)
        out.whole = at
    }
    out
}

/// A log's chain at a record's end (spec F25): BLAKE3 of the chain at the record before it and the
/// record's 8-byte hash, which ends the record.
pub fn chained(before: Id, record_end: [u8]) -> Id {
    var b: Vec<u8> = Vec::with_capacity(40)
    for x in before.bytes() {
        b.push(x)
    }
    bytes::push_run(mut b, bytes::slice(record_end, record_end.len() - 8, record_end.len()))
    hash(b)
}

/// The end and the chain there of each whole record of `b`, which starts at byte `at` of a log
/// whose chain there is `chain`.
pub fn ends(b: [u8], r: Read, at: u64, chain: Id) -> Vec<(u64, Id)> {
    var out: Vec<(u64, Id)> = Vec::with_capacity(r.ends.len())
    var c = chain
    for end in r.ends {
        c = chained(c, bytes::slice(b, end - 8, end))
        out.push((at + u64(end), c))
    }
    out
}

/// Where in `ends` (a log's record ends, in order) the log is `at` bytes long with chain `chain`;
/// whether it is. An empty log's chain is zero.
pub fn holds(ends: [(u64, Id)], at: u64, chain: Id) -> bool {
    if at == 0 {
        return chain.is_zero()
    }
    var lo = 0
    var hi = ends.len()
    while lo < hi {
        let mid = (lo + hi) / 2
        if ends[mid].0 < at {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo < ends.len() && ends[lo].0 == at && ends[lo].1 == chain
}

@test
fn a_logs_chain_tells_its_prefixes_apart() {
    var a: Vec<u8> = Vec::new()
    for text in ["one", "two", "three"] {
        bytes::push_run(mut a, record(bytes::of_str(text)))
    }
    var b: Vec<u8> = Vec::new()
    for text in ["one", "zwei", "three"] {
        bytes::push_run(mut b, record(bytes::of_str(text)))
    }
    let ea = ends(a, read(a), 0, Id::zero())
    let eb = ends(b, read(b), 0, Id::zero())
    assert(ea.len() == 3 && ea[0] == eb[0], "the same first record, the same chain")
    assert(ea[1].1 != eb[1].1 && ea[2].1 != eb[2].1, "a record apart, chains apart after it")
    assert(holds(ea, ea[1].0, ea[1].1) && holds(ea, 0, Id::zero()), "its own prefixes")
    assert(!holds(ea, eb[1].0, eb[1].1) && !holds(ea, ea[1].0 - 1, ea[1].1), "not another's")
    // Read from the middle, the chain goes on as it would from the start.
    let tail = bytes::slice(a, u32(ea[0].0), a.len())
    let et = ends(tail, read(tail), ea[0].0, ea[0].1)
    assert(et.len() == 2 && et[1] == ea[2], "the same chain from the middle")
}

@test
fn a_log_reads_back_its_records_and_stops_at_a_torn_one() {
    var log: Vec<u8> = Vec::new()
    for text in ["one", "", "three"] {
        bytes::push_run(mut log, record(bytes::of_str(text)))
    }
    let whole = log.len()
    let r = read(log)
    assert(r.payloads.len() == 3 && r.whole == whole, "three records")
    assert(
        bytes::same(r.payloads[2], bytes::of_str("three")) && r.payloads[1].is_empty(),
        "payloads",
    )
    // A crash in the middle of the next record leaves it cut short.
    let next = record(bytes::of_str("four"))
    for cut in 0..next.len() {
        var torn = log.clone()
        bytes::push_run(mut torn, bytes::slice(next, 0, cut))
        let t = read(torn)
        assert(t.payloads.len() == 3 && t.whole == whole, f"cut at {cut}")
    }
    // A record whose bytes changed is where the log ends.
    var bent = log.clone()
    bent[5] = 0
    assert(read(bent).payloads.is_empty(), "a changed first record")
}
