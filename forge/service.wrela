// The service (spec/forge.md): forge's state in memory and on disk, its HTTP connections, its
// commits and its workers, run by the service host (runtime/service). Every host request it makes
// waits in `waits` with what its answer is for, and `step` polls them on each call.
//
// What it keeps on disk, under the `data` root: `objects/ab/cdef...`, each object in a file of
// its own named by its id; `events`, the log; and `workers/<name>`, what each worker's checkout
// holds. A start reads the log back (cutting a torn last record), folds it, loads the files main
// and the open changes hold, and then listens.
//
// A commit makes a call's objects and events durable before its answer goes: the objects are
// written and flushed, then the events are appended to the log and flushed, then the answer is
// sent. The events are folded into the state when the commit is made, so the next call sees
// them; commits are written in the order they were made, and many that wait are written
// together. A write that fails stops the service: a start from the log is the state the answers
// promised.

use blake3::Id
use core::{Core, Ctx, Durable, Outcome}
use http::{Read, Reader, Request}
use object::{File, Files, Object}
use platform::net::{close, send}
use platform::service as host
use state::{Event, Run, Status}
use std::input::{Event as Input, events, payload}
use std::io::{IoError, Pending, print}
use std::json::{Json as Doc, Kind}

pub const DATA: Text = "data"
pub const LOG: Text = "data/events"
/// The most bytes a host request may carry, less room for its path: a larger write goes in parts.
const PART: u32 = 1040000

pub enum Phase: Copy + Eq {
    /// Reading the arguments and the time.
    Begin,
    /// Making directories and reading the log.
    Disk,
    /// Loading the files main and the open changes hold.
    Loading,
    /// Asking its peers, before it listens (peers.wrela).
    Probing,
    Ready,
    /// Running as a client: one call to a forge service.
    Client,
    /// Running as a worker of a forge service on another machine (remote.wrela).
    Work,
    /// Running as a replica of a forge service (replicate.wrela).
    Replica,
    /// Pulling or pushing a workspace (workspace.wrela).
    Workspace,
    /// Backing a store up, or restoring one (backup.wrela).
    Backup,
    Stopped,
}

/// What a host request's answer is for.
pub enum For: Clone {
    Args,
    Now,
    /// A directory made at the start.
    Made,
    /// The store's lock, taken at the start.
    Locked,
    /// What the store promised as a replica (replicate.wrela), read at the start.
    PromiseRead,
    ObjectDirs,
    LogStat,
    LogRead,
    Truncated,
    Object(Id),
    Listening,
    /// A write (or a part of one) of the commit in flight.
    Wrote,
    /// A part of the commit in flight's append.
    Appended,
    Peer(u32),
    /// What tailscale said of the caller on connection `conn`, at address `addr` (who.wrela).
    Whois(u32, String),
    /// A write or a removal in a worker's checkout, and a look at a file it would keep.
    Checkout,
    Looked(String),
    /// The host's clock, as a checkout is made.
    Clock,
    /// A look at a file a worker on another machine keeps (remote.wrela).
    RemoteLooked(String),
    ManifestRead,
    ManifestSaved,
    Ran(u64),
    /// A step of an import (import.wrela).
    Import(u32),
    /// A call's connection to a service (calls.wrela).
    Client(u32),
    /// A request of a worker on another machine (remote.wrela).
    Remote(u32),
    /// A request of a replica (replicate.wrela).
    Replica(u32),
    /// A read of the log for a replica's ask on connection `conn`.
    LogPart(u32),
    /// A wake-up, for what waits on time.
    Tick,
    /// A request of a workspace (workspace.wrela): what it's for, and for which file.
    Desk(u32, u32),
    /// A request of a backup or a restore (backup.wrela); an object it reads, and its kind.
    Backup(u32),
    BackupObject(Id, u8),
    /// A read of the log for a watch on connection `conn` (rooms.wrela).
    Watched(u32),
}

pub struct Wait {
    pub p: Pending<u8>,
    pub what: For,
}

/// An answer to send on a connection.
pub struct Reply: Clone {
    pub conn: u32,
    pub status: u32,
    pub kind: Text,
    pub body: Vec<u8>,
}

pub struct Conn {
    pub reader: Reader,
    /// Whether a request of its waits for its answer: the next is read once it's sent.
    pub busy: bool,
    pub closing: bool,
    pub peer: String,
    /// Whether its peer is known: its requests wait until it is, since who calls decides what
    /// they may do.
    pub known: bool,
    /// Who calls, once known; none for a caller forge refuses (F28). Until when tailscale's word
    /// holds (milliseconds since 1970; 0 for the machine itself): its next request after that waits
    /// for tailscale to say again.
    pub who: Option<who::Who>,
    pub until: u64,
}

/// A commit waiting to be written.
struct Pend: Clone {
    objects: Vec<Object>,
    events: Vec<Event>,
    records: Vec<u8>,
    reply: Option<Reply>,
    /// Whether the service stops once it is durable: it fences the service (F26a).
    stops: bool,
}

/// The commits being written: what waits on their writes, and their answers.
struct Flight: Clone {
    writes_left: u32,
    /// Each of its records' events.
    events: Vec<Vec<Event>>,
    records: Vec<u8>,
    /// Where each of its records will end in the log, and the log's chain there (F25).
    ends: Vec<(u64, Id)>,
    appends_left: u32,
    replies: Vec<Reply>,
    stops: bool,
}

/// A call that waits for objects, to be made again once they're loaded.
pub struct Parked: Clone {
    pub conn: u32,
    pub body: Vec<u8>,
    pub waiting: Vec<Id>,
    pub rounds: u32,
}

pub struct Service {
    pub phase: Phase,
    pub started: bool,
    /// How many of the arguments and the time have come.
    begun: u32,
    pub args: Vec<String>,
    /// Where it listens, the machine's name, and who may land changes.
    pub listen: String,
    pub machine: String,
    /// Who may write, land and work or replicate (F22): rules who.wrela reads. With no
    /// `--writers`, every caller forge knows may write.
    pub writers: Option<Vec<String>>,
    pub landers: Vec<String>,
    pub fleet: Vec<String>,
    /// The program that says who a tailnet address is, and what it said of each address lately:
    /// who, and until when it holds (milliseconds since 1970).
    pub whois: String,
    known: SortedMap<String, (who::Who, u64)>,
    /// The time when the host started: milliseconds since 1970, and the call's seconds since.
    pub start_ms: u64,
    pub time: f32,
    pub core: Core,
    pub waits: Vec<Wait>,
    pub conns: SortedMap<u32, Conn>,
    queue: Vec<Pend>,
    flight: Option<Flight>,
    /// Objects written, or being written: not written again.
    written: SortedMap<Id, bool>,
    loading: SortedMap<Id, bool>,
    /// Objects that couldn't be loaded.
    missing: SortedMap<Id, bool>,
    pub parked: Vec<Parked>,
    pub startup_left: u32,
    pub log_size: u64,
    /// Where each record of the log ends, and the log's chain there (F25): what a replica's ask
    /// is checked against.
    pub ends: Vec<(u64, Id)>,
    /// The other stores of the fleet (`--peers`), and the address they know this one by.
    pub peers: peers::Peers,
    pub advertise: String,
    /// Whether it learned of a newer epoch: it answers nothing more, and stops once that's
    /// durable.
    pub fencing: bool,
    pub worker: jobs::Worker,
    pub import: import::Import,
    pub calls: calls::Calls,
    pub remote: remote::Remote,
    /// Whether the service runs checks itself.
    pub works: bool,
    /// Replication (replicate.wrela): the replicas' asks that wait, what each replica holds, how
    /// many must hold a landing before it's answered, the answers that wait for them, the objects
    /// asks that wait for loads, a replica's own state, and whether a wake-up is out.
    pub asks: Vec<replicate::Ask>,
    pub replicas: Vec<(String, u64)>,
    pub acks: u32,
    pub awaiting: Vec<(u64, Vec<Reply>)>,
    pub object_asks: Vec<(u32, Vec<u8>)>,
    pub replica: replicate::Replica,
    pub desk: workspace::Workspace,
    pub backup: backup::Backup,
    pub rooms: rooms::Rooms,
    pub watching: client::Watching,
    ticking: bool,
    /// When the chores that wait on time are next done: jobs past their limit, peers' epochs.
    chores_at: u64,
    /// Whether main moved since the open changes were last carried onto it.
    carry_due: bool,
}

pub fn new() -> Service {
    Service {
        phase: Phase::Begin,
        started: false,
        begun: 0,
        args: Vec::new(),
        listen: String::from("127.0.0.1:7171"),
        machine: String::from("local"),
        writers: None,
        landers: Vec::new(),
        fleet: Vec::new(),
        whois: String::from("tailscale"),
        known: SortedMap::new(),
        start_ms: 0,
        time: 0.0,
        core: core::core("local"),
        waits: Vec::new(),
        conns: SortedMap::new(),
        queue: Vec::new(),
        flight: None,
        written: SortedMap::new(),
        loading: SortedMap::new(),
        missing: SortedMap::new(),
        parked: Vec::new(),
        startup_left: 0,
        log_size: 0,
        ends: Vec::new(),
        peers: peers::none(),
        advertise: String::new(),
        fencing: false,
        worker: jobs::worker("local"),
        import: import::idle(),
        calls: calls::calls(""),
        remote: remote::idle(),
        works: true,
        asks: Vec::new(),
        replicas: Vec::new(),
        acks: 0,
        awaiting: Vec::new(),
        object_asks: Vec::new(),
        replica: replicate::idle(),
        desk: workspace::idle(),
        backup: backup::idle(),
        rooms: rooms::none(),
        watching: client::not_watching(),
        ticking: false,
        chores_at: 0,
        carry_due: false,
    }
}

pub fn wait(s: mut Service, p: take Pending<u8>, what: take For) {
    s.waits.push(Wait { p, what })
}

/// Milliseconds since 1970, now.
pub fn now(s: Service) -> u64 {
    s.start_ms + u64(s.time * 1000.0)
}

/// Stops the service with `why`: a start from the log is what it promised.
pub fn fatal(s: mut Service, why: str) {
    print(f"forge: {why}")
    host::exit(1)
    s.phase = Phase::Stopped
}

/// One call of the host: answers, then input, then what waits to be written.
pub fn step(s: mut Service, time: f32) {
    s.time = time
    if s.phase == Phase::Stopped {
        return
    }
    if !s.started {
        s.started = true
        wait(mut s, host::args(), For::Args)
        wait(mut s, host::now(), For::Now)
    }
    var i = 0
    while i < s.waits.len() {
        let answer = s.waits[i].p.poll()
        match take answer {
            Some(r) => {
                let w = s.waits.remove(i)
                answered(mut s, take w.what, take r)
                if s.phase == Phase::Stopped {
                    return
                }
            },
            None => i += 1,
        }
    }
    for e in events() {
        match e {
            // A connection a listener accepted is a caller's (its tag is the port); one the
            // program made (tag 0) is a call's.
            Input::Message { conn, .. } => {
                if let Some(b) = payload(e) {
                    if s.conns.contains(conn) {
                        bytes_in(mut s, conn, b)
                    } else {
                        calls::bytes(mut s, conn, b)
                    }
                }
            },
            Input::Connection { conn, open, tag } => {
                if tag == 0 {
                    calls::connection(mut s, conn, open)
                } else if open && s.conns.len() >= 1024 {
                    // At most 1024 callers at once.
                    close(conn)
                } else if open {
                    let _ = s.conns.insert(
                        conn,
                        Conn {
                            reader: Reader::new(),
                            busy: false,
                            closing: false,
                            peer: String::new(),
                            known: false,
                            who: None,
                            until: 0,
                        },
                    )
                    wait(mut s, host::peer(conn), For::Peer(conn))
                } else {
                    let _ = s.conns.remove(conn)
                }
            },
            _ => {},
        }
    }
    if s.phase == Phase::Ready {
        if s.carry_due {
            carry_all(mut s)
        }
        if s.works {
            jobs::pump(mut s)
        }
        import::pump(mut s)
        if now(s) >= s.chores_at {
            s.chores_at = now(s) + 10000
            jobs::expire(mut s)
            peers::now_and_then(mut s)
        }
    }
    if s.phase == Phase::Work {
        remote::pump(mut s)
    }
    if s.phase == Phase::Replica {
        replicate::pump(mut s)
    }
    if s.phase == Phase::Workspace {
        workspace::pump(mut s)
    }
    pump(mut s)
    calls::expire(mut s)
    if s.phase == Phase::Ready {
        replicate::pump_asks(mut s)
        replicate::pump_objects(mut s)
        rooms::pump(mut s)
    }
    // Asks, calls and chores wait on time: a wake-up each second.
    let timed = s.phase == Phase::Ready || s.phase == Phase::Replica || s.calls.busy
    if timed && !s.ticking && s.phase != Phase::Stopped {
        s.ticking = true
        wait(mut s, host::after(1000), For::Tick)
    }
}

fn answered(s: mut Service, what: take For, r: take Result<Vec<u8>, IoError>) {
    match take what {
        For::Args => {
            if let Ok(b) = take r {
                s.args = host::args_of(take b).unwrap_or(Vec::new())
            }
            begin(mut s)
        },
        For::Now => {
            if let Ok(b) = take r {
                s.start_ms = host::millis_of(take b).unwrap_or(0)
            }
            begin(mut s)
        },
        For::Made => started_one(mut s, "making a directory", take r),
        For::PromiseRead => {
            // A promotion's epoch is above any this store promised another candidate.
            if let Ok(b) = take r {
                match replicate::promise_of(take b) {
                    Some((epoch, _)) => s.peers.fence_epoch = epoch,
                    None => return fatal(mut s, "data/promise isn't a promise forge kept"),
                }
            }
            started_one(mut s, "reading the store's promise", Ok(Vec::new()))
        },
        For::Locked => started_one(
            mut s,
            "another forge holds this store (its lock, data/lock)",
            take r,
        ),
        For::ObjectDirs => {
            match take r {
                Ok(b) => {
                    let have = host::entries_of(take b).unwrap_or(Vec::new())
                    let hex = "0123456789abcdef"
                    for hi in 0..16 {
                        for lo in 0..16 {
                            var name = String::new()
                            name.push_byte(hex.byte(hi))
                            name.push_byte(hex.byte(lo))
                            var there = false
                            for e in have {
                                if e.name.as_str() == name.as_str() {
                                    there = true
                                }
                            }
                            if !there {
                                s.startup_left += 1
                                wait(
                                    mut s,
                                    host::mkdir(f"{DATA}/objects/{name}".as_str()),
                                    For::Made,
                                )
                            }
                        }
                    }
                    started_one(mut s, "listing the objects", Ok(Vec::new()))
                },
                Err(e) => fatal(mut s, f"can't list data/objects: {e.message()}".as_str()),
            }
        },
        For::LogStat => {
            match take r {
                Ok(b) => {
                    let st = host::stat_of(take b)
                    match st {
                        Some(x) => {
                            if x.kind == host::Kind::Missing {
                                started_one(mut s, "the log", Ok(Vec::new()))
                            } else {
                                s.startup_left += 1
                                wait(mut s, host::read(LOG), For::LogRead)
                                started_one(mut s, "the log", Ok(Vec::new()))
                            }
                        },
                        None => fatal(mut s, "the log's stat is malformed"),
                    }
                },
                Err(e) => fatal(mut s, f"can't stat the log: {e.message()}".as_str()),
            }
        },
        For::LogRead => {
            match take r {
                Ok(b) => replay(mut s, take b),
                Err(e) => fatal(mut s, f"can't read the log: {e.message()}".as_str()),
            }
        },
        For::Truncated => started_one(mut s, "cutting the log's torn record", take r),
        For::Object(id) => loaded(mut s, id, take r),
        For::Listening => {
            match take r {
                Ok(b) => {
                    print(
                        f"forge: main at {s.core.state.seq}; listening on {s.listen} (port {host::port_of(take b).unwrap_or(0)})",
                    )
                    s.phase = Phase::Ready
                },
                Err(e) => fatal(mut s, f"can't listen on {s.listen}: {e.message()}".as_str()),
            }
        },
        For::Wrote => {
            if let Err(e) = r {
                return fatal(mut s, f"an object's write failed: {e.message()}".as_str())
            }
            wrote_one(mut s)
        },
        For::Appended => {
            match take r {
                Ok(b) => {
                    s.log_size = host::length_of(take b).unwrap_or(s.log_size)
                    appended_one(mut s)
                },
                Err(e) => fatal(mut s, f"the log's append failed: {e.message()}".as_str()),
            }
        },
        For::Peer(conn) => {
            if s.conns.contains(conn) {
                if let Ok(b) = take r {
                    s.conns.at_mut(conn).peer = bytes::text_of(b)
                }
                identify(mut s, conn)
            }
        },
        For::Whois(conn, addr) => whois_said(mut s, conn, addr.as_str(), take r),
        For::Checkout => jobs::checkout_done(mut s, take r),
        For::Looked(path) => jobs::looked(mut s, take path, take r),
        For::Clock => jobs::clocked(mut s, take r),
        For::RemoteLooked(path) => remote::looked(mut s, take path, take r),
        For::ManifestRead => jobs::manifest_read(mut s, take r),
        For::ManifestSaved => jobs::manifest_saved(mut s, take r),
        For::Ran(job) => jobs::ran(mut s, job, take r),
        For::Import(step) => import::answered(mut s, step, take r),
        For::Client(serial) => calls::connected(mut s, serial, take r),
        For::Remote(what) => remote::answered(mut s, what, take r),
        For::Replica(what) => replicate::answered(mut s, what, take r),
        For::LogPart(conn) => replicate::log_read(mut s, conn, take r),
        For::Tick => s.ticking = false,
        For::Desk(what, i) => workspace::answered(mut s, what, i, take r),
        For::Backup(what) => backup::answered(mut s, what, take r),
        For::BackupObject(id, kind) => backup::read_object(mut s, id, kind, take r),
        For::Watched(conn) => rooms::read(mut s, conn, take r),
    }
}

// ---- starting ----------------------------------------------------------------------------------

fn flag(args: [String], name: str) -> Option<String> {
    for i in 0..args.len() {
        if args[i].as_str() == name && i + 1 < args.len() {
            return Some(args[i + 1].clone())
        }
    }
    None
}

/// Once the arguments and the time have come: serves, or makes one call as a client.
fn begin(s: mut Service) {
    s.begun += 1
    if s.begun < 2 {
        return
    }
    let mode = if s.args.is_empty() { String::from("help") } else { s.args[0].clone() }
    // Who may do what, and who tailscale says calls: for a service and a replica alike.
    for (name, which) in [("--writers", 0), ("--landers", 1), ("--fleet", 2)] {
        let Some(l) = flag(s.args, name) else { continue }
        if let Some(bad) = who::bad_rule(l.as_str()) {
            return fatal(
                mut s,
                f"{name}: `{bad}` isn't node:NAME, user:LOGIN, tag:TAG or an address".as_str(),
            )
        }
        let rules = who::rules(l.as_str())
        if which == 0 {
            s.writers = Some(take rules)
        } else if which == 1 {
            s.landers = take rules
        } else {
            s.fleet = take rules
        }
    }
    if let Some(w) = flag(s.args, "--whois") {
        s.whois = take w
    }
    let keeps = mode.as_str() == "serve" || mode.as_str() == "replica" || mode.as_str() == "work"
    if keeps && flag(s.args, "--machine").is_none() {
        // Each machine's name is its own: two stores both called `local` would each take the
        // other's epoch for their own (F26).
        return fatal(mut s, f"forge {mode} needs --machine NAME, a name of this machine's own")
    }
    if mode.as_str() == "work" {
        s.phase = Phase::Work
        return remote::start(mut s)
    }
    if mode.as_str() == "replica" {
        s.phase = Phase::Replica
        return replicate::start(mut s)
    }
    if mode.as_str() == "backup" || mode.as_str() == "restore" {
        s.phase = Phase::Backup
        return backup::start(mut s, mode.as_str() == "restore")
    }
    if mode.as_str() == "pull" || mode.as_str() == "push" {
        s.phase = Phase::Workspace
        return workspace::start(mut s)
    }
    if let Some(n) = flag(s.args, "--acks") {
        s.acks = u32(bytes::parse_u64(n.as_str()).unwrap_or(0))
    }
    if mode.as_str() != "serve" {
        s.phase = Phase::Client
        return client::start(mut s)
    }
    var works = true
    for a in s.args {
        if a.as_str() == "--no-worker" {
            works = false
        }
    }
    s.works = works
    if let Some(l) = flag(s.args, "--listen") {
        s.listen = take l
    }
    if let Some(m) = flag(s.args, "--machine") {
        s.machine = m.clone()
        s.core.machine = m.clone()
        s.worker = jobs::worker(m.as_str())
    }
    if let Some(p) = flag(s.args, "--peers") {
        s.peers.addrs = who::rules(p.as_str())
    }
    s.advertise = flag(s.args, "--advertise").unwrap_or(s.listen.clone())
    s.phase = Phase::Disk
    // One program holds a store at a time: its lock first, before anything of it is read.
    s.startup_left = 7
    wait(mut s, host::lock("data/lock"), For::Locked)
    wait(mut s, host::read("data/promise"), For::PromiseRead)
    wait(mut s, host::mkdir("data/objects"), For::Made)
    wait(mut s, host::mkdir("data/workers"), For::Made)
    wait(mut s, host::list("data/objects"), For::ObjectDirs)
    wait(mut s, host::stat(LOG), For::LogStat)
    wait(mut s, host::read(jobs::manifest_path(s.worker.name.as_str()).as_str()), For::ManifestRead)
}

/// One request of the start answered: once all have been, the next stage begins.
pub fn started_one(s: mut Service, what: str, r: take Result<Vec<u8>, IoError>) {
    if let Err(e) = r {
        return fatal(mut s, f"{what}: {e.message()}".as_str())
    }
    s.startup_left -= 1
    if s.startup_left > 0 {
        return
    }
    if s.phase == Phase::Disk {
        load_held(mut s)
    } else if s.phase == Phase::Loading {
        if s.core.state.fenced > 0 {
            return fatal(
                mut s,
                f"epoch {s.core.state.fenced} fenced this store's service: it serves no more (make it a replica again from an empty store)".as_str(),
            )
        }
        // What this service's worker ran when it stopped runs again, as a new try (F23a).
        var events: Vec<Event> = Vec::new()
        for id in jobs::running_on(s, s.worker.name.as_str()) {
            events.push(
                Event::Requeued {
                    job: id,
                    why: String::from("the service started again"),
                    time: now(s),
                },
            )
        }
        if !events.is_empty() {
            commit(mut s, Durable { objects: Vec::new(), events }, None)
        }
        var promote = false
        for a in s.args {
            if a.as_str() == "--promote" {
                promote = true
            }
        }
        if !promote {
            // A store's first service begins its first epoch; a store whose epoch is another
            // machine's is that service's replica, which serves only once promoted (F26).
            if s.core.state.epoch == 0 {
                let ev = Event::Promoted { epoch: 1, machine: s.machine.clone(), time: now(s) }
                commit(mut s, Durable { objects: Vec::new(), events: Vec::from([take ev]) }, None)
            } else if s.core.state.primary.as_str() != s.machine.as_str() {
                return fatal(
                    mut s,
                    f"epoch {s.core.state.epoch} is {s.core.state.primary}'s, not {s.machine}'s: `forge serve --promote` makes this store the service".as_str(),
                )
            }
        }
        peers::at_start(mut s, promote)
    }
}

/// Listens for callers: ready once it does.
pub fn listen(s: mut Service) {
    s.phase = Phase::Begin
    wait(mut s, host::listen(s.listen.as_str()), For::Listening)
    s.carry_due = true
}

/// Fenced by epoch `epoch` (F26a): from now it confirms nothing, and once the fence is in the log
/// it sends `answer` (if any) and stops.
pub fn fence(s: mut Service, epoch: u64, answer: take Option<Reply>) {
    if s.fencing {
        if let Some(a) = answer {
            reply(mut s, a.conn, 503, "text/plain", bytes::of_str("forge is being fenced\n"))
        }
        return
    }
    s.fencing = true
    print(f"forge: epoch {epoch} is newer than this service's ({s.core.state.epoch}): stopping")
    let ev = Event::Fenced { epoch, time: now(s) }
    let d = Durable { objects: Vec::new(), events: Vec::from([take ev]) }
    if let Err(why) = core::absorb(mut s.core, d.clone()) {
        return fatal(mut s, f"the fence doesn't apply: {why}".as_str())
    }
    let records = log::record(state::payload(d.events))
    s.queue.push(
        Pend { objects: Vec::new(), events: d.events.clone(), records, reply: answer, stops: true },
    )
}

impl Service {
    /// Whether every commit made is durable.
    pub fn flushed(self) -> bool {
        self.queue.is_empty() && self.flight.is_none()
    }
}

/// The log's bytes: each whole record folded, a torn last record cut off.
fn replay(s: mut Service, b: take Vec<u8>) {
    let read = log::read(b)
    if read.whole < b.len() {
        print(f"forge: the log ends in {b.len() - read.whole} bytes of a torn record; cutting them")
        s.startup_left += 1
        wait(mut s, host::truncate(LOG, u64(read.whole)), For::Truncated)
    }
    s.log_size = u64(read.whole)
    s.ends = log::ends(b, read.clone(), 0, Id::zero())
    var n = 0
    for p in read.payloads {
        match state::decode_all(p.clone()) {
            Ok(evs) => {
                if let Err(why) = state::apply_all(mut s.core.state, evs) {
                    return fatal(mut s, f"record {n} of the log doesn't apply: {why}".as_str())
                }
            },
            Err(bad) => return fatal(
                mut s,
                f"record {n} of the log is malformed: {bad.why}".as_str(),
            ),
        }
        n += 1
    }
    print(f"forge: {n} records; main at {s.core.state.seq}")
    started_one(mut s, "reading the log", Ok(Vec::new()))
}

/// The objects every start loads: the files main and the open changes hold.
fn load_held(s: mut Service) {
    s.phase = Phase::Loading
    var ids: SortedMap<Id, bool> = SortedMap::new()
    for f in s.core.state.files.values() {
        let _ = ids.insert(f.id, value: true)
    }
    for c in s.core.state.changes.values() {
        if c.status == Status::Open {
            for t in c.touches.values() {
                for x in [t.base, t.now, t.conflict] {
                    if let Some(f) = x {
                        let _ = ids.insert(f.id, value: true)
                    }
                }
            }
        }
    }
    s.startup_left = 1
    for id in ids.keys() {
        if load(mut s, id) {
            s.startup_left += 1
        }
    }
    started_one(mut s, "loading", Ok(Vec::new()))
}

// ---- objects -----------------------------------------------------------------------------------

/// Loads object `id` into memory, if it isn't and isn't loading: whether a load began.
pub fn load(s: mut Service, id: Id) -> bool {
    if s.core.blobs.contains(id) || s.loading.contains(id) || s.missing.contains(id) {
        return false
    }
    let _ = s.loading.insert(id, value: true)
    wait(mut s, host::read(object::path(DATA, id).as_str()), For::Object(id))
    true
}

fn loaded(s: mut Service, id: Id, r: take Result<Vec<u8>, IoError>) {
    let _ = s.loading.remove(id)
    let starting = s.phase == Phase::Loading
    match take r {
        Ok(b) => match object::check(id, b) {
            Ok(kind) => {
                let _ = s.core.stored.insert(id, value: true)
                let _ = s.written.insert(id, value: true)
                let _ = s.core.blobs.insert(id, if kind == object::BLOB {
                    object::content(b)
                } else { take b })
            },
            Err(bad) => {
                if starting {
                    return fatal(mut s, f"object {id.hex()}: {bad.why}".as_str())
                }
                let _ = s.missing.insert(id, value: true)
            },
        },
        Err(e) => {
            if starting {
                return fatal(mut s, f"object {id.hex()} can't be read: {e.message()}".as_str())
            }
            let _ = s.missing.insert(id, value: true)
        },
    }
    if starting {
        return started_one(mut s, "loading an object", Ok(Vec::new()))
    }
    unpark(mut s, id)
    // A carry or a job may have waited for it.
    s.carry_due = true
}

/// Makes again each parked call that no longer waits for an object.
fn unpark(s: mut Service, id: Id) {
    var i = 0
    while i < s.parked.len() {
        var hit = false
        var k = 0
        while k < s.parked[i].waiting.len() {
            if s.parked[i].waiting[k] == id {
                let _ = s.parked[i].waiting.remove(k)
                hit = true
            } else {
                k += 1
            }
        }
        if hit && s.parked[i].waiting.is_empty() {
            let p = s.parked.remove(i)
            if s.missing.contains(id) {
                reply(
                    mut s,
                    p.conn,
                    500,
                    "application/json",
                    bytes::of_str("{\"error\":\"an object forge needs is missing\"}"),
                )
            } else {
                retry(mut s, take p)
            }
        } else {
            i += 1
        }
    }
}

// ---- commits -----------------------------------------------------------------------------------

/// Makes `d` durable, then sends `answer` (if any). Its events are folded in now. A call's events
/// are one record, so a crash keeps all of them or none (F14); one larger than a record may hold
/// is refused.
pub fn commit(s: mut Service, d: take Durable, answer: take Option<Reply>) {
    var records: Vec<u8> = Vec::new()
    if !d.events.is_empty() {
        let p = state::payload(d.events)
        if p.len() > log::MOST {
            if let Some(a) = answer {
                reply(
                    mut s,
                    a.conn,
                    413,
                    "application/json",
                    bytes::of_str(
                        "{\"error\":\"the call's events are larger than a record holds\"}",
                    ),
                )
            }
            return
        }
        records = log::record(p)
    }
    if let Err(why) = core::absorb(mut s.core, d.clone()) {
        print(f"forge: a call's events don't apply: {why}")
        if let Some(a) = answer {
            reply(
                mut s,
                a.conn,
                500,
                "application/json",
                bytes::of_str("{\"error\":\"forge couldn't apply the call\"}"),
            )
        }
        return
    }
    for ev in d.events {
        match ev {
            Event::Landed { .. } => s.carry_due = true,
            _ => {},
        }
    }
    s.queue.push(
        Pend {
            objects: take d.objects,
            events: take d.events,
            records,
            reply: answer,
            stops: false,
        },
    )
}

/// Writes the commits that wait, if none are being written.
fn pump(s: mut Service) {
    if s.flight.is_some() || s.queue.is_empty() || s.phase == Phase::Stopped {
        return
    }
    var f = Flight {
        writes_left: 0,
        events: Vec::new(),
        records: Vec::new(),
        ends: Vec::new(),
        appends_left: 0,
        replies: Vec::new(),
        stops: false,
    }
    let pends = replace(mut s.queue, Vec::new())
    for p in pends {
        for o in p.objects {
            if s.written.contains(o.id) {
                continue
            }
            let _ = s.written.insert(o.id, value: true)
            f.writes_left += write_object(mut s, o.id, o.bytes)
        }
        bytes::push_run(mut f.records, p.records)
        if !p.events.is_empty() {
            f.events.push(p.events.clone())
        }
        f.stops = f.stops || p.stops
        if let Some(r) = p.reply {
            f.replies.push(r.clone())
        }
    }
    f.ends = log::ends(f.records, log::read(f.records), s.log_size, chain_of(s))
    let none_left = f.writes_left == 0
    s.flight = Some(take f)
    if none_left {
        append_flight(mut s)
    }
}

/// Writes object `id` to its file, in parts if it's large: how many answers it waits for.
fn write_object(s: mut Service, id: Id, b: [u8]) -> u32 {
    write_file(mut s, object::path(DATA, id).as_str(), b, For::Wrote)
}

/// Writes `b` to the file at `path`, whole or not at all but not flushed (a crash of the machine
/// may leave the old file), in parts if it's large; `exec` makes it executable. How many answers
/// (each for `what`) it waits for.
pub fn write_unflushed_file(s: mut Service, path: str, b: [u8], exec: bool, what: For) -> u32 {
    if b.len() <= PART {
        wait(mut s, host::write_unflushed(path, b, exec), what.clone())
        return 1
    }
    let part = f"{path}.part"
    wait(mut s, host::write_unflushed(part.as_str(), bytes::slice(b, 0, PART), exec), what.clone())
    var n = 1
    var at = PART
    while at < b.len() {
        let end = min(at + PART, b.len())
        wait(mut s, host::append(part.as_str(), bytes::slice(b, at, end)), what.clone())
        n += 1
        at = end
    }
    wait(mut s, host::rename(part.as_str(), path), what.clone())
    n + 1
}

/// Writes `b` to the file at `path`, flushed, whole or not at all, in parts if it's large, and
/// executable if `exec`: how many answers (each for `what`) it waits for.
pub fn write_exec_file(s: mut Service, path: str, b: [u8], exec: bool, what: For) -> u32 {
    if b.len() <= PART {
        wait(mut s, host::write_file(path, b, exec), what.clone())
        return 1
    }
    let part = f"{path}.part"
    wait(mut s, host::write_file(part.as_str(), bytes::slice(b, 0, PART), exec), what.clone())
    var n = 1
    var at = PART
    while at < b.len() {
        let end = min(at + PART, b.len())
        wait(mut s, host::append(part.as_str(), bytes::slice(b, at, end)), what.clone())
        n += 1
        at = end
    }
    wait(mut s, host::rename(part.as_str(), path), what.clone())
    n + 1
}

/// Writes `b` to the file at `path`, flushed, whole or not at all, in parts if it's large: how
/// many answers (each for `what`) it waits for.
pub fn write_file(s: mut Service, path: str, b: [u8], what: For) -> u32 {
    if b.len() <= PART {
        wait(mut s, host::write(path, b), what.clone())
        return 1
    }
    // Written beside it in parts, then renamed into place: whole or absent after a crash.
    let part = f"{path}.part"
    wait(mut s, host::write(part.as_str(), bytes::slice(b, 0, PART)), what.clone())
    var n = 1
    var at = PART
    while at < b.len() {
        let end = min(at + PART, b.len())
        wait(mut s, host::append(part.as_str(), bytes::slice(b, at, end)), what.clone())
        n += 1
        at = end
    }
    wait(mut s, host::rename(part.as_str(), path), what.clone())
    n + 1
}

fn wrote_one(s: mut Service) {
    match mut s.flight {
        Some(f) => {
            f.writes_left -= 1
            if f.writes_left > 0 {
                return
            }
        },
        None => return fatal(mut s, "a write answered with no commit in flight"),
    }
    append_flight(mut s)
}

/// Appends the flight's records to the log, in parts: a crash between them leaves a torn
/// record, which the next start cuts off.
fn append_flight(s: mut Service) {
    let records = match mut s.flight {
        Some(f) => replace(mut f.records, Vec::new()),
        None => return,
    }
    if records.is_empty() {
        return appended_all(mut s)
    }
    var n = 0
    var at = 0
    while at < records.len() {
        let end = min(at + PART, records.len())
        wait(mut s, host::append(LOG, bytes::slice(records, at, end)), For::Appended)
        n += 1
        at = end
    }
    match mut s.flight {
        Some(f) => f.appends_left = n,
        None => {},
    }
}

fn appended_one(s: mut Service) {
    match mut s.flight {
        Some(f) => {
            f.appends_left -= 1
            if f.appends_left > 0 {
                return
            }
        },
        None => return fatal(mut s, "an append answered with no commit in flight"),
    }
    appended_all(mut s)
}

/// The flight is durable: its answers go, once enough replicas hold it too (`--acks`).
fn appended_all(s: mut Service) {
    let Some(f) = replace(mut s.flight, None) else { return }
    for e in f.ends {
        s.ends.push(e)
    }
    rooms::kept(mut s, f.events, f.ends)
    if f.stops {
        // The fence is durable: its own answer goes, and the service stops.
        for r in f.replies {
            if r.status == 200 {
                reply(mut s, r.conn, r.status, r.kind, r.body.clone())
            }
        }
        print("forge: fenced")
        host::exit(1)
        s.phase = Phase::Stopped
        return
    }
    if s.fencing {
        // Fenced while this was written: nothing more is confirmed.
        for r in f.replies {
            reply(
                mut s,
                r.conn,
                503,
                "text/plain",
                bytes::of_str("forge was fenced: this call's outcome is unknown\n"),
            )
        }
        return pump(mut s)
    }
    if s.acks > 0 && !f.replies.is_empty() {
        s.awaiting.push((s.log_size, f.replies.clone()))
        replicate::release(mut s)
    } else {
        for r in f.replies {
            reply(mut s, r.conn, r.status, r.kind, r.body.clone())
        }
    }
    pump(mut s)
}

/// How long the log is, as far as it is durable: the end of its last record written whole.
pub fn durable(s: Service) -> u64 {
    if s.ends.is_empty() { 0 } else { s.ends[s.ends.len() - 1].0 }
}

/// The log's chain at its durable end (F25).
pub fn chain_of(s: Service) -> Id {
    if s.ends.is_empty() { Id::zero() } else { s.ends[s.ends.len() - 1].1 }
}

// ---- carrying changes onto main ----------------------------------------------------------------

/// Carries every open change whose files main has moved past onto main.
fn carry_all(s: mut Service) {
    s.carry_due = false
    var ids: Vec<u64> = Vec::new()
    for c in s.core.state.changes.values() {
        if c.status == Status::Open && !state::stale(s.core.state, c.clone()).is_empty() {
            ids.push(c.id)
        }
    }
    for id in ids {
        let ch = s.core.state.changes.at(id).clone()
        match core::carry(s.core, ch) {
            Outcome::Done { durable, .. } => commit(mut s, take durable, None),
            Outcome::Need(need) => {
                for x in need {
                    let _ = load(mut s, x)
                }
                // Carried again once the objects have come.
                s.carry_due = true
            },
        }
    }
}

// ---- HTTP --------------------------------------------------------------------------------------

/// Sends `b` on connection `conn`, in parts: a host request holds at most 1 MiB.
pub fn send_all(conn: u32, b: [u8]) {
    if b.len() <= PART {
        return send(conn, b)
    }
    var at = 0
    while at < b.len() {
        let end = min(at + PART, b.len())
        send(conn, bytes::slice(b, at, end))
        at = end
    }
}

/// Sends an answer on connection `conn`, then reads its next request.
pub fn reply(s: mut Service, conn: u32, status: u32, kind: Text, body: [u8]) {
    if !s.conns.contains(conn) {
        return
    }
    let closing = s.conns.at(conn).closing
    send_all(conn, http::response(status, kind, body, close: closing))
    if closing {
        close(conn)
        let _ = s.conns.remove(conn)
        return
    }
    s.conns.at_mut(conn).busy = false
    next_request(mut s, conn)
}

fn bytes_in(s: mut Service, conn: u32, b: [u8]) {
    if !s.conns.contains(conn) {
        return
    }
    s.conns.at_mut(conn).reader.add(b)
    // A connection holds at most one request's worth of bytes it hasn't been answered for, and
    // all of them together at most 256 MiB: past that, it is closed.
    var all: u64 = 0
    for c in s.conns.values() {
        all += u64(c.reader.held())
    }
    if s.conns.at(conn).reader.held() > http::MOST_BODY + 131072 || all > 268435456 {
        print(f"forge: {s.conns.at(conn).peer} sent more than forge holds for it; closing it")
        close(conn)
        let _ = s.conns.remove(conn)
        return
    }
    next_request(mut s, conn)
}

fn next_request(s: mut Service, conn: u32) {
    if !s.conns.contains(conn) || s.conns.at(conn).busy || !s.conns.at(conn).known {
        return
    }
    let until = s.conns.at(conn).until
    if until != 0 && now(s) >= until && s.conns.at(conn).reader.held() > 0 {
        // What tailscale said of this caller is a minute old: it's asked again first.
        s.conns.at_mut(conn).known = false
        return identify(mut s, conn)
    }
    if s.conns.at(conn).who.is_none() {
        // A caller forge can't name: refused, whatever it asks.
        s.conns.at_mut(conn).closing = true
        s.conns.at_mut(conn).busy = true
        let peer = s.conns.at(conn).peer.clone()
        return reply(
            mut s,
            conn,
            403,
            "text/plain",
            bytes::of_str(
                f"forge serves the machine itself and callers tailscale names; not {peer}\n".as_str(),
            ),
        )
    }
    let got = s.conns.at_mut(conn).reader.next()
    match take got {
        Read::Wait => {},
        Read::Bad { status, why } => {
            s.conns.at_mut(conn).closing = true
            s.conns.at_mut(conn).busy = true
            reply(mut s, conn, status, "text/plain", bytes::of_str(why.as_str()))
        },
        Read::Got(req) => {
            s.conns.at_mut(conn).busy = true
            if req.closes() {
                s.conns.at_mut(conn).closing = true
            }
            if s.phase == Phase::Replica {
                return replicate::route(mut s, conn, take req)
            }
            if s.fencing {
                return reply(
                    mut s,
                    conn,
                    503,
                    "text/plain",
                    bytes::of_str("forge was fenced by a newer epoch: ask its new service\n"),
                )
            }
            if s.phase != Phase::Ready {
                return reply(mut s, conn, 503, "text/plain", bytes::of_str("forge is starting"))
            }
            route(mut s, conn, take req)
        },
    }
}

fn route(s: mut Service, conn: u32, req: take Request) {
    let method = req.method.as_str()
    let path = req.path.as_str()
    if method == "GET" && path == "/health" {
        return reply(mut s, conn, 200, "text/plain", bytes::of_str("ok\n"))
    }
    if method == "GET" && path == "/api/watch" {
        return rooms::watch(
            mut s,
            conn,
            req.param("room").as_str(),
            req.param("from").as_str(),
            lines: req.param("lines").as_str() == "1",
        )
    }
    if method == "GET" && path == "/studio" {
        return rooms::studio(mut s, conn, req.param("after").as_str())
    }
    if method == "GET" && path == "/" {
        let page = digest::page(s.core, now(s))
        return reply(mut s, conn, 200, "text/html; charset=utf-8", bytes::of_str(page.as_str()))
    }
    if method == "POST" && path == "/api/call" {
        return call(
            mut s,
            Parked { conn, body: take req.body, waiting: Vec::new(), rounds: 0 },
        )
    }
    if method == "GET" && path.starts_with("/api/object/") {
        return get_object(mut s, conn, path.slice(from: 12, to: path.len()))
    }
    let ctx = ctx_of(s, conn)
    if method == "POST" && path == "/api/object" {
        if !allowed(mut s, conn, ctx.writes, "only writers store blobs") {
            return
        }
        let o = object::blob(req.body)
        let id = o.id
        let r = Reply {
            conn,
            status: 200,
            kind: "text/plain",
            body: bytes::of_str(id.hex().as_str()),
        }
        return commit(
            mut s,
            Durable { objects: Vec::from([take o]), events: Vec::new() },
            Some(take r),
        )
    }
    if method == "POST" && path == "/api/import" {
        if !allowed(mut s, conn, ctx.lands, "only a lander imports") {
            return
        }
        return import::start(mut s, conn, req.body)
    }
    if method == "POST" && path == "/api/stop" {
        if !allowed(mut s, conn, ctx.lands, "only a lander stops forge") {
            return
        }
        print("forge: stopping")
        reply(mut s, conn, 200, "text/plain", bytes::of_str("stopping\n"))
        host::exit(0)
        s.phase = Phase::Stopped
        return
    }
    if (path == "/api/log" || path.starts_with("/api/work")) &&
        !allowed(mut s, conn, ctx.fleet, "only the fleet (--fleet) works and replicates") {
        return
    }
    if method == "GET" && path == "/api/position" {
        let p = peers::Position {
            role: String::from("service"),
            machine: s.machine.clone(),
            epoch: s.core.state.epoch,
            size: durable(s),
            chain: chain_of(s),
        }
        return reply(mut s, conn, 200, "application/json", bytes::of_str(peers::json(p).as_str()))
    }
    if method == "POST" && path == "/api/fence" {
        if !allowed(mut s, conn, ctx.lands || ctx.fleet, "only a lander or the fleet fences") {
            return
        }
        let epoch = fence_epoch(req.body)
        if epoch <= s.core.state.epoch {
            return reply(mut s, conn, 200, "application/json", bytes::of_str("{\"fenced\":false}"))
        }
        // Answered once the fence is durable, and nothing is confirmed after it.
        let r = Reply {
            conn,
            status: 200,
            kind: "application/json",
            body: bytes::of_str("{\"fenced\":true}"),
        }
        return fence(mut s, epoch, Some(take r))
    }
    if method == "GET" && path == "/api/log" {
        let from = bytes::parse_u64(req.param("from").as_str()).unwrap_or(0)
        let epoch = bytes::parse_u64(req.param("epoch").as_str()).unwrap_or(0)
        return replicate::log_from(
            mut s,
            conn,
            from,
            req.param("chain").as_str(),
            epoch,
            req.param("replica").as_str(),
        )
    }
    if method == "POST" && path == "/api/objects" {
        return replicate::objects(mut s, conn, req.body)
    }
    if path.starts_with("/api/work") {
        return jobs::remote(mut s, conn, take req)
    }
    reply(
        mut s,
        conn,
        404,
        "text/plain",
        bytes::of_str(f"forge has nothing at {method} {path}\n".as_str()),
    )
}

/// The epoch a fence's body names; 0 if it names none.
pub fn fence_epoch(body: [u8]) -> u64 {
    match Doc::read(body) {
        Ok(doc) => match doc.get(doc.root, "epoch") {
            Some(v) => doc.whole64(v).unwrap_or(0),
            None => 0,
        },
        Err(_) => 0,
    }
}

/// The machine a fence's body names as its candidate; empty if it names none.
pub fn fence_machine(body: [u8]) -> String {
    match Doc::read(body) {
        Ok(doc) => doc.field(doc.root, "machine").to_string(),
        Err(_) => String::new(),
    }
}

/// Whether a worker or a replica named `name` may be the caller's: the machine itself names its
/// own as it likes; another names its for its node, `NODE` or `NODE/...`.
pub fn names_its_own(ctx: Ctx, name: str) -> bool {
    let node = ctx.node.as_str()
    ctx.who.as_str() == "local" ||
        name == node ||
        (name.starts_with(node) && name.len() > node.len() && name.byte(node.len()) == 47)
}

fn get_object(s: mut Service, conn: u32, hex: str) {
    let Some(id) = Id::parse(hex) else {
        return reply(
            mut s,
            conn,
            400,
            "text/plain",
            bytes::of_str("an object's id is 64 hex digits\n"),
        )
    }
    match s.core.blobs.get(id) {
        Some(b) => reply(mut s, conn, 200, "application/octet-stream", b),
        None => {
            if s.missing.contains(id) {
                return reply(mut s, conn, 404, "text/plain", bytes::of_str("no such object\n"))
            }
            let _ = load(mut s, id)
            // Answered once it's loaded: an API call that reads it.
            var body = String::from("{\"tool\":\"object\",\"args\":{\"id\":\"")
            body.push_str(hex)
            body.push_str("\"}}")
            s.parked.push(
                Parked {
                    conn,
                    body: bytes::of_str(body.as_str()),
                    waiting: Vec::from([id]),
                    rounds: 0,
                },
            )
        },
    }
}

/// Who calls on connection `conn`, and what they may do (F22).
pub fn ctx_of(s: Service, conn: u32) -> Ctx {
    let found = if s.conns.contains(conn) { s.conns.at(conn).who.clone() } else { None }
    let Some(w) = found else {
        return Ctx {
            who: String::from("unknown"),
            node: String::new(),
            now: now(s),
            writes: false,
            lands: false,
            fleet: false,
        }
    }
    let writes = match s.writers {
        Some(rules) => who::named(w.clone(), rules),
        None => true,
    }
    Ctx {
        who: who::name(w.clone()),
        node: if w.local { s.machine.clone() } else { w.node.clone() },
        now: now(s),
        writes,
        lands: who::named(w.clone(), s.landers),
        fleet: who::named(w, s.fleet),
    }
}

/// Learns who calls on connection `conn`, from its peer's address: the machine itself, a
/// tailnet caller tailscale names (asked once a minute at most), or a caller refused (F28).
fn identify(s: mut Service, conn: u32) {
    let addr = who::addr_of(s.conns.at(conn).peer.as_str())
    if who::is_loopback(addr.as_str()) {
        return known_as(mut s, conn, Some(who::local(addr.as_str())))
    }
    if !who::is_tailnet(addr.as_str()) {
        return known_as(mut s, conn, None)
    }
    if s.known.contains(addr.clone()) {
        let (w, until) = s.known.at(addr.clone()).clone()
        if now(s) < until {
            return known_as(mut s, conn, Some(take w))
        }
    }
    let r = host::Run {
        tag: 0,
        argv: Vec::from(
            [s.whois.clone(), String::from("whois"), String::from("--json"), addr.clone()],
        ),
        cwd: DATA.to_string(),
        env: Vec::new(),
        limit_ms: 10000,
        cap: 1048576,
        stdin: Vec::new(),
    }
    wait(mut s, host::run(r), For::Whois(conn, take addr))
}

fn whois_said(s: mut Service, conn: u32, addr: str, r: take Result<Vec<u8>, IoError>) {
    var w: Option<who::Who> = None
    match take r {
        Ok(b) => match host::ran_of(take b) {
            Some(x) => {
                if x.ok() {
                    w = who::of_whois(addr, x.stdout)
                }
                if w.is_none() {
                    print(f"forge: tailscale doesn't name {addr}; refusing it")
                }
            },
            None => print("forge: the whois answer is malformed"),
        },
        Err(e) => print(f"forge: whois didn't run: {e.message()}"),
    }
    if let Some(x) = w.clone() {
        let _ = s.known.insert(addr.to_string(), (take x, now(s) + 60000))
    }
    if s.conns.contains(conn) {
        known_as(mut s, conn, take w)
    }
}

fn known_as(s: mut Service, conn: u32, w: take Option<who::Who>) {
    let until = match w {
        Some(x) => if x.local { 0 } else { now(s) + 60000 },
        None => 0,
    }
    s.conns.at_mut(conn).who = take w
    s.conns.at_mut(conn).until = until
    s.conns.at_mut(conn).known = true
    next_request(mut s, conn)
}

/// Answers `conn` with 403 unless its caller may do what `may` says; whether it may.
fn allowed(s: mut Service, conn: u32, may: bool, what: str) -> bool {
    if !may {
        reply(mut s, conn, 403, "text/plain", bytes::of_str(f"{what}\n".as_str()))
    }
    may
}

/// Makes a tool call, or parks it until what it needs is loaded.
fn call(s: mut Service, p: take Parked) {
    retry(mut s, take p)
}

fn retry(s: mut Service, p: take Parked) {
    let doc = match Doc::read(p.body) {
        Ok(d) => take d,
        Err(_) => {
            return reply(
                mut s,
                p.conn,
                400,
                "application/json",
                bytes::of_str("{\"error\":\"the body isn't JSON\"}"),
            )
        },
    }
    let ctx = ctx_of(s, p.conn)
    let (name, args) = {
        let Some(args) = doc.get(doc.root, "args") else {
            return reply(
                mut s,
                p.conn,
                400,
                "application/json",
                bytes::of_str("{\"error\":\"give `tool` and `args`\"}"),
            )
        }
        (doc.field(doc.root, "tool").to_string(), args)
    }
    let outcome = if name.as_str() == "object" {
        object_tool(s, doc, args)
    } else {
        core::call(s.core, ctx, name.as_str(), doc, args)
    }
    match take outcome {
        Outcome::Need(ids) => {
            if p.rounds >= 64 {
                return reply(
                    mut s,
                    p.conn,
                    500,
                    "application/json",
                    bytes::of_str("{\"error\":\"the call kept needing more objects\"}"),
                )
            }
            var waiting: Vec<Id> = Vec::new()
            for id in ids {
                if s.missing.contains(id) {
                    return reply(
                        mut s,
                        p.conn,
                        500,
                        "application/json",
                        bytes::of_str("{\"error\":\"an object forge needs is missing\"}"),
                    )
                }
                let _ = load(mut s, id)
                if !s.core.blobs.contains(id) {
                    waiting.push(id)
                }
            }
            s.parked.push(
                Parked {
                    conn: p.conn,
                    body: p.body.clone(),
                    waiting,
                    rounds: p.rounds + 1,
                },
            )
        },
        Outcome::Done { json, error, durable } => {
            let (status, kind, body) = if name.as_str() == "object" && !error {
                (200, "application/octet-stream", raw_object(s, json.as_str()))
            } else {
                (if error { 422 } else { 200 }, "application/json", bytes::of_str(json.as_str()))
            }
            if durable.objects.is_empty() &&
                durable.events.is_empty() &&
                s.flushed() &&
                s.awaiting.is_empty() {
                reply(mut s, p.conn, status, kind, body)
            } else {
                // An answer waits for what came before it to be durable (and held by the
                // replicas), so it never says what a crash could undo.
                commit(mut s, take durable, Some(Reply { conn: p.conn, status, kind, body }))
            }
        },
    }
}

/// The `object` call that a GET of an object parks as: the object's id, once it's in memory.
fn object_tool(s: Service, doc: Doc, args: u32) -> Outcome {
    let Some(id) = Id::parse(doc.field(args, "id")) else {
        return core::fail("an object's id is 64 hex digits")
    }
    if s.core.blobs.contains(id) {
        Outcome::Done {
            json: id.hex(),
            error: false,
            durable: Durable { objects: Vec::new(), events: Vec::new() },
        }
    } else {
        Outcome::Need(Vec::from([id]))
    }
}

fn raw_object(s: Service, hex: str) -> Vec<u8> {
    match Id::parse(hex) {
        Some(id) => s.core.blobs.get(id).unwrap_or(Vec::new()),
        None => Vec::new(),
    }
}

impl Service {
    /// Whether object `id` couldn't be loaded.
    pub fn missing_has(self, id: Id) -> bool {
        self.missing.contains(id)
    }
}

/// Whether object `id` is loading.
pub fn loading(s: Service, id: Id) -> bool {
    s.loading.contains(id)
}
