// forge as a command: one call to a forge service, its answer printed.
//
//     forge serve [--listen ADDR] [--machine NAME] [--landers IP,...]   run the service
//     forge <tool> [key=value...] [--server ADDR]                      call a tool: open, read, ...
//     forge call <tool> '<json>' [--server ADDR]                       call a tool with JSON arguments
//     forge import <git-dir> [ref] [--server ADDR]                     import a repository's history
//
// A value that is all digits is a number, `true` and `false` are booleans, and anything else is
// text. The service is at 127.0.0.1:7171 unless `--server` says otherwise.

use out::Json
use platform::service as host
use service::Service

const USAGE: Text = "usage:\n  forge serve [--listen ADDR] [--machine NAME] [--landers IP,...] [--no-worker]\n  forge work --server ADDR --machine NAME [--jobs N]\n  forge <tool> [key=value...] [--server ADDR]   (tools: open changes read list search write edit remove move status diff snap check job submit close log land)\n  forge call <tool> '<json arguments>' [--server ADDR]\n  forge import <git-dir> [ref] [--server ADDR]\n"

fn done(s: mut Service, code: u32, text: str) {
    if code == 0 {
        host::stdout(bytes::of_str(text))
    } else {
        host::stderr(bytes::of_str(text))
    }
    host::exit(code)
    s.phase = service::Phase::Stopped
}

fn is_digits(t: str) -> bool {
    if t.is_empty() || t.len() > 18 {
        return false
    }
    for i in 0..t.len() {
        if t.byte(i) < 48 || t.byte(i) > 57 {
            return false
        }
    }
    true
}

/// The call the arguments ask for: its path and body.
fn request(args: [String]) -> Result<(Text, String), String> {
    let tool = args[0].as_str()
    if tool == "import" {
        if args.len() < 2 {
            return Err(String::from("forge import <git-dir> [ref]"))
        }
        var j = Json::new()
        j.obj()
        j.kstr("git", args[1].as_str())
        if args.len() > 2 && !args[2].as_str().starts_with("--") {
            j.kstr("ref", args[2].as_str())
        }
        j.end_obj()
        return Ok(("/api/import", take j.text))
    }
    if tool == "call" {
        if args.len() < 3 {
            return Err(String::from("forge call <tool> '<json>'"))
        }
        return Ok(("/api/call", f"{{\"tool\":\"{args[1]}\",\"args\":{args[2]}}}"))
    }
    var j = Json::new()
    j.obj()
    j.kstr("tool", tool)
    j.key("args")
    j.obj()
    var i = 1
    while i < args.len() {
        let a = args[i].as_str()
        if a == "--server" {
            i += 2
            continue
        }
        let Some(eq) = a.find("=") else { return Err(f"`{a}` isn't key=value") }
        let key = a.slice(from: 0, to: eq)
        let value = a.slice(from: eq + 1, to: a.len())
        j.key(key)
        if is_digits(value) {
            j.raw(value)
        } else if value == "true" || value == "false" {
            j.raw(value)
        } else {
            j.str(value)
        }
        i += 1
    }
    j.end_obj()
    j.end_obj()
    Ok(("/api/call", take j.text))
}

/// The service's address: `--server`, or forge's usual one.
pub fn server_of(args: [String]) -> String {
    for i in 0..args.len() {
        if args[i].as_str() == "--server" && i + 1 < args.len() {
            return args[i + 1].clone()
        }
    }
    String::from("127.0.0.1:7171")
}

pub fn start(s: mut Service) {
    if s.args.is_empty() || s.args[0].as_str() == "help" || s.args[0].as_str() == "--help" {
        return done(mut s, 0, USAGE)
    }
    let (path, body) = match request(s.args) {
        Ok(x) => take x,
        Err(why) => return done(mut s, 2, f"forge: {why}\n{USAGE}".as_str()),
    }
    s.calls = calls::calls(server_of(s.args).as_str())
    calls::call(mut s, "POST", path, "application/json", bytes::of_str(body.as_str()), 1)
}

/// The call's answer: printed, and the command's status.
pub fn got(s: mut Service, status: u32, body: take Vec<u8>) {
    var text = bytes::text_of(body)
    text.push_str("\n")
    if status == 0 {
        return done(mut s, 1, f"forge: {text}".as_str())
    }
    done(mut s, if status < 400 { 0 } else { 1 }, text.as_str())
}

@test
fn a_commands_arguments_become_a_tool_call() {
    let args = Vec::from(
        [
            String::from("read"),
            String::from("change=c3"),
            String::from("path=a b.txt"),
            String::from("from=10"),
            String::from("--server"),
            String::from("h:1"),
        ],
    )
    let Ok((path, body)) = request(args) else { panic("a request") }
    assert(path == "/api/call", "a call")
    assert(
        body.as_str() ==
            "{\"tool\":\"read\",\"args\":{\"change\":\"c3\",\"path\":\"a b.txt\",\"from\":10}}",
        body.as_str(),
    )
    let Ok((ipath, ibody)) = request(
        Vec::from([String::from("import"), String::from("/repo")]),
    ) else { panic("an import") }
    assert(ipath == "/api/import" && ibody.as_str() == "{\"git\":\"/repo\"}", ibody.as_str())
}
