// forge: wrela's own version control and check service (spec/forge.md), run by the service host:
//
//     wrela-service forge/build --root data=DIR --root work=DIR -- serve [--listen ADDR] ...
//
// `data` holds the store, and `work` is the checkout its worker runs checks in. The same build is
// forge's command (client.wrela): `forge <tool> key=value...` calls a running service.

use service::Service

pub fn serve_init() -> Service {
    service::new()
}

pub fn serve(s: mut Service, time: f32) {
    service::step(mut s, time)
}
