use compute_new_balance from domain/ledger

fn compute_projected_balance(current_balance: Integer, incoming_credit: Integer) -> Integer {
    if incoming_credit <= 0 {
        return current_balance

    }
    projected_balance = compute_new_balance(
        current_balance=current_balance,
        delta=incoming_credit
    )
    if projected_balance < 0 {
        return current_balance
    }
    return projected_balance
}
