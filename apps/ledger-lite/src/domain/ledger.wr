to try_to_validate_positive_amount(amount: Integer) -> Result[Nothing]:
    if amount > 0:
        return nothing
    return error "amount must be positive"

to try_to_validate_non_negative_balance(balance: Integer) -> Result[Nothing]:
    if balance >= 0:
        return nothing
    return error "balance must be non-negative"

to compute_new_balance(current_balance: Integer, delta: Integer) -> Integer:
    return current_balance + delta
