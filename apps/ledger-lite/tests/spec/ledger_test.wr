use compute_projected_balance from application/service
use {
    compute_new_balance,
    try_to_validate_non_negative_balance,
    try_to_validate_positive_amount
}
from domain/ledger

fn test_compute_projected_balance_adds_credit() -> Nothing {
    updated_balance = compute_projected_balance(current_balance=10, incoming_credit=5)
    boundary_credit_balance = compute_projected_balance(current_balance=10, incoming_credit=1)
    assert value updated_balance == 15
    assert value boundary_credit_balance == 11

}
fn test_compute_projected_balance_rejects_non_positive_credit() -> Nothing {
    unchanged_for_zero = compute_projected_balance(current_balance=10, incoming_credit=0)
    unchanged_for_negative = compute_projected_balance(current_balance=10, incoming_credit=-3)
    assert value unchanged_for_zero == 10
    assert value unchanged_for_negative == 10

}
fn test_compute_projected_balance_rejects_negative_projection() -> Nothing {
    unchanged_balance = compute_projected_balance(current_balance=-5, incoming_credit=1)
    zero_boundary_balance = compute_projected_balance(current_balance=-1, incoming_credit=1)
    assert value unchanged_balance == -5
    assert value zero_boundary_balance == 0

}
fn test_positive_amount_validation() -> Nothing {
    boundary_positive = try_to_validate_positive_amount(1)
    match boundary_positive {
        Ok(_) {
            assert value true == true
        }
        Err(_) {
            assert value true == false
        }
        default {
            assert value true == false

        }
    }
    positive_result = try_to_validate_positive_amount(9)
    match positive_result {
        Ok(_) {
            assert value true == true
        }
        Err(_) {
            assert value true == false
        }
        default {
            assert value true == false

        }
    }
    negative_result = try_to_validate_positive_amount(-1)
    match negative_result {
        Ok(_) {
            assert value true == false
        }
        Err(_) {
            assert value true == true
        }
        default {
            assert value true == false

        }
    }
}
fn test_compute_new_balance_and_floor_check() -> Nothing {
    projected_balance = compute_new_balance(current_balance=5, delta=3)
    assert value projected_balance == 8

    floor_boundary_result = try_to_validate_non_negative_balance(0)
    match floor_boundary_result {
        Ok(_) {
            assert value true == true
        }
        Err(_) {
            assert value true == false
        }
        default {
            assert value true == false

        }
    }
    floor_result = try_to_validate_non_negative_balance(projected_balance)
    match floor_result {
        Ok(_) {
            assert value true == true
        }
        Err(_) {
            assert value true == false
        }
        default {
            assert value true == false
        }
    }
}
