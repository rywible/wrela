use DemoRuntime from domain/browser_demo_game

render GameArcadeSurface {
    preset game_arcade_2d
    profile balanced
    target DemoScene
    shader gpu GameArcadeSurface_shader
    overrides {
        0 { aa = 1 }
        1 { aa = 2 }
        2 { aa = 3 }
    }
}

gpu fn GameArcadeSurface_shader() -> String {
    return "const MAX_COLLECTIBLES: u32 = 32u;\n\nstruct FrameUniform \{\n    canvas_world: vec4<f32>,\n    player: vec4<f32>,\n    ui: vec4<u32>,\n    collectibles: array<vec4<f32>, MAX_COLLECTIBLES>,\n\};\n\n@group(0) @binding(0)\nvar<uniform> frame: FrameUniform;\n\n@vertex\nfn vs_main(@builtin(vertex_index) vertex_index: u32) -> @builtin(position) vec4<f32> \{\n    var positions = array<vec2<f32>, 3>(\n        vec2<f32>(-1.0, -1.0),\n        vec2<f32>(3.0, -1.0),\n        vec2<f32>(-1.0, 3.0),\n    );\n    return vec4<f32>(positions[vertex_index], 0.0, 1.0);\n\}\n\n@fragment\nfn fs_main(@builtin(position) frag_pos: vec4<f32>) -> @location(0) vec4<f32> \{\n    let canvas = max(frame.canvas_world.xy, vec2<f32>(1.0, 1.0));\n    let world = max(frame.canvas_world.zw, vec2<f32>(1.0, 1.0));\n    let player_screen = vec2<f32>(\n        frame.player.x / world.x * canvas.x,\n        frame.player.y / world.y * canvas.y,\n    );\n    let delta = abs(frag_pos.xy - player_screen);\n    if (delta.x <= 8.0 && delta.y <= 8.0) \{\n        return vec4<f32>(0.0, 0.92, 1.0, 1.0);\n    \}\n    return vec4<f32>(0.05, 0.12, 0.22, 1.0);\n\}\n"
}

node DemoScene profile canvas {
    mutable scene_name: String = "wr-demo"
    mutable player_x: Integer = 0
    mutable player_y: Integer = 0
    mutable score: Integer = 0
    mutable remaining_pickups: Integer = 3
    mutable victory_state: Boolean = false
    mutable status_code: String = "running"
}

node DemoHud profile ui {
    mutable node_key: String = "hud"
    mutable text: String = "score: 0"
    mutable score: Integer = 0
    mutable restart_count: Integer = 0
}

fn compute_status_code(runtime: DemoRuntime) -> String {
    if runtime.victory_state {
        return "victory"
    }
    return "running"
}

view create_demo_scene(runtime: DemoRuntime) -> DemoScene {
    return DemoScene(
        scene_name="wr-demo",
        player_x=runtime.player_x,
        player_y=runtime.player_y,
        score=runtime.score,
        remaining_pickups=3 - runtime.score,
        victory_state=runtime.victory_state,
        status_code=compute_status_code(runtime=runtime)
    )
}

view create_demo_hud(runtime: DemoRuntime) -> DemoHud {
    return DemoHud(
        node_key="hud",
        text="score",
        score=runtime.score,
        restart_count=runtime.restart_count
    )
}

anim compute_banner_pulse(tick: Integer) -> Integer {
    phase = tick % 20
    if phase <= 10 {
        return phase
    }
    return 20 - phase
}
