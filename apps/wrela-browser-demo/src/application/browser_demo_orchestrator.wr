use {
    DemoRuntime,
    create_demo_runtime_after_step,
    create_demo_input
}
from domain/browser_demo_game

fn create_runtime_after_steps(
    runtime: DemoRuntime,
    axis_x: Integer,
    axis_y: Integer,
    steps_remaining: Integer
) -> DemoRuntime {
    if steps_remaining <= 0 {
        return runtime
    }

    input_event = create_demo_input(
        axis_x=axis_x,
        axis_y=axis_y,
        is_restart_pressed=false
    )
    stepped_runtime = create_demo_runtime_after_step(runtime=runtime, input_event=input_event)

    return create_runtime_after_steps(
        runtime=stepped_runtime,
        axis_x=axis_x,
        axis_y=axis_y,
        steps_remaining=steps_remaining - 1
    )
}

fn create_victory_demo_runtime(runtime: DemoRuntime) -> DemoRuntime {
    mutable next_runtime = runtime

    next_runtime = create_runtime_after_steps(
        runtime=next_runtime,
        axis_x=1,
        axis_y=0,
        steps_remaining=3
    )
    next_runtime = create_runtime_after_steps(
        runtime=next_runtime,
        axis_x=0,
        axis_y=1,
        steps_remaining=3
    )
    next_runtime = create_runtime_after_steps(
        runtime=next_runtime,
        axis_x=1,
        axis_y=0,
        steps_remaining=8
    )
    next_runtime = create_runtime_after_steps(
        runtime=next_runtime,
        axis_x=0,
        axis_y=1,
        steps_remaining=2
    )
    next_runtime = create_runtime_after_steps(
        runtime=next_runtime,
        axis_x=1,
        axis_y=0,
        steps_remaining=6
    )
    next_runtime = create_runtime_after_steps(
        runtime=next_runtime,
        axis_x=0,
        axis_y=1,
        steps_remaining=6
    )

    return next_runtime
}

fn create_restarted_demo_runtime(runtime: DemoRuntime) -> DemoRuntime {
    paused_runtime = create_runtime_after_steps(runtime=runtime, axis_x=0, axis_y=0, steps_remaining=4)
    restart_event = create_demo_input(
        axis_x=0,
        axis_y=0,
        is_restart_pressed=true
    )
    return create_demo_runtime_after_step(runtime=paused_runtime, input_event=restart_event)
}
