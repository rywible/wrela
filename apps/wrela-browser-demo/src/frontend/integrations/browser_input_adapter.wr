use {
    DemoInput,
    DemoRuntime,
    create_demo_input
}
from domain/browser_demo_game

use DemoScene from presentation/browser_demo_surface

fn compute_planned_axis_x(tick: Integer) -> Integer {
    if tick < 3 {
        return 1
    }
    if tick < 6 {
        return 0
    }
    if tick < 14 {
        return 1
    }
    if tick < 16 {
        return 0
    }
    if tick < 22 {
        return 1
    }
    return 0
}

fn compute_planned_axis_y(tick: Integer) -> Integer {
    if tick < 3 {
        return 0
    }
    if tick < 6 {
        return 1
    }
    if tick < 14 {
        return 0
    }
    if tick < 16 {
        return 1
    }
    if tick < 22 {
        return 0
    }
    if tick < 28 {
        return 1
    }
    return 0
}

fn is_restart_ready(runtime: DemoRuntime) -> Boolean {
    if runtime.victory_state {
        return runtime.tick >= 30
    }
    return false
}

fn create_planned_demo_input(runtime: DemoRuntime) -> DemoInput {
    return create_demo_input(
        axis_x=compute_planned_axis_x(runtime.tick),
        axis_y=compute_planned_axis_y(runtime.tick),
        is_restart_pressed=is_restart_ready(runtime=runtime)
    )
}

fn map_scene_to_status(scene_state: DemoScene) -> String {
    if scene_state.victory_state {
        return "victory"
    }
    return "running"
}
