use * from domain/intent_policy

to test_role_operation_matrix() -> Nothing:
    assert value role_may_perform_intent_operation(
        role=Role.Reader(),
        operation=IntentOperation.CreateIntent()
    ) == false

    assert value role_may_perform_intent_operation(
        role=Role.Proposer(),
        operation=IntentOperation.CreateIntent()
    ) == true

    assert value role_may_perform_intent_operation(
        role=Role.Shaper(),
        operation=IntentOperation.EditIntent()
    ) == true

    assert value role_may_perform_intent_operation(
        role=Role.Reviewer(),
        operation=IntentOperation.AdvanceIntent()
    ) == true

    assert value role_may_perform_intent_operation(
        role=Role.Reviewer(),
        operation=IntentOperation.EndorseIntent()
    ) == false

    assert value role_may_perform_intent_operation(
        role=Role.Steward(),
        operation=IntentOperation.EndorseIntent()
    ) == true

    assert value role_may_perform_intent_operation(
        role=Role.BDFL(),
        operation=IntentOperation.BlockIntent()
    ) == true


to test_contribution_matrix() -> Nothing:
    assert value role_may_submit_contribution(
        role=Role.Observer(),
        contribution=ContributionType.Clarification()
    ) == true

    assert value role_may_submit_contribution(
        role=Role.Observer(),
        contribution=ContributionType.Counterargument()
    ) == false

    assert value role_may_submit_contribution(
        role=Role.Proposer(),
        contribution=ContributionType.Constraint()
    ) == true

    assert value role_may_submit_contribution(
        role=Role.Proposer(),
        contribution=ContributionType.Conflict()
    ) == false

    assert value role_may_submit_contribution(
        role=Role.Shaper(),
        contribution=ContributionType.Conflict()
    ) == true

    assert value role_may_submit_contribution(
        role=Role.BDFL(),
        contribution=ContributionType.EscalationRequest()
    ) == true


to test_contribution_operation_alignment() -> Nothing:
    assert value contribution_is_valid_for_operation(
        contribution=ContributionType.Conflict(),
        operation=IntentOperation.BlockIntent()
    ) == true

    assert value contribution_is_valid_for_operation(
        contribution=ContributionType.Constraint(),
        operation=IntentOperation.BlockIntent()
    ) == false

    assert value contribution_is_valid_for_operation(
        contribution=ContributionType.Counterargument(),
        operation=IntentOperation.AdvanceIntent()
    ) == true

    assert value contribution_is_valid_for_operation(
        contribution=ContributionType.EscalationRequest(),
        operation=IntentOperation.AdvanceIntent()
    ) == false
