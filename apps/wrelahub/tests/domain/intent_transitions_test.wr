use * from domain/intent

to test_valid_transitions_sequential() -> Nothing:
    capture r1 = transition(current=IntentState.Seed(), target=IntentState.Sharpening(), reason="clarify scope")
    match r1:
        Ok(s):
            match s:
                IntentState.Sharpening(): assert value true == true
                otherwise: assert value false == true
        Err(_): assert value false == true
        otherwise: assert value false == true

    capture r2 = transition(current=IntentState.Sharpening(), target=IntentState.StressTested(), reason="added counterexamples")
    match r2:
        Ok(s):
            match s:
                IntentState.StressTested(): assert value true == true
                otherwise: assert value false == true
        Err(_): assert value false == true
        otherwise: assert value false == true

    capture r3 = transition(current=IntentState.StressTested(), target=IntentState.Endorsed(), reason="resolved objections")
    match r3:
        Ok(s):
            match s:
                IntentState.Endorsed(): assert value true == true
                otherwise: assert value false == true
        Err(_): assert value false == true
        otherwise: assert value false == true

    capture r4 = transition(current=IntentState.Endorsed(), target=IntentState.Realized(), reason="implemented and shipped")
    match r4:
        Ok(s):
            match s:
                IntentState.Realized(): assert value true == true
                otherwise: assert value false == true
        Err(_): assert value false == true
        otherwise: assert value false == true

to test_valid_transition_to_archived_from_any() -> Nothing:
    states = [
        IntentState.Seed(),
        IntentState.Sharpening(),
        IntentState.StressTested(),
        IntentState.Endorsed(),
        IntentState.Realized()
    ]
    for s in states:
        capture r = transition(current=s, target=IntentState.Archived(), reason="no longer relevant")
        match r:
            Ok(out):
                match out:
                    IntentState.Archived(): assert value true == true
                    otherwise: assert value false == true
            Err(_): assert value false == true
            otherwise: assert value false == true

to test_invalid_transitions_rejected() -> Nothing:
    capture bad = transition(current=IntentState.Seed(), target=IntentState.Endorsed(), reason="skip ahead lol")
    match bad:
        Ok(_): assert value false == true
        Err(_): assert value true == true
        otherwise: assert value false == true

    capture bad2 = transition(current=IntentState.Archived(), target=IntentState.Seed(), reason="revive")
    match bad2:
        Ok(_): assert value false == true
        Err(_): assert value true == true
        otherwise: assert value false == true

to test_missing_reason_rejected() -> Nothing:
    capture bad = transition(current=IntentState.Seed(), target=IntentState.Sharpening(), reason="")
    match bad:
        Ok(_): assert value false == true
        Err(_): assert value true == true
        otherwise: assert value false == true
