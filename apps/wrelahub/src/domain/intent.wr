An IntentState is either:
    Seed
    Sharpening
    StressTested
    Endorsed
    Archived
    Realized


An Intent:
    has:
        id: String
        state: IntentState
        problem: String
        impact: String
        constraints: String
        non_goals: String
        success_criteria: String


An IntentTransitionError is either:
    MissingReason
    InvalidTransition(from_state: IntentState, to_state: IntentState, why: String)

to transition(
    current_state: IntentState,
    target_state: IntentState,
    transition_reason: String
) -> Result[IntentState, IntentTransitionError]:
    if transition_reason == "":
        return error IntentTransitionError.MissingReason

    match current_state:
        IntentState.Seed:
            match target_state:
                IntentState.Sharpening: return target_state
                IntentState.Archived: return target_state
                otherwise:
                    return error IntentTransitionError.InvalidTransition(
                        from_state=current_state,
                        to_state=target_state,
                        why="Seed may only transition to Sharpening or Archived"
                    )
        IntentState.Sharpening:
            match target_state:
                IntentState.StressTested: return target_state
                IntentState.Archived: return target_state
                otherwise:
                    return error IntentTransitionError.InvalidTransition(
                        from_state=current_state,
                        to_state=target_state,
                        why="Sharpening may only transition to StressTested or Archived"
                    )
        IntentState.StressTested:
            match target_state:
                IntentState.Endorsed: return target_state
                IntentState.Archived: return target_state
                otherwise:
                    return error IntentTransitionError.InvalidTransition(
                        from_state=current_state,
                        to_state=target_state,
                        why="StressTested may only transition to Endorsed or Archived"
                    )
        IntentState.Endorsed:
            match target_state:
                IntentState.Realized: return target_state
                IntentState.Archived: return target_state
                otherwise:
                    return error IntentTransitionError.InvalidTransition(
                        from_state=current_state,
                        to_state=target_state,
                        why="Endorsed may only transition to Realized or Archived"
                    )
        IntentState.Archived:
            return error IntentTransitionError.InvalidTransition(
                from_state=current_state,
                to_state=target_state,
                why="Archived is terminal"
            )
        IntentState.Realized:
            match target_state:
                IntentState.Archived: return target_state
                otherwise:
                    return error IntentTransitionError.InvalidTransition(
                        from_state=current_state,
                        to_state=target_state,
                        why="Realized may only transition to Archived"
                    )
