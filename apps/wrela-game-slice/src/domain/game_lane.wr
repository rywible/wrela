fn run_render_lane_configuration() -> Nothing {
    return
}

resource CollectorRuntime {
    mutable tick: Integer = 0
    mutable score: Integer = 0
    mutable player_x: Integer = 0
    mutable player_y: Integer = 0
}

event CollectorInputEvent {
    mutable sequence: Integer = 0
    mutable axis_x: Integer = 0
    mutable axis_y: Integer = 0
    mutable pickup_signal: Boolean = false
}

theme CollectorTheme {
    mutable background: String = "#0d111c"
    mutable accent: String = "#67d5ff"
    mutable text: String = "#f6f8fb"
}

fn clamp_axis(value: Integer) -> Integer {
    if value > 1 {
        return 1
    }
    if value < -1 {
        return -1
    }
    return value
}

fn create_default_collector_runtime() -> CollectorRuntime {
    return CollectorRuntime(
        player_x=24,
        player_y=12
    )
}

fn create_default_collector_theme() -> CollectorTheme {
    return CollectorTheme()
}

fn create_collector_input_event(
    sequence: Integer,
    axis_x: Integer,
    axis_y: Integer,
    is_pickup_signal: Boolean
) -> CollectorInputEvent {
    return CollectorInputEvent(
        sequence=sequence,
        axis_x=clamp_axis(axis_x),
        axis_y=clamp_axis(axis_y),
        pickup_signal=is_pickup_signal
    )
}

system create_collector_runtime_after_step[stage=fixed, reads=[CollectorInputEvent], writes=[CollectorRuntime]](
    runtime: CollectorRuntime,
    input_event: CollectorInputEvent
) -> CollectorRuntime {
    mutable score = runtime.score
    if input_event.pickup_signal {
        score = score + 1
    }

    return CollectorRuntime(
        tick=runtime.tick + 1,
        score=score,
        player_x=runtime.player_x + input_event.axis_x,
        player_y=runtime.player_y + input_event.axis_y
    )
}

fn compute_collector_bob(tick: Integer) -> Integer {
    phase = tick % 24
    if phase <= 12 {
        return phase
    }
    return 24 - phase
}
