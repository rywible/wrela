use {
    SiteState,
    SiteTheme
}
from domain/site_lane

assets SiteSurfaceAssets {
    manifest site_surface_manifest
    streaming chunked
}

render SiteSurface {
    resources SiteSurfaceAssets
    temporal history
    quality tier balanced
    budget tags ui, pbr, temporal, "resource-contract"
    shader material site_surface_pbr_contract
}

material site_surface_pbr_contract {
    surface_model pbr
    preset ui
    textures orm "site-surface-pbr-temporal-resource-v5.orm.ktx2"
    render alpha opaque
    render double_sided false
    render receives_decals true
}

gpu fn site_surface_shader() -> String {
    return "const MAX_COLLECTIBLES: u32 = 32u;\n\nstruct FrameUniform \{\n    canvas_world: vec4<f32>,\n    player: vec4<f32>,\n    ui: vec4<u32>,\n    pbr: vec4<f32>,\n    temporal: vec4<f32>,\n    resource_contract: vec4<u32>,\n    collectibles: array<vec4<f32>, MAX_COLLECTIBLES>,\n};\n\n@group(0) @binding(0)\nvar<uniform> frame: FrameUniform;\n\nstruct VsOut \{\n    @builtin(position) position: vec4<f32>,\n};\n\n@vertex\nfn vs_main(@builtin(vertex_index) vertex_index: u32) -> VsOut \{\n    var positions = array<vec2<f32>, 3>(\n        vec2<f32>(-1.0, -1.0),\n        vec2<f32>(3.0, -1.0),\n        vec2<f32>(-1.0, 3.0),\n    );\n\n    var out: VsOut;\n    out.position = vec4<f32>(positions[vertex_index], 0.0, 1.0);\n    return out;\n\}\n\n@fragment\nfn fs_main(@builtin(position) frag_pos: vec4<f32>) -> @location(0) vec4<f32> \{\n    let canvas_size = max(frame.canvas_world.xy, vec2<f32>(1.0, 1.0));\n    let world_size = max(frame.canvas_world.zw, vec2<f32>(1.0, 1.0));\n    let temporal_jitter = frame.temporal.xy;\n    let temporal_mix = clamp(frame.temporal.z, 0.0, 1.0);\n    let pbr_roughness = clamp(frame.pbr.x, 0.04, 1.0);\n    let pbr_metallic = clamp(frame.pbr.y, 0.0, 1.0);\n    let pbr_ao = clamp(frame.pbr.z, 0.0, 1.0);\n    let exposure = max(frame.pbr.w, 0.001);\n    let contract_seed = f32(frame.resource_contract.x & 1023u) * 0.0001;\n    let world_pos = vec2<f32>(\n        (frag_pos.x + temporal_jitter.x) / canvas_size.x * world_size.x,\n        (frag_pos.y + temporal_jitter.y) / canvas_size.y * world_size.y,\n    );\n\n    var color = vec4<f32>(0.03529, 0.04706, 0.10980, 1.0);\n\n    if (frag_pos.y <= 40.0) \{\n        color = vec4<f32>(0.06274, 0.09803, 0.20000, 1.0);\n    \}\n\n    let collectible_count = min(frame.ui.x, MAX_COLLECTIBLES);\n    for (var i: u32 = 0u; i < MAX_COLLECTIBLES; i = i + 1u) \{\n        if (i >= collectible_count) \{\n            break;\n        \}\n\n        let collectible = frame.collectibles[i];\n        let half_world = vec2<f32>(\n            collectible.z / canvas_size.x * world_size.x,\n            collectible.z / canvas_size.y * world_size.y,\n        );\n        let delta = abs(world_pos - collectible.xy);\n\n        if (delta.x <= half_world.x && delta.y <= half_world.y) \{\n            let collected = (frame.ui.y & (1u << i)) != 0u;\n            if (collected) \{\n                color = mix(color, vec4<f32>(0.17254, 0.23137, 0.34901, 1.0), 0.45);\n            } else \{\n                color = vec4<f32>(0.00000, 0.84313, 1.00000, 1.0);\n            \}\n        \}\n    \}\n\n    let player_half_world = vec2<f32>(\n        frame.player.z / canvas_size.x * world_size.x,\n        frame.player.z / canvas_size.y * world_size.y,\n    );\n    let player_delta = abs(world_pos - frame.player.xy);\n\n    if (player_delta.x <= player_half_world.x && player_delta.y <= player_half_world.y) \{\n        color = vec4<f32>(0.00000, 0.84313, 1.00000, 1.0);\n    \}\n\n    let shaded = mix(color.rgb * pbr_ao, vec3<f32>(1.0, 1.0, 1.0), pbr_metallic * 0.1);\n    let tone_mapped = shaded / (shaded + vec3<f32>(exposure + pbr_roughness));\n    let stabilized = mix(color.rgb, tone_mapped, temporal_mix * 0.4) + vec3<f32>(contract_seed);\n\n    return vec4<f32>(clamp(stabilized, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);\n\}\n"
}

fn create_site_surface_schema_family() -> String {
    return "render-schema-v6+shader-bundle-v6+asset-pack-v4+world-chunk-v3"
}

node SiteScene profile canvas {
    mutable title: String = "Wrela Website Slice"
    mutable subtitle: String = "view/node lane"
    mutable click_count: Integer = 0
    mutable panel_color: String = "#0f172a"
}

node SiteWidget profile ui {
    mutable node_key: String = "hero"
    mutable kind: String = "card"
    mutable text: String = "welcome"
    mutable color: String = "#00d7ff"
    mutable badge_count: Integer = 0
}

fn create_site_scene(state: SiteState, site_theme: SiteTheme) -> SiteScene {
    return SiteScene(
        title=state.headline,
        subtitle="interactive 2d website",
        click_count=state.click_count,
        panel_color=site_theme.panel_color
    )
}

view create_site_widget(state: SiteState, site_theme: SiteTheme) -> SiteWidget {
    return SiteWidget(
        node_key="hero",
        kind="card",
        text="Welcome to the website slice",
        color=site_theme.accent_color,
        badge_count=state.click_count
    )
}
