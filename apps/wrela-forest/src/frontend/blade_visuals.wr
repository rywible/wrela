//
// Blade trail and afterimage visual configuration per resonance tier.

resource BladeTrailConfig {
    mutable trail_length: Integer = 6
    mutable opacity_milli: Integer = 600
    mutable color_r: Integer = 200
    mutable color_g: Integer = 200
    mutable color_b: Integer = 255
}

resource BladeAfterimageConfig {
    mutable count: Integer = 0
    mutable spacing_ticks: Integer = 2
    mutable opacity_milli: Integer = 300
}

fn get_resonance_trail_color_r(tier: Integer) -> Integer {
    if tier == 0 { return 200 }
    if tier == 1 { return 100 }
    if tier == 2 { return 255 }
    if tier == 3 { return 255 }
    if tier >= 4 { return 255 }
    return 200
}

fn get_resonance_trail_color_g(tier: Integer) -> Integer {
    if tier == 0 { return 200 }
    if tier == 1 { return 200 }
    if tier == 2 { return 180 }
    if tier == 3 { return 100 }
    if tier >= 4 { return 255 }
    return 200
}

fn get_resonance_trail_color_b(tier: Integer) -> Integer {
    if tier == 0 { return 255 }
    if tier == 1 { return 255 }
    if tier == 2 { return 50 }
    if tier == 3 { return 50 }
    if tier >= 4 { return 200 }
    return 255
}

fn get_trail_config_for_tier(tier: Integer) -> BladeTrailConfig {
    mutable trail_length = 6
    mutable opacity = 600
    if tier >= 1 { trail_length = 8 }
    if tier >= 2 { trail_length = 10 }
    if tier >= 3 { trail_length = 14 }
    if tier >= 4 { trail_length = 20 }
    if tier >= 2 { opacity = 800 }
    if tier >= 3 { opacity = 900 }
    if tier >= 4 { opacity = 1000 }

    return BladeTrailConfig(
        trail_length=trail_length,
        opacity_milli=opacity,
        color_r=get_resonance_trail_color_r(tier),
        color_g=get_resonance_trail_color_g(tier),
        color_b=get_resonance_trail_color_b(tier)
    )
}

fn get_afterimage_config_for_tier(tier: Integer) -> BladeAfterimageConfig {
    if tier < 2 {
        return BladeAfterimageConfig(count=0)
    }
    if tier == 2 {
        return BladeAfterimageConfig(count=1, spacing_ticks=3, opacity_milli=200)
    }
    if tier == 3 {
        return BladeAfterimageConfig(count=2, spacing_ticks=2, opacity_milli=350)
    }
    return BladeAfterimageConfig(count=3, spacing_ticks=2, opacity_milli=500)
}
