//
// Combat feel tuning: all hand-tuned hit stop, camera jolt, and screen shake values.

resource CombatFeelConfig {
    // Hit stop duration (ticks)
    mutable light_hit_stop_ticks: Integer = 3
    mutable heavy_hit_stop_ticks: Integer = 6
    mutable parry_hit_stop_ticks: Integer = 8

    // Camera jolt magnitude (milli)
    mutable light_jolt_milli: Integer = 100
    mutable heavy_jolt_milli: Integer = 250
    mutable parry_jolt_milli: Integer = 400

    // Screen shake magnitude (milli)
    mutable light_shake_milli: Integer = 50
    mutable heavy_shake_milli: Integer = 150
    mutable poise_break_shake_milli: Integer = 300
}

fn create_default_combat_feel() -> CombatFeelConfig {
    return CombatFeelConfig()
}

fn get_hit_stop_ticks(config: CombatFeelConfig, move_type: Integer) -> Integer {
    // move_type: 1=light, 2=heavy, 3=parry
    if move_type == 1 { return config.light_hit_stop_ticks }
    if move_type == 2 { return config.heavy_hit_stop_ticks }
    if move_type == 3 { return config.parry_hit_stop_ticks }
    return config.light_hit_stop_ticks
}

fn get_jolt_magnitude(config: CombatFeelConfig, move_type: Integer) -> Integer {
    if move_type == 1 { return config.light_jolt_milli }
    if move_type == 2 { return config.heavy_jolt_milli }
    if move_type == 3 { return config.parry_jolt_milli }
    return config.light_jolt_milli
}

fn get_shake_magnitude(config: CombatFeelConfig, move_type: Integer) -> Integer {
    if move_type == 1 { return config.light_shake_milli }
    if move_type == 2 { return config.heavy_shake_milli }
    return config.light_shake_milli
}
