assets ForestClearingAssets {
    manifest forest_clearing_manifest
    streaming chunked
}

render ForestClearingScene {
    resources ForestClearingAssets
    temporal reproject
    quality tier balanced
    budget tags gameplay, pbr, temporal, "resource-contract"
    shader material forest_clearing_pbr_contract
}

material forest_clearing_pbr_contract {
    surface_model pbr
    preset gameplay
    textures orm "forest-clearing-pbr-temporal-resource-v5.orm.ktx2"
    render alpha opaque
    render double_sided false
    render receives_decals true
}

gpu fn forest_clearing_shader() -> String {
    return "const MAX_COLLECTIBLES: u32 = 32u;\n\nstruct FrameUniform \{\n    canvas_world: vec4<f32>,\n    player: vec4<f32>,\n    ui: vec4<u32>,\n    collectibles: array<vec4<f32>, MAX_COLLECTIBLES>,\n\};\n\n@group(0) @binding(0)\nvar<uniform> frame: FrameUniform;\n\n@vertex\nfn vs_main(@builtin(vertex_index) vertex_index: u32) -> @builtin(position) vec4<f32> \{\n    var positions = array<vec2<f32>, 3>(\n        vec2<f32>(-1.0, -1.0),\n        vec2<f32>(3.0, -1.0),\n        vec2<f32>(-1.0, 3.0),\n    );\n    return vec4<f32>(positions[vertex_index], 0.0, 1.0);\n\}\n\nfn world_from_screen(frag_pos: vec2<f32>, canvas: vec2<f32>, world: vec2<f32>) -> vec2<f32> \{\n    return vec2<f32>(\n        frag_pos.x / canvas.x * world.x,\n        frag_pos.y / canvas.y * world.y,\n    );\n\}\n\n@fragment\nfn fs_main(@builtin(position) frag_pos: vec4<f32>) -> @location(0) vec4<f32> \{\n    let canvas = max(frame.canvas_world.xy, vec2<f32>(1.0, 1.0));\n    let world = max(frame.canvas_world.zw, vec2<f32>(1.0, 1.0));\n    let world_pos = world_from_screen(frag_pos.xy, canvas, world);\n\n    let horizon = smoothstep(0.0, 1.0, frag_pos.y / canvas.y);\n    let sky_low = vec3<f32>(0.11, 0.18, 0.26);\n    let sky_high = vec3<f32>(0.30, 0.46, 0.38);\n    let ground = vec3<f32>(0.10, 0.21, 0.14);\n    var color = mix(sky_low, sky_high, horizon);\n    color = mix(color, ground, smoothstep(0.42, 1.0, horizon));\n\n    let tiles = vec2<f32>(floor(frag_pos.x / 24.0), floor(frag_pos.y / 24.0));\n    let checker = f32((i32(tiles.x) + i32(tiles.y)) & 1);\n    color = color + vec3<f32>(0.06 * checker, 0.03 * (1.0 - checker), 0.02 * checker);\n\n    let grid_x = abs(fract(world_pos.x * 0.05) - 0.5);\n    let grid_y = abs(fract(world_pos.y * 0.05) - 0.5);\n    let underbrush = (1.0 - smoothstep(0.0, 0.48, min(grid_x, grid_y))) * 0.12;\n    color = color + vec3<f32>(0.02, underbrush, 0.01);\n\n    let player_center = frame.player.xy;\n    let player_half = vec2<f32>(\n        frame.player.z / canvas.x * world.x,\n        frame.player.z / canvas.y * world.y,\n    ) * 0.5;\n    let player_delta = abs(world_pos - player_center);\n    if (player_delta.x <= player_half.x && player_delta.y <= player_half.y) \{\n        color = vec3<f32>(0.34, 0.86, 0.98);\n    \}\n\n    let collectible_count = min(frame.ui.x, MAX_COLLECTIBLES);\n    for (var i: u32 = 0u; i < MAX_COLLECTIBLES; i = i + 1u) \{\n        if (i >= collectible_count) \{\n            break;\n        \}\n        let collectible = frame.collectibles[i];\n        let half_size = vec2<f32>(\n            collectible.z / canvas.x * world.x,\n            collectible.z / canvas.y * world.y,\n        ) * 0.5;\n        let delta = abs(world_pos - collectible.xy);\n        if (delta.x <= half_size.x && delta.y <= half_size.y) \{\n            let collected = (frame.ui.y & (1u << i)) != 0u;\n            if (collected) \{\n                color = mix(color, vec3<f32>(0.32, 0.36, 0.30), 0.45);\n            \} else \{\n                color = vec3<f32>(0.95, 0.82, 0.39);\n            \}\n        \}\n    \}\n\n    return vec4<f32>(clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);\n\}\n"
}

fn create_forest_clearing_schema_family() -> String {
    return "render-schema-v6+shader-bundle-v6+asset-pack-v4+world-chunk-v3"
}

node ForestHudNode profile ui {
    mutable node_key: String = "forest-hud"
    mutable kind: String = "bar"
    mutable health_ratio: Integer = 1000
    mutable stamina_ratio: Integer = 1000
    mutable resonance_tier: Integer = 0
    mutable resonance_charge: Integer = 0
    mutable enemy_health_ratio: Integer = 1000
}

fn create_forest_hud(
    health_ratio: Integer,
    stamina_ratio: Integer,
    resonance_tier: Integer,
    resonance_charge: Integer,
    enemy_health_ratio: Integer
) -> ForestHudNode {
    return ForestHudNode(
        node_key="forest-hud",
        kind="bar",
        health_ratio=health_ratio,
        stamina_ratio=stamina_ratio,
        resonance_tier=resonance_tier,
        resonance_charge=resonance_charge,
        enemy_health_ratio=enemy_health_ratio
    )
}
