// ============================================================================
// Game Tick Input
// ============================================================================

event GameTickInput {
    mutable move_x: Integer = 0
    mutable move_z: Integer = 0
    mutable attack_light: Boolean = false
    mutable attack_heavy: Boolean = false
    mutable dodge: Boolean = false
    mutable parry: Boolean = false
}

fn create_game_tick_input(
    move_x: Integer,
    move_z: Integer,
    attack_light: Boolean,
    attack_heavy: Boolean,
    dodge: Boolean,
    parry: Boolean
) -> GameTickInput {
    return GameTickInput(
        move_x=move_x,
        move_z=move_z,
        attack_light=attack_light,
        attack_heavy=attack_heavy,
        dodge=dodge,
        parry=parry
    )
}

fn create_empty_game_tick_input() -> GameTickInput {
    return GameTickInput()
}

// ============================================================================
// Game Tick State
// ============================================================================

class GameTickState {
    mutable world: ForestWorldState
    mutable player: CharacterState
    mutable player_stamina: StaminaState
    mutable player_health: HealthState
    mutable player_poise: PoiseState
    mutable blade: SoulBlade
    mutable resonance: ResonanceState
    mutable enemy: RotStalker
    mutable enemy_health: HealthState
    mutable enemy_poise: PoiseState
    mutable parry_state: ParryState
    mutable hit_stop: HitStopState
    mutable player_hit_memory: CombatHitMemory
    mutable enemy_hit_memory: CombatHitMemory
    mutable spring_arm: SpringArmState
    mutable camera_jolt: CameraJoltState
    mutable fov_shift: CameraFovShiftState
    mutable combat_feel: CombatFeelConfig
    mutable player_x: Integer
    mutable player_y: Integer
    mutable player_z: Integer
}

fn create_default_game_tick_state() -> GameTickState {
    return GameTickState(
        world=create_default_forest_world(),
        player=create_default_character_state(),
        player_stamina=create_default_stamina(),
        player_health=create_default_health(),
        player_poise=create_default_poise(),
        blade=create_default_soul_blade(),
        resonance=create_default_resonance(),
        enemy=create_default_rot_stalker(),
        enemy_health=create_default_health(),
        enemy_poise=create_default_poise(),
        parry_state=create_default_parry(),
        hit_stop=create_default_hit_stop(),
        player_hit_memory=create_combat_hit_memory(attacker_id=0),
        enemy_hit_memory=create_combat_hit_memory(attacker_id=1),
        spring_arm=create_default_spring_arm(),
        camera_jolt=create_default_camera_jolt(),
        fov_shift=create_default_fov_shift(),
        combat_feel=create_default_combat_feel(),
        player_x=0,
        player_y=0,
        player_z=0
    )
}

// ============================================================================
// Helper: rebuild GameTickState with updated fields
// ============================================================================

fn rebuild_state(
    world: ForestWorldState,
    player: CharacterState,
    player_stamina: StaminaState,
    player_health: HealthState,
    player_poise: PoiseState,
    blade: SoulBlade,
    resonance: ResonanceState,
    enemy: RotStalker,
    enemy_health: HealthState,
    enemy_poise: PoiseState,
    parry_state: ParryState,
    hit_stop: HitStopState,
    player_hit_memory: CombatHitMemory,
    enemy_hit_memory: CombatHitMemory,
    spring_arm: SpringArmState,
    camera_jolt: CameraJoltState,
    fov_shift: CameraFovShiftState,
    combat_feel: CombatFeelConfig,
    player_x: Integer,
    player_y: Integer,
    player_z: Integer
) -> GameTickState {
    return GameTickState(
        world=world,
        player=player,
        player_stamina=player_stamina,
        player_health=player_health,
        player_poise=player_poise,
        blade=blade,
        resonance=resonance,
        enemy=enemy,
        enemy_health=enemy_health,
        enemy_poise=enemy_poise,
        parry_state=parry_state,
        hit_stop=hit_stop,
        player_hit_memory=player_hit_memory,
        enemy_hit_memory=enemy_hit_memory,
        spring_arm=spring_arm,
        camera_jolt=camera_jolt,
        fov_shift=fov_shift,
        combat_feel=combat_feel,
        player_x=player_x,
        player_y=player_y,
        player_z=player_z
    )
}

// ============================================================================
// Helper: determine if the player just entered attack (rising edge)
// ============================================================================

fn player_just_entered_attack(player: CharacterState) -> Boolean {
    // state 4 = attack, state_tick == 0 means just entered this tick
    if player.current_state == 4 {
        if player.state_tick == 0 {
            return true
        }
    }
    return false
}

fn player_just_entered_parry(player: CharacterState) -> Boolean {
    if player.current_state == 6 {
        if player.state_tick == 0 {
            return true
        }
    }
    return false
}

// ============================================================================
// Helper: determine the move type for the current attack
// Uses the previous input to distinguish light vs heavy
// ============================================================================

fn get_player_move_type(player: CharacterState) -> Integer {
    // prev_attack_heavy is set after the character state advances
    // If heavy was pressed, it's a heavy (2). Otherwise light (1).
    if player.prev_attack_heavy {
        return 2
    }
    return 1
}

fn get_player_move_id(player: CharacterState) -> Integer {
    if player.prev_attack_heavy {
        return move_id_heavy()
    }
    return move_id_light()
}

fn get_player_frame_data(player: CharacterState) -> FrameDataEntry {
    if player.prev_attack_heavy {
        return soul_blade_heavy_attack()
    }
    return soul_blade_light_attack()
}

fn get_player_hitbox(player: CharacterState) -> HitboxDescriptor {
    if player.prev_attack_heavy {
        return soul_blade_heavy_hitbox()
    }
    return soul_blade_light_hitbox()
}

// ============================================================================
// Master game tick function
// ============================================================================

fn execute_game_tick(state: GameTickState, input: GameTickInput) -> GameTickState {
    // -----------------------------------------------------------------------
    // Step 1: Hit stop check
    // If currently hit-stopped, only tick hit_stop, camera_jolt, fov_shift.
    // All game logic is frozen.
    // -----------------------------------------------------------------------
    if is_hit_stopped(state=state.hit_stop) {
        new_hit_stop = tick_hit_stop(state=state.hit_stop)
        new_camera_jolt = tick_camera_jolt(jolt=state.camera_jolt)
        new_fov_shift = tick_fov_shift(state=state.fov_shift)
        return rebuild_state(
            world=state.world,
            player=state.player,
            player_stamina=state.player_stamina,
            player_health=state.player_health,
            player_poise=state.player_poise,
            blade=state.blade,
            resonance=state.resonance,
            enemy=state.enemy,
            enemy_health=state.enemy_health,
            enemy_poise=state.enemy_poise,
            parry_state=state.parry_state,
            hit_stop=new_hit_stop,
            player_hit_memory=state.player_hit_memory,
            enemy_hit_memory=state.enemy_hit_memory,
            spring_arm=state.spring_arm,
            camera_jolt=new_camera_jolt,
            fov_shift=new_fov_shift,
            combat_feel=state.combat_feel,
            player_x=state.player_x,
            player_y=state.player_y,
            player_z=state.player_z
        )
    }

    // -----------------------------------------------------------------------
    // Step 2: Convert input to CharacterInputEvent
    // -----------------------------------------------------------------------
    char_input = create_character_input_event(
        move_x=input.move_x,
        move_z=input.move_z,
        attack_light=input.attack_light,
        attack_heavy=input.attack_heavy,
        dodge=input.dodge,
        parry=input.parry
    )

    // -----------------------------------------------------------------------
    // Step 3: Advance character state machine
    // -----------------------------------------------------------------------
    mutable cur_player = advance_character_state(state=state.player, input=char_input)

    // -----------------------------------------------------------------------
    // Step 4: Player movement
    // Walk state = 1, move based on facing direction and speed
    // -----------------------------------------------------------------------
    mutable cur_player_x = state.player_x
    mutable cur_player_y = state.player_y
    mutable cur_player_z = state.player_z
    move_speed = 40

    if cur_player.current_state == 1 {
        cur_player_x = cur_player_x + cur_player.facing_x * move_speed / 1000
        cur_player_z = cur_player_z + cur_player.facing_z * move_speed / 1000
    }

    // -----------------------------------------------------------------------
    // Step 5: Stamina consumption on attack entry
    // -----------------------------------------------------------------------
    mutable cur_stamina = state.player_stamina

    if player_just_entered_attack(player=cur_player) {
        mutable attack_cost = 8000
        if cur_player.prev_attack_heavy {
            attack_cost = 18000
        }
        if has_stamina(state=cur_stamina, amount_milli=attack_cost) {
            cur_stamina = consume_stamina(state=cur_stamina, amount_milli=attack_cost)
        }
    }

    // -----------------------------------------------------------------------
    // Step 6: Parry activation
    // -----------------------------------------------------------------------
    mutable cur_parry = state.parry_state

    if player_just_entered_parry(player=cur_player) {
        parry_cost = 5000
        if has_stamina(state=cur_stamina, amount_milli=parry_cost) {
            cur_stamina = consume_stamina(state=cur_stamina, amount_milli=parry_cost)
            cur_parry = activate_parry(state=cur_parry, window_ticks=4)
        }
    }

    // -----------------------------------------------------------------------
    // Step 7: Tick stamina regen
    // -----------------------------------------------------------------------
    cur_stamina = tick_stamina_regen(state=cur_stamina)

    // -----------------------------------------------------------------------
    // Step 8: Tick enemy AI
    // -----------------------------------------------------------------------
    mutable cur_enemy = tick_rot_stalker_ai(
        stalker=state.enemy,
        player_x=cur_player_x,
        player_z=cur_player_z
    )

    // -----------------------------------------------------------------------
    // Step 9: Player attack hit detection
    // -----------------------------------------------------------------------
    mutable cur_blade = state.blade
    mutable cur_resonance = state.resonance
    mutable cur_enemy_health = state.enemy_health
    mutable cur_enemy_poise = state.enemy_poise
    mutable cur_hit_stop = state.hit_stop
    mutable cur_camera_jolt = state.camera_jolt
    mutable cur_player_hit_memory = state.player_hit_memory

    if cur_player.current_state == 4 {
        player_fd = get_player_frame_data(player=cur_player)
        res_tier = get_resonance_tier(state=cur_resonance)
        modified_fd = apply_resonance_modifier(base=player_fd, resonance_tier=res_tier)

        if is_in_active(entry=modified_fd, current_tick=cur_player.state_tick) {
            player_hb = get_player_hitbox(player=cur_player)
            enemy_hb = rot_stalker_hurtbox()
            p_move_id = get_player_move_id(player=cur_player)

            hit_event = detect_combat_hits(
                hitbox=player_hb,
                attacker_x=cur_player_x,
                attacker_y=cur_player_y,
                attacker_z=cur_player_z,
                attacker_id=0,
                move_id=p_move_id,
                damage_milli=modified_fd.damage_milli,
                hitstun_ticks=modified_fd.hitstun_ticks,
                poise_damage_milli=modified_fd.poise_damage_milli,
                hurtbox=enemy_hb,
                defender_x=cur_enemy.position_x,
                defender_y=cur_enemy.position_y,
                defender_z=cur_enemy.position_z,
                defender_id=cur_enemy.entity_id,
                memory=cur_player_hit_memory,
                facing_x=cur_player.facing_x,
                facing_z=cur_player.facing_z
            )

            if hit_event.damage_milli > 0 {
                // Apply damage to enemy
                cur_enemy_health = apply_damage(state=cur_enemy_health, amount_milli=hit_event.damage_milli)

                // Apply poise damage to enemy
                cur_enemy_poise = apply_poise_damage(state=cur_enemy_poise, damage_milli=hit_event.poise_damage_milli)

                // Record strike on blade
                cur_blade = record_strike(blade=cur_blade, damage_milli=hit_event.damage_milli)

                // Add resonance charge (50 per hit)
                cur_resonance = add_resonance(state=cur_resonance, amount_milli=50)

                // Trigger hit stop based on move type
                move_type = get_player_move_type(player=cur_player)
                hs_ticks = get_hit_stop_ticks(config=state.combat_feel, move_type=move_type)
                hs_bonus = get_hit_stop_bonus(resonance_tier=res_tier)
                cur_hit_stop = trigger_hit_stop(
                    state=cur_hit_stop,
                    duration_ticks=hs_ticks + hs_bonus,
                    strength_milli=get_jolt_magnitude(config=state.combat_feel, move_type=move_type)
                )

                // Trigger camera jolt
                jolt_mag = get_jolt_magnitude(config=state.combat_feel, move_type=move_type)
                cur_camera_jolt = trigger_camera_jolt(
                    jolt=cur_camera_jolt,
                    magnitude_milli=jolt_mag,
                    duration_ticks=hs_ticks + hs_bonus
                )

                // Record hit in player memory
                cur_player_hit_memory = record_hit(
                    memory=cur_player_hit_memory,
                    move_id=p_move_id,
                    defender_id=cur_enemy.entity_id
                )
            }
        }
    }
    // Reset hit memory when not in attack state
    if cur_player.current_state != 4 {
        cur_player_hit_memory = reset_hit_memory(memory=cur_player_hit_memory)
    }

    // -----------------------------------------------------------------------
    // Step 10: Enemy attack hit detection
    // -----------------------------------------------------------------------
    mutable cur_player_health = state.player_health
    mutable cur_player_poise = state.player_poise
    mutable cur_enemy_hit_memory = state.enemy_hit_memory

    if cur_enemy.current_move > 0 {
        enemy_fd = get_rot_stalker_frame_data(move_id=cur_enemy.current_move)

        if is_in_active(entry=enemy_fd, current_tick=cur_enemy.move_tick) {
            enemy_hitbox = get_rot_stalker_hitbox(move_id=cur_enemy.current_move)
            p_hurtbox = player_hurtbox()

            enemy_hit = detect_combat_hits(
                hitbox=enemy_hitbox,
                attacker_x=cur_enemy.position_x,
                attacker_y=cur_enemy.position_y,
                attacker_z=cur_enemy.position_z,
                attacker_id=cur_enemy.entity_id,
                move_id=cur_enemy.current_move,
                damage_milli=enemy_fd.damage_milli,
                hitstun_ticks=enemy_fd.hitstun_ticks,
                poise_damage_milli=enemy_fd.poise_damage_milli,
                hurtbox=p_hurtbox,
                defender_x=cur_player_x,
                defender_y=cur_player_y,
                defender_z=cur_player_z,
                defender_id=0,
                memory=cur_enemy_hit_memory,
                facing_x=cur_enemy.facing_x,
                facing_z=cur_enemy.facing_z
            )

            if enemy_hit.damage_milli > 0 {
                // Check if player parry is active
                if test_parry(state=cur_parry) {
                    // Parry success!
                    cur_parry = on_parry_success(
                        state=cur_parry,
                        counter_window_ticks=soul_blade_parry_counter_window()
                    )

                    // Record parry on blade
                    cur_blade = record_parry(blade=cur_blade)

                    // Add resonance (100 per parry)
                    cur_resonance = add_resonance(state=cur_resonance, amount_milli=100)

                    // Trigger parry hit stop (8 ticks)
                    parry_hs_ticks = get_hit_stop_ticks(config=state.combat_feel, move_type=3)
                    cur_hit_stop = trigger_hit_stop(
                        state=cur_hit_stop,
                        duration_ticks=parry_hs_ticks,
                        strength_milli=get_jolt_magnitude(config=state.combat_feel, move_type=3)
                    )

                    // Camera jolt for parry
                    cur_camera_jolt = trigger_camera_jolt(
                        jolt=cur_camera_jolt,
                        magnitude_milli=get_jolt_magnitude(config=state.combat_feel, move_type=3),
                        duration_ticks=parry_hs_ticks
                    )

                    // Enemy takes poise damage on parry
                    cur_enemy_poise = apply_poise_damage(
                        state=cur_enemy_poise,
                        damage_milli=enemy_fd.poise_damage_milli
                    )
                }
                else {
                    // Player takes damage and poise damage
                    cur_player_health = apply_damage(
                        state=cur_player_health,
                        amount_milli=enemy_hit.damage_milli
                    )
                    cur_player_poise = apply_poise_damage(
                        state=cur_player_poise,
                        damage_milli=enemy_hit.poise_damage_milli
                    )

                    // Trigger hit stop (light = 3 ticks)
                    enemy_hs_ticks = get_hit_stop_ticks(config=state.combat_feel, move_type=1)
                    cur_hit_stop = trigger_hit_stop(
                        state=cur_hit_stop,
                        duration_ticks=enemy_hs_ticks,
                        strength_milli=get_jolt_magnitude(config=state.combat_feel, move_type=1)
                    )

                    // Camera jolt
                    cur_camera_jolt = trigger_camera_jolt(
                        jolt=cur_camera_jolt,
                        magnitude_milli=get_jolt_magnitude(config=state.combat_feel, move_type=1),
                        duration_ticks=enemy_hs_ticks
                    )
                }

                // Record hit in enemy memory
                cur_enemy_hit_memory = record_hit(
                    memory=cur_enemy_hit_memory,
                    move_id=cur_enemy.current_move,
                    defender_id=0
                )
            }
        }
    }
    // Reset enemy hit memory when not attacking
    if cur_enemy.current_move == 0 {
        cur_enemy_hit_memory = reset_hit_memory(memory=cur_enemy_hit_memory)
    }

    // -----------------------------------------------------------------------
    // Step 11: Tick poise (both player and enemy)
    // -----------------------------------------------------------------------
    cur_player_poise = tick_poise(state=cur_player_poise)
    cur_enemy_poise = tick_poise(state=cur_enemy_poise)

    // -----------------------------------------------------------------------
    // Step 12: Check poise break
    // -----------------------------------------------------------------------
    if is_poise_broken(state=cur_player_poise) {
        // Player enters stagger (state 5)
        if cur_player.current_state != 5 {
            cur_player = CharacterState(
                current_state=5,
                state_tick=0,
                facing_x=cur_player.facing_x,
                facing_z=cur_player.facing_z,
                speed_milli=cur_player.speed_milli,
                grounded=cur_player.grounded,
                recovery_ticks=20,
                prev_attack_light=cur_player.prev_attack_light,
                prev_attack_heavy=cur_player.prev_attack_heavy,
                prev_dodge=cur_player.prev_dodge,
                prev_parry=cur_player.prev_parry
            )
        }
    }
    if is_poise_broken(state=cur_enemy_poise) {
        // Enemy enters stagger: set current_move to 0 and cooldown to broken_duration
        if cur_enemy.current_move != 0 {
            cur_enemy = RotStalker(
                entity_id=cur_enemy.entity_id,
                position_x=cur_enemy.position_x,
                position_y=cur_enemy.position_y,
                position_z=cur_enemy.position_z,
                current_move=0,
                move_tick=0,
                aggro_range_milli=cur_enemy.aggro_range_milli,
                attack_range_milli=cur_enemy.attack_range_milli,
                cooldown_ticks=20,
                facing_x=cur_enemy.facing_x,
                facing_z=cur_enemy.facing_z
            )
        }
    }

    // -----------------------------------------------------------------------
    // Step 13: Tick parry
    // -----------------------------------------------------------------------
    cur_parry = tick_parry(state=cur_parry)

    // -----------------------------------------------------------------------
    // Step 14: Tick resonance decay
    // -----------------------------------------------------------------------
    cur_resonance = tick_resonance_decay(state=cur_resonance)

    // -----------------------------------------------------------------------
    // Step 15: Tick camera
    // -----------------------------------------------------------------------
    mutable cur_spring_arm = update_spring_arm_target(
        arm=state.spring_arm,
        target_x=cur_player_x,
        target_y=cur_player_y,
        target_z=cur_player_z
    )
    cur_spring_arm = tick_spring_arm(arm=cur_spring_arm)
    cur_camera_jolt = tick_camera_jolt(jolt=cur_camera_jolt)
    mutable cur_fov_shift = tick_fov_shift(state=state.fov_shift)

    // -----------------------------------------------------------------------
    // Step 16: Update world state
    // -----------------------------------------------------------------------
    mutable cur_world = state.world

    // Add activity based on combat (attacks, hits generate activity)
    mutable activity_delta = 0
    if cur_player.current_state == 4 {
        activity_delta = activity_delta + 5
    }
    if cur_enemy.current_move > 0 {
        activity_delta = activity_delta + 3
    }
    if activity_delta > 0 {
        cur_world = create_forest_world_with_activity_delta(state=cur_world, amount=activity_delta)
    }

    // -----------------------------------------------------------------------
    // Step 17: Update ForestWorldState player fields
    // -----------------------------------------------------------------------
    cur_world = create_forest_world_with_player_position(
        state=cur_world,
        px=cur_player_x,
        pz=cur_player_z
    )

    // Tick the world simulation
    cur_world = create_forest_world_after_tick_system(state=cur_world)

    // -----------------------------------------------------------------------
    // Assemble final state
    // -----------------------------------------------------------------------
    return rebuild_state(
        world=cur_world,
        player=cur_player,
        player_stamina=cur_stamina,
        player_health=cur_player_health,
        player_poise=cur_player_poise,
        blade=cur_blade,
        resonance=cur_resonance,
        enemy=cur_enemy,
        enemy_health=cur_enemy_health,
        enemy_poise=cur_enemy_poise,
        parry_state=cur_parry,
        hit_stop=cur_hit_stop,
        player_hit_memory=cur_player_hit_memory,
        enemy_hit_memory=cur_enemy_hit_memory,
        spring_arm=cur_spring_arm,
        camera_jolt=cur_camera_jolt,
        fov_shift=cur_fov_shift,
        combat_feel=state.combat_feel,
        player_x=cur_player_x,
        player_y=cur_player_y,
        player_z=cur_player_z
    )
}
