//
// Forest world state modeled as a generic persistent-physics lane.

use {
    PersistentPhysicsBodyState,
    PersistentPhysicsLifecycleEvent,
    create_persistent_physics_body_state,
    create_persistent_physics_lifecycle_event,
    check_persistent_physics_state_terminal,
    get_persistent_physics_state_static,
    get_persistent_physics_state_active,
    get_persistent_physics_state_sleeping,
    get_persistent_physics_state_baked,
    get_persistent_physics_state_harvested
}
from pkg/game/physics/persistent

resource ForestWorldState {
    mutable focus_body_id: Integer = 1
    mutable focus_archetype_id: Integer = 101
    mutable focus_body_state: Integer = 0
    mutable focus_body_stability: Integer = 800
    mutable focus_body_wear: Integer = 100
    mutable world_activity: Integer = 0
    mutable world_resonance: Integer = 0
    mutable world_damage: Integer = 0
    mutable tick: Integer = 0
    mutable player_x: Integer = 0
    mutable player_z: Integer = 0
}

fn create_default_forest_archetype_id() -> Integer {
    // Tree is now only one archetype entry in a generic domain.
    return 101
}

fn create_forest_world_state(
    focus_body_id: Integer,
    focus_archetype_id: Integer,
    focus_body_state: Integer,
    focus_body_stability: Integer,
    focus_body_wear: Integer,
    world_activity: Integer,
    world_resonance: Integer,
    world_damage: Integer,
    tick: Integer,
    player_x: Integer,
    player_z: Integer
) -> ForestWorldState {
    return ForestWorldState(
        focus_body_id=focus_body_id,
        focus_archetype_id=focus_archetype_id,
        focus_body_state=focus_body_state,
        focus_body_stability=focus_body_stability,
        focus_body_wear=focus_body_wear,
        world_activity=world_activity,
        world_resonance=world_resonance,
        world_damage=world_damage,
        tick=tick,
        player_x=player_x,
        player_z=player_z
    )
}

fn clamp_ratio(value: Integer) -> Integer {
    mutable clamped = value
    if clamped < 0 {
        clamped = 0
    }
    if clamped > 1000 {
        clamped = 1000
    }
    return clamped
}

fn create_default_forest_world() -> ForestWorldState {
    return create_forest_world_state(
        focus_body_id=1,
        focus_archetype_id=create_default_forest_archetype_id(),
        focus_body_state=get_persistent_physics_state_static(),
        focus_body_stability=800,
        focus_body_wear=100,
        world_activity=0,
        world_resonance=0,
        world_damage=0,
        tick=0,
        player_x=0,
        player_z=0
    )
}

fn get_focus_body_stability(state: ForestWorldState) -> Integer {
    return state.focus_body_stability
}

fn get_focus_body_wear(state: ForestWorldState) -> Integer {
    return state.focus_body_wear
}

fn get_world_activity(state: ForestWorldState) -> Integer {
    return state.world_activity
}

fn get_world_resonance(state: ForestWorldState) -> Integer {
    return state.world_resonance
}

fn get_world_damage(state: ForestWorldState) -> Integer {
    return state.world_damage
}

fn get_focus_body_state(state: ForestWorldState) -> Integer {
    return state.focus_body_state
}

fn get_focus_archetype_id(state: ForestWorldState) -> Integer {
    return state.focus_archetype_id
}

fn create_focus_body_snapshot(state: ForestWorldState) -> PersistentPhysicsBodyState {
    return create_persistent_physics_body_state(
        entity_id=state.focus_body_id,
        archetype_id=state.focus_archetype_id,
        lifecycle_state=state.focus_body_state,
        position_x=0,
        position_y=0,
        position_z=0,
        velocity_x=0,
        velocity_y=0,
        velocity_z=0,
        durability_milli=state.focus_body_stability,
        burden_milli=state.focus_body_wear,
        persistence_ticks=state.tick
    )
}

fn create_focus_body_lifecycle_event(
    state: ForestWorldState,
    next_state: Integer,
    reason_code: Integer
) -> PersistentPhysicsLifecycleEvent {
    body = create_focus_body_snapshot(state)
    return create_persistent_physics_lifecycle_event(
        state=body,
        next_state=next_state,
        reason_code=reason_code,
        tick=state.tick
    )
}

fn create_forest_world_with_activity_delta(state: ForestWorldState, amount: Integer) -> ForestWorldState {
    return create_forest_world_state(
        focus_body_id=state.focus_body_id,
        focus_archetype_id=state.focus_archetype_id,
        focus_body_state=state.focus_body_state,
        focus_body_stability=state.focus_body_stability,
        focus_body_wear=state.focus_body_wear,
        world_activity=clamp_ratio(state.world_activity + amount),
        world_resonance=state.world_resonance,
        world_damage=state.world_damage,
        tick=state.tick,
        player_x=state.player_x,
        player_z=state.player_z
    )
}

fn create_forest_world_with_baked_focus_body(state: ForestWorldState) -> ForestWorldState {
    return create_forest_world_state(
        focus_body_id=state.focus_body_id,
        focus_archetype_id=state.focus_archetype_id,
        focus_body_state=get_persistent_physics_state_baked(),
        focus_body_stability=state.focus_body_stability,
        focus_body_wear=state.focus_body_wear,
        world_activity=state.world_activity,
        world_resonance=state.world_resonance,
        world_damage=state.world_damage,
        tick=state.tick,
        player_x=state.player_x,
        player_z=state.player_z
    )
}

fn create_forest_world_with_harvested_focus_body(state: ForestWorldState) -> ForestWorldState {
    return create_forest_world_state(
        focus_body_id=state.focus_body_id,
        focus_archetype_id=state.focus_archetype_id,
        focus_body_state=get_persistent_physics_state_harvested(),
        focus_body_stability=state.focus_body_stability,
        focus_body_wear=state.focus_body_wear,
        world_activity=state.world_activity,
        world_resonance=state.world_resonance,
        world_damage=state.world_damage,
        tick=state.tick,
        player_x=state.player_x,
        player_z=state.player_z
    )
}

fn create_forest_world_with_player_position(state: ForestWorldState, px: Integer, pz: Integer) -> ForestWorldState {
    return create_forest_world_state(
        focus_body_id=state.focus_body_id,
        focus_archetype_id=state.focus_archetype_id,
        focus_body_state=state.focus_body_state,
        focus_body_stability=state.focus_body_stability,
        focus_body_wear=state.focus_body_wear,
        world_activity=state.world_activity,
        world_resonance=state.world_resonance,
        world_damage=state.world_damage,
        tick=state.tick,
        player_x=px,
        player_z=pz
    )
}

system create_forest_world_after_tick_system[stage=fixed, reads=[ForestWorldState], writes=[ForestWorldState]](
    state: ForestWorldState
) -> ForestWorldState {
    mutable focus_body_state = state.focus_body_state
    mutable focus_body_stability = state.focus_body_stability
    mutable focus_body_wear = state.focus_body_wear
    mutable world_activity = state.world_activity
    mutable world_resonance = state.world_resonance
    mutable world_damage = state.world_damage

    if world_activity > 0 {
        world_activity = world_activity - 1
    }
    if world_activity < 200 {
        if focus_body_stability < 1000 {
            focus_body_stability = focus_body_stability + 1
        }
    }
    if focus_body_stability < 300 {
        if focus_body_wear < 1000 {
            focus_body_wear = focus_body_wear + 1
        }
    }
    if focus_body_stability > 700 {
        if focus_body_wear > 0 {
            focus_body_wear = focus_body_wear - 1
        }
    }
    if world_activity > 700 {
        if world_resonance < 1000 {
            world_resonance = world_resonance + 1
        }
    }
    if world_activity == 0 {
        if world_resonance > 0 {
            world_resonance = world_resonance - 1
        }
    }
    if focus_body_wear > 800 {
        if world_damage < 1000 {
            world_damage = world_damage + 1
        }
    }
    if focus_body_stability > 800 {
        if world_damage > 0 {
            world_damage = world_damage - 1
        }
    }

    focus_body_stability = clamp_ratio(focus_body_stability)
    focus_body_wear = clamp_ratio(focus_body_wear)
    world_activity = clamp_ratio(world_activity)
    world_resonance = clamp_ratio(world_resonance)
    world_damage = clamp_ratio(world_damage)

    if check_persistent_physics_state_terminal(focus_body_state) == false {
        if world_activity > 0 {
            focus_body_state = get_persistent_physics_state_active()
        }
        else if focus_body_stability < 450 {
            focus_body_state = get_persistent_physics_state_sleeping()
        }
        else {
            focus_body_state = get_persistent_physics_state_static()
        }
    }

    return create_forest_world_state(
        focus_body_id=state.focus_body_id,
        focus_archetype_id=state.focus_archetype_id,
        focus_body_state=focus_body_state,
        focus_body_stability=focus_body_stability,
        focus_body_wear=focus_body_wear,
        world_activity=world_activity,
        world_resonance=world_resonance,
        world_damage=world_damage,
        tick=state.tick + 1,
        player_x=state.player_x,
        player_z=state.player_z
    )
}
