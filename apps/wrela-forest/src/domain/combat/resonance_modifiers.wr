//
// Frame data deltas per resonance tier.
// Higher tiers = tighter timing, more reward.

use {
    FrameDataEntry,
    create_frame_data_entry
}
from pkg/game/combat/frame_data

fn apply_resonance_modifier(
    base: FrameDataEntry,
    resonance_tier: Integer
) -> FrameDataEntry {
    if resonance_tier <= 0 {
        // Tier 0 (survivor): no modifications
        return base
    }

    mutable startup_delta = 0
    mutable active_delta = 0
    mutable recovery_delta = 0
    mutable hit_stop_bonus = 0

    if resonance_tier == 1 {
        // Flow: recovery -1
        recovery_delta = -1
    }
    if resonance_tier == 2 {
        // Edge: startup -1, recovery -2, hit_stop +1
        startup_delta = -1
        recovery_delta = -2
        hit_stop_bonus = 1
    }
    if resonance_tier == 3 {
        // Overdrive: startup -1, active +1, recovery -3, hit_stop +2
        startup_delta = -1
        active_delta = 1
        recovery_delta = -3
        hit_stop_bonus = 2
    }
    if resonance_tier >= 4 {
        // Transcendent: extreme (briefly reachable)
        startup_delta = -2
        active_delta = 2
        recovery_delta = -4
        hit_stop_bonus = 3
    }

    new_startup = base.startup_ticks + startup_delta
    if new_startup < 1 {
        new_startup = 1
    }
    new_active = base.active_ticks + active_delta
    if new_active < 1 {
        new_active = 1
    }
    new_recovery = base.recovery_ticks + recovery_delta
    if new_recovery < 1 {
        new_recovery = 1
    }

    return create_frame_data_entry(
        move_id=base.move_id,
        startup_ticks=new_startup,
        active_ticks=new_active,
        recovery_ticks=new_recovery,
        damage_milli=base.damage_milli,
        stamina_cost_milli=base.stamina_cost_milli,
        hitstun_ticks=base.hitstun_ticks + hit_stop_bonus,
        poise_damage_milli=base.poise_damage_milli,
        knockback_milli=base.knockback_milli
    )
}

fn get_hit_stop_bonus(resonance_tier: Integer) -> Integer {
    if resonance_tier == 1 { return 0 }
    if resonance_tier == 2 { return 1 }
    if resonance_tier == 3 { return 2 }
    if resonance_tier >= 4 { return 3 }
    return 0
}
