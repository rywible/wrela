//
// Resonance state: 5 tiers driven by clean combat.
// Tiers: 0=survivor (0-199), 1=flow (200-499), 2=edge (500-799),
//        3=overdrive (800-999), 4=transcendent (1000).

resource ResonanceState {
    mutable tier: Integer = 0
    mutable charge_milli: Integer = 0
    mutable decay_per_tick_milli: Integer = 3
}

fn create_default_resonance() -> ResonanceState {
    return ResonanceState()
}

fn add_resonance(state: ResonanceState, amount_milli: Integer) -> ResonanceState {
    new_charge = state.charge_milli + amount_milli
    if new_charge > 1000 {
        new_charge = 1000
    }
    new_tier = compute_tier(new_charge)
    return ResonanceState(
        tier=new_tier,
        charge_milli=new_charge,
        decay_per_tick_milli=state.decay_per_tick_milli
    )
}

fn tick_resonance_decay(state: ResonanceState) -> ResonanceState {
    new_charge = state.charge_milli - state.decay_per_tick_milli
    if new_charge < 0 {
        new_charge = 0
    }
    new_tier = compute_tier(new_charge)
    return ResonanceState(
        tier=new_tier,
        charge_milli=new_charge,
        decay_per_tick_milli=state.decay_per_tick_milli
    )
}

fn get_resonance_tier(state: ResonanceState) -> Integer {
    return state.tier
}

fn compute_tier(charge_milli: Integer) -> Integer {
    if charge_milli >= 1000 {
        return 4
    }
    if charge_milli >= 800 {
        return 3
    }
    if charge_milli >= 500 {
        return 2
    }
    if charge_milli >= 200 {
        return 1
    }
    return 0
}

fn get_resonance_charge(state: ResonanceState) -> Integer {
    return state.charge_milli
}

fn tier_name(tier: Integer) -> String {
    if tier == 0 { return "survivor" }
    if tier == 1 { return "flow" }
    if tier == 2 { return "edge" }
    if tier == 3 { return "overdrive" }
    if tier == 4 { return "transcendent" }
    return "unknown"
}
