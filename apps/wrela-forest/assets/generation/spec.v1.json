      "output_group": "environment",
      "lod_policy": "near-mid-far",
      "material_policy": "pbr-ground",
      "reference_bindings": ["forest"]
    },
    {
      "id": "forest_tree_cluster",
      "kind": "mesh",
      "prompt": "Stylized conifer cluster mesh kit for forest edge silhouette",
      "style": "balanced",
      "constraints": ["no-intersections", "atlas-friendly-uv"],
      "output_group": "environment",
      "lod_policy": "near-mid-far",
      "material_policy": "pbr-foliage",
      "reference_bindings": ["forest"]
    },
    {
      "id": "ground_albedo",
      "kind": "texture",
      "prompt": "Forest floor albedo texture map with moss and soil breakup",
      "style": "balanced",
      "constraints": ["tileable", "no-text"],
      "output_group": "textures",
      "lod_policy": "texture-mips",
      "material_policy": "pbr-ground",
      "reference_bindings": ["forest"]
    },
    {
      "id": "ground_normal",
      "kind": "texture",
      "prompt": "Forest floor normal texture map matching albedo breakup",
      "style": "balanced",
      "constraints": ["tileable", "no-artifacts"],
      "output_group": "textures",
      "lod_policy": "texture-mips",
      "material_policy": "pbr-ground",
      "reference_bindings": ["forest"]
