// ============================================================================
// Test 1: Default state initialization is correct
// ============================================================================

fn test_default_state_initialization() -> Nothing {
    state = create_default_game_tick_state()

    // Player at origin
    assert value state.player_x == 0
    assert value state.player_y == 0
    assert value state.player_z == 0

    // Player starts idle
    assert value state.player.current_state == 0

    // Stamina is full
    assert value state.player_stamina.current_milli == 100000

    // Health is full
    assert value state.player_health.current_milli == 100000

    // Poise is full
    assert value state.player_poise.current_milli == 50000

    // Blade has zero stats
    assert value state.blade.total_strikes == 0
    assert value state.blade.total_parries == 0

    // Resonance starts at zero
    assert value state.resonance.charge_milli == 0
    assert value state.resonance.tier == 0

    // Enemy at (3000, 0, 3000)
    assert value state.enemy.position_x == 3000
    assert value state.enemy.position_z == 3000

    // Enemy health is full
    assert value state.enemy_health.current_milli == 100000

    // Hit stop not active
    assert value is_hit_stopped(state=state.hit_stop) == false

    // Camera jolt not active
    assert value state.camera_jolt.active == false

    // World tick starts at 0
    assert value state.world.tick == 0
}

// ============================================================================
// Test 2: No-input tick (state advances, stamina regens, resonance decays)
// ============================================================================

fn test_no_input_tick_advances_world() -> Nothing {
    state = create_default_game_tick_state()
    empty_input = create_empty_game_tick_input()
    next = execute_game_tick(state=state, input=empty_input)

    // World tick should advance
    assert value next.world.tick == 1

    // Player still at origin
    assert value next.player_x == 0
    assert value next.player_z == 0

    // Player stays idle
    assert value next.player.current_state == 0

    // Stamina stays at max (regen on full does not exceed max)
    assert value next.player_stamina.current_milli == 100000

    // Resonance decays (starts at 0, so stays at 0)
    assert value next.resonance.charge_milli == 0
}

// ============================================================================
// Test 3: Light attack input transitions player to attack state
// ============================================================================

fn test_light_attack_enters_attack_state() -> Nothing {
    state = create_default_game_tick_state()
    attack_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=true,
        attack_heavy=false,
        dodge=false,
        parry=false
    )
    next = execute_game_tick(state=state, input=attack_input)

    // Player should be in attack state (4)
    assert value next.player.current_state == 4
}

// ============================================================================
// Test 4: Stamina consumption on attack
// ============================================================================

fn test_stamina_consumed_on_light_attack() -> Nothing {
    state = create_default_game_tick_state()
    attack_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=true,
        attack_heavy=false,
        dodge=false,
        parry=false
    )
    next = execute_game_tick(state=state, input=attack_input)

    // Light attack costs 8000 stamina. After consumption, regen ticks once.
    // Starting: 100000 - 8000 = 92000, then regen ticks_since_consume resets to 0.
    // Since ticks_since_consume < regen_delay_ticks, no regen happens, just increment.
    assert value next.player_stamina.current_milli == 92000
}

fn test_stamina_consumed_on_heavy_attack() -> Nothing {
    state = create_default_game_tick_state()
    attack_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=false,
        attack_heavy=true,
        dodge=false,
        parry=false
    )
    next = execute_game_tick(state=state, input=attack_input)

    // Heavy attack costs 18000 stamina
    assert value next.player_stamina.current_milli == 82000
}

// ============================================================================
// Test 5: Player movement during walk state
// ============================================================================

fn test_player_moves_during_walk() -> Nothing {
    state = create_default_game_tick_state()
    walk_input = create_game_tick_input(
        move_x=1000,
        move_z=0,
        attack_light=false,
        attack_heavy=false,
        dodge=false,
        parry=false
    )
    next = execute_game_tick(state=state, input=walk_input)

    // Walk state = 1. Facing is (1000, 0). Movement = facing * 40 / 1000
    // player_x = 0 + 1000 * 40 / 1000 = 40
    assert value next.player.current_state == 1
    assert value next.player_x == 40
    assert value next.player_z == 0
}

// ============================================================================
// Test 6: Hit detection when player attack active window overlaps enemy
// ============================================================================

fn test_player_attack_hits_enemy_in_range() -> Nothing {
    // Place player right next to enemy to ensure hitbox/hurtbox overlap
    mutable state = create_default_game_tick_state()

    // Move player close to enemy: enemy is at (3000, 0, 3000)
    // We'll place player at the same position
    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=state.enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=3000,
        player_y=0,
        player_z=3000
    )

    attack_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=true,
        attack_heavy=false,
        dodge=false,
        parry=false
    )

    // First tick: enter attack state (startup phase)
    state = execute_game_tick(state=state, input=attack_input)
    assert value state.player.current_state == 4

    // Continue with no input to advance through startup (3 ticks)
    empty = create_empty_game_tick_input()
    state = execute_game_tick(state=state, input=empty)
    state = execute_game_tick(state=state, input=empty)
    state = execute_game_tick(state=state, input=empty)

    // Now we should be in active frames. If a hit happened, enemy should have taken damage.
    // The light attack has 3 startup ticks, then becomes active.
    // We need to check after the hit if enemy health decreased
    initial_enemy_health = 100000
    if state.enemy_health.current_milli < initial_enemy_health {
        // Hit was detected - verify blade recorded the strike
        assert value state.blade.total_strikes > 0
    }
}

// ============================================================================
// Test 7: Parry detection when enemy attacks during parry window
// ============================================================================

fn test_parry_blocks_enemy_attack() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Place player close to enemy
    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=state.enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=3000,
        player_y=0,
        player_z=3000
    )

    // Force enemy into an attack: set current_move=10 (claw_swipe) at active tick
    // claw_swipe: 5 startup, 6 active. So at move_tick=5, it's in active frames
    forced_enemy = RotStalker(
        entity_id=1,
        position_x=3000,
        position_y=0,
        position_z=3000,
        current_move=10,
        move_tick=5,
        aggro_range_milli=3000,
        attack_range_milli=800,
        cooldown_ticks=0,
        facing_x=0,
        facing_z=-1000
    )

    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=forced_enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=3000,
        player_y=0,
        player_z=3000
    )

    // Player activates parry
    parry_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=false,
        attack_heavy=false,
        dodge=false,
        parry=true
    )

    state = execute_game_tick(state=state, input=parry_input)

    // Player health should NOT have decreased (parry blocked)
    // If parry succeeded, blade should record a parry and resonance should increase
    // The parry success depends on hitbox/hurtbox overlap at this position
    // At same position with active enemy frames, parry should trigger
    if state.blade.total_parries > 0 {
        // Parry was successful
        assert value state.player_health.current_milli == 100000
        assert value state.resonance.charge_milli > 0
    }
}

// ============================================================================
// Test 8: Hit stop triggered on damage events
// ============================================================================

fn test_hit_stop_triggers_on_hit() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Place player at enemy position
    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=state.enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=3000,
        player_y=0,
        player_z=3000
    )

    attack_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=true,
        attack_heavy=false,
        dodge=false,
        parry=false
    )
    empty = create_empty_game_tick_input()

    // Advance through startup (3 ticks) to reach active frames
    state = execute_game_tick(state=state, input=attack_input)
    state = execute_game_tick(state=state, input=empty)
    state = execute_game_tick(state=state, input=empty)
    state = execute_game_tick(state=state, input=empty)

    // If a hit occurred, hit stop should be active
    if state.enemy_health.current_milli < 100000 {
        assert value is_hit_stopped(state=state.hit_stop) == true
    }
}

// ============================================================================
// Test 9: Resonance increase on successful parry
// ============================================================================

fn test_resonance_increases_on_parry() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Set up an active parry and enemy attacking at same position
    forced_enemy = RotStalker(
        entity_id=1,
        position_x=3000,
        position_y=0,
        position_z=3000,
        current_move=10,
        move_tick=5,
        aggro_range_milli=3000,
        attack_range_milli=800,
        cooldown_ticks=0,
        facing_x=0,
        facing_z=-1000
    )

    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=forced_enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=3000,
        player_y=0,
        player_z=3000
    )

    initial_resonance = state.resonance.charge_milli

    parry_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=false,
        attack_heavy=false,
        dodge=false,
        parry=true
    )

    state = execute_game_tick(state=state, input=parry_input)

    // If parry succeeded, resonance should have increased by 100 then decayed by 3 = 97
    if state.blade.total_parries > 0 {
        // Resonance increased (100 added, then 3 decayed)
        assert value state.resonance.charge_milli == 97
    }
}

// ============================================================================
// Test 10: Enemy AI moves toward player when in range
// ============================================================================

fn test_enemy_moves_toward_player_in_aggro_range() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Player at (1000, 0, 1000) - within aggro range (3000) of enemy at (3000, 0, 3000)
    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=state.enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=1000,
        player_y=0,
        player_z=1000
    )

    initial_enemy_x = state.enemy.position_x
    initial_enemy_z = state.enemy.position_z

    empty = create_empty_game_tick_input()
    state = execute_game_tick(state=state, input=empty)

    // Enemy should move toward player: dx = 1000 - 3000 = -2000, dz = 1000 - 3000 = -2000
    // So enemy should move with negative x and z (closer to player)
    assert value state.enemy.position_x <= initial_enemy_x
    assert value state.enemy.position_z <= initial_enemy_z
}

// ============================================================================
// Test 11: Player takes damage from enemy hits
// ============================================================================

fn test_player_takes_damage_from_enemy() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Force enemy into active attack at player's position
    forced_enemy = RotStalker(
        entity_id=1,
        position_x=0,
        position_y=0,
        position_z=0,
        current_move=10,
        move_tick=5,
        aggro_range_milli=3000,
        attack_range_milli=800,
        cooldown_ticks=0,
        facing_x=0,
        facing_z=1000
    )

    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=forced_enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=0,
        player_y=0,
        player_z=0
    )

    initial_health = state.player_health.current_milli
    empty = create_empty_game_tick_input()
    state = execute_game_tick(state=state, input=empty)

    // Claw swipe damage is 15000. If hit detected, health should decrease.
    if state.player_health.current_milli < initial_health {
        expected_health = initial_health - 15000
        assert value state.player_health.current_milli == expected_health
    }
}

// ============================================================================
// Test 12: Poise break causes stagger
// ============================================================================

fn test_poise_break_causes_stagger() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Set player poise very low (about to break)
    low_poise = PoiseState(
        current_milli=100,
        max_milli=50000,
        regen_per_tick_milli=200,
        broken=false,
        broken_duration_ticks=20,
        broken_tick=0
    )

    // Force enemy to hit player with enough poise damage
    forced_enemy = RotStalker(
        entity_id=1,
        position_x=0,
        position_y=0,
        position_z=0,
        current_move=10,
        move_tick=5,
        aggro_range_milli=3000,
        attack_range_milli=800,
        cooldown_ticks=0,
        facing_x=0,
        facing_z=1000
    )

    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=low_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=forced_enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=0,
        player_y=0,
        player_z=0
    )

    empty = create_empty_game_tick_input()
    state = execute_game_tick(state=state, input=empty)

    // If hit detected and poise broke, player should be in stagger (state 5)
    if is_poise_broken(state=state.player_poise) {
        assert value state.player.current_state == 5
    }
}

// ============================================================================
// Test 13: Hit memory prevents double-hit per swing
// ============================================================================

fn test_hit_memory_prevents_double_hit() -> Nothing {
    mutable state = create_default_game_tick_state()

    // Place player at enemy position
    state = rebuild_state(
        world=state.world,
        player=state.player,
        player_stamina=state.player_stamina,
        player_health=state.player_health,
        player_poise=state.player_poise,
        blade=state.blade,
        resonance=state.resonance,
        enemy=state.enemy,
        enemy_health=state.enemy_health,
        enemy_poise=state.enemy_poise,
        parry_state=state.parry_state,
        hit_stop=state.hit_stop,
        player_hit_memory=state.player_hit_memory,
        enemy_hit_memory=state.enemy_hit_memory,
        spring_arm=state.spring_arm,
        camera_jolt=state.camera_jolt,
        fov_shift=state.fov_shift,
        combat_feel=state.combat_feel,
        player_x=3000,
        player_y=0,
        player_z=3000
    )

    attack_input = create_game_tick_input(
        move_x=0,
        move_z=0,
        attack_light=true,
        attack_heavy=false,
        dodge=false,
        parry=false
    )
    empty = create_empty_game_tick_input()

    // Enter attack
    state = execute_game_tick(state=state, input=attack_input)

    // Advance through startup to active frames, tracking hit count
    mutable ticks_in_active = 0
    mutable i = 0
    while i < 10 {
        state = execute_game_tick(state=state, input=empty)
        i = i + 1
    }

    // Even though we advanced through multiple active ticks,
    // the blade should have at most 1 strike (hit memory prevents double-hit)
    assert value state.blade.total_strikes <= 1
}

