to try_to_run_process_port(
    ports: PlatformPorts,
    command: String,
    args: List[String],
    cwd: String,
    timeout_ms: Integer
) -> Result[Map]:
    process_ops_maps = ports.process_port.ops
    match get_required_platform_operation_text(process_ops_maps, "process", "run_process"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.process_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-process":
        if adapter_identity_name != "linux-io_uring-process":
            if adapter_identity_name != "linux-epoll-process":
                return error "unsupported platform adapter: {adapter_identity_name}"
    process_specs = __wr_map_new()
    __wr_map_set(process_specs, "command", command)
    __wr_map_set(process_specs, "args", args)
    __wr_map_set(process_specs, "cwd", cwd)
    __wr_map_set(process_specs, "env", {})
    __wr_map_set(process_specs, "timeout_ms", timeout_ms)
    return __wr_process_run(process_specs)


