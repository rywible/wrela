to try_to_spawn_thread(
    ports: PlatformPorts,
    thread_name: String,
    payload_maps: Map
) -> Result[Map]:
    thread_ops_maps = ports.thread_port.ops
    match get_required_platform_operation_text(thread_ops_maps, "thread", "spawn_thread"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.thread_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-thread":
        if adapter_identity_name != "linux-io_uring-thread":
            if adapter_identity_name != "linux-epoll-thread":
                return error "unsupported platform adapter: {adapter_identity_name}"

    result_maps = __wr_map_new()
    __wr_map_set(result_maps, "thread_handle", "{adapter_identity_name}:{thread_name}")
    __wr_map_set(result_maps, "payload", payload_maps)
    __wr_map_set(result_maps, "spawned", true)
    return result_maps


to try_to_join_thread(
    ports: PlatformPorts,
    thread_handle: String,
    timeout_ms: Integer
) -> Result[Map]:
    thread_ops_maps = ports.thread_port.ops
    match get_required_platform_operation_text(thread_ops_maps, "thread", "join_thread"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.thread_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-thread":
        if adapter_identity_name != "linux-io_uring-thread":
            if adapter_identity_name != "linux-epoll-thread":
                return error "unsupported platform adapter: {adapter_identity_name}"

    if timeout_ms < 0:
        return error "invalid thread join timeout_ms: {timeout_ms}"

    result_maps = __wr_map_new()
    __wr_map_set(result_maps, "thread_handle", thread_handle)
    __wr_map_set(result_maps, "joined", true)
    __wr_map_set(result_maps, "timeout_ms", timeout_ms)
    return result_maps


