to try_to_wait_on_handle(
    ports: PlatformPorts,
    wait_handle: String,
    timeout_ms: Integer
) -> Result[Map]:
    sync_ops_maps = ports.sync_port.ops
    match get_required_platform_operation_text(sync_ops_maps, "sync", "wait"):
