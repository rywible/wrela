so:
    Runtime facade that dispatches platform operations through adapter contracts.
    This keeps core/application callsites adapter-agnostic while staying fail-closed.

use PlatformPorts from domain/platform/contracts
use get_platform_operation_value_or_empty_text from domain/platform/contracts


to get_required_platform_operation_text(
    operation_maps: Map,
    port_name_text: String,
    operation_name_text: String
) -> Result[String]:
    operation_value_text = get_platform_operation_value_or_empty_text(
        operation_maps,
        operation_name_text
    )
    if operation_value_text == "":
        return error "missing platform op: {port_name_text}.{operation_name_text}"
    return operation_value_text


to run_reactor_port_lifecycle(
    ports: PlatformPorts,
    token: Integer,
    timeout_milliseconds: Integer
) -> Result[Map]:
    reactor_ops_maps = ports.reactor_port.ops
    match get_required_platform_operation_text(reactor_ops_maps, "reactor", "create_reactor_handle"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing
    match get_required_platform_operation_text(reactor_ops_maps, "reactor", "drop_reactor_handle"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing
    match get_required_platform_operation_text(reactor_ops_maps, "reactor", "register_token"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing
    match get_required_platform_operation_text(reactor_ops_maps, "reactor", "deregister_token"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing
    match get_required_platform_operation_text(reactor_ops_maps, "reactor", "arm_timer"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.reactor_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-reactor":
        if adapter_identity_name != "linux-io_uring-reactor":
            if adapter_identity_name != "linux-epoll-reactor":
                return error "unsupported platform adapter: {adapter_identity_name}"

    reactor_handle = __wr_reactor_new()
    __wr_reactor_register(reactor_handle, token)
    __wr_reactor_arm_timer(reactor_handle, token, timeout_milliseconds)
    __wr_reactor_deregister(reactor_handle, token)
    __wr_reactor_drop(reactor_handle)

    result_maps = __wr_map_new()
    __wr_map_set(result_maps, "reactor_handle", reactor_handle)
    __wr_map_set(result_maps, "token", token)
    __wr_map_set(result_maps, "timeout_milliseconds", timeout_milliseconds)
    return result_maps


to run_clock_port_now_ns(ports: PlatformPorts) -> Result[Integer]:
    clock_ops_maps = ports.clock_port.ops
