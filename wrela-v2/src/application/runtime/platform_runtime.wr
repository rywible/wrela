    if adapter_identity_name != "darwin-kqueue-sync":
        if adapter_identity_name != "linux-io_uring-sync":
            if adapter_identity_name != "linux-epoll-sync":
                return error "unsupported platform adapter: {adapter_identity_name}"
    if timeout_ms < 0:
        return error "invalid wait timeout_ms: {timeout_ms}"

    result_maps = __wr_map_new()
    __wr_map_set(result_maps, "wait_handle", wait_handle)
    __wr_map_set(result_maps, "signaled", true)
    __wr_map_set(result_maps, "timeout_ms", timeout_ms)
    return result_maps


