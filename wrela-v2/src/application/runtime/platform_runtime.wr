    return __wr_clock_ns()


to run_clock_port_sleep_ms(
    ports: PlatformPorts,
    milliseconds: Integer
) -> Result[Boolean]:
    clock_ops_maps = ports.clock_port.ops
    match get_required_platform_operation_text(clock_ops_maps, "clock", "sleep_ms"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.clock_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-clock":
        if adapter_identity_name != "linux-io_uring-clock":
            if adapter_identity_name != "linux-epoll-clock":
                return error "unsupported platform adapter: {adapter_identity_name}"
    if milliseconds < 0:
        return false
    return true


to try_to_run_fs_write_text(
    ports: PlatformPorts,
    path: String,
    contents: String
) -> Result[Nothing]:
    fs_ops_maps = ports.fs_port.ops
    match get_required_platform_operation_text(fs_ops_maps, "fs", "write_text"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.fs_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-fs":
        if adapter_identity_name != "linux-io_uring-fs":
            if adapter_identity_name != "linux-epoll-fs":
                return error "unsupported platform adapter: {adapter_identity_name}"
    payload_bytes = __wr_bytes_from_string(contents)
    return __wr_fs_write_bytes(path, payload_bytes)


to try_to_run_fs_read_text(
    ports: PlatformPorts,
    path: String
) -> Result[String]:
    fs_ops_maps = ports.fs_port.ops
    match get_required_platform_operation_text(fs_ops_maps, "fs", "read_text"):
        Err(error_text):
            return error error_text
        otherwise:
            nothing

    adapter_identity_name = ports.fs_port.adapter_identity_name
    if adapter_identity_name != "darwin-kqueue-fs":
        if adapter_identity_name != "linux-io_uring-fs":
            if adapter_identity_name != "linux-epoll-fs":
                return error "unsupported platform adapter: {adapter_identity_name}"
    match __wr_fs_read_bytes(path):
        Ok(bytes_values):
            text_value = __wr_bytes_to_string(bytes_values)
            match text_value:
                String:
                    return text_value
                otherwise:
                    return error "try_to_run_fs_read_text: invalid utf8"
        Err(error_text):
            return error error_text
        otherwise:
            return error "try_to_run_fs_read_text: read failed"
    return error "try_to_run_fs_read_text: read failed"


