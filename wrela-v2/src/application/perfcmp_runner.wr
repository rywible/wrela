so:
    Real perfcmp runner for M7-C.

use try_to_parse_integer from parse
use try_to_run_perf_runner from application/perf_runner
use get_env_int_or_default from application/env_vars
use get_env_or_default from application/env_vars


to try_to_read_text_for_perfcmp(path: String) -> Result[String]:
    match __wr_fs_read_bytes(path):
        Ok(bytes):
            text = __wr_bytes_to_string(bytes)
            match text:
                String: return text
                otherwise: return error "perfcmp invalid utf8"
        Err(_):
            return error "perfcmp read failed"
        otherwise:
            return error "perfcmp read failed"
    return error "perfcmp read failed"


to get_perfcmp_integer_env_or_default(key_text: String, fallback_number: Integer) -> Integer:
    return get_env_int_or_default(key_text, fallback_number)


to get_perfcmp_text_env_or_default(key_text: String, fallback_text: String) -> String:
    return get_env_or_default(key_text, fallback_text)


to get_perfcmp_lines(text: String) -> List[String]:
    line_lists = []
    current_byte_lists = []
    text_byte_lists = __wr_bytes_to_list(__wr_bytes_from_string(text))

    for byte_value in text_byte_lists:
        if byte_value == 13:
            nothing
        otherwise:
            if byte_value == 10:
                __wr_list_push(line_lists, __wr_bytes_to_string(__wr_bytes_from_list(current_byte_lists)))
                current_byte_lists = []
            otherwise:
                __wr_list_push(current_byte_lists, byte_value)
    __wr_list_push(line_lists, __wr_bytes_to_string(__wr_bytes_from_list(current_byte_lists)))
    return line_lists


to get_perfcmp_prefix_match_flag(text: String, prefix: String) -> Integer:
    text_byte_lists = __wr_bytes_to_list(__wr_bytes_from_string(text))
    prefix_byte_lists = __wr_bytes_to_list(__wr_bytes_from_string(prefix))

    mutable text_count_number = 0
    for _ in text_byte_lists:
        text_count_number = text_count_number + 1

    mutable prefix_count_number = 0
    for _ in prefix_byte_lists:
        prefix_count_number = prefix_count_number + 1

    if text_count_number < prefix_count_number:
        return 0

    mutable index_number = 0
    for prefix_byte_value in prefix_byte_lists:
        mutable text_byte_value_at_index = -1
        mutable cursor_number = 0
        for text_byte_value in text_byte_lists:
            if cursor_number == index_number:
                text_byte_value_at_index = text_byte_value
                break
            cursor_number = cursor_number + 1
        if text_byte_value_at_index != prefix_byte_value:
            return 0
        index_number = index_number + 1
    return 1


to get_perfcmp_value_for_key(text: String, key_text: String) -> String:
    prefix_text = "{key_text}="
    for line_text in get_perfcmp_lines(text):
        if get_perfcmp_prefix_match_flag(line_text, prefix_text) == 1:
            line_byte_lists = __wr_bytes_to_list(__wr_bytes_from_string(line_text))
            prefix_byte_lists = __wr_bytes_to_list(__wr_bytes_from_string(prefix_text))
            mutable prefix_count_number = 0
            for _ in prefix_byte_lists:
                prefix_count_number = prefix_count_number + 1

            value_byte_lists = []
            mutable cursor_number = 0
            for line_byte_value in line_byte_lists:
                if cursor_number >= prefix_count_number:
                    __wr_list_push(value_byte_lists, line_byte_value)
                cursor_number = cursor_number + 1
            return __wr_bytes_to_string(__wr_bytes_from_list(value_byte_lists))
    return ""


to try_to_write_perfcmp_report(
    baseline_p50_ns_number: Integer,
    current_p50_ns_number: Integer,
    delta_percent_number: Integer,
    threshold_percent_number: Integer,
    status_text: String
) -> Result[Nothing]:
    output_root_path_text = "target/wrela_v2_perf"
    report_path_text = "{output_root_path_text}/perfcmp_report.json"
    match __wr_fs_mkdir_all(output_root_path_text):
        Ok(_):
            nothing
        Err(_):
            return error "perfcmp failed to create report directory"
        otherwise:
            return error "perfcmp failed to create report directory"

    report_text = "baseline_p50_ns={baseline_p50_ns_number}\ncurrent_p50_ns={current_p50_ns_number}\ndelta_percent={delta_percent_number}\nthreshold_percent={threshold_percent_number}\nstatus={status_text}\n"
    match __wr_fs_write_bytes(report_path_text, __wr_bytes_from_string(report_text)):
        Ok(_):
            return nothing
        Err(_):
            return error "perfcmp failed to write report"
        otherwise:
            return error "perfcmp failed to write report"
    return error "perfcmp failed to write report"


to try_to_run_perfcmp_runner(path: String) -> Result[Map]:
    baseline_path_text = get_perfcmp_text_env_or_default(
        "WRELA_V2_PERF_BASELINE",
        "target/wrela_v2_perf/baseline_perf_report.json"
    )

    mutable baseline_text = ""
    match try_to_read_text_for_perfcmp(baseline_path_text):
        Ok(text):
            baseline_text = text
        Err(_):
            return error "perfcmp baseline missing"
        otherwise:
            return error "perfcmp baseline missing"

    required_baseline_key_texts = [
        "runs",
        "successes",
        "failures",
        "min_ns",
        "max_ns",
        "avg_ns",
        "p50_ns",
        "p95_ns",
        "p99_ns",
        "timestamp_ns"
    ]
    for required_baseline_key_text in required_baseline_key_texts:
        if get_perfcmp_value_for_key(baseline_text, required_baseline_key_text) == "":
            return error "perfcmp baseline invalid"

    baseline_value_text = get_perfcmp_value_for_key(baseline_text, "p50_ns")
    if baseline_value_text == "":
        return error "perfcmp baseline invalid"

    mutable baseline_p50_ns_number = 0
    match try_to_parse_integer(baseline_value_text):
        Ok(parsed_number):
            baseline_p50_ns_number = parsed_number
        Err(_):
            return error "perfcmp baseline invalid"
        otherwise:
            return error "perfcmp baseline invalid"

    mutable current_result_maps = __wr_map_new()
    match try_to_run_perf_runner(path):
        Ok(result_maps):
            current_result_maps = result_maps
        Err(_):
            return error "perfcmp current perf failed"
        otherwise:
            return error "perfcmp current perf failed"

    current_p50_ns_value = __wr_map_get(current_result_maps, "p50_ns")
    if current_p50_ns_value == nothing:
        return error "perfcmp current perf missing p50"

    mutable current_p50_ns_number = 0
    match try_to_parse_integer("{current_p50_ns_value}"):
        Ok(parsed_number):
            current_p50_ns_number = parsed_number
        Err(_):
            return error "perfcmp current perf missing p50"
        otherwise:
            return error "perfcmp current perf missing p50"
    threshold_percent_number = get_perfcmp_integer_env_or_default(
        "WRELA_V2_PERFCMP_MAX_REGRESSION_PCT",
        10
    )

    mutable delta_percent_number = 0
    if baseline_p50_ns_number > 0:
        delta_percent_number = ((current_p50_ns_number - baseline_p50_ns_number) * 100) / baseline_p50_ns_number
    otherwise:
        if current_p50_ns_number > 0:
            delta_percent_number = 100

    if delta_percent_number > threshold_percent_number:
        try_to_write_perfcmp_report(
            baseline_p50_ns_number,
            current_p50_ns_number,
            delta_percent_number,
            threshold_percent_number,
            "regression"
        ) otherwise nothing
        return error "perfcmp regression exceeded threshold"

    try_to_write_perfcmp_report(
        baseline_p50_ns_number,
        current_p50_ns_number,
        delta_percent_number,
        threshold_percent_number,
        "ok"
    ) otherwise nothing

    result_maps = __wr_map_new()
    __wr_map_set(result_maps, "baseline_p50_ns", baseline_p50_ns_number)
    __wr_map_set(result_maps, "current_p50_ns", current_p50_ns_number)
    __wr_map_set(result_maps, "delta_percent", delta_percent_number)
    __wr_map_set(result_maps, "threshold_percent", threshold_percent_number)
    __wr_map_set(result_maps, "status", "ok")
    return result_maps
