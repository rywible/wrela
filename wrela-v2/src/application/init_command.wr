so:
    V2 `init` command bootstrap.
    Coverage-critical helper module for project scaffolding.


to normalize_root(path: String) -> String:
    if path == "":
        return "."
    return path


to get_path_exists_flag(path: String) -> Integer:
    match __wr_fs_metadata(path):
        Ok(metadata_maps):
            if metadata_maps == nothing:
                return 1
            return 1
        Err(metadata_error_text):
            if metadata_error_text == "":
                return 0
            return 0
        otherwise:
            return 0
    return 0


to ensure_directory(path: String) -> Result[Nothing]:
    if get_path_exists_flag(path) == 1:
        return nothing
    return __wr_fs_mkdir_all(path)


to ensure_file(path: String, contents: String) -> Result[Nothing]:
    if get_path_exists_flag(path) == 1:
        return nothing
    return __wr_fs_write_bytes(path, __wr_bytes_from_string(contents))


to run_init_command(path: String) -> Integer:
    root = normalize_root(path)
    src_dir = "{root}/src"
    tests_dir = "{root}/tests"
    main_path = "{src_dir}/main.wr"
    test_path = "{tests_dir}/basic_test.wr"

    ensure_directory(root) otherwise nothing
    if get_path_exists_flag(root) != 1:
        return 1
    ensure_directory(src_dir) otherwise nothing
    if get_path_exists_flag(src_dir) != 1:
        return 1
    ensure_directory(tests_dir) otherwise nothing
    if get_path_exists_flag(tests_dir) != 1:
        return 1

    ensure_file(main_path, "to run() -> Integer:\n    return 0\n") otherwise nothing
    if get_path_exists_flag(main_path) != 1:
        return 1

    ensure_file(test_path, "to run() -> Integer:\n    return 0\n") otherwise nothing
    if get_path_exists_flag(test_path) != 1:
        return 1

    return 0
