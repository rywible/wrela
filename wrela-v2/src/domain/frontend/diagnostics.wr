    __wr_map_set(type_error_maps, "code", "E-TYPE-ARITH_NON_INTEGER")
    __wr_map_set(type_error_maps, "message", "arithmetic expression requires integer operands")
    __wr_map_set(type_error_maps, "stage", "type")
    __wr_map_set(type_error_maps, "line", type_error_line_number)
    __wr_map_set(type_error_maps, "column", type_error_column_number)
    return type_error_maps
