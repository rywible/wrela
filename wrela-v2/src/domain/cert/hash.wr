so:
    Deterministic cert hash helpers for M8-A.


to get_cert_hash_text(value_text: String) -> String:
    value_byte_lists = __wr_bytes_to_list(__wr_bytes_from_string(value_text))
    return get_cert_hash_text_from_byte_lists(value_byte_lists)


to get_cert_hash_text_from_byte_lists(value_byte_lists: List[Integer]) -> String:
    mutable hash_number = 2_166_136_261
    for hash_byte_value in value_byte_lists:
        hash_number = ((hash_number * 16_777_619) + hash_byte_value) % 2_147_483_647
    return "h{hash_number}"

