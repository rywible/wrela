to test_check_pipeline_reports_ok_for_simple_program() -> Nothing:
    root = "target/wrela_v2_check_contract"
    path = "{root}/ok.wr"
    ensure_contract_directory(root)
    write_contract_fixture(path, "to run() -> Integer:\n    return 1 + 2 * 3\n")

    match run_check_pipeline(path):
        Ok(report_maps):
            assert value __wr_map_get(report_maps, "status") == "ok"
            assert value __wr_map_get(report_maps, "exit_code") == 0
            assert value __wr_map_get(report_maps, "stage") == "type"
            assert value get_diagnostics_count(report_maps) == 0
            return nothing
        Err(error_text):
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


