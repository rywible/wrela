to write_contract_fixture(path: String, source: String) -> Nothing:
    match try_to_write_text(path, source):
        Ok(write_result):
            return nothing
        Err(error_text):
            assert value error_text == ""
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to ensure_contract_directory(path: String) -> Nothing:
    match try_to_create_directory(path):
        Ok(create_result):
            return nothing
        Err(error_text):
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to get_diagnostics_count(report_maps: Map) -> Integer:
    diagnostic_lists = get_list_value_or_empty_list(__wr_map_get(report_maps, "diagnostics"))
    mutable count = 0
    for diagnostic_item in diagnostic_lists:
        count = count + 1
    return count


to get_first_diagnostic_code(report_maps: Map) -> String:
    diagnostic_lists = get_list_value_or_empty_list(__wr_map_get(report_maps, "diagnostics"))
    for diagnostic_item in diagnostic_lists:
        return get_string_value_or_default(__wr_map_get(diagnostic_item, "code"), "")
    return ""


to run_error_report_assertions(report_maps: Map, stage_text: String, code_text: String) -> Nothing:
    assert value __wr_map_get(report_maps, "status") == "error"
    assert value __wr_map_get(report_maps, "stage") == stage_text
    assert value __wr_map_get(report_maps, "exit_code") == 2
    assert value get_diagnostics_count(report_maps) == 1
    assert value get_first_diagnostic_code(report_maps) == code_text
    return nothing


to test_check_pipeline_requires_input_path() -> Nothing:
    match run_check_pipeline(""):
        Err(message_text):
            assert value message_text == "missing input path"
            return nothing
        Ok(unexpected_report_maps):
            assert value __wr_map_get(unexpected_report_maps, "status") == ""
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to test_check_pipeline_lex_rejects_whitespace_only_source() -> Nothing:
    root = "target/wrela_v2_check_contract"
    path = "{root}/whitespace_only.wr"
    ensure_contract_directory(root)
    write_contract_fixture(path, "   \n  \n")

    match run_check_pipeline(path):
        Ok(report_maps):
            run_error_report_assertions(report_maps, "lex", "E-LEX-EMPTY")
            return nothing
        Err(error_text):
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


