to get_linker_contract_lowered_mir_or_empty_map(source_text: String) -> Map:
    token_result_maps = get_source_tokens(source_text)
    if __wr_map_get(token_result_maps, "ok") != true:
        return __wr_map_new()
    token_lists = get_frontend_lex_token_lists(token_result_maps)
    parse_result_maps = parse_tokens(token_lists)
    if __wr_map_get(parse_result_maps, "ok") != true:
        return __wr_map_new()
    ast_maps = __wr_map_get(parse_result_maps, "ast")
    type_result_maps = check_program(ast_maps)
    if __wr_map_get(type_result_maps, "ok") != true:
        return __wr_map_new()
    lower_result_maps = try_to_lower_program_to_mir(ast_maps)
    if __wr_map_get(lower_result_maps, "ok") != true:
        return __wr_map_new()
    return __wr_map_get(lower_result_maps, "mir")


to get_linker_contract_integer_list_count(value_lists: List) -> Integer:
    mutable count_number = 0
    for value_item in value_lists:
        value_item = value_item
        count_number = count_number + 1
    return count_number


to get_linker_contract_byte_at_index(value_lists: List, index_number: Integer) -> Integer:
    mutable current_index_number = 0
    for value_item in value_lists:
        if current_index_number == index_number:
            return value_item
        current_index_number = current_index_number + 1
    return -1


to check_linker_contract_links_source_text(source_text: String) -> Map:
    mir_program_maps = get_linker_contract_lowered_mir_or_empty_map(source_text)
    object_program_maps = __wr_map_get(emit_object_from_mir_program(mir_program_maps), "object")
    linker_input_maps = create_linker_input_from_object_program(object_program_maps)
    link_emit_result_maps = try_to_emit_linker_executable_from_input(linker_input_maps)
    assert value __wr_map_get(link_emit_result_maps, "ok") == true
    image_maps = __wr_map_get(link_emit_result_maps, "image")
    validate_result_maps = validate_linker_executable_image(image_maps)
    assert value __wr_map_get(validate_result_maps, "ok") == true
    return image_maps


to create_linker_contract_object_program_maps(
    symbol_name_text: String,
    symbol_offset_number: Integer,
    byte_a_number: Integer,
    byte_b_number: Integer
) -> Map:
    text_byte_lists = []
    __wr_list_push(text_byte_lists, byte_a_number)
    __wr_list_push(text_byte_lists, byte_b_number)
    section_lists = []
    __wr_list_push(section_lists, create_object_section_maps(".text", "code", text_byte_lists))
    symbol_lists = []
    __wr_list_push(symbol_lists, create_object_symbol_maps(symbol_name_text, ".text", symbol_offset_number))
    relocation_lists = []
    return create_object_program_maps(section_lists, symbol_lists, relocation_lists, text_byte_lists)


to ensure_linker_contract_directory(path: String) -> Nothing:
    match try_to_create_directory(path):
        Ok(create_result):
            return nothing
        Err(error_text):
            assert value error_text == ""
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to write_linker_contract_fixture(path: String, source: String) -> Nothing:
    match try_to_write_text(path, source):
        Ok(write_result):
            return nothing
        Err(error_text):
            assert value error_text == ""
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to test_linker_executable_links_precedence_program() -> Nothing:
    image_maps = check_linker_contract_links_source_text(
        "to run() -> Integer:\n    return 1 + 2 * 3\n"
    )
    assert value get_mir_text_prefix_match_flag(
        get_linker_image_signature_text(image_maps),
        "LNK|WRLX|mach-o-thin|darwin-arm64|"
    ) == 1
    return nothing


to test_linker_executable_links_parenthesized_program() -> Nothing:
    image_maps = check_linker_contract_links_source_text(
        "to run() -> Integer:\n    return (1 + 2) * 3\n"
    )
    assert value get_linker_image_entry_offset_number(image_maps) >= 0
    return nothing


to test_linker_executable_links_multi_object_programs() -> Nothing:
    object_a_maps = create_linker_contract_object_program_maps("run", 0, 10, 11)
    object_b_maps = create_linker_contract_object_program_maps("helper", 1, 20, 21)
    relocation_lists = []
    __wr_list_push(
        relocation_lists,
        create_object_relocation_maps(".text", 1, "run", "placeholder")
    )
    __wr_map_set(object_b_maps, "relocations", relocation_lists)

    object_program_lists = []
    __wr_list_push(object_program_lists, object_a_maps)
    __wr_list_push(object_program_lists, object_b_maps)
    linker_input_maps = create_linker_input_from_object_program_lists(object_program_lists)
    link_emit_result_maps = try_to_emit_linker_executable_from_input(linker_input_maps)
    assert value __wr_map_get(link_emit_result_maps, "ok") == true
    image_maps = __wr_map_get(link_emit_result_maps, "image")
    assert value __wr_map_get(validate_linker_executable_image(image_maps), "ok") == true
    assert value get_mir_text_prefix_match_flag(
        get_linker_image_signature_text(image_maps),
        "LNK|WRLX|mach-o-thin|darwin-arm64|"
    ) == 1
    return nothing


to test_linker_executable_is_deterministic_for_repeated_link() -> Nothing:
    image_a_maps = check_linker_contract_links_source_text(
        "to run() -> Integer:\n    return 1 + 2 * 3\n"
    )
    image_b_maps = check_linker_contract_links_source_text(
        "to run() -> Integer:\n    return 1 + 2 * 3\n"
    )
    assert value get_linker_image_signature_text(image_a_maps) == get_linker_image_signature_text(image_b_maps)
    bytes_a_lists = get_linker_image_byte_lists(image_a_maps)
    bytes_b_lists = get_linker_image_byte_lists(image_b_maps)
    assert value get_linker_contract_integer_list_count(bytes_a_lists) == get_linker_contract_integer_list_count(bytes_b_lists)
    mutable index_number = 0
    for byte_a in bytes_a_lists:
        byte_b = get_linker_contract_byte_at_index(bytes_b_lists, index_number)
        assert value byte_a == byte_b
        index_number = index_number + 1
    return nothing


to test_linker_executable_is_deterministic_for_repeated_multi_object_link() -> Nothing:
    object_a_maps = create_linker_contract_object_program_maps("run", 0, 10, 11)
    object_b_maps = create_linker_contract_object_program_maps("helper", 1, 20, 21)
    object_program_lists = []
    __wr_list_push(object_program_lists, object_a_maps)
    __wr_list_push(object_program_lists, object_b_maps)

    input_a_maps = create_linker_input_from_object_program_lists(object_program_lists)
    input_b_maps = create_linker_input_from_object_program_lists(object_program_lists)
    image_a_maps = __wr_map_get(try_to_emit_linker_executable_from_input(input_a_maps), "image")
    image_b_maps = __wr_map_get(try_to_emit_linker_executable_from_input(input_b_maps), "image")
    assert value get_linker_image_signature_text(image_a_maps) == get_linker_image_signature_text(image_b_maps)
    return nothing


to test_linker_executable_fails_when_entry_symbol_missing() -> Nothing:
    mir_program_maps = get_linker_contract_lowered_mir_or_empty_map("to run() -> Integer:\n    return 1 + 2\n")
    object_program_maps = __wr_map_get(emit_object_from_mir_program(mir_program_maps), "object")
    symbol_lists = __wr_map_get(object_program_maps, "symbols")
    filtered_symbol_lists = []
    for symbol_map in symbol_lists:
        if __wr_map_get(symbol_map, "name") != "run":
            __wr_list_push(filtered_symbol_lists, symbol_map)
    __wr_map_set(object_program_maps, "symbols", filtered_symbol_lists)

    linker_input_maps = create_linker_input_from_object_program(object_program_maps)
    link_emit_result_maps = try_to_emit_linker_executable_from_input(linker_input_maps)
    assert value __wr_map_get(link_emit_result_maps, "ok") == false
    assert value __wr_map_get(link_emit_result_maps, "reason") == "entry symbol was not found"
    return nothing


