to test_linker_executable_fails_closed_for_unknown_relocation_kind() -> Nothing:
    mir_program_maps = get_linker_contract_lowered_mir_or_empty_map("to run() -> Integer:\n    return 1 + 2\n")
    object_program_maps = __wr_map_get(emit_object_from_mir_program(mir_program_maps), "object")
    bad_relocation_lists = []
    bad_relocation_maps = __wr_map_new()
    __wr_map_set(bad_relocation_maps, "section_name", ".text")
    __wr_map_set(bad_relocation_maps, "offset", 0)
    __wr_map_set(bad_relocation_maps, "symbol_name", "run")
    __wr_map_set(bad_relocation_maps, "kind", "weird_kind")
    __wr_list_push(bad_relocation_lists, bad_relocation_maps)
    __wr_map_set(object_program_maps, "relocations", bad_relocation_lists)

    linker_input_maps = create_linker_input_from_object_program(object_program_maps)
    link_emit_result_maps = try_to_emit_linker_executable_from_input(linker_input_maps)
    assert value __wr_map_get(link_emit_result_maps, "ok") == false
    assert value __wr_map_get(link_emit_result_maps, "reason") == "unknown relocation kind"
    return nothing


