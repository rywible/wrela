so:
    Contract coverage for v2 test command behavior.

use run_test_command from application/test_command
use try_to_create_directory from host/fs
use try_to_write_text from host/fs


to ensure_test_contract_directory(path: String) -> Nothing:
    match try_to_create_directory(path):
        Ok(create_ok_value):
            create_ok_value = create_ok_value
            return nothing
        Err(create_error_text):
            create_error_text = create_error_text
            return nothing
        otherwise:
            return nothing
    return nothing


to ensure_test_contract_file(path: String, source_text: String) -> Nothing:
    match try_to_write_text(path, source_text):
        Ok(write_ok_value):
            write_ok_value = write_ok_value
            return nothing
        Err(write_error_text):
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to create_test_contract_project(root_path_text: String) -> Nothing:
    ensure_test_contract_directory(root_path_text)
    ensure_test_contract_directory("{root_path_text}/tests")
    return nothing


to test_test_command_returns_one_for_missing_path() -> Nothing:
    assert value run_test_command("target/wrela_v2_test_command_contract_missing") == 1
    return nothing


to test_test_command_runs_single_file_mode() -> Nothing:
    root_path_text = "target/wrela_v2_test_command_contract_single"
    create_test_contract_project(root_path_text)
    single_test_path_text = "{root_path_text}/tests/alpha_test.wr"
    ensure_test_contract_file(single_test_path_text, "to run() -> Integer:\n    return 0\n")
    assert value run_test_command(single_test_path_text) == 0
    return nothing


to test_test_command_returns_zero_for_project_with_passing_tests() -> Nothing:
    root_path_text = "target/wrela_v2_test_command_contract_pass"
    create_test_contract_project(root_path_text)
    ensure_test_contract_file("{root_path_text}/tests/alpha_test.wr", "to run() -> Integer:\n    return 0\n")
    ensure_test_contract_file("{root_path_text}/tests/beta_test.wr", "to run() -> Integer:\n    return 1 + 2\n")
    assert value run_test_command(root_path_text) == 0
    return nothing


to test_test_command_returns_two_when_any_test_fails() -> Nothing:
    root_path_text = "target/wrela_v2_test_command_contract_fail"
    create_test_contract_project(root_path_text)
    ensure_test_contract_file("{root_path_text}/tests/alpha_test.wr", "to run() -> Integer:\n    return 0\n")
    ensure_test_contract_file("{root_path_text}/tests/beta_test.wr", "to run() -> Integer:\n    return 1 +\n")
    assert value run_test_command(root_path_text) == 2
    return nothing
