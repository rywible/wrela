so:
    Contract coverage for v2 build command behavior.

use run_build_command from application/build_command
use run_init_command from application/init_command
use try_to_build_executable from application/build_runner
use get_build_runner_string_map_value_or_default from application/build_runner
use get_build_runner_output_root_path_or_default from application/build_runner
use get_build_runner_cert_root_path_or_default from application/build_runner
use try_to_create_directory from host/fs
use try_to_write_text from host/fs
use try_to_read_metadata from host/fs
use try_to_remove_file from host/fs
use try_to_remove_directory from host/fs
use run_verify_cert_command from application/verify_cert_command


to ensure_build_contract_directory(path: String) -> Nothing:
    match try_to_create_directory(path):
        Ok(create_ok_value):
            create_ok_value = create_ok_value
            return nothing
        Err(create_error_text):
            create_error_text = create_error_text
            return nothing
        otherwise:
            return nothing
    return nothing


to ensure_build_contract_file(path: String, source_text: String) -> Nothing:
    match try_to_write_text(path, source_text):
        Ok(write_ok_value):
            write_ok_value = write_ok_value
            return nothing
        Err(write_error_text):
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to clear_build_output_paths_for_contracts() -> Nothing:
    match try_to_remove_file("target/wrela_v2_build"):
        Ok(remove_file_ok_value):
            remove_file_ok_value = remove_file_ok_value
        Err(remove_file_error_text):
            remove_file_error_text = remove_file_error_text
        otherwise:
            nothing
    match try_to_remove_directory("target/wrela_v2_build"):
        Ok(remove_directory_ok_value):
            remove_directory_ok_value = remove_directory_ok_value
        Err(remove_directory_error_text):
            remove_directory_error_text = remove_directory_error_text
        otherwise:
            nothing
    return nothing


to create_valid_build_contract_project(root_path_text: String) -> Nothing:
    ensure_build_contract_directory(root_path_text)
    ensure_build_contract_directory("{root_path_text}/src")
    ensure_build_contract_file("{root_path_text}/src/main.wr", "to run() -> Integer:\n    return (1 + 2) * 3\n")
    return nothing


to test_build_command_requires_path() -> Nothing:
    assert value run_build_command("") == 1
    return nothing


to test_build_command_returns_two_for_invalid_program() -> Nothing:
    root_path_text = "target/wrela_v2_build_command_contract_invalid"
    ensure_build_contract_directory(root_path_text)
    ensure_build_contract_directory("{root_path_text}/src")
    ensure_build_contract_file("{root_path_text}/src/main.wr", "to run() -> Integer:\n    return 1 +\n")
    assert value run_build_command(root_path_text) == 2
    return nothing


to test_build_command_returns_zero_and_writes_artifacts_for_valid_program() -> Nothing:
    root_path_text = "target/wrela_v2_build_command_contract_valid"
    assert value run_init_command(root_path_text) == 0
    assert value run_build_command(root_path_text) == 0

    match try_to_read_metadata("target/wrela_v2_build/main.wrela.bin"):
        Ok(bin_metadata_maps):
            bin_metadata_maps = bin_metadata_maps
        Err(bin_metadata_error_text):
            assert value false == true
        otherwise:
            assert value false == true

    match try_to_read_metadata("target/wrela_v2_build/main.wrela.image"):
        Ok(image_metadata_maps):
            image_metadata_maps = image_metadata_maps
        Err(image_metadata_error_text):
            assert value false == true
        otherwise:
            assert value false == true
    match try_to_read_metadata("target/wrela_v2_cert/cert.json"):
        Ok(cert_metadata_maps):
            cert_metadata_maps = cert_metadata_maps
        Err(cert_metadata_error_text):
            assert value false == true
        otherwise:
            assert value false == true
    assert value run_verify_cert_command("target/wrela_v2_cert/cert.json") == 0
    match __wr_fs_read_bytes("target/wrela_v2_build/main.wrela.bin"):
        Ok(bin_bytes):
            bin_text_value = __wr_bytes_to_string(bin_bytes)
            match bin_text_value:
                String:
                    bin_text_value = bin_text_value
                otherwise:
                    assert value false == true
        Err(_):
            assert value false == true
        otherwise:
            assert value false == true
    return nothing


to test_build_command_cert_output_is_deterministic_for_repeated_builds() -> Nothing:
    root_path_text = "target/wrela_v2_build_command_contract_cert_deterministic"
    assert value run_init_command(root_path_text) == 0
    assert value run_build_command(root_path_text) == 0

    mutable first_cert_text = ""
    match __wr_fs_read_bytes("target/wrela_v2_cert/cert.json"):
        Ok(first_cert_bytes):
            first_cert_value = __wr_bytes_to_string(first_cert_bytes)
            match first_cert_value:
                String:
                    first_cert_text = first_cert_value
                otherwise:
                    assert value false == true
        Err(first_cert_error_text):
            assert value false == true
        otherwise:
            assert value false == true

    assert value run_build_command(root_path_text) == 0

    mutable second_cert_text = ""
    match __wr_fs_read_bytes("target/wrela_v2_cert/cert.json"):
        Ok(second_cert_bytes):
            second_cert_value = __wr_bytes_to_string(second_cert_bytes)
            match second_cert_value:
                String:
                    second_cert_text = second_cert_value
                otherwise:
                    assert value false == true
        Err(second_cert_error_text):
            assert value false == true
        otherwise:
            assert value false == true

    assert value first_cert_text == second_cert_text
    return nothing


to test_build_command_returns_two_when_output_root_cannot_be_created() -> Nothing:
    root_path_text = "target/wrela_v2_build_command_contract_output_root_blocked"
    create_valid_build_contract_project(root_path_text)
    clear_build_output_paths_for_contracts()
    ensure_build_contract_file("target/wrela_v2_build", "blocked")

    match try_to_build_executable(root_path_text):
        Err(error_text):
            assert value error_text == "build failed to create output directory"
        Ok(result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    assert value run_build_command(root_path_text) == 2

    clear_build_output_paths_for_contracts()
    return nothing


