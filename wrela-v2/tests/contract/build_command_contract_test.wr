to test_build_runner_string_helper_and_stage_errors_are_deterministic() -> Nothing:
    helper_maps = __wr_map_new()
    assert value get_build_runner_string_map_value_or_default(helper_maps, "missing", "fallback") == "fallback"
    __wr_map_set(helper_maps, "value", 7)
    assert value get_build_runner_string_map_value_or_default(helper_maps, "value", "fallback") == "7"

    match try_to_build_executable(""):
        Err(error_text):
            assert value error_text == "missing input path"
        Ok(result_maps):
            assert value false == true
        otherwise:
            assert value false == true

    match try_to_build_executable("target/wrela_v2_build_command_contract_missing_src"):
        Err(error_text):
            assert value error_text == "build failed at load"
        Ok(result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    return nothing


to test_build_runner_output_and_cert_root_helpers_honor_env_overrides() -> Nothing:
    __wr_env_set("WRELA_V2_BUILD_OUTPUT_ROOT", "")
    __wr_env_set("WRELA_V2_CERT_OUTPUT_ROOT", "")
    assert value get_build_runner_output_root_path_or_default() == "target/wrela_v2_build"
    assert value get_build_runner_cert_root_path_or_default() == "target/wrela_v2_cert"

    __wr_env_set("WRELA_V2_BUILD_OUTPUT_ROOT", "target/custom_build_root")
    __wr_env_set("WRELA_V2_CERT_OUTPUT_ROOT", "target/custom_cert_root")
    assert value get_build_runner_output_root_path_or_default() == "target/custom_build_root"
    assert value get_build_runner_cert_root_path_or_default() == "target/custom_cert_root"

    __wr_env_set("WRELA_V2_BUILD_OUTPUT_ROOT", "")
    __wr_env_set("WRELA_V2_CERT_OUTPUT_ROOT", "")
    return nothing


to test_build_runner_success_result_map_fields_are_stable() -> Nothing:
    root_path_text = "target/wrela_v2_build_command_contract_runner_ok"
    assert value run_init_command(root_path_text) == 0

    match try_to_build_executable(root_path_text):
        Ok(result_maps):
            assert value __wr_map_get(result_maps, "resolved_path") == "{root_path_text}/src/main.wr"
            assert value __wr_map_get(result_maps, "output_path") == "target/wrela_v2_build/main.wrela.bin"
            assert value __wr_map_get(result_maps, "image_path") == "target/wrela_v2_build/main.wrela.image"
            signature_text = "{__wr_map_get(result_maps, \"image_signature\")}"
            signature_bytes = __wr_bytes_to_list(__wr_bytes_from_string(signature_text))
            expected_prefix_bytes = __wr_bytes_to_list(__wr_bytes_from_string("LNK|WRLX|"))
            mutable prefix_index = 0
            for expected_prefix_byte in expected_prefix_bytes:
                mutable current_signature_byte = -1
                mutable current_signature_index = 0
                for signature_byte in signature_bytes:
                    if current_signature_index == prefix_index:
                        current_signature_byte = signature_byte
                    current_signature_index = current_signature_index + 1
                assert value current_signature_byte == expected_prefix_byte
                prefix_index = prefix_index + 1
        Err(error_text):
            assert value false == true
        otherwise:
            assert value false == true
    return nothing
