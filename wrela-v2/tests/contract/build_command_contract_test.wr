    return nothing


to test_build_command_returns_two_when_launcher_path_is_directory() -> Nothing:
    root_path_text = "target/wrela_v2_build_command_contract_launcher_path_directory"
    create_valid_build_contract_project(root_path_text)
    clear_build_output_paths_for_contracts()
    ensure_build_contract_directory("target/wrela_v2_build/main.wrela.bin")

    match try_to_build_executable(root_path_text):
        Err(error_text):
            assert value error_text == "build failed to write launcher"
        Ok(result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    assert value run_build_command(root_path_text) == 2

    clear_build_output_paths_for_contracts()
