to write_check_command_fixture(path: String, source: String) -> Nothing:
    match try_to_write_text(path, source):
        Ok(write_result):
            return nothing
        Err(error_text):
            assert value error_text == ""
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


