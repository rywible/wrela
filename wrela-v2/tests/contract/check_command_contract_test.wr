            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to test_try_to_run_shadow_v1_check_is_callable() -> Nothing:
    __wr_env_set("WRELA_V1_BIN", "")
    __wr_env_set("WRELA_WORKSPACE_ROOT", "")
    match try_to_run_shadow_v1_check("missing.wr"):
        Err(message_text):
            assert value message_text == "shadow check disabled"
            return nothing
        Ok(status_code):
            assert value status_code == 0
            assert value false == true
            return nothing
        otherwise:
            assert value false == true
            return nothing
    return nothing


to test_get_string_value_or_default_for_check_uses_fallback_only_for_nothing() -> Nothing:
    assert value get_string_value_or_default_for_check("ok", "fallback") == "ok"
    missing_value = __wr_map_get(__wr_map_new(), "missing")
    assert value get_string_value_or_default_for_check(missing_value, "fallback") == "fallback"
    return nothing


