            get_platform_operation_presence_flag(runtime_ports.reactor_port.ops, "create_reactor_handle")
            get_platform_operation_value_or_empty_text(runtime_ports.reactor_port.ops, "create_reactor_handle")
            ignore result run_reactor_port_lifecycle(runtime_ports, 9, 1)
            ignore result run_clock_port_now_ns(runtime_ports)
            ignore result run_clock_port_sleep_ms(runtime_ports, 1)
            runtime_fs_path = "target/wrela_v2_runtime_touchpoint.txt"
            ignore result try_to_run_fs_write_text(runtime_ports, runtime_fs_path, "ok\n")
            ignore result try_to_run_fs_read_text(runtime_ports, runtime_fs_path)
            ignore result try_to_run_fs_read_metadata(runtime_ports, runtime_fs_path)
            ignore result try_to_run_process_port(runtime_ports, "/bin/echo", ["ok"], ".", 1000)
            ignore result try_to_get_process_port_cwd(runtime_ports)
        Err(runtime_error_text):
            runtime_error_text = runtime_error_text
        otherwise:
            nothing

    linux_target = PlatformTarget()
    linux_target.host_os_name = "linux"
    linux_target.host_architecture = "x86_64"
    match try_to_create_platform_ports(linux_target, true):
