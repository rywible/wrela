to test_application_coverage_touchpoints_are_callable() -> Nothing:
    match try_to_remove_file("target/wrela_v2_build"):
        Ok(remove_file_ok_value):
            remove_file_ok_value = remove_file_ok_value
        Err(remove_file_error_text):
            remove_file_error_text = remove_file_error_text
        otherwise:
            nothing
    match try_to_remove_directory("target/wrela_v2_build"):
        Ok(remove_directory_ok_value):
            remove_directory_ok_value = remove_directory_ok_value
        Err(remove_directory_error_text):
            remove_directory_error_text = remove_directory_error_text
        otherwise:
            nothing

    assert value run_build_command("") == 1
    assert value run_build_command("src/main.wr") == 2
    match try_to_build_executable(""):
        Err(build_runner_error_text):
            assert value build_runner_error_text == "missing input path"
        Ok(build_runner_result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    match try_to_build_executable("target/wrela_v2_build_runner_touchpoint_missing"):
        Err(build_runner_error_text):
            assert value build_runner_error_text == "build failed at load"
        Ok(build_runner_result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    build_runner_helper_maps = __wr_map_new()
    assert value get_build_runner_string_map_value_or_default(
        build_runner_helper_maps,
        "missing",
        "fallback"
    ) == "fallback"
    __wr_map_set(build_runner_helper_maps, "value", 42)
    assert value get_build_runner_string_map_value_or_default(
        build_runner_helper_maps,
        "value",
        "fallback"
    ) == "42"
    __wr_env_set("WRELA_V2_BUILD_OUTPUT_ROOT", "")
    __wr_env_set("WRELA_V2_CERT_OUTPUT_ROOT", "")
    assert value get_build_runner_output_root_path_or_default() == "target/wrela_v2_build"
    assert value get_build_runner_cert_root_path_or_default() == "target/wrela_v2_cert"
    __wr_env_set("WRELA_V2_BUILD_OUTPUT_ROOT", "target/touch_build_root")
    __wr_env_set("WRELA_V2_CERT_OUTPUT_ROOT", "target/touch_cert_root")
    assert value get_build_runner_output_root_path_or_default() == "target/touch_build_root"
    assert value get_build_runner_cert_root_path_or_default() == "target/touch_cert_root"
    __wr_env_set("WRELA_V2_BUILD_OUTPUT_ROOT", "")
    __wr_env_set("WRELA_V2_CERT_OUTPUT_ROOT", "")
    self_host_stage_root = get_deterministic_stage_root("target/wrela_v2_touch", ".")
    __wr_fs_mkdir_all(self_host_stage_root) otherwise nothing
    self_host_report_maps = __wr_map_new()
    __wr_map_set(self_host_report_maps, "stage0_status", "ok")
    __wr_map_set(self_host_report_maps, "stage1_status", "ok")
    __wr_map_set(self_host_report_maps, "stage2_status", "ok")
    __wr_map_set(self_host_report_maps, "stage0_toolchain_hash", "a")
    __wr_map_set(self_host_report_maps, "stage1_toolchain_hash", "b")
    __wr_map_set(self_host_report_maps, "stage2_toolchain_hash", "c")
    __wr_map_set(self_host_report_maps, "repro_match", true)
    __wr_map_set(self_host_report_maps, "entry_path", "entry")
    __wr_map_set(self_host_report_maps, "workspace_root", "workspace")
    __wr_map_set(self_host_report_maps, "timestamp_ns", 7)
    try_to_write_self_host_report(
        "{self_host_stage_root}/self_host_report.json",
        self_host_report_maps
    ) otherwise nothing

    build_runner_root = "target/wrela_v2_build_runner_touchpoint_project"
    assert value run_init_command(build_runner_root) == 0
    assert value run_build_command(build_runner_root) == 0
    match try_to_build_executable(build_runner_root):
        Ok(build_runner_result_maps):
            assert value __wr_map_get(build_runner_result_maps, "resolved_path") == "{build_runner_root}/src/main.wr"
            assert value __wr_map_get(build_runner_result_maps, "output_path") == "target/wrela_v2_build/main.wrela.bin"
            assert value __wr_map_get(build_runner_result_maps, "image_path") == "target/wrela_v2_build/main.wrela.image"
        Err(build_runner_error_text):
            assert value false == true
        otherwise:
            assert value false == true

    match try_to_remove_file("target/wrela_v2_build"):
        Ok(remove_file_ok_value):
            remove_file_ok_value = remove_file_ok_value
        Err(remove_file_error_text):
            remove_file_error_text = remove_file_error_text
        otherwise:
            nothing
    match try_to_remove_directory("target/wrela_v2_build"):
        Ok(remove_directory_ok_value):
            remove_directory_ok_value = remove_directory_ok_value
        Err(remove_directory_error_text):
            remove_directory_error_text = remove_directory_error_text
        otherwise:
            nothing
    write_check_command_fixture("target/wrela_v2_build", "blocked")
    match try_to_build_executable(build_runner_root):
        Err(build_runner_error_text):
            assert value build_runner_error_text == "build failed to create output directory"
        Ok(build_runner_result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    assert value run_build_command(build_runner_root) == 2
    match try_to_remove_file("target/wrela_v2_build"):
        Ok(remove_file_ok_value):
            remove_file_ok_value = remove_file_ok_value
        Err(remove_file_error_text):
            remove_file_error_text = remove_file_error_text
        otherwise:
            nothing
    match try_to_remove_directory("target/wrela_v2_build"):
        Ok(remove_directory_ok_value):
            remove_directory_ok_value = remove_directory_ok_value
        Err(remove_directory_error_text):
            remove_directory_error_text = remove_directory_error_text
        otherwise:
            nothing

    ensure_check_command_contract_directory("target/wrela_v2_build/main.wrela.image")
    match try_to_build_executable(build_runner_root):
        Err(build_runner_error_text):
            assert value build_runner_error_text == "build failed to write image"
        Ok(build_runner_result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    assert value run_build_command(build_runner_root) == 2
    match try_to_remove_file("target/wrela_v2_build"):
        Ok(remove_file_ok_value):
            remove_file_ok_value = remove_file_ok_value
        Err(remove_file_error_text):
            remove_file_error_text = remove_file_error_text
        otherwise:
            nothing
    match try_to_remove_directory("target/wrela_v2_build"):
        Ok(remove_directory_ok_value):
            remove_directory_ok_value = remove_directory_ok_value
        Err(remove_directory_error_text):
            remove_directory_error_text = remove_directory_error_text
        otherwise:
            nothing

    ensure_check_command_contract_directory("target/wrela_v2_build/main.wrela.bin")
    match try_to_build_executable(build_runner_root):
        Err(build_runner_error_text):
            assert value build_runner_error_text == "build failed to write launcher"
        Ok(build_runner_result_maps):
            assert value false == true
        otherwise:
            assert value false == true
    assert value run_build_command(build_runner_root) == 2
    match try_to_remove_file("target/wrela_v2_build"):
        Ok(remove_file_ok_value):
            remove_file_ok_value = remove_file_ok_value
        Err(remove_file_error_text):
            remove_file_error_text = remove_file_error_text
        otherwise:
            nothing
    match try_to_remove_directory("target/wrela_v2_build"):
        Ok(remove_directory_ok_value):
            remove_directory_ok_value = remove_directory_ok_value
        Err(remove_directory_error_text):
            remove_directory_error_text = remove_directory_error_text
        otherwise:
            nothing

    build_runner_cases_root = "target/wrela_v2_build_runner_touchpoint_cases"
    ensure_check_command_contract_directory(build_runner_cases_root)
    ensure_check_command_contract_directory("{build_runner_cases_root}/src")
    write_check_command_fixture(
        "{build_runner_cases_root}/src/lex_tab.wr",
        "to run() -> Integer:\n\treturn 1\n"
    )
    write_check_command_fixture(
        "{build_runner_cases_root}/src/parse_fail.wr",
        "to run() -> Integer:\n    return 1 +\n"
    )
    write_check_command_fixture(
        "{build_runner_cases_root}/src/type_fail.wr",
        "to run() -> Integer:\n    return 1 + true\n"
    )

