    assert value get_string_value_or_default_for_check(__wr_map_get(check_default_maps, "s"), "fallback") == "fallback"
    assert value get_integer_value_or_default(__wr_map_get(check_default_maps, "n"), 8) == 8
    assert value get_string_value_or_default(__wr_map_get(check_default_maps, "s"), "fallback-two") == "fallback-two"
    normalized_maps = get_map_value_or_empty_map(__wr_map_get(check_default_maps, "map"))
    normalized_maps = normalized_maps
    normalized_lists = get_list_value_or_empty_list(__wr_map_get(check_default_maps, "list"))
