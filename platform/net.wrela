// The server host's networking (language.md §12): a room's journal and its connections. The host
// carries the bytes and keeps the records durably; `std::net` decides what they are. Each of
// these is a command the host never answers.
//
// What the host does with a call's commands: it keeps every record the call gave it (`keep`,
// `compact`) durably, in order, before it sends anything the call sent (`send`) or closes what
// it closed (`close`). If it can't keep them, it sends nothing and starts the room again from
// what it had kept.

use std::host::request
use std::input::{Event, events, payload}
use std::net::{Reduce, Record, Room, Step}
use std::pack::{Pack, pack, unpack}

/// The connection a room's journal comes from: before any live connection's events, the server
/// host gives a room it starts its kept records, oldest first, as messages from this one.
pub const JOURNAL: u32 = 0

/// The bit the host sets on a connection's number when it gives back a message that trapped the
/// room alone, on a fresh instance (`Room::poisoned`).
pub const POISONED: u32 = 2147483648

/// A room compacts once its journal holds this many entries past its snapshot.
pub const COMPACT_AFTER: u64 = 1024

fn word(bytes: mut Vec<u8>, x: u32) {
    for k in 0..4 {
        bytes.push(u8((x >> (8 * k)) & 255))
    }
}

/// Keeps `record` (a packed `Record`) at the end of the room's journal.
@server
pub fn keep(record: [u8]) {
    let _ = request("net/keep", record)
}

/// Replaces the room's journal with `snapshot` (a packed `Record::Snapshot`): the host writes it
/// whole, then drops the records before it.
@server
pub fn compact(snapshot: [u8]) {
    let _ = request("net/compact", snapshot)
}

/// Sends `bytes` on connection `conn`, once the call's records are kept.
@server
pub fn send(conn: u32, bytes: [u8]) {
    var body: Vec<u8> = Vec::with_capacity(4 + bytes.len())
    word(mut body, conn)
    for b in bytes {
        body.push(b)
    }
    let _ = request("net/send", body)
}

/// Closes connection `conn`, after the call's sends.
@server
pub fn close(conn: u32) {
    var body: Vec<u8> = Vec::new()
    word(mut body, conn)
    let _ = request("net/close", body)
}

/// Carries out a room's step: its records kept, then its sends, then its closes.
@server
pub fn carry_out<S: Clone + Pack, T: Clone + Pack>(step: Step<S, T>) {
    for r in step.records {
        keep(pack(r.clone()))
    }
    for s in step.sends {
        send(s.0, s.1)
    }
    for c in step.closes {
        close(c)
    }
}

/// Runs a room for a server's `serve`, at the room's time `at` (milliseconds): reads the events
/// since the last call (after a start, its journal first) and carries out what the room makes of
/// them, compacting its journal once it's long. A journal record this program can't read means
/// the journal isn't its own: that's a panic, and the host keeps the room closed.
@server
pub fn serve_room<S: Reduce<T> + Clone + Pack, T: Clone + Pack>(room: mut Room<S, T>, at: u64) {
    for e in events() {
        match e {
            Event::Message { conn, .. } => {
                let Some(bytes) = payload(e) else { continue }
                if conn == JOURNAL {
                    match unpack::<Record<S, T>>(take bytes) {
                        Ok(r) => room.restore(r),
                        Err(_) => panic("a journal record this program can't read"),
                    }
                } else if conn >= POISONED {
                    carry_out(room.poisoned(conn - POISONED, take bytes))
                } else {
                    carry_out(room.receive(conn, take bytes, at))
                }
            },
            Event::Connection { conn, open } => {
                if open {
                    room.opened(conn)
                } else {
                    room.closed(conn)
                }
            },
            _ => {},
        }
    }
    if room.since_snapshot() > COMPACT_AFTER {
        compact(pack(room.compact()))
    }
}
