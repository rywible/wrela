// The messages between the console and a game's session program: list a profile's saves,
// prepare a save, start the game, and export or import a save. The console sends a `Request`
// and the session program answers with a `Reply`. The hosts carry the bytes and never read
// them; how a game keeps its saves is the session program's choice.
use std::serialize::{Serialize, load, save}

pub struct SaveInfo: Clone + Serialize {
    pub slot: String,
    pub label: String,
    pub description: String,
    pub saved: u32,
}

pub enum Request: Clone + Serialize {
    List { profile: String },
    Prepare { profile: String, slot: String },
    Start,
    Export { profile: String, slot: String },
    Import { profile: String, bytes: Vec<u8> },
}

pub enum Reply: Clone + Serialize {
    Saves { entries: Vec<SaveInfo> },
    Ready,
    Started,
    Exported { bytes: Vec<u8> },
    Imported,
    Error { message: String },
}

/// An exported save: the game's name and its save format's version come before the save's
/// bytes, so a game checks them before it reads `body`.
pub struct SaveFile: Clone + Serialize {
    pub game: String,
    pub version: u32,
    pub saved: u32,
    pub body: Vec<u8>,
}

/// Whether `key` is a valid profile key: 1 to 64 of a-z, 0-9 and `-`. A key is part of a storage
/// path, so it can't leave its directory; the profile's name, which a person can change, is apart.
pub fn valid_key(key: str) -> bool {
    if key.is_empty() || key.len() > 64 { return false }
    for i in 0..key.len() {
        let c = key.byte(i)
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45) { return false }
    }
    true
}

@test
fn profile_keys_cannot_escape_storage_or_expand_without_bound() {
    assert(valid_key("player-1"))
    for key in ["", "../save", "a/b", "a\\b", "a%2fb", "a:b", "A", "."] {
        assert(!valid_key(key), key)
    }
}

@test
fn session_replies_keep_game_owned_save_metadata() {
    var entries: Vec<SaveInfo> = Vec::new()
    entries.push(
        SaveInfo {
            slot: String::from("continue"),
            label: String::from("Continue"),
            description: String::from("A game supplied summary"),
            saved: 42,
        },
    )
    let back: Result<Reply, std::serialize::LoadError> = load(save(Reply::Saves { entries }))
    match back {
        Ok(Reply::Saves { entries }) => assert(entries.len() == 1 && entries[0].saved == 42),
        _ => assert(false, "session reply round trip"),
    }
}
