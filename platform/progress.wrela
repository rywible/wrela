// What an account's character has done in the MMO's fights: the bosses it beat, how often, and its
// best time. A fight is checked where it's fought, in its room (mmo/combat), by running it again
// from its players' logs, and a room knows who its players are from the passes they joined with
// (pass.wrela), checked with the Worker's keys. So a room writes each win down where only it can
// write: in the instance `server`'s store, which every room shares (spec §19.6), one row a winner
// (`won/<name's key><fight>`, a `Won`). A room makes no calls, and an account's store is its own,
// so the account reads it from there:
//
// - **Recording a win.** The player's client, once its fight settles won, asks its account to
//   record it (`Request::Record`, by the fight's id). The account asks the instance `server`
//   (`Inner::Won`) for its own name's row of that fight. If there is one, it's counted on the
//   account's progress (`f`, a `Progress`) once: a fight counts only if it ended after the last
//   one counted, so a record asked again (or by a second tab) counts nothing more.
// - **Deleting an account.** The deletion's sweep tells `server` to forget the name's rows
//   (`Note::Forget`), and its name is let go only once that's said done, so a later holder of
//   the name never reads them. A pass outlives its account by `pass::LIFE_MS` at most, so a win
//   written in that while is left in `server`'s store under a name no account has, unread unless
//   the name's next holder records that very fight.
//
// The rows are the room's to write and the store's to keep: nothing in the browser says who won.

use account::{key, under}
use names::Name
use server::{Back, Engine, Game, Inner, Job, Kind, Note, Step, blank_job}
use std::serialize::{Serialize, save}
use wire::{Beaten, Request}

/// Where a room writes its fights' winners, in the instance `server`'s store.
pub const WON: Text = "won/"
/// The instance whose store the rooms share (spec §19.5).
pub const ROOMS: Text = "server"
/// The longest fight id (`fight_id`): a room's name (at most 256 bytes) and 13 bytes more.
pub const MAX_FIGHT: u32 = 269
/// The account's record of its progress.
pub const PROGRESS: Text = "f"
/// The most bosses an account's progress counts.
pub const MOST_BOSSES: u32 = 64
/// The rows a forget deletes a call.
const FORGET_PAGE: u32 = 64

/// A win, as its room wrote it: which boss, the fight's frames (its time), and when it ended (Unix
/// milliseconds, the room's clock).
pub struct Won: Clone + Eq + Serialize {
    pub boss: u32,
    pub frames: u32,
    pub at: u64,
}

/// An account's progress: each boss it has beaten, and when the last fight it counted ended.
pub struct Progress: Clone + Eq + Serialize {
    pub beaten: Vec<Beaten>,
    pub latest: u64,
}

pub fn no_progress() -> Progress {
    Progress { beaten: Vec::new(), latest: 0 }
}

/// A fight's id: its room's name, `/`, the room's time it began (8 bytes, big-endian) and its
/// number in the room (4 bytes): what's unique to it, and the same in every peer's state.
pub fn fight_id(room: str, began: u64, n: u32) -> Vec<u8> {
    var k: Vec<u8> = Vec::new()
    for i in 0..room.len() {
        k.push(room.byte(i))
    }
    k.push(47)
    for i in 0..8 {
        k.push(u8((began >> (8 * (7 - i))) & 255))
    }
    for i in 0..4 {
        k.push(u8((n >> (8 * (3 - i))) & 255))
    }
    k
}

/// Whether `fight` is shaped as a fight's id: a room's name, `/`, then 12 bytes.
pub fn is_fight(fight: [u8]) -> bool {
    fight.len() > 13 && fight.len() <= MAX_FIGHT && fight[fight.len() - 13] == 47
}

/// `won/<name's key>`: where every win of name `name` is.
pub fn won_prefix(name: Name) -> Vec<u8> {
    key(WON, names::key(name))
}

/// `won/<name's key><fight>`: name `name`'s win of fight `fight`.
pub fn won_key(name: Name, fight: [u8]) -> Vec<u8> {
    var k = won_prefix(name)
    for b in fight {
        k.push(b)
    }
    k
}

/// What a room writes for a win of boss `boss` in `frames`, ended at `at`.
pub fn won_row(boss: u32, frames: u32, at: u64) -> Vec<u8> {
    save(Won { boss, frames, at })
}

/// `p` with win `w` counted, if it ended after the last fight `p` counted: then it's another of
/// its boss's wins, and its best if it's quicker. None if it counts nothing (counted before, or
/// a boss past `MOST_BOSSES` new ones).
pub fn credited(p: Progress, w: Won) -> Option<Progress> {
    if w.at <= p.latest {
        return None
    }
    var out = p.clone()
    out.latest = w.at
    for i in 0..out.beaten.len() {
        if out.beaten[i].boss == w.boss {
            out.beaten[i].wins += 1
            out.beaten[i].best = min(out.beaten[i].best, w.frames)
            out.beaten[i].last = w.at
            return Some(out)
        }
    }
    if out.beaten.len() >= MOST_BOSSES {
        return None
    }
    out.beaten.push(Beaten { boss: w.boss, wins: 1, best: w.frames, first: w.at, last: w.at })
    Some(out)
}

impl<G: Game> Engine<G> {
    /// Call `conn` to the instance `server`: a name's win of a fight, if its room wrote one.
    pub(package) fn rooms_called(mut self, conn: u32, inner: Inner) {
        let Inner::Won { name, fight } = inner.clone() else {
            self.back(conn, Back::Refused { why: String::from("The rooms answer only a win.") })
            return
        }
        if !is_fight(fight) {
            self.back(conn, Back::Missing)
            return
        }
        var j = blank_job(conn, Request::Me)
        j.inner = Some(inner.clone())
        self.get(won_key(name, fight), Step::WonRead, take j)
    }

    /// A message to the instance `server`: forget a name's wins.
    pub(package) fn rooms_delivered(mut self, job: take Job) {
        let j = take job
        let Note::Forget { name } = j.note.clone() else {
            self.done(j)
            return
        }
        let from = won_prefix(name)
        var to = won_prefix(name)
        to.push(255)
        self.scan_range(take from, take to, FORGET_PAGE, Step::ForgetScan, take j)
    }

    pub(package) fn rooms_answer(mut self, job: take Job, answer: Vec<u8>) {
        let j = take job
        match j.step {
            Step::WonRead => {
                let Some(Inner::Won { name, fight }) = j.inner.clone() else { return }
                let w: Option<Won> = self.latest_as(won_key(name, fight), answer)
                match w {
                    Some(w) => self.back(j.conn, Back::Won { won: w.clone() }),
                    None => self.back(j.conn, Back::Missing),
                }
            },
            Step::ForgetScan => {
                let Some(scan) = self.scanned(j, answer) else { return }
                for e in scan.entries {
                    self.delete(e.key.clone())
                }
                if scan.entries.len() >= FORGET_PAGE && !scan.last.is_empty() {
                    var from = scan.last.clone()
                    from.push(0)
                    let to = j.range.to.clone()
                    self.scan_range(take from, take to, FORGET_PAGE, Step::ForgetScan, take j)
                    return
                }
                self.done(j)
            },
            _ => {},
        }
    }
}

// ---- tests --------------------------------------------------------------------------------------

@test
fn a_win_counts_once_and_keeps_the_best_time() {
    let p = no_progress()
    let Some(p) = credited(p, Won { boss: 1, frames: 900, at: 100 }) else { panic("a first win") }
    assert(p.beaten.len() == 1 && p.beaten[0].wins == 1 && p.beaten[0].best == 900)
    assert(credited(p, Won { boss: 1, frames: 10, at: 100 }).is_none(), "the same fight again")
    assert(credited(p, Won { boss: 1, frames: 10, at: 50 }).is_none(), "an older one")
    let Some(p) = credited(p, Won { boss: 1, frames: 1200, at: 200 }) else { panic("slower") }
    assert(p.beaten[0].wins == 2 && p.beaten[0].best == 900 && p.beaten[0].last == 200)
    let Some(p) = credited(p, Won { boss: 1, frames: 600, at: 300 }) else { panic("quicker") }
    assert(p.beaten[0].best == 600 && p.beaten[0].first == 100, "the best, and the first kept")
    let Some(p) = credited(p, Won { boss: 2, frames: 5, at: 400 }) else { panic("another boss") }
    assert(p.beaten.len() == 2 && p.beaten[1].wins == 1 && p.latest == 400)
}

@test
fn a_fight_id_is_its_room_then_when_it_began_and_its_number() {
    let f = fight_id("fight-ab12", 0x0102, 3)
    assert(is_fight(f) && f.len() == 10 + 13)
    assert(f[10] == 47 && f[17] == 1 && f[18] == 2 && f[22] == 3)
    assert(!is_fight([1, 2, 3]), "too short")
    var no_slash = f.clone()
    no_slash[10] = 0
    assert(!is_fight(no_slash), "no slash before its 12 bytes")
    let n = Name { title: 1, front: 2, back: 3, epithet: 4 }
    let k = won_key(n, f)
    assert(k.len() == 4 + 8 + f.len(), "under the name's prefix")
    let p = won_prefix(n)
    for i in 0..p.len() {
        assert(k[i] == p[i])
    }
}
