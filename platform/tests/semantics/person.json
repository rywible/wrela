[
  {"until": "document.querySelector('.wrela-semantics input') !== null && document.querySelector('.wrela-semantics a').href.endsWith('#next')"},
  {"method": "Input.dispatchMouseEvent", "params": {"type": "mousePressed", "x": 20, "y": 30, "button": "left", "buttons": 1, "clickCount": 1}},
  {"method": "Input.dispatchMouseEvent", "params": {"type": "mouseReleased", "x": 20, "y": 30, "button": "left", "buttons": 0, "clickCount": 1}},
  {"until": "document.activeElement !== null && document.activeElement.tagName === 'INPUT'"},
  {"method": "Input.dispatchKeyEvent", "params": {"type": "keyDown", "key": "a", "code": "KeyA", "windowsVirtualKeyCode": 65, "text": "a"}},
  {"method": "Input.dispatchKeyEvent", "params": {"type": "keyUp", "key": "a", "code": "KeyA", "windowsVirtualKeyCode": 65}},
  {"wait": 0.3},
  {"method": "Input.insertText", "params": {"text": "é"}},
  {"wait": 0.3},
  {"method": "Input.imeSetComposition", "params": {"text": "かな", "selectionStart": 2, "selectionEnd": 2}},
  {"wait": 0.3},
  {"method": "Input.insertText", "params": {"text": "仮名"}},
  {"wait": 0.3},
  {"method": "Input.dispatchKeyEvent", "params": {"type": "keyDown", "key": "Enter", "code": "Enter", "windowsVirtualKeyCode": 13, "text": "\r"}},
  {"method": "Input.dispatchKeyEvent", "params": {"type": "keyUp", "key": "Enter", "code": "Enter", "windowsVirtualKeyCode": 13}},
  {"wait": 0.3},
  {"method": "Input.dispatchMouseEvent", "params": {"type": "mousePressed", "x": 20, "y": 10, "button": "left", "buttons": 1, "clickCount": 1}},
  {"method": "Input.dispatchMouseEvent", "params": {"type": "mouseReleased", "x": 20, "y": 10, "button": "left", "buttons": 0, "clickCount": 1}},
  {"wait": 0.3},
  {"until": "location.hash.startsWith('#test')"}
]
