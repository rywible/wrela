/// How many names there are.
pub fn count() -> u64 {
    u64(TITLES.len()) * u64(FRONTS.len()) * u64(BACKS.len()) * u64(EPITHETS.len())
}

/// The longest a name's text can be, in bytes: what the longest of each list makes.
pub const LONGEST: u32 = 72

/// The name that `seed` draws (eight random bytes, as a number): each part by its share of the
/// seed. Every name is as likely as any other, to within one part in 2^40.
pub fn draw(seed: u64) -> Name {
    var x = seed
    let title = u32(x % u64(TITLES.len()))
    x = x / u64(TITLES.len())
    let front = u32(x % u64(FRONTS.len()))
    x = x / u64(FRONTS.len())
    let back = u32(x % u64(BACKS.len()))
    x = x / u64(BACKS.len())
    let epithet = u32(x % u64(EPITHETS.len()))
    Name { title, front, back, epithet }
}

/// Whether `n`'s parts are all in their lists.
pub fn valid(n: Name) -> bool {
    n.title < TITLES.len() &&
        n.front < FRONTS.len() &&
        n.back < BACKS.len() &&
        n.epithet < EPITHETS.len()
}

/// The noun of `n`: its two halves together ("Wobblesnout").
pub fn noun(n: Name) -> String {
    f"{FRONTS[n.front]}{BACKS[n.back]}"
}

/// `n` as the player sees it: "Sir Wobblesnout the Unhurried". A part out of its list is shown as
/// nothing, never read past it.
pub fn text(n: Name) -> String {
    if !valid(n) {
        return String::new()
    }
    f"{TITLES[n.title]} {noun(n)} the {EPITHETS[n.epithet]}"
}

/// `n` as a store key's bytes: its four parts, big-endian, so each name has one key.
pub fn key(n: Name) -> Vec<u8> {
    var out: Vec<u8> = Vec::with_capacity(8)
    for part in [n.title, n.front, n.back, n.epithet] {
        out.push(u8(part >> 8))
        out.push(u8(part & 255))
    }
    out
}

/// The name whose key (`key`) is `bytes`, if they are one.
pub fn from_key(bytes: [u8]) -> Option<Name> {
    if bytes.len() != 8 {
        return None
    }
    let at = |i: u32| -> u32 { (u32(bytes[2 * i]) << 8) | u32(bytes[2 * i + 1]) }
    let n = Name { title: at(0), front: at(1), back: at(2), epithet: at(3) }
    if !valid(n) {
        return None
    }
    Some(n)
}

/// The name whose text (`text`) is `s`, if one's is: every noun is unique, so at most one is.
pub fn parse(s: str) -> Option<Name> {
    if s.len() > LONGEST {
        return None
    }
    for t in 0..TITLES.len() {
        let head = f"{TITLES[t]} "
        if !s.starts_with(head.as_str()) {
            continue
        }
        for e in 0..EPITHETS.len() {
            let tail = f" the {EPITHETS[e]}"
            if s.len() < head.len() + tail.len() || !s.ends_with(tail.as_str()) {
                continue
            }
            let middle = s.slice(head.len(), s.len() - tail.len())
            for f in 0..FRONTS.len() {
                if !middle.starts_with(FRONTS[f]) {
                    continue
                }
                let rest = middle.slice(FRONTS[f].len(), middle.len())
                for b in 0..BACKS.len() {
                    if rest == BACKS[b] {
                        return Some(Name { title: t, front: f, back: b, epithet: e })
                    }
                }
            }
        }
    }
    None
}

/// The parts that names starting with a search's parts may have: its titles, its fronts each with
/// the backs that may follow it (a noun's prefix can end in either half), and its epithets, each
/// in its list's order.
pub struct Matching: Clone {
    pub titles: Vec<u32>,
    pub fronts: Vec<u32>,
    pub backs: Vec<Vec<u32>>,
    pub epithets: Vec<u32>,
}

/// Whether byte `b` may be in a name: a letter, a space or a hyphen.
pub fn name_char(b: u8) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 32 || b == 45
}

/// `b` in lower case, ASCII only.
fn lower_byte(b: u8) -> u8 {
    if b >= 65 && b <= 90 { b + 32 } else { b }
}

/// Whether `s` starts with `prefix`, in any case (ASCII). Nothing is allocated, so a search may
/// test every part of every list with it.
pub fn starts(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() {
        return false
    }
    for i in 0..prefix.len() {
        if lower_byte(s.byte(i)) != lower_byte(prefix.byte(i)) {
            return false
        }
    }
    true
}

/// The indices of `list`'s parts that start with `prefix`, in any case, in the list's order (all
/// of them for an empty one).
pub fn starting(list: [Text], prefix: str) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    for i in 0..list.len() {
        if starts(list[i], prefix) {
            out.push(i)
        }
    }
    out
}

/// The second halves (`BACKS`' indices) that may follow first half `front` in a noun that starts
/// with `noun`, in any case: every one when the front starts with `noun` ("wob" and Wobble), those
/// that start with the rest when `noun` runs past it ("wobblesn" and Wobble: snout, snoot), and
/// none otherwise.
pub fn backs_after(front: u32, noun: str) -> Vec<u32> {
    let f = FRONTS[front]
    if starts(f, noun) {
        starting(BACKS, "")
    } else if noun.len() > f.len() && starts(noun, f) {
        starting(BACKS, noun.slice(f.len(), noun.len()))
    } else { Vec::new() }
}

/// The parts of the names whose title, noun and epithet start with `title`, `noun` and `epithet`,
/// in any case (an empty one matches any).
pub fn matching(title: str, noun: str, epithet: str) -> Matching {
    var m = Matching {
        titles: starting(TITLES, title),
        fronts: Vec::new(),
        backs: Vec::new(),
        epithets: starting(EPITHETS, epithet),
    }
    for f in 0..FRONTS.len() {
        let backs = backs_after(f, noun)
        if !backs.is_empty() {
            m.fronts.push(f)
            m.backs.push(take backs)
        }
    }
    m
}

fn holds(xs: [u32], x: u32) -> bool {
    for y in xs {
        if y == x {
            return true
        }
    }
    false
}

/// Whether name `n` is one that `m` matches.
pub fn matches(m: Matching, n: Name) -> bool {
    if !holds(m.titles, n.title) || !holds(m.epithets, n.epithet) {
        return false
    }
    for i in 0..m.fronts.len() {
        if m.fronts[i] == n.front {
            return holds(m.backs[i], n.back)
        }
    }
    false
}

// ---- tests -------------------------------------------------------------------------------------

/// Stems that no part of a name may hold, in any case: crude, cruel or hateful words, and short
/// ones that hide in longer words (which is why "Grass", "Cucumber" and "Titmouse" aren't in the
/// lists). Kept as stems so a word's other forms are caught too.
const NEVER: [Text; 40] = [
    "ass",
    "arse",
    "butt",
    "bum",
    "shit",
    "fuck",
    "cunt",
    "cock",
    "dick",
    "piss",
    "tit",
    "twat",
    "wank",
    "fag",
    "nig",
    "rape",
    "sex",
    "porn",
    "nazi",
    "hitler",
    "kkk",
    "slut",
    "whore",
    "bitch",
    "bastard",
    "damn",
    "hell",
    "crap",
    "poo",
    "pee",
    "cum",
    "jizz",
    "spunk",
    "nude",
    "naked",
    "kill",
    "die",
    "dead",
    "drug",
    "booze",
]

/// `s` in lower case, ASCII only.
fn lower(s: str) -> String {
    var out = String::new()
    for i in 0..s.len() {
        out.push_byte(lower_byte(s.byte(i)))
    }
    out
}

/// Why `s` can't be part of a name, if it can't: a stem it holds, or a character other than a
/// letter, a space or a hyphen.
fn problem(s: str) -> Option<String> {
    if s.is_empty() {
        return Some(String::from("an empty part"))
    }
    for i in 0..s.len() {
        if !name_char(s.byte(i)) {
            return Some(f"`{s}` holds a character a name doesn't")
        }
    }
    let low = lower(s)
    for stem in NEVER {
        if low.as_str().find(stem).is_some() {
            return Some(f"`{s}` holds `{stem}`")
        }
    }
    None
}

/// Whether `xs` holds the same text twice, ignoring case.
fn repeats(xs: [String]) -> Option<String> {
    var sorted: Vec<String> = Vec::new()
    for x in xs {
        sorted.push(lower(x.as_str()))
    }
    sorted.sort_by(|a, b| a.as_str() < b.as_str())
    for i in 1..sorted.len() {
        if sorted[i] == sorted[i - 1] {
            return Some(sorted[i].clone())
        }
    }
    None
}

fn texts(xs: [Text]) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    for x in xs {
        out.push(String::from(x))
    }
    out
}

/// The first problem of any part of `list`.
fn listed_problem(list: [Text]) -> Option<String> {
    for part in list {
        if let Some(why) = problem(part) {
            return Some(why)
        }
    }
    None
}

/// The index of `list`'s longest part.
fn longest_of(list: [Text]) -> u32 {
    var best = 0
    for i in 0..list.len() {
        if list[i].len() > list[best].len() {
            best = i
        }
    }
    best
}

@test
fn every_part_and_every_noun_the_halves_make_is_clean() {
    for why in [
        listed_problem(TITLES),
        listed_problem(FRONTS),
        listed_problem(BACKS),
        listed_problem(EPITHETS),
    ] {
        if let Some(w) = why {
            panic(w.as_str())
        }
    }
    // Each title and epithet is checked above; a noun joins two halves, so a stem could form
    // across the join: each of the 3,072 nouns is checked whole.
    for f in 0..FRONTS.len() {
        for b in 0..BACKS.len() {
            let n = Name { title: 0, front: f, back: b, epithet: 0 }
            if let Some(why) = problem(noun(n).as_str()) {
                panic(why.as_str())
            }
        }
    }
}

@test
fn no_two_choices_give_the_same_name() {
    for same in [
        repeats(texts(TITLES)),
        repeats(texts(FRONTS)),
        repeats(texts(BACKS)),
        repeats(texts(EPITHETS)),
    ] {
        if let Some(x) = same {
            panic(f"`{x}` is in a list twice")
        }
    }
    // Two halves could join to another pair's noun ("Pud" + "dlesnout"): every noun is unique, so a
    // name's text is unique when its parts are, and the server keeps the parts unique.
    var nouns: Vec<String> = Vec::new()
    for f in 0..FRONTS.len() {
        for b in 0..BACKS.len() {
            nouns.push(noun(Name { title: 0, front: f, back: b, epithet: 0 }))
        }
    }
    if let Some(same) = repeats(nouns) {
        panic(f"the noun `{same}` is made twice")
    }
    // Two names differ in their keys when their parts do.
    let a = key(Name { title: 1, front: 0, back: 0, epithet: 0 })
    let b = key(Name { title: 0, front: 1, back: 0, epithet: 0 })
    assert(a != b && a.len() == 8)
}

@test
fn there_are_millions_of_names_and_none_is_too_long() {
    assert(count() > 18000000, f"{count()} names")
    let n = Name {
        title: longest_of(TITLES),
        front: longest_of(FRONTS),
        back: longest_of(BACKS),
        epithet: longest_of(EPITHETS),
    }
    let longest = text(n).len()
    assert(longest <= LONGEST, f"the longest name is {longest} bytes: {text(n)}")
}

@test
fn a_seed_draws_each_part_from_its_own_digits() {
    let n = draw(0)
    assert(text(n) == String::from("Sir Wobblesnout the Unhurried"), text(n).as_str())
    // The next title, then the next front half, as the seed counts up in each list's base.
    assert(draw(1).title == 1 && draw(1).front == 0)
    assert(draw(u64(TITLES.len())).front == 1 && draw(u64(TITLES.len())).title == 0)
    let last = draw(count() - 1)
    assert(
        last.title == TITLES.len() - 1 &&
            last.front == FRONTS.len() - 1 &&
            last.back == BACKS.len() - 1 &&
            last.epithet == EPITHETS.len() - 1,
    )
    assert(valid(draw(0xffffffffffffffff)), "any seed draws a name")
    assert(text(Name { title: 99, front: 0, back: 0, epithet: 0 }).is_empty())
}

@test
fn a_name_reads_back_from_its_text_and_its_key_and_a_search_matches_its_parts() {
    for seed in [0, 1, 99, 123456789, 0xffffffffffffffff] {
        let n = draw(seed)
        assert(parse(text(n).as_str()) == Some(n), text(n).as_str())
        assert(from_key(key(n)) == Some(n))
    }
    for bad in [
        "",
        "Sir Wobblesnout",
        "Sir Wobble the Unhurried",
        "sir wobblesnout the unhurried",
    ] {
        assert(parse(bad).is_none(), bad)
    }
    assert(from_key([0, 99, 0, 0, 0, 0, 0, 0]).is_none(), "a title past its list")
    // "wob" gives Wobblesnout, whatever the title and the epithet; "wobblesn" only the snouts.
    let n = draw(0)
    let m = matching("", "wob", "")
    assert(matches(m, n) && m.titles.len() == TITLES.len() && m.fronts.len() == 1)
    assert(matches(matching("si", "Wobblesn", "unh"), n))
    assert(!matches(matching("Dame", "", ""), n) && !matches(matching("", "wobblepaw", ""), n))
    assert(matching("", "", "zzz").epithets.is_empty())
    assert(starts("Wobble", "wOB") && !starts("Wob", "wobble") && starts("Sir", ""))
    assert(backs_after(0, "WOBBLESN").len() == 2 && backs_after(1, "wob").is_empty())
    assert(name_char(45) && name_char(122) && !name_char(48) && !name_char(95))
}
