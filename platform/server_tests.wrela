// The console's server (server.wrela), run on a fake host of many instances: each named instance
// with its own store in memory and its own outbox, a fresh edge instance for each request, calls
// answered by their callee's reply, messages delivered until acknowledged (and held, or failed, as a
// test says), random bytes from a counter (or given), tags made by HMAC-SHA256 here (RFC 2104, or
// given), and signatures "checked" by a list of good ones, so a test sees exactly what the server
// asks its host to check. The host's own checks (SQLite, the OS's randomness, WebCrypto, the outbox
// under reordering and crashes) are the toolchain's, tested there (wrela-compiler 0.18.0).
//
// Its passkeys come from the W3C's test vectors (WebAuthn Level 3, §16, "Packed Attestation with
// ES256 Credential": https://w3c.github.io/webauthn/#sctn-test-vectors, generated by its
// test-vectors/webauthn-test-vectors.py), and from passkeys made here as an authenticator makes
// them.

use account::{CEREMONY_BYTES, CODES, HANDLE_BYTES, account_instance}
use server::{
    Asked, CHALLENGE_BYTES, Claim, Command, Cookie, Engine, Game, NONCE_BYTES, Outcome, Versions,
    board_instance, engine,
}
use std::collections::replace
use std::crypto::{Signature, p256_key}
use std::hash::sha256::{Sha256, sha256}
use std::serialize::{LoadError, load, save}
use std::store::Entry
use std::webauthn::base64url
use wire::{
    ADD_PASSKEY, ANY, AROUND, Agreed, FULL, MOST_FOUND, NOT_AGREED, REGISTER, Reply, Request,
    RunRef, SIGN_IN, WHOLE,
}

// ---- a toy game ---------------------------------------------------------------------------------

/// A game whose replay is its course, the time it claims (4 bytes) and its moves: a run's time is
/// how many moves it has, and it counts for 100% when every move is even. Its boards are version
/// `board`, and version 7's verifier is archived (so a build of version 7 plays its own).
struct Toy: Copy {
    board: u32 = 7,
}

const TOY_ARCHIVED: [(u32, Text); 1] = [(7, "verifiers/toy/7/0123abcd")]

struct ToyRun {
    moves: Vec<u8>,
    at: u32,
}

impl Game for Toy {
    type Run = ToyRun

    fn id(self) -> Text {
        "toy"
    }

    fn board(self) -> u32 {
        self.board
    }

    fn courses(self) -> u32 {
        2
    }

    fn claim(self, replay: [u8]) -> Result<Claim, Text> {
        if replay.len() < 5 || replay[0] >= 2 {
            return Err("That isn't a run of this game.")
        }
        Ok(Claim { course: u32(replay[0]), ticks: account::u32_at(replay, 1) })
    }

    fn start(self, replay: [u8]) -> ToyRun {
        var moves: Vec<u8> = Vec::new()
        for i in 5..replay.len() {
            moves.push(replay[i])
        }
        ToyRun { moves, at: 0 }
    }

    fn play(self, run: mut ToyRun, ticks: u32) -> Option<Result<Outcome, Text>> {
        run.at = min(run.at + ticks, run.moves.len())
        if run.at < run.moves.len() {
            return None
        }
        var full = true
        for m in run.moves {
            if m % 2 != 0 {
                full = false
            }
        }
        Some(Ok(Outcome { ticks: run.moves.len(), full }))
    }

    fn archived(self) -> [(u32, Text)] {
        TOY_ARCHIVED
    }
}

/// A toy replay of `course`, claiming `claimed` ticks, with `moves` moves of `move`.
fn toy(course: u8, claimed: u32, moves: u32, m: u8) -> Vec<u8> {
    var out: Vec<u8> = Vec::from([course])
    for k in 0..4 {
        out.push(u8((claimed >> (24 - 8 * k)) & 255))
    }
    for _ in 0..moves {
        out.push(m)
    }
    out
}

// ---- the fake host ----------------------------------------------------------------------------------

/// A response the server gave: its request, its reply, the cookies it set, and how long it may be
/// cached.
struct Answered: Clone {
    conn: u32,
    reply: Reply,
    cookies: Vec<Cookie>,
    public: u32,
    immutable: bool,
}

/// A browser's cookie.
struct Kept: Clone {
    browser: u32,
    name: String,
    value: Vec<u8>,
}

/// What an instance hears on its next call.
enum Heard: Clone {
    Http { conn: u32, asked: Asked },
    Call { conn: u32, body: Vec<u8> },
    Message { conn: u32, from: String, body: Vec<u8> },
    Closed { conn: u32 },
}

/// A message in an outbox: to whom, what, and whether a delivery of it is under way.
struct Sent: Clone {
    id: u64,
    to: String,
    body: Vec<u8>,
    trying: bool,
}

/// An open connection, and where its answer goes: a request's to its browser, a call's to its
/// caller's ticket, a message's acknowledgement to its sender.
enum Waits: Clone {
    Http,
    Call { caller: u32, ticket: u32 },
    Message { sender: u32, id: u64 },
}

struct Open: Clone {
    conn: u32,
    at: u32,
    waits: Waits,
}

/// An instance: its name (empty for an edge, whose `id` tells it apart), the engine, its store,
/// the answers and events for its next call, and its outbox.
struct Instance {
    id: u32,
    name: String,
    engine: Engine<Toy>,
    store: Vec<Entry>,
    waiting: Vec<(u32, Option<Vec<u8>>)>,
    heard: Vec<Heard>,
    outbox: Vec<Sent>,
}

struct Host {
    instances: Vec<Instance>,
    next_id: u32,
    next_conn: u32,
    next_message: u64,
    open: Vec<Open>,
    /// The requests answered.
    answered: Vec<Answered>,
    /// Each browser's cookies, as its browser keeps them.
    jar: Vec<Kept>,
    /// Random answers to give first, in order; then a counter's bytes. Tags to give first, then
    /// HMAC-SHA256's.
    given: Vec<Vec<u8>>,
    counter: u32,
    tags: Vec<Vec<u8>>,
    /// Signatures the host says check out.
    good: Vec<Vec<u8>>,
    checked: Vec<Command>,
    /// The host's wall clock, in milliseconds since the Unix epoch.
    time: u64,
    /// The Worker's keys, as each request carries them.
    keys: Vec<Vec<u8>>,
    /// What the instances are made with: the game and the versions taken, and whether sign-ups
    /// are closed.
    game: Toy,
    versions: Versions,
    closed: bool,
    /// Instances whose messages wait (by their name's start), and whose calls fail.
    holding: Vec<String>,
    failing: Vec<String>,
    /// Each call made: its callee's name.
    calls: Vec<String>,
    /// Calls of every instance, counted.
    rounds: u32,
    /// The relying party and origin the instances take.
    rp: String,
    origin: String,
    /// Each request as its browser sent it, for the instance the edge sends it to.
    asked_log: Vec<(u32, Asked)>,
    /// Instances whose calls wait (by their name's start), and the calls waiting: the caller,
    /// its ticket, the callee and the body.
    pausing: Vec<String>,
    paused: Vec<(u32, u32, String, Vec<u8>)>,
    /// Every message delivered: its sender's name, its receiver's and its body.
    log: Vec<(String, String, Vec<u8>)>,
}

const RP: Text = "wrela.dev"
const ORIGIN: Text = "https://wrela.dev"
/// The versions the toy's server takes, and a new account's agreement to them.
const VERSIONS: Versions = Versions { terms: 3, privacy: 4, posting: 5 }
const AGREED: Agreed = Agreed { terms: 3, privacy: 4, of_age: true }
/// The Worker's key: 32 bytes of text, as a secret is.
const KEY: Text = "0123456789abcdef0123456789abcdef"

fn host() -> Host {
    Host {
        instances: Vec::new(),
        next_id: 0,
        next_conn: 0,
        next_message: 0,
        open: Vec::new(),
        answered: Vec::new(),
        jar: Vec::new(),
        given: Vec::new(),
        counter: 0,
        tags: Vec::new(),
        good: Vec::new(),
        checked: Vec::new(),
        time: 1793404800000,
        keys: Vec::from([Vec::from(String::from(KEY).as_bytes())]),
        game: Toy {},
        versions: VERSIONS,
        closed: false,
        holding: Vec::new(),
        failing: Vec::new(),
        calls: Vec::new(),
        rounds: 0,
        rp: String::from(RP),
        origin: String::from(ORIGIN),
        asked_log: Vec::new(),
        pausing: Vec::new(),
        paused: Vec::new(),
        log: Vec::new(),
    }
}

/// Where `key` is, or would go, in `store`.
fn find(store: [Entry], key: [u8]) -> (u32, bool) {
    for i in 0..store.len() {
        if store[i].key == Vec::from(key) {
            return (i, true)
        }
        if Vec::from(key) < store[i].key {
            return (i, false)
        }
    }
    (store.len(), false)
}

fn answer_get(store: [Entry], key: [u8]) -> Vec<u8> {
    let (i, found) = find(store, key)
    if !found {
        return Vec::from([u8(0)])
    }
    var out: Vec<u8> = Vec::from([u8(1)])
    for b in store[i].value {
        out.push(b)
    }
    out
}

fn answer_scan(store: [Entry], from: [u8], to: [u8], limit: u32, down: bool) -> Vec<u8> {
    var w = std::serialize::Writer::new()
    var picked: Vec<u32> = Vec::new()
    for k in 0..store.len() {
        // Down: from the last, as the host's scan gives them.
        let i = if down { store.len() - 1 - k } else { k }
        borrow key = store[i].key
        if key >= Vec::from(from) &&
            (to.is_empty() || key < Vec::from(to)) &&
            picked.len() < limit {
            picked.push(i)
        }
    }
    w.write_u32(picked.len())
    for i in picked {
        counted(mut w, store[i].key)
        counted(mut w, store[i].value)
    }
    take w.into_bytes()
}

fn counted(w: mut std::serialize::Writer, b: [u8]) {
    w.write_u32(b.len())
    for x in b {
        w.write_u8(x)
    }
}

/// HMAC-SHA256 of `message` under `key` (RFC 2104).
fn hmac(key: [u8], message: [u8]) -> Vec<u8> {
    var k: Vec<u8> = if key.len() > 64 { Vec::from(sha256(key)) } else { Vec::from(key) }
    while k.len() < 64 {
        k.push(0)
    }
    var inner = Sha256::new()
    var pad: Vec<u8> = Vec::new()
    for b in k {
        pad.push(b ^ 54)
    }
    inner.update(pad)
    inner.update(message)
    let h = inner.finish()
    var outer = Sha256::new()
    var opad: Vec<u8> = Vec::new()
    for b in k {
        opad.push(b ^ 92)
    }
    outer.update(opad)
    outer.update(h)
    Vec::from(outer.finish())
}

fn put_entry(store: mut Vec<Entry>, key: [u8], value: [u8]) {
    let (i, found) = find(store, key)
    if found {
        store[i].value = Vec::from(value)
    } else {
        store.insert(i, Entry { key: Vec::from(key), value: Vec::from(value) })
    }
}

fn holds(xs: [u32], x: u32) -> bool {
    for y in xs {
        if y == x {
            return true
        }
    }
    false
}

impl Host {
    /// The instance named `name`, made if it isn't: its index.
    fn instance(mut self, name: str) -> u32 {
        for i in 0..self.instances.len() {
            if !name.is_empty() && self.instances[i].name.as_str() == name {
                return i
            }
        }
        self.next_id += 1
        var e = engine(self.game, self.rp.as_str(), self.origin.as_str(), self.versions, name)
        if self.closed {
            e.close_sign_ups()
        }
        self.instances.push(
            Instance {
                id: self.next_id,
                name: String::from(name),
                engine: e,
                store: Vec::new(),
                waiting: Vec::new(),
                heard: Vec::new(),
                outbox: Vec::new(),
            },
        )
        self.instances.len() - 1
    }

    fn index_of(self, id: u32) -> Option<u32> {
        for i in 0..self.instances.len() {
            if self.instances[i].id == id {
                return Some(i)
            }
        }
        None
    }

    fn open_at(self, conn: u32) -> Option<u32> {
        for i in 0..self.open.len() {
            if self.open[i].conn == conn {
                return Some(i)
            }
        }
        None
    }

    fn held(self, name: str) -> bool {
        for p in self.holding {
            if name.starts_with(p.as_str()) {
                return true
            }
        }
        false
    }

    fn pauses(self, name: str) -> bool {
        for p in self.pausing {
            if name.starts_with(p.as_str()) {
                return true
            }
        }
        false
    }

    /// The calls paused go on, and calls aren't paused any more.
    fn unpause(mut self) {
        self.pausing.clear()
        let waiting = replace(mut self.paused, Vec::new())
        for (caller, ticket, to, body) in waiting {
            self.next_conn += 1
            let conn = self.next_conn
            let at = self.instance(to.as_str())
            if self.index_of(caller).is_none() {
                continue
            }
            self.open.push(
                Open { conn, at: self.instances[at].id, waits: Waits::Call { caller, ticket } },
            )
            self.instances[at].heard.push(Heard::Call { conn, body: body.clone() })
        }
    }

    fn fails(self, name: str) -> bool {
        for p in self.failing {
            if name.starts_with(p.as_str()) {
                return true
            }
        }
        false
    }

    /// Random bytes: what's given first, then a counter's.
    fn random(mut self, n: u32) -> Vec<u8> {
        var bytes: Vec<u8> = Vec::new()
        if !self.given.is_empty() && n > 1 {
            bytes = self.given.remove(0)
        }
        while bytes.len() < n {
            self.counter += 1
            let x = sha256(save(self.counter))
            for b in x {
                if bytes.len() < n {
                    bytes.push(b)
                }
            }
        }
        bytes
    }

    /// One call of instance `i`: the answers waiting and what it heard, then what it asked carried
    /// out: its reads answered for its next call, its writes committed, then its responses,
    /// dispatches, calls, replies, sends and acknowledgements.
    fn call(mut self, i: u32) {
        self.rounds += 1
        self.time += 10
        let waiting = replace(mut self.instances[i].waiting, Vec::new())
        let heard = replace(mut self.instances[i].heard, Vec::new())
        self.instances[i].engine.begin()
        for (t, a) in waiting {
            self.instances[i].engine.answer(t, a.clone())
        }
        for h in heard {
            match h {
                Heard::Http { conn, asked } => self.instances[i].engine.http(conn, asked.clone()),
                Heard::Call { conn, body } => self.instances[i].engine.called(conn, body),
                Heard::Message { conn, from, body } => {
                    self.instances[i].engine.delivered(conn, from.as_str(), body)
                },
                Heard::Closed { conn } => self.instances[i].engine.closed(conn),
            }
        }
        self.instances[i].engine.end()
        let commands = self.instances[i].engine.commands()
        let me = self.instances[i].id
        for c in commands {
            match c {
                Command::Get { ticket, key } => {
                    let a = answer_get(self.instances[i].store, key)
                    self.instances[i].waiting.push((ticket, Some(take a)))
                },
                Command::Scan { ticket, from, to, limit, down } => {
                    let a = answer_scan(self.instances[i].store, from, to, limit, down)
                    self.instances[i].waiting.push((ticket, Some(take a)))
                },
                Command::Random { ticket, n } => {
                    let bytes = self.random(n)
                    self.instances[i].waiting.push((ticket, Some(take bytes)))
                },
                Command::Hmac { ticket, key, message } => {
                    let tag = if self.tags.is_empty() { hmac(key, message) } else {
                        self.tags.remove(0)
                    }
                    self.instances[i].waiting.push((ticket, Some(take tag)))
                },
                Command::Verify { ticket, signature, .. } => {
                    self.checked.push(c.clone())
                    var ok = false
                    for g in self.good {
                        if g == signature {
                            ok = true
                        }
                    }
                    self.instances[i].waiting.push(
                        (ticket, Some(Vec::from([if ok { u8(1) } else { u8(0) }]))),
                    )
                },
                _ => {},
            }
        }
        // Then its writes commit, then the rest go (toolchain 0.18.0's host: `carryOut`).
        for c in commands {
            match c {
                Command::Put { key, value } => put_entry(mut self.instances[i].store, key, value),
                Command::Delete { key } => {
                    let (k, found) = find(self.instances[i].store, key)
                    if found {
                        let _ = self.instances[i].store.remove(k)
                    }
                },
                Command::Send { to, body } => {
                    self.next_message += 1
                    let id = self.next_message
                    self.instances[i].outbox.push(
                        Sent { id, to: to.clone(), body: body.clone(), trying: false },
                    )
                },
                _ => {},
            }
        }
        for c in commands {
            match c {
                Command::Respond { conn, body, cookies, public, immutable } => {
                    for a in self.answered {
                        assert(a.conn != conn, "a request is answered once")
                    }
                    let r: Result<Reply, LoadError> = load(body.clone())
                    self.answered.push(
                        Answered {
                            conn,
                            reply: take r.unwrap(),
                            cookies: cookies.clone(),
                            public,
                            immutable,
                        },
                    )
                    self.close(conn)
                },
                Command::Dispatch { conn, to } => {
                    let Some(o) = self.open_at(conn) else { continue }
                    let Some(asked) = self.asked_of(conn) else { continue }
                    let at = self.instance(to.as_str())
                    self.instances[i].heard.push(Heard::Closed { conn })
                    self.open[o].at = self.instances[at].id
                    self.instances[at].heard.push(Heard::Http { conn, asked })
                },
                Command::Call { ticket, to, body } => {
                    self.calls.push(to.clone())
                    if self.fails(to.as_str()) {
                        self.instances[i].waiting.push((ticket, None))
                        continue
                    }
                    if self.pauses(to.as_str()) {
                        self.paused.push((me, ticket, to.clone(), body.clone()))
                        continue
                    }
                    self.next_conn += 1
                    let conn = self.next_conn
                    let at = self.instance(to.as_str())
                    self.open.push(
                        Open {
                            conn,
                            at: self.instances[at].id,
                            waits: Waits::Call { caller: me, ticket },
                        },
                    )
                    self.instances[at].heard.push(Heard::Call { conn, body: body.clone() })
                },
                Command::Reply { conn, body } => {
                    let Some(o) = self.open_at(conn) else { continue }
                    if let Waits::Call { caller, ticket } = self.open[o].waits {
                        if let Some(k) = self.index_of(caller) {
                            self.instances[k].waiting.push((ticket, Some(body.clone())))
                        }
                    }
                    self.close(conn)
                },
                Command::Ack { conn } => {
                    let Some(o) = self.open_at(conn) else { continue }
                    if let Waits::Message { sender, id } = self.open[o].waits {
                        if let Some(k) = self.index_of(sender) {
                            self.instances[k].outbox.retain(|m| m.id != id)
                        }
                    }
                    self.close(conn)
                },
                Command::CallBuild { ticket, artifact, body } => {
                    // An archived build: a fresh edge of its version, asked once.
                    let parts = artifact.as_str()
                    let board: u32 = if parts == "verifiers/toy/7/0123abcd" { 7 } else { 0 }
                    if board == 0 {
                        self.instances[i].waiting.push((ticket, None))
                        continue
                    }
                    var old = engine(Toy { board }, RP, ORIGIN, self.versions, "")
                    old.begin()
                    old.called(1, body)
                    old.end()
                    var reply: Option<Vec<u8>> = None
                    for k in old.commands() {
                        if let Command::Reply { body, .. } = k {
                            reply = Some(body.clone())
                        }
                    }
                    self.instances[i].waiting.push((ticket, take reply))
                },
                _ => {},
            }
        }
    }

    /// What request `conn` asked, as its browser sent it.
    fn asked_of(self, conn: u32) -> Option<Asked> {
        for k in self.asked_log {
            if k.0 == conn {
                return Some(k.1.clone())
            }
        }
        None
    }

    /// A message to `to`, as from `from`, heard on its next call: one no outbox holds (a copy of
    /// one sent long ago, or a test's own).
    fn tell(mut self, from: str, to: str, body: [u8]) {
        self.next_conn += 1
        let conn = self.next_conn
        let at = self.instance(to)
        self.next_message += 1
        let id = self.next_message
        self.instances[at].heard.push(
            Heard::Message { conn, from: String::from(from), body: Vec::from(body) },
        )
        self.open.push(
            Open { conn, at: self.instances[at].id, waits: Waits::Message { sender: 0, id } },
        )
    }

    /// Connection `conn` is answered: the instance holding it hears it close.
    fn close(mut self, conn: u32) {
        let Some(o) = self.open_at(conn) else { return }
        let at = self.open[o].at
        let _ = self.open.remove(o)
        if let Some(k) = self.index_of(at) {
            self.instances[k].heard.push(Heard::Closed { conn })
        }
    }

    /// Whether instance `i` has anything for its next call.
    fn due(self, i: u32) -> bool {
        !self.instances[i].waiting.is_empty() || !self.instances[i].heard.is_empty()
    }

    /// Tries each outbox's messages not under way and not held: each heard by its receiver.
    fn deliver(mut self) -> bool {
        var any = false
        var k = 0
        while k < self.instances.len() {
            var m = 0
            while m < self.instances[k].outbox.len() {
                let s = self.instances[k].outbox[m].clone()
                if !s.trying && !self.held(s.to.as_str()) {
                    self.instances[k].outbox[m].trying = true
                    self.next_conn += 1
                    let conn = self.next_conn
                    let sender = self.instances[k].id
                    let from = self.instances[k].name.clone()
                    let at = self.instance(s.to.as_str())
                    self.open.push(
                        Open {
                            conn,
                            at: self.instances[at].id,
                            waits: Waits::Message { sender, id: s.id },
                        },
                    )
                    self.log.push((from.clone(), s.to.clone(), s.body.clone()))
                    self.instances[at].heard.push(
                        Heard::Message { conn, from, body: s.body.clone() },
                    )
                    any = true
                }
                m += 1
            }
            k += 1
        }
        any
    }

    /// Calls until nothing waits: each instance with something for its next call is called, and
    /// each message tried; a message its receiver left unacknowledged is tried again once all else
    /// is done, as the host's backoff would.
    /// One round: each instance with something for its next call is called, then each message
    /// tried. Whether anything happened.
    fn step(mut self) -> bool {
        var any = false
        var i = 0
        while i < self.instances.len() {
            if self.due(i) {
                self.call(i)
                any = true
            }
            i += 1
        }
        if self.deliver() {
            any = true
        }
        any
    }

    fn settle(mut self) {
        var n = 0
        var again = 0
        while n < 40000 {
            let any = self.step()
            if !any {
                // Unacknowledged: its connection times out, and it's tried again.
                var retried = false
                for i in 0..self.instances.len() {
                    for m in 0..self.instances[i].outbox.len() {
                        if self.instances[i].outbox[m].trying && again < 50 {
                            self.instances[i].outbox[m].trying = false
                            retried = true
                        }
                    }
                }
                if !retried {
                    break
                }
                again += 1
                self.open.retain(|o| match o.waits {
                    Waits::Message { .. } => false,
                    _ => true,
                })
            }
            n += 1
        }
        assert(n < 40000, "the server settles")
        // Edges with nothing open go: each request has its own.
        var keep: Vec<u32> = Vec::new()
        for o in self.open {
            keep.push(o.at)
        }
        for p in self.paused {
            keep.push(p.0)
        }
        self.instances.retain(
            |x| !x.name.is_empty() ||
                !x.heard.is_empty() ||
                !x.waiting.is_empty() ||
                holds(keep, x.id),
        )
    }

    /// Browser `browser`'s cookie `name`: empty if it has none.
    fn cookie(self, browser: u32, name: Text) -> Vec<u8> {
        for k in self.jar {
            if k.browser == browser && k.name.as_str() == name {
                return k.value.clone()
            }
        }
        Vec::new()
    }

    /// Browser `browser` keeps cookie `name` as `value` (none if empty), as a `Set-Cookie` says.
    fn keep(mut self, browser: u32, name: str, value: [u8]) {
        self.jar.retain(|k| k.browser != browser || k.name.as_str() != name)
        if !value.is_empty() {
            self.jar.push(Kept { browser, name: String::from(name), value: Vec::from(value) })
        }
    }

    /// Browser `browser`'s request for `request`, with its cookies, as a `POST` (or a `GET` if
    /// `public`, with no cookie, as `fetch_public` sends it).
    fn asked(self, browser: u32, request: Request, public: bool) -> Asked {
        Asked {
            time: self.time,
            public,
            session: if public { Vec::new() } else { self.cookie(browser, server::SESSION) },
            ceremony: if public { Vec::new() } else { self.cookie(browser, server::CEREMONY) },
            keys: self.keys.clone(),
            body: save(request),
        }
    }

    /// Browser `browser`'s requests, each to a fresh edge, together: heard in one call where
    /// they meet. Returns their connections.
    fn send(mut self, browser: u32, requests: [Request], public: bool) -> Vec<u32> {
        var conns: Vec<u32> = Vec::new()
        for r in requests {
            self.next_conn += 1
            let conn = self.next_conn
            conns.push(conn)
            let asked = self.asked(browser, r.clone(), public)
            self.asked_log.push((conn, asked.clone()))
            let at = self.instance("")
            self.open.push(Open { conn, at: self.instances[at].id, waits: Waits::Http })
            self.instances[at].heard.push(Heard::Http { conn, asked })
        }
        conns
    }

    /// The answers to `conns`, their cookies kept by browser `browser`.
    fn answers(mut self, browser: u32, conns: [u32]) -> Vec<Answered> {
        var out: Vec<Answered> = Vec::new()
        for c in conns {
            var found: Option<Answered> = None
            for a in self.answered {
                if a.conn == c {
                    found = Some(a.clone())
                }
            }
            let Some(a) = found else { panic("every request is answered") }
            for k in a.cookies {
                self.keep(browser, k.name.as_str(), k.value)
            }
            out.push(a.clone())
        }
        out
    }

    /// Browser `browser` sends `requests` together, as `POST`s (or `GET`s if `public`): each
    /// one's answer, its cookies kept.
    fn together(
        mut self,
        browser: u32,
        requests: [Request],
        public: bool = false,
    ) -> Vec<Answered> {
        let conns = self.send(browser, requests, public)
        self.settle()
        self.answers(browser, conns)
    }

    /// Browser `browser` sends `request`: its answer, in a list as the tests read it.
    fn say(mut self, browser: u32, request: Request) -> Vec<Reply> {
        let a = self.together(browser, [request.clone()])
        Vec::from([a[0].reply.clone()])
    }

    /// Browser `browser` reads `request` by a public `GET`: its answer, and how long it may be
    /// cached.
    fn read(mut self, browser: u32, request: Request) -> (Reply, u32) {
        let a = self.together(browser, [request.clone()], public: true)
        (a[0].reply.clone(), a[0].public)
    }

    /// Like `read`, the answer as the host gave it, with whether it never changes.
    fn read_whole(mut self, browser: u32, request: Request) -> Answered {
        let a = self.together(browser, [request.clone()], public: true)
        a[0].clone()
    }

    /// The keys that start with `prefix` in the instances whose names start with `at`.
    fn keys(self, at: str, prefix: Text) -> u32 {
        let p = Vec::from(String::from(prefix).as_bytes())
        var n = 0
        for x in self.instances {
            if x.name.is_empty() || !x.name.starts_with(at) {
                continue
            }
            for e in x.store {
                if e.key.len() >= p.len() && part(e.key, 0, p.len()) == p {
                    n += 1
                }
            }
        }
        n
    }

    /// The store of instance `name` (empty if it has none).
    fn store_of(self, name: str) -> Vec<Entry> {
        for x in self.instances {
            if x.name.as_str() == name {
                return x.store.clone()
            }
        }
        Vec::new()
    }

    /// The messages waiting in every outbox, to instances whose names start with `at`.
    fn outbound(self, at: Text) -> u32 {
        var n = 0
        for x in self.instances {
            for m in x.outbox {
                if m.to.starts_with(at) {
                    n += 1
                }
            }
        }
        n
    }

    /// Instance `name` dropped: its memory goes (and with it every connection open on it, each
    /// answered as failed), its store and outbox stay, and the next call starts it again.
    fn drop_instance(mut self, name: str) {
        let i = self.instance(name)
        let id = self.instances[i].id
        self.instances[i].engine = engine(
            self.game,
            self.rp.as_str(),
            self.origin.as_str(),
            self.versions,
            name,
        )
        if self.closed {
            self.instances[i].engine.close_sign_ups()
        }
        self.instances[i].waiting.clear()
        self.instances[i].heard.clear()
        for m in 0..self.instances[i].outbox.len() {
            self.instances[i].outbox[m].trying = false
        }
        var k = 0
        while k < self.open.len() {
            if self.open[k].at != id {
                k += 1
                continue
            }
            let o = self.open.remove(k)
            match o.waits {
                Waits::Call { caller, ticket } => {
                    if let Some(c) = self.index_of(caller) {
                        self.instances[c].waiting.push((ticket, None))
                    }
                },
                Waits::Message { sender, id } => {
                    if let Some(c) = self.index_of(sender) {
                        for m in 0..self.instances[c].outbox.len() {
                            if self.instances[c].outbox[m].id == id {
                                self.instances[c].outbox[m].trying = false
                            }
                        }
                    }
                },
                Waits::Http => {},
            }
        }
    }

    /// A deploy: every instance's memory goes, and new ones are made with `game` and `versions`.
    fn deploy(mut self, game: Toy, versions: Versions) {
        self.game = game
        self.versions = versions
        var names: Vec<String> = Vec::new()
        for x in self.instances {
            if !x.name.is_empty() {
                names.push(x.name.clone())
            }
        }
        for n in names {
            self.drop_instance(n.as_str())
        }
    }
}

fn part(b: [u8], at: u32, n: u32) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    for i in at..at + n {
        out.push(b[i])
    }
    out
}

/// A challenge for `ceremony`: a new account's agreeing to the toy's versions.
fn begin(ceremony: u32, csrf: Vec<u8> = Vec::new()) -> Request {
    let agreed = if ceremony == REGISTER { AGREED } else { NOT_AGREED }
    Request::Begin { ceremony, csrf: csrf.clone(), agreed }
}

fn challenge_of(rs: [Reply]) -> Vec<u8> {
    for r in rs {
        if let Reply::Challenge { challenge, .. } = r {
            return challenge.clone()
        }
    }
    panic("a challenge")
}

fn handle_of(rs: [Reply]) -> Vec<u8> {
    for r in rs {
        if let Reply::Challenge { handle, .. } = r {
            return handle.clone()
        }
    }
    panic("a challenge")
}

/// An account's session after it signed up: its cookie, CSRF token, name, codes and handle.
struct Signed: Clone {
    session: Vec<u8>,
    csrf: Vec<u8>,
    name: String,
    codes: Vec<String>,
    handle: Vec<u8>,
}

impl Signed {
    /// Its account's instance.
    fn at(self) -> String {
        account_instance(self.handle)
    }
}

fn session_of(rs: [Reply]) -> Option<Signed> {
    for r in rs {
        if let Reply::Session { csrf, me, codes } = r {
            return Some(
                Signed {
                    session: Vec::new(),
                    csrf: csrf.clone(),
                    name: me.name.clone(),
                    codes: codes.clone(),
                    handle: Vec::new(),
                },
            )
        }
    }
    None
}

fn refused(rs: [Reply]) -> bool {
    for r in rs {
        if let Reply::Refused { .. } = r {
            return true
        }
    }
    false
}

fn why_of(r: Reply) -> String {
    match r {
        Reply::Refused { why } => why.clone(),
        Reply::Rejected { why } => why.clone(),
        _ => String::new(),
    }
}

/// The sign-up of a new account's passkey `id` over challenge `c`, for `handle`.
fn register(handle: [u8], c: [u8], id: u8) -> Request {
    Request::Register {
        handle: Vec::from(handle),
        challenge: Vec::from(c),
        agreed: AGREED,
        id: Vec::from([id]),
        client_data: client("webauthn.create", c, ORIGIN),
        attestation: made(RP, [id], id),
    }
}

/// A new account in browser `conn`, its passkey credential `id`.
fn sign_up(h: mut Host, conn: u32, id: u8) -> Signed {
    let begun = h.say(conn, begin(REGISTER))
    let c = challenge_of(begun)
    let handle = handle_of(begun)
    let rs = h.say(conn, register(handle, c, id))
    let Some(s) = session_of(rs) else { panic(f"a session: {why_of(rs[0])}") }
    var signed = s.clone()
    signed.handle = take handle
    signed.session = h.cookie(conn, server::SESSION)
    signed
}

/// A sign-in over challenge `c` with credential `id` of the account whose handle is `handle`, its
/// signature `signature` (which the host checks against its good list).
fn signing_in(c: [u8], id: u8, handle: [u8], counter: u32, signature: [u8]) -> Request {
    Request::SignIn {
        challenge: Vec::from(c),
        id: Vec::from([id]),
        client_data: client("webauthn.get", c, ORIGIN),
        authenticator_data: auth_data(RP, 1 | 4, counter, []),
        signature: Vec::from(signature),
        user: Vec::from(handle),
    }
}

/// A sign-in in browser `conn` with credential `id` of the account whose handle is `handle`.
fn sign_in(
    h: mut Host,
    conn: u32,
    id: u8,
    handle: [u8],
    counter: u32,
    signature: [u8],
) -> Vec<Reply> {
    let c = challenge_of(h.say(conn, begin(SIGN_IN)))
    h.say(conn, signing_in(c, id, handle, counter, signature))
}

/// A knighted account in browser `conn` that has agreed to posting, and a token for the toy's
/// boards.
fn uploader(h: mut Host, conn: u32, id: u8) -> (Signed, Vec<u8>) {
    let s = sign_up(mut h, conn, id)
    let _ = h.say(conn, Request::Keep { csrf: s.csrf.clone() })
    let consent = Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: false }
    let Reply::Posting { agreed: true, .. } = h.say(conn, consent)[0].clone() else {
        panic("agreed to posting")
    }
    (s.clone(), token_of(mut h, conn))
}

fn token_of(h: mut Host, conn: u32) -> Vec<u8> {
    let Reply::Token { token, .. } = h.say(
        conn,
        Request::Token { game: String::from("toy") },
    )[0].clone() else {
        panic("a token")
    }
    token
}

/// An upload of `replay` to the toy's board version `board`, with `token`.
fn up(token: [u8], replay: [u8], board: u32 = 7) -> Request {
    Request::Upload {
        token: Vec::from(token),
        game: String::from("toy"),
        board,
        replay: Vec::from(replay),
    }
}

/// The upload of `replay` with `token` from browser `conn`: its answer.
fn upload(h: mut Host, conn: u32, token: [u8], replay: [u8]) -> Reply {
    let board = h.game.board
    h.say(conn, up(token, replay, board))[0].clone()
}

/// Uploads a toy run of course 0 with `moves` moves with `token`: verified.
fn post(h: mut Host, conn: u32, token: [u8], moves: u32) {
    let Reply::Verified { .. } = upload(mut h, conn, token, toy(0, moves, moves, 2)) else {
        panic("verified")
    }
}

/// The next sign-up's random bytes: its challenge's nonce, its browser's token and its handle
/// (each from `id`, the handle also from `conn`), then the seed its name is drawn from.
fn give(h: mut Host, conn: u32, id: u8, seed: u64) {
    var begun: Vec<u8> = Vec::filled(NONCE_BYTES + CEREMONY_BYTES + HANDLE_BYTES, id)
    begun[NONCE_BYTES + CEREMONY_BYTES] = u8(conn & 255)
    begun[NONCE_BYTES + CEREMONY_BYTES + 1] = u8(conn >> 8)
    h.given.push(take begun)
    h.given.push(seed_bytes(seed))
}

fn seed_bytes(seed: u64) -> Vec<u8> {
    var drawn: Vec<u8> = Vec::new()
    std::store::append_u64(mut drawn, seed)
    drawn
}

/// A knighted account that agreed to posting, with the name that `seed` draws, in browser `conn`
/// with passkey `id`: its token.
fn named(h: mut Host, conn: u32, id: u8, seed: u64) -> (Signed, Vec<u8>) {
    give(mut h, conn, id, seed)
    uploader(mut h, conn, id)
}

/// The seed that draws the name of parts `title`, `front`, `back` and `epithet`.
fn seed_of(title: u32, front: u32, back: u32, epithet: u32) -> u64 {
    let (t, f, b) = (u64(names::TITLES.len()), u64(names::FRONTS.len()), u64(names::BACKS.len()))
    u64(title) + t * (u64(front) + f * (u64(back) + b * u64(epithet)))
}

/// A record of account `s`'s, by its key.
fn record(h: Host, s: Signed, key: Text) -> Option<Vec<u8>> {
    let k = Vec::from(String::from(key).as_bytes())
    for e in h.store_of(s.at().as_str()) {
        if e.key == k {
            return Some(e.value.clone())
        }
    }
    None
}

/// The names held now at their shards (an owner's), and whose `n` is.
fn owned_names(h: Host) -> u32 {
    var n = 0
    for x in h.instances {
        if !x.name.as_str().starts_with("names/") {
            continue
        }
        for e in x.store {
            let r: Result<shards::NameEntry, LoadError> = load(e.value.clone())
            if let Ok(entry) = r {
                if !entry.owner.is_empty() {
                    n += 1
                }
            }
        }
    }
    n
}

/// The recovery codes whose shards say they're an account's.
fn live_codes(h: Host) -> u32 {
    var n = 0
    for x in h.instances {
        if !x.name.as_str().starts_with("codes/") {
            continue
        }
        for e in x.store {
            let r: Result<shards::CodeEntry, LoadError> = load(e.value.clone())
            if let Ok(entry) = r {
                if !entry.owner.is_empty() {
                    n += 1
                }
            }
        }
    }
    n
}

/// The replays their shards say are an account's.
fn owned_replays(h: Host) -> u32 {
    var n = 0
    for x in h.instances {
        if !x.name.as_str().starts_with("replays/") {
            continue
        }
        for e in x.store {
            if e.value.len() == HANDLE_BYTES {
                n += 1
            }
        }
    }
    n
}

/// Every place on every board and whole board (each an account's best there).
fn places(h: Host) -> u32 {
    h.keys("board/", "r") + h.keys("whole/", "r")
}

/// A page of a board: the first, or the one after the `from` places before it, from where the
/// last ended (`after`).
fn board(course: u32, category: u32, from: u32 = 0, after: take Vec<u8> = Vec::new()) -> Request {
    Request::Board { game: String::from("toy"), course, category, from, after }
}

/// The page of the toy's any% board of course 0 that holds place `place`, reached as a player's
/// scrolling reaches it: a page at a time from the top, each after the last.
fn page_with(h: mut Host, place: u32) -> Vec<wire::Place> {
    var from: u32 = 0
    var after: Vec<u8> = Vec::new()
    loop {
        let Reply::Board { places, total, next } = h.read(
            20,
            board(0, ANY, from, after.clone()),
        ).0 else {
            panic("a page")
        }
        if from + places.len() >= place || from + places.len() >= total {
            return places.clone()
        }
        from += places.len()
        after = next.clone()
    }
}

/// The places of `reply`, a board's page.
fn places_of(reply: Reply) -> Vec<wire::Place> {
    let Reply::Board { places, .. } = reply else { panic("a board") }
    places.clone()
}

/// A fresh sign-in for account `s` in browser `conn`, with passkey `id`: its CSRF token.
fn fresh(h: mut Host, conn: u32, id: u8, s: Signed) -> Vec<u8> {
    h.good.push(Vec::from([4]))
    let Some(f) = session_of(sign_in(mut h, conn, id, s.handle, 0, [4])) else {
        panic("signed in")
    }
    f.csrf.clone()
}

/// Steps the host until instance `name` waits on an ask at `step`, then fails that ask: its answer
/// is none, as when the host's store, its randomness or a call fails.
fn fail_at(h: mut Host, name: str, step: server::Step) {
    var k = 0
    while k < 400 {
        let i = h.instance(name)
        var ticket: Option<u32> = None
        for j in h.instances[i].engine.jobs {
            if j.step == step {
                ticket = Some(j.ticket)
            }
        }
        if let Some(t) = ticket {
            for w in 0..h.instances[i].waiting.len() {
                if h.instances[i].waiting[w].0 == t {
                    h.instances[i].waiting[w].1 = None
                    return
                }
            }
        }
        let _ = h.step()
        k += 1
    }
    panic("it never waited there")
}

// ---- tests ------------------------------------------------------------------------------------------

@test
fn the_w3c_vectors_register_and_their_assertion_is_checked_with_the_registered_key() {
    var h = host()
    h.rp = String::from("example.org")
    h.origin = String::from("https://example.org")
    // The challenge the vector was made over is a nonce, when it expires and a tag: given as the
    // host's random bytes, its clock and its HMAC.
    let reg = unhex("c1184a5fddf8045e13dc47f54b61f5a656b666b59018f16d870e9256e9952012")
    var first = part(reg, 0, NONCE_BYTES)
    for b in [3; CEREMONY_BYTES] {
        first.push(b)
    }
    for b in [7; HANDLE_BYTES] {
        first.push(b)
    }
    h.given.push(take first)
    var tag = part(reg, at: 16, n: 16)
    for _ in 0..16 {
        tag.push(0)
    }
    h.tags = Vec::from([tag.clone(), tag.clone()])
    h.time = account::u64_at(reg, NONCE_BYTES) - account::CHALLENGE_LIFE
    let begun = h.say(1, begin(REGISTER))
    assert(challenge_of(begun) == reg && handle_of(begun) == Vec::from([7; 16]), "the vector's")
    let id = unhex("c9a6f5b3462d02873fea0c56862234f99f081728084e511bb7760201a89054a5")
    let rs = h.say(
        1,
        Request::Register {
            handle: Vec::from([7; 16]),
            challenge: reg.clone(),
            agreed: AGREED,
            id: id.clone(),
            client_data: unhex(REG_CLIENT),
            attestation: unhex(REG_ATTESTATION),
        },
    )
    let Some(s) = session_of(rs) else {
        panic(f"the vector's registration is taken: {why_of(rs[0])}")
    }
    let at = account_instance([7; 16])
    assert(s.codes.len() == CODES && h.cookie(1, server::SESSION).len() == 48 && !s.name.is_empty())
    assert(
        h.keys(at.as_str(), "c/") == 1 &&
            h.keys(at.as_str(), "r/") == CODES &&
            h.keys(at.as_str(), "s/") == 1,
    )
    assert(owned_names(h) == 1 && live_codes(h) == CODES, "its name and codes at their shards")
    // Its sign-in: the server asks the host to check the vector's signature, by the key the
    // registration gave, over the authenticator's data and the client's data's hash.
    let sig_in = unhex("b1106fa46a57bef1781511c0557dc898a03413d5f0f17d244630c194c7e1adb5")
    var second = part(sig_in, 0, NONCE_BYTES)
    for b in [4; CEREMONY_BYTES] {
        second.push(b)
    }
    h.given.push(take second)
    var tag2 = part(sig_in, at: 16, n: 16)
    for _ in 0..16 {
        tag2.push(0)
    }
    h.tags = Vec::from([tag2.clone(), tag2.clone()])
    h.time = account::u64_at(sig_in, NONCE_BYTES) - account::CHALLENGE_LIFE
    assert(challenge_of(h.say(1, begin(SIGN_IN))) == sig_in, "the vector's")
    let signature = unhex(AUTH_SIGNATURE)
    h.good.push(signature.clone())
    let auth = unhex("bfabc37432958b063360d3ad6461c9c4735ae7f8edd46592a5e0f01452b2e4b50d00000000")
    let cd = unhex(AUTH_CLIENT)
    let rs = h.say(
        1,
        Request::SignIn {
            challenge: sig_in.clone(),
            id: id.clone(),
            client_data: cd.clone(),
            authenticator_data: auth.clone(),
            signature: signature.clone(),
            user: Vec::from([7; 16]),
        },
    )
    assert(session_of(rs).is_some(), "signed in")
    assert(h.checked.len() == 1)
    let Command::Verify {
        algorithm,
        key,
        message,
        signature: sig,
        ..
    } = h.checked[0].clone() else {
        panic("a check")
    }
    let x = unhex("1cf27f25da591208a4239c2e324f104f585525479a29edeedd830f48e77aeae5")
    let y = unhex("59e4b7da6c0106e206ce390c93ab98a15a5ec3887e57f0cc2bece803b920c423")
    assert(algorithm == Signature::Es256 && key == p256_key(x, y), "the registered key")
    var covered = auth.clone()
    for b in sha256(cd) {
        covered.push(b)
    }
    assert(message == covered && sig == signature, "what the signature covers")
}

@test
fn a_bad_signature_another_accounts_handle_or_a_stale_counter_signs_nobody_in() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    h.good.push(Vec::from([1, 2, 3]))
    assert(refused(sign_in(mut h, 2, 5, s.handle, 1, [9, 9])), "a signature that doesn't check")
    assert(refused(sign_in(mut h, 2, 5, [1; 16], 1, [1, 2, 3])), "another account's handle")
    assert(session_of(sign_in(mut h, 2, 5, s.handle, 3, [1, 2, 3])).is_some(), "a good one")
    assert(refused(sign_in(mut h, 2, 5, s.handle, 3, [1, 2, 3])), "the counter must go up")
    assert(refused(sign_in(mut h, 2, 6, s.handle, 4, [1, 2, 3])), "a passkey nobody has")
    assert(h.keys(account_instance([1; 16]).as_str(), "") == 0, "another's handle wrote nothing")
}

@test
fn a_bad_passkey_is_answered_alike_for_an_account_that_exists_never_did_or_was_deleted() {
    var h = host()
    let live = sign_up(mut h, 1, 5)
    let gone = sign_up(mut h, 2, 6)
    let csrf = fresh(mut h, 2, 6, gone)
    let Reply::Done = h.say(2, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    // The same tries at each: a passkey nobody has, twice over one challenge, its cookie kept back.
    var said: Vec<String> = Vec::new()
    for handle in [live.handle.clone(), Vec::from([66; 16]), gone.handle.clone()] {
        let c = challenge_of(h.say(3, begin(SIGN_IN)))
        let token = h.cookie(3, server::CEREMONY)
        for _ in 0..2 {
            h.keep(3, server::CEREMONY, token)
            said.push(why_of(h.say(3, signing_in(c, 77, handle, 0, [1]))[0].clone()))
        }
    }
    for w in said {
        assert(w == said[0] && !w.is_empty(), w.as_str())
    }
    assert(h.keys(live.at().as_str(), "w/") == 0, "nothing written of a sign-in that failed")
}

@test
fn a_challenge_is_used_once_by_the_browser_that_asked_and_expires() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    h.good.push(Vec::from([1]))
    let c = challenge_of(h.say(2, begin(SIGN_IN)))
    let token = h.cookie(2, server::CEREMONY)
    let attempt = signing_in(c, 5, s.handle, 0, [1])
    // A synced passkey's counter stays 0, so only the challenge stops a replay of its assertion.
    // Another browser can't use it: it hasn't the ceremony's cookie.
    assert(refused(h.say(3, attempt.clone())), "another browser's challenge")
    // Asked again by its own browser: the first try (by browser 3) didn't touch it.
    assert(session_of(h.say(2, attempt.clone())).is_some(), "its own")
    assert(h.cookie(2, server::CEREMONY).is_empty(), "the ceremony's cookie cleared")
    assert(refused(h.say(2, attempt.clone())), "its cookie gone")
    // Its cookie kept back by the browser: the challenge is still used, kept so until it expires.
    h.keep(2, server::CEREMONY, token)
    assert(refused(h.say(2, attempt.clone())), "used once")
    // Two requests in one call with the same ceremony: both read it before either's mark
    // commits, and still only one may use it.
    let c1 = challenge_of(h.say(1, begin(SIGN_IN)))
    let twice = signing_in(c1, 5, s.handle, 0, [1])
    let both = h.together(1, [twice.clone(), twice.clone()])
    var sessions = 0
    for a in both {
        if session_of([a.reply.clone()]).is_some() {
            sessions += 1
        }
    }
    assert(sessions == 1, f"only one of two at once: {sessions}")
    // One left five minutes is gone.
    let c2 = challenge_of(h.say(2, begin(SIGN_IN)))
    h.time += 301000
    assert(refused(h.say(2, signing_in(c2, 5, s.handle, 0, [1]))), "expired")
    // The used ones that have expired go as another sign-in comes.
    assert(h.keys(s.at().as_str(), "w/") >= 2, "kept until they expire")
    assert(session_of(sign_in(mut h, 4, 5, s.handle, 0, [1])).is_some())
    assert(h.keys(s.at().as_str(), "w/") == 1, "the expired ones cleared")
    // A tag that isn't the server's, or a sign-in's challenge for a sign-up, is refused.
    var forged = challenge_of(h.say(2, begin(SIGN_IN)))
    forged[CHALLENGE_BYTES - 1] = forged[CHALLENGE_BYTES - 1] ^ 1
    assert(refused(h.say(2, signing_in(forged, 5, s.handle, 0, [1]))), "a forged tag")
    let c4 = challenge_of(h.say(2, begin(SIGN_IN)))
    assert(refused(h.say(2, register([9; 16], c4, 8))), "another ceremony's challenge")
    let begun = h.say(6, begin(REGISTER))
    let c5 = challenge_of(begun)
    let elsewhere = Request::Register {
        handle: handle_of(begun),
        challenge: c5.clone(),
        agreed: AGREED,
        id: Vec::from([8]),
        client_data: client("webauthn.create", c5, "https://evil.example"),
        attestation: made(RP, [8], 8),
    }
    assert(refused(h.say(6, elsewhere)), "another origin")
    assert(h.keys(account_instance(handle_of(begun)).as_str(), "a") == 0, "no account made")
    assert(c5.len() == CHALLENGE_BYTES)
}

@test
fn a_challenge_made_with_the_key_before_a_rotation_still_finishes() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    h.good.push(Vec::from([1]))
    let c = challenge_of(h.say(2, begin(SIGN_IN)))
    // The Worker's secret rotated: the new key first, the old one after it.
    let old = h.keys[0].clone()
    h.keys = Vec::from(
        [Vec::from(String::from("fedcba9876543210fedcba9876543210").as_bytes()), take old],
    )
    assert(session_of(h.say(2, signing_in(c, 5, s.handle, 0, [1]))).is_some(), "the old key's")
    // Then the old one goes: a challenge it made no longer finishes.
    let c2 = challenge_of(h.say(3, begin(SIGN_IN)))
    h.keys = Vec::from(
        [Vec::from(String::from("00112233445566770011223344556677").as_bytes()), h.keys[0].clone()],
    )
    assert(session_of(h.say(3, signing_in(c2, 5, s.handle, 0, [1]))).is_some(), "the one before")
    let c3 = challenge_of(h.say(4, begin(SIGN_IN)))
    h.keys = Vec::from([Vec::from(String::from("99999999999999999999999999999999").as_bytes())])
    assert(refused(h.say(4, signing_in(c3, 5, s.handle, 0, [1]))), "a key no longer held")
    // No key, or one too short: nothing begins.
    h.keys = Vec::from([Vec::from(String::from("short").as_bytes())])
    assert(refused(h.say(5, begin(SIGN_IN))) && refused(h.say(5, begin(REGISTER))))
    h.keys = Vec::new()
    assert(refused(h.say(5, begin(SIGN_IN))))
}

@test
fn a_replayed_sign_up_is_refused_even_two_at_once() {
    var h = host()
    let begun = h.say(1, begin(REGISTER))
    let c = challenge_of(begun)
    let handle = handle_of(begun)
    let token = h.cookie(1, server::CEREMONY)
    assert(session_of(h.say(1, register(handle, c, 5))).is_some(), "made")
    // The same sign-up again, its cookie kept back: the account is made, so it's a replay.
    h.keep(1, server::CEREMONY, token)
    assert(refused(h.say(1, register(handle, c, 6))), "a replay")
    let at = account_instance(handle)
    assert(
        h.keys(at.as_str(), "c/") == 1 && h.keys(at.as_str(), "s/") == 1,
        "nothing of the replay's",
    )
    // Two at once, over one challenge: one account, one passkey, one name.
    let begun2 = h.say(2, begin(REGISTER))
    let c2 = challenge_of(begun2)
    let handle2 = handle_of(begun2)
    let both = h.together(2, [register(handle2, c2, 7), register(handle2, c2, 8)])
    var made = 0
    for a in both {
        if session_of([a.reply.clone()]).is_some() {
            made += 1
        }
    }
    let at2 = account_instance(handle2)
    assert(made == 1 && h.keys(at2.as_str(), "c/") == 1, f"{made} made")
    assert(owned_names(h) == 2, "a name each account")
}

@test
fn changes_need_the_sessions_csrf_token() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    assert(refused(h.say(1, Request::Reroll { csrf: Vec::from([0; 16]) })), "a wrong token")
    assert(refused(h.say(1, Request::Reroll { csrf: Vec::new() })), "no token")
    assert(refused(h.say(2, Request::Reroll { csrf: s.csrf.clone() })), "not signed in")
    let rs = h.say(1, Request::Reroll { csrf: s.csrf.clone() })
    let Reply::Welcome { me, .. } = rs[0].clone() else { panic("renamed") }
    assert(me.rerolls == 2 && me.name != s.name && !me.fixed, me.name.as_str())
    assert(owned_names(h) == 1, "the old name let go")
    for _ in 0..2 {
        let _ = h.say(1, Request::Reroll { csrf: s.csrf.clone() })
    }
    assert(refused(h.say(1, Request::Reroll { csrf: s.csrf.clone() })), "out of draws")
    let kept = h.say(1, Request::Keep { csrf: s.csrf.clone() })
    let Reply::Welcome { me, .. } = kept[0].clone() else { panic("kept") }
    assert(me.fixed)
    assert(refused(h.say(1, Request::Delete { csrf: Vec::from([1; 16]) })), "deleting needs it too")
}

@test
fn names_are_unique_however_the_draw_falls() {
    var h = host()
    // Two accounts whose first draws are the same seed.
    let (a, _) = named(mut h, 1, 5, seed: 3)
    let (b, _) = named(mut h, 2, 6, seed: 3)
    assert(a.name != b.name, a.name.as_str())
    assert(a.name == names::text(names::draw(3)), "the first had the seed's name")
    assert(owned_names(h) == 2)
}

@test
fn a_late_release_never_frees_a_name_a_later_owner_holds() {
    var h = host()
    let first = names::draw(11)
    let shard = server::names_instance(first)
    give(mut h, 1, 5, seed: 11)
    let a = sign_up(mut h, 1, 5)
    assert(a.name == names::text(first))
    // It draws again: its first name is let go.
    h.given.push(seed_bytes(12))
    let Reply::Welcome { me, .. } = h.say(
        1,
        Request::Reroll { csrf: a.csrf.clone() },
    )[0].clone() else {
        panic("drawn again")
    }
    assert(me.name != a.name && owned_names(h) == 1)
    // Another takes the first name, at a later generation.
    give(mut h, 2, 6, seed: 11)
    let b = sign_up(mut h, 2, 6)
    assert(b.name == names::text(first), b.name.as_str())
    // The old owner's release and keep come again, late: each names the old owner and its
    // generation, so the name stays the new owner's.
    for note in [
        server::Note::Release { name: first, owner: a.handle.clone(), generation: 1 },
        server::Note::Keep { name: first, owner: a.handle.clone(), generation: 1 },
        server::Note::Release { name: first, owner: b.handle.clone(), generation: 1 },
    ] {
        let letter = server::Letter { time: h.time, note: note.clone(), confirm: Vec::new() }
        h.tell(a.at().as_str(), shard.as_str(), save(letter))
    }
    h.settle()
    var owner: Vec<u8> = Vec::new()
    var generation: u64 = 0
    for e in h.store_of(shard.as_str()) {
        let r: Result<shards::NameEntry, LoadError> = load(e.value.clone())
        if let Ok(entry) = r {
            if !entry.owner.is_empty() {
                owner = entry.owner.clone()
                generation = entry.generation
            }
        }
    }
    assert(owner == b.handle && generation == 2, f"the new owner's, generation {generation}")
}

/// The account record of `s`, as its store holds it.
fn account_record(h: Host, s: Signed) -> Option<account::Account> {
    let v = record(h, s, account::ACCOUNT)?
    let a: Result<account::Account, LoadError> = load(v.clone())
    take a.ok()
}

@test
fn a_draw_whose_shard_answers_late_never_undoes_a_keep() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    // The draw's shard is slow to answer, and the name is kept meanwhile.
    h.pausing.push(String::from("names/"))
    let drawn = h.send(1, [Request::Reroll { csrf: s.csrf.clone() }], public: false)
    h.settle()
    assert(h.paused.len() == 1, "waiting at the shard")
    h.pausing.clear()
    let Reply::Welcome { me, .. } = h.say(
        1,
        Request::Keep { csrf: s.csrf.clone() },
    )[0].clone() else {
        panic("kept")
    }
    assert(me.fixed && me.name == s.name)
    h.unpause()
    h.settle()
    let Some(a) = account_record(h, s) else { panic("an account") }
    assert(a.fixed && names::text(a.name) == s.name && a.rerolls == account::REROLLS, "as kept")
    assert(owned_names(h) == 1, "the late claim let go")
    assert(refused([h.answers(1, drawn)[0].reply.clone()]), "the draw came too late")
}

@test
fn a_draw_whose_shard_answers_late_never_brings_back_a_deleted_account() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    h.pausing.push(String::from("names/"))
    let drawn = h.send(1, [Request::Reroll { csrf: s.csrf.clone() }], public: false)
    h.settle()
    assert(h.paused.len() == 1, "waiting at the shard")
    h.pausing.clear()
    let Reply::Done = h.say(1, Request::Delete { csrf: s.csrf.clone() })[0].clone() else {
        panic("deleted")
    }
    assert(nothing_left(h, s), "deleted before the draw comes back")
    h.unpause()
    h.settle()
    assert(nothing_left(h, s), "still nothing of it, and no name of it held")
    assert(refused([h.answers(1, drawn)[0].reply.clone()]), "the draw came too late")
}

// ---- passkeys as an authenticator makes them --------------------------------------------------------

fn unhex(s: str) -> Vec<u8> {
    let Some(bytes) = account::unhex(s) else { panic("hexadecimal") }
    bytes
}

fn bytes_of(s: str) -> Vec<u8> {
    Vec::from(String::from(s).as_bytes())
}

fn cbor(out: mut Vec<u8>, major: u32, n: u32) {
    if n < 24 {
        out.push(u8((major << 5) | n))
    } else {
        out.push(u8((major << 5) | 24))
        out.push(u8(n))
    }
}

fn cbor_bytes(out: mut Vec<u8>, major: u32, b: [u8]) {
    cbor(mut out, major: major, n: b.len())
    for x in b {
        out.push(x)
    }
}

/// The authenticator's data for `rp_id`: the person present and verified, the counter, then
/// `rest`.
fn auth_data(rp_id: str, flags: u32, counter: u32, rest: [u8]) -> Vec<u8> {
    var out = Vec::from(sha256(bytes_of(rp_id)))
    out.push(u8(flags))
    for k in 0..4 {
        out.push(u8((counter >> (24 - 8 * k)) & 255))
    }
    for b in rest {
        out.push(b)
    }
    out
}

/// A new passkey's attestation object, its format "none": credential `id` with an ES256 key whose
/// coordinates are `seed`'s.
fn made(rp_id: str, id: [u8], seed: u8) -> Vec<u8> {
    var rest: Vec<u8> = Vec::filled(16, u8(0))
    rest.push(0)
    rest.push(u8(id.len()))
    for b in id {
        rest.push(b)
    }
    cbor(mut rest, major: 5, n: 5)
    cbor(mut rest, major: 0, n: 1)
    cbor(mut rest, major: 0, n: 2)
    cbor(mut rest, major: 0, n: 3)
    cbor(mut rest, major: 1, n: 6)
    cbor(mut rest, major: 1, n: 0)
    cbor(mut rest, major: 0, n: 1)
    cbor(mut rest, major: 1, n: 1)
    cbor_bytes(mut rest, 2, [seed; 32])
    cbor(mut rest, major: 1, n: 2)
    cbor_bytes(mut rest, 2, [seed + 1; 32])
    let auth = auth_data(rp_id, 1 | 4 | 64, 0, rest)
    var out: Vec<u8> = Vec::new()
    cbor(mut out, major: 5, n: 3)
    cbor_bytes(mut out, 3, bytes_of("fmt"))
    cbor_bytes(mut out, 3, bytes_of("none"))
    cbor_bytes(mut out, 3, bytes_of("attStmt"))
    cbor(mut out, major: 5, n: 0)
    cbor_bytes(mut out, 3, bytes_of("authData"))
    cbor_bytes(mut out, 2, auth)
    out
}

fn client(kind: str, challenge: [u8], origin: str) -> Vec<u8> {
    let c = base64url(challenge)
    bytes_of(
        f"{{\"type\":\"{kind}\",\"challenge\":\"{c}\",\"origin\":\"{origin}\",\"crossOrigin\":false}}",
    )
}

const REG_CLIENT: Text = ""
const REG_ATTESTATION: Text = ""
const AUTH_CLIENT: Text = ""
const AUTH_SIGNATURE: Text = "30450220694969d3ee928de6f02ef23a9c644d7d779916451734a94b432542f498a1ebe90221008b0819c824218a97152cd099c55bfb1477b29d900a49a64018314f9bfccda163"

@test
fn a_games_token_only_submits_runs_and_a_session_never_does() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    assert(refused(h.say(1, Request::Token { game: String::from("toy") })), "knighted first")
    let _ = h.say(1, Request::Keep { csrf: s.csrf.clone() })
    let _ = h.say(1, Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: false })
    assert(refused(h.say(1, Request::Token { game: String::from("other") })), "only its game")
    let token = token_of(mut h, 1)
    assert(
        token.len() == 48 && part(token, at: 0, n: 16) == s.handle,
        "its account's handle, then a secret",
    )
    // As a session it opens nothing, and the cookie that held it is cleared.
    h.keep(2, server::SESSION, token)
    let Reply::Welcome { me, .. } = h.say(2, Request::Me)[0].clone() else { panic("welcome") }
    assert(!me.signed_in, "a game's token isn't a session")
    assert(h.cookie(2, server::SESSION).is_empty(), "a session cookie for no session is cleared")
    // A session's cookie doesn't upload.
    let Reply::Refused { .. } = upload(
        mut h,
        2,
        s.session,
        toy(0, claimed: 3, moves: 3, m: 2),
    ) else {
        panic("a session's token can't upload")
    }
    let Reply::Verified { .. } = upload(mut h, 2, token, toy(0, claimed: 3, moves: 3, m: 2)) else {
        panic("the game's token uploads")
    }
    // An hour on, it has expired.
    h.time += 3601000
    let Reply::Refused { .. } = upload(mut h, 2, token, toy(0, claimed: 4, moves: 4, m: 2)) else {
        panic("an expired token, till it's new")
    }
}

@test
fn an_upload_is_played_again_and_its_time_and_category_are_the_servers() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    let good = toy(1, claimed: 2500, moves: 2500, m: 2)
    let Reply::Verified { run, ticks, place } = upload(mut h, 1, token, good) else {
        panic("verified")
    }
    assert(
        ticks == 2500 && place == 1 && run.handle == s.handle && run.n == 1,
        f"{ticks} at {place}",
    )
    // Every move even: it counts for 100% too.
    for category in [ANY, FULL] {
        // A board's page is a public read: a cache may keep it a while.
        let (b, age) = h.read(2, board(1, category))
        assert(age == server::BOARD_AGE, "a board's page may be cached")
        let p = places_of(b)
        assert(p.len() == 1 && p[0].name == s.name && p[0].ticks == 2500 && p[0].run == run)
    }
    // Its replay, by the run, kept a year: it never changes.
    let a = h.read_whole(2, Request::Watch { run: run.clone() })
    let Reply::Run { replay, run: watched, .. } = a.reply else { panic("the run") }
    assert(replay == good && watched == run && a.public == server::RUN_AGE && a.immutable)
    // What changes things can't be a GET; and a POST's answer is never cached.
    let (r, age) = h.read(1, Request::Keep { csrf: s.csrf.clone() })
    assert(refused([take r]) && age == 0, "a change by GET")
    // A run that claims a time its moves don't make, an odd one for 100%, and the same run again.
    let Reply::Rejected { .. } = upload(
        mut h,
        1,
        token,
        toy(1, claimed: 2000, moves: 2500, m: 2),
    ) else {
        panic("a tampered run")
    }
    let Reply::Verified { run: again, place: first, .. } = upload(mut h, 1, token, good) else {
        panic("the same run twice: what came of it")
    }
    assert(again == run && first == 1, "the same run, not another")
    let Reply::Verified { place, .. } = upload(
        mut h,
        1,
        token,
        toy(1, claimed: 2400, moves: 2400, m: 1),
    ) else {
        panic("verified")
    }
    assert(place == 1, "faster on any%")
    assert(
        places_of(h.say(2, board(1, FULL))[0].clone())[0].ticks == 2500,
        "100% keeps the run that found everything",
    )
    let any = places_of(h.say(2, board(1, ANY))[0].clone())
    assert(any.len() == 1 && any[0].ticks == 2400, "an account's best alone")
    // A run of the other course: now the whole game has a sum.
    let Reply::Verified { .. } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 100, moves: 100, m: 2),
    ) else {
        panic("verified")
    }
    let whole = places_of(h.say(2, board(WHOLE, ANY))[0].clone())
    assert(whole.len() == 1 && whole[0].ticks == 2500 && whole[0].run.is_none(), f"{whole.len()}")
    assert(h.keys("account/", "u/") == 3, "a run each verified, none for the same again")
}

@test
fn uploads_are_bounded() {
    var h = host()
    let (_, token) = uploader(mut h, 1, 5)
    let Reply::Rejected { .. } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 60000, moves: 60000, m: 2),
    ) else {
        panic("past the most bytes")
    }
    let Reply::Rejected { .. } = upload(mut h, 1, token, toy(5, claimed: 3, moves: 3, m: 2)) else {
        panic("not one of the game's")
    }
    for k in 0..server::RUNS_AN_HOUR {
        let Reply::Verified { .. } = upload(mut h, 1, token, toy(0, 10 + k, 10 + k, 2)) else {
            panic("within the hour's")
        }
    }
    let r = upload(mut h, 1, token, toy(0, claimed: 99, moves: 99, m: 2))
    let Reply::Refused { why } = r else { panic("past the hour's, till the next") }
    assert(why.as_str().find("an hour").is_some(), why.as_str())
    // The next hour, with a new token (the first has expired).
    h.time += 3600000
    let fresh = token_of(mut h, 1)
    let Reply::Verified { .. } = upload(
        mut h,
        1,
        fresh,
        toy(0, claimed: 99, moves: 99, m: 2),
    ) else {
        panic("the next hour")
    }
}

@test
fn a_recovery_code_signs_in_once_ends_every_other_session_and_needs_a_passkey_next() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    borrow code = s.codes[3]
    let rs = h.say(3, Request::Recover { code: code.clone() })
    let Reply::Session { me, csrf, .. } = rs[0].clone() else {
        panic(f"recovered: {why_of(rs[0])}")
    }
    assert(me.must_add_passkey && h.cookie(3, server::SESSION).len() == 48)
    // The session in browser 1 ended: its next request finds so.
    let Reply::Welcome { me, .. } = h.say(1, Request::Me)[0].clone() else { panic("welcome") }
    assert(!me.signed_in, "every other session ended")
    assert(h.keys(s.at().as_str(), "s/") == 1)
    // Used up, here and at its shard.
    assert(refused(h.say(2, Request::Recover { code: code.clone() })), "used once")
    assert(live_codes(h) == CODES - 1, "its shard let it go")
    // Until a passkey is added, nothing else.
    assert(refused(h.say(3, Request::Token { game: String::from("toy") })))
    assert(refused(h.say(3, Request::Reroll { csrf: csrf.clone() })))
    let begun = h.say(3, begin(ADD_PASSKEY, csrf.clone()))
    assert(handle_of(begun) == s.handle, "a passkey added is made for the account's handle")
    let c = challenge_of(begun)
    let rs = h.say(
        3,
        Request::AddPasskey {
            csrf: csrf.clone(),
            challenge: c.clone(),
            id: Vec::from([9]),
            client_data: client("webauthn.create", c, ORIGIN),
            attestation: made(RP, [9], 9),
        },
    )
    let Reply::Welcome { me, .. } = rs[0].clone() else {
        panic(f"a passkey added: {why_of(rs[0])}")
    }
    assert(!me.must_add_passkey && h.keys(s.at().as_str(), "c/") == 2)
    assert(!refused(h.say(3, Request::Reroll { csrf: csrf.clone() })))
}

/// A recovery code whose hash's shard is `shard`'s, and isn't `not`.
fn code_in(shard: String, not: str) -> String {
    for k in 0..10000 {
        let c = account::code([u8(k & 255), u8(k >> 8), 0, 0, 0, 0, 0, 0, 0, 1])
        if c.as_str() == not {
            continue
        }
        let Some(h) = account::code_hash(c.as_str()) else { continue }
        if server::codes_instance(h) == shard {
            return c
        }
    }
    panic("a code in that shard")
}

@test
fn recovery_codes_are_rate_limited_at_each_code_shard() {
    var h = host()
    let first = String::from("0000-0000-0000-0000")
    let Some(hash) = account::code_hash(first.as_str()) else { panic("a code") }
    let shard = server::codes_instance(hash)
    // Everyone's tries at one shard in a minute, from any browser (each browser's own limit is the
    // host's).
    for k in 0..server::ALL_TRIES {
        let r = h.say(k, Request::Recover { code: first.clone() })[0].clone()
        assert(why_of(r).as_str().find("Too many").is_none(), "within the limit")
    }
    let same = code_in(shard.clone(), first.as_str())
    let r = h.say(99, Request::Recover { code: same })[0].clone()
    assert(why_of(r).as_str().find("Too many").is_some(), why_of(r).as_str())
    // Another shard's codes have their own.
    let other = if shard == String::from("codes/00") { String::from("codes/01") } else {
        String::from("codes/00")
    }
    let elsewhere = code_in(other, "")
    let r = h.say(99, Request::Recover { code: elsewhere })[0].clone()
    assert(why_of(r).as_str().find("Too many").is_none(), "another shard's tries")
    // A minute on, there are tries again.
    h.time += 60000
    let r = h.say(99, Request::Recover { code: first.clone() })[0].clone()
    assert(why_of(r).as_str().find("Too many").is_none())
    assert(refused(h.say(99, Request::Recover { code: String::from("not a code") })))
}

/// Whether nothing of account `s` is left anywhere: its store only its mark, and no board, whole
/// board, search, replay, code or name of it.
fn nothing_left(h: Host, s: Signed) -> bool {
    let store = h.store_of(s.at().as_str())
    let marked = store.len() == 1 &&
        store[0].key == Vec::from(String::from(account::GONE).as_bytes())
    marked &&
        places(h) == 0 &&
        h.keys("board/", "n") + h.keys("whole/", "n") == 0 &&
        h.keys("search/", "n") + h.keys("search/", "t") == 0 &&
        owned_replays(h) == 0 &&
        live_codes(h) == 0 &&
        owned_names(h) == 0
}

@test
fn an_account_deleted_leaves_nothing_and_its_export_holds_what_was_kept() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    // Five runs of 47,000 moves: their replays, as base64, are more than one part of the export.
    for k in 0..5 {
        let Reply::Verified { .. } = upload(mut h, 1, token, toy(0, 47000 + k, 47000 + k, 2)) else {
            panic("verified")
        }
    }
    let Reply::Verified { .. } = upload(
        mut h,
        1,
        token,
        toy(1, claimed: 30, moves: 30, m: 2),
    ) else {
        panic("verified")
    }
    assert(places(h) == 6, "both courses, both categories, and the whole game's of each")
    // Asked part by part, each from where the last ended, until the last.
    var text = String::new()
    var after: Vec<u8> = Vec::new()
    var parts = 0
    var last = false
    while !last && parts < 8 {
        let Reply::Export { text: t, next, last: l } = h.say(
            1,
            Request::Export { after: after.clone() },
        )[0].clone() else {
            panic("a part")
        }
        text.push_str(t.as_str())
        after = next.clone()
        last = l
        parts += 1
    }
    assert(last && parts >= 2, f"the export ends, in {parts} parts")
    let Some(doc) = std::json::parse(text.as_str()) else { panic(text.as_str()) }
    let Some(acct) = doc.get(std::json::TOP, "account") else { panic("an account") }
    let Some(n) = doc.get(acct, "name") else { panic("a name") }
    assert(doc.text(n) == Some(s.name.clone()))
    let Some(replays) = doc.get(std::json::TOP, "replays") else { panic("replays") }
    assert(doc.count(replays) == 6, "every replay, once")
    assert(text.as_str().find("\"passkey\":").is_some())
    // More records than one page of the deletion's sweep: a token each.
    for _ in 0..270 {
        let _ = token_of(mut h, 1)
    }
    assert(h.keys(s.at().as_str(), "t/") == 271, "a token each")
    // Deleting needs a fresh sign-in.
    h.time += 600000
    assert(refused(h.say(1, Request::Delete { csrf: s.csrf.clone() })), "not fresh")
    let csrf = fresh(mut h, 1, 5, s)
    let rs = h.say(1, Request::Delete { csrf })
    let Reply::Done = rs[0].clone() else { panic(f"deleted: {why_of(rs[0])}") }
    assert(h.cookie(1, server::SESSION).is_empty(), "its session's cookie cleared")
    // Every removal said done: nothing of it is left, and its handle can't be made again.
    assert(nothing_left(h, s), "nothing left")
    assert(h.outbound("") == 0, "every message delivered")
}

@test
fn an_export_reads_only_its_own_account() {
    var h = host()
    let _a = sign_up(mut h, 1, 5)
    let _ = sign_up(mut h, 2, 6)
    // From a phase there isn't: refused.
    for after in [Vec::from([u8(7)]), Vec::from([u8(3), 97])] {
        assert(refused(h.say(2, Request::Export { after: after.clone() })), "a cursor of no phase")
    }
    // From anywhere else, only its own store is read: never another account's passkey.
    for after in [Vec::from([u8(0)]), Vec::from([u8(0), 97, 47]), Vec::from([u8(2)])] {
        let Reply::Export { text, .. } = h.say(
            2,
            Request::Export { after: after.clone() },
        )[0].clone() else {
            panic("a part")
        }
        assert(text.as_str().find(base64url([5]).as_str()).is_none(), "not account 1's")
    }
    let _ = _a
}

@test
fn a_session_ended_while_another_request_read_it_stays_ended() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    let cookie = h.cookie(1, server::SESSION)
    // Last seen over an hour ago, so a request writes when it was seen.
    h.time += 2 * account::HOUR
    let both = h.together(1, [Request::SignOut { csrf: s.csrf.clone() }, Request::Me])
    let Reply::Welcome { me, .. } = both[0].reply.clone() else { panic("signed out") }
    assert(!me.signed_in)
    // The cookie, kept: it opens nothing.
    h.keep(1, server::SESSION, cookie)
    let Reply::Welcome { me, .. } = h.say(1, Request::Me)[0].clone() else { panic("welcome") }
    assert(!me.signed_in, "the session stays ended")
    assert(h.keys(s.at().as_str(), "s/") == 0)
}

@test
fn a_recovery_code_used_twice_at_once_signs_in_once() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    let code = Request::Recover { code: s.codes[0].clone() }
    let both = h.together(3, [code.clone(), code.clone()])
    var sessions = 0
    for a in both {
        if session_of([a.reply.clone()]).is_some() {
            sessions += 1
        }
    }
    assert(sessions == 1, f"{sessions} sessions")
}

@test
fn every_session_a_recovery_ends_stays_ended_while_one_is_read() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    // 70 sessions, each in its own browser.
    h.good.push(Vec::from([4]))
    for b in 2..71 {
        let _ = sign_in(mut h, b, 5, s.handle, 0, [4])
    }
    assert(h.keys(s.at().as_str(), "s/") == 70)
    h.time += 2 * account::HOUR
    // A session's `Me` is read as the recovery ends every session, and goes on after.
    let _ = h.send(200, [Request::Recover { code: s.codes[0].clone() }], public: false)
    for _ in 0..3 {
        let _ = h.step()
    }
    let _ = h.send(2, [Request::Me], public: false)
    h.settle()
    let Reply::Welcome { me, .. } = h.say(2, Request::Me)[0].clone() else { panic("welcome") }
    assert(!me.signed_in, "the session stays ended")
    assert(h.keys(s.at().as_str(), "s/") == 1, "the recovery's own session alone")
}

@test
fn a_recovery_ends_more_sessions_than_a_page_of_them() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    // 1,100 sessions, more than any page a request reads, made as sign-ins would make them.
    let at = h.instance(s.at().as_str())
    var last: Vec<u8> = Vec::new()
    for k in 0..1100 {
        let token = Vec::from(sha256(save(u32(k))))
        let key = account::session_key(account::hashed(token))
        let session = account::Session {
            csrf: Vec::from([1; 16]),
            created: h.time,
            seen: h.time,
            fresh_until: 0,
            recovery: false,
        }
        put_entry(mut h.instances[at].store, key, save(session))
        if last.is_empty() || key > account::session_key(account::hashed(last)) {
            last = token.clone()
        }
    }
    // The one whose key is read last, in browser 2.
    h.keep(2, server::SESSION, account::held(s.handle, last))
    let Reply::Welcome { me, .. } = h.say(2, Request::Me)[0].clone() else { panic("welcome") }
    assert(me.signed_in, "a session")
    let Reply::Session { .. } = h.say(
        3,
        Request::Recover { code: s.codes[0].clone() },
    )[0].clone() else {
        panic("recovered")
    }
    let Reply::Welcome { me, .. } = h.say(2, Request::Me)[0].clone() else { panic("welcome") }
    assert(!me.signed_in, "ended, past the first page")
    let Reply::Welcome { me, .. } = h.say(1, Request::Me)[0].clone() else { panic("welcome") }
    assert(!me.signed_in, "the sign-up's ended too")
    let Reply::Welcome { me, .. } = h.say(3, Request::Me)[0].clone() else { panic("welcome") }
    assert(me.signed_in && me.must_add_passkey, "the recovery's own session opens")
}

@test
fn a_deletion_a_dropped_instance_left_is_finished_by_the_next() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    post(mut h, 1, token, 10)
    // More records than a page of the sweep: a token each.
    for _ in 0..270 {
        let _ = token_of(mut h, 1)
    }
    let csrf = fresh(mut h, 1, 5, s)
    let _ = h.send(1, [Request::Delete { csrf }], public: false)
    // Marked, then the instance is dropped part way through its sweep: what it asked is never
    // answered.
    var k = 0
    while k < 40 {
        let _ = h.step()
        let r = record(h, s, account::ACCOUNT)
        if let Some(v) = r {
            let a: Result<account::Account, LoadError> = load(v.clone())
            if (take a).unwrap().deleting {
                break
            }
        }
        k += 1
    }
    assert(k < 40, "marked")
    h.drop_instance(s.at().as_str())
    h.settle()
    assert(nothing_left(h, s), "finished by the next, from its own message")
}

@test
fn a_deletion_dropped_after_its_last_clear_keeps_its_mark_and_a_held_sign_up_is_refused() {
    var h = host()
    let begun = h.say(1, begin(REGISTER))
    let (c, handle) = (challenge_of(begun), handle_of(begun))
    let token = h.cookie(1, server::CEREMONY)
    let Some(made) = session_of(h.say(1, register(handle, c, 5))) else { panic("made") }
    var s = made.clone()
    s.handle = handle.clone()
    let _ = h.send(1, [Request::Delete { csrf: s.csrf.clone() }], public: false)
    // Its last records cleared, and the instance dropped before it hears the clear is done.
    var k = 0
    while k < 400 && record(h, s, account::ACCOUNT).is_some() {
        let _ = h.step()
        k += 1
    }
    assert(k < 400, "cleared")
    h.drop_instance(s.at().as_str())
    h.settle()
    assert(nothing_left(h, s), "its mark kept")
    // The sign-up's challenge, its cookie kept back, within its life: refused.
    h.keep(1, server::CEREMONY, token)
    assert(refused(h.say(1, register(handle, c, 6))), "its handle isn't made again")
    assert(h.keys(s.at().as_str(), "a") == 0)
}

// ---- agreement, posting and the public reads -----------------------------------------------------

@test
fn an_account_is_made_only_with_the_current_agreement_and_keeps_it() {
    var h = host()
    let asks = [
        (NOT_AGREED, "nothing agreed"),
        (Agreed { terms: 3, privacy: 4, of_age: false }, "under 13"),
        (Agreed { terms: 2, privacy: 4, of_age: true }, "old terms"),
        (Agreed { terms: 3, privacy: 9, of_age: true }, "another privacy policy"),
    ]
    for (agreed, why) in asks {
        assert(
            refused(h.say(1, Request::Begin { ceremony: REGISTER, csrf: Vec::new(), agreed })),
            why,
        )
    }
    assert(h.keys("", "") == 0, "no ceremony begun, nothing kept")
    // Begun with the versions of the day, then the server's change: the sign-up can't finish.
    let begun = h.say(1, begin(REGISTER))
    let (c, handle) = (challenge_of(begun), handle_of(begun))
    h.deploy(Toy {}, Versions { terms: 4, privacy: 4, posting: 5 })
    assert(refused(h.say(1, register(handle, c, 5))), "the terms changed since it began")
    assert(h.keys("account/", "a") == 0, "no account made")
    // The agreement is in what the challenge's tag covers: one said other than as begun is refused.
    h.deploy(Toy {}, VERSIONS)
    let begun = h.say(1, begin(REGISTER))
    let (c, handle) = (challenge_of(begun), handle_of(begun))
    let Request::Register { handle: hd, challenge, id, client_data, attestation, .. } = register(
        handle,
        c,
        5,
    ) else {
        panic("a sign-up")
    }
    let other = Request::Register {
        handle: hd.clone(),
        challenge: challenge.clone(),
        agreed: Agreed { terms: 3, privacy: 4, of_age: false },
        id: id.clone(),
        client_data: client_data.clone(),
        attestation: attestation.clone(),
    }
    assert(refused(h.say(1, other)), "not what it agreed to as it began")
    // With the current versions: made, and what it agreed to kept with it, and when.
    let made_at = h.time
    let s = sign_up(mut h, 1, 5)
    let Some(v) = record(h, s, account::AGREED) else { panic("the agreement kept") }
    let g: Result<account::Agreement, LoadError> = load(take v)
    let Ok(g) = g else { panic("an agreement") }
    assert(g.agreed == AGREED && g.at > made_at, f"{g.at}")
    // A sign-in agrees to nothing again.
    h.good.push(Vec::from([4]))
    assert(session_of(sign_in(mut h, 2, 5, s.handle, 1, [4])).is_some())
    let Reply::Export { text, .. } = h.say(
        1,
        Request::Export { after: Vec::new() },
    )[0].clone() else {
        panic("an export")
    }
    assert(text.as_str().find("\"agreed\":{\"terms\":3,\"privacy\":4").is_some(), text.as_str())
}

@test
fn a_post_needs_consent_and_the_best_runs_setting_is_kept() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    let _ = h.say(1, Request::Keep { csrf: s.csrf.clone() })
    let token = token_of(mut h, 1)
    let Reply::Posting { agreed, best_runs, .. } = h.say(1, Request::Posting)[0].clone() else {
        panic("posting")
    }
    assert(!agreed && !best_runs, "off until chosen")
    let Reply::Refused { why } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 10, moves: 10, m: 2),
    ) else {
        panic("refused")
    }
    assert(why.as_str().find("Agree").is_some(), why.as_str())
    assert(
        h.keys("account/", "u/") == 0 && h.keys("account/", "h/") == 0,
        "nothing kept, nothing counted",
    )
    // The setting, with the session's CSRF token.
    assert(refused(h.say(1, Request::BestRuns { csrf: Vec::from([1; 16]), on: true })))
    assert(refused(h.say(2, Request::BestRuns { csrf: s.csrf.clone(), on: true })))
    let Reply::Posting { agreed, best_runs, .. } = h.say(
        1,
        Request::BestRuns { csrf: s.csrf.clone(), on: true },
    )[0].clone() else {
        panic("set")
    }
    assert(!agreed && best_runs, "the setting alone is no consent")
    // Consent to another version than the server's is refused.
    assert(
        refused(h.say(1, Request::Consent { csrf: s.csrf.clone(), version: 4, best_runs: true })),
        "an old version",
    )
    let at = h.time
    let rs = h.say(1, Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: true })
    let Reply::Posting { agreed: true, best_runs: true, .. } = rs[0].clone() else {
        panic("agreed")
    }
    let Reply::Posting { agreed, best_runs } = h.say(1, Request::Posting)[0].clone() else {
        panic("posting")
    }
    let Some(v) = record(h, s, account::POSTING) else { panic("the choice kept") }
    let p: Result<account::Posting, LoadError> = load(take v)
    let Ok(p) = p else { panic("a choice") }
    assert(agreed && best_runs && p.at >= at && p.version == 5, "kept, with when")
    let Reply::Verified { .. } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 11, moves: 11, m: 2),
    ) else { panic("posted") }
    // Off again: the consent stays.
    let rs = h.say(1, Request::BestRuns { csrf: s.csrf.clone(), on: false })
    let Reply::Posting { agreed: true, best_runs: false, .. } = rs[0].clone() else { panic("off") }
    // What posting shares changes: the consent is to agree again.
    h.deploy(Toy {}, Versions { terms: 3, privacy: 4, posting: 6 })
    let Reply::Posting { agreed, .. } = h.say(1, Request::Posting)[0].clone() else {
        panic("posting")
    }
    assert(!agreed, "another version")
    let Reply::Refused { .. } = upload(mut h, 1, token, toy(0, claimed: 12, moves: 12, m: 2)) else {
        panic("refused")
    }
}

@test
fn the_best_runs_setting_never_undoes_a_consent_made_beside_it() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    let _ = h.say(1, Request::Keep { csrf: s.csrf.clone() })
    let consent = |best: bool| -> Request {
        Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: best }
    }
    let best = |on: bool| -> Request { Request::BestRuns { csrf: s.csrf.clone(), on } }
    // The setting asked as the consent comes, in one call: each reads before the other writes.
    let _ = h.together(1, [best(true), consent(true)])
    let Reply::Posting { agreed, best_runs } = h.say(1, Request::Posting)[0].clone() else {
        panic("posting")
    }
    assert(agreed && best_runs, "the consent kept, and the setting")
    // Off beside a consent that turned it on: the last asked wins, and the consent stays.
    let _ = h.together(1, [consent(true), best(false)])
    let Reply::Posting { agreed, best_runs } = h.say(1, Request::Posting)[0].clone() else {
        panic("posting")
    }
    assert(agreed && !best_runs, "off, still agreed")
    let Some(v) = record(h, s, account::POST_BEST) else { panic("the setting, apart") }
    let b: Result<account::PostBest, LoadError> = load(take v)
    assert(!(take b).unwrap().on)
}

@test
fn a_runs_replay_is_read_by_its_run_and_kept_for_a_year() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    let good = toy(0, claimed: 30, moves: 30, m: 2)
    let Reply::Verified { run, .. } = upload(mut h, 1, token, good) else { panic("verified") }
    let hash = Vec::from(sha256(good))
    // A board's page names each place's run, and its replay's hash, which the bytes must have.
    let p = places_of(h.read(2, board(0, ANY)).0)
    assert(p.len() == 1 && p[0].replay == hash && p[0].run == run, "the run and its hash")
    let a = h.read_whole(2, Request::Watch { run: run.clone() })
    let Reply::Run { replay, .. } = a.reply else { panic("the replay") }
    assert(replay == good && Vec::from(sha256(replay)) == hash, "the run's bytes")
    assert(a.public == server::RUN_AGE && a.immutable, f"{a.public}")
    assert(wire::run_of(wire::run_path(run).as_str()) == Some(run.clone()))
    // A run nobody has, or of no account, is refused, and that isn't kept.
    for wrong in [
        RunRef { handle: s.handle.clone(), n: 99 },
        RunRef { handle: Vec::from([1, 2]), n: 1 },
        RunRef { handle: Vec::from([1; 16]), n: 1 },
    ] {
        let a = h.read_whole(2, Request::Watch { run: wrong.clone() })
        assert(refused([a.reply.clone()]) && a.public == 0 && !a.immutable)
    }
    // Another account's upload of the same bytes is refused: a replay names one run.
    let (_, other) = uploader(mut h, 3, 6)
    let Reply::Rejected { why } = upload(mut h, 3, other, good) else { panic("refused") }
    assert(why.as_str().find("already on the boards").is_some(), why.as_str())
    // Its account deleted: gone from the server (a cache may keep it a while, as the policy says).
    let csrf = fresh(mut h, 1, 5, s)
    let Reply::Done = h.say(1, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    let a = h.read_whole(2, Request::Watch { run: run.clone() })
    assert(refused([a.reply.clone()]) && owned_replays(h) == 0, "gone with its account")
    // And let go: the other account may post it now.
    let Reply::Verified { .. } = upload(mut h, 3, other, good) else { panic("its own now") }
}

@test
fn a_public_read_is_no_sessions_and_sets_no_cookie() {
    var h = host()
    let (_, token) = uploader(mut h, 1, 5)
    post(mut h, 1, token, 10)
    // Signed in, with a cookie that is no session's, and with none: one answer, no cookie set.
    h.keep(2, server::SESSION, [9, 9, 9])
    let none = h.read_whole(3, board(0, ANY))
    for browser in [1, 2, 3] {
        let a = h.read_whole(browser, board(0, ANY))
        assert(save(a.reply) == save(none.reply) && a.public == server::BOARD_AGE, f"{browser}")
        assert(a.cookies.is_empty(), f"browser {browser}'s answer sets no cookie")
    }
    // Even sent with its cookies (as a `fetch` would), a board's answer reads none.
    let conns = h.send(1, [board(0, ANY)], public: true)
    let i = h.asked_log.len() - 1
    h.asked_log[i].1.session = h.cookie(1, server::SESSION)
    h.settle()
    let a = h.answers(1, conns)
    assert(save(a[0].reply) == save(none.reply) && a[0].cookies.is_empty())
}

@test
fn a_replay_uploaded_by_two_accounts_at_once_is_the_first_ones_alone() {
    var h = host()
    let (owner, a) = uploader(mut h, 1, 5)
    let (other, b) = uploader(mut h, 2, 6)
    // The same bytes from both, at once: each is admitted and played before either is owned.
    let same = toy(0, claimed: 40, moves: 40, m: 2)
    let both = h.together(3, [up(a, same), up(b, same)])
    let first_in = match both[0].reply {
        Reply::Verified { .. } => true,
        _ => false,
    }
    var verified = 0
    var refused_copy = 0
    for r in both {
        match r.reply {
            Reply::Verified { .. } => verified += 1,
            Reply::Rejected { why } => {
                assert(why.as_str().find("already on the boards").is_some(), why.as_str())
                refused_copy += 1
            },
            _ => {},
        }
    }
    assert(verified == 1 && refused_copy == 1, f"{verified} verified, {refused_copy} refused")
    assert(owned_replays(h) == 1 && h.keys("account/", "u/") == 1, "one run, one owner")
    // Whichever got in, deleting the other account leaves its replay.
    let (browser, id, gone, kept) = if first_in { (2, 6, other.clone(), owner.clone()) } else {
        (1, 5, owner.clone(), other.clone())
    }
    let csrf = fresh(mut h, browser, id, gone)
    let Reply::Done = h.say(browser, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    let p = places_of(h.read(9, board(0, ANY)).0)
    assert(p.len() == 1 && p[0].run.handle == kept.handle, "the owner's place stays")
    let Reply::Run { .. } = h.read(9, Request::Watch { run: p[0].run.clone() }).0 else {
        panic("the owner's replay stays")
    }
    assert(owned_replays(h) == 1)
}

@test
fn a_run_posted_again_hears_what_came_of_it_the_first_time() {
    var h = host()
    let (_, token) = uploader(mut h, 1, 5)
    let good = toy(0, claimed: 30, moves: 30, m: 2)
    let Reply::Verified { run, ticks, place } = upload(mut h, 1, token, good) else {
        panic("verified")
    }
    // A faster run of another account's: posted again, the first is second now.
    let (_, other) = uploader(mut h, 2, 6)
    let Reply::Verified { .. } = upload(
        mut h,
        2,
        other,
        toy(0, claimed: 20, moves: 20, m: 2),
    ) else {
        panic("verified")
    }
    let Reply::Verified { run: r2, ticks: t2, place: p2 } = upload(mut h, 1, token, good) else {
        panic("verified again")
    }
    assert(r2 == run && t2 == ticks && place == 1 && p2 == 2, f"{t2} {p2}")
    assert(h.keys("account/", "u/") == 2, "no run made of it again")
    // A rejected run posted again is rejected again, for the same reason, and isn't played again.
    let tampered = toy(0, claimed: 10, moves: 30, m: 4)
    let Reply::Rejected { why } = upload(mut h, 1, token, tampered) else { panic("rejected") }
    let Reply::Rejected { why: again } = upload(mut h, 1, token, tampered) else {
        panic("rejected again")
    }
    assert(why == again && why.as_str().find("match its moves").is_some(), again.as_str())
    assert(h.keys("account/", "v/") == 3 && h.keys("account/", "u/") == 2, "one outcome a replay")
}

@test
fn a_run_posted_again_on_a_new_version_of_the_boards_is_played_on_it() {
    var h = host()
    let (_, token) = uploader(mut h, 1, 5)
    let good = toy(0, claimed: 30, moves: 30, m: 2)
    let Reply::Verified { run: first, .. } = upload(mut h, 1, token, good) else {
        panic("verified on version 7")
    }
    // A change to play starts version 8, and version 7's verifier is archived: the same replay is
    // a new run there, played again.
    h.deploy(Toy { board: 8 }, VERSIONS)
    let Reply::Verified { run, place, .. } = upload(mut h, 1, token, good) else {
        panic("verified on version 8")
    }
    assert(run != first && place == 1, f"{run.n} {place}")
    assert(
        h.keys("account/", "u/") == 2 && h.keys("account/", "v/") == 2,
        "a run and an outcome a version",
    )
    let p = places_of(h.read(2, board(0, ANY)).0)
    assert(p.len() == 1 && p[0].run == run, "on version 8's board")
    // Posted again there, what came of it there; another account's copy is refused there too.
    let Reply::Verified { run: again, .. } = upload(mut h, 1, token, good) else {
        panic("verified again")
    }
    let (_, other) = uploader(mut h, 3, 6)
    let Reply::Rejected { why } = upload(mut h, 3, other, good) else { panic("a copy") }
    assert(again == run && why.as_str().find("already on the boards").is_some(), why.as_str())
    // A run of version 7 still goes up: its archived verifier plays it, onto version 7's board.
    let older = toy(1, claimed: 25, moves: 25, m: 2)
    let Reply::Verified { place, .. } = h.say(1, up(token, older, 7))[0].clone() else {
        panic("played by the archived verifier")
    }
    assert(
        place == 1 &&
            h.keys(board_instance("toy", board: 7, course: 1, category: ANY).as_str(), "r") == 1,
    )
    let Reply::Rejected { .. } = h.say(
        1,
        up(token, toy(1, claimed: 5, moves: 4, m: 2), 7),
    )[0].clone() else {
        panic("the archived verifier's refusal")
    }
    // A version with no verifier kept is closed.
    let Reply::Rejected { why } = h.say(
        1,
        up(token, toy(1, claimed: 21, moves: 21, m: 2), 6),
    )[0].clone() else {
        panic("closed")
    }
    assert(why.as_str().find("closed").is_some(), why.as_str())
}

@test
fn a_run_posted_twice_at_once_is_one_run() {
    var h = host()
    let (_, token) = uploader(mut h, 1, 5)
    let long = up(token, toy(1, claimed: 4000, moves: 4000, m: 2))
    let both = h.together(1, [long.clone(), long.clone()])
    var verified = 0
    for a in both {
        match a.reply {
            Reply::Verified { ticks, .. } => {
                assert(ticks == 4000)
                verified += 1
            },
            Reply::Refused { .. } => {},
            _ => panic(f"{why_of(a.reply)}"),
        }
    }
    assert(verified >= 1 && h.keys("account/", "u/") == 1, f"{verified} told")
    let Reply::Verified { .. } = h.say(1, long)[0].clone() else { panic("and again, the same") }
    assert(h.keys("account/", "u/") == 1)
}

@test
fn a_run_is_refused_until_its_accounts_name_is_kept() {
    var h = host()
    let (s, token) = named(mut h, 1, 5, seed: 0)
    // A record the store holds wrong: a name is kept for good.
    let at = s.at()
    let Some(v) = record(h, s, account::ACCOUNT) else { panic("its account") }
    let r: Result<account::Account, LoadError> = load(take v)
    var drawn = (take r).unwrap()
    drawn.fixed = false
    let i = h.instance(at.as_str())
    put_entry(mut h.instances[i].store, String::from(account::ACCOUNT).as_bytes(), save(drawn))
    let Reply::Refused { why } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 30, moves: 30, m: 2),
    ) else {
        panic("refused")
    }
    assert(why.as_str().find("Keep your name").is_some(), why.as_str())
    assert(
        h.keys("account/", "u/") == 0 && owned_replays(h) == 0 && h.keys("search/", "n") == 0,
        "nothing of it kept",
    )
    // A name not kept draws again; once kept, it can't, so a searched name never goes stale.
    let t = sign_up(mut h, 2, 6)
    let _ = h.say(2, Request::Keep { csrf: t.csrf.clone() })
    assert(refused(h.say(2, Request::Reroll { csrf: t.csrf.clone() })), "kept for good")
}

// ---- slices and searches ---------------------------------------------------------------------------

fn around(name: str, course: u32) -> Request {
    Request::Around { game: String::from("toy"), course, category: ANY, name: String::from(name) }
}

@test
fn a_slice_holds_the_places_around_a_name() {
    var h = host()
    // Eight accounts on course 0, the k-th fastest with 10 + k moves.
    var names: Vec<String> = Vec::new()
    for k in 0..8 {
        let (s, token) = uploader(mut h, k + 1, u8(k + 5))
        post(mut h, k + 1, token, 10 + k)
        names.push(s.name.clone())
    }
    let (r, age) = h.read(20, around(names[6].as_str(), 0))
    assert(age == server::BOARD_AGE, "kept as a board's page is")
    let Reply::Around { places, at } = r else { panic("a slice") }
    assert(at == 7 && places.len() == AROUND + 2, f"{at}: {places.len()} places")
    for i in 0..places.len() {
        let k = i + 1
        assert(places[i].place == k + 1 && places[i].name == names[k], places[i].name.as_str())
        assert(
            places[i].ticks == 10 + k && places[i].replay.len() == 32 && !places[i].run.is_none(),
        )
    }
    // The fastest: nothing above it.
    let Reply::Around { places, at } = h.read(20, around(names[0].as_str(), 0)).0 else {
        panic("a slice")
    }
    assert(at == 1 && places.len() == AROUND + 1 && places[0].name == names[0])
    // A name nobody has, text that isn't a name, a board the name has no run on, and an account
    // that never posted: one answer, kept as a board's page is, so a slice says nothing of whether
    // an account exists.
    let nobody = names::text(names::draw(77777))
    let quiet = sign_up(mut h, 30, 40)
    let _ = h.say(30, Request::Keep { csrf: quiet.csrf.clone() })
    for (name, course) in [
        (take nobody, 0),
        (String::from("Sir Nobody"), 0),
        (names[0].clone(), 1),
        (quiet.name.clone(), 0),
    ] {
        let a = h.read_whole(20, around(name.as_str(), course))
        assert(save(a.reply) == save(Reply::Unplaced), name.as_str())
        assert(a.public == server::BOARD_AGE, "kept as a board's page is")
    }
}

/// The handle of the `k`-th of a crowd.
fn crowd_handle(k: u32) -> Vec<u8> {
    var out: Vec<u8> = Vec::filled(12, u8(200))
    for i in 0..4 {
        out.push(u8((k >> (24 - 8 * i)) & 255))
    }
    out
}

/// Puts `n` accounts' bests on the toy's any% board of course 0, as their accounts would tell it:
/// the k-th with `100 + k` ticks and the name that seed `k` draws.
fn crowd(h: mut Host, n: u32) {
    let to = board_instance("toy", board: 7, course: 0, category: ANY)
    for k in 0..n {
        let handle = crowd_handle(k)
        let name = names::draw(u64(k))
        let best = server::Ranked {
            ticks: 100 + k,
            name: names::text(name),
            key: names::key(name),
            run: RunRef { handle: handle.clone(), n: 1 },
            replay: Vec::filled(32, u8(k & 255)),
        }
        let note = server::Note::Best {
            handle: handle.clone(),
            revision: 1,
            best: Vec::from([take best]),
        }
        let letter = server::Letter { time: h.time, note, confirm: Vec::new() }
        h.tell(account_instance(handle).as_str(), to.as_str(), save(letter))
        if k % 64 == 63 {
            h.settle()
        }
    }
    h.settle()
}

@test
fn a_slice_past_the_places_counted_still_holds_the_places_around_it() {
    var h = host()
    crowd(mut h, server::MOST_PLACE + 8)
    let around_k = |k: u32| -> Request { around(names::text(names::draw(u64(k))).as_str(), 0) }
    // Within the places counted, the last of them, and the first past them: numbered while counted.
    for (k, at_is) in [
        (997, 998),
        (server::MOST_PLACE - 1, server::MOST_PLACE),
        (server::MOST_PLACE, 0),
        (server::MOST_PLACE + 7, 0),
    ] {
        let Reply::Around { places, at } = h.read(20, around_k(k)).0 else { panic("a slice") }
        let below = min(AROUND, server::MOST_PLACE + 7 - k)
        assert(at == at_is && places.len() == AROUND + 1 + below, f"{k}: at {at}, {places.len()}")
        for i in 0..places.len() {
            let ticks = 100 + k - AROUND + i
            let number = if at == 0 { 0 } else { at - AROUND + i }
            assert(places[i].ticks == ticks && places[i].place == number, f"{k}: {i}")
        }
        assert(places[AROUND].name == names::text(names::draw(u64(k))), "its own in the middle")
    }
    // A late message, and the same again, change nothing.
    let to = board_instance("toy", board: 7, course: 0, category: ANY)
    let stale = server::Note::Best { handle: crowd_handle(3), revision: 1, best: Vec::new() }
    let letter = server::Letter { time: h.time, note: stale, confirm: Vec::new() }
    h.tell(account_instance(crowd_handle(3)).as_str(), to.as_str(), save(letter))
    h.settle()
    let Reply::Around { at, .. } = h.read(20, around_k(3)).0 else { panic("still placed") }
    assert(at == 4, f"{at}")
}

@test
fn the_thousand_and_first_moves_up_when_a_place_above_goes() {
    var h = host()
    crowd(mut h, server::MOST_PLACE)
    // An account faster than everyone: the crowd's last is the 1,001st, past the places counted.
    let (s, token) = named(mut h, 1, 5, seed_of(title: 47, front: 63, back: 47, epithet: 127))
    let Reply::Verified { place, .. } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 50, moves: 50, m: 2),
    ) else {
        panic("verified")
    }
    assert(place == 1)
    let last = names::text(names::draw(u64(server::MOST_PLACE - 1)))
    let Reply::Around { at, .. } = h.read(20, around(last.as_str(), 0)).0 else { panic("a slice") }
    assert(at == 0, f"past the places counted: {at}")
    // It's deleted: every best stays kept, so the 1,001st is the 1,000th now, with no upload.
    let csrf = fresh(mut h, 1, 5, s)
    let Reply::Done = h.say(1, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    let Reply::Around { at, places } = h.read(20, around(last.as_str(), 0)).0 else {
        panic("a slice")
    }
    assert(at == server::MOST_PLACE && places[AROUND].name == last, f"moved up: {at}")
    let p = page_with(mut h, server::MOST_PLACE)
    let at = (server::MOST_PLACE - 1) % wire::BOARD_PAGE
    assert(p[at].place == server::MOST_PLACE && p[at].name == last, "on its page")
    assert(nothing_left(h, s) == false, "the crowd is still on the board")
    assert(h.store_of(s.at().as_str()).len() == 1, "the account's store cleared")
}

@test
fn a_run_past_the_places_counted_is_said_unnumbered() {
    var h = host()
    crowd(mut h, server::MOST_PLACE - 1)
    let (_, ta) = named(mut h, 1, 5, seed_of(title: 47, front: 63, back: 47, epithet: 127))
    let slow = toy(0, claimed: 1500, moves: 1500, m: 2)
    let Reply::Verified { place, .. } = upload(mut h, 1, ta, slow) else { panic("verified") }
    assert(place == server::MOST_PLACE, f"the last counted: {place}")
    // One more ahead: it's past the places counted, and so is a slower run, unnumbered.
    crowd(mut h, server::MOST_PLACE)
    let Reply::Verified { place, .. } = upload(mut h, 1, ta, slow) else { panic("verified") }
    assert(place == 0, f"posted again, past them: {place}")
    let (_, tb) = named(mut h, 2, 6, seed_of(title: 46, front: 63, back: 47, epithet: 127))
    let slower = toy(0, claimed: 1600, moves: 1600, m: 2)
    let Reply::Verified { place, .. } = upload(mut h, 2, tb, slower) else { panic("verified") }
    assert(place == 0, f"past them: {place}")
}

@test
fn a_deep_page_reads_after_the_last_and_is_numbered_from_it() {
    var h = host()
    let n = server::MOST_PLACE + 8
    crowd(mut h, n)
    // Every page from the top, each from where the last ended: numbered on, in order, each
    // saying there are more by the one place past it it read, no more.
    var from: u32 = 0
    var after: Vec<u8> = Vec::new()
    var pages = 0
    loop {
        let r = h.read(20, board(0, ANY, from, after.clone())).0
        let Reply::Board { places, total, next } = r else { panic("a page") }
        assert(places.len() == min(wire::BOARD_PAGE, n - from), f"page {pages}")
        for i in 0..places.len() {
            let ok = places[i].place == from + i + 1 && places[i].ticks == 100 + from + i
            assert(ok, f"page {pages}, row {i}: {places[i].place}")
        }
        assert(next.len() == wire::CURSOR_BYTES, "it says where it ends")
        pages += 1
        from += places.len()
        if total <= from {
            break
        }
        assert(total == from + 1, f"one place past the page: {total}")
        after = next.clone()
    }
    assert(from == n && pages == (n + wire::BOARD_PAGE - 1) / wire::BOARD_PAGE, f"{pages} pages")
    // A page further down needs where the last ended, as the server said it; the first, none.
    for wrong in [
        board(0, ANY, from: 40),
        board(0, ANY, from: 0, after: Vec::filled(wire::CURSOR_BYTES, u8(1))),
        board(0, ANY, from: 40, after: Vec::from([1, 2, 3])),
    ] {
        let Reply::Refused { .. } = h.read(20, wrong).0 else { panic("refused") }
    }
}

@test
fn a_search_finds_names_by_noun_or_by_title_at_most_twenty_and_never_a_deleted_one() {
    var h = host()
    // 24 Wobblesnouts with runs, each its own title and epithet, and one without a run.
    var signed: Vec<Signed> = Vec::new()
    for k in 0..24 {
        let (s, token) = named(
            mut h,
            k + 1,
            u8(k + 5),
            seed_of(title: k, front: 0, back: 0, epithet: k),
        )
        post(mut h, k + 1, token, 10 + k)
        signed.push(s.clone())
    }
    let (quiet, _) = named(mut h, 30, 40, seed_of(title: 1, front: 0, back: 0, epithet: 40))
    let search = |title: Text, noun: Text, epithet: Text| -> Request {
        Request::Names {
            game: String::from("toy"),
            title: String::from(title),
            noun: String::from(noun),
            epithet: String::from(epithet),
        }
    }
    let (r, age) = h.read(99, search("", "wob", ""))
    assert(age == server::BOARD_AGE)
    let Reply::Names { found } = r else { panic("names") }
    assert(found.len() == MOST_FOUND, f"{found.len()} found")
    for f in found {
        assert(f.name.as_str().find("Wobblesnout").is_some() && f.standings.len() >= 1)
        assert(f.standings[0].course == 0 && f.standings[0].replay.len() == 32)
        assert(!f.standings[0].run.is_none(), "its run, to watch")
    }
    // By each part: a title and an epithet pick one; a name without a run is never found.
    let Reply::Names { found } = h.read(99, search("dame", "WOBBLES", "")).0 else { panic("names") }
    assert(found.len() == 1 && found[0].name == signed[1].name, f"{found.len()} found")
    assert(found[0].name != quiet.name, "no run, not found")
    let epithet = names::EPITHETS[3]
    let Reply::Names { found } = h.read(99, search("", "wobble", epithet)).0 else { panic("names") }
    assert(found.len() == 1 && found[0].name == signed[3].name)
    let Reply::Names { found } = h.read(99, search("", "Wobblepaw", "")).0 else { panic("names") }
    assert(found.is_empty(), "another noun")
    // By a title alone: every letter's shard asked.
    let Reply::Names { found } = h.read(99, search("dame", "", "")).0 else { panic("names") }
    assert(found.len() == 1 && found[0].name == signed[1].name, f"by title: {found.len()}")
    // Too wide, nothing at all, or what no name holds: refused.
    for (t, n, p) in [
        ("", "", "Unh"),
        ("", "", ""),
        ("", "w0b", ""),
        ("", "", "                                 x"),
    ] {
        assert(refused([h.read(99, search(t, n, p)).0]), f"{t}|{n}|{p}")
    }
    // Deleted: gone from a search once its shard hears.
    let csrf = fresh(mut h, 4, 8, signed[3])
    let Reply::Done = h.say(4, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    let Reply::Names { found } = h.read(99, search("", "wobble", epithet)).0 else { panic("names") }
    assert(found.is_empty(), "a deleted account")
}

@test
fn a_search_reads_a_range_of_names_a_page_at_a_time() {
    var h = host()
    // 70 Sir Wobblesnouts with runs, by epithet in the index's order, and one without: the epithet
    // asked for is the last's, past the range's first page.
    for k in 0..70 {
        let (_, token) = named(
            mut h,
            k + 1,
            u8(k + 5),
            seed_of(title: 0, front: 0, back: 0, epithet: k),
        )
        post(mut h, k + 1, token, 10 + k)
    }
    let _ = sign_up(mut h, 80, 90)
    assert(
        owned_names(h) == 71 && h.keys("search/", "n") == 70,
        "only names with runs are searched",
    )
    let Reply::Names { found } = h.read(
        99,
        Request::Names {
            game: String::from("toy"),
            title: String::from("Sir"),
            noun: String::from("Wobblesnout"),
            epithet: String::from(names::EPITHETS[69]),
        },
    ).0 else { panic("names") }
    assert(
        found.len() == 1 && found[0].name.as_str().ends_with(names::EPITHETS[69]),
        f"{found.len()}",
    )
    // A title alone is its range of each letter's shard, asked at once, in the index's order.
    let before = h.calls.len()
    let Reply::Names { found } = h.read(
        99,
        Request::Names {
            game: String::from("toy"),
            title: String::from("Sir"),
            noun: String::new(),
            epithet: String::new(),
        },
    ).0 else { panic("names") }
    assert(
        found.len() == MOST_FOUND && h.calls.len() - before == server::letters().len(),
        f"{h.calls.len() - before} calls",
    )
    for k in 0..found.len() {
        assert(found[k].name.as_str().ends_with(names::EPITHETS[k]), "in the index's order")
    }
}

// ---- what spans instances --------------------------------------------------------------------------

@test
fn a_run_uploaded_while_its_account_is_deleted_leaves_nothing() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    let csrf = fresh(mut h, 1, 5, s)
    // Admitted and played; its replay's shard is slow to answer, and the deletion comes meanwhile,
    // its removals held, so the account is fenced and not yet cleared when the run comes back.
    h.pausing.push(String::from("replays/"))
    h.holding.push(String::from("replays/"))
    let conns = h.send(2, [up(token, toy(1, claimed: 400, moves: 400, m: 2))], public: false)
    h.settle()
    assert(h.paused.len() == 1, "waiting at its replay's shard")
    let Reply::Done = h.say(1, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    h.unpause()
    h.settle()
    let a = h.answers(2, conns)
    let Reply::Refused { why } = a[0].reply.clone() else { panic(f"refused: {why_of(a[0].reply)}") }
    assert(why.as_str().find("gone").is_some(), why.as_str())
    assert(h.keys(s.at().as_str(), "u/") == 0 && places(h) == 0, "never recorded, never ranked")
    h.holding.clear()
    h.settle()
    assert(nothing_left(h, s), "its replay let go with the rest")
    // Had its replay's shard heard of it only after the deletion, it's never its own again.
    let (t, tk) = uploader(mut h, 3, 6)
    let c = fresh(mut h, 3, 6, t)
    h.pausing.push(String::from("replays/"))
    let late = h.send(4, [up(tk, toy(1, claimed: 402, moves: 402, m: 2))], public: false)
    h.settle()
    let Reply::Done = h.say(3, Request::Delete { csrf: c })[0].clone() else { panic("deleted") }
    h.unpause()
    h.settle()
    let b = h.answers(4, late)
    let Reply::Rejected { .. } = b[0].reply.clone() else {
        panic(f"not posted: {why_of(b[0].reply)}")
    }
    assert(nothing_left(h, t), "nothing of the second either")
}

@test
fn a_deletion_clears_its_store_only_once_every_removal_is_done() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    let Reply::Verified { run, .. } = upload(
        mut h,
        1,
        token,
        toy(0, claimed: 30, moves: 30, m: 2),
    ) else {
        panic("verified")
    }
    let csrf = fresh(mut h, 1, 5, s)
    // The boards don't hear yet.
    h.holding.push(String::from("board/"))
    let Reply::Done = h.say(1, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    assert(h.cookie(1, server::SESSION).is_empty(), "signed out at once")
    assert(h.keys(s.at().as_str(), "x/") >= 2, "its removals wait")
    assert(h.keys(s.at().as_str(), "u/") == 1, "its store not cleared")
    assert(
        h.keys(s.at().as_str(), "s/") + h.keys(s.at().as_str(), "c/") == 0,
        "no session or passkey",
    )
    // It's fenced: no session opens it, nothing more is recorded, and its run isn't served.
    assert(refused([h.read(2, Request::Watch { run: run.clone() }).0]), "its run, while it goes")
    let Reply::Refused { .. } = upload(mut h, 1, token, toy(0, claimed: 31, moves: 31, m: 2)) else {
        panic("fenced")
    }
    assert(h.keys(s.at().as_str(), "u/") == 1)
    // The boards hear: each says done, and then the store is cleared.
    h.holding.clear()
    h.settle()
    assert(nothing_left(h, s), "cleared once every removal was done")
    // A sign-up replayed onto its handle is refused: its mark stays.
    let begun = h.say(3, begin(REGISTER))
    assert(refused(h.say(3, register(s.handle, challenge_of(begun), 9))), "its handle stays used")
}

@test
fn a_deleted_accounts_late_removals_never_take_its_name_from_the_next_to_hold_it() {
    var h = host()
    let seed = seed_of(title: 2, front: 0, back: 0, epithet: 5)
    let (a, token) = named(mut h, 1, 5, seed)
    post(mut h, 1, token, 20)
    let csrf = fresh(mut h, 1, 5, a)
    // Its boards and search don't hear its removals yet.
    for p in ["board/", "whole/", "search/"] {
        h.holding.push(String::from(p))
    }
    let Reply::Done = h.say(1, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    // Another draws its name while they wait, and posts.
    let (b, tb) = named(mut h, 2, 6, seed)
    post(mut h, 2, tb, 30)
    // They're heard; then a third draws the name, and posts.
    h.holding.clear()
    h.settle()
    let (c, tc) = named(mut h, 3, 7, seed)
    post(mut h, 3, tc, 40)
    // Each holder of a name is found by it, and placed under it.
    for s in [b.clone(), c.clone()] {
        let n = names::parse(s.name.as_str()).unwrap()
        let noun = String::from(names::FRONTS[n.front])
        let found = h.read(
            9,
            Request::Names {
                game: String::from("toy"),
                title: String::new(),
                noun: noun.clone(),
                epithet: String::new(),
            },
        ).0
        let Reply::Names { found } = found else { panic("names") }
        var mine = false
        for f in found {
            if f.name == s.name {
                mine = true
            }
        }
        assert(mine, f"{s.name} is found")
        let Reply::Around { .. } = h.read(9, around(s.name.as_str(), 0)).0 else {
            panic(f"{s.name} is placed")
        }
    }
    assert(b.name != a.name && c.name == a.name, "free only once its removals were done")
    assert(nothing_left_of(h, a), "the first is gone")
}

/// Whether nothing of deleted account `s` is left in its own store but its mark.
fn nothing_left_of(h: Host, s: Signed) -> bool {
    let store = h.store_of(s.at().as_str())
    store.len() == 1 && store[0].key == Vec::from(String::from(account::GONE).as_bytes())
}

@test
fn a_ranking_that_fails_is_answered_saved_and_its_retry_takes_the_first_run() {
    var h = host()
    let (_, token) = uploader(mut h, 1, 5)
    // The board can't be reached: not by the edge's call, nor its account's message.
    h.failing.push(String::from("board/"))
    h.holding.push(String::from("board/"))
    let replay = toy(0, claimed: 30, moves: 30, m: 2)
    let Reply::Refused { why } = upload(mut h, 1, token, replay) else {
        panic("refused, to try again")
    }
    assert(why.as_str().find("saved").is_some(), why.as_str())
    assert(h.keys("account/", "u/") == 1 && places(h) == 0, "kept, not ranked")
    // Tried again once it can be: the run recorded before, ranked now, and no other made.
    h.failing.clear()
    let Reply::Verified { run, place, .. } = upload(mut h, 1, token, replay) else {
        panic("verified")
    }
    assert(place == 1 && run.n == 1 && h.keys("account/", "u/") == 1, f"{run.n}")
    // The account's own message comes later, the same: it changes nothing.
    h.holding.clear()
    h.settle()
    let p = places_of(h.read(2, board(0, ANY)).0)
    assert(p.len() == 1 && p[0].run == run && places(h) == 2, "once, on any% and 100%")
}

@test
fn closed_sign_ups_refuse_a_new_account_and_still_sign_in() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    h.closed = true
    h.deploy(Toy {}, VERSIONS)
    let accounts = h.keys("account/", "a")
    let r = h.say(2, begin(REGISTER))[0].clone()
    assert(why_of(r).as_str().find("closed for now").is_some(), why_of(r).as_str())
    // A sign-up begun before they closed can't finish either.
    assert(refused(h.say(2, register([8; 16], [1; CHALLENGE_BYTES], 6))), "register")
    assert(h.keys("account/", "a") == accounts, "no account made")
    // Signing in and recovery go on.
    h.good.push(Vec::from([4]))
    assert(session_of(sign_in(mut h, 3, 5, s.handle, 0, [4])).is_some(), "a sign-in")
    let rs = h.say(4, Request::Recover { code: s.codes[0].clone() })
    assert(session_of(rs).is_some(), "a recovery")
}

@test
fn recovery_ends_another_accounts_session_in_the_same_browser() {
    var h = host()
    let a = sign_up(mut h, 1, 5)
    let b = sign_up(mut h, 2, 6)
    // Browser 1, signed in to the first, signs in to the second: its cookie is replaced, so the
    // first's session ends at the first's instance.
    h.good.push(Vec::from([4]))
    assert(session_of(sign_in(mut h, 1, 6, b.handle, 0, [4])).is_some())
    assert(h.keys(a.at().as_str(), "s/") == 0 && h.keys(b.at().as_str(), "s/") == 2)
    // And by a code: the second's session in browser 1 ends as the first is recovered there.
    let Reply::Session { .. } = h.say(
        1,
        Request::Recover { code: a.codes[0].clone() },
    )[0].clone() else {
        panic("recovered")
    }
    assert(h.keys(b.at().as_str(), "s/") == 1 && h.keys(a.at().as_str(), "s/") == 1)
}

// ---- what an instance remembers of its own writes -------------------------------------------------

@test
fn a_key_kept_then_forgotten_reads_as_gone() {
    var e = engine(Toy {}, RP, ORIGIN, VERSIONS, account_instance([7; HANDLE_BYTES]).as_str())
    e.begin()
    e.keep(Vec::from([1]), Vec::from([2]))
    e.forget(Vec::from([1]))
    // A read made before either committed, which found the key as it was before both.
    assert(e.latest([1], [1, 9]).is_none(), "gone, not what was kept before")
    e.keep(Vec::from([1]), Vec::from([3]))
    assert(e.latest([1], [0]) == Some(Vec::from([3])), "kept again")
}

@test
fn a_sign_up_whose_tag_check_fails_lets_the_next_begin() {
    var h = host()
    // Two sign-ups for one handle: each begun with the same random bytes.
    let bytes: Vec<u8> = Vec::filled(NONCE_BYTES + CEREMONY_BYTES + HANDLE_BYTES, u8(3))
    h.given.push(bytes.clone())
    let first = h.say(1, begin(REGISTER))
    let handle = handle_of(first)
    let conns = h.send(1, [register(handle, challenge_of(first), 5)], public: false)
    fail_at(mut h, account_instance(handle).as_str(), server::Step::TagChecked)
    h.settle()
    assert(refused([h.answers(1, conns)[0].reply.clone()]), "refused, to try again")
    h.given.push(bytes.clone())
    let again = h.say(1, begin(REGISTER))
    assert(handle_of(again) == handle, "the same handle")
    let rs = h.say(1, register(handle, challenge_of(again), 5))
    assert(session_of(rs).is_some(), f"the next sign-up goes on: {why_of(rs[0])}")
}

@test
fn a_removal_said_done_twice_never_clears_the_store_before_the_name_is_let_go() {
    var h = host()
    let (s, token) = uploader(mut h, 1, 5)
    post(mut h, 1, token, 20)
    let csrf = fresh(mut h, 1, 5, s)
    // Its names and search shards don't hear yet.
    h.holding.push(String::from("names/"))
    h.holding.push(String::from("search/"))
    let Reply::Done = h.say(1, Request::Delete { csrf })[0].clone() else { panic("deleted") }
    // The search hears and says done, so the name is let go next; as that's written, the search's
    // removal is said done again.
    h.holding.retain(|p| p.as_str() == "names/")
    let at = s.at()
    var k = 0
    while k < 400 {
        let i = h.instance(at.as_str())
        var releasing = false
        for j in h.instances[i].engine.jobs {
            if j.step == server::Step::ReleaseAccount {
                releasing = true
            }
        }
        if releasing {
            break
        }
        let _ = h.step()
        k += 1
    }
    assert(k < 400, "its name about to be let go")
    let again = server::Note::Removed { id: Vec::from(String::from("l").as_bytes()) }
    let letter = server::Letter { time: h.time, note: again, confirm: Vec::new() }
    h.tell(server::search_instance(97).as_str(), at.as_str(), save(letter))
    h.settle()
    assert(h.keys(at.as_str(), "x/") == 1, "the name's removal still waits")
    assert(record(h, s, account::ACCOUNT).is_some(), "the store isn't cleared before it's done")
    h.holding.clear()
    h.settle()
    assert(nothing_left(h, s), "then it is")
}

@test
fn a_deletions_clear_remembers_none_of_what_it_deletes() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    let at = s.at()
    // More records than two pages of the clear, none of which the sweep ends itself.
    let i = h.instance(at.as_str())
    for k in 0..600 {
        put_entry(mut h.instances[i].store, account::spent_key(u64(k), [1]), [])
    }
    let _ = h.send(1, [Request::Delete { csrf: s.csrf.clone() }], public: false)
    var most = 0
    var k = 0
    while k < 4000 && h.step() {
        let i = h.instance(at.as_str())
        most = max(most, h.instances[i].engine.gone.len())
        k += 1
    }
    h.settle()
    assert(nothing_left_of(h, s), "cleared")
    assert(most < 64, f"{most} keys remembered gone")
}

@test
fn a_page_numbered_past_any_board_is_refused() {
    var h = host()
    crowd(mut h, 30)
    let after = Vec::filled(wire::CURSOR_BYTES, u8(0))
    for from in [4294967295, 4294967295 - wire::BOARD_PAGE, wire::MOST_FROM + 1] {
        let (r, _) = h.read(20, board(0, ANY, from, after.clone()))
        assert(refused([take r]), f"from {from}")
    }
    let Reply::Board { places, .. } = h.read(
        20,
        board(0, ANY, wire::MOST_FROM, after.clone()),
    ).0 else {
        panic("the deepest page still reads")
    }
    assert(places[0].place == wire::MOST_FROM + 1)
}

@test
fn a_recovery_that_fails_after_its_code_is_checked_leaves_the_code_and_every_session() {
    var h = host()
    let s = sign_up(mut h, 1, 5)
    for step in [server::Step::RecoverSecrets, server::Step::RecoverAccount] {
        let conns = h.send(3, [Request::Recover { code: s.codes[0].clone() }], public: false)
        fail_at(mut h, s.at().as_str(), step)
        h.settle()
        assert(refused([h.answers(3, conns)[0].reply.clone()]), "refused, to try again")
        let Reply::Welcome { me, .. } = h.say(1, Request::Me)[0].clone() else { panic("welcome") }
        assert(me.signed_in, "no session ended")
        assert(live_codes(h) == CODES, "the code still its account's at its shard")
    }
    let rs = h.say(3, Request::Recover { code: s.codes[0].clone() })
    assert(session_of(rs).is_some(), f"the code still signs in: {why_of(rs[0])}")
}
