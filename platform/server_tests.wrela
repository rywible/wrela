// The console's server (server.wrela), run on a fake host: a store in memory, random bytes from
// a counter (or given), and signatures "checked" by a list of good ones, so a test sees exactly
// what the server asks its host to check. The host's own checks (SQLite, the OS's randomness, ES256
// by RustCrypto) are the toolchain's, tested there (wrela-compiler, `server_services.rs`).
//
// Its passkeys come from the W3C's test vectors (WebAuthn Level 3, §16, "Packed Attestation with
// ES256 Credential": https://w3c.github.io/webauthn/#sctn-test-vectors, generated by its
// test-vectors/webauthn-test-vectors.py), and from passkeys made here as an authenticator makes
// them.

use account::{CEREMONY_BYTES, CODES, CHALLENGE_BYTES, HANDLE_BYTES, account_key}
use server::{Asked, Claim, Command, Cookie, Engine, Game, Outcome, Versions, engine}
use std::crypto::{Signature, p256_key}
use std::hash::sha256::sha256
use std::serialize::{LoadError, load, save}
use std::store::Entry
use std::webauthn::base64url
use wire::{
    ADD_PASSKEY, ANY, AROUND, Agreed, FULL, MOST_FOUND, NOT_AGREED, REGISTER, Reply, Request,
    SIGN_IN, WHOLE,
}

// ---- a toy game ---------------------------------------------------------------------------------

/// A game whose replay is its course, the time it claims (4 bytes) and its moves: a run's time is
/// how many moves it has, and it counts for 100% when every move is even.
struct Toy {}

struct ToyRun {
    moves: Vec<u8>,
    at: u32,
}

impl Game for Toy {
    type Run = ToyRun

    fn id(self) -> Text {
        "toy"
    }

    fn board(self) -> u32 {
        7
    }

    fn courses(self) -> u32 {
        2
    }

    fn claim(self, replay: [u8]) -> Result<Claim, Text> {
        if replay.len() < 5 || replay[0] >= 2 {
            return Err("That isn't a run of this game.")
        }
        Ok(Claim { course: u32(replay[0]), ticks: account::u32_at(replay, 1) })
    }

    fn start(self, replay: [u8]) -> ToyRun {
        var moves: Vec<u8> = Vec::new()
        for i in 5..replay.len() {
            moves.push(replay[i])
        }
        ToyRun { moves, at: 0 }
    }

    fn play(self, run: mut ToyRun, ticks: u32) -> Option<Result<Outcome, Text>> {
        run.at = min(run.at + ticks, run.moves.len())
        if run.at < run.moves.len() {
            return None
        }
        var full = true
        for m in run.moves {
            if m % 2 != 0 {
                full = false
            }
        }
        Some(Ok(Outcome { ticks: run.moves.len(), full }))
    }
}

/// A toy replay of `course`, claiming `claimed` ticks, with `moves` moves of `move`.
fn toy(course: u8, claimed: u32, moves: u32, m: u8) -> Vec<u8> {
    var out: Vec<u8> = Vec::from([course])
    for k in 0..4 {
        out.push(u8((claimed >> (24 - 8 * k)) & 255))
    }
    for _ in 0..moves {
        out.push(m)
    }
    out
}

// ---- the fake host ----------------------------------------------------------------------------------

/// A response the server gave: its request, its reply, the cookies it set, and how long it may be
/// cached.
struct Answered: Clone {
    conn: u32,
    reply: Reply,
    cookies: Vec<Cookie>,
    public: u32,
    immutable: bool,
}

/// A browser's cookie.
struct Kept: Clone {
    browser: u32,
    name: String,
    value: Vec<u8>,
}

struct Host {
    store: Vec<Entry>,
    waiting: Vec<(u32, Option<Vec<u8>>)>,
    /// The requests answered, and the ones whose close the server hears on the next call.
    answered: Vec<Answered>,
    closing: Vec<u32>,
    /// Each browser's cookies, as its browser keeps them.
    jar: Vec<Kept>,
    next_conn: u32,
    /// Random answers to give first, in order; then a counter's bytes.
    given: Vec<Vec<u8>>,
    counter: u32,
    /// Signatures the host says check out.
    good: Vec<Vec<u8>>,
    checked: Vec<Command>,
    /// The host's wall clock, in milliseconds since the Unix epoch.
    time: u64,
    calls: u32,
}

fn host() -> Host {
    Host {
        store: Vec::new(),
        waiting: Vec::new(),
        answered: Vec::new(),
        closing: Vec::new(),
        jar: Vec::new(),
        next_conn: 0,
        given: Vec::new(),
        counter: 0,
        good: Vec::new(),
        checked: Vec::new(),
        time: 1793404800000,
        calls: 0,
    }
}

/// Where `key` is, or would go, in `store`.
fn find(store: [Entry], key: [u8]) -> (u32, bool) {
    for i in 0..store.len() {
        if store[i].key == Vec::from(key) {
            return (i, true)
        }
        if Vec::from(key) < store[i].key {
            return (i, false)
        }
    }
    (store.len(), false)
}

fn answer_get(store: [Entry], key: [u8]) -> Vec<u8> {
    let (i, found) = find(store, key)
    if !found {
        return Vec::from([u8(0)])
    }
    var out: Vec<u8> = Vec::from([u8(1)])
    for b in store[i].value {
        out.push(b)
    }
    out
}

fn answer_scan(store: [Entry], from: [u8], to: [u8], limit: u32, down: bool) -> Vec<u8> {
    var w = std::serialize::Writer::new()
    var picked: Vec<u32> = Vec::new()
    for k in 0..store.len() {
        // Down: from the last, as the host's scan gives them.
        let i = if down { store.len() - 1 - k } else { k }
        borrow key = store[i].key
        if key >= Vec::from(from) &&
            (to.is_empty() || key < Vec::from(to)) &&
            picked.len() < limit {
            picked.push(i)
        }
    }
    w.write_u32(picked.len())
    for i in picked {
        counted(mut w, store[i].key)
        counted(mut w, store[i].value)
    }
    take w.into_bytes()
}

fn counted(w: mut std::serialize::Writer, b: [u8]) {
    w.write_u32(b.len())
    for x in b {
        w.write_u8(x)
    }
}

impl Host {
    /// One call: the answers waiting and the requests that closed, then the requests given, then
    /// what the server asked carried out.
    fn call(mut self, e: mut Engine<Toy>, requests: [(u32, Asked)]) {
        self.calls += 1
        self.time += 10
        e.begin()
        let waiting = self.waiting.clone()
        self.waiting.clear()
        for (t, a) in waiting {
            e.answer(t, a.clone())
        }
        let closing = self.closing.clone()
        self.closing.clear()
        for c in closing {
            e.closed(c)
        }
        for (c, asked) in requests {
            e.http(c, asked.clone())
        }
        e.end()
        let commands = e.commands()
        // A call's requests are answered at its end, from the store as it was before the call's
        // writes, which commit after.
        for c in commands {
            match c {
                Command::Get { ticket, key } => self.waiting.push(
                    (ticket, Some(answer_get(self.store, key))),
                ),
                Command::Scan { ticket, from, to, limit, down } => {
                    self.waiting.push(
                        (ticket, Some(answer_scan(self.store, from, to, limit, down))),
                    )
                },
                Command::Random { ticket, n } => {
                    var bytes: Vec<u8> = Vec::new()
                    if !self.given.is_empty() && n > 1 {
                        bytes = self.given.remove(0)
                    }
                    while bytes.len() < n {
                        self.counter += 1
                        let x = sha256(save(self.counter))
                        for b in x {
                            if bytes.len() < n {
                                bytes.push(b)
                            }
                        }
                    }
                    self.waiting.push((ticket, Some(take bytes)))
                },
                Command::Verify { ticket, signature, .. } => {
                    self.checked.push(c.clone())
                    var ok = false
                    for g in self.good {
                        if g == signature {
                            ok = true
                        }
                    }
                    self.waiting.push((ticket, Some(Vec::from([if ok { u8(1) } else { u8(0) }]))))
                },
                _ => {},
            }
        }
        // Then its writes commit, then its responses go (toolchain 0.13.0's host: `carryOut`).
        for c in commands {
            match c {
                Command::Put { key, value } => {
                    let (i, found) = find(self.store, key)
                    if found {
                        self.store[i].value = value.clone()
                    } else {
                        self.store.insert(i, Entry { key: key.clone(), value: value.clone() })
                    }
                },
                Command::Delete { key } => {
                    let (i, found) = find(self.store, key)
                    if found {
                        let _ = self.store.remove(i)
                    }
                },
                _ => {},
            }
        }
        for c in commands {
            if let Command::Respond { conn, body, cookies, public, immutable } = c {
                for a in self.answered {
                    assert(a.conn != conn, "a request is answered once")
                }
                let r: Result<Reply, LoadError> = load(body.clone())
                self.answered.push(
                    Answered {
                        conn,
                        reply: take r.unwrap(),
                        cookies: cookies.clone(),
                        public,
                        immutable,
                    },
                )
                self.closing.push(conn)
            }
        }
    }

    /// Calls until nothing waits, as the host calls at once while answers wait.
    fn settle(mut self, e: mut Engine<Toy>) {
        var n = 0
        while (!self.waiting.is_empty() || !self.closing.is_empty()) && n < 20000 {
            self.call(mut e, [])
            n += 1
        }
        assert(n < 20000, "the server settles")
    }

    /// Browser `browser`'s cookie `name`: empty if it has none.
    fn cookie(self, browser: u32, name: Text) -> Vec<u8> {
        for k in self.jar {
            if k.browser == browser && k.name.as_str() == name {
                return k.value.clone()
            }
        }
        Vec::new()
    }

    /// Browser `browser` keeps cookie `name` as `value` (none if empty), as a `Set-Cookie` says.
    fn keep(mut self, browser: u32, name: str, value: [u8]) {
        self.jar.retain(|k| k.browser != browser || k.name.as_str() != name)
        if !value.is_empty() {
            self.jar.push(Kept { browser, name: String::from(name), value: Vec::from(value) })
        }
    }

    /// Browser `browser`'s request for `request`, with its cookies, as a `POST` (or a `GET` if
    /// `public`).
    fn asked(self, browser: u32, request: Request, public: bool) -> Asked {
        Asked {
            time: self.time,
            public,
            session: self.cookie(browser, server::SESSION),
            ceremony: self.cookie(browser, server::CEREMONY),
            body: save(request),
        }
    }

    /// Browser `browser` sends `requests` in one call, as `POST`s (or `GET`s if `public`): each
    /// one's answer, its cookies kept.
    fn together(
        mut self,
        e: mut Engine<Toy>,
        browser: u32,
        requests: [Request],
        public: bool = false,
    ) -> Vec<Answered> {
        var given: Vec<(u32, Asked)> = Vec::new()
        var conns: Vec<u32> = Vec::new()
        for r in requests {
            self.next_conn += 1
            conns.push(self.next_conn)
            given.push((self.next_conn, self.asked(browser, r.clone(), public)))
        }
        self.answered.clear()
        self.call(mut e, given)
        self.settle(mut e)
        var out: Vec<Answered> = Vec::new()
        for c in conns {
            var found: Option<Answered> = None
            for a in self.answered {
                if a.conn == c {
                    found = Some(a.clone())
                }
            }
            let Some(a) = found else { panic("every request is answered") }
            for k in a.cookies {
                self.keep(browser, k.name.as_str(), k.value)
            }
            out.push(a.clone())
        }
        out
    }

    /// Browser `browser` sends `request`: its answer, in a list as the tests read it.
    fn say(mut self, e: mut Engine<Toy>, browser: u32, request: Request) -> Vec<Reply> {
        let a = self.together(mut e, browser, [request.clone()])
        Vec::from([a[0].reply.clone()])
    }

    /// Browser `browser` reads `request` by a `GET`: its answer, and how long it may be cached.
    fn read(mut self, e: mut Engine<Toy>, browser: u32, request: Request) -> (Reply, u32) {
        let a = self.together(mut e, browser, [request.clone()], public: true)
        (a[0].reply.clone(), a[0].public)
    }

    /// Like `read`, the answer as the host gave it, with whether it never changes.
    fn read_whole(mut self, e: mut Engine<Toy>, browser: u32, request: Request) -> Answered {
        let a = self.together(mut e, browser, [request.clone()], public: true)
        a[0].clone()
    }

    /// The keys that start with `prefix`.
    fn keys(self, prefix: Text) -> u32 {
        let p = Vec::from(String::from(prefix).as_bytes())
        var n = 0
        for e in self.store {
            if e.key.len() >= p.len() && part(e.key, 0, p.len()) == p {
                n += 1
            }
        }
        n
    }
}

fn part(b: [u8], at: u32, n: u32) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    for i in at..at + n {
        out.push(b[i])
    }
    out
}

// ---- passkeys as an authenticator makes them --------------------------------------------------------

fn unhex(s: str) -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    let digit = |c: u8| -> u8 { if c >= 97 { c - 87 } else { c - 48 } }
    var i = 0
    while i + 1 < s.len() {
        out.push(digit(s.byte(i)) * 16 + digit(s.byte(i + 1)))
        i += 2
    }
    out
}

fn bytes_of(s: str) -> Vec<u8> {
    Vec::from(String::from(s).as_bytes())
}

fn cbor(out: mut Vec<u8>, major: u32, n: u32) {
    if n < 24 {
        out.push(u8((major << 5) | n))
    } else {
        out.push(u8((major << 5) | 24))
        out.push(u8(n))
    }
}

fn cbor_bytes(out: mut Vec<u8>, major: u32, b: [u8]) {
    cbor(mut out, major: major, n: b.len())
    for x in b {
        out.push(x)
    }
}

/// The authenticator's data for `rp_id`: the person present and verified, the counter, then
/// `rest`.
fn auth_data(rp_id: str, flags: u32, counter: u32, rest: [u8]) -> Vec<u8> {
    var out = Vec::from(sha256(bytes_of(rp_id)))
    out.push(u8(flags))
    for k in 0..4 {
        out.push(u8((counter >> (24 - 8 * k)) & 255))
    }
    for b in rest {
        out.push(b)
    }
    out
}

/// A new passkey's attestation object, its format "none": credential `id` with an ES256 key whose
/// coordinates are `seed`'s.
fn made(rp_id: str, id: [u8], seed: u8) -> Vec<u8> {
    var rest: Vec<u8> = Vec::filled(16, u8(0))
    rest.push(0)
    rest.push(u8(id.len()))
    for b in id {
        rest.push(b)
    }
    cbor(mut rest, major: 5, n: 5)
    cbor(mut rest, major: 0, n: 1)
    cbor(mut rest, major: 0, n: 2)
    cbor(mut rest, major: 0, n: 3)
    cbor(mut rest, major: 1, n: 6)
    cbor(mut rest, major: 1, n: 0)
    cbor(mut rest, major: 0, n: 1)
    cbor(mut rest, major: 1, n: 1)
    cbor_bytes(mut rest, 2, [seed; 32])
    cbor(mut rest, major: 1, n: 2)
    cbor_bytes(mut rest, 2, [seed + 1; 32])
    let auth = auth_data(rp_id, 1 | 4 | 64, 0, rest)
    var out: Vec<u8> = Vec::new()
    cbor(mut out, major: 5, n: 3)
    cbor_bytes(mut out, 3, bytes_of("fmt"))
    cbor_bytes(mut out, 3, bytes_of("none"))
    cbor_bytes(mut out, 3, bytes_of("attStmt"))
    cbor(mut out, major: 5, n: 0)
    cbor_bytes(mut out, 3, bytes_of("authData"))
    cbor_bytes(mut out, 2, auth)
    out
}

fn client(kind: str, challenge: [u8], origin: str) -> Vec<u8> {
    let c = base64url(challenge)
    bytes_of(
        f"{{\"type\":\"{kind}\",\"challenge\":\"{c}\",\"origin\":\"{origin}\",\"crossOrigin\":false}}",
    )
}

const RP: Text = "wrela.dev"
const ORIGIN: Text = "https://wrela.dev"
/// The versions the toy's server takes, and a new account's agreement to them.
const VERSIONS: Versions = Versions { terms: 3, privacy: 4, posting: 5 }
const AGREED: Agreed = Agreed { terms: 3, privacy: 4, of_age: true }

/// A challenge for `ceremony`: a new account's agreeing to the toy's versions.
fn begin(ceremony: u32, csrf: Vec<u8> = Vec::new()) -> Request {
    let agreed = if ceremony == REGISTER { AGREED } else { NOT_AGREED }
    Request::Begin { ceremony, csrf: csrf.clone(), agreed }
}

fn challenge_of(rs: [Reply]) -> Vec<u8> {
    for r in rs {
        if let Reply::Challenge { challenge, .. } = r {
            return challenge.clone()
        }
    }
    panic("a challenge")
}

fn handle_of(rs: [Reply]) -> Vec<u8> {
    for r in rs {
        if let Reply::Challenge { handle, .. } = r {
            return handle.clone()
        }
    }
    panic("a challenge")
}

/// An account's session after it signed up: its token (its browser's cookie), CSRF token, name
/// and codes.
struct Signed: Clone {
    session: Vec<u8>,
    csrf: Vec<u8>,
    name: String,
    codes: Vec<String>,
    handle: Vec<u8>,
}

fn session_of(rs: [Reply]) -> Option<Signed> {
    for r in rs {
        if let Reply::Session { csrf, me, codes } = r {
            return Some(
                Signed {
                    session: Vec::new(),
                    csrf: csrf.clone(),
                    name: me.name.clone(),
                    codes: codes.clone(),
                    handle: Vec::new(),
                },
            )
        }
    }
    None
}

fn refused(rs: [Reply]) -> bool {
    for r in rs {
        if let Reply::Refused { .. } = r {
            return true
        }
    }
    false
}

/// A new account in browser `conn`, its passkey credential `id`.
fn sign_up(e: mut Engine<Toy>, h: mut Host, conn: u32, id: u8) -> Signed {
    let begun = h.say(mut e, conn, begin(REGISTER))
    let c = challenge_of(begun)
    let handle = handle_of(begun)
    let rs = h.say(
        mut e,
        conn,
        Request::Register {
            id: Vec::from([id]),
            client_data: client("webauthn.create", c, ORIGIN),
            attestation: made(RP, [id], id),
        },
    )
    let Some(s) = session_of(rs) else { panic("a session") }
    var signed = s.clone()
    signed.handle = take handle
    signed.session = h.cookie(conn, server::SESSION)
    signed
}

/// A sign-in in browser `conn` with credential `id` of the account whose handle is `handle`, its signature
/// `signature` (which the host checks against its good list).
fn sign_in(
    e: mut Engine<Toy>,
    h: mut Host,
    conn: u32,
    id: u8,
    handle: [u8],
    counter: u32,
    signature: [u8],
) -> Vec<Reply> {
    let c = challenge_of(h.say(mut e, conn, begin(SIGN_IN)))
    h.say(
        mut e,
        conn,
        Request::SignIn {
            id: Vec::from([id]),
            client_data: client("webauthn.get", c, ORIGIN),
            authenticator_data: auth_data(RP, 1 | 4, counter, []),
            signature: Vec::from(signature),
            user: Vec::from(handle),
        },
    )
}

fn started() -> (Engine<Toy>, Host) {
    (engine(Toy {}, RP, ORIGIN, VERSIONS), host())
}

// ---- tests ------------------------------------------------------------------------------------------

@test
fn the_w3c_vectors_register_and_their_assertion_is_checked_with_the_registered_key() {
    var e = engine(Toy {}, "example.org", "https://example.org", VERSIONS)
    var h = host()
    // The challenges the vectors were made over, given as the host's random bytes, each with the
    // browser's token after it.
    var first = unhex("c1184a5fddf8045e13dc47f54b61f5a656b666b59018f16d870e9256e9952012")
    for b in [3; CEREMONY_BYTES] {
        first.push(b)
    }
    for b in [7; 16] {
        first.push(b)
    }
    for b in [0, 0, 0, 0, 0, 0, 0, 42, 0, 0, 0, 0, 0, 0, 0, 0] {
        first.push(b)
    }
    h.given.push(take first)
    let begun = h.say(mut e, 1, begin(REGISTER))
    assert(challenge_of(begun).len() == CHALLENGE_BYTES && handle_of(begun) == Vec::from([7; 16]))
    let id = unhex("c9a6f5b3462d02873fea0c56862234f99f081728084e511bb7760201a89054a5")
    let rs = h.say(
        mut e,
        1,
        Request::Register {
            id: id.clone(),
            client_data: unhex(REG_CLIENT),
            attestation: unhex(REG_ATTESTATION),
        },
    )
    let Some(s) = session_of(rs) else { panic("the vector's registration is taken") }
    assert(s.codes.len() == CODES && h.cookie(1, server::SESSION).len() == 32 && !s.name.is_empty())
    assert(h.keys("c/") == 1 && h.keys("n/") == 1 && h.keys("r/") == CODES && h.keys("s/") == 1)
    let (_, found) = find(h.store, account_key(42))
    assert(found, "account 42")
    // Its sign-in: the server asks the host to check the vector's signature, by the key the
    // registration gave, over the authenticator's data and the client's data's hash.
    var second = unhex("b1106fa46a57bef1781511c0557dc898a03413d5f0f17d244630c194c7e1adb5")
    for b in [4; CEREMONY_BYTES] {
        second.push(b)
    }
    h.given.push(take second)
    let _ = h.say(mut e, 1, begin(SIGN_IN))
    let signature = unhex(AUTH_SIGNATURE)
    h.good.push(signature.clone())
    let auth = unhex("bfabc37432958b063360d3ad6461c9c4735ae7f8edd46592a5e0f01452b2e4b50d00000000")
    let cd = unhex(AUTH_CLIENT)
    let rs = h.say(
        mut e,
        1,
        Request::SignIn {
            id: id.clone(),
            client_data: cd.clone(),
            authenticator_data: auth.clone(),
            signature: signature.clone(),
            user: Vec::from([7; 16]),
        },
    )
    assert(session_of(rs).is_some(), "signed in")
    assert(h.checked.len() == 1)
    let Command::Verify {
        algorithm,
        key,
        message,
        signature: sig,
        ..
    } = h.checked[0].clone() else { panic("a check") }
    let x = unhex("1cf27f25da591208a4239c2e324f104f585525479a29edeedd830f48e77aeae5")
    let y = unhex("59e4b7da6c0106e206ce390c93ab98a15a5ec3887e57f0cc2bece803b920c423")
    assert(algorithm == Signature::Es256 && key == p256_key(x, y), "the registered key")
    var covered = auth.clone()
    for b in sha256(cd) {
        covered.push(b)
    }
    assert(message == covered && sig == signature, "what the signature covers")
}

const REG_CLIENT: Text = ""
const REG_ATTESTATION: Text = ""
const AUTH_CLIENT: Text = ""
const AUTH_SIGNATURE: Text = "30450220694969d3ee928de6f02ef23a9c644d7d779916451734a94b432542f498a1ebe90221008b0819c824218a97152cd099c55bfb1477b29d900a49a64018314f9bfccda163"

@test
fn a_bad_signature_another_accounts_handle_or_a_stale_counter_signs_nobody_in() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    h.good.push(Vec::from([1, 2, 3]))
    assert(
        refused(sign_in(mut e, mut h, 2, 5, s.handle, 1, [9, 9])),
        "a signature that doesn't check",
    )
    assert(refused(sign_in(mut e, mut h, 2, 5, [1; 16], 1, [1, 2, 3])), "another account's handle")
    assert(session_of(sign_in(mut e, mut h, 2, 5, s.handle, 3, [1, 2, 3])).is_some(), "a good one")
    assert(refused(sign_in(mut e, mut h, 2, 5, s.handle, 3, [1, 2, 3])), "the counter must go up")
    assert(refused(sign_in(mut e, mut h, 2, 6, s.handle, 4, [1, 2, 3])), "a passkey nobody has")
}

@test
fn a_challenge_is_used_once_by_the_browser_that_asked_and_expires() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    h.good.push(Vec::from([1]))
    let c = challenge_of(h.say(mut e, 2, begin(SIGN_IN)))
    let attempt = Request::SignIn {
        id: Vec::from([5]),
        client_data: client("webauthn.get", c, ORIGIN),
        authenticator_data: auth_data(RP, 1 | 4, 0, []),
        signature: Vec::from([1]),
        user: s.handle.clone(),
    }
    // A synced passkey's counter stays 0, so only the challenge stops a replay of its assertion.
    // Another browser can't use it: it hasn't the ceremony's cookie.
    assert(refused(h.say(mut e, 3, attempt.clone())), "another browser's challenge")
    // Asked again by its own browser: the first try (by browser 3) didn't touch it.
    assert(session_of(h.say(mut e, 2, attempt.clone())).is_some(), "its own")
    assert(h.cookie(2, server::CEREMONY).is_empty(), "the ceremony's cookie cleared")
    assert(refused(h.say(mut e, 2, attempt.clone())), "used once")
    // Two requests in one call with the same ceremony: both read it before either's delete
    // commits, and still only one may use it.
    let c1 = challenge_of(h.say(mut e, 1, begin(SIGN_IN)))
    let twice = Request::SignIn {
        id: Vec::from([5]),
        client_data: client("webauthn.get", c1, ORIGIN),
        authenticator_data: auth_data(RP, 1 | 4, 0, []),
        signature: Vec::from([1]),
        user: s.handle.clone(),
    }
    let both = h.together(mut e, 1, [twice.clone(), twice.clone()])
    assert(
        session_of([both[0].reply.clone()]).is_some() && refused([both[1].reply.clone()]),
        "only the first of two at once",
    )
    // One left five minutes is gone.
    let c2 = challenge_of(h.say(mut e, 2, begin(SIGN_IN)))
    h.time += 301000
    let late = Request::SignIn {
        id: Vec::from([5]),
        client_data: client("webauthn.get", c2, ORIGIN),
        authenticator_data: auth_data(RP, 1 | 4, 0, []),
        signature: Vec::from([1]),
        user: s.handle.clone(),
    }
    assert(refused(h.say(mut e, 2, late)), "expired")
    // An expired ceremony left in the store goes as another begins.
    let c3 = challenge_of(h.say(mut e, 4, begin(SIGN_IN)))
    h.time += 301000
    let _ = h.say(mut e, 5, begin(SIGN_IN))
    assert(h.keys("w/") == 1, "the expired one cleared")
    // A registration over a sign-in's challenge, or from another origin, is refused.
    let c4 = challenge_of(h.say(mut e, 2, begin(SIGN_IN)))
    let wrong = Request::Register {
        id: Vec::from([8]),
        client_data: client("webauthn.create", c4, ORIGIN),
        attestation: made(RP, [8], 8),
    }
    assert(refused(h.say(mut e, 2, wrong)), "another ceremony's challenge")
    let c5 = challenge_of(h.say(mut e, 6, begin(REGISTER)))
    let elsewhere = Request::Register {
        id: Vec::from([8]),
        client_data: client("webauthn.create", c5, "https://evil.example"),
        attestation: made(RP, [8], 8),
    }
    assert(refused(h.say(mut e, 6, elsewhere)), "another origin")
    assert(c3.len() == CHALLENGE_BYTES)
}

@test
fn changes_need_the_sessions_csrf_token() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    assert(refused(h.say(mut e, 1, Request::Reroll { csrf: Vec::from([0; 16]) })), "a wrong token")
    assert(refused(h.say(mut e, 1, Request::Reroll { csrf: Vec::new() })), "no token")
    assert(refused(h.say(mut e, 2, Request::Reroll { csrf: s.csrf.clone() })), "not signed in")
    let rs = h.say(mut e, 1, Request::Reroll { csrf: s.csrf.clone() })
    let Reply::Welcome { me, .. } = rs[0].clone() else { panic("renamed") }
    assert(me.rerolls == 2 && me.name != s.name && !me.fixed, me.name.as_str())
    assert(h.keys("n/") == 1, "the old name let go")
    for _ in 0..2 {
        let _ = h.say(mut e, 1, Request::Reroll { csrf: s.csrf.clone() })
    }
    assert(refused(h.say(mut e, 1, Request::Reroll { csrf: s.csrf.clone() })), "out of draws")
    let kept = h.say(mut e, 1, Request::Keep { csrf: s.csrf.clone() })
    let Reply::Welcome { me, .. } = kept[0].clone() else { panic("kept") }
    assert(me.fixed)
    assert(
        refused(h.say(mut e, 1, Request::Delete { csrf: Vec::from([1; 16]) })),
        "deleting needs it too",
    )
}

@test
fn names_are_unique_however_the_draw_falls() {
    let both = started()
    var e = take both.0
    var h = take both.1
    // Two accounts whose first draws are the same seed.
    for conn in [1, 2] {
        var bytes: Vec<u8> = Vec::filled(CHALLENGE_BYTES + CEREMONY_BYTES + HANDLE_BYTES, u8(conn))
        for b in [0, 0, 0, 0, 0, 0, 0, conn, 0, 0, 0, 0, 0, 0, 0, 3] {
            bytes.push(b)
        }
        h.given.push(take bytes)
    }
    let a = sign_up(mut e, mut h, 1, 5)
    let b = sign_up(mut e, mut h, 2, 6)
    assert(a.name != b.name, a.name.as_str())
    assert(a.name == names::text(names::draw(3)), "the first had the seed's name")
    assert(h.keys("n/") == 2)
}

@test
fn a_games_token_only_submits_runs_and_a_session_never_does() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    assert(refused(h.say(mut e, 1, Request::Token { game: String::from("toy") })), "knighted first")
    let _ = h.say(mut e, 1, Request::Keep { csrf: s.csrf.clone() })
    let _ = h.say(
        mut e,
        1,
        Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: false },
    )
    assert(
        refused(h.say(mut e, 1, Request::Token { game: String::from("other") })),
        "only its game",
    )
    let Reply::Token { token, .. } = h.say(
        mut e,
        1,
        Request::Token { game: String::from("toy") },
    )[0].clone() else { panic("a token") }
    // As a session it opens nothing, and the cookie that held it is cleared.
    h.keep(2, server::SESSION, token)
    let Reply::Welcome { me, .. } = h.say(mut e, 2, Request::Me)[0].clone() else {
        panic("welcome")
    }
    assert(!me.signed_in, "a game's token isn't a session")
    assert(h.cookie(2, server::SESSION).is_empty(), "a session cookie for no session is cleared")
    // A session's token doesn't upload.
    let up = |t: Vec<u8>| -> Request {
        Request::Upload {
            token: t.clone(),
            game: String::from("toy"),
            replay: toy(0, claimed: 3, moves: 3, m: 2),
        }
    }
    let rs = h.say(mut e, 2, up(s.session.clone()))
    let Reply::Rejected { .. } = rs[0].clone() else { panic("a session's token can't upload") }
    let rs = h.say(mut e, 2, up(token.clone()))
    let Reply::Verified { .. } = rs[0].clone() else { panic("the game's token uploads") }
    // An hour on, it has expired.
    h.time += 3601000
    let rs = h.say(
        mut e,
        2,
        Request::Upload {
            token: token.clone(),
            game: String::from("toy"),
            replay: toy(0, claimed: 4, moves: 4, m: 2),
        },
    )
    let Reply::Rejected { .. } = rs[0].clone() else { panic("an expired token") }
}

/// A knighted account in browser `conn` that has agreed to posting, and a token for the toy's
/// boards.
fn uploader(e: mut Engine<Toy>, h: mut Host, conn: u32, id: u8) -> (Signed, Vec<u8>) {
    let s = sign_up(mut e, mut h, conn, id)
    let _ = h.say(mut e, conn, Request::Keep { csrf: s.csrf.clone() })
    let consent = Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: false }
    let Reply::Posting { agreed: true, .. } = h.say(mut e, conn, consent)[0].clone() else {
        panic("agreed to posting")
    }
    let Reply::Token { token, .. } = h.say(
        mut e,
        conn,
        Request::Token { game: String::from("toy") },
    )[0].clone() else { panic("a token") }
    (s, token)
}

@test
fn an_upload_is_played_again_and_its_time_and_category_are_the_servers() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (s, token) = uploader(mut e, mut h, 1, 5)
    // 2,500 moves: several calls of play.
    let good = toy(1, claimed: 2500, moves: 2500, m: 2)
    let rs = h.say(
        mut e,
        1,
        Request::Upload { token: token.clone(), game: String::from("toy"), replay: good.clone() },
    )
    // Answered once it is verified.
    let Reply::Verified { run, ticks, place } = rs[0].clone() else { panic("verified") }
    assert(ticks == 2500 && place == 1, f"{ticks} at {place}")
    // Every move even: it counts for 100% too.
    for category in [ANY, FULL] {
        // A board's page is a public read: a cache may keep it a while.
        let (b, age) = h.read(
            mut e,
            2,
            Request::Board { game: String::from("toy"), course: 1, category, from: 0 },
        )
        assert(age == server::BOARD_AGE, "a board's page may be cached")
        let Reply::Board { places, .. } = b else { panic("a board") }
        assert(
            places.len() == 1 &&
                places[0].name == s.name &&
                places[0].ticks == 2500 &&
                places[0].run == run,
        )
    }
    let (watched, age) = h.read(mut e, 2, Request::Watch { run })
    let Reply::Run { replay, .. } = watched else { panic("the run") }
    assert(replay == good && age == server::RUN_AGE, "its replay, to watch")
    // What changes things can't be a GET; and a POST's answer is never cached.
    let (r, age) = h.read(mut e, 1, Request::Keep { csrf: s.csrf.clone() })
    assert(refused([take r]) && age == 0, "a change by GET")
    // A run that claims a time its moves don't make, an odd one for 100%, and the same run again.
    let tampered = toy(1, claimed: 2000, moves: 2500, m: 2)
    let rs = h.say(
        mut e,
        1,
        Request::Upload { token: token.clone(), game: String::from("toy"), replay: tampered },
    )
    let Reply::Rejected { .. } = rs[rs.len() - 1].clone() else { panic("a tampered run") }
    let rs = h.say(
        mut e,
        1,
        Request::Upload { token: token.clone(), game: String::from("toy"), replay: good.clone() },
    )
    let Reply::Verified { run: again, place: first, .. } = rs[0].clone() else {
        panic("the same run twice: what came of it")
    }
    assert(again == run && first == 1, "the same run, not another")
    let odd = toy(1, claimed: 2400, moves: 2400, m: 1)
    let rs = h.say(
        mut e,
        1,
        Request::Upload { token: token.clone(), game: String::from("toy"), replay: odd },
    )
    let Reply::Verified { place, .. } = rs[0].clone() else { panic("verified") }
    assert(place == 1, "faster on any%")
    let b = h.say(
        mut e,
        2,
        Request::Board { game: String::from("toy"), course: 1, category: FULL, from: 0 },
    )
    let Reply::Board { places, .. } = b[0].clone() else { panic("a board") }
    assert(places[0].ticks == 2500, "100% keeps the run that found everything")
    let b = h.say(
        mut e,
        2,
        Request::Board { game: String::from("toy"), course: 1, category: ANY, from: 0 },
    )
    let Reply::Board { places, .. } = b[0].clone() else { panic("a board") }
    assert(places.len() == 1 && places[0].ticks == 2400, "an account's best alone")
    // A run of the other course: now the whole game has a sum.
    let rs = h.say(
        mut e,
        1,
        Request::Upload {
            token: token.clone(),
            game: String::from("toy"),
            replay: toy(0, claimed: 100, moves: 100, m: 2),
        },
    )
    let Reply::Verified { .. } = rs[0].clone() else { panic("verified") }
    let b = h.say(
        mut e,
        2,
        Request::Board { game: String::from("toy"), course: WHOLE, category: ANY, from: 0 },
    )
    let Reply::Board { places, .. } = b[0].clone() else { panic("a board") }
    assert(places.len() == 1 && places[0].ticks == 2500 && places[0].run == 0, f"{places.len()}")
}

@test
fn uploads_are_bounded() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (_, token) = uploader(mut e, mut h, 1, 5)
    let up = |replay: Vec<u8>| -> Request {
        Request::Upload { token: token.clone(), game: String::from("toy"), replay: replay.clone() }
    }
    let rs = h.say(mut e, 1, up(toy(0, claimed: 60000, moves: 60000, m: 2)))
    let Reply::Rejected { .. } = rs[0].clone() else { panic("past the most bytes") }
    let rs = h.say(mut e, 1, up(toy(5, claimed: 3, moves: 3, m: 2)))
    let Reply::Rejected { .. } = rs[0].clone() else { panic("not one of the game's") }
    // A run whose ticks would make the queue longer than an upload may wait.
    let rs = h.say(mut e, 1, up(toy(0, claimed: server::QUEUE_TICKS + 1, moves: 3, m: 2)))
    let Reply::Rejected { why } = rs[0].clone() else { panic("past the queue's ticks") }
    assert(why.as_str().find("busy").is_some(), why.as_str())
    for k in 0..server::RUNS_AN_HOUR {
        let rs = h.say(mut e, 1, up(toy(0, 10 + k, 10 + k, 2)))
        let Reply::Verified { .. } = rs[0].clone() else { panic("within the hour's") }
    }
    let rs = h.say(mut e, 1, up(toy(0, claimed: 99, moves: 99, m: 2)))
    let Reply::Rejected { why } = rs[0].clone() else { panic("past the hour's") }
    assert(why.as_str().find("an hour").is_some(), why.as_str())
    // The next hour, with a new token (the first has expired).
    h.time += 3600000
    let Reply::Token { token: fresh, .. } = h.say(
        mut e,
        1,
        Request::Token { game: String::from("toy") },
    )[0].clone() else {
        panic("a token")
    }
    let again = Request::Upload {
        token: fresh.clone(),
        game: String::from("toy"),
        replay: toy(0, claimed: 99, moves: 99, m: 2),
    }
    let Reply::Verified { .. } = h.say(mut e, 1, again)[0].clone() else { panic("the next hour") }
}

@test
fn a_recovery_code_signs_in_once_ends_every_other_session_and_needs_a_passkey_next() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    borrow code = s.codes[3]
    let rs = h.say(mut e, 3, Request::Recover { code: code.clone() })
    let Reply::Session { me, csrf, .. } = rs[0].clone() else { panic("recovered") }
    assert(me.must_add_passkey)
    // The session in browser 1 ended: its next request finds so.
    let Reply::Welcome { me, .. } = h.say(mut e, 1, Request::Me)[0].clone() else {
        panic("welcome")
    }
    assert(!me.signed_in, "every other session ended")
    assert(h.keys("s/") == 1)
    // Used up.
    assert(refused(h.say(mut e, 2, Request::Recover { code: code.clone() })), "used once")
    // Until a passkey is added, nothing else.
    assert(refused(h.say(mut e, 3, Request::Token { game: String::from("toy") })))
    assert(refused(h.say(mut e, 3, Request::Reroll { csrf: csrf.clone() })))
    let begun = h.say(mut e, 3, begin(ADD_PASSKEY, csrf.clone()))
    assert(handle_of(begun) == s.handle, "a passkey added is made for the account's handle")
    let c = challenge_of(begun)
    let rs = h.say(
        mut e,
        3,
        Request::AddPasskey {
            csrf: csrf.clone(),
            id: Vec::from([9]),
            client_data: client("webauthn.create", c, ORIGIN),
            attestation: made(RP, [9], 9),
        },
    )
    let Reply::Welcome { me, .. } = rs[0].clone() else { panic("a passkey added") }
    assert(!me.must_add_passkey && h.keys("c/") == 2)
    assert(!refused(h.say(mut e, 3, Request::Reroll { csrf: csrf.clone() })))
}

@test
fn recovery_codes_are_rate_limited() {
    let both = started()
    var e = take both.0
    var h = take both.1
    // Everyone's tries in a minute, from any browser (each browser's own limit is the host's).
    for k in 0..server::ALL_TRIES {
        let rs = h.say(mut e, k, Request::Recover { code: String::from("0000-0000-0000-0000") })
        let Reply::Refused { why } = rs[0].clone() else { panic("refused") }
        assert(why.as_str().find("Too many").is_none(), "within the limit")
    }
    let rs = h.say(mut e, 99, Request::Recover { code: String::from("0000-0000-0000-0009") })
    let Reply::Refused { why } = rs[0].clone() else { panic("refused") }
    assert(why.as_str().find("Too many").is_some(), why.as_str())
    // A minute on, there are tries again.
    h.time += 60000
    let rs = h.say(mut e, 99, Request::Recover { code: String::from("not a code") })
    let Reply::Refused { why } = rs[0].clone() else { panic("refused") }
    assert(why.as_str().find("Too many").is_none())
}

@test
fn an_account_deleted_leaves_nothing_and_its_export_holds_what_was_kept() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (s, token) = uploader(mut e, mut h, 1, 5)
    // Five runs of 47,000 moves: their replays, as base64, are more than one part of the export.
    for k in 0..5 {
        let rs = h.say(
            mut e,
            1,
            Request::Upload {
                token: token.clone(),
                game: String::from("toy"),
                replay: toy(0, claimed: 47000 + k, moves: 47000 + k, m: 2),
            },
        )
        let Reply::Verified { .. } = rs[0].clone() else { panic("verified") }
    }
    // Asked part by part, each from where the last ended, until the last.
    var text = String::new()
    var after: Vec<u8> = Vec::new()
    var parts = 0
    var last = false
    while !last && parts < 8 {
        let Reply::Export { text: t, next, last: l } = h.say(
            mut e,
            1,
            Request::Export { after: after.clone() },
        )[0].clone() else { panic("a part") }
        text.push_str(t.as_str())
        after = next.clone()
        last = l
        parts += 1
    }
    assert(last && parts >= 2, f"the export ends, in {parts} parts")
    let Some(doc) = std::json::parse(text.as_str()) else { panic(text.as_str()) }
    let Some(acct) = doc.get(std::json::TOP, "account") else { panic("an account") }
    let Some(n) = doc.get(acct, "name") else { panic("a name") }
    assert(doc.text(n) == Some(s.name.clone()))
    let Some(replays) = doc.get(std::json::TOP, "replays") else { panic("replays") }
    assert(doc.count(replays) == 5, "every replay, once")
    assert(text.as_str().find("\"passkey\":").is_some())
    // More records than one page of the deletion's scans (256): a token each.
    for _ in 0..270 {
        let _ = h.say(mut e, 1, Request::Token { game: String::from("toy") })
    }
    assert(h.keys("t/") == 271, "a token each")
    // Deleting needs a fresh sign-in.
    h.time += 600000
    assert(refused(h.say(mut e, 1, Request::Delete { csrf: s.csrf.clone() })), "not fresh")
    h.good.push(Vec::from([4]))
    let rs = sign_in(mut e, mut h, 1, 5, s.handle, 1, [4])
    let Some(fresh) = session_of(rs) else { panic("signed in") }
    let rs = h.say(mut e, 1, Request::Delete { csrf: fresh.csrf.clone() })
    let Reply::Done = rs[rs.len() - 1].clone() else { panic("deleted") }
    assert(h.cookie(1, server::SESSION).is_empty(), "its session's cookie cleared")
    // Every record of the account is gone, and nothing else is left.
    for p in ["a/", "c/", "s/", "r/", "n/", "u/", "b/", "q/", "t/", "w/"] {
        assert(h.keys(p) == 0, p)
    }
    assert(h.store.is_empty())
}

@test
fn an_export_goes_on_only_within_its_own_account() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let _ = sign_up(mut e, mut h, 1, 5)
    let _ = sign_up(mut e, mut h, 2, 6)
    // From before every account, from another account's records, or of another phase: refused.
    for after in [Vec::from([u8(0)]), Vec::from([u8(0), 97, 47]), Vec::from([u8(7)])] {
        let rs = h.say(mut e, 2, Request::Export { after: after.clone() })
        assert(refused(rs), "a cursor outside the account")
    }
}

@test
fn a_session_ended_while_another_request_read_it_stays_ended() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    let cookie = h.cookie(1, server::SESSION)
    // Last seen over an hour ago, so a request writes when it was seen.
    h.time += 2 * account::HOUR
    let both = h.together(mut e, 1, [Request::SignOut { csrf: s.csrf.clone() }, Request::Me])
    let Reply::Welcome { me, .. } = both[0].reply.clone() else { panic("signed out") }
    assert(!me.signed_in)
    // The cookie, kept: it opens nothing.
    h.keep(1, server::SESSION, cookie)
    let Reply::Welcome { me, .. } = h.say(mut e, 1, Request::Me)[0].clone() else {
        panic("welcome")
    }
    assert(!me.signed_in, "the session stays ended")
    assert(h.keys("s/") == 0)
}

@test
fn a_recovery_code_used_twice_at_once_signs_in_once() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    let code = Request::Recover { code: s.codes[0].clone() }
    let both = h.together(mut e, 3, [code.clone(), code.clone()])
    var sessions = 0
    for a in both {
        if session_of([a.reply.clone()]).is_some() {
            sessions += 1
        }
    }
    assert(sessions == 1, f"{sessions} sessions")
}

@test
fn uploads_let_in_at_once_keep_the_queue_within_its_ticks() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (_, a) = uploader(mut e, mut h, 1, 5)
    let (_, b) = uploader(mut e, mut h, 2, 6)
    // Each within the bound alone, both past it.
    let half = server::QUEUE_TICKS / 2 + 1
    let up = |t: Vec<u8>, moves: u32| -> Request {
        Request::Upload {
            token: t.clone(),
            game: String::from("toy"),
            replay: toy(0, half, moves, 2),
        }
    }
    let both = h.together(mut e, 3, [up(a, 3), up(b, 4)])
    var busy = 0
    for r in both {
        if let Reply::Rejected { why } = r.reply {
            if why.as_str().find("busy").is_some() {
                busy += 1
            }
        }
    }
    assert(busy == 1, f"{busy} turned away")
}

/// Calls with nothing new until `key`'s prefix holds a key, at most `n` times.
fn until(e: mut Engine<Toy>, h: mut Host, prefix: Text, n: u32) {
    var k = 0
    while h.keys(prefix) == 0 && k < n {
        h.call(mut e, [])
        k += 1
    }
    assert(h.keys(prefix) > 0, prefix)
}

@test
fn a_deletion_a_dropped_instance_left_is_finished_by_the_next() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    let _ = h.say(mut e, 1, Request::Keep { csrf: s.csrf.clone() })
    // More records than a page of the deletion's scans: a token each.
    for _ in 0..270 {
        let _ = h.say(mut e, 1, Request::Token { game: String::from("toy") })
    }
    let asked = h.asked(1, Request::Delete { csrf: s.csrf.clone() }, public: false)
    h.call(mut e, [(900, take asked)])
    // Marked, then the instance is dropped: what it asked is never answered.
    until(mut e, mut h, "x/", 10)
    h.waiting.clear()
    h.closing.clear()
    var next = engine(Toy {}, RP, ORIGIN, VERSIONS)
    h.call(mut next, [])
    h.settle(mut next)
    for p in ["a/", "c/", "s/", "r/", "n/", "t/", "x/"] {
        assert(h.keys(p) == 0, p)
    }
}

@test
fn a_run_verified_while_its_account_is_deleted_leaves_nothing() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (s, token) = uploader(mut e, mut h, 1, 5)
    // Fresh first: the deletion comes while a long run is being played.
    h.good.push(Vec::from([4]))
    let Some(fresh) = session_of(sign_in(mut e, mut h, 1, 5, s.handle, 1, [4])) else {
        panic("signed in")
    }
    let run = Request::Upload {
        token: token.clone(),
        game: String::from("toy"),
        replay: toy(1, claimed: 40000, moves: 40000, m: 2),
    }
    h.call(mut e, [(901, h.asked(1, run, public: false))])
    until(mut e, mut h, "q/", 20)
    for _ in 0..10 {
        h.call(mut e, [])
    }
    let delete = h.asked(1, Request::Delete { csrf: fresh.csrf.clone() }, public: false)
    h.call(mut e, [(902, take delete)])
    h.settle(mut e)
    var done = false
    for a in h.answered {
        if let Reply::Done = a.reply {
            done = a.conn == 902
        }
    }
    assert(done, "deleted")
    for p in ["a/", "u/", "b/", "q/", "n/", "x/"] {
        assert(h.keys(p) == 0, p)
    }
}

@test
fn every_session_a_recovery_ends_stays_ended_however_many() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    // 70 sessions, each in its own browser.
    h.good.push(Vec::from([4]))
    for b in 2..71 {
        let _ = sign_in(mut e, mut h, b, 5, s.handle, 0, [4])
    }
    assert(h.keys("s/") == 70)
    // The session a recovery's scan finds first, of a browser seen over an hour ago.
    var first = 1
    for b in 2..71 {
        if account::hashed(h.cookie(b, server::SESSION)) <
            account::hashed(h.cookie(first, server::SESSION)) {
            first = b
        }
    }
    h.time += 2 * account::HOUR
    let recover = h.asked(200, Request::Recover { code: s.codes[0].clone() }, public: false)
    h.call(mut e, [(9001, take recover)])
    h.call(mut e, [])
    // Its `Me` is read as the recovery ends every session, and goes on after.
    let me = h.asked(first, Request::Me, public: false)
    h.call(mut e, [(9002, take me)])
    h.settle(mut e)
    let Reply::Welcome { me, .. } = h.say(mut e, first, Request::Me)[0].clone() else {
        panic("welcome")
    }
    assert(!me.signed_in, "the session stays ended")
    assert(h.keys("s/") == 1, "the recovery's own session alone")
}

// ---- agreement, posting and the public reads -----------------------------------------------------

/// The value of the first account's record of kind `of` (`a/<id>/<of>`), if there is one.
fn record(h: Host, of: u8) -> Option<Vec<u8>> {
    for e in h.store {
        if e.key.len() == 12 && e.key[0] == 97 && e.key[10] == 47 && e.key[11] == of {
            return Some(e.value.clone())
        }
    }
    None
}

@test
fn an_account_is_made_only_with_the_current_agreement_and_keeps_it() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let asks = [
        (NOT_AGREED, "nothing agreed"),
        (Agreed { terms: 3, privacy: 4, of_age: false }, "under 13"),
        (Agreed { terms: 2, privacy: 4, of_age: true }, "old terms"),
        (Agreed { terms: 3, privacy: 9, of_age: true }, "another privacy policy"),
    ]
    for (agreed, why) in asks {
        let rs = h.say(mut e, 1, Request::Begin { ceremony: REGISTER, csrf: Vec::new(), agreed })
        assert(refused(rs), why)
    }
    assert(h.keys("w/") == 0, "no ceremony begun")
    // Begun with the versions of the day, then the server's change: the sign-up can't finish.
    let c = challenge_of(h.say(mut e, 1, begin(REGISTER)))
    var newer = engine(Toy {}, RP, ORIGIN, Versions { terms: 4, privacy: 4, posting: 5 })
    let rs = h.say(
        mut newer,
        1,
        Request::Register {
            id: Vec::from([5]),
            client_data: client("webauthn.create", c, ORIGIN),
            attestation: made(RP, [5], 5),
        },
    )
    assert(refused(rs) && h.keys("a/") == 0, "the terms changed since it began")
    // With the current versions: made, and what it agreed to kept with it, and when.
    let made_at = h.time
    let s = sign_up(mut e, mut h, 1, 5)
    let Some(v) = record(h, account::OF_AGREED) else { panic("the agreement kept") }
    let g: Result<account::Agreement, LoadError> = load(take v)
    let Ok(g) = g else { panic("an agreement") }
    assert(g.terms == 3 && g.privacy == 4 && g.of_age && g.at > made_at, f"{g.at}")
    // A sign-in agrees to nothing again.
    h.good.push(Vec::from([4]))
    assert(session_of(sign_in(mut e, mut h, 2, 5, s.handle, 1, [4])).is_some())
    let Reply::Export { text, .. } = h.say(
        mut e,
        1,
        Request::Export { after: Vec::new() },
    )[0].clone() else {
        panic("an export")
    }
    assert(text.as_str().find("\"agreed\":{\"terms\":3,\"privacy\":4").is_some(), text.as_str())
}

@test
fn a_post_needs_consent_and_the_best_runs_setting_is_kept() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let s = sign_up(mut e, mut h, 1, 5)
    let _ = h.say(mut e, 1, Request::Keep { csrf: s.csrf.clone() })
    let Reply::Token { token, .. } = h.say(
        mut e,
        1,
        Request::Token { game: String::from("toy") },
    )[0].clone() else { panic("a token") }
    let up = |moves: u32| -> Request {
        Request::Upload {
            token: token.clone(),
            game: String::from("toy"),
            replay: toy(0, moves, moves, 2),
        }
    }
    let Reply::Posting { agreed, best_runs, .. } = h.say(
        mut e,
        1,
        Request::Posting,
    )[0].clone() else {
        panic("posting")
    }
    assert(!agreed && !best_runs, "off until chosen")
    let Reply::Rejected { why } = h.say(mut e, 1, up(10))[0].clone() else { panic("refused") }
    assert(why.as_str().find("Agree").is_some(), why.as_str())
    assert(h.keys("q/") == 0 && h.keys("u/") == 0, "nothing queued")
    // The setting, with the session's CSRF token.
    assert(refused(h.say(mut e, 1, Request::BestRuns { csrf: Vec::from([1; 16]), on: true })))
    assert(refused(h.say(mut e, 2, Request::BestRuns { csrf: s.csrf.clone(), on: true })))
    let Reply::Posting { agreed, best_runs, .. } = h.say(
        mut e,
        1,
        Request::BestRuns { csrf: s.csrf.clone(), on: true },
    )[0].clone() else { panic("set") }
    assert(!agreed && best_runs, "the setting alone is no consent")
    // Consent to another version than the server's is refused.
    let stale = Request::Consent { csrf: s.csrf.clone(), version: 4, best_runs: true }
    assert(refused(h.say(mut e, 1, stale)), "an old version")
    let at = h.time
    let rs = h.say(mut e, 1, Request::Consent { csrf: s.csrf.clone(), version: 5, best_runs: true })
    let Reply::Posting { agreed: true, best_runs: true, .. } = rs[0].clone() else {
        panic("agreed")
    }
    let Reply::Posting { agreed, at: when, best_runs } = h.say(
        mut e,
        1,
        Request::Posting,
    )[0].clone() else {
        panic("posting")
    }
    assert(agreed && best_runs && when >= at && when > 0, "kept, with when")
    let Reply::Verified { .. } = h.say(mut e, 1, up(11))[0].clone() else { panic("posted") }
    // Off again: the consent stays.
    let rs = h.say(mut e, 1, Request::BestRuns { csrf: s.csrf.clone(), on: false })
    let Reply::Posting { agreed: true, best_runs: false, .. } = rs[0].clone() else {
        panic("off")
    }
    // What posting shares changes: the consent is to agree again.
    var newer = engine(Toy {}, RP, ORIGIN, Versions { terms: 3, privacy: 4, posting: 6 })
    let Reply::Posting { agreed, .. } = h.say(mut newer, 1, Request::Posting)[0].clone() else {
        panic("posting")
    }
    assert(!agreed, "another version")
    let Reply::Rejected { .. } = h.say(mut newer, 1, up(12))[0].clone() else { panic("refused") }
}

@test
fn a_replay_is_read_by_its_hash_and_kept_for_a_year() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (s, token) = uploader(mut e, mut h, 1, 5)
    let good = toy(0, claimed: 30, moves: 30, m: 2)
    let rs = h.say(
        mut e,
        1,
        Request::Upload { token: token.clone(), game: String::from("toy"), replay: good.clone() },
    )
    let Reply::Verified { run, .. } = rs[0].clone() else { panic("verified") }
    let hash = Vec::from(sha256(good))
    // A board's page names each place's replay by its hash.
    let (b, _) = h.read(
        mut e,
        2,
        Request::Board { game: String::from("toy"), course: 0, category: ANY, from: 0 },
    )
    let Reply::Board { places, .. } = b else { panic("a board") }
    assert(places.len() == 1 && places[0].replay == hash, "the hash on the board")
    let a = h.read_whole(mut e, 2, Request::Replay { hash: hash.clone() })
    let Reply::Run { run: by_hash, replay, .. } = a.reply else { panic("the replay") }
    assert(by_hash == run && replay == good, "the run it names")
    assert(a.public == server::REPLAY_AGE && a.immutable, f"{a.public}")
    assert(wire::replay_path(hash).as_str().ends_with(account::hex(hash).as_str()))
    // A hash nothing has, or one that isn't a hash, is refused, and that isn't kept.
    for wrong in [Vec::filled(32, u8(0)), Vec::from([1, 2, 3])] {
        let a = h.read_whole(mut e, 2, Request::Replay { hash: wrong.clone() })
        assert(refused([a.reply.clone()]) && a.public == 0 && !a.immutable)
    }
    // Another account's upload of the same bytes is refused: a hash names one run.
    let (_, other) = uploader(mut e, mut h, 3, 6)
    let rs = h.say(
        mut e,
        3,
        Request::Upload { token: other.clone(), game: String::from("toy"), replay: good.clone() },
    )
    let Reply::Rejected { why } = rs[0].clone() else { panic("refused") }
    assert(why.as_str().find("already on the boards").is_some(), why.as_str())
    // Its account deleted: gone from the server (a cache may keep it a while, as the policy says).
    h.good.push(Vec::from([4]))
    let Some(fresh) = session_of(sign_in(mut e, mut h, 1, 5, s.handle, 1, [4])) else {
        panic("signed in")
    }
    let Reply::Done = h.say(
        mut e,
        1,
        Request::Delete { csrf: fresh.csrf.clone() },
    )[0].clone() else {
        panic("deleted")
    }
    let a = h.read_whole(mut e, 2, Request::Replay { hash: hash.clone() })
    assert(refused([a.reply.clone()]) && h.keys("h/") == 0, "gone with its account")
}

/// The upload of `replay` with `token` from browser `conn`: its answer.
fn upload(e: mut Engine<Toy>, h: mut Host, conn: u32, token: [u8], replay: [u8]) -> Reply {
    let up = Request::Upload {
        token: Vec::from(token),
        game: String::from("toy"),
        replay: Vec::from(replay),
    }
    h.say(mut e, conn, up)[0].clone()
}

@test
fn a_replay_uploaded_by_two_accounts_at_once_is_the_first_ones_alone() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (owner, a) = uploader(mut e, mut h, 1, 5)
    let (other, b) = uploader(mut e, mut h, 2, 6)
    // The same bytes from both, in one call: each reads the hash as nobody's before either's
    // claim commits.
    let same = toy(0, claimed: 40, moves: 40, m: 2)
    let up = |t: Vec<u8>| -> Request {
        Request::Upload { token: t.clone(), game: String::from("toy"), replay: same.clone() }
    }
    let both = h.together(mut e, 3, [up(a.clone()), up(b.clone())])
    let first_in = match both[0].reply {
        Reply::Verified { .. } => true,
        _ => false,
    }
    var verified = 0
    var refused_copy = 0
    for r in both {
        match r.reply {
            Reply::Verified { .. } => verified += 1,
            Reply::Rejected { why } => {
                assert(why.as_str().find("already on the boards").is_some(), why.as_str())
                refused_copy += 1
            },
            _ => {},
        }
    }
    assert(verified == 1 && refused_copy == 1, f"{verified} verified, {refused_copy} refused")
    assert(h.keys("h/") == 1 && h.keys("u/") == 1, "one run, one hash")
    let hash = Vec::from(sha256(same))
    // Whichever got in, deleting the other account leaves its replay.
    let Reply::Run { run, .. } = h.read(mut e, 9, Request::Replay { hash: hash.clone() }).0 else {
        panic("the replay")
    }
    let (browser, id) = if first_in { (2, 6) } else { (1, 5) }
    let handle = if first_in { other.handle.clone() } else { owner.handle.clone() }
    h.good.push(Vec::from([4]))
    let Some(fresh) = session_of(sign_in(mut e, mut h, browser, id, handle, 1, [4])) else {
        panic("signed in")
    }
    let Reply::Done = h.say(
        mut e,
        browser,
        Request::Delete { csrf: fresh.csrf.clone() },
    )[0].clone() else {
        panic("deleted")
    }
    let (r, _) = h.read(mut e, 9, Request::Replay { hash: hash.clone() })
    let Reply::Run { run: still, .. } = r else { panic("the owner's replay stays") }
    assert(still == run && h.keys("h/") == 1)
}

@test
fn a_run_posted_again_hears_what_came_of_it_the_first_time() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (_, token) = uploader(mut e, mut h, 1, 5)
    let good = toy(0, claimed: 30, moves: 30, m: 2)
    let Reply::Verified { run, ticks, place } = upload(mut e, mut h, 1, token, good) else {
        panic("verified")
    }
    // A faster run of another account's: posted again, the first is second now.
    let (_, other) = uploader(mut e, mut h, 2, 6)
    let Reply::Verified { .. } = upload(
        mut e,
        mut h,
        2,
        other,
        toy(0, claimed: 20, moves: 20, m: 2),
    ) else {
        panic("verified")
    }
    let Reply::Verified { run: r2, ticks: t2, place: p2 } = upload(
        mut e,
        mut h,
        1,
        token,
        good,
    ) else {
        panic("verified again")
    }
    assert(r2 == run && t2 == ticks && place == 1 && p2 == 2, f"{r2} {t2} {p2}")
    assert(h.keys("u/") == 2 && h.keys("q/") == 0, "no run made of it again")
    // A rejected run posted again is rejected again, for the same reason, and isn't played again.
    let tampered = toy(0, claimed: 10, moves: 30, m: 4)
    let Reply::Rejected { why } = upload(mut e, mut h, 1, token, tampered) else {
        panic("rejected")
    }
    let Reply::Rejected { why: again } = upload(mut e, mut h, 1, token, tampered) else {
        panic("rejected again")
    }
    assert(why == again && why.as_str().find("match its moves").is_some(), again.as_str())
    assert(h.keys("h/") == 3 && h.keys("u/") == 2, "one record a replay")
}

@test
fn a_run_posted_again_while_it_is_played_hears_when_it_is() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (_, token) = uploader(mut e, mut h, 1, 5)
    let long = Request::Upload {
        token: token.clone(),
        game: String::from("toy"),
        replay: toy(1, claimed: 40000, moves: 40000, m: 2),
    }
    h.call(mut e, [(901, h.asked(1, long.clone(), public: false))])
    until(mut e, mut h, "q/", 20)
    h.call(mut e, [(902, h.asked(1, long, public: false))])
    h.settle(mut e)
    var told: Vec<u32> = Vec::new()
    for a in h.answered {
        if let Reply::Verified { ticks: 40000, .. } = a.reply {
            told.push(a.conn)
        }
    }
    assert(told.len() == 2 && h.keys("u/") == 1, f"{told.len()} told")
}

@test
fn a_run_is_refused_until_its_accounts_name_is_kept() {
    let both = started()
    var e = take both.0
    var h = take both.1
    let (_, token) = named(mut e, mut h, 1, 5, seed: 0)
    // A token from before (a name is kept for good, so this is a record the store holds wrong).
    let (i, found) = find(h.store, account_key(5))
    assert(found, "account 5")
    let r: Result<account::Account, LoadError> = load(h.store[i].value.clone())
    var drawn = (take r).unwrap()
    drawn.fixed = false
    h.store[i].value = save(drawn.clone())
    let Reply::Rejected { why } = upload(
        mut e,
        mut h,
        1,
        token,
        toy(0, claimed: 30, moves: 30, m: 2),
    ) else {
        panic("refused")
    }
    assert(why.as_str().find("Keep your name").is_some(), why.as_str())
    assert(h.keys("q/") == 0 && h.keys("h/") == 0 && h.keys("p/") == 0, "nothing of it kept")
    // A name not kept draws again; once kept, it can't, so a searched name never goes stale.
    let s = sign_up(mut e, mut h, 2, 6)
    let _ = h.say(mut e, 2, Request::Keep { csrf: s.csrf.clone() })
    assert(refused(h.say(mut e, 2, Request::Reroll { csrf: s.csrf.clone() })), "kept for good")
}

/// A knighted account that agreed to posting, with the name that `seed` draws, its number `id`,
/// in browser `conn` with passkey `id`: its token.
fn named(e: mut Engine<Toy>, h: mut Host, conn: u32, id: u8, seed: u64) -> (Signed, Vec<u8>) {
    var bytes: Vec<u8> = Vec::filled(CHALLENGE_BYTES + CEREMONY_BYTES + HANDLE_BYTES, id)
    for b in [0, 0, 0, 0, 0, 0, 0, id] {
        bytes.push(b)
    }
    for k in 0..8 {
        bytes.push(u8((seed >> (56 - 8 * k)) & 255))
    }
    h.given.push(take bytes)
    uploader(mut e, mut h, conn, id)
}

/// Uploads a toy run of course 0 with `moves` moves with `token`: verified.
fn post(e: mut Engine<Toy>, h: mut Host, conn: u32, token: [u8], moves: u32) {
    let rs = h.say(
        mut e,
        conn,
        Request::Upload {
            token: Vec::from(token),
            game: String::from("toy"),
            replay: toy(0, moves, moves, 2),
        },
    )
    let Reply::Verified { .. } = rs[0].clone() else { panic("verified") }
}

@test
fn a_slice_holds_the_places_around_a_name() {
    let both = started()
    var e = take both.0
    var h = take both.1
    // Eight accounts on course 0, the k-th fastest with 10 + k moves.
    var names: Vec<String> = Vec::new()
    for k in 0..8 {
        let (s, token) = uploader(mut e, mut h, k + 1, u8(k + 5))
        post(mut e, mut h, k + 1, token, 10 + k)
        names.push(s.name.clone())
    }
    let around = |name: String, course: u32| -> Request {
        Request::Around { game: String::from("toy"), course, category: ANY, name: name.clone() }
    }
    let (r, age) = h.read(mut e, 20, around(names[6].clone(), 0))
    assert(age == server::BOARD_AGE, "kept as a board's page is")
    let Reply::Around { places, at } = r else { panic("a slice") }
    assert(at == 7 && places.len() == AROUND + 2, f"{at}: {places.len()} places")
    for i in 0..places.len() {
        let k = i + 1
        assert(places[i].place == k + 1 && places[i].name == names[k], places[i].name.as_str())
        assert(places[i].ticks == 10 + k && places[i].replay.len() == 32)
    }
    // The fastest: nothing above it.
    let (r, _) = h.read(mut e, 20, around(names[0].clone(), 0))
    let Reply::Around { places, at } = r else { panic("a slice") }
    assert(at == 1 && places.len() == AROUND + 1 && places[0].name == names[0])
    // A name nobody has, text that isn't a name, and a board the name has no run on.
    let nobody = names::text(names::draw(77777))
    for (name, course) in [
        (take nobody, 0),
        (String::from("Sir Nobody"), 0),
        (names[0].clone(), 1),
    ] {
        let (r, _) = h.read(mut e, 20, around(name.clone(), course))
        assert(refused([take r]), name.as_str())
    }
}

/// The seed that draws the name of parts `title`, `front`, `back` and `epithet`.
fn seed_of(title: u32, front: u32, back: u32, epithet: u32) -> u64 {
    let (t, f, b) = (u64(names::TITLES.len()), u64(names::FRONTS.len()), u64(names::BACKS.len()))
    u64(title) + t * (u64(front) + f * (u64(back) + b * u64(epithet)))
}

@test
fn a_search_finds_names_by_their_parts_at_most_twenty_and_never_a_deleted_one() {
    let both = started()
    var e = take both.0
    var h = take both.1
    // 24 Wobblesnouts with runs, each its own title and epithet, and one without a run.
    var signed: Vec<Signed> = Vec::new()
    for k in 0..24 {
        let (s, token) = named(
            mut e,
            mut h,
            k + 1,
            u8(k + 5),
            seed_of(title: k, front: 0, back: 0, epithet: k),
        )
        post(mut e, mut h, k + 1, token, 10 + k)
        signed.push(s.clone())
    }
    let (quiet, _) = named(mut e, mut h, 30, 40, seed_of(title: 1, front: 0, back: 0, epithet: 40))
    let search = |title: Text, noun: Text, epithet: Text| -> Request {
        Request::Names {
            game: String::from("toy"),
            title: String::from(title),
            noun: String::from(noun),
            epithet: String::from(epithet),
        }
    }
    let (r, age) = h.read(mut e, 99, search("", "wob", ""))
    assert(age == server::BOARD_AGE)
    let Reply::Names { found } = r else { panic("names") }
    assert(found.len() == MOST_FOUND, f"{found.len()} found")
    for f in found {
        assert(f.name.as_str().find("Wobblesnout").is_some() && f.standings.len() >= 1)
        assert(f.standings[0].course == 0 && f.standings[0].replay.len() == 32)
    }
    // By each part: a title and an epithet pick one; a name without a run is never found.
    let (r, _) = h.read(mut e, 99, search("dame", "WOBBLES", ""))
    let Reply::Names { found } = r else { panic("names") }
    assert(found.len() == 1 && found[0].name == signed[1].name, f"{found.len()} found")
    assert(found[0].name != quiet.name, "no run, not found")
    let epithet = names::EPITHETS[3]
    let (r, _) = h.read(mut e, 99, search("", "wobble", epithet))
    let Reply::Names { found } = r else { panic("names") }
    assert(found.len() == 1 && found[0].name == signed[3].name)
    let (r, _) = h.read(mut e, 99, search("", "Wobblepaw", ""))
    let Reply::Names { found } = r else { panic("names") }
    assert(found.is_empty(), "another noun")
    // Too wide, nothing at all, or what no name holds: refused.
    for (t, n, p) in [
        ("", "", "Unh"),
        ("", "", ""),
        ("", "w0b", ""),
        ("", "", "                                 x"),
    ] {
        let (r, _) = h.read(mut e, 99, search(t, n, p))
        assert(refused([take r]), f"{t}|{n}|{p}")
    }
    // Being deleted (its records still going): not found.
    let (i, found) = find(h.store, account_key(10))
    assert(found, "account 10")
    let r: Result<account::Account, LoadError> = load(h.store[i].value.clone())
    var going = (take r).unwrap()
    going.deleting = true
    h.store[i].value = save(going.clone())
    let (r, _) = h.read(mut e, 99, search("", "wobble", names::EPITHETS[5]))
    let Reply::Names { found } = r else { panic("names") }
    assert(found.is_empty() && names::text(going.name) == signed[5].name, "being deleted")
    // Deleted: gone from a search at once.
    h.good.push(Vec::from([4]))
    let Some(fresh) = session_of(sign_in(mut e, mut h, 4, 8, signed[3].handle, 1, [4])) else {
        panic("signed in")
    }
    let Reply::Done = h.say(
        mut e,
        4,
        Request::Delete { csrf: fresh.csrf.clone() },
    )[0].clone() else {
        panic("deleted")
    }
    let (r, _) = h.read(mut e, 99, search("", "wobble", epithet))
    let Reply::Names { found } = r else { panic("names") }
    assert(found.is_empty(), "a deleted account")
}

@test
fn a_search_reads_a_range_of_names_a_page_at_a_time() {
    let both = started()
    var e = take both.0
    var h = take both.1
    // 70 Sir Wobblesnouts with runs, by epithet in the index's order, and one without: the epithet
    // asked for is the last's, past the range's first page.
    for k in 0..70 {
        var bytes: Vec<u8> = Vec::filled(CHALLENGE_BYTES + CEREMONY_BYTES + HANDLE_BYTES, u8(k + 5))
        for b in [0, 0, 0, 0, 0, 0, 1, u8(k + 5)] {
            bytes.push(b)
        }
        let seed = seed_of(title: 0, front: 0, back: 0, epithet: k)
        for i in 0..8 {
            bytes.push(u8((seed >> (56 - 8 * i)) & 255))
        }
        h.given.push(take bytes)
        let (_, token) = uploader(mut e, mut h, k + 1, u8(k + 5))
        post(mut e, mut h, k + 1, token, 10 + k)
    }
    let _ = sign_up(mut e, mut h, 80, 90)
    assert(h.keys("n/") == 71 && h.keys("p/") == 70, "only names with runs are searched")
    let (r, _) = h.read(
        mut e,
        99,
        Request::Names {
            game: String::from("toy"),
            title: String::from("Sir"),
            noun: String::from("Wobblesnout"),
            epithet: String::from(names::EPITHETS[69]),
        },
    )
    let Reply::Names { found } = r else { panic("names") }
    assert(
        found.len() == 1 && found[0].name.as_str().ends_with(names::EPITHETS[69]),
        f"{found.len()}",
    )
}
