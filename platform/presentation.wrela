// The link between a game and the console that embeds it: the game says when it shows its first
// useful frame, and goes back to the console when the player asks, once its save is stored.
//
// A game keeps one `Link` and, each frame:
// - gives it the frame's input (`input`), and sets `returning` for a return of its own;
// - calls `presented` once it shows a useful frame, never a loading or black one;
// - while `returning` is set, calls `save_and_return` with its save's path and bytes.
//
// The player asks to return with F10, the pad's Home button, or Select and Start held on one
// pad. The console can also ask, as the browser's Back does.
use std::input::{Event, Key, Mods, Pad, PadButton, PADS}
use std::io::{Pending, store}
use host::{asked_to_return, ready, return_to_parent}

pub struct Link {
    signalled: bool,
    pads: [Pad; PADS],
    ready_request: Option<Pending<u8>>,
    // The parent's asking it to return, heard from the first useful frame.
    asked: Option<Pending<u8>>,
    pub returning: bool,
    saving: Option<Pending<u8>>,
    leaving: Option<Pending<u8>>,
}

impl Link {
    pub fn new() -> Link {
        Link {
            signalled: false,
            pads: [Pad {}; PADS],
            ready_request: None,
            asked: None,
            returning: false,
            saving: None,
            leaving: None,
        }
    }

    /// Reads `input`'s events for the return shortcuts. Call it after the game reads its own input.
    pub fn input(mut self, input: std::input::Input) {
        for e in input.events { self.event(e) }
    }

    pub fn event(mut self, event: Event) {
        for i in 0..PADS {
            self.pads[i].update(i, event)
            if self.pads[i].held(PadButton::Select) && self.pads[i].held(PadButton::Start) {
                self.returning = true
            }
        }
        match event {
            Event::KeyDown { key: Key::F10, repeat: false, .. } => self.returning = true,
            Event::PadButton {
                button: PadButton::Home,
                pressed: true,
                ..
            } => self.returning = true,
            _ => {},
        }
    }

    /// Tells the console the game is ready, the first time, and polls whether the console asks the
    /// game to return. Call it each frame from the first useful frame on, never from a loading or
    /// black frame.
    pub fn presented(mut self) {
        if !self.signalled {
            self.ready_request = Some(ready())
            self.asked = Some(asked_to_return())
            self.signalled = true
        }
        // A host with no parent, or none that asks, never answers: the shortcuts still work.
        match mut self.asked {
            Some(p) => {
                if let Some(result) = p.poll() {
                    if result.is_ok() { self.returning = true }
                    self.asked = None
                }
            },
            None => {},
        }
        match mut self.ready_request {
            Some(p) => { if p.poll().is_some() { self.ready_request = None } },
            None => {},
        }
    }

    /// Stores `bytes` at `path`, then asks the console to take the game back. The game returns only
    /// once the store succeeds; if it fails, `returning` goes back to false.
    pub fn save_and_return(mut self, path: str, bytes: [u8]) {
        if self.returning && self.saving.is_none() && self.leaving.is_none() {
            self.saving = Some(store(path, bytes))
        }
        var written = None
        match mut self.saving {
            Some(p) => written = p.poll(),
            None => {},
        }
        if let Some(result) = written {
            self.saving = None
            match result {
                Ok(_) => self.leaving = Some(return_to_parent()),
                Err(_) => self.returning = false,
            }
        }
        match mut self.leaving {
            Some(p) => {
                if p.poll().is_some() {
                    self.leaving = None
                    self.returning = false
                }
            },
            None => {},
        }
    }
}

@test
fn returning_requires_a_deliberate_non_repeated_shortcut() {
    var link = Link::new()
    link.event(Event::KeyDown { key: Key::F10, repeat: true, mods: Mods {} })
    assert(!link.returning)
    link.event(Event::KeyDown { key: Key::Escape, repeat: false, mods: Mods {} })
    assert(!link.returning)
    link.event(Event::KeyDown { key: Key::F10, repeat: false, mods: Mods {} })
    assert(link.returning)
}

@test
fn controller_return_chord_requires_both_buttons_on_one_pad() {
    var link = Link::new()
    link.event(Event::PadButton { pad: 0, button: PadButton::Select, pressed: true, value: 1.0 })
    link.event(Event::PadButton { pad: 1, button: PadButton::Start, pressed: true, value: 1.0 })
    assert(!link.returning)
    link.event(Event::PadButton { pad: 0, button: PadButton::Start, pressed: true, value: 1.0 })
    assert(link.returning)
}
