// The console's server: accounts, sessions and verified leaderboards, for every wrela game
// (games/capybara/design.md, "Accounts and leaderboards"). The console's program runs it as its
// server build on Cloudflare (toolchain 0.18.0's host, language.md §19.5), answering HTTP requests
// to wrela.dev's `/api/` (wire.wrela). A game reaches it only through the console (link.wrela),
// since a server takes only its own program's clients (docs/toolchain-gaps.md, "A server takes one
// program's clients").
//
// **One build, many instances** (std::server). Each named instance has a store of its own, and
// holds one thing (docs/plan-online-play.md, step 14):
//
// | Instance | Holds | Written by |
// | --- | --- | --- |
// | `account/<handle>` | the account, passkeys, sessions, recovery codes' hashes, game tokens, runs and replays, bests and whole-game sums, upload counts, the agreement, the posting consent and the best-runs setting (accounts.wrela) | itself |
// | `names/<00..3f>` | name → owner and generation | itself (shards.wrela) |
// | `search/<noun's first letter>` | each posted name, by noun and by title, with its runs | its accounts (upserts) |
// | `codes/<00..3f>` | recovery code's hash → handle | its accounts (upserts) |
// | `replays/<00..3f>` | replay's hash → the account that posted it | itself |
// | `board/<game>/<board>/<course>/<any or full>` | every account's best (ranking.wrela) | its accounts (upserts) |
// | `whole/<game>/<board>/<any or full>` | every account's whole-game sum | its accounts (upserts) |
//
// **The edge** (edge.wrela) hears every request first, with no store: it sends each to the instance
// that answers it (a session's to its account, a board's to its board), or answers it itself:
// a ceremony's start, a recovery (through its code's shard, then the account), an upload (admitted
// by the account, played here, recorded by the account, ranked by the board), and a search by a
// title (every letter's shard). It also plays a replay for an archived build's verifier
// (`std::server::call_build`).
//
// It is a state machine over its host, so tests can run it on a fake host: what it asks of the host
// comes out as `Command`s (the store's reads and writes, random bytes, a signature or a tag to make
// or check, calls, messages, replies, the responses), and the host's answers go back in by their
// ticket (`answer`). The console's `serve` (console/server) carries the commands out through
// std::store, std::crypto, std::server and std::http, one call at a time; a read is answered on the
// call after the one that asked, and the host commits a call's writes when it returns, before its
// responses, replies, calls and sends go.
//
// **Every request is answered**, and every call: one whose work ends without an answer is refused at
// the end of the call (`end`). A message is acknowledged in the call whose writes complete its
// effect, so one an instance dropped comes again.
//
// **Between instances** an account tells (`send`, at least once) its boards, whole boards, search
// shard and code shards what it has there, as an upsert of a key only it writes, with its own
// revision: a receiver keeps the highest revision a key has had, tombstones too, so a late or
// repeated message changes nothing. Names are another's: a names shard is the authority on its
// names, and gives each claim a generation, which a keep or a release must name. A deletion's
// removals each come back said done (`Note::Removed`), and only then is the account's store cleared.
//
// **Guards in memory.** One instance answers one call at a time, but a request's work spans calls
// (each read is answered on the next), so each instance remembers what it wrote and deleted lately
// (`gone`, `written`): a read made before such a call committed isn't trusted for that key.

use account::{HANDLE_BYTES, account_instance, part, u64_at, under, unhex, with_bytes}
use names::Name
use std::collections::replace
use std::crypto::Signature
use std::hash::sha256::{hex, sha256}
use std::serialize::{LoadError, Serialize, load, save}
use std::store::{append_u32, append_u64, value}
use wire::{ANY, FULL, Found, Me, Reply, Request, RunRef, Standing, WHOLE, public}

// ---- what a game gives the server ----------------------------------------------------------------

/// What a replay says it is, read without playing it: its course and its time in ticks.
pub struct Claim: Copy {
    pub course: u32,
    pub ticks: u32,
}

/// What playing a replay made of it: its time, and whether it counts for 100%.
pub struct Outcome: Copy {
    pub ticks: u32,
    pub full: bool,
}

/// A game's boards: its name, its board's version (its build of play: a change to play starts a
/// new one, games/capybara/design.md, "Physics is locked at release"), its courses, how to check a
/// replay, and where an older version's verifier is kept.
pub trait Game {
    /// A replay being played.
    type Run

    /// The game's key (`capybara`), as its catalog names it.
    fn id(self) -> Text

    /// The board version this build verifies for.
    fn board(self) -> u32

    /// How many courses have boards: courses 0 to this, less one.
    fn courses(self) -> u32

    /// What `replay` claims, if it reads as one of the game's replays and is within its bounds
    /// (its course, its length): `Err` says why not, for a person.
    fn claim(self, replay: [u8]) -> Result<Claim, Text>

    /// A replay that `claim` took, ready to play.
    fn start(self, replay: [u8]) -> Self::Run

    /// Plays at most `ticks` more ticks of `run`: none until it has played all of it, then what it
    /// came to, or why its claim isn't what the rules make of it.
    fn play(self, run: mut Self::Run, ticks: u32) -> Option<Result<Outcome, Text>>

    /// The archived verifier of board version `board`, an older one than this build's, if its
    /// release kept one: its path in the host's store of builds (`std::server::call_build`,
    /// `verifiers/<game>/<board>/<sha256>`). None: that board is closed.
    fn archived(self, board: u32) -> Option<String>
}

/// The versions of what a player agrees to, as the console's build has them (console/legal.wrela):
/// the Terms and the Privacy Policy, at sign-up, and what posting makes public, before the first
/// post. The server takes only these.
pub struct Versions: Copy {
    pub terms: u32,
    pub privacy: u32,
    pub posting: u32,
}

// ---- bounds --------------------------------------------------------------------------------------

/// Runs an account may upload an hour.
pub const RUNS_AN_HOUR: u32 = 10
/// Ticks of a run the edge plays at a time, between asking whether the run ended; it plays a whole
/// run in one call (an edge instance has no store to keep it in, and runs in the Worker, so no
/// other request waits behind it).
pub const PLAY_TICKS: u32 = 4096
/// Recovery codes anyone may try in a minute against one code shard. Each client's own limit is
/// the host's, by address (`WRELA_LIMITS`, studio/release), which the server is never told.
pub const ALL_TRIES: u32 = 30
/// How long a public read may be kept by a cache, in seconds: a board's page, a slice and a search
/// (they change as runs come). A run's replay never changes once posted, so it's kept a year,
/// as immutable; a deleted account's runs are gone from the server, though a cache may still hold
/// one this long, as the privacy policy says (console/legal.wrela).
pub const BOARD_AGE: u32 = 30
pub const RUN_AGE: u32 = 31536000
/// A search's bounds: the entries a read of a shard's range takes, the entries it reads in all.
pub const RANGE_PAGE: u32 = 64
pub const MOST_SCANNED: u32 = 1024
/// An account's records, and its runs, read for an export at a time.
pub const EXPORT_RECORDS: u32 = 512
pub const EXPORT_RUNS: u32 = 16
/// Records cleared or scanned at a time: spent challenges as a new one is used, a deletion's.
pub const PRUNED: u32 = 16
pub const CLEARED: u32 = 256
/// The most places a run's place is counted to.
pub const MOST_PLACE: u32 = 1000
/// The bytes of a ceremony's challenge: its nonce, when it expires, and its tag (the first bytes
/// of an HMAC-SHA256 of what it's for, RFC 2104 §5), so a challenge is the 32 bytes a WebAuthn
/// challenge usually is, and the server keeps none of it until it's used.
pub const NONCE_BYTES: u32 = 8
pub const TAG_BYTES: u32 = 16
pub const CHALLENGE_BYTES: u32 = NONCE_BYTES + 8 + TAG_BYTES
/// The shortest key a ceremony's tag is made with (a Worker secret's, edge.wrela): 32 bytes.
pub const KEY_BYTES: u32 = 32
/// The shards of names, recovery codes and replays: `00` to `3f`.
pub const SHARDS: u32 = 64

/// Why a new account is refused while sign-ups are closed (`Engine::close_sign_ups`).
pub const CLOSED: Text = "Sign-ups are closed for now. Every game still plays without an account."

// ---- what the server asks of its host ------------------------------------------------------------

pub enum Command: Clone {
    Get { ticket: u32, key: Vec<u8> },
    Scan { ticket: u32, from: Vec<u8>, to: Vec<u8>, limit: u32, down: bool },
    Put { key: Vec<u8>, value: Vec<u8> },
    Delete { key: Vec<u8> },
    Random { ticket: u32, n: u32 },
    Verify {
        ticket: u32,
        algorithm: Signature,
        key: Vec<u8>,
        message: Vec<u8>,
        signature: Vec<u8>,
    },
    /// HMAC-SHA256 of `message` under `key` (std::crypto::hmac): the answer is 32 bytes.
    Hmac { ticket: u32, key: Vec<u8>, message: Vec<u8> },
    /// The one answer to request `conn`: a `Reply`'s bytes, the cookies it sets, how long a cache
    /// may keep it (0: none may), and whether it never changes.
    Respond { conn: u32, body: Vec<u8>, cookies: Vec<Cookie>, public: u32, immutable: bool },
    /// Request `conn`, at the edge, sent on to instance `to`, which answers it.
    Dispatch { conn: u32, to: String },
    /// Calls instance `to` with an `Envelope`'s bytes: its answer is the reply's (a `Back`), or
    /// none if the call failed.
    Call { ticket: u32, to: String, body: Vec<u8> },
    /// The one answer to call `conn`: a `Back`'s bytes.
    Reply { conn: u32, body: Vec<u8> },
    /// Sends instance `to` a message (a `Letter`'s bytes): at least once.
    Send { to: String, body: Vec<u8> },
    /// Acknowledges message `conn`: its effect is complete, in this call's writes.
    Ack { conn: u32 },
    /// Calls the archived build at `artifact` (`call_build`) with a `Verify`'s bytes: its answer
    /// is a `Verdict`'s, or none.
    CallBuild { ticket: u32, artifact: String, body: Vec<u8> },
}

/// A first-party session cookie (`std::http::session_cookie`): `__Host-<name>`, holding `value`,
/// for `max_age` seconds (0 clears it).
pub struct Cookie: Clone {
    pub name: String,
    pub value: Vec<u8>,
    pub max_age: u32,
}

/// The session's and a ceremony's cookies.
pub const SESSION: Text = "session"
pub const CEREMONY: Text = "ceremony"

/// A request, as the host gave it: when it was taken (the host's wall clock, milliseconds since the
/// Unix epoch), whether it may be cached (a `GET`), its cookies' values, the keys a ceremony's
/// challenge is made and checked with (the Worker's secrets, edge.wrela: the one in use first, then
/// the one before it), and its body (a `Request`).
pub struct Asked: Clone {
    pub time: u64,
    pub public: bool,
    pub session: Vec<u8>,
    pub ceremony: Vec<u8>,
    pub keys: Vec<Vec<u8>>,
    pub body: Vec<u8>,
}

// ---- what instances say to each other -------------------------------------------------------------

/// A best on a board, as the board ranks it: the time (a whole game's sum), the name it shows, the
/// run (none for a whole game's) and its replay's hash (empty for a whole game's).
pub struct Ranked: Clone + Serialize {
    pub ticks: u32,
    pub name: String,
    /// The name's key (`names::key`), by which a slice finds its place.
    pub key: Vec<u8>,
    pub run: RunRef,
    pub replay: Vec<u8>,
}

/// A posted name, as its search shard keeps it: the name, and its runs on the boards.
pub struct Listing: Clone + Serialize {
    pub name: Name,
    pub standings: Vec<Standing>,
}

/// What a played replay came to, from the edge or an archived build's verifier (`call_build`'s
/// `wrela-verify-1`: `Verify` in, `Verdict` out): whether it's what it claims, its time and
/// whether it counts for 100%, or why not.
pub struct Verdict: Clone + Serialize {
    pub ok: bool,
    pub ticks: u32,
    pub full: bool,
    pub why: String,
}

/// What a call asks of an instance.
pub enum Inner: Clone + Serialize {
    /// To a names shard: name `name` for account `owner`, if it's free (`Claimed`, with its new
    /// generation) or not (`Taken`).
    Claim { name: Name, owner: Vec<u8> },
    /// To a code shard: whose code `hash` is (`Owner`), within the shard's tries a minute.
    Lookup { hash: Vec<u8> },
    /// To an account: a sign-in by its code `hash`, from a browser whose session cookie was
    /// `cookie` (another account's, ended, or none): `Session`, or `Refused`.
    Recover { hash: Vec<u8>, cookie: Vec<u8> },
    /// To an account: may run `hash` (on `game`'s board version `board`, course `course`, claiming
    /// `ticks`) go up, by game token `token`'s secret? `Admitted`; or what came of it before
    /// (`Recorded`, `Rejected`); or `Refused`.
    Admit { token: Vec<u8>, game: String, board: u32, hash: Vec<u8>, course: u32, ticks: u32 },
    /// To a replays shard: replay `hash` is account `owner`'s now, unless it's another's
    /// (`Mine` or `Other`).
    Own { hash: Vec<u8>, owner: Vec<u8> },
    /// To an account: what playing the run it admitted came to (`verdict`), with its replay, to
    /// keep and rank: `Recorded`, `Rejected`, or `Refused`.
    Record { token: Vec<u8>, board: u32, course: u32, verdict: Verdict, replay: Vec<u8> },
    /// To a board: the account's best there (`best`, a `Note::Best`'s, applied as its message
    /// is), then the place of a run of `ticks` by `handle` (`Place`).
    Rank { best: Note, ticks: u32, handle: Vec<u8> },
    /// To a search shard: its names that a search's parts match, in the index's order (`Found`).
    Search { title: String, noun: String, epithet: String },
}

/// A call's reply.
pub enum Back: Clone + Serialize {
    Claimed { generation: u64 },
    Taken,
    Owner { handle: Vec<u8> },
    /// A session begun by a recovery code: the cookie's bytes, and what the console is told.
    Session { cookie: Vec<u8>, csrf: Vec<u8>, me: Me },
    Admitted,
    /// A run kept and its best told (`best`: the course's any% best as its board is told, for the
    /// edge to rank with): the run, its time.
    Recorded { run: RunRef, ticks: u32, best: Note },
    Mine,
    Other,
    Place { place: u32 },
    /// A search's names, each with its place in the index's order (`by_title`'s).
    Found { found: Vec<Listed> },
    /// For good (a run that never goes up): why.
    Rejected { why: String },
    /// Not now: why.
    Refused { why: String },
}

/// A name a search shard found, and where it is in the index's order.
pub struct Listed: Clone + Serialize {
    pub order: Vec<u8>,
    pub found: Found,
}

/// What a message tells an instance.
pub enum Note: Clone + Serialize {
    /// To a board or a whole board: account `handle`'s best there at revision `revision` (none, a
    /// tombstone: it has none).
    Best { handle: Vec<u8>, revision: u64, best: Vec<Ranked> },
    /// To a search shard: account `handle`'s name and runs at revision `revision` (none: it isn't
    /// on the boards).
    Listed { handle: Vec<u8>, revision: u64, listing: Vec<Listing> },
    /// To a code shard: recovery code `hash` is account `owner`'s at revision `revision` (`owner`
    /// empty: it's used up or gone).
    Code { hash: Vec<u8>, revision: u64, owner: Vec<u8> },
    /// To a names shard: name `name` is kept for good by `owner` (generation `generation`), or let
    /// go.
    Keep { name: Name, owner: Vec<u8>, generation: u64 },
    Release { name: Name, owner: Vec<u8>, generation: u64 },
    /// To a replays shard: replay `hash` is no longer `owner`'s.
    Disown { hash: Vec<u8>, owner: Vec<u8> },
    /// To an account: the session whose token's hash is `hash` ended (its browser signed in again).
    EndSession { hash: Vec<u8> },
    /// To an account: the removal it sent as `id` is done.
    Removed { id: Vec<u8> },
    /// To an account, from itself: finish its deletion (sent as it's marked, so a deletion an
    /// instance dropped part way is finished by the next).
    Finish,
    /// Nothing.
    Nothing,
}

/// A call's bytes: when its request was taken (the host's wall clock; an instance's clock is the
/// latest it has heard) and what it asks.
pub struct Envelope: Clone + Serialize {
    pub time: u64,
    pub inner: Inner,
}

/// A message's bytes: when, what it tells, and, for a deletion's removal, the id its receiver says
/// done with a `Note::Removed` (empty: none is asked).
pub struct Letter: Clone + Serialize {
    pub time: u64,
    pub note: Note,
    pub confirm: Vec<u8>,
}

// ---- instances ------------------------------------------------------------------------------------

/// What an instance is, by its name.
pub enum Kind: Copy + Eq {
    Edge,
    Account,
    Names,
    Codes,
    Replays,
    Search,
    Board,
    Whole,
    /// A name of none of these: it answers nothing.
    Other,
}

/// The kind of the instance named `name` (empty: the edge).
pub fn kind_of(name: str) -> Kind {
    if name.is_empty() {
        return Kind::Edge
    }
    let Some(slash) = name.find("/") else { return Kind::Other }
    let kind = name.slice(0, slash)
    let rest = name.slice(slash + 1, name.len())
    if kind == "account" {
        let handle = unhex(rest)
        if handle.is_some() && rest.len() == 2 * HANDLE_BYTES {
            return Kind::Account
        }
        return Kind::Other
    }
    if kind == "names" || kind == "codes" || kind == "replays" {
        let Some(b) = unhex(rest) else { return Kind::Other }
        if b.len() != 1 || u32(b[0]) >= SHARDS {
            return Kind::Other
        }
        return if kind == "names" { Kind::Names } else if kind == "codes" {
            Kind::Codes
        } else { Kind::Replays }
    }
    if kind == "search" {
        return if rest.len() == 1 && rest.byte(0) >= 97 && rest.byte(0) <= 122 {
            Kind::Search
        } else { Kind::Other }
    }
    if kind == "board" {
        return Kind::Board
    }
    if kind == "whole" {
        return Kind::Whole
    }
    Kind::Other
}

/// The shard of a hash or a key: `00` to `3f`, from its first byte.
pub fn shard(bytes: [u8]) -> String {
    let b = if bytes.is_empty() { u8(0) } else { u8(u32(bytes[0]) % SHARDS) }
    hex([b])
}

/// The names shard of name `n`: by its key's SHA-256, so names spread over the shards.
pub fn names_instance(n: Name) -> String {
    String::from(f"names/{shard(sha256(names::key(n)))}")
}

pub fn codes_instance(hash: [u8]) -> String {
    String::from(f"codes/{shard(hash)}")
}

pub fn replays_instance(hash: [u8]) -> String {
    String::from(f"replays/{shard(hash)}")
}

/// The letter a noun starts with, in lower case.
pub fn letter_of(front: u32) -> u8 {
    names::lower_byte(names::FRONTS[front].byte(0))
}

/// The search shard of the names whose noun starts with `letter` (lower case).
pub fn search_instance(letter: u8) -> String {
    var out = String::from("search/")
    out.push_byte(letter)
    out
}

/// Every letter a noun starts with, each once, in order: the search shards.
pub fn letters() -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    for f in 0..names::FRONTS.len() {
        let l = letter_of(f)
        var have = false
        for x in out {
            if x == l {
                have = true
            }
        }
        if !have {
            out.push(l)
        }
    }
    out.sort_by(|a, b| a < b)
    out
}

/// A category's word in a board's name.
fn category_word(category: u32) -> Text {
    if category == FULL { "full" } else { "any" }
}

/// The board of `game`'s version `board`, course `course` (WHOLE: the whole game's) and category
/// `category`.
pub fn board_instance(game: str, board: u32, course: u32, category: u32) -> String {
    let c = category_word(category)
    if course == WHOLE {
        String::from(f"whole/{game}/{board}/{c}")
    } else {
        String::from(f"board/{game}/{board}/{course}/{c}")
    }
}

// ---- the server's state ---------------------------------------------------------------------------

/// How a connection came: an HTTP request, a call, or a message.
pub enum Via: Copy + Eq {
    Http,
    Call,
    Message,
}

/// A connection under way, and what it carries.
pub struct Conn: Clone {
    pub conn: u32,
    pub via: Via,
    /// Whether it was answered, and whether its answer may be cached.
    pub answered: bool,
    pub public: bool,
    /// A request's session: its token's hash (empty when signed out), CSRF token, freshness and
    /// whether a code made it, once read; its cookie's bytes as sent; its ceremony cookie's value;
    /// the keys a ceremony's tag is made with; and the cookies its response sets.
    pub session: Vec<u8>,
    pub csrf: Vec<u8>,
    pub fresh_until: u64,
    pub recovery: bool,
    pub cookie: Vec<u8>,
    pub ceremony: Vec<u8>,
    pub keys: Vec<Vec<u8>>,
    pub cookies: Vec<Cookie>,
}

/// A request, a call or a message under way, waiting on its ticket: what it has learned so far.
pub struct Job: Clone {
    pub conn: u32,
    /// The call it began in: a key deleted or written since may have been read by it before that
    /// committed.
    pub since: u64,
    pub ticket: u32,
    pub step: Step,
    pub request: Request,
    /// The call it answers, or the message it acts on.
    pub inner: Option<Inner>,
    pub note: Note,
    pub confirm: Vec<u8>,
    pub from: String,
    pub account: Option<account::Account>,
    pub session: Option<account::Session>,
    pub passkey: Option<account::Passkey>,
    pub credential: Option<std::webauthn::Credential>,
    pub message: Vec<u8>,
    pub hash: Vec<u8>,
    pub handle: Vec<u8>,
    pub keys: Vec<Vec<u8>>,
    pub views: Vec<Vec<u8>>,
    pub text: String,
    pub seed: u64,
    pub tries: u32,
    pub n: u32,
    pub course: u32,
    pub ticks: u32,
    pub expires: u64,
    pub run: RunRef,
    pub best: Note,
    pub verdict: Option<Verdict>,
    pub found: Vec<Listed>,
    pub matching: Option<names::Matching>,
    pub agreed: wire::Agreed,
}

/// What a job waits for.
pub enum Step: Copy + Eq {
    // A ceremony's challenge, at the edge or an account (edge.wrela).
    ChallengeRandom,
    ChallengeTag,
    // The edge (edge.wrela).
    EdgeLookup,
    EdgeRecover,
    EdgeAdmit,
    EdgeVerify,
    EdgeOwn,
    EdgeRecord,
    EdgeRank,
    EdgeSearch,
    // An account (accounts.wrela).
    HelloSession,
    HelloAccount,
    BeginAddScan,
    TagChecked,
    SpentRead,
    RegisterGone,
    RegisterAccount,
    RegisterSeed,
    RegisterClaim,
    RegisterSecrets,
    SignInPasskey,
    SignInAccount,
    SignInVerify,
    SignInSecrets,
    SignInPrune,
    RecoverCode,
    RecoverAccount,
    RecoverCounters,
    RecoverSessions,
    RecoverSecrets,
    NameSeed,
    NameClaim,
    AddCredential,
    AddCount,
    AddSession,
    RemoveScan,
    PasskeysScan,
    CodesScan,
    CodesCounters,
    CodesRandom,
    SessionsScan,
    RevokeScan,
    TokenPrune,
    TokenRandom,
    ExportScan,
    ExportRuns,
    DeleteCounters,
    DeleteScan,
    RemovedScan,
    FinishSwept,
    FinishAccount,
    ClearScan,
    ClearNext,
    PostingRead,
    PostingBest,
    BestRunsRead,
    WatchAccount,
    WatchRun,
    AdmitToken,
    AdmitAccount,
    AdmitConsent,
    AdmitOutcome,
    AdmitBest,
    AdmitRate,
    RecordAccount,
    RecordOutcome,
    RecordCounters,
    RecordBests,
    // A shard (shards.wrela).
    ClaimRead,
    NameNoteRead,
    LookupRead,
    CodeNoteRead,
    OwnRead,
    DisownRead,
    ListedRead,
    SearchRange,
    // A board (ranking.wrela).
    BestRead,
    RankRead,
    RankCount,
    BoardScan,
    AroundName,
    AroundEntry,
    AroundCount,
    AroundAbove,
    AroundBelow,
}

/// The server: one instance of it, the edge or a named one.
pub struct Engine<G: Game> {
    pub(package) game: G,
    pub(package) rp_id: String,
    pub(package) origin: String,
    pub(package) versions: Versions,
    /// Whether new accounts may be made. Signing in, recovery and play without an account don't
    /// depend on it.
    pub(package) sign_ups: bool,
    /// This instance's name and kind; an account's handle; a board's course and category.
    pub(package) name: String,
    pub(package) kind: Kind,
    pub(package) handle: Vec<u8>,
    pub(package) out: Vec<Command>,
    pub(package) ticket: u32,
    /// The server's clock: the latest request's time, in milliseconds since the Unix epoch.
    pub(package) now: u64,
    pub(package) conns: Vec<Conn>,
    pub(package) jobs: Vec<Job>,
    /// The calls counted.
    pub(package) call: u64,
    /// Keys deleted lately, and keys written lately with what was written: a read made before their
    /// call committed isn't to be trusted for them.
    pub(package) gone: Vec<(Vec<u8>, u64)>,
    pub(package) written: Vec<(Vec<u8>, Vec<u8>, u64)>,
    /// A code shard's tries in the last minute.
    pub(package) tries: Vec<u64>,
    /// An account's: the highest revision and run number it has given out while this instance ran
    /// (each read from its store too, so they go on after it's dropped); whether a registration or
    /// a deletion is under way here; and the uploads admitted lately (the hour, the call), which a
    /// read of the hour's count made before they committed doesn't count.
    pub(package) revision: u64,
    pub(package) runs: u32,
    pub(package) registering: bool,
    pub(package) deleting: bool,
    pub(package) admitted: Vec<(u64, u64)>,
    /// The edge's searches over every letter's shard: the request, the names found, the shards
    /// still to answer.
    pub(package) searching: Vec<(u32, Vec<Listed>, u32)>,
}

/// A server for `game`'s boards, its passkeys for relying party `rp_id` from `origin` alone, taking
/// the agreements of `versions`: the instance named `name` (empty: the edge, `std::server::me()`).
pub fn engine<G: Game>(
    game: take G,
    rp_id: str,
    origin: str,
    versions: Versions,
    name: str,
) -> Engine<G> {
    let kind = kind_of(name)
    let handle = if kind == Kind::Account {
        unhex(name.slice("account/".len(), name.len())).unwrap_or(Vec::new())
    } else { Vec::new() }
    Engine {
        game,
        rp_id: rp_id.to_string(),
        origin: origin.to_string(),
        versions,
        sign_ups: true,
        name: name.to_string(),
        kind,
        handle,
        out: Vec::new(),
        ticket: 0,
        now: 0,
        conns: Vec::new(),
        jobs: Vec::new(),
        call: 0,
        gone: Vec::new(),
        written: Vec::new(),
        tries: Vec::new(),
        revision: 0,
        runs: 0,
        registering: false,
        deleting: false,
        admitted: Vec::new(),
        searching: Vec::new(),
    }
}

pub(package) fn blank_job(conn: u32, request: take Request) -> Job {
    Job {
        conn,
        since: 0,
        ticket: 0,
        step: Step::HelloSession,
        request,
        inner: None,
        note: Note::Nothing,
        confirm: Vec::new(),
        from: String::new(),
        account: None,
        session: None,
        passkey: None,
        credential: None,
        message: Vec::new(),
        hash: Vec::new(),
        handle: Vec::new(),
        keys: Vec::new(),
        views: Vec::new(),
        text: String::new(),
        seed: 0,
        tries: 0,
        n: 0,
        course: 0,
        ticks: 0,
        expires: 0,
        run: RunRef::none(),
        best: Note::Nothing,
        verdict: None,
        found: Vec::new(),
        matching: None,
        agreed: wire::NOT_AGREED,
    }
}

pub(package) fn nobody() -> Me {
    Me { signed_in: false, name: String::new(), fixed: false, rerolls: 0, must_add_passkey: false }
}

pub(package) fn read<T: Serialize>(bytes: [u8]) -> Option<T> {
    let r: Result<T, LoadError> = load(Vec::from(bytes))
    take r.ok()
}

/// The value a `get` answered with, as a `T`: none for no value, or one that doesn't read.
pub(package) fn got<T: Serialize>(answer: [u8]) -> Option<T> {
    let v = value(answer)?
    read(v)
}

/// Whether `a` and `b` are the same bytes, in time that says nothing of where they differ.
pub(package) fn same_bytes(a: [u8], b: [u8]) -> bool {
    std::crypto::same(a, b)
}

/// Whether `bytes` starts with `prefix`.
pub(package) fn starts_with(bytes: [u8], prefix: [u8]) -> bool {
    if bytes.len() < prefix.len() {
        return false
    }
    for i in 0..prefix.len() {
        if bytes[i] != prefix[i] {
            return false
        }
    }
    true
}

/// Whether `key` is among the keys used lately.
pub(package) fn lately(keys: [(Vec<u8>, u64)], key: [u8]) -> bool {
    for (k, _) in keys {
        if same_bytes(k, key) {
            return true
        }
    }
    false
}

/// Drops the times in `xs` older than `window` before `now`.
pub(package) fn recent(xs: mut Vec<u64>, now: u64, window: u64) {
    var i = 0
    while i < xs.len() {
        if xs[i] + window <= now {
            let _ = xs.remove(i)
        } else {
            i += 1
        }
    }
}

impl<G: Game> Engine<G> {
    // ---- the host's side --------------------------------------------------------------------

    /// Refuses new accounts from now on: a `Begin` or a `Register` for one is refused.
    pub fn close_sign_ups(mut self) {
        self.sign_ups = false
    }

    /// Starts a call.
    pub fn begin(mut self) {
        self.call += 1
    }

    /// Ends a call: a refusal for each request whose work ended unanswered, so none waits for the
    /// host's timeout, and a failure for each such call.
    pub fn end(mut self) {
        self.forget_old()
        var left: Vec<(u32, Via)> = Vec::new()
        for c in self.conns {
            if !c.answered && c.via != Via::Message && !self.busy(c.conn) {
                left.push((c.conn, c.via))
            }
        }
        for (conn, via) in left {
            if via == Via::Http {
                self.refuse(conn, "Something went wrong on our end. Try again in a moment.")
            } else {
                self.back(conn, Back::Refused { why: String::from("Something went wrong.") })
            }
        }
    }

    /// Connection `conn` closed (answered, or its client went).
    pub fn closed(mut self, conn: u32) {
        self.conns.retain(|c| c.conn != conn)
    }

    /// Request `conn`'s request.
    pub fn http(mut self, conn: u32, asked: Asked) {
        self.closed(conn)
        self.now = max(self.now, asked.time)
        var c = self.blank_conn(conn, Via::Http)
        c.public = asked.public
        c.cookie = asked.session.clone()
        c.ceremony = asked.ceremony.clone()
        c.keys = asked.keys.clone()
        self.conns.push(take c)
        let parsed: Option<Request> = read(asked.body)
        let Some(request) = take parsed else {
            self.refuse(conn, "wrela.dev can't read that request. Reload the page and try again.")
            return
        }
        if asked.public && !public(request) {
            self.refuse(conn, "That request changes things, so it can't be a GET.")
            return
        }
        match self.kind {
            Kind::Edge => self.edge_http(conn, take request),
            Kind::Account => self.account_http(conn, take request),
            Kind::Board | Kind::Whole => self.board_http(conn, take request),
            Kind::Search => self.search_http(conn, take request),
            _ => self.refuse(conn, "That isn't something wrela.dev answers."),
        }
    }

    /// Call `conn`: an `Envelope` (at the edge, a verifier's `Verify`).
    pub fn called(mut self, conn: u32, body: [u8]) {
        self.closed(conn)
        self.conns.push(self.blank_conn(conn, Via::Call))
        if self.kind == Kind::Edge {
            self.edge_verify(conn, body)
            return
        }
        let parsed: Option<Envelope> = read(body)
        let Some(e) = take parsed else {
            self.back(conn, Back::Refused { why: String::from("That call doesn't read.") })
            return
        }
        self.now = max(self.now, e.time)
        borrow inner = e.inner
        match self.kind {
            Kind::Account => self.account_called(conn, inner),
            Kind::Names | Kind::Codes | Kind::Replays | Kind::Search => {
                self.shard_called(conn, inner)
            },
            Kind::Board | Kind::Whole => self.board_called(conn, inner),
            _ => self.back(conn, Back::Refused { why: String::from("Nothing here.") }),
        }
    }

    /// Message `conn` from instance `from`: a `Letter`.
    pub fn delivered(mut self, conn: u32, from: str, body: [u8]) {
        self.closed(conn)
        self.conns.push(self.blank_conn(conn, Via::Message))
        let parsed: Option<Letter> = read(body)
        let Some(l) = take parsed else {
            // What can't be read never will be: taken, so it doesn't come again.
            self.out.push(Command::Ack { conn })
            return
        }
        self.now = max(self.now, l.time)
        var j = blank_job(conn, Request::Me)
        j.note = l.note.clone()
        j.confirm = l.confirm.clone()
        j.from = String::from(from)
        match self.kind {
            Kind::Account => self.account_delivered(take j),
            Kind::Names | Kind::Codes | Kind::Replays | Kind::Search => self.shard_delivered(
                take j,
            ),
            Kind::Board | Kind::Whole => self.board_delivered(take j),
            _ => self.out.push(Command::Ack { conn }),
        }
    }

    /// The host's answer to ticket `ticket`: its bytes, or none if the request (or the call) failed.
    pub fn answer(mut self, ticket: u32, answer: Option<Vec<u8>>) {
        var found: Option<u32> = None
        for i in 0..self.jobs.len() {
            if self.jobs[i].ticket == ticket {
                found = Some(i)
            }
        }
        let Some(i) = found else { return }
        let job = self.jobs.remove(i)
        match answer {
            Some(bytes) => match self.kind {
                Kind::Edge => self.edge_answer(take job, bytes),
                Kind::Account => self.account_answer(take job, bytes),
                Kind::Board | Kind::Whole => self.board_answer(take job, bytes),
                _ => self.shard_answer(take job, bytes),
            },
            None => self.failed(take job),
        }
    }

    /// What the server asks of its host, since the last time.
    pub fn commands(mut self) -> Vec<Command> {
        replace(mut self.out, Vec::new())
    }

    // ---- helpers ------------------------------------------------------------------------------

    fn blank_conn(self, conn: u32, via: Via) -> Conn {
        Conn {
            conn,
            via,
            answered: false,
            public: false,
            session: Vec::new(),
            csrf: Vec::new(),
            fresh_until: 0,
            recovery: false,
            cookie: Vec::new(),
            ceremony: Vec::new(),
            keys: Vec::new(),
            cookies: Vec::new(),
        }
    }

    /// A job's ask failed (the host's, or a call's): its request is refused, its call answered
    /// not now, and its message comes again.
    fn failed(mut self, job: take Job) {
        let j = take job
        if self.kind == Kind::Edge && self.edge_failed(j) {
            return
        }
        if self.kind == Kind::Account {
            if accounts::signs_up(j.step) {
                self.registering = false
            }
            if j.step == Step::DeleteCounters || j.step == Step::DeleteScan {
                self.deleting = false
            }
        }
        self.searching.retain(|s| s.0 != j.conn)
        let Some(i) = self.conn_index(j.conn) else { return }
        match self.conns[i].via {
            Via::Http => self.refuse(
                j.conn,
                "Something went wrong on our end. Try again in a moment.",
            ),
            Via::Call => self.back(
                j.conn,
                Back::Refused {
                    why: String::from("Something went wrong on our end. Try again in a moment."),
                },
            ),
            Via::Message => {},
        }
    }

    pub(package) fn next_ticket(mut self) -> u32 {
        self.ticket += 1
        self.ticket
    }

    pub(package) fn conn_index(self, conn: u32) -> Option<u32> {
        for i in 0..self.conns.len() {
            if self.conns[i].conn == conn {
                return Some(i)
            }
        }
        None
    }

    /// Whether connection `conn` still has work under way.
    fn busy(self, conn: u32) -> bool {
        for j in self.jobs {
            if j.conn == conn {
                return true
            }
        }
        for s in self.searching {
            if s.0 == conn {
                return true
            }
        }
        false
    }

    /// Answers request `conn` with `reply`, once: a public read's answer may be cached.
    pub(package) fn reply(mut self, conn: u32, reply: take Reply) {
        let age = match reply {
            Reply::Board { .. } | Reply::Around { .. } | Reply::Unplaced | Reply::Names { .. } => {
                BOARD_AGE
            },
            _ => 0,
        }
        self.respond(conn, take reply, age, immutable: false)
    }

    /// Answers request `conn` with `reply`, once, which a cache may keep `age` seconds if it was a
    /// public read (a `GET`), as never changing if `immutable`.
    pub(package) fn respond(mut self, conn: u32, reply: take Reply, age: u32, immutable: bool) {
        let Some(i) = self.conn_index(conn) else { return }
        if self.conns[i].answered || self.conns[i].via != Via::Http {
            return
        }
        self.conns[i].answered = true
        let public = if self.conns[i].public { age } else { 0 }
        let cookies = self.conns[i].cookies.clone()
        self.out.push(
            Command::Respond {
                conn,
                body: save(reply),
                cookies,
                public,
                immutable: immutable && public > 0,
            },
        )
    }

    pub(package) fn refuse(mut self, conn: u32, why: Text) {
        self.reply(conn, Reply::Refused { why: String::from(why) })
    }

    /// Answers call `conn` with `back`, once.
    pub(package) fn back(mut self, conn: u32, back: take Back) {
        let Some(i) = self.conn_index(conn) else { return }
        if self.conns[i].answered || self.conns[i].via != Via::Call {
            return
        }
        self.conns[i].answered = true
        self.out.push(Command::Reply { conn, body: save(back) })
    }

    /// Acknowledges message `conn`: its effect is in this call's writes.
    pub(package) fn ack(mut self, conn: u32) {
        let Some(i) = self.conn_index(conn) else { return }
        if self.conns[i].answered || self.conns[i].via != Via::Message {
            return
        }
        self.conns[i].answered = true
        self.out.push(Command::Ack { conn })
    }

    /// Acknowledges `job`'s message, and says its removal done to its sender if it asked.
    pub(package) fn done(mut self, job: Job) {
        if !job.confirm.is_empty() && !job.from.is_empty() {
            self.tell(job.from.as_str(), Note::Removed { id: job.confirm.clone() }, [])
        }
        self.ack(job.conn)
    }

    /// Sets cookie `name` on request `conn`'s response (`value` empty and `max_age` 0 clear it).
    pub(package) fn cookie(mut self, conn: u32, name: Text, value: take Vec<u8>, max_age: u32) {
        let Some(i) = self.conn_index(conn) else { return }
        self.conns[i].cookies.push(Cookie { name: String::from(name), value, max_age })
    }

    /// Waits on `job`'s ticket, from the call it began in.
    pub(package) fn push_job(mut self, job: take Job) {
        var j = take job
        if j.since == 0 {
            j.since = self.call
        }
        self.jobs.push(take j)
    }

    fn wait(mut self, ticket: u32, step: Step, job: take Job) {
        var j = take job
        j.ticket = ticket
        j.step = step
        self.push_job(take j)
    }

    pub(package) fn get(mut self, key: take Vec<u8>, step: Step, job: take Job) {
        let t = self.next_ticket()
        self.out.push(Command::Get { ticket: t, key })
        self.wait(t, step, take job)
    }

    /// The entries from `from` to before `to` (none: to the end), `limit` at most.
    pub(package) fn scan_range(
        mut self,
        from: take Vec<u8>,
        to: take Vec<u8>,
        limit: u32,
        step: Step,
        job: take Job,
    ) {
        let t = self.next_ticket()
        self.out.push(Command::Scan { ticket: t, from, to, limit, down: false })
        self.wait(t, step, take job)
    }

    /// The last `limit` entries from `from` to before `to`, the last first.
    pub(package) fn scan_down(
        mut self,
        from: take Vec<u8>,
        to: take Vec<u8>,
        limit: u32,
        step: Step,
        job: take Job,
    ) {
        let t = self.next_ticket()
        self.out.push(Command::Scan { ticket: t, from, to, limit, down: true })
        self.wait(t, step, take job)
    }

    /// The entries under `prefix`, `limit` at most.
    pub(package) fn scan(mut self, prefix: take Vec<u8>, limit: u32, step: Step, job: take Job) {
        let to = std::store::past(prefix).unwrap_or(Vec::new())
        self.scan_range(take prefix, take to, limit, step, take job)
    }

    pub(package) fn random(mut self, n: u32, step: Step, job: take Job) {
        let t = self.next_ticket()
        self.out.push(Command::Random { ticket: t, n })
        self.wait(t, step, take job)
    }

    pub(package) fn hmac(mut self, key: [u8], message: [u8], step: Step, job: take Job) {
        let t = self.next_ticket()
        self.out.push(Command::Hmac { ticket: t, key: Vec::from(key), message: Vec::from(message) })
        self.wait(t, step, take job)
    }

    pub(package) fn verify(
        mut self,
        algorithm: Signature,
        key: [u8],
        message: [u8],
        signature: [u8],
        step: Step,
        job: take Job,
    ) {
        let t = self.next_ticket()
        self.out.push(
            Command::Verify {
                ticket: t,
                algorithm,
                key: Vec::from(key),
                message: Vec::from(message),
                signature: Vec::from(signature),
            },
        )
        self.wait(t, step, take job)
    }

    /// Calls instance `to` with `inner`, as of now: its answer is a `Back`'s bytes.
    pub(package) fn ask(mut self, to: str, inner: Inner, step: Step, job: take Job) {
        let t = self.next_ticket()
        let body = save(Envelope { time: self.now, inner: inner.clone() })
        self.out.push(Command::Call { ticket: t, to: String::from(to), body })
        self.wait(t, step, take job)
    }

    /// Sends instance `to` `note`, asking it to say done as `confirm` (empty: not asked).
    pub(package) fn tell(mut self, to: str, note: Note, confirm: [u8]) {
        let body = save(Letter { time: self.now, note: note.clone(), confirm: Vec::from(confirm) })
        self.out.push(Command::Send { to: String::from(to), body })
    }

    pub(package) fn put<T: Serialize>(mut self, key: take Vec<u8>, record: T) {
        self.out.push(Command::Put { key, value: save(record) })
    }

    pub(package) fn put_bytes(mut self, key: take Vec<u8>, value: take Vec<u8>) {
        self.out.push(Command::Put { key, value })
    }

    pub(package) fn delete(mut self, key: take Vec<u8>) {
        self.out.push(Command::Delete { key })
    }

    /// Deletes `key`, a single-use or revocable record, and remembers it gone: a read of it made
    /// before this call's writes commit is not to be trusted.
    pub(package) fn forget(mut self, key: take Vec<u8>) {
        self.gone.push((key.clone(), self.call))
        self.delete(take key)
    }

    /// Writes `value` at `key` and remembers it written: a read of it made before this call's
    /// writes commit sees what this wrote (`latest`).
    pub(package) fn keep(mut self, key: take Vec<u8>, value: take Vec<u8>) {
        self.written.retain(|w| !same_bytes(w.0, key))
        self.gone.retain(|g| !same_bytes(g.0, key))
        self.written.push((key.clone(), value.clone(), self.call))
        self.put_bytes(take key, take value)
    }

    /// What is at `key` as a read answered `answer` sees it, made since call `since`: what this
    /// instance wrote or deleted there lately, if it did, or the read's.
    pub(package) fn latest(self, key: [u8], answer: [u8]) -> Option<Vec<u8>> {
        for (k, v, _) in self.written {
            if same_bytes(k, key) {
                return Some(v.clone())
            }
        }
        if lately(self.gone, key) {
            return None
        }
        value(answer)
    }

    /// What is at `key` as `latest` sees it, as a `T`: none for no value, or one that doesn't
    /// read.
    pub(package) fn latest_as<T: Serialize>(self, key: [u8], answer: [u8]) -> Option<T> {
        let v = self.latest(key, answer)?
        read(v)
    }

    /// Lets go of what was deleted or written lately once no read made before it can still be
    /// used: kept while a job that began by then is under way, and for the call after (a read made
    /// in a call is answered in the next).
    fn forget_old(mut self) {
        var oldest = self.call
        for j in self.jobs {
            oldest = min(oldest, j.since)
        }
        let call = self.call
        self.gone.retain(|g| g.1 >= oldest || g.1 + 1 >= call)
        self.written.retain(|w| w.2 >= oldest || w.2 + 1 >= call)
        self.admitted.retain(|a| a.1 >= oldest || a.1 + 1 >= call)
    }
}

/// Whether `part` can be the start of a part of a name: at most `MOST_PART` bytes of letters,
/// spaces and hyphens.
pub fn searchable(part: str) -> bool {
    if part.len() > wire::MOST_PART {
        return false
    }
    for i in 0..part.len() {
        if !names::name_char(part.byte(i)) {
            return false
        }
    }
    true
}

/// A ceremony's challenge's message, which its tag covers: what it's for, the token of the browser
/// that began it, the account it's for (none for a sign-in, whose account the passkey names), its
/// nonce, when it expires, and for a new account what its player agreed to.
pub fn ceremony_message(
    kind: u32,
    token: [u8],
    handle: [u8],
    nonce: [u8],
    expires: u64,
    agreed: wire::Agreed,
) -> Vec<u8> {
    var m = under("wrela-ceremony-1")
    m.push(u8(kind))
    append_u32(mut m, agreed.terms)
    append_u32(mut m, agreed.privacy)
    m.push(if agreed.of_age { u8(1) } else { u8(0) })
    with_bytes(mut m, token)
    m.push(u8(handle.len()))
    with_bytes(mut m, handle)
    with_bytes(mut m, nonce)
    append_u64(mut m, expires)
    m
}

/// A challenge from its nonce, when it expires and the tag's first `TAG_BYTES`.
pub fn challenge_of(nonce: [u8], expires: u64, tag: [u8]) -> Vec<u8> {
    var c = Vec::from(nonce)
    append_u64(mut c, expires)
    with_bytes(mut c, part(tag, 0, TAG_BYTES))
    c
}

/// A challenge's nonce, when it expires, and its tag: none unless it's `CHALLENGE_BYTES`.
pub fn challenge_parts(c: [u8]) -> Option<(Vec<u8>, u64, Vec<u8>)> {
    if c.len() != CHALLENGE_BYTES {
        return None
    }
    Some((part(c, 0, NONCE_BYTES), u64_at(c, NONCE_BYTES), part(c, NONCE_BYTES + 8, TAG_BYTES)))
}

/// What a board's places are of: its game, version, course and category, as an account keeps its
/// best there (`b/<this>`).
pub fn board_part(game: str, board: u32, course: u32, category: u32) -> Vec<u8> {
    var k = Vec::from(String::from(game).as_bytes())
    k.push(0)
    append_u32(mut k, board)
    append_u32(mut k, course)
    append_u32(mut k, category)
    k
}

@test
fn instances_are_named_by_what_they_hold() {
    assert(kind_of("") == Kind::Edge)
    assert(kind_of(account_instance([7; HANDLE_BYTES]).as_str()) == Kind::Account)
    assert(kind_of("account/77") == Kind::Other && kind_of("account/zz") == Kind::Other)
    assert(kind_of("names/3f") == Kind::Names && kind_of("names/40") == Kind::Other)
    assert(kind_of("codes/00") == Kind::Codes && kind_of("replays/1a") == Kind::Replays)
    assert(kind_of("search/w") == Kind::Search && kind_of("search/W") == Kind::Other)
    assert(
        kind_of(board_instance("toy", board: 7, course: 1, category: FULL).as_str()) == Kind::Board,
    )
    assert(kind_of(board_instance("toy", 7, WHOLE, ANY).as_str()) == Kind::Whole)
    assert(
        board_instance("capybara", board: 3, course: 2, category: ANY).as_str() ==
            "board/capybara/3/2/any",
    )
    assert(board_instance("capybara", 3, WHOLE, FULL).as_str() == "whole/capybara/3/full")
    for name in [
        names_instance(names::draw(1)),
        codes_instance([255]),
        replays_instance([]),
        search_instance(letter_of(0)),
        board_instance("capybara", board: 3, course: 2, category: ANY),
    ] {
        assert(std::server::instance_name(name.as_str()), name.as_str())
    }
    assert(shard([255]) == String::from("3f") && shard([64]) == String::from("00"))
    let ls = letters()
    assert(ls.len() >= 2 && ls.len() <= 26)
    for i in 1..ls.len() {
        assert(ls[i - 1] < ls[i], "each letter once, in order")
    }
}

@test
fn a_challenge_reads_back_and_its_message_names_what_it_is_for() {
    let c = challenge_of([1; NONCE_BYTES], 1793404800000, [9; 32])
    assert(c.len() == CHALLENGE_BYTES)
    let Some((nonce, expires, tag)) = challenge_parts(c) else { panic("a challenge") }
    assert(nonce == Vec::from([1; NONCE_BYTES]) && expires == 1793404800000 && tag.len() == 16)
    assert(challenge_parts([1, 2, 3]).is_none())
    let agreed = wire::Agreed { terms: 3, privacy: 4, of_age: true }
    let a = ceremony_message(0, [3; 16], [4; 16], nonce, expires, agreed)
    let b = ceremony_message(1, [3; 16], [4; 16], nonce, expires, agreed)
    let d = ceremony_message(0, [3; 16], [5; 16], nonce, expires, agreed)
    let e = ceremony_message(0, [3; 16], [], nonce, expires, agreed)
    let f = ceremony_message(0, [3; 16], [4; 16], nonce, expires, wire::NOT_AGREED)
    let g = ceremony_message(0, [3; 16], [4; 16], nonce, expires + 1, agreed)
    assert(a != b && a != d && a != e && b != e && a != f && a != g, "each part counts")
}
