// The idol's body: the reference's distance sampled every 4.5 cm (engine::sampled), written by
// /mnt/project-files/idol-3d/fit/grid/export_sampled.py from the reference mesh, which never
// ships. 33 x 37 x 21 blocks of 4 cells, 6529 stored; a sample is a byte, the distance in
// [-BAND, BAND].
// Log line: docs/generated.jsonl, prediction g3bf8n2gdsrnc0d1p7jrdq76h8 (the .glb).

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-2.91786, 0.00000, -1.55669)
pub const CELL: f32 = 0.04500
pub const SIZE: vec3u = vec3u(33, 37, 21)
pub const BAND: f32 = 0.09000

/// Its tables (its vertices to bone `bone`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

