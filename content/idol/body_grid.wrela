// The idol's body: the reference's distance, sampled every 3.0 cm (engine::sampled), written by
// /mnt/project-files/idol-3d/fit/v14/export_sampled.py from the reference mesh, which never ships.
// 37 x 54 x 23 blocks of 4 cells, 7557 stored; a sample is a byte, the distance in [-BAND, BAND].
// Log line: docs/generated.jsonl, Rodin Gen-2 prediction xe9s0rk069rmy0d1pgjt4smfj8.

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-2.20180, 0.00000, -0.82064)
pub const CELL: f32 = 0.03000
pub const SIZE: vec3u = vec3u(37, 54, 23)
pub const BAND: f32 = 0.06000

/// Its tables (its vertices to bone `bone`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

