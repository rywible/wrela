/// The sum's weights and bias (its output in centimetres).
const W3: [f32; 48] = [
    0.625, 0.522, 0.686, 0.659, 0.682, 0.661, 0.514, 0.548, 0.649, 0.55, 0.608, 0.651, -0.568,
    0.631, 0.604, -0.601, -0.631, -0.726, 0.639, 0.568, 0.589, -0.589, 0.555, -0.604, 0.661, -0.645,
    -0.631, -0.543, 0.693, 0.542, 0.516, 0.744, -0.685, 0.604, 0.692, -0.794, -0.644, 0.697, 0.562,
    -0.562, -0.512, -0.515, -0.657, -0.611, 0.508, -0.639, -0.902, -0.671,
]
const B3: f32 = 0.24381

fn ramp(v: f32, lo: f32, hi: f32) -> f32 {
    let t = clamp((v - lo) / (hi - lo), 0.0, 1.0)
    t * t * (3.0 - 2.0 * t)
}

/// Where the detail holds (1): over the face only (the brow down to the jaw, the front), fading
/// before the crown, the sides and the neck, which stay plain stone.
fn held(p: vec3) -> f32 {
    ramp(p.y, lo: 0.02, hi: 0.12) *
        (1.0 - ramp(p.y, lo: 0.8, hi: 0.9)) *
        ramp(p.z, lo: 0.12, hi: 0.3) *
        (1.0 - ramp(abs(p.x), lo: 0.3, hi: 0.4))
}

/// How far the reference's surface is beyond the blocks' at `p` (m).
pub fn detail(p: vec3) -> f32 {
    let w = held(p)
    if w <= 0.0 {
        return 0.0
    }
    let q = (p - CENTRE) * 6.2831853
    var x = [0.0; 64]
    for j in 0..32 {
        let a = dot(q, WAVES[j])
        x[j] = sin(a)
        x[j + 32] = cos(a)
    }
    var h1 = [0.0; 48]
    for i in 0..48 {
        var s = B1[i]
        for j in 0..64 {
            s += W1[i * 64 + j] * x[j]
        }
        h1[i] = sin(s)
    }
    var out = B3
    for i in 0..48 {
        var s = B2[i]
        for j in 0..48 {
            s += W2[i * 48 + j] * h1[j]
        }
        out += W3[i] * sin(s)
    }
    clamp(out * 0.01, -MOST, MOST) * w
}
