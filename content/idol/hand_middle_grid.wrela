// The idol's middle hand: the reference's distance less 1.2 cm, sampled every 2.5 cm
// (engine::sampled), written by /mnt/project-files/idol-3d/fit/v14/export_sampled.py from the
// reference mesh, which never ships. 21 x 17 x 10 blocks of 4 cells, 816 stored; a sample is a
// byte, the distance in [-BAND, BAND].
// Log line: docs/generated.jsonl, Rodin Gen-2 prediction xe9s0rk069rmy0d1pgjt4smfj8.

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-1.05000, 3.90000, 0.91000)
pub const CELL: f32 = 0.02500
pub const SIZE: vec3u = vec3u(21, 17, 10)
pub const BAND: f32 = 0.05000

/// Its tables (its vertices to bone `bone`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

