// The idol's middle hand: the reference's distance less 2.5 cm, sampled every 2.5 cm
// (engine::sampled), written by /mnt/project-files/idol-3d/fit/v10/export_sampled.py from the
// reference mesh, which never ships. 25 x 24 x 12 blocks of 4 cells, 1366 stored; a sample is a
// byte, the distance in [-BAND, BAND].
// Log line: docs/generated.jsonl, Rodin Gen-2 prediction ayj7bgx9txrmr0d1pdas97f1t8.

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-1.25000, 3.45000, 1.41000)
pub const CELL: f32 = 0.02500
pub const SIZE: vec3u = vec3u(25, 24, 12)
pub const BAND: f32 = 0.05000

/// Its tables (its vertices to bone `bone`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

