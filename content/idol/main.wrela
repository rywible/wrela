// The idol in plain light: its seven sampled parts (the body, its three heads, its three hands,
// each a distance grid read from GPU memory by engine::sampled) realized once, at rest; a frame each, in turn, its turnaround (five times round, front to
// back) and five nearer shots (`SHOTS`).

use idol::{Block, Stone, stone_paint}
use engine::creature::Creature
use engine::sampled::realize_sampled
use std::derive::Box3
use engine::character::{ByChannels, colours}
use engine::creature::MAX_BONES
use engine::plain::{LIGHTS, coloured, skin_coloured, unlit_shadow, view}
use engine::realize::{Mesh, Tally, realize_once, solid}
use std::gpu::{
    ComparisonSampler, Cull, DepthTexture, GpuBuffer, Unorm8x4, begin_screen_pass_with_depth,
    buffer, comparison_sampler, depth_texture, draw, read, write,
}
use std::io::{Pending, print}
use std::transform::{rotate_y, translate}

/// A box round the idol (m), for its paint.
const BOUNDS = Box3 { lo: vec3(-3.5, -0.5, -2.0), hi: vec3(3.5, 7.0, 3.3) }

/// The views: front, three-quarter, side, back, the other side.
const TURNS = [0.0, -0.7853982, -1.5707963, 3.1415927, 1.5707963]

/// Its shots, one a frame in turn: the turnaround; then, of one idol at the origin, each an eye and
/// where it looks (m): the whole of it from a man's height, three-quarter on; its heads; its left
/// hand; its middle hand; it from behind and below.
const SHOTS: [(vec3, vec3, f32); 5] = [
    (vec3(-7.5, 1.7, 10.5), vec3(0.0, 3.4, 0.0), 0.75),
    (vec3(-2.0, 6.3, 5.6), vec3(0.0, 5.9, 0.2), 0.62),
    (vec3(4.8, 2.6, 3.8), vec3(1.75, 2.95, 0.35), 0.62),
    (vec3(-2.4, 4.5, 6.0), vec3(0.0, 4.7, 1.4), 0.62),
    (vec3(8.0, 1.2, -12.0), vec3(0.0, 3.4, 0.0), 0.62),
]

/// The stone's paint everywhere round the idol, as a field to cook a mesh's colours from.
fn stone() -> Creature<Stone> {
    solid(Block { half: vec3(4.0), round: 0.0, groove: 0.0 }.with_at(stone_paint), BOUNDS)
}

pub struct State {
    meshes: Vec<Mesh>,
    colours: Vec<GpuBuffer<Unorm8x4>>,
    palettes: GpuBuffer<mat4>,
    tallies: Vec<Pending<Tally>>,
    shadow: DepthTexture,
    smp: ComparisonSampler,
    shot: u32,
}

pub fn init() -> State {
    // Its seven parts from their sampled distances, each coloured by the stone's paint.
    let parts = [
        body_grid::samples(0),
        head_middle_grid::samples(0),
        head_left_grid::samples(0),
        head_right_grid::samples(0),
        hand_left_grid::samples(0),
        hand_right_grid::samples(0),
        hand_middle_grid::samples(0),
    ]
    let paint = stone()
    var meshes: Vec<Mesh> = Vec::new()
    var colour: Vec<GpuBuffer<Unorm8x4>> = Vec::new()
    var tallies: Vec<Pending<Tally>> = Vec::new()
    for part in parts {
        let m = realize_sampled(part.upload())
        colour.push(colours(m, paint.field(), ByChannels {}, cell: 0.01))
        tallies.push(read(m.tally.items()))
        meshes.push(take m)
    }
    // Five placed round for the turnaround, and one at the origin for the others.
    var palettes: GpuBuffer<mat4> = buffer(6 * MAX_BONES)
    for v in 0..5 {
        let place = translate(vec3(f32(v) * 6.6 - 13.2, 0.0, 0.0)) * rotate_y(TURNS[v])
        write(mut palettes, v * MAX_BONES, [place; 64])
    }
    write(mut palettes, 5 * MAX_BONES, [translate(vec3(0.0)); 64])
    State {
        meshes,
        colours: colour,
        palettes,
        tallies,
        shadow: unlit_shadow(),
        smp: comparison_sampler(),
        shot: 0,
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    for i in 0..s.tallies.len() {
        if let Some(Ok(v)) = s.tallies[i].poll() {
            let t = v[0]
            print(
                f"mesh {i}: {t.vertices} vertices, {t.pushed_quads} quads, {t.live_blocks} blocks, flags {t.flags}, holes {t.holes}",
            )
        }
    }
    let shot = s.shot % 6
    s.shot += 1
    let (eye, at, fovy) = if shot == 0 {
        (vec3(0.0, 3.6, 46.0), vec3(0.0, 3.2, 0.0), 0.36)
    } else {
        SHOTS[shot - 1]
    }
    let v = view(eye, at, fovy, f32(width) / f32(height), vec3(0.5, 0.8, 0.6), 16.0)
    var depth = depth_texture(width: width, height: height)
    let pass = begin_screen_pass_with_depth(mut depth, clear: vec4(0.85, 0.82, 0.76, 1.0))
    let n = if shot == 0 { 5 } else { 1 }
    let first = if shot == 0 { 0 } else { 5 }
    for k in 0..s.meshes.len() * n {
        let m = k / n
        draw(
            pass,
            skin_coloured.bind(
                verts: s.meshes[m].verts.items(),
                colours: s.colours[m].items(),
                palettes: s.palettes.items(),
                first: (first + k % n) * MAX_BONES,
                view: v,
            ),
            coloured.bind(view: v, lights: LIGHTS, shadow: s.shadow, shadow_sampler: s.smp),
            indices: s.meshes[m].quads.items(),
            indirect: s.meshes[m].draw.items(),
            cull: Cull::Back,
        )
    }
    pass.present()
}
