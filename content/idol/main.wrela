// The idol to look at: its seven sampled parts (the body, its three heads, its three hands, each
// a distance grid read from GPU memory by engine::sampled) realized once, at rest, each fitted to
// what it holds once its tally is read back; carved stone (engine::carving) under a low sun with
// shadows. A frame each, in turn: its turnaround (five times round, front to back) and five nearer
// shots (`SHOTS`).

use idol::{Block, Stone, stone_paint}
use engine::creature::Creature
use engine::sampled::realize_sampled
use std::derive::Box3
use engine::character::{ByChannels, colours}
use engine::creature::MAX_BONES
use engine::carving::{STATUE, carved, skin_carved}
use engine::plain::{LIGHTS, Lights, coloured, depth_only, skin_coloured, skin_shadow, view}
use engine::realize::{Mesh, Tally, solid}
use std::gpu::{
    ComparisonSampler, Cull, DepthBias, DepthTexture, begin_depth_pass, GpuBuffer, Unorm8x4,
    begin_screen_pass_with_depth, buffer, comparison_sampler, depth_texture, draw, read, write,
}
use std::io::{Pending, print}
use std::transform::{rotate_y, translate}

/// Whether the stone is carved pixel by pixel (`engine::carving`), or plain (`--set CARVED=0`).
pub const CARVED: u32 = 1

/// Whether it's lit by a low sun from the side, with shadows, as stone is best judged (1), or
/// by the examples' plain light, unshadowed (`--set RAKING=0`).
pub const RAKING: u32 = 1

/// The low sun's light: strong, with little from the sky, so relief casts and catches.
const RAKED = Lights {
    sun_colour: vec3(2.7, 2.45, 2.1),
    sky: vec3(0.5, 0.6, 0.78),
    ground: vec3(0.28, 0.24, 0.19),
    ambient: 0.55,
    exposure: 0.85,
    f0: 0.04,
    normal_offset: 1.5e-2,
    compare_bias: 0.001,
}

/// A box round the idol (m), for its paint.
const BOUNDS = Box3 { lo: vec3(-3.5, -0.5, -2.0), hi: vec3(3.5, 7.0, 3.3) }

/// The views: front, three-quarter, side, back, the other side.
const TURNS = [0.0, -0.7853982, -1.5707963, 3.1415927, 1.5707963]

/// Its shots, one a frame in turn: the turnaround; then, of one idol at the origin, each an eye and
/// where it looks (m): the whole of it from a man's height, three-quarter on; its heads; its left
/// hand; its middle hand; it from behind and below.
const SHOTS: [(vec3, vec3, f32); 5] = [
    (vec3(-7.5, 1.7, 10.5), vec3(0.0, 3.4, 0.0), 0.75),
    (vec3(-2.0, 6.3, 5.6), vec3(0.0, 5.9, 0.2), 0.62),
    (vec3(4.8, 2.6, 3.8), vec3(1.75, 2.95, 0.35), 0.62),
    (vec3(-2.4, 4.5, 6.0), vec3(0.0, 4.7, 1.4), 0.62),
    (vec3(8.0, 1.2, -12.0), vec3(0.0, 3.4, 0.0), 0.62),
]

/// The stone's paint everywhere round the idol, as a field to cook a mesh's colours from.
fn stone() -> Creature<Stone> {
    solid(Block { half: vec3(4.0, 8.0, 4.0) }.with_at(stone_paint), BOUNDS)
}

pub struct State {
    meshes: Vec<Mesh>,
    colours: Vec<GpuBuffer<Unorm8x4>>,
    palettes: GpuBuffer<mat4>,
    tallies: Vec<Pending<Tally>>,
    map: DepthTexture,
    depth: DepthTexture,
    width: u32,
    height: u32,
    smp: ComparisonSampler,
    shot: u32,
}

pub fn init() -> State {
    // Its seven parts from their sampled distances, each coloured by the stone's paint.
    let parts = [
        body_grid::samples(0),
        head_middle_grid::samples(0),
        head_left_grid::samples(0),
        head_right_grid::samples(0),
        hand_left_grid::samples(0),
        hand_right_grid::samples(0),
        hand_middle_grid::samples(0),
    ]
    let paint = stone()
    var meshes: Vec<Mesh> = Vec::new()
    var colour: Vec<GpuBuffer<Unorm8x4>> = Vec::new()
    var tallies: Vec<Pending<Tally>> = Vec::new()
    for part in parts {
        let m = realize_sampled(part.upload())
        colour.push(colours(m, paint.field(), ByChannels {}, cell: 0.01))
        tallies.push(read(m.tally.items()))
        meshes.push(take m)
    }
    // Five placed round for the turnaround, and one at the origin for the others.
    var palettes: GpuBuffer<mat4> = buffer(6 * MAX_BONES)
    for v in 0..5 {
        let place = translate(vec3(f32(v) * 6.6 - 13.2, 0.0, 0.0)) * rotate_y(TURNS[v])
        write(mut palettes, v * MAX_BONES, [place; MAX_BONES])
    }
    write(mut palettes, 5 * MAX_BONES, [translate(vec3(0.0)); MAX_BONES])
    State {
        meshes,
        colours: colour,
        palettes,
        tallies,
        map: depth_texture(width: 4096, height: 4096),
        depth: depth_texture(width: 1, height: 1),
        width: 1,
        height: 1,
        smp: comparison_sampler(),
        shot: 0,
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    for i in 0..s.tallies.len() {
        if let Some(Ok(v)) = s.tallies[i].poll() {
            let t = v[0]
            s.meshes[i].fit(t.vertices, t.pushed_quads)
            print(
                f"mesh {i}: {t.vertices} vertices, {t.pushed_quads} quads, {t.live_blocks} blocks, flags {t.flags}, holes {t.holes}",
            )
        }
    }
    let shot = s.shot % 6
    s.shot += 1
    let (eye, at, fovy) = if shot == 0 {
        (vec3(0.0, 3.6, 46.0), vec3(0.0, 3.2, 0.0), 0.36)
    } else {
        SHOTS[shot - 1]
    }
    let raking = RAKING != 0
    let sun = if raking { vec3(0.85, 0.55, 0.5) } else { vec3(0.5, 0.8, 0.6) }
    let extent = if shot == 0 { 16.0 } else { 6.0 }
    let lights = if raking { RAKED } else { LIGHTS }
    let v = view(eye, at, fovy, f32(width) / f32(height), sun, extent)
    let n = if shot == 0 { 5 } else { 1 }
    let first = if shot == 0 { 0 } else { 5 }
    // The sun's shadow map, when it's raking (cleared, it shadows nothing).
    let cast = begin_depth_pass(mut s.map, clear_depth: 1.0)
    if raking {
        for k in 0..s.meshes.len() * n {
            let m = k / n
            draw(
                cast,
                skin_shadow.bind(
                    verts: s.meshes[m].verts.items(),
                    palettes: s.palettes.items(),
                    first: (first + k % n) * MAX_BONES,
                    view: v,
                ),
                depth_only,
                indices: s.meshes[m].quads.items(),
                indirect: s.meshes[m].draw.items(),
                depth_bias: DepthBias { constant: 4, slope: 2.0, clamp: 0.0 },
            )
        }
    }
    cast.end()
    if width != s.width || height != s.height {
        s.depth = depth_texture(width: width, height: height)
        s.width = width
        s.height = height
    }
    let pass = begin_screen_pass_with_depth(mut s.depth, clear: vec4(0.85, 0.82, 0.76, 1.0))
    for k in 0..s.meshes.len() * n {
        let m = k / n
        if CARVED == 0 {
            draw(
                pass,
                skin_coloured.bind(
                    verts: s.meshes[m].verts.items(),
                    colours: s.colours[m].items(),
                    palettes: s.palettes.items(),
                    first: (first + k % n) * MAX_BONES,
                    view: v,
                ),
                coloured.bind(view: v, lights: lights, shadow: s.map, shadow_sampler: s.smp),
                indices: s.meshes[m].quads.items(),
                indirect: s.meshes[m].draw.items(),
                cull: Cull::Back,
            )
        } else {
            draw(
                pass,
                skin_carved.bind(
                    verts: s.meshes[m].verts.items(),
                    colours: s.colours[m].items(),
                    palettes: s.palettes.items(),
                    first: (first + k % n) * MAX_BONES,
                    view: v,
                ),
                carved.bind(
                    view: v,
                    lights: lights,
                    carving: STATUE,
                    shadow: s.map,
                    shadow_sampler: s.smp,
                ),
                indices: s.meshes[m].quads.items(),
                indirect: s.meshes[m].draw.items(),
                cull: Cull::Back,
            )
        }
    }
    pass.present()
}
