// The idol's right hand: the reference's distance, sampled every 2.5 cm (engine::sampled), written
// by /mnt/project-files/idol-3d/fit/v16/export_sampled.py from the reference mesh, which never
// ships. 12 x 12 x 13 blocks of 4 cells, 733 stored; a sample is a byte, the distance in [-BAND,
// BAND].
// Filtered: each sample is the distance averaged over two cells, so carving finer than a cell
// is soft, not ragged.
// Log line: docs/generated.jsonl, Rodin Gen-2 prediction xe9s0rk069rmy0d1pgjt4smfj8.

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-2.19180, 2.35000, -0.35000)
pub const CELL: f32 = 0.02500
pub const SIZE: vec3u = vec3u(12, 12, 13)
pub const BAND: f32 = 0.05000

/// Its tables (its vertices to bone `bone`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

