        .join(
            "mid fore",
            b("middle forearm"),
            Block { half: vec3(0.33, 0.32, 0.31), round: 0.08, groove: GROOVE }
                .rotate(Quat { v: vec4(-0.08716, 0.00000, 0.00000, 0.99619) })
                .translate(vec3(0.0, 3.04, 1.25))
                .with_at(stone_paint)
                .translate(-s.rest(b("middle forearm"))),
            seam: hard(),
