                .rotate(Quat { v: vec4(0.05001, 0.00005, 0.05001, 0.99750) })
                .translate(vec3(1.08, 0.87, -0.575))
                .with_at(stone_paint)
                .translate(-s.rest(b("calf left"))),
            seam: hard(),
            mirror: true,
        )
        .join(
            "foot",
            b("foot left"),
            Block { half: vec3(0.6, 0.216, 0.94), round: 0.07, groove: 0.0 }
                .rotate(Quat { v: vec4(0.00005, 0.00005, 0.00005, 1.00000) })
                .translate(vec3(1.2, 0.217, -0.42))
                .with_at(stone_paint)
                .translate(-s.rest(b("foot left"))),
            seam: hard(),
            mirror: true,
        )
        .join(
            "toes",
            b("foot left"),
            Block { half: vec3(0.543, 0.149, 0.202), round: 0.07, groove: 0.0 }
                .rotate(Quat { v: vec4(0.00005, 0.00005, 0.00005, 1.00000) })
                .translate(vec3(1.15, 0.16, 0.382))
                .with_at(stone_paint)
                .translate(-s.rest(b("foot left"))),
            seam: hard(),
            mirror: true,
        )
        .join(
            "shoulder",
            b("upper arm left"),
            Block { half: vec3(0.4, 0.32, 0.46), round: 0.1, groove: 0.0 }
                .rotate(Quat { v: vec4(0.00000, 0.00000, 0.00000, 1.00000) })
                .translate(vec3(2.02, 4.42, -0.45))
                .with_at(stone_paint)
                .translate(-s.rest(b("upper arm left"))),
            seam: hard(),
            mirror: true,
        )
        .join(
            "elbow",
            b("forearm left"),
            Block { half: vec3(0.38, 0.26, 0.42), round: 0.1, groove: 0.0 }
                .rotate(Quat { v: vec4(0.00000, 0.00000, 0.07493, 0.99719) })
                .translate(vec3(2.1, 3.62, -0.36))
                .with_at(stone_paint)
                .translate(-s.rest(b("forearm left"))),
            seam: hard(),
            mirror: true,
        )
        .join(
            "mid root",
            b("chest"),
            Block { half: vec3(0.4, 0.28, 0.42), round: 0.08, groove: 0.0 }
                .rotate(Quat { v: vec4(0.00000, 0.00000, 0.00000, 1.00000) })
                .translate(vec3(0.0, 4.25, 0.54))
                .with_at(stone_paint)
                .translate(-s.rest(b("chest"))),
            seam: hard(),
        )
        .join(
            "mid upper",
            b("middle upper arm"),
            Block { half: vec3(0.3, 0.47, 0.28), round: 0.08, groove: GROOVE }
                .rotate(Quat { v: vec4(-0.18224, 0.00000, 0.00000, 0.98325) })
                .translate(vec3(0.0, 3.79, 1.02))
                .with_at(stone_paint)
                .translate(-s.rest(b("middle upper arm"))),
