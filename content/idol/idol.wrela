}

/// Its three heads, one design: the middle facing ahead, the side heads turned out.
pub fn heads() -> Creature<Stone> {
    let s = skeleton()
    let b = |name: Text| s.find(name)
    creature(s)
        .join("head middle", b("head middle"), Head {}.with_at(head_paint))
        .join(
            "head side",
            b("head left"),
            Head {}.rotate(HEAD_TURN).with_at(side_head_paint),
            seam: hard(),
            mirror: true,
        )
}

/// A head's paint, from a point in the head bone's space (`stone_paint`, at the point's place).
fn head_paint(p: vec3) -> Stone {
    stone_paint(p + HEAD_MIDDLE)
}

fn side_head_paint(p: vec3) -> Stone {
    stone_paint(p + HEAD_SIDE)
}

/// Its three hands, one design: its left, its right (the left's mirror image) and its middle.
pub fn hands() -> Creature<Stone> {
    let s = skeleton()
    let b = |name: Text| s.find(name)
    creature(s)
        .join("hand side", b("hand left"), Hand {}.with_at(hand_paint), mirror: true)
        .join(
            "hand middle",
            b("middle hand"),
            Hand {}.scale(MIDDLE_SCALE).rotate(MIDDLE_TURN).with_at(middle_hand_paint),
            seam: hard(),
        )
}

fn hand_paint(p: vec3) -> Stone {
    stone_paint(p + WRIST)
}

fn middle_hand_paint(p: vec3) -> Stone {
    stone_paint(p + MIDDLE_WRIST)
}
