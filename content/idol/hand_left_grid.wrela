// The idol's left hand: the reference's distance sampled every 2.5 cm (engine::sampled), written by
// /mnt/project-files/idol-3d/fit/grid/export_sampled.py from the reference mesh, which never
// ships. 13 x 14 x 17 blocks of 4 cells, 936 stored; a sample is a byte, the distance in
// [-BAND, BAND].
// Log line: docs/generated.jsonl, Rodin Gen-2 prediction ayj7bgx9txrmr0d1pdas97f1t8.

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(1.30000, 1.95000, -0.85000)
pub const CELL: f32 = 0.02500
pub const SIZE: vec3u = vec3u(13, 14, 17)
pub const BAND: f32 = 0.05000

/// Its tables (its vertices to bone `bone`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

/// Each block's slot (0 outside, 1 inside, 2 + its index stored), x fastest, as base64 words.
