// The electric guitar's player, for the audio tool (`wrela tool audio -- content/guitar wav
// <out.wav> --take n`). An instrument check, not a composition; the phrases were written for
// this, and quote no recording or score:
// - take 0: the clean sound. Four bars of chords picked a string at a time and let ring (A
//   minor, F, C, G), then the same chords strummed, down on the beat and up off it;
// - take 1: the crunch. A riff on the low E string, palm-muted eighths with chords of a fifth
//   let go between them, every stroke down;
// - take 2: the lead. A line in A minor's five notes, played as a player leans on it: some
//   notes accented and slid into, steps bent to and let back, a pull-off, long notes swayed
//   wider the longer they are held, a finger late off one string for the next, with an echo.
//   Take 3 is the same line with no bends: every slur hammered on or pulled off;
// - takes 4 to 8: take 1's riff through each of the other amplifiers: dad rock, hair metal,
//   stoner rock (tuned a whole step down), death metal (two whole steps down) and metalcore
//   (a whole step down);
// - take 9: a wall. The riff two whole steps down through the `WALL` amplifier: two bars of
//   one guitar alone on the left, then on a downbeat, with no fill, a second player on the
//   right, a darker pair behind them, a bass guitar an octave under, and drums, for eight
//   bars and a last chord;
// - takes 10, 11 and 12: every key from the low E string to the high one's last fret, on the
//   clean sound, the crunch and the lead, 0.6 s each with a rest between and no room: the
//   check that the instrument sounds the note it is asked for.

use engine::drum::{CRASH, HAT, KICK, SNARE}
use engine::guitar::{
    Amp, BASS, CLEAN, CRUNCH, DAD_ROCK, DEATH_METAL, Guitar, HAIR_METAL, HUMBUCKER, Hand, LEAD,
    METALCORE, Picking, SOLO, STONER, WALL, pickings, string_for, tuned_down,
}
use engine::pattern::{Feel, Pattern, pattern, struck, tacet}
use engine::perform::{Mark, Performance, Taste, bar, perform}
use engine::score::{Score, meter, score}
use engine::session::{Master, Session, Strip, play_session, session}
use std::audio::{SAMPLE_RATE, play}
use std::collections::Vec

const TITLE: Text = "Guitar"

/// The clean phrase: eight bars at 92.
fn clean() -> Score {
    score(TITLE, meter(beats: 4, unit: 4)).voice(
        "guitar",
        [
            "a2/8 !mf e3 a3 c4 e4 c4 a3 e3 |",
            "f2/8 c3 f3 a3 e4 a3 f3 c3 |",
            "c3/8 e3 g3 c4 e4 c4 g3 e3 |",
            "g2/8 d3 g3 b3 d4 b3 g3 d3 |",
            "<a2 e3 a3 c4 e4>/4 !mf <a2 e3 a3 c4 e4>/8 <a2 e3 a3 c4 e4> r <a2 e3 a3 c4 e4> <a2 e3 a3 c4 e4> <a2 e3 a3 c4 e4> |",
            "<f2 c3 f3 a3 c4 f4>/4 <f2 c3 f3 a3 c4 f4>/8 <f2 c3 f3 a3 c4 f4> r <f2 c3 f3 a3 c4 f4> <f2 c3 f3 a3 c4 f4> <f2 c3 f3 a3 c4 f4> |",
            "<c3 e3 g3 c4 e4>/4 <c3 e3 g3 c4 e4>/8 <c3 e3 g3 c4 e4> r <c3 e3 g3 c4 e4> <c3 e3 g3 c4 e4> <c3 e3 g3 c4 e4> |",
            "<g2 b2 d3 g3 b3 g4>/1 |",
        ],
    )
}

/// The riff: five bars at 132.
fn riff() -> Score {
    score(TITLE, meter(beats: 4, unit: 4)).voice(
        "guitar",
        [
            "e2/8 !f !staccato e2 !staccato <e2 b2 e3> !accent e2 !staccato e2 !staccato <g2 d3 g3> !accent e2 !staccato e2 !staccato |",
            "e2/8 !staccato e2 !staccato <e2 b2 e3> !accent e2 !staccato <a2 e3 a3>/4 !accent <g2 d3 g3>/4 |",
            "e2/8 !staccato e2 !staccato <e2 b2 e3> !accent e2 !staccato e2 !staccato <g2 d3 g3> !accent e2 !staccato e2 !staccato |",
            "<c3 g3 c4>/4. !accent <d3 a3 d4>/4. !accent <e2 b2 e3>/4 !accent |",
            "<e2 b2 e3>/1 |",
        ],
    )
}

/// The line: six bars at 84. An accent is leaned on (and slid into); a slur of a step is a
/// bend.
fn line() -> Score {
    score(TITLE, meter(beats: 4, unit: 4)).voice(
        "guitar",
        [
            "r/4 e4/8 !mf g4 a4/4. !accent c5/8 |",
            "c5/8 !< ( d5 ) d5/2 !accent !f ( c5/8 a4 ) |",
            "r/8 a4/8 !mf c5 ( d5 ) e5/4 !accent !< g5/8 ( a5 ) |",
            "a5/2. !accent !ff g5/8 !> ( e5 ) |",
            "d5/8 !mf c5 a4 g4 a4/4 ( c5 ) |",
            "a4/1 !accent !f |",
        ],
    )
}

/// The wall's bass: the riff's low notes, an octave under the guitars, the fifths' roots under
/// the chords.
fn low() -> Score {
    score(TITLE, meter(beats: 4, unit: 4)).voice(
        "bass",
        [
            "e1/8 !f e1 e1 e1 e1 g1 e1 e1 |",
            "e1/8 e1 e1 e1 a1/4 g1 |",
            "e1/8 e1 e1 e1 e1 g1 e1 e1 |",
            "c2/4. d2 e1/4 |",
        ],
    )
}

/// The riff's four bars and nothing after, for the wall to say twice.
fn four_bars() -> Score {
    score(TITLE, meter(beats: 4, unit: 4)).voice(
        "guitar",
        [
            "e2/8 !f !staccato e2 !staccato <e2 b2 e3> !accent e2 !staccato e2 !staccato <g2 d3 g3> !accent e2 !staccato e2 !staccato |",
            "e2/8 !staccato e2 !staccato <e2 b2 e3> !accent e2 !staccato <a2 e3 a3>/4 !accent <g2 d3 g3>/4 |",
            "e2/8 !staccato e2 !staccato <e2 b2 e3> !accent e2 !staccato e2 !staccato <g2 d3 g3> !accent e2 !staccato e2 !staccato |",
            "<c3 g3 c4>/4. !accent <d3 a3 d4>/4. !accent <e2 b2 e3>/4 !accent |",
        ],
    )
}

/// One bar of `name` holding the chord or note `what` for the whole of it.
fn held(name: Text, what: Text) -> Score {
    score(TITLE, meter(beats: 4, unit: 4)).voice(name, [what])
}

/// A drum's part for the wall: silent while the one guitar is alone, then `phrase` (four
/// bars) twice, then `last`.
fn kit(name: Text, phrase: [Text], last: Text) -> Pattern {
    let four = meter(beats: 4, unit: 4)
    let said = pattern(name, four, phrase)
    tacet(four, bars: 2).then(said.clone()).then(said).then(pattern(name, four, [last]))
}

/// A score played at `tempo`, each note a little unlike the last, as a hand's are: `seed`
/// chooses how, so two players of one part differ.
fn played(s: Score, tempo: f32, seed: u32 = 1) -> Performance {
    perform(
        s,
        Taste { tempo, metre: 0.05, accent: 0.3, jitter_time: 0.004, jitter_velocity: 0.06, seed },
        [Mark::Hold { at: bar(1), by: 1.0 }; 0],
    )
}

/// `picks` on a guitar tuned `down` semitones lower: fingered the same, sounding that much
/// lower.
fn lowered(picks: take Vec<Picking>, down: f32) -> Vec<Picking> {
    var out = take picks
    for i in 0..out.len() {
        out[i].key = out[i].key - down
    }
    out
}

/// The wall: the riff at 120, two whole steps down.
const WALL_TEMPO: f32 = 120.0
const WALL_DOWN: f32 = 4.0

/// One guitar's part in the wall: the riff's four bars `times` times after `rest` bars of
/// silence, then the last chord, as the player `seed` plays it on `g`.
fn wall_guitar(g: Guitar, rest: u32, times: u32, seed: u32) -> Vec<Picking> {
    var part = four_bars()
    for _ in 1..times {
        part = take part.then(four_bars())
    }
    part = take part.then(held("guitar", "<e2 b2 e3>/1 !accent |"))
    if rest > 0 {
        var before = held("guitar", "r/1 |")
        for _ in 1..rest {
            before = take before.then(held("guitar", "r/1 |"))
        }
        part = take before.then(take part)
    }
    // Every stroke down, and quick across the strings.
    let hand = Hand { up_every: 0, strum: 0.005 }
    lowered(pickings(part, played(part, WALL_TEMPO, seed), 0, g, hand), WALL_DOWN)
}

/// The wall, ready to play.
fn wall() -> Session {
    var s = session(
        WALL_TEMPO,
        Master {
            gain: 2.0,
            glue_db: -18.0,
            glue: 0.45,
            makeup: 4.0,
            warmth: 0.8,
            ceiling: -1.0,
            room_time: 0.9,
            room_highs: 0.4,
            room_size: 1.8,
            room_db: -7.0,
            duck_time: 0.09,
        },
    )
    let feel = Feel { loose: 0.002, uneven: 0.05, seed: 3 }
    s.drum(
        "kick",
        KICK,
        struck(
            kit(
                "kick",
                [
                    "x.x. ..x. x.x. ..x. | x.x. ..x. x... x... | x.x. ..x. x.x. ..x. | x... ..x. .... x... |",
                ],
                "X... .... .... .... |",
            ),
            WALL_TEMPO,
            feel,
            key: 36,
        ),
        Strip { gain: -2.0, room: 0.05 },
    )
    s.drum(
        "snare",
        SNARE,
        struck(
            kit(
                "snare",
                [
                    ".... X... .... X... | .... X... .... X... | .... X... .... X... | .... X... .... X.[xx]x |",
                ],
                ".... .... .... .... |",
            ),
            WALL_TEMPO,
            Feel { late: 0.006, ..feel },
            key: 38,
        ),
        Strip { gain: -3.0, room: 0.2 },
    )
    s.drum(
        "hat",
        HAT,
        struck(
            kit(
                "hat",
                [
                    "..x. x.x. x.x. x.x. | x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x.x. | x.x. x.x. x.x. x... |",
                ],
                ".... .... .... .... |",
            ),
            WALL_TEMPO,
            Feel { late: -0.004, ..feel },
            key: 42,
        ),
        Strip { gain: -14.0, pan: 0.3, low_cut: 400.0, room: 0.1 },
    )
    s.drum(
        "crash",
        CRASH,
        struck(
            kit(
                "crash",
                [
                    "X... .... .... .... | .... .... .... .... | X... .... .... .... | .... .... .... .... |",
                ],
                "X... .... .... .... |",
            ),
            WALL_TEMPO,
            feel,
            key: 49,
        ),
        Strip { gain: -9.0, pan: -0.3, low_cut: 300.0, room: 0.3 },
    )
    // The bass guitar: under everything, in the middle, pushed down a little by each kick.
    var bass_part = held("bass", "r/1 |").then(held("bass", "r/1 |"))
    bass_part = take bass_part.then(low())
    bass_part = take bass_part.then(low())
    bass_part = take bass_part.then(held("bass", "e1/1 |"))
    let bass = tuned_down(BASS, WALL_DOWN)
    let fingers = Hand { mutes: false }
    s.guitar(
        "bass",
        bass,
        lowered(pickings(bass_part, played(bass_part, WALL_TEMPO, 5), 0, BASS, fingers), WALL_DOWN),
        Strip { gain: -1.0, high_cut: 3000.0, duck: 3.0, room: 0.03 },
    )
    // The guitars. The first is alone for two bars; the second answers it from the other
    // side through another speaker; a darker pair sits behind and between them. Each is its
    // own player, so no two strokes land together.
    let left = tuned_down(Guitar { amp: WALL, ..HUMBUCKER }, WALL_DOWN)
    let right = tuned_down(Guitar { amp: Amp { cone: 29, ..WALL }, ..HUMBUCKER }, WALL_DOWN)
    let behind = tuned_down(Guitar { amp: Amp { level: -17.0, ..STONER }, ..HUMBUCKER }, WALL_DOWN)
    let other = tuned_down(
        Guitar { amp: Amp { level: -17.0, cone: 41, ..STONER }, ..HUMBUCKER },
        WALL_DOWN,
    )
    let cut = 85.0
    s.guitar(
        "guitar left",
        left,
        wall_guitar(left, rest: 0, times: 2, seed: 11),
        Strip { pan: -0.9, low_cut: cut, room: 0.12 },
    )
    s.guitar(
        "guitar right",
        right,
        wall_guitar(right, rest: 2, times: 2, seed: 12),
        Strip { pan: 0.9, low_cut: cut, room: 0.12 },
    )
    s.guitar(
        "guitar behind left",
        behind,
        wall_guitar(behind, rest: 2, times: 2, seed: 13),
        Strip { gain: -1.0, pan: -0.45, low_cut: cut, room: 0.25 },
    )
    s.guitar(
        "guitar behind right",
        other,
        wall_guitar(other, rest: 2, times: 2, seed: 14),
        Strip { gain: -1.0, pan: 0.45, low_cut: cut, room: 0.25 },
    )
    s.key("kick")
    s
}

/// The guitar a scale's take is played on.
fn sound(which: u32) -> Guitar {
    match which % 10 {
        1 => CRUNCH,
        2 => LEAD,
        _ => CLEAN,
    }
}

/// Every key from 40 to 86, 0.6 s each and 0.8 s apart.
fn scale(g: Guitar) -> Vec<Picking> {
    var out: Vec<Picking> = Vec::new()
    for k in 0..47 {
        let key = f32(40 + k)
        out.push(
            Picking {
                from: 9600 + 38400 * k,
                to: 9600 + 38400 * k + 28800,
                key,
                string: string_for(g, key),
            },
        )
    }
    out
}

/// The guitar the riff's take `which` is played on, and how many semitones down it is tuned.
fn riff_on(which: u32) -> (Guitar, f32) {
    match which {
        4 => (Guitar { amp: DAD_ROCK, ..HUMBUCKER }, 0.0),
        5 => (Guitar { amp: HAIR_METAL, ..HUMBUCKER }, 0.0),
        6 => (Guitar { amp: STONER, ..HUMBUCKER }, 2.0),
        7 => (Guitar { amp: DEATH_METAL, ..HUMBUCKER }, 4.0),
        8 => (Guitar { amp: METALCORE, ..HUMBUCKER }, 2.0),
        _ => (CRUNCH, 0.0),
    }
}

/// The session of take `which`, and how many bars it has.
fn chosen(which: u32) -> (Session, u32) {
    if which == 9 {
        return (wall(), 11)
    }
    if which >= 10 {
        var s = session(tempo: 75.0)
        let g = sound(which)
        s.guitar("guitar", g, scale(g))
        return (s, 47)
    }
    if which == 1 || (which >= 4 && which <= 8) {
        var s = session(tempo: 132.0, master: Master { room_time: 0.6, room_db: -8.0 })
        let r = riff()
        let (g, down) = riff_on(which)
        // Every stroke down, and quick across the strings. A guitar tuned down is fingered
        // the same, and sounds that much lower.
        let hand = Hand { up_every: 0, strum: 0.005 }
        let picks = lowered(pickings(r, played(r, 132.0), 0, g, hand), down)
        s.guitar("guitar", tuned_down(g, down), picks, Strip { room: 0.1 })
        return (s, 5)
    }
    if which == 2 || which == 3 {
        var s = session(
            tempo: 84.0,
            master: Master { room_time: 1.2, echo_beats: 0.75, echo_again: 0.3, echo_db: -9.0 },
        )
        let l = line()
        let hand = if which == 2 { SOLO } else { Hand { bends: 0, ..SOLO } }
        s.guitar(
            "guitar",
            LEAD,
            pickings(l, played(l, 84.0), 0, LEAD, hand),
            Strip { room: 0.15, echo: 0.35 },
        )
        return (s, 6)
    }
    var s = session(tempo: 92.0, master: Master { room_time: 1.3 })
    let c = clean()
    // Each note rings on until its string is wanted again.
    let hand = Hand { ring: 1.2 }
    s.guitar("guitar", CLEAN, pickings(c, played(c, 92.0), 0, CLEAN, hand), Strip { room: 0.25 })
    (s, 8)
}

pub struct Piece {
    which: u32,
    started: bool,
}

pub fn init() -> Piece {
    Piece { which: 0, started: false }
}

pub fn choose(p: mut Piece, which: u32) {
    assert(!p.started, "a take is chosen before the piece starts")
    assert(which <= 12, "the guitar has takes 0 to 12")
    p.which = which
}

@audio
fn render(s: mut Session, left: mut [f32], right: mut [f32]) {
    play_session(mut s, mut left, mut right)
}

pub fn frame(p: mut Piece, time: f32, width: u32, height: u32) {
    if !p.started {
        p.started = true
        let (s, _) = chosen(p.which)
        play(take s, render)
    }
}

pub fn seconds(p: Piece) -> f32 {
    let (s, _) = chosen(p.which)
    f32(s.seconds)
}

pub fn describe(p: Piece) {
    let (s, bars) = chosen(p.which)
    let name = match p.which {
        0 => "clean",
        1 => "crunch",
        2 => "lead",
        3 => "lead, no bends",
        4 => "dad rock",
        5 => "hair metal",
        6 => "stoner rock",
        7 => "death metal",
        8 => "metalcore",
        9 => "wall",
        _ => "scale",
    }
    s.describe(TITLE, name, bars)
}
