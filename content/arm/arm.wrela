// Hakuro's left arm as one form: a sweep from inside his armhole to inside the wrap at his
// wrist, through his elbow, by thirteen sections. Each section has three bumps: the muscle up and
// back of the arm (the triceps' outer head, then the forearm's extensors), the muscle up and in
// front (the biceps, then the forearm's flexors), and the hollow under it.
//
// Its structure is written; its numbers are solved against the sampled reference (`fit::misses`:
// `wrela solve content/arm --fit fit::misses --free arm.wrela:<PATH's lines and the sections'>
// --write`), so none of them is an author's guess.
//
// Its path goes through five points: its two ends, and three about his elbow's joint. At rest
// they are where `PATH` puts them; posed (`posed`), each is where its bone carries it (the upper
// arm's two, the forearm's two, and the joint's own between them), so the arm's two lengths stay
// straight and it bends at his elbow, and the form is made again along that path.

use engine::sweep::{Section, Sweep, section, sweep}

/// Where the path's points are along the arm at rest (x, m): its ends, his elbow's joint, and
/// 5 cm either side of it. Held, while the solver moves the rest.
const AT_X: [f32; 5] = [0.16, 0.413, 0.463, 0.513, 0.62]

/// How far a bump reaches either side of its middle (radians). Held: a solver's trial step past
/// 0 would stop the solve (`Section::bump` asserts it).
const WIDE: f32 = 0.6

/// The path's height and depth at each of its points at rest (y, z; m).
const PATH: [vec2; 5] = [
    vec2(1.4500, -0.0700),
    vec2(1.4102, -0.0706),
    vec2(1.4266, -0.0829),
    vec2(1.4408, -0.0806),
    vec2(1.4440, -0.0789),
]

/// Where its sections are, as fractions of its path's length: the first where he stops being
/// trunk and is an arm (x 0.23; before it the form keeps that section, into his armhole).
const PLACES: [f32; 13] = [
    0.152, 0.196, 0.250, 0.304, 0.370, 0.435, 0.511, 0.587, 0.674, 0.761, 0.848, 0.924, 1.000,
]

/// Its sections, from his shoulder to his wrist.
fn sections() -> [Section; 13] {
    [
        section(
            up: 0.1121,
            down: 0.0601,
            left: 0.1357,
            right: 0.0955,
            square: 0.29,
            turn: 0.134,
        )
            .bump(at: -0.458, height: 0.0218, width: WIDE)
            .bump(at: 4.645, height: -0.0255, width: WIDE)
            .bump(at: 3.656, height: -0.0214, width: WIDE),
        section(
            up: 0.0866,
            down: 0.0478,
            left: 0.0941,
            right: 0.0692,
            square: 1.83,
            turn: 0.423,
        )
            .bump(at: -0.042, height: 0.0157, width: WIDE)
            .bump(at: 5.745, height: 0.0076, width: WIDE)
            .bump(at: 3.389, height: -0.0105, width: WIDE),
        section(
            up: 0.0742,
            down: 0.0446,
            left: 0.0912,
            right: 0.0688,
            square: 2.47,
            turn: 0.436,
        )
            .bump(at: 0.387, height: 0.0062, width: WIDE)
            .bump(at: 5.442, height: 0.0012, width: WIDE)
            .bump(at: 3.099, height: -0.0100, width: WIDE),
        section(
            up: 0.0715,
            down: 0.0428,
            left: 0.0888,
            right: 0.0623,
            square: 3.17,
            turn: 0.341,
        )
            .bump(at: 1.385, height: -0.0039, width: WIDE)
            .bump(at: 5.249, height: 0.0107, width: WIDE)
            .bump(at: 3.812, height: -0.0047, width: WIDE),
        section(
            up: 0.0757,
            down: 0.0399,
            left: 0.0843,
            right: 0.0641,
            square: 3.00,
            turn: 0.413,
        )
            .bump(at: 1.436, height: -0.0119, width: WIDE)
            .bump(at: 5.344, height: 0.0123, width: WIDE)
            .bump(at: 3.657, height: -0.0096, width: WIDE),
        section(
            up: 0.0767,
            down: 0.0362,
            left: 0.0762,
            right: 0.0658,
            square: 2.92,
            turn: 0.444,
        )
            .bump(at: 1.381, height: -0.0126, width: WIDE)
            .bump(at: 5.404, height: 0.0122, width: WIDE)
            .bump(at: 3.744, height: -0.0076, width: WIDE),
        section(
            up: 0.0731,
            down: 0.0286,
            left: 0.0612,
            right: 0.0644,
            square: 3.17,
            turn: 0.418,
        )
            .bump(at: 1.137, height: -0.0031, width: WIDE)
            .bump(at: 5.433, height: 0.0114, width: WIDE)
            .bump(at: 4.365, height: -0.0005, width: WIDE),
        section(
            up: 0.0881,
            down: 0.0301,
            left: 0.0600,
            right: 0.0556,
            square: 2.16,
            turn: 0.151,
        )
            .bump(at: 0.191, height: -0.0150, width: WIDE)
            .bump(at: 5.335, height: 0.0120, width: WIDE)
            .bump(at: 4.323, height: -0.0121, width: WIDE),
        section(
            up: 0.0803,
            down: 0.0640,
            left: 0.0584,
            right: 0.0474,
            square: 1.72,
            turn: -0.177,
        )
            .bump(at: -0.005, height: -0.0008, width: WIDE)
            .bump(at: 5.262, height: 0.0089, width: WIDE)
            .bump(at: 3.907, height: -0.0019, width: WIDE),
        section(
            up: 0.0783,
            down: 0.0703,
            left: 0.0556,
            right: 0.0435,
            square: 1.92,
            turn: -0.341,
        )
            .bump(at: 1.072, height: 0.0019, width: WIDE)
            .bump(at: 5.491, height: 0.0021, width: WIDE)
            .bump(at: 3.463, height: 0.0058, width: WIDE),
        section(
            up: 0.0620,
            down: 0.0688,
            left: 0.0501,
            right: 0.0414,
            square: 2.15,
            turn: -0.483,
        )
            .bump(at: 1.172, height: 0.0049, width: WIDE)
            .bump(at: 4.692, height: 0.0024, width: WIDE)
            .bump(at: 3.569, height: 0.0014, width: WIDE),
        section(
            up: 0.0604,
            down: 0.0652,
            left: 0.0513,
            right: 0.0468,
            square: 2.10,
            turn: -0.551,
        )
            .bump(at: 0.678, height: 0.0026, width: WIDE)
            .bump(at: 4.741, height: 0.0030, width: WIDE)
            .bump(at: 3.597, height: -0.0046, width: WIDE),
        section(
            up: 0.0564,
            down: 0.0513,
            left: 0.0421,
            right: 0.0438,
            square: 1.96,
            turn: -0.589,
        )
            .bump(at: 0.101, height: 0.0051, width: WIDE)
            .bump(at: 4.710, height: 0.0058, width: WIDE)
            .bump(at: 3.412, height: -0.0045, width: WIDE),
    ]
}

/// The path's points at rest.
fn rest_points() -> [vec3; 5] {
    [
        vec3(AT_X[0], PATH[0]),
        vec3(AT_X[1], PATH[1]),
        vec3(AT_X[2], PATH[2]),
        vec3(AT_X[3], PATH[3]),
        vec3(AT_X[4], PATH[4]),
    ]
}

/// The arm at rest (his T-pose): +x toward the hand, angle 0 up, a quarter turn his back.
pub fn arm() -> Sweep<13> {
    sweep(rest_points(), up: vec3(y: 1.0), sections: sections(), places: PLACES)
}

/// The arm posed: its form along the path its bones carry its points to, and how far his
/// forearm is turned about its length (`turn`, radians), which the form's sections take up from
/// his elbow (`from`, a fraction of the path's length) to his wrist.
pub struct Posed: Copy {
    pub form: Sweep<13>,
    pub turn: f32,
    pub from: f32,
}

/// `p` as matrix `m` carries it.
fn carried(m: mat4, p: vec3) -> vec3 {
    (m * vec4(p, 1.0)).xyz
}

/// The angle (radians, toward the left) from a sweep's own up at its path's end to `up`, about
/// the path there.
fn end_angle(form: Sweep<13>, up: vec3) -> f32 {
    let last = form.vertices - 1
    let n = form.normal[last]
    let uu = form.up[last]
    let v = cross(uu, n)
    atan2(dot(up, v), dot(up, uu))
}

/// The arm as his upper arm's and forearm's bones pose it (each the matrix that carries a point
/// of him at rest to where the bone has it): the path's first two points go with his upper arm,
/// its last two with his forearm, and the joint's own point halfway between where each has it.
/// Its sections' up is his upper arm's; his forearm's own turn about its length is `turn`.
pub fn posed(upper: mat4, fore: mat4) -> Posed {
    let p = rest_points()
    let points = [
        carried(upper, p[0]),
        carried(upper, p[1]),
        0.5 * (carried(upper, p[2]) + carried(fore, p[2])),
        carried(fore, p[3]),
        carried(fore, p[4]),
    ]
    let up = normalize((upper * vec4(0.0, 1.0, 0.0, 0.0)).xyz)
    let form = sweep(points, up: up, sections: sections(), places: PLACES)
    let fore_up = normalize((fore * vec4(0.0, 1.0, 0.0, 0.0)).xyz)
    let turn = end_angle(form, fore_up) - end_angle(arm(), vec3(y: 1.0))
    // (The joint's point is the path's middle one: the vertex halfway along its pieces.)
    let from = form.along[(form.vertices - 1) / 2] / form.length()
    Posed { form, turn, from }
}
