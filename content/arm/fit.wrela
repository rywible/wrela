// How far the arm is from the reference it's solved against (`target::TARGET`: the sampled arm's
// lattice points near its surface, each with the reference's distance there): the arm's own
// distance at each point, held against the reference's.

use arm::arm
use std::field::Surface
use target::{POINTS, TARGET}

/// Target point `i`, and the reference's distance there (m).
pub fn point(i: u32) -> vec4 {
    vec4(
        f32(TARGET[4 * i]) * 0.0001,
        f32(TARGET[4 * i + 1]) * 0.0001,
        f32(TARGET[4 * i + 2]) * 0.0001,
        f32(TARGET[4 * i + 3]) * 0.000001,
    )
}

/// How far the arm is from each target point (mm), over the square root of their count, so
/// the sum of their squares is the mean squared miss (mm²). What a least-squares solve makes
/// small (`wrela solve --fit fit::misses`, where the toolchain has it).
pub fn misses() -> [f32; POINTS] {
    let a = arm()
    var out = [0.0; POINTS]
    let scale = 1000.0 / sqrt(f32(POINTS))
    for i in 0..POINTS {
        let t = point(i)
        out[i] = (a.near(t.xyz) - t.w) * scale
    }
    out
}

/// The arm's mean squared miss over the target (mm²): what `wrela solve --minimize fit::miss`
/// makes small.
pub fn miss() -> f32 {
    var sum = 0.0
    for m in misses() {
        sum += m * m
    }
    sum
}
