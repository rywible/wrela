// The cloth of Hakuro's coat's tails: how the tails are draped from his hips, kept off his legs
// and follow them (`Drape`, `draped`, `follow_legs`). Nothing of him is a sampled mesh any more:
// his arms, his hands, his legs, his trunk, his neck, his head and his jacket are drawn along
// their charts (`hakuro::charts`, `hakuro::wide_charts`).

use shapes::{TAILS_AXIS, TAILS_FROM, TAILS_TO, front_edge, hem, tails}
use engine::realize::{Mesh, SkinVertex, Tally}
use std::collections::Vec
use std::gpu::{GlobalId, GpuBuffer, GpuSpan, Slots, Unorm8x4, buffer, dispatch, write}
use std::math::TAU

// ---- the tails' drape, worked out on a grid over the cloth's middle -------------------------

/// The drape's grid: columns round the tails from one front edge to the other, rows from their
/// top down to the hem. Each frame each node is draped over his legs (`off_legs`) and each vertex
/// of the cloth moves as the nodes round it do: both faces and every neighbour alike, so the cloth
/// can't tear or turn its lining through its face. (Worked out vertex by vertex, neighbours a
/// millimetre apart were pushed different ways round a leg and the lining tore into shards.)
pub const DRAPE_COLS: u32 = 72
pub const DRAPE_ROWS: u32 = 40
pub const DRAPE_NODES: u32 = DRAPE_COLS * DRAPE_ROWS

/// Where on the grid (column, row; fractional) a point of the tails at rest is.
fn drape_cell(rest: vec3) -> vec2 {
    let rel = rest - TAILS_AXIS
    var deg = atan2(rel.x, rel.z) * 57.2957795
    if deg < 0.0 {
        deg += 360.0
    }
    let inside = clamp(deg, TAILS_FROM, TAILS_TO)
    let c = (inside - TAILS_FROM) / (TAILS_TO - TAILS_FROM) * f32(DRAPE_COLS - 1)
    let t = clamp((TAILS_TOP_REST - rest.y) / (TAILS_TOP_REST - hem(inside)), 0.0, 1.0)
    vec2(c, t * f32(DRAPE_ROWS - 1))
}

/// The point at rest of the cloth's middle at a node.
fn drape_node(c: u32, r: u32) -> vec3 {
    let deg = TAILS_FROM + (TAILS_TO - TAILS_FROM) * f32(c) / f32(DRAPE_COLS - 1)
    let y = TAILS_TOP_REST - (TAILS_TOP_REST - hem(deg)) * f32(r) / f32(DRAPE_ROWS - 1)
    let a = deg * 0.0174532925
    let out = vec3(sin(a), 0.0, cos(a))
    let p = vec3(TAILS_AXIS.x, y, TAILS_AXIS.z) + out * 0.2
    p - out * tails(p).1
}

/// A point of the tails at rest carried by his hips and legs as `palettes` (from `first`) pose
/// them (`tails_weights`).
fn tails_skinned(rest: vec3, palettes: [mat4], first: u32) -> vec3 {
    let (b, bits) = tails_weights(rest)
    let w = Unorm8x4 { bits }.decode()
    let m = palettes[first + (b & 255)] * w.x +
        palettes[first + ((b >> 8) & 255)] * w.y +
        palettes[first + ((b >> 16) & 255)] * w.z +
        palettes[first + (b >> 24)] * w.w
    (m * vec4(rest, 1.0)).xyz
}

/// His thighs' joints at rest: what a thigh turns about.
const THIGH_JOINT: vec3 = vec3(0.114, 0.971, -0.036)

/// `rest` turned by `share` of what `thigh` (a thigh's matrix) turns from `hips` (his hips'),
/// about that thigh's joint (`joint`, at rest), in his hips' own space.
fn part_turned(rest: vec3, hips: mat4, thigh: mat4, joint: vec3, share: f32) -> vec3 {
    if share <= 0.0 {
        return rest
    }
    // The thigh's turn from his hips, as an axis and an angle.
    // (His hips' turn undone: each of the thigh's axes along his hips' own.)
    let (h0, h1, h2) = (hips[0].xyz, hips[1].xyz, hips[2].xyz)
    let across = |c: vec3| vec3(dot(h0, c), dot(h1, c), dot(h2, c))
    let r = mat3(across(thigh[0].xyz), across(thigh[1].xyz), across(thigh[2].xyz))
    let lean = vec3(r[1][2] - r[2][1], r[2][0] - r[0][2], r[0][1] - r[1][0])
    let s = 0.5 * length(lean)
    if s < 1.0e-5 {
        return rest
    }
    let angle = atan2(s, 0.5 * (r[0][0] + r[1][1] + r[2][2] - 1.0)) * share
    let k = lean / (2.0 * s)
    let d = rest - joint
    joint + d * cos(angle) + cross(k, d) * sin(angle) + k * dot(k, d) * (1.0 - cos(angle))
}

/// Where the cloth's shape has a point of the tails (`rest`) as `palettes` (from `first`)
/// pose him: carried by his hips, and turned about each thigh's joint by that thigh's share
/// (`tails_weights`) of its turn. (`tails_skinned` puts it a share of the way to where the
/// thigh would carry it, which is nearer the joint: with a thigh lifted square to his hips a
/// sixth nearer. The cloth, as long as ever, had to gather to lie on that shape, and its
/// front edge ruffled at every high step.)
fn tails_carried(rest: vec3, palettes: [mat4], first: u32) -> vec3 {
    let (_, bits) = tails_weights(rest)
    let w = Unorm8x4 { bits }.decode()
    let hips = palettes[first]
    let left = part_turned(rest, hips, palettes[first + 18], THIGH_JOINT, w.y)
    let right = part_turned(
        rest,
        hips,
        palettes[first + 19],
        vec3(-THIGH_JOINT.x, THIGH_JOINT.y, THIGH_JOINT.z),
        w.z,
    )
    (hips * vec4(left + right - rest, 1.0)).xyz
}

/// How much of the cloth's own shape it keeps each frame: drawn this far toward where his hips
/// carry it at rest (its A-line and pleats), the rest left to its weight, its swing and his legs.
const SHAPE: f32 = 0.15
/// How much of its swing it keeps from frame to frame (air and its own stiffness take the rest).
const KEEP: f32 = 0.75
/// How many times a frame each node is pulled back to its neighbours' distances.
const RELAXES: u32 = 16

/// Where `rest` (a node of the cloth, its column's top at `top`) would hang: carried by his hips
/// as the tails are skinned, but swung back toward plumb below the jacket's hem the further down it
/// is, as cloth hangs. (Carried stiffly, a tilt of his hips stood the tails' hem out like a shelf
/// when he leaned out over the skiff's rail.)
fn hung(rest: vec3, top: vec3, palettes: [mat4], first: u32, going: f32) -> vec3 {
    let at = tails_carried(rest, palettes, first)
    let w = 0.85 * smoothstep(0.0, 0.45, top.y - rest.y)
    if w <= 0.0 {
        return at
    }
    let anchor = tails_carried(top, palettes, first)
    let below = tails_carried(top - vec3(0.0, 0.3, 0.0), palettes, first)
    let down = normalize(below - anchor)
    // (Plumb, in the air he's going through: going `going` m/s the way his hips face, the
    // cloth hangs back from straight down by the air's push, which grows as his speed squared.
    // Hanging straight down at a run, his coat's tails only swung: they never streamed.)
    let ahead = palettes[first][2].xyz
    let back = -normalize(vec3(ahead.x, 0.0, ahead.z))
    let plumb = normalize(vec3(0.0, -1.0, 0.0) + back * (STREAM * going * going))
    let axis = cross(down, plumb)
    let s = length(axis)
    if s < 1.0e-4 {
        return at
    }
    let k = axis / s
    let angle = atan2(s, dot(down, plumb)) * w
    let v = at - anchor
    let c = cos(angle)
    anchor + v * c + cross(k, v) * sin(angle) + k * dot(k, v) * (1.0 - c)
}

/// How far the cloth hangs back from straight down for his speed squared (the tangent of the
/// angle, for each (m/s)²): 25° at a run's 4 m/s, 3° at a walk.
const STREAM: f32 = 0.029

/// How firmly a node is held where his hips carry it: wholly along the seam where the tails
/// carry on from his jacket (their top centimetre and a half), free from 8 cm below it. (Held
/// a hand's width down, as they were when their top was tucked under a longer jacket, a thigh
/// lifted in a stride came through the held cloth at his hip: it couldn't ride up over it.)
fn pinned(rest: vec3) -> f32 {
    let u = clamp((rest.y - 0.85) / 0.065, 0.0, 1.0)
    u * u * (3.0 - 2.0 * u)
}

/// How much a node is the seam itself (1 along the tails' top edge, none from 2.5 cm under
/// it): his jacket's hem carried on, which goes where the jacket does.
fn sewn(rest: vec3) -> f32 {
    smoothstep(0.9, 0.925, rest.y)
}

/// How much of a node is cloth (1 within the tails' front edges, none from 8° past one): the
/// grid runs on in front of the edges where they're cut back (`shapes::front_edge`), and its
/// nodes there are no cloth. Kept off a thigh that lifted through them, they stood away from
/// the cloth beside them, column by column, and the edge between was drawn in steps.
fn woven(rest: vec3) -> f32 {
    let rel = rest - TAILS_AXIS
    var deg = atan2(rel.x, rel.z) * 57.2957795
    if deg < 0.0 {
        deg += 360.0
    }
    let edge = front_edge(rest.y)
    1.0 - smoothstep(0.0, 8.0, max(edge - deg, deg - (360.0 - edge)))
}

/// A node's place in `views` views' grids: its view, its column and row, its first bone.
fn node_of(i: u32, stride: u32) -> (u32, u32, u32, u32) {
    let view = i / DRAPE_NODES
    let n = i % DRAPE_NODES
    (view, n % DRAPE_COLS, n / DRAPE_COLS, view * stride)
}

/// The cloth's step: each node swung on from where it was (`pos`, a frame ago `prev`) by its
/// own momentum and its weight, and drawn a little toward its shape on him. The first frame
/// (`fresh`) it starts where his hips carry it.
@compute(64)
pub fn cloth_step(
    palettes: [mat4],
    views: u32,
    stride: u32,
    dt: f32,
    going: f32,
    fresh: u32,
    pos: [vec4],
    prev: [vec4],
    root: [vec4],
    out_pos: mut Slots<vec4>,
    out_prev: mut Slots<vec4>,
    id: GlobalId,
) {
    if id.x >= views * DRAPE_NODES {
        return
    }
    let (_, c, r, first) = node_of(id.x, stride)
    let rest = drape_node(c, r)
    let target = hung(rest, drape_node(c, 0), palettes, first, going)
    if fresh == 1 {
        out_pos[id] = vec4(target, 0.0)
        out_prev[id] = vec4(target, 0.0)
        return
    }
    let p = pos[id.x].xyz
    let swing = (p - prev[id.x].xyz) * KEEP
    // (Its swing damped as it moves against him, not as he's carried: the way his hips moved
    // since the last step is kept whole. Damped with the rest, the coat of a man carried along
    // at a skiff's ten metres a second streamed out behind him as if in a gale.)
    let view = id.x / DRAPE_NODES
    let carried = hips_of(palettes, first) - root[view].xyz
    var q = p + swing + carried * (1.0 - KEEP) + vec3(0.0, -9.8, 0.0) * dt * dt
    q = mix(q, target, mix(SHAPE, 1.0, pinned(rest)))
    out_pos[id] = vec4(q, 0.0)
    out_prev[id] = vec4(p, 0.0)
}

/// Where his hips are as `palettes` (from `first`) pose him.
fn hips_of(palettes: [mat4], first: u32) -> vec3 {
    (palettes[first] * vec4(0.0, 0.949, -0.043, 1.0)).xyz
}

/// Each view's hips as this frame poses them, for the next step's `cloth_step`.
@compute(64)
pub fn cloth_root(palettes: [mat4], views: u32, stride: u32, out: mut Slots<vec4>, id: GlobalId) {
    if id.x >= views {
        return
    }
    out[id] = vec4(hips_of(palettes, id.x * stride), 0.0)
}

/// The cloth relaxed once: each node pulled toward its neighbours' distances at rest (beside it
/// and above and below, and two along for its stiffness), then kept off his legs and arms.
@compute(64)
pub fn cloth_relax(
    palettes: [mat4],
    views: u32,
    stride: u32,
    legs: [f32],
    pos: [vec4],
    out: mut Slots<vec4>,
    id: GlobalId,
) {
    if id.x >= views * DRAPE_NODES {
        return
    }
    let (view, c, r, first) = node_of(id.x, stride)
    let rest = drape_node(c, r)
    let pin = pinned(rest)
    let target = tails_skinned(rest, palettes, first)
    let p = pos[id.x].xyz
    let base = view * DRAPE_NODES
    var pull = vec3(0.0)
    var weight = 0.0
    let steps = [
        vec2(-1.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.0, -1.0),
        vec2(0.0, 1.0),
        vec2(-2.0, 0.0),
        vec2(2.0, 0.0),
        vec2(0.0, -2.0),
        vec2(0.0, 2.0),
    ]
    for k in 0..8 {
        let cc = i32(c) + i32(steps[k].x)
        let rr = i32(r) + i32(steps[k].y)
        if cc >= 0 && cc < i32(DRAPE_COLS) && rr >= 0 && rr < i32(DRAPE_ROWS) {
            let o = pos[base + u32(rr) * DRAPE_COLS + u32(cc)].xyz
            let want = length(drape_node(u32(cc), u32(rr)) - rest)
            let d = o - p
            let l = length(d)
            let w = if k < 4 { 1.0 } else { 0.25 }
            if l > 1.0e-6 {
                pull += d * ((l - want) / l) * 0.5 * w
            }
            weight += w
        }
    }
    var q = p + pull / max(weight, 1.0) * 1.6
    // (Only what's cloth is kept off him: a node past the tails' front edge goes where its
    // neighbours take it.)
    let cloth = woven(rest)
    q = mix(q, off_legs_now(q, rest, palettes, first), cloth)
    q = mix(q, off_trousers(q, palettes, first, legs, CLEAR_OF_LEG, 10.0), cloth)
    q = mix(q, target, pin)
    // (Where it's held at the seam it can't hang off a leg, only be put out of one: a thigh
    // swung out as he stands, or lifted in a stride, came through the cloth his hips hold.
    // But not its top edge, which is his jacket's hem carried on: put out of a lifted thigh
    // while the hem over it stayed, its front corner stood off the hem as a wing at his belt.
    // The corner goes into the fold of his hip with the hem, and the cloth comes out over
    // his thigh under it.)
    q = mix(
        q,
        off_trousers(q, palettes, first, legs, CLEAR_PINNED, 10.0),
        (1.0 - sewn(rest)) * cloth,
    )
    out[id] = vec4(q, 0.0)
}

/// Each node's drape: how far the cloth is from where his hips alone would carry it (`out`), and
/// which way its outside faces now (`facing`): the cloth's thickness is laid along it, so when
/// it swings over, its face and lining turn over with it and never pass through each other.
@compute(64)
pub fn cloth_drape(
    palettes: [mat4],
    views: u32,
    stride: u32,
    pos: [vec4],
    out: mut Slots<vec4>,
    facing: mut Slots<vec4>,
    id: GlobalId,
) {
    if id.x >= views * DRAPE_NODES {
        return
    }
    let (view, c, r, first) = node_of(id.x, stride)
    let base = view * DRAPE_NODES
    let at = |cc: u32, rr: u32| pos[base + rr * DRAPE_COLS + cc].xyz
    let c0 = if c > 0 { c - 1 } else { c }
    let c1 = min(c + 1, DRAPE_COLS - 1)
    let r0 = if r > 0 { r - 1 } else { r }
    let r1 = min(r + 1, DRAPE_ROWS - 1)
    let rest = drape_node(c, r)
    let here = tails_skinned(rest, palettes, first)
    // Its outside at rest, carried by his hips: out from the tails' axis.
    let flat = vec3(rest.x - TAILS_AXIS.x, 0.0, rest.z - TAILS_AXIS.z)
    let o = normalize(flat)
    let ow = normalize(tails_skinned(rest + o * 0.01, palettes, first) - here)
    // Its outside now: across the cloth, turned the way its outside was at rest.
    let round = at(c1, r) - at(c0, r)
    let down = at(c, r1) - at(c, r0)
    let rround = tails_skinned(drape_node(c1, r), palettes, first) -
        tails_skinned(drape_node(c0, r), palettes, first)
    let rdown = tails_skinned(drape_node(c, r1), palettes, first) -
        tails_skinned(drape_node(c, r0), palettes, first)
    let rn = cross(rround, rdown)
    let sign = if dot(rn, ow) >= 0.0 { 1.0 } else { -1.0 }
    let n = cross(round, down) * sign
    let nl = length(n)
    facing[id] = vec4(if nl > 1.0e-8 { n / nl } else { ow }, 0.0)
    out[id] = vec4(at(c, r) - here, 0.0)
}

/// The tails' cloth for `views` views: each node of the drape's grid where it is (two, this
/// frame's and the last's), where it was a frame before, and how far it hangs from where his
/// hips carry it (`grid`, what `draped` reads).
pub struct Drape {
    pos_a: GpuBuffer<vec4>,
    pos_b: GpuBuffer<vec4>,
    prev_a: GpuBuffer<vec4>,
    prev_b: GpuBuffer<vec4>,
    out: GpuBuffer<vec4>,
    facing: GpuBuffer<vec4>,
    // (Each view's hips at the last step.)
    root: GpuBuffer<vec4>,
    // (His trouser legs' radii at rest, `leg_radii`: what the cloth is kept off.)
    legs: GpuBuffer<f32>,
    flip: u32,
    fresh: bool,
}

/// Room for the cloth of `views` views.
pub fn drape_room(views: u32) -> Drape {
    let n = views * DRAPE_NODES
    Drape {
        pos_a: buffer(n),
        pos_b: buffer(n),
        prev_a: buffer(n),
        prev_b: buffer(n),
        out: buffer(n),
        facing: buffer(n),
        root: buffer(views),
        legs: leg_radii(),
        flip: 0,
        fresh: true,
    }
}

/// One frame of the cloth: stepped from `pos` and `prev` into `next` and `next_prev`, relaxed
/// back and forth between `next` and `pos` (ending in `next`), its drape into `out`.
fn cloth_frame(
    palettes: GpuBuffer<mat4>,
    views: u32,
    stride: u32,
    legs: GpuBuffer<f32>,
    dt: f32,
    going: f32,
    fresh: u32,
    pos: mut GpuBuffer<vec4>,
    prev: GpuBuffer<vec4>,
    next: mut GpuBuffer<vec4>,
    next_prev: mut GpuBuffer<vec4>,
    out: mut GpuBuffer<vec4>,
    facing: mut GpuBuffer<vec4>,
    root: mut GpuBuffer<vec4>,
) {
    let groups = (views * DRAPE_NODES + 63) / 64
    dispatch(
        cloth_step.bind(
            palettes: palettes.items(),
            views: views,
            stride: stride,
            dt: dt,
            going: going,
            fresh: fresh,
            pos: pos.items(),
            prev: prev.items(),
            root: root.items(),
            out_pos: mut next,
            out_prev: mut next_prev,
        ),
        groups: groups,
    )
    for _ in 0..RELAXES / 2 {
        dispatch(
            cloth_relax.bind(
                palettes: palettes.items(),
                views: views,
                stride: stride,
                legs: legs.items(),
                pos: next.items(),
                out: mut pos,
            ),
            groups: groups,
        )
        dispatch(
            cloth_relax.bind(
                palettes: palettes.items(),
                views: views,
                stride: stride,
                legs: legs.items(),
                pos: pos.items(),
                out: mut next,
            ),
            groups: groups,
        )
    }
    dispatch(
        cloth_drape.bind(
            palettes: palettes.items(),
            views: views,
            stride: stride,
            pos: next.items(),
            out: mut out,
            facing: mut facing,
        ),
        groups: groups,
    )
    dispatch(
        cloth_root.bind(palettes: palettes.items(), views: views, stride: stride, out: mut root),
        groups: (views + 63) / 64,
    )
}

impl Drape {
    /// The cloth for `views` views (each view's palette `stride` bones on from the last), moved
    /// on `dt` seconds, him going `going` m/s the way his hips face through still air (0: the
    /// air goes with him, or he's standing). (`lagged` is unused: the cloth carries its own
    /// swing.)
    pub fn work(
        mut self,
        palettes: GpuBuffer<mat4>,
        views: u32,
        stride: u32,
        lagged: u32,
        dt: f32,
        going: f32 = 0.0,
    ) {
        let fresh: u32 = if self.fresh { 1 } else { 0 }
        self.fresh = false
        let step = clamp(dt, 0.0, 1.0 / 20.0)
        if self.flip == 0 {
            cloth_frame(
                palettes,
                views,
                stride,
                self.legs,
                step,
                going,
                fresh,
                mut self.pos_a,
                self.prev_a,
                mut self.pos_b,
                mut self.prev_b,
                mut self.out,
                mut self.facing,
                mut self.root,
            )
        } else {
            cloth_frame(
                palettes,
                views,
                stride,
                self.legs,
                step,
                going,
                fresh,
                mut self.pos_b,
                self.prev_b,
                mut self.pos_a,
                mut self.prev_a,
                mut self.out,
                mut self.facing,
                mut self.root,
            )
        }
        self.flip = 1 - self.flip
    }

    /// How far the cloth hangs from where his hips carry it this frame, for `draped`.
    pub fn grid(self) -> GpuSpan<vec4> {
        self.out.items()
    }

    /// Which way the cloth's outside faces this frame, for `draped`.
    pub fn facing(self) -> GpuSpan<vec4> {
        self.facing.items()
    }
}

/// How far off his trouser legs' sides the cloth is kept (m): where it hangs free, and where
/// it's pinned up under his jacket's hem (only so a thigh swung out doesn't come through it:
/// kept as clear there as below, its top stood out past the hem as a ledge).
const CLEAR_OF_LEG: f32 = 0.012
const CLEAR_PINNED: f32 = 0.003

/// How far along a leg's path at rest his hip's joint is, and his knee's (m): the path starts
/// 8 cm over his hip (`figure::chains::leg_left`).
const HIP_ALONG: f32 = 0.08
const KNEE_ALONG: f32 = 0.509

/// His trouser legs' radii at rest, as a table the cloth's step reads (`leg_radii`): for each
/// leg (his left, his right) and each of its two lengths (thigh, shin), `LEG_ROWS` places
/// along it by `LEG_COLS` angles round it. A thigh's rows start `ABOVE_HIP` of its length over
/// his hip's joint, where his trousers' seat is.
const LEG_ROWS: u32 = 24
const LEG_COLS: u32 = 32
const ABOVE_HIP: f32 = 0.18

/// The joints either end of length `seg` (0 his thigh, 1 his shin) of his leg on `side` (0
/// his left), at rest.
fn leg_ends(side: u32, seg: u32) -> (vec3, vec3) {
    let sx = if side == 0 { 1.0 } else { -1.0 }
    if seg == 0 {
        return (vec3(0.114 * sx, 0.971, -0.036), vec3(0.114 * sx, 0.542, -0.036))
    }
    (vec3(0.114 * sx, 0.542, -0.036), vec3(0.114 * sx, 0.086, -0.088))
}

/// His trouser legs' radii at rest about each of their straight lengths: how far his charted
/// leg's side (`hakuro::charts`) is from the length's line, at each row's place along it and
/// each column's angle round it (from his front, toward his left). A trouser leg is 8 cm deep
/// one way and 15 the other: a capsule fat enough for the one let the cloth lie inside the
/// other, and his thigh came through his coat's skirt wherever he stood with a leg out. The
/// form's own side read at every node every pass (`Limb::toward`) kept the cloth off it as
/// well and took 90 ms a frame; the table is that side, read once.
fn leg_radii() -> GpuBuffer<f32> {
    let parts = hakuro::charts()
    var radii: Vec<f32> = Vec::new()
    for side in 0..2 {
        let leg = parts[4 + side].rest()
        let whole = leg.path.length()
        for seg in 0..2 {
            let (a, b) = leg_ends(side, seg)
            let e = b - a
            let from = if seg == 0 { -ABOVE_HIP } else { 0.0 }
            for i in 0..LEG_ROWS {
                let h = mix(from, 1.0, f32(i) / f32(LEG_ROWS - 1))
                let along = (if seg == 0 { HIP_ALONG } else { KNEE_ALONG }) + h * length(e)
                let fr = leg.path.frame(along)
                let on = a + e * h
                for j in 0..LEG_COLS {
                    let phi = TAU * f32(j) / f32(LEG_COLS)
                    let way = vec3(sin(phi), 0.0, cos(phi))
                    let theta = atan2(dot(way, fr.left), dot(way, fr.up))
                    radii.push(length(leg.side(f: along / whole, theta: theta) - on))
                }
            }
        }
    }
    // (Each place the most of itself and the places round it: read between places, a fold of
    // his trousers finer than the table stood through the cloth as specks.)
    var hull: Vec<f32> = Vec::new()
    for k in 0..4 {
        for i in 0..LEG_ROWS {
            for j in 0..LEG_COLS {
                var most = 0.0
                for di in 0..3 {
                    for dj in 0..3 {
                        let ii = u32(clamp(i32(i) + i32(di) - 1, 0, i32(LEG_ROWS) - 1))
                        let jj = (j + dj + LEG_COLS - 1) % LEG_COLS
                        most = max(most, radii[(k * LEG_ROWS + ii) * LEG_COLS + jj])
                    }
                }
                hull.push(most)
            }
        }
    }
    var out: GpuBuffer<f32> = buffer(2 * 2 * LEG_ROWS * LEG_COLS)
    write(mut out, 0, hull)
    out
}

/// `p` (a node of the cloth) kept `clear` off his trouser legs as `palette` (from `first`)
/// poses them (`legs`: `leg_radii`), where that moves it no more than about `most` (m). The
/// cloth's point is taken back to him at rest by his thigh's bone and by his shin's in turn,
/// and where it's by that bone's length of the leg it's kept clear of the leg's side there,
/// out from the length's line.
fn off_trousers(p: vec3, palette: [mat4], first: u32, legs: [f32], clear: f32, most: f32) -> vec3 {
    var q = p
    // His middle, between his hips: the cloth hangs outside his legs, out from it.
    let mid = ((palette[first + 18] * vec4(0.114, 0.971, -0.036, 1.0)).xyz +
        (palette[first + 19] * vec4(-0.114, 0.971, -0.036, 1.0)).xyz) *
        0.5
    for side in 0..2 {
        for seg in 0..2 {
            let m = palette[first + 18 + 2 * seg + side]
            let off = q - m[3].xyz
            let back = vec3(dot(m[0].xyz, off), dot(m[1].xyz, off), dot(m[2].xyz, off))
            let (a, b) = leg_ends(side, seg)
            let e = b - a
            let h = dot(back - a, e) / dot(e, e)
            let from = if seg == 0 { -ABOVE_HIP } else { 0.0 }
            if h > from && h < 1.0 {
                let d = back - (a + e * h)
                let rho = length(d)
                // The leg's radius there: between the table's rows and columns.
                let row = (h - from) / (1.0 - from) * f32(LEG_ROWS - 1)
                let col = fract(atan2(d.x, d.z) / TAU + 1.0) * f32(LEG_COLS)
                let i0 = min(u32(floor(row)), LEG_ROWS - 2)
                let j0 = u32(floor(col)) % LEG_COLS
                let j1 = (j0 + 1) % LEG_COLS
                let fi = clamp(row - f32(i0), 0.0, 1.0)
                let fj = col - floor(col)
                let base = ((side * 2 + seg) * LEG_ROWS + i0) * LEG_COLS
                let r = mix(
                    mix(legs[base + j0], legs[base + j1], fj),
                    mix(legs[base + LEG_COLS + j0], legs[base + LEG_COLS + j1], fj),
                    fi,
                )
                let need = r + clear - rho
                if need > 0.0 && rho > 1.0e-5 {
                    var n = (m * vec4(d / rho, 0.0)).xyz
                    // (Off a leg always to its outer side, seen from his middle: pushed
                    // straight off it, cloth just beside a leg kicked back slid round it and
                    // the leg came out behind the coat.)
                    let flat = vec3(q.x - mid.x, 0.0, q.z - mid.z)
                    let fl = length(flat)
                    if fl > 1.0e-4 {
                        let o = flat / fl
                        let outer = dot(n, o)
                        if outer < 0.3 {
                            n = normalize(n + o * (0.3 - outer) * 2.0)
                        }
                    }
                    // (All the way clear if that's no more than `most`; less the deeper in
                    // it is, and not at all from twice `most`.)
                    q = q + n * need * (1.0 - smoothstep(most, 2.0 * most, need))
                }
            }
        }
    }
    q
}

/// `p` (a node of the cloth, at rest `rest`) kept off his boots and arms as `palette` (from
/// `first`) poses them: straight off each boot, forearm and hand, a capsule each, a couple of
/// centimetres clear (less however far into a boot's the cloth already hangs at rest). His
/// trouser legs are `off_trousers`'.
fn off_legs_now(p: vec3, rest: vec3, palette: [mat4], first: u32) -> vec3 {
    var q = p
    // His middle, between his hips: the cloth hangs outside his legs, out from it.
    let mid = ((palette[first + 18] * vec4(0.114, 0.971, -0.036, 1.0)).xyz +
        (palette[first + 19] * vec4(-0.114, 0.971, -0.036, 1.0)).xyz) *
        0.5
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        let heel = (palette[first + 22 + side] * vec4(0.124 * sx, 0.065, -0.13, 1.0)).xyz
        let toe = (palette[first + 22 + side] * vec4(0.124 * sx, 0.055, 0.14, 1.0)).xyz
        let elbow = (palette[first + 10 + side] * vec4(0.463 * sx, 1.455, -0.073, 1.0)).xyz
        let wrist = (palette[first + 12 + side] * vec4(0.706 * sx, 1.455, -0.065, 1.0)).xyz
        let knuckle = (palette[first + 12 + side] * vec4(0.86 * sx, 1.45, -0.05, 1.0)).xyz
        for k in 0..3 {
            let a = if k == 0 { heel } else if k == 1 { elbow } else { wrist }
            let b = if k == 0 { toe } else if k == 1 { wrist } else { knuckle }
            let ra = if k == 0 { 0.085 } else if k == 1 { 0.055 } else { 0.042 }
            let rb = if k == 0 { 0.075 } else if k == 1 { 0.042 } else { 0.045 }
            // (How far in the capsule the cloth hangs at rest: his boot's only, his arms are
            // clear.)
            var inside = 0.0
            if k == 0 {
                let ar = vec3(0.124 * sx, 0.065, -0.13)
                let er = vec3(0.124 * sx, 0.055, 0.14) - ar
                let hr = clamp(dot(rest - ar, er) / dot(er, er), 0.0, 1.0)
                inside = max(mix(ra, rb, hr) + 0.02 - length(rest - (ar + er * hr)), 0.0)
            }
            let e = b - a
            let h = clamp(dot(q - a, e) / dot(e, e), 0.0, 1.0)
            let off = q - (a + e * h)
            let d = length(off)
            let r = mix(ra, rb, h) + 0.02 - inside
            if r - d > 0.0 && d > 1.0e-5 {
                var n = off / d
                // (Off a boot always to its outer side, seen from his middle: pushed straight
                // off it, cloth just beside a heel kicked back slid round it and the boot came
                // out behind the coat.)
                if k == 0 {
                    let flat = vec3(q.x - mid.x, 0.0, q.z - mid.z)
                    let fl = length(flat)
                    if fl > 1.0e-4 {
                        let o = flat / fl
                        let outer = dot(n, o)
                        if outer < 0.3 {
                            n = normalize(n + o * (0.3 - outer) * 2.0)
                        }
                    }
                }
                // Out along it until clear of the capsule.
                let along = dot(off, n)
                let across = length(off - n * along)
                let need = sqrt(max(r * r - across * across, 0.0)) - along
                if need > 0.0 {
                    q = q + n * need
                }
            }
        }
    }
    q
}

/// A point of the tails (`hung`: where his hips carry it, turned by `turn`; at rest `rest`)
/// hanging as the cloth does this frame (view `view`'s, in `grid` and `facing`: `Drape`): its
/// middle moved as the nodes round it are, and its face or lining laid out from that middle the
/// way the cloth faces there now.
pub fn draped(hung: vec3, rest: vec3, turn: mat3, grid: [vec4], facing: [vec4], view: u32) -> vec3 {
    let at = drape_cell(rest)
    let c0 = min(u32(floor(at.x)), DRAPE_COLS - 2)
    let r0 = min(u32(floor(at.y)), DRAPE_ROWS - 2)
    let fx = clamp(at.x - f32(c0), 0.0, 1.0)
    let fy = clamp(at.y - f32(r0), 0.0, 1.0)
    let base = view * DRAPE_NODES
    let lerp = |b: [vec4], cc: u32, rr: u32| b[base + rr * DRAPE_COLS + cc].xyz
    let g = |b: [vec4]| mix(
        mix(lerp(b, c0, r0), lerp(b, c0 + 1, r0), fx),
        mix(lerp(b, c0, r0 + 1), lerp(b, c0 + 1, r0 + 1), fx),
        fy,
    )
    // How far out of the cloth's middle it is at rest, and which way (out from the axis).
    let th = tails(rest).1
    let flat = vec3(rest.x - TAILS_AXIS.x, 0.0, rest.z - TAILS_AXIS.z)
    let o = if length(flat) > 1.0e-4 { normalize(flat) } else { vec3(0.0, 0.0, -1.0) }
    let middle = hung - turn * (o * th)
    let n = g(facing)
    let nl = length(n)
    let out = if nl > 1.0e-4 { n / nl } else { turn * o }
    middle + g(grid) + out * th
}

/// The tails' top at rest (`shapes::TAILS_TOP`): the drape's first row.
const TAILS_TOP_REST: f32 = 0.93

// ---- his coat's tails ----------------------------------------------------------------------

/// Each of the tails' vertices on his hips and thighs: a coat's skirt hangs from the hips but
/// its lower part goes where his legs push it, the side over each leg mostly with that leg.
/// (The tails' field binds them to the pelvis whole; under a stride or a fighting stance his
/// thighs went through the cloth.)
pub fn tails_weights(p: vec3) -> (u32, u32) {
    // How far down the tails (from their top under the jacket's hem to about the knee).
    let t = clamp((0.98 - p.y) / 0.36, 0.0, 1.0)
    // (Only a little: the cloth (`Drape`) hangs from his hips and his legs push it; carried
    // further by the thighs, its shape swung the hem out flat with a leg stepped back.)
    let share = 0.2 * t * t * (3.0 - 2.0 * t)
    // Over which leg: his left (+x) or right, eased across the middle of his back.
    let lean = clamp(p.x / 0.15, -1.0, 1.0)
    var left = share * (0.5 + 0.5 * lean)
    var right = share - left
    // (Their hem, below the knee, partly carried by the nearer shin, so a heel kicked up behind
    // him lifts it rather than coming out through it.)
    let u = clamp((0.74 - p.y) / 0.24, 0.0, 1.0)
    let low = 0.0 * u
    var shin = 0.0
    if p.x >= 0.0 {
        shin = left * low
        left -= shin
    } else {
        shin = right * low
        right -= shin
    }
    let sb: u32 = if p.x >= 0.0 { 20 } else { 21 }
    let wl = u32(round(left * 255.0))
    let wr = u32(round(right * 255.0))
    let ws = u32(round(shin * 255.0))
    let w0 = 255 - min(wl + wr + ws, 255)
    (0 | (18 << 8) | (19 << 16) | (sb << 24), w0 | (wl << 8) | (wr << 16) | (ws << 24))
}

@compute(64)
pub fn skin_tails(tally: [Tally], verts: mut Slots<SkinVertex>, id: GlobalId) {
    if id.x >= tally[0].vertices {
        return
    }
    let v = verts[id]
    // (Weighed at the cloth's middle, so its lining and face move alike: weighed each where it
    // is, they turned apart and the lining showed through the face.)
    let rel = vec3(v.pos.x - TAILS_AXIS.x, 0.0, v.pos.z - TAILS_AXIS.z)
    let mid = v.pos - (if length(rel) > 1.0e-4 { normalize(rel) } else {
        vec3(0.0, 0.0, -1.0)
    }) * tails(v.pos).1
    let (bones, weights) = tails_weights(mid)
    verts[id] = SkinVertex { pos: v.pos, bones, normal: v.normal, weights, mask: v.mask }
}

/// His coat's tails (`hakuro::coat`, realized) made to follow his legs (`tails_weights`).
pub fn follow_legs(mesh: take Mesh) -> Mesh {
    var m = take mesh
    dispatch(
        skin_tails.bind(tally: m.tally.items(), verts: m.verts.items_mut()),
        groups: m.skin.items(),
    )
    m
}

/// `p` (a point of his coat's tails, posed) draped over his legs, posed as `palette` (from
/// `first`) has them. Each thigh, shin and boot is a tapered capsule round him, and the cloth is
/// kept a centimetre off them, pushed out from his middle. Each point hangs on a rod from the
/// tails' top above it, so a point pushed out swings up over the leg instead of being pierced
/// by it: a heel kicked up behind him lifts the hem over it. (Skinning to the thighs and shins
/// alone left a kicked leg or a knee coming through.)
pub fn off_legs(p: vec3, rest: vec3, palette: [mat4], first: u32) -> vec3 {
    var q = p
    // (Not at all up under his belt, where the tails hang from his hips: the thighs' tops pushed
    // there pinched the cloth into dark folds.)
    let u = clamp((0.99 - rest.y) / 0.1, 0.0, 1.0)
    let reach = u * u * (3.0 - 2.0 * u)
    if reach <= 0.0 {
        return q
    }
    // Its rod: from the tails' top straight above it at rest (carried by his hips), as long as at
    // rest; and his middle, between his hips, to push out from.
    // How far out of the cloth's middle the point is (its lining in, its face out): the legs
    // push the middle, and both faces go with it, so the lining is never pushed through the face.
    let th = tails(rest).1
    let rflat = vec3(rest.x - TAILS_AXIS.x, 0.0, rest.z - TAILS_AXIS.z)
    let rest_mid = rest - (if length(rflat) > 1.0e-4 { normalize(rflat) } else {
        vec3(0.0, 0.0, -1.0)
    }) * th
    let anchor = (palette[first] * vec4(rest.x, TAILS_TOP, rest.z, 1.0)).xyz
    let rod = TAILS_TOP - rest.y
    let mid = ((palette[first + 18] * vec4(0.114, 0.971, -0.036, 1.0)).xyz +
        (palette[first + 19] * vec4(-0.114, 0.971, -0.036, 1.0)).xyz) *
        0.5
    var hip = [vec3(0.0); 2]
    var knee = [vec3(0.0); 2]
    var ankle = [vec3(0.0); 2]
    var heel = [vec3(0.0); 2]
    var toe = [vec3(0.0); 2]
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        hip[side] = (palette[first + 18 + side] * vec4(0.114 * sx, 0.971, -0.036, 1.0)).xyz
        knee[side] = (palette[first + 20 + side] * vec4(0.114 * sx, 0.542, -0.036, 1.0)).xyz
        ankle[side] = (palette[first + 22 + side] * vec4(0.114 * sx, 0.086, -0.088, 1.0)).xyz
        heel[side] = (palette[first + 22 + side] * vec4(0.124 * sx, 0.065, -0.13, 1.0)).xyz
        toe[side] = (palette[first + 22 + side] * vec4(0.124 * sx, 0.055, 0.14, 1.0)).xyz
    }
    // His forearms and hands, whose swing passes the tails' sides.
    var elbow = [vec3(0.0); 2]
    var wrist = [vec3(0.0); 2]
    var knuckle = [vec3(0.0); 2]
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        elbow[side] = (palette[first + 10 + side] * vec4(0.463 * sx, 1.455, -0.073, 1.0)).xyz
        wrist[side] = (palette[first + 12 + side] * vec4(0.706 * sx, 1.455, -0.065, 1.0)).xyz
        knuckle[side] = (palette[first + 12 + side] * vec4(0.86 * sx, 1.45, -0.05, 1.0)).xyz
    }
    for _ in 0..6 {
        // On its rod (only where it hangs: none up under his belt), then out of his legs, last,
        // so whatever the rod leaves undone it's never left inside one.
        let hang = q - anchor
        if length(hang) > 1.0e-4 && rod > 0.0 {
            // Swung up no further than LIFT from hanging straight down: lifted past it the cloth
            // turned over, its lining out, and tore where neighbours turned different ways.
            var hd = normalize(hang)
            let down = -hd.y
            if down < LIFT {
                let side = vec3(hd.x, 0.0, hd.z)
                let sl = length(side)
                let flat = if sl > 1.0e-4 { side / sl } else { vec3(0.0, 0.0, -1.0) }
                hd = flat * sqrt(1.0 - LIFT * LIFT) - vec3(0.0, LIFT, 0.0)
            }
            q = mix(q, anchor + hd * rod, reach)
        }
        let out = vec3(q.x - mid.x, 0.0, q.z - mid.z)
        let dir = if length(out) > 1.0e-4 { normalize(out) } else { vec3(0.0, 0.0, -1.0) }
        for side in 0..2 {
            for k in 0..3 {
                let a = if k == 0 { hip[side] } else if k == 1 { knee[side] } else { heel[side] }
                let b = if k == 0 { knee[side] } else if k == 1 { ankle[side] } else { toe[side] }
                let ra = if k == 0 { 0.135 } else if k == 1 { 0.125 } else { 0.11 }
                let rb = if k == 0 { 0.125 } else if k == 1 { 0.22 } else { 0.10 }
                let e = b - a
                let qm = q - dir * th
                let h = clamp(dot(qm - a, e) / dot(e, e), 0.0, 1.0)
                let d = length(qm - (a + e * h))
                let r = mix(ra, rb, h) + 0.021
                // Less however far in it the point already is at rest, so the capsules can be as
                // fat as his baggy trousers without pushing the cloth out where it hangs at rest.
                let sx = if side == 0 { 1.0 } else { -1.0 }
                let ar = if k == 0 { vec3(0.114 * sx, 0.971, -0.036) } else if k == 1 {
                    vec3(0.114 * sx, 0.542, -0.036)
                } else { vec3(0.124 * sx, 0.065, -0.13) }
                let br = if k == 0 { vec3(0.114 * sx, 0.542, -0.036) } else if k == 1 {
                    vec3(0.114 * sx, 0.086, -0.088)
                } else { vec3(0.124 * sx, 0.055, 0.14) }
                let er = br - ar
                let hr = clamp(dot(rest_mid - ar, er) / dot(er, er), 0.0, 1.0)
                let dr = length(rest_mid - (ar + er * hr))
                // Eased in over a centimetre either side, so neighbours aren't pulled apart.
                let x = r - d - max(mix(ra, rb, hr) + 0.021 - dr, 0.0)
                let push = (0.5 * (x + sqrt(x * x + 0.0004)) - 0.002) * reach
                if push > 0.0 {
                    q = q + dir * push
                }
            }
        }
        // Off his forearms and hands, straight out from each (they're outside the cloth: it
        // gives way under them).
        for side in 0..2 {
            for k in 0..2 {
                let a = if k == 0 { elbow[side] } else { wrist[side] }
                let b = if k == 0 { wrist[side] } else { knuckle[side] }
                let ra = if k == 0 { 0.055 } else { 0.042 }
                let rb = if k == 0 { 0.042 } else { 0.045 }
                let e = b - a
                // From the cloth's middle too, so lining and face are pushed the same way.
                let qm = q - dir * th
                let h = clamp(dot(qm - a, e) / dot(e, e), 0.0, 1.0)
                let off = qm - (a + e * h)
                let d = length(off)
                let r = mix(ra, rb, h) + 0.008
                let x = r - d
                let push = (0.5 * (x + sqrt(x * x + 0.0004)) - 0.002) * reach
                if push > 0.0 && d > 1.0e-5 {
                    q = q + off / d * push
                }
            }
        }
    }
    q
}

/// A point of the tails (`now`, posed) left trailing toward where it was a moment ago (`then`):
/// the cloth's weight, so it swings after his legs and hips rather than moving as one with them.
/// None at its top, most at the hem.
pub fn trailed(now: vec3, then: vec3, rest: vec3) -> vec3 {
    let u = clamp((TAILS_TOP - rest.y) / 0.45, 0.0, 1.0)
    let back = then - now
    let l = length(back)
    let capped = if l > 0.15 { back * (0.15 / l) } else { back }
    now + capped * 0.85 * u * u
}

/// The cosine of the furthest the tails swing up off hanging straight down (55°).
const LIFT: f32 = 0.574

/// Where the tails' rods hang from (his rest height).
const TAILS_TOP: f32 = 0.97

@test
fn the_tails_hang_back_in_the_air_he_runs_through() {
    // The middle of the tails' hem behind him, as he stands at rest: where his hips carry it
    // in still air, and at a run's 4 m/s swung back and up about where it hangs from, by a
    // fifth of a metre and more.
    let same = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    let palette = [same; 64]
    let hem = drape_node(DRAPE_COLS / 2, DRAPE_ROWS - 1)
    let top = drape_node(DRAPE_COLS / 2, 0)
    let standing = hung(hem, top, palette, 0, 0.0)
    assert(length(standing - hem) < 0.0001)
    let running = hung(hem, top, palette, 0, 4.0)
    assert(running.z < standing.z - 0.15 && running.y > standing.y, f"{running.z - standing.z}")
    // At a walk it hardly stirs.
    let walking = hung(hem, top, palette, 0, 1.4)
    assert(length(walking - standing) < 0.04)
}

@test
fn the_tails_shape_keeps_its_length_from_a_lifted_thighs_joint() {
    // His right thigh lifted square to his hips (a quarter turn about its joint, his knee
    // forward): a point of the tails over that thigh, a third of a metre under its joint.
    let same = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    let joint = vec3(-THIGH_JOINT.x, THIGH_JOINT.y, THIGH_JOINT.z)
    // (About +x through the joint, by -90°: down goes to ahead.)
    let lifted = mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 0.0, -1.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, joint.y - joint.z, joint.z + joint.y, 1.0),
    )
    assert(length((lifted * vec4(joint, 1.0)).xyz - joint) < 1.0e-5)
    assert(
        length(
            (lifted * vec4(joint - vec3(0.0, 0.3, 0.0), 1.0)).xyz - (joint + vec3(0.0, 0.0, 0.3)),
        ) <
            1.0e-5,
    )
    var palette = [same; 64]
    palette[19] = lifted
    let rest = vec3(-0.16, 0.64, 0.05)
    let (_, bits) = tails_weights(rest)
    let share = Unorm8x4 { bits }.decode().z
    assert(share > 0.15, f"the thigh's share is {share}")
    // Carried, it's as far from the joint as at rest, and turned that share of the quarter
    // turn; a share of the way to where the thigh would take it is nearer the joint.
    let far = length(rest - joint)
    let carried = tails_carried(rest, palette, 0)
    assert(abs(length(carried - joint) - far) < 1.0e-4, f"{length(carried - joint)} of {far}")
    let turn = acos(dot(normalize(carried - joint), normalize(rest - joint)))
    assert(abs(turn - share * 1.5707963) < 0.02, f"turned {turn}")
    let skinned = tails_skinned(rest, palette, 0)
    assert(length(skinned - joint) < far * 0.9, f"{length(skinned - joint)} of {far}")
}
