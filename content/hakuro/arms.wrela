// Hakuro's sampled pieces, made as the idol's parts are: the reference body's own surface sampled
// into distance grids (his arms, hands, body and jacket: `*_grid`, engine::sampled), so the
// elbow, the shoulder, the fingers and the muscle between are the sculpt's, not pieces fitted
// to it. Each is realized from its samples, then skinned by the reference rig's own weights
// round it (`*_weights`, `skinning`), every finger joint, so he bends where and as it does.

use arm_left_grid
use arm_left_weights
use arm_right_grid
use arm_right_weights
use body_grid
use body_weights
use hand_left_grid
use hand_left_weights
use hand_right_grid
use hand_right_weights
use jacket_grid
use skinning::{WeightTables, Weights, weights_at}
use engine::realize::{BLOCK, Mesh, SkinVertex, Tally}
use engine::realize::corner_offset
use engine::sampled::{BLOCK_WORDS, Lattice, STORED, Samples, realize_sampled}
use std::gpu::{GlobalId, Slots, dispatch}

/// The skeleton's bone numbers (`hakuro::skeleton` adds them in this order: the trunk, then
/// each pair left and right).
const B_UPPER: u32 = 8
const B_HAND: u32 = 12

/// The samples' distance at `p` (as `engine::sampled::Samples::distance`, on the GPU).
fn sampled_at(l: Lattice, slots: [u32], words: [u32], p: vec3) -> f32 {
    let n = vec3(l.size * BLOCK)
    let q = clamp((p - l.origin) / l.cell, vec3(0.0), n - vec3(0.001))
    let c = vec3u(q)
    let f = q - vec3(c)
    let b = c / BLOCK
    let slot = slots[b.x + l.size.x * (b.y + l.size.y * b.z)]
    if slot < STORED {
        return if slot == 0 { l.band } else { -l.band }
    }
    let base = (slot - STORED) * BLOCK_WORDS
    let lc = c - b * BLOCK
    var v = [0.0; 8]
    for j in 0..8 {
        let k = lc + corner_offset(j)
        let i = (k.x * 5 + k.y) * 5 + k.z
        let byte = (words[base + i / 4] >> ((i % 4) * 8)) & 255
        v[j] = (f32(byte) / 255.0 - 0.5) * 2.0 * l.band
    }
    mix(
        mix(mix(v[0], v[1], f.x), mix(v[2], v[3], f.x), f.y),
        mix(mix(v[4], v[5], f.x), mix(v[6], v[7], f.x), f.y),
        f.z,
    )
}

/// His arm on `side` (0 left, 1 right) realized from its samples and skinned by the reference's
/// own weights round it.
pub fn arm(side: u32) -> Mesh {
    if side == 0 {
        weighted(arm_left_grid::samples(B_UPPER), arm_left_weights::weights(), reach: 1.5, pull: 0.0)
    } else {
        weighted(arm_right_grid::samples(B_UPPER + 1), arm_right_weights::weights(), reach: 1.5, pull: 0.0)
    }
}

/// His hand on `side`, from inside the forearm's wrap to the fingertips: sampled finer, each
/// finger's joints weighted as the reference's are.
pub fn hand(side: u32) -> Mesh {
    if side == 0 {
        weighted(hand_left_grid::samples(B_HAND), hand_left_weights::weights(), reach: 1.5, pull: 0.0)
    } else {
        weighted(hand_right_grid::samples(B_HAND + 1), hand_right_weights::weights(), reach: 1.5, pull: 0.0)
    }
}

/// Each of a sampled shape's vertices skinned by a weight lattice (`skinning::weights_at`: the
/// reference rig's own), its normal taken over `reach` cells each way.
@compute(64)
pub fn skin_weighted(
    grid: Weights,
    wslots: [u32],
    wwords: [u32],
    reach: f32,
    pull: f32,
    lattice: Lattice,
    slots: [u32],
    words: [u32],
    tally: [Tally],
    verts: mut Slots<SkinVertex>,
    id: GlobalId,
) {
    if id.x >= tally[0].vertices {
        return
    }
    let v = verts[id]
    let found = weights_at(grid, wslots, wwords, v.pos)
    var bones = found.0
    var weights = found.1
    // (A shell hanging clear of him, as his long jacket's back does, is off the lattice's kept
    // blocks: its weights are his body's nearest in, `pull` at a time toward his middle, not
    // the lattice's fallback, his chest, which swung it out as a slab.)
    if pull > 0.0 {
        var q = v.pos
        for _ in 0..8 {
            if !(bones == grid.fallback && weights == 255) {
                break
            }
            let toward = vec3(q.x, 0.0, q.z + 0.02)
            if length(toward) < 1.0e-4 {
                break
            }
            q = q - normalize(toward) * pull
            let again = weights_at(grid, wslots, wwords, q)
            bones = again.0
            weights = again.1
        }
    }
    let e = lattice.cell * reach
    let g = vec3(
        sampled_at(lattice, slots, words, v.pos + vec3(e, 0.0, 0.0)) - sampled_at(lattice, slots, words, v.pos - vec3(e, 0.0, 0.0)),
        sampled_at(lattice, slots, words, v.pos + vec3(0.0, e, 0.0)) - sampled_at(lattice, slots, words, v.pos - vec3(0.0, e, 0.0)),
        sampled_at(lattice, slots, words, v.pos + vec3(0.0, 0.0, e)) - sampled_at(lattice, slots, words, v.pos - vec3(0.0, 0.0, e)),
    )
    let normal = if length(g) > 1.0e-6 { normalize(g) } else { v.normal }
    verts[id] = SkinVertex { pos: v.pos, bones, normal, weights, mask: v.mask }
}

/// A sampled shape of his realized and skinned by a weight lattice.
fn weighted(samples: Samples, tables: WeightTables, reach: f32, pull: f32) -> Mesh {
    let shape = samples.upload()
    let w = tables.upload()
    var mesh = realize_sampled(shape)
    dispatch(
        skin_weighted.bind(
            grid: w.grid,
            wslots: w.slots.items(),
            wwords: w.words.items(),
            reach: reach,
            pull: pull,
            lattice: shape.lattice,
            slots: shape.slots.items(),
            words: shape.samples.items(),
            tally: mesh.tally.items(),
            verts: mesh.verts.items_mut(),
        ),
        groups: mesh.skin.items(),
    )
    mesh
}

// ---- his body ------------------------------------------------------------------------------

/// His trunk, legs and head (`body_grid`) realized from their samples and skinned.
pub fn sampled_body() -> Mesh {
    weighted(body_grid::samples(0), body_weights::weights(), reach: 1.5, pull: 0.0)
}

/// His jacket (`jacket_grid`): its own shell over his shirt, skinned as his body is.
pub fn jacket() -> Mesh {
    // (Its normal taken nearer: the shell is only a cell or two thick, and further off the
    // samples would reach through it to its other face.)
    weighted(jacket_grid::samples(0), body_weights::weights(), reach: 0.8, pull: 0.012)
}

// ---- his coat's tails ----------------------------------------------------------------------

/// Each of the tails' vertices on his hips and thighs: a coat's skirt hangs from the hips but
/// its lower part goes where his legs push it, the side over each leg mostly with that leg.
/// (The tails' field binds them to the pelvis whole; under a stride or a fighting stance his
/// thighs went through the cloth.)
pub fn tails_weights(p: vec3) -> (u32, u32) {
    // How far down the tails (from their top under the jacket's hem to about the knee).
    let t = clamp((0.98 - p.y) / 0.36, 0.0, 1.0)
    let share = 0.75 * t * t * (3.0 - 2.0 * t)
    // Over which leg: his left (+x) or right, both across the middle of his back.
    // (Sharply: the back vent parts them, each side with its own leg.)
    let lean = clamp(p.x / 0.035, -1.0, 1.0)
    var left = share * (0.5 + 0.5 * lean)
    var right = share - left
    // (Their hem, below the knee, partly carried by the nearer shin, so a heel kicked up behind
    // him lifts it rather than coming out through it.)
    let u = clamp((0.74 - p.y) / 0.24, 0.0, 1.0)
    let low = 0.6 * u * u * (3.0 - 2.0 * u)
    var shin = 0.0
    if p.x >= 0.0 {
        shin = left * low
        left -= shin
    } else {
        shin = right * low
        right -= shin
    }
    let sb: u32 = if p.x >= 0.0 { 20 } else { 21 }
    let wl = u32(round(left * 255.0))
    let wr = u32(round(right * 255.0))
    let ws = u32(round(shin * 255.0))
    let w0 = 255 - min(wl + wr + ws, 255)
    (0 | (18 << 8) | (19 << 16) | (sb << 24), w0 | (wl << 8) | (wr << 16) | (ws << 24))
}

@compute(64)
pub fn skin_tails(tally: [Tally], verts: mut Slots<SkinVertex>, id: GlobalId) {
    if id.x >= tally[0].vertices {
        return
    }
    let v = verts[id]
    let (bones, weights) = tails_weights(v.pos)
    verts[id] = SkinVertex { pos: v.pos, bones, normal: v.normal, weights, mask: v.mask }
}

/// His coat's tails (`hakuro::coat`, realized) made to follow his legs (`tails_weights`).
pub fn follow_legs(mesh: take Mesh) -> Mesh {
    var m = take mesh
    dispatch(
        skin_tails.bind(tally: m.tally.items(), verts: m.verts.items_mut()),
        groups: m.skin.items(),
    )
    m
}

/// `p` (a point of his coat's tails, posed) draped over his legs, posed as `palette` (from
/// `first`) has them. Each thigh, shin and boot is a tapered capsule round him, and the cloth is
/// kept a centimetre off them, pushed out from his middle. Each point hangs on a rod from the
/// tails' top above it, so a point pushed out swings up over the leg instead of being pierced
/// by it: a heel kicked up behind him lifts the hem over it. (Skinning to the thighs and shins
/// alone left a kicked leg or a knee coming through.)
pub fn off_legs(p: vec3, rest: vec3, palette: [mat4], first: u32) -> vec3 {
    var q = p
    // (Not at all up under his belt, where the tails hang from his hips: the thighs' tops pushed
    // there pinched the cloth into dark folds.)
    let u = clamp((0.84 - rest.y) / 0.1, 0.0, 1.0)
    let reach = u * u * (3.0 - 2.0 * u)
    if reach <= 0.0 {
        return q
    }
    // Its rod: from the tails' top straight above it at rest (carried by his hips), as long as at
    // rest; and his middle, between his hips, to push out from.
    let anchor = (palette[first] * vec4(rest.x, TAILS_TOP, rest.z, 1.0)).xyz
    let rod = TAILS_TOP - rest.y
    let mid = ((palette[first + 18] * vec4(0.114, 0.971, -0.036, 1.0)).xyz +
        (palette[first + 19] * vec4(-0.114, 0.971, -0.036, 1.0)).xyz) * 0.5
    var hip = [vec3(0.0); 2]
    var knee = [vec3(0.0); 2]
    var ankle = [vec3(0.0); 2]
    var heel = [vec3(0.0); 2]
    var toe = [vec3(0.0); 2]
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        hip[side] = (palette[first + 18 + side] * vec4(0.114 * sx, 0.971, -0.036, 1.0)).xyz
        knee[side] = (palette[first + 20 + side] * vec4(0.114 * sx, 0.542, -0.036, 1.0)).xyz
        ankle[side] = (palette[first + 22 + side] * vec4(0.114 * sx, 0.086, -0.088, 1.0)).xyz
        heel[side] = (palette[first + 22 + side] * vec4(0.124 * sx, 0.065, -0.13, 1.0)).xyz
        toe[side] = (palette[first + 22 + side] * vec4(0.124 * sx, 0.055, 0.14, 1.0)).xyz
    }
    // His forearms and hands, whose swing passes the tails' sides.
    var elbow = [vec3(0.0); 2]
    var wrist = [vec3(0.0); 2]
    var knuckle = [vec3(0.0); 2]
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        elbow[side] = (palette[first + 10 + side] * vec4(0.463 * sx, 1.455, -0.073, 1.0)).xyz
        wrist[side] = (palette[first + 12 + side] * vec4(0.706 * sx, 1.455, -0.065, 1.0)).xyz
        knuckle[side] = (palette[first + 12 + side] * vec4(0.86 * sx, 1.45, -0.05, 1.0)).xyz
    }
    for _ in 0..6 {
        // On its rod (only where it hangs: none up under his belt), then out of his legs, last,
        // so whatever the rod leaves undone it's never left inside one.
        let hang = q - anchor
        if length(hang) > 1.0e-4 && rod > 0.0 {
            q = mix(q, anchor + normalize(hang) * rod, reach)
        }
        let out = vec3(q.x - mid.x, 0.0, q.z - mid.z)
        let dir = if length(out) > 1.0e-4 { normalize(out) } else { vec3(0.0, 0.0, -1.0) }
        for side in 0..2 {
            for k in 0..3 {
                let a = if k == 0 { hip[side] } else if k == 1 { knee[side] } else { heel[side] }
                let b = if k == 0 { knee[side] } else if k == 1 { ankle[side] } else { toe[side] }
                let ra = if k == 0 { 0.125 } else if k == 1 { 0.11 } else { 0.085 }
                let rb = if k == 0 { 0.11 } else if k == 1 { 0.115 } else { 0.075 }
                let e = b - a
                let h = clamp(dot(q - a, e) / dot(e, e), 0.0, 1.0)
                let d = length(q - (a + e * h))
                let r = mix(ra, rb, h) + 0.012
                // Eased in over a centimetre either side, so neighbours aren't pulled apart.
                let x = r - d
                let push = (0.5 * (x + sqrt(x * x + 0.0004)) - 0.002) * reach
                if push > 0.0 {
                    q = q + dir * push
                }
            }
        }
        // Off his forearms and hands, straight out from each (they're outside the cloth: it
        // gives way under them).
        for side in 0..2 {
            for k in 0..2 {
                let a = if k == 0 { elbow[side] } else { wrist[side] }
                let b = if k == 0 { wrist[side] } else { knuckle[side] }
                let ra = if k == 0 { 0.055 } else { 0.042 }
                let rb = if k == 0 { 0.042 } else { 0.045 }
                let e = b - a
                let h = clamp(dot(q - a, e) / dot(e, e), 0.0, 1.0)
                let off = q - (a + e * h)
                let d = length(off)
                let r = mix(ra, rb, h) + 0.008
                let x = r - d
                let push = (0.5 * (x + sqrt(x * x + 0.0004)) - 0.002) * reach
                if push > 0.0 && d > 1.0e-5 {
                    q = q + off / d * push
                }
            }
        }
    }
    q
}

/// A point of the tails (`now`, posed) left trailing toward where it was a moment ago (`then`):
/// the cloth's weight, so it swings after his legs and hips rather than moving as one with them.
/// None at its top, most at the hem.
pub fn trailed(now: vec3, then: vec3, rest: vec3) -> vec3 {
    let u = clamp((TAILS_TOP - rest.y) / 0.45, 0.0, 1.0)
    let back = then - now
    let l = length(back)
    let capped = if l > 0.15 { back * (0.15 / l) } else { back }
    now + capped * 0.85 * u * u
}

/// Where the tails' rods hang from (his rest height).
const TAILS_TOP: f32 = 0.97
