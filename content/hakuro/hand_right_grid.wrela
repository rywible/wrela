// Hakuro's right hand: the reference body's distance sampled every 2.5 mm (engine::sampled), from inside
// the forearm's gauntlet to the fingertips, dressed as his outfit has it. Written by
// /mnt/project-files/hakuro-fit/hands_grid.py from the reference mesh, which never ships.
// 36 x 17 x 19 blocks of 4 cells, 3005 stored; a sample is a byte, the distance in
// [-BAND, BAND].

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-0.94500, 1.34000, -0.13500)
pub const CELL: f32 = 0.00250
pub const SIZE: vec3u = vec3u(36, 17, 19)
pub const BAND: f32 = 0.00750

/// Its tables (its vertices to bone `bone`, till they're skinned).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

/// Each block's slot (0 outside, 1 inside, 2 + its index stored), x fastest, as base64 words.
