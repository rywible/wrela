// Hakuro's right arm's skin weights: the reference rig's (weights_grids.py).
// 16 x 12 x 9 blocks of 4³ points every 10.0 mm, 441 stored; a point is two words, its four
// bones and their weights, a byte each.

use skinning::{WeightTables, Weights}
use engine::sampled::words_of

/// Its tables.
pub fn weights() -> WeightTables {
    let grid = Weights {
        origin: vec3(-0.76000, 1.18000, -0.24000),
        cell: 0.01000,
        size: vec3u(16, 12, 9),
        fallback: 9,
    }
    WeightTables { grid, slots: words_of(SLOTS), words: words_of(WORDS) }
}

