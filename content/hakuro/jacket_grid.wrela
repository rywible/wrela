// Hakuro's jacket: a shell 11 mm thick lying 24 mm off his smoothed body, hanging straight from his chest, open down the front,
// at the armholes, the hem and its collar's top, sampled every 5.0 mm (engine::sampled). Written by
// /mnt/project-files/hakuro-fit/jacket_grid.py from the reference mesh, which never ships.
// 32 x 46 x 25 blocks of 4 cells, 7002 stored; a sample is a byte, the distance in
// [-BAND, BAND].

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-0.32000, 0.75000, -0.27000)
pub const CELL: f32 = 0.00500
pub const SIZE: vec3u = vec3u(32, 46, 25)
pub const BAND: f32 = 0.01000

/// Its tables (its vertices to bone `bone`, till they're skinned).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

/// Each block's slot (0 outside, 1 inside, 2 + its index stored), x fastest, as base64 words.
