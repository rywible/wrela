// Hakuro's left hand's skin weights: the reference rig's, every finger joint (hands_grid.py).
// 23 x 11 x 12 blocks of 4³ points every 4.0 mm, 1035 stored; a point is two words, its four
// bones and their weights, a byte each.

use skinning::{WeightTables, Weights}
use engine::sampled::words_of

/// Its tables.
pub fn weights() -> WeightTables {
    let grid = Weights {
        origin: vec3(0.59100, 1.34100, -0.13400),
        cell: 0.00400,
        size: vec3u(23, 11, 12),
        fallback: 12,
    }
    WeightTables { grid, slots: words_of(SLOTS), words: words_of(WORDS) }
}

