/// The body's paint at `p` (rest space), his clothes by region as the locked outfit has them.
pub fn body_paint(p: vec3) -> Cloth {
    worn_under(p, 0.0005)
}

// ---- what his clothes are made of -------------------------------------------------------------
//
// Each cloth is its colour and its relief at a point of him at rest: its weave, its seams and
// their stitches, its pockets and its ribs. `px` is how much of him a pixel covers there (m):
// a line is drawn a pixel soft, and a pattern finer than two pixels isn't drawn at all (it
// would shimmer).

/// How much of a line `w` wide (m) a point `d` from its middle is in.
fn stripe(d: f32, w: f32, px: f32) -> f32 {
    saturate((0.5 * w - abs(d)) / max(px, 0.0003) + 0.5)
}

/// How much of a pattern that repeats every `period` (m) is drawn: all of it from eight
/// pixels a repeat, none of it at four. (Drawn down to two pixels a repeat, a weave's threads
/// beat against the pixels in rings across his chest.)
fn fine(period: f32, px: f32) -> f32 {
    saturate(0.25 * period / max(px, 0.00001) - 1.0)
}

/// A sewn seam `d` from its line (m), `along` it (m): a welt 11 mm wide with a groove down its
/// middle (`x`: its relief, m) and a row of stitches either side of the groove (`y`: how much
/// of the point is thread).
fn seam(d: f32, along: f32, px: f32) -> vec2 {
    let dash = if fract(along / 0.008) < 0.62 { fine(0.008, px) } else { 0.0 }
    vec2(
        0.0009 * stripe(d, 0.011, px) - 0.0012 * stripe(d, 0.003, px),
        (stripe(d - 0.0045, 0.0013, px) + stripe(d + 0.0045, 0.0013, px)) * dash,
    )
}

/// `base` with a seam's relief and thread on it (`seam`'s answer, or several added).
fn sewn(base: Cloth, on: vec2) -> Cloth {
    Cloth {
        albedo: mix(base.albedo, THREAD, vec3(saturate(on.y) * 0.85)),
        relief: base.relief + on.x,
        ..base,
    }
}

/// How far outside a box `half` wide and high about `at` a point of a flat piece is (m;
/// negative inside).
fn boxed(q: vec2, at: vec2, half: vec2) -> f32 {
    let d = abs(q - at) - half
    max(d.x, d.y)
}

/// His trousers at a point of them at rest (his legs', and his trunk's under his belt):
/// charcoal twill combat trousers. A seam down the outside of each leg; a bellows pocket on
/// each thigh with a flap and a gold snap; a knee's panel between two seams, pleated to bend;
/// the cloth gathered into his boots; a fly and a waistband under his belt.
fn trousers_at(p: vec3, px: f32) -> Cloth {
    // About his leg's line: how far round from its front (0; a quarter turn its outside).
    let za = if p.y > 0.542 { -0.036 } else {
        mix(-0.088, -0.036, saturate((p.y - 0.086) / 0.456))
    }
    let out = abs(p.x) - 0.114
    let fore = p.z - za
    let phi = atan2(out, fore)
    let leg = p.y < 0.86
    // Its weave, and the cloth's own crumple: long soft folds across the leg, more of them
    // where it's gathered into his boot.
    let girth = phi * max(length(vec2(out, fore)), 0.04)
    var relief = 0.00016 * sin(TAU * (girth + p.y) / 0.0028) * fine(0.0028, px)
    relief += 0.0011 * sin(p.y * 70.0 + 2.2 * sin(phi * 2.0 + p.y * 17.0))
    let gathered = 1.0 - smoothstep(0.34, 0.45, p.y)
    relief += 0.0020 * gathered * sin(phi * 15.0 + 3.0 * sin(p.y * 40.0))
    var on = vec2(0.0)
    // Down its outside.
    if out > 0.0 {
        on += seam(fore, p.y, px)
    }
    var cloth = TROUSERS
    if leg {
        // His knee's panel, on the front of his leg.
        let front = smoothstep(-0.03, 0.01, fore)
        on += (seam(p.y - 0.615, girth, px) + seam(p.y - 0.468, girth, px)) * front
        for k in 0..3 {
            relief -= 0.0009 * front * stripe(p.y - (0.578 - 0.037 * f32(k)), 0.004, px)
        }
        // His thigh's pocket, on its outside: the pocket standing off his leg, its flap over
        // its top, a snap on the flap.
        if out > 0.0 {
            let q = vec2(fore, p.y)
            let pocket = boxed(q, vec2(0.0, 0.672), vec2(0.052, 0.078))
            let flap = boxed(q, vec2(0.0, 0.752), vec2(0.056, 0.022))
            relief += 0.0028 * saturate(-pocket / 0.004) + 0.0020 * saturate(-flap / 0.003)
            on.y += stripe(pocket + 0.006, 0.0013, px) *
                fine(0.008, px) *
                (if fract((q.x + q.y) / 0.008) < 0.62 { 1.0 } else { 0.0 })
            // (Under the flap's edge, its shadow.)
            let under = stripe(q.y - 0.727, 0.004, px) * saturate(-pocket / 0.004)
            cloth = Cloth { albedo: cloth.albedo * (1.0 - 0.55 * under), ..cloth }
            if length(q - vec2(0.0, 0.745)) < 0.0065 {
                return Cloth { relief: 0.0045, ..GOLD }
            }
        }
    } else {
        // Under his belt: its waistband, and its fly down his front.
        on += seam(p.y - 0.944, girth, px)
        if p.z > 0.0 {
            on += seam(p.x - 0.014, p.y, px) * smoothstep(0.944, 0.93, p.y)
        }
    }
    sewn(Cloth { relief, ..cloth }, on)
}

/// How far from the line from `a` to `b` a point of a flat piece is (m), and how far along it.
fn along_line(q: vec2, a: vec2, b: vec2) -> vec2 {
    let e = b - a
    let h = clamp(dot(q - a, e) / dot(e, e), 0.0, 1.0)
    vec2(length(q - (a + e * h)), h * length(e))
}

/// A flat-locked seam of his top `d` from its line: a low flat welt, its thread laid across
/// it in a ladder.
fn flatlock(d: f32, along: f32, px: f32) -> vec2 {
    let ladder = 0.5 + 0.5 * sin(TAU * along / 0.0032)
    vec2(0.0005 * stripe(d, 0.007, px), stripe(d, 0.0055, px) * mix(0.45, ladder, fine(0.0032, px)))
}

/// Where his top's neckline is at a point round his neck (rest height): a crew neck, at the
/// root of his neck, lower at his throat than behind.
pub fn neckline(p: vec3) -> f32 {
    1.497 + 0.028 * smoothstep(0.03, -0.06, p.z)
}

/// How wide the band round his top's neck is (m).
const NECKBAND: f32 = 0.013

/// His top at a point of it at rest (his trunk's over his belt, his right arm's): a black
/// compression knit, close as a skin and smoother than his jacket. Flat-locked seams from
/// his neck to under each arm and down each side; round its neck a ribbed band.
fn top_at(p: vec3, px: f32) -> Cloth {
    // Its knit's courses.
    var relief = 0.00010 * sin(TAU * p.y / 0.0018) * fine(0.0018, px)
    var on = vec2(0.0)
    let under = neckline(p) - p.y
    if abs(p.x) < 0.1 && under < NECKBAND {
        // Its neckband: ribs across it, standing a little off his skin, a seam under it.
        let round = atan2(p.x, p.z + 0.03)
        let ribs = fine(0.006, px)
        let across = under / NECKBAND * 2.0 - 1.0
        return Cloth {
            albedo: TOP.albedo * (1.0 + 0.5 * ribs * sin(round * 60.0)),
            relief: 0.0016 * sqrt(max(1.0 - across * across, 0.0)) +
                0.0005 * sin(round * 60.0) * ribs,
            ..TOP,
        }
    }
    if p.x < -0.2 {
        // His right arm's sleeve: one seam, under his arm.
        if p.y < 1.455 {
            on += flatlock(p.z + 0.068, p.x, px)
        }
    } else {
        // From his neck to under each arm, and down each side.
        let q = vec2(abs(p.x), p.y)
        let raglan = along_line(q, vec2(0.052, 1.495), vec2(0.176, 1.335))
        on += flatlock(raglan.x, raglan.y, px)
        if abs(p.x) > 0.09 && p.y < 1.33 {
            on += flatlock(p.z + 0.012, p.y, px)
        }
    }
    Cloth {
        albedo: mix(TOP.albedo, THREAD * 0.6, vec3(saturate(on.y) * 0.8)),
        relief: relief + on.x,
        ..TOP,
    }
}

/// What he wears under his coat at a point of him at rest, and what he doesn't: his trousers
/// to his belt, his top over it to its neckline, and his neck bare above that.
fn worn_under(p: vec3, px: f32) -> Cloth {
    if p.y < 0.97 {
        return trousers_at(p, px)
    }
    // (His neck, between his shoulders: his top's sleeve and shoulders are as high.)
    if abs(p.x) > 0.1 || p.y < neckline(p) {
        return top_at(p, px)
    }
    // (His head's wrap comes down his nape as a hairline does: to 4 cm under the foot of
    // his skull behind, and up to his jaw's corners at his sides.)
    if p.y > nape(p) {
        return Cloth { relief: 0.0012 * stripe(p.y - nape(p) - 0.004, 0.008, px), ..WRAP }
    }
    // His neck's skin, in his jaw's shade under his chin.
    let shade = mix(0.6, 1.0, smoothstep(1.6, 1.555, p.y))
    Cloth { albedo: SKIN.albedo * mix(1.0, shade, smoothstep(-0.03, 0.03, p.z)), ..SKIN }
}

/// How low his head's wrap comes on his neck at a point round it (rest height): to his nape
/// behind, rising to his jaw's corners at his sides, and nowhere on his throat.
pub fn nape(p: vec3) -> f32 {
    1.607 + 0.06 * smoothstep(-0.06, 0.01, p.z)
}

/// The wrap round his head, under his mask and his hair, at a point of his head at rest. It
/// covers his head whole, to under his chin and to the foot of his skull, so his head is a
/// head over his bare neck and his mask sits on it. (With his nape bare to his hairline and
/// his cheeks bare under it, his head read as more neck, and his mask as hung in front of
/// it.) Round it, his mask's cord.
fn wrapped_head(p: vec3, px: f32) -> Cloth {
    // (Behind his mask, a dark void.)
    if p.y > 1.607 && p.z > 0.02 {
        return VOID
    }
    // His mask's cord: from its sides at his eyes' height, back and down round his head.
    let cord = abs(p.y - (1.712 + 0.3 * p.z)) - 0.0045
    if cord < 0.0 && p.z < 0.04 {
        return Cloth {
            albedo: CORD,
            rough: 0.6,
            relief: 0.002 * sqrt(saturate(-cord / 0.0045)),
            ..WRAP,
        }
    }
    WRAP
}

/// His coat's cloth at a point of it at rest, `e` outside its front opening (`opening`): a
/// matte black twill, its edge bound in gold, a row of stitches inside the binding. Seams
/// down its back and its sides and across its shoulders.
fn coat_at(p: vec3, e: f32, px: f32) -> Cloth {
    if e < TRIM {
        // (The binding: a rounded welt.)
        let across = (e / TRIM) * 2.0 - 1.0
        return Cloth { relief: 0.0016 * sqrt(max(1.0 - across * across, 0.0)), ..GOLD }
    }
    let relief = 0.00018 * sin(TAU * (p.x + p.z + p.y) / 0.003) * fine(0.003, px)
    var on = vec2(0.0, stripe(e - TRIM - 0.004, 0.0013, px) * (if fract(p.y / 0.008) < 0.62 {
        fine(0.008, px)
    } else { 0.0 }))
    if p.z < -0.02 {
        // Across its shoulders: its back's yoke. Under that its back is one piece to its
        // hem. (A seam down the middle of its back and one down each side, each stopping at
        // his waist where the tails carry on, and a seam round his waist: his coat's back
        // read as a jacket with a skirt sewn on, two pieces and not one.)
        on += seam(p.y - 1.405, p.x, px)
    }
    sewn(Cloth { relief, ..BLACK }, on)
}

/// How far outside his jacket's front opening a point of him at rest is (m; negative: in the
/// opening). The jacket hangs open from its collar to its hem: a hand's width at his throat,
/// widening down to where his coat's tails' front edges hang (`shapes::TAILS_FROM`, 12 cm
/// either side of his middle), and straight down from there. One line from collar to the
/// tails' hem: the opening was a slanted slot that stopped at his belt, with the jacket closed
/// across his hips under it, and its gold edges read as a sweatshirt's cords.
pub fn opening(p: vec3) -> f32 {
    if p.z <= 0.0 {
        return 1.0
    }
    let t = clamp((1.50 - p.y) / 0.60, 0.0, 1.0)
    // (Over its collar's foot the opening widens again: the collar stands open at his throat.)
    let by_width = abs(p.x) - (0.035 + 0.083 * pow(t, 0.85) + 0.45 * max(p.y - 1.50, 0.0))
    // (By his hips, where the tails' edges are: at their angle about the tails' own axis, so
    // the jacket's edge runs into the tails' whatever the cloth's girth there.)
    let rel = p - shapes::TAILS_AXIS
    let r = length(rel.xz)
    // (Where the jacket lies over the tails' top, at the tails' own edge there, which is
    // cut back from his waist: `shapes::front_edge`.)
    let by_angle = (atan2(abs(rel.x), rel.z) - shapes::front_edge(p.y) * 0.0174532925) * r
    mix(by_angle, by_width, smoothstep(0.93, 1.04, p.y))
}

/// How wide the gold along his jacket's front edges and his tails' is (m).
pub const TRIM: f32 = 0.017

/// His left arm at rest: the figure's arm and what his is over it (`arm_left_form`), about
/// the figure's arm's chain (`figure::chains::arm_left`).
pub const ARM_LEFT: figure::limbs::Form = figure::arm::ARM.plus(arm_left_form::ARM_LEFT_OVER)

/// His right arm at rest, in his jacket's sleeve and his gauntlet: the figure's arm mirrored
/// and what his is over it (`arm_right_form`), about `figure::chains::arm_right`.
pub const ARM_RIGHT: figure::limbs::Form = figure::arm::ARM
    .mirrored()
    .plus(arm_right_form::ARM_RIGHT_OVER)

/// His left leg at rest, in his trousers: the figure's leg and what his is over it
/// (`leg_form`), about `figure::chains::leg_left`. His right is its mirror image.
pub const LEG_LEFT: figure::limbs::Form = figure::leg::LEG.plus(leg_form::LEG_OVER)

/// How many of his parts are drawn along their charts as limbs are, how many of those are his
/// arms' (the first of them), and how many are drawn as his trunk is (a larger form).
pub const CHARTS: u32 = 25
pub const ARM_CHARTS: u32 = 4
pub const WIDE_CHARTS: u32 = 2

/// Where the wrap round his left forearm starts, and the gauntlet over his right, as fractions
/// of an arm's path's length; and how far each stands off the arm under it (m).
pub const WRAP_FROM: f32 = 0.75
pub const GAUNTLET_FROM: f32 = 0.634
pub const WRAP_OVER: f32 = 0.0015

/// Where the wrap and the gauntlet end, as a fraction of an arm's path's length: well inside
/// his palm's own end of each. An arm's path is shorter where his elbow is bent (it cuts the
/// corner), so a fraction of it falls nearer his elbow then: at 0.86 the wrap stopped short of
/// his palm in his guard, and the sky showed between them as a pale crescent in his wristband.
pub const WRAP_TO: f32 = 0.91
pub const GAUNTLET_OVER: f32 = 0.0035

/// His charted limbs. His left arm, bare, and his right, in his jacket's sleeve, each drawn to
/// inside the wrap or the gauntlet at his wrist, where his hand takes over, its root under his
/// jacket. The wrap round his left forearm and the gauntlet over his right: each a layer over
/// its arm's own form, a little off it, on the arm's chain and bones, so it goes where the arm
/// goes and its edge is a real step. His legs, in his trousers, each drawn to inside his boot,
/// its root 6 cm under his trousers' seat (further under than his trunk is, `TRUNK_UNDER`:
/// the root keeps its whole width inside his hip, and nearer than his trunk it showed as a
/// patch at his belt). His neck, its root under his collar. And his head, under
/// his mask and his hair, to his crown: one rigid form on his head's bone, closed under his
/// chin.
pub fn charts() -> [Part<16, 13>; CHARTS] {
    // (Neither arm's root is drawn under his coat: his sleeves are layers on his arms, and
    // his coat's body has nothing where his arms go. Drawn 4 to 7 cm further from the eye
    // than it was, an arm's root hid behind a coat it had passed through, and showed again
    // wherever the eye moved round.)
    let left = figure::limbs::arm(
        ARM_LEFT,
        0,
        [6, 8, 10],
        to: 0.84,
        under: vec2(0.0, 0.1),
    )
    let right = figure::limbs::arm(
        ARM_RIGHT,
        1,
        [7, 9, 11],
        to: 0.84,
        under: vec2(0.0, 0.1),
    )
    let over = |arm: Part<16, 13>, from: f32, by: f32| Part {
        form: arm.form.plus(chart::round(by)),
        band: Band { f: vec2(from, WRAP_TO), theta: arm.band.theta },
        sunk: vec2(0.0, 0.1),
        ..arm,
    }
    // (His coat's shoulder over an arm: a layer on the arm's own form, on the arm's chain and
    // bones, as his wrap and his gauntlet are. See `CAP_OVER`.)
    let cap = |arm: Part<16, 13>| Part {
        form: arm.form.plus(chart::round(CAP_OVER)),
        band: Band { f: vec2(0.0, CAP_TO), theta: arm.band.theta },
        sunk: vec2(0.0, 0.1),
        ..arm,
    }
    // (A piece of his jacket about a line `bones` carry: its form `over` off its fitted face.)
    let worn = |line: chart::Chain, bones: [u32; 2], form: Radial<16, 13>, band: vec2, over: f32| Part {
        chain: line,
        bones: [bones[0], bones[1], 0, 0, 0, 0, 0, 0],
        root: bones[0],
        form: form.plus(chart::round(over)),
        changes: [chart::unchanged(); JOINTS],
        band: Band { f: band, theta: vec2(0.0, TAU) },
        sunk: vec2(0.0, 0.1),
    }
    [
        left,
        right,
        over(left, WRAP_FROM, WRAP_OVER),
        over(right, GAUNTLET_FROM, GAUNTLET_OVER),
        figure::limbs::leg(LEG_LEFT, 0, [0, 18, 20], to: 0.78, under: 0.06),
        figure::limbs::leg(LEG_LEFT.mirrored(), 1, [0, 19, 21], to: 0.78, under: 0.06),
        Part {
            chain: figure::chains::neck(),
            bones: [3, 4, 5, 0, 0, 0, 0, 0],
            root: 3,
            form: NECK_FORM,
            changes: [chart::unchanged(); JOINTS],
            band: Band { f: vec2(0.0, 0.9), theta: vec2(0.0, TAU) },
            sunk: vec2(0.03, 0.3),
        },
        Part {
            chain: figure::chains::head(),
            bones: [5, 0, 0, 0, 0, 0, 0, 0],
            root: 5,
            form: HEAD_FORM,
            changes: [chart::unchanged(); JOINTS],
            band: Band { f: vec2(0.0, 0.93), theta: vec2(0.0, TAU) },
            sunk: vec2(0.0, 0.1),
            caps: vec2(HEAD_CAP, 0.0),
        },
        // His jacket's collar and the tops of its shoulders: each one rigid form on a line
        // his chest carries. Past them his coat is his sleeves, layers on his arms
        // (`CAP_OVER`). (On his collarbone, a shoulder's top sheared against the jacket's
        // body whenever his collarbone turned: a ragged patch on his shoulder in his run, a
        // strap standing up in a punch.)
        worn(figure::chains::collar(), [3, 3], COLLAR_FLARED, vec2(0.09, 0.87), 0.0),
        worn(
            figure::chains::yoke_left(),
            [3, 3],
            yoke_left_form::YOKE_LEFT.plus(YOKE_SET),
            vec2(0.07, YOKE_TO),
            0.0,
        ),
        worn(
            figure::chains::yoke_right(),
            [3, 3],
            yoke_right_form::YOKE_RIGHT.plus(YOKE_SET),
            vec2(0.07, YOKE_TO),
            0.0,
        ),
        hand_piece(0, 0),
        hand_piece(0, 1),
        hand_piece(0, 2),
        hand_piece(0, 3),
        hand_piece(0, 4),
        hand_piece(0, 5),
        hand_piece(1, 0),
        hand_piece(1, 1),
        hand_piece(1, 2),
        hand_piece(1, 3),
        hand_piece(1, 4),
        hand_piece(1, 5),
        cap(left),
        cap(right),
    ]
}

/// His coat's sleeves among his charted parts (`charts`' order): his left, his right.
pub const CAP_LEFT: u32 = 23
pub const CAP_RIGHT: u32 = 24

/// His coat's sleeves: how far off his arm each lies (m), how far along his arm's path it
/// goes (to 5 cm past his shoulder's joint: a cap sleeve), and how wide its gold hem is (m).
///
/// Cloth sits on a body because the body holds it up: where his coat lies on a part of him
/// that moves, it is that part's own surface, as he's posed, and the cloth's thickness.
/// Each sleeve is a layer on his arm's own form, all the way round, from where that form
/// begins inside his coat to its hem on his arm: it goes where his arm goes, nothing of him
/// can come through it, and its hem is round his arm in every pose. It comes out through
/// the side of his jacket's body, which has no hole for it and nothing where his arm goes
/// (`jacket_trim`), and is filleted to it there as one cloth (`grown`): where a sleeve
/// leaves the body is where his arm leaves his trunk, wherever his arm is.
///
/// (Each sleeve was a shell of its own shape, carried by his collarbone and his arm, then
/// by his chest: it fitted his shoulder at rest and in no other pose, so his shoulder came
/// through it or it stood where his shoulder had been. And the body had a hole for each
/// arm, cut for an arm held straight out and bound in gold: in any other pose his arm went
/// through the cloth beside the hole.)
pub const CAP_OVER: f32 = 0.007
pub const CAP_TO: f32 = 0.21
pub const CAP_HEM: f32 = 0.012

/// How wide the fillet is where a sleeve leaves his jacket's body (m).
pub const CAP_FILLET: f32 = 0.02

/// How long his arm's path is at rest (m): what a share of it is in metres.
const ARM_LONG: f32 = 0.564

/// How far out from his middle the top of his coat's shoulder is still the piece his chest
/// carries (m): past it, his sleeve (`CAP_OVER`), which comes out from under it.
pub const YOKE_OUT: f32 = 0.165

/// Whether charted part `part` is a sleeve of his coat (`CAP_OVER`).
pub fn of_cap(part: u32) -> bool {
    part == CAP_LEFT || part == CAP_RIGHT
}

/// His hands' pieces among his charted parts: his left's six (his four fingers from his index,
/// his thumb, his palm), then his right's.
pub const HAND_LEFT: u32 = 11
pub const HAND_PIECES: u32 = 6

/// How much of a finger's path its tip closes over (`Part::caps`): from where the forms tool
/// stops reading it (`studio/forms`' `hand_spec`).
pub const TIP_CAP: f32 = 0.12

/// How much of a finger's path its root closes over, inside his palm.
pub const ROOT_CAP: f32 = 0.1

/// How much of his palm's path its end closes over, up to his knuckles' line.
pub const PALM_CAP: f32 = 0.1

/// The first of his hand's pieces on `side` among his charted parts (`HAND_PIECES` of them).
pub fn hand_first(side: u32) -> u32 {
    HAND_LEFT + side * HAND_PIECES
}

/// How far under his palm a finger's root is drawn (m), and under his arm's end his palm's.
pub const FINGER_UNDER: f32 = 0.004

/// Piece `i` of his hand on `side` (0 left, 1 right; `HAND_PIECES`' order) as a charted part.
/// A finger: on its own line (`hands::finger_left`), its bones his hand and the finger's three
/// joints' (bones 26 on, a pair a joint), its tip closed, its root under his palm. His palm:
/// on his forearm and his hand, bending at his wrist, closed at his knuckles, its root under
/// his arm's end.
fn hand_piece(side: u32, i: u32) -> Part<16, 13> {
    let left = side == 0
    let forms = if left {
        [
            index_left_form::INDEX_LEFT,
            middle_left_form::MIDDLE_LEFT,
            ring_left_form::RING_LEFT,
            little_left_form::LITTLE_LEFT,
            thumb_left_form::THUMB_LEFT,
            palm_left_form::PALM_LEFT,
        ]
    } else {
        [
            index_right_form::INDEX_RIGHT,
            middle_right_form::MIDDLE_RIGHT,
            ring_right_form::RING_RIGHT,
            little_right_form::LITTLE_RIGHT,
            thumb_right_form::THUMB_RIGHT,
            palm_right_form::PALM_RIGHT,
        ]
    }
    let hand = 12 + side
    if i == 5 {
        return Part {
            chain: if left { hands::palm_left() } else { hands::palm_right() },
            bones: [10 + side, hand, 0, 0, 0, 0, 0, 0],
            root: 10 + side,
            form: forms[5],
            changes: [chart::unchanged(); JOINTS],
            band: Band { f: vec2(0.0, 1.0), theta: vec2(0.0, TAU) },
            // (Its root under his arm's end and what's over it there.)
            sunk: vec2(0.006, 0.12),
            caps: vec2(0.0, PALM_CAP),
        }
    }
    let first = 26 + 6 * i + side
    Part {
        chain: if left { hands::finger_left(i) } else { hands::finger_right(i) },
        bones: [hand, first, first + 2, first + 4, 0, 0, 0, 0],
        root: hand,
        form: forms[i],
        changes: [chart::unchanged(); JOINTS],
        band: Band { f: vec2(0.0, 1.0), theta: vec2(0.0, TAU) },
        // (His fingers' roots aren't drawn under his palm: their knuckles stand on the back
        // of his hand. His thumb's is, by 2 mm as far as its first joint: there it lies on
        // his palm's own surface, and level with it the two met in a ragged line. Each root
        // closes inside his palm: open, the ball of his thumb showed its cut rim.)
        sunk: if i == 4 { vec2(0.002, 0.5) } else { vec2(0.0, 0.25) },
        caps: vec2(ROOT_CAP, TIP_CAP),
    }
}

/// The charted part that part `part` grows from or lies on (`chart::vertex_onto`), among
/// `charts` and then `wide_charts`: a thumb's is its hand's palm, his head's is his neck, and his jacket's
/// collar and its shoulders lie on its body. `CHARTS + WIDE_CHARTS` for a part that grows from none. (A
/// finger stands on its knuckle as it is: the crease there is the line a fist's knuckles are
/// drawn with, and filleted, a fist at a blow read as "a blunt lump".)
pub fn grows_from(part: u32) -> u32 {
    if (of_jacket(part) && part != JACKET_BODY) || of_cap(part) {
        return JACKET_BODY
    }
    if part == HEAD {
        return NECK
    }
    if !of_hand(part) || (part - HAND_LEFT) % HAND_PIECES != 4 {
        return CHARTS + WIDE_CHARTS
    }
    HAND_LEFT + ((part - HAND_LEFT) / HAND_PIECES) * HAND_PIECES + 5
}

/// His neck and his head among his charted parts (`charts`' order).
pub const NECK: u32 = 6
pub const HEAD: u32 = 7

/// How part `part` grows from what it grows from, or lies on what it lies on
/// (`chart::vertex_onto`). His thumb's root, which no reference was read for, rises from the
/// heel of his hand at the wrist, and the foot of its ball is filleted along his palm as far
/// as the thumb's own knuckle. A piece of his jacket is laid on its body where it's within
/// 12 mm of it and the body is there (`jacket_covers`' first cover is the body's), and lit as
/// the body is over the same 12 mm: the pieces overlap, and each as its own sheet the one
/// stood off the other as a plate with a shade of its own.
/// His head grows from his neck: the back of his skull closes under itself and stood over
/// his bare nape as a ledge, a roll across the back of his neck; filleted 3 cm, the one runs
/// into the other as a nape does.
pub fn grown(part: u32) -> Grown {
    if part == COLLAR {
        return Grown { fillet: 0.012, reach: 9.0, laid: 0.012, cover: 0, beyond: 10.0 }
    }
    if of_jacket(part) {
        return Grown { fillet: 0.012, reach: 9.0, laid: 0.012, cover: 0 }
    }
    if of_cap(part) {
        // (A sleeve comes out of the jacket's body as one cloth with it: filleted 2 cm
        // where it leaves the body's side, and not at all by its hem: filleted there, the
        // hem's ends flared out from his arm as hooks where they came near the body.)
        return Grown { fillet: CAP_FILLET, reach: CAP_TO, cover: 0 }
    }
    if part == HEAD {
        return Grown { fillet: 0.018, reach: 0.55 }
    }
    Grown { fillet: 0.009, reach: 0.8, rooted: 0.2 }
}

/// Whether charted part `part` is a piece of his hand.
pub fn of_hand(part: u32) -> bool {
    part >= HAND_LEFT && part < HAND_LEFT + 2 * HAND_PIECES
}

/// His jacket's pieces among his charted parts (`charts`' order, then `wide_charts`'): its
/// collar, its two shoulders, and its body.
pub const COLLAR: u32 = 8
pub const YOKE_LEFT: u32 = 9
pub const YOKE_RIGHT: u32 = 10
pub const JACKET_BODY: u32 = CHARTS + 1

/// His neck's radius about its line (`figure::chains::neck`: from inside his chest, through
/// his neck's joint and his head's, into his skull), `f` of the way up it and `theta` round
/// (0 his front, a half turn his nape; m). It tapers the whole way: 12 cm across under his
/// jaw, widening down into the slope of his shoulders, least at his throat and most at his
/// sides and behind, a fighter's. Down each side of his throat a muscle stands a little off
/// it, from behind his ear to the notch between his collarbones.
/// (His neck's form was read off the body he was sampled from, which wore a high collar: it
/// was the collar's girth, 17 to 19 cm through, with the collar's folds in it. Under the
/// collar nobody saw it; bare, his neck was as wide as his head, and lumpy. Then a column
/// that widened only at its foot, inside his collar: what showed over the collar was a
/// straight pipe, and read as too long.)
fn neck_radius(f: f32, theta: f32) -> f32 {
    let (front, sides) = (cos(theta), cos(2.0 * theta))
    let top = 0.060 - 0.001 * front - 0.001 * sides
    let base = 0.0915 - 0.011 * front - 0.0105 * sides
    let slope = 1.0 - smoothstep(0.08, 0.86, f)
    // The muscle's line: from 20° off his front at the bottom to 105° off it under his ear.
    let off = abs(wrapped_angle(theta))
    let line = 0.35 + 1.48 * smoothstep(0.15, 0.78, f)
    let muscle = 0.0028 *
        exp(-(off - line) * (off - line) / 0.16) *
        smoothstep(0.12, 0.3, f) *
        (1.0 - smoothstep(0.62, 0.8, f))
    mix(top, base, slope) + muscle
}

/// `a` (radians) as an angle within a half turn of 0.
fn wrapped_angle(a: f32) -> f32 {
    a - TAU * floor(a / TAU + 0.5)
}

/// His head's radius about a line straight up through it (`figure::chains::head`), `f` of
/// the way up and `theta` round (0 his front; m): his skull (`shapes::skull`, scaled as his
/// head is), found from outside in; under his jaw, where there's none, a stub inside his
/// neck. (His head's form was read off the body he was sampled from, which wore a wrap and
/// a high collar: below his cheekbones it was their bulk, as wide and as deep as his skull
/// down to his chin's height. With his neck bare it hung under his mask and over his nape
/// as a ball, and no mask sat right on it.)
fn head_radius(f: f32, theta: f32) -> f32 {
    let y = 1.55 + 0.27 * f
    let (sn, cs) = (sin(theta), cos(theta))
    let at = |r: f32| -> f32 { shapes::skull(unscaled(vec3(r * sn, y, r * cs))) }
    // In from outside, 4 mm at a time, to the first place that's inside; then halved.
    var out = 0.17
    while out > 0.03 && at(out) > 0.0 {
        out -= 0.004
    }
    if out <= 0.03 {
        return 0.03
    }
    var lo = out
    var hi = out + 0.004
    for _ in 0..12 {
        let mid = 0.5 * (lo + hi)
        if at(mid) > 0.0 {
            hi = mid
        } else {
            lo = mid
        }
    }
    0.5 * (lo + hi)
}

/// His head's form (`head_radius`), in a charted form's numbers.
@fuel(2 ** 36)
pub const HEAD_FORM: Radial<16, 13> = chart::of(head_radius)

/// His neck's form (`neck_radius`), in a charted form's numbers.
@fuel(2 ** 36)
pub const NECK_FORM: Radial<16, 13> = chart::of(neck_radius)

/// How far his coat's collar stands out from his neck, `f` of the way up its line (m): none
/// at its foot, 2 cm by its top.
fn collar_flare(f: f32, theta: f32) -> f32 {
    0.02 * smoothstep(0.12, 0.38, f)
}

/// His coat's collar's form: as it was fitted, stood out from his neck toward its top: a
/// coat's collar, standing off his bare neck, and not a second neck. (A constant: worked
/// out where his charts are made, each frame, it was a form fitted twice a frame, and the
/// combat lab's frame went from 11 ms to 81.)
@fuel(2 ** 36)
pub const COLLAR_FLARED: Radial<16, 13> = collar_form::COLLAR.plus(chart::of(collar_flare))

/// How far his jacket's shoulders stand off their fitted face, `f` of the way along a
/// shoulder's line (m): 2 mm over it by his neck, where it lies on the top of his coat's
/// back, down to 3 mm inside it by its seam, so its end lies on his shoulder.
fn yoke_set(f: f32, theta: f32) -> f32 {
    mix(0.002, -0.003, smoothstep(0.15, 0.3, f))
}

/// `yoke_set` in a form's numbers.
@fuel(2 ** 36)
pub const YOKE_SET: Radial<16, 13> = chart::of(yoke_set)

/// How far up his head's path its form closes (of the path's length): its first centimetre
/// and a half, the foot of the stub under his jaw, inside his neck.
pub const HEAD_CAP: f32 = 0.055

/// How far up his trunk's path its form closes at the fork of his legs.
pub const FORK_CAP: f32 = 0.08

/// How much less his trunk's radius is than it was fitted, `f` of the way up its path and
/// `theta` round (m): none to the tops of his shoulders, then in to a stub that ends inside
/// his neck. (Past the root of his neck the fitted form follows nothing: it swells to 18 cm
/// in front. Under the collar's girth his neck used to be drawn at, that was hidden; with
/// his neck its own size it stood out of his throat as a lump when his head went back, and
/// round the foot of his neck as a second, wider neck.)
fn trunk_trim(f: f32, theta: f32) -> f32 {
    let fitted = trunk_form::TRUNK.radius(f: f, theta: theta)
    let stub = 0.056 + 0.008 * cos(theta)
    (stub - fitted) * smoothstep(0.84, 0.925, f)
}

/// His trunk's form: as it was fitted, its top trimmed to end inside his neck
/// (`trunk_trim`).
@fuel(2 ** 38)
pub const TRUNK_FORM: Radial<24, 21> = trunk_form::TRUNK.plus(chart::of(trunk_trim))

/// How far out from his middle his jacket's body's sides are, at most (m, at rest), from his
/// armpits up: 2 cm off his ribs, just inside his shoulders' joints. Lower, a side may be
/// further out by 3 mm for each centimetre under 1.25 m, where his coat hangs clear of him.
pub const BODY_HALF: f32 = 0.197

/// His spine's line at rest, which his trunk and his jacket's body are about.
const SPINE: chart::Path = figure::chains::trunk().rest()

/// How far his jacket's body's fitted form is trimmed, `f` of the way up his spine at angle
/// `theta` (m; 0 or less): in to `BODY_HALF` from his middle.
///
/// The form was fitted to a jacket that had a sleeve's stub for an arm held straight out: at
/// his shoulders its sides ran out to 26 cm from his middle, round behind each shoulder and
/// in front of it, and stood 5 cm off his ribs under his arms. A hole for his arm was cut
/// in that. His arm fitted the hole held straight out and in no other pose: hanging, it lay
/// in the coat's side, and swept back in his run it went through the wing of the coat's back
/// that stood behind his shoulder. The jacket's body is his trunk's own shape and a standoff,
/// with nothing out past where his arm leaves his trunk: his sleeve comes out of its side
/// there (`CAP_OVER`), wherever his arm is.
fn jacket_trim(f: f32, theta: f32) -> f32 {
    let fr = SPINE.frame(saturate(f) * SPINE.length())
    let out = fr.up * cos(theta) + fr.left * sin(theta)
    let run = abs(out.x)
    if run < 0.2 {
        return 0.0
    }
    let fitted = jacket_form::JACKET.radius(f: f, theta: theta)
    // (How far along this way its side is `BODY_HALF` out, at the height it is there.)
    var reach = fitted
    for _ in 0..2 {
        let y = (fr.at + out * reach).y
        reach = min(fitted, (BODY_HALF + 0.3 * max(1.25 - y, 0.0) - abs(fr.at.x)) / run)
    }
    reach - fitted
}

/// His jacket's body's form: as it was fitted, its sides trimmed (`jacket_trim`).
@fuel(2 ** 38)
pub const JACKET_FORM: Radial<24, 21> = jacket_form::JACKET.plus(chart::of(jacket_trim))

/// How far up its path his trunk is drawn: to its end, inside his neck.
pub const TRUNK_TO: f32 = 1.0

/// How far before its path's end his trunk starts to close (of the path's length): from the
/// root of his neck, where his neck's own form has taken over. Left open, its rim stood out
/// from his throat when his head went back, and from his collar's front in his run.
pub const NECK_CAP: f32 = 0.12

/// How far under what he wears his trunk is drawn (m). Set when his jacket was a skinned mesh:
/// the two didn't bend alike, and without this his trunk came through his jacket at his chest
/// and his hip when he leant back from a blow. His jacket's body is now about his trunk's own
/// line; less than this hasn't been tried.
pub const TRUNK_UNDER: f32 = 0.04

/// His charted trunk and the jacket over it, both about his spine (`figure::chains::trunk`),
/// so the charted jacket goes where his trunk goes and can't pass through it. His trunk closes
/// at the fork of his legs and is drawn under what's worn over it.
pub fn wide_charts() -> [Part<24, 21>; WIDE_CHARTS] {
    let on_spine = |form: Radial<24, 21>, band: vec2, cap: vec2, under: f32, coarser: u32| Part {
        chain: figure::chains::trunk(),
        bones: [0, 1, 2, 3, 0, 0, 0, 0],
        root: 0,
        form,
        changes: [chart::unchanged(); JOINTS],
        band: Band { f: band, theta: vec2(0.0, TAU) },
        // (Under what's worn over it the whole way up, not at its root alone.)
        sunk: vec2(under, 3.0),
        caps: cap,
        coarser,
    }
    [
        // (His trunk is under what he wears the whole way: no outline of its own to draw
        // finely.)
        on_spine(
            TRUNK_FORM,
            vec2(0.0, TRUNK_TO),
            vec2(FORK_CAP, NECK_CAP),
            TRUNK_UNDER,
            2,
        ),
        on_spine(JACKET_FORM, vec2(0.03, 1.0), vec2(0.0, 0.0), 0.0, 0),
    ]
}

/// Whether charted part `part` is drawn from both its faces: his jacket's pieces, each an open
/// sheet whose inside shows (inside his collar, from the front; under a lifted hem).
pub fn two_faced(part: u32) -> bool {
    of_jacket(part)
}

/// Whether the inside of charted part `part` can be seen at a point of it (on him at rest):
/// his jacket's body's (at its open front and under its hem) and his collar's where it
/// stands. Not the top of his coat's back and its shoulders, which lie on him. (Each is drawn
/// from both faces; seen edge-on from behind, a shoulder's form's normal tipped away from
/// the eye in patches, and those were painted as its lining: dark ragged shapes on his
/// shoulders that came and went with the view.)
pub fn shows_inside(part: u32, rest: vec3) -> bool {
    part == JACKET_BODY || (part == COLLAR && rest.y > 1.5)
}

/// Whether charted part `part` is a piece of his jacket.
pub fn of_jacket(part: u32) -> bool {
    part == COLLAR || part == YOKE_LEFT || part == YOKE_RIGHT || part == JACKET_BODY
}

/// His charted parts as a pose has them: his limbs and his head (`charts`' order), and his
/// trunk and his jacket (`wide_charts`').
pub struct Charted: Copy {
    pub limbs: [Limb<16, 13>; CHARTS],
    pub wide: [Limb<24, 21>; WIDE_CHARTS],
}

/// His charted parts at rest.
pub fn charted_at_rest() -> Charted {
    let limbs = charts()
    let wide = wide_charts()
    var out = Charted { limbs: [limbs[0].rest(); CHARTS], wide: [wide[0].rest(); WIDE_CHARTS] }
    for k in 0..CHARTS {
        out.limbs[k] = limbs[k].rest()
    }
    for k in 0..WIDE_CHARTS {
        out.wide[k] = wide[k].rest()
    }
    out
}

/// His charted parts as `palette` poses them (each of his bones' matrices, from him at rest to
/// where the pose has him).
pub fn charted_as(palette: [mat4; 64]) -> Charted {
    let limbs = charts()
    let wide = wide_charts()
    var out = charted_at_rest()
    for k in 0..CHARTS {
        out.limbs[k] = limbs[k].posed(palette)
    }
    for k in 0..WIDE_CHARTS {
        out.wide[k] = wide[k].posed(palette)
    }
    out
}

/// How fine the detail round a charted part's path its shading keeps (harmonics): his light's
/// bands are read off his forms without the ripples finer than this (`Radial::softened`). More
/// kept, and dark spots stand inside a highlight.
pub const SHADED_DETAIL: f32 = 3.5

/// What a limb-sized part's pixels read their normals from: its posed form, softened
/// (`SHADED_DETAIL`) and kept to its first 4 harmonics of 6. What's dropped is a twentieth of
/// what it was before softening or less, and a pixel pays for every term.
pub fn shaded(form: Radial<16, 13>) -> Radial<16, 9> {
    form.softened(SHADED_DETAIL).kept()
}

/// What a piece of his hand's pixels read their normals from: its form as it is. A palm is a
/// flat section, which is its even harmonics to the last: softened as a limb is, the back of
/// his open hand was lit as a tube's and read as "a flat, unshaded paddle". And a thumb's ball
/// that rises from his palm (`grown`) is lit there as the palm's side is made, so the palm's
/// own pixels read the same side.
pub fn shaded_hand(form: Radial<16, 13>) -> Radial<16, 13> {
    form
}

/// What his trunk's and his jacket's pixels read their normals from: the posed form softened,
/// kept to its first 5 harmonics of 10.
pub fn shaded_wide(form: Radial<24, 21>) -> Radial<24, 11> {
    form.softened(SHADED_DETAIL).kept()
}

/// Where the wrap round his left forearm ends, at his wrist (his rest space, m along his arm).
pub const WRAP_END: f32 = 0.664

/// The wrap round his left forearm at a point of it at rest: a charcoal cloth band wound
/// round it, each turn rising to its edge and falling back within a fifth of the turn (a
/// step straight down, and the light across it flipped in ragged black marks).
fn wrap_at(rest: vec3, px: f32) -> Cloth {
    let turn = fract((rest.x - 0.565) / 0.022)
    let rise = smoothstep(0.0, 0.8, turn) * (1.0 - smoothstep(0.8, 1.0, turn))
    Cloth { relief: 0.0009 * rise * fine(0.022, px), ..CHARCOAL }
}

/// How far out from his middle the top of his coat's back, under his collar's foot, is his
/// collar's piece's (m): past it, a shoulder's. A shoulder starts 1.5 cm inside this and
/// stands 2 mm over it there, so its edge is a seam's step.
pub const SHELF_OUT: f32 = 0.13

/// How far round its line from straight up a shoulder of his coat reaches, front and back
/// (radians): to 2 cm over the height of its line. Lower, in front and behind, his coat is
/// its body's alone.
pub const YOKE_ROUND: f32 = 1.25

/// How far along a shoulder's path it's drawn (of the path's length: his shoulder's joint is
/// 0.33 of the way, its seam a little past it).
const YOKE_TO: f32 = 0.4

/// What charted part `part` is made of at a point of it (`charts`' order, then
/// `wide_charts`'): `rest` is where the point is on him at rest and `place` where it is on the
/// part's chart; `hem` how far a sleeve's point is from the sleeve's end, along his arm
/// (m); `inner` whether it's the inside of a piece of his coat that's
/// seen; `px` how much of him a pixel covers there (m). His bare arm, the wrap and the gauntlet on his forearms, his hands; his
/// coat's pieces (their outside its cloth, bound in gold at every edge; their inside its
/// lining); and what he wears under it (`worn_under`).
pub fn chart_paint(part: u32, rest: vec3, hem: f32, inner: bool, px: f32) -> Cloth {
    if of_cap(part) {
        // (Its hem, `hem` along his arm from its end.)
        if hem < CAP_HEM {
            let across = (hem / CAP_HEM) * 2.0 - 1.0
            return Cloth { relief: 0.0016 * sqrt(max(1.0 - across * across, 0.0)), ..GOLD }
        }
        return coat_at(rest, 1.0, px)
    }
    if part == 0 {
        // (His bare arm in his coat's shade where the shoulder's cap is over it.)
        let lit = mix(0.3, 1.0, smoothstep(0.17, 0.215, rest.x))
        return Cloth { albedo: SKIN.albedo * lit, ..SKIN }
    }
    if part == 2 {
        return wrap_at(rest, px)
    }
    if part == HEAD {
        return wrapped_head(rest, px)
    }
    if part == 3 {
        return LEATHER
    }
    if of_jacket(part) {
        if inner {
            // (Its lining in the coat's own shade away from its front edges and its collar's
            // top: lit all over, what showed of it past an edge was a bright patch on
            // his shoulder.)
            let edge = min(opening(rest), collar_top(rest) - rest.y)
            let lit = mix(0.1, 1.0, 1.0 - smoothstep(0.015, 0.09, edge))
            return Cloth { albedo: LINING.albedo * lit, ..LINING }
        }
        // (No armhole and no rim of one: a sleeve comes out of its side, the same cloth, and
        // its hem is on his arm.)
        if part == JACKET_BODY {
            return coat_at(rest, opening(rest), px)
        }
        if part == COLLAR {
            // (Its front edges the jacket's own, on up; its top edge bound as they are.)
            return coat_at(rest, min(opening(rest), collar_top(rest) - rest.y), px)
        }
        // A shoulder: a seam along its top.
        return sewn(coat_at(rest, 1.0, px), seam(rest.z + 0.065, rest.x, px))
    }
    // (His left hand bare, his right in a black glove. The wrap round his left forearm
    // carries on over the heel of his palm to his wrist: the wrap's own form ends inside his
    // palm's, where the two surfaces lie in one another, and with his palm bare there the
    // wrap's end showed through it as ragged dark marks.)
    if of_hand(part) {
        if part >= HAND_LEFT + HAND_PIECES {
            return LEATHER
        }
        return if rest.x < WRAP_END { wrap_at(rest, px) } else { SKIN }
    }
    worn_under(rest, px)
}

/// How high his coat's collar stands at a point round it (rest height): a low standing
/// collar, 4 cm at its front edges and 7.5 behind, so his neck shows over it all round. (To
/// the middle of his neck, as it was under a turtleneck, it hid his neck from every side
/// but the front. At 6 cm behind, 10 cm of bare nape showed over it and his neck read as
/// too long.)
pub fn collar_top(p: vec3) -> f32 {
    1.528 + 0.037 * smoothstep(0.05, -0.06, p.z)
}

/// How far inside its cover's edge a point of charted part `part` is (places along its path;
/// under 0 where the part isn't): his coat's pieces'. A part with no cover is everywhere.
pub fn chart_edge(part: u32, covers: [f32], place: vec3) -> f32 {
    if !of_jacket(part) {
        return 1000.0
    }
    let at = if part == JACKET_BODY { 0 } else { part - COLLAR + 1 }
    chart::inside(covers, place.x, place.y, at: at)
}

/// What a pixel of charted part `part` shows: whether the part is there at all (`hidden`:
/// outside its cover or cut away), what it's made of there, and its normal with the cloth's
/// relief on it (and turned about where it's a coat's inside that's seen).
pub struct Dressed: Copy {
    pub hidden: bool,
    pub cloth: Cloth,
    pub normal: vec3,
}

/// Charted part `part`'s pixel (`v`: what its vertices passed down; `n`: its form's normal
/// there, `chart::Vertex::normal_from`; `from_eye`: the way from the eye to it, unit;
/// `covers`: `jacket_covers`). Each of the three programs that draw him asks this, so his
/// clothes are the same in all of them.
pub fn dressed(part: u32, v: chart::Vertex, n: vec3, from_eye: vec3, covers: [f32]) -> Dressed {
    let edge = chart_edge(part, covers, v.place)
    let inner = shows_inside(part, v.rest) && dot(n, from_eye) > 0.0
    let px = 0.5 * (length(dpdx(v.rest)) + length(dpdy(v.rest)))
    // (A sleeve is hemmed at its end, on his arm: how far along his arm from there.)
    let hem = if of_cap(part) { (CAP_TO - v.place.x) * ARM_LONG } else { 1.0 }
    let cloth = chart_paint(part, v.rest, hem, inner, px)
    let normal = engine::character::embossed(n, v.world, cloth.relief)
    Dressed {
        hidden: edge < 0.0 || chart_cut(part, v.rest, v.place),
        cloth,
        normal: if inner { -normal } else { normal },
    }
}

/// Where his jacket's body is on its chart, before its opening is cut (`chart_cut`).
pub fn jacket_body_cover() -> chart::Cover {
    let body = wide_charts()[JACKET_BODY - CHARTS]
    // The body's cover as it was written has the front of an older jacket, a slanted slot
    // that swung to his right: its front is made whole here, from its hem to the foot of its
    // collar, and the jacket's opening is cut where `opening` has it (`chart_cut`). Its
    // neck stays as it was written.
    let at_rest = body.rest()
    var marks: Vec<bool> = Vec::new()
    for i in 0..chart::COVER_ALONG {
        for j in 0..chart::COVER_ROUND {
            let at = at_rest.side(
                f: (f32(i) + 0.5) / f32(chart::COVER_ALONG),
                theta: (f32(j) + 0.5) / f32(chart::COVER_ROUND) * TAU,
            )
            let front = at.z > 0.0 && at.y < 1.47 && abs(at.x) < 0.17
            // (And its sides whole up to where its shoulders take over: it has no armholes,
            // and his sleeves come out through its sides.)
            let side = abs(at.x) > 0.1 && at.y < 1.5
            marks.push(front || side || jacket_cover::JACKET_COVER.at(i, j))
        }
    }
    chart::cover_of(marks)
}

/// His jacket's pieces' covers in GPU memory (`jacket_cover`: where each is on its chart, as
/// how far inside its edge each place is: `chart::Cover::edges`), in the order `chart_edge`
/// reads them.
pub fn jacket_covers() -> std::gpu::GpuBuffer<f32> {
    let limbs = charts()
    let body = wide_charts()[JACKET_BODY - CHARTS]
    // (A place round a piece's path against a place along it, by the piece's size halfway.)
    let round = |length: f32, radius: f32| {
        (TAU * radius / f32(chart::COVER_ROUND)) / (length / f32(chart::COVER_ALONG))
    }
    let of = |part: Part<16, 13>| {
        round(part.chain.rest().length(), part.form.radius(f: 0.5, theta: 0.0))
    }
    // (Its collar's cover whole, and its shoulders': the collar's front and its top are cut
    // where `opening` and `collar_top` have them, a shoulder's edges where `YOKE_ROUND`
    // and `YOKE_OUT` do.)
    let all: Vec<bool> = Vec::filled(chart::COVER_ALONG * chart::COVER_ROUND, true)
    chart::uploaded(
        [
            jacket_body_cover(),
            chart::cover_of(all),
            chart::cover_of(all),
            chart::cover_of(all),
        ],
        [
            round(body.chain.rest().length(), body.form.radius(f: 0.5, theta: 0.0)),
            of(limbs[COLLAR]),
            of(limbs[YOKE_LEFT]),
            of(limbs[YOKE_RIGHT]),
        ],
    )
}

/// Whether charted part `part` is cut away at a place besides (where it is on him at rest):
/// his jacket's front's edge where `body_paint` has his shirt showing, so the gold along it
/// keeps its width.
pub fn chart_cut(part: u32, rest: vec3, place: vec3) -> bool {
    if part == COLLAR {
        // (Its form carries the top of his coat's back too, under its foot: that stops
        // where a shoulder takes over, `SHELF_OUT` from his middle. Run on under the
        // shoulder, the two lay in one another and the line between them was ragged.)
        return opening(rest) < 0.0 ||
            rest.y > collar_top(rest) ||
            (rest.y < 1.5 && abs(rest.x) > SHELF_OUT)
    }
    if part == YOKE_LEFT || part == YOKE_RIGHT {
        // (Its foot a line along its own chart, front and back: cut at a height, where its
        // top slopes away gently behind, its foot was a ragged edge across his shoulder
        // blade.)
        return abs(chart::wrapped(place.y)) > YOKE_ROUND || abs(rest.x) > YOKE_OUT
    }
    if of_cap(part) {
        return false
    }
    if part != JACKET_BODY {
        return false
    }
    // (No hole for an arm: a sleeve comes out through its side. And none of it over the top
    // of his shoulder, past where a shoulder of his coat takes over: there his sleeve is
    // his coat.)
    let on_shoulder = abs(rest.x) > 0.15 && atan2(abs(rest.z + 0.065), rest.y - 1.455) < 1.1
    opening(rest) < 0.0 || rest.y < COAT_SEAM || on_shoulder
}

/// A place where one of his arms' sides passes through his coat's body where the body is
/// drawn, as a pose has them: where on the body at rest, which arm (0 his left), and how
/// far along the arm's path.
pub struct Through: Copy {
    pub rest: vec3,
    pub arm: u32,
    pub along: f32,
    /// Where it is as the pose has him.
    pub at: vec3,
    /// How far the body stands there off what his chest carries (m, at rest: `off_him`).
    pub off: f32,
}

/// How far a point of him at rest is from what his chest carries of him (m; negative
/// inside it): his trunk, and each shoulder as far out as its joint (the root of each arm's
/// form, 7 cm of it: past the joint it's his upper arm, which goes its own way).
pub fn off_him(rest: Charted, p: vec3) -> f32 {
    var least = rest.wide[0].near(p)
    for arm in 0..2 {
        let limb = rest.limbs[arm]
        let pl = limb.path.place(p)
        let past = max(pl.along - 0.07, 0.0)
        let gap = limb.near(p)
        least = min(least, if past > 0.0 {
            sqrt(max(gap, 0.0) * max(gap, 0.0) + past * past)
        } else { gap })
    }
    least
}

/// Whether his coat's body is drawn where `p` is about it (`body`: as a pose has it;
/// `rest`: at rest; `cover`: `jacket_body_cover`), and where that is on it at rest.
pub fn body_drawn_at(
    body: Limb<24, 21>,
    rest: Limb<24, 21>,
    cover: chart::Cover,
    p: vec3,
) -> (bool, vec3) {
    let pl = body.path.place(p)
    let f = pl.along / body.path.length()
    if f < 0.03 || f > 1.0 {
        return (false, vec3())
    }
    let at = rest.side(f: f, theta: pl.theta)
    let i = u32(f * f32(chart::COVER_ALONG))
    let j = u32(fract(pl.theta / TAU + 1.0) * f32(chart::COVER_ROUND))
    (cover.at(i, j) && !chart_cut(JACKET_BODY, at, vec3(f, pl.theta, 0.0)), at)
}

/// Every place his arms' sides pass through his coat's body as `posed` has him (`rest`: him
/// at rest; `cover`: `jacket_body_cover`): his arms' sides, `over` metres off them, from
/// `from` to `to` of the way along their paths, read on a grid 1 cm by a twentieth of a
/// turn, and each place the side goes from inside the body's side to outside it between two
/// neighbours on the grid with the body drawn there. Cloth can't pass through what's inside
/// it: none, for a coat that's on him.
pub fn arms_through_coat(
    posed: Charted,
    rest: Charted,
    cover: chart::Cover,
    from: f32,
    to: f32,
    over: f32,
) -> Vec<Through> {
    var out: Vec<Through> = Vec::new()
    let body = posed.wide[JACKET_BODY - CHARTS]
    let body_rest = rest.wide[JACKET_BODY - CHARTS]
    let rows = u32((to - from) * ARM_LONG / 0.01) + 2
    for arm in 0..2 {
        let limb = Limb { form: posed.limbs[arm].form.plus(chart::round(over)), ..posed.limbs[arm] }
        var before = [vec4(); 20]
        for i in 0..rows {
            let f = from + (to - from) * f32(i) / f32(rows - 1)
            var row = [vec4(); 20]
            for j in 0..20 {
                let p = limb.side(f: f, theta: TAU * f32(j) / 20.0)
                row[j] = vec4(p, body.near(p))
            }
            for j in 0..20 {
                let a = row[j]
                for side in 0..2 {
                    // (Its neighbour round the arm, and its neighbour back along it.)
                    let other = if side == 0 { row[(j + 1) % 20] } else { before[j] }
                    let apart = (a.w < 0.0) != (other.w < 0.0)
                    if apart && (side == 0 || i > 0) {
                        // (Where the side crosses the body's, between the two.)
                        let t = a.w / (a.w - other.w)
                        let here = mix(a.xyz, other.xyz, t)
                        let (drawn, at) = body_drawn_at(body, body_rest, cover, here)
                        if drawn {
                            out.push(
                                Through {
                                    rest: at,
                                    arm,
                                    along: f,
                                    at: here,
                                    off: off_him(rest, at),
                                },
                            )
                        }
                    }
                }
            }
            before = row
        }
    }
    out
}

/// Where his jacket stops and his coat's tails carry on (rest height): just under the tails'
/// top (`shapes::TAILS_TOP`), where the tails' girth is the jacket's own, so the two are one
/// surface there. The tails' cloth runs on 3 cm up inside the jacket (`shapes::TAILS_UNDER`),
/// so its top rim is out of sight.
pub const COAT_SEAM: f32 = 0.927

/// His belt's height, its half width, and where its buckle's middle is (rest space).
const BELT_AT: f32 = 0.975
const BELT_HALF: f32 = 0.021
const BUCKLE: vec3 = vec3(0.0, 0.975, 0.1225)

/// His belt at `q` (rest space): a leather band 4 cm wide round his trousers' waist, and a
/// buckle on its front, a frame with a prong across it.
fn belt(q: vec3) -> f32 {
    let e = length(vec2(q.x / 0.172, (q.z + 0.006) / 0.124))
    let band = max((e - 1.0) * 0.124, abs(q.y - BELT_AT) - BELT_HALF)
    let c = q - BUCKLE
    let outer = max(max(abs(c.x) - 0.031, abs(c.y) - 0.028), abs(c.z) - 0.0045)
    let hole = max(abs(c.x) - 0.021, abs(c.y) - 0.018)
    let frame = max(outer, -hole)
    let prong = max(max(abs(c.x + 0.004) - 0.0025, abs(c.y) - 0.0275), abs(c.z - 0.002) - 0.003)
    min(band, min(frame, prong))
}

/// His belt as a shape on his spine's first joint (`at`: the joint at rest).
pub struct Belt: Copy + GpuData {
    pub at: vec3,
}

impl Surface for Belt {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, BELT_AT, 0.0) - self.at, radius: 0.22, slope: 0.5 }
    }

    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        belt(p + self.at)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// His belt's paint (`p` from its joint): black leather, a row of stitches along each edge,
/// its buckle gold.
fn sash_paint(p: vec3) -> Cloth {
    let q = p + vec3(0.0, 1.072, -0.007)
    let c = q - BUCKLE
    if c.z > -0.006 && abs(c.x) < 0.033 && abs(c.y) < 0.03 {
        if max(abs(c.x) - 0.021, abs(c.y) - 0.018) > -0.0005 || abs(c.x + 0.004) < 0.003 {
            return GOLD
        }
    }
    let stitch = stripe(abs(q.y - BELT_AT) - 0.015, 0.0015, 0.0008) *
        (if fract(atan2(q.x, q.z) / 0.045) < 0.6 { 1.0 } else { 0.0 })
    Cloth { albedo: mix(LEATHER.albedo, THREAD, vec3(stitch * 0.7)), ..LEATHER }
}

/// The mask, on the head's bone (the head's joint is the bone's place).
pub struct Mask: Copy + GpuData {}

impl Surface for Mask {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, 0.14, 0.05), radius: 0.31, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        fox(unscaled(p + HEAD_JOINT)) * HEAD_SCALE
    }

    /// Ellipsoids by their usual bound, cones, a triangle and smooth extrema: about 1, with
    /// room.
    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

fn mask_paint(p: vec3) -> Cloth {
    let (c, rough) = fox_paint(unscaled(p + HEAD_JOINT))
    Cloth { albedo: c, rough, metal: 0.0 }
}

/// The hair, on the head's bone.
pub struct Hair: Copy + GpuData {}

impl Surface for Hair {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, 0.19, -0.13), radius: 0.34, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        let q = unscaled(p + HEAD_JOINT)
        hair(q, shapes::skull(q)) * HEAD_SCALE
    }

    /// Flattened cones (each scaled back by its flattening) and his skull, by smooth extrema,
    /// and his locks' rise and fall on it (as steep as 1 in 1 at a lock's tip).
    fn lipschitz(self, near: f32) -> f32 {
        2.1
    }
}

fn hair_paint(p: vec3) -> Cloth {
    HAIR
}

/// A boot's foot, on the left foot's bone (its image on the right's).
pub struct BootFoot: Copy + GpuData {
    pub at: vec3,
}

impl Surface for BootFoot {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.006, 0.004, 0.088), radius: 0.21, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        boot_foot(p + self.at)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

/// A boot's shaft, on the left calf's bone.
pub struct BootShaft: Copy + GpuData {
    pub at: vec3,
}

impl Surface for BootShaft {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.006, -0.342, -0.024), radius: 0.21, slope: 0.5 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.5 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        boot_shaft(p + self.at)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.5
    }
}

fn foot_paint(p: vec3) -> Cloth {
    let (c, rough, metal) = boot_paint(p + vec3(0.114, 0.086, -0.088))
    Cloth { albedo: c, rough, metal }
}

fn shaft_paint(p: vec3) -> Cloth {
    let (c, rough, metal) = boot_paint(p + vec3(0.114, 0.542, -0.036))
    Cloth { albedo: c, rough, metal }
}

/// The coat's tails, on the pelvis's bone (scaled down by how steeply its folds turn).
pub struct Tails: Copy + GpuData {}

/// How much faster than a distance the tails' field grows across its folds.
const FOLDS: f32 = 2.5

impl Surface for Tails {
    fn bound(self) -> Bound {
        Bound { centre: vec3(0.0, -0.3, 0.003), radius: 0.46, slope: 0.3 }
    }

    /// By its bound on the gradient from its centre's distance: no derived interval of all
    /// of it, which would be most of a culling pass's shader.
    fn interval(self, over: Box3) -> Interval {
        let r = 1.0 * 0.5 * length(over.hi - over.lo)
        let d = self.distance(over.center())
        Interval { lo: d - r, hi: d + r }
    }

    fn distance(self, p: vec3) -> f32 {
        tails(p + vec3(0.0, 0.949, -0.043)).0 / FOLDS
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// The tails' paint: black outside, gold lined, a gold band along the hem.
fn tails_paint(p: vec3) -> Cloth {
    let q = p + vec3(0.0, 0.949, -0.043)
    let (_, through) = tails(q)
    let rel = q - vec3(0.0, 0.949, -0.043)
    var deg = atan2(rel.x, rel.z) * 57.2957795
    if deg < 0.0 {
        deg += 360.0
    }
    let low = shapes::hem(clamp(deg, 42.0, 318.0))
    if q.y < low + 0.022 {
        return GOLD
    }
    // (Its front edges gold too, on from his jacket's: one trim from his collar to the hem.)
    let edge = shapes::front_edge(q.y)
    let round = min(deg - edge, 360.0 - edge - deg) * 0.0174532925 * length(rel.xz)
    if round < TRIM {
        return GOLD
    }
    if through >= -0.004 {
        return BLACK
    }
    // (The lining in the coat's shade further up inside it: lit gold all the way up, a run's
    // lifted hem showed it as a flat slab.)
    let t = clamp((q.y - low - 0.03) / 0.18, 0.0, 1.0)
    let shade = 1.0 - 0.85 * t * t * (3.0 - 2.0 * t)
    // (A darker amber satin than the trim's gold, as the sheet's lining; barely glossy: metallic,
    // it mirrored the sky and flared bright inside the coat.)
    Cloth { albedo: LINING.albedo * shade, rough: LINING.rough, metal: LINING.metal }
}

/// What he wears that isn't drawn along a chart: the belt, the boots. (His body, dressed, and
/// his jacket are: `charts`, `wide_charts`.)
pub fn hero() -> Creature<Cloth> {
    let s = skeleton()
    let b = |name: Text| s.find(name)
    creature(s)
        .join(
            "sash",
            b("spine 1"),
            // A flat leather belt, about 4 cm, straight-sided (an oval band bulged into a tube),
            // on his trousers under his open jacket.
            Belt { at: s.rest(b("spine 1")) }.with_at(sash_paint),
            seam: hard(),
        )
        .join(
            "boot",
            b("foot left"),
            BootFoot { at: vec3(0.114, 0.086, -0.088) }.with_at(foot_paint),
            seam: hard(),
            mirror: true,
        )
        .join(
            "boot shaft",
            b("calf left"),
            BootShaft { at: vec3(0.114, 0.542, -0.036) }.with_at(shaft_paint),
            seam: smooth(0.004),
            mirror: true,
        )
}

/// His coat's tails, realized on their own finer grid (thin cloth): on his pelvis's bone.
pub fn coat() -> Creature<Cloth> {
    let s = skeleton()
    creature(s)
        .join("tails", s.find("pelvis"), Tails {}.with_at(tails_paint))
        .bounded(Box3 { lo: vec3(-0.30, 0.28, -0.32), hi: vec3(0.30, 0.99, 0.22) })
}

/// His head's finer work, realized on its own finer grid: the hair and the mask, on his head's
/// bone (his skeleton's, so one palette poses both).
pub fn head() -> Creature<Cloth> {
    let s = skeleton()
    let head = s.find("head")
    creature(s)
        .join("hair", s.find("hair"), Hair {}.with_at(hair_paint))
        .join("mask", head, Mask {}.with_at(mask_paint), seam: hard())
}

@test
fn his_coats_front_edge_is_one_line_from_its_collar_into_its_tails() {
    // Where his jacket stops and his tails carry on, the jacket's front edge is where the
    // tails' is, on each side: the gold along them is one line.
    let a = shapes::front_edge(COAT_SEAM) * 0.0174532925
    for side in [1.0, -1.0] {
        let p = vec3(
            shapes::TAILS_AXIS.x + side * sin(a) * 0.19,
            COAT_SEAM,
            shapes::TAILS_AXIS.z + cos(a) * 0.19,
        )
        assert(abs(opening(p)) < 0.004, f"{opening(p)} m off the tails' edge")
    }
    // And from his throat down, the opening only widens: a point of his chest's front is
    // further inside it the lower it is.
    var last = opening(vec3(0.1, 1.5, 0.12))
    for i in 1..31 {
        let now = opening(vec3(0.1, 1.5 - 0.019 * f32(i), 0.12))
        assert(now <= last + 0.0001, f"at {1.5 - 0.019 * f32(i)}")
        last = now
    }
    // The tails' front edge is cut back from his waist: past the front of his thigh (47
    // degrees round) a hand's breadth down, and further the lower.
    assert(shapes::front_edge(shapes::TAILS_TOP) == shapes::TAILS_FROM)
    assert(shapes::front_edge(shapes::TAILS_TOP - 0.09) > 55.0)
    assert(shapes::front_edge(0.6) > shapes::front_edge(0.8))
}

@test
fn his_coats_body_is_on_his_trunk_with_nothing_out_past_his_shoulders() {
    // At rest, from his armpits to the top of its back, nothing of the jacket's body is
    // further from his middle than `BODY_HALF` (and the form's own smoothing, 1 cm), and
    // its sides are whole: no hole for an arm.
    let body = wide_charts()[JACKET_BODY - CHARTS].rest()
    let cover = jacket_body_cover()
    var widest = 0.0
    for i in 0..40 {
        let f = 0.58 + 0.008 * f32(i)
        for j in 0..96 {
            let theta = TAU * f32(j) / 96.0
            let at = body.side(f: f, theta: theta)
            if at.y < 1.27 || at.y > 1.49 {
                continue
            }
            assert(abs(at.x) < BODY_HALF + 0.01, f"its side is {abs(at.x)} m out at {at}")
            widest = max(widest, abs(at.x))
            let (drawn, _) = body_drawn_at(body, body, cover, at)
            if abs(at.x) > 0.15 && at.y < 1.44 {
                assert(drawn, f"a hole in its side at {at}")
            }
        }
    }
    // (And it does reach its sides: 2 cm off his ribs.)
    assert(widest > BODY_HALF - 0.012, f"its sides are only {widest} m out")
}

@test
fn his_neck_is_a_neck_and_his_trunk_ends_inside_it() {
    // His neck under his jaw is narrower than his head (13 cm across to his skull's 16), and
    // widens into his shoulders at its foot: half as wide again at its sides.
    let under_jaw = NECK_FORM.radius(f: 0.72, theta: TAU / 4.0)
    let skull = HEAD_FORM.radius(f: 0.68, theta: TAU / 4.0)
    assert(under_jaw > 0.06 && under_jaw < 0.07, f"his neck is {under_jaw} m to a side")
    assert(skull > under_jaw + 0.008, f"his skull is {skull} m to a side")
    assert(NECK_FORM.radius(f: 0.04, theta: TAU / 4.0) > 1.4 * under_jaw)
    // Its front is its least: his throat doesn't stand out past his chin.
    assert(NECK_FORM.radius(f: 0.04, theta: 0.0) < 0.075)
    // Round it, where it shows over his collar, it's smooth: no place stands a millimetre
    // and a half off the two a centimetre either side of it.
    for i in 0..40 {
        let f = 0.45 + 0.45 * f32(i) / 40.0
        for j in 0..24 {
            let theta = TAU * f32(j) / 24.0
            let here = NECK_FORM.radius(f: f, theta: theta)
            let beside = 0.5 *
                (NECK_FORM.radius(f: f, theta: theta - 0.15) +
                    NECK_FORM.radius(f: f, theta: theta + 0.15))
            assert(
                abs(here - beside) < 0.0015,
                f"his neck has a lump of {here - beside} at {f}, {theta}",
            )
        }
    }
    // Past the root of his neck his trunk is a stub inside it, whichever way it's seen from.
    for j in 0..8 {
        let theta = TAU * f32(j) / 8.0
        let stub = TRUNK_FORM.radius(f: 0.96, theta: theta)
        assert(stub < 0.07, f"his trunk's top is {stub} m out at {theta}")
    }
    // And below his shoulders' tops it's as it was fitted.
    assert(
        abs(TRUNK_FORM.radius(f: 0.6, theta: 1.0) - trunk_form::TRUNK.radius(f: 0.6, theta: 1.0)) <
            0.001,
    )
}

@test
fn his_mask_covers_his_face_and_is_sized_to_his_head() {
    // Every point of the front of his head, from his chin to his brow, is behind his mask:
    // inside its shell (but where its eyes' slits are cut, each side of his nose).
    for i in 0..12 {
        let y = 1.60 + 0.016 * f32(i)
        for theta in [-0.5, 0.0, 0.5] {
            if theta != 0.0 && abs(y - 1.712) < 0.02 {
                continue
            }
            let r = HEAD_FORM.radius(f: (y - 1.55) / 0.27, theta: theta)
            let p = vec3(r * sin(theta), y, r * cos(theta))
            assert(fox(unscaled(p)) < 0.0, f"his face shows at {p}: {fox(unscaled(p))}")
        }
    }
    // It's no wider than his head at his temples (his skull is 8 cm to a side there), and it
    // ends under his chin, not at his throat.
    assert(fox(unscaled(vec3(0.105, 1.75, 0.03))) > 0.0)
    assert(fox(unscaled(vec3(0.0, 1.56, 0.09))) > 0.0)
    // His jaw is under it: his head at his chin's height is narrower than his neck.
    let jaw = HEAD_FORM.radius(f: 0.15, theta: TAU / 4.0)
    assert(jaw < 0.05, f"his jaw is {jaw} m to a side at his chin")
}

@test
fn his_skull_is_a_skulls_proportions() {
    // How far the skull reaches from its middle line at a height, to his side and ahead.
    let reach = |y: f32, way: vec3| -> f32 {
        var r = 0.2
        while r > 0.0 && shapes::skull(vec3(0.0, y, 0.0) + way * r) > 0.0 {
            r -= 0.001
        }
        r
    }
    let side = vec3(1.0, 0.0, 0.0)
    // Widest over his ears, then his cheekbones, then his jaw's corners, then his chin.
    let (vault, cheeks, jaw) = (reach(1.722, side), reach(1.668, side), reach(1.625, side))
    assert(vault > cheeks && cheeks > jaw && jaw > 0.045, f"{vault} {cheeks} {jaw}")
    assert(vault > 0.07 && vault < 0.078, f"his skull is {2.0 * vault} m across")
    // His chin is ahead of his skull's middle, 5 cm across, and nothing of his skull is
    // under it.
    let front = vec3(0.0, shapes::CHIN + 0.008, 0.07)
    assert(shapes::skull(front) < 0.0, "his chin isn't where it should be")
    assert(shapes::skull(front + vec3(0.035, 0.0, 0.0)) > 0.0, "his chin is too wide")
    assert(shapes::skull(vec3(0.0, shapes::CHIN - 0.004, 0.07)) > 0.0)
    // His jaw's underside rises from his chin to its corners: under his ears there's no
    // skull at his chin's height.
    assert(shapes::skull(vec3(0.04, shapes::CHIN + 0.01, -0.01)) > 0.0)
    // It's deeper than it is wide, and from his chin to his crown about 23 cm (before his
    // head's scale): seven and a half heads to his height.
    let deep = reach(1.722, vec3(0.0, 0.0, 1.0)) + reach(1.722, vec3(0.0, 0.0, -1.0))
    assert(deep > 2.0 * vault + 0.03, f"{deep} m deep")
    let crown = shapes::CRANIUM_AT.y + shapes::CRANIUM.y
    assert(abs(crown - shapes::CHIN - 0.227) < 0.005, f"{crown - shapes::CHIN} m tall")
    // His hair grows from the same skull's vault, and his mask is the same skull's face a
    // centimetre out.
    let brow = vec3(0.0, 1.76, 0.0)
    assert(abs(shapes::cranium(brow) - shapes::skull(brow)) < 0.004)
    let forehead = vec3(0.0, 1.78, 0.06)
    assert(
        abs(fox(forehead) - (shapes::skull(forehead) - shapes::MASK_OFF)) < 0.004,
        f"{fox(forehead)}",
    )
}

@test
fn little_of_his_neck_shows_between_his_collar_and_his_heads_wrap() {
    // Behind, his coat's collar comes to within 5 cm of where his head's wrap ends on his
    // nape; at his sides, to within 9 of his jaw's corners.
    let behind = vec3(0.0, 1.58, -0.085)
    assert(
        nape(behind) - collar_top(behind) < 0.05,
        f"{nape(behind) - collar_top(behind)} m of nape",
    )
    assert(nape(behind) - collar_top(behind) > 0.025)
    // And his neck is wider the lower: at his collar's top half as wide again as under
    // his jaw.
    let low = NECK_FORM.radius(f: 0.4, theta: TAU / 4.0)
    let high = NECK_FORM.radius(f: 0.85, theta: TAU / 4.0)
    assert(low > 1.3 * high, f"{low} against {high}")
}

@test
fn his_coats_shoulder_is_a_layer_on_his_own_shoulder() {
    // The outer end of each of his coat's shoulders is his arm's own form and the cloth's
    // thickness, on his arm's own path and bones: wherever his shoulder goes it goes, the
    // same distance off it.
    let parts = charts()
    for (cap, arm) in [(CAP_LEFT, 0), (CAP_RIGHT, 1)] {
        assert(parts[cap].bones[0] == parts[arm].bones[0] && parts[cap].root == parts[arm].root)
        for i in 0..8 {
            let f = CAP_TO * f32(i) / 8.0
            for j in 0..6 {
                let theta = TAU * f32(j) / 6.0
                let off = parts[cap].form.radius(f: f, theta: theta) -
                    parts[arm].form.radius(f: f, theta: theta)
                assert(abs(off - CAP_OVER) < 1.0e-5, f"{off} m off his shoulder at {f}, {theta}")
            }
        }
    }
    // It runs all the way round his arm to its hem, 5 cm past his shoulder's joint, and
    // none of the body's own shell is left on top of his shoulder under it.
    assert(!chart_cut(CAP_LEFT, vec3(0.24, 1.40, -0.065), vec3(0.19, 3.0, 0.0)))
    assert(chart_cut(JACKET_BODY, vec3(0.18, 1.54, -0.065), vec3(0.9, 0.0, 0.0)))
}
