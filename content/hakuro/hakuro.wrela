        .join(
            "deltoid right",
            b("upper arm right"),
            oval(vec3(0.1715, 0.0700, 0.1259))
                .rotate(Quat { v: vec4(-0.07208, 0.02176, -0.56834, 0.81934) })
                .translate(vec3(-0.1360, 1.3593, -0.0526))
                .with_at(body_paint)
                .translate(-s.rest(b("upper arm right"))),
            seam: smooth(0.040),
        )
        .join(
            "biceps left",
            b("upper arm left"),
            oval(vec3(0.1328, 0.0421, 0.0460))
                .rotate(Quat { v: vec4(0.25923, 0.03389, -0.00100, 0.96522) })
                .translate(vec3(0.3480, 1.4407, -0.0474))
                .with_at(body_paint)
                .translate(-s.rest(b("upper arm left"))),
            seam: smooth(0.030),
        )
        .join(
            "biceps right",
            b("upper arm right"),
            oval(vec3(0.1488, 0.0581, 0.0620))
                .rotate(Quat { v: vec4(0.25923, -0.03389, 0.00100, 0.96522) })
                .translate(vec3(-0.3480, 1.4407, -0.0474))
                .with_at(body_paint)
                .translate(-s.rest(b("upper arm right"))),
            seam: smooth(0.030),
        )
        .join(
            "triceps left",
            b("upper arm left"),
            oval(vec3(0.1787, 0.0796, 0.0583))
                .rotate(Quat { v: vec4(0.38564, -0.02522, -0.19827, 0.90074) })
                .translate(vec3(0.2256, 1.4598, -0.0857))
                .with_at(body_paint)
                .translate(-s.rest(b("upper arm left"))),
            seam: smooth(0.030),
        )
        .join(
            "triceps right",
            b("upper arm right"),
            oval(vec3(0.1947, 0.0956, 0.0743))
                .rotate(Quat { v: vec4(0.38564, 0.02522, 0.19827, 0.90074) })
                .translate(vec3(-0.2256, 1.4598, -0.0857))
                .with_at(body_paint)
                .translate(-s.rest(b("upper arm right"))),
            seam: smooth(0.030),
        )
        .join(
            "forearm left",
            b("forearm left"),
            oval(vec3(0.1924, 0.0601, 0.0516))
                .rotate(Quat { v: vec4(0.10474, 0.00152, 0.00720, 0.99447) })
                .translate(vec3(0.4676, 1.4324, -0.0902))
                .with_at(body_paint)
                .translate(-s.rest(b("forearm left"))),
            seam: smooth(0.030),
        )
        .join(
            "forearm right",
            b("forearm right"),
            oval(vec3(0.2024, 0.0701, 0.0616))
                .rotate(Quat { v: vec4(0.10474, -0.00152, -0.00720, 0.99447) })
                .translate(vec3(-0.4676, 1.4324, -0.0902))
                .with_at(body_paint)
                .translate(-s.rest(b("forearm right"))),
            seam: smooth(0.030),
        )
        .join(
            "wrist left",
            b("forearm left"),
            round_cone(
                vec3(0.4858, 1.4722, -0.0703),
                vec3(0.7104, 1.4434, -0.0663),
                r_top: 0.0418,
                r_bottom: 0.0345,
            )
                .with_at(body_paint)
                .translate(-s.rest(b("forearm left"))),
            seam: smooth(0.030),
        )
        .join(
            "wrist right",
            b("forearm right"),
            round_cone(
                vec3(-0.4858, 1.4722, -0.0703),
                vec3(-0.7104, 1.4434, -0.0663),
                r_top: 0.0498,
                r_bottom: 0.0425,
            )
                .with_at(body_paint)
                .translate(-s.rest(b("forearm right"))),
            seam: smooth(0.030),
        )
        .join(
            "thigh",
            b("thigh left"),
            oval(vec3(0.0830, 0.2892, 0.0877))
                .rotate(Quat { v: vec4(0.04534, 0.30884, -0.00545, 0.95002) })
                .translate(vec3(0.1221, 0.7258, -0.0113))
                .with_at(body_paint)
                .translate(-s.rest(b("thigh left"))),
            seam: smooth(0.040),
            mirror: true,
