            oval(vec3(0.0892, 0.1836, 0.1037))
                .rotate(Quat { v: vec4(0.06653, -0.11183, 0.00873, 0.99146) })
                .translate(vec3(0.1277, 0.3882, -0.0850))
                .intersect(cuboid(vec3(1.0, 0.37, 1.0)).translate(vec3(0.0, 0.64, 0.0)))
