        .join(
            "shin",
            b("calf left"),
            round_cone(
                vec3(0.1312, 0.8252, -0.0573),
                vec3(0.1258, 0.1209, -0.0870),
                r_top: 0.0750,
                r_bottom: 0.0683,
            )
                .intersect(cuboid(vec3(1.0, 0.37, 1.0)).translate(vec3(0.0, 0.64, 0.0)))
                .with_at(body_paint)
                .translate(-s.rest(b("calf left"))),
            seam: smooth(0.030),
            mirror: true,
        )
        .join(
            "collar",
            b("spine 3"),
            round_cone(
                vec3(0.0, 1.47, -0.045),
                vec3(0.0, 1.595, -0.055),
                r_top: 0.082,
                r_bottom: 0.094,
            )
                .intersect(cuboid(vec3(1.0, 1.0, 0.1)).translate(vec3(0.0, 1.5, -0.075)))
                .with_at(collar_paint)
                .translate(-s.rest(b("spine 3"))),
            seam: hard(),
        )
        .join(
            "sash",
            b("spine 1"),
            oval(vec3(0.19, 0.12, 0.14))
                .translate(vec3(0.0, 1.0, 0.0))
                .intersect(cuboid(vec3(1.0, 0.045, 1.0)).translate(vec3(0.0, 0.985, 0.0)))
                .with_at(sash_paint)
                .translate(-s.rest(b("spine 1"))),
            seam: hard(),
        )
        .join(
            "hand left",
            b("hand left"),
            oval(vec3(0.055, 0.026, 0.046))
                .translate(vec3(0.765, 1.45, -0.055))
                .with_at(hand_paint)
                .translate(-s.rest(b("hand left"))),
            seam: smooth(0.02),
        )
        .join(
            "fingers left",
            b("fingers left"),
            oval(vec3(0.052, 0.021, 0.045))
                .translate(vec3(0.862, 1.448, -0.058))
                .with_at(hand_paint)
                .translate(-s.rest(b("fingers left"))),
            seam: smooth(0.015),
        )
        .join(
            "thumb left",
            b("thumb left"),
            round_cone(
                vec3(0.74, 1.428, -0.024),
                vec3(0.80, 1.392, 0.008),
                r_top: 0.015,
                r_bottom: 0.011,
            )
                .with_at(hand_paint)
                .translate(-s.rest(b("thumb left"))),
            seam: smooth(0.012),
        )
        .join(
            "hand right",
            b("hand right"),
            oval(vec3(0.055, 0.026, 0.046))
                .translate(vec3(-0.765, 1.45, -0.055))
                .with_at(hand_paint)
                .translate(-s.rest(b("hand right"))),
            seam: smooth(0.02),
        )
        .join(
            "fingers right",
            b("fingers right"),
            oval(vec3(0.052, 0.021, 0.045))
                .translate(vec3(-0.862, 1.448, -0.058))
                .with_at(hand_paint)
                .translate(-s.rest(b("fingers right"))),
            seam: smooth(0.015),
        )
        .join(
            "thumb right",
            b("thumb right"),
            round_cone(
                vec3(-0.74, 1.428, -0.024),
                vec3(-0.80, 1.392, 0.008),
                r_top: 0.015,
                r_bottom: 0.011,
            )
                .with_at(hand_paint)
                .translate(-s.rest(b("thumb right"))),
            seam: smooth(0.012),
        )
        .join(
            "boot",
            b("foot left"),
            BootFoot { at: vec3(0.114, 0.086, -0.088) }.with_at(foot_paint),
            seam: hard(),
            mirror: true,
        )
        .join(
            "boot shaft",
            b("calf left"),
            BootShaft { at: vec3(0.114, 0.542, -0.036) }.with_at(shaft_paint),
            seam: smooth(0.004),
            mirror: true,
        )
}

/// His coat's tails, realized on their own finer grid (thin cloth): on his pelvis's bone.
pub fn coat() -> Creature<Cloth> {
    let s = skeleton()
    creature(s)
        .join("tails", s.find("pelvis"), Tails {}.with_at(tails_paint))
        .bounded(Box3 { lo: vec3(-0.30, 0.28, -0.32), hi: vec3(0.30, 0.99, 0.22) })
}

/// His head's finer work, realized on its own finer grid: the hair and the mask, on his head's
/// bone (his skeleton's, so one palette poses both).
pub fn head() -> Creature<Cloth> {
    let s = skeleton()
    let head = s.find("head")
    creature(s)
        .join("hair", head, Hair {}.with_at(hair_paint))
        .join("mask", head, Mask {}.with_at(mask_paint), seam: hard())
}
