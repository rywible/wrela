// Hakuro as fields: his skeleton (the joints of the body he was designed on, measured), and his
// parts, each a field on a bone. The body's pieces were measured off the Quaternius body he was
// designed on (CC0; content/humanoid's) and dressed as the locked outfit has it: an open black
// jacket with one sleeve and a gold-edged front, a high collar, a sash with a gold line, loose
// charcoal trousers; his left arm bare but for a forearm wrap, his right gloved. Then his hard
// parts (`shapes`): the Hakuro mask, the spiked hair, the combat boots and the coat's tails.
//
// (This file is written by a script from the measured pieces; the shapes, the paint and the
// skeleton are its template's.)

use engine::chart
use engine::sway
use engine::chart::{Band, Grown, JOINTS, Limb, Part, Radial}
use std::collections::Vec
use std::math::TAU
use engine::creature::{Creature, Skeleton, creature, hard, smooth}
use engine::character::Shaded
use shapes::{
    HEAD_JOINT, HEAD_SCALE, boot_foot, boot_paint, boot_shaft, ellip, fox, fox_paint, hair, tails,
    unscaled,
}
use std::derive::{Box3, Interval}
use std::field::{Blend, Bound, Surface, cuboid, oval, round_cone}

/// What a point of him is made of: its colour (linear), how rough and how metallic.
pub struct Cloth: Copy + GpuData + Blend {
    pub albedo: vec3,
    pub rough: f32,
    pub metal: f32,
    /// How far the cloth's surface stands off the form it's on here (m): a seam's welt, a
    /// rib, a weave's thread. What draws it tilts its light by this (`dressed`).
    pub relief: f32 = 0.0,
}

impl Shaded for Cloth {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        self.rough
    }

    fn metallic(self) -> f32 {
        self.metal
    }
}

// The locked palette (sRGB as designed, here linear): near-black, charcoal, gold, skin, the sash,
// the hair.
pub const BLACK = Cloth { albedo: vec3(0.050, 0.050, 0.066), rough: 0.6, metal: 0.0 }
pub const CHARCOAL = Cloth { albedo: vec3(0.070, 0.070, 0.088), rough: 0.85, metal: 0.0 }
pub const GOLD = Cloth { albedo: vec3(0.690, 0.380, 0.016), rough: 0.35, metal: 1.0 }
pub const LINING = Cloth { albedo: vec3(0.300, 0.150, 0.022), rough: 0.6, metal: 0.15 }
pub const SKIN = Cloth { albedo: vec3(0.500, 0.250, 0.130), rough: 0.72, metal: 0.0 }
/// His top: a fitted black compression knit, smoother than his jacket's cloth, so light picks
/// out his chest and his sleeved arm under the matte jacket.
pub const TOP = Cloth { albedo: vec3(0.034, 0.034, 0.044), rough: 0.55, metal: 0.0 }
/// His trousers: a charcoal twill, a step lighter than his jacket and his top and matte
/// where his top shines. (As light as graphite, with nothing on them, they read as grey
/// sweatpants.)
pub const TROUSERS = Cloth { albedo: vec3(0.098, 0.101, 0.118), rough: 0.9, metal: 0.0 }
/// The black wrap his mask is tied over, round his head above his top's neck.
pub const WRAP = Cloth { albedo: vec3(0.030, 0.030, 0.038), rough: 0.9, metal: 0.0 }
/// The cord his mask is tied on with: the vermilion of its marks.
pub const CORD: vec3 = vec3(0.57, 0.016, 0.007)
/// The thread his clothes are stitched with.
pub const THREAD: vec3 = vec3(0.19, 0.19, 0.21)
pub const HAIR = Cloth { albedo: vec3(0.027, 0.028, 0.045), rough: 0.7, metal: 0.0 }
pub const VOID = Cloth { albedo: vec3(0.004, 0.003, 0.004), rough: 1.0, metal: 0.0 }
pub const LEATHER = Cloth { albedo: vec3(0.030, 0.030, 0.040), rough: 0.45, metal: 0.0 }

/// His skeleton at rest (a T-pose), the body's joints as measured (m): +x his left.
pub fn skeleton() -> Skeleton {
    var s = Skeleton::new()
    let pelvis = s.root("pelvis", vec3(0.0, 0.949, -0.043))
    let spine1 = s.joint("spine 1", pelvis, vec3(0.0, 1.072, -0.007))
    let spine2 = s.joint("spine 2", spine1, vec3(0.0, 1.178, 0.004))
    let spine3 = s.joint("spine 3", spine2, vec3(0.0, 1.311, 0.007))
    let neck = s.joint("neck", spine3, vec3(0.0, 1.52, -0.041))
    s.joint("head", neck, HEAD_JOINT)
    let (clav, _) = s.joint_pair(
        "collarbone left",
        "collarbone right",
        spine3,
        vec3(0.031, 1.495, 0.033),
    )
    let (upper, _) = s.joint_pair(
        "upper arm left",
        "upper arm right",
        clav,
        vec3(0.212, 1.455, -0.065),
    )
    let (fore, _) = s.joint_pair("forearm left", "forearm right", upper, vec3(0.463, 1.455, -0.073))
    let (hand, _) = s.joint_pair("hand left", "hand right", fore, vec3(0.706, 1.455, -0.065))
    s.joint_pair("fingers left", "fingers right", hand, vec3(0.822, 1.451, -0.05))
    s.joint_pair("thumb left", "thumb right", hand, vec3(0.74, 1.428, -0.024))
    let (thigh, _) = s.joint_pair("thigh left", "thigh right", pelvis, vec3(0.114, 0.971, -0.036))
    let (calf, _) = s.joint_pair("calf left", "calf right", thigh, vec3(0.114, 0.542, -0.036))
    let (foot, _) = s.joint_pair("foot left", "foot right", calf, vec3(0.114, 0.086, -0.088))
    s.joint_pair("ball left", "ball right", foot, vec3(0.114, 0.015, 0.055))
    // Each finger's three joints, as the reference's rig has them: bones 26 on, a pair a
    // joint, finger by finger.
    for f in 0..5 {
        var parent = hand
        for k in 0..3 {
            let (b, _) = s.joint_pair(
                FINGER_NAMES[f * 3 + k],
                FINGER_NAMES_RIGHT[f * 3 + k],
                parent,
                FINGER_JOINTS[f * 4 + k],
            )
            parent = b
        }
    }
    // His hair's own bone, where his head's is: it sways about his skull (`with_hair`).
    s.joint("hair", s.find("head"), HEAD_JOINT)
    s
}

/// His hair's bone (`skeleton`'s last).
pub const HAIR_BONE: u32 = 56

/// What his hair sways about, and where its mass is, on him at rest: the middle of his skull,
/// and a point over the back of his crown, in among its spikes.
pub const HAIR_PIVOT: vec3 = vec3(0.0, 1.7, -0.01)
pub const HAIR_MASS: vec3 = vec3(0.0, 1.85, -0.07)

/// His hair's spring (`engine::sway`): stiff and well damped, as spikes held with wax are.
/// It swings four times a second and is still within a quarter of a second, overshooting
/// once and barely; its mass goes no more than 3.5 cm from where his head holds it.
/// (At three swings a second and little damping it swung in time with his sprint's steps,
/// three and a quarter a second, and built up to its limit: his hair pumped at every
/// footfall and wobbled on after he stopped.)
pub const HAIR_SPRING: sway::Spring = sway::Spring { rate: 4.0, damping: 0.6, most: 0.035 }

/// Where his head holds his hair's mass as `palette` poses him: what `sway::Sway::step` is
/// given.
pub fn hair_held(palette: [mat4; 64]) -> vec3 {
    (palette[5] * vec4(HAIR_MASS, 1.0)).xyz
}

/// How far the air he's in pushes his hair's mass back for its speed squared (m for each
/// (m/s)²), and how far at most (m): at a sprint's 5.2 m/s, 2.5 cm, his spikes swept back.
pub const HAIR_BLOWN: f32 = 0.0009
pub const HAIR_BLOWN_MOST: f32 = 0.025

/// Where his hair's mass is from where his head holds it, swaying `sway` (m: `Sway::step`'s
/// answer) in air that meets him at `going` m/s from ahead (as `palette` poses him): its sway
/// and the air's push back along where his hips face, together no further than his hair's
/// spring lets it go.
pub fn hair_blown(palette: [mat4; 64], sway: vec3, going: f32) -> vec3 {
    let ahead = palette[0][2].xyz
    let level = vec3(ahead.x, 0.0, ahead.z)
    if length(level) < 0.2 {
        return sway
    }
    let off = sway - normalize(level) * min(HAIR_BLOWN * going * going, HAIR_BLOWN_MOST)
    let far = length(off)
    if far > HAIR_SPRING.most { off * (HAIR_SPRING.most / far) } else { off }
}

/// `palette` with his hair's bone set: his head's, turned about the middle of his skull so
/// that his hair's mass is `off` (m) from where his head holds it (`sway::Sway::step`'s
/// answer; none: his hair goes with his head). Every palette he's drawn with goes through
/// this: his hair's vertices are on its own bone.
pub fn with_hair(palette: [mat4; 64], off: vec3) -> [mat4; 64] {
    var out = palette
    let pivot = (palette[5] * vec4(HAIR_PIVOT, 1.0)).xyz
    out[HAIR_BONE] = sway::turn_about(pivot, hair_held(palette), off) * palette[5]
    out
}

/// The fingers in their bones' order: index, middle, ring, little finger, thumb.
pub const FINGERS: u32 = 5

/// Each finger's joints at rest (his left hand's): its three, and its tip.
pub const FINGER_JOINTS: [vec3; 20] = [
    vec3(0.8239, 1.4483, -0.0248),
    vec3(0.8565, 1.4471, -0.0252),
    vec3(0.8844, 1.4460, -0.0256),
    vec3(0.9085, 1.4451, -0.0260),
    vec3(0.8219, 1.4508, -0.0503),
    vec3(0.8594, 1.4494, -0.0512),
    vec3(0.8895, 1.4482, -0.0518),
    vec3(0.9200, 1.4471, -0.0525),
    vec3(0.8159, 1.4507, -0.0778),
    vec3(0.8519, 1.4494, -0.0776),
    vec3(0.8801, 1.4483, -0.0773),
    vec3(0.9092, 1.4472, -0.0772),
    vec3(0.8050, 1.4495, -0.1000),
    vec3(0.8366, 1.4483, -0.1010),
    vec3(0.8640, 1.4472, -0.1019),
    vec3(0.8855, 1.4464, -0.1026),
    vec3(0.7403, 1.4280, -0.0243),
    vec3(0.7714, 1.4088, -0.0093),
    vec3(0.7993, 1.3916, 0.0042),
    vec3(0.8265, 1.3748, 0.0173),
]

const FINGER_NAMES = [
    "index 1 left",
    "index 2 left",
    "index 3 left",
    "middle 1 left",
    "middle 2 left",
    "middle 3 left",
    "ring 1 left",
    "ring 2 left",
    "ring 3 left",
    "little 1 left",
    "little 2 left",
    "little 3 left",
    "thumb 1 left",
    "thumb 2 left",
    "thumb 3 left",
]

const FINGER_NAMES_RIGHT = [
    "index 1 right",
    "index 2 right",
    "index 3 right",
    "middle 1 right",
    "middle 2 right",
    "middle 3 right",
    "ring 1 right",
    "ring 2 right",
