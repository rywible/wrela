// Hakuro's turnaround in plain light, as his look was locked (hero-masks v17's sheet): his fields
// realized once as the engine realizes a character, posed as the sheet poses him (his weight on
// his right leg, his left hand on his hip) and drawn five times round, front to back.

use arms::{arm, sampled_body}
use hakuro::{Cloth, body_paint, coat, hands, head, hero, skeleton}
use engine::character::{ByChannels, colours}
use engine::character::skin_matrix
use engine::creature::{Bone, Creature, MAX_BONES, PartMask, Parts, Skeleton}
use engine::look::CreatureLook
use engine::look::Mesh as Tolerance
use engine::plain::{LIGHTS, Lights, View, unlit_shadow, view}
use engine::realize::{Mesh, SkinVertex, Tally, realize_once}
use std::gpu::{
    ClipPosition, ComparisonSampler, Cull, DepthTexture, Flat, GpuBuffer, Unorm8x4, VertexIndex,
    begin_screen_pass_with_depth,
    buffer, comparison_sampler, depth_texture, draw, read, write,
}
use std::io::{Pending, print}
use std::transform::{rotate_y, translate}

/// 1 to stand him in the sheet's pose; 0 at rest, a T-pose (`--set POSED=0`).
pub const POSED: f32 = 1.0

/// The body's grid: cells of about 13 mm (what a realization's scratch has room for over a
/// T-pose's span); the coat's tails', about 7 mm; the head's, about 5 mm.
const HOW = CreatureLook { surface: Tolerance { tolerance: 1.0e-3, radius: 0.021, largest: 0.013 } }
/// His hands' grid: cells of about 6 mm (their fingers are thin).
const HOW_HANDS = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.010, largest: 0.006 },
}
const HOW_COAT = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.012, largest: 0.007 },
}
const HOW_HEAD = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.007, largest: 0.005 },
}

/// The sheet's pose: each bone turned about a world axis by degrees, root to leaf, as the design
/// posed him (hero-masks v17's scene.py).
const POSE: [(Text, vec3, f32); 25] = [
    ("pelvis", vec3(0.0, 0.0, 1.0), 3.0),
    ("pelvis", vec3(0.0, 1.0, 0.0), -6.0),
    ("spine 1", vec3(0.0, 0.0, 1.0), -4.0),
    ("spine 2", vec3(0.0, 0.0, 1.0), -2.0),
    ("spine 3", vec3(1.0, 0.0, 0.0), -3.0),
    ("thigh left", vec3(0.0, 0.0, 1.0), 6.0),
    ("thigh right", vec3(0.0, 0.0, 1.0), -2.0),
    ("thigh left", vec3(1.0, 0.0, 0.0), -6.0),
    ("calf left", vec3(1.0, 0.0, 0.0), 10.0),
    ("foot left", vec3(0.0, 1.0, 0.0), 12.0),
    ("foot right", vec3(0.0, 1.0, 0.0), -8.0),
    ("collarbone left", vec3(0.0, 0.0, 1.0), -6.0),
    ("collarbone right", vec3(0.0, 0.0, 1.0), 4.0),
    ("upper arm left", vec3(0.0, 0.0, 1.0), -53.0),
    ("upper arm right", vec3(0.0, 0.0, 1.0), 78.0),
    ("upper arm left", vec3(0.0, 1.0, 0.0), 4.0),
    ("upper arm right", vec3(1.0, 0.0, 0.0), 4.0),
    ("forearm left", vec3(0.0, 0.0, 1.0), -58.0),
    ("forearm left", vec3(0.0, 1.0, 0.0), 12.0),
    ("hand left", vec3(0.0, 0.0, 1.0), -32.0),
    ("forearm right", vec3(1.0, 0.0, 0.0), -14.0),
    ("neck", vec3(1.0, 0.0, 0.0), 6.0),
    ("head", vec3(1.0, 0.0, 0.0), 10.0),
    ("head", vec3(0.0, 1.0, 0.0), -10.0),
    ("head", vec3(0.0, 0.0, 1.0), 4.0),
]

/// A turn of `degrees` about `axis` (unit) about the point `at`.
fn turn_about(axis: vec3, degrees: f32, at: vec3) -> mat4 {
    let a = degrees * 0.0174532925
    let c = cos(a)
    let s = sin(a)
    let t = 1.0 - c
    let x = axis.x
    let y = axis.y
    let z = axis.z
    let r = mat4(
        vec4(t * x * x + c, t * x * y + s * z, t * x * z - s * y, 0.0),
        vec4(t * x * y - s * z, t * y * y + c, t * y * z + s * x, 0.0),
        vec4(t * x * z + s * y, t * y * z - s * x, t * z * z + c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    translate(at) * r * translate(-at)
}

/// Whether bone `b` is `of` or below it.
fn below(s: Skeleton, b: u32, of: u32) -> bool {
    var i = b
    loop {
        if i == of {
            return true
        }
        let p = s.parent(Bone { index: i }).index
        if p == i {
            return false
        }
        i = p
    }
}

/// His palette in the sheet's pose.
fn posed() -> [mat4; 64] {
    let s = skeleton()
    var m = [translate(vec3(0.0)); 64]
    if POSED < 0.5 {
        return m
    }
    for (name, axis, degrees) in POSE {
        let b = s.find(name).index
        let at = (m[b] * vec4(s.rest(Bone { index: b }), 1.0)).xyz
        let r = turn_about(axis, degrees, at)
        for k in 0..s.len() {
            if below(s, k, b) {
                m[k] = r * m[k]
            }
        }
    }
    m
}

/// The sheet's five views: front, three-quarter, side, back, the other side.
const TURNS = [0.0, -0.7853982, -1.5707963, 3.1415927, 1.5707963]

pub struct State {
    meshes: [Mesh; 7],
    colours: [GpuBuffer<Unorm8x4>; 4],
    palettes: GpuBuffer<mat4>,
    tallies: Vec<Pending<Tally>>,
    shadow: DepthTexture,
    smp: ComparisonSampler,
}

pub fn init() -> State {
    let h = hero()
    let body = realize_once(h, HOW)
    let c0 = colours(body, h.field(), ByChannels {}, cell: 0.005)
    let hd = head()
    let head_mesh = realize_once(hd, HOW_HEAD)
    let c1 = colours(head_mesh, hd.field(), ByChannels {}, cell: 0.002)
    let ct = coat()
    let coat_mesh = realize_once(ct, HOW_COAT)
    let c2 = colours(coat_mesh, ct.field(), ByChannels {}, cell: 0.003)
    let ar = hands()
    let hands_mesh = realize_once(ar, HOW_HANDS)
    let c3 = colours(hands_mesh, ar.field(), ByChannels {}, cell: 0.003)
    let pose = posed()
    var palettes: GpuBuffer<mat4> = buffer(5 * MAX_BONES)
    for v in 0..5 {
        let place = translate(vec3(f32(v) * 1.15 - 2.3, 0.0, 0.0)) * rotate_y(TURNS[v])
        var m = pose
        for k in 0..64 {
            m[k] = place * pose[k]
        }
        write(mut palettes, v * MAX_BONES, m)
    }
    var tallies: Vec<Pending<Tally>> = Vec::new()
    tallies.push(read(body.tally.items()))
    tallies.push(read(head_mesh.tally.items()))
    tallies.push(read(coat_mesh.tally.items()))
    tallies.push(read(hands_mesh.tally.items()))
    let left_arm = arm(0)
    let right_arm = arm(1)
    tallies.push(read(left_arm.tally.items()))
    tallies.push(read(right_arm.tally.items()))
    let skin = sampled_body()
    tallies.push(read(skin.tally.items()))
    State {
        meshes: [body, head_mesh, coat_mesh, hands_mesh, left_arm, right_arm, skin],
        colours: [c0, c1, c2, c3],
        palettes,
        tallies,
        shadow: unlit_shadow(),
        smp: comparison_sampler(),
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    for i in 0..s.tallies.len() {
        if let Some(Ok(v)) = s.tallies[i].poll() {
            let t = v[0]
            print(
                f"mesh {i}: {t.vertices} vertices, {t.pushed_quads} quads, {t.live_blocks} blocks, flags {t.flags}, holes {t.holes}",
            )
        }
    }
    let v = view(
        vec3(0.0, 1.0, 9.0),
        vec3(0.0, 0.95, 0.0),
        0.36,
        f32(width) / f32(height),
        vec3(0.5, 0.8, 0.6),
        4.0,
    )
    var depth = depth_texture(width: width, height: height)
    let pass = begin_screen_pass_with_depth(mut depth, clear: vec4(0.85, 0.82, 0.76, 1.0))
    // (Each of his meshes with its own creature's fields: they're of different types.)
    let fields = (hero(), head(), coat(), hands())
    for k in 0..5 {
        draw(
            pass,
            fielded.bind(
                verts: s.meshes[0].verts.items(),
                palettes: s.palettes.items(),
                first: k * MAX_BONES,
                view: v,
            ),
            fielded_pixel.bind(
                field: fields.0.field(),
                view: v,
                lights: LIGHTS,
                shadow: s.shadow,
                shadow_sampler: s.smp,
            ),
            indices: s.meshes[0].quads.items(),
            indirect: s.meshes[0].draw.items(),
            cull: Cull::Back,
        )
    }
    for k in 0..5 {
        draw(
            pass,
            fielded.bind(
                verts: s.meshes[1].verts.items(),
                palettes: s.palettes.items(),
                first: k * MAX_BONES,
                view: v,
            ),
            fielded_pixel.bind(
                field: fields.1.field(),
                view: v,
                lights: LIGHTS,
                shadow: s.shadow,
                shadow_sampler: s.smp,
            ),
            indices: s.meshes[1].quads.items(),
            indirect: s.meshes[1].draw.items(),
            cull: Cull::Back,
        )
    }
    for k in 0..5 {
        draw(
            pass,
            fielded.bind(
                verts: s.meshes[2].verts.items(),
                palettes: s.palettes.items(),
                first: k * MAX_BONES,
                view: v,
            ),
            fielded_pixel.bind(
                field: fields.2.field(),
                view: v,
                lights: LIGHTS,
                shadow: s.shadow,
                shadow_sampler: s.smp,
            ),
            indices: s.meshes[2].quads.items(),
            indirect: s.meshes[2].draw.items(),
            cull: Cull::Back,
        )
    }
    for k in 0..5 {
        draw(
            pass,
            fielded.bind(
                verts: s.meshes[3].verts.items(),
                palettes: s.palettes.items(),
                first: k * MAX_BONES,
                view: v,
            ),
            fielded_pixel.bind(
                field: fields.3.field(),
                view: v,
                lights: LIGHTS,
                shadow: s.shadow,
                shadow_sampler: s.smp,
            ),
            indices: s.meshes[3].quads.items(),
            indirect: s.meshes[3].draw.items(),
            cull: Cull::Back,
        )
    }
    // (His arms and body, sampled from the reference: no fields to read, so their own normals and his
    // body's paint at their place at rest.)
    for m in 4..7 {
        for k in 0..5 {
            draw(
                pass,
                fielded.bind(
                    verts: s.meshes[m].verts.items(),
                    palettes: s.palettes.items(),
                    first: k * MAX_BONES,
                    view: v,
                ),
                painted_pixel.bind(view: v, lights: LIGHTS, shadow: s.shadow, shadow_sampler: s.smp),
                indices: s.meshes[m].quads.items(),
                indirect: s.meshes[m].draw.items(),
                cull: Cull::Back,
            )
        }
    }
    pass.present()
}

/// What his vertex passes on: where it is, where it is on him at rest, its skin's turn and which
/// of his parts are near (so his pixel reads his fields there, as the opening draws him).
pub struct Fielded: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub rest: vec3,
    pub tx: vec3,
    pub ty: vec3,
    pub tz: vec3,
    pub normal: vec3,
    pub lo: Flat<u32>,
    pub hi: Flat<u32>,
}

@vertex
pub fn fielded(v: VertexIndex, verts: [SkinVertex], palettes: [mat4], first: u32, view: View) -> Fielded {
    let sv = verts[v.index]
    let m = skin_matrix(sv, palettes, first)
    let world = (m * vec4(sv.pos, 1.0)).xyz
    Fielded {
        clip: ClipPosition { position: view.view_proj * vec4(world, 1.0) },
        world,
        rest: sv.pos,
        tx: m[0].xyz,
        ty: m[1].xyz,
        tz: m[2].xyz,
        normal: mat3(m[0].xyz, m[1].xyz, m[2].xyz) * sv.normal,
        lo: Flat { value: sv.mask.lo },
        hi: Flat { value: sv.mask.hi },
    }
}

/// His pixel in plain light, its normal and cloth read from his fields at that point of him (his
/// finer relief, his clothes' edges and folds, finer than his mesh's cells).
@fragment
pub fn fielded_pixel<F: Parts<Cloth>>(
    v: Fielded,
    field: F,
    view: View,
    lights: Lights,
    shadow: DepthTexture,
    shadow_sampler: ComparisonSampler,
) -> vec4 {
    let mask = PartMask { lo: v.lo.value, hi: v.hi.value }
    let (_, grad, c) = field.sample_masked(v.rest, mask, 0.002)
    var n = normalize(mat3(v.tx, v.ty, v.tz) * grad)
    let d = normalize(v.world - view.eye)
    if dot(n, d) > 0.0 {
        n = normalize(n - d * (dot(n, d) + 0.05))
    }
    let lit = lights.shadow(view, v.world, n, shadow, shadow_sampler)
    vec4(lights.light(c.albedo, c.rough, n, v.world, view, lit), 1.0)
}

/// A pixel of a mesh with no fields behind it (his sampled arms), in plain light: its own
/// normal, and his body's paint where it is on him at rest.
@fragment
pub fn painted_pixel(
    v: Fielded,
    view: View,
    lights: Lights,
    shadow: DepthTexture,
    shadow_sampler: ComparisonSampler,
) -> vec4 {
    let c = body_paint(v.rest)
    var n = normalize(v.normal)
    let d = normalize(v.world - view.eye)
    if dot(n, d) > 0.0 {
        n = normalize(n - d * (dot(n, d) + 0.05))
    }
    let lit = lights.shadow(view, v.world, n, shadow, shadow_sampler)
    vec4(lights.light(c.albedo, c.rough, n, v.world, view, lit), 1.0)
}
