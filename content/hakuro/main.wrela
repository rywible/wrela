// Hakuro's turnaround in plain light, as his look was locked (hero-masks v17's sheet): his fields
// realized once as the engine realizes a character, posed as the sheet poses him (his weight on
// his right leg, his left hand on his hip) and drawn five times round, front to back.

use hakuro::{coat, hands, head, hero, skeleton}
use engine::character::{ByChannels, colours}
use engine::creature::{Bone, Creature, MAX_BONES, Skeleton}
use engine::look::CreatureLook
use engine::look::Mesh as Tolerance
use engine::plain::{LIGHTS, coloured, skin_coloured, unlit_shadow, view}
use engine::realize::{Mesh, Tally, realize_once}
use std::gpu::{
    ComparisonSampler, Cull, DepthTexture, GpuBuffer, Unorm8x4, begin_screen_pass_with_depth,
    buffer, comparison_sampler, depth_texture, draw, read, write,
}
use std::io::{Pending, print}
use std::transform::{rotate_y, translate}

/// 1 to stand him in the sheet's pose; 0 at rest, a T-pose (`--set POSED=0`).
pub const POSED: f32 = 1.0

/// The body's grid: cells of about 13 mm (what a realization's scratch has room for over a
/// T-pose's span); the coat's tails', about 7 mm; the head's, about 5 mm.
const HOW = CreatureLook { surface: Tolerance { tolerance: 1.0e-3, radius: 0.021, largest: 0.013 } }
/// His hands' grid: cells of about 6 mm (their fingers are thin).
const HOW_HANDS = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.010, largest: 0.006 },
}
const HOW_COAT = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.012, largest: 0.007 },
}
const HOW_HEAD = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.007, largest: 0.005 },
}

/// The sheet's pose: each bone turned about a world axis by degrees, root to leaf, as the design
/// posed him (hero-masks v17's scene.py).
const POSE: [(Text, vec3, f32); 25] = [
    ("pelvis", vec3(0.0, 0.0, 1.0), 3.0),
    ("pelvis", vec3(0.0, 1.0, 0.0), -6.0),
    ("spine 1", vec3(0.0, 0.0, 1.0), -4.0),
    ("spine 2", vec3(0.0, 0.0, 1.0), -2.0),
    ("spine 3", vec3(1.0, 0.0, 0.0), -3.0),
    ("thigh left", vec3(0.0, 0.0, 1.0), 6.0),
    ("thigh right", vec3(0.0, 0.0, 1.0), -2.0),
    ("thigh left", vec3(1.0, 0.0, 0.0), -6.0),
    ("calf left", vec3(1.0, 0.0, 0.0), 10.0),
    ("foot left", vec3(0.0, 1.0, 0.0), 12.0),
    ("foot right", vec3(0.0, 1.0, 0.0), -8.0),
    ("collarbone left", vec3(0.0, 0.0, 1.0), -6.0),
    ("collarbone right", vec3(0.0, 0.0, 1.0), 4.0),
    ("upper arm left", vec3(0.0, 0.0, 1.0), -58.0),
    ("upper arm right", vec3(0.0, 0.0, 1.0), 78.0),
    ("upper arm left", vec3(0.0, 1.0, 0.0), 4.0),
    ("upper arm right", vec3(1.0, 0.0, 0.0), 4.0),
    ("forearm left", vec3(0.0, 0.0, 1.0), -58.0),
    ("forearm left", vec3(0.0, 1.0, 0.0), 12.0),
    ("hand left", vec3(0.0, 0.0, 1.0), -20.0),
    ("forearm right", vec3(1.0, 0.0, 0.0), -14.0),
    ("neck", vec3(1.0, 0.0, 0.0), 6.0),
    ("head", vec3(1.0, 0.0, 0.0), 10.0),
    ("head", vec3(0.0, 1.0, 0.0), -10.0),
    ("head", vec3(0.0, 0.0, 1.0), 4.0),
]

/// A turn of `degrees` about `axis` (unit) about the point `at`.
fn turn_about(axis: vec3, degrees: f32, at: vec3) -> mat4 {
    let a = degrees * 0.0174532925
    let c = cos(a)
    let s = sin(a)
    let t = 1.0 - c
    let x = axis.x
    let y = axis.y
    let z = axis.z
    let r = mat4(
        vec4(t * x * x + c, t * x * y + s * z, t * x * z - s * y, 0.0),
        vec4(t * x * y - s * z, t * y * y + c, t * y * z + s * x, 0.0),
        vec4(t * x * z + s * y, t * y * z - s * x, t * z * z + c, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    translate(at) * r * translate(-at)
}

/// Whether bone `b` is `of` or below it.
fn below(s: Skeleton, b: u32, of: u32) -> bool {
    var i = b
    loop {
        if i == of {
            return true
        }
        let p = s.parent(Bone { index: i }).index
        if p == i {
            return false
        }
        i = p
    }
}

/// His palette in the sheet's pose.
fn posed() -> [mat4; 64] {
    let s = skeleton()
    var m = [translate(vec3(0.0)); 64]
    if POSED < 0.5 {
        return m
    }
    for (name, axis, degrees) in POSE {
        let b = s.find(name).index
        let at = (m[b] * vec4(s.rest(Bone { index: b }), 1.0)).xyz
        let r = turn_about(axis, degrees, at)
        for k in 0..s.len() {
            if below(s, k, b) {
                m[k] = r * m[k]
            }
        }
    }
    m
}

/// The sheet's five views: front, three-quarter, side, back, the other side.
const TURNS = [0.0, -0.7853982, -1.5707963, 3.1415927, 1.5707963]

pub struct State {
    meshes: [Mesh; 4],
    colours: [GpuBuffer<Unorm8x4>; 4],
    palettes: GpuBuffer<mat4>,
    tallies: Vec<Pending<Tally>>,
    shadow: DepthTexture,
    smp: ComparisonSampler,
}

pub fn init() -> State {
    let h = hero()
    let body = realize_once(h, HOW)
    let c0 = colours(body, h.field(), ByChannels {}, cell: 0.005)
    let hd = head()
    let head_mesh = realize_once(hd, HOW_HEAD)
    let c1 = colours(head_mesh, hd.field(), ByChannels {}, cell: 0.002)
    let ct = coat()
    let coat_mesh = realize_once(ct, HOW_COAT)
    let c2 = colours(coat_mesh, ct.field(), ByChannels {}, cell: 0.003)
    let ar = hands()
    let hands_mesh = realize_once(ar, HOW_HANDS)
    let c3 = colours(hands_mesh, ar.field(), ByChannels {}, cell: 0.003)
    let pose = posed()
    var palettes: GpuBuffer<mat4> = buffer(5 * MAX_BONES)
    for v in 0..5 {
        let place = translate(vec3(f32(v) * 1.15 - 2.3, 0.0, 0.0)) * rotate_y(TURNS[v])
        var m = pose
        for k in 0..64 {
            m[k] = place * pose[k]
        }
        write(mut palettes, v * MAX_BONES, m)
    }
    var tallies: Vec<Pending<Tally>> = Vec::new()
    tallies.push(read(body.tally.items()))
    tallies.push(read(head_mesh.tally.items()))
    tallies.push(read(coat_mesh.tally.items()))
    tallies.push(read(hands_mesh.tally.items()))
    State {
        meshes: [body, head_mesh, coat_mesh, hands_mesh],
        colours: [c0, c1, c2, c3],
        palettes,
        tallies,
        shadow: unlit_shadow(),
        smp: comparison_sampler(),
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    for i in 0..s.tallies.len() {
        if let Some(Ok(v)) = s.tallies[i].poll() {
            let t = v[0]
            print(
                f"mesh {i}: {t.vertices} vertices, {t.pushed_quads} quads, {t.live_blocks} blocks, flags {t.flags}, holes {t.holes}",
            )
        }
    }
    let v = view(
        vec3(0.0, 1.0, 9.0),
        vec3(0.0, 0.95, 0.0),
        0.36,
        f32(width) / f32(height),
        vec3(0.5, 0.8, 0.6),
        4.0,
    )
    var depth = depth_texture(width: width, height: height)
    let pass = begin_screen_pass_with_depth(mut depth, clear: vec4(0.85, 0.82, 0.76, 1.0))
    for k in 0..20 {
        let m = k / 5
        draw(
            pass,
            skin_coloured.bind(
                verts: s.meshes[m].verts.items(),
                colours: s.colours[m].items(),
                palettes: s.palettes.items(),
                first: (k % 5) * MAX_BONES,
                view: v,
            ),
            coloured.bind(view: v, lights: LIGHTS, shadow: s.shadow, shadow_sampler: s.smp),
            indices: s.meshes[m].quads.items(),
            indirect: s.meshes[m].draw.items(),
            cull: Cull::Back,
        )
    }
    pass.present()
}
