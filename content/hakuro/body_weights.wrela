// Hakuro's body's (and jacket's) skin weights: the reference rig's (weights_grids.py).
// 14 x 35 x 11 blocks of 4³ points every 12.0 mm, 1912 stored; a point is two words, its four
// bones and their weights, a byte each.

use skinning::{WeightTables, Weights}
use engine::sampled::words_of

/// Its tables.
pub fn weights() -> WeightTables {
    let grid = Weights {
        origin: vec3(-0.33200, 0.22800, -0.26200),
        cell: 0.01200,
        size: vec3u(14, 35, 11),
        fallback: 3,
    }
    WeightTables { grid, slots: words_of(SLOTS), words: words_of(WORDS) }
}

