// Hakuro's left arm: the reference body's distance sampled every 6 mm (engine::sampled), as the
// idol's parts are, written by /mnt/project-files/hakuro-fit/arms_grid.py from the reference mesh,
// which never ships. From just inside the armhole to the wrist, dressed out where his outfit
// covers it. 28 x 21 x 16 blocks of 4 cells, 1597 stored; a sample is a byte, the
// distance in [-BAND, BAND].

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(0.13900, 1.18900, -0.23100)
pub const CELL: f32 = 0.00550
pub const SIZE: vec3u = vec3u(28, 21, 16)
pub const BAND: f32 = 0.01650

/// Its tables (its vertices to bone `bone`, till they're skinned: `hakuro::arms::skinned`).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

/// Each block's slot (0 outside, 1 inside, 2 + its index stored), x fastest, as base64 words.
