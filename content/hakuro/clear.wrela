// His fists kept off his mask's snout, cheeks and chin. The moves were fitted to a body with a face, not a fox's
// snout 21 cm long: a boxer's guard holds the fists at the chin, where Hakuro's snout is, and
// they went through it. Each fist near the snout is moved off it, the whole arm swung about its
// shoulder (so the elbow and the grip are the move's), by how far it's in, eased so that it
// never pops.

use engine::humanoid::arc
use std::transform::translate

/// The snout's axis in his rest space (the mask's cone, the head scaled 1.1 about its joint):
/// its root and tip, and the cone's radius at each.
const ROOT = vec3(0.0, 1.6792, 0.0783)
const TIP = vec3(0.0, 1.6325, 0.2279)
const R_ROOT: f32 = 0.057
const R_TIP: f32 = 0.019

/// The mask's cheeks (his left's; the right mirrored): their middles and radius, in his rest space.
const CHEEK = vec3(0.0726, 1.6308, 0.0830)
const R_CHEEK: f32 = 0.065

/// The mask's chin, under the snout's root, and its radius.
const CHIN = vec3(0.0, 1.600, 0.090)
const R_CHIN: f32 = 0.045

/// A fist's middle in his rest space (his left; the right mirrored), and its half thickness.
const FIST = vec3(0.795, 1.425, -0.062)
const FIST_R: f32 = 0.056

/// His shoulder joints at rest (his left).
const SHOULDER = vec3(0.212, 1.455, -0.065)

/// The bones of an arm from the upper arm down (his left's; the right's each one more): upper
/// arm, forearm, hand, the old finger and thumb bones, then each finger joint.
fn arm_bone(i: u32, side: u32) -> u32 {
    let b = if i == 0 { 8 } else if i == 1 { 10 } else if i == 2 { 12 } else if i == 3 { 14 } else if i == 4 { 16 } else { 26 + 2 * (i - 5) }
    b + side
}

/// A turn (a rotation matrix) taking `a` onto `b` about the point `at`.
fn swung(a: vec3, b: vec3, at: vec3) -> mat4 {
    let r = arc(a, b).to_mat3()
    translate(at) * mat4(vec4(r[0], 0.0), vec4(r[1], 0.0), vec4(r[2], 0.0), vec4(0.0, 0.0, 0.0, 1.0)) * translate(-at)
}

/// `m` (his palette) with each fist moved off the snout and cheeks.
pub fn fists_off_mask(m: [mat4; 64]) -> [mat4; 64] {
    var out = m
    let root = (m[5] * vec4(ROOT, 1.0)).xyz
    let tip = (m[5] * vec4(TIP, 1.0)).xyz
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        let shoulder = (out[8 + side] * vec4(SHOULDER.x * sx, SHOULDER.y, SHOULDER.z, 1.0)).xyz
        // (Twice: a fist moved off may still graze it.)
        for _ in 0..2 {
            let fist = (out[12 + side] * vec4(FIST.x * sx, FIST.y, FIST.z, 1.0)).xyz
            let e = tip - root
            let h = clamp(dot(fist - root, e) / dot(e, e), 0.0, 1.0)
            var near = root + e * h
            var reach = mix(R_ROOT, R_TIP, h) + FIST_R + 0.025
            // (Or a cheek or the chin, whichever it's deepest in.)
            for c in 0..3 {
                let cx = if c == 0 { 1.0 } else { -1.0 }
                let at = if c < 2 { vec3(CHEEK.x * cx, CHEEK.y, CHEEK.z) } else { CHIN }
                let cheek = (m[5] * vec4(at, 1.0)).xyz
                let rc = (if c < 2 { R_CHEEK } else { R_CHIN }) + FIST_R + 0.025
                if rc - length(fist - cheek) > reach - length(fist - near) {
                    near = cheek
                    reach = rc
                }
            }
            let off = fist - near
            let d = length(off)
            // How far in, eased: nothing well clear, the full depth well in, smooth between.
            let x = reach - d
            let push = 0.5 * (x + sqrt(x * x + 0.0001)) - 0.005
            if push <= 0.0 {
                continue
            }
            // Out from the snout's axis; straight out sideways if the fist is on it.
            let dir = if d > 1.0e-4 { off / d } else { vec3(sx, 0.0, 0.0) }
            let r = swung(fist - shoulder, fist + dir * push - shoulder, shoulder)
            for i in 0..20 {
                let b = arm_bone(i, side)
                out[b] = r * out[b]
            }
        }
    }
    out
}
