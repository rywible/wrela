// Hakuro's trunk, legs and head: the reference body's distance sampled every 7 mm (engine::sampled),
// as his arms are, written by /mnt/project-files/hakuro-fit/body_grid.py from the reference mesh,
// which never ships. Dressed as his outfit has it (the jacket, the neck's wrap, loose trousers)
// with its tailoring in the same distance; his arms cut away at the shoulders; stopped inside his
// boots. 23 x 59 x 17 blocks of 4 cells, 4891 stored; a sample is a byte, the distance in
// [-BAND, BAND].

use engine::sampled::{Lattice, Samples, words_of}

pub const ORIGIN: vec3 = vec3(-0.31400, 0.23600, -0.23400)
pub const CELL: f32 = 0.00700
pub const SIZE: vec3u = vec3u(23, 59, 17)
pub const BAND: f32 = 0.01300

/// Its tables (its vertices to bone `bone`, till they're skinned).
pub fn samples(bone: u32) -> Samples {
    let lattice = Lattice { origin: ORIGIN, cell: CELL, size: SIZE, band: BAND, bone }
    Samples { lattice, slots: words_of(SLOTS), words: words_of(SAMPLES) }
}

