// Hakuro's hard parts as fields, ported from the shapes his look was designed and locked with
// (hero-masks v17): the Hakuro fox mask, the swept spiked hair, the combat boots and the coat's
// tails, and how each is painted. Each is written in the body's rest space (metres; +y up, +z
// ahead, +x his left; his head 1.10 times the body's, about the head's joint), as the design
// had them; a part on a bone moves it to its bone's space (`Abs`).

use std::field::{Surface, smax, smin}

// ---- small fields ---------------------------------------------------------------------------

/// An ellipsoid's distance (the design's: its usual bound, k0 (k0 − 1) / k1).
pub fn ellip(p: vec3, c: vec3, r: vec3) -> f32 {
    let q = (p - c) / r
    let k0 = length(q)
    let k1 = length(q / r)
    k0 * (k0 - 1.0) / max(k1, 1.0e-9)
}

/// The hull of two spheres along a straight axis, its radius changing evenly along it (the
/// design's cone: not the exact hull, near it where the radii are close).
pub fn cone(p: vec3, a: vec3, b: vec3, ra: f32, rb: f32) -> f32 {
    let ba = b - a
    let h = clamp(dot(p - a, ba) / dot(ba, ba), 0.0, 1.0)
    length(p - a - ba * h) - (ra + (rb - ra) * h)
}

/// A 2D triangle's signed distance.
pub fn tri2(p: vec2, a: vec2, b: vec2, c: vec2) -> f32 {
    let e0 = b - a
    let e1 = c - b
    let e2 = a - c
    let v0 = p - a
    let v1 = p - b
    let v2 = p - c
    let pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0)
    let pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0)
    let pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0)
    let s = sign(e0.x * e2.y - e0.y * e2.x)
    let d = min(
        min(
            vec2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x)),
            vec2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x)),
        ),
        vec2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x)),
    )
    -sqrt(d.x) * sign(d.y)
}

/// How far `p` is outside a brush stroke along the quadratic curve A, B, C, `w0` wide at A
/// tapering to `w1` at C (negative inside): the design's painted marks.
pub fn stroke(p: vec2, a: vec2, b: vec2, c: vec2, w0: f32, w1: f32) -> f32 {
    var best = 1.0e9
    var at = 0.0
    var last = a
    for i in 1..13 {
        let t = f32(i) / 12.0
        let u = 1.0 - t
        let q = a * (u * u) + b * (2.0 * u * t) + c * (t * t)
        let e = q - last
        let h = clamp(dot(p - last, e) / max(dot(e, e), 1.0e-12), 0.0, 1.0)
        let d = length(p - last - e * h)
        if d < best {
            best = d
            at = (f32(i - 1) + h) / 12.0
        }
        last = q
    }
    best - mix(w0, w1, at)
}

/// The head's joint, which the head is scaled 1.10 about.
pub const HEAD_JOINT = vec3(0.0, 1.6, -0.017)
pub const HEAD_SCALE: f32 = 1.1

/// A point of the scaled head in the unscaled head's space, where the design wrote the mask and
/// the hair.
pub fn unscaled(p: vec3) -> vec3 {
    HEAD_JOINT + (p - HEAD_JOINT) / HEAD_SCALE
}

// ---- his skull -------------------------------------------------------------------------------

/// His skull's vault, in the unscaled head's space (the body's, measured): what his hair
/// grows from.
pub const CRANIUM_AT = vec3(0.0002, 1.7222, -0.0056)
pub const CRANIUM = vec3(0.0735, 0.0906, 0.1011)

/// How high his chin's underside is (the unscaled head's space): his head is 22.7 cm from
/// there to his crown, 7.5 heads to his height.
pub const CHIN: f32 = 1.586

/// His skull's vault at `p`.
pub fn cranium(p: vec3) -> f32 {
    ellip(p, CRANIUM_AT, CRANIUM)
}

/// His skull at `p` (the unscaled head's space): what his head's wrap lies on, his hair
/// grows from and his mask is shaped to. Its vault, as wide as it is anywhere over his ears;
/// under its front his cheekbones and his upper jaw, a little narrower; and his lower jaw,
/// narrower again at its corners under his ears, its underside rising from his chin back to
/// them, and narrowing forward to a chin 5 cm across; and its base behind his jaw, where his
/// neck comes up into it. In thirds from his chin to his
/// hairline: the foot of his nose, his brow.
pub fn skull(p: vec3) -> f32 {
    let vault = cranium(p)
    // (Its base, behind his jaw and under his ears, as wide as his cheekbones: the vault alone
    // narrows from its middle down, and his head was widest in front of his ears.)
    let base = ellip(p, vec3(0.0, 1.676, -0.022), vec3(0.068, 0.046, 0.062))
    let face = ellip(p, vec3(0.0, 1.668, 0.028), vec3(0.064, 0.050, 0.062))
    var jaw = ellip(p, vec3(0.0, 1.636, 0.018), vec3(0.055, 0.05, 0.068))
    // (His chin: the lowest and the foremost of his jaw, as far forward as his teeth. An
    // ellipsoid's underside alone is lowest at its middle, and his chin fell away.)
    jaw = smin(jaw, ellip(p, vec3(0.0, 1.604, 0.060), vec3(0.025, 0.019, 0.024)), 0.014)
    // (Its sides in to his chin; its underside up from his chin to its corners.)
    jaw = smax(jaw, (abs(p.x) - 0.024 - 0.85 * (p.y - CHIN)) * 0.762, 0.012)
    jaw = smax(jaw, (CHIN + 0.3 * max(0.058 - p.z, 0.0) - p.y) * 0.958, 0.008)
    smin(smin(smin(vault, base, 0.02), face, 0.02), jaw, 0.016)
}

// ---- the mask -------------------------------------------------------------------------------

/// The snout's tip. (It was 2.3 cm longer: from the side the mask read as a beak. And it
/// fell 16° from its root: with his chin down as he carries it, it hung like an anteater's.)
pub const TIP = vec3(0.0, 1.648, 0.176)

/// An ear's height and its width at its base (m).
const EAR_H: f32 = 0.168
const EAR_W: f32 = 0.074

/// A point in an ear's own frame (`side` 1 his left, -1 his right): from the ear's base, x
/// across it, y up it, z out of its front. The ear leans 22° out and 8° back, and its front
/// is turned 20° outward: facing straight ahead, it was a blade's edge from the side. (Leant
/// 16° back, it stood in among his hair's spikes, and one came through its front.)
fn in_ear(p: vec3, side: f32) -> vec3 {
    let d0 = p - vec3(side * 0.066, 1.772, 0.018)
    let d = vec3(
        0.939693 * d0.x - side * 0.342020 * d0.z,
        d0.y,
        side * 0.342020 * d0.x + 0.939693 * d0.z,
    )
    vec3(
        0.927184 * d.x - side * 0.374607 * d.y,
        side * 0.370961 * d.x + 0.918161 * d.y - 0.139173 * d.z,
        side * 0.052135 * d.x + 0.129039 * d.y + 0.990268 * d.z,
    )
}

/// An ear: a tall triangle, thick at its base and thin at its tip, cupped on its front. (A
/// plate 5 mm thick the whole way up, upright, it was a blade from the side.)
fn ear(p: vec3, side: f32) -> f32 {
    let q = in_ear(p, side)
    let up = clamp(q.y / EAR_H, 0.0, 1.0)
    let d2 = tri2(
        q.xy,
        vec2(-EAR_W / 2.0, 0.0),
        vec2(EAR_W / 2.0, 0.0),
        vec2(side * 0.004, EAR_H),
    )
    let across = clamp(abs(q.x) / (EAR_W / 2.0), 0.0, 1.0)
    // (Its back bowed out, its front hollowed: a shell's section, not a board's.)
    let z = q.z + 0.016 * (1.0 - across * across) * (1.0 - 0.5 * up)
    max(d2 - 0.004, abs(z) - mix(0.011, 0.0045, up)) - 0.002
}

/// Where the fur at the mask's cheek ends on his left (the right's mirrored): one short
/// point, swept back and up past the mask's rim.
const TUFT = vec3(0.098, 1.694, 0.004)

/// The fur at the mask's cheek on `side`: one flat point at his cheekbone, swept back and up
/// along the side of his head, part of the mask's own plate. (Two points to a side, low on
/// his jaw and tipped in red, read as barbs stuck on the mask.)
fn tuft(p: vec3, side: f32) -> f32 {
    // (Flat against his head: half as thick out from it as it's wide.)
    let q = vec3(side * p.x, p.y, p.z)
    let flat = vec3(2.0, 1.0, 1.0)
    cone(q * flat, vec3(0.062, 1.666, 0.046) * flat, TUFT * flat, ra: 0.027, rb: 0.003) / 2.0
}

/// How far off his skull his mask's outside is (m): its own thickness and the wrap under it.
pub const MASK_OFF: f32 = 0.010

/// Hakuro's mask, in the unscaled head's space: a fox's face cut to his own. Its shell is
/// his skull's face a centimetre out (`skull`, `MASK_OFF`), from over his brow to under his
/// chin and back round his cheeks to its rim, so it lies on his face everywhere; on it a slim
/// muzzle, a slanted brow ridge over each slit eye, tall ears leaning out from its top
/// corners, and one point of fur at each cheekbone, swept back. (It was first an ellipsoid
/// 2 to 3 cm wider than his head a side with round jowls, a faceplate held in front of him;
/// then an ellipsoid his head's width cut to a wedge, which no longer followed his jaw.)
pub fn fox(p: vec3) -> f32 {
    var face = skull(p) - MASK_OFF
    var sn = cone(p, vec3(0.0, 1.670, 0.060), TIP, ra: 0.040, rb: 0.013)
    sn = smax(sn, -(p.y - 1.604), 0.008)
    face = smin(face, sn, 0.022)
    for s in [1.0, -1.0] {
        // Its brow's ridge, low by the nose and rising outward.
        face = smin(
            face,
            cone(
                p,
                vec3(s * 0.012, 1.724, 0.096),
                vec3(s * 0.070, 1.750, 0.048),
                ra: 0.011,
                rb: 0.005,
            ),
            0.016,
        )
    }
    // Its rim: a little way back round his cheeks, further the further out.
    let rim = 0.030 - 1.5 * p.x * p.x
    var d = smax(face, -(p.z - rim), 0.006)
    // (Open under his chin.)
    d = smax(d, -(p.y - (CHIN - 0.006)), 0.004)
    d = smin(d, min(ear(p, 1.0), ear(p, -1.0)), 0.010)
    // (Its cheeks' fur after the rim's cut: it sweeps back past the rim.)
    d = smin(d, min(tuft(p, 1.0), tuft(p, -1.0)), 0.012)
    // The eye slits, tilted 22°.
    for s in [1.0, -1.0] {
        let q0 = vec2(s * (p.x - s * 0.036), p.y - 1.702)
        let q = vec2(0.927184 * q0.x + 0.374607 * q0.y, -0.374607 * q0.x + 0.927184 * q0.y)
        var e = (length(q / vec2(0.027, 0.0065)) - 1.0) * 0.0065
        e = max(e, -(p.z - 0.02))
        d = smax(d, -e, 0.0015)
    }
    d
}

/// The mask's lacquer and its paint, at `p` (the unscaled head's space): white, vermilion fire
/// marks over the eyes and up the brow, the ears' insides red, a black nose, a red mouth line.
pub fn fox_paint(p: vec3) -> (vec3, f32) {
    let q = vec3(abs(p.x), p.y, p.z)
    let white = vec3(0.66, 0.63, 0.57)
    let red = vec3(0.57, 0.016, 0.007)
    var marks = stroke(
        q.xy,
        vec2(0.012, 1.694),
        vec2(0.044, 1.716),
        vec2(0.086, 1.748),
        w0: 0.0045,
        w1: 0.0006,
    )
    marks = min(
        marks,
        stroke(
            q.xy,
            vec2(0.022, 1.689),
            vec2(0.044, 1.686),
            vec2(0.066, 1.7),
            w0: 0.0018,
            w1: 0.0004,
        ),
    )
    marks = min(
        marks,
        stroke(
            q.xy,
            vec2(0.0, 1.718),
            vec2(0.002, 1.745),
            vec2(0.020, 1.790),
            w0: 0.0055,
            w1: 0.0008,
        ),
    )
    marks = min(
        marks,
        stroke(
            q.xy,
            vec2(0.020, 1.732),
            vec2(0.030, 1.752),
            vec2(0.040, 1.776),
            w0: 0.0035,
            w1: 0.0006,
        ),
    )
    // An ear's inside, on its front: red.
    let e = in_ear(q, 1.0)
    let on_ear = e.y > 0.006 && abs(e.x) < EAR_W
    if on_ear && e.z > -0.004 {
        marks = min(
            marks,
            tri2(e.xy, vec2(-0.023, 0.014), vec2(0.025, 0.014), vec2(0.004, EAR_H - 0.04)),
        )
    }
    if p.y < 1.65 {
        marks = min(
            marks,
            stroke(
                vec2(p.z, p.y),
                vec2(TIP.z - 0.012, 1.641),
                vec2(0.150, 1.634),
                vec2(0.115, 1.636),
                w0: 0.0016,
                w1: 0.0006,
            ),
        )
    }
    var c = if marks < 0.0 { red } else { white }
    // (Its inside and the cut of its rim, dark: lacquered white like its face, its rim's
    // thickness showed from behind as a white band round his head.)
    let rim = 0.030 - 1.5 * p.x * p.x
    let on_its_ear = e.y > -0.004 && abs(e.x) < EAR_W && abs(e.z) < 0.03
    if p.z < rim + 0.002 && !on_its_ear && tuft(q, 1.0) > 0.003 {
        c = vec3(0.02, 0.017, 0.018)
    }
    // (Inside an eye's slit, the dark behind the mask: its walls were lacquer, and a slit seen
    // aslant showed white.)
    let e0 = vec2(q.x - 0.036, p.y - 1.702)
    let slit = vec2(0.927184 * e0.x + 0.374607 * e0.y, -0.374607 * e0.x + 0.927184 * e0.y)
    if length(slit / vec2(0.027, 0.0065)) < 1.06 && p.z > 0.02 {
        c = vec3(0.004, 0.003, 0.004)
    }
    if length((p - TIP) * vec3(1.0, 1.3, 1.0)) < 0.016 {
        c = vec3(0.007, 0.006, 0.007)
    }
    (c, 0.25)
}

// ---- the hair -------------------------------------------------------------------------------

/// The spikes: each a base, a tip, the base's radius and how far it arcs up (m), in the
/// unscaled head's space.
const CLUMPS: [(vec3, vec3, f32, f32); 15] = [
    (vec3(0.0, 1.84, 0.0), vec3(0.0, 1.975, -0.17), 0.040, 0.030),
    (vec3(0.03, 1.82, -0.07), vec3(0.035, 1.905, -0.3), 0.038, 0.030),
    (vec3(-0.03, 1.775, -0.11), vec3(-0.03, 1.765, -0.325), 0.036, 0.022),
    (vec3(0.0, 1.712, -0.12), vec3(0.0, 1.615, -0.255), 0.034, 0.010),
    (vec3(0.035, 1.745, -0.125), vec3(0.085, 1.560, -0.205), 0.040, 0.004),
    (vec3(-0.035, 1.745, -0.125), vec3(-0.085, 1.560, -0.205), 0.040, 0.004),
    (vec3(0.0, 1.790, -0.110), vec3(0.0, 1.735, -0.335), 0.036, 0.015),
    (vec3(0.06, 1.83, -0.02), vec3(0.135, 1.955, -0.14), 0.034, 0.025),
    (vec3(0.08, 1.79, -0.06), vec3(0.205, 1.845, -0.225), 0.034, 0.022),
    (vec3(0.08, 1.73, -0.1), vec3(0.165, 1.675, -0.265), 0.032, 0.012),
    (vec3(0.09, 1.8, -0.02), vec3(0.215, 1.885, -0.06), 0.028, 0.020),
    (vec3(-0.06, 1.83, -0.02), vec3(-0.135, 1.955, -0.14), 0.034, 0.025),
    (vec3(-0.08, 1.79, -0.06), vec3(-0.205, 1.845, -0.225), 0.034, 0.022),
    (vec3(-0.08, 1.73, -0.1), vec3(-0.165, 1.675, -0.265), 0.032, 0.012),
    (vec3(-0.09, 1.8, -0.02), vec3(-0.215, 1.885, -0.06), 0.028, 0.020),
]

/// The hair's centre, which each spike's flat side faces.
const HAIR_CENTRE = vec3(0.0, 1.70, -0.01)

/// How far `p` is from the curve from `a` to `c` bent toward `b` (a quadratic Bézier), and
/// how far along the curve the nearest point is (0 at `a`, 1 at `c`). The curve's nearest
/// point is a cubic's root, solved in closed form.
fn to_curve(p: vec3, a: vec3, b: vec3, c: vec3) -> vec2 {
    let aa = b - a
    let bb = a - b * 2.0 + c
    let cc = aa * 2.0
    let dd = a - p
    let kk = 1.0 / max(dot(bb, bb), 1.0e-9)
    let kx = kk * dot(aa, bb)
    let ky = kk * (2.0 * dot(aa, aa) + dot(dd, bb)) / 3.0
    let kz = kk * dot(dd, aa)
    let pp = ky - kx * kx
    let q = kx * (2.0 * kx * kx - 3.0 * ky) + kz
    let h = q * q + 4.0 * pp * pp * pp
    if h >= 0.0 {
        let r = sqrt(h)
        let (x0, x1) = ((r - q) * 0.5, (-r - q) * 0.5)
        let t = clamp(
            sign(x0) * pow(abs(x0), 1.0 / 3.0) + sign(x1) * pow(abs(x1), 1.0 / 3.0) - kx,
            0.0,
            1.0,
        )
        return vec2(length(dd + (cc + bb * t) * t), t)
    }
    let z = sqrt(-pp)
    let v = acos(clamp(q / (pp * z * 2.0), -1.0, 1.0)) / 3.0
    let (m, n) = (cos(v), sin(v) * 1.7320508)
    let t0 = clamp((m + m) * z - kx, 0.0, 1.0)
    let t1 = clamp((-n - m) * z - kx, 0.0, 1.0)
    let (q0, q1) = (dd + (cc + bb * t0) * t0, dd + (cc + bb * t1) * t1)
    if dot(q0, q0) < dot(q1, q1) { vec2(length(q0), t0) } else { vec2(length(q1), t1) }
}

/// A spike from `a` toward `b` (the design's, shortened to 0.64 of its length), arcing up by
/// `arc`, `r0` thick at its base and flattened 2:1 across its sweep: one curve, its
/// thickness falling evenly to a point. (Five straight lengths joined end to end, it was
/// ringed at each joint, a horn's and not a lock of hair's: a crease where they met, a
/// bulge where they were run together.)
fn blade(p: vec3, a: vec3, b0: vec3, r0: f32, arc: f32) -> f32 {
    let flat = 2.0
    let b = a + (b0 - a) * 0.64
    let r = r0 * 0.82
    // (At least a little arc: a straight line is no curve to solve for.)
    let up = max(arc * 0.7, 0.008)
    let t = normalize(a - HAIR_CENTRE)
    // (Flattened: the space stretched across the spike's sweep, and the spike round in it.)
    let wide = |x: vec3| x + t * ((flat - 1.0) * dot(x - a, t))
    let ctrl = (a + b) * 0.5 + vec3(0.0, up, 0.0)
    let near = to_curve(wide(p), a, wide(ctrl), wide(b))
    (near.x - (r * pow(1.0 - near.y, 0.8) + 0.002) * flat) / flat
}

/// How far off his scalp his hair's body stands at its least (m), and how much further a
/// lock's tip stands off it. (A shell 12 mm off his scalp, smooth, read as hair pressed flat
/// and glued down wherever it wasn't a spike.)
const HAIR_DEEP: f32 = 0.015
const LOCK_HIGH: f32 = 0.014

/// How many locks lie side by side round his head, and how long a lock is (radians of his
/// head's round).
const LOCKS_ROUND: f32 = 11.0
const LOCK_LONG: f32 = 0.36

/// Where his hair runs from, and which way is straight back from there: from his crown, a
/// little forward of the top of his head, down and back all round. (From over his brow, its
/// rows met again at his nape, where his locks drew in to a point as a star.)
const HAIR_FROM: vec3 = vec3(0.0, 0.9404, 0.3401)
const HAIR_OVER: vec3 = vec3(0.0, 0.3401, -0.9404)

/// How far along his hair's run a point of his head is (radians from his crown, toward the
/// foot of his skull), and how far round it (radians from the middle of the back of his head).
fn combed(p: vec3) -> vec2 {
    // (Never divided by less than 2 cm: no hair is that near his head's middle, and a bound
    // worked out over a box that holds the middle would divide by nothing.)
    let from = p - HAIR_CENTRE
    let d = from / max(length(from), 0.02)
    vec2(acos(clamp(dot(d, HAIR_FROM), -1.0, 1.0)), atan2(d.x, dot(d, HAIR_OVER)))
}

/// How far a lock stands off his hair's body at `p` (m): his hair lies in locks, each a
/// tongue that rises from its root to its tip and narrows to a point, a row of them lapping
/// over the roots of the next, each row set half a lock round from the last.
fn locks(p: vec3) -> f32 {
    let at = combed(p)
    let row = at.x / LOCK_LONG
    let t = fract(row)
    let half = 0.5 * (floor(row) - 2.0 * floor(0.5 * floor(row)))
    let across = abs(fract(at.y * LOCKS_ROUND / 6.2831853 + half) - 0.5)
    // (Its width, narrowing to its tip; its height, rising to its tip and rounded off there.)
    let wide = 0.5 * (1.0 - 0.65 * t)
    let round = saturate(1.0 - (across / wide) * (across / wide))
    // (None by his crown, where the rows draw in.)
    let grown = smoothstep(0.3, 0.6, at.x) * (1.0 - smoothstep(2.6, 2.9, at.x))
    LOCK_HIGH * round * smoothstep(0.0, 0.6, t) * (1.0 - smoothstep(0.6, 1.0, t)) * grown
}

/// How low his hair grows at a point round his head (the unscaled head's space): to the tops
/// of his ears at his temples, and down behind them to the foot of his skull, its edge in
/// points, a lock's width each.
pub fn hairline(p: vec3) -> f32 {
    let at = combed(p)
    let point = abs(fract(at.y * LOCKS_ROUND / 6.2831853) - 0.5)
    1.704 - 0.066 * smoothstep(-0.025, -0.075, p.z) + 0.02 * (point - 0.25)
}

/// His hair, in the unscaled head's space, `scalp` how far `p` is from his skull
/// (`skull`): its body, locks lying on one another back over his whole head from his mask's
/// rim to its hairline, and its spikes, swept back out of it.
pub fn hair(p: vec3, scalp: f32) -> f32 {
    var cap = scalp - (HAIR_DEEP + locks(p))
    cap = smax(cap, hairline(p) - p.y, 0.008)
    // (Far from every spike's reach, the cap alone: the spikes are evaluated near the head.)
    if length(p - vec3(0.0, 1.76, -0.12)) < 0.32 {
        for c in CLUMPS {
            // (Only the spikes that could be the nearest: one whose whole reach is further off
            // than what's already found changes nothing. Every pixel of his head read all
            // fifteen, five lengths each.)
            let b = c.0 + (c.1 - c.0) * 0.64
            let reach = 0.5 * length(b - c.0) + c.2 + c.3 + 0.006
            if length(p - (c.0 + b) * 0.5) - reach < cap + 0.004 {
                cap = smin(cap, blade(p, c.0, c.1, c.2, c.3), 0.0025)
            }
        }
    }
    // (Behind his mask: a centimetre and a half behind its ears, which lean back, so they
    // stand clear of it; between them a forelock comes forward to the mask's rim.)
    let behind_ears = 0.004 - 0.14 * (p.y - 1.772)
    let to_rim = 0.022 - 1.5 * p.x * p.x
    let front = mix(to_rim, behind_ears, smoothstep(0.016, 0.03, abs(p.x)))
    smax(cap, p.z - front, 0.016)
}

// ---- the boots ------------------------------------------------------------------------------

fn upper(p: vec3) -> f32 {
    let toe = ellip(p, vec3(0.125, 0.048, 0.082), vec3(0.057, 0.044, 0.080))
    let heel = ellip(p, vec3(0.120, 0.068, -0.090), vec3(0.054, 0.068, 0.058))
    let instep = cone(
        p,
        vec3(0.123, 0.058, 0.025),
        vec3(0.116, 0.140, -0.062),
        ra: 0.056,
        rb: 0.058,
    )
    smin(smin(toe, heel, 0.05), instep, 0.05)
}

/// The left boot's foot (written for x ≥ 0, in the body's rest space): a rounded toe box and
/// heel on a chunky sole with an arch gap.
pub fn boot_foot(p: vec3) -> f32 {
    var up = upper(p)
    up = smax(up, -(p.y - 0.034), 0.003)
    let fp = upper(vec3(p.x, 0.055, p.z)) - 0.010
    var sole = smax(smax(fp, p.y - 0.036, 0.004), -p.y - 0.004, 0.002)
    let arch = smax(
        smax(abs(p.z + 0.012) - 0.030, p.y - 0.012, 0.004),
        abs(p.x - 0.12) - 0.2,
        0.002,
    )
    sole = smax(sole, -arch, 0.004)
    smax(smin(up, sole, 0.003), p.y - 0.19, 0.01)
}

/// The left boot's shaft: an oval tube hugging the shin, pinched at the ankle, flaring over the
/// calf, a padded collar and a pull tab.
pub fn boot_shaft(p: vec3) -> f32 {
    let q = vec3((p.x - 0.120) * 1.22 + 0.120, p.y, p.z)
    var s = cone(q, vec3(0.120, 0.115, -0.068), vec3(0.120, 0.200, -0.066), ra: 0.050, rb: 0.054)
    s = smin(
        s,
        cone(q, vec3(0.120, 0.200, -0.066), vec3(0.120, 0.285, -0.062), ra: 0.054, rb: 0.060),
        0.02,
    )
    let collar = cone(
        q,
        vec3(0.120, 0.282, -0.062),
        vec3(0.120, 0.300, -0.062),
        ra: 0.063,
        rb: 0.063,
    )
    let tab = cone(p, vec3(0.120, 0.282, -0.128), vec3(0.120, 0.318, -0.126), ra: 0.010, rb: 0.008)
    let d = smin(smin(s, collar, 0.005), tab, 0.004)
    smax(d, -(p.y - 0.11), 0.01)
}

/// The boot's leather and its details at `p` (x ≥ 0): matte black, a grey rubber sole and welt,
/// a toe cap seam, light laces criss-crossed down the front between gold eyelets, a padded
/// collar.
pub fn boot_paint(p: vec3) -> (vec3, f32, f32) {
    let ax = abs(p.x)
    var c = vec3(0.010, 0.010, 0.012)
    var rough = 0.75
    var metal = 0.0
    if p.y < 0.0345 {
        c = vec3(0.019, 0.019, 0.024)
    }
    if abs(p.y - 0.0355) < 0.0022 {
        c = vec3(0.055, 0.055, 0.063)
    }
    let cap = abs(length(vec2((ax - 0.125) * 0.9, p.z - 0.105)) - 0.055) - 0.0020
    if cap < 0.0 && p.y > 0.036 && p.y < 0.10 && p.z > 0.05 {
        c = vec3(0.0)
    }
    let zf = mix(0.072, 0.012, clamp((p.y - 0.06) / 0.13, 0.0, 1.0))
    if p.y > 0.058 && p.y < 0.292 && p.z > zf - 0.020 {
        let dx = ax - 0.120
        let u = p.y / 0.020
        if abs(dx) < 0.020 {
            c = vec3(0.022, 0.022, 0.031)
        }
        let l1 = abs(fract(u + dx / 0.040) - 0.5)
        let l2 = abs(fract(u - dx / 0.040) - 0.5)
        if min(l1, l2) < 0.09 && abs(dx) < 0.019 {
            c = vec3(0.21, 0.19, 0.16)
        }
        if length(vec2(abs(dx) - 0.024, (fract(u) - 0.5) * 0.020)) < 0.0032 {
            c = vec3(0.69, 0.45, 0.08)
            rough = 0.3
            metal = 1.0
        }
    }
    if p.y > 0.283 {
        c = vec3(0.022, 0.022, 0.027)
    }
    (c, rough, metal)
}

// ---- the coat's tails -----------------------------------------------------------------------

/// Where the tails hang from: the pelvis's joint, and the band round the hips they start at.
pub const TAILS_AXIS = vec3(0.0, 0.949, -0.043)
pub const TAILS_TOP: f32 = 0.93

/// How far the tails' cloth runs on up inside the jacket, over their top (m).
pub const TAILS_UNDER: f32 = 0.028

/// Where the long jacket's hem is (rest height): the tails carry on below it.
pub const JACKET_HEM: f32 = 0.865

/// How far the tails flare out for each metre they fall (the sheet's A-line).
pub const FLARE: f32 = 0.06

/// The back vent's top (rest height) and half its width at the hem (m).
pub const VENT_TOP: f32 = 0.0
pub const VENT_HALF: f32 = 0.004

/// How far round from straight ahead the tails' edges are at their top (degrees): open in
/// front between.
pub const TAILS_FROM: f32 = 42.0
pub const TAILS_TO: f32 = 318.0

/// How much further round each front edge is cut back by the time it's fallen `CUT_OVER` (m)
/// from the tails' top (degrees): a cutaway coat, its front edges sweeping back from his
/// waist to its long tails behind. (Hanging straight down from his waist, each front edge lay
/// down the middle of a thigh: a thigh lifted in a stride took the edge on its front, and the
/// edge rode it as a ragged line.)
pub const CUT_BACK: f32 = 44.0
pub const CUT_OVER: f32 = 0.34

/// How far round from straight ahead the tails' front edge is at height `y` (degrees; its
/// other edge is as far from straight ahead the other way).
pub fn front_edge(y: f32) -> f32 {
    // (Quickest at his waist, as a tailcoat's front is cut: by a hand's breadth down, the edge
    // is past the front of his thigh. Easing away from his waist, the edge's top corner still
    // lay on his thigh, and a stride lifted it as a small wing at his belt.)
    let t = clamp((TAILS_TOP - y) / CUT_OVER, 0.0, 1.0)
    TAILS_FROM + CUT_BACK * (1.0 - (1.0 - t) * (1.0 - t))
}

/// The tails' girth at their top, from `TAILS_FROM` to `TAILS_TO` every 12° (m from the
/// axis): his jacket's own outside where the tails carry on from it (`hakuro::COAT_SEAM`),
/// read off its charted form, so the coat is one surface across the seam. (His left and his
/// right aren't quite alike: the jacket's form isn't.)
pub const TAILS_GIRTH: [f32; 24] = [
    0.1854, 0.2057, 0.2171, 0.2214, 0.2280, 0.2364, 0.2346, 0.2164, 0.1913, 0.1698, 0.1551, 0.1486,
    0.1489, 0.1549, 0.1696, 0.1917, 0.2160, 0.2346, 0.2368, 0.2275, 0.2216, 0.2171, 0.2074, 0.1988,
]

/// The girth at `deg`: a smooth curve through the table (Catmull-Rom). Straight from one
/// number to the next, the tails' top was 24 flat faces, each lit as its own block.
fn girth(deg: f32) -> f32 {
    let f = clamp((deg - TAILS_FROM) / 12.0, 0.0, 22.999)
    let i = u32(f)
    let t = f - f32(i)
    let p0 = TAILS_GIRTH[if i > 0 { i - 1 } else { 0 }]
    let p1 = TAILS_GIRTH[i]
    let p2 = TAILS_GIRTH[i + 1]
    let p3 = TAILS_GIRTH[min(i + 2, 23)]
    0.5 *
        (2.0 * p1 +
            (p2 - p0) * t +
            (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t * t +
            (3.0 * p1 - p0 - 3.0 * p2 + p3) * t * t * t)
}

/// Where the hem is at `deg` round (y, m): a long back tail, shorter at the front edges,
/// lopsided (his left shorter).
pub fn hem(deg: f32) -> f32 {
    let f = abs(deg - 180.0) / 138.0
    0.30 + 0.26 * pow(f, 1.6) + 0.06 * sin((deg) * 0.0174532925)
}

/// The tails at `p` (the body's rest space): a curtain hanging from the hips round the sides
/// and the back, flaring and folding as it falls, open in front; and how far through it `p` is
/// from its lining (negative on the lining's side).
pub fn tails(p: vec3) -> (f32, f32) {
    let rel = p - TAILS_AXIS
    let r = length(rel.xz)
    var deg = atan2(rel.x, rel.z) * 57.2957795
    if deg < 0.0 {
        deg += 360.0
    }
    let inside = clamp(deg, TAILS_FROM, TAILS_TO)
    let low = hem(inside)
    let tt = clamp((TAILS_TOP - p.y) / (TAILS_TOP - low), 0.0, 1.0)
    let s = (inside - TAILS_FROM) / (TAILS_TO - TAILS_FROM)
    // The sheet's folds: knife pleats, each a panel stepping out over the next with a crisp
    // edge (a sawtooth round, its drop eased so the cloth stays whole), deeper as they fall.
    let f = fract(s * 5.0 + 0.5)
    let saw = f - smoothstep(0.72, 1.0, f) - 0.5 + 0.14
    let fold = (0.05 * pow(tt, 0.6) + 0.006) * saw * 1.4
    // Its drape: on from the jacket at the jacket's own line (the jacket stops where the
    // tails start, `hakuro::COAT_SEAM`: the coat is one line from collar to hem), an A-line
    // from there, its folds coming in over the first hand's breadth and deepening as they
    // fall. (Eased out over his hips from his belt and then hanging straight read as a kilt.
    // Tucked in under a jacket that came 6 cm down over them, the two front edges never met.
    // Its folds starting all at once under the old hem's height, their start was a ridge
    // round his hips that caught the light as a second belt.)
    let down = max(TAILS_TOP - p.y, 0.0)
    let eased = clamp(down / 0.30, 0.0, 1.0)
    // (Its flare eased in over 25 cm: flaring from its very top, the cloth turned up to the
    // light at the seam, and the tails were a lighter piece than the jacket over them.)
    let flare = FLARE * down * smoothstep(0.0, 0.25, down)
    // (Over its top it runs on up inside the jacket, 4 mm inside the jacket's line
    // (`TAILS_UNDER`): its top rim, where its cloth is cut off, is out of sight. Ending at
    // the jacket's foot, the rim showed there as a thin dark line round his waist, and his
    // coat's back was two pieces.)
    // (From a centimetre over the jacket's foot: the cloth's mesh is 7 mm a cell, and a turn
    // inward that started at the foot showed under it as a pale hairline.)
    let tuck = 0.004 * smoothstep(0.0, 0.008, p.y - (TAILS_TOP + 0.007))
    let rr = girth(inside) - 0.009 - tuck + flare + fold * eased * eased * (3.0 - 2.0 * eased)
    var d = abs(r - rr) - 0.009
    // Its front edges: the distance round to the nearer (negative between them).
    let edge = front_edge(p.y)
    d = max(d, max(edge - deg, deg - (360.0 - edge)) * 0.0174532925 * r)
    d = max(d, max(p.y - (TAILS_TOP + TAILS_UNDER), low - p.y))
    // Its vent: split up the middle of the back from the hem, so each side follows its own leg.
    let vent = max(abs(deg - 180.0) * 0.0174532925 * r - VENT_HALF, p.y - VENT_TOP)
    d = max(d, -vent)
    (d, r - rr)
}
