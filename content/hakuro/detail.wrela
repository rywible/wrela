/// The sum's weights and bias (its output in centimetres).
const W3: [f32; 32] = [
    0.268, -0.348, -0.34, 0.37, 0.305, -0.402, -0.36, 0.441, -0.344, -0.268, -0.33, -0.321, -0.288,
    -0.412, 0.316, -0.331, 0.254, 0.472, -0.281, 0.37, -0.311, 0.366, -0.42, -0.296, -0.449, -0.306,
    0.436, -0.375, 0.285, -0.398, 0.352, 0.271,
]
const B3: f32 = -0.0601989

fn ramp(v: f32, lo: f32, hi: f32) -> f32 {
    let t = clamp((v - lo) / (hi - lo), 0.0, 1.0)
    t * t * (3.0 - 2.0 * t)
}

/// Where the detail holds (1) and where his other pieces cover him (0): above his loose
/// trousers, below the collar, short of the wrists.
fn held(p: vec3) -> f32 {
    // (The collar's height only round his neck: his arms reach out at it.)
    let collar = ramp(p.y, lo: 1.50, hi: 1.56) * (1.0 - ramp(abs(p.x), lo: 0.10, hi: 0.16))
    // (Under his jacket and its sleeve, a third of it: cloth softens what's under it. His bare
    // left arm, all of it.)
    let bare = mix(0.35, 1.0, ramp(p.x, lo: 0.14, hi: 0.20))
    ramp(p.y, lo: 0.82, hi: 0.90) *
        (1.0 - collar) *
        (1.0 - ramp(abs(p.x), lo: 0.56, hi: 0.62)) *
        bare
}

/// How far the sculpt's surface is beyond his shapes' at `p` (m; in his rest space).
pub fn detail(p: vec3) -> f32 {
    let w = held(p)
    if w <= 0.0 {
        return 0.0
    }
    let q = (p - CENTRE) * 6.2831853
    var x = [0.0; 48]
    for j in 0..24 {
        let f = dot(q, WAVES[j])
        x[j] = sin(f)
        x[j + 24] = cos(f)
    }
    var h1 = [0.0; 32]
    for i in 0..32 {
        var s = B1[i]
        for j in 0..48 {
            s += W1[i * 48 + j] * x[j]
        }
        h1[i] = sin(s)
    }
    var out = B3
    for i in 0..32 {
        var s = B2[i]
        for j in 0..32 {
            s += W2[i * 32 + j] * h1[j]
        }
        out += W3[i] * sin(s)
    }
    out * 0.01 * w
}

/// His finer form, after his body's pieces (`.then(Detail {})`).
pub struct Detail: Copy + GpuData {}

impl Modifier for Detail {
    fn apply(self, d: f32, p: vec3) -> f32 {
        d + detail(p)
    }

    fn lipschitz(self, inner: f32, near: f32) -> f32 {
        inner + STEEPEST
    }

    fn widen(self, near: f32) -> f32 {
        near + MOST
    }

    /// By how far it can move the distance at most: the network's own derived interval would
    /// be most of a culling pass's shader.
    fn interval(self, d: Interval, b: Box3) -> Interval {
        Interval { lo: d.lo - MOST, hi: d.hi + MOST }
    }
}
