// Written by the forms tool (`wrela tool forms`, studio/forms): don't edit it by hand, change
// the tool or what it fits and write it again. How a limb's form changes where its two joints
// bend (engine::chart::Change): each a form times the bend's angle and a form times its
// square, written for a bend toward angle 0. Solved against the reference body (Quaternius's
// Superhero Male, CC0) posed by its own skin weights, over poses of captured motion
// (studio/forms/joints.wrela).

use engine::chart::Radial

/// The deepest the joint bent among the poses its change was solved over (radians).
pub const SHOULDER_UPTO: f32 = 1.88

/// The deepest the joint bent among the poses its change was solved over (radians).
pub const ELBOW_UPTO: f32 = 2.28

