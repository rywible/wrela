// The grazer as a program. It realizes the grazer's mesh once (sketch 02's extraction) and walks
// it on the spot with sketch 01's cycle, skinned by the palette the gait's pose gives
// (`engine::walk`). The lens draws it too (`wrela tool studio -- content/grazer`).

use creature::{Coat, grazer}
use engine::look::CreatureLook
use engine::render::Shaded
use engine::walk::{Walker, walker}
use std::units::mm

impl Shaded for Coat {
    fn albedo(self) -> vec3 {
        vec3(self.albedo.r, self.albedo.g, self.albedo.b)
    }

    fn roughness(self) -> f32 {
        0.8
    }
}

/// The grazer's mesh: cells of 2 cm.
const LOOK = CreatureLook { surface: engine::look::Mesh { tolerance: 1mm } }

pub fn init() -> Walker {
    walker(grazer(), LOOK)
}

pub fn frame(state: mut Walker, time: f32, width: u32, height: u32) {
    state.frame(grazer(), width, height, eye: vec3(7.0, 2.6, 3.4), at: vec3(0.0, 1.1, 0.7))
}

/// Sketch 01's cycle for 120 frames: the legs keep their bones' lengths, each foot is where
/// the gait puts it within 1 mm (or as near as its leg reaches: the gait's stride overreaches
/// at its ends), the feet come down where they rest and lift, and every bone's matrix is finite.
@test(frames: 120)
fn walks_with_sketch_01s_cycle(state: Walker) {
    let w = state.walked
    assert(w.frames == 120)
    assert(w.finite, "a bone's matrix isn't finite")
    assert(w.length_error < 1.0e-4, f"a bone's length changed by {w.length_error} m")
    assert(w.foot_error < 1mm, f"a foot is {w.foot_error} m from the gait's place, past its reach")
    assert(w.overreached * 2 < 4 * w.frames, f"{w.overreached} feet were beyond their legs' reach")
    assert(abs(w.lowest) < 1mm, f"the lowest a foot went is {w.lowest} m from its rest")
    assert(w.highest > 2.0e-2, f"the highest a foot went is {w.highest} m above its rest")
}
