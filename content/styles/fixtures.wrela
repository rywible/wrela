/// A look for the trait's own test (engine/tests/style): it lights by the form's normal
/// (`NORMAL` 1), draws no marks, and shows the normal it's lit by as a colour (`n · 0.5 + 0.5`),
/// through a lens that leaves it as it is.
pub struct Normals {}

impl Style for Normals {
    const NORMAL: u32 = 1
    type Out = vec4

    fn written(colour: vec4, s: Substance) -> vec4 {
        colour
    }

    fn shade(light: Light, lit: Lit, s: Substance, class: u32, world: vec3, eye: vec3) -> vec3 {
        lit.n * 0.5 + vec3(0.5)
    }

    fn palette(light: Light, class: u32, history: vec4, albedo: vec3) -> vec3 {
        albedo
    }

    fn lens(
        paint: vec3,
        px: vec2,
        d: Develop,
        e: Exposure,
        lut: Texture3d<Rgba8>,
        s: Sampler,
    ) -> vec4 {
        vec4(paint, 1.0)
    }
}

/// A look for the marks' own tests (engine/tests/marks): physical light, its substance written,
/// and round dots `DOT_PX` output pixels apart as its marks (the marks pass's `marks::STROKES`),
/// each a soft disc half its spacing across, a pixel's edge.
pub struct Dotted {}

/// The dots' spacing (output pixels).
pub const DOT_PX: f32 = 12.0

impl Style for Dotted {
    const SUBSTANCE: u32 = substance::ALL
    const MARKS: u32 = marks::LINES | marks::DABS | marks::STROKES
    type Out = Written

    fn written(colour: vec4, s: Substance) -> Written {
        substance::written(colour, s)
    }

    fn shade(light: Light, lit: Lit, s: Substance, class: u32, world: vec3, eye: vec3) -> vec3 {
        Physical::shade(light, lit, s, class, world, eye)
    }

    fn shade_leaf(
        light: Light,
        lit: Lit,
        facing: vec3,
        s: Substance,
        world: vec3,
        eye: vec3,
    ) -> vec3 {
        Physical::shade_leaf(light, lit, facing, s, world, eye)
    }

    fn palette(light: Light, class: u32, history: vec4, albedo: vec3) -> vec3 {
        albedo
    }

    /// A soft disc a quarter of its cell in radius, its edge a pixel wide.
    fn mark(m: MarkSample, s: Substance, depth_px: f32) -> f32 {
        let r = length(m.offset) * m.size_px
        0.5 * (1.0 - smoothstep(m.size_px * 0.25 - 0.5, m.size_px * 0.25 + 0.5, r))
    }

    fn mark_px(kind: u32) -> f32 {
        DOT_PX
    }

    fn lens(
        paint: vec3,
        px: vec2,
        d: Develop,
        e: Exposure,
        lut: Texture3d<Rgba8>,
        s: Sampler,
    ) -> vec4 {
        Physical::lens(paint, px, d, e, lut, s)
    }
}

/// The cel look without its flattening (`FLAT` 0, `engine::style::flattened` folded away), for
/// measuring the flattening's cost: a build of the vale in it against one in `cel::Cel`.
pub struct Unflattened {}

impl Style for Unflattened {
    const SUBSTANCE: u32 = Cel::SUBSTANCE
    const NORMAL: u32 = Cel::NORMAL
    const MARKS: u32 = Cel::MARKS
    const FLAT_CLIP: f32 = Cel::FLAT_CLIP
    const FLAT: f32 = 0.0
    const LINE_DARK: f32 = Cel::LINE_DARK
    type Out = Written

    fn written(colour: vec4, s: Substance) -> Written {
        Cel::written(colour, s)
    }

    fn shade(light: Light, lit: Lit, s: Substance, class: u32, world: vec3, eye: vec3) -> vec3 {
        Cel::shade(light, lit, s, class, world, eye)
    }

    fn shade_leaf(
        light: Light,
        lit: Lit,
        facing: vec3,
        s: Substance,
        world: vec3,
        eye: vec3,
    ) -> vec3 {
        Cel::shade_leaf(light, lit, facing, s, world, eye)
    }

    fn palette(light: Light, class: u32, history: vec4, albedo: vec3) -> vec3 {
        Cel::palette(light, class, history, albedo)
    }

    fn mark(m: MarkSample, s: Substance, depth_px: f32) -> f32 {
        Cel::mark(m, s, depth_px)
    }

    fn lens(
        paint: vec3,
        px: vec2,
        d: Develop,
        e: Exposure,
        lut: Texture3d<Rgba8>,
        s: Sampler,
    ) -> vec4 {
        Cel::lens(paint, px, d, e, lut, s)
    }
}
