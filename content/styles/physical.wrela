// The physical look: light as it falls, through the lens as the frame's look says (`paint::Look`).
// Today's image: the other looks are changes of it, a slot at a time.

use engine::marks
use engine::light::{Light, Lit, tone}
use engine::paint::{Develop, Exposure, graded, hdr_tone}
use engine::style::Style
use engine::substance::Substance
use std::gpu::{Rgba8, Sampler, Texture3d}

/// The physical look (`engine::style::Style`): every constant 0.
pub struct Physical {}

impl Style for Physical {
    /// The characters' lines (`paint::lines`): part of today's look.
    const MARKS: u32 = marks::LINES

    /// The scene's colour alone: it reads no substance.
    type Out = vec4

    fn written(colour: vec4, s: Substance) -> vec4 {
        colour
    }

    /// The light's sum (`light::world`): the matte light and the gloss.
    fn shade(light: Light, lit: Lit, s: Substance, class: u32, world: vec3, eye: vec3) -> vec3 {
        engine::light::world(light, lit, world, eye)
    }

    /// A leaf's matte light, and its gloss on its side that faces the eye.
    fn shade_leaf(
        light: Light,
        lit: Lit,
        facing: vec3,
        s: Substance,
        world: vec3,
        eye: vec3,
    ) -> vec3 {
        engine::light::matte(light, lit, world, eye) +
            engine::light::gloss(light, Lit { n: facing, ..lit }, normalize(eye - world))
    }

    /// The albedo as it is.
    fn palette(class: u32, history: vec4, albedo: vec3) -> vec3 {
        albedo
    }

    /// HDR output with headroom where the screen shows it (`paint::hdr_tone`, no grade);
    /// otherwise the tone curve at the exposure and the look's grade; then, but in the clay view,
    /// the vignette.
    fn lens(
        paint: vec3,
        px: vec2,
        d: Develop,
        e: Exposure,
        lut: Texture3d<Rgba8>,
        s: Sampler,
    ) -> vec4 {
        let look = d.look
        let clay = d.view == 1
        if d.hdr != 0 && !clay {
            // Linear light with headroom (`hdr_tone`): no SDR curve, no display grade.
            let uv = px / d.out - vec2(0.5)
            return vec4(
                hdr_tone(paint * e.value, look.peak) * (1.0 - look.vignette * dot(uv, uv)),
                1.0,
            )
        }
        var c = graded(tone(paint, e.value), lut, s, look.grade)
        if clay {
            return vec4(c, 1.0)
        }
        let uv = px / d.out - vec2(0.5)
        c = c * (1.0 - look.vignette * dot(uv, uv))
        vec4(c, 1.0)
    }
}
