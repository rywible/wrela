// The trees grown (docs/plan-world-class-3.md §E1.3): each living kind (`kinds`) an archetype, its
// species' tree grown from its genome (`genomes`, `engine::growth::grow_graph`) at its class's
// median site (an age class, and the open or a stand), at build; then scaled to the kind's built
// height, so an instance is placed as before. The plants are kept as bytes (`GROWN`: each
// limb's points and radii and each clump as half floats), a constant of the build, read back by
// `kinds::kind_plant` into its kind's leaves and bark.
//
// The plan's archetypes are 70 (seven species × five age classes × open and under). The memory
// gate decides their count (§E1.3: the vale's GPU peak, 539.8 MiB on `main`, is already over its
// 512), so the living kinds' number holds: each kind's form (its species, open or forest, young or
// ancient) is one archetype grown, where it was a shape authored by hand. The dead are grown too:
// a fallen tree (§E4) a grown trunk laid, a standing one (§E8) a grown tree broken and its small
// wood shed (`dead`). The great tree (the floor's alone: a character of its lore) and the two far
// kinds no program places stay authored.

use engine::growth::{Grow, GrowthEvent, Site, convert, fungi_on, grow_graph, scale}
use land::grow::{NO_EVENT, Tree, events_of, light_at}
use engine::plant::{Bark, Clump, Leaves, MAX_CLUMPS, MAX_LIMBS, Plant}
use genomes::genomes
use kinds::{
    ALDER_A, ALDER_B, BEECH_ANCIENT, BEECH_FOREST, BEECH_OPEN, BIRCH_FOREST, BIRCH_OPEN, BUILT,
    HAWTHORN, KINDS, LOG_LONG, LOG_SHORT, OAK_ANCIENT, OAK_FOREST, OAK_OPEN, PINE_FOREST, PINE_OPEN,
    SLOE, SNAG_BROAD, SNAG_BURNT, SNAG_FORKED, SNAG_PINE, SNAG_STUMP, YOUNG_BROAD, YOUNG_PINE,
}
use species::{HABITS, Species}
use std::field::Tube
use std::gpu::Half2

/// An archetype: its species, the age it's grown to (years), the stand round it (`Site::stand`:
/// 0 the open) and its seed.
pub struct Archetype: Copy {
    pub species: u32,
    pub age: f32,
    pub stand: f32,
    pub seed: u32,
}

/// Kind `k`'s archetype, if it's grown (**proposed** ages: a mature tree at about a quarter of
/// its species' life, an ancient at two thirds, the young a beech of 12 years (about its built
/// 3 m) and a pine of 35 (the youngest the pine's strong leader grows a cone of laterals by: at 8
/// or 20 a stick); a forest's stand 1 for the oak
/// and the beech, 0.6 for the birch and the pine, whose crowns a closer stand left a tuft; the open
/// pine's 0.35, its neighbours' shade on its foot: grown alone it kept a live limb at 2 m, and
/// under a browse line few of its forks cleared it, too few for neighbours to fork apart).
pub fn archetype(k: u32) -> Option<Archetype> {
    let (species, age, stand) = if k == OAK_OPEN {
        (Species::Oak, 150.0, 0.0)
    } else if k == OAK_FOREST {
        (Species::Oak, 150.0, 1.0)
    } else if k == OAK_ANCIENT {
        (Species::Oak, 400.0, 0.0)
    } else if k == BEECH_OPEN {
        (Species::Beech, 120.0, 0.0)
    } else if k == BEECH_FOREST {
        (Species::Beech, 120.0, 1.0)
    } else if k == BEECH_ANCIENT {
        (Species::Beech, 260.0, 0.0)
    } else if k == BIRCH_OPEN {
        (Species::Birch, 50.0, 0.0)
    } else if k == BIRCH_FOREST {
        (Species::Birch, 50.0, 0.6)
    } else if k == PINE_OPEN {
        (Species::Pine, 100.0, 0.35)
    } else if k == PINE_FOREST {
        (Species::Pine, 100.0, 0.6)
    } else if k == ALDER_A {
        (Species::Alder, 60.0, 0.0)
    } else if k == ALDER_B {
        (Species::Alder, 60.0, 0.6)
    } else if k == HAWTHORN {
        (Species::Thorn, 40.0, 0.0)
    } else if k == SLOE {
        (Species::Sloe, 25.0, 0.0)
    } else if k == YOUNG_BROAD {
        (Species::Beech, 12.0, 0.0)
    } else if k == YOUNG_PINE {
        (Species::Pine, 35.0, 0.0)
    } else if k == LOG_SHORT {
        (Species::Beech, 90.0, 0.9)
    } else if k == LOG_LONG {
        (Species::Oak, 150.0, 0.9)
    } else if k == SNAG_BROAD {
        (Species::Oak, 120.0, 0.8)
    } else if k == SNAG_BURNT || k == SNAG_STUMP {
        (Species::Oak, 90.0, 0.8)
    } else if k == SNAG_PINE {
        (Species::Pine, 100.0, 0.6)
    } else if k == SNAG_FORKED {
        (Species::Oak, 70.0, 0.4)
    } else {
        return None
    }
    Some(Archetype { species: u32(species), age, stand, seed: 101 + k })
}

/// Kind `k`'s archetype grown and scaled to its built height (`BUILT`): at build only (a veteran's
/// growth takes seconds). A log's (`LOG_SHORT`, `LOG_LONG`) is laid (`laid`).
pub fn grown(k: u32, a: Archetype) -> Plant {
    let g = genomes()[a.species]
    // The forked snag's fork a gale's, in its youth (E1.2's fork: a lateral took the broken leader's
    // place).
    var events: Vec<GrowthEvent> = Vec::new()
    if k == SNAG_FORKED {
        events.push(GrowthEvent { age: 30.0, kind: engine::growth::GALE, strength: 0.9 })
    }
    var t = grow_graph(g, Site { age: a.age, stand: a.stand }, [], vec2(0.0), events, a.seed)
    let alive_tall = t.height
    if let Some((broke, shed)) = dead(k, a.seed) {
        engine::growth::die(mut t, broke * alive_tall, shed)
    }
    var p = engine::plant::plant(Leaves {}, Bark {})
    let _ = convert(t, g, mut p)
    if k == LOG_SHORT || k == LOG_LONG {
        return laid(p, BUILT[k], if k == LOG_LONG { 0.5 } else { 0.28 }, a.seed)
    }
    if dead(k, a.seed).is_some() {
        // Standing dead: no leaves, and scaled by the height it stood alive (`BUILT` is a snag's
        // living height: its instance is scaled to its record's).
        p.clumps.clear()
        scale(mut p, BUILT[k] / max(alive_tall, 1.0e-3))
        return p
    }
    let s = BUILT[k] / max(p.top(), 1.0e-3)
    scale(mut p, s)
    p
}

/// A standing dead kind's break (a share of its living height) and the thinnest wood it keeps (m,
/// before it's scaled), if `k` is one, drawn from its seed in each form's range (the hand's
/// snags', **proposed**): a broad-leaved snag rotted from its top, most of it standing; a burnt
/// one broken lower; a stump with its shard low; a forked one burnt to its fork; a pine's keeping
/// its spiky branches, which rot slowly.
fn dead(k: u32, seed: u32) -> Option<(f32, f32)> {
    let u = engine::growth::Rng::keyed(seed).unit()
    if k == SNAG_BROAD {
        Some((mix(0.75, 0.95, u), 0.04))
    } else if k == SNAG_BURNT {
        Some((mix(0.55, 0.85, u), 0.06))
    } else if k == SNAG_STUMP {
        Some((mix(0.25, 0.4, u), 0.12))
    } else if k == SNAG_FORKED {
        Some((mix(0.65, 0.8, u), 0.05))
    } else if k == SNAG_PINE {
        Some((mix(0.75, 0.95, u), 0.015))
    } else { None }
}

/// A fallen tree (§E4's deadwood) from its grown plant `p`, laid along +z on the ground (its foot
/// at the origin, its trunk's middle its radius up), `long` m long and `girth` m round its foot's
/// radius: its trunk one tube from its foot
/// to a short break where its kept wood ends (its pieces' line, those at least a fifth its foot's
/// radius: its crown gone; the hand's root plate is added to it, `grown_into`); and its bracket fungi
/// (`growth::fungi_on` at its full rot) as flat clumps on its side, whose cards show past
/// `BRACKETS_FROM` (`Leaves::after`, in its kind's leaves).
fn laid(p: Plant, long: f32, girth: f32, seed: u32) -> Plant {
    var out = engine::plant::plant(Leaves {}, Bark {})
    let r0 = p.limbs[0].radii[0]
    // The trunk's line: its first limb, and each that starts where the last ended, nearly as
    // thick, while it's thick enough to keep.
    var trunk: Vec<bool> = Vec::filled(p.limbs.len(), value: false)
    trunk[0] = true
    var end = p.limbs[0]
    var going = true
    while going {
        going = false
        for i in 1..p.limbs.len() {
            let l = p.limbs[i]
            if !trunk[i] &&
                l.radii[0] >= 0.2 * r0 &&
                length(l.points[0] - end.points[3]) < 0.5 * end.radii[3] + 1.0e-3 &&
                l.radii[0] >= 0.6 * end.radii[3] {
                trunk[i] = true
                end = l
                going = true
                break
            }
        }
    }
    // Laid straight along +z from its foot to its break, its grown taper kept (laid as it grew,
    // its lean ran the log off its own line).
    // Its girth the fallen kind's (`girth` at its foot: its radii scaled apart from its length, a
    // short bole stretched to its length was a metre thick).
    let rs = girth / max(r0, 1.0e-3)
    let (r, r_end) = (girth, end.radii[2] * rs)
    // Its foot closed by a short piece swelling from a stub, as the hand's log's (a tube's start is
    // open: begun at its girth, its rim read as a lid on the log's end at the eye, shot 7).
    out.tube(
        [
            vec3(0.0, r, -0.25 * r),
            vec3(0.0, r, 0.35 * r),
            vec3(0.0, r_end, long - r_end * 0.5),
            vec3(0.0, r_end, long),
        ],
        [0.35 * r, r, r_end, r_end],
    )
    for f in fungi_on(1.0, long, seed) {
        let side = if f.x > 0.5 { 1.0 } else { -1.0 }
        out.cushion(vec3(side * r * 0.9, r * 1.2, f.x * long * 0.85), f.y * 1.5, 0.3)
    }
    out
}

/// The grown kinds' plants as bytes, one after another in the kinds' order (a kind not grown
/// none): `grown_into`'s.
@fuel(2 ** 44)
pub const GROWN: Vec<u8> = grown_bytes()

fn grown_bytes() -> Vec<u8> {
    var out: Vec<u8> = Vec::new()
    for k in 0..KINDS {
        if let Some(a) = archetype(k) {
            put(mut out, grown(k, a))
        }
    }
    out
}

/// Its words, little-endian.
fn put_u32(out: mut Vec<u8>, x: u32) {
    for i in 0..4 {
        out.push(u8((x >> (8 * i)) & 255))
    }
}

fn get_u32(b: [u8], at: u32) -> u32 {
    u32(b[at]) | (u32(b[at + 1]) << 8) | (u32(b[at + 2]) << 16) | (u32(b[at + 3]) << 24)
}

/// Two values as half floats, a word.
fn put_pair(out: mut Vec<u8>, a: f32, b: f32) {
    put_u32(mut out, Half2::encode(vec2(a, b)).bits)
}

fn get_pair(b: [u8], at: u32) -> vec2 {
    Half2 { bits: get_u32(b, at) }.decode()
}

/// A plant's geometry: its limbs' and clumps' counts (a word), each limb's twelve coordinates and
/// four radii (eight words), each clump's centre, radius and squash (three words).
fn put(out: mut Vec<u8>, p: Plant) {
    put_u32(mut out, p.limbs.len() | (p.clumps.len() << 16))
    for i in 0..p.limbs.len() {
        let l = p.limbs[i]
        let (a, b, c, d) = (l.points[0], l.points[1], l.points[2], l.points[3])
        put_pair(mut out, a.x, a.y)
        put_pair(mut out, a.z, b.x)
        put_pair(mut out, b.y, b.z)
        put_pair(mut out, c.x, c.y)
        put_pair(mut out, c.z, d.x)
        put_pair(mut out, d.y, d.z)
        put_pair(mut out, l.radii[0], l.radii[1])
        put_pair(mut out, l.radii[2], l.radii[3])
    }
    for i in 0..p.clumps.len() {
        let c = p.clumps[i]
        put_pair(mut out, c.centre.x, c.centre.y)
        put_pair(mut out, c.centre.z, c.radius)
        put_pair(mut out, c.squash, 0.0)
    }
}

/// Kind `k`'s grown geometry from `GROWN` into `p` (its limbs and clumps replaced, its leaves
/// and bark kept), if `k` is grown (in place: a plant is 130 KB, and a debug build's stack holds
/// few).
pub fn grown_into(k: u32, p: mut Plant) {
    if archetype(k).is_none() {
        return
    }
    // A fallen tree keeps its hand's root plate (its stubs after its trunk: an uprooted tree reads
    // by its plate), its trunk grown.
    var plate: Vec<Tube<4>> = Vec::new()
    if k == LOG_SHORT || k == LOG_LONG {
        for i in 1..p.limbs.len() {
            plate.push(p.limbs[i])
        }
    }
    var at = 0
    for j in 0..k {
        if archetype(j).is_some() {
            let counts = get_u32(GROWN, at)
            at += 4 + 32 * (counts & 65535) + 12 * (counts >> 16)
        }
    }
    let counts = get_u32(GROWN, at)
    let (limbs, clumps) = (min(counts & 65535, MAX_LIMBS), min(counts >> 16, MAX_CLUMPS))
    at += 4
    p.limbs.clear()
    p.clumps.clear()
    for _ in 0..limbs {
        let w = |i: u32| get_pair(GROWN, at + 4 * i)
        let (p0, p1, p2, p3, p4, p5, r0, r1) = (w(0), w(1), w(2), w(3), w(4), w(5), w(6), w(7))
        p.tube(
            [
                vec3(p0.x, p0.y, p1.x),
                vec3(p1.y, p2.x, p2.y),
                vec3(p3.x, p3.y, p4.x),
                vec3(p4.y, p5.x, p5.y),
            ],
            [r0.x, r0.y, r1.x, r1.y],
        )
        at += 32
    }
    for _ in 0..clumps {
        let (c0, c1, c2) = (get_pair(GROWN, at), get_pair(GROWN, at + 4), get_pair(GROWN, at + 8))
        p.cushion(vec3(c0.x, c0.y, c1.x), c1.y, c2.x)
        at += 12
    }
    for l in plate {
        p.tube(l.points, l.radii)
    }
}

/// The oldest a near individual is grown to (years: **proposed**).
pub const GROWN_AGE: f32 = 120.0

/// Whether kind `k` is grown alive (an archetype, not a fallen or a standing dead tree's), so a
/// tree drawn as it can be a near individual.
pub fn grows(k: u32) -> bool {
    archetype(k).is_some() && k != LOG_SHORT && k != LOG_LONG && dead(k, 0).is_none()
}

/// Whether tree `t`, drawn as kind `k`, is drawn as itself near the eye at `present`: its kind
/// grown, not a fallen tree's, and it no older than `GROWN_AGE`.
pub fn grows_as_itself(t: Tree, k: u32, present: i32) -> bool {
    grows(k) && present - t.born <= i32(GROWN_AGE)
}

/// Tree `t` (drawn as kind `k`) as a near individual's growth (§E1.3), if its kind is grown: its
/// species' genome, its age at `present`, its light each year and its events from its own history
/// (`land::grow::light_at`, `events_of`: no neighbour's record read), its own seed, its kind's
/// leaves and bark, its kind's stand and height (so it's placed as its archetype is).
pub fn individual(t: Tree, k: u32, present: i32) -> Option<Grow> {
    // Not a fallen tree (drawn as its laid kind), nor one older than `GROWN_AGE` (its archetype's
    // veteran form is grown to its full age: a veteran grown to `GROWN_AGE` and stretched to its
    // height was a young tree's thin trunk).
    if !grows_as_itself(t, k, present) {
        return None
    }
    let a = archetype(k)?
    let species = min(t.kind, u32(Species::Alder))
    let h = HABITS[species]
    // Its age, to `GROWN_AGE` at most (a veteran's form is set long before; its growth's cost
    // grows faster than its years: a 200-year oak's 1.2 s, docs/bench.md "E1.2").
    let age = clamp(f32(present - t.born), 1.0, GROWN_AGE)
    var light: Vec<f32> = Vec::new()
    for y in 0..u32(ceil(age)) {
        let (l, _) = light_at(t, h, f32(y))
        light.push(l)
    }
    var events: Vec<GrowthEvent> = Vec::new()
    for e in events_of(t) {
        if e.kind != NO_EVENT {
            events.push(
                GrowthEvent {
                    age: f32(i32(e.year) - t.born),
                    kind: u32(e.kind),
                    strength: f32(e.strength) / 255.0,
                },
            )
        }
    }
    // Its leaves as large as its kind's look's once its instance's scale (its height against its
    // kind's built one: `kinds::scale_of`) is on them: its plant is its own (a young broadleaf
    // 2.6 times its built 3 m had leaves a third of a metre across at the eye).
    let look = kinds::LOOKS[k].0
    let leaves = Leaves {
        size: look.size * clamp(1.0 / kinds::scale_of(k, kinds::drawn_tall(k, t.tall)), 0.5, 2.0),
        ..look,
    }
    Some(
        Grow {
            genome: genomes()[species],
            site: Site { age, stand: a.stand },
            light,
            events,
            seed: t.seed,
            leaves,
            bark: kinds::LOOKS[k].1,
            blend: kinds::LOOKS[k].2,
            height: BUILT[k],
        },
    )
}
