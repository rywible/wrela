// The cello's body and level. The body is the one the audio tool's `track` fits to a
// recording's own harmonics (a source and a body, by least squares), then trimmed note by note:
// each note's harmonics in the cello's playing of the passage are set beside the same note's in
// the recording (`follow`), and each band moved toward the middle of what its harmonics are
// off, by at most 10 dB in all, and smoothly from band to band, so the trim can't carve the body
// to hide something else. The recording's source and licence are in docs/citations.md.

use strings::Voicing

pub const BOWED: Voicing = Voicing {
    body: [
        -37.40, -35.50, -32.90, -27.60, -19.10, -11.70, -6.50, -2.40, -14.80, -13.70, -1.50, -7.40,
        -14.50, -6.30, 5.40, 3.90, -2.70, 0.80, 0.90, 1.60, 0.20, -9.00, -2.70, 3.30, 4.60, -3.30,
        -2.70, -2.40, -3.30, -2.30, -3.10, -1.40, 3.50, -2.30, -1.90, -5.40, -7.70, -9.00, -10.80,
        -12.30, -14.50, -19.50, -18.10, -17.10, -15.80, -12.30, -11.90, -13.40,
    ],
    gain: -0.60,
}
