// The wolf as a program. It realizes the wolf's mesh once and walks it round a circle on flat
// ground by the engine's gait, in plain light (`engine::plain::Viewer`). The lens draws it too
// (`wrela tool studio -- content/wolf`).

use creature::{Coat, wolf, walker_body}
use engine::look::CreatureLook
use engine::character::Shaded
use engine::plain::{Viewer, viewer}
use std::derive::Box3
use std::field::part_share
use std::units::mm

/// A box around the wolf, from the ground up: where its test samples its points.
const AROUND: Box3 = Box3 { lo: vec3(-0.3, -0.02, -0.85), hi: vec3(0.3, 1.1, 0.85) }

impl Shaded for Coat {
    fn albedo(self) -> vec3 {
        vec3(self.albedo.r, self.albedo.g, self.albedo.b)
    }

    fn roughness(self) -> f32 {
        0.8
    }
}

/// The wolf's mesh: cells of about 1.4 cm.
const LOOK = CreatureLook { surface: engine::look::Mesh { tolerance: 0.5mm } }

pub fn init() -> Viewer {
    viewer(wolf(), LOOK, walker_body())
}

pub fn frame(state: mut Viewer, time: f32, width: u32, height: u32) {
    state.frame(wolf(), width, height, eye: vec3(6.5, 2.2, 3.0), at: vec3(0.0, 0.45, 0.0))
}

/// The engine's gait for 120 frames: the legs keep their bones' lengths, the soles come down on
/// the ground (its paw joint rolls up to 12.5 mm under its rest height at the end of a stance) and lift, and every bone's matrix is finite.
@test(frames: 120)
fn walks_by_the_engines_gait(state: Viewer) {
    let w = state.walked
    assert(w.frames == 120)
    assert(w.finite, "a bone's matrix isn't finite")
    assert(w.length_error < 1.0e-5, f"a bone's length changed by {w.length_error} m")
    assert(abs(w.lowest) < 15mm, f"the lowest a sole went is {w.lowest} m from the ground")
    assert(w.highest > 2.0e-2, f"the highest a sole went is {w.highest} m above the ground")
}

@test
fn each_part_shares_the_surface_where_it_decides_it() {
    let f = wolf().field()
    var i = 0
    var checked = 0
    while checked < 128 {
        let p = AROUND.sample(3, i)
        i += 1
        if abs(f.distance(p)) > 0.01 {
            continue
        }
        let part = f.part_at(p).1
        assert(
            part_share(f, p, part) != 0.0,
            f"part {part} doesn't share the surface it decides at ({p.x}, {p.y}, {p.z})",
        )
        checked += 1
    }
    // Far from its blends a part has no share: the nose, at the tail's tip; and an ear, at its
    // own image.
    let tail = f.part_at(vec3(0.0, 0.31, -0.69))
    let nose = f.part_at(vec3(0.0, 0.87, 0.82)).1
    assert(part_share(f, vec3(0.0, 0.31, -0.69), nose) == 0.0)
    assert(part_share(f, vec3(0.0, 0.87, 0.82), tail.1) == 0.0)
    let ear = vec3(0.06, 1.02, 0.55)
    let (left, right) = (f.part_at(ear).1, f.part_at(vec3(-0.06, 1.02, 0.55)).1)
    assert(left != right)
    assert(part_share(f, ear, left) > 0.5 && part_share(f, ear, right) == 0.0)
}
