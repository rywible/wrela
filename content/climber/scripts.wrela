// The fight's scripts of input: `wrela script content/climber scripts::FIGHT` writes one for the
// native host to play (`wrela-host <build> --ticks n --input <file>`).

use std::input::{PadAxis, PadButton, Script}

/// The scripted fight: the test bot's presses (`bot` in tests.wrela), its stick rounded to
/// hundredths, for the native host to play in examples/climber-lab.
