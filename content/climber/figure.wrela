// The climber's figure: its simulated garment, stepped each frame from where the body stands
// and its pose. It's presentation: the frames step it, so the fight's state and its replays
// don't carry presentation cloth.

use cape::{Cape, Plane, POINTS, body_frame, hang}
use moves::Pose

/// How far the body may move in a frame before the figure is hung afresh where it is, not
/// stepped (m): a travel, a new shot.
const JUMP: f32 = 1.0

/// The figure: its garment, hung at the first step, and the body's velocity as it was last
/// stepped (m/s; the licks of shadow at the hem lean back from it).
pub struct Figure {
    pub cape: Option<Cape>,
    pub velocity: vec3,
}

pub fn figure() -> Figure {
    Figure { cape: None, velocity: vec3(0.0) }
}

impl Figure {
    /// The figure `dt` seconds on: the body at `feet`, facing `heading`, in `pose`, gone (a
    /// blink) or not, on `ground`, in `wind` (m/s).
    pub fn step(
        mut self,
        feet: vec3,
        heading: f32,
        pose: Pose,
        gone: bool,
        ground: Plane,
        wind: vec3,
        dt: f32,
    ) {
        let frame = body_frame(feet, heading, pose.form)
        var fresh = false
        var cape = match replace(mut self.cape, None) {
            Some(it) => take it,
            None => {
                fresh = true
                hang(frame)
            },
        }
        let moved = (frame * vec4(0.0, 0.0, 0.0, 1.0)).xyz -
            (cape.frame * vec4(0.0, 0.0, 0.0, 1.0)).xyz
        // A blink carries the whole garment together, its folds and its train as they are. A
        // travel or a new shot puts the body somewhere else, maybe facing elsewhere: the garment
        // hangs there afresh, its train behind it.
        if length(moved) > JUMP && !gone {
            cape = hang(frame)
            fresh = true
        } else if gone {
            cape.carry(moved)
        }
        cape.step(frame, gather: pose.form.gather, ground: ground, wind: wind, dt: dt)
        self.velocity = if fresh || gone || dt <= 1.0e-4 { vec3(0.0) } else { moved / dt }
        self.cape = Some(take cape)
    }

    /// The whole figure moved by `by`, as it is (the floor's render origin moved).
    pub fn carry(mut self, by: vec3) {
        match mut self.cape {
            Some(c) => c.carry(by),
            None => {},
        }
    }

    /// The garment's points, for a buffer (none before its first step).
    pub fn points(self) -> Vec<vec4> {
        var out: Vec<vec4> = Vec::new()
        match self.cape {
            Some(c) => {
                for k in 0..POINTS {
                    out.push(vec4(c.at[k], 1.0))
                }
            },
            None => {},
        }
        out
    }

    /// Where the end of the robe's train lies (none before the first step).
    pub fn train_end(self) -> Option<vec3> {
        match self.cape {
            Some(c) => Some(c.at[cape::point(cape::AROUND / 2, cape::DOWN - 1)]),
            None => None,
        }
    }
}

// ---- tests -------------------------------------------------------------------------------------

/// A frame of the figure standing still at `at`, facing `heading`, on level ground.
fn still(f: mut Figure, at: vec3, heading: f32) {
    f.step(
        at,
        heading,
        moves::REST,
        gone: false,
        ground: cape::flat(0.0),
        wind: vec3(0.0),
        dt: 1.0 / 60.0,
    )
}

/// A body that jumps (a travel, a new shot) has its figure hung afresh where it lands, facing
/// the way it now faces: the garment doesn't fall the whole way, its train lies behind it, not
/// where it lay before. An origin shift carries it all as it is.
@test
fn a_jump_hangs_the_figure_where_it_lands() {
    var f = figure()
    for _ in 0..60 {
        still(mut f, vec3(0.0), 0.0)
    }
    let by = vec3(40.0, 0.0, -25.0)
    let heading = 1.5707964
    still(mut f, by, heading)
    let end = cape::point(cape::AROUND / 2, cape::DOWN - 1)
    let ahead = (cape::body_frame(by, heading, moves::REST.form) * vec4(0.0, 0.0, 1.0, 0.0)).xyz
    let behind = -dot(f.points()[end].xyz - by, ahead)
    assert(behind > 1.2, f"after the jump the train lies {behind} m behind the body")
    let collar = f.points()[cape::point(i: 0, j: 0)].xyz
    assert(length(collar.xz - by.xz) < 0.3, "the collar was left behind by the jump")
    let before = f.points()[end].xyz
    f.carry(vec3(-40.0, 0.0, 25.0))
    let moved = f.points()[end].xyz - before
    assert(length(moved - vec3(-40.0, 0.0, 25.0)) < 1.0e-3, "the origin's move left the hem")
}

/// Gliding off from a stand, the empty sleeves swing back from the shoulders, then hang again.
@test
fn the_sleeves_swing_back_as_it_sets_off_and_settle() {
    var f = figure()
    for _ in 0..60 {
        still(mut f, vec3(0.0), 0.0)
    }
    let cuff = |f: Figure, at: vec3| {
        let s = cape::SLEEVE_SHEETS[0]
        let points = f.points()
        var sum = vec3(0.0)
        for i in 0..s.around {
            sum = sum + points[s.at(i, s.down - 1)].xyz
        }
        sum / f32(s.around) - at
    }
    let hanging = cuff(f, vec3(0.0))
    var back = 0.0
    var at = vec3(0.0)
    for _ in 0..20 {
        at.z += 6.0 / 60.0
        still(mut f, at, 0.0)
        back = max(back, hanging.z - cuff(f, at).z)
    }
    assert(back > 0.08, f"setting off swings the cuff back only {back} m")
    for _ in 0..240 {
        still(mut f, at, 0.0)
    }
    let settled = length(cuff(f, at) - hanging)
    assert(settled < 0.05, f"the sleeve hangs {settled} m from where it hung before")
}
