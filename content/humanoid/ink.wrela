// The second pass: the ink and the paper (the Kinetic Ink look), reading this scene's targets:
// the backdrop and the ground. A line is drawn where what the first pass wrote changes between a
// pixel and its neighbours (what the ray met, how far, the normal's turn, the line field's sign),
// a hand's width that wobbles and boils from drawing to drawing. Where the moment is kinetic (the
// frame's `Shot::kinetic`, or a pixel's own) the lines fray: they break into strands, throw off
// static, and the palette drains toward black and white. Quiet, it's a painting with ink; at the
// edges of a violent thing, chaos.

use look::{BACKDROP, BODY, GROUND, INK, PAPER, Shot, band, hash2, luma, noise}
use std::gpu::{FragCoord, Rgba16Float, Rgba8, Texture}

/// A pixel's texel of a target, its coordinates clamped to it.
fn at(t: Texture<Rgba16Float>, p: vec2, size: vec2) -> vec4 {
    let q = clamp(p, vec2(0.0), size - vec2(1.0))
    t.load(u32(q.x), u32(q.y))
}

fn at8(t: Texture<Rgba8>, p: vec2, size: vec2) -> vec4 {
    let q = clamp(p, vec2(0.0), size - vec2(1.0))
    t.load(u32(q.x), u32(q.y))
}

/// How much of a line lies between two samples: `a` and `b` what each met (`look`'s marks), `na`
/// and `nb` their normals; `horizon` what the horizon's line weighs (a thin one, quiet; none
/// where the page is kinetic: frayed, it was static along the middle of the page).
fn edge(a: vec4, b: vec4, na: vec3, nb: vec3, horizon: f32) -> f32 {
    let near = if a.x < b.x { a } else { b }
    if abs(a.y - b.y) > 0.5 {
        // The horizon's a thin line; any other change of what was met, a full one.
        if (a.y == BACKDROP && b.y == GROUND) || (a.y == GROUND && b.y == BACKDROP) {
            return horizon
        }
        return max(near.w, 0.6)
    }
    if a.y == BACKDROP {
        return 0.0
    }
    var e = 0.0
    // A fold in depth: one thing in front of another part of itself.
    // (Finer on a body: an arm a hand's width in front of its own trunk is a line.)
    // (Not on the ground: toward the horizon it folds away at every pixel, a line of static
    // once the page frays.)
    if a.y > GROUND + 0.5 {
        let fold = if a.y >= BODY - 0.5 { 0.035 } else { 0.10 }
        e = max(e, band(abs(a.x - b.x), edge: fold, soft: fold * 0.3) * near.w)
        // A crease, on solid things.
        e = max(e, band(1.0 - dot(na, nb), edge: 0.30, soft: 0.08) * 0.8 * near.w)
    }
    // The line field's zero: seams.
    if (a.z < 0.0) != (b.z < 0.0) {
        e = max(e, 0.7 * near.w)
    }
    e
}

/// The impact frame's line between two samples: a body's outline (against the page, the other
/// body, its own head) and one part of it in front of another (by `fold`): no creases, no
/// seams, no trim, nothing a hand wouldn't draw in the one drawing that has to read.
fn outline(a: vec4, b: vec4, fold: f32) -> f32 {
    // (The struck one's head and body are one shape: his mask tipped back edge on, outlined
    // against the page and against his own face, was a post the fist ran into.)
    let whole = |id: f32| -> f32 { if id > BODY + 20.5 { BODY + 20.0 } else { id } }
    if abs(whole(a.y) - whole(b.y)) > 0.5 {
        let ground = a.y < BODY - 0.5 && b.y < BODY - 0.5
        return if ground { 0.0 } else { 1.0 }
    }
    if a.y < BODY - 0.5 {
        return 0.0
    }
    // (A head's its outline alone: his mask seen edge on was a bar of two seams.)
    if a.y - (if a.y >= BODY + 19.5 { BODY + 20.0 } else { BODY }) > 0.5 {
        return 0.0
    }
    // (One part of him in front of another, where the blow is: his arms across his chest. Away
    // from it his outline alone: his legs and his coat's folds were scraps of line.)
    band(abs(a.x - b.x), edge: 0.035, soft: 0.01) * fold
}

const AROUND = [
    vec2(1.0, 0.0),
    vec2(-1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(0.0, -1.0),
    vec2(0.7071, 0.7071),
    vec2(-0.7071, 0.7071),
    vec2(0.7071, -0.7071),
    vec2(-0.7071, -0.7071),
]

/// Where world point `p` falls on the screen (pixels, y down).
fn screen_of(s: Shot, p: vec3) -> vec2 {
    let clip = s.cam.view_proj * vec4(p, 1.0)
    let ndc = clip.xy / max(clip.w, 1.0e-4)
    vec2((ndc.x * 0.5 + 0.5) * s.resolution.x, (0.5 - ndc.y * 0.5) * s.resolution.y)
}

@fragment
pub fn ink(
    pixel: FragCoord,
    shot: Shot,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
) -> vec4 {
    let s = shot
    let size = s.resolution
    let px = pixel.position.xy
    let scale = size.y / 720.0
    let seed = s.held * 12.0
    let c0 = display(at(colour, px, size).xyz)
    let m0 = at(marks, px, size)
    let n0 = at8(normal, px, size)
    // An impact frame (the frame's energy at its peak): the page goes flat, two values and one
    // clean, heavy line. The striker in solid ink, the one struck in bare paper, so the fist
    // reads black against his face. No grain, no strands: the contact is the cleanest shape on
    // the page.
    if s.kinetic > 0.95 {
        let body = m0.y >= BODY - 0.5
        let struck = m0.y >= BODY + 19.5
        let head = body && m0.y - (if struck { BODY + 20.0 } else { BODY }) > 0.5
        // (How near the blow this is, 0 to 1: the pen's heavy where it lands and thins away
        // from it, as a hand leans on the line that matters.)
        var near = 0.5
        if s.force_to.w > 0.01 {
            let far = length(px - screen_of(s, s.force_to.xyz))
            near = 1.0 - band(far, edge: 150.0 * scale, soft: 130.0 * scale)
        }
        // (Where the striker lies over the one struck, a margin of paper round him and no line
        // of the other's under it: his fist is a clean black shape on the face it lands on.)
        var meets = false
        for i in 0..8 {
            let mq = at(marks, px + AROUND[i] * scale * (3.0 + 4.0 * near), size)
            // (On the struck one's side only: the striker's fist keeps every pixel of its shape.)
            meets = meets || (struck && mq.y >= BODY - 0.5 && mq.y < BODY + 19.5)
        }
        if meets {
            return vec4(display(PAPER), 1.0)
        }
        var e = 0.0
        let pen = scale * (0.65 + 1.25 * near)
        for i in 0..8 {
            for k in 1..3 {
                let mq = at(marks, px + AROUND[i] * pen * f32(k), size)
                e = max(e, outline(m0, mq, band(near, edge: 0.3, soft: 0.15)))
            }
        }
        // (The ink black: at `INK`'s own value it showed a grey violet, weak on the paper.)
        let black = INK * 0.1
        // (The striker's mask left paper inside his black: he keeps his face.)
        let flat = if body && !struck && !(head && m0.z >= 0.0) { black } else { PAPER }
        let bl = blast(s, px, scale)
        let fc = mix(mix(flat, PAPER, bl.y), black, max(band(e, edge: 0.35, soft: 0.1), bl.x))
        return vec4(display(fc), 1.0)
    }
    // The energy here: the frame's, or the most of this pixel's and its near neighbours'.
    var local = n0.w
    for i in 0..4 {
        let o = AROUND[i] * 5.0 * scale
        local = max(local, at8(normal, px + o, size).w * 0.8)
    }
    // (A strike's moment frays the page round its contact, not evenly to the feet.)
    var focus = 1.0
    if s.force_to.w > 0.01 {
        let far = length(px - screen_of(s, s.force_to.xyz))
        focus = 1.0 - band(far, edge: 260.0 * scale, soft: 160.0 * scale)
    }
    let energy = clamp(max(s.kinetic * focus, local), 0.0, 1.0)
    // (The horizon's line goes as the page turns kinetic.)
    let horizon = 0.18 * (1.0 - band(s.kinetic, edge: 0.5, soft: 0.15))
    // (On a dark form only the one line: a pale line's strands and flecks on black are lint.)
    let dark0 = 1.0 - band(luma(c0), edge: 0.035, soft: 0.02)
    // The pen's width: a hand's, wobbling along the line and boiling between drawings; quiet, the
    // boil is slight, so a figure in motion keeps a steady line (the opening's quiet sea had none).
    let wob = noise(px / (scale * 40.0) + vec2(seed * 0.37, 0.0)) - 0.5
    let r = scale * (1.15 + (0.35 + 0.35 * energy) * wob) * (1.0 + 0.25 * energy)
    // Strands: the line drawn again by a hand that doesn't quite find it, each stroke pushed off
    // along a slow wander of its own, the more so the more kinetic it is. Quiet, one strand.
    var line = 0.0
    for k in 0..3 {
        let kk = f32(k)
        let lift = if k == 0 { 1.0 } else { band(energy, 0.3 + 0.12 * kk, 0.06) * (1.0 - dark0) }
        let wander = vec2(
            noise(px / (scale * 14.0) + vec2(seed * 1.3 + kk * 17.0, kk * 5.0)),
            noise(px / (scale * 14.0) + vec2(kk * 9.0, seed * 0.9 + kk * 23.0)),
        ) -
            vec2(0.5)
        let shove = wander * scale * (1.0 + 4.0 * energy) * (if k == 0 { 0.2 + 0.4 * energy } else {
            1.0 + kk
        })
        var e = 0.0
        for i in 0..8 {
            let q = px + shove + AROUND[i] * r * (if k == 0 { 1.0 } else { 0.6 })
            let mq = at(marks, q, size)
            let nq = at8(normal, q, size)
            e = max(e, edge(m0, mq, n0.xyz * 2.0 - 1.0, nq.xyz * 2.0 - 1.0, horizon))
        }
        // Each strand breaks where its own slow noise falls: dashes, then fragments.
        let gaps = noise(px / (scale * 9.0) + vec2(seed * 2.3 + kk * 41.0, kk * 13.0))
        let kept = 1.0 - band(gaps, 1.0 - 0.6 * energy, 0.05) * band(energy, edge: 0.1, soft: 0.05)
        line = max(line, e * kept * lift * (if k == 0 { 1.0 } else { 0.85 }))
    }
    // Flecks thrown off the line: short dashes in cells round it, sparse, each its own angle.
    let cell = 7.0 * scale
    let id = floor(px / cell)
    let h = hash2(id + vec2(seed * 3.1, 7.0))
    let centre = (id +
        vec2(0.25 + 0.5 * hash2(id + vec2(1.0, seed)), 0.25 + 0.5 * hash2(id + vec2(seed, 2.0)))) *
        cell
    let turn = hash2(id + vec2(seed * 5.7, 3.0)) * 3.14159
    let axis = vec2(cos(turn), sin(turn))
    let rel = px - centre
    let dash = 1.0 - band(abs(dot(rel, vec2(-axis.y, axis.x))), 0.7 * scale, 0.3 * scale)
    let dash_len = 1.0 - band(abs(dot(rel, axis)), 2.2 * scale, 0.6 * scale)
    var near_line = 0.0
    for i in 0..4 {
        let q = centre + AROUND[i] * r * 3.0
        near_line = max(
            near_line,
            edge(
                at(marks, centre, size),
                at(marks, q, size),
                at8(normal, centre, size).xyz * 2.0 - 1.0,
                at8(normal, q, size).xyz * 2.0 - 1.0,
                0.0,
            ),
        )
    }
    let fleck = dash *
        dash_len *
        band(h, 1.0 - 0.5 * energy, 0.01) *
        band(energy, edge: 0.42, soft: 0.05) *
        band(near_line, edge: 0.3, soft: 0.1) *
        (1.0 - dark0)
    // Kinetic, the ink commits: a line is there or it isn't, no grey.
    let committed = mix(
        line,
        band(line, edge: 0.45, soft: 0.08),
        band(energy, edge: 0.3, soft: 0.1),
    )
    let ink_line = clamp(max(committed, fleck), 0.0, 1.0)
    // The palette drains toward ink and paper as the energy rises past the middle: three values,
    // and hatching in the middle one, as a page of manga.
    var c = c0
    let v = pow(max(luma(c0), 0.0), 0.4545)
    // (The ground's shadows fall in the middle value: above it, they were outlines of nothing.)
    let tone = band(v, edge: 0.30, soft: 0.02) * 0.5 + band(v, edge: 0.74, soft: 0.02) * 0.5
    // (The middle one a flat wash: hatched by rule across a whole body, it was a screen laid over
    // him, and it shimmered as he moved under it.)
    let mid = mix(INK * 1.4, PAPER * 0.92, 0.42)
    let bw = if tone < 0.25 { mix(INK * 1.4, mid, tone * 4.0) } else {
        mix(mid, PAPER, clamp(tone * 2.0 - 1.0, 0.0, 1.0))
    }
    // The frame's own level drains it all.
    c = mix(c, bw, band(s.kinetic, edge: 0.62, soft: 0.22))
    // The ink, warmer and thinner far off (what the first pass weighed), dark near.
    // Quiet, the ink is the form's own colour, deepened: it sits on the 3D form, not over it.
    // Kinetic, it turns to ink.
    // (On a dark form the line is pale, as white ink on black: his black arm reads across his
    // black trunk.)
    let on_dark = 1.0 - band(luma(c), edge: 0.035, soft: 0.02)
    let quiet = mix(c * c * 0.45, vec3(0.36, 0.36, 0.43), on_dark)
    let loud = mix(INK * 0.7, vec3(0.30, 0.30, 0.36), on_dark)
    let ink_c = mix(quiet, loud, band(energy, edge: 0.25, soft: 0.15))
    c = mix(c, ink_c, ink_line)
    // A blast thrown off the blow: its air paler, its ink over all.
    let bl = blast(s, px, scale)
    c = mix(c, PAPER * 1.02, bl.y)
    c = mix(c, INK * 0.6, bl.x)
    // The paper: its tooth and fibres, and a vignette as a page's edge darkens.
    let tooth = noise(px / (1.3 * scale)) * 0.6 + noise(px / (6.0 * scale)) * 0.4
    c *= 0.975 + 0.035 * tooth
    let uv = px / size - vec2(0.5)
    c *= 1.0 - 0.18 * pow(length(uv * vec2(1.0, 1.2)), 2.4)
    vec4(c, 1.0)
}

/// A blast thrown off a blow at pixel `px`: (ink, air). The air the blow drives on past what it
/// struck: a cone opening ahead of the fist, its front a heavy broken ink rim (two fainter rims
/// behind it), the air inside it a pale wash; and ink thrown off the contact along the blow in
/// drops, long and thin as they fly, each its own speed. It's over everything: the force goes
/// through what it hit.
fn blast(s: Shot, px: vec2, scale: f32) -> vec2 {
    let age = s.blast.w
    if age < 0.0 || s.blast_dir.w <= 0.0 {
        return vec2(0.0)
    }
    let life = clamp(age / 0.45, 0.0, 1.0)
    let c = screen_of(s, s.blast.xyz)
    let ahead = screen_of(s, s.blast.xyz + s.blast_dir.xyz * s.blast_dir.w)
    let reach = max(length(ahead - c), 1.0)
    let u = (ahead - c) / reach
    let v = vec2(-u.y, u.x)
    let rel = px - c
    // (The front: an ellipse about the contact, stretched along the blow, wrapping round the
    // sides of what it struck and gone behind the fist.)
    let q = vec2(dot(rel, u), dot(rel, v) / 0.7)
    let r = length(q)
    let ang = atan2(abs(q.y), q.x)
    let front = 1.0 - band(ang, edge: 1.65, soft: 0.3)
    let grow = 1.0 - exp(-age / 0.11)
    let fade = 1.0 - smoothstep(0.3, 1.0, life)
    // (It wobbles as a hand's stroke would, thick ahead and drawn out to points at its sides.)
    let wob = (noise(vec2(ang * 2.5, 3.0)) - 0.5) * 0.1 * reach
    let taper = max(1.0 - (ang / 1.65) * (ang / 1.65), 0.0)
    var ink = 0.0
    for k in 0..2 {
        let kk = f32(k)
        // (It starts at the contact itself and runs out from there; the echo lags behind.)
        let radius = reach * grow * (1.0 - 0.3 * kk) + wob * grow
        let thick = scale *
            (7.5 - 3.5 * kk) *
            taper *
            (1.0 - 0.7 * life) *
            (0.4 + 0.6 * smoothstep(0.0, 0.05, age))
        let rim = 1.0 - band(abs(r - radius), edge: thick, soft: 1.2 * scale)
        // A dry brush: streaks of paper through it along the stroke, more as it fades.
        let dry = noise(vec2(ang * 40.0 + kk * 13.0, (r - radius) / (2.0 * scale)))
        let kept = band(dry, edge: 0.18 + 0.45 * life, soft: 0.08)
        ink = max(ink, rim * kept * front * fade * (1.0 - 0.45 * kk))
    }
    // At the contact itself: a burst of ink round the fist, ragged, all the way round, gone in a
    // fifth of a second, so the eye finds where it landed first.
    let rr = length(rel)
    let ang2 = atan2(rel.y, rel.x)
    let splash = reach *
        0.3 *
        (1.0 - exp(-age / 0.035)) *
        (0.75 + 0.5 * noise(vec2(ang2 * 2.2, 7.0)))
    let sthick = scale * 6.0 * (1.0 - smoothstep(0.0, 0.2, age))
    let ring = 1.0 - band(abs(rr - splash), edge: sthick, soft: 1.2 * scale)
    let sdry = band(noise(vec2(ang2 * 14.0, rr / (3.0 * scale))), edge: 0.25, soft: 0.08)
    ink = max(ink, ring * sdry)
    vec2(clamp(ink, 0.0, 1.0), 0.0)
}

/// A linear colour for the screen: a soft shoulder, then sRGB's curve.
fn display(c: vec3) -> vec3 {
    let x = c / (vec3(1.0) + c * 0.12)
    pow(max(x, vec3(0.0)), vec3(1.0 / 2.2))
}
