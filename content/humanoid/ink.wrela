// The second pass: the ink and the paper (the Kinetic Ink look), reading this scene's targets:
// the backdrop and the ground. A line is drawn where what the first pass wrote changes between a
// pixel and its neighbours (what the ray met, how far, the normal's turn, the line field's sign),
// a hand's width that wobbles and boils from drawing to drawing. Where the moment is kinetic (the
// frame's `Shot::kinetic`, or a pixel's own) the lines fray: they break into strands, throw off
// static, and the palette drains toward black and white. Quiet, it's a painting with ink; at the
// edges of a violent thing, chaos.

use look::{BACKDROP, BODY, GROUND, INK, PAPER, Shot, band, hash2, luma, noise}
use std::gpu::{FragCoord, Rgba16Float, Rgba8, Texture}

/// A pixel's texel of a target, its coordinates clamped to it.
fn at(t: Texture<Rgba16Float>, p: vec2, size: vec2) -> vec4 {
    let q = clamp(p, vec2(0.0), size - vec2(1.0))
    t.load(u32(q.x), u32(q.y))
}

fn at8(t: Texture<Rgba8>, p: vec2, size: vec2) -> vec4 {
    let q = clamp(p, vec2(0.0), size - vec2(1.0))
    t.load(u32(q.x), u32(q.y))
}

/// How much of a line lies between two samples: `a` and `b` what each met (`look`'s marks), `na`
/// and `nb` their normals.
fn edge(a: vec4, b: vec4, na: vec3, nb: vec3) -> f32 {
    let near = if a.x < b.x { a } else { b }
    if abs(a.y - b.y) > 0.5 {
        // The horizon's a thin line; any other change of what was met, a full one.
        let horizon = (a.y == BACKDROP && b.y == GROUND) || (a.y == GROUND && b.y == BACKDROP)
        let w = if horizon { 0.35 } else { max(near.w, 0.6) }
        return w
    }
    if a.y == BACKDROP {
        return 0.0
    }
    var e = 0.0
    // A fold in depth: one thing in front of another part of itself.
    e = max(e, band(abs(a.x - b.x), edge: 0.10, soft: 0.03) * near.w)
    // A crease, on solid things.
    if a.y > GROUND + 0.5 {
        e = max(e, band(1.0 - dot(na, nb), edge: 0.30, soft: 0.08) * 0.8 * near.w)
    }
    // The line field's zero: seams.
    if (a.z < 0.0) != (b.z < 0.0) {
        e = max(e, 0.7 * near.w)
    }
    e
}

const AROUND = [
    vec2(1.0, 0.0),
    vec2(-1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(0.0, -1.0),
    vec2(0.7071, 0.7071),
    vec2(-0.7071, 0.7071),
    vec2(0.7071, -0.7071),
    vec2(-0.7071, -0.7071),
]

/// Where world point `p` falls on the screen (pixels, y down).
fn screen_of(s: Shot, p: vec3) -> vec2 {
    let clip = s.cam.view_proj * vec4(p, 1.0)
    let ndc = clip.xy / max(clip.w, 1.0e-4)
    vec2((ndc.x * 0.5 + 0.5) * s.resolution.x, (0.5 - ndc.y * 0.5) * s.resolution.y)
}

/// A strike's fury at pixel `px`: (ink, drain). Its speed lines, ruled behind the fist back
/// along the limb's path in lanes of broken strokes, the thickest nearest its line; on contact,
/// a burst of spokes round the fist, and the page there drained to ink and paper. The body
/// (`on_body`) is left alone: its own lines fray (`paint_body`'s energy).
fn strike(s: Shot, px: vec2, scale: f32, seed: f32, on_body: bool) -> vec2 {
    let by = s.force_to.w
    if by < 0.01 {
        return vec2(0.0)
    }
    let a = screen_of(s, s.force_from.xyz)
    let b = screen_of(s, s.force_to.xyz)
    let ab = b - a
    let len = max(length(ab), 1.0)
    let dir = ab / len
    let rel = px - b
    let back = -dot(rel, dir)
    let across = dot(rel, vec2(-dir.y, dir.x))
    // Speed lines: lanes across the path, some ruled, each from its own start back a way.
    let spread = 80.0 * scale
    let gap = 6.0 * scale
    let lane = floor(across / gap)
    let keep = band(hash2(vec2(lane, seed * 1.7 + 3.0)), edge: 0.35, soft: 0.01)
    let thin = 1.0 - band(abs(across - (lane + 0.5) * gap), edge: 0.9 * scale, soft: 0.5 * scale)
    let reach = len * 2.4
    let from = hash2(vec2(lane, seed * 0.9 + 11.0)) * reach * 0.35
    let till = from + reach * (0.35 + 0.5 * hash2(vec2(lane, seed * 2.3 + 5.0)))
    let dash = band(back, edge: from, soft: 3.0 * scale) *
        (1.0 - band(back, edge: till, soft: 6.0 * scale))
    let fade = saturate(1.0 - abs(across) / spread) * saturate(1.0 - back / reach)
    var ink = keep * thin * dash * fade * band(by, edge: 0.15, soft: 0.1)
    // The burst: on contact (the frame's flash), spokes round the fist, each its own length.
    let r = length(rel)
    var drain = 0.0
    if s.kinetic > 0.15 {
        let n = 20.0
        let turn = atan2(rel.y, rel.x) / 6.2831853 * n + hash2(vec2(seed, 9.0)) * 3.0
        let spoke = floor(turn)
        let h = hash2(vec2(spoke, seed * 4.1 + 1.0))
        let r0 = 22.0 * scale
        let l = (40.0 + 70.0 * h) * scale
        let x = saturate((r - r0) / l)
        let w = (3.2 * scale) * (1.0 - x)
        let off = abs(fract(turn) - 0.5) * 6.2831853 / n * r
        let on = band(r, edge: r0, soft: 2.0 * scale) *
            (1.0 - band(r, edge: r0 + l, soft: 2.0 * scale))
        ink = max(
            ink,
            on * (1.0 - band(off, edge: w, soft: 1.0 * scale)) * band(h, edge: 0.25, soft: 0.01),
        )
        drain = 1.0 - band(r, edge: 150.0 * scale, soft: 60.0 * scale)
    }
    if on_body {
        ink = 0.0
    }
    vec2(ink, drain)
}

@fragment
pub fn ink(
    pixel: FragCoord,
    shot: Shot,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
) -> vec4 {
    let s = shot
    let size = s.resolution
    let px = pixel.position.xy
    let scale = size.y / 720.0
    let seed = s.held * 12.0
    let c0 = display(at(colour, px, size).xyz)
    let m0 = at(marks, px, size)
    let n0 = at8(normal, px, size)
    // The energy here: the frame's, or the most of this pixel's and its near neighbours'.
    var local = n0.w
    for i in 0..4 {
        let o = AROUND[i] * 5.0 * scale
        local = max(local, at8(normal, px + o, size).w * 0.8)
    }
    let energy = clamp(max(s.kinetic, local), 0.0, 1.0)
    // The pen's width: a hand's, wobbling along the line and boiling between drawings; quiet, the
    // boil is slight, so a figure in motion keeps a steady line (the opening's quiet sea had none).
    let wob = noise(px / (scale * 40.0) + vec2(seed * 0.37, 0.0)) - 0.5
    let r = scale * (1.15 + (0.35 + 0.35 * energy) * wob) * (1.0 + 0.5 * energy)
    // Strands: the line drawn again by a hand that doesn't quite find it, each stroke pushed off
    // along a slow wander of its own, the more so the more kinetic it is. Quiet, one strand.
    var line = 0.0
    for k in 0..3 {
        let kk = f32(k)
        let lift = if k == 0 { 1.0 } else { band(energy, 0.12 + 0.12 * kk, 0.06) }
        let wander = vec2(
            noise(px / (scale * 14.0) + vec2(seed * 1.3 + kk * 17.0, kk * 5.0)),
            noise(px / (scale * 14.0) + vec2(kk * 9.0, seed * 0.9 + kk * 23.0)),
        ) -
            vec2(0.5)
        let shove = wander * scale * (1.0 + 7.0 * energy) * (if k == 0 { 0.2 + 0.4 * energy } else {
            1.0 + kk
        })
        var e = 0.0
        for i in 0..8 {
            let q = px + shove + AROUND[i] * r * (if k == 0 { 1.0 } else { 0.6 })
            let mq = at(marks, q, size)
            let nq = at8(normal, q, size)
            e = max(e, edge(m0, mq, n0.xyz * 2.0 - 1.0, nq.xyz * 2.0 - 1.0))
        }
        // Each strand breaks where its own slow noise falls: dashes, then fragments.
        let gaps = noise(px / (scale * 9.0) + vec2(seed * 2.3 + kk * 41.0, kk * 13.0))
        let kept = 1.0 - band(gaps, 1.0 - 0.6 * energy, 0.05) * band(energy, edge: 0.1, soft: 0.05)
        line = max(line, e * kept * lift * (if k == 0 { 1.0 } else { 0.85 }))
    }
    // Flecks thrown off the line: short dashes in cells round it, sparse, each its own angle.
    let cell = 7.0 * scale
    let id = floor(px / cell)
    let h = hash2(id + vec2(seed * 3.1, 7.0))
    let centre = (id +
        vec2(0.25 + 0.5 * hash2(id + vec2(1.0, seed)), 0.25 + 0.5 * hash2(id + vec2(seed, 2.0)))) *
        cell
    let turn = hash2(id + vec2(seed * 5.7, 3.0)) * 3.14159
    let axis = vec2(cos(turn), sin(turn))
    let rel = px - centre
    let dash = 1.0 - band(abs(dot(rel, vec2(-axis.y, axis.x))), 0.7 * scale, 0.3 * scale)
    let dash_len = 1.0 - band(abs(dot(rel, axis)), 2.2 * scale, 0.6 * scale)
    var near_line = 0.0
    for i in 0..4 {
        let q = centre + AROUND[i] * r * 3.0
        near_line = max(
            near_line,
            edge(
                at(marks, centre, size),
                at(marks, q, size),
                at8(normal, centre, size).xyz * 2.0 - 1.0,
                at8(normal, q, size).xyz * 2.0 - 1.0,
            ),
        )
    }
    let fleck = dash *
        dash_len *
        band(h, 1.0 - 0.5 * energy, 0.01) *
        band(energy, edge: 0.2, soft: 0.05) *
        band(near_line, edge: 0.3, soft: 0.1)
    // Kinetic, the ink commits: a line is there or it isn't, no grey.
    let committed = mix(
        line,
        band(line, edge: 0.45, soft: 0.08),
        band(energy, edge: 0.3, soft: 0.1),
    )
    let ink_line = clamp(max(committed, fleck), 0.0, 1.0)
    // The palette drains toward ink and paper as the energy rises past the middle: three values,
    // and hatching in the middle one, as a page of manga.
    var c = c0
    let v = pow(max(luma(c0), 0.0), 0.4545)
    let tone = band(v, edge: 0.30, soft: 0.02) * 0.5 + band(v, edge: 0.60, soft: 0.02) * 0.5
    let hatch_q = (px.x + px.y) / (5.0 * scale) +
        (noise(px / (scale * 60.0) + vec2(seed)) - 0.5) * 0.4
    let hatch = band(abs(fract(hatch_q) - 0.5), edge: 0.32, soft: 0.06)
    let mid = mix(INK * 1.4, PAPER * 0.92, hatch)
    let bw = if tone < 0.25 { mix(INK * 1.4, mid, tone * 4.0) } else {
        mix(mid, PAPER, clamp(tone * 2.0 - 1.0, 0.0, 1.0))
    }
    // The frame's own level drains it all; a strike's contact drains the page round its fist.
    let fury = strike(s, px, scale, seed, m0.y >= BODY)
    c = mix(c, bw, max(band(s.kinetic, edge: 0.62, soft: 0.22), fury.y))
    // The ink, warmer and thinner far off (what the first pass weighed), dark near.
    // Quiet, the ink is the form's own colour, deepened: it sits on the 3D form, not over it.
    // Kinetic, it turns to ink.
    let ink_c = mix(c * c * 0.45, INK * 0.7, band(energy, edge: 0.25, soft: 0.15))
    c = mix(c, ink_c, ink_line)
    // The strike's speed lines and burst, in ink, round the body (never over it).
    c = mix(c, INK * 0.6, fury.x)
    // The paper: its tooth and fibres, and a vignette as a page's edge darkens.
    let tooth = noise(px / (1.3 * scale)) * 0.6 + noise(px / (6.0 * scale)) * 0.4
    c *= 0.975 + 0.035 * tooth
    let uv = px / size - vec2(0.5)
    c *= 1.0 - 0.18 * pow(length(uv * vec2(1.0, 1.2)), 2.4)
    vec4(c, 1.0)
}

/// A linear colour for the screen: a soft shoulder, then sRGB's curve.
fn display(c: vec3) -> vec3 {
    let x = c / (vec3(1.0) + c * 0.12)
    pow(max(x, vec3(0.0)), vec3(1.0 / 2.2))
}
