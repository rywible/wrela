// A humanoid character base, drawn in Kinetic Ink: Quaternius's Superhero Male, converted from
// its glTF when the program is built onto VRM 1.0's bones (`engine::humanoid`), standing in its
// T-pose, then idling (Quaternius's Universal Animation Library), then walking a 100STYLE take
// retargeted onto it and looped. Two passes, as the opening style test's: the scene painted in 3D
// into what the ink reads (`paint`), then the ink and the paper (`ink`).
//
// `--set SHOW=1` holds the T-pose, `2` the idle, `3` the walk, `4` the run, `5` the walking
// turns, `6` the jog, `7` and `8` ACCAD's two walks (Male 1's, Male 2's), `9` and `10` their
// runs; `0` (the default) plays them in turn: two seconds of T-pose, six of idle,
// then the walk. `--set RAW=1` plays a clip as its take has it, before its cleanup
// (`engine::cleanup`; the walk's, `engine::stride`).
//
// `--set SHOW=11` plays the body as a game would (`engine::playback`): a scripted stick walks it
// off (in the actor's own first steps), turns it, runs it, throws a punch over the run (timed
// to the fight's attack frames), stops it (in his own last steps), rolls it, turns it on the spot
// (stepping round) and walks it back, each change inertial.

use body::{
    ACCAD_M1_RUN, ACCAD_M1_RUN_RAW, ACCAD_M1_WALK, ACCAD_M1_WALK_RAW, ACCAD_M2_RUN,
    ACCAD_M2_RUN_RAW, ACCAD_M2_WALK, ACCAD_M2_WALK_CODE, ACCAD_M2_WALK_RAW, ACT_PUNCH, ACT_ROLL,
    ACTS, GAITS, HERO, PUNCH, IDLE, IDLE_RAW, JOG, JOG_RAW, RUN, RUN_RAW, T_POSE, TURNS, TURNS_RAW,
    WALK, WALK_RAW,
}
use engine::cleanup
use engine::cleanup::Cleanup
use engine::humanoid
use engine::humanoid::{BodyVertex, Clip, Pose, blend, palette}
use engine::playback
use engine::playback::{Handling, Mover}
use engine::review::review
use engine::stride
use ink::ink
use look::{Shot, shot_at}
use paint::{backdrop, body, ground, paint_backdrop, paint_body, paint_ground}
use std::gpu::{
    ClipPosition, Cull, DepthTexture, GpuBuffer, Rgba16Float, Rgba8, Texture, VertexIndex,
    begin_pass3_with_depth, begin_screen_pass, buffer_of, depth_texture, draw, texture, write,
}
use std::io::print
use std::transform::identity

/// What plays: 0 each in turn, 1 the T-pose, 2 the idle, 3 the walk, 4 the run, 5 the walking
/// turns, 6 the jog; and whether as its take has it (1), before its cleanup.
pub const SHOW: u32 = 0
pub const RAW: u32 = 0

/// `--set CODE=1` plays a move as it's written in Wrela (content/moves, fitted from its clip by
/// the moves tool) instead of the clip itself: Male 2's walk (`SHOW=8`).
pub const CODE: u32 = 0

/// `SHOW=11` as a game without this layer's help would play it, for comparison: `--set CUT=1`
/// cuts from move to move and lets the feet go where the moves put them.
pub const CUT: u32 = 0

/// How kinetic the moment is (0 quiet): `--set KINETIC=0.6` frays the ink.
pub const KINETIC: f32 = 0.0

/// The camera: how far off (m), and the height it frames (m): `--set FAR=1.2 --set FOCUS=0.2`
/// looks at the feet.
pub const FAR: f32 = 3.7
pub const FOCUS: f32 = 0.95

/// Which side of its front the camera sees the walk from (+ its left): `--set SIDE=8` is near
/// its profile.
pub const SIDE: f32 = 0.75

/// When the sequence moves on (s), and how long a change of clip blends.
const IDLE_AT: f32 = 2.0
const WALK_AT: f32 = 8.0
const BLEND: f32 = 0.5

pub struct State {
    verts: GpuBuffer<BodyVertex>,
    indices: GpuBuffer<u32>,
    palette: GpuBuffer<mat4>,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
    depth: DepthTexture,
    width: u32,
    height: u32,
    /// `SHOW=11`'s body and when it was last stepped.
    mover: Mover,
    last: f32,
    mask: [f32; 64],
}

pub fn init() -> State {
    print(
        f"humanoid: {HERO.rig.bones.len()} bones, {HERO.verts.len()} vertices, {HERO.indices.len() / 3} triangles; idle {IDLE.frames} frames, walk {WALK.frames} frames ({WALK.travel.z:.2} m a loop)",
    )
    State {
        verts: buffer_of(HERO.verts),
        indices: buffer_of(HERO.indices),
        palette: buffer_of([identity(); 64]),
        colour: texture(width: 640, height: 360),
        marks: texture(width: 640, height: 360),
        normal: texture(width: 640, height: 360),
        depth: depth_texture(width: 640, height: 360),
        width: 640,
        height: 360,
        mover: Mover::standing(vec3(0.0), 0.0, GAITS),
        last: 0.0,
        mask: playback::upper_body(HERO.rig),
    }
}

/// `SHOW=11`'s script: the stick (the speed asked for along the floor, m/s) at `time`, and the
/// one-off begun as time passes from `last` to `time` (`NONE` for none), whether over the upper
/// body alone.
pub fn script(last: f32, time: f32) -> (vec3, u32, bool) {
    let at = |t: f32| -> bool { last < t && time >= t }
    let dir = |deg: f32| -> vec3 { vec3(sin(deg * 0.017453292), 0.0, cos(deg * 0.017453292)) }
    let (walk, run) = (GAITS.walk.speed, GAITS.run.speed)
    let stick = if time < 1.5 {
        vec3(0.0)
    } else if time < 4.5 {
        dir(0.0) * walk
    } else if time < 7.0 {
        dir(-70.0) * walk
    } else if time < 10.5 {
        dir(-70.0) * run
    } else if time < 12.0 {
        dir(-70.0) * walk
    } else if time < 14.5 {
        vec3(0.0)
    } else if time < 18.0 {
        dir(150.0) * walk
    } else {
        vec3(0.0)
    }
    if at(8.8) {
        return (stick, ACT_PUNCH, true)
    }
    if at(13.0) {
        return (stick, ACT_ROLL, false)
    }
    (stick, humanoid::NONE, false)
}

/// `SHOW=11`'s body stepped on to `time`: its pose and where it's drawn.
fn played(s: mut State, time: f32) -> (Pose, mat4) {
    let dt = clamp(time - s.last, 1.0e-4, 0.1)
    let (stick, act, upper) = script(s.last, time)
    let pose = playback::step(
        mut s.mover,
        GAITS,
        ACTS,
        HERO.rig,
        s.mask,
        stick,
        act,
        upper,
        if CUT == 1 {
            Handling { change_half: 1.0e-4, act_half: 1.0e-4, plant: false, clips: false }
        } else {
            Handling {}
        },
        dt,
    )
    s.last = time
    (pose, playback::placed(s.mover))
}

/// The pose at `time`, and how far into its clip it's walked (for the camera to follow).
fn pose_at(time: f32) -> Pose {
    let n = HERO.rig.bones.len()
    let raw = RAW == 1
    match SHOW {
        1 => T_POSE.pose(0.0),
        2 => if raw { IDLE_RAW.pose(time) } else { IDLE.pose(time) },
        3 => if raw { WALK_RAW.pose(time) } else { WALK.pose(time) },
        4 => if raw { RUN_RAW.pose(time) } else { RUN.pose(time) },
        5 => if raw { TURNS_RAW.pose(time) } else { TURNS.pose(time) },
        6 => if raw { JOG_RAW.pose(time) } else { JOG.pose(time) },
        7 => if raw { ACCAD_M1_WALK_RAW.pose(time) } else { ACCAD_M1_WALK.pose(time) },
        8 => if CODE == 1 {
            ACCAD_M2_WALK_CODE.pose(time)
        } else if raw {
            ACCAD_M2_WALK_RAW.pose(time)
        } else {
            ACCAD_M2_WALK.pose(time)
        },
        9 => if raw { ACCAD_M1_RUN_RAW.pose(time) } else { ACCAD_M1_RUN.pose(time) },
        10 => if raw { ACCAD_M2_RUN_RAW.pose(time) } else { ACCAD_M2_RUN.pose(time) },
        _ => if time < IDLE_AT {
            T_POSE.pose(0.0)
        } else if time < WALK_AT {
            let t = time - IDLE_AT
            blend(T_POSE.pose(0.0), IDLE.pose(t), smoothstep(0.0, BLEND * 2.0, t), n)
        } else {
            let t = time - WALK_AT
            blend(IDLE.pose(WALK_AT - IDLE_AT + t), WALK.pose(t), smoothstep(0.0, BLEND, t), n)
        },
    }
}

/// The hips' place, on average over a loop (or a second) round `time`: a walk's steady path,
/// an idle's spot.
fn steady_hips(time: f32) -> vec3 {
    let base = HERO.rig.base
    let span = match SHOW {
        4 => RUN.length(),
        5 => 1.0,
        6 => JOG.length(),
        7 => ACCAD_M1_WALK.length(),
        8 => ACCAD_M2_WALK.length(),
        9 => ACCAD_M1_RUN.length(),
        10 => ACCAD_M2_RUN.length(),
        _ => WALK.length(),
    }
    var sum = vec3(0.0)
    for k in 0..16 {
        let t = time + span * ((f32(k) + 0.5) / 16.0 - 0.5)
        sum += base.t + base.q.rotate(pose_at(t).hips)
    }
    sum / 16.0
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if width != s.width || height != s.height {
        s.colour = texture(width: width, height: height)
        s.marks = texture(width: width, height: height)
        s.normal = texture(width: width, height: height)
        s.depth = depth_texture(width, height)
        s.width = width
        s.height = height
    }
    let game = SHOW == 11
    let (pose, place) = if game { played(mut s, time) } else { (pose_at(time), identity()) }
    let bones = palette(HERO.rig, pose, place)
    write(mut s.palette, 0, bones)
    // The camera follows the hips along the ground, steadily: where they are on average over a
    // stride, so it neither surges with each step nor sways with the hips. A game's body is
    // followed where gameplay puts it, which is steady already.
    let hips = if game { s.mover.place } else { steady_hips(time) }
    let walking = SHOW >= 3 || (SHOW == 0 && time >= WALK_AT)
    let side = if walking { SIDE } else { -0.55 }
    let left = normalize((bones[0] * vec4(1.0, 0.0, 0.0, 0.0)).xyz)
    let shot = shot_at(
        time,
        FOCUS,
        vec3(hips.x, 0.0, hips.z),
        width,
        height,
        FAR,
        side,
        KINETIC,
        left,
    )
    let p = begin_pass3_with_depth(
        mut s.colour,
        mut s.marks,
        mut s.normal,
        mut s.depth,
        clear: vec4(0.0),
        clear_depth: 0.0,
    )
    draw(p, backdrop, paint_backdrop.bind(shot: shot), vertices: 3, depth: engine::view::NEAREST)
    draw(
        p,
        ground.bind(shot: shot),
        paint_ground.bind(shot: shot),
        vertices: 6,
        depth: engine::view::NEAREST,
    )
    draw(
        p,
        body.bind(verts: s.verts.items(), palette: s.palette.items(), shot: shot),
        paint_body.bind(shot: shot),
        indices: s.indices,
        index_count: HERO.indices.len(),
        cull: Cull::Back,
        depth: engine::view::NEAREST,
    )
    p.end()
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        screen,
        backdrop,
        ink.bind(shot: shot, colour: s.colour, marks: s.marks, normal: s.normal),
        vertices: 3,
    )
    screen.present()
}

/// The body converts onto VRM's bones within the engine's 64, and its clips with it: the walk
/// goes ahead (+z) a stride (two steps) a loop, and the idle stays where it stands.
@test
fn the_body_and_its_clips_convert() {
    let r = HERO.rig.clone()
    assert(r.bones.len() == 52, f"the rig has {r.bones.len()} bones, not 52")
    assert(r.find("hips") == 0 && r.find("leftToes") != humanoid::NONE)
    assert(HERO.verts.len() > 8000 && HERO.indices.len() % 3 == 0)
    assert(HERO.hi.y > 1.7 && HERO.hi.y < 1.9, f"the body stands {HERO.hi.y} m tall")
    assert(WALK.travel.z > 1.0 && WALK.travel.z < 1.4, f"a walk's loop goes {WALK.travel} m")
    assert(abs(WALK.travel.x) < 0.05)
    assert(length(IDLE.travel) < 0.05, f"the idle wanders {IDLE.travel} m a loop")
}

/// At rest, each bone's palette matrix is the identity: the rig's rest pose is the mesh's bind.
@test
fn the_t_pose_is_the_bind_pose() {
    let m = palette(HERO.rig, T_POSE.pose(0.0), identity())
    var worst = 0.0
    for b in 0..HERO.rig.bones.len() {
        for c in 0..4 {
            worst = max(worst, length(m[b][c] - identity()[c]))
        }
    }
    assert(worst < 1.0e-3, f"a bone's rest palette is {worst} from the identity")
}

/// A walk's loop meets itself: its last frame's turns are its first's.
@test
fn the_walk_loops_without_a_pop() {
    let n = WALK.frames - 1
    var worst = 0.0
    for b in 0..WALK.bones {
        let a = WALK.turns[b].v
        let z = WALK.turns[n * WALK.bones + b].v
        worst = max(worst, min(length(a - z), length(a + z)))
    }
    assert(worst < 1.0e-3, f"the walk's seam is {worst} apart")
}

/// Each frame records draws the host accepts.
@test(frames: 2)
fn frames_record_valid_draws() {}

fn bone_at(m: [mat4; 64], rw: [humanoid::Rigid], b: str) -> vec3 {
    let i = HERO.rig.find(b)
    (m[i] * vec4(rw[i].t, 1.0)).xyz
}

/// The walk faces where it goes: through a loop and into the next, its hips go ahead (+z), its
/// left is +x and its toes point ahead (within 45°: a foot rolls in as it pushes off).
@test
fn the_walk_faces_ahead() {
    let rw = HERO.rig.rest_world()
    var last = -1.0
    for k in 0..12 {
        let t = f32(k) * 0.25
        let m = palette(HERO.rig, WALK.pose(t), identity())
        let h = bone_at(m, rw, "hips")
        let left = bone_at(m, rw, "leftUpperLeg") - bone_at(m, rw, "rightUpperLeg")
        let toes = bone_at(m, rw, "leftToes") - bone_at(m, rw, "leftFoot")
        assert(h.z > last, f"at {t} s the hips went back, to {h.z}")
        assert(left.x > 0.15 && abs(left.z) < 0.08, f"at {t} s the pelvis turned: {left}")
        assert(toes.z > abs(toes.x), f"at {t} s the left toes point {toes}")
        last = h.z
    }
}

/// A planted foot stays put: frame to frame, an ankle down on the ground (within 2 cm of its
/// height at rest) moves no more than 1.5 cm along it (a stance eases in and out).
@test
fn the_walk_plants_its_feet() {
    let rw = HERO.rig.rest_world()
    let n = WALK.frames - 1
    for foot in ["leftFoot", "rightFoot"] {
        let rest = rw[HERO.rig.find(foot)].t.y
        var last = vec3(0.0)
        var down = false
        for f in 0..n {
            let t = f32(f) / WALK.fps
            let a = bone_at(palette(HERO.rig, WALK.pose(t), identity()), rw, foot)
            let now = a.y < rest + 0.01
            if now && down {
                let slide = length(vec2(a.x - last.x, a.z - last.z))
                assert(slide < 0.015, f"at {t} s the planted {foot} slid {slide} m")
            }
            down = now
            last = a
        }
    }
}

/// Every clip that's ready passes its review (`engine::review`: what an animator's eye looks
/// for, measured): the walk made human (`engine::stride`), and the idle and the run as the
/// cleanup every clip goes through leaves them (`engine::cleanup`), untuned. The walk's take
/// passes too, cleaned up in place of the walk's own making, and so does a walk from mocap the
/// cleanup was never tuned on (ACCAD's Male 1).
@test
fn every_clip_passes_its_review() {
    let r = HERO.rig.clone()
    passes("the walk", WALK.clone(), r.clone())
    passes("the idle", IDLE.clone(), r.clone())
    passes("the run", RUN.clone(), r.clone())
    passes(
        "the walk's take, cleaned",
        cleanup::cleaned(WALK_RAW.clone(), r.clone(), Cleanup {}),
        r.clone(),
    )
    passes("ACCAD's Male 1 walk", ACCAD_M1_WALK.clone(), r)
}

/// A foot that swings low clears the floor: ACCAD's Male 2 walk's left heel skims it at 6 m/s
/// as it swings (8 mm over it as the take comes, under it once its feet are set on the floor),
/// and the cleanup lifts every heel and ball going faster than twice a heel lands clear of it
/// (`engine::cleanup`'s `CLEAR`, 1.29 cm).
@test
fn a_swinging_foot_clears_the_floor() {
    let rig = HERO.rig.clone()
    let clip = ACCAD_M2_WALK.clone()
    let n = clip.frames - 1
    for side in [1.0, -1.0] {
        let l = stride::leg_of(rig.clone(), side)
        var was = (vec3(0.0), vec3(0.0))
        for f in 0..n {
            let w = stride::worlds(rig.clone(), clip.clone(), f)
            let (a, t) = (w[l.ankle], w[l.toes])
            let (heel, ball) = (a.t + a.q.rotate(l.heel), t.t + t.q.rotate(l.ball))
            if f > 0 {
                for (p, q) in [(heel, was.0), (ball, was.1)] {
                    let speed = length(vec2(p.x - q.x, p.z - q.z)) * clip.fps
                    assert(
                        speed < 1.74 || p.y - l.floor > 0.012,
                        f"frame {f}: a foot {(p.y - l.floor) * 100.0:.2} cm over the floor at {speed:.2} m/s",
                    )
                }
            }
            was = (heel, ball)
        }
    }
}

/// What the cleanup can't make right, the review sends for a look: the walking turns' take
/// hops mid-turn, and the jog (a library's cartoon, not a person's) bounds, its steps too long
/// and too few for how fast its feet sweep.
@test
fn the_review_sends_the_rest_for_a_look() {
    let r = HERO.rig.clone()
    flags("the walking turns", TURNS.clone(), r.clone(), "the body hops")
    flags("the jog", JOG.clone(), r, "the steps are too long")
}

/// A take that turns as it goes keeps its head on its body: the neck's carriage (the take's
/// mean neck and head, `Retarget::carried`) is taken about the way the body faces each frame,
/// not the room's, so the head faces with the chest on average (looking into each turn).
@test
fn the_turns_keep_the_head_with_the_body() {
    let rig = HERO.rig.clone()
    let rw = rig.rest_world()
    let (head, chest) = (rig.find("head"), rig.find("upperChest"))
    let ahead = |w: [humanoid::Rigid], b: u32| -> f32 {
        let d = w[b].q.mul(rw[b].q.inverse()).rotate(vec3(0.0, 0.0, 1.0))
        atan2(d.x, d.z)
    }
    var sum = 0.0
    for f in 0..TURNS.frames {
        let w = stride::worlds(rig.clone(), TURNS.clone(), f)
        var off = ahead(w.clone(), head) - ahead(w, chest)
        off -= 6.2831853 * floor((off + 3.14159265) / 6.2831853)
        sum += off
    }
    let mean = sum / f32(TURNS.frames) * 57.29578
    assert(abs(mean) < 5.0, f"the walking turns' head faces {mean:.1}° off the chest on average")
}

/// That a clip's review flags nothing.
fn passes(name: str, clip: Clip, rig: humanoid::Rig) {
    let rv = review(clip, rig)
    assert(rv.flags.len() == 0, rv.text(name).as_str())
}

/// The review sees what's wrong with the takes as they come: the walk's feet sliding, the
/// idle's sinking into the floor, the run's cut seam jumping, the jog running on the spot.
@test
fn the_review_sees_the_takes_faults() {
    let r = HERO.rig.clone()
    flags("the walk's take", WALK_RAW.clone(), r.clone(), "the left foot slides")
    flags("the walk's take", WALK_RAW.clone(), r.clone(), "the left foot slips")
    flags("the idle's take", IDLE_RAW.clone(), r.clone(), "the left foot sinks")
    flags("the run's take", RUN_RAW.clone(), r.clone(), "the neck pops")
    flags("the jog's take", JOG_RAW.clone(), r, "the left foot slides along the floor as on a")
}

/// That a clip's review has a flag that starts `what`.
fn flags(name: str, clip: Clip, rig: humanoid::Rig, what: str) {
    let rv = review(clip, rig)
    var seen = false
    for f in rv.flags.clone() {
        seen = seen || f.as_str().starts_with(what)
    }
    assert(seen, f"{name}: no flag says {what}\n{rv.text(name)}")
}

// ---- the body played as a game plays it (`engine::playback`) --------------------------------

/// The walk and the run play in place, gameplay carrying them on, and each foot comes down once
/// a loop, half a loop after the other; the idle stands.
@test
fn the_gaits_play_in_place_with_their_footfalls() {
    for (name, m) in [("walk", GAITS.walk.clone()), ("run", GAITS.run.clone())] {
        let a = m.clip.hips[0]
        let z = m.clip.hips[m.clip.frames - 1]
        assert(
            length(vec2(z.x - a.x, z.z - a.z)) < 0.01,
            f"the {name} moves {z - a} m a loop in place",
        )
        let l = m.mark(playback::STEP_LEFT)
        let r = m.mark(playback::STEP_RIGHT)
        assert(l.is_some() && r.is_some(), f"the {name} has no footfall marked")
        assert(m.passed(playback::STEP_LEFT, 0.0, m.length()) == 1)
        let apart = abs(r.unwrap().from - l.unwrap().from) / m.length()
        print(
            f"{name}: {m.speed:.2} m/s, {m.stride:.2} m a stride, left down at {l.unwrap().from:.3} s, right at {r.unwrap().from:.3} s ({apart:.2} of a loop apart)",
        )
        assert(apart > 0.4 && apart < 0.6, f"the {name}'s feet come down {apart} of a loop apart")
    }
    assert(
        GAITS.walk.speed > 0.9 && GAITS.walk.speed < 1.8,
        f"the walk goes {GAITS.walk.speed} m/s",
    )
    assert(GAITS.run.speed > GAITS.walk.speed + 0.3)
    assert(GAITS.idle.marks.len() == 0, "the idle steps")
}

/// The ankles' heights over the floor on a pose.
fn ankles(pose: Pose) -> (f32, f32) {
    let m = palette(HERO.rig, pose, identity())
    let rw = HERO.rig.rest_world()
    (bone_at(m, rw, "leftFoot").y, bone_at(m, rw, "rightFoot").y)
}

/// The walk and the run mixed at one phase put the same foot down together: after phase 0 the
/// left foot is the one on the ground in both, after one half the right.
@test
fn the_walk_and_the_run_keep_step() {
    for (name, m) in [("walk", GAITS.walk.clone()), ("run", GAITS.run.clone())] {
        // Over each foot's first quarter after it comes down, it's the lower.
        var left_lower = 0.0
        var right_lower = 0.0
        for k in 0..10 {
            let (l, r) = ankles(m.at_phase(f32(k) / 40.0))
            left_lower += r - l
            let (l2, r2) = ankles(m.at_phase(0.5 + f32(k) / 40.0))
            right_lower += l2 - r2
        }
        print(
            f"{name}: the left ankle is {left_lower * 10.0:.1} cm lower on average after phase 0, the right {right_lower * 10.0:.1} cm after one half",
        )
        assert(
            left_lower > 0.0 && right_lower > 0.0,
            f"the {name}'s footfalls aren't at its phases",
        )
    }
}

/// The punch is fitted to the fight's attack: as long as its frames, its windows where the fight
/// has them, and its fist going fastest within the active frames. Reviewed as a hand-keyed move
/// it isn't flagged for the snap it's for.
@test
fn the_punch_lands_when_the_fight_says() {
    let total = f32(body::ATTACK_WINDUP + body::ATTACK_ACTIVE + body::ATTACK_RECOVERY) / body::HZ
    assert(
        abs(PUNCH.length() - total) < 1.0 / 30.0,
        f"the punch lasts {PUNCH.length()} s, not {total}",
    )
    let active = PUNCH.mark(playback::ACTIVE).unwrap()
    assert(abs(active.from - f32(body::ATTACK_WINDUP) / body::HZ) < 1.0e-4)
    let strike = playback::strike_of(PUNCH, HERO.rig, "rightHand")
    print(
        f"the punch: {PUNCH.length():.3} s, hits from {active.from:.3} to {active.till:.3} s, its fist fastest at {strike:.3} s",
    )
    assert(
        strike > active.from - 2.0 / 30.0 && strike < active.till + 2.0 / 30.0,
        f"the fist is fastest at {strike} s, not when it hits",
    )
    let keyed = engine::review::review_as(PUNCH.clip.clone(), HERO.rig, engine::review::KEYED)
    let judged = review(PUNCH.clip.clone(), HERO.rig)
    print(keyed.text("the punch, as a keyed move"))
    print(judged.text("the punch, as locomotion"))
}

/// The bones that carry the body's shape (not its fingers).
const MAJOR: [Text; 16] = [
    "hips",
    "spine",
    "chest",
    "upperChest",
    "neck",
    "head",
    "leftUpperArm",
    "leftLowerArm",
    "rightUpperArm",
    "rightLowerArm",
    "leftUpperLeg",
    "leftLowerLeg",
    "rightUpperLeg",
    "rightLowerLeg",
    "leftFoot",
    "rightFoot",
]

/// What a run of `script` shows: about each change, the most a joint moved in a frame in the
/// body's own space (m); the fastest a foot on the floor went along it (m/s), steadily and in a
/// change's first third of a second; and whether the body stood at the end.
struct Played: Copy {
    worst: f32,
    slide: f32,
    slide_change: f32,
    stood: bool,
}

/// The body played by `script` for 20 s at 60 Hz, handled as `how` says, measured each frame.
fn played_by(how: Handling) -> Played {
    let hz = 60.0
    let rig = HERO.rig.clone()
    let rw = rig.rest_world()
    let mask = playback::upper_body(rig)
    let rest_ankle = rw[rig.find("leftFoot")].t.y
    var m = Mover::standing(vec3(0.0), 0.0, GAITS)
    var last = 0.0
    let joints = [
        "hips",
        "head",
        "leftHand",
        "rightHand",
        "leftFoot",
        "rightFoot",
        "leftLowerLeg",
        "rightLowerLeg",
    ]
    var was: Vec<vec3> = Vec::filled(joints.len(), vec3(0.0))
    var worst = 0.0
    var worst_at = 0.0
    var worst_name: Text = ""
    var since = 100
    var doing = m.doing
    var acting = m.acting
    var slide = 0.0
    var slide_at = 0.0
    var slide_change = 0.0
    var slide_change_at = 0.0
    var prev_l = vec3(0.0)
    var prev_r = vec3(0.0)
    var low_l = 0
    var low_r = 0
    for f in 1..u32(21.5 * hz) {
        let time = f32(f) / hz
        let (stick, act, upper) = script(last, time)
        let pose = playback::step(
            mut m,
            GAITS,
            ACTS,
            rig,
            mask,
            stick,
            act,
            upper,
            how,
            1.0 / hz,
        )
        last = time
        if m.doing != doing || m.acting != acting {
            since = 0
            // How far a cut would have jumped: the biggest turn the change hides.
            var cut = 0.0
            var cut_bone = 0
            for name in MAJOR {
                let b = rig.find(name)
                let a = length(m.inertia.turns[b]) * 57.29578
                if a > cut {
                    cut = a
                    cut_bone = b
                }
            }
            print(
                f"{time:.3} s: doing {m.doing}, acting {m.acting}, going {m.speed:.2} m/s, phase {m.phase:.2}; a cut would jump a bone {cut:.0}° (bone {cut_bone}, VRM {humanoid::BONES[rig.bones[cut_bone].vrm]})",
            )
            doing = m.doing
            acting = m.acting
        }
        let pal = palette(rig, pose, playback::placed(m))
        let own = palette(rig, pose, identity())
        for j in 0..joints.len() {
            let p = bone_at(own, rw, joints[j])
            if f > 1 && since < 4 && m.acting != ACT_ROLL {
                // How far it moved in a frame, about a change (but the roll's own start, which is
                // as fast as Quaternius keyed it).
                let d = length(p - was[j])
                if d > worst {
                    worst = d
                    worst_at = time
                    worst_name = joints[j]
                }
            }
            was[j] = p
        }
        let l = bone_at(pal, rw, "leftFoot")
        let r = bone_at(pal, rw, "rightFoot")
        // A foot's on the floor once it's been low (its ankle within 1.5 cm of its height at rest)
        // for a tenth of a second: a swinging foot that skims the floor passes quicker.
        low_l = if l.y < rest_ankle + 0.015 { low_l + 1 } else { 0 }
        low_r = if r.y < rest_ankle + 0.015 { low_r + 1 } else { 0 }
        if f > 1 && m.acting == humanoid::NONE {
            for (now, before, low) in [(l, prev_l, low_l), (r, prev_r, low_r)] {
                if low > 6 {
                    let s = length(vec2(now.x - before.x, now.z - before.z)) * hz
                    if since >= 20 && s > slide {
                        slide = s
                        slide_at = time
                    }
                    if since < 20 && s > slide_change {
                        slide_change = s
                        slide_change_at = time
                    }
                }
            }
        }
        prev_l = l
        prev_r = r
        since += 1
    }
    print(
        f"about a change, the most a joint moved in a frame: {worst * 100.0:.1} cm, the {worst_name} at {worst_at:.3} s",
    )
    print(
        f"the fastest a foot on the floor went along it, steadily: {slide:.2} m/s at {slide_at:.3} s",
    )
    print(
        f"the fastest a foot on the floor went along it in a change's first third of a second: {slide_change:.2} m/s at {slide_change_at:.3} s",
    )
    print(
        f"(steadily at {slide_at:.3} s; about a change at {slide_change_at:.3} s; the joint, the {worst_name}, at {worst_at:.3} s)",
    )
    Played { worst, slide, slide_change, stood: m.doing == playback::STANDING }
}

/// Played by a scripted stick (walk off, turn, run, a punch over the run, stop, roll, walk back),
/// each change keeps the body's joints moving at their pace where a cut would jump them, and a
/// foot on the floor stays put, steadily and through the changes; the same script cut from move
/// to move with its feet left loose (`CUT=1`) jumps and skates.
@test
fn a_played_body_moves_without_a_pop() {
    let p = played_by(Handling {})
    let c = played_by(
        Handling { change_half: 1.0e-4, act_half: 1.0e-4, plant: false, clips: false },
    )
    print(
        f"inertial and planted: a joint moves {p.worst * 100.0:.1} cm a frame at most about a change; a foot on the floor goes {p.slide:.2} m/s steadily, {p.slide_change:.2} m/s about a change",
    )
    print(
        f"cut, feet loose: a joint moves {c.worst * 100.0:.1} cm a frame at most about a change; a foot on the floor goes {c.slide:.2} m/s steadily, {c.slide_change:.2} m/s about a change",
    )
    assert(p.stood, "the body didn't stop at the end")
    assert(p.worst < 0.5 * c.worst, f"a change jumps a joint {p.worst} m a frame (a cut {c.worst})")
    // What's left: a running foot that's slow to be judged down at 4 m/s.
    assert(p.slide < 0.8 && p.slide < c.slide, f"a foot on the floor skates at {p.slide} m/s")
    assert(
        p.slide_change < 0.25 * c.slide_change,
        f"a foot on the floor skates at {p.slide_change} m/s in a change (cut: {c.slide_change})",
    )
}

/// An impact frame (an arm snapped to a pose for a frame) is a pop to the locomotion review and
/// nothing to the keyed one, which judges only the feet and knees.
@test
fn a_keyed_move_may_snap() {
    var c = IDLE.clone()
    let b = HERO.rig.find("rightLowerArm")
    let f = c.frames / 2
    c.turns[f * c.bones + b] = Quat::axis_angle(vec3(0.0, 1.0, 0.0), 1.5).mul(
        c.turns[f * c.bones + b],
    )
    let judged = review(c.clone(), HERO.rig)
    let keyed = engine::review::review_as(c, HERO.rig, engine::review::KEYED)
    print(judged.text("the idle with a snap, as locomotion"))
    print(keyed.text("the idle with a snap, as a keyed move"))
    assert(judged.score < 10.0, "the locomotion review missed the snap")
    assert(keyed.score == 10.0, "the keyed review flagged the snap")
}
