// A humanoid character base, drawn in Kinetic Ink: Quaternius's Superhero Male, converted from
// its glTF when the program is built onto VRM 1.0's bones (`engine::humanoid`), standing in its
// T-pose, then idling (Quaternius's Universal Animation Library), then walking a 100STYLE take
// retargeted onto it and looped. Two passes, as the opening style test's: the scene painted in 3D
// into what the ink reads (`paint`), then the ink and the paper (`ink`).
//
// `--set SHOW=1` holds the T-pose, `2` the idle, `3` the walk, `4` the run, `5` the walking
// turns, `6` the jog, `7` and `8` ACCAD's two walks (Male 1's, Male 2's), `9` and `10` their
// runs; `0` (the default) plays them in turn: two seconds of T-pose, six of idle,
// then the walk. `--set RAW=1` plays a clip as its take has it, before its cleanup
// (`engine::cleanup`; the walk's, `engine::stride`).
//
// `--set SHOW=11` plays the body as a game would (`engine::playback`): a scripted stick walks it
// off (in the actor's own first steps), turns it, runs it, throws a punch over the run (timed
// to the fight's attack frames), stops it (in his own last steps), rolls it, turns it on the spot
// (stepping round) and walks it back, each change inertial. The body is Hakuro (`HAKURO`), as
// he stands, carries himself and runs (content/hakuro's `manner`); `--set HAKURO=0` plays the
// bare body with the captures' own gaits. `--set SHOW=12` stands the body in
// its guard and throws the solved cross (`solved`), twice. `--set SHOW=16` plays a take NVIDIA's
// Kimodo made from a text prompt (`kimodo`), its right cross retimed to the fight's frame data.

use body::{
    HAKURO_GAITS, ACCAD_M1_RUN, ACCAD_M1_RUN_RAW, ACCAD_M1_WALK, ACCAD_M1_WALK_RAW, ACCAD_M2_RUN,
    ACCAD_M2_RUN_RAW, ACCAD_M2_WALK, ACCAD_M2_WALK_CODE, ACCAD_M2_WALK_RAW, ACT_PUNCH, ACT_ROLL,
    ACTS, GAITS, GAITS_CODE, HERO, PUNCH, IDLE, IDLE_RAW, JOG, JOG_RAW, RUN, RUN_RAW, T_POSE, TURNS,
    TURNS_RAW, WALK, WALK_RAW,
}
use engine::anime
use engine::written::Beats
use engine::anime::{Anime, Drawer}
use fighter::{Fighters, fighters, hakuro_palette}
use hakuro::manner
use engine::bearing
use fists::{ACT_CROSS, ACT_STEP_IN, ACT_STEP_LEFT, ACT_STEP_OUT, ACT_STEP_RIGHT, FIGHT_GAITS, LOOKS}
use engine::cleanup
use engine::cleanup::Cleanup
use engine::humanoid
use engine::humanoid::{BodyVertex, Clip, Pose, blend, palette}
use engine::playback
use engine::playback::{Gaits, Handling, Move, Mover}
use engine::review::review
use engine::stride
use ink::ink
use look::{Shot, shot_at}
use paint::{backdrop, body, ground, paint_backdrop, paint_body, paint_ground}
use std::gpu::{
    ClipPosition, Cull, DepthTexture, GpuBuffer, Rgba16Float, Rgba8, Texture, VertexIndex,
    begin_pass3_with_depth, begin_screen_pass, buffer_of, depth_texture, draw, texture, write,
}
use engine::sound::{Cue, Palette, Surface, Swish, Babble, Breath, mixer}
use engine::sound
use lab::{Lab, preset, preset_name}
use std::audio::{RingWriter, play}
use std::input::{Event, Key, PadButton, events}
use std::io::print
use std::transform::identity
use ui::draw::{Rect, Renderer}
use ui::text::Fonts
use ui::widgets::{Anchor, Ui}

/// What plays: 0 each in turn, 1 the T-pose, 2 the idle, 3 the walk, 4 the run, 5 the walking
/// turns, 6 the jog; and whether as its take has it (1), before its cleanup.
pub const SHOW: u32 = 0
/// Who fights in the exchange and the lab (`SHOW=28`, `29`) and who a game plays (`SHOW=11`):
/// 1 Hakuro (`fighter`), in a fight against his double; 0 the bare body (`--set HAKURO=0`).
pub const HAKURO: u32 = 1
/// `SHOW=12`'s body: the bare body (0), or with `--set CHARTED=1` Hakuro, his arms and hands his
/// charted forms (`engine::chart`), alone: to see how a strike's turns land on a charted arm.
pub const CHARTED: u32 = 0
pub const RAW: u32 = 0

/// `--set CODE=1` plays the moves as they're written in Wrela (content/moves, fitted from their
/// clips by the moves tool) instead of the clips themselves: Male 2's walk (`SHOW=8`), and every
/// gait and one-off a game plays (`SHOW=11`).
pub const CODE: u32 = 0

/// The gaits and one-offs `SHOW=11` plays: Hakuro's own (`HAKURO`), or the bare body's: the
/// clips', or as `CODE` says, the code's. (Chosen as constants: chosen with an `if` where
/// they're played, toolchain 0.24.0's build drew single frames with the body flipped,
/// whichever was chosen; and a build holds only the set it plays.)
@fuel(2 ** 40)
const PLAYED_GAITS: Gaits = if HAKURO == 1 { HAKURO_GAITS.clone() } else if CODE == 1 {
    GAITS_CODE.clone()
} else { GAITS.clone() }
@fuel(2 ** 40)
const PLAYED_ACTS: [Move; 2] = if CODE == 1 { ACTS_CODE.clone() } else { ACTS.clone() }

/// `SHOW=11` as a game without this layer's help would play it, for comparison: `--set CUT=1`
/// cuts from move to move and lets the feet go where the moves put them.
pub const CUT: u32 = 0

/// (Measuring: `--set PROBE_FIST=1` prints the fist's path round the contact.)
pub const PROBE_FIST: u32 = 0

/// `SHOW=11`'s fight moves drawn as anime is (`engine::anime`: on twos, the strike pushed past
/// and held, fists and feet smeared): `--set ANIME=0` draws them smooth.
pub const ANIME: u32 = 1

/// How far back a fast fist or foot is smeared in the fight's moves (`engine::anime::Anime`'s
/// `smear`: of its travel since the last drawing): `--set SMEAR=0` draws them unsmeared.
pub const SMEAR: f32 = 0.6

/// The fight's moves (`fists::LOOKS` says how each is drawn): the running punch, the roll, the
/// solved cross (`solved::CROSS`: goal poses, each part of the body on its own clock, its
/// numbers solved against spec.wrela) and the steps.
@fuel(2 ** 40)
const FIGHT_ACTS: [Move; 7] = [
    ACTS[ACT_PUNCH].clone(),
    ACTS[ACT_ROLL].clone(),
    solved::CROSS.clone(),
    fists::STEP_IN.clone(),
    fists::STEP_OUT.clone(),
    fists::STEP_LEFT.clone(),
    fists::STEP_RIGHT.clone(),
]

/// `SHOW=11`'s one-offs from the moves written in Wrela, no capture read (`CODE`): the solved
/// cross at the fight's attack frames (`Written::played`), and the roll (content/moves).
@fuel(2 ** 40)
const ACTS_CODE: [Move; 2] = [
    solved::cross().played(
        HERO.rig,
        solved::CONTACT,
        Beats::of_frames(body::ATTACK_WINDUP, body::ATTACK_ACTIVE, body::ATTACK_RECOVERY, body::HZ),
        fps: 60.0,
        fist: 2.0,
    ),
    body::ROLL_CODE.clone(),
]

/// How kinetic the moment is (0 quiet): `--set KINETIC=0.6` frays the ink.
pub const KINETIC: f32 = 0.0

/// The camera: how far off (m), and the height it frames (m): `--set FAR=1.2 --set FOCUS=0.2`
/// looks at the feet.
pub const FAR: f32 = 3.7
pub const FOCUS: f32 = 0.95

/// Which side of its front the camera sees the walk from (+ its left): `--set SIDE=8` is near
/// its profile.
pub const SIDE: f32 = 0.75

/// The crosses' drawings a second when drawn as anime (`SHOW=13`, `14`): a strike's snap needs
/// more than twelve.
pub const DRAWINGS: f32 = 24.0

/// Which side the guard and its crosses (`SHOW=12` to `14`) are seen from.
pub const CROSS_SIDE: f32 = -1.6

/// When the sequence moves on (s), and how long a change of clip blends.
const IDLE_AT: f32 = 2.0
const WALK_AT: f32 = 8.0
const BLEND: f32 = 0.5

pub struct State {
    verts: GpuBuffer<BodyVertex>,
    indices: GpuBuffer<u32>,
    palette: GpuBuffer<mat4>,
    /// `SHOW=28`'s second fighter's.
    palette2: GpuBuffer<mat4>,
    /// Hakuro as both fighters (`HAKURO`), and the played time their cloth was last stepped to.
    fighters: Fighters,
    cloth_at: f32,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
    depth: DepthTexture,
    width: u32,
    height: u32,
    /// `SHOW=11`'s body and when it was last stepped.
    mover: Mover,
    last: f32,
    /// How Hakuro is holding himself there, each eased from 0 to 1: how much he's carrying
    /// himself his own way (not in a roll, which holds its own head), how much his arms are
    /// his bearing's (not a punch's), how much he's standing as he stands, and how closed his
    /// fists are.
    held: vec4,
    mask: [f32; 64],
    drawer: Drawer,
    /// `SHOW=29`'s: the lab, its panel, and the cues to its sounds.
    lab: Lab,
    ui: Ui,
    renderer: Renderer,
    cues: RingWriter<Cue>,
}

/// The lab's sounds: a fist landing on a body (impact 0) and on stone (1), and a fist through
/// the air (whoosh 0).
pub const LAB_SOUNDS: Palette = Palette {
    surfaces: [Surface {}; 8],
    waters: [Babble {}; 4],
    brushes: [Babble {}; 3],
    impacts: [
        // Knuckles into a face: a short, deep thud under a dry slap.
        Surface {
            knock_hz: 92.0,
            knock_t60: 0.13,
            knock: 0.85,
            grit_hz: 2100.0,
            grit_q: 0.8,
            grit_t60: 0.06,
            grit: 0.3,
        },
        // Knuckles into a stone shin: a low crack that rings, and grit spat off it.
        Surface {
            knock_hz: 58.0,
            knock_t60: 0.4,
            knock: 0.95,
            grit_hz: 3300.0,
            grit_q: 0.9,
            grit_t60: 0.22,
            grit: 0.5,
        },
        Surface {},
        Surface {},
    ],
    whooshes: [
        // A fist cutting air: short and quick.
        Swish { hz: 1100.0, q: 0.9, attack: 0.04, t60: 0.16, level: 0.45 },
        Swish {},
    ],
    wind: Breath {},
    near: 3.0,
    gain: 1.0,
}

pub fn init() -> State {
    if SHOW == 29 && PROBE_FIST == 1 {
        print(exchange::fist_track())
    }
    if SHOW == 28 && PROBE_FIST == 1 {
        print(exchange::move_track(184, 262))
    }
    if SHOW == 28 {
        print(
            f"exchange: hit at {exchange::hit_at():.3} s, blow {exchange::BLOW}, foe at {exchange::PLACE[3].xyz}, contact {exchange::contact()}",
        )
    }
    print(
        f"humanoid: {HERO.rig.bones.len()} bones, {HERO.verts.len()} vertices, {HERO.indices.len() / 3} triangles; idle {IDLE.frames} frames, walk {WALK.frames} frames ({WALK.travel.z:.2} m a loop)",
    )
    let (cues, voice) = mixer(LAB_SOUNDS, seed: 7)
    if SHOW == 29 {
        play(take voice, sound::mix)
    }
    State {
        lab: Lab::new(),
        ui: Ui::new(Fonts::load()),
        renderer: Renderer::new(Fonts::load()),
        cues,
        verts: buffer_of(HERO.verts),
        indices: buffer_of(HERO.indices),
        palette: buffer_of([identity(); 64]),
        palette2: buffer_of([identity(); 64]),
        fighters: fighters(if SHOW == 11 || (CHARTED == 1 && SHOW == 12) { 1 } else { 2 }),
        cloth_at: 0.0,
        colour: texture(width: 640, height: 360),
        marks: texture(width: 640, height: 360),
        normal: texture(width: 640, height: 360),
        depth: depth_texture(width: 640, height: 360),
        width: 640,
        height: 360,
        mover: if SHOW == 12 {
            Mover::standing(vec3(0.0), 0.0, FIGHT_GAITS)
        } else if SHOW == 13 {
            Mover::standing(vec3(0.0), 0.0, accad_fists::GUARD_GAITS)
        } else {
            Mover::standing(vec3(0.0), 0.0, PLAYED_GAITS)
        },
        last: 0.0,
        held: vec4(1.0, 1.0, 1.0, 0.0),
        mask: playback::upper_body(HERO.rig),
        drawer: Drawer::new(),
    }
}

/// `SHOW=11`'s script: the stick (the speed asked for along the floor, m/s) at `time`, and the
/// one-off begun as time passes from `last` to `time` (`NONE` for none), whether over the upper
/// body alone.
pub fn script(last: f32, time: f32) -> (vec3, u32, bool) {
    let at = |t: f32| -> bool { last < t && time >= t }
    let dir = |deg: f32| -> vec3 { vec3(sin(deg * 0.017453292), 0.0, cos(deg * 0.017453292)) }
    let (walk, run) = (PLAYED_GAITS.walk.speed, PLAYED_GAITS.run.speed)
    let stick = if time < 1.5 {
        vec3(0.0)
    } else if time < 4.5 {
        dir(0.0) * walk
    } else if time < 7.0 {
        dir(-70.0) * walk
    } else if time < 10.5 {
        dir(-70.0) * run
    } else if time < 12.0 {
        dir(-70.0) * walk
    } else if time < 14.5 {
        vec3(0.0)
    } else if time < 18.0 {
        dir(150.0) * walk
    } else {
        vec3(0.0)
    }
    if at(8.8) {
        return (stick, ACT_PUNCH, true)
    }
    if at(13.0) {
        return (stick, ACT_ROLL, false)
    }
    (stick, humanoid::NONE, false)
}

/// `SHOW=12`'s script: the body bounces in its guard, steps in and throws the cross, steps back
/// out, slips to its left and its right, steps in again and throws it again.
pub fn stand_script(last: f32, time: f32) -> (vec3, u32, bool) {
    let at = |t: f32| -> bool { last < t && time >= t }
    let beats = [
        (1.2, ACT_STEP_IN),
        (1.62, ACT_CROSS),
        (2.6, ACT_STEP_OUT),
        (3.3, ACT_STEP_LEFT),
        (4.0, ACT_STEP_RIGHT),
        (4.7, ACT_STEP_IN),
        (5.12, ACT_CROSS),
        (6.1, ACT_STEP_OUT),
    ]
    for (t, act) in beats {
        if at(t) {
            return (vec3(0.0), act, false)
        }
    }
    (vec3(0.0), humanoid::NONE, false)
}

/// `SHOW=13`'s script: the body stands in its guard and throws the captured cross
/// (`accad_fists`), twice.
pub fn cross_script(last: f32, time: f32) -> (vec3, u32, bool) {
    let at = |t: f32| -> bool { last < t && time >= t }
    let act = accad_fists::ACT_TAKEN
    for t in [1.2, 3.2] {
        if at(t) {
            return (vec3(0.0), act, false)
        }
    }
    (vec3(0.0), humanoid::NONE, false)
}

/// `SHOW=11`'s body stepped on to `time`: its pose and where it's drawn.
fn played(s: mut State, time: f32) -> (Pose, mat4) {
    let dt = clamp(time - s.last, 1.0e-4, 0.1)
    let (stick, act, upper) = if SHOW == 12 { stand_script(s.last, time) } else if SHOW >= 13 {
        cross_script(s.last, time)
    } else {
        script(s.last, time)
    }
    let how = if CUT == 1 {
        Handling { change_half: 1.0e-4, act_half: 1.0e-4, plant: false, clips: false }
    } else {
        Handling {}
    }
    // (Each gaits const passed whole: an `if` choosing between consts would move one out.)
    let pose = if SHOW == 12 {
        playback::step(
            mut s.mover,
            FIGHT_GAITS,
            FIGHT_ACTS,
            HERO.rig,
            s.mask,
            stick,
            act,
            upper,
            how,
            dt,
        )
    } else if SHOW == 13 {
        playback::step(
            mut s.mover,
            accad_fists::GUARD_GAITS,
            accad_fists::ACTS,
            HERO.rig,
            s.mask,
            stick,
            act,
            upper,
            how,
            dt,
        )
    } else {
        playback::step(
            mut s.mover,
            PLAYED_GAITS,
            PLAYED_ACTS,
            HERO.rig,
            s.mask,
            stick,
            act,
            upper,
            how,
            dt,
        )
    }
    s.last = time
    (pose, playback::placed(s.mover))
}

/// The struck fighter's palette from the rig's `foe`: Hakuro's, his head squashed along the blow
/// while the fist is in it (the exchange's clock `xc`, below 0 none).
fn struck_palette(foe: [mat4; 64], xc: f32, xt: exchange::Tune) -> [mat4; 64] {
    let m = hakuro_palette(foe)
    if xc < 0.0 {
        return m
    }
    let head = bone_at(foe, HERO.rig.rest_world(), "head") + vec3(0.0, 0.07, 0.0)
    fighter::squashed(m, head, exchange::BLOW, exchange::squash(xc, xt))
}

fn pose_at(time: f32) -> Pose {
    let n = HERO.rig.bones.len()
    let raw = RAW == 1
    match SHOW {
        1 => T_POSE.pose(0.0),
        2 => if raw { IDLE_RAW.pose(time) } else { IDLE.pose(time) },
        3 => if raw { WALK_RAW.pose(time) } else { WALK.pose(time) },
        4 => if raw { RUN_RAW.pose(time) } else { RUN.pose(time) },
        5 => if raw { TURNS_RAW.pose(time) } else { TURNS.pose(time) },
        6 => if raw { JOG_RAW.pose(time) } else { JOG.pose(time) },
        7 => if raw { ACCAD_M1_WALK_RAW.pose(time) } else { ACCAD_M1_WALK.pose(time) },
        8 => if CODE == 1 {
            ACCAD_M2_WALK_CODE.pose(time)
        } else if raw {
            ACCAD_M2_WALK_RAW.pose(time)
        } else {
            ACCAD_M2_WALK.pose(time)
        },
        9 => if raw { ACCAD_M1_RUN_RAW.pose(time) } else { ACCAD_M1_RUN.pose(time) },
        10 => if raw { ACCAD_M2_RUN_RAW.pose(time) } else { ACCAD_M2_RUN.pose(time) },
        16 => kimodo::TIMED.pose(time % (kimodo::TIMED.length() + 0.4)),
        18 => kimodo::STANCE.pose(time % kimodo::STANCE.length()),
        19 => kimodo::in_stance(time),
        20 => kimodo::PREVIEW.pose(time % kimodo::PREVIEW.length()),
        21 => kimodo::BOUNCE.pose(time % kimodo::BOUNCE.length()),
        22 => kimodo::SWAGGERED.pose(time % kimodo::SWAGGERED.length()),
        23 => kimodo::SPAR_IDLE.pose(time % kimodo::SPAR_IDLE.length()),
        24 => kimodo::SHRUG_D.pose(time % kimodo::SHRUG_D.length()),
        25 => kimodo::SHRUG_N.pose(time % kimodo::SHRUG_N.length()),
        26 => kimodo::fight_round(time),
        28 => exchange::striker_on(time, exchange::TUNED),
        27 => kimodo::FIGHT_IDLE_M.pose(time % kimodo::FIGHT_IDLE_M.length()),
        _ => if time < IDLE_AT {
            T_POSE.pose(0.0)
        } else if time < WALK_AT {
            let t = time - IDLE_AT
            blend(T_POSE.pose(0.0), IDLE.pose(t), smoothstep(0.0, BLEND * 2.0, t), n)
        } else {
            let t = time - WALK_AT
            blend(IDLE.pose(WALK_AT - IDLE_AT + t), WALK.pose(t), smoothstep(0.0, BLEND, t), n)
        },
    }
}

/// The hips' place, on average over a loop (or a second) round `time`: a walk's steady path,
/// an idle's spot.
fn steady_hips(time: f32) -> vec3 {
    let base = HERO.rig.base
    let span = match SHOW {
        4 => RUN.length(),
        5 => 1.0,
        6 => JOG.length(),
        7 => ACCAD_M1_WALK.length(),
        8 => ACCAD_M2_WALK.length(),
        9 => ACCAD_M1_RUN.length(),
        10 => ACCAD_M2_RUN.length(),
        _ => WALK.length(),
    }
    var sum = vec3(0.0)
    for k in 0..16 {
        let t = time + span * ((f32(k) + 0.5) / 16.0 - 0.5)
        sum += base.t + base.q.rotate(pose_at(t).hips)
    }
    sum / 16.0
}

/// How far the lab's camera looks aside so the fight sits clear of its panel (m, along the
/// ground): to the view's right, by about half the panel's share of the screen.
fn lab_aside(t: exchange::Tune, l: Lab, width: u32) -> vec3 {
    if !l.panel {
        return vec3(0.0)
    }
    let side = -exchange::BLOW.z / exchange::BLOW.x
    let d = normalize(vec3(side, 0.0, 1.0))
    let right = vec3(d.z, 0.0, -d.x)
    let far = if t.giant { 12.0 } else { 3.4 }
    right * far * l.zoom * 0.45 * (LAB_W + 20.0) / f32(width)
}

/// The lab's panel's width (px).
const LAB_W: f32 = 300.0

/// `SHOW=29`'s input and panel: a press throws the cross (J, F, a click off the panel, a pad's
/// face button); the panel tunes slot A or B, records a take and replays it through both.
fn lab_panel(s: mut State, time: f32, width: u32, height: u32) {
    let screen = vec2(f32(width), f32(height))
    let input = events()
    mut ui = s.ui
    mut l = s.lab
    // (The lab runs on its own clock, slowed as its panel says.)
    l.clock += clamp(time - l.last_time, 0.0, 0.1) * l.speed
    l.last_time = time
    let g = l.clock
    ui.begin(screen, input)
    var punch = false
    for e in input {
        if let Event::PadButton { button, pressed, .. } = e {
            if pressed && (button == PadButton::West || button == PadButton::South) {
                punch = true
            }
        }
    }
    if ui.key(Key::J) || ui.key(Key::F) {
        punch = true
    }
    if ui.key(Key::H) {
        l.panel = !l.panel
    }
    let r = Rect::new(screen.x - LAB_W - 10.0, 10.0, LAB_W, 640.0)
    if ui.pointer_pressed() && !(l.panel && r.contains(ui.pointer())) {
        punch = true
    }
    if l.panel {
        ui.begin_panel("Combat lab", r)
        ui.label("Punch: J, F, click or pad. H: hide")
        ui.begin_row()
        if ui.button("Tune A") {
            l.editing_b = false
        }
        if ui.button("Tune B") {
            l.editing_b = true
        }
        ui.label(if l.editing_b { "  editing B" } else { "  editing A" })
        ui.end_row()
        var t = l.live()
        // (Both slots strike the same opponent, so A and B differ only in their tuning.)
        if ui.toggle("Opponent: stone giant", mut t.giant) {
            l.a.giant = t.giant
            l.b.giant = t.giant
        }
        ui.slider("Hit-stop (s)", mut t.hold, lo: 0.0, hi: 0.3)
        ui.slider("Impact frame (s)", mut t.flash, lo: 0.0, hi: 0.12)
        ui.slider("Camera kick (m)", mut t.kick, lo: 0.0, hi: 0.2)
        ui.slider("Camera push in (m)", mut t.push, lo: 0.0, hi: 0.8)
        ui.slider("Blast ring size (0 = off)", mut t.blast, lo: 0.0, hi: 4.0)
        ui.slider("Giant flinch", mut t.give, lo: 0.0, hi: 1.5)
        ui.slider("Body leans in during stop", mut t.grind, lo: 0.0, hi: 1.0)
        ui.slider("Fist rides the hit (s)", mut t.pin, lo: 0.0, hi: 0.15)
        ui.slider("Recoil into puncher", mut t.recoil, lo: 0.0, hi: 0.4)
        ui.toggle("Drawn on twos", mut t.twos)
        ui.begin_row()
        for k in 0..2 {
            if ui.button(preset_name(u32(k))) {
                t = preset(u32(k), t.giant)
            }
        }
        ui.end_row()
        ui.begin_row()
        for k in 2..4 {
            if ui.button(preset_name(u32(k))) {
                t = preset(u32(k), t.giant)
            }
        }
        ui.end_row()
        if l.editing_b { l.b = t } else { l.a = t }
        ui.space(6.0)
        ui.slider("Speed (1 = real time)", mut l.speed, lo: 0.1, hi: 1.0)
        ui.slider("Camera distance", mut l.zoom, lo: 0.6, hi: 1.6)
        ui.slider("Volume", mut l.volume, lo: 0.0, hi: 1.0)
        ui.space(6.0)
        ui.begin_row()
        if l.recording {
            if ui.button("Stop") {
                l.stop(g)
            }
        } else if ui.button("Record") {
            l.record(g)
        }
        if l.replaying {
            if ui.button("Stop replay") {
                l.stop(g)
            }
        } else if ui.button("Replay A then B") {
            l.replay(g)
        }
        ui.end_row()
        let status = if l.recording {
            f"Recording: {l.punches.len()} punch(es), {g - l.rec_from:.1} s"
        } else if l.replaying {
            // (The sliders show the slot being edited, which may not be the one playing.)
            if l.editing_b { "Replaying A, B in turn. Sliders: B" } else {
                "Replaying A, B in turn. Sliders: A"
            }.to_string()
        } else {
            f"Take: {l.punches.len()} punch(es), {l.take_len:.1} s"
        }
        ui.label(status)
        ui.end_panel()
    }
    if l.replaying {
        // (Big enough to read at a glance which slot is playing.)
        ui.panel("", Anchor::TopLeft, width: 170.0, height: 44.0)
        ui.label(if l.now.b { "Showing B" } else { "Showing A" })
        ui.end_panel()
    }
    if punch {
        l.press(g)
    }
    l.tick(g)
    ui.end()
    s.renderer.upload(ui.draw)
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if SHOW == 29 {
        lab_panel(mut s, time, width, height)
    }
    if width != s.width || height != s.height {
        s.colour = texture(width: width, height: height)
        s.marks = texture(width: width, height: height)
        s.normal = texture(width: width, height: height)
        s.depth = depth_texture(width, height)
        s.width = width
        s.height = height
    }
    let game = SHOW == 11 || SHOW == 12 || SHOW == 13
    let crosses = SHOW == 13 ||
        SHOW == 16 ||
        SHOW == 18 ||
        SHOW == 19 ||
        SHOW == 20 ||
        SHOW == 21 ||
        SHOW == 22 ||
        SHOW == 23 ||
        SHOW == 24 ||
        SHOW == 25 ||
        SHOW == 26 ||
        SHOW == 27 ||
        SHOW == 28 ||
        SHOW == 29

    let dt = clamp(time - s.last, 1.0e-4, 0.1)
    let (pose, place) = if game { played(mut s, time) } else if SHOW == 29 {
        (lab::striker_at(s.lab, s.lab.clock), identity())
    } else { (pose_at(time), identity()) }
    var bones = palette(HERO.rig, pose, place)
    // The exchange's clock and tuning: the scripted one's, or the lab's last press's (below 0,
    // no exchange).
    let xt = if SHOW == 29 { s.lab.shown() } else { exchange::TUNED }
    let xc = if SHOW == 28 { time } else if SHOW == 29 { lab::exchange_clock(s.lab) } else { -1.0 }
    // (How swiftly the fist is going in, 0 to 1: the smear's drawing.)
    var swift = 0.0

    // Hakuro as the body a game plays: how he's holding himself, eased from what he's doing.
    let hero = HAKURO == 1 && SHOW == 11
    if hero {
        let acting = s.mover.acting != humanoid::NONE
        let rolling = acting && !s.mover.upper
        let punching = acting && s.mover.acting == ACT_PUNCH
        let stands = s.mover.doing == playback::STANDING && !acting && s.mover.speed < 0.3
        let ease = |x: f32, to: bool, over: f32| -> f32 {
            x + ((if to { 1.0 } else { 0.0 }) - x) * (1.0 - exp(-dt / over))
        }
        s.held = vec4(
            ease(s.held.x, !rolling, 0.12),
            ease(s.held.y, !acting, 0.08),
            ease(s.held.z, stands, 0.25),
            ease(s.held.w, punching, 0.06),
        )
    }
    // (Carried his own way: his bearing at the speed he's going, his arms left to a punch.)
    let carry = |p: Pose| -> Pose {
        if !hero {
            return p
        }
        let how = manner::bearing_at(s.mover.speed).part(s.held.x)
        bearing::carried(HERO.rig, p, bearing::Bearing { trail: how.trail * s.held.y, ..how })
    }
    bones = palette(HERO.rig, carry(pose), place)

    var kinetic = KINETIC
    var force = anime::Force::none()
    if game && ANIME == 1 {
        let d = if crosses {
            anime::drawn(
                mut s.drawer,
                s.mover,
                accad_fists::ACTS,
                accad_fists::LOOKS,
                HERO.rig,
                s.mask,
                pose,
                place,
                Anime { drawings: DRAWINGS },
                dt,
            )
        } else {
            anime::drawn(
                mut s.drawer,
                s.mover,
                FIGHT_ACTS,
                LOOKS,
                HERO.rig,
                s.mask,
                pose,
                place,
                Anime { smear: SMEAR },
                dt,
            )
        }
        bones = anime::smeared(palette(HERO.rig, carry(d.pose), d.place), HERO.rig, d.smears)
        kinetic = max(kinetic, d.impact)
        force = d.force
    }
    write(mut s.palette, 0, bones)
    if hero {
        s.fighters.pose(0, manner::palette_of(bones, standing: s.held.z, fists: s.held.w))
    }
    let fight = HAKURO == 1 && (SHOW == 28 || SHOW == 29)
    if fight {
        // His punching arm smeared on the drawings where his fist is going in fast.
        let rw0 = HERO.rig.rest_world()
        let before = if SHOW == 28 { pose_at(time - 1.0 / 60.0) } else {
            lab::striker_at(s.lab, s.lab.clock - 1.0 / 60.0)
        }
        let was = bone_at(palette(HERO.rig, before, place), rw0, "rightHand")
        let fist = bone_at(bones, rw0, "rightHand")
        let going = (fist - was) * 60.0
        // (Only on its way in: the contact drawing is the clean one.)
        let short = dot(exchange::KNUCKLES - exchange::BLOW * 0.09 - fist, exchange::BLOW)
        swift = clamp((dot(going, exchange::BLOW) - 2.0) / 3.0, 0.0, 1.0) *
            smoothstep(0.03, 0.1, short)
        // (And his fist drawn big where it counts: going in, and on the face.)
        let landed = if xc >= 0.0 { exchange::squash(xc, xt) / exchange::X_SQUASH } else { 0.0 }
        let way = if landed > 0.0 { exchange::BLOW } else { going }
        let big = 1.0 + max(0.3 * swift, exchange::X_FIST * landed)
        s.fighters.pose(
            0,
            fighter::smeared(hakuro_palette(bones), fist, way, exchange::X_SMEAR * swift, big),
        )
        s.fighters.fist_grown(0, 1, big)
    }
    if SHOW == 28 {
        var foe = palette(
            HERO.rig,
            exchange::clear_of(
                exchange::struck(exchange::played_at(time, exchange::TUNED), exchange::TUNED),
                exchange::PLACE,
                pose,
            ),
            exchange::PLACE,
        )
        foe[63] = mat4(
            exchange::STRUCK_TINT,
            vec4(normalize((exchange::PLACE * vec4(1.0, 0.0, 0.0, 0.0)).xyz), 1.0),
            vec4(0.0),
            vec4(0.0),
        )
        write(mut s.palette2, 0, foe)
        if fight {
            s.fighters.pose(1, struck_palette(foe, xc, xt))
        }
    }
    let shown = s.lab.shown()
    if SHOW == 29 {
        let at = exchange::place(shown)
        // (His hands kept out of the punching arm; the giant's are far above it.)
        let struck = lab::struck_at(s.lab, s.lab.clock)
        let struck = if shown.giant { struck } else { exchange::clear_of(struck, at, pose) }
        var foe = palette(HERO.rig, struck, at)
        foe[63] = mat4(
            exchange::tint(shown),
            vec4(normalize((at * vec4(1.0, 0.0, 0.0, 0.0)).xyz), 1.0),
            vec4(0.0),
            vec4(0.0),
        )
        write(mut s.palette2, 0, foe)
        if fight {
            s.fighters.pose(1, struck_palette(foe, xc, xt))
        }
    }
    // The camera follows the hips along the ground, steadily: where they are on average over a
    // stride, so it neither surges with each step nor sways with the hips. A game's body is
    // followed where gameplay puts it, which is steady already.
    let (kick, push) = if SHOW == 28 { exchange::camera(time, exchange::TUNED) } else if SHOW ==
        29 { lab::camera(s.lab, s.lab.clock) } else { (0.0, 0.0) }
    if SHOW == 28 {
        kinetic = max(kinetic, exchange::flash(time, exchange::TUNED))
    }
    if SHOW == 29 {
        kinetic = max(kinetic, lab::flash(s.lab, s.lab.clock))
    }
    let hips = if SHOW == 28 {
        (vec3(0.0, 0.0, 0.25) + exchange::PLACE[3].xyz) * 0.5 + exchange::BLOW * kick
    } else if SHOW == 29 {
        // (The giant framed wide enough for his whole body, the striker nearer the middle.)
        mix(vec3(0.0, 0.0, 0.25), exchange::place(shown)[3].xyz, if shown.giant { 0.45 } else {
            0.5
        }) + exchange::BLOW * kick + lab_aside(shown, s.lab, width)
    } else if SHOW == 26 { vec3(0.0, 0.0, 0.25) } else if SHOW == 19 {
        vec3(0.0, 0.0, 0.25) +
            kimodo::a_shake(time % kimodo::stance_round() - kimodo::STANCE.length())
    } else if SHOW == 16 {
        vec3(0.0, 0.0, 0.25) +
            kimodo::a_shake(time % (kimodo::TIMED.length() + 0.4) - kimodo::STILL)
    } else if SHOW == 12 || crosses { vec3(0.0, 0.0, 0.25) } else if game {
        s.mover.place
    } else {
        steady_hips(time)
    }
    let walking = SHOW != 12 && !crosses && (SHOW >= 3 || (SHOW == 0 && time >= WALK_AT))
    let side = if SHOW == 28 || SHOW == 29 { -exchange::BLOW.z / exchange::BLOW.x } else if SHOW ==
        12 ||
        crosses { CROSS_SIDE } else if walking { SIDE } else { -0.55 }
    let left = normalize((bones[0] * vec4(1.0, 0.0, 0.0, 0.0)).xyz)
    // (The lab frames the fighter or the giant, as far as its panel says.)
    let (far, focus) = if SHOW != 29 { (FAR, FOCUS) } else if shown.giant {
        (12.0 * s.lab.zoom, 3.6)
    } else { (3.4 * s.lab.zoom, 1.05) }
    // (The hit staged close: the camera in on the contact as the cross winds up, out again
    // as he's knocked away.)
    let stage = if SHOW == 28 { exchange::staged(time, exchange::TUNED) } else if SHOW == 29 {
        lab::staged(s.lab, s.lab.clock)
    } else { 0.0 }
    let with = if SHOW == 28 { exchange::staged_with(time, exchange::TUNED) } else if SHOW == 29 {
        lab::staged_with(s.lab, s.lab.clock)
    } else { 0.0 }
    var shot = shot_at(
        time,
        mix(focus, exchange::X_STAGE_FOCUS, stage),
        vec3(hips.x + exchange::BLOW.x * with, 0.0, hips.z + exchange::BLOW.z * with),
        width,
        height,
        far * mix(1.0, exchange::X_STAGE, stage) - push,
        side,
        kinetic,
        left,
    )
    shot.force_from = vec4(force.from, if force.heavy { 1.0 } else { 0.0 })
    shot.force_to = vec4(force.to, force.by)
    if SHOW == 28 {
        let (b0, b1) = exchange::blast(time, exchange::TUNED)
        shot.blast = b0
        shot.blast_dir = b1
    }
    if fight {
        // Each fighter's own shadow, and the strike's force along the striker's arm.
        let rw = HERO.rig.rest_world()
        let mine = bone_at(bones, rw, "hips")
        let his = if SHOW == 28 { exchange::PLACE[3].xyz } else { exchange::place(shown)[3].xyz }
        // (`w` 2: they cast their own shadows, in their own shapes.)
        shot.pair_a = vec4(mine.x, 0.0, mine.z, 2.0)
        shot.pair_b = vec4(his.x, 0.0, his.z, 2.0)
        if xc >= 0.0 {
            // (Going in, the force is the fist's own speed, and the ink trails off it; landed,
            // the strike's, dying after the hit-stop.)
            let coming = xc < exchange::hit_at()
            let by = if coming { swift } else { exchange::force(xc, xt) }
            shot.force_from = vec4(bone_at(bones, rw, "rightUpperArm"), if coming { swift } else {
                0.0
            })
            shot.force_to = vec4(bone_at(bones, rw, "rightHand"), by)
        }
    }
    if SHOW == 29 {
        let (b0, b1) = lab::blast(s.lab, s.lab.clock)
        shot.blast = b0
        shot.blast_dir = b1
        // The sounds: heard from the camera, the fist's whoosh as it goes and the hit as it lands
        // (harder the longer the hit-stop holds it).
        let at = vec3(hips.x, focus, hips.z)
        let eye = at + normalize(vec3(side, 0.18, 1.0)) * (far - push)
        let fwd = normalize(vec2(at.x - eye.x, at.z - eye.z))
        let _ = s.cues.push(Cue::Listen { at: eye, forward: fwd })
        let (swing, hit) = lab::sounds(mut s.lab, s.lab.clock)
        let v = s.lab.volume
        let fist = exchange::KNUCKLES
        if swing && v > 0.0 {
            let _ = s.cues.push(
                Cue::Whoosh { at: fist, kind: 0, amount: 0.8 * v, seed: u32(time * 60.0) },
            )
        }
        if hit && v > 0.0 {
            let kind = if shown.giant { 1 } else { 0 }
            let strength = v * (0.75 + shown.hold)
            let _ = s.cues.push(Cue::Impact { at: fist, kind, strength, seed: u32(time * 60.0) })
        }
    }
    if hero {
        // (He casts his own shadow, in his own shape; his coat's in the air he goes through.)
        shot.pair_a = vec4(s.mover.place.x, 0.0, s.mover.place.z, 2.0)
        shot.pair_b = shot.pair_a
        s.fighters.step(dt, going: manner::air_at(s.mover.speed, time))
    }
    // Hakuro alone in `SHOW=12`'s place (`CHARTED`).
    let alone = CHARTED == 1 && SHOW == 12
    if alone {
        s.fighters.pose(0, hakuro_palette(bones))
        s.fighters.step(dt)
    }
    if fight {
        // (Their cloth moves on the bodies' clock: held through the hit-stop with them.)
        let played = if SHOW == 28 { exchange::played_at(time, exchange::TUNED) } else { time }
        s.fighters.step(clamp(played - s.cloth_at, 0.0, 0.1))
        s.cloth_at = played
    }
    let p = begin_pass3_with_depth(
        mut s.colour,
        mut s.marks,
        mut s.normal,
        mut s.depth,
        clear: vec4(0.0),
        clear_depth: 0.0,
    )
    draw(p, backdrop, paint_backdrop.bind(shot: shot), vertices: 3, depth: engine::view::NEAREST)
    draw(
        p,
        ground.bind(shot: shot),
        paint_ground.bind(shot: shot),
        vertices: 6,
        depth: engine::view::NEAREST,
    )
    if fight || hero || alone {
        s.fighters.draw(p, shot)
    } else {
        draw(
            p,
            body.bind(verts: s.verts.items(), palette: s.palette.items(), shot: shot),
            paint_body.bind(shot: shot),
            indices: s.indices,
            index_count: HERO.indices.len(),
            cull: Cull::Back,
            depth: engine::view::NEAREST,
        )
        if (SHOW == 28 && exchange::X_FOE == 1) || SHOW == 29 {
            let shot2 = shot
            draw(
                p,
                body.bind(verts: s.verts.items(), palette: s.palette2.items(), shot: shot2),
                paint_body.bind(shot: shot2),
                indices: s.indices,
                index_count: HERO.indices.len(),
                cull: Cull::Back,
                depth: engine::view::NEAREST,
            )
        }
    }
    p.end()
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        screen,
        backdrop,
        ink.bind(shot: shot, colour: s.colour, marks: s.marks, normal: s.normal),
        vertices: 3,
    )
    if SHOW == 29 {
        s.renderer.draw(screen, vec2(f32(width), f32(height)))
    }
    screen.present()
}

/// The body converts onto VRM's bones within the engine's 64, and its clips with it: the walk
/// goes ahead (+z) a stride (two steps) a loop, and the idle stays where it stands.
@test
fn the_body_and_its_clips_convert() {
    let r = HERO.rig.clone()
    assert(r.bones.len() == 52, f"the rig has {r.bones.len()} bones, not 52")
    assert(r.find("hips") == 0 && r.find("leftToes") != humanoid::NONE)
    assert(HERO.verts.len() > 8000 && HERO.indices.len() % 3 == 0)
    assert(HERO.hi.y > 1.7 && HERO.hi.y < 1.9, f"the body stands {HERO.hi.y} m tall")
    assert(WALK.travel.z > 1.0 && WALK.travel.z < 1.4, f"a walk's loop goes {WALK.travel} m")
    assert(abs(WALK.travel.x) < 0.05)
    assert(length(IDLE.travel) < 0.05, f"the idle wanders {IDLE.travel} m a loop")
}

/// At rest, each bone's palette matrix is the identity: the rig's rest pose is the mesh's bind.
@test
fn the_t_pose_is_the_bind_pose() {
    let m = palette(HERO.rig, T_POSE.pose(0.0), identity())
    var worst = 0.0
    for b in 0..HERO.rig.bones.len() {
        for c in 0..4 {
            worst = max(worst, length(m[b][c] - identity()[c]))
        }
    }
    assert(worst < 1.0e-3, f"a bone's rest palette is {worst} from the identity")
}

/// A walk's loop meets itself: its last frame's turns are its first's.
@test
fn the_walk_loops_without_a_pop() {
    let n = WALK.frames - 1
    var worst = 0.0
    for b in 0..WALK.bones {
        let a = WALK.turns[b].v
        let z = WALK.turns[n * WALK.bones + b].v
        worst = max(worst, min(length(a - z), length(a + z)))
    }
    assert(worst < 1.0e-3, f"the walk's seam is {worst} apart")
}

/// Each frame records draws the host accepts.
@test(frames: 2)
fn frames_record_valid_draws() {}

fn bone_at(m: [mat4; 64], rw: [humanoid::Rigid], b: str) -> vec3 {
    let i = HERO.rig.find(b)
    (m[i] * vec4(rw[i].t, 1.0)).xyz
}

/// The walk faces where it goes: through a loop and into the next, its hips go ahead (+z), its
/// left is +x and its toes point ahead (within 45°: a foot rolls in as it pushes off).
@test
fn the_walk_faces_ahead() {
    let rw = HERO.rig.rest_world()
    var last = -1.0
    for k in 0..12 {
        let t = f32(k) * 0.25
        let m = palette(HERO.rig, WALK.pose(t), identity())
        let h = bone_at(m, rw, "hips")
        let left = bone_at(m, rw, "leftUpperLeg") - bone_at(m, rw, "rightUpperLeg")
        let toes = bone_at(m, rw, "leftToes") - bone_at(m, rw, "leftFoot")
        assert(h.z > last, f"at {t} s the hips went back, to {h.z}")
        assert(left.x > 0.15 && abs(left.z) < 0.08, f"at {t} s the pelvis turned: {left}")
        assert(toes.z > abs(toes.x), f"at {t} s the left toes point {toes}")
        last = h.z
    }
}

/// A planted foot stays put: frame to frame, an ankle down on the ground (within 2 cm of its
/// height at rest) moves no more than 1.5 cm along it (a stance eases in and out).
@test
fn the_walk_plants_its_feet() {
    let rw = HERO.rig.rest_world()
    let n = WALK.frames - 1
    for foot in ["leftFoot", "rightFoot"] {
        let rest = rw[HERO.rig.find(foot)].t.y
        var last = vec3(0.0)
        var down = false
        for f in 0..n {
            let t = f32(f) / WALK.fps
            let a = bone_at(palette(HERO.rig, WALK.pose(t), identity()), rw, foot)
            let now = a.y < rest + 0.01
            if now && down {
                let slide = length(vec2(a.x - last.x, a.z - last.z))
                assert(slide < 0.015, f"at {t} s the planted {foot} slid {slide} m")
            }
            down = now
            last = a
        }
    }
}

/// Every clip that's ready passes its review (`engine::review`: what an animator's eye looks
/// for, measured): the walk made human (`engine::stride`), and the idle and the run as the
/// cleanup every clip goes through leaves them (`engine::cleanup`), untuned. The walk's take
/// passes too, cleaned up in place of the walk's own making, and so does a walk from mocap the
/// cleanup was never tuned on (ACCAD's Male 1).
@test
fn every_clip_passes_its_review() {
    let r = HERO.rig.clone()
    passes("the walk", WALK.clone(), r.clone())
    passes("the idle", IDLE.clone(), r.clone())
    passes("the run", RUN.clone(), r.clone())
    passes(
        "the walk's take, cleaned",
        cleanup::cleaned(WALK_RAW.clone(), r.clone(), Cleanup {}),
        r.clone(),
    )
    passes("ACCAD's Male 1 walk", ACCAD_M1_WALK.clone(), r)
}

/// A foot that swings low clears the floor: ACCAD's Male 2 walk's left heel skims it at 6 m/s
/// as it swings (8 mm over it as the take comes, under it once its feet are set on the floor),
/// and the cleanup lifts every heel and ball going faster than twice a heel lands clear of it
/// (`engine::cleanup`'s `CLEAR`, 1.29 cm).
@test
fn a_swinging_foot_clears_the_floor() {
    let rig = HERO.rig.clone()
    let clip = ACCAD_M2_WALK.clone()
    let n = clip.frames - 1
    for side in [1.0, -1.0] {
        let l = stride::leg_of(rig.clone(), side)
        var was = (vec3(0.0), vec3(0.0))
        for f in 0..n {
            let w = stride::worlds(rig.clone(), clip.clone(), f)
            let (a, t) = (w[l.ankle], w[l.toes])
            let (heel, ball) = (a.t + a.q.rotate(l.heel), t.t + t.q.rotate(l.ball))
            if f > 0 {
                for (p, q) in [(heel, was.0), (ball, was.1)] {
                    let speed = length(vec2(p.x - q.x, p.z - q.z)) * clip.fps
                    assert(
                        speed < 1.74 || p.y - l.floor > 0.012,
                        f"frame {f}: a foot {(p.y - l.floor) * 100.0:.2} cm over the floor at {speed:.2} m/s",
                    )
                }
            }
            was = (heel, ball)
        }
    }
}

/// What the cleanup can't make right, the review sends for a look: the walking turns' take
/// hops mid-turn, and the jog (a library's cartoon, not a person's) bounds, its steps too long
/// and too few for how fast its feet sweep.
@test
fn the_review_sends_the_rest_for_a_look() {
    let r = HERO.rig.clone()
    flags("the walking turns", TURNS.clone(), r.clone(), "the body hops")
    flags("the jog", JOG.clone(), r, "the steps are too long")
}

/// A take that turns as it goes keeps its head on its body: the neck's carriage (the take's
/// mean neck and head, `Retarget::carried`) is taken about the way the body faces each frame,
/// not the room's, so the head faces with the chest on average (looking into each turn).
@test
fn the_turns_keep_the_head_with_the_body() {
    let rig = HERO.rig.clone()
    let rw = rig.rest_world()
    let (head, chest) = (rig.find("head"), rig.find("upperChest"))
    let ahead = |w: [humanoid::Rigid], b: u32| -> f32 {
        let d = w[b].q.mul(rw[b].q.inverse()).rotate(vec3(0.0, 0.0, 1.0))
        atan2(d.x, d.z)
    }
    var sum = 0.0
    for f in 0..TURNS.frames {
        let w = stride::worlds(rig.clone(), TURNS.clone(), f)
        var off = ahead(w.clone(), head) - ahead(w, chest)
        off -= 6.2831853 * floor((off + 3.14159265) / 6.2831853)
        sum += off
    }
    let mean = sum / f32(TURNS.frames) * 57.29578
    assert(abs(mean) < 5.0, f"the walking turns' head faces {mean:.1}° off the chest on average")
}

/// That a clip's review flags nothing.
fn passes(name: str, clip: Clip, rig: humanoid::Rig) {
    let rv = review(clip, rig)
    assert(rv.flags.len() == 0, rv.text(name).as_str())
}

/// The review sees what's wrong with the takes as they come: the walk's feet sliding, the
/// idle's sinking into the floor, the run's cut seam jumping, the jog running on the spot.
@test
fn the_review_sees_the_takes_faults() {
    let r = HERO.rig.clone()
    flags("the walk's take", WALK_RAW.clone(), r.clone(), "the left foot slides")
    flags("the walk's take", WALK_RAW.clone(), r.clone(), "the left foot slips")
    flags("the idle's take", IDLE_RAW.clone(), r.clone(), "the left foot sinks")
    flags("the run's take", RUN_RAW.clone(), r.clone(), "the neck pops")
    flags("the jog's take", JOG_RAW.clone(), r, "the left foot slides along the floor as on a")
}

/// That a clip's review has a flag that starts `what`.
fn flags(name: str, clip: Clip, rig: humanoid::Rig, what: str) {
    let rv = review(clip, rig)
    var seen = false
    for f in rv.flags.clone() {
        seen = seen || f.as_str().starts_with(what)
    }
    assert(seen, f"{name}: no flag says {what}\n{rv.text(name)}")
}

// ---- the body played as a game plays it (`engine::playback`) --------------------------------

/// The walk and the run play in place, gameplay carrying them on, and each foot comes down once
/// a loop, half a loop after the other; the idle stands.
@test
fn the_gaits_play_in_place_with_their_footfalls() {
    for (name, m) in [("walk", GAITS.walk.clone()), ("run", GAITS.run.clone())] {
        let a = m.clip.hips[0]
        let z = m.clip.hips[m.clip.frames - 1]
        assert(
            length(vec2(z.x - a.x, z.z - a.z)) < 0.01,
            f"the {name} moves {z - a} m a loop in place",
        )
        let l = m.mark(playback::STEP_LEFT)
        let r = m.mark(playback::STEP_RIGHT)
        assert(l.is_some() && r.is_some(), f"the {name} has no footfall marked")
        assert(m.passed(playback::STEP_LEFT, 0.0, m.length()) == 1)
        let apart = abs(r.unwrap().from - l.unwrap().from) / m.length()
        print(
            f"{name}: {m.speed:.2} m/s, {m.stride:.2} m a stride, left down at {l.unwrap().from:.3} s, right at {r.unwrap().from:.3} s ({apart:.2} of a loop apart)",
        )
        assert(apart > 0.4 && apart < 0.6, f"the {name}'s feet come down {apart} of a loop apart")
    }
    assert(
        GAITS.walk.speed > 0.9 && GAITS.walk.speed < 1.8,
        f"the walk goes {GAITS.walk.speed} m/s",
    )
    assert(GAITS.run.speed > GAITS.walk.speed + 0.3)
    assert(GAITS.idle.marks.len() == 0, "the idle steps")
}

/// The ankles' heights over the floor on a pose.
fn ankles(pose: Pose) -> (f32, f32) {
    let m = palette(HERO.rig, pose, identity())
    let rw = HERO.rig.rest_world()
    (bone_at(m, rw, "leftFoot").y, bone_at(m, rw, "rightFoot").y)
}

/// The walk and the run mixed at one phase put the same foot down together: after phase 0 the
/// left foot is the one on the ground in both, after one half the right.
@test
fn the_walk_and_the_run_keep_step() {
    for (name, m) in [("walk", GAITS.walk.clone()), ("run", GAITS.run.clone())] {
        // Over each foot's first quarter after it comes down, it's the lower.
        var left_lower = 0.0
        var right_lower = 0.0
        for k in 0..10 {
            let (l, r) = ankles(m.at_phase(f32(k) / 40.0))
            left_lower += r - l
            let (l2, r2) = ankles(m.at_phase(0.5 + f32(k) / 40.0))
            right_lower += l2 - r2
        }
        print(
            f"{name}: the left ankle is {left_lower * 10.0:.1} cm lower on average after phase 0, the right {right_lower * 10.0:.1} cm after one half",
        )
        assert(
            left_lower > 0.0 && right_lower > 0.0,
            f"the {name}'s footfalls aren't at its phases",
        )
    }
}

/// The punch is fitted to the fight's attack: as long as its frames, its windows where the fight
/// has them, and its fist going fastest within the active frames. Reviewed as a hand-keyed move
/// it isn't flagged for the snap it's for.
@test
fn the_punch_lands_when_the_fight_says() {
    let total = f32(body::ATTACK_WINDUP + body::ATTACK_ACTIVE + body::ATTACK_RECOVERY) / body::HZ
    assert(
        abs(PUNCH.length() - total) < 1.0 / 30.0,
        f"the punch lasts {PUNCH.length()} s, not {total}",
    )
    let active = PUNCH.mark(playback::ACTIVE).unwrap()
    assert(abs(active.from - f32(body::ATTACK_WINDUP) / body::HZ) < 1.0e-4)
    let strike = playback::strike_of(PUNCH, HERO.rig, "rightHand")
    print(
        f"the punch: {PUNCH.length():.3} s, hits from {active.from:.3} to {active.till:.3} s, its fist fastest at {strike:.3} s",
    )
    assert(
        strike > active.from - 2.0 / 30.0 && strike < active.till + 2.0 / 30.0,
        f"the fist is fastest at {strike} s, not when it hits",
    )
    let keyed = engine::review::review_as(PUNCH.clip.clone(), HERO.rig, engine::review::KEYED)
    let judged = review(PUNCH.clip.clone(), HERO.rig)
    print(keyed.text("the punch, as a keyed move"))
    print(judged.text("the punch, as locomotion"))
}

/// The bones that carry the body's shape (not its fingers).
const MAJOR: [Text; 16] = [
    "hips",
    "spine",
    "chest",
    "upperChest",
    "neck",
    "head",
    "leftUpperArm",
    "leftLowerArm",
    "rightUpperArm",
    "rightLowerArm",
    "leftUpperLeg",
    "leftLowerLeg",
    "rightUpperLeg",
    "rightLowerLeg",
    "leftFoot",
    "rightFoot",
]

/// What a run of `script` shows: about each change, the most a joint moved in a frame in the
/// body's own space (m); the fastest a foot on the floor went along it (m/s), steadily and in a
/// change's first third of a second; and whether the body stood at the end.
struct Played: Copy {
    worst: f32,
    slide: f32,
    slide_change: f32,
    stood: bool,
}

/// The body played by `script` for 20 s at 60 Hz, handled as `how` says, measured each frame.
fn played_by(how: Handling) -> Played {
    let hz = 60.0
    let rig = HERO.rig.clone()
    let rw = rig.rest_world()
    let mask = playback::upper_body(rig)
    let rest_ankle = rw[rig.find("leftFoot")].t.y
    var m = Mover::standing(vec3(0.0), 0.0, GAITS)
    var last = 0.0
    let joints = [
        "hips",
        "head",
        "leftHand",
        "rightHand",
        "leftFoot",
        "rightFoot",
        "leftLowerLeg",
        "rightLowerLeg",
    ]
    var was: Vec<vec3> = Vec::filled(joints.len(), vec3(0.0))
    var worst = 0.0
    var worst_at = 0.0
    var worst_name: Text = ""
    var since = 100
    var doing = m.doing
    var acting = m.acting
    var slide = 0.0
    var slide_at = 0.0
    var slide_change = 0.0
    var slide_change_at = 0.0
    var prev_l = vec3(0.0)
    var prev_r = vec3(0.0)
    var low_l = 0
    var low_r = 0
    for f in 1..u32(21.5 * hz) {
        let time = f32(f) / hz
        let (stick, act, upper) = script(last, time)
        let pose = playback::step(
            mut m,
            GAITS,
            ACTS,
            rig,
            mask,
            stick,
            act,
            upper,
            how,
            1.0 / hz,
        )
        last = time
        if m.doing != doing || m.acting != acting {
            since = 0
            // How far a cut would have jumped: the biggest turn the change hides.
            var cut = 0.0
            var cut_bone = 0
            for name in MAJOR {
                let b = rig.find(name)
                let a = length(m.inertia.turns[b]) * 57.29578
                if a > cut {
                    cut = a
                    cut_bone = b
                }
            }
            print(
                f"{time:.3} s: doing {m.doing}, acting {m.acting}, going {m.speed:.2} m/s, phase {m.phase:.2}; a cut would jump a bone {cut:.0}° (bone {cut_bone}, VRM {humanoid::BONES[rig.bones[cut_bone].vrm]})",
            )
            doing = m.doing
            acting = m.acting
        }
        let pal = palette(rig, pose, playback::placed(m))
        let own = palette(rig, pose, identity())
        for j in 0..joints.len() {
            let p = bone_at(own, rw, joints[j])
            if f > 1 && since < 4 && m.acting != ACT_ROLL {
                // How far it moved in a frame, about a change (but the roll's own start, which is
                // as fast as Quaternius keyed it).
                let d = length(p - was[j])
                if d > worst {
                    worst = d
                    worst_at = time
                    worst_name = joints[j]
                }
            }
            was[j] = p
        }
        let l = bone_at(pal, rw, "leftFoot")
        let r = bone_at(pal, rw, "rightFoot")
        // A foot's on the floor once it's been low (its ankle within 1.5 cm of its height at rest)
        // for a tenth of a second: a swinging foot that skims the floor passes quicker.
        low_l = if l.y < rest_ankle + 0.015 { low_l + 1 } else { 0 }
        low_r = if r.y < rest_ankle + 0.015 { low_r + 1 } else { 0 }
        if f > 1 && m.acting == humanoid::NONE {
            for (now, before, low) in [(l, prev_l, low_l), (r, prev_r, low_r)] {
                if low > 6 {
                    let s = length(vec2(now.x - before.x, now.z - before.z)) * hz
                    if since >= 20 && s > slide {
                        slide = s
                        slide_at = time
                    }
                    if since < 20 && s > slide_change {
                        slide_change = s
                        slide_change_at = time
                    }
                }
            }
        }
        prev_l = l
        prev_r = r
        since += 1
    }
    print(
        f"about a change, the most a joint moved in a frame: {worst * 100.0:.1} cm, the {worst_name} at {worst_at:.3} s",
    )
    print(
        f"the fastest a foot on the floor went along it, steadily: {slide:.2} m/s at {slide_at:.3} s",
    )
    print(
        f"the fastest a foot on the floor went along it in a change's first third of a second: {slide_change:.2} m/s at {slide_change_at:.3} s",
    )
    print(
        f"(steadily at {slide_at:.3} s; about a change at {slide_change_at:.3} s; the joint, the {worst_name}, at {worst_at:.3} s)",
    )
    Played { worst, slide, slide_change, stood: m.doing == playback::STANDING }
}

/// Played by a scripted stick (walk off, turn, run, a punch over the run, stop, roll, walk back),
/// each change keeps the body's joints moving at their pace where a cut would jump them, and a
/// foot on the floor stays put, steadily and through the changes; the same script cut from move
/// to move with its feet left loose (`CUT=1`) jumps and skates.
@test
fn a_played_body_moves_without_a_pop() {
    let p = played_by(Handling {})
    let c = played_by(
        Handling { change_half: 1.0e-4, act_half: 1.0e-4, plant: false, clips: false },
    )
    print(
        f"inertial and planted: a joint moves {p.worst * 100.0:.1} cm a frame at most about a change; a foot on the floor goes {p.slide:.2} m/s steadily, {p.slide_change:.2} m/s about a change",
    )
    print(
        f"cut, feet loose: a joint moves {c.worst * 100.0:.1} cm a frame at most about a change; a foot on the floor goes {c.slide:.2} m/s steadily, {c.slide_change:.2} m/s about a change",
    )
    assert(p.stood, "the body didn't stop at the end")
    assert(p.worst < 0.5 * c.worst, f"a change jumps a joint {p.worst} m a frame (a cut {c.worst})")
    // What's left: a running foot that's slow to be judged down at 4 m/s.
    assert(p.slide < 0.8 && p.slide < c.slide, f"a foot on the floor skates at {p.slide} m/s")
    assert(
        p.slide_change < 0.25 * c.slide_change,
        f"a foot on the floor skates at {p.slide_change} m/s in a change (cut: {c.slide_change})",
    )
}

/// An impact frame (an arm snapped to a pose for a frame) is a pop to the locomotion review and
/// nothing to the keyed one, which judges only the feet and knees.
@test
fn a_keyed_move_may_snap() {
    var c = IDLE.clone()
    let b = HERO.rig.find("rightLowerArm")
    let f = c.frames / 2
    c.turns[f * c.bones + b] = Quat::axis_angle(vec3(0.0, 1.0, 0.0), 1.5).mul(
        c.turns[f * c.bones + b],
    )
    let judged = review(c.clone(), HERO.rig)
    let keyed = engine::review::review_as(c, HERO.rig, engine::review::KEYED)
    print(judged.text("the idle with a snap, as locomotion"))
    print(keyed.text("the idle with a snap, as a keyed move"))
    assert(judged.score < 10.0, "the locomotion review missed the snap")
    assert(keyed.score == 10.0, "the keyed review flagged the snap")
}

/// Drawn as anime is (`engine::anime`), the punch and the roll change drawing about twelve times
/// a second (on twos) where the walk and run change every frame; the punch strikes once, its
/// impact frame shown for a few frames and held, its fist smeared on the way in.
@test
fn the_fight_is_drawn_on_twos() {
    let hz = 60.0
    let rig = HERO.rig.clone()
    let mask = playback::upper_body(rig)
    var m = Mover::standing(vec3(0.0), 0.0, GAITS)
    var d = Drawer::new()
    var last = 0.0
    var acting_frames = 0
    var acting_changes = 0
    var impact_frames = 0
    var fist_smears = 0
    var before = Pose { turns: [Quat::identity(); 64], hips: vec3(0.0) }
    let arm = rig.find("rightLowerArm")
    for f in 1..u32(15.0 * hz) {
        let time = f32(f) / hz
        let (stick, act, upper) = script(last, time)
        let pose = playback::step(
            mut m,
            GAITS,
            ACTS,
            rig,
            mask,
            stick,
            act,
            upper,
            Handling {},
            1.0 / hz,
        )
        last = time
        let shown = anime::drawn(
            mut d,
            m,
            ACTS,
            LOOKS,
            rig,
            mask,
            pose,
            playback::placed(m),
            Anime {},
            1.0 / hz,
        )
        if m.acting != humanoid::NONE && LOOKS[m.acting].twos {
            acting_frames += 1
            if length(shown.pose.turns[arm].v - before.turns[arm].v) > 1.0e-6 {
                acting_changes += 1
            }
            if shown.impact > 0.0 {
                impact_frames += 1
            }
            if shown.smears[1].on && m.acting == ACT_PUNCH {
                fist_smears += 1
            }
        }
        before = shown.pose
    }
    let rate = f32(acting_changes) / (f32(acting_frames) / hz)
    print(
        f"acting {acting_frames} frames, {acting_changes} drawings ({rate:.1} a second); impact {impact_frames} frames; the fist smeared {fist_smears} frames",
    )
    assert(rate > 9.0 && rate < 14.0, f"the fight's drawn {rate} times a second")
    assert(
        impact_frames >= 2 && impact_frames <= 4,
        f"the impact frame showed {impact_frames} frames",
    )
    assert(fist_smears > 0, "the punch's fist never smeared")
}
