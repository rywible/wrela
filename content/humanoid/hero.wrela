// The hero's design over the body: what's added to its mesh as geometry on its bones, made when
// the program is built from the body's own shape (where its skull, its neck and its back are), so
// it fits whatever body it's given. The body's clothes are painted on it (`paint::outfit`).
//
// - Hair: a cap over the skull (the head's own surface above a hairline, lifted off it, clipped
//   clean along the line), and locks on it, each a tapered blade, swept back and up off the crown,
//   a fringe falling over the brow. All on the head bone.
// - A scarf: a thick roll round the base of the neck, on the neck and the upper chest.
// - A cape: a sheet from the scarf over the shoulders' backs to below the knees, folded, flaring
//   clear of the back and the legs; its top on the upper chest, its hem shared with the hips, so
//   it neither lags a stoop nor swings through the legs. (How it swings is a later step's.)

use std::collections::Vec
use engine::humanoid::{BodyVertex, Humanoid}
use engine::toon
use look::noise

/// The colours, sRGB: hair an ink black with the sea in it, the scarf and the cape's outside a
/// deep sun-faded red, the cape's lining a darker one.
pub const HAIR = vec3(0.17, 0.16, 0.21)
pub const SCARF = vec3(0.70, 0.16, 0.12)
pub const COAT_BLUE = vec3(0.13, 0.15, 0.30)
pub const LINING = vec3(0.55, 0.12, 0.10)
pub const SAND = vec3(0.80, 0.74, 0.62)
pub const BONE = vec3(0.90, 0.86, 0.74)
pub const WOOD = vec3(0.36, 0.22, 0.12)
pub const STONE = vec3(0.20, 0.62, 0.60)

fn pack(a: u32, b: u32, c: u32, d: u32) -> u32 {
    (a & 255) | ((b & 255) << 8) | ((c & 255) << 16) | ((d & 255) << 24)
}

fn srgb8(c: vec3) -> u32 {
    let q = clamp(c, vec3(0.0), vec3(1.0)) * 255.0 + vec3(0.5)
    pack(a: u32(q.x), b: u32(q.y), c: u32(q.z), d: 255)
}

/// A mesh being added: its vertices and triangles.
struct Mesh: Clone {
    verts: Vec<BodyVertex>,
    indices: Vec<u32>,
}

impl Mesh {
    /// A vertex at `pos` facing `normal`, on bones `a` and `b` (`wa` of 255 on `a`).
    fn vertex(
        mut self,
        pos: vec3,
        normal: vec3,
        a: u32,
        b: u32,
        wa: u32,
        colour: vec3,
        kind: u32,
        width: f32,
    ) -> u32 {
        self.verts.push(
            BodyVertex {
                pos,
                bones: pack(a: a, b: b, c: 0, d: 0),
                normal: normalize(normal),
                weights: pack(a: wa, b: 255 - wa, c: 0, d: 0),
                colour: srgb8(colour),
                part: 1,
                toon: toon::toon_word(occlusion: 0.0, width: width, kind: kind),
                outline: 0,
            },
        )
        self.verts.len() - 1
    }

    fn tri(mut self, a: u32, b: u32, c: u32) {
        self.indices.push(a)
        self.indices.push(b)
        self.indices.push(c)
    }
}

/// Where the head is: the middle and half-extents of what's on its bone.
struct Skull: Copy {
    centre: vec3,
    radii: vec3,
}

/// How far above the hairline a point of the head is (in the head's half-extents): the line high
/// over the brow, dipping over the ears, low at the nape.
fn above_hairline(s: Skull, p: vec3) -> f32 {
    let u = (p - s.centre) / s.radii
    let front = smoothstep(-0.2, 0.75, u.z)
    let line = mix(-0.62, 0.42, front) + 0.10 * (1.0 - front) * (1.0 - abs(u.x))
    u.y - line
}

/// `body` dressed (as this module's comment says).
pub fn dressed(body: Humanoid) -> Humanoid {
    borrow rig = body.rig
    let head = rig.find("head")
    let upper = if rig.find("upperChest") != engine::humanoid::NONE {
        rig.find("upperChest")
    } else {
        rig.find("chest")
    }
    let hips = rig.find("hips")
    var lo = vec3(1.0e9)
    var hi = vec3(-1.0e9)
    for v in body.verts {
        if (v.bones & 255) == head && toon::toon_of(v.toon).kind == toon::SKIN {
            lo = min(lo, v.pos)
            hi = max(hi, v.pos)
        }
    }
    let skull = Skull { centre: (lo + hi) * 0.5, radii: (hi - lo) * 0.5 }
    var m = Mesh { verts: Vec::new(), indices: Vec::new() }
    cap(mut m, body, skull, head)
    locks(mut m, body, skull, head)
    shell(mut m, body, COAT)
    shell(mut m, body, TROUSERS)
    tails(mut m, body, hips)
    beads(mut m, body, upper)
    var out = body.clone()
    let base = out.verts.len()
    for v in m.verts {
        out.lo = min(out.lo, v.pos)
        out.hi = max(out.hi, v.pos)
        out.verts.push(v)
    }
    for i in m.indices {
        out.indices.push(base + i)
    }
    out
}

/// The cap: each of the head's triangles above the hairline (clipped along it), lifted off the
/// skull along its normals, more on the crown.
fn cap(m: mut Mesh, body: Humanoid, s: Skull, head: u32) {
    let n = body.indices.len() / 3
    for t in 0..n {
        let ia = body.indices[t * 3]
        let ib = body.indices[t * 3 + 1]
        let ic = body.indices[t * 3 + 2]
        let a = body.verts[ia]
        let b = body.verts[ib]
        let c = body.verts[ic]
        if (a.bones & 255) != head || (b.bones & 255) != head || (c.bones & 255) != head {
            continue
        }
        if toon::toon_of(a.toon).kind != toon::SKIN {
            continue
        }
        let fa = above_hairline(s, a.pos)
        let fb = above_hairline(s, b.pos)
        let fc = above_hairline(s, c.pos)
        if fa <= 0.0 && fb <= 0.0 && fc <= 0.0 {
            continue
        }
        // Clip the triangle to the side above the line (Sutherland–Hodgman, one plane).
        let ps = [a.pos, b.pos, c.pos]
        let ns = [a.normal, b.normal, c.normal]
        let fs = [fa, fb, fc]
        var cp: Vec<vec3> = Vec::new()
        var cn: Vec<vec3> = Vec::new()
        for k in 0..3 {
            let j = (k + 1) % 3
            if fs[k] > 0.0 {
                cp.push(ps[k])
                cn.push(ns[k])
            }
            if (fs[k] > 0.0) != (fs[j] > 0.0) {
                let w = fs[k] / (fs[k] - fs[j])
                cp.push(mix(ps[k], ps[j], vec3(w)))
                cn.push(normalize(mix(ns[k], ns[j], vec3(w))))
            }
        }
        var ids: Vec<u32> = Vec::new()
        for k in 0..cp.len() {
            let u = (cp[k] - s.centre) / s.radii
            let lift = 0.006 +
                0.016 * saturate(u.y * 0.8 + 0.3) +
                0.006 * saturate(above_hairline(s, cp[k]) * 4.0)
            // Shaded as the skull's ellipsoid is, so its light and its highlight fall in clean shapes.
            let e = normalize((cp[k] - s.centre) / (s.radii * s.radii))
            ids.push(m.vertex(cp[k] + cn[k] * lift, e, head, head, 255, HAIR, toon::HAIR, 1.0))
        }
        for k in 1..ids.len() - 1 {
            m.tri(ids[0], ids[k], ids[k + 1])
        }
    }
}

/// The head's surface point nearest the direction `d` from its middle, and its normal.
fn on_skull(body: Humanoid, s: Skull, head: u32, d: vec3) -> (vec3, vec3) {
    var best = 0
    var bv = -2.0
    for i in 0..body.verts.len() {
        let v = body.verts[i]
        if (v.bones & 255) != head || toon::toon_of(v.toon).kind != toon::SKIN {
            continue
        }
        let x = dot(normalize((v.pos - s.centre) / s.radii), d)
        if x > bv {
            bv = x
            best = i
        }
    }
    (body.verts[best].pos, body.verts[best].normal)
}

/// One lock: a blade from `root`, `long` metres along `dir` and bending by `bend` (m at its tip),
/// `wide` at its root and flattened across `flat`, tapering to a point.
fn lock(
    m: mut Mesh,
    head: u32,
    root: vec3,
    dir: vec3,
    bend: vec3,
    long: f32,
    wide: f32,
    flat: vec3,
) {
    tinted_lock(mut m, head, root, dir, bend, long, wide, flat, HAIR, toon::HAIR)
}

/// A lock of `colour` and `kind` (a headband's tail is one).
fn tinted_lock(
    m: mut Mesh,
    head: u32,
    root: vec3,
    dir: vec3,
    bend: vec3,
    long: f32,
    wide: f32,
    flat: vec3,
    colour: vec3,
    kind: u32,
) {
    var path = [vec3(0.0); 8]
    for i in 0..8 {
        let s = f32(i) / 7.0
        path[i] = root + dir * long * s + bend * s * s
    }
    blade(mut m, head, path, wide, flat, colour, kind)
}

/// A blade along `path`, `wide` at its root and flattened across `flat`, tapering to a point: a
/// flattened diamond in section.
fn blade(m: mut Mesh, head: u32, path: [vec3; 8], wide: f32, flat: vec3, colour: vec3, kind: u32) {
    let up = normalize(flat)
    var rings: Vec<u32> = Vec::new()
    for i in 0..8 {
        let s = f32(i) / 7.0
        let ahead = normalize(if i == 7 { path[7] - path[6] } else { path[i + 1] - path[i] })
        let side = normalize(cross(ahead, up))
        let face = normalize(cross(side, ahead))
        let w = wide * pow(1.0 - s * 0.97, 0.75)
        let corners = [side * w, face * w * 0.42, -side * w, -face * w * 0.42]
        let normals = [side, face, -side, -face]
        for k in 0..4 {
            rings.push(
                m.vertex(path[i] + corners[k], normals[k], head, head, 255, HAIR, toon::HAIR, 0.8),
            )
        }
    }
    for i in 0..7 {
        for k in 0..4 {
            let j = (k + 1) % 4
            let a = rings[i * 4 + k]
            let b = rings[i * 4 + j]
            let c = rings[(i + 1) * 4 + j]
            let d = rings[(i + 1) * 4 + k]
            m.tri(a, b, c)
            m.tri(a, c, d)
        }
    }
}

/// The locks: the hair swept back off the brow by the sea wind and tied at the back of the head
/// in a short tail (bound by a cord, in the scarf's red); broad locks over the crown lie along the
/// skull toward the tie, and two loose ones fall either side of the brow, framing the face.
fn locks(m: mut Mesh, body: Humanoid, s: Skull, head: u32) {
    let back = vec3(0.0, 0.0, -1.0)
    let down = vec3(0.0, -1.0, 0.0)
    let r = s.radii.y
    let (tie, tie_n) = on_skull(body, s, head, normalize(vec3(0.0, 0.25, -1.0)))
    // Over the crown: each from near the hairline back to the tie, lying along the skull.
    let lanes = [-0.62, -0.38, -0.13, 0.12, 0.36, 0.6]
    for k in 0..6 {
        let x = lanes[k]
        let (p, nrm) = on_skull(body, s, head, normalize(vec3(x * 0.8, 0.7, 0.55)))
        // Round the skull from its root to the tie, lifted off it a little, most mid-way.
        var path = [vec3(0.0); 8]
        let from = p - s.centre
        let to = tie + tie_n * 0.015 - s.centre
        for i in 0..8 {
            let t = f32(i) / 7.0
            let d = normalize(mix(from, to, vec3(t)))
            let reach = mix(length(from), length(to), t) + 0.012 + 0.016 * sin(t * 3.14159)
            path[i] = s.centre + d * reach
        }
        blade(mut m, head, path, r * 0.4, nrm, HAIR, toon::HAIR)
    }
    // Spikes over the crown and the back, wind-blown back and up, uneven.
    for row in 0..3 {
        let count = 6 + row * 2
        for k in 0..count {
            let a = (f32(k) + 0.5 * f32(row % 2)) / f32(count) - 0.5
            let yaw = a * 3.4
            let pitch = 1.1 - f32(row) * 0.42
            let d = normalize(
                vec3(sin(yaw) * cos(pitch), sin(pitch), -cos(yaw) * cos(pitch) + 0.45),
            )
            let (p, nrm) = on_skull(body, s, head, d)
            let jitter = noise(vec2(f32(k) * 3.7, f32(row) * 5.1)) - 0.5
            let out = normalize(
                nrm * 0.7 + back * 0.55 + vec3(sin(yaw) * 0.2, 0.3 - f32(row) * 0.2, 0.0),
            )
            let long = r * (0.55 + 0.22 * f32(row) + 0.35 * jitter)
            lock(
                mut m,
                head,
                p + nrm * 0.004,
                out,
                down * long * 0.25 + back * long * 0.2,
                long,
                r * 0.36,
                nrm,
            )
        }
    }
    // Over the brow, a few kicked up and aside, clear of the eyes.
    let brow = [-0.6, -0.25, 0.1, 0.45]
    for k in 0..4 {
        let x = brow[k]
        let (p, nrm) = on_skull(body, s, head, normalize(vec3(x * 0.7, 0.62, 0.62)))
        let out = normalize(nrm * 0.6 + vec3(x * 0.8 + 0.15, 0.55, 0.35))
        let long = r * (0.5 + 0.2 * abs(x))
        lock(mut m, head, p + nrm * 0.004, out, back * long * 0.35, long, r * 0.32, nrm)
    }
    // The tail: from the tie, out and down, in two locks, a little apart, and a cord round it.
    for k in 0..2 {
        let sx = if k == 0 { 0.25 } else { -0.2 }
        let dir = normalize(back * 0.8 + down * 0.45 + vec3(sx * 0.3, 0.0, 0.0))
        lock(
            mut m,
            head,
            tie + tie_n * 0.012,
            dir,
            down * r * 0.9 + vec3(sx * 0.08, 0.0, 0.0),
            r * (1.7 - 0.25 * f32(k)),
            r * 0.36,
            vec3(sx, 0.2, 1.0),
        )
    }
    headband(mut m, body, s, head)
    cord(mut m, head, tie + tie_n * 0.03, normalize(back * 0.8 + down * 0.45), r * 0.2)
    // Loose either side of the brow.
    for side in 0..2 {
        let sx = if side == 0 { 1.0 } else { -1.0 }
        let (p, nrm) = on_skull(body, s, head, normalize(vec3(sx * 0.68, 0.45, 0.55)))
        let out = normalize(vec3(sx * 0.35, -0.75, 0.3) + nrm * 0.25)
        let long = r * 0.85
        lock(
            mut m,
            head,
            p - nrm * 0.004,
            out,
            down * long * 0.35 + nrm * 0.012,
            long,
            r * 0.28,
            nrm,
        )
    }
}

/// The cord round the tail: a short fat ring of the scarf's red about `axis` at `at`.
fn cord(m: mut Mesh, head: u32, at: vec3, axis: vec3, radius: f32) {
    let a = normalize(cross(axis, vec3(1.0, 0.0, 0.0)))
    let b = cross(axis, a)
    let around = 12
    var ids: Vec<u32> = Vec::new()
    for i in 0..around {
        let t = f32(i) / f32(around) * 6.2831853
        let d = a * cos(t) + b * sin(t)
        for j in 0..2 {
            let p = at + d * radius + axis * (f32(j) - 0.5) * radius * 0.9
            ids.push(m.vertex(p, d, head, head, 255, SCARF, toon::CLOTH, 0.7))
        }
    }
    for i in 0..around {
        let i2 = (i + 1) % around
        m.tri(ids[i * 2], ids[i2 * 2 + 1], ids[i2 * 2])
        m.tri(ids[i * 2], ids[i * 2 + 1], ids[i2 * 2 + 1])
    }
}

/// The garments made as shells over the body: its own triangles in a region, lifted off it.
pub const COAT: u32 = 0
pub const TROUSERS: u32 = 1

/// How far inside garment `g`'s region a point at rest is (m; it's covered where it's above 0).
/// The coat: the trunk from the waist to a high collar, open down the front in a V that widens
/// toward the hem, and wide short sleeves to just past the elbow. The trousers: the legs from the
/// waist to the shins, where the wraps gather them.
fn inside(g: u32, p: vec3) -> f32 {
    let ax = abs(p.x)
    if g == COAT {
        if ax > 0.24 && p.y > 1.2 {
            return 0.5 - ax
        }
        let open = if p.z > 0.0 { ax - (0.045 + 0.16 * saturate((1.5 - p.y) / 0.55)) } else { 1.0 }
        let collar = 1.63 - p.y - 0.06 * saturate(p.z * 12.0)
        return min(min(p.y - 0.94, collar), open)
    }
    if ax > 0.24 && p.y > 1.2 {
        return -1.0
    }
    min(p.y - 0.31, 1.0 - p.y)
}

/// How far garment `g` stands off the body at a point at rest (m): the coat a little, its collar
/// and its sleeves more, the sleeves flaring wide toward their ends; the trousers wide through
/// the thigh and the knee, gathered at the waist and into the wraps.
fn lift(g: u32, p: vec3) -> f32 {
    let ax = abs(p.x)
    if g == COAT {
        if ax > 0.24 && p.y > 1.2 {
            return 0.02 + 0.075 * smoothstep(0.3, 0.5, ax)
        }
        return 0.018 + 0.012 * smoothstep(1.5, 1.6, p.y)
    }
    0.012 + 0.024 * smoothstep(0.97, 0.72, p.y) * smoothstep(0.31, 0.52, p.y)
}

/// Garment `g`: each of the body's skin triangles in its region (clipped along its edge), lifted
/// off the body along its normals, on the body's own bones and weights, so it moves as the body
/// does.
fn shell(m: mut Mesh, body: Humanoid, g: u32) {
    let colour = if g == COAT { COAT_BLUE } else { SAND }
    let kind = if g == COAT { toon::PATTERN } else { toon::CLOTH }
    let n = body.indices.len() / 3
    for t in 0..n {
        let vs = [
            body.verts[body.indices[t * 3]],
            body.verts[body.indices[t * 3 + 1]],
            body.verts[body.indices[t * 3 + 2]],
        ]
        if toon::toon_of(vs[0].toon).kind != toon::SKIN {
            continue
        }
        var fs = [0.0; 3]
        var any = false
        for k in 0..3 {
            fs[k] = inside(g, vs[k].pos)
            any = any || fs[k] > 0.0
        }
        if !any {
            continue
        }
        var ids: Vec<u32> = Vec::new()
        for k in 0..3 {
            let j = (k + 1) % 3
            if fs[k] > 0.0 {
                ids.push(lifted(mut m, vs[k], vs[k].pos, vs[k].normal, g, colour, kind))
            }
            if (fs[k] > 0.0) != (fs[j] > 0.0) {
                let w = fs[k] / (fs[k] - fs[j])
                let at = mix(vs[k].pos, vs[j].pos, vec3(w))
                let nrm = normalize(mix(vs[k].normal, vs[j].normal, vec3(w)))
                // On the bones of whichever corner is inside.
                let on = if fs[k] > 0.0 { vs[k] } else { vs[j] }
                ids.push(lifted(mut m, on, at, nrm, g, colour, kind))
            }
        }
        for k in 1..ids.len() - 1 {
            m.tri(ids[0], ids[k], ids[k + 1])
        }
    }
}

/// A shell's vertex: at `at` lifted along `nrm`, on `on`'s bones and weights.
fn lifted(
    m: mut Mesh,
    on: BodyVertex,
    at: vec3,
    nrm: vec3,
    g: u32,
    colour: vec3,
    kind: u32,
) -> u32 {
    m.verts.push(
        BodyVertex {
            pos: at + nrm * lift(g, at),
            bones: on.bones,
            normal: nrm,
            weights: on.weights,
            colour: srgb8(colour),
            part: on.part,
            toon: toon::toon_word(occlusion: 0.0, width: 1.0, kind: kind),
            outline: 0,
        },
    )
    m.verts.len() - 1
}

/// The body's farthest reach from its middle line at height `y`, toward angle `a` round it (0
/// ahead, + toward its left), within 15° of it.
fn reach_at(body: Humanoid, y: f32, a: f32) -> f32 {
    var r = 0.08
    for v in body.verts {
        if abs(v.pos.y - y) < 0.025 && abs(v.pos.x) < 0.24 {
            let b = atan2(v.pos.x, v.pos.z)
            var d = abs(b - a)
            if d > 3.14159 {
                d = 6.2831853 - d
            }
            if d < 0.26 {
                r = max(r, length(vec2(v.pos.x, v.pos.z)))
            }
        }
    }
    r
}

/// The coat's tails: a skirt from its hem at the waist to above the knee, open in front, flaring
/// as it falls; outside in the coat's cloth, its lining dark. On the hips, its front panels
/// sharing a little with the thigh on their side, so they swing with the legs.
fn tails(m: mut Mesh, body: Humanoid, hips: u32) {
    let left = body.rig.find("leftUpperLeg")
    let right = body.rig.find("rightUpperLeg")
    let around = 26
    let down = 10
    let top = 0.98
    let hem = 0.56
    let gap = 0.42
    var reach: Vec<f32> = Vec::new()
    for i in 0..around + 1 {
        let a = gap + (6.2831853 - 2.0 * gap) * f32(i) / f32(around)
        reach.push(reach_at(body, top, a) + 0.03)
    }
    for layer in 0..2 {
        let outside = layer == 0
        var ids: Vec<u32> = Vec::new()
        for j in 0..down + 1 {
            let v = f32(j) / f32(down)
            for i in 0..around + 1 {
                let a = gap + (6.2831853 - 2.0 * gap) * f32(i) / f32(around)
                let dir = vec3(sin(a), 0.0, cos(a))
                let r = reach[i] + 0.10 * v * v + 0.015 * v * sin(a * 7.0)
                let p = vec3(0.0, mix(top, hem, v), 0.0) + dir * (r + (if outside { 0.003 } else {
                    0.0
                }))
                let nrm = normalize(dir * (if outside { 1.0 } else { -1.0 }) + vec3(0.0, 0.15, 0.0))
                let side = if sin(a) > 0.0 { left } else { right }
                let front = saturate(cos(a) + 0.2)
                let share = u32(255.0 * (1.0 - 0.45 * v * front) + 0.5)
                let colour = if outside { COAT_BLUE } else { LINING }
                let kind = if outside { toon::PATTERN } else { toon::CLOTH }
                ids.push(m.vertex(p, nrm, hips, side, share, colour, kind, 0.9))
            }
        }
        let w = around + 1
        for j in 0..down {
            for i in 0..around {
                let a = ids[j * w + i]
                let b = ids[j * w + i + 1]
                let c = ids[(j + 1) * w + i + 1]
                let d = ids[(j + 1) * w + i]
                if outside {
                    m.tri(a, c, b)
                    m.tri(a, d, c)
                } else {
                    m.tri(a, b, c)
                    m.tri(a, c, d)
                }
            }
        }
    }
}

/// A string of beads round the neck, lying on the chest in the coat's opening, a carved stone
/// at its lowest.
fn beads(m: mut Mesh, body: Humanoid, upper: u32) {
    let count = 22
    for k in 0..count {
        let a = (f32(k) / f32(count) - 0.5) * 4.6
        let front = cos(a)
        let r = 0.075 + 0.03 * front
        let y = 1.50 - 0.13 * saturate(front) * saturate(front)
        let base = vec3(sin(a) * r, y, 0.0)
        let z = reach_at(body, y, a) * cos(a) + 0.012
        let at = vec3(base.x, y, z)
        let big = k == count / 2
        let size = if big { 0.018 } else { 0.008 }
        let colour = if big { STONE } else if k % 2 == 0 { BONE } else { WOOD }
        bead(mut m, upper, at, size, colour)
    }
}

/// A bead: an octahedron, `size` from its middle to each point.
fn bead(m: mut Mesh, bone: u32, at: vec3, size: f32, colour: vec3) {
    let dirs = [
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0),
        vec3(-1.0, 0.0, 0.0),
        vec3(0.0, -1.0, 0.0),
        vec3(0.0, 0.0, -1.0),
    ]
    var ids: Vec<u32> = Vec::new()
    for d in dirs {
        ids.push(m.vertex(at + d * size, d, bone, bone, 255, colour, toon::CLOTH, 0.5))
    }
    let faces = [
        (0, 1, 2),
        (1, 3, 2),
        (3, 4, 2),
        (4, 0, 2),
        (1, 0, 5),
        (3, 1, 5),
        (4, 3, 5),
        (0, 4, 5),
    ]
    for (a, b, c) in faces {
        m.tri(ids[a], ids[b], ids[c])
    }
}

/// A headband (a sailor's hachimaki) in the sash's red, tied round the head along the hairline,
/// its knot at the back and two tails thrown off it.
fn headband(m: mut Mesh, body: Humanoid, s: Skull, head: u32) {
    let around = 40
    var ids: Vec<u32> = Vec::new()
    for i in 0..around {
        let a = f32(i) / f32(around) * 6.2831853
        let front = cos(a) * 0.5 + 0.5
        let d = normalize(vec3(sin(a), mix(0.05, 0.42, front), cos(a)))
        let (p, nrm) = on_skull(body, s, head, d)
        let out = normalize(vec3(sin(a), 0.0, cos(a)) * 0.8 + nrm * 0.2)
        for j in 0..2 {
            let up = (f32(j) - 0.5) * 0.034
            ids.push(
                m.vertex(
                    p + out * 0.016 + vec3(0.0, up, 0.0),
                    out,
                    head,
                    head,
                    255,
                    SCARF,
                    toon::CLOTH,
                    0.8,
                ),
            )
        }
    }
    for i in 0..around {
        let i2 = (i + 1) % around
        m.tri(ids[i * 2], ids[i2 * 2], ids[i2 * 2 + 1])
        m.tri(ids[i * 2], ids[i2 * 2 + 1], ids[i * 2 + 1])
    }
    let (knot, kn) = on_skull(body, s, head, normalize(vec3(0.15, 0.05, -1.0)))
    let r = s.radii.y
    for k in 0..2 {
        let sx = if k == 0 { 0.5 } else { 0.1 }
        let dir = normalize(vec3(sx, -0.55, -0.8))
        tinted_lock(
            mut m,
            head,
            knot + kn * 0.02,
            dir,
            vec3(0.0, -r * 0.4, 0.0),
            r * (1.5 - 0.3 * f32(k)),
            r * 0.2,
            vec3(1.0, 0.0, 0.0),
            SCARF,
            toon::CLOTH,
        )
    }
}
