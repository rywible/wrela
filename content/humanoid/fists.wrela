// The body's fists, hand-posed (`engine::keys`): each punch an animator's keys, timed for weight
// and read, not a take's frames retimed. The first: a cross thrown from where the body stands.
//
// A cross from an orthodox stance (left foot and fist ahead): the body sinks and coils back onto
// its rear foot (the tell), holds that a beat (the eye reads it), then snaps through in five
// frames, the rear heel pivoting up and the hips and trunk turning the fist out to full reach,
// the lead fist pulled back to the chin; it drives a little past its contact (the impact), holds
// there, then pulls the fist home faster than it threw it and settles back into its guard.

use std::collections::Vec
use engine::humanoid
use engine::humanoid::Clip
use engine::keys
use std::io::print
use engine::keys::{Key, SETTLE, SMOOTH, SNAP}
use engine::playback
use engine::playback::{ACTIVE, CANCEL, Gaits, Mark, Move, RECOVER, WINDUP}
use body::{GAITS, HERO}
use engine::anime::{Look, PLAIN, STRIKE}

/// The guard: an orthodox stance, up on the balls of both feet, the lead foot ahead and turned a
/// little in, the rear foot back and turned out; the hips sunk and turned to the right (the lead
/// shoulder ahead), the trunk leaning in; the lead fist out at eye height, the rear at the chin,
/// both elbows in and down.
pub fn guard() -> Key {
    Key {
        at: 0.0,
        hips: vec3(-0.01, -0.06, 0.0),
        hips_turn: vec3(0.0, -25.0, 0.0),
        trunk: vec3(6.0, -5.0, 0.0),
        look: vec3(0.0, 1.5, 3.0),
        fists: [vec3(0.10, 1.40, 0.30), vec3(-0.11, 1.40, 0.12)],
        elbows: [vec3(0.5, -1.0, -0.2), vec3(-0.5, -1.0, -0.2)],
        rolls: [0.0, 0.0],
        feet: [vec4(0.10, 0.22, -15.0, 12.0), vec4(-0.17, -0.20, -40.0, 18.0)],
    }
}

/// The cross's keys (s from its start).
pub fn cross_keys() -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    var k = guard()
    out.push(k)
    // The load: sunk and coiled onto the rear foot, the rear fist drawn back a hand's width,
    // the rear heel down to drive off.
    k.at = 0.16
    k.ease = SMOOTH
    k.hips = vec3(-0.04, -0.10, -0.04)
    k.hips_turn = vec3(0.0, -40.0, 0.0)
    k.trunk = vec3(10.0, -16.0, 0.0)
    k.look = vec3(0.0, 1.42, 3.0)
    k.fists = [vec3(0.12, 1.40, 0.36), vec3(-0.16, 1.36, 0.03)]
    k.elbows = [vec3(0.5, -1.0, -0.2), vec3(-0.6, -1.0, -0.4)]
    k.feet[1] = vec4(-0.17, -0.20, -40.0, 0.0)
    out.push(k)
    // The beat: held, settling a hair further in.
    k.at = 0.28
    k.ease = SETTLE
    k.hips = vec3(-0.045, -0.105, -0.045)
    k.hips_turn = vec3(0.0, -42.0, 0.0)
    k.trunk = vec3(11.0, -17.0, 0.0)
    out.push(k)
    // Contact: snapped through in five frames, the hips and trunk turned square and past, the
    // rear heel up and pivoted, the fist at full reach at chin height on the centre line, its
    // shoulder up over the chin; the lead fist pulled back to guard the face.
    k.at = 0.36
    k.ease = SNAP
    k.hips = vec3(0.0, -0.08, 0.06)
    k.hips_turn = vec3(0.0, 18.0, 0.0)
    k.trunk = vec3(12.0, 26.0, 0.0)
    k.collars = [vec3(0.0), vec3(0.0, 10.0, -8.0)]
    k.fists = [vec3(0.07, 1.43, 0.18), vec3(-0.02, 1.46, 0.74)]
    k.elbows = [vec3(0.6, -1.0, 0.0), vec3(-0.3, -1.0, 0.0)]
    k.feet[1] = vec4(-0.17, -0.20, -5.0, 32.0)
    out.push(k)
    // The impact: driven on past contact, the weight over the lead foot.
    k.at = 0.39
    k.ease = SETTLE
    k.hips = vec3(0.005, -0.085, 0.08)
    k.hips_turn = vec3(0.0, 22.0, 0.0)
    k.trunk = vec3(15.0, 30.0, 0.0)
    out.push(k)
    // The hold on the hit: barely drifting.
    k.at = 0.46
    k.ease = SETTLE
    k.hips = vec3(0.0, -0.083, 0.075)
    k.hips_turn = vec3(0.0, 20.0, 0.0)
    k.trunk = vec3(14.0, 28.0, 0.0)
    out.push(k)
    // The pull home: faster than it went, the fist most of the way back, the hips turning back.
    k.at = 0.56
    k.ease = SETTLE
    k.hips = vec3(-0.01, -0.07, 0.02)
    k.hips_turn = vec3(0.0, -10.0, 0.0)
    k.trunk = vec3(7.0, 5.0, 0.0)
    k.collars = [vec3(0.0), vec3(0.0, 3.0, -2.0)]
    k.fists = [vec3(0.09, 1.41, 0.26), vec3(-0.07, 1.41, 0.20)]
    k.elbows = [vec3(0.5, -1.0, -0.2), vec3(-0.5, -1.0, -0.2)]
    k.feet[1] = vec4(-0.17, -0.20, -30.0, 14.0)
    out.push(k)
    // Back in the guard.
    var g = guard()
    g.at = 0.85
    g.ease = SMOOTH
    out.push(g)
    out
}

/// A keyed clip as a move that stays where it stands: no root path to carry, no heading to
/// turn (its hips' turns are the pose's, not the body's).
fn in_place(c: Clip) -> Move {
    let n = c.frames
    Move {
        clip: c.clone(),
        root: Vec::filled(n, vec3(0.0)),
        heading: Vec::filled(n, 0.0),
        marks: Vec::new(),
        speed: 0.0,
        stride: 0.0,
    }
}

/// The cross's frames in the fight, at 60 a second: its tell (the load and the beat, to the
/// snap's start), when it hits (from contact through the drive past it), and its recovery.
pub const CROSS_HIT: f32 = 0.36
pub const CROSS_HIT_TILL: f32 = 0.42

/// The cross as a game plays it: its keys at 60 a second, fists clenched, in place, its windows
/// marked.
@fuel(2 ** 40)
pub const CROSS: Move = cross_move()

fn cross_move() -> Move {
    let keys = cross_keys()
    var m = in_place(keys::keyed(HERO.rig, keys, fps: 60.0, fist: 2.0))
    let end = m.clip.length()
    m.marks = Vec::new()
    m.marks.push(Mark { kind: WINDUP, from: 0.0, till: CROSS_HIT })
    m.marks.push(Mark { kind: ACTIVE, from: CROSS_HIT, till: CROSS_HIT_TILL })
    m.marks.push(Mark { kind: RECOVER, from: CROSS_HIT_TILL, till: end })
    m.marks.push(Mark { kind: CANCEL, from: end - 0.15, till: end })
    m
}

// ---- footwork ---------------------------------------------------------------------------

/// A step of a fighter's footwork, `by` along the floor (m, in the body's space: +z toward the
/// foe, +x its left), in the guard and facing the foe all the while: the foot nearest the way it
/// goes steps first (pushed off the other, which drives), lands, and the other follows it, so
/// the stance never narrows or crosses; the body sinks as it lands and is back up bouncing.
pub fn step_keys(by: vec3) -> Vec<Key> {
    // Which foot leads: ahead or to the left, the lead (left) foot; back or to the right, the
    // rear (right).
    let first = if by.z > 0.05 || (abs(by.z) <= 0.05 && by.x > 0.0) { 0 } else { 1 }
    let second = 1 - first
    var out: Vec<Key> = Vec::new()
    var k = guard()
    k.hips = vec3(-0.01, -0.095, 0.0)
    out.push(k)
    // The push: off the second foot, its heel up, the body's weight going.
    k = keys::shifted(guard(), by * 0.12)
    k.at = 0.07
    k.ease = SETTLE
    k.hips.y = -0.085
    k.feet[second] = guard().feet[second]
    k.feet[second].w = 30.0
    k.feet[first] = guard().feet[first] + vec4(by.x * 0.3, by.z * 0.3, 0.0, 0.0)
    k.lifts[first] = 0.05
    out.push(k)
    // The first foot down where it's going; the second leaves the floor.
    k = keys::shifted(guard(), by * 0.65)
    k.at = 0.17
    k.ease = SMOOTH
    k.hips.y = -0.08
    k.feet[first] = guard().feet[first] + vec4(by.x, by.z, 0.0, 0.0)
    k.feet[first].w = 10.0
    k.feet[second] = guard().feet[second] + vec4(by.x * 0.35, by.z * 0.35, 0.0, 0.0)
    k.lifts = [0.0, 0.0]
    k.lifts[second] = 0.045
    out.push(k)
    // The second foot down after it: the stance whole again, sunk to take the weight.
    k = keys::shifted(guard(), by)
    k.at = 0.27
    k.ease = SETTLE
    k.hips.y = -0.11
    k.feet[0].w = 8.0
    k.feet[1].w = 12.0
    out.push(k)
    // Back up, bouncing.
    k = keys::shifted(guard(), by)
    k.at = 0.38
    k.ease = SMOOTH
    k.hips.y = -0.08
    out.push(k)
    out
}

/// A step `by` as a move: its keys at 60 a second about its root, which carries the body.
fn step_move(by: vec3) -> Move {
    let keys = step_keys(by)
    let c = keys::keyed(HERO.rig, keys, fps: 60.0, fist: 2.0)
    let n = c.frames
    var m = in_place(c)
    m.root = keys::travels(keys, fps: 60.0, frames: n)
    m
}

/// The footwork: a step in toward the foe, a step back out, and a step to either side.
pub const STEP: f32 = 0.32
@fuel(2 ** 40)
pub const STEP_IN: Move = step_move(vec3(0.0, 0.0, STEP))
@fuel(2 ** 40)
pub const STEP_OUT: Move = step_move(vec3(0.0, 0.0, -STEP))
@fuel(2 ** 40)
pub const STEP_LEFT: Move = step_move(vec3(STEP * 0.85, 0.0, 0.0))
@fuel(2 ** 40)
pub const STEP_RIGHT: Move = step_move(vec3(-STEP * 0.85, 0.0, 0.0))

/// The one-offs a body acts, by index: the running punch (`body::ACT_PUNCH`), the roll
/// (`body::ACT_ROLL`) and the standing cross (`ACT_CROSS`); and how each is drawn (`LOOKS`): the
/// strikes as strikes, the roll as it plays.
pub const ACT_CROSS: u32 = 2
pub const ACT_STEP_IN: u32 = 3
pub const ACT_STEP_OUT: u32 = 4
pub const ACT_STEP_LEFT: u32 = 5
pub const ACT_STEP_RIGHT: u32 = 6
@fuel(2 ** 40)
pub const ACTS: [Move; 7] = [
    body::PUNCH.clone(),
    body::ROLL.clone(),
    CROSS.clone(),
    STEP_IN.clone(),
    STEP_OUT.clone(),
    STEP_LEFT.clone(),
    STEP_RIGHT.clone(),
]
pub const LOOKS: [Look; 7] = [STRIKE, PLAIN, STRIKE, PLAIN, PLAIN, PLAIN, PLAIN]

/// The guard as a body stands ready to fight: bouncing on the balls of its feet, twice a
/// second, light, ready to go any way. It drops onto its feet fast (the floor takes it) and
/// floats off them, just off the floor at the top; its fists ride the bounce a beat behind the
/// body, its head steady.
pub const BOUNCE: f32 = 0.5

pub fn guard_keys() -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    var low = guard()
    low.hips = vec3(-0.01, -0.095, 0.0)
    low.feet[0].w = 8.0
    low.feet[1].w = 12.0
    low.fists = [vec3(0.10, 1.395, 0.30), vec3(-0.11, 1.395, 0.12)]
    var high = guard()
    high.hips = vec3(-0.01, -0.045, 0.0)
    high.feet[0].w = 24.0
    high.feet[1].w = 28.0
    high.lifts = [0.012, 0.012]
    high.fists = [vec3(0.10, 1.40, 0.30), vec3(-0.11, 1.40, 0.12)]
    high.trunk = vec3(5.0, -5.0, 0.0)
    // Off the floor and up, slowing; then dropped onto the feet, gathering speed.
    var k = low
    k.at = 0.0
    out.push(k)
    k = high
    k.at = BOUNCE * 0.55
    k.ease = SETTLE
    out.push(k)
    k = low
    k.at = BOUNCE
    k.ease = SNAP
    out.push(k)
    out
}

@fuel(2 ** 40)
pub const GUARD: Move = guard_move()

fn guard_move() -> Move {
    var c = keys::keyed(HERO.rig, guard_keys(), fps: 60.0, fist: 2.0)
    c.looped = true
    in_place(c)
}

/// The gaits of a body ready to fight: standing in its guard, walking and running as ever.
@fuel(2 ** 40)
pub const FIGHT_GAITS: Gaits = Gaits {
    idle: GUARD.clone(),
    walk: GAITS.walk.clone(),
    run: GAITS.run.clone(),
    start: GAITS.start.clone(),
    stop: GAITS.stop.clone(),
    start_exit: GAITS.start_exit,
    stop_entry: GAITS.stop_entry,
}

/// The cross reaches: its fist out to near full stretch on contact, there fastest just before
/// and all but stopped just after (snapped into, then driven on a little), and its lead foot
/// staying put through it.
@test
fn the_cross_snaps_out_to_its_contact_on_planted_feet() {
    borrow rig = HERO.rig
    let rw = rig.rest_world()
    let (u, h) = (rig.find("rightUpperArm"), rig.find("rightHand"))
    let reach = length(rw[h].t - rw[u].t)
    let at = |t: f32| -> (vec3, vec3, vec3) {
        let w = engine::stride::worlds(rig, CROSS.clip, u32(t * 60.0 + 0.5))
        let (root, _) = CROSS.root_at(t)
        (w[u].t, w[h].t, w[rig.find("leftToes")].t + root)
    }
    let (s, f, _) = at(CROSS_HIT)
    let out = length(f - s) / reach
    let (_, before, _) = at(CROSS_HIT - 1.0 / 60.0)
    let (_, after, _) = at(CROSS_HIT + 2.0 / 60.0)
    let (_, f0, _) = at(CROSS_HIT - 2.0 / 60.0)
    let into = length(f - before) * 60.0
    let on = length(after - f) * 30.0
    let early = length(before - f0) * 60.0
    print(
        f"the cross: on contact the fist's {out * 100.0:.0}% out, {into:.1} m/s into it, {on:.2} m/s after (and {early:.1} a frame before)",
    )
    assert(out > 0.93, f"the fist's only {out} of its reach out on contact")
    assert(into > 3.0 * on, "the fist doesn't stop on its contact")
    var most = 0.0
    let (_, _, toe0) = at(0.0)
    for k in 0..u32(CROSS.clip.length() * 60.0) {
        let (_, _, toe) = at(f32(k) / 60.0)
        most = max(most, length(toe - toe0))
    }
    print(f"the lead foot's ball moves {most * 100.0:.1} cm at most")
    assert(most < 0.01, f"the lead foot slides {most} m")
}
