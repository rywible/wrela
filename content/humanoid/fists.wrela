// The fighter's footwork and guard, hand-posed (`engine::keys`): the guard he stands in and
// bounces in, and his steps. A body struck isn't keyed: a blow is laid into its inertia
// (`engine::contact`). His strikes are written moves, each
// part of the body on its own clock and their numbers solved (solved.wrela, hook.wrela,
// `engine::written`); a strike keyed alone, every part on one curve, is gone.

use std::collections::Vec
use engine::humanoid
use engine::humanoid::Clip
use engine::keys
use std::io::print
use engine::keys::{Key, SETTLE, SMOOTH, SNAP}
use engine::playback
use engine::playback::{ACTIVE, CANCEL, Gaits, Mark, Move, RECOVER, WINDUP}
use body::{GAITS, HERO}
use engine::anime::{LIGHT, Look, PLAIN, STRIKE}

/// The guard: an orthodox stance, up on the balls of both feet, the lead foot ahead and turned a
/// little in, the rear foot back and turned out; the hips sunk and turned to the right (the lead
/// shoulder ahead), the trunk leaning in; the lead fist out at eye height, the rear at the chin,
/// both elbows in and down.
pub fn guard() -> Key {
    Key {
        at: 0.0,
        hips: vec3(-0.01, -0.06, 0.0),
        hips_turn: vec3(0.0, -25.0, 0.0),
        trunk: vec3(6.0, -5.0, 0.0),
        look: vec3(0.0, 1.5, 3.0),
        fists: [vec3(0.10, 1.40, 0.30), vec3(-0.11, 1.40, 0.12)],
        elbows: [vec3(0.5, -1.0, -0.2), vec3(-0.5, -1.0, -0.2)],
        rolls: [0.0, 0.0],
        feet: [vec4(0.10, 0.22, -15.0, 12.0), vec4(-0.17, -0.20, -40.0, 18.0)],
    }
}

/// A keyed clip as a move that stays where it stands: no root path to carry, no heading to
/// turn (its hips' turns are the pose's, not the body's).
fn in_place(c: Clip) -> Move {
    let n = c.frames
    Move {
        clip: c.clone(),
        root: Vec::filled(n, vec3(0.0)),
        heading: Vec::filled(n, 0.0),
        marks: Vec::new(),
        speed: 0.0,
        stride: 0.0,
    }
}

/// A step of a fighter's footwork, `by` along the floor (m, in the body's space: +z toward the
/// foe, +x its left), in the guard and facing the foe all the while: the foot nearest the way it
/// goes steps first (pushed off the other, which drives), lands, and the other follows it, so
/// the stance never narrows or crosses; the body sinks as it lands and is back up bouncing.
pub fn step_keys(by: vec3) -> Vec<Key> {
    // Which foot leads: ahead or to the left, the lead (left) foot; back or to the right, the
    // rear (right).
    let first = if by.z > 0.05 || (abs(by.z) <= 0.05 && by.x > 0.0) { 0 } else { 1 }
    let second = 1 - first
    var out: Vec<Key> = Vec::new()
    var k = guard()
    k.hips = vec3(-0.01, -0.095, 0.0)
    out.push(k)
    // The push: off the second foot, its heel up, the body's weight going.
    k = keys::shifted(guard(), by * 0.12)
    k.at = 0.07
    k.ease = SETTLE
    k.hips.y = -0.085
    k.feet[second] = guard().feet[second]
    k.feet[second].w = 30.0
    k.feet[first] = guard().feet[first] + vec4(by.x * 0.3, by.z * 0.3, 0.0, 0.0)
    k.lifts[first] = 0.05
    out.push(k)
    // The first foot down where it's going; the second leaves the floor.
    k = keys::shifted(guard(), by * 0.65)
    k.at = 0.17
    k.ease = SMOOTH
    k.hips.y = -0.08
    k.feet[first] = guard().feet[first] + vec4(by.x, by.z, 0.0, 0.0)
    k.feet[first].w = 10.0
    k.feet[second] = guard().feet[second] + vec4(by.x * 0.35, by.z * 0.35, 0.0, 0.0)
    k.lifts = [0.0, 0.0]
    k.lifts[second] = 0.045
    out.push(k)
    // The second foot down after it: the stance whole again, sunk to take the weight.
    k = keys::shifted(guard(), by)
    k.at = 0.27
    k.ease = SETTLE
    k.hips.y = -0.11
    k.feet[0].w = 8.0
    k.feet[1].w = 12.0
    out.push(k)
    // Back up, bouncing.
    k = keys::shifted(guard(), by)
    k.at = 0.38
    k.ease = SMOOTH
    k.hips.y = -0.08
    out.push(k)
    out
}

/// A step `by` as a move: its keys at 60 a second about its root, which carries the body.
fn step_move(by: vec3) -> Move {
    let keys = step_keys(by)
    let c = keys::keyed(HERO.rig, keys, fps: 60.0, fist: 2.0)
    let n = c.frames
    var m = in_place(c)
    m.root = keys::travels(keys, fps: 60.0, frames: n)
    m
}

/// The footwork: a step in toward the foe, a step back out, and a step to either side.
pub const STEP: f32 = 0.32
@fuel(2 ** 40)
pub const STEP_IN: Move = step_move(vec3(0.0, 0.0, STEP))
@fuel(2 ** 40)
pub const STEP_OUT: Move = step_move(vec3(0.0, 0.0, -STEP))
@fuel(2 ** 40)
pub const STEP_LEFT: Move = step_move(vec3(STEP * 0.85, 0.0, 0.0))
@fuel(2 ** 40)
pub const STEP_RIGHT: Move = step_move(vec3(-STEP * 0.85, 0.0, 0.0))

/// The one-offs the lab's fighter acts (main.wrela's `FIGHT_ACTS`), by index: the running
/// punch (`body::ACT_PUNCH`), the roll (`body::ACT_ROLL`), the standing cross (the solved one,
/// `ACT_CROSS`) and the steps; and how each is drawn (`LOOKS`): the strikes as strikes, the rest
/// as they play.
pub const ACT_CROSS: u32 = 2
pub const ACT_STEP_IN: u32 = 3
pub const ACT_STEP_OUT: u32 = 4
pub const ACT_STEP_LEFT: u32 = 5
pub const ACT_STEP_RIGHT: u32 = 6
pub const LOOKS: [Look; 7] = [STRIKE, PLAIN, LIGHT, PLAIN, PLAIN, PLAIN, PLAIN]

/// Each bounce: how long (s), how high (of the most), and where the weight is (1 on the lead
/// foot, -1 on the rear).
const BOUNCES: [vec3; 7] = [
    vec3(0.46, 1.0, 0.45),
    vec3(0.53, 0.65, -0.3),
    vec3(0.42, 0.9, 0.7),
    vec3(0.6, 0.5, -0.6),
    vec3(0.47, 0.85, 0.15),
    vec3(0.51, 0.7, -0.45),
    vec3(0.44, 0.95, 0.35),
]

/// A bounce's key, `up` of the way to its top, `height` its height, `weight` where the weight
/// is.
fn bounce_key(up: f32, height: f32, weight: f32) -> Key {
    var k = guard()
    let lift = up * height
    // The weight over a foot: the hips toward it and turned a hair with it.
    k.hips = vec3(-0.01 + 0.025 * weight, -0.098 + 0.05 * lift, 0.022 * weight)
    k.trunk = vec3(6.0 - 1.0 * lift, -5.0, -1.5 * weight)
    let (lead, rear) = (saturate(weight), saturate(-weight))
    // The loaded foot's heel sinks, the free one's rises; at the top it taps off the floor.
    k.feet[0].w = 6.0 + 14.0 * lift + 14.0 * rear
    k.feet[1].w = 10.0 + 14.0 * lift + 14.0 * lead
    k.lifts = [0.004 * lift + 0.018 * lift * rear, 0.004 * lift + 0.018 * lift * lead]
    // The fists ride behind: low at the top, up as it lands.
    let ride = 0.008 * (0.5 - up) * height
    k.fists = [vec3(0.10, 1.40 + ride, 0.30), vec3(-0.11, 1.40 + ride, 0.12)]
    k
}

/// The guard as a body stands ready to fight: light on the balls of its feet, never still and
/// never even. Each bounce its own length and height, its weight rolling onto one foot and off
/// the other: the loaded foot's heel sinks, the other's rises and taps off the floor at the top.
/// It drops onto its feet fast (the floor takes it) and floats off them; its fists ride a beat
/// behind, its head steady.
pub fn guard_keys() -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    var t = 0.0
    let n = BOUNCES.len()
    for i in 0..n {
        let b = BOUNCES[i]
        // Landed: weight already rolling to this bounce's foot.
        var k = bounce_key(0.0, b.y, b.z)
        k.at = t
        k.ease = SNAP
        out.push(k)
        // Its top: off the floor and slowing, the weight on its way to the next.
        let next = BOUNCES[(i + 1) % n]
        k = bounce_key(1.0, b.y, mix(b.z, next.z, 0.4))
        k.at = t + b.x * 0.55
        k.ease = SETTLE
        out.push(k)
        t += b.x
    }
    var k = bounce_key(0.0, BOUNCES[0].y, BOUNCES[0].z)
    k.at = t
    k.ease = SNAP
    out.push(k)
    out
}

@fuel(2 ** 40)
pub const GUARD: Move = guard_move()

fn guard_move() -> Move {
    var c = keys::keyed(HERO.rig, guard_keys(), fps: 60.0, fist: 2.0)
    c.looped = true
    in_place(c)
}

/// The gaits of a body ready to fight: standing in its guard, walking and running as ever.
@fuel(2 ** 40)
pub const FIGHT_GAITS: Gaits = Gaits {
    idle: GUARD.clone(),
    walk: GAITS.walk.clone(),
    run: GAITS.run.clone(),
    start: GAITS.start.clone(),
    stop: GAITS.stop.clone(),
    start_exit: GAITS.start_exit,
    stop_entry: GAITS.stop_entry,
}
