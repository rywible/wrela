// The fighter's footwork and guard, hand-posed (`engine::keys`): the guard he stands in and
// bounces in, and his steps. A body struck isn't keyed: a blow is laid into its inertia
// (`engine::contact`). His strikes are written moves, each
// part of the body on its own clock and their numbers solved (solved.wrela, hook.wrela,
// `engine::written`); a strike keyed alone, every part on one curve, is gone.

use std::collections::Vec
use engine::humanoid
use engine::humanoid::Clip
use engine::keys
use std::io::print
use engine::keys::{Key, SETTLE, SMOOTH, SNAP}
use engine::playback
use engine::stride
use engine::playback::{ACTIVE, CANCEL, Gaits, Mark, Move, RECOVER, WINDUP}
use body::{GAITS, HERO}
use engine::anime::{LIGHT, Look, PLAIN, STRIKE}

/// The guard: an orthodox stance, up on the balls of both feet, the lead foot ahead and turned a
/// little in, the rear foot back and turned out; the hips sunk and turned to the right (the lead
/// shoulder ahead); the lead fist out before the face, the rear at the chin, both elbows in and
/// down. Its shape is the captured boxer's (`accad_fists::GUARD`, ACCAD's Male 2), read off the
/// stance sheet (`engine::stance`) and solved for on this body (spec.wrela's `guard_spec`).
pub fn guard() -> Key {
    // ---- What the solve finds (spec.wrela): each number alone on its line. ----
    // How far the hips are sunk (m) and turned (degrees), and the trunk's lean and turn.
    let sink = -0.06
    let hips_yaw = -44.9
    let trunk_pitch = 1.0
    let trunk_yaw = -17.9
    // Where the feet stand (m along the floor: +x the left, +z ahead).
    let lead_x = 0.02
    let lead_z = 0.38
    let rear_x = -0.16
    let rear_z = -0.26
    // Where the fists are (m, the body's space), and how high the eyes look (m, 3 m ahead).
    let lead_fist_x = 0.074
    let lead_fist_y = 1.28
    let lead_fist_z = 0.48
    let rear_fist_x = -0.25
    let rear_fist_y = 1.42
    let rear_fist_z = 0.02
    let look_y = 1.7
    Key {
        at: 0.0,
        hips: vec3(-0.01, sink, 0.0),
        hips_turn: vec3(0.0, hips_yaw, 0.0),
        trunk: vec3(trunk_pitch, trunk_yaw, 0.0),
        look: vec3(0.0, look_y, 3.0),
        fists: [
            vec3(lead_fist_x, lead_fist_y, lead_fist_z),
            vec3(rear_fist_x, rear_fist_y, rear_fist_z),
        ],
        elbows: [vec3(0.5, -1.0, -0.2), vec3(-0.5, -1.0, -0.2)],
        rolls: [0.0, 0.0],
        feet: [vec4(lead_x, lead_z, -15.0, 12.0), vec4(rear_x, rear_z, -40.0, 18.0)],
    }
}

/// A keyed clip as a move that stays where it stands: no root path to carry, no heading to
/// turn (its hips' turns are the pose's, not the body's).
pub fn in_place(c: Clip) -> Move {
    let n = c.frames
    Move {
        clip: c.clone(),
        root: Vec::filled(n, vec3(0.0)),
        heading: Vec::filled(n, 0.0),
        marks: Vec::new(),
        speed: 0.0,
        stride: 0.0,
    }
}

/// A step of a fighter's footwork, `by` along the floor (m, in the body's space: +z toward the
/// foe, +x its left), in the guard and facing the foe all the while: the foot nearest the way it
/// goes steps first (pushed off the other, which drives), lands, and the other follows it, so
/// the stance never narrows or crosses; the body sinks as it lands and is back up bouncing.
pub fn step_keys(by: vec3) -> Vec<Key> {
    // Which foot leads: ahead or to the left, the lead (left) foot; back or to the right, the
    // rear (right).
    let first = if by.z > 0.05 || (abs(by.z) <= 0.05 && by.x > 0.0) { 0 } else { 1 }
    let second = 1 - first
    var out: Vec<Key> = Vec::new()
    var k = guard()
    k.hips = vec3(-0.01, -0.095, 0.0)
    out.push(k)
    // The push: off the second foot, its heel up, the body's weight going.
    k = keys::shifted(guard(), by * 0.12)
    k.at = 0.07
    k.ease = SETTLE
    k.hips.y = -0.085
    k.feet[second] = guard().feet[second]
    k.feet[second].w = 30.0
    k.feet[first] = guard().feet[first] + vec4(by.x * 0.3, by.z * 0.3, 0.0, 0.0)
    k.lifts[first] = 0.05
    out.push(k)
    // The first foot down where it's going; the second leaves the floor.
    k = keys::shifted(guard(), by * 0.65)
    k.at = 0.17
    k.ease = SMOOTH
    k.hips.y = -0.08
    k.feet[first] = guard().feet[first] + vec4(by.x, by.z, 0.0, 0.0)
    k.feet[first].w = 10.0
    k.feet[second] = guard().feet[second] + vec4(by.x * 0.35, by.z * 0.35, 0.0, 0.0)
    k.lifts = [0.0, 0.0]
    k.lifts[second] = 0.045
    out.push(k)
    // The second foot down after it: the stance whole again, sunk to take the weight.
    k = keys::shifted(guard(), by)
    k.at = 0.27
    k.ease = SETTLE
    k.hips.y = -0.11
    k.feet[0].w = 8.0
    k.feet[1].w = 12.0
    out.push(k)
    // Back up, bouncing.
    k = keys::shifted(guard(), by)
    k.at = 0.38
    k.ease = SMOOTH
    k.hips.y = -0.08
    out.push(k)
    out
}

/// A step `by` as a move: its keys at 60 a second about its root, which carries the body.
pub fn step_move(by: vec3) -> Move {
    let keys = step_keys(by)
    let c = keys::keyed(HERO.rig, keys, fps: 60.0, fist: 2.0)
    let n = c.frames
    var m = in_place(c)
    m.root = keys::travels(keys, fps: 60.0, frames: n)
    m
}

/// The footwork: a step in toward the foe, a step back out, and a step to either side.
pub const STEP: f32 = 0.32
@fuel(2 ** 40)
pub const STEP_IN: Move = step_move(vec3(0.0, 0.0, STEP))
@fuel(2 ** 40)
pub const STEP_OUT: Move = step_move(vec3(0.0, 0.0, -STEP))
@fuel(2 ** 40)
pub const STEP_LEFT: Move = step_move(vec3(STEP * 0.85, 0.0, 0.0))
@fuel(2 ** 40)
pub const STEP_RIGHT: Move = step_move(vec3(-STEP * 0.85, 0.0, 0.0))

/// The one-offs the lab's fighter acts (main.wrela's `FIGHT_ACTS`), by index: the running
/// punch (`body::ACT_PUNCH`), the roll (`body::ACT_ROLL`), the standing cross (the solved one,
/// `ACT_CROSS`) and the steps; and how each is drawn (`LOOKS`): the strikes as strikes, the rest
/// as they play.
pub const ACT_CROSS: u32 = 2
pub const ACT_STEP_IN: u32 = 3
pub const ACT_STEP_OUT: u32 = 4
pub const ACT_STEP_LEFT: u32 = 5
pub const ACT_STEP_RIGHT: u32 = 6
pub const LOOKS: [Look; 7] = [STRIKE, PLAIN, LIGHT, PLAIN, PLAIN, PLAIN, PLAIN]

/// The VRM bones that come in left and right pairs (the part after "left" / "right").
pub const SIDED: [Text; 24] = [
    "Eye",
    "UpperLeg",
    "LowerLeg",
    "Foot",
    "Toes",
    "Shoulder",
    "UpperArm",
    "LowerArm",
    "Hand",
    "ThumbMetacarpal",
    "ThumbProximal",
    "ThumbDistal",
    "IndexProximal",
    "IndexIntermediate",
    "IndexDistal",
    "MiddleProximal",
    "MiddleIntermediate",
    "MiddleDistal",
    "RingProximal",
    "RingIntermediate",
    "RingDistal",
    "LittleProximal",
    "LittleIntermediate",
    "LittleDistal",
]

/// `c` mirrored left for right (through the body's own middle): a right-foot-forward stance becomes
/// left-foot-forward, each side moving as the other side did.
fn mirrored(c: Clip) -> Clip {
    borrow rig = HERO.rig
    let nb = c.bones
    var partner: Vec<u32> = Vec::with_capacity(nb)
    for b in 0..nb {
        partner.push(b)
    }
    for s in SIDED {
        let (l, r) = (rig.find(f"left{s}".as_str()), rig.find(f"right{s}".as_str()))
        if l != humanoid::NONE && r != humanoid::NONE {
            partner[l] = r
            partner[r] = l
        }
    }
    let base = rig.base
    let inv = base.inverse()
    var out = c.clone()
    for f in 0..c.frames {
        let w = stride::worlds(rig, c, f)
        var m = w.clone()
        for b in 0..nb {
            let r = inv.then(w[partner[b]])
            let q = Quat { v: vec4(r.q.v.x, -r.q.v.y, -r.q.v.z, r.q.v.w) }
            m[b] = base.then(humanoid::Rigid { q: q, t: vec3(-r.t.x, r.t.y, r.t.z) })
        }
        stride::store(rig, m, mut out, f)
    }
    out
}

/// The fight's bounce: ACCAD's Male 2 bouncing on his toes in his guard (E8, Open Motion Project
/// by ACCAD/The Ohio State University, CC BY 3.0: a person's capture, written as a cycle by the
/// moves tool, `moves::stance::STANCE`), mirrored to stand orthodox (left foot forward, so the
/// right is the rear hand that throws the cross). The fight stands in it whole, its shape and its
/// life: the guard every body ready to fight stands in (`GUARD`), and the shape every strike sets
/// off from and comes home to (`guard`, solved to it).
@fuel(2 ** 40)
pub const BOUNCE: Clip = mirrored(moves::stance::STANCE.clip(HERO.rig.clone(), 60.0))

/// The guard as a body stands ready to fight: the bounce, its hands made fists.
@fuel(2 ** 40)
pub const GUARD: Move = in_place(stride::curled_hands(BOUNCE.clone(), HERO.rig, 2.0))

/// The gaits of a body ready to fight: standing in its guard, walking and running as ever.
@fuel(2 ** 40)
pub const FIGHT_GAITS: Gaits = Gaits {
    idle: GUARD.clone(),
    walk: GAITS.walk.clone(),
    run: GAITS.run.clone(),
    start: GAITS.start.clone(),
    stop: GAITS.stop.clone(),
    start_exit: GAITS.start_exit,
    stop_entry: GAITS.stop_entry,
}

// ---- tests ---------------------------------------------------------------------------------------

/// The fight's guard is the bounce (`BOUNCE`, ACCAD Male 2's E8), read on the stance sheet
/// (`engine::stance`) as the take itself reads, every line; its feet sliding no more than the
/// take's own. The guard's key (`guard`), every strike's start and end, is the bounce's shape
/// (solved to it, spec.wrela's `guard_spec`). A strike begun out of the bounce at any moment starts
/// from where the body is: its fist and hips move no more on its first frame than a frame of the
/// bounce alone moves them.
@test
fn the_guard_is_the_bounce() {
    borrow rig = HERO.rig
    let g = engine::stance::read(rig, GUARD.clip.clone())
    let t = engine::stance::read(rig, BOUNCE.clone())
    let near = |a: f32, want: f32, within: f32, what: str| {
        assert(abs(a - want) <= within, f"{what}: {a} against the take's {want}")
    }
    near(g.bounces, t.bounces, 0.01, "bounces a second")
    near(g.bounce_high, t.bounce_high, 0.002, "how high (m)")
    near(g.sway_across, t.sway_across, 0.002, "sway across (m)")
    near(g.sway_fore, t.sway_fore, 0.002, "sway fore and aft (m)")
    near(g.heel[0], t.heel[0], 0.002, "the left heel (m)")
    near(g.heel[1], t.heel[1], 0.002, "the right heel (m)")
    near(g.feet_fore, t.feet_fore, 0.005, "feet fore and aft (m)")
    near(g.feet_across, t.feet_across, 0.005, "feet across (m)")
    assert(g.slide <= 0.018, f"its feet slide {g.slide} m, the take's {t.slide}")
    let (e, h, ge, gh) = engine::stance::begun(
        rig,
        FIGHT_GAITS,
        [solved::CROSS.clone()],
        0,
        engine::end::RIGHT_FIST,
    )
    assert(
        e <= ge + 0.002 && h <= gh + 0.002,
        f"a cross begun: its fist {e} m, its hips {h} m on its first frame",
    )
}
