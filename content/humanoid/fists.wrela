// The fighter's footwork and guard, hand-posed (`engine::keys`): the guard he stands in and
// bounces in, and his steps. A body struck isn't keyed: a blow is laid into its inertia
// (`engine::contact`). His strikes are written moves, each
// part of the body on its own clock and their numbers solved (solved.wrela, hook.wrela,
// `engine::written`); a strike keyed alone, every part on one curve, is gone.

use std::collections::Vec
use engine::humanoid
use engine::humanoid::Clip
use engine::keys
use std::io::print
use engine::keys::{Key, LINEAR, SETTLE, SMOOTH, SNAP}
use engine::playback
use engine::playback::{ACTIVE, CANCEL, Gaits, Mark, Move, RECOVER, WINDUP}
use body::{GAITS, HERO}
use engine::anime::{LIGHT, Look, PLAIN, STRIKE}

/// The guard: an orthodox stance, up on the balls of both feet, the lead foot ahead and turned a
/// little in, the rear foot back and turned out; the hips sunk and turned to the right (the lead
/// shoulder ahead); the lead fist out before the face, the rear at the chin, both elbows in and
/// down. Its shape is the captured boxer's (`accad_fists::GUARD`, ACCAD's Male 2), read off the
/// stance sheet (`engine::stance`) and solved for on this body (spec.wrela's `guard_spec`).
pub fn guard() -> Key {
    // ---- What the solve finds (spec.wrela): each number alone on its line. ----
    // How far the hips are sunk (m) and turned (degrees), and the trunk's lean and turn.
    let sink = -0.0113
    let hips_yaw = -30.6
    let trunk_pitch = -1.5
    let trunk_yaw = -3.5
    // Where the feet stand (m along the floor: +x the left, +z ahead).
    let lead_x = 0.095
    let lead_z = 0.29
    let rear_x = -0.231
    let rear_z = -0.176
    // Where the fists are (m, the body's space), and how high the eyes look (m, 3 m ahead).
    let lead_fist_x = 0.105
    let lead_fist_y = 1.46
    let lead_fist_z = 0.281
    let rear_fist_x = -0.172
    let rear_fist_y = 1.50
    let rear_fist_z = 0.07
    let look_y = 2.1
    Key {
        at: 0.0,
        hips: vec3(-0.01, sink, 0.0),
        hips_turn: vec3(0.0, hips_yaw, 0.0),
        trunk: vec3(trunk_pitch, trunk_yaw, 0.0),
        look: vec3(0.0, look_y, 3.0),
        fists: [
            vec3(lead_fist_x, lead_fist_y, lead_fist_z),
            vec3(rear_fist_x, rear_fist_y, rear_fist_z),
        ],
        elbows: [vec3(0.5, -1.0, -0.2), vec3(-0.5, -1.0, -0.2)],
        rolls: [0.0, 0.0],
        feet: [vec4(lead_x, lead_z, -15.0, 12.0), vec4(rear_x, rear_z, -40.0, 18.0)],
    }
}

/// A keyed clip as a move that stays where it stands: no root path to carry, no heading to
/// turn (its hips' turns are the pose's, not the body's).
fn in_place(c: Clip) -> Move {
    let n = c.frames
    Move {
        clip: c.clone(),
        root: Vec::filled(n, vec3(0.0)),
        heading: Vec::filled(n, 0.0),
        marks: Vec::new(),
        speed: 0.0,
        stride: 0.0,
    }
}

/// A step of a fighter's footwork, `by` along the floor (m, in the body's space: +z toward the
/// foe, +x its left), in the guard and facing the foe all the while: the foot nearest the way it
/// goes steps first (pushed off the other, which drives), lands, and the other follows it, so
/// the stance never narrows or crosses; the body sinks as it lands and is back up bouncing.
pub fn step_keys(by: vec3) -> Vec<Key> {
    // Which foot leads: ahead or to the left, the lead (left) foot; back or to the right, the
    // rear (right).
    let first = if by.z > 0.05 || (abs(by.z) <= 0.05 && by.x > 0.0) { 0 } else { 1 }
    let second = 1 - first
    var out: Vec<Key> = Vec::new()
    var k = guard()
    k.hips = vec3(-0.01, -0.095, 0.0)
    out.push(k)
    // The push: off the second foot, its heel up, the body's weight going.
    k = keys::shifted(guard(), by * 0.12)
    k.at = 0.07
    k.ease = SETTLE
    k.hips.y = -0.085
    k.feet[second] = guard().feet[second]
    k.feet[second].w = 30.0
    k.feet[first] = guard().feet[first] + vec4(by.x * 0.3, by.z * 0.3, 0.0, 0.0)
    k.lifts[first] = 0.05
    out.push(k)
    // The first foot down where it's going; the second leaves the floor.
    k = keys::shifted(guard(), by * 0.65)
    k.at = 0.17
    k.ease = SMOOTH
    k.hips.y = -0.08
    k.feet[first] = guard().feet[first] + vec4(by.x, by.z, 0.0, 0.0)
    k.feet[first].w = 10.0
    k.feet[second] = guard().feet[second] + vec4(by.x * 0.35, by.z * 0.35, 0.0, 0.0)
    k.lifts = [0.0, 0.0]
    k.lifts[second] = 0.045
    out.push(k)
    // The second foot down after it: the stance whole again, sunk to take the weight.
    k = keys::shifted(guard(), by)
    k.at = 0.27
    k.ease = SETTLE
    k.hips.y = -0.11
    k.feet[0].w = 8.0
    k.feet[1].w = 12.0
    out.push(k)
    // Back up, bouncing.
    k = keys::shifted(guard(), by)
    k.at = 0.38
    k.ease = SMOOTH
    k.hips.y = -0.08
    out.push(k)
    out
}

/// A step `by` as a move: its keys at 60 a second about its root, which carries the body.
fn step_move(by: vec3) -> Move {
    let keys = step_keys(by)
    let c = keys::keyed(HERO.rig, keys, fps: 60.0, fist: 2.0)
    let n = c.frames
    var m = in_place(c)
    m.root = keys::travels(keys, fps: 60.0, frames: n)
    m
}

/// The footwork: a step in toward the foe, a step back out, and a step to either side.
pub const STEP: f32 = 0.32
@fuel(2 ** 40)
pub const STEP_IN: Move = step_move(vec3(0.0, 0.0, STEP))
@fuel(2 ** 40)
pub const STEP_OUT: Move = step_move(vec3(0.0, 0.0, -STEP))
@fuel(2 ** 40)
pub const STEP_LEFT: Move = step_move(vec3(STEP * 0.85, 0.0, 0.0))
@fuel(2 ** 40)
pub const STEP_RIGHT: Move = step_move(vec3(-STEP * 0.85, 0.0, 0.0))

/// The one-offs the lab's fighter acts (main.wrela's `FIGHT_ACTS`), by index: the running
/// punch (`body::ACT_PUNCH`), the roll (`body::ACT_ROLL`), the standing cross (the solved one,
/// `ACT_CROSS`) and the steps; and how each is drawn (`LOOKS`): the strikes as strikes, the rest
/// as they play.
pub const ACT_CROSS: u32 = 2
pub const ACT_STEP_IN: u32 = 3
pub const ACT_STEP_OUT: u32 = 4
pub const ACT_STEP_LEFT: u32 = 5
pub const ACT_STEP_RIGHT: u32 = 6
pub const LOOKS: [Look; 7] = [STRIKE, PLAIN, LIGHT, PLAIN, PLAIN, PLAIN, PLAIN]

/// How long the guard's life takes to come round (s), and how far each part of it goes at most:
/// the weight across and fore and aft over the feet (m), the hips' dip as it settles onto a foot
/// (m), the fists' drift (m), the trunk's turn, nod and lean to the loaded side (degrees). The captured boxer's guard
/// (`accad_fists::GUARD`) is the target its stance sheet reads (the_guard_stands_as_the_boxer_does).
pub const LIFE: f32 = 3.5
const SIDE: f32 = 0.012
const FORE: f32 = 0.018
const DIP: f32 = 0.017
const DRIFT: f32 = 0.047
const TURNS: f32 = 5.0
const NOD: f32 = 3.5
const ROLL: f32 = 4.0

/// The guard `u` of the way round its life (0 to 1): never still and never even. Its weight rolls
/// onto the lead foot and back onto the rear twice a time round, the hips settling as it lands on
/// each (the loaded heel down, the other up); the trunk turns and nods a little after it; each
/// fist drifts on its own slow round, as a boxer's hands keep moving. Each is a few waves, each a
/// whole number of times round, so it loops without a seam.
fn living(u: f32) -> Key {
    let g = guard()
    var k = g
    let a = 6.2831853 * u
    let weight = 0.6 * cos(2.0 * a) + 0.15 * sin(3.0 * a + 0.4)
    let settled = 0.5 + 0.5 * cos(2.0 * a)
    k.hips = g.hips + vec3(SIDE * weight, -DIP * settled, FORE * weight)
    k.hips_turn = g.hips_turn + vec3(0.0, 0.6 * TURNS * sin(a + 0.7), 0.0)
    k.trunk = g.trunk + vec3(NOD * sin(2.0 * a + 1.3), TURNS * sin(a + 0.4), -ROLL * weight)
    let lead = vec3(sin(a + 0.3), 0.8 * sin(2.0 * a + 1.9), 0.7 * sin(3.0 * a + 0.8))
    let rear = vec3(0.8 * sin(2.0 * a + 2.6), sin(a + 0.9), 0.7 * sin(2.0 * a + 2.1))
    k.fists = [g.fists[0] + lead * DRIFT, g.fists[1] + rear * DRIFT]
    // The loaded foot's heel sinks, the other's rises.
    k.feet[0].w = g.feet[0].w - 6.0 * max(weight, 0.0) + 6.0 * max(-weight, 0.0)
    k.feet[1].w = g.feet[1].w - 6.0 * max(-weight, 0.0) + 6.0 * max(weight, 0.0)
    k
}

/// The guard as a body stands ready to fight (`living`), a key a frame round its life.
pub fn guard_keys() -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    let n = u32(LIFE * 60.0)
    for f in 0..n + 1 {
        var k = living(f32(f) / f32(n))
        k.at = f32(f) / 60.0
        k.ease = LINEAR
        out.push(k)
    }
    out
}

@fuel(2 ** 40)
pub const GUARD: Move = guard_move()

fn guard_move() -> Move {
    var c = keys::keyed(HERO.rig, guard_keys(), fps: 60.0, fist: 2.0)
    c.looped = true
    in_place(c)
}

/// The gaits of a body ready to fight: standing in its guard, walking and running as ever.
@fuel(2 ** 40)
pub const FIGHT_GAITS: Gaits = Gaits {
    idle: GUARD.clone(),
    walk: GAITS.walk.clone(),
    run: GAITS.run.clone(),
    start: GAITS.start.clone(),
    stop: GAITS.stop.clone(),
    start_exit: GAITS.start_exit,
    stop_entry: GAITS.stop_entry,
}

// ---- tests ---------------------------------------------------------------------------------------

/// The fight's guard stands as the captured boxer's does (`accad_fists::GUARD`), read on the same
/// sheet (`engine::stance`): its shape (solved to it, spec.wrela's `guard_spec`) and its life
/// (how often it settles and how far, how far its weight sways, how far and how fast its hands
/// and head go), each within a third of his; never still, and its feet held where they stand.
@test
fn the_guard_stands_as_the_boxer_does() {
    borrow rig = HERO.rig
    let g = engine::stance::read(rig, GUARD.clip.clone())
    let b = engine::stance::read(rig, accad_fists::GUARD.clip.clone())
    let near = |a: f32, want: f32, within: f32, what: str| {
        assert(abs(a - want) <= within, f"{what}: {a} against the boxer's {want}")
    }
    near(g.feet_fore, b.feet_fore, 0.02, "feet fore and aft (m)")
    near(g.feet_across, b.feet_across, 0.02, "feet across (m)")
    near(g.knees, b.knees, 6.0, "knees (degrees)")
    near(g.turn, b.turn, 3.0, "trunk's turn (degrees)")
    for i in 0..2 {
        near(g.hand_y[i], b.hand_y[i], 0.02, "a hand's height (m)")
        near(g.hand_face[i], b.hand_face[i], 0.02, "a hand off the face (m)")
    }
    let third = |a: f32, want: f32, what: str| {
        assert(abs(a - want) <= want / 3.0, f"{what}: {a} against the boxer's {want}")
    }
    third(g.bounces, b.bounces, "settles a second")
    third(g.bounce_high, b.bounce_high, "how far it settles (m)")
    third(g.sway_across + g.sway_fore, b.sway_across + b.sway_fore, "weight's sway (m)")
    third(g.hands_most, b.hands_most, "hands' drift (m)")
    third(g.hands_speed, b.hands_speed, "hands' speed (m/s)")
    third(g.head_most, b.head_most, "head's drift (m)")
    third(g.head_speed, b.head_speed, "head's speed (m/s)")
    assert(g.stillest < 0.1, f"never still: still for {g.stillest} s")
    assert(g.slide <= b.slide, f"its feet slide {g.slide} m")
}
