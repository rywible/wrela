// One exchange, for judging how a blow reads (`SHOW=28`, and the lab's `SHOW=29`): the fight's
// cross (the solved one, a written move, thrown with a step: `stepping::CROSS`) thrown out of the
// guard from out of reach at a second
// fighter, or the stone giant, who stands where it lands. The contact is the engine's
// (`engine::contact`): both bodies held through the hit-stop, the striker driving on in while his
// fist stays on what it struck; as the hold breaks, the one struck knocked along the blow and the
// blow back up the striker's arm, each laid into the body's inertia; the camera kicked along it
// and pushed in. Nothing here is keyed to this punch: another written strike thrown here lands
// the same way.
//
// `--set X_HOLD=0 --set X_FLASH=0 --set X_KICK=0 --set X_PUSH=0` is the bare exchange.

use engine::anime
use engine::anime::{Anime, Drawer, Force, Look, STRIKE}
use engine::contact
use engine::contact::{Give, Hit, Kick, Knock, Shock}
use engine::end::RIGHT_FIST
use engine::held
use engine::held::Held
use engine::humanoid
use engine::humanoid::{Pose, pose_world}
use engine::playback
use engine::playback::{Gaits, Handling, Move, Mover}
use std::collections::Vec
use std::string::String
use std::transform::translate
use engine::timing::RATE
use body::HERO
use fists::FIGHT_GAITS
use solved
use stepping
use armed
use downcut
use stick

/// The hit-stop: how long both bodies hold at contact (s).
pub const X_HOLD: f32 = 0.15
/// How long the contact is drawn as an impact frame (s).
pub const X_FLASH: f32 = 0.06
/// How hard the camera's kicked along the blow (m), and how far it's pushed in after (m).
pub const X_KICK: f32 = 0.07
pub const X_PUSH: f32 = 0.2
/// How long the push takes to let go (s).
pub const X_PUSH_LIFE: f32 = 0.45
/// The second fighter's tint (`paint`'s), and the stone giant's (above 1.5 in `w`: stone).
pub const X_TINT = vec4(0.3, 0.45, 0.85, 1.0)
pub const X_STONE = vec4(0.62, 0.66, 0.72, 2.0)
/// Who's struck: the fighter (0), or the giant (1), `X_SCALE` times as big, struck on the shin;
/// and the blast the blow throws off him (its size, m; 0 none) and how long it lives (s).
pub const X_GIANT: u32 = 0
pub const X_SCALE: f32 = 4.5
pub const X_BLAST: f32 = 3.2
pub const X_BLAST_LIFE: f32 = 0.45
/// Whether the striker's drawn on twos (the fight's anime) or every frame.
pub const X_TWOS: u32 = 0
/// How kinetic the page stays after the impact frame (0 to 1), and how fast it lets go (s).
pub const X_AFTER: f32 = 0.85
pub const X_AFTER_LIFE: f32 = 0.17
/// The hit staged close: how far in (of the distance), the focus's height there (m), how long
/// before the contact it closes in, how long it stays after the hold, how long it takes to open
/// out again (s), and how far along the blow it goes with the one struck (m).
pub const X_STAGE: f32 = 0.58
pub const X_STAGE_FOCUS: f32 = 1.3
pub const X_STAGE_IN: f32 = 0.3
pub const X_STAGE_STAY: f32 = 0.1
pub const X_STAGE_OUT: f32 = 0.5
pub const X_STAGE_WITH: f32 = 0.4
/// How much bigger the striking fist is drawn on the blow (of its size, added), and how far the
/// struck head's squashed along it (of its depth), while the fist is in it.
pub const X_FIST: f32 = 0.35
pub const X_SQUASH: f32 = 0.15
/// How near the middle of the struck one's glove may come to the striker's arms and fists (m): a
/// glove's half-width, an arm's, and a gap between.
pub const X_CLEAR: f32 = 0.19
/// How much of its pace the striker's clock keeps through the hit-stop (he drives on in while
/// his fist stays on what it struck), how long after it his fist still rides what it struck (s),
/// how hard the one struck gives (1 a fighter's own give), and how hard the blow runs back up the
/// striker's arm (0.1 as hard as `engine::contact::Give`'s own).
pub const X_GRIND: f32 = 0.3
pub const X_PIN: f32 = 0.05
pub const X_GIVE: f32 = 0.5
pub const X_RECOIL: f32 = 0.1

/// When the scripted exchange (`SHOW=28`) throws its cross (s): the cross, stepping in from out
/// of reach (`stepping::CROSS`), lands 6.8 s in, frame 204 at the judge's 30 a second
/// (studio/judge's `exchange` scene and `arms` shots): a frame before the cross's own start, which
/// it's begun on the frame after.
pub const THROW: f32 = 6.43 - 1.0 / 60.0

/// What the combat lab (`lab`) tunes live: the hit-stop, the impact frame, the camera's kick and
/// push, the blast's size, how hard the one struck gives, whether the striker's drawn on twos,
/// who's struck, and how the striker drives on, rides the hit and takes its shock. `TUNED` is
/// what the constants above say.
pub struct Tune: Copy + Eq {
    pub hold: f32,
    pub flash: f32,
    pub kick: f32,
    pub push: f32,
    pub blast: f32,
    pub give: f32,
    pub twos: bool,
    pub giant: bool,
    pub grind: f32 = X_GRIND,
    pub pin: f32 = X_PIN,
    pub recoil: f32 = X_RECOIL,
    /// How heavy the blow is (`engine::contact::Hit::weight`).
    pub weight: f32 = 1.0,
    /// Whether the striker holds the lab's stand-in stick (`stick::BOTH`), in both hands, and cuts
    /// with it (`downcut::DOWNCUT`) in place of the cross: the blow lands where along it the head
    /// is, going the way the stick goes there, and it's drawn trailing.
    pub stick: bool = false,
}

/// What the striker holds, as `t` says.
pub fn held_of(t: Tune) -> Held {
    if t.stick { stick::BOTH.held } else { engine::held::NOTHING }
}

pub const TUNED: Tune = Tune {
    hold: X_HOLD,
    flash: X_FLASH,
    kick: X_KICK,
    push: X_PUSH,
    blast: if X_GIANT == 1 { X_BLAST } else { 0.0 },
    give: X_GIVE,
    twos: X_TWOS == 1,
    giant: X_GIANT == 1,
}

/// The way the blow goes: the striker stands at the origin facing +x (`HEADING`; the lab's
/// side-on camera looks across it), the one struck facing back at him.
pub const BLOW: vec3 = vec3(1.0, 0.0, 0.0)
pub const HEADING: f32 = 1.57079633
pub const FACING_BACK: f32 = -1.57079633

/// Point `p` of a body facing +z, turned to face the way `heading` says (about up).
fn turned(p: vec3, heading: f32) -> vec3 {
    Quat::axis_angle(vec3(0.0, 1.0, 0.0), heading).rotate(p)
}

/// Where the cross's fist is on its contact (the world): the striker stands at the origin, out of
/// reach, and the cross steps in as it's thrown (`stepping::cross`, its travel in its reach).
@fuel(2 ** 40)
pub const KNUCKLES: vec3 = turned(stepping::cross().end(HERO.rig, stepping::CONTACT), HEADING)

/// Where bone `name` of the guard is (the body's space).
fn in_guard(name: str) -> vec3 {
    borrow rig = HERO.rig
    pose_world(rig, FIGHT_GAITS.idle.pose(0.0))[rig.find(name)].t
}

/// Where the one struck stands, facing the striker (on the floor, the world): the fighter with
/// his chin a fist's depth past the contact, or the giant with his lead shin there.
@fuel(2 ** 40)
pub const FOE_AT: vec3 = foe_at(giant: false)
@fuel(2 ** 40)
pub const GIANT_AT: vec3 = foe_at(giant: true)

/// Where the one struck stands for the cut (the stick in both hands): his neck where the cut
/// lands.
@fuel(2 ** 40)
pub const CUT_FOE_AT: vec3 = foe_at(giant: false, hit: CUT_POINT)

/// Where the cut's striking point is on its contact (the world), thrown from the origin.
@fuel(2 ** 40)
pub const CUT_POINT: vec3 = turned(downcut::cut().end(HERO.rig, downcut::CONTACT), HEADING)

fn foe_at(giant: bool, hit: vec3 = KNUCKLES) -> vec3 {
    let (p, s) = if giant {
        ((in_guard("leftLowerLeg") + in_guard("leftFoot")) * 0.5, X_SCALE)
    } else { (in_guard("head") - vec3(0.0, 0.1, 0.0), 1.0) }
    let to = hit + BLOW * 0.1
    let r = turned(p, FACING_BACK) * s
    vec3(to.x - r.x, 0.0, to.z - r.z)
}

/// Where the one struck (not the giant) stands, as `t` says: where the cut lands, or the cross.
fn foe_of(t: Tune) -> vec3 {
    if t.stick { CUT_FOE_AT } else { FOE_AT }
}

/// The gaits both stand and step in, as `t` says: armed with the stand-in in both hands (its
/// armed guard, `armed::ARMED_GAITS`), or in the fight's guard.
@fuel(2 ** 40)
const GAITS: [Gaits; 2] = [FIGHT_GAITS.clone(), armed::ARMED_GAITS.clone()]

fn armed_of(t: Tune) -> u32 {
    if t.stick { 1 } else { 0 }
}

/// When the striker's strike lands (s into it), as `t` says: the cut's, or the cross's.
fn contact_of(t: Tune) -> f32 {
    if t.stick { downcut::CONTACT } else { stepping::CONTACT }
}

/// Where the one struck is drawn: turned to face the striker, the giant `X_SCALE` times as big.
pub fn place(t: Tune) -> mat4 {
    let (at, s) = if t.giant { (GIANT_AT, X_SCALE) } else { (foe_of(t), 1.0) }
    let (x, z) = (
        turned(vec3(1.0, 0.0, 0.0), FACING_BACK),
        turned(vec3(0.0, 0.0, 1.0), FACING_BACK),
    )
    let r = mat4(
        vec4(x * s, 0.0),
        vec4(0.0, s, 0.0, 0.0),
        vec4(z * s, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    )
    translate(at) * r
}

pub fn tint(t: Tune) -> vec4 {
    if t.giant { X_STONE } else { X_TINT }
}

/// How the one struck gives, and the striker takes its shock, as `t` says: a fighter's own give
/// (`engine::contact::Give`) scaled, the stone giant giving a quarter as much and standing his
/// ground, the camera kicked as far as `kick` says.
pub fn give_of(t: Tune) -> Give {
    let g = Give {}
    let stone = if t.giant { 0.25 } else { 1.0 }
    Give {
        // (The giant stands his ground: he's too big to be knocked off his feet.)
        back: if t.giant { 0.0 } else { g.back * 2.0 * t.give },
        tip: g.tip * 2.0 * t.give * stone,
        lean: g.lean * 2.0 * t.give * stone,
        open: g.open * 2.0 * t.give * stone,
        shock: g.shock * t.recoil / X_RECOIL,
        // (A kick of `kick` m at its farthest: measured, the camera's spring set going at `v`
        // goes `v` times its half-life over 3.76 at most.)
        kick: t.kick * 3.76 / g.kick_half,
        ..g,
    }
}

/// The exchange as it's stepped: its tuning; how long since the cross was thrown (s; below 0
/// not yet, or none to throw) and whether one's still to throw; the striker and the one struck,
/// each a body that plays its moves (`engine::playback`) and drawn as the fight draws it; the
/// blow (`hit`), how long since it landed (s; below 0, not yet) and how long it's still held;
/// the camera's kick; and what this frame shows and sounds.
pub struct Exchange: Clone {
    tune: Tune,
    clock: f32,
    throw: bool,
    /// What the striker does once he's done with what he's doing (`CROSS`, `BACK`;
    /// `humanoid::NONE` nothing).
    then: u32,
    striker: Mover,
    struck: Mover,
    drawer: Drawer,
    mask: [f32; 64],
    hit: Hit,
    since: f32,
    held: f32,
    given: bool,
    kick: Kick,
    shock: Shock,
    knock: Knock,
    shown: Pose,
    shown_place: mat4,
    struck_shown: Pose,
    smears: [anime::Smear; 4],
    trail: anime::Trail,
    grown: anime::Grown,
    /// The striker's hand (the body's space) a frame ago: the way a held thing's going.
    hand_was: humanoid::Rigid,
    impact: f32,
    force: Force,
    swing: bool,
    landed: bool,
    /// Where along what he holds his blow met the head (0 the hilt, 1 the tip).
    along: f32,
    /// The striker's time from the blow (s): below 0 before it lands, by his move's clock; very
    /// far below with no blow coming.
    from_hit: f32,
}

/// What the striker does: stands out of reach, throws the cross stepping in (`CROSS`), or with the
/// stick the cut (`CUT`), and steps back to where he stood (`BACK`, `CUT_BACK`).
@fuel(2 ** 40)
const MOVES: [Move; 4] = [
    stepping::CROSS.clone(),
    stepping::BACK.clone(),
    downcut::DOWNCUT.clone(),
    downcut::BACK.clone(),
]
const CROSS: u32 = 0
const BACK: u32 = 1
const CUT: u32 = 2
const CUT_BACK: u32 = 3

impl Exchange {
    /// Both in their guards, the cross to be thrown `after` s on (below 0: none till a press).
    pub fn new(t: Tune, after: f32) -> Exchange {
        Exchange {
            tune: t,
            clock: -after,
            throw: after >= 0.0,
            then: humanoid::NONE,
            striker: Mover::standing(vec3(0.0), HEADING, GAITS[armed_of(t)]),
            struck: Mover::standing(if t.giant { GIANT_AT } else {
                foe_of(t)
            }, FACING_BACK, GAITS[armed_of(t)]),
            drawer: Drawer::new(),
            mask: playback::upper_body(HERO.rig),
            hit: Hit { at: KNUCKLES, way: BLOW, weight: t.weight, hold: t.hold },
            since: -1.0,
            held: 0.0,
            given: true,
            kick: Kick::none(),
            shock: Shock::none(),
            knock: Knock::none(),
            shown: GAITS[armed_of(t)].idle.pose(0.0),
            shown_place: std::transform::identity(),
            struck_shown: GAITS[armed_of(t)].idle.pose(0.0),
            smears: [anime::Smear::none(); 4],
            trail: anime::Drawer::new().trail,
            grown: anime::Grown { on: false, about: vec3(0.0), by: 1.0, bone: humanoid::NONE },
            hand_was: humanoid::Rigid::identity(),
            impact: 0.0,
            force: Force::none(),
            swing: false,
            landed: false,
            along: 1.0,
            from_hit: -1.0e6,
        }
    }

    /// A press: the cross thrown now, through `t`, from wherever the two stand. (Who's struck
    /// changing stands him anew.)
    pub fn again(mut self, t: Tune) {
        if t.giant != self.tune.giant || t.stick != self.tune.stick {
            self.struck = Mover::standing(
                if t.giant { GIANT_AT } else { foe_of(t) },
                FACING_BACK,
                GAITS[armed_of(t)],
            )
        }
        self.tune = t
        self.clock = 0.0
        self.throw = true
        self.then = humanoid::NONE
        self.since = -1.0
        self.held = 0.0
        self.given = true
    }

    /// The exchange `dt` (s) on.
    pub fn step(mut self, dt: f32) {
        borrow rig = HERO.rig
        let t = self.tune
        let give = give_of(t)
        self.clock += dt
        self.swing = false
        self.landed = false
        var act = humanoid::NONE
        if self.throw && self.clock >= 0.0 {
            act = if t.stick { CUT } else { CROSS }
            self.then = if t.stick { CUT_BACK } else { BACK }
            self.throw = false
        } else if self.then != humanoid::NONE && self.striker.acting == humanoid::NONE {
            act = self.then
            self.then = humanoid::NONE
        }
        // Held at the blow: the one struck still, the striker driving on at `grind` of his pace.
        let holding = self.held > 0.0
        let was = self.striker.act_time
        let pose = playback::step(
            mut self.striker,
            GAITS[armed_of(t)],
            MOVES,
            rig,
            self.mask,
            vec3(0.0),
            act,
            upper: false,
            how: Handling {},
            dt: contact::paced(dt, held: holding, grind: t.grind),
        )
        let striking = self.striker.acting == CROSS || self.striker.acting == CUT
        let now = self.striker.act_time
        if striking && was < contact_of(t) - 0.12 && now >= contact_of(t) - 0.12 {
            self.swing = true
        }
        // The blow lands as the cross reaches its contact.
        let holds = held_of(t)
        let w_now = pose_world(rig, pose)
        let hand_now = w_now[rig.find("rightHand")]
        if striking && self.since < 0.0 && now >= contact_of(t) {
            let place = playback::placed(self.striker)
            let fist = (place * vec4(RIGHT_FIST.in_pose(rig, w_now), 1.0)).xyz
            self.hit = Hit { at: fist, way: BLOW, weight: t.weight, hold: t.hold }
            if holds.held() {
                // A held thing's blow lands where along it the head it meets is, and goes the
                // way the thing's going there.
                let head = (playback::placed(self.struck) *
                    vec4(pose_world(rig, self.struck_shown)[rig.find("head")].t, 1.0)).xyz
                let along = holds.along(
                    hand_now,
                    (std::transform::inverse(place) * vec4(head, 1.0)).xyz,
                )
                self.along = along
                let way = held::swung(holds, along, hand_now, self.hand_was)
                self.hit = Hit {
                    at: (place * vec4(holds.at(along).in_pose(rig, w_now), 1.0)).xyz,
                    way: (place * vec4(way, 0.0)).xyz,
                    weight: t.weight,
                    hold: t.hold,
                }
            }
            self.since = 0.0
            self.held = t.hold
            self.given = false
            self.landed = true
            self.kick.kicked(self.hit, give)
        } else if self.since >= 0.0 {
            self.since += dt
        }
        if self.held > 0.0 {
            self.held -= dt
        }
        // As the hold breaks, each gives to it.
        if !self.given && self.held <= 0.0 {
            self.knock.struck(self.struck, self.hit, give)
            self.shock = Shock::struck(self.hit, end: RIGHT_FIST)
            self.given = true
        }
        self.shock.step(give, dt)
        let pose = self.shock.over(self.striker, rig, pose)
        // His fist on what it struck while it's held, and a little after.
        let place = playback::placed(self.striker)
        let riding = self.since >= 0.0 && self.since < t.hold + t.pin && striking
        // (What struck: the fist, or the point along what it holds that met the head.)
        let end = if holds.held() { holds.at(self.along) } else { RIGHT_FIST }
        let pose = if riding { contact::pinned(rig, pose, place, end: end, at: self.hit.at) } else {
            pose
        }
        self.hand_was = hand_now
        let look = if t.twos { STRIKE } else { Look { twos: false, ..STRIKE } }
        let d = anime::drawn(
            mut self.drawer,
            self.striker,
            MOVES,
            [look, anime::PLAIN, look, anime::PLAIN],
            rig,
            self.mask,
            pose,
            place,
            Anime { impact: t.flash, held: holds, big: X_FIST, big_for: t.hold },
            dt,
        )
        self.shown = d.pose
        self.shown_place = d.place
        self.smears = d.smears
        self.trail = d.trail
        self.grown = d.grown
        self.impact = d.impact
        self.force = d.force
        let held = self.held > 0.0
        self.knock.step(mut self.struck, give, if held { 0.0 } else { dt })
        let moved = playback::step(
            mut self.struck,
            GAITS[armed_of(t)],
            MOVES,
            rig,
            self.mask,
            vec3(0.0),
            humanoid::NONE,
            upper: false,
            how: Handling {},
            dt: contact::paced(dt, held: held, grind: 0.0),
        )
        self.struck_shown = self.knock.over(rig, moved, give)
        // The one struck with his gloves kept off the striker's arms.
        self.struck_shown = clear_of(
            self.struck_shown,
            playback::placed(self.struck),
            self.shown,
            self.shown_place,
        )
        self.from_hit = if self.since >= 0.0 { self.since } else if striking {
            self.striker.act_time - contact_of(t)
        } else { -1.0e6 }
        self.kick.step(give, dt)
    }

    /// The striker's palette as drawn (`anime::drawn_palette`: smeared where his fist's going in
    /// fast, what he holds trailed, his striking fist drawn big on the blow).
    pub fn striker_palette(self) -> [mat4; 64] {
        let d = anime::Drawn {
            pose: self.shown,
            place: self.shown_place,
            impact: self.impact,
            smears: self.smears,
            force: self.force,
            trail: self.trail,
            grown: self.grown,
        }
        anime::drawn_palette(
            humanoid::palette(HERO.rig, self.shown, self.shown_place),
            HERO.rig,
            d,
            held_of(self.tune),
        )
    }

    /// The one struck's palette, where he's drawn (the giant scaled).
    pub fn struck_palette(self) -> [mat4; 64] {
        let s = if self.tune.giant { X_SCALE } else { 1.0 }
        let scale = mat4(
            vec4(s, 0.0, 0.0, 0.0),
            vec4(0.0, s, 0.0, 0.0),
            vec4(0.0, 0.0, s, 0.0),
            vec4(0.0, 0.0, 0.0, 1.0),
        )
        humanoid::palette(HERO.rig, self.struck_shown, playback::placed(self.struck) * scale)
    }

    /// The tuning on screen now, and where the one struck stands.
    pub fn tune(self) -> Tune {
        self.tune
    }

    /// How long since the blow landed (s; below 0, not yet).
    pub fn since(self) -> f32 {
        self.since
    }

    /// Where the camera's kicked to (the world, m), and how far it's pushed in (m): pushed as the
    /// hold breaks and let go over `X_PUSH_LIFE`.
    pub fn camera(self) -> (vec3, f32) {
        let u = self.since - self.tune.hold
        let push = if self.since < 0.0 || u < 0.0 { 0.0 } else {
            self.tune.push * smoothstep(0.0, 0.14, u) * exp(-u / X_PUSH_LIFE)
        }
        (self.kick.at, push)
    }

    /// How kinetic the moment is (the impact frame, `flash` s of it, then the page let go over
    /// `X_AFTER_LIFE`), and where the strike's force runs.
    pub fn kinetic(self) -> (f32, Force) {
        let u = self.since
        let k = if u < 0.0 { 0.0 } else if u < self.tune.flash { 1.0 } else {
            X_AFTER * exp(-(u - self.tune.flash) / X_AFTER_LIFE)
        }
        (max(k, self.impact), self.force)
    }

    /// How much bigger the striking fist is drawn (1 its own size), and how far the struck head's
    /// squashed along the blow (of its depth): whole on the contact and while it's held, let go as
    /// the fist leaves (none on the giant).
    pub fn drawn_big(self) -> (f32, f32) {
        let u = self.since
        if u < 0.0 {
            return (1.0, 0.0)
        }
        let on = 1.0 - smoothstep(self.tune.hold, self.tune.hold + 0.1, u)
        // (The fist's own size is the drawing's, `anime`'s: `Anime::big`.)
        (if self.grown.on { self.grown.by } else { 1.0 }, if self.tune.giant { 0.0 } else {
            X_SQUASH * on
        })
    }

    /// How far the hit is staged close (0 to 1; never the giant's: he's framed whole), and how far
    /// along the blow the close camera's gone with the one struck (m).
    pub fn staged(self) -> (f32, f32) {
        let t = self.from_hit
        if self.tune.giant || t < -1.0e5 {
            return (0.0, 0.0)
        }
        let stage = if t < 0.0 { smoothstep(-X_STAGE_IN, -0.03, t) } else {
            let from = self.tune.hold + X_STAGE_STAY
            1.0 - smoothstep(from, from + X_STAGE_OUT, t)
        }
        let with = X_STAGE_WITH * smoothstep(self.tune.hold, self.tune.hold + 0.2, t) * stage
        (stage, with)
    }

    /// The blast off the giant as the blow lands: where it starts and its age, and the way it goes
    /// and its size (`look::Shot`'s `blast`, `blast_dir`); none (age below 0) else.
    pub fn blast(self) -> (vec4, vec4) {
        let t = self.tune
        if !t.giant || t.blast <= 0.0 || self.since < 0.0 || self.since > X_BLAST_LIFE {
            return (vec4(0.0, 0.0, 0.0, -1.0), vec4(0.0))
        }
        (vec4(self.hit.at, self.since), vec4(BLOW, t.blast))
    }

    /// Whether the fist set off on its way in this step (its whoosh), and whether the blow landed
    /// (its hit); and where the blow is.
    pub fn sounds(self) -> (bool, bool, vec3) {
        (self.swing, self.landed, self.hit.at)
    }
}

/// The one struck (`foe`, drawn at `at`) with his gloves kept off the striker's arms and fists
/// (`striker`, drawn at `by`): a glove that would be on one is moved off it the shortest way, its
/// arm reaching there. (A guard stood as near as a blow lands holds its gloves where the striking
/// arm comes through.)
fn clear_of(foe: Pose, at: mat4, striker: Pose, by: mat4) -> Pose {
    borrow rig = HERO.rig
    let ws = pose_world(rig, striker)
    let on = |b: u32| -> vec3 { (by * vec4(ws[b].t, 1.0)).xyz }
    var segs: Vec<(vec3, vec3)> = Vec::new()
    for arm in ["left", "right"] {
        let s0 = on(rig.find(f"{arm}UpperArm".as_str()))
        let e = on(rig.find(f"{arm}LowerArm".as_str()))
        let wr = on(rig.find(f"{arm}Hand".as_str()))
        segs.push((s0, e))
        segs.push((e, wr + normalize(wr - e) * 0.09))
    }
    let a = pose_world(rig, foe)
    let nb = rig.bones.len()
    var w: Vec<humanoid::Rigid> = Vec::with_capacity(nb)
    for b in 0..nb {
        w.push(a[b])
    }
    let back = std::transform::inverse(at)
    var moved = false
    for side in 0..2 {
        let hand = rig.find(if side == 0 { "leftHand" } else { "rightHand" })
        let lower = rig.find(if side == 0 { "leftLowerArm" } else { "rightLowerArm" })
        let p = (at * vec4(w[hand].t, 1.0)).xyz
        // (The glove's middle, a little on from the wrist.)
        let g = p + normalize((at * vec4(w[hand].t - w[lower].t, 0.0)).xyz) * 0.07
        var push = vec3(0.0)
        for (s0, s1) in segs {
            let ab = s1 - s0
            let q = s0 + ab * clamp(dot(g + push - s0, ab) / max(dot(ab, ab), 1.0e-6), 0.0, 1.0)
            let d = length(g + push - q)
            if d < X_CLEAR {
                let away = if d > 1.0e-4 { (g + push - q) / d } else { vec3(0.0, -1.0, 0.0) }
                push += away * (X_CLEAR - d)
            }
        }
        if length(push) > 1.0e-5 {
            engine::keys::arm_to(rig, mut w, u32(side), (back * vec4(p + push, 1.0)).xyz)
            moved = true
        }
    }
    if !moved {
        return foe
    }
    var out = foe
    for b in 0..nb {
        let up = rig.bones[b].parent
        let pq = if up == humanoid::NONE { rig.base.q } else { w[up].q }
        out.turns[b] = pq.inverse().mul(w[b].q)
    }
    out
}

// ---- the contact sheet --------------------------------------------------------------------------

/// The striker as this step shows him (his pose, before he's placed), and his place.
impl Exchange {
    pub fn striker_pose(self) -> (Pose, mat4) {
        (self.shown, self.shown_place)
    }
}

/// The exchange stepped at `RATE` a second from both standing to `seconds` on, the cross thrown
/// `after` s in: each step's exchange.
pub fn played(t: Tune, after: f32, seconds: f32) -> Vec<Exchange> {
    var x = Exchange::new(t, after: after)
    var out: Vec<Exchange> = Vec::new()
    let n = u32(seconds * RATE)
    for _ in 0..n {
        x.step(1.0 / RATE)
        out.push(x.clone())
    }
    out
}

/// The contact sheet: how the blow lands and how both bodies take it, read a step at a time
/// (`RATE` a second) through the exchange as `t` tunes it, a blow of each weight in turn (a
/// quarter, a half, the heaviest). `wrela tool moves -- --contact` prints it.
pub fn sheet(t: Tune) -> String {
    var out = String::from(
        f"contact: the cross lands on {if t.giant { "the giant's shin" } else { "the jaw" }}, held {t.hold:.3} s\n",
    )
    for weight in [0.25, 0.5, 1.0] {
        out.push_str(read(Tune { weight, ..t }).as_str())
    }
    // And a blow that comes down: the cut in both hands (`downcut`), at weight 1.
    out.push_str("the cut in both hands, coming down on the neck:\n")
    out.push_str(read(Tune { weight: 1.0, stick: true, ..t }).as_str())
    out
}

/// One blow's rows of the contact sheet (`sheet`).
fn read(t: Tune) -> String {
    borrow rig = HERO.rig
    let steps = played(t, after: 0.2, seconds: 6.0)
    let (head, hips) = (rig.find("head"), rig.find("hips"))
    let world = |m: Mover, p: Pose, b: u32| -> vec3 {
        (playback::placed(m) * vec4(pose_world(rig, p)[b].t, 1.0)).xyz
    }
    var landed = 0
    for i in 0..steps.len() {
        if steps[i].since >= 0.0 {
            landed = i
            break
        }
    }
    let at = steps[landed].hit.at
    borrow first = steps[landed]
    let head0 = world(first.struck, first.struck_shown, head)
    let hips0 = world(first.struck, first.struck_shown, hips)
    let drove0 = world(first.striker, first.shown, hips)
    let feet0 = [first.struck.feet[0].at, first.struck.feet[1].at]
    // Through the hold: how far the fist strays off what it struck, and how far the striker's
    // hips drive on in.
    var stray = 0.0
    var drove = 0.0
    // After it: each joint's most laid in, and when; the struck head's and hips' farthest along
    // the blow, and when; when both are back within a centimetre; how far his feet step back and
    // how many steps they take; how far his guard's knocked open (his upper arms' most turned off
    // it, degrees); the camera's kick and push at their most.
    var shock = [0.0; 4]
    var shock_at = [0.0; 4]
    var far = 0.0
    var far_at = 0.0
    var hips_far = 0.0
    var hips_at = 0.0
    var out_at = 0.0
    var feet_far = 0.0
    var steps_taken = 0
    var stepping = [false, false]
    var open = 0.0
    var snap = 0.0
    var snap_at = 0.0
    var trunk_at = 0.0
    var trunk = 0.0
    var kick = 0.0
    var push = 0.0
    // How far the struck head and hips go down under a blow that comes down, and when.
    var dropped = 0.0
    var dropped_at = 0.0
    var sank = 0.0
    var sank_at = 0.0
    for i in landed..steps.len() {
        borrow x = steps[i]
        let u = x.since
        if u < t.hold {
            let (p, place) = x.striker_pose()
            // (What struck: the fist, or the point along what he holds that met the head.)
            let held = held_of(t)
            let end = if held.held() { held.at(x.along) } else { RIGHT_FIST }
            let fist = (place * vec4(end.in_pose(rig, pose_world(rig, p)), 1.0)).xyz
            stray = max(stray, length(fist - at))
            drove = max(drove, dot(world(x.striker, x.shown, hips) - drove0, BLOW))
            continue
        }
        let after = (u - t.hold) * 1000.0
        for k in 0..4 {
            let v = x.shock.turned(k)
            if v > shock[k] {
                shock[k] = v
                shock_at[k] = after
            }
        }
        let d = dot(world(x.struck, x.struck_shown, head) - head0, BLOW)
        let h = dot(world(x.struck, x.struck_shown, hips) - hips0, BLOW)
        if d > far {
            far = d
            far_at = after
        }
        if h > hips_far {
            hips_far = h
            hips_at = after
        }
        let dh = head0.y - world(x.struck, x.struck_shown, head).y
        let dp = hips0.y - world(x.struck, x.struck_shown, hips).y
        if dh > dropped {
            dropped = dh
            dropped_at = after
        }
        if dp > sank {
            sank = dp
            sank_at = after
        }
        // (Home: his body back on its mark and his head on his neck, whatever his guard's bounce
        // does.)
        if !x.knock.still() {
            out_at = after
        }
        for f in 0..2 {
            feet_far = max(feet_far, dot(x.struck.feet[f].at - feet0[f], BLOW))
            let on = x.struck.feet[f].step > 0.0
            if on && !stepping[f] {
                steps_taken += 1
            }
            stepping[f] = on
        }
        open = max(open, length(x.knock.guard.x) * 57.29578)
        let hs = length(x.knock.head.x) * 57.29578
        if hs > snap + 0.05 {
            snap = hs
            snap_at = after
        }
        let ts = length(x.knock.trunk.x) * 57.29578
        if ts > trunk + 0.05 {
            trunk = ts
            trunk_at = after
        }
        let (k, pu) = x.camera()
        kick = max(kick, length(k))
        push = max(push, pu)
    }
    var out = String::from(f"weight {t.weight:.2}\n")
    out.push_str(
        f"  hold: the fist strays {stray * 100.0:.1} cm off what it struck; the striker drives on {drove * 100.0:.1} cm\n".as_str(),
    )
    out.push_str("  shock (most turned, and when after the hold breaks):")
    let parts = ["forearm", "upper arm", "collar", "chest"]
    for k in 0..4 {
        out.push_str(f" {parts[k]} {shock[k]:.1} deg at {shock_at[k]:.0} ms;".as_str())
    }
    out.push_str("\n")
    out.push_str(
        f"  struck: head {far * 100.0:.1} cm along the blow at its farthest ({far_at:.0} ms), hips {hips_far * 100.0:.1} cm ({hips_at:.0} ms); home (his knock within 1 cm and a degree) at {out_at:.0} ms{if out_at > 5.0e3 { " (not in the 6 s read)" } else { "" }}\n".as_str(),
    )
    out.push_str(
        f"  knock: head snapped back {snap:.0} deg ({snap_at:.0} ms), trunk bent back {trunk:.0} deg ({trunk_at:.0} ms)\n".as_str(),
    )
    out.push_str(
        f"  feet: {steps_taken} steps, back {feet_far * 100.0:.1} cm at most; guard knocked open {open:.0} deg at the shoulder\n".as_str(),
    )
    out.push_str(
        f"  camera: kicked {kick * 100.0:.1} cm at most, pushed in {push * 100.0:.1} cm\n".as_str(),
    )
    // (A blow that comes down: how much of its way does, and how far it bows and sinks him.)
    let down = -normalize(first.hit.way).y
    if down > 0.1 {
        out.push_str(
            f"  down: {down * 100.0:.0}% of the blow's way comes down; his head down {dropped * 100.0:.1} cm at most ({dropped_at:.0} ms), his hips {sank * 100.0:.1} cm ({sank_at:.0} ms)\n".as_str(),
        )
    }
    out
}

// ---- tests ---------------------------------------------------------------------------------------

/// The cross lands on the one struck: the striker's fist stays on what it struck through the
/// hold, and as it breaks a blow of weight 1 throws him at least as far as main's keyed reaction
/// did (its head 63 cm along the blow at its farthest, its hips 65 cm: the Kimodo clip this
/// replaced), his feet taking a few steps back to catch him and home again, and he's home in a
/// second and a half; a quarter's a touch.
@test
fn the_cross_lands_and_the_one_struck_gives_and_comes_back() {
    borrow rig = HERO.rig
    let (head, hips) = (rig.find("head"), rig.find("hips"))
    let thrown = |weight: f32| -> (f32, f32, u32, f32, f32) {
        var x = Exchange::new(Tune { weight, ..TUNED }, after: 0.2)
        let dt = 1.0 / 60.0
        var start = [vec3(0.0); 2]
        var most = [0.0; 2]
        var steps = 0
        var stepping = [false; 2]
        var fist_off = 0.0
        var home = -1.0
        for _ in 0..240 {
            x.step(dt)
            let w = pose_world(rig, x.struck_shown)
            let place = playback::placed(x.struck)
            let at = [(place * vec4(w[head].t, 1.0)).xyz, (place * vec4(w[hips].t, 1.0)).xyz]
            if x.since() < 0.0 {
                start = at
                continue
            }
            for k in 0..2 {
                most[k] = max(most[k], dot(at[k] - start[k], BLOW))
                let on = x.struck.feet[k].step > 0.0
                if on && !stepping[k] {
                    steps += 1
                }
                stepping[k] = on
            }
            if x.since() < TUNED.hold {
                let sw = pose_world(rig, x.shown)
                let fist = (x.shown_place * vec4(sw[rig.find("rightHand")].t, 1.0)).xyz
                fist_off = max(fist_off, length(fist - x.hit.at))
            }
            if !x.knock.still() {
                home = x.since() - TUNED.hold
            }
        }
        (most[0], most[1], steps, fist_off, home)
    }
    let (head1, hips1, steps1, fist1, home1) = thrown(1.0)
    assert(fist1 < 0.03, f"the fist stays on what it struck through the hold: {fist1} m off")
    assert(
        head1 >= 0.632 && hips1 >= 0.65,
        f"weight 1 throws his head {head1} m, his hips {hips1} m",
    )
    // (Over the bounce's own: it settles its feet now and then, struck or not, one to three times
    // in the window as the blow finds it in its loop, so the count over it wanders by one.)
    let (_, _, steps0, _, _) = thrown(0.0)
    let more = steps1 - steps0
    assert(
        more >= 2 && more <= 5,
        f"his feet step to catch him and back: {more} steps more than the bounce's own {steps0}",
    )
    assert(home1 > 0.5 && home1 < 1.5, f"and he's home {home1} s after the hold breaks")
    // Stood out of reach in their guards, and the cross stepping in as it's thrown, neither's
    // lead fist (held well out) comes near the other's lead fist or head but through the blow:
    // a hand's width and more between them from the idle to the striker back on his mark, but
    // for the blow's own stretch (from 0.3 s before it lands to 0.6 s after).
    var near = 9.0
    for x in played(TUNED, after: 1.0, seconds: 4.0) {
        if x.from_hit > -0.3 && x.from_hit < 0.6 {
            continue
        }
        let sw = pose_world(rig, x.shown)
        let tw = pose_world(rig, x.struck_shown)
        let at = |p: mat4, v: vec3| -> vec3 { (p * vec4(v, 1.0)).xyz }
        let sp = playback::placed(x.struck)
        let (a, ah) = (
            at(x.shown_place, sw[rig.find("leftHand")].t),
            at(x.shown_place, sw[rig.find("head")].t),
        )
        let (b, bh) = (at(sp, tw[rig.find("leftHand")].t), at(sp, tw[rig.find("head")].t))
        near = min(near, min(length(a - b), min(length(a - bh), length(b - ah))))
    }
    assert(
        near >= 0.25,
        f"a lead fist comes {near} m from the other's lead fist or head but through the blow",
    )
    let (head4, _, _, _, _) = thrown(0.25)
    assert(head4 < 0.25 * head1, f"a quarter's a touch: his head {head4} m")
}

/// Body `m`'s ankles where they're drawn (the world), as `pose` has them.
fn ankles(m: Mover, pose: Pose) -> [vec3; 2] {
    borrow rig = HERO.rig
    let w = pose_world(rig, pose)
    let place = playback::placed(m)
    [
        (place * vec4(w[rig.find("leftFoot")].t, 1.0)).xyz,
        (place * vec4(w[rig.find("rightFoot")].t, 1.0)).xyz,
    ]
}

/// `engine::playback`'s feet, on the fight's guard and walk: the guard's bounce (up on the balls
/// of its feet, its ankles 2 to 7 cm over their height at rest) plants its feet, so they hold
/// where they stand rather than slide as the guard sways them (as they did when only an ankle at
/// its height at rest was down); and a walk's swinging foot isn't taken for planted.
@test
fn the_guard_holds_its_feet_and_a_walk_swings_its_own() {
    borrow rig = HERO.rig
    let dt = 1.0 / 60.0
    let floor = |a: vec3| -> vec2 { vec2(a.x, a.z) }
    // The guard: how far each ankle goes along the floor in three seconds, drawn bare (as it was)
    // and planted.
    var m = Mover::standing(vec3(0.0), 0.0, FIGHT_GAITS)
    var bare = 0.0
    var held = 0.0
    var down = 0
    var last_bare = [vec3(0.0); 2]
    var last = [vec3(0.0); 2]
    for f in 0..180 {
        let pose = playback::step(
            mut m,
            FIGHT_GAITS,
            MOVES,
            rig,
            playback::upper_body(rig),
            vec3(0.0),
            humanoid::NONE,
            upper: false,
            how: Handling {},
            dt: dt,
        )
        let a = ankles(m, pose)
        let b = ankles(m, FIGHT_GAITS.idle.pose(f32(f + 1) * dt))
        for k in 0..2 {
            if f > 30 {
                held += length(floor(a[k]) - floor(last[k]))
                bare += length(floor(b[k]) - floor(last_bare[k]))
                if m.feet[k].down {
                    down += 1
                }
            }
            last[k] = a[k]
            last_bare[k] = b[k]
        }
    }
    // (Down most of the time: the free foot taps off the floor at the top of each bounce.)
    assert(down > 2 * 149 * 6 / 10, f"the guard's feet are down {down} of {2 * 149} foot-frames")
    assert(held < 0.5 * bare, f"planted, its ankles go {held} m along the floor; bare, {bare} m")
    // A walk: each foot swings clear (not down) for a good part of each stride.
    var w = Mover::standing(vec3(0.0), 0.0, FIGHT_GAITS)
    var up = [0; 2]
    for f in 0..180 {
        let _ = playback::step(
            mut w,
            FIGHT_GAITS,
            MOVES,
            rig,
            playback::upper_body(rig),
            vec3(0.0, 0.0, 1.0),
            humanoid::NONE,
            upper: false,
            how: Handling {},
            dt: dt,
        )
        for k in 0..2 {
            if f > 60 && !w.feet[k].down {
                up[k] += 1
            }
        }
    }
    assert(up[0] > 20 && up[1] > 20, f"a walk's feet swing: up {up[0]} and {up[1]} of 119 frames")
}

/// The exchange as it's drawn (`engine::anime`): the striker's fist drawn big on the blow and
/// through its hold, as big as `X_FIST` says, and let go after; and with the stand-in stick
/// held, the stick trailing back along its way on the drawing before the contact.
@test
fn the_fist_is_drawn_big_on_the_blow_and_the_stick_trails() {
    var most = 1.0
    var after = 1.0
    for x in played(TUNED, after: 0.2, seconds: 2.0) {
        if x.since >= 0.0 && x.since < TUNED.hold {
            most = max(most, x.drawn_big().0)
        }
        if x.since > TUNED.hold + 0.2 {
            after = max(after, x.drawn_big().0)
        }
    }
    assert(abs(most - (1.0 + X_FIST)) < 1.0e-3, f"drawn {most} times its size on the blow")
    assert(after == 1.0, f"and its own size after: {after}")
    var trailed = 0.0
    for x in played(Tune { stick: true, ..TUNED }, after: 0.2, seconds: 2.0) {
        if x.since < 0.0 && x.trail.on {
            trailed = max(trailed, length(x.trail.back))
        }
    }
    assert(trailed > 0.1, f"the stick trails {trailed} m before the contact")
}

/// A blow that comes down (the cut in both hands, on the neck, at weight 1) bows the one struck
/// and sinks him at the knees (a weight-1 blow coming straight down sinks him `Give::sink`, this
/// one comes 60% down: 7 cm), his hips down 6 cm and more with his trunk bowed over them, and
/// home.
@test
fn a_blow_that_comes_down_sinks_the_one_struck() {
    borrow rig = HERO.rig
    let t = Tune { weight: 1.0, stick: true, ..TUNED }
    let steps = played(t, after: 0.2, seconds: 4.0)
    var landed = 0
    for i in 0..steps.len() {
        if steps[i].since >= 0.0 {
            landed = i
            break
        }
    }
    let hips = rig.find("hips")
    let at = |x: Exchange| -> vec3 {
        (playback::placed(x.struck) * vec4(pose_world(rig, x.struck_shown)[hips].t, 1.0)).xyz
    }
    let y0 = at(steps[landed].clone()).y
    var sank = 0.0
    var sunk_most = 0.0
    for i in landed..steps.len() {
        sank = max(sank, y0 - at(steps[i].clone()).y)
        sunk_most = max(sunk_most, steps[i].knock.sink.x.x)
    }
    let last = steps[steps.len() - 1].clone()
    assert(-normalize(steps[landed].hit.way).y > 0.3, "the cut comes down")
    assert(sank >= 0.06, f"his hips sink {sank} m")
    assert(sunk_most > 0.06 && last.knock.sink.x.x < 0.01, f"sunk {sunk_most} m, and back up")
}
