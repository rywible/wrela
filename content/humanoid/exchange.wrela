// One exchange, for judging how a punch reads (`SHOW=28`): the cross out of the bounce lands on a
// second fighter, who takes it (a hit reaction Kimodo made from a text prompt, `REACT`). Around
// the contact: a hit-stop (both bodies held), the camera kicked once along the blow and eased
// back, and (for the anime look) an impact frame, the palette drained for a few frames.
//
// `--set X_HOLD=0 --set X_FLASH=0 --set X_KICK=0 --set X_PUSH=0` is the bare exchange.

use engine::bvh
use engine::humanoid
use engine::humanoid::{Clip, Pose}
use engine::keys::arm_to
use engine::stride
use body::HERO
use kimodo::{
    FIGHT_IDLE_M, FT_EARLY, a_end, a_hit, facing, fight_length, fight_round, guard_yaw, kimodo_take,
    legs_to, one_pose,
}

/// The hit-stop: how long both bodies hold at contact (s).
pub const X_HOLD: f32 = 0.15
/// The impact frame: how long the palette drains at contact (s).
pub const X_FLASH: f32 = 0.05
/// The camera's kick along the blow (m) and its push in (m), and how fast each eases off (s).
pub const X_KICK: f32 = 0.07
pub const X_PUSH: f32 = 0.3
pub const X_KICK_LIFE: f32 = 0.12
pub const X_PUSH_LIFE: f32 = 0.45
/// Where the blow lands on him: how far past his face's front the fist reaches (m; his head
/// is struck as the fist reaches its furthest).
pub const X_DEPTH: f32 = 0.02
/// How far into the reaction (from its own impact frame) the struck drawing is (s): the one
/// that's held through the hit-stop, already knocked back.
pub const X_INTO: f32 = 0.03
/// How long the reaction takes to give way to his guard again (s).
pub const X_BACK: f32 = 0.4
/// His bounce's phase against the striker's (s).
pub const X_PHASE: f32 = 0.31
/// The opponent's tint: what his clothes are multiplied by, and how much.
pub const X_TINT = vec4(0.3, 0.45, 0.85, 1.0)
/// Whether the opponent is there (0: the cross thrown at the air, as before), and whether both
/// bodies are drawn on twos (12 drawings a second, the camera on ones).
pub const X_FOE: u32 = 1
/// The one struck is a giant (an idol's stand-in: the same body, `X_SCALE` times as big, stood
/// in stone, struck on the shin), and the blast the blow throws off (its size, m; 0 none).
pub const X_GIANT: u32 = 1
pub const X_SCALE: f32 = 4.5
pub const X_BLAST: f32 = 3.2
pub const X_BLAST_LIFE: f32 = 0.45
pub const X_STONE = vec4(0.62, 0.66, 0.72, 2.0)
pub const STRUCK_TINT: vec4 = X_TINT * (1.0 - f32(X_GIANT)) + X_STONE * f32(X_GIANT)
pub const X_TWOS: u32 = 0

/// What the combat lab (`lab`) tunes live: the hit-stop, the impact frame, the camera's kick and
/// push, the blast's size, how hard the giant gives, whether the bodies are drawn on twos, and
/// who's struck (the fighter, or the giant). `TUNED` is what the constants above say.
pub struct Tune: Copy + Eq {
    pub hold: f32,
    pub flash: f32,
    pub kick: f32,
    pub push: f32,
    pub blast: f32,
    pub give: f32,
    pub twos: bool,
    pub giant: bool,
    pub grind: f32 = X_GRIND,
    pub pin: f32 = X_PIN,
    pub recoil: f32 = X_RECOIL,
}

pub const TUNED: Tune = Tune {
    hold: X_HOLD,
    flash: X_FLASH,
    kick: X_KICK,
    push: X_PUSH,
    blast: X_BLAST,
    give: X_GIVE,
    twos: X_TWOS == 1,
    giant: X_GIANT == 1,
}

/// Who's struck, as `t` says: where he stands, and his tint (`paint`: above 1.5 in `w`, stone).
pub fn place(t: Tune) -> mat4 {
    if t.giant { GIANT } else { FOE }
}

pub fn tint(t: Tune) -> vec4 {
    if t.giant { X_STONE } else { X_TINT }
}

/// The hit reaction: a Kimodo take, its last frame, the frame where the blow lands (the head
/// starts snapping back) and the frame where he's back on guard (30 fps).
pub const REACT_LAST: u32 = 59
pub const REACT_HIT: f32 = 8.0
pub const REACT_HOME: f32 = 50.0
pub const REACT: Clip = kimodo_take(bvh::read(embed("assets/kimodo/react.bvh")), REACT_LAST)

/// When the cross lands, on the played clock (s).
pub fn hit_at() -> f32 {
    FIGHT_IDLE_M.length() * 2.0 + a_hit() - X_EARLY
}

/// How long before the cross's full reach the fist lands (s): a blow lands with the arm still
/// bent and the fist still fast (the elbow at about 155 degrees, some 20 cm of reach left to
/// drive through), never at full extension, where the arm is locked and the fist has stopped.
pub const X_EARLY: f32 = 0.062

/// The connection: through the hit-stop the striker's body keeps driving in, slowed to `X_GRIND`
/// of its speed, while his fist stays on what it struck, so his elbow loads; his fist rides what
/// it struck back for `X_PIN` (s) after the hit-stop, then drives on through; and the blow jolts
/// back into him, his chest and head rocked back by up to `X_RECOIL` (radians).
pub const X_GRIND: f32 = 0.3
pub const X_PIN: f32 = 0.05
pub const X_RECOIL: f32 = 0.12
/// How fast the jolt rises and dies (s on his clock), and how long his fist takes to leave what
/// it struck for its own path.
pub const X_RECOIL_LIFE: f32 = 0.035
pub const X_LET_GO: f32 = 0.08

/// The clock the bodies play on: held through the hit-stop.
pub fn played_at(time: f32, t: Tune) -> f32 {
    let h = hit_at()
    let p = if time < h { time } else if time < h + t.hold { h } else { time - t.hold }
    if t.twos {
        // (On twos, a drawing lands on the contact.)
        return h + floor((p - h) * 12.0 + 1.0e-4) / 12.0
    }
    p
}

/// The striker at played time `p`: the cross, then the bounce on past the round's end.
pub fn striker(p: f32) -> Pose {
    if p < fight_length() {
        return fight_round(p)
    }
    let back = FIGHT_IDLE_M.length() * 2.0 + a_end() - FT_EARLY
    FIGHT_IDLE_M.pose((p - back) % FIGHT_IDLE_M.length())
}

fn yaw_q(a: f32) -> Quat {
    Quat::axis_angle(vec3(0.0, 1.0, 0.0), a)
}

/// Where the one struck stands: the fighter's place, or the giant's.
@fuel(2 ** 40)
pub const PLACE: mat4 = if X_GIANT == 1 { giant_place() } else { foe_place() }

/// The giant's place (`giant_place`), for the lab, which may strike either.
@fuel(2 ** 40)
pub const GIANT: mat4 = giant_place()

/// The giant's place: turned to face the striker, `X_SCALE` times as big, stood so the fist
/// lands on the front of his lead shin.
fn giant_place() -> mat4 {
    borrow rig = HERO.rig
    let h = hit_at()
    let w = stride::worlds(rig, one_pose(striker(h)), 0)
    let fist = w[rig.find("rightHand")].t
    let d = BLOW
    let me = foe_idle(h)
    let q = yaw_q(atan2(-d.x, -d.z) - guard_yaw(me))
    let k = X_SCALE
    let wf = stride::worlds(rig, one_pose(me), 0)
    // (His lead shin: the lower leg nearer the striker, at the fist's height.)
    let near = |b: str| -> vec3 { q.rotate(wf[rig.find(b)].t) * k }
    let (kl, al, kr, ar) = (
        near("leftLowerLeg"),
        near("leftFoot"),
        near("rightLowerLeg"),
        near("rightFoot"),
    )
    let lead_left = dot(kl - kr, -d) > 0.0
    let (knee, ankle) = if lead_left { (kl, al) } else { (kr, ar) }
    let t = clamp((fist.y - ankle.y) / max(knee.y - ankle.y, 0.01), 0.0, 1.0)
    let shin = ankle + (knee - ankle) * t
    let at = fist + d * (0.09 + 0.07 * k - X_DEPTH) - shin
    let r = q.rotate(vec3(k, 0.0, 0.0))
    let f = q.rotate(vec3(0.0, 0.0, k))
    mat4(vec4(r, 0.0), vec4(0.0, k, 0.0, 0.0), vec4(f, 0.0), vec4(at.x, 0.0, at.z, 1.0))
}

/// The one struck at played time `p`: the fighter, or the giant, who stands his ground.
pub fn struck(p: f32, t: Tune) -> Pose {
    if t.giant { giant(p, t.give) } else { foe(p) }
}

/// How hard the giant gives under the blow (radians at its knee): one sprung bump, no swing back
/// and forth.
pub const X_GIVE: f32 = 0.5
pub const X_GIVE_LIFE: f32 = 0.13

/// The giant at played time `p`: still, until struck; then his struck leg gives (the knee dips),
/// his hips sink and his trunk rocks back off the blow, and he settles: a sprung bump that rises
/// over `X_GIVE_LIFE` and dies away.
fn giant(p: f32, give: f32) -> Pose {
    borrow rig = HERO.rig
    let still = foe_idle(hit_at())
    let t = p - hit_at()
    if t <= 0.0 || give <= 0.0 {
        return still
    }
    let x = t / X_GIVE_LIFE
    let b = x * exp(1.0 - x)
    // His trunk rocks back off the blow.
    var pose = still
    let side = vec3(1.0, 0.0, 0.0)
    for (name, part) in [("spine", 0.35), ("chest", 0.3), ("upperChest", 0.25), ("head", 0.4)] {
        let i = rig.find(name)
        if i != humanoid::NONE {
            pose.turns[i] = Quat::axis_angle(side, -give * part * 0.6 * b).mul(pose.turns[i])
        }
    }
    // His hips sink and give back, his feet kept where they stand: the knees take it.
    let c0 = one_pose(pose)
    var c = c0.clone()
    var w = stride::worlds(rig, c0, 0)
    let (lf, rf) = (rig.find("leftFoot"), rig.find("rightFoot"))
    let feet = [w[lf].t, w[rf].t]
    let foot_q = [w[lf].q, w[rf].q]
    let g = guard_yaw(still)
    let back = -vec3(sin(g), 0.0, cos(g))
    stride::shift(mut w, (vec3(0.0, -0.05, 0.0) + back * 0.03) * b * (give / 0.22))
    legs_to(rig, mut w, feet, foot_q)
    stride::store(rig, w, mut c, 0)
    c.pose(0.0)
}

/// Whether the giant's lead leg (the one nearer the striker, struck) is his left.
@fuel(2 ** 40)
const LEAD_LEFT: bool = lead_left()

fn lead_left() -> bool {
    borrow rig = HERO.rig
    let me = foe_idle(hit_at())
    let q = yaw_q(atan2(-BLOW.x, -BLOW.z) - guard_yaw(me))
    let wf = stride::worlds(rig, one_pose(me), 0)
    let d = q.rotate(wf[rig.find("leftLowerLeg")].t) - q.rotate(wf[rig.find("rightLowerLeg")].t)
    dot(d, -BLOW) > 0.0
}

/// The blast at clock `time`: where it starts (the knuckles at contact) and how old it is (s;
/// below 0, none), and the way it goes and its size (m).
pub fn blast(time: f32, t: Tune) -> (vec4, vec4) {
    let age = time - hit_at()
    if t.blast <= 0.0 || age < 0.0 || age > X_BLAST_LIFE {
        return (vec4(0.0, 0.0, 0.0, -1.0), vec4(0.0))
    }
    (vec4(KNUCKLES, age), vec4(BLOW, t.blast))
}

@fuel(2 ** 40)
pub const KNUCKLES: vec3 = knuckles()

fn knuckles() -> vec3 {
    borrow rig = HERO.rig
    let w = stride::worlds(rig, one_pose(striker(hit_at())), 0)
    w[rig.find("rightHand")].t + BLOW * 0.09
}

/// The opponent's place: turned to face the striker and stood so the fist, at full reach, lands
/// `X_DEPTH` into his face.
@fuel(2 ** 40)
pub const FOE: mat4 = foe_place()

fn foe_place() -> mat4 {
    borrow rig = HERO.rig
    let h = hit_at()
    let w = stride::worlds(rig, one_pose(striker(h)), 0)
    let d = BLOW
    let fist = w[rig.find("rightHand")].t
    let me = foe_idle(h)
    let turn = atan2(-d.x, -d.z) - guard_yaw(me)
    let q = yaw_q(turn)
    let wf = stride::worlds(rig, one_pose(me), 0)
    let head = q.rotate(wf[rig.find("head")].t)
    // (The fist's knuckles are about 9 cm past the wrist; his face about 10 cm in front of the
    // head bone, which sits at the base of the skull.)
    let at = fist + d * (0.19 - X_DEPTH) - head
    let r = q.rotate(vec3(1.0, 0.0, 0.0))
    let f = q.rotate(vec3(0.0, 0.0, 1.0))
    mat4(vec4(r, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(f, 0.0), vec4(at.x, 0.0, at.z, 1.0))
}

pub fn foe_idle(p: f32) -> Pose {
    FIGHT_IDLE_M.pose((p + X_PHASE) % FIGHT_IDLE_M.length())
}

/// The opponent at played time `p` (in his own place, `FOE`): his bounce; struck, the reaction,
/// turned to face the way his bounce did and stood over its hips; then back to his bounce where
/// the reaction left him.
pub fn foe(p: f32) -> Pose {
    let n = HERO.rig.bones.len()
    let h = hit_at()
    if p < h {
        return foe_idle(p)
    }
    let base = HERO.rig.base
    let inv = base.inverse()
    let i0 = foe_idle(h)
    let r0 = REACT.pose(REACT_HIT / 30.0)
    let turn = yaw_q(guard_yaw(i0) - guard_yaw(r0))
    let from = base.t + base.q.rotate(r0.hips)
    let to = base.t + base.q.rotate(i0.hips)
    let placed = |q: Pose| -> Pose {
        var c = q
        let hw = base.t + base.q.rotate(c.hips)
        let o = turn.rotate(hw - from)
        c.hips = inv.t + inv.q.rotate(to + o)
        c.turns[0] = base.q.inverse().mul(turn.mul(base.q.mul(c.turns[0])))
        c
    }
    let v = p - h
    let home = (REACT_HOME - REACT_HIT) / 30.0 - X_INTO
    let r = placed(REACT.pose(REACT_HIT / 30.0 + X_INTO + min(v, home)))
    if v < home {
        return r
    }
    // (His bounce picked up where the reaction left him: shifted by how far it carried him.)
    let rh = base.t + base.q.rotate(placed(REACT.pose(REACT_HOME / 30.0)).hips)
    var off = rh - to
    off.y = 0.0
    // (Then he steps back in to where he stood, so the next blow finds him.)
    off *= 1.0 - smoothstep(home, home + STEP_IN, v)
    var b = foe_idle(p)
    b.hips = b.hips + inv.q.rotate(off)
    humanoid::blend(r, b, smoothstep(0.0, X_BACK, v - home), n)
}

/// How long he takes to step back in to his mark once his reaction's done (s).
pub const STEP_IN: f32 = 0.6

/// How long after the contact he's back on his mark (s).
pub fn reaction_home() -> f32 {
    (REACT_HOME - REACT_HIT) / 30.0 - X_INTO + STEP_IN
}

/// The camera at clock `time`: its kick along the blow (m), and how far it's pushed in (m).
pub fn camera(time: f32, tune: Tune) -> (f32, f32) {
    let h = hit_at()
    // (On twos it steps with the bodies' drawings, held through the hit-stop: one cadence for
    // the whole frame.)
    let at = if tune.twos {
        played_at(time, tune) - h + (if time >= h + tune.hold { tune.hold } else { 0.0 })
    } else {
        time - h
    }
    // (Dead still through the impact frame; it moves as the colour comes back.)
    let t = at - tune.flash
    if t < 0.0 {
        return (0.0, 0.0)
    }
    let kick = tune.kick * smoothstep(0.0, 0.1, t) * exp(-t / X_KICK_LIFE)
    let push = tune.push * smoothstep(0.0, 0.14, t) * exp(-t / X_PUSH_LIFE)
    (kick, push)
}

/// How kinetic the moment is at clock `time`: the impact frame drains the palette.
pub fn flash(time: f32, tune: Tune) -> f32 {
    let t = time - hit_at()
    if t >= 0.0 && t < tune.flash { 1.0 } else { 0.0 }
}

/// The way the blow travels, along the ground: the way the cross reaches (at its full reach).
@fuel(2 ** 40)
pub const BLOW: vec3 = blow()

fn blow() -> vec3 {
    borrow rig = HERO.rig
    let w = stride::worlds(rig, one_pose(striker(hit_at() + X_EARLY)), 0)
    var reach = w[rig.find("rightHand")].t - w[rig.find("hips")].t
    reach.y = 0.0
    normalize(reach)
}

/// Where the blow lands, for checking: the fist's height, his head's height, and the fist's
/// distance past his head's centre along the blow (m), at contact.
pub fn contact() -> vec3 {
    borrow rig = HERO.rig
    let h = hit_at()
    let w = stride::worlds(rig, one_pose(striker(h)), 0)
    let fist = w[rig.find("rightHand")].t
    let wf = stride::worlds(rig, one_pose(foe_idle(h)), 0)
    let head = (FOE * vec4(wf[rig.find("head")].t, 1.0)).xyz
    vec3(fist.y, head.y, dot(fist - head, BLOW))
}

/// (Measuring: the fist along the blow, and its height, around the contact.)
pub fn fist_track() -> String {
    borrow rig = HERO.rig
    var out = String::new()
    let h = hit_at()
    for k in 0..24 {
        let t = h - 0.14 + f32(k) * 0.01
        let w = stride::worlds(rig, one_pose(striker(t)), 0)
        let f = w[rig.find("rightHand")].t
        let e = w[rig.find("rightLowerArm")].t
        let s = w[rig.find("rightUpperArm")].t
        let ang = acos(clamp(dot(normalize(s - e), normalize(f - e)), -1.0, 1.0))
        out.push_str(
            f"{t - h:.2}: along {dot(f, BLOW):.3} y {f.y:.3} elbow {ang * 57.3:.0}\n".as_str(),
        )
    }
    out
}

/// The striker's clock at clock `time`: through the hit-stop his body grinds on, slowed to
/// `t.grind` of its speed, and after it he's that much further on than the one he struck.
pub fn played_striker(time: f32, t: Tune) -> f32 {
    let h = hit_at()
    if t.twos {
        return played_at(time, t)
    }
    if time < h {
        time
    } else if time < h + t.hold {
        h + (time - h) * t.grind
    } else {
        time - t.hold * (1.0 - t.grind)
    }
}

/// Where the blow lands on him, and which bone carries it: his face (his head's), or the giant's
/// lead shin.
fn struck_bone(t: Tune) -> u32 {
    borrow rig = HERO.rig
    if !t.giant {
        return rig.find("head")
    }
    if LEAD_LEFT { rig.find("leftLowerLeg") } else { rig.find("rightLowerLeg") }
}

/// How far the place he was struck has moved since the contact, by played time `pf` (his clock).
fn struck_moved(pf: f32, t: Tune) -> vec3 {
    borrow rig = HERO.rig
    let h = hit_at()
    if pf <= h {
        return vec3(0.0)
    }
    let b = struck_bone(t)
    let at = place(t)
    let w0 = stride::worlds(rig, one_pose(struck(h, t)), 0)
    let w1 = stride::worlds(rig, one_pose(struck(pf, t)), 0)
    (at * vec4(w1[b].t - w0[b].t, 0.0)).xyz
}

/// The striker at his clock `ps` (the one struck at his clock `pf`), connecting: from the
/// contact his fist stays on the place it struck, riding it back as it gives, while his body
/// drives on (his elbow loads); then it leaves it for its own path, driving through; and the
/// blow rocks his chest and head back, a sprung bump that rises and dies.
pub fn striker_hit(ps: f32, pf: f32, t: Tune) -> Pose {
    let base = striker(ps)
    let h = hit_at()
    let since = ps - h
    let held = t.hold * t.grind
    let free = held + t.pin
    if since <= 0.0 || since > free + X_LET_GO + 4.0 * X_RECOIL_LIFE {
        return base
    }
    borrow rig = HERO.rig
    var pose = base
    // The jolt back up the arm into his trunk and head.
    if t.recoil > 0.0 {
        let x = since / X_RECOIL_LIFE
        let b = x * exp(1.0 - x)
        let side = vec3(1.0, 0.0, 0.0)
        for (name, part) in [
            ("chest", 0.3),
            ("upperChest", 0.4),
            ("rightShoulder", 0.6),
            ("head", 0.5),
        ] {
            let i = rig.find(name)
            if i != humanoid::NONE {
                pose.turns[i] = Quat::axis_angle(side, -t.recoil * part * b).mul(pose.turns[i])
            }
        }
    }
    if since > free + X_LET_GO {
        return pose
    }
    // His fist on what it struck, then let go.
    let c0 = one_pose(pose)
    var c = c0.clone()
    var w = stride::worlds(rig, c0, 0)
    let hand = rig.find("rightHand")
    let on = KNUCKLES - BLOW * 0.09 + struck_moved(pf, t)
    let own = w[hand].t
    let k = 1.0 - smoothstep(free, free + X_LET_GO, since)
    let want = mix(own, on, k)
    arm_to(rig, mut w, 1, want)
    stride::store(rig, w, mut c, 0)
    c.pose(0.0)
}
