// The slash: a sword cut written from a source and followed through. Quaternius's `Sword_Attack`
// (Universal Animation Library, CC0; `body::SWORD_ATTACK_RAW`) is the source, read whole on the
// sheets: a one-handed cut from a guard low at the right hip, loaded up over the right shoulder,
// brought over the top and down through ahead at shoulder height, followed through to a finish
// low on the far side, held a beat, and swung back round to the guard.
//
// The written move's keys are read off the source at its own moments (`keys::key_of`): its poses
// are the source's at those moments, so it plays as the source does, within a stated miss
// (`the_slash_plays_as_its_source_does`). And it steps in (`STEP`), as an attack does in the
// fight: the source's feet already leave the floor together as it goes over the top and land
// after the blow, so the step is laid in while they're off it, and they land a step on.

use engine::humanoid::{Clip, Rigid, frame_world}
use engine::keys
use engine::keys::{BARE, Key, LINEAR, SETTLE, SMOOTH, SNAP, Wield}
use engine::written::{Beats, Chain, Taste, Written}
use engine::playback::Move
use engine::end::End
use body::HERO
use stick::{BOTH, STICK}

/// Whether the second hand holds the grip too (`stick::BOTH`), or the cut's one-handed, as its
/// source is: a choice, asked of Ryan; as the source does until he answers.
pub const BOTH_HANDS: bool = false

/// What the slash holds, as `BOTH_HANDS` says.
@fuel(2 ** 40)
pub const WIELD: Wield = if BOTH_HANDS { BOTH } else {
    Wield { held: STICK, off: BARE.off, both: false }
}

/// The source's moments (its frames, at its own 30 a second), and how the body comes into each:
/// eased into and out of the beat in the load (the source's hand gathers speed and slows into it),
/// gathering speed into the swing, evenly through the moments it's moving, so it never stops where
/// the source doesn't, and settling into the finish and home:
/// the guard; the load, held a beat; setting off; over the top; through the target (where it
/// would meet a foe, its hand fastest); down through ahead and round; the finish, low on the far
/// side; held there; swung back up and round; home in the guard.
pub const FRAMES: [u32; 15] = [0, 5, 9, 10, 11, 12, 13, 14, 15, 23, 25, 27, 30, 33, 38]
pub const EASES: [u32; 15] = [
    SMOOTH,
    SMOOTH,
    SNAP,
    LINEAR,
    LINEAR,
    LINEAR,
    LINEAR,
    LINEAR,
    SETTLE,
    SMOOTH,
    SNAP,
    LINEAR,
    LINEAR,
    LINEAR,
    SETTLE,
]
/// Through the target: the source's frame 12, 0.40 s.
pub const CONTACT_KEY: u32 = 5

/// The source's pose at frame `f` (its bones in the body's space).
fn source_at(f: u32) -> [Rigid; 64] {
    borrow rig = HERO.rig
    let c = body::SWORD_ATTACK_RAW.clone()
    let v = frame_world(rig, c.turns, f, rig.base.t + rig.base.q.rotate(c.hips[f]))
    var out = [Rigid::identity(); 64]
    for b in 0..v.len() {
        out[b] = v[b]
    }
    out
}

/// Through the swing (between these of `FRAMES`, the setting off to the finish) the source's sword
/// hand goes round the shoulder on an arc, 1.6 to 2.2 m a frame at its 30 a second. A key mixes its
/// hilt's place straight from one key's to the next's, a chord that cuts in by the shoulder, which
/// folds the arm to reach it (the elbow 124 degrees from straight at 0.38 s, where the source's is
/// 30). So a key is put half way between each two of them, read off the source as it's played
/// there.
pub const SWING: [u32; 6] = [3, 4, 5, 6, 7, 8]

/// How many keys: the source's moments, and one half way between each two through the swing.
pub const KEYS: u32 = 21

/// The keys read off the source (`source_keys`), once, as the package is built: what the slash is
/// written from. A solve follows the slash through these, not through the source clip, which it
/// can't (a clip's frames are in a `Vec`: docs/toolchain.md, "A solve follows arrays").
@fuel(2 ** 40)
pub const SOURCE_KEYS: [Key; KEYS] = source_keys()

/// The keys read off the source at its moments, and the swing's half-way keys.
pub fn source_keys() -> [Key; KEYS] {
    borrow rig = HERO.rig
    let fps = body::SWORD_ATTACK_RAW.fps
    var read = [Key { at: 0.0, fists: [vec3(0.0); 2], feet: [vec4(0.0); 2] }; 15]
    for i in 0..15 {
        read[i] = keys::key_of(rig, source_at(FRAMES[i]), f32(FRAMES[i]) / fps, EASES[i], WIELD)
    }
    var out = [Key { at: 0.0, fists: [vec3(0.0); 2], feet: [vec4(0.0); 2] }; KEYS]
    var n = 0
    for i in 0..15 {
        var half = false
        for k in SWING {
            if k == i {
                half = true
            }
        }
        if half {
            // The source half way between its two frames, each joint turned half way from one to
            // the next (`Clip::pose`), so its hand goes round, not along the chord. (Its curve
            // through the frames either side, `smooth_pose`, put a hitch in the striking point:
            // 9.2 cm a frame then 45.7 at 0.35 s, the source's frames 19.2 then 28.8.)
            let at = (read[i - 1].at + read[i].at) * 0.5
            let w = engine::humanoid::pose_world(rig, body::SWORD_ATTACK_RAW.pose(at))
            out[n] = keys::key_of(rig, w, at, LINEAR, WIELD)
            n += 1
        }
        out[n] = read[i]
        n += 1
    }
    out
}

/// How far the slash steps in (m, ahead): the fight's step for a strike, 32 of its units (mmo/
/// combat's `sim::TRAVEL`), all of it by the blow, as the stepping cross's is.
pub const STEP: f32 = 0.5

/// When the source's feet leave the floor together (s): half way between its frames 9 and 10,
/// 0.083 s before the blow (the footwork read, `wrela tool moves -- --sheet`). Both are off it
/// from then till after the blow (the right lands 0.017 s after it, the left 0.050).
pub const LEAVES: f32 = 9.5 / 30.0

/// `k`, the source's keys, stepping in: each carried on by as much of `STEP` as is done by its
/// moment, the step taken evenly from when the feet leave the floor (`LEAVES`) to the blow, so
/// it's laid in while neither foot is down. The keys before stand where the source does; those
/// after, the whole step on, its feet with them, so the feet land a step on and nothing slides.
pub fn stepped(k: [Key; KEYS]) -> [Key; KEYS] {
    var out = k
    for i in 0..KEYS {
        let done = clamp((k[i].at - LEAVES) / (CONTACT - LEAVES), 0.0, 1.0)
        out[i] = keys::shifted(k[i], vec3(0.0, 0.0, STEP * done))
    }
    out
}

/// The slash as written, the parts on `chain`'s clocks.
pub fn slash_with(chain: Chain) -> Written<KEYS> {
    Written { keys: stepped(SOURCE_KEYS), taste: Taste { chain }, end: STRIKE }
}

/// When the slash goes through its target (s): the source's frame 12, where its sword hand is
/// fastest, as a cut lands.
pub const CONTACT: f32 = 0.40

/// Where along the blade it strikes (0 the hilt, 1 the tip).
pub const ALONG: f32 = 0.75

/// What it strikes with.
@fuel(2 ** 40)
pub const STRIKE: End = STICK.at(ALONG)

/// The slash as written: its keys read off the source, the parts on no chain of their own. The
/// source carries its own order from the hips out to the blade in its timing; a fighter's chain
/// laid over it (the fists', `taste`) lags the arm behind its own moments (52.6 cm at the contact,
/// `the_slash_plays_as_its_source_does`).
pub fn slash() -> Written<KEYS> {
    Written { keys: stepped(SOURCE_KEYS), taste: Taste { chain: Chain {} }, end: STRIKE }
}

/// The slash as the fight plays it at its own beats: its contact at `CONTACT`, its follow-through
/// and finish the active frames' and the recovery's.
@fuel(2 ** 40)
pub const SLASH: Move = slash_at(
    Beats { windup: CONTACT, active: 0.1, recovery: slash().length() - CONTACT - 0.1 },
)

/// The slash as a game plays it at `beats` (`engine::written::Written::played`): at 60 a second,
/// the sword hand closed on its grip, its blade through its target on the frame the rules hit.
/// The one way the slash is played: the lab's (`SLASH`), the game's (mmo/game's `bodies`).
pub fn slash_at(beats: Beats) -> Move {
    slash().played(HERO.rig, CONTACT, beats, fps: 60.0, fist: 2.0)
}

/// The slash without its step (`stepped`), as a game plays it at `beats`: cut where it stands, for
/// a fight whose rules don't carry a striker.
pub fn standing_at(beats: Beats) -> Move {
    Written { keys: SOURCE_KEYS, ..slash() }.played(
        HERO.rig,
        CONTACT,
        beats,
        fps: 60.0,
        fist: 2.0,
    )
}

/// The source as the cut sheet reads it (`engine::cut`): the bands the slash's spec holds it to
/// (spec.wrela's `slash_spec`), read once, as it's built, each a number on its own: a solve
/// follows the spec through numbers, not through the sheet's reading, which holds its samples in
/// `Vec`s. How high the sword hand is on contact, and how far ahead of the chest (m); how upright
/// the blade stands at most on the way over (degrees above level).
@fuel(2 ** 40)
pub const SOURCE_HAND_UP: f32 = source_cut().hand_y
@fuel(2 ** 40)
pub const SOURCE_HAND_AHEAD: f32 = source_cut().hand_ahead
@fuel(2 ** 40)
pub const SOURCE_UPRIGHT: f32 = source_cut().upright

fn source_cut() -> engine::cut::Cut {
    engine::cut::cut(SOURCE.clip.clone(), HERO.rig, STICK, CONTACT)
}

/// The source's sword hand's fastest over its own frames' steps from setting off to the blow
/// (m/s, its frames 6 to 12 at 30 a second): what the slash's spec holds its hand to, read alike.
@fuel(2 ** 40)
pub const SOURCE_HAND: f32 = source_hand()

fn source_hand() -> f32 {
    let hand = HERO.rig.find("rightHand")
    var fastest = 0.0
    for f in 7..13 {
        fastest = max(fastest, length(source_at(f)[hand].t - source_at(f - 1)[hand].t) * 30.0)
    }
    fastest
}

/// The source itself on the body, held in place, its hands made fists: what the slash is judged
/// against.
@fuel(2 ** 40)
pub const SOURCE: Move = fists::in_place(
    engine::stride::curled_hands(body::SWORD_ATTACK_RAW.clone(), HERO.rig, 2.0),
)

/// Whether key `i` (of `source_keys`) is one read off the source, not a half-way one, and which of
/// `FRAMES` it is.
fn keys_read(i: u32) -> bool {
    var n = 0
    for f in 0..15 {
        var half = false
        for k in SWING {
            if k == f {
                half = true
            }
        }
        if half {
            if n == i {
                return false
            }
            n += 1
        }
        if n == i {
            return true
        }
        n += 1
    }
    false
}

fn read_index(i: u32) -> u32 {
    var n = 0
    for f in 0..15 {
        var half = false
        for k in SWING {
            if k == f {
                half = true
            }
        }
        if half {
            n += 1
        }
        if n == i {
            return f
        }
        n += 1
    }
    0
}

// ---- tests ---------------------------------------------------------------------------------------

/// The slash plays as its source does, its step aside (`stepped`). Its keys pose within 14 cm of the source's own frames at
/// worst (the finish's deep twist, whose spine bends as one trunk turn shared up the spine can't
/// follow); between them, every frame of the source, its joints within 18 cm and its blade's tip
/// within 25 cm. On the cut sheet it reads as the source: the hand as fast (within 15%), the hands where the source's are on contact (within 3 cm), the blade as upright on
/// the way over; and it's followed through to a finish low on the far side, held a beat (the
/// sword hand left of the body and below 70 cm from 0.50 s to 0.75 s).
@test
fn the_slash_plays_as_its_source_does() {
    borrow rig = HERO.rig
    let c = body::SWORD_ATTACK_RAW.clone()
    let names = [
        "hips",
        "head",
        "leftHand",
        "rightHand",
        "leftLowerArm",
        "rightLowerArm",
        "leftFoot",
        "rightFoot",
    ]
    let m = Written { keys: SOURCE_KEYS, ..slash() }
    var worst = 0.0
    var tip = 0.0
    for f in 0..c.frames {
        let s = source_at(f)
        let w = m.world(rig, f32(f) / c.fps)
        for n in names {
            worst = max(worst, length(w[rig.find(n)].t - s[rig.find(n)].t))
        }
        let (_, ts) = STICK.ends_at(s[rig.find("rightHand")])
        let (_, tw) = STICK.ends_at(w[rig.find("rightHand")])
        tip = max(tip, length(ts - tw))
    }
    var keyed = 0.0
    for i in 0..KEYS {
        if !keys_read(i) {
            continue
        }
        let s = source_at(FRAMES[read_index(i)])
        let w = engine::humanoid::pose_world(rig, keys::posed(rig, m.keys[i]))
        for n in names {
            keyed = max(keyed, length(w[rig.find(n)].t - s[rig.find(n)].t))
        }
    }
    std::io::print(
        f"the slash against its source: keys within {keyed * 100.0:.1} cm, its joints {worst * 100.0:.1} cm, its tip {tip * 100.0:.1} cm",
    )
    assert(keyed <= 0.14 && worst <= 0.18 && tip <= 0.25, "the slash plays as its source does")
    let ours = engine::cut::cut(SLASH.clip, rig, STICK, CONTACT)
    let theirs = engine::cut::cut(SOURCE.clip, rig, STICK, CONTACT)
    assert(
        // (Within 15%: through the swing ours goes round the arc between the source's frames,
        // which sample it at 30 a second and read it as the chord between them.)
        abs(ours.hand_fastest - theirs.hand_fastest) <= 0.15 * theirs.hand_fastest,
        f"the hand {ours.hand_fastest} m/s, the source's {theirs.hand_fastest}",
    )
    assert(
        abs(ours.hand_y - theirs.hand_y) <= 0.03 &&
            abs(ours.hand_ahead - theirs.hand_ahead) <= 0.03,
        "the hands where the source's are on contact",
    )
    assert(
        abs(ours.upright - theirs.upright) <= 5.0,
        f"the blade {ours.upright} deg up on the way over, the source's {theirs.upright}",
    )
    var t = 0.50
    while t <= 0.75 {
        let h = m.world(rig, t)[rig.find("rightHand")].t
        assert(
            h.x > 0.2 && h.y < 0.7,
            f"at {t} s the sword hand at {h}: the finish, low on the far side",
        )
        t += 1.0 / 60.0
    }
}

/// The slash steps in as the fight's strikes do: the body carried `STEP` by the blow and no
/// further, none of it before its feet leave the floor; its feet leaving and landing as they do
/// without the step (each within a frame), carried a step on by the time they land, so a foot
/// slides no more while down than without it (each within 0.5 cm). (Against the fit without its
/// step, not the source: the source's back foot goes back 96 cm skimming the floor, which the
/// footwork read takes for a foot that stays down.)
@test
fn the_slash_steps_in_as_its_feet_leave_the_floor() {
    borrow rig = HERO.rig
    let m = slash()
    let at_blow = m.root(rig, CONTACT).z
    let at_end = m.root(rig, m.length()).z
    assert(
        abs(at_blow - STEP) < 1.0e-4 && abs(at_end - STEP) < 1.0e-4,
        f"it steps {at_blow} m by the blow, {at_end} in all",
    )
    assert(m.root(rig, LEAVES).z < 1.0e-4, "nothing of the step before the feet leave the floor")
    let standing = standing_at(
        Beats { windup: CONTACT, active: 0.1, recovery: slash().length() - CONTACT - 0.1 },
    )
    let read = |mv: Move| -> engine::footwork::Footwork {
        engine::footwork::footwork(mv.clip, mv.root, rig, CONTACT, 0.0, mv.clip.length())
    }
    let (ours, without) = (read(SLASH), read(standing))
    std::io::print(f"stepping {ours.text()}")
    std::io::print(f"standing {without.text()}")
    for i in 0..2 {
        assert(
            abs(ours.leaves[i] - without.leaves[i]) <= 0.017 &&
                abs(ours.lands[i] - without.lands[i]) <= 0.017,
            f"foot {i} leaves and lands as it does standing",
        )
        assert(
            ours.slide[i] <= without.slide[i] + 0.005,
            f"foot {i} slides {ours.slide[i]} m, standing {without.slide[i]}",
        )
    }
}
