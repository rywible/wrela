// The body and its clips, each converted when the program is built (`engine::humanoid`): the
// Quaternius body on VRM's bones, its T-pose, an idle, a walk, a run, walking turns, a jog, and
// ACCAD's mocap walks and runs.

use engine::humanoid
use engine::humanoid::{
    ACCAD, Clip, HUNDRED_STYLE, HUNDRED_STYLE_ARM, Humanoid, NO_NAMES, Paint, Retarget, Take,
    UNREAL,
}
use engine::bvh
use engine::cleanup
use engine::cleanup::Cleanup
use engine::stride
use engine::stride::Gait

/// The body's colours, sRGB: its skin, its hair and brows, its eyes.
pub const SKIN = vec3(0.86, 0.66, 0.52)
pub const HAIR = vec3(0.16, 0.11, 0.09)
pub const EYES = vec3(0.12, 0.09, 0.08)

/// Quaternius's Superhero Male (assets/superhero_male.glb.LICENSE.txt).
@fuel(2 ** 40)
pub const HERO: Humanoid = humanoid::import(
    embed("assets/superhero_male.glb"),
    UNREAL,
    [
        Paint { material: "MI_Hair_1", albedo: HAIR },
        Paint { material: "MI_Eyes", albedo: EYES },
        Paint { material: "MI_Superhero_Male", albedo: SKIN },
    ],
    fallback: SKIN,
)

/// Its bind pose: a T-pose.
pub const T_POSE: Clip = humanoid::rest_clip(HERO.rig.clone())

/// Quaternius's idle (assets/ual1.glb.LICENSE.txt), on its own mannequin, retargeted.
@fuel(2 ** 40)
pub const IDLE_RAW: Clip = humanoid::retarget(
    humanoid::take_of_gltf(embed("assets/ual1.glb"), "Idle_Loop", UNREAL, fps: 30.0),
    HERO.rig.clone(),
    Retarget { looped: true },
)

/// A 100STYLE walk (assets/neutral_fw.bvh.LICENSE.txt): the stride of the take that loops
/// best, turned to walk ahead, made human (`engine::stride`: its feet rolling heel to toe and
/// planted, its pelvis, spine, head and arms as people carry them, its arms hung as the idle
/// carries them, its hands loose; the take has no fingers).
@fuel(2 ** 40)
pub const WALK: Clip = stride::loose_hands(
    stride::humanised(WALK_RAW.clone(), IDLE_RAW.clone(), HERO.rig.clone(), Gait {}),
    HERO.rig.clone(),
)

/// The walk as the take has it, retargeted and looped.
@fuel(2 ** 40)
pub const WALK_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/neutral_fw.bvh")),
        HUNDRED_STYLE,
        HUNDRED_STYLE_ARM,
        from: 0,
        to: 138,
    ).looped(shortest: 60, longest: 110),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true },
)

/// A 100STYLE run (assets/neutral_fr.bvh.LICENSE.txt), the stride that loops best, turned to
/// run ahead.
@fuel(2 ** 40)
pub const RUN_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/neutral_fr.bvh")),
        HUNDRED_STYLE,
        HUNDRED_STYLE_ARM,
        from: 0,
        to: 78,
    ).looped(shortest: 30, longest: 76),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true },
)

/// 100STYLE's walking turns (assets/neutral_tr1.bvh.LICENSE.txt), as they come.
@fuel(2 ** 40)
pub const TURNS_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/neutral_tr1.bvh")),
        HUNDRED_STYLE,
        HUNDRED_STYLE_ARM,
        from: 0,
        to: 180,
    ),
    HERO.rig.clone(),
    Retarget { carried: true },
)

/// Quaternius's jog (assets/ual1.glb.LICENSE.txt), on its own mannequin, retargeted: it jogs in
/// place.
@fuel(2 ** 40)
pub const JOG_RAW: Clip = humanoid::retarget(
    humanoid::take_of_gltf(embed("assets/ual1.glb"), "Jog_Fwd_Loop", UNREAL, fps: 30.0),
    HERO.rig.clone(),
    Retarget { looped: true },
)

/// The idle, the run, the walking turns and the jog, each cleaned up as every clip is
/// (`engine::cleanup`), and nothing more.
@fuel(2 ** 40)
pub const IDLE: Clip = cleanup::cleaned(IDLE_RAW.clone(), HERO.rig.clone(), Cleanup {})
@fuel(2 ** 40)
pub const RUN: Clip = cleanup::cleaned(RUN_RAW.clone(), HERO.rig.clone(), Cleanup {})
@fuel(2 ** 40)
pub const TURNS: Clip = cleanup::cleaned(TURNS_RAW.clone(), HERO.rig.clone(), Cleanup {})
@fuel(2 ** 40)
pub const JOG: Clip = cleanup::cleaned(JOG_RAW.clone(), HERO.rig.clone(), Cleanup {})

/// ACCAD's Open Motion Project takes (assets/accad_*.bvh.LICENSE.txt): each actor's first frame
/// standing (of their stand-to-walk), which their takes are rested as, and a walk and a run,
/// each the stride that loops best, turned to go ahead, retargeted (their feet as flat as the
/// body's own, `Retarget::stood`, and their neck and head carried as its own on average: Male
/// 1 stands looking about 20° aside, which his walk and run would otherwise keep) and cleaned
/// up as every clip is.
@fuel(2 ** 40)
pub const ACCAD_M1_STAND: Take = humanoid::take_of_bvh(
    bvh::read(embed("assets/accad_male1_stand_to_walk.bvh")),
    ACCAD,
    NO_NAMES,
    from: 0,
    to: 0,
)
@fuel(2 ** 40)
pub const ACCAD_M2_STAND: Take = humanoid::take_of_bvh(
    bvh::read(embed("assets/accad_male2_stand_to_walk.bvh")),
    ACCAD,
    NO_NAMES,
    from: 0,
    to: 0,
)
@fuel(2 ** 40)
pub const ACCAD_M1_WALK_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/accad_male1_walk.bvh")),
        ACCAD,
        NO_NAMES,
        from: 0,
        to: 182,
    )
        .rested_as(ACCAD_M1_STAND.clone(), 0)
        .looped(shortest: 28, longest: 56),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true, stood: true },
)
@fuel(2 ** 40)
pub const ACCAD_M1_RUN_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/accad_male1_run.bvh")),
        ACCAD,
        NO_NAMES,
        from: 0,
        to: 45,
    )
        .rested_as(ACCAD_M1_STAND.clone(), 0)
        .looped(shortest: 16, longest: 30),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true, stood: true },
)
@fuel(2 ** 40)
pub const ACCAD_M2_WALK_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/accad_male2_walk.bvh")),
        ACCAD,
        NO_NAMES,
        from: 0,
        to: 530,
    )
        .rested_as(ACCAD_M2_STAND.clone(), 0)
        .looped(shortest: 110, longest: 220),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true, stood: true },
)
@fuel(2 ** 40)
pub const ACCAD_M2_RUN_RAW: Clip = humanoid::retarget(
    humanoid::take_of_bvh(
        bvh::read(embed("assets/accad_male2_run.bvh")),
        ACCAD,
        NO_NAMES,
        from: 0,
        to: 57,
    )
        .rested_as(ACCAD_M2_STAND.clone(), 0)
        .looped(shortest: 16, longest: 30),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true, stood: true },
)
@fuel(2 ** 40)
pub const ACCAD_M1_WALK: Clip = cleanup::cleaned(
    ACCAD_M1_WALK_RAW.clone(),
    HERO.rig.clone(),
    Cleanup {},
)
@fuel(2 ** 40)
pub const ACCAD_M1_RUN: Clip = cleanup::cleaned(
    ACCAD_M1_RUN_RAW.clone(),
    HERO.rig.clone(),
    Cleanup {},
)
@fuel(2 ** 40)
pub const ACCAD_M2_WALK: Clip = cleanup::cleaned(
    ACCAD_M2_WALK_RAW.clone(),
    HERO.rig.clone(),
    Cleanup {},
)
@fuel(2 ** 40)
pub const ACCAD_M2_RUN: Clip = cleanup::cleaned(
    ACCAD_M2_RUN_RAW.clone(),
    HERO.rig.clone(),
    Cleanup {},
)
