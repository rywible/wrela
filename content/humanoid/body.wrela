        NO_NAMES,
        from: 0,
        to: 182,
    )
        .rested_as(ACCAD_M1_STAND.clone(), 0)
        .looped(shortest: 28, longest: 56),
    HERO.rig.clone(),
    Retarget { face_ahead: true, looped: true, carried: true, stood: true },
)
@fuel(2 ** 40)
pub const ACCAD_M1_RUN_RAW: Clip = humanoid::retarget(
