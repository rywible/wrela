// ---- the moves a game plays (`engine::playback`) ------------------------------------------

/// The idle, and ACCAD Male 2's walk and run (Ryan's pick of the walks; his run is a real
/// 4 m/s run), in place, their footfalls marked, and his start and stop: the body's gaits.
@fuel(2 ** 40)
pub const GAITS: Gaits = gaits_of(
    IDLE.clone(),
    ACCAD_M2_WALK.clone(),
    ACCAD_M2_RUN.clone(),
    ACCAD_M2_START.clone(),
    ACCAD_M2_STOP.clone(),
)

/// The same gaits from the moves written in Wrela (content/moves): no capture read.
@fuel(2 ** 40)
pub const GAITS_CODE: Gaits = gaits_of(
    moves::idle::IDLE.clip(HERO.rig.clone(), IDLE.fps),
    moves::walk::WALK.clip(HERO.rig.clone(), ACCAD_M2_WALK.fps),
    moves::run::RUN.clip(HERO.rig.clone(), ACCAD_M2_RUN.fps),
    moves::start::START.clip(HERO.rig.clone(), ACCAD_M2_START.fps),
    moves::stop::STOP.clip(HERO.rig.clone(), ACCAD_M2_STOP.fps),
)

/// Hakuro's gaits (content/hakuro's `manner`): his stand, the walk, and his sprint (the run's
/// stride at a sprint's cadence), the moves written in Wrela; the same start and stop.
@fuel(2 ** 40)
pub const HAKURO_GAITS: Gaits = gaits_of(
    hakuro::manner::stand(HERO.rig.clone()),
    moves::walk::WALK.clip(HERO.rig.clone(), ACCAD_M2_WALK.fps),
    hakuro::manner::sprint().clip(HERO.rig.clone(), ACCAD_M2_RUN.fps),
    moves::start::START.clip(HERO.rig.clone(), ACCAD_M2_START.fps),
    moves::stop::STOP.clip(HERO.rig.clone(), ACCAD_M2_STOP.fps),
)

/// The body's gaits from an idle, a walk and a run (each looped, in place: their footfalls
/// marked), a start and a stop.
fn gaits_of(idle: Clip, walk: Clip, run: Clip, start: Clip, stop: Clip) -> Gaits {
    let rig = HERO.rig.clone()
    Gaits::of(
        playback::with_steps(playback::moved(idle, rig.clone()), rig.clone()),
        playback::with_steps(playback::moved(walk, rig.clone()), rig.clone()),
        playback::with_steps(playback::moved(run, rig.clone()), rig.clone()),
        playback::moved(start, rig.clone()),
        playback::moved(stop, rig.clone()),
        rig,
    )
}

/// A player's attack's frames in the fight, at its 60 a second: windup (the tell), active (when
/// it hits), recovery (committed and open): mmo/combat/sim.wrela's `ATTACK_WINDUP`,
/// `ATTACK_ACTIVE` and `ATTACK_RECOVERY`.
pub const HZ: f32 = 60.0
pub const ATTACK_WINDUP: u32 = 10
pub const ATTACK_ACTIVE: u32 = 4
pub const ATTACK_RECOVERY: u32 = 14

/// The punch held to its feet (`cleanup::KEYED`), in place.
@fuel(2 ** 40)
pub const PUNCH_KEYED: Move = playback::moved(
    cleanup::cleaned(PUNCH_RAW.clone(), HERO.rig.clone(), cleanup::KEYED),
    HERO.rig.clone(),
)

/// The punch fitted to the attack's frames: its fist at its fastest when the fight says it hits.
@fuel(2 ** 40)
pub const PUNCH: Move = punched(PUNCH_KEYED.clone())

/// A punch (in place, held to its feet) fitted to the attack's frames.
fn punched(keyed: Move) -> Move {
    playback::timed(
        keyed.clone(),
        playback::strike_of(keyed, HERO.rig.clone(), "rightHand"),
        ATTACK_WINDUP,
        ATTACK_ACTIVE,
        ATTACK_RECOVERY,
        HZ,
    )
}

/// The roll, at its own pace, its keys eased into each other (`playback::eased`: they whip
/// from one to the next): Quaternius keyed it in place, so gameplay carries it ahead
/// (`ROLL_SPEED`, m/s), as the fight's dodge does.
pub const ROLL_SPEED: f32 = 2.4
@fuel(2 ** 40)
pub const ROLL: Move = rolled(
    cleanup::cleaned(ROLL_RAW.clone(), HERO.rig.clone(), cleanup::KEYED),
)

/// A roll (in place, held to its feet) eased and carried ahead.
fn rolled(clip: Clip) -> Move {
    playback::pushed(playback::eased(playback::moved(clip, HERO.rig.clone()), 2), ROLL_SPEED)
}

/// The one-offs a body acts, by index: the punch (`ACT_PUNCH`), the roll (`ACT_ROLL`).
pub const ACT_PUNCH: u32 = 0
pub const ACT_ROLL: u32 = 1
@fuel(2 ** 40)
pub const ACTS: [Move; 2] = [PUNCH.clone(), ROLL.clone()]

/// The roll written in Wrela (content/moves), eased and carried ahead as the captured one is: no
/// capture read.
@fuel(2 ** 40)
pub const ROLL_CODE: Move = rolled(moves::roll::ROLL.clip(HERO.rig.clone(), ROLL_RAW.fps))
