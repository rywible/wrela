// The longsword's moves, hand-posed (`engine::keys`): the hero's stance with the sword in both
// hands, his walk and run carrying it (ACCAD Male 2's legs and trunk, the stance's arms), and his
// cuts, each an animator's keys timed for weight and read.
//
// Grounded, not bouncing: both feet flat and the knees soft, the weight low and even, the sword
// out ahead on the centre line toward the foe's throat (the middle guard every two-handed school
// has: kendo's chūdan, the German school's Pflug). It breathes; it doesn't hop.

use std::collections::Vec
use engine::humanoid
use engine::humanoid::{Clip, Pose, Rig}
use engine::keys
use engine::keys::{Key, LINEAR, SETTLE, SMOOTH, SNAP, STEP}
use engine::playback
use engine::playback::{ACTIVE, CANCEL, Gaits, Mark, Move, RECOVER, WINDUP}
use body::{GAITS, HERO}
use engine::anime::{Look, PLAIN}

/// The stance: the right foot ahead and the left back and turned out, both flat, the knees soft
/// and the hips dropped and turned a little toward the left (the right side ahead); the trunk
/// upright, its chest squared back toward the foe; the hands on the hilt in front of the navel,
/// the right at the guard and the left at the pommel, the blade up and ahead at the foe's
/// throat, its edge down.
pub fn stance() -> Key {
    Key {
        at: 0.0,
        hips: vec3(0.0, -0.075, 0.0),
        hips_turn: vec3(0.0, 18.0, 0.0),
        trunk: vec3(4.0, -10.0, 0.0),
        look: vec3(0.0, 1.55, 3.0),
        fists: [vec3(0.10, 1.05, 0.20), vec3(-0.10, 1.05, 0.25)],
        elbows: [vec3(0.7, -1.0, -0.3), vec3(-0.7, -1.0, -0.3)],
        feet: [vec4(0.21, -0.24, 30.0, 16.0), vec4(-0.13, 0.24, 8.0, 0.0)],
        grip: vec3(0.0, 1.06, 0.32),
        blade: normalize(vec3(0.03, 0.62, 1.0)),
        edge: vec3(0.0, -1.0, 0.0),
        two: 1.0,
    }
}

/// The stance's breath: a slow loop, uneven (in longer than out, a pause at its bottom), the
/// hips sinking a centimetre and the chest rising, the point drifting on the foe a hair.
pub fn stance_keys() -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    let breaths = [
        (1.7, 1.0, 0.004),
        (2.1, 0.8, -0.006),
        (1.9, 1.1, 0.002),
    ]
    var t = 0.0
    for (long, deep, drift) in breaths {
        var k = stance()
        k.at = t
        k.ease = SMOOTH
        out.push(k)
        // In: the chest up, the hips settling, the point lifting.
        k = stance()
        k.at = t + long * 0.45
        k.ease = SMOOTH
        k.hips.y -= 0.008 * deep
        k.trunk.x -= 1.2 * deep
        k.grip.y += 0.006 * deep
        k.grip.x += drift
        k.blade = normalize(k.blade + vec3(drift, 0.012 * deep, 0.0))
        out.push(k)
        // Out, and held a moment at its bottom.
        k = stance()
        k.at = t + long * 0.85
        k.ease = SMOOTH
        k.hips.y += 0.003 * deep
        k.trunk.x += 0.4 * deep
        k.grip.x += drift * 0.5
        out.push(k)
        t += long
    }
    var k = stance()
    k.at = t
    k.ease = SMOOTH
    out.push(k)
    out
}

/// A keyed clip as a move that stays where it stands.
fn in_place(c: Clip) -> Move {
    let n = c.frames
    Move {
        clip: c.clone(),
        root: Vec::filled(n, vec3(0.0)),
        heading: Vec::filled(n, 0.0),
        marks: Vec::new(),
        speed: 0.0,
        stride: 0.0,
    }
}

/// A keyed move about its root, which carries the body along its keys' travel.
fn travelling(keys: Vec<Key>) -> Move {
    let c = keys::keyed(HERO.rig, keys, fps: 60.0, fist: 2.2)
    let n = c.frames
    var m = in_place(c)
    m.root = keys::travels(keys, fps: 60.0, frames: n)
    m
}

@fuel(2 ** 40)
pub const STANCE: Move = stance_move()

fn stance_move() -> Move {
    var c = keys::keyed(HERO.rig, stance_keys(), fps: 60.0, fist: 2.2)
    c.looped = true
    in_place(c)
}

/// The bones of an arm (4 the left, 5 the right: `humanoid::part_of`): its collar, upper arm,
/// forearm, hand and fingers.
fn arm_bones(rig: Rig, part: u32) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    for b in 0..rig.bones.len() {
        if humanoid::part_of(rig.bones[b].vrm) == part {
            out.push(b)
        }
    }
    out
}

/// How the sword's carried walking: both hands on it, lower and nearer than the stance, the
/// point up and ahead.
pub fn walk_carry() -> Key {
    var k = stance()
    k.grip = vec3(-0.01, 1.01, 0.27)
    k.blade = normalize(vec3(0.04, 0.38, 1.0))
    k
}

/// How it's carried running: in the right hand alone, low at the hip, the blade trailing back
/// and down behind him, its edge down; the left arm runs free.
pub fn run_carry() -> Key {
    var k = stance()
    k.grip = vec3(-0.27, 0.98, 0.02)
    k.blade = normalize(vec3(-0.22, -0.42, -1.0))
    k.edge = vec3(0.0, -1.0, 0.3)
    k.elbows = [vec3(0.7, -1.0, -0.3), vec3(-1.0, -0.6, 0.2)]
    k.two = 0.0
    k
}

/// `c` with its arms holding the sword as `carry` does (each arm bone's turn in its parent; the
/// left arm `c`'s own where the left hand's off the hilt): the legs and trunk going as `c`
/// does, the sword carried before the chest as it turns.
pub fn carrying(c: Clip, rig: Rig, carry: Key) -> Clip {
    let held = keys::posed(rig, carry)
    var bones = arm_bones(rig, 5)
    if carry.two > 0.5 {
        for b in arm_bones(rig, 4) {
            bones.push(b)
        }
    }
    var out = c.clone()
    for f in 0..c.frames {
        for b in bones.clone() {
            out.turns[f * c.bones + b] = held.turns[b]
        }
    }
    out
}

/// A gait carrying the sword as `carry` does.
fn carried(m: Move, carry: Key) -> Move {
    var out = m.clone()
    out.clip = carrying(m.clip, HERO.rig, carry)
    out
}

/// The gaits with the sword: standing in the stance, walking (and setting off and stopping)
/// with it held low in both hands, running with it trailing in the right.
@fuel(2 ** 40)
pub const SWORD_GAITS: Gaits = Gaits {
    idle: STANCE.clone(),
    walk: carried(GAITS.walk, walk_carry()),
    run: carried(GAITS.run, run_carry()),
    start: carried(GAITS.start, walk_carry()),
    stop: carried(GAITS.stop, walk_carry()),
    start_exit: GAITS.start_exit,
    stop_entry: GAITS.stop_entry,
}

// ---- the cuts -----------------------------------------------------------------------------

/// The pivot the hands swing about (the body's space at rest: in front of the chest), and how
/// far out from it they hold the hilt: toward the blade's way, bent ahead so the hands stay in
/// front of the body.
pub const PIVOT = vec3(-0.02, 1.28, 0.14)
pub const REACH: f32 = 0.31

/// The way `a` turns toward `b` (unit), `t` of the way (past 1 and before 0 it carries on round).
fn arc_at(a: vec3, b: vec3, t: f32) -> vec3 {
    let c = clamp(dot(a, b), -1.0, 1.0)
    var axis = cross(a, b)
    if length(axis) < 1.0e-5 {
        axis = vec3(0.0, 1.0, 0.0)
    }
    Quat::axis_angle(normalize(axis), acos(c) * t).rotate(a)
}

/// A cut's path: the blade's way where it's cocked (`from`), halfway through the strike
/// (`through`), on contact at the end of the strike's arc (`hit`, where it stops dead on the
/// blow), and where its follow-through carries it (`to`), each leg a great circle's arc.
pub struct Path: Copy {
    pub from: vec3,
    pub through: vec3,
    pub hit: vec3,
    pub to: vec3,
}

/// The blade's way `t` along a path (0 cocked, 1 on contact, 2 followed through), and its edge,
/// leading the way it goes.
pub fn along(p: Path, t: f32) -> (vec3, vec3) {
    let way = |x: f32| -> vec3 {
        if x < 0.5 {
            arc_at(normalize(p.from), normalize(p.through), x * 2.0)
        } else if x < 1.0 {
            arc_at(normalize(p.through), normalize(p.hit), x * 2.0 - 1.0)
        } else {
            arc_at(normalize(p.hit), normalize(p.to), x - 1.0)
        }
    }
    let b = way(t)
    (b, normalize(way(t + 0.01) - way(t - 0.01)))
}

/// The body for a beat of a cut: its hips (offset from where they stand, and their turn), its
/// trunk's turn, each foot (its ball (x, z), yaw and heel), where it's got to (`travel`), and
/// the hands moved from their swing's place (a lift over the head).
pub struct Body: Copy {
    pub hips: vec3,
    pub turn: f32,
    pub trunk: vec3,
    pub feet: [vec4; 2],
    pub travel: f32,
    pub hands: vec3 = vec3(0.0),
}

fn body_mix(a: Body, b: Body, u: f32) -> Body {
    Body {
        hips: mix(a.hips, b.hips, vec3(u)),
        turn: mix(a.turn, b.turn, u),
        trunk: mix(a.trunk, b.trunk, vec3(u)),
        feet: [mix(a.feet[0], b.feet[0], vec4(u)), mix(a.feet[1], b.feet[1], vec4(u))],
        travel: mix(a.travel, b.travel, u),
        hands: mix(a.hands, b.hands, vec3(u)),
    }
}

/// A beat of a cut: when (s), how it's come into, its body, and the blade `t` along its path.
fn beat(at: f32, ease: u32, b: Body, p: Path, t: f32) -> Key {
    var k = stance()
    k.at = at
    k.ease = ease
    k.hips = b.hips
    k.hips_turn = vec3(0.0, b.turn, 0.0)
    k.trunk = b.trunk
    k.feet = b.feet
    k.travel = vec3(0.0, 0.0, b.travel)
    k.look = vec3(0.0, 1.5, 3.0 + b.travel)
    let (blade, edge) = along(p, t)
    k.blade = blade
    k.edge = edge
    k.grip = PIVOT +
        vec3(b.hips.x, b.hips.y + 0.075, b.hips.z) +
        b.hands +
        normalize(blade + vec3(0.0, 0.0, 0.8)) * REACH
    k.two = 1.0
    k
}

/// The stance's own hold as a key `by` ahead.
fn stance_at(at: f32, ease: u32, by: f32) -> Key {
    var k = keys::shifted(stance(), vec3(0.0, 0.0, by))
    k.at = at
    k.ease = ease
    k
}

/// A cut, as an animator times it (at 60 a second): from `start` (the stance, or where the
/// cut before it followed through to), the gather into the coil (`windup`, eased) and a quick
/// cock deeper (`cock`: the last frames of the tell), the strike (`snap`, staged from the ground
/// up), stopped dead on contact at the end of its arc (`impact`: the hit-stop), followed through
/// by its weight past the target (`follow`, slowing), and settled back into the stance `rest_by`
/// ahead (`settle`: fast out of the follow-through, slow into the guard). From a cut held with
/// its edge the other way, the hands first turn the blade over (`turn_over`). `coil`, `hit` and
/// `past` are the body cocked, on contact and followed through.
pub struct Cut: Copy {
    pub path: Path,
    pub coil: Body,
    pub hit: Body,
    pub past: Body,
    pub rest_by: f32,
    pub windup: f32,
    pub cock: f32,
    pub snap: f32,
    pub impact: f32,
    pub follow: f32,
    pub settle: f32,
    pub turn_over: bool = false,
}

impl Cut {
    /// When it makes contact, when it's through its hit-stop, and when it's followed through.
    pub fn contact(self) -> f32 {
        self.windup + self.cock + self.snap
    }
    pub fn released(self) -> f32 {
        self.contact() + self.impact
    }
    pub fn driven(self) -> f32 {
        self.released() + self.follow
    }
}

/// The key a cut's followed through to (the next cut in a combo begins from it).
pub fn held_key(c: Cut) -> Key {
    beat(c.driven(), SETTLE, c.past, c.path, 2.0)
}

/// A cut's keys, from `start`.
pub fn cut_keys(c: Cut, start: Key) -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    var first = start
    first.at = 0.0
    out.push(first)
    let lift = beat(c.windup, SMOOTH, c.coil, c.path, 0.0)
    if c.turn_over {
        // Halfway into the gather, the blade on its flat: the wrists roll it over a quarter.
        var mid = keys::mixed(first, lift, 0.5)
        mid.at = c.windup * 0.5
        mid.ease = SMOOTH
        mid.edge = normalize(cross(mid.blade, first.edge))
        out.push(mid)
    }
    out.push(lift)
    // The cock: a few frames further into the coil, settling.
    var deep = c.coil
    deep.hips.y -= 0.01
    deep.trunk.y += 4.0 * sign(c.coil.trunk.y)
    deep.hands = c.coil.hands * 1.06
    deep.hips.y -= 0.02
    deep.turn = mix(c.coil.turn, c.hit.turn, 0.25)
    deep.feet = [mix(c.coil.feet[0], c.hit.feet[0], vec4(0.3)), mix(c.coil.feet[1], c.hit.feet[1], vec4(0.3))]
    deep.travel = mix(c.coil.travel, c.hit.travel, 0.3)
    out.push(beat(c.windup + c.cock, SETTLE, deep, c.path, -0.05))
    // The strike, from the ground up: the hips turn first and arrive early, the trunk after
    // them, the arms and the blade last of all, gathering speed and whipped through its last
    // frames.
    let n = 4
    for i in 1..n + 1 {
        let u = f32(i) / f32(n)
        let hips = 1.0 - (1.0 - u) * (1.0 - u) * (1.0 - u)
        let trunk = 1.0 - (1.0 - u) * (1.0 - u)
        let blade = pow(u, 1.6)
        // The stepping foot lands first, two frames ahead of the blade.
        let step = smoothstep(0.0, 0.6, u)
        let at = c.windup + c.cock + c.snap * u
        var b = body_mix(deep, c.hit, hips)
        b.feet = [mix(deep.feet[0], c.hit.feet[0], vec4(step)), mix(deep.feet[1], c.hit.feet[1], vec4(step))]
        b.travel = mix(deep.travel, c.hit.travel, step)
        b.trunk = mix(deep.trunk, c.hit.trunk, vec3(trunk))
        b.hands = mix(deep.hands, c.hit.hands, vec3(blade))
        out.push(beat(at, LINEAR, b, c.path, mix(-0.05, 1.0, blade)))
    }
    // The hit-stop: stopped dead on the blow, the body still sinking into it a hair.
    var stopped = c.hit
    stopped.hips.y -= 0.01
    stopped.trunk.x += 1.5
    out.push(beat(c.released(), SETTLE, stopped, c.path, 1.02))
    // The follow-through: released, the blade carried on past by its weight and slowing, the
    // body carried with it.
    let m = 4
    for i in 1..m + 1 {
        let u = f32(i) / f32(m)
        let p = 1.0 - (1.0 - u) * (1.0 - u)
        let at = c.released() + c.follow * u
        out.push(beat(at, LINEAR, body_mix(stopped, c.past, p), c.path, mix(1.02, 2.0, p)))
    }
    // Back into the guard: quickly most of the way, then eased home.
    var back = keys::mixed(held_key(c), stance_at(0.0, SMOOTH, c.rest_by), 0.55)
    back.at = c.driven() + c.settle * 0.45
    back.ease = SMOOTH
    out.push(back)
    out.push(stance_at(c.driven() + c.settle, SMOOTH, c.rest_by))
    out
}

/// A cut as a move: its keys about its root, and its windows (`playback`): the tell to
/// contact, hitting from contact into its follow-through, the recovery after, and when the next
/// may cut it off (halfway through its follow-through: the next cut's gather overlaps it).
fn cut_move(c: Cut, start: Key) -> Move {
    var m = travelling(cut_keys(c, start))
    let end = m.clip.length()
    m.marks = Vec::new()
    m.marks.push(Mark { kind: WINDUP, from: 0.0, till: c.contact() })
    m.marks.push(Mark { kind: ACTIVE, from: c.contact(), till: c.released() + c.follow * 0.3 })
    m.marks.push(Mark { kind: RECOVER, from: c.released() + c.follow * 0.3, till: end })
    m.marks.push(Mark { kind: CANCEL, from: c.released() + c.follow * 0.5, till: end })
    m
}


/// The stance's feet, `by` ahead, each moved on (`left_by`, `right_by`), the rear heel raised
/// `heel` degrees.
fn feet_on(left: vec2, right: vec2, heel: f32) -> [vec4; 2] {
    let f = stance().feet
    [f[0] + vec4(left.x, left.y, 0.0, heel), f[1] + vec4(right.x, right.y, 0.0, 0.0)]
}

/// The first light cut (kesa-giri): a quick gather up over the right shoulder (the hands beside
/// the head, the face clear), cocked; then the hips turn it down across him, the right foot
/// stepping in 30 cm on the strike and the pelvis dropping, the blade stopped dead at the left
/// hip on the blow, and carried on past it low.
pub fn first_cut() -> Cut {
    Cut {
        path: Path {
            from: vec3(-0.55, 0.55, -0.65),
            through: vec3(-0.1, 0.25, 1.0),
            hit: vec3(0.55, -0.55, 0.62),
            to: vec3(0.45, -0.72, -0.55),
        },
        coil: Body {
            hips: vec3(0.0, -0.10, -0.07),
            turn: -6.0,
            trunk: vec3(-2.0, -26.0, -4.0),
            feet: feet_on(vec2(0.0), vec2(0.0), 16.0),
            travel: 0.0,
            hands: vec3(-0.12, -0.03, 0.08),
        },
        hit: Body {
            hips: vec3(0.02, -0.22, 0.32),
            turn: 34.0,
            trunk: vec3(16.0, 16.0, 4.0),
            feet: feet_on(vec2(0.0, 0.06), vec2(0.0, 0.58), 26.0),
            travel: 0.2,
            hands: vec3(0.04, -0.04, 0.04),
        },
        past: Body {
            hips: vec3(0.03, -0.21, 0.34),
            turn: 42.0,
            trunk: vec3(20.0, 30.0, 6.0),
            feet: feet_on(vec2(0.0, 0.10), vec2(0.0, 0.58), 26.0),
            travel: 0.22,
            hands: vec3(0.2, -0.14, 0.02),
        },
        rest_by: 0.26,
        windup: 0.12,
        cock: 0.07,
        snap: 0.1,
        impact: 0.06,
        follow: 0.16,
        settle: 0.26,
    }
}

/// The second: from the first's follow-through, low on his left, the blade turned over and
/// cocked; then cut back up across him (gyaku-kesa), the rear foot driving him on a step,
/// stopped high on his right, the hands by the right shoulder and below the chin.
pub fn second_cut() -> Cut {
    Cut {
        path: Path {
            from: vec3(0.75, -0.45, -0.15),
            through: vec3(0.1, -0.1, 1.0),
            hit: vec3(-0.6, 0.6, 0.5),
            to: vec3(-0.55, 0.5, -0.35),
        },
        coil: Body {
            hips: vec3(0.03, -0.14, 0.04),
            turn: 44.0,
            trunk: vec3(18.0, 34.0, 6.0),
            feet: feet_on(vec2(0.0, -0.12), vec2(0.0, 0.36), 20.0),
            travel: 0.0,
            hands: vec3(0.08, 0.0, 0.04),
        },
        hit: Body {
            hips: vec3(-0.01, -0.12, 0.16),
            turn: 6.0,
            trunk: vec3(6.0, -16.0, -4.0),
            feet: feet_on(vec2(0.0, 0.10), vec2(0.0, 0.60), 18.0),
            travel: 0.14,
            hands: vec3(-0.1, -0.04, 0.12),
        },
        past: Body {
            hips: vec3(-0.02, -0.10, 0.17),
            turn: -6.0,
            trunk: vec3(0.0, -28.0, -6.0),
            feet: feet_on(vec2(0.0, 0.12), vec2(0.0, 0.60), 18.0),
            travel: 0.15,
            hands: vec3(-0.12, -0.10, 0.0),
        },
        rest_by: 0.16,
        windup: 0.12,
        cock: 0.03,
        snap: 0.09,
        impact: 0.06,
        follow: 0.15,
        settle: 0.26,
        turn_over: true,
    }
}

/// The third, the combo's finisher: from the second's follow-through the sword drops level to
/// his right side, the body wound round onto its back foot; then a full level cut, a long step
/// in and the hips turning it right through, stopped as it passes in front of his left side,
/// and carried on round past it, the hands out on his left, clear of the chest.
pub fn third_cut() -> Cut {
    Cut {
        path: Path {
            from: vec3(-0.6, 0.25, -0.75),
            through: vec3(-0.1, 0.0, 1.0),
            hit: vec3(0.85, -0.05, 0.5),
            to: vec3(0.5, -0.25, -0.83),
        },
        coil: Body {
            hips: vec3(-0.03, -0.12, -0.06),
            turn: -16.0,
            trunk: vec3(4.0, -40.0, -6.0),
            feet: feet_on(vec2(0.0, -0.03), vec2(0.0, 0.45), 18.0),
            travel: 0.0,
            hands: vec3(-0.1, -0.02, -0.04),
        },
        hit: Body {
            hips: vec3(0.01, -0.21, 0.38),
            turn: 38.0,
            trunk: vec3(14.0, 20.0, 2.0),
            feet: feet_on(vec2(0.0, 0.16), vec2(0.0, 0.78), 28.0),
            travel: 0.26,
            hands: vec3(0.04, -0.02, -0.02),
        },
        past: Body {
            hips: vec3(0.04, -0.20, 0.40),
            turn: 66.0,
            trunk: vec3(16.0, 58.0, 8.0),
            feet: feet_on(vec2(0.0, 0.20), vec2(0.0, 0.78), 28.0),
            travel: 0.28,
            hands: vec3(0.3, -0.06, 0.0),
        },
        rest_by: 0.34,
        windup: 0.18,
        cock: 0.04,
        snap: 0.12,
        impact: 0.08,
        follow: 0.17,
        settle: 0.36,
        turn_over: true,
    }
}

/// The heavy cut: the sword raised high, the hands above the forehead and the face framed
/// between the forearms (a long tell: up, then a slow sink into the back leg, the rear heel
/// lifting), then brought straight down with everything behind it, a stamping step in and the
/// hips dropped deep, stopped dead level with the foe's chin, held, then dropped on through to
/// past the left knee, and a slow recovery.
pub fn heavy_cut() -> Cut {
    Cut {
        path: Path {
            from: vec3(0.0, 0.55, -0.83),
            through: vec3(0.0, 0.95, 0.3),
            hit: vec3(0.05, -0.6, 0.8),
            to: vec3(0.35, -0.88, 0.3),
        },
        coil: Body {
            hips: vec3(0.0, -0.11, -0.08),
            turn: 10.0,
            trunk: vec3(-6.0, -4.0, 0.0),
            feet: feet_on(vec2(0.0), vec2(0.0), 24.0),
            travel: 0.0,
            hands: vec3(0.0, 0.3, 0.04),
        },
        hit: Body {
            hips: vec3(0.0, -0.26, 0.40),
            turn: 22.0,
            trunk: vec3(24.0, 4.0, 0.0),
            feet: feet_on(vec2(0.0, 0.08), vec2(0.0, 0.62), 30.0),
            travel: 0.3,
            hands: vec3(0.0, 0.02, 0.14),
        },
        past: Body {
            hips: vec3(0.0, -0.27, 0.42),
            turn: 28.0,
            trunk: vec3(34.0, 10.0, 2.0),
            feet: feet_on(vec2(0.0, 0.10), vec2(0.0, 0.62), 30.0),
            travel: 0.32,
            hands: vec3(0.06, -0.02, 0.16),
        },
        rest_by: 0.4,
        windup: 0.3,
        cock: 0.1,
        snap: 0.13,
        impact: 0.15,
        follow: 0.15,
        settle: 0.5,
    }
}

/// Each cut of the combo begins where the one before it was held (back at its own root).
fn after(c: Cut) -> Key {
    let k = held_key(c)
    keys::shifted(k, -k.travel)
}

@fuel(2 ** 40)
pub const FIRST: Move = cut_move(first_cut(), stance())
@fuel(2 ** 40)
pub const SECOND: Move = cut_move(second_cut(), after(first_cut()))
@fuel(2 ** 40)
pub const THIRD: Move = cut_move(third_cut(), after(second_cut()))
@fuel(2 ** 40)
pub const HEAVY: Move = cut_move(heavy_cut(), stance())

// ---- dodges -----------------------------------------------------------------------------

/// A dash (a backstep, a sidestep): low and quick along the floor, `by` (m, the body's space),
/// the sword kept in its guard drawn in a little. It loads (sinks, the weight onto the foot it
/// pushes off), pushes (both feet skimming the floor, the near foot first), lands on the far
/// foot and sinks to take it, then rises back into the stance where it got to.
pub fn dash_keys(by: vec3) -> Vec<Key> {
    let lead = if by.x > 0.05 { 0 } else if by.x < -0.05 { 1 } else if by.z < 0.0 { 0 } else { 1 }
    let push = 1 - lead
    var out: Vec<Key> = Vec::new()
    out.push(stance_at(0.0, SMOOTH, 0.0))
    // The load.
    var k = stance()
    k.at = 0.06
    k.ease = SMOOTH
    k.hips.y = -0.11
    k.hips = k.hips + by * 0.05
    k.trunk.x += 4.0
    k.grip = k.grip + vec3(0.0, -0.02, -0.04)
    k.feet[push].w = 14.0
    out.push(k)
    // The push: off the floor, a third of the way, the lead foot reaching.
    k = keys::shifted(stance(), by * 0.35)
    k.at = 0.13
    k.ease = SETTLE
    k.hips.y = -0.06
    k.trunk = stance().trunk + vec3(-by.z * 12.0, 0.0, by.x * 10.0)
    k.grip = k.grip + vec3(0.0, 0.01, -0.06)
    k.feet[lead] = k.feet[lead] + vec4(by.x * 0.35, by.z * 0.35, 0.0, 0.0)
    k.feet[push] = k.feet[push] + vec4(-by.x * 0.2, -by.z * 0.2, 0.0, 28.0)
    k.lifts = [0.035, 0.035]
    out.push(k)
    // The landing, on the lead foot, the other still skimming in.
    k = keys::shifted(stance(), by * 0.85)
    k.at = 0.24
    k.ease = SMOOTH
    k.hips.y = -0.10
    k.trunk = stance().trunk + vec3(-by.z * 6.0, 0.0, by.x * 6.0)
    k.grip = k.grip + vec3(0.0, -0.01, -0.05)
    k.feet[push] = k.feet[push] + vec4(-by.x * 0.15, -by.z * 0.15, 0.0, 18.0)
    k.lifts[push] = 0.03
    out.push(k)
    // Down on both, sunk to take it.
    k = keys::shifted(stance(), by)
    k.at = 0.32
    k.ease = SETTLE
    k.hips.y = -0.13
    k.trunk.x += 3.0
    k.grip = k.grip + vec3(0.0, -0.03, -0.03)
    out.push(k)
    out.push(stance_at(0.58, SMOOTH, 0.0))
    var last = out[out.len() - 1]
    last = keys::shifted(last, by)
    out[out.len() - 1] = last
    out
}

fn dash_move(by: vec3) -> Move {
    var m = travelling(dash_keys(by))
    let end = m.clip.length()
    m.marks = Vec::new()
    m.marks.push(Mark { kind: RECOVER, from: 0.32, till: end })
    m.marks.push(Mark { kind: CANCEL, from: 0.36, till: end })
    m
}

@fuel(2 ** 40)
pub const BACKSTEP: Move = dash_move(vec3(0.0, 0.0, -0.75))
@fuel(2 ** 40)
pub const SIDESTEP_LEFT: Move = dash_move(vec3(0.7, 0.0, 0.0))
@fuel(2 ** 40)
pub const SIDESTEP_RIGHT: Move = dash_move(vec3(-0.7, 0.0, 0.0))

/// `k`'s sword tipped back `deg` degrees (its point up, about the body's left) and swung `yaw`
/// toward its left.
fn tipped(k: Key, deg: f32, yaw: f32) -> Key {
    var out = k
    let q = Quat::axis_angle(vec3(0.0, 1.0, 0.0), yaw * 0.017453292)
        .mul(Quat::axis_angle(vec3(1.0, 0.0, 0.0), -deg * 0.017453292))
    let f = keys::frame_of(k.blade, k.edge)
    out.blade = q.rotate(f.rotate(vec3(0.0, 0.0, 1.0)))
    out.edge = q.rotate(f.rotate(vec3(1.0, 0.0, 0.0)))
    out
}

// ---- being hit ---------------------------------------------------------------------------

/// Being hit: knocked from the stance by a blow from ahead, `by` how hard (0 a flinch, 1 a
/// stagger). The head and chest snap back first (two frames: the hit lands before the body
/// knows), the hips follow, the sword's point thrown up and off the line; a stagger carries him
/// back a step and a half, the rear foot catching him, sunk low, before he gathers himself and
/// comes back up into the stance.
pub fn hit_keys(by: f32) -> Vec<Key> {
    var out: Vec<Key> = Vec::new()
    out.push(stance_at(0.0, SMOOTH, 0.0))
    let back = -0.08 - 0.5 * by
    // The snap: the head and chest thrown back, the arms with them.
    var k = stance()
    k.at = 0.035
    k.ease = SETTLE
    k.trunk = stance().trunk + vec3(-14.0 - 12.0 * by, 6.0 + 6.0 * by, 4.0)
    k.look = vec3(0.0, 2.2 + 0.6 * by, 3.0)
    k.hips = stance().hips + vec3(0.0, -0.01, -0.02)
    k.grip = stance().grip + vec3(0.03, 0.06 + 0.08 * by, -0.08)
    k = tipped(k, 22.0 + 20.0 * by, 10.0)
    out.push(k)
    // The body follows: carried back, the rear foot catching it.
    k = keys::shifted(stance(), vec3(0.0, 0.0, back * 0.7))
    k.at = 0.16 + 0.12 * by
    k.ease = SETTLE
    k.trunk = stance().trunk + vec3(-10.0 - 8.0 * by, 8.0 * by, 3.0)
    k.look = k.look + vec3(0.0, 0.5, 0.0)
    k.hips.y = -0.10 - 0.05 * by
    k.grip = k.grip + vec3(0.04, 0.03 + 0.05 * by, -0.10)
    k = tipped(k, 16.0 + 14.0 * by, 12.0)
    k.feet[1] = k.feet[1] + vec4(0.0, -back * 0.45, 0.0, 0.0)
    k.feet[0] = k.feet[0] + vec4(0.0, back * 0.25, 0.0, 10.0)
    out.push(k)
    // Caught low.
    k = keys::shifted(stance(), vec3(0.0, 0.0, back))
    k.at = 0.30 + 0.25 * by
    k.ease = SETTLE
    k.trunk = stance().trunk + vec3(4.0 * by, 4.0 * by, 0.0)
    k.hips.y = -0.11 - 0.07 * by
    k.grip = k.grip + vec3(0.0, -0.03, -0.06)
    out.push(k)
    out.push(stance_at(0.55 + 0.5 * by, SMOOTH, back))
    out
}

fn hit_move(by: f32) -> Move {
    var m = travelling(hit_keys(by))
    let end = m.clip.length()
    m.marks = Vec::new()
    m.marks.push(Mark { kind: RECOVER, from: 0.0, till: end })
    m
}

@fuel(2 ** 40)
pub const FLINCH: Move = hit_move(0.0)
@fuel(2 ** 40)
pub const STAGGER: Move = hit_move(1.0)

/// A cut's look: on twos, its force along the sword arm; not the arm stretched (the blade's
/// own smear sweeps it: `sword::SMEAR`). A heavy one flashes on contact and drains the page.
pub const CUT: Look = Look { twos: true, limb: 1 }
pub const FINISH: Look = Look { twos: true, limb: 1 }
pub const HEAVY_CUT: Look = Look { twos: true, flash: true, limb: 1, heavy: true }

/// Whether one-off `act` sweeps the blade (a cut).
/// How long each cut's strike lasts (s), by act: its smear's drawn only through it.
pub fn snap_of(act: u32) -> f32 {
    if act == ACT_FIRST {
        first_cut().snap
    } else if act == ACT_SECOND {
        second_cut().snap
    } else if act == ACT_THIRD {
        third_cut().snap
    } else {
        heavy_cut().snap
    }
}

pub fn sweeps(act: u32) -> bool {
    act <= ACT_HEAVY
}

/// The sword's one-offs, by index, and how each is drawn (`engine::anime`): the light cuts on
/// twos and smeared, the finisher and the heavy cut as strikes (flashed, the page drained).
pub const ACT_FIRST: u32 = 0
pub const ACT_SECOND: u32 = 1
pub const ACT_THIRD: u32 = 2
pub const ACT_HEAVY: u32 = 3
pub const ACT_BACKSTEP: u32 = 4
pub const ACT_SIDESTEP_LEFT: u32 = 5
pub const ACT_SIDESTEP_RIGHT: u32 = 6
pub const ACT_FLINCH: u32 = 7
pub const ACT_STAGGER: u32 = 8
@fuel(2 ** 40)
pub const SWORD_ACTS: [Move; 9] = [
    FIRST.clone(),
    SECOND.clone(),
    THIRD.clone(),
    HEAVY.clone(),
    BACKSTEP.clone(),
    SIDESTEP_LEFT.clone(),
    SIDESTEP_RIGHT.clone(),
    FLINCH.clone(),
    STAGGER.clone(),
]
pub const SWORD_LOOKS: [Look; 9] = [
    CUT,
    CUT,
    FINISH,
    HEAVY_CUT,
    PLAIN,
    PLAIN,
    PLAIN,
    PLAIN,
    PLAIN,
]
