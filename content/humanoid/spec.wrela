// What the solved cross (solved.wrela) and the solved lead hook (hook.wrela) should measure:
// the checks `wrela solve content/humanoid --spec` holds their literals to, and reports.
//
// Only what a solve can follow is here: `Written::thrown`'s numbers, and the chain's lead as
// each part's turn reaches half way (`Written::halfway`), each with a derivative by the moves'
// literals. What the timing sheet reads off the built clip (its chain's starts, its flags) is
// found by searching samples, which gives a solve no slope: the tests read those back
// (the_solved_cross_reads_as_a_strike).

use std::lift::Checks
use engine::anime
use engine::anime::Anime
use accad_fists::REAL
use body::HERO
use solved::{CONTACT, TARGET, cross}
use engine::humanoid::pose_world
use engine::keys
use engine::stance

/// How many of a game's frames before the contact the throw is read over.
pub const STEPS: u32 = 18

pub fn spec<C: Checks>(c: mut C) {
    let t = cross().thrown(HERO.rig, CONTACT, STEPS)
    // The fist is on its target when the fight says it lands.
    c.near("cross: fist on its target, across (m)", t.at.x, TARGET.x, within: 0.005)
    c.near("cross: fist on its target, up (m)", t.at.y, TARGET.y, within: 0.005)
    c.near("cross: fist on its target, ahead (m)", t.at.z, TARGET.z, within: 0.005)
    // Fast, as the hand-keyed cross it replaced was (28 m/s), not as a boxer's fist is
    // (9.14 m/s: Walilko, Viano and Bir 2005): judged side by side, the cross held to a
    // boxer's speed had less snap (Ryan's look, 2026-11-12). Held under that cross's.
    c.at_least("cross: fist's fastest (m/s)", t.fastest, 12.0, within: 0.5)
    c.at_most("cross: fist's fastest (m/s)", t.fastest, 26.0, within: 0.5)
    // Fastest as it lands, not before.
    c.at_least(
        "cross: fist's speed into contact, of its fastest",
        t.into / t.fastest,
        0.95,
        within: 0.02,
    )
    // Gathering speed all the way in: its spacing opens frame by frame, with no check in it.
    c.at_most("cross: fist slows on its way in (m/s)", t.slows, 0.0, within: 0.5)
    // Its snap, as it's drawn. On twos (`engine::anime`) the eye gets the drawing before the
    // contact's and the contact's. In the first the hips have gone and the fist is still
    // back; the fist's whole way out is the second. (The hand-keyed cross's fist came 76 cm
    // into its contact's drawing; one whose throw is spread over three drawings has no snap.)
    let before = anime::drawing_before(CONTACT, Anime {})
    let m = cross()
    let loaded = m.end(HERO.rig, m.keys[2].at + m.taste.chain.wrist)
    let out_left = length(t.at - m.end(HERO.rig, before)) / length(t.at - loaded)
    c.at_least(
        "cross: fist's way out left for its contact's drawing, of the whole",
        out_left,
        0.85,
        within: 0.03,
    )
    let (h0, h1, h2) = (
        m.heading(HERO.rig, m.keys[2].at),
        m.heading(HERO.rig, before),
        m.heading(HERO.rig, CONTACT),
    )
    c.at_least(
        "cross: hips' turn done a drawing before the contact's, of the whole",
        (h1 - h0) / (h2 - h0),
        0.6,
        within: 0.05,
    )
    // And all but stopped by it: what's left is the drive past the contact.
    c.at_most(
        "cross: fist's speed after contact, of its fastest",
        t.after / t.fastest,
        0.34,
        within: 0.02,
    )
    // The load draws the fist back off the guard (`fists::guard`), a hand's width or so, not
    // out past the shoulder nor forward.
    let drawn = length(m.keys[1].fists[1] - m.keys[0].fists[1])
    c.at_least("cross: the load draws the fist back off the guard (m)", drawn, 0.09, within: 0.01)
    c.at_most("cross: the load draws the fist back off the guard (m)", drawn, 0.19, within: 0.01)
    c.at_most(
        "cross: the load draws the fist forward of the guard (m)",
        m.keys[1].fists[1].z - m.keys[0].fists[1].z,
        -0.05,
        within: 0.01,
    )
    // The load is held a beat before the throw sets off: two of a game's frames with the fist
    // still, which gets there later than the hips by its lag.
    let still = m.keys[2].at - (m.keys[1].at + m.taste.chain.wrist)
    c.at_least("cross: the fist still before the throw (s)", still, 0.03, within: 0.005)
    // Home slower than it went: a recovery faster than the blow is what the eye takes for
    // the blow.
    let back = m.fastest(HERO.rig, CONTACT + 0.1, 24)
    c.at_most(
        "cross: fist's fastest on its way home, of the strike's",
        back / t.fastest,
        0.7,
        within: 0.05,
    )
    // The body behind it: the hips turned through the strike about as far as a boxer's (70
    // degrees, `accad_fists::CROSS_TAKE`'s sheet), the chest turned on past them.
    let through = m.keys[3].hips_turn.y - m.keys[2].hips_turn.y
    c.at_least("cross: hips' turn through the strike (degrees)", through, 55.0, within: 2.0)
    c.at_most("cross: hips' turn through the strike (degrees)", through, 80.0, within: 2.0)
    c.at_least(
        "cross: chest's twist past the hips on contact (degrees)",
        m.keys[3].trunk.y,
        18.0,
        within: 2.0,
    )
    c.at_most(
        "cross: chest's twist past the hips on contact (degrees)",
        m.keys[3].trunk.y,
        35.0,
        within: 2.0,
    )
    // The contact key asks for a spot the arm reaches (past it the arm locks, and a solve
    // loses its slope).
    c.at_most(
        "cross: contact key's spot, of the arm's reach",
        m.asked(HERO.rig, 3),
        0.97,
        within: 0.01,
    )
    // The striking elbow bends about its own hinge on contact, as real elbows do
    // (`engine::arms` flags one 40 degrees off; the test reads every frame).
    let off = m.hinge(HERO.rig, CONTACT, REAL.hinge[1])
    c.at_most("cross: elbow's bend off its hinge on contact (degrees)", off, 25.0, within: 5.0)
    // The arm not yet straight: a blow lands with some reach left to drive through.
    c.at_most("cross: arm's reach used on contact", t.out, 0.95, within: 0.01)
    c.at_least("cross: arm's reach used on contact", t.out, 0.85, within: 0.01)
    // The weight over the feet, gone toward the lead foot.
    c.at_most("cross: hips outside the feet (m)", t.outside, 0.0, within: 0.01)
    c.at_least("cross: weight toward the lead foot on contact", t.left, 0.45, within: 0.03)
    c.at_most("cross: weight toward the lead foot on contact", t.left, 0.65, within: 0.03)
    // The chain's lead, as a solve can follow it (`Written::halfway`, each part's own turn):
    // from the beat's end to the contact, the hips half way round well before the striking
    // upper arm. (Not the forearm after the upper arm: an elbow opens as a shoulder swings,
    // and a cross's sets off a little before it.)
    let (b, e) = (m.keys[2].at, CONTACT)
    let hips = m.halfway(HERO.rig, "hips", b, e)
    let upper = m.halfway(HERO.rig, "rightUpperArm", b, e)
    c.at_least(
        "cross: the hips' lead on the striking upper arm, half way round (s)",
        upper - hips,
        0.035,
        within: 0.005,
    )
    hook_spec(mut c)
    guard_spec(mut c)
    stepping_spec(mut c)
    downcut_spec(mut c)
    slash_spec(mut c)
}

/// The fight's bounce (`fists::BOUNCE`: ACCAD Male 2 bouncing in his guard, E8) as its stance
/// sheet reads it (`wrela tool moves -- --stance bounce`): the shape the guard's key is solved to,
/// so every strike sets off from the stance the fight stands in.
pub const TAKE: stance::Shape = stance::Shape {
    feet_fore: 0.49,
    feet_across: 0.39,
    sunk: 0.040,
    knees: 136.0,
    lean: 1.5,
    turn: 37.0,
    hand_y: [1.29, 1.42],
    hand_face: [0.56, 0.27],
    hand_ahead: [0.44, 0.16],
    elbows: [95.0, 78.0],
    head_y: 1.56,
    head_lean: 16.0,
}

/// Which way the bounce faces, on average over its loop (`engine::stance::facing`, level): the
/// guard's shape is read facing this way, so the solve can't turn "ahead" by moving the hands it's
/// read off.
@fuel(2 ** 40)
pub const TAKE_FACING: vec3 = take_facing()

fn take_facing() -> vec3 {
    let c = fists::BOUNCE.clone()
    var sum = vec3(0.0)
    for f in 0..c.frames {
        sum += stance::facing(HERO.rig, pose_world(HERO.rig, c.pose(f32(f) / c.fps)))
    }
    normalize(sum)
}

/// What the fight's guard (`fists::guard`) should measure: the bounce's shape (`TAKE`) on this
/// body. Its height, its legs and its arms are its own, so what a key asks for isn't what
/// it gets: the feet's spread, the hips' sink (how far the knees bend), the trunk's lean and turn,
/// each hand's height, how far it's held off the face and out ahead, and the head's lean are the
/// numbers the body's shape decides, and solved.
fn guard_spec<C: Checks>(c: mut C) {
    let w = pose_world(HERO.rig, keys::posed(HERO.rig, fists::guard()))
    let s = stance::shaped(HERO.rig, w, TAKE_FACING)
    let b = TAKE
    c.near("guard: feet apart fore and aft (m)", s.feet_fore, b.feet_fore, within: 0.02)
    c.near("guard: feet apart across (m)", s.feet_across, b.feet_across, within: 0.02)
    c.near("guard: knees' bend (degrees)", s.knees, b.knees, within: 3.0)
    c.near("guard: trunk's lean forward (degrees)", s.lean, b.lean, within: 2.0)
    c.near("guard: trunk's turn (degrees)", s.turn, b.turn, within: 3.0)
    c.near("guard: lead hand's height (m)", s.hand_y[0], b.hand_y[0], within: 0.02)
    c.near("guard: lead hand off the face (m)", s.hand_face[0], b.hand_face[0], within: 0.02)
    c.near("guard: lead hand ahead of the hips (m)", s.hand_ahead[0], b.hand_ahead[0], within: 0.02)
    c.near("guard: rear hand's height (m)", s.hand_y[1], b.hand_y[1], within: 0.02)
    c.near("guard: rear hand off the face (m)", s.hand_face[1], b.hand_face[1], within: 0.02)
    c.near("guard: rear hand ahead of the hips (m)", s.hand_ahead[1], b.hand_ahead[1], within: 0.02)
    c.near("guard: head's lean forward (degrees)", s.head_lean, b.head_lean, within: 3.0)
    // The shoulders turned as the bounce's with the hips under them, not the chest twisted round
    // against still hips: a solve left free turned the chest 77 degrees off the hips to reach the
    // shoulders' turn (a body standing in a guard keeps them within some 20 degrees).
    let flat = |q: Quat| -> vec3 {
        let v = q.rotate(vec3(1.0, 0.0, 0.0))
        normalize(vec3(v.x, 0.0, v.z) + vec3(1.0e-6, 0.0, 0.0))
    }
    let rw = HERO.rig.rest_frames()
    let (hb, cb) = (HERO.rig.find("hips"), HERO.rig.find("upperChest"))
    let hl = flat(w[hb].q.mul(rw[hb].q.inverse()))
    let cl = flat(w[cb].q.mul(rw[cb].q.inverse()))
    let twist = acos(clamp(dot(hl, cl), -1.0, 1.0)) * 57.29578
    c.at_most("guard: chest's twist against the hips (degrees)", twist, 18.0, within: 2.0)
}

/// What the solved lead hook (hook.wrela) should measure. Each bound is set past the brief's
/// own by its `within`, so a check holds where the brief's number does and no further: the
/// fist at 10 m/s at least, not 9.5.
fn hook_spec<C: Checks>(c: mut C) {
    let m = hook::hook()
    // (Read from the beat's end, when the throw sets off: before it the fist eases into its
    // load, which slows as any ease does.)
    let t = m.thrown_from(HERO.rig, hook::CONTACT, m.keys[2].at)
    // The fist within 5 mm of its target when the fight says it lands.
    c.near("hook: fist on its target, across (m)", t.at.x, hook::TARGET.x, within: 0.005)
    c.near("hook: fist on its target, up (m)", t.at.y, hook::TARGET.y, within: 0.005)
    c.near("hook: fist on its target, ahead (m)", t.at.z, hook::TARGET.z, within: 0.005)
    // Between 10 and 24 m/s at its fastest, and fastest as it lands (the step into contact at
    // least 0.95 of it).
    c.at_least("hook: fist's fastest (m/s)", t.fastest, 10.5, within: 0.5)
    c.at_most("hook: fist's fastest (m/s)", t.fastest, 23.5, within: 0.5)
    c.at_least(
        "hook: fist's speed into contact, of its fastest",
        t.into / t.fastest,
        0.97,
        within: 0.02,
    )
    // Never slowing on its way in (a hundredth of a millimetre a frame is noise).
    c.at_most("hook: fist slows on its way in (m/s)", t.slows, 0.0, within: 0.05)
    // All but stopped after: the next step under 0.34 of its fastest.
    c.at_most(
        "hook: fist's speed after contact, of its fastest",
        t.after / t.fastest,
        0.32,
        within: 0.02,
    )
    // The arm bent on contact: a hook lands with its elbow bent, its reach used 0.55 to 0.80.
    c.at_least("hook: arm's reach used on contact", t.out, 0.56, within: 0.01)
    c.at_most("hook: arm's reach used on contact", t.out, 0.79, within: 0.01)
    // The weight over the feet: the hips never outside them.
    c.at_most("hook: hips outside the feet (m)", t.outside, 0.0, within: 0.002)
    // Home slower than it went: at most 0.7 of the strike's fastest.
    let back = m.fastest(HERO.rig, hook::CONTACT + 0.1, 24)
    c.at_most(
        "hook: fist's fastest on its way home, of the strike's",
        back / t.fastest,
        0.65,
        within: 0.05,
    )
    // As drawn on twos: by the drawing before the one that lands, the hips have done at least
    // 0.6 of their turn and the fist still has at least 0.7 of its way to go. A hook's body
    // carries its fist before its arm sets off, so its way is from the hips' setting off (the
    // beat's end), not the arm's as the cross's is: the arm's comes after that drawing.
    let before = anime::drawing_before(hook::CONTACT, Anime {})
    let loaded = m.end(HERO.rig, m.keys[2].at)
    let out_left = length(t.at - m.end(HERO.rig, before)) / length(t.at - loaded)
    c.at_least(
        "hook: fist's way out left for its contact's drawing, of the whole",
        out_left,
        0.73,
        within: 0.03,
    )
    let (h0, h1, h2) = (
        m.heading(HERO.rig, m.keys[2].at),
        m.heading(HERO.rig, before),
        m.heading(HERO.rig, hook::CONTACT),
    )
    c.at_least(
        "hook: hips' turn done a drawing before the contact's, of the whole",
        (h1 - h0) / (h2 - h0),
        0.65,
        within: 0.05,
    )
    // Kept sound for the solve (not asked by the brief): the contact key's spot within the
    // arm's reach, and the striking elbow about its own hinge (`engine::arms` flags 40 degrees).
    c.at_most(
        "hook: contact key's spot, of the arm's reach",
        m.asked(HERO.rig, 3),
        0.97,
        within: 0.01,
    )
    let off = m.hinge(HERO.rig, hook::CONTACT, REAL.hinge[0])
    c.at_most("hook: elbow's bend off its hinge on contact (degrees)", off, 25.0, within: 5.0)
    // The chain's lead: the hips half way round well before the striking upper arm.
    let (b, e) = (m.keys[2].at, hook::CONTACT)
    let hips = m.halfway(HERO.rig, "hips", b, e)
    let upper = m.halfway(HERO.rig, "leftUpperArm", b, e)
    c.at_least(
        "hook: the hips' lead on the striking upper arm, half way round (s)",
        upper - hips,
        0.035,
        within: 0.005,
    )
}

/// What the stepping cross (stepping.wrela) should measure: the standing cross's checks, a step
/// on, and its footwork. The step in the punch as a captured boxer's is (`accad_fists::BOXING`
/// read by `engine::footwork`: in each punch he steps into, the hips go 30 to 80 cm in the 0.6 s
/// before the contact, and the lead foot is down by it), and no foot sliding.
fn stepping_spec<C: Checks>(c: mut C) {
    borrow rig = HERO.rig
    let m = stepping::cross()
    let at = stepping::CONTACT
    let t = m.thrown(rig, at, STEPS)
    c.near(
        "stepping cross: fist on its target, across (m)",
        t.at.x,
        stepping::TARGET.x,
        within: 0.005,
    )
    c.near("stepping cross: fist on its target, up (m)", t.at.y, stepping::TARGET.y, within: 0.005)
    c.near(
        "stepping cross: fist on its target, ahead (m)",
        t.at.z,
        stepping::TARGET.z,
        within: 0.005,
    )
    c.at_least("stepping cross: fist's fastest (m/s)", t.fastest, 12.0, within: 0.5)
    c.at_most("stepping cross: fist's fastest (m/s)", t.fastest, 26.0, within: 0.5)
    c.at_least(
        "stepping cross: fist's speed into contact, of its fastest",
        t.into / t.fastest,
        0.95,
        within: 0.02,
    )
    // It may slow a little as the step lands, as the boxer's does: in the punches he steps into
    // (Extended 1, read in the 0.3 s before each contact) his fist slows by 0.2 to 1.1 m/s and
    // goes again; his standing cross's, 0.01.
    c.at_most("stepping cross: fist slows on its way in (m/s)", t.slows, 1.0, within: 0.1)
    c.at_most(
        "stepping cross: fist's speed after contact, of its fastest",
        t.after / t.fastest,
        0.34,
        within: 0.02,
    )
    c.at_most(
        "stepping cross: contact key's spot, of the arm's reach",
        m.asked(rig, 3),
        0.97,
        within: 0.01,
    )
    let off = m.hinge(rig, at, REAL.hinge[1])
    c.at_most(
        "stepping cross: elbow's bend off its hinge on contact (degrees)",
        off,
        25.0,
        within: 5.0,
    )
    c.at_most("stepping cross: arm's reach used on contact", t.out, 0.95, within: 0.01)
    c.at_least("stepping cross: arm's reach used on contact", t.out, 0.85, within: 0.01)
    c.at_most("stepping cross: hips outside the feet (m)", t.outside, 0.0, within: 0.01)
    c.at_least("stepping cross: weight toward the lead foot on contact", t.left, 0.45, within: 0.03)
    c.at_most("stepping cross: weight toward the lead foot on contact", t.left, 0.70, within: 0.03)
    let (b, e) = (m.keys[2].at, at)
    c.at_least(
        "stepping cross: the hips' lead on the striking upper arm, half way round (s)",
        m.halfway(rig, "rightUpperArm", b, e) - m.halfway(rig, "hips", b, e),
        0.035,
        within: 0.005,
    )
    // The load held a beat before it sets off, as the standing cross's is.
    let still = m.keys[2].at - (m.keys[1].at + m.taste.chain.wrist)
    c.at_least("stepping cross: the fist still before the throw (s)", still, 0.03, within: 0.005)
    // The step: the body travels as far as the boxer's does into his.
    let travel = length(m.root(rig, at) - m.root(rig, at - 0.6))
    c.at_least("stepping cross: the body's travel to the contact (m)", travel, 0.32, within: 0.02)
    c.at_most("stepping cross: the body's travel to the contact (m)", travel, 0.78, within: 0.02)
    // And on through the blow, not back: left free, a solve carries the body past its step by the
    // contact and draws it back through the drive.
    let on = m.root(rig, m.keys[4].at).z - m.root(rig, m.keys[3].at).z
    c.at_least("stepping cross: the body's travel on through the blow (m)", on, 0.0, within: 0.005)
    // Each foot where its keys put it, all through the step: a leg asked past its reach drags its
    // foot along the floor.
    var off = 0.0
    var time = m.keys[2].at
    while time <= m.keys[6].at {
        let w = m.world(rig, time)
        let k = keys::key_in(m.keys, time, m.taste.chain.body_snap)
        let feet = [rig.find("leftToes"), rig.find("rightToes")]
        for j in 0..2 {
            let p = w[feet[j]].t
            off = max(off, length(vec2(p.x - k.feet[j].x, p.z - k.feet[j].y)))
        }
        time += 1.0 / 60.0
    }
    c.at_most("stepping cross: a foot off where its keys put it (m)", off, 0.0, within: 0.01)
    // The lead foot planted by the contact: not moving over the step that ends on it, nor off
    // the floor.
    // (The rear foot pivots on its ball as it drives, as the standing cross's does: the tests read
    // that it doesn't slide.)
    let toes = [rig.find("leftToes"), rig.find("rightToes")]
    let (w0, w1) = (m.world(rig, at - 1.0 / 60.0), m.world(rig, at))
    let rest = rig.rest_frames()
    c.at_most(
        "stepping cross: lead foot moving on the contact (m/s)",
        length(w1[toes[0]].t - w0[toes[0]].t) * 60.0,
        0.0,
        within: 0.05,
    )
    c.at_most(
        "stepping cross: lead foot off the floor on the contact (m)",
        w1[toes[0]].t.y - rest[toes[0]].t.y,
        0.0,
        within: 0.005,
    )
}

/// What the cut in both hands (downcut.wrela) should measure: the stick's striking point on its
/// target when the fight says it lands, fast and fastest as it lands, edge first, both hands on
/// their grips, the wrists and elbows as a person's, the hips over the feet and leading the arms.
fn downcut_spec<C: Checks>(c: mut C) {
    borrow rig = HERO.rig
    let m = downcut::cut()
    let at = downcut::CONTACT
    let t = m.thrown_from(rig, at, m.keys[2].at)
    c.near("cut: striking point on its target, across (m)", t.at.x, downcut::TARGET.x, within: 0.01)
    c.near("cut: striking point on its target, up (m)", t.at.y, downcut::TARGET.y, within: 0.01)
    c.near("cut: striking point on its target, ahead (m)", t.at.z, downcut::TARGET.z, within: 0.01)
    // Fast: at least as the cross's fist (12 m/s), and fastest as it lands.
    c.at_least("cut: striking point's fastest (m/s)", t.fastest, 12.5, within: 0.5)
    // And no faster than the cross's fist is held to (26 m/s): left free, a solve throws the
    // stick round from behind the shoulder in a tenth of a second, at 40.
    c.at_most("cut: striking point's fastest (m/s)", t.fastest, 25.5, within: 0.5)
    c.at_least(
        "cut: striking point's speed into contact, of its fastest",
        t.into / t.fastest,
        0.95,
        within: 0.02,
    )
    c.at_most("cut: striking point slows on its way in (m/s)", t.slows, 0.0, within: 0.5)
    // Edge first: its edge within 15 degrees of the way it goes, on contact and the frame before.
    c.at_most(
        "cut: edge off its way on contact (degrees)",
        m.edge(rig, at, downcut::ALONG),
        15.0,
        within: 5.0,
    )
    c.at_most(
        "cut: edge off its way the frame before (degrees)",
        m.edge(rig, at - 1.0 / 60.0, downcut::ALONG),
        15.0,
        within: 5.0,
    )
    // Both hands on their grips (the left follows the right on it: `keys::both_hands`), at each
    // key: the left arm never asked past its reach, nor the right on contact.
    var off = 0.0
    var bent = [0.0; 2]
    for k in 0..6 {
        let time = m.keys[k].at + if k >= 3 { m.taste.chain.wrist } else { 0.0 }
        let w = pose_world(rig, m.pose(rig, time))
        let thing = w[rig.find("rightHand")].then(m.keys[0].wield.held.grip)
        let left = thing.then(m.keys[0].wield.off.inverse())
        off = max(off, length(w[rig.find("leftHand")].t - left.t))
        for a in 0..2 {
            bent[a] = max(bent[a], m.wrist(rig, time, a))
        }
    }
    c.at_most("cut: left hand off its grip at any key (m)", off, 0.0, within: 0.003)
    c.at_most("cut: right arm's reach asked on contact", m.asked(rig, 3), 0.95, within: 0.02)
    // The wrists as a person's: a hand bends some 70 degrees back, 80 forward, 20 toward the
    // thumb and 30 toward the little finger from straight (American Academy of Orthopaedic
    // Surgeons, "Joint Motion: Method of Measuring and Recording", 1965); a grip that holds a
    // blade bends them less than that, held here within 45 degrees of straight at every key.
    c.at_most("cut: left wrist's bend at its most at a key (degrees)", bent[0], 40.0, within: 5.0)
    c.at_most("cut: right wrist's bend at its most at a key (degrees)", bent[1], 40.0, within: 5.0)
    // Each elbow about its own hinge (`engine::arms` flags 40 degrees).
    c.at_most(
        "cut: left elbow's bend off its hinge on contact (degrees)",
        m.hinge_of(rig, at, REAL.hinge[0], 0),
        25.0,
        within: 5.0,
    )
    c.at_most(
        "cut: right elbow's bend off its hinge on contact (degrees)",
        m.hinge_of(rig, at, REAL.hinge[1], 1),
        25.0,
        within: 5.0,
    )
    // On through it, down and to the left (the cut's way: Ringeck's gloss has it go on through
    // to the ground on the other side): the striking point lower and further left as it goes
    // through than where it struck. Left free, a solve swings it back to the right to ease the
    // wrists.
    let struck = m.end(rig, at)
    let gone = m.end(rig, m.keys[4].at + m.taste.chain.wrist)
    c.at_least("cut: goes on down through its target (m)", struck.y - gone.y, 0.25, within: 0.02)
    c.at_least(
        "cut: goes on to the left through its target (m)",
        gone.x - struck.x,
        0.10,
        within: 0.02,
    )
    // A beat in the load before it sets off, as the cross has (`the fist still before the
    // throw`): left free, a solve sets off as soon as it's loaded, to make the swing longer.
    c.at_least(
        "cut: the load held before it sets off (s)",
        m.keys[2].at - m.keys[1].at,
        0.08,
        within: 0.01,
    )
    // The body behind it: the hips turned through the cut as through the cross (55 degrees at
    // least). Left free, a solve leaves them coiled and cuts with the arms alone.
    let turned = m.keys[3].hips_turn.y - m.keys[2].hips_turn.y
    c.at_least("cut: hips' turn through the cut (degrees)", turned, 55.0, within: 2.0)
    // The weight over the feet, and the hips half way round well before the striking upper arm.
    c.at_most("cut: hips outside the feet (m)", t.outside, 0.0, within: 0.002)
    let (b, e) = (m.keys[2].at, at)
    c.at_least(
        "cut: the hips' lead on the striking upper arm, half way round (s)",
        m.halfway(rig, "rightUpperArm", b, e) - m.halfway(rig, "hips", b, e),
        0.035,
        within: 0.005,
    )
    // Each hand reaches where the grip puts it at every key, as the key poses it: a hilt placed
    // past the arms' reach leaves the hands short of it and the stick where they got to.
    var short = 0.0
    for k in 0..7 {
        let key = keys::shifted(m.keys[k], -m.keys[k].travel)
        let w = pose_world(rig, keys::posed(rig, key))
        let want = keys::hands_of(key)
        short = max(short, length(w[rig.find("leftHand")].t - want[0].t))
        short = max(short, length(w[rig.find("rightHand")].t - want[1].t))
    }
    c.at_most("cut: a hand short of its grip at a key (m)", short, 0.0, within: 0.005)
    // The guard held as vom Tag is (Ringeck, as Tobler translates him: the sword at the right
    // shoulder or above the head), the hilt by the body: left free, a solve holds it at arm's
    // length out ahead to ease the wrists.
    c.at_most(
        "cut: the guard's hilt ahead of the hips (m)",
        m.keys[0].hilt.z - m.keys[0].hips.z,
        0.30,
        within: 0.02,
    )
    // The step in, as the stepping cross's: the body travels, on through the blow and not back,
    // each foot where its keys put it all through it, the lead foot planted by the contact.
    let travel = m.root(rig, at).z
    c.at_least("cut: the body's travel to the contact (m)", travel, 0.25, within: 0.02)
    let on = m.root(rig, m.keys[4].at).z - m.root(rig, m.keys[3].at).z
    c.at_least("cut: the body's travel on through the blow (m)", on, 0.0, within: 0.005)
    var stray = 0.0
    var time = m.keys[1].at
    while time <= m.keys[5].at {
        let w = m.world(rig, time)
        let k = keys::key_in(m.keys, time, m.taste.chain.body_snap)
        let feet = [rig.find("leftToes"), rig.find("rightToes")]
        for j in 0..2 {
            let p = w[feet[j]].t
            stray = max(stray, length(vec2(p.x - k.feet[j].x, p.z - k.feet[j].y)))
        }
        time += 1.0 / 60.0
    }
    c.at_most("cut: a foot off where its keys put it (m)", stray, 0.0, within: 0.01)
    let toe = rig.find("leftToes")
    let (w0, w1) = (m.world(rig, at - 1.0 / 60.0), m.world(rig, at))
    c.at_most(
        "cut: lead foot moving on the contact (m/s)",
        length(w1[toe].t - w0[toe].t) * 60.0,
        0.0,
        within: 0.05,
    )
    // The cut comes down with the hands, as the Oberhau does: it ends in the long point (Langort,
    // Ringeck as Tobler translates him), the arms out, the hands at chest height in front, the
    // blade coming down onto what it strikes. Read off Quaternius's sword cut where its tip is
    // fastest (`wrela tool moves -- --cut sword-take`): its hands 112 cm up, 61 cm ahead of the
    // chest, the arm 99% out; and 130 cm up as its blade stands upright. Left to the checks
    // before, the solve brought the hands to the belt and flicked the blade over from there.
    let hand = rig.find("rightHand")
    let held = m.keys[0].wield.held
    let w = m.world(rig, at)
    let hc = w[hand].t
    c.at_least("cut: the hands' height on contact (m)", hc.y, 1.27, within: 0.02)
    c.at_most("cut: the hands' height on contact (m)", hc.y, 1.43, within: 0.02)
    let ahead = hc.z - w[rig.find("upperChest")].t.z
    // (Both hands on one hilt meet in front of the chest's middle, nearer the body than one hand
    // reaching alone: a hand's width less than the one-handed reference's 61 cm, its arm out as far.)
    c.at_least("cut: the hands ahead of the chest on contact (m)", ahead, 0.42, within: 0.02)
    c.at_most("cut: the hands ahead of the chest on contact (m)", ahead, 0.63, within: 0.02)
    let (sh, el) = (w[rig.find("rightUpperArm")].t, w[rig.find("rightLowerArm")].t)
    let used = length(hc - sh) / (length(el - sh) + length(hc - el))
    c.at_least("cut: the arm's reach used on contact", used, 0.86, within: 0.01)
    c.at_most("cut: the arm's reach used on contact", used, 0.96, within: 0.01)
    let (h0, p0) = held.ends_at(w[hand])
    let up = normalize(p0 - h0).y
    c.at_most("cut: the blade above level on contact (sine)", up, 0.38, within: 0.04)
    let struck_at = m.end(rig, at)
    let falling = (m.end(rig, at - 1.0 / 60.0).y - struck_at.y) * 60.0
    c.at_least("cut: the striking point coming down on contact (m/s)", falling, 2.5, within: 0.5)
    // On the way over, the hands up with the blade: never down at the waist while it still
    // stands more than 30 degrees up.
    var low = 9.0
    var t2 = m.keys[2].at
    while t2 <= at {
        let wt = m.world(rig, t2)
        let (h, p) = held.ends_at(wt[hand])
        if normalize(p - h).y > 0.5 {
            low = min(low, wt[hand].t.y)
        }
        t2 += 1.0 / 60.0
    }
    c.at_least("cut: the hands' height while the blade's still up (m)", low, 1.27, within: 0.02)
}

/// What the slash (slash.wrela) should measure: its source's bands (`slash::SOURCE_CUT`, the cut
/// sheet's reading of `Sword_Attack` on the body), so a later change of ours, a second hand on the
/// grip, a longer blade, a foe at a set distance, can't drift from what it was fitted to. Each as
/// `the_slash_plays_as_its_source_does` holds it, read off the written move so a solve can follow
/// it:
/// - through its target when the fight says it lands: fastest as it lands;
/// - the hand as fast as the source's, within 15% (ours goes round between the source's frames,
///   which sample it at 30 a second and read it along the chord);
/// - the hands where the source's are on contact, up and ahead of the chest, within 3 cm;
/// - the blade as upright on the way over, within 5 degrees;
/// - followed through to a finish low on the far side, held: the sword hand left of the body
///   (over 20 cm) and low (under 70 cm), from 0.50 s to 0.75 s;
/// - its step (`slash::STEP`): all of it by the blow, none before the feet leave the floor.
fn slash_spec<C: Checks>(c: mut C) {
    slash_spec_of(mut c, slash::slash())
}

/// `slash_spec`'s checks of `m`, a slash as written.
fn slash_spec_of<C: Checks>(c: mut C, m: engine::written::Written<slash::KEYS>) {
    borrow rig = HERO.rig
    let at = slash::CONTACT
    let src = slash::SOURCE_CUT.clone()
    let hand = rig.find("rightHand")
    let chest = rig.find("upperChest")
    // (Fastest as it lands: the striking point, read from setting off.)
    let t = m.thrown_from(rig, at, 0.2)
    c.at_least(
        "slash: striking point's speed into contact, of its fastest",
        t.into / t.fastest,
        0.95,
        within: 0.02,
    )
    // The hand's fastest, read as the source's is: over each of its own frames' steps (30 a
    // second), from setting off to the blow. (Read at 60, ours goes round between the source's
    // frames and the source along the chord across them: not the same measure.)
    var fastest = 0.0
    for f in 7..13 {
        let (a, b) = (
            pose_world(rig, m.pose(rig, f32(f - 1) / 30.0))[hand].t,
            pose_world(rig, m.pose(rig, f32(f) / 30.0))[hand].t,
        )
        fastest = max(fastest, length(b - a) * 30.0)
    }
    c.at_least("slash: hand's fastest (m/s)", fastest, slash::SOURCE_HAND * 0.85, within: 0.5)
    c.at_most("slash: hand's fastest (m/s)", fastest, slash::SOURCE_HAND * 1.15, within: 0.5)
    // The hands on contact.
    let w = pose_world(rig, m.pose(rig, at))
    c.near("slash: hand up on contact (m)", w[hand].t.y, src.hand_y, within: 0.03)
    c.near(
        "slash: hand ahead of the chest on contact (m)",
        w[hand].t.z - w[chest].t.z,
        src.hand_ahead,
        within: 0.03,
    )
    // The blade most upright on the way over (from setting off to the blow, at 60 a second).
    var most_up = -2.0
    for k in 0..13 {
        let time = 0.2 + f32(k) / 60.0
        let p = pose_world(rig, m.pose(rig, time))
        let (hilt, tip) = slash::WIELD.held.ends_at(p[hand])
        most_up = max(most_up, normalize(tip - hilt).y)
    }
    c.near(
        "slash: blade most upright on the way over (degrees)",
        asin(clamp(most_up, -1.0, 1.0)) * 57.29578,
        src.upright,
        within: 5.0,
    )
    // The finish, low on the far side, held.
    var left = 1.0e9
    var low = -1.0e9
    for k in 0..6 {
        let p = pose_world(rig, m.pose(rig, 0.5 + f32(k) * 0.05))
        left = min(left, p[hand].t.x)
        low = max(low, p[hand].t.y)
    }
    c.at_least("slash: finish, the hand left of the body (m)", left, 0.2, within: 0.02)
    c.at_most("slash: finish, the hand low (m)", low, 0.7, within: 0.02)
    // Its step: all of it by the blow, none before the feet leave the floor.
    c.near("slash: its step by the blow (m)", m.root(rig, at).z, slash::STEP, within: 0.005)
    c.at_most(
        "slash: its step before the feet leave the floor (m)",
        m.root(rig, slash::LEAVES).z,
        0.0,
        within: 0.005,
    )
}

/// The slash holds its spec (`slash_spec`, among the moves' in `the_solved_cross_holds_its_spec`),
/// and the spec bites: a slash written off its source misses it. Without its step, the step's
/// check misses; with its blow's key's hilt 10 cm higher, the hands on contact miss.
@test
fn the_slash_spec_holds_and_bites() {
    var r = std::lift::Report::new()
    slash_spec(mut r)
    assert(r.missed == 0 && r.held >= 10, f"the slash holds its spec: {r.done()}")
    let standing = engine::written::Written { keys: slash::source_keys(), ..slash::slash() }
    var a = std::lift::Report::new()
    slash_spec_of(mut a, standing)
    assert(a.missed >= 1, "without its step, it misses")
    var raised = slash::slash()
    for k in 0..slash::KEYS {
        if abs(raised.keys[k].at - slash::CONTACT) < 1.0e-4 {
            raised.keys[k].hilt.y += 0.1
        }
    }
    var b = std::lift::Report::new()
    slash_spec_of(mut b, raised)
    assert(b.missed >= 1, "with its blow's hilt raised, it misses")
}
