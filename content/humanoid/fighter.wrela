// Hakuro as the lab's fighters (`--set HAKURO=1`, the exchange and the lab: `SHOW=28`, `29`) and
// as the body a game plays (`SHOW=11`): the hero (content/hakuro, written as fields on his
// skeleton) realized once as the engine realizes a character, posed by the body's own rig (the
// reference he was measured on, so each of its bones moves one of his), and painted into what
// the ink reads as the body is: his own colours in two values, a rim, his cloth's edges as the
// ink's seams. The one he strikes is his double, his values turned over (pale where he's
// black), so the two part on the page as ink and paper do.

use engine::chart
use engine::chart::{Band, Grids, Grown, Limb, Part, Radial}
use hakuro::arms::{Drape, drape_room, draped, follow_legs}
use hakuro::clear::fists_off_mask
use hakuro::fingers::{FIST_CURL, curled}
use hakuro::hakuro::{
    CHARTS, Charted, Cloth, WIDE_CHARTS, charted_as, charted_at_rest, charts, coat, head, hero,
    shaded, shaded_wide, wide_charts,
}
use engine::sway
use engine::sway::Sway
use engine::character::skin_matrix
use engine::creature::{Creature, MAX_BONES, PartMask, Parts}
use engine::look::CreatureLook
use engine::look::Mesh as Tolerance
use engine::realize::{Mesh, SkinVertex, realize_once}
use look::{BODY, COOL, Shot, WARM, band}
use paint::cast_shadow
use std::gpu::{
    ClipPosition, Cull, Flat, GpuBuffer, RenderPass, Targets3, VertexIndex, buffer, discard, draw,
    write,
}
use std::math::TAU
use std::transform::translate

/// His body's grid (cells of about 13 mm), his head's (5 mm: the mask's ears and the hair's
/// spikes) and his coat's tails' (7 mm: thin cloth), as the opening realizes him.
const HOW_BODY = CreatureLook {
    surface: Tolerance { tolerance: 1.0e-3, radius: 0.021, largest: 0.013 },
}
const HOW_HEAD = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.007, largest: 0.005 },
}
const HOW_COAT = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.012, largest: 0.007 },
}

/// How many fighters are drawn: the striker, and the one struck.
pub const FIGHTERS: u32 = 2

/// The fighters: Hakuro's meshes, each fighter's palette (the striker's, then the one struck's),
/// and each one's coat's tails' cloth.
pub struct Fighters {
    body: Mesh,
    head: Mesh,
    coat: Mesh,
    palettes: GpuBuffer<mat4>,
    drape: Drape,
    /// Each fighter's charted parts as his bones pose them this frame (`hakuro::Charted`), and
    /// the grids charted forms are drawn on.
    charted: [Charted; FIGHTERS],
    grids: Grids,
    /// Where his jacket is on its chart (`hakuro::jacket_cover`), for its pixels to read.
    cover: GpuBuffer<f32>,
    /// Each fighter's hair's sway (`hakuro::with_hair`), and how long the last step was (s):
    /// their hair moves on the clock their cloth does.
    hair: [Sway; FIGHTERS],
    dt: f32,
    /// The air they're in (m/s, from ahead), as last stepped.
    going: f32,
    /// How many of them are drawn and moved: both, or the first alone.
    shown: u32,
}

/// The fighters, `shown` of them drawn (the striker alone, or the one struck too).
pub fn fighters(shown: u32) -> Fighters {
    Fighters {
        shown: min(shown, FIGHTERS),
        body: realize_once(hero(), HOW_BODY),
        head: realize_once(head(), HOW_HEAD),
        coat: follow_legs(realize_once(coat(), HOW_COAT)),
        palettes: buffer(2 * FIGHTERS * MAX_BONES),
        drape: drape_room(FIGHTERS),
        charted: [charted_at_rest(); FIGHTERS],
        cover: hakuro::hakuro::jacket_covers(),
        hair: [sway::still(); FIGHTERS],
        dt: 0.0,
        going: 0.0,
        grids: chart::grids(),
    }
}

/// His palette from the rig's (`engine::humanoid::palette`, the body's rig, whose joints are
/// his): each of the rig's bones' matrices to his, and his hands closed into fists, kept off
/// his mask (the captures hold no fingers, and his snout stands out where their face doesn't).
pub fn hakuro_palette(rig_m: [mat4; 64]) -> [mat4; 64] {
    fists_off_mask(curled(hakuro::manner::on_rig(rig_m), FIST_CURL))
}

/// His palette with his punching fist (at `fist`, going `going`) drawn `big` times its size, and
/// smeared: drawn out behind itself along its way by `by` (0 none; 1 twice as long), back over
/// his forearm, its knuckles kept where they are: the one drawing between the cocked fist and
/// the contact, as an animator stretches it into a stroke aimed at the face.
pub fn smeared(m: [mat4; 64], fist: vec3, going: vec3, by: f32, big: f32) -> [mat4; 64] {
    if (by <= 0.0 && big <= 1.0) || length(going) < 1.0e-5 {
        return m
    }
    let d = normalize(going)
    // (About his knuckles, a little on from his wrist.)
    let e = fist + d * 0.09
    // x -> big (x + by (x - e)·d d): a stretch along `d` about his knuckles, then grown there.
    let c0 = (vec3(1.0, 0.0, 0.0) + d * (by * d.x)) * big
    let c1 = (vec3(0.0, 1.0, 0.0) + d * (by * d.y)) * big
    let c2 = (vec3(0.0, 0.0, 1.0) + d * (by * d.z)) * big
    let shift = e - (c0 * e.x + c1 * e.y + c2 * e.z)
    let stretch = mat4(vec4(c0, 0.0), vec4(c1, 0.0), vec4(c2, 0.0), vec4(shift, 1.0))
    var out = m
    // (His fingers alone are drawn out: the hand's own bone also carries his cuff, which drew
    // out as a spike. His hand's grown with them, about his knuckles.)
    let grow = mat4(
        vec4(big, 0.0, 0.0, 0.0),
        vec4(0.0, big, 0.0, 0.0),
        vec4(0.0, 0.0, big, 0.0),
        vec4(e * (1.0 - big), 1.0),
    )
    out[13] = grow * m[13]
    for j in 0..15 {
        // (His thumb goes with his hand: drawn out with his fingers, its form came away from
        // his palm and hung under his fist.)
        let with_hand = j >= 12
        out[27 + 2 * j] = (if with_hand { grow } else { stretch }) * m[27 + 2 * j]
    }
    out
}

/// His palette with his head squashed by `by` (0 to 1 of its depth) along `along` about
/// `about` (its middle), and swelled across to keep its bulk: the contact drawing's, a face
/// with a fist in it.
pub fn squashed(m: [mat4; 64], about: vec3, along: vec3, by: f32) -> [mat4; 64] {
    if by <= 0.0 {
        return m
    }
    let d = normalize(along)
    let a = 1.0 - by
    let p = 1.0 / sqrt(a)
    let c0 = vec3(p, 0.0, 0.0) + d * ((a - p) * d.x)
    let c1 = vec3(0.0, p, 0.0) + d * ((a - p) * d.y)
    let c2 = vec3(0.0, 0.0, p) + d * ((a - p) * d.z)
    let shift = about - (c0 * about.x + c1 * about.y + c2 * about.z)
    var out = m
    out[5] = mat4(vec4(c0, 0.0), vec4(c1, 0.0), vec4(c2, 0.0), vec4(shift, 1.0)) * m[5]
    out
}

impl Fighters {
    /// Fighter `who`'s palette set, and his cloth's.
    pub fn pose(mut self, who: u32, bare: [mat4; 64]) {
        let swayed = self.hair[who].step(
            hakuro::hakuro::hair_held(bare),
            self.dt,
            hakuro::hakuro::HAIR_SPRING,
        )
        let m = hakuro::hakuro::with_hair(
            bare,
            hakuro::hakuro::hair_blown(bare, swayed, self.going),
        )
        write(mut self.palettes, who * MAX_BONES, m)
        write(mut self.palettes, (FIGHTERS + who) * MAX_BONES, m)
        self.charted[who] = charted_as(m)
    }

    /// Fighter `who`'s hand on `side` drawn `by` times as thick (his fist, big at a blow): his
    /// charted hand's pieces' own, where the smear's bones have already drawn its paths out.
    pub fn fist_grown(mut self, who: u32, side: u32, by: f32) {
        let first = hakuro::hakuro::hand_first(side)
        for k in 0..hakuro::hakuro::HAND_PIECES {
            self.charted[who].limbs[first + k].swell = by
        }
    }

    /// Their coats' tails moved on `dt` seconds (0 through a hit-stop: the cloth holds with
    /// them), in air that meets them at `going` m/s from ahead (what they go through, or a
    /// wind: `hakuro::arms::Drape::work`).
    pub fn step(mut self, dt: f32, going: f32 = 0.0) {
        self.dt = dt
        self.going = going
        self.drape.work(
            self.palettes,
            self.shown,
            MAX_BONES,
            FIGHTERS * MAX_BONES,
            dt,
            going: going,
        )
    }

    /// Those shown drawn into the paint's targets.
    pub fn draw<P: RenderPass>(self, p: P, shot: Shot) {
        let hb = hero()
        let hh = head()
        let hc = coat()
        // Their shadows first: each mesh laid flat on the ground along the sun.
        for who in 0..self.shown {
            let first = who * MAX_BONES
            shadow_of(p, self.body, self.palettes, first, shot)
            shadow_of(p, self.head, self.palettes, first, shot)
            let parts = charts()
            for k in 0..CHARTS {
                chart_shadow(p, self.grids, self.charted[who].limbs[k], parts[k].band, shot)
            }
            let wide = wide_charts()
            for k in 0..WIDE_CHARTS {
                chart_shadow(p, self.grids, self.charted[who].wide[k], wide[k].band, shot)
            }
            draw(
                p,
                coat_shadow_vertex.bind(
                    verts: self.coat.verts.items(),
                    palettes: self.palettes.items(),
                    grid: self.drape.grid(),
                    facing: self.drape.facing(),
                    first: first,
                    shot: shot,
                ),
                shadow_pixel.bind(shot: shot),
                indices: self.coat.quads.items(),
                indirect: self.coat.draw.items(),
                cull: Cull::None,
                depth: engine::view::NEAREST,
            )
        }
        let parts = charts()
        let wide = wide_charts()
        for who in 0..self.shown {
            draw(
                p,
                fighter_vertex.bind(
                    verts: self.body.verts.items(),
                    palettes: self.palettes.items(),
                    first: who * MAX_BONES,
                    shot: shot,
                ),
                fighter_pixel.bind(field: hb.field(), shot: shot, who: who, own: 0),
                indices: self.body.quads.items(),
                indirect: self.body.draw.items(),
                cull: Cull::Back,
                depth: engine::view::NEAREST,
            )
            draw(
                p,
                fighter_vertex.bind(
                    verts: self.head.verts.items(),
                    palettes: self.palettes.items(),
                    first: who * MAX_BONES,
                    shot: shot,
                ),
                fighter_pixel.bind(field: hh.field(), shot: shot, who: who, own: 1),
                indices: self.head.quads.items(),
                indirect: self.head.draw.items(),
                cull: Cull::Back,
                depth: engine::view::NEAREST,
            )
            draw(
                p,
                coat_vertex.bind(
                    verts: self.coat.verts.items(),
                    palettes: self.palettes.items(),
                    grid: self.drape.grid(),
                    facing: self.drape.facing(),
                    first: who * MAX_BONES,
                    shot: shot,
                ),
                fighter_pixel.bind(field: hc.field(), shot: shot, who: who, own: 2),
                indices: self.coat.quads.items(),
                indirect: self.coat.draw.items(),
                cull: Cull::Back,
                depth: engine::view::NEAREST,
            )
            let rest = charted_at_rest()
            for k in 0..CHARTS {
                let c = self.charted[who].limbs[k]
                let onto = hakuro::hakuro::grows_from(k)
                if onto < CHARTS {
                    chart_drawn_onto(
                        p,
                        self.grids,
                        self.cover,
                        rest.limbs[k],
                        c,
                        hakuro::hakuro::shaded_hand(c.form),
                        parts[k].band,
                        parts[k].sunk,
                        shot,
                        who,
                        k,
                        self.charted[who].limbs[onto],
                        hakuro::hakuro::shaded_hand(self.charted[who].limbs[onto].form),
                        hakuro::hakuro::grown(k),
                    )
                } else if onto < CHARTS + WIDE_CHARTS {
                    chart_drawn_onto(
                        p,
                        self.grids,
                        self.cover,
                        rest.limbs[k],
                        c,
                        hakuro::hakuro::shaded(c.form),
                        parts[k].band,
                        parts[k].sunk,
                        shot,
                        who,
                        k,
                        self.charted[who].wide[onto - CHARTS],
                        hakuro::hakuro::shaded_wide(self.charted[who].wide[onto - CHARTS].form),
                        hakuro::hakuro::grown(k),
                    )
                } else if hakuro::hakuro::of_hand(k) {
                    chart_drawn(
                        p,
                        self.grids,
                        self.cover,
                        rest.limbs[k],
                        c,
                        hakuro::hakuro::shaded_hand(c.form),
                        parts[k].band,
                        parts[k].sunk,
                        shot,
                        who,
                        k,
                    )
                } else {
                    chart_drawn(
                        p,
                        self.grids,
                        self.cover,
                        rest.limbs[k],
                        c,
                        hakuro::hakuro::shaded(c.form),
                        parts[k].band,
                        parts[k].sunk,
                        shot,
                        who,
                        k,
                    )
                }
            }
            for k in 0..WIDE_CHARTS {
                let c = self.charted[who].wide[k]
                chart_drawn(
                    p,
                    self.grids,
                    self.cover,
                    rest.wide[k],
                    c,
                    shaded_wide(c.form),
                    wide[k].band,
                    wide[k].sunk,
                    shot,
                    who,
                    CHARTS + k,
                )
            }
        }
    }
}

/// What his vertex passes on: where it is, where it is on him at rest, its skin's turn (to
/// bring his fields' normal into the world) and which of his parts are near.
pub struct FighterVertex: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub rest: vec3,
    pub tx: vec3,
    pub ty: vec3,
    pub tz: vec3,
    pub normal: vec3,
    pub lo: Flat<u32>,
    pub hi: Flat<u32>,
}

@vertex
pub fn fighter_vertex(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    first: u32,
    shot: Shot,
) -> FighterVertex {
    fighter_at(v, verts, palettes, first, shot)
}

/// His coat's tails' vertex: as `fighter_vertex`, hanging as the tails' cloth does this frame.
@vertex
pub fn coat_vertex(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    grid: [vec4],
    facing: [vec4],
    first: u32,
    shot: Shot,
) -> FighterVertex {
    var f = fighter_at(v, verts, palettes, first, shot)
    f.world = draped(f.world, f.rest, mat3(f.tx, f.ty, f.tz), grid, facing, first / MAX_BONES)
    f.clip = ClipPosition { position: shot.cam.clip(f.world) }
    f
}

/// A charted part drawn into the paint's targets: on the grid its size on screen calls for.
fn chart_drawn<P: RenderPass, const A: u32, const R: u32, const S: u32>(
    p: P,
    grids: Grids,
    cover: GpuBuffer<f32>,
    rest: Limb<A, R>,
    form: Limb<A, R>,
    shade: Radial<A, S>,
    band: Band,
    sunk: vec2,
    shot: Shot,
    who: u32,
    part: u32,
) {
    let level = form.level(shot.cam.eye, shot.resolution.y, shot.cam.tan_half)
    let span = chart::level_span(level)
    // (Which faces are drawn is part of a draw's pipeline, so each way is written out.)
    if hakuro::hakuro::two_faced(part) {
        draw(
            p,
            chart::vertex.bind(
                rest: rest,
                form: form,
                band: band,
                under: sunk,
                level: level,
                seen: shot.cam,
            ),
            charted_pixel.bind(
                shade: shade,
                length: form.path.length(),
                cover: cover.items(),
                shot: shot,
                who: who,
                part: part,
            ),
            indices: grids.indices,
            first_index: span.x,
            index_count: span.y,
            cull: Cull::None,
            depth: engine::view::NEAREST,
        )
    } else {
        draw(
            p,
            chart::vertex.bind(
                rest: rest,
                form: form,
                band: band,
                under: sunk,
                level: level,
                seen: shot.cam,
            ),
            charted_pixel.bind(
                shade: shade,
                length: form.path.length(),
                cover: cover.items(),
                shot: shot,
                who: who,
                part: part,
            ),
            indices: grids.indices,
            first_index: span.x,
            index_count: span.y,
            cull: Cull::Back,
            depth: engine::view::NEAREST,
        )
    }
}

/// `chart_drawn`, for a part that grows from another or lies on it (`onto`, as the pose has
/// it, and what its pixels read their normals from, `light`): rising from it, laid on it and
/// filleted where the two meet (`how`; `chart::vertex_onto`).
fn chart_drawn_onto<P: RenderPass, const A: u32, const R: u32, const S: u32, const B: u32, const Q: u32, const T: u32>(
    p: P,
    grids: Grids,
    cover: GpuBuffer<f32>,
    rest: Limb<A, R>,
    form: Limb<A, R>,
    shade: Radial<A, S>,
    band: Band,
    sunk: vec2,
    shot: Shot,
    who: u32,
    part: u32,
    onto: Limb<B, Q>,
    light: Radial<B, T>,
    how: Grown,
) {
    let level = form.level(shot.cam.eye, shot.resolution.y, shot.cam.tan_half)
    let span = chart::level_span(level)
    // (Which faces are drawn is part of a draw's pipeline, so each way is written out.)
    if hakuro::hakuro::two_faced(part) {
        draw(
            p,
            chart::vertex_onto.bind(
                rest: rest,
                form: form,
                band: band,
                under: sunk,
                level: level,
                seen: shot.cam,
                onto: onto,
                light: light,
                how: how,
                covers: cover.items(),
            ),
            charted_pixel.bind(
                shade: shade,
                length: form.path.length(),
                cover: cover.items(),
                shot: shot,
                who: who,
                part: part,
            ),
            indices: grids.indices,
            first_index: span.x,
            index_count: span.y,
            cull: Cull::None,
            depth: engine::view::NEAREST,
        )
    } else {
        draw(
            p,
            chart::vertex_onto.bind(
                rest: rest,
                form: form,
                band: band,
                under: sunk,
                level: level,
                seen: shot.cam,
                onto: onto,
                light: light,
                how: how,
                covers: cover.items(),
            ),
            charted_pixel.bind(
                shade: shade,
                length: form.path.length(),
                cover: cover.items(),
                shot: shot,
                who: who,
                part: part,
            ),
            indices: grids.indices,
            first_index: span.x,
            index_count: span.y,
            cull: Cull::Back,
            depth: engine::view::NEAREST,
        )
    }
}

/// A charted part's shadow drawn.
fn chart_shadow<P: RenderPass, const A: u32, const R: u32>(
    p: P,
    grids: Grids,
    form: Limb<A, R>,
    band: Band,
    shot: Shot,
) {
    let level = form.level(shot.cam.eye, shot.resolution.y, shot.cam.tan_half)
    let span = chart::level_span(level)
    draw(
        p,
        charted_shadow_vertex.bind(form: form, band: band, level: level, shot: shot),
        shadow_pixel.bind(shot: shot),
        indices: grids.indices,
        first_index: span.x,
        index_count: span.y,
        cull: Cull::None,
        depth: engine::view::NEAREST,
    )
}

/// A charted part's shadow.
@vertex
pub fn charted_shadow_vertex<const A: u32, const R: u32>(
    v: VertexIndex,
    form: Limb<A, R>,
    band: Band,
    level: u32,
    shot: Shot,
) -> ShadowVertex {
    let at = chart::place_of(v.index, level, band)
    cast(form.side(f: at.x, theta: at.y), shot)
}

/// Mesh `m`'s shadow drawn, posed by the palette at `first`.
fn shadow_of<P: RenderPass>(p: P, m: Mesh, palettes: GpuBuffer<mat4>, first: u32, shot: Shot) {
    draw(
        p,
        shadow_vertex.bind(
            verts: m.verts.items(),
            palettes: palettes.items(),
            first: first,
            shot: shot,
        ),
        shadow_pixel.bind(shot: shot),
        indices: m.quads.items(),
        indirect: m.draw.items(),
        cull: Cull::None,
        depth: engine::view::NEAREST,
    )
}

/// A point of a shadow: where it lies on the ground, and how high on him it's cast from.
pub struct ShadowVertex: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub from: f32,
}

/// `world` laid on the ground along the sun (a hair above it, so it's drawn over the page).
fn cast(world: vec3, shot: Shot) -> ShadowVertex {
    let l = shot.sun
    let h = max(world.y, 0.0)
    let on = world - l * (h / max(l.y, 0.2))
    let p = vec3(on.x, 0.006, on.z)
    ShadowVertex { clip: ClipPosition { position: shot.cam.clip(p) }, world: p, from: h }
}

@vertex
pub fn shadow_vertex(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    first: u32,
    shot: Shot,
) -> ShadowVertex {
    cast(fighter_at(v, verts, palettes, first, shot).world, shot)
}

@vertex
pub fn coat_shadow_vertex(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    grid: [vec4],
    facing: [vec4],
    first: u32,
    shot: Shot,
) -> ShadowVertex {
    let f = fighter_at(v, verts, palettes, first, shot)
    cast(draped(f.world, f.rest, mat3(f.tx, f.ty, f.tz), grid, facing, first / MAX_BONES), shot)
}

@fragment
pub fn shadow_pixel(v: ShadowVertex, shot: Shot) -> Targets3<vec4, vec4, vec4> {
    cast_shadow(v.world, shot, v.from)
}

fn fighter_at(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    first: u32,
    shot: Shot,
) -> FighterVertex {
    let sv = verts[v.index]
    let m = skin_matrix(sv, palettes, first)
    let world = (m * vec4(sv.pos, 1.0)).xyz
    FighterVertex {
        clip: ClipPosition { position: shot.cam.clip(world) },
        world,
        rest: sv.pos,
        tx: m[0].xyz,
        ty: m[1].xyz,
        tz: m[2].xyz,
        normal: mat3(m[0].xyz, m[1].xyz, m[2].xyz) * sv.normal,
        lo: Flat { value: sv.mask.lo },
        hi: Flat { value: sv.mask.hi },
    }
}

/// His pixel where his fields are behind his mesh (what he wears, his head, his coat's tails):
/// his normal and his cloth read from them at that point of him at rest.
@fragment
pub fn fighter_pixel<F: Parts<Cloth>>(
    v: FighterVertex,
    field: F,
    shot: Shot,
    who: u32,
    own: u32,
) -> Targets3<vec4, vec4, vec4> {
    let t = length(v.world - shot.cam.eye)
    let fp = t * 1.5 / shot.resolution.y
    let mask = PartMask { lo: v.lo.value, hi: v.hi.value }
    let (_, grad, c) = field.sample_masked(v.rest, mask, fp)
    let n = normalize(mat3(v.tx, v.ty, v.tz) * grad)
    painted(shot, v.world, n, c, who, own)
}

/// His pixel where his form is drawn along its chart (charted part `part`): his paint by the
/// part and where the place is on him at rest, and its normal read at the pixel itself from the
/// form's slopes at its place (`shade`: the posed form, its finest ripples left out; about a
/// path `length` long: `chart::Vertex::normal_from`). Nothing where the part isn't (`cover`:
/// his jacket's front and armholes) or is cut away.
@fragment
pub fn charted_pixel<const A: u32, const R: u32>(
    v: chart::Vertex,
    shade: Radial<A, R>,
    length: f32,
    cover: [f32],
    shot: Shot,
    who: u32,
    part: u32,
) -> Targets3<vec4, vec4, vec4> {
    let dressed = hakuro::hakuro::dressed(
        part,
        v,
        v.normal_from(shade, length),
        normalize(v.world - shot.cam.eye),
        cover,
    )
    if dressed.hidden {
        discard()
    }
    painted(shot, v.world, dressed.normal, dressed.cloth, who, 0)
}

/// What his black cloth's lit planes are raised by (linear).
pub const SLATE = vec3(0.026, 0.030, 0.044)

/// The one struck's cloth (the double): the vermilion of a seal on an ink painting where
/// Hakuro's is black, a mid value that reads against the page and against him; his mask, his
/// hair, his skin and his gold his own, so a black fist lands on a white mask.
pub const VERMILION = vec3(0.80, 0.22, 0.13)

/// What fighter `who` wears of cloth `c`: the striker's own; the one struck's black cloth,
/// vermilion (`own`: a mesh whose colours are kept, his head's).
fn worn(c: Cloth, who: u32, own: u32) -> vec3 {
    if who == 0 || own == 1 || c.metal > 0.1 {
        return c.albedo
    }
    let v = dot(c.albedo, vec3(0.3, 0.55, 0.15))
    // (His cloth's own steps of black kept as steps of the red: his belt and boots deeper.)
    mix(VERMILION * (0.45 + 6.0 * v), c.albedo, vec3(band(v, edge: 0.12, soft: 0.04)))
}

/// A point of him painted as the body is (`paint::paint_body`): his cloth in three values, the
/// light warm and the shade cool, a thin rim round his edge, and into what the ink reads: how
/// far, that he's a body (the one struck, 20 on), which side of a seam he's on (his dark cloth
/// against his pale: the ink draws the edge between), and his normal.
fn painted(
    shot: Shot,
    world: vec3,
    n0: vec3,
    c: Cloth,
    who: u32,
    own: u32,
) -> Targets3<vec4, vec4, vec4> {
    let v = normalize(shot.cam.eye - world)
    // (A normal turned from the eye, where his fields' relief is finer than his mesh: brought
    // round to his edge.)
    var n = n0
    if dot(n, v) < 0.0 {
        n = normalize(n - v * (dot(n, v) - 0.05))
    }
    let l = shot.sun
    // (His colours are the screen's own, as his look was locked: his black is black, not the
    // grey a display's curve lifts it to.)
    let shown = worn(c, who, own)
    let value = dot(shown, vec3(0.3, 0.55, 0.15))
    let albedo = pow(shown, vec3(2.2))
    let ndl = dot(n, l)
    let lit_side = band(ndl, edge: 0.02, soft: 0.035)
    let full = band(ndl, edge: 0.45, soft: 0.035)
    let light = WARM * 1.08
    let shade = mix(COOL, vec3(0.62, 0.56, 0.62), vec3(0.35)) * 0.58
    let half = mix(shade, light, vec3(0.68))
    var col = albedo * mix(shade, mix(half, light, vec3(full)), vec3(lit_side))
    col *= 0.9 + 0.1 * n.y
    col *= mix(0.82, 1.0, saturate(world.y - shot.feet.y))
    // His gold catches the light: a hard glint where it turns to the sun.
    if c.metal > 0.5 {
        let h = normalize(l + v)
        col += albedo * WARM * band(dot(n, h), edge: 0.9, soft: 0.03) * 1.6
    }
    // The rim: the page's light round a dark form's edge (so his black reads on the paper and
    // against the other body), warm where the sun's behind him; slight on pale cloth.
    let edge = band(1.0 - max(dot(n, v), 0.0), edge: 0.74, soft: 0.05)
    let back = saturate(-dot(v, l) + 0.35)
    let dark = 1.0 - band(value, edge: 0.12, soft: 0.06)
    // (Not his coat's tails: a flat sheet of cloth seen along itself is all edge, and swung out
    // by a blow his black tails washed grey.)
    // (Nor on a kinetic page: drained to three values, a rim is a second outline a step off
    // the first.)
    let rim = (if own == 2 { 0.0 } else { 1.0 }) * (1.0 - band(shot.kinetic, edge: 0.45, soft: 0.2))
    col += WARM * edge * (0.07 + 0.2 * back) * lit_side * dark * rim
    col += COOL * edge * 0.05 * (1.0 - lit_side) * dark * rim
    col += albedo * WARM * edge * (0.25 + 0.5 * back) * lit_side * (1.0 - dark)
    // His black's lit planes, a dark slate (as black cloth is painted on a cel: black in the
    // shade, a step up in the light), so an arm across his trunk is a shape, not a hole.
    col += SLATE * dark * (0.4 * lit_side + 0.6 * full) * mix(0.35, 1.0, rim)
    let t = length(world - shot.cam.eye)
    // (His head's a part of its own, one on: the ink draws his head's seams, his mask's edge,
    // where it leaves the rest of him bare.)
    let id = (if who > 0 { BODY + 20.0 } else { BODY }) + (if own == 1 { 1.0 } else { 0.0 })
    let line = if value > 0.14 { 1.0 } else { -1.0 }
    // A strike's force: the striker's energy along his striking limb, most toward its end (the
    // ink frays his lines there).
    var energy = 0.0
    let f = shot.force_from
    if shot.force_to.w > 0.0 && who == 0 {
        let ab = shot.force_to.xyz - f.xyz
        let k = saturate(dot(world - f.xyz, ab) / max(dot(ab, ab), 1.0e-6))
        let d = length(world - (f.xyz + ab * k))
        let near = 1.0 - band(d, edge: 0.16, soft: 0.08)
        energy = shot.force_to.w * near * saturate((k - 0.35) / 0.3)
    }
    // (His striking limb's black is flat black: its lit planes and rim were bands across the
    // one stroke that has to read as speed.)
    col = mix(col, col * 0.15, saturate(energy * 1.5) * dark)
    Targets3 {
        first: vec4(col, 1.0),
        second: vec4(log2(max(t, 0.01)), id, line, 0.75),
        third: vec4(n * 0.5 + 0.5, energy),
    }
}
