// Mixamo's Great Sword Pack (mocap of a two-handed great sword: idles, cuts, blocks, hits), its
// FBX turned to BVH (`mixamorig:` taken off) and kept in `private/`, out of the repository: its
// licence lets the game carry it but not the raw files be published.

use std::collections::Vec
use engine::bvh
use engine::humanoid
use engine::humanoid::{Clip, MIXAMO, NO_NAMES, Pose, Retarget, Take}

use engine::playback
use engine::playback::{Gaits, Move}
use engine::anime::Look
use engine::keys
use body::HERO

fn clip_of(file: Bytes, frames: u32) -> Clip {
    let b = bvh::read(file)
    let to = min(frames, b.frames) - 1
    humanoid::retarget(
        humanoid::take_of_bvh(b, MIXAMO, NO_NAMES, from: 0, to: to),
        HERO.rig.clone(),
        Retarget {},
    )
}

/// The clips a reel plays, in turn.
pub const COUNT: u32 = 10
@fuel(2 ** 40)
pub const REEL: [Clip; 10] = [
    clip_of(embed("private/great_sword_idle.bvh"), 1000),
    clip_of(embed("private/great_sword_slash.bvh"), 1000),
    clip_of(embed("private/great_sword_slash_2.bvh"), 1000),
    clip_of(embed("private/great_sword_slash_3.bvh"), 1000),
    clip_of(embed("private/great_sword_slash_4.bvh"), 1000),
    clip_of(embed("private/great_sword_slash_5.bvh"), 1000),
    clip_of(embed("private/great_sword_attack.bvh"), 1000),
    clip_of(embed("private/great_sword_high_spin_attack.bvh"), 1000),
    clip_of(embed("private/great_sword_impact.bvh"), 1000),
    clip_of(embed("private/great_sword_walk.bvh"), 1000),
]

/// Which clip plays at `time` and how far into it: each in turn, a beat of its first frame
/// held before it and of its last after.
pub fn reel_at(time: f32) -> (u32, f32) {
    var t = time
    for i in 0..COUNT {
        let span = REEL[i].length() + 0.6
        if t < span {
            return (i, clamp(t - 0.3, 0.0, REEL[i].length()))
        }
        t -= span
    }
    (0, 0.0)
}

// ---- the loop played from mocap ------------------------------------------------------------

fn take_from(file: Bytes) -> Take {
    let b = bvh::read(file)
    let to = b.frames - 1
    humanoid::take_of_bvh(b, MIXAMO, NO_NAMES, from: 0, to: to)
}

/// Frames `from` to `to` of a take (Mixamo's at 30 a second), its still lead-in and tail cut.
fn part_of(file: Bytes, from: u32, to: u32) -> Take {
    let b = bvh::read(file)
    let last = min(to, b.frames - 1)
    humanoid::take_of_bvh(b, MIXAMO, NO_NAMES, from: from, to: last)
}

/// How far down the hilt the left hand holds it, below the right (m): a great sword's long
/// hilt, the hands a hand's width apart.
pub const SPAN: f32 = 0.24

/// The way the sword points from the right hand (`keys::sword_in_hands`): as the guard's two
/// hands hold it (Mixamo's grip, not the keyed hold's).
@fuel(2 ** 40)
pub const AIM: vec3 = aim_read()

fn aim_read() -> vec3 {
    let rig = HERO.rig.clone()
    let c = humanoid::retarget(
        take_from(embed("private/great_sword_idle.bvh")),
        HERO.rig.clone(),
        Retarget {},
    )
    let w = humanoid::frame_world(rig, c.turns, 0, rig.base.t + rig.base.q.rotate(c.hips[0]))
    keys::aim_of(rig, w)
}

/// A take in place, looped as it is (an idle: Mixamo's loop end to end).
fn idle_of(file: Bytes) -> Move {
    var c = humanoid::retarget(take_from(file), HERO.rig.clone(), Retarget {})
    c.looped = true
    c.travel = vec3(0.0)
    c.travel_local = vec3(0.0)
    playback::moved(c, HERO.rig.clone())
}

/// A travelling take, the stride that loops best, turned to go ahead, its footfalls marked.
fn gait_of(file: Bytes, shortest: u32, longest: u32) -> Move {
    let c = humanoid::retarget(
        take_from(file).looped(shortest: shortest, longest: longest),
        HERO.rig.clone(),
        Retarget { face_ahead: true, looped: true },
    )
    playback::with_steps(playback::moved(c, HERO.rig.clone()), HERO.rig.clone())
}

/// A one-off at its own pace, where it stands, its frames `from` to `to`.
fn once_of(file: Bytes, from: u32, to: u32) -> Move {
    var m = playback::moved(
        humanoid::retarget(part_of(file, from, to), HERO.rig.clone(), Retarget {}),
        HERO.rig.clone(),
    )
    // Each's cut toward the foe ahead and ends facing him: the hips' swing through it is the
    // body's own, not the way the body faces.
    m.heading = Vec::filled(m.clip.frames, 0.0)
    m
}

/// When (s) in `m` its blow lands: between `lo` and `hi` (s), where its sword's point goes
/// fastest as the blade comes to point `at` (the body's space: the way the cut meets its foe).
/// The sword held as the hands hold it (`keys::sword_in_hands`), its point a blade's length
/// past the grip.
pub fn blow_of(m: Move, lo: f32, hi: f32, at: vec3) -> f32 {
    let rig = HERO.rig.clone()
    let c = m.clip.clone()
    let aim = normalize(at)
    var best = 0.0
    var when = lo
    var last = vec3(0.0)
    for f in 0..c.frames {
        let w = humanoid::frame_world(rig, c.turns, f, rig.base.t + rig.base.q.rotate(c.hips[f]))
        let (grip, q) = keys::sword_in_hands(rig, w, AIM)
        let u = q.rotate(vec3(0.0, 0.0, 1.0))
        let tip = grip + u
        let t = (f32(f) - 0.5) / c.fps
        if f > 0 && t >= lo && t <= hi {
            let facing = max(dot(u, aim), 0.0)
            let v = length(tip - last) * facing * facing * facing * facing
            if v > best {
                best = v
                when = t
            }
        }
        last = tip
    }
    when
}

/// Each frame's (time, point speed m/s, blade's way) of frames `from` to `to` of a take (a
/// probe for keying a cut's blow by eye).
pub fn tip_track(file: Bytes, from: u32, to: u32) -> Vec<vec4> {
    let m = once_of(file, from, to)
    let rig = HERO.rig.clone()
    borrow c = m.clip
    var out: Vec<vec4> = Vec::new()
    var last = vec3(0.0)
    for f in 0..c.frames {
        let w = humanoid::frame_world(rig, c.turns, f, rig.base.t + rig.base.q.rotate(c.hips[f]))
        let (grip, q) = keys::sword_in_hands(rig, w, AIM)
        let u = q.rotate(vec3(0.0, 0.0, 1.0))
        let tip = grip + u
        let v = if f > 0 { length(tip - last) * c.fps } else { 0.0 }
        out.push(vec4(f32(f) / c.fps, v, u.y, tip.y))
        last = tip
    }
    out
}

/// A cut keyed by eye over its mocap (frames `from` to `to`): its blade meeting the foe `blow`
/// seconds in (where `tip_track` shows its point coming through the foe's height at speed), the
/// last `snap` seconds into it quickened, stopped dead on it for `hold`, the next cut free to come
/// `cancel` after, its follow-through played `tail` times as fast.
fn cut_key(
    file: Bytes,
    from: u32,
    to: u32,
    blow: f32,
    snap: f32,
    quicken: f32,
    hold: f32,
    cancel: f32,
    tail: f32,
) -> Move {
    playback::struck(once_of(file, from, to), blow, snap, quicken, hold, cancel, tail)
}

/// A leaping cut (`cut_of`'s), its body lifted clear of the ground from `up` to `down` seconds
/// into its frames (the mocap's hop made a leap).
fn leapt_cut(
    file: Bytes,
    from: u32,
    to: u32,
    lo: f32,
    hi: f32,
    at: vec3,
    snap: f32,
    quicken: f32,
    hold: f32,
    cancel: f32,
    tail: f32,
) -> Move {
    let m = leapt(once_of(file, from, to), up: 0.27, down: 0.73, height: 0.58)
    let blow = max(blow_of(m.clone(), lo, hi, at) - 0.03, 0.0)
    settled(playback::struck(m, blow, snap, quicken, hold, cancel, tail), 0.3)
}

/// `m` with its last pose held `secs` longer (a heavy's planted settle): its recovery and its
/// window to be cut short run on to the new end.
fn settled(m: Move, secs: f32) -> Move {
    var out = m.clone()
    let n = out.clip.bones
    let last = out.clip.frames - 1
    let extra = u32(secs * out.clip.fps + 0.5)
    for _ in 0..extra {
        for b in 0..n {
            let q = out.clip.turns[last * n + b]
            out.clip.turns.push(q)
        }
        let h = out.clip.hips[last]
        out.clip.hips.push(h)
        let r = out.root[last]
        out.root.push(r)
        let y = out.heading[last]
        out.heading.push(y)
    }
    out.clip.frames += extra
    let end = out.clip.length()
    for i in 0..out.marks.len() {
        if out.marks[i].kind == playback::RECOVER || out.marks[i].kind == playback::CANCEL {
            out.marks[i].till = end
        }
    }
    out
}

/// A hit taken, its knock played quickened (its first `knock` seconds `quicken` times as fast)
/// and held a moment at its worst.
fn hit_of(file: Bytes, to: u32, knock: f32) -> Move {
    var m = once_of(file, 0, to)
    // The neck and head thrown back no more than half as far as the mocap's (its whiplash reads
    // as a neck broken, not a blow taken).
    let rig = HERO.rig.clone()
    let n = m.clip.bones
    for name in ["neck", "head"] {
        let b = rig.find(name)
        if b != humanoid::NONE {
            let first = m.clip.turns[b]
            for f in 1..m.clip.frames {
                let i = f * n + b
                m.clip.turns[i] = first.nlerp(m.clip.turns[i], 0.45)
            }
        }
    }
    // The arms held in the guard's hold (on the chest, as the guard's are), so both hands stay
    // on the hilt: the hit's sold by the trunk, the neck and the legs, not by letting go.
    let guard = IDLE_M.clip.pose(0.0)
    let arms = [
        "leftShoulder", "leftUpperArm", "leftLowerArm", "leftHand",
        "rightShoulder", "rightUpperArm", "rightLowerArm", "rightHand",
    ]
    for name in arms {
        let b = rig.find(name)
        if b != humanoid::NONE {
            for f in 0..m.clip.frames {
                let i = f * n + b
                m.clip.turns[i] = m.clip.turns[i].nlerp(guard.turns[b], 0.85)
            }
        }
    }
    playback::struck(m, knock, knock, quicken: 5.0, hold: 0.08, cancel: 0.3, tail: 1.4)
}

/// `m` with its hips lifted through a leap: from `up` to `down` seconds in, the body rising
/// `height` (m) at most and falling back, both feet off the ground.
fn leapt(m: Move, up: f32, down: f32, height: f32) -> Move {
    var out = m.clone()
    let fps = out.clip.fps
    for f in 0..out.clip.frames {
        let t = f32(f) / fps
        if t > up && t < down {
            let x = (t - up) / (down - up)
            out.clip.hips[f] = out.clip.hips[f] + vec3(0.0, height * sin(3.14159265 * x), 0.0)
        }
    }
    out
}

/// A pose breathing (`on`, 0 to 1, how much): the chest and shoulders rising and falling, the
/// blade's point bobbing with them, the trunk's weight shifting slowly side to side; drawn on
/// twos (its time stepped thirty times a second), as the moves are.
pub fn breathed(p: Pose, time: f32, on: f32) -> Pose {
    var out = p
    let rig = HERO.rig.clone()
    let drawn = floor(time * 30.0) / 30.0
    let breath = sin(drawn * 6.2831853 / 3.0) * on
    let shift = sin(drawn * 6.2831853 / 5.3 + 0.7) * on
    let deg = 0.017453292
    let turn = |name: str, axis: vec3, a: f32| {
        let b = rig.find(name)
        if b != humanoid::NONE {
            out.turns[b] = out.turns[b].mul(Quat::axis_angle(axis, a * deg))
        }
    }
    turn("spine", vec3(0.0, 0.0, 1.0), 4.5 * shift)
    turn("chest", vec3(1.0, 0.0, 0.0), -6.0 * breath)
    turn("upperChest", vec3(1.0, 0.0, 0.0), -4.0 * breath)
    turn("rightShoulder", vec3(0.0, 0.0, 1.0), 3.0 * breath)
    turn("leftShoulder", vec3(0.0, 0.0, 1.0), -3.0 * breath)
    turn("rightHand", vec3(1.0, 0.0, 0.0), 6.0 * breath)
    turn("neck", vec3(1.0, 0.0, 0.0), 2.2 * breath)
    turn("neck", vec3(0.0, 0.0, 1.0), -1.2 * shift)
    out
}

/// The classic downward cut: raised over the head, held there, snapped straight down in three
/// frames, stopped dead on its blow, settled, and back to guard (its sword `vertical_sword`).
fn vertical() -> Move {
    // The body of Mixamo's first slash, retimed to the keyed sword: its gather while the sword
    // rises and holds, its lunge (the step in) on the three-frame snap so the stamp lands with
    // the blow, its planted settle after.
    let m = once_of(embed("private/great_sword_slash.bvh"), 7, 36)
    let keys = [
        vec2(0.0, 0.0),
        vec2(0.18, 0.06),
        vec2(0.33, 0.09),
        vec2(0.38, 0.467),
        vec2(0.48, 0.467),
        vec2(0.55, 0.53),
        vec2(0.9, 0.95),
    ]
    var v = playback::keyed_over(m, keys, blow: 0.38, free: 0.48, cancel: 0.6)
    // Its trunk squared to the foe ahead: the slash's twist (a diagonal cut's wind) taken out of
    // the spine, and the hips' turn undone above them, so the shoulders face straight ahead and
    // the cut comes down the middle.
    let rig = HERO.rig.clone()
    let n = v.clip.bones
    let hips = rig.find("hips")
    let spine = rig.find("spine")
    for f in 0..v.clip.frames {
        let hq = v.clip.turns[f * n + hips]
        let turned = keys::twist_of(hq, vec3(0.0, 1.0, 0.0))
        for name in ["spine", "chest", "upperChest"] {
            let b = rig.find(name)
            if b != humanoid::NONE {
                let i = f * n + b
                let q = v.clip.turns[i]
                let swing = q.mul(keys::twist_of(q, vec3(0.0, 1.0, 0.0)).inverse())
                v.clip.turns[i] = if b == spine { turned.inverse().mul(swing) } else { swing }
            }
        }
    }
    v
}

/// The classic cut's sword, keyed `time` into it: where the right hand holds it (from the upper
/// chest, the body's space: +y up, +z ahead), the way its blade points and its edge leads.
/// From the guard up over the head (jodan, hands a fist above and ahead of the brow), held there
/// loading back a little, snapped straight down the middle in three evenly spaced frames to
/// stop just below level at the foe's chest, held dead six frames, its point dipping as the body
/// sinks into its front knee, and straight back up the middle to guard.
pub fn vertical_sword(time: f32) -> (vec3, vec3, vec3) {
    // Keys: (time, the hold's place from the chest, the blade's angle up from ahead about the
    // body's left-right axis, degrees).
    let times = [0.0, 0.18, 0.33, 0.38, 0.48, 0.55, 0.9]
    let holds = [
        vec3(0.0, -0.35, 0.4),
        vec3(0.0, 0.48, 0.3),
        vec3(0.0, 0.52, 0.26),
        vec3(0.0, -0.12, 0.58),
        vec3(0.0, -0.12, 0.58),
        vec3(0.0, -0.18, 0.56),
        vec3(0.0, -0.35, 0.4),
    ]
    let angles = [-5.0, 140.0, 150.0, -10.0, -10.0, -22.0, -5.0]
    var hold = holds[6]
    var angle = angles[6]
    for i in 1..7 {
        if time >= times[i - 1] && time <= times[i] {
            let x = (time - times[i - 1]) / (times[i] - times[i - 1])
            // The snap down accelerates into its blow; the rest ease in and out.
            let k = if i == 3 { x } else { smoothstep(0.0, 1.0, x) }
            hold = mix(holds[i - 1], holds[i], k)
            // Coming over the top, the hands arc up and out ahead rather than cutting a corner.
            if i == 3 {
                hold += vec3(0.0, 0.1, 0.1) * sin(3.14159265 * k)
            }
            angle = mix(angles[i - 1], angles[i], k)
        }
    }
    let a = angle * 0.017453292
    let blade = vec3(0.0, sin(a), cos(a))
    let edge = cross(vec3(1.0, 0.0, 0.0), blade)
    (hold, blade, edge)
}

@fuel(2 ** 40)
pub const IDLE_M: Move = idle_of(embed("private/great_sword_idle.bvh"))
/// The guard's hands closed on the hilt (its fingers held through a hit that lets go).
@fuel(2 ** 40)
pub const FIST: humanoid::Pose = IDLE_M.clip.pose(0.0)
@fuel(2 ** 40)
pub const WALK_M: Move = gait_of(embed("private/great_sword_walk.bvh"), shortest: 24, longest: 41)
@fuel(2 ** 40)
pub const RUN_M: Move = gait_of(embed("private/great_sword_run.bvh"), shortest: 12, longest: 22)

/// The gaits: Mixamo's guard idle, its walk and run with the sword (set off into and stopped
/// out of as a walk).
@fuel(2 ** 40)
pub const MOCAP_GAITS: Gaits = Gaits::of(
    IDLE_M.clone(),
    WALK_M.clone(),
    RUN_M.clone(),
    WALK_M.clone(),
    WALK_M.clone(),
    HERO.rig.clone(),
)

/// The one-offs: three cuts that chain (the last a spin), a heavy (a leaping blow down), and
/// two hits taken.
pub const M_FIRST: u32 = 0
pub const M_SECOND: u32 = 1
pub const M_THIRD: u32 = 2
pub const M_HEAVY: u32 = 3
pub const M_HIT: u32 = 4
pub const M_HIT_HARD: u32 = 5
/// The one classic cut: raised overhead, held, brought straight down.
pub const M_VERTICAL: u32 = 6

@fuel(2 ** 40)
pub const MOCAP_ACTS: [Move; 7] = [
    // A rising flick, then up and over: the blow down from over the right shoulder.
    cut_key(
        embed("private/great_sword_slash.bvh"),
        from: 7,
        to: 36,
        blow: 0.467,
        snap: 0.13,
        quicken: 2.0,
        hold: 0.08,
        cancel: 0.1,
        tail: 1.4,
    ),
    // A level cut back across.
    cut_key(
        embed("private/great_sword_slash_3.bvh"),
        from: 19,
        to: 42,
        blow: 0.233,
        snap: 0.13,
        quicken: 2.0,
        hold: 0.08,
        cancel: 0.1,
        tail: 1.4,
    ),
    // The finisher: a spin, round into a cut.
    cut_key(
        embed("private/great_sword_high_spin_attack.bvh"),
        from: 16,
        to: 50,
        blow: 0.667,
        snap: 0.13,
        quicken: 2.0,
        hold: 0.1,
        cancel: 0.2,
        tail: 1.3,
    ),
    // The heavy: a leap, and the blade brought down with it.
    leapt_cut(
        embed("private/great_sword_jump_attack.bvh"),
        from: 8,
        to: 35,
        lo: 0.85,
        hi: 0.92,
        at: vec3(0.0, -0.9, 0.45),
        snap: 0.35,
        quicken: 1.6,
        hold: 0.18,
        cancel: 0.3,
        tail: 1.0,
    ),
    // Struck, the chest and head knocked back; struck hard, the knees buckling back.
    hit_of(embed("private/great_sword_impact_3.bvh"), 37, 0.45),
    hit_of(embed("private/great_sword_impact_2.bvh"), 35, 0.5),
    vertical(),
]

/// How each's drawn: all on twos, each contact held dead still, the heavy flashed.
pub const MOCAP_LOOKS: [Look; 7] = [
    Look { twos: true, held: true },
    Look { twos: true, held: true },
    Look { twos: true, held: true },
    Look { twos: true, flash: true, heavy: true, held: true },
    Look { twos: true, held: true },
    Look { twos: true, held: true },
    Look { twos: true, held: true },
]

/// Which way and how far (0 to 1) act `act` leans the blade's point, `time` into it: a hit
/// taken drops the guard forward and down at once, eased back up as it ends; the heavy drives
/// its point down at the floor ahead from its blow on, through its hold and settle; a light
/// cut holds its point on its line through its hit-stop.
pub fn lean_of(act: u32, time: f32) -> (vec3, f32) {
    if act == M_HIT || act == M_HIT_HARD {
        let len = MOCAP_ACTS[act].length()
        let on = 0.85 * smoothstep(0.0, 0.08, time) * (1.0 - smoothstep(len - 0.4, len - 0.05, time))
        return (vec3(0.35, -0.2, 0.9), on)
    }
    if act == M_HEAVY {
        let len = MOCAP_ACTS[act].length()
        let blow = MOCAP_ACTS[act].mark(playback::ACTIVE).unwrap().from
        let on = smoothstep(blow - 0.06, blow, time) * (1.0 - smoothstep(len - 0.2, len, time))
        return (vec3(0.0, -0.6, 0.8), 0.9 * on)
    }
    if act <= M_THIRD {
        // A cut met head on: its point held on its line through the foe from the blow through
        // the hit-stop, let go over its follow-through.
        let ways = [vec3(0.35, -0.55, 0.75), vec3(0.0, -0.25, 1.0), vec3(0.0, -0.4, 0.9)]
        let a = MOCAP_ACTS[act].mark(playback::ACTIVE).unwrap()
        let on = smoothstep(a.from - 0.05, a.from, time) * (1.0 - smoothstep(a.till, a.till + 0.25, time))
        return (ways[act], 0.6 * on)
    }
    (vec3(0.0, 0.0, 1.0), 0.0)
}

/// Whether an act is a cut (its blade smeared through its strike).
pub fn sweeps(act: u32) -> bool {
    act <= M_HEAVY || act == M_VERTICAL
}
