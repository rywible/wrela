/// A counter that can be cloned but not implicitly copied.
struct Log: Clone {
    count: u32,
}

fn bump(log: mut Log) {
    log.count += 1
}

fn archive(log: take Log) -> u32 {
    log.count
}

pub fn run() -> u32 {
    var log = Log { count: 0 }
    bump(mut log)
    bump(mut log)
    let copy = log.clone()
    let archived = archive(take copy)
    log.count + archived
}

