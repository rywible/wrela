/// The index of the first negative element of `xs`, if there is one.
fn first_negative(xs: [f32]) -> Option<u32> {
    var i: u32 = 0
    while i < xs.len() {
        if xs[i] < 0.0 {
            return Some(i)
        }
        i += 1
    }
    None
}

pub fn where_negative() -> u32 {
    let xs = [2.0, 7.0, -1.0, 3.0]
    match first_negative(xs) {
        Some(i) => i,
        None => 99,
    }
}

