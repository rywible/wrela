// Sum a run, and the largest element of a fixed array.
fn sum(xs: [f32]) -> f32 {
    var total = 0.0
    var i = 0
    while i < xs.len() {
        total += xs[i]
        i += 1
    }
    total
}

fn largest(xs: [f32; 5]) -> f32 {
    var best = xs[0]
    var i = 1
    while i < 5 {
        best = max(best, xs[i])
        i += 1
    }
    best
}

pub fn stats() -> vec2 {
    let data = [3.0, -1.0, 4.0, 1.0, 5.0]
    vec2(sum(data), largest(data))
}

