#!/usr/bin/env python3
"""Build and run the current checkout's CLI."""
import os
from pathlib import Path
import subprocess
import sys

os.chdir(Path(__file__).resolve().parent.parent)
try:
    subprocess.run(["cargo", "build", "-q", "--release", "-p", "wrela", "-p", "wrela-host", "--bins"], check=True)
    target = Path(os.environ.get("CARGO_TARGET_DIR", "target")).resolve()
    sys.exit(subprocess.call([str(target / "release/wrela"), *sys.argv[1:]]))
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode)
