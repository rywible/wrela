 /**
+ * Reset the ids of the vertices emitted since the last flush: the
+ * temporaries of each stage, and those of the pipeline's vertices that
+ * were emitted. Sweeping every vertex of the pipeline's run (as
+ * draw_reset_vertex_ids does) at each flush costs the run's size per flush.
+ */
+static void
+vbuf_reset_vertex_ids(struct vbuf_stage *vbuf)
+{
+   struct draw_context *draw = vbuf->stage.draw;
+   const char *verts = draw->pipeline.verts;
+   const char *end = verts + (size_t)draw->pipeline.vertex_count *
+                             draw->pipeline.vertex_stride;
+   unsigned n = MIN2(vbuf->nr_vertices, vbuf->emitted_cap);
+
+   if (n < vbuf->nr_vertices) {
+      draw_reset_vertex_ids(draw);
+      return;
+   }
+
+   for (struct draw_stage *stage = draw->pipeline.first; stage;
+        stage = stage->next) {
+      for (unsigned i = 0; i < stage->nr_tmps; i++)
+         stage->tmp[i]->vertex_id = UNDEFINED_VERTEX_ID;
+   }
+
+   if (verts) {
+      for (unsigned i = 0; i < n; i++) {
+         const char *v = (const char *)vbuf->emitted[i];
+         if (v >= verts && v < end)
+            vbuf->emitted[i]->vertex_id = UNDEFINED_VERTEX_ID;
+      }
+   }
+}
+
+
