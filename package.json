{
  "name": "wrela-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --hot tools/dev.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.browser.json && bun tools/boundaries.ts && biome check . --reporter=summary",
    "verify": "bun tools/verify.ts",
    "perf": "bun tools/perf.ts",
    "perf:low": "bun tools/perf.ts --low",
    "perf:author": "bun tools/authoring-benchmark.ts",
    "author": "bun tools/author.ts",
    "cook": "bun tools/cook.ts",
    "build": "bun tools/build.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12",
    "@dimforge/rapier3d-compat": "0.19.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/bun": "1.3.10",
    "@webgpu/types": "0.1.64",
    "@biomejs/biome": "2.3.8"
  }
}
