// The opening, as a style test of Kinetic Ink: a skiff adrift on an endless ocean in the quiet
// before anything happens, and far off a rock floating in the sky with a shining cathedral on top,
// a crisp silhouette against the light, the one place to go.
//
// The engine's sky over it (`heavens`: its air, its light and its clouds, cooked over the first
// frames and marched a phase a frame). Then two passes. The first paints the scene in 3D (`paint`):
// each pixel's ray meets the sea, the skiff, the rock or the sky, lit as the engine lights its
// world, with soft shadows, ambient occlusion and the air's depth; beside its colour it writes
// what the ink needs: how far it is, what it is, its normal, and a field whose zero is a line to
// draw. The second (`ink`) tones it for the screen and lays the ink on the forms, light when it's
// quiet, fraying as the moment turns kinetic.
//
// The sea is an open ocean's (`engine::ocean`): its waves summed on the GPU each drawing, the
// skiff riding the longest of them as the CPU sums them. The water and the skiff move at
// `HELD` drawings a second. The player sails the skiff (`sail`): W sheets in, S lets the sail
// fly, A and D steer, and the camera swings round after it.

use heavens::heavens
use look::SUN
use ink::ink
use played::{State, cover, painted, sized, targets, weathered}
use sail::key
use std::input::events
use std::gpu::{begin_screen_pass, draw, label, timed}
use std::io::print

/// The time the scene starts at (s): the frames a test or a still draws begin here.
pub const START: f32 = 0.0

/// The whole frame's kinetic level, 0 (the quiet opening) to 1 (a fight's climax): how far every
/// line frays and the palette drains toward black and white. `--set KINETIC=0.6` builds it louder.
pub const KINETIC: f32 = 0.0

/// Which view draws: 0 the opening's, 1 the rock near, 2 the skiff near, 3 the cathedral, 4
/// the sea from over it, 5 toward the sun (`--set VIEW=1`).
pub const VIEW: u32 = 0

/// How much of the drawing lies over the render: 1, all of it; 0, the physical render alone
/// (`--set STYLE=0`), to see what the style is laid on.
pub const STYLE: f32 = 1.0

/// Which shading language draws everything, the skiff to the sky: 3 clean CG (the chosen look:
/// no ink till the action brings it), or for comparison 0 the drawn look, 1 painted CG, 2 cel
/// and ink (`--set LOOK=2`).
pub const LOOK: f32 = 3.0

/// The cathedral lit from within, its stained glass beaming coloured light round over the sea
/// (`--set LANTERN=1`).
pub const LANTERN: f32 = 0.0

/// How finely the rock and the skiff are met (`Shot::fine`): 1, each pixel near them four
/// times over; 0.3, as wrela.dev's live page draws them, the rock alone so; 0, all once
/// (`--set FINE=0.3`, to see what the page gives up).
pub const FINE: f32 = 1.0

/// The skiff's hull: 0 the open rowing skiff it was, 1 a planing hull made for the sail (narrow,
/// flat-bottomed and flared, its bow swept up and decked) (`--set PLANING=1`).
pub const PLANING: f32 = 1.0

/// How high the planing hull's deck stands over the water it floats in (m): its topsides, the
/// freeboard that makes it read as a boat and not a board. Its hull is that much deeper, so it
/// draws as much as before (`--set FREEBOARD=0`, the flush board it was).
pub const FREEBOARD: f32 = 0.28

/// The skiff's sail (1, the junk's, Ryan's pick): 0 the windsurfer's battened triangle, weathered and patched; 1 a junk's
/// lug sail of tanbark cloth between bamboo battens; 2 a crab-claw of woven matting between two
/// spars; 3 the triangle again in bold madder with a pennant streaming off its head
/// (`--set SAIL=1`).
pub const SAIL: u32 = 1

/// How far the opening's camera stands to the skiff's port side (m): at 3.5 the skiff sails on
/// the frame's right third under the rock on its left, not stacked on the centre line under it
/// (`--set OPEN_SIDE=0`, as it was).
pub const OPEN_SIDE: f32 = 3.5

/// Where the camera stands: 0 the opening's shot, 1 the player's, up behind the skiff
/// (`Rig::framing`; `--set FRAMING=1`).
pub const FRAMING: f32 = 0.0

/// Clear weather over the opening itself (`--set CLEAR=1`): the clear region moved onto the
/// skiff and the rock, so every view can be checked in a sea day's light.
pub const CLEAR: f32 = 0.0

/// The player's camera: 0 low behind the skiff, as it was; 1 higher and off its quarter, so the
/// deck and the hull's length read (`--set CAMERA=1`).
pub const CAMERA: f32 = 0.0

/// Pieces left out, to measure what each costs (`--set OFF=...`, the bits added): 1 the rock
/// and the cathedral, 2 the sea stacks, 4 the far islands, 8 the falls, 16 the skiff (and the
/// hero on it), 32 the hero alone, 64 the sea's shading (still traced, lit flat), 128 the wake's
/// thrown spray, 256 the weather pass, 512 the rock's and the cathedral's shading (still met,
/// lit flat), 1024 the stacks' shading (still met, lit flat), 2048 the stacks' edge test (the
/// four rays round a stack's edge that keep it from trailing), 4096 the rock's rest (met afresh
/// every drawing in every pixel, `yonder::REFRESH`). 0, the scene whole: as shipped.
pub const OFF: u32 = 0

/// The side (px) of the blocks the rock is met afresh in, a block of each 2x2 a drawing in turn
/// (`yonder::REFRESH`): wide enough that each group of pixels a GPU runs together falls in one.
pub const RELIT: u32 = 32

/// Whether the rock, the cathedral, the stacks and the far islands are met a quarter of their
/// pixels a drawing, at half the size each way, and rebuilt at the full size over the drawings
/// (`yonder::yonder_low`, `yonder::yonder_rebuild`): a quarter of the far pass's cost.
pub const QUARTER: bool = true

/// The side of the blocks the far things are met sparsely in (`QUARTER`): one pixel of each
/// block a drawing, at 1 / `SPARSE` the size each way: 2, or 4 (a quarter the cost again, but
/// the stacks stay grainy for seconds after the camera starts).
pub const SPARSE: u32 = 2

/// Whether the paint is painted in every other column out on the sea, the others filled between
/// their neighbours along the row, and in full round the skiff (`paint::paint_half`,
/// `paint::paint_fill`): about half the paint's cost.
pub const HALF_PAINT: bool = true

/// How many frames march the clouds' dome whole, a share of its tiles each
/// (`engine::switches::Switches::DOME_PHASES`; 32, 64 or 128): at 128 a frame's march costs a
/// quarter of 32's, and at 120 frames a second the dome is still marched whole about once a
/// second (`--set DOME_PHASES=32` for the engine's own).
pub const DOME_PHASES: u32 = 128

/// Whether the clouds' dome is marched at half its size each way (`--set HALF_SKY=false` for full): a
/// quarter of the clouds' cost, a little softer.
pub const HALF_SKY: bool = true

/// Whether each frame's passes print their GPU time (`timing <frame> <pass> <us>`), for a host
/// that can't be asked for timestamps, as the render box's (`--set TIMINGS=true`).
pub const TIMINGS: bool = false

/// The passes `TIMINGS` prints.
const TIMED: [Text; 6] = ["clouds", "ocean", "yonder", "paint", "weather", "ink"]

pub fn init() -> State {
    targets(heavens(SUN, 3.0), 640, 360)
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if TIMINGS {
        timings(mut s)
    }
    sized(mut s, width, height)
    // The player's keys: W sheets in, S lets the sail fly, A and D steer.
    for e in events() {
        key(mut s.rig, e)
    }
    let shot = painted(mut s, time, VIEW, 0.0, framing: FRAMING, fine: FINE)
    weathered(mut s, shot)
    borrow hv = s.heavens
    borrow colour = if (OFF & 256) != 0 { s.colour } else { s.aired }
    label("ink")
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        screen,
        cover,
        ink.bind(
            shot: shot,
            light: hv.light,
            colour: colour,
            marks: s.marks,
            normal: s.normal,
        ),
        vertices: 3,
    )
    screen.present()
}

/// The passes' times as they come back, printed, and this frame's asked for.
fn timings(s: mut State) {
    var k = 0
    while k < s.asks.len() {
        let i = s.asks[k].0
        let at = s.asks[k].2
        match s.asks[k].1.poll() {
            Some(Ok(us)) => {
                print(f"timing {at} {TIMED[i]} {us[0]}")
                let _ = s.asks.remove(k)
            },
            Some(Err(_)) => {
                let _ = s.asks.remove(k)
            },
            None => k += 1,
        }
    }
    for i in 0..6 {
        s.asks.push((u32(i), timed(TIMED[i]), s.frames))
    }
    s.frames += 1
}

/// Each frame records draws the host accepts.
@test(frames: 2)
fn frames_record_valid_draws() {}

/// The storm's low cloud: 1 the scud torn under the deck and the lifted air on the horizon as
/// they were; 0 neither, the deck going down into its own air (`--set LOW_CLOUD=0`).
pub const LOW_CLOUD: f32 = 1.0
