// The opening, as a style test of Kinetic Ink: a skiff adrift on an endless ocean in the quiet
// before anything happens, and far off a rock floating in the sky with a shining cathedral on top,
// a crisp silhouette against the light, the one place to go.
//
// Two passes. The first paints the scene (`paint`): each pixel's ray meets the sea, the skiff, the
// rock or the sky, and is lit as a painter would (a few tones each, cool shadows, warm light), and
// beside its colour it writes what the ink needs: how far it is, what it is, its normal, and a
// field whose zero is a line to draw (a wave's crest, a cloud's edge). The second (`ink`) draws
// the lines where those change, wobbling as a hand's do, and lays the paper's grain over all.
//
// The quiet look is painterly (the art direction's "quiet = painterly"); the water and the skiff
// move on twos (`HELD`).

use look::{Shot, shot_at}
use paint::paint
use ink::ink
use std::gpu::{
    ClipPosition, Rgba16Float, Rgba8, Sampler, Texture, VertexIndex, begin_pass3, begin_screen_pass,
    draw, texture,
}

/// The time the scene starts at (s): the frames a test or a still draws begin here.
pub const START: f32 = 0.0

/// The whole frame's kinetic level, 0 (the quiet opening) to 1 (a fight's climax): how far every
/// line frays and the palette drains toward black and white. `--set KINETIC=0.6` builds it louder.
pub const KINETIC: f32 = 0.0

/// Which view draws: 0 the opening's, 1 the rock near, 2 the skiff near (`--set VIEW=1`).
pub const VIEW: u32 = 0

pub struct State {
    /// The painted scene, and what the ink reads beside it: (log₂ distance, what it is, the
    /// line field, the line's weight) and the normal.
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
    width: u32,
    height: u32,
}

fn targets(width: u32, height: u32) -> State {
    State {
        colour: texture(width: width, height: height),
        marks: texture(width: width, height: height),
        normal: texture(width: width, height: height),
        width,
        height,
    }
}

pub fn init() -> State {
    targets(640, 360)
}

/// One triangle that covers the screen.
@vertex
fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if width != s.width || height != s.height {
        s = targets(width, height)
    }
    let shot = shot_at(START + time, width, height, KINETIC, VIEW)
    let p = begin_pass3(mut s.colour, mut s.marks, mut s.normal, clear: vec4(0.0))
    draw(p, cover, paint.bind(shot: shot), vertices: 3)
    p.end()
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        screen,
        cover,
        ink.bind(shot: shot, colour: s.colour, marks: s.marks, normal: s.normal),
        vertices: 3,
    )
    screen.present()
}

/// Each frame records draws the host accepts.
@test(frames: 2)
fn frames_record_valid_draws() {}
