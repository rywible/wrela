// The opening, as a style test of Kinetic Ink: a skiff adrift on an endless ocean in the quiet
// before anything happens, and far off a rock floating in the sky with a shining cathedral on top,
// a crisp silhouette against the light, the one place to go.
//
// The engine's sky over it (`heavens`: its air, its light and its clouds, cooked over the first
// frames and marched a phase a frame). Then two passes. The first paints the scene in 3D (`paint`):
// each pixel's ray meets the sea, the skiff, the rock or the sky, lit as the engine lights its
// world, with soft shadows, ambient occlusion and the air's depth; beside its colour it writes
// what the ink needs: how far it is, what it is, its normal, and a field whose zero is a line to
// draw. The second (`ink`) tones it for the screen and lays the ink on the forms, light when it's
// quiet, fraying as the moment turns kinetic.
//
// The sea is an open ocean's (`engine::ocean`): its waves summed on the GPU each drawing, the
// skiff riding the longest of them as the CPU sums them. The water and the skiff move at
// `HELD` drawings a second. The player sails the skiff (`sail`): W sheets in, S lets the sail
// fly, A and D steer, and the camera swings round after it.

use heavens::heavens
use look::SUN
use ink::ink
use played::{State, cover, painted, sized, targets}
use sail::key
use std::input::events
use std::gpu::{begin_screen_pass, draw}

/// The time the scene starts at (s): the frames a test or a still draws begin here.
pub const START: f32 = 0.0

/// The whole frame's kinetic level, 0 (the quiet opening) to 1 (a fight's climax): how far every
/// line frays and the palette drains toward black and white. `--set KINETIC=0.6` builds it louder.
pub const KINETIC: f32 = 0.0

/// Which view draws: 0 the opening's, 1 the rock near, 2 the skiff near, 3 the cathedral, 4
/// the sea from over it, 5 toward the sun, 8 the traveller close, 9 him
/// from off the starboard quarter (`--set VIEW=1`).
pub const VIEW: u32 = 0

/// How much of the drawing lies over the render: 1, all of it; 0, the physical render alone
/// (`--set STYLE=0`), to see what the style is laid on.
pub const STYLE: f32 = 1.0

/// Which shading language draws everything, the skiff to the sky: 3 clean CG (the chosen look:
/// no ink till the action brings it), or for comparison 0 the drawn look, 1 painted CG, 2 cel
/// and ink (`--set LOOK=2`).
pub const LOOK: f32 = 3.0

/// The cathedral lit from within, its stained glass beaming coloured light round over the sea
/// (`--set LANTERN=1`).
pub const LANTERN: f32 = 0.0

/// How finely the rock and the skiff are met (`Shot::fine`): 1, each pixel near them four
/// times over; 0.3, as wrela.dev's live page draws them, the rock alone so; 0, all once
/// (`--set FINE=0.3`, to see what the page gives up).
pub const FINE: f32 = 1.0

/// The skiff's hull: 0 the open rowing skiff it was, 1 a planing hull made for the sail (narrow,
/// flat-bottomed and flared, its bow swept up and decked) (`--set PLANING=1`).
pub const PLANING: f32 = 1.0

/// Where the camera stands: 0 the opening's shot, 1 the player's, up behind the skiff
/// (`Rig::framing`; `--set FRAMING=1`).
pub const FRAMING: f32 = 0.0

/// Whether the hero (Hakuro, content/hakuro: his fields realized and drawn into the painted
/// scene, `aboard`) stands to the sail: 1, him; 0 the traveller's figure in his place
/// (`--set HERO=0`).
pub const HERO: f32 = 1.0

pub fn init() -> State {
    targets(heavens(SUN, 3.0), 640, 360)
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    sized(mut s, width, height)
    // The player's keys: W sheets in, S lets the sail fly, A and D steer.
    for e in events() {
        key(mut s.rig, e)
    }
    let shot = painted(mut s, time, VIEW, 0.0, framing: FRAMING, fine: FINE)
    let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
    borrow hv = s.heavens
    draw(
        screen,
        cover,
        ink.bind(shot: shot, light: hv.light, colour: s.colour, marks: s.marks, normal: s.normal),
        vertices: 3,
    )
    screen.present()
}

/// Each frame records draws the host accepts.
@test(frames: 2)
fn frames_record_valid_draws() {}
