// The sea: a sum of long swells and shorter waves, their crests sharpened, moving on twos; and
// how it carries the skiff.

use look::noise

/// The rate the sea and the skiff are drawn at (a second's drawings): on ones at 24, as the clean
/// look's world moves. (12 holds them on twos, as a hand-drawn film's are.)
pub const HELD: f32 = 24.0

/// `time` held to the last drawing.
pub fn held(time: f32) -> f32 {
    floor(time * HELD) / HELD
}

/// One wave: a direction, a length (m) and a height (m).
struct Wave: Copy {
    dir: vec2,
    length: f32,
    height: f32,
}

const WAVES = [
    Wave { dir: vec2(0.20, 0.98), length: 46.0, height: 0.42 },
    Wave { dir: vec2(-0.62, 0.78), length: 23.0, height: 0.25 },
    Wave { dir: vec2(0.85, 0.53), length: 13.0, height: 0.16 },
    Wave { dir: vec2(-0.30, 0.95), length: 7.1, height: 0.085 },
    Wave { dir: vec2(0.55, -0.83), length: 4.3, height: 0.05 },
    Wave { dir: vec2(-0.93, 0.36), length: 2.6, height: 0.03 },
    Wave { dir: vec2(0.71, 0.70), length: 1.7, height: 0.02 },
    Wave { dir: vec2(-0.18, -0.98), length: 1.1, height: 0.012 },
]

/// The sea's height at `p` (x, z) at time `t`; `detail` from 0 to 1 says how much of the short
/// waves a pixel there can hold (far off, the swell alone).
pub fn height(p: vec2, t: f32, detail: f32) -> f32 {
    var h = 0.0
    for i in 0..8 {
        let w = WAVES[i]
        let k = 6.2831853 / w.length
        let speed = sqrt(9.81 / k)
        let x = dot(w.dir, p) * k - t * speed * k
        // A crest sharper than its trough: a sine's top, raised.
        let s = 0.5 + 0.5 * sin(x)
        let crest = s * s * (3.0 - 2.0 * s)
        let keep = if i < 2 { 1.0 } else { detail }
        h += w.height * (2.0 * crest - 1.0) * keep
    }
    h + (noise(p * 0.21 + vec2(t * 0.15, t * 0.31)) - 0.5) * 0.18 * detail
}

/// The ink of the crests' strokes at `p` and their pale lips (each 0 to 1): short curved strokes along the crests of the
/// shorter waves, broken into dashes, each about `px` m wide here (a pixel's footprint, before the slant `d` foreshortens it)
/// and gone where the wave's own height there is low.
pub fn strokes(p: vec2, t: f32, px: f32, d: vec3, h: f32) -> vec2 {
    let v = normalize(vec2(d.x, d.z))
    // The crests bend: the plane warped by a slow noise before the waves are read on it.
    let q = p + (vec2(noise(p * 0.045), noise(p * 0.045 + vec2(31.0, 7.0))) - vec2(0.5)) * 9.0
    let slant = max(abs(d.y), 0.03)
    var ink = 0.0
    var light = 0.0
    for i in 1..5 {
        let w = WAVES[i]
        let k = 6.2831853 / w.length
        let speed = sqrt(9.81 / k)
        let x = dot(w.dir, q) * k - t * speed * k + f32(i) * 1.7
        // How far from the crest (m), and along it.
        let signed = (fract((x - 1.5707963) / 6.2831853 + 0.5) - 0.5) * w.length
        let off = abs(signed)
        let along = dot(vec2(-w.dir.y, w.dir.x), q) / w.length
        // A pixel's footprint across this crest: foreshortened by the slant as far as the crest
        // runs across the view.
        let toward = dot(w.dir, v)
        let across = toward * slant
        let side = dot(w.dir, vec2(-v.y, v.x))
        let foot = px / sqrt(across * across + side * side)
        let width = foot * (1.0 + 0.8 * noise(vec2(along * 3.0, f32(i))))
        // A dash's width swells from its ends to its middle: a brush's stroke, not a bar.
        let dash = smoothstep(
            0.44,
            0.62,
            noise(vec2(along * 5.0 + f32(i) * 11.0, floor(x / 6.2831853) * 3.7)),
        )
        let stroke = 1.0 - smoothstep(width * dash * 0.7, width * dash * 1.3 + 0.0001, off)
        let high = smoothstep(-0.05, 0.25, h)
        ink = max(ink, stroke * high)
        // The crest's lit lip, a pale stroke just ahead of the ink.
        let lip = 1.0 -
            smoothstep(width * dash * 0.6, width * dash * 1.4 + 0.0001, abs(signed + width * 2.4))
        light = max(light, lip * high)
    }
    vec2(ink, light)
}

/// How much of wave `w` a pixel can hold: a pixel `px` m across (before the slant), seen along
/// `d`. Whole while a wave spans sixteen pixels; gone by six: finer, it only crawls and stairs,
/// and the clean look's water is drawn in its broad shapes.
/// (Foreshortened along the view: a wave running toward the eye goes first, one running across
/// it holds out to the horizon.)
fn kept(w: Wave, px: f32, d: vec3) -> f32 {
    let flat = vec2(d.x, d.z)
    let v = flat / max(length(flat), 1.0e-5)
    let slant = max(abs(d.y), 0.004)
    let toward = dot(w.dir, v) / slant
    let side = dot(w.dir, vec2(-v.y, v.x))
    let foot = px * sqrt(toward * toward + side * side)
    1.0 - smoothstep(0.05 * w.length, 0.2 * w.length, foot)
}

/// The sea at `p` as a pixel `px` m across, seen along `d`, sees it: each wave kept as far as
/// the pixel can hold it, the short ones `calm` of their height (by the skiff's hull, its lee).
/// Its height, its normal, and the slopes the pixel couldn't hold (their variance), which roughen
/// the sun's glint instead: so far off the sea turns to a sheen, its glitter one soft path.
pub fn surface(p: vec2, t: f32, px: f32, d: vec3, calm: f32) -> (f32, vec3, f32) {
    var h = 0.0
    var g = vec2(0.0)
    var lost = 0.0
    for i in 0..8 {
        let w = WAVES[i]
        let k = 6.2831853 / w.length
        let speed = sqrt(9.81 / k)
        let x = dot(w.dir, p) * k - t * speed * k
        let s = 0.5 + 0.5 * sin(x)
        let crest = s * s * (3.0 - 2.0 * s)
        let keep = kept(w, px, d) * (if i < 2 { 1.0 } else { calm })
        h += w.height * (2.0 * crest - 1.0) * keep
        // (The crest's slope: 2 H d(crest)/dx, crest' = 6 s (1 - s), s' = cos(x) / 2.)
        g += w.dir * (w.height * k * 6.0 * s * (1.0 - s) * cos(x) * keep)
        let slope = w.height * k * 0.75
        lost += slope * slope * (1.0 - keep * keep)
    }
    // The chop: a noise under the waves, about 5 m across.
    let foot = px * sqrt(0.5 / max(d.y * d.y, 1.6e-5) + 0.5)
    let chop_k = (1.0 - smoothstep(0.5, 1.2, foot)) * calm
    let q = p * 0.21 + vec2(t * 0.15, t * 0.31)
    let c0 = noise(q)
    h += (c0 - 0.5) * 0.18 * chop_k
    if chop_k > 0.0 {
        let cx = noise(q + vec2(0.06, 0.0)) - c0
        let cz = noise(q + vec2(0.0, 0.06)) - c0
        g += vec2(cx, cz) / 0.06 * 0.21 * 0.18 * chop_k
    }
    lost += 0.0036 * (1.0 - chop_k * chop_k)
    // Ripples under the waves, too small to trace: the normal's alone, while a pixel holds them.
    // (Faint: a hint of texture on the waves, not a glitter of its own.)
    let r1_k = (1.0 - smoothstep(0.03, 0.09, foot)) * 0.55
    let r2_k = (1.0 - smoothstep(0.012, 0.035, foot)) * 0.55
    var r = vec2(0.0)
    if r1_k > 0.0 {
        r += (vec2(noise(p * 1.7 + vec2(t * 0.9, 0.0)), noise(p * 1.7 + vec2(13.0, t * 0.7))) -
            vec2(0.5)) *
            r1_k
    }
    if r2_k > 0.0 {
        r += (vec2(noise(p * 4.3 + vec2(t * 1.6, 5.0)), noise(p * 4.3 + vec2(29.0, t * 1.3))) -
            vec2(0.5)) *
            0.6 *
            r2_k
    }
    lost += 0.006 * (1.0 - r1_k * r1_k / 0.3) + 0.002 * (1.0 - r2_k * r2_k / 0.3)
    let n = normalize(vec3(-g.x + r.x * 0.5, 1.0, -g.y + r.y * 0.5))
    (h, n, lost)
}

/// The sea's height alone, as `surface` sees it (for the ray that finds it).
pub fn level(p: vec2, t: f32, px: f32, d: vec3, calm: f32) -> f32 {
    var h = 0.0
    for i in 0..8 {
        let w = WAVES[i]
        let k = 6.2831853 / w.length
        let speed = sqrt(9.81 / k)
        let x = dot(w.dir, p) * k - t * speed * k
        let s = 0.5 + 0.5 * sin(x)
        let crest = s * s * (3.0 - 2.0 * s)
        let keep = kept(w, px, d) * (if i < 2 { 1.0 } else { calm })
        h += w.height * (2.0 * crest - 1.0) * keep
    }
    let foot = px * sqrt(0.5 / max(d.y * d.y, 1.6e-5) + 0.5)
    let chop_k = (1.0 - smoothstep(0.5, 1.2, foot)) * calm
    h + (noise(p * 0.21 + vec2(t * 0.15, t * 0.31)) - 0.5) * 0.18 * chop_k
}

/// How much of the short waves there are by the skiff (at `rel` from it, `x` and `z` its
/// across and along): in its lee they're broken, out past a hull's width they're whole.
pub fn lee(rel: vec3, x: vec3, z: vec3) -> f32 {
    let e = length(vec2(dot(rel, x) / 0.62, dot(rel, z) / 2.2))
    mix(CALM, 1.0, smoothstep(1.0, 2.6, e))
}

/// What's left of the short waves along the skiff's hull.
const CALM: f32 = 0.35

/// The sea's normal at `p`, its differences `e` m apart.
pub fn normal(p: vec2, t: f32, detail: f32, e: f32) -> vec3 {
    let hx = height(p + vec2(e, 0.0), t, detail) - height(p - vec2(e, 0.0), t, detail)
    let hz = height(p + vec2(0.0, e), t, detail) - height(p - vec2(0.0, e), t, detail)
    // Ripples under the waves, too small to trace: the normal's alone, gone where a pixel is wider.
    let r = vec2(noise(p * 1.7 + vec2(t * 0.9, 0.0)), noise(p * 1.7 + vec2(13.0, t * 0.7))) -
        vec2(0.5) +
        (vec2(noise(p * 4.3 + vec2(t * 1.6, 5.0)), noise(p * 4.3 + vec2(29.0, t * 1.3))) -
            vec2(0.5)) *
            0.6
    let fade = clamp(0.15 / e, 0.0, 1.0)
    let ripple = r * 0.5 * detail * fade * fade
    normalize(vec3(-hx, 2.0 * e, -hz) / (2.0 * e) + vec3(ripple.x, 0.0, ripple.y))
}

/// Where the sea holds the skiff at time `t`, at `at` (x, z) and steered `steer` from its drift,
/// and its axes (across, up, along): it rides the swell, pitched and rolled by its slope, slowly
/// turning.
pub fn bob(t: f32, at: vec2, steer: f32) -> (vec3, vec3, vec3, vec3) {
    let c = at
    let yaw = -0.22 + 0.05 * sin(t * 0.23) + steer
    let along0 = vec2(sin(yaw), cos(yaw))
    let across0 = vec2(cos(yaw), -sin(yaw))
    // The sea under it read where it bears on it: bow, stern and either side, as the water
    // there is by the hull (its short waves broken in its lee), so it sits in what's drawn.
    let bow = height(c + along0 * 1.5, t, CALM)
    let stern = height(c - along0 * 1.5, t, CALM)
    let port = height(c - across0 * 0.5, t, CALM)
    let star = height(c + across0 * 0.5, t, CALM)
    let mid = height(c, t, CALM)
    let y = (bow + stern + port + star + mid * 2.0) / 6.0 + 0.2
    // Pitched and rolled as those points lie, but not all the way: the hull's weight steadies it.
    let along_ = normalize(vec3(along0.x, (bow - stern) / 3.0 * 0.8, along0.y))
    let across_ = normalize(vec3(across0.x, (star - port) / 1.0 * 0.6, across0.y))
    let up = normalize(cross(along_, across_))
    let across = normalize(cross(up, along_))
    let along = cross(across, up)
    (vec3(c.x, y, c.y), across, up, along)
}
