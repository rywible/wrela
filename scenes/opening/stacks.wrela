// The sea's own rocks: stacks of the archipelago's bedded stone and the skerries round their feet, standing
// out of the open sea in clusters a few hundred metres apart, so the eye has something fixed to
// see the skiff pass. Built at their real size (a bed a few metres deep, a stack tens of metres
// tall), never a small rock scaled up; drawn in the far pass (`yonder`) with the
// rock, lit by the one light and seen through the one air.
//
// One cluster or none in each cell of a grid laid over the sea, its place, its kind and size from
// the cell's hash; each kept inside its cell, so the field is only ever the cell's own cluster
// and the way out of the cell (a ray steps to the cell's edge, then meets the next one's).
// None in the skiff's first reach, none in the lane it sails out along, none in front of the
// cathedral rock.

use look::{ISLE, hash2, noise, noise3}

/// A cell's side (m), and how far a cluster reaches from its middle (m): a cluster stays a margin
/// inside its cell.
const CELL: f32 = 170.0
const REACH: f32 = 50.0
/// How far out the rocks stand (m): past this, the sea is open to the horizon.
const OUT: f32 = 2600.0
/// The tallest rock (m).
pub const TALLEST: f32 = 64.0
/// How far under the sea the rocks reach (m): a stack's foot ends 12 m down (`stack`), its rough
/// faces a metre and a half past that; nothing of them is deeper.
const FLOOR: f32 = 16.0

/// Whether a cluster at `at` (x, z) is kept out: the skiff's first reach, the lane ahead of it,
/// the cathedral rock's bearing.
fn kept_out(at: vec2) -> bool {
    let r = length(at)
    let ahead = vec2(sin(-0.22), cos(-0.22))
    let along = dot(at, ahead)
    let off = abs(at.x * ahead.y - at.y * ahead.x)
    let to_isle = normalize(vec2(ISLE.x, ISLE.z))
    let bearing = dot(at / max(r, 1.0), to_isle)
    r < 120.0 + REACH ||
        (along > -60.0 && along < 900.0 && off < 40.0 + REACH) ||
        (bearing > cos(0.16) && r > 300.0)
}

/// Cell `c`'s cluster: its middle (x, z), its main stack's height and girth (m), and its seed;
/// height 0 if the cell has none.
fn cluster(c: vec2) -> vec4 {
    // (One placed: a tall stack and its skerries some sixty metres off the lane, two hundred
    // metres out, so the skiff passes close by something fixed in its first half minute.)
    if c.x == 0.0 && c.y == 1.0 {
        return vec4(70.0, 230.0, 46.0, 41.0)
    }
    let h = hash2(c * 0.913 + vec2(3.7))
    let at = (c + vec2(0.5)) * CELL + (vec2(hash2(c + vec2(1.1)), hash2(c + vec2(7.3))) - 0.5) * (CELL - 2.0 * REACH - 14.0)
    // (In groups: whole stretches of sea bare, and where the rock is, several cells together.)
    // (Thinner the farther out: a few far off, not a skyline of them along the horizon.)
    let gather = smoothstep(0.35, 0.7, noise(c * 0.21 + vec2(5.3))) * (1.0 - 0.65 * smoothstep(700.0, 2400.0, length(at)))
    if h > 0.45 * gather || kept_out(at) || length(at) > OUT {
        return vec4(at, 0.0, 0.0)
    }
    let size = hash2(c + vec2(5.9))
    vec4(at, 14.0 + (TALLEST - 18.0) * size * size, h * 97.0)
}

/// A stack: a pillar of bedded stone `r` m round and `tall` m high, leaning, its crown tilted and
/// broken into crags, its footprint lobed, its foot notched by the sea. `q` from its foot. (No detail finer than the
/// far pass's pixels hold steadily: what's finer crawls as the skiff moves.)
fn stack(q: vec3, r: f32, tall: f32, seed: f32, px: f32) -> f32 {
    let lean = vec2(hash2(vec2(seed, 1.0)) - 0.5, hash2(vec2(seed, 2.0)) - 0.5) * 0.22
    let v = vec2(q.x, q.z) - lean * max(q.y, 0.0)
    let rv = length(v)
    let dir = v / max(rv, 1.0e-3)
    let up = clamp(q.y / tall, 0.0, 1.0)
    // (Its sides cut back unevenly by sea and rain: broad buttresses and bays, changing as it
    // rises, never a pattern.)
    let ang = atan2(dir.y, dir.x)
    let around = vec2(cos(ang), sin(ang))
    let lobe = 1.0 + 0.36 * (noise(around * 1.3 + vec2(seed, q.y * 0.012)) - 0.5) +
        0.16 * (noise(around * 2.9 + vec2(seed * 2.0, q.y * 0.035)) - 0.5)
    // (Its beds weather back unevenly, a ledge standing out where a harder one lies, at no
    // set spacing; and only where a pixel holds them steadily.)
    let hard = smoothstep(0.55, 0.8, noise(vec2(q.y * 0.22, seed * 1.7)))
    let lip = 1.0 + 0.06 * hard * (1.0 - smoothstep(0.3, 1.0, px))
    // (Narrowing as it rises; the sea's notch cut deep into its foot.)
    let notch = 1.0 - 0.26 * exp(-pow((q.y - 2.2) / 2.2, 2.0))
    let girth = r * lobe * lip * (1.0 - 0.35 * up) * notch
    // (Its crown tilted and broken into crags, slumped toward one side.)
    let tilt = vec2(hash2(vec2(seed, 3.0)) - 0.5, hash2(vec2(seed, 4.0)) - 0.5) * 0.6
    let crags = noise(around * 2.4 + vec2(seed * 3.0)) * tall * 0.16
    let crown = tall - dot(v, tilt) - 0.15 * rv - crags
    // (Its faces rough: blocks proud and hollows fallen out, a few metres across, where a pixel
    // holds them steadily; its mass alone farther off.)
    let rough = (noise3(q * 0.16 + vec3(seed)) - 0.5) * 2.4 + (noise3(q * 0.4 + vec3(seed * 2.0)) - 0.5) * 0.9
    let shell = max(rv - girth, max(q.y - crown, -q.y - 12.0))
    (shell + rough * (1.0 - smoothstep(0.4, 1.6, px)) * smoothstep(8.0, 0.0, abs(shell))) * 0.6
}

/// The least `stack` can be at `q` for a stack `r` m round: no nearer than its widest girth (its
/// lobes and ledges `r` by 1.336 at most), leant as far as any leans (0.156 a metre up), and
/// roughened as far in as its faces go (1.65 m), scaled as it is (0.6).
fn least_stack(q: vec3, r: f32) -> f32 {
    (length(vec2(q.x, q.z)) - 0.156 * max(q.y, 0.0) - 1.336 * r - 1.65) * 0.6
}

/// A skerry: a low hump of broken rock, `r` m round and `tall` high, awash.
fn skerry(q: vec3, r: f32, tall: f32, seed: f32) -> f32 {
    let v = vec2(q.x, q.z)
    let wob = 1.0 + 0.35 * (noise(v / 7.0 + vec2(seed)) - 0.5)
    (length(vec3(v.x / r, q.y / tall, v.y / r)) - wob) * min(r, tall) * 0.7
}

/// The cluster in cell `c`, its field at `p`: its main stack and the lesser stacks and skerries
/// round it.
fn in_cluster(cl: vec4, p: vec3, px: f32) -> f32 {
    let q = p - vec3(cl.x, 0.0, cl.y)
    let tall = cl.z
    let seed = cl.w
    // (Some slender, some squat and broad as a bastion.)
    let girth = (4.5 + tall * 0.16) * mix(0.85, 1.7, hash2(vec2(seed, 9.0)))
    var d = stack(q, girth, tall, seed, px)
    // (The sea breaking round its foot: a collar of white water heaped against it, ragged.)
    let rq = length(vec2(q.x, q.z))
    let heap = 0.6 + 0.9 * noise(vec2(atan2(q.z, q.x) * 3.0 + seed, 0.0))
    d = min(d, max(abs(rq - girth * 1.12) - girth * 0.14 - 1.0, max(q.y - heap, -q.y - 1.0)) * 0.7)
    // (The fallen blocks round its foot, awash.)
    for i in 0..3 {
        let fi = f32(i)
        let a = hash2(vec2(seed, fi + 40.0)) * 6.2831853
        let at = vec3(cos(a), 0.0, sin(a)) * (girth * 1.05 + 2.0 + 3.0 * hash2(vec2(seed, fi + 50.0)))
        let br = 1.2 + 2.0 * hash2(vec2(seed, fi + 60.0))
        d = min(d, skerry(q - at, br * 1.3, br, seed + fi * 3.0))
    }
    for i in 0..4 {
        let fi = f32(i)
        let a = hash2(vec2(seed, fi + 10.0)) * 6.2831853
        let reach = 14.0 + 24.0 * hash2(vec2(seed, fi + 20.0))
        let at = vec3(cos(a) * reach, 0.0, sin(a) * reach)
        let k = hash2(vec2(seed, fi + 30.0))
        if k < 0.45 {
            let t2 = tall * (0.25 + 0.5 * k)
            let r = 2.5 + t2 * 0.2
            // (Only where it could be the nearer: a stack is costly, and most points are nearer
            // the main one by far. Where its least is no nearer, `d` stands as it would.)
            if least_stack(q - at, r) < d {
                d = min(d, stack(q - at, r, t2, seed + fi * 7.0, px))
            }
        } else {
            d = min(d, skerry(q - at, 4.0 + 7.0 * k, 1.5 + 3.0 * k, seed + fi))
        }
    }
    d
}

/// The rocks' field at `p` (m): the nearest rock of its cell, or the way out of the cell.
pub fn stacks(p: vec3, px: f32) -> f32 {
    if p.y > TALLEST + 4.0 {
        return p.y - TALLEST
    }
    let g = vec2(p.x, p.z) / CELL
    let c = floor(g)
    let local = (g - c) * CELL
    // (Clusters stand a margin inside their cells, so the way out of this one is a step past
    // its edge and no nearer any rock: never so near the ray takes it for one.)
    let out = min(min(local.x, CELL - local.x), min(local.y, CELL - local.y)) + 5.0
    in_cell(c, p, px, out)
}

/// How far a ray at `p` going `d` may step toward the rocks: `stacks`, but the way out of the
/// cell taken along the ray, not to the cell's nearest side. (A ray running close beside a
/// cell's side, as the opening's middle column runs beside x = 0, took steps only as long as it
/// was near that side, a few metres, and ran out of steps short of the rocks it looked at.)
fn stacks_along(p: vec3, d: vec3, px: f32) -> f32 {
    if p.y > TALLEST + 4.0 {
        return p.y - TALLEST
    }
    let g = vec2(p.x, p.z) / CELL
    let c = floor(g)
    let local = (g - c) * CELL
    let dxz = vec2(d.x, d.z)
    let to_x = if dxz.x > 0.0 { (CELL - local.x) / dxz.x } else if dxz.x < 0.0 { local.x / -dxz.x } else {
        1.0e5
    }
    let to_z = if dxz.y > 0.0 { (CELL - local.y) / dxz.y } else if dxz.y < 0.0 { local.y / -dxz.y } else {
        1.0e5
    }
    // (Past the side by a step: the next cell's rocks stand further in from it than that.)
    in_cell(c, p, px, min(to_x, to_z) + 5.0)
}

/// The rocks of cell `c` at `p`, or `out`, the way out of the cell, if that's nearer.
fn in_cell(c: vec2, p: vec3, px: f32, out: f32) -> f32 {
    let cl = cluster(c)
    if cl.z <= 0.0 {
        return max(out, 1.0)
    }
    let near = length(vec2(p.x, p.z) - vec2(cl.x, cl.y)) - REACH
    if near > 4.0 {
        return min(near, out)
    }
    min(in_cluster(cl, p, px), out)
}

/// Whether any rock could stand within `margin` m of the ground from `lo` to `hi` (x, z): a
/// cluster's reach round its middle meets it. (True past a few cells across: asked of a wide
/// stretch, it doesn't count.)
pub fn stacks_near(lo: vec2, hi: vec2, margin: f32) -> bool {
    let c0 = floor(lo / CELL)
    let c1 = floor(hi / CELL)
    if c1.x - c0.x > 6.0 || c1.y - c0.y > 6.0 {
        return true
    }
    var cy = c0.y
    while cy <= c1.y {
        var cx = c0.x
        while cx <= c1.x {
            let cl = cluster(vec2(cx, cy))
            if cl.z > 0.0 {
                let q = clamp(cl.xy, lo, hi)
                if length(q - cl.xy) < REACH + margin {
                    return true
                }
            }
            cx += 1.0
        }
        cy += 1.0
    }
    false
}

/// How far out from the world's middle the rocks can stand (m, x and z).
pub fn stacks_reach() -> f32 {
    OUT * 1.2
}

/// Where the ray `o` + `d` meets the rocks, from the eye to `hi` (or `hi`); `k` a pixel's width
/// per metre out.
pub fn march_stacks(o: vec3, d: vec3, hi: f32, k: f32) -> f32 {
    march_stacks_from(o, d, 0.0, hi, k)
}

/// `march_stacks` from `from` along the ray on (where the stacks' meshes say the nearest could
/// be: `stacked`), not from the eye.
pub fn march_stacks_from(o: vec3, d: vec3, from: f32, hi: f32, k: f32) -> f32 {
    if from >= hi {
        return hi
    }
    // (Only where the ray is low enough to meet one, out to where they stop.)
    var lo = from
    var top = hi
    // The clusters occupy a world-space circle, not one round the eye. Once the skiff sailed
    // past it, a fixed distance from the eye hid the stacks when it looked back toward them.
    let o2 = vec2(o.x, o.z)
    let d2 = vec2(d.x, d.z)
    let a = dot(d2, d2)
    let reach = OUT * 1.2
    if a > 1.0e-12 {
        let b = dot(o2, d2)
        let c = dot(o2, o2) - reach * reach
        let disc = b * b - a * c
        if disc < 0.0 { return hi }
        let root = sqrt(max(disc, 0.0))
        lo = max(lo, (-b - root) / a)
        top = min(top, (-b + root) / a)
    } else if dot(o2, o2) > reach * reach {
        // A vertical ray never enters the circle.
        return hi
    }
    if d.y > 0.0 {
        top = min(top, max(TALLEST + 4.0 - o.y, 0.0) / d.y)
    } else if d.y < 0.0 {
        if o.y > TALLEST + 4.0 {
            lo = max(lo, (o.y - TALLEST - 4.0) / -d.y)
        }
        // (Nor under the sea past where the rocks' feet end, `FLOOR` down: a ray that looks
        // down at the water went on under it, out past every cell to where they stop, and met
        // nothing there the sea doesn't hide.)
        top = min(top, max(o.y + FLOOR, 0.0) / -d.y)
    } else if o.y > TALLEST + 4.0 || o.y < -FLOOR {
        return hi
    }
    var t = lo
    var hit = hi
    var i = 0
    while i < 320 && t < top {
        let px = t * k
        let h = stacks_along(o + d * t, d, px)
        if h < max(px * 0.4, 0.01) {
            hit = t
            t = top
        } else {
            // (Never less than a fraction of a pixel a step: a ray grazing the sea past many
            // rocks would otherwise run out of steps short of one, and see through it.)
            t += max(h, px * 0.25)
        }
        i += 1
    }
    if hit < hi {
        for _ in 0..2 {
            hit += stacks(o + d * hit, hit * k) * 0.9
        }
    }
    hit
}

@test
fn a_stack_remains_visible_from_beyond_the_archipelago() {
    let p = vec3(70.0, 15.0, 230.0)
    assert(stacks(p, 0.01) < 0.0, "the placed stack occupies this point")
    let clear = normalize(vec2(ISLE.x, ISLE.z))
    let d = normalize(vec3(-clear.x, 12.5 / 4300.0, -clear.y))
    let near = march_stacks(p - d * 100.0, d, hi: 10000.0, k: 0.0001)
    let far = march_stacks(p - d * 4300.0, d, hi: 10000.0, k: 0.0001)
    assert(near < 100.0, "the default stack is met nearby")
    assert(far < 10000.0, "the same stack is still met from a distant low camera")
    assert(far > OUT * 1.2, "the first visible stack lies past the former eye-relative cap")
    let at = p - d * 4300.0 + d * far
    assert(stacks(at, far * 0.0001) < 0.5, "the distant hit belongs to actual stack geometry")
}

@test
fn stack_world_bounds_handle_outward_missing_and_vertical_rays() {
    let far = 10000.0
    assert(march_stacks(vec3(4000.0, 15.0, 0.0), vec3(1.0, 0.0, 0.0), hi: far, k: 0.001) == far)
    assert(march_stacks(vec3(4000.0, 15.0, 0.0), vec3(0.0, 0.0, 1.0), hi: far, k: 0.001) == far)
    assert(march_stacks(vec3(4000.0, 80.0, 0.0), vec3(0.0, -1.0, 0.0), hi: far, k: 0.001) == far)
    assert(march_stacks(vec3(4000.0, 80.0, 0.0), normalize(vec3(-1.0e-8, -1.0, 0.0)), hi: far, k: 0.001) == far)
    assert(march_stacks(vec3(70.0, 80.0, 230.0), vec3(0.0, 0.0, 1.0), hi: far, k: 0.001) == far)
    assert(march_stacks(vec3(70.0, 80.0, 230.0), vec3(0.0, -1.0, 0.0), hi: far, k: 0.001) < far)
    assert(march_stacks(vec3(70.0, 80.0, 230.0), normalize(vec3(1.0e-8, -1.0, 0.0)), hi: far, k: 0.001) < far)
}

/// The rocks' normal at `p`, read `e` m apart.
pub fn stacks_normal(p: vec3, e: f32, px: f32) -> vec3 {
    let a = vec2(1.0, -1.0)
    normalize(
        a.xyy * stacks(p + a.xyy * e, px) +
            a.yyx * stacks(p + a.yyx * e, px) +
            a.yxy * stacks(p + a.yxy * e, px) +
            a.xxx * stacks(p + a.xxx * e, px),
    )
}

/// How much of the light from `l` reaches `p` past the rocks (a soft shadow, a few steps).
pub fn stacks_shadow(p: vec3, l: vec3, px: f32) -> f32 {
    var t = 0.3 + px
    var lit = 1.0
    for _ in 0..24 {
        let h = stacks(p + l * t, px)
        lit = min(lit, 8.0 * h / t)
        t += clamp(h, 0.4, 12.0)
    }
    clamp(lit, 0.0, 1.0)
}

/// How much of the sky reaches `p`, facing `n`.
pub fn stacks_ao(p: vec3, n: vec3, px: f32) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..5 {
        let h = 1.2 * f32(i * i)
        hidden += w * max(h - stacks(p + n * h, px), 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.5, 0.0, 1.0)
}

/// The basalt at `p` facing `n`: dark blue-grey, each column a shade of its own (where a pixel
/// `px` holds it), the tops pale with salt and the birds, wet and darker in the spray's reach,
/// and white where the sea breaks on its foot.
pub fn stacks_albedo(p: vec3, n: vec3, px: f32) -> vec3 {
    // The archipelago's own bedded stone, the cathedral rock's: warm sandstone and grey beds,
    // level, its bands read from far off; darker with the sea's wet.
    // (Its finer beds, a few metres deep, only where a pixel holds them; else their mean.)
    let fine = 1.0 - smoothstep(0.3, 1.0, px)
    let bed = mix(0.5, noise(vec2(p.y * 0.35 + noise(vec2(p.x + p.z, p.x - p.z) * 0.05) * 1.5, 0.5)), fine)
    var a = mix(vec3(0.20, 0.15, 0.13), vec3(0.42, 0.33, 0.25), bed)
    let band_ = smoothstep(0.35, 0.65, noise(vec2(p.y * 0.08, 7.0)))
    a = mix(a, vec3(0.42, 0.42, 0.42) * (0.8 + 0.4 * bed), (1.0 - band_) * 0.5)
    a *= 1.0 + 0.4 * (noise(vec2(p.x * 0.3 + p.z * 0.2, p.y * 0.5)) - 0.5) * fine
    // Tops: salt-pale and birds' white.
    a = mix(a, vec3(0.22, 0.22, 0.2), smoothstep(0.55, 0.9, n.y) * 0.7)
    let guano = smoothstep(0.7, 0.85, noise(vec2((p.x + p.z) * 0.12, p.y * 0.04))) *
        smoothstep(10.0, 25.0, p.y) *
        smoothstep(0.4, -0.1, n.y)
    a = mix(a, vec3(0.42, 0.42, 0.4), guano * 0.35)
    // Down its faces: gullies the rain has cut, darker, and the pale streaks of salt and the
    // birds run down under its ledges; a few metres wide, so they hold steady far off.
    let gully = smoothstep(0.62, 0.78, noise3(vec3(p.x * 0.18, p.y * 0.02, p.z * 0.18)))
    a *= 1.0 - 0.45 * gully * smoothstep(0.6, 0.1, abs(n.y))
    let streak = smoothstep(0.66, 0.8, noise3(vec3(p.x * 0.22 + 5.0, p.y * 0.015, p.z * 0.22))) *
        smoothstep(3.0, 12.0, p.y)
    a = mix(a, vec3(0.5, 0.5, 0.48), streak * 0.5 * smoothstep(0.6, 0.1, abs(n.y)))
    // The spray's reach, wet; and the surf on its foot.
    a *= mix(0.45, 1.0, smoothstep(0.5, 6.0, p.y))
    // (The sea breaking on it: white a few metres up its foot, torn above, and higher where the
    // swell throws it.)
    let reach = 2.5 + 3.0 * noise(vec2((p.x - p.z) * 0.08, 1.0))
    let torn = mix(0.45, noise(vec2(p.x * 0.4 + p.z * 0.3, p.y * 0.9)), fine)
    let surf = max(
        smoothstep(reach, reach * 0.3, p.y) * smoothstep(0.25, 0.55, torn + 0.3 * smoothstep(reach * 0.5, 0.0, p.y)),
        smoothstep(1.4, 0.6, p.y),
    )
    // (On its sides and round its foot; far off a pale seam, never a spark.)
    let seen = mix(1.0, smoothstep(0.85, 0.45, n.y), smoothstep(0.8, 2.0, p.y)) * mix(0.95, 0.45, smoothstep(0.6, 3.0, px))
    mix(a, vec3(0.72, 0.74, 0.76), surf * seen)
}
