// The second pass: the ink and the paper. A line is drawn where what the first pass wrote changes
// between a pixel and its neighbours (what the ray met, how far, the normal's turn, the line
// field's sign), a hand's width that wobbles and boils from drawing to drawing. Where the moment is
// kinetic (the frame's `Shot::kinetic`, or a pixel's own: the bow's cut, the skiff's slap) the
// lines fray: they break into strands, throw off static, and the palette drains toward black
// and white. Quiet, it's a painting with ink; at the edges of a violent thing, chaos.

use look::{INK, PAPER, SEA, SKY, Shot, band, hash2, luma, noise}
use engine::light::{Light, display}
use std::gpu::{FragCoord, Rgba16Float, Rgba8, Texture}

/// A pixel's texel of a target, its coordinates clamped to it.
fn at(t: Texture<Rgba16Float>, p: vec2, size: vec2) -> vec4 {
    let q = clamp(p, vec2(0.0), size - vec2(1.0))
    t.load(u32(q.x), u32(q.y))
}

fn at8(t: Texture<Rgba8>, p: vec2, size: vec2) -> vec4 {
    let q = clamp(p, vec2(0.0), size - vec2(1.0))
    t.load(u32(q.x), u32(q.y))
}

/// How much of a line lies between two samples: `a` and `b` what each met (`look`'s marks), `na`
/// and `nb` their normals.
fn edge(a: vec4, b: vec4, na: vec3, nb: vec3) -> f32 {
    let near = if a.x < b.x { a } else { b }
    if abs(a.y - b.y) > 0.5 {
        // The horizon's a thin line; any other change of what was met, a full one.
        let horizon = (a.y == SKY && b.y == SEA) || (a.y == SEA && b.y == SKY)
        let w = if horizon { 0.35 } else { max(near.w, 0.6) }
        return w
    }
    if a.y == SKY {
        // A cloud's edge.
        let cross = if (a.z < 0.0) != (b.z < 0.0) { 1.0 } else { 0.0 }
        return cross * max(a.w, b.w)
    }
    var e = 0.0
    // A fold in depth: one thing in front of another part of itself.
    // (Not on the sea: toward the horizon each pixel reaches much further than the last.)
    if a.y != SEA {
        e = max(e, band(abs(a.x - b.x), 0.10, 0.03) * near.w)
    }
    // A crease, on solid things.
    if a.y > SEA + 0.5 && near.x < 9.0 {
        e = max(e, band(1.0 - dot(na, nb), 0.30, 0.08) * 0.8 * near.w)
    }
    // The line field's zero: crests, strata, seams.
    if (a.z < 0.0) != (b.z < 0.0) {
        e = max(e, 0.7 * near.w)
    }
    e
}

/// The render, drawn: its values grouped into bands with brushy edges, and hatching laid in the
/// shadows of solid things (on the sea, long level strokes). `s.style` says how much.
fn styled(s: Shot, c: vec3, px: vec2, m: vec4, scale: f32, seed: f32) -> vec3 {
    let l = max(luma(c), 1.0e-4)
    // The brush's edge: the bands' boundaries broken by a slow noise and the paper's grain.
    let brush = (noise(px / (scale * 45.0) + vec2(seed * 0.05, 0.0)) - 0.5) * 0.6 +
        (noise(px / (scale * 11.0) + vec2(0.0, seed * 0.1)) - 0.5) * 0.3 +
        (noise(px / (scale * 2.5)) - 0.5) * 0.08
    let steps = 6.0
    let x = pow(l, 0.75) * steps + brush
    let q = (floor(x) + smoothstep(0.22, 0.78, fract(x))) / steps
    let banded = c * (pow(max(q, 0.0), 1.0 / 0.75) / l)
    var o = mix(c, banded, (if m.y == SKY { 0.3 } else { 0.65 }) * s.style)
    // Hatching: in the shadow band of what's solid, one way; deeper, crossed.
    let solid = m.y > SEA + 0.5
    let far = clamp((m.x - 8.0) / 3.0, 0.0, 1.0)
    let wob = (noise(px / (scale * 40.0) + vec2(seed * 0.5, 9.0)) - 0.5) * 0.6
    let h1 = 1.0 - band(abs(fract((px.x + px.y) / (4.5 * scale) + wob) - 0.5), 0.14, 0.05)
    let h2 = 1.0 - band(abs(fract((px.x - px.y * 0.6) / (4.5 * scale) - wob) - 0.5), 0.14, 0.05)
    let gaps = band(noise(px / (scale * 5.0) + vec2(seed, 1.0)), 0.25, 0.1)
    if solid {
        let shadow = 1.0 - band(l, 0.16, 0.04)
        let deep = 1.0 - band(l, 0.07, 0.03)
        let hatch = max(h1 * shadow, h2 * deep) * gaps * (1.0 - 0.6 * far)
        o = mix(o, o * 0.35 + INK * 0.05, hatch * 0.55 * s.style)
    } else if m.y == SEA {
        let lv = 1.0 - band(abs(fract(px.y / (3.5 * scale) + wob * 0.3) - 0.5), 0.12, 0.05)
        let dash = band(noise(vec2(px.x / (scale * 22.0) + seed, px.y / (scale * 3.5))), 0.55, 0.08)
        let shadow = 1.0 - band(l, 0.1, 0.04)
        let near = clamp((7.5 - m.x) / 2.0, 0.0, 1.0)
        o = mix(o, o * 0.4, lv * dash * shadow * near * 0.5 * s.style)
    }
    o
}

const AROUND = [
    vec2(1.0, 0.0),
    vec2(-1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(0.0, -1.0),
    vec2(0.7071, 0.7071),
    vec2(-0.7071, 0.7071),
    vec2(0.7071, -0.7071),
    vec2(-0.7071, -0.7071),
]

@fragment
pub fn ink(
    pixel: FragCoord,
    shot: Shot,
    light: Light,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
) -> vec4 {
    let s = shot
    let size = s.resolution
    let px = pixel.position.xy
    let scale = size.y / 720.0
    let seed = s.held * 12.0
    let c0 = display(light, at(colour, px, size).xyz)
    let m0 = at(marks, px, size)
    let n0 = at8(normal, px, size)
    let c0 = styled(s, c0, px, m0, scale, seed)
    // The energy here: the frame's, or the most of this pixel's and its near neighbours'.
    var local = n0.w
    for i in 0..4 {
        let o = AROUND[i] * 5.0 * scale
        local = max(local, at8(normal, px + o, size).w * 0.8)
    }
    let energy = clamp(max(s.kinetic, local), 0.0, 1.0)
    // The pen's width: a hand's, wobbling along the line and boiling between drawings.
    let wob = noise(px / (scale * 40.0) + vec2(seed * 0.37, 0.0)) - 0.5
    let r = scale * (1.15 + 0.7 * wob) * (1.0 + 0.15 * energy)
    // Strands: the line drawn again by a hand that doesn't quite find it, each stroke pushed off
    // along a slow wander of its own, the more so the more kinetic it is. Quiet, one strand.
    var line = 0.0
    for k in 0..3 {
        let kk = f32(k)
        // Quiet, a second strand faintly: the sketch's searching line.
        let sketch = if k == 1 { 0.4 * s.style } else { 0.0 }
        let lift = if k == 0 { 1.0 } else { max(band(energy, 0.12 + 0.12 * kk, 0.06), sketch) }
        let wander = vec2(
            noise(px / (scale * 14.0) + vec2(seed * 1.3 + kk * 17.0, kk * 5.0)),
            noise(px / (scale * 14.0) + vec2(kk * 9.0, seed * 0.9 + kk * 23.0)),
        ) -
            vec2(0.5)
        let shove = wander * scale * (1.0 + 7.0 * energy) * (if k == 0 { 0.6 } else { 1.0 + kk })
        var e = 0.0
        for i in 0..8 {
            let q = px + shove + AROUND[i] * r * (if k == 0 { 1.0 } else { 0.6 })
            let mq = at(marks, q, size)
            let nq = at8(normal, q, size)
            e = max(e, edge(m0, mq, n0.xyz * 2.0 - 1.0, nq.xyz * 2.0 - 1.0))
        }
        // Each strand breaks where its own slow noise falls: dashes, then fragments.
        let gaps = noise(px / (scale * 9.0) + vec2(seed * 2.3 + kk * 41.0, kk * 13.0))
        let kept = 1.0 - band(gaps, 1.0 - 0.6 * energy, 0.05) * band(energy, 0.1, 0.05)
        line = max(line, e * kept * lift * (if k == 0 { 1.0 } else { 0.85 }))
    }
    line *= mix(1.0, 1.0, s.style)
    // Kinetic, streaks: long thin strokes torn off the lines along one slant, as the frame's
    // ink is pulled out of it.
    let slant = normalize(vec2(1.0, -0.35))
    let along = dot(px, slant) / (scale * 70.0)
    let athwart = dot(px, vec2(-slant.y, slant.x)) / (scale * 1.6)
    let tear = band(noise(vec2(along + seed * 0.7, athwart)), 0.78 - 0.1 * energy, 0.03)
    var by_line = 0.0
    for i in 0..8 {
        let q = px - slant * scale * (6.0 + 10.0 * f32(i))
        by_line = max(
            by_line,
            edge(
                at(marks, q, size),
                at(marks, q + vec2(r, 0.0), size),
                at8(normal, q, size).xyz * 2.0 - 1.0,
                at8(normal, q + vec2(r, 0.0), size).xyz * 2.0 - 1.0,
            ),
        )
    }
    let streak = tear * band(by_line, 0.4, 0.1) * band(energy, 0.35, 0.1)
    // Flecks thrown off the line: short dashes in cells round it, sparse, each its own angle.
    let cell = 7.0 * scale
    let id = floor(px / cell)
    let h = hash2(id + vec2(seed * 3.1, 7.0))
    let centre = (id +
        vec2(0.25 + 0.5 * hash2(id + vec2(1.0, seed)), 0.25 + 0.5 * hash2(id + vec2(seed, 2.0)))) *
        cell
    let turn = hash2(id + vec2(seed * 5.7, 3.0)) * 3.14159
    let axis = vec2(cos(turn), sin(turn))
    let rel = px - centre
    let dash = 1.0 - band(abs(dot(rel, vec2(-axis.y, axis.x))), 0.7 * scale, 0.3 * scale)
    let dash_len = 1.0 - band(abs(dot(rel, axis)), 2.2 * scale, 0.6 * scale)
    var near_line = 0.0
    for i in 0..4 {
        let q = centre + AROUND[i] * r * 3.0
        near_line = max(
            near_line,
            edge(
                at(marks, centre, size),
                at(marks, q, size),
                at8(normal, centre, size).xyz * 2.0 - 1.0,
                at8(normal, q, size).xyz * 2.0 - 1.0,
            ),
        )
    }
    let fleck = dash *
        dash_len *
        band(h, 1.0 - 0.5 * energy, 0.01) *
        band(energy, 0.2, 0.05) *
        band(near_line, 0.5, 0.08)
    // Kinetic, the ink commits: a line is there or it isn't, no grey.
    let committed = mix(line, band(line, 0.45, 0.08), band(energy, 0.3, 0.1))
    let ink_line = clamp(max(max(committed, fleck), streak * 0.8), 0.0, 1.0)
    // The palette drains toward ink and paper as the energy rises past the middle: three values,
    // and hatching in the middle one, as a page of manga.
    var c = c0
    let v = pow(max(luma(c0), 0.0), 0.4545)
    let tone = band(v, 0.30, 0.02) * 0.5 + band(v, 0.60, 0.02) * 0.5
    let hatch_q = (px.x + px.y) / (5.0 * scale) +
        (noise(px / (scale * 60.0) + vec2(seed)) - 0.5) * 0.4
    let hatch = band(abs(fract(hatch_q) - 0.5), 0.32, 0.06)
    let mid = mix(INK * 1.4, PAPER * 0.92, hatch)
    let cross_q = (px.x - px.y) / (5.0 * scale) +
        (noise(px / (scale * 60.0) + vec2(seed, 3.0)) - 0.5) * 0.4
    let cross = band(abs(fract(cross_q) - 0.5), 0.3, 0.06)
    let dark = mix(INK * 1.4, PAPER * 0.85, hatch * cross * 0.6)
    let bw = if tone < 0.25 { mix(dark, mid, tone * 4.0) } else {
        mix(mid, PAPER, clamp(tone * 2.0 - 1.0, 0.0, 1.0))
    }
    // The frame's own level alone drains it: a pixel's local fray never takes the colour.
    c = mix(c, bw, band(s.kinetic, 0.62, 0.22))
    // The ink, warmer and thinner far off (what the first pass weighed), dark near.
    // Quiet, the ink is the form's own colour, deepened: it sits on the 3D form, not over it.
    // Kinetic, it turns to ink.
    let ink_c = mix(c * c * 0.45, INK * 0.7, band(energy, 0.25, 0.15))
    c = mix(c, ink_c, ink_line)
    // The sun's glints on the sea, drawn: four-pointed stars where it's brightest.
    let gcell = 9.0 * scale
    let gid = floor(px / gcell)
    let gc = (gid + vec2(0.5)) * gcell
    let gm = at(marks, gc, size)
    let gl = luma(display(light, at(colour, gc, size).xyz))
    let gh = hash2(gid + vec2(seed * 1.7, 11.0))
    if gm.y == SEA && gl > 0.82 && gh < 0.45 * s.style {
        let rel = px - gc
        let arm = (2.5 + 4.0 * gh) * scale * smoothstep(0.82, 1.0, gl)
        let star = max(
            (1.0 - band(abs(rel.y), 0.35 * scale, 0.25 * scale)) *
                (1.0 - band(abs(rel.x), arm, arm * 0.6)),
            (1.0 - band(abs(rel.x), 0.35 * scale, 0.25 * scale)) *
                (1.0 - band(abs(rel.y), arm * 0.8, arm * 0.5)),
        )
        c = mix(c, vec3(1.0, 0.96, 0.85), star * 0.9)
    }
    // The paper: its tooth and fibres, and a vignette as a page's edge darkens.
    let tooth = noise(px / (1.3 * scale)) * 0.6 + noise(px / (6.0 * scale)) * 0.4
    c *= 0.975 + 0.035 * tooth
    let uv = px / size - vec2(0.5)
    c *= 1.0 - 0.18 * pow(length(uv * vec2(1.0, 1.2)), 2.4)
    vec4(c, 1.0)
}
