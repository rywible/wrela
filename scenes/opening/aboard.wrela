// Hakuro aboard: the hero (content/hakuro, written as fields on his skeleton) realized once as the
// engine realizes a character (`engine::realize`), stood to the skiff as the sailing holds its
// traveller (`Shot`'s hips, neck, hands and feet), and drawn into the painted scene.
//
// The scene is traced and he's a mesh, so the two meet by depth: he's drawn into his own targets
// where he's nearer than what was painted there (`hero`, reading the paint's distance), then laid
// over the paint's (`laid`), so the ink treats him as it treats the skiff. His colours and his
// normal are his fields' own, read again at each pixel from where the pixel is on him at rest:
// as fine as his fields, however coarse his mesh. He's lit as the skiff is (`paint::lit_solid`,
// its sea bounce and its rim), shadowed by the rig and the clouds.

use hakuro::arms::{Drape, drape_room, draped, follow_legs, hand, jacket, sampled_body}
use hakuro::hakuro::{
    ARM_CHARTS, Cloth, FINGER_JOINTS, SHADED_DETAIL, arm_charts, body_paint, chart_paint, coat,
    head, hero, jacket_paint,
}
use engine::chart
use engine::chart::{Grids, Limb, Radial}
use engine::creature::{Creature, MAX_BONES, PartMask, Parts}
use engine::character::skin_matrix
use engine::look::CreatureLook
use engine::look::Mesh as Tolerance
use engine::light::{Light, Lit, world}
use engine::realize::{Mesh, SkinVertex, realize_once}
use engine::sky::{Clouds, cloud_shadow, sky_uv}
use heavens::Heavens
use look::{OVERCAST, SKIFF, Shot}
use main::{FREEBOARD, HERO_POP, INKED}
use paint::{Heaven, Overhead, lit_solid, overhead, storm_sky}
use played::cover
use sail::{BOOM, BOW_OUT, LASHED, trimming}
use sail::FOOT as RIG_FOOT
use skiff::vessel_shadow
use std::gpu::{
    ClipPosition, DepthTexture, Flat, FragCoord, GpuBuffer, Rgba16Float, Rgba8, Sampler, Targets3,
    Texture, Texture3d, VertexIndex, begin_pass3, begin_pass3_with_depth, buffer, depth_texture,
    Cull, GlobalId, Slots, discard, dispatch, draw, texture, write,
}
use std::math::PI

// ---- his meshes ----------------------------------------------------------------------------

/// His body's grid (cells of about 13 mm: what a realization's scratch has room for over a
/// T-pose's span), his head's (5 mm: the mask's ears and the hair's spikes), his coat's tails'
/// (7 mm: thin cloth) and his hands' (6 mm: thin fingers).
const BODY = CreatureLook {
    surface: Tolerance { tolerance: 1.0e-3, radius: 0.021, largest: 0.013 },
}
const HEAD = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.007, largest: 0.005 },
}
const COAT = CreatureLook {
    surface: Tolerance { tolerance: 0.5e-3, radius: 0.012, largest: 0.007 },
}

/// Hakuro realized, his palette, and the targets he's drawn into before he's laid over the
/// paint's.
pub struct Aboard {
    body: Mesh,
    head: Mesh,
    coat: Mesh,
    // (His sampled meshes: his body, his jacket and his hands.)
    sampled: [Mesh; 4],
    // (His arms, and the wrap and the gauntlet over them, as his pose has them this drawing:
    // drawn along their charts, `hakuro::arm_charts`, on the grids charted forms are drawn on.)
    arms: [Limb<16, 13>; ARM_CHARTS],
    grids: Grids,
    palette: GpuBuffer<mat4>,
    // (The sky's light from his three fixed directions, once a frame: `hero_skies`.)
    skies: GpuBuffer<vec4>,
    // (His palette a moment ago, each frame eased toward his. Drawn after his own in `palette`.)
    lagged: [mat4; 64],
    // (Where his coat's tails are draped over his legs this frame: `hakuro::arms::draped`.)
    drape: Drape,
    fresh: bool,
    // (The drawing's time he was last stepped to.)
    held: f32,
    // (His ride: how far the hull's lurches have pressed his hips from where they'd be (m, the
    // skiff's frame) and how fast, and the hull's last place and velocity in the world.)
    give: vec3,
    give_v: vec3,
    last_boat: vec3,
    last_v: vec3,
    // (The hull's last pitch and roll: how far its bow and its side were tipped up.)
    last_tip: vec2,
    rode: u32,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
    depth: DepthTexture,
    // The paint's own targets as they were before he's laid over them (his edges blend with
    // them).
    under_colour: Texture<Rgba16Float>,
    under_marks: Texture<Rgba16Float>,
    under_normal: Texture<Rgba8>,
    width: u32,
    height: u32,
}

/// He's drawn at this many times the screen's resolution each way, and his samples averaged
/// down to each pixel as he's laid over the paint: his edges smooth as the paint's are.
const FINER: u32 = 2

/// Hakuro realized from his fields.
pub fn aboard() -> Aboard {
    let parts = arm_charts()
    var arms = [parts[0].rest(); ARM_CHARTS]
    for a in 0..ARM_CHARTS {
        arms[a] = parts[a].rest()
    }
    Aboard {
        body: realize_once(hero(), BODY),
        head: realize_once(head(), HEAD),
        coat: follow_legs(realize_once(coat(), COAT)),
        // (His body, jacket and hands are sampled from the reference's own surface:
        // `hakuro::arms`.)
        sampled: [sampled_body(), jacket(), hand(0), hand(1)],
        arms,
        grids: chart::grids(),
        palette: buffer(2 * MAX_BONES),
        skies: buffer(SKIES),
        lagged: [mat4(vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0)); 64],
        drape: drape_room(1),
        fresh: true,
        held: 0.0,
        give: vec3(0.0),
        give_v: vec3(0.0),
        last_boat: vec3(0.0),
        last_v: vec3(0.0),
        last_tip: vec2(0.0),
        rode: 0,
        colour: texture(width: 1, height: 1),
        marks: texture(width: 1, height: 1),
        normal: texture(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        under_colour: texture(width: 1, height: 1),
        under_marks: texture(width: 1, height: 1),
        under_normal: texture(width: 1, height: 1),
        width: 1,
        height: 1,
    }
}

// ---- standing him to the sail --------------------------------------------------------------

/// His joints at rest (his skeleton's, by bone number: `hakuro::skeleton`).
const PELVIS = vec3(0.0, 0.949, -0.043)
const SPINE1 = vec3(0.0, 1.072, -0.007)
const SPINE2 = vec3(0.0, 1.178, 0.004)
const SPINE3 = vec3(0.0, 1.311, 0.007)
const NECK = vec3(0.0, 1.52, -0.041)
const HEAD_AT = vec3(0.0, 1.6, -0.017)
const CLAVICLE = vec3(0.031, 1.495, 0.033)
const UPPER = vec3(0.212, 1.455, -0.065)
const FORE = vec3(0.463, 1.455, -0.073)
const HAND = vec3(0.706, 1.455, -0.065)
/// How far each finger's joints close round the boom (radians, knuckle first), and the thumb's.
const GRIP = [0.95, 1.15, 0.7]
const THUMB_GRIP = [0.0, 0.45, 0.45]

/// The thumb's joints' axis at rest (his left's): across its pad, so it closes toward the palm.
const THUMB_AXIS = vec3(-0.35, 0.55, 0.76)
const THIGH = vec3(0.114, 0.971, -0.036)
const CALF = vec3(0.114, 0.542, -0.036)
const FOOT = vec3(0.114, 0.086, -0.088)
const BALL = vec3(0.114, 0.015, 0.055)

/// The skeleton's bone numbers (`hakuro::skeleton` adds them in this order: the trunk, then
/// each pair left then right).
const B_PELVIS: u32 = 0
const B_SPINE1: u32 = 1
const B_SPINE2: u32 = 2
const B_SPINE3: u32 = 3
const B_NECK: u32 = 4
const B_HEAD: u32 = 5
const B_CLAVICLE: u32 = 6
const B_UPPER: u32 = 8
const B_FORE: u32 = 10
const B_HAND: u32 = 12
const B_DIGITS: u32 = 26
const B_THIGH: u32 = 18
const B_CALF: u32 = 20
const B_FOOT: u32 = 22
const B_BALL: u32 = 24

/// An axis of turning mirrored with his body (a turn's axis reflects as a pseudovector).
fn mirrored_axis(a: vec3, side: f32) -> vec3 {
    vec3(a.x, a.y * side, a.z * side)
}

fn mirrored(p: vec3, side: f32) -> vec3 {
    vec3(p.x * side, p.y, p.z)
}

/// The turn that takes the frame (`a`, `b` made square to it) at rest to (`c`, `d` made square
/// to it).
fn aim(a: vec3, b: vec3, c: vec3, d: vec3) -> mat3 {
    let a0 = normalize(a)
    let b0 = normalize(b - a0 * dot(b, a0))
    let c0 = normalize(c)
    let d0 = normalize(d - c0 * dot(d, c0))
    let e0 = cross(a0, b0)
    let to = mat3(c0, d0, cross(c0, d0))
    // (`to` times the inverse of the rest frame, which is its transpose: rows a0, b0, e0.)
    let from_t = mat3(vec3(a0.x, b0.x, e0.x), vec3(a0.y, b0.y, e0.y), vec3(a0.z, b0.z, e0.z))
    to * from_t
}

/// A turn of `angle` about `axis` (unit).
fn about(axis: vec3, angle: f32) -> mat3 {
    let c = cos(angle)
    let s = sin(angle)
    let t = 1.0 - c
    let x = axis.x
    let y = axis.y
    let z = axis.z
    mat3(
        vec3(t * x * x + c, t * x * y + s * z, t * x * z - s * y),
        vec3(t * x * y - s * z, t * y * y + c, t * y * z + s * x),
        vec3(t * x * z + s * y, t * y * z - s * x, t * z * z + c),
    )
}

/// A bone's palette matrix: its rest point `rest` to `at`, turned by `turn`.
fn placed(turn: mat3, at: vec3, rest: vec3) -> mat4 {
    let m = mat4(
        vec4(turn[0], 0.0),
        vec4(turn[1], 0.0),
        vec4(turn[2], 0.0),
        vec4(at - turn * rest, 1.0),
    )
    m
}

/// Where a two-bone limb's middle joint goes: from `root` to reach `goal`, its bones `l1` and
/// `l2` long, bent toward `pole`.
fn bend(root: vec3, goal: vec3, l1: f32, l2: f32, pole: vec3) -> vec3 {
    let to = goal - root
    let reach = clamp(length(to), abs(l1 - l2) + 0.001, (l1 + l2) * 0.999)
    let dir = normalize(to)
    let a = (l1 * l1 + reach * reach - l2 * l2) / (2.0 * reach)
    let h = sqrt(max(l1 * l1 - a * a, 0.0))
    let side = normalize(pole - dir * dot(pole, dir))
    root + dir * a + side * h
}

/// `foot` (planted on the deck) drawn in toward under `hips`: softly, never further than
/// `STANCE` out across the deck from them.
fn drawn_in(foot: vec3, hips: vec3) -> vec3 {
    let across = vec2(foot.x - hips.x, foot.z - hips.z)
    let k = 1.0 / sqrt(1.0 + dot(across, across) / (STANCE * STANCE))
    vec3(hips.x + across.x * k, foot.y, hips.z + across.y * k)
}

/// How far out across the deck from his hips his feet ever stand (m).
const STANCE: f32 = 0.3
/// How far his head keeps off the boom's arms (m), his hair's spikes and all.
const CLEAR: f32 = 0.45

/// The highest his pelvis can stand over `foot` (where it's planted) with a leg `leg` long from
/// hip to ankle, his hips where `hips` is across the deck.
fn stood_over(hips: vec3, foot: vec3, leg: f32) -> f32 {
    let ankle = foot + vec3(0.0, FOOT.y + 0.02, 0.0)
    let across = vec2(hips.x - ankle.x, hips.z - ankle.z)
    ankle.y + sqrt(max(leg * leg - dot(across, across), 0.0)) - (THIGH.y - PELVIS.y)
}

/// His palette as the shot holds the traveller (in the skiff's frame), into the world: each of
/// his bones' matrices, rest space to world.
pub fn bones(s: Shot, give: vec3) -> [mat4; 64] {
    var m = [mat4(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0),
    ); 64]
    let up = vec3(0.0, 1.0, 0.0)
    // Which way is up in the world, in the skiff's frame: as the hull heels and pitches he keeps
    // his body and his head to it, as a rider does, not to the deck.
    let plumb = normalize(vec3(s.boat_x.y, s.boat_y.y, s.boat_z.y))
    // Which way he faces: from his hips toward his hands, level.
    let mid = (s.fore_hand + s.aft_hand) * 0.5
    let facing = normalize(vec3(mid.x - s.hips.x, 0.0, mid.z - s.hips.z) + vec3(0.0, 0.0, 1.0e-4))
    let left = cross(up, facing)
    // He hangs back from the boom on near straight arms, as a sailor of a board does, but never
    // locked: his chest goes toward or away from his hands till they're a little short of a
    // straight arm's reach from it (back by 45 cm at most), his hips a third as far.
    let chest = s.hips + (s.neck - s.hips) * 0.8
    let toward = vec3(mid.x - chest.x, 0.0, mid.z - chest.z)
    let over = clamp(length(mid - chest) - 1.02 * length(HAND - UPPER), -0.55, 1.0)
    let lean = toward / max(length(toward), 1.0e-4) * over
    // Sunk a little into his knees, braced against the sea.
    var hips = s.hips + lean * 0.35 - vec3(0.0, 0.04, 0.0)
    var neck_at = s.neck + lean * 1.15
    // The wishbone's arm his hands are on runs at his head's height, and leaning toward his
    // hands never took his head off it: the boom went through his head. So he hangs out from
    // it, his head (a hand above his neck) at least `CLEAR` off them, across the boom, as far
    // to windward as it takes (his hips a third as far), which straightens his arms too.
    // (And his neck a hand over his hands, the boom at his shoulders, as a sailor of a board
    // holds it: at his neck, it ran past his eyes.)
    neck_at.y = max(neck_at.y, mid.y + 0.15)
    let head_at = neck_at + up * 0.18
    let r = head_at - RIG_FOOT - s.mast * LASHED
    let u = clamp(dot(r, s.boom), 0.0, BOOM)
    let bowed = BOW_OUT * sin(PI * u / BOOM) + 0.015
    let spar = RIG_FOOT + s.mast * LASHED + s.boom * u
    // (Both of the wishbone's arms: his hair fans out a hand's span round his head, and the far
    // arm cut through it.)
    let gap_near = head_at - (spar - s.belly * bowed)
    let gap_far = head_at - (spar + s.belly * bowed)
    let near_g = gap_near - s.boom * dot(gap_near, s.boom)
    let far_g = gap_far - s.boom * dot(gap_far, s.boom)
    let gap = if length(near_g) < length(far_g) { near_g } else { far_g }
    let windward = vec3(-s.belly.x, 0.0, -s.belly.z)
    let level = vec3(gap.x, 0.0, gap.z) + windward * 0.05
    let side = level / max(length(level), 1.0e-4)
    let short = max(CLEAR - length(gap), 0.0)
    neck_at = neck_at + side * short
    hips = hips + side * short * 0.35
    // The sailing holds a slighter figure's hips low under a neck at the boom; his own trunk is
    // its length, so stood that low his shoulders fell a hand's span under the boom and his arms
    // were wrung up over his head to it. So he rises out of the crouch till his trunk reaches up
    // toward where the sailing wants his neck, as far as his legs, near straight, let him.
    // (Steering with his weight: his body leans into a turn, his hips a little across with it.)
    let into = left * clamp(s.turn / 0.4, -1.0, 1.0)
    neck_at = neck_at + into * 0.12
    hips = hips + into * 0.05
    let torso = length(NECK - PELVIS)
    // (His knees kept bent, a rider's ready crouch, never stood up straight-legged, and lower
    // the harder it's turning.)
    let crouch = 0.84 - 0.05 * clamp(abs(s.turn) / 0.4, 0.0, 1.0)
    let leg = crouch * (length(CALF - THIGH) + length(FOOT - CALF))
    // A rider hangs off the boom: his shoulders back from his hands by near a straight arm's
    // reach and level with them, his trunk laid back from there 22 degrees off upright, away
    // from the sail, his hips under it as low as his bent legs set them. (Fed his weight through
    // straight arms, not crooked up under his chin, and never sat upright on his heels.)
    // (Further out in a gust, as he takes its pull.)
    // (And every second or so he works the sail: sits his weight back against it, his
    // shoulders further out on straighter arms, then eases back in. Drawn toward the boom
    // instead, it read as a lunge at it.)
    let trim = trimming(s.held)
    let reach = length(HAND - UPPER) * 0.92 + 0.1 + 0.08 * clamp(s.gust - 1.0, -0.5, 1.0) + 0.08 * trim
    let back = vec3(neck_at.x - mid.x, 0.0, neck_at.z - mid.z)
    let back_dir = back / max(length(back), 1.0e-4)
    let lay = normalize(back_dir * 0.375 + normalize(mix(up, plumb, 0.7)) * 0.927)
    neck_at = mid + back_dir * reach + up * 0.04
    let hung = neck_at - lay * torso
    hips = vec3(hung.x, hips.y, hung.z)
    // (His feet drawn in under him a little, as wide a stance as his legs keep strength in:
    // spread as wide as the sailing sets them, he'd have had to squat to reach the deck.)
    let fore_foot = drawn_in(s.fore_foot, hips)
    let aft_foot = drawn_in(s.aft_foot, hips)
    let top = min(stood_over(hips, fore_foot, leg), stood_over(hips, aft_foot, leg))
    // (Never deeper than a ready crouch: with the boom low, as the rig's raked back, he bends at
    // the waist to it rather than squatting down on his heels.)
    hips.y = clamp(hung.y, top - 0.06, top)
    neck_at = hips + lay * torso
    // His give: the hull's lurches taken in his knees and hips (`Aboard::ride`), his hips moved
    // the whole of it, his shoulders less, so his trunk sways over his feet.
    hips = hips + give
    hips.y = min(hips.y, top)
    // (His shoulders against his hips across the boat, so his head stays over the keel.)
    neck_at = neck_at + vec3(-give.x * 0.25, give.y * 0.85, give.z * 0.3)
    // His trunk: the pelvis half way to the spine's lean, the chest along it.
    let spine = normalize(neck_at - hips)
    // (The pelvis kept nearer upright than the chest: tipped as far, it swung the coat's tails
    // out behind him like a seat.)
    let r_pelvis = aim(vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), normalize(up * 3.0 + spine), facing)
    let r_chest = aim(vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), spine, facing)
    let r_spine1 = aim(
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0),
        normalize(up + spine * 2.0),
        facing,
    )
    let r_spine2 = aim(
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0),
        normalize(up + spine * 4.0),
        facing,
    )
    let pelvis = hips
    let spine1 = pelvis + r_pelvis * (SPINE1 - PELVIS)
    let spine2 = spine1 + r_spine1 * (SPINE2 - SPINE1)
    let spine3 = spine2 + r_spine2 * (SPINE3 - SPINE2)
    let neck = spine3 + r_chest * (NECK - SPINE3)
    m[B_PELVIS] = placed(r_pelvis, pelvis, PELVIS)
    m[B_SPINE1] = placed(r_spine1, spine1, SPINE1)
    m[B_SPINE2] = placed(r_spine2, spine2, SPINE2)
    m[B_SPINE3] = placed(r_chest, spine3, SPINE3)
    // His head along the sailing's gaze: ahead over the bow, into turns.
    // (Kept level to the horizon as the hull rolls under him, as the eyes keep a head.)
    // (Glancing up at the sail's luff as he trims it.)
    let at_sail = normalize(s.mast * 1.6 + RIG_FOOT - neck)
    let gaze = normalize(mix(normalize(s.gaze), at_sail, 0.45 * trimming(s.held - 0.08)))
    let level_look = normalize(gaze - plumb * dot(gaze, plumb) * 0.7)
    // (Turned at most 45 degrees from where his chest faces: led by the sailing's gaze over the
    // bow while he faces across the boat to the boom, his head swung round near backwards.)
    let flat = vec3(level_look.x, 0.0, level_look.z)
    // (By the sine of the turn, not its angle: a gaze passing behind him eases his head back
    // to the front, never snaps it across from one shoulder to the other.)
    let across = dot(cross(facing, flat), up) / max(length(flat), 1.0e-4)
    let turn_to = 0.78 * clamp(across / 0.7071, -1.0, 1.0)
    let swung = facing * cos(turn_to) + cross(up, facing) * sin(turn_to)
    let look = normalize(swung * length(flat) + up * level_look.y)
    let r_head = aim(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), look, plumb * 3.0 + spine)
    let r_neck = aim(vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0), normalize(spine + up), look)
    m[B_NECK] = placed(r_neck, neck, NECK)
    let head = neck + r_neck * (HEAD_AT - NECK)
    m[B_HEAD] = placed(r_head, head, HEAD_AT)
    // His arms: each hand on the wishbone (the hand nearer the bow is the one on that side), the
    // elbows down and out.
    let left_fore = dot(left, s.fore_hand - s.aft_hand) > 0.0
    for k in 0..2 {
        let side = if k == 0 { 1.0 } else { -1.0 }
        let grip = if (k == 0) == left_fore { s.fore_hand } else { s.aft_hand }
        // The wrist short of the boom by the palm's length, a little above it, so the closed
        // hand is round it.
        let goal = grip - normalize(grip - spine3) * 0.07 + up * 0.025
        let clav = spine3 + r_chest * (mirrored(CLAVICLE, side) - SPINE3)
        let shoulder = spine3 + r_chest * (mirrored(UPPER, side) - SPINE3)
        let l1 = length(FORE - UPPER)
        let l2 = length(HAND - FORE)
        let out = left * side
        let pole = -up + out * 0.25 - facing * 0.15
        let elbow = bend(shoulder, goal, l1, l2, pole)
        let wrist = elbow + normalize(goal - elbow) * l2
        // The upper arm turned so the elbow's crease faces the hand's way: away from the elbow's
        // point, which `bend` set toward `pole`. (At rest his arms are straight out, the inside of
        // each elbow ahead, +z.) The crease taken from the pole, not the forearm, so a near
        // straight arm doesn't spin about itself.
        let crook = (wrist - elbow) - pole * 0.05
        // (Each bone along its own rest axis, a degree or two off straight out.)
        let r_upper = aim(
            normalize(mirrored(FORE, side) - mirrored(UPPER, side)),
            vec3(0.0, 0.0, 1.0),
            elbow - shoulder,
            crook,
        )
        // The forearm folds about the elbow's hinge (the upper arm's own up, at rest), so the
        // fold itself never twists the two against each other at the elbow.
        let fore_axis = normalize(wrist - elbow)
        let r_fold = aim(
            normalize(mirrored(HAND, side) - mirrored(FORE, side)),
            vec3(0.0, 1.0, 0.0),
            wrist - elbow,
            r_upper * vec3(0.0, 1.0, 0.0),
        )
        // The hand round the boom wants its palm down onto it. A forearm turns the hand by
        // twisting along its length (more than a wrist could), so the turn the palm needs from
        // the folded forearm's is shared: half twists the forearm, all of it the hand, and none
        // of it is ever more than a real arm's. (All of it at the wrist pinched the forearm
        // thin and long.)
        let palm_at = r_fold * vec3(0.0, -1.0, 0.0)
        let palm_raw = -up + facing * 0.5
        // (When the forearm points nearly along the palm's wanted way, that way spins about it,
        // so the turn fades out there rather than following it.)
        let across = palm_raw - fore_axis * dot(palm_raw, fore_axis)
        let sure = smoothstep(0.1, 0.3, length(across) / length(palm_raw))
        let palm_want = across / max(length(across), 1.0e-4)
        let palm_now = palm_at
        let twist = sure * clamp(
            atan2(dot(cross(palm_now, palm_want), fore_axis), dot(palm_now, palm_want)),
            -1.7,
            1.7,
        )
        let r_fore = about(fore_axis, twist * 0.5) * r_fold
        let r_hand = about(fore_axis, twist) * r_fold
        let i = u32(k)
        m[B_CLAVICLE + i] = placed(r_chest, clav, mirrored(CLAVICLE, side))
        m[B_UPPER + i] = placed(r_upper, shoulder, mirrored(UPPER, side))
        m[B_FORE + i] = placed(r_fore, elbow, mirrored(FORE, side))
        m[B_HAND + i] = placed(r_hand, wrist, mirrored(HAND, side))
        // Each finger round the boom, joint by joint (the reference's: `hakuro::FINGER_JOINTS`),
        // the thumb closing over from the other side.
        for f in 0..5 {
            var r = r_hand
            if f == 4 {
                r = r_hand * about(vec3(1.0, 0.0, 0.0), 0.9)
            }
            var at = wrist + r_hand * (mirrored(FINGER_JOINTS[f * 4], side) - mirrored(HAND, side))
            for j in 0..3 {
                let bend = if f == 4 { THUMB_GRIP[j] } else { GRIP[j] }
                let axis = if f == 4 { mirrored_axis(THUMB_AXIS, side) } else { vec3(0.0, 0.0, 1.0) }
                r = r * about(axis, -bend * side)
                let rest = mirrored(FINGER_JOINTS[f * 4 + j], side)
                m[B_DIGITS + 2 * (f * 3 + j) + i] = placed(r, at, rest)
                at = at + r * (mirrored(FINGER_JOINTS[f * 4 + j + 1], side) - rest)
            }
        }
    }
    // His legs: each foot planted on the deck where the sailing sets it (the fore foot the one
    // on the bow's side of him), the knees sprung forward and out.
    let left_fore_foot = dot(left, fore_foot - aft_foot) > 0.0
    for k in 0..2 {
        let side = if k == 0 { 1.0 } else { -1.0 }
        let planted = if (k == 0) == left_fore_foot { fore_foot } else { aft_foot }
        let hip = pelvis + r_pelvis * (mirrored(THIGH, side) - PELVIS)
        let ankle = planted + vec3(0.0, FOOT.y + 0.02, 0.0)
        let l1 = length(CALF - THIGH)
        let l2 = length(FOOT - CALF)
        let pole = facing + left * side * 0.3
        let knee = bend(hip, ankle, l1, l2, pole)
        let foot = knee + normalize(ankle - knee) * l2
        let down = vec3(0.0, -1.0, 0.0)
        let r_thigh = aim(down, vec3(0.0, 0.0, 1.0), knee - hip, pole)
        // (The shin leans back a little at rest, its bone from knee to ankle.)
        let r_calf = aim(normalize(FOOT - CALF), vec3(0.0, 0.0, 1.0), foot - knee, pole)
        // The foot flat on the deck, its toes turned out a little from where he faces.
        let toes = normalize(facing + left * side * 0.35)
        let r_foot = aim(vec3(0.0, 0.0, 1.0), up, toes, up)
        let i = u32(k)
        m[B_THIGH + i] = placed(r_thigh, hip, mirrored(THIGH, side))
        m[B_CALF + i] = placed(r_calf, knee, mirrored(CALF, side))
        m[B_FOOT + i] = placed(r_foot, foot, mirrored(FOOT, side))
        let ball = foot + r_foot * (mirrored(BALL, side) - mirrored(FOOT, side))
        m[B_BALL + i] = placed(r_foot, ball, mirrored(BALL, side))
    }
    // From the skiff's frame into the world.
    let world = mat4(
        vec4(s.boat_x, 0.0),
        vec4(s.boat_y, 0.0),
        vec4(s.boat_z, 0.0),
        vec4(s.boat + s.boat_y * FREEBOARD, 1.0),
    )
    // (Every bone, fingers too: stopped at the legs' last, his fingers stayed in the skiff's
    // frame, at the world's middle, and their skin streaked back to there from his hands.)
    for i in 0..64 {
        m[i] = world * m[i]
    }
    m
}

// ---- drawing him ---------------------------------------------------------------------------

/// What his vertex passes on: where it is (clip and world), where it is on him at rest, its
/// skin's turn (to bring his fields' normal into the world) and which of his parts are near.
pub struct HeroVertex: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub rest: vec3,
    pub tx: vec3,
    pub ty: vec3,
    pub tz: vec3,
    pub normal: vec3,
    pub lo: Flat<u32>,
    pub hi: Flat<u32>,
}

/// The near and far planes of his depth (m).
const NEAR: f32 = 0.05
const FAR: f32 = 400.0

/// A point of the world in the shot's clip space: as `look::ray` casts its pixels.
pub fn clip_of(s: Shot, p: vec3) -> vec4 {
    let r = p - s.eye
    let x = dot(r, s.right)
    let y = dot(r, s.up)
    let z = dot(r, s.forward)
    vec4(
        s.focal * x * s.resolution.y / s.resolution.x,
        s.focal * y,
        (z - NEAR) * FAR / (FAR - NEAR),
        z,
    )
}

@vertex
pub fn hero_vertex(v: VertexIndex, verts: [SkinVertex], palette: [mat4], shot: Shot) -> HeroVertex {
    hero_at(v, verts, palette, shot)
}

/// His coat's tails' vertex: as `hero_vertex`, hanging as the tails' cloth does this frame
/// (`hakuro::arms::draped`).
@vertex
pub fn coat_vertex(v: VertexIndex, verts: [SkinVertex], palette: [mat4], grid: [vec4], facing: [vec4], shot: Shot) -> HeroVertex {
    var h = hero_at(v, verts, palette, shot)
    h.world = draped(h.world, h.rest, mat3(h.tx, h.ty, h.tz), grid, facing, 0)
    h.clip = ClipPosition { position: clip_of(shot, h.world) }
    h
}

fn hero_at(v: VertexIndex, verts: [SkinVertex], palette: [mat4], shot: Shot) -> HeroVertex {
    let sv = verts[v.index]
    let m = skin_matrix(sv, palette, 0)
    let world = (m * vec4(sv.pos, 1.0)).xyz
    HeroVertex {
        clip: ClipPosition { position: clip_of(shot, world) },
        world,
        rest: sv.pos,
        tx: m[0].xyz,
        ty: m[1].xyz,
        tz: m[2].xyz,
        normal: mat3(m[0].xyz, m[1].xyz, m[2].xyz) * sv.normal,
        lo: Flat { value: sv.mask.lo },
        hi: Flat { value: sv.mask.hi },
    }
}

/// His pixel: drawn where he's nearer than what the paint met there, lit as the skiff is.
@fragment
pub fn hero_pixel<F: Parts<Cloth>>(
    v: HeroVertex,
    field: F,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    skies: [vec4],
    once: [vec4],
    painted: Texture<Rgba16Float>,
    pixel: FragCoord,
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let t = length(v.world - s.eye)
    let behind = painted.load(u32(pixel.position.x) / FINER, u32(pixel.position.y) / FINER)
    // (Compared as stored, in log2 of the distance at half precision: a step there is about
    // 0.3% of it at the boat's range, so the margin is a little more than one.)
    if behind.x < log2(t) - 0.006 {
        discard()
    }
    // His fields at this point of him at rest: his normal (their gradient) and what he's made of.
    let fp = t * 1.5 / (s.focal * s.resolution.y)
    let mask = PartMask { lo: v.lo.value, hi: v.hi.value }
    let (_, grad, c) = field.sample_masked(v.rest, mask, fp)
    let turn = mat3(v.tx, v.ty, v.tz)
    let d = normalize(v.world - s.eye)
    var n = normalize(turn * grad)
    if dot(n, d) > 0.0 {
        n = normalize(n - d * (dot(n, d) + 0.05))
    }
    // How much of the sky his own folds hide (the skiff's way): his distance a little out along
    // his normal, at rest, short of how far out it was stepped.
    let out = normalize(grad)
    var hidden = 0.0
    for i in 1..3 {
        let step = 0.03 * f32(i * i)
        let (e, _, _) = field.sample_masked(v.rest + out * step, mask, fp)
        hidden += max(step - e, 0.0) / step * (if i == 1 { 1.0 } else { 0.6 })
    }
    let ao = clamp(1.0 - hidden * 0.6, 0.0, 1.0)
    lit_hero(s, light, clouds, view, aerial, dome, cloud, smp, skies, overhead(once), v.world, n, d, t, c, ao)
}

/// What the scene is seen with, for a charted form (`engine::chart::vertex`): its own cast.
impl chart::Seen for Shot {
    fn clip_at(self, world: vec3) -> vec4 {
        clip_of(self, world)
    }

    fn seen_from(self) -> vec3 {
        self.eye
    }
}

/// His charted arms' pixel (`hakuro::arm_charts`): as `arm_pixel`, its normal read from the
/// form at the pixel's own place (`chart::Vertex::normal_from`; `along`: its path's length) and
/// its paint the part's.
@fragment
pub fn charted_pixel<const A: u32, const R: u32>(
    v: chart::Vertex,
    shade: Radial<A, R>,
    along: f32,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    skies: [vec4],
    once: [vec4],
    painted: Texture<Rgba16Float>,
    part: u32,
    pixel: FragCoord,
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let t = length(v.world - s.eye)
    let behind = painted.load(u32(pixel.position.x) / FINER, u32(pixel.position.y) / FINER)
    if behind.x < log2(t) - 0.006 {
        discard()
    }
    let d = normalize(v.world - s.eye)
    var n = v.normal_from(shade, along)
    if dot(n, d) > 0.0 {
        n = normalize(n - d * (dot(n, d) + 0.05))
    }
    let c = chart_paint(part, v.rest)
    lit_hero(s, light, clouds, view, aerial, dome, cloud, smp, skies, overhead(once), v.world, n, d, t, c, 0.9)
}

/// His sampled meshes' pixel (his body, jacket and hands): as `hero_pixel`, but with no fields
/// behind them, their own normal and his body's paint where they are on him at rest.
@fragment
pub fn arm_pixel(
    v: HeroVertex,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    skies: [vec4],
    once: [vec4],
    painted: Texture<Rgba16Float>,
    jacket: u32,
    pixel: FragCoord,
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let t = length(v.world - s.eye)
    let behind = painted.load(u32(pixel.position.x) / FINER, u32(pixel.position.y) / FINER)
    if behind.x < log2(t) - 0.006 {
        discard()
    }
    let d = normalize(v.world - s.eye)
    var n = normalize(v.normal)
    if dot(n, d) > 0.0 {
        n = normalize(n - d * (dot(n, d) + 0.05))
    }
    // (1 for his jacket, whose paint carries on down over his trousers: `jacket_paint`.)
    let c = if jacket == 1 { jacket_paint(v.rest) } else { body_paint(v.rest) }
    lit_hero(s, light, clouds, view, aerial, dome, cloud, smp, skies, overhead(once), v.world, n, d, t, c, 0.9)
}

/// His light, illustrated: the world's own sky and sun, but the sky's light taken from fixed
/// directions over him (the deck's overhead and toward the sun) and stepped by how far each face
/// turns up, so the clouds' detail never mottles his forms (`lit_solid` looks the sky up along
/// each normal, and across his muscles that drew the clouds on him in squiggles); his skin and
/// cloth matte, his gold keeping a mirror of the sky overhead.
fn illustrated(
    s: Shot,
    light: Light,
    skies: [vec4],
    p: vec3,
    n: vec3,
    c: Cloth,
    sun: f32,
    ao: f32,
) -> vec3 {
    let side = normalize(vec3(light.sun.x, 0.35, light.sun.z))
    let deck = (skies[0].xyz + skies[1].xyz) * 0.5
    // Two values of shade: the faces turned up, and the rest, a soft step between.
    let open = 0.20 + 0.20 * smoothstep(0.15, 0.35, n.y)
    let under = max(-n.y, 0.0)
    let below = light.sun_colour * vec3(0.085, 0.07, 0.055) * under
    let sky = (deck * PI * open + below) * (0.25 + 0.75 * ao * ao)
    let metal = c.metal > 0.5
    let lit = Lit {
        albedo: c.albedo,
        n,
        sun,
        sky,
        through: vec3(0.0),
        rough: if metal { c.rough } else { max(c.rough, 0.92) },
        metallic: c.metal,
        reflected: if metal { deck * ao * 0.6 } else { vec3(0.0) },
        glint: if metal { 0.6 } else { 0.0 },
    }
    // A key from the sky's bright quarter, set to a hard edge: his forms' lit side and shade side,
    // two tones as an illustrator lays them.
    let key = smoothstep(0.05, 0.15, dot(n, side))
    let keyed = deck * c.albedo * (1.0 - c.metal) * key * 1.1
    world(light, lit, p, s.eye) + keyed
}

/// How many of the sky's lights `hero_skies` keeps: the deck's overhead, the sky toward the sun's
/// side, and the light over the sea toward the sun.
const SKIES: u32 = 3

/// The sky's light from his fixed directions, once a frame (the same for every pixel of him, so
/// looked up once, not in each): `out[0]` overhead, `[1]` toward the sun's side, `[2]` low over the
/// sea toward the sun.
@compute(64)
pub fn hero_skies(
    light: Light,
    view: Texture<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    out: mut Slots<vec4>,
    id: GlobalId,
) {
    if id.x >= SKIES {
        return
    }
    let dir = if id.x == 0 {
        vec3(0.0, 1.0, 0.0)
    } else if id.x == 1 {
        normalize(vec3(light.sun.x, 0.35, light.sun.z))
    } else {
        normalize(vec3(light.sun.x, 0.25, light.sun.z))
    }
    out[id] = vec4(storm_sky(view, light, dir, dome, smp, disc: false).rgb, 0.0)
}

/// His pixel lit, from its normal `n`, cloth `c` and how open it is to the sky `ao`: as the skiff
/// is, a character's way.
fn lit_hero(
    s: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    skies: [vec4],
    over: Overhead,
    p: vec3,
    n: vec3,
    d: vec3,
    t: f32,
    c: Cloth,
    ao: f32,
) -> Targets3<vec4, vec4, vec4> {
    let h = Heaven { light, clouds, over }
    // (No march of the vessel's shadow where the clouds let no sun through.)
    let clouded = cloud_shadow(clouds, cloud, smp, p)
    let sun = if clouded > 0.0 { vessel_shadow(s, p + n * 0.01, light.sun) * clouded } else { 0.0 }
    var col = if INKED > 0.5 {
        illustrated(s, light, skies, p, n, c, sun, ao)
    } else {
        lit_solid(
            s,
            h,
            view,
            aerial,
            dome,
            smp,
            p,
            n,
            d,
            c.albedo,
            c.rough,
            c.metal,
            vec3(0.0),
            sun,
            ao: ao,
            haze: 0.0,
            glint: 1.0,
        )
    }
    // Lit as the skiff is, a character's way: the sea's light thrown up under him, and a rim of
    // the sun (its numbers, for the clean look).
    let sea_light = skies[2].xyz
    let toward = max(dot(n, normalize(vec3(light.sun.x, -0.4, light.sun.z))), 0.0)
    let bounce = sea_light *
        PI *
        0.13 *
        mix(1.0, 2.2, OVERCAST) *
        (0.4 + 0.6 * ao) *
        (0.5 + 0.5 * toward)
    let edge_k = pow(1.0 - max(dot(n, -d), 0.0), 3.0) *
        max(dot(n, normalize(vec3(light.sun.x, 0.3, light.sun.z))), 0.0)
    // (Illustrated, his rim is the sky's, below: this one lit his muscles' creases in streaks.)
    let rim = light.sun_colour * vec3(1.0, 0.85, 0.6) * (0.6 * edge_k) * (1.0 - INKED)
    col += c.albedo * bounce + rim * sun
    if INKED > 0.5 {
        // Illustrated: the sky's light round his form, from the side away from the eye, so his
        // black reads against the dark sea; brightest where his form turns up to the sky.
        // A narrow band with a hard edge, as an illustrator lays it: his blacks stay deep inside.
        let edge = 1.0 - max(dot(n, -d), 0.0)
        let band = clamp((edge - mix(0.62, 0.78, HERO_POP)) / mix(0.08, 0.05, HERO_POP), 0.0, 1.0)
        let sky = storm_sky(view, light, normalize(vec3(0.0, 0.6, 0.0) + n), dome, smp, disc: false).rgb
        // (Not on his bare skin: its muscles turn from the eye inside his outline, and the band
        // drew their contours in squiggles there.)
        let cloth = if c.albedo.r > 0.3 && c.metal < 0.5 { 0.0 } else { 1.0 }
        col += sky * mix(vec3(1.0), vec3(0.85, 0.95, 1.2), HERO_POP) * band * (0.45 + 0.35 * max(n.y, 0.0)) * mix(0.45, 1.8, HERO_POP) * cloth
        // His gold's trim kept bright under the storm.
        col += c.albedo * c.metal * 0.05
    }
    Targets3 {
        first: vec4(col, 1.0),
        second: vec4(log2(max(t, 0.01)), SKIFF, 1.0, 0.5),
        third: vec4(n * 0.5 + 0.5, 0.0),
    }
}

/// The paint's targets copied as they are.
@fragment
pub fn copied(
    pixel: FragCoord,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
) -> Targets3<vec4, vec4, vec4> {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    Targets3 { first: colour.load(x, y), second: marks.load(x, y), third: normal.load(x, y) }
}

/// His targets laid over the paint's where he was drawn: his finer samples in each pixel
/// averaged with the paint's colour where they missed him, his marks and normal where most hit
/// him.
@fragment
pub fn laid(
    pixel: FragCoord,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba8>,
    under_colour: Texture<Rgba16Float>,
    under_marks: Texture<Rgba16Float>,
    under_normal: Texture<Rgba8>,
) -> Targets3<vec4, vec4, vec4> {
    let x = u32(pixel.position.x)
    let y = u32(pixel.position.y)
    var sum = vec4(0.0)
    var hits = 0.0
    var m = vec4(0.0)
    var n = vec4(0.0)
    for k in 0..FINER * FINER {
        let sx = x * FINER + k % FINER
        let sy = y * FINER + k / FINER
        let mk = marks.load(sx, sy)
        if mk.y != 0.0 {
            sum += colour.load(sx, sy)
            hits += 1.0
            m = mk
            n = normal.load(sx, sy)
        }
    }
    if hits == 0.0 {
        discard()
    }
    let all = f32(FINER * FINER)
    if INKED > 0.5 {
        // His ink: where, a finer sample or two off, he ends (his outline) or his surface jumps
        // back (where an arm crosses his body, the coat over his legs).
        var ink = 0.0
        for k in 0..FINER * FINER {
            let sx = i32(x * FINER + k % FINER)
            let sy = i32(y * FINER + k / FINER)
            let here = marks.load(u32(sx), u32(sy))
            if here.y != 0.0 {
                // (Three finer samples out, eight ways: a line about a pixel and a half wide.)
                for j in 0..8 {
                    let ox = if j == 0 || j == 4 || j == 5 { 3 } else if j == 1 || j == 6 || j == 7 { -3 } else { 0 }
                    let oy = if j == 2 || j == 4 || j == 6 { 3 } else if j == 3 || j == 5 || j == 7 { -3 } else { 0 }
                    let o = marks.load(u32(max(sx + ox, 0)), u32(max(sy + oy, 0)))
                    if o.y == 0.0 || o.x - here.x > 0.03 {
                        ink += 1.0
                    }
                }
            }
        }
        let a = clamp(ink / (all * 2.0), 0.0, 1.0)
        sum = mix(sum, vec4(0.012, 0.012, 0.018, 1.0) * hits, a)
    }
    let under = under_colour.load(x, y)
    let most = hits * 2.0 >= all
    Targets3 {
        first: (sum + under * (all - hits)) / all,
        second: if most { m } else { under_marks.load(x, y) },
        third: if most { n } else { under_normal.load(x, y) },
    }
}

impl Aboard {
    /// His ride, stepped by `dt` (s) of the drawing's time: the hull's lurches (its acceleration
    /// in the world, felt in its own frame, as he stands on it) press his hips the other way on
    /// a sprung, damped give, his knees taking the heave and his hips the surge and the sway,
    /// and it springs back, about one and a half times a second, a little past and settling.
    fn ride(mut self, s: Shot, dt: f32) {
        // (Started afresh after a jump: the time run back or skipped on, or the hull put down
        // somewhere else, as the live page does restoring a saved spot. Felt as a lurch, that
        // threw his hips to their limits for a second.)
        if dt < 0.0 || dt > 0.25 || (self.rode >= 2 && length(s.boat - self.last_boat) > 15.0 * max(dt, 1.0 / 60.0)) {
            self.rode = 0
            self.give = vec3(0.0)
            self.give_v = vec3(0.0)
        }
        if self.rode < 2 || dt <= 0.0 {
            // (A start, or a held drawing: nothing felt yet.)
            let v = if self.rode == 0 || dt <= 0.0 { vec3(0.0) } else { (s.boat - self.last_boat) / dt }
            if dt > 0.0 || self.rode == 0 {
                self.last_v = v
                self.last_boat = s.boat
                self.last_tip = vec2(s.boat_z.y, s.boat_x.y)
                self.rode = self.rode + 1
            }
            return
        }
        let v = (s.boat - self.last_boat) / dt
        let a = clamp((v - self.last_v) / dt, vec3(-40.0), vec3(40.0))
        self.last_boat = s.boat
        self.last_v = v
        // (Felt in the hull's frame: heave in his knees, surge and sway in his hips.)
        let felt = vec3(dot(a, s.boat_x), dot(a, s.boat_y), dot(a, s.boat_z))
        let k = 55.0
        let c = 9.0
        // (And the hull's pitching and rolling: as the bow lifts he sinks into his knees and
        // springs back as it falls; as it rolls he shifts his weight onto the low foot.)
        let tip = vec2(s.boat_z.y, s.boat_x.y)
        let tipping = (tip - self.last_tip) / dt
        self.last_tip = tip
        let push = -felt * vec3(0.014, 0.035, 0.012) + vec3(-tipping.y * 0.7, -abs(tipping.x) * 0.8 - tipping.x * 0.5, 0.0)
        self.give_v = self.give_v + (push * k - self.give * k - self.give_v * c) * dt
        self.give = self.give + self.give_v * dt
        self.give = clamp(self.give, vec3(-0.09, -0.12, -0.08), vec3(0.09, 0.04, 0.08))
    }

    /// Him drawn into the painted scene (`colour`, `marks`, `normal`, which the paint has just
    /// filled), as `shot` holds him.
    pub fn draw(
        mut self,
        shot: Shot,
        hv: Heavens,
        colour: mut Texture<Rgba16Float>,
        marks: mut Texture<Rgba16Float>,
        normal: mut Texture<Rgba8>,
        width: u32,
        height: u32,
        // (The sky's colours the same for every pixel of the drawing: `paint::overhead_once`.)
        once: GpuBuffer<vec4>,
    ) {
        if width != self.width || height != self.height {
            let (w, h) = (width * FINER, height * FINER)
            self.colour = texture(width: w, height: h)
            self.marks = texture(width: w, height: h)
            self.normal = texture(width: w, height: h)
            self.depth = depth_texture(width: w, height: h)
            self.under_colour = texture(width: width, height: height)
            self.under_marks = texture(width: width, height: height)
            self.under_normal = texture(width: width, height: height)
            self.width = width
            self.height = height
        }
        // (The scene moves on its own drawings, `sea::held`: his cloth and his lagged palette
        // step only when the drawing does, by the time it moved. Stepped every frame, a drawing
        // held over two frames let the cloth run on and then jump, a pop every fifth frame.)
        let moved = shot.held - self.held
        if self.fresh || moved != 0.0 {
            self.ride(shot, moved)
            let now = bones(shot, self.give)
            write(mut self.palette, 0, now)
            let parts = arm_charts()
            for a in 0..ARM_CHARTS {
                self.arms[a] = parts[a].posed(now)
            }
            // (About a tenth of a second behind: 0.16 of the way each 60th of a second.)
            let ease = 1.0 - pow(0.84, clamp(moved, 0.0, 0.1) * 60.0)
            for k in 0..64 {
                self.lagged[k] = if self.fresh { now[k] } else { self.lagged[k] + (now[k] - self.lagged[k]) * ease }
            }
            write(mut self.palette, MAX_BONES, self.lagged)
            self.drape.work(self.palette, 1, MAX_BONES, MAX_BONES, if self.fresh { 1.0 / 60.0 } else { moved })
            self.fresh = false
            self.held = shot.held
        }
        dispatch(
            hero_skies.bind(light: hv.light, view: hv.tables.view, dome: hv.sky.dome, smp: hv.linear, out: mut self.skies),
            groups: 1,
        )
        let p = begin_pass3_with_depth(
            mut self.colour,
            mut self.marks,
            mut self.normal,
            mut self.depth,
            clear: vec4(0.0),
        )
        let hb = hero()
        let hh = head()
        let hc = coat()
        // (His faces wind the other way on screen here: `clip_of` keeps the camera's forward as
        // +z, a mirror of the usual view, so it's the front-wound faces that face away.)
        draw(
            p,
            hero_vertex.bind(
                verts: self.body.verts.items(),
                palette: self.palette.items(),
                shot: shot,
            ),
            hero_pixel.bind(
                field: hb.field(),
                shot: shot,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                skies: self.skies.items(),
                once: once.items(),
                painted: marks,
            ),
            indices: self.body.quads.items(),
            indirect: self.body.draw.items(),
            cull: Cull::Front,
        )
        draw(
            p,
            hero_vertex.bind(
                verts: self.head.verts.items(),
                palette: self.palette.items(),
                shot: shot,
            ),
            hero_pixel.bind(
                field: hh.field(),
                shot: shot,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                skies: self.skies.items(),
                once: once.items(),
                painted: marks,
            ),
            indices: self.head.quads.items(),
            indirect: self.head.draw.items(),
            cull: Cull::Front,
        )
        draw(
            p,
            coat_vertex.bind(
                verts: self.coat.verts.items(),
                palette: self.palette.items(),
                grid: self.drape.grid(),
                facing: self.drape.facing(),
                shot: shot,
            ),
            hero_pixel.bind(
                field: hc.field(),
                shot: shot,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                skies: self.skies.items(),
                once: once.items(),
                painted: marks,
            ),
            indices: self.coat.quads.items(),
            indirect: self.coat.draw.items(),
            cull: Cull::Front,
        )
        for a in 0..4 {
            draw(
                p,
                hero_vertex.bind(
                    verts: self.sampled[a].verts.items(),
                    palette: self.palette.items(),
                    shot: shot,
                ),
                arm_pixel.bind(
                    shot: shot,
                    light: hv.light,
                    clouds: hv.clouds,
                    view: hv.tables.view,
                    aerial: hv.tables.aerial,
                    dome: hv.sky.dome,
                    cloud: hv.sky.shadow,
                    smp: hv.linear,
                    skies: self.skies.items(),
                    once: once.items(),
                    painted: marks,
                    jacket: if a == 1 { 1 } else { 0 },
                ),
                indices: self.sampled[a].quads.items(),
                indirect: self.sampled[a].draw.items(),
                cull: Cull::Front,
            )
        }
        // His arms, and the wrap and the gauntlet over them, along their charts: no mesh, each
        // form made again where his bones are.
        let parts = arm_charts()
        for a in 0..ARM_CHARTS {
            let form = self.arms[a]
            let level = form.level(shot.eye, f32(height * FINER), 1.0 / shot.focal)
            let span = chart::level_span(level)
            draw(
                p,
                chart::vertex.bind(
                    rest: parts[a].rest(),
                    form: form,
                    band: parts[a].band,
                    under: parts[a].sunk,
                    level: level,
                    seen: shot,
                ),
                charted_pixel.bind(
                    shade: form.form.softened(SHADED_DETAIL),
                    along: form.path.length(),
                    shot: shot,
                    light: hv.light,
                    clouds: hv.clouds,
                    view: hv.tables.view,
                    aerial: hv.tables.aerial,
                    dome: hv.sky.dome,
                    cloud: hv.sky.shadow,
                    smp: hv.linear,
                    skies: self.skies.items(),
                    once: once.items(),
                    painted: marks,
                    part: a,
                ),
                indices: self.grids.indices,
                first_index: span.x,
                index_count: span.y,
                cull: Cull::Front,
            )
        }
        p.end()
        let c = begin_pass3(
            mut self.under_colour,
            mut self.under_marks,
            mut self.under_normal,
            clear: vec4(0.0),
        )
        draw(c, cover, copied.bind(colour: colour, marks: marks, normal: normal), vertices: 3)
        c.end()
        let q = begin_pass3(mut colour, mut marks, mut normal, keep: true)
        draw(
            q,
            cover,
            laid.bind(
                colour: self.colour,
                marks: self.marks,
                normal: self.normal,
                under_colour: self.under_colour,
                under_marks: self.under_marks,
                under_normal: self.under_normal,
            ),
            vertices: 3,
        )
        q.end()
    }
}
