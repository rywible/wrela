// The rock floating in the sky and the one building on it, massive and far: an inverted mountain
// of bedded stone hewn into planes, with spurs hanging under it; on its plateau a castle's keep of
// the rock's own stone, battered, buttressed and machicolated, round towers at its corners, and
// standing on it a gothic cathedral hundreds of metres tall: its nave and aisles, flying
// buttresses, pinnacles, transept, lantern tower, twin west towers and their spires gilded at
// their tips, its lancets and roses lit from within.
//
// Distances are built at a model's scale and drawn `SCALE` times it (`isle`).

use engine::far::shown
use look::{GILT, GLASS, HOUSE, ISLE, ROOF, ROCK, STONE, TILE, fbm3, hash2, hash3, noise, noise3}

/// How much larger the isle is drawn than it's modelled.
pub const SCALE: f32 = 6.3

/// How tall the rock is under its plateau, and how wide its plateau (the model's m).
const DROP: f32 = 210.0
const TOP: f32 = 118.0

/// How high its plateau's top is over the isle's centre (the world's m).
const PLATEAU: f32 = 2.0 * SCALE

/// Where the isle's bounds are (the world's): a sphere round it.
pub fn bounds() -> vec4 {
    vec4(ISLE + vec3(0.0, -55.0 * SCALE, 0.0), 300.0 * SCALE)
}

fn sd_box(p: vec3, b: vec3) -> f32 {
    let q = abs(p) - b
    length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

/// A cone standing on its base at y = 0, `r` wide there and `h` tall: a spire.
fn sd_spire(p: vec3, r: f32, h: f32) -> f32 {
    let q = vec2(length(vec2(p.x, p.z)), p.y)
    let side = normalize(vec2(h, r))
    max(dot(q - vec2(r, 0.0), side), -p.y)
}

/// An eight-sided spire: its faces' planes, a gothic spire's broaches.
fn sd_octo_spire(p: vec3, r: f32, h: f32) -> f32 {
    let a = abs(vec2(p.x, p.z))
    let o = max(max(a.x, a.y), (a.x + a.y) * 0.7071)
    let side = normalize(vec2(h, r))
    max(dot(vec2(o, p.y) - vec2(r, 0.0), side), -p.y)
}

fn sd_segment(p: vec3, a: vec3, b: vec3, r: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    length(pa - ba * h) - r
}

/// The planes a rock is hewn by: each a normal's direction and how far out it cuts.
const CUTS = [
    vec4(0.80, -0.45, 0.25, 92.0),
    vec4(-0.75, -0.40, 0.42, 96.0),
    vec4(0.15, -0.42, -0.82, 90.0),
    vec4(-0.50, -0.35, -0.74, 98.0),
    vec4(0.97, -0.10, -0.20, 108.0),
    vec4(-0.96, -0.12, 0.25, 110.0),
    vec4(0.35, -0.50, 0.62, 88.0),
    vec4(-0.25, -0.15, 0.96, 106.0),
]

/// The ribs hanging under the rock's flanks (the model's m): where (x, z), how long, how wide.
const RIBS = [
    vec4(-78.0, -38.0, 46.0, 15.0),
    vec4(-58.0, 34.0, 38.0, 12.0),
    vec4(70.0, -36.0, 54.0, 16.0),
    vec4(82.0, 18.0, 34.0, 11.0),
    vec4(26.0, -70.0, 44.0, 14.0),
    vec4(-30.0, -74.0, 50.0, 13.0),
    vec4(-8.0, 70.0, 40.0, 13.0),
    vec4(40.0, 58.0, 30.0, 10.0),
    vec4(-88.0, 2.0, 28.0, 10.0),
]

/// A mass hanging under the rock (the model's m): round `c` (x, z), from `top` down to its tip at
/// `tip`, `r` wide at its top, gouged by its own crags.
fn pendant(p: vec3, c: vec2, top: f32, tip: f32, r: f32, seed: f32) -> f32 {
    let q = vec2(p.x, p.z) - c
    let u = clamp((p.y - tip) / (top - tip), 0.0, 1.0)
    let ang = atan2(q.y, q.x)
    let crag = (noise(vec2(ang * 5.0 + seed, p.y * 0.02)) - 0.5) * r * 0.5 * u
    let wide = r * pow(u, 0.7)
    max((length(q) - wide - crag) * 0.6, max(p.y - top, tip - p.y))
}

/// A rock hewn from an inverted mountain: `q` from its top's centre (the model's m), `s` its
/// scale, `turn` its turn about the vertical; `lid` how far over `q` its top is taken to be (0:
/// where it is; far over, its sides alone, so a point under its top reads how far in from its
/// brink it is).
fn hewn(q: vec3, s: f32, turn: f32, lid: f32) -> f32 {
    let c = cos(turn)
    let n = sin(turn)
    var p = vec3(q.x * c - q.z * n, q.y, q.x * n + q.z * c) / s
    // It hangs askew: its tip off its plateau's centre.
    p.x += p.y * 0.17
    p.z -= p.y * 0.06
    let r = length(vec2(p.x, p.z))
    let ang = atan2(p.z, p.x)
    // Broad at the top, falling to a point, gouged by crags that run down it and ledged by its
    // beds.
    let k = clamp((p.y + DROP) / DROP, 0.0, 1.0)
    // Its flanks stepped in tiers, each overhanging the next, so it hangs in great broken masses,
    // not one cone.
    // (Each tier's foot a sharp overhang, its face drawn back up it: from 8 km a ledge 50 m deep
    // throws a shadow line a few pixels thick, the bands a far eye measures a cliff by.)
    let tier_u = fract(p.y / 41.0 + noise(vec2(atan2(p.z, p.x) * 2.0, 4.0)) * 0.5)
    let tier = smoothstep(0.0, 0.12, tier_u) * (1.0 - tier_u)
    let wide = TOP * pow(k, 0.85) * (1.0 - 0.16 * tier * (1.0 - k * 0.5))
    let crag = (noise(vec2(ang * 4.0, p.y * 0.010)) - 0.5) * 46.0 * k +
        (noise(vec2(ang * 11.0, p.y * 0.03 + 7.0)) - 0.5) * 18.0
    let beds = abs(fract(p.y / 9.0 + noise(vec2(ang * 3.0, 1.0)) * 0.6) - 0.5) * 3.0
    var d = max((r - wide - crag + beds * 0.3) * 0.55, max(p.y - lid, -DROP - p.y))
    for i in 0..8 {
        let cut = CUTS[i]
        d = max(d, dot(p, normalize(vec3(cut.x, cut.y, cut.z))) - cut.w * 1.1)
    }
    // Masses hanging under it, each its own crag and tip, breaking its underside into several.
    d = min(d, pendant(p, vec2(-40.0, -22.0), -30.0, -168.0, 44.0, 1.0))
    d = min(d, pendant(p, vec2(46.0, 26.0), -24.0, -128.0, 38.0, 4.0))
    d = min(d, pendant(p, vec2(8.0, -52.0), -50.0, -150.0, 30.0, 7.0))
    d = min(d, pendant(p, vec2(-12.0, 40.0), -40.0, -118.0, 30.0, 9.0))
    // And under them a second rank, smaller, each hung off the flank where it is: the underside
    // in masses, then ribs, then crags, the way a cliff's scale steps down, not one cone's face.
    if p.y < -24.0 && d > -8.0 {
        for j in 0..9 {
            let rib = RIBS[j]
            let at = vec2(rib.x, rib.y)
            // (Its top tucked into the flank at its own radius, its tip far under it.)
            let top = -DROP * clamp(1.0 - length(at) / (TOP * 0.95), 0.08, 0.9) + 6.0
            d = min(d, pendant(p, at, top, top - rib.z, rib.w, f32(j) * 3.1 + 11.0))
        }
    }
    // Spurs hanging under it.
    let spur_a = vec2(p.x - 50.0, p.z + 18.0)
    let spur_b = vec2(p.x + 46.0, p.z - 10.0)
    d = min(
        d,
        max(
            length(spur_a) - 15.0 * clamp((p.y + 175.0) / 115.0, 0.0, 1.0),
            max(p.y + 60.0, -175.0 - p.y),
        ) *
            0.7,
    )
    d = min(
        d,
        max(
            length(spur_b) - 12.0 * clamp((p.y + 140.0) / 90.0, 0.0, 1.0),
            max(p.y + 50.0, -140.0 - p.y),
        ) *
            0.7,
    )
    // Its fractures, running down it, and its beds' ledges.
    let fracture = 1.0 - abs(noise3(p * vec3(0.035, 0.006, 0.035)) * 2.0 - 1.0)
    d += fracture * fracture * 7.0
    // (Not just under the plateau's lip, where a ledge would stand out against the sky as a
    // slab of its own.)
    let lip = smoothstep(-4.0, -34.0, p.y)
    d += smoothstep(
        0.3,
        0.55,
        fract(p.y / 23.0 + noise(vec2(ang * 3.0, 3.0)) * 0.9 + noise3(p * 0.03) * 0.6),
    ) *
        2.2 *
        lip
    // Its great ledges: a few deep beds, each overhanging the one under it.
    d += smoothstep(0.15, 0.6, fract(p.y / 61.0 + noise(vec2(ang * 2.0, 9.0)) * 0.35)) * 4.5 * lip
    d += (fbm3(p * 0.04, 3) - 0.5) * 5.0 + (noise3(p * 0.35) - 0.5) * 1.0
    d * s
}

/// Where the cathedral stands on the plateau (the world's m, from the isle's centre: its floor,
/// the keep's top, 218 m over the plateau), and its bay: every 9 m along nave and choir, a window,
/// a buttress, a flyer.
const SITE = vec3(0.0, 231.0, -42.0)
const BAY: f32 = 9.0

/// How far the cathedral is turned on the plateau (radians): its length along the plateau's
/// longer axis, its west front swung half toward the sea's eye, so its flank shows its length and
/// its two west spires stand apart.
const TURN: f32 = 2.69

/// `w` (the world's m, from the isle's centre) in the cathedral's own frame and size.
fn at_church(w: vec3) -> vec3 {
    let r = w - SITE
    let c = cos(TURN)
    let n = sin(TURN)
    vec3(c * r.x + n * r.z, r.y, -n * r.x + c * r.z) / GRAND
}

/// How much grander than the great cathedrals of the world this one is built: every part of it,
/// its doors and its windows too.
const GRAND: f32 = 3.0

/// A pointed arch's outline (an equilateral lancet): `x` across it, `y` up from its sill,
/// `hw` its half-width, `h` the height its arch springs at. Inside, negative.
fn lancet(x: f32, y: f32, hw: f32, h: f32) -> f32 {
    let ax = abs(x)
    let body = if y < h { ax - hw } else { length(vec2(ax + hw, y - h)) - 2.0 * hw }
    max(body, -y)
}

/// Where a window is cut through a wall: its outline `o` (`lancet`'s), `depth` the distance
/// across the wall from its centre and `t` the wall's half-thickness. The cut, the glass at the
/// wall's middle, and the tracery: a mullion and a ring in its head.
fn window(o: f32, x: f32, y: f32, depth: f32, t: f32, hw: f32, h: f32) -> vec3 {
    let cut = max(o, abs(depth) - t - 0.5)
    let glass = max(o, abs(depth) - 0.08)
    let ring = abs(length(vec2(x, y - h - 0.55 * hw)) - 0.42 * hw) - 0.22
    let bars = min(min(abs(x) - 0.22, ring), abs(y - h * 0.5) - 0.18)
    let tracery = max(max(bars, o - 0.0), abs(depth) - 0.35)
    vec3(cut, glass, tracery)
}

/// A pitched roof along x over `half` across (z), its eaves at `eaves`, as steep as `pitch`.
fn roof_x(p: vec3, x0: f32, x1: f32, half: f32, eaves: f32, pitch: f32) -> f32 {
    let ridge = eaves + half * pitch
    let slope = (abs(p.z) * pitch + p.y - ridge) / sqrt(pitch * pitch + 1.0)
    max(max(abs(p.x - (x0 + x1) * 0.5) - (x1 - x0) * 0.5, eaves - p.y), slope)
}

/// An octagonal tower and its spire (the model's m, from its foot): a shaft `r` wide up to `h0`,
/// ringed by string courses, then a spire that swells a little as it tapers to its tip at `h`,
/// frilled with crockets. Its distance, and its gilded tip's.
fn spire_tower(p: vec3, r: f32, h0: f32, h: f32) -> vec2 {
    let a = abs(vec2(p.x, p.z))
    let o = max(max(a.x, a.y), (a.x + a.y) * 0.7071)
    let ring = 0.5 * smoothstep(0.85, 0.95, fract(p.y / 13.0))
    let shaft = max(o - r - ring, max(p.y - h0, -p.y - 20.0))
    let u = clamp((p.y - h0) / (h - h0), 0.0, 1.0)
    let crocket = (1.0 - u) * 0.6 * smoothstep(0.55, 0.9, fract(p.y / 4.5))
    let rr = r * 0.95 * (1.0 - u) * (1.0 + 0.6 * u) + crocket
    let spire = max((o - rr) * 0.7, max(p.y - h, h0 - p.y))
    let tip = min(max(spire, h - 0.1 * (h - h0) - p.y), length(p - vec3(0.0, h, 0.0)) - r * 0.22)
    vec2(min(shaft, spire), tip)
}

/// The keep the cathedral stands on (the model's m, from `SITE`): 238 m by 120, 40 m high above
/// the plateau and sunk into the rock below it, its walls battered out at the foot, ribbed with
/// buttresses with blind arcades between them and arrow-slit lights, a machicolated gallery and
/// battlements round its top; a round tower at each corner and two along each flank, each with
/// its conical slate roof. Its stone, its slates and its lights.
fn keep(p: vec3) -> vec3 {
    let k = vec3(p.x - 17.0, p.y, abs(p.z))
    let ax = abs(k.x)
    let batter = max(-6.0 - p.y, 0.0) * 0.14
    var wall = sd_box(k - vec3(0.0, -31.0, 0.0), vec3(119.0 + batter, 33.4, 60.0 + batter)) * 0.98
    // Which face is nearer: a flank's (along x) or an end's (along z), and where along it.
    let flank = k.z - 60.0 > ax - 119.0
    let along = if flank { k.x } else { k.z }
    let face = if flank { k.z } else { ax + 59.0 }
    // Buttresses every 12 m, and between them blind arcades in four tiers, three arches to a bay
    // in each: a wall made of many arches a man's size, not a few a giant's.
    let pa = along - 12.0 * round(along / 12.0)
    let pier = sd_box(
        vec3(pa, p.y + 33.0, face - 60.0 - batter - 1.0),
        vec3(1.7, 32.0, 2.2),
    )
    let ba = along - 12.0 * round((along - 6.0) / 12.0) - 6.0
    let sub = ba - 2.9 * round(ba / 2.9)
    let tier_y = p.y + 58.0
    let ty = tier_y - 11.0 * floor(tier_y / 11.0)
    let arch = max(
        max(lancet(sub, ty - 1.2, 0.95, 5.6), abs(ba) - 4.3),
        max(-58.0 - p.y, p.y + 14.0),
    )
    let blind = max(arch, 60.0 + batter - 1.0 - face)
    wall = max(wall, -blind)
    let light = 1.0e5
    wall = min(wall, pier)
    // The machicolated gallery round the top, on its corbels, and the battlements on it.
    wall = min(wall, sd_box(k - vec3(0.0, -0.4, 0.0), vec3(121.2, 2.8, 62.2)))
    let ca = along - 2.2 * round(along / 2.2)
    let corbel = max(abs(ca) - 0.5, max(abs(p.y + 4.3) - 1.2, face - 61.8))
    wall = min(wall, max(corbel, 59.5 - face))
    let parapet = max(
        sd_box(k - vec3(0.0, 4.3, 0.0), vec3(121.2, 1.9, 62.2)),
        -sd_box(k - vec3(0.0, 4.3, 0.0), vec3(120.0, 3.0, 61.0)),
    )
    // (A pierced parapet, not battlements: a pinnacle on every buttress, and a smaller between,
    // so its skyline bristles as a gothic one does.)
    wall = min(wall, parapet)
    let pin_a = along - 6.0 * round(along / 6.0)
    let big_pin = abs(along - 12.0 * round(along / 12.0)) < 1.0
    let pin_h = if big_pin { 9.0 } else { 5.0 }
    let pin_r = if big_pin { 1.1 } else { 0.7 }
    wall = min(wall, sd_spire(vec3(pin_a, p.y - 6.2, face - 61.6), pin_r, pin_h))
    // At its corners and along its flanks, no towers: stepped buttresses rising over the wall
    // walk to pinnacles, as a gothic church's are; it's the cathedral's own podium, not a castle.
    let slate = 1.0e5
    let t1 = vec2(ax - 119.0, k.z - 60.0)
    let t2 = vec2(ax - 52.0, k.z - 61.0)
    let corner = length(t1) < length(t2) + 3.0
    let tq = if corner { t1 } else { t2 }
    let r = if corner { 5.5 } else { 4.0 }
    let tb = max(-12.0 - p.y, 0.0) * 0.12
    let tq_a = abs(tq)
    let shaft = max(max(tq_a.x, tq_a.y) - r - tb, max(p.y - 12.0, -66.0 - p.y))
    let stage = max(max(tq_a.x, tq_a.y) - r * 0.7, abs(p.y - 15.0) - 3.0)
    let pin = sd_octo_spire(vec3(tq.x, p.y - 18.0, tq.y), r * 0.75, r * 3.2)
    wall = min(wall, min(min(shaft, stage), pin) * 0.98)
    vec3(wall, slate, light)
}

/// The cathedral in true size, as the great gothic ones are built (the world's m, from `SITE`),
/// on its keep: nave and choir 144 m long in sixteen bays, double aisles, two tiers of flyers, a
/// transept with roses, a lantern tower and spire over the crossing, an apse ringed by chapels,
/// and twin west towers of 175 m. The distance and the material (`STONE`, `GILT`, `GLASS`,
/// `ROOF`).
fn church(p: vec3) -> vec2 {
    // Far from it, its box.
    let outer = sd_box(p - vec3(17.0, 76.0, 0.0), vec3(126.0, 145.0, 72.0))
    if outer > 4.0 {
        return vec2(outer, STONE)
    }
    let az = abs(p.z)
    let kp = keep(p)
    var stone = kp.x
    var glass = kp.z
    var roof = kp.y
    var gilt = 1.0e5
    // The bay this point is in, along nave and choir (sixteen, from -58 to 86).
    let k = clamp(floor((p.x + 58.0) / BAY), 0.0, 15.0)
    let bx = p.x - (-58.0 + (k + 0.5) * BAY)
    let edge_x = p.x - (-58.0 + clamp(round((p.x + 58.0) / BAY), 1.0, 15.0) * BAY)
    // Nave and choir: the high walls, 2 m thick, their clerestory windows.
    var nave = max(
        sd_box(p - vec3(14.0, 22.0, 0.0), vec3(72.0, 22.0, 9.5)),
        -sd_box(p - vec3(14.0, 22.0, 0.0), vec3(71.0, 30.0, 7.5)),
    )
    let cw = window(lancet(bx, p.y - 26.0, 2.7, 11.0), bx, p.y - 26.0, az - 8.5, 1.0, 2.7, 11.0)
    nave = max(nave, -cw.x)
    stone = min(stone, min(nave, cw.z))
    glass = min(glass, cw.y)
    // The aisles: out to 24 m, 22 m high, their windows.
    var aisle = max(sd_box(p - vec3(14.0, 11.0, 0.0), vec3(72.0, 11.0, 24.0)), 9.0 - az)
    let aw = window(lancet(bx, p.y - 4.0, 2.3, 10.0), bx, p.y - 4.0, az - 23.0, 1.0, 2.3, 10.0)
    aisle = max(aisle, -aw.x)
    stone = min(stone, min(aisle, aw.z))
    glass = min(glass, aw.y)
    // The aisles' lean-to roofs.
    roof = min(
        roof,
        max(
            max(abs(p.x - 14.0) - 72.5, max(9.0 - az, az - 24.6)),
            max(21.5 - p.y, p.y - 22.0 - (24.6 - az) * 0.42),
        ),
    )
    // The nave's roof, steep and leaded, and its ridge.
    roof = min(roof, roof_x(p, -58.0, 86.0, 10.0, 44.0, 1.45))
    // The buttresses at each bay's edge: the outer piers and their pinnacles, the piers between
    // the aisles, and the flyers from both to the high wall in two tiers.
    let b = vec3(edge_x, p.y, az)
    stone = min(stone, sd_box(b - vec3(0.0, 15.5, 27.0), vec3(1.4, 15.5, 3.2)))
    stone = min(stone, sd_box(b - vec3(0.0, 16.5, 16.5), vec3(1.1, 16.5, 1.1)))
    stone = min(stone, sd_spire(b - vec3(0.0, 31.0, 27.0), 1.5, 13.0))
    stone = min(stone, sd_spire(b - vec3(0.0, 33.0, 16.5), 1.15, 9.0))
    stone = min(stone, sd_segment(b, vec3(0.0, 29.5, 26.0), vec3(0.0, 32.5, 17.0), 0.55))
    stone = min(stone, sd_segment(b, vec3(0.0, 32.0, 16.0), vec3(0.0, 40.5, 9.8), 0.55))
    stone = min(stone, sd_segment(b, vec3(0.0, 23.5, 26.0), vec3(0.0, 26.5, 17.0), 0.5))
    stone = min(stone, sd_segment(b, vec3(0.0, 26.0, 16.0), vec3(0.0, 34.0, 9.8), 0.5))
    // The high wall's parapet pinnacles.
    stone = min(stone, sd_spire(b - vec3(0.0, 44.0, 9.6), 0.7, 5.5))
    // The transept: across the crossing (x 22 to 42), its arms 46 m out, its roof, and a rose
    // and a portal in each end.
    let t = vec3(p.x - 32.0, p.y, az)
    var arm = max(
        sd_box(t - vec3(0.0, 22.0, 23.0), vec3(10.0, 22.0, 23.0)),
        -sd_box(t - vec3(0.0, 22.0, 23.0), vec3(8.0, 30.0, 22.0)),
    )
    let rose_o = length(vec2(t.x, t.y - 29.0)) - 7.0
    let rose_cut = max(rose_o, abs(t.z - 45.0) - 1.5)
    let spoke = abs(sin(atan2(t.y - 29.0, t.x) * 6.0)) * length(vec2(t.x, t.y - 29.0)) - 0.35
    let rose_bars = max(
        max(
            min(
                min(spoke, abs(length(vec2(t.x, t.y - 29.0)) - 3.0) - 0.3),
                abs(rose_o + 0.3) - 0.3,
            ),
            rose_o - 0.0,
        ),
        abs(t.z - 45.0) - 0.4,
    )
    let portal = lancet(t.x, t.y - 2.4, 3.2, 7.0)
    arm = max(arm, -max(portal, abs(t.z - 45.5) - 1.5))
    arm = max(arm, -rose_cut)
    stone = min(stone, min(arm, rose_bars))
    glass = min(glass, max(rose_o, abs(t.z - 45.0) - 0.08))
    stone = min(stone, sd_box(vec3(abs(t.x) - 10.5, t.y - 24.0, t.z - 44.5), vec3(1.8, 24.0, 1.8)))
    stone = min(stone, sd_spire(vec3(abs(t.x) - 10.5, t.y - 48.0, t.z - 44.5), 1.9, 16.0))
    let gable = max(abs(t.z - 45.6) - 0.6, max(44.0 - t.y, abs(t.x) * 1.45 + t.y - 58.5))
    stone = min(stone, gable)
    roof = min(roof, roof_x(vec3(t.z - 23.0, t.y, t.x), -23.0, 23.0, 10.0, 44.0, 1.45))
    // Over the crossing, the lantern tower: square to the ridge and a stage above it, with its
    // paired belfry lights and corner pinnacles; on it an octagon of tall lights; then its spire.
    let c = vec3(p.x - 32.0, p.y, p.z)
    let ca = abs(vec2(c.x, c.z))
    var lantern = sd_box(c - vec3(0.0, 60.0, 0.0), vec3(11.5, 19.0, 11.5))
    let cf = min(ca.x, ca.y)
    let cd = max(ca.x, ca.y)
    let cl = lancet(abs(cf) - 4.2, c.y - 52.0, 2.3, 16.0)
    lantern = max(lantern, -max(cl, 8.5 - cd))
    let cc = vec3(ca.x - 11.0, c.y, ca.y - 11.0)
    lantern = min(lantern, sd_box(cc - vec3(0.0, 60.0, 0.0), vec3(1.9, 20.0, 1.9)))
    stone = min(stone, sd_spire(cc - vec3(0.0, 80.0, 0.0), 2.1, 15.0))
    let spire = spire_tower(c, 10.5, 106.0, 215.0)
    let c8 = max(max(ca.x, ca.y), (ca.x + ca.y) * 0.7071)
    let cang = atan2(c.z, c.x)
    let cs = cang - 0.7854 * round(cang / 0.7854)
    let ll = lancet(length(vec2(c.x, c.z)) * cs, c.y - 81.0, 1.7, 11.0)
    stone = min(stone, max(min(lantern, spire.x), -max(ll, 7.2 - c8)))
    gilt = min(gilt, spire.y)
    // The apse: the choir's end rounded, its tall windows, the ambulatory round it, and five
    // chapels ringing that, each with its own pointed roof.
    let a = vec3(p.x - 86.0, p.y, p.z)
    let ar = length(vec2(a.x, a.z))
    let ang = atan2(a.z, a.x)
    let sector = 0.4488
    let aa = ang - sector * round(ang / sector)
    let apse = max(max(abs(ar - 8.5) - 1.0, abs(a.y - 22.0) - 22.0), -a.x)
    let apw = window(
        lancet(ar * aa, a.y - 26.0, 1.8, 11.0),
        ar * aa,
        a.y - 26.0,
        ar - 8.5,
        1.0,
        1.8,
        11.0,
    )
    stone = min(stone, max(apse, -apw.x))
    stone = min(stone, max(apw.z, -a.x))
    glass = min(glass, max(apw.y, -a.x))
    stone = min(stone, max(max(ar - 24.0, abs(a.y - 11.0) - 11.0), -a.x))
    roof = min(roof, max(-a.x, max(44.0 - a.y, (ar * 1.45 + a.y - 58.5) / 1.76)))
    roof = min(roof, max(-a.x, max(max(21.5 - a.y, ar - 24.6), a.y - 22.0 - (24.6 - ar) * 0.42)))
    for i in 0..5 {
        let ca2 = -1.2566 + f32(i) * 0.6283
        let q = a - vec3(cos(ca2) * 27.0, 0.0, sin(ca2) * 27.0)
        let qr = length(vec2(q.x, q.z))
        stone = min(stone, max(qr - 6.5, abs(q.y - 9.0) - 9.0))
        roof = min(roof, sd_spire(q - vec3(0.0, 18.0, 0.0), 7.0, 9.0))
        let qa = atan2(q.z, q.x)
        let qs = qa - 0.7854 * round(qa / 0.7854)
        let cwn = window(
            lancet(qr * qs, q.y - 3.5, 1.3, 7.5),
            qr * qs,
            q.y - 3.5,
            qr - 6.0,
            0.8,
            1.3,
            7.5,
        )
        stone = max(stone, -max(cwn.x, 0.5 - qr))
        glass = min(glass, max(cwn.y, 4.0 - qr))
    }
    // The west front: twin towers (x -82 to -58, each 25 m square), their stages (the great
    // window, the belfry, the octagon) and their openwork spires; the gable between them over
    // the great west window, and three deep portals.
    let w = vec3(p.x + 70.0, p.y, az - 17.0)
    var tower = sd_box(w - vec3(0.0, 31.0, 0.0), vec3(12.5, 31.0, 12.5))
    tower = min(tower, sd_box(w - vec3(0.0, 81.0, 0.0), vec3(10.5, 19.0, 10.5)))
    let wa = abs(vec2(w.x, w.z))
    let w8 = max(max(wa.x, wa.y), (wa.x + wa.y) * 0.7071)
    tower = min(tower, max(w8 - 9.0, abs(w.y - 109.0) - 9.0))
    // Corner buttresses, stepping up, and their pinnacles.
    let wc = vec3(wa.x - 11.6, w.y, wa.y - 11.6)
    tower = min(tower, sd_box(wc - vec3(0.0, 33.0, 0.0), vec3(2.6, 33.0, 2.6)))
    tower = min(tower, sd_box(wc - vec3(-1.5, 82.0, -1.5), vec3(1.8, 18.0, 1.8)))
    tower = min(tower, sd_spire(wc - vec3(0.0, 66.0, 0.0), 2.6, 14.0))
    tower = min(tower, sd_spire(wc - vec3(-1.5, 100.0, -1.5), 1.9, 16.0))
    // Each face's windows: the great lancet low, the paired belfry lights high, the octagon's.
    let face_x = min(wa.x, wa.y)
    let face_d = max(wa.x, wa.y)
    // (Its great window two lights in two tiers, each a lancet of its own.)
    let big = max(
        lancet(abs(face_x) - 1.9, w.y - 26.0 - 22.0 * step(48.0, w.y), 1.45, 13.0),
        abs(w.y - 47.0) - 25.0,
    )
    tower = max(tower, -max(big, abs(face_d - 12.5) - 1.2))
    glass = min(glass, max(big, abs(face_d - 11.6) - 0.08))
    let bel = lancet(abs(face_x) - 4.2, w.y - 66.0, 2.4, 20.0)
    tower = max(tower, -max(bel, -(face_d - 8.0)))
    let oct_l = lancet(min(wa.x, wa.y) * 0.0 + (face_x * 0.92), w.y - 102.0, 1.5, 9.0)
    tower = max(tower, -max(oct_l, -(w8 - 7.0)))
    stone = min(stone, tower)
    stone = min(stone, sd_octo_spire(w - vec3(0.0, 118.0, 0.0), 8.8, 57.0))
    stone = min(stone, sd_spire(vec3(wa.x - 6.4, w.y - 118.0, wa.y - 6.4), 1.1, 12.0))
    gilt = min(gilt, max(sd_octo_spire(w - vec3(0.0, 118.0, 0.0), 8.85, 57.0), 168.0 - w.y))
    // The gable between the towers, the great west window, the portals (with their gables).
    let f = vec3(p.x + 70.0, p.y, p.z)
    var front = sd_box(f - vec3(0.0, 25.0, 0.0), vec3(12.0, 25.0, 4.6))
    front = min(front, max(abs(f.x + 11.5) - 0.8, max(44.0 - f.y, az * 1.45 + f.y - 58.5)))
    let ww = lancet(p.z, f.y - 22.0, 3.6, 14.0)
    front = max(front, -max(ww, abs(f.x + 11.5) - 1.6))
    glass = min(glass, max(ww, abs(f.x + 11.0) - 0.08))
    stone = min(stone, front)
    let pz = vec2(p.z, az - 17.0)
    let main_portal = lancet(p.z, f.y - 2.4, 4.4, 8.0)
    let side_portal = lancet(az - 17.0, f.y - 2.4, 3.0, 6.0)
    let portals = min(main_portal, side_portal)
    stone = max(stone, -max(portals, abs(f.x + 12.5) - 3.0))
    let pg = max(
        abs(f.x + 13.0) - 0.7,
        max(10.0 - f.y, min(abs(p.z) * 1.9 + f.y - 27.0, abs(az - 17.0) * 1.9 + f.y - 20.0)),
    )
    stone = min(stone, max(pg, -portals))
    stone = min(stone, sd_spire(vec3(f.x + 13.0, f.y - 23.0, abs(az - 8.6)), 0.8, 6.0) + pz.x * 0.0)
    // The crosses at the spires' tops.
    let x1 = vec3(w.x, w.y - 175.0, w.z)
    gilt = min(
        gilt,
        min(
            sd_box(x1 - vec3(0.0, 3.0, 0.0), vec3(0.35, 3.5, 0.35)),
            sd_box(x1 - vec3(0.0, 4.2, 0.0), vec3(0.35, 0.35, 1.6)),
        ),
    )
    var best = vec2(stone, STONE)
    if glass < best.x {
        best = vec2(glass, GLASS)
    }
    if roof < best.x {
        best = vec2(roof, ROOF)
    }
    if gilt < best.x {
        best = vec2(gilt, GILT)
    }
    best
}

/// The town along the plateau's lip (`w` the world's m from the isle's centre, `edge` how far
/// inside the lip it is, m: negative inside): a rampart on the brink with its turrets, and
/// behind it a band of houses packed along lanes, each a few storeys under a pitched roof, a
/// few towers among them. Built at a town's own size: the cathedral's scale is read off them.
fn town(w: vec3, edge: f32, ground: f32) -> vec2 {
    // The rampart: 4 m thick, 14 m over the plateau, its walk's parapet; every 70 m round, a
    // turret rising over it to a slate cone.
    let ang = atan2(w.z, w.x)
    let round_ = length(vec2(w.x, w.z))
    let ta = ang * round_ / 70.0
    let turret_at = (ta - round(ta)) * 70.0
    let turret_r = length(vec2(turret_at, edge + 6.0))
    let wy0 = w.y - PLATEAU
    var wall = max(abs(edge + 6.0) - 2.0, wy0 - 14.0)
    wall = min(wall, max(turret_r - 5.0, wy0 - 22.0))
    var tile = sd_spire(vec3(turret_at, wy0 - 22.0, edge + 6.0), 6.5, 15.0)
    // The houses: one to a 13 m lot (some lots empty, lanes between), from the rampart in to
    // 70 m, cut where the band ends. Each lot's house stays in its lot, so the four lots round the
    // nearest corner hold the nearest house.
    let cell = 13.0
    let corner = floor(vec2(w.x, w.z) / cell + vec2(0.5))
    let band = max(-96.0 - edge, edge + 10.0)
    // (Each house on its terrace.)
    let wy = w.y - ground
    var house = cell * 0.5
    var house_roof = cell * 0.5
    var spire = cell * 0.5
    for i in 0..4 {
        let id = corner - vec2(f32(i % 2), f32(i / 2))
        let r = vec2(w.x, w.z) - (id + vec2(0.5)) * cell
        let h1 = hash2(id)
        let h2 = hash2(id + vec2(17.3, 4.1))
        let h3 = hash2(id + vec2(3.7, 29.9))
        let h4 = hash2(id + vec2(41.2, 13.6))
        // (Not a carpet: lanes run round the town along its terraces' walls, and here and there
        // a square or a garden opens, so its roofs gather in blocks of many sizes.)
        let open_ = noise(id * 0.21 + vec2(4.3, 1.9))
        if h1 > 0.16 && open_ > 0.3 && abs(fract((edge - 4.0) / 31.0) - 0.5) < 0.42 {
            // One lot in forty a tower: a belfry or a guild's, 28 to 56 m to its eaves under a
            // steep slate cap, standing over the roofs, as a town's towers do.
            let tower = h4 > 0.975
            // (Each house near filling its lot, so their roofs run on together with lanes
            // between, not stand apart as posts.)
            let half = if tower { vec2(3.6 + 0.8 * h2) } else {
                vec2(4.0 + 1.6 * h2, 4.4 + 1.4 * h3)
            }
            let long_x = h4 < 0.5
            let eaves = if tower { 28.0 + 28.0 * h3 } else {
                7.0 + 8.0 * h1 * h1 + (if h4 > 0.9 { 7.0 } else { 0.0 })
            }
            let body = sd_box(
                vec3(r.x, wy - (eaves - 20.0) * 0.5, r.y),
                vec3(half.x, (eaves + 20.0) * 0.5, half.y),
            )
            // (Its roof pitched along its length, steep, as a northern town's are; a tower's a
            // pyramid, steeper.)
            let across = if tower { max(abs(r.x), abs(r.y)) } else if long_x { abs(r.y) } else {
                abs(r.x)
            }
            let span = if long_x || tower { half.y } else { half.x }
            let pitch = if tower { 2.0 } else { 0.95 }
            let ridge = eaves + (span + 0.6) * pitch
            let roof = max(
                max(abs(r.x) - half.x - 0.6, abs(r.y) - half.y - 0.6),
                max(eaves - wy, (across * pitch + wy - ridge) / sqrt(pitch * pitch + 1.0)),
            )
            house = min(house, max(body, band))
            if tower {
                spire = min(spire, max(roof, band))
            } else {
                house_roof = min(house_roof, max(roof, band))
            }
        }
    }
    var best = vec2(wall, STONE)
    if house < best.x {
        best = vec2(house, HOUSE)
    }
    tile = min(tile, house_roof)
    if tile < best.x {
        best = vec2(tile, TILE)
    }
    if spire < best.x {
        best = vec2(spire, ROOF)
    }
    best
}

/// The boulders that hang round it, broken from it: where each is (the world's m from the
/// isle's centre) and how big (m). Each well clear of it, the sky between: a boulder that
/// touches the rock's outline only reads as a lump on it. Of a boulder's own sizes, not the rock
/// in small, and many more small than large, a few only specks: a lone few of one size read as
/// pebbles beside it.
const SHARDS = [
    vec4(-930.0, -540.0, -380.0, 58.0),
    vec4(820.0, -780.0, -300.0, 72.0),
    vec4(705.0, -985.0, -340.0, 26.0),
    vec4(-560.0, -1010.0, -120.0, 64.0),
    vec4(649.0, -773.0, 244.0, 44.0),
    vec4(316.0, -783.0, -483.0, 34.0),
]

/// A boulder of radius `r` at `p` (from its centre, the world's m), `seed` its own: a lump of the
/// rock's bedded stone, longer than it is tall, broken off along a few flat planes and knobbed.
fn boulder(p: vec3, r: f32, seed: f32) -> f32 {
    let far = length(p) - 1.35 * r
    if far > 0.0 {
        return far + 1.0
    }
    let (c, n) = (cos(seed * 2.3), sin(seed * 2.3))
    let b = vec3(c * p.x - n * p.z, p.y, n * p.x + c * p.z)
    let e = vec3(1.0, 0.62, 0.8) * r
    var d = (length(b / e) - 1.15) * r * 0.62
    d += (fbm3(b / r * 2.2 + vec3(seed * 7.1), 3) - 0.5) * r * 0.22
    // Where it broke: flat faces, its old top up and the rest each its own way, so it's a
    // faceted chunk catching the light on its planes, not a rounded lump.
    d = max(d, b.y - 0.36 * r)
    for j in 0..6 {
        let fj = f32(j)
        let dir = normalize(
            vec3(
                hash3(vec3(seed, fj, 1.0)) - 0.5,
                (hash3(vec3(seed, fj, 2.0)) - 0.65) * 1.2,
                hash3(vec3(seed, fj, 3.0)) - 0.5,
            ),
        )
        d = max(d, dot(b, dir) - r * (0.42 + 0.22 * hash3(vec3(seed, fj, 4.0))))
    }
    d * 0.8
}

/// The falls: water spilling off the plateau's lip (from the isle's centre, in the rock's model
/// m: x, z, the lip's height, and how wide it leaves it; none where it's 0).
pub const FALLS = [
    vec4(11.1, -112.2, 2.0, 9.0),
    vec4(-64.4, -100.0, 2.0, 6.0),
    vec4(77.8, -103.3, 2.0, 0.0),
]

/// The notch each falls has worn in the lip it spills from (the world's m from the isle's
/// centre): a bite into the brink, 22 m deep, flaring to its top. Negative inside.
fn notches(w: vec3) -> f32 {
    var cut = 1.0e5
    for i in 0..3 {
        let f = FALLS[i]
        if f.w >= 1.0 {
            let lip = f.z * SCALE
            let r = length(vec2(w.x, w.z) - vec2(f.x, f.y) * SCALE)
            let floor_ = lip - 22.0
            let open = f.w * SCALE * 0.35 + max(w.y - floor_, 0.0) * 0.9
            cut = min(cut, max(r - open, floor_ - w.y) * 0.74)
        }
    }
    cut
}

/// The rock and its cathedral at `p` (the world's): the distance, and which material.
pub fn isle(p: vec3) -> vec2 {
    let q = (p - ISLE) / SCALE / vec3(1.25, 1.0, 1.0)
    var d = hewn(q, 1.0, 0.0, 0.0)
    // The plateau's top, cut level.
    d = max(d, q.y - 2.0)
    // The boulders round it.
    let w = p - ISLE
    var rock = d * SCALE
    for i in 0..6 {
        let sh = SHARDS[i]
        rock = min(rock, boulder(w - vec3(sh.x, sh.y, sh.z), sh.w, f32(i) + 1.0))
    }
    var best = vec2(rock, ROCK)
    // The town on its lip: only in the slab over the plateau's rim, read against the rock's
    // side just under it (how far in from the brink each point is).
    let slab = max(abs(w.y - 100.0) - 120.0, length(vec2(w.x / 1.25, w.z)) - 800.0)
    if slab < 0.0 {
        let edge = hewn(vec3(q.x, -3.0, q.z), 1.0, 0.0, 1000.0) * SCALE * 0.75
        // The plateau built up in terraces behind the rampart, each held by its wall, climbing
        // to the keep and under it, as a hill town climbs to its abbey: so the town on them
        // rises into sight from the sea below and the keep grows out of it, no line between.
        let inward = -edge
        var fill = 1.0e5
        for k in 0..7 {
            let from = 12.0 + 11.0 * f32(k)
            fill = min(fill, max((from - inward) * 0.9, w.y - PLATEAU - 15.0 * f32(k + 1)))
        }
        // (Its terraces the rock's own, cut in ledges: their walls bedded stone, their tops
        // grassed, the cathedral's close round the keep a green.)
        if fill < best.x {
            best = vec2(fill, ROCK)
        }
        if edge > -110.0 {
            let ground = PLATEAU + 15.0 * clamp(floor((inward - 12.0) / 11.0) + 1.0, 0.0, 7.0)
            let tn = town(w, edge, ground)
            if tn.x < best.x {
                best = tn
            }
        }
    } else if slab + 2.0 < best.x {
        // (Outside the slab, how far it is, held off its face so the march never takes the slab
        // for a surface.)
        best = vec2(slab + 2.0, ROCK)
    }
    // Where the falls leave it, their notches in its lip.
    best = vec2(max(best.x, -notches(w)), best.y)
    let c = church(at_church(p - ISLE))
    if c.x * GRAND < best.x {
        best = vec2(c.x * GRAND, c.y)
    }
    best
}

/// The isle's normal at `p`, by its differences `e` m apart (a tetrahedron's four taps).
pub fn isle_normal(p: vec3, e: f32) -> vec3 {
    let a = vec3(1.0, -1.0, -1.0)
    let b = vec3(-1.0, -1.0, 1.0)
    let c = vec3(-1.0, 1.0, -1.0)
    let d = vec3(1.0, 1.0, 1.0)
    normalize(
        a * isle(p + a * e).x +
            b * isle(p + b * e).x +
            c * isle(p + c * e).x +
            d * isle(p + d * e).x,
    )
}

/// What the isle is made of at `p` (the world's), facing `n`, material `id`: its albedo, its
/// roughness, its metal, the light it gives (its lit windows) and the ink's line field there.
/// (`foot`: how wide a pixel is there, m: the stone's courses and the lead's seams, finer than
/// a pixel far off, are left to their average, `engine::far::shown`.)
pub fn isle_material(p: vec3, n: vec3, id: f32, foot: f32) -> (vec3, f32, f32, vec3, f32) {
    let q = (p - ISLE) / SCALE
    if id == ROCK {
        // Bedded stone: warm sandstone and grey beds, darker toward the underside, the plateau's
        // grass and the moss on its ledges.
        let bed = noise(vec2(q.y * 0.11 + noise3(q * 0.02) * 2.0, 0.5))
        let band_ = smoothstep(0.35, 0.65, noise(vec2(q.y * 0.045 + noise3(q * 0.015) * 1.5, 7.0)))
        var a = mix(vec3(0.20, 0.15, 0.13), vec3(0.42, 0.33, 0.25), bed)
        // Its great beds: red sandstone and pale grey limestone in turn, tens of metres deep.
        a = mix(a, a * vec3(1.25, 0.85, 0.7), band_ * 0.6)
        a = mix(
            a,
            vec3(0.42, 0.42, 0.42) * (0.8 + 0.4 * bed),
            (1.0 - band_) * smoothstep(0.55, 0.8, noise(vec2(q.y * 0.07, 3.0))) * 0.5,
        )
        a *= 0.75 + 0.5 * noise3(q * 0.18)
        // Its strata, read from far off: broad bands of lighter and darker stone, level.
        a *= 0.6 +
            0.8 * smoothstep(0.3, 0.7, noise(vec2(q.y * 0.06 + noise3(q * 0.01) * 0.8, 11.0)))
        // Darker and cooler down its underside, toward the tip, as a mass hung in its own shade.
        let under = clamp(-q.y / DROP, 0.0, 1.0)
        a = mix(a, vec3(0.16, 0.15, 0.17), under * 0.5)
        a *= mix(1.0, 0.5, smoothstep(0.15, 0.95, under))
        // Under the plateau's lip, the green that spills over it and hangs down the cliff.
        let spill = smoothstep(-34.0, -10.0, q.y) *
            smoothstep(0.75, 0.35, n.y) *
            smoothstep(0.35, 0.6, noise3(q * vec3(0.25, 0.06, 0.25)))
        a = mix(
            a,
            mix(vec3(0.07, 0.1, 0.04), vec3(0.14, 0.17, 0.07), noise3(q * 0.5)),
            spill * 0.85,
        )
        let grass = smoothstep(0.65, 0.85, n.y) * smoothstep(-30.0, -4.0, q.y)
        // (The close's green in fields and copses, worn paths across it: not one flat lawn.)
        let field = noise3(q * 0.035 + vec3(2.0))
        let copse = smoothstep(0.55, 0.75, noise3(q * 0.09 + vec3(7.0)))
        var green = mix(vec3(0.09, 0.14, 0.05), vec3(0.17, 0.22, 0.08), noise3(q * 0.3))
        green *= 0.7 + 0.6 * field
        green = mix(green, vec3(0.04, 0.07, 0.03), copse * 0.8)
        let path = smoothstep(0.035, 0.0, abs(noise(vec2(q.x, q.z) * 0.03) - 0.5)) *
            shown(6.0, foot)
        green = mix(green, vec3(0.3, 0.27, 0.2), path * 0.7)
        a = mix(a, green, grass)
        let moss = smoothstep(0.45, 0.7, n.y) *
            (1.0 - grass) *
            smoothstep(0.5, 0.7, noise3(q * 0.07))
        a = mix(a, vec3(0.12, 0.16, 0.08), moss * 0.7)
        (a, 0.9, 0.0, vec3(0.0), 1.0)
    } else if id == GILT {
        // Gilding: the crosses and the spires' tips, burnished.
        let wear = noise3(p * 0.3)
        (mix(vec3(0.75, 0.52, 0.2), vec3(1.0, 0.8, 0.4), wear), 0.3, 1.0, vec3(0.0), 1.0)
    } else if id == ROOF {
        // Lead, sheeted in bays with standing seams down the slope; dulled, a few sheets newer.
        let c = at_church(p - ISLE)
        let along = if abs(n.x) > abs(n.z) { c.z } else { c.x }
        let lead_k = shown(0.9 * GRAND, foot)
        let seam = smoothstep(0.06, 0.0, abs(fract(along / 0.9) - 0.5) - 0.44) * lead_k
        let sheet = mix(0.5, hash3(vec3(floor(along / 0.9), floor(c.y / 3.0), 1.0)), lead_k)
        var a = mix(vec3(0.13, 0.15, 0.17), vec3(0.2, 0.22, 0.24), sheet)
        a *= 1.0 - 0.35 * seam
        (a, 0.55 + 0.2 * sheet, 0.25, vec3(0.0), 1.0)
    } else if id == HOUSE {
        // Lime-washed walls and stone, each house its own, its windows dark specks.
        let lot = floor(vec2(p.x - ISLE.x, p.z - ISLE.z) / 13.0)
        let h = hash2(lot + vec2(5.1, 2.2))
        var a = mix(vec3(0.62, 0.57, 0.48), vec3(0.72, 0.68, 0.6), h)
        // (Half of them bare stone, warm grey and ochre: a town of its rock, not of the
        // cathedral's pale ashlar, so it doesn't melt into the keep from far off.)
        let stone_ = mix(
            vec3(0.38, 0.33, 0.28),
            vec3(0.52, 0.44, 0.33),
            hash2(lot + vec2(2.4, 7.7)),
        )
        a = mix(a, stone_, step(0.5, hash2(lot + vec2(9.9, 1.3))))
        let win = smoothstep(0.3, 0.1, abs(fract(p.y / 3.2) - 0.55)) *
            smoothstep(0.3, 0.1, abs(fract((p.x + p.z) / 2.6) - 0.5))
        a *= 1.0 - 0.55 * win * shown(2.6, foot) - 0.2 * (1.0 - shown(2.6, foot))
        (a, 0.85, 0.0, vec3(0.0), 1.0)
    } else if id == TILE {
        // Their roofs: red tile and grey slate, weathered, each its own.
        let lot = floor(vec2(p.x - ISLE.x, p.z - ISLE.z) / 13.0)
        let h = hash2(lot + vec2(1.7, 8.8))
        // (A value darker than the walls under them, so far off the town reads as roofs over
        // walls, and the keep's pale foot stands on it, not melts into it.)
        let a = if h < 0.5 { mix(vec3(0.3, 0.12, 0.07), vec3(0.38, 0.18, 0.1), hash2(lot)) } else {
            mix(vec3(0.11, 0.115, 0.13), vec3(0.16, 0.16, 0.17), hash2(lot))
        }
        (a, 0.7, 0.0, vec3(0.0), 1.0)
    } else if id == GLASS {
        // Stained glass: each light its colour, the sun through it from inside the nave.
        let c = at_church(p - ISLE)
        let cell = floor(c * 0.6)
        let h = hash3(cell)
        let pane = if h < 0.45 { vec3(0.15, 0.25, 0.9) } else if h < 0.75 {
            vec3(0.9, 0.18, 0.12)
        } else { vec3(1.0, 0.75, 0.25) }
        // (Too far for a pixel to hold its panes, a window is one warm light: its colours, each
        // a pixel's, would only reshuffle as the eye moves.)
        let tint = mix(vec3(1.0, 0.56, 0.24), pane, shown(1.67 * GRAND, foot))
        let lead = smoothstep(
            0.08,
            0.0,
            min(abs(fract(c.y * 0.6) - 0.5), abs(fract((c.x + c.z) * 0.6) - 0.5)) - 0.42,
        ) *
            shown(1.67 * GRAND, foot) +
            0.15 * (1.0 - shown(1.67 * GRAND, foot))
        // (And far off, a window's light no more than a warm speck: by day, from 8 km, a
        // cathedral's windows are dark, not lamps.)
        let far_dim = mix(0.02, 1.0, shown(1.67 * GRAND, foot))
        (
            vec3(0.02),
            mix(0.55, 0.08, shown(1.67 * GRAND, foot)),
            0.0,
            tint * (1.0 - lead) * 1.8 * far_dim,
            1.0,
        )
    } else {
        // Limestone in ashlar: courses 0.6 m, blocks staggered, each its own tint; rain's dark
        // streaks below every ledge; grime at the foot; lichen.
        let c = at_church(p - ISLE)
        let along = if abs(n.x) > abs(n.z) { c.z } else { c.x }
        let row = floor(c.y / 0.6)
        let col = floor(along / 1.2 + row * 0.5)
        let course_k = shown(0.6 * GRAND, foot)
        let block = mix(0.5, hash3(vec3(row, col, 3.0)), shown(1.2 * GRAND, foot))
        let joint = course_k *
            max(
                smoothstep(0.05, 0.0, abs(fract(c.y / 0.6) - 0.5) - 0.44),
                smoothstep(0.03, 0.0, abs(fract(along / 1.2 + row * 0.5) - 0.5) - 0.47),
            ) *
            smoothstep(0.7, 0.3, abs(n.y))
        var a = vec3(0.62, 0.56, 0.46) * (0.86 + 0.22 * block)
        a = mix(a, vec3(0.5, 0.52, 0.5), 0.3 * smoothstep(0.3, 0.8, noise3(c * 0.05)))
        // Weathered unevenly, wall by wall: paler where the sun bleaches it, darker where the
        // rain stains it, in tall patches a far eye still reads.
        a *= 0.8 + 0.4 * noise3(c * vec3(0.07, 0.018, 0.07) + vec3(3.3))
        let streak = mix(
            0.25,
            smoothstep(0.45, 0.9, noise(vec2(along * 0.9, c.y * 0.04))),
            shown(1.1 * GRAND, foot),
        ) *
            smoothstep(0.5, -0.2, n.y)
        a *= 1.0 - 0.45 * streak
        a *= 1.0 - 0.3 * smoothstep(12.0, 0.0, c.y)
        a *= 1.0 - 0.25 * joint
        let lichen = smoothstep(0.62, 0.8, noise3(c * 0.3)) * smoothstep(30.0, 0.0, c.y)
        a = mix(a, vec3(0.36, 0.38, 0.22), lichen * 0.5)
        (a, 0.85, 0.0, vec3(0.0), 1.0)
    }
}

/// How much of the sun reaches `p` past the isle: a soft shadow marched toward it.
/// (Its first step jittered by `jit` (0 to 1), a pixel's own: else the steps of neighbouring
/// pixels fall together and a face the sun rakes is banded in a fan of stripes.)
pub fn isle_shadow(p: vec3, l: vec3, start: f32, jit: f32) -> f32 {
    var t = start * (1.0 + 2.0 * jit)
    var lit = 1.0
    var i = 0
    while i < 72 && t < 5600.0 && lit > 0.02 {
        let h = isle(p + l * t).x
        lit = min(lit, 10.0 * h / t)
        t += clamp(h, 1.5, 170.0)
        i += 1
    }
    clamp(lit, 0.0, 1.0)
}

/// How much of the sky reaches `p` on the isle, facing `n`: five taps out along its normal.
pub fn isle_ao(p: vec3, n: vec3) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..6 {
        let h = 5.6 * f32(i * i)
        hidden += w * max(h - isle(p + n * h).x, 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.55, 0.0, 1.0)
}
