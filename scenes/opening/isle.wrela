// The rock floating in the sky and its cathedral, massive and far: an inverted mountain of
// bedded stone hewn into planes, with spurs hanging under it and chunks drifting by; on its
// plateau a gothic cathedral hundreds of metres tall, its nave and aisles, flying buttresses,
// pinnacles, transept, crossing tower and spires gilded at their tips, its lancets and rose
// window lit from within.
//
// Distances are built at a model's scale and drawn `SCALE` times it (`isle`).

use look::{GILT, ISLE, ROCK, STONE, fbm3, noise, noise3}

/// How much larger the isle is drawn than it's modelled.
pub const SCALE: f32 = 4.4

/// How tall the rock is under its plateau, and how wide its plateau (the model's m).
const DROP: f32 = 290.0
const TOP: f32 = 118.0

/// The cathedral's size on the model, over the rock's.
const CHURCH_SCALE: f32 = 1.9
/// How much taller than wide the cathedral is drawn: its towers and spires reach.
const TALL: f32 = 1.4

/// Where the isle's bounds are (the world's): a sphere round it.
pub fn bounds() -> vec4 {
    vec4(ISLE + vec3(0.0, -55.0 * SCALE, 0.0), 300.0 * SCALE)
}

fn sd_box(p: vec3, b: vec3) -> f32 {
    let q = abs(p) - b
    length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

/// A cone standing on its base at y = 0, `r` wide there and `h` tall: a spire.
fn sd_spire(p: vec3, r: f32, h: f32) -> f32 {
    let q = vec2(length(vec2(p.x, p.z)), p.y)
    let side = normalize(vec2(h, r))
    max(dot(q - vec2(r, 0.0), side), -p.y)
}

/// An eight-sided spire: its faces' planes, a gothic spire's broaches.
fn sd_octo_spire(p: vec3, r: f32, h: f32) -> f32 {
    let a = abs(vec2(p.x, p.z))
    let o = max(max(a.x, a.y), (a.x + a.y) * 0.7071)
    let side = normalize(vec2(h, r))
    max(dot(vec2(o, p.y) - vec2(r, 0.0), side), -p.y)
}

fn sd_segment(p: vec3, a: vec3, b: vec3, r: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    length(pa - ba * h) - r
}

/// The planes a rock is hewn by: each a normal's direction and how far out it cuts.
const CUTS = [
    vec4(0.80, -0.45, 0.25, 92.0),
    vec4(-0.75, -0.40, 0.42, 96.0),
    vec4(0.15, -0.42, -0.82, 90.0),
    vec4(-0.50, -0.35, -0.74, 98.0),
    vec4(0.97, -0.10, -0.20, 108.0),
    vec4(-0.96, -0.12, 0.25, 110.0),
    vec4(0.35, -0.50, 0.62, 88.0),
    vec4(-0.25, -0.15, 0.96, 106.0),
]

/// A rock hewn from an inverted mountain: `q` from its top's centre (the model's m), `s` its
/// scale, `turn` its turn about the vertical.
fn hewn(q: vec3, s: f32, turn: f32) -> f32 {
    let c = cos(turn)
    let n = sin(turn)
    let p = vec3(q.x * c - q.z * n, q.y, q.x * n + q.z * c) / s
    let r = length(vec2(p.x, p.z))
    let ang = atan2(p.z, p.x)
    // Broad at the top, falling to a point, gouged by crags that run down it and ledged by its
    // beds.
    let k = clamp((p.y + DROP) / DROP, 0.0, 1.0)
    let wide = TOP * pow(k, 0.85)
    let crag = (noise(vec2(ang * 4.0, p.y * 0.010)) - 0.5) * 46.0 * k +
        (noise(vec2(ang * 11.0, p.y * 0.03 + 7.0)) - 0.5) * 18.0
    let beds = abs(fract(p.y / 9.0 + noise(vec2(ang * 3.0, 1.0)) * 0.6) - 0.5) * 3.0
    var d = max((r - wide - crag + beds * 0.3) * 0.55, max(p.y, -DROP - p.y))
    for i in 0..8 {
        let cut = CUTS[i]
        d = max(d, dot(p, normalize(vec3(cut.x, cut.y, cut.z))) - cut.w)
    }
    // Spurs hanging under it.
    let spur_a = vec2(p.x - 50.0, p.z + 18.0)
    let spur_b = vec2(p.x + 46.0, p.z - 10.0)
    d = min(
        d,
        max(
            length(spur_a) - 15.0 * clamp((p.y + 175.0) / 115.0, 0.0, 1.0),
            max(p.y + 60.0, -175.0 - p.y),
        ) *
            0.7,
    )
    d = min(
        d,
        max(
            length(spur_b) - 12.0 * clamp((p.y + 140.0) / 90.0, 0.0, 1.0),
            max(p.y + 50.0, -140.0 - p.y),
        ) *
            0.7,
    )
    // Its fractures, running down it, and its beds' ledges.
    let fracture = 1.0 - abs(noise3(p * vec3(0.035, 0.006, 0.035)) * 2.0 - 1.0)
    d += fracture * fracture * 7.0
    d += smoothstep(
        0.3,
        0.55,
        fract(p.y / 23.0 + noise(vec2(ang * 3.0, 3.0)) * 0.9 + noise3(p * 0.03) * 0.6),
    ) *
        0.9
    d += (fbm3(p * 0.04, 3) - 0.5) * 5.0 + (noise3(p * 0.35) - 0.5) * 1.0
    d * s
}

/// The cathedral (the model's m, before `CHURCH_SCALE`), from its plateau's centre: its nave
/// along x, its west front at -x. The distance, and which material (`STONE`, `GILT`).
fn church(q: vec3) -> vec2 {
    let p = q - vec3(4.0, 0.0, 8.0)
    // The nave and its clerestory; the aisles, lower, beside it.
    var d = sd_box(p - vec3(0.0, 15.0, 0.0), vec3(32.0, 15.0, 8.0))
    d = min(d, sd_box(p - vec3(0.0, 8.0, 0.0), vec3(30.0, 8.0, 12.5)))
    // The plinth it stands on.
    d = min(d, sd_box(p - vec3(-2.0, 0.6, 0.0), vec3(40.0, 1.2, 26.0)))
    // Buttresses along the aisles every 8 m, and the flying arches from them to the clerestory.
    let rx = p.x - 8.0 * round(clamp(p.x, -28.0, 28.0) / 8.0)
    let side = vec3(rx, p.y, abs(p.z))
    d = min(d, sd_box(side - vec3(0.0, 9.0, 13.6), vec3(1.0, 9.0, 1.4)))
    d = min(d, sd_segment(side, vec3(0.0, 18.0, 13.6), vec3(0.0, 26.5, 8.2), 0.55))
    d = min(d, sd_segment(side, vec3(0.0, 13.0, 13.6), vec3(0.0, 20.0, 8.2), 0.45))
    // The windows' recesses in the clerestory: the walls' depth.
    let wx = p.x - 4.0 - 8.0 * round((p.x - 4.0) / 8.0)
    let lancet = max(abs(wx) - 1.6, max(abs(p.y - 21.0) - 6.5, abs(abs(p.z) - 8.0) - 0.5))
    d = max(d, -lancet)
    var stone = d
    // The pinnacles on the buttresses.
    var gilt = sd_spire(side - vec3(0.0, 18.0, 13.6), 1.3, 9.0)
    // The nave's roof, the transept's and the crossing.
    let roof = max(abs(p.x) - 32.0, max(30.0 - p.y, abs(p.z) * 1.1 + (p.y - 30.0) - 8.8))
    gilt = min(gilt, roof)
    let t = p - vec3(10.0, 0.0, 0.0)
    stone = min(stone, sd_box(t - vec3(0.0, 14.0, 0.0), vec3(8.0, 14.0, 22.0)))
    gilt = min(gilt, max(abs(t.z) - 22.0, max(28.0 - t.y, abs(t.x) * 1.1 + (t.y - 28.0) - 8.8)))
    // The crossing tower: two stages and the great spire.
    stone = min(stone, sd_box(t - vec3(0.0, 24.0, 0.0), vec3(7.5, 24.0, 7.5)))
    stone = min(stone, sd_box(t - vec3(0.0, 50.0, 0.0), vec3(6.2, 4.0, 6.2)))
    let tc = vec3(abs(t.x) - 7.0, t.y, abs(t.z) - 7.0)
    gilt = min(gilt, sd_spire(tc - vec3(0.0, 48.0, 0.0), 1.3, 18.0))
    stone = min(stone, sd_octo_spire(t - vec3(0.0, 54.0, 0.0), 6.0, 70.0))
    gilt = min(gilt, max(sd_octo_spire(t - vec3(0.0, 54.0, 0.0), 6.05, 70.0), 100.0 - t.y))
    // The apse and its chapels.
    let a = p - vec3(32.0, 0.0, 0.0)
    stone = min(stone, max(length(vec2(a.x, a.z)) - 9.0, abs(a.y - 13.0) - 13.0))
    gilt = min(gilt, sd_spire(a - vec3(0.0, 26.0, 0.0), 9.5, 12.0))
    for k in 0..3 {
        let ang = -0.9 + f32(k) * 0.9
        let c = a - vec3(cos(ang) * 10.0, 0.0, sin(ang) * 10.0)
        stone = min(stone, max(length(vec2(c.x, c.z)) - 3.5, abs(c.y - 7.0) - 7.0))
        gilt = min(gilt, sd_spire(c - vec3(0.0, 14.0, 0.0), 3.8, 5.0))
    }
    // The west front's two towers, their stages, their spires and corner pinnacles.
    let w = vec3(p.x + 34.0, p.y, abs(p.z) - 9.0)
    stone = min(stone, sd_box(w - vec3(0.0, 21.0, 0.0), vec3(6.5, 21.0, 6.5)))
    stone = min(stone, sd_box(w - vec3(0.0, 46.0, 0.0), vec3(5.2, 6.0, 5.2)))
    let belfry = max(abs(w.y - 46.0) - 4.0, min(abs(w.x), abs(w.z)) - 1.2)
    stone = max(stone, -max(belfry, max(abs(w.x), abs(w.z)) - 5.4))
    stone = min(stone, sd_octo_spire(w - vec3(0.0, 52.0, 0.0), 5.0, 56.0))
    gilt = min(gilt, max(sd_octo_spire(w - vec3(0.0, 52.0, 0.0), 5.05, 56.0), 92.0 - w.y))
    let corner = vec3(abs(w.x) - 5.8, w.y, abs(w.z) - 5.8)
    gilt = min(gilt, sd_spire(corner - vec3(0.0, 42.0, 0.0), 1.2, 16.0))
    // The west front between the towers, its gable and its portal's recess.
    let front = p - vec3(-34.0, 0.0, 0.0)
    stone = min(stone, sd_box(front - vec3(0.0, 17.0, 0.0), vec3(5.5, 17.0, 3.5)))
    stone = max(stone, -sd_box(front - vec3(-6.0, 6.0, 0.0), vec3(1.2, 6.0, 2.4)))
    if gilt < stone { vec2(gilt, GILT) } else { vec2(stone, STONE) }
}

/// The rock and its cathedral at `p` (the world's): the distance, and which material.
pub fn isle(p: vec3) -> vec2 {
    let q = (p - ISLE) / SCALE
    var d = hewn(q, 1.0, 0.0)
    // The plateau's top, cut level.
    d = max(d, q.y - 2.0)
    // Chunks drifting under it.
    d = min(d, hewn(q - vec3(-128.0, -150.0, -30.0), 0.17, 1.3))
    d = min(d, hewn(q - vec3(118.0, -96.0, -60.0), 0.12, 2.6))
    d = min(d, hewn(q - vec3(40.0, -238.0, -10.0), 0.08, 4.1))
    d = min(d, hewn(q - vec3(-60.0, -40.0, -170.0), 0.06, 0.4))
    let c = church((q - vec3(0.0, 2.0, 0.0)) / CHURCH_SCALE * vec3(1.0, 1.0 / TALL, 1.0))
    let cd = c.x * CHURCH_SCALE
    if cd < d { vec2(cd * SCALE, c.y) } else { vec2(d * SCALE, ROCK) }
}

/// The isle's normal at `p`, by its differences `e` m apart (a tetrahedron's four taps).
pub fn isle_normal(p: vec3, e: f32) -> vec3 {
    let a = vec3(1.0, -1.0, -1.0)
    let b = vec3(-1.0, -1.0, 1.0)
    let c = vec3(-1.0, 1.0, -1.0)
    let d = vec3(1.0, 1.0, 1.0)
    normalize(
        a * isle(p + a * e).x +
            b * isle(p + b * e).x +
            c * isle(p + c * e).x +
            d * isle(p + d * e).x,
    )
}

/// What the isle is made of at `p` (the world's), facing `n`, material `id`: its albedo, its
/// roughness, its metal, the light it gives (its lit windows) and the ink's line field there.
pub fn isle_material(p: vec3, n: vec3, id: f32) -> (vec3, f32, f32, vec3, f32) {
    let q = (p - ISLE) / SCALE
    if id == ROCK {
        // Bedded stone: warm sandstone and grey beds, darker toward the underside, the plateau's
        // grass and the moss on its ledges.
        let bed = noise(vec2(q.y * 0.11 + noise3(q * 0.02) * 2.0, 0.5))
        var a = mix(vec3(0.22, 0.18, 0.15), vec3(0.40, 0.33, 0.26), bed)
        a *= 0.75 + 0.5 * noise3(q * 0.18)
        let under = clamp(-q.y / DROP, 0.0, 1.0)
        a = mix(a, vec3(0.16, 0.15, 0.17), under * 0.5)
        let grass = smoothstep(0.65, 0.85, n.y) * smoothstep(-30.0, -4.0, q.y)
        a = mix(a, mix(vec3(0.09, 0.14, 0.05), vec3(0.17, 0.22, 0.08), noise3(q * 0.3)), grass)
        let moss = smoothstep(0.45, 0.7, n.y) *
            (1.0 - grass) *
            smoothstep(0.5, 0.7, noise3(q * 0.07))
        a = mix(a, vec3(0.12, 0.16, 0.08), moss * 0.7)
        (a, 0.9, 0.0, vec3(0.0), 1.0)
    } else if id == GILT {
        // Gilded lead: gold, worn darker in streaks.
        let wear = noise3(q * vec3(0.4, 0.08, 0.4))
        (mix(vec3(0.70, 0.48, 0.18), vec3(1.0, 0.78, 0.36), wear), 0.42, 1.0, vec3(0.0), 1.0)
    } else {
        // Pale limestone, its courses; its lancets and rose lit amber from within.
        let c = (q - vec3(0.0, 2.0, 0.0)) / CHURCH_SCALE * vec3(1.0, 1.0 / TALL, 1.0) -
            vec3(4.0, 0.0, 8.0)
        var a = vec3(0.52, 0.44, 0.35) * (0.85 + 0.25 * noise3(q * 0.6))
        let course = smoothstep(0.42, 0.5, abs(fract(c.y / 1.2) - 0.5))
        a *= 1.0 - 0.12 * course
        let wx = c.x - 4.0 - 8.0 * round((c.x - 4.0) / 8.0)
        let side = abs(abs(c.z) - 8.0) < 0.55 || abs(abs(c.z) - 12.5) < 0.6
        let arch = abs(wx) + max(c.y - 24.0, 0.0) * 0.45
        let in_clere = arch < 1.5 && c.y > 15.5 && c.y < 27.0
        let aisle_y = abs(c.y - 8.0) < 5.0 && abs(wx) + max(c.y - 10.5, 0.0) * 0.5 < 1.4
        let rose = abs(c.x + 40.0) < 1.0 && length(vec2(c.y - 22.0, c.z)) < 3.4
        let lit = (side && (in_clere || aisle_y)) || rose
        let glow = if lit { vec3(2.2, 1.3, 0.45) * (0.7 + 0.3 * noise3(q * 2.0)) } else {
            vec3(0.0)
        }
        (a, 0.8, 0.0, glow, 1.0)
    }
}
