// The skiff: a small open boat of planks with a free sail rig, as a windsurfer's is (`sail`): a
// mast on a swivel stepped through its forward thwart, a wishbone boom round a battenless sail,
// and its traveller standing to it; where the sea holds it (`Shot::boat` and its axes).

use look::{Shot, hash2, noise}
use sail::{BOOM, BOW_OUT, FOOT, LASHED}

fn sd_box(p: vec3, b: vec3) -> f32 {
    let q = abs(p) - b
    length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0)
}

fn sd_capsule(p: vec3, a: vec3, b: vec3, r: f32) -> f32 {
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    length(pa - ba * h) - r
}

/// The half-length of the hull (m), its beam's half and its depth.
const LONG: f32 = 2.2
const BEAM: f32 = 0.62
const DEEP: f32 = 0.42

/// `p` (the world's) in the skiff's frame: across, up, along.
pub fn local(s: Shot, p: vec3) -> vec3 {
    let r = p - s.boat
    vec3(dot(r, s.boat_x), dot(r, s.boat_y), dot(r, s.boat_z))
}

/// The hull as a solid, from its gunwale's middle (`q`, the skiff's frame): what keeps the sea
/// out of it.
fn hull_solid(q: vec3) -> f32 {
    let z = clamp(q.z / LONG, -1.0, 1.0)
    let taper = if z > 0.0 { 1.0 - pow(z, 1.8) } else { 1.0 - 0.75 * pow(-z, 2.6) }
    let w = max(BEAM * taper, 0.03)
    let sheer = 0.16 * z * z + 0.05 * max(z, 0.0) + 0.3 * pow(max(z, 0.0), 4.0)
    let y = q.y - sheer
    let e = length(vec2(q.x / w, y / DEEP))
    max((e - 1.0) * min(w, DEEP), abs(q.z) - LONG)
}

/// How far `p` (the world's) lies out from the hull's side, the solid hull as it is at `p`'s
/// height: at the water, how far from its waterline.
pub fn hull_off(s: Shot, p: vec3) -> f32 {
    hull_solid(local(s, p))
}

/// Whether the sea at `p` (the world's) lies inside the skiff, where it isn't drawn.
pub fn dry(s: Shot, p: vec3) -> bool {
    let q = local(s, p)
    hull_solid(q) < -0.01 && q.y < 0.2
}

/// The hull's shell, from its gunwale's middle (`q`, the skiff's frame).
fn hull(q: vec3) -> f32 {
    let z = clamp(q.z / LONG, -1.0, 1.0)
    // Pointed at the bow (+z), fuller at the stern; the sheer rising to both.
    let taper = if z > 0.0 { 1.0 - pow(z, 1.8) } else { 1.0 - 0.75 * pow(-z, 2.6) }
    let w = max(BEAM * taper, 0.03)
    let sheer = 0.16 * z * z + 0.05 * max(z, 0.0) + 0.3 * pow(max(z, 0.0), 4.0)
    let y = q.y - sheer
    let e = length(vec2(q.x / w, y / DEEP))
    var d = (e - 1.0) * min(w, DEEP)
    d = max(d, abs(q.z) - LONG)
    // A shell of planks 3 cm thick, open above its sheer.
    d = abs(d + 0.02) - 0.025
    max(d, y)
}

fn smin(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0)
    mix(b, a, h) - k * h * (1.0 - h)
}

/// A cone with round ends from `a` (`ra` across) to `b` (`rb`): a limb, a cloak's fall
/// (Quílez's).
fn sd_round_cone(p: vec3, a: vec3, b: vec3, ra: f32, rb: f32) -> f32 {
    let ba = b - a
    let l2 = dot(ba, ba)
    let rr = ra - rb
    let a2 = l2 - rr * rr
    let il2 = 1.0 / l2
    let pa = p - a
    let y = dot(pa, ba)
    let z = y - l2
    let xv = pa * l2 - ba * y
    let x2 = dot(xv, xv)
    let y2 = y * y * l2
    let z2 = z * z * l2
    let k = sign(rr) * rr * rr * x2
    if sign(z) * a2 * z2 > k {
        return sqrt(x2 + z2) * il2 - rb
    }
    if sign(y) * a2 * y2 < k {
        return sqrt(x2 + y2) * il2 - ra
    }
    (sqrt(x2 * a2 * il2) + y * rr) * il2 - ra
}

/// The mast's height over its foot to the sail's head (m).
const HEAD: f32 = 4.1

/// The sail's cloth at `q` (the skiff's frame): its distance, and where on it (along the boom
/// from the mast, up the mast, m). Its luff on the mast, its foot sweeping up from the tack to
/// the clew at the boom's end, its leech bowed out (the roach) from there to the head; blown into
/// a belly the harder it's sheeted, and let fly, shivering along its leech.
fn cloth(s: Shot, q: vec3) -> (f32, vec2) {
    let r = q - FOOT
    let v = dot(r, s.mast)
    let u = dot(r, s.boom)
    let w = dot(r, s.belly)
    let x = clamp(u / BOOM, 0.0, 1.0)
    let low = 0.22 + (LASHED - 0.22) * pow(x, 2.6)
    let high = HEAD - (HEAD - LASHED) * pow(x, 1.5)
    let edge = max(max(low - v, v - high) * 0.55, max(-u, u - BOOM))
    let up = clamp((v - 0.2) / HEAD, 0.0, 1.0)
    let depth = (0.08 + 0.32 * s.power) * (1.0 - 0.45 * up)
    let shiver = (1.0 - smoothstep(0.1, 0.6, s.power)) *
        (0.08 + 0.2 * x) *
        x *
        sin(u * 5.0 + v * 1.1 - s.held * 30.0) +
        (1.0 - smoothstep(0.3, 0.9, s.power)) * 0.03 * x * sin(u * 13.0 - v * 2.0 - s.held * 47.0)
    let off = w - depth * 4.0 * x * (1.0 - x) * (1.0 + 0.8 * x) - shiver
    let face = abs(off) * 0.85 - 0.011
    (length(max(vec2(face, edge), vec2(0.0))) + min(max(face, edge), 0.0), vec2(u, v))
}

/// The spars: the mast, and the wishbone's two arms bowed round the sail from the mast to the
/// clew.
fn spars(s: Shot, q: vec3) -> f32 {
    let mast = sd_capsule(q, FOOT, FOOT + s.mast * (HEAD + 0.12), 0.03)
    let r = q - FOOT - s.mast * LASHED
    let u = dot(r, s.boom)
    let uc = clamp(u, 0.0, BOOM)
    let bow = BOW_OUT * sin(3.14159 * uc / BOOM) + 0.015
    let arm = length(vec3(u - uc, dot(r, s.mast), abs(dot(r, s.belly)) - bow)) - 0.032
    min(mast, arm)
}

/// The traveller, standing aft of the mast with its hands on the wishbone, hanging out against
/// the sail's pull: legs braced, a long hooded cloak whose skirts the wind streams; from `q`
/// (the skiff's frame).
pub fn figure(s: Shot, q: vec3) -> f32 {
    let up = vec3(y: 1.0)
    // (The knees bent and sprung, out toward the hands: a stance braced against the pull.)
    let toward = normalize(vec3(s.fore_hand.x - s.hips.x, 0.0, s.fore_hand.z - s.hips.z)) * 0.16
    let knee_a = mix(s.fore_foot, s.hips, 0.5) + toward
    let knee_b = mix(s.aft_foot, s.hips, 0.5) + toward * 0.8
    var d = min(
        min(sd_capsule(q, s.fore_foot, knee_a, 0.06), sd_capsule(q, knee_a, s.hips, 0.075)),
        min(sd_capsule(q, s.aft_foot, knee_b, 0.06), sd_capsule(q, knee_b, s.hips, 0.075)),
    )
    // The cloak, from the shoulders falling past the hips, its skirts blown downwind and
    // fluttering.
    let spine = s.neck - s.hips
    let lean = normalize(spine)
    let blow = normalize(vec3(s.belly.x, 0.0, s.belly.z) - vec3(0.0, 0.0, 0.6 + 0.08 * s.speed))
    let flap = (0.05 * sin(s.held * 15.0 + q.y * 4.0) + 0.03 * sin(s.held * 23.0 + q.y * 7.0)) *
        (0.6 + 0.12 * s.speed)
    let skirt = s.hips - lean * 0.2 + blow * (0.22 + 0.05 * s.speed) + up * flap
    d = min(d, sd_round_cone(q, skirt, s.neck - lean * 0.06, 0.17, 0.13))
    // The arms in its sleeves: shoulders square to the hands, the elbows a little bent.
    let mid = (s.fore_hand + s.aft_hand) * 0.5
    let side = normalize(cross(normalize(mid - s.neck), up) + vec3(0.0001))
    let sa = if dot(side, s.fore_hand - s.aft_hand) > 0.0 { side } else { -side }
    let sh_a = s.neck + sa * 0.19 - up * 0.06
    let sh_b = s.neck - sa * 0.19 - up * 0.06
    let el_a = mix(sh_a, s.fore_hand, 0.5) - up * 0.07
    let el_b = mix(sh_b, s.aft_hand, 0.5) - up * 0.07
    d = smin(d, min(sd_capsule(q, sh_a, el_a, 0.055), sd_capsule(q, sh_b, el_b, 0.055)), 0.04)
    d = min(d, min(sd_capsule(q, el_a, s.fore_hand, 0.045), sd_capsule(q, el_b, s.aft_hand, 0.045)))
    // The hood, its peak blown back; under it, the white mask's long muzzle, turned to the
    // sail.
    let head = s.neck + lean * 0.2
    var hood = length(q - head) - 0.13
    hood = smin(hood, sd_capsule(q, head, head + blow * 0.2 - lean * 0.03, 0.04), 0.06)
    d = smin(d, hood, 0.05)
    min(d, sd_capsule(q, head, head + normalize(mid - head) * 0.19 - up * 0.03, 0.07))
}

/// The skiff's parts at `q` (the skiff's frame): the hull and its thwart, the sail, the spars
/// and the traveller.
fn parts(s: Shot, q: vec3) -> vec4 {
    var wood = hull(q)
    // The mast thwart, the mast stepped through it, and the stern's seat.
    wood = min(wood, sd_box(q - vec3(0.0, -0.08, FOOT.z), vec3(0.5, 0.025, 0.12)))
    wood = min(wood, sd_box(q - vec3(0.0, -0.05, -1.75), vec3(0.32, 0.025, 0.25)))
    // The stem carried up past the bow and curled back over it, as a fern's head.
    let stem = sd_capsule(q, vec3(0.0, 0.4, 2.12), vec3(0.0, 0.82, 2.3), 0.035)
    wood = min(wood, min(stem, sd_capsule(q, vec3(0.0, 0.82, 2.3), vec3(0.0, 0.9, 2.16), 0.03)))
    let (sail, _) = cloth(s, q)
    vec4(wood, sail, spars(s, q), figure(s, q))
}

/// The skiff at `p` (the world's): its distance.
pub fn skiff(s: Shot, p: vec3) -> f32 {
    let k = parts(s, local(s, p))
    min(min(k.x, k.y), min(k.z, k.w))
}

pub fn skiff_normal(s: Shot, p: vec3) -> vec3 {
    let e = 0.004
    let dx = skiff(s, p + vec3(e, 0.0, 0.0)) - skiff(s, p - vec3(e, 0.0, 0.0))
    let dy = skiff(s, p + vec3(0.0, e, 0.0)) - skiff(s, p - vec3(0.0, e, 0.0))
    let dz = skiff(s, p + vec3(0.0, 0.0, e)) - skiff(s, p - vec3(0.0, 0.0, e))
    normalize(vec3(dx, dy, dz))
}

/// What the skiff is made of at `p` (the world's), facing `n`: its albedo, roughness and the
/// ink's line field (the planks' seams).
pub fn skiff_material(s: Shot, p: vec3, n: vec3) -> (vec3, f32, f32) {
    let q = local(s, p)
    // Weathered wood, its grain along the planks; the inside paler where feet and sun have
    // worn it.
    let grain = noise(vec2(q.z * 3.0, q.y * 40.0 + q.x * 6.0))
    let fine = noise(vec2(q.z * 14.0, q.y * 160.0 + q.x * 20.0))
    // Outside, varnished planks of a warm wood, each its own tone; under the gunwale a strake
    // lacquered the sail's madder over a gilt line; below the water's reach, a dark red-brown.
    let plank = floor((q.y * 46.0 + q.z * 1.5) / 6.2831853)
    let tone = hash2(vec2(plank, 3.0))
    var a = mix(vec3(0.36, 0.17, 0.07), vec3(0.55, 0.3, 0.13), tone * 0.6 + grain * 0.4)
    a *= 0.9 + 0.2 * fine
    let outside = 1.0 - smoothstep(0.6, 0.7, dot(n, s.boat_y))
    let zz = clamp(q.z / LONG, -1.0, 1.0)
    let sheer = 0.16 * zz * zz + 0.05 * max(zz, 0.0) + 0.3 * pow(max(zz, 0.0), 4.0)
    let y = q.y - sheer
    let strake = smoothstep(-0.12, -0.105, y) * outside
    let cream = smoothstep(-0.15, -0.14, y) * (1.0 - smoothstep(-0.125, -0.115, y)) * outside
    let bottom = (1.0 - smoothstep(-0.34, -0.32, y)) * outside
    a = mix(a, vec3(0.3, 0.045, 0.03) * (0.85 + 0.3 * grain), strake)
    a = mix(a, vec3(0.75, 0.52, 0.18), cream)
    a = mix(a, vec3(0.2, 0.06, 0.04), bottom * 0.8)
    // Inside, the wood paler and worn, the floorboards darker between the thwarts.
    let inside = smoothstep(0.3, 0.6, dot(n, s.boat_y))
    a = mix(
        a,
        mix(vec3(0.46, 0.33, 0.2), vec3(0.3, 0.2, 0.12), smoothstep(-0.3, -0.36, q.y)),
        inside * 0.7,
    )
    let seam = sin(q.y * 46.0 + q.z * 1.5) + 0.92
    // The varnish holds the light: smoother on the outside, its paint smoother still.
    let rough = mix(0.75, mix(0.42, 0.3, strake), outside)
    let k = parts(s, q)
    // The sail: a heavy cloth, bone-pale and weathered, its panels seamed across, a broad band
    // of the cloak's madder through it and a dark leech tape; lit through when the light's
    // behind it.
    if k.y < 0.006 && k.y <= min(k.z, k.w) {
        let (_, uv) = cloth(s, q)
        let stain = noise(uv * vec2(3.0, 2.0)) * 0.6 + noise(uv * vec2(11.0, 7.0)) * 0.4
        // (Tanned canvas, as a working sail's is: oiled and weathered, darker toward the foot
        // where the spray reaches it.)
        var c = mix(vec3(0.58, 0.5, 0.38), vec3(0.78, 0.7, 0.56), stain)
        c *= 0.8 + 0.2 * smoothstep(0.2, 1.4, uv.y)
        let band_ = smoothstep(2.3, 2.33, uv.y) * (1.0 - smoothstep(2.58, 2.61, uv.y))
        c = mix(c, vec3(0.36, 0.06, 0.04) * (0.8 + 0.35 * stain), band_)
        let x = clamp(uv.x / BOOM, 0.0, 1.0)
        let high = HEAD - (HEAD - LASHED) * pow(x, 1.5)
        let tape = 1.0 - smoothstep(0.035, 0.05, abs(uv.y - high) * (1.0 + 2.0 * x))
        c = mix(c, vec3(0.12, 0.08, 0.06), tape * step(LASHED, uv.y))
        // Three battens across it over the boom, fanning up toward the head, and the luff's
        // sleeve dark along the mast.
        let bat = fract((uv.y - LASHED + 0.15 * uv.x) / 0.85)
        let batten = (1.0 - smoothstep(0.012, 0.03, abs(bat - 0.5) * 0.85)) *
            step(LASHED + 0.2, uv.y) *
            step(uv.y, HEAD - 0.5)
        c = mix(c, vec3(0.1, 0.07, 0.05), batten * 0.85)
        c = mix(c, vec3(0.1, 0.07, 0.05), 1.0 - smoothstep(0.05, 0.08, uv.x))
        let seam = sin(uv.y * 5.2 - uv.x * 0.6) + 0.96
        return (c, 0.82, seam)
    }
    // The spars: tarred, dark and smooth.
    if k.z < 0.006 && k.z <= k.w {
        return (vec3(0.06, 0.045, 0.035), 0.45, 1.0)
    }
    // The traveller's cloak: a madder red, deeper in its folds, the folds falling in long runs
    // from the shoulders; an ochre band round its hem; legs in dark wrappings.
    if k.w < 0.006 {
        let lean = normalize(s.neck - s.hips)
        let h = dot(q - s.hips, lean)
        let fold = noise(vec2((q.x + q.z) * 9.0, h * 1.8)) * 0.8 +
            noise(vec2(q.x * 20.0, h * 4.0)) * 0.2
        var cloak = mix(vec3(0.32, 0.05, 0.04), vec3(0.62, 0.1, 0.06), fold)
        let hem = smoothstep(-0.22, -0.2, h) * (1.0 - smoothstep(-0.16, -0.14, h))
        cloak = mix(cloak, vec3(0.62, 0.42, 0.14) * (0.85 + 0.3 * fold), hem)
        let legs = 1.0 - smoothstep(-0.27, -0.23, h)
        cloak = mix(cloak, vec3(0.05, 0.045, 0.045), legs)
        // (The mask: white lacquer, a red flame drawn up from each eye.)
        let head = s.neck + lean * 0.2
        let fore = dot(q - head, normalize((s.fore_hand + s.aft_hand) * 0.5 - head))
        if length(q - head) < 0.26 && length(q - head) > 0.11 && fore > 0.05 {
            let fire = smoothstep(0.6, 0.75, noise(vec2(q.y * 40.0, (q.x + q.z) * 25.0)))
            return (mix(vec3(0.85, 0.83, 0.78), vec3(0.6, 0.06, 0.04), fire), 0.3, 1.0)
        }
        return (cloak, 0.85, sin(h * 9.0 + q.x * 3.0) + 0.92)
    }
    (a, rough, seam)
}
