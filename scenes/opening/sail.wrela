// Sailing the skiff: the keys the player sails it by, and how the boat answers them on the sea's
// wind (`sea::SEA`). It's a small sail skiff with a free rig, as a windsurfer's is: a mast on a
// swivel, a wishbone boom the traveller holds standing, leaning out against the sail's pull.
// Sheeted in, it gathers way, slowly at first, then lifts onto the plane and runs; it's quickest
// with the wind on its quarter, slow straight downwind, and stalls heading into it. It surfs down
// the swell's faces, heels to a gust, banks into its turns, and its sail keeps to its own
// side (it never swings right across). The camera rides behind it, falling back as it surges and widening as it runs. Not a
// simulator: what it should feel like, not what it would cost to learn. What a frame draws is
// the rig as it stood at the last drawing (`HELD` a second).

use std::input::{Event, Key, PadAxis, PadButton}
use sea::{HELD, SEA, bob}
use wind::air_at
use stacks::stacks
use engine::ocean::Swell

/// The skiff under the player's hands.
pub struct Rig: Copy {
    /// Where it is (x, z, m) and how far it's been steered from its first heading (rad).
    pub at: vec2,
    pub steer: f32,
    /// Its way through the water (m/s, forward positive) and its turning (rad/s).
    pub speed: f32,
    pub turn: f32,
    /// How hard the sail is sheeted in, 0 (let fly, the sail flagging in the wind) to 1 (sheeted
    /// hard, the traveller leaning right out): what the keys ask for, and that eased.
    pub trim: f32,
    pub power: f32,
    /// The boom's angle off the centreline aft (rad, positive to starboard): where the wind and
    /// the sheet hold it, on its own side (`tack`).
    pub boom: f32,
    /// The side the sail sits (1 starboard, -1 port). It keeps it: the sail never swings
    /// across the boat.
    pub tack: f32,
    /// How far it heels (rad, positive starboard side down), and how fast.
    pub heel: f32,
    heel_rate: f32,
    /// How far onto the plane it is, 0 (pushing its bow wave) to 1 (skimming).
    pub plane: f32,
    /// The wind's strength where it is, its gusts and lulls included (1 the storm's mean).
    pub gust: f32,
    /// How far the local wind's veered from the storm's mean (rad), its region and gusts included.
    pub veer: f32,
    /// The speed as the camera's caught up with it (m/s): how far it's fallen back.
    pub rush: f32,
    /// A knock just felt (1, fading to 0 in under half a second): the boom slammed across.
    pub jolt: f32,
    /// How far the camera has swung (rad), following the steer; and which side of the wake it
    /// rides, -1 port to 1 starboard (to windward, crossing over after a gybe).
    pub look: f32,
    pub perch: f32,
    /// Where the camera stands, 0 for the opening's shot (low behind the skiff, the rock filling
    /// the sky) to 1 for the player's (up behind it, the skiff and the sea ahead); between, on
    /// its way from one to the other (`look::shot_at`).
    pub framing: f32,
    /// Each key and pad kept independently: releasing one alias or centring a stick never
    /// releases another control still held.
    keyboard: u32,
    pad_buttons: [u32; 4],
    pad_sticks: [vec2; 4],
    forward: bool,
    back: bool,
    left: bool,
    right: bool,
    /// The time it was last stepped to, and the drawing it last held.
    time: f32,
    drawing: f32,
    /// The rig as the last drawing holds it: what a frame draws.
    pub shown_at: vec2,
    pub shown_steer: f32,
    pub shown_speed: f32,
    pub shown_turn: f32,
    pub shown_power: f32,
    pub shown_boom: f32,
    pub shown_heel: f32,
    pub shown_plane: f32,
    pub shown_rush: f32,
    pub shown_look: f32,
    pub shown_perch: f32,
    /// The sail's cloth and the traveller's body as they move (`Motion`), and as the last drawing
    /// holds them.
    pub m: Motion,
    pub shown_m: Motion,
}

/// What moves on the skiff besides the hull: the sail's cloth, the old mast's whip, and the
/// traveller's body, each as a spring that lags, overshoots and settles, so nothing snaps to
/// where it's going.
pub struct Motion: Copy {
    /// The cloth as a membrane, in a few of its shapes (`skiff::cloth`): how deep its belly is
    /// (m, signed: toward `cross(mast, boom)`, so it passes through flat as the wind crosses it
    /// and pops full on its other face), how far its leech twists off to leeward, the bubble its
    /// luff backs into as the wind comes on along it, how hard it flogs (0 to 1), and its leech's
    /// flutter; and each one's rate.
    pub fill: f32,
    pub fill_v: f32,
    pub twist: f32,
    pub twist_v: f32,
    pub bubble: f32,
    pub bubble_v: f32,
    pub flog: f32,
    pub flutter: f32,
    pub flutter_v: f32,
    /// The old mast's whip: how far its head's swung off (across, along; rad), and how fast.
    pub whip: vec2,
    pub whip_v: vec2,
    /// The skiff's heave under the traveller (m) and its rate (m/s).
    pub heave: f32,
    pub heave_v: f32,
    /// How far the traveller's knees have given (m), and how fast.
    pub sink: f32,
    pub sink_v: f32,
    /// Its hips and neck as they've caught up with where the sail's pull wants them, and how fast
    /// they're going there.
    pub hips: vec3,
    pub hips_v: vec3,
    pub neck: vec3,
    pub neck_v: vec3,
    /// Its feet, planted till they're left too far from where they'd stand, then stepped there:
    /// each one's place, where its step began and how far through it it is (1 planted).
    pub fore_foot: vec3,
    pub aft_foot: vec3,
    pub fore_from: vec3,
    pub aft_from: vec3,
    pub fore_step: f32,
    pub aft_step: f32,
    /// Where it's glancing off ahead (rad: round, up), and how fast its head's turning.
    pub look: vec2,
    pub look_v: vec2,
    /// Whether it's been placed yet (0 until the first step).
    pub placed: f32,
}

fn still() -> Motion {
    Motion {
        fill: 0.0,
        fill_v: 0.0,
        twist: 0.0,
        twist_v: 0.0,
        bubble: 0.0,
        bubble_v: 0.0,
        flog: 1.0,
        flutter: 0.0,
        flutter_v: 0.0,
        whip: vec2(0.0),
        whip_v: vec2(0.0),
        heave: 0.0,
        heave_v: 0.0,
        sink: 0.0,
        sink_v: 0.0,
        hips: vec3(0.0),
        hips_v: vec3(0.0),
        neck: vec3(0.0),
        neck_v: vec3(0.0),
        fore_foot: vec3(0.0),
        aft_foot: vec3(0.0),
        fore_from: vec3(0.0),
        aft_from: vec3(0.0),
        fore_step: 1.0,
        aft_step: 1.0,
        look: vec2(0.0),
        look_v: vec2(0.0),
        placed: 0.0,
    }
}

/// `x` (going at `v`) pulled toward `to` by a spring of angular frequency `w` (rad/s) and damping
/// ratio `z`, over `dt`: where it gets to, and how fast.
fn spring(x: f32, v: f32, to: f32, w: f32, z: f32, dt: f32) -> (f32, f32) {
    let v1 = v + (w * w * (to - x) - 2.0 * z * w * v) * dt
    (x + v1 * dt, v1)
}

fn spring3(x: vec3, v: vec3, to: vec3, w: f32, z: f32, dt: f32) -> (vec3, vec3) {
    let v1 = v + ((to - x) * (w * w) - v * (2.0 * z * w)) * dt
    (x + v1 * dt, v1)
}

/// A smooth wander in about [-1, 1] at time `t`, never repeating soon: for what's forced by the
/// chop and the wind's turbulence.
fn wander(t: f32, seed: f32) -> f32 {
    (sin(t * 1.93 + seed) + sin(t * 3.17 + seed * 2.3) * 0.6 + sin(t * 5.71 + seed * 4.1) * 0.35) / 1.95
}

fn hashed(x: f32) -> f32 {
    fract(sin(x * 127.1 + 311.7) * 43758.5453)
}

/// The skiff at rest, as the opening finds it: its sail let fly, flagging downwind.
pub fn rest() -> Rig {
    Rig {
        at: vec2(0.0),
        steer: 0.0,
        speed: 0.0,
        turn: 0.0,
        trim: 0.0,
        power: 0.0,
        boom: flagged(0.0, 0.0),
        tack: if flagged(0.0, 0.0) >= 0.0 { 1.0 } else { -1.0 },
        heel: 0.0,
        heel_rate: 0.0,
        plane: 0.0,
        gust: 1.0,
        veer: 0.0,
        rush: 0.0,
        jolt: 0.0,
        look: 0.0,
        perch: 1.0,
        framing: 0.0,
        keyboard: 0,
        pad_buttons: [0; 4],
        pad_sticks: [vec2(0.0); 4],
        forward: false,
        back: false,
        left: false,
        right: false,
        time: -1.0,
        drawing: -1.0,
        shown_at: vec2(0.0),
        shown_steer: 0.0,
        shown_speed: 0.0,
        shown_turn: 0.0,
        shown_power: 0.0,
        shown_boom: flagged(0.0, 0.0),
        shown_heel: 0.0,
        shown_plane: 0.0,
        shown_rush: 0.0,
        shown_look: 0.0,
        shown_perch: 1.0,
        m: still(),
        shown_m: still(),
    }
}

/// The rig after input event `e`: W or Up sheets in (held, harder), S or Down lets the sail fly,
/// A and D (or Left and Right) steer; on a pad, the left stick or the D-pad the same way.
pub fn key(r: mut Rig, e: Event) {
    match e {
        Event::KeyDown { key, .. } => hold(mut r, key, down: true),
        Event::KeyUp { key, .. } => hold(mut r, key, down: false),
        Event::PadButton { pad, button, pressed, .. } => {
            if pad < 4 {
                let bit = match button {
                    PadButton::Up => 1,
                    PadButton::Down => 4,
                    PadButton::Left => 16,
                    PadButton::Right => 64,
                    _ => 0,
                }
                if pressed { r.pad_buttons[pad] |= bit } else { r.pad_buttons[pad] &= !bit }
            }
        },
        // (The stick past a third of its throw holds the way it leans; back in the middle, lets
        // that stick go. Up is negative.)
        Event::PadAxis { pad, axis: PadAxis::LeftY, value } => {
            if pad < 4 { r.pad_sticks[pad].y = value }
        },
        Event::PadAxis { pad, axis: PadAxis::LeftX, value } => {
            if pad < 4 { r.pad_sticks[pad].x = value }
        },
        _ => {},
    }
    held_keys(mut r)
}

/// How far the stick leans before it holds a way.
const STICK: f32 = 0.35

/// Every key let go: the hands keep the sail as it's trimmed.
pub fn let_go(r: mut Rig) {
    r.keyboard = 0
    r.pad_buttons = [0; 4]
    r.pad_sticks = [vec2(0.0); 4]
    held_keys(mut r)
}

fn hold(r: mut Rig, key: Key, down: bool) {
    let bit = match key {
        Key::W => 1,
        Key::Up => 2,
        Key::S => 4,
        Key::Down => 8,
        Key::A => 16,
        Key::Left => 32,
        Key::D => 64,
        Key::Right => 128,
        _ => 0,
    }
    if down { r.keyboard |= bit } else { r.keyboard &= !bit }
    held_keys(mut r)
}

/// Which ways are held by at least one key, D-pad or stick.
fn held_keys(r: mut Rig) {
    r.forward = (r.keyboard & 3) != 0
    r.back = (r.keyboard & 12) != 0
    r.left = (r.keyboard & 48) != 0
    r.right = (r.keyboard & 192) != 0
    for pad in 0..4 {
        let buttons = r.pad_buttons[pad]
        let stick = r.pad_sticks[pad]
        r.forward = r.forward || (buttons & 1) != 0 || stick.y < -STICK
        r.back = r.back || (buttons & 4) != 0 || stick.y > STICK
        r.left = r.left || (buttons & 16) != 0 || stick.x < -STICK
        r.right = r.right || (buttons & 64) != 0 || stick.x > STICK
    }
}

/// Its best speed through the water, with the wind on its quarter and the sail sheeted hard
/// (m/s), before the gusts; the trim it keeps sailing at once W is let go; and how fast it turns
/// under way (rad/s).
const RUN: f32 = 10.5
const CRUISE: f32 = 0.6
const TURN_RATE: f32 = 0.62

/// The wind's heading (where it blows to) in the skiff's frame at heading `yaw`: (across, along).
fn wind_in(yaw: f32) -> vec2 {
    let w = SEA.wind
    vec2(w.x * cos(yaw) - w.y * sin(yaw), w.x * sin(yaw) + w.y * cos(yaw))
}

/// Where the wind comes from, off the bow (rad, -π to π, positive from starboard), at heading
/// `yaw`.
pub fn wind_off(yaw: f32) -> f32 {
    let w = wind_in(yaw)
    atan2(-w.x, -w.y)
}

/// The boom let fly at heading `steer`: streaming with the wind, as a flag does.
fn flagged(steer: f32, veer: f32) -> f32 {
    let b = wind_off(-0.22 + steer + veer)
    -b
}

/// How fast it sails (of `RUN`) with the wind `off` the bow (rad): nothing heading into it, more
/// as it bears away, best on a broad reach, a little less straight downwind.
fn polar(off: f32) -> f32 {
    let a = abs(off)
    smoothstep(0.55, 1.25, a) * (0.72 + 0.3 * exp(-(a - 2.05) * (a - 2.05) / 0.45))
}

/// The rig stepped on to `time` (s), on the sea's long waves (`swell`).
pub fn step(r: mut Rig, time: f32, swell: Swell) {
    if r.time < 0.0 {
        r.time = time
    }
    let dt = clamp(time - r.time, 0.0, 0.1)
    r.time = time
    // The sheet: W draws it in (held, harder), let go it eases to a cruising trim, S lets it fly.
    if r.forward {
        r.trim = min(r.trim + dt * 1.6, 1.0)
    } else if r.back {
        r.trim = max(r.trim - dt * 1.4, 0.0)
    } else if r.trim > CRUISE {
        r.trim = max(r.trim - dt * 0.35, CRUISE)
    }
    r.power += (r.trim - r.power) * (1.0 - exp(-dt * (if r.trim < r.power { 5.0 } else { 3.0 })))
    // The wind where it is: gusts and lulls a few tens of metres across, blowing down on it.
    let air = air_at(r.at, time)
    r.gust = air.speed / SEA.speed
    // Both the regional mean and its gusts turn and fill the sail. Keeping only the gust's
    // offset made it sail by the gale even inside a region with a different wind.
    r.veer = atan2(SEA.wind.x * air.way.y - SEA.wind.y * air.way.x, dot(SEA.wind, air.way))
    let yaw = -0.22 + r.steer
    let off = wind_off(yaw + r.veer)
    let heading = vec2(sin(yaw), cos(yaw))
    // Its way: toward what the wind and the sheet give it; slow to gather from rest, then a
    // surge as it lifts onto the plane and the water lets go of it; braked when the sail's let
    // fly. Down a swell's face it surfs, up the back it slows.
    let want = RUN * polar(off) * r.power * r.gust
    let rate = if want > r.speed { mix(0.3, 0.9, r.plane) } else { mix(0.3, 1.2, 1.0 - r.power) }
    r.speed += (want - r.speed) * rate * dt
    let bow = swell.height(r.at + heading * 1.6, time)
    let stern = swell.height(r.at - heading * 1.6, time)
    r.speed -= 9.81 * (bow - stern) / 3.2 * 0.5 * dt
    // (A hard turn bleeds its way.)
    r.speed -= abs(r.turn) * max(r.speed, 0.0) * 0.18 * dt
    r.speed = max(r.speed, -0.5)
    let planing = smoothstep(3.6, 6.0, r.speed)
    r.plane += (planing - r.plane) * (1.0 - exp(-dt * (if planing > r.plane { 1.6 } else { 3.0 })))
    // Steering: a little even at rest (the rig swung to turn it), more as it carves under way.
    let wheel = (if r.right { 1.0 } else { 0.0 }) - (if r.left { 1.0 } else { 0.0 })
    let grip = 0.4 + 0.6 * smoothstep(0.0, 5.0, r.speed)
    r.turn += (wheel * TURN_RATE * grip - r.turn) * (1.0 - exp(-dt * 2.6))
    r.steer += r.turn * dt
    r.at += heading * r.speed * dt
    // (Never into a rock: held off a sea stack's foot, its way lost against it. Steered or
    // put back where one stands, it ran into the stone and the camera with it.)
    let foot = vec3(r.at.x, 0.5, r.at.y)
    let clear = stacks(foot, 0.2) - 4.0
    if clear < 0.0 {
        let e = 0.5
        let g = vec2(
            stacks(foot + vec3(x: e), 0.2) - stacks(foot - vec3(x: e), 0.2),
            stacks(foot + vec3(z: e), 0.2) - stacks(foot - vec3(z: e), 0.2),
        )
        r.at -= g / max(length(g), 1.0e-4) * clear
        r.speed *= exp(-dt * 3.0)
    }
    // The boom: on its own side always. Sheeted, held at the angle the wind wants; let fly, it
    // streams out with the wind as far as its side lets it. With the wind round on the other
    // side (by the lee), it stays where it is, full, rather than swinging right across: a slam
    // over the skiff reads as a glitch, not a gybe.
    let side = r.tack
    let trimmed = side * clamp((abs(off) - 0.45) * 0.62, 0.12, 1.42)
    let free = side * clamp(-off * side, 0.15, 1.5)
    let k = smoothstep(0.0, 0.55, r.power)
    let target = mix(free, trimmed, k)
    r.boom += (target - r.boom) * (1.0 - exp(-dt * (1.6 + 1.2 * k)))
    r.jolt = max(r.jolt - dt * 2.5, 0.0)
    // Heeling: the sail's pull to leeward (more in a gust, less once it planes, the traveller's
    // weight out to windward taking most of it), and banked into its turns, carving. On a
    // spring, so a gust or a gybe sets it rocking.
    let pull = r.power * sin(abs(off)) * polar(off) * r.gust
    let lean = side * (0.3 * pull + 0.1 * r.power * r.gust) * (1.0 - 0.3 * r.plane) +
        r.turn * clamp(r.speed, 0.0, 9.0) * 0.12
    r.heel_rate += ((lean - r.heel) * 22.0 - r.heel_rate * 5.0) * dt
    r.heel += r.heel_rate * dt
    // The camera: swung round after the bow, lagging it; falling back as it surges and catching
    // up as it settles.
    r.look += (r.steer - r.look) * (1.0 - exp(-dt * 0.9))
    r.rush += (r.speed - r.rush) * (1.0 - exp(-dt * 0.9))
    let windward = if r.boom > 0.0 { -1.0 } else { 1.0 }
    r.perch += (windward - r.perch) * (1.0 - exp(-dt * 0.35))
    moved(mut r, time, dt, swell, off)
    // What the drawing holds, renewed as each drawing comes.
    let drawing = floor(time * HELD)
    if drawing != r.drawing {
        r.shown_m = r.m
        r.drawing = drawing
        r.shown_at = r.at
        r.shown_steer = r.steer
        r.shown_speed = r.speed
        r.shown_turn = r.turn
        r.shown_power = r.power
        r.shown_boom = r.boom
        r.shown_heel = r.heel
        r.shown_plane = r.plane
        r.shown_rush = r.rush
        r.shown_look = r.look
        r.shown_perch = r.perch
    }
}

/// The rig and the traveller as a drawing holds them, in the skiff's frame (across, up, along):
/// the mast's heading up from its foot, the boom's aft from where it's lashed to it, the sail's
/// belly (the way it's blown out), and the traveller's hips, neck, hands and feet.
pub struct Pose: Copy {
    pub mast: vec3,
    pub boom: vec3,
    pub belly: vec3,
    pub hips: vec3,
    pub neck: vec3,
    pub fore_hand: vec3,
    pub aft_hand: vec3,
    pub fore_foot: vec3,
    pub aft_foot: vec3,
    /// Where the rider looks: ahead over the bow, past the sail's luff.
    pub gaze: vec3,
    /// The cloth's shapes (`Motion`): its belly, its leech's twist, its luff's bubble, its
    /// flogging; and its leech's flutter.
    pub cloth: vec4,
    pub quiver: vec4,
}

/// Where the mast stands (the skiff's frame), how far up it the boom is lashed, and the boom's
/// length to the clew (m).
pub const FOOT = vec3(0.0, 0.02, 0.95)
pub const LASHED: f32 = 1.5
pub const BOOM: f32 = 2.15

/// How far either arm of the wishbone bows out from the sail, at its middle (m).
pub const BOW_OUT: f32 = 0.22

/// The rig as `r`'s drawing holds it: its spars and the hands where the sail's pull has them,
/// the body as it's caught up with them, its knees giving to the heave, its head glancing round.
pub fn pose(r: Rig) -> Pose {
    let yaw = -0.22 + r.shown_steer
    let m = r.shown_m
    let g = rigged(wind_off(yaw + r.veer), r.shown_turn, r.shown_power, r.shown_boom, r.jolt)
    // (The old mast whips as the hull's knocked about: its head swung, the sail and the boom on
    // it carried round.)
    let mast = normalize(g.mast + vec3(m.whip.x, 0.0, m.whip.y))
    let lift = mast - g.mast
    let up_m = vec3(y: 1.0)
    let boom_ = normalize(g.boom + lift * 0.5)
    let shift = lift * LASHED
    let placed = m.placed > 0.5
    var hips = if placed { m.hips } else { g.hips }
    var neck = if placed { m.neck } else { g.neck }
    hips -= up_m * m.sink
    neck -= up_m * (m.sink * 0.85)
    let fore_foot = if placed { m.fore_foot } else { g.fore_foot }
    let aft_foot = if placed { m.aft_foot } else { g.aft_foot }
    let ga = g.gaze
    let cy = cos(m.look.x)
    let sy = sin(m.look.x)
    let gaze = normalize(vec3(ga.x * cy + ga.z * sy, ga.y + m.look.y, ga.z * cy - ga.x * sy))
    Pose {
        mast,
        boom: boom_,
        belly: g.belly,
        hips,
        neck,
        fore_hand: g.fore_hand + shift,
        aft_hand: g.aft_hand + shift,
        fore_foot,
        aft_foot,
        gaze,
        cloth: vec4(m.fill, m.twist, m.bubble, m.flog),
        quiver: vec4(m.flutter, 0.0, 0.0, 0.0),
    }
}

/// The rig with the wind `off` the bow, turning at `turn`, sheeted to `p`, its boom at `phi`,
/// just knocked `jolt`: where its spars stand, where the hands hold them and where the body
/// would hang from them, still.
fn rigged(off: f32, turn: f32, p: f32, phi: f32, jolt: f32) -> Pose {
    let side = if phi >= 0.0 { 1.0 } else { -1.0 }
    // (To windward, easing over through upright as the boom crosses the centreline: a sign
    // flipped there threw the mast 35 degrees over in a frame.)
    let wind = -clamp(phi / 0.5, -1.0, 1.0)
    let a = min(abs(phi), 3.0)
    // The mast leans to windward as the traveller hangs on it, the more as the sail's squared
    // off (so the sail's over the boat, not out over the sea); and raked forward to bear away,
    // aft to head up.
    // (Eased to nothing as the wind comes dead ahead or astern: a sign flipped there raked the
    // mast over in a frame as the wind crossed the stern.)
    let up_into = turn * clamp(sin(off) / 0.3, -1.0, 1.0)
    let rake = clamp(-up_into / TURN_RATE, -1.0, 1.0) * 0.16 + 0.05
    let tilt = (0.1 + 0.32 * smoothstep(0.6, 1.5, a)) * smoothstep(0.1, 0.6, p)
    let mast = normalize(vec3(wind * sin(tilt), cos(tilt) * cos(rake), sin(rake)))
    let b0 = vec3(side * sin(a), 0.0, -cos(a))
    let boom = normalize(b0 - mast * dot(b0, mast))
    // (Its belly out on the boom's side, away from the traveller, whichever side the wind's on:
    // turned by the wind, it flipped him and the sail round in a frame as the wind crossed.)
    let belly = -side * normalize(cross(mast, boom))
    // The hands on the wishbone's windward arm, the fore one near the mast; let fly, the fore
    // hand on the mast itself and the aft one on the boom near it, the rig held upright.
    let lash = FOOT + mast * LASHED
    let arm = BOW_OUT * 0.95
    let held = smoothstep(0.08, 0.5, p)
    let fore_sail = lash + boom * 0.4 - belly * arm * 0.6
    let aft_sail = lash + boom * 1.0 - belly * arm
    let fore_free = FOOT + mast * 1.3 - belly * 0.06
    let aft_free = lash + boom * 0.35 - belly * arm * 0.5
    let fore_hand = mix(fore_free, fore_sail, held)
    let aft_hand = mix(aft_free, aft_sail, held)
    // The traveller hangs back from the hands, out to windward, arms near straight: the harder
    // the sail's sheeted, the further.
    let mid = (fore_hand + aft_hand) * 0.5
    let away = normalize(vec3(-belly.x, 0.0, -belly.z) + vec3(0.0, 0.0, -0.35))
    let reach = 0.3 + 0.1 * p
    // (Ducked under the boom as it slams across in a gybe.)
    var neck = mid + away * reach + vec3(0.0, 0.08 - 0.22 * p - 0.4 * jolt, 0.0)
    neck.x = clamp(neck.x, -1.1, 1.1)
    neck.z = clamp(neck.z, -1.3, 0.55)
    var hips = neck + vec3(0.0, -0.56, 0.0) - away * (0.08 + 0.08 * p)
    hips.y = min(hips.y, FOOT.y + 0.82 - 0.12 * p)
    // (And the whole of him tipped out over his feet, from the ankles, across the boat over
    // the windward rail: shoulders furthest, hips between, knees a little bent. Eased through
    // the centreline, so it never flips in a frame.)
    let tip = 0.3 + 0.2 * p
    let out = vec3(clamp(away.x * 3.0, -1.0, 1.0), 0.0, 0.0)
    neck += out * tip
    hips += out * (tip * 0.8) + vec3(0.0, -0.05, 0.0)
    let ahead = normalize(vec3(-away.z, 0.0, away.x))
    let fwd = if ahead.z > 0.0 { ahead } else { -ahead }
    let stance = vec3(clamp(hips.x - out.x * 0.42, -0.4, 0.4), FOOT.y, hips.z)
    let fore_foot = stance + fwd * 0.3
    let aft_foot = stance - fwd * 0.28
    // (Looking ahead over the bow, a little across past the luff and into a turn.)
    let gaze = normalize(vec3(0.0, 0.04, 1.0) + vec3(belly.x, 0.0, belly.z) * 0.35 + vec3(turn * 0.8, 0.0, 0.0))
    Pose {
        mast,
        boom,
        belly,
        hips,
        neck,
        fore_hand,
        aft_hand,
        fore_foot,
        aft_foot,
        gaze,
        cloth: vec4(0.0),
        quiver: vec4(0.0),
    }
}

/// How long a step takes (s), and how far a foot's left from where it'd stand before it steps
/// (m).
const STRIDE: f32 = 0.3
const REACH: f32 = 0.2

/// What moves on the skiff, stepped on by `dt` to `time`, the wind `off` the bow.
fn moved(r: mut Rig, time: f32, dt: f32, swell: Swell, off: f32) {
    let yaw = -0.22 + r.steer
    let g = rigged(off, r.turn, r.power, r.boom, r.jolt)
    var m = r.m
    // The heave under it, and how hard it's changing: the knees take it.
    let (b, _, _, _) = bob(time, r.at, r.steer, swell)
    if m.placed < 0.5 {
        m.heave = b.y
        m.hips = g.hips
        m.neck = g.neck
        m.fore_foot = g.fore_foot
        m.aft_foot = g.aft_foot
        m.placed = 1.0
    }
    var lift = 0.0
    if dt > 1.0e-4 {
        let v = (b.y - m.heave) / dt
        lift = clamp((v - m.heave_v) / dt, -6.0, 6.0)
        m.heave = b.y
        m.heave_v = v
    }
    let run = smoothstep(3.0, 9.0, r.speed)
    // The air over the sail as it meets it, in the skiff's frame (across, along): the wind less
    // the skiff's own way. Its angle to the sail's chord (the boom's line aft) sets the cloth's
    // load: full on one face or the other, luffing as it comes on along it, flogging when the
    // sail's let stream with it.
    let w = wind_in(yaw + r.veer) * (SEA.speed * r.gust) - vec2(0.0, r.speed)
    let va = max(length(w), 0.1)
    let f = w / va
    let chord = vec2(sin(r.boom), -cos(r.boom))
    let face = vec2(chord.y, -chord.x)
    let s_al = dot(f, face)
    let c_al = dot(f, chord)
    let q = clamp(va * va / (SEA.speed * SEA.speed), 0.4, 1.6)
    // (Always bellied out on its lee face, away from the traveller: never blown back through.)
    let sheet_side = if r.boom >= 0.0 { 1.0 } else { -1.0 }
    let load = -sheet_side * clamp(abs(s_al) / 0.3, 0.0, 1.0)
    let fill_to = load * (0.12 + 0.26 * sqrt(q))
    let luff = 1.0 - smoothstep(0.06, 0.24, abs(s_al))
    let flog_to = (1.0 - smoothstep(0.05, 0.2, abs(s_al))) * (if c_al > -0.2 { 1.0 } else { 0.6 })
    let twist_to = (0.06 * max(r.gust - 0.9, 0.0) * 2.0 + 0.04 * abs(load)) * sqrt(q)
    let bubble_to = 0.11 * luff * smoothstep(-0.1, 0.4, c_al) * (1.0 - 0.6 * m.flog)
    // (Stepped in short substeps: the leech's flutter is quick.)
    let n = 4
    let h = dt / f32(n)
    for i in 0..n {
        let ti = time - dt + h * f32(i + 1)
        let (a1, v1) = spring(m.fill, m.fill_v, fill_to, 6.5, 0.3, h)
        m.fill = a1
        m.fill_v = v1
        let (a2, v2) = spring(m.twist, m.twist_v, twist_to + 0.05 * wander(ti * 0.8, 3.0) * r.gust, 5.0, 0.55, h)
        m.twist = a2
        m.twist_v = v2
        let (a3, v3) = spring(m.bubble, m.bubble_v, bubble_to * (0.8 + 0.3 * wander(ti * 1.7, 9.0)), 9.0, 0.4, h)
        m.bubble = a3
        m.bubble_v = v3
        // (The leech flutters, more the faster the air and the looser the cloth.)
        let shake = wander(ti * 4.3, 1.0) * (0.004 + 0.02 * m.flog + 0.006 * run) * q * 290.0
        let (a4, v4) = spring(m.flutter, m.flutter_v + shake * h, 0.0, 17.0, 0.08, h)
        m.flutter = a4
        m.flutter_v = v4
        // (The old mast whips: knocked by the heave and a slammed boom, rung by the belly's pop.)
        let kick = vec2(r.jolt * 1.5 * (if r.boom > 0.0 { 1.0 } else { -1.0 }), -lift * 0.03 - m.fill_v * 0.1)
        let wx = m.whip_v.x + (kick.x - 100.0 * m.whip.x - 2.0 * 0.12 * 10.0 * m.whip_v.x) * h
        let wz = m.whip_v.y + (kick.y - 100.0 * m.whip.y - 2.0 * 0.12 * 10.0 * m.whip_v.y) * h
        m.whip_v = vec2(wx, wz)
        m.whip += m.whip_v * h
    }
    let rate = if flog_to > m.flog { 2.6 } else { 1.6 }
    m.flog += (flog_to - m.flog) * (1.0 - exp(-dt * rate))
    m.whip = clamp(m.whip, vec2(-0.025), vec2(0.025))
    // The traveller. Its knees give as the hull's lifted and spring back as it drops, deeper at
    // a run and the harder it hangs on the sail; the chop working at them under way.
    let sink_to = 0.02 + 0.03 * r.power + 0.03 * run + 0.03 * lift + 0.03 * run * wander(time * 1.6, 5.0)
    let (sk, skv) = spring(m.sink, m.sink_v, clamp(sink_to, 0.0, 0.3), 8.5, 0.5, dt)
    m.sink = sk
    m.sink_v = skv
    // It hangs further out as a gust comes on and the skiff heels, its weight thrown aft as the
    // skiff surges and forward as it's brought up; the body lags where the sail's pull wants
    // it, and swings past a little.
    let away = normalize(vec3(g.neck.x - g.fore_hand.x, 0.0, g.neck.z - g.fore_hand.z) + vec3(0.0001))
    let hang = 0.1 * clamp(r.gust - 1.0, -0.3, 0.6) * r.power + 0.15 * abs(r.heel) * r.power
    let surge = clamp((r.speed - r.rush) * 0.04, -0.12, 0.12)
    // (Its upper body sways against the hull's roll, keeping its head over its feet, and
    // rocks with the chop.)
    let sway = vec3(-r.heel * 0.55 + 0.04 * run * wander(time * 0.9, 11.0), 0.0, 0.03 * wander(time * 0.7, 13.0))
    let to_neck = g.neck + away * hang + vec3(0.0, 0.0, -surge) + sway
    let to_hips = g.hips + away * (hang * 0.5) + vec3(0.0, 0.0, -surge * 0.6)
    let (nk, nkv) = spring3(m.neck, m.neck_v, to_neck, 4.2, 0.55, dt)
    m.neck = nk
    m.neck_v = nkv
    let (hp, hpv) = spring3(m.hips, m.hips_v, to_hips, 3.6, 0.65, dt)
    m.hips = hp
    m.hips_v = hpv
    // Its feet: planted, each stepped when it's left too far from where it'd stand, one at a
    // time, lifted through the step.
    if m.fore_step >= 1.0 && m.aft_step >= 1.0 {
        let df = length(m.fore_foot - g.fore_foot)
        let da = length(m.aft_foot - g.aft_foot)
        if df > REACH && df >= da {
            m.fore_from = m.fore_foot
            m.fore_step = 0.0
        } else if da > REACH {
            m.aft_from = m.aft_foot
            m.aft_step = 0.0
        }
    }
    if m.fore_step < 1.0 {
        m.fore_step = min(m.fore_step + dt / STRIDE, 1.0)
        let e = smoothstep(0.0, 1.0, m.fore_step)
        m.fore_foot = mix(m.fore_from, g.fore_foot, e) + vec3(0.0, 0.1 * sin(3.1415927 * m.fore_step), 0.0)
    }
    if m.aft_step < 1.0 {
        m.aft_step = min(m.aft_step + dt / STRIDE, 1.0)
        let e = smoothstep(0.0, 1.0, m.aft_step)
        m.aft_foot = mix(m.aft_from, g.aft_foot, e) + vec3(0.0, 0.1 * sin(3.1415927 * m.aft_step), 0.0)
    }
    // Its head glances round every few seconds: mostly ahead, up at the sail's luff, across at
    // the rock, back over its shoulder at the sea coming up; up at the sail when it's just
    // sheeted or knocked.
    let beat = time / 3.4
    let k = floor(beat)
    let pick = hashed(k)
    let rock = vec2(-1890.0, 7560.0) - r.at
    let rock_off = atan2(rock.x, rock.y) - yaw
    let rock_yaw = atan2(sin(rock_off), cos(rock_off))
    let sail_side = if r.boom > 0.0 { 1.0 } else { -1.0 }
    var glance = vec2(0.0)
    if pick > 0.85 {
        glance = vec2(clamp(rock_yaw, -1.4, 1.4) * 0.8, 0.2)
    } else if pick > 0.7 {
        glance = vec2(-sail_side * 1.3, -0.08)
    } else if pick > 0.52 {
        glance = vec2(sail_side * 0.45, 0.45)
    } else {
        glance = vec2(0.12 * wander(time * 0.4, 2.0), 0.03 * wander(time * 0.5, 7.0))
    }
    // (Held a while, then back ahead before the next.)
    if fract(beat) > 0.7 {
        glance = vec2(0.0)
    }
    if r.jolt > 0.2 || abs(r.trim - r.power) > 0.25 {
        glance = vec2(sail_side * 0.4, 0.4)
    }
    let (lk, lkv) = spring3(vec3(m.look, 0.0), vec3(m.look_v, 0.0), vec3(glance, 0.0), 4.0, 0.9, dt)
    m.look = lk.xy
    m.look_v = lkv.xy
    r.m = m
}

@test
fn sailing_keeps_a_held_keyboard_alias() {
    var r = rest()
    hold(mut r, Key::W, down: true)
    hold(mut r, Key::Up, down: true)
    hold(mut r, Key::W, down: false)
    assert(r.forward)
    hold(mut r, Key::Up, down: false)
    assert(!r.forward)
}

@test
fn sailing_keeps_keyboard_input_when_a_pad_centres() {
    var r = rest()
    hold(mut r, Key::A, down: true)
    key(mut r, Event::PadAxis { pad: 0, axis: PadAxis::LeftX, value: 0.0 })
    assert(r.left)
    let_go(mut r)
    assert(!r.left)
}

@test
fn sailing_keeps_a_held_pad_button_when_its_stick_centres() {
    var r = rest()
    key(mut r, Event::PadButton { pad: 0, button: PadButton::Up, value: 1.0, pressed: true })
    key(mut r, Event::PadAxis { pad: 0, axis: PadAxis::LeftY, value: 0.0 })
    assert(r.forward)
    let_go(mut r)
    assert(!r.forward)
}

@test
fn sailing_into_the_local_wind_cannot_drive_the_skiff() {
    let swell = Swell { modes: Vec::new(), chop: 0.0, held: 0.0 }
    var r = rest()
    r.at = vec2(0.0, -26000.0)
    let t = 1.0 / 60.0
    let air = air_at(r.at, t)
    r.steer = atan2(-air.way.x, -air.way.y) + 0.25 + 0.22
    r.trim = 1.0
    r.power = 1.0
    r.time = 0.0
    step(mut r, t, swell)
    assert(abs(r.speed) < 1.0e-6)
}
