// The rock and its cathedral, met in a pass of their own before the paint (`paint` lays it over
// what it meets behind them). They are the finest work in the frame and the farthest: a spire's
// tracery or a crag finer than a pixel crawls and beads as the eye moves, and met four times a
// pixel each drawing it still did. Here each drawing meets each pixel once, a little off its
// centre (a step of a Halton sequence), and adds it to what the drawings before met there,
// carried to where the camera has gone since (`Yon`): so over a few drawings each pixel holds
// many, and holds still as the skiff rocks. They don't move, so what was met is still true.
//
// It writes what the paint reads of them: their light, already in their air, premultiplied by how
// much of the pixel they cover; how far, what, the ink's line and weight; and the normal. (Their
// falls move each drawing, so they're not added up here, which would smear them: the paint draws
// them fresh, with `falls`.)

use main::{OFF, RELIT, ROCK_SPARSE, SPARSE}
use look::{GILT, GLASS, ISLE, ROCK, SKY, STONE, Shot, band, fbm, hash2, noise, ray}
use isle::{FALLS, SCALE, bounds, isle, isle_ao, isle_material, isle_normal, isle_shadow}
use far::far_off
use rock::{baked_at, march_from}
use stacks::{march_stacks, stacks_albedo, stacks_ao, stacks_normal, stacks_shadow}
use paint::{Heaven, aired, hazed_far, heaven, lit_solid, overhead, sphere}
use engine::far::{
    KEPT, Vista, foot, gathered, stratum, turn_index, turn_of, turn_texel, turn_texels, vista_at,
    vista_ray,
}
use engine::light::{Light, sky as clear_sky}
use engine::sky::{Clouds, cloud_shadow}
use std::gpu::{
    FragCoord, GlobalId, R32Float, Rg32Float, Rgba16Float, Rgba8, Sampler, Slots, Targets3, Texels,
    Texels3d, Texture, Texture3d,
}

/// What the drawings before left, and where from: the camera of the last drawing (its eye, its
/// axes, its focal length and its screen) and how many drawings the pixels hold (0: none, so
/// this one starts afresh). And this drawing's offset in its pixels (px).
pub struct Yon: Copy + GpuData {
    pub eye: vec3,
    pub forward: vec3,
    pub right: vec3,
    pub up: vec3,
    pub focal: f32,
    pub resolution: vec2,
    pub held: f32,
    pub jitter: vec2,
    /// Which of each 2x2 of 8x8-pixel blocks this drawing meets the rock in afresh (`REFRESH`).
    pub turn: u32,
    /// Whether the rock's meshes say where its march starts (`rock::reach`): 1, or 0.
    pub meshed: u32,
    /// Which of each 2x2 of blocks (`ROCK_BLOCK` of the half-size pass's pixels) meets the rock
    /// and the cathedral this drawing, when they're met more sparsely than the stacks
    /// (`main::ROCK_SPARSE`).
    pub rock_turn: u32,
    /// Whether the rock and the cathedral are the vista's (`main::VISTA`, `vista_look`): 1 once
    /// it's laid in whole, 0 before (on a first load, or while it fades in or out), when they're
    /// met here as ever.
    pub vista: u32,
}

/// The side of the blocks the rock is met in by turns (`Yon::rock_turn`), in the half-size
/// pass's pixels: wide enough that a wave of the GPU's threads falls in one.
pub const ROCK_BLOCK: u32 = 16

/// What the half-size pass says of a pixel whose turn to meet the rock this isn't, where no
/// stack stands nearer (`Yon::rock_turn`): keep what was carried.
pub const KEEP: f32 = -2.0

/// The rock and the cathedral met afresh in one block of each 2x2 a drawing, in turn: the
/// others keep what the drawings before met there, carried to where the camera has gone. They
/// don't move and they're kilometres off, so what was met is still true; the mean over the
/// drawings only builds up four times as slowly.
pub const REFRESH: u32 = 4

/// The most drawings a pixel holds: a new one weighs at least one part in so many.
const HOLD: f32 = 12.0

/// `t` read at `at` (px) through a Catmull-Rom filter, from nine texels in five bilinear reads
/// (Jimenez's): what's carried from drawing to drawing is read again each time, and bilinear
/// reads would blur it a little more each one, the rock going soft as the skiff rocks.
/// (Never below zero: the filter's lobes can undershoot at a hard edge.)
fn sharp(t: Texture<Rgba16Float>, smp: Sampler, at: vec2, size: vec2) -> vec4 {
    let pos = at - vec2(0.5)
    let c = floor(pos) + vec2(0.5)
    let f = pos - floor(pos)
    let w0 = f * (-0.5 + f * (1.0 - 0.5 * f))
    let w1 = vec2(1.0) + f * f * (-2.5 + 1.5 * f)
    let w2 = f * (0.5 + f * (2.0 - 1.5 * f))
    let w3 = f * f * (-0.5 + 0.5 * f)
    let w12 = w1 + w2
    let o12 = w2 / w12
    let p0 = (c - vec2(1.0)) / size
    let p3 = (c + vec2(2.0)) / size
    let p12 = (c + o12) / size
    var r = t.sample_level(smp, vec2(p12.x, p0.y)) * (w12.x * w0.y)
    r += t.sample_level(smp, vec2(p0.x, p12.y)) * (w0.x * w12.y)
    r += t.sample_level(smp, p12) * (w12.x * w12.y)
    r += t.sample_level(smp, vec2(p3.x, p12.y)) * (w3.x * w12.y)
    r += t.sample_level(smp, vec2(p12.x, p3.y)) * (w12.x * w3.y)
    let wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y
    max(r / wsum, vec4(0.0))
}

/// `sharp`, held within the four texels round `at`: the filter's lobes overshoot a hard edge,
/// and carried from aim to aim an overshoot would grow (a stone's edge brighter than the stone,
/// more than all of a texel covered).
fn sharp_within(t: Texture<Rgba16Float>, smp: Sampler, at: vec2, size: vec2) -> vec4 {
    let base = clamp(floor(at - vec2(0.5)), vec2(0.0), size - vec2(2.0))
    var lo = vec4(1.0e9)
    var hi = vec4(-1.0e9)
    for k in 0..4 {
        let texel = t.load(u32(base.x) + (k & 1), u32(base.y) + (k >> 1))
        lo = min(lo, texel)
        hi = max(hi, texel)
    }
    clamp(sharp(t, smp, at, size), lo, hi)
}

/// Where from the world point `w` the camera of `y` saw (px), and whether it saw it at all.
fn was_at(y: Yon, w: vec3) -> vec3 {
    let v = w - y.eye
    let z = dot(v, y.forward)
    let uv = vec2(dot(v, y.right), -dot(v, y.up)) * (y.focal / max(z, 1.0e-3))
    let at = (uv * y.resolution.y + y.resolution) * 0.5
    let seen = z > 0.0 &&
        at.x >= 0.0 &&
        at.y >= 0.0 &&
        at.x < y.resolution.x &&
        at.y < y.resolution.y
    vec3(at, if seen { 1.0 } else { 0.0 })
}

/// The isle's field cooked once, at load (`cook_isle`), on a coarse grid of `FIELD_SIDE`³ cells
/// over its bounds: in each cell, how far the isle is from anywhere in it at least (m). The rock
/// and the cathedral don't move, so what's far from them stays far: the march crosses the
/// empty air round them by it, a read a step, and meets them by their own field as before.
pub const FIELD_SIDE: u32 = 128

/// How much steeper than a distance the isle's field may run: the march steps 0.8 of it, but
/// the rock's fractures and crags run steeper in places (about 2 at worst).
const STEEP: f32 = 2.0

/// How far the rock's field jumps where its beds wrap (m): its ledges' lips (4.5) and its finer
/// beds (2.2), in the rock's own units, scaled to the world's. A cell across one of those sheets
/// can't vouch for its far side by its slope alone.
const JUMPS: f32 = 6.7 * SCALE

/// The cook's slabs of the grid (in z), one a drawing, so the first drawing isn't held up by it.
pub const FIELD_SLABS: u32 = 8

/// Past how far (m) the cooked field is trusted for a step: nearer, the isle's own.
const NEAR: f32 = 6.0

/// A cell of the isle's cooked field: the field at its middle, less the most it can fall from
/// there to the cell's corners.
/// (Only slab `slab` of `FIELD_SLABS`, the rest left as they are. A cell not yet cooked reads 0:
/// the isle's own field there, as before.)
@compute(4, 4, 4)
pub fn cook_isle(slab: u32, out: mut Texels3d<R32Float>, id: GlobalId) {
    let per = FIELD_SIDE / FIELD_SLABS
    if id.z < slab * per || id.z >= (slab + 1) * per {
        return
    }
    let b = bounds()
    let cell = 2.0 * b.w / f32(FIELD_SIDE)
    let at = b.xyz - vec3(b.w) + (vec3(f32(id.x), f32(id.y), f32(id.z)) + vec3(0.5)) * cell
    out.store(id, isle(at).x - STEEP * 0.8660254 * cell - JUMPS)
}

/// The cooked field's low corner (the world's), and how wide it is (m).
const FIELD_LO: vec3 = bounds().xyz - vec3(bounds().w)
const FIELD_WIDE: f32 = 2.0 * bounds().w

/// How far the isle is from `p` at least (m), by its cooked field (`cook_isle`); 0 outside it.
fn isle_far(field: Texture3d<R32Float>, p: vec3) -> f32 {
    let g = (p - FIELD_LO) / FIELD_WIDE * f32(FIELD_SIDE)
    let n = f32(FIELD_SIDE)
    if g.x < 0.0 || g.y < 0.0 || g.z < 0.0 || g.x >= n || g.y >= n || g.z >= n {
        return 0.0
    }
    field.load(u32(g.x), u32(g.y), u32(g.z))
}

fn march_isle(field: Texture3d<R32Float>, o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 320 && t < hi {
        let far = isle_far(field, o + d * t)
        let h = if far > NEAR { far } else { isle(o + d * t).x }
        if far > NEAR {
            t += far * 0.8
        } else if h < t * 0.0001 {
            hit = t
            t = hi
        } else {
            t += h * 0.8
        }
        i += 1
    }
    // (Settled onto the surface: a hit left anywhere inside the march's last step bands a face
    // seen edge on with the steps' contours.)
    if hit < hi {
        for _ in 0..3 {
            hit += isle(o + d * hit).x
        }
    }
    hit
}

/// The rock or the cathedral (`id`) where the ray `o` + `d` met it, `t` off, at pixel `px`: its
/// light, in its air, its line and weight, and the normal the ink reads.
fn isle_shade(
    s: Shot,
    h: Heaven,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    d: vec3,
    t: f32,
    id: f32,
    px: vec2,
    baked: vec2,
) -> (vec3, f32, f32, vec3) {
    let light = h.light
    var c = vec3(0.0)
    var line = 1.0
    var weight = 0.0
    var n = vec3(y: 1.0)
    // The rock's normal taken broad, so it models in planes, as hewn stone is drawn; the
    // cathedral's finer.
    // (Far off, the cathedral's too: an arcade or a tracery's ring finer than a pixel or two
    // only beads in the low sun, a grid of gold specks, so its faces are lit as planes there.)
    let broad = if id == ROCK { 0.0016 } else {
        mix(0.0007, 0.0024, smoothstep(2000.0, 6000.0, t))
    }
    n = isle_normal(p, max(0.3, t * broad))
    // (A pixel's footprint on the face, longer as the face turns from the eye.)
    let (albedo, rough, metal, glow0, l) = isle_material(
        p,
        n,
        id,
        foot(t, s.resolution.y, s.focal, dot(n, d)),
    )
    // The gilding shines: it holds the low sun, as if lit from within.
    // (Far off, a cross or a finial is a speck: held down, or it beads as a model's would.)
    let far_ = 1.0 - 0.95 * smoothstep(2000.0, 6000.0, t)
    let glow = if id == GILT {
        glow0 +
            light.sun_colour *
                vec3(1.0, 0.74, 0.4) *
                (0.25 + 0.8 * max(dot(n, light.sun), 0.0)) *
                far_
    } else if id == GLASS { glow0 * (1.0 + 20.0 * s.lantern) } else { glow0 }
    // (Its shadows likewise: none from a recess too small for a pixel to hold.)
    // (Cooked onto the rock's meshes, where they have it (`rock::Shade`): read, not marched.)
    let lift = max(2.0, t * 0.0012)
    let shadow = if baked.x >= 0.0 { baked.x } else {
        isle_shadow(p + n * lift, light.sun, lift, hash2(px * 1.37))
    }
    let sun = shadow * mix(1.0, cloud_shadow(clouds, cloud, smp, p), mix(0.35, 1.0, light.storm))
    let ao = if baked.y >= 0.0 { baked.y } else { isle_ao(p, n) }
    // The rock and the cathedral on it in the same air: all the air their 8 km holds, and a
    // little past it toward the sky's own colour, as a painter pushes back what's far; so the
    // building sits on its rock, not over it, and both sit far off, not near and small.
    // Its underside, hung in its own shade, given to the air: the lower, the more of the sky.
    // (The same air top to tip: an underside fading to the sky more than its top reads as a
    // ghost, not stone. Its own shade, below, keeps it dark.)
    let below = clamp((ISLE.y - p.y) / (210.0 * SCALE), 0.0, 1.0)
    let haze = 0.97
    let gloss = if id == ROCK { 0.0 } else { 1.0 }
    // (The rock lit by its planes more than its cracks: a crack's wall turned to the sun
    // catches it softly, not as a seam of gold.)
    let rn = if id == ROCK { isle_normal(p, t * 0.006) } else { n }
    let ln = if id == ROCK { normalize(mix(n, rn, 0.85)) } else { n }
    c = lit_solid(
        s,
        h,
        view,
        aerial,
        dome,
        smp,
        p,
        ln,
        d,
        albedo,
        rough,
        metal,
        glow,
        sun,
        ao,
        0.0,
        gloss,
    )
    // The underside hangs in its own shade, darker the lower: a mass over the sea, not a veil.
    if id == ROCK {
        c *= mix(1.0, 0.5, smoothstep(0.1, 0.8, below))
    }
    // The keep's foot darker where it meets the town's top terraces, and the town's walls
    // under it darker still, in their own shade and the grime their rain runs down to: the
    // building grows from its rock, not set on it.
    if id == STONE {
        c *= mix(0.6, 1.0, smoothstep(30.0, 170.0, p.y - (ISLE.y + 2.0 * SCALE)))
    }
    // The sun behind it catches every edge turned its way: a hot rim down the spires' and the
    // rock's sun sides, against the light.
    let side = normalize(vec3(light.sun.x, 0.15, light.sun.z))
    // (The rock's rim off its broad planes, not every crack's: a light along its edges, not
    // a sparkle.)
    let cel = s.look > 1.5 && s.look < 2.5
    let edge_soft = pow(1.0 - max(dot(rn, -d), 0.0), 3.0) * max(dot(rn, side), 0.0)
    let edge_on = if cel { band(edge_soft, 0.15, 0.02) * 0.4 } else { edge_soft }
    // (Far off, a rim along a spire finer than a pixel only beads: held down there.)
    let hot = (if id == ROCK { 0.08 } else if id == GILT { 0.8 } else {
        1.0
    }) * (if id == ROCK { 1.0 } else { mix(1.0, 0.18, smoothstep(2500.0, 7000.0, t)) })
    c += light.sun_colour * vec3(1.0, 0.78, 0.45) * hot * edge_on * mix(1.0, sun, 0.6)
    // The rock's great planes modelled as a painter would against the light: those turned
    // toward the sun's side warmed by it as it wraps round, those turned away left in a
    // deeper, cooler shade, and the ledges' tops catching the sky. Fading as the air takes
    // the underside.
    if id == ROCK {
        let wrap = if cel { band(dot(rn, side), -0.05, 0.03) * 0.5 } else {
            pow(clamp(dot(rn, side) * 0.55 + 0.45, 0.0, 1.0), 2.5)
        }
        let ledge = smoothstep(0.2, 0.7, rn.y)
        let fade = 1.0 - smoothstep(0.2, 0.8, below)
        c += albedo *
            light.sun_colour *
            vec3(1.0, 0.8, 0.55) *
            0.3 *
            wrap *
            mix(0.35, 1.0, sun) *
            fade
        c += albedo * vec3(0.5, 0.58, 0.75) * 0.12 * ledge * fade
        c *= mix(1.0, mix(0.72, 1.0, wrap), fade)
        // Under the overcast, a ledge reads by the sky it sees: its top catching the deck's
        // light, the overhang under it looking down at the dark sea. (By the finer normal: the
        // broad one smooths a 50 m ledge away.) So its tiers band it, top to tip.
        let up = smoothstep(0.15, 0.7, n.y)
        let down = smoothstep(-0.1, -0.6, n.y)
        c *= (1.0 + 0.55 * up) * (1.0 - 0.45 * down)
    }
    // (The air over all of that: the shading darkens the stone, never the air in front of it.)
    c = hazed_far(s, h, view, aerial, dome, smp, c, p, d, haze)
    line = l
    weight = if id == ROCK { 0.55 } else { 0.5 }
    // (The ink reads the rock by its planes too.)
    n = ln
    (c, line, weight, n)
}

/// `c` (a far solid's light through all its air, along `d`) pushed back `k` (0 to 1) of the way on
/// toward the sky behind it, the sky the eye sees there (the storm's own air on the horizon); and
/// never brighter than that sky: a stack against the light is its shadow side, and a pale sliver
/// of it toward the sun reads as a white spark on the horizon.
fn pushed_back(
    h: Heaven,
    view: Texture<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    c: vec3,
    d: vec3,
    k: f32,
) -> vec3 {
    let stormy = heaven(
        view,
        h.light,
        normalize(vec3(d.x, max(d.y, 0.0), d.z)),
        dome,
        smp,
        h.over,
    ).rgb
    // (Under an open sky, less, and toward the open sky's own colour, not the clouds' behind
    // it: the far clouds' pattern, capped into a stack, showed through it as if it were glass.)
    let open = clear_sky(view, smp, h.light, normalize(vec3(d.x, max(d.y, 0.02), d.z)))
    let sky = mix(open, stormy, h.light.storm)
    min(mix(c, sky, k * mix(0.45, 1.0, h.light.storm)), sky * 0.9)
}

/// A stack where the ray met it at `p`, a pixel `px` m across there: its light in its air, and
/// its normal. Lit as the rock is lit: the one sun through the deck, the deck's light, the air.
fn stacks_shade(
    s: Shot,
    h: Heaven,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    d: vec3,
    px: f32,
) -> (vec3, vec3) {
    let n = stacks_normal(p, max(0.04, px * 0.6), px)
    let albedo = stacks_albedo(p, n, px)
    let lift = max(0.1, px)
    let sun = stacks_shadow(p + n * lift, h.light.sun, px) *
        mix(1.0, cloud_shadow(clouds, cloud, smp, p), mix(0.35, 1.0, h.light.storm))
    let ao = stacks_ao(p, n, px)
    // (All the air between, and the farther a little past it toward the deck's own colour, as
    // the rock is pushed back: so a stack two kilometres off stands paler than one at three
    // hundred metres, and the eye reads how far each is.)
    let t = length(p - s.eye)
    let c = lit_solid(
        s,
        h,
        view,
        aerial,
        dome,
        smp,
        p,
        n,
        d,
        albedo,
        0.85,
        0.0,
        vec3(0.0),
        sun,
        ao,
        1.0,
        0.0,
    )
    (pushed_back(h, view, dome, smp, c, d, 0.1 + 0.7 * pow(smoothstep(60.0, 2200.0, t), 0.7)), n)
}

@fragment
pub fn yonder(
    pixel: FragCoord,
    shot: Shot,
    yon: Yon,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    past_colour: Texture<Rgba16Float>,
    past_marks: Texture<Rgba16Float>,
    past_normal: Texture<Rgba8>,
    field: Texture3d<R32Float>,
    reach: Texture<Rg32Float>,
    once: [vec4],
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let h = Heaven { light, clouds, over: overhead(once) }
    let px = pixel.position.xy
    let o = s.eye
    let far = 1.0e5
    let d = ray(s, px + yon.jitter)
    var t = far
    var id = SKY
    let is = sphere(o, d, bounds(), far)
    // (Not this pixel's turn, and the last drawing met the rock, or something as far, where it
    // sees: that's kept, and only what's nearer met.)
    var rest = false
    // (By blocks of pixels (`main::RELIT`), not single pixels: a GPU runs neighbouring pixels together, and
    // a block where any one pixel meets the rock afresh waits on it.)
    let mine = (u32(px.x) / RELIT % 2) + 2 * (u32(px.y) / RELIT % 2)
    if yon.held > 0.0 && mine != yon.turn && is.x < is.y && (OFF & 4096) == 0 && yon.vista == 0 {
        let was0 = was_at(yon, o + ray(s, px) * length(ISLE - o))
        if was0.z > 0.0 {
            let q0 = clamp(floor(was0.xy), vec2(0.0), yon.resolution - vec2(1.0))
            let bm0 = past_marks.load(u32(q0.x), u32(q0.y))
            let seen = was_at(yon, o + ray(s, px) * min(exp2(bm0.x), length(ISLE - o) * 1.2)).z
            if bm0.y > ROCK - 0.5 && exp2(bm0.x) > 2500.0 && seen > 0.0 {
                rest = true
                t = exp2(bm0.x)
                id = bm0.y
            }
        }
    }
    let from = if yon.meshed == 1 { march_from(reach, px, s.resolution, is.x, is.y) } else { is.x }
    if from < is.y && (OFF & 1) == 0 && !rest && yon.vista == 0 {
        let ti = march_isle(field, o, d, from, is.y)
        if ti < is.y {
            t = ti
            id = isle(o + d * ti).y
        }
    }
    // The sea's own stacks, nearer.
    let k = 2.0 / (s.resolution.y * s.focal)
    let ts = if (OFF & 2) == 0 { march_stacks(o, d, t, k) } else { far }
    var c = vec3(0.0)
    var cover = 0.0
    var marks = vec4(log2(far), SKY, 1.0, 0.0)
    var n = -d
    if ts < t && (OFF & 1024) != 0 {
        c = vec3(0.05)
        cover = 1.0
        marks = vec4(log2(ts), ROCK, 1.0, 0.5)
    } else if ts < t {
        let (sc, sn) = stacks_shade(
            s,
            h,
            clouds,
            view,
            aerial,
            dome,
            cloud,
            smp,
            o + d * ts,
            d,
            ts * k,
        )
        c = sc
        cover = 1.0
        marks = vec4(log2(ts), ROCK, 1.0, 0.5)
        n = sn
    } else if id == SKY {
        // Past them, the archipelago's other islands on the horizon, as silhouettes.
        let (tf, fnn) = if (OFF & 4) == 0 { far_off(o, d, far, k) } else { (far, -d) }
        if tf < far {
            let p = o + d * tf
            let sun = mix(1.0, cloud_shadow(clouds, cloud, smp, p), mix(0.35, 1.0, h.light.storm))
            let albedo = vec3(0.07, 0.072, 0.08) * (0.85 + 0.3 * noise(vec2(p.x + p.z, p.y) * 0.02))
            // (Pushed back past their air toward the deck's colour, as the rock is.)
            let lit = lit_solid(
                s,
                h,
                view,
                aerial,
                dome,
                smp,
                p,
                fnn,
                d,
                albedo,
                0.9,
                0.0,
                vec3(0.0),
                sun,
                1.0,
                1.0,
                0.0,
            )
            c = pushed_back(h, view, dome, smp, lit, d, 0.4 * smoothstep(3000.0, 10000.0, tf))
            cover = 1.0
            marks = vec4(log2(tf), ROCK, 1.0, 0.3)
            n = fnn
        }
    } else if rest {
        // (Kept from the drawings before, below.)
        cover = 1.0
        marks = vec4(log2(t), id, 1.0, 0.5)
    } else if (OFF & 512) != 0 {
        c = vec3(0.05)
        cover = 1.0
        marks = vec4(log2(t), id, 1.0, 0.5)
    } else {
        let (ic, il, iw, inn) = isle_shade(
            s,
            h,
            clouds,
            view,
            aerial,
            dome,
            cloud,
            smp,
            o + d * t,
            d,
            t,
            id,
            px,
            if yon.meshed == 1 { baked_at(reach, px, s.resolution, t) } else { vec2(-1.0) },
        )
        c = ic
        cover = 1.0
        marks = vec4(log2(t), id, il, iw)
        n = inn
    }
    var now = vec4(c, cover)
    var third = vec4(n * 0.5 + 0.5, 0.0)
    // What the drawings before met here, carried to where the camera has gone: the point this
    // pixel sees (the rock's, or for the sky round it, as far as the rock) where the last
    // drawing's camera saw it.
    if yon.held > 0.0 {
        let w = o + ray(s, px) * min(exp2(marks.x), length(ISLE - o) * 1.2)
        let was = was_at(yon, w)
        if was.z > 0.0 {
            let uv = was.xy / yon.resolution
            let before = sharp(past_colour, smp, was.xy, yon.resolution)
            let q = clamp(floor(was.xy), vec2(0.0), yon.resolution - vec2(1.0))
            let bm = past_marks.load(u32(q.x), u32(q.y))
            // (A near stack slides past what's behind it: where this drawing and the last met
            // things at different depths and either was a near stack, little of the last is
            // kept, else it trails a smear off the stack's side as the skiff turns.)
            // (But only where this drawing has no stack edge round it: an edge's pixels flip
            // between stack and sky from drawing to drawing with the jitter, and they're the
            // ones the mean is for. Where none of the pixels round it meets the same as this one,
            // the last drawing's is a ghost, and it's dropped.)
            let near = min(bm.x, marks.x) < 11.5
            var fresh = 0.0
            if near && abs(bm.x - marks.x) > 0.25 && (OFF & 2048) == 0 {
                // (Two neighbours, one on each diagonal 1.5 pixels off, see a side's edge and a top's
                // alike; and once one differs it's an edge, and the other isn't marched.)
                var same = true
                var j = 0
                while j < 2 && same {
                    let side = f32(j) * 2.0 - 1.0
                    let dj = ray(s, px + vec2(1.0, side) * 1.06)
                    same = (march_stacks(o, dj, t, k) < t) == (ts < t)
                    j += 1
                }
                // (And an edge's mean held short, a few drawings: the stack slides against the
                // sky behind it, and a long mean would trail it.)
                fresh = if same { 1.0 } else { 0.3 }
            }
            let k = if rest && ts >= t { 0.0 } else { max(1.0 / min(yon.held + 1.0, HOLD), fresh) }
            now = mix(before, now, k)
            let bn = past_normal.sample_level(smp, uv)
            // (What it is isn't a mean: the last drawing's where this one met nothing of it.)
            let what = if id != SKY { id } else if now.a > 0.5 { bm.y } else { SKY }
            marks = vec4(
                mix(bm.xzw, marks.xzw, k).x,
                what,
                mix(bm.z, marks.z, k),
                mix(bm.w, marks.w, k),
            )
            third = mix(bn, third, k)
        }
    }
    Targets3 { first: now, second: marks, third }
}

/// What the ray through `pf` (px, the full drawing's, offset already) meets of the rock, the
/// cathedral, the stacks and the far islands: their light in their air, premultiplied by how
/// much they cover; what the ink reads; the normal. Nothing carried from the drawings before.
fn meet(
    s: Shot,
    h: Heaven,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    field: Texture3d<R32Float>,
    reach: Texture<Rg32Float>,
    meshed: u32,
    vista: u32,
    skip_rock: bool,
    pf: vec2,
) -> (vec4, vec4, vec4) {
    let o = s.eye
    let far = 1.0e5
    let d = ray(s, pf)
    var t = far
    var id = SKY
    let is = sphere(o, d, bounds(), far)
    // (Once the vista holds the rock and the cathedral (`Yon::vista`), drawn into their own
    // picture pinned to the world (`vista_look`) and laid in after (`far_merge`): only the
    // stacks and the far islands are met here.)
    let from = if vista == 1 { is.y } else if meshed == 1 {
        march_from(reach, pf, s.resolution, is.x, is.y)
    } else { is.x }
    let k = 2.0 / (s.resolution.y * s.focal)
    // (Skipped only where no stack stands past where the rock begins: there the rock may be the
    // nearer, and it's met. The stacks met to the horizon here are the same as met to the rock.)
    let s0 = if skip_rock && is.x < is.y && (OFF & 2) == 0 { march_stacks(o, d, far, k) } else {
        far
    }
    let skip = skip_rock && (s0 >= far || s0 < is.x)
    if from < is.y && (OFF & 1) == 0 && !skip {
        let ti = march_isle(field, o, d, from, is.y)
        if ti < is.y {
            t = ti
            id = isle(o + d * ti).y
        }
    }
    let ts = if skip_rock && is.x < is.y && (OFF & 2) == 0 { s0 } else if (OFF & 2) == 0 {
        march_stacks(o, d, t, k)
    } else { far }
    var c = vec3(0.0)
    var cover = 0.0
    var marks = vec4(log2(far), SKY, 1.0, 0.0)
    var n = -d
    // (Only where the rock could be: past its bounds, the far islands are met as ever.)
    if skip && ts >= t && is.x < is.y {
        // (As far as the rock: where the rebuild carries what was met from.)
        return (vec4(0.0), vec4(log2(length(ISLE - o)), KEEP, 0.0, 0.0), vec4(0.0))
    }
    if ts < t && (OFF & 1024) != 0 {
        c = vec3(0.05)
        cover = 1.0
        marks = vec4(log2(ts), ROCK, 1.0, 0.5)
    } else if ts < t {
        let (sc, sn) = stacks_shade(
            s,
            h,
            clouds,
            view,
            aerial,
            dome,
            cloud,
            smp,
            o + d * ts,
            d,
            ts * k,
        )
        c = sc
        cover = 1.0
        marks = vec4(log2(ts), ROCK, 1.0, 0.5)
        n = sn
    } else if id == SKY {
        let (tf, fnn) = if (OFF & 4) == 0 { far_off(o, d, far, k) } else { (far, -d) }
        if tf < far {
            let p = o + d * tf
            let sun = mix(1.0, cloud_shadow(clouds, cloud, smp, p), mix(0.35, 1.0, h.light.storm))
            let albedo = vec3(0.07, 0.072, 0.08) * (0.85 + 0.3 * noise(vec2(p.x + p.z, p.y) * 0.02))
            let lit = lit_solid(
                s,
                h,
                view,
                aerial,
                dome,
                smp,
                p,
                fnn,
                d,
                albedo,
                0.9,
                0.0,
                vec3(0.0),
                sun,
                1.0,
                1.0,
                0.0,
            )
            c = pushed_back(h, view, dome, smp, lit, d, 0.4 * smoothstep(3000.0, 10000.0, tf))
            cover = 1.0
            marks = vec4(log2(tf), ROCK, 1.0, 0.3)
            n = fnn
        }
    } else if (OFF & 512) != 0 {
        c = vec3(0.05)
        cover = 1.0
        marks = vec4(log2(t), id, 1.0, 0.5)
    } else {
        let (ic, il, iw, inn) = isle_shade(
            s,
            h,
            clouds,
            view,
            aerial,
            dome,
            cloud,
            smp,
            o + d * t,
            d,
            t,
            id,
            pf,
            if meshed == 1 { baked_at(reach, pf, s.resolution, t) } else { vec2(-1.0) },
        )
        c = ic
        cover = 1.0
        marks = vec4(log2(t), id, il, iw)
        n = inn
    }
    (vec4(c, cover), marks, vec4(n * 0.5 + 0.5, 0.0))
}

/// Which pixel of each `SPARSE`-square block a drawing meets afresh when they're met sparsely
/// (`main::QUARTER`), the `turn`th: each in turn, in an ordered-dither order, so those met one
/// after another lie far apart in the block.
pub fn spot(turn: u32) -> vec2 {
    if SPARSE == 2 {
        let i = turn % 4
        return if i == 0 { vec2(0.0, 0.0) } else if i == 1 { vec2(1.0, 1.0) } else if i == 2 {
            vec2(1.0, 0.0)
        } else { vec2(0.0, 1.0) }
    }
    SPOTS[turn % 16]
}

/// Where in its turns block `q` (of the sparse pass's pixels) starts: each its own, so the
/// pixels met lately don't lie on one lattice across the screen, which reads as a grid of dots.
fn shuffled(q: vec2) -> u32 {
    if SPARSE == 2 { 0 } else { u32(hash2(q + vec2(0.5)) * 16.0) % 16 }
}

/// The 4x4 ordered-dither (Bayer) matrix's places, by their number.
const SPOTS = [
    vec2(0.0, 0.0),
    vec2(2.0, 2.0),
    vec2(2.0, 0.0),
    vec2(0.0, 2.0),
    vec2(1.0, 1.0),
    vec2(3.0, 3.0),
    vec2(3.0, 1.0),
    vec2(1.0, 3.0),
    vec2(1.0, 0.0),
    vec2(3.0, 2.0),
    vec2(3.0, 0.0),
    vec2(1.0, 2.0),
    vec2(0.0, 1.0),
    vec2(2.0, 3.0),
    vec2(2.0, 1.0),
    vec2(0.0, 3.0),
]

/// The far things met a quarter at a time (`main::QUARTER`): a pixel of this pass's, half the
/// drawing's size each way, meets one pixel of its 2x2 in the drawing (`quarter_of` the turn),
/// a little off its centre. `yonder_rebuild` lays them over what the drawings before met.
@fragment
@standin(yonder_low_flat)
pub fn yonder_low(
    pixel: FragCoord,
    shot: Shot,
    yon: Yon,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    field: Texture3d<R32Float>,
    reach: Texture<Rg32Float>,
    once: [vec4],
) -> Targets3<vec4, vec4, vec4> {
    let q = floor(pixel.position.xy)
    let pf = q * f32(SPARSE) + spot(yon.turn + shuffled(q)) + vec2(0.5) + yon.jitter
    // (Not this block's turn to meet the rock: only the stacks are met, and where none is, what
    // was carried is kept.)
    let block = (u32(q.x) / ROCK_BLOCK % 2) + 2 * (u32(q.y) / ROCK_BLOCK % 2)
    // (And only where the last drawing saw it: at the edge a turn brings in there's nothing to keep.)
    let seen = was_at(yon, shot.eye + ray(shot, pf) * length(ISLE - shot.eye)).z > 0.0
    let skip = ROCK_SPARSE && yon.vista == 0 && yon.held > 0.0 && block != yon.rock_turn && seen
    let (now, marks, third) = meet(
        shot,
        Heaven { light, clouds, over: overhead(once) },
        clouds,
        view,
        aerial,
        dome,
        cloud,
        smp,
        field,
        reach,
        yon.meshed,
        yon.vista,
        skip,
        pf,
    )
    Targets3 { first: now, second: marks, third }
}

/// What `yonder_low` draws while the browser builds it (seconds, on a first load): the rock, a
/// flat shape in the open sky's haze, where its mesh is (`rock::reach`) or, before it has one,
/// where the cooked field (`cook_isle`) says it is, a little fat; the sky elsewhere.
@fragment
pub fn yonder_low_flat(
    pixel: FragCoord,
    shot: Shot,
    yon: Yon,
    light: Light,
    _clouds: Clouds,
    view: Texture<Rgba16Float>,
    _aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    _cloud: Texture<Rgba16Float>,
    smp: Sampler,
    field: Texture3d<R32Float>,
    reach: Texture<Rg32Float>,
    once: [vec4],
) -> Targets3<vec4, vec4, vec4> {
    let pf = floor(pixel.position.xy) * f32(SPARSE) + vec2(0.5)
    let d = ray(shot, pf)
    let q = clamp(pf, vec2(0.0), shot.resolution - vec2(1.0))
    let t = if yon.vista == 1 { 1.0e5 } else if yon.meshed == 1 {
        reach.load(u32(q.x), u32(q.y)).x
    } else { rough_isle(field, shot.eye, d) }
    if t >= 9.0e4 {
        return Targets3 {
            first: vec4(0.0),
            second: vec4(log2(1.0e5), SKY, 1.0, 0.0),
            third: vec4(-d * 0.5 + 0.5, 0.0),
        }
    }
    let up = normalize(vec3(d.x, max(d.y, 0.02), d.z))
    let open = clear_sky(view, smp, light, up)
    let haze = mix(open, heaven(view, light, up, dome, smp, overhead(once)).rgb, light.storm)
    let c = haze * mix(0.35, 0.7, smoothstep(3000.0, 10000.0, t))
    Targets3 {
        first: vec4(c, 1.0),
        second: vec4(log2(t), ROCK, 1.0, 0.3),
        third: vec4(-d * 0.5 + 0.5, 0.0),
    }
}

/// How far along `d` from `o` the isle's cooked field (`cook_isle`) says its surface is (m), 1e5
/// where it doesn't: the field at the cells' middles, given back what the cook took off, and
/// read between them. A cell not cooked yet (0) reads as air.
fn rough_isle(field: Texture3d<R32Float>, o: vec3, d: vec3) -> f32 {
    let b = bounds()
    let is = sphere(o, d, b, 1.0e5)
    let cell = 2.0 * b.w / f32(FIELD_SIDE)
    var t = is.x
    for _i in 0..96 {
        if t >= is.y {
            return 1.0e5
        }
        let f = cooked_at(field, o + d * t) + STEEP * 0.8660254 * cell + JUMPS
        if f < 0.0 {
            return t
        }
        t += max(f * 0.5, cell * 0.25)
    }
    1.0e5
}

/// The cooked field at `p`, read between the cells' middles.
fn cooked_at(field: Texture3d<R32Float>, p: vec3) -> f32 {
    let b = bounds()
    let n = f32(FIELD_SIDE)
    let g = clamp(
        (p - (b.xyz - vec3(b.w))) / (2.0 * b.w) * n - vec3(0.5),
        vec3(0.0),
        vec3(n - 1.001),
    )
    let i = floor(g)
    let f = g - i
    let x0 = u32(i.x)
    let y0 = u32(i.y)
    let z0 = u32(i.z)
    let x1 = min(x0 + 1, FIELD_SIDE - 1)
    let y1 = min(y0 + 1, FIELD_SIDE - 1)
    let z1 = min(z0 + 1, FIELD_SIDE - 1)
    let a = mix(field.load(x0, y0, z0), field.load(x1, y0, z0), f.x)
    let bb = mix(field.load(x0, y1, z0), field.load(x1, y1, z0), f.x)
    let c = mix(field.load(x0, y0, z1), field.load(x1, y0, z1), f.x)
    let e = mix(field.load(x0, y1, z1), field.load(x1, y1, z1), f.x)
    mix(mix(a, bb, f.y), mix(c, e, f.y), f.z)
}

/// Of the most drawings a pixel holds met a quarter at a time: a new one weighs at least one
/// part in so many of its own.
const QUARTER_HOLD: f32 = 4.0

/// The least share of a solid met over what was carried as sky (`yonder_rebuild`): over a half,
/// so the paint takes it as solid at once (`paint_at`).
const OVER_SKY: f32 = 0.6

/// The most drawings a pixel holds where what's met there jumps (`yonder_rebuild`).
const EDGE_HOLD: f32 = 12.0

/// How far (the drawing's pixels) an edge held `EDGE_HOLD` long may move over its hold: a meet
/// in four drawings, so a pixel moving 0.02 px a drawing holds the most, faster ones less.
const EDGE_REACH: f32 = 0.25

/// The far things at the drawing's full size from a quarter met afresh (`yonder_low`): the pixel
/// met this drawing adds it to what the drawings before met there, carried to where the camera
/// has gone, as the full pass does; the others keep what was carried. They don't move, so it's
/// still true, unless something else now stands there: where what was carried lies at another
/// depth from what this drawing met beside it, it's held to the colours met round it.
@fragment
pub fn yonder_rebuild(
    pixel: FragCoord,
    shot: Shot,
    yon: Yon,
    smp: Sampler,
    low_colour: Texture<Rgba16Float>,
    low_marks: Texture<Rgba16Float>,
    low_normal: Texture<Rgba8>,
    past_colour: Texture<Rgba16Float>,
    past_marks: Texture<Rgba16Float>,
    past_normal: Texture<Rgba8>,
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let ip = floor(pixel.position.xy)
    let side = f32(SPARSE)
    let q = floor(ip / side)
    let lsize = ceil(s.resolution / side)
    let lc = low_colour.load(u32(q.x), u32(q.y))
    let lm = low_marks.load(u32(q.x), u32(q.y))
    let ln = low_normal.load(u32(q.x), u32(q.y))
    if yon.held <= 0.0 {
        return Targets3 { first: lc, second: lm, third: ln }
    }
    let w = s.eye + ray(s, ip + vec2(0.5)) * min(exp2(lm.x), length(ISLE - s.eye) * 1.2)
    var was = was_at(yon, w)
    // (Kept (`KEEP`): carried from as far as the rock's middle, then again from as far as what
    // was carried there, so its near and far faces don't slide.)
    if lm.y == KEEP && was.z > 0.0 {
        let bq0 = clamp(floor(was.xy), vec2(0.0), yon.resolution - vec2(1.0))
        let d0 = exp2(past_marks.load(u32(bq0.x), u32(bq0.y)).x)
        let again = was_at(
            yon,
            s.eye + ray(s, ip + vec2(0.5)) * min(d0, length(ISLE - s.eye) * 1.2),
        )
        if again.z > 0.0 {
            was = again
        }
    }
    if was.z <= 0.0 {
        return Targets3 { first: lc, second: lm, third: ln }
    }
    let before = sharp(past_colour, smp, was.xy, yon.resolution)
    let bq = clamp(floor(was.xy), vec2(0.0), yon.resolution - vec2(1.0))
    let bm = past_marks.load(u32(bq.x), u32(bq.y))
    let bn = past_normal.sample_level(smp, was.xy / yon.resolution)
    // (The same thing as this drawing met beside it: as far, give or take.)
    // (Kept: this drawing didn't meet the rock here (`KEEP`), so what was carried stands.)
    let kept = lm.y == KEEP
    let agree = kept || abs(bm.x - lm.x) < 0.25
    let off = ip - q * side - spot(yon.turn + shuffled(q))
    let mine = off.x == 0.0 && off.y == 0.0 && !kept
    var now = before
    var marks = bm
    var third = bn
    if mine {
        let had = floor(yon.held / (side * side))
        // (Not as far as what was carried: something else stands here now, and what was carried
        // is dropped, not half kept, which would leave a depth that's neither's.)
        // (Its colour blended in either way: a spire or a lit window thinner than the pixel is
        // met on and off it as the offset steps, and taken whole each time it shimmered. A solid
        // met over what was carried as sky is taken at least half: any less, the rock's edge
        // coming in over the sky as the camera turns stays see-through, marked solid, till it's
        // met again.)
        // (Longer where what's met there jumps from drawing to drawing, a spire's edge or a window's
        // opening: its share of the pixel is the mean of many; on a face, as long as the face's
        // own detail stays still. But only as long as what it holds moves less than `EDGE_REACH`
        // over it, the camera still: turning, an edge held long trails.)
        let motion = length(was.xy - (ip + vec2(0.5)))
        let edge_hold = clamp(EDGE_REACH / max(motion, 1.0e-4), QUARTER_HOLD, EDGE_HOLD)
        // (A pixel part covered is an edge too, whichever it met this time: held alike both ways,
        // or its share would lean to the one met as agreeing.)
        let edgy = !agree || (before.a > 0.02 && before.a < 0.98)
        let held_k = 1.0 / min(had + 1.0, if edgy { edge_hold } else { QUARTER_HOLD })
        // (And the take over sky only as the camera moves: held still, the rock's own thin
        // openings and spires are met on and off as the offset steps, their share the blend's.)
        let over_sky = !agree && bm.y == SKY && lm.y != SKY && edge_hold < EDGE_HOLD
        let k = if over_sky { max(held_k, OVER_SKY) } else { held_k }
        now = mix(before, lc, k)
        if agree {
            let what = if lm.y != SKY { lm.y } else if now.a > 0.5 { bm.y } else { SKY }
            marks = vec4(mix(bm.x, lm.x, k), what, mix(bm.z, lm.z, k), mix(bm.w, lm.w, k))
            third = mix(bn, ln, k)
        } else if lm.x < bm.x {
            // (Not as far as what was carried: the nearer one's marks whole, not a depth that's
            // neither's.)
            marks = lm
            third = ln
        }
    } else if !agree {
        // What was carried, held to what this drawing met round it.
        var lo = vec4(1.0e9)
        var hi = vec4(-1.0e9)
        for j in 0..3 {
            for i in 0..3 {
                let at = clamp(q + vec2(f32(i) - 1.0, f32(j) - 1.0), vec2(0.0), lsize - vec2(1.0))
                // (A neighbour kept says nothing of what's there.)
                if low_marks.load(u32(at.x), u32(at.y)).y != KEEP {
                    let v = low_colour.load(u32(at.x), u32(at.y))
                    lo = min(lo, v)
                    hi = max(hi, v)
                }
            }
        }
        now = clamp(before, lo, hi)
        // (What it is goes with what it covers: where the clamp made a carried sky solid, or a
        // carried solid sky, the marks are the neighbour's met this drawing.)
        if (now.a > 0.5) != (bm.y != SKY) {
            marks = lm
            third = ln
        }
    }
    Targets3 { first: now, second: marks, third }
}

/// How far the wind (`Shot::wind`, the world's one: `wind`) carries a drop for each metre it
/// falls (the spray's slow fall against it).
const CARRY: f32 = 0.55

/// How much of the falls a ray `o` + `d` t meets before `hit`, and their light (premultiplied);
/// and how far the nearest is (`hit` if none).
///
/// Water falling kilometres doesn't reach the bottom as water. Each fall leaves its lip as a
/// sheet, white as it breaks, and within a few hundred metres it's all spray: a plume that
/// widens as it falls, billowing, carried off down the wind and thinning till it's gone, long
/// before the sea. (Big things fall slowly on the screen: the billows sink at the spray's own
/// slow pace.) Each is drawn on the plane through its lip turned to the eye. (Torn and thin over
/// the rock: a veil of it over the underside reads as a smear, not spray.)
pub(package) fn falls(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    o: vec3,
    d: vec3,
    hit: f32,
) -> (vec4, f32) {
    var acc = vec4(0.0)
    var first = hit
    for i in 0..3 {
        let f = FALLS[i]
        if f.w >= 1.0 {
            let lip = vec3(ISLE.x + f.x * SCALE, ISLE.y + f.z * SCALE, ISLE.z + f.y * SCALE)
            let width = f.w * SCALE
            // The plane through the lip, facing the eye (about the vertical).
            let facing = normalize(vec2(lip.x - o.x, lip.z - o.z))
            let side_dir = vec2(-facing.y, facing.x)
            let den = dot(vec2(d.x, d.z), facing)
            let tc = dot(vec2(lip.x - o.x, lip.z - o.z), facing) / max(den, 1.0e-4)
            if den > 0.0 && tc < hit {
                let p = o + d * tc
                let drop = lip.y - p.y
                // Where the fall's middle is at this depth: off down the wind as it falls.
                let carried = dot(normalize(s.wind), side_dir) * CARRY * max(drop - 60.0, 0.0)
                let side = dot(vec2(p.x - lip.x, p.z - lip.z), side_dir) - carried
                let fi = f32(i) * 13.7
                let px_m = tc * 2.0 / (s.resolution.y * s.focal)
                // The sheet: water still, its strands running down it, breaking up as it goes.
                let sheet_w = width * (0.5 + drop * 0.0016)
                let strands = mix(
                    0.55,
                    smoothstep(0.3, 0.75, noise(vec2(side / 7.0 + fi, drop / 40.0 - s.held * 1.6))),
                    1.0 - smoothstep(3.0, 9.0, px_m),
                )
                let edge = smoothstep(sheet_w, sheet_w * 0.45, abs(side))
                let sheet = edge *
                    smoothstep(-6.0, 12.0, drop) *
                    smoothstep(420.0, 90.0, drop) *
                    mix(0.85, 0.35 + 0.65 * strands, smoothstep(10.0, 160.0, drop))
                // The spray: a plume widening as it falls, billowing, fading out down the wind.
                let plume_w = width * 0.6 + drop * 0.2
                let sinking = s.held * 7.0
                let billow = fbm(vec2(side / 110.0 + fi, (drop - sinking) / 130.0), 4)
                let fine = noise(vec2(side / 28.0 - fi, (drop - sinking * 1.4) / 34.0))
                let lump = mix(
                    billow,
                    billow * (0.6 + 0.8 * fine),
                    1.0 - smoothstep(6.0, 18.0, px_m),
                )
                let across = side / plume_w
                let body = exp(-across * across * 2.2)
                let spray = body *
                    smoothstep(40.0, 320.0, drop) *
                    smoothstep(1100.0, 320.0, drop) *
                    smoothstep(0.38, 0.8, lump + 0.2 * body)
                let a = clamp(sheet * 0.95 + spray * 0.6, 0.0, 0.95) * (1.0 - acc.a)
                if a > 0.001 {
                    // Lit as the world is: a pale matte facing the eye and the sky over it, the
                    // spray's top lighter than its shadowed belly.
                    let n = normalize(-d + vec3(0.0, 0.6 + 0.3 * lump, 0.0))
                    let white = mix(0.7, 1.0, smoothstep(0.0, 200.0, drop))
                    let lit = lit_solid(
                        s,
                        h,
                        view,
                        aerial,
                        dome,
                        smp,
                        p,
                        n,
                        d,
                        vec3(white),
                        1.0,
                        0.0,
                        vec3(0.0),
                        1.0,
                        mix(0.55, 1.0, lump),
                        1.0,
                        0.0,
                    )
                    acc += vec4(lit * a, a)
                    first = min(first, tc)
                }
            }
        }
    }
    (acc, first)
}

// ---- the vista: the rock and the cathedral pinned to the world (`engine::far::Vista`) ---------
//
// Met a few looks a drawing into the screen's own pixels, a spire or a window finer than a pixel
// flickered: each pixel was met afresh only every four to sixteen drawings, all or nothing, and
// what was carried between had to follow every bob of the camera and couldn't be held long.
// Here they're drawn into a picture of their own from a fixed eye, finer than the screen's
// pixels, a band of its rows a drawing (`vista_look`), each texel the mean of its looks; and
// each drawing reads it through its own rays (`far_merge`).

/// The vista's view as a shot of the drawing's: its eye, axes and size, the drawing's light.
pub fn vista_shot(v: Vista, shot: Shot) -> Shot {
    Shot {
        eye: v.eye,
        forward: v.forward,
        right: v.right,
        up: v.up,
        focal: v.focal,
        resolution: vec2(v.size),
        ..shot,
    }
}

/// What the ray through `pf` (texels of the vista's shot `s`) meets of the rock and the
/// cathedral: their light in their air and how much they cover (0 or 1); the marks (log2
/// distance, what, line, weight), all but what premultiplied by the cover; the normal, likewise.
fn isle_look(
    s: Shot,
    h: Heaven,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    field: Texture3d<R32Float>,
    reach: Texture<Rg32Float>,
    meshed: u32,
    pf: vec2,
) -> (vec4, vec4, vec4) {
    let o = s.eye
    let d = ray(s, pf)
    let none = (vec4(0.0), vec4(0.0, SKY, 0.0, 0.0), vec4(0.0))
    let is = sphere(o, d, bounds(), 1.0e5)
    if is.x >= is.y || (OFF & 1) != 0 {
        return none
    }
    let from = if meshed == 1 { march_from(reach, pf, s.resolution, is.x, is.y) } else { is.x }
    if from >= is.y {
        return none
    }
    let t = march_isle(field, o, d, from, is.y)
    if t >= is.y {
        return none
    }
    let id = isle(o + d * t).y
    let (c, l, w, n) = isle_shade(
        s,
        h,
        clouds,
        view,
        aerial,
        dome,
        cloud,
        smp,
        o + d * t,
        d,
        t,
        id,
        pf,
        if meshed == 1 { baked_at(reach, pf, s.resolution, t) } else { vec2(-1.0) },
    )
    (vec4(c, 1.0), vec4(log2(t), id, l, w), vec4(n, 1.0))
}

/// The vista's texels whose turn of `period` this drawing's is (`engine::far::turn_texel`, the
/// `id`th of them) looked at once more: each one's next look, at its own place in it (`stratum`,
/// by how many times the vista has been looked at whole, `seq`: not by its count, which stops at
/// `KEPT` and would put every look after on one spot), added to the mean of those before
/// (`held_*`, the count in the normal's w), into slots of their own (`vista_lay` lays them in).
/// A kernel over those texels alone: drawn as a pass, a pixel's work runs in fours, and each
/// texel's three neighbours, not their turn, would be shaded with it.
@compute(64)
pub fn vista_look(
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    field: Texture3d<R32Float>,
    reach: Texture<Rg32Float>,
    meshed: u32,
    held_colour: Texture<Rgba16Float>,
    held_marks: Texture<Rgba16Float>,
    held_normal: Texture<Rgba16Float>,
    seq: u32,
    side: u32,
    turn: u32,
    period: u32,
    kept: f32,
    once: [vec4],
    colour: mut Slots<vec4>,
    marks: mut Slots<vec4>,
    normal: mut Slots<vec4>,
    id: GlobalId,
) {
    if id.x >= turn_texels(side, period) {
        return
    }
    let q = turn_texel(id.x, side, turn, period)
    let (x, y) = (u32(q.x), u32(q.y))
    let oc = held_colour.load(x, y)
    let om = held_marks.load(x, y)
    let on = held_normal.load(x, y)
    // (Held as at most `kept` looks: fewer while the light is changing, so the new light comes
    // in within a few sweeps, not the half minute all `KEPT` would take.)
    let n = min(on.w, kept - 1.0)
    let (c, m, nn) = isle_look(
        shot,
        Heaven { light, clouds, over: overhead(once) },
        clouds,
        view,
        aerial,
        dome,
        cloud,
        smp,
        field,
        reach,
        meshed,
        stratum(f32(seq), q),
    )
    let k = 1.0 / min(n + 1.0, KEPT)
    let what = if n > 0.0 && om.y > SKY + 0.5 { om.y } else { m.y }
    colour[id] = gathered(oc, c, n)
    marks[id] = vec4(mix(om.x, m.x, k), what, mix(om.z, m.z, k), mix(om.w, m.w, k))
    normal[id] = vec4(mix(on.xyz, nn.xyz, k), min(n + 1.0, KEPT))
}

/// The looks `vista_look` took this drawing laid into the vista, each at its texel: a kernel
/// over the whole vista, the texels not of this turn left as they are.
@compute(8, 8)
pub fn vista_lay(
    colour: [vec4],
    marks: [vec4],
    normal: [vec4],
    side: u32,
    turn: u32,
    period: u32,
    out_colour: mut Texels<Rgba16Float>,
    out_marks: mut Texels<Rgba16Float>,
    out_normal: mut Texels<Rgba16Float>,
    id: GlobalId,
) {
    let q = vec2(f32(id.x), f32(id.y))
    if id.x >= side || id.y >= side || turn_of(q, period) != turn {
        return
    }
    let i = turn_index(q, side, turn, period)
    out_colour.store(id, colour[i])
    out_marks.store(id, marks[i])
    out_normal.store(id, normal[i])
}

/// How many looks a texel carried to a vista aimed afresh counts as (`vista_carry`): enough
/// that the next looks don't jump it, few enough that they soon outweigh it. What's carried is
/// read between the old texels, a little softer each time, and where the depth read through
/// was off, a little wrong; held as all `KEPT`, a re-aim every ten seconds or so at a run
/// would carry that on and on.
const CARRIED: f32 = 8.0

/// The vista aimed afresh from the eye's new place (`now`), each texel what the old one (`was`)
/// held where the ray meets the thing (through the depth it held), so it doesn't start empty.
@fragment
pub fn vista_carry(
    pixel: FragCoord,
    now: Vista,
    was: Vista,
    smp: Sampler,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba16Float>,
) -> Targets3<vec4, vec4, vec4> {
    let d = vista_ray(now, floor(pixel.position.xy) + vec2(0.5))
    let (at, _) = vista_where(was, colour, marks, smp, now.eye, d)
    if at.z < 0.5 {
        return Targets3 { first: vec4(0.0), second: vec4(0.0, SKY, 0.0, 0.0), third: vec4(0.0) }
    }
    // (Carried to a coarser vista: read over the new texel's footprint, as a pixel reads it, so
    // the texels between its reads aren't skipped.)
    if now.size < was.size {
        let px = floor(pixel.position.xy) + vec2(0.5)
        let dx = vista_ray(now, px + vec2(0.25, 0.0)) - d
        let dy = vista_ray(now, px + vec2(0.0, 0.25)) - d
        let (c, m, n, _) = vista_read(was, colour, marks, normal, smp, now.eye, d, dx, dy)
        return Targets3 {
            first: c,
            second: m,
            third: vec4(n.xyz, min(n.w, CARRIED)),
        }
    }
    // (Else through a Catmull-Rom filter, not bilinear: a bilinear read halfway between texels
    // blurs them, and each re-aim would blur the vista more.)
    let size = vec2(was.size)
    let c = sharp_within(colour, smp, at.xy, size)
    let m = sharp_within(marks, smp, at.xy, size)
    let n = sharp_within(normal, smp, at.xy, size)
    Targets3 {
        first: c,
        second: vec4(m.x, vista_what(was, colour, marks, at.xy), m.z, m.w),
        third: vec4(n.xyz, min(n.w, CARRIED)),
    }
}

/// Where in vista `v` the ray from `o` along `d` meets its thing (texels; z, whether it's in
/// the vista), and how far: where the thing's middle would be, then again where the depth the
/// vista holds there puts it.
fn vista_where(
    v: Vista,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    smp: Sampler,
    o: vec3,
    d: vec3,
) -> (vec3, f32) {
    var depth = v.depth
    var at = vista_at(v, o + d * depth)
    if at.z < 0.5 {
        return (at, depth)
    }
    let c0 = colour.sample_level(smp, at.xy / v.size)
    if c0.a > 0.004 {
        let m0 = marks.sample_level(smp, at.xy / v.size)
        let held = exp2(m0.x / c0.a)
        let again = vista_at(v, o + d * held)
        if again.z > 0.5 {
            at = again
            depth = held
        }
    }
    (at, depth)
}

/// What the most covered of the four texels round `at` (texels) is, `SKY` where none is
/// covered; of two as covered, the nearer `at`: by the order they're read, the id at a stone's
/// edge would jump a texel as the camera bobs.
fn vista_what(
    v: Vista,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    at: vec2,
) -> f32 {
    let base = clamp(floor(at - vec2(0.5)), vec2(0.0), vec2(v.size - 2.0))
    let f = clamp(at - vec2(0.5) - base, vec2(0.0), vec2(1.0))
    var what = SKY
    var most = 0.0
    for k in 0..4 {
        let (x, y) = (u32(base.x) + (k & 1), u32(base.y) + (k >> 1))
        let a = colour.load(x, y).a
        let w = (if (k & 1) == 1 { f.x } else { 1.0 - f.x }) * (if (k >> 1) == 1 { f.y } else {
            1.0 - f.y
        })
        let score = a + 0.01 * w
        if a > 0.004 && score > most {
            most = score
            what = marks.load(x, y).y
        }
    }
    what
}

/// What vista `v` holds where the ray from `o` along `d` meets its thing: read where the depth
/// it holds there puts it (premultiplied colour and cover, marks, normal and count), and what
/// it is (`SKY` where nothing). Read over the pixel, not at a point: four bilinear reads a
/// quarter of a pixel each way of the ray (`dx`, `dy`: the rays that far off it, less `d`; 0
/// for one read). One bilinear read at the pixel's middle sharpens and softens the thing as the
/// pixel's middle crosses the texels, and the eye sees that pulse as a shimmer.
fn vista_read(
    v: Vista,
    colour: Texture<Rgba16Float>,
    marks: Texture<Rgba16Float>,
    normal: Texture<Rgba16Float>,
    smp: Sampler,
    o: vec3,
    d: vec3,
    dx: vec3,
    dy: vec3,
) -> (vec4, vec4, vec4, f32) {
    let (at, depth) = vista_where(v, colour, marks, smp, o, d)
    if at.z < 0.5 {
        return (vec4(0.0), vec4(0.0, SKY, 0.0, 0.0), vec4(0.0), SKY)
    }
    let ax = vista_at(v, o + (d + dx) * depth).xy - at.xy
    let ay = vista_at(v, o + (d + dy) * depth).xy - at.xy
    var c = vec4(0.0)
    var m = vec4(0.0)
    var n = vec4(0.0)
    for k in 0..4 {
        let sx = f32(k & 1) * 2.0 - 1.0
        let sy = f32(k >> 1) * 2.0 - 1.0
        let uv = (at.xy + ax * sx + ay * sy) / v.size
        c += colour.sample_level(smp, uv) * 0.25
        m += marks.sample_level(smp, uv) * 0.25
        n += normal.sample_level(smp, uv) * 0.25
    }
    let what = vista_what(v, colour, marks, at.xy)
    (c, vec4(m.x, what, m.z, m.w), n, what)
}

/// How near (m) what the far pass meets must be to stand in front of the vista while it fades.
const NEARER: f32 = 2500.0

/// The far layer the paint reads: the stacks and the far islands as this pass met them
/// (`yon_*`), and the rock and the cathedral as the vista holds them, the nearer over the
/// farther. The marks and normal are the one that covers more of the pixel's. (`shot` the
/// jittered one: the vista is read where this drawing's ray goes.)
@fragment
pub fn far_merge(
    pixel: FragCoord,
    shot: Shot,
    vista: Vista,
    shown: f32,
    smp: Sampler,
    yon_colour: Texture<Rgba16Float>,
    yon_marks: Texture<Rgba16Float>,
    yon_normal: Texture<Rgba8>,
    vista_colour: Texture<Rgba16Float>,
    vista_marks: Texture<Rgba16Float>,
    vista_normal: Texture<Rgba16Float>,
) -> Targets3<vec4, vec4, vec4> {
    let (x, y) = (u32(pixel.position.x), u32(pixel.position.y))
    let fc = yon_colour.load(x, y)
    let fm = yon_marks.load(x, y)
    let fnn = yon_normal.load(x, y)
    let d = ray(shot, pixel.position.xy)
    let (vc, vm, vn, _) = vista_read(
        vista,
        vista_colour,
        vista_marks,
        vista_normal,
        smp,
        shot.eye,
        d,
        ray(shot, pixel.position.xy + vec2(0.25, 0.0)) - d,
        ray(shot, pixel.position.xy + vec2(0.0, 0.25)) - d,
    )
    // (As much of it as is shown: faded in over what the far pass meets as it's laid in, and out
    // as it's put by, not swapped in a drawing.)
    let vc = vc * shown
    let vm = vec4(vm.x * shown, vm.y, vm.z * shown, vm.w * shown)
    if vc.a <= 0.004 {
        return Targets3 { first: fc, second: fm, third: fnn }
    }
    let a = vc.a
    let vmarks = vec4(vm.x / a, vm.y, vm.z / a, vm.w / a)
    // (While it fades in or out the far pass still meets the rock too: two of the same surface,
    // and whichever came out a little nearer would win, the vista not fading in there but
    // popping at the end. So till it's all in, only what's well nearer than the rock (a stack)
    // is in front of it.)
    let near = fc.a > 0.0 && fm.x < vmarks.x && (shown >= 1.0 || exp2(fm.x) < NEARER)
    let c = if near { fc + vc * (1.0 - fc.a) } else { vc + fc * (1.0 - a) }
    let mine = if near { a * (1.0 - fc.a) } else { a }
    let theirs = if near { fc.a } else { fc.a * (1.0 - a) }
    // (The normal's w, how much of what's laid in is the vista's: read through the jittered ray,
    // unlike the far pass's, which its own drawings settle at the pixel's middle. The paint passes
    // it on to the upscaler (`engine::upscale`), whose jitter gathers the vista's edges over the
    // frames as it does the sea's.)
    let jittered = mine / max(mine + theirs, 1.0e-4)
    if mine >= theirs {
        Targets3 {
            first: c,
            second: vmarks,
            third: vec4(normalize(vn.xyz + vec3(0.0, 1.0e-6, 0.0)) * 0.5 + 0.5, jittered),
        }
    } else { Targets3 { first: c, second: fm, third: vec4(fnn.xyz, jittered) } }
}
