// What the skiff does to the water: the slick its hull leaves and the ripples it rocks out; its
// wake (two arms spreading at the Kelvin angle, the churned trail straight astern, the bow's
// wave); the lip of broken water along its waterline; and the spray its bow throws as it runs,
// torn downwind by the gale. The sea itself is `engine::ocean` and `paint::sea_shade`, which
// calls these.

use look::{Shot, cells, fbm, hash2, noise}
use sea::SEA
use skiff::hull_off

/// How far the skiff's way has it from drifting (0) to running (1): its wake whitens, lengthens
/// and its bow throws spray.
fn running(s: Shot) -> f32 {
    smoothstep(1.5, 8.5, s.speed)
}

/// Foam's lace at `w` (m, where the water rests): clots of froth and the bubbles round them,
/// in drifts, warped and broken so it's never a net's mesh. In [0, 1].
pub fn lace_at(w: vec2) -> f32 {
    let warp = vec2(noise(w * 0.9 + vec2(2.1, 8.3)), noise(w * 0.9 + vec2(6.7, 3.9))) - vec2(0.5)
    let c = cells(w * 9.0 + warp * 4.0)
    // (A bubble's blot round each cell's point, sized by a noise, so they clot and scatter.)
    let size = 0.08 + 0.35 * noise(w * 6.0 + vec2(5.0)) * noise(w * 1.7)
    let blots = 1.0 - smoothstep(size * 0.4, size, c.x)
    let drifts = smoothstep(0.4, 0.7, fbm(w * 0.6 + warp, 3))
    blots * drifts
}

/// The water the hull has smoothed and rocked at `xz` (`n` its normal there, `rest` where its
/// water rests): astern, its slick, a lane of smoother water as wide as the hull, widening and
/// fading, longer the faster it runs; round it, the ripples it rocks out, the more as it slaps
/// down. The normal as it leaves it, and the foam of the spray falling back either side of the
/// bow as it runs.
pub fn stirred(s: Shot, xz: vec2, rest: vec2, n: vec3) -> (vec3, f32) {
    let bx = normalize(vec2(s.boat_x.x, s.boat_x.z))
    let bz = normalize(vec2(s.boat_z.x, s.boat_z.z))
    let rel = xz - vec2(s.boat.x, s.boat.z)
    let q = vec2(dot(rel, bx), dot(rel, bz))
    let way = clamp(abs(s.speed) / 3.0, 0.0, 1.0)
    let run = running(s)
    let astern = q.y < -1.5 && q.y > -40.0 && abs(q.x) < 4.0
    if dot(q, q) > 64.0 && !astern {
        return (n, 0.0)
    }
    var tilt = vec2(0.0)
    let behind = max(-q.y - 1.6, 0.0)
    let lane = 0.45 + 0.06 * behind
    let calm = (1.0 - smoothstep(lane * 0.5, lane, abs(q.x))) *
        smoothstep(0.0, 1.0, behind) *
        exp(-behind / (5.0 + 8.0 * way + 6.0 * run)) *
        smoothstep(0.0, 0.4, way) *
        // (In patches, and less at a run: a slick ruled straight astern mirrors the sky as a
        // glowing bar.)
        (0.35 + 0.65 * noise(rest * 0.6)) *
        (1.0 - 0.6 * run) *
        0.6
    let along = q.y - clamp(q.y, -1.7, 1.7)
    let out = vec2(q.x, along)
    let off_hull = length(out) - 0.5
    let away = out / max(length(out), 1.0e-3)
    for k in 0..3 {
        let r_k = 0.1 + fract(s.held * 0.3 + f32(k) / 3.0) * 2.6
        let x = off_hull - r_k
        let train = exp(-x * x / 0.003) * sin(x * 80.0)
        tilt += away * (train * (0.05 + 0.1 * s.slap) * smoothstep(2.7, 0.3, r_k))
    }
    tilt *= step(0.0, off_hull) * (1.0 - 0.7 * run)
    // Where the bow's spray falls back, either side and a little aft of it: a scatter of white
    // that's left astern as it runs.
    let fall = vec2(abs(q.x) - 1.1 - 0.5 * run, q.y - 0.2 + 1.2 * run)
    let splash = exp(-dot(fall, fall) / (0.35 + 0.6 * run)) *
        smoothstep(
            0.35,
            0.75,
            lace_at(rest * 1.9) + 0.25 * noise(rest * 3.0 + vec2(s.held * 2.0)),
        ) *
        run *
        0.8
    let world_tilt = bx * tilt.x + bz * tilt.y
    let m = normalize(n + vec3(world_tilt.x, 0.0, world_tilt.y))
    (normalize(mix(m, vec3(y: 1.0), calm * 0.55)), splash)
}

/// The skiff's marks at `p` on the sea (`xz`, `rest` where its water rests): its wake (white),
/// the lip of broken water at its waterline (foam), and how far `p` is out from the hull's side.
pub fn marks(s: Shot, p: vec3, xz: vec2, rest: vec2) -> (f32, f32, f32) {
    let rel = p - s.boat
    let along = dot(rel, s.boat_z)
    let across = dot(rel, s.boat_x)
    // Under way, the wake runs longer and whiter, and the bow throws a wave off each side. The
    // wake lies along the way the skiff came: turning, an arc (its centre `bend` m to the side the
    // bow swings), read as how far back along it (`back`) and how far off it (`off`).
    let way = clamp(abs(s.speed) / 3.0, 0.0, 1.0)
    let run = running(s)
    let bend = s.speed / (if abs(s.turn) < 1.0e-4 { 1.0e-4 } else { s.turn })
    var back = -along
    var off = across
    if abs(bend) < 400.0 && abs(bend) > 3.0 {
        let u = vec2(across - bend, along)
        let b = vec2(-sign(bend), 0.0)
        let phi = sign(bend) * atan2(b.x * u.y - b.y * u.x, dot(b, u))
        back = abs(bend) * phi
        off = length(u) - abs(bend)
    }
    let behind_ = max(back - 2.0, 0.0)
    // Its arms broken into foam as they spread: patches, dashes, thinning and fading; running,
    // whiter and lasting further astern.
    // (Froth in clots riding the water, never soft blots: value noise laid along the wake
    // reads as squares.)
    let froth = lace_at(rest * 1.6 + vec2(7.0, 3.0))
    let broken = smoothstep(0.08, 0.5, froth * (0.6 + 0.8 * noise(rest * 0.35))) *
        (1.0 - 0.6 * smoothstep(4.0, 30.0, behind_) * (1.0 - froth))
    // (Each arm a train of short wavelets slanting off it, as a wake's are, never one ruled line.)
    let wavelets = smoothstep(
        0.1,
        0.9,
        0.5 + 0.5 * sin(behind_ * 5.0 + abs(off) * 3.0 - s.held * 4.0 + 6.0 * noise(rest * 0.45)),
    )
    let arms = exp(-pow(abs(off) - behind_ * 0.36 - 0.4, 2.0) / (0.03 + behind_ * 0.02)) *
        smoothstep(0.0, 1.0, behind_) *
        smoothstep(7.0 + 6.0 * way + 22.0 * run, 1.0, behind_) *
        (0.6 + 0.5 * run) *
        mix(broken, 1.0, 0.45 * run * exp(-behind_ / 10.0)) *
        mix(1.0, wavelets, 0.4)
    // Straight astern, the churned water it leaves: lace on the water that rides with it (laid
    // where it rests), in patches that thin as it widens and fades; running, a broad white
    // furrow of it close astern.
    let churn = 0.16 + behind_ * 0.04 + 0.08 * run
    let trail = exp(-off * off / churn) *
        smoothstep(0.0, 0.8, behind_) *
        exp(-behind_ / (3.0 + 9.0 * way + 12.0 * run)) *
        smoothstep(
            0.15 - 0.06 * run * exp(-behind_ / 8.0),
            0.7 - 0.15 * run * exp(-behind_ / 8.0),
            lace_at(rest * 1.6) * (0.5 + fbm(rest * 0.7, 2)),
        )
    // The bow's wave, peeling off either side; running, it breaks white along the forward third
    // of the hull where it lifts onto the plane.
    let from_bow = max(1.9 - along, 0.0)
    let bow_wave = exp(
        -pow(abs(across) - 0.12 - from_bow * (0.4 - 0.1 * run), 2.0) / (0.012 + 0.03 * run),
    ) *
        smoothstep(0.0, 0.3, from_bow) *
        // (Along the hull only, peeling off it: carried on astern it drew a bar of white
        // straight down the screen behind the skiff.)
        smoothstep(3.9, 2.8, from_bow) *
        smoothstep(0.3 - 0.15 * run, 0.55, noise(vec2(along * 3.0 - s.held * 4.0, across * 3.0))) *
        way
    // (Thinned under the eye: so near, a pixel's footprint is a hand across and the froth blurs to
    // soft glowing pools, as if on the lens.)
    let near_eye = smoothstep(3.0, 7.0, length(p - s.eye))
    let wake = max(
        max(arms, trail) * step(0.0, back) * smoothstep(0.0, 0.5, way) * near_eye,
        bow_wave * (0.7 + 0.3 * run),
    )
    // Where the sea meets the hull: a lip of churned water along its waterline, out past the
    // gunwale's flare so the eye above sees it, wider and whiter as the skiff makes way or slaps
    // down.
    let wl = hull_off(s, p)
    let fore = clamp(dot(p - s.boat, s.boat_z) / 2.2, 0.0, 1.0)
    let lip_w = (0.05 + 0.1 * way + 0.12 * s.slap + 0.2 * fore * fore * (0.3 + way) + 0.12 * run) *
        (0.55 + 0.9 * noise(xz * 2.2 + vec2(s.held * 0.4, 0.0)))
    let ragged = wl + 0.06 * (noise(xz * 5.0 + vec2(s.held * 0.7)) - 0.5)
    let lip = (1.0 - smoothstep(lip_w * 0.35, lip_w, ragged)) *
        step(-0.05, wl) *
        smoothstep(
            0.42 - 0.2 * fore - 0.15 * run,
            0.68,
            noise(xz * 9.0 + vec2(s.held * 2.0, -s.held * 1.5)) * 0.55 +
                noise(xz * 26.0 + vec2(-s.held, s.held * 0.8)) * 0.3 +
                noise(xz * 60.0) * 0.15,
        )
    (wake, lip * (0.6 + 0.4 * max(way, s.slap)), wl)
}

/// A drop of water `r` m across, flying from `p0` to `p1` while the frame's shutter is open (so
/// drawn as the short streak it sweeps), as the ray `o` + `d` t meets it before `hit`: drawn at
/// least a pixel wide (a pixel `px_k` t m at t), as much fainter as it's smaller than that, in
/// its light `lit`. Its light (premultiplied) and cover.
fn drop(o: vec3, d: vec3, hit: f32, p0: vec3, p1: vec3, r: f32, px_k: f32, lit: vec3) -> vec4 {
    let e = p1 - p0
    let w = o - p0
    let b = dot(d, e)
    let c = max(dot(e, e), 1.0e-8)
    let u = clamp((dot(e, w) - b * dot(d, w)) / max(c - b * b, 1.0e-8), 0.0, 1.0)
    let p = p0 + e * u
    let tc = dot(p - o, d)
    if tc <= 0.0 || tc >= hit {
        return vec4(0.0)
    }
    let dist = length(p - o - d * tc)
    let drawn = max(r, tc * px_k * 0.6)
    // (A streak's light spread down its length: the longer, the fainter.)
    let long = 1.0 + sqrt(c) / max(drawn * 2.0, 1.0e-4)
    let cover = (1.0 - smoothstep(drawn * 0.3, drawn * 1.1, dist)) *
        min(r * r / (drawn * drawn) * 3.0 / sqrt(long), 1.0)
    vec4(lit * cover, cover)
}

/// How many drops the bow's sheets tear into at once, and how long each flies (s).
const DROPS: u32 = 24
const FLIGHT: f32 = 0.8

/// The bow's spray, in front of what the ray met at `hit`: as the skiff runs, a sheet of water
/// peeled off either side of its forward sections (the lee one the higher, where the hull's
/// pressed into the sea), flung up and out and aft, thin and glassy where it leaves the hull,
/// tearing into streaks and then drops at its crest, and the drops it tears torn downwind by the
/// gale. Each drop streaked by its flight through the frame. In the light `lit`. Its light
/// (premultiplied) and cover.
pub fn spray(s: Shot, lit: vec3, o: vec3, d: vec3, hit: f32) -> vec4 {
    let run = running(s)
    let thrown = max(
        max(run * (0.1 + 0.9 * s.power), s.slap * smoothstep(0.5, 2.0, s.speed) * (0.3 + 0.7 * s.power)),
        s.jolt,
    )
    if thrown <= 0.0 {
        return vec4(0.0)
    }
    // (Only for rays that pass near the skiff's bow.)
    let bow = s.boat + s.boat_z * 1.0 + vec3(y: 0.4) - o
    let tc = dot(bow, d)
    if tc <= 0.0 || length(bow - d * tc) > 3.5 {
        return vec4(0.0)
    }
    let up = vec3(y: 1.0)
    let lee_side = if s.boom.x > 0.0 { 1.0 } else { -1.0 }
    var acc = vec4(0.0)
    // The sheets: each a surface leaning out from the hull's side, read where the ray crosses
    // it as (how far aft along it, how high up it).
    for k in 0..2 {
        let side = if k == 0 { lee_side } else { -lee_side }
        // (Pulsing as the bow meets each wave, never one steady card.)
        let pulse = 0.55 + 0.7 * noise(vec2(s.held * 2.6 + f32(k) * 5.0, 1.0))
        let strong = thrown * (if k == 0 { 1.0 } else { 0.5 }) * (0.75 + 0.35 * s.gust) * pulse
        let root = s.boat + s.boat_x * (side * 0.34) + s.boat_z * 1.55 - s.boat_y * 0.12
        let aft = normalize(-s.boat_z + s.boat_x * (side * 0.55))
        let rise = normalize(up + s.boat_x * (side * 0.4))
        let n = normalize(cross(aft, rise))
        let dn = dot(d, n)
        if abs(dn) > 1.0e-4 {
            let t = dot(root - o, n) / dn
            if t > 0.0 && t < hit {
                let rel = o + d * t - root
                let a = dot(rel, aft)
                let b = dot(rel, rise)
                let long = 1.2 + 2.6 * strong
                let x = a / long
                // (Its crest an arc: up from the hull, falling back aft.)
                let crest = (0.35 + 1.25 * strong) * 3.2 * x * (1.0 - x) * (1.0 - 0.3 * x)
                if x > 0.0 && x < 1.0 && b > -0.05 && b < crest + 0.1 {
                    // (Streaked along its flight, as a sheet of water thrown fast is.)
                    let flow = vec2(a * 2.2 - s.held * s.speed * 0.6, b * 16.0 + a * 3.0)
                    let streaks = noise(flow) * 0.55 +
                        noise(flow * vec2(2.3, 2.9) + vec2(4.0)) * 0.45
                    let up_k = clamp(b / max(crest, 0.02), 0.0, 1.2)
                    // (Glassy and whole near the hull, streaked higher, in drops at its crest.)
                    let torn = smoothstep(0.2 + 0.4 * up_k, 0.55 + 0.4 * up_k, streaks)
                    let edge = 1.0 - smoothstep(0.45, 1.0, up_k + 0.3 * (streaks - 0.5))
                    let ends = smoothstep(0.0, 0.25, x) * smoothstep(1.0, 0.45, x)
                    let cover = torn *
                        edge *
                        ends *
                        smoothstep(-0.05, 0.35, b) *
                        smoothstep(s.boat.y - 0.3, s.boat.y + 0.35, o.y + d.y * t) *
                        0.55 *
                        min(strong * 1.6, 1.0)
                    acc = acc * (1.0 - cover) + vec4(lit * (0.85 + 0.3 * streaks) * cover, cover)
                }
            }
        }
    }
    // The drops torn off its crest, flying on and torn downwind.
    let px_k = 2.0 / (s.resolution.y * s.focal)
    let air = vec3(SEA.wind.x, 0.0, SEA.wind.y) * SEA.speed - s.boat_z * s.speed
    let pull = up * -9.81 + air * 0.55
    // (A short shutter: long streaks of one length read as dashes of type, not water.)
    let open = 0.012
    for i in 0..DROPS {
        let fi = f32(i)
        let h1 = hash2(vec2(fi, 3.7))
        let h2 = hash2(vec2(fi + 7.0, 1.3))
        let h3 = hash2(vec2(fi + 13.0, 9.1))
        let cycle = s.held / FLIGHT + h1
        let age = fract(cycle) * FLIGHT
        let born = floor(cycle)
        let h4 = hash2(vec2(fi, born))
        let side = if hash2(vec2(born, fi + 3.0)) > 0.33 { lee_side } else { -lee_side }
        let from = s.boat +
            s.boat_x * (side * (0.6 + 0.3 * h4)) +
            s.boat_z * (0.9 + 0.6 * h4) +
            up * (0.2 + 0.4 * thrown)
        let v0 = s.boat_x * (side * (1.2 + 2.4 * h2) * thrown) +
            up * ((1.0 + 2.0 * h3) * thrown) -
            s.boat_z * (0.6 * s.speed * 0.2)
        let t0 = max(age - open, 0.0)
        let p1 = from + v0 * age + pull * (0.5 * age * age)
        let p0 = from + v0 * t0 + pull * (0.5 * t0 * t0)
        if p1.y > s.boat.y - 0.45 && p1.y < s.boat.y + 0.9 && h4 < thrown * 0.45 {
            let r = 0.005 + 0.012 * (1.0 - h2) * (1.0 - h2)
            let dr = drop(o, d, hit, p0, p1, r, px_k, lit * (0.45 + 0.55 * h3)) * 0.75
            acc = acc * (1.0 - dr.a) + dr
        }
    }
    vec4(acc.rgb, min(acc.a, 1.0))
}


