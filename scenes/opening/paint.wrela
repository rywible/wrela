// The first pass: each pixel's ray meets the sea, the skiff, the rock and its cathedral, or the
// engine's sky, and is lit in 3D as the engine lights its world: the sun through the air
// (`engine::light`), the clouds' shadows, soft shadows and ambient occlusion from the distance
// fields, the sky's light and its reflection, and the air between the eye and what it sees
// (`engine::light::hazed`). Beside the colour it writes what the ink reads: how far, what it is,
// a line field, the line's weight, the normal and the moment's energy.

use look::{GILT, ROCK, SEA, SKIFF, SKY, STONE, Shot, band, noise, ray}
use sea::{height, strokes}
use sea::normal as sea_normal
use isle::{bounds, isle, isle_material, isle_normal}
use skiff::{dry, skiff, skiff_material, skiff_normal}
use engine::light::{Light, Lit, hazed, sun_reflection, world}
use engine::sky::{Clouds, cloud_shadow, clouded_sky, sky_with_clouds}
use std::gpu::{FragCoord, Rgba16Float, Sampler, Targets3, Texture, Texture3d}
use std::math::PI

/// What the sky's light reads beside its textures: the light, and where the clouds are.
pub struct Heaven: Copy {
    light: Light,
    clouds: Clouds,
}

/// Where the ray from `o` along `d` meets the sea (`d` going down), or `far`.
fn trace_sea(s: Shot, o: vec3, d: vec3, far: f32) -> f32 {
    if d.y >= -0.0005 {
        return far
    }
    var t = (o.y - 0.9) / -d.y
    if t > far {
        return far
    }
    for _ in 0..10 {
        let p = o + d * t
        let detail = clamp(1.0 - t / 160.0, 0.0, 1.0)
        let f = p.y - height(vec2(p.x, p.z), s.held, detail)
        t += f / max(-d.y, 0.02) * 0.6
    }
    min(t, far)
}

fn march_skiff(s: Shot, o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 80 && t < hi {
        let h = skiff(s, o + d * t)
        if h < 0.002 {
            hit = t
            t = hi
        } else {
            t += h * 0.8
        }
        i += 1
    }
    hit
}

fn march_isle(o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 220 && t < hi {
        let h = isle(o + d * t).x
        if h < t * 0.00025 {
            hit = t
            t = hi
        } else {
            t += h * 0.8
        }
        i += 1
    }
    hit
}

/// Where a ray from `o` along `d` meets a sphere `b` (centre, radius): its near and far
/// distances, or (far, far).
fn sphere(o: vec3, d: vec3, b: vec4, far: f32) -> vec2 {
    let oc = o - b.xyz
    let k = dot(oc, d)
    let c = dot(oc, oc) - b.w * b.w
    let h = k * k - c
    if h < 0.0 {
        return vec2(far)
    }
    let q = sqrt(h)
    vec2(max(-k - q, 0.0), -k + q)
}

/// How much of the sun reaches `p` past the isle: a soft shadow marched toward it.
fn isle_shadow(p: vec3, l: vec3, start: f32) -> f32 {
    var t = start
    var lit = 1.0
    var i = 0
    while i < 64 && t < 1800.0 && lit > 0.02 {
        let h = isle(p + l * t).x
        lit = min(lit, 10.0 * h / t)
        t += clamp(h, 1.5, 60.0)
        i += 1
    }
    clamp(lit, 0.0, 1.0)
}

/// How much of the sky reaches `p` on the isle, facing `n`: five taps out along its normal.
fn isle_ao(p: vec3, n: vec3) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..6 {
        let h = 4.0 * f32(i * i)
        hidden += w * max(h - isle(p + n * h).x, 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.55, 0.0, 1.0)
}

fn skiff_shadow(s: Shot, p: vec3, l: vec3) -> f32 {
    var t = 0.02
    var lit = 1.0
    for _ in 0..24 {
        let h = skiff(s, p + l * t)
        lit = min(lit, 12.0 * h / t)
        t += clamp(h, 0.02, 0.4)
    }
    clamp(lit, 0.0, 1.0)
}

fn skiff_ao(s: Shot, p: vec3, n: vec3) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..5 {
        let h = 0.04 * f32(i * i)
        hidden += w * max(h - skiff(s, p + n * h), 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.6, 0.0, 1.0)
}

/// A solid surface's light, as the engine's world takes it (`engine::light::world`): the sun
/// through `sun` of shadow, the sky's light over it (`ao` of it reaching), its reflection, and
/// what it gives itself; seen from the eye through the air.
fn lit_solid(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    n: vec3,
    d: vec3,
    albedo: vec3,
    rough: f32,
    metal: f32,
    glow: vec3,
    sun: f32,
    ao: f32,
) -> vec3 {
    let up = vec3(y: 1.0)
    // The sky's light on it: the sky toward its normal, lifted toward the zenith, and the sea's
    // light from below.
    let skyward = clouded_sky(view, h.light, normalize(n + up * 0.6), dome, smp)
    let below = h.light.sun_colour * vec3(0.03, 0.05, 0.06) * max(-n.y, 0.0)
    let sky = (skyward * PI * (0.2 + 0.25 * max(n.y, 0.0)) + below) * (0.25 + 0.75 * ao * ao)
    let r = d - 2.0 * dot(d, n) * n
    let reflected = clouded_sky(view, h.light, normalize(vec3(r.x, abs(r.y), r.z)), dome, smp) * ao
    let lit = Lit {
        albedo,
        n,
        sun,
        sky,
        through: vec3(0.0),
        rough,
        metallic: metal,
        reflected,
        glint: 1.0,
    }
    // The air between, eased: the isle keeps its colour and its form across the 3 km of it.
    let raw = world(h.light, lit, p, s.eye) + glow
    mix(raw, hazed(aerial, smp, h.light, raw, p, s.eye), 0.45)
}

/// The sea at `p`, seen along `d` from `t` away: its light, line field, weight, normal and energy.
fn sea_shade(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    d: vec3,
    t: f32,
) -> (vec3, f32, f32, vec3, f32) {
    let detail = clamp(1.0 - t / 160.0, 0.0, 1.0)
    let e = max(0.06, t * 0.012)
    let xz = vec2(p.x, p.z)
    // Far off, the sea's normal settles toward the vertical, as its waves fall under a pixel.
    let n = normalize(
        mix(sea_normal(xz, s.held, detail, e), vec3(y: 1.0), clamp(t / 900.0, 0.0, 0.8)),
    )
    let wave = height(xz, s.held, detail)
    let l = h.light.sun
    let v = -d
    let nv = max(dot(n, v), 0.0)
    // What reaches it of the sun: the clouds' shadow and the skiff's.
    let near = skiff(s, p)
    let boat_shadow = if near < 4.0 { skiff_shadow(s, p + vec3(0.0, 0.02, 0.0), l) } else { 1.0 }
    let sun = cloud_shadow(h.clouds, cloud, smp, p) * boat_shadow
    // The reflected sky and clouds, Fresnel's share of it (water's F0, 0.02), and the sun's glint.
    var r = d - 2.0 * dot(d, n) * n
    r.y = abs(r.y)
    let fresnel = 0.02 + 0.98 * pow(1.0 - nv, 5.0)
    // A rough sea doesn't mirror the clouds: what it reflects is part the sky toward the
    // reflection, part the sky's mean light, more of the mean far off where the waves under a
    // pixel turn every way.
    let mirrored = sky_with_clouds(view, h.light, r, dome, smp).rgb
    let spread = clouded_sky(view, h.light, normalize(r + vec3(0.0, 0.5, 0.0)), dome, smp)
    let reflected = mix(mirrored, spread, 0.35 + 0.4 * (1.0 - detail))
    let glint = h.light.sun_colour *
        sun_reflection(n, l, v, 0.12 + 0.35 * clamp(t / 300.0, 0.0, 1.0), 0.02) *
        sun
    // The light that comes back up out of the water: deep blue-green, brighter through the
    // crests lit from behind.
    let sky_up = clouded_sky(view, h.light, vec3(y: 1.0), dome, smp) * PI
    let body = vec3(0.006, 0.030, 0.038) * (h.light.sun_colour * max(l.y, 0.0) * sun + sky_up)
    let behind = pow(max(dot(normalize(vec3(-d.x, 0.0, -d.z)), -l) * 0.5 + 0.5, 0.0), 4.0)
    let through = vec3(0.004, 0.035, 0.03) *
        h.light.sun_colour *
        sun *
        behind *
        max(wave, 0.0) *
        detail
    var c = (body + through) * (1.0 - fresnel) + reflected * fresnel + glint
    // Foam where the sea meets the skiff, lit as a white surface is.
    let foam = band(-near, -0.05 - 0.07 * noise(xz * 4.0 + vec2(s.held * 3.0)), 0.015)
    let foam_light = vec3(0.8) * (h.light.sun_colour * max(dot(n, l), 0.0) * sun + sky_up) / PI
    c = mix(c, foam_light, foam * 0.85)
    // The crests' ink strokes and pale lips, light: the ink sits on the water's form.
    let footprint = t * 2.0 / (s.resolution.y * s.focal)
    let crest_ink = strokes(xz, s.held, footprint, d, wave) * clamp(1.0 - t / 70.0, 0.0, 1.0)
    c = mix(c, c * 1.6 + vec3(0.02, 0.04, 0.045), crest_ink.y * 0.35)
    c = mix(c, c * 0.35, crest_ink.x * 0.45)
    // The bow's cut: where the ink frays, more when it slaps down.
    let bow = clamp(dot(p - s.boat, s.boat_z) / 2.2, 0.0, 1.0)
    let cut = exp(-max(near, 0.0) / (0.18 + 0.25 * s.slap)) * (0.15 + 0.25 * bow + 0.45 * s.slap)
    let line = 0.5 - foam
    let hazy = hazed(aerial, smp, h.light, c, p, s.eye)
    (hazy, line, detail * 0.6 + foam, n, cut)
}

@fragment
pub fn paint(
    pixel: FragCoord,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let h = Heaven { light, clouds }
    let px = pixel.position.xy
    let d = ray(s, px)
    let o = s.eye
    let far = 1.0e5
    var t = far
    var id = SKY
    let ts = trace_sea(s, o, d, far)
    if ts < far {
        t = ts
        id = SEA
    }
    let bs = sphere(o, d, vec4(s.boat + s.boat_y * 0.3, 3.2), far)
    // The sea inside the skiff isn't there: the ray goes on to the hull.
    if id == SEA && dry(s, o + d * t) {
        t = far
        id = SKY
    }
    if bs.x < t {
        let tb = march_skiff(s, o, d, bs.x, min(bs.y, t))
        if tb < min(bs.y, t) {
            t = tb
            id = SKIFF
        }
    }
    let is = sphere(o, d, bounds(), far)
    if is.x < t {
        let ti = march_isle(o, d, is.x, min(is.y, t))
        if ti < min(is.y, t) {
            t = ti
            id = isle(o + d * ti).y
        }
    }
    var c = vec3(0.0)
    var line = 1.0
    var weight = 0.0
    var n = vec3(y: 1.0)
    var energy = 0.0
    let p = o + d * t
    if id == SKY {
        let sky = sky_with_clouds(view, light, d, dome, smp)
        c = sky.rgb
        line = 0.45 - sky.a
        n = -d
    } else if id == SEA {
        let (sc, sl, sw, sn, se) = sea_shade(s, h, view, aerial, dome, cloud, smp, p, d, t)
        c = sc
        line = sl
        weight = sw
        n = sn
        energy = se
    } else if id == SKIFF {
        n = skiff_normal(s, p)
        let (albedo, rough, seam) = skiff_material(s, p, n)
        let sun = skiff_shadow(s, p + n * 0.01, light.sun) * cloud_shadow(clouds, cloud, smp, p)
        let ao = skiff_ao(s, p, n)
        c = lit_solid(
            s,
            h,
            view,
            aerial,
            dome,
            smp,
            p,
            n,
            d,
            albedo,
            rough,
            0.0,
            vec3(0.0),
            sun,
            ao,
        )
        line = seam
        weight = 0.8
        energy = s.slap * 0.35
    } else {
        n = isle_normal(p, max(0.3, t * 0.0007))
        let (albedo, rough, metal, glow, l) = isle_material(p, n, id)
        let sun = isle_shadow(p + n * 2.0, light.sun, 2.0) * cloud_shadow(clouds, cloud, smp, p)
        let ao = isle_ao(p, n)
        c = lit_solid(s, h, view, aerial, dome, smp, p, n, d, albedo, rough, metal, glow, sun, ao)
        line = l
        weight = if id == ROCK { 0.22 } else { 0.28 }
    }
    // The cathedral's shine: a warm light held in the air round it, far off, over all but the
    // skiff.
    if id != SKIFF && t > 400.0 {
        let k = max(dot(d, s.glow), 0.0)
        let over = if id == SKY || id == SEA { 1.0 } else { 0.15 }
        c += light.sun_colour *
            vec3(1.0, 0.78, 0.45) *
            (0.1 * pow(k, 60.0) + 0.3 * pow(k, 500.0)) *
            over
    }
    Targets3 {
        first: vec4(c, 1.0),
        second: vec4(log2(max(t, 0.01)), id, line, weight),
        third: vec4(n * 0.5 + 0.5, clamp(energy, 0.0, 1.0)),
    }
}
