// The first pass: each pixel's ray meets the sea, the skiff, the rock and its cathedral, or the
// engine's sky, and is lit in 3D as the engine lights its world: the sun through the air
// (`engine::light`), the clouds' shadows, soft shadows and ambient occlusion from the distance
// fields, the sky's light and its reflection, and the air between the eye and what it sees
// (`engine::light::hazed`). Beside the colour it writes what the ink reads: how far, what it is,
// a line field, the line's weight, the normal and the moment's energy.

use look::{GILT, ISLE, ROCK, SEA, SKIFF, SKY, STONE, Shot, band, noise, noise3, ray}
use sea::{height, strokes}
use sea::normal as sea_normal
use isle::{bounds, isle, isle_material, isle_normal}
use skiff::{dry, paddle, skiff, skiff_material, skiff_normal}
use engine::light::{Light, Lit, hazed, sun_reflection, world}
use engine::light::sky as clear_sky
use engine::sky::{Clouds, cloud_shadow, clouded_sky, sky_with_clouds}
use std::gpu::{FragCoord, Rgba16Float, Sampler, Targets3, Texture, Texture3d}
use std::math::PI

/// What the sky's light reads beside its textures: the light, and where the clouds are.
pub struct Heaven: Copy {
    light: Light,
    clouds: Clouds,
}

/// The sky along `d`, with its clouds (their cover in alpha); the clouds lost in the air low on
/// the horizon, where they'd be sixty kilometres off and more (the cloud field's far repeats).
fn heaven(
    view: Texture<Rgba16Float>,
    light: Light,
    d: vec3,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
) -> vec4 {
    let cloudy = sky_with_clouds(view, light, d, dome, smp)
    let lost = smoothstep(0.034, 0.058, d.y)
    if lost >= 1.0 {
        return cloudy
    }
    let clear = clear_sky(view, smp, light, normalize(vec3(d.x, max(d.y, 0.0), d.z)))
    vec4(mix(clear, cloudy.rgb, lost), cloudy.a * lost)
}

/// Where the ray from `o` along `d` meets the sea (`d` going down), or `far`.
fn trace_sea(s: Shot, o: vec3, d: vec3, far: f32) -> f32 {
    if d.y >= -0.0005 {
        return far
    }
    var t = (o.y - 0.9) / -d.y
    if t > far {
        return far
    }
    // (The waves the shading reads, no more: a short wave the trace met and the shading didn't
    // only speckles. Grazing, the steps are held short so the first crest is the one found.)
    for _ in 0..12 {
        let p = o + d * t
        let detail = clamp(1.0 - t / 60.0, 0.0, 1.0)
        let f = p.y - height(vec2(p.x, p.z), s.held, detail)
        t += f / max(-d.y, 0.06) * 0.6
    }
    min(t, far)
}

fn march_skiff(s: Shot, o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 80 && t < hi {
        let h = skiff(s, o + d * t)
        if h < 0.002 {
            hit = t
            t = hi
        } else {
            t += h * 0.8
        }
        i += 1
    }
    hit
}

fn march_isle(o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 320 && t < hi {
        let h = isle(o + d * t).x
        if h < t * 0.0001 {
            hit = t
            t = hi
        } else {
            t += h * 0.8
        }
        i += 1
    }
    hit
}

/// The isle met coarsely (for its reflection, where the sea blurs it): 90 steps, a loose hit.
fn march_coarse(o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 90 && t < hi {
        let h = isle(o + d * t).x
        if h < t * 0.002 {
            hit = t
            t = hi
        } else {
            t += h
        }
        i += 1
    }
    hit
}

/// Where a ray from `o` along `d` meets a sphere `b` (centre, radius): its near and far
/// distances, or (far, far).
fn sphere(o: vec3, d: vec3, b: vec4, far: f32) -> vec2 {
    let oc = o - b.xyz
    let k = dot(oc, d)
    let c = dot(oc, oc) - b.w * b.w
    let h = k * k - c
    if h < 0.0 {
        return vec2(far)
    }
    let q = sqrt(h)
    vec2(max(-k - q, 0.0), -k + q)
}

/// How much of the sun reaches `p` past the isle: a soft shadow marched toward it.
fn isle_shadow(p: vec3, l: vec3, start: f32) -> f32 {
    var t = start
    var lit = 1.0
    var i = 0
    while i < 72 && t < 4000.0 && lit > 0.02 {
        let h = isle(p + l * t).x
        lit = min(lit, 10.0 * h / t)
        t += clamp(h, 1.5, 120.0)
        i += 1
    }
    clamp(lit, 0.0, 1.0)
}

/// How much of the sky reaches `p` on the isle, facing `n`: five taps out along its normal.
fn isle_ao(p: vec3, n: vec3) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..6 {
        let h = 4.0 * f32(i * i)
        hidden += w * max(h - isle(p + n * h).x, 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.55, 0.0, 1.0)
}

fn skiff_shadow(s: Shot, p: vec3, l: vec3) -> f32 {
    var t = 0.02
    var lit = 1.0
    for _ in 0..24 {
        let h = skiff(s, p + l * t)
        lit = min(lit, 12.0 * h / t)
        t += clamp(h, 0.02, 0.4)
    }
    clamp(lit, 0.0, 1.0)
}

fn skiff_ao(s: Shot, p: vec3, n: vec3) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..5 {
        let h = 0.04 * f32(i * i)
        hidden += w * max(h - skiff(s, p + n * h), 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.6, 0.0, 1.0)
}

/// A solid surface's light, as the engine's world takes it (`engine::light::world`): the sun
/// through `sun` of shadow, the sky's light over it (`ao` of it reaching), its reflection, and
/// what it gives itself; seen from the eye through the air.
fn lit_solid(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    n: vec3,
    d: vec3,
    albedo: vec3,
    rough: f32,
    metal: f32,
    glow: vec3,
    sun: f32,
    ao: f32,
    haze: f32,
    glint: f32,
) -> vec3 {
    let up = vec3(y: 1.0)
    // The sky's light on it: the sky toward its normal, lifted toward the zenith, and the sea's
    // light from below.
    // (The clear sky's, not the clouds': a cloud's patch in it would mottle a whole face.)
    let skyward = clear_sky(view, smp, h.light, normalize(n + up * 0.6))
    // (The sea under the low sun is bright: it throws a warm light up under what hangs over it.)
    let below = h.light.sun_colour * vec3(0.085, 0.07, 0.055) * max(-n.y, 0.0)
    let sky = (skyward * PI * (0.2 + 0.25 * max(n.y, 0.0)) + below) * (0.25 + 0.75 * ao * ao)
    let r = d - 2.0 * dot(d, n) * n
    let reflected = clouded_sky(view, h.light, normalize(vec3(r.x, abs(r.y), r.z)), dome, smp) * ao
    let lit = Lit {
        albedo,
        n,
        sun,
        sky,
        through: vec3(0.0),
        rough,
        metallic: metal,
        reflected: reflected * glint,
        glint,
    }
    // The air between, all of it; and past that (`haze` over 1) drawn on toward the sky's own
    // colour there, as a painter pushes back what's far.
    let raw = world(h.light, lit, p, s.eye) + glow
    let aired = hazed(aerial, smp, h.light, raw, p, s.eye)
    let behind = clear_sky(view, smp, h.light, normalize(vec3(d.x, max(d.y, 0.02), d.z)))
    if haze <= 1.0 {
        return mix(raw, aired, haze)
    }
    mix(aired, behind, haze - 1.0)
}

/// The sea at `p`, seen along `d` from `t` away: its light, line field, weight, normal and energy.
fn sea_shade(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    d: vec3,
    t: f32,
) -> (vec3, f32, f32, vec3, f32) {
    let detail = clamp(1.0 - t / 60.0, 0.0, 1.0)
    let e = max(0.06, t * 0.02)
    let xz = vec2(p.x, p.z)
    // Far off, the sea's normal settles toward the vertical, as its waves fall under a pixel:
    // how many metres of water a pixel holds along the ray, against the swell's length.
    let foot = t / (s.focal * s.resolution.y * 0.5 * max(-d.y, 0.002))
    let settle = max(clamp(t / 600.0, 0.0, 0.85), smoothstep(3.0, 26.0, foot) * 0.97)
    // Seen from high over it, the sea keeps its long swell, the swell's slopes mirroring the sky
    // in long lines, and the wind's patches roughen and smooth it by turns: no glass.
    let aloft = smoothstep(20.0, 250.0, s.eye.y)
    let paws = smoothstep(
        0.35,
        0.75,
        noise(xz * 0.0045 + vec2(s.held * 0.002, 3.0)) * 0.6 + noise(xz * 0.016 + vec2(7.0)) * 0.4,
    )
    // (The swell read through a slow warp, its crests bent and broken, never ruled lines.)
    let warp = (vec2(noise(xz * 0.0031), noise(xz * 0.0031 + vec2(17.0, 5.0))) - vec2(0.5)) * 160.0
    let swell_n = sea_normal(xz + warp, s.held, 0.0, max(e, 3.0))
    let n = if aloft > 0.0 {
        normalize(
            mix(
                mix(sea_normal(xz, s.held, detail, e), vec3(y: 1.0), settle),
                // (The swell's lines come and go in long patches: never a ruled pattern.)
                mix(
                    swell_n,
                    vec3(y: 1.0),
                    0.62 -
                        0.4 *
                            smoothstep(0.3, 0.8, noise(xz * 0.0021 + vec2(11.0, s.held * 0.001))) -
                        0.1 * paws,
                ),
                aloft,
            ),
        )
    } else { normalize(mix(sea_normal(xz, s.held, detail, e), vec3(y: 1.0), settle)) }
    let wave = height(xz, s.held, detail)
    let l = h.light.sun
    let v = -d
    let nv = max(dot(n, v), 0.0)
    // What reaches it of the sun: the clouds' shadow and the skiff's.
    let near = skiff(s, p)
    let boat_shadow = if near < 4.0 { skiff_shadow(s, p + vec3(0.0, 0.02, 0.0), l) } else { 1.0 }
    let sun = cloud_shadow(h.clouds, cloud, smp, p) * boat_shadow
    // The reflected sky and clouds, Fresnel's share of it (water's F0, 0.02), and the sun's glint.
    var r = d - 2.0 * dot(d, n) * n
    r.y = abs(r.y)
    let fresnel = 0.02 + 0.98 * pow(1.0 - nv, 5.0)
    // A rough sea doesn't mirror the clouds: what it reflects is part the sky toward the
    // reflection, part the sky's mean light, more of the mean far off where the waves under a
    // pixel turn every way.
    // Far off, where a pixel holds many waves, it mirrors a smear of the sky over the horizon:
    // the flat sea's mirror, blurred upward, not one wave's tilt (which only speckles).
    let flat_r = vec3(d.x, -d.y, d.z)
    let gloss = smoothstep(3.0, 26.0, foot)
    var mirrored = heaven(view, h.light, r, dome, smp).rgb
    if gloss > 0.0 {
        var smear = vec3(0.0)
        for k in 0..4 {
            let up_k = f32(k) * 0.012 + 0.002
            smear += heaven(view, h.light, normalize(flat_r + vec3(0.0, up_k, 0.0)), dome, smp).rgb
        }
        mirrored = mix(mirrored, smear * 0.25 * 0.93, gloss * (1.0 - 0.7 * aloft))
    }
    // (The rough patches mirror less of the bright low sky, more of the deeper sky over it.)
    mirrored *= mix(1.0, mix(1.0, 0.72, paws), aloft)
    // The isle's reflection, far out on the water: where the mirrored ray meets the rock, a
    // darker, bluer sky.
    // The isle's reflection, far out on the water: the rock's warm dark under it, smeared down
    // the swell in broken vertical strokes, as the waves under it each mirror a piece.
    if t > 60.0 {
        let r0 = vec3(d.x, -d.y, d.z)
        let ib = sphere(p, r0, bounds(), 1.0e5)
        if ib.x < ib.y {
            let ti = march_coarse(p, r0 + vec3(0.0, 0.006, 0.0), ib.x, ib.y)
            if ti < ib.y {
                let broken = smoothstep(0.3, 0.7, noise(vec2(p.x * 0.02, p.z * 0.25)))
                mirrored = mix(mirrored, mirrored * vec3(0.72, 0.6, 0.52), 0.35 + 0.45 * broken)
            }
        }
    }
    // The skiff's own reflection beside it: its dark hull, broken by the ripples.
    let near_hull = skiff(s, p)
    if near_hull < 4.5 {
        let tr = march_skiff(s, p + vec3(0.0, 0.02, 0.0), r, 0.02, 7.0)
        if tr < 7.0 {
            let hull_tone = vec3(0.16, 0.07, 0.045) * (h.light.sun_colour * 0.05 + vec3(0.6))
            mirrored = mix(mirrored, hull_tone, 0.7)
        }
    }
    let spread = clouded_sky(view, h.light, normalize(r + vec3(0.0, 0.5, 0.0)), dome, smp)
    let reflected = mix(mirrored, spread, 0.15 * detail)
    let glint = h.light.sun_colour *
        sun_reflection(n, l, v, 0.12 + 0.35 * clamp(t / 300.0, 0.0, 1.0), 0.02) *
        sun
    // The light that comes back up out of the water: deep blue-green, brighter through the
    // crests lit from behind.
    let sky_up = clouded_sky(view, h.light, vec3(y: 1.0), dome, smp) * PI
    let body = vec3(0.018, 0.068, 0.082) * (h.light.sun_colour * max(l.y, 0.0) * sun + sky_up)
    let behind = pow(max(dot(normalize(vec3(-d.x, 0.0, -d.z)), -l) * 0.5 + 0.5, 0.0), 4.0)
    let through = vec3(0.004, 0.035, 0.03) *
        h.light.sun_colour *
        sun *
        behind *
        max(wave, 0.0) *
        detail
    var c = (body + through) * (1.0 - fresnel) + reflected * fresnel + glint
    // Foam where the sea meets the skiff, lit as a white surface is.
    // The skiff's wake: two thin lines spreading from its stern as it drifts, and the stirred
    // water straight behind it.
    let rel = p - s.boat
    let along = dot(rel, s.boat_z)
    let across = dot(rel, s.boat_x)
    // Under way, the wake runs longer and whiter, and the bow throws a wave off each side. The
    // wake lies along the way the skiff came: turning, an arc (its centre `bend` m to the side the
    // bow swings), read as how far back along it (`back`) and how far off it (`off`).
    let way = clamp(abs(s.speed) / 1.6, 0.0, 1.0)
    let bend = s.speed / (if abs(s.turn) < 1.0e-4 { 1.0e-4 } else { s.turn })
    var back = -along
    var off = across
    if abs(bend) < 400.0 && abs(bend) > 3.0 {
        let u = vec2(across - bend, along)
        let b = vec2(-sign(bend), 0.0)
        let phi = sign(bend) * atan2(b.x * u.y - b.y * u.x, dot(b, u))
        back = abs(bend) * phi
        off = length(u) - abs(bend)
    }
    let behind_ = max(back - 2.0, 0.0)
    // Its arms broken into foam as they spread: patches, dashes, thinning and fading.
    let broken = smoothstep(
        0.3 - 0.1 * way,
        0.62,
        noise(vec2(behind_ * 0.8 - s.held * 1.5, off * 2.0)) * 0.6 +
            noise(vec2(behind_ * 2.7, off * 6.0 + s.held)) * 0.4,
    )
    let arms = exp(-pow(abs(off) - behind_ * 0.36 - 0.4, 2.0) / (0.02 + behind_ * 0.01)) *
        smoothstep(0.0, 1.0, behind_) *
        smoothstep(26.0 + 40.0 * way, 4.0, behind_) *
        exp(-behind_ / (30.0 + 40.0 * way)) *
        broken
    let trail = exp(-off * off / (0.4 + behind_ * 0.05)) *
        smoothstep(0.0, 0.8, behind_) *
        smoothstep(14.0 + 22.0 * way, 2.0, behind_) *
        smoothstep(0.45 - 0.15 * way, 0.7, noise(xz * 1.3 + vec2(s.held * 0.6, back * 0.4)))
    let from_bow = max(1.9 - along, 0.0)
    let bow_wave = exp(-pow(abs(across) - 0.12 - from_bow * 0.4, 2.0) / 0.012) *
        smoothstep(0.0, 0.3, from_bow) *
        smoothstep(4.5, 1.2, from_bow) *
        smoothstep(0.3, 0.55, noise(vec2(along * 3.0 - s.held * 4.0, across * 3.0))) *
        way
    // Where the paddle bites: a swirl of foam round the blade, left in the water behind it.
    let (pg, pb, sunk) = paddle(s)
    let blade_w = s.boat + s.boat_x * pb.x + s.boat_z * pb.z
    let swirl = (1.0 - band(abs(length(xz - vec2(blade_w.x, blade_w.z)) - 0.16), 0.07, 0.04)) *
        smoothstep(0.3, 0.6, noise(xz * 7.0 + vec2(s.held * 2.0))) *
        sunk
    let wake = max(
        max(arms, trail * 0.6) * step(0.0, back) * (0.4 + 0.45 * way),
        max(bow_wave * 0.7, swirl * 0.8),
    )
    let foam = band(-near, -0.05 - 0.07 * noise(xz * 4.0 + vec2(s.held * 3.0)), 0.015)
    let foam_light = vec3(0.8) * (h.light.sun_colour * max(dot(n, l), 0.0) * sun + sky_up) / PI
    c = mix(c, foam_light, max(foam * 0.85, wake))
    // Rings spreading from the hull as it rocks, three at a time, fading as they widen.
    var rings = 0.0
    for k in 0..3 {
        let r_k = 0.25 + fract(s.held * 0.22 + f32(k) / 3.0) * 2.8
        let fade_k = smoothstep(3.1, 0.6, r_k)
        rings = max(
            rings,
            (1.0 - band(abs(near - r_k), 0.035 + 0.02 * r_k, 0.02)) *
                fade_k *
                smoothstep(0.3, 0.6, noise(xz * 2.2 + vec2(f32(k) * 9.0, s.held * 0.3))),
        )
    }
    c = mix(c, foam_light * 0.9, rings * 0.4 * step(0.02, near))
    // Under the hull's lee, the darkest water.
    c *= mix(0.6, 1.0, smoothstep(0.0, 0.7, near))
    // The crests' ink strokes and pale lips, light: the ink sits on the water's form.
    let footprint = t * 2.0 / (s.resolution.y * s.focal)
    let crest_ink = strokes(xz, s.held, footprint, d, wave) * clamp(1.0 - t / 70.0, 0.0, 1.0)
    c = mix(c, c * 1.6 + vec3(0.02, 0.04, 0.045), crest_ink.y * 0.35)
    c = mix(c, c * 0.35, crest_ink.x * 0.45)
    // The bow's cut: where the ink frays, more when it slaps down.
    let bow = clamp(dot(p - s.boat, s.boat_z) / 2.2, 0.0, 1.0)
    let cut = exp(-max(near, 0.0) / (0.18 + 0.25 * s.slap)) * (0.15 + 0.25 * bow + 0.45 * s.slap)
    let line = 0.5 - foam
    let aired = hazed(aerial, smp, h.light, c, p, s.eye)
    // Far out, the sea and the sky meet in the air: no ruled edge where they do.
    let horizon_sky = heaven(view, h.light, normalize(vec3(d.x, 0.006, d.z)), dome, smp).rgb
    let hazy = mix(aired, horizon_sky, smoothstep(2500.0, 30000.0, t) * 0.85)
    (hazy, line, detail * 0.6 + foam, n, cut)
}

/// A band of low cloud wrapped round the rock's lower flanks (from 420 m to 860 m, within 2.6 km
/// of it): puffs of it marched along the ray up to `hit`, lit by the low sun from above and the
/// sky. Its light, premultiplied.
fn cloud_band(
    s: Shot,
    h: Heaven,
    aerial: Texture3d<Rgba16Float>,
    smp: Sampler,
    o: vec3,
    d: vec3,
    hit: f32,
) -> vec4 {
    let lo = 230.0
    let hi = 520.0
    if abs(d.y) < 1.0e-4 {
        return vec4(0.0)
    }
    // Only near the rock: a ray that passes it by meets none of the band.
    let near_isle = sphere(o, d, vec4(ISLE.x, 375.0, ISLE.z, 2100.0), 1.0e9)
    if near_isle.x >= near_isle.y {
        return vec4(0.0)
    }
    let t0 = (lo - o.y) / d.y
    let t1 = (hi - o.y) / d.y
    let a = max(max(min(t0, t1), 0.0), near_isle.x)
    let b = min(min(max(t0, t1), hit), near_isle.y)
    if b <= a {
        return vec4(0.0)
    }
    var acc = vec4(0.0)
    for i in 0..14 {
        let t = a + (b - a) * (f32(i) + 0.5) / 14.0
        let p = o + d * t
        let r = length(vec2(p.x - ISLE.x, (p.z - ISLE.z) * 1.6)) / 1250.0
        let hf = (p.y - lo) / (hi - lo)
        let shape = noise3(
            p * vec3(1.0 / 380.0, 1.0 / 200.0, 1.0 / 380.0) + vec3(s.held * 0.002, 0.0, 0.0),
        ) *
            0.65 +
            noise3(p * (1.0 / 110.0)) * 0.35
        let profile = smoothstep(0.0, 0.3, hf) * smoothstep(1.0, 0.3, hf)
        let ragged = r + (noise3(p * (1.0 / 600.0) + vec3(7.0, 0.0, 3.0)) - 0.5) * 0.7
        let dense = smoothstep(0.54, 0.64, shape * profile + 0.3 * (1.0 - ragged)) *
            smoothstep(1.0, 0.5, ragged)
        let step_a = dense * 0.32 * (1.0 - acc.a)
        let lit = (h.light.sun_colour * vec3(1.0, 0.88, 0.75) * 0.15 * (0.25 + 0.75 * hf) +
            vec3(0.24, 0.24, 0.3)) *
            (1.0 + 0.5 * (1.0 - dense)) *
            (0.75 + 0.25 * (1.0 - acc.a))
        let col = hazed(aerial, smp, h.light, lit, p, s.eye)
        acc += vec4(col * step_a, step_a)
    }
    acc
}

/// The falls: water spilling off the plateau's lip, `FALLS` (the world's x, z, the lip's height
/// and how wide it leaves it), thinning as it drops into a mist it never lands from.
const FALLS = [
    vec4(-1300.0, 4895.0, 1009.0, 26.0),
    vec4(-1640.0, 4950.0, 1009.0, 18.0),
    vec4(-1000.0, 4935.0, 1009.0, 0.0),
]

/// How much of the falls a ray `o` + `d` t meets before `hit`, and their light (premultiplied).
fn falls(
    s: Shot,
    h: Heaven,
    aerial: Texture3d<Rgba16Float>,
    smp: Sampler,
    o: vec3,
    d: vec3,
    hit: f32,
) -> vec4 {
    var acc = vec4(0.0)
    let dd = vec2(d.x, d.z)
    let len2 = max(dot(dd, dd), 1.0e-6)
    for i in 0..3 {
        let f = FALLS[i]
        let rel = vec2(o.x, o.z) - vec2(f.x, f.y)
        let tc = -dot(rel, dd) / len2
        if tc > 0.0 && tc < hit {
            let p = o + d * tc
            let drop = f.z - p.y
            let across = length(vec2(p.x, p.z) - vec2(f.x, f.y))
            let w = f.w * (0.45 + drop * 0.004)
            let side = dot(vec2(p.x, p.z) - vec2(f.x, f.y), normalize(vec2(-dd.y, dd.x)))
            let streak = smoothstep(
                0.35,
                0.75,
                noise(vec2(side * 0.25 + f32(i) * 7.0, drop * 0.008 - s.held * 0.4)),
            )
            // A ribbon with clean edges, breaking up into mist about halfway down.
            let body = smoothstep(w, w * 0.55, across) *
                smoothstep(0.0, 6.0, drop) *
                smoothstep(560.0, 260.0, drop) *
                step(1.0, f.w)
            let mist = exp(-(across * across) / (w * w * 9.0)) *
                smoothstep(220.0, 520.0, drop) *
                smoothstep(1250.0, 700.0, drop) *
                step(1.0, f.w) *
                0.45
            let a = clamp(
                body * streak +
                    mist * (0.6 + 0.4 * noise(vec2(side * 0.05, drop * 0.01 - s.held * 0.2))),
                0.0,
                0.9,
            ) *
                (1.0 - acc.a)
            let lit = h.light.sun_colour * vec3(1.0, 0.9, 0.8) * 0.05 + vec3(0.22, 0.23, 0.27)
            let col = mix(lit, hazed(aerial, smp, h.light, lit, p, s.eye), 0.5)
            acc += vec4(col * a, a)
        }
    }
    acc
}

/// A flock: gulls round the rock and nearer, each a dark V beating its wings. `BIRDS` (where,
/// the world's; and how far each drifts).
const BIRDS = [
    vec4(18.0, 19.0, 110.0, 1.0),
    vec4(23.0, 21.0, 116.0, 2.0),
    vec4(14.0, 17.5, 121.0, 3.0),
    vec4(-128.0, 52.0, 560.0, 4.0),
    vec4(-122.0, 54.0, 566.0, 5.0),
    vec4(-134.0, 50.5, 572.0, 6.0),
    vec4(-118.0, 51.0, 552.0, 7.0),
    vec4(26.0, 11.0, 70.0, 8.0),
]

/// How much of a gull covers this pixel `px` (0 to 1), and how far it is.
fn birds(s: Shot, px: vec2) -> vec2 {
    let uv = (px * 2.0 - s.resolution) / s.resolution.y
    var cover = 0.0
    var far = 1.0e9
    for i in 0..8 {
        let b = BIRDS[i]
        let at = vec3(b.x, b.y, b.z) +
            vec3(
                sin(s.held * 0.3 + b.w) * 6.0 + s.held * 4.0,
                sin(s.held * 0.7 + b.w * 2.0) * 1.5,
                cos(s.held * 0.25 + b.w) * 5.0,
            )
        let v = at - s.eye
        let along = dot(v, s.forward)
        if along > 1.0 {
            let pb = vec2(dot(v, s.right), -dot(v, s.up)) * s.focal / along
            let scale = s.resolution.y * 0.5 * s.focal / along
            let q = (uv - pb) * s.resolution.y * 0.5 / max(scale, 1.0e-3)
            let flap = sin(s.held * 7.0 + b.w * 1.7) * 0.35
            let x = abs(q.x)
            let wing = q.y + (x * (0.45 + flap) - x * x * 0.35)
            let dist = abs(wing) * scale
            let on = smoothstep(0.9, 0.3, dist) * step(x, 0.8) * smoothstep(0.0, 0.05, x + 0.02)
            if on > cover {
                cover = on
                far = length(v)
            }
        }
    }
    vec2(cover, far)
}

@fragment
pub fn paint(
    pixel: FragCoord,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
) -> Targets3<vec4, vec4, vec4> {
    let s = shot
    let h = Heaven { light, clouds }
    let px = pixel.position.xy
    let d = ray(s, px)
    let o = s.eye
    let far = 1.0e5
    var t = far
    var id = SKY
    let ts = trace_sea(s, o, d, far)
    if ts < far {
        t = ts
        id = SEA
    }
    let bs = sphere(o, d, vec4(s.boat + s.boat_y * 0.3, 3.2), far)
    // The sea inside the skiff isn't there: the ray goes on to the hull.
    if id == SEA && dry(s, o + d * t) {
        t = far
        id = SKY
    }
    if bs.x < t {
        let tb = march_skiff(s, o, d, bs.x, min(bs.y, t))
        if tb < min(bs.y, t) {
            t = tb
            id = SKIFF
        }
    }
    let is = sphere(o, d, bounds(), far)
    if is.x < t {
        let ti = march_isle(o, d, is.x, min(is.y, t))
        if ti < min(is.y, t) {
            t = ti
            id = isle(o + d * ti).y
        }
    }
    var c = vec3(0.0)
    var line = 1.0
    var weight = 0.0
    var n = vec3(y: 1.0)
    var energy = 0.0
    let p = o + d * t
    if id == SKY {
        let sky = heaven(view, light, d, dome, smp)
        c = sky.rgb
        let band_ = cloud_band(s, h, aerial, smp, o, d, 1.0e5)
        c = c * (1.0 - band_.a) + band_.rgb
        line = 0.45 - sky.a
        weight = 0.0
        n = -d
    } else if id == SEA {
        let (sc, sl, sw, sn, se) = sea_shade(s, h, view, aerial, dome, cloud, smp, p, d, t)
        c = sc
        line = sl
        weight = sw
        n = sn
        energy = se
    } else if id == SKIFF {
        n = skiff_normal(s, p)
        let (albedo, rough, seam) = skiff_material(s, p, n)
        let sun = skiff_shadow(s, p + n * 0.01, light.sun) * cloud_shadow(clouds, cloud, smp, p)
        let ao = skiff_ao(s, p, n)
        c = lit_solid(
            s,
            h,
            view,
            aerial,
            dome,
            smp,
            p,
            n,
            d,
            albedo,
            rough,
            0.0,
            vec3(0.0),
            sun,
            ao,
            0.0,
            1.0,
        )
        // The player's skiff is lit as a character is, never lost in the shade: the bright sea's
        // light thrown up onto it, warm off the sun's path on the water, and a rim of the sun.
        let sea_light = clouded_sky(
            view,
            light,
            normalize(vec3(light.sun.x, 0.25, light.sun.z)),
            dome,
            smp,
        )
        let bounce = sea_light *
            PI *
            0.22 *
            (0.4 + 0.6 * ao) *
            (0.5 + 0.5 * max(dot(n, normalize(vec3(light.sun.x, -0.4, light.sun.z))), 0.0))
        let rim = light.sun_colour *
            vec3(1.0, 0.85, 0.6) *
            0.35 *
            pow(1.0 - max(dot(n, -d), 0.0), 3.0) *
            max(dot(n, normalize(vec3(light.sun.x, 0.3, light.sun.z))), 0.0)
        c += albedo * bounce + rim * sun
        // The waterline: the hull dark where the sea has wet it.
        let wet = smoothstep(0.14, 0.0, p.y - height(vec2(p.x, p.z), s.held, 1.0))
        c *= 1.0 - 0.5 * wet
        line = seam
        weight = 0.8
        energy = s.slap * 0.35
    } else {
        // The rock's normal taken broad, so it models in planes, as hewn stone is drawn; the
        // cathedral's finer.
        let broad = if id == ROCK { 0.0016 } else { 0.0007 }
        n = isle_normal(p, max(0.3, t * broad))
        let (albedo, rough, metal, glow0, l) = isle_material(p, n, id)
        // The gilding shines: it holds the low sun, as if lit from within.
        let glow = if id == GILT {
            glow0 +
                light.sun_colour * vec3(1.0, 0.74, 0.4) * (0.7 + 2.4 * max(dot(n, light.sun), 0.0))
        } else { glow0 }
        let sun = isle_shadow(p + n * 2.0, light.sun, 2.0) *
            mix(1.0, cloud_shadow(clouds, cloud, smp, p), 0.35)
        let ao = isle_ao(p, n)
        // The rock far and blued; the cathedral, catching the light, less so.
        // Its underside, hung in its own shade, given to the air: the lower, the more of the sky.
        let below = clamp((ISLE.y - p.y) / 945.0, 0.0, 1.0)
        let haze = if id == ROCK { 0.92 + 0.42 * pow(below, 1.6) } else { 0.62 }
        let gloss = if id == ROCK { 0.0 } else { 1.0 }
        // (The rock lit by its planes more than its cracks: a crack's wall turned to the sun
        // catches it softly, not as a seam of gold.)
        let rn = if id == ROCK { isle_normal(p, t * 0.006) } else { n }
        let ln = if id == ROCK { normalize(mix(n, rn, 0.85)) } else { n }
        c = lit_solid(
            s,
            h,
            view,
            aerial,
            dome,
            smp,
            p,
            ln,
            d,
            albedo,
            rough,
            metal,
            glow,
            sun,
            ao,
            haze,
            gloss,
        )
        // The sun behind it catches every edge turned its way: a hot rim down the spires' and the
        // rock's sun sides, against the light.
        let side = normalize(vec3(light.sun.x, 0.15, light.sun.z))
        // (The rock's rim off its broad planes, not every crack's: a light along its edges, not
        // a sparkle.)
        let edge_on = pow(1.0 - max(dot(rn, -d), 0.0), 3.0) * max(dot(rn, side), 0.0)
        let hot = if id == ROCK { 0.08 } else if id == GILT { 1.4 } else { 1.0 }
        c += light.sun_colour * vec3(1.0, 0.78, 0.45) * hot * edge_on * mix(1.0, sun, 0.6)
        // The rock's great planes modelled as a painter would against the light: those turned
        // toward the sun's side warmed by it as it wraps round, those turned away left in a
        // deeper, cooler shade, and the ledges' tops catching the sky. Fading as the air takes
        // the underside.
        if id == ROCK {
            let wrap = pow(clamp(dot(rn, side) * 0.55 + 0.45, 0.0, 1.0), 2.5)
            let ledge = smoothstep(0.2, 0.7, rn.y)
            let fade = 1.0 - smoothstep(0.2, 0.8, below)
            c += albedo *
                light.sun_colour *
                vec3(1.0, 0.8, 0.55) *
                0.3 *
                wrap *
                mix(0.35, 1.0, sun) *
                fade
            c += albedo * vec3(0.5, 0.58, 0.75) * 0.12 * ledge * fade
            c *= mix(1.0, mix(0.72, 1.0, wrap), fade)
        }
        // The cloud band round the rock's lower flanks, in front of it.
        let band_ = cloud_band(s, h, aerial, smp, o, d, t)
        c = c * (1.0 - band_.a) + band_.rgb
        line = l
        weight = if id == ROCK { 0.55 } else { 0.5 }
        // (The ink reads the rock by its planes too.)
        n = ln
    }
    // The falls, in front of what the ray met; the gulls in front of all.
    let fall = falls(s, h, aerial, smp, o, d, t)
    c = c * (1.0 - fall.a) + fall.rgb
    let gull = birds(s, pixel.position.xy)
    if gull.y < t {
        c = mix(c, c * mix(0.12, 0.75, clamp(gull.y / 1200.0, 0.0, 0.85)) + vec3(0.01), gull.x)
    }
    // The cathedral's shine: a warm light held in the air round it, far off, over all but the
    // skiff.
    // Behind the spires it's strongest: they stand dark-edged and gilt against it.
    if id != SKIFF && t > 400.0 {
        let k = max(dot(d, s.glow), 0.0)
        let over = if id == SKY { 1.0 } else { 0.0 }
        c += light.sun_colour *
            vec3(1.0, 0.8, 0.5) *
            (0.05 * pow(k, 250.0) + 0.85 * pow(k, 1400.0)) *
            over
    }
    Targets3 {
        first: vec4(c, 1.0),
        second: vec4(log2(max(t, 0.01)), id, line, weight),
        third: vec4(n * 0.5 + 0.5, clamp(energy, 0.0, 1.0)),
    }
}
