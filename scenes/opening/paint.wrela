// The first pass: each pixel's ray meets the sea, the skiff, the rock and its cathedral, or the
// engine's sky, and is lit in 3D as the engine lights its world: the sun through the air
// (`engine::light`), the clouds' shadows, soft shadows and ambient occlusion from the distance
// fields, the sky's light and its reflection, and the air between the eye and what it sees
// (`engine::light::hazed`). Beside the colour it writes what the ink reads: how far, what it is,
// a line field, the line's weight, the normal and the moment's energy.

use main::{FREEBOARD, LOOK, LOW_CLOUD, OFF}
use look::{
    STORM_BEHIND, STORM_HORIZON, STORM_LOW, GILT, GLASS, ISLE, ROCK, SEA, SKIFF, SKY, STONE, Shot,
    band, cells, hash2, luma, fbm, noise, ray,
}
use sea::{SEA as SEA_STATE, lee, strokes, tiles}
use engine::ocean::{Waves, level_at, surface_at}
use isle::{FALLS, SCALE, bounds, isle, isle_material, isle_normal}
use yonder::falls
use skiff::{dry, skiff, skiff_material, skiff_normal}
use wake::{lifted, marks, spray, stirred}
use engine::far::foot
use engine::light::{Light, Lit, gloss, hazed, matte, sun_disc, world}
use engine::air::aerial_uvw
use engine::light::sky as clear_sky
use engine::sky::{Clouds, cloud_shadow, sky_uv, stormy_air}
use std::gpu::{FragCoord, Rgba16Float, Rgba8, Sampler, Targets3, Texture, Texture3d}
use std::math::PI

/// What the sky's light reads beside its textures: the light, and where the clouds are.
pub struct Heaven: Copy {
    pub(package) light: Light,
    pub(package) clouds: Clouds,
}

/// The sky along `d` and its clouds from the dome (their cover in alpha), the sun's disc on it
/// if `disc`. Under the overcast, the sky seen through the deck's thinner places is the deck's
/// own dim light, not the open sky's glare, and the sun's disc is gone.
fn storm_sky(
    view: Texture<Rgba16Float>,
    light: Light,
    d: vec3,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    disc: bool,
) -> vec4 {
    let c = dome.sample_level(smp, sky_uv(d))
    let open = mix(sea_day_sky(view, light, d, smp), clear_sky(view, smp, light, d), light.storm) + (if disc {
        (sun_disc(light, d) + sun_glow(light, d)) * (1.0 - light.storm)
    } else { vec3(0.0) })
    let behind = mix(open, vec3(luma(open)) * vec3(0.8, 0.85, 0.9) * STORM_BEHIND, light.storm)
    vec4(behind * (1.0 - c.a) + c.rgb, c.a)
}

/// The open sky along `d` on a sea day: its colour the sky's square to the sun at the same
/// height, so the haze's forward glow doesn't turn the whole sunward sky to cream; the sky's
/// own only close round the sun, where that glow is.
fn sea_day_sky(view: Texture<Rgba16Float>, light: Light, d: vec3, smp: Sampler) -> vec3 {
    let here = clear_sky(view, smp, light, d)
    let flat = normalize(vec2(-light.sun.z, light.sun.x))
    let k = sqrt(max(1.0 - d.y * d.y, 0.0))
    let square = clear_sky(view, smp, light, vec3(flat.x * k, d.y, flat.y * k))
    mix(square, here, pow(max(dot(d, light.sun), 0.0), 48.0))
}

/// The glare round the sun's disc under an open sky: a hot core and a wide soft halo, the haze
/// lit up round it.
fn sun_glow(light: Light, d: vec3) -> vec3 {
    let c = clamp(dot(d, light.sun), 1.0e-3, 1.0)
    light.sun_colour * (1.5 * pow(c, 2500.0) + 0.3 * pow(c, 300.0) + 0.05 * pow(c, 40.0))
}

/// `sky` (`storm_sky`'s, along `d`), under the overcast gone low on the horizon, past the deck's
/// reach, into the storm's own air: as bright as the deck a little over it all round (eight of
/// its directions' mean, so no one cloud shows, and its grazing march's streaks don't), the
/// deck's underside going on into it.
fn into_the_air(
    sky: vec4,
    view: Texture<Rgba16Float>,
    light: Light,
    d: vec3,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
) -> vec4 {
    if light.storm <= 0.0 || d.y > STORM_LOW {
        return sky
    }
    var far = vec3(0.0)
    for k in 0..8 {
        let a = f32(k) * 0.785398
        far += storm_sky(
            view,
            light,
            normalize(vec3(cos(a), STORM_LOW * 1.4, sin(a))),
            dome,
            smp,
            disc: false,
        ).rgb
    }
    // (Lighter toward the horizon itself, where the eye looks out under the deck's edge into
    // farther air: the band the cathedral and the skiff stand dark against.)
    let lift = mix(mix(1.0, STORM_HORIZON, LOW_CLOUD), 1.0, smoothstep(0.0, STORM_LOW, d.y))
    let air = vec3(luma(far / 8.0)) * vec3(0.92, 0.96, 1.0) * lift
    let deck_k = smoothstep(STORM_LOW * 0.35, STORM_LOW, d.y)
    vec4(mix(air, sky.rgb, deck_k), mix(1.0, sky.a, deck_k))
}

/// The elevation (as a direction's y) the deck is sure to be under, from the eye: what's below
/// it is the air the deck goes into.

/// How much lighter the air is at the horizon itself than under the deck.

/// How bright the air past the deck's reach is, against the open sky's there.

/// Low on the horizon along `d`, under the clouds' far repeats: the open sky where the sky over
/// it is open, and where clouds stand over it (a storm's far deck seen from clear weather), their
/// light gone on down into the air under them, so there's no band of open sky cut under them.
/// (Their light spread along the horizon, so no one cloud streaks down into it.)
fn under_the_far_deck(
    view: Texture<Rgba16Float>,
    light: Light,
    d: vec3,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
) -> vec3 {
    let clear = sea_day_horizon(view, light, d, smp)
    // (The deck's light and cover low all round, eight directions' mean: one colour along the
    // whole horizon, so no cloud streaks down into it.)
    var low = vec4(0.0)
    for k in 0..8 {
        let a = f32(k) * 0.785398
        let lo = dome.sample_level(smp, sky_uv(normalize(vec3(cos(a), 0.035, sin(a)))))
        let hi = dome.sample_level(smp, sky_uv(normalize(vec3(cos(a), 0.06, sin(a)))))
        low += (if hi.a > lo.a { hi } else { lo }) * 0.125
    }
    let cloud = low.rgb / max(low.a, 1.0e-3)
    let toward = smoothstep(0.03, 0.0, d.y)
    let air = mix(cloud, clear, 0.25 + 0.35 * toward)
    mix(clear, air, saturate(low.a))
}

/// Under an open sky, the elevation (a direction's y) under which the clouds' far repeats are
/// all lost in the air, and over which they're whole (between, they fade): their far repeats,
/// grazing, step into ruled dashes, so they go softly into the horizon's air.
const LOST_LOW: f32 = 0.02
const LOST_HIGH: f32 = 0.08

/// The open sky low on the horizon along `d` on a sea day: as bright as the sky's own there,
/// but no brighter than the sky a little over it by much, and its hue the air's square to the
/// sun, cool white: looking sunward the haze's forward glow paints the horizon a beige band.
fn sea_day_horizon(view: Texture<Rgba16Float>, light: Light, d: vec3, smp: Sampler) -> vec3 {
    let here = clear_sky(view, smp, light, normalize(vec3(d.x, max(d.y, 0.0), d.z)))
    let flat = normalize(vec2(-light.sun.z, light.sun.x))
    let square = clear_sky(view, smp, light, normalize(vec3(flat.x, max(d.y, 0.0), flat.y)))
    let over = clear_sky(view, smp, light, normalize(vec3(d.x, 0.15, d.z)))
    let bright = min(luma(here), luma(over) * 1.15)
    square * (bright / max(luma(square), 1.0e-4))
}

/// The sky along `d`, with its clouds (their cover in alpha); the clouds lost in the air low on
/// the horizon, where they'd be sixty kilometres off and more (the cloud field's far repeats).
pub(package) fn heaven(
    view: Texture<Rgba16Float>,
    light: Light,
    d: vec3,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
) -> vec4 {
    let cloudy = storm_sky(view, light, d, dome, smp, disc: true)
    // (Under the overcast, the deck goes on down to the horizon: its far repeats are lost in
    // its own air.)
    let lost = mix(smoothstep(LOST_LOW, LOST_HIGH, d.y), 1.0, light.storm)
    // (Under the storm all of it's lost in the deck: not read.)
    let clear = if lost >= 1.0 { vec3(0.0) } else { under_the_far_deck(view, light, d, dome, smp) }
    let open = vec4(mix(clear, cloudy.rgb, lost), cloudy.a * lost)
    into_the_air(open, view, light, d, dome, smp)
}

/// `colour` at `world`, seen from `eye` through the air (`engine::light::hazed`'s), the storm's
/// air under the overcast: the same air the clouds are seen through (`engine::sky::stormy_air`).
pub(package) fn aired(
    air: Texture3d<Rgba16Float>,
    smp: Sampler,
    light: Light,
    colour: vec3,
    world: vec3,
    eye: vec3,
) -> vec3 {
    let v = world - eye
    // (Under an open sky the air's a sea day's, clearer than the storm's: a rock 8 km off keeps
    // its dark mass, veiled, not washed out to the haze's cream. The storm's air is as it was.)
    let km = length(v) * 0.001 * mix(CLEAR_AIR, 1.0, light.storm)
    let a = stormy_air(air, smp, light.sun, normalize(v), km, light.storm)
    let stormy = colour * a.a + a.rgb
    if light.storm >= 1.0 {
        return stormy
    }
    // (And its light the air's square to the sun, cool and blue: looking sunward, the haze's
    // forward glow would wash a far rock out to a flat cream.)
    let side = normalize(vec3(-light.sun.z, 0.05, light.sun.x))
    let b = air.sample_level(smp, aerial_uvw(light.sun, side, km))
    mix(colour * b.a + b.rgb, stormy, light.storm)
}

/// Under an open sky, how much of the storm's air a distance holds (the sea day's air is
/// clearer; 1 under the storm).
const CLEAR_AIR: f32 = 0.35

/// The sky as the water mirrors it along `d`: `heaven`'s, without the sun's disc (the sun's own
/// mirror is the glitter's).
fn mirrored_sky(
    view: Texture<Rgba16Float>,
    light: Light,
    d: vec3,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
) -> vec3 {
    let cloudy = storm_sky(view, light, d, dome, smp, disc: false).rgb
    // (Under the overcast, the deck goes on down to the horizon: its far repeats are lost in
    // its own air.)
    let lost = mix(smoothstep(LOST_LOW, LOST_HIGH, d.y), 1.0, light.storm)
    // (Under the storm all of it's lost in the deck: not read.)
    let clear = if lost >= 1.0 { vec3(0.0) } else { under_the_far_deck(view, light, d, dome, smp) }
    into_the_air(vec4(mix(clear, cloudy, lost), 1.0), view, light, d, dome, smp).rgb
}

/// Where the ray from `o` along `d` meets the sea (`d` going down), or `far`. Near, found on the
/// waves (a crest hides the trough behind it): the ocean's two longer tiles, each read as the
/// pixel's footprint holds it, the waves a boat rides broken by the hull (`tiles`). Far off,
/// where the waves a pixel holds are long and low, on the sea's level plane: a ray skimming the
/// swell found it a few metres either way from pixel to pixel, and its shading speckled.
fn trace_sea(s: Shot, waves: Waves, o: vec3, d: vec3, far: f32) -> f32 {
    if d.y >= -0.0005 {
        return far
    }
    let plane = o.y / -d.y
    if plane > far {
        return far
    }
    let level_k = smoothstep(120.0, 300.0, plane)
    if level_k >= 1.0 {
        return plane
    }
    // (Stepping only forward, each step what the sea's slopes allow, so a ray skimming a crest
    // never hops back and forth between it and the trough behind; once under, halved onto it.
    // The footprint along the ray, foreshortened, picks the mips: a crest a pixel can't hold
    // isn't marched into speckle.)
    let slant = max(-d.y, 0.02)
    var t = max((o.y - 1.6) / -d.y, 0.0)
    var before = t
    var under = false
    var i = 0
    while i < 32 && !under {
        let p = o + d * t
        let foot = t * 2.0 / (s.resolution.y * s.focal * slant)
        let f = p.y - sea_level(s, waves, p, foot)
        if f < 0.0 {
            under = true
        } else {
            before = t
            t += f / (-d.y + 0.2) + 0.01
        }
        i += 1
    }
    if under {
        var lo = before
        var hi = t
        for _ in 0..8 {
            let m = (lo + hi) * 0.5
            let p = o + d * m
            let foot = m * 2.0 / (s.resolution.y * s.focal * slant)
            let f = p.y - sea_level(s, waves, p, foot)
            if f < 0.0 {
                hi = m
            } else {
                lo = m
            }
        }
        t = (lo + hi) * 0.5
    }
    min(mix(t, plane, level_k), far)
}

/// The sea's height under `p` (read as a pixel `foot` m across holds it), the waves a boat rides
/// broken by the hull (`tiles`). Close along the hull it lies no higher than halfway up its
/// side: the skiff rides the swell (`sea::bob`), and the shorter waves it only rocks on would
/// otherwise rise through its planks and drown its side.
fn sea_level(s: Shot, waves: Waves, p: vec3, foot: f32) -> f32 {
    let rel = p - s.boat
    let mid = tiles(lee(rel, s.boat_x, s.boat_z)).y
    let level = level_at(waves, vec2(p.x, p.z), foot, mid)
    let e = length(vec2(dot(rel, s.boat_x) / 0.62, dot(rel, s.boat_z) / 2.2))
    // (The cap follows the skiff as it heels and pitches, halfway up its side (its deck is
    // `FREEBOARD` over its waterline), and lets go over a hull's width or so, so the water slopes
    // down to it rather than standing in a wall round it. Capped at the waterline, every crest
    // that reached the hull was cut flat to one straight line along it, and it read as laid on
    // the sea; now the waves climb its planks and fall back. A soft cap, so a crest under it
    // rounds over rather than ending in a crease.)
    let gunwale = s.boat.y + FREEBOARD - (s.boat_y.x * rel.x + s.boat_y.z * rel.z) / max(s.boat_y.y, 0.5)
    let near = 1.0 - smoothstep(1.0, 2.6, e)
    // (Heaped by the hull as it makes way: its bow wave, its quarters' hollow, the hump astern:
    // `wake::lifted`; the cap over that too, so the bow wave never stands over the deck.)
    let heaped = level + lifted(s, p)
    let cap = gunwale - 0.14
    let hk = clamp(0.5 + 0.5 * (cap - heaped) / 0.08, 0.0, 1.0)
    let capped = mix(cap, heaped, hk) - 0.08 * hk * (1.0 - hk)
    mix(heaped, capped, near * near * (3.0 - 2.0 * near))
}

fn march_skiff(s: Shot, o: vec3, d: vec3, lo: f32, hi: f32) -> f32 {
    var t = lo
    var hit = hi
    var i = 0
    while i < 80 && t < hi {
        let h = skiff(s, o + d * t)
        if h < 0.002 {
            hit = t
            t = hi
        } else {
            t += h * 0.8
        }
        i += 1
    }
    hit
}

/// The skiff seen in the water: where the ray meets it (or `hi`), and how near it came (for a
/// soft edge to its reflection).
fn mirror_skiff(s: Shot, o: vec3, d: vec3, lo: f32, hi: f32) -> vec2 {
    var t = lo
    var hit = hi
    var closest = 1.0e5
    var i = 0
    while i < 48 && t < hi {
        let h = skiff(s, o + d * t)
        closest = min(closest, h)
        if h < 0.004 {
            hit = t
            t = hi
        } else {
            t += h * 0.9
        }
        i += 1
    }
    vec2(hit, closest)
}

/// The cathedral's lantern: six beams of its stained glass's colours thrown from the heart of it
/// out and down over the sea, turning slowly round as a lighthouse's do. Each beam's colour.
const BEAM_TINT = [
    vec3(0.95, 0.12, 0.1),
    vec3(0.15, 0.3, 1.0),
    vec3(1.0, 0.72, 0.2),
    vec3(0.6, 0.15, 0.95),
    vec3(0.1, 0.45, 1.0),
    vec3(1.0, 0.3, 0.08),
]

/// Where the lantern's beams start (the world's), and beam `k`'s heading at time `t`.
fn beam_apex() -> vec3 {
    ISLE + vec3(0.0, 420.0, -42.0)
}

fn beam_heading(k: u32, t: f32) -> vec3 {
    let az = t * 0.09 + f32(k) * 1.0471976
    normalize(vec3(cos(az), -0.3, sin(az)))
}

/// How much of the beams a ray `o` + `d` t passes through before `hit`, and their light
/// (premultiplied): at each beam, where the ray comes closest to its axis, a soft cone widening
/// as it goes.
fn beams(
    s: Shot,
    h: Heaven,
    aerial: Texture3d<Rgba16Float>,
    smp: Sampler,
    o: vec3,
    d: vec3,
    hit: f32,
) -> vec4 {
    var acc = vec4(0.0)
    let apex = beam_apex()
    for k in 0..6 {
        let e = beam_heading(k, s.held)
        let len = apex.y / -e.y
        let w0 = o - apex
        let b = dot(d, e)
        let den = max(1.0 - b * b, 1.0e-5)
        let dd = dot(d, w0)
        let ee = dot(e, w0)
        let tt = (b * ee - dd) / den
        let sc = clamp(ee + b * tt, 250.0, len)
        let axis = apex + e * sc
        let tr = max(dot(axis - o, d), 0.0)
        if tr < hit {
            let q = o + d * tr
            let dist = length(q - axis)
            let r = 16.0 + sc * 0.028
            let dens = exp(-dist * dist / (r * r) * 2.0) *
                smoothstep(250.0, 650.0, sc) *
                (0.55 + 0.45 * smoothstep(len, len * 0.6, sc))
            let a = clamp(dens * 0.42 * s.lantern, 0.0, 0.7) * (1.0 - acc.a)
            let col = h.light.sun_colour * BEAM_TINT[k] * 0.26
            let seen = mix(col, aired(aerial, smp, h.light, col, q, s.eye), 0.5)
            acc += vec4(seen * a, a)
        }
    }
    acc
}

/// Where a ray from `o` along `d` meets a sphere `b` (centre, radius): its near and far
/// distances, or (far, far).
pub(package) fn sphere(o: vec3, d: vec3, b: vec4, far: f32) -> vec2 {
    let oc = o - b.xyz
    let k = dot(oc, d)
    let c = dot(oc, oc) - b.w * b.w
    let h = k * k - c
    if h < 0.0 {
        return vec2(far)
    }
    let q = sqrt(h)
    vec2(max(-k - q, 0.0), -k + q)
}

fn skiff_shadow(s: Shot, p: vec3, l: vec3) -> f32 {
    var t = 0.02
    var lit = 1.0
    for _ in 0..24 {
        let h = skiff(s, p + l * t)
        lit = min(lit, 12.0 * h / t)
        t += clamp(h, 0.02, 0.4)
    }
    clamp(lit, 0.0, 1.0)
}

fn skiff_ao(s: Shot, p: vec3, n: vec3) -> f32 {
    var hidden = 0.0
    var w = 1.0
    for i in 1..5 {
        let h = 0.04 * f32(i * i)
        hidden += w * max(h - skiff(s, p + n * h), 0.0) / h
        w *= 0.6
    }
    clamp(1.0 - hidden * 0.6, 0.0, 1.0)
}

/// A solid surface's light, as the engine's world takes it (`engine::light::world`): the sun
/// through `sun` of shadow, the sky's light over it (`ao` of it reaching), its reflection, and
/// what it gives itself; seen from the eye through the air.
pub(package) fn lit_solid(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    p: vec3,
    n: vec3,
    d: vec3,
    albedo: vec3,
    rough: f32,
    metal: f32,
    glow: vec3,
    sun: f32,
    ao: f32,
    haze: f32,
    glint: f32,
) -> vec3 {
    let up = vec3(y: 1.0)
    // The cel look's light: the sun on a face or not, at one strength, the terminator a pixel
    // wide; the sky's light the same over every face. (Its glints keep their own light.)
    let cel = LOOK > 1.5 && LOOK < 2.5
    // The sky's light on it: the sky toward its normal, lifted toward the zenith, and the sea's
    // light from below.
    // (The clear sky's, not the clouds': a cloud's patch in it would mottle a whole face.)
    let clear_light = clear_sky(view, smp, h.light, if cel { up } else { normalize(n + up * 0.6) })
    // (Under the overcast, the light of the deck itself, as the sea's and the skiff's is: three
    // of its directions round the face's, so no one cloud mottles it.)
    let toward = if cel { up } else { normalize(n + up * 0.6) }
    let across = normalize(cross(toward, vec3(0.0, 0.0, 1.0)) + vec3(1.0e-4))
    let deck_light = (storm_sky(view, h.light, toward, dome, smp, disc: false).rgb +
        storm_sky(
            view,
            h.light,
            normalize(toward + across * 0.5 + up * 0.2),
            dome,
            smp,
            disc: false,
        ).rgb +
        storm_sky(
            view,
            h.light,
            normalize(toward - across * 0.5 + up * 0.2),
            dome,
            smp,
            disc: false,
        ).rgb) /
        3.0
    let skyward = mix(clear_light, deck_light, h.light.storm)
    // (The sea under the low sun is bright: it throws a warm light up under what hangs over it.)
    let under = if cel { band(-n.y, 0.35, 0.04) * 0.6 } else { max(-n.y, 0.0) }
    let below = h.light.sun_colour * vec3(0.085, 0.07, 0.055) * under
    // (Cel, the faces turned up a step lighter than the rest: two values of shade, not a ramp.)
    let open = if cel { 0.22 + 0.12 * band(n.y, 0.35, 0.05) } else { 0.2 + 0.25 * max(n.y, 0.0) }
    let sky = (skyward * PI * open + below) * (0.25 + 0.75 * ao * ao)
    let r = d - 2.0 * dot(d, n) * n
    let mirrored = normalize(vec3(r.x, abs(r.y), r.z))
    let reflected = storm_sky(view, h.light, mirrored, dome, smp, disc: false).rgb * ao
    let lit = Lit {
        albedo,
        n,
        sun,
        sky,
        through: vec3(0.0),
        rough,
        metallic: metal,
        reflected: reflected * glint,
        glint,
    }
    // The air between, all of it; and past that (`haze` over 1) drawn on toward the sky's own
    // colour there, as a painter pushes back what's far.
    let raw = if cel {
        // (Set a little round the terminator, as cel light is: the sides turned to the sun's
        // quarter catch it, so a form against the light still has its lit plane. Past the
        // terminator, its own cast shadows kept.)
        let ndl = dot(n, h.light.sun)
        let faces = smoothstep(-0.24, -0.18, ndl)
        let cast = mix(1.0, smoothstep(0.3, 0.45, sun), smoothstep(-0.02, 0.06, ndl))
        let shade = Lit { sun: 0.0, ..lit }
        matte(h.light, shade, p, s.eye) +
            albedo * h.light.sun_colour * (0.42 * faces * cast * (1.0 - metal)) +
            gloss(h.light, lit, normalize(s.eye - p)) +
            glow
    } else { world(h.light, lit, p, s.eye) + glow }
    let aired = aired(aerial, smp, h.light, raw, p, s.eye)
    let back = normalize(vec3(d.x, max(d.y, 0.02), d.z))
    // (Under the overcast, the sky behind it is the deck's.)
    let behind = mix(
        clear_sky(view, smp, h.light, back),
        storm_sky(view, h.light, back, dome, smp, disc: false).rgb,
        h.light.storm,
    )
    if haze <= 1.0 {
        return mix(raw, aired, haze)
    }
    mix(aired, behind, haze - 1.0)
}

/// `raw` (a surface's light at `p`, as `lit_solid` gives it with no `haze`) seen from the eye
/// through the air, `lit_solid`'s way: all of it, and past that (`haze` over 1) on toward the
/// sky's own colour behind. For light shaded further after `lit_solid`, so the air is laid
/// over the shading, never darkened by it.
pub(package) fn hazed_far(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    smp: Sampler,
    raw: vec3,
    p: vec3,
    d: vec3,
    haze: f32,
) -> vec3 {
    let aired = aired(aerial, smp, h.light, raw, p, s.eye)
    let back = normalize(vec3(d.x, max(d.y, 0.02), d.z))
    let behind = mix(
        clear_sky(view, smp, h.light, back),
        storm_sky(view, h.light, back, dome, smp, disc: false).rgb,
        h.light.storm,
    )
    if haze <= 1.0 {
        return mix(raw, aired, haze)
    }
    mix(aired, behind, haze - 1.0)
}

/// The middles of a normal spread's four quarters, in its deviations.
const QUARTILES = [-1.15, -0.32, 0.32, 1.15]

/// Smith's Λ for Beckmann's roughness `a` on the axes `tu`, `tv` of the facet `n`, along `w`
/// (Walter et al.'s rational fit).
fn smith(w: vec3, n: vec3, tu: vec3, tv: vec3, a: vec2) -> f32 {
    let z = max(abs(dot(w, n)), 1.0e-4)
    let x = dot(w, tu) * a.x
    let y = dot(w, tv) * a.y
    let k = z / max(sqrt(x * x + y * y), 1.0e-6)
    if k >= 1.6 {
        return 0.0
    }
    (1.0 - 1.259 * k + 0.396 * k * k) / (3.535 * k + 2.181 * k * k)
}

/// The sun's mirror in water whose slopes too fine to draw spread its facets as a Gaussian does
/// (the sea's slopes are near enough one: Cox and Munk), by Beckmann's roughness `a` across the
/// view (`a.x`) and along it (`a.y`, about `along`): per unit `sun_colour`, as
/// `engine::light::sun_reflection`, spread two ways. (A footprint stretched down the view loses
/// the slopes along it, not across it.)
fn glitter(n: vec3, l: vec3, v: vec3, along: vec3, a: vec2) -> f32 {
    let nl = dot(n, l)
    let half = l + v
    if nl <= 0.0 || dot(half, half) <= 1.0e-12 {
        return 0.0
    }
    let nv = max(dot(n, v), 1.0e-4)
    let h = normalize(half)
    let tv = normalize(along - n * dot(n, along) + vec3(0.0, 0.0, 1.0e-5))
    let tu = cross(n, tv)
    let hx = dot(h, tu) / a.x
    let hy = dot(h, tv) / a.y
    let hz = max(dot(h, n), 1.0e-3)
    let facets = exp(-(hx * hx + hy * hy) / (hz * hz)) / (PI * a.x * a.y * pow(hz, 4.0))
    let masked = 1.0 + smith(v, n, tu, tv, a) + smith(l, n, tu, tv, a)
    let fresnel = 0.02 + 0.98 * pow(1.0 - max(dot(v, h), 0.0), 5.0)
    PI * facets * fresnel / (4.0 * nv * masked)
}

/// A glint's spread, in pixels: a point of sunlight on the water is a half-pixel's deviation wide.
const SPARK: f32 = 0.5

/// The glitter as the points it is. Of the facets too fine to draw, here and there one turns the
/// sun's mirror to the eye: a point of light a pixel across that rides with its water (laid
/// where the water rests, `rest`) and flashes for a few drawings, then another elsewhere. They
/// lie `density` to a pixel, the pixel's footprint `across` (m, a pixel to the right on the
/// screen) and `down` (a pixel down it, along the eye's heading `flat`): how much of the
/// glitter's mean light this pixel holds of them, 1 on average.
fn sparkle(rest: vec2, flat: vec2, across: vec2, down: vec2, t: f32, density: f32) -> f32 {
    // The points lie in cells on a lattice turned to face the eye (a pixel's footprint is long
    // down its heading and narrow across), so each cell is a few pixels each way. The lattice
    // turns in steps of a degree and a half of heading, each step's points its own and the
    // two either side of a heading mixed, so nothing swims as the eye moves.
    let step_ = 0.02618
    let heading = atan2(flat.y, flat.x) / step_
    let first = floor(heading)
    let mixed = heading - first
    var sum = 0.0
    for j in 0..2 {
        let turn = (first + f32(j)) * step_
        let b = vec2(cos(turn), sin(turn))
        let a = vec2(-b.y, b.x)
        let w = if j == 0 { 1.0 - mixed } else { mixed }
        sum += w *
            sparkle_on(
                vec2(dot(rest, a), dot(rest, b)),
                vec2(dot(across, a), dot(across, b)),
                vec2(dot(down, a), dot(down, b)),
                t,
                density,
                first + f32(j),
            )
    }
    sum
}

/// One lattice's points (`sparkle`'s), everything in its own axes; `which` the lattice.
fn sparkle_on(rest: vec2, across: vec2, down: vec2, t: f32, density: f32, which: f32) -> f32 {
    // Each cell as small as holds a point whole (two deviations every way), in powers of two
    // each way (so no seam shows where they step: on either side the points lie as thick and as
    // bright), with room for `SPARKS` points.
    let ext = (abs(across) + abs(down)) * (2.0 * SPARK)
    let c = vec2(exp2(ceil(log2(ext.x * 2.05))), exp2(ceil(log2(ext.y * 2.05))))
    let cell = floor(rest / c)
    let det = across.x * down.y - across.y * down.x
    let area = c.x * c.y / max(abs(det), 1.0e-12)
    let p = min(density * area / f32(SPARKS), 1.0)
    if p <= 1.0e-6 {
        return 0.0
    }
    let id = cell + vec2(log2(c.x) * 17.0 + which * 3.1, log2(c.y) * 5.0 + which * 0.7)
    var sum = 0.0
    for i in 0..SPARKS {
        // Each point holds for a third to two thirds of a second (eight drawings and more), and
        // the next lies elsewhere in the cell; a few burn far brighter than the rest.
        let own = id + vec2(f32(i) * 41.3, f32(i) * 11.9)
        let life = 0.3 + 0.3 * hash2(own)
        let k = t / life + hash2(own + vec2(5.3, 1.1))
        let round_ = floor(k)
        let seed = own + vec2(round_ * 7.31, round_ * 3.17)
        if hash2(seed) < p {
            let at = cell * c +
                ext +
                (c - ext * 2.0) * vec2(hash2(seed + vec2(1.7, 9.2)), hash2(seed + vec2(8.3, 2.6)))
            // How far it lies from the pixel, in pixels.
            let off = at - rest
            let x = (off.x * down.y - off.y * down.x) / det
            let y = (across.x * off.y - across.y * off.x) / det
            let u = fract(k)
            let held_ = smoothstep(0.0, 0.15, u) * smoothstep(1.0, 0.85, u)
            let strength = min(0.5 / sqrt(max(hash2(seed + vec2(4.4, 6.1)), 0.0025)), 10.0)
            sum += exp(-(x * x + y * y) / (2.0 * SPARK * SPARK)) * held_ * strength
        }
    }
    // (Its mean, over the cell and its life: SPARKS × p of them, lit 0.85 of it, 2πσ² pixels
    // each.)
    sum * area / (f32(SPARKS) * p * 0.85 * 2.0 * PI * SPARK * SPARK)
}

/// How many points a cell of the glitter's lattice may hold, and how many a pixel may: a cell
/// is some sixteen pixels.
const SPARKS: u32 = 3
const SPARK_ROOM: f32 = 0.2

/// How bright a glint's point is at its heart (the light's, before the exposure), at most: far
/// over the sky's, so it burns white. And its light times the footprint it lies in (m²): one
/// facet's mirror of the sun, spread over a pixel.
const SPARK_PEAK: f32 = 60.0
const SPARK_GLINT: f32 = 1.5

/// The sea at `p`, seen along `d` from `t` away: its light, line field, weight, normal and energy.

/// How much of the sky over the water at `p` the rock hides (0 to 1, cosine-weighted): as a
/// disc 1.1 km across its broad middle, seen from under it.
fn under_isle(p: vec3) -> f32 {
    let v = ISLE + vec3(0.0, -450.0, 0.0) - p
    let d2 = dot(v, v)
    let r2 = 1100.0 * 1100.0
    clamp(1.5 * r2 / (r2 + d2) * max(v.y, 0.0) / sqrt(d2), 0.0, 0.85)
}

fn sea_shade(
    s: Shot,
    h: Heaven,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    waves: Waves,
    yon: Texture<Rgba16Float>,
    yon_marks: Texture<Rgba16Float>,
    p: vec3,
    d: vec3,
    t: f32,
) -> (vec3, f32, f32, vec3, f32) {
    let detail = clamp(1.0 - t / 60.0, 0.0, 1.0)
    let xz = vec2(p.x, p.z)
    // The ocean as this pixel holds it: its tiles read through the pixel's footprint on the
    // water (a pixel across, and down the view as many as the slant stretches it), so what's
    // finer than a pixel is averaged, not stairs or crawl; and the slopes it lost roughening the
    // glint instead (`engine::ocean::surface_at`). By the hull its shorter waves are broken, so
    // the skiff sits in the water it's drawn on.
    let px_m = t * 2.0 / (s.resolution.y * s.focal)
    let calm = lee(p - s.boat, s.boat_x, s.boat_z)
    let flat = normalize(vec2(d.x, d.z))
    // (A pixel's step on the water: to the right on the screen, along the eye's level right; down
    // it, along the ray's own heading, as far as the slant stretches it.)
    let px_at = px_m * dot(d, s.forward)
    let du = normalize(vec2(s.right.x, s.right.z)) * px_at
    let dv = flat * (px_at / max(-d.y, 0.01))
    let (wave, n0, foam_k, squeezed, lost0, rest) = surface_at(waves, xz, du, dv, tiles(calm))
    // Where the skiff has been: its slick, its ripples, its spray falling back.
    let (n, splash) = stirred(s, xz, rest, n0)
    // (Far off, the wind's lanes: broad patches of rougher and smoother water, as its gusts
    // leave them, foreshortened to long bands of brighter and duller sheen toward the horizon.)
    let lanes = noise(xz * vec2(0.004, 0.0012) + vec2(s.held * 0.003, 5.0))
    let lost = lost0 *
        mix(1.0, mix(0.3, 2.0, smoothstep(0.25, 0.75, lanes)), smoothstep(60.0, 400.0, t))
    let l = h.light.sun
    let v = -d
    let nv = max(dot(n, v), 0.0)
    // What reaches it of the sun: the clouds' shadow and the skiff's.
    // (Far from the skiff, its distance isn't needed to know it's far: skip the march. This one
    // distance serves the shadow here and the reflection below.)
    let near = if length(p - s.boat - s.boat_y * 2.0) > 9.0 { 9.0 } else { skiff(s, p) }
    let boat_shadow = if near < 4.0 { skiff_shadow(s, p + vec3(0.0, 0.02, 0.0), l) } else { 1.0 }
    let sun = cloud_shadow(h.clouds, cloud, smp, p) * boat_shadow
    // The reflected sky and clouds, Fresnel's share of it (water's F0, 0.02), and the sun's glint.
    var r = d - 2.0 * dot(d, n) * n
    r.y = abs(r.y)
    // What the pixel mirrors is what the facets it holds but can't draw mirror, each its own
    // tilt (the slopes it lost, `lost`, a normal spread): four of them, a quarter of the slopes
    // each, along the view, as many seen as their faces turn to the eye (a facet turned away is
    // hidden behind the wave before it), each reflecting its own sky by its own Fresnel. So a
    // rough sea seen low mirrors its facets' higher, deeper sky, and less of it, and lies darker
    // than the bright sky over the horizon, as a real sea does, its glitter bright on it (the
    // ocean BRDF of Bruneton, Neyret and Holzschuch, 2010).
    let slope = sqrt(lost.y)
    let rise = asin(clamp(r.y, 0.0, 1.0))
    let across = normalize(vec2(r.x, r.z) + vec2(1.0e-6, 0.0))
    var mirrored = vec3(0.0)
    var fresnel = 0.0
    var seen = 0.0
    for k in 0..4 {
        let tilt = slope * QUARTILES[k]
        let w = max(nv + tilt * sqrt(max(1.0 - nv * nv, 0.0)), 0.0) + 1.0e-4
        let e = max(rise + 2.0 * atan(tilt), 0.002)
        let rk = vec3(across.x * cos(e), sin(e), across.y * cos(e))
        let facing = sqrt(max((1.0 + dot(-d, rk)) * 0.5, 0.0))
        let f = 0.02 + 0.98 * pow(1.0 - facing, 5.0)
        mirrored += mirrored_sky(view, h.light, rk, dome, smp) * w * f
        fresnel += w * f
        seen += w
    }
    mirrored /= max(fresnel, 1.0e-6)
    fresnel /= seen
    // The isle's reflection, far out on the water: the rock as its own pass met it (`yonder`),
    // where the water's own mirrored ray looks (from so far, the eye's view of it serves), so
    // the waves under it break it as they break the sky's.
    if t > 60.0 {
        let r0 = normalize(vec3(r.x, max(r.y, 0.002), r.z))
        let z = dot(r0, s.forward)
        if z > 0.0 {
            let uv = vec2(dot(r0, s.right), -dot(r0, s.up)) * (s.focal / z)
            let at = (uv * s.resolution.y + s.resolution) * 0.5
            // (Only where that lands on the screen, fading at its edges: past them the
            // texture's edge would smear across the water.)
            let inside = smoothstep(0.0, 8.0, min(min(at.x, at.y), 1.0e5)) *
                smoothstep(0.0, 8.0, min(s.resolution.x - at.x, s.resolution.y - at.y))
            // (The rock's alone: the sea's own stacks stand near, where the eye's view of them is
            // not the water's.)
            let what = yon_marks.sample_level(smp, at / s.resolution)
            if inside > 0.0 && exp2(what.x) > 2500.0 {
                let far = yon.sample_level(smp, at / s.resolution) * inside
                mirrored = mirrored * (1.0 - far.a) + far.rgb
            }
        }
    }
    // The skiff's own reflection beside it: the hull's own colours in the shade it hangs in,
    // its edge soft (how near the mirrored ray came to it) and broken by the ripples, and gone a
    // few metres down it.
    let near_hull = near
    if near_hull < 4.5 {
        let mr = mirror_skiff(s, p + vec3(0.0, 0.02, 0.0), r, 0.02, 7.0)
        // (Only its nearest metres: on a sea this rough the tall sail's mirror breaks up long before
        // it reaches the eye, and kept whole it hangs down the water as a ruled bar of light.)
        let cover = (1.0 - smoothstep(0.0, 0.06, mr.y)) *
            smoothstep(2.5, 0.4, mr.x) *
            (0.4 + 0.6 * noise(p.xz * 3.0 + vec2(s.held * 1.3, 0.0)))
        if cover > 0.0 {
            let q = p + vec3(0.0, 0.02, 0.0) + r * min(mr.x, 7.0)
            let qn = skiff_normal(s, q)
            let (albedo, _, _) = skiff_material(s, q, qn)
            let shade = storm_sky(view, h.light, vec3(y: 1.0), dome, smp, disc: false).rgb *
                PI *
                0.35 +
                h.light.sun_colour * 0.12
            // (What the water mirrors there is the hull's lower side, turned from the sky and
            // wet: darker than its lit topsides, or the mirror reads as a bright gap under it.)
            mirrored = mix(mirrored, albedo * shade * 0.45, 0.6 * cover)
        }
        // (Against the hull, the water mirrors the hull and not the sky: a dark seam where it
        // stands on the sea, so it sits in it rather than over it.)
        mirrored *= mix(0.45, 1.0, smoothstep(0.02, 0.4, near_hull))
    }
    let spread = storm_sky(
        view,
        h.light,
        normalize(r + vec3(0.0, 0.5, 0.0)),
        dome,
        smp,
        disc: false,
    ).rgb
    let reflected = mix(mirrored, spread, 0.15 * detail)
    // The sun's glitter: its mean, the facets' mirror as the pixel holds them (spread most down
    // the view, where the footprint lost most), and that mean gathered into the points it is.
    // A glint is the sun's mirror in one small facet, as bright as the facet is large to the
    // pixel: near, a pixel holds a few, each burning white, the water dark between; far off, a
    // pixel holds hundreds and the path is a smooth blaze. (So of the mean, as much is drawn as
    // points as the points a pixel can hold carry; the rest lies smooth.)
    let along = vec3(flat.x, 0.0, flat.y)
    let wind = normalize(SEA_STATE.wind)
    let rough = vec2(sqrt(0.004 + 2.4 * lost.x), sqrt(0.004 + 2.4 * lost.y))
    // (Its colour the sun's as the frame draws its disc: burnt toward a warm white.)
    let sun_seen = mix(h.light.sun_colour, vec3(1.0, 0.84, 0.55) * luma(h.light.sun_colour), 0.55)
    let mean = sun_seen * glitter(n, l, v, along, rough) * sun * 2.0
    let slant = max(-d.y, 0.003)
    let footprint_m2 = px_at * px_at / slant
    let peak = clamp(SPARK_GLINT / footprint_m2, 4.0, SPARK_PEAK)
    // (No points where the mean is faint: off the sun's path the facets that could mirror it are
    // too few to see, not a dust of them.)
    let gate = smoothstep(0.04, 0.3, luma(mean))
    let needed = luma(mean) * gate / (peak * 0.5 * 2.0 * PI * SPARK * SPARK)
    let pointed = min(1.0, SPARK_ROOM / max(needed, 1.0e-6)) * gate
    // The points gather on the faces of the wavelets too small to draw that turn to the sun,
    // in drifts that run with the waves, the water dark between (held to their mean where a
    // pixel is too long to hold one).
    let drift = rest - wind * (1.6 * s.held)
    let gather_raw = smoothstep(
        0.3,
        0.7,
        noise(drift * vec2(1.3, 0.9) + vec2(4.0, 2.0)) * 0.6 + noise(drift * 0.4 + vec2(9.0)) * 0.4,
    ) *
        2.2
    let gather = mix(gather_raw, 1.0, smoothstep(0.6, 3.0, length(dv)))
    let points = sparkle(
        rest,
        flat,
        du,
        flat * (px_at / slant),
        s.held,
        needed * pointed * gather,
    ) *
        gather
    // What the points don't carry lies smooth, held under white (so the water between them stays
    // water, a warm gold, and what they'd carry they burn the brighter for), a little less held
    // far off. Its colour the sun's, as the reflected sky warms it: the path a brighter gold
    // under its white glints, not a grey plate.
    let spread_ = mean * (1.0 - pointed)
    let held_under = mix(0.2, 1.2, smoothstep(0.3, 12.0, footprint_m2))
    let kept_l = held_under * log(1.0 + luma(spread_) / held_under)
    let hue = mix(
        spread_ / max(luma(spread_), 1.0e-5),
        reflected / max(luma(reflected), 1.0e-5),
        0.3,
    )
    let kept_ = hue * kept_l
    let cut = luma(spread_) - kept_l
    let carried = mean * pointed
    let glint = kept_ + carried * points * (1.0 + cut / max(luma(carried), 1.0e-4))
    // The light that comes back up out of the water: deep blue-green, brighter through the
    // crests lit from behind.
    // (Under the rock, less of it: the rock's mass hides a great piece of the sky over the water
    // there, a darker pool on the sea round its foot.)
    let sky_up = storm_sky(view, h.light, vec3(y: 1.0), dome, smp, disc: false).rgb *
        PI *
        (1.0 - under_isle(p))
    let body = vec3(0.018, 0.068, 0.082) * (h.light.sun_colour * max(l.y, 0.0) * sun + sky_up)
    let behind = pow(max(dot(normalize(vec3(-d.x, 0.0, -d.z)), -l) * 0.5 + 0.5, 0.0), 4.0)
    // The sun through the waves' crests: their thin tops, where the waves crowd and sharpen,
    // glowing green on the faces turned to the eye, most when the eye looks toward the sun
    // and low across the water (from high over it, it sees the deep water's own dark instead).
    let crest = smoothstep(0.02, 0.5, 1.0 - squeezed)
    let facing = clamp(0.5 + dot(vec2(n.x, n.z), -flat) * 5.0, 0.0, 1.0)
    let through = vec3(0.016, 0.056, 0.066) *
        h.light.sun_colour *
        sun *
        (0.12 + behind) *
        (0.12 + 2.2 * crest) *
        facing *
        clamp(1.0 - t / 700.0, 0.0, 1.0) *
        (1.0 - smoothstep(0.25, 0.75, -d.y))
    var c = (body + through) * (1.0 - fresnel) + reflected * fresnel + glint
    // The white horses: foam where a crest broke (`foam_k`, left by the ocean where its water was
    // squeezed till it folded, fading over a few seconds), torn into lace that rides with the
    // water (laid on where its water rests, `rest`), lace that a pixel too wide to hold reads as
    // its mean.
    // (Its lace streaked down the wind, as the wind draws foam out.)
    let wa = vec2(dot(rest, wind), dot(rest, vec2(-wind.y, wind.x)))
    let lace = noise(wa * vec2(0.6, 3.2) + vec2(3.0, 9.0)) * 0.5 +
        noise(wa * vec2(4.0, 9.0) + vec2(7.0, 1.0)) * 0.32 +
        noise(wa * vec2(13.0, 24.0)) * 0.18
    // Within it, the foam's a raft of bubbles: walls of froth round holes of thinner foam and
    // clear water, two sizes of them, streaked down the wind; and over them the lace's clots.
    // How much froth there is at a point (`mass`) is how fresh the foam is there times how thick
    // the raft is: fresh, thick walls round thin, see-through cells; fading, only the walls'
    // threads; then specks. Where a pixel's too wide to hold the raft, its mean.
    // (The raft's walls wander and thicken and thin as the water's eddies have drawn them, never
    // a net's ruled mesh.)
    // (Three sizes of cell, each drawn out down the wind into streaks, so its holes are slots
    // and tears, not a net's even mesh; how big they run wandering across the raft.)
    let wq = wa * vec2(0.55, 2.0)
    let warp = vec2(noise(wq * 0.5 + vec2(2.1, 8.3)), noise(wq * 0.5 + vec2(6.7, 3.9))) - vec2(0.5)
    let c1 = cells(wq + warp * 2.2 + vec2(0.3, 5.1))
    let c2 = cells(wa * vec2(1.6, 5.2) + warp * 3.0 + vec2(8.2, 1.7))
    let c3 = cells(wa * vec2(5.0, 13.0) + warp * 4.0 + vec2(1.4, 6.6))
    let web_k = clamp(1.0 - px_m * 3.0, 0.0, 1.0)
    let walls = 0.12 + 0.7 * lace * lace
    let raft = (1.0 - smoothstep(0.0, walls, c1.y - c1.x)) * 0.35 +
        (1.0 - smoothstep(0.0, walls * 0.9, c2.y - c2.x)) * 0.25 +
        (1.0 - smoothstep(0.0, 0.3, c3.y - c3.x)) * 0.12 +
        lace * 0.28
    let thick = mix(0.48, raft, web_k)
    // (Where it's freshest, at the breaking crest itself, it's a thicker mass of froth, its holes
    // fewer.)
    let mass = sqrt(foam_k) * (0.35 + 1.25 * thick) + pow(foam_k, 4.0) * 0.5
    // (Its outer edge feathered and torn, never a cut-out's.)
    let rim = smoothstep(0.04, 0.3, foam_k + (lace - 0.5) * 0.35)
    let white = smoothstep(0.38, 0.95, mass) * rim
    // (Its thick froth bright, its thin film greyer, the water showing through it.)
    let froth = mix(
        0.5,
        noise(wa * vec2(30.0, 45.0)) * 0.6 + noise(wa * vec2(8.0, 12.0) + vec2(2.0)) * 0.4,
        clamp(1.0 - px_m * 8.0, 0.0, 1.0),
    )
    let bright = (0.4 + 0.6 * smoothstep(0.5, 1.4, mass)) * (0.7 + 0.5 * froth)
    // Under it and round it, the water's paler and greener, full of the bubbles the break drove
    // down, as the water under a whitecap is.
    let bubbles = smoothstep(mix(0.02, 0.2, h.light.storm), 0.5, foam_k)
    // The skiff's wake, and the lip of broken water along its waterline (`wake`).
    let (wake, foam, wl, aer) = marks(s, p, xz, rest)
    // (Foam's a froth of bubbles: lit by the sun on it, and through it from behind when the eye
    // looks toward the sun, as a cloud's edge is; warm, not the sky's lilac.)
    // (And whiter than the light on it, as a froth's many bubbles scatter every colour alike: it
    // reads as foam on the gold, not more gold.)
    // (Lit as the water under it leans: the faces turned to the sun warm and bright, the rest in
    // the sky's blue-grey.)
    let toward_l = max(dot(n, l) + 0.3, 0.0) / 1.3
    let foam_lit = vec3(0.92, 0.92, 0.9) *
        (h.light.sun_colour * (toward_l * 1.6 + 0.12 + 0.8 * behind) * sun + sky_up * 1.3) /
        PI
    let foam_light = mix(foam_lit, vec3(luma(foam_lit)) * vec3(1.0, 0.97, 0.94), 0.45) * 1.6
    c *= mix(0.45, 1.0, smoothstep(0.0, 0.3, max(wl, 0.0)))
    c += body *
        (1.0 - fresnel) *
        mix(2.6, 0.9, h.light.storm) *
        max(bubbles, aer * 0.3) *
        (1.0 - white)
    c = mix(c, foam_light * bright, white * 0.92)
    c = mix(c, foam_light, max(max(foam * 0.9, wake), splash))
    // The crests' ink strokes and pale lips, light: the ink sits on the water's form.
    let footprint = t * 2.0 / (s.resolution.y * s.focal)
    let crest_ink = if LOOK > 2.5 { vec2(0.0) } else {
        strokes(xz, s.held, footprint, d, wave) * clamp(1.0 - t / 70.0, 0.0, 1.0)
    }
    // (The painted look keeps the lips, a brush's light; the cel look the ink too, drawn; the
    // clean look neither.)
    let lips = if LOOK > 2.5 { 0.0 } else if LOOK > 1.5 { 0.5 } else { 0.35 }
    let crest_dark = if LOOK > 2.5 || (LOOK > 0.5 && LOOK < 1.5) { 0.0 } else { 0.45 }
    c = mix(c, c * 1.6 + vec3(0.02, 0.04, 0.045), crest_ink.y * lips)
    c = mix(c, c * 0.35, crest_ink.x * crest_dark)
    // The bow's cut: where the ink frays, more when it slaps down.
    let bow = clamp(dot(p - s.boat, s.boat_z) / 2.2, 0.0, 1.0)
    let cut = exp(-max(near, 0.0) / (0.18 + 0.25 * s.slap)) * (0.15 + 0.25 * bow + 0.45 * s.slap)
    let line = 0.5 - foam
    // Where the lantern's beams fall on the water, its colours lie on the waves.
    if s.lantern > 0.5 {
        let apex = beam_apex()
        for k in 0..6 {
            let e = beam_heading(k, s.held)
            let len = apex.y / -e.y
            let foot = apex + e * len
            let head = normalize(vec2(e.x, e.z))
            let rel = xz - vec2(foot.x, foot.z)
            let along = dot(rel, head)
            let across = dot(rel, vec2(-head.y, head.x))
            let r = 16.0 + len * 0.028
            let pool = exp(-(along * along / (r * r * 4.0) + across * across / (r * r)))
            let shimmer = 0.6 + 0.8 * smoothstep(0.4, 0.8, noise(xz * 0.05 + vec2(s.held * 0.3)))
            c += h.light.sun_colour * BEAM_TINT[k] * 0.05 * pool * shimmer
        }
    }
    let aired = aired(aerial, smp, h.light, c, p, s.eye)
    // Far out, the sea and the sky meet in the air: no ruled edge where they do.
    let horizon_sky = heaven(view, h.light, normalize(vec3(d.x, 0.006, d.z)), dome, smp).rgb
    let hazy = mix(aired, horizon_sky, smoothstep(2500.0, 30000.0, t) * 0.85)
    (hazy, line, detail * 0.6 + foam, n, cut)
}

/// A flock: gulls nearer and farther, each a dark V beating its wings. `BIRDS` (where, the
/// world's; and how far each drifts). (None so far that it's a pixel: a gull a pixel wide reads
/// as a dead one on the screen, not a bird. And none seen against the far rock: there a gull a
/// few hundred metres off reads at the rock's distance, a hundred metres wide, and shrinks it.)
const BIRDS = [
    vec4(18.0, 19.0, 110.0, 1.0),
    vec4(23.0, 21.0, 116.0, 2.0),
    vec4(14.0, 17.5, 121.0, 3.0),
    vec4(61.0, 31.0, 258.0, 4.0),
    vec4(64.0, 32.0, 261.0, 5.0),
    vec4(58.0, 30.2, 264.0, 6.0),
    vec4(66.0, 30.5, 254.0, 7.0),
    vec4(26.0, 11.0, 70.0, 8.0),
]

/// How much of a gull covers this pixel `px` (0 to 1), and how far it is.
fn birds(s: Shot, px: vec2) -> vec2 {
    let uv = (px * 2.0 - s.resolution) / s.resolution.y
    var cover = 0.0
    var far = 1.0e9
    for i in 0..8 {
        let b = BIRDS[i]
        let at = vec3(b.x, b.y, b.z) +
            vec3(
                sin(s.held * 0.3 + b.w) * 6.0 + s.held * 4.0,
                sin(s.held * 0.7 + b.w * 2.0) * 1.5,
                cos(s.held * 0.25 + b.w) * 5.0,
            )
        let v = at - s.eye
        let along = dot(v, s.forward)
        if along > 1.0 {
            let pb = vec2(dot(v, s.right), -dot(v, s.up)) * s.focal / along
            let scale = s.resolution.y * 0.5 * s.focal / along
            let q = (uv - pb) * s.resolution.y * 0.5 / max(scale, 1.0e-3)
            let flap = sin(s.held * 7.0 + b.w * 1.7) * 0.35
            let x = abs(q.x)
            let wing = q.y + (x * (0.45 + flap) - x * x * 0.35)
            let dist = abs(wing) * scale
            let on = smoothstep(0.9, 0.3, dist) * step(x, 0.8) * smoothstep(0.0, 0.05, x + 0.02)
            if on > cover {
                cover = on
                far = length(v)
            }
        }
    }
    vec2(cover, far)
}

/// What one ray through `px` meets and how it's lit: the colour, and what the ink reads (log₂
/// distance, what it is, the line field, the line's weight; the normal and the energy).
fn sample(
    s: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    waves: Waves,
    yon_colour: Texture<Rgba16Float>,
    yon_marks: Texture<Rgba16Float>,
    yon_normal: Texture<Rgba8>,
    px: vec2,
) -> (vec3, vec4, vec4) {
    let h = Heaven { light, clouds }
    let d = ray(s, px)
    let o = s.eye
    let far = 1.0e5
    var t = far
    var id = SKY
    let ts = trace_sea(s, waves, o, d, far)
    if ts < far {
        t = ts
        id = SEA
    }
    let bs = sphere(o, d, vec4(s.boat + s.boat_y * (1.5 + FREEBOARD), 4.0), far)
    // The sea inside the skiff isn't there: the ray goes on to the hull.
    if id == SEA && dry(s, o + d * t) {
        t = far
        id = SKY
    }
    if bs.x < t && (OFF & 16) == 0 {
        let tb = march_skiff(s, o, d, bs.x, min(bs.y, t))
        if tb < min(bs.y, t) {
            t = tb
            id = SKIFF
        }
    }
    var c = vec3(0.0)
    var line = 1.0
    var weight = 0.0
    var n = vec3(y: 1.0)
    var energy = 0.0
    let p = o + d * t
    if id == SKY {
        let sky = heaven(view, light, d, dome, smp)
        c = sky.rgb
        line = 0.45 - sky.a
        weight = 0.0
        n = -d
    } else if id == SEA && (OFF & 64) != 0 {
        c = vec3(0.02, 0.03, 0.04)
        n = vec3(y: 1.0)
    } else if id == SEA {
        let (sc, sl, sw, sn, se) = sea_shade(
            s,
            h,
            view,
            aerial,
            dome,
            cloud,
            smp,
            waves,
            yon_colour,
            yon_marks,
            p,
            d,
            t,
        )
        c = sc
        line = sl
        weight = sw
        n = sn
        energy = se
    } else if id == SKIFF {
        n = skiff_normal(s, p)
        let (albedo, rough, seam) = skiff_material(s, p, n)
        let sun = skiff_shadow(s, p + n * 0.01, light.sun) * cloud_shadow(clouds, cloud, smp, p)
        let ao = skiff_ao(s, p, n)
        c = lit_solid(
            s,
            h,
            view,
            aerial,
            dome,
            smp,
            p,
            n,
            d,
            albedo,
            rough,
            0.0,
            vec3(0.0),
            sun,
            ao,
            0.0,
            1.0,
        )
        // The player's skiff is lit as a character is, never lost in the shade: the bright sea's
        // light thrown up onto it, warm off the sun's path on the water, and a rim of the sun.
        let sea_light = storm_sky(
            view,
            light,
            normalize(vec3(light.sun.x, 0.25, light.sun.z)),
            dome,
            smp,
            disc: false,
        ).rgb
        // (The CG looks light it as a hero is against the sun: less fill, so its shade side
        // holds its value against the bright sea, and a stronger rim; the cel look's both hard.)
        let cg = LOOK > 0.5
        let cel = LOOK > 1.5 && LOOK < 2.5
        let toward = max(dot(n, normalize(vec3(light.sun.x, -0.4, light.sun.z))), 0.0)
        // (Under the overcast, more of it: the deck's light all round is all it has.)
        let bounce = sea_light * PI * (if cg { 0.13 } else {
            0.22
        }) * mix(1.0, 2.2, light.storm) * (0.4 + 0.6 * ao) * (0.5 + 0.5 * (if cel {
            band(toward, 0.3, 0.04)
        } else { toward }))
        let edge_k = pow(1.0 - max(dot(n, -d), 0.0), 3.0) *
            max(dot(n, normalize(vec3(light.sun.x, 0.3, light.sun.z))), 0.0)
        let rim = light.sun_colour * vec3(1.0, 0.85, 0.6) * (if cel {
            band(edge_k, 0.12, 0.02) * 0.3
        } else if cg { 0.6 * edge_k } else {
            0.35 * edge_k
        })
        c += albedo * bounce + rim * sun
        // The waterline: the hull dark where the sea has wet it.
        let at_hull = sea_level(s, waves, p, 0.02)
        let wet = smoothstep(0.2, 0.02, p.y - at_hull)
        c *= 1.0 - 0.65 * wet
        // (And the planks nearest the sea in the dark the sea throws up, not the sky's light:
        // the hull's lower side falls off toward the water, so it sits down in the sea.)
        c *= mix(0.5, 1.0, smoothstep(0.0, 0.45, p.y - at_hull))
        line = seam
        weight = 0.8
        energy = s.slap * 0.35
    }
    // The rock, the cathedral and their falls, met in a pass of their own (`yonder`), over what
    // this ray met behind them: unless what it met is nearer.
    let q = clamp(floor(px), vec2(0.0), s.resolution - vec2(1.0))
    let fc = yon_colour.load(u32(q.x), u32(q.y))
    if fc.a > 0.0 {
        let fm = yon_marks.load(u32(q.x), u32(q.y))
        if id == SKY || exp2(fm.x) < t {
            c = c * (1.0 - fc.a) + fc.rgb
            if fc.a > 0.5 {
                t = exp2(fm.x)
                id = fm.y
                line = fm.z
                weight = fm.w
                n = yon_normal.load(u32(q.x), u32(q.y)).xyz * 2.0 - 1.0
            }
        }
    }
    // The falls, fresh each drawing, in front of what's behind them (the rock too).
    let (fall, _) = if (OFF & 8) == 0 { falls(s, h, view, aerial, dome, smp, o, d, t) } else {
        (vec4(0.0), t)
    }
    c = c * (1.0 - fall.a) + fall.rgb
    // (Its drops lit by the deck's light from above, and the sun through them toward it.)
    let toward = pow(max(dot(d, light.sun), 0.0), 6.0)
    let drops_lit = light.sun_colour * (0.9 + 9.0 * toward) +
        vec3(0.22, 0.25, 0.29) * mix(1.0, 1.6, light.storm)
    let thrown = if (OFF & 128) == 0 { spray(s, drops_lit, o, d, t) } else { vec4(0.0) }
    c = c * (1.0 - thrown.a) + thrown.rgb
    if s.lantern > 0.5 {
        let beam = beams(s, h, aerial, smp, o, d, t)
        c = c * (1.0 - beam.a) + beam.rgb
    }
    let gull = birds(s, px)
    if gull.y < t {
        c = mix(c, c * mix(0.12, 0.75, clamp(gull.y / 1200.0, 0.0, 0.85)) + vec3(0.01), gull.x)
    }
    // The cathedral's shine: a warm light held in the air round it, far off, over all but the
    // skiff.
    // Behind the spires it's strongest: they stand dark-edged and gilt against it.
    if id != SKIFF && t > 400.0 {
        let k = max(dot(d, s.glow), 0.0)
        let over = if id == SKY { 1.0 } else { 0.0 }
        c += light.sun_colour * vec3(1.0, 0.8, 0.5) * (0.05 * pow(k, 250.0) + (if LOOK > 2.5 {
            0.0
        } else { 0.85 }) * pow(k, 1400.0)) * over
    }
    (c, vec4(log2(max(t, 0.01)), id, line, weight), vec4(n * 0.5 + 0.5, clamp(energy, 0.0, 1.0)))
}

/// Four places in a pixel, on a turned grid: each its own row and column.
const WITHIN = [vec2(0.125, -0.375), vec2(-0.375, -0.125), vec2(0.375, 0.125), vec2(-0.125, 0.375)]

/// What the paint makes of pixel `px` (its centre, the drawing's pixels): the colour, and what
/// the ink reads.
fn paint_at(
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    waves: Waves,
    yon_colour: Texture<Rgba16Float>,
    yon_marks: Texture<Rgba16Float>,
    yon_normal: Texture<Rgba8>,
    px: vec2,
) -> (vec4, vec4, vec4) {
    let s = shot
    // Where the ray passes near the skiff, what's finer than a pixel (the hull's edge, the
    // paddle) is met four times over and averaged, so it neither stairs nor crawls as the eye
    // moves. Elsewhere, once. (Round the skiff the four fade to the one over its last metre, so
    // no ring shows where they stop; and each weighed down as it's bright, so one spark in four
    // doesn't flicker the whole pixel.) The rock and the cathedral are met in their own pass
    // (`yonder`), over many drawings.
    let d = ray(s, px)
    let to_boat = s.boat + s.boat_y * (1.5 + FREEBOARD) - s.eye
    let pass = length(to_boat - d * dot(to_boat, d))
    let boat_k = if dot(to_boat, d) > 0.0 { smoothstep(3.8, 2.9, pass) } else { 0.0 }
    // (One call of `sample` in one loop, met once or four times: written twice, the shader
    // would be over what a browser compiles as it loads.)
    var c = vec3(0.0)
    var marks = vec4(0.0)
    var third = vec4(0.0)
    var sum = vec3(0.0)
    var weight = 0.0
    var count = 1
    var i = 0
    while i < count {
        let off = if i == 0 {
            WITHIN[0] * (if s.fine > 0.5 { boat_k } else { 0.0 })
        } else { WITHIN[i] }
        let (ck, mk, tk) = sample(
            s,
            light,
            clouds,
            view,
            aerial,
            dome,
            cloud,
            smp,
            waves,
            yon_colour,
            yon_marks,
            yon_normal,
            px + off,
        )
        if i == 0 {
            c = ck
            marks = mk
            third = tk
            if boat_k > 0.0 && s.fine > 0.5 {
                count = 4
            }
        }
        let wk = 1.0 / (1.0 + luma(ck) * light.exposure)
        sum += ck * wk
        weight += wk
        i += 1
    }
    if count > 1 {
        c = mix(c, sum / weight, boat_k)
    }
    (vec4(c, 1.0), marks, third)
}

@fragment
pub fn paint(
    pixel: FragCoord,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    waves: Waves,
    yon_colour: Texture<Rgba16Float>,
    yon_marks: Texture<Rgba16Float>,
    yon_normal: Texture<Rgba8>,
) -> Targets3<vec4, vec4, vec4> {
    let (first, second, third) = paint_at(shot, light, clouds, view, aerial, dome, cloud, smp, waves, yon_colour, yon_marks, yon_normal, pixel.position.xy)
    Targets3 { first, second, third }
}

/// The paint for half the drawing's pixels (`main::HALF_PAINT`): this pass is half the drawing's
/// width, and its pixel (q, y) paints the drawing's (2q + `shift`, y). Out on the sea, every
/// other column: the sea's glints and foam lie along the rows, drawn out by the low eye, and the
/// fill between left and right keeps them whole (a checkerboard broke them into dots). Round the
/// skiff, a checkerboard: its mast, rigging and rider stand across the rows, and a column left
/// out would lose a rope a pixel wide. `paint_fill` fills the others.
@fragment
pub fn paint_half(
    pixel: FragCoord,
    shot: Shot,
    light: Light,
    clouds: Clouds,
    view: Texture<Rgba16Float>,
    aerial: Texture3d<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    smp: Sampler,
    waves: Waves,
    yon_colour: Texture<Rgba16Float>,
    yon_marks: Texture<Rgba16Float>,
    yon_normal: Texture<Rgba8>,
) -> Targets3<vec4, vec4, vec4> {
    let q = floor(pixel.position.xy)
    let x = q.x * 2.0 + f32(shift(shot, u32(q.x), u32(q.y)))
    let (first, second, third) = paint_at(shot, light, clouds, view, aerial, dome, cloud, smp, waves, yon_colour, yon_marks, yon_normal, vec2(x + 0.5, q.y + 0.5))
    Targets3 { first, second, third }
}

/// Which of its two pixels `paint_half`'s pixel `slot` in row `y` paints: 0 out on the sea; round
/// the skiff, 0 and 1 on alternate rows. (Decided for blocks of 16 by 16 drawing pixels, at each
/// one's middle, so a wave of the GPU's threads goes one way.)
fn shift(s: Shot, slot: u32, y: u32) -> u32 {
    let mid = vec2(f32((slot / 8) * 16 + 8), f32((y / 16) * 16 + 8))
    let d = ray(s, mid)
    let to_boat = s.boat + s.boat_y * (1.5 + FREEBOARD) - s.eye
    let along = dot(to_boat, d)
    let near = length(to_boat) < NEAR_SKIFF ||
        (along > 0.0 && length(to_boat - d * along) < NEAR_SKIFF)
    if near { y % 2 } else { 0 }
}

/// How near the skiff a block's middle ray passes (m, from its middle) to be painted as a
/// checkerboard (`shift`): the 4 m round it that `sample` meets the hull, sail and rider in, and a
/// block's width or so.
const NEAR_SKIFF: f32 = 5.5

/// Of drawing pixel (`x`, `y`) and its neighbours left, right, above and below: whether each was
/// painted (`paint_half`), and where in the half it is (its slot, its row).
struct Round: Copy {
    fresh: bool,
    mid: vec2u,
    left: bool,
    l: vec2u,
    right: bool,
    r: vec2u,
    above: bool,
    u: vec2u,
    below: bool,
    d: vec2u,
}

fn round_of(s: Shot, x: u32, y: u32, size: vec2) -> Round {
    let hw = u32((size.x + 1.0) * 0.5) - 1
    let hh = u32(size.y) - 1
    let q = min(x / 2, hw)
    let lq = if x > 0 { (x - 1) / 2 } else { 0 }
    let rq = min((x + 1) / 2, hw)
    let up = if y > 0 { y - 1 } else { 0 }
    let dn = min(y + 1, hh)
    Round {
        fresh: 2 * q + shift(s, q, y) == x,
        mid: vec2u(q, y),
        left: x > 0 && 2 * lq + shift(s, lq, y) == x - 1,
        l: vec2u(lq, y),
        right: 2 * rq + shift(s, rq, y) == x + 1,
        r: vec2u(rq, y),
        above: y > 0 && 2 * q + shift(s, q, up) == x,
        u: vec2u(q, up),
        below: y < hh && 2 * q + shift(s, q, dn) == x,
        d: vec2u(q, dn),
    }
}

/// The drawing's pixels from the half's (`paint_half`): those it painted as they are; each other
/// one between the pair of its painted neighbours, left and right or above and below, that
/// differ least (out on the sea there are only left and right), so an edge is followed along,
/// not blurred across; and what the ink reads, of the first of that pair. (A pass painting the
/// pixels on edges in full over these cost half of what the half saved, though they were only
/// one in thirty: a wave of the GPU's threads with one such pixel in it pays for all of it.)
@fragment
pub fn paint_fill(
    pixel: FragCoord,
    shot: Shot,
    size: vec2,
    half_colour: Texture<Rgba16Float>,
    half_marks: Texture<Rgba16Float>,
    half_normal: Texture<Rgba8>,
) -> Targets3<vec4, vec4, vec4> {
    let ip = floor(pixel.position.xy)
    let n = round_of(shot, u32(ip.x), u32(ip.y), size)
    if n.fresh {
        return Targets3 {
            first: half_colour.load(n.mid.x, n.mid.y),
            second: half_marks.load(n.mid.x, n.mid.y),
            third: half_normal.load(n.mid.x, n.mid.y),
        }
    }
    let cl = half_colour.load(n.l.x, n.l.y)
    let cr = half_colour.load(n.r.x, n.r.y)
    let cu = half_colour.load(n.u.x, n.u.y)
    let cd = half_colour.load(n.d.x, n.d.y)
    let across = if n.left && n.right { luma(abs(cl.rgb - cr.rgb)) } else { 1.0e9 }
    let down = if n.above && n.below { luma(abs(cu.rgb - cd.rgb)) } else { 1.0e9 }
    var c = half_colour.load(n.mid.x, n.mid.y)
    var at = n.mid
    if across < 1.0e9 && across <= down {
        c = (cl + cr) * 0.5
        at = n.l
    } else if down < 1.0e9 {
        c = (cu + cd) * 0.5
        at = n.u
    } else if n.left {
        c = cl
        at = n.l
    } else if n.right {
        c = cr
        at = n.r
    }
    // (The ink's reading is no mean: a line or a depth halfway between two isn't either's.)
    Targets3 { first: c, second: half_marks.load(at.x, at.y), third: half_normal.load(at.x, at.y) }
}
