// The engine's own sky over the opening: the air (`engine::air`: its scattering tables and its
// aerial perspective), the sun's light through it (`engine::light`), and the clouds
// (`engine::sky`: a field of cumulus marched into a dome round the eye, and their shadows), cooked
// over the first frames and marched a phase of the dome each frame after.

use engine::air::{Air, Tables, hazy, tables}
use engine::light::{Light, SUN_TOP, sunlight}
use engine::sky::{Clouds, Gap, MAP_BANDS, NOISE_SLICES, Sky, Weather, new_sky}
use engine::switches::Switches
use std::gpu::{Address, Sampler, sampler}
use std::math::PI
use look::{BREAK, LIFT, OVERCAST, SUN, THIN, VEIL, wind}

/// The engine's approved switches: the sky's march at full size.
pub struct Approved {}

impl Switches for Approved {}

/// The heavens: the air and its light, its tables, the clouds, and how far their cook has come.
pub struct Heavens {
    pub air: Air,
    pub light: Light,
    pub tables: Tables,
    pub sky: Sky,
    pub clouds: Clouds,
    pub linear: Sampler,
    pub repeat: Sampler,
    /// The cook's steps done: the tables (1), the noises (2), the weather and its shadow (3);
    /// after, the dome marches.
    cooked: u32,
}

/// The weather: overcast (`OVERCAST`). A deck of heavy cloud over the whole sky, thicker and
/// thinner in broad swells; no clear stretch toward the sun; a quick drift before the gale.
fn weather() -> Weather {
    Weather {
        clouds: Vec::new(),
        fair: 0.0,
        // (A break far off toward the sun: a lane across the view under it, `BREAK` m wide.)
        gap: Gap {
            a: normalize(vec2(SUN.x, SUN.z)) * 20000.0 + vec2(-SUN.z, SUN.x) * 9000.0,
            b: normalize(vec2(SUN.x, SUN.z)) * 20000.0 - vec2(-SUN.z, SUN.x) * 9000.0,
            radius: BREAK,
        },
        // (The deck goes with the sea's wind, faster up where it is.)
        wind: wind() * 12.0,
        overcast: OVERCAST,
        thin: THIN,
        // (Thinner behind the cathedral, as the eye sees the deck over its spires: a soft,
        // lighter reach for them to stand against.)
        veil: Gap { a: vec2(-1700.0, 7000.0), b: vec2(-2500.0, 11500.0), radius: VEIL },
    }
}

/// How fully the deck's own column shades it (`engine::sky::Clouds::gloom`): a little under
/// all, so its billows still take some of the light from above and show their form.
const GLOOM: f32 = 1.0

/// The share of the sun's light that comes through the overcast's deck.
const UNDER_DECK: f32 = 0.1

/// The heavens, the sun toward `sun`, seen from an eye `eye` m over the sea; uncooked.
pub fn heavens(sun: vec3, eye: f32) -> Heavens {
    // The engine's hazy air, cleared to a sea day's: less haze, so a thing 3 km off keeps its
    // form and its shadows.
    let air = Air {
        mie_scattering: 0.12,
        mie_absorption: 0.01,
        ..hazy(normalize(sun), SUN_TOP, eye),
    }
    // A touch brighter than the engine's default exposure: a sea under an open sky.
    // Under the overcast, what's below the deck has the sun's light only as far as it comes
    // through it: a tenth, all round (the deck itself is lit from above it, `engine::sky`), and
    // the rest of its light from the deck (`paint::storm_sky`). Exposed for that dimmer world.
    let open = sunlight(air)
    let light = Light {
        exposure: (0.66 + 0.75 * OVERCAST) * mix(1.0, LIFT, OVERCAST),
        sun_colour: open.sun_colour * mix(1.0, mix(UNDER_DECK, 0.3, THIN), OVERCAST),
        ..open,
    }
    // (A storm's deck: `engine::sky::Clouds::gloom`.)
    var sky = new_sky::<Approved>()
    sky.gloom = OVERCAST * GLOOM
    let clouds = sky.clouds::<Approved>(
        light,
        vec3(0.0, eye, 0.0),
        drift: vec2(0.0),
        still: true,
        forward: vec3(0.0, 0.0, 1.0),
        view: PI,
    )
    Heavens {
        air,
        light,
        tables: tables(),
        sky,
        clouds,
        linear: sampler(),
        repeat: sampler(address: Address::Repeat),
        cooked: 0,
    }
}

impl Heavens {
    /// This frame's step: a cook's, until all are in, then a phase of the dome from `eye`,
    /// looking along `forward`, the clouds drifted to `time`.
    pub fn step(mut self, eye: vec3, forward: vec3, time: f32) {
        if self.cooked == 0 {
            self.tables.cook(self.air, self.linear)
        } else if self.cooked == 1 {
            for k in 0..NOISE_SLICES {
                self.sky.cook_noise_slice(k)
            }
        } else if self.cooked == 2 {
            let w = weather()
            for band in 0..MAP_BANDS {
                self.sky.cook_weather_band(w, band)
            }
            self.sky.cook_shadow(self.light.sun, self.repeat, shadows: true)
        } else {
            let drift = weather().wind * time
            self.clouds = self.sky.march::<Approved>(
                self.air,
                self.light,
                self.tables,
                eye,
                drift: drift,
                rep: self.repeat,
                s: self.linear,
                still: true,
                forward: forward,
                view: PI,
            )
        }
        if self.cooked < 3 {
            self.cooked += 1
        }
    }

    /// Whether the dome has been marched whole.
    pub fn whole(self) -> bool {
        self.cooked >= 3 && self.sky.done()
    }
}
