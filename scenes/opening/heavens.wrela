// The engine's own sky over the opening: the air (`engine::air`: its scattering tables and its
// aerial perspective), the sun's light through it (`engine::light`), and the clouds
// (`engine::sky`: a field of cumulus marched into a dome round the eye, and their shadows), cooked
// over the first frames and marched a phase of the dome each frame after.

use engine::air::{Air, Tables, hazy, tables}
use engine::light::{Light, SUN_TOP, sunlight}
use engine::sky::{Clouds, Cumulus, Gap, MAP_BANDS, NOISE_SLICES, Sky, Weather, new_sky}
use engine::switches::Switches
use std::gpu::{Address, Sampler, sampler}
use std::math::PI

/// The engine's approved switches: the sky's march at full size.
pub struct Approved {}

impl Switches for Approved {}

/// The heavens: the air and its light, its tables, the clouds, and how far their cook has come.
pub struct Heavens {
    pub air: Air,
    pub light: Light,
    pub tables: Tables,
    pub sky: Sky,
    pub clouds: Clouds,
    pub linear: Sampler,
    pub repeat: Sampler,
    /// The cook's steps done: the tables (1), the noises (2), the weather and its shadow (3);
    /// after, the dome marches.
    cooked: u32,
}

/// The weather: overcast. A low deck of heavy cloud over the whole sky (great cumulus set close
/// on a grid, so their discs run together, and every fair-weather cloud the noise allows between
/// them), torn a little where the deck thins; no clear stretch toward the sun; a quick drift
/// before the gale.
fn weather() -> Weather {
    var clouds: Vec<Cumulus> = Vec::new()
    for i in 0..8 {
        for j in 0..8 {
            let jitter = vec2(f32((i * 7 + j * 3) % 5) - 2.0, f32((i * 3 + j * 5) % 5) - 2.0)
            clouds.push(
                Cumulus {
                    at: vec2(f32(i) * 6000.0 - 21000.0, f32(j) * 6000.0 - 21000.0) + jitter * 700.0,
                    wide: 12500.0,
                    tall: 1700.0 + 260.0 * f32((i * 5 + j * 11) % 7),
                },
            )
        }
    }
    Weather {
        clouds,
        fair: 2.5,
        gap: Gap { a: vec2(0.0, 0.0), b: vec2(0.0, 0.0), radius: 0.0 },
        wind: vec2(9.0, -14.0),
    }
}

/// The heavens, the sun toward `sun`, seen from an eye `eye` m over the sea; uncooked.
pub fn heavens(sun: vec3, eye: f32) -> Heavens {
    // The engine's hazy air, cleared to a sea day's: less haze, so a thing 3 km off keeps its
    // form and its shadows.
    let air = Air {
        mie_scattering: 0.22,
        mie_absorption: 0.01,
        ..hazy(normalize(sun), SUN_TOP, eye),
    }
    // A touch brighter than the engine's default exposure: a sea under an open sky.
    // Under the overcast, the sun's own light comes through the deck thinned to a fifth.
    let open = sunlight(air)
    let light = Light { exposure: 0.66, sun_colour: open.sun_colour * 0.22, ..open }
    let sky = new_sky::<Approved>()
    let clouds = sky.clouds::<Approved>(
        light,
        vec3(0.0, eye, 0.0),
        drift: vec2(0.0),
        still: true,
        forward: vec3(0.0, 0.0, 1.0),
        view: PI,
    )
    Heavens {
        air,
        light,
        tables: tables(),
        sky,
        clouds,
        linear: sampler(),
        repeat: sampler(address: Address::Repeat),
        cooked: 0,
    }
}

impl Heavens {
    /// This frame's step: a cook's, until all are in, then a phase of the dome from `eye`,
    /// looking along `forward`, the clouds drifted to `time`.
    pub fn step(mut self, eye: vec3, forward: vec3, time: f32) {
        if self.cooked == 0 {
            self.tables.cook(self.air, self.linear)
        } else if self.cooked == 1 {
            for k in 0..NOISE_SLICES {
                self.sky.cook_noise_slice(k)
            }
        } else if self.cooked == 2 {
            let w = weather()
            for band in 0..MAP_BANDS {
                self.sky.cook_weather_band(w, band)
            }
            self.sky.cook_shadow(self.light.sun, self.repeat, shadows: true)
        } else {
            let drift = weather().wind * time
            self.clouds = self.sky.march::<Approved>(
                self.air,
                self.light,
                self.tables,
                eye,
                drift: drift,
                rep: self.repeat,
                s: self.linear,
                still: true,
                forward: forward,
                view: PI,
            )
        }
        if self.cooked < 3 {
            self.cooked += 1
        }
    }

    /// Whether the dome has been marched whole.
    pub fn whole(self) -> bool {
        self.cooked >= 3 && self.sky.done()
    }
}
