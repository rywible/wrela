// The opening played by another program: wrela.dev's front page plays it live behind its own
// screen, and its Play hands the skiff to the player. The page makes the scene (`scene`), passes
// it the keys while the player sails (`input`), and each frame draws it into its `image` (`play`),
// which it lays on its own screen.

use main::{
    HALF_PAINT, HERO, KINETIC, LANTERN, LOOK, MIRROR_PHASES, MIRROR_TABLE, OFF, QUARTER, SPARSE,
    START, STYLE, VISTA, VISTA_SIZE,
}
use aboard::{Aboard, aboard}
use heavens::{Heavens, heavens}
use look::{SUN, Shot, shot_at}
use sea::{MID_CALM, RIDDEN, SEA, held}
use engine::ocean::{Ocean, Waves}
use engine::upscale::{Body, NO_BODY, Pinhole}
use paint::{MIRROR_H, MIRROR_W, OVERHEAD, cook_mirror, overhead_once, paint, paint_fill, paint_half}
use yonder::{
    FIELD_SIDE, FIELD_SLABS, REFRESH, Yon, cook_isle, far_merge, vista_carry, vista_lay, vista_look,
    vista_shot, yonder, yonder_low, yonder_rebuild,
}
use isle::isle_extent
use engine::far::{
    KEPT, MOST_SIDE, SWEEP, Vista, aimed, jumped, strayed, texels_needed, turn_texels, vista_fits,
    vista_side,
}
use ink::ink
use rock::{Rock, reach, rock, step_rock}
use weather::weather
use sail::{Rig, key, let_go, rest, step}
use std::collections::swap
use std::io::Pending
use std::input::Event
use std::gpu::{
    ClipPosition, DepthTexture, GpuBuffer, buffer, R32Float, Rg32Float, Rgba16Float, Rgba8, Texture,
    Texture3d, VertexIndex, begin_pass, begin_pass3, depth_texture, dispatch, draw, label, texture,
    texture3d, writable_texture,
}

/// How finely a live page meets the scene (`Shot::fine`): the rock and the cathedral four times
/// over a pixel, the rest once.
const LIVE_FINE: f32 = 0.3

pub struct State {
    pub(package) heavens: Heavens,
    /// The open sea, summed each drawing.
    pub(package) ocean: Ocean,
    /// The painted scene, and what the ink reads beside it: (log₂ distance, what it is, the
    /// line field, the line's weight) and the normal.
    pub(package) colour: Texture<Rgba16Float>,
    pub(package) marks: Texture<Rgba16Float>,
    pub(package) normal: Texture<Rgba8>,
    /// The painted scene with the weather laid over it (`weather`): what the ink reads.
    pub(package) aired: Texture<Rgba16Float>,
    /// The rock and the cathedral as their own pass met them over the drawings (`yonder`): this
    /// drawing's (their light, what the ink reads, the normal), the last's beside it, and where
    /// from and how many drawings they hold.
    pub(package) yon_colour: Texture<Rgba16Float>,
    pub(package) yon_marks: Texture<Rgba16Float>,
    pub(package) yon_normal: Texture<Rgba8>,
    pub(package) past_colour: Texture<Rgba16Float>,
    pub(package) past_marks: Texture<Rgba16Float>,
    pub(package) past_normal: Texture<Rgba8>,
    /// A quarter of them met afresh this drawing, at half the size each way (`main::QUARTER`).
    pub(package) low_colour: Texture<Rgba16Float>,
    pub(package) low_marks: Texture<Rgba16Float>,
    pub(package) low_normal: Texture<Rgba8>,
    /// Every other column of the paint, at half the width (`main::HALF_PAINT`).
    pub(package) half_colour: Texture<Rgba16Float>,
    pub(package) half_marks: Texture<Rgba16Float>,
    pub(package) half_normal: Texture<Rgba8>,
    pub(package) yon: Yon,
    pub(package) yon_shot: Shot,
    pub(package) yon_count: f32,
    pub(package) yon_seq: u32,
    /// The isle's field, cooked once over the first drawings (`yonder::cook_isle`), and how many
    /// of its slabs have been.
    pub(package) isle_field: Texture3d<R32Float>,
    pub(package) isle_cooked: u32,
    /// The rock and the cathedral as meshes (`rock`), and how far each pixel is to them, drawn
    /// each drawing, with its depth.
    pub(package) rock: Rock,
    pub(package) reach: Texture<Rg32Float>,
    pub(package) reach_depth: DepthTexture,
    /// The rock and the cathedral in a picture of their own, pinned to the world (`main::VISTA`):
    /// its view, whether it's been aimed yet, what it holds (`vista_*`) and what's written from it
    /// when it's carried to a new aim (`vista_new_*`, the two swapped after), whose turn it is, and the
    /// meshes' reach from its eye (`rock::reach`).
    pub(package) vista: Vista,
    pub(package) vista_aimed: bool,
    pub(package) vista_colour: Texture<Rgba16Float>,
    pub(package) vista_marks: Texture<Rgba16Float>,
    pub(package) vista_normal: Texture<Rgba16Float>,
    pub(package) vista_new_colour: Texture<Rgba16Float>,
    pub(package) vista_new_marks: Texture<Rgba16Float>,
    pub(package) vista_new_normal: Texture<Rgba16Float>,
    pub(package) vista_turn: u32,
    /// This drawing's looks at the vista, before they're laid in (`yonder::vista_look`).
    pub(package) vista_fresh_colour: GpuBuffer<vec4>,
    pub(package) vista_fresh_marks: GpuBuffer<vec4>,
    pub(package) vista_fresh_normal: GpuBuffer<vec4>,
    /// How many times the vista has been looked at whole since it was first aimed.
    pub(package) vista_sweeps: u32,
    /// Whether the vista serves this camera (`engine::far::vista_fits`): where it doesn't, the
    /// far pass draws the rock as ever, and the vista waits, not looked at.
    pub(package) vista_fits: bool,
    pub(package) vista_reach: Texture<Rg32Float>,
    pub(package) vista_depth: DepthTexture,
    pub(package) vista_meshed: u32,
    /// The storm's light (`Heavens::storm`) as the vista's sweep began, and whether it changed
    /// over the sweep before: while it changes, the vista keeps fewer looks (`VISTA_STIRRED`).
    pub(package) vista_storm: f32,
    pub(package) vista_stirred: bool,
    /// How much of the vista is laid in (`yonder::far_merge`): 0 to 1 over `VISTA_FADE` drawings
    /// once it's ready, and back as it stops serving the camera. Only once it's all in does the
    /// far pass leave the rock to it (`yonder::Yon::vista`).
    pub(package) vista_shown: f32,
    /// Whether the far pass left the rock to the vista last drawing (`yonder::Yon::vista`).
    pub(package) vista_in: bool,
    /// The far layer the paint reads: the stacks as `yonder` met them with the vista laid in
    /// (`yonder::far_merge`).
    pub(package) far_colour: Texture<Rgba16Float>,
    pub(package) far_marks: Texture<Rgba16Float>,
    pub(package) far_normal: Texture<Rgba8>,
    /// The inked drawing, at the drawing's size, where it's drawn below the screen's
    /// (`main::RENDER_SCALE`): brought up to the screen by `main::upscaled`.
    pub(package) inked: Texture<Rgba16Float>,
    /// The upscaler's histories at the screen's size (`engine::upscale`), written in turn
    /// (`flip`: `history_b` this frame), the size they're at, and whether they hold nothing
    /// true yet; this frame's jitter (the drawing's pixels) and camera unjittered, and the last.
    pub(package) history_a: Texture<Rgba16Float>,
    pub(package) history_b: Texture<Rgba16Float>,
    pub(package) history_size: (u32, u32),
    pub(package) flip: bool,
    pub(package) fresh: bool,
    pub(package) jitter: vec2,
    pub(package) pinhole: Pinhole,
    pub(package) last_pinhole: Pinhole,
    /// This drawing's shot unjittered: the far pass's, which settles its own pixels.
    pub(package) plain: Shot,
    pub(package) upscaled_frames: u32,
    /// The skiff's frame this drawing and the last, for the upscaler.
    pub(package) body: Body,
    pub(package) last_body: Body,
    /// What a tile not yet cooked reads for its shade (`rock::reach`).
    pub(package) unbaked: GpuBuffer<vec4>,
    /// The sky's colours the same for every pixel of the drawing (`paint::overhead_once`).
    pub(package) overhead: GpuBuffer<vec4>,
    /// The sky the sea mirrors, along each direction over the horizon, this drawing's
    /// (`paint::cook_mirror`).
    pub(package) mirror: Texture<Rgba16Float>,
    pub(package) mirror_phase: u32,
    /// Whether the mirror table was last worked out whole from the whole dome.
    pub(package) mirror_whole: bool,
    /// The passes' times asked for and not yet answered (which, the ask, its frame), and the
    /// frames drawn (`main::TIMINGS`).
    pub(package) asks: Vec<(u32, Pending<f32>, u32)>,
    pub(package) frames: u32,
    pub(package) width: u32,
    pub(package) height: u32,
    /// The skiff as the player sails it.
    pub(package) rig: Rig,
    /// The last drawing finished, inked, for a program that plays the scene behind its own
    /// screen (`play`), and its size; and the texture the next is inked into before they swap,
    /// so `image` is never one half drawn, nor blank while the scene changes size.
    pub image: Texture<Rgba8>,
    pub(package) image_size: (u32, u32),
    pub(package) spare: Texture<Rgba8>,
    pub(package) spare_size: (u32, u32),
    /// The drawing (`sea::held`'s time) last begun for `image`, its shot, and the band of its rows
    /// to paint next (0: none under way).
    pub(package) drawn: f32,
    pub(package) shot: Shot,
    pub(package) band: u32,
    /// The hero, realized, and what he's drawn into before he's laid over the paint (`aboard`).
    pub(package) aboard: Aboard,
}

pub(package) fn targets(heavens: take Heavens, width: u32, height: u32) -> State {
    let ocean = Ocean::new(SEA, RIDDEN, MID_CALM)
    let shot = shot_at(START, width, height, KINETIC, 0, rest(), ocean.swell)
    State {
        heavens,
        ocean,
        rig: rest(),
        colour: texture(width: width, height: height),
        marks: texture(width: width, height: height),
        normal: texture(width: width, height: height),
        aired: texture(width: width, height: height),
        yon_colour: texture(width: width, height: height),
        yon_marks: texture(width: width, height: height),
        yon_normal: texture(width: width, height: height),
        past_colour: texture(width: width, height: height),
        past_marks: texture(width: width, height: height),
        past_normal: texture(width: width, height: height),
        low_colour: texture(
            width: (width + SPARSE - 1) / SPARSE,
            height: (height + SPARSE - 1) / SPARSE,
        ),
        low_marks: texture(
            width: (width + SPARSE - 1) / SPARSE,
            height: (height + SPARSE - 1) / SPARSE,
        ),
        low_normal: texture(
            width: (width + SPARSE - 1) / SPARSE,
            height: (height + SPARSE - 1) / SPARSE,
        ),
        half_colour: texture(width: (width + 1) / 2, height: height),
        half_marks: texture(width: (width + 1) / 2, height: height),
        half_normal: texture(width: (width + 1) / 2, height: height),
        yon: afresh(shot),
        yon_shot: shot,
        yon_count: 0.0,
        yon_seq: 0,
        isle_field: texture3d::<R32Float>(FIELD_SIDE, FIELD_SIDE, FIELD_SIDE),
        isle_cooked: 0,
        rock: rock(),
        reach: texture(width: width, height: height),
        reach_depth: depth_texture(width, height),
        vista: aimed(shot.eye, isle_extent(), size: f32(VISTA_SIZE), margin: 0.04),
        vista_aimed: false,
        vista_colour: writable_texture::<Rgba16Float>(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_marks: writable_texture::<Rgba16Float>(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_normal: writable_texture::<Rgba16Float>(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_new_colour: writable_texture::<Rgba16Float>(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_new_marks: writable_texture::<Rgba16Float>(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_new_normal: writable_texture::<Rgba16Float>(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_turn: 0,
        vista_fresh_colour: buffer(VISTA_LOOKS),
        vista_fresh_marks: buffer(VISTA_LOOKS),
        vista_fresh_normal: buffer(VISTA_LOOKS),
        vista_sweeps: 0,
        vista_fits: false,
        vista_reach: texture(width: VISTA_SIZE, height: VISTA_SIZE),
        vista_depth: depth_texture(VISTA_SIZE, VISTA_SIZE),
        vista_meshed: 0,
        vista_storm: 0.0,
        vista_stirred: false,
        vista_shown: 0.0,
        vista_in: false,
        far_colour: texture(width: width, height: height),
        far_marks: texture(width: width, height: height),
        far_normal: texture(width: width, height: height),
        inked: texture(width: width, height: height),
        history_a: texture(width: 1, height: 1),
        history_b: texture(width: 1, height: 1),
        history_size: (1, 1),
        flip: false,
        fresh: true,
        jitter: vec2(0.0),
        pinhole: pinhole_of(shot),
        last_pinhole: pinhole_of(shot),
        upscaled_frames: 0,
        body: NO_BODY,
        last_body: NO_BODY,
        plain: shot,
        unbaked: buffer(1),
        overhead: buffer(OVERHEAD),
        mirror: writable_texture::<Rgba16Float>(width: MIRROR_W, height: MIRROR_H),
        mirror_phase: 0,
        mirror_whole: false,
        asks: Vec::new(),
        frames: 0,
        image: texture(width: 1, height: 1),
        image_size: (1, 1),
        spare: texture(width: 1, height: 1),
        spare_size: (1, 1),
        drawn: -1.0,
        shot,
        band: 0,
        aboard: aboard(),
        width,
        height,
    }
}

/// `shot`'s camera, as the upscaler reads it.
pub(package) fn pinhole_of(shot: Shot) -> Pinhole {
    Pinhole {
        eye: shot.eye,
        focal: shot.focal,
        forward: shot.forward,
        right: shot.right,
        up: shot.up,
        size: shot.resolution,
    }
}

/// `shot` with each pixel's ray through `px + j` (its pixels), not `px`.
fn jittered(shot: Shot, j: vec2) -> Shot {
    let k = 2.0 / (shot.resolution.y * shot.focal)
    Shot { forward: shot.forward + (shot.right * j.x - shot.up * j.y) * k, ..shot }
}

/// One triangle that covers the screen.
@vertex
pub(package) fn cover(vertex: VertexIndex) -> ClipPosition {
    let x = f32(vertex.index % 2) * 4.0 - 1.0
    let y = f32(vertex.index / 2) * 4.0 - 1.0
    ClipPosition { position: vec4(x, y, 0.0, 1.0) }
}

/// A camera that has met nothing yet: the next drawing starts afresh.
fn afresh(shot: Shot) -> Yon {
    Yon {
        eye: shot.eye,
        forward: shot.forward,
        right: shot.right,
        up: shot.up,
        focal: shot.focal,
        resolution: shot.resolution,
        held: 0.0,
        jitter: vec2(0.0),
        turn: 0,
        meshed: 0,
        rock_turn: 0,
        vista: 0,
    }
}

/// The `i`th of the Halton sequence in base `b`, in [0, 1).
fn halton(i: u32, b: u32) -> f32 {
    var f = 1.0
    var r = 0.0
    var n = i
    while n > 0 {
        f /= f32(b)
        r += f * f32(n % b)
        n /= b
    }
    r
}

/// The rock's pass made ready for a new drawing from `shot`: what the last met becomes what's
/// before, the last drawing's camera where it's carried from, and this one's offset in the
/// pixel the next of the sequence.
fn next_yon(s: mut State, shot: Shot) {
    swap(mut s.yon_colour, mut s.past_colour)
    swap(mut s.yon_marks, mut s.past_marks)
    swap(mut s.yon_normal, mut s.past_normal)
    let n = s.yon_count
    // (The sequence runs on past the most a pixel holds: held at its cap, the offset would stop
    // on one place and the crawl come back.)
    s.yon_seq += 1
    // (Met a quarter at a time, or the rock a block in four (`yonder::REFRESH`), each pixel's
    // offset steps on once in its four drawings: stepped each drawing, the four would each run
    // through only a part of the sequence.)
    let i = (if QUARTER { s.yon_seq / (SPARSE * SPARSE) } else if (OFF & 4096) == 0 {
        s.yon_seq / REFRESH
    } else { s.yon_seq }) % 16 + 1
    s.yon = Yon {
        held: n,
        jitter: vec2(halton(i, 2), halton(i, 3)) - vec2(0.5),
        turn: if QUARTER { s.yon_seq % (SPARSE * SPARSE) } else { s.yon_seq % REFRESH },
        rock_turn: (s.yon_seq / (SPARSE * SPARSE)) % 4,
        ..afresh(s.yon_shot),
    }
    s.yon_count = min(n + 1.0, 64.0)
    s.yon_shot = shot
}

/// The targets made again at a new size.
pub(package) fn sized(s: mut State, width: u32, height: u32) {
    if width != s.width || height != s.height {
        s.colour = texture(width: width, height: height)
        s.marks = texture(width: width, height: height)
        s.normal = texture(width: width, height: height)
        s.aired = texture(width: width, height: height)
        s.yon_colour = texture(width: width, height: height)
        s.yon_marks = texture(width: width, height: height)
        s.yon_normal = texture(width: width, height: height)
        s.past_colour = texture(width: width, height: height)
        s.past_marks = texture(width: width, height: height)
        s.past_normal = texture(width: width, height: height)
        s.low_colour = texture(
            width: (width + SPARSE - 1) / SPARSE,
            height: (height + SPARSE - 1) / SPARSE,
        )
        s.low_marks = texture(
            width: (width + SPARSE - 1) / SPARSE,
            height: (height + SPARSE - 1) / SPARSE,
        )
        s.low_normal = texture(
            width: (width + SPARSE - 1) / SPARSE,
            height: (height + SPARSE - 1) / SPARSE,
        )
        s.half_colour = texture(width: (width + 1) / 2, height: height)
        s.half_marks = texture(width: (width + 1) / 2, height: height)
        s.half_normal = texture(width: (width + 1) / 2, height: height)
        s.reach = texture(width: width, height: height)
        s.reach_depth = depth_texture(width, height)
        s.far_colour = texture(width: width, height: height)
        s.far_marks = texture(width: width, height: height)
        s.far_normal = texture(width: width, height: height)
        s.inked = texture(width: width, height: height)
        s.fresh = true
        s.yon_count = 0.0
        s.width = width
        s.height = height
    }
}

/// The scene stepped on to `time` and painted (the first pass) from view `view`, the camera swung
/// `orbit` radians round the skiff from where the sailing puts it and stood at `framing`
/// (`Rig::framing`), met `fine`ly (`Shot::fine`): the shot it was painted from.
pub(package) fn painted(
    s: mut State,
    time: f32,
    view: u32,
    orbit: f32,
    framing: f32,
    fine: f32,
) -> Shot {
    // (The rig stepped to the drawing's own time, as all else in it is: stepped to the frame's,
    // a drawing held over two frames carried two frames' motion into the next, every fifth frame
    // at 30 a second, a jolt the coat's cloth threw out wide for a frame.)
    step(mut s.rig, held(START + time), s.ocean.swell)
    let shot = prepared(mut s, time, view, orbit, framing, fine)
    paint_rows(mut s, shot, from: 0, to: s.height)
    stood(mut s, shot)
    shot
}

/// The hero drawn into the painted drawing (`aboard`), where he stands to the sail (`HERO`).
fn stood(s: mut State, shot: Shot) {
    if HERO > 0.5 {
        let (width, height) = (s.width, s.height)
        s.aboard.draw(
            shot,
            s.heavens,
            mut s.colour,
            mut s.marks,
            mut s.normal,
            width,
            height,
            s.overhead,
        )
    }
}

/// The shot at `time`, the camera at `framing` (`Rig::framing`), the sky and the sea stepped on
/// to it.
fn prepared(s: mut State, time: f32, view: u32, orbit: f32, framing: f32, fine: f32) -> Shot {
    var rig = s.rig
    rig.shown_look += orbit
    rig.framing = framing
    let shot = Shot {
        style: STYLE,
        look: LOOK,
        lantern: LANTERN,
        fine,
        ..shot_at(START + time, s.width, s.height, KINETIC, view, rig, s.ocean.swell),
    }
    s.heavens.step(shot.eye, shot.forward, START + time)
    let shot = Shot { storm: s.heavens.storm, wind: s.heavens.wind, ..shot }
    // (Its rays through each pixel moved by the upscaler's jitter, `s.jitter`; the camera as it
    // is, for the upscaler.)
    s.pinhole = pinhole_of(shot)
    s.plain = shot
    s.body = Body { at: shot.boat, x: shot.boat_x, y: shot.boat_y, z: shot.boat_z }
    next_yon(mut s, shot)
    // The sea as it is at this drawing.
    s.ocean.step(held(START + time))
    // The rock's meshes, and how far each pixel is to them.
    label("rock")
    let ready = step_rock(mut s.rock, shot, s.heavens.light.sun)
    let meshed = reach(s.rock, shot, ready, s.unbaked, mut s.reach, mut s.reach_depth)
    s.yon.meshed = if meshed { 1 } else { 0 }
    if VISTA {
        label("vista")
        aim_vista(mut s, shot)
        // (And again as soon as the rock is ready, if it wasn't when the sweep began: else a
        // whole sweep would march without it.)
        if s.vista_aimed && (s.vista_turn == 0 || (s.vista_meshed == 0 && ready)) {
            // (The meshes from the vista's eye: where its looks start marching, and their cooked
            // shade. Drawn again once a sweep: they're kilometres off, and change only as the
            // rock's tiles are cooked or met at another level.)
            let vm = reach(
                s.rock,
                vista_shot(s.vista, shot),
                ready,
                s.unbaked,
                mut s.vista_reach,
                mut s.vista_depth,
            )
            s.vista_meshed = if vm { 1 } else { 0 }
        }
        // (Laid in once it has looked at them whole a few times: till then, on a first load, the
        // far pass meets them as it did, and they don't come in a few looks at a time.)
        let laid = s.vista_aimed && s.vista_fits && s.vista_sweeps >= VISTA_READY
        s.vista_shown = if !s.vista_aimed { 0.0 } else if laid {
            min(s.vista_shown + 1.0 / VISTA_FADE, 1.0)
        } else { max(s.vista_shown - 1.0 / VISTA_FADE, 0.0) }
        // (As it's put by, the far pass starts afresh: what it kept from the drawings before
        // holds no rock, the vista's while it was laid in, and kept, its blocks would show
        // the rock only on their turns.)
        // (`next_yon` made `yon` afresh: whether it was laid in is the last drawing's `vista_in`.)
        let back = s.vista_in && s.vista_shown < 1.0
        if back {
            s.yon.held = 0.0
            s.yon_count = 1.0
        }
        s.vista_in = s.vista_shown >= 1.0
        s.yon.vista = if s.vista_in { 1 } else { 0 }
    }
    jittered(shot, s.jitter)
}

/// How many times the vista is looked at whole at its fast pace (`VISTA_FAST` drawings to it
/// whole) before it settles into its own (`engine::far::SWEEP`).
const VISTA_EARLY: u32 = 4
const VISTA_FAST: u32 = 8

/// How many times the vista is looked at whole before it's laid in (`yonder::Yon::vista`): its
/// fast ones, a quarter of a second at 120 a second. Laid in with fewer looks a texel, it pops
/// in, and its spires settle as it's looked at again.
const VISTA_READY: u32 = VISTA_EARLY

/// The most looks at the vista a drawing (`yonder::vista_look`): the biggest, at its fast pace.
const VISTA_LOOKS: u32 = MOST_SIDE * MOST_SIDE / VISTA_FAST

/// How many drawings the vista takes to fade in as it's laid in, or out as it's put by.
const VISTA_FADE: f32 = 16.0

/// The most looks a vista's texel keeps while the storm's light is changing (sailing into or
/// out of clear weather): the new light in within a few sweeps.
const VISTA_STIRRED: f32 = 6.0

/// How far the storm's light (`Heavens::storm`) may move over a sweep and still be one light.
const STILL_STORM: f32 = 0.003

/// How much of the box round the rock its vista leaves round it.
const VISTA_MARGIN: f32 = 0.04

/// The vista aimed at the rock from where the eye is: the first drawing, once the eye has gone
/// `engine::far::REAIM` m from where it was aimed, or once the screen asks for a vista much finer
/// or coarser than it is (`engine::far::vista_side`: a zoom, a bigger window). What it held is
/// carried over, read through its depth (`yonder::vista_carry`), so it doesn't start again empty;
/// but after a jump (`engine::far::jumped`), or once it served no camera for a while
/// (`engine::far::vista_fits`), it starts again, and the far pass draws the rock till it's ready.
fn aim_vista(s: mut State, shot: Shot) {
    let b = isle_extent()
    let needed = texels_needed(
        shot.eye,
        b,
        VISTA_MARGIN,
        rows: shot.resolution.y,
        focal: shot.focal,
    )
    s.vista_fits = vista_fits(shot.eye, b, needed, slack: if s.vista_fits { 1.1 } else { 1.0 })
    if !s.vista_fits {
        // (Held as it is while it fades out (`vista_shown`), dropped once it's gone, or at once
        // after a jump: read from so far off, it would be a ghost.)
        if s.vista_shown <= 0.0 || jumped(s.vista, shot.eye) {
            s.vista_aimed = false
        }
        return
    }
    let side = vista_side(needed)
    let was = s.vista
    // (A quarter finer or coarser than the screen asks: a vista much finer than the screen is
    // read between texels the pixel's footprint misses, and shimmers as they cross it.)
    let resized = side * 4 > u32(was.size) * 5 || side * 5 < u32(was.size) * 4
    if s.vista_aimed && !strayed(was, shot.eye) && !resized {
        return
    }
    // (Its size kept where it's near enough: a vista carried to a new size is read between the
    // old texels.)
    let size = if resized || !s.vista_aimed { side } else { u32(was.size) }
    let now = aimed(shot.eye, b, size: f32(size), margin: VISTA_MARGIN)
    if !s.vista_aimed || jumped(was, shot.eye) {
        vista_targets(mut s, size)
        s.vista_sweeps = 0
        s.vista_storm = s.heavens.storm
        s.vista_stirred = false
        s.vista_shown = 0.0
    } else {
        if size != u32(was.size) {
            s.vista_new_colour = writable_texture::<Rgba16Float>(width: size, height: size)
            s.vista_new_marks = writable_texture::<Rgba16Float>(width: size, height: size)
            s.vista_new_normal = writable_texture::<Rgba16Float>(width: size, height: size)
        }
        borrow hv = s.heavens
        let c = begin_pass3(
            mut s.vista_new_colour,
            mut s.vista_new_marks,
            mut s.vista_new_normal,
            keep: false,
        )
        draw(
            c,
            cover,
            vista_carry.bind(
                now: now,
                was: was,
                smp: hv.linear,
                colour: s.vista_colour,
                marks: s.vista_marks,
                normal: s.vista_normal,
            ),
            vertices: 3,
        )
        c.end()
        swap_vista(mut s)
        if size != u32(was.size) {
            s.vista_new_colour = writable_texture::<Rgba16Float>(width: size, height: size)
            s.vista_new_marks = writable_texture::<Rgba16Float>(width: size, height: size)
            s.vista_new_normal = writable_texture::<Rgba16Float>(width: size, height: size)
            s.vista_reach = texture(width: size, height: size)
            s.vista_depth = depth_texture(size, size)
        }
    }
    s.vista_turn = 0
    s.vista = now
    s.vista_aimed = true
}

/// What the vista's last pass wrote (`vista_new_*`) made what it holds, and what it held what the
/// next writes.
fn swap_vista(s: mut State) {
    swap(mut s.vista_colour, mut s.vista_new_colour)
    swap(mut s.vista_marks, mut s.vista_new_marks)
    swap(mut s.vista_normal, mut s.vista_new_normal)
}

/// How many drawings go to looking at the vista whole (`engine::far::turn_of`): `SWEEP`, its
/// first few times (`VISTA_EARLY`) `VISTA_FAST`.
fn vista_period(s: State) -> u32 {
    if s.vista_sweeps < VISTA_EARLY { VISTA_FAST } else { SWEEP }
}

/// The vista's pictures made afresh, `size` texels a side, empty (no looks yet).
fn vista_targets(s: mut State, size: u32) {
    s.vista_colour = writable_texture::<Rgba16Float>(width: size, height: size)
    s.vista_marks = writable_texture::<Rgba16Float>(width: size, height: size)
    s.vista_normal = writable_texture::<Rgba16Float>(width: size, height: size)
    s.vista_new_colour = writable_texture::<Rgba16Float>(width: size, height: size)
    s.vista_new_marks = writable_texture::<Rgba16Float>(width: size, height: size)
    s.vista_new_normal = writable_texture::<Rgba16Float>(width: size, height: size)
    s.vista_reach = texture(width: size, height: size)
    s.vista_depth = depth_texture(size, size)
}

/// Paints rows `from` to `to` of `shot` (the first pass), keeping the rest as they are.
fn paint_rows(s: mut State, shot: Shot, from: u32, to: u32) {
    borrow hv = s.heavens
    let waves = Waves {
        sea: s.ocean.view(),
        big_shape: s.ocean.big.shape,
        big_tilt: s.ocean.big.tilt,
        mid_shape: s.ocean.mid.shape,
        mid_tilt: s.ocean.mid.tilt,
        fine_shape: s.ocean.fine.shape,
        fine_tilt: s.ocean.fine.tilt,
        ripple_shape: s.ocean.ripple.shape,
        ripple_tilt: s.ocean.ripple.tilt,
        s: s.ocean.s,
    }
    let width = s.width
    // The half paint reads one row beyond the band for its vertical reconstruction. Its
    // far-layer inputs must be current there too, not left over from another drawing.
    let paint_from = if HALF_PAINT && from > 0 { from - 1 } else { from }
    let paint_to = if HALF_PAINT { min(to + 1, s.height) } else { to }
    if s.isle_cooked < FIELD_SLABS {
        label("cook isle")
        // Keep the global IDs the field stores through, but stop at this slab's upper edge:
        // later slabs would only launch invocations that immediately return.
        let depth = (s.isle_cooked + 1) * (FIELD_SIDE / FIELD_SLABS)
        dispatch(
            cook_isle.bind(slab: s.isle_cooked, out: mut s.isle_field),
            over: (FIELD_SIDE, FIELD_SIDE, depth),
        )
        s.isle_cooked += 1
    }
    label("overhead")
    dispatch(
        overhead_once.bind(
            view: hv.tables.view,
            light: hv.light,
            dome: hv.sky.dome,
            smp: hv.linear,
            out: mut s.overhead,
        ),
        over: OVERHEAD,
    )
    if MIRROR_TABLE {
        // (Whole while the dome's still being marched whole, and once more from the whole dome;
        // then a band of rows a drawing.)
        label("mirror")
        let band = (MIRROR_H + MIRROR_PHASES - 1) / MIRROR_PHASES
        let (row0, rows) = if hv.whole() && s.mirror_whole {
            s.mirror_phase = (s.mirror_phase + 1) % MIRROR_PHASES
            (s.mirror_phase * band, band)
        } else {
            s.mirror_whole = hv.whole()
            (0, MIRROR_H)
        }
        dispatch(
            cook_mirror.bind(
                view: hv.tables.view,
                light: hv.light,
                dome: hv.sky.dome,
                smp: hv.linear,
                once: s.overhead.items(),
                row0: row0,
                rows: rows,
                out: mut s.mirror,
            ),
            groups: ((MIRROR_W + 7) / 8, (row0 + rows + 7) / 8, 1),
        )
    }
    label("vista")
    // (The vista laid in over what the far pass met (`yonder::far_merge`), once it's ready.)
    let merged = VISTA && s.vista_shown > 0.0
    if VISTA && from == 0 && s.vista_aimed {
        // The vista's texels whose turn it is looked at once more (`yonder::vista_look`), and laid
        // in (`yonder::vista_lay`): once a drawing, with its first band of the paint's.
        let vshot = vista_shot(s.vista, s.plain)
        // (Its first few looks at four times the pace: an empty or one-look picture is all
        // jumps; after them each look moves a texel less.)
        let period = vista_period(s)
        let turn = s.vista_turn
        let side = u32(s.vista.size)
        let stirred = s.vista_stirred || abs(hv.storm - s.vista_storm) > STILL_STORM
        dispatch(
            vista_look.bind(
                shot: vshot,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                field: s.isle_field,
                reach: s.vista_reach,
                meshed: s.vista_meshed,
                held_colour: s.vista_colour,
                held_marks: s.vista_marks,
                held_normal: s.vista_normal,
                seq: s.vista_sweeps,
                side: side,
                turn: turn,
                period: period,
                kept: if stirred { VISTA_STIRRED } else { KEPT },
                once: s.overhead.items(),
                colour: mut s.vista_fresh_colour,
                marks: mut s.vista_fresh_marks,
                normal: mut s.vista_fresh_normal,
            ),
            over: (turn_texels(side, period), 1, 1),
        )
        dispatch(
            vista_lay.bind(
                colour: s.vista_fresh_colour,
                marks: s.vista_fresh_marks,
                normal: s.vista_fresh_normal,
                side: side,
                turn: turn,
                period: period,
                out_colour: mut s.vista_colour,
                out_marks: mut s.vista_marks,
                out_normal: mut s.vista_normal,
            ),
            over: (side, side, 1),
        )
        s.vista_turn = if turn + 1 >= period { 0 } else { turn + 1 }
        if turn + 1 >= period {
            s.vista_sweeps += 1
            s.vista_stirred = abs(hv.storm - s.vista_storm) > STILL_STORM
            s.vista_storm = hv.storm
        }
    }
    label("yonder")
    if QUARTER {
        // (A row of the half-size pass either side of the band's own: the rebuild reads the
        // pixels round each.)
        let lw = (width + SPARSE - 1) / SPARSE
        let lh = (s.height + SPARSE - 1) / SPARSE
        let lfrom = if paint_from / SPARSE > 0 { paint_from / SPARSE - 1 } else { 0 }
        let lto = min((paint_to + SPARSE - 1) / SPARSE + 1, lh)
        let f = begin_pass3(mut s.low_colour, mut s.low_marks, mut s.low_normal, keep: true)
        f.scissor(0, lfrom, lw, lto - lfrom)
        draw(
            f,
            cover,
            yonder_low.bind(
                shot: s.plain,
                yon: s.yon,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                field: s.isle_field,
                reach: s.reach,
                once: s.overhead.items(),
            ),
            vertices: 3,
        )
        f.end()
        let r = begin_pass3(mut s.yon_colour, mut s.yon_marks, mut s.yon_normal, keep: true)
        r.scissor(0, paint_from, width, paint_to - paint_from)
        draw(
            r,
            cover,
            yonder_rebuild.bind(
                shot: s.plain,
                yon: s.yon,
                smp: hv.linear,
                low_colour: s.low_colour,
                low_marks: s.low_marks,
                low_normal: s.low_normal,
                past_colour: s.past_colour,
                past_marks: s.past_marks,
                past_normal: s.past_normal,
            ),
            vertices: 3,
        )
        r.end()
    } else {
        let f = begin_pass3(mut s.yon_colour, mut s.yon_marks, mut s.yon_normal, keep: true)
        f.scissor(0, paint_from, width, paint_to - paint_from)
        draw(
            f,
            cover,
            yonder.bind(
                shot: s.plain,
                yon: s.yon,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                past_colour: s.past_colour,
                past_marks: s.past_marks,
                past_normal: s.past_normal,
                field: s.isle_field,
                reach: s.reach,
                once: s.overhead.items(),
            ),
            vertices: 3,
        )
        f.end()
    }
    label("merge")
    if merged {
        // The far layer the paint reads: the stacks as met, the vista laid in.
        let m = begin_pass3(mut s.far_colour, mut s.far_marks, mut s.far_normal, keep: true)
        m.scissor(0, paint_from, width, paint_to - paint_from)
        draw(
            m,
            cover,
            far_merge.bind(
                shot: shot,
                vista: s.vista,
                shown: s.vista_shown,
                smp: hv.linear,
                yon_colour: s.yon_colour,
                yon_marks: s.yon_marks,
                yon_normal: s.yon_normal,
                vista_colour: s.vista_colour,
                vista_marks: s.vista_marks,
                vista_normal: s.vista_normal,
            ),
            vertices: 3,
        )
        m.end()
        // (The paint reads `yon_*`: the far layer in their place while it paints, swapped back
        // after, as the next drawing carries what the far pass met.)
        swap(mut s.far_colour, mut s.yon_colour)
        swap(mut s.far_marks, mut s.yon_marks)
        swap(mut s.far_normal, mut s.yon_normal)
    }
    label("paint")
    if HALF_PAINT {
        // (A row of the half either side of the band's own: the fill reads the rows round each.)
        let hp = begin_pass3(mut s.half_colour, mut s.half_marks, mut s.half_normal, keep: true)
        hp.scissor(0, paint_from, (width + 1) / 2, paint_to - paint_from)
        draw(
            hp,
            cover,
            paint_half.bind(
                shot: shot,
                light: hv.light,
                clouds: hv.clouds,
                view: hv.tables.view,
                aerial: hv.tables.aerial,
                dome: hv.sky.dome,
                mirror: s.mirror,
                cloud: hv.sky.shadow,
                smp: hv.linear,
                waves: waves,
                yon_colour: s.yon_colour,
                yon_marks: s.yon_marks,
                yon_normal: s.yon_normal,
                once: s.overhead.items(),
            ),
            vertices: 3,
        )
        hp.end()
        let p = begin_pass3(mut s.colour, mut s.marks, mut s.normal, keep: true)
        p.scissor(0, from, width, to - from)
        draw(
            p,
            cover,
            paint_fill.bind(
                shot: shot,
                size: vec2(f32(width), f32(s.height)),
                half_colour: s.half_colour,
                half_marks: s.half_marks,
                half_normal: s.half_normal,
                yon_colour: s.yon_colour,
                yon_marks: s.yon_marks,
                yon_normal: s.yon_normal,
            ),
            vertices: 3,
        )
        p.end()
        if merged {
            swap(mut s.far_colour, mut s.yon_colour)
            swap(mut s.far_marks, mut s.yon_marks)
            swap(mut s.far_normal, mut s.yon_normal)
        }
        return
    }
    let p = begin_pass3(mut s.colour, mut s.marks, mut s.normal, keep: true)
    p.scissor(0, from, width, to - from)
    draw(
        p,
        cover,
        paint.bind(
            shot: shot,
            light: hv.light,
            clouds: hv.clouds,
            view: hv.tables.view,
            aerial: hv.tables.aerial,
            dome: hv.sky.dome,
            mirror: s.mirror,
            cloud: hv.sky.shadow,
            smp: hv.linear,
            waves: waves,
            yon_colour: s.yon_colour,
            yon_marks: s.yon_marks,
            yon_normal: s.yon_normal,
            once: s.overhead.items(),
        ),
        vertices: 3,
    )
    p.end()
    if merged {
        swap(mut s.far_colour, mut s.yon_colour)
        swap(mut s.far_marks, mut s.yon_marks)
        swap(mut s.far_normal, mut s.yon_normal)
    }
}

/// The weather laid over the painted scene (`weather`), into `aired`, for the ink.
pub(package) fn weathered(s: mut State, shot: Shot) {
    // The ink reads the unweathered paint directly when this pass is disabled. Clearing an
    // unused `aired` first would both cost a pass and replace the scene with black.
    if (OFF & 256) != 0 { return }
    borrow hv = s.heavens
    label("weather")
    let p = begin_pass(mut s.aired, clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        p,
        cover,
        weather.bind(
            shot: shot,
            light: hv.light,
            clouds: hv.clouds,
            view: hv.tables.view,
            aerial: hv.tables.aerial,
            dome: hv.sky.dome,
            smp: hv.linear,
            colour: s.colour,
            marks: s.marks,
            once: s.overhead.items(),
        ),
        vertices: 3,
    )
    p.end()
}

/// The scene for another program, drawn at `width` by `height`.
pub fn scene(width: u32, height: u32) -> State {
    targets(heavens(SUN, 3.0), width, height)
}

/// The scene stepped on to `time`, its drawings painted and inked into `image` at `width` by
/// `height` (which may be smaller than the screen it's shown on), the camera at `framing`
/// (`Rig::framing`: 0 the opening's shot, 1 the player's) and swung `orbit` radians
/// round the skiff. Live, a page has a frame's time for everything it draws, so a drawing's work
/// is spread over the frames before the next: the scene moves on its own drawings (`HELD` a
/// second, `sea::held`), so between them nothing in it changes. A new drawing's paint goes in
/// `bands` bands of rows, one a frame, the ink after the last; `image` holds the last drawing
/// inked meanwhile. A new size drops the drawing under way and begins one at once. Whether
/// `image` is a new drawing.
pub fn play(
    s: mut State,
    time: f32,
    width: u32,
    height: u32,
    orbit: f32,
    framing: f32,
    bands: u32,
) -> bool {
    // (The rig stepped to the drawing's own time, as all else in it is: stepped to the frame's,
    // a drawing held over two frames carried two frames' motion into the next, every fifth frame
    // at 30 a second, a jolt the coat's cloth threw out wide for a frame.)
    step(mut s.rig, held(START + time), s.ocean.swell)
    if width != s.width || height != s.height {
        sized(mut s, width, height)
        s.band = 0
        s.drawn = -1.0
    }
    let drawing = held(START + time)
    if s.band == 0 {
        // (In one band, a drawing every frame: a frame that falls in the last's drawing still
        // draws, so a screen's pace never skips one.)
        if drawing == s.drawn && bands > 1 {
            return false
        }
        s.drawn = drawing
        s.shot = prepared(mut s, time, 0, orbit, framing, fine: LIVE_FINE)
    }
    let shot = s.shot
    let n = max(bands, 1)
    let from = height * s.band / n
    let to = height * (s.band + 1) / n
    paint_rows(mut s, shot, from, to)
    s.band += 1
    if s.band < n {
        return false
    }
    s.band = 0
    stood(mut s, shot)
    if s.spare_size != (width, height) {
        s.spare = texture(width: width, height: height)
        s.spare_size = (width, height)
    }
    weathered(mut s, shot)
    borrow hv = s.heavens
    borrow colour = if (OFF & 256) != 0 { s.colour } else { s.aired }
    label("ink")
    let p = begin_pass(mut s.spare, clear: vec4(0.0, 0.0, 0.0, 1.0))
    draw(
        p,
        cover,
        ink.bind(
            shot: shot,
            light: hv.light,
            colour: colour,
            marks: s.marks,
            normal: s.normal,
            settled: 0,
        ),
        vertices: 3,
    )
    p.end()
    swap(mut s.image, mut s.spare)
    swap(mut s.image_size, mut s.spare_size)
    true
}

/// Whether the sky has cooked whole: the scene is fit to be seen.
pub fn ready(s: State) -> bool {
    s.heavens.whole()
}

/// The player's input event `e`, for the skiff: W or Up sheets the sail in (held, harder), S or
/// Down lets it fly, A and D (or Left and Right) steer.
pub fn input(s: mut State, e: Event) {
    key(mut s.rig, e)
}

/// The player's hands off the keys: every key let go (the page took the keys away); the sail
/// stays as it's trimmed.
pub fn release(s: mut State) {
    let_go(mut s.rig)
}

/// How far the camera has swung from the opening's bearing (rad, -π to π), following the
/// steering: a program that wants the opening's shot back swings it by the opposite (`play`'s
/// `orbit`).
pub fn swung(s: State) -> f32 {
    let a = s.rig.shown_look
    a - 6.2831853 * floor((a + 3.1415927) / 6.2831853)
}

/// How fast the skiff moves through the water (m/s): whether the player has rowed it yet.
pub fn way(s: State) -> f32 {
    s.rig.speed
}

/// Where the skiff is (x, z, m) and its heading from the opening's (rad): what a save keeps.
pub fn whereabouts(s: State) -> (vec2, f32) {
    (s.rig.at, s.rig.steer)
}

/// The skiff put at `at` (x, z, m) and headed `steer` (rad), at rest, the camera behind it: a
/// save taken up again.
pub fn put(s: mut State, at: vec2, steer: f32) {
    var r = rest()
    r.at = at
    r.steer = steer
    r.look = steer
    r.shown_at = at
    r.shown_steer = steer
    r.shown_look = steer
    s.rig = r
}
