// The hero's joints aboard, as the sailing stands them (the skiff's frame). Hakuro himself is
// drawn into the scene from his own fields (`aboard`); the sea's checks of his shadow and his
// mirror read a few plain solids at these joints (`skiff::stand_in`). (The traced likeness that
// stood here before him recomputed his whole pose in every pixel: gone, Nov 8.)

/// Where the hero's joints stand (the skiff's frame).
pub struct Joints: Copy {
    pub hips: vec3,
    pub neck: vec3,
    pub fore_hand: vec3,
    pub aft_hand: vec3,
    pub fore_foot: vec3,
    pub aft_foot: vec3,
    /// 1 sat (knees drawn up, the coat's skirts over the seat behind), 0 standing.
    pub sit: f32,
    /// Where the mask faces.
    pub gaze: vec3,
}
