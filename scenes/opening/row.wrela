// Rowing the skiff: the keys the player paddles and steers it by, and how the boat answers them
// on the water: it gathers way slowly and keeps it, turns more as it moves, and the camera swings
// round after it. What a frame draws is the rig as it stood at the last drawing (on twos).

use std::input::{Event, Key}
use sea::{HELD}

/// The skiff under the player's hands.
pub struct Rig: Copy {
    /// Where it is (x, z, m) and how far it's been steered from its drift's heading (rad).
    pub at: vec2,
    pub steer: f32,
    /// Its way through the water (m/s, forward positive) and its turning (rad/s).
    pub speed: f32,
    pub turn: f32,
    /// How hard the traveller paddles, -1 (backing) to 1, eased; and the stroke's phase (strokes).
    pub pull: f32,
    pub stroke: f32,
    /// How far the camera has swung (rad), following the steer.
    pub look: f32,
    /// The keys held.
    forward: bool,
    back: bool,
    left: bool,
    right: bool,
    /// The time it was last stepped to, and the drawing it last held.
    time: f32,
    drawing: f32,
    /// The rig as the last drawing holds it: what a frame draws.
    pub shown_at: vec2,
    pub shown_steer: f32,
    pub shown_speed: f32,
    pub shown_turn: f32,
    pub shown_pull: f32,
    pub shown_stroke: f32,
    pub shown_look: f32,
}

/// The skiff at rest, as the opening finds it.
pub fn rest() -> Rig {
    Rig {
        at: vec2(0.0),
        steer: 0.0,
        speed: 0.0,
        turn: 0.0,
        pull: 0.0,
        stroke: 0.0,
        look: 0.0,
        forward: false,
        back: false,
        left: false,
        right: false,
        time: -1.0,
        drawing: -1.0,
        shown_at: vec2(0.0),
        shown_steer: 0.0,
        shown_speed: 0.0,
        shown_turn: 0.0,
        shown_pull: 0.0,
        shown_stroke: 0.0,
        shown_look: 0.0,
    }
}

/// The rig after input event `e`: W or Up paddles ahead, S or Down backs, A and D (or Left and
/// Right) steer.
pub fn key(r: mut Rig, e: Event) {
    match e {
        Event::KeyDown { key, .. } => hold(mut r, key, true),
        Event::KeyUp { key, .. } => hold(mut r, key, false),
        _ => {},
    }
}

/// Every key let go: the hands off the paddle.
pub fn let_go(r: mut Rig) {
    r.forward = false
    r.back = false
    r.left = false
    r.right = false
}

fn hold(r: mut Rig, key: Key, down: bool) {
    match key {
        Key::W => r.forward = down,
        Key::Up => r.forward = down,
        Key::S => r.back = down,
        Key::Down => r.back = down,
        Key::A => r.left = down,
        Key::Left => r.left = down,
        Key::D => r.right = down,
        Key::Right => r.right = down,
        _ => {},
    }
}

/// How fast the skiff gathers way under a full stroke (m/s²), the water's drag on it (1/s), and
/// how fast it turns at speed (rad/s).
const THRUST: f32 = 0.75
const DRAG: f32 = 0.32
const TURN_RATE: f32 = 0.32

/// The rig stepped on to `time` (s).
pub fn step(r: mut Rig, time: f32) {
    if r.time < 0.0 {
        r.time = time
    }
    let dt = clamp(time - r.time, 0.0, 0.1)
    r.time = time
    // The paddling eases in and out: a stroke is taken, not switched on.
    let want = if r.forward { 1.0 } else if r.back { -0.6 } else { 0.0 }
    r.pull += (want - r.pull) * (1.0 - exp(-dt * 2.2))
    // Each stroke pulls hardest mid-way through the water, and the boat glides between.
    let surge = 0.55 + 0.9 * max(sin(fract(r.stroke) * 6.2831853), 0.0)
    r.speed += (THRUST * r.pull * surge - DRAG * r.speed) * dt
    r.stroke += dt * (0.8 * abs(r.pull) + 0.04)
    // A paddled boat turns when it's steered, more as it has way on it; a little even at rest.
    let wheel = (if r.right { 1.0 } else { 0.0 }) - (if r.left { 1.0 } else { 0.0 })
    let grip = 0.35 + 0.65 * min(abs(r.speed) / 1.2, 1.0)
    r.turn += (wheel * TURN_RATE * grip - r.turn) * (1.0 - exp(-dt * 1.8))
    r.steer += r.turn * dt
    r.at += vec2(sin(-0.22 + r.steer), cos(-0.22 + r.steer)) * r.speed * dt
    // The camera swings round after the bow, lagging it.
    r.look += (r.steer - r.look) * (1.0 - exp(-dt * 1.1))
    // What the drawing holds, renewed as each drawing comes.
    let drawing = floor(time * HELD)
    if drawing != r.drawing {
        r.drawing = drawing
        r.shown_at = r.at
        r.shown_steer = r.steer
        r.shown_speed = r.speed
        r.shown_turn = r.turn
        r.shown_pull = r.pull
        r.shown_stroke = r.stroke
        r.shown_look = r.look
    }
}
