// What both passes read (`Shot`: the camera, the light, the skiff where the sea has it this
// frame), the scene's layout and palette, and the noise they paint with.

use sea::{HELD, SEA as WATER, bob, held, held_at}
use engine::ocean::Swell
use sail::{Rig, Pose, pose}
use main::{CAMERA, FREEBOARD, OPEN_SIDE}
use skiff::{Rod, rods}
use hero::Joints

/// Where the rock floats (the world's, m: its plateau's centre), and the sun.
pub const ISLE = vec3(-1890.0, 1806.0, 7560.0)
pub const SUN = vec3(0.3725, 0.42, 0.9221)
/// How overcast the sky is, 0 (the engine's open sky and its clouds) to 1 (a storm's deck over
/// all of it, the sun behind it: `heavens`' weather, `engine::sky::Weather::overcast`).
pub const OVERCAST: f32 = 1.0
/// Under the overcast: how much brighter it's exposed than the storm's first grade (1 as it was);
/// how wide a break in the deck far off toward the sun (m; 0 none); how far the deck thins
/// between its banks, the sun's light glowing through (0 to 1).
pub const LIFT: f32 = 1.8
pub const BREAK: f32 = 0.0
pub const THIN: f32 = 0.0
/// How wide the deck's thinner reach behind the cathedral is (m; 0 none).
pub const VEIL: f32 = 3800.0
/// Under the overcast, low on the horizon: the elevation (a direction's y) under which the deck
/// goes into the storm's own air; how much lighter that air is at the horizon itself; and how
/// bright the open sky behind the deck's thinner places is, against the open sky's own.
pub const STORM_LOW: f32 = 0.075
pub const STORM_HORIZON: f32 = 1.6
pub const STORM_BEHIND: f32 = 0.2

/// The way the wind blows (x, z, a unit vector): the sea's (`sea::SEA`), which the clouds, the
/// rain and the scud go with.
pub fn wind() -> vec2 {
    WATER.wind
}

/// The palette, linear: the ink, the paper, the shadow's cool and the light's warmth.
pub const INK = vec3(0.045, 0.035, 0.07)
pub const PAPER = vec3(0.97, 0.94, 0.88)
pub const COOL = vec3(0.32, 0.36, 0.58)
pub const WARM = vec3(1.0, 0.82, 0.58)

/// What a pixel's ray met: the sky, the sea, the skiff, the rock, the cathedral's stone and its
/// gilding.
pub const SKY: f32 = 1.0
pub const SEA: f32 = 2.0
pub const SKIFF: f32 = 3.0
pub const ROCK: f32 = 4.0
pub const STONE: f32 = 5.0
pub const GILT: f32 = 6.0
pub const GLASS: f32 = 7.0
pub const ROOF: f32 = 8.0
pub const HOUSE: f32 = 9.0
pub const TILE: f32 = 10.0

/// What the passes read: the screen, the camera's eye and its axes, the light, and the skiff's
/// place and axes (as the sea carries it), the held time.
pub struct Shot: Copy + GpuData {
    pub resolution: vec2,
    pub time: f32,
    pub held: f32,
    pub eye: vec3,
    pub forward: vec3,
    pub right: vec3,
    pub up: vec3,
    pub focal: f32,
    pub sun: vec3,
    pub glow: vec3,
    pub boat: vec3,
    pub boat_x: vec3,
    pub boat_y: vec3,
    pub boat_z: vec3,
    /// How kinetic the moment is, 0 (quiet) to 1 (the fight's climax): the whole frame's fray and
    /// its pull toward black and white.
    pub kinetic: f32,
    /// How hard the skiff just met the water (0 to 1): its bounce, felt as fraying ink at the hull.
    pub slap: f32,
    /// The boom's slam across in a gybe, just felt (1) and fading.
    pub jolt: f32,
    /// How much of the drawing is laid over the render, 0 (the physical render alone, to judge it
    /// by) to 1: the value bands, the hatching, the ink.
    pub style: f32,
    /// The skiff's way (m/s) and turning (rad/s), how hard its sail's sheeted (0 to 1), how far
    /// onto the plane it is (0 to 1) and the wind's gust there (1 its mean).
    pub speed: f32,
    pub turn: f32,
    pub power: f32,
    pub plane: f32,
    pub gust: f32,
    /// The rig and the traveller in the skiff's frame (`sail::Pose`).
    pub mast: vec3,
    pub boom: vec3,
    pub belly: vec3,
    pub hips: vec3,
    pub neck: vec3,
    pub fore_hand: vec3,
    pub aft_hand: vec3,
    pub fore_foot: vec3,
    pub aft_foot: vec3,
    pub gaze: vec3,
    /// Worked out once a drawing for the skiff (`skiff`), so no pixel works them out again: the
    /// eye in the skiff's frame (`skiff::local`), the sail's face (across the mast and the boom)
    /// and its rods (`skiff::rods`).
    pub eye_aboard: vec3,
    pub sheet: vec3,
    pub rods: [Rod; 15],
    /// How far up the hull's sides the sea has lately washed (`wake::washed`: port's twelve places
    /// stern to bow, then starboard's, four to a `vec4`; m up from its waterline).
    pub wash: [vec4; 6],
    /// Where the water the skiff stirs lies (`engine::stir::Stir::at`; its last 0 for none).
    pub stir_at: vec4,
    /// The sail's cloth: its belly, twist, luff bubble and flogging, its leech's flutter
    /// (`sail::Motion`).
    pub cloth: vec4,
    pub quiver: vec4,
    /// Which shading language draws it all: 0 the drawn look (ink and hatching over the render),
    /// 1 painted CG, 2 cel and ink, 3 clean CG.
    pub look: f32,
    /// The cathedral lit from within (0 or 1): its stained glass throwing coloured beams round
    /// over the sea as a lighthouse's do.
    pub lantern: f32,
    /// How finely it's met: 1 for a still or a clip (the rock's and the skiff's edges met four
    /// times over a pixel); 0.3 for a live page, the rock and the cathedral alone four times, so
    /// their fine work doesn't crawl as the eye moves; 0 everything once (`paint`).
    pub fine: f32,
    /// How much of the storm is here, where the eye is (0 clear to 1 the storm's deck: the
    /// weather of the region it's in, `heavens::Heavens::storm`), eased as it sails between.
    pub storm: f32,
    /// The wind's mean where the eye is (m/s, toward where it blows: `wind::mean_wind`, eased
    /// as the skiff sails between regions); its gusts over it are `wind::air_over`'s.
    pub wind: vec2,
}

/// The player's camera (`Rig::framing` 1): how far behind the skiff (m), how high over the sea
/// (m), and its focal length (screen half-heights; the opening's shot is a long 3.7).
const PLAY_BACK: f32 = 6.2
const PLAY_UP: f32 = 2.5

/// How far over the water under it the camera stays at least (m): over the chop the CPU's
/// waves (`Swell`) leave out, and its spray.
const CLEAR: f32 = 0.9

/// The larger of `a` and `b`, rounded over `k` where they meet.
fn soft_max(a: f32, b: f32, k: f32) -> f32 {
    let h = clamp(0.5 + 0.5 * (a - b) / k, 0.0, 1.0)
    mix(b, a, h) + k * h * (1.0 - h)
}
const PLAY_FOCAL: f32 = 1.75
/// How far the player's camera stands out to windward of the skiff's wake (m): over the
/// traveller's shoulder, the sail seen across, not edge on.
const PLAY_SIDE: f32 = 2.4

/// `v` (x, z) turned `a` (rad) about the vertical, as a heading turns.
fn turned(v: vec2, a: f32) -> vec2 {
    vec2(v.x * cos(a) + v.y * sin(a), v.y * cos(a) - v.x * sin(a))
}

/// How much lower the skiff sits than the open sea would hold it (m), in the hollow its own
/// weight presses into the water round it. What's set by its waterline goes down with it: how
/// high the sea may stand on its planks (`paint::sea_level`), its soaked band (`skiff`).
pub const SAT: f32 = 0.08

/// The shot at `time`, the skiff where the player has rowed it (`r`) on the sea's long waves
/// (`swell`): the camera behind the skiff and above it, swung round after its steering; at rest,
/// the rock up and to the left.
pub fn shot_at(
    time: f32,
    width: u32,
    height: u32,
    kinetic: f32,
    view: u32,
    r: Rig,
    swell: Swell,
) -> Shot {
    let t = held(time)
    // (As it floats, `Rig::float`: lagging the sea, overshooting and rocking on after it.)
    let (afloat, bx0, by0, bz0) = if r.floated {
        held_at(t, r.shown_at, r.shown_steer, r.shown_float)
    } else {
        bob(t, r.shown_at, r.shown_steer, swell)
    }
    // Heeled by the sail's pull and its turns (starboard down as `heel` is positive), its bow
    // lifted as it climbs onto the plane and settling as it skims, a little higher in the water.
    let hl = r.shown_heel
    let bx1 = bx0 * cos(hl) - by0 * sin(hl)
    let by1 = by0 * cos(hl) + bx0 * sin(hl)
    let pl = r.shown_plane
    let pitch = 0.1 * pl * (1.0 - pl) * 4.0 * smoothstep(0.5, 4.0, r.shown_speed) + 0.02 * pl
    let bz = bz0 * cos(pitch) + by1 * sin(pitch)
    let by = by1 * cos(pitch) - bz0 * sin(pitch)
    let bx = bx1
    // (Lifted a little on the plane; pressed down into the water as it heels into a turn, its
    // low chine dug in, as a carving hull loads up. And a hand lower than the sea alone would
    // hold it, `SAT`: the water it stirs is pressed down under it (`wake::PRESS`) and stands
    // lower all round it, and riding at the open sea's height it showed its side down to the
    // keel, a model stood on the water.)
    let boat = afloat + vec3(y: 0.02 * pl - SAT - 0.2 * abs(sin(hl)))
    let g = pose(r, t)
    // The bounce: how sharply the skiff's fall was stopped over the last drawings. (The sea's
    // alone, `b0`, as the drawings before are: the heel's sink and the plane's lift in it
    // too would read every change of heel between two drawings as a slam, the more the more
    // drawings a second, and held the slap on all through a turn.)
    let dt = 1.0 / HELD
    let (b1, _, _, _) = bob(t - dt, r.shown_at, r.shown_steer, swell)
    let (b2, _, _, _) = bob(t - 2.0 * dt, r.shown_at, r.shown_steer, swell)
    // (Now, it's what the rig already found as it floated to this drawing, `Rig::float`: the
    // sea's own height under it, not summed again.)
    let b0 = if r.floated { r.shown_float.x } else { bob(t, r.shown_at, r.shown_steer, swell).0.y }
    let lift = (b0 - 2.0 * b1.y + b2.y) / (dt * dt)
    let behind = turned(vec2(0.5 - OPEN_SIDE, -21.0), r.shown_look)
    let ahead = turned(vec2(-530.5, 5421.0), r.shown_look)
    let low = vec3(r.shown_at.x + behind.x, 1.9 + boat.y * 0.6, r.shown_at.y + behind.y)
    let rock = normalize(vec3(ahead.x, 622.0 - low.y, ahead.y))
    // The player's camera: up behind the skiff along the way it's looking, the skiff low in the
    // frame and the sea ahead of it, wider, so the water is seen going by.
    let heading = vec2(sin(-0.22 + r.shown_look), cos(-0.22 + r.shown_look))
    // (Under way it falls back a little as the skiff surges and catches up as it settles, a
    // little lower the faster it runs.)
    let run = smoothstep(2.0, 10.0, r.shown_rush)
    let surge = clamp(r.shown_speed - r.shown_rush, -1.0, 3.0)
    let back = PLAY_BACK + 0.8 * CAMERA - 0.3 * run + max(surge, 0.0) * 0.35 + min(surge, 0.0) * 0.15
    let beside = vec2(heading.y, -heading.x) * ((PLAY_SIDE + 2.2 * CAMERA) * r.shown_perch)
    let high = vec3(
        r.shown_at.x - heading.x * back + beside.x,
        PLAY_UP + 1.4 * CAMERA - 0.35 * run + boat.y * 0.5,
        r.shown_at.y - heading.y * back + beside.y,
    )
    let ahead_of = vec3(
        r.shown_at.x + heading.x * (24.0 - 6.0 * CAMERA) + beside.x * 0.4,
        0.9,
        r.shown_at.y + heading.y * (24.0 - 6.0 * CAMERA) + beside.y * 0.4,
    )
    let k = smoothstep(0.0, 1.0, clamp(r.framing, 0.0, 1.0))
    // (Running, the camera shakes a little with the hull's chatter over the chop, and with a
    // knock as the boom slams across or the bow slaps down.)
    let chatter = 0.025 * run + 0.3 * r.jolt
    let shake = vec3(
        noise(vec2(t * 13.0, 1.0)) - 0.5,
        noise(vec2(t * 17.0, 4.0)) - 0.5,
        noise(vec2(t * 11.0, 7.0)) - 0.5,
    ) *
        chatter
    let eye = mix(low, high + shake, k)
    let at = eye + normalize(mix(rock, normalize(ahead_of - high), k)) * 1000.0
    // (Only a touch wider at a run: widened much, the near water stretched and swam toward the
    // frame's edges like a fish-eye's.)
    let near = mix(3.7, PLAY_FOCAL - 0.06 * run - 0.03 * max(surge, 0.0) - 0.04 * r.jolt, k)
    // The other views, for looking closer: the rock from 1.1 km, the skiff from beside it, the
    // cathedral from 900 m, the low sun raking across it from the left, the sea from 30 m over
    // it, looking down its sun path, and the sun from the skiff's own eye.
    let (eye, at, focal) = if view == 1 {
        (ISLE + vec3(1260.0, -560.0, -3920.0), ISLE + vec3(0.0, -210.0, 0.0), 1.6)
    } else if view == 3 {
        (ISLE + vec3(2100.0, 980.0, 420.0), ISLE + vec3(0.0, 460.0, -42.0), 1.5)
    } else if view == 4 {
        (vec3(0.0, 30.0, -12.0), vec3(0.0, 0.0, 14.0), 1.2)
    } else if view == 5 {
        (eye, eye + vec3(SUN.x, 0.03, SUN.z) * 1000.0, 2.4)
    } else if view == 2 {
        // (Beside the skiff wherever it's sailed: off its starboard quarter, abeam if `VIEW`
        // 6, off its port bow if 7.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near + bx * 4.5 + vec3(y: 2.0) - bz * 3.0, near + vec3(y: 1.4) + bz * 0.5, 1.5)
    } else if view == 6 {
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near + bx * 7.5 + vec3(y: 1.6), near + vec3(y: 1.6), 1.4)
    } else if view == 8 {
        // (Close on the rider from off the starboard bow.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near + bx * 2.4 + vec3(y: 1.5) + bz * 1.8, near + vec3(y: 0.9) + bz * 0.2, 1.7)
    } else if view == 9 {
        // (The traveller close, from off the starboard quarter: to judge the hero by.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near + bx * 2.6 + vec3(y: 1.9) - bz * 1.6, near + vec3(y: 1.0) - bz * 0.2, 1.7)
    } else if view == 10 {
        // (The traveller close, from off the port bow.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near - bx * 2.2 + vec3(y: 1.7) + bz * 1.4, near + vec3(y: 1.2) - bz * 0.1, 1.9)
    } else if view == 7 {
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near - bx * 5.0 + vec3(y: 1.5) + bz * 5.0, near + vec3(y: 1.5), 1.4)
    } else if view == 12 {
        // (Close on its waterline, low, from off its port bow: where the water meets the planks.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near - bx * 3.4 + vec3(y: 0.75) + bz * 2.6, near + vec3(y: 0.25) + bz * 0.5, 1.7)
    } else if view == 13 {
        // (And low from abeam, to starboard.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near + bx * 4.2 + vec3(y: 0.8) - bz * 0.6, near + vec3(y: 0.3), 1.7)
    } else if view == 14 {
        // (Hard by its side amidships, looking down along its waterline.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        (near + bx * 2.3 + vec3(y: 0.7) + bz * 1.2, near + vec3(y: 0.0) + bz * 0.1, 1.8)
    } else if view == 11 {
        // (From high over its bow, looking down and back along its wake: to judge how far the
        // water it's been through shows it.)
        let near = vec3(r.shown_at.x, boat.y, r.shown_at.y)
        let along = normalize(vec3(bz0.x, 0.0, bz0.z))
        (near + along * 5.0 + vec3(y: 19.0), near - along * 6.0, 1.3)
    } else {
        (eye, at, near)
    }
    // Never under the water: a crest running under the camera lifts it, as a buoy is lifted,
    // when the skiff's in the trough before it (a crest stands 3 m over the mean in this sea,
    // the camera a little less over the skiff). Smoothly, so a crest passing under rolls it up
    // and down; the views from the sea's own height only, the others well over it already.
    let (eye, at) = if view == 0 || view == 2 || view >= 5 {
        let floor = swell.height(vec2(eye.x, eye.z), t) + CLEAR
        let lift = soft_max(eye.y, floor, 0.6) - eye.y
        // (The player's view keeps looking the way it did; the others keep the skiff framed.)
        (eye + vec3(y: lift), if view == 0 { at + vec3(y: lift) } else { at })
    } else { (eye, at) }
    let forward = normalize(at - eye)
    let level = normalize(cross(vec3(y: 1.0), forward))
    let aboard = eye - boat - by * FREEBOARD
    let joints = Joints {
        hips: g.hips,
        neck: g.neck,
        fore_hand: g.fore_hand,
        aft_hand: g.aft_hand,
        fore_foot: g.fore_foot,
        aft_foot: g.aft_foot,
        sit: 0.0,
        gaze: g.gaze,
    }
    let rods = rods(g.mast, g.boom, joints)
    // (The player's camera leans a little with the skiff's heel.)
    let roll = if view == 0 { -r.shown_heel * 0.12 * k } else { 0.0 }
    let flat_up = cross(forward, level)
    let right = level * cos(roll) + flat_up * sin(roll)
    let up = cross(forward, right)
    Shot {
        resolution: vec2(f32(width), f32(height)),
        time,
        held: t,
        eye,
        forward,
        right,
        up,
        focal,
        sun: normalize(SUN),
        glow: normalize(ISLE + vec3(0.0, 700.0, -42.0) - eye),
        boat,
        boat_x: bx,
        boat_y: by,
        boat_z: bz,
        kinetic,
        slap: clamp((lift - 2.0) / 1.4, 0.0, 1.0),
        jolt: r.jolt,
        style: 1.0,
        speed: r.shown_speed,
        turn: r.shown_turn,
        power: r.shown_power,
        plane: r.shown_plane,
        gust: r.gust,
        mast: g.mast,
        boom: g.boom,
        belly: g.belly,
        hips: g.hips,
        neck: g.neck,
        fore_hand: g.fore_hand,
        aft_hand: g.aft_hand,
        fore_foot: g.fore_foot,
        aft_foot: g.aft_foot,
        gaze: g.gaze,
        eye_aboard: vec3(dot(aboard, bx), dot(aboard, by), dot(aboard, bz)),
        sheet: normalize(cross(g.mast, g.boom)),
        rods,
        wash: [vec4(-1.0); 6],
        stir_at: vec4(0.0),
        cloth: g.cloth,
        quiver: g.quiver,
        look: 0.0,
        lantern: 0.0,
        fine: 1.0,
        storm: OVERCAST,
        wind: WATER.wind * WATER.speed,
    }
}

/// The ray through pixel `px` (pixel centres at half-integers, y down).
pub fn ray(s: Shot, px: vec2) -> vec3 {
    let uv = (px * 2.0 - s.resolution) / s.resolution.y
    normalize(s.forward * s.focal + s.right * uv.x - s.up * uv.y)
}

// ---- noise -------------------------------------------------------------------------------

/// A hash of a point in [0, 1) (Hoskins's hash without sine).
pub fn hash2(p: vec2) -> f32 {
    var q = fract(vec3(p.x, p.y, p.x) * 0.1031)
    q += dot(q, vec3(q.y, q.z, q.x) + 33.33)
    fract((q.x + q.y) * q.z)
}

pub fn hash3(p: vec3) -> f32 {
    var q = fract(p * 0.1031)
    q += dot(q, vec3(q.z, q.y, q.x) + 31.32)
    fract((q.x + q.y) * q.z)
}

/// Value noise in [0, 1].
pub fn noise(p: vec2) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec2(3.0) - 2.0 * f)
    let a = hash2(i)
    let b = hash2(i + vec2(1.0, 0.0))
    let c = hash2(i + vec2(0.0, 1.0))
    let d = hash2(i + vec2(1.0, 1.0))
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

pub fn noise3(p: vec3) -> f32 {
    let i = floor(p)
    let f = p - i
    let u = f * f * (vec3(3.0) - 2.0 * f)
    let a = mix(
        mix(hash3(i), hash3(i + vec3(1.0, 0.0, 0.0)), u.x),
        mix(hash3(i + vec3(0.0, 1.0, 0.0)), hash3(i + vec3(1.0, 1.0, 0.0)), u.x),
        u.y,
    )
    let b = mix(
        mix(hash3(i + vec3(0.0, 0.0, 1.0)), hash3(i + vec3(1.0, 0.0, 1.0)), u.x),
        mix(hash3(i + vec3(0.0, 1.0, 1.0)), hash3(i + vec3(1.0, 1.0, 1.0)), u.x),
        u.y,
    )
    mix(a, b, u.z)
}

/// Fractal noise in about [0, 1]: `n` layers, each turned, twice the frequency, half as strong.
pub fn fbm(p: vec2, n: u32) -> f32 {
    var q = p
    var s = 0.0
    var a = 0.5
    var total = 0.0
    for _ in 0..n {
        s += a * noise(q)
        total += a
        q = vec2(1.6 * q.x - 1.2 * q.y, 1.2 * q.x + 1.6 * q.y) + vec2(17.3, -9.1)
        a *= 0.5
    }
    s / total
}

pub fn fbm3(p: vec3, n: u32) -> f32 {
    var q = p
    var s = 0.0
    var a = 0.5
    var total = 0.0
    for _ in 0..n {
        s += a * noise3(q)
        total += a
        q = vec3(1.6 * q.x - 1.2 * q.z, q.y * 2.0 + 3.1, 1.2 * q.x + 1.6 * q.z) +
            vec3(7.3, 0.0, -4.1)
        a *= 0.5
    }
    s / total
}

/// Cells at `p` (Worley's, one point a unit cell): how far to the nearest point and the next
/// nearest. Their difference is small along the walls between cells, as foam's lace and a
/// bubble raft's walls are.
pub fn cells(p: vec2) -> vec2 {
    let i = floor(p)
    var f1 = 8.0
    var f2 = 8.0
    for y in 0..3 {
        for x in 0..3 {
            let c = i + vec2(f32(x) - 1.0, f32(y) - 1.0)
            let at = c + vec2(hash2(c), hash2(c + vec2(19.1, 7.3))) * 0.9 + vec2(0.05)
            let r = length(p - at)
            if r < f1 {
                f2 = f1
                f1 = r
            } else if r < f2 {
                f2 = r
            }
        }
    }
    vec2(f1, f2)
}

/// A soft step of `x` across `edge`, `soft` wide: a painted tone's edge.
pub fn band(x: f32, edge: f32, soft: f32) -> f32 {
    smoothstep(edge - soft, edge + soft, x)
}

/// The luma of a linear colour.
pub fn luma(c: vec3) -> f32 {
    dot(c, vec3(0.2126, 0.7152, 0.0722))
}
