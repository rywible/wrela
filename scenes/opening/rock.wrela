// The rock and its cathedral as meshes: the isle's field (`isle::isle`) realized by the engine in
// tiles (`engine::solids`), each at the level its size on screen asks for, and drawn each drawing
// into how far each pixel is from the eye (`reach`). The far pass (`yonder`) starts its march
// there, a little short, instead of from the isle's bounds: it meets the surface in a few steps,
// and a pixel the mesh doesn't cover (nor any pixel round it) doesn't march the isle at all. Its
// light is the traced field's still: the mesh only says where to look.
//
// So the mesh must cover everything the field holds, and it's cut proud of the stone (`PROUD`)
// by its coarsest level's error, as the stacks' is (`stacked`). Cut at the stone itself, what
// was thinner than a level's cell wasn't in the mesh, and what wasn't in the mesh wasn't
// marched: the cathedral's spires ended blunt where they narrowed past a cell, its pinnacles
// and buttresses were gone, and its thin walls were holes with the sky through them.

use main::MESHED
use isle::{bounds, isle, isle_ao, isle_shadow}
use look::Shot
use engine::creature::{CreatureField, Placed}
use engine::look::Level
use engine::realize::{Eye, SkinVertex, solid}
use engine::solids::{Bake, Tiles, tiles}
use std::derive::{Box3, Interval}
use std::field::{Bound, Field, Surface, UNBOUNDED}
use std::gpu::{
    ClipPosition, Cull, DepthTexture, GpuBuffer, Rg32Float, Texture, VertexIndex,
    begin_pass_with_depth, draw,
}

/// The rock and its cathedral as a surface: the traced field's distance, and its material.
pub struct Isle: Copy + GpuData {
    pub unused: f32,
}

impl Surface for Isle {
    /// Unbounded: the scene culls it by its tiles (`engine::solids`), not by a sphere.
    fn bound(self) -> Bound {
        UNBOUNDED
    }

    fn distance(self, p: vec3) -> f32 {
        isle(p).x - PROUD
    }

    /// From its distance at fifteen places in the box (its middle, its corners and its faces'
    /// middles) and a bound on its steepness between them, not interval arithmetic through the
    /// whole field (whose kernel would pass the 256 KiB a pipeline may be).
    ///
    /// Not from its middle alone. The field isn't a distance everywhere: outside each of its
    /// pieces' bounds it's how far those bounds are, and it steps where one piece's bounds end,
    /// so what it reads at one place bounds little of what it reads a block away. Where a box
    /// that holds some of the mesh's surface is taken to hold none, the mesh has a hole;
    /// through a hole in its near side a pixel sees only its far side, the march begins behind
    /// the stone, and the cathedral's great spire had a band of sky across it.
    fn interval(self, over: Box3) -> Interval {
        let c = over.center()
        let h = 0.5 * (over.hi - over.lo)
        var lo = isle(c).x
        var hi = lo
        for k in 0..8 {
            let corner = vec3(
                if (k & 1) == 0 { -h.x } else { h.x },
                if (k & 2) == 0 { -h.y } else { h.y },
                if (k & 4) == 0 { -h.z } else { h.z },
            )
            let d = isle(c + corner).x
            lo = min(lo, d)
            hi = max(hi, d)
        }
        for k in 0..6 {
            let way = if k < 2 { vec3(h.x, 0.0, 0.0) } else if k < 4 { vec3(0.0, h.y, 0.0) } else {
                vec3(0.0, 0.0, h.z)
            }
            let d = isle(c + way * (if k % 2 == 0 { 1.0 } else { -1.0 })).x
            lo = min(lo, d)
            hi = max(hi, d)
        }
        // (No point of the box is farther from one of the fifteen than half its half-diagonal.)
        let r = STEEP * 0.5 * length(h)
        Interval { lo: lo - PROUD - r, hi: hi - PROUD + r }
    }
}

impl Field<f32> for Isle {
    fn channels(self, p: vec3) -> f32 {
        isle(p).y
    }
}

/// How steep the isle's field is taken to be between the places `Isle::interval` reads it. Not
/// a bound that's proved: the field steps where its pieces' bounds end, so none holds
/// everywhere. At 1.5 the cathedral's great spire still had two bites out of it from the
/// opening's shot; at 3 it's whole, there and a minute's sailing on.
const STEEP: f32 = 3.0

/// How far proud of the stone the mesh stands (m): the coarsest level's error, half its cell (a
/// tile's first mesh is its coarsest, and stands until the budget comes to it). So nothing of
/// the stone is outside any level's mesh, and a spire a metre across is in it, sixteen fat.
const PROUD: f32 = 16.0

/// The isle's meshes, kept by the engine.
pub type Rock = Tiles<CreatureField<Placed<Isle>>>

/// The levels (cells, m), coarse to fine, and each's estimated cost a block (us).
pub const LEVELS = [
    Level { cell: 32.0, cost_us: 0.3 },
    Level { cell: 16.0, cost_us: 0.3 },
    Level { cell: 8.0, cost_us: 0.3 },
    Level { cell: 4.0, cost_us: 0.3 },
]

/// A tile's side (m).
pub const SIDE: f32 = 512.0

/// How far short of the mesh the march starts (m), and how far from the mesh the surface the
/// march meets may be and the mesh's cooked shade still be its own (`baked_at`): past the mesh's
/// pride and its coarsest level's error.
pub const SHORT: f32 = 40.0

/// What's cooked onto the rock's meshes (`engine::solids::Bake`): how much of the sun reaches
/// each vertex past the isle, and how much of the sky (the far pass's `isle_shadow`, `isle_ao`,
/// marched once a mesh, not once a pixel a drawing). The sun doesn't move.
pub struct Shade: Copy + GpuData {
    pub sun: vec3,
}

impl Bake for Shade {
    /// (At the stone under the vertex, not at the vertex: the mesh stands `PROUD` of it, and out
    /// there nothing hides the sky.)
    fn at(self, p: vec3, n: vec3) -> vec4 {
        var q = p
        for _ in 0..3 {
            q = q - n * (isle(q).x * 0.8)
        }
        vec4(isle_shadow(q + n * LIFT, self.sun, LIFT, 0.5), isle_ao(q, n), 0.0, 0.0)
    }
}

/// How far off its surface a vertex's shadow starts (m): the far pass's, 8 km off.
const LIFT: f32 = 10.0

/// The tiles a drawing cooks `Shade` onto.
const BAKES: u32 = 24

/// The isle's box: its bounding sphere's.
pub fn isle_box() -> Box3 {
    let b = bounds()
    Box3 { lo: b.xyz - vec3(b.w), hi: b.xyz + vec3(b.w) }
}

/// The isle's tiles, none realized yet.
pub fn rock() -> Rock {
    let shape = solid(Isle { unused: 0.0 }, isle_box(), name: "isle")
    tiles(shape.field(), isle_box(), SIDE, LEVELS, max_cell_px: 2.0, budget_us: 6000.0)
}

/// The near and far planes of `reach`'s depth (m).
pub const NEAR: f32 = 20.0
const FAR: f32 = 100000.0

/// `s`'s camera as a view-projection: the pixel a point lands on is the one whose `ray` meets it.
pub fn view_proj(s: Shot) -> mat4 {
    let a = s.focal * s.resolution.y / s.resolution.x
    let k = FAR / (FAR - NEAR)
    let row0 = vec4(s.right * a, -dot(s.right, s.eye) * a)
    let row1 = vec4(s.up * s.focal, -dot(s.up, s.eye) * s.focal)
    let row3 = vec4(s.forward, -dot(s.forward, s.eye))
    let row2 = row3 * k - vec4(0.0, 0.0, 0.0, NEAR * k)
    mat4(
        vec4(row0.x, row1.x, row2.x, row3.x),
        vec4(row0.y, row1.y, row2.y, row3.y),
        vec4(row0.z, row1.z, row2.z, row3.z),
        vec4(row0.w, row1.w, row2.w, row3.w),
    )
}

/// The rock's tiles stepped on for `s`: each tile's level, what the budget realizes, and the
/// sun's shade cooked onto what's new. Whether every tile has a mesh.
pub fn step_rock(rock: mut Rock, s: Shot, sun: vec3) -> bool {
    let fovy = 2.0 * atan(1.0 / s.focal)
    rock.frame(Eye { at: s.eye, view_proj: view_proj(s), height: s.resolution.y, fovy })
    let _ = rock.bake(Shade { sun }, BAKES)
    rock.whole()
}

/// Whether a view (`vp`, `view_proj`) can see any of a tile's cube: its sphere against the
/// view's sides, and not wholly behind the eye. A tile it can't see isn't drawn: each tile is a
/// draw of its own, with its own buffers bound, and in a browser a draw costs some forty
/// microseconds whatever it covers. The sea's stacks are hundreds of tiles, most behind the eye
/// or off to the sides, and drawing them all was more of a frame than shading the picture.
pub fn seen(vp: mat4, cube: Box3) -> bool {
    let r = 0.5 * length(cube.hi - cube.lo)
    let clip = vp * vec4(0.5 * (cube.lo + cube.hi), 1.0)
    let scale = max(
        length(vec3(vp[0].x, vp[1].x, vp[2].x)),
        length(vec3(vp[0].y, vp[1].y, vp[2].y)),
    )
    let rs = r * scale
    clip.w > -r && abs(clip.x) <= clip.w + rs && abs(clip.y) <= clip.w + rs
}

/// How far each pixel of `s` is from the eye to the rock's mesh (m), `FAR` where it sees none,
/// and the shade cooked there (`Shade`, packed: `pack`; -1 on a tile not cooked yet, whose mesh
/// is new: `unbaked` stands in for its numbers): drawn into `out`. Only once every tile has a
/// mesh (`ready`); until then `out` says nothing and the far pass marches and shades as it did.
/// Whether it drew.
pub fn reach(
    rock: Rock,
    s: Shot,
    ready: bool,
    unbaked: GpuBuffer<vec4>,
    out: mut Texture<Rg32Float>,
    depth: mut DepthTexture,
) -> bool {
    if !MESHED || !ready {
        return false
    }
    let vp = view_proj(s)
    let pass = begin_pass_with_depth(mut out, mut depth, clear: vec4(FAR, 0.0, 0.0, 0.0))
    for i in 0..rock.len() {
        if !seen(vp, rock.cubes[i]) {
            continue
        }
        borrow m = rock.mesh(i)
        let cooked = rock.has_baked(i)
        draw(
            pass,
            placed.bind(
                verts: m.verts.items(),
                shade: if cooked { rock.baked(i).items() } else { unbaked.items() },
                cooked: if cooked { 1 } else { 0 },
                view_proj: vp,
                eye: s.eye,
            ),
            how_far.bind(),
            indices: m.quads.items(),
            indirect: m.draw.items(),
            cull: Cull::None,
        )
    }
    pass.end()
    true
}

pub struct Reached: Copy {
    pub clip: ClipPosition,
    pub far: f32,
    pub shade: vec2,
}

@vertex
pub fn placed(
    v: VertexIndex,
    verts: [SkinVertex],
    shade: [vec4],
    cooked: u32,
    view_proj: mat4,
    eye: vec3,
) -> Reached {
    let p = verts[v.index].pos
    Reached {
        clip: ClipPosition { position: view_proj * vec4(p, 1.0) },
        far: length(p - eye),
        shade: if cooked == 1 { shade[v.index].xy } else { vec2(-1.0) },
    }
}

@fragment
pub fn how_far(r: Reached) -> vec2 {
    vec2(r.far, if r.shade.x < 0.0 { -1.0 } else { pack(r.shade) })
}

/// Two numbers from 0 to 1 in one, a part in 4095 each (an `f32` holds every whole number of
/// its 24 bits).
pub fn pack(v: vec2) -> f32 {
    let q = round(clamp(v, vec2(0.0), vec2(1.0)) * 4095.0)
    q.x * 4096.0 + q.y
}

pub fn unpack(x: f32) -> vec2 {
    let hi = floor(x / 4096.0)
    vec2(hi, x - hi * 4096.0) / 4095.0
}

/// The shade cooked where the mesh is at pixel `pf` (`Shade`: the sun, the sky), if the mesh
/// there is the surface the march met `t` off; (-1, -1) where it isn't (an edge, where the
/// mesh shows what's behind or nothing), and it's marched.
pub fn baked_at(reach: Texture<Rg32Float>, pf: vec2, size: vec2, t: f32) -> vec2 {
    let q = clamp(floor(pf), vec2(0.0), size - vec2(1.0))
    let r = reach.load(u32(q.x), u32(q.y))
    if r.x >= FAR || abs(r.x - t) > SHORT || r.y < 0.0 { vec2(-1.0) } else { unpack(r.y) }
}

/// Where the march through pixel `pf` (px, the full drawing's) should start along the ray, by
/// the mesh's `reach`: a little short of the nearest the mesh is in the pixel and the eight round
/// it; past `hi` (the isle's bounds' far side) where none of them sees it.
pub fn march_from(reach: Texture<Rg32Float>, pf: vec2, size: vec2, lo: f32, hi: f32) -> f32 {
    march_short(reach, pf, size, lo, hi, SHORT)
}

/// `march_from`, starting `short` m short of the mesh: as far as the mesh may stand inside the
/// surface it's of (the rock's, by its coarsest level's error; a mesh cut proud of its surface
/// by that error, as the stacks' is, by nothing but its depth's rounding).
pub fn march_short(
    reach: Texture<Rg32Float>,
    pf: vec2,
    size: vec2,
    lo: f32,
    hi: f32,
    short: f32,
) -> f32 {
    let q = floor(pf)
    var near = FAR
    for j in 0..3 {
        for i in 0..3 {
            let at = clamp(q + vec2(f32(i) - 1.0, f32(j) - 1.0), vec2(0.0), size - vec2(1.0))
            near = min(near, reach.load(u32(at.x), u32(at.y)).x)
        }
    }
    if near >= FAR { hi + 1.0 } else { max(lo, near - short) }
}

/// A box `Isle::interval` clears holds none of the mesh's surface: where it says the field,
/// less the mesh's pride, is over nought throughout, it is at every one of 64 places in the
/// box (and where it says under nought, under). Tried on boxes the size of the two finest
/// levels' blocks with the cell round them that the realizer takes in, on a lattice over the
/// cathedral and its great spire. (A guard, not a proof: on this lattice the bound it replaced
/// cleared no box wrongly either, though the spire it meshed had a band missing.)
@test
@fuel(2 ** 38)
fn a_box_cleared_of_the_isle_holds_none_of_its_meshs_surface() {
    let field = Isle { unused: 0.0 }
    var cleared = 0
    var wrong = 0
    for level in [2, 3] {
        // (A block's four cells and one more each way.)
        let half = LEVELS[level].cell * 3.0
        var y = look::ISLE.y + 250.0
        while y < look::ISLE.y + 900.0 {
            var z = look::ISLE.z - 150.0
            while z < look::ISLE.z + 150.0 {
                var x = look::ISLE.x - 240.0
                while x < look::ISLE.x + 60.0 {
                    let c = vec3(x, y, z)
                    let over = Box3 { lo: c - vec3(half), hi: c + vec3(half) }
                    let said = field.interval(over)
                    if said.lo > 0.0 || said.hi < 0.0 {
                        cleared += 1
                        var crossed = false
                        for k in 0..64 {
                            let at = (vec3(f32(k % 4), f32((k / 4) % 4), f32(k / 16)) + vec3(0.5)) /
                                4.0
                            let d = field.distance(over.lo + (over.hi - over.lo) * at)
                            crossed = crossed || (d > 0.0) != (said.lo > 0.0)
                        }
                        if crossed {
                            wrong += 1
                        }
                    }
                    x += 37.0
                }
                z += 37.0
            }
            y += 37.0
        }
    }
    std::io::print(f"  {cleared} boxes cleared, {wrong} of them holding some of the surface")
    assert(wrong == 0, f"{wrong} of {cleared} cleared boxes hold some of the mesh's surface")
}
