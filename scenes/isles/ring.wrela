// The Still Ring.
//
// Premise: a ring of black basalt cliffs a kilometre across, broken by one mouth, round a lagoon
// that never moves. No wave crosses its mouth: the sea's swell runs in and stops dead at a line,
// and inside the water is a black mirror. What it mirrors isn't this sky. At noon it holds night,
// the stars of no chart anyone keeps, and low over its far rim a moon too large, which no one has
// ever seen in the sky itself.
//
// Rule it bends: a reflection that isn't of here.
//
// People: a few dozen fishers in stilt huts along the inner shelf, who sleep by day and fish the
// reflection by night, and say what they pull from it is never quite fish.
//
// Clue (for the theory that home is another sky): the stars the lagoon shows are few and sharp,
// and one cluster of them is the pattern of the fire marks on the traveller's own mask. Other
// theories have it that the lagoon shows the sky under the sea, or what this sky looked like
// before; none of them is confirmed, and none can be.
//
// Silhouette: a low, long, flat-topped dark wall on the horizon with a notch in it, the one shape
// of its kind in the sea, and through the notch, from the right bearing, a pale disc lying in black
// water.

use engine::far::shown
use opening::look::{hash2, noise, noise3}
use isle::{BASALT, Finish, Isle, STILL, THATCH, TIMBER, TURF, matte}
use kit::{
    basalt, boulder, columns, hex_cell, hut, near, sd_hex, sector, stilts, thatch, timber, turf,
    turn,
}

/// The Still Ring, placed: its centre at sea level (the world's), the heading its mouth opens to
/// (rad, from +x toward +z), and its shape: the lagoon's radius (m), the cliffs' height over the
/// sea (m) and how wide the mouth is (rad).
pub struct Ring: Copy + GpuData {
    pub at: vec3,
    pub mouth: f32,
    pub radius: f32,
    pub height: f32,
    pub gap: f32,
}

/// The shape Ryan picks among (`--set VARIANT=k` in the workbench).
pub fn ring_variant(k: u32, at: vec3, mouth: f32) -> Ring {
    if k == 1 {
        // The first middle size, wider and lower.
        Ring { at, mouth, radius: 520.0, height: 40.0, gap: 0.2 }
    } else if k == 2 {
        // Wide and low, the mouth a broad bay.
        Ring { at, mouth, radius: 680.0, height: 28.0, gap: 0.32 }
    } else {
        // Taller and tighter: a crater's rim (Ryan's pick, Nov 5 2026).
        Ring { at, mouth, radius: 380.0, height: 62.0, gap: 0.16 }
    }
}

/// How far round from the mouth heading `a` is (rad, 0 to π).
fn from_mouth(a: f32, mouth: f32) -> f32 {
    let x = a - mouth
    abs(x - 6.2831853 * floor((x + 3.1415927) / 6.2831853))
}

/// The cliffs' line round the ring at heading `a`: its centre's radius, its half-width and its top
/// (m).
fn rim(r: Ring, a: f32) -> vec3 {
    let along = vec2(cos(a), sin(a)) * 3.0
    let rr = r.radius * (1.0 + 0.05 * (noise(along + vec2(3.1)) - 0.5))
    let half = 34.0 + 26.0 * noise(along * 1.7 + vec2(7.7))
    // Its top in blocks the faults have left a few metres apart, each a stretch of a hundred
    // metres or so, tilted a little, rolling over the ring's length: a skyline in steps, never a
    // ruler's edge.
    let round = a * r.radius
    let bf = round / 110.0 + noise(along * 4.0) * 0.8
    let block = floor(bf)
    // (Each block's step blended into the next over its last fifth, so the rim breaks in a few
    // falls, not a battlement's teeth.)
    let into = smoothstep(0.8, 1.0, fract(bf))
    let fault = mix(hash2(vec2(block, 4.4)), hash2(vec2(block + 1.0, 4.4)), into) *
        0.45 *
        r.height -
        0.22 * r.height
    var top = r.height * (0.55 + 0.95 * noise(along * 1.3 + vec2(1.9))) + fault
    // And saddles where the rim sags between its heights.
    top -= r.height * 0.35 * smoothstep(0.6, 0.85, noise(along * 2.7 + vec2(8.3)))
    // (Its skyline steps in whole flows, each 11 m: a flow's top stays level till it ends, then
    // the rim drops to the next, as a basalt plateau's edge does; never a dune's roll.)
    let flows = top / 11.0
    top = (floor(flows) + smoothstep(0.85, 1.0, fract(flows))) * 11.0
    // At the mouth the cliffs stop: their ends fall to the sea in a few broken steps, and between
    // them the wall is gone below the water.
    let m = from_mouth(a, r.mouth)
    // (In three falls of a column's height each, never a smooth hump.)
    let open = floor(smoothstep(r.gap * 0.5, r.gap * 0.5 + 0.1, m) * 3.0 + 0.35) / 3.0
    top = mix(-12.0, top, open)
    vec3(rr, half, top)
}

/// How far `q` (from the centre) is from the cliffs' mass, and the top over it.
fn cliffs(r: Ring, q: vec3) -> vec2 {
    let a = atan2(q.z, q.x)
    let line = rim(r, a)
    let rad = length(vec2(q.x, q.z))
    let u = rad - line.x
    // Its faces worn back unevenly as the sea undercuts them; the outer face more.
    let wear = (noise3(q * vec3(0.03, 0.012, 0.03)) - 0.5) * 14.0 + (noise3(q * 0.09) - 0.5) * 4.0
    // Its faces broken into the bays and buttresses columns fall away in: gullies a few metres
    // across running straight down the cliff, the column's grain a far eye still reads.
    let round = a * line.x
    let gully = (noise(vec2(round / 7.0 + noise(vec2(round / 40.0, 1.0)) * 3.0, q.y / 50.0)) -
        0.5) *
        3.0 +
        (noise(vec2(round / 2.3, q.y / 25.0 + 3.0)) - 0.5) * 1.0
    // Undercut at the waterline, where the sea works at it; and over it the scree the cliff has
    // shed, a slope of fallen columns banked against its foot.
    let notch = 2.0 * exp(-q.y * q.y / 6.0)
    // Sea caves: every so often the sea has worked a column bay loose at the waterline and
    // hollowed it back into the cliff, a black mouth 8 to 14 m high.
    let cave_k = floor(round / 45.0)
    let cave_at = (cave_k + 0.3 + 0.4 * hash2(vec2(cave_k, 2.2))) * 45.0
    let cave_w = 4.0 + 4.0 * hash2(vec2(cave_k, 6.6))
    let cave = if hash2(vec2(cave_k, 3.3)) > 0.55 && u > 0.0 {
        14.0 *
            exp(-(round - cave_at) * (round - cave_at) / (cave_w * cave_w)) *
            smoothstep(cave_w * 1.6, 0.0, q.y) *
            smoothstep(-3.0, 0.0, q.y)
    } else { 0.0 }
    let scree = max(9.0 - q.y, 0.0) *
        (0.9 + 0.8 * noise(vec2(round / 30.0, 6.0))) *
        smoothstep(0.3, 0.6, noise(vec2(round / 90.0, 2.0)))
    // The ring is lava flow laid on flow, each ten metres or so: where one ends on the next its
    // soft red bole weathers back, so the cliff stands in tiers, each its own colonnade.
    let flow = q.y / 11.0 + noise(vec2(round / 160.0, 3.0)) * 1.2
    let bole = smoothstep(0.12, 0.0, abs(fract(flow) - 0.5) - 0.38) * smoothstep(3.0, 6.0, q.y)
    let half = line.y + wear + gully * 0.6 + scree - 1.6 * bole - if u > 0.0 && scree < 0.5 {
        notch
    } else { 0.0 }
    // Its brink crumbled: the top falls away over its last metres, under the turf.
    let brink = smoothstep(4.0, -2.0, half - abs(u)) * 2.5
    let wall = max(abs(u) - half, max(q.y - line.z + brink, -q.y - 40.0))
    // The inner shelf the fishers' huts stand along: a step a few metres over the lagoon.
    let shelf = max(abs(u + half + 7.0) - 9.0, max(q.y - 2.6, -q.y - 40.0))
    let mass = min(wall, shelf) * 0.7
    vec2(mass, if shelf < wall { 2.6 } else { line.z })
}

/// The two stacks that stand at the mouth's sides, its gateposts: basalt pillars taller than the
/// cliffs, each a bundle of columns, and the boulders round their feet.
fn gates(r: Ring, q: vec3, px: f32) -> f32 {
    var d = 1.0e3
    for i in 0..2 {
        let side = f32(i) * 2.0 - 1.0
        let a = r.mouth + side * (r.gap * 0.5 + 0.045)
        let out = vec2(cos(a), sin(a))
        let along = vec2(-out.y, out.x)
        let c = out * (r.radius + 85.0)
        let tall = r.height * (1.8 - 0.3 * f32(i))
        // Its footprint: about 20 m round, lobed, a lesser stack leaning off it seaward.
        let v = vec2(q.x, q.z) - c
        let ang = atan2(v.y, v.x)
        let reach = 18.0 +
            6.0 * noise(vec2(ang * 1.2 + f32(i) * 7.0, 0.5)) +
            14.0 * smoothstep(0.7, 1.0, dot(normalize(v + vec2(1.0e-4)), out))
        let rv = length(v)
        // Its height over each point: the heart tallest, falling away in steps to its skirts, its
        // top tilted as its flow's was.
        let fall = smoothstep(0.25, 1.0, rv / reach)
        let tilt = dot(v, out) * 0.18 + dot(v, along) * 0.08 * side
        let crown = tall * (1.0 - 0.75 * fall) - tilt
        let shell = max(rv - reach, max(q.y - crown, -q.y - 30.0)) * 0.7
        if px > 1.0 || shell > 6.0 {
            d = min(d, shell)
        } else {
            // A bundle of columns 3.2 m across, each to its own height under the crown, some
            // snapped off metres short.
            let (cc, lv) = hex_cell(vec2(q.x, q.z), 3.2)
            let cv = cc - c
            let h = hash2(cc * 0.37)
            let cr = length(cv)
            let c_fall = smoothstep(0.25, 1.0, cr / reach)
            let c_top = tall * (1.0 - 0.75 * c_fall) -
                (dot(cv, out) * 0.18 + dot(cv, along) * 0.08 * side) -
                floor(h * 3.0) * 1.8 -
                step(0.85, h) * 9.0
            let inside = cr < reach
            let col = if inside { max(sd_hex(lv, 3.2) + 0.1, max(q.y - c_top, -q.y - 30.0)) } else {
                1.0e3
            }
            let edge = 1.6 - max(abs(lv.x), dot(abs(lv), vec2(0.5, 0.8660254)))
            d = min(d, min(col, max(shell, 0.0) + max(edge, 0.1)))
        }
    }
    d
}

/// The talus round the ring's outer foot: blocks the cliffs have shed, house-sized, half sunk in
/// the sea.
fn talus(r: Ring, q: vec3, px: f32) -> f32 {
    let n = floor(6.2831853 * r.radius / 9.0)
    let (c, k) = sector(vec2(q.x, q.z), n)
    let a = k * 6.2831853 / n
    let line = rim(r, a)
    if line.z < 2.0 || hash2(vec2(k, 5.5)) < 0.35 {
        return 1.0e3
    }
    let rb = 2.0 + 2.8 * hash2(vec2(k, 1.9))
    let out = line.x + line.y + 3.0 + 7.0 * hash2(vec2(k, 8.4))
    let p = vec3(c.x - out, q.y + rb * 0.35, c.y + (hash2(vec2(k, 2.6)) - 0.5) * 4.0)
    if length(p) > rb + 6.0 {
        return length(p) - rb - 4.0
    }
    boulder(p, rb, hash2(vec2(k, 7.3)))
}

/// The fishers' huts, on stilts in the lagoon along the inner shelf, in the stretch of the ring
/// left of the mouth.
fn village(r: Ring, q: vec3, px: f32) -> vec2 {
    let n = floor(6.2831853 * r.radius / 15.0)
    let (c, k) = sector(vec2(q.x, q.z), n)
    let a = k * 6.2831853 / n
    let m = a - r.mouth
    let side = m - 6.2831853 * floor(m / 6.2831853)
    if side < 0.3 || side > 2.6 || hash2(vec2(k, 3.3)) < 0.25 {
        return vec2(1.0e3, TIMBER)
    }
    let line = rim(r, a)
    let out = line.x - line.y - 22.0 - 6.0 * hash2(vec2(k, 1.1))
    // (The door faces the lagoon: the hut's +x turned toward the centre.)
    let p = vec3(out - c.x, q.y - 2.3, c.y + (hash2(vec2(k, 8.1)) - 0.5) * 4.0)
    let w = 3.6 + 1.2 * hash2(vec2(k, 2.7))
    let l = 4.4 + 1.6 * hash2(vec2(k, 5.9))
    let reach = length(p) - 9.0
    if reach > 2.0 {
        return vec2(reach, TIMBER)
    }
    let hh = hut(p, w, l, px)
    near(vec2(hh.x, if hh.y < 0.5 { TIMBER } else {
        THATCH
    }), vec2(stilts(p, w, l, -3.3, px), TIMBER))
}

/// The other sky, which the lagoon mirrors along `d`: night, few sharp stars, and a moon too large.
fn other_sky(r: Ring, d: vec3) -> vec3 {
    var c = vec3(0.004, 0.006, 0.014) * (1.0 - 0.6 * clamp(d.y * 3.0, 0.0, 1.0))
    let az = atan2(d.z, d.x)
    let el = asin(clamp(d.y, -1.0, 1.0))
    // Two fields of stars: many faint and small, and a few large and bright, each its own colour,
    // white, blue-white or a dull amber.
    for layer in 0..2 {
        let scale = if layer == 0 { 160.0 } else { 55.0 }
        let rare = if layer == 0 { 0.985 } else { 0.992 }
        let g = vec2(az, el) * scale
        let cell = floor(g)
        let h = hash2(cell + vec2(f32(layer) * 31.0))
        if h > rare {
            let at = cell + vec2(hash2(cell + vec2(1.7)), hash2(cell + vec2(9.2))) * 0.6 + vec2(0.2)
            let sharp = if layer == 0 { 22.0 } else { 30.0 }
            let k = exp(-dot(g - at, g - at) * sharp)
            let tone = hash2(cell + vec2(4.4))
            let hue = if tone < 0.6 { vec3(0.9, 0.92, 1.0) } else if tone < 0.85 {
                vec3(0.7, 0.8, 1.0)
            } else { vec3(1.0, 0.75, 0.45) }
            c += hue * k * (if layer == 0 { 1.2 } else { 4.0 }) * (h - rare) / (1.0 - rare)
        }
    }
    // The moon: risen over the far rim from the mouth, seven degrees across, so the lagoon holds
    // it clear of the rim's own reflection. A sphere, full, darker toward its limb, its seas
    // grey on it, in a ring of its own light.
    let m = normalize(vec3(-cos(r.mouth), 0.26, -sin(r.mouth)))
    let off = acos(clamp(dot(d, m), -1.0, 1.0))
    let rr = clamp(off / 0.06, 0.0, 1.0)
    let disc = 1.0 - smoothstep(0.058, 0.061, off)
    let limb = pow(max(1.0 - rr * rr, 0.0), 0.3)
    let seas = 0.25 * smoothstep(0.5, 0.7, noise3(d * 28.0 + vec3(4.0))) + 0.1 * noise3(d * 120.0)
    let face = limb * (0.85 - seas)
    c = mix(c, vec3(0.7, 0.69, 0.64) * face, disc)
    c += vec3(0.5, 0.55, 0.65) *
        (0.06 * exp(-max(off - 0.06, 0.0) * 30.0) + 0.012 * exp(-off * 5.0))
    c
}

impl Isle for Ring {
    fn bounds(self) -> vec4 {
        vec4(self.at + vec3(0.0, 10.0, 0.0), self.radius + 180.0)
    }

    fn mirrored(self, p: vec3, px: f32) -> f32 {
        let q = p - self.at
        let mt = cliffs(self, q)
        min(columns(q, mt.x, mt.y, 1.4, px), gates(self, q, px))
    }

    fn field(self, p: vec3, px: f32) -> vec2 {
        let q = p - self.at
        let mt = cliffs(self, q)
        let mass = mt.x
        let top = mt.y
        // (The columns stand in the faces; on the tops the turf has long since buried them.)
        let rock = if q.y > top - 1.2 { mass } else { columns(q, mass, top, 1.4, px) }
        var f = vec2(rock, BASALT)
        f = near(f, vec2(gates(self, q, px), BASALT))
        if q.y < 8.0 {
            f = near(f, vec2(talus(self, q, px), BASALT))
        }
        // The still water: a level sheet over the lagoon, to the line its mouth stops the sea at.
        let rad = length(vec2(q.x, q.z))
        let still = max(max(q.y, -q.y - 3.0), rad - self.radius)
        f = near(f, vec2(still, STILL))
        if rad > self.radius * 0.7 && rad < self.radius + 20.0 && q.y < 12.0 {
            f = near(f, village(self, q, px))
        }
        f
    }

    fn finish(self, p: vec3, n: vec3, d: vec3, id: f32, foot: f32) -> Finish {
        let q = p - self.at
        if id == STILL {
            // A black mirror of the other sky: all the reflection water gives, none of this sky's.
            // (It reflects all of it, as no water does: a mirror, not a lake.)
            let rd = vec3(d.x, abs(d.y), d.z)
            return Finish {
                albedo: vec3(0.0),
                rough: 0.05,
                metal: 0.0,
                glow: other_sky(self, rd),
                line: 1.0,
                gloss: 0.0,
            }
        }
        if id == THATCH {
            return matte(thatch(q, foot), 0.95)
        }
        if id == TIMBER {
            return matte(timber(q, q.x + q.z, foot), 0.85)
        }
        // Basalt, and the salt turf on its tops.
        var a = basalt(q, n, 1.4, foot)
        let top = cliffs(self, q).y
        // A lava flow's two tiers, as basalt cliffs stand: the colonnade below, its columns
        // straight and pale with salt; over it the entablature, darker, its columns thin and
        // crazed, in a band a far eye reads across the whole ring.
        let upper = smoothstep(
            0.5,
            0.62,
            (q.y + noise(vec2(atan2(q.z, q.x) * 40.0, 0.5)) * 3.0) / max(top, 1.0),
        )
        a *= mix(1.15, 0.7, upper)
        let flow = q.y / 11.0 + noise(vec2(atan2(q.z, q.x) * self.radius / 160.0, 3.0)) * 1.2
        let bole = smoothstep(0.12, 0.0, abs(fract(flow) - 0.5) - 0.4) * smoothstep(3.0, 6.0, q.y)
        a = mix(a, vec3(0.03, 0.025, 0.025), bole * 0.35)
        let grass = smoothstep(0.75, 0.92, n.y) *
            smoothstep(top - 2.5, top - 0.4, q.y) *
            smoothstep(0.3, 0.5, noise3(q * 0.06))
        a = mix(a, turf(q), grass * 0.9)
        // Where the swell breaks on the cliffs' foot, a ragged line of white water and the wet,
        // salt-white rock over it.
        let rad = length(vec2(q.x, q.z))
        let seaward = rad > self.radius + 5.0
        let wash = noise(vec2(atan2(q.z, q.x) * self.radius / 6.0, 0.3))
        let foam = if seaward {
            smoothstep(1.6 + 1.2 * wash, 0.3, q.y) *
                smoothstep(-0.6, 0.2, q.y) *
                smoothstep(0.3, 0.6, noise3(q * vec3(0.4, 1.5, 0.4)))
        } else { 0.0 }
        a = mix(a * 0.6, vec3(0.42, 0.44, 0.46), foam * 0.5)
        matte(a, 0.9)
    }

    fn mirror(self, id: f32) -> f32 {
        if id == STILL { 2.0 } else { 0.0 }
    }

    fn mirrored_tint(self) -> vec4 {
        // (Black basalt: the sky it hides is nearly all hidden.)
        vec4(0.3, 0.3, 0.32, 0.25)
    }

    fn dry(self, p: vec3) -> bool {
        length(vec2(p.x - self.at.x, p.z - self.at.z)) < self.radius
    }
}
