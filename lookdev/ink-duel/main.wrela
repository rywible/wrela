// The duel: the MMO's combat feel's first playable test, in Kinetic Ink. The wanderer (you) faces
// a brawler among standing stones. Read its wind-ups, dodge through its blows (a dodge is
// untouchable for most of its first quarter second), answer its recoveries with a jab and a
// cross or a hook, and fill its posture (each blow, and each of its blows dodged cleanly) until it
// breaks; then, in front of it, the riposte: the uppercut that launches it.
//
//     W A S D, or the left stick        walk (the camera's way; locked on to the brawler)
//     Space, or East (B / Circle)        dodge
//     J or the left button, or RB/R1     jab (pressed again in it, a cross; at a broken
//                                        brawler's front, the riposte)
//     K or the right button, or RT/R2    hook
//     L held, or LB/L1 held              guard (raised just as a blow comes, a deflect: the
//                                        brawler's posture takes it; raised early, a block)
//
// The sim (`duel`) steps at 60 ticks a second on a timeline (engine::timeline), as a client
// predicting its own game would; beside it the program runs the server's copy, which hears each
// input `LAG` ticks late (two-thirds of a 200 ms round trip) and steps it at the tick it was
// stamped with, and checks the two agree: in a fight against the world, every blow is the
// client's own prediction, and the server's word, LAG later, is the same.
//
// The drawing (`present`, `motion`) never feeds back: poses, feet planted on the ground, the lean
// and the flinch, held drawings on twos (fours as the moment rises), the smear, the impact frames,
// the hit-stops' shake are how a frame shows what the sim decided. The player's own act always
// draws at once (a new drawing on any change of what the wanderer is doing), so holding drawings
// never delays a dodge.
//
// `--set AUTO=true` lets the test bot (`duel::Bot`: a person's 200 ms reactions) play, for
// captures.

use arena::{Arena, SUN, air_of, arena}
use body::{BRAWLER, Bones, WANDERER, figure}
use duel::{Bot, LIES, NEVER, World, advance, play, second, world}
use engine::character::{ByChannels, Smear, cast, parts_of}
use engine::clip::{Local, palette, rest}
use engine::combat::{Act, Fighter, HZ, Intent, Move, Press}
use engine::creature::{MAX_BONES, Skeleton}
use engine::frame::{Aim, Change, Frame, Gathered, Quality}
use engine::light::sunlight
use engine::look::{CreatureLook, Mesh as Tolerance}
use engine::distance::rigid_inverse
use engine::noise::hash2
use engine::physique::Capsule
use engine::probes::grid
use engine::switches::Switches
use engine::terrain::{Clipmap, Terrain}
use engine::timeline::Timeline
use engine::view::first_camera
use hud::Hud
use moves::{BRAWLER_MOVES, COILED, CONTACT, HOOK_N, JAB_N, WANDERER_MOVES}
use motion::{Carriage, carriage, carry, flinch}
use physics::Body
use pose::{Feet, Pose, locals}
use poses::GUARD
use present::{Clips, Placing, brawler, clips, placing_matrix, wanderer}
use std::input::{Button, Event, Key, PadAxis, PadButton, events}
use std::io::print
use styles::kinetic::Kinetic

/// The look the duel draws in, and the switches it draws with (`content/styles`: Kinetic Ink's).
pub type LOOK = Kinetic

pub type SWITCHES = Inked

/// Kinetic Ink's switches (lookdev/ink-yard's): what a graphic look doesn't draw is built out.
pub struct Inked {}

impl Switches for Inked {
    const CLOUDS: bool = false
    const PROBES: bool = false
    const BLOOM: bool = false
    const FOG: bool = false
    const DISTANCE: bool = false
    const SIGHT: bool = false
    const REFLECTIONS: bool = false
    const CONTACT: bool = false
}

/// The approved switches (every system the realistic scenes draw), for a measure of what
/// Kinetic Ink's save here: `--set LOOK=styles::physical::Physical --set SWITCHES=Realistic`.
pub struct Realistic {}

impl Switches for Realistic {}

/// The pose sheet (`--set SHEET=true`): no fight; the wanderer and the brawler side by side,
/// each playing its moves in turn (`SLOT` seconds each), seen from `VIEW` (0 three-quarters
/// from the front, on the sun's side; 1 side on; 2 three-quarters from behind), for reviewing
/// the drawing.
pub const SHEET: bool = false
pub const VIEW: u32 = 0
pub const SLOT: f32 = 2.4

/// The capture viewer (`--set MOCAP=n`): no fight; clip `n` (1 the one-two, 2 the guard, 3 the
/// duck, 4 the lunge, 5 the hook, 6 the backward fall, 7 the fall on the face) played on the wanderer,
/// side on, from its frame `MOCAP_FROM` (at 60 a second), for choosing what the duel plays.
pub const MOCAP: u32 = 0
pub const MOCAP_FROM: u32 = 0

/// Whether the test bot plays (`--set AUTO=true`).
pub const AUTO: bool = false

/// How late the server hears an input (ticks): 7, two-thirds of a 200 ms round trip at 60 a
/// second.
pub const LAG: u32 = 7

/// The drawings a second: on twos, and on fours past `FIGHT_FROM` of the moment's height.
pub const DRAWINGS: f32 = 12.0
pub const FIGHT_DRAWINGS: f32 = 6.0
pub const FIGHT_FROM: f32 = 0.55

/// The smear at the moment's height (engine::character::Smear; as the yard's).
pub const SMEAR: f32 = 0.8
pub const STROKES: f32 = 0.55
pub const DISARRAY: f32 = 0.6
pub const SMEAR_FRAMES: f32 = 4.0

/// The impact frames after the riposte's contact, the launch and the landing (frames at 60 a
/// second), and after a posture breaks.
pub const CONTACT_FLASHES: [u32; 5] = [0, 1, 2, 7, 8]
pub const LAUNCH_FLASHES: [u32; 2] = [0, 1]
pub const LAND_FLASHES: [u32; 1] = [0]
pub const BROKE_FLASHES: [u32; 1] = [0]

/// The moment's intensity: at rest; in the brawler's second phase; and what each event adds.
pub const QUIET: f32 = 0.08
pub const PHASE_TWO: f32 = 0.3
pub const ON_EVADE: f32 = 0.22
pub const ON_HIT: f32 = 0.09
pub const ON_DEFLECT: f32 = 0.16
pub const ON_TAKEN: f32 = 0.14
pub const ON_BROKE: f32 = 0.4

const HOW = CreatureLook { surface: Tolerance { tolerance: 3.0e-3 } }

/// A body's drawing: its pose and placing, held until its next.
struct Drawn: Copy {
    bones: [mat4; MAX_BONES],
    root: mat4,
}

/// The keys and buttons held, and what was pressed since the last tick.
struct Held: Copy {
    up: bool = false,
    down: bool = false,
    left: bool = false,
    right: bool = false,
    stick: vec2 = vec2(0.0),
    guard: bool = false,
    press: Press = Press::Nothing,
}

/// The camera: where its eye and its look are, and how fast each is going.
struct Eye: Copy {
    eye: vec3,
    at: vec3,
    ve: vec3 = vec3(0.0),
    va: vec3 = vec3(0.0),
    fovy: f32 = 0.8,
    /// What it's doing (0 the two-shot, 1 the riposte, 2 watching the launch), and which side of
    /// the fight's line it's on (1 or -1).
    mode: u32 = 0,
    side: f32 = 1.0,
    /// The subjects and the fight's width as the camera follows them (smoothed), and the way it
    /// last looked.
    sa: vec3 = vec3(0.0),
    sb: vec3 = vec3(0.0),
    span: f32 = 3.0,
    look: vec3 = vec3(0.0, 0.0, 1.0),
}

/// A change of what a fighter plays (a new act or move), blended over `BLEND` seconds from the
/// pose it was in, so a punch leaves the guard from where the guard was (a crossfade, which the
/// legs' IK and the planted feet keep grounded).
struct Blend: Copy {
    act: Act = Act::Ready,
    move: u32 = 0,
    at: f32 = -1.0e9,
    from: Pose,
    last: Pose,
}

pub const BLEND: f32 = 0.1

/// Pose `p` for a fighter doing `act` (move `move`), blended from where it was if that's new.
fn blended(b: mut Blend, act: Act, move: u32, p: Pose, time: f32) -> Pose {
    if act != b.act || (act == Act::Attack && move != b.move) {
        b.from = b.last
        b.at = time
        b.act = act
        b.move = move
    }
    let u = smoothstep(0.0, BLEND, time - b.at)
    let out = if u < 1.0 { pose::mixed(b.from, p, u) } else { p }
    b.last = out
    out
}

/// The events last drawn (by the tick each came), so a new one is drawn once.
struct Seen: Copy {
    hit_you: u32 = NEVER,
    hit_foe: u32 = NEVER,
    evaded: u32 = NEVER,
    broke: u32 = NEVER,
    deflected: u32 = NEVER,
    blocked: u32 = NEVER,
    contact: u32 = NEVER,
    launch: u32 = NEVER,
    landed: u32 = NEVER,
    act: Act = Act::Ready,
    move: u32 = 0,
}

pub struct State {
    pub frame: Frame<Gathered, SWITCHES, LOOK>,
    pub scene: Arena,
    a: (Skeleton, Bones),
    b: (Skeleton, Bones),
    clips: Clips,
    /// The capture being viewed (`MOCAP`), as poses at 60 a second.
    viewed: Vec<Pose>,
    /// Each body's capsules (read off its parts: `body::capsules`), for contact.
    caps_a: Vec<Capsule>,
    caps_b: Vec<Capsule>,
    /// The client's timeline, and the server's copy: its world, the inputs in flight to it (each
    /// the tick it's for), and how many ticks it has agreed and disagreed with the client.
    timeline: Timeline<World, Intent>,
    server: World,
    flight: Vec<(u32, Intent)>,
    pub agreed: u32,
    pub disagreed: u32,
    bot: Bot,
    held: Held,
    owed: f32,
    last: Option<f32>,
    ca: Carriage,
    cb: Carriage,
    da: Drawn,
    db: Drawn,
    drawn_at: f32,
    drawing: f32,
    since: f32,
    seen: Seen,
    /// Each fighter's change of clip, blended over (`Blend`).
    ba: Blend,
    bb: Blend,
    /// Each body's physics.
    pa: Body,
    pb: Body,
    /// The last blow's impact star: where (the world), when (the frame's time), how big (m).
    star_at: vec3,
    star_time: f32,
    star_size: f32,
    /// The star a deflect's spark (1) or a blow's burst (0).
    star_sharp: f32,
    /// When each fighter died (the frame's time; none yet, below 0).
    dead_a: f32,
    dead_b: f32,
    /// When each event came (the frame's time), for its impact frames.
    contact_at: f32,
    launch_at: f32,
    landed_at: f32,
    broke_at: f32,
    taken_at: f32,
    pub intensity: f32,
    cam: Eye,
}

pub fn init() -> State {
    let air = air_of(SUN)
    let (one, sa, ka) = figure(WANDERER)
    let (other, sb, kb) = figure(BRAWLER)
    // Each body's capsules, a bone each, fitted to its field: what contact is tested against.
    let caps_a = body::capsules(WANDERER)
    let caps_b = body::capsules(BRAWLER)
    said("wanderer", caps_a, ka.chest.index)
    said("brawler", caps_b, kb.chest.index)
    let w = world()
    let start = vec3(0.6, 1.9, -7.4)
    let frame: Frame<Gathered, SWITCHES, LOOK> = Frame::new(
        Quality {},
        sunlight(air),
        air,
        Clipmap::new(levels: 6, finest: 0.25),
        first_camera(start, vec3(0.0, 1.2, 0.0), 0.8, width: 320, height: 180),
        grid(vec2(0.0), cols: 17, spacing: 2.5, low: -4.0, high: 12.0, voxel: 1.0),
        vec2(0.0),
    )
    let you = vec3(w.you.pos.x, 0.0, w.you.pos.y)
    let foe = vec3(w.foe.pos.x, 0.0, w.foe.pos.y)
    let idle = Drawn {
        bones: palette(sa, [rest(); MAX_BONES], placing_matrix(Placing { at: you, heading: 0.0 })),
        root: placing_matrix(Placing { at: you, heading: 0.0 }),
    }
    var scene = arena(
        cast(take one, ByChannels {}, HOW, slices: 16),
        cast(take other, ByChannels {}, HOW, slices: 16),
        parts_of(sa),
    )
    scene.bars = true
    State {
        frame,
        scene,
        a: (sa, ka),
        b: (sb, kb),
        clips: CLIPS.clone(),
        viewed: viewed(),
        caps_a,
        caps_b,
        timeline: Timeline::new(w, history: 64),
        server: w,
        flight: Vec::new(),
        agreed: 0,
        disagreed: 0,
        bot: Bot {},
        held: Held {},
        owed: 0.0,
        last: None,
        ca: carriage(you, w.you.heading, GUARD, WANDERER.tall),
        cb: carriage(foe, w.foe.heading, GUARD, BRAWLER.tall),
        da: idle,
        db: idle,
        drawn_at: -1.0e9,
        drawing: 0.0,
        since: 0.0,
        seen: Seen {},
        ba: Blend { from: GUARD, last: GUARD },
        bb: Blend { from: GUARD, last: GUARD },
        dead_a: -1.0,
        dead_b: -1.0,
        star_at: vec3(0.0),
        star_time: -1.0e9,
        star_size: 0.0,
        star_sharp: 0.0,
        pa: physics::body(sa, ka, WANDERER.tall),
        pb: physics::body(sb, kb, BRAWLER.tall),
        contact_at: -1.0e9,
        launch_at: -1.0e9,
        landed_at: -1.0e9,
        broke_at: -1.0e9,
        taken_at: -1.0e9,
        intensity: QUIET,
        cam: Eye {
            eye: start,
            at: vec3(0.0, 1.2, 0.0),
            sa: you,
            sb: foe,
            look: normalize(vec3(0.0, 1.2, 0.0) - start),
        },
    }
}

/// What the keys, buttons and sticks say this frame: held ones remembered, presses kept for the
/// next tick.
fn listen(h: mut Held) {
    for e in events() {
        match e {
            Event::KeyDown { key, repeat, .. } => {
                if key == Key::W { h.up = true }
                if key == Key::S { h.down = true }
                if key == Key::A { h.left = true }
                if key == Key::D { h.right = true }
                if key == Key::L { h.guard = true }
                if !repeat {
                    if key == Key::Space || key == Key::ShiftLeft { h.press = Press::Dodging }
                    if key == Key::J { h.press = Press::Moves { index: JAB_N } }
                    if key == Key::K { h.press = Press::Moves { index: HOOK_N } }
                }
            },
            Event::KeyUp { key, .. } => {
                if key == Key::W { h.up = false }
                if key == Key::S { h.down = false }
                if key == Key::A { h.left = false }
                if key == Key::D { h.right = false }
                if key == Key::L { h.guard = false }
            },
            Event::PointerDown { button, .. } => {
                if button == Button::Primary { h.press = Press::Moves { index: JAB_N } }
                if button == Button::Secondary { h.press = Press::Moves { index: HOOK_N } }
            },
            Event::PadButton { pad, button, pressed, .. } => {
                if pad == 0 && button == PadButton::LeftShoulder { h.guard = pressed }
                if pad == 0 && pressed {
                    if button == PadButton::East || button == PadButton::South {
                        h.press = Press::Dodging
                    }
                    if button == PadButton::RightShoulder {
                        h.press = Press::Moves { index: JAB_N }
                    }
                    if button == PadButton::RightTrigger {
                        h.press = Press::Moves { index: HOOK_N }
                    }
                }
            },
            Event::PadAxis { pad, axis, value } => {
                if pad == 0 && axis == PadAxis::LeftX { h.stick.x = value }
                if pad == 0 && axis == PadAxis::LeftY { h.stick.y = -value }
            },
            _ => {},
        }
    }
}

/// The wanderer's intent from what's held: its walk turned from the camera's frame (x right, y
/// ahead) into the world's, and its press, which is spent.
fn intent_of(h: mut Held, cam: Eye) -> Intent {
    var v = h.stick
    if length(v) < 0.18 {
        v = vec2(0.0)
    }
    if h.up { v.y += 1.0 }
    if h.down { v.y -= 1.0 }
    if h.right { v.x += 1.0 }
    if h.left { v.x -= 1.0 }
    if length(v) > 1.0 {
        v = normalize(v)
    }
    let ahead = normalize(vec2(cam.at.x - cam.eye.x, cam.at.z - cam.eye.z) + vec2(1.0e-5, 0.0))
    let right = vec2(ahead.y, -ahead.x)
    let i = Intent { walk: right * v.x + ahead * v.y, press: h.press, guard: h.guard }
    h.press = Press::Nothing
    i
}

/// Whether `since` seconds after an event is one of its impact frames (frames at 60 a second).
fn flashing(since: f32, flashes: [u32]) -> bool {
    if since < 0.0 || since > 1.0 {
        return false
    }
    let k = u32(floor(since * 60.0 + 0.01))
    for f in flashes {
        if f == k {
            return true
        }
    }
    false
}

/// The camera's spring toward `goal` (critically damped at `hz`), stepped in pieces short enough
/// to stay stable however stiff it is (a single step goes unstable once `hz` × 2π × `dt` nears 1).
fn sprung(at: mut vec3, v: mut vec3, goal: vec3, dt: f32, hz: f32) {
    let w = 6.2831853 * hz
    let n = max(ceil(w * dt / 0.2), 1.0)
    let h = dt / n
    for _ in 0..u32(n) {
        let a = (goal - at) * (w * w) - v * (2.0 * w)
        v = v + a * h
        at = at + v * h
    }
}

/// One tick: the wanderer's intent (or the bot's), the client's prediction, the input sent to
/// the server, and the server stepping each input that's arrived, checked against the client.
fn tick(s: mut State) {
    let w = s.timeline.world()
    let i = if AUTO { play(mut s.bot, w) } else { intent_of(mut s.held, s.cam) }
    let t = s.timeline.tick()
    s.timeline.advance(i, advance)
    s.flight.push((t + LAG, i))
    // The server: each input whose time has come, stepped at its own tick.
    while s.flight.len() > 0 && s.flight[0].0 <= s.timeline.tick() {
        let (_, input) = s.flight.remove(0)
        advance(mut s.server, input)
        let sv = s.server.tick - 1
        if std::hash::state_hash(s.server) == s.timeline.checksum_at(sv) {
            s.agreed += 1
        } else {
            s.disagreed += 1
        }
    }
    if s.timeline.tick() % 600 == 0 {
        print(
            f"tick {s.timeline.tick()}: the server agrees on {s.agreed} ticks, differs on {s.disagreed}; wanderer {w.you.health}, brawler {w.foe.health}",
        )
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    let dt = match s.last {
        Some(l) => clamp(time - l, 0.0, 0.1),
        None => 0.0,
    }
    s.last = Some(time)
    if SHEET {
        sheet(mut s, time, width, height)
        return
    }
    if MOCAP != 0 {
        view_capture(mut s, time, width, height)
        return
    }
    listen(mut s.held)
    // The sim's ticks owed since the last frame.
    // (Not while the frame is arriving: the fight begins when it can be seen.)
    s.owed = if s.frame.ready.arriving { 0.0 } else { s.owed + dt }
    while s.owed >= 1.0 / HZ - 1.0e-5 {
        s.owed -= 1.0 / HZ
        tick(mut s)
    }
    let w = s.timeline.world()
    // ---- The events, drawn once each.
    var forced = false
    if w.you.act != s.seen.act || (w.you.act == Act::Attack && w.you.move != s.seen.move) {
        forced = true
    }
    if w.you.act == Act::Attack && w.you.t == 0 {
        forced = true
    }
    s.seen.act = w.you.act
    s.seen.move = w.you.move
    var bump = 0.0
    if w.hit_you != s.seen.hit_you {
        s.seen.hit_you = w.hit_you
        let from = vec3(w.foe.pos.x - w.you.pos.x, 0.0, w.foe.pos.y - w.you.pos.y)
        flinch(mut s.ca, from, w.you.heading, 1.0)
        let head = s.pa.at[s.a.1.head.index]
        physics::struck(
            mut s.pa,
            head,
            normalize(vec3(-from.x, 0.4, -from.z) + vec3(1.0e-4)) * 3.2,
            0.35,
            1.0 / 60.0,
        )
        s.taken_at = time
        bump += ON_TAKEN
        forced = true
    }
    if w.hit_foe != s.seen.hit_foe {
        s.seen.hit_foe = w.hit_foe
        let from = vec3(w.you.pos.x - w.foe.pos.x, 0.0, w.you.pos.y - w.foe.pos.y)
        flinch(mut s.cb, from, w.foe.heading, 0.45)
        let heavy = w.you.move == HOOK_N
        let at = if heavy { s.pb.at[s.b.1.chest.index] } else { s.pb.at[s.b.1.head.index] }
        s.star_at = at
        s.star_time = time
        s.star_size = if heavy { 0.6 } else { 0.4 }
        s.star_sharp = 0.0
        physics::struck(
            mut s.pb,
            at,
            normalize(vec3(-from.x, 0.25, -from.z) + vec3(1.0e-4)) * if heavy { 2.6 } else { 1.8 },
            if heavy { 0.4 } else { 0.25 },
            1.0 / 60.0,
        )
        bump += ON_HIT
        forced = true
    }
    if w.evaded != s.seen.evaded {
        s.seen.evaded = w.evaded
        bump += ON_EVADE
        forced = true
    }
    if w.deflected != s.seen.deflected || w.blocked != s.seen.blocked {
        // A blow met on the guard: the ink's spark where the forearms took it; deflected, the
        // brawler's arm thrown back off it and its chest after; blocked, the wanderer's guard
        // driven in.
        let deflect = w.deflected != s.seen.deflected
        s.seen.deflected = w.deflected
        s.seen.blocked = w.blocked
        let guard = (s.pa.at[s.a.1.wrist_r.index] + s.pa.at[s.a.1.wrist_l.index]) * 0.5
        s.star_at = guard
        s.star_time = time
        s.star_size = if deflect { 0.7 } else { 0.3 }
        s.star_sharp = if deflect { 1.0 } else { 0.0 }
        let back = normalize(
            vec3(w.foe.pos.x - w.you.pos.x, 0.0, w.foe.pos.y - w.you.pos.y) + vec3(1.0e-4),
        )
        if deflect {
            for i in [s.b.1.wrist_r.index, s.b.1.wrist_l.index] {
                physics::struck(
                    mut s.pb,
                    s.pb.at[i],
                    (back + vec3(0.0, 0.5, 0.0)) * 2.4,
                    0.3,
                    1.0 / 60.0,
                )
            }
            physics::struck(mut s.pb, s.pb.at[s.b.1.chest.index], back * 1.2, 0.25, 1.0 / 60.0)
            bump += ON_DEFLECT
        } else {
            physics::struck(mut s.pa, guard, -back * 1.6, 0.25, 1.0 / 60.0)
            bump += ON_HIT
        }
        forced = true
    }
    if w.broke != s.seen.broke {
        s.seen.broke = w.broke
        s.broke_at = time
        bump += ON_BROKE
        forced = true
    }
    if w.contact != s.seen.contact {
        s.seen.contact = w.contact
        s.contact_at = time
        // The uppercut's blow: the head driven up and back.
        let head = s.pb.at[s.b.1.head.index]
        s.star_at = head
        s.star_time = time
        s.star_size = 1.3
        s.star_sharp = 0.0
        let back = vec3(w.foe.pos.x - w.you.pos.x, 0.0, w.foe.pos.y - w.you.pos.y)
        physics::struck(
            mut s.pb,
            head,
            vec3(0.0, 4.5, 0.0) + normalize(back + vec3(1.0e-4)) * 1.5,
            0.5,
            1.0 / 60.0,
        )
        forced = true
    }
    if w.launch != s.seen.launch {
        s.seen.launch = w.launch
        if w.launch != NEVER {
            s.launch_at = time
        }
        forced = true
    }
    if w.landed != s.seen.landed {
        s.seen.landed = w.landed
        if w.landed != NEVER {
            s.landed_at = time
            s.scene.ground.crater = w.crater
            s.frame.changed(Change::Ground)
            let g = s.scene.ground.height(w.foe.pos.x, w.foe.pos.y)
            for k in 0..4 {
                let a = f32(k) * 1.5707964 + 0.4
                s.scene.dust.push(
                    vec3(w.foe.pos.x + sin(a) * 1.4, g + 0.3, w.foe.pos.y + cos(a) * 1.4),
                )
            }
        }
        forced = true
    }
    // ---- The moment: raised by what happens, held a while, falling back to its rest.
    let riposting = w.you.act == Act::Riposte || (w.launch != NEVER && w.landed == NEVER)
    let floor = if second(w) { PHASE_TWO } else { QUIET }
    if riposting {
        s.intensity = mix(s.intensity, 1.0, 1.0 - exp(-dt * 10.0))
    } else {
        s.intensity = min(s.intensity + bump, 1.0)
        let held_for = time - max(max(s.broke_at, s.taken_at), s.landed_at)
        if held_for > 1.0 {
            s.intensity = max(floor, s.intensity - dt * 0.18)
        }
        s.intensity = max(s.intensity, floor)
    }
    // ---- The bodies.
    let (sa, ka) = s.a
    let (sb, kb) = s.b
    let ground = s.scene.ground
    let ga = ground.height(w.you.pos.x, w.you.pos.y)
    let gb = ground.height(w.foe.pos.x, w.foe.pos.y)
    if w.you.act == Act::Dead && s.dead_a < 0.0 {
        s.dead_a = time
    }
    if w.foe.act == Act::Dead && s.dead_b < 0.0 {
        s.dead_b = time
    }
    let (pa, la) = wanderer(w, s.clips, ga, time, time - s.dead_a)
    let (pb, lb) = brawler(w, s.clips, gb, time, time - s.dead_b)
    let pa = blended(mut s.ba, w.you.act, w.you.move, pa, time)
    let pb = blended(mut s.bb, w.foe.act, w.foe.move, pb, time)
    let ra = carry(mut s.ca, la.at, la.heading, pa, dt, WANDERER.tall, ground)
    let rb = carry(mut s.cb, lb.at, lb.heading, pb, dt, BRAWLER.tall, ground)
    // A body turned over (flung, lying) takes its pose's own feet, not the ground's.
    let fa = if la.over == 0.0 { ra.feet } else { pose::feet_of(ra.pose, WANDERER.tall) }
    let fb = if lb.over == 0.0 { rb.feet } else { pose::feet_of(rb.pose, BRAWLER.tall) }
    let ma = placing_matrix(la)
    let mb = placing_matrix(lb)
    // Contact: each fist kept on the other's surface, not in it (the other's capsules, fitted to
    // its field, posed as it's drawn); and the riposte's fist put on the brawler's jaw.
    let bare_a = palette(sa, locals(ra.pose, fa, sa, ka, WANDERER.tall), ma)
    let bare_b = palette(sb, locals(rb.pose, fb, sb, kb, BRAWLER.tall), mb)
    var qa = ra.pose
    var qb = rb.pose
    // (Only a fist that's striking: pushing a resting guard out of the other body would fling the
    // arm wherever the nearest way out is.)
    if la.over == 0.0 && lb.over == 0.0 {
        if striking(w.you, WANDERER_MOVES) {
            qa = touching(qa, fa, sa, ka, WANDERER.tall, ma, s.caps_b, bare_b)
        }
        if striking(w.foe, BRAWLER_MOVES) {
            qb = touching(qb, fb, sb, kb, BRAWLER.tall, mb, s.caps_a, bare_a)
        }
    }
    if w.you.act == Act::Riposte {
        // The fist onto the jaw as it arrives, held through the impact frames, then let go to
        // drive on up as the head snaps back (`present::SNAP_AFTER`).
        let t = f32(w.you.t)
        let after = if w.contact == NEVER { 0.0 } else { f32(w.tick - w.contact) }
        let u = smoothstep(f32(CONTACT) - 6.0, f32(CONTACT), t) *
            (1.0 - smoothstep(f32(present::SNAP_AFTER), f32(present::SNAP_AFTER) + 4.0, after))
        if u > 0.0 {
            let head = bare_b[kb.head.index] *
                vec4(sb.rest(kb.head) + vec3(0.0, 0.01, 0.09) * BRAWLER.tall, 1.0)
            let to = (rigid_inverse(ma) * head).xyz
            qa = pose::reached(qa, fa, sa, ka, WANDERER.tall, right: true, to: to, w: u)
        }
    }
    // ---- Physics (`physics`): each body's particles pulled toward its animation, colliding
    // with the ground and the other body; slack (a ragdoll) once laid out or felled.
    let anim_a = palette(sa, locals(qa, fa, sa, ka, WANDERER.tall), ma)
    let anim_b = palette(sb, locals(qb, fb, sb, kb, BRAWLER.tall), mb)
    let ta = physics::points(anim_a, sa, ka, WANDERER.tall)
    let tb = physics::points(anim_b, sb, kb, BRAWLER.tall)
    s.pa.aim = if w.you.act == Act::Dead { 0.3 } else { 1.0 }
    let laid = w.landed != NEVER && (w.foe.act == Act::Dead || w.tick - w.landed < LIES)
    s.pb.aim = if laid { 0.0 } else if w.foe.act == Act::Dead { 0.3 } else { 1.0 }
    physics::step(mut s.pa, ta, dt, ground, s.caps_b, anim_b)
    physics::step(mut s.pb, tb, dt, ground, s.caps_a, anim_a)
    let set_a = physics::settled(anim_a, s.pa, ta, sa, ka)
    let set_b = physics::settled(anim_b, s.pb, tb, sb, kb)
    let rate = if s.intensity >= FIGHT_FROM { FIGHT_DRAWINGS } else { DRAWINGS }
    if forced || time - s.drawn_at >= 1.0 / rate - 1.0e-4 {
        // The smear reaches back to the drawing before, carried to where each body is now:
        // limbs' motion, not the body's travel.
        let carry_a = ma * rigid_inverse(s.da.root)
        let carry_b = mb * rigid_inverse(s.db.root)
        var from_a = s.da.bones
        var from_b = s.db.bones
        for i in 0..MAX_BONES {
            from_a[i] = carry_a * from_a[i]
            from_b[i] = carry_b * from_b[i]
        }
        s.scene.wanderer.new_drawing_from(from_a)
        s.scene.brawler.new_drawing_from(from_b)
        s.da = Drawn { bones: set_a, root: ma }
        s.db = Drawn { bones: set_b, root: mb }
        s.drawn_at = time
        s.drawing += 1.0
        s.since = 0.0
    } else {
        s.since += 1.0
    }
    s.scene.wanderer.pose(s.da.bones, shadowed: true, moved: false)
    s.scene.brawler.pose(s.db.bones, shadowed: true, moved: false)
    if s.scene.wanderer.realizing() {
        s.scene.wanderer.realize()
    }
    if s.scene.brawler.realizing() {
        s.scene.brawler.realize()
    }
    let impact = flashing(time - s.contact_at, CONTACT_FLASHES) ||
        flashing(time - s.launch_at, LAUNCH_FLASHES) ||
        flashing(time - s.landed_at, LAND_FLASHES) ||
        flashing(time - s.broke_at, BROKE_FLASHES)
    s.frame.impact = if impact { 1.0 } else { 0.0 }
    // The smear; none on an impact frame, whose stark silhouettes must read clean.
    let held = if s.since < SMEAR_FRAMES && !impact { 1.0 } else { 0.0 }
    let strength = smoothstep(0.3, 0.8, s.intensity) * if impact { 0.0 } else { 1.0 }
    let steady_a = (1 << ka.head.index) | (1 << ka.neck.index)
    let steady_b = (1 << kb.head.index) | (1 << kb.neck.index)
    s.scene.wanderer.smear_by(
        Smear {
            amount: SMEAR * strength * held,
            strokes: STROKES * strength * held,
            disarray: DISARRAY * strength,
            steady: steady_a,
        },
    )
    s.scene.brawler.smear_by(
        Smear {
            amount: SMEAR * strength * held,
            strokes: STROKES * strength * held,
            disarray: DISARRAY * strength,
            steady: steady_b,
        },
    )
    // ---- The camera (`camera`).
    let you = vec3(w.you.pos.x, ga, w.you.pos.y)
    let foe = vec3(w.foe.pos.x, gb + w.air, w.foe.pos.y)
    let aim = camera(mut s, w, you, foe, dt, time, f32(width) / max(f32(height), 1.0))
    // ---- The bars.
    let taken = exp(-(time - s.taken_at) * 4.0)
    // The ink effects: the last blow's star where it landed, on screen; speed lines behind the
    // launched brawler.
    let size = vec2(f32(width), f32(height))
    let (star_px, star_depth) = on_screen(aim, s.star_at, size)
    let star_age = (time - s.star_time) / 0.22
    let star_r = s.star_size / max(star_depth, 0.5) / tan(aim.fovy * 0.5) * size.y * 0.5
    let flying = w.launch != NEVER && w.landed == NEVER
    let (foe_px, _) = on_screen(aim, foe + vec3(0.0, 1.0, 0.0), size)
    let (ahead_px, _) = on_screen(
        aim,
        foe + vec3(0.0, 1.0, 0.0) + vec3(w.way.x, 2.0, w.way.y) * 0.3,
        size,
    )
    let way_px = ahead_px - foe_px
    s.scene.hud = Hud {
        out: vec2(f32(width), f32(height)),
        star: vec4(star_px, star_r, if star_depth > 0.0 { star_age } else { 2.0 }),
        star_sharp: s.star_sharp,
        star_seed: if s.star_time < 0.0 { 0.0 } else { f32(u32(s.star_time * 60.0) % 997) },
        speed: vec4(foe_px, if flying { 1.0 - smoothstep(0.6, 1.4, time - s.launch_at) } else {
            0.0
        }, 0.0),
        speed_way: if length(way_px) > 1.0e-3 { normalize(way_px) } else { vec2(0.0, -1.0) },
        you: vec4(
            w.you.health / duel::YOU.health,
            w.you.stamina / duel::YOU.stamina,
            s.scene.hud.you.z,
            taken,
        ),
        foe: vec4(
            w.foe.health / duel::FOE.health,
            w.foe.posture / duel::FOE.posture,
            s.scene.hud.foe.z,
            0.0,
        ),
    }
    // What was just lost shows pale, catching up.
    s.scene.hud.you.z = max(s.scene.hud.you.x, s.scene.hud.you.z - dt * 0.35)
    s.scene.hud.foe.z = max(s.scene.hud.foe.x, s.scene.hud.foe.z - dt * 0.35)
    s.frame.intensity = s.intensity
    s.frame.drawing = s.drawing
    s.frame.look.line_px = 1.7 + 1.4 * s.intensity
    let _ = s.frame.begin(mut s.scene, aim, time, width, height)
    s.frame.draw(mut s.scene, aim)
    let _ = CONTACT
}

/// The pose sheet's frame: each fighter playing its moves in turn, from the start once the frame
/// has arrived.
fn sheet(s: mut State, time: f32, width: u32, height: u32) {
    if s.frame.ready.arriving {
        s.owed = time
    }
    let t = max(time - s.owed, 0.0)
    let slot = u32(floor(t / SLOT))
    let u = t - f32(slot) * SLOT
    borrow c = s.clips
    // The wanderer's: guard, jab, cross, hook, dodge, riposte, the fall; the brawler's: guard,
    // one, two, haymaker, lunge, sweep, broken.
    let n = slot % 7
    let pa = present::sheet_pose(0, n, u, c, time)
    let pb = present::sheet_pose(1, n, u, c, time)
    let (sa, ka) = s.a
    let (sb, kb) = s.b
    let la = Placing { at: vec3(0.9, 0.0, 0.0), heading: 3.1415927 + 0.5 }
    let lb = Placing { at: vec3(-1.0, 0.0, 0.0), heading: 3.1415927 - 0.5 }
    let da = locals(pa, pose::feet_of(pa, WANDERER.tall), sa, ka, WANDERER.tall)
    let db = locals(pb, pose::feet_of(pb, BRAWLER.tall), sb, kb, BRAWLER.tall)
    s.scene.wanderer.pose(palette(sa, da, placing_matrix(la)), shadowed: true, moved: false)
    s.scene.brawler.pose(palette(sb, db, placing_matrix(lb)), shadowed: true, moved: false)
    if s.scene.wanderer.realizing() {
        s.scene.wanderer.realize()
    }
    if s.scene.brawler.realizing() {
        s.scene.brawler.realize()
    }
    s.scene.bars = false
    let eye = if VIEW == 0 { vec3(0.6, 1.25, 5.2) } else if VIEW == 1 {
        vec3(5.4, 1.25, 0.3)
    } else {
        vec3(-2.0, 1.4, -4.8)
    }
    let aim = Aim { eye, at: vec3(0.05, 0.95, 0.0), fovy: 0.62, moving_at: vec3(0.0, 1.0, 0.0) }
    s.frame.intensity = 0.08
    s.frame.look.line_px = 1.9
    let _ = s.frame.begin(mut s.scene, aim, time, width, height)
    s.frame.draw(mut s.scene, aim)
}

/// Whether fighter `f`'s fist is out: a move from just before its hitting ticks to a little
/// after.
fn striking(f: Fighter, moves: [Move]) -> bool {
    if f.act != Act::Attack {
        return false
    }
    let m = moves[f.move]
    f.t + 4 >= m.windup && f.t < m.windup + m.active + 10
}

/// Every clip (the captures parsed and retargeted): computed when the program is built, not when
/// it starts.
const CLIPS: Clips = clips()

/// Where world point `p` falls on a screen of `size` pixels seen through `aim` (pixels from the
/// top left), and how far ahead of the eye it is (behind it, below 0).
fn on_screen(aim: Aim, p: vec3, size: vec2) -> (vec2, f32) {
    let f = normalize(aim.at - aim.eye)
    let r = normalize(cross(f, vec3(0.0, 1.0, 0.0)))
    let u = cross(r, f)
    let d = p - aim.eye
    let z = dot(d, f)
    let t = tan(aim.fovy * 0.5)
    let x = dot(d, r) / max(z, 1.0e-3) / (t * size.x / size.y)
    let y = dot(d, u) / max(z, 1.0e-3) / t
    (vec2((x + 1.0) * 0.5 * size.x, (1.0 - y) * 0.5 * size.y), z)
}

/// Prints a body's chest capsule (`BODIES` in `duel` is set from it).
fn said(name: str, caps: [Capsule], chest: u32) {
    for c in caps {
        if c.bone.index == chest {
            print(f"the {name}'s chest capsule: radius {c.radius:.3} m, from {c.a} to {c.b}")
        }
    }
}

/// Pose `p` (its feet `feet`, its root `m`) with each fist kept on the surface of the other body
/// (its capsules `caps`, posed by `other`) rather than in it: the arm bent to put the fist where it
/// would just touch, twice over, so one capsule's push doesn't leave it in the next.
fn touching(
    p: Pose,
    feet: Feet,
    s: Skeleton,
    k: Bones,
    tall: f32,
    m: mat4,
    caps: [Capsule],
    other: [mat4; MAX_BONES],
) -> Pose {
    var out = p
    let inv = rigid_inverse(m)
    let r = pose::FIST_R * tall
    for right in [true, false] {
        for _ in 0..2 {
            let a = pose::arm(out, feet, s, k, tall, right)
            let fist = (m * vec4(a.fist, 1.0)).xyz
            var deepest = 0.0
            var to = fist
            for c in caps {
                let pa = (other[c.bone.index] * vec4(c.a, 1.0)).xyz
                let pb = (other[c.bone.index] * vec4(c.b, 1.0)).xyz
                let ab = pb - pa
                let u = clamp(dot(fist - pa, ab) / max(dot(ab, ab), 1.0e-8), 0.0, 1.0)
                let q = pa + ab * u
                let d = fist - q
                let n = length(d)
                let pen = c.radius + r - n
                if pen > deepest && n > 1.0e-4 {
                    deepest = pen
                    to = q + d / n * (c.radius + r)
                }
            }
            if deepest > 0.0 {
                out = pose::reached(
                    out,
                    feet,
                    s,
                    k,
                    tall,
                    right,
                    to: (inv * vec4(to, 1.0)).xyz,
                    w: 1.0,
                )
            }
        }
    }
    out
}

/// The fastest the camera's look turns (radians a second).
pub const TURN_RATE: f32 = 4.0

/// Where a camera can stand so two points `a` and `b` land at screen points `pa` and `pb` (each
/// -1 to 1 across and up), for a vertical field of view `fovy` and an `aspect`: Lino and Christie's
/// toric space (SIGGRAPH 2015, "Intuitive and Efficient Camera Control with the Toric Space"). The
/// two rays to the screen points make an angle α, and every camera seeing `a` and `b` that far apart
/// sits on a spindle torus round the line between them (the inscribed angle). On it: `dist` from
/// `a` (the arc's angle at `a` that gives it, kept short of the line beyond `a`, where the two would
/// overlap), `phi` up from level round the line, on the line's side `side`. Its eye, and a point it
/// looks at that puts `a` and `b` where they're asked.
fn toric(
    a: vec3,
    b: vec3,
    pa: vec2,
    pb: vec2,
    fovy: f32,
    aspect: f32,
    dist: f32,
    phi: f32,
    side: f32,
) -> (vec3, vec3) {
    let t = tan(fovy * 0.5)
    let ra = normalize(vec3(pa.x * t * aspect, pa.y * t, 1.0))
    let rb = normalize(vec3(pb.x * t * aspect, pb.y * t, 1.0))
    let alpha = acos(clamp(dot(ra, rb), -1.0, 1.0))
    let ab = b - a
    let d = max(length(ab), 1.0e-3)
    let u = ab / d
    let up = vec3(0.0, 1.0, 0.0)
    let level = normalize(up - u * dot(u, up) + vec3(0.0, 1.0e-4, 0.0))
    let across = cross(u, level) * side
    let w = across * cos(phi) + level * sin(phi)
    let k = min(dist * sin(alpha) / d, 1.0)
    let beta = min(3.1415927 - asin(k) - alpha, (3.1415927 - alpha) * 0.96)
    let ac = d * sin(alpha + beta) / sin(alpha)
    let eye = a + (u * cos(beta) + w * sin(beta)) * ac
    // The turn taking the camera's two rays onto the world's two directions to `a` and `b`.
    let da = normalize(a - eye)
    let db = normalize(b - eye)
    let e2 = normalize(rb - ra * dot(ra, rb))
    let g2 = normalize(db - da * dot(da, db))
    let e3 = cross(ra, e2)
    let g3 = cross(da, g2)
    // The camera's ahead (0, 0, 1) in the rays' frame, then in the world's.
    let ahead = vec3(ra.z, e2.z, e3.z)
    let look = da * ahead.x + g2 * ahead.y + g3 * ahead.z
    (eye, eye + look)
}

/// The camera this frame. Fighting: toric two-subject framing (`toric`): both fighters always in
/// frame and apart on screen, the wanderer to one side and the brawler to the other, the camera as
/// far back as the fight is wide; it keeps to its side of the fight's line, never swinging across
/// it, and never loses a fighter (its safe area) nor whips (its turn rate). The riposte: a cut to a low angle beside the two, looking up at where the fist will meet
/// the jaw, pushing in through the coil. The launch: a cut to low behind the striker, set by the
/// launch's line, holding its follow-through and the brawler flying, until it's been down a moment; then back to the two-shot, eased. A hit-stop shakes it and
/// punches its field of view in.
fn camera(s: mut State, w: World, you: vec3, foe: vec3, dt: f32, time: f32, aspect: f32) -> Aim {
    let up = vec3(0.0, 1.0, 0.0)
    let d = vec2(foe.x - you.x, foe.z - you.z)
    let n = length(d)
    let along = if n > 0.3 { d / n } else { vec2(sin(w.you.heading), cos(w.you.heading)) }
    let ahead = vec3(along.x, 0.0, along.y)
    let right = vec3(along.y, 0.0, -along.x)
    let riposte = w.you.act == Act::Riposte && w.launch == NEVER
    let flying = w.launch != NEVER && (w.landed == NEVER || w.tick - w.landed < 50)
    let mode: u32 = if riposte { 1 } else if flying { 2 } else { 0 }
    let side = right * s.cam.side
    let ground_foe = vec3(foe.x, you.y, foe.z)
    var goal_eye = you
    var goal_at = you
    var fovy = 0.78
    var hz = 2.2
    if mode == 0 {
        // Toric framing (`toric`): the wanderer's chest a third in from one side of the frame, the
        // brawler's a quarter in from the other and a little higher (both clear of the bars below); the camera on its side of the
        // fight's line, as far from the wanderer as the fight is wide.
        // The subjects smoothed, and the fight's width damped, so a dash or a knock-back doesn't
        // jerk the shot.
        s.cam.sa = mix(s.cam.sa, you, vec3(1.0 - exp(-dt * 8.0)))
        s.cam.sb = mix(s.cam.sb, ground_foe, vec3(1.0 - exp(-dt * 8.0)))
        s.cam.span = mix(s.cam.span, length(ground_foe - you), 1.0 - exp(-dt * 2.5))
        let a = s.cam.sa + up * 1.3
        let b = s.cam.sb + up * 1.45
        let sd = s.cam.side
        let (eye, look) = toric(
            a,
            b,
            vec2(0.34 * sd, 0.02),
            vec2(-0.26 * sd, 0.14),
            fovy,
            aspect,
            clamp(2.0 + 0.45 * s.cam.span, 2.5, 4.6),
            0.14,
            sd,
        )
        goal_eye = eye
        goal_at = look
    } else if mode == 1 {
        let mid = mix(you, ground_foe, vec3(0.5))
        let t = f32(w.you.t)
        goal_eye = mid + side * 2.3 - ahead * 0.35 + up * 0.4
        goal_at = mid + up * mix(1.15, 1.6, smoothstep(f32(CONTACT) - 10.0, f32(CONTACT), t))
        fovy = mix(0.74, 0.58, smoothstep(f32(COILED), f32(CONTACT), t))
        hz = 6.0
    } else {
        // Low behind the striker, set by the launch's own line (so it holds still while the body
        // flies), looking up past the striker's follow-through at the body it flung.
        let way = vec3(w.way.x, 0.0, w.way.y)
        let across = vec3(w.way.y, 0.0, -w.way.x) * s.cam.side
        let from = vec3(w.from.x, you.y, w.from.y)
        goal_eye = from - way * 3.4 + across * 1.8 + up * 0.7
        goal_at = mix(you + up * 1.4, foe + up * 0.8, vec3(0.6))
        fovy = 1.1
        hz = 3.0
    }
    if mode != s.cam.mode && mode != 0 {
        // A cut, as an animator cuts to the shot.
        s.cam.eye = goal_eye
        s.cam.at = goal_at
        s.cam.ve = vec3(0.0)
        s.cam.va = vec3(0.0)
        s.cam.fovy = fovy
    }
    s.cam.mode = mode
    sprung(mut s.cam.eye, mut s.cam.ve, goal_eye, dt, hz)
    sprung(mut s.cam.at, mut s.cam.va, goal_at, dt, hz * 1.6)
    s.cam.fovy = mix(s.cam.fovy, fovy, 1.0 - exp(-dt * 6.0))
    // The look's turn, at most `TURN_RATE` a second: no whip.
    let was = normalize(s.cam.look)
    let now = normalize(s.cam.at - s.cam.eye)
    let angle = acos(clamp(dot(was, now), -1.0, 1.0))
    let most = TURN_RATE * dt
    if angle > most && angle > 1.0e-4 {
        let k = most / angle
        let turned = normalize(mix(was, now, vec3(k)))
        s.cam.at = s.cam.eye + turned * length(s.cam.at - s.cam.eye)
    }
    s.cam.look = normalize(s.cam.at - s.cam.eye)
    var eye = s.cam.eye
    var fov = s.cam.fovy
    var look_at = s.cam.at
    // The safe area: both fighters' chests and heads inside the frame's middle four fifths, else
    // this frame's eye backs away from what it looks at until they are (a hard constraint for the
    // frame drawn, not stored: a spring that lags a dash must never lose a fighter, and pushing
    // the camera itself back would pile up frame on frame).
    if mode == 0 {
        for _ in 0..8 {
            let probe = Aim { eye, at: look_at, fovy: fov, moving_at: look_at }
            var worst = 0.0
            for p in [
                you + up * 1.2,
                you + up * 1.85,
                ground_foe + up * 1.3,
                ground_foe + up * 2.05,
            ] {
                let (px, z) = on_screen(probe, p, vec2(aspect, 1.0))
                let ndc = vec2(px.x / aspect * 2.0 - 1.0, 1.0 - px.y * 2.0)
                worst = max(worst, if z <= 0.2 { 2.0 } else { max(abs(ndc.x), abs(ndc.y) * 1.1) })
            }
            if worst <= 0.84 {
                break
            }
            // Back away, and turn toward the pair.
            look_at = mix(look_at, mix(you, ground_foe, vec3(0.5)) + up * 1.3, vec3(0.25))
            eye = eye + (eye - look_at) * 0.07
        }
    }
    if w.stop > 0 {
        let k = i32(time * 60.0)
        let shake = vec3(hash2(k, 3) - 0.5, hash2(k, 7) - 0.5, hash2(k, 11) - 0.5) *
            (0.03 + 0.06 * s.intensity)
        eye = eye + shake
        fov = fov * 0.93
    }
    Aim { eye, at: look_at, fovy: fov, moving_at: mix(you, foe, vec3(0.5)) }
}

/// The capture `MOCAP` names, as poses, from `MOCAP_FROM` (none when it names none).
fn viewed() -> Vec<Pose> {
    if MOCAP == 0 {
        return Vec::new()
    }
    let c = if MOCAP == 1 {
        retarget::capture(mocap::cmu::BOXER, mocap::cmu::JAB_CROSS, hz: 60.0, every: 1)
    } else if MOCAP == 2 {
        retarget::capture(mocap::cmu::BOXER, mocap::cmu::GUARD, hz: 60.0, every: 1)
    } else if MOCAP == 3 {
        retarget::capture(mocap::cmu::BOXER, mocap::cmu::DUCK, hz: 60.0, every: 1)
    } else if MOCAP == 4 {
        retarget::capture(mocap::cmu::BOXER, mocap::cmu::LUNGE, hz: 60.0, every: 1)
    } else if MOCAP == 5 {
        retarget::capture(mocap::cmu::HOOKER, mocap::cmu::HOOK, hz: 60.0, every: 1)
    } else if MOCAP == 6 {
        retarget::capture(mocap::cmu::FALLER, mocap::cmu::FALL_BACK, hz: 60.0, every: 1)
    } else { retarget::capture(mocap::cmu::FALLER, mocap::cmu::FALL_FACE, hz: 60.0, every: 1) }
    print(
        f"capture {MOCAP}: {c.frames.len()} frames at {c.rate} a second, scale {c.scale:.3}, floor {c.floor:.2}",
    )
    retarget::poses_of(c, MOCAP_FROM, c.frames.len())
}

/// The capture viewer's frame: the capture played on the wanderer from when the frame has
/// arrived, side on; the brawler beside it in its guard.
fn view_capture(s: mut State, time: f32, width: u32, height: u32) {
    if s.frame.ready.arriving {
        s.owed = time
    }
    let t = max(time - s.owed, 0.0)
    let p = retarget::played(s.viewed, 60.0, t)
    let (sa, ka) = s.a
    let (sb, kb) = s.b
    let la = Placing { at: vec3(0.0, 0.0, 0.0), heading: 3.1415927 * 0.5 }
    let lb = Placing { at: vec3(0.0, 0.0, 2.2), heading: -3.1415927 * 0.5 }
    let da = locals(p, pose::feet_of(p, WANDERER.tall), sa, ka, WANDERER.tall)
    let db = locals(GUARD, pose::feet_of(GUARD, BRAWLER.tall), sb, kb, BRAWLER.tall)
    s.scene.wanderer.pose(palette(sa, da, placing_matrix(la)), shadowed: true, moved: false)
    s.scene.brawler.pose(palette(sb, db, placing_matrix(lb)), shadowed: true, moved: false)
    if s.scene.wanderer.realizing() {
        s.scene.wanderer.realize()
    }
    if s.scene.brawler.realizing() {
        s.scene.brawler.realize()
    }
    s.scene.bars = false
    let aim = Aim {
        eye: vec3(-4.6, 1.2, 1.0),
        at: vec3(0.0, 1.0, 1.0),
        fovy: 0.62,
        moving_at: vec3(0.0, 1.0, 0.0),
    }
    s.frame.intensity = 0.08
    s.frame.look.line_px = 1.9
    let _ = s.frame.begin(mut s.scene, aim, time, width, height)
    s.frame.draw(mut s.scene, aim)
}
