/// The riposte's ticks: the coil reached, held dead still until the snap, the fist's contact
/// (the hit-stop begins), the follow-through's height, and the end, back on guard.
pub const COILED: u32 = 22
pub const STILL: u32 = 34
pub const CONTACT: u32 = 40
pub const OVER: u32 = 50
pub const RIPOSTE: u32 = 120

/// A beat `ticks` in (at 60 a second).
fn at(ticks: f32, pose: pose::Pose, ease: u32) -> Beat {
    Beat { at: ticks / 60.0, pose, ease }
}

/// A key on `phase`, `u` of the way through it: `pose`'s `parts` (absolute), held `hold` ticks,
/// eased on as `ease` says.
fn key(phase: Phase, u: f32, pose: Pose, parts: u32, hold: f32, ease: u32) -> Key {
    Key { phase, u, pose, parts, hold, ease }
}

/// A key as an offset from the guide (`pose` built on `pose::NONE`).
fn by(phase: Phase, u: f32, pose: Pose, parts: u32, hold: f32, ease: u32) -> Key {
    Key { phase, u, pose, parts, offset: true, hold, ease }
}

// The keys' poses: each past anything the performer did, as an anime key is (the line of action
// one long curve, the striking side all the way round), on the captured guard's body.

/// The jab's hit: the lead arm thrown long, the body leaning in behind it, the lead shoulder up
/// by the chin.
const JAB_HIT = Pose {
    lift: vec3(0.0, -0.11, 0.12),
    chest: vec3(0.2, 0.14, 0.0),
    upper_l: vec3(0.1, 0.1, 1.0),
    fore_l: vec3(0.1, 0.08, 1.0),
    reach: vec2(1.0, 1.14),
    shrug: vec2(0.1, 0.3),
    ..JAB,
}

/// The cross cocked: the rear elbow drawn straight back and tight, the fist by the ear, the lead
/// fist tucked at the chin, the hips and chest wound away so the rear shoulder is behind. (Its
/// elbow out wide, both arms spread read as a grab.)
const CROSS_COCK = Pose {
    lift: vec3(0.0, -0.12, -0.08),
    hips: vec3(0.04, 0.85, 0.0),
    chest: vec3(0.0, 0.5, 0.0),
    head: vec3(-0.12, -0.55, 0.0),
    upper_r: vec3(0.28, -0.55, -0.79),
    fore_r: vec3(0.0, 0.78, 0.63),
    upper_l: vec3(-0.15, -0.65, 0.72),
    fore_l: vec3(0.45, 0.85, 0.2),
    shrug: vec2(0.3, 0.1),
    ..CROSS_LOAD,
}

/// The cross's hit: driven right through, the hips past square, the body leaning long behind the
/// arm.
const CROSS_HIT = Pose {
    lift: vec3(0.0, -0.12, 0.18),
    hips: vec3(0.08, -0.6, 0.0),
    chest: vec3(0.12, -0.45, 0.0),
    head: vec3(-0.12, 0.45, 0.0),
    reach: vec2(1.16, 1.0),
    ..CROSS,
}

/// The hook's coil: sunk deep, wound right round so the back half faces the foe, the rear arm
/// cocked behind, the eyes still on the target.
const HOOK_COIL = Pose {
    lift: vec3(0.0, -0.27, -0.03),
    hips: vec3(0.15, 1.05, 0.0),
    chest: vec3(0.24, 0.45, 0.12),
    head: vec3(-0.12, -1.0, 0.0),
    upper_r: vec3(0.8, -0.2, -0.56),
    fore_r: vec3(0.0, 0.5, 0.86),
    ..HOOK_LOAD,
}

/// The hook's hit: unwound past square, the body thrown over the lead leg behind the swing.
const HOOK_HIT = Pose {
    lift: vec3(0.0, -0.18, 0.16),
    hips: vec3(0.1, -0.85, 0.0),
    chest: vec3(0.12, -0.6, -0.15),
    head: vec3(-0.1, 1.0, 0.0),
    reach: vec2(1.1, 1.0),
    ..HOOK,
}

/// The hook's finish, held: turned on through, the arm still across, the head up and on the
/// target.
const HOOK_DONE = Pose {
    hips: vec3(0.08, -1.0, 0.0),
    chest: vec3(0.1, -0.8, -0.12),
    head: vec3(-0.12, 1.15, 0.0),
    ..HOOK_HIT,
}

/// The lunge's hit, longer: one line from the rear heel through the fist, the body no more than a
/// third of the way to level (flatter, it read as a fall), the head up, the rear fist pulled back
/// to the hip. The hips barely shift ahead of the feet: on a capture's wide stance, a shift the
/// legs can't reach sinks the body into a fold.
const LUNGE_HIT = Pose {
    lift: vec3(0.0, -0.1, 0.12),
    hips: vec3(0.12, -0.4, 0.0),
    waist: vec3(0.05, -0.1, 0.0),
    chest: vec3(0.1, -0.25, 0.0),
    head: vec3(-0.3, 0.45, 0.0),
    reach: vec2(1.16, 1.0),
    ..LUNGE,
}

/// The haymaker cocked for its hold: twisted right away, the striking arm high behind the head,
/// the lead arm reaching out to aim, the weight back over the rear leg.
const HAY_HOLD = Pose {
    hips: vec3(-0.06, 0.8, 0.0),
    chest: vec3(-0.25, 0.6, -0.1),
    head: vec3(-0.05, -1.1, 0.0),
    upper_l: vec3(-0.1, 0.05, 1.0),
    fore_l: vec3(0.05, 0.1, 1.0),
    ..HAY_COCKED,
}

/// The haymaker's blow: the fist driven down through where the face was, the chest turned past
/// square behind it (not folded over: bent past the hips, it read as a bow), the lead foot
/// stamped ahead, the rear heel up.
const HAY_HIT = Pose {
    lift: vec3(0.0, -0.12, 0.1),
    foot_l: vec3(-0.12, 0.085, 0.36),
    hips: vec3(0.12, -0.35, 0.0),
    waist: vec3(0.08, -0.15, 0.0),
    chest: vec3(0.22, -0.4, 0.05),
    head: vec3(-0.15, 0.4, 0.0),
    fore_r: vec3(0.0, -0.45, 0.89),
    ..HAY_DOWN,
}

/// The wanderer's move `n`'s keys, over its capture: quick, each snapping out of a short held
/// chamber and hitting with a held impact, the heavy hook coiled long and finished in a held pose.
pub fn wanderer_keys(n: u32) -> Vec<Key> {
    if n == JAB_N {
        return Vec::from(
            [
                by(
                    Phase::Windup,
                    0.45,
                    Pose {
                        lift: vec3(0.0, -0.04, -0.04),
                        chest: vec3(-0.05, -0.25, 0.0),
                        head: vec3(0.05, 0.0, 0.0),
                        ..NONE,
                    },
                    TRUNK | HEAD,
                    2.0,
                    SNAP,
                ),
                key(Phase::Active, 0.0, JAB_HIT, UPPER, 4.0, SMOOTH),
                // The follow-through held, arm still out, the feet planted in stance.
                key(Phase::Recovery, 0.1, JAB_HIT, UPPER | LEGS, 4.0, SMOOTH),
            ],
        )
    }
    if n == CROSS_N {
        return Vec::from(
            [
                key(Phase::Windup, 0.5, CROSS_COCK, UPPER, 3.0, SNAP),
                key(Phase::Active, 0.0, CROSS_HIT, UPPER, 4.0, SMOOTH),
                key(Phase::Recovery, 0.12, CROSS_HIT, UPPER | LEGS, 5.0, SMOOTH),
            ],
        )
    }
    Vec::from(
        [
            key(Phase::Windup, 0.45, HOOK_COIL, UPPER, 6.0, SNAP),
            key(Phase::Active, 0.0, HOOK_HIT, UPPER, 4.0, SMOOTH),
            // The finish held (a mie): turned on through, the arm still across, the feet planted.
            key(Phase::Recovery, 0.12, HOOK_DONE, UPPER | LEGS, 8.0, SMOOTH),
        ],
    )
}

/// The brawler's move `n`'s keys, over its capture (the sweep alone has none): every wind-up held
/// long enough to be read and dodged, every blow hitting with its body behind it, every recovery
/// overcommitted and held, the opening to punish.
pub fn brawler_keys(n: u32) -> Vec<Key> {
    if n == ONE_N {
        return Vec::from(
            [
                by(
                    Phase::Windup,
                    0.55,
                    Pose {
                        lift: vec3(0.0, -0.07, -0.08),
                        chest: vec3(-0.12, -0.35, 0.0),
                        head: vec3(0.1, 0.0, 0.0),
                        ..NONE,
                    },
                    TRUNK | HEAD,
                    5.0,
                    SNAP,
                ),
                key(
                    Phase::Active,
                    0.0,
                    Pose { lift: vec3(0.0, -0.11, 0.1), chest: vec3(0.14, 0.2, 0.0), ..JAB_HIT },
                    UPPER,
                    4.0,
                    SMOOTH,
                ),
            ],
        )
    }
    if n == TWO_N {
        return Vec::from(
            [
                key(Phase::Windup, 0.5, CROSS_COCK, UPPER, 4.0, SNAP),
                key(Phase::Active, 0.0, CROSS_HIT, UPPER, 4.0, SMOOTH),
                // Overcommitted, held: still leaning through, the feet planted (the capture's
                // knee lift, held, read as a flamingo).
                key(Phase::Recovery, 0.15, CROSS_HIT, UPPER | LEGS, 8.0, SMOOTH),
            ],
        )
    }
    if n == HAYMAKER_N {
        return Vec::from(
            [
                key(Phase::Windup, 0.25, HAY_LIFT, UPPER, 0.0, SMOOTH),
                // The delay: cocked at its limit and held there, then the snap down.
                // (As written: the hook's performer leans to the side, which bowed these poses.)
                Key { rebase: false, ..key(Phase::Windup, 0.5, HAY_HOLD, UPPER, 22.0, SNAP) },
                Key { rebase: false, ..key(Phase::Active, 0.0, HAY_HIT, ALL, 5.0, SMOOTH) },
                Key { rebase: false, ..key(Phase::Recovery, 0.2, HAY_HIT, ALL, 10.0, SMOOTH) },
            ],
        )
    }
    if n == LUNGE_N {
        return Vec::from(
            [
                key(Phase::Windup, 0.55, LUNGE_LOAD, UPPER, 6.0, SNAP),
                key(Phase::Active, 0.0, LUNGE_HIT, UPPER, 5.0, SMOOTH),
                key(Phase::Recovery, 0.12, LUNGE_HIT, UPPER | LEGS, 6.0, SMOOTH),
            ],
        )
    }
    // The sweep: no capture of one, so its keys are the whole of it, over the guard.
    Vec::from(
        [
            key(Phase::Windup, 0.7, SWEEP_WIND, ALL, 2.0, SNAP),
            key(Phase::Active, 0.0, SWEEP, ALL, 4.0, SMOOTH),
            key(Phase::Recovery, 0.2, SWEEP, TRUNK | HEAD, 0.0, SMOOTH),
        ],
    )
}

/// The riposte's beats: down into the coil slowly, dead still, the snap up into the blow, on up
/// into the follow-through, held high, back on guard.
pub fn riposte_beats() -> Vec<Beat> {
    Vec::from(
        [
            at(0.0, GUARD, SMOOTH),
            at(f32(COILED), COIL, HOLD),
            at(f32(STILL), COIL, SNAP),
            at(f32(CONTACT), UPPERCUT, SNAP),
            at(f32(OVER), OVERHEAD, HOLD),
            at(90.0, OVERHEAD, SMOOTH),
            at(f32(RIPOSTE), GUARD, SMOOTH),
        ],
    )
}
