/// The riposte's ticks: the coil reached, held dead still until the snap, the fist's contact
/// (the hit-stop begins), the follow-through's height, and the end, back on guard.
pub const COILED: u32 = 22
pub const STILL: u32 = 34
pub const CONTACT: u32 = 40
pub const OVER: u32 = 50
pub const RIPOSTE: u32 = 120

/// A beat `ticks` in (at 60 a second).
fn at(ticks: f32, pose: pose::Pose, ease: u32) -> Beat {
    Beat { at: ticks / 60.0, pose, ease }
}

/// The wanderer's move `n`'s beats.
pub fn wanderer_beats(n: u32) -> Vec<Beat> {
    if n == JAB_N {
        return Vec::from(
            [
                at(0.0, GUARD, SNAP),
                at(3.0, JAB_LOAD, SNAP),
                at(8.0, JAB, HOLD),
                at(13.0, JAB, SMOOTH),
                at(30.0, GUARD, SMOOTH),
            ],
        )
    }
    if n == CROSS_N {
        return Vec::from(
            [
                at(0.0, GUARD, SNAP),
                at(4.0, CROSS_LOAD, SNAP),
                at(10.0, CROSS, HOLD),
                at(15.0, CROSS, SMOOTH),
                at(36.0, GUARD, SMOOTH),
            ],
        )
    }
    Vec::from(
        [
            at(0.0, GUARD, SMOOTH),
            at(13.0, HOOK_LOAD, HOLD),
            at(15.0, HOOK_LOAD, SNAP),
            at(20.0, HOOK, HOLD),
            at(26.0, HOOK, SMOOTH),
            at(53.0, GUARD, SMOOTH),
        ],
    )
}

/// The brawler's move `n`'s beats.
pub fn brawler_beats(n: u32) -> Vec<Beat> {
    if n == ONE_N {
        return Vec::from(
            [
                at(0.0, GUARD, SMOOTH),
                at(14.0, JAB_LOAD, SNAP),
                at(22.0, JAB, HOLD),
                at(27.0, JAB, SMOOTH),
                at(38.0, CROSS_LOAD, SMOOTH),
            ],
        )
    }
    if n == TWO_N {
        return Vec::from(
            [
                at(0.0, CROSS_LOAD, HOLD),
                at(10.0, CROSS_LOAD, SNAP),
                at(18.0, CROSS, HOLD),
                at(25.0, CROSS, SMOOTH),
                at(57.0, GUARD, SMOOTH),
            ],
        )
    }
    if n == HAYMAKER_N {
        return Vec::from(
            [
                at(0.0, GUARD, SMOOTH),
                at(16.0, HAY_LIFT, SMOOTH),
                at(55.0, HAY_COCKED, HOLD),
                at(57.0, HAY_COCKED, SNAP),
                at(62.0, HAY_DOWN, HOLD),
                at(80.0, HAY_DOWN, SMOOTH),
                at(112.0, GUARD, SMOOTH),
            ],
        )
    }
    if n == LUNGE_N {
        return Vec::from(
            [
                at(0.0, GUARD, SMOOTH),
                at(16.0, LUNGE_LOAD, HOLD),
                at(21.0, LUNGE_LOAD, SNAP),
                at(28.0, LUNGE, HOLD),
                at(40.0, LUNGE, SMOOTH),
                at(70.0, GUARD, SMOOTH),
            ],
        )
    }
    Vec::from(
        [
            at(0.0, GUARD, SMOOTH),
            at(18.0, SWEEP_WIND, SNAP),
            at(26.0, SWEEP, HOLD),
            at(32.0, SWEEP, SMOOTH),
            at(69.0, GUARD, SMOOTH),
        ],
    )
}

/// The riposte's beats: down into the coil slowly, dead still, the snap up into the blow, on up
/// into the follow-through, held high, back on guard.
pub fn riposte_beats() -> Vec<Beat> {
    Vec::from(
        [
            at(0.0, GUARD, SMOOTH),
            at(f32(COILED), COIL, HOLD),
            at(f32(STILL), COIL, SNAP),
            at(f32(CONTACT), UPPERCUT, SNAP),
            at(f32(OVER), OVERHEAD, HOLD),
            at(90.0, OVERHEAD, SMOOTH),
            at(f32(RIPOSTE), GUARD, SMOOTH),
        ],
    )
}
