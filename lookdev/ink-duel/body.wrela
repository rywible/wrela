// The duel's people: one humanoid body, built to a person's proportions (eight heads tall: the
// figure drawing's canon), its forms the masses an anatomy class draws rather than a mannequin's
// tubes: a ribcage wider at the top than the waist, a pelvis with the glutes behind it, the
// trapezius sloping from the neck to the shoulder, deltoids capping the shoulders, a biceps and a
// forearm's swell near the elbow, a quadriceps and a calf, a jaw and a nose, so the silhouette
// reads as a person from any side. Its skeleton has clavicles (a shoulder shrugs), wrists and
// toes (a foot rolls off its ball), and is the same for every build; a build scales it and its
// masses (`Build`), so a heavy brawler and a lean wanderer are one type, one set of pipelines.
//
// Andrew Loomis 1943, "Figure Drawing for All It's Worth": the eight-head figure and its masses.

use engine::character::Shaded
use engine::creature::{Body, Bone, Placed, Skeleton, Then, creature}
use std::field::{Blend, Oval, RoundCone, Surface, Translate, With, oval, round_cone}

/// A part's paint: its albedo, as the character's look reads it (`ByChannels`).
pub struct Paint: Copy + Blend + GpuData {
    pub albedo: vec3,
}

impl engine::character::Shaded for Paint {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        0.7
    }
}

/// The two shapes a body is made of: a round cone (a limb, a neck, a jaw) and an oval (a mass:
/// the ribcage, a deltoid, a calf), each painted and placed on its bone.
pub type Cone = Placed<With<RoundCone, Paint>>

pub type Mass = Placed<With<Translate<Oval>, Paint>>

/// The body: its parts, in the order `figure` joins them.
pub type Figure = Body<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Mass, Mass>, Cone>, Mass>, Mass>, Cone>, Cone>, Mass>, Cone>, Cone>, Mass>, Mass>, Cone>, Mass>, Cone>, Mass>, Cone>, Mass>, Cone>, Cone>, Mass>, Cone>, Mass>, Cone>, Cone>>

/// Its bones, by name: its root (the pelvis), the small of its back, its chest, neck and head;
/// each side's clavicle, shoulder, elbow and wrist; each side's hip, knee, ankle and toes (r: its
/// right, at +x).
pub struct Bones: Copy {
    pub pelvis: Bone,
    pub spine: Bone,
    pub chest: Bone,
    pub neck: Bone,
    pub head: Bone,
    pub clav_r: Bone,
    pub shoulder_r: Bone,
    pub elbow_r: Bone,
    pub wrist_r: Bone,
    pub clav_l: Bone,
    pub shoulder_l: Bone,
    pub elbow_l: Bone,
    pub wrist_l: Bone,
    pub hip_r: Bone,
    pub knee_r: Bone,
    pub ankle_r: Bone,
    pub toe_r: Bone,
    pub hip_l: Bone,
    pub knee_l: Bone,
    pub ankle_l: Bone,
    pub toe_l: Bone,
}

/// A build: how tall (against 1.8 m), how broad across the shoulders and hips, how thick its
/// masses are, and its colours: its coat (the torso and the upper arms, or its skin where it
/// goes bare), its sash, its wraps (forearms and fists), its trousers, its skin and its hair; and
/// its hair's shape (a tuft tied back, or a topknot: half axes and where on the head).
pub struct Build: Copy {
    pub tall: f32 = 1.0,
    pub broad: f32 = 1.0,
    pub thick: f32 = 1.0,
    pub coat: vec3,
    pub sash: vec3,
    pub wraps: vec3,
    pub trousers: vec3,
    pub skin: vec3,
    pub hair: vec3,
    pub hair_size: vec3,
    pub hair_at: vec3,
}

/// The wanderer: lean, in an indigo coat and a red sash, its forearms wrapped pale, its hair
/// tied back.
pub const WANDERER = Build {
    coat: vec3(0.17, 0.19, 0.28),
    sash: vec3(0.58, 0.08, 0.05),
    wraps: vec3(0.80, 0.74, 0.62),
    trousers: vec3(0.16, 0.16, 0.18),
    skin: vec3(0.64, 0.45, 0.33),
    hair: vec3(0.05, 0.04, 0.04),
    hair_size: vec3(0.092, 0.075, 0.105),
    hair_at: vec3(0.0, 0.165, -0.025),
}

/// The brawler: a head taller and heavier, bare to the waist, in pale trousers and a blue sash,
/// its wraps dark, a topknot.
pub const BRAWLER = Build {
    tall: 1.1,
    broad: 1.16,
    thick: 1.24,
    coat: vec3(0.50, 0.33, 0.24),
    sash: vec3(0.10, 0.20, 0.45),
    wraps: vec3(0.12, 0.11, 0.11),
    trousers: vec3(0.66, 0.62, 0.54),
    skin: vec3(0.50, 0.33, 0.24),
    hair: vec3(0.05, 0.04, 0.04),
    hair_size: vec3(0.045, 0.05, 0.045),
    hair_at: vec3(0.0, 0.215, -0.045),
}

/// The skeleton of a build `b`: standing at the origin facing +z, its arms out level (its rest),
/// 1.8 m tall times `b.tall`, its shoulders and hips `b.broad` as wide.
pub fn skeleton(b: Build) -> (Skeleton, Bones) {
    let t = b.tall
    let w = b.broad
    var s = Skeleton::new()
    let pelvis = s.root("pelvis", at(vec3(0.0, 0.98, 0.0), w: w, t: t))
    let spine = s.joint("spine", pelvis, at(vec3(0.0, 1.1, -0.01), w: w, t: t))
    let chest = s.joint("chest", spine, at(vec3(0.0, 1.26, -0.01), w: w, t: t))
    let neck = s.joint("neck", chest, at(vec3(0.0, 1.5, -0.02), w: w, t: t))
    let head = s.joint("head", neck, at(vec3(0.0, 1.585, 0.0), w: w, t: t))
    let (clav_r, clav_l) = s.joint_pair(
        "clav_r",
        "clav_l",
        chest,
        at(vec3(0.025, 1.45, 0.03), w: w, t: t),
    )
    let (shoulder_r, shoulder_l) = s.joint_pair(
        "shoulder_r",
        "shoulder_l",
        clav_r,
        at(vec3(0.185, 1.455, -0.015), w: w, t: t),
    )
    let (elbow_r, elbow_l) = s.joint_pair(
        "elbow_r",
        "elbow_l",
        shoulder_r,
        at(vec3(0.475, 1.455, -0.02), w: w, t: t),
    )
    let (wrist_r, wrist_l) = s.joint_pair(
        "wrist_r",
        "wrist_l",
        elbow_r,
        at(vec3(0.735, 1.455, -0.01), w: w, t: t),
    )
    let (hip_r, hip_l) = s.joint_pair(
        "hip_r",
        "hip_l",
        pelvis,
        at(vec3(0.092, 0.95, 0.0), w: w, t: t),
    )
    let (knee_r, knee_l) = s.joint_pair(
        "knee_r",
        "knee_l",
        hip_r,
        at(vec3(0.1, 0.51, 0.025), w: w, t: t),
    )
    let (ankle_r, ankle_l) = s.joint_pair(
        "ankle_r",
        "ankle_l",
        knee_r,
        at(vec3(0.1, 0.085, -0.02), w: w, t: t),
    )
    let (toe_r, toe_l) = s.joint_pair(
        "toe_r",
        "toe_l",
        ankle_r,
        at(vec3(0.105, 0.02, 0.145), w: w, t: t),
    )
    (
        s,
        Bones {
            pelvis,
            spine,
            chest,
            neck,
            head,
            clav_r,
            shoulder_r,
            elbow_r,
            wrist_r,
            clav_l,
            shoulder_l,
            elbow_l,
            wrist_l,
            hip_r,
            knee_r,
            ankle_r,
            toe_r,
            hip_l,
            knee_l,
            ankle_l,
            toe_l,
        },
    )
}

/// A skeleton's joint at `p` for a figure 1.8 m tall: its width scaled by `w` and the
/// whole by `t`.
fn at(p: vec3, w: f32, t: f32) -> vec3 {
    vec3(p.x * w, p.y, p.z) * t
}

/// A build's scale: its height's (`t`) and its masses' thickness (`g`).
struct Scale: Copy {
    t: f32,
    g: f32,
}

impl Scale {
    /// A limb or a neck: a round cone from `a` to `c` (its bone's space), `ra` and `rc` thick.
    fn cone(self, a: vec3, c: vec3, ra: f32, rc: f32, col: vec3) -> With<RoundCone, Paint> {
        round_cone(a * self.t, c * self.t, r_top: ra * self.g, r_bottom: rc * self.g).with(
            Paint { albedo: col },
        )
    }

    /// A mass: an oval of half axes `r`, its middle at `at`.
    fn mass(self, r: vec3, at: vec3, col: vec3) -> With<Translate<Oval>, Paint> {
        oval(r * self.g).translate(at * self.t).with(Paint { albedo: col })
    }
}

/// The body of build `b`, on its skeleton: its masses and limbs, each on its bone, the paired
/// ones mirrored onto the left.
pub fn figure(b: Build) -> (Figure, Skeleton, Bones) {
    let (s, k) = skeleton(b)
    let t = b.tall
    let g = b.thick * t
    let z = Scale { t, g }
    // A head isn't thicker for a heavier build; a neck a little.
    let hz = Scale { t, g: t }
    let nz = Scale { t, g: t * sqrt(b.thick) }
    let body = creature(s)
        // The pelvis, wide at the hips, the glutes behind it.
        .join(
            "pelvis",
            k.pelvis,
            z.mass(vec3(0.155 * b.broad, 0.105, 0.11), vec3(0.0, -0.035, -0.005), b.trousers),
        )
        .join(
            "glute",
            k.pelvis,
            z.mass(vec3(0.08, 0.095, 0.08), vec3(0.068 * b.broad, -0.075, -0.055), b.trousers),
            mirror: true,
        )
        // The waist, narrowest above the hips; the sash round it.
        .join(
            "waist",
            k.spine,
            z.cone(vec3(0.0, -0.07, 0.0), vec3(0.0, 0.1, 0.005), ra: 0.118, rc: 0.125, col: b.coat),
        )
        .join("sash", k.spine, z.mass(vec3(0.132, 0.045, 0.118), vec3(0.0, -0.065, 0.0), b.sash))
        // The ribcage: wider at the top, deep; the chest's muscle in front.
        .join(
            "ribs",
            k.chest,
            z.mass(vec3(0.158 * b.broad, 0.165, 0.112), vec3(0.0, 0.07, 0.0), b.coat),
        )
        .join(
            "lats",
            k.chest,
            z.cone(
                vec3(0.0, -0.02, -0.03),
                vec3(0.0, 0.14, -0.02),
                ra: 0.105,
                rc: 0.165 * b.broad,
                col: b.coat,
            ),
        )
        .join(
            "trapezius",
            k.chest,
            z.cone(
                vec3(0.0, 0.245, -0.025),
                vec3(0.14 * b.broad, 0.2, -0.025),
                ra: 0.055,
                rc: 0.042,
                col: b.coat,
            ),
            mirror: true,
        )
        .join(
            "chest",
            k.chest,
            z.mass(vec3(0.07, 0.055, 0.04), vec3(0.06 * b.broad, 0.115, 0.072), b.coat),
            mirror: true,
        )
        // The neck, leaning a little forward; the head: the skull, the jaw, the nose, the hair.
        .join(
            "neck",
            k.neck,
            nz.cone(
                vec3(0.0, -0.03, -0.005),
                vec3(0.0, 0.08, 0.015),
                ra: 0.056,
                rc: 0.047,
                col: b.skin,
            ),
        )
        .join(
            "jaw",
            k.head,
            hz.cone(
                vec3(0.0, 0.07, 0.01),
                vec3(0.0, 0.025, 0.072),
                ra: 0.064,
                rc: 0.034,
                col: b.skin,
            ),
        )
        .join("skull", k.head, hz.mass(vec3(0.083, 0.105, 0.1), vec3(0.0, 0.118, -0.008), b.skin))
        .join("hair", k.head, hz.mass(b.hair_size, b.hair_at, b.hair))
        .join(
            "nose",
            k.head,
            hz.cone(
                vec3(0.0, 0.11, 0.085),
                vec3(0.0, 0.08, 0.1),
                ra: 0.011,
                rc: 0.015,
                col: b.skin,
            ),
        )
        // The arms: a deltoid capping the shoulder, the upper arm and its biceps, the forearm
        // swelling below the elbow and wrapped, the fist.
        .join(
            "deltoid",
            k.shoulder_r,
            z.mass(vec3(0.078, 0.07, 0.078), vec3(0.025, 0.005, 0.0), b.coat),
            mirror: true,
        )
        .join(
            "upper_arm",
            k.shoulder_r,
            z.cone(vec3(0.0), vec3(0.29, 0.0, 0.0), ra: 0.052, rc: 0.04, col: b.coat),
            mirror: true,
        )
        .join(
            "biceps",
            k.shoulder_r,
            z.mass(vec3(0.075, 0.042, 0.044), vec3(0.15, 0.0, 0.012), b.coat),
            mirror: true,
        )
        .join(
            "forearm",
            k.elbow_r,
            z.cone(vec3(0.0), vec3(0.25, 0.0, 0.005), ra: 0.044, rc: 0.029, col: b.wraps),
            mirror: true,
        )
        .join(
            "forearm_swell",
            k.elbow_r,
            z.mass(vec3(0.065, 0.042, 0.038), vec3(0.065, 0.006, 0.0), b.wraps),
            mirror: true,
        )
        .join(
            "fist",
            k.wrist_r,
            z.cone(
                vec3(0.025, 0.0, 0.0),
                vec3(0.075, -0.005, 0.01),
                ra: 0.038,
                rc: 0.043,
                col: b.wraps,
            ),
            mirror: true,
        )
        // The legs: the thigh and its quadriceps, the shin and its calf, the foot and its toes.
        .join(
            "thigh",
            k.hip_r,
            z.cone(vec3(0.0), vec3(0.008, -0.44, 0.025), ra: 0.092, rc: 0.058, col: b.trousers),
            mirror: true,
        )
        .join(
            "quadriceps",
            k.hip_r,
            z.mass(vec3(0.07, 0.16, 0.072), vec3(0.008, -0.19, 0.03), b.trousers),
            mirror: true,
        )
        .join(
            "shin",
            k.knee_r,
            z.cone(vec3(0.0), vec3(0.0, -0.425, -0.045), ra: 0.055, rc: 0.036, col: b.trousers),
            mirror: true,
        )
        .join(
            "calf",
            k.knee_r,
            z.mass(vec3(0.056, 0.115, 0.06), vec3(0.0, -0.13, -0.04), b.trousers),
            mirror: true,
        )
        .join(
            "foot",
            k.ankle_r,
            z.cone(
                vec3(0.0, -0.035, -0.035),
                vec3(0.0, -0.05, 0.125),
                ra: 0.042,
                rc: 0.032,
                col: b.wraps,
            ),
            mirror: true,
        )
        .join(
            "toes",
            k.toe_r,
            z.cone(
                vec3(0.0, -0.005, -0.01),
                vec3(0.0, -0.01, 0.05),
                ra: 0.03,
                rc: 0.022,
                col: b.wraps,
            ),
            mirror: true,
        )
        .blend(0.028)
    (body, s, k)
}
