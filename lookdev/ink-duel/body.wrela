// The duel's people: one humanoid body, an anime figure's proportions (eight heads tall, long in
// the leg, broad and square across the shoulders, narrow at the waist, a pointed chin, spiked
// hair) drawn as an artist's mannequin: each limb one clean tapered form, each joint creased, so
// the ink draws the figure's construction and its silhouette reads from any side without the
// lumps of modelled muscle. Its skeleton has clavicles (a shoulder shrugs), wrists and
// toes (a foot rolls off its ball), and is the same for every build; a build scales it and its
// masses (`Build`), so a heavy brawler and a lean wanderer are one type, one set of pipelines.
//
// Andrew Loomis 1943, "Figure Drawing for All It's Worth": the eight-head figure and its masses.

use engine::character::Shaded
use engine::creature::{Body, Bone, Placed, Skeleton, Then, crease, creature, smooth}
use std::field::{Blend, Oval, RoundCone, Surface, Translate, With, oval, round_cone}

/// A part's paint: its albedo, as the character's look reads it (`ByChannels`).
pub struct Paint: Copy + Blend + GpuData {
    pub albedo: vec3,
}

impl engine::character::Shaded for Paint {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        0.7
    }
}

/// The two shapes a body is made of: a round cone (a limb, a neck, a jaw) and an oval (a mass:
/// the ribcage, a deltoid, a calf), each painted and placed on its bone.
pub type Cone = Placed<With<RoundCone, Paint>>

pub type Mass = Placed<With<Translate<Oval>, Paint>>

/// The body: its parts, in the order `figure` joins them.
pub type Figure = Body<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Mass, Cone>, Mass>, Mass>, Cone>, Cone>, Mass>, Cone>, Mass>, Cone>, Cone>, Cone>, Cone>, Mass>, Cone>, Cone>, Mass>, Cone>, Cone>, Cone>, Cone>, Mass>, Cone>, Cone>>

/// Its bones, by name: its root (the pelvis), the small of its back, its chest, neck and head;
/// each side's clavicle, shoulder, elbow and wrist; each side's hip, knee, ankle and toes (r: its
/// right, at +x).
pub struct Bones: Copy {
    pub pelvis: Bone,
    pub spine: Bone,
    pub chest: Bone,
    pub neck: Bone,
    pub head: Bone,
    pub clav_r: Bone,
    pub shoulder_r: Bone,
    pub elbow_r: Bone,
    pub wrist_r: Bone,
    pub clav_l: Bone,
    pub shoulder_l: Bone,
    pub elbow_l: Bone,
    pub wrist_l: Bone,
    pub hip_r: Bone,
    pub knee_r: Bone,
    pub ankle_r: Bone,
    pub toe_r: Bone,
    pub hip_l: Bone,
    pub knee_l: Bone,
    pub ankle_l: Bone,
    pub toe_l: Bone,
}

/// A build: how tall (against 1.8 m), how broad across the shoulders and hips, how thick its
/// forms are; its colours (its coat: the torso and upper arms, or its skin where it goes bare;
/// its sash; its wraps on the forearms, fists and feet; its trousers; its skin; its hair); and its
/// hair's shape: a cap (half axes, where on the head) and three spikes swept from it (the middle
/// one's root and tip, and the side ones', mirrored), as an anime figure's hair reads in
/// silhouette.
pub struct Build: Copy {
    pub tall: f32 = 1.0,
    pub broad: f32 = 1.0,
    pub thick: f32 = 1.0,
    pub coat: vec3,
    pub sash: vec3,
    pub wraps: vec3,
    pub trousers: vec3,
    pub skin: vec3,
    pub hair: vec3,
    pub cap: vec3,
    pub cap_at: vec3,
    pub spike: (vec3, vec3),
    pub side: (vec3, vec3),
    /// Its fringe: a lock over each side of the brow (root and tip, the right's; mirrored).
    pub fringe: (vec3, vec3),
}

/// The wanderer: lean and long-legged, in an indigo coat and a red sash, its forearms wrapped
/// pale, its hair swept back into a tail.
pub const WANDERER = Build {
    coat: vec3(0.17, 0.19, 0.28),
    sash: vec3(0.62, 0.08, 0.05),
    wraps: vec3(0.82, 0.76, 0.64),
    trousers: vec3(0.15, 0.15, 0.17),
    skin: vec3(0.62, 0.45, 0.34),
    hair: vec3(0.06, 0.05, 0.06),
    cap: vec3(0.09, 0.07, 0.1),
    cap_at: vec3(0.0, 0.16, -0.015),
    spike: (vec3(0.0, 0.15, -0.07), vec3(0.0, 0.05, -0.2)),
    side: (vec3(0.06, 0.15, -0.03), vec3(0.085, 0.09, -0.11)),
    fringe: (vec3(0.03, 0.19, 0.05), vec3(0.055, 0.135, 0.1)),
}

/// The brawler: a head taller and heavier, bare to the waist, in pale trousers and a blue sash,
/// its wraps leather, its hair tied up in a topknot.
pub const BRAWLER = Build {
    tall: 1.12,
    broad: 1.32,
    thick: 1.42,
    coat: vec3(0.55, 0.37, 0.27),
    sash: vec3(0.10, 0.20, 0.48),
    wraps: vec3(0.42, 0.28, 0.2),
    trousers: vec3(0.68, 0.64, 0.56),
    skin: vec3(0.55, 0.37, 0.27),
    hair: vec3(0.05, 0.04, 0.04),
    cap: vec3(0.084, 0.05, 0.09),
    cap_at: vec3(0.0, 0.175, -0.02),
    spike: (vec3(0.0, 0.2, -0.04), vec3(0.0, 0.29, -0.07)),
    side: (vec3(0.03, 0.2, -0.04), vec3(0.035, 0.27, -0.08)),
    fringe: (vec3(0.05, 0.17, 0.04), vec3(0.075, 0.15, 0.075)),
}

/// The skeleton of a build `b`: standing at the origin facing +z, its arms out level (its rest),
/// 1.8 m tall times `b.tall`, its shoulders and hips `b.broad` as wide.
pub fn skeleton(b: Build) -> (Skeleton, Bones) {
    let t = b.tall
    let w = b.broad
    var s = Skeleton::new()
    let pelvis = s.root("pelvis", at(vec3(0.0, 0.98, 0.0), w: w, t: t))
    let spine = s.joint("spine", pelvis, at(vec3(0.0, 1.1, -0.01), w: w, t: t))
    let chest = s.joint("chest", spine, at(vec3(0.0, 1.26, -0.01), w: w, t: t))
    let neck = s.joint("neck", chest, at(vec3(0.0, 1.5, -0.02), w: w, t: t))
    let head = s.joint("head", neck, at(vec3(0.0, 1.585, 0.0), w: w, t: t))
    let (clav_r, clav_l) = s.joint_pair(
        "clav_r",
        "clav_l",
        chest,
        at(vec3(0.025, 1.45, 0.03), w: w, t: t),
    )
    let (shoulder_r, shoulder_l) = s.joint_pair(
        "shoulder_r",
        "shoulder_l",
        clav_r,
        at(vec3(0.185, 1.455, -0.015), w: w, t: t),
    )
    let (elbow_r, elbow_l) = s.joint_pair(
        "elbow_r",
        "elbow_l",
        shoulder_r,
        at(vec3(0.475, 1.455, -0.02), w: w, t: t),
    )
    let (wrist_r, wrist_l) = s.joint_pair(
        "wrist_r",
        "wrist_l",
        elbow_r,
        at(vec3(0.735, 1.455, -0.01), w: w, t: t),
    )
    let (hip_r, hip_l) = s.joint_pair(
        "hip_r",
        "hip_l",
        pelvis,
        at(vec3(0.092, 0.95, 0.0), w: w, t: t),
    )
    let (knee_r, knee_l) = s.joint_pair(
        "knee_r",
        "knee_l",
        hip_r,
        at(vec3(0.1, 0.51, 0.025), w: w, t: t),
    )
    let (ankle_r, ankle_l) = s.joint_pair(
        "ankle_r",
        "ankle_l",
        knee_r,
        at(vec3(0.1, 0.085, -0.02), w: w, t: t),
    )
    let (toe_r, toe_l) = s.joint_pair(
        "toe_r",
        "toe_l",
        ankle_r,
        at(vec3(0.105, 0.02, 0.145), w: w, t: t),
    )
    (
        s,
        Bones {
            pelvis,
            spine,
            chest,
            neck,
            head,
            clav_r,
            shoulder_r,
            elbow_r,
            wrist_r,
            clav_l,
            shoulder_l,
            elbow_l,
            wrist_l,
            hip_r,
            knee_r,
            ankle_r,
            toe_r,
            hip_l,
            knee_l,
            ankle_l,
            toe_l,
        },
    )
}

/// A skeleton's joint at `p` for a figure 1.8 m tall: its width scaled by `w` and the
/// whole by `t`.
fn at(p: vec3, w: f32, t: f32) -> vec3 {
    vec3(p.x * w, p.y, p.z) * t
}

/// A build's scale: its height's (`t`) and its masses' thickness (`g`).
struct Scale: Copy {
    t: f32,
    g: f32,
}

impl Scale {
    /// A limb or a neck: a round cone from `a` to `c` (its bone's space), `ra` and `rc` thick.
    fn cone(self, a: vec3, c: vec3, ra: f32, rc: f32, col: vec3) -> With<RoundCone, Paint> {
        round_cone(a * self.t, c * self.t, r_top: ra * self.g, r_bottom: rc * self.g).with(
            Paint { albedo: col },
        )
    }

    /// A mass: an oval of half axes `r`, its middle at `at`.
    fn mass(self, r: vec3, at: vec3, col: vec3) -> With<Translate<Oval>, Paint> {
        oval(r * self.g).translate(at * self.t).with(Paint { albedo: col })
    }
}

/// The body of build `b`, on its skeleton: an anime figure's forms, kept as a mannequin's (each
/// limb one clean tapered form, its joints creased so the ink draws where one meets the next), the
/// paired ones mirrored onto the left.
pub fn figure(b: Build) -> (Figure, Skeleton, Bones) {
    let (s, k) = skeleton(b)
    let t = b.tall
    let g = b.thick * t
    let z = Scale { t, g }
    // A head isn't thicker for a heavier build; a neck a little.
    let hz = Scale { t, g: t }
    let nz = Scale { t, g: t * sqrt(b.thick) }
    let joint = crease(k: 0.035, depth: 0.009)
    let body = creature(s)
        // The pelvis; the waist, narrow over it; the sash round it.
        .join(
            "pelvis",
            k.pelvis,
            z.mass(vec3(0.15 * b.broad, 0.1, 0.105), vec3(0.0, -0.03, 0.0), b.trousers),
        )
        .join(
            "waist",
            k.spine,
            z.cone(vec3(0.0, -0.06, 0.0), vec3(0.0, 0.1, 0.005), ra: 0.108, rc: 0.122, col: b.coat),
        )
        .join("sash", k.spine, z.mass(vec3(0.128, 0.042, 0.115), vec3(0.0, -0.06, 0.0), b.sash))
        // The chest, wide and deep at the top; the shoulders across it as one bar, square.
        .join(
            "chest",
            k.chest,
            z.mass(vec3(0.16 * b.broad, 0.165, 0.112), vec3(0.0, 0.08, 0.005), b.coat),
        )
        .join(
            "shoulders",
            k.chest,
            z.cone(
                vec3(-0.16 * b.broad, 0.19, -0.02),
                vec3(0.16 * b.broad, 0.19, -0.02),
                ra: 0.068,
                rc: 0.068,
                col: b.coat,
            ),
        )
        // The neck; the head: the skull, the jaw tapering to a pointed chin, the hair.
        .join(
            "neck",
            k.neck,
            nz.cone(
                vec3(0.0, -0.04, -0.005),
                vec3(0.0, 0.08, 0.012),
                ra: 0.052,
                rc: 0.045,
                col: b.skin,
            ),
            seam: joint,
        )
        .join("skull", k.head, hz.mass(vec3(0.08, 0.098, 0.094), vec3(0.0, 0.12, -0.005), b.skin))
        .join(
            "jaw",
            k.head,
            hz.cone(
                vec3(0.0, 0.075, 0.015),
                vec3(0.0, 0.018, 0.078),
                ra: 0.066,
                rc: 0.024,
                col: b.skin,
            ),
        )
        .join("hair", k.head, hz.mass(b.cap, b.cap_at, b.hair))
        .join(
            "spike",
            k.head,
            hz.cone(b.spike.0, b.spike.1, ra: 0.05, rc: 0.008, col: b.hair),
        )
        .join(
            "spikes",
            k.head,
            hz.cone(b.side.0, b.side.1, ra: 0.045, rc: 0.008, col: b.hair),
            mirror: true,
        )
        .join(
            "fringe",
            k.head,
            hz.cone(b.fringe.0, b.fringe.1, ra: 0.032, rc: 0.006, col: b.hair),
            mirror: true,
        )
        // The face's planes, which the light and the ink catch: a small nose's wedge and the
        // ears, each with a seam of its own (the body's blend, wider than either, smeared each
        // into a lump), so a profile reads. No painted eyes or brows: at a fight's distance, dark
        // marks on the face's pale egg read as a skull's sockets.
        .join(
            "nose",
            k.head,
            hz.cone(
                vec3(0.0, 0.112, 0.087),
                vec3(0.0, 0.092, 0.1),
                ra: 0.008,
                rc: 0.006,
                col: b.skin,
            ),
            seam: smooth(0.008),
        )
        .join(
            "ear",
            k.head,
            hz.mass(vec3(0.012, 0.026, 0.018), vec3(0.08, 0.108, -0.005), b.skin),
            seam: smooth(0.008),
            mirror: true,
        )
        // The arms: the upper arm, the forearm (wrapped), the fist, each creased at its joint.
        .join(
            "upper_arm",
            k.shoulder_r,
            z.cone(vec3(0.0), vec3(0.29, 0.0, 0.0), ra: 0.056, rc: 0.042, col: b.coat),
            mirror: true,
        )
        .join(
            "forearm",
            k.elbow_r,
            z.cone(vec3(0.0), vec3(0.25, 0.0, 0.005), ra: 0.047, rc: 0.032, col: b.wraps),
            seam: joint,
            mirror: true,
        )
        .join(
            "fist",
            k.wrist_r,
            z.mass(vec3(0.062, 0.042, 0.05), vec3(0.06, 0.0, 0.004), b.wraps),
            seam: joint,
            mirror: true,
        )
        // The wrist, so the fist never floats off the forearm's end; the thumb, folded across
        // the fist's front, so it reads as a hand closed and not a ball.
        .join(
            "wrist",
            k.wrist_r,
            z.cone(
                vec3(-0.03, 0.0, 0.0),
                vec3(0.02, 0.0, 0.002),
                ra: 0.031,
                rc: 0.034,
                col: b.wraps,
            ),
            mirror: true,
        )
        .join(
            "thumb",
            k.wrist_r,
            z.cone(
                vec3(0.025, -0.012, 0.04),
                vec3(0.085, -0.022, 0.05),
                ra: 0.017,
                rc: 0.013,
                col: b.wraps,
            ),
            seam: smooth(0.006),
            mirror: true,
        )
        // The legs: the thigh, the shin with its calf, the foot and its toes, each creased at its
        // joint.
        .join(
            "thigh",
            k.hip_r,
            z.cone(vec3(0.0), vec3(0.006, -0.44, 0.022), ra: 0.09, rc: 0.056, col: b.trousers),
            mirror: true,
        )
        .join(
            "shin",
            k.knee_r,
            z.cone(vec3(0.0), vec3(0.0, -0.425, -0.045), ra: 0.056, rc: 0.035, col: b.trousers),
            seam: joint,
            mirror: true,
        )
        .join(
            "calf",
            k.knee_r,
            z.mass(vec3(0.05, 0.11, 0.054), vec3(0.0, -0.13, -0.034), b.trousers),
            mirror: true,
        )
        .join(
            "foot",
            k.ankle_r,
            z.cone(
                vec3(0.0, -0.035, -0.035),
                vec3(0.0, -0.05, 0.125),
                ra: 0.042,
                rc: 0.032,
                col: b.wraps,
            ),
            seam: joint,
            mirror: true,
        )
        .join(
            "toes",
            k.toe_r,
            z.cone(
                vec3(0.0, -0.005, -0.01),
                vec3(0.0, -0.01, 0.05),
                ra: 0.03,
                rc: 0.022,
                col: b.wraps,
            ),
            mirror: true,
        )
        .blend(0.024)
    (body, s, k)
}

/// A body's capsules, a bone each, read off its own parts (the round cones exactly; an oval as the
/// capsule down its long axis that holds it): what contact and physics test against, for no cost
/// at load (`engine::physique::fit_capsules` would fit the same from the field, refining every cell
/// of the body's box). In the body's rest space, as `fit_capsules` gives them.
pub fn capsules(b: Build) -> Vec<engine::physique::Capsule> {
    let (s, k) = skeleton(b)
    let t = b.tall
    let g = b.thick * t
    let cap = |bone: Bone, a: vec3, c: vec3, r: f32| -> engine::physique::Capsule {
        let at = s.rest(bone)
        engine::physique::Capsule { bone, a: at + a * t, b: at + c * t, radius: r }
    }
    let wide = 0.16 * b.broad
    Vec::from(
        [
            cap(
                k.pelvis,
                vec3(-0.15 * b.broad + 0.1, -0.03, 0.0),
                vec3(0.15 * b.broad - 0.1, -0.03, 0.0),
                0.105 * g,
            ),
            cap(k.spine, vec3(0.0, -0.06, 0.0), vec3(0.0, 0.1, 0.005), 0.122 * g),
            cap(k.chest, vec3(0.0, 0.0, 0.005), vec3(0.0, 0.16, 0.005), max(wide, 0.112) * g),
            cap(k.chest, vec3(-wide, 0.19, -0.02), vec3(wide, 0.19, -0.02), 0.068 * g),
            cap(
                k.neck,
                vec3(0.0, -0.04, -0.005),
                vec3(0.0, 0.08, 0.012),
                0.052 * t * sqrt(b.thick),
            ),
            cap(k.head, vec3(0.0, 0.07, -0.005), vec3(0.0, 0.17, -0.005), 0.094 * t),
            cap(k.shoulder_r, vec3(0.0), vec3(0.29, 0.0, 0.0), 0.056 * g),
            cap(k.shoulder_l, vec3(0.0), vec3(-0.29, 0.0, 0.0), 0.056 * g),
            cap(k.elbow_r, vec3(0.0), vec3(0.25, 0.0, 0.005), 0.047 * g),
            cap(k.elbow_l, vec3(0.0), vec3(-0.25, 0.0, 0.005), 0.047 * g),
            cap(k.wrist_r, vec3(0.04, 0.0, 0.004), vec3(0.08, 0.0, 0.004), 0.05 * g),
            cap(k.wrist_l, vec3(-0.04, 0.0, 0.004), vec3(-0.08, 0.0, 0.004), 0.05 * g),
            cap(k.hip_r, vec3(0.0), vec3(0.006, -0.44, 0.022), 0.09 * g),
            cap(k.hip_l, vec3(0.0), vec3(-0.006, -0.44, 0.022), 0.09 * g),
            cap(k.knee_r, vec3(0.0), vec3(0.0, -0.425, -0.045), 0.056 * g),
            cap(k.knee_l, vec3(0.0), vec3(0.0, -0.425, -0.045), 0.056 * g),
        ],
    )
}
