// The duel's arena as the frame draws it (`engine::frame::Scene`), the yard's (lookdev/ink-yard)
// grown for a fight: a flat floor, a bowl of ragged rock walls climbing round it (`walls`), cratered where the brawler lands (`Mounds::crater`); nine
// tall standing stones in a ring round it (realized a frame
// each at load, then static casters); the two fighters, cast into the moving shadow map; the dust
// a landing throws up; and the bars over the finished frame (`hud`).

use engine::air::{Air, hazy}
use engine::character::{ByChannels, Cast, PartOf}
use engine::frame::{Cooks, Scene, full}
use hud::{Hud, hud}
use engine::particles::{Burst, Emits, burst}
use engine::light::{Light, SUN_TOP}
use engine::lit::Lighting
use engine::plant::Wind
use engine::probes::{Occluder, ProbeGrid, Trace, grid}
use engine::shadow::{CASTER, Shadows}
use engine::sky::{Gap, Weather}
use engine::stone::{Realized, realize_stone, stone_shade, stone_shadow, stone_vertex}
use engine::style::Style
use engine::switches::Switches
use engine::terrain::{Clipmap, Cover, Terrain}
use engine::vegetation::nothing
use engine::view::{Camera, NEAREST}
use body::{Figure, Paint}
use std::gpu::{Cull, R32Uint, RenderPass, Sampler, ScreenPass, Texture, draw}

/// The sun: about 50° up in the south-west, low enough that a stone's sides turn clearly to it or
/// away (a high sun grazes them, and their lumps break into blotches of light and shade), high
/// enough that a stone's shadow ends before the bowl's wall. A fighter it would backlight is lit
/// by the look's key light instead (`Style::CEL_KEY`).
pub const SUN = vec3(-0.45, 0.72, -0.42)

/// The ring of stones: how many, how far out, how tall.
pub const STONES: u32 = 9
pub const RING: f32 = 12.0

/// The arena's ground: flat, walled (`walls`); packed earth, paler where it's
/// worn flat, darker on the slopes. And its crater, where a blow drove into it (`crater`: its
/// middle's x and z, its radius and its depth; 0 deep, none): a bowl with a rim thrown up round it.
pub struct Mounds: Copy + GpuData {
    pub crater: vec4 = vec4(0.0),
}

impl Terrain for Mounds {
    fn height(self, x: f32, z: f32) -> f32 {
        // (Low mounds round the floor rippled the walls' foot, each ripple's shade side a dark
        // blot behind every shot: the floor is flat and the walls rise smooth.)
        walls(x, z) + cratered(self.crater, vec2(x, z))
    }

    fn steepest(self) -> f32 {
        3.0
    }

    fn cover(self, at: vec3, n: vec3) -> Cover {
        let worn = 1.0 - smoothstep(9.0, 14.0, length(at.xz))
        let slope = 1.0 - saturate(n.y)
        let earth = mix(vec3(0.30, 0.24, 0.16), vec3(0.42, 0.36, 0.25), vec3(worn))
        // The walls' rock: grey over the earth, darker where steepest.
        let rock = mix(vec3(0.52, 0.48, 0.42), vec3(0.4, 0.37, 0.33), vec3(saturate(slope * 2.5)))
        let walled = smoothstep(WALL_FROM, WALL_FROM + 3.0, length(at.xz))
        Cover {
            albedo: mix(
                mix(earth, vec3(0.18, 0.16, 0.13), vec3(saturate(slope * 6.0))),
                rock,
                vec3(walled),
            ),
            grass: 0.0,
        }
    }
}

/// The bowl's walls at (`x`, `z`): rock rising `WALL` metres from about `WALL_FROM` to
/// `WALL_TO` from the middle, its edge ragged round the ring, so
/// every shot has a ground behind it and the arena's scale reads (an open plain read as nowhere).
/// Its rock pale, so its shade side reads as shade and not as a hole.
pub const WALL: f32 = 6.0
pub const WALL_FROM: f32 = 14.0
pub const WALL_TO: f32 = 27.0

pub fn walls(x: f32, z: f32) -> f32 {
    let r = length(vec2(x, z))
    let a = atan2(z, x)
    let ragged = 0.6 * sin(a * 5.0 + 0.7) + 0.35 * sin(a * 11.0 + 2.1)
    let w = smoothstep(WALL_FROM + 0.4 * ragged, WALL_TO + ragged, r)
    // (Steep, lobed walls turned stretches of themselves from the high sun, and the look's two
    // bands made each a black blot behind every shot: the walls rise gently and nearly round, so
    // the sun reaches all of them.)
    WALL * w
}

/// A crater's height at `p` (`Mounds::crater`): down `depth` at its middle, a bowl out to its
/// radius, a rim a quarter of its depth high just past it, nothing beyond.
pub fn cratered(c: vec4, p: vec2) -> f32 {
    if c.w <= 0.0 {
        return 0.0
    }
    let r = length(p - c.xy) / c.z
    let bowl = -c.w * (1.0 - smoothstep(0.0, 1.0, r * r))
    let rim = 0.25 * c.w * exp(-((r - 1.05) * (r - 1.05)) / 0.02)
    bowl + rim
}

/// The ground's height at a point of the world (x, z), cratered by `crater`.
pub fn ground_at(p: vec2, crater: vec4 = vec4(0.0)) -> f32 {
    Mounds { crater }.height(p.x, p.y)
}

/// Stone `k`'s place in the ring: its middle (a metre up, sunk well into the ground: higher, its
/// ellipsoid narrowed to a point at the ground and it read as perched), its turn, its seed.
fn stone_at(k: u32) -> (vec3, f32, u32) {
    let a = f32(k) / f32(STONES) * 6.2831853 + 0.3
    let r = RING + 1.2 * sin(f32(k) * 2.7)
    let p = vec2(sin(a), cos(a)) * r
    (vec3(p.x, ground_at(p) + 1.0, p.y), a * 1.7, 11 + k * 7)
}

/// How far along the line from `a` to `b` (0 to 1) it first passes behind a stone (within a
/// metre of its middle across the ground, below its top); 1 when nothing stands in the way. For
/// the camera: a stone is a black slab across the frame when it comes between the eye and the
/// fight.
pub fn stone_between(a: vec3, b: vec3) -> f32 {
    var first = 1.0
    for k in 0..STONES {
        let (at, _, _) = stone_at(k)
        let d = b.xz - a.xz
        let dd = max(dot(d, d), 1.0e-6)
        let u = clamp(dot(at.xz - a.xz, d) / dd, 0.0, 1.0)
        let p = mix(a, b, vec3(u))
        let top = at.y + 2.1
        if length(p.xz - at.xz) < 1.0 && p.y < top {
            // Back along the line to where it meets the metre round the stone.
            let back = sqrt(max(1.0 - length(p.xz - at.xz) * length(p.xz - at.xz), 0.0)) / sqrt(dd)
            first = min(first, max(u - back, 0.0))
        }
    }
    first
}

/// A blow's dust: ninety dark clods of the arena's earth thrown up from round where it lands, a few
/// metres and only a little out (a plume round the crater, not a fog), settling in under two
/// seconds.
pub const DUST = Burst {
    count: 90,
    spread: 1.0,
    lift: 0.1,
    life: vec2(0.6, 1.6),
    out: vec2(0.4, 2.5),
    up: vec2(2.0, 7.0),
    size: vec2(0.02, 0.06),
    colour: vec4(0.2, 0.16, 0.11, 0.95),
    drag: 2.2,
    grow: 0.15,
}

/// The arena: its stones as they're realized, its two fighters (the wanderer and the brawler) and
/// their parts, its ground (its crater), the dust thrown up this frame, the bars and whether
/// they're drawn, and its weather.
pub struct Arena {
    pub stones: Vec<Realized>,
    pub wanderer: Cast<Paint, Figure, ByChannels>,
    pub brawler: Cast<Paint, Figure, ByChannels>,
    pub parts: PartOf,
    pub ground: Mounds,
    pub dust: Vec<vec3>,
    pub hud: Hud,
    pub bars: bool,
    weather: Weather,
}

pub fn arena(
    wanderer: take Cast<Paint, Figure, ByChannels>,
    brawler: take Cast<Paint, Figure, ByChannels>,
    parts: PartOf,
) -> Arena {
    Arena {
        stones: Vec::new(),
        wanderer,
        brawler,
        parts,
        ground: Mounds {},
        dust: Vec::new(),
        hud: Hud {},
        bars: false,
        weather: Weather {
            clouds: Vec::new(),
            fair: 0.35,
            gap: Gap { a: vec2(3300.0, -590.0), b: vec2(12200.0, -2150.0), radius: 2500.0 },
            wind: vec2(-5.5, 3.0),
        },
    }
}

/// The arena's air: a hazy evening's, its eye at a person's height.
pub fn air_of(sun: vec3) -> Air {
    hazy(normalize(sun), SUN_TOP, eye: 1.7)
}

impl Scene for Arena {
    fn wind(self, cam: Camera, time: f32) -> Wind {
        Wind { time, dir: vec2(1.0, 0.0), strength: 0.3 }
    }

    fn weather(self) -> Weather {
        self.weather.clone()
    }

    fn trace(self, light: Light, grid: ProbeGrid) -> Trace {
        Trace { light, grid, foliage: vec3(0.0), reach: 24.0, leaf: vec3(0.0), bounced: 0 }
    }

    fn probe_grid(self, at: vec2, origin: vec3) -> ProbeGrid {
        grid(at, cols: 17, spacing: 2.5, low: -4.0, high: 12.0, voxel: 1.0)
    }

    fn occluders(self, at: vec2, origin: vec3) -> Option<Vec<Occluder>> {
        Some(Vec::new())
    }

    fn height_at(self, world: vec2) -> f32 {
        self.ground.height(world.x, world.y)
    }

    fn cook_ground(mut self, clipmap: mut Clipmap, eye: vec3, again: bool) -> u32 {
        clipmap.follow(self.ground, eye, again)
    }

    /// The bars, over the finished frame.
    fn overlay(self, pass: ScreenPass, out: vec2) {
        if self.bars {
            draw(pass, full.bind(z: 0.5), hud.bind(h: self.hud), vertices: 3)
        }
    }

    /// The dust a blow threw up this frame.
    fn emit(mut self, e: mut Emits) {
        for k in 0..self.dust.len() {
            burst(mut e, DUST, self.dust[k], seed: 4001 + k)
        }
        self.dust.clear()
    }

    /// A stone realized a step until the ring is whole; each fitted to its mesh once its counts
    /// have come.
    fn cook(mut self, c: mut Cooks, clipmap: mut Clipmap, linear: Sampler) {
        if self.stones.len() < STONES {
            let (at, turn, seed) = stone_at(self.stones.len())
            self.stones.push(realize_stone(1.0, vec3(0.75, 2.1, 0.65), seed, at, turn))
        }
        for mut st in self.stones {
            st.settle()
        }
    }

    fn casters_complete(self) -> bool {
        self.stones.len() == STONES
    }

    fn casters_ready(self, far: bool) -> bool {
        self.stones.len() == STONES
    }

    fn ground_casts(self) -> bool {
        true
    }

    /// The stones into a cascade's first strip (they're solids: once).
    fn cast<P: RenderPass>(
        self,
        pass: P,
        view: mat4,
        sh: Shadows,
        wind: Wind,
        s: Sampler,
        first: bool,
    ) {
        if !first {
            return
        }
        for st in self.stones {
            draw(
                pass,
                stone_shadow.bind(verts: st.mesh.verts.items(), at: st.at, view: view),
                nothing,
                indices: st.mesh.quads.items(),
                indirect: st.mesh.draw.items(),
                depth_bias: CASTER,
            )
        }
    }

    fn cast_moving<P: RenderPass>(self, pass: P, view: mat4) {
        self.wanderer.shadow(pass, view)
        self.brawler.shadow(pass, view)
    }

    fn casts_moving(self) -> bool {
        self.wanderer.on || self.brawler.on
    }

    fn shade<P: RenderPass, Q: Switches, Y: Style>(
        self,
        pass: P,
        lt: Lighting<Q, Y>,
        wind: Wind,
        ids: Texture<R32Uint>,
    ) {
        for st in self.stones {
            draw(
                pass,
                stone_vertex.bind(
                    verts: st.mesh.verts.items(),
                    colours: st.colours.items(),
                    at: st.at,
                    seed: st.seed,
                    cam: lt.cam,
                ),
                stone_shade.bind(lt),
                indices: st.mesh.quads.items(),
                indirect: st.mesh.draw.items(),
                cull: Cull::Back,
                depth: NEAREST,
            )
        }
    }

    fn characters<P: RenderPass, Q: Switches, Y: Style>(self, pass: P, lt: Lighting<Q, Y>) {
        self.wanderer.draw(pass, lt, lt.cam, self.parts)
        self.brawler.draw(pass, lt, lt.cam, self.parts)
    }

    fn motion<P: RenderPass>(mut self, pass: P, cam: Camera, wind: Wind) {
        self.wanderer.motion(pass, cam)
        self.brawler.motion(pass, cam)
    }
}
