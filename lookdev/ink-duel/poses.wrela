    shrug: vec2(0.45, 0.0),
    upper_r: vec3(-0.05, 0.98, 0.15),
    fore_r: vec3(0.0, 1.0, -0.05),
    reach: vec2(1.1, 1.0),
    upper_l: vec3(-0.4, -0.7, -0.6),
    fore_l: vec3(0.0, -0.3, 0.95),
    foot_r: vec3(0.15, 0.45, -0.45),
    foot_l: vec3(-0.12, 0.6, 0.15),
    heel: vec2(0.9, 0.5),
    toe_out: vec2(0.1, 0.1),
    free: vec2(1.0, 1.0),
}

/// Taken by the uppercut: the head snapped back, the chest arched, the arms flung out, the knees
/// gone.
pub const TAKEN = Pose {
    lift: vec3(0.0, -0.05, -0.1),
    hips: vec3(-0.2, 0.0, 0.0),
    waist: vec3(-0.15, 0.0, 0.0),
    chest: vec3(-0.4, 0.0, 0.0),
