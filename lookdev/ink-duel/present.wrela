// What each fighter looks like this frame, from the sim's numbers (`duel::World`): its pose (a
// move's beats down the body's chain, a dodge's crouch leaning the way it goes, a stagger, a
// broken posture swaying, the riposte; the brawler taken, flung, down and getting up) and where
// its body stands in the world (on the ground, or tumbling through the air, or laid on its back).
// None of it feeds back: the sim decided every blow before any of this is drawn.

use body::BRAWLER
use duel::{LIES, NEVER, RISES, World}
use engine::combat::{Act, Fighter, HZ}
use engine::clip::{HOLD, SMOOTH, SNAP}
use engine::combat::Move
use mocap::cmu
use moves::{BRAWLER_MOVES, CONTACT, WANDERER_MOVES, brawler_beats, riposte_beats, wanderer_beats}
use std::string::Bytes
use pose::{Beat, Pose, chained, mixed, sampled}
use poses::{BROKEN, DODGE, DOWN, FLUNG, GUARD, KNEEL, STRUCK, TAKEN}
use std::quat::Quat
use std::transform::{rotate_y, translate}

/// How far behind the hips each link of the body's chain arrives (s): about a tick.
pub const LAG: f32 = 0.014

/// How long after the riposte's contact the brawler's head snaps back (ticks): after its first
/// impact frames, which show the fist meeting the jaw where it hung.
pub const SNAP_AFTER: u32 = 3

/// How fast the flung brawler tumbles (radians a second, about its own left-right axis).
pub const TUMBLE: f32 = -7.0

/// Where each captured move's beats fall in its clip (content/mocap/cmu/LICENSE.txt says which
/// frames of which trial each clip is): the jab and the cross of subject 14's one-two; subject
/// 13's rear hook; subject 14's lunging cross and its duck.
pub const JAB_MARKS = Marks { start: 5.0, contact: 17.0, end: 30.0 }
pub const CROSS_MARKS = Marks { start: 30.0, contact: 41.0, end: 64.0 }
pub const HOOK_MARKS = Marks { start: 10.0, contact: 30.0, end: 50.0 }
pub const LUNGE_MARKS = Marks { start: 4.0, contact: 28.0, end: 52.0 }
pub const DUCK_MARKS = Marks { start: 0.0, contact: 15.0, end: 33.0 }

/// Every move's beats, made once.
pub struct Clips: Clone {
    pub wanderer: Vec<Vec<Beat>>,
    pub brawler: Vec<Vec<Beat>>,
    pub riposte: Vec<Beat>,
    pub dodge: Vec<Beat>,
    /// The captured motion (content/mocap, retargeted: `retarget`): the guard, each fighter's
    /// moves (none where a move is still keyed: the sweep), the duck a dodge plays, and the fall
    /// onto the face a fighter dies in.
    pub guard: Vec<Pose>,
    pub w_caps: Vec<Captured>,
    pub b_caps: Vec<Captured>,
    pub duck: Captured,
    pub fall: Vec<Pose>,
}

/// A captured move: its poses (60 a second) and the frames that mark it (`Marks`).
pub struct Captured: Clone {
    pub poses: Vec<Pose>,
    pub marks: Marks,
}

/// Where a captured move's beats fall in its clip (its frames, 60 a second): where it starts
/// from guard, where it's chambered (a held blow's hold: none, -1), where its fist meets its
/// target, and where it's back on guard. A move's ticks are fitted to them (`warped`), so the
/// rules' timing is kept and the performer's motion fills it.
pub struct Marks: Copy {
    pub start: f32,
    pub hold: f32 = -1.0,
    pub contact: f32,
    pub end: f32,
}

/// The frame of a captured move's clip for its tick `t` (`m`'s marks, the rules' move `mv`): its
/// wind-up from start to contact (through the hold: reached in its first third, held until its
/// last eighth), its hitting ticks just past contact, its recovery back to guard.
pub fn warped(m: Marks, mv: Move, t: f32) -> f32 {
    let w = f32(mv.windup)
    let a = f32(mv.active)
    let r = f32(mv.recovery)
    if t < w {
        let u = t / max(w, 1.0)
        if m.hold >= 0.0 {
            if u < 0.33 {
                return mix(m.start, m.hold, smoothstep(0.0, 0.33, u))
            }
            if u < 0.875 {
                return m.hold
            }
            return mix(m.hold, m.contact, (u - 0.875) / 0.125)
        }
        return mix(m.start, m.contact, u)
    }
    let past = m.contact + min(a, 3.0)
    if t < w + a {
        return mix(m.contact, past, (t - w) / max(a, 1.0))
    }
    mix(past, m.end, clamp((t - w - a) / max(r, 1.0), 0.0, 1.0))
}

/// A captured clip at frame `f` (60 a second), between the frames either side.
pub fn frame_of(ps: [Pose], f: f32) -> Pose {
    retarget::played(ps, 60.0, f / 60.0)
}

/// The captured guard at time `time` (s), looped, its seam crossfaded over its last eighth.
pub fn guard_at(ps: [Pose], time: f32) -> Pose {
    let n = f32(ps.len() - 1)
    let fade = n * 0.125
    let f = time * 60.0 - floor(time * 60.0 / (n - fade)) * (n - fade)
    if f < fade {
        // The loop's start, faded in from its end.
        return mixed(frame_of(ps, n - fade + f), frame_of(ps, f), f / fade)
    }
    frame_of(ps, f)
}

/// Loads the captures and retargets them.
fn captured(asf: Bytes, amc: Bytes, marks: Marks) -> Captured {
    let c = retarget::capture(asf, amc, hz: 60.0, every: 1)
    Captured { poses: retarget::poses_of(c, 0, c.frames.len()), marks }
}

fn none() -> Captured {
    Captured { poses: Vec::new(), marks: Marks { start: 0.0, contact: 0.0, end: 0.0 } }
}

fn at(ticks: f32, pose: Pose, ease: u32) -> Beat {
    Beat { at: ticks / 60.0, pose, ease }
}

pub fn clips() -> Clips {
    var w: Vec<Vec<Beat>> = Vec::new()
    for n in 0..3 {
        w.push(wanderer_beats(n))
    }
    var b: Vec<Vec<Beat>> = Vec::new()
    for n in 0..5 {
        b.push(brawler_beats(n))
    }
    Clips {
        wanderer: w,
        brawler: b,
        riposte: riposte_beats(),
        dodge: Vec::from(
            [
                at(0.0, GUARD, SNAP),
                at(4.0, DODGE, HOLD),
                at(19.0, DODGE, SMOOTH),
                at(32.0, GUARD, SMOOTH),
            ],
        ),
        guard: captured(cmu::BOXER, cmu::GUARD, Marks { start: 0.0, contact: 0.0, end: 0.0 }).poses,
        w_caps: Vec::from(
            [
                captured(cmu::BOXER, cmu::JAB_CROSS, JAB_MARKS),
                captured(cmu::BOXER, cmu::JAB_CROSS, CROSS_MARKS),
                captured(cmu::HOOKER, cmu::HOOK, HOOK_MARKS),
            ],
        ),
        b_caps: Vec::from(
            [
                captured(cmu::BOXER, cmu::JAB_CROSS, JAB_MARKS),
                captured(cmu::BOXER, cmu::JAB_CROSS, CROSS_MARKS),
                captured(cmu::HOOKER, cmu::HOOK, Marks { hold: 22.0, ..HOOK_MARKS }),
                captured(cmu::BOXER, cmu::LUNGE, LUNGE_MARKS),
                none(),
            ],
        ),
        duck: captured(cmu::BOXER, cmu::DUCK, DUCK_MARKS),
        fall: captured(
            cmu::FALLER,
            cmu::FALL_FACE,
            Marks { start: 0.0, contact: 0.0, end: 0.0 },
        ).poses,
    }
}

/// Where a body is put and how it lies: its root on the ground (or in the air), its heading, and
/// how far it's turned over (radians about its own left-right axis: 0 upright, -π/2 on its back),
/// about a pivot this high (m).
pub struct Placing: Copy {
    pub at: vec3,
    pub heading: f32,
    pub over: f32 = 0.0,
    pub pivot: f32 = 0.0,
}

/// A placing as the matrix its skeleton is posed under.
pub fn placing_matrix(p: Placing) -> mat4 {
    let up = vec3(0.0, p.pivot, 0.0)
    let r = Quat::axis_angle(vec3(1.0, 0.0, 0.0), p.over).to_mat3()
    let over = mat4(vec4(r[0], 0.0), vec4(r[1], 0.0), vec4(r[2], 0.0), vec4(0.0, 0.0, 0.0, 1.0))
    translate(p.at + up) * rotate_y(p.heading) * over * translate(-up)
}

/// A move's time (s) from its tick count.
fn secs(t: u32) -> f32 {
    f32(t) / HZ
}

/// A fighter's pose when it's doing what the rules run (ready, a move, a dodge, staggered,
/// broken), its moves' beats `moves`, bouncing on guard `bounce` times a second.
fn fighting(
    f: Fighter,
    moves: [Vec<Beat>],
    caps: [Captured],
    rules: [Move],
    c: Clips,
    time: f32,
    bounce: f32,
) -> Pose {
    let t = secs(f.t)
    match f.act {
        Act::Attack => {
            if caps[f.move].poses.is_empty() {
                chained(moves[f.move], t, LAG)
            } else {
                borrow k = caps[f.move]
                frame_of(k.poses, warped(k.marks, rules[f.move], f32(f.t)))
            }
        },
        Act::Dodge => {
            let d = c.duck.marks
            var p = frame_of(c.duck.poses, mix(d.start, d.end, clamp(t * 60.0 / 32.0, 0.0, 1.0)))
            // Leaning the way it goes, in its own frame.
            let s = sin(f.heading)
            let k = cos(f.heading)
            let local = vec2(f.way.x * k - f.way.y * s, f.way.x * s + f.way.y * k)
            let w = 1.0 - smoothstep(0.2, 0.5, t)
            p.hips = p.hips + vec3(0.35 * local.y, 0.0, -0.4 * local.x) * w
            p.chest = p.chest + vec3(0.2 * local.y, 0.0, -0.25 * local.x) * w
            p
        },
        Act::Staggered => {
            let length = secs(f.move)
            let beats = [
                Beat { at: 0.0, pose: GUARD, ease: SNAP },
                Beat { at: 0.05, pose: STRUCK, ease: HOLD },
                Beat { at: 0.05 + length * 0.3, pose: STRUCK, ease: SMOOTH },
                Beat { at: length, pose: GUARD, ease: SMOOTH },
            ]
            sampled(beats, t)
        },
        Act::Broken => {
            let beats = [
                Beat { at: 0.0, pose: STRUCK, ease: SNAP },
                Beat { at: 0.25, pose: BROKEN, ease: SMOOTH },
            ]
            var p = sampled(beats, t)
            // Swaying where it stands, dazed.
            let sway = sin(time * 2.3) * 0.12
            p.hips = p.hips + vec3(0.0, sway * 0.5, sway)
            p.head = p.head + vec3(0.1 * sin(time * 1.7), sway * 2.0, 0.0)
            p
        },
        _ => {
            // On guard: the captured guard, bouncing, looped (a lighter fighter's quicker,
            // `bounce` against the performer's own 1.7 a second); each fighter a little out of
            // step with the other.
            guard_at(c.guard, time * bounce / 1.7 + bounce * 3.1)
        },
    }
}

/// The wanderer this frame: its pose and placing (`dead_for`: how long it's been dead, s).
pub fn wanderer(w: World, c: Clips, ground: f32, time: f32, dead_for: f32) -> (Pose, Placing) {
    let f = w.you
    let place = Placing { at: vec3(f.pos.x, ground, f.pos.y), heading: f.heading }
    match f.act {
        Act::Riposte => (chained(c.riposte, secs(f.t), LAG), place),
        Act::Dead => (frame_of(c.fall, dead_for * 60.0), place),
        _ => (fighting(f, c.wanderer, c.w_caps, WANDERER_MOVES, c, time, bounce: 1.7), place),
    }
}

/// The brawler this frame: fighting; or taken by the riposte (broken until the blow lands,
/// snapped back until the launch, flung and tumbling, laid out where it landed, getting up).
pub fn brawler(w: World, c: Clips, ground: f32, time: f32, dead_for: f32) -> (Pose, Placing) {
    let f = w.foe
    let tall = BRAWLER.tall
    let place = Placing { at: vec3(f.pos.x, ground, f.pos.y), heading: f.heading }
    let lying = Placing { over: -1.5707964, pivot: 0.13 * tall, ..place }
    if f.act == Act::Dead {
        // Laid out where the riposte threw it; or, felled by a blow, falling onto its face.
        if w.landed != NEVER {
            return (DOWN, lying)
        }
        return (frame_of(c.fall, dead_for * 60.0), place)
    }
    if f.act != Act::Taken {
        return (fighting(f, c.brawler, c.b_caps, BRAWLER_MOVES, c, time, bounce: 1.1), place)
    }
    if w.launch == NEVER {
        // The riposte's coil, then the blow.
        // Broken and swaying until the blow, then snapped back by it.
        // (The impact frames show the fist under the slumped jaw; the snap comes after them.)
        let hit = w.you.act == Act::Riposte &&
            w.contact != NEVER &&
            w.tick - w.contact >= SNAP_AFTER
        if hit {
            return (TAKEN, place)
        }
        var p = BROKEN
        let sway = sin(time * 2.3) * 0.12
        p.hips = p.hips + vec3(0.0, sway * 0.5, sway)
        p.head = p.head + vec3(0.1 * sin(time * 1.7), sway * 2.0, 0.0)
        return (p, place)
    }
    if w.landed == NEVER {
        let t = f32(w.tick - w.launch) / HZ
        let p = mixed(TAKEN, FLUNG, smoothstep(0.0, 0.15, t))
        return (
            p,
            Placing {
                at: vec3(f.pos.x, ground + w.air, f.pos.y),
                heading: f.heading,
                over: TUMBLE * t,
                pivot: 1.0 * tall,
            },
        )
    }
    let since = f32(w.tick - w.landed) / HZ
    let lie = f32(LIES) / HZ
    let rise = f32(RISES) / HZ
    if since < lie {
        // Slammed down, a bounce, then still.
        let bounce = 0.25 * max(0.0, sin(since * 9.0)) * exp(-since * 5.0)
        return (DOWN, Placing { at: lying.at + vec3(0.0, bounce, 0.0), ..lying })
    }
    // Getting up: turned upright over the first half, through the kneel to the guard.
    let u = clamp((since - lie) / rise, 0.0, 1.0)
    let p = if u < 0.5 { mixed(DOWN, KNEEL, smoothstep(0.0, 0.5, u)) } else {
        mixed(KNEEL, GUARD, smoothstep(0.5, 1.0, u))
    }
    let over = -1.5707964 * (1.0 - smoothstep(0.0, 0.5, u))
    (p, Placing { over, pivot: 0.13 * tall, ..place })
}

/// What the pose sheet shows (`main`'s `SHEET`): fighter `who` (0 the wanderer, 1 the brawler) in
/// slot `slot`, `u` seconds into it: its guard; then each of its moves; then (the wanderer) a dodge
/// and the riposte, (the brawler) broken.
pub fn sheet_pose(who: u32, slot: u32, u: f32, c: Clips, time: f32) -> Pose {
    let base = Fighter { pos: vec2(0.0), heading: 0.0, health: 1.0, stamina: 1.0, t: u32(u * 60.0) }
    if who == 0 {
        if slot == 0 {
            return fighting(base, c.wanderer, c.w_caps, WANDERER_MOVES, c, time, bounce: 1.7)
        }
        if slot <= 3 {
            return fighting(
                Fighter { act: Act::Attack, move: slot - 1, ..base },
                c.wanderer,
                c.w_caps,
                WANDERER_MOVES,
                c,
                time,
                bounce: 1.7,
            )
        }
        if slot == 4 {
            return fighting(
                Fighter { act: Act::Dodge, way: vec2(1.0, 0.0), ..base },
                c.wanderer,
                c.w_caps,
                WANDERER_MOVES,
                c,
                time,
                bounce: 1.7,
            )
        }
        if slot == 5 {
            return chained(c.riposte, u, LAG)
        }
        return frame_of(c.fall, u * 60.0)
    }
    if slot == 0 {
        return fighting(base, c.brawler, c.b_caps, BRAWLER_MOVES, c, time, bounce: 1.1)
    }
    if slot <= 5 {
        return fighting(
            Fighter { act: Act::Attack, move: slot - 1, ..base },
            c.brawler,
            c.b_caps,
            BRAWLER_MOVES,
            c,
            time,
            bounce: 1.1,
        )
    }
    fighting(
        Fighter { act: Act::Broken, ..base },
        c.brawler,
        c.b_caps,
        BRAWLER_MOVES,
        c,
        time,
        bounce: 1.1,
    )
}
