pub const COIL = Shape {
    pelvis: Quat { v: vec4(0.0, 0.3420, 0.0, 0.9397) },
    shift: vec3(0.0, -0.36, -0.08),
    chest: Quat { v: vec4(0.2156, 0.0851, 0.0189, 0.9726) },
    upper_a: vec3(0.35, -0.8, -0.45),
    fore_a: vec3(0.1, 0.15, 1.0),
    upper_b: vec3(-0.25, -0.2, 0.95),
    fore_b: vec3(0.3, 0.85, 0.4),
    thigh_a: vec3(0.12, -0.45, -0.65),
    shin_a: vec3(0.0, -0.9, -0.45),
    thigh_b: vec3(-0.1, -0.5, 0.85),
    shin_b: vec3(0.0, -0.98, -0.2),
}

