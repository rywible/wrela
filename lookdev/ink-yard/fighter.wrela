/// The flung: arched back over its own momentum, its limbs trailing behind the flight.
pub const FLUNG = Shape {
    pelvis: Quat { v: vec4(-0.1736, 0.0, 0.0, 0.9848) },
    chest: Quat { v: vec4(-0.3827, 0.0, 0.0, 0.9239) },
    head: Quat { v: vec4(-0.4226, 0.0, 0.0, 0.9063) },
    upper_a: vec3(0.45, -0.5, -0.75),
    fore_a: vec3(0.3, -0.6, -0.75),
    upper_b: vec3(-0.45, -0.5, -0.75),
    fore_b: vec3(-0.3, -0.6, -0.75),
    thigh_a: vec3(0.1, -0.85, -0.5),
    shin_a: vec3(0.0, -0.6, -0.8),
    thigh_b: vec3(-0.1, -0.9, -0.4),
    shin_b: vec3(0.0, -0.55, -0.85),
}

/// The uppercut's times (seconds into it, the program's stop aside): the coil's depth, the held
/// stillness's end, the blow's arrival (the stop begins there), the struck one's launch (a beat
/// after the stop), the follow-through's height, and the end, back on guard.
pub const COILED: f32 = 0.55
pub const STILL: f32 = 0.9
pub const CONTACT: f32 = 0.98
pub const LAUNCH: f32 = 1.16
pub const OVER: f32 = 1.3
pub const HELD: f32 = 2.6
pub const UPPERCUT: f32 = 3.3

/// Shape `s`'s keys at time `at`, each going on as `ease` says: a clip's tracks for every bone a
/// shape sets.
fn keyed(tracks: mut Vec<Track>, b: Bones, at: f32, s: Shape, ease: u32) {
    let l = locals(s, b)
    let bones = [
        b.pelvis,
        b.chest,
        b.head,
        b.shoulder_a,
        b.elbow_a,
        b.shoulder_b,
        b.elbow_b,
        b.hip_a,
        b.knee_a,
        b.hip_b,
        b.knee_b,
    ]
    for k in 0..bones.len() {
        let pose = l[bones[k].index]
        if tracks.len() <= k {
            tracks.push(Track { bone: bones[k], keys: Vec::new() })
        }
        tracks[k].keys.push(Key { at, pose, ease })
    }
}

/// The guard, a clip of one pose.
pub fn guard(b: Bones) -> Clip {
    var tracks: Vec<Track> = Vec::new()
    keyed(mut tracks, b, 0.0, GUARD, SMOOTH)
    Clip { length: 1.0, looped: true, tracks }
}

/// The striker's uppercut: guard; down into the coil, slowly; dead still; the snap up into the
/// blow (most of it at once); on up into the follow-through; held high; back on guard.
pub fn uppercut(b: Bones) -> Clip {
    var tracks: Vec<Track> = Vec::new()
    keyed(mut tracks, b, 0.0, GUARD, SMOOTH)
    keyed(mut tracks, b, COILED, COIL, HOLD)
    keyed(mut tracks, b, STILL, COIL, SNAP)
    keyed(mut tracks, b, CONTACT, BLOW, SNAP)
    keyed(mut tracks, b, OVER, OVERHEAD, HOLD)
    keyed(mut tracks, b, HELD, OVERHEAD, SMOOTH)
    keyed(mut tracks, b, UPPERCUT, GUARD, SMOOTH)
    Clip { length: UPPERCUT, looped: false, tracks }
}

/// The struck one's: guard until the blow, then snapped into the struck shape at once, held there
/// a beat after the stop, then flung (its flight `main.wrela`'s).
pub fn struck(b: Bones) -> Clip {
    var tracks: Vec<Track> = Vec::new()
    keyed(mut tracks, b, 0.0, GUARD, HOLD)
    keyed(mut tracks, b, CONTACT, STRUCK_SHAPE, HOLD)
    keyed(mut tracks, b, LAUNCH, STRUCK_SHAPE, SNAP)
    keyed(mut tracks, b, LAUNCH + 0.12, FLUNG, HOLD)
    Clip { length: UPPERCUT, looped: false, tracks }
}
