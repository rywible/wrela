// The yard's fighters: two of round cones on a humanoid skeleton (bodies the MMO's characters
// will outgrow, enough to judge a look's ink on a figure and its motion's force), and their clips,
// hand keyed (`engine::clip`): the uppercut. The striker coils low and deep, holds dead still a
// beat, then rises through the blow in a jump, its fist driving up through the other's jaw; the
// one it strikes is snapped back, held there a beat too long (the blow's delay), then flung into
// the sky (`main.wrela` throws it). Thomas and Johnston 1981's anticipation, squash and stretch,
// follow-through and timing, and an anime fight's held tension before release.
//
// The poses are written as where each limb points in the body's frame (`Shape`), turned into
// each bone's turn against its parent's (`aimed`), so a pose is its silhouette, not a guess at
// joint angles.

use engine::character::{ByChannels, Shaded}
use engine::clip::{Clip, HOLD, Key, Local, SMOOTH, SNAP, Track, key, rest}
use engine::creature::{Body, Bone, Placed, Skeleton, Then, creature}
use engine::gait::turn
use std::field::{Blend, RoundCone, Surface, With, round_cone}
use std::quat::Quat

/// A part's paint: its albedo, as the character's look reads it (`ByChannels`).
pub struct Paint: Copy + Blend + GpuData {
    pub albedo: vec3,
}

impl Shaded for Paint {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        0.7
    }
}

/// A part: a round cone with its paint, on a bone.
pub type Part = Placed<With<RoundCone, Paint>>

/// The fighter's body: its sixteen parts, in the order `fighter` joins them.
pub type Fighter = Body<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Then<Part, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>, Part>>

/// Their colours: the striker's dark coat and red sash, the struck one's pale coat and blue sash,
/// and skin.
pub const COAT = vec3(0.20, 0.22, 0.30)
pub const SASH = vec3(0.55, 0.08, 0.05)
pub const PALE = vec3(0.62, 0.58, 0.50)
pub const BLUE = vec3(0.10, 0.20, 0.45)
pub const SKIN = vec3(0.62, 0.42, 0.30)

/// Its bones, by name: its root (the pelvis), spine, chest, neck, head; each arm's shoulder,
/// elbow and hand; each leg's hip, knee and ankle (a = its right, at +x).
pub struct Bones: Copy {
    pub pelvis: Bone,
    pub spine: Bone,
    pub chest: Bone,
    pub neck: Bone,
    pub head: Bone,
    pub shoulder_a: Bone,
    pub elbow_a: Bone,
    pub hand_a: Bone,
    pub shoulder_b: Bone,
    pub elbow_b: Bone,
    pub hand_b: Bone,
    pub hip_a: Bone,
    pub knee_a: Bone,
    pub ankle_a: Bone,
    pub hip_b: Bone,
    pub knee_b: Bone,
    pub ankle_b: Bone,
}

/// Its skeleton, 1.8 m tall, standing at the origin facing +z, its arms out level (its rest).
pub fn skeleton() -> (Skeleton, Bones) {
    var s = Skeleton::new()
    let pelvis = s.root("pelvis", vec3(0.0, 1.0, 0.0))
    let spine = s.joint("spine", pelvis, vec3(0.0, 1.2, 0.0))
    let chest = s.joint("chest", spine, vec3(0.0, 1.42, 0.0))
    let neck = s.joint("neck", chest, vec3(0.0, 1.58, 0.0))
    let head = s.joint("head", neck, vec3(0.0, 1.66, 0.0))
    let shoulder_a = s.joint("shoulder_a", chest, vec3(0.2, 1.5, 0.0))
    let elbow_a = s.joint("elbow_a", shoulder_a, vec3(0.48, 1.5, 0.0))
    let hand_a = s.joint("hand_a", elbow_a, vec3(0.74, 1.5, 0.0))
    let shoulder_b = s.joint("shoulder_b", chest, vec3(-0.2, 1.5, 0.0))
    let elbow_b = s.joint("elbow_b", shoulder_b, vec3(-0.48, 1.5, 0.0))
    let hand_b = s.joint("hand_b", elbow_b, vec3(-0.74, 1.5, 0.0))
    let hip_a = s.joint("hip_a", pelvis, vec3(0.11, 0.97, 0.0))
    let knee_a = s.joint("knee_a", hip_a, vec3(0.12, 0.53, 0.02))
    let ankle_a = s.joint("ankle_a", knee_a, vec3(0.12, 0.09, 0.0))
    let hip_b = s.joint("hip_b", pelvis, vec3(-0.11, 0.97, 0.0))
    let knee_b = s.joint("knee_b", hip_b, vec3(-0.12, 0.53, 0.02))
    let ankle_b = s.joint("ankle_b", knee_b, vec3(-0.12, 0.09, 0.0))
    (
        s,
        Bones {
            pelvis,
            spine,
            chest,
            neck,
            head,
            shoulder_a,
            elbow_a,
            hand_a,
            shoulder_b,
            elbow_b,
            hand_b,
            hip_a,
            knee_a,
            ankle_a,
            hip_b,
            knee_b,
            ankle_b,
        },
    )
}

/// A round cone from `a` to `b` (its bone's space), `ra` and `rb` thick there, painted `c`.
fn cone(a: vec3, b: vec3, ra: f32, rb: f32, c: vec3) -> With<RoundCone, Paint> {
    round_cone(a, b, r_top: ra, r_bottom: rb).with(Paint { albedo: c })
}

/// A fighter in `coat` and `sash`: a coat over its hips and chest, a sash, its head, its limbs,
/// its fists.
pub fn fighter(coat: vec3, sash: vec3) -> (Fighter, Skeleton, Bones) {
    let (s, b) = skeleton()
    let body = creature(s)
        .part(
            b.pelvis,
            cone(vec3(0.0, -0.08, 0.0), vec3(0.0, 0.14, 0.0), ra: 0.19, rb: 0.16, c: coat),
        )
        .part(
            b.spine,
            cone(vec3(0.0, -0.06, 0.0), vec3(0.0, 0.04, 0.0), ra: 0.17, rb: 0.17, c: sash),
        )
        .part(
            b.chest,
            cone(vec3(0.0, -0.12, 0.01), vec3(0.0, 0.06, 0.0), ra: 0.18, rb: 0.21, c: coat),
        )
        .part(
            b.neck,
            cone(vec3(0.0, -0.02, 0.0), vec3(0.0, 0.06, 0.0), ra: 0.06, rb: 0.055, c: SKIN),
        )
        .part(b.head, cone(vec3(0.0, 0.08, 0.01), vec3(0.0, 0.17, 0.0), ra: 0.1, rb: 0.11, c: SKIN))
        .part(b.shoulder_a, cone(vec3(0.0), vec3(0.27, 0.0, 0.0), ra: 0.075, rb: 0.06, c: coat))
        .part(b.elbow_a, cone(vec3(0.0), vec3(0.24, 0.0, 0.0), ra: 0.055, rb: 0.045, c: SKIN))
        .part(
            b.hand_a,
            cone(vec3(0.02, 0.0, 0.0), vec3(0.09, 0.0, 0.0), ra: 0.06, rb: 0.055, c: SKIN),
        )
        .part(b.shoulder_b, cone(vec3(0.0), vec3(-0.27, 0.0, 0.0), ra: 0.075, rb: 0.06, c: coat))
        .part(b.elbow_b, cone(vec3(0.0), vec3(-0.24, 0.0, 0.0), ra: 0.055, rb: 0.045, c: SKIN))
        .part(
            b.hand_b,
            cone(vec3(-0.02, 0.0, 0.0), vec3(-0.09, 0.0, 0.0), ra: 0.06, rb: 0.055, c: SKIN),
        )
        .part(b.hip_a, cone(vec3(0.0), vec3(0.01, -0.44, 0.02), ra: 0.09, rb: 0.07, c: coat))
        .part(b.knee_a, cone(vec3(0.0), vec3(0.0, -0.44, -0.02), ra: 0.065, rb: 0.05, c: coat))
        .part(b.ankle_a, cone(vec3(0.0), vec3(0.0, -0.05, 0.16), ra: 0.05, rb: 0.04, c: sash))
        .part(b.hip_b, cone(vec3(0.0), vec3(-0.01, -0.44, 0.02), ra: 0.09, rb: 0.07, c: coat))
        .part(b.knee_b, cone(vec3(0.0), vec3(0.0, -0.44, -0.02), ra: 0.065, rb: 0.05, c: coat))
        .blend(0.04)
    (body, s, b)
}

const X = vec3(1.0, 0.0, 0.0)

/// A pose as its silhouette: the pelvis's turn and shift, the chest's and the head's turns (each
/// against its parent), and where each arm's upper and lower bones and each leg's thigh and shin
/// point, in the body's frame (+z ahead, +x its right, +y up), with each arm's stretch along its
/// length (1: none).
pub struct Shape: Copy {
    pub pelvis: Quat = Quat::identity(),
    pub shift: vec3 = vec3(0.0),
    pub chest: Quat = Quat::identity(),
    pub head: Quat = Quat::identity(),
    pub upper_a: vec3,
    pub fore_a: vec3,
    pub upper_b: vec3,
    pub fore_b: vec3,
    pub thigh_a: vec3,
    pub shin_a: vec3,
    pub thigh_b: vec3,
    pub shin_b: vec3,
    pub reach_a: f32 = 1.0,
}

/// The turn that points a bone whose rest runs along `rest` along `want` (the body's frame), under
/// a parent whose turns come to `above`.
fn aimed(above: Quat, rest: vec3, want: vec3) -> Quat {
    turn(normalize(rest), normalize(above.inverse().rotate(normalize(want))))
}

/// Shape `s` as each bone's pose (`engine::clip::Local`), for skeleton bones `b`.
pub fn locals(s: Shape, b: Bones) -> [Local; engine::creature::MAX_BONES] {
    var out = [rest(); engine::creature::MAX_BONES]
    let body = s.pelvis.mul(s.chest)
    out[b.pelvis.index] = Local { turn: s.pelvis, stretch: vec3(1.0), shift: s.shift }
    out[b.chest.index] = Local { turn: s.chest, stretch: vec3(1.0), shift: vec3(0.0) }
    out[b.head.index] = Local { turn: s.head, stretch: vec3(1.0), shift: vec3(0.0) }
    let sa = aimed(body, X, s.upper_a)
    let ea = aimed(body.mul(sa), X, s.fore_a)
    let sb = aimed(body, -X, s.upper_b)
    let eb = aimed(body.mul(sb), -X, s.fore_b)
    out[b.shoulder_a.index] = Local {
        turn: sa,
        stretch: vec3(s.reach_a, 1.0, 1.0),
        shift: vec3(0.0),
    }
    out[b.elbow_a.index] = Local { turn: ea, stretch: vec3(s.reach_a, 1.0, 1.0), shift: vec3(0.0) }
    out[b.shoulder_b.index] = Local { turn: sb, stretch: vec3(1.0), shift: vec3(0.0) }
    out[b.elbow_b.index] = Local { turn: eb, stretch: vec3(1.0), shift: vec3(0.0) }
    let down = vec3(0.0, -1.0, 0.0)
    let ha = aimed(s.pelvis, down, s.thigh_a)
    let ka = aimed(s.pelvis.mul(ha), down, s.shin_a)
    let hb = aimed(s.pelvis, down, s.thigh_b)
    let kb = aimed(s.pelvis.mul(hb), down, s.shin_b)
    out[b.hip_a.index] = Local { turn: ha, stretch: vec3(1.0), shift: vec3(0.0) }
    out[b.knee_a.index] = Local { turn: ka, stretch: vec3(1.0), shift: vec3(0.0) }
    out[b.hip_b.index] = Local { turn: hb, stretch: vec3(1.0), shift: vec3(0.0) }
    out[b.knee_b.index] = Local { turn: kb, stretch: vec3(1.0), shift: vec3(0.0) }
    out
}

/// The guard both stand in: weight low, fists up before the chin, the lead (left) foot ahead.
pub const GUARD = Shape {
    pelvis: Quat { v: vec4(0.0, 0.1305, 0.0, 0.9914) },
    shift: vec3(0.0, -0.07, 0.0),
    upper_a: vec3(0.2, -0.55, 0.8),
    fore_a: vec3(-0.25, 0.85, 0.45),
    upper_b: vec3(-0.2, -0.5, 0.85),
    fore_b: vec3(0.25, 0.85, 0.45),
    thigh_a: vec3(0.08, -0.95, -0.2),
    shin_a: vec3(0.0, -1.0, -0.15),
    thigh_b: vec3(-0.08, -0.93, 0.3),
    shin_b: vec3(0.0, -1.0, 0.05),
}

/// The coil: as low as it goes, turned away from the blow, the striking (right) fist dropped
