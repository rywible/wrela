    pelvis: Quat { v: vec4(0.0, -0.2164, 0.0, 0.9763) },
    shift: vec3(0.0, 0.05, 0.22),
    chest: Quat { v: vec4(-0.0692, -0.1302, 0.0091, 0.9890) },
    upper_a: vec3(0.0, 0.25, 0.97),
    fore_a: vec3(-0.35, 0.8, 0.5),
    upper_b: vec3(-0.3, -0.6, -0.65),
    fore_b: vec3(0.0, 0.3, 0.95),
    thigh_a: vec3(0.05, -0.75, -0.65),
    shin_a: vec3(0.0, -0.6, -0.8),
    thigh_b: vec3(-0.05, -0.98, 0.2),
    shin_b: vec3(0.0, -1.0, 0.0),
    reach_a: 1.2,
}

