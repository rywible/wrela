// The look's passes (#28 §7): the owner's pick, gouache and light for the world, cel for
// characters. They run after temporal AA, at the output's resolution, on its colour, the scene's
// depth and the tags.
//
// - The world: brush dabs anchored on its surfaces (spike 12's stroke cells: space cut into
//   cells in the surface's plane, each holding one stroke), moving the paint's value and hue a
//   little; stronger on broad areas (far ground, crowns, the sky, whose dabs are anchored to
//   directions) so the painted feel shows at a glance. A paper's tooth anchored in the world too
//   (Q6 of #51: a grain anchored to the screen is a shower door in motion).
// - Characters: their two bands are their shading's (`light::character`); here, thin lines in a
//   darker shade of their colour on their silhouettes and where their parts meet (from the
//   depth and the tags), and the world's dabs at half strength.
// - Bloom: the bright light, brought down to a quarter and blurred; then the tone curve.
//
// Every texture the look lays on is anchored in the world (AC1).

use light::{Light, tone}
use noise::{hash2, noise3}
use std::gpu::{
    DepthTexture, FragCoord, GlobalId, LocalId, One, Rgba16Float, Sampler, Shared, Slots, Texture,
    barrier,
}
use terrain::{Levels, Texel, ground_at, height_at}
use view::{CREATURE, Camera, FLOWER, GRASS, GROUND, class_of, jitter_of}

/// The look's settings: how strong the dabs are on near surfaces, on broad far ones and on the
/// sky; the paper's tooth; the bloom; the characters' lines (their width in output pixels, and
/// how dark); how much the edges sharpen; and the vignette.
pub struct Look: Copy + GpuData {
    pub dabs_near: f32 = 0.16,
    pub dabs_far: f32 = 0.30,
    pub dabs_sky: f32 = 0.10,
    pub dab_px: f32 = 18.0,
    pub tooth: f32 = 0.06,
    pub bloom: f32 = 0.18,
    pub line_px: f32 = 1.6,
    pub line_dark: f32 = 0.45,
    pub sharpen: f32 = 0.2,
    pub vignette: f32 = 0.28,
}

/// The strokes at `q` (in cells): the value of the one that covers it most, of the four cells
/// nearest it (a stroke reaches less than a cell from its centre's cell), in [-1, 1].
fn strokes(q: vec2) -> f32 {
    let c = floor(q - vec2(0.5))
    var best = 0.0
    var value = 0.0
    for j in 0..2 {
        for i in 0..2 {
            let cell = c + vec2(f32(i), f32(j))
            let (x, y) = (i32(cell.x), i32(cell.y))
            let centre = cell + vec2(0.25, 0.25) + 0.5 * vec2(hash2(x, y), hash2(y + 71, x + 13))
            let a = 0.5 + 0.6 * (hash2(x + 5, y + 9) - 0.5)
            let dir = vec2(cos(a), sin(a))
            let d = q - centre
            let along = dot(d, dir) / 0.62
            let across = dot(d, vec2(-dir.y, dir.x)) / 0.3
            let cover = 1.0 - (along * along + across * across)
            // Its edge about two output pixels wide, which a map at half the output's size
            // holds.
            let w = smoothstep(0.0, 0.6, cover) * (0.5 + hash2(x + 3, y + 1))
            if w > best {
                best = w
                value = hash2(x + 31, y + 17) * 2.0 - 1.0
            }
        }
    }
    value * smoothstep(0.0, 0.4, best)
}

/// Brush dabs on a surface at `world` whose normal is `n`, about `px` pixels long wherever
/// they're seen (a pixel `footprint` metres wide there): in [-1, 1]. Two sizes of cells, a
/// power of two apart, blended by distance (Bénard et al. 2009), so the dabs keep their size on
/// screen and stay on the surface.
pub fn dabs(world: vec3, n: vec3, footprint: f32, px: f32) -> f32 {
    let s = max(footprint * px, 1.0e-4)
    let l = log2(s)
    let f = fract(l)
    let s0 = exp2(floor(l))
    let t1 = normalize(cross(n, vec3(0.3, 0.2, 1.0)))
    let t2 = cross(n, t1)
    let q = vec2(dot(world, t1), dot(world, t2) + dot(world, n) * 0.5)
    mix(strokes(q / s0), strokes(q / (2.0 * s0) + vec2(17.0, 5.0)), f)
}

/// The paper's tooth at `world`, `footprint` metres a pixel: a fine grain, a few pixels across
/// wherever it's seen, anchored on the surface (two octaves blended by distance), about 0.
fn tooth(world: vec3, footprint: f32) -> f32 {
    let s = max(footprint * 2.5, 1.0e-4)
    let l = log2(s)
    let f = fract(l)
    let s0 = exp2(floor(l))
    mix(noise3(world / s0), noise3(world / (2.0 * s0) + vec3(9.0, 3.0, 5.0)), f) - 0.5
}

/// A quarter-resolution texel of the glow: the mean of the 4×4 texels under it of `image`'s
/// light above `threshold` (the light at the exposure `base`; so at the metered exposure,
/// `exposure`'s, it's scaled to the same brightness on the screen), each 2×2 of them read as
/// one filtered sample (its mean, then the threshold): four samples, not sixteen loads.
@fragment
pub fn glow_down(
    pixel: FragCoord,
    image: Texture<Rgba16Float>,
    s: Sampler,
    threshold: f32,
    base: f32,
    exposure: [Exposure],
) -> vec4 {
    let size = vec2(f32(image.width()), f32(image.height()))
    let t = threshold * base / max(exposure[0].value, 1.0e-3)
    let base = floor(pixel.position.xy) * 4.0
    var sum = vec3(0.0)
    for j in 0..2 {
        for i in 0..2 {
            let at = (base + vec2(f32(i), f32(j)) * 2.0 + vec2(1.0)) / size
            let c = image.sample_level(s, at).rgb
            sum += max(c - vec3(t), vec3(0.0))
        }
    }
    vec4(sum / 4.0, 1.0)
}

/// A 13-tap Gaussian blur along x (`across` 0) or y (1), `spread` texels a tap.
@fragment
pub fn glow_blur(pixel: FragCoord, src: Texture<Rgba16Float>, across: u32, spread: f32) -> vec4 {
    let p = vec2i(pixel.position.xy)
    let w = [0.1964, 0.1748, 0.1232, 0.0687, 0.0303, 0.0106, 0.0029]
    let (wi, hi) = (i32(src.width()) - 1, i32(src.height()) - 1)
    var s = src.load(x: u32(p.x), y: u32(p.y)).rgb * w[0]
    for k in 1..7 {
        let o = i32(round(f32(k) * spread))
        let d = select(if_false: vec2i(o, 0), if_true: vec2i(0, o), cond: across == 1)
        let a = clamp(p + d, vec2i(0), vec2i(wi, hi))
        let b = clamp(p - d, vec2i(0), vec2i(wi, hi))
        s += (src.load(x: u32(a.x), y: u32(a.y)).rgb + src.load(x: u32(b.x), y: u32(b.y)).rgb) *
            w[k]
    }
    vec4(s, 1.0)
}

// ---- metering -------------------------------------------------------------------------------

/// How the camera meters (the eye adapting): `base`, the exposure of a scene whose mean
/// luminance (geometric, over a 32 × 32 grid of its pixels) is `reference`, and for another
/// mean, `base` times (`reference` / mean) to the power `strength` (1 brings every scene to the
/// same mean, 0 doesn't meter), within `lo` to `hi`; reached a fraction `rate` of the way each
/// frame, or at once (`fresh` 1). A hazy sky toward a low sun is ten times the rest of it: a
/// fixed exposure shows it white.
pub struct Metering: Copy + GpuData {
    pub base: f32,
    pub reference: f32,
    pub strength: f32,
    pub lo: f32,
    pub hi: f32,
    pub rate: f32,
    pub fresh: u32,
}

/// The metered exposure (`meter`), and the scene's mean luminance (for tests).
pub struct Exposure: Copy + GpuData {
    pub value: f32,
    pub mean: f32,
}

/// The exposure, and the scene's mean luminance: one workgroup, each invocation four of the
/// grid's pixels, then their logs summed in workgroup memory.
@compute(256)
pub fn meter(
    scene: Texture<Rgba16Float>,
    m: Metering,
    sums: mut Shared<f32, 256>,
    exposure: mut One<Exposure>,
    id: GlobalId,
    lid: LocalId,
) {
    let size = vec2(f32(scene.width()), f32(scene.height()))
    var sum = 0.0
    for k in 0..4 {
        let i = lid.x + 256 * k
        let at = (vec2(f32(i % 32), f32(i / 32)) + vec2(0.5)) / 32.0 * size
        let c = scene.load(x: u32(at.x), y: u32(at.y)).rgb
        sum += log2(max(dot(c, vec3(0.2126, 0.7152, 0.0722)), 1.0e-4))
    }
    let mine = sums.chunk(lid)
    sums.write(mine, 0, sum)
    barrier(mut sums)
    // Halved eight times: each round, the first half's invocations add the second half's.
    for k in 0..8 {
        let half = 128 >> k
        let own = sums.get(lid.x)
        let v = if lid.x < half { own + sums.get(lid.x + half) } else { own }
        barrier(mut sums)
        sums.write(mine, 0, v)
        barrier(mut sums)
    }
    let mean = exp2(sums.get(0) / 1024.0)
    let target = clamp(m.base * pow(m.reference / mean, m.strength), m.lo, m.hi)
    exposure.update(id, |old| {
        let value = if m.fresh != 0 { target } else { mix(old.value, target, m.rate) }
        Exposure { value, mean }
    })
}

/// What the look's pass reads besides its textures: the scene's camera (unjittered: the output
/// is), the light (its tone curve), the look, and the output's size.
pub struct Develop: Copy + GpuData {
    pub cam: Camera,
    pub light: Light,
    pub look: Look,
    pub out: vec2,
}

/// The scene's depth nearest an output pixel's centre `px`, and where in the scene that is.
fn depth_at(d: Develop, depth: DepthTexture, px: vec2) -> (f32, vec2) {
    let scale = d.cam.screen / d.out
    let q = px * scale
    let p = min(vec2u(q), vec2u(d.cam.screen) - vec2u(1))
    (depth.load(x: p.x, y: p.y), q)
}

/// How much of a character's line the output pixel at `p` is (on the character's own pixels,
/// so the line is a darker shade of its colour): where a neighbour `line_px` away is well behind
/// it (its silhouette), or is another of its parts a little behind it (where a part passes in
/// front of another).
fn line(
    d: Develop,
    image: Texture<Rgba16Float>,
    depth: DepthTexture,
    p: vec2,
    here_tag: f32,
    here_z: f32,
) -> f32 {
    if class_of(here_tag) != class_of(CREATURE) {
        return 0.0
    }
    let r = d.look.line_px
    let near = d.cam.distance_of(here_z)
    var line = 0.0
    for k in 0..4 {
        let a = f32(k) * 1.5707964 + 0.4
        let q = clamp(p + vec2(cos(a), sin(a)) * r, vec2(0.0), d.out - vec2(1.0))
        let other = image.load(x: u32(q.x), y: u32(q.y)).a
        let (z, _) = depth_at(d, depth, q)
        let there = d.cam.distance_of(z)
        let other_char = class_of(other) == class_of(CREATURE)
        // Its silhouette: the neighbour isn't it, and is well behind it.
        let behind = if !other_char { smoothstep(0.03, 0.12, (there - near) / near) } else { 0.0 }
        // Where one of its parts passes in front of another (a leg against its body): another
        // part, a little behind.
        let parts = if other_char && abs(other - here_tag) > 0.5 {
            smoothstep(0.004, 0.02, (there - near) / near)
        } else {
            0.0
        }
        line = max(line, max(behind, parts * 0.8))
    }
    line
}

/// The dabs and the paper's tooth at a scene pixel (the scene's resolution: the look allows
/// them there, #28 §7): its surface from its depth and its neighbours' (its world point and
/// normal, as the jittered sample saw it), or its sky direction; each the amount it moves the
/// paint, for the output's pass to read between texels. Their sizes are in the output's
/// pixels (`out` its size), whatever the scene's. The ground and what grows on it take the
/// terrain's plane (the clipmap's normal), which the depth's neighbours give only roughly
/// through the grass.
@fragment
pub fn dab_map(
    pixel: FragCoord,
    cam: Camera,
    look: Look,
    out: vec2,
    levels: Levels,
    texels: [Texel],
    scene: Texture<Rgba16Float>,
    depth: DepthTexture,
) -> vec4 {
    // The scene's pixel, at its unjittered centre: each texel holds the dab of the same point
    // of a surface from frame to frame, and the output reads it at the same place (`develop`).
    // (Read at a place the jitter shifted each frame, between texels sampled at shifted points,
    // the dabs' sharp edges flickered.)
    let px = pixel.position.xy
    let size = vec2u(cam.screen) - vec2u(1)
    let p = min(vec2u(px), size)
    // An output pixel's share of a scene pixel.
    let per_out = cam.screen.y / out.y
    let still = Camera { jitter: vec2(0.0), ..cam }
    let class = class_of(scene.load(x: p.x, y: p.y).a)
    let z = depth.load(x: p.x, y: p.y)
    if class == 0 || z <= 0.0 {
        // The sky: dabs anchored to directions, a pixel's angle being its footprint at 1 m.
        let ray = still.ray(px)
        let footprint = 2.0 * cam.tan_half / cam.screen.y
        let dab = dabs(ray, -ray, footprint, look.dab_px * 1.6 * per_out)
        return vec4(look.dabs_sky * dab, 0.0, 0.0, 1.0)
    }
    // The surface at the pixel's own (unjittered) point, not at the jittered sample the scene
    // took near it: the depth between the samples round that point (reversed depth is linear
    // on screen across a plane, so bilinear is exact there). So a dab stays where it is on a
    // surface from frame to frame, as temporal AA's image does. Across an edge (the four depths
    // over 2% apart), the nearest sample itself.
    let jp = vec2(cam.jitter.x * cam.screen.x, -cam.jitter.y * cam.screen.y) * 0.5
    let f = px - vec2(0.5) + jp
    let b = floor(f)
    let t = f - b
    let at = |dx: f32, dy: f32| {
        let q = clamp(b + vec2(dx, dy), vec2(0.0), vec2(size))
        depth.load(x: u32(q.x), y: u32(q.y))
    }
    let (d00, d10, d01, d11) = (at(0.0, 0.0), at(1.0, 0.0), at(0.0, 1.0), at(1.0, 1.0))
    let lo = min(min(d00, d10), min(d01, d11))
    let hi = max(max(d00, d10), max(d01, d11))
    var world = cam.world_at(vec2(p) + vec2(0.5), z)
    var zz = z
    if lo > 0.0 && hi - lo <= 0.02 * hi {
        zz = mix(mix(d00, d10, t.x), mix(d01, d11, t.x), t.y)
        world = still.world_at(px, zz)
    }
    let dist = cam.distance_of(zz)
    let footprint = cam.footprint(dist)
    let qx = vec2u(min(p.x + 1, size.x), p.y)
    let qy = vec2u(p.x, min(p.y + 1, size.y))
    let wx = cam.world_at(vec2(qx) + vec2(0.5), max(depth.load(x: qx.x, y: qx.y), 1.0e-9))
    let wy = cam.world_at(vec2(qy) + vec2(0.5), max(depth.load(x: qy.x, y: qy.y), 1.0e-9))
    var n = normalize(cross(wy - world, wx - world) + vec3(0.0, 1.0e-6, 0.0))
    if dot(n, cam.eye - world) < 0.0 {
        n = -n
    }
    if class == class_of(GROUND) || class == class_of(GRASS) || class == class_of(FLOWER) {
        let (ground_n, _, _) = ground_at(levels, texels, world.xz)
        n = ground_n
        // Grass and flowers are painted on the ground they grow from: where the texel's
        // unjittered ray meets the terrain's plane there, which the blades' jittered samples
        // don't move.
        if class != class_of(GROUND) {
            let ground = vec3(world.x, height_at(levels, texels, world.xz), world.z)
            let ray = still.ray(px)
            let across = dot(ray, n)
            if abs(across) > 0.05 {
                world = cam.eye + ray * (dot(ground - cam.eye, n) / across)
            }
        }
    }
    // A crown is a mass of leaves, each tilted its own way: its dabs lie across the line of
    // sight, as a painter lays a crown's.
    if class == 3 {
        n = normalize(cam.eye - world)
    }
    // Broad things take stronger dabs: the far ground, crowns; characters half.
    let broad = if class == 3 { 1.0 } else { smoothstep(30.0, 250.0, dist) }
    var strength = mix(look.dabs_near, look.dabs_far, broad)
    if class == class_of(CREATURE) {
        strength *= 0.5
    }
    // A pixel's footprint on the surface, across the slope it's seen at (a surface seen edge on
    // spreads a pixel along it): so a dab is as wide on screen one way as the other, never a
    // streak thinner than a pixel.
    let facing = max(abs(dot(n, normalize(cam.eye - world))), 0.4)
    let dab = dabs(world, n, footprint / facing, look.dab_px * per_out)
    // The tooth's grain, a few output pixels: no finer than two of the scene's pixels at half
    // the output's size, so the map holds it at either.
    vec4(strength * dab, look.tooth * tooth(world, footprint * per_out * 2.0), 0.0, 1.0)
}

/// The output pixel, painted: the dabs and the paper's tooth (from the dab map, between its
/// texels), the bloom, the characters' lines, a little sharpening, the tone curve at the
/// metered exposure (`meter`) and a vignette.
@fragment
pub fn develop(
    pixel: FragCoord,
    d: Develop,
    image: Texture<Rgba16Float>,
    depth: DepthTexture,
    glow: Texture<Rgba16Float>,
    dabs: Texture<Rgba16Float>,
    s: Sampler,
    exposure: [Exposure],
) -> vec4 {
    let px = pixel.position.xy
    let p = vec2u(px)
    let here = image.load(x: p.x, y: p.y)
    let look = d.look
    // A little sharpening against temporal AA's softness: the pixel against its cross.
    let size = vec2u(d.out) - vec2u(1)
    let n1 = image.load(x: min(p.x + 1, size.x), y: p.y).rgb
    let n2 = image.load(x: max(p.x, 1) - 1, y: p.y).rgb
    let n3 = image.load(x: p.x, y: min(p.y + 1, size.y)).rgb
    let n4 = image.load(x: p.x, y: max(p.y, 1) - 1).rgb
    var paint = max(
        here.rgb + (here.rgb * 4.0 - (n1 + n2 + n3 + n4)) * (look.sharpen * 0.25),
        vec3(0.0),
    )
    // The dab map's texel for this point: its texels hold their unjittered centres' points
    // (`dab_map`), so the same place each frame.
    let q = px * (d.cam.screen / d.out)
    let m = dabs.sample_level(s, q / d.cam.screen)
    paint = paint * (1.0 + m.r) * vec3(1.0 + 0.25 * m.r, 1.0, 1.0 - 0.3 * m.r) * (1.0 + m.g)
    // Bloom.
    let gq = min(vec2u(px / 4.0), vec2u(glow.width() - 1, glow.height() - 1))
    paint += glow.load(x: gq.x, y: gq.y).rgb * look.bloom
    var c = tone(paint, exposure[0].value)
    // The characters' lines: a darker shade of their colour.
    let (z, _) = depth_at(d, depth, px)
    let l = line(d, image, depth, px, here.a, z)
    if l > 0.0 {
        c = mix(c, c * look.line_dark, vec3(l))
    }
    let uv = px / d.out - vec2(0.5)
    c = c * (1.0 - look.vignette * dot(uv, uv))
    vec4(c, 1.0)
}
