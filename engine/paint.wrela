// The look's passes after temporal AA: bloom and the tone curve, which turn the lit scene into
// the image (`develop`, the last pass, calling the look's lens: `style::Style::lens`).
//
// - The world's brush dabs and the paper's tooth (`marks::dab_map`, a map at the scene's
//   resolution) move the paint's value and hue a little as `develop` reads them; the lines on the
//   characters and solid forms are drawn before temporal AA (`marks::lines`). Both are the
//   physical look's marks (`marks`).
// - Bloom: the bright light, brought down a pyramid of `BLOOM_LEVELS` levels and back up it, each
//   level adding its light, wider, to the one above (`bloom_down`, `bloom_up`); then the tone
//   curve, at an exposure metered from a histogram of the scene's luminance
//   (`meter`: the band from its median to its brightest twentieth); then the look's grading table
//   (`graded`).
//
// Every texture the look lays on is anchored in the world.

use light::LUMA
use style::Style
use noise::{hash2, noise3, octave_of}
use std::gpu::{
    DepthTexture, FragCoord, GlobalId, LocalId, One, Rgba16Float, Rgba8, Sampler, SharedAtomics,
    Texels3d, Texture, Texture3d, dispatch, texture3d,
}
use terrain::{Levels, Texel, ground_at, level_at, materials_at}
use view::{BARK, CREATURE, Camera, FLOWER, GRASS, GROUND, LEAVES, ROCK, WATER, class_of}

/// The look's settings: how much of the grading table it takes; how strong the dabs are on near
/// surfaces, on broad far ones and on the sky; the paper's tooth; the bloom; the characters' lines (their width in output pixels, and
/// how dark); how much the edges sharpen; and the vignette.
pub struct Look: Copy + GpuData {
    /// How much of the frame's grading table the colour takes (`Frame::grade_with`; 0: none,
    /// the identity's).
    pub grade: f32 = 0.0,
    pub dabs_near: f32 = 0.16,
    pub dabs_far: f32 = 0.30,
    pub dabs_sky: f32 = 0.10,
    pub dab_px: f32 = 18.0,
    pub tooth: f32 = 0.06,
    pub bloom: f32 = 0.18,
    pub line_px: f32 = 1.6,
    pub line_dark: f32 = 0.65,
    pub sharpen: f32 = 0.2,
    pub vignette: f32 = 0.28,
    /// The screen it's for (B13, D11): SDR (0: the tone curve to [0, 1], sRGB) or HDR (1: linear
    /// light, rolled off above SDR white toward `peak`, where the display shows it so).
    pub output: u32 = 0,
    pub peak: f32 = 4.0,
}

/// An HDR screen's light from the scene's (`c`, exposed): linear, as it is up to SDR white
/// (1.0); its luminance above it rolled off toward `peak` (`e / (1 + e / (peak − 1))` of its
/// excess `e`), its chroma kept.
pub fn hdr_tone(c: vec3, peak: f32) -> vec3 {
    let c = max(c, vec3(0.0))
    let y = dot(c, vec3(0.2126, 0.7152, 0.0722))
    if y <= 1.0 {
        return c
    }
    let e = y - 1.0
    let rolled = 1.0 + e / (1.0 + e / max(peak - 1.0, 1.0e-3))
    c * (rolled / y)
}

/// A pixel `e` sharpened against its cross (`b`, `d`, `f`, `h`), as AMD's robust contrast-adaptive
/// sharpening does it (Lottes, FidelityFX CAS / RCAS, MIT): a negative lobe as strong as keeps
/// the result within the cross's range, at most `sharpen` / 4 (the cross the look sharpened
/// against before, where nothing clips), in tamed colours (each over one plus its largest
/// channel, so a bright pixel's range is the [0, 1] RCAS reads).
pub fn rcas(e: vec3, b: vec3, d: vec3, f: vec3, h: vec3, sharpen: f32) -> vec3 {
    let tame = |c: vec3| max(c, vec3(0.0)) / (1.0 + max(c.r, max(c.g, c.b)))
    let (te, tb, td, tf, th) = (tame(e), tame(b), tame(d), tame(f), tame(h))
    let mn = min(min(tb, td), min(tf, th))
    let mx = max(max(tb, td), max(tf, th))
    let hit_min = min(mn, te) / (4.0 * max(mx, vec3(1.0e-5)))
    let hit_max = (vec3(1.0) - max(mx, te)) / min(4.0 * mn - vec3(4.0), vec3(-1.0e-5))
    let lobes = max(-hit_min, hit_max)
    let lobe = max(-0.1875, min(max(lobes.r, max(lobes.g, lobes.b)), 0.0)) *
        min(sharpen * 4.0 / 3.0, 1.0)
    let t = (lobe * (tb + td + tf + th) + te) / (4.0 * lobe + 1.0)
    temporal::untamed(clamp(t, vec3(0.0), vec3(0.999)))
}

// ---- bloom --------------------------------------------------------------------------------

/// The bloom's levels: half the output's size, then each half the last.
pub const BLOOM_LEVELS: u32 = 4

/// `src` filtered down to a texel of a target half its size at `pixel` (Jimenez's 13 taps, Next
/// Generation Post Processing in Call of Duty: Advanced Warfare, SIGGRAPH 2014: five overlapping
/// boxes of 2 × 2 texels, each a filtered sample, no texel left out and none flickering as the
/// light moves). The first level takes only the light above `threshold` (at the exposure `base`;
/// so at the metered exposure, `exposure`'s, it's the same brightness on the screen).
@fragment
pub fn bloom_down(
    pixel: FragCoord,
    src: Texture<Rgba16Float>,
    s: Sampler,
    first: u32,
    threshold: f32,
    base: f32,
    exposure: [Exposure],
) -> vec4 {
    let size = vec2(f32(src.width()), f32(src.height()))
    let at = pixel.position.xy * 2.0
    let t = |dx: f32, dy: f32| src.sample_level(s, (at + vec2(dx, dy)) / size).rgb
    var c = t(0.0, 0.0) * 0.125 +
        (t(-2.0, -2.0) + t(2.0, -2.0) + t(-2.0, 2.0) + t(2.0, 2.0)) * 0.03125 +
        (t(0.0, -2.0) + t(-2.0, 0.0) + t(2.0, 0.0) + t(0.0, 2.0)) * 0.0625 +
        (t(-1.0, -1.0) + t(1.0, -1.0) + t(-1.0, 1.0) + t(1.0, 1.0)) * 0.125
    if first != 0 {
        c = max(c - vec3(threshold * base / max(exposure[0].value, 1.0e-3)), vec3(0.0))
    }
    vec4(c, 1.0)
}

/// `src` (a level half its target's size) brought up at `pixel` by a 3 × 3 tent, a texel of
/// `src` a tap: what a level adds to the one above it (drawn with `Blend::Add`).
@fragment
pub fn bloom_up(pixel: FragCoord, src: Texture<Rgba16Float>, s: Sampler) -> vec4 {
    let size = vec2(f32(src.width()), f32(src.height()))
    let at = pixel.position.xy * 0.5
    let t = |dx: f32, dy: f32| src.sample_level(s, (at + vec2(dx, dy)) / size).rgb
    let c = (t(-1.0, -1.0) + t(1.0, -1.0) + t(-1.0, 1.0) + t(1.0, 1.0)) * 0.0625 +
        (t(0.0, -1.0) + t(-1.0, 0.0) + t(1.0, 0.0) + t(0.0, 1.0)) * 0.125 +
        t(0.0, 0.0) * 0.25
    vec4(c, 1.0)
}

// ---- grading ---------------------------------------------------------------------------------

/// A grading table's side: 32 texels, a colour's channels its three coordinates.
pub const LUT_SIDE: u32 = 32

/// Texel `id` of the identity grading table: its own colour.
@compute(4, 4, 4)
pub fn identity_lut(out: mut Texels3d<Rgba8>, id: GlobalId) {
    if id.x >= LUT_SIDE || id.y >= LUT_SIDE || id.z >= LUT_SIDE {
        return
    }
    out.store(id, vec4(vec3(f32(id.x), f32(id.y), f32(id.z)) / f32(LUT_SIDE - 1), 1.0))
}

/// The identity grading table (`Look::grade` 0 reads none).
pub fn identity() -> Texture3d<Rgba8> {
    var t = texture3d::<Rgba8>(LUT_SIDE, LUT_SIDE, LUT_SIDE)
    dispatch(identity_lut.bind(out: mut t), over: (LUT_SIDE, LUT_SIDE, LUT_SIDE))
    t
}

/// Display colour `c` graded by `lut` (through `s`, linear), `grade` of the way.
pub fn graded(c: vec3, lut: Texture3d<Rgba8>, s: Sampler, grade: f32) -> vec3 {
    if grade <= 0.0 {
        return c
    }
    let uvw = saturate(c) * (f32(LUT_SIDE - 1) / f32(LUT_SIDE)) + vec3(0.5 / f32(LUT_SIDE))
    mix(c, lut.sample_level(s, uvw).rgb, vec3(grade))
}

// ---- metering -------------------------------------------------------------------------------

/// How the camera meters (the eye adapting): `base`, the exposure of a scene whose metered
/// luminance (`meter`: the geometric mean of the brighter half of its pixels but the brightest
/// twentieth) is `reference`, and for another, `base` times (`reference` / it) to the power
/// `strength` (1 brings every scene to the same, 0 doesn't meter), within `lo` to `hi`; reached a
/// fraction `rate` of the way each frame, or at once (`fresh` 1); but never more than `flash`
/// times it, so a scene that brightens at once (a turn from the wood's shade to a sunlit
/// clearing) shows no more than that over its settled brightness, while one that darkens adapts
/// at `rate`. A hazy sky toward a low sun is ten times the rest of it: a fixed exposure shows it
/// white.
pub struct Metering: Copy + GpuData {
    pub base: f32,
    pub reference: f32,
    pub strength: f32,
    pub lo: f32,
    pub hi: f32,
    pub rate: f32,
    pub flash: f32,
    pub fresh: u32,
}

/// The metered exposure (`meter`), the luminance it was metered from, and the scene's geometric
/// mean luminance (for tests).
pub struct Exposure: Copy + GpuData {
    pub value: f32,
    pub metered: f32,
    pub mean: f32,
}

/// The histogram's bins, and the stops of log luminance they span (from `LOWEST`).
pub const BINS: u32 = 128
pub const LOWEST: f32 = -14.0
pub const STOPS: f32 = 20.0

/// The band of the scene's pixels (by luminance) the meter reads: from the median to the
/// brightest twentieth (the sun, its glow, a sky's highlights: left out).
pub const BAND_LO: f32 = 0.5
pub const BAND_HI: f32 = 0.95

/// The bin of log2 luminance `l`.
pub fn bin_of(l: f32) -> u32 {
    u32(clamp((l - LOWEST) / STOPS * f32(BINS), 0.0, f32(BINS - 1)))
}

/// The log2 luminance at bin `b`'s middle.
pub fn bin_middle(b: u32) -> f32 {
    LOWEST + (f32(b) + 0.5) / f32(BINS) * STOPS
}

/// The geometric mean of the band of `bins` (a histogram of `total` pixels' log luminance) from
/// the `lo` to the `hi` share of them, darkest first: each bin weighed by its pixels in the band.
/// And the geometric mean of all of them.
pub fn band_of(bins: [u32; 128], total: u32, lo: f32, hi: f32) -> (f32, f32) {
    let from = lo * f32(total)
    let to = hi * f32(total)
    var below = 0.0
    var sum = 0.0
    var weight = 0.0
    var all = 0.0
    for b in 0..BINS {
        let n = f32(bins[b])
        let inside = max(min(below + n, to) - max(below, from), 0.0)
        sum += inside * bin_middle(b)
        weight += inside
        all += n * bin_middle(b)
        below += n
    }
    (exp2(sum / max(weight, 1.0)), exp2(all / max(f32(total), 1.0)))
}

/// The exposure: one workgroup, each invocation sixteen of a 64 × 64 grid of the scene's pixels
/// put in a histogram of their log luminance in workgroup memory (`BINS` bins over `STOPS` stops);
/// then the band's geometric mean (`band_of`), metered as `Metering` says.
@compute(256)
pub fn meter(
    scene: Texture<Rgba16Float>,
    m: Metering,
    bins: mut SharedAtomics<128>,
    exposure: mut One<Exposure>,
    id: GlobalId,
    lid: LocalId,
) {
    let size = vec2(f32(scene.width()), f32(scene.height()))
    for k in 0..16 {
        let i = lid.x + 256 * k
        let at = (vec2(f32(i % 64), f32(i / 64)) + vec2(0.5)) / 64.0 * size
        let c = scene.load(x: u32(at.x), y: u32(at.y)).rgb
        let _ = bins.add(i: bin_of(log2(max(dot(c, LUMA), 1.0e-6))), value: 1)
    }
    bins.barrier()
    if lid.x != 0 {
        return
    }
    var h = [0; 128]
    for b in 0..BINS {
        h[b] = bins.load(b)
    }
    let (metered, mean) = band_of(h, total: 4096, lo: BAND_LO, hi: BAND_HI)
    let target = clamp(m.base * pow(m.reference / metered, m.strength), m.lo, m.hi)
    exposure.update(id, |old| {
        let value = if m.fresh != 0 { target } else {
            min(mix(old.value, target, m.rate), target * m.flash)
        }
        Exposure { value, metered, mean }
    })
}

/// What the look's pass reads besides its textures: the scene's camera (unjittered: the output
/// is), the look, and the output's size. (The tone curve's exposure is the metered one:
/// `meter`.) And `view`, a debug view of form, off by default: 1 clay (the scene's light on its
/// grey forms, `light::Light`'s `clay`, with none of the look's marks), 2 silhouettes
/// (`silhouette`).
pub struct Develop: Copy + GpuData {
    pub cam: Camera,
    pub look: Look,
    pub out: vec2,
    pub view: u32 = 0,
    /// Whether the screen is shown HDR now (`std::gpu::screen_is`): the look's `output` asks,
    /// the host and the display decide.
    pub hdr: u32 = 0,
}

/// The silhouette view's value at an output pixel (display-referred) whose depth is `z` and tag
/// `tag`: the sky white; the land (the ground, what grows low on it, water) light; solid forms
/// (rock, what's built, trunks, crowns, characters) dark; each a step lighter for each band of
/// distance, a factor of four apart from 4 m. So a form reads by its shape alone, against the
/// sky, the land and the forms behind it.
fn silhouette(d: Develop, z: f32, tag: f32) -> f32 {
    if z <= 0.0 {
        return 0.97
    }
    let dist = d.cam.distance_of(z)
    let band = clamp(floor(log2(max(dist, 1.0) / 4.0) / 2.0) + 1.0, 0.0, 5.0)
    let class = class_of(tag)
    let land = class == class_of(GROUND) ||
        class == class_of(GRASS) ||
        class == class_of(FLOWER) ||
        class == class_of(WATER)
    if land { 0.52 + 0.06 * band } else { 0.03 + 0.08 * band }
}

/// The scene's depth nearest an output pixel's centre `px`.
pub fn depth_at(d: Develop, depth: DepthTexture, px: vec2) -> f32 {
    let p = min(vec2u(px * (d.cam.screen / d.out)), vec2u(d.cam.screen) - vec2u(1))
    depth.load(x: p.x, y: p.y)
}

/// The output pixel, painted: the dabs and the paper's tooth (from the dab map, between its
/// texels), the bloom, the characters' lines, a little sharpening, the tone curve at the
/// metered exposure (`meter`) and a vignette: the look's lens (`Y`, `style::Style::lens`). In the
/// debug views (`Develop`'s `view`), the clay without the dabs, the tooth, the lines and the
/// vignette; or the silhouettes alone.
@fragment
pub fn develop<Y: Style>(
    pixel: FragCoord,
    d: Develop,
    image: Texture<Rgba16Float>,
    depth: DepthTexture,
    glow: Texture<Rgba16Float>,
    below: Texture<Rgba16Float>,
    levels: u32,
    dabs: Texture<Rgba16Float>,
    lut: Texture3d<Rgba8>,
    s: Sampler,
    exposure: [Exposure],
) -> vec4 {
    let px = pixel.position.xy
    let p = vec2u(px)
    let here = image.load(x: p.x, y: p.y)
    if d.view == 2 {
        return vec4(vec3(silhouette(d, depth_at(d, depth, px), here.a)), 1.0)
    }
    let clay = d.view == 1
    let look = d.look
    // Sharpening against temporal AA's softness (and its upscaling): the pixel against its
    // cross, limited so it stays within its cross's range (`rcas`).
    let size = vec2u(d.out) - vec2u(1)
    let n1 = image.load(x: min(p.x + 1, size.x), y: p.y).rgb
    let n2 = image.load(x: max(p.x, 1) - 1, y: p.y).rgb
    let n3 = image.load(x: p.x, y: min(p.y + 1, size.y)).rgb
    let n4 = image.load(x: p.x, y: max(p.y, 1) - 1).rgb
    var paint = rcas(here.rgb, n1, n2, n3, n4, look.sharpen)
    // The dab map's texel for this point: its texels hold their unjittered centres' points
    // (`dab_map`), so the same place each frame.
    let q = px * (d.cam.screen / d.out)
    let m = if clay { vec4(0.0) } else { dabs.sample_level(s, q / d.cam.screen) }
    paint = paint * (1.0 + m.r) * vec3(1.0 + 0.25 * m.r, 1.0, 1.0 - 0.3 * m.r) * (1.0 + m.g)
    // Bloom: the pyramid's top and the level under it brought up (`bloom_up`'s tent, here rather
    // than in a pass of its own), which hold the levels' light each once (a quarter of it, so as
    // much light is spread as before).
    let glow_at = px / d.out
    var bloom = glow.sample_level(s, glow_at).rgb
    if levels > 1 {
        let size = vec2(f32(below.width()), f32(below.height()))
        let at = glow_at * size
        let t = |dx: f32, dy: f32| below.sample_level(s, (at + vec2(dx, dy)) / size).rgb
        bloom += (t(-1.0, -1.0) + t(1.0, -1.0) + t(-1.0, 1.0) + t(1.0, 1.0)) * 0.0625 +
            (t(0.0, -1.0) + t(-1.0, 0.0) + t(1.0, 0.0) + t(0.0, 1.0)) * 0.125 +
            t(0.0, 0.0) * 0.25
    }
    paint += bloom * (look.bloom / f32(BLOOM_LEVELS))
    Y::lens(paint, px, d, exposure[0], lut, s)
}

/// HDR keeps SDR's range as it is, and rolls a white three times SDR's off above 1 and under the
/// peak.
@test
fn hdr_rolls_off_above_sdr_white() {
    let mid = hdr_tone(vec3(0.5), peak: 4.0)
    assert(length(mid - vec3(0.5)) < 1.0e-6, f"{mid}")
    let white = hdr_tone(vec3(3.0), peak: 4.0)
    assert(white.x > 1.0 && white.x < 4.0, f"3.0 white shows as {white.x}")
    let far = hdr_tone(vec3(1000.0), peak: 4.0)
    assert(far.x < 4.0, f"{far.x} past the peak")
}

/// The sharpening leaves a flat neighbourhood as it is, stays within its cross's range at an
/// edge (no halo), and does nothing at 0.
@test
fn rcas_sharpens_within_its_crosss_range() {
    let flat = rcas(vec3(0.4), vec3(0.4), vec3(0.4), vec3(0.4), vec3(0.4), sharpen: 0.2)
    assert(length(flat - vec3(0.4)) < 1.0e-4, "a flat neighbourhood changed")
    let edge = rcas(vec3(0.5), vec3(0.9), vec3(0.1), vec3(0.5), vec3(0.5), sharpen: 0.2)
    assert(edge.r >= 0.1 - 1.0e-4 && edge.r <= 0.9 + 1.0e-4, "the edge overshot its cross")
    let bright = rcas(vec3(6.0, 2.0, 1.0), vec3(4.0), vec3(1.0), vec3(5.0), vec3(3.0), sharpen: 0.2)
    assert(bright.r >= 0.0 && bright.r < 1.0e6, "a bright pixel isn't finite")
    let off = rcas(vec3(0.5), vec3(0.9), vec3(0.1), vec3(0.5), vec3(0.5), sharpen: 0.0)
    assert(length(off - vec3(0.5)) < 1.0e-4, "no sharpening changed the pixel")
}

/// The band's mean: a scene of two halves, one 4 stops under the other, meters at its brighter
/// half; the brightest twentieth (a sun) moves it nothing; all of it reads the geometric mean.
@test
fn the_meter_reads_the_band_from_the_median_up() {
    var h = [0; 128]
    let dark = bin_of(-6.0)
    let lit = bin_of(-2.0)
    h[dark] = 2048
    h[lit] = 2048
    let (band, all) = band_of(h, total: 4096, lo: 0.5, hi: 0.95)
    assert(abs(log2(band) - bin_middle(lit)) < 1.0e-4, f"the band read {log2(band)}")
    assert(abs(log2(all) - (bin_middle(dark) + bin_middle(lit)) * 0.5) < 1.0e-4, "the mean")
    // A sun: the brightest 4 % far brighter; the band is the same.
    var sunny = [0; 128]
    sunny[dark] = 2048
    sunny[lit] = 2048 - 160
    sunny[bin_of(5.0)] = 160
    let (with_sun, _) = band_of(sunny, total: 4096, lo: 0.5, hi: 0.95)
    assert(
        abs(log2(with_sun) - bin_middle(lit)) < 1.0e-4,
        f"the sun moved the band: {log2(with_sun)}",
    )
}
