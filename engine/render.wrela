// Drawing creatures (#43 §8, D-089, D-097): a realized mesh (`realize`), posed on the GPU by its
// type's `Poser`, skinned by linear blending of four bones, cast into the sun's shadow map, and
// shaded per pixel by its field: evaluated at the rest position, under the triangle's mask (2 or
// 3 parts, not 20), with the pixel's footprint, its gradient the normal and its channels what the
// type's `Look` turns into an albedo and a roughness. Engine code, generic over any creature's
// field and look: the kernels are monomorphized for their types, and their numbers arrive as
// uniforms (D-070).

use creature::{Bone, Creature, PartMask, Parts, Skeleton}
use realize::{SkinVertex}
use sim::{Pose, Transform}
use std::gpu::{
    ClipPosition, ComparisonSampler, DepthTexture, Flat, GlobalId, LocalId, Slots, VertexIndex,
    WorkgroupId,
}
use std::math::PI
use std::quat::Quat

/// The most bones a palette holds.
pub const MAX_BONES: u32 = 64

/// A camera and the sun: the camera's view-projection, the sun's (its shadow map's), the eye,
/// and the direction toward the sun.
pub struct View: Copy + GpuData {
    pub view_proj: mat4,
    pub light: mat4,
    pub eye: vec3,
    pub sun: vec3,
}

/// The lights (D-089): a sun with a shadow map, a hemisphere's ambient light, normalized
/// Blinn-Phong specular, and an ACES fit. The numbers are the game's (spike 01's, for the herd).
pub struct Lights: Copy + GpuData {
    pub sun_colour: vec3,
    /// The hemisphere's colour straight up and straight down.
    pub sky: vec3,
    pub ground: vec3,
    /// How much of the hemisphere's light reaches a surface.
    pub ambient: f32,
    /// What the colour is scaled by before the ACES fit.
    pub exposure: f32,
    /// The specular reflectance at normal incidence.
    pub f0: f32,
    /// The shadow lookup's offset along the normal, and its comparison's bias.
    pub normal_offset: f32,
    pub compare_bias: f32,
}

impl Lights {
    /// The ACES fit (Narkowicz) of `exposure` times `x`.
    pub fn tonemap(self, x: vec3) -> vec3 {
        let c = x * self.exposure
        clamp((c * (2.51 * c + 0.03)) / (c * (2.43 * c + 0.59) + 0.14), vec3(0.0), vec3(1.0))
    }

    /// A surface of `albedo` and roughness `rough`, its normal `n`, at `world`, seen from `view`'s
    /// eye and lit by its sun to `lit` (1 in the sun, 0 in shadow): tonemapped.
    pub fn light(
        self,
        albedo: vec3,
        rough: f32,
        n: vec3,
        world: vec3,
        view: View,
        lit: f32,
    ) -> vec3 {
        let l = view.sun
        let v = normalize(view.eye - world)
        let h = normalize(l + v)
        let ndl = max(dot(n, l), 0.0)
        let a = max(rough * rough, 0.02)
        let sp = 2.0 / (a * a) - 2.0
        let spec = pow(max(dot(n, h), 0.0), sp) * (sp + 8.0) / 25.13 * self.f0
        let hemi = mix(self.ground, self.sky, 0.5 + 0.5 * n.y)
        let sun = self.sun_colour * (ndl * lit)
        self.tonemap(albedo * (hemi * self.ambient + sun) + sun * spec)
    }

    /// How lit `world` is, whose normal is `n` (1 in the sun, 0 in shadow): the point moved
    /// `normal_offset` along the normal, looked up in the sun's shadow map through a comparison
    /// sampler that blends the four nearest texels (2×2 PCF), `compare_bias` nearer the sun.
    pub fn shadow(
        self,
        view: View,
        world: vec3,
        n: vec3,
        map: DepthTexture,
        s: ComparisonSampler,
    ) -> f32 {
        let lp = view.light * vec4(world + n * self.normal_offset, 1.0)
        let uv = vec2(lp.x * 0.5 + 0.5, lp.y * -0.5 + 0.5)
        map.sample_compare_level(s, uv, lp.z - self.compare_bias)
    }
}

/// How a creature type's surface looks (#43 §8.4): from its field's channels at a rest-space
/// point, seen `fp` wide, an albedo (linear) and a roughness; and the colour written to the
/// screen from the lit, tonemapped one. Written by the game, run per pixel.
pub trait Look<C>: Copy + GpuData {
    fn surface(self, c: C, rest: vec3, fp: f32) -> (vec3, f32)

    fn output(self, colour: vec3) -> vec4 {
        vec4(colour, 1.0)
    }
}

/// Channels that say their own albedo and roughness.
pub trait Shaded {
    fn albedo(self) -> vec3
    fn roughness(self) -> f32
}

/// A look that takes the albedo and roughness straight from the channels (`Shaded`).
pub struct ByChannels: Copy + GpuData {
    pub unused: u32,
}

impl<C: Shaded> Look<C> for ByChannels {
    fn surface(self, c: C, rest: vec3, fp: f32) -> (vec3, f32) {
        (c.albedo(), c.roughness())
    }
}

// ---- posing on the GPU (§8.1) ---------------------------------------------------------------------

/// How a creature type poses its skeleton on the GPU: each bone's turn, and where the root goes,
/// from an instance's pose parameters (the type's: a gait phase, how its head is held). Written
/// in wrela, run in one compute pass for every visible instance.
pub trait Poser: Copy + GpuData {
    /// Bone `bone`'s turn about its own rest position, for an instance whose pose is `pose`.
    fn local(self, bone: u32, pose: vec4) -> mat4

    /// Where the skeleton goes: from an instance's root position `at` and `heading`, and its
    /// pose.
    fn root(self, at: vec3, heading: f32, pose: vec4) -> mat4
}

/// An instance to pose: where its root is, which way it faces, its pose parameters, and which
/// rest skeleton it has (in the skeletons buffer). Its palette is its place in the instances
/// buffer, `MAX_BONES` matrices each.
pub struct Instance: Copy + GpuData {
    pub at: vec3,
    pub heading: f32,
    pub pose: vec4,
    pub skeleton: u32,
}

/// A skeleton at rest, as the posing pass reads it: each bone's rest position (in `xyz`) and
/// parent (in `w`, its own number for a root), and how many bones.
pub struct RestSkeleton: Copy + GpuData {
    pub bones: [vec4; 64],
    pub count: u32,
}

impl RestSkeleton {
    pub fn of(s: Skeleton) -> RestSkeleton {
        var out = RestSkeleton { bones: [vec4(0.0); 64], count: s.len() }
        for i in 0..s.len() {
            let b = Bone { index: i }
            out.bones[i] = vec4(s.rest(b), f32(s.parent(b).index))
        }
        out
    }
}

/// A translation by `t`.
pub fn translate(t: vec3) -> mat4 {
    mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(t, 1.0))
}

/// Each instance's palette (a workgroup each, an invocation per bone): bone i's matrix, rest
/// space to world, is world_parent · T(J_i − J_parent) · local_i, with the root's from the root's
/// transform, times T(−J_i). Each invocation walks its bone's chain from the root.
@compute(64)
pub fn pose_instances<P: Poser>(
    poser: P,
    instances: [Instance],
    skeletons: [RestSkeleton],
    palettes: mut Slots<mat4>,
    group: WorkgroupId,
    lid: LocalId,
    id: GlobalId,
) {
    let inst = instances[group.x]
    let sk = skeletons[inst.skeleton]
    let bone = lid.x
    if bone >= sk.count {
        return
    }
    // The chain from `bone` up to its root.
    var chain = [0; 16]
    var n = 0
    var b = bone
    loop {
        chain[n] = b
        n += 1
        let parent = u32(sk.bones[b].w)
        if parent == b || n == 16 {
            break
        }
        b = parent
    }
    let root = chain[n - 1]
    var world = poser.root(inst.at, inst.heading, inst.pose) *
        translate(sk.bones[root].xyz) *
        poser.local(root, inst.pose)
    for k in 1..n {
        let i = chain[n - 1 - k]
        let p = chain[n - k]
        world = world * translate(sk.bones[i].xyz - sk.bones[p].xyz) * poser.local(i, inst.pose)
    }
    palettes[id] = world * translate(-sk.bones[bone].xyz)
}

// ---- skinning, shadows and shading (§8.2–§8.4) -----------------------------------------------------

/// What the vertex shader passes on: the clip position, the rest position (shading is in rest
/// space), the world position, the skinning matrix's linear part (for normals), and the
/// vertex's mask, not interpolated.
pub struct Skinned: Copy {
    pub clip: ClipPosition,
    pub rest: vec3,
    pub world: vec3,
    pub r0: vec3,
    pub r1: vec3,
    pub r2: vec3,
    pub mask_lo: Flat<u32>,
    pub mask_hi: Flat<u32>,
}

/// Byte `k` of `w`, as a fraction of 255.
fn unorm8(w: u32, k: u32) -> f32 {
    f32((w >> (8 * k)) & 255) / 255.0
}

/// A vertex's skinning matrix: its four bones' matrices in the palette starting at `first`,
/// blended by its weights.
pub fn skin_matrix(v: SkinVertex, palettes: [mat4], first: u32) -> mat4 {
    let b = v.bones
    palettes[first + (b & 255)] * unorm8(v.weights, 0) +
        palettes[first + ((b >> 8) & 255)] * unorm8(v.weights, 1) +
        palettes[first + ((b >> 16) & 255)] * unorm8(v.weights, 2) +
        palettes[first + (b >> 24)] * unorm8(v.weights, 3)
}

/// A mesh's vertex, skinned by the palette from `first`, seen from `view`'s camera.
@vertex
pub fn skin(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    first: u32,
    view: View,
) -> Skinned {
    let sv = verts[v.index]
    let m = skin_matrix(sv, palettes, first)
    let wp = (m * vec4(sv.pos, 1.0)).xyz
    Skinned {
        clip: ClipPosition { position: view.view_proj * vec4(wp, 1.0) },
        rest: sv.pos,
        world: wp,
        r0: m[0].xyz,
        r1: m[1].xyz,
        r2: m[2].xyz,
        mask_lo: Flat { value: sv.mask.lo },
        mask_hi: Flat { value: sv.mask.hi },
    }
}

/// A mesh's vertex, skinned, seen from the sun: for the shadow map.
@vertex
pub fn skin_shadow(
    v: VertexIndex,
    verts: [SkinVertex],
    palettes: [mat4],
    first: u32,
    view: View,
) -> ClipPosition {
    let sv = verts[v.index]
    ClipPosition { position: view.light * (skin_matrix(sv, palettes, first) * vec4(sv.pos, 1.0)) }
}

/// A depth-only pass's fragment: its colour goes nowhere.
@fragment
pub fn depth_only() -> vec4 {
    vec4(0.0)
}

/// A pixel of a creature: its field at the rest position, under the triangle's mask, seen as
/// wide as the pixel; the gradient turned by the skinning matrix is the normal, and the channels
/// are what the look shades.
@fragment
pub fn shade<C, F: Parts<C>, L: Look<C>>(
    field: F,
    look: L,
    s: Skinned,
    view: View,
    lights: Lights,
    shadow: DepthTexture,
    shadow_sampler: ComparisonSampler,
) -> vec4 {
    let mask = PartMask { lo: s.mask_lo.value, hi: s.mask_hi.value }
    let fp = length(fwidth(s.rest)) // this pixel's footprint in rest space
    let (_, g, channels) = field.sample_masked(s.rest, mask, fp)
    let n = normalize(mat3(s.r0, s.r1, s.r2) * g)
    let (albedo, rough) = look.surface(channels, s.rest, fp)
    let lit = lights.shadow(view, s.world, n, shadow, shadow_sampler)
    look.output(lights.light(albedo, rough, n, s.world, view, lit))
}

// ---- cameras --------------------------------------------------------------------------------------

/// A right-handed view from `eye` toward `at`, with +y up.
pub fn look_at(eye: vec3, at: vec3) -> mat4 {
    let z = normalize(eye - at)
    let x = normalize(cross(vec3(0.0, 1.0, 0.0), z))
    let y = cross(z, x)
    mat4(
        vec4(x.x, y.x, z.x, 0.0),
        vec4(x.y, y.y, z.y, 0.0),
        vec4(x.z, y.z, z.z, 0.0),
        vec4(-dot(x, eye), -dot(y, eye), -dot(z, eye), 1.0),
    )
}

/// A perspective projection `fovy` (radians) high, `aspect` wide, depth 0 at `near` to 1 at
/// `far` (WebGPU's range).
pub fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> mat4 {
    let f = 1.0 / tan(fovy / 2.0)
    mat4(
        vec4(f / aspect, 0.0, 0.0, 0.0),
        vec4(0.0, f, 0.0, 0.0),
        vec4(0.0, 0.0, far / (near - far), -1.0),
        vec4(0.0, 0.0, near * far / (near - far), 0.0),
    )
}

/// An orthographic projection of the box from (l, b, -n) to (r, t, -f), depth 0 to 1.
pub fn ortho(l: f32, r: f32, b: f32, t: f32, n: f32, f: f32) -> mat4 {
    mat4(
        vec4(2.0 / (r - l), 0.0, 0.0, 0.0),
        vec4(0.0, 2.0 / (t - b), 0.0, 0.0),
        vec4(0.0, 0.0, 1.0 / (n - f), 0.0),
        vec4(-(r + l) / (r - l), -(t + b) / (t - b), n / (n - f), 1.0),
    )
}

/// A view: a camera at `eye` looking at `at`, `fovy` high on a screen `aspect` wide, near 0.1 m
/// and far 400 m; and the sun, toward `sun`, its shadow map `extent` either side of the point on
/// the ground below `at`, 60 m away along the sun's direction.
pub fn view(eye: vec3, at: vec3, fovy: f32, aspect: f32, sun: vec3, extent: f32) -> View {
    let s = normalize(sun)
    let centre = vec3(at.x, 0.0, at.z)
    let box = ortho(-extent, extent, -extent, extent, n: 1.0, f: 140.0)
    let light = box * look_at(centre + s * 60.0, centre)
    let proj = perspective(fovy, aspect, near: 0.1, far: 400.0)
    View { view_proj: proj * look_at(eye, at), light, eye, sun: s }
}

// ---- a palette posed on the CPU (the examples' walk) ---------------------------------------------

/// Bone matrices for one pose (rest space to world), as CPU code poses a creature: the examples'
/// walk on the spot (`walk`).
pub struct Palette: Copy + GpuData {
    pub bones: [mat4; MAX_BONES],
}

/// The rotation that turns the unit vector `a` to the unit vector `b`, the short way.
fn turn(a: vec3, b: vec3) -> Quat {
    let c = dot(a, b)
    if c < -0.9999 {
        // Opposite: half a turn about any axis across `a`.
        let across = if abs(a.x) < 0.9 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
        return Quat::axis_angle(cross(a, across), PI)
    }
    Quat { v: normalize(vec4(cross(a, b), 1.0 + c)) }
}

/// A bone's matrix: rest space to posed, turned by `r` about the bone's rest position `rest`,
/// which moves to `posed`.
fn bone_matrix(r: Quat, rest: vec3, posed: vec3) -> mat4 {
    let m = r.to_mat3()
    mat4(vec4(m[0], 0.0), vec4(m[1], 0.0), vec4(m[2], 0.0), vec4(posed - m * rest, 1.0))
}

/// Where a two-bone limb's middle joint goes, its root at `h` and its rest middle joint and end
/// at `k` and `a`, when its end goes to `to`: in the plane of the rest bend, each bone keeping
/// its length, and the end pulled no farther than the limb reaches.
fn bend(h: vec3, k: vec3, a: vec3, to: vec3) -> (vec3, vec3) {
    let (l1, l2) = (length(k - h), length(a - k))
    let span = to - h
    let d = clamp(length(span), abs(l1 - l2) + 1.0e-4, (l1 + l2) * 0.9999)
    let dir = if length(span) > 1.0e-6 { normalize(span) } else { normalize(a - h) }
    // Across the reach, toward the rest knee.
    let rest_out = (k - h) - dir * dot(k - h, dir)
    let out = if length(rest_out) > 1.0e-6 { normalize(rest_out) } else {
        normalize(cross(dir, vec3(1.0, 0.0, 0.0)))
    }
    let along = (l1 * l1 - l2 * l2 + d * d) / (2.0 * d)
    let knee = h + dir * along + out * sqrt(max(l1 * l1 - along * along, 0.0))
    (knee, h + dir * d)
}

/// The gait's hip height: `sim::GaitState::pose` is a body this tall's.
pub const GAIT_HIP: f32 = 1.2

/// The palette that poses `skeleton` as `pose` has its legs, moved into the world by `root`:
/// each foot goes where the gait puts it, its step (from under the hip) scaled from the gait's
/// 1.2 m hips to the leg's own; hip to ankle bends by two-bone IK, in the plane of its rest
/// knee; the ankle and the foot keep their rest turn. The other bones stay at rest.
pub fn palette(skeleton: Skeleton, pose: Pose, root: Transform) -> Palette {
    let (c, s) = (cos(root.heading), sin(root.heading))
    let world = mat4(
        vec4(c, 0.0, -s, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(s, 0.0, c, 0.0),
        vec4(root.pos, 1.0),
    )
    var bones = [world; MAX_BONES]
    let legs = skeleton.legs()
    for i in 0..min(skeleton.leg_count(), 4) {
        let j = legs[i].joints
        let rest = |b: Bone| skeleton.rest(b)
        let (h, k, a, f) = (rest(j[0]), rest(j[1]), rest(j[2]), rest(j[3]))
        let lp = pose.legs[i]
        let step = lp.foot - vec3(lp.hip.x, 0.0, lp.hip.z)
        let ankle_to = f + step * (h.y / GAIT_HIP) - (f - a)
        let (knee, ankle) = bend(h, k, a, ankle_to)
        let upper = turn(normalize(k - h), normalize(knee - h))
        let lower = turn(normalize(a - k), normalize(ankle - knee))
        bones[j[0].index] = world * bone_matrix(upper, h, h)
        bones[j[1].index] = world * bone_matrix(lower, k, knee)
        let below = bone_matrix(Quat::identity(), a, ankle)
        bones[j[2].index] = world * below
        bones[j[3].index] = world * below
    }
    Palette { bones }
}
