// Stones (#28 §4): fields, a displaced, faceted oval each (spike 15's boulders), realized to
// meshes at load by the engine's realization, as creatures are, with their normals and colours
// cooked in; drawn each frame from the meshes, so no field is evaluated per vertex or per pixel
// (AC4). Each is a creature of one bone, so it realizes as one.

use character::colours
use creature::{Creature, Skeleton, creature}
use light::{Lit}
use lit::{Lighting, shown, sun_and_gloss}
use look::{CreatureLook, Mesh as Tolerance}
use noise::{noise3, rand}
use realize::{Mesh, SkinVertex, realize_rigid}
use render::{ByChannels, Shaded}
use std::derive::Box3
use std::field::{Blend, Surface, fbm, oval}
use std::gpu::{ClipPosition, Flat, FragCoord, GpuBuffer, Unorm8x4, VertexIndex, discard}
use std::math::TAU
use std::transform::{rotate_y, translate}
use view::{Camera, ROCK}

/// What a point of a stone carries: its colour (linear).
pub struct Rock: Copy + GpuData + Blend {
    pub albedo: vec3,
}

impl Shaded for Rock {
    fn albedo(self) -> vec3 {
        self.albedo
    }

    fn roughness(self) -> f32 {
        0.8
    }
}

/// A stone's flat faces: the half-spaces it's cut by (each `dot(p, n) < w` for `n` in xyz),
/// their intersection's distance.
pub struct Facets: Copy + GpuData {
    pub planes: [vec4; 7],
}

impl Surface for Facets {
    fn distance(self, p: vec3) -> f32 {
        var d = -1.0e9
        for q in self.planes {
            d = max(d, dot(p, q.xyz) - q.w)
        }
        d
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// A stone's colour at a point of it, `r` across, seed `seed`: grey granite with a grain, each
/// facet a little its own tone, lichen in broad faint crusts where it faces the sky, and moss on
/// its top (round lichen spots and a noise's crack lines read as a leopard's and a maze).
pub struct Stain: Copy + GpuData {
    pub r: f32,
    pub seed: f32,
}

/// Granite's grain at `q` (0 to 1): three octaves, the coarsest the strongest.
pub fn grain(q: vec3) -> f32 {
    0.5 * noise3(q) + 0.3 * noise3(q * 3.1) + 0.2 * noise3(q * 9.7)
}

impl Stain {
    pub fn at(self, p: vec3) -> Rock {
        let q = p * (6.0 / self.r) + vec3(self.seed)
        var c = mix(vec3(0.22, 0.21, 0.20), vec3(0.36, 0.34, 0.31), vec3(grain(q)))
        // A fine speckle at a fixed scale, whatever the stone's size, faint.
        c *= 0.94 + 0.12 * noise3(p * 9.0 + vec3(self.seed))
        // Warmer and cooler in broad patches across it.
        c *= mix(
            vec3(0.95, 0.98, 1.03),
            vec3(1.05, 1.0, 0.93),
            vec3(noise3(p * (1.2 / self.r) + vec3(self.seed * 0.7))),
        )
        let top = p.y / self.r
        let crust = 0.7 * noise3(p * 1.1 + vec3(5.0, 2.0, 1.0) + vec3(self.seed)) +
            0.3 * noise3(p * 4.0 + vec3(self.seed))
        let lichen = smoothstep(0.5, 0.75, crust) * smoothstep(-0.2, 0.4, top)
        c = mix(c, vec3(0.42, 0.41, 0.30), vec3(lichen * 0.4))
        let moss = smoothstep(0.25, 0.65, top + 0.35 * (noise3(p * 2.5 + vec3(self.seed)) - 0.5))
        Rock { albedo: mix(c, vec3(0.10, 0.14, 0.035), vec3(moss * 0.6)) }
    }
}

/// A stone's field: an oval `radius` across, squashed by `squash`, lumpy (fractal noise), cut
/// by seven planes into facets, as weathered granite splits; and its colour.
pub type StoneField = std::field::Field<Rock>

/// A stone `radius` across, squashed by `squash`, seed `seed`, as a field.
pub fn stone_field(radius: f32, squash: vec3, seed: u32) -> StoneField {
    var planes = [vec4(0.0); 7]
    for k in 0..7 {
        let a = TAU * rand(seed, 20 + k)
        let z = rand(seed, 40 + k) * 1.6 - 0.5
        let n = normalize(vec3(cos(a), z, sin(a)))
        let h = radius * (0.78 + 0.18 * rand(seed, 60 + k))
        planes[k] = vec4(n * squash, h)
    }
    let stain = Stain { r: radius, seed: f32(seed) * 3.1 }
    // Lumps at its own scale, and the rock's own roughness at a fixed one (a big stone, smooth
    // at its own scale alone, read as clay in the lookbook).
    oval(squash * radius)
        .displace(
            fbm(freq: 1.7 / radius, octaves: 3, offset: vec3(f32(seed) * 3.1)),
            amp: 0.14 * radius,
        )
        .displace(fbm(freq: 2.2, octaves: 2, offset: vec3(f32(seed) * 1.7)), amp: 0.045)
        .intersect(Facets { planes })
        .with_at(|p| stain.at(p))
}

/// A stone as a creature of one bone (at its centre), to realize.
pub type Stone = Creature<Rock>

pub fn stone(radius: f32, squash: vec3, seed: u32) -> Stone {
    var s = Skeleton::new()
    let root = s.root("stone", vec3(0.0))
    // Its box: the oval's, grown by the lumps' reach (its facets bound nothing of their own).
    let half = squash * radius * 1.2 + vec3(0.02)
    creature(s).part(root, stone_field(radius, squash, seed)).bounded(Box3 { lo: -half, hi: half })
}

/// A stone realized: its mesh, its colours, and where it is (its rest space to the world).
pub struct Realized {
    pub mesh: Mesh,
    pub colours: GpuBuffer<Unorm8x4>,
    pub at: mat4,
    pub seed: u32,
}

/// A placement borrows one mesh from its owner. Its enclosing sphere is in world space.
pub struct Placement: Copy {
    pub prototype: u32,
    pub at: mat4,
    pub normal_at: mat3,
    pub reach: f32,
    pub seed: u32,
}

/// Repeated rigid stones: a small set of owned GPU meshes and plain placement data.
pub struct Instances {
    pub prototypes: Vec<Realized>,
    pub placements: Vec<Placement>,
}

impl Instances {
    pub fn shift(mut self, delta: vec3) {
        for mut p in self.placements {
            p.at[3] = vec4(p.at[3].xyz + delta, 1.0)
        }
    }
}

impl Placement {
    /// Whether this sphere meets an orthographic shadow volume (clip z is 0 to 1).
    pub fn casts_into(self, view: mat4) -> bool {
        let p = view * vec4(self.at[3].xyz, 1.0)
        let r = self.reach *
            vec3(
                length(vec3(view[0].x, view[1].x, view[2].x)),
                length(vec3(view[0].y, view[1].y, view[2].y)),
                length(vec3(view[0].z, view[1].z, view[2].z)),
            )
        abs(p.x) <= 1.0 + r.x && abs(p.y) <= 1.0 + r.y && p.z >= -r.z && p.z <= 1.0 + r.z
    }
}

/// A normal transforms by the inverse transpose, including when instances squash a mesh.
pub fn normal_matrix(at: mat4) -> mat3 {
    let a = at[0].xyz
    let b = at[1].xyz
    let c = at[2].xyz
    let cofactor = mat3(cross(b, c), cross(c, a), cross(a, b))
    let determinant = dot(a, cross(b, c))
    mat3(cofactor[0] / determinant, cofactor[1] / determinant, cofactor[2] / determinant)
}

@test
fn stone_instance_normals_stay_perpendicular_after_squashing() {
    let at = translate(vec3(4.0, 2.0, -7.0)) *
        rotate_y(0.7) *
        std::transform::scale(vec3(1.4, 0.35, 0.8))
    let normal = normalize(vec3(1.0, 1.0, 0.0))
    let tangent = vec3(1.0, -1.0, 0.0)
    let transformed = (at * vec4(tangent, 0.0)).xyz
    let n = normalize(normal_matrix(at) * normal)
    assert(abs(dot(n, transformed)) < 1.0e-5, "squashed stone normal leaned away from its surface")
    assert(abs(length(n) - 1.0) < 1.0e-5, "stone normal lost its unit length")
}

@test
fn repeated_stone_bounds_follow_the_origin_and_shadow_volume() {
    let identity = std::transform::scale(vec3(1.0))
    let p = Placement {
        prototype: 0,
        at: translate(vec3(1.3, 0.0, 0.5)),
        normal_at: normal_matrix(identity),
        reach: 0.4,
        seed: 7,
    }
    assert(p.casts_into(identity), "a caster overlapping a shadow edge was culled")
    let outside = Placement { at: translate(vec3(1.5, 0.0, 0.5)), ..p }
    assert(!outside.casts_into(identity), "a caster outside the shadow volume survived")
    var set = Instances { prototypes: Vec::new(), placements: Vec::from([p]) }
    set.shift(vec3(-1.3, 0.0, 0.0))
    let moved = set.placements[0]
    assert(length(moved.at[3].xyz - vec3(0.0, 0.0, 0.5)) < 1.0e-6, "origin shift lost a placement")
    assert(
        moved.prototype == p.prototype && moved.reach == p.reach,
        "origin shift changed mesh ownership",
    )
    assert(moved.casts_into(identity), "shifted caster lost its shadow")
}

/// The stone of `radius`, `squash` and `seed`, realized once (cells for an 8 mm tolerance, at
/// most 4 cm: a stone bends gently, and its stain varies over a sixth of its radius) at `at`
/// turned by `turn` about +y.
pub fn realize_stone(radius: f32, squash: vec3, seed: u32, at: vec3, turn: f32) -> Realized {
    realize_stone_within(
        radius,
        squash,
        seed,
        at,
        turn,
        CreatureLook { surface: Tolerance { tolerance: 8mm, largest: 4cm } },
    )
}

/// A reusable stone prototype, with a surface tolerance suited to its final displayed scale.
pub fn realize_stone_within(
    radius: f32,
    squash: vec3,
    seed: u32,
    at: vec3,
    turn: f32,
    look: CreatureLook,
) -> Realized {
    let s = stone(radius, squash, seed)
    let mesh = realize_rigid(s, look)
    let colours = colours(mesh, s.field(), ByChannels {}, cell: 1cm)
    Realized { mesh, colours, at: translate(at) * rotate_y(turn), seed }
}

/// What a stone's vertex passes on.
pub struct StoneVertex: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub normal: vec3,
    pub albedo: vec3,
    pub seed: Flat<u32>,
}

@vertex
pub fn stone_vertex(
    v: VertexIndex,
    verts: [SkinVertex],
    colours: [Unorm8x4],
    at: mat4,
    seed: u32,
    cam: Camera,
) -> StoneVertex {
    stone_point(v.index, verts, colours, at, mat3(at[0].xyz, at[1].xyz, at[2].xyz), seed, cam)
}

fn stone_point(
    index: u32,
    verts: [SkinVertex],
    colours: [Unorm8x4],
    at: mat4,
    normal_at: mat3,
    seed: u32,
    cam: Camera,
) -> StoneVertex {
    let sv = verts[index]
    let world = (at * vec4(sv.pos, 1.0)).xyz
    let c = colours[index].decode()
    StoneVertex {
        clip: ClipPosition { position: cam.clip(world) },
        world,
        normal: normal_at * sv.normal,
        albedo: c.rgb * c.rgb,
        seed: Flat { value: seed },
    }
}

/// An instance's inverse transpose is computed once on the CPU with its placement.
@vertex
pub fn stone_instance_vertex(
    v: VertexIndex,
    verts: [SkinVertex],
    colours: [Unorm8x4],
    at: mat4,
    normal_at: mat3,
    seed: u32,
    cam: Camera,
) -> StoneVertex {
    stone_point(v.index, verts, colours, at, normal_at, seed, cam)
}

@vertex
pub fn stone_shadow(v: VertexIndex, verts: [SkinVertex], at: mat4, view: mat4) -> ClipPosition {
    ClipPosition { position: view * (at * vec4(verts[v.index].pos, 1.0)) }
}

/// Whether a pixel belongs to a mesh's share of a transition. Both representations use the
/// same framebuffer pixel and frame, with adjacent shares, so one draws colour and depth at
/// each pixel. A whole share keeps the ordinary opaque path.
pub fn coverage_kept(coverage: vec2, pixel: vec2, frame: u32) -> bool {
    if coverage.x <= 0.0 && coverage.y >= 1.0 {
        return true
    }
    let anchor = vec2(f32(frame % 4), f32((frame / 4) % 4))
    lod::keeps_packed(lod::packed(vec4(coverage, anchor)), pixel)
}

@test
fn complementary_stone_meshes_cover_each_pixel_once() {
    for frame in 0..16 {
        for step in 0..33 {
            let split = f32(step) / 32.0
            for y in 0..4 {
                for x in 0..4 {
                    let pixel = vec2(f32(x) + 0.5, f32(y) + 0.5)
                    let near = coverage_kept(vec2(0.0, split), pixel, frame)
                    let far = coverage_kept(vec2(split, 1.0), pixel, frame)
                    assert(
                        near != far,
                        "mesh transition left a hole or shaded the same pixel twice",
                    )
                    if step == 0 { assert(!near && far, "zero share retained the near mesh") }
                    if step == 32 { assert(near && !far, "whole share retained the far mesh") }
                }
            }
        }
    }
}

/// A stone's pixel: its cooked normal and colour, lit by the world's light, darker where it
/// meets the ground.
@fragment
pub fn stone_shade(
    s: StoneVertex,
    pixel: FragCoord,
    lt: Lighting,
    coverage: vec2 = vec2(0.0, 1.0),
) -> vec4 {
    if !coverage_kept(coverage, pixel.position.xy, lt.cam.frame) {
        discard()
    }
    let n = normalize(s.normal)
    let (sun, sky, reflected) = sun_and_gloss(lt, s.world, n, soft: 1.0)
    let ground = probes::ground_under(lt.grid, lt.grounds, s.world.xz)
    let low = 0.4 + 0.6 * smoothstep(0.0, 0.5, s.world.y - ground)
    let lit = Lit {
        albedo: s.albedo,
        n,
        sun,
        sky: sky * low,
        through: vec3(0.0),
        rough: Rock { albedo: s.albedo }.roughness(),
        reflected: reflected * low,
        glint: 1.0,
    }
    let c = shown(lt, lit, s.world)
    vec4(c, ROCK + f32(s.seed.value % 63))
}

// ---- bedrock: a bed of rock as a solid ------------------------------------------------------------

/// A bed of rock as a solid: a prism its faces cut (each `dot(p, n) < w` for `n` in xyz, `n` of
/// unit length): its joints' planes round it, its bedding planes over and under it. Flat faces
/// and hard edges, which light can carve (rock as a heightfield draped where it should break).
pub struct Bed: Copy + GpuData {
    pub planes: [vec4; 9],
    /// A box it lies in, and its tone's seed.
    pub lo: vec3,
    pub hi: vec3,
    pub seed: u32,
}

impl Surface for Bed {
    fn distance(self, p: vec3) -> f32 {
        var d = -1.0e9
        for q in self.planes {
            d = max(d, dot(p, q.xyz) - q.w)
        }
        d
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

/// A bed's colour at `p` (in its own frame): granite of its own tone, one bed lighter or darker
/// than the next, a darker seam along its foot where the bed over it sits, faint streaks down
/// it where water runs. No spots, no crack lines: its form carries it.
pub fn bed_colour(b: Bed, p: vec3) -> Rock {
    let tone = 0.85 + 0.3 * rand(b.seed, 3)
    let g = grain(p * 0.9 + vec3(f32(b.seed) * 1.3))
    var c = tone * mix(vec3(0.30, 0.29, 0.27), vec3(0.40, 0.38, 0.34), vec3(g))
    // How far over its bedding plane under it `p` is (the last plane's: `-n` up, so `w - dot`).
    let under = b.planes[8]
    let above = -(dot(p, under.xyz) - under.w)
    c *= 0.82 + 0.18 * smoothstep(0.0, 0.5, above)
    let streak = noise3(vec3(p.x * 1.6, p.y * 0.12, p.z * 1.6) + vec3(f32(b.seed)))
    c *= 1.0 - 0.12 * smoothstep(0.6, 0.85, streak)
    Rock { albedo: c }
}

/// A bed as a creature of one bone, to realize.
pub fn bed(b: Bed) -> Creature<Rock> {
    var s = Skeleton::new()
    let root = s.root("bed", vec3(0.0))
    creature(s).part(root, b.with_at(|p| bed_colour(b, p))).bounded(Box3 { lo: b.lo, hi: b.hi })
}

/// Bed `b` realized at `at` (its frame's origin in the world): cells of about 45 cm (its faces
/// are planes; an edge rounds by about a cell), its colours a cell 25 cm.
pub fn realize_bed(b: Bed, at: vec3) -> Realized {
    let c = bed(b)
    let look = CreatureLook { surface: Tolerance { tolerance: 50cm, largest: 45cm } }
    let mesh = realize_rigid(c, look)
    let colours = colours(mesh, c.field(), ByChannels {}, cell: 25cm)
    Realized { mesh, colours, at: translate(at), seed: b.seed }
}
