// Lossless source visibility IDs in local palettes. Material attributes are reconstructed
// from the same resident cards and limbs used by the ordinary renderer; raster precision
// and uncompressed source values can differ from the BC representation. Opt-in and measured
// in docs/neural-source-identity-atlas.md. Every decoded ID is checked before activation.
use std::gpu::{
    Atomics, GlobalId, GpuBuffer, Rgba8, Texture, buffer, copy, dispatch, label, read, sampler,
}
use std::io::Pending
use vegetation::Kind
use impostor::source_ids

pub struct Packed { pub data: GpuBuffer<u32> }

fn source_key(ids: Texture<Rgba8>, at: vec2u) -> u32 {
    let v = vec4u(round(ids.load(at.x, at.y) * 255.0))
    let wide = v.x | (v.y << 8) | (v.z << 16) | (v.w << 24)
    (wide & 32767) | ((wide >> 31) << 15)
}

@compute(64)
fn encode(
    ids: Texture<Rgba8>,
    kind: u32,
    prefix: u32,
    out: mut Atomics<u32>,
    totals: mut Atomics<u32>,
    id: GlobalId,
) {
    let macro = vec2u(id.x % 128, id.x / 128) * 8
    let first = source_key(ids, macro)
    var same = true
    for i in 0..64 {
        if source_key(ids, macro + vec2u(i % 8, i / 8)) != first { same = false }
    }
    let at = kind * 16384 + id.x
    if same {
        out.store(at, 2147483648 | first)
        return
    }
    let children = totals.add(i: 0, value: 4) + prefix
    out.store(at, children)
    for child in 0..4 {
        let block = macro + vec2u(child % 2, child / 2) * 4
        var keys = [0; 16]
        var selectors = [0; 16]
        var count = 0
        for i in 0..16 {
            let key = source_key(ids, block + vec2u(i % 4, i / 4))
            var at = count
            for j in 0..count { if keys[j] == key { at = j } }
            if at == count {
                keys[count] = key
                count += 1
            }
            selectors[i] = at
        }
        if count == 1 {
            out.store(children + child, 2147483648 | keys[0])
        } else {
            let bits = if count <= 2 { 1 } else if count <= 4 { 2 } else if count <= 8 { 3 } else {
                4
            }
            let palette_words = (count + 1) / 2
            let index_words = (16 * bits + 31) / 32
            let offset = totals.add(i: 0, value: palette_words + index_words) + prefix
            out.store(children + child, ((count - 1) << 24) | offset)
            for j in 0..palette_words {
                out.store(offset + j, keys[j * 2] | (keys[j * 2 + 1] << 16))
            }
            var words = [0; 2]
            for i in 0..16 {
                let bit = i * bits
                let shift = bit % 32
                words[bit / 32] |= selectors[i] << shift
                if shift + bits > 32 { words[bit / 32 + 1] |= selectors[i] >> (32 - shift) }
            }
            for j in 0..index_words { out.store(offset + palette_words + j, words[j]) }
        }
    }
}

fn decoded(data: [u32], kind: u32, at: vec2u) -> u32 {
    let outer = data[(kind * 128 + at.y / 8) * 128 + at.x / 8]
    if (outer & 2147483648) != 0 { return outer & 65535 }
    let child = ((at.y & 7) / 4) * 2 + (at.x & 7) / 4
    let header = data[outer + child]
    if (header & 2147483648) != 0 { return header & 65535 }
    let count = ((header >> 24) & 15) + 1
    let offset = header & 16777215
    let bits = if count <= 2 { 1 } else if count <= 4 { 2 } else if count <= 8 { 3 } else { 4 }
    let bit = ((at.y & 3) * 4 + (at.x & 3)) * bits
    let shift = bit % 32
    let word = offset + (count + 1) / 2 + bit / 32
    var index = data[word] >> shift
    if shift + bits > 32 { index |= data[word + 1] << (32 - shift) }
    index &= (1 << bits) - 1
    (data[offset + index / 2] >> ((index & 1) * 16)) & 65535
}

@compute(64)
fn verify(ids: Texture<Rgba8>, kind: u32, data: [u32], totals: mut Atomics<u32>, id: GlobalId) {
    let at = vec2u(id.x % 1024, id.x / 1024)
    if source_key(ids, at) != decoded(data, kind, at) { totals.add(i: 1, value: 1) }
}

pub struct Build { raw: GpuBuffer<u32>, prefix: u32, pending: Pending<u32> }

pub struct Checking { pub packed: Packed, pending: Pending<u32> }

impl Build {
    pub fn new(kinds: [Kind], atlas: Texture<Rgba8>) -> Build {
        let prefix = kinds.len() * 16384
        var raw: GpuBuffer<u32> = buffer(prefix * 45)
        var totals: GpuBuffer<u32> = buffer(2)
        let s = sampler()
        for kind in 0..kinds.len() {
            borrow k = kinds[kind]
            assert(
                (k.card_count >> 2) < 32768 && k.limb_count * (plant::LIMB_VERTICES / 3) < 32768,
                "source identity exceeds16bits",
            )
            label("source identity raster")
            let ids = source_ids(
                k.impostor.bake,
                k.cards,
                k.card_count,
                k.limbs,
                k.limb_count,
                atlas,
                s,
            )
            label("source identity encode")
            dispatch(encode.bind(ids, kind, prefix, out: mut raw, totals: mut totals), over: 16384)
            label("source identity verify")
            dispatch(verify.bind(ids, kind, data: raw, totals: mut totals), over: 1048576)
        }
        let pending = read(totals.items())
        Build { raw, prefix, pending }
    }
    pub fn poll(mut self) -> Option<Vec<u32>> {
        match self.pending.poll() {
            Some(Ok(values)) => Some(take values),
            Some(Err(_)) => {
                assert(false, "source identity readback failed")
                None
            },
            None => None,
        }
    }
    pub fn finish(take self, payload_words: u32) -> Checking {
        let count = self.prefix + payload_words
        assert(count < 16777216, "source palette offset overflow")
        var data: GpuBuffer<u32> = buffer(count)
        copy(from: self.raw.span(start: 0, count: count), to: data.span_mut(start: 0, count: count))
        let errors: GpuBuffer<u32> = buffer(1)
        Checking { packed: Packed { data }, pending: read(errors.items()) }
    }
}

impl Checking {
    pub fn poll(mut self) -> Option<u32> {
        match self.pending.poll() {
            Some(Ok(values)) => Some(values[0]),
            Some(Err(_)) => {
                assert(false, "source identity fence failed")
                None
            },
            None => None,
        }
    }
}

/// Bounds for the15-bit per-kind source identities and24-bit packed word addresses.
pub fn fits(kinds: [Kind]) -> bool {
    if kinds.len() == 0 || kinds.len() > 22 { return false }
    for k in kinds {
        if (k.card_count >> 2) >= 32768 || k.limb_count * (plant::LIMB_VERTICES / 3) >= 32768 {
            return false
        }
    }
    true
}
