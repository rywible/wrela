// Timers: work due at a later tick, as data.
//
// `Timers` is generic over the game's action type, so pending timers are cloned, hashed and saved
// with the world, which a closure couldn't be: each closure has its own type, there's no `dyn` to
// put two in one `Vec`, and a closure has no `Serialize` (language.md §6.7).

use sim::{Sim, Tick}

pub struct Timers<A>: Sim {
    /// Sorted by when they're due, then by the order they were set.
    pending: Vec<Timer<A>>,
    next: u64,
}

pub struct Timer<A>: Sim {
    /// A tick, not a time: a loaded game fires on the same tick.
    pub due: Tick,
    /// Timers due on one tick fire in the order they were set.
    pub seq: u64,
    pub action: A,
}

impl<A: Clone> Timers<A> {
    pub fn new() -> Timers<A> {
        Timers { pending: Vec::new(), next: 0 }
    }

    /// Runs `action` `delay` seconds after tick `now`, where a tick is `dt` seconds long (the
    /// tick's input has it). An id for `cancel`.
    @deterministic
    pub fn after(mut self, now: Tick, delay: f32, dt: f32, action: take A) -> u64 {
        let due = now + u32(ceil(delay / dt))
        let n = self.pending.len()
        var at = n
        if n > 0 && self.pending[n - 1].due > due {
            // The first later timer: equal due ticks keep the order they were set in.
            var lo = 0
            var hi = n
            while lo < hi {
                let mid = lo + (hi - lo) / 2
                if self.pending[mid].due <= due {
                    lo = mid + 1
                } else {
                    hi = mid
                }
            }
            at = lo
        }
        let seq = self.next
        self.pending.insert(at, Timer { due, seq, action })
        self.next += 1
        seq
    }

    @deterministic
    pub fn cancel(mut self, seq: u64) {
        self.pending.retain(|t| t.seq != seq)
    }

    /// Removes the timers due by `now`, and returns them in order. The caller owns them, so
    /// an action that runs can set new timers.
    @deterministic
    pub fn take_due(mut self, now: Tick) -> Vec<Timer<A>> {
        var n = 0
        while n < self.pending.len() && self.pending[n].due <= now {
            n += 1
        }
        self.pending.drain_front(n)
    }

    pub fn len(self) -> u32 {
        self.pending.len()
    }
}

// ---- tests --------------------------------------------------------------------------------------

/// The old insertion, a linear search from the end, against which `after`'s search is checked.
fn reference(pending: mut Vec<Timer<u32>>, now: Tick, delay: f32, dt: f32, seq: u64) {
    let due = now + u32(ceil(delay / dt))
    var at = pending.len()
    while at > 0 && pending[at - 1].due > due {
        at -= 1
    }
    pending.insert(at, Timer { due, seq, action: u32(seq) })
}

fn same(timers: Timers<u32>, expected: [Timer<u32>]) {
    assert(timers.len() == expected.len(), "timer count changed")
    for k in 0..expected.len() {
        borrow a = timers.pending[k]
        borrow b = expected[k]
        assert(a.due == b.due && a.seq == b.seq && a.action == b.action, "timer order changed")
    }
}

/// Timers' search keeps what the old insertion gave: each timer's due tick, its sequence and
/// its action, in order, through cancellations and draining, in five patterns of delays.
@test
fn timer_search_preserves_due_ticks_sequence_and_cancellation() {
    for pattern in 0..5 {
        var timers = Timers::<u32>::new()
        var expected: Vec<Timer<u32>> = Vec::new()
        let now = if pattern == 4 { 4000000000 } else { 12 }
        for i in 0..256 {
            let delay = if pattern == 0 { f32(i) } else if pattern == 1 {
                f32(255 - i)
            } else if pattern == 2 { 3.25 } else { f32((i * 37) % 101) * 0.125 }
            let dt = if pattern == 3 { 0.125 } else { 0.5 }
            let seq = timers.after(now, delay, dt, action: i)
            assert(seq == u64(i), "timer id changed")
            reference(mut expected, now, delay, dt, seq)
            same(timers, expected)
            if i % 7 == 3 {
                let canceled = u64(i / 2)
                timers.cancel(canceled)
                expected.retain(|t| t.seq != canceled)
                same(timers, expected)
            }
        }
        for tick in 0..514 {
            var n = 0
            while n < expected.len() && expected[n].due <= now + tick {
                n += 1
            }
            let want = expected.drain_front(n)
            let got = timers.take_due(now + tick)
            assert(got.len() == want.len(), "due count changed")
            for k in 0..want.len() {
                assert(
                    got[k].due == want[k].due &&
                        got[k].seq == want[k].seq &&
                        got[k].action == want[k].action,
                    "due order changed",
                )
            }
            same(timers, expected)
        }
        assert(timers.len() == 0, "timers left pending")
    }
}
