// A bowed string instrument: four strings on one bridge, one of them bowed, heard through a
// body. A cello, a violin, a viola and a double bass are the same instrument with other strings
// and another body (`Fiddle`).
//
// Each string is two delay lines either side of a bow, whose hair sticks to the string and
// slips (McIntyre, Schumacher and Woodhouse, JASA 74(5), 1983; Smith, "Efficient simulation of
// the reed-bore and bow-string mechanisms", ICMC 1986). The friction's curve is the STK's bow
// table (Cook and Scavone, "The Synthesis ToolKit (STK)", ICMC 1999).
//
// It plays notes as a string player bows them (`Bowing`):
// - a note is played on the highest string whose open pitch is at or under it, as a hand in the
//   first position plays it. Its pitch is there at once: a finger comes down, or the bow goes to
//   another string; nothing slides;
// - a note that starts a new bow stops the one before: the bow slows almost to a stop and sets
//   off the other way. Notes under one slur share a bow, and only the finger changes (or the
//   bow goes to the next string);
// - every stroke starts with its string already in a bowed string's motion (one slip a period),
//   kept from when the player first tried the instrument and fitted to the string and the
//   speed: a string bowed from rest takes a tenth of a second to find that motion, and
//   scratches or breaks to its octave until it does;
// - a string that is left rings on if it is open, and dies as its finger lifts if it was
//   stopped; all four stand on one bridge, so each feels a little of the others' motion;
// - a stopped note held a while is given a vibrato.
// The bow's speed sets how loud, how hard it presses how bright. The player knows how loud each
// pitch comes out (having tried each), and an ear trims the bow to the level asked.
//
// Behind the instrument is a player (`bowings`, `Playing`): no note of a line is a slab. Each
// leans toward the next or falls away into silence, a long one swells, a line is louder as it
// climbs, a down-bow sinks and an up-bow grows, the vibrato is wider on a louder note and
// follows the bow through each note, a bow from silence starts more gently than one within
// the line, and the left hand moves to each note a moment before its time.
//
// The body is 96 modes, twelve an octave from 55 Hz, unevenly placed and weighted as a wooden
// box's are, each sixth of an octave of them set to a level (a `Fiddle`'s `body`) so that the
// instrument's notes have the harmonics a recording's have (the audio tool's `follow`). This
// began in content/cello as one of three ways to make a bowed string, played beside a recording
// of a cello: a filtered sawtooth and a set of measured harmonics were the others. This one was
// chosen by ear and the others are gone.

use perform::{Performance, deadpan}
use score::{NO_SLUR, Score, meter, score}
use tone::{Band, Noise, Svf, band, gain_of, key_hz, seeded}
use std::audio::SAMPLE_RATE
use std::collections::Vec
use std::math::{PI, TAU}

/// The audio thread's rate.
const RATE: f32 = f32(SAMPLE_RATE)

/// The body's bands, and the lowest's frequency (Hz): the audio tool's `track`'s.
pub const BANDS: u32 = 48
const LOWEST: f32 = 55.0

/// Band `j`'s frequency (Hz).
fn band_hz(j: u32) -> f32 {
    LOWEST * exp2(f32(j) / 6.0)
}

/// How hard a note at `db` is played, from 0 (-45 dB and under) to 1 (-10 dB and over).
@audio
fn hard(db: f32) -> f32 {
    clamp((db + 45.0) / 35.0, 0.0, 1.0)
}

/// The body's modes: twelve an octave from 55 Hz, over eight octaves. A wooden box answers at
/// its own resonances, each a few percent wide, with hollows between: a note's harmonics come
/// out uneven, one strong and its neighbour weak, and differently for every pitch. (A body of
/// 48 broad band filters gave every note the same evenly falling harmonics, a filtered
/// sawtooth's: in the recording a harmonic is 7.0 dB from the mean of its two neighbours, in
/// that body's cello 3.4 dB.) No cello's modes are measured here: the modes are placed and
/// weighted by a seeded scatter, a body's kind of irregularity, not one instrument's own, and
/// each band of two modes is then set to the level the recording shows over that band.
const MODES: u32 = 96
/// How far a mode strays from its even place (a share of a twelfth of an octave, either way),
/// and the weakest a mode is beside the strongest.
const STRAYS: f32 = 0.35
const WEAKEST: f32 = 0.4

/// How sharp a mode at `hz` is: broad at the bottom (6 at 55 Hz), sharper going up (30 from
/// 1.1 kHz), so that the body rings about 0.2 s at its lowest modes and under 0.1 s from 500 Hz
/// up. (With the low modes sharper, 10 at 55 Hz and 20 at 190 Hz, a low note rang on in the
/// body as loud as the note slurred after it for a tenth of a second, and the player, who
/// learns each pitch's loudness in a fifth of a second, took the low notes for quieter than
/// they are and played them 6 dB too loud.)
fn sharp(hz: f32, sharpest: f32) -> f32 {
    clamp(4.0 + 6.0 * log2(hz / 55.0), 6.0, sharpest)
}

/// What a mode at `centre`, `q` sharp, makes of a sine at `hz`: its real and imaginary parts.
fn answer(centre: f32, q: f32, hz: f32) -> vec2 {
    let w = tan(PI * hz / RATE) / tan(PI * centre / RATE)
    let k = 1.0 / q
    // j w k / (1 - w² + j w k)
    let (dr, di) = (1.0 - w * w, w * k)
    let den = dr * dr + di * di
    vec2(w * k * di / den, w * k * dr / den)
}

/// A body: modes side by side, their outputs summed. Each mode's frequency (Hz), how sharp
/// it is, and its gain (its sign is which way it pushes).
pub struct Body {
    hz: [f32; 96],
    q: [f32; 96],
    gains: [f32; 96],
    bands: [Band; 96],
    state: [Svf; 96],
}

/// A body whose mean response over each band (a sixth of an octave about `band_hz`) is `db`,
/// its modes scattered by the seed `wood`: another number is another body.
/// Band `b` holds modes `2 b` and `2 b + 1`. The modes overlap, so each band's gain is found
/// by trying: 40 times, each is moved by what its band is off (its mean power at nine
/// frequencies across it).
pub fn body(db: [f32; 48], wood: u32, sharpest: f32 = 30.0) -> Body {
    var grain = seeded(wood)
    var hz = [0.0; 96]
    var q = [0.0; 96]
    var weight = [0.0; 96]
    var bands = [Band {}; 96]
    for m in 0..MODES {
        hz[m] = LOWEST * exp2((f32(m) - 0.5 + STRAYS * grain.next()) / 12.0)
        q[m] = sharp(hz[m], sharpest)
        // How strong it is beside its band's other mode, and which way it pushes: two
        // neighbours pushing the same way leave a hollow between them.
        let strength = WEAKEST + (1.0 - WEAKEST) * abs(grain.next())
        weight[m] = if grain.next() < 0.0 { -strength } else { strength }
        bands[m] = band(hz: hz[m], q: q[m])
    }
    var level = [0.0; 48]
    for b in 0..BANDS {
        level[b] = gain_of(db[b])
    }
    for _ in 0..40 {
        var got = [0.0; 48]
        for b in 0..BANDS {
            var power = 0.0
            for i in 0..9 {
                let at = band_hz(b) * exp2((f32(i) - 4.0) / 54.0)
                var sum = vec2(0.0)
                for m in 0..MODES {
                    sum += level[m / 2] * weight[m] * answer(hz[m], q[m], at)
                }
                power += sum.x * sum.x + sum.y * sum.y
            }
            got[b] = sqrt(power / 9.0)
        }
        for b in 0..BANDS {
            level[b] *= clamp(gain_of(db[b]) / max(got[b], 1e-9), 0.25, 4.0)
        }
    }
    var gains = [0.0; 96]
    for m in 0..MODES {
        gains[m] = level[m / 2] * weight[m]
    }
    Body { hz, q, gains, bands, state: [Svf {}; 96] }
}

impl Body {
    /// Stills it: what it was ringing with is gone.
    pub fn still(mut self) {
        self.state = [Svf {}; 96]
    }

    /// How much of a sine at `hz` comes through (1 is all of it).
    pub fn answers(self, hz: f32) -> f32 {
        var sum = vec2(0.0)
        for m in 0..MODES {
            sum += self.gains[m] * answer(self.hz[m], self.q[m], hz)
        }
        length(sum)
    }

    /// `x` through the body.
    @audio
    pub fn pass(mut self, x: f32) -> f32 {
        var y = 0.0
        for m in 0..MODES {
            y += self.gains[m] * self.state[m].pass(self.bands[m], x)
        }
        y
    }
}

/// An instrument: its four strings' pitches open (Hz, low to high), the lowest pitch its
/// player learns (Hz: the player knows the 48 semitones from it), its body's bands (dB) and the
/// seed its modes are scattered by, the level of the whole (dB), and the frequency (Hz) below
/// which nothing is wanted of it (two high-passes there, together a fourth-order one, take what
/// rumble the strings' lowest motion leaves).
pub struct Fiddle: Copy {
    pub open: [f32; 4],
    pub lowest: f32,
    pub body: [f32; 48],
    pub wood: u32 = 1007,
    pub gain: f32 = 0.0,
    pub floor: f32 = 55.0,
    /// The harmonic from which a note brightens with how hard it is played (`BRIGHTENS`): a
    /// cello's sixth, a violin's ninth, as their recorded notes show; a viola's and a double
    /// bass's are taken from those two, not measured.
    pub bright_from: f32 = 6.0,
    /// The sharpest its body's modes are. A small body's modes crowd together higher up, and
    /// its answer there is smoother than a few sharp modes give: a violin's recorded notes have
    /// each harmonic 5.3 dB from the mean of its neighbours, and with modes as sharp as a
    /// cello's the violin here had 7.7 dB.
    pub sharpest: f32 = 30.0,
    /// How strong the body's grain is beside the sound itself (0: none). At 0.7 a violin's
    /// harmonics were 7.6 dB from the mean of their neighbours where its recorded notes' are
    /// 5.3 dB: too rough an answer, a comb's.
    pub grain: f32 = 0.3,
    /// Its players' vibrato: the rate (Hz) and the depth (cents either way). A cellist's by
    /// default; a violinist's is some 6.3 Hz and a quarter of a semitone either way (Seashore's
    /// measurements of violinists: about 6.5 Hz and a quarter tone from bottom to top).
    pub sway_hz: f32 = 5.6,
    pub sway_cents: f32 = 14.0,
    /// How uneven the hair's pull is all through a stroke: the bow's speed is this share of
    /// itself up and down (RMS) from moment to moment, as fast as the string (`CATCH_PITCH`). Under a high
    /// note's fundamental a recorded violin is not silent: from 250 Hz (where its body starts
    /// to sound) up to the note, each third of an octave has 31 to 44 dB less than the note, a
    /// bed the body makes of the bow's unevenness. With a steady bow the violin here had 43 to
    /// 54 dB less, 9 to 12 dB short, and an ear called it not full, with a synthesizer's edge:
    /// one wave, the same every period. At this it has the recorded notes' bed within 3 dB,
    /// band by band. (More of the hair's hiss, `ROSIN` at four times this, raised the bed 5 dB
    /// and no further, and was over the recorded notes' hiss higher up.) Measured on the
    /// violin's notes only; the viola's and the double bass's take the same on trust.
    ///
    /// This is its size at `MF`. The hair's unevenness doesn't fall away as the bow slows: for
    /// each dB a note is under `MF` it is `BREATHES` dB more of the bow's speed (and as much
    /// less over it), so the bed stays about where it is while the note comes and goes. A
    /// recorded violin's soft note is breathy: under its fundamental each third of an octave
    /// has 27 to 36 dB less than the note at pianissimo, 35 to 45 at mezzo-forte and 53 to 62
    /// at fortissimo. (With the bed falling away with the note, a soft note here was a clean
    /// tone with one vibrato, 43 to 47 dB over its bed: what an ear twice picked out, by the
    /// second, as "very synthy". It has 29 to 35 dB less now at pianissimo.)
    pub coarse: f32 = 0.024,
    /// Each string's own colour, lowest string first, for what one body can't give them all:
    /// how much more of the string's harmonics there is over its fundamental (`richness`, dB,
    /// from `RICH_FROM` times the note's pitch up), and how much more it gives above
    /// `BRILLIANT_FROM` Hz (`brilliance`, dB; under 0, less). A violin's strings are not one
    /// string at four tunings: its E is plain steel and far brighter than its wound strings,
    /// and note for note its recorded A and G strings have their harmonics 6 to 9 dB further
    /// over the fundamental than a body voiced to the middle of all its notes gave them here.
    /// (The violin's notes on its A string had their second to sixth harmonics 14, 6, 7, 10
    /// and 16 dB weaker beside the fundamental than the same notes recorded on a violin's A
    /// string: nearly plain tones. An ear picked out one of them, a held E flat, as "very
    /// synthy", and had heard the higher notes edge back toward a synthesizer: on the E
    /// string a note had 10 dB less than a recorded one from 5 to 12 kHz. With these the
    /// middle of each string's notes is within 5 dB of the recorded string's, harmonic by
    /// harmonic to the sixth, and within 3 dB by band above.)
    ///
    /// A string's richness is a loud note's. It is all there from `MF` up, none `RICH_OVER`
    /// dB under, and turned the other way below that (as far under as it was over): a recorded
    /// violin's A string played pianissimo has its second to eighth harmonics 6 to 12 dB lower
    /// beside the fundamental than at mezzo-forte, and no higher at fortissimo. (Given the
    /// same richness at every level, a soft note had a loud note's harmonics, its fundamental
    /// 9 dB under the whole where a recorded soft note's leads: an ear heard that as a
    /// synthesizer too.)
    pub brilliance: [f32; 4] = [0.0; 4],
    pub richness: [f32; 4] = [0.0; 4],
    /// The samples of a string's period that lie between the bow and the bridge but in no
    /// delay line (the bridge's own delay): counted, they keep the bow at `BOW_AT` of the
    /// string however short it is. Left out (0), the bow sits further along a short string: a
    /// sixth of the way on a violin's notes over 600 Hz, where a player's bow is nearer a tenth,
    /// and the sixth harmonic of each of those notes was 28 to 32 dB under its strongest, a
    /// hole where a recorded note has 0 to 17 dB. The bridge's delay is about 2.5 samples; at
    /// that a violin's G5 started at its octave and three notes spoke late, so the violin
    /// counts 1.5, which brings the sixth harmonics back to 12 to 17 dB under and leaves every
    /// note speaking as it did. The cello counts none: it was called finished as it is.
    pub bridge_side: f32 = 0.0,
    /// How unsteady the arm is: the bow's speed drifts by this share of itself (RMS), and its
    /// weight with it (by `WEIGHS` dB for all of the speed: what the string gives above its
    /// fundamental and above the brightness's corner comes and goes), both as slowly as
    /// `UNSTEADY_HZ`. Held without vibrato, a recorded violin's note is not still: each of its
    /// first six harmonics moves 0.5 to 1.5 dB (RMS, over 40 ms, its slow drift taken off; 2
    /// to 5 dB on some notes), mostly not together. With a steady arm the violin's here moved
    /// 0.1 to 0.3 dB: one wave held, which an ear named exactly, "that regular oscillation
    /// classic synthy sound". At this they move 0.5 to 1.2 dB. (A sharper body, a larger
    /// tremble of the pitch and a rougher bow's place were each tried first and moved them
    /// under 0.2 dB more.) The cello's arm is steady: it was called finished so.
    pub unsteady: f32 = 0.0,
}

/// A cello: C2, G2, D3 and A3. Its body, like the other instruments' here, is voiced to notes
/// recorded in an anechoic chamber (docs/citations.md, the dry references): the instrument
/// plays its chromatic scale at `MF`, each note's harmonics are set beside the recorded note's
/// (the audio tool's `follow`), and each band is moved toward the middle of what its harmonics
/// are off, smoothly from band to band (no band more than 8 dB from the mean of its
/// neighbours), until they agree: to 1.4 dB by band. (Its first body was set the same way
/// against a recording of the Prelude made in a room, and had that recording's colour: thin
/// from 140 to 250 Hz. An ear found this one the more natural.)
pub const CELLO: Fiddle = Fiddle {
    open: [65.41, 98.0, 146.83, 220.0],
    lowest: 55.0,
    body: [
        -39.75, -35.06, -29.70, -27.16, -21.45, -14.05, -8.85, -4.94, -5.08, 9.59, 10.41, 12.91,
        8.20, -2.13, 3.54, 7.46, 1.83, 8.18, 1.30, 4.67, 5.94, -2.48, 4.25, 4.07, -1.98, -4.35,
        0.38, -2.73, -5.20, -0.94, -5.22, -6.69, 0.80, -2.39, -6.63, -9.88, -13.42, -19.36, -15.72,
        -16.01, -14.52, -16.63, -17.40, -13.56, -16.74, -16.91, -14.25, -15.75,
    ],
    gain: -0.60,
    // Its recorded notes brighten from about their sixth harmonic. This is lower by an ear's
    // choice: the take of the Prelude that an ear called almost perfect was made when every
    // note brightened from 1.2 kHz up, and from here the cello is within a decibel of it.
    bright_from: 3.5,
    // No grain: an ear called this cello finished without it (and, hearing it both ways,
    // asked for nothing more).
    grain: 0.0,
    // A steady bow: this cello was called finished with one.
    coarse: 0.0,
}

/// A violin: G3, D4, A4 and E5, voiced as the cello is (to 1.0 dB by band).
pub const VIOLIN: Fiddle = Fiddle {
    open: [196.0, 293.66, 440.0, 659.26],
    lowest: 195.998,
    body: [
        -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04, -4.04,
        -4.04, -0.68, 2.68, 1.69, 6.28, 4.55, 2.59, 3.63, -11.32, -10.57, 4.67, 3.91, -5.94, -4.60,
        -2.99, -1.82, -0.33, 3.23, 7.38, 4.95, -0.78, -1.15, 2.72, 3.94, 5.11, 2.19, -5.82, -6.39,
        -7.46, -10.57, -11.15, -13.06, -12.25, -7.22, -4.04,
    ],
