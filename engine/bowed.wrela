/// A double bass: E1, A1, D2 and G2, voiced as the cello is (to 1.1 dB by band).
pub const BASS: Fiddle = Fiddle {
    open: [41.2, 55.0, 73.42, 98.0],
    lowest: 41.203,
    body: [
        -2.20, 9.99, 15.32, 9.99, 14.29, 15.32, 15.32, 15.32, 14.95, 6.79, 10.06, 11.31, 6.94, 6.11,
