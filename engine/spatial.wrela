// Spatial queries (sketch 03 §3): a grid of positions copied at the start of a tick (D-085),
// so a system reads them while the entities themselves change. Built in iteration order and
// sorted by cell, ties kept in that order, so its answers depend on nothing but the positions.
// There are no iterator types: a query takes a closure (`each_within`) or returns an owned
// `Vec` (`within`), language.md §6.6. A grid kept in the world and rebuilt each tick
// (`rebuild`) reuses its buffers, so a steady tick allocates nothing for it (#43 §5.2).

use sim::{Sim, SimState}
use std::arena::{Arena, Handle}
use std::hash::StateHash
use std::serialize::Serialize

/// What a query found: an entity's handle, and where it was when the grid was built.
pub struct Found<T>: Copy {
    pub handle: Handle<T>,
    pub pos: vec3,
}

/// A grid entry: its cell's key, its order in the arena, and what it holds.
struct Entry<T>: Copy + StateHash + Serialize + SimState {
    key: u32,
    order: u32,
    handle: Handle<T>,
    pos: vec3,
}

/// Positions in cells `cell` metres wide, sorted by cell; and the sort's room, which holds no
/// elements (it hashes, saves and clones empty).
pub struct SpatialGrid<T>: Sim {
    cell: f32,
    entries: Vec<Entry<T>>,
    room: Vec<u8>,
}

/// A cell's key: its coordinates, hashed. Two cells may share one, so queries check distances.
fn key_of(c: vec3i) -> u32 {
    let u = vec3u(c)
    let h = u.x.wrapping_mul(73856093) ^ u.y.wrapping_mul(19349663) ^ u.z.wrapping_mul(83492791)
    h ^ (h >> 16)
}

fn cell_of(p: vec3, cell: f32) -> vec3i {
    vec3i(floor(p / cell))
}

/// Whether `a` goes before `b`: by key, then by order.
fn before<T>(a: Entry<T>, b: Entry<T>) -> bool {
    a.key < b.key || (a.key == b.key && a.order < b.order)
}

impl<T> SpatialGrid<T> {
    /// An empty grid of cells `cell` metres wide.
    pub fn new(cell: f32) -> SpatialGrid<T> {
        SpatialGrid { cell, entries: Vec::new(), room: Vec::new() }
    }

    /// A grid of `items`' positions, `pos(item)`, in cells `cell` metres wide.
    pub fn build(items: Arena<T>, pos: fn(T) -> vec3, cell: f32) -> SpatialGrid<T> {
        var grid = SpatialGrid::new(cell)
        grid.rebuild(items, pos)
        grid
    }

    /// The grid of `items`' positions now, in the buffers it had: once they've grown to size,
    /// nothing is allocated.
    pub fn rebuild(mut self, items: Arena<T>, pos: fn(T) -> vec3) {
        self.entries.clear()
        var order = 0
        for x in items {
            let p = pos(x)
            let key = key_of(cell_of(p, self.cell))
            self.entries.push(Entry { key, order, handle: items.handle_at(order), pos: p })
            order += 1
        }
        self.entries.sort_by_in(|a, b| before(a, b), mut self.room)
    }

    pub fn len(self) -> u32 {
        self.entries.len()
    }

    /// The first entry whose key isn't below `key`.
    fn first_at(self, key: u32) -> u32 {
        var lo = 0
        var hi = self.entries.len()
        while lo < hi {
            let mid = (lo + hi) / 2
            if self.entries[mid].key < key {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        lo
    }

    /// Calls `f` with each entity within `radius` of `p`, cell by cell.
    pub fn each_within(self, p: vec3, radius: f32, f: fn(Found<T>)) {
        let r = i32(ceil(radius / self.cell))
        let c = cell_of(p, self.cell)
        let r2 = radius * radius
        for dz in -r..r + 1 {
            for dy in -r..r + 1 {
                for dx in -r..r + 1 {
                    let key = key_of(c + vec3i(dx, dy, dz))
                    var i = self.first_at(key)
                    while i < self.entries.len() && self.entries[i].key == key {
                        let e = self.entries[i]
                        let d = e.pos - p
                        if dot(d, d) <= r2 {
                            f(Found { handle: e.handle, pos: e.pos })
                        }
                        i += 1
                    }
                }
            }
        }
    }

    /// The entities within `radius` of `p`: a small owned `Vec`.
    pub fn within(self, p: vec3, radius: f32) -> Vec<Found<T>> {
        var out: Vec<Found<T>> = Vec::new()
        self.each_within(p, radius, |x| out.push(x))
        out
    }

    /// The entity nearest `p`, if one is within `within`. Of equally near ones, the first in
    /// the grid's order.
    pub fn closest(self, p: vec3, within: f32) -> Option<Found<T>> {
        var best: Option<Found<T>> = None
        var nearest = within * within
        self.each_within(p, within, |x| {
            let d = dot(x.pos - p, x.pos - p)
            if d < nearest || (d == nearest && best.is_none()) {
                nearest = d
                best = Some(x)
            }
        })
        best
    }
}
