// Hand-posed keys for a body's fight moves: an animator's poses, each set where the body's
// parts go (the hips' drop and turn, the trunk's twist, each fist's spot and which way its
// elbow points, each foot's ball on the floor, its heel up or down), and when, and how the body
// comes into each (easing out of the last, snapping into it, settling, or holding). The arms and
// legs reach for their spots (two-bone IK), so a pose stays put on its feet, and a fist goes
// where it's put between keys, not round some arc a blend of turns would draw.
//
// Pose to pose, after the way hand-keyed fighting-game moves are timed: a wind-up and a tell
// eased into, a held beat the eye reads, a strike snapped into in a few frames, a pause on
// contact, then the follow-through and recovery settled out of.

use std::collections::Vec
use humanoid::{Clip, NONE, Pose, Rig, Rigid, arc}
use stride::{about, curled_hands, leg_of, reach, turn_below, turn_under}

const DEG: f32 = 0.017453292
const PI: f32 = 3.14159265

/// An elbow's hinge, for a body bound in a T-pose: the axis it bends about is the body's up
/// leaned this far ahead (degrees), the left arm's the other way round. Measured: the axes
/// real elbows bent about in captured takes on Quaternius's body (content/humanoid's
/// `accad_fists::REAL`, read by `engine::arms`) are 38 degrees (the left) and 29 (the right)
/// off straight up.
pub const ELBOW_LEAN: f32 = 33.5

/// How a body comes into a key from the one before: evenly (`LINEAR`), easing out of the last
/// and into this (`SMOOTH`), gathering speed all the way and stopped dead by it (`SNAP`: a
/// strike into its contact), setting off fast and settling into it (`SETTLE`), or held at the
/// last until this, then there at once (`STEP`).
pub const LINEAR: u32 = 0
pub const SMOOTH: u32 = 1
pub const SNAP: u32 = 2
pub const SETTLE: u32 = 3
pub const STEP: u32 = 4

/// A key: when (s), how it's come into (`ease`), and the pose, in the body's space (x its
/// left, y up, z ahead; m and degrees):
/// - `hips`: how far the hips move from where they stand at rest (a drop, a shift of weight),
///   and `hips_turn`, how they turn (x pitch forward, y yaw toward the left, z roll);
/// - `trunk`: how the trunk turns above the hips, shared among the spine's three bones;
/// - `look`: a spot the head looks at (the neck takes half the turn);
/// - `collars`: each collar's turn (left, right), a shoulder brought up or forward;
/// - `fists`: where each wrist goes (left, right), `elbows` which way each elbow points, and
///   `rolls` each forearm's roll about itself (degrees);
/// - `feet`: each foot's ball on the floor (x, z), its yaw (toes toward the left) and its heel
///   lifted (degrees, about the ball), and `lifts`, how high each ball's off the floor (m: a
///   hop, a step's swing); `swing`, how high a foot that moves along the floor into this key
///   lifts on its way, at most half way (m: a step taken between two keys);
/// - `travel`: where the body's got to along the floor since the move began (its root, which
///   gameplay carries; everything else is set where it is from the move's start).
pub struct Key: Copy {
    pub at: f32,
    pub ease: u32 = SMOOTH,
    pub hips: vec3 = vec3(0.0),
    pub hips_turn: vec3 = vec3(0.0),
    pub trunk: vec3 = vec3(0.0),
    pub look: vec3 = vec3(0.0, 1.6, 3.0),
    pub collars: [vec3; 2] = [vec3(0.0); 2],
    pub fists: [vec3; 2],
    pub elbows: [vec3; 2] = [vec3(0.0, -1.0, 0.0); 2],
    pub rolls: [f32; 2] = [0.0; 2],
    pub feet: [vec4; 2],
    pub lifts: [f32; 2] = [0.0; 2],
    pub swing: f32 = 0.0,
    pub travel: vec3 = vec3(0.0),
}

/// Foot `f` (a key's: where it stands along the floor, its turn and its heel's lift) where it
/// stands, turned `yaw` and its heel up `heel` (degrees): a foot that pivots or rises where it is.
pub fn turned_foot(f: vec4, yaw: f32, heel: f32) -> vec4 {
    vec4(f.x, f.y, yaw, heel)
}

/// `k` moved along the floor by `by`: its hips, fists, feet, look and travel.
pub fn shifted(k: Key, by: vec3) -> Key {
    var out = k
    out.hips += by
    out.look += by
    out.travel += by
    for i in 0..2 {
        out.fists[i] += by
        out.feet[i] = out.feet[i] + vec4(by.x, by.z, 0.0, 0.0)
    }
    out
}

/// `x` eased from 0 to 1 as `ease` says.
pub fn eased(ease: u32, x: f32) -> f32 {
    let u = clamp(x, 0.0, 1.0)
    match ease {
        LINEAR => u,
        SNAP => u * u * u,
        SETTLE => 1.0 - (1.0 - u) * (1.0 - u) * (1.0 - u),
        STEP => if u >= 1.0 { 1.0 } else { 0.0 },
        _ => u * u * (3.0 - 2.0 * u),
    }
}

/// Two keys mixed: `a` where `t` is 0, `b` where it's 1 (`b`'s time and ease).
/// An elbow's pole between `a`'s and `b`'s: their mix's direction, or the nearer key's where
/// the two point opposite ways and their mix has none.
fn pole(a: vec3, b: vec3, t: f32) -> vec3 {
    let v = a + (b - a) * t
    if length(v) < 1.0e-4 {
        return if t < 0.5 { a } else { b }
    }
    normalize(v)
}

pub fn mixed(a: Key, b: Key, t: f32) -> Key {
    let m = |x: vec3, y: vec3| -> vec3 { x + (y - x) * t }
    let m4 = |x: vec4, y: vec4| -> vec4 { x + (y - x) * t }
    Key {
        at: b.at,
        ease: b.ease,
        hips: m(a.hips, b.hips),
        hips_turn: m(a.hips_turn, b.hips_turn),
        trunk: m(a.trunk, b.trunk),
        look: m(a.look, b.look),
        collars: [m(a.collars[0], b.collars[0]), m(a.collars[1], b.collars[1])],
        fists: [m(a.fists[0], b.fists[0]), m(a.fists[1], b.fists[1])],
        elbows: [
            pole(a.elbows[0], b.elbows[0], t),
            pole(a.elbows[1], b.elbows[1], t),
        ],
        rolls: [
            a.rolls[0] + (b.rolls[0] - a.rolls[0]) * t,
            a.rolls[1] + (b.rolls[1] - a.rolls[1]) * t,
        ],
        feet: [m4(a.feet[0], b.feet[0]), m4(a.feet[1], b.feet[1])],
        lifts: [
            a.lifts[0] + (b.lifts[0] - a.lifts[0]) * t + swung(a.feet[0], b.feet[0], b.swing, t),
            a.lifts[1] + (b.lifts[1] - a.lifts[1]) * t + swung(a.feet[1], b.feet[1], b.swing, t),
        ],
        swing: b.swing,
        travel: m(a.travel, b.travel),
    }
}

/// How high a foot going from `a` to `b` (a key's foot) is lifted `t` of its way, a key's
/// `swing` high half way: none for a foot that stays where it is.
fn swung(a: vec4, b: vec4, swing: f32, t: f32) -> f32 {
    if length(b.xy - a.xy) < 0.01 { 0.0 } else { swing * 4.0 * t * (1.0 - t) }
}

/// A turn by `d` degrees: pitch (about x), then yaw (about y), then roll (about z), in the
/// body's space.
fn turn_of(d: vec3) -> Quat {
    about(vec3(0.0, 1.0, 0.0), d.y * DEG)
        .mul(about(vec3(1.0, 0.0, 0.0), d.x * DEG))
        .mul(about(vec3(0.0, 0.0, 1.0), d.z * DEG))
}

/// The elbow's spot for a shoulder at `s` reaching a wrist at `t` with an upper arm `l1` and a
/// forearm `l2` long, bent toward `pole`; and how far the wrist is put (short of the reach).
fn elbow_at(s: vec3, t: vec3, l1: f32, l2: f32, pole: vec3) -> (vec3, vec3) {
    let to = t - s
    let d = clamp(length(to), abs(l1 - l2) + 1.0e-3, (l1 + l2) * 0.999)
    let u = normalize(to)
    let a = (l1 * l1 - l2 * l2 + d * d) / (2.0 * d)
    let h = sqrt(max(l1 * l1 - a * a, 0.0))
    var n = pole - u * dot(pole, u)
    if length(n) < 1.0e-4 {
        n = vec3(0.0, -1.0, 0.0) - u * dot(vec3(0.0, -1.0, 0.0), u)
    }
    (s + u * a + normalize(n) * h, s + u * d)
}

/// The pose key `k` sets: its parts set from the rest down (hips, trunk, collars, head), then
/// each arm and leg reaching for its spot.
pub fn posed(rig: Rig, k: Key) -> Pose {
    // (The bones in arrays, not `Vec`s: a solve's derivation follows an array alone, so a
    // pose keeps its derivative by the key's numbers: `humanoid::Frames`.)
    let rw = rig.rest_frames()
    let parents = rig.parents()
    var w = rw
    let nb = rig.bones.len()
    let find = |n: str| -> u32 { rig.find(n) }
    let hips = find("hips")
    turn_under(parents, nb, mut w, hips, turn_of(k.hips_turn))
    for b in 0..nb {
        w[b].t += k.hips
    }
    // The trunk: its turn shared among the spine's bones, each about its own place.
    let spine = [find("spine"), find("chest"), find("upperChest")]
    var shares = 0.0
    for b in spine {
        if b != NONE {
            shares += 1.0
        }
    }
    for b in spine {
        if b != NONE {
            turn_under(parents, nb, mut w, b, turn_of(k.trunk / max(shares, 1.0)))
        }
    }
    let collars = [find("leftShoulder"), find("rightShoulder")]
    for i in 0..2 {
        if collars[i] != NONE {
            turn_under(parents, nb, mut w, collars[i], turn_of(k.collars[i]))
        }
    }
    // The head: the neck turned half way to the spot, the head the rest.
    let (neck, head) = (find("neck"), find("head"))
    if neck != NONE && head != NONE {
        let ahead = rw[head].q.inverse().rotate(vec3(0.0, 0.0, 1.0))
        let to = k.look - w[head].t
        let r = arc(w[head].q.rotate(ahead), to)
        let half = Quat::identity().nlerp(r, 0.5)
        turn_under(parents, nb, mut w, neck, half)
        turn_under(parents, nb, mut w, head, arc(w[head].q.rotate(ahead), to))
    }
    // The arms, each reaching its wrist to its fist's spot, its elbow toward its pole.
    let arms = [
        [find("leftUpperArm"), find("leftLowerArm"), find("leftHand")],
        [find("rightUpperArm"), find("rightLowerArm"), find("rightHand")],
    ]
    for i in 0..2 {
        let (u, l, h) = (arms[i][0], arms[i][1], arms[i][2])
        if u != NONE && l != NONE && h != NONE {
            let l1 = length(rw[l].t - rw[u].t)
            let l2 = length(rw[h].t - rw[l].t)
            let (e, t) = elbow_at(w[u].t, k.fists[i], l1, l2, k.elbows[i])
            turn_under(parents, nb, mut w, u, arc(w[l].t - w[u].t, e - w[u].t))
            // The forearm's turn as the plain reach leaves it (the upper arm aimed at the elbow,
            // the forearm at the wrist), before the upper arm is twisted: the hand faces as the
            // key wrote it, and the twist below doesn't carry down to it.
            var plain = w
            turn_under(parents, nb, mut plain, l, arc(plain[h].t - plain[l].t, t - plain[l].t))
            let written = plain[l].q
            // The upper arm turned about its own length till the elbow bends about its hinge:
            // the reach above puts the elbow where it's asked, by the shortest turn, which
            // leaves the upper arm's twist to chance and the elbow bent across its hinge (an
            // arm that looks wrung). A leg's reach keeps its knee's hinge (`stride::reach`);
            // this keeps the elbow's.
            let along = normalize(e - w[u].t)
            let bend = cross(along, t - e)
            let side = if i == 0 { -1.0 } else { 1.0 }
            let lean = ELBOW_LEAN * DEG
            let hinge = rw[u].q.inverse().rotate(vec3(0.0, cos(lean), sin(lean)) * side)
            let has = w[u].q.rotate(hinge)
            let flat = has - along * dot(has, along)
            if length(bend) > 1.0e-5 && length(flat) > 1.0e-4 {
                let (want, now) = (normalize(bend), normalize(flat))
                // Whole: what a body is drawn with spreads an upper arm's twist along it (a
                // charted arm's `engine::chart::Chain::spread`, a skin's twist steps,
                // `humanoid::SPREAD`), so the shoulder doesn't take it all and wring.
                let twist = atan2(dot(cross(now, want), along), dot(now, want))
                turn_under(parents, nb, mut w, u, about(along, twist))
            }
            turn_under(parents, nb, mut w, l, arc(w[h].t - w[l].t, t - w[l].t))
            // The forearm turned back about its own length to the plain reach's turn (both aim
            // it at the wrist, so only its roll differs): what the upper arm's twist would have
            // turned the hand by is the forearm's own roll, as a person's forearm turns along its
            // length from elbow to wrist, and the elbow still bends about its hinge.
            turn_under(parents, nb, mut w, l, written.mul(w[l].q.inverse()))
            turn_under(parents, nb, mut w, l, about(normalize(t - e), k.rolls[i] * DEG))
        }
    }
    // The legs: each foot set on its ball, turned and its heel up as said, the leg reaching
    // its ankle there, the knee bending about the shin's left.
    for i in 0..2 {
        let l = leg_of(rig, if i == 0 { 1.0 } else { -1.0 })
        let f = k.feet[i]
        let yaw = about(vec3(0.0, 1.0, 0.0), f.z * DEG)
        let heel = about(yaw.rotate(vec3(1.0, 0.0, 0.0)), f.w * DEG)
        let q = heel.mul(yaw)
        // (A leg with no toes plants its ankle.)
        let toe = if l.toes != NONE { l.toes } else { l.ankle }
        let ball = vec3(f.x, rw[toe].t.y + k.lifts[i], f.y)
        let ankle = ball + q.rotate(rw[l.ankle].t - rw[toe].t)
        let hinge = rw[l.knee].q.inverse().rotate(vec3(1.0, 0.0, 0.0))
        let (qu, ql) = reach(w[l.hip], w[l.knee], w[l.ankle].t, ankle, hinge)
        turn_under(parents, nb, mut w, l.hip, qu.mul(w[l.hip].q.inverse()))
        turn_under(parents, nb, mut w, l.knee, ql.mul(w[l.knee].q.inverse()))
        turn_under(parents, nb, mut w, l.ankle, q.mul(rw[l.ankle].q).mul(w[l.ankle].q.inverse()))
        if l.toes != NONE {
            turn_under(parents, nb, mut w, l.toes, yaw.mul(rw[l.toes].q).mul(w[l.toes].q.inverse()))
        }
    }
    // Back to each bone's turn in its parent.
    var p = Pose { turns: [Quat::identity(); 64], hips: vec3(0.0) }
    for b in 0..nb {
        let up = parents[b]
        let pq = if up == NONE { rig.base.q } else { w[up].q }
        p.turns[b] = pq.inverse().mul(w[b].q)
    }
    let inv = rig.base.inverse()
    p.hips = inv.t + inv.q.rotate(w[hips].t)
    p
}

/// The key `keys` set at `time` (s): the two either side mixed as the later one's ease says,
/// the first before them and the last after.
pub fn key_at(keys: [Key], time: f32) -> Key {
    let n = keys.len()
    assert(n > 0, "a move needs at least one key")
    if time <= keys[0].at {
        return keys[0]
    }
    for i in 1..n {
        if time < keys[i].at {
            return between(keys[i - 1], keys[i], time, snap: 1.0)
        }
    }
    keys[n - 1]
}

/// Between two keys at `time`: mixed as the later one's ease says. A `SNAP` keeps `snap` of
/// its snap (1 all of it: stopped dead by the key; 0 none: eased into it, as `SMOOTH`).
fn between(a: Key, b: Key, time: f32, snap: f32) -> Key {
    let x = (time - a.at) / max(b.at - a.at, 1.0e-5)
    var e = eased(b.ease, x)
    if b.ease == SNAP {
        let soft = eased(SMOOTH, x)
        e = soft + (e - soft) * snap
    }
    mixed(a, b, e)
}

/// `key_at` for keys held in an array: the form a solve's derivation follows, where it can't
/// follow a run of keys (`engine::written`). `snap` is how much of a `SNAP` key's snap is
/// kept (`between`): a part of the body that eases into a pose the fist is stopped dead by.
pub fn key_in<const N: u32>(keys: [Key; N], time: f32, snap: f32 = 1.0) -> Key {
    assert(N > 0, "a move needs at least one key")
    if time <= keys[0].at {
        return keys[0]
    }
    for i in 1..N {
        if time < keys[i].at {
            return between(keys[i - 1], keys[i], time, snap)
        }
    }
    keys[N - 1]
}

/// Where `keys` have the body's root at each of `frames` frames at `fps`: their travel.
pub fn travels(keys: [Key], fps: f32, frames: u32) -> Vec<vec3> {
    var out: Vec<vec3> = Vec::with_capacity(frames)
    for f in 0..frames {
        out.push(key_at(keys, f32(f) / fps).travel)
    }
    out
}

/// A clip of `keys` at `fps`, about their root (each frame's travel taken off: gameplay carries
/// that), its hands made fists (`fist`, as `stride::curled_hands`).
pub fn keyed(rig: Rig, keys: [Key], fps: f32, fist: f32) -> Clip {
    let nb = rig.bones.len()
    assert(keys.len() > 0, "a move needs at least one key")
    let last = keys[keys.len() - 1].at
    let n = u32(last * fps + 0.5) + 1
    var c = humanoid::rest_clip(rig)
    c.frames = n
    c.looped = false
    c.fps = fps
    c.turns = Vec::with_capacity(n * nb)
    c.hips = Vec::with_capacity(n)
    for f in 0..n {
        let k = key_at(keys, f32(f) / fps)
        let p = posed(rig, shifted(k, -k.travel))
        for b in 0..nb {
            c.turns.push(p.turns[b])
        }
        c.hips.push(p.hips)
    }
    curled_hands(c, rig, fist)
}

/// How far (m) a fist or a foot may be from the spot its key puts it before it's a miss.
pub const MISS: f32 = 0.01

/// Where `keys` ask for what the body can't do, at `fps`: each fist and each foot that ends up
/// more than `MISS` from the spot its key puts it at some frame (a fist past its arm's reach,
/// a foot its leg can't get to under hips that high or that far off), with the frame it's
/// furthest off and by how much. Nothing for keys the body reaches: the pose drawn is the pose
/// written.
pub fn misses(rig: Rig, keys: [Key], fps: f32) -> Vec<String> {
    var out: Vec<String> = Vec::new()
    let c = keyed(rig, keys, fps, fist: 0.0)
    let rw = rig.rest_world()
    let names = ["left fist", "right fist", "left foot", "right foot"]
    let legs = [leg_of(rig, 1.0), leg_of(rig, -1.0)]
    let bones = [
        rig.find("leftHand"),
        rig.find("rightHand"),
        if legs[0].toes != NONE { legs[0].toes } else { legs[0].ankle },
        if legs[1].toes != NONE { legs[1].toes } else { legs[1].ankle },
    ]
    for limb in 0..4 {
        let b = bones[limb]
        if b == NONE {
            continue
        }
        var worst = 0.0
        var at = 0.0
        for f in 0..c.frames {
            let time = f32(f) / fps
            let k = key_at(keys, time)
            let k = shifted(k, -k.travel)
            let w = humanoid::frame_world(
                rig,
                c.turns,
                f,
                rig.base.t + rig.base.q.rotate(c.hips[f]),
            )
            let want = if limb < 2 {
                k.fists[limb]
            } else {
                let foot = k.feet[limb - 2]
                vec3(foot.x, rw[b].t.y + k.lifts[limb - 2], foot.y)
            }
            let off = length(w[b].t - want)
            if off > worst {
                worst = off
                at = time
            }
        }
        if worst > MISS {
            out.push(
                f"the {names[limb]} is {worst * 100.0:.1} cm from its key's spot at {at:.3} s: out of reach",
            )
        }
    }
    out
}

/// One arm (`side` 0 the left, 1 the right) of a pose's bones `w` (the body's space) reaching its
/// wrist to `wrist`, its elbow kept toward the side it bends to now (the pose's own bend, as a
/// capture has it) and its hand keeping its turn. In place in `w`.
pub fn arm_to(rig: Rig, w: mut Vec<Rigid>, side: u32, wrist: vec3) {
    let n = if side == 0 { "left" } else { "right" }
    let (u, l, h) = (
        rig.find(f"{n}UpperArm".as_str()),
        rig.find(f"{n}LowerArm".as_str()),
        rig.find(f"{n}Hand".as_str()),
    )
    if u == NONE || l == NONE || h == NONE {
        return
    }
    let rw = rig.rest_world()
    let l1 = length(rw[l].t - rw[u].t)
    let l2 = length(rw[h].t - rw[l].t)
    let pole = w[l].t - (w[u].t + w[h].t) * 0.5
    let hand = w[h].q
    let (e, t) = elbow_at(w[u].t, wrist, l1, l2, pole)
    turn_below(rig, mut w, u, arc(w[l].t - w[u].t, e - w[u].t))
    turn_below(rig, mut w, l, arc(w[h].t - w[l].t, t - w[l].t))
    turn_below(rig, mut w, h, hand.mul(w[h].q.inverse()))
}
