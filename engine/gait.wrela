// A procedural walk for a creature on terrain: its speed and turn come from a path, and each
// foot is planted on the ground and held there until it lifts.
//
// Make a `Body` from a skeleton (`body`) and a `Walker` that stands on the terrain (`stand`).
// The sim calls `step` each tick, which is deterministic. A frame draws the walker between two
// ticks' states (`between`) and poses the skeleton with `palette`.
//
// - Each foot is planted where a ray cast against the terrain field meets the ground, and held
//   there until it lifts.
// - Each leg bends by two-bone IK, and the pelvis lowers to the lowest plant.
// - The head's and the tail's chains move as secondary motion: a damped spring a bone.
// - The legs lift one at a time, hind then fore on each side (left hind, left fore, right hind,
//   right fore), each on the ground for most of its cycle. A foot lands ahead of its hip by
//   half its stance's travel, so it is under the hip mid-stance, and lifts as far behind.

use creature::{Bone, Skeleton}
use distance::rigid_inverse
use present::short_way
use creature::MAX_BONES
use sim::{SimState, Transform}
use std::derive::Box3
use std::hash::StateHash
use std::math::{PI, TAU}
use std::quat::Quat
use std::serialize::Serialize
use std::transform::{identity, rotate_x, rotate_y, translate}
use terrain::{Terrain, below}

/// How a walk goes: its speed (m/s), the fraction of a cycle a foot is planted, how high a
/// swinging foot lifts (m), and each leg's place in the cycle (legs in the skeleton's order:
/// fore right, fore left, hind right, hind left).
pub struct Walk: Copy + Eq + StateHash + Serialize + SimState {
    pub speed: f32 = 1.0,
    pub duty: f32 = 0.65,
    pub lift: f32 = 0.09,
    pub offsets: [f32; 4] = [0.75, 0.25, 0.5, 0.0],
    /// How fast it turns toward where its path leads (per second), and how far ahead it looks.
    pub steer: f32 = 1.4,
    pub look_ahead: f32 = 2.5,
    /// Its cycles a second: the first at a standstill, and the second more for each m/s.
    pub cadence: vec2 = vec2(0.55, 0.25),
}

/// A foot: whether it's on the ground, where its sole is (world), and the ground's normal there;
/// where it lifted from, for its swing.
pub struct Foot: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub planted: bool,
    pub at: vec3,
    pub normal: vec3,
    pub from: vec3,
}

/// The most springs a walker has: its head's and tail's chains. Each is where its bone's tip is
/// (world), and how fast it's moving (`Spring`); its bone follows it.
pub const SPRINGS: u32 = 12

/// A walker as the sim has it: its root (on the ground: where its rest feet stand, and which way
/// it faces), its cycle's phase, its feet, its springs, and how far along its path it is.
pub struct Walker: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub root: Transform,
    pub phase: f32,
    pub speed: f32,
    pub turn: f32,
    pub feet: [Foot; 4],
    pub springs: [Spring; SPRINGS],
    pub along: f32,
    /// Its body's height over its root's ground (the pelvis, lowered to the lowest plant), and
    /// its pitch (radians, nose up), each eased.
    pub height: f32,
    pub pitch: f32,
}

/// A path: a creature follows points along it, by distance (m).
pub trait Path: Copy {
    /// The point `s` metres along the path (on the plane: x, z).
    fn at(self, s: f32) -> vec2

    /// How long it is (m): a walker stops at its end.
    fn length(self) -> f32 {
        1.0e9
    }
}

/// What a walker's body is, for its gait: each leg's rest sole (its foot joint's x, z, on the
/// ground, in the body's space) and its foot joint's height over its sole; and its springs'
/// bones (the head's chain, then the tail's), their rest tips, and how stiff each is.
pub struct Body: Copy {
    pub soles: [vec3; 4],
    pub foot_height: [f32; 4],
    pub hips: [vec3; 4],
    /// Each leg's reach (its upper and lower bones' lengths, a little short of straight), and
    /// its foot joint from its ankle (rest).
    pub reach: [f32; 4],
    pub ankle_to_foot: [vec3; 4],
    pub spring_bones: Bounded<u32, SPRINGS>,
    pub spring_tips: Bounded<vec3, SPRINGS>,
    pub stiffness: Bounded<f32, SPRINGS>,
}

/// The body a skeleton has for walking: its legs' rest soles and hips, and springs on the
/// bones of two chains (each listed from its root): `head` (neck to head) and `tail`, `head_k`
/// and `tail_k` stiff. Each bone of a chain but its last gets a spring at its tip (the next
/// bone's joint).
pub fn body(s: Skeleton, head: [Bone], tail: [Bone], head_k: f32, tail_k: f32) -> Body {
    var b = Body {
        soles: [vec3(0.0); 4],
        foot_height: [0.0; 4],
        hips: [vec3(0.0); 4],
        reach: [0.0; 4],
        ankle_to_foot: [vec3(0.0); 4],
        spring_bones: Bounded::new(),
        spring_tips: Bounded::new(),
        stiffness: Bounded::new(),
    }
    let legs = s.legs()
    for i in 0..s.leg_count() {
        let j = legs[i].joints
        let f = s.rest(j[3])
        b.soles[i] = vec3(f.x, 0.0, f.z)
        b.foot_height[i] = f.y
        b.hips[i] = s.rest(j[0])
        let (h, k, a) = (s.rest(j[0]), s.rest(j[1]), s.rest(j[2]))
        b.reach[i] = (length(k - h) + length(a - k)) * REACH
        b.ankle_to_foot[i] = f - a
    }
    add_chain(mut b, s, head, head_k)
    add_chain(mut b, s, tail, tail_k)
    b
}

/// Springs on the bones of `chain` (listed from its root), each `k` stiff: one at the tip of
/// each bone but the last (the next bone's joint), while the body has room.
fn add_chain(b: mut Body, s: Skeleton, chain: [Bone], k: f32) {
    for i in 0..chain.len() {
        if i + 1 < chain.len() && !b.spring_bones.is_full() {
            b.spring_bones.push(chain[i].index)
            b.spring_tips.push(s.rest(chain[i + 1]))
            b.stiffness.push(k)
        }
    }
}

/// The body's frame in the world: its root's place, turned by its heading and pitched (nose up
/// turns +z toward +y: about the body's -x), raised to its height.
pub fn body_frame(w: Walker) -> mat4 {
    translate(w.root.pos + vec3(0.0, w.height, 0.0)) * rotate_y(w.root.heading) * rotate_x(-w.pitch)
}

/// A positive pitch follows higher forefeet: the body's nose goes up in world space.
@test
fn an_uphill_pitch_raises_the_front_of_the_body() {
    var w = still(Transform { pos: vec3(3.0, 2.0, 1.0), heading: 0.0 })
    w.pitch = 0.3
    for heading in [0.0, 1.0, -2.0] {
        w.root.heading = heading
        let m = body_frame(w)
        let front = apply(m, vec3(0.0, 0.0, 1.0))
        let back = apply(m, vec3(0.0, 0.0, -1.0))
        assert(front.y > w.root.pos.y && back.y < w.root.pos.y, "an uphill pitch lowered the nose")
        assert(abs(length(front - back) - 2.0) < 1.0e-5, "pitch changed the body's length")
    }
}

/// A box holding the walker's body posed: `rest` (a box holding it at rest) carried by its
/// body's frame, `slack` wider each way for what the pose moves past it (a leg's reach, a
/// spring's sway).
pub fn posed_bounds(w: Walker, rest: Box3, slack: f32) -> Box3 {
    let m = body_frame(w)
    var lo = vec3(1.0e9)
    var hi = vec3(-1.0e9)
    for i in 0..8 {
        let p = apply(
            m,
            vec3(
                if (i & 1) == 0 { rest.lo.x } else { rest.hi.x },
                if (i & 2) == 0 { rest.lo.y } else { rest.hi.y },
                if (i & 4) == 0 { rest.lo.z } else { rest.hi.z },
            ),
        )
        lo = min(lo, p)
        hi = max(hi, p)
    }
    Box3 { lo: lo - vec3(slack), hi: hi + vec3(slack) }
}

fn apply(m: mat4, p: vec3) -> vec3 {
    (m * vec4(p, 1.0)).xyz
}

/// A walker standing still at `root`, level, its feet planted at the origin and its springs
/// there, at rest: what `stand` settles onto the terrain.
fn still(root: Transform) -> Walker {
    let foot = Foot { planted: true, at: vec3(0.0), normal: vec3(0.0, 1.0, 0.0), from: vec3(0.0) }
    Walker {
        root,
        phase: 0.0,
        speed: 0.0,
        turn: 0.0,
        feet: [foot; 4],
        springs: [Spring { pos: vec3(0.0), vel: vec3(0.0) }; SPRINGS],
        along: 0.0,
        height: 0.0,
        pitch: 0.0,
    }
}

/// A walker standing at `at` on `terrain`, facing `heading`, its feet planted under it and its
/// springs at rest.
pub fn stand<T: Terrain>(terrain: T, b: Body, at: vec2, heading: f32) -> Walker {
    var w = still(Transform { pos: vec3(at.x, terrain.height(at.x, at.y), at.y), heading })
    let m = body_frame(w)
    for i in 0..4 {
        let rest = apply(m, b.soles[i])
        let hit = below(terrain, rest)
        w.feet[i] = Foot { planted: true, at: hit.point, normal: hit.normal, from: hit.point }
    }
    settle_body(mut w, b, dt: 1.0)
    let m = body_frame(w)
    for i in 0..b.spring_bones.len() {
        w.springs[i] = Spring { pos: apply(m, b.spring_tips[i]), vel: vec3(0.0) }
    }
    w
}

/// How much of a leg's length its reach is: a leg never straightens fully, so its knee bends
/// where the IK puts it and the foot is where the gait does.
const REACH: f32 = 0.995

/// How far the body must come down (m, 0 or less) for leg `i` to reach its foot: its hip moves
/// along world up as its height changes, and its ankle's target is fixed (by the foot's place
/// and the body's turn).
fn drop_to_reach(w: Walker, b: Body, i: u32) -> f32 {
    let m = body_frame(w)
    let up = (m * vec4(0.0, 1.0, 0.0, 0.0)).xyz
    let hip = apply(m, b.hips[i])
    let ankle = w.feet[i].at + up * b.foot_height[i] - (m * vec4(b.ankle_to_foot[i], 0.0)).xyz
    let v = ankle - hip
    let r = b.reach[i]
    if dot(v, v) <= r * r {
        return 0.0
    }
    // |v - (0, d, 0)|² = r²: the nearest d below 0 (or, past the leg's reach across, the nearest
    // its hip comes).
    let along = v.y
    let disc = along * along - dot(v, v) + r * r
    min(if disc >= 0.0 { along + sqrt(disc) } else { along }, 0.0)
}

/// Lowering the pitched body's height must put a planted ankle within its leg's reach.
@test
fn a_pitched_body_lowers_along_world_up_to_reach_its_feet() {
    var w = still(Transform { pos: vec3(3.0, 2.0, 1.0), heading: 0.0 })
    var b = Body {
        soles: [vec3(0.0); 4],
        foot_height: [0.0; 4],
        hips: [vec3(0.0); 4],
        reach: [1.0; 4],
        ankle_to_foot: [vec3(0.0); 4],
        spring_bones: Bounded::new(),
        spring_tips: Bounded::new(),
        stiffness: Bounded::new(),
    }
    for pitch in [-0.5, 0.5] {
        let side = if pitch < 0.0 { -1.0 } else { 1.0 }
        b.hips[0] = vec3(0.0, 1.0, side)
        w.pitch = pitch
        for heading in [0.0, 1.0, -2.0] {
            w.root.heading = heading
            let root = translate(w.root.pos) * rotate_y(heading)
            w.feet[0].at = apply(root, vec3(0.0, 0.0, side))
            for foot_height in [0.0, 0.2] {
                w.height = 0.0
                b.foot_height[0] = foot_height
                b.ankle_to_foot[0] = vec3(0.0, foot_height * 0.5, side * foot_height * 0.25)
                let before = body_frame(w)
                let ankle = w.feet[0].at +
                    (before * vec4(0.0, foot_height, 0.0, 0.0)).xyz -
                    (before * vec4(b.ankle_to_foot[0], 0.0)).xyz
                assert(
                    length(ankle - apply(before, b.hips[0])) > b.reach[0],
                    "fixture leg already reaches",
                )
                w.height += drop_to_reach(w, b, 0)
                let after = body_frame(w)
                let distance = length(ankle - apply(after, b.hips[0]))
                assert(
                    abs(distance - b.reach[0]) < 1.0e-5,
                    "lowering a pitched body missed its ankle target",
                )
            }
        }
    }
}

/// Its body's height and pitch, eased toward what its feet ask: the pelvis as low as its lowest
/// plant, and pitched by its fore feet's height over its hind's; then lowered at once as far as
/// a leg needs to reach its foot, so no planted foot is dragged.
fn settle_body(w: mut Walker, b: Body, dt: f32) {
    let ground = w.root.pos.y
    var lowest = 1.0e9
    var fore = 0.0
    var hind = 0.0
    for i in 0..4 {
        let y = w.feet[i].at.y - ground
        lowest = min(lowest, y)
        if i < 2 { fore += y } else { hind += y }
    }
    let length = max(b.soles[0].z - b.soles[2].z, 0.1)
    let want_pitch = atan2(0.5 * (fore - hind), length)
    let ease = 1.0 - exp(-dt * 8.0)
    w.height += (min(lowest, 0.0) - w.height) * ease
    w.pitch += (want_pitch - w.pitch) * ease
    var drop = 0.0
    for i in 0..4 {
        drop = min(drop, drop_to_reach(w, b, i))
    }
    w.height += drop
}

/// One tick of `dt` seconds of a walker following `path` over `terrain`, its body `b`, walking
/// as `walk` says (stopped when `go` is false).
@deterministic
pub fn step<T: Terrain, P: Path>(
    w: mut Walker,
    terrain: T,
    path: P,
    b: Body,
    walk: Walk,
    go: bool,
    dt: f32,
) {
    // Steering: toward a point `look_ahead` metres along the path.
    let target = path.at(w.along + walk.look_ahead)
    let to = target - w.root.pos.xz
    let want = atan2(to.x, to.y)
    let diff = short_way(want - w.root.heading, TAU)
    // It stops where the path ends, its look ahead past it.
    let speed_to = if go && w.along + walk.look_ahead < path.length() { walk.speed } else { 0.0 }
    w.speed += (speed_to - w.speed) * (1.0 - exp(-dt * 2.0))
    w.turn = clamp(diff * walk.steer, -0.8, 0.8) * min(w.speed / max(walk.speed, 0.01), 1.0)
    w.root = w.root.advance(vec3(0.0, w.turn * dt, w.speed * dt))
    w.root.pos.y = terrain.height(w.root.pos.x, w.root.pos.z)
    // Its progress: the path's point nearest it, searched a little ahead of the last.
    var best = w.along
    var nearest = 1.0e9
    for k in 0..16 {
        let s = w.along + f32(k) * 0.05
        let d = length(path.at(s) - w.root.pos.xz)
        if d < nearest {
            nearest = d
            best = s
        }
    }
    w.along = best
    // The cycle: faster with speed; a stride's length follows.
    let cadence = walk.cadence.x + walk.cadence.y * w.speed
    let moving = w.speed > 0.02
    if moving {
        w.phase = (w.phase + dt * cadence) % 1.0
    }
    let travel = walk.duty * w.speed / cadence
    let m = body_frame(w)
    let forward = w.root.forward()
    for i in 0..4 {
        let t = (w.phase + walk.offsets[i]) % 1.0
        let stance = t < walk.duty || !moving
        var foot = w.feet[i]
        if stance {
            if !foot.planted {
                // Touchdown: where the ground is under its target.
                let hit = below(terrain, landing(w, b, walk, i, travel, cadence, forward, m, t))
                foot = Foot { planted: true, at: hit.point, normal: hit.normal, from: foot.from }
            }
        } else {
            if foot.planted {
                foot.from = foot.at
                foot.planted = false
            }
            // The swing: from where it lifted to where it'll land, arcing up.
            let s = (t - walk.duty) / (1.0 - walk.duty)
            let land = below(terrain, landing(w, b, walk, i, travel, cadence, forward, m, t))
            let e = s * s * (3.0 - 2.0 * s)
            foot.at = mix(foot.from, land.point, vec3(e)) + vec3(0.0, walk.lift * sin(PI * s), 0.0)
            foot.normal = land.normal
        }
        w.feet[i] = foot
    }
    settle_body(mut w, b, dt)
    // The springs: each bone's tip follows where its rigid pose puts it, critically damped.
    let m = body_frame(w)
    for i in 0..b.spring_bones.len() {
        w.springs[i].follow(apply(m, b.spring_tips[i]), b.stiffness[i], dt)
    }
}

/// Where leg `i`'s foot lands: its rest sole where the body will be when it lands, ahead of
/// its hip by half its stance's travel.
fn landing(
    w: Walker,
    b: Body,
    walk: Walk,
    i: u32,
    travel: f32,
    cadence: f32,
    forward: vec3,
    m: mat4,
    t: f32,
) -> vec3 {
    // How long until it lands (the rest of its swing), and the body's travel meanwhile.
    let until = if t >= walk.duty { (1.0 - t) / cadence } else { 0.0 }
    apply(m, b.soles[i]) + forward * (w.speed * until + travel * 0.5)
}

/// Spring `i`'s energy (its motion's and its stretch's, for its stiffness): a turn puts energy
/// in, and it decays once the body moves steadily.
pub fn energy_of(w: Walker, b: Body, i: u32) -> f32 {
    let sp = w.springs[i]
    let d = sp.pos - apply(body_frame(w), b.spring_tips[i])
    0.5 * dot(sp.vel, sp.vel) + 0.5 * b.stiffness[i] * dot(d, d)
}

// ---- posing -------------------------------------------------------------------------------------

/// A walker between two ticks' states, `a` and `b`, `alpha` of the way: what a frame draws.
pub fn between(a: Walker, b: Walker, alpha: f32) -> Walker {
    var out = b
    out.root = Transform {
        pos: mix(a.root.pos, b.root.pos, vec3(alpha)),
        heading: a.root.heading + present::lerp_angle(0.0, b.root.heading - a.root.heading, alpha),
    }
    out.height = mix(a.height, b.height, alpha)
    out.pitch = mix(a.pitch, b.pitch, alpha)
    for i in 0..4 {
        out.feet[i].at = mix(a.feet[i].at, b.feet[i].at, vec3(alpha))
    }
    for i in 0..SPRINGS {
        out.springs[i].pos = mix(a.springs[i].pos, b.springs[i].pos, vec3(alpha))
    }
    out
}

/// The rotation `r` about the point `at`.
fn about(r: Quat, at: vec3) -> mat4 {
    bone_matrix(r, at, at)
}

/// The palette that poses skeleton `s` as walker `w` stands: each leg's foot joint over its
/// sole, its hip to its ankle bent by two-bone IK in the plane of its rest knee, its ankle and
/// foot keeping their rest turn; each sprung bone turned toward its spring about its joint,
/// carrying the bones below it; the rest as their parents go; all in the body's frame.
pub fn palette(s: Skeleton, b: Body, w: Walker) -> Palette {
    let m = body_frame(w)
    let inv = rigid_inverse(m)
    // Each bone's matrix in the body's space: rest to posed.
    var mats = [identity(); MAX_BONES]
    var set = [false; MAX_BONES]
    let legs = s.legs()
    for i in 0..s.leg_count() {
        let j = legs[i].joints
        let (h, k, a, f) = (s.rest(j[0]), s.rest(j[1]), s.rest(j[2]), s.rest(j[3]))
        // The foot joint's target, in the body's space: over its sole by its rest height.
        let sole = apply(inv, w.feet[i].at)
        let foot_to = sole + vec3(0.0, b.foot_height[i], 0.0)
        let ankle_to = foot_to - (f - a)
        let (knee, ankle) = bend(h, k, a, ankle_to)
        let upper = turn(normalize(k - h), normalize(knee - h))
        let lower = turn(normalize(a - k), normalize(ankle - knee))
        mats[j[0].index] = bone_matrix(upper, h, h)
        mats[j[1].index] = bone_matrix(lower, k, knee)
        let below = bone_matrix(Quat::identity(), a, ankle)
        mats[j[2].index] = below
        mats[j[3].index] = below
        for x in j {
            set[x.index] = true
        }
    }
    // The others in order (a parent before its children): as their parent goes, a sprung bone
    // turned about its joint toward its spring.
    for i in 0..s.len() {
        if set[i] {
            continue
        }
        let bone = Bone { index: i }
        let parent = s.parent(bone)
        let pm = if parent.index == i { identity() } else { mats[parent.index] }
        var mm = pm
        for k in 0..b.spring_bones.len() {
            if b.spring_bones[k] == i {
                let at = apply(pm, s.rest(bone))
                let tip = apply(pm, b.spring_tips[k])
                let want = apply(inv, w.springs[k].pos)
                mm = about(turn(normalize(tip - at), normalize(want - at)), at) * pm
            }
        }
        mats[i] = mm
    }
    var bones = [m; MAX_BONES]
    for i in 0..s.len() {
        bones[i] = m * mats[i]
    }
    Palette { bones }
}

/// A damped spring: where it is, and how fast it's moving. A walker's (`Walker`) are its sim's
/// state.
pub struct Spring: Copy + Eq + Plain + StateHash + Serialize + SimState {
    pub pos: vec3,
    pub vel: vec3,
}

impl Spring {
    /// One step towards `target`, critically damped-ish.
    pub fn follow(mut self, target: vec3, stiffness: f32, dt: f32) {
        let a = (target - self.pos) * stiffness - self.vel * (2.0 * sqrt(stiffness))
        self.vel += a * dt
        self.pos += self.vel * dt
    }
}

// ---- bones posed on the CPU -----------------------------------------------------------------

/// Bone matrices for one pose (rest space to world), as CPU code poses a creature (`palette`).
pub struct Palette: Copy + GpuData {
    pub bones: [mat4; MAX_BONES],
}

/// The rotation that turns the unit vector `a` to the unit vector `b`, the short way.
pub fn turn(a: vec3, b: vec3) -> Quat {
    let c = dot(a, b)
    if c < -0.9999 {
        // Opposite: half a turn about any axis across `a`.
        let across = if abs(a.x) < 0.9 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
        return Quat::axis_angle(cross(a, across), PI)
    }
    Quat { v: normalize(vec4(cross(a, b), 1.0 + c)) }
}

/// A bone's matrix: rest space to posed, turned by `r` about the bone's rest position `rest`,
/// which moves to `posed`.
pub fn bone_matrix(r: Quat, rest: vec3, posed: vec3) -> mat4 {
    let m = r.to_mat3()
    mat4(vec4(m[0], 0.0), vec4(m[1], 0.0), vec4(m[2], 0.0), vec4(posed - m * rest, 1.0))
}

/// Where a two-bone limb's middle joint goes, its root at `h` and its rest middle joint and end
/// at `k` and `a`, when its end goes to `to`: in the plane of the rest bend, each bone keeping
/// its length, and the end pulled no farther than the limb reaches.
pub fn bend(h: vec3, k: vec3, a: vec3, to: vec3) -> (vec3, vec3) {
    let (l1, l2) = (length(k - h), length(a - k))
    let span = to - h
    let d = clamp(length(span), abs(l1 - l2) + 1.0e-4, (l1 + l2) * 0.9999)
    let dir = if length(span) > 1.0e-6 { normalize(span) } else if length(a - h) > 1.0e-6 {
        normalize(a - h)
    } else {
        // A folded rest limb has its end at its root; its first bone still gives a direction.
        normalize(k - h)
    }
    // Across the reach, toward the rest knee.
    let rest_out = (k - h) - dir * dot(k - h, dir)
    let out = if length(rest_out) > 1.0e-6 { normalize(rest_out) } else {
        let across = if abs(dir.x) < 0.9 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
        normalize(cross(dir, across))
    }
    let along = (l1 * l1 - l2 * l2 + d * d) / (2.0 * d)
    let knee = h + dir * along + out * sqrt(max(l1 * l1 - along * along, 0.0))
    (knee, h + dir * d)
}

@test
fn a_straight_limb_bends_along_each_axis_without_nan() {
    for direction in [vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0)] {
        let (knee, end) = bend(vec3(0.0), direction, direction * 2.0, direction)
        assert(knee == knee && end == end, "a collinear limb has a finite bending plane")
        assert(abs(length(knee) - 1.0) < 1.0e-5)
        assert(abs(length(end - knee) - 1.0) < 1.0e-5)
        assert(length(end - direction) < 1.0e-5)
    }
}

@test
fn a_folded_limb_can_target_its_root_without_nan() {
    let root = vec3(0.0)
    let (knee, end) = bend(root, vec3(0.0, 1.0, 0.0), root, root)
    assert(knee == knee && end == end, "a folded limb has a finite reach direction")
    assert(abs(length(knee - root) - 1.0) < 1.0e-5)
    assert(abs(length(end - knee) - 1.0) < 1.0e-5)
    assert(length(end - root) < 0.001)
}
