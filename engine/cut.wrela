// A cut's sheet: a strike with a held thing (`engine::held`), read as its tip. It's the timing
// sheet (`engine::timing`) read by the tip's end, and what a held thing adds to it:
//
// - The tip against the hand: the tip outruns the hand that swings it (a lever), and the chain
//   goes from the hips out to the tip, the tip's fastest last of all.
// - The edge against its path: how far (degrees) the edge's way is off the way the tip goes, on
//   contact and at worst over the swing. A cut lands edge first (0); a blade turned flat to its
//   path lands flat (90).
// - The cut's plane: how far the tip's path from setting off to its contact strays from the plane
//   it best lies in (m, and of its path's length). A cut swung on one plane is flat (0).
// - The hands: on contact, how high the hand that holds it is, how far out ahead of the chest, how
//   much of its arm's reach is used, and the blade's angle to the floor; and on the way over, how
//   high that hand is when the blade stands most upright, and how far the hand leads the blade
//   (when the hand's gone half its way, against when the blade's turned half its turn). A cut
//   from above comes down with the hands: out in front at chest height, the arms nearly straight,
//   the blade coming down onto what it strikes, not flicked over from the belt.
// - The sweep: where the hilt and the tip are each sample from setting off to the contact (the
//   body's space): the volume the blade sweeps, which the rules' hit shapes are made from.
//
// `Cut::text` is the sheet.

use std::collections::Vec
use std::string::String
use humanoid::{Clip, NONE, Rig, Rigid}
use held::Held
use timing::{END, RATE, Timing, read, timing}

const DEG: f32 = 57.29578

/// A cut, read (`cut`).
pub struct Cut: Clone {
    /// The timing sheet, read by the tip.
    pub timing: Timing,
    /// The hand's fastest over the strike (m/s), and whether the chain goes from the hips out to
    /// the tip with the tip's fastest last.
    pub hand_fastest: f32,
    pub tip_last: bool,
    /// How far the edge is off the tip's way on contact, and at worst from setting off to it
    /// (degrees).
    pub edge_on: f32,
    pub edge_worst: f32,
    /// How far the tip's path strays from its plane at most (m), and of its path's length.
    pub plane_off: f32,
    pub plane_share: f32,
    /// The hilt and the tip each sample from setting off to the contact (the body's space).
    pub sweep: Vec<[vec3; 2]>,
    /// On contact: how high the holding hand is (m), how far out ahead of the chest (m, along the
    /// body's ahead), how much of its arm's reach is used (wrist from shoulder, of the arm's
    /// length), and the blade's angle below level (degrees; below 0, pointing up).
    pub hand_y: f32,
    pub hand_ahead: f32,
    pub reach: f32,
    pub blade_down: f32,
    /// On the way over: how high the holding hand is when the blade stands most upright (m), how
    /// upright it stands then (degrees above level), and how far the hand leads the blade (s: when
    /// the blade's turned half its turn, less when the hand's gone half its way).
    pub upright_hand_y: f32,
    pub upright: f32,
    pub lead: f32,
}

/// The cut `clip` makes on `rig` with `held`, its contact at `contact` s (negative to find it).
pub fn cut(clip: Clip, rig: Rig, held: Held, contact: f32) -> Cut {
    let t = timing(clip, rig, held.tip_end(), contact)
    var out = Cut {
        timing: t.clone(),
        hand_fastest: 0.0,
        tip_last: false,
        edge_on: 0.0,
        edge_worst: 0.0,
        plane_off: 0.0,
        plane_share: 0.0,
        sweep: Vec::new(),
        hand_y: 0.0,
        hand_ahead: 0.0,
        reach: 0.0,
        blade_down: 0.0,
        upright_hand_y: 0.0,
        upright: 0.0,
        lead: 0.0,
    }
    let hand = held.hand_of(rig)
    if !t.found || hand == NONE {
        return out
    }
    let r = read(clip, rig, [hand])
    let frame = |i: u32| -> Rigid { Rigid { q: r.q[i], t: r.at[i] } }
    let last = r.m - 1
    let i_s = min(u32(t.sets_off * RATE + 0.5), last)
    let i_c = max(min(u32(t.contact * RATE + 0.5), last), i_s)
    // The tip last and fastest: the chain in order, no part fastest after it.
    var latest = true
    for part in 0..END {
        if t.chain.len() > END && t.chain[part].at > t.chain[END].at {
            latest = false
        }
    }
    out.tip_last = t.in_order() && latest
    // The hands: the holding arm's shoulder, elbow and hand, and the chest.
    let side = if held.hand == "leftHand" { "left" } else { "right" }
    let arm = read(
        clip,
        rig,
        [
            rig.find(f"{side}UpperArm".as_str()),
            rig.find(f"{side}LowerArm".as_str()),
            rig.find("upperChest"),
        ],
    )
    let at = |i: u32, j: u32| -> vec3 { arm.at[i * arm.k + j] }
    let hand_c = r.at[i_c]
    out.hand_y = hand_c.y
    out.hand_ahead = hand_c.z - at(i_c, 2).z
    let whole = length(at(i_c, 1) - at(i_c, 0)) + length(hand_c - at(i_c, 1))
    out.reach = length(hand_c - at(i_c, 0)) / max(whole, 1.0e-4)
    var blades: Vec<vec3> = Vec::with_capacity(r.m)
    for i in 0..r.m {
        let (h, p) = held.ends_at(Rigid { q: r.q[i], t: r.at[i] })
        blades.push(normalize(p - h))
    }
    let blade = |i: u32| -> vec3 { blades[i] }
    out.blade_down = asin(clamp(-blade(i_c).y, -1.0, 1.0)) * DEG
    var most_up = -2.0
    var hand_way = 0.0
    var turned = 0.0
    for i in i_s + 1..i_c + 1 {
        hand_way += length(r.at[i] - r.at[i - 1])
        turned += acos(clamp(dot(blade(i), blade(i - 1)), -1.0, 1.0))
        if blade(i).y > most_up {
            most_up = blade(i).y
            out.upright_hand_y = r.at[i].y
        }
    }
    out.upright = asin(clamp(most_up, -1.0, 1.0)) * DEG
    var gone = 0.0
    var swung = 0.0
    var hand_half = f32(i_c) / RATE
    var blade_half = f32(i_c) / RATE
    var hand_done = false
    var blade_done = false
    for i in i_s + 1..i_c + 1 {
        gone += length(r.at[i] - r.at[i - 1])
        swung += acos(clamp(dot(blade(i), blade(i - 1)), -1.0, 1.0))
        if !hand_done && gone >= hand_way * 0.5 {
            hand_half = f32(i) / RATE
            hand_done = true
        }
        if !blade_done && swung >= turned * 0.5 {
            blade_half = f32(i) / RATE
            blade_done = true
        }
    }
    out.lead = blade_half - hand_half
    var path = 0.0
    var centre = vec3(0.0)
    for i in i_s..i_c + 1 {
        let (h, p) = held.ends_at(frame(i))
        out.sweep.push([h, p])
        centre += p
        if i > 0 {
            let (_, q) = held.ends_at(frame(i - 1))
            let step = p - q
            path += length(step)
            out.hand_fastest = max(out.hand_fastest, length(r.at[i] - r.at[i - 1]) * RATE)
            if length(step) > 1.0e-5 {
                // (0 edge first: the edge along the way it goes, either edge; 90 flat to it.)
                let a = acos(clamp(abs(dot(held.edge_at(frame(i)), normalize(step))), 0.0, 1.0)) *
                    DEG
                out.edge_worst = max(out.edge_worst, abs(a))
                if i == i_c {
                    out.edge_on = abs(a)
                }
            }
        }
    }
    // The plane the tip's path best lies in: through its middle, square to the turn its path
    // sweeps about it.
    let n = out.sweep.len()
    if n >= 3 {
        centre = centre / f32(n)
        var turn = vec3(0.0)
        for k in 0..n - 1 {
            turn += cross(out.sweep[k][1] - centre, out.sweep[k + 1][1] - centre)
        }
        if length(turn) > 1.0e-8 {
            let normal = normalize(turn)
            for k in 0..n {
                out.plane_off = max(out.plane_off, abs(dot(out.sweep[k][1] - centre, normal)))
            }
        }
        out.plane_share = out.plane_off / max(path, 1.0e-4)
    }
    out
}

impl Cut {
    /// The sheet, headed `name`: the timing sheet read by the tip, and the cut's own reads.
    pub fn text(self, name: str) -> String {
        var s = self.timing.text(name)
        borrow t = self.timing
        s.push_str(
            f"\ncut: the tip fastest {t.fastest:.1} m/s at {t.fastest_at:.3} s, the hand {self.hand_fastest:.1} m/s; the chain from the hips out to the tip {if self.tip_last { "in order, the tip last" } else { "out of order" }}\n".as_str(),
        )
        s.push_str(
            f"  the edge {self.edge_on:.0} deg off its way on contact, {self.edge_worst:.0} at worst over the swing (0 edge first, 90 flat)\n".as_str(),
        )
        s.push_str(
            f"  its plane: the tip strays {self.plane_off * 100.0:.1} cm off it at most, {self.plane_share * 100.0:.1}% of its path; {self.sweep.len()} samples swept\n".as_str(),
        )
        s.push_str(
            f"  the hands on contact: {self.hand_y * 100.0:.0} cm up, {self.hand_ahead * 100.0:.0} cm ahead of the chest, the arm {self.reach * 100.0:.0}% out; the blade {self.blade_down:.0} deg below level\n".as_str(),
        )
        s.push_str(
            f"  on the way over: the blade most upright {self.upright:.0} deg above level, the hand {self.upright_hand_y * 100.0:.0} cm up then; the hand {self.lead * 1000.0:.0} ms ahead of the blade, half way\n".as_str(),
        )
        s
    }
}
