// Levels of detail without popping (the owner's ask, beyond #28's scope for M5): a plant is drawn
// at a level its size on screen and its distance ask (its cards' levels, then an impostor, then
// a volume, then nothing), and near a switch it's drawn both ways, each keeping its share of the
// pixels. Which pixels a share holds is an ordered pattern anchored on the plant (where its
// middle falls on the screen), the same for both ways at a pixel, so the two shares tile the
// pixel with no gap and no overlap. The pattern moves with the plant as the camera moves, and
// steps through its 16 places over temporal AA's cycle of 16 frames, so each pixel takes every
// threshold once and temporal AA blends the two ways. (Held still, a small share was a fixed
// grid of dots; tied to the screen, it swam over the plant as the camera moved.)
//
// One function says where an instance is between its levels (`place`), on the CPU (which lists
// it's drawn in) and on the GPU (each draw's share of it), so the shares always add to one.
//
//     level:   0 ──── 1 ──── 2 ═══ impostor ═══ volume ┄┄ nothing
//              cards, by their size on screen ┊ by distance  ┊ by its size on screen
//     a switch: the middle 20% of each step, a smoothstep of the shares (`SWITCH`)

use noise::hash2
use plant::CARD_LEVELS
use view::Camera

/// The ways an instance is drawn: its cards' levels, an impostor, a volume.
pub const IMPOSTOR: u32 = 3
pub const VOLUME: u32 = 4

/// Where each card level ends, in pixels a card's width: an instance is drawn at the coarsest
/// level whose cards look no wider than this on screen.
pub const CARD_PX: f32 = 24.0
/// The width on screen (the scene's pixels) below which a far crown fades out, by half again.
/// Like `CARD_PX`, it's scaled by `Lod::card_px`: a scene drawn at another size chooses the
/// same levels and fades by giving `card_px` in its own pixels.
pub const FAINT_PX: f32 = 1.5

/// What deciding a plant's level reads: where its cards hand over to an impostor and the
/// impostor to a volume (m), its leaves' size, its height and reach (m, at scale 1), and how
/// wide on screen a card level's cards grow before the next takes over (`CARD_PX`).
pub struct Lod: Copy + GpuData {
    pub cards_to: f32,
    pub impostors_to: f32,
    pub leaf: f32,
    pub top: f32,
    pub reach: f32,
    pub card_px: f32,
    /// How wide a cut's hashed cell is, in the scene's pixels (`noise::hashed_threshold_of`): an
    /// output pixel, so a scene drawn at half the output's size and one drawn at its size cut
    /// the same cells, and temporal AA's jitter sweeps a sample over several.
    pub cell: f32,
}

/// Where an instance at `at` (its base), `scale` large, is between its levels, seen from `cam`:
/// its level as a number (each whole number a way, `CARD_LEVELS - 1` the coarsest cards, then
/// `IMPOSTOR` and `VOLUME`), and how far it has faded out (0 to 1, by its size on screen).
pub fn place(l: Lod, cam: Camera, at: vec3, scale: f32) -> (f32, f32) {
    let r = l.reach * scale
    let d = length(at + vec3(0.0, l.top * 0.5 * scale, 0.0) - cam.eye)
    // The finest level whose cards look no wider than CARD_PX (each level doubles them).
    let px = card_width(l, cam, at, scale)
    var level = clamp(log2(l.card_px / max(px, 1.0e-4)), 0.0, f32(CARD_LEVELS - 1))
    // Toward the impostors, the coarsest cards (the impostor's): from 60% of the way.
    level = max(level, f32(CARD_LEVELS - 1) * smoothstep(0.6, 0.75, d / l.cards_to))
    // Then the impostor, and then the volume, each over a tenth of its distance.
    level += smoothstep(0.92, 1.08, d / l.cards_to) + smoothstep(0.92, 1.08, d / l.impostors_to)
    // Beyond the cards, a crown fading as it shrinks to a pixel or two.
    let crown = 2.0 * r / max(cam.footprint(d), 1.0e-6)
    let fp = FAINT_PX * l.card_px / CARD_PX
    let faint = if d > l.cards_to { 1.0 - smoothstep(fp, 2.0 * fp, crown) } else { 0.0 }
    (level, faint)
}

/// How wide the cards of an instance at `at`, `scale` large, look from `cam` at its nearest
/// level, in pixels (each level doubles it): `place`'s measure.
pub fn card_width(l: Lod, cam: Camera, at: vec3, scale: f32) -> f32 {
    let r = l.reach * scale
    let d = length(at + vec3(0.0, l.top * 0.5 * scale, 0.0) - cam.eye)
    l.leaf * scale / max(cam.footprint(max(d - r * 0.5, 0.5)), 1.0e-4)
}

/// How much of each step between two ways an instance is drawn both ways (its middle): over
/// 80%, a tree was between two of its card levels most of the time, and temporal AA (a fifth of
/// a pixel from each frame) left their dither as a screen over most crowns (the lookdev
/// reviews).
pub const SWITCH: f32 = 0.2

/// How far through a step's switch an instance at `level` is (0 to 1).
fn switched(level: f32) -> f32 {
    let f = level - floor(level)
    smoothstep(0.5 - 0.5 * SWITCH, 0.5 + 0.5 * SWITCH, f)
}

/// The part of [0, 1) that way `way` keeps of an instance at `level`, faded by `faint`: the
/// lower way of a step keeps its start, the upper its end (each a smoothstep over the step's
/// middle `SWITCH`), so the two tile it; and none of it at all past `1 - faint`.
pub fn share(level: f32, faint: f32, way: u32) -> vec2 {
    let k = floor(level)
    let s = switched(level)
    let kept = 1.0 - faint
    let w = f32(way)
    if w == k {
        return vec2(0.0, (1.0 - s) * kept)
    }
    if w == k + 1.0 {
        return vec2((1.0 - s) * kept, kept)
    }
    vec2(0.0)
}

/// Where the shares of an instance at `at`, `scale` large, its plant `top` tall, are anchored
/// on the target (`keeps_packed`) this frame: where its middle falls (pixels, unjittered), moved
/// by a few whole pixels by a draw of its own, so neighbours' patterns don't line up, and by the
/// frame's place in the pattern's cycle.
///
/// A middle at or behind the eye's plane (the camera inside the crown) falls on no pixel: its
/// anchor is the screen's corner, as good as any, since the plant is drawn whole there. (A
/// player's camera went inside a crown within ten minutes of playing spike 17, and the infinite
/// pixel trapped where the CPU made it an integer: `packed`.)
pub fn anchor(cam: Camera, at: vec3, top: f32, scale: f32) -> vec2 {
    // Its own draw, keyed to where it stands in the world.
    let w = at + cam.keyed()
    let own = vec2(
        hash2(i32(floor(w.x * 8.0)), i32(floor(w.z * 8.0))),
        hash2(i32(floor(w.z * 8.0)) + 17, i32(floor(w.x * 8.0)) - 5),
    )
    let k = (cam.frame * 7) % 16
    let step = vec2(f32(k % 4), f32(k / 4))
    let middle = at + vec3(0.0, top * 0.5 * scale, 0.0)
    let ahead = dot(middle - cam.eye, cam.forward) > cam.near
    let on = if ahead { clamp(cam.pixel(middle), vec2(-1.0e6), vec2(1.0e6)) } else { vec2(0.0) }
    on - floor(own * 4.0) - step
}

/// The 4 × 4 Bayer matrix's threshold at `o` (each in 0 to 3), over 16, at its step's middle:
/// (x xor y, y)'s bits interleaved and reversed (no table to look up: a table indexed by a
/// pixel's place is memory, not registers).
fn bayer(o: vec2u) -> f32 {
    let a = o.x ^ o.y
    let b = o.y
    let v = ((a & 1) << 3) | ((b & 1) << 2) | (((a >> 1) & 1) << 1) | ((b >> 1) & 1)
    f32(v) / 16.0 + 1.0 / 32.0
}

/// A way's share (its start and end in [0, 1), `share`) and the instance's anchor (`anchor`) in
/// one word, for a vertex to pass on: the share's start and end in 14 bits each, and of the
/// anchor only what a pixel's draw depends on (a pixel centre's offset from it is its whole pixel
/// plus `floor(0.5 - anchor)`, and the pattern repeats every 4 pixels), 2 bits each way.
pub fn packed(keep: vec4) -> u32 {
    let s = vec2u(round(saturate(keep.xy) * 16383.0))
    let c = vec2u(vec2i(floor(vec2(0.5) - keep.zw)) & vec2i(3))
    s.x | (s.y << 14) | (c.x << 28) | (c.y << 30)
}

/// Whether a share packed by `packed` holds the pixel at `pixel` (a fragment's position): where
/// the pixel's draw (`draw_packed`) is in the share. A whole share holds every pixel, with no
/// draw.
pub fn keeps_packed(k: u32, pixel: vec2) -> bool {
    let start = f32(k & 16383) / 16383.0
    let end = f32((k >> 14) & 16383) / 16383.0
    if start <= 0.0 && end >= 1.0 {
        return true
    }
    let c = vec2u((k >> 28) & 3, (k >> 30) & 3)
    let u = bayer((vec2u(pixel) + c) & vec2u(3))
    u >= start && u < end
}

/// A pixel's draw in [0, 1) for a share packed by `packed`, its pattern moved by `shift` pixels:
/// a 4 × 4 Bayer matrix anchored on the instance, so each block of 4 × 4 takes every one of 16
/// thresholds and the blend of two ways is even.
pub fn draw_packed(k: u32, pixel: vec2, shift: vec2u) -> f32 {
    let c = vec2u((k >> 28) & 3, (k >> 30) & 3)
    bayer((vec2u(pixel) + c + shift) & vec2u(3))
}

/// Whether an instance is drawn at all, and its ways (the lower, and the upper when it's
/// between two), at `level`, faded by `faint`.
pub fn ways(level: f32, faint: f32) -> (bool, u32, u32) {
    if faint >= 1.0 {
        return (false, 0, 0)
    }
    let k = floor(level)
    let s = switched(level)
    let lower = u32(k)
    let upper = if s > 0.0 && lower < VOLUME { lower + 1 } else { lower }
    let both_kept = s < 1.0
    if !both_kept {
        return (true, upper, upper)
    }
    (true, lower, upper)
}
