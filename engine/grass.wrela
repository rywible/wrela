// Grass: blades of geometry round the eye, with flowers and the wood's floor's plants, placed on
// the GPU each frame so they follow the camera. Beyond them, the terrain's shading is the grass
// (its cover's colour).
//
// Make one `Grass` (`Grass::new`). Each frame, `Grass::place` runs a kernel that places the
// blades and flowers round the camera into `Append` buffers, and an indirect draw draws them. A
// blade's root, height, colour and ground normal come from the terrain's clipmap when it is
// placed, never from the terrain's field.
//
// Placement is nested, so the density never thins at a ring's edge as the eye moves:
// - Level k is a world-anchored grid of cells `FINEST · 2^k` apart. A blade's spacing grows with
//   its distance (`spacing_at`), and level k places the blades whose wanted spacing falls
//   between its cells' and twice that.
// - Each cell of level k + 1 holds the blade of one of its four children at level k (its first
//   by a hash). So where level k hands over to level k + 1, the blades left are those level
//   k + 1 places: the same blades, in the same places.
// - Within a level, a cell's blade is kept while its rank among its siblings is under the
//   density the distance asks, and it shrinks away as it is dropped, so nothing pops.

use light::{Light, Lit}
use lit::{Lighting, shown, sun_and_gloss, sun_at}
use noise::{hash2, hash2u, rand}
use plant::{Wind, sway}
use probes::{ProbeGrid, sky_light}
use sky::{Clouds, cloud_shadow}
use std::gpu::{
    Append, AppendBuffer, ClipPosition, DrawArgs, DrawIndexedArgs, Flat, FragCoord, GlobalId,
    GpuBuffer, InstanceIndex, One, RenderPass, Rgba16Float, Sampler, Slots, Texture, Unorm8x4,
    VertexIndex, append_buffer, buffer, buffer_of, discard, dispatch, draw,
}
use std::derive::Box2
use std::math::TAU
use temporal::deforming_of
use terrain::{Levels, Texel, ground_cover_at}
use view::Camera

/// A blade, as placed: its root, its height, its facing (radians) and bend, its width, its
/// ground's normal (packed), and its colour's variation (tint, dry, deep) packed.
pub struct Blade: Copy + GpuData {
    pub root: vec3,
    pub tall: f32,
    pub facing: f32,
    pub bend: f32,
    pub width: f32,
    pub ground: std::gpu::Oct32,
    pub colour: Unorm8x4,
    /// The sky light at its root, from the probes (over 2), sampled where it's placed.
    pub sky: Unorm8x4,
}

/// A flower's head, placed with the grass: where it is, its size, its kind (0 to 2) and seed.
pub struct Flower: Copy + GpuData {
    pub head: vec3,
    pub root: vec3,
    pub height: f32,
    pub size: f32,
    pub kind: u32,
    pub seed: u32,
}

/// The finest cells' spacing (m), how a blade's spacing grows with its distance (a fraction of
/// it), and how far the grass reaches (m).
pub const FINEST: f32 = 0.032
pub const GROWTH: f32 = 0.0085
pub const REACH: f32 = 92.0
/// How far flowers reach (m): they shrink away over its last 12.
pub const FLOWERS_TO: f32 = 60.0
/// The levels of cells: the coarsest's blades reach past REACH.
pub const LEVELS: u32 = 5

/// The blades' tiers: near blades bend along 8 segments, the middle ones along 4, far ones
/// along 2 (the tip the last); a level's blades are its tier's (`tier_of`). Each tier's curve
/// morphs to the next tier's shape over the last stretch before it hands over, so no blade's
/// shape pops.
pub const TIERS: u32 = 3
pub const SEGMENTS: [u32; TIERS] = [8, 4, 2]

/// The tier of level `k`'s blades.
pub fn tier_of(k: u32) -> u32 {
    if k == 0 { 0 } else if k < 3 { 1 } else { 2 }
}

/// Where tier `t` hands over to the next (m from the eye): its last level's outer ring.
pub fn tier_end(t: u32) -> f32 {
    if t == 0 { ring(0) } else if t == 1 { ring(2) } else { 1.0e9 }
}

/// The most blades and flowers a frame places.
pub const MAX_BLADES: u32 = 196608
pub const MAX_FLOWERS: u32 = 32768

/// The spacing wanted between blades `d` metres from the eye.
pub fn spacing_at(d: f32) -> f32 {
    max(FINEST, GROWTH * d)
}

/// Where level `k`'s cells end (m from the eye): its blades are wanted between `ring(k - 1)`
/// and `ring(k)` (level 0's from the eye).
pub fn ring(k: u32) -> f32 {
    2.0 * FINEST * f32(1 << k) / GROWTH
}

/// What a level's placement reads: the camera, the level, the cells it covers this frame (their
/// first, and how many each way), and how far ahead a blade must be to be in view (`ahead`: the
/// cosine of the view's half angle, widened, from its direction; found once for the frame).
pub struct Place: Copy + GpuData {
    pub cam: Camera,
    pub light: Light,
    pub grid: ProbeGrid,
    pub clouds: Clouds,
    pub first: vec2,
    pub level: u32,
    pub cols: u32,
    pub ahead: f32,
}

/// The cells level `k` covers when the eye is at `eye`, looking along `forward`: its first
/// cell and how many each way, the box round the part of its ring the view can see (its ring's
/// square, when the view looks steeply down).
pub fn cells(k: u32, cam: Camera) -> (vec2, u32, u32) {
    let s = FINEST * f32(1 << k)
    let outer = min(ring(k), REACH) + s
    // The view's sector on the ground: the eye, and its edges `outer` away. Its half angle is
    // the screen's, widened a little for the blades' lean.
    let half = atan(cam.tan_half * cam.aspect) + 0.12
    let f = normalize(vec2(cam.forward.x, cam.forward.z) + vec2(1.0e-6, 0.0))
    var lo = cam.eye.xz
    var hi = cam.eye.xz
    // Looking down, the whole ring is in view; else the sector's corners bound it.
    if cam.forward.y < -0.8 {
        lo = cam.eye.xz - vec2(outer)
        hi = cam.eye.xz + vec2(outer)
    } else {
        for i in 0..5 {
            let a = -half + 2.0 * half * f32(i) / 4.0
            let (c, sn) = (cos(a), sin(a))
            let d = vec2(c * f.x - sn * f.y, sn * f.x + c * f.y)
            let p = cam.eye.xz + d * outer
            lo = min(lo, p)
            hi = max(hi, p)
        }
        // A little behind the eye too: blades lean into view from there.
        lo = min(lo, cam.eye.xz - vec2(0.6))
        hi = max(hi, cam.eye.xz + vec2(0.6))
    }
    let first = floor(lo / s)
    let n = vec2u(ceil(hi / s) - first)
    (first, n.x, n.y)
}

/// The child (at level `k - 1`) whose blade level `k`'s cell `c` holds: one of its four, by a
/// hash.
fn first_child(c: vec2i, k: u32) -> vec2i {
    let h = u32(hash2(c.x * 2 + 7 * i32(k), c.y * 2 - 3) * 4.0)
    vec2i(c.x * 2 + i32(h & 1), c.y * 2 + i32(h >> 1))
}

/// The finest cell whose blade a level-`k` cell holds: its first child's, all the way down.
fn finest_cell(c: vec2i, k: u32) -> vec2i {
    var cell = c
    var level = k
    while level > 0 {
        cell = first_child(cell, level)
        level -= 1
    }
    cell
}

/// Width of a blade's density fade. Reserve this much below the largest rank so all four
/// children start a ring at full height, while the inherited blade ends it at full height.
const DENSITY_FADE: f32 = 0.15

/// A cell's rank among its siblings: the parent's inherited blade is exactly 0. The other
/// three ranks include jitter, with room left for their fade at the ring's inner edge.
fn rank(c: vec2i, k: u32) -> f32 {
    let parent = vec2i(i32(floor(f32(c.x) / 2.0)), i32(floor(f32(c.y) / 2.0)))
    let first = first_child(parent, k + 1)
    if c.x == first.x && c.y == first.y {
        return 0.0
    }
    // Shuffle the other three for each parent. A fixed quadrant order made diagonal rows
    // where a level retained two or three of its four children.
    let i = (c.x - parent.x * 2) + 2 * (c.y - parent.y * 2)
    let j = (first.x - parent.x * 2) + 2 * (first.y - parent.y * 2)
    let order = if i < j { i } else { i - 1 }
    let shuffle = hash2u(parent.x, parent.y, k + 413)
    let turned = (u32(order) + shuffle % 3) % 3
    let ranked = if (shuffle & 8) == 0 { turned } else { 2 - turned }
    f32(1 + ranked) + (1.0 - DENSITY_FADE) * hash2(c.x + 911, c.y - 77)
}

fn density_keep(c: vec2i, k: u32, distance: f32) -> f32 {
    let spacing = FINEST * f32(1 << k)
    let want = spacing / spacing_at(distance)
    4.0 * want * want - rank(c, k)
}

fn density_scale(keep: f32, k: u32) -> f32 {
    if k + 1 < LEVELS { smoothstep(0.0, DENSITY_FADE, keep) } else { 1.0 }
}

/// A level's blades and flowers: each cell of the level's box whose blade falls in the level's
/// ring and in view, kept by its rank, placed on the clipmap's ground by its meadow.
@compute(8, 8)
pub fn place(
    at: Place,
    levels: Levels,
    texels: [Texel],
    probes: Texture<Rgba16Float>,
    cloud: Texture<Rgba16Float>,
    linear: Sampler,
    grounds: [f32],
    stones: [vec4],
    flora: Flora,
    blades: mut Append<Blade>,
    flowers: mut Append<Flower>,
    id: GlobalId,
) {
    if id.x >= at.cols {
        return
    }
    let k = at.level
    let s = FINEST * f32(1 << k)
    // The cell keyed to the world (the render origin in this level's cells added: a whole
    // number of them, as the origin moves by whole tiles), so the blades stay where they are
    // when the origin moves.
    let keyed = at.cam.keyed().xz
    let c = vec2i(i32(at.first.x) + i32(id.x), i32(at.first.y) + i32(id.y)) +
        vec2i(round(keyed / s))
    // The blade's place: its finest cell's, jittered in it, in render space.
    let f = finest_cell(c, k)
    let jitter = vec2(hash2(f.x, f.y), hash2(f.y + 31, f.x - 17))
    let xz = (vec2(f) + jitter) * FINEST - keyed
    let d = length(xz - at.cam.eye.xz)
    // Its level places it only within its ring (the next level places it beyond).
    let inner = if k == 0 { 0.0 } else { ring(k - 1) }
    if d < inner || d >= ring(k) || d > REACH {
        return
    }
    // In view: within the view's sector, or near enough the eye to lean into it.
    let to = normalize(vec3(xz.x, at.cam.eye.y - 0.5, xz.y) - at.cam.eye)
    let ahead = dot(to, at.cam.forward)
    if d > 1.0 && ahead < at.ahead && ahead < 0.2 {
        return
    }
    // Kept while its rank is under the density this distance asks (from 1 at the level's
    // inner edge to a quarter at its outer).
    let keep = density_keep(c, k, d)
    if keep <= 0.0 && k + 1 < LEVELS {
        return
    }
    // Out of the stones, and short round them for a stride past their reach (grazed and trodden
    // there, as round a standing stone or a wall), so their feet show.
    var trodden = 1.0
    for st in stones {
        let past = length(xz - st.xy) - st.z
        if past < 0.0 {
            return
        }
        trodden = min(trodden, mix(0.3, 1.0, smoothstep(0.0, 1.6, past)))
    }
    let t = ground_cover_at(levels, texels, xz)
    let cover = t.cover
    let meadow = t.meadow
    let n = (f.x * 73856093) ^ (f.y * 19349663)
    let seed = u32(n)
    let y = t.height
    // It shrinks away as it's dropped (keep from 0.15 to 0), and over the last stretch of the
    // grass's reach, into the meadow's ground: nothing pops.
    let dropped = density_scale(keep, k)
    let shrink = dropped * trodden * (1.0 - smoothstep(REACH - 12.0, REACH, d))
    let grass = rand(seed, 3) < cover.a
    // In the grass, a share of forbs (a meadow is not grass alone: `FORBS`), most of them in
    // the meadow's drifts of flowers (`bloom_drift`).
    let wxz = xz + keyed
    let drift = if grass { bloom_drift(wxz) } else { 0.0 }
    // The sward's drifts (`sward`): the blades' height and lie, and the forbs' and the wood's
    // floor's plants' too where they grow in the grass, so a grazed gap is low all through and
    // nothing stands out of it as a spike.
    let (lie, swathe) = sward(wxz)
    let lawn = mix(1.0, mix(0.65, 1.2, swathe), smoothstep(0.05, 0.4, cover.a))
    let forb = grass && rand(seed, 15) < FORBS * (0.6 + 0.8 * drift)
    if !grass || forb {
        // No grass: perhaps one of the wood's floor's own plants, or a forb of the open's.
        let p = WoodPlant { xz, y, d, seed, shrink: shrink * lawn, forb, drift }
        under_plant(
            at,
            t,
            p,
            levels,
            texels,
            probes,
            cloud,
            linear,
            grounds,
            flora,
            mut blades,
            mut flowers,
        )
        return
    }
    // The sward as a carpet, not a bed of spikes: its height set by its drift (keyed
    // to the world, metres to tens of metres across: taller swathes, quiet grazed gaps), little
    // by the blade, so no one blade stands out of its neighbours; a few lit tufts.
    let tuft = noise::noise2(wxz * 1.3 + vec2(-5.0, 8.0))
    let tall = (0.15 + 0.55 * meadow.x) *
        (0.6 + 0.7 * rand(seed, 4)) *
        mix(0.65, 1.2, swathe) *
        (0.9 + 0.3 * smoothstep(0.6, 0.85, tuft)) *
        shrink
    let width = spacing_at(d) * (0.75 + 0.5 * rand(seed, 5))
    // Its tuft: blades gather in tussocks a hand or two across, splaying out from its middle
    // (a tuft reads as one mass, where blades stood alone as spikes), the tallest in the middle,
    // all combed the patch's way.
    // Turn the tuft lattice away from the blade lattice and warp it smoothly;
    // aligned square tuft boundaries read as planted rows even with jittered roots.
    let tuft_space = vec2(0.8 * wxz.x - 0.6 * wxz.y, 0.6 * wxz.x + 0.8 * wxz.y)
    let warp = vec2(noise::noise2(wxz * 0.7), noise::noise2(wxz * 0.7 + vec2(31.0))) * TUFT
    let tc = floor((tuft_space + warp) / TUFT)
    let ti = vec2i(tc)
    let middle = (tc +
        vec2(0.5) +
        0.6 * (vec2(hash2(ti.x + 5, ti.y), hash2(ti.y - 3, ti.x)) - 0.5)) *
        TUFT
    let offset = tuft_space + warp - middle
    let away = vec2(0.8 * offset.x + 0.6 * offset.y, -0.6 * offset.x + 0.8 * offset.y)
    let out = length(away) / (0.75 * TUFT)
    let splay = tuft_direction(away, lie, seed)
    let tall = tall * (1.1 - 0.2 * saturate(out))
    let tint = rand(seed, 8)
    let ground_n = t.normal
    let root = vec3(xz.x, y + 0.1, xz.y)
    let shade = cloud_shadow(at.clouds, cloud, linear, root)
    let sky = sky_light(at.grid, probes, linear, grounds, at.light, root, ground_n, shade)
    let _ = blades.push(
        Blade {
            root: vec3(xz.x, y - 0.02, xz.y),
            tall,
            // Splayed from its tuft and combed by the wind and the herd, bending over more
            // toward the tuft's edge, so the blades cover the ground as a pile does.
            facing: atan2(splay.y, splay.x),
            bend: 0.45 + 0.35 * saturate(out) + 0.35 * rand(seed, 7),
            width,
            ground: std::gpu::Oct32::encode(t.normal),
            colour: Unorm8x4::encode(
                vec4(
                    tint,
                    saturate(
                        meadow.y + 0.25 * (tint - 0.5) + 0.5 * (noise::noise2(wxz * 0.21) - 0.5),
                    ),
                    meadow.z,
                    0.0,
                ),
            ),
            sky: Unorm8x4::encode(vec4(saturate(sky * 0.5), 0.0)),
        },
    )
    // A flower on its tip, where the meadow has them, in its drifts: which kind, by their
    // weights here.
    let fw = t.flowers
    if rand(seed, 11) < fw.w * (0.04 + 1.8 * drift) && d < FLOWERS_TO {
        let r = rand(seed, 12) * (fw.x + fw.y + fw.z)
        let kind = if r < fw.x { 0 } else if r < fw.x + fw.y { 1 } else { 2 }
        let _ = flowers.push(
            Flower {
                head: vec3(xz.x, y + tall * (0.75 + 0.35 * rand(seed, 13)), xz.y),
                root: vec3(xz.x, y, xz.y),
                height: tall,
                size: (0.035 + 0.03 * rand(seed, 14)) *
                    shrink *
                    (1.0 - smoothstep(FLOWERS_TO - 12.0, FLOWERS_TO, d)),
                kind,
                seed,
            },
        )
    }
}

/// A tuft spreads all around its root. The meadow's prevailing lie only nudges it;
/// overpowering that spread made every blade lean in parallel strips.
fn tuft_direction(away: vec2, lie: f32, seed: u32) -> vec2 {
    let comb = vec2(cos(lie), sin(lie))
    let turn = TAU * rand(seed, 6)
    normalize(normalize(away + vec2(1.0e-4)) * 0.8 + comb * 0.3 + vec2(cos(turn), sin(turn)) * 0.5)
}

/// Where a plant of the wood's floor might stand: its place, the ground's height there, its
/// distance from the eye, its cell's seed, and how far it's shrunk away (as a blade there is).
struct WoodPlant: Copy {
    xz: vec2,
    y: f32,
    d: f32,
    seed: u32,
    shrink: f32,
    /// A forb in the grass: one of the open's species, not as `Cover::under` asks.
    forb: bool,
    /// How far into a drift of flowers it stands (`bloom_drift`).
    drift: f32,
}

/// The meadow's drifts at `w` (in the world): which way its blades lie (radians: combed in
/// swathes, turning slowly across the meadow), and how tall the sward stands, 0 in its quiet
/// grazed gaps to 1 in its tall swathes (one even, spiky height reads as a bed of nails).
pub fn sward(w: vec2) -> (f32, f32) {
    let lie = TAU * noise::fbm2(w * 0.035 + vec2(-13.0, 5.0), 2) * 1.5
    let swathe = smoothstep(0.3, 0.72, noise::fbm2(w * 0.07 + vec2(11.0, 3.0), 3))
    (lie, swathe)
}

/// How far `w` (in the world) is into one of the meadow's drifts of flowers, 0 to 1: drifts
/// some metres across with few flowers between them, not flowers scattered evenly (which read
/// as confetti).
pub fn bloom_drift(w: vec2) -> f32 {
    let warped = w + 6.0 * vec2(noise::noise2(w * 0.05), noise::noise2(w * 0.05 + vec2(4.0, 9.0)))
    smoothstep(0.58, 0.74, noise::fbm2(warped * 0.06 + vec2(3.0, -7.0), 2))
}

/// The share of the grass's places a forb takes (a meadow's sward is about a third forbs by
/// cover; fewer read better among blades this size).
pub const FORBS: f32 = 0.1

/// The ground a frond of a fern or of bracken covers (m²): the wood's floor's plants' density
/// (`Cover::under`) is fronds this far apart.
pub const FROND_AREA: f32 = 0.18

/// How far apart the meadow's tufts are (m).
pub const TUFT: f32 = 0.24

/// How near the eye no frond grows (m, on the plane).
pub const CLEAR_EYE: f32 = 1.5

/// The grid a fern's fronds gather to its crown on (m), and a herb's leaves to its rosette.
pub const FERN_CROWN: f32 = 1.1
pub const HERB_ROSETTE: f32 = 0.35

/// A blade's kind (`Blade::colour`'s fourth part): grass, a fern's frond, bracken's, a herb's
/// leaf.
pub const GRASS_BLADE: f32 = 0.0
/// A strap leaf of the wood's floor (a bluebell's, a sedge's): tapering as a blade does, its
/// colour its species'.
pub const STRAP: f32 = 0.17
pub const FERN: f32 = 0.34
pub const BRACKEN: f32 = 0.67
pub const HERB: f32 = 1.0

/// A species of the wood's floor (beech with bramble; acid oak and birch with bracken, bramble,
/// bluebell, bilberry and wavy hair-grass; ash on richer soil with dog's mercury, ramsons and
/// wood anemone; wet alder with sedges, yellow pimpernel and bugle; foxglove and nettle in
/// glades and on worn ground): its shape
/// (`HERB`, a broad leaf; `STRAP`, a strap leaf; `BRACKEN`, a frond of leaflets), how tall
/// and wide (m) and how far it arches, its leaves' colour (linear), its flower (a bloom's kind and
/// 1, or 0) and how many flower; and the habitat it grows in (`Cover::flora`): its soil's acidity,
/// wetness and light, each a range it thrives in.
pub struct Species: Copy + GpuData {
    pub colour: vec3,
    pub shape: f32,
    pub acid: vec2,
    pub wet: vec2,
    pub light: vec2,
    pub tall: f32,
    pub wide: f32,
    pub bend: f32,
    pub bloom: u32,
    pub blooms: f32,
    /// How much it likes worn, trodden ground (0: it's worn away there).
    pub worn: f32 = 0.0,
}

/// The wood's floor's species (0 is none: the generic herb). Ferns and bracken are kinds of their
/// own (`FERN`, `BRACKEN`).
pub const SPECIES = [
    Species {
        colour: vec3(0.075, 0.13, 0.04),
        shape: HERB,
        acid: vec2(0.0, 1.0),
        wet: vec2(0.0, 1.0),
        light: vec2(0.0, 1.0),
        tall: 0.1,
        wide: 0.13,
        bend: 0.7,
        bloom: 0,
        blooms: 0.0,
    },
    // Bluebell: strap leaves, a haze of blue flowers; acid to neutral soil, shade.
    Species {
        colour: vec3(0.035, 0.085, 0.03),
        shape: STRAP,
        acid: vec2(0.3, 0.9),
        wet: vec2(0.0, 0.65),
        light: vec2(0.05, 0.5),
        tall: 0.3,
        wide: 0.022,
        bend: 0.55,
        bloom: 3,
        blooms: 0.55,
    },
    // Dog's mercury: carpets of upright leaves on base-rich soil, in shade.
    Species {
        colour: vec3(0.05, 0.11, 0.03),
        shape: HERB,
        acid: vec2(0.0, 0.4),
        wet: vec2(0.1, 0.8),
        light: vec2(0.0, 0.5),
        tall: 0.24,
        wide: 0.06,
        bend: 0.25,
        bloom: 0,
        blooms: 0.0,
    },
    // Ramsons: broad bright leaves and white flowers on damp, rich soil.
    Species {
        colour: vec3(0.07, 0.15, 0.04),
        shape: HERB,
        acid: vec2(0.0, 0.5),
        wet: vec2(0.4, 0.95),
        light: vec2(0.0, 0.55),
        tall: 0.28,
        wide: 0.07,
        bend: 0.45,
        bloom: 1,
        blooms: 0.35,
    },
    // Wood anemone: small leaves and white flowers, in light shade.
    Species {
        colour: vec3(0.06, 0.12, 0.035),
        shape: HERB,
        acid: vec2(0.15, 0.75),
        wet: vec2(0.1, 0.8),
        light: vec2(0.1, 0.6),
        tall: 0.12,
        wide: 0.05,
        bend: 0.4,
        bloom: 1,
        blooms: 0.6,
    },
    // Bramble: arching canes of dark leaflets where light comes through: gaps and edges.
    Species {
        colour: vec3(0.035, 0.07, 0.025),
        shape: BRACKEN,
        acid: vec2(0.0, 1.0),
        wet: vec2(0.0, 0.75),
        light: vec2(0.25, 0.85),
        tall: 0.75,
        wide: 0.3,
        bend: 0.95,
        bloom: 1,
