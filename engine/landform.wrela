// Landforms: a land's relief as its rock, the uplift under it and its water made it, worked out
// at build time over a grid. Each step raises the land, routes its water to the base level (pits
// flooded, Barnes, Lehman and Mulla's priority flood with an epsilon), cuts the channels by the
// stream power law (Braun and Willett, 2013: implicit, n = 1, in the order the water flows) and
// lets the slopes creep (linear diffusion). Rock that's hard to erode keeps its height; soft rock
// goes. A game gives the land it starts from, which cells hold the base level, the uplift and
// the rock; what it keeps is the relief (`Relief`), which its terrain reads on the CPU and the
// GPU alike, and what an agent reads of it (`Landscape`, `summary`): heights, where the water
// goes, how much gathers, and the land's forms.

use grow::{Grid, Heap, NEIGHBOURS, NONE}

/// How far the flood raises a cell over the cell it reached it from (m), so every cell it
/// fills still drains: a little, but more than a float's step anywhere within `HIGHEST`.
const RISE: f32 = 1.0e-3

/// How far from 0 a land's heights may be (m): within it a float's step is under `RISE` / 2.
pub const HIGHEST: f32 = 4096.0

/// Where the water on a land goes: each cell's receiver, the neighbour it falls to most steeply
/// over the land with its pits filled (`NONE` where none is lower: an outlet); the land with its
/// pits filled; and the cells in the order the flood reached them, so a cell's receiver always
/// comes before it.
pub struct Drainage {
    pub down: Vec<u32>,
    pub filled: Vec<f32>,
    pub order: Vec<u32>,
}

/// Where the water on the land `heights` (over grid `g`) goes, `outlets` the cells it leaves the
/// land by. The pits are filled by flooding from the outlets, lowest first, each cell raised to
/// `RISE` over the cell it's reached from (Barnes, Lehman and Mulla's priority flood, with an
/// epsilon), so every cell drains to an outlet, across a pit by the way it would spill.
pub fn drainage(g: Grid, heights: [f32], outlets: [bool]) -> Drainage {
    let nn = g.cells()
    let (nx, nz) = (g.nx, g.nz)
    var filled: Vec<f32> = Vec::filled(nn, 0.0)
    var done: Vec<bool> = Vec::filled(nn, value: false)
    var order: Vec<u32> = Vec::with_capacity(nn)
    var heap = Heap { items: Vec::new() }
    for c in 0..nn {
        assert(abs(heights[c]) < HIGHEST, "a land's height is past `landform::HIGHEST`")
        if outlets[c] {
            filled[c] = heights[c]
            done[c] = true
            heap.push(filled[c], c)
        }
    }
    while !heap.items.is_empty() {
        let top = heap.pop()
        let h = bitcast_f32(top.x)
        let c = top.y
        order.push(c)
        let (i, j) = (i32(c % nx), i32(c / nx))
        for k in 0..8 {
            let n = vec2i(i, j) + NEIGHBOURS[k]
            if n.x >= 0 && n.y >= 0 && n.x < i32(nx) && n.y < i32(nz) {
                let q = u32(n.y) * nx + u32(n.x)
                if !done[q] {
                    done[q] = true
                    filled[q] = max(heights[q], h + RISE)
                    heap.push(filled[q], q)
                }
            }
        }
    }
    var down: Vec<u32> = Vec::filled(nn, NONE)
    for c in 0..nn {
        let (i, j) = (i32(c % nx), i32(c / nx))
        var best = 0.0
        for k in 0..8 {
            let n = vec2i(i, j) + NEIGHBOURS[k]
            if n.x >= 0 && n.y >= 0 && n.x < i32(nx) && n.y < i32(nz) {
                let q = u32(n.y) * nx + u32(n.x)
                let fall = (filled[c] - filled[q]) / length(vec2(NEIGHBOURS[k]))
                if fall > best {
                    best = fall
                    down[c] = q
                }
            }
        }
    }
    Drainage { down, filled, order }
}

/// A grid's border cells: `drainage`'s outlets where the water leaves by every edge.
pub fn border(g: Grid) -> Vec<bool> {
    Vec::from_fn(g.cells(), |c| {
        let (i, j) = (c % g.nx, c / g.nx)
        i == 0 || j == 0 || i == g.nx - 1 || j == g.nz - 1
    })
}

// ---- the land's making --------------------------------------------------------------------------

/// How a land is made: how many steps, each how many years; the stream power law's exponent on
/// the area a channel drains (m, about 0.5; n is 1); and how fast its slopes creep (m² a year).
pub struct Shaping: Copy {
    pub steps: u32,
    pub years: f32,
    pub m: f32,
    pub creep: f32,
}

/// A land as it was made: its grid, its heights (m), each cell's receiver (`NONE` at the base
/// level), the area that drains through it (m²), its uplift (m a year), its rock's erodibility
/// (the stream power law's K) and which cells hold the base level.
pub struct Landscape: Clone {
    pub grid: Grid,
    pub heights: Vec<f32>,
    pub down: Vec<u32>,
    pub area: Vec<f32>,
    pub uplift: Vec<f32>,
    pub erodibility: Vec<f32>,
    pub base: Vec<bool>,
}

/// The land made from `start` (heights over grid `g`) over `s`'s steps: the cells `base` holds
/// at their heights, the base level, which the water leaves the land by; the rest raised by
/// `uplift` (m a year) each year, their water routed across their pits, their channels cut where
/// their rock's `erodibility` (the stream power law's K) lets them, and their slopes crept. What's left has
/// its last pits filled, as lakes: each of its cells stands over its receiver, which is `NONE`
/// only at the base level.
pub fn evolve(
    g: Grid,
    start: [f32],
    base: [bool],
    uplift: [f32],
    erodibility: [f32],
    s: Shaping,
) -> Landscape {
    let nn = g.cells()
    var h: Vec<f32> = Vec::from_fn(nn, |c| start[c])
    var area: Vec<f32> = Vec::filled(nn, 0.0)
    var down: Vec<u32> = Vec::filled(nn, NONE)
    for _ in 0..s.steps {
        for c in 0..nn {
            if !base[c] {
                h[c] += uplift[c] * s.years
            }
        }
        let d = drainage(g, h, base)
        for c in 0..nn {
            down[c] = if base[c] { NONE } else { d.down[c] }
        }
        gather(g, d.order, down, mut area)
        incise(g, d.order, down, area, erodibility, s, mut h)
        diffuse(g, mut h, base, s.creep * s.years)
    }
    // The land as it's left: its pits filled once more (creep can open one), so every cell
    // stands over the one its water goes to.
    let d = drainage(g, h, base)
    for c in 0..nn {
        h[c] = d.filled[c]
        down[c] = if base[c] { NONE } else { d.down[c] }
    }
    gather(g, d.order, down, mut area)
    Landscape {
        grid: g,
        heights: h,
        down,
        area,
        uplift: Vec::from_fn(nn, |c| uplift[c]),
        erodibility: Vec::from_fn(nn, |c| erodibility[c]),
        base: Vec::from_fn(nn, |c| base[c]),
    }
}

/// The area that drains through each cell (m²): its own, and all that reaches it, passed down
/// from the highest cell (the last the flood reached) to the lowest.
fn gather(g: Grid, order: [u32], down: [u32], area: mut Vec<f32>) {
    let own = g.cell * g.cell
    for c in 0..g.cells() {
        area[c] = own
    }
    var n = order.len()
    while n > 0 {
        n -= 1
        let c = order[n]
        if down[c] != NONE {
            area[down[c]] += area[c]
        }
    }
}

/// One step of the stream power law, dh/dt = -K A^m S, n = 1, implicit in the receiver's new
/// height (Braun and Willett, 2013), so it holds at any step: each cell after its receiver, in
/// the flood's order. A cell with no receiver holds, and so does one in a pit, under the
/// receiver its water spills to: a lake's floor isn't cut, but its outlet is, so it drains.
pub fn incise(
    g: Grid,
    order: [u32],
    down: [u32],
    area: [f32],
    k: [f32],
    s: Shaping,
    h: mut Vec<f32>,
) {
    for c in order {
        let r = down[c]
        if r != NONE && h[r] < h[c] {
            let run = length(g.centre(c) - g.centre(r))
            let f = k[c] * s.years * pow(area[c], s.m) / run
            h[c] = (h[c] + f * h[r]) / (1.0 + f)
        }
    }
}

/// Slopes creeping for `kt` (a diffusivity times the time, m²): explicit linear diffusion over
/// the four neighbours, in steps of at most a fifth of a cell's area each (stable), the cells
/// `held` keeping their heights and an edge passing nothing (a missing neighbour is the cell).
pub fn diffuse(g: Grid, h: mut Vec<f32>, held: [bool], kt: f32) {
    if kt <= 0.0 {
        return
    }
    let a = kt / (g.cell * g.cell)
    let parts = u32(ceil(a / 0.2))
    let each = a / f32(parts)
    let (nx, nz) = (g.nx, g.nz)
    var was: Vec<f32> = Vec::filled(g.cells(), 0.0)
    for _ in 0..parts {
        for c in 0..g.cells() {
            was[c] = h[c]
        }
        for j in 0..nz {
            for i in 0..nx {
                let c = j * nx + i
                if !held[c] {
                    let here = was[c]
                    let w = if i > 0 { was[c - 1] } else { here }
                    let e = if i + 1 < nx { was[c + 1] } else { here }
                    let n = if j > 0 { was[c - nx] } else { here }
                    let sth = if j + 1 < nz { was[c + nx] } else { here }
                    h[c] = here + each * (w + e + n + sth - 4.0 * here)
                }
            }
        }
    }
}

// ---- the relief, as the terrain reads it --------------------------------------------------------

/// A land's relief over its grid, `N` cells (`nx` × `nz`, from `lo`, `cell` metres a side), as a
/// terrain reads it on the CPU and the GPU: each cell's rise over the land the game made it
/// from (m), and how wet it is, from the area that drains through it (0 to 1), packed in a word
/// (`pack`), so a terrain that holds one stays small. Its fields are sampled between the cells'
/// middles: the rise smoothly (Catmull-Rom, through each cell's own), the wetness linearly; past
/// the grid each is its nearest edge's.
pub struct Relief<const N: u32>: Copy + GpuData {
    pub lo: vec2,
    pub cell: f32,
    pub nx: u32,
    pub nz: u32,
    pub cells: [u32; N],
}

/// A relief's rise, from `-RISE_RANGE` to `RISE_RANGE` m in steps of 1 / `RISE_STEPS` m, in a
/// word's low 24 bits; its wetness, 0 to 255, in the high 8.
pub const RISE_RANGE: f32 = 1024.0
const RISE_STEPS: f32 = 8192.0
const LOW_24: u32 = 16777215

/// A cell of a relief: its rise (m, within `RISE_RANGE`) and its wetness (0 to 1).
pub fn pack(rise: f32, wet: f32) -> u32 {
    assert(abs(rise) < RISE_RANGE, "a relief's rise is past `landform::RISE_RANGE`")
    let r = min(u32(round((rise + RISE_RANGE) * RISE_STEPS)), LOW_24)
    r | (u32(round(saturate(wet) * 255.0)) << 24)
}

/// The area a channel drains (m²) at which the ground is as wet as it gets, and below which
/// it's dry: the wetness runs between them on a log scale.
pub const DRY_AREA: f32 = 2.0e4
pub const WET_AREA: f32 = 4.0e6

impl<const N: u32> Relief<N> {
    /// The relief of `l`, made from the land `from` (each cell's height before it was made).
    pub fn of(l: Landscape, from: [f32]) -> Relief<N> {
        let g = l.grid
        assert(g.cells() == N, "a relief's grid has `N` cells")
        var r = Relief { lo: g.lo, cell: g.cell, nx: g.nx, nz: g.nz, cells: [0; N] }
        let span = log(WET_AREA / DRY_AREA)
        for c in 0..N {
            r.cells[c] = pack(l.heights[c] - from[c], log(l.area[c] / DRY_AREA) / span)
        }
        r
    }

    /// No relief over grid `g`: none of its cells risen, none wet.
    pub fn none(g: Grid) -> Relief<N> {
        assert(g.cells() == N, "a relief's grid has `N` cells")
        Relief { lo: g.lo, cell: g.cell, nx: g.nx, nz: g.nz, cells: [pack(rise: 0.0, wet: 0.0); N] }
    }

    /// Cell `c`'s rise (m).
    pub fn rise(self, c: u32) -> f32 {
        rise_of(self.cells[c])
    }

    /// Cell `c`'s wetness (0 to 1).
    pub fn wet(self, c: u32) -> f32 {
        wet_of(self.cells[c])
    }

    // The fields read the cells in place, and work out where they are from numbers alone: a
    // method of the relief's called for each cell would copy the whole relief into the GPU's
    // private memory each time.

    /// The rise at `p` (m): Catmull-Rom between the cells' middles, through each one's own.
    pub fn rise_at(self, p: vec2) -> f32 {
        let q = (p - self.lo) / self.cell - vec2(0.5)
        let f = q - floor(q)
        let c = vec2i(floor(q))
        let wx = catmull_rom(f.x)
        let wz = catmull_rom(f.y)
        var y = 0.0
        for b in 0..4 {
            var row = 0.0
            for a in 0..4 {
                let k = clamped(self.nx, self.nz, c.x - 1 + i32(a), c.y - 1 + i32(b))
                row += wx[a] * rise_of(self.cells[k])
            }
            y += wz[b] * row
        }
        y
    }

    /// How wet the ground is at `p` (0 to 1), linear between the cells' middles.
    pub fn wet_at(self, p: vec2) -> f32 {
        let q = (p - self.lo) / self.cell - vec2(0.5)
        let f = q - floor(q)
        let c = vec2i(floor(q))
        let (nx, nz) = (self.nx, self.nz)
        let a = mix(
            wet_of(self.cells[clamped(nx, nz, c.x, c.y)]),
            wet_of(self.cells[clamped(nx, nz, c.x + 1, c.y)]),
            f.x,
        )
        let b = mix(
            wet_of(self.cells[clamped(nx, nz, c.x, c.y + 1)]),
            wet_of(self.cells[clamped(nx, nz, c.x + 1, c.y + 1)]),
            f.x,
        )
        mix(a, b, f.y)
    }

    /// How much of the relief holds at `p` (0 to 1): all of it more than `collar` metres inside
    /// the outermost cells' middles, none past them, smoothly between (level at both ends), so a
    /// terrain that adds `within(p) * rise_at(p)` to the land it was made from meets that land at
    /// the grid's edges with no step and no crease.
    pub fn within(self, p: vec2, collar: f32) -> f32 {
        let first = self.lo + vec2(0.5 * self.cell)
        let last = self.lo + (vec2(f32(self.nx), f32(self.nz)) - vec2(0.5)) * self.cell
        let inside = min(p - first, last - p)
        smoothstep(0.0, collar, inside.x) * smoothstep(0.0, collar, inside.y)
    }
}

/// A packed cell's rise (m) and wetness (0 to 1).
fn rise_of(cell: u32) -> f32 {
    f32(cell & LOW_24) / RISE_STEPS - RISE_RANGE
}

fn wet_of(cell: u32) -> f32 {
    f32(cell >> 24) / 255.0
}

/// The index of cell (i, j) of a grid `nx` by `nz`, each clamped to it.
fn clamped(nx: u32, nz: u32, i: i32, j: i32) -> u32 {
    u32(clamp(j, 0, i32(nz) - 1)) * nx + u32(clamp(i, 0, i32(nx) - 1))
}

/// Catmull-Rom's weights at `t` (0 to 1) along a span, for the points before it, at its ends and
/// after it.
fn catmull_rom(t: f32) -> vec4 {
    let t2 = t * t
    let t3 = t2 * t
    vec4(
        0.5 * (-t3 + 2.0 * t2 - t),
        0.5 * (3.0 * t3 - 5.0 * t2 + 2.0),
        0.5 * (-3.0 * t3 + 4.0 * t2 + t),
        0.5 * (t3 - t2),
    )
}

// ---- what an agent reads of it ------------------------------------------------------------------

/// A land as an agent surveys it: what its making left (`made`); how much each cell rose or sank
/// over the land it was made from (m); the heights a game draws over the same grid's cells, the
/// final surface; and the cells where the relief holds whole, which its summary counts.
pub struct Survey: Clone {
    pub made: Landscape,
    pub rise: Vec<f32>,
    pub surface: Vec<f32>,
    pub counted: Vec<bool>,
}

impl Survey {
    /// The final surface's summary over the counted cells, its channels those that drain more
    /// than `channel` m².
    pub fn summary(self, channel: f32) -> Summary {
        summary(self.made.grid, self.surface, self.made.area, self.made.base, self.counted, channel)
    }
}

/// A land's form at a cell, from its slope and curvature at the grid's scale: flat; a ridge's
/// crest or a spur running down from one (convex: gently, steeply); an even slope; a hollow or a
/// valley's floor (concave: steeply, gently); a cliff.
pub enum Landform: Copy + Eq + Fieldless {
    Flat,
    Ridge,
    Spur,
    Slope,
    Hollow,
    Valley,
    Cliff,
}

/// The slope (rise over run) past which a cell is a cliff (about 45°), under which it's flat
/// (about 3°), and the curvature (1/m, the Laplacian of its heights) past which it's convex or
/// concave.
pub const CLIFF: f32 = 1.0
pub const LEVEL: f32 = 0.05
pub const CURVED: f32 = 2.0e-4

/// The slope (rise over run) and the curvature (the Laplacian, 1/m; positive in a hollow) of
/// heights `h` over grid `g` at cell (i, j), by central differences, an edge's one-sided.
pub fn shape(g: Grid, h: [f32], i: i32, j: i32) -> vec2 {
    let here = h[g.index(i, j)]
    let w = h[g.index(i - 1, j)]
    let e = h[g.index(i + 1, j)]
    let n = h[g.index(i, j - 1)]
    let s = h[g.index(i, j + 1)]
    let dx = (e - w) / (2.0 * g.cell)
    let dz = (s - n) / (2.0 * g.cell)
    vec2(length(vec2(dx, dz)), (w + e + n + s - 4.0 * here) / (g.cell * g.cell))
}

/// The form of heights `h` over grid `g` at cell (i, j).
pub fn landform(g: Grid, h: [f32], i: i32, j: i32) -> Landform {
    let sc = shape(g, h, i, j)
    let (slope, lap) = (sc.x, sc.y)
    if slope >= CLIFF {
        Landform::Cliff
    } else if slope < LEVEL && abs(lap) < CURVED {
        Landform::Flat
    } else if lap < -CURVED {
        if slope < 0.27 { Landform::Ridge } else { Landform::Spur }
    } else if lap > CURVED {
        if slope < 0.14 { Landform::Valley } else { Landform::Hollow }
    } else {
        Landform::Slope
    }
}

/// What a land's heights `h` over grid `g` add up to, over the cells `counted`: their lowest,
/// highest and mean height (m); its hypsometric integral (where the mean stands between the
/// lowest and the highest, 0 to 1); how many cells' slopes are under 5°, 15°, 30° and 45° and
/// past it (shares); its forms' shares, in `Landform`'s order; its drainage density (km of
/// channel, cells that drain over `channel` m² by `area`, a km²); and its pits, cells with no
/// lower neighbour that aren't outlets.
pub struct Summary: Copy {
    pub low: f32,
    pub high: f32,
    pub mean: f32,
    pub hypsometric: f32,
    pub slopes: [f32; 5],
    pub forms: [f32; Landform],
    pub density: f32,
    pub pits: u32,
}

/// The slopes (rise over run) between `Summary::slopes`' shares: 5°, 15°, 30° and 45°.
const SLOPES = [0.0875, 0.268, 0.577, 1.0]

pub fn summary(
    g: Grid,
    h: [f32],
    area: [f32],
    outlets: [bool],
    counted: [bool],
    channel: f32,
) -> Summary {
    var s = Summary {
        low: 1.0e9,
        high: -1.0e9,
        mean: 0.0,
        hypsometric: 0.0,
        slopes: [0.0; 5],
        forms: [0.0; Landform],
        density: 0.0,
        pits: 0,
    }
    var n = 0
    var channels = 0
    for j in 0..g.nz {
        for i in 0..g.nx {
            let c = j * g.nx + i
            if !counted[c] {
                continue
            }
            n += 1
            s.low = min(s.low, h[c])
            s.high = max(s.high, h[c])
            s.mean += h[c]
            let slope = shape(g, h, i32(i), i32(j)).x
            var b = 0
            while b < 4 && slope >= SLOPES[b] {
                b += 1
            }
            s.slopes[b] += 1.0
            s.forms[landform(g, h, i32(i), i32(j))] += 1.0
            if area[c] > channel {
                channels += 1
            }
            if !outlets[c] {
                var lower = false
                for k in 0..8 {
                    let q = vec2i(i32(i), i32(j)) + NEIGHBOURS[k]
                    if q.x >= 0 && q.y >= 0 && q.x < i32(g.nx) && q.y < i32(g.nz) {
                        lower = lower || h[g.index(q.x, q.y)] < h[c]
                    }
                }
                if !lower {
                    s.pits += 1
                }
            }
        }
    }
    if n == 0 {
        return s
    }
    let count = f32(n)
    s.mean /= count
    s.hypsometric = (s.mean - s.low) / max(s.high - s.low, 1.0e-6)
    for b in 0..5 {
        s.slopes[b] /= count
    }
    for f in 0..7 {
        s.forms[f] /= count
    }
    let km2 = count * g.cell * g.cell * 1.0e-6
    s.density = f32(channels) * g.cell * 1.0e-3 / km2
    s
}

// ---- tests --------------------------------------------------------------------------------------

/// A grid `nx` by `nz` cells `cell` metres wide, from the origin.
fn grid(nx: u32, nz: u32, cell: f32) -> Grid {
    Grid { lo: vec2(0.0), nx, nz, cell }
}

/// Whether each cell's receivers lead to an outlet, never round.
fn drains(g: Grid, d: Drainage, outlets: [bool]) -> bool {
    for c in 0..g.cells() {
        var at = c
        var steps = 0
        while d.down[at] != NONE && !outlets[at] {
            at = d.down[at]
            steps += 1
            if steps > g.cells() {
                return false
            }
        }
        if !outlets[at] {
            return false
        }
    }
    true
}

@test
fn a_level_land_drains_to_its_border() {
    let g = grid(nx: 12, nz: 9, cell: 10.0)
    let h: Vec<f32> = Vec::filled(g.cells(), 5.0)
    let outlets = border(g)
    let d = drainage(g, h, outlets)
    assert(drains(g, d, outlets))
    // Every cell's area reaches an outlet, and none twice.
    var area: Vec<f32> = Vec::filled(g.cells(), 0.0)
    let down: Vec<u32> = Vec::from_fn(g.cells(), |c| if outlets[c] { NONE } else { d.down[c] })
    gather(g, d.order, down, mut area)
    var out = 0.0
    for c in 0..g.cells() {
        if outlets[c] {
            out += area[c]
        }
    }
    assert(out == f32(g.cells()) * 100.0)
}

@test
fn a_closed_bowl_spills_by_its_notch() {
    // A bowl closed on every side but a notch in its west wall: the only outlet is past the
    // notch, so every cell drains through it.
    let g = grid(nx: 11, nz: 11, cell: 10.0)
    var h: Vec<f32> = Vec::from_fn(g.cells(), |c| {
        let p = vec2(f32(c % 11), f32(c / 11)) - vec2(5.0)
        0.2 * dot(p, p)
    })
    let notch = g.index(i: 0, j: 5)
    h[g.index(i: 1, j: 5)] = 1.0
    h[notch] = 0.5
    var outlets: Vec<bool> = Vec::filled(g.cells(), value: false)
    outlets[notch] = true
    let d = drainage(g, h, outlets)
    assert(drains(g, d, outlets))
    let down: Vec<u32> = Vec::from_fn(g.cells(), |c| if outlets[c] { NONE } else { d.down[c] })
    var area: Vec<f32> = Vec::filled(g.cells(), 0.0)
    gather(g, d.order, down, mut area)
    assert(area[notch] == f32(g.cells()) * 100.0)
    // The bowl's floor is filled to spill, each cell a little over the one it drains to.
    for c in 0..g.cells() {
        if d.down[c] != NONE && !outlets[c] {
            assert(d.filled[c] > d.filled[d.down[c]])
        }
    }
}

@test
fn equal_spills_choose_one_way_and_never_loop() {
    // Two outlets at the same height either side of a level saddle: each cell drains to one.
    let g = grid(nx: 9, nz: 3, cell: 10.0)
    let h: Vec<f32> = Vec::filled(g.cells(), 2.0)
    var outlets: Vec<bool> = Vec::filled(g.cells(), value: false)
    outlets[g.index(i: 0, j: 1)] = true
    outlets[g.index(i: 8, j: 1)] = true
    let d = drainage(g, h, outlets)
    assert(drains(g, d, outlets))
}

@test
fn creep_damps_a_sine_by_its_exact_factor() {
    // h = A sin(πi/(n-1)) sin(πj/(n-1)), zero on the held border: the five-point Laplacian's
    // eigenvalue for it is -8 sin²(π/2(n-1)) / dx², so one explicit step scales every cell by
    // 1 - 8 a sin²(π/2(n-1)), a = κt/dx².
    let n = 17
    let g = grid(n, n, 8.0)
    let amp = 100.0
    let w = std::math::PI / f32(n - 1)
    var h: Vec<f32> = Vec::from_fn(g.cells(), |c| {
        amp * sin(w * f32(c % n)) * sin(w * f32(c / n))
    })
    let before = h.clone()
    let a = 0.15
    diffuse(g, mut h, border(g), a * g.cell * g.cell)
    let s = sin(0.5 * w)
    let factor = 1.0 - 8.0 * a * s * s
    for c in 0..g.cells() {
        if abs(before[c]) > 1.0 {
            assert(abs(h[c] / before[c] - factor) < 1.0e-4)
        }
    }
}

/// A channel one cell wide, `n` cells long, its outlet at its west end, raised 1 mm a year: each
/// cell's own area and all upstream of it drains through it, so its steady slope is U / (K A^m)
/// exactly (n = 1). Its rock's K is 2e-5, a quarter of that in the cells `hard` (from, to).
fn channel(n: u32, hard: vec2u) -> Landscape {
    let g = grid(n, 1, 50.0)
    let start: Vec<f32> = Vec::filled(n, 0.0)
    var base: Vec<bool> = Vec::filled(n, value: false)
    base[0] = true
    let u: Vec<f32> = Vec::filled(n, 1.0e-3)
    let k: Vec<f32> = Vec::from_fn(n, |i| if i >= hard.x && i < hard.y { 0.5e-5 } else { 2.0e-5 })
    let s = Shaping { steps: 400, years: 2.0e4, m: 0.5, creep: 0.0 }
    evolve(g, start, base, u, k, s)
}

@test
fn a_channel_reaches_the_stream_power_laws_steady_slope() {
    let n = 24
    let l = channel(n, hard: vec2u(0))
    for i in 1..n {
        let a = f32(n - i) * 2500.0
        assert(abs(l.area[i] - a) < 1.0e-3 * a)
        let slope = (l.heights[i] - l.heights[i - 1]) / 50.0
        let law = 1.0e-3 / (2.0e-5 * sqrt(a))
        assert(abs(slope / law - 1.0) < 1.0e-3)
    }
}

@test
fn hard_rock_holds_a_steeper_channel() {
    // A band four times harder: its slope four times the law's for the soft rock at the same area.
    let n = 24
    let l = channel(n, hard: vec2u(10, 14))
    for i in 10..14 {
        let a = f32(n - i) * 2500.0
        let slope = (l.heights[i] - l.heights[i - 1]) / 50.0
        let soft = 1.0e-3 / (2.0e-5 * sqrt(a))
        assert(abs(slope / (4.0 * soft) - 1.0) < 1.0e-3)
    }
}

@test
fn a_relief_passes_through_its_cells_and_fades_at_its_edges() {
    let g = Grid { lo: vec2(-100.0, 40.0), nx: 6, nz: 5, cell: 20.0 }
    let from: Vec<f32> = Vec::filled(30, 3.0)
    let heights: Vec<f32> = Vec::from_fn(30, |c| 3.0 + f32(c % 7) * 1.5 - f32(c / 6))
    var area: Vec<f32> = Vec::filled(30, 400.0)
    area[14] = WET_AREA
    let l = Landscape {
        grid: g,
        heights,
        down: Vec::filled(30, NONE),
        area,
        uplift: Vec::filled(30, 0.0),
        erodibility: Vec::filled(30, 0.0),
        base: Vec::filled(30, value: false),
    }
    let r: Relief<30> = Relief::of(l, from)
    for c in 0..30 {
        let p = g.centre(c)
        assert(abs(r.rise_at(p) - (l.heights[c] - 3.0)) < 1.0e-3)
    }
    assert(r.wet(14) == 1.0 && r.wet(0) == 0.0)
    // A rise packs to within half a step, and no relief is no rise.
    assert(abs(r.rise(7) - (l.heights[7] - 3.0)) <= 0.5 / RISE_STEPS)
    let none: Relief<30> = Relief::none(g)
    assert(none.rise_at(g.centre(14)) == 0.0 && none.wet_at(g.centre(14)) == 0.0)
    // None of it holds on the outermost cells' middles or past them, all of it a collar in.
    assert(r.within(g.centre(0), 15.0) == 0.0)
    assert(r.within(vec2(-200.0, 0.0), 15.0) == 0.0)
    assert(r.within(g.centre(g.index(i: 2, j: 2)), 15.0) == 1.0)
}

@test
fn a_summary_counts_forms_slopes_and_pits() {
    // A cone: its sides are slopes, its top a ridge; no pits but the outlets on its border.
    let g = grid(nx: 21, nz: 21, cell: 10.0)
    let h: Vec<f32> = Vec::from_fn(g.cells(), |c| {
        let p = vec2(f32(c % 21), f32(c / 21)) - vec2(10.0)
        60.0 - 2.0 * length(p)
    })
    let outlets = border(g)
    let all: Vec<bool> = Vec::filled(g.cells(), value: true)
    let d = drainage(g, h, outlets)
    let down: Vec<u32> = Vec::from_fn(g.cells(), |c| if outlets[c] { NONE } else { d.down[c] })
    var area: Vec<f32> = Vec::filled(g.cells(), 0.0)
    gather(g, d.order, down, mut area)
    let s = summary(g, h, area, outlets, all, 1.0e9)
    assert(s.pits == 0 && s.density == 0.0)
    assert(s.high == 60.0)
    // The cone's sides are a slope of 0.2, between 5° and 15°.
    assert(s.slopes[1] > 0.8)
    var forms = 0.0
    for f in s.forms {
        forms += f
    }
    assert(abs(forms - 1.0) < 1.0e-5)
}
