// The frame: what a lit 3D program's frame is made of, in order, from the scene a game gives.
//
// A game keeps a `Frame` beside its scene (sibling fields of its state, so both can be `mut` at
// once) and each frame calls `begin` with where the camera is (`Aim`), then `draw` with its
// scene. The frame owns what every lit scene needs and its order: the targets and their sizes;
// the camera, jittered for temporal AA; the air's tables, the clouds, the static shadow cascades
// round the eye and the moving map, and the sky-light probes, each cooked a step a frame within
// one plan (`engine::cook`) and replaced only when what replaces it is whole; when the first full
// frame is shown, and an arrival after a jump; the passes, from the vegetation's depth prepass
// to the look's develop. The scene (`Scene`) says what it draws, casts and cooks.
//
//     begin   size, camera (and the render origin, `recentre`)
//     draw    the ground cooked (the scene's), the scene's load, the static cascades a strip,
//             the moving map, the sky a phase, the probes a strip; then the scene's passes:
//             choose, prepass, shade, ground, characters, sky, effects, motion; then the lines,
//             temporal AA, metering, the arrival's cover, the dabs, the glow, the develop, the
//             scene's overlay
//
// Every pipeline the frame itself draws with is one every lit program needs (the ground, the
// sky, the lines, the resolve, the meter, the dabs, the glow, the develop): what's optional (the
// water, a test's views; the air's fog is the frame's, `fog`) is drawn only from the scene's own methods, whose
// defaults draw nothing, so a program builds only the pipelines it reaches.

use air::{AIR_SLICES, Air, Tables, tables}
use ambient::Occlusion
use cascades::Cascades
use lights::{LocalLight, Lights}
use memory::{Share, Usage, unused}
use particles::{Emits, Particles, Step, composite, wind_of}
use reflect::{Mirror, Specular, copy_below}
use cook::{Budget, Planner, Work}
use distance::{Distance, Solids}
use fog::{FogField, FogVolume, sky_fogged}
use light::Light
use lit::Lighting
use paint::{
    BLOOM_LEVELS, Develop, Exposure, Look, Metering, bloom_down, bloom_up, dab_map, develop,
    identity, lines, meter,
}
use plant::Wind
use probes::{Baked, Occluder, ProbeGrid, STRIP_COLUMNS, Steer, Trace, band}
use shadow::{Cascade, Kept, Shadows, shadows}
use sheet::{Scale, pace}
use sky::{Clouds, MAP_BANDS, NOISE_SLICES, Sky, Weather, new_sky, sky_shade}
use switches::Switches
use style::Style
use temporal::{FoundRow, Resolve, found_rows, held, neighbourhoods, resolve, resolve_gathered}
use cull::{Hzb, Pyramid}
use terrain::{Clipmap, SIDES, Texel, ground, ground_shade}
use view::{BEHIND, Camera, NEAREST, camera, jitter_of}
use std::input::Key
use std::cache::Stale
use std::collections::{Flags, replace, swap}
use std::gpu::{
    Address, Blend, ClipPosition, ComparisonSampler, DepthTexture, FragmentShader, GpuBuffer,
    GpuSpan, Half2, R32Float, R32Uint, R8, RenderPass, Rgba16Float, Rgba8, Sampler, ScreenPass,
    Texture, Texture3d, VertexIndex, begin_depth_pass, begin_pass, begin_pass2_with_depth,
    begin_pass_with_depth, begin_screen_pass, buffer, buffer_of, comparison_sampler, depth_texture,
    dispatch, draw, draw_multi, label, memory, sampler, texture, timed, writable_texture, copy,
}
use std::io::{Pending, print}
use std::time::phase

/// A triangle that covers the target, at depth `z`.
@vertex
pub fn full(v: VertexIndex, z: f32) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, z, 1.0) }
}

/// Any fragment shader over the whole target (`full`'s triangle): a pass that draws each pixel
/// once.
pub fn fullscreen<P: RenderPass, F: FragmentShader<ClipPosition>>(pass: P, fs: F) {
    draw(pass, full.bind(z: 0.5), fs, vertices: 3)
}

// ---- What a game gives -------------------------------------------------------------------------

/// What a frame draws: implemented by the game's own scene type. The frame calls each method at
/// its stage, with the passes, the camera and the lighting bound; the defaults draw and cook
/// nothing.
pub trait Scene {
    /// The wind this frame, for the camera `cam` (its render origin keys the wind's waves to the
    /// world: `Camera::keyed`).
    fn wind(self, cam: Camera, time: f32) -> Wind

    /// The weather the clouds are cooked with.
    fn weather(self) -> Weather

    /// How the probes trace, lit by `light`, over `grid`.
    fn trace(self, light: Light, grid: ProbeGrid) -> Trace

    /// The probes' grid round `at` (render space, the render origin `origin` taken off).
    fn probe_grid(self, at: vec2, origin: vec3) -> ProbeGrid

    /// What occludes the probes round `at` (render space), or none while what stands there is
    /// still coming (an empty list is open land; none waits).
    fn occluders(self, at: vec2, origin: vec3) -> Option<Vec<Occluder>>

    /// The ground's height at a point of the world (x, z): where the near cascade follows the
    /// eye to.
    fn height_at(self, world: vec2) -> f32

    /// What's solid round the eye (render space, the render origin `origin` taken off), for the
    /// distance volume (`distance`): `None` if it hasn't changed since version `since` (its
    /// `Solids::version`), which the volume was last cooked from. None by default: the volume
    /// holds the ground alone.
    fn solids(self, origin: vec3, since: u32) -> Option<Solids> {
        None
    }

    /// What the air holds (render space, the render origin `origin` taken off): its fog, its
    /// mists and its canopy's haze (`fog::FogField`), the froxels' (`Switches::FOG`). None by
    /// default: clear air.
    fn fog(self, origin: vec3) -> Option<FogField> {
        None
    }

    /// The ground cooked into the clipmap round `eye` with whichever terrain the scene draws
    /// (`Clipmap::follow`; `again`: every level, the ground having changed). How many levels it
    /// cooked.
    fn cook_ground(mut self, clipmap: mut Clipmap, eye: vec3, again: bool) -> u32

    /// The scene's own load this frame: what it streams, cooks and realizes, each step asked of
    /// the plan (`c.planner.may`). It may write the ground's fields into `clipmap`.
    fn cook(mut self, c: mut Cooks, clipmap: mut Clipmap, linear: Sampler) {}

    /// Whether what a full frame round the eye needs (`eye`, the world's) has come in: its
    /// tiles placed, its built things realized.
    fn streamed(self, eye: vec2) -> bool {
        true
    }

    /// Whether the scene is still loading what's round the eye (a capture's probes wait for it).
    fn loading(self) -> bool {
        false
    }

    /// Whether every static caster is in (the first probes see the light an arrival reveals).
    fn casters_complete(self) -> bool {
        true
    }

    /// Whether a static cascade (the far one, `far`, or the near) may be drawn yet: its casters
    /// come at load, and a map drawn before them would be drawn whole again as each came.
    fn casters_ready(self, far: bool) -> bool {
        true
    }

    /// Whether the probes light the scene (a view of bare land, which they weren't baked over,
    /// is lit by the open sky).
    fn probes_lit(self) -> bool {
        true
    }

    /// Whether the ground itself casts into the static cascades (land with relief to shade).
    fn ground_casts(self) -> bool {
        false
    }

    /// The static casters of a cascade's strip (`lo` to `hi`, x and z) chosen, before its pass.
    fn choose_casters(mut self, cam: Camera, lo: vec2, hi: vec2) {}

    /// Static casters into a strip of a cascade seen from the sun by `view` (`first`: its first
    /// strip, which draws what casts once: solids). The wind is at rest: a map drawn over many
    /// frames can't follow it.
    fn cast<P: RenderPass>(
        self,
        pass: P,
        view: mat4,
        sh: Shadows,
        wind: Wind,
        s: Sampler,
        first: bool,
    ) {}

    /// What moves into the moving map, seen from the sun by `view`.
    fn cast_moving<P: RenderPass>(self, pass: P, view: mat4) {}

    /// The scene's local lights this frame (`lights`: at most `lights::MOST_LIGHTS` are used, and
    /// where more than `lights::PER_FROXEL` reach one place, the first of them): the lights that
    /// matter most first.
    fn lights(self) -> Vec<LocalLight> {
        Vec::new()
    }

    /// The particles the scene emits this frame (`particles`), into `e`.
    fn emit(mut self, e: mut Emits) {}

    /// Whether the scene draws veils (`veils`).
    fn has_veils(self) -> bool {
        false
    }

    /// The scene's veils, see-through matter, drawn into `pass` lit by `lt`: with `weighted`,
    /// into weighted blended transparency's two targets (`particles::weighted`, with `blends:
    /// [Blend::Add, Blend::Multiply]`, no depth written); without, into the scene, dithered by
    /// their coverage (temporal AA settles it), tagged `view::VEIL`.
    fn veils<P: RenderPass, Q: Switches, Y: Style>(
        self,
        pass: P,
        lt: Lighting<Q, Y>,
        weighted: bool,
    ) {}

    /// Whether anything casts into the moving map this frame (`cast_moving`): when nothing
    /// does, the frame keeps the map it cleared and draws no pass.
    fn casts_moving(self) -> bool {
        false
    }

    /// What the GPU chooses before any pass: grass placed round the eye, a wood's instances,
    /// lit by `lt`, on the clipmap's `texels`; what last frame's depth (`pyramid`, `hzb`) hid
    /// is left for `reveal`.
    fn choose<Q: Switches, Y: Style>(
        mut self,
        lt: Lighting<Q, Y>,
        texels: GpuSpan<Texel>,
        pyramid: Texture<R32Float>,
        hzb: Hzb,
    ) {}

    /// Whether the scene leaves what's hidden for `reveal` (the frame then builds its pyramid
    /// and draws the late passes).
    fn reveals(self) -> bool {
        false
    }

    /// After the opaque passes: what `choose` left out, tested against this frame's depth
    /// (`pyramid`, `hzb`), chosen for `late_prepass` and `late_shade`.
    fn reveal(mut self, pyramid: Texture<R32Float>, hzb: Hzb) {}

    /// The depth prepass of what `reveal` revealed (into the ids and the depth).
    fn late_prepass<P: RenderPass>(self, pass: P, cam: Camera, wind: Wind, s: Sampler) {}

    /// The shading of what `reveal` revealed, as `shade`'s.
    fn late_shade<P: RenderPass, Q: Switches, Y: Style>(
        self,
        pass: P,
        lt: Lighting<Q, Y>,
        wind: Wind,
        ids: Texture<R32Uint>,
    ) {}

    /// The depth prepass (into the ids and the depth): cut cards, grass.
    fn prepass<P: RenderPass>(self, pass: P, cam: Camera, wind: Wind, s: Sampler) {}

    /// After the prepass: what its depth puts out, and passes that keep it (far crowns).
    fn after_prepass(mut self, t: mut Targets, cam: Camera, wind: Wind, s: Sampler) {}

    /// The lit scene, before the ground: vegetation, stones, built things.
    fn shade<P: RenderPass, Q: Switches, Y: Style>(
        self,
        pass: P,
        lt: Lighting<Q, Y>,
        wind: Wind,
        ids: Texture<R32Uint>,
    ) {}

    /// The characters, after the ground (their pass joins it).
    fn characters<P: RenderPass, Q: Switches, Y: Style>(self, pass: P, lt: Lighting<Q, Y>) {}

    /// Something in place of the sky (a test's key colour): whether it drew it.
    fn sky_instead<P: RenderPass>(self, pass: P) -> bool {
        false
    }

    /// Whether the scene draws effects over the lit scene (`effects`), which take targets of
    /// their own (the scene under water).
    fn has_effects(self) -> bool {
        false
    }

    /// What goes over the lit scene before motion and temporal AA: water over a copy of the
    /// scene, veils, drawn into `t` with what the frame holds (`fx`).
    fn effects<Q: Switches, Y: Style>(mut self, t: mut Targets, fx: Effects<Q, Y>) {}

    /// What moved since the last frame, into the motion target (over the scene's depth).
    fn motion<P: RenderPass>(mut self, pass: P, cam: Camera, wind: Wind) {}

    /// Where on the output (`out` pixels) anything that moves can be, now or last frame: a
    /// rectangle (temporal AA checks last frame's motion there). The whole output by default.
    fn moves_in(self, cam: Camera, out: vec2) -> vec4 {
        vec4(0.0, 0.0, out)
    }

    /// Whether the frame is shown another way than the look (a test's view), by `show_instead`.
    fn shows_instead(self) -> bool {
        false
    }

    /// The frame shown another way than the look, into the screen's pass.
    fn show_instead(self, pass: ScreenPass, t: Targets, exposure: GpuSpan<Exposure>) {}

    /// What the game draws over the developed frame (a map), `out` pixels.
    fn overlay(self, pass: ScreenPass, out: vec2) {}

    /// The scene's targets are `w` × `h` now (the output's at the render scale).
    fn resized(mut self, w: u32, h: u32) {}

    /// The render origin moved: what the scene keeps in render space moves by `d` with it.
    fn shift(mut self, d: vec3) {}

    /// What the scene's own subsystems hold on the GPU, each against its budget
    /// (`engine::memory`: the wood's lists, a realizer's meshes), for the frame's `usage`.
    fn shares(self) -> Vec<Share> {
        Vec::new()
    }

    /// The program's GPU memory, as the frame read it (`Frame::usage`): what's over its budget
    /// says what the scene trims (`memory::shrink_after`, `memory::evict_after`).
    fn pressed(mut self, usage: Usage) {}
}

/// Where the camera is this frame: its eye and what it looks at (render space), its field of
/// view (radians), the render origin (the world point render space's origin stands for: whole
/// tiles), and where the moving map goes round (what moves: the player's feet).
pub struct Aim: Copy {
    pub eye: vec3,
    pub at: vec3,
    pub fovy: f32,
    pub moving_at: vec3,
}

/// The frame's targets. The scene's (`w` × `h`: the output's at the render scale): its colour
/// and tags, a second it ping-pongs with (the lines, the water), its depth and the last frame's,
/// the far crowns' ids, motion and the last frame's, the scene under the water (when the scene has
/// effects) and then the dabs in the same texture (`below`: the water reads it before the look
/// writes the dabs into it); the output's: temporal AA's history and the last frame's; a quarter
/// of the output's: the glow's chain.
///
/// At 1080p (the scene at 0.667: 1280 × 720) each scene-sized half-float target is 7.0 MiB, the
/// depths and the ids 3.5 MiB each, each history 15.8 MiB, the glow's chain 5.3 MiB in all: 82
/// MiB, where the dabs' own texture was 7.0 MiB more (the audit's §3.4) and the shafts' 1.8 (B10:
/// the air's froxels hold them).
pub struct Targets {
    pub scene: Texture<Rgba16Float>,
    pub scene_b: Texture<Rgba16Float>,
    pub depth: DepthTexture,
    pub last_depth: DepthTexture,
    pub ids: Texture<R32Uint>,
    pub motion: Texture<Rgba16Float>,
    pub last_motion: Texture<Rgba16Float>,
    pub below: Texture<Rgba16Float>,
    pub history: Texture<Rgba16Float>,
    pub last_history: Texture<Rgba16Float>,
    /// The bloom's pyramid (`paint::BLOOM_LEVELS`): half the output's size, then each level half
    /// the last.
    pub bloom_1: Texture<Rgba16Float>,
    pub bloom_2: Texture<Rgba16Float>,
    pub bloom_3: Texture<Rgba16Float>,
    pub bloom_4: Texture<Rgba16Float>,
}

/// Targets of a texel each, before the first frame sizes them.
fn no_targets() -> Targets {
    Targets {
        scene: texture::<Rgba16Float>(width: 1, height: 1),
        scene_b: texture::<Rgba16Float>(width: 1, height: 1),
        depth: depth_texture(width: 1, height: 1),
        last_depth: depth_texture(width: 1, height: 1),
        ids: texture::<R32Uint>(width: 1, height: 1),
        motion: texture::<Rgba16Float>(width: 1, height: 1),
        last_motion: texture::<Rgba16Float>(width: 1, height: 1),
        below: texture::<Rgba16Float>(width: 1, height: 1),
        history: texture::<Rgba16Float>(width: 1, height: 1),
        last_history: texture::<Rgba16Float>(width: 1, height: 1),
        bloom_1: texture::<Rgba16Float>(width: 1, height: 1),
        bloom_2: texture::<Rgba16Float>(width: 1, height: 1),
        bloom_3: texture::<Rgba16Float>(width: 1, height: 1),
        bloom_4: texture::<Rgba16Float>(width: 1, height: 1),
    }
}

/// Targets for an output of `width` × `height`, the scene's `w` × `h` (`effects`: whether the
/// scene draws over itself, whose targets every frame has now: the dabs share the water's).
fn targets_for(width: u32, height: u32, w: u32, h: u32, effects: bool) -> Targets {
    Targets {
        scene: texture::<Rgba16Float>(width: w, height: h),
        scene_b: texture::<Rgba16Float>(width: w, height: h),
        depth: depth_texture(width: w, height: h),
        last_depth: depth_texture(width: w, height: h),
        ids: texture::<R32Uint>(width: w, height: h),
        motion: texture::<Rgba16Float>(width: w, height: h),
        last_motion: texture::<Rgba16Float>(width: w, height: h),
        below: texture::<Rgba16Float>(width: w, height: h),
        history: texture::<Rgba16Float>(width: width, height: height),
        last_history: texture::<Rgba16Float>(width: width, height: height),
        bloom_1: bloom_of(width, height, level: 1),
        bloom_2: bloom_of(width, height, level: 2),
        bloom_3: bloom_of(width, height, level: 3),
        bloom_4: bloom_of(width, height, level: 4),
    }
}

impl Targets {
    /// The GPU bytes its textures take: half floats but the depths and the ids (32 bits).
    pub fn bytes(self) -> u64 {
        let h = |t: Texture<Rgba16Float>| memory::texels(t.width(), t.height(), 8)
        let n = h(self.scene) +
            h(self.scene_b) +
            h(self.motion) +
            h(self.last_motion) +
            h(self.below) +
            h(self.history) +
            h(self.last_history) +
            h(self.bloom_1) +
            h(self.bloom_2) +
            h(self.bloom_3) +
            h(self.bloom_4)
        n + memory::texels(self.depth.width(), self.depth.height(), 4) * 3
    }
}

/// The bloom's level `level` for an output `width` × `height`: `2^level` times smaller.
fn bloom_of(width: u32, height: u32, level: u32) -> Texture<Rgba16Float> {
    texture::<Rgba16Float>(width: max(width >> level, 1), height: max(height >> level, 1))
}

/// The narrowest a bloom level is drawn (texels).
const BLOOM_NARROWEST: u32 = 64

/// How many of the bloom's levels an output `width` wide draws: those at least
/// `BLOOM_NARROWEST` wide, and the first whatever its width.
fn bloom_levels(width: u32) -> u32 {
    var n = 1
    while n < BLOOM_LEVELS && (width >> (n + 1)) >= BLOOM_NARROWEST {
        n += 1
    }
    n
}

/// A level of the bloom drawn from the one above it (`from`; the first from the output, its
/// light above the threshold: `paint::bloom_down`).
fn bloom_level(
    into: mut Texture<Rgba16Float>,
    from: Texture<Rgba16Float>,
    s: Sampler,
    first: bool,
    base: f32,
    exposure: GpuSpan<Exposure>,
) {
    let p = begin_pass(mut into)
    fullscreen(
        p,
        bloom_down.bind(
            from,
            s,
            first: if first { 1 } else { 0 },
            threshold: 1.1,
            base: base,
            exposure: exposure,
        ),
    )
    p.end()
}

/// The level under `into` (`from`) brought up and added to it (`paint::bloom_up`).
fn bloom_add(into: mut Texture<Rgba16Float>, from: Texture<Rgba16Float>, s: Sampler) {
    let p = begin_pass(mut into, keep: true)
    draw(p, full.bind(z: 0.5), bloom_up.bind(from, s), vertices: 3, blend: Blend::Add)
    p.end()
}

/// What an effect reads from the frame: everything a shading pass reads (`lt`), the air's sky
/// table and the clouds' dome (what water reflects), the sun's shadows, the wind and the time.
pub borrow struct Effects<Q: Switches, Y: Style> {
    pub lt: Lighting<Q, Y>,
    pub view: borrow Texture<Rgba16Float>,
    pub dome: borrow Texture<Rgba16Float>,
    pub sh: Shadows,
    pub wind: Wind,
    pub time: f32,
}

/// What a scene's load is given (`Scene::cook`): the plan to ask before each step, whether a
/// capture fills its caches and whether an arrival is covered (what comes in under the cover is
/// whole at once), whether the frame has been playable, the frame's length (s, at most 0.1), the
/// eye (the world's, x and z), the render origin and the frame's number. The scene sets
/// `near_changed` or `far_changed` when what casts into a static cascade changed.
pub struct Cooks {
    pub planner: Planner,
    pub capture: bool,
    pub arriving: bool,
    pub playable: bool = false,
    pub dt: f32,
    pub eye: vec2,
    pub origin: vec3,
    pub frames: u32,
    pub near_changed: bool,
    pub far_changed: bool,
}

// ---- Temporal AA's resolve -------------------------------------------------------------------

/// How temporal AA brings the scene up to the output: a type, so a program holds one resolve's
/// pipelines.
pub trait Resolver {
    fn made() -> Self

    /// Whether it brings a scene of another size up to the output's (`Quality::scale`), or draws
    /// the scene at the output's size.
    fn scaled() -> bool {
        true
    }

    /// The scene is `w` × `h` now.
    fn resize(mut self, w: u32, h: u32)

    /// The history `into` resolved from the last (`t.last_history`) with this frame's scene, the
    /// learned rejector's where the program's switches `Q` have it.
    fn resolve<Q: Switches>(
        mut self,
        into: mut Texture<Rgba16Float>,
        r: Resolve,
        scene: Texture<Rgba16Float>,
        depth: DepthTexture,
        last_depth: DepthTexture,
        motion: Texture<Rgba16Float>,
        last_motion: Texture<Rgba16Float>,
        last_history: Texture<Rgba16Float>,
        s: Sampler,
        net: GpuSpan<Half2>,
    )
}

/// The scene drawn at the output's size: each output pixel gathers its own sample's
/// neighbourhood (`temporal::resolve_gathered`). A frame with it keeps the render scale at 1.
pub struct Gathered {}

impl Resolver for Gathered {
    fn made() -> Gathered {
        Gathered {}
    }

    fn scaled() -> bool {
        false
    }

    fn resize(mut self, w: u32, h: u32) {}

    fn resolve<Q: Switches>(
        mut self,
        into: mut Texture<Rgba16Float>,
        r: Resolve,
        scene: Texture<Rgba16Float>,
        depth: DepthTexture,
        last_depth: DepthTexture,
        motion: Texture<Rgba16Float>,
        last_motion: Texture<Rgba16Float>,
        last_history: Texture<Rgba16Float>,
        s: Sampler,
        net: GpuSpan<Half2>,
    ) {
        let p = begin_pass(mut into)
        draw(
            p,
            full.bind(z: 0.5),
            resolve_gathered.bind(
                r,
                scene,
                depth,
                last_depth,
                motion,
                last_motion,
                last_history,
                s,
                net,
                learned: Q::LEARNED,
            ),
            vertices: 3,
        )
        p.end()
    }
}

/// The scene drawn at any scale: each scene pixel's neighbourhood found once
/// (`temporal::neighbourhoods`), and the output's pixels read their nearest's.
pub struct Shared {
    means: Texture<Rgba16Float>,
    spreads: Texture<Rgba16Float>,
}

impl Resolver for Shared {
    fn made() -> Shared {
        Shared {
            means: writable_texture::<Rgba16Float>(width: 1, height: 1),
            spreads: writable_texture::<Rgba16Float>(width: 1, height: 1),
        }
    }

    fn resize(mut self, w: u32, h: u32) {
        self.means = writable_texture::<Rgba16Float>(width: w, height: h)
        self.spreads = writable_texture::<Rgba16Float>(width: w, height: h)
    }

    fn resolve<Q: Switches>(
        mut self,
        into: mut Texture<Rgba16Float>,
        r: Resolve,
        scene: Texture<Rgba16Float>,
        depth: DepthTexture,
        last_depth: DepthTexture,
        motion: Texture<Rgba16Float>,
        last_motion: Texture<Rgba16Float>,
        last_history: Texture<Rgba16Float>,
        s: Sampler,
        net: GpuSpan<Half2>,
    ) {
        dispatch(neighbourhoods.bind(scene, mut self.means, mut self.spreads), over: scene)
        let p = begin_pass(mut into)
        draw(
            p,
            full.bind(z: 0.5),
            resolve.bind(
                r,
                scene,
                depth,
                last_depth,
                motion,
                last_motion,
                last_history,
                self.means,
                self.spreads,
                s,
                net,
                learned: Q::LEARNED,
            ),
            vertices: 3,
        )
        p.end()
    }
}

// ---- Quality ---------------------------------------------------------------------------------

/// What a game may tune, once, given to `frame` and changed only through `Frame::requality`. The
/// defaults are the Last Green's approved values, where they aren't the floor's own (its far
/// cascade's place).
pub struct Quality: Copy {
    /// The scene's size over the output's (temporal AA brings it up: temporal super-resolution).
    /// `Gathered` draws at 1 whatever this says (`Resolver::scaled`).
    pub scale: f32 = 0.667,
    /// Whether the scale is paced by the frames as well (`sheet::pace`: smaller while frames come
    /// late, back up once they don't, down to `LEAST_SCALE` of the output): the valve when the
    /// frame's work doesn't fit the display's interval. Needs `Shared`.
    pub pace: bool = true,
    pub shadows: ShadowQuality = ShadowQuality {},
    pub probes: ProbeQuality = ProbeQuality {},
    /// The radiance cascades' numbers (B14.4, `cascades`), where the program's switches have
    /// them (`switches::Switches::CASCADES`).
    pub cascades: CascadeQuality = CascadeQuality {},
    pub arrival: Arrival = Arrival {},
    /// How much of this frame a pixel takes where a sample falls on it (temporal AA).
    pub blend: f32 = 0.12,
    pub budget: Budget = Budget {},
    /// Whether the planner learns this device's costs (the default): at a frame's start the frame
    /// asks for the GPU time of each kind it plans that's due (`std::gpu::timed`), which the host
    /// then times in the first frame that runs one of its steps (a frame runs one of each but
    /// while a capture fills its caches), and the planner plans with it from then on
    /// (`Planner::measure`, on its ladder of steps). A kind is due until it's been measured
    /// `MEASURE_FIRST` times, then every `MEASURE_AGAIN` frames: a host times only the work asked
    /// for, so a frame that times nothing costs nothing more. Off, it plans with the code's
    /// estimates and records, and a frame's order is the same on every run, as the tests of order
    /// need.
    pub measured: bool = true,
    /// The GPU memory the program keeps to (`engine::memory::TOTAL`, **proposed**: a tab's 1.5 GB
    /// less the WASM heap and the page), read every `MEMORY_EVERY` frames (`Frame::usage`).
    pub memory: u64 = memory::TOTAL,
    /// How veils are drawn (`Scene::veils`): blended in any order (weighted blended
    /// transparency), or dithered by their coverage.
    pub transparency: Transparency = Transparency::Weighted,
}

impl Quality {
    /// The lookdev instrument's reference (docs/lookdev.md, F12): every knob at its most. The
    /// scene at the output's size, unpaced, the planner with the code's estimates; the cascades
    /// at 4096² (their finest before shadow pages), drawn whole each frame; probes of 128 rays.
    /// With temporal AA's history off and the jitter on an 8 × 8 grid, a mean of 64 frames of it
    /// is a 64-sample supersample.
    pub fn reference() -> Quality {
        let q = Quality {}
        Quality {
            scale: 1.0,
            pace: false,
            measured: false,
            shadows: ShadowQuality {
                near: Cascade { side: 4096, ..q.shadows.near },
                far: Cascade { side: 4096, ..q.shadows.far },
                near_strips: 1,
                far_strips: 1,
                ..q.shadows,
            },
            probes: ProbeQuality { rays: 128, ..q.probes },
            ..q,
        }
    }
}

/// How see-through matter is drawn (`Quality::transparency`).
pub enum Transparency: Copy + Eq + Fieldless {
    Dithered,
    Weighted,
}

/// What see-through matter is drawn into before it's laid over the scene (`particles::composite`):
/// the veils' weighted colours and what they leave showing, and the particles, premultiplied (at
/// half the scene's size); and
/// whether the veils' two hold nothing (cleared, and none drawn since).
pub struct SeeThrough {
    pub accum: Texture<Rgba16Float>,
    pub reveal: Texture<R8>,
    pub parts: Texture<Rgba16Float>,
    pub empty: bool,
}

impl SeeThrough {
    /// Its targets for a scene `w` × `h`.
    fn new(w: u32, h: u32) -> SeeThrough {
        SeeThrough {
            accum: texture::<Rgba16Float>(width: w, height: h),
            reveal: texture::<R8>(width: w, height: h),
            parts: texture::<Rgba16Float>(width: max(w / 2, 1), height: max(h / 2, 1)),
            empty: false,
        }
    }

    /// The GPU bytes its targets take.
    fn bytes(self) -> u64 {
        memory::texels(self.accum.width(), self.accum.height(), 8) +
            memory::texels(self.reveal.width(), self.reveal.height(), 1) +
            memory::texels(self.parts.width(), self.parts.height(), 8)
    }
}

/// The least scene a paced 3D frame draws, over the output's size (`Quality::pace`): below it a
/// field's detail and the resolve's reconstruction give out.
pub const LEAST_SCALE: f32 = 0.5

/// While the sun moves, every this many frames draws no strip of the cascades, so the probes
/// (which a frame that draws one doesn't bake) keep their turns (`Frame::static_strips`).
const PROBE_TURN: u32 = 4

/// How often the frame reads the program's GPU memory against its budget (`Frame::usage`).
const MEMORY_EVERY: u32 = 30

/// A measuring frame's pace (`Quality::measured`): each kind is measured this many times as soon
/// as it runs, then once every this many frames (4 s at 60 Hz).
const MEASURE_FIRST: u32 = 4

const MEASURE_AGAIN: u32 = 240

/// The phases of a frame's CPU time it names (`std::time::phase`), in order: the cooking and
/// the planner (`draw`'s start), the scene's choosing, recording the passes, the finish (temporal
/// AA to the bloom), and the present (the develop). A game's `frame` adds `sim`, round its read
/// of the latest snapshot.
pub const PHASES: [Text; 5] = ["cook", "choose", "passes", "finish", "present"]

/// The most a frame spends on the clouds' noise and weather slices, loading or not (µs,
/// planned): the first slice runs whatever it costs.
const SKY_FRAME_US: f32 = 4000.0

/// Whether the probes in use are traced again where things changed first (B9c), or each strip
/// in turn.
const STEERED: bool = true

/// How many kinds of work a measuring frame times (`MEASURED`).
const MEASURED_KINDS: u32 = 14

/// The kinds of work a measuring frame times (`Quality::measured`), each by the label its pass or
/// dispatch carries: a frame may run several steps of a kind, so the time is divided by the steps
/// the frame it timed ran (`Frame::measure`). (A creature's mesh is timed by none yet: it's
/// labelled with the work round it.)
const MEASURED: [(Work, Text); MEASURED_KINDS] = [
    (Work::SkyPhase, "clouds"),
    (Work::NearStrip, "shadows near"),
    (Work::FarStrip, "shadows far"),
    (Work::ProbeOccluders, "probes occluders"),
    (Work::ProbeStrip, "probes bake"),
    (Work::AirTables, "air"),
    (Work::SkyNoise, "clouds noise"),
    (Work::SkyWeather, "clouds weather"),
    (Work::Kind, "kind"),
    (Work::Built, "built things"),
    (Work::TerrainLevel, "terrain cook"),
    (Work::Tile, "tile"),
    (Work::Distance, "distance"),
    (Work::ProbeAgain, "probes again"),
]

/// The static cascades: the near one (its square's `centre` is where it starts, and where it
/// stays if it doesn't follow the eye), in how many strips it's drawn, and how far the eye goes
/// from its middle before it's drawn again round it (at least 1e8: it stays); the far one (its
/// middle stays in the world) and its strips; how far past a cascade's square a tree's shadow can
/// reach into it (m: a 25 m tree's at a sun 24° up is 56 m long); and the moving map, its texels a
/// side and how wide it is round what moves (m).
pub struct ShadowQuality: Copy {
    pub near: Cascade = Cascade { centre: vec3(0.0), span: 144.0, reach: 250.0, side: 2048 },
    pub near_strips: u32 = 12,
    pub near_moves: f32 = 40.0,
    pub far: Cascade = Cascade { centre: vec3(0.0), span: 2400.0, reach: 2600.0, side: 2048 },
    pub far_strips: u32 = 48,
    pub reach_in: f32 = 60.0,
    pub moving_side: u32 = 1024,
    pub moving_span: f32 = 6.0,
}

/// The probes: how far the eye goes from their middle before the next are baked round it (m);
/// the rays a probe is first baked with (of `probes::RAYS`); and whether, once baked, a strip is
/// traced again each frame through the volume, lit by the sun and sky as they are, blended into
/// what it held (`probes::AGAIN_COLUMNS`, `AGAIN_KEEP`: DDGI's update, Majercik et al. 2019), so
/// the bounce light follows the clouds and the sun, and a change of the sky or the sun is traced
/// into the probes in use rather than baked into new ones (only the eye moving on and what
/// occludes them changing bake new ones).
pub struct ProbeQuality: Copy {
    pub moves: f32 = 30.0,
    pub rays: u32 = 32,
    pub again: bool = true,
}

/// The radiance cascades (§B14.4, `cascades`), where they light the sky's term in place of the
/// probes' and the ambient occlusion (built from the frame's depth, read by the next frame's
/// shading, as the occlusion is): c0's probes' spacing (scene pixels) and each ray's steps (the
/// experiment's rungs: 8 and 16, 16 and 16, 16 and 8).
pub struct CascadeQuality: Copy {
    pub spacing: u32 = 8,
    pub steps: u32 = 16,
}

/// An arrival: whether the frames stay covered until the light round the eye is drawn (at the
/// start, and after a jump), how far the eye moves in a frame for a jump (m), and for how many
/// frames under that light temporal AA gathers before the cover goes (a still's: `still_frames`).
pub struct Arrival: Copy {
    pub on: bool = true,
    pub jump: f32 = 30.0,
    pub gather: u32 = 12,
    pub still_frames: u32 = 16,
}

/// The systems a frame can leave out (a test's or a key's): the static shadows' casters, the
/// ground, temporal AA's history (each frame its own), the clouds' shadows.
pub enum Off: Copy + Eq + Fieldless {
    Shadows,
    Terrain,
    History,
    CloudShadows,
}

/// How a frame is drawn for looking at it, not for play: systems left out; the develop's view
/// (0 the look, 1 clay, 2 silhouettes: `paint::Develop`); plain rendering (the scene at the
/// output's size, no jitter, history or look: the flicker test's reference); stills (each
/// frame's jitter on a still's grid, and a capture fills its caches at once); and the wind
/// still (the clouds' march keeps its jitter, the probes keep what they baked).
pub struct Debug: Copy {
    pub off: Flags<Off>,
    pub view: u32 = 0,
    pub plain: bool = false,
    pub capture: bool = false,
    pub still: bool = false,
    /// Time frozen at this frame time (F10): the wind, the clouds' drift, the water's and the
    /// particles hold, so only what the renderer does moves a pixel (the lookdev instrument).
    pub frozen: Option<f32> = None,
    /// The eye held at this aim (F11), whatever the game aims at; with `dolly` (F11 again), moved
    /// along its look at `DOLLY` m a frame while no reference, arrival or pause (`paused`, the
    /// backquote) holds it.
    pub held: Option<Aim> = None,
    pub dolly: bool = false,
    pub paused: bool = false,
    /// The ghost control's history, unclipped (`Frame::ghost`).
    pub ghost: bool = false,
    /// The reference (F12): the quality and the history it replaced, to put back; and whether
    /// the first frame round the eye since F12 last toggled it is still to be said (`REFERENCE`,
    /// `PLAY`).
    pub reference: Option<(Quality, bool)> = None,
    pub unsaid: bool = false,
}

/// How far a dolly (F11's second press) moves the held eye each frame: 0.5 m/s at 60 frames a
/// second, the frame's time frozen or not.
pub const DOLLY: f32 = 0.5 / 60.0

/// What the frame prints when a reference's first frame is drawn round the eye (F12), and when
/// play's is once F12 puts it back: the lookdev instrument then takes its frames (`wrela tool
/// lookbook --quality`).
pub const REFERENCE: Text = "reference at frame"
pub const PLAY: Text = "play at frame"

// ---- Readiness ---------------------------------------------------------------------------------

/// When frames are shown. `playable`: a full frame round the eye (the near cascade drawn, the
/// probes in use baked whole, the scene streamed round the eye: `Scene::streamed`). `arriving`:
/// since the frame began or the eye jumped (`Arrival`), frames are covered (black) until the
/// light round the eye is drawn (`lit`), then for `gathered` consecutive lit frames (reset by any
/// frame that isn't: no timeout), and temporal AA's history starts afresh on the first. A held
/// shot's clock waits while it's covered.
pub struct Readiness: Copy {
    pub playable: bool,
    pub arriving: bool,
    pub gathered: u32,
    pub playable_at: Option<u32>,
}

/// Arrival's count of consecutive lit frames: a frame that isn't lit starts it again.
pub fn arrival_gathered(previous: u32, lit: bool) -> u32 {
    if lit { previous + 1 } else { 0 }
}

/// Whether probes baked from `a` hold what `b` asks for: the same inputs, or with the probes traced
/// again (`again`, which brings in a new sky and sun), the same occluders and ground.
fn same_inputs(a: ProbeKey, b: ProbeKey, again: bool) -> bool {
    if again { a.0 == b.0 } else { a == b }
}

/// Whether a probe step of `w` may run now (`Planner::may`); a step the rules allow and the
/// budget refuses is noted in `waited`, so the next frame's dome gives way to it.
fn probe_step(planner: mut Planner, waited: mut bool, w: Work) -> bool {
    let allowed = planner.would(w)
    let ran = planner.may(w)
    waited = allowed && !ran
    ran
}

/// Whether two shadow qualities make the same cascades and the same moving map (what `requality`
/// keeps).
fn same_shadows(a: ShadowQuality, b: ShadowQuality) -> bool {
    let same = |x: Cascade, y: Cascade| {
        x.centre == y.centre && x.span == y.span && x.reach == y.reach && x.side == y.side
    }
    same(a.near, b.near) &&
        same(a.far, b.far) &&
        a.near_strips == b.near_strips &&
        a.far_strips == b.far_strips &&
        a.near_moves == b.near_moves &&
        a.reach_in == b.reach_in &&
        a.moving_side == b.moving_side &&
        a.moving_span == b.moving_span
}

/// Each setting of the cascades and the moving map tells two shadow qualities apart.
@test
fn every_shadow_setting_tells_qualities_apart() {
    let a = ShadowQuality {}
    assert(same_shadows(a, a))
    let c = Cascade { centre: vec3(1.0, 0.0, 0.0), span: 144.0, reach: 250.0, side: 2048 }
    for b in [
        ShadowQuality { near: c },
        ShadowQuality { far: Cascade { side: 1024, ..a.far } },
        ShadowQuality { near_strips: 6 },
        ShadowQuality { far_strips: 24 },
        ShadowQuality { near_moves: 20.0 },
        ShadowQuality { reach_in: 30.0 },
        ShadowQuality { moving_side: 512 },
        ShadowQuality { moving_span: 3.0 },
    ] {
        assert(!same_shadows(a, b), "a changed setting kept the old cascades")
    }
}

// ---- The probes ------------------------------------------------------------------------------

/// The probes in use (`using`) round `at` (render space), and the next being baked beside them
/// round `next_at` (once the eye has moved `ProbeQuality::moves`, or what they're baked from
/// changed: the sun, its light, what occludes them, the ground), which take over when they're
/// baked. Each remembers what it was started from: a replacement started from older inputs is
/// dropped.
pub struct Probes {
    pub using: Baked,
    pub at: vec2,
    pub next: Option<Baked>,
    pub next_at: vec2,
    next_cooked: bool,
    /// The probes last replaced, whose buffers the next replacement of their shape takes
    /// (`Baked::renew`).
    spare: Option<Baked>,
    /// Whether the probes in use have their occluders (the first bake begins with them).
    pub cooked: bool,
    using_k: ProbeKey,
    next_k: ProbeKey,
}

/// What probes are baked from: the version of what occludes them and of the ground
/// (`Frame::changed`), the version of the sky they bake the light of (the air's tables and the
/// clouds' weather, counted as each is cooked again), and the sun's direction and light.
type ProbeKey = (u32, u32, vec3, vec3)

impl Probes {
    /// Whether the probes in use are baked whole.
    pub fn done(self) -> bool {
        self.using.done()
    }
}

// ---- The frame -------------------------------------------------------------------------------

/// A lit 3D program's frame (the module's comment): its quality, its debug state, the camera,
/// the light and the air, the air's tables, the clouds, the static cascades and the moving map,
/// the probes, the ground's clipmap, the targets, temporal AA's resolve, the metered exposure,
/// the samplers, the plan, readiness, and what it was last cooked from.
pub struct Frame<R: Resolver, Q: Switches, Y: Style> {
    quality: Quality,
    pub debug: Debug,
    pub look: Look,
    pub metering: Metering,
    pub cam: Camera,
    pub light: Light,
    pub air: Air,
    pub tables: Tables,
    /// The tables being cooked a slice a frame (`air::AIR_SLICES`): they swap in for `tables`
    /// once whole. And the air and the light the sky cooks for (its tables, its clouds' weather
    /// and dome, the probes' open sky and what they're baked from): the frame's own, but held
    /// through a cook under way and while probes wait for the sky they bake (`follow_light`).
    next_tables: Tables,
    air_slice: Option<u32>,
    sky_key: (Air, vec3, vec3),
    pub sky: Sky,
    pub clouds: Clouds,
    pub near: Kept,
    pub far: Kept,
    pub moving: DepthTexture,
    /// Whether the moving map is clear (the last frame drew nothing into it).
    moving_clear: bool,
    pub cmp: ComparisonSampler,
    pub probes: Probes,
    /// The solids' distance volume round the eye (`Switches::DISTANCE`).
    pub distance: Distance,
    /// The air's froxels (`Switches::FOG`).
    pub fog: FogVolume,
    /// Whether the screen has been asked to be HDR (`Look::output`).
    asked_hdr: bool = false,
    pub clipmap: Clipmap,
    pub targets: Targets,
    /// The depth pyramid (`cull`): this frame's, built after its opaque passes, which the next
    /// frame's choosing reads.
    pub pyramid: Pyramid,
    /// The ambient occlusion (`ambient`): the last frame's, which this frame's shading reads, and
    /// this frame's, built after its opaque passes.
    pub ambient: Occlusion,
    /// The radiance cascades (`Switches::CASCADES`), which build into the occlusion's texture.
    cascades: Option<Cascades>,
    /// The learned rejector's net (`Switches::LEARNED`, `reject_by`: none until given),
    /// and the output pixels whose resolve is asked for (`ask_found`) with where it goes.
    rejector: GpuBuffer<Half2>,
    rejects: bool,
    found: Option<(GpuBuffer<vec2u>, GpuBuffer<FoundRow>)>,
    /// The scene's local lights, binned into the frame's froxels (`lights`).
    pub lights: Lights,
    /// What glossy surfaces reflect (`reflect`): the last frame's scene and distances (its
    /// colour and each pixel's distance, copied after its effects) as `mirror`'s camera drew
    /// them, and the specular probe, a face baked a frame.
    pub screen: Texture<Rgba16Float>,
    pub mirror: Mirror,
    pub specular: Specular,
    /// The look's grading table (`paint::graded`, as much as `Look::grade` says): the identity
    /// until a game gives one (`grade_with`).
    pub grade: Texture3d<Rgba8>,
    /// The particles (`particles`), made when the scene first emits one; the frame's emitted;
    /// and what see-through matter is drawn into, made when there's some to draw.
    pub particles: Option<Particles>,
    emits: Emits,
    see_through: Option<SeeThrough>,
    /// How far the render space moved since the particles' last step (`recentre`).
    particle_shift: vec3,
    /// The program's GPU memory against its budget, last read (`MEMORY_EVERY`), and whether
    /// it's been said to be over.
    pub usage: Usage,
    said_over: bool,
    resolver: R,
    pub exposure: GpuBuffer<Exposure>,
    pub linear: Sampler,
    pub repeat: Sampler,
    pub cooks: Cooks,
    /// The kinds whose GPU time a measuring frame asked for and hasn't had (`Quality::measured`),
    /// each by its place in `MEASURED`; how many times each of `MEASURED` was measured and the
    /// frame it last was (`ran`'s count, which a resize doesn't start again); and whether the host
    /// can't time them (it stops asking).
    measuring: Vec<(u32, Pending<f32>, u32)>,
    measured: [u32; MEASURED_KINDS],
    measured_at: [u32; MEASURED_KINDS],
    untimed: bool,
    /// The paced scale (`Quality::pace`).
    pub pacer: Scale,
    pub ready: Readiness,
    /// Frames drawn since the last resize, and frames run (a held screen runs frames it doesn't
    /// draw).
    pub frames: u32,
    pub ran: u32,
    /// Frames the camera has held still (`temporal::held`).
    settled: u32,
    /// The last aim `begin` was given: what F11 holds.
    aimed: Aim,
    width: u32,
    height: u32,
    /// The render origin (the world point, whole tiles, y 0).
    pub origin: vec3,
    /// Where the eye was last frame (the world's), whether it jumped this frame, the frame's
    /// time and the last.
    last_eye: vec2,
    pub jumped: bool,
    time: f32,
    last_time: Option<f32>,
    /// Whether a build that took over from another (hot reload) holds the screen it left: frames
    /// cook, and present nothing.
    pub hold: bool,
    /// What's cooked from what: the air's tables and the probes' open sky (the air, the sun and
    /// its light), the clouds' noise, their
    /// weather (the sun, the weather's version), their shadow (whether it's on, the weather's
    /// version), the static casters (the sun, whether they're on), and the versions of what
    /// changed (`changed`).
    air_cooked: Stale<(Air, vec3, vec3)>,
    noise_cooked: bool,
    /// The noises' slices cooked (`sky::NOISE_SLICES`), and the weather cook under way: its
    /// step (`sky::MAP_BANDS` bands of the weather map, then as many of the shadow map), what
    /// it's for, and the weather it cooks.
    noise_slices: u32,
    weather_cooking: Option<(u32, (vec3, u32), bool, Weather)>,
    weather_cooked: Stale<(vec3, u32)>,
    cloud_shadow: Stale<(bool, u32)>,
    casting: Stale<(vec3, bool)>,
    cloud_wind: vec2,
    ground_again: bool,
    weather_v: u32,
    probes_v: u32,
    /// Each cook of the air's tables or the clouds' weather: the sky the probes bake (`ProbeKey`).
    sky_v: u32,
    /// Whether the last frame's probe step was eligible and the budget refused it (`cook_sky`
    /// gives way to it).
    probes_waited: bool,
    /// The sky's cook this frame's plan counted before its optional steps (`sky_cook`).
    sky_noted: Option<Work>,
    /// The sun as the last frame had it, the frame it last moved at, and how many times it has
    /// moved since the sky last caught up with it (its tables and its dome cooked for the sun as
    /// it is): while it moves, both cascades draw a strip a frame (`static_strips`), and once it
    /// has moved again before the sky caught up, the probes are traced again through a sky that
    /// isn't settled (`bake_probes`). And how many times it has moved since both cascades last
    /// settled: once it has moved again before they could, the probes keep their turns
    /// (`static_strips`).
    last_sun: vec3,
    sun_moved_at: u32,
    sun_moves: u32,
    cascade_moves: u32,
    /// Whether the cascades' last casting drew shadows (`Off::Shadows`): a switch of it recasts
    /// them (`shadow::Kept::recast`), where a move of the sun only draws them again.
    cast_on: bool,
}

/// What changed of a scene, outside the frame's own state (the light and the air the frame
/// compares itself): its ground (every level cooked again, the cascades and the probes too), its
/// static casters (the cascades drawn again), what occludes the probes (baked again beside those
/// in use), or the clouds' weather (cooked again, the dome marched afresh, then the probes baked
/// again under it).
pub enum Change: Copy + Eq + Fieldless {
    Ground,
    Casters,
    Occluders,
    Weather,
}

impl<R: Resolver, Q: Switches, Y: Style> Frame<R, Q, Y> {
    /// A frame of `quality`, lit by `light` through `air`, its ground in `clipmap`, its first
    /// camera `first` (its own last), its probes' first grid `grid` round `at` (render space;
    /// baked once what stands round them is in).
    pub fn new(
        quality: Quality,
        light: Light,
        air: Air,
        clipmap: take Clipmap,
        first: Camera,
        grid: ProbeGrid,
        at: vec2,
    ) -> Frame<R, Q, Y> {
        let sh = quality.shadows
        let near_at = if sh.near_moves >= 1.0e8 { sh.near.centre } else { first.eye }
        var probes = Baked::new(grid, Vec::new())
        probes.strip_rays = quality.probes.rays
        probes.grid.visibility = u32(Q::SIGHT)
        Frame {
            quality,
            debug: Debug { off: Flags::none() },
            look: Look {},
            metering: Metering {
                base: 0.62,
                // The band the meter reads is 2.1 times the scene's geometric mean the Last
                // Green's look was picked at (0.136), as the start's view and its walk measure.
                reference: 0.286,
                strength: 0.85,
                lo: 0.15,
                hi: 4.0,
                rate: 0.05,
                flash: 1.25,
                fresh: 0,
            },
            cam: first,
            light,
            air,
            tables: tables(),
            next_tables: tables(),
            air_slice: None,
            last_sun: light.sun,
            sun_moved_at: 0,
            sun_moves: 0,
            cascade_moves: 0,
            cast_on: true,
            sky_key: (air, light.sun, light.sun_colour),
            sky: new_sky::<Q>(),
            clouds: Clouds {
                eye: vec3(0.0),
                phase: 0,
                sun: light.sun,
                blend: 1.0,
                drift: vec2(0.0),
                seed: 0,
            },
            near: Kept::new(
                near_at,
                sh.near.span,
                reach: sh.near.reach,
                reach_in: sh.reach_in,
                side: sh.near.side,
                strips: sh.near_strips,
            ),
            far: Kept::new(
                sh.far.centre,
                sh.far.span,
                reach: sh.far.reach,
                reach_in: sh.reach_in,
                side: sh.far.side,
                strips: sh.far_strips,
            ),
            moving: depth_texture(width: 1, height: 1),
            moving_clear: false,
            cmp: comparison_sampler(),
            distance: Distance::new(Q::DISTANCE),
            fog: FogVolume::new(Q::FOG),
            probes: Probes {
                using: probes,
                at,
                next: None,
                next_at: at,
                next_cooked: false,
                spare: None,
                cooked: false,
                using_k: (0, 0, vec3(0.0), vec3(0.0)),
                next_k: (0, 0, vec3(0.0), vec3(0.0)),
            },
            clipmap,
            targets: no_targets(),
            pyramid: Pyramid::new(width: 1, height: 1),
            ambient: Occlusion::new(width: 1, height: 1),
            cascades: None,
            rejector: buffer(1),
            rejects: false,
            found: None,
            lights: Lights::new(),
            screen: texture::<Rgba16Float>(width: 1, height: 1),
            mirror: Mirror { cam: first, on: 0, probe: 0 },
            specular: Specular::new(),
            grade: identity(),
            particles: None,
            particle_shift: vec3(0.0),
            usage: unused(),
            said_over: false,
            emits: Emits::new(),
            see_through: None,
            resolver: R::made(),
            exposure: buffer(1),
            linear: sampler(),
            repeat: sampler(address: Address::Repeat),
            cooks: Cooks {
                planner: Planner::new(quality.budget),
                capture: false,
                arriving: quality.arrival.on,
                dt: 0.0,
                eye: vec2(0.0),
                origin: vec3(0.0),
                frames: 0,
                near_changed: false,
                far_changed: false,
            },
            measuring: Vec::new(),
            measured: [0; MEASURED_KINDS],
            measured_at: [0; MEASURED_KINDS],
            untimed: false,
            pacer: Scale {},
            ready: Readiness {
                playable: false,
                arriving: quality.arrival.on,
                gathered: 0,
                playable_at: None,
            },
            frames: 0,
            ran: 0,
            settled: 0,
            aimed: Aim {
                eye: vec3(0.0),
                at: vec3(0.0, 0.0, -1.0),
                fovy: 1.0,
                moving_at: vec3(0.0),
            },
            width: 0,
            height: 0,
            origin: vec3(0.0),
            last_eye: vec2(0.0),
            jumped: false,
            time: 0.0,
            last_time: None,
            hold: false,
            air_cooked: Stale::new(),
            noise_cooked: false,
            noise_slices: 0,
            weather_cooking: None,
            weather_cooked: Stale::new(),
            cloud_shadow: Stale::new(),
            casting: Stale::new(),
            cloud_wind: vec2(0.0),
            ground_again: false,
            weather_v: 0,
            probes_v: 0,
            sky_v: 0,
            probes_waited: false,
            sky_noted: None,
        }
    }

    /// The learned rejector's net (`temporal::REJECTOR`'s shape, half floats), which temporal AA
    /// reads under `Switches::LEARNED`.
    pub fn reject_by(mut self, net: [Half2]) {
        self.rejector = buffer_of(net)
        self.rejects = true
    }

    /// What the resolve finds at `pixels` of the output, each frame from the next until asked
    /// again (`temporal::found_rows`), into `found`'s rows (a row a pixel).
    pub fn ask_found(mut self, pixels: [vec2u]) {
        self.found = Some((buffer_of(pixels, at_least: 1), buffer(max(pixels.len(), 1))))
    }

    /// What the resolve found the last frame at the pixels `ask_found` asked for, as a new
    /// buffer (none if nothing was asked).
    pub fn found(self) -> Option<GpuBuffer<FoundRow>> {
        match self.found {
            Some((pixels, rows)) => {
                var out: GpuBuffer<FoundRow> = buffer(pixels.len())
                copy(from: rows.items(), to: out.items_mut())
                Some(out)
            },
            None => None,
        }
    }

    /// The frame's quality.
    pub fn quality(self) -> Quality {
        self.quality
    }

    /// The quality changed to `q`: what depends on what changed is made again (the targets at
    /// the next frame for the scale, temporal AA's history afresh; other cascades or another
    /// moving map, drawn again while frames are covered; probes of other rays, baked again; the
    /// planner, with the new budget).
    pub fn requality(mut self, q: Quality) {
        if q.scale != self.quality.scale {
            self.width = 0
        }
        // Other cascades or another moving map: made again (and drawn again, covered).
        let sh = q.shadows
        let remade = !same_shadows(sh, self.quality.shadows)
        if remade {
            let near_at = if sh.near_moves >= 1.0e8 { sh.near.centre - self.origin } else {
                self.cam.eye
            }
            self.near = Kept::new(
                near_at,
                sh.near.span,
                reach: sh.near.reach,
                reach_in: sh.reach_in,
                side: sh.near.side,
                strips: sh.near_strips,
            )
            self.far = Kept::new(
                sh.far.centre - self.origin,
                sh.far.span,
                reach: sh.far.reach,
                reach_in: sh.reach_in,
                side: sh.far.side,
                strips: sh.far_strips,
            )
            self.moving = depth_texture(width: sh.moving_side, height: sh.moving_side)
            self.moving_clear = false
        }
        // Probes of other rays: baked again beside those in use.
        if q.probes.rays != self.quality.probes.rays {
            self.probes_v += 1
        }
        // The cascades made again where their numbers changed.
        let (a, b) = (q.cascades, self.quality.cascades)
        if a.spacing != b.spacing || a.steps != b.steps {
            self.width = 0
        }
        self.quality = q
        self.cooks.planner = Planner::new(q.budget)
        if remade {
            self.arrive()
        }
    }

    /// `c` changed (`Change`).
    pub fn changed(mut self, c: Change) {
        match c {
            Change::Ground => {
                self.ground_again = true
                self.near.recast()
                self.far.recast()
                self.probes_v += 1
                // Its voxels hold the ground's distance too: cooked again.
                self.distance.forget()
            },
            Change::Casters => {
                self.near.recast()
                self.far.recast()
            },
            Change::Occluders => self.probes_v += 1,
            Change::Weather => self.weather_v += 1,
        }
    }

    /// A system left out (or back, `on`): what it changes is drawn again.
    pub fn set(mut self, off: Off, on: bool) {
        if on == !self.debug.off.has(off) {
            return
        }
        self.debug.off = self.debug.off.toggled(off)
    }

    /// Whether system `off` is drawn.
    pub fn on(self, off: Off) -> bool {
        !self.debug.off.has(off)
    }

    /// The frame's own keys for looking at it, not for play: F7 stills (capture mode: each
    /// frame's jitter on a still's grid, and the frames covered until the light round the eye has
    /// gathered; `still at frame N` is printed on the still) and V plain rendering. Whether `key`
    /// was one of them.
    pub fn key(mut self, key: Key) -> bool {
        if key == Key::F7 {
            self.debug.capture = !self.debug.capture
            self.ready.arriving = self.debug.capture
            self.ready.gathered = 0
            return true
        }
        if key == Key::V {
            self.debug.plain = !self.debug.plain
            return true
        }
        // The lookdev instrument's (docs/lookdev.md): F10 freezes time, F11 holds the eye, F12
        // draws the reference (and holds time and the eye while it does).
        if key == Key::F10 {
            self.debug.frozen = match self.debug.frozen {
                Some(_) => None,
                None => Some(self.time),
            }
            return true
        }
        // The backquote pauses the dolly where it is, and resumes it.
        if key == Key::Backquote {
            self.debug.paused = !self.debug.paused
            return true
        }
        // F11 cycles: the eye held, then dollied along its look, then the game's again.
        if key == Key::F11 {
            match self.debug.held {
                None => self.debug.held = Some(self.aimed),
                Some(_) => {
                    if self.debug.dolly {
                        self.debug.held = None
                    }
                    self.debug.dolly = !self.debug.dolly
                },
            }
            return true
        }
        if key == Key::F12 {
            // Either way the caches are made again: the frame waits for them (`arrive`).
            match self.debug.reference {
                Some((q, history)) => {
                    self.requality(q)
                    self.set(Off::History, on: history)
                    self.debug.reference = None
                },
                None => {
                    let history = self.on(Off::History)
                    self.debug.reference = Some((self.quality, history))
                    self.debug.frozen = Some(self.debug.frozen.unwrap_or(self.time))
                    self.debug.held = Some(self.debug.held.unwrap_or(self.aimed))
                    self.requality(Quality::reference())
                    // No history: the instrument's mean of 64 frames is then a 64-sample
                    // supersample, not the resolver's own filtering of them.
                    self.set(Off::History, on: false)
                },
            }
            self.debug.unsaid = true
            self.arrive()
            return true
        }
        false
    }

    /// The develop's view of form (`Debug::view`): 0 the look, 1 clay (the scene's light on its
    /// forms all one matte grey), 2 silhouettes.
    pub fn form(mut self, view: u32) {
        self.debug.view = view
        self.light.clay = if view == 1 { 1 } else { 0 }
    }

    /// Temporal AA's blend forced to `blend` (`Quality::blend`) and its history no longer clipped
    /// to the frame's neighbourhood: the lookdev instrument's ghost control (docs/lookdev.md), a
    /// history that drags behind what moves.
    pub fn ghost(mut self, blend: f32) {
        self.debug.ghost = true
        self.requality(Quality { blend, ..self.quality })
    }

    /// The game's time for the frame at `time`: the frozen one while F10 or F12 holds it, so a
    /// game that steps its own clocks by it (its snapshots, its shots' moves) holds them too.
    pub fn held_time(self, time: f32) -> f32 {
        self.debug.frozen.unwrap_or(time)
    }

    /// Whether the frame's time is frozen (F10, F12): a game then reads no new snapshots of its
    /// sim, so it holds as well.
    pub fn frozen(self) -> bool {
        self.debug.frozen.is_some()
    }

    /// An arrival begins (a lookbook shot, a capture, a jump the eye didn't make): frames are
    /// covered until the light round the eye is drawn and gathered. A capture's dome is marched
    /// afresh round the new eye too.
    pub fn arrive(mut self) {
        if !self.quality.arrival.on {
            return
        }
        self.ready.arriving = true
        self.ready.gathered = 0
        if self.debug.capture {
            self.sky.frames = 0
        }
    }

    /// The probes start again from nothing round where they are (what they were baked over went):
    /// baked once what stands round them is in.
    pub fn restart_probes<S: Scene>(mut self, scene: S) {
        var b = Baked::new(scene.probe_grid(self.probes.at, self.origin), Vec::new())
        b.strip_rays = self.quality.probes.rays
        b.grid.visibility = u32(Q::SIGHT)
        self.probes.using = take b
        self.probes.cooked = false
        self.probes.next = None
    }

    /// The air is `air` now: its tables cooked again, and the clouds' dome marched afresh.
    pub fn set_air(mut self, air: Air) {
        self.air = air
        self.sky.frames = 0
    }

    /// The render origin moved to `origin` (whole tiles): everything kept in render space moves
    /// by the old origin less the new, keeping what it cooked (the clipmap's levels, the probes
    /// in use, the cascades, and the scene's own); probes being baked for a new place are
    /// dropped (their occluders were cooked from the old render space: baked again round the
    /// eye).
    pub fn recentre<S: Scene>(mut self, scene: mut S, origin: vec3) {
        if origin == self.origin {
            return
        }
        let d = self.origin - origin
        self.origin = origin
        scene.shift(d)
        // Last frame's depth was drawn in the old render space: nothing is hidden by it, nor
        // shades what's near.
        self.pyramid.at.on = 0
        self.ambient.forget()
        self.mirror.on = 0
        self.clipmap.set_origin(origin.xz)
        self.probes.using.shift(d.xz)
        self.probes.at += d.xz
        self.probes.next = None
        self.distance.forget()
        self.fog.forget()
        self.near.shift(d)
        self.far.shift(d)
        self.particle_shift += d
    }

    /// The look graded by `lut` (a `paint::LUT_SIDE`³ table of display colours), as much as
    /// `Look::grade` says.
    pub fn grade_with(mut self, lut: take Texture3d<Rgba8>) {
        self.grade = take lut
    }

    /// The frame's size and camera: the output is `width` × `height`; the scene's at the render
    /// scale (or the output's, drawn plain); the camera at `aim`, jittered unless plain, on a
    /// still's grid when capturing. What a game does with the camera before `draw` (its sound, a
    /// click's provenance) reads `cam`.
    pub fn begin<S: Scene>(
        mut self,
        scene: mut S,
        aim: Aim,
        time: f32,
        width: u32,
        height: u32,
    ) -> Camera {
        // The lookdev instrument's held time and eye (F10, F11, F12).
        self.aimed = aim
        if let Some(h) = self.debug.held {
            let stopped = self.debug.paused || self.debug.reference.is_some() || self.ready.arriving
            if self.debug.dolly && !stopped {
                let step = normalize(h.at - h.eye) * DOLLY
                self.debug.held = Some(Aim { eye: h.eye + step, at: h.at + step, ..h })
            }
        }
        let aim = self.debug.held.unwrap_or(aim)
        let time = self.debug.frozen.unwrap_or(time)
        let dt = match self.last_time {
            Some(t) => clamp(time - t, 0.0, 0.1),
            None => 0.0,
        }
        let scaled = R::scaled()
        if self.quality.pace && scaled {
            self.pacer.least = min(LEAST_SCALE / self.quality.scale, 1.0)
            pace(mut self.pacer, dt)
        }
        let paced = if self.quality.pace && scaled { self.pacer.value } else { 1.0 }
        let scale = if self.debug.plain || !scaled { 1.0 } else { self.quality.scale * paced }
        let (w, h) = (max(u32(f32(width) * scale), 1), max(u32(f32(height) * scale), 1))
        if width != self.width || height != self.height || f32(w) != self.cam.screen.x {
            self.targets = targets_for(width, height, w, h, scene.has_effects())
            self.pyramid = Pyramid::new(width: w, height: h)
            self.ambient = Occlusion::new(width: w, height: h)
            let cq = self.quality.cascades
            self.cascades = if Q::CASCADES {
                Some(Cascades::new(vec2u(w, h), spacing: cq.spacing, steps: cq.steps))
            } else {
                None
            }
            self.screen = texture::<Rgba16Float>(width: w, height: h)
            self.mirror.on = 0
            self.see_through = None
            self.resolver.resize(w, h)
            scene.resized(w, h)
            self.width = width
            self.height = height
            self.frames = 0
            self.settled = 0
        }
        self.cooks.dt = dt
        self.last_time = Some(time)
        self.time = time
        self.cam = camera(
            aim.eye,
            aim.at,
            aim.fovy,
            width: w,
            height: h,
            frame: self.frames,
            time: time,
            last: self.cam,
            still: self.debug.plain,
            origin: self.origin,
            grid: self.debug.capture || self.debug.reference.is_some(),
            cells: if self.debug.reference.is_some() { 8 } else { 4 },
        )
        self.cam
    }

    /// This frame cooked and drawn (the module's comment), the camera `begin` made at `aim`.
    pub fn draw<S: Scene>(mut self, scene: mut S, aim: Aim) {
        phase("cook")
        let aim = self.debug.held.unwrap_or(aim)
        if self.debug.unsaid && !self.ready.arriving {
            self.debug.unsaid = false
            let said = if self.debug.reference.is_some() { REFERENCE } else { PLAY }
            print(f"{said} {self.frames}")
        }
        if self.quality.measured {
            self.measure()
        }
        if self.ran % MEMORY_EVERY == 0 {
            self.memory(mut scene)
        }
        let cam = self.cam
        let eye = cam.eye
        let eye_w = eye.xz + self.origin.xz
        let wind = scene.wind(cam, self.time)
        // The ground: mandatory, cooked first (`engine::cook`).
        let again = self.ground_again
        self.ground_again = false
        let levels = scene.cook_ground(mut self.clipmap, eye, again)
        let filling = self.debug.capture
        // (The moving-cache rules hold from the first full frame on, through later arrivals.)
        self.cooks.planner.begin(levels, self.ready.playable_at.is_some(), self.near.ready, filling)
        // A cook of the sky that's a frame of its own counts before any optional step, of the
        // light the sky cooks for this frame.
        self.follow_light(eye.xz)
        self.sky_noted = self.sky_cook()
        if let Some(w) = self.sky_noted {
            self.cooks.planner.note(w)
        }
        self.cooks.capture = filling
        self.cooks.arriving = self.ready.arriving
        self.cooks.playable = self.ready.playable_at.is_some()
        self.cooks.eye = eye_w
        self.cooks.origin = self.origin
        self.cooks.frames = self.frames
        let steps = self.cooks.planner.steps(filling: true)
        for _ in 0..steps {
            scene.cook(mut self.cooks, mut self.clipmap, self.linear)
        }
        if self.cooks.near_changed {
            self.near.recast()
        }
        if self.cooks.far_changed {
            self.far.recast()
        }
        self.cooks.near_changed = false
        self.cooks.far_changed = false
        // The static cascades: drawn again when the sun or the casting moved; the near round
        // where the eye is (a little ahead), the far round its place in the world.
        let on = self.on(Off::Shadows)
        let cast_key = (self.light.sun, on)
        if self.casting.stale(cast_key) {
            if self.casting.ready() && on != self.cast_on {
                self.near.recast()
                self.far.recast()
            } else if self.casting.ready() {
                self.near.changed()
                self.far.changed()
            }
            self.cast_on = on
            self.casting.cooked(cast_key)
        }
        let q = self.quality.shadows
        if q.near_moves < 1.0e8 {
            self.near.follow(vec3(eye.x, scene.height_at(eye_w), eye.z), q.near_moves)
        } else {
            self.near.follow(q.near.centre - self.origin, 1.0e9)
        }
        self.far.follow(q.far.centre - self.origin, 1.0e9)
        let moving_at = aim.moving_at + vec3(0.0, 1.0, 0.0)
        var sh = shadows(
            self.light.sun,
            self.near.cascade(),
            self.far.cascade(),
            moving_at: moving_at,
            moving_span: q.moving_span,
            moving_side: q.moving_side,
        )
        let moved = self.light.sun != self.last_sun
        if moved {
            self.sun_moved_at = self.ran
            self.last_sun = self.light.sun
        }
        let caught = !self.air_cooked.stale(self.sky_key) &&
            self.sky.done() &&
            self.sky_key.1 == self.light.sun
        self.sun_moves = (if caught { 0 } else { self.sun_moves }) + (if moved { 1 } else { 0 })
        let settled = self.near.settled() && self.far.settled()
        self.cascade_moves = (if settled { 0 } else { self.cascade_moves }) + (if moved { 1 } else {
            0
        })
        for _ in 0..steps {
            self.static_strips(mut scene, sh, wind)
        }
        // A completed strip set swaps its depth map and cascade together: shading uses the new
        // cascade this frame, the moving map and the probes' bake too.
        sh = Shadows {
            soft_pcss: if Q::PCSS { 1 } else { 0 },
            sun_size: self.light.sun_size,
            ..shadows(
                self.light.sun,
                self.near.cascade(),
                self.far.cascade(),
                moving_at: moving_at,
                moving_span: q.moving_span,
                moving_side: q.moving_side,
            ),
        }
        // Nothing moving casts: the map cleared once is kept, a texel of it (a cleared map reads
        // as lit wherever it's read); what casts gets the map its side.
        let casts = scene.casts_moving()
        let side = if casts { q.moving_side } else { 1 }
        if self.moving.width() != side {
            self.moving = depth_texture(width: side, height: side)
            self.moving_clear = false
        }
        if casts || !self.moving_clear {
            label("shadow moving")
            let mv = begin_depth_pass(mut self.moving, clear_depth: 1.0)
            if casts {
                scene.cast_moving(mv, sh.moving)
            }
            mv.end()
            self.moving_clear = !casts
        }
        // The sky a phase a frame (all of it while a capture fills the dome).
        for k in 0..self.cooks.planner.steps(filling: !self.sky.done()) {
            if k > 0 && self.sky.done() {
                break
            }
            self.cook_sky(scene, eye, wind)
        }
        // The distance volume round the eye: a slab a frame while it's due (the scene's solids
        // changed, or the eye moved a bin).
        if Q::DISTANCE {
            let since = self.distance.version()
            self.distance.follow(eye, scene.solids(self.origin, since))
            if self.distance.due() && self.cooks.planner.may(Work::Distance) {
                self.distance.cook(self.clipmap.levels(), self.clipmap.texels())
            }
        }
        // The probes a strip a frame (many while a capture's bake is under way).
        for _ in 0..steps {
            let baking = !self.probes.done() || self.probes.next.is_some()
            self.bake_probes(scene, sh, eye.xz)
            if !baking {
                break
            }
        }
        // A jump: frames are covered while the light round the new eye is drawn.
        self.jumped = self.frames > 0 && length(eye_w - self.last_eye) > self.quality.arrival.jump
        if self.jumped {
            self.arrive()
        }
        self.last_eye = eye_w
        if self.ready.arriving {
            self.ready.gathered = arrival_gathered(
                self.ready.gathered,
                self.lit(scene, eye.xz, eye_w),
            )
        }
        self.ready.playable = self.playable(scene, eye_w)
        if self.ready.playable && self.ready.playable_at.is_none() {
            self.ready.playable_at = Some(self.frames)
            print(f"playable at frame {self.frames}")
            self.say_shares(scene)
        }
        if self.hold {
            self.ran += 1
            return
        }
        swap(mut self.targets.depth, mut self.targets.last_depth)
        self.ambient.turn()
        if self.jumped {
            self.ambient.forget()
            self.mirror.on = 0
        }
        // The specular probe's next face, from the sky as it is.
        if Q::REFLECTIONS {
            self.specular.bake_face(
                self.light,
                self.air.ground,
                self.tables.view,
                self.sky.dome,
                self.probes.using.maps,
                self.linear,
            )
        }
        self.draw_scene(mut scene, sh, wind)
        self.finish(scene)
        self.frames += 1
        self.ran += 1
    }

    /// A measuring frame's times (`Quality::measured`), before anything is recorded: each answer
    /// that's come is the planner's, and each kind that's due and not asked for is asked for (its
    /// answer is the first frame's from this one that runs a step of it). None is asked for while
    /// a capture fills its caches, whose frames run many steps of a kind.
    fn measure(mut self) {
        // How many steps of each kind the frame a time was asked for ran (the first frame from the
        // asking that ran one, as the host times it): the planner's count is the last frame's.
        for mut m in self.measuring {
            if m.2 == 0 {
                m.2 = self.cooks.planner.ran(MEASURED[m.0].0)
            }
        }
        var k = 0
        while k < self.measuring.len() {
            let i = self.measuring[k].0
            let steps = max(self.measuring[k].2, 1)
            match self.measuring[k].1.poll() {
                Some(Ok(us)) => {
                    self.cooks.planner.measure(MEASURED[i].0, us[0] / f32(steps))
                    self.measured[i] += 1
                    self.measured_at[i] = self.ran
                    let _ = self.measuring.remove(k)
                },
                Some(Err(_)) => {
                    self.untimed = true
                    let _ = self.measuring.remove(k)
                },
                None => k += 1,
            }
        }
        if self.untimed || self.debug.capture {
            return
        }
        for i in 0..MEASURED_KINDS {
            var asked = false
            for m in self.measuring {
                asked = asked || m.0 == i
            }
            let due = self.measured[i] < MEASURE_FIRST ||
                self.ran - self.measured_at[i] >= MEASURE_AGAIN
            if !asked && due {
                self.measuring.push((i, timed(MEASURED[i].1), 0))
            }
        }
    }

    /// The program's GPU memory read against its budget (`Quality::memory`, the scene's
    /// `shares`) and handed to the scene to trim what's over (`Scene::pressed`); the first time
    /// something is over, it's said.
    fn memory<S: Scene>(mut self, scene: mut S) {
        var shares = self.shares()
        for sh in scene.shares() {
            shares.push(sh.clone())
        }
        self.usage = Usage { gpu: memory(), total: self.quality.memory, shares }
        scene.pressed(self.usage)
        let over = self.usage.over()
        if !over.is_empty() && !self.said_over {
            self.said_over = true
            let mib = |b: u64| b / memory::MIB
            var names = String::new()
            for n in over {
                if !names.is_empty() {
                    names.push_str(", ")
                }
                names.push_str(n)
            }
            var parts = String::new()
            var counted = 0
            for sh in self.usage.shares {
                parts.push_str(f", {sh.name} {mib(sh.bytes)}")
                counted += sh.bytes
            }
            let rest = if self.usage.held() > counted { self.usage.held() - counted } else { 0 }
            print(
                f"GPU memory over its budget ({names}): {mib(self.usage.held())} MiB held of {mib(self.usage.total)}{parts}, the rest {mib(rest)}",
            )
        }
    }

    /// The GPU memory held and each share of it (the frame's and the scene's), printed once at
    /// `playable` as `memory shares: held <bytes>, <name> <bytes>, ...` (the bench reads it).
    fn say_shares<S: Scene>(self, scene: S) {
        let gpu = memory()
        var line = String::from(f"memory shares: held {gpu.buffers + gpu.textures}")
        for sh in self.shares() {
            line.push_str(f", {sh.name} {sh.bytes}")
        }
        for sh in scene.shares() {
            line.push_str(f", {sh.name} {sh.bytes}")
        }
        print(line)
    }

    /// What the frame's own subsystems hold on the GPU, by their own counts: its targets (with
    /// the depth pyramid, the ambient occlusion and the see-through targets), the cascades and
    /// the moving map, the sky, the probes (in use, being baked and kept for the next), the
    /// ground's clipmap, the reflections (the screen's copy and the specular probe), the lights'
    /// lists, and the particles once there are some. None has a budget of its own: the total is
    /// theirs.
    pub fn shares(self) -> Vec<Share> {
        let total = self.quality.memory
        let share = |name: Text, bytes: u64| Share { name, bytes, budget: total }
        var probes = self.probes.using.bytes()
        match self.probes.next {
            Some(b) => probes += b.bytes(),
            None => {},
        }
        match self.probes.spare {
            Some(b) => probes += b.bytes(),
            None => {},
        }
        var targets = self.targets.bytes() + self.pyramid.bytes() + self.ambient.bytes()
        match self.cascades {
            Some(c) => targets += c.bytes(),
            None => {},
        }
        match self.see_through {
            Some(t) => targets += t.bytes(),
            None => {},
        }
        let reflections = memory::texels(self.screen.width(), self.screen.height(), 8) +
            self.specular.bytes()
        var out = Vec::from(
            [
                share("targets", targets),
                share(
                    "shadows",
                    self.near.bytes() +
                        self.far.bytes() +
                        memory::texels(self.moving.width(), self.moving.height(), 4),
                ),
                share("sky", self.sky.bytes()),
                share("probes", probes),
                share("distance", self.distance.bytes()),
                share("fog", self.fog.bytes()),
                share("terrain", self.clipmap.bytes()),
                share("reflections", reflections),
                share("lights", self.lights.bytes()),
            ],
        )
        match self.particles {
            Some(p) => out.push(share("particles", p.bytes())),
            None => {},
        }
        out
    }

    /// Whether a frame from `eye_w` (the world's) is full: the near cascade drawn, the probes in
    /// use baked whole, and the scene streamed round it.
    pub fn playable<S: Scene>(self, scene: S, eye_w: vec2) -> bool {
        self.near.ready && self.probes.done() && scene.streamed(eye_w)
    }

    /// Whether the light round the eye (`eye` in render space, `eye_w` in the world) is drawn: a
    /// full frame there, both cascades settled, the near one and the probes in use round it (not
    /// round where the eye was).
    pub fn lit<S: Scene>(self, scene: S, eye: vec2, eye_w: vec2) -> bool {
        self.cascades_whole() &&
            length(eye - self.near.centre.xz) <= self.quality.shadows.near_moves &&
            self.probes.next.is_none() &&
            length(eye - self.probes.at) <= self.quality.probes.moves &&
            self.playable(scene, eye_w)
    }

    /// The static cascades' strips this frame, as the plan allows: a strip of whichever is being
    /// drawn (the near first, the far once its casters are in); while the sun moves (it moved
    /// last frame or this), a strip of each, so neither waits on the other's sets (each set is
    /// drawn from the sun it began with: `shadow::Kept::strip`), and none every `PROBE_TURN`th
    /// frame, which the probes take (a frame that draws a strip bakes none); and none on that
    /// frame either while the sun moves again before the cascades settle (`cascade_moves`: a sun
    /// stepped every few frames), whose sets would otherwise take every frame.
    fn static_strips<S: Scene>(mut self, scene: mut S, sh: Shadows, wind: Wind) {
        let turn = self.ran % PROBE_TURN == PROBE_TURN - 1
        if self.ran - self.sun_moved_at < 2 {
            if !turn {
                self.strip(mut scene, sh, wind, far: false)
                self.strip(mut scene, sh, wind, far: true)
            }
        } else if !(turn && self.cascade_moves >= 2) {
            if self.near.drawing() && scene.casters_ready(far: false) {
                self.strip(mut scene, sh, wind, far: false)
            } else {
                self.strip(mut scene, sh, wind, far: true)
            }
        }
    }

    /// A strip of the near cascade (or with `far` the far one), if it's being drawn, its casters
    /// are in, and the plan allows it.
    fn strip<S: Scene>(mut self, scene: mut S, sh: Shadows, wind: Wind, far: bool) {
        let drawing = if far { self.far.drawing() } else { self.near.drawing() }
        if !drawing || !scene.casters_ready(far) {
            return
        }
        if !self.cooks.planner.may(if far { Work::FarStrip } else { Work::NearStrip }) {
            return
        }
        let on = self.on(Off::Shadows)
        let still = Wind { strength: 0.0, ..wind }
        if far {
            label("shadows far")
            strip_of(
                mut self.far,
                mut scene,
                self.clipmap,
                self.light.sun,
                sh,
                still,
                self.linear,
                self.cam,
                on,
            )
        } else {
            label("shadows near")
            strip_of(
                mut self.near,
                mut scene,
                self.clipmap,
                self.light.sun,
                sh,
                still,
                self.linear,
                self.cam,
                on,
            )
        }
    }

    /// The cook of the sky that's a frame of its own this frame, if one is (a slice of the air's
    /// tables, which `cook_sky` cooks first), so the plan counts it before the frame's optional
    /// steps. The clouds' noise and weather are optional steps, a slice each.
    fn sky_cook(self) -> Option<Work> {
        if self.ran == 0 {
            None
        } else if self.air_slice.is_some() || self.air_cooked.stale(self.sky_key) {
            Some(Work::AirTables)
        } else {
            None
        }
    }

    /// The sky, cooked a step a frame: the air's tables (again when the air or the light
    /// changed: a slice a step, beside the tables in use, which they replace once whole; a cook
    /// under way finishes with the air it began with, so a moving sun's sky follows a cook
    /// behind) and the probes' open sky from them, after the first frame (which is full); the
    /// clouds' noises; their weather and shadow maps (again when the sun or the weather
    /// changed), each in a frame of its own (each is tens of milliseconds: together with the
    /// load's other work, a frame took 137 ms); then a phase of the dome marched a frame, from
    /// `eye`, the field drifted with the wind.
    fn cook_sky<S: Scene>(mut self, scene: S, eye: vec3, wind: Wind) {
        let weather_key = (self.sky_key.1, self.weather_v)
        let cloud_shadows = self.on(Off::CloudShadows)
        let cooking = self.sky_cook()
        // Counted once: the cook `draw` counted before the optional steps isn't counted again.
        if let Some(w) = cooking {
            if self.sky_noted == Some(w) {
                self.sky_noted = None
            } else {
                self.cooks.planner.note(w)
            }
        }
        match cooking {
            Some(Work::AirTables) => {
                // The air and the light are held while it cooks (`follow_light`).
                let k = match self.air_slice {
                    Some(k) => k,
                    None => 0,
                }
                self.next_tables.cook_slice(self.sky_key.0, self.linear, k)
                if k + 1 < AIR_SLICES {
                    self.air_slice = Some(k + 1)
                } else {
                    self.air_slice = None
                    swap(mut self.tables, mut self.next_tables)
                    self.probes.using.open(
                        self.sky_light(),
                        self.sky_key.0.ground,
                        self.tables.view,
                        self.linear,
                    )
                    self.air_cooked.cooked(self.sky_key)
                    self.sky_v += 1
                    // The dome is marched again through the new air (the probes wait for it).
                    self.sky.frames = 0
                }
            },
            _ => {},
        }
        // Once the air is in: the clouds' noises, then their weather and its shadow, a slice a
        // step, as many a frame as the budget allows and `SKY_FRAME_US` holds (whole, a cook
        // took tens of milliseconds, and one frame cooking the air and the clouds together took
        // 137 ms).
        let air_in = cooking.is_none() && self.ran > 0
        var sky_us = 0.0
        if air_in && !self.noise_cooked {
            let cost = self.cooks.planner.cost(Work::SkyNoise).us
            while self.noise_slices < NOISE_SLICES &&
                (sky_us == 0.0 || sky_us + cost <= SKY_FRAME_US) &&
                self.cooks.planner.may(Work::SkyNoise) {
                self.sky.cook_noise_slice(self.noise_slices)
                self.noise_slices += 1
                sky_us += cost
            }
            self.noise_cooked = self.noise_slices == NOISE_SLICES
        } else if air_in &&
            (self.weather_cooking.is_some() || self.weather_cooked.stale(weather_key)) {
            if self.weather_cooking.is_none() {
                let w = scene.weather()
                self.cloud_wind = w.wind
                self.weather_cooking = Some((0, weather_key, cloud_shadows, take w))
            }
            loop {
                let step = match self.weather_cooking {
                    Some(c) => c.0,
                    None => 2 * MAP_BANDS,
                }
                let cost = self.cooks.planner.cost(Work::SkyWeather).us
                if step >= 2 * MAP_BANDS ||
                    (sky_us > 0.0 && sky_us + cost > SKY_FRAME_US) ||
                    !self.cooks.planner.may(Work::SkyWeather) {
                    break
                }
                sky_us += cost
                match mut self.weather_cooking {
                    Some(c) => {
                        if step < MAP_BANDS {
                            self.sky.cook_weather_band(c.3, step)
                        } else {
                            let band = step - MAP_BANDS
                            // For the sun the cook began with (its key's): a map of one sun.
                            self.sky.cook_shadow_band(c.1.0, self.repeat, c.2, band)
                        }
                        c.0 += 1
                    },
                    None => {},
                }
            }
            // Whole: for the weather and the sun it began with (a change since is cooked next).
            let done = match self.weather_cooking {
                Some(c) => if c.0 == 2 * MAP_BANDS { Some((c.1, c.2)) } else { None },
                None => None,
            }
            if let Some((key, shadows)) = done {
                self.weather_cooking = None
                self.weather_cooked.cooked(key)
                self.sky_v += 1
                self.cloud_shadow.cooked((shadows, self.weather_cooked.version()))
            }
        }
        let fresh = !self.weather_cooked.stale(weather_key)
        let shadow_key = (cloud_shadows, self.weather_cooked.version())
        if fresh && self.cloud_shadow.stale(shadow_key) {
            self.sky.cook_shadow(self.sky_key.1, self.repeat, shadows: cloud_shadows)
            self.cloud_shadow.cooked(shadow_key)
        }
        // A dome that's whole is marched again only while the probes' steps aren't waiting on
        // the budget: the first full frame needs them, and the dome's light is already there.
        let yield_to_probes = self.probes_waited && self.sky.done()
        if fresh && !yield_to_probes && self.cooks.planner.may(Work::SkyPhase) {
            self.clouds = self.sky.march::<Q>(
                self.sky_key.0,
                self.sky_light(),
                self.tables,
                eye,
                // The field's drift, less the render origin (`Clouds::drift`).
                drift: self.cloud_wind * wind.time - self.cam.keyed().xz,
                rep: self.repeat,
                s: self.linear,
                still: self.debug.still,
                forward: self.cam.forward,
                view: self.cam.corner_angle(),
            )
        }
    }

    /// The air and the light the sky cooks for (`sky_key`) brought to the frame's own, unless a
    /// cook of the air's tables is under way (it finishes with the air it began with), or the
    /// tables are cooked for them and probes wait for the sky they bake (`wants_probes`): the sky
    /// is then cooked whole for them first. So a sun that moves from the first frame still has
    /// its first sky and probes, and a moving sun's probes round a new eye are baked, the sky a
    /// cook behind the sun meanwhile. (`eye`: render space.)
    fn follow_light(mut self, eye: vec2) {
        if self.air_slice.is_some() {
            return
        }
        if self.air_cooked.stale(self.sky_key) || !self.wants_probes(eye) {
            self.sky_key = (self.air, self.light.sun, self.light.sun_colour)
        }
    }

    /// The light the sky cooks for (`sky_key`): the frame's, its sun as the sky has it.
    fn sky_light(self) -> Light {
        Light { sun: self.sky_key.1, sun_colour: self.sky_key.2, ..self.light }
    }

    /// What the probes are baked from, as the sky has it: their occluders' and ground's version,
    /// the sky's, and the sun the sky cooks for.
    fn probe_key(self) -> ProbeKey {
        (self.probes_v, self.sky_v, self.sky_key.1, self.sky_key.2)
    }

    /// Whether probes wait for the sky they bake (`bake_probes`): the first, or new ones beside
    /// them, under way or due (the eye, `eye` in render space, moved on, or what they're baked
    /// from changed).
    fn wants_probes(self, eye: vec2) -> bool {
        !self.probes.cooked ||
            !self.probes.done() ||
            self.probes.next.is_some() ||
            length(eye - self.probes.at) > self.quality.probes.moves ||
            !same_inputs(self.probes.using_k, self.probe_key(), self.quality.probes.again)
    }

    /// Whether both static cascades are drawn whole for what casts now (`shadow::Kept::whole`):
    /// settled, or a set behind a sun that moved, however often it moves.
    fn cascades_whole(self) -> bool {
        self.near.whole(self.light.sun) && self.far.whole(self.light.sun)
    }

    /// The probes, lit by `sh`: the first baked round the eye once the near cascade, the air's
    /// tables and the clouds' dome are drawn (the dome's light is what they bake: a dome half
    /// marched left the light in shade greener and dimmer) and every static caster is in with
    /// both cascades settled (the first probes see the light an arrival reveals), their occluders
    /// cooked first, then a strip of columns a frame; then the next round the eye once it has
    /// moved `ProbeQuality::moves` or what they're baked from changed, baked beside them and
    /// swapped in when whole. While playable, not in a frame that cooked the ground or drew a
    /// strip (one moving cache a frame).
    fn bake_probes<S: Scene>(mut self, scene: S, sh: Shadows, eye: vec2) {
        // The sky the probes bake is settled: the air's tables cooked for the light the sky
        // cooks for, the dome marched through them. While the sun moves it's held for probes that
        // wait for it (`follow_light`), and otherwise isn't; then only the probes in use are
        // traced again, by the tables and the dome as they are.
        let settled = !self.air_cooked.stale(self.sky_key) && self.sky.done()
        let moving = self.sun_moves >= 2
        let tracing = self.quality.probes.again && self.probes.done() && self.probes.next.is_none()
        if !self.near.ready || !(settled || (moving && tracing)) {
            return
        }
        if !self.cooks.planner.would(Work::ProbeStrip) &&
            !(tracing && self.cooks.planner.would(Work::ProbeAgain)) {
            return
        }
        // A still's probes wait for what's round the eye too: their occluders.
        if self.debug.capture && scene.loading() {
            return
        }
        if !self.probes.cooked && !(scene.casters_complete() && self.cascades_whole()) {
            return
        }
        let key = self.probe_key()
        // The rays step through the solids' distance volume once it's cooked.
        let trace = Trace {
            solids: self.distance.read(),
            ..scene.trace(self.light, self.probes.using.grid),
        }
        let texels = self.clipmap.texels()
        let levels = self.clipmap.levels()
        if !self.probes.cooked {
            let Some(occluders) = scene.occluders(eye, self.origin) else { return }
            if !probe_step(mut self.cooks.planner, mut self.probes_waited, Work::ProbeOccluders) {
                return
            }
            var b = Baked::new(scene.probe_grid(eye, self.origin), occluders)
            b.strip_rays = self.quality.probes.rays
            b.grid.visibility = u32(Q::SIGHT)
            self.probes.using = take b
            self.probes.at = eye
            self.probes.using.open(
                self.sky_light(),
                self.sky_key.0.ground,
                self.tables.view,
                self.linear,
            )
            self.probes.using.cook()
            self.probes.cooked = true
            self.probes.using_k = key
            return
        }
        if !self.probes.done() {
            if probe_step(mut self.cooks.planner, mut self.probes_waited, Work::ProbeStrip) {
                // Twice the columns a strip while the frame loads: its budget allows it, and
                // the probes' first bake is the last link before playable.
                self.probes.using.strip_columns = if self.ready.playable_at.is_none() {
                    2 * STRIP_COLUMNS
                } else {
                    STRIP_COLUMNS
                }
                self.probes.using.bake_strip::<Q>(
                    Trace { grid: self.probes.using.grid, ..trace },
                    sh,
                    levels,
                    texels,
                    self.near.front,
                    self.far.front,
                    self.cmp,
                    self.tables.view,
                    self.sky.dome,
                    self.linear,
                    self.distance.volume,
                )
            }
            return
        }
        // A replacement started from older inputs is dropped (with the probes traced again, older
        // occluders: they follow a new sky by tracing).
        let again = self.quality.probes.again
        if self.probes.next.is_some() && !same_inputs(self.probes.next_k, key, again) {
            self.probes.spare = replace(mut self.probes.next, None)
        }
        let moved = length(eye - self.probes.at) > self.quality.probes.moves
        if self.probes.next.is_none() &&
            settled &&
            (moved || !same_inputs(self.probes.using_k, key, again)) {
            let Some(occluders) = scene.occluders(eye, self.origin) else { return }
            let g = scene.probe_grid(eye, self.origin)
            // Moved alone (its inputs the same), the probes shift by whole columns: those both
            // grids hold kept, the new band's baked and its occluders cooked (`Baked::shifted`).
            let shift = same_inputs(self.probes.using_k, key, again) &&
                g.spacing == self.probes.using.grid.spacing
            let d = vec2i(round((g.corner - self.probes.using.grid.corner) / g.spacing))
            var b = match replace(mut self.probes.spare, None) {
                Some(old) => if shift && Baked::shifts(old, self.probes.using) {
                    let near = band(occluders, self.probes.using.grid, d)
                    Baked::shifted::<Q>(take old, self.probes.using, d, near)
                } else { Baked::renew(take old, g, occluders) },
                None => Baked::new(g, occluders),
            }
            b.strip_rays = self.quality.probes.rays
            b.grid.visibility = u32(Q::SIGHT)
            self.probes.next = Some(take b)
            self.probes.next_at = eye
            self.probes.next_cooked = false
            self.probes.next_k = key
        }
        var swap_now = false
        match mut self.probes.next {
            Some(next) => {
                if !self.probes.next_cooked {
                    if probe_step(
                        mut self.cooks.planner,
                        mut self.probes_waited,
                        Work::ProbeOccluders,
                    ) {
                        next.cook()
                        next.open(
                            self.sky_light(),
                            self.sky_key.0.ground,
                            self.tables.view,
                            self.linear,
                        )
                        self.probes.next_cooked = true
                    }
                } else if !next.done() {
                    if probe_step(
                        mut self.cooks.planner,
                        mut self.probes_waited,
                        Work::ProbeStrip,
                    ) {
                        next.bake_strip::<Q>(
                            Trace { grid: next.grid, ..trace },
                            sh,
                            levels,
                            texels,
                            self.near.front,
                            self.far.front,
                            self.cmp,
                            self.tables.view,
                            self.sky.dome,
                            self.linear,
                            self.distance.volume,
                        )
                    }
                } else {
                    swap_now = true
                }
            },
            None => {
                // Once baked, a strip traced again a frame as the clouds drift and the sun moves:
                // the probes in use take the new sky as they're traced (not new occluders or
                // ground: those are baked into new probes).
                if again && !self.debug.still && self.cooks.planner.may(Work::ProbeAgain) {
                    self.probes.using_k = (self.probes.using_k.0, key.1, key.2, key.3)
                    // Steered to where the sun or the sky changed, near and ahead of the eye
                    // first (`probes::next_strip`, B9c).
                    let ahead = self.cam.forward.xz
                    let steer = Steer {
                        frame: self.ran + 1,
                        sun: normalize(self.sky_key.1),
                        weather: key.1,
                        eye,
                        ahead: if dot(ahead, ahead) > 1.0e-8 { normalize(ahead) } else {
                            vec2(0.0, 1.0)
                        },
                    }
                    self.probes.using.bake_strip::<Q>(
                        trace,
                        sh,
                        levels,
                        texels,
                        self.near.front,
                        self.far.front,
                        self.cmp,
                        self.tables.view,
                        self.sky.dome,
                        self.linear,
                        self.distance.volume,
                        steer: if STEERED { steer } else { Steer {} },
                    )
                }
            },
        }
        if swap_now {
            let old = replace(mut self.probes.using, replace(mut self.probes.next, None).unwrap())
            self.probes.spare = Some(take old)
            self.probes.at = self.probes.next_at
            self.probes.using_k = self.probes.next_k
        }
    }

    /// The scene's passes, lit by `sh`, the probes and the clouds: what the GPU chooses, the
    /// depth prepass, the lit scene, the ground, the characters and the sky, the effects, and
    /// what moved.
    fn draw_scene<S: Scene>(mut self, scene: mut S, sh: Shadows, wind: Wind) {
        let cam = self.cam
        var grid = self.probes.using.grid
        // Until the probes are baked (or where they don't light the scene), the open sky lights
        // everything.
        if !self.probes.done() || !scene.probes_lit() {
            grid.cols = 0
        }
        borrow maps = self.probes.using.maps
        // The culling phase: what every pass draws, chosen on the GPU in one compute pass before
        // the first render pass (the terrain's sides, the scene's: its wood, rocks and grass).
        label("cull")
        if self.on(Off::Terrain) {
            self.clipmap.cull(cam)
        }
        self.lights.bin(cam, scene.lights())
        let texels = self.clipmap.texels()
        let grounds = self.probes.using.grounds.span(
            start: 0,
            count: self.probes.using.grid.probes(),
        )
        // The air's froxels, lit as the scene will be, before the passes that look through them.
        if Q::FOG {
            match scene.fog(self.origin) {
                Some(field) => self.fog.make(
                    cam,
                    self.light,
                    field,
                    sh,
                    self.near.front,
                    self.far.front,
                    self.cmp,
                    self.clouds,
                    self.sky.shadow,
                    grid,
                    maps,
                    grounds,
                    self.probes.using.density,
                    self.linear,
                ),
                None => self.fog.clear(),
            }
        }
        // Whether glossy surfaces reflect the screen: last frame's (`Mirror`), and this frame's
        // copied for the next.
        let mirrored = Q::REFLECTIONS || Q::CONTACT
        let lt = Lighting::<Q, Y> {
            cam,
            light: self.light,
            shadows: sh,
            grid,
            clouds: self.clouds,
            levels: self.clipmap.levels(),
            near: self.near.front,
            far: self.far.front,
            moving: self.moving,
            cmp: self.cmp,
            probes: maps,
            grounds,
            seen: self.probes.using.seen.items(),
            cloud: self.sky.shadow,
            air: self.tables.aerial,
            ambient: self.ambient.at,
            ao: self.ambient.last,
            froxels: self.lights.at,
            lights: self.lights.words.items(),
            mirror: Mirror {
                on: if mirrored { self.mirror.on } else { 0 },
                reflect: if Q::REFLECTIONS { 1 } else { 0 },
                probe: if Q::REFLECTIONS && self.specular.baked { 1 } else { 0 },
                contact: if Q::CONTACT { 1 } else { 0 },
                ..self.mirror,
            },
            screen: self.screen,
            spec: self.specular.cube,
            s: self.linear,
            distance: self.distance.read(),
            volume: self.distance.volume,
            fog: self.fog.grid,
            fogged: self.fog.lit,
        }
        // Last frame's pyramid, if it's this view's (not after a jump, nor with occlusion off).
        var hzb = self.pyramid.at
        if !Q::OCCLUSION || self.jumped || !scene.reveals() {
            hzb.on = 0
        }
        phase("choose")
        scene.choose(lt, texels, self.pyramid.depth, hzb)
        phase("passes")
        label("vegetation prepass")
        let pre = begin_pass_with_depth(
            mut self.targets.ids,
            mut self.targets.depth,
            clear: vec4(0.0),
            clear_depth: 0.0,
        )
        scene.prepass(pre, cam, wind, self.linear)
        pre.end()
        scene.after_prepass(mut self.targets, cam, wind, self.linear)
        label("vegetation")
        let veg = begin_pass_with_depth(
            mut self.targets.scene,
            mut self.targets.depth,
            clear: vec4(0.0),
            keep_depth: true,
        )
        scene.shade(veg, lt, wind, self.targets.ids)
        veg.end()
        let terrain = self.on(Off::Terrain)
        label("terrain")
        let ter = begin_pass_with_depth(
            mut self.targets.scene,
            mut self.targets.depth,
            keep: true,
            keep_depth: true,
        )
        if terrain {
            draw_multi(
                ter,
                ground.bind(cam, lt.levels, texels),
                ground_shade.bind(
                    lt,
                    texels,
                    litter: self.clipmap.details.litter,
                    soil: self.clipmap.details.soil,
                    rock: self.clipmap.details.rock,
                    moss: self.clipmap.details.moss,
                    ds: self.clipmap.details.s,
                ),
                indices: self.clipmap.indices(),
                indirect: self.clipmap.sides_args(),
                count: lt.levels.count * SIDES,
                depth: NEAREST,
            )
        }
        ter.end()
        label("creature")
        let cr = begin_pass_with_depth(
            mut self.targets.scene,
            mut self.targets.depth,
            keep: true,
            keep_depth: true,
            join: true,
        )
        scene.characters(cr, lt)
        cr.end()
        // The second phase (`cull`): this frame's pyramid from the opaque passes' depth, what the
        // first phase left out tested against it, and what it reveals drawn now.
        let late = Q::OCCLUSION && scene.reveals()
        if late {
            label("occlusion")
            self.pyramid.build(self.targets.depth, cam)
            scene.reveal(self.pyramid.depth, self.pyramid.at)
            label("vegetation late")
            let lp = begin_pass_with_depth(
                mut self.targets.ids,
                mut self.targets.depth,
                keep: true,
                keep_depth: true,
            )
            scene.late_prepass(lp, cam, wind, self.linear)
            lp.end()
            let ls = begin_pass_with_depth(
                mut self.targets.scene,
                mut self.targets.depth,
                keep: true,
                keep_depth: true,
            )
            scene.late_shade(ls, lt, wind, self.targets.ids)
            ls.end()
        } else {
            self.pyramid.at.on = 0
        }
        // The sky joins the pass before it (the creature pass, or the late shading), where nothing
        // was drawn (its depth doesn't change).
        label("sky")
        let sky = begin_pass_with_depth(
            mut self.targets.scene,
            mut self.targets.depth,
            keep: true,
            keep_depth: true,
            join: true,
        )
        if scene.sky_instead(sky) {} else if Q::FOG {
            draw(
                sky,
                full.bind(z: 0.0),
                sky_fogged.bind(
                    cam,
                    self.light,
                    view: self.tables.view,
                    dome: self.sky.dome,
                    s: self.linear,
                    fog: self.fog.grid,
                    fogged: self.fog.lit,
                ),
                vertices: 3,
                depth: BEHIND,
            )
        } else {
            draw(
                sky,
                full.bind(z: 0.0),
                sky_shade.bind(
                    cam,
                    self.light,
                    view: self.tables.view,
                    dome: self.sky.dome,
                    s: self.linear,
                ),
                vertices: 3,
                depth: BEHIND,
            )
        }
        sky.end()
        // The ambient occlusion from this frame's opaque depth (the sky's leaves it as it was),
        // for the next frame's shading (its slices still in plain rendering, which has no history
        // to gather them); or the radiance cascades' light, in its place.
        let still = Camera { frame: if self.debug.plain { 0 } else { cam.frame }, ..cam }
        let built = if Q::CASCADES {
            match mut self.cascades {
                Some(c) => {
                    self.ambient.next_at = c.build(
                        mut self.ambient.next,
                        self.targets.depth,
                        still,
                        lt,
                        self.tables.view,
                        self.sky.dome,
                    )
                    true
                },
                None => false,
            }
        } else { false }
        if !built && Q::AMBIENT {
            label("ambient occlusion")
            self.ambient.next_at = ambient::build::<Q>(
                mut self.ambient.next,
                self.targets.depth,
                still,
                self.distance.read(),
                self.distance.volume,
            )
        }
        let fx = Effects::<Q, Y> {
            lt,
            view: self.tables.view,
            dome: self.sky.dome,
            sh,
            wind,
            time: self.time,
        }
        scene.effects(mut self.targets, fx)
        // The see-through matter, over the scene drawn so far (`particles`): the particles the
        // scene emits moved and sorted; dithered veils into the scene; or the veils (weighted)
        // and the particles into their targets, and laid over the scene.
        self.emits.list.clear()
        scene.emit(mut self.emits)
        if self.particles.is_none() && !self.emits.list.is_empty() {
            self.particles = Some(Particles::new())
        }
        let st = Step {
            cam,
            gravity: vec3(0.0, -9.81, 0.0),
            dt: self.cooks.dt,
            wind: wind_of(wind),
            collide: 1,
            shift: self.particle_shift,
        }
        match mut self.particles {
            Some(ps) => ps.step(st, self.targets.depth, self.emits.list),
            _ => {},
        }
        self.particle_shift = vec3(0.0)
        let veils = scene.has_veils()
        let weighted = self.quality.transparency == Transparency::Weighted
        if veils && !weighted {
            label("veils")
            let vp = begin_pass_with_depth(
                mut self.targets.scene,
                mut self.targets.depth,
                keep: true,
                keep_depth: true,
            )
            scene.veils(vp, lt, weighted: false)
            vp.end()
        }
        // The weighted veils and the particles are drawn see-through (`SeeThrough`).
        let weighted_veils = veils && weighted
        let see_through = self.particles.is_some() || weighted_veils
        let (w, h) = (self.targets.scene.width(), self.targets.scene.height())
        if see_through && self.see_through.is_none() {
            self.see_through = Some(SeeThrough::new(w, h))
        }
        match mut self.see_through {
            Some(t) if see_through => {
                label("see-through")
                // The veils' targets cleared for this frame's, or once when there are none, which
                // they then keep.
                if weighted_veils || !t.empty {
                    begin_pass(mut t.accum, clear: vec4(0.0)).end()
                    begin_pass(mut t.reveal, clear: vec4(1.0)).end()
                    t.empty = true
                }
                if weighted_veils {
                    t.empty = false
                    let vp = begin_pass2_with_depth(
                        mut t.accum,
                        mut t.reveal,
                        mut self.targets.depth,
                        keep: true,
                        keep_depth: true,
                    )
                    scene.veils(vp, lt, weighted: true)
                    vp.end()
                }
                match mut self.particles {
                    Some(ps) => ps.light(lt),
                    None => {},
                }
                let width = t.parts.width()
                let pp = begin_pass(mut t.parts, clear: vec4(0.0))
                match self.particles {
                    Some(ps) => ps.draw(pp, cam, self.targets.depth, target_width: width),
                    None => {},
                }
                pp.end()
                let cp = begin_pass(mut self.targets.scene_b)
                fullscreen(
                    cp,
                    composite.bind(
                        scene: self.targets.scene,
                        accum: t.accum,
                        reveal: t.reveal,
                        parts: t.parts,
                        s: self.linear,
                    ),
                )
                cp.end()
                swap(mut self.targets.scene, mut self.targets.scene_b)
            },
            _ => {},
        }
        // What the next frame's glossy surfaces reflect from the screen: this frame's scene
        // after its effects, and each pixel's distance.
        if mirrored {
            label("reflections copy")
            let rp = begin_pass(mut self.screen)
            fullscreen(
                rp,
                copy_below.bind(scene: self.targets.scene, depth: self.targets.depth, cam: cam),
            )
            rp.end()
            self.mirror = Mirror { cam, on: 1, probe: 0 }
        }
        // What moved, over the older motion target: the last frame's is kept.
        label("motion")
        swap(mut self.targets.motion, mut self.targets.last_motion)
        let mo = begin_pass_with_depth(
            mut self.targets.motion,
            mut self.targets.depth,
            clear: vec4(0.0),
            keep_depth: true,
        )
        scene.motion(mo, cam, wind)
        mo.end()
    }

    /// Temporal AA up to the output, then the look's passes to the screen (or an arrival's
    /// cover, plain rendering, or a scene's own view).
    fn finish<S: Scene>(mut self, scene: S) {
        phase("finish")
        let cam = self.cam
        let out = vec2(f32(self.width), f32(self.height))
        // An arrival's first frame under the new eye's light: temporal AA's history starts again.
        let again = self.ready.arriving && self.ready.gathered == 1
        let fresh = self.frames == 0 || self.debug.plain || again || !self.on(Off::History)
        let r = Resolve {
            cam,
            out,
            blend: self.quality.blend,
            fresh: if fresh { 1 } else { 0 },
            unclipped: if self.debug.ghost { 1 } else { 0 },
            jitter: jitter_of(cam.frame, cam.grid != 0, cells: max(cam.grid, 1)),
            last_jitter: jitter_of(max(cam.frame, 1) - 1, cam.grid != 0, cells: max(cam.grid, 1)),
            moving: scene.moves_in(cam, out),
            settled: if again { 0.0 } else { f32(self.settled) },
            learned: if Q::LEARNED && self.rejects { 1 } else { 0 },
        }
        self.settled = if !held(cam) { 0 } else if again { 1 } else { self.settled + 1 }
        let instead = scene.shows_instead()
        // The lines, on the scene's own samples, so temporal AA anti-aliases them (none in the
        // debug views of form).
        if !self.debug.plain && self.debug.view == 0 && !instead {
            label("lines")
            let d = Develop { cam, look: self.look, out, view: 0 }
            let lp = begin_pass(mut self.targets.scene_b)
            fullscreen(lp, lines.bind(d, self.targets.scene, self.targets.depth))
            lp.end()
            swap(mut self.targets.scene, mut self.targets.scene_b)
        }
        label("temporal")
        swap(mut self.targets.history, mut self.targets.last_history)
        self.resolver.resolve::<Q>(
            mut self.targets.history,
            r,
            self.targets.scene,
            self.targets.depth,
            self.targets.last_depth,
            self.targets.motion,
            self.targets.last_motion,
            self.targets.last_history,
            self.linear,
            self.rejector.items(),
        )
        match mut self.found {
            Some((pixels, rows)) => {
                dispatch(
                    found_rows.bind(
                        r,
                        self.targets.scene,
                        self.targets.depth,
                        self.targets.last_depth,
                        self.targets.motion,
                        self.targets.last_motion,
                        self.targets.last_history,
                        self.linear,
                        self.rejector.items(),
                        pixels.items(),
                        out: mut rows,
                    ),
                    over: pixels.len(),
                )
            },
            None => {},
        }
        label("look")
        // (While arriving, the exposure is metered afresh each frame: the eye arrives adapted.)
        let m = Metering { fresh: if self.frames == 0 || self.ready.arriving { 1 } else {
            0
        }, ..self.metering }
        dispatch(meter.bind(self.targets.scene, m, exposure: mut self.exposure), groups: 1)
        if self.ready.arriving {
            let a = self.quality.arrival
            let gather = if self.debug.capture { a.still_frames - 1 } else { a.gather }
            if self.ready.gathered > gather {
                self.ready.arriving = false
                if self.debug.capture {
                    print(f"still at frame {self.frames}")
                }
            } else {
                let black = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
                black.present()
                return
            }
        }
        let e = self.exposure.items()
        if instead || self.debug.plain {
            let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
            scene.show_instead(screen, self.targets, e)
            screen.present()
            return
        }
        // The screen HDR where the look asks for it, once (the host swaps it in when it can).
        if self.look.output == 1 && !self.asked_hdr {
            std::gpu::screen(hdr: true, gamut: std::gpu::Gamut::DisplayP3)
            self.asked_hdr = true
        }
        let hdr = self.look.output == 1 && std::gpu::screen_is().hdr
        let d = Develop { cam, look: self.look, out, view: self.debug.view, hdr: u32(hdr) }
        // The dabs into the texture the water's copy held (done with by now).
        let dp = begin_pass(mut self.targets.below)
        fullscreen(
            dp,
            dab_map.bind(
                cam,
                look: d.look,
                out: d.out,
                levels: self.clipmap.levels(),
                texels: self.clipmap.texels(),
                scene: self.targets.scene,
                depth: self.targets.depth,
            ),
        )
        dp.end()
        // The bloom: down its pyramid from temporal AA's output (the first level the light
        // above the threshold), then back up it, each level adding its light to the one above.
        label("bloom")
        let base = self.metering.base
        borrow s = self.linear
        // Its levels at least `BLOOM_NARROWEST` wide (a phone's narrowest are a few texels: blur
        // the levels above already give); the top level's up-sample of the one under it is the
        // develop's (`paint::develop`'s `below`), not a pass of its own.
        let levels = bloom_levels(self.width)
        bloom_level(
            mut self.targets.bloom_1,
            self.targets.history,
            s,
            first: true,
            base: base,
            exposure: e,
        )
        if levels > 1 {
            bloom_level(
                mut self.targets.bloom_2,
                self.targets.bloom_1,
                s,
                first: false,
                base: base,
                exposure: e,
            )
        }
        if levels > 2 {
            bloom_level(
                mut self.targets.bloom_3,
                self.targets.bloom_2,
                s,
                first: false,
                base: base,
                exposure: e,
            )
        }
        if levels > 3 {
            bloom_level(
                mut self.targets.bloom_4,
                self.targets.bloom_3,
                s,
                first: false,
                base: base,
                exposure: e,
            )
            bloom_add(mut self.targets.bloom_3, self.targets.bloom_4, s)
        }
        if levels > 2 {
            bloom_add(mut self.targets.bloom_2, self.targets.bloom_3, s)
        }
        phase("present")
        let screen = begin_screen_pass(clear: vec4(0.0, 0.0, 0.0, 1.0))
        fullscreen(
            screen,
            develop::<Y>.bind(
                d,
                self.targets.history,
                self.targets.depth,
                glow: self.targets.bloom_1,
                below: self.targets.bloom_2,
                levels: levels,
                dabs: self.targets.below,
                lut: self.grade,
                s: self.linear,
                exposure: e,
            ),
        )
        scene.overlay(screen, out)
        screen.present()
    }
}

/// A strip of `kept` drawn: the scene's casters in its part of the square (chosen first), and on
/// its first strip the ground where it casts; after the last, the maps swap.
fn strip_of<S: Scene>(
    kept: mut Kept,
    scene: mut S,
    clipmap: Clipmap,
    sun: vec3,
    sh: Shadows,
    wind: Wind,
    s: Sampler,
    cam: Camera,
    on: bool,
) {
    let Some(strip) = kept.strip(sun) else { return }
    if on {
        scene.choose_casters(cam, strip.lo, strip.hi)
    }
    let pass = begin_depth_pass(mut kept.back, clear_depth: 1.0, keep_depth: !strip.first)
    if on {
        scene.cast(pass, strip.view, sh, wind, s, strip.first)
        if strip.first && scene.ground_casts() {
            clipmap.cast(pass, strip.view)
        }
    }
    pass.end()
    kept.drawn()
}

// ---- tests ---------------------------------------------------------------------------------

/// Arrival resolves only consecutive lit frames: no timeout makes an unlit arrival visible, and a
/// frame that isn't lit (a late tile, a cache replaced) starts the count again.
@test
fn an_arrival_waits_for_complete_frames_without_a_timeout() {
    var gathered = 0
    for _ in 0..600 {
        gathered = arrival_gathered(gathered, lit: false)
        assert(gathered == 0, "an unready arrival was forced visible by elapsed frames")
    }
    let gather = Arrival {}.gather
    for _ in 0..gather {
        gathered = arrival_gathered(gathered, lit: true)
    }
    assert(gathered == gather, "lit frames did not gather")
    gathered = arrival_gathered(gathered, lit: false)
    assert(gathered == 0, "a later cache update retained an earlier lit count")
}
