// The painterly look's panels (scenes/, `--set PANEL=<n>`), each built, drawn two frames on the
// hardware GPU at 256 × 256 and its screen read (RGBA8, rows top to bottom).

use hosts::both::bytes_of
use hosts::steps::built
use std::io::print
use std::tool::drive
use std::tool::drive::Step
use std::tool::toolchain
use std::tool::toolchain::{Override, Set}

const SIDE: u32 = 256
/// The look's strokes' length where the tone is flat (`styles::painterly::STROKE_PX`).
const STROKE_PX: f32 = 24.0

/// Panel `panel`'s screen.
fn screen(panel: u32) -> Vec<u8> {
    let out = f"scratch/panel{panel}"
    var options = toolchain::options()
    options.overrides = Vec::from(
        [
            Override { name: String::from("engine"), dir: String::from("repo/engine") },
            Override { name: String::from("styles"), dir: String::from("repo/content/styles") },
        ],
    )
    options.set = Vec::from([Set { name: String::from("PANEL"), value: String::from(f"{panel}") }])
    built("repo/engine/tests/style-painterly/scenes", out.as_str(), options, "the panel builds")
    var load = drive::gpu()
    load.width = SIDE
    load.height = SIDE
    let steps = [Step::Init, Step::FrameAt(0.0), Step::FrameAt(0.016), Step::Capture]
    let Ok(seen) = drive::run(out.as_str(), load, steps).wait() else { panic("it draws on a GPU") }
    if let Some(trap) = seen.trap {
        panic(trap.message.as_str())
    }
    bytes_of(seen.captures[0].rgba.clone())
}

/// On a sphere, the strokes run along its latitude or its longitude within 15°: of its pixels
/// away from the poles (where the latitude is the shape's fallback direction) and its rim, at
/// least 95 %. A sphere curves alike every way, so its shape's direction is the fallback's
/// (`substance::principal`'s `UMBILIC`), not the noise in its curvatures'.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn a_spheres_strokes_follow_its_latitude_or_longitude() {
    let px = screen(0)
    var counted = 0
    var within = 0
    for y in 0..SIDE {
        for x in 0..SIDE {
            // The sphere's pixels, and their neighbours two pixels each way too (off its rim, the
            // shape's half-size texels span the sky).
            var inside = true
            for (dx, dy) in [(0, 0), (2, 0), (-2, 0), (0, 2), (0, -2)] {
                let (qx, qy) = (i32(x) + dx, i32(y) + dy)
                if qx < 0 || qy < 0 || qx >= i32(SIDE) || qy >= i32(SIDE) {
                    inside = false
                } else if px[4 * (u32(qy) * SIDE + u32(qx)) + 2] < 128 {
                    inside = false
                }
            }
            let at = 4 * (y * SIDE + x)
            if inside && px[at + 1] >= 128 {
                counted += 1
                if px[at] >= 128 {
                    within += 1
                }
            }
        }
    }
    print(
        f"the sphere: {within} of {counted} pixels' strokes within 15° of its latitude or longitude",
    )
    assert(counted > 10000, f"only {counted} pixels counted")
    assert(f32(within) >= 0.95 * f32(counted), f"{counted - within} of {counted} off")
}

/// On a flat plane the strokes are `STROKE_PX` long within 10 %, where the stroke lattice's
/// spacing is `STROKE_PX` (across an octave its two lattices blend, their mean spacing within
/// 6 % of it: engine/tests/marks): the longest runs of one shade along their direction (the
/// screen's rows), the top tenth of them, through a stroke's middle; and hardly any longer.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn a_planes_strokes_are_their_length() {
    let px = screen(1)
    // The plane's grey, the most common shade.
    var counts: [u32; 256] = [0; 256]
    for i in 0..(SIDE * SIDE) {
        counts[u32(px[4 * i])] += 1
    }
    var base = 0
    for v in 0..256 {
        if counts[v] > counts[base] {
            base = v
        }
    }
    // The runs of one shade at least 2 off the grey, along each row, but those cut by the edge.
    var runs: Vec<u32> = Vec::new()
    for y in 0..SIDE {
        var run = 0
        var last = 999
        for x in 0..SIDE {
            let v = u32(px[4 * (y * SIDE + x)])
            let off = if v > base { v - base } else { base - v }
            if off >= 2 && v == last {
                run += 1
            } else {
                if run >= 4 && x > run {
                    runs.push(run)
                }
                run = if off >= 2 { 1 } else { 0 }
            }
            last = v
        }
    }
    runs.sort_by(|a: u32, b: u32| a < b)
    assert(runs.len() > 100, f"only {runs.len()} strokes' runs")
    // Two strokes end to end whose seeds give them one shade read as one run (`STROKE_VARY`'s
    // 0.04 leaves few shades): at most a hundredth of the runs may be longer than a stroke.
    let long = f32(runs[runs.len() * 9 / 10])
    var over = 0
    for r in runs.clone() {
        if f32(r) > 1.1 * STROKE_PX {
            over += 1
        }
    }
    print(
        f"the plane: {runs.len()} runs; the top tenth's shortest {long} px, {over} longer than {1.1 * STROKE_PX} px",
    )
    assert(
        long >= 0.9 * STROKE_PX && over * 100 <= runs.len(),
        f"the top tenth from {long} px, {over} of {runs.len()} past a stroke",
    )
}
