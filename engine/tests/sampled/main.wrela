// A sphere and a box sampled every 4 cm into a sampled shape's bricks on the CPU (the tables a
// tool writes for a sculpt), uploaded, and realized through `engine::sampled`: each of the
// sphere's vertices lies on it within 1.5 mm, its normal points outward and isn't split (a curve
// has no creases), and no quad is missing a vertex; the box's edges stay sharp, every vertex
// facing as one of its faces does. The vertices are read back once the tallies are in.

use engine::realize::{BLOCK, Mesh, SkinVertex, Tally}
use engine::sampled::{
    BLOCK_WORDS, INSIDE, Lattice, OUTSIDE, STORED, Samples, realize_sampled, words_of,
}
use std::gpu::read
use std::io::{Pending, print}

const CENTRE: vec3 = vec3(0.1, 0.2, -0.05)
const RADIUS: f32 = 0.47
const CELL: f32 = 0.04
const BAND: f32 = 0.12
/// Blocks along each axis: 1.28 m a side from the origin.
const SIZE: u32 = 8
const ORIGIN: vec3 = vec3(-0.54, -0.44, -0.69)

fn distance(p: vec3) -> f32 {
    length(p - CENTRE) - RADIUS
}

/// The box's half size: its faces cross the cells, off the lattice's planes.
const HALF: f32 = 0.3

fn box_distance(p: vec3) -> f32 {
    let a = abs(p - CENTRE) - vec3(HALF)
    length(max(a, vec3(0.0))) + min(max(a.x, max(a.y, a.z)), 0.0)
}

/// The sphere's distance, or the box's.
fn shape_distance(p: vec3, boxed: bool) -> f32 {
    if boxed { box_distance(p) } else { distance(p) }
}

/// The byte a distance is stored as.
fn byte(d: f32) -> u32 {
    u32(round((clamp(d, -BAND, BAND) / BAND * 0.5 + 0.5) * 255.0))
}

/// The sphere's mesh and the box's, their tallies and vertices as they come back.
pub struct State {
    meshes: Vec<Mesh>,
    tallies: Vec<Pending<Tally>>,
    pub counted: Vec<Tally>,
    asked: Vec<Pending<SkinVertex>>,
    pub read: Vec<Vec<SkinVertex>>,
}

/// The sphere's tables, as a tool would write them.
fn sphere() -> Samples {
    tables(false)
}

/// The sphere's tables or the box's.
fn tables(boxed: bool) -> Samples {
    var slots: Vec<u32> = Vec::new()
    var words: Vec<u32> = Vec::new()
    for bz in 0..SIZE {
        for by in 0..SIZE {
            for bx in 0..SIZE {
                // The block's 125 samples, x slowest; stored unless all are past the band.
                var bytes = [0; 128]
                var lo = 255
                var hi = 0
                for i in 0..125 {
                    let c = vec3u(i / 25, (i / 5) % 5, i % 5)
                    let p = ORIGIN + (vec3(vec3u(bx, by, bz) * BLOCK + c)) * CELL
                    let b = byte(shape_distance(p, boxed))
                    bytes[i] = b
                    lo = min(lo, b)
                    hi = max(hi, b)
                }
                if lo == 255 {
                    slots.push(OUTSIDE)
                } else if hi == 0 {
                    slots.push(INSIDE)
                } else {
                    slots.push(STORED + words.len() / BLOCK_WORDS)
                    for w in 0..BLOCK_WORDS {
                        let k = 4 * w
                        words.push(
                            bytes[k] |
                                (bytes[k + 1] << 8) |
                                (bytes[k + 2] << 16) |
                                (bytes[k + 3] << 24),
                        )
                    }
                }
            }
        }
    }
    let lattice = Lattice {
        origin: ORIGIN,
        cell: CELL,
        size: vec3u(SIZE),
        band: BAND,
        bone: 0,
    }
    Samples { lattice, slots, words }
}

pub fn init() -> State {
    var meshes: Vec<Mesh> = Vec::new()
    var tallies: Vec<Pending<Tally>> = Vec::new()
    for boxed in [false, true] {
        let mesh = realize_sampled(tables(boxed).upload())
        tallies.push(read(mesh.tally.items()))
        meshes.push(take mesh)
    }
    State { meshes, tallies, counted: Vec::new(), asked: Vec::new(), read: Vec::new() }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if s.counted.len() < s.tallies.len() {
        let k = s.counted.len()
        if let Some(Ok(t)) = s.tallies[k].poll() {
            s.counted.push(t[0])
            s.asked.push(read(s.meshes[k].verts.items()))
        }
        return
    }
    if s.read.len() < s.asked.len() {
        let k = s.read.len()
        if let Some(Ok(v)) = s.asked[k].poll() {
            s.read.push(Vec::from(v))
        }
    }
}

@test(frames: 30, gpu: true)
fn a_sampled_sphere_is_the_sphere(s: State) {
    assert(s.counted.len() == 2, "the tallies came back")
    let t = s.counted[0]
    print(
        f"{t.vertices} vertices, {t.pushed_quads} quads, {t.live_blocks} live blocks, {t.holes} holes",
    )
    assert(t.vertices > 1000, "the sphere has its vertices")
    assert(t.holes == 0, "no quad is missing a vertex")
    assert(t.flags == 0, "the mesh had room")
    assert(s.read.len() == 2, "the vertices came back")
    var worst = 0.0
    var inward = 0
    var bent = 1.0
    for i in 0..t.vertices {
        let v = s.read[0][i]
        worst = max(worst, abs(distance(v.pos)))
        if dot(v.normal, v.pos - CENTRE) <= 0.0 {
            inward += 1
        }
        bent = min(bent, dot(v.normal, normalize(v.pos - CENTRE)))
    }
    print(
        f"farthest from the sphere: {worst * 1000.0} mm; {inward} normals inward; least cos {bent}",
    )
    assert(worst < 1.5e-3, "every vertex on the sphere within 1.5 mm")
    assert(inward == 0, "every normal outward")
    assert(bent > 0.97, "every normal within 14 degrees of the sphere's")
}

/// The box's edges and corners stay sharp: every vertex, the ones on its edges too, faces as one
/// of the faces it lies on, so each face shades flat to its edges.
@test(frames: 30, gpu: true)
fn a_sampled_box_keeps_its_edges(s: State) {
    assert(s.read.len() == 2, "the vertices came back")
    let t = s.counted[1]
    print(f"box: {t.vertices} vertices, {t.pushed_quads} quads, {t.holes} holes")
    assert(t.holes == 0 && t.flags == 0, "whole, with room")
    var off = 0
    for i in 0..t.vertices {
        let v = s.read[1][i]
        let n = abs(v.normal)
        if max(n.x, max(n.y, n.z)) < 0.97 {
            off += 1
        }
    }
    print(f"{off} of {t.vertices} vertices face no face")
    assert(off * 50 < t.vertices, "all but 2% of its vertices face as a face does")
}

/// A table's text comes back as its words: bytes 1 to 8, then 9 alone (its padding skipped).
@test
fn base64_text_comes_back_as_words() {
    let w = words_of(["AQIDBA", "UGBwgJ"])
    assert(w.len() == 3, "three words")
    assert(w[0] == 0x04030201 && w[1] == 0x08070605 && w[2] == 9, "little-endian, in order")
}

/// On the CPU the tables give the sphere's distance near it, within a millimetre and a half, and
/// past the band, the band.
@test
fn a_sampled_sphere_answers_its_distance() {
    let s = sphere()
    var worst = 0.0
    for i in 0..200 {
        let a = f32(i) * 0.7
        let dir = normalize(vec3(sin(a * 1.3), cos(a * 0.9), sin(a * 2.1 + 0.4)))
        let p = CENTRE + dir * (RADIUS + (f32(i % 9) - 4.0) * 0.01)
        worst = max(worst, abs(s.distance(p) - distance(p)))
    }
    print(f"worst near the surface: {worst * 1000.0} mm")
    assert(worst < 1.5e-3, "near the surface, the sphere's distance")
    assert(s.distance(CENTRE) == -BAND, "deep inside, the band below 0")
    assert(s.distance(vec3(5.0, 0.0, 0.0)) > BAND, "past the lattice, more than the band")
}
