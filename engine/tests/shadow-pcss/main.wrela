// Percentage-closer soft shadows in the static cascades (`engine::shadow::Shadows::soft_pcss`):
// a blocker's edge over a receiver, the blocker near the receiver (a quad just over a plane) and
// far above it (a quad high over it), its light read across the edge through the production
// lookup and read back. The higher blocker's penumbra is wider; with `soft_pcss` 0 both are the
// same few texels.
//
// The near map's view is the identity (a point's x and y are its place on the map, its z its
// depth): its texels left of the middle hold the blocker, high in the top half and low in the
// bottom, the rest clear.
//
// And the cascades' seam (§G4): a second map holding an edge along x (a blocker 4 m over the
// receivers below the middle), read as the near map (the identity) and as the far (the same
// texels over twice the span), along the edge from inside the near map out past it, through the
// band where the near map fades into the far.

use engine::frame::full
use engine::shadow::{Cascade, Shadows, shadows, statically_sunlit}
use std::gpu::{
    Compare, ComparisonSampler, Depth, DepthTexture, FragCoord, GlobalId, GpuBuffer, Slots,
    WithDepth, begin_depth_pass, buffer, comparison_sampler, depth_texture, draw, read,
}
use std::io::{Pending, print}

/// The map's texels a side, its depth's span (m) and its texel (m); the receivers' depth.
const SIDE: u32 = 512
const SPAN: f32 = 500.0
const TEXEL: f32 = 0.01
const RECEIVER: f32 = 0.5

/// The depth `m` metres over the receivers.
fn over(m: f32) -> f32 {
    RECEIVER - m / SPAN
}

/// The blocker: left of the map's middle, 16 m over the receivers in its top half, 1 m in its
/// bottom.
@fragment
fn blocker(p: FragCoord) -> WithDepth<vec4> {
    let t = vec2u(p.position.xy)
    let d = if t.x >= SIDE / 2 { 1.0 } else if t.y < SIDE / 2 { over(16.0) } else { over(1.0) }
    WithDepth { color: vec4(0.0), depth: d }
}

/// How many receivers a row reads, a texel apart across the map's middle.
const ACROSS: u32 = 128

/// The seam's map: a blocker 4 m over the receivers below its middle.
@fragment
fn ledge(p: FragCoord) -> WithDepth<vec4> {
    let t = vec2u(p.position.xy)
    WithDepth { color: vec4(0.0), depth: if t.y >= SIDE / 2 { over(4.0) } else { 1.0 } }
}

/// How many receivers the seam's row reads: near-clip x from 0.5 to 1.1, a quarter texel apart.
const ALONG: u32 = 768

/// Receiver `id.x` along the seam's edge: its light.
@compute(64)
fn along(
    sh: Shadows,
    map: DepthTexture,
    cmp: ComparisonSampler,
    out: mut Slots<f32>,
    id: GlobalId,
) {
    if id.x >= ALONG {
        return
    }
    let x = 0.5 + (f32(id.x) + 0.5) / f32(ALONG) * 0.6
    out[id] = statically_sunlit(sh, vec3(x, 0.0, RECEIVER), vec3(0.0), map, map, cmp, 1.5)
}

/// Receiver `id.x` of row `id.y` (0: under the high blocker, 1: under the low): its light.
@compute(64)
fn across(
    sh: Shadows,
    map: DepthTexture,
    cmp: ComparisonSampler,
    out: mut Slots<f32>,
    id: GlobalId,
) {
    if id.x >= ACROSS || id.y >= 2 {
        return
    }
    // Clip x from -0.25 to 0.25: texels 192 to 320, the edge at 256.
    let x = (f32(id.x) + 0.5) / f32(ACROSS) * 0.5 - 0.25
    let y = if id.y == 0 { 0.25 } else { -0.25 }
    out[id] = statically_sunlit(sh, vec3(x, y, RECEIVER), vec3(0.0), map, map, cmp, 1.5)
}

pub struct State {
    asked: Vec<Pending<f32>>,
    pub got: Vec<Vec<f32>>,
}

pub fn init() -> State {
    State { asked: Vec::new(), got: Vec::new() }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if s.asked.is_empty() {
        var map = depth_texture(width: SIDE, height: SIDE)
        let p = begin_depth_pass(mut map, clear_depth: 1.0)
        draw(
            p,
            full.bind(z: 0.5),
            blocker,
            vertices: 3,
            depth: Depth { compare: Compare::Always, write: true },
        )
        p.end()
        let identity = mat4(
            vec4(1.0, 0.0, 0.0, 0.0),
            vec4(0.0, 1.0, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(0.0, 0.0, 0.0, 1.0),
        )
        let cascade = Cascade {
            centre: vec3(0.0),
            span: TEXEL * f32(SIDE),
            reach: 250.0,
            side: SIDE,
        }
        let base = Shadows {
            near: identity,
            far: identity,
            near_depth: SPAN,
            ..shadows(
                normalize(vec3(1.0, 1.0, 1.0)),
                cascade,
                cascade,
                moving_at: vec3(1000.0),
                moving_span: 10.0,
                moving_side: 64,
            ),
        }
        let cmp = comparison_sampler()
        for pcss in [0, 1] {
            let sh = Shadows { soft_pcss: pcss, ..base }
            var out: GpuBuffer<f32> = buffer(2 * ACROSS)
            std::gpu::dispatch(across.bind(sh, map, cmp, out: mut out), over: (ACROSS, 2))
            s.asked.push(read(out.items()))
        }
        // The seam: the near map the identity, the far the same texels over twice the span.
        var edge = depth_texture(width: SIDE, height: SIDE)
        let q = begin_depth_pass(mut edge, clear_depth: 1.0)
        draw(
            q,
            full.bind(z: 0.5),
            ledge,
            vertices: 3,
            depth: Depth { compare: Compare::Always, write: true },
        )
        q.end()
        let half = mat4(
            vec4(0.5, 0.0, 0.0, 0.0),
            vec4(0.0, 0.5, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(0.0, 0.0, 0.0, 1.0),
        )
        let seam = Shadows {
            far: half,
            far_texel: 2.0 * TEXEL,
            texel_uv: vec3(1.0 / f32(SIDE)),
            soft_pcss: 1,
            ..base,
        }
        var row: GpuBuffer<f32> = buffer(ALONG)
        std::gpu::dispatch(along.bind(seam, edge, cmp, out: mut row), over: (ALONG, 1))
        s.asked.push(read(row.items()))
        return
    }
    while s.got.len() < s.asked.len() {
        let k = s.got.len()
        match s.asked[k].poll() {
            Some(Ok(v)) => s.got.push(take v),
            _ => return,
        }
    }
}

/// The 10–90% transition's width along a row of `ACROSS` receivers (a texel apart), from dark
/// to lit.
fn penumbra(row: [f32]) -> u32 {
    var first = ACROSS
    var last = 0
    for i in 0..ACROSS {
        if row[i] > 0.1 && first == ACROSS {
            first = i
        }
        if row[i] < 0.9 {
            last = i
        }
    }
    if last >= first { last - first + 1 } else { 0 }
}

/// With `soft_pcss` 1 a blocker 16 m over its receiver casts a wider penumbra than one 1 m over it; with
/// `soft_pcss` 0 both penumbrae are the filter's few texels.
@test(frames: 8, gpu: true)
fn a_higher_blocker_casts_a_wider_penumbra(s: State) {
    assert(s.got.len() == 3, f"{s.got.len()} reads came back")
    let row = |k: u32, r: u32| {
        var out: Vec<f32> = Vec::new()
        for i in 0..ACROSS {
            out.push(s.got[k][r * ACROSS + i])
        }
        take out
    }
    let (pcf_high, pcf_low) = (penumbra(row(0, 0)), penumbra(row(0, 1)))
    let (high, low) = (penumbra(row(1, 0)), penumbra(row(1, 1)))
    print(f"penumbra in texels: PCF {pcf_high} high, {pcf_low} low; PCSS {high} high, {low} low")
    assert(pcf_high == pcf_low, "PCF's penumbra depends on the blocker's height")
    assert(high > low && high >= 2 * low, f"PCSS: {high} high against {low} low")
}

/// The cascades' seam shows no line (§G4): along a soft shadow's edge, from where the near map
/// holds the point alone out past where the far map does, no receiver's light is more than 1/255
/// from its neighbour's (a quarter texel apart), though the near map's penumbra and the far's
/// differ.
@test(frames: 8, gpu: true)
fn the_cascades_seam_shows_no_line(s: State) {
    assert(s.got.len() == 3, f"{s.got.len()} reads came back")
    borrow row = s.got[2]
    var most = 0.0
    var at = 0
    for i in 1..ALONG {
        let d = abs(row[i] - row[i - 1])
        if d > most {
            most = d
            at = i
        }
    }
    print(
        f"across the seam: {row[0]} near, {row[ALONG - 1]} far, the most between neighbours {most * 255.0}/255 at {at}",
    )
    assert(most <= 1.0 / 255.0, f"a line at receiver {at}: {most * 255.0}/255 from its neighbour")
}
