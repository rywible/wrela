// Percentage-closer soft shadows in the static cascades (`engine::shadow::Soft::Pcss`): a
// blocker's edge over a receiver, the blocker near the receiver (a quad just over a plane) and
// far above it (a quad high over it), its light read across the edge through the production
// lookup and read back. The higher blocker's penumbra is wider; with `Pcf` both are the same few
// texels.
//
// The near map's view is the identity (a point's x and y are its place on the map, its z its
// depth): its texels left of the middle hold the blocker, high in the top half and low in the
// bottom, the rest clear.

use engine::frame::full
use engine::shadow::{Cascade, Shadows, shadows, statically_sunlit}
use std::gpu::{
    Compare, ComparisonSampler, Depth, DepthTexture, FragCoord, GlobalId, GpuBuffer, Slots,
    WithDepth, begin_depth_pass, buffer, comparison_sampler, depth_texture, draw, read,
}
use std::io::{Pending, print}

/// The map's texels a side, its depth's span (m) and its texel (m); the receivers' depth.
const SIDE: u32 = 512
const SPAN: f32 = 500.0
const TEXEL: f32 = 0.01
const RECEIVER: f32 = 0.5

/// The depth `m` metres over the receivers.
fn over(m: f32) -> f32 {
    RECEIVER - m / SPAN
}

/// The blocker: left of the map's middle, 16 m over the receivers in its top half, 1 m in its
/// bottom.
@fragment
fn blocker(p: FragCoord) -> WithDepth<vec4> {
    let t = vec2u(p.position.xy)
    let d = if t.x >= SIDE / 2 { 1.0 } else if t.y < SIDE / 2 { over(16.0) } else { over(1.0) }
    WithDepth { color: vec4(0.0), depth: d }
}

/// How many receivers a row reads, a texel apart across the map's middle.
const ACROSS: u32 = 128

/// Receiver `id.x` of row `id.y` (0: under the high blocker, 1: under the low): its light.
@compute(64)
fn across(
    sh: Shadows,
    map: DepthTexture,
    cmp: ComparisonSampler,
    out: mut Slots<f32>,
    id: GlobalId,
) {
    if id.x >= ACROSS || id.y >= 2 {
        return
    }
    // Clip x from -0.25 to 0.25: texels 192 to 320, the edge at 256.
    let x = (f32(id.x) + 0.5) / f32(ACROSS) * 0.5 - 0.25
    let y = if id.y == 0 { 0.25 } else { -0.25 }
    out[id] = statically_sunlit(sh, vec3(x, y, RECEIVER), vec3(0.0), map, map, cmp, 1.5)
}

pub struct State {
    asked: Vec<Pending<f32>>,
    pub got: Vec<Vec<f32>>,
}

pub fn init() -> State {
    State { asked: Vec::new(), got: Vec::new() }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if s.asked.is_empty() {
        var map = depth_texture(width: SIDE, height: SIDE)
        let p = begin_depth_pass(mut map, clear_depth: 1.0)
        draw(
            p,
            full.bind(z: 0.5),
            blocker,
            vertices: 3,
            depth: Depth { compare: Compare::Always, write: true },
        )
        p.end()
        let identity = mat4(
            vec4(1.0, 0.0, 0.0, 0.0),
            vec4(0.0, 1.0, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(0.0, 0.0, 0.0, 1.0),
        )
        let cascade = Cascade {
            centre: vec3(0.0),
            span: TEXEL * f32(SIDE),
            reach: 250.0,
            side: SIDE,
        }
        let base = Shadows {
            near: identity,
            far: identity,
            near_depth: SPAN,
            ..shadows(
                normalize(vec3(1.0, 1.0, 1.0)),
                cascade,
                cascade,
                moving_at: vec3(1000.0),
                moving_span: 10.0,
                moving_side: 64,
            ),
        }
        let cmp = comparison_sampler()
        for pcss in [0, 1] {
            let sh = Shadows { soft_pcss: pcss, ..base }
            var out: GpuBuffer<f32> = buffer(2 * ACROSS)
            std::gpu::dispatch(across.bind(sh, map, cmp, out: mut out), over: (ACROSS, 2))
            s.asked.push(read(out.items()))
        }
        return
    }
    while s.got.len() < s.asked.len() {
        let k = s.got.len()
        match s.asked[k].poll() {
            Some(Ok(v)) => s.got.push(take v),
            _ => return,
        }
    }
}

/// The 10–90% transition's width along a row of `ACROSS` receivers (a texel apart), from dark
/// to lit.
fn penumbra(row: [f32]) -> u32 {
    var first = ACROSS
    var last = 0
    for i in 0..ACROSS {
        if row[i] > 0.1 && first == ACROSS {
            first = i
        }
        if row[i] < 0.9 {
            last = i
        }
    }
    if last >= first { last - first + 1 } else { 0 }
}

/// With `Pcss` a blocker 16 m over its receiver casts a wider penumbra than one 1 m over it; with
/// `Pcf` both penumbrae are the filter's few texels.
@test(frames: 8, gpu: true)
fn a_higher_blocker_casts_a_wider_penumbra(s: State) {
    assert(s.got.len() == 2, f"{s.got.len()} reads came back")
    let row = |k: u32, r: u32| {
        var out: Vec<f32> = Vec::new()
        for i in 0..ACROSS {
            out.push(s.got[k][r * ACROSS + i])
        }
        take out
    }
    let (pcf_high, pcf_low) = (penumbra(row(0, 0)), penumbra(row(0, 1)))
    let (high, low) = (penumbra(row(1, 0)), penumbra(row(1, 1)))
    print(f"penumbra in texels: PCF {pcf_high} high, {pcf_low} low; PCSS {high} high, {low} low")
    assert(pcf_high == pcf_low, "PCF's penumbra depends on the blocker's height")
    assert(high > low && high >= 2 * low, f"PCSS: {high} high against {low} low")
}
