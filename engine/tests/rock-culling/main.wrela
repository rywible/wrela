// The broad culling cone of engine::stone's rocks (`Camera::corner_tan`, the GPU's `cull_rocks` tests
// each rock's sphere with it through `in_view`) contains the camera's edges and corners, also
// with a square viewport, and drops rocks behind or well outside the view.

use engine::stone::{NEAR_RADII, in_view}
use engine::view::first_camera

/// Whether `cull_rocks` draws a rock of radius 0.25 at `at` (render space) for `cam`, and near.
fn kept(cam: engine::view::Camera, at: vec3) -> (bool, bool) {
    let sp = vec4(at, 0.25)
    let seen = in_view(sp, cam.eye, cam.forward, cam.tan_half, cam.corner_tan())
    (seen, length(at - cam.eye) < NEAR_RADII * sp.w)
}

pub fn frame(time: f32, width: u32, height: u32) {}

@test
fn each_visible_rock_is_kept() {
    for width in [640, 360, 960] {
        let cam = first_camera(vec3(0.0), vec3(0.0, 0.0, 1.0), 1.0, width, 640)
        // The centre, four edges and four corners project inside the actual view.
        for y in [-0.98, 0.0, 0.98] {
            for x in [-0.98, 0.0, 0.98] {
                let point = cam.eye +
                    20.0 *
                        (cam.forward + cam.tan_half * (cam.right * (x * cam.aspect) + cam.up * y))
                let clip = cam.view_proj * vec4(point, 1.0)
                assert(
                    abs(clip.x) < clip.w && abs(clip.y) < clip.w && clip.z > 0.0 && clip.z < clip.w,
                    "the sample is outside the view",
                )
                let (seen, near) = kept(cam, point)
                assert(!near, "a distant sphere used its near mesh")
                assert(seen, "a visible edge or corner rock was culled")
            }
        }
        let (behind, _) = kept(cam, -cam.forward * 20.0)
        assert(!behind, "a rock behind the camera was retained")
        let (aside, _) = kept(cam, cam.forward * 20.0 + cam.right * 100.0)
        assert(!aside, "a rock well outside the view was retained")
    }
}
