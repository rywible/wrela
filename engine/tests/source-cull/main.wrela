// Independent walls/openings exercise the original sphere's optional finer query.
// The earlier source-envelope fixture is preserved in its evidence bundle.

use engine::cull::{Hzb, Pyramid, occluded}
use engine::view::{Camera, first_camera}
use std::gpu::{GlobalId, GpuBuffer, R32Float, Slots, Texture, buffer, buffer_of, dispatch, read}
use std::io::Pending

@compute(1)
fn probe(
    pyramid: Texture<R32Float>,
    h: Hzb,
    spheres: [vec4],
    refine: u32,
    out: mut Slots<u32>,
    id: GlobalId,
) {
    let s = spheres[id.x]
    out[id] = if occluded(pyramid, h, s.xyz, s.w, refine: refine != 0) { 1 } else { 0 }
}

pub struct State {
    started: bool,
    pending: Vec<Pending<u32>>,
    expected: Vec<u32>,
    answers: Vec<u32>,
}

pub fn init() -> State {
    State { started: false, pending: Vec::new(), expected: Vec::new(), answers: Vec::new() }
}

fn camera(w: u32, h: u32) -> Camera {
    first_camera(vec3(0.0), vec3(0.0, 0.0, 1.0), 1.0, width: w, height: h).unjittered()
}

fn point(cam: Camera, pixel: vec2, z: f32) -> vec3 {
    let xy = vec2(pixel.x / cam.screen.x * 2.0 - 1.0, 1.0 - pixel.y / cam.screen.y * 2.0)
    (cam.forward +
        cam.right * (xy.x * cam.aspect * cam.tan_half) +
        cam.up * (xy.y * cam.tan_half)) *
        z
}

fn case(
    s: mut State,
    cam: Camera,
    texels: [f32],
    sphere: vec4,
    expected: u32,
    refine: bool = true,
    enabled: bool = true,
) {
    var p = Pyramid::new(u32(cam.screen.x), u32(cam.screen.y))
    p.build_from(texels, cam)
    let h = Hzb { on: if enabled { 1 } else { 0 }, ..p.at }
    var out: GpuBuffer<u32> = buffer(1)
    let q = buffer_of([sphere])
    dispatch(probe.bind(p.depth, h, q, refine: if refine { 1 } else { 0 }, out: mut out), groups: 1)
    s.pending.push(read(out.items()))
    s.expected.push(expected)
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    if !s.started {
        s.started = true
        let cam = camera(w: 64, h: 64)
        let wall = Vec::filled(64 * 64, cam.near / 10.0)
        let behind = vec4(point(cam, vec2(23.0), 20.0), 0.5)
        case(mut s, cam, wall, behind, 1)
        case(mut s, cam, wall, vec4(point(cam, vec2(23.0), 5.0), 0.5), 0)
        case(mut s, cam, wall, vec4(0.0, 0.0, cam.near * 0.5, 0.5), 0)
        case(mut s, cam, wall, vec4(point(cam, vec2(200.0), 20.0), 0.5), 0)
        case(mut s, cam, wall, behind, 0, enabled: false)
        case(mut s, cam, wall, vec4(point(cam, vec2(23.0), 10.5), 0.5), 0)
        var opening = Vec::filled(64 * 64, cam.near / 10.0)
        opening[23 * 64 + 23] = 0.0
        case(mut s, cam, opening, behind, 0)
        var outside = Vec::filled(64 * 64, cam.near / 10.0)
        outside[23 * 64 + 29] = 0.0
        case(mut s, cam, outside, behind, 1)
        // This same source is visible under the original coarse query.
        case(mut s, cam, outside, behind, 0, refine: false)
        let odd_cam = camera(w: 65, h: 37)
        var odd = Vec::filled(65 * 37, odd_cam.near / 10.0)
        odd[65 * 37 - 1] = 0.0
        case(mut s, odd_cam, odd, vec4(point(odd_cam, vec2(64.0, 36.0), 20.0), 0.5), 0)
    }
    while s.answers.len() < s.pending.len() {
        let k = s.answers.len()
        match s.pending[k].poll() {
            Some(Ok(v)) => s.answers.push(v[0]),
            _ => return,
        }
    }
}

@test(frames: 8, gpu: true)
fn sphere_refinement_preserves_openings_and_discards_external_gaps(s: State) {
    assert(s.answers.len() == 10, "sphere refinement cases did not return")
    for i in 0..s.answers.len() {
        assert(
            s.answers[i] == s.expected[i],
            f"sphere refinement case {i}: got {s.answers[i]}, expected {s.expected[i]}",
        )
    }
}
