// The tool test: the frame fixture (engine/tests/frame, a bare scene with no effects, no
// characters, no prepass and no motion of its own) checked through the toolchain, with the
// engine read from the workspace, and the pipelines its build makes read from the answer.

use std::io::print
use std::tool::toolchain
use std::tool::toolchain::Override

/// How many pipelines a bare scene's frame makes (31 since B3: the terrain's sides bounded
/// and culled, `terrain::bound_sides` and `cull_sides`, and the probes' voxels cleared before a
/// cook, `probes::clear_voxels`; 33 since B4b: the depth pyramid's, `cull::level_zero` and
/// `farthest`; 34 since B8.1: the ambient occlusion's, `ambient::gtao`; 35 since B8.4: the local
/// lights' binning, `lights::bin`, dispatched only when a scene has lights; 38 since B8.5: the
/// reflections', `reflect::bake_sky`, `prefilter` and the screen's copy, `copy_below`; 39 since
/// B8.7: the bloom's pyramid, `paint::bloom_down` and `bloom_up`, for the glow's two, and the
/// identity grading table's kernel, `identity_lut`; 52 since B9: the particles' (`particles`:
/// `simulate`, `admit`, `groups_of`, `draw_args`, `keys_of`, the sort's `digit_counts`,
/// `scan_blocks`, `scan_sums`, `add_sums` and `scatter`, `light_particle`, the particles' draw)
/// and the see-through matter's `composite`, reached, made only when a scene has them); 64 since
/// world-class 2: the probes shifted by whole columns (`shift_probes`, `shift_voxels`, B5.5), the
/// cloud dome's half-size march brought up (`upsample`, B5.4), the probes' sights (`see`,
/// `shift_seen`, B9a), the solids' distance volume (`cook_distance`, B9b), the froxel volume
/// (`inject`, `integrate`, and the sky through it, `sky_fogged`, in place of `sky_shade`, B10),
/// the radiance cascades (`trace`, `merge`, `resolve`, B14.4) and the resolve's findings
/// (`found_rows`, B14.3), the last four made only when a frame's quality asks for them.
const FRAME_PIPELINES: u32 = 64

/// The fixture's pipelines: each one's entry points, `+` between them.
fn pipelines() -> Vec<String> {
    let overrides = [Override { name: String::from("engine"), dir: String::from("repo/engine") }]
    let Ok(checked) = toolchain::check_with(
        "repo/engine/tests/frame",
        overrides,
        300.0,
    ).wait() else {
        panic("the check's request")
    }
    for d in checked.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    var out: Vec<String> = Vec::new()
    for p in checked.pipelines {
        var names = String::new()
        for e in p.entries {
            if !names.is_empty() {
                names.push_str(" + ")
            }
            names.push_str(e.as_str())
        }
        out.push(take names)
    }
    out
}

/// No pipeline of a stage the scene leaves out (no water, no characters, no vegetation, no
/// effects of a scene's own), and no more pipelines than the frame's own.
@test(tool, read: [("repo", "../../..")], budget: 300)
fn a_bare_scene_reaches_only_the_frames_own_pipelines() {
    let ps = pipelines()
    // The frame's own (the look, temporal AA, the sky, the ground and its shadow, the probes,
    // the air and the clouds), 2026-10-23: a frame that reaches another says so here.
    assert(
        ps.len() == FRAME_PIPELINES,
        f"the bare scene makes {ps.len()} pipelines, not {FRAME_PIPELINES}",
    )
    for p in ps {
        print(p.as_str())
        for absent in ["water", "skin", "creature", "vegetation", "grass", "card", "mist"] {
            assert(p.as_str().find(absent).is_none(), f"the bare scene reaches `{p.as_str()}`")
        }
    }
}
