// The ink look: its sphere panel (scenes/), built, drawn two frames on the hardware GPU at
// 256 × 256 and its screen read (RGBA8, rows top to bottom); and its hatching on the mark lattice
// under a dollying eye.

use engine::light::{LUMA, Light, Lit}
use engine::marks
use engine::marks::{MarkSample, sample}
use engine::style
use engine::style::Style
use engine::substance
use engine::view::{Camera, first_camera}
use hosts::both::bytes_of
use hosts::steps::built
use std::io::print
use std::tool::drive
use std::tool::drive::Step
use std::tool::toolchain
use std::tool::toolchain::Override
use styles::ink::{HATCH_PX, Ink, LAYERS, LAYER_SOFT, layer}

const SIDE: u32 = 256
/// The panel's light and sky (`scenes::SUN`, `scenes::SKY`).
const SUN: vec3 = vec3(0.9759, 0.0, 0.2182)
const SKY: vec3 = vec3(0.5)

/// The panel's screen.
fn screen() -> Vec<u8> {
    let out = "scratch/panel"
    var options = toolchain::options()
    options.overrides = Vec::from(
        [
            Override { name: String::from("engine"), dir: String::from("repo/engine") },
            Override { name: String::from("styles"), dir: String::from("repo/content/styles") },
        ],
    )
    built("repo/engine/tests/style-ink/scenes", out, options, "the panel builds")
    var load = drive::gpu()
    load.width = SIDE
    load.height = SIDE
    let steps = [Step::Init, Step::FrameAt(0.0), Step::FrameAt(0.016), Step::Capture]
    let Ok(seen) = drive::run(out, load, steps).wait() else { panic("it draws on a GPU") }
    if let Some(trap) = seen.trap {
        panic(trap.message.as_str())
    }
    bytes_of(seen.captures[0].rgba.clone())
}

/// The density (1 less the look's light) of the sphere at pixel (`x`, `y`), as the panel lights
/// it, or below 0 off it.
fn density_at(x: u32, y: u32) -> f32 {
    let cam = first_camera(vec3(0.0, 0.0, 4.0), vec3(0.0), 0.8, SIDE, SIDE)
    let ray = cam.ray(vec2(f32(x) + 0.5, f32(y) + 0.5))
    let b = dot(cam.eye, ray)
    let h = b * b - (dot(cam.eye, cam.eye) - 1.0)
    if h <= 0.0 {
        return -1.0
    }
    let p = cam.eye + ray * (-b - sqrt(h))
    let n = normalize(p)
    let light = Light { sun: SUN, exposure: 1.0, sun_colour: vec3(1.0), eye: 1.0, horizon: 0.0 }
    let l = Lit { albedo: vec3(0.25), n, sun: 1.0, sky: SKY, through: vec3(0.0) }
    1.0 - dot(Ink::shade(light, l, substance::NONE, style::STONE, p, vec3(0.0, 0.0, 4.0)), LUMA)
}

/// A sphere lit from the side has no layer at its lit pole and all three at its dark limb, each
/// layer's boundary where the density crosses its threshold: across a band of rows through its
/// middle, a column whose every pixel is past layer `k`'s threshold (and its softness) has a
/// line of it, and no pixel short of it has any.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn a_spheres_layers_follow_its_density() {
    let px = screen()
    let band = 40
    var report = String::new()
    for k in 0..3 {
        let (lo, hi) = (LAYERS[k] - LAYER_SOFT, LAYERS[k] + LAYER_SOFT)
        var past = 0
        var inked = 0
        var stray = 0
        for x in 0..SIDE {
            var all_past = true
            var any = false
            for y in (SIDE / 2 - band / 2)..(SIDE / 2 + band / 2) {
                let d = density_at(x, y)
                let on = px[4 * (y * SIDE + x) + k] >= 128 && d >= 0.0
                if d < hi {
                    all_past = false
                }
                if on {
                    any = true
                    if d < lo {
                        stray += 1
                    }
                }
            }
            if all_past {
                past += 1
                if any {
                    inked += 1
                }
            }
        }
        report = f"{report} layer {k + 1}: {inked} of {past} columns past its threshold inked, {stray} pixels short of it;"
        assert(past >= 8, f"layer {k + 1}: only {past} columns past its threshold")
        assert(
            inked == past,
            f"layer {k + 1}: {past - inked} of {past} columns past its threshold uninked",
        )
        assert(stray == 0, f"layer {k + 1}: {stray} pixels short of its threshold inked")
    }
    // The lit pole (the sphere's point facing the sun) and the dark limb (its left edge).
    let pole = density_at(x: SIDE / 2 + 74, y: SIDE / 2)
    let limb = density_at(x: SIDE / 2 - 78, y: SIDE / 2)
    print(f"the sphere:{report} density {pole} at the lit pole, {limb} at the dark limb")
    assert(pole < LAYERS[0] - LAYER_SOFT && limb > LAYERS[2] + LAYER_SOFT, f"{pole} to {limb}")
}

/// An eye `d` metres from the plane's point `p`, looking down at it at 40°, a 1080-pixel screen
/// (engine/tests/marks's).
fn eye_at(p: vec3, d: f32) -> Camera {
    let look = normalize(vec3(0.0, -0.64, 0.77))
    first_camera(p - look * d, p, 0.82, width: 1920, height: 1080)
}

/// The first layer's ink at the plane's (y = 0) point under pixel `px` through `cam`, on the
/// lattice of level `level` (the finer's or the coarser's, as `level_of` gives it), its density 1.
fn ink_at(cam: Camera, px: vec2, level: i32) -> (f32, vec3) {
    let ray = cam.ray(px)
    let p = cam.eye + ray * (-cam.eye.y / ray.y)
    let foot = cam.footprint(dot(p - cam.eye, cam.forward))
    let s = sample(marks::HATCH, p, vec3(0.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), foot, HATCH_PX)
    let (k, _) = marks::level_of(foot, HATCH_PX)
    let m = if level == k { s.fine } else { s.coarse }
    (layer(MarkSample { lit: 0.0, ..m }, 0), p)
}

/// The hatch lines' middles down screen column `x` through `cam`, rows `from` to `to`, on lattice
/// `level`: each run of ink's centre, weighted by its ink (sub-pixel), and the plane's point there.
fn lines_down(cam: Camera, x: f32, from: f32, to: f32, level: i32) -> Vec<(f32, vec3)> {
    var out: Vec<(f32, vec3)> = Vec::new()
    var w = 0.0
    var wy = 0.0
    var y = from
    while y < to {
        let (ink, _) = ink_at(cam, vec2(x, y), level)
        if ink > 0.05 {
            w += ink
            wy += ink * y
        } else if w > 0.0 {
            let c = wy / w
            let (_, p) = ink_at(cam, vec2(x, c), level)
            out.push((c, p))
            w = 0.0
            wy = 0.0
        }
        y += 0.125
    }
    out
}

/// A hatch line stays on its surface point under a 1 m dolly: on the lattice both eyes share (the
/// same level's, or the nearer eye's coarser one), a line's middle seen from the far eye, carried
/// to where its surface point is seen from the near one, is within a pixel of a line's middle
/// there.
@test
fn a_hatch_line_keeps_its_surface_point_under_a_dolly() {
    var worst = 0.0
    var checked = 0
    for k in 0..12 {
        let p = vec3(f32(k % 4) * 0.9 - 1.3, 0.0, f32(k / 4) * 1.3 + 1.0)
        for d0 in [6.0, 15.0, 40.0] {
            let (a, b) = (eye_at(p, d0), eye_at(p, d0 - 1.0))
            let (ka, _) = marks::level_of(a.footprint(d0), HATCH_PX)
            let (kb, _) = marks::level_of(b.footprint(d0 - 1.0), HATCH_PX)
            if ka != kb && kb + 1 != ka {
                continue
            }
            let mid = a.pixel(p)
            for (_, q) in lines_down(a, mid.x, mid.y - 40.0, mid.y + 40.0, ka) {
                let there = b.pixel(q)
                var nearest = 1.0e9
                for (c, _) in lines_down(b, there.x, there.y - 8.0, there.y + 8.0, ka) {
                    nearest = min(nearest, abs(c - there.y))
                }
                worst = max(worst, nearest)
                checked += 1
            }
        }
    }
    print(f"{checked} hatch lines under a 1 m dolly: within {worst} px of their surface points")
    assert(checked > 100, f"only {checked} lines checked")
    assert(worst < 1.0, f"a line slid {worst} px")
}
