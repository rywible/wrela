// The look's slots on the hardware GPU (docs/plan-world-class-3.md §D2): the sphere fixture
// (sphere/) built and drawn a frame, its screen read; and the frame fixture (engine/tests/frame)
// built in a look that draws no marks, its manifest's pipelines read.

use hosts::both::bytes_of
use hosts::steps::{built, text_of}
use std::io::print
use std::json::{TOP, parse}
use std::tool::drive
use std::tool::drive::Step
use std::tool::toolchain
use std::tool::toolchain::{Override, Set}

/// The fixture's sphere and its bumps (`sphere/main.wrela`'s `R`, `AMP`, `WAVE`), and its
/// screen's side.
const R: f32 = 0.8
const AMP: f32 = 0.02
const WAVE: f32 = 0.08
const SIDE: u32 = 128

/// The bumpy sphere's distance, as the fixture has it.
fn bumpy(q: vec3) -> f32 {
    length(q) - R + AMP * sin(q.x * 6.2831853 / WAVE) * sin(q.y * 6.2831853 / WAVE)
}

/// A channel's byte for a value in [0, 1].
fn byte(v: f32) -> i32 {
    i32(round(clamp(v, 0.0, 1.0) * 255.0))
}

/// A look whose `shade` shows the normal it's lit by (`styles::fixtures::Normals`, which lights by
/// the form's: `NORMAL` 1) draws a bumpy sphere's form: at 100 pixels on it, each channel within
/// 1/255 of the sphere's normal, `n · 0.5 + 0.5`, where its bumps' normal is further off.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn a_look_that_shows_its_normal_draws_the_spheres_form() {
    let out = "scratch/sphere"
    var options = toolchain::options()
    options.overrides = Vec::from(
        [
            Override { name: String::from("engine"), dir: String::from("repo/engine") },
            Override { name: String::from("styles"), dir: String::from("repo/content/styles") },
        ],
    )
    built("repo/engine/tests/style/sphere", out, options, "the sphere builds")
    var load = drive::gpu()
    load.width = SIDE
    load.height = SIDE
    let Ok(seen) = drive::run(
        out,
        load,
        [Step::Init, Step::FrameAt(0.0), Step::Capture],
    ).wait() else {
        panic("the sphere loads and draws on a hardware GPU")
    }
    if let Some(trap) = seen.trap {
        panic(trap.message.as_str())
    }
    let pixels = bytes_of(seen.captures[0].rgba.clone())
    var checked = 0
    var worst = 0
    var bumped = 0
    var fine_worst = 0
    for k in 0..100 {
        // A 10 × 10 grid over the middle of the disc.
        let x = 34 + (k % 10) * 6
        let y = 34 + (k / 10) * 6
        let uv = (vec2(f32(x) + 0.5, f32(y) + 0.5) / f32(SIDE) * 2.0 - vec2(1.0)) * vec2(1.0, -1.0)
        let r2 = dot(uv, uv)
        assert(r2 < R * R * 0.9, f"pixel ({x}, {y}) isn't on the disc")
        let n = normalize(vec3(uv, sqrt(R * R - r2)))
        let want = n * 0.5 + vec3(0.5)
        let fine = normalize(std::derive::gradient(|q: vec3| bumpy(q), n * R)) * 0.5 + vec3(0.5)
        var off = 0
        for c in 0..3 {
            off = max(off, abs(byte(fine[c]) - byte(want[c])))
        }
        fine_worst = max(fine_worst, u32(off))
        if off > 3 {
            bumped += 1
        }
        let at = 4 * (y * SIDE + x)
        for c in 0..3 {
            let got = i32(pixels[at + c])
            let d = abs(got - byte(want[c]))
            worst = max(worst, u32(d))
        }
        checked += 1
    }
    print(
        f"{checked} pixels on the sphere: each channel within {worst}/255 of its form's normal; its bumps' normal more than 3/255 off at {bumped} (up to {fine_worst}/255)",
    )
    assert(worst <= 1, f"a channel {worst}/255 off its form's normal")
    assert(
        bumped >= 50,
        f"the bumps show at only {bumped} of the pixels: the test can't tell the normals apart",
    )
}

/// The fragment entry points of the frame fixture built in look `look`, from its manifest.
fn fragments(look: str, out: str) -> Vec<String> {
    var options = toolchain::options()
    options.overrides = Vec::from(
        [
            Override { name: String::from("engine"), dir: String::from("repo/engine") },
            Override { name: String::from("styles"), dir: String::from("repo/content/styles") },
        ],
    )
    options.set = Vec::from([Set { name: String::from("LOOK"), value: String::from(look) }])
    built("repo/engine/tests/frame", out, options, "the fixture builds")
    let manifest = text_of(f"{out}/manifest.json")
    let Some(d) = parse(manifest.as_str()) else { panic("the manifest is JSON") }
    let Some(list) = d.get(TOP, "pipelines") else { panic("the manifest's pipelines") }
    var out_list: Vec<String> = Vec::new()
    for k in 0..d.count(list) {
        let Some(p) = d.at(list, k) else { continue }
        let Some(f) = d.get(p, "fragment_entry") else { continue }
        if let Some(t) = d.text(f) {
            out_list.push(take t)
        }
    }
    out_list
}

/// A look that draws no marks (`MARKS` 0: `styles::fixtures::Normals`) builds no pass of them:
/// the physical look's lines (`paint::lines`) are in its build, and not in the other.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn a_look_without_marks_builds_no_pass_of_them() {
    let physical = fragments("styles::physical::Physical", "scratch/physical")
    let unmarked = fragments("styles::fixtures::Normals", "scratch/unmarked")
    let has = |list: Vec<String>, e: str| {
        var found = false
        for x in list {
            if x.as_str() == e {
                found = true
            }
        }
        found
    }
    print(f"the physical look: {physical.len()} render pipelines; without marks: {unmarked.len()}")
    assert(has(physical.clone(), "lines"), "the physical look draws its lines")
    assert(!has(unmarked.clone(), "lines"), "a look without marks draws lines")
}
