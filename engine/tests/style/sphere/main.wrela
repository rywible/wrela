// A sphere with bumps finer than its form, drawn through a look's slots: each pixel's point on it,
// its fine normal (the bumps') and its form's (the sphere's), the normal the look lights by
// (`style::lit_normal`, the look's `NORMAL`), and what the look's `shade` and `lens` make of it.
// The look is `styles::fixtures::Normals`: it lights by the form and shows the normal as a colour.

use engine::frame::full
use engine::light::{Light, Lit}
use engine::paint::{Develop, Exposure, Look}
use engine::style
use engine::style::{Style, lit_normal}
use engine::substance
use engine::view::first_camera
use std::gpu::{FragCoord, Rgba8, Sampler, Texture3d, begin_screen_pass, draw, sampler, texture3d}
use styles::fixtures::Normals

pub type LOOK = Normals

/// The sphere's radius (of the screen's half-height), and its bumps' height and wavelength.
pub const R: f32 = 0.8
pub const AMP: f32 = 0.02
pub const WAVE: f32 = 0.08

/// The bumps' height at `p`, and its gradient.
fn bumps(p: vec3) -> f32 {
    AMP * sin(p.x * 6.2831853 / WAVE) * sin(p.y * 6.2831853 / WAVE)
}

/// The lens's grading table and sampler (the `Normals` look reads neither).
pub struct State {
    lut: Texture3d<Rgba8>,
    s: Sampler,
}

pub fn init() -> State {
    State { lut: texture3d::<Rgba8>(width: 1, height: 1, depth: 1), s: sampler() }
}

/// The sphere seen straight on (orthographic, the eye down -z), the screen `size`: its point at
/// the pixel, lit through the look, or black off it.
@fragment
fn sphere(
    pixel: FragCoord,
    size: vec2,
    d: Develop,
    e: Exposure,
    lut: Texture3d<Rgba8>,
    s: Sampler,
) -> vec4 {
    let uv = (pixel.position.xy / size * 2.0 - vec2(1.0)) * vec2(size.x / size.y, -1.0)
    let r2 = dot(uv, uv)
    if r2 >= R * R {
        return vec4(0.0, 0.0, 0.0, 1.0)
    }
    let p = vec3(uv, sqrt(R * R - r2))
    let form = normalize(p)
    let fine = normalize(std::derive::gradient(|q: vec3| length(q) - R + bumps(q), p))
    let n = lit_normal::<LOOK>(fine, form, form)
    let light = Light { sun: vec3(0.0, 0.0, 1.0), exposure: 1.0, sun_colour: vec3(1.0), eye: 1.0, horizon: 0.0 }
    let lit = Lit { albedo: vec3(0.5), n, sun: 1.0, sky: vec3(0.0), through: vec3(0.0) }
    let c = LOOK::shade(light, lit, substance::NONE, style::STONE, p, p + vec3(0.0, 0.0, 4.0))
    LOOK::lens(c, pixel.position.xy, d, e, lut, s)
}

pub fn frame(state: mut State, time: f32, width: u32, height: u32) {
    let screen = begin_screen_pass(clear: vec4(0.0))
    let size = vec2(f32(width), f32(height))
    let d = Develop {
        cam: first_camera(vec3(0.0), vec3(0.0, 0.0, -1.0), 1.0, width, height),
        look: Look {},
        out: size,
    }
    let e = Exposure { value: 1.0, metered: 1.0, mean: 0.18 }
    draw(
        screen,
        full.bind(z: 0.5),
        sphere.bind(size, d, e, lut: state.lut, s: state.s),
        vertices: 3,
    )
    screen.present()
}
