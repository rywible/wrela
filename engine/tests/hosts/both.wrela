// Both hosts draw a fixture: the native host on the machine's hardware GPU (through
// `std::tool::drive`), and headless Chrome in the browser runtime's test mode (through
// `std::tool::serve` and `std::tool::browser`), each its first frames at 60 a second. Test mode
// writes the page's last frame (`results/frame.rgba`) and its state hash (`results/hash.txt`)
// into the served directory; the native host's are its capture and its hash.

use std::tool::MOST_BYTES
use std::tool::blob
use std::tool::blob::Data
use std::tool::browser
use std::tool::browser::{Script, Until}
use std::tool::drive
use std::tool::drive::Step
use std::tool::files
use std::tool::serve
use std::tool::toolchain
use steps::built

/// What both hosts drew: each one's state hash (16 hex digits) and last frame (RGBA8).
pub struct Both: Clone {
    pub chrome_hash: String,
    pub chrome: Vec<u8>,
    pub native_hash: String,
    pub native: Vec<u8>,
}

/// The bytes of `data`, read from its blob if it's one.
pub fn bytes_of(data: take Data) -> Vec<u8> {
    let held = match take data {
        Data::Bytes(v) => return v,
        Data::Blob(held) => held,
    }
    let Ok(size) = blob::len(held).wait() else { panic("the blob's length") }
    var out: Vec<u8> = Vec::new()
    var at: u64 = 0
    while at < size {
        let len = u32(min(size - at, u64(MOST_BYTES)))
        let Ok(chunk) = blob::read(held, at, len).wait() else { panic("the blob's bytes") }
        for j in 0..chunk.len() {
            out.push(chunk[j])
        }
        at += u64(len)
    }
    out
}

/// The bytes of the file at `path`.
pub fn file_bytes(path: str) -> Vec<u8> {
    let Ok(held) = files::read_blob(path).wait() else { panic(f"{path} reads") }
    bytes_of(Data::Blob(held))
}

/// `bytes` as text, its spaces and newlines trimmed.
fn trimmed(bytes: take Vec<u8>) -> String {
    let Some(text) = String::from_utf8(take bytes) else { panic("the text isn't UTF-8") }
    var a = 0
    var b = text.len()
    while a < b && (text.byte(a) == 32 || text.byte(a) == 10 || text.byte(a) == 13) {
        a += 1
    }
    while b > a && (text.byte(b - 1) == 32 || text.byte(b - 1) == 10 || text.byte(b - 1) == 13) {
        b -= 1
    }
    String::from(text.as_str().slice(a, b))
}

/// The build in `out` (a write root's directory: its page writes its results there) run in
/// headless Chrome's test mode with the URL fragment `fragment` (`#test&frames=...`), to its end,
/// which must be `ok`: its results are in `out/results/`.
pub fn in_chrome(out: str, fragment: str) {
    let Ok(srv) = serve::start(out).wait() else { panic("the page's server starts") }
    let url = f"{srv.origin.as_str()}/{fragment}"
    let Ok(page) = browser::open(url.as_str()).wait() else { panic("Chrome opens the page") }
    let script = Script::new().wait(Until::done(), timeout: 120.0)
    if let Err(e) = browser::run(page, script, 150.0).wait() {
        panic(f"the page's run: {e.message()}")
    }
    let Ok(result) = browser::results(page).wait() else { panic("the page's result") }
    let Some(said) = result else { panic("the page wrote no result") }
    assert(said.as_str() == "ok", f"the browser run failed: {said.as_str()}")
    let _ = browser::close(page).wait()
    let _ = serve::close(srv.server).wait()
}

/// The package at `pkg` (a root path), built into `scratch/<name>` (its page too; a test build,
/// with its `@testing` exports, if `testing`), drawn by both hosts: `frames` frames, `width` ×
/// `height`.
pub fn both_hosts(
    pkg: str,
    name: str,
    width: u32,
    height: u32,
    frames: u32,
    testing: bool,
) -> Both {
    let out = String::from(f"scratch/{name}")
    var options = toolchain::options()
    options.testing = testing
    built(pkg, out.as_str(), options, f"{name} builds")
    // The native host: its frames at their times, then its screen and its hash.
    var load = drive::gpu()
    load.width = width
    load.height = height
    var list: Vec<Step> = Vec::from([Step::Init])
    for k in 0..frames {
        list.push(Step::FrameAt(f32(k) / 60.0))
    }
    list.push(Step::Capture)
    list.push(Step::Hash)
    let Ok(seen) = drive::run(out.as_str(), load, list).wait() else {
        panic("the build runs on a hardware GPU")
    }
    if let Some(t) = seen.trap {
        panic(f"init runs and the native frames draw: {t.message.as_str()}")
    }
    let native = bytes_of(seen.captures[0].rgba.clone())
    // Chrome: the page served from the build's directory, in test mode.
    in_chrome(out.as_str(), f"#test&frames={frames}&width={width}&height={height}&fps=60&workers=1")
    let chrome = file_bytes(f"{out}/results/frame.rgba")
    let chrome_hash = trimmed(file_bytes(f"{out}/results/hash.txt"))
    Both { chrome_hash, chrome, native_hash: String::from(f"{seen.hashes[0]:016x}"), native }
}

/// The mean of the two frames' channels' differences, in 8-bit steps, and the largest.
pub fn difference(a: [u8], b: [u8]) -> (f64, u32) {
    assert(a.len() == b.len() && a.len() > 0, "the frames are the same size")
    var sum = 0.0
    var most = 0
    for i in 0..a.len() {
        let d = if a[i] > b[i] { u32(a[i] - b[i]) } else { u32(b[i] - a[i]) }
        sum += f64(d)
        most = max(most, d)
    }
    (sum / f64(a.len()), most)
}
