// The steps the workspace's tool tests share: files read and written as text, source text
// patched and counted, packages built, a driven build's commands and screen read back, and the
// words of bytes a build read back.

use both::bytes_of
use std::tool::drive
use std::tool::drive::Step
use std::tool::files
use std::tool::toolchain

/// The text of the file at `path`, which must read and be UTF-8.
pub fn text_of(path: str) -> String {
    let Ok(bytes) = files::read(path).wait() else { panic(f"{path} reads") }
    let Some(text) = String::from_utf8(take bytes) else { panic(f"{path} isn't UTF-8") }
    text
}

/// Writes `text` at `path`.
pub fn written(path: str, text: str) {
    assert(files::write(path, String::from(text).as_bytes()).wait().is_ok(), f"{path} is written")
}

/// `text` with each `from` replaced by `to`, left to right.
pub fn replaced(text: str, from: str, to: str) -> String {
    var out: Vec<u8> = Vec::new()
    var i = 0
    while i < text.len() {
        var hit = i + from.len() <= text.len()
        if hit {
            for j in 0..from.len() {
                if text.byte(i + j) != from.byte(j) {
                    hit = false
                    break
                }
            }
        }
        if hit {
            for j in 0..to.len() {
                out.push(to.byte(j))
            }
            i += from.len()
        } else {
            out.push(text.byte(i))
            i += 1
        }
    }
    let Some(s) = String::from_utf8(take out) else { panic("a replacement keeps UTF-8") }
    s
}

/// How many of `text`'s lines are `@test` alone: the tests it declares.
pub fn declared(text: str) -> u32 {
    var n = 0
    var start = 0
    for i in 0..text.len() + 1 {
        if i == text.len() || text.byte(i) == 10 {
            var a = start
            var b = i
            while a < b && (text.byte(a) == 32 || text.byte(a) == 9 || text.byte(a) == 13) {
                a += 1
            }
            while b > a &&
                (text.byte(b - 1) == 32 || text.byte(b - 1) == 9 || text.byte(b - 1) == 13) {
                b -= 1
            }
            if text.slice(a, b) == "@test" {
                n += 1
            }
            start = i + 1
        }
    }
    n
}

/// The package at `pkg` built into `out` with `options`: the build must have no error, and must
/// succeed, or the test fails with `what` (as "the mixer builds").
pub fn built(pkg: str, out: str, options: toolchain::BuildOptions, what: str) {
    let Ok(build) = toolchain::build(pkg, out, options).wait() else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, what)
}

/// Every command `h` recorded since the last time, however many answers they take.
pub fn recorded(h: drive::Build) -> Vec<drive::Recorded> {
    var out: Vec<drive::Recorded> = Vec::new()
    loop {
        let Ok(seen) = drive::steps(h, [Step::Commands]).wait() else { panic("the commands") }
        borrow r = seen.commands[0]
        for k in 0..r.commands.len() {
            out.push(r.commands[k].clone())
        }
        if r.waiting == 0 {
            return out
        }
    }
}

/// `h`'s screen, RGBA8, rows top to bottom.
pub fn screen(h: drive::Build) -> Vec<u8> {
    let Ok(seen) = drive::steps(h, [Step::Capture]).wait() else { panic("the capture") }
    bytes_of(seen.captures[0].rgba.clone())
}

/// The little-endian `u32` at byte `at` of `bytes`.
pub fn word(bytes: [u8], at: u32) -> u32 {
    u32(bytes[at]) |
        (u32(bytes[at + 1]) << 8) |
        (u32(bytes[at + 2]) << 16) |
        (u32(bytes[at + 3]) << 24)
}

/// Sample `i` of `bytes`, little-endian `f32`s.
pub fn sample(bytes: [u8], i: u32) -> f32 {
    bitcast_f32(word(bytes, 4 * i))
}
