// Aligned scene samples and the resolve immediately on either side of a sample boundary.
// No history: this isolates current-frame reconstruction from accumulation and sharpening.
use engine::floor::fullscreen
use engine::plant::full
use engine::temporal::{Resolve, neighbourhoods, resolve}
use engine::view::first_camera
use std::gpu::{
    Compare, Depth, FragCoord, Rgba16Float, Texture, WithDepth, begin_pass, begin_pass_with_depth,
    begin_screen_pass, depth_texture, dispatch, draw, sampler, texture, writable_texture,
}

@fragment
fn surface(p: FragCoord) -> WithDepth<vec4> {
    let at = vec2u(p.position.xy)
    let stripe = if at.x % 2 == 0 { 0.8 } else { 0.05 }
    let ramp = 0.05 + f32(at.y) * 0.04
    WithDepth { color: vec4(stripe, ramp, 0.1, 64.0), depth: 0.25 }
}

@fragment
fn show(
    p: FragCoord,
    scene: Texture<Rgba16Float>,
    aligned: Texture<Rgba16Float>,
    before: Texture<Rgba16Float>,
    after: Texture<Rgba16Float>,
    reduced: Texture<Rgba16Float>,
    reduced_before: Texture<Rgba16Float>,
    reduced_after: Texture<Rgba16Float>,
) -> vec4 {
    let at = vec2u(p.position.xy)
    // The lower row reduces the same scene by two. A -0.5 scene-pixel jitter aligns
    // each output centre with an even-indexed source sample.
    if at.y >= 16 {
        let x = at.x % 8
        let y = at.y - 16
        let c = if at.x < 8 { scene.load(x * 2, y * 2) } else if at.x < 16 {
            reduced.load(x, y)
        } else if at.x < 24 { reduced_before.load(x, y) } else {
            reduced_after.load(x, y)
        }
        return vec4(c.rgb, 1.0)
    }
    let x = at.x % 16
    let c = if at.x < 16 { scene.load(x, at.y) } else if at.x < 32 {
        aligned.load(x, at.y)
    } else if at.x < 48 { before.load(x, at.y) } else { after.load(x, at.y) }
    vec4(c.rgb, 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var scene = texture::<Rgba16Float>(width: 16, height: 16)
    var depth = depth_texture(width: 16, height: 16)
    let p = begin_pass_with_depth(mut scene, mut depth)
    draw(
        p,
        full.bind(z: 0.5),
        surface,
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
    var motion = texture::<Rgba16Float>(width: 16, height: 16)
    let p = begin_pass(mut motion, clear: vec4(0.0))
    p.end()
    var means = writable_texture::<Rgba16Float>(width: 16, height: 16)
    var spreads = writable_texture::<Rgba16Float>(width: 16, height: 16)
    dispatch(neighbourhoods.bind(scene, mut means, mut spreads), over: scene)
    let cam = first_camera(vec3(0.0), vec3(0.0, 0.0, -1.0), 1.0, width: 16, height: 16).unjittered()
    let r = Resolve {
        cam,
        out: vec2(16.0),
        blend: 0.12,
        fresh: 1,
        jitter: vec2(0.0),
        last_jitter: vec2(0.0),
        moving: vec4(0.0),
    }
    let s = sampler()
    var aligned = texture::<Rgba16Float>(width: 16, height: 16)
    var before = texture::<Rgba16Float>(width: 16, height: 16)
    var after = texture::<Rgba16Float>(width: 16, height: 16)
    let p = begin_pass(mut aligned)
    fullscreen(p, resolve.bind(r, scene, depth, depth, motion, motion, scene, means, spreads, s))
    p.end()
    let p = begin_pass(mut before)
    fullscreen(
        p,
        resolve.bind(
            Resolve { jitter: vec2(-0.0001), ..r },
            scene,
            depth,
            depth,
            motion,
            motion,
            scene,
            means,
            spreads,
            s,
        ),
    )
    p.end()
    let p = begin_pass(mut after)
    fullscreen(
        p,
        resolve.bind(
            Resolve { jitter: vec2(0.0001), ..r },
            scene,
            depth,
            depth,
            motion,
            motion,
            scene,
            means,
            spreads,
            s,
        ),
    )
    p.end()
    var reduced = texture::<Rgba16Float>(width: 8, height: 8)
    var reduced_before = texture::<Rgba16Float>(width: 8, height: 8)
    var reduced_after = texture::<Rgba16Float>(width: 8, height: 8)
    let reduced_resolve = Resolve { out: vec2(8.0), jitter: vec2(-0.5), ..r }
    let p = begin_pass(mut reduced)
    fullscreen(
        p,
        resolve.bind(
            reduced_resolve,
            scene,
            depth,
            depth,
            motion,
            motion,
            scene,
            means,
            spreads,
            s,
        ),
    )
    p.end()
    let p = begin_pass(mut reduced_before)
    fullscreen(
        p,
        resolve.bind(
            Resolve { jitter: vec2(-0.5001), ..reduced_resolve },
            scene,
            depth,
            depth,
            motion,
            motion,
            scene,
            means,
            spreads,
            s,
        ),
    )
    p.end()
    let p = begin_pass(mut reduced_after)
    fullscreen(
        p,
        resolve.bind(
            Resolve { jitter: vec2(-0.4999), ..reduced_resolve },
            scene,
            depth,
            depth,
            motion,
            motion,
            scene,
            means,
            spreads,
            s,
        ),
    )
    p.end()
    let screen = begin_screen_pass(clear: vec4(0.0))
    fullscreen(
        screen,
        show.bind(scene, aligned, before, after, reduced, reduced_before, reduced_after),
    )
    screen.present()
}
