// Three small resolves: fresh reference, stale depth, matching depth. The scene has colour
// variation so neighbourhood clipping alone admits the blue history on red pixels.
use engine::floor::fullscreen
use engine::plant::full
use engine::temporal::{Resolve, neighbourhoods, resolve}
use engine::view::first_camera
use std::gpu::{
    Compare, Depth, FragCoord, Rgba16Float, Texture, WithDepth, begin_pass, begin_pass_with_depth,
    begin_screen_pass, depth_texture, dispatch, draw, sampler, texture, writable_texture,
}

@fragment
fn surface(p: FragCoord, previous: bool) -> WithDepth<vec4> {
    let row = u32(p.position.y) / 4
    let red = u32(p.position.x) % 2 == 0
    let now = if row == 0 || row == 3 { if red { 0.5 } else { 0.1 } } else if row == 1 {
        0.25
    } else if row == 4 && red { 0.5 } else { 0.0 }
    let before = if row == 0 || row >= 3 { 0.25 } else { 0.5 }
    let tag = if row == 3 && red { 192.0 } else if row == 2 || (row == 4 && !red) { 0.0 } else {
        64.0
    }
    let colour = if red { vec3(0.8, 0.05, 0.05) } else { vec3(0.05, 0.05, 0.8) }
    WithDepth { color: vec4(colour, tag), depth: if previous { before } else { now } }
}

@fragment
fn show(
    p: FragCoord,
    fresh: Texture<Rgba16Float>,
    rejected: Texture<Rgba16Float>,
    kept: Texture<Rgba16Float>,
) -> vec4 {
    let at = vec2u(p.position.xy)
    let x = at.x % 32
    let c = if at.x < 32 { fresh.load(x, at.y) } else if at.x < 64 { rejected.load(x, at.y) } else {
        kept.load(x, at.y)
    }
    vec4(c.rgb, 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var scene = texture::<Rgba16Float>(width: 16, height: 20)
    var scratch = texture::<Rgba16Float>(width: 16, height: 20)
    var depth = depth_texture(width: 16, height: 20)
    var old_depth = depth_texture(width: 16, height: 20)
    let p = begin_pass_with_depth(mut scene, mut depth)
    draw(
        p,
        full.bind(z: 0.5),
        surface.bind(previous: false),
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
    let p = begin_pass_with_depth(mut scratch, mut old_depth)
    draw(
        p,
        full.bind(z: 0.5),
        surface.bind(previous: true),
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
    var motion = texture::<Rgba16Float>(width: 16, height: 20)
    let p = begin_pass(mut motion, clear: vec4(0.0))
    p.end()
    var history = texture::<Rgba16Float>(width: 32, height: 40)
    let p = begin_pass(mut history, clear: vec4(0.05, 0.05, 0.8, 64.0))
    p.end()
    var means = writable_texture::<Rgba16Float>(width: 16, height: 20)
    var spreads = writable_texture::<Rgba16Float>(width: 16, height: 20)
    dispatch(neighbourhoods.bind(scene, mut means, mut spreads), over: scene)
    let cam = first_camera(vec3(0.0), vec3(0.0, 0.0, -1.0), 1.0, width: 16, height: 20).unjittered()
    let r = Resolve {
        cam,
        out: vec2(32.0, 40.0),
        blend: 0.12,
        fresh: 0,
        jitter: vec2(0.0),
        last_jitter: vec2(0.0),
        moving: vec4(0.0),
        settled: 100.0,
    }
    let s = sampler()
    var fresh = texture::<Rgba16Float>(width: 32, height: 40)
    var rejected = texture::<Rgba16Float>(width: 32, height: 40)
    var kept = texture::<Rgba16Float>(width: 32, height: 40)
    let p = begin_pass(mut fresh)
    fullscreen(
        p,
        resolve.bind(
            Resolve { fresh: 1, ..r },
            scene,
            depth,
            old_depth,
            motion,
            motion,
            history,
            means,
            spreads,
            s,
        ),
    )
    p.end()
    let p = begin_pass(mut rejected)
    fullscreen(
        p,
        resolve.bind(r, scene, depth, old_depth, motion, motion, history, means, spreads, s),
    )
    p.end()
    let p = begin_pass(mut kept)
    fullscreen(p, resolve.bind(r, scene, depth, depth, motion, motion, history, means, spreads, s))
    p.end()
    let screen = begin_screen_pass(clear: vec4(0.0))
    fullscreen(screen, show.bind(fresh, rejected, kept))
    screen.present()
}
