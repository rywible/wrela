// Grass the wind moves, through temporal AA: thin blades (the grass's tag) sliding 1.5 pixels a
// frame over the ground, resolved frame after frame with their motion in the motion target
// (`deforming_of`'s, 0.5 in z) and without it (all 0). After `FRAMES` frames the screen shows
// each resolve beside a fresh one of the last frame (no history): left with motion, middle
// without, right fresh.
use engine::floor::fullscreen
use std::collections::swap
use engine::plant::full
use engine::temporal::{Resolve, resolve_gathered}
use engine::view::{GRASS, GROUND, first_camera}
use std::gpu::{
    Compare, Depth, DepthTexture, FragCoord, Rgba16Float, Texture, WithDepth, begin_pass,
    begin_pass_with_depth, begin_screen_pass, depth_texture, draw, sampler, texture,
}

const W: u32 = 64
const H: u32 = 32
pub const FRAMES: u32 = 12
const SPEED: f32 = 1.5

/// Frame `f`'s scene (`blades`): blades two pixels wide every eight, moved `SPEED` pixels a frame.
@fragment
fn blades(p: FragCoord, f: f32) -> WithDepth<vec4> {
    let x = p.position.x - SPEED * f
    let blade = fract(x / 8.0) < 0.25
    let c = if blade { vec4(0.3, 0.9, 0.2, GRASS) } else { vec4(0.25, 0.12, 0.05, GROUND) }
    WithDepth { color: c, depth: 0.5 }
}

/// The blades' motion (now less then: `SPEED` pixels along x), or none.
@fragment
fn moved(p: FragCoord, f: f32, on: u32) -> vec4 {
    let x = p.position.x - SPEED * f
    if on != 0 && fract(x / 8.0) < 0.25 { vec4(SPEED, 0.0, 0.5, 1.0) } else { vec4(0.0) }
}

@fragment
fn show(
    p: FragCoord,
    with: Texture<Rgba16Float>,
    without: Texture<Rgba16Float>,
    fresh: Texture<Rgba16Float>,
) -> vec4 {
    let at = vec2u(p.position.xy)
    let x = at.x % W
    let c = if at.x < W { with.load(x, at.y) } else if at.x < 2 * W { without.load(x, at.y) } else {
        fresh.load(x, at.y)
    }
    vec4(c.rgb, 1.0)
}

/// The frame's number, the depth, and each resolve's history and the one before it.
pub struct State {
    frame: u32,
    depth: DepthTexture,
    with: Texture<Rgba16Float>,
    last_with: Texture<Rgba16Float>,
    without: Texture<Rgba16Float>,
    last_without: Texture<Rgba16Float>,
}

pub fn init() -> State {
    State {
        frame: 0,
        depth: depth_texture(width: W, height: H),
        with: texture::<Rgba16Float>(width: W, height: H),
        last_with: texture::<Rgba16Float>(width: W, height: H),
        without: texture::<Rgba16Float>(width: W, height: H),
        last_without: texture::<Rgba16Float>(width: W, height: H),
    }
}

/// One frame's resolve into `history` from `last`, its motion on or off; `fresh` with no history.
fn resolved(
    depth: DepthTexture,
    scene: Texture<Rgba16Float>,
    motion: Texture<Rgba16Float>,
    last: Texture<Rgba16Float>,
    history: mut Texture<Rgba16Float>,
    fresh: u32,
) {
    let cam = first_camera(vec3(0.0), vec3(0.0, 0.0, -1.0), 1.0, width: W, height: H).unjittered()
    let r = Resolve {
        cam,
        out: vec2(f32(W), f32(H)),
        blend: 0.12,
        fresh,
        jitter: vec2(0.0),
        last_jitter: vec2(0.0),
        moving: vec4(0.0, 0.0, f32(W), f32(H)),
        settled: 0.0,
    }
    let linear = sampler()
    let p = begin_pass(mut history)
    fullscreen(
        p,
        resolve_gathered.bind(r, scene, depth, depth, motion, motion, last, linear),
    )
    p.end()
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    let f = f32(s.frame)
    var scene = texture::<Rgba16Float>(width: W, height: H)
    let p = begin_pass_with_depth(mut scene, mut s.depth)
    draw(
        p,
        full.bind(z: 0.5),
        blades.bind(f),
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
    var motion = texture::<Rgba16Float>(width: W, height: H)
    let p = begin_pass(mut motion)
    fullscreen(p, moved.bind(f, on: 1))
    p.end()
    var still = texture::<Rgba16Float>(width: W, height: H)
    let p = begin_pass(mut still)
    fullscreen(p, moved.bind(f, on: 0))
    p.end()
    let first = if s.frame == 0 { 1 } else { 0 }
    swap(mut s.with, mut s.last_with)
    swap(mut s.without, mut s.last_without)
    resolved(s.depth, scene, motion, s.last_with, mut s.with, fresh: first)
    resolved(s.depth, scene, still, s.last_without, mut s.without, fresh: first)
    var fresh = texture::<Rgba16Float>(width: W, height: H)
    resolved(s.depth, scene, still, s.last_without, mut fresh, fresh: 1)
    let screen = begin_screen_pass(clear: vec4(0.0))
    fullscreen(screen, show.bind(s.with, s.without, fresh))
    screen.present()
    s.frame += 1
}
