// Three eight-pixel blocks: opaque, one uncovered pixel, and empty. Even the single gap
// must leave the block open so a distant crown behind it is not removed: the depth pyramid's
// level 3 (`engine::cull`, its texels the blocks) holds each block's farthest depth.
use engine::cull::Pyramid
use engine::frame::fullscreen
use engine::frame::full
use engine::view::first_camera
use std::gpu::{
    Compare, Depth, FragCoord, R32Float, Texture, WithDepth, begin_depth_pass, begin_screen_pass,
    depth_texture, draw,
}

@fragment
fn surface(p: FragCoord) -> WithDepth<vec4> {
    let x = u32(p.position.x)
    let y = u32(p.position.y)
    let covered = x < 8 || (x < 16 && !(x == 8 && y == 0))
    WithDepth { color: vec4(0.0), depth: if covered { 0.5 } else { 0.0 } }
}

@fragment
fn report(p: FragCoord, pyramid: Texture<R32Float>) -> vec4 {
    vec4(vec3(pyramid.load(x: u32(p.position.x) / 8, y: 0, level: 3)), 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var map = depth_texture(width: 24, height: 8)
    let p = begin_depth_pass(mut map, clear_depth: 0.0)
    draw(
        p,
        full.bind(z: 0.5),
        surface,
        vertices: 3,
        depth: Depth { compare: Compare::Always, write: true },
    )
    p.end()
    var pyramid = Pyramid::new(width: 24, height: 8)
    pyramid.build(map, first_camera(vec3(0.0), vec3(0.0, 0.0, 1.0), 1.0, width: 24, height: 8))
    let p = begin_screen_pass(clear: vec4(0.0))
    fullscreen(p, report.bind(pyramid.depth))
    p.present()
}
