// Production far quads and volume depth at three widths, from level and raised cameras.
use engine::floor::fullscreen
use engine::impostor::{Bake, VIEWS, far_quad, volume_cut}
use engine::plant::{Bark, Instance, Leaves, Wind, tint_of}
use engine::view::{Camera, first_camera}
use std::gpu::{
    Compare, Depth, DepthTexture, FragCoord, GlobalId, R32Uint, Rgba16Float, Texels3d, Texture,
    begin_pass_with_depth, begin_screen_pass, buffer_of, depth_texture, dispatch, draw, sampler,
    texture, texture3d,
}

fn camera(row: u32) -> Camera {
    // A long lens isolates width from the near-face perspective magnification of a deep box.
    first_camera(vec3(0.0, if row == 0 { 0.0 } else {
        10.0
    }, 20.0), vec3(0.0), fovy: 0.14, width: 64, height: 64).unjittered()
}

fn instance(wide: f32) -> Instance {
    Instance { at: vec3(0.0), yaw: 0.0, tint: tint_of(vec2(0.0)), scale: 1.0, fork: 0.0, wide }
}

@compute(4, 4, 4)
fn box_volume(out: mut Texels3d<Rgba16Float>, depths: mut Texels3d<Rgba16Float>, p: GlobalId) {
    let q = (vec3(f32(p.x), f32(p.y), f32(p.z)) + vec3(0.5)) / 24.0 * 2.0 - vec3(1.0)
    let filled = max(abs(q.x), max(abs(q.y), abs(q.z))) < 0.42
    out.store(p, if filled { vec4(50.0, 0.0, 50.0, 0.0) } else { vec4(0.0) })
    depths.store(p, vec4(0.0))
}

@fragment
fn report(p: FragCoord, ids: Texture<R32Uint>, depth: DepthTexture) -> vec4 {
    let at = vec2u(p.position.xy)
    if ids.load(x: at.x, y: at.y) == 0 { return vec4(0.0, 0.0, 0.0, 1.0) }
    let row = at.y / 64
    let col = at.x / 64
    let wide = 0.5 + 0.5 * f32(col)
    let world = camera(row).world_at(
        vec2(f32(at.x % 64) + 0.5, f32(at.y % 64) + 0.5),
        depth.load(x: at.x, y: at.y),
    )
    let bound = instance(wide).bound_radius(reach: 1.0)
    let ok = abs(world.x) <= 0.53 * wide &&
        abs(world.y) <= 0.53 &&
        abs(world.z) <= 0.53 * wide &&
        length(world) <= bound
    vec4(if ok { 0.0 } else { 1.0 }, 1.0, 1.0, 1.0)
}

pub fn frame(time: f32, width: u32, height: u32) {
    var grid = texture3d::<Rgba16Float>(width: 24, height: 24, depth: 24)
    var depths = texture3d::<Rgba16Float>(width: 24, height: 24, depth: 24)
    dispatch(box_volume.bind(mut grid, mut depths), over: grid)
    let b = Bake { mid: vec3(0.0), half: 1.0, leaves: Leaves {}, bark: Bark {} }
    let bounds = buffer_of(Vec::filled(VIEWS * VIEWS, vec4(-1.0, -1.0, 1.0, 1.0)))
    let marks = buffer_of([vec2u(16383 << 14, 0)])
    var cases: Vec<Instance> = Vec::new()
    for k in 0..48 {
        cases.push(instance(0.5 + 0.5 * f32(k / 16)))
    }
    let placed = buffer_of(cases)
    let s = sampler()
    var ids = texture::<R32Uint>(width: 192, height: 128)
    var depth = depth_texture(width: 192, height: 128)
    let pass = begin_pass_with_depth(mut ids, mut depth, clear_depth: 0.0)
    for k in 0..6 {
        var cam = camera(k / 3)
        // Embed this 64-pixel camera in its panel without changing eye, rays or depth.
        let panel = mat4(
            vec4(1.0 / 3.0, 0.0, 0.0, 0.0),
            vec4(0.0, 0.5, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4((f32(k % 3) * 2.0 - 2.0) / 3.0, (1.0 - f32(k / 3) * 2.0) / 2.0, 0.0, 1.0),
        )
        cam.view_proj = panel * cam.view_proj
        draw(
            pass,
            far_quad.bind(
                cam,
                wind: Wind { time: 0.0, dir: vec2(1.0, 0.0), strength: 0.0 },
                b: b,
                instances: placed.span(start: (k % 3) * 16, count: 1),
                marks: marks.items(),
                bounds: bounds.items(),
                first: k,
                front: 0,
            ),
            volume_cut.bind(cam, b, grid, grid_depth: depths, s: s, cell: 1.0),
            vertices: 6,
            depth: Depth { compare: Compare::Greater, write: true },
        )
    }
    pass.end()
    let pass = begin_screen_pass(clear: vec4(0.0))
    fullscreen(pass, report.bind(ids, depth))
    pass.present()
}
