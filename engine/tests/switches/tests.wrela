// The tool test: the frame fixture (engine/tests/frame, a bare scene) built twice, its air's
// switch on and off (`--set FOG=false`: its switches' `FOG`), with the engine read from the
// workspace, and each build's pipelines and shaders read from its manifest.

use hosts::steps::{built, text_of}
use std::io::print
use std::json::{Doc, TOP, parse}
use std::tool::toolchain
use std::tool::toolchain::{Override, Set}

/// The froxels' entry points (`engine::fog`): their volume's two kernels, and the sky drawn
/// through them.
const FOG_ENTRIES: [Text; 3] = ["inject", "integrate", "sky_fogged"]

/// The bare scene's lit surface's shading (`terrain::ground_shade`): the pass whose shader the
/// switch's fold shortens.
const SHADING: Text = "ground_shade"

/// A build's pipelines: each one's entry points, and its shading's WGSL bytes.
struct Built: Clone {
    entries: Vec<String>,
    shading: u32,
}

/// Whether `b` has a pipeline whose entry point is `e`.
fn has(b: Built, e: str) -> bool {
    for x in b.entries {
        if x.as_str() == e {
            return true
        }
    }
    false
}

/// The text of `key` of object `n`, or empty.
fn text_at(d: Doc, n: u32, key: str) -> String {
    match d.get(n, key) {
        Some(v) => match d.text(v) {
            Some(t) => t,
            None => String::new(),
        },
        None => String::new(),
    }
}

/// The fixture built with its fog `fog`, read from its manifest.
fn fixture(fog: bool) -> Built {
    let out = if fog { "scratch/fogged" } else { "scratch/clear" }
    var options = toolchain::options()
    options.overrides = Vec::from(
        [Override { name: String::from("engine"), dir: String::from("repo/engine") }],
    )
    options.set = Vec::from(
        [Set { name: String::from("FOG"), value: String::from(if fog { "true" } else {
            "false"
        }) }],
    )
    built("repo/engine/tests/frame", out, options, "the fixture builds")
    let manifest = text_of(f"{out}/manifest.json")
    let Some(d) = parse(manifest.as_str()) else { panic("the manifest is JSON") }
    let Some(list) = d.get(TOP, "pipelines") else { panic("the manifest's pipelines") }
    var entries: Vec<String> = Vec::new()
    var shading: u32 = 0
    for k in 0..d.count(list) {
        let Some(p) = d.at(list, k) else { continue }
        let render = text_at(d, p, "kind").as_str() == "render"
        let fragment = text_at(d, p, "fragment_entry")
        entries.push(if render { fragment.clone() } else { text_at(d, p, "entry") })
        if render && fragment.as_str() == SHADING {
            shading += text_of(f"{out}/{text_at(d, p, "shader").as_str()}").len()
        }
    }
    Built { entries, shading }
}

/// With its fog off, the bare scene builds no pipeline of the froxels (the sky drawn without
/// them, `sky_shade`) and its ground's shading shader is smaller: the fog's read folded out.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn a_switch_thats_off_builds_none_of_its_path() {
    let on = fixture(true)
    let off = fixture(false)
    print(
        f"fog on: {on.entries.len()} pipelines, the ground's shading {on.shading} bytes; off: {off.entries.len()} pipelines, {off.shading} bytes",
    )
    for e in FOG_ENTRIES {
        assert(has(on, e), f"the fogged build has no `{e}`")
        assert(!has(off, e), f"the clear build has `{e}`")
    }
    assert(has(off, "sky_shade"), "the clear build's sky")
    assert(on.shading > 0, "the fogged build's ground shading")
    assert(off.shading > 0 && off.shading < on.shading, "the clear build's shading is smaller")
}
