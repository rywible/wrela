// The tool test: it builds this package through the toolchain service, then drives its ticks on
// the native host's CPU, with no helpers, one or seven, and with each job's result held 100 ms
// (so tick 10 waits for the job tick 2 asked for). The ticks before 20 run, and tick 20 traps
// with the job's message. The bound holds on a loaded machine too: the result is held whichever
// thread ran the job, a helper or tick 10 itself when no helper took it in time (with no
// helpers, always), and load only makes the ticks slower.

use std::input::Script
use std::tool::drive
use std::tool::toolchain

/// Each run: how many threads run jobs (the program's own among them), and how long each job's
/// result is held, in microseconds.
const RUNS: [(u32, u32); 6] = [(1, 0), (2, 0), (8, 0), (1, 100000), (2, 100000), (8, 100000)]

@test(tool, read: [("repo", "../../..")], budget: 120)
@job
fn a_trapping_job_traps_at_the_tick_that_takes_it() {
    var b = toolchain::build("repo/engine/tests/run-jobs", "scratch/build", toolchain::options())
    var built = b.poll()
    while built.is_none() {
        yield
        built = b.poll()
    }
    let Some(polled) = take built else { panic("no answer") }
    let Ok(build) = toolchain::read_built(take polled) else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the package builds")
    for run in RUNS {
        let (workers, hold) = run
        var options = drive::cpu()
        options.workers = workers
        options.hold = hold
        var l = drive::load("scratch/build", options)
        var loaded = l.poll()
        while loaded.is_none() {
            yield
            loaded = l.poll()
        }
        let Some(lp) = take loaded else { panic("no answer") }
        let Ok(it) = drive::read_loaded(take lp) else { panic("the build loads") }
        let h = it.build
        var i = drive::init(h)
        var inited = i.poll()
        while inited.is_none() {
            yield
            inited = i.poll()
        }
        let Some(ip) = take inited else { panic("no answer") }
        let Ok(init) = drive::read_ran(take ip) else { panic("init's request") }
        assert(init.trap.is_none(), "init runs")
        var asked = 0.0
        for k in 0..21 {
            var t = drive::ticks(h, 1, Script::ticks())
            var ticked = t.poll()
            while ticked.is_none() {
                yield
                ticked = t.poll()
            }
            let Some(tp) = take ticked else { panic("no answer") }
            let Ok(ran) = drive::read_ran(take tp) else { panic("the tick's request") }
            if k < 20 {
                if let Some(trap) = ran.trap {
                    panic(f"{workers} threads, held {hold}: tick {k}: {trap.message.as_str()}")
                }
                let step = ran.steps[0]
                if k == 2 {
                    asked = step.start
                }
                if k == 10 && hold > 0 {
                    let since = (step.end - asked) * 1000.0
                    assert(
                        since >= 95.0,
                        f"{workers} threads: tick 10 ended {since} ms after the ask",
                    )
                }
            } else {
                // Tick 20 takes the trapping job.
                let Some(trap) = ran.trap else {
                    panic(f"{workers} threads, held {hold}: tick 20 runs")
                }
                let m = trap.message.as_str()
                assert(
                    m.find("in tick 20").is_some() && m.find("a job's input was 13").is_some(),
                    f"{workers} threads, held {hold}: {m}",
                )
                assert(trap.stage == drive::Stage::Tick && trap.number == 20)
                assert(ran.steps.len() == 0, "tick 20 didn't end")
            }
        }
        var c = drive::close(h)
        while c.poll().is_none() { yield }
    }
}
