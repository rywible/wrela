// The tool test: it builds this package through the toolchain service, then drives its ticks on
// the native host's CPU, with no helpers, one or seven, and with each job's result held 100 ms
// (so tick 10 waits for the job tick 2 asked for). The ticks before 20 run, and tick 20 traps
// with the job's message. The bound holds on a loaded machine too: the result is held whichever
// thread ran the job, a helper or tick 10 itself when no helper took it in time (with no
// helpers, always), and load only makes the ticks slower.

use std::input::Script
use std::tool::drive
use std::tool::drive::{Stage, Step}
use std::tool::toolchain

/// Each run: how many threads run jobs (the program's own among them), and how long each job's
/// result is held, in microseconds.
const RUNS: [(u32, u32); 6] = [(1, 0), (2, 0), (8, 0), (1, 100000), (2, 100000), (8, 100000)]

@test(tool, read: [("repo", "../../..")], budget: 120)
fn a_trapping_job_traps_at_the_tick_that_takes_it() {
    built()
    for run in RUNS {
        let (workers, hold) = run
        var options = drive::cpu()
        options.workers = workers
        options.hold = hold
        // `init`, then 21 ticks, each a step of its own: step `k + 1` is tick `k`.
        var list: Vec<Step> = Vec::from([Step::Init])
        for _ in 0..21 {
            list.push(Step::Ticks(1, Script::ticks()))
        }
        let Ok(seen) = drive::run("scratch/build", options, list).wait() else {
            panic("the build loads and runs")
        }
        // Tick 20 takes the trapping job: `init` and the ticks before it run.
        let Some(trap) = seen.trap else { panic(f"{workers} threads, held {hold}: tick 20 runs") }
        let m = trap.message.as_str()
        assert(trap.step == 21, f"{workers} threads, held {hold}: step {trap.step}: {m}")
        assert(
            m.find("in tick 20").is_some() && m.find("a job's input was 13").is_some(),
            f"{workers} threads, held {hold}: {m}",
        )
        assert(trap.stage == Stage::Tick && trap.number == 20)
        assert(seen.ran.len() == 22, "init and each tick ran")
        for k in 0..20 {
            assert(seen.ran[k + 1].spans.len() == 1, f"tick {k} ended")
        }
        assert(seen.ran[21].spans.len() == 0, "tick 20 didn't end")
        if hold > 0 {
            let asked = seen.ran[3].spans[0].start
            let since = (seen.ran[11].spans[0].end - asked) * 1000.0
            assert(since >= 95.0, f"{workers} threads: tick 10 ended {since} ms after the ask")
        }
    }
}

/// A trap's stage and number are the host's: tick 20's trap, reached by frames then ticks, or
/// by frames alone, is in tick 20, as its message says.
@test(tool, read: [("repo", "../../..")], budget: 120)
fn a_trap_is_numbered_by_the_tick_the_host_ran() {
    built()
    // Frames then ticks, and frames alone: either way the trap is in tick 20, which a lockstep
    // frame runs as much as `ticks` does.
    for ticks_after in [true, false] {
        var options = drive::cpu()
        options.workers = 2
        var list: Vec<Step> = Vec::from([Step::Init])
        list.push(Step::Frames(if ticks_after { 10 } else { 40 }, Script::frames()))
        if ticks_after {
            list.push(Step::Ticks(20, Script::ticks()))
        }
        let Ok(seen) = drive::run("scratch/build", options, list).wait() else {
            panic("the build loads and runs")
        }
        let Some(trap) = seen.trap else { panic("tick 20 traps") }
        let m = trap.message.as_str()
        // Ten frames run the ticks before 20: the ticks after them trap.
        assert(trap.step == if ticks_after { 2 } else { 1 }, f"step {trap.step}: {m}")
        assert(m.find("in tick 20").is_some(), m)
        assert(
            trap.stage == Stage::Tick && trap.number == 20,
            f"stage, number {trap.number}: {m}",
        )
        assert(trap.panic.as_str() == "a job's input was 13", trap.panic.as_str())
    }
}

/// This package built into `scratch/build`, with no error.
fn built() {
    let options = toolchain::options()
    let made = toolchain::build("repo/engine/tests/run-jobs", "scratch/build", options).wait()
    let Ok(build) = made else { panic("the build's request") }
    for d in build.diagnostics {
        assert(!d.error, d.rendered.as_str())
    }
    assert(build.ok, "the package builds")
}
