// The marks (engine::marks, docs/plan-world-class-3.md §D7a): `marks::sample` on a plane under a
// moving eye, as a look's marks would be drawn there; and the frame fixture drawn in a look whose
// marks are dots.

use engine::marks
use engine::marks::{darkness, sample}
use engine::substance
use engine::view::{Camera, first_camera}
use hosts::both::bytes_of
use hosts::steps::built
use std::io::print
use std::tool::drive
use std::tool::drive::Step
use std::tool::toolchain
use std::tool::toolchain::{Override, Set}
use styles::fixtures::{DOT_PX, Dotted}

/// The plane's normal and the marks' direction on it.
const UP: vec3 = vec3(0.0, 1.0, 0.0)
const ALONG: vec3 = vec3(1.0, 0.0, 0.0)

/// An eye `d` metres from the plane's point `p`, looking down at it at 40°, a 1080-pixel screen.
fn eye_at(p: vec3, d: f32) -> Camera {
    let look = normalize(vec3(0.0, -0.64, 0.77))
    first_camera(p - look * d, p, 0.82, width: 1920, height: 1080)
}

/// A mark on a plane keeps its surface point under a 1 m dolly: the mark of the lattice both eyes
/// share (the coarser of the nearer eye's two, or the same level) is anchored at the same point,
/// so its screen position moves as the surface point's projection does (within a pixel).
@test
fn a_mark_keeps_its_surface_point_under_a_dolly() {
    var worst = 0.0
    var checked = 0
    for k in 0..200 {
        let p = vec3(f32(k % 20) * 0.37 - 3.0, 0.0, f32(k / 20) * 0.41 + 1.0)
        for d0 in [6.0, 15.0, 40.0] {
            let (a, b) = (eye_at(p, d0), eye_at(p, d0 - 1.0))
            let fa = a.footprint(d0)
            let fb = b.footprint(d0 - 1.0)
            let sa = sample(marks::STROKES, p, UP, ALONG, fa, DOT_PX)
            let sb = sample(marks::STROKES, p, UP, ALONG, fb, DOT_PX)
            let (ka, _) = marks::level_of(fa, DOT_PX)
            let (kb, _) = marks::level_of(fb, DOT_PX)
            // The lattice both have: the same level's, or the nearer eye's coarser one.
            let (ca, cb) = if ka == kb { (sa.fine.at, sb.fine.at) } else {
                (sa.fine.at, sb.coarse.at)
            }
            if ka != kb && kb + 1 != ka {
                continue
            }
            let moved = length(b.pixel(ca) - b.pixel(cb))
            worst = max(worst, moved)
            checked += 1
        }
    }
    print(f"{checked} marks under a 1 m dolly: their anchors' screen positions within {worst} px")
    assert(checked > 300, f"only {checked} shared a lattice")
    assert(worst < 1.0, f"a mark slid {worst} px")
}

/// A mark's size in pixels stays within 10 % of its look's as the eye dollies from 2 m to 400 m:
/// its two octaves' spacings, blended across the octave, over the pixel's footprint.
@test
fn a_marks_size_holds_under_a_dolly() {
    var lo = 1.0e9
    var hi = 0.0
    for k in 0..2000 {
        let d = 2.0 * pow(200.0, f32(k) / 2000.0)
        let foot = eye_at(vec3(0.0), d).footprint(d)
        let (level, f) = marks::level_of(foot, DOT_PX)
        let spacing = mix(exp2(f32(level)), exp2(f32(level + 1)), f)
        let px = spacing / foot
        lo = min(lo, px)
        hi = max(hi, px)
    }
    print(f"a {DOT_PX}-pixel mark from 2 m to 400 m: {lo} to {hi} px")
    assert(lo >= DOT_PX * 0.9 && hi <= DOT_PX * 1.1, f"its size ran {lo} to {hi} px")
}

/// Crossing an octave, the two lattices' marks blend: as the eye pulls back over two octaves (a
/// frame each 1 % further), no pixel's darkness steps by half or more between frames (a mark
/// appearing whole): the largest step at any of 400 surface points.
@test
fn marks_blend_across_an_octave() {
    var worst = 0.0
    var most = 0.0
    for k in 0..400 {
        let p = vec3(f32(k % 20) * 0.53 - 5.0, 0.0, f32(k / 20) * 0.47)
        var last = -1.0
        for t in 0..140 {
            let foot = 0.002 * pow(1.01, f32(t))
            let dark = darkness::<Dotted>(marks::STROKES, p, UP, ALONG, foot, substance::NONE)
            most = max(most, dark)
            if last >= 0.0 {
                worst = max(worst, abs(dark - last))
            }
            last = dark
        }
    }
    print(
        f"two octaves at 400 points: the largest step between frames {worst} (a dot's darkness {most})",
    )
    assert(most > 0.3, "no dot was drawn")
    assert(worst < 0.5, f"a mark stepped {worst} between frames")
}

/// The screen of the frame fixture built in look `look`, after three seconds of frames.
fn screen_of(look: str, out: str) -> Vec<u8> {
    var options = toolchain::options()
    options.overrides = Vec::from(
        [
            Override { name: String::from("engine"), dir: String::from("repo/engine") },
            Override { name: String::from("styles"), dir: String::from("repo/content/styles") },
        ],
    )
    options.set = Vec::from([Set { name: String::from("LOOK"), value: String::from(look) }])
    built("repo/engine/tests/frame", out, options, "the fixture builds")
    var load = drive::gpu()
    load.width = 320
    load.height = 180
    var steps: Vec<Step> = Vec::from([Step::Init])
    for k in 1..181 {
        steps.push(Step::FrameAt(f32(k) / 60.0))
    }
    steps.push(Step::Capture)
    let Ok(seen) = drive::run(out, load, steps).wait() else { panic("the fixture draws on a GPU") }
    if let Some(trap) = seen.trap {
        panic(trap.message.as_str())
    }
    bytes_of(seen.captures[0].rgba.clone())
}

/// The marks pass draws on the GPU: the frame fixture in the dots' look differs from it in the
/// physical look on its ground (its lower third, a dot in about five of its pixels), and is the
/// same in its sky (the top rows), which has no marks.
@test(tool, read: [("repo", "../../..")], budget: 600)
fn the_marks_pass_draws_a_looks_marks() {
    let plain = screen_of("styles::physical::Physical", "scratch/plain")
    let dotted = screen_of("styles::fixtures::Dotted", "scratch/dotted")
    var ground = 0
    var sky = 0
    for y in 0..180 {
        for x in 0..320 {
            let at = 4 * (y * 320 + x)
            var d = 0
            for c in 0..3 {
                d = max(d, abs(i32(plain[at + c]) - i32(dotted[at + c])))
            }
            if d > 0 {
                if y >= 120 {
                    ground += 1
                } else if y < 20 {
                    sky += 1
                }
            }
        }
    }
    var lit = 0
    for k in 0..plain.len() / 4 {
        lit += u32(plain[4 * k]) + u32(plain[4 * k + 1]) + u32(plain[4 * k + 2])
    }
    print(
        f"pixels the dots changed: {ground} of the ground's 19,200, {sky} of the sky's 6,400 (the physical screen's mean {f32(lit) / f32(plain.len() / 4 * 3)})",
    )
    assert(ground > 2000, f"the dots changed {ground} of the ground's pixels")
    assert(sky == 0, f"the dots changed {sky} of the sky's pixels")
}
