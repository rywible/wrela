// A bare scene (flat ground, which casts into the cascades, open land, the sky's own clouds) drawn
// through `engine::frame` on the GPU, and a script of what a game does to a frame: it loads; 30
// frames after its first full frame the eye jumps 500 m; once that arrival is shown, the weather
// changes; 90 frames later the air does, and 90 after that the sun moves; once its cascades are
// drawn again, the sun moves every frame for 120 frames; then the screen is held for 8 frames;
// then the frame measures its work on this device
// (`Quality::measured`), and its cascades and probes are drawn again to be measured; 400 frames
// later the screen is resized to half, and the frame goes on measuring. Each frame's
// plan (`engine::cook::Planner`) and readiness are recorded, and the tests read the record. Until
// it measures, a frame's order is the same on every run and in both hosts.

use engine::cook::{Evidence, Work}
use std::io::print
use engine::frame::{Aim, Change, Frame, Gathered, Quality}
use engine::switches::Switches
use styles::physical::Physical
use engine::air::{AIR_SLICES, hazy}
use engine::light::{SUN_TOP, sunlight}
use engine::probes::grid
use engine::terrain::Clipmap
use engine::view::first_camera
use bare::{AHEAD, Bare, START, SUN, air_of, bare}

/// The bare scene's air: froxels, or clear (`engine/tests/switches` builds it both ways, `--set
/// FOG=false`).
pub const FOG: bool = true

/// The fixture's switches: the approved, its air as `FOG` says.
pub struct Bared {}

impl Switches for Bared {
    const FOG: bool = FOG
}

/// Where the sun moves to, and where the eye jumps to (the world's, m).
const LATER_SUN = vec3(0.6, 0.6, 0.53)
const JUMPED = vec3(500.0, 1.6, 0.0)

/// A frame's record: frames run and drawn, the plan (each kind's steps, the estimated
/// microseconds spent, the ground levels cooked) and the readiness after it.
pub struct Record: Copy {
    pub ran: u32,
    pub drawn: u32,
    pub levels: u32,
    pub near: u32,
    pub far: u32,
    pub weather: u32,
    pub noise: u32,
    pub phase: u32,
    pub probes: u32,
    /// The slices of the air's tables cooked, and the sets of strips each cascade has drawn whole.
    pub air: u32,
    pub near_sets: u32,
    pub far_sets: u32,
    /// The strips the probes in use have been traced again, and whether new probes are being
    /// baked beside them.
    pub agains: u32,
    pub rebaking: bool,
    pub spent: f32,
    /// The plan's mandatory and optional costs apart, its first optional step's, and its budget.
    pub mandatory: f32,
    pub optional: f32,
    pub first_optional: f32,
    pub limit: f32,
    pub playable: bool,
    pub near_ready: bool,
    pub arriving: bool,
    pub gathered: u32,
    pub jumped: bool,
    pub sky_frames: u32,
}

/// The script's steps, in order.
pub enum Step: Copy + Eq {
    Load,
    Jump,
    Weather,
    Air,
    Sun,
    Moving,
    Hold,
    Done,
    Resized,
}

pub struct State {
    pub frame: Frame<Gathered, Bared, Physical>,
    pub scene: Bare,
    pub step: Step,
    /// The frame each step began at (`Record::ran`), in `Step`'s order.
    pub began: Vec<u32>,
    pub records: Vec<Record>,
    eye: vec3,
    /// Whether the screen is half its size (`Step::Resized`).
    small: bool,
}

pub fn init() -> State {
    let air = air_of(SUN)
    // Not measuring until the script's last step: until then a frame's order is the same on
    // every run and in both hosts, which the tests of order read.
    let frame: Frame<Gathered, Bared, Physical> = Frame::new(
        Quality { measured: false },
        sunlight(air),
        air,
        Clipmap::new(levels: 6, finest: 0.5),
        first_camera(START, START + AHEAD, 0.82, width: 320, height: 180),
        grid(START.xz, cols: 17, spacing: 4.0, low: -8.0, high: 24.0, voxel: 2.0),
        START.xz,
    )
    State {
        frame,
        scene: bare(),
        step: Step::Load,
        began: Vec::from([0]),
        records: Vec::new(),
        eye: START,
        small: false,
    }
}

/// The next step, begun at frame `at`.
fn next(s: mut State, step: Step) {
    s.step = step
    s.began.push(s.frame.ran)
}

/// The script: what the game does before this frame.
fn script(s: mut State) {
    let ran = s.frame.ran
    let since = ran - s.began[s.began.len() - 1]
    match s.step {
        Step::Load => if let Some(at) = s.frame.ready.playable_at {
            if s.frame.frames >= at + 30 {
                next(mut s, Step::Jump)
                s.eye = JUMPED
            }
        },
        Step::Jump => if !s.frame.ready.arriving && since > 1 && since >= 30 {
            next(mut s, Step::Weather)
            s.frame.changed(Change::Weather)
        },
        Step::Weather => if since >= 90 {
            next(mut s, Step::Air)
            // Hazier air for an eye higher up, the sun where it was.
            s.frame.air = hazy(SUN, SUN_TOP, eye: 40.0)
        },
        Step::Air => if since >= 90 {
            next(mut s, Step::Sun)
            s.frame.air = air_of(LATER_SUN)
            s.frame.light = sunlight(s.frame.air)
        },
        Step::Sun => if since >= 30 && s.frame.near.settled() && s.frame.far.settled() {
            next(mut s, Step::Moving)
        },
        Step::Moving => if since >= 120 {
            next(mut s, Step::Hold)
            s.frame.hold = true
        } else {
            // The sun turns round the vertical a fifth of a degree a frame.
            let a = f32(since + 1) * 0.0035
            let (c, n) = (cos(a), sin(a))
            let sun = vec3(
                LATER_SUN.x * c - LATER_SUN.z * n,
                LATER_SUN.y,
                LATER_SUN.x * n + LATER_SUN.z * c,
            )
            s.frame.air = air_of(normalize(sun))
            s.frame.light = sunlight(s.frame.air)
        },
        Step::Hold => if since >= 8 {
            next(mut s, Step::Done)
            s.frame.hold = false
            s.frame.requality(Quality { measured: true })
            s.frame.changed(Change::Casters)
            s.frame.changed(Change::Occluders)
        },
        Step::Done => if since >= 400 {
            next(mut s, Step::Resized)
            s.small = true
        },
        Step::Resized => {},
    }
}

pub fn frame(s: mut State, time: f32, width: u32, height: u32) {
    script(mut s)
    let aim = Aim { eye: s.eye, at: s.eye + AHEAD, fovy: 0.82, moving_at: s.eye }
    let (w, h) = if s.small { (width / 2, height / 2) } else { (width, height) }
    let _ = s.frame.begin(mut s.scene, aim, time, w, h)
    s.frame.draw(mut s.scene, aim)
    borrow p = s.frame.cooks.planner
    s.records.push(
        Record {
            ran: s.frame.ran,
            drawn: s.frame.frames,
            levels: p.ran(Work::TerrainLevel),
            near: p.ran(Work::NearStrip),
            far: p.ran(Work::FarStrip),
            weather: p.ran(Work::SkyWeather),
            noise: p.ran(Work::SkyNoise),
            phase: p.ran(Work::SkyPhase),
            probes: p.ran(Work::ProbeStrip) + p.ran(Work::ProbeAgain),
            air: p.ran(Work::AirTables),
            near_sets: s.frame.near.sets,
            far_sets: s.frame.far.sets,
            agains: s.frame.probes.using.agains,
            rebaking: s.frame.probes.next.is_some(),
            spent: p.spent(),
            mandatory: p.spent_mandatory(),
            optional: p.spent_optional(),
            first_optional: p.first_optional(),
            limit: p.limit(),
            playable: s.frame.ready.playable_at.is_some(),
            near_ready: s.frame.near.ready,
            arriving: s.frame.ready.arriving,
            gathered: s.frame.ready.gathered,
            jumped: s.frame.jumped,
            sky_frames: s.frame.sky.frames,
        },
    )
}

/// Once playable, no frame plans work past twice its budget: what the planner spends, the
/// ground's levels and a noted cook of the sky's included (§B4: every kind past that is cooked
/// a slice at a time). And the clouds' noise and weather at load are cooked a slice a step over
/// at least 8 frames, where they were a frame each; a weather change in play cooks all its bands.
@test(frames: 1100, gpu: true)
fn no_playable_frame_plans_past_twice_its_budget_and_the_sky_is_sliced(s: State) {
    reached(s, Step::Air)
    var worst = 0.0
    for r in s.records {
        if r.playable && !r.arriving {
            worst = max(worst, r.spent / max(r.limit, 1.0))
        }
    }
    print(f"the heaviest playable frame planned {worst:.2} of its budget")
    assert(worst <= 2.0, f"a playable frame planned {worst:.2} of its budget")
    let (from, to) = window(s, 0)
    var load = 0
    var noise = 0
    for i in from..to {
        let r = s.records[i]
        noise += r.noise
        load += if r.noise + r.weather > 0 { 1 } else { 0 }
    }
    print(f"the load's sky: {noise} slices of noise, the noise and the weather over {load} frames")
    assert(noise == 9 && load >= 8, f"the load's sky cooked over {load} frames")
    let (from, to) = window(s, 2)
    var weather = 0
    var frames = 0
    var most = 0
    for i in from..to {
        let w = s.records[i].weather
        weather += w
        frames += if w > 0 { 1 } else { 0 }
        most = max(most, w)
    }
    print(f"the weather change: {weather} bands over {frames} frames, {most} at most in one")
    assert(weather >= 8, f"the weather change cooked {weather} bands")
}

/// The frames of step `k` (`Step`'s order): from the frame it began at to the next one's.
fn window(s: State, k: u32) -> (u32, u32) {
    let from = s.began[k]
    let to = if k + 1 < s.began.len() { s.began[k + 1] } else { s.records.len() }
    (from, to)
}

/// The steps the script reached, failing a test that needs one it didn't.
fn reached(s: State, step: Step) {
    let names = ["load", "jump", "weather", "air", "sun", "moving", "hold", "done", "resized"]
    var k = 0
    for st in [
        Step::Load,
        Step::Jump,
        Step::Weather,
        Step::Air,
        Step::Sun,
        Step::Moving,
        Step::Hold,
        Step::Done,
        Step::Resized,
    ] {
        if st == step {
            assert(s.began.len() > k, f"the script didn't reach its {names[k]} by its last frame")
        }
        k += 1
    }
}

/// Through the frames of steps `k` to `last` (`what` names them), the probes in use were traced
/// again (`Quality`'s `probes.again`: they take the new sky as they're traced) and no new ones
/// were baked.
fn traced_not_rebaked(s: State, k: u32, last: u32, what: str) {
    let (from, _) = window(s, k)
    let (_, to) = window(s, last)
    for i in from..to {
        assert(!s.records[i].rebaking, f"{what}: frame {s.records[i].ran} baked new probes")
    }
    let traced = s.records[to - 1].agains - s.records[from].agains
    assert(traced > 0, f"{what}: the probes weren't traced again")
}

/// A change of the weather, the air or the sun, and a sun that moves every frame, are traced into
/// the probes in use: none bakes new ones. (The sun's change is traced once the dome is marched
/// again under it, after its cascades: as it begins to move.)
@test(frames: 1100, gpu: true)
fn the_sky_and_the_sun_are_traced_into_the_probes_in_use(s: State) {
    reached(s, Step::Hold)
    traced_not_rebaked(s, k: 2, last: 2, what: "the weather")
    traced_not_rebaked(s, k: 3, last: 3, what: "the air")
    traced_not_rebaked(s, k: 4, last: 5, what: "the sun, then the moving sun")
    traced_not_rebaked(s, k: 5, last: 5, what: "the moving sun")
}

/// The planner's rules hold on every frame, the jump's included: a frame that cooked ground
/// levels draws no strip of a cascade once the near one is ready; a playable frame that cooked the
/// ground or drew a strip bakes no probes; one that cooked two levels marches no sky; and the
/// optional work keeps to the budget, but for a frame's first step.
@test(frames: 1100, gpu: true)
fn the_planners_rules_hold_on_every_frame(s: State) {
    reached(s, Step::Done)
    let budget = engine::cook::Budget {}
    for r in s.records {
        if r.levels > 0 && r.near_ready {
            assert(r.near == 0 && r.far == 0, f"frame {r.ran} drew a strip as the ground moved")
        }
        if r.playable && (r.levels > 0 || r.near + r.far > 0) {
            assert(r.probes == 0, f"frame {r.ran} baked probes beside a cooked ground or strip")
        }
        if r.playable && r.levels >= 2 {
            assert(r.phase == 0, f"frame {r.ran} marched the sky as the ground moved")
        }
        let limit = if r.playable { budget.playing_us } else { budget.loading_us }
        let steps = r.near + r.far + r.probes + r.phase
        assert(r.spent <= limit || steps <= 1, f"frame {r.ran} spent {r.spent} us of {limit}")
    }
}

/// A jump is covered from its frame until the light round the new eye has been drawn, then for
/// as many consecutive lit frames as an arrival gathers, and it ends then; nothing is gathered
/// while the light isn't drawn.
@test(frames: 1100, gpu: true)
fn a_jump_is_covered_until_its_light_has_gathered(s: State) {
    reached(s, Step::Weather)
    let gather = engine::frame::Arrival {}.gather
    let (from, to) = window(s, 1)
    var jumped_at: Option<u32> = None
    for i in from..to {
        if s.records[i].jumped {
            jumped_at = Some(i)
        }
    }
    let Some(j) = jumped_at else { panic("the eye's 500 m move wasn't taken as a jump") }
    var last = 0
    var ended: Option<u32> = None
    for i in j..to {
        let r = s.records[i]
        if !r.arriving {
            ended = Some(i)
            break
        }
        assert(r.gathered == 0 || r.gathered == last + 1, f"frame {r.ran}: gathered {r.gathered}")
        last = r.gathered
    }
    let Some(e) = ended else { panic("the jump's arrival didn't end") }
    assert(s.records[e].gathered >= gather || last + 1 >= gather, "it ended before it gathered")
    assert(e - j >= gather, f"it was covered {e - j} frames, fewer than the {gather} it gathers")
    var near = 0
    var probes = 0
    for i in j..e {
        near += s.records[i].near
        probes += s.records[i].probes
    }
    assert(near > 0 && probes > 0, "the cascade and the probes weren't drawn round the new eye")
}

/// A weather change cooks the clouds' weather again (a band a step) and then starts the dome's
/// march again, draws no cascade, and bakes the probes again once the dome is marched (they
/// bake its light).
@test(frames: 1100, gpu: true)
fn a_weather_change_redraws_the_clouds_and_then_the_probes(s: State) {
    reached(s, Step::Air)
    let (from, to) = window(s, 2)
    var weather = 0
    var near = 0
    for i in from..to {
        weather += s.records[i].weather
        near += s.records[i].near + s.records[i].far
    }
    assert(weather >= 1, "the clouds' weather wasn't cooked again")
    assert(near == 0, f"the weather drew {near} strips of the cascades")
    // Once the weather map is whole (a band a step, the old dome in use meanwhile), the dome is
    // marched afresh, and the probes bake only once it has been.
    var restart = to
    for i in from..to {
        if restart == to && s.records[i].sky_frames <= 1 {
            restart = i
        }
    }
    assert(restart < to, "the dome's march didn't start again")
    var probes = 0
    var marched = 0
    var baked_after = 0
    for i in restart..to {
        // A frame's phase is marched before its probes' step.
        if probes == 0 {
            marched += s.records[i].phase
        }
        probes += s.records[i].probes
        if probes > 0 && baked_after == 0 {
            baked_after = marched
        }
    }
    assert(probes > 0, "the probes weren't baked again under the new weather")
    assert(
        baked_after >= engine::sky::PHASES,
        f"the probes were baked after {baked_after} of the dome's {engine::sky::PHASES} phases",
    )
}

/// An air change with the sun where it was cooks the air's tables again, marches the dome again
/// through the new air, and bakes the probes again under that dome; it draws no cascade.
@test(frames: 1100, gpu: true)
fn an_air_change_redraws_the_dome_and_then_the_probes(s: State) {
    reached(s, Step::Sun)
    let (from, to) = window(s, 3)
    var near = 0
    var probes = 0
    var marched = 0
    var baked_after = 0
    for i in from..to {
        near += s.records[i].near + s.records[i].far
        // A frame's phase is marched before its probes' step.
        if probes == 0 {
            marched += s.records[i].phase
        }
        probes += s.records[i].probes
        if probes > 0 && baked_after == 0 {
            baked_after = marched
        }
    }
    assert(near == 0, f"the air drew {near} strips of the cascades")
    assert(probes > 0, "the probes weren't baked again under the new air")
    assert(
        baked_after >= engine::sky::PHASES,
        f"the probes were baked after {baked_after} of the dome's {engine::sky::PHASES} phases",
    )
}

/// A sun change draws both cascades again and cooks the clouds' weather again (it's lit from the
/// sun); the probes are baked again under it once the dome has been marched again (they bake its
/// light), which is after the cascades.
@test(frames: 1100, gpu: true)
fn a_sun_change_redraws_the_cascades_the_clouds_and_then_the_probes(s: State) {
    reached(s, Step::Done)
    let (from, to) = window(s, 4)
    var near = 0
    var far = 0
    var weather = 0
    for i in from..to {
        near += s.records[i].near
        far += s.records[i].far
        weather += s.records[i].weather
    }
    assert(near > 0 && far > 0, f"the cascades drew {near} and {far} strips")
    assert(weather >= 1, "the clouds weren't cooked again")
    var baked: Option<u32> = None
    var marched = 0
    for i in from..s.records.len() {
        let r = s.records[i]
        if r.probes > 0 && baked.is_none() {
            baked = Some(i)
        }
        if baked.is_none() {
            marched += r.phase
        }
    }
    let Some(b) = baked else { panic("the probes weren't baked again under the new sun") }
    assert(
        marched >= engine::sky::PHASES,
        f"the probes were baked after {marched} of the dome's {engine::sky::PHASES} phases",
    )
    assert(b > from, "the probes were baked in the sun's own frame")
}

/// A sun that moves every frame (for 120 frames): no frame cooks the air's tables whole, a slice a
/// frame, and they're cooked again through it, each cook finishing with the air it began with;
/// and both cascades complete sets of strips, each drawn from the sun it began with, though every
/// fourth frame draws none (the probes' turn).
@test(frames: 1100, gpu: true)
fn a_moving_sun_cooks_its_air_in_slices_and_completes_its_cascades(s: State) {
    reached(s, Step::Hold)
    let (from, to) = window(s, 5)
    var slices = 0
    for i in from..to {
        let r = s.records[i]
        assert(r.air < AIR_SLICES, f"frame {r.ran} cooked the air's tables whole")
        slices += r.air
    }
    assert(slices >= AIR_SLICES * 4, f"only {slices} slices of the air's tables were cooked")
    let near = s.records[to - 1].near_sets - s.records[from].near_sets
    let far = s.records[to - 1].far_sets - s.records[from].far_sets
    print(f"the moving sun: {slices} slices of the air, {near} near sets and {far} far")
    assert(near >= 3, f"the near cascade completed {near} sets")
    assert(far >= 1, f"the far cascade completed {far} sets")
}

/// A held screen runs frames (it cooks) and draws none; drawing resumes when it's let go.
@test(frames: 1100, gpu: true)
fn a_held_screen_runs_frames_and_draws_none(s: State) {
    reached(s, Step::Done)
    let (from, to) = window(s, 6)
    let drawn = s.records[from].drawn
    for i in from..to {
        assert(s.records[i].drawn == drawn, f"frame {s.records[i].ran} drew while held")
    }
    assert(to - from == 8, f"it was held {to - from} frames")
    // The last frame before the resize, which starts the count of drawn frames again.
    let (_, done) = window(s, 7)
    let last = s.records[done - 1]
    assert(last.drawn > drawn, "drawing didn't resume once it was let go")
}

/// A measuring frame plans with what this device takes: each kind it times, once it has run a
/// step alone, is measured (the records of the cascades' strips moved to this device's), and a
/// time is more than nothing. No test says how small.
@test(frames: 1100, gpu: true)
fn the_planner_measures_this_devices_costs(s: State) {
    reached(s, Step::Done)
    borrow p = s.frame.cooks.planner
    let fresh = engine::cook::Planner::new(engine::cook::Budget {})
    for w in [
        Work::SkyPhase,
        Work::NearStrip,
        Work::FarStrip,
        Work::ProbeOccluders,
        Work::ProbeStrip,
    ] {
        let c = p.cost(w)
        assert(c.evidence == Evidence::Measured && c.us > 0.0, f"a step wasn't measured: {c.us} us")
        assert(c.us != fresh.cost(w).us, f"a step kept the code's cost: {c.us} us")
    }
}

/// The live path, measuring (`Quality::measured`, the default): over 300 measuring frames the
/// order isn't asserted, only the budget's promises. In every frame the optional steps keep to
/// what the budget leaves past the mandatory work, but for the frame's first optional step,
/// which always runs; the mandatory work is never refused; and every kind the frame's changes
/// made eligible ran.
@test(frames: 1500, gpu: true)
fn a_measuring_frame_keeps_the_budgets_promises(s: State) {
    reached(s, Step::Done)
    let (from, to) = window(s, 7)
    assert(to - from >= 300, f"only {to - from} measuring frames")
    var near = 0
    var far = 0
    var probes = 0
    for k in from..to {
        let r = s.records[k]
        if r.optional > r.first_optional {
            assert(
                r.mandatory + r.optional <= r.limit + 0.01,
                f"frame {r.ran} spent {r.mandatory} + {r.optional} of {r.limit}",
            )
        }
        assert(r.spent == r.mandatory + r.optional, f"frame {r.ran}'s costs don't add up")
        near += r.near
        far += r.far
        probes += r.probes
    }
    assert(
        near > 0 && far > 0 && probes > 0,
        f"a kind made eligible didn't run: {near} {far} {probes}",
    )
}

/// A measuring frame resized goes on measuring: a resize starts the frame's count of drawn frames
/// again, and the measuring's own count (`ran`) doesn't, so a kind measured before is asked again
/// in time, and the frames after the resize are drawn.
@test(frames: 2000, gpu: true)
fn a_measuring_frame_goes_on_after_a_resize(s: State) {
    reached(s, Step::Resized)
    let (from, to) = window(s, 8)
    assert(to - from >= 100, f"only {to - from} frames after the resize")
    assert(s.records[to - 1].drawn > 50, "the resized frame didn't draw")
}

/// The frame reads the program's GPU memory against its budget (`Frame::usage`): it holds some,
/// against the proposed total, and the bare scene is within it.
@test(frames: 200, gpu: true)
fn the_frame_reads_its_gpu_memory(s: State) {
    borrow u = s.frame.usage
    print(f"{u.held() / engine::memory::MIB} MiB held, of {u.total / engine::memory::MIB}")
    assert(u.held() > 0, "the frame read no memory")
    assert(u.total == engine::memory::TOTAL && u.over().is_empty(), "the bare scene is over budget")
}

/// The settled bare scene after its jump and its weather is its golden on this machine's GPU,
/// within a GPU's differences.
@test(frames: 200, gpu: true, golden: "goldens/bare.png", within: 1.0)
fn the_bare_scene_is_its_golden(s: State) {}

/// The near cascade, as its last strip's pass left it, is its golden: a strip drawn wrong or
/// into the wrong place shows in its depth.
@test(frames: 200, gpu: true, golden: "goldens/near-cascade.png", pass: "shadows near")
fn the_near_cascade_is_its_golden(s: State) {}

/// Both hosts draw the same frames: Chrome's state hash after the load, the jump and the weather
/// is the native host's, and its last frame is the native host's within a GPU's differences.
@test(frames: 200, gpu: true, hosts: both)
fn both_hosts_draw_the_same_frames(s: State) {}
