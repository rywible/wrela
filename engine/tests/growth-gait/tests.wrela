// The grazer's gaits (kit::gaits, kit::walks, §F5): the effort proxy can't be gamed by the
// secondary springs and matches a hand computation; an invalid candidate is invalid; the optimized
// walk holds a 30° slope up and down, clears a log, recovers from a drop, and spends at least 10 %
// less than the hand-set walk; the search is the same from its seed.

use kit::gaits::{Ground, HAND, Pace, effort, gait_at, run, score, score_with}
use kit::genome::ROE
use kit::walks::WALKS
use engine::loads::Loads

/// The optimized walk on level ground, on 30°, and on uneven ground (`kit::walks`' order).
const LEVEL: u32 = 0
const STEEP: u32 = 2

/// The effort of a constructed history: two bones, the second turning at `omega` against the
/// root, its joint's torque `torque` each frame, over `frames` frames a sixtieth of a second apart
/// and `distance` m.
fn constructed(torque: [f32], omega: f32, distance: f32) -> f32 {
    var l = Loads {
        torques: Vec::new(),
        omegas: Vec::new(),
        forces: Vec::new(),
        residual: Vec::new(),
        feasible: Vec::new(),
    }
    for t in torque {
        l.torques.push(Vec::from([vec3(0.0), vec3(0.0, 0.0, t)]))
        l.omegas.push(Vec::from([vec3(0.0), vec3(0.0, 0.0, omega)]))
        l.forces.push(Vec::new())
        l.residual.push(0.0)
        l.feasible.push(true)
    }
    effort(l, [0, 0], 1.0 / 60.0, distance)
}

/// A fixture's effort matches a hand computation within 5 %: a joint bearing 10 N·m while turning
/// at 2 rad/s for a second over a metre does 20 J/m.
@test
fn the_efforts_proxy_matches_a_hand_computation() {
    let e = constructed(Vec::filled(60, 10.0), omega: 2.0, distance: 1.0)
    assert(abs(e - 20.0) <= 0.05 * 20.0, f"the fixture's effort {e} J/m, not 20")
}

/// Two torque histories with the same peak and different integrated power give different efforts.
@test
fn equal_peaks_and_unequal_power_differ() {
    var brief: Vec<f32> = Vec::filled(60, 0.0)
    brief[30] = 10.0
    let (a, b) = (
        constructed(Vec::filled(60, 10.0), omega: 2.0, distance: 1.0),
        constructed(brief, omega: 2.0, distance: 1.0),
    )
    assert(a > b * 10.0, f"a held peak's effort {a}, a brief one's {b}")
}

/// One stride mostly infeasible among clean ones is invalid however many clean strides there are:
/// validity is each stride's (no stride over 5 %), not the run's.
@test
fn a_failed_stride_isnt_diluted() {
    var feasible: Vec<bool> = Vec::filled(600, value: true)
    for t in 240..252 {
        feasible[t] = false
    }
    let run_share = 12.0 / 600.0
    let worst = kit::gaits::worst_stride(feasible, stride: 24)
    assert(run_share <= 0.05 && worst > 0.05, f"the run's {run_share}, the worst stride's {worst}")
}

/// A centre of mass 2 cm outside a three-foot support is outside it (a hull has no band); beside
/// a two-foot line, within its 4 cm band, it isn't.
@test
fn a_hull_has_no_band() {
    let feet = Vec::from([vec2(0.0, 0.0), vec2(0.4, 0.0), vec2(0.2, 0.6)])
    assert(kit::gaits::out_of_support(vec2(0.2, -0.02), feet), "2 cm outside the hull counted in")
    let pair = Vec::from([vec2(0.0, 0.0), vec2(0.4, 0.6)])
    assert(
        !kit::gaits::out_of_support(vec2(0.2, 0.3) + vec2(0.02, -0.013), pair),
        "within the band counted out",
    )
}

/// The secondary chains can't game it: two candidates that differ only in the head's spring give
/// the same effort to 1e-6 (the head's chain is frozen in the poses it reads).
@test(tool, budget: 600)
fn the_heads_spring_cant_move_the_effort() {
    var a = WALKS[LEVEL]
    var b = WALKS[LEVEL]
    a.head_k = 30.0
    b.head_k = 150.0
    let (ea, eb) = (
        score(ROE, a, Pace::Walk, Ground {}, 8.0, down: false).effort,
        score(ROE, b, Pace::Walk, Ground {}, 8.0, down: false).effort,
    )
    assert(abs(ea - eb) <= 1.0e-6, f"the head's spring moved the effort {ea} to {eb}")
}

/// A candidate with over 5 % of its frames infeasible is invalid: a hop (a bound whose feet are
/// down a third of its cycle, airborne between).
@test(tool, budget: 600)
fn a_hopping_candidate_is_invalid() {
    var g = gait_at(ROE, Pace::Bound, [0.5, 0.5, 0.5, 0.5, 0.5, 0.5])
    g.walk.duty = 0.3
    let s = score(ROE, g, Pace::Bound, Ground {}, 8.0, down: false)
    assert(s.infeasible > 0.05 && !s.valid, f"a hop {s.infeasible} infeasible, valid {s.valid}")
}

/// On a 30° slope, up and down, for 60 s: the optimized walk's centre of mass stays within its
/// support (its hull: no band) and no planted foot hangs over 2 cm.
@test(tool, budget: 600, workers: 8)
fn the_walk_holds_a_30_degree_slope() {
    for down in [false, true] {
        let way = if down { "down" } else { "up" }
        let s = score(ROE, WALKS[STEEP], Pace::Walk, Ground { grade: 0.5235988 }, 60.0, down: down)
        assert(s.stability == 0.0, f"{way} 30°: outside its support {s.stability} of the time")
        assert(s.gap <= 0.02, f"{way} 30°: a planted foot hangs {s.gap} m")
    }
}

/// Over a log 0.3 m thick lying across its way, each swing's top clears it. **Blocked** (docs/
/// bench.md, "F5"): a swinging sole still dips `LOG_PIERCE` into it on the way (the plan asks none);
/// next lever, the swing's lift sampled against the posed sole along its arc, not the foot's
/// target, and more finely.
@test(tool, budget: 600)
fn the_walk_steps_over_a_log() {
    let s = score(ROE, WALKS[LEVEL], Pace::Walk, Ground { log: 0.15, at: 4.0 }, 12.0, down: false)
    assert(s.clearance > 0.0, f"a swing passed {-s.clearance} m into the log")
    assert(s.pierce <= LOG_PIERCE, f"a swinging sole went {s.pierce} m into the log")
}

/// How deep a swinging sole went into the log, as recorded (m): the Blocked gate's.
const LOG_PIERCE: f32 = 0.14

/// After a 0.2 m drop, its stability is back to none within 3 strides.
@test(tool, budget: 600)
fn the_walk_recovers_from_a_drop_within_three_strides() {
    let at = 6.0
    let r = run(ROE, WALKS[LEVEL], Pace::Walk, Ground { step: -0.2, at: at }, 20.0, down: false)
    // The strides past the drop (the body's whole length past it), from the fourth on.
    var past = 0
    var record = String::new()
    for s in r.strides {
        if s.y > at + 1.0 {
            past += 1
            record.push_str(f" {s.x}")
            if past > 3 {
                assert(s.x == 0.0, f"past the drop, the strides' shares outside:{record.as_str()}")
            }
        }
    }
    assert(past > 3, "the walk didn't get past the drop")
}

/// The optimized walk spends less than the hand-set walk (the clearing's, on the walker as the
/// engine had it before §F5) on level ground, per metre: `EFFORT_SHARE` of it at most.
/// **Blocked** (docs/bench.md, "F5"): the plan asks 0.9; the walk that holds its centre of mass
/// over its hull (its sway) spends 0.9007 of it, the search's 120 generations no lower; next lever,
/// the sway's acceleration bounded (it spends effort, and a fifth of its frames are infeasible).
@test(tool, budget: 600)
fn the_optimized_walk_spends_less_than_the_hand_set() {
    let (o, h) = (
        score(ROE, WALKS[LEVEL], Pace::Walk, Ground {}, 20.0, down: false),
        score(ROE, HAND, Pace::Walk, Ground {}, 20.0, down: false),
    )
    assert(
        o.effort <= EFFORT_SHARE * h.effort,
        f"the optimized walk {o.effort} J/m against the hand-set's {h.effort}",
    )
}

/// The optimized walk's effort against the hand-set's, as recorded: the Blocked gate's.
const EFFORT_SHARE: f32 = 0.901

/// The search is the same from its seed: two searches of two generations each pick the same walk,
/// to the bit.
@test(tool, budget: 600, workers: 8)
fn the_search_is_the_same_from_its_seed() {
    let (a, b) = (searched(), searched())
    for i in 0..a.len() {
        assert(bitcast_u32(a[i]) == bitcast_u32(b[i]), f"coordinate {i}: {a[i]} and {b[i]}")
    }
}

/// Two generations of the gait tool's search on level ground (its population, from its seed).
fn searched() -> Vec<f32> {
    let (q, segs) = (kit::genome::quadruped_at(ROE, 1.0), kit::genome::grown_segments(ROE, 1.0))
    var cma = toolkit::cma::Cma::new([0.5, 0.4, 0.4, 0.5, 0.0, 1.0], 0.2, 5, lambda: 8)
    var best = Vec::from([0.5, 0.4, 0.4, 0.5, 0.0, 1.0])
    var least = 1.0e30
    for _ in 0..2 {
        let xs = cma.ask()
        var totals: Vec<f32> = Vec::new()
        for x in xs {
            let t = score_with(
                ROE,
                q,
                segs.clone(),
                gait_at(ROE, Pace::Walk, x),
                Pace::Walk,
                Ground {},
                3.0,
                down: false,
            ).total
            totals.push(t)
            if t < least {
                least = t
                best = x.clone()
            }
        }
        cma.tell(totals)
    }
    best
}

/// The muscles the gait tool baked (`kit::grown::GROWN_MUSCLES`) are the optimized level walk's,
/// sized now from its `SIZING` s, to the bit: the bake isn't stale.
@test(tool, budget: 600)
fn the_baked_muscles_are_the_walks() {
    let q = kit::genome::quadruped_at(ROE, 1.0)
    let r = run(ROE, WALKS[LEVEL], Pace::Walk, Ground {}, kit::gaits::SIZING, down: false)
    let m = kit::muscles::muscles(ROE, q, r.loads)
    for i in 0..7 {
        assert(
            bitcast_u32(m[i].section) == bitcast_u32(kit::grown::GROWN_MUSCLES[i].section),
            f"group {i}: {m[i].section} sized, {kit::grown::GROWN_MUSCLES[i].section} baked",
        )
    }
}
