// The tool tests: the package built (as it ships) through the toolchain, and its voice's first
// second rendered offline: on the native host's CPU (one thread, after a frame starts it), each
// time from a new load, and in Chrome's AudioWorklet (the browser runtime's test mode renders it
// and writes `results/audio.f32`).

use hosts::both::{bytes_of, file_bytes, in_chrome}
use hosts::steps::sample
use std::io::print
use std::math::log10_f64
use std::tool::drive
use std::tool::drive::Step
use std::tool::toolchain

/// A second at 48 kHz, in quanta of 128 samples.
const MIXED: u32 = 375

/// The second's FNV-1a 64 of its samples' bytes when the mixer was made: it changes only when the
/// mixer's sound does.
const MIXED_HASH: Text = "791d08e6bc49c2d7"

/// The package built into `scratch/mixer`.
fn built() {
    hosts::steps::built(
        "repo/engine/tests/mixer",
        "scratch/mixer",
        toolchain::options(),
        "the mixer builds",
    )
}

/// The mixer's second from the native host, from a new load: `f32`s, little-endian, left and
/// right interleaved.
fn mixed() -> Vec<u8> {
    var load = drive::cpu()
    load.workers = 1
    load.width = 16
    load.height = 16
    let list = [Step::Init, Step::FrameAt(0.0), Step::Audio(MIXED, false)]
    let Ok(seen) = drive::run("scratch/mixer", load, list).wait() else {
        panic("the mixer loads and its voice renders")
    }
    if let Some(t) = seen.trap {
        panic(f"init runs and the frame starts the voice: {t.message.as_str()}")
    }
    bytes_of(seen.audio[0].samples.clone())
}

/// FNV-1a 64 of `bytes`, as 16 hex digits (the hosts' state hash's).
fn fnv(bytes: [u8]) -> String {
    var h: u64 = 0xcbf29ce484222325
    for b in bytes {
        h = (h ^ u64(b)).wrapping_mul(0x100000001b3)
    }
    String::from(f"{h:016x}")
}

/// Whether two byte strings are the same; the first index where they differ, if not.
fn first_difference(a: [u8], b: [u8]) -> Option<u32> {
    if a.len() != b.len() {
        return Some(min(a.len(), b.len()))
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return Some(i)
        }
    }
    None
}

/// The mixer's second: in [-1, 1], louder to the left than the right (the sources are placed
/// round the listener, not ahead), the same when rendered again, and hashing as it did when the
/// mixer was made.
@test(tool, read: [("repo", "../../..")], budget: 300)
fn the_mixer_mixes_the_same_samples_every_time() {
    built()
    let runs = [mixed(), mixed()]
    let samples = runs[0].clone()
    let n = samples.len() / 4
    assert(n == MIXED * 128 * 2, f"{n} samples")
    var peak = 0.0
    var left = 0.0
    var right = 0.0
    for i in 0..n {
        let x = sample(samples, i)
        peak = max(peak, abs(x))
        let e = f64(x) * f64(x)
        if i % 2 == 0 {
            left += e
        } else {
            right += e
        }
    }
    assert(peak > 0.01 && peak < 1.0, f"peak {peak}")
    assert(abs(log10_f64(left / right)) > 0.05, "no side louder")
    assert(first_difference(runs[1], samples).is_none(), "rendered again, the samples differ")
    let hash = fnv(samples)
    assert(hash.as_str() == MIXED_HASH, f"the mixer's sound changed: {hash.as_str()}")
}

/// Chrome's AudioWorklet, rendering the mixer offline, gives the native host's samples, bit for
/// bit.
@test(tool, read: [("repo", "../../..")], browser: true, budget: 300)
fn both_hosts_mix_the_same_samples() {
    built()
    let want = mixed()
    in_chrome("scratch/mixer", f"#test&frames=2&width=16&height=16&fps=60&workers=1&audio={MIXED}")
    let chrome = file_bytes("scratch/mixer/results/audio.f32")
    assert(chrome.len() == want.len(), f"{chrome.len()} bytes of samples, not {want.len()}")
    if let Some(i) = first_difference(chrome, want) {
        panic(f"the samples differ from sample {i / 4}")
    }
    print("Chrome's samples are the native host's")
}
