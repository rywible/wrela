// Source-program specialization, generated from the inspected Last Green source tapes.
// Every opcode, register operand and integer-half selector must match before use.
// Adjacent high/low integer operations execute once as u32; scalar uses retain exact halves.
// Numeric constants remain mutable. Packed integer half selectors are also checked. Unknown graphs use Distance's interpreter.
// This table covers observed layouts; it is not a universal source-program compiler.
// Provenance, regeneration and numeric/rendered qualification: docs/neural-direct-fields.md.
// Layout guards are exact; direct floating-point results need not be bitwise identical.
use stone::ShapeTape

pub struct Program: Copy + GpuData {
    pub id: u32 = 0,
    values: [f32; 368] = [0.0; 368],
}

fn same<const N: u32>(t: ShapeTape, layout: [vec4u; N], selectors: [u32; N]) -> bool {
    if t.len() != N || t.consts_len() != 0 { return false }
    for i in 0..N {
        let op = t.op_at(i)
        let (a, b, c) = op.operands()
        if vec4u(op.opcode(), op.third(), a, b) != layout[i] { return false }
        if selectors[i] != 0xffffffff && bitcast_u32(c) != selectors[i] { return false }
    }
    true
}

pub fn compile(t: ShapeTape) -> Program {
    var id = 0
    if same(t, LAYOUT_1, SELECTORS_1) {
        id = 1
    } else if same(t, LAYOUT_2, SELECTORS_2) {
        id = 2
    } else if same(t, LAYOUT_3, SELECTORS_3) {
        id = 3
    } else if same(t, LAYOUT_4, SELECTORS_4) {
        id = 4
    } else if same(t, LAYOUT_5, SELECTORS_5) {
        id = 5
    } else if same(t, LAYOUT_6, SELECTORS_6) {
        id = 6
    } else if same(t, LAYOUT_7, SELECTORS_7) {
        id = 7
    } else if same(t, LAYOUT_8, SELECTORS_8) {
        id = 8
    } else if same(t, LAYOUT_9, SELECTORS_9) {
        id = 9
    } else if same(t, LAYOUT_10, SELECTORS_10) {
        id = 10
    } else if same(t, LAYOUT_11, SELECTORS_11) {
        id = 11
    } else if same(t, LAYOUT_12, SELECTORS_12) {
        id = 12
    } else if same(t, LAYOUT_13, SELECTORS_13) {
        id = 13
    } else if same(t, LAYOUT_14, SELECTORS_14) {
        id = 14
    } else if same(t, LAYOUT_15, SELECTORS_15) {
        id = 15
    } else if same(t, LAYOUT_16, SELECTORS_16) {
        id = 16
    }
    var result = Program { id }
    if id != 0 {
        for i in 0..t.len() {
            let (_, _, c) = t.op_at(i).operands()
            result.values[i] = c
        }
    }
    result
}

// Match the pinned stage interpreter's packed integer and conversion semantics.
fn whole(hi: f32, lo: f32) -> u32 {
    let h = if hi >= 0.0 && hi < 65536.0 { u32(hi) } else { 0 }
    let l = if lo >= 0.0 && lo < 65536.0 { u32(lo) } else { 0 }
    (h << 16) | l
}

fn wrapped(a: f32) -> u32 {
    if abs(a) < 2147483648.0 { return u32(i32(a)) }
    let low = a - 4294967296.0 * floor(a / 4294967296.0)
    if low == low { u32(low) } else { 0 }
}

