fn field_1(v: [f32; 368], p: vec3) -> f32 {
    let r0: f32 = p.x - v[0]
    let r1: f32 = p.y - v[1]
    let r2: f32 = p.z - v[2]
    let r3: f32 = v[3]
    let r4: f32 = r0 - r3
    let r5: f32 = r1 - r3
    let r6: f32 = r2 - r3
    let r7: f32 = v[7]
    let r8: f32 = v[8]
    let r9: f32 = r7 * r5
    let r10: f32 = r3 * r5
    let r11: f32 = r8 * r5
    let r12: f32 = r4 - r9
    let r13: f32 = r5 - r10
    let r14: f32 = r6 - r11
    let r15: f32 = v[15]
    let r16: f32 = r12 - r3
    let r17: f32 = r13 - r15
    let r18: f32 = r14 - r3
    let r19: f32 = r17 / r15
    let r20: f32 = saturate(r19)
    let r21: f32 = v[21]
    let r22: f32 = r21 * r20
    let r23: f32 = v[23]
    let r24: f32 = r23 - r22
    let r25: f32 = v[25]
    let r26: f32 = r25 * r24
    let r27: f32 = v[27]
    let r28: f32 = r27 * r24
    let r29: f32 = min(r26, r28)
    let r30: f32 = v[30]
    let r31: f32 = r29 * r30
    let r32: f32 = r26 - r31
    let r33: f32 = r15 - r31
    let r34: f32 = r28 - r31
    let r35: f32 = abs(r16)
    let r36: f32 = abs(r17)
    let r37: f32 = abs(r18)
    let r38: f32 = r35 - r32
    let r39: f32 = r36 - r33
    let r40: f32 = r37 - r34
    let r41: f32 = max(r39, r40)
    let r42: f32 = max(r38, r41)
    let r43: f32 = if r3 < r42 { 1.0 } else { 0.0 }
    let r44: f32 = max(r38, r3)
