// Water: the meres, the streams, the waterfalls and the springs, as one surface, laid as a mesh
// when the game is built and shaded each frame.
//
// `laid` lays the mesh where the map and the history's flow put the water: a mere at its level,
// out past its shore (the ground hides what's under it); a stream as a ribbon down its course, a
// skin over the ground (`SKIN`); a waterfall the same ribbon over the edge and down the slope to
// a pool at its foot; a spring a pool where it rises. The sim reads its water's height from the
// same mesh (`WaterMesh::height_at`), so what's drawn is where it is. A stream's bed is under its
// skin by the history's depth (the sim's player stands on it): the ground isn't cut, and the
// water's colour gives the depth.
//
// Drawn after the scene, over a copy of it (`below`: its colour and each pixel's distance):
// what's under the water seen through it, bent by its ripples and dimmed by its depth; the world
// reflected from the screen where the reflection is on it, and from the probes and the sky where
// it isn't (no ray is traced through the scene); the sun's glints, and foam
// at the banks and where it falls. No vertex moves: the ripples are the shading's. Three looks
// (`WaterLook`): clear, peat-dark, and painted.

use grow::{Ground, Heap, Stream}
use light::{CLAY, LUMA, Light, sun_reflection}
use lit::{Lighting, sun_and_gloss, through_air}
use noise::noise2
use place::Water
use sky::clouded_sky
use std::gpu::{ClipPosition, FragCoord, Rgba16Float, Texture, VertexIndex}
use std::math::TAU
use view::{Camera, WATER}

/// How far a stream's or a pool's surface lies over the ground (m), and a fall's (white water,
/// thick over the rocks).
pub const SKIN: f32 = 0.04
pub const FALL_SKIN: f32 = 0.25

/// What a point of the water is: still (a mere, a pool), flowing (a stream) or falling.
pub const STILL: f32 = 0.0
pub const FLOWING: f32 = 1.0
pub const FALLING: f32 = 2.0

/// How far past its basin a mere's surface is laid (its radius times this): the sim's reach of it
/// (`footing::mere_depth`).
pub const MERE_REACH: f32 = 1.3

/// A point of the water's mesh: where it is, how deep the water is under it (m: a mere's over its
/// basin, a stream's over its bed), how it flows (m/s, on the plane), what it is (`STILL`,
/// `FLOWING`, `FALLING`) and how near a stream's bank it is (0 its middle, 1 its bank).
pub struct WaterVert: Copy + GpuData {
    pub at: vec3,
    pub depth: f32,
    pub flow: vec2,
    pub kind: f32,
    pub bank: f32,
}

/// The water's mesh: its points, and its triangles (three indices each); and its triangles
/// binned on a grid of `BIN` m from `lo`, `nx` × `nz` (each bin's first in `items` at `start`,
/// a triangle by its first index in `tris`), for the sim's reads (`height_at`).
pub struct WaterMesh: Clone {
    pub verts: Vec<WaterVert>,
    pub tris: Vec<u32>,
    pub lo: vec2,
    pub nx: u32,
    pub nz: u32,
    pub start: Vec<u32>,
    pub items: Vec<u32>,
}

/// The bins' size (m).
const BIN: f32 = 8.0

/// A stream's course as the water lays it: its points (x, z, width, depth), whether it falls, and
/// whether its water is held to a level that never rises down it (`held`: a course a land's own
/// drainage traced, over ground whose detail can rise across its way; the water lies under a rise
/// there, a stone in its bed showing through, and never climbs it).
pub struct Course: Clone {
    pub points: Vec<vec4>,
    pub falls: bool,
    pub held: bool = false,
}

/// A lake's sheet: still water at `level` over the cells of a grid (from `lo`, `nx` × `nz`, each
/// `cell` m a side) that `holds` marks (its basin's), and on round them as far as its water runs
/// under its level, to the shore, under which its edge hides; but no further than a cell, and into
/// no hollow the shore cuts off (`sheet`).
pub struct Sheet: Clone {
    pub lo: vec2,
    pub nx: u32,
    pub nz: u32,
    pub cell: f32,
    pub level: f32,
    pub holds: Vec<bool>,
}

/// How far apart a sheet's points are (m).
const SHEET_STEP: f32 = 2.0

/// No water: a height's answer where there's none.
pub const NONE: f32 = -1.0e9

// ---- laying the mesh ----------------------------------------------------------------------------

/// How fast a fall's water leaves its lip (m/s, level), and gravity (m/s²): the sheet's arc.
const THROW: f32 = 3.5
const GRAVITY: f32 = 9.81

/// How far apart a course's sections are along it (m: a fall's closer, its ground steeper and
/// more curved), and how many points each has across; and how far apart a disc's rings and its
/// points round them are (m: a pool's closer, over the ground).
const ALONG: f32 = 0.33
const FALL_ALONG: f32 = 0.25
const ACROSS: u32 = 9
/// How far a stream's wet bank reaches past its edge (of its half-width).
const MARGIN: f32 = 0.45
const MERE_STEP: f32 = 2.5
const POOL_STEP: f32 = 0.4

/// The water's mesh over `g`: the meres of `w` at their levels, each course a ribbon (`ALONG`
/// apart, `ACROSS` points wide), and each pool (x, z, radius, level) a disc: a skin over the
/// ground (its level `NONE`: a spring's), or still at its level (a hollow the water fills).
pub fn lay<G: Ground>(g: G, w: Water, courses: [Course], pools: [vec4]) -> WaterMesh {
    let none: Vec<Sheet> = Vec::new()
    lay_with(g, w, courses, pools, none)
}

/// `lay`, and lakes' sheets (`Sheet`).
pub fn lay_with<G: Ground>(
    g: G,
    w: Water,
    courses: [Course],
    pools: [vec4],
    sheets: [Sheet],
) -> WaterMesh {
    var m = WaterMesh {
        verts: Vec::new(),
        tris: Vec::new(),
        lo: vec2(0.0),
        nx: 0,
        nz: 0,
        start: Vec::new(),
        items: Vec::new(),
    }
    for mere in w.meres {
        if mere.z > 0.0 {
            disc(mut m, g, mere.xy, mere.z * MERE_REACH, mere.w, MERE_STEP, spills: false)
        }
    }
    for c in courses {
        ribbon(mut m, g, c)
    }
    for q in pools {
        disc(mut m, g, q.xy, q.z, q.w, POOL_STEP, spills: true)
    }
    for sh in sheets {
        sheet(mut m, g, sh)
    }
    binned(mut m)
    m
}

/// A lake's sheet (`Sheet`): a point each `SHEET_STEP` at its level, over its cells, and from
/// them out through each point round them (within a cell) whose ground lies under its level, as
/// its water would run; and a point past each of those, on the shore, so its edge hides under the
/// ground. A hollow the shore cuts off stays dry. A triangle where all three of its points are.
fn sheet<G: Ground>(m: mut WaterMesh, g: G, sh: Sheet) {
    let ix = i32(sh.nx)
    let iz = i32(sh.nz)
    let held = |i: i32, j: i32| i >= 0 &&
        j >= 0 &&
        i < ix &&
        j < iz &&
        sh.holds[u32(j) * sh.nx + u32(i)]
    // Its points' grid: over the cells it holds and one round them.
    var lo = vec2i(ix, iz)
    var hi = vec2i(-1, -1)
    for j in 0..iz {
        for i in 0..ix {
            if held(i, j) {
                lo = min(lo, vec2i(i - 1, j - 1))
                hi = max(hi, vec2i(i + 1, j + 1))
            }
        }
    }
    if hi.x < lo.x {
        return
    }
    let per = sh.cell / SHEET_STEP
    let a = sh.lo + vec2(lo) * sh.cell
    let n = vec2u(ceil(vec2(hi - lo + vec2i(1)) * per)) + vec2u(1)
    let count = n.x * n.y
    let at = |k: u32| a + vec2(f32(k % n.x), f32(k / n.x)) * SHEET_STEP
    let cell_of = |p: vec2| vec2i(floor((p - sh.lo) / sh.cell))
    // Each point's ground, whether it's in the basin's cells or its ring, and whether its water
    // reaches it: flooded from the basin's cells through the ring's points under the level.
    var ground: Vec<f32> = Vec::with_capacity(count)
    var ring: Vec<bool> = Vec::with_capacity(count)
    var wet: Vec<bool> = Vec::filled(count, value: false)
    var front: Vec<u32> = Vec::new()
    for k in 0..count {
        let p = at(k)
        let c = cell_of(p)
        var near = false
        for q in 0..9 {
            near = near || held(c.x + i32(q % 3) - 1, c.y + i32(q / 3) - 1)
        }
        ground.push(g.height(p.x, p.y))
        ring.push(near)
        if held(c.x, c.y) {
            wet[k] = true
            front.push(k)
        }
    }
    while front.len() > 0 {
        let k = front.pop().unwrap()
        let (u, v) = (i32(k % n.x), i32(k / n.x))
        for q in [vec2i(-1, 0), vec2i(1, 0), vec2i(0, -1), vec2i(0, 1)] {
            let (x, z) = (u + q.x, v + q.y)
            if x < 0 || z < 0 || x >= i32(n.x) || z >= i32(n.y) {
                continue
            }
            let o = u32(z) * n.x + u32(x)
            if !wet[o] && ring[o] && ground[o] < sh.level {
                wet[o] = true
                front.push(o)
            }
        }
    }
    let first = m.verts.len()
    var index: Vec<u32> = Vec::filled(count, NO_POINT)
    for k in 0..count {
        let (u, v) = (i32(k % n.x), i32(k / n.x))
        var shore = false
        for q in 0..9 {
            let (x, z) = (u + i32(q % 3) - 1, v + i32(q / 3) - 1)
            shore = shore ||
                (x >= 0 && z >= 0 && x < i32(n.x) && z < i32(n.y) && wet[u32(z) * n.x + u32(x)])
        }
        if wet[k] || shore {
            let p = at(k)
            index[k] = m.verts.len() - first
            m.verts.push(
                WaterVert {
                    at: vec3(p.x, sh.level, p.y),
                    depth: max(sh.level - ground[k], 0.0),
                    flow: vec2(0.0),
                    kind: STILL,
                    bank: 0.0,
                },
            )
        }
    }
    for v in 0..n.y - 1 {
        for u in 0..n.x - 1 {
            let q = [
                index[v * n.x + u],
                index[v * n.x + u + 1],
                index[(v + 1) * n.x + u],
                index[(v + 1) * n.x + u + 1],
            ]
            if q[0] != NO_POINT && q[1] != NO_POINT && q[2] != NO_POINT {
                m.tris.push(first + q[0])
                m.tris.push(first + q[2])
                m.tris.push(first + q[1])
            }
            if q[1] != NO_POINT && q[2] != NO_POINT && q[3] != NO_POINT {
                m.tris.push(first + q[1])
                m.tris.push(first + q[2])
                m.tris.push(first + q[3])
            }
        }
    }
}

/// No point of a sheet's grid.
const NO_POINT: u32 = 4294967295

/// The mesh's triangles binned (`WaterMesh`'s bins): each in every bin its bounds touch.
fn binned(m: mut WaterMesh) {
    var lo = vec2(1.0e9)
    var hi = vec2(-1.0e9)
    for v in m.verts {
        lo = min(lo, v.at.xz)
        hi = max(hi, v.at.xz)
    }
    if m.verts.is_empty() {
        lo = vec2(0.0)
        hi = vec2(0.0)
    }
    m.lo = lo
    m.nx = u32(ceil((hi.x - lo.x) / BIN)) + 1
    m.nz = u32(ceil((hi.y - lo.y) / BIN)) + 1
    let n = m.nx * m.nz
    var count: Vec<u32> = Vec::filled(n + 1, 0)
    var k = 0
    while k + 2 < m.tris.len() {
        let (a, b) = tri_bins(m, k)
        for j in a.y..(b.y + 1) {
            for i in a.x..(b.x + 1) {
                count[j * m.nx + i] += 1
            }
        }
        k += 3
    }
    var start: Vec<u32> = Vec::filled(n + 1, 0)
    for c in 0..n {
        start[c + 1] = start[c] + count[c]
    }
    var items: Vec<u32> = Vec::filled(start[n], 0)
    var fill = start.clone()
    k = 0
    while k + 2 < m.tris.len() {
        let (a, b) = tri_bins(m, k)
        for j in a.y..(b.y + 1) {
            for i in a.x..(b.x + 1) {
                let c = j * m.nx + i
                items[fill[c]] = k
                fill[c] += 1
            }
        }
        k += 3
    }
    m.start = take start
    m.items = take items
}

/// The bins triangle `k` (its first index) touches: the lowest and the highest, each way.
fn tri_bins(m: WaterMesh, k: u32) -> (vec2u, vec2u) {
    let a = m.verts[m.tris[k]].at.xz
    let b = m.verts[m.tris[k + 1]].at.xz
    let c = m.verts[m.tris[k + 2]].at.xz
    let lo = (min(min(a, b), c) - m.lo) / BIN
    let hi = (max(max(a, b), c) - m.lo) / BIN
    (vec2u(max(floor(lo), vec2(0.0))), min(vec2u(floor(hi)), vec2u(m.nx - 1, m.nz - 1)))
}

/// A disc round `at`, `r` across: still at `level` (a mere's, a filled hollow's: its depth over
/// the ground under it), or a skin over the ground where its level is `NONE` (a spring's; its
/// depth a stream's). Its rings and points `step` apart, at least 12 round. Where it `spills`
/// (a pool's), its water runs on as a skin past where the ground falls away (`disc_point`).
fn disc<G: Ground>(m: mut WaterMesh, g: G, at: vec2, r: f32, level: f32, step: f32, spills: bool) {
    let rings = max(u32(ceil(r / step)), 2)
    let round = clamp(u32(ceil(TAU * r / step)), 12, 160)
    let first = m.verts.len()
    m.verts.push(disc_point(g, at, at, r, level, spills))
    for k in 1..(rings + 1) {
        for i in 0..round {
            let a = TAU * f32(i) / f32(round)
            m.verts.push(
                disc_point(
                    g,
                    at + vec2(cos(a), sin(a)) * r * f32(k) / f32(rings),
                    at,
                    r,
                    level,
                    spills,
                ),
            )
        }
    }
    for i in 0..round {
        m.tris.push(first)
        m.tris.push(ring_point(first, round, 1, i + 1))
        m.tris.push(ring_point(first, round, 1, i))
    }
    for k in 1..rings {
        for i in 0..round {
            let a = ring_point(first, round, k, i)
            let b = ring_point(first, round, k, i + 1)
            let c = ring_point(first, round, k + 1, i)
            let d = ring_point(first, round, k + 1, i + 1)
            m.tris.push(a)
            m.tris.push(b)
            m.tris.push(c)
            m.tris.push(b)
            m.tris.push(d)
            m.tris.push(c)
        }
    }
}

/// A disc's point at `p` (its middle `at`, its radius `r`; `disc`'s level, and whether it's a
/// hollow's pool, which spills).
fn disc_point<G: Ground>(g: G, p: vec2, at: vec2, r: f32, level: f32, spills: bool) -> WaterVert {
    let ground = g.height(p.x, p.y)
    let still = level > NONE
    var y = if still { level } else { ground + SKIN }
    // Past a hollow's rim (ground at its level between the point and its middle), its water
    // isn't held: where the ground falls away there (where it spills), it runs on as a skin.
    if still && spills && ground + SKIN < level {
        var rim = false
        for k in 1..16 {
            let q = mix(at, p, vec2(f32(k) / 16.0))
            rim = rim || g.height(q.x, q.y) > level - 0.05
        }
        if rim {
            y = ground + SKIN
        }
    }
    let depth = if still { max(level - ground, 0.0) } else { 0.3 * (1.0 - length(p - at) / r) }
    WaterVert { at: vec3(p.x, y, p.y), depth, flow: vec2(0.0), kind: STILL, bank: 0.0 }
}

/// A disc's point `i` round on ring `k` (1 the innermost; `round` a ring), its first `first`.
fn ring_point(first: u32, round: u32, k: u32, i: u32) -> u32 {
    first + 1 + (k - 1) * round + i % round
}

/// A course's ribbon: a section each `ALONG` down it, `ACROSS` points across its width, each a
/// skin over the ground; deepest in its middle (the course's depth), flowing down it faster where
/// it's steeper. A fall's water leaves the lip (where its ground first drops steeply) as a sheet
/// thrown out over the drop: from the lip it falls as a thrown thing does (`THROW`, under
/// gravity), and lies on the ground again only where the ground is higher than the sheet (where
/// it lands, under a pool's water, or on a slope it meets).
fn ribbon<G: Ground>(m: mut WaterMesh, g: G, c: Course) {
    let n = c.points.len()
    if n < 2 {
        return
    }
    // The sections: the course's points, and between each two, enough to be `ALONG` apart.
    var sections: Vec<vec4> = Vec::new()
    for i in 0..n - 1 {
        let a = c.points[i]
        let b = c.points[i + 1]
        let along = if c.falls { FALL_ALONG } else { ALONG }
        let k = max(u32(ceil(length(b.xy - a.xy) / along)), 1)
        for j in 0..k {
            sections.push(mix(a, b, vec4(f32(j) / f32(k))))
        }
    }
    sections.push(c.points[n - 1])
    let first = m.verts.len()
    let count = sections.len()
    let skin = if c.falls { FALL_SKIN } else { SKIN }
    // The lip, once the fall's ground first drops steeply: the sheet's height there, and how far
    // the water has gone past it. A held course's level so far down it (`Course::held`).
    var lip = NONE
    var past = 0.0
    var level = 1.0e9
    for i in 0..count {
        let s = sections[i]
        let prev = sections[if i > 0 { i - 1 } else { 0 }].xy
        let next = sections[min(i + 1, count - 1)].xy
        let along = normalize(next - prev + vec2(1.0e-6, 0.0))
        let side = vec2(-along.y, along.x)
        let ground = g.height(s.x, s.y)
        level = min(level, ground + skin)
        let fall = g.height(prev.x, prev.y) - g.height(next.x, next.y)
        let slope = max(fall, 0.0) / max(length(next - prev), 0.1)
        if c.falls && lip <= NONE && slope > 0.7 {
            lip = ground + skin
        }
        if lip > NONE && i > 0 {
            past += length(s.xy - sections[i - 1].xy)
        }
        // The sheet's height, thrown from the lip; none before it.
        let sheet = if lip > NONE {
            lip - 0.5 * GRAVITY * past * past / (THROW * THROW)
        } else { NONE }
        // A fall's water is white and fast where it falls (in the air, or down a steep face), and
        // runs on as a stream below.
        let falling = c.falls && (slope > 0.7 || sheet > ground + skin + 0.3)
        let kind = if falling { FALLING } else { FLOWING }
        let speed = if falling { 4.0 + 6.0 * min(slope, 1.0) } else { 0.35 + 2.5 * min(slope, 0.5) }
        // Across: its wet bank on each side (a stream's: `MARGIN` of its half-width out past its
        // edge, a skin of wet ground), then the water's own `ACROSS` points.
        let margin = if c.falls { 1.0 } else { 1.0 + MARGIN }
        for k in 0..(ACROSS + 2) {
            let u = if k == 0 { -margin } else if k == ACROSS + 1 { margin } else {
                2.0 * f32(k - 1) / f32(ACROSS - 1) - 1.0
            }
            let p = s.xy + side * (u * 0.5 * s.z)
            let wet = max(1.0 - u * u, 0.0)
            let on = g.height(p.x, p.y) + skin
            m.verts.push(
                WaterVert {
                    at: vec3(p.x, max(if c.held { min(on, level) } else { on }, sheet), p.y),
                    depth: s.w * wet,
                    flow: along * speed * (1.0 - 0.5 * min(u * u, 1.0)),
                    kind,
                    bank: abs(u),
                },
            )
        }
    }
    for i in 0..count - 1 {
        for k in 0..ACROSS + 1 {
            let a = first + i * (ACROSS + 2) + k
            let b = a + 1
            let c = a + ACROSS + 2
            let d = c + 1
            m.tris.push(a)
            m.tris.push(c)
            m.tris.push(b)
            m.tris.push(b)
            m.tris.push(c)
            m.tris.push(d)
        }
    }
}

/// The courses the water lays: the history's streams (`streams`), and where one ends at a fall
/// of the map's or at the plateau's edge, its fall: over the edge and on down the slope past it
/// (`fall_path`). The fall runs into the first hollow its way meets (its plunge pool, filled to
/// its rim) and a stream runs on from where the pool spills, to its foot. A pool at each spring,
/// each hollow a fall fills, and the fall's foot (x, z, radius, level: `NONE` for a skin).
pub fn courses<G: Ground>(g: G, w: Water, streams: [Stream]) -> (Vec<Course>, Vec<vec4>) {
    var out: Vec<Course> = Vec::new()
    var pools: Vec<vec4> = Vec::new()
    for i in 0..w.spring_count {
        pools.push(vec4(w.springs[i].x, w.springs[i].y, 1.6, NONE))
    }
    for s in streams {
        out.push(Course { points: s.points.clone(), falls: false })
        let n = s.points.len()
        if n < 2 {
            continue
        }
        let end = s.points[n - 1]
        var at_fall = g.past_edge(end.xy) > 0.0
        for f in w.falls {
            at_fall = at_fall || (length(f) > 0.0 && length(end.xy - f) < 8.0)
        }
        if !at_fall {
            continue
        }
        // Over the edge and on down (`fall_path`), to its foot.
        let (path, hollows) = fall_path(g, end.xy)
        // A fall spreads over its lip where it falls (steep): wider than the stream that feeds
        // it; below, on the valley's gentler slope, it narrows to the stream's width.
        // The sheet is as wide as it will be over the lip from a few metres before it, and keeps
        // its width down the face (each point the steepest of its next six and last four).
        var steeps: Vec<f32> = Vec::new()
        for k in 0..path.len() {
            let q = path[k]
            let r = path[min(k + 1, path.len() - 1)]
            let drop = g.height(q.x, q.y) - g.height(r.x, r.y)
            steeps.push(smoothstep(0.3, 0.7, max(drop, 0.0) / max(length(r - q), 0.1)))
        }
        var pts: Vec<vec4> = Vec::new()
        for k in 0..path.len() {
            var steep = 0.0
            for j in (max(k, 4) - 4)..min(k + 7, path.len()) {
                steep = max(steep, steeps[j])
            }
            let q = path[k]
            pts.push(vec4(q.x, q.y, mix(max(end.z, 1.5), max(end.z * 2.0, 8.0), steep), 0.3))
        }
        pts[0] = end
        // The first hollow on the way past the edge: the fall ends in it, and a stream runs on
        // from a metre past its rim (where the pool spills), at the width it had above the lip.
        var into = pts.len()
        var on = pts.len()
        var first = hollows.len()
        for k in 0..hollows.len() {
            if first == hollows.len() && g.past_edge(hollows[k].xy) > 4.0 {
                first = k
            }
        }
        if first < hollows.len() {
            let h = hollows[first]
            pools.push(h)
            // The fall runs on to the pool's middle, its deepest (where the sheet lands, under the
            // pool's water).
            var nearest = 1.0e9
            for k in 0..pts.len() {
                let d = length(pts[k].xy - h.xy)
                if d < nearest && d < h.z {
                    nearest = d
                    into = k
                }
            }
            for k in 0..pts.len() {
                let d = length(pts[k].xy - h.xy)
                if into < pts.len() && on == pts.len() && k > into && d > h.z + 1.0 {
                    on = k
                }
            }
        }
        if into == pts.len() {
            let p = pts[pts.len() - 1].xy
            pools.push(vec4(p.x, p.y, 5.0, NONE))
            out.push(Course { points: pts, falls: true })
            continue
        }
        var fall: Vec<vec4> = Vec::new()
        for k in 0..(into + 1) {
            fall.push(pts[k])
        }
        out.push(Course { points: fall, falls: true })
        if on + 1 < pts.len() {
            var stream: Vec<vec4> = Vec::new()
            for k in on..pts.len() {
                stream.push(vec4(pts[k].x, pts[k].y, max(end.z, 1.5), end.w))
            }
            let p = stream[stream.len() - 1].xy
            pools.push(vec4(p.x, p.y, 3.0, NONE))
            out.push(Course { points: stream, falls: false })
        }
    }
    (out, pools)
}

/// How far round a fall's lip its way down is looked for (m), and the cells it's looked for on.
const FALL_REACH: f32 = 220.0
const FALL_CELL: f32 = 1.0

/// How deep a hollow on a fall's way must fill (m) to be a pool, and how wide (its radius, m).
const HOLLOW_DEEP: f32 = 0.3
const HOLLOW_WIDE: f32 = 2.0

/// A fall's way down from `from`: the ground round it on a grid (`FALL_REACH` each way), its
/// hollows filled by flooding from the grid's border (as `grow::drainage`), so the water spills
/// out of a hollow on the slope by its lowest rim; then down it steepest first, smoothed, to its
/// foot: where the ground under its last 20 steps fell less than a metre. And each hollow it
/// passes through that fills deep enough (`HOLLOW_DEEP`) and wide enough (`HOLLOW_WIDE`) to be a
/// pool, in the order it meets them: its deepest point (x, z), its radius (to the farthest point
/// it fills) and its level.
fn fall_path<G: Ground>(g: G, from: vec2) -> (Vec<vec2>, Vec<vec4>) {
    let n = u32(2.0 * FALL_REACH / FALL_CELL)
    let lo = from - vec2(FALL_REACH)
    let at = |c: u32| lo + (vec2(f32(c % n), f32(c / n)) + vec2(0.5)) * FALL_CELL
    var heights: Vec<f32> = Vec::with_capacity(n * n)
    for c in 0..(n * n) {
        let p = at(c)
        heights.push(g.height(p.x, p.y))
    }
    var filled: Vec<f32> = Vec::filled(n * n, 0.0)
    var done: Vec<bool> = Vec::filled(n * n, value: false)
    var heap = Heap { items: Vec::new() }
    for c in 0..(n * n) {
        let (i, j) = (c % n, c / n)
        if i == 0 || j == 0 || i == n - 1 || j == n - 1 {
            filled[c] = heights[c]
            done[c] = true
            heap.push(filled[c], c)
        }
    }
    while !heap.items.is_empty() {
        let top = heap.pop()
        let h = bitcast_f32(top.x)
        let c = top.y
        for k in 0..8 {
            let q = vec2i(i32(c % n), i32(c / n)) + EIGHT[k]
            if q.x >= 0 && q.y >= 0 && q.x < i32(n) && q.y < i32(n) {
                let d = u32(q.y) * n + u32(q.x)
                if !done[d] {
                    done[d] = true
                    filled[d] = max(heights[d], h + 1.0e-3)
                    heap.push(filled[d], d)
                }
            }
        }
    }
    var out: Vec<vec2> = Vec::from([from])
    var drops: Vec<f32> = Vec::from([g.height(from.x, from.y)])
    var c = u32(FALL_REACH / FALL_CELL) * (n + 1)
    var hollows: Vec<vec4> = Vec::new()
    // The hollow the way is in (its deepest cell so far), if any.
    var deepest = n * n
    for _ in 0..(4 * n) {
        var next = c
        var best = 0.0
        for k in 0..8 {
            let q = vec2i(i32(c % n), i32(c / n)) + EIGHT[k]
            if q.x >= 0 && q.y >= 0 && q.x < i32(n) && q.y < i32(n) {
                let d = u32(q.y) * n + u32(q.x)
                let fall = (filled[c] - filled[d]) / length(vec2(EIGHT[k]))
                if fall > best {
                    best = fall
                    next = d
                }
            }
        }
        if next == c {
            break
        }
        c = next
        out.push(at(c))
        // In a hollow: its deepest cell; out of it, the hollow as a pool if it's one.
        if filled[c] - heights[c] > 0.02 {
            if deepest == n * n || filled[c] - heights[c] > filled[deepest] - heights[deepest] {
                deepest = c
            }
        } else if deepest < n * n {
            if filled[deepest] - heights[deepest] > HOLLOW_DEEP {
                let r = hollow_radius(filled, heights, n, deepest)
                if r > HOLLOW_WIDE {
                    hollows.push(vec4(at(deepest).x, at(deepest).y, r, filled[deepest]))
                }
            }
            deepest = n * n
        }
        // At its foot: the ground under its last 20 steps out of a hollow fell less than a metre
        // (a hollow it crosses is level, not its foot).
        if deepest == n * n {
            drops.push(heights[c])
            let k = drops.len()
            if k > 20 && drops[k - 21] - drops[k - 1] < 1.0 {
                break
            }
        }
    }
    // Its cells' steps smoothed out, its ends where they are.
    for _ in 0..3 {
        let was = out.clone()
        for k in 1..(max(was.len(), 2) - 1) {
            out[k] = mix(was[k], (was[k - 1] + was[k + 1]) * 0.5, vec2(0.5))
        }
    }
    (out, hollows)
}

/// How far from cell `c` (of `n` a side) the farthest cell its hollow fills is (m), and a cell
/// more: looked for out to 30 cells.
fn hollow_radius(filled: [f32], heights: [f32], n: u32, c: u32) -> f32 {
    let at = vec2i(i32(c % n), i32(c / n))
    var best = 0.0
    for j in -30..31 {
        for i in -30..31 {
            let q = at + vec2i(i, j)
            if q.x >= 0 && q.y >= 0 && q.x < i32(n) && q.y < i32(n) {
                let d = u32(q.y) * n + u32(q.x)
                if abs(filled[d] - filled[c]) < 0.01 && filled[d] - heights[d] > 0.02 {
                    best = max(best, length(vec2(f32(i), f32(j))) + 1.0)
                }
            }
        }
    }
    best * FALL_CELL
}

/// A cell's eight neighbours.
const EIGHT = [
    vec2i(-1, -1),
    vec2i(0, -1),
    vec2i(1, -1),
    vec2i(-1, 0),
    vec2i(1, 0),
    vec2i(-1, 1),
    vec2i(0, 1),
    vec2i(1, 1),
]

/// The water laid: its courses and pools (the sim's, `surface`) and its mesh (the drawing's).
pub struct Laid: Clone {
    pub courses: Vec<Course>,
    pub pools: Vec<vec4>,
    pub mesh: WaterMesh,
}

/// The water over `g`: the map's (`w`) and the history's `streams`, laid (`courses`, `lay`).
pub fn laid<G: Ground>(g: G, w: Water, streams: [Stream]) -> Laid {
    let (courses, pools) = courses(g, w, streams)
    let mesh = lay(g, w, courses, pools)
    Laid { courses, pools, mesh }
}

impl Laid {
    /// The sim's water height at `p` (`NONE` for none): the drawn mesh's (`WaterMesh::height_at`).
    pub fn surface(self, p: vec2) -> f32 {
        self.mesh.height_at(p)
    }
}

impl WaterMesh {
    /// The water's height at `p`, as the sim reads it: its highest triangle over `p` (`NONE` for
    /// none), from the triangles binned there.
    pub fn height_at(self, p: vec2) -> f32 {
        let q = (p - self.lo) / BIN
        if q.x < 0.0 || q.y < 0.0 || q.x >= f32(self.nx) || q.y >= f32(self.nz) {
            return NONE
        }
        let c = u32(q.y) * self.nx + u32(q.x)
        var top = NONE
        for i in self.start[c]..self.start[c + 1] {
            top = max(top, self.on_triangle(self.items[i], p))
        }
        top
    }

    /// The drawn surface's height over `p`: its highest triangle there, every triangle read (the
    /// rasterizer's: `NONE` for none), but a stream's wet bank (`is_bank`), which isn't water.
    pub fn height_over(self, p: vec2) -> f32 {
        var top = NONE
        var k = 0
        while k + 2 < self.tris.len() {
            top = max(top, self.on_triangle(k, p))
            k += 3
        }
        top
    }

    /// Whether triangle `k` (its first index) is of a stream's wet bank (past its edge).
    fn is_bank(self, k: u32) -> bool {
        let edge = 1.0 + 1.0e-3
        self.verts[self.tris[k]].bank > edge ||
            self.verts[self.tris[k + 1]].bank > edge ||
            self.verts[self.tris[k + 2]].bank > edge
    }

    /// Triangle `k`'s (its first index's) height over `p`: its plane through its corners, where
    /// `p` is over it (`NONE` where it isn't).
    fn on_triangle(self, k: u32, p: vec2) -> f32 {
        // A stream's wet bank is drawn with the water but isn't water: no height.
        if self.is_bank(k) {
            return NONE
        }
        let a = self.verts[self.tris[k]].at
        let b = self.verts[self.tris[k + 1]].at
        let c = self.verts[self.tris[k + 2]].at
        let e1 = b.xz - a.xz
        let e2 = c.xz - a.xz
        let det = e1.x * e2.y - e1.y * e2.x
        if abs(det) <= 1.0e-9 {
            return NONE
        }
        let q = p - a.xz
        let u = (q.x * e2.y - q.y * e2.x) / det
        let v = (e1.x * q.y - e1.y * q.x) / det
        if u >= -1.0e-5 && v >= -1.0e-5 && u + v <= 1.0 + 1.0e-5 {
            a.y + u * (b.y - a.y) + v * (c.y - a.y)
        } else {
            NONE
        }
    }
}

// ---- drawing ------------------------------------------------------------------------------------

/// What the water's pass reads of the scene drawn before it: its colour, and each pixel's
/// distance along the view (m; the sky's 60 km), written by `copy_below`.
@fragment
pub fn copy_below(
    pixel: FragCoord,
    scene: Texture<Rgba16Float>,
    depth: std::gpu::DepthTexture,
    cam: Camera,
) -> vec4 {
    let p = vec2u(pixel.position.xy)
    let d = depth.load(x: p.x, y: p.y)
    vec4(scene.load(x: p.x, y: p.y).rgb, min(cam.distance_of(d), 60000.0))
}

/// A look of the water: its colour deep (what light it scatters back, per metre of sky light),
/// how fast it dims what's under it (per metre, each channel), its ripples' strength, still and
/// flowing, how much the reflection shows (1 Fresnel's), its foam's colour, and how many bands
/// its light is cut into (0: none: the painted look's cel treatment).
pub struct WaterLook: Copy + GpuData {
    pub deep: vec3,
    pub ripple: f32,
    pub dims: vec3,
    pub flow_ripple: f32,
    pub foam: vec3,
    pub mirror: f32,
    pub bands: f32,
    pub refract: f32,
}

/// The clear look: brown-green clear water over its bed, a sky that shows at a glancing angle.
pub const CLEAR = WaterLook {
    deep: vec3(0.010, 0.022, 0.018),
    ripple: 0.06,
    dims: vec3(0.45, 0.22, 0.20),
    flow_ripple: 0.22,
    foam: vec3(0.80, 0.82, 0.80),
    mirror: 0.55,
    bands: 0.0,
    refract: 0.05,
}

/// The peat look: dark as tea, little seen under it, a mirror of the sky and the trees.
pub const PEAT = WaterLook {
    deep: vec3(0.006, 0.004, 0.002),
    ripple: 0.035,
    dims: vec3(2.2, 3.0, 4.2),
    flow_ripple: 0.18,
    foam: vec3(0.75, 0.70, 0.60),
    mirror: 1.5,
    bands: 0.0,
    refract: 0.03,
}

/// The painted look: flat colours in bands, as the creatures' cel treatment, its foam a line.
pub const PAINTED = WaterLook {
    deep: vec3(0.012, 0.030, 0.034),
    ripple: 0.05,
    dims: vec3(0.9, 0.5, 0.4),
    flow_ripple: 0.2,
    foam: vec3(0.85, 0.90, 0.92),
    mirror: 1.0,
    bands: 3.0,
    refract: 0.0,
}

/// The looks, in the order the floor switches them.
pub const LOOKS = [CLEAR, PEAT, PAINTED]

/// What the water's pixel is given of its point.
pub struct WaterPoint: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub depth: f32,
    pub flow: vec2,
    pub kind: f32,
    pub bank: f32,
}

/// A point of the water's mesh, as it's laid (`at`, in the world: no vertex moves), in render
/// space (the render origin taken off: the floor's water lies near the world's origin, where
/// that's exact).
@vertex
pub fn water_vertex(v: VertexIndex, verts: [WaterVert], tris: [u32], cam: Camera) -> WaterPoint {
    let w = verts[tris[v.index]]
    let at = w.at - cam.origin
    WaterPoint {
        clip: ClipPosition { position: cam.clip(at) },
        world: at,
        depth: w.depth,
        flow: w.flow,
        kind: w.kind,
        bank: w.bank,
    }
}

/// The ripples' slope at `p` (on the plane), `t` seconds in: two layers of noise drifting with
/// the flow (and a breeze across still water), their slopes by differences. Where the water runs,
/// its ripples are drawn out along it (streaks, not round cells). A layer finer than the pixel's
/// footprint `fp` (m) fades out, so the far water doesn't sparkle; how much of the ripples' slope
/// is lost so is the second value (0 to 1), which the glint's spread takes up.
fn ripples(p: vec2, flow: vec2, t: f32, fp: f32) -> (vec2, f32) {
    let drift = flow + vec2(0.08, 0.05)
    let speed = length(flow)
    let down = if speed > 1.0e-3 { flow / speed } else { vec2(1.0, 0.0) }
    let stretch = 1.0 + 0.8 * smoothstep(0.1, 1.0, speed)
    // The plane turned to the flow and squeezed along it: the noise's cells long down it.
    let q = vec2(dot(p, down) / stretch, dot(p, vec2(-down.y, down.x)))
    let qd = vec2(dot(drift, down) / stretch, dot(drift, vec2(-down.y, down.x)))
    // Each layer's share fades once its wavelength (0.77 m and 0.27 m) is under 4 footprints.
    // All unresolved slope becomes roughness; keeping any of it aliases into moving sparkles.
    let k1 = 0.6 * (1.0 - smoothstep(0.19, 0.77, fp))
    let k2 = 0.4 * (1.0 - smoothstep(0.07, 0.27, fp))
    let e = 0.05
    let h = wave(q, qd, t, k1, k2)
    let g = vec2(
        wave(q + vec2(e, 0.0), qd, t, k1, k2) - h,
        wave(q + vec2(0.0, e), qd, t, k1, k2) - h,
    ) /
        e
    // Back to the world's axes.
    let slope = down * (g.x / stretch) + vec2(-down.y, down.x) * g.y
    (slope, 1.0 - (k1 + k2))
}

/// The ripples' height at `q`, drifting at `drift`, `t` seconds in, each layer at its share.
/// The fine layer only where it has a share (none past a few metres).
fn wave(q: vec2, drift: vec2, t: f32, k1: f32, k2: f32) -> f32 {
    let broad = noise2(q * 1.3 - drift * t * 1.3) * k1
    if k2 > 0.0 { broad + noise2(q * 3.7 + vec2(4.0, 1.0) - drift * t * 2.6) * k2 } else { broad }
}

/// The sun reflected by the unresolved facets between drawn ripples. Losing resolved
/// slopes widens their normal distribution; the normalized BRDF preserves its energy.
/// The water's Fresnel is evaluated against the sun's half-vector inside `sun_reflection`,
/// not the macro surface (which greatly overstated its glint at grazing view angles).
fn sun_glint(n: vec3, sun: vec3, v: vec3, lost: f32, flowing: bool) -> f32 {
    sun_reflection(n, sun, v, ripple_roughness(lost, flowing), 0.02)
}

/// Perceptual roughness for both sun and scene reflections. The small undrawn ripples
/// retain a finite slope width even near the eye; filtered large slopes add to that width.
fn ripple_roughness(lost: f32, flowing: bool) -> f32 {
    let slope_width = mix(if flowing { 0.16 } else { 0.08 }, 0.25, clamp(lost, 0.0, 1.0))
    sqrt(slope_width)
}

/// How far a reflection from the screen marches, in steps (a whole number of threes:
/// `reflected_on_screen`), and how far each goes (m, growing).
const MARCH: u32 = 24
const FIRST: f32 = 0.4

/// A bilinear colour sample restricted to the hit's depth layer. The colour taps cannot
/// borrow a nearer bank or trunk just because the reflection's centre hit the water's far
/// shore. Weight is retained as coverage so narrow silhouettes fade toward the fallback.
fn reflection_colour(below: Texture<Rgba16Float>, px: vec2, depth: f32, tolerance: f32) -> vec4 {
    let q = px - vec2(0.5)
    let base = vec2i(floor(q))
    let f = fract(q)
    let limit = vec2i(i32(below.width()) - 1, i32(below.height()) - 1)
    var colour = vec3(0.0)
    var weight = 0.0
    for y in 0..2 {
        for x in 0..2 {
            let p = clamp(base + vec2i(x, y), vec2i(0), limit)
            let sample = below.load(x: u32(p.x), y: u32(p.y))
            let same = 1.0 - smoothstep(tolerance * 0.25, tolerance, abs(sample.a - depth))
            let w = (if x == 0 { 1.0 - f.x } else { f.x }) * (if y == 0 { 1.0 - f.y } else {
                f.y
            }) * same
            colour += sample.rgb * w
            weight += w
        }
    }
    vec4(colour, weight)
}

/// The world the water's reflection meets from the screen: marched from `world` along `r` in
/// view space against `below`'s distances, the colour where the ray goes behind what's there
/// (within the step's length), and how much to trust it (fading at the screen's edges, and to
/// nothing where it leaves the screen or comes back toward the eye).
pub fn reflected_on_screen(
    cam: Camera,
    below: Texture<Rgba16Float>,
    world: vec3,
    r: vec3,
    rough: f32,
) -> vec4 {
    // The hit is filtered after the march, so a group of pixels whose rays meet surfaces at
    // different steps filters them together, once.
    let m = reflection_march(cam, below, world, r)
    if !m.hit {
        return vec4(0.0)
    }
    reflection_at(below, cam, m.px, m.seen, m.d, m.len, rough)
}

/// Where a reflection's march meets a surface (`hit`): its pixel, the surface's distance there,
/// and the step's distance and length.
pub struct Met: Copy {
    pub hit: bool,
    pub px: vec2,
    pub seen: f32,
    pub d: f32,
    pub len: f32,
}

/// The march of `reflected_on_screen`: from `world` along `r` in view space against `below`'s
/// distances, until a step goes behind what's there (within the step's length), or leaves the
/// screen, goes under the water or comes back toward the eye.
pub fn reflection_march(cam: Camera, below: Texture<Rgba16Float>, world: vec3, r: vec3) -> Met {
    var len = FIRST
    var at = world
    let shift = cam.jitter * cam.screen * vec2(0.5, -0.5)
    var hit = false
    var px = vec2(0.0)
    var seen = 0.0
    var d = 0.0
    // The steps go in threes. Every step is checked for the march's ends, but only the third's
    // texel is read; if it lands behind a surface (or the march ends within the three), the
    // first two are read and tested first, so a surface either was behind is met there, as one
    // step at a time would meet it. A surface is passed by only where a first or second step is
    // behind it and the third is in front of what lies beyond: a thin one, met between reads.
    // The march's reads wait on each other (reading four steps at once was slower), so a third
    // of them is what it saves.
    for _ in 0..MARCH / 3 {
        at += r * len
        if at.y < world.y {
            return Met { hit: false, px, seen, d, len }
        }
        let p1 = cam.pixel(at) + shift
        if outside(p1, cam.screen) {
            return Met { hit: false, px, seen, d, len }
        }
        let d1 = dot(at - cam.eye, cam.forward)
        if d1 <= cam.near {
            return Met { hit: false, px, seen, d, len }
        }
        let l1 = len
        len *= 1.18
        at += r * len
        let p2 = cam.pixel(at) + shift
        let d2 = dot(at - cam.eye, cam.forward)
        let end2 = at.y < world.y || outside(p2, cam.screen) || d2 <= cam.near
        let l2 = len
        if !end2 {
            len *= 1.18
            at += r * len
        }
        px = cam.pixel(at) + shift
        d = dot(at - cam.eye, cam.forward)
        let ends = end2 || at.y < world.y || outside(px, cam.screen) || d <= cam.near
        seen = if ends { 0.0 } else { below.load(x: u32(px.x), y: u32(px.y)).a }
        if ends || seen < d {
            let s1 = below.load(x: u32(p1.x), y: u32(p1.y)).a
            if s1 < d1 && d1 - s1 < l1 * 1.5 + 0.2 {
                px = p1
                seen = s1
                d = d1
                len = l1
                hit = true
                break
            }
            if !end2 {
                let s2 = below.load(x: u32(p2.x), y: u32(p2.y)).a
                if s2 < d2 && d2 - s2 < l2 * 1.5 + 0.2 {
                    px = p2
                    seen = s2
                    d = d2
                    len = l2
                    hit = true
                    break
                }
            }
            if ends {
                return Met { hit: false, px, seen, d, len }
            }
            if d - seen < len * 1.5 + 0.2 {
                hit = true
                break
            }
        }
        len *= 1.18
    }
    Met { hit, px, seen, d, len }
}

/// Whether pixel `px` is off a target `screen` pixels in size.
fn outside(px: vec2, screen: vec2) -> bool {
    px.x < 0.0 || px.y < 0.0 || px.x >= screen.x || px.y >= screen.y
}

/// The reflection where the march found it (`reflected_on_screen`): at `px`, a surface at
/// distance `seen` that the step of length `len` reached at `d`.
fn reflection_at(
    below: Texture<Rgba16Float>,
    cam: Camera,
    px: vec2,
    seen: f32,
    d: f32,
    len: f32,
    rough: f32,
) -> vec4 {
    let edge = min(min(px.x, cam.screen.x - px.x), min(px.y, cam.screen.y - px.y))
    // A hit close to the ray thickness limit is uncertain. Fade it before the next frame can
    // lose it; nearest-depth tests still prevent foreground leaks.
    let trust = smoothstep(0.0, 0.08 * cam.screen.y, edge) *
        (1.0 - smoothstep(0.25, 1.0, (d - seen) / (len * 1.5 + 0.2)))
    let spread = 1.0 + rough * 4.0
    let tolerance = min(len * 1.5 + 0.2, 0.05 + seen * 0.02)
    let filtered = reflection_colour(below, px + vec2(spread, 0.0), seen, tolerance) +
        reflection_colour(below, px - vec2(spread, 0.0), seen, tolerance) +
        reflection_colour(below, px + vec2(0.0, spread), seen, tolerance) +
        reflection_colour(below, px - vec2(0.0, spread), seen, tolerance)
    vec4(filtered.rgb / max(filtered.a, 1.0e-6), trust * filtered.a * 0.25)
}

/// The water's pixel: what's under it through it, the world reflected, the sun's glint, foam.
@fragment
pub fn water_shade(
    w: WaterPoint,
    pixel: FragCoord,
    lt: Lighting,
    below: Texture<Rgba16Float>,
    view: Texture<Rgba16Float>,
    dome: Texture<Rgba16Float>,
    look: WaterLook,
) -> vec4 {
    let cam = lt.cam
    let t = cam.time
    let flowing = w.kind > 0.5
    let falling = w.kind > 1.5
    let strength = if flowing { look.flow_ripple } else { look.ripple }
    // The ripples, foam and streaks keyed to the world, not render space.
    let keyed = w.world.xz + cam.keyed().xz
    // The pixel's footprint on the water (m): long at a glancing angle.
    let fp = max(length(dpdx(keyed)), length(dpdy(keyed)))
    let (ripple, lost) = ripples(keyed, w.flow, t, fp)
    // A stream's ripples low and long over its clear shallows, so its bed shows (the sky's
    // silver over all of it read as metal); a fall's broken and steep.
    let slope = ripple * strength * (if falling { 3.0 } else if flowing { 0.5 } else { 1.0 })
    // A fall's sheet faces down its flow, leaning out a little (its mesh rows are steps: their
    // planes read as panels); the rest lie flat.
    let face = if falling {
        let down = normalize(w.flow + vec2(1.0e-4, 0.0))
        vec3(down.x, FALL_LEAN, down.y)
    } else { vec3(0.0, 1.0, 0.0) }
    let n = normalize(face + vec3(-slope.x, 0.0, -slope.y))
    let v = normalize(cam.eye - w.world)
    let distance = dot(w.world - cam.eye, cam.forward)
    // Under it: the scene through it, bent by its ripples where that's still under the water.
    let px = pixel.position.xy
    let size = vec2(f32(below.width()), f32(below.height()))
    let bent = clamp(
        px + n.xz * (look.refract * size.y / max(distance, 1.0)),
        vec2(0.0),
        size - vec2(1.0),
    )
    var under = below.load(x: u32(bent.x), y: u32(bent.y))
    if under.a < distance {
        under = below.load(x: u32(px.x), y: u32(px.y))
    }
    // How much water the eye sees through: what's under it, or the stream's bed under its skin.
    let thick = max(under.a - distance, 0.0) + w.depth / max(v.y, 0.2)
    // A fall's sheet is white water, all but opaque: the cliff behind it doesn't show through.
    let through = exp(-look.dims * thick) * (if falling { 0.1 } else { 1.0 })
    let (sun, sky, probe) = sun_and_gloss(lt, w.world, n, soft: 1.0)
    // The clay view: the water's surface as matte grey, lit as the ground is.
    if lt.light.clay != 0 {
        let wrap = max((dot(n, lt.light.sun) + 0.15) / 1.15, 0.0)
        let c = CLAY * (lt.light.sun_colour * (wrap * sun) + sky)
        return vec4(through_air(lt, c, w.world), WATER)
    }
    let deep = look.deep * (sky + vec3(sun) * lt.light.sun_colour * 0.25)
    let seen = under.rgb * through + deep * (vec3(1.0) - through)
    // The world reflected: from the screen where it's on it; else from the probes, and the sky
    // with its clouds where the probe sees the sky's light that way.
    let r = n * (2.0 * dot(n, v)) - v
    let up = vec3(r.x, max(r.y, 0.02), r.z)
    // The direct solar disc is accounted for once, by the glint below. Reflecting it
    // from the sky as well adds a second, unfiltered white highlight.
    let open = clouded_sky(view, lt.light, normalize(up), dome, lt.s)
    let opens = clamp(dot(probe, LUMA) / max(dot(open, LUMA), 1.0e-4), 0.0, 1.0)
    var reflected = mix(probe, open, vec3(opens * opens))
    // Slopes below a pixel still spread the reflection instead of vanishing into a mirror.
    let rough = ripple_roughness(lost, flowing)
    let screen = reflected_on_screen(cam, below, w.world, r, rough)
    reflected = mix(reflected, screen.rgb, vec3(screen.a))
    let fresnel = reflection_share(dot(n, v), rough, look.mirror)
    var c = mix(seen, reflected, vec3(fresnel))
    // The direct solar BRDF includes Fresnel, light incidence and facet masking. The
    // environment Fresnel above belongs only to reflected scene light, not to this lobe.
    let glint = sun_glint(n, lt.light.sun, v, lost, flowing)
    c += lt.light.sun_colour * (sun * glint * look.mirror)
    // Foam: at a stream's banks and where it runs fast, all over where it falls, and on a still
    // pool's shallows.
    let churn = noise2(keyed * 2.1 - w.flow * t * 1.5) * 0.6 +
        noise2(keyed * 5.3 - w.flow * t * 2.4) * 0.4
    var foam = 0.0
    if falling {
        // White water in streaks down the fall, running with it.
        let down = normalize(w.flow + vec2(1.0e-4, 0.0))
        let across = vec2(-down.y, down.x)
        let u = dot(keyed, across)
        // Down the sheet: its drop (it falls more than it runs), then its run.
        let a = dot(keyed, down) - (w.world.y + cam.keyed().y) - t * length(w.flow)
        // A white sheet, torn by a few dark threads down it.
        let uw = u + 0.35 * noise2(vec2(u * 0.6, a * 0.12 + 7.0))
        let streak = noise2(vec2(uw * 3.5, a * 0.15)) * 0.7 +
            noise2(vec2(uw * 9.0, a * 0.4 + 3.0)) * 0.3
        foam = smoothstep(0.12, 0.55, streak + 0.1 * churn)
    } else if flowing {
        foam = smoothstep(0.65, 0.95, churn * 0.7 + w.bank * 0.2 + 0.08 * length(w.flow))
    } else {
        foam = smoothstep(0.75, 0.95, churn) * (1.0 - smoothstep(0.02, 0.12, w.depth)) * 0.6
    }
    let lit_foam = look.foam * (sky + vec3(sun) * lt.light.sun_colour)
    // Painted: the light in bands, the foam a hard edge.
    if look.bands > 0.0 {
        let l = max(dot(c, LUMA), 1.0e-4)
        let stops = 2.0 / look.bands
        let banded = exp2(floor(log2(l) / stops + 0.5) * stops)
        c = c * (banded / l)
        foam = step(0.5, foam)
    }
    c = mix(c, lit_foam, vec3(foam))
    // A stream's and a fall's edges thin to what's under them; past its edge, its wet bank:
    // the ground there darkened, as soaked earth and stones are, fading out to the dry.
    c = mix(c, under.rgb, vec3(smoothstep(0.8, 1.0, w.bank) * (1.0 - foam)))
    if w.bank > 1.0 {
        let out = smoothstep(1.0, 1.0 + MARGIN, w.bank)
        c = under.rgb * mix(0.45, 1.0, out) + reflected * (0.08 * fresnel * (1.0 - out))
    }
    vec4(through_air(lt, c, w.world), WATER)
}

// ---- mist ---------------------------------------------------------------------------------------

/// Where a fall's mist hangs, each (x, y, z, radius) in the world, from the courses that fall:
/// where the water lands (its course's end: the middle of the pool it falls into), low over the
/// water and rising from it, and a thinner veil up the face it falls down (the steepest stretch).
pub fn mists<G: Ground>(g: G, courses: [Course]) -> Vec<vec4> {
    var out: Vec<vec4> = Vec::new()
    for c in courses {
        if !c.falls || c.points.len() < 3 {
            continue
        }
        // The steepest stretch's lower end: where the most height is lost over the least ground.
        var best = 0.0
        var steepest = 1
        for k in 1..c.points.len() {
            let a = c.points[k - 1].xy
            let b = c.points[k].xy
            let drop = g.height(a.x, a.y) - g.height(b.x, b.y)
            let steep = drop / max(length(b - a), 0.5)
            if steep > best {
                best = steep
                steepest = k
            }
        }
        let f = c.points[c.points.len() - 1].xy
        out.push(vec4(f.x, g.height(f.x, f.y) + 4.0, f.y, 11.0))
        let l = c.points[steepest].xy
        out.push(vec4(l.x, g.height(l.x, l.y) + 7.0, l.y, 8.0))
    }
    out
}

/// What the mist's pass reads besides its textures: the camera, the light, how many mists there
/// are, and the time (s).
pub struct MistAt: Copy + GpuData {
    pub cam: Camera,
    pub light: Light,
    pub count: u32,
    pub time: f32,
}

/// The scene's pixel seen through the falls' mist (a volume, since cards that blend would blend
/// the scene's tags too): along the pixel's
/// ray to what it meets, each mist's sphere of drifting, rising noise, the light it scatters (the
/// sun's, forward most, and the sky's) over what's behind it, the tag kept.
@fragment
pub fn mist_over(
    pixel: FragCoord,
    at: MistAt,
    scene: Texture<Rgba16Float>,
    below: Texture<Rgba16Float>,
    mists: [vec4],
) -> vec4 {
    let p = vec2u(pixel.position.xy)
    let c = scene.load(x: p.x, y: p.y)
    let cam = at.cam
    let dir = cam.unjittered().ray(pixel.position.xy)
    // The distance to what the pixel shows (the copy under the water holds it).
    let far = below.load(x: p.x, y: p.y).a
    var through = 1.0
    var lit = vec3(0.0)
    let keyed = cam.keyed()
    for i in 0..min(at.count, mists.len()) {
        let m = mists[i]
        let centre = m.xyz - cam.origin
        let oc = cam.eye - centre
        let b = dot(oc, dir)
        let disc = b * b - (dot(oc, oc) - m.w * m.w)
        if disc <= 0.0 {
            continue
        }
        let h = sqrt(disc)
        let t0 = max(-b - h, 0.0)
        let t1 = min(-b + h, far)
        if t1 <= t0 {
            continue
        }
        // Samples along the chord: soft billows rising and drifting, densest low in the sphere
        // (it rises off the water) and thinning smoothly to its edge.
        var d = 0.0
        for k in 0..MIST_SAMPLES {
            let t = mix(t0, t1, (f32(k) + 0.5) / f32(MIST_SAMPLES))
            let q = cam.eye + dir * t
            let rel = (q - centre) / m.w
            let r2 = dot(rel, rel)
            let fade = (1.0 - min(r2, 1.0)) * (1.0 - min(r2, 1.0))
            let low = 1.0 - 0.6 * smoothstep(-0.6, 0.8, rel.y)
            let drift = vec3(0.0, -at.time * 0.7, at.time * 0.15)
            let n = noise::noise3((q + keyed) * 0.25 + drift * 0.6)
            d += fade * low * smoothstep(0.2, 0.75, n)
        }
        let a = 1.0 - exp(-MIST_THICK * d * (t1 - t0) / f32(MIST_SAMPLES))
        // Droplets throw the sun's light forward most, and are lit by the whole sky.
        let forward = pow(max(dot(dir, at.light.sun), 0.0), 4.0)
        let light = at.light.sun_colour * (0.3 + 0.9 * forward) + vec3(0.55, 0.6, 0.68)
        lit += through * a * light
        through *= 1.0 - a
    }
    vec4(c.rgb * through + lit * 0.5, c.a)
}

/// How far a fall's sheet leans back from upright (its face's rise for each unit out).
const FALL_LEAN: f32 = 0.3

/// How thick a fall's mist is where it's densest (per m), and how many points of each sphere's
/// chord a pixel reads it at (a noise each: the pass is full-screen).
const MIST_THICK: f32 = 0.22
const MIST_SAMPLES: u32 = 4

// ---- tests ------------------------------------------------------------------------------------

/// A view directly away from the sun has no half vector. Water has no glint there, not NaN.
@test
fn a_water_glint_is_finite_when_the_view_and_sun_are_opposite() {
    let glint = sun_glint(
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, -1.0, 0.0),
        lost: 0.0,
        flowing: false,
    )
    assert(glint == 0.0, "opposite light and view made a water glint or a NaN")
}

/// A rough surface spreads grazing reflections over the normal distribution. Keep the
/// normal-incidence water reflectance and reduce the coherent mirror as roughness rises.
fn reflection_share(cosine: f32, rough: f32, mirror: f32) -> f32 {
    let grazing = max(1.0 - rough, 0.02)
    clamp((0.02 + (grazing - 0.02) * pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0)) * mirror, 0.0, 1.0)
}

@test
fn unresolved_water_ripples_transfer_to_roughness() {
    for i in 0..16 {
        let (slope, lost) = ripples(vec2(f32(i) * 0.43, 2.7), vec2(0.2, 0.7), f32(i), 1.0)
        assert(length(slope) < 1.0e-6, "unresolved waves still move the far reflection")
        assert(abs(lost - 1.0) < 1.0e-6, "unresolved slopes did not become roughness")
    }
    assert(
        abs(reflection_share(cosine: 1.0, rough: 0.5, mirror: 1.0) - 0.02) < 1.0e-6,
        "roughness changed normal-incidence water reflectance",
    )
    assert(
        reflection_share(cosine: 0.0, rough: 0.5, mirror: 1.0) <
            reflection_share(cosine: 0.0, rough: 0.0, mirror: 1.0),
        "rough grazing water remains a perfect mirror",
    )
}

@test
fn water_glint_spreads_without_creating_reflected_energy() {
    let up = vec3(0.0, 1.0, 0.0)
    assert(
        sun_glint(up, up, up, 1.0, flowing: false) < sun_glint(up, up, up, 0.0, flowing: false),
        "unresolved ripple slopes do not spread the sun's peak",
    )
    // Integrate incident directions over the hemisphere for a fixed view. The shared
    // BRDF already includes cosine and is scaled by pi (the scene's sun_colour units).
    // A passive water surface cannot reflect more energy than arrives.
    for rough in [0.3, 0.5, 0.8] {
        for elevation in [0.15, 0.5, 1.0] {
            let v = vec3(sqrt(1.0 - elevation * elevation), elevation, 0.0)
            var reflected = 0.0
            for y in 0..24 {
                let upness = (f32(y) + 0.5) / 24.0
                let across = sqrt(1.0 - upness * upness)
                for x in 0..48 {
                    let angle = TAU * (f32(x) + 0.5) / 48.0
                    let l = vec3(cos(angle) * across, upness, sin(angle) * across)
                    reflected += sun_reflection(up, l, v, rough, 0.02) * (2.0 / (24.0 * 48.0))
                }
            }
            assert(
                reflected > 0.0 && reflected <= 1.0,
                "water's direct reflection creates energy or is not finite",
            )
        }
    }
}

/// A test's ground: a plain falling to +x at `fall` a metre, with a bump `bump` m high round x = 20
/// (4 m wide).
struct Plain: Copy {
    fall: f32,
    bump: f32,
}

impl Ground for Plain {
    fn height(self, x: f32, z: f32) -> f32 {
        -self.fall * x + self.bump * max(1.0 - abs(x - 20.0) / 2.0, 0.0)
    }

    fn past_edge(self, p: vec2) -> f32 {
        -100.0
    }

    fn rock(self, p: vec2) -> f32 {
        0.0
    }
}

/// A held course (`Course::held`) never rises down its way: over a bump in its bed its water lies
/// under the bump, and its middle's height only falls (it climbs nothing in all); an unheld one
/// rides over it.
@test
fn a_held_course_never_rises_down_its_way() {
    let g = Plain { fall: 0.05, bump: 1.5 }
    let pts = Vec::from_fn(11, |i| vec4(f32(i) * 4.0, 0.0, 2.0, 0.3))
    let none = Water {
        meres: [vec4(0.0); 2],
        springs: [vec2(0.0); 8],
        spring_count: 0,
        falls: [vec2(0.0); 2],
    }
    for held in [true, false] {
        let pools: Vec<vec4> = Vec::new()
        let m = lay(g, none, [Course { points: pts.clone(), falls: false, held }], pools)
        // Each section's middle point: the ribbon's sixth of its `ACROSS + 2` a section.
        var last = 1.0e9
        var rises = 0.0
        var i = (ACROSS + 2) / 2
        while i < m.verts.len() {
            let y = m.verts[i].at.y
            rises += max(y - last, 0.0)
            last = y
            i += ACROSS + 2
        }
        if held {
            assert(rises <= 0.0, f"a held course rises {rises} m")
        } else {
            assert(rises > 1.0, f"an unheld course climbs only {rises} m over the bump")
        }
    }
}

/// A test's basin: level ground at 0 m over x 32 to 56, z -24 to 0, and 0.5 m round it, with a
/// round hollow a metre deep, 3 m across, at (`hole`, -12).
struct Bowl: Copy {
    hole: f32,
}

impl Ground for Bowl {
    fn height(self, x: f32, z: f32) -> f32 {
        let inside = x >= 32.0 && x <= 56.0 && z >= -24.0 && z <= 0.0
        (if inside { 0.0 } else {
            0.5
        }) - max(1.0 - length(vec2(x - self.hole, z + 12.0)) / 1.5, 0.0)
    }

    fn past_edge(self, p: vec2) -> f32 {
        -100.0
    }

    fn rock(self, p: vec2) -> f32 {
        0.0
    }
}

/// A lake's sheet covers its basin to the shore and keeps to it: no water in a hollow beside it
/// that its shore cuts off (in its ring, at 61 m) or past it (at 90 m); none farther than a point
/// up its shore.
@test
fn a_lakes_sheet_keeps_to_its_basin() {
    for hole in [61.0, 90.0] {
        let g = Bowl { hole }
        var holds: Vec<bool> = Vec::filled(100, value: false)
        for c in 0..100 {
            let (i, j) = (c % 10, c / 10)
            holds[c] = i >= 2 && i <= 4 && j >= 2 && j <= 4
        }
        let sh = Sheet { lo: vec2(16.0, -40.0), nx: 10, nz: 10, cell: 8.0, level: 0.2, holds }
        let none = Water {
            meres: [vec4(0.0); 2],
            springs: [vec2(0.0); 8],
            spring_count: 0,
            falls: [vec2(0.0); 2],
        }
        let (courses, pools): (Vec<Course>, Vec<vec4>) = (Vec::new(), Vec::new())
        let m = lay_with(g, none, courses, pools, [take sh])
        var inside = 0
        for v in m.verts {
            assert(v.at.y == 0.2, "a sheet's point off its level")
            assert(length(v.at.xz - vec2(hole, -12.0)) > 1.4, f"water over the hollow at {hole}")
            let p = v.at.xz
            assert(
                p.x >= 32.0 - SHEET_STEP - 0.01 &&
                    p.x <= 56.0 + SHEET_STEP + 0.01 &&
                    p.y >= -24.0 - SHEET_STEP - 0.01 &&
                    p.y <= SHEET_STEP + 0.01,
                f"water at {p}, past the shore",
            )
            if p.x >= 32.0 && p.x <= 56.0 && p.y >= -24.0 && p.y <= 0.0 {
                inside += 1
            }
        }
        assert(inside >= 169, f"only {inside} of the basin's points")
    }
}
