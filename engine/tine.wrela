// An electric piano: a hammer strikes a steel tine, and a pickup beside the tine turns its
// motion into the sound (the Rhodes piano's design: H. Rhodes, US patent 2,972,922, 1961).
//
// What it models, note by note:
// - the tine: a pure tone at the note, ringing for seconds while the key is down, longer in
//   the bass;
// - the tone bar the tine is fixed to, tuned to the same note a fraction of a hertz away: the
//   two beat slowly, so a held note swells and ebbs a little, each key at its own rate;
// - the tine's own overtone, a bar's second mode, at 6.27 times the note (Fletcher and Rossing,
//   The Physics of Musical Instruments, 2nd ed., 1998, ch. 2: a clamped-free bar's modes are at
//   1, 6.27, 17.55...): a bell over the first third of a second, much louder for a hard blow;
// - the hammer: a harder blow swings the tine further, and its overtone further still;
// - the pickup: a magnet's pole beside the tine. The field through its coil is strongest when
//   the tine is on the pole's axis and falls off either side, a bump; the tine rests a little
//   off the axis. A soft note swings on the bump's slope and comes out nearly as it is, with
//   some of the octave above. A hard one swings past the axis, where the field turns back down:
//   the tone folds over, and the note barks. What the coil gives is how fast the field changes,
//   so what the fold adds is brighter still. Each tine has its own pickup, so the notes of a
//   chord don't bend each other;
// - the damper: a felt that stops the tine when the key comes up, unless the sustain pedal
//   holds the dampers off;
// - the key's knock: the hammer and the key bottoming, a thud under the note.
// Then the amplifier takes the highs, and its tremolo sways the sound from side to side.
//
// No note is measured from a recording yet: the pole's place and the field's width, the knock
// and the beating are set from how the instrument is built, for a fit against recorded notes to
// settle.
//
// Everything on the audio thread is f32 arithmetic in a fixed order, so both hosts give the same
// samples.

use std::audio::SAMPLE_RATE
use std::math::TAU
use tone::{Mode, key_hz, one_pole, scatter}

/// The audio thread's rate.
const RATE: f32 = f32(SAMPLE_RATE)

/// The notes that sound at once: the oldest makes way.
pub const VOICES: u32 = 16

/// What makes an electric piano's sound.
pub struct Tine: Copy {
    /// Seconds a held note takes to fall 60 dB at E1 and at E7; between, evenly by the octave.
    pub ring_low: f32 = 10.0,
    pub ring_high: f32 = 3.0,
    /// The tone bar: how far it swings beside the tine, and the most it is tuned away from the
    /// note (Hz, either way: each key's own).
    pub bar: f32 = 0.3,
    pub beat: f32 = 0.35,
    /// The overtone: its ratio to the note, how far it swings beside the note at the hardest
    /// blow (the pickup hears it `bell_ratio` times as loud as that), and its seconds to fall
    /// 60 dB.
    pub bell_ratio: f32 = 6.27,
    pub bell: f32 = 0.09,
    pub bell_t60: f32 = 0.32,
    /// The hammer: the power of the velocity the tine's swing goes by (1: evenly), and how much
    /// faster the overtone grows with it.
    pub hammer: f32 = 1.3,
    pub bell_touch: f32 = 1.0,
    /// The pickup: how far from the tine's rest the pole's axis is, and how wide the field's
    /// bump is, both in the hardest blow's swing. A blow that swings the tine past `pole` barks.
    pub pole: f32 = 0.42,
    pub field: f32 = 0.5,
    /// Seconds a note takes to fall 60 dB once its damper is on it.
    pub damped: f32 = 0.11,
    /// The key's knock: its level beside the hardest blow's note.
    pub knock: f32 = 0.07,
    /// The amplifier: the corner above which it takes the highs (Hz), and its tremolo's rate
    /// (Hz) and depth (0: none; 1: each side falls silent in turn).
    pub top_hz: f32 = 8000.0,
    pub tremolo_hz: f32 = 4.4,
    pub tremolo: f32 = 0.45,
    /// The level of the whole.
    pub level: f32 = 0.5,
}

/// One tine ringing.
struct Voice: Copy {
    on: bool = false,
    key: f32 = 0.0,
    /// Its key is down; and, if not, whether its damper has landed (the pedal may hold it off).
    held: bool = false,
    damped: bool = false,
    note: Mode = Mode {},
    bar: Mode = Mode {},
    bell: Mode = Mode {},
    /// The field through its pickup at the last sample, and the note's period over 2π in
    /// samples: what makes a rate of change of the field as loud as the swing was.
    field: f32 = 0.0,
    per: f32 = 0.0,
    age: u32 = 0,
}

/// An electric piano being played: what the audio thread owns of it.
pub struct Tines {
    patch: Tine,
    voices: [Voice; 16],
    presses: u32,
    /// Whether the sustain pedal holds the dampers off.
    pedal: bool,
    /// The key's knock: two short modes.
    knock: [Mode; 2],
    /// The amplifier's two poles, and the tremolo's phase.
    top: f32,
    held1: f32,
    held2: f32,
    sway: f32,
}

/// An electric piano that sounds as `patch` says.
pub fn tines(patch: Tine) -> Tines {
    assert(
        patch.pole >= 0.1 * patch.field && patch.field > 0.0,
        "the pole is at least a tenth of the field's width from the tine's rest",
    )
    var knock = [Mode {}; 2]
    // A thud at 110 Hz and a tap at 380 Hz, gone in a few hundredths of a second.
    knock[0].tune(hz: 110.0, t60: 0.06)
    knock[1].tune(hz: 380.0, t60: 0.03)
    Tines {
        patch,
        voices: [Voice {}; 16],
        presses: 0,
        pedal: false,
        knock,
        top: one_pole(patch.top_hz),
        held1: 0.0,
        held2: 0.0,
        sway: 0.0,
    }
}

/// What the coil's field is with the tine `x` from its rest: a bump round the pole's axis,
/// `pole` from the rest and `field` wide. It is 0 at rest and as steep there as `x` itself, so
/// a small swing comes out as it went in; past the axis it turns back down.
@audio
fn flux(x: f32, pole: f32, field: f32) -> f32 {
    let rest = -pole / field
    let at_rest = 1.0 / (1.0 + rest * rest)
    let slope = -2.0 * rest * at_rest * at_rest / field
    let u = (x - pole) / field
    (1.0 / (1.0 + u * u) - at_rest) / slope
}

impl Tines {
    /// How long a held note at `key` rings (seconds to fall 60 dB).
    @audio
    fn ring(self, key: f32) -> f32 {
        let p = self.patch
        p.ring_low * pow(p.ring_high / p.ring_low, clamp((key - 28.0) / 72.0, 0.0, 1.0))
    }

    /// Strikes `key` (MIDI's numbering) `velocity` hard (0 to 1).
    @audio
    pub fn press(mut self, key: f32, velocity: f32) {
        let p = self.patch
        let v = clamp(velocity, 0.0, 1.0)
        self.presses += 1
        // The key's own tine if it still rings (a blow adds to what it's doing); else a still
        // one; else the oldest.
        var at = 0
        var found = false
        for i in 0..VOICES {
            if self.voices[i].on && self.voices[i].key == key {
                at = i
                found = true
                break
            }
        }
        if !found {
            for i in 0..VOICES {
                if !self.voices[i].on {
                    at = i
                    found = true
                    break
                }
                if self.voices[i].age < self.voices[at].age {
                    at = i
                }
            }
        }
        var voice = self.voices[at]
        if !voice.on || voice.key != key {
            voice.note.still()
            voice.bar.still()
            voice.bell.still()
            voice.field = 0.0
        }
        voice.on = true
        voice.key = key
        voice.held = true
        voice.damped = false
        voice.age = self.presses
        let hz = key_hz(key)
        let ring = self.ring(key)
        voice.per = RATE / (TAU * hz)
        voice.note.tune(hz, ring)
        // The tone bar: each key's a little off its note, its own way.
        let off = p.beat * (2.0 * scatter(u32(key), b: 0, c: 21) - 1.0)
        voice.bar.tune(hz + off, 1.2 * ring)
        let swing = pow(v, p.hammer)
        voice.note.strike((1.0 - p.bar) * swing)
        voice.bar.strike(p.bar * swing)
        // The overtone, where it's under 14 kHz.
        let bell_hz = hz * p.bell_ratio
        if bell_hz < 14000.0 {
            voice.bell.tune(bell_hz, p.bell_t60)
            voice.bell.strike(p.bell * swing * pow(v, p.bell_touch))
        }
        self.voices[at] = voice
        self.knock[0].strike(p.knock * v)
        self.knock[1].strike(0.6 * p.knock * v)
    }

    /// Lands voice `i`'s damper.
    @audio
    fn damp(mut self, i: u32) {
        let p = self.patch
        let hz = key_hz(self.voices[i].key)
        self.voices[i].damped = true
        self.voices[i].note.tune(hz, p.damped)
        self.voices[i].bar.tune(hz, p.damped)
        self.voices[i].bell.tune(min(hz * p.bell_ratio, 14000.0), min(p.damped, p.bell_t60))
    }

    /// Lets `key` go: its damper lands, unless the pedal holds it off.
    @audio
    pub fn lift(mut self, key: f32) {
        for i in 0..VOICES {
            if self.voices[i].on && self.voices[i].held && self.voices[i].key == key {
                self.voices[i].held = false
                if !self.pedal {
                    self.damp(i)
                }
            }
        }
    }

    /// Moves the sustain pedal: down past half its travel (`depth` over 0.5), the dampers are
    /// held off every tine; let up, they land on every tine whose key is up.
    @audio
    pub fn hold_pedal(mut self, depth: f32) {
        let down = depth > 0.5
        if self.pedal && !down {
            for i in 0..VOICES {
                if self.voices[i].on && !self.voices[i].held && !self.voices[i].damped {
                    self.damp(i)
                }
            }
        }
        self.pedal = down
    }

    /// Whether nothing of it sounds.
    @audio
    pub fn silent(self) -> bool {
        for i in 0..VOICES {
            if self.voices[i].on {
                return false
            }
        }
        abs(self.held1) + abs(self.held2) + self.knock[0].level() + self.knock[1].level() < 1e-6
    }

    /// Adds its sound to samples `from` to `to` of `left` and `right`.
    @audio
    pub fn sound(mut self, left: mut [f32], right: mut [f32], from: u32, to: u32) {
        if self.silent() {
            return
        }
        let p = self.patch
        let turn = p.tremolo_hz / RATE
        for n in from..to {
            var sum = self.knock[0].next() + self.knock[1].next()
            for i in 0..VOICES {
                if !self.voices[i].on {
                    continue
                }
                // The tine's motion (with its bar's and its overtone's), the field it makes
                // through its pickup, and how fast that changes.
                let x = self.voices[i].note.next() +
                    self.voices[i].bar.next() +
                    self.voices[i].bell.next()
                let field = flux(x, p.pole, p.field)
                sum += (field - self.voices[i].field) * self.voices[i].per
                self.voices[i].field = field
            }
            // The amplifier's top, two poles.
            self.held1 += self.top * (sum - self.held1)
            self.held2 += self.top * (self.held1 - self.held2)
            let y = p.level * self.held2
            let side = p.tremolo * sin(TAU * self.sway)
            self.sway = fract(self.sway + turn)
            left[n] += y * (1.0 + side)
            right[n] += y * (1.0 - side)
        }
        // A tine under -100 dB is still.
        for i in 0..VOICES {
            let v = self.voices[i]
            if v.on && v.note.level() + v.bar.level() + v.bell.level() < 1e-5 {
                self.voices[i].on = false
            }
        }
    }
}

/// A suitcase electric piano: mellow when played softly, barking when struck, with its
/// amplifier's slow tremolo.
pub const SUITCASE: Tine = Tine {}

// The tests render on the program's thread, as the audio thread would.

/// `seconds` of `t`: the two channels' mean.
fn rendered(t: mut Tines, seconds: f32) -> Vec<f32> {
    var out: Vec<f32> = Vec::new()
    var l = [0.0; 128]
    var r = [0.0; 128]
    for _ in 0..u32(seconds * RATE) / 128 {
        for i in 0..128 {
            l[i] = 0.0
            r[i] = 0.0
        }
        t.sound(mut l, mut r, from: 0, to: 128)
        for i in 0..128 {
            out.push(0.5 * (l[i] + r[i]))
        }
    }
    out
}

/// The energy of `x`, and of its sample-to-sample differences (the highs).
fn energies(x: [f32]) -> vec2 {
    var e = vec2(0.0)
    for i in 1..x.len() {
        e += vec2(x[i] * x[i], (x[i] - x[i - 1]) * (x[i] - x[i - 1]))
    }
    e
}

@test
fn a_hard_blow_barks_and_a_soft_one_is_mellow() {
    // The same note, hard and soft, with no tremolo and no knock: the hard one's highs are a
    // larger share.
    let dry = Tine { tremolo: 0.0, knock: 0.0, ..SUITCASE }
    var hard = tines(dry)
    hard.press(57.0, velocity: 1.0)
    let h = energies(rendered(mut hard, seconds: 0.25))
    var soft = tines(dry)
    soft.press(57.0, velocity: 0.3)
    let s = energies(rendered(mut soft, seconds: 0.25))
    assert(h.x > 6.0 * s.x, f"a hard blow has {h.x / s.x} times a soft one's energy")
    assert(
        h.y / h.x > 2.0 * s.y / s.x,
        f"a hard blow's highs: {h.y / h.x} of it; a soft one's {s.y / s.x}",
    )
}

@test
fn the_field_is_a_bump_that_a_hard_swing_folds_over() {
    // At rest, nothing; a small swing comes out as it went in; and past the pole the field
    // turns back: further out is no more field than nearer.
    assert(abs(flux(0.0, pole: 0.42, field: 0.5)) < 1e-6)
    assert(abs(flux(0.01, pole: 0.42, field: 0.5) - 0.01) < 0.0005)
    let at_pole = flux(0.42, pole: 0.42, field: 0.5)
    assert(
        flux(0.9, pole: 0.42, field: 0.5) < at_pole && flux(0.2, pole: 0.42, field: 0.5) < at_pole,
    )
}

@test
fn a_damper_stops_a_tine_and_the_pedal_holds_it_off() {
    var t = tines(SUITCASE)
    t.press(48.0, velocity: 0.8)
    let _ = rendered(mut t, seconds: 1.0)
    let held = energies(rendered(mut t, seconds: 0.1)).x
    assert(held > 1e-3 && !t.silent(), "a held note died within a second")
    t.lift(48.0)
    let _ = rendered(mut t, seconds: 0.4)
    assert(t.silent(), "a damped note rang on")
    // With the pedal down, the key let go rings on; the pedal let up, it stops.
    t.hold_pedal(1.0)
    t.press(48.0, velocity: 0.8)
    t.lift(48.0)
    let _ = rendered(mut t, seconds: 0.5)
    assert(energies(rendered(mut t, seconds: 0.1)).x > 1e-3, "the pedal didn't hold the note")
    t.hold_pedal(0.0)
    let _ = rendered(mut t, seconds: 0.4)
    assert(t.silent(), "a note rang on after the pedal came up")
}
