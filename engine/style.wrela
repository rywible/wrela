// The look a program's frame draws with (docs/plan-world-class-3.md §C2, D2): a type the program
// names (`Frame<R, Q, Y: Style>`), whose slots the frame calls where a surface's light is summed
// (`lit::shown`: `shade`) and where the image goes to the screen (`paint::develop`: `lens`). Part
// D gives the slots the substance they read and the styles that fill them; here each has the
// physical look's body (`styles::physical::Physical`), and the constants are 0.

use light::{Light, Lit}
use paint::{Develop, Exposure}
use std::gpu::{Rgba8, Sampler, Texture3d}
use substance::Substance

/// A look: its constants say what the frame makes for it, its functions what it does with it.
pub trait Style {
    /// Which substance targets the frame writes (D1's mask: form, cause, tone); 0: none.
    const SUBSTANCE: u32 = 0
    /// Which normal lights the form: 0 the fine (the shading's own), 1 the form's, 2 the coarse.
    const NORMAL: u32 = 0
    /// Which marks are drawn (D7's bits: lines, creases, dabs, strokes, hatch); 0: the frame's
    /// own, as before the marks.
    const MARKS: u32 = 0
    /// How hard temporal AA clips where the substance says the tone is flat (0: as the physical
    /// look; 1: the neighbourhood's box shrunk to its centre's tone).
    const FLAT_CLIP: f32 = 0.0

    /// What its shading passes' fragments write: the scene's colour alone (`vec4`) for a look
    /// that reads no substance after the pass, or that and the substance's three
    /// (`substance::Written`).
    type Out: Copy

    /// A fragment's `Out`: its colour (the lit colour and its tag) and its substance.
    fn written(colour: vec4, s: Substance) -> Self::Out

    /// The light a surface at `world`, lit as `lit` says (its albedo, normal and the light that
    /// reaches it) under `light`, shows the eye at `eye`.
    fn shade(light: Light, lit: Lit, world: vec3, eye: vec3) -> vec3

    /// The colour a material of class `class` (`view`'s), its history `history` (D1's cause: age,
    /// light, wetness, stress), and albedo `albedo` becomes in this look, before light.
    fn palette(class: u32, history: vec4, albedo: vec3) -> vec3

    /// The lens: the output pixel `px`, painted (`paint`: its dabs, bloom and sharpening in), as
    /// the screen shows it, at exposure `e`, `d` saying the output, the view and the look's
    /// numbers, `lut` the grading table (read through `s`).
    fn lens(
        paint: vec3,
        px: vec2,
        d: Develop,
        e: Exposure,
        lut: Texture3d<Rgba8>,
        s: Sampler,
    ) -> vec4
}

/// A fragment's substance as far as `Y` reads it (`Style::SUBSTANCE`): a surface whose form's
/// normal is `n_form` and coarse normal `n_coarse`, its history `history` and its albedo before
/// light `tone`. Nothing for a look that reads none, so the physical look's shaders are as they
/// were; and each channel only if it's read, so what makes the others is no code. (The form's
/// shape is found after the passes: `substance::shaped`.)
pub fn substance_of<Y: Style>(
    n_form: vec3,
    n_coarse: vec3,
    history: vec4,
    tone: vec3,
) -> Substance {
    if Y::SUBSTANCE == 0 {
        return substance::NONE
    }
    var s = substance::NONE
    if (Y::SUBSTANCE & substance::CAUSE) != 0 {
        s.history = history
    }
    if (Y::SUBSTANCE & substance::TONE) != 0 {
        s.tone = tone
    }
    if (Y::SUBSTANCE & substance::FORM) != 0 {
        s.n_form = n_form
        s.n_coarse = n_coarse
    }
    s
}
