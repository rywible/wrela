// Sun shadows (#28 §5.1): two static cascades, one over the near land and one over the far,
// drawn only when something static changes (spike 15: drawing them every frame cost 11 ms); and
// a dynamic map over the space round what moves (the creature), drawn every frame. A lookup
// reads both and takes the darker. Edges are softened by a disc of comparison taps, turned each
// frame, which temporal AA averages.

use std::gpu::{ComparisonSampler, DepthTexture}
use std::math::TAU
use std::transform::{look_at, ortho}

/// The sun's views: each map's light-space-to-clip matrix, the basis the sun sees (for cards
/// that face it), each map's texel size (m), the disc's taps turned by the frame's turn (`TAPS`,
/// two to a vec4, in texels), and each map's texel in its uv (the near map's, the far's, the
/// moving one's).
pub struct Shadows: Copy + GpuData {
    pub near: mat4,
    pub far: mat4,
    pub moving: mat4,
    pub right: vec3,
    pub near_texel: f32,
    pub up: vec3,
    pub far_texel: f32,
    pub taps: [vec4; 2],
    pub texel_uv: vec3,
    pub moving_texel: f32,
}

/// Where the static cascades are: each a square `span` metres wide round `centre`, seen from
/// `reach` metres toward the sun, `side` texels a side.
pub struct Cascade: Copy {
    pub centre: vec3,
    pub span: f32,
    pub reach: f32,
    pub side: u32,
}

/// The sun's view of a square round `centre`, `span` wide, from `reach` toward `sun`.
pub fn sun_view(sun: vec3, centre: vec3, span: f32, reach: f32) -> mat4 {
    let h = span * 0.5
    ortho(left: -h, right: h, bottom: -h, top: h, near: 1.0, far: 2.0 * reach) *
        look_at(centre + sun * reach, centre)
}

/// The shadows for a frame: the static cascades `near` and `far` (their maps each `side` texels
/// a side), and the moving map round `moving_at`, `moving_span` wide, `moving_side` texels a
/// side.
pub fn shadows(
    sun: vec3,
    near: Cascade,
    far: Cascade,
    moving_at: vec3,
    moving_span: f32,
    moving_side: u32,
    frame: u32,
) -> Shadows {
    let s = normalize(sun)
    let fwd = -s
    let right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)))
    let up = cross(right, fwd)
    // The moving map's centre snapped to its texels, so its edges don't crawl as it follows.
    let texel = moving_span / f32(moving_side)
    let snapped = vec3(
        floor(dot(moving_at, right) / texel) * texel,
        floor(dot(moving_at, up) / texel) * texel,
        dot(moving_at, fwd),
    )
    let centre = right * snapped.x + up * snapped.y + fwd * snapped.z
    // The taps turned with temporal AA's jitter, whose cycle is 16 frames: a still frame repeats.
    let turn = TAU * noise::rand(frame % 16, 3)
    let (c, sn) = (cos(turn), sin(turn))
    var t = [vec2(0.0); 4]
    for i in 0..4 {
        let p = TAPS[i]
        t[i] = vec2(c * p.x - sn * p.y, sn * p.x + c * p.y)
    }
    Shadows {
        near: sun_view(s, near.centre, near.span, near.reach),
        far: sun_view(s, far.centre, far.span, far.reach),
        moving: sun_view(s, centre, moving_span, 40.0),
        right,
        near_texel: near.span / f32(near.side),
        up,
        far_texel: far.span / f32(far.side),
        taps: [vec4(t[0], t[1]), vec4(t[2], t[3])],
        texel_uv: vec3(1.0) / vec3(f32(near.side), f32(far.side), f32(moving_side)),
        moving_texel: texel,
    }
}

/// The 4 taps of a disc, in texels; turned each frame (16 turns, over and over).
const TAPS = [vec2(0.5, 0.2), vec2(-0.6, 0.9), vec2(-0.9, -0.7), vec2(0.8, -1.1)]

/// How lit `p` is in one map (`view`'s, one of its texels `texel_uv` of its uv), `soft` texels
/// of penumbra, biased `bias` in depth.
fn lookup(
    sh: Shadows,
    view: mat4,
    map: DepthTexture,
    texel_uv: f32,
    s: ComparisonSampler,
    p: vec3,
    soft: f32,
    bias: f32,
) -> (f32, bool) {
    let lp = view * vec4(p, 1.0)
    let uv = vec2(lp.x * 0.5 + 0.5, lp.y * -0.5 + 0.5)
    let inside = uv.x > 0.01 &&
        uv.x < 0.99 &&
        uv.y > 0.01 &&
        uv.y < 0.99 &&
        lp.z < 1.0 &&
        lp.z > 0.0
    if !inside {
        return (1.0, false)
    }
    let texel = soft * texel_uv
    let at = |o: vec2| map.sample_compare_level(s, uv + o * texel, lp.z - bias)
    let lit = at(sh.taps[0].xy) + at(sh.taps[0].zw) + at(sh.taps[1].xy) + at(sh.taps[1].zw)
    (lit / 4.0, true)
}

/// How lit `world` is by the sun (0 to 1), its normal `n`: the static cascades (the near one
/// where it holds the point, else the far) and the moving map, the darker of the two; `soft`
/// texels of penumbra.
pub fn sunlit(
    sh: Shadows,
    world: vec3,
    n: vec3,
    near: DepthTexture,
    far: DepthTexture,
    moving: DepthTexture,
    s: ComparisonSampler,
    soft: f32,
) -> f32 {
    let lit = statically_sunlit(sh, world, n, near, far, s, soft)
    let (m, _) = lookup(
        sh,
        sh.moving,
        moving,
        sh.texel_uv.z,
        s,
        world + n * (sh.moving_texel * 1.5),
        1.5,
        bias: 0.0008,
    )
    min(lit, m)
}

/// How lit `world` is by the sun through the static cascades alone (`sunlit` without the moving
/// map): for light kept over many frames, such as the probes', which a moving shadow mustn't
/// mark.
pub fn statically_sunlit(
    sh: Shadows,
    world: vec3,
    n: vec3,
    near: DepthTexture,
    far: DepthTexture,
    s: ComparisonSampler,
    soft: f32,
) -> f32 {
    let (a, inside) = lookup(
        sh,
        sh.near,
        near,
        sh.texel_uv.x,
        s,
        world + n * (sh.near_texel * 1.2),
        soft,
        bias: 0.0004,
    )
    if inside {
        return a
    }
    let (b, _) = lookup(
        sh,
        sh.far,
        far,
        sh.texel_uv.y,
        s,
        world + n * (sh.far_texel * 1.2),
        1.5,
        bias: 0.0006,
    )
    b
}
