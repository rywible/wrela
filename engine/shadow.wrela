// Sun shadows: shadow maps that say how much of the sun's light reaches each point of the world.
//
// `Kept` is a static cascade kept round a moving middle: the map in use stays while the next is
// drawn beside it a strip a frame (`Kept::strip`, `Kept::drawn`), and the two swap when the last
// strip is drawn (the frame draws it: engine::frame).
//
// Two static cascades cover the land, one over the near land and one over the far; they are
// drawn only when something static changes. A dynamic map covers the space round what moves
// (the creature) and is drawn every frame. A lookup (`sunlit`) reads both and takes the darker.
// Four fixed comparison taps soften edges in shadow-map space. A surface keeps the same light as
// time and the viewing camera change.

use std::collections::swap
use std::gpu::{ComparisonSampler, DepthBias, DepthTexture, depth_texture}
use std::transform::{look_at, ortho}

/// The depth bias a caster draws into a shadow map with: enough that a lit surface doesn't
/// shadow itself.
pub const CASTER = DepthBias { constant: 2, slope: 1.5, clamp: 0.0 }

/// The sun's views: each map's light-space-to-clip matrix, the basis the sun sees (for cards
/// that face it), each map's texel size (m), and each map's texel in its uv (the near map's,
/// the far's, the moving one's).
pub struct Shadows: Copy + GpuData {
    pub near: mat4,
    pub far: mat4,
    pub moving: mat4,
    pub right: vec3,
    pub near_texel: f32,
    pub up: vec3,
    pub far_texel: f32,
    pub texel_uv: vec3,
    pub moving_texel: f32,
    /// How the static shadows are softened: four fixed taps a texel or so apart (0), or a
    /// penumbra as wide as the sun's size makes it at the blockers' distance (1, the program's
    /// `switches::Switches::PCSS`: Fernando, Percentage-Closer Soft Shadows, SIGGRAPH 2005
    /// sketch: an 8-tap blocker search, then a 12-tap filter that wide); the sun's angular size
    /// it widens with (radians), and each static map's depth span (m: its depth's 0 to 1,
    /// `sun_view`'s 1 to twice its reach).
    pub soft_pcss: u32 = 0,
    pub sun_size: f32 = 0.00925,
    pub near_depth: f32 = 499.0,
    pub far_depth: f32 = 5199.0,
}

/// Points on the unit disc, evenly spread (a Vogel spiral: the golden angle round, the square
/// root out): the blocker search's and the soft filter's.
fn disc(i: u32, n: u32) -> vec2 {
    let r = sqrt((f32(i) + 0.5) / f32(n))
    let a = f32(i) * 2.39996323
    vec2(cos(a), sin(a)) * r
}

/// How far the blocker search reaches (texels), and the soft filter's widest (texels).
const SEARCH: f32 = 6.0
const WIDEST: f32 = 24.0

/// Where the static cascades are: each a square `span` metres wide round `centre`, seen from
/// `reach` metres toward the sun, `side` texels a side; and the sun its map was drawn from (a map
/// drawn while the sun moved is read as it was drawn: `Kept::strip`), none (0) for the frame's.
pub struct Cascade: Copy {
    pub centre: vec3,
    pub span: f32,
    pub reach: f32,
    pub side: u32,
    pub sun: vec3 = vec3(0.0),
}

/// The sun cascade `c`'s map is read toward: its own, or the frame's `sun` if it has none.
fn sun_of(c: Cascade, sun: vec3) -> vec3 {
    if dot(c.sun, c.sun) > 0.0 { normalize(c.sun) } else { sun }
}

/// The sun's view of a square round `centre`, `span` wide, from `reach` toward `sun`.
pub fn sun_view(sun: vec3, centre: vec3, span: f32, reach: f32) -> mat4 {
    let h = span * 0.5
    ortho(left: -h, right: h, bottom: -h, top: h, near: 1.0, far: 2.0 * reach) *
        look_at(centre + sun * reach, centre)
}

/// The basis the sun toward `sun` sees: its forward (away from the sun), right and up.
fn sun_basis(sun: vec3) -> (vec3, vec3, vec3) {
    let fwd = -normalize(sun)
    let right = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)))
    (fwd, right, cross(right, fwd))
}

/// Snap a replacement static cascade to the texel grid of its previous map. The reference
/// moves with render space, so shifting the render origin does not change the grid.
pub fn snapped_centre(sun: vec3, centre: vec3, reference: vec3, texel: f32) -> vec3 {
    let (fwd, right, up) = sun_basis(sun)
    let delta = centre - reference
    reference +
        right * (round(dot(delta, right) / texel) * texel) +
        up * (round(dot(delta, up) / texel) * texel) +
        fwd * dot(delta, fwd)
}

/// The near map's share, fading into the far map before its border. Both maps stay valid in
/// this band; switching at the last valid texel made a moving square of light on the land.
fn near_share(clip: vec3) -> f32 {
    let edge = min(1.0 - abs(clip.x), 1.0 - abs(clip.y)) * 0.5
    smoothstep(0.01, 0.12, edge) * smoothstep(0.0, 0.04, min(clip.z, 1.0 - clip.z))
}

/// The shadows for a frame: the static cascades `near` and `far` (their maps each `side` texels
/// a side), and the moving map round `moving_at`, `moving_span` wide, `moving_side` texels a
/// side.
pub fn shadows(
    sun: vec3,
    near: Cascade,
    far: Cascade,
    moving_at: vec3,
    moving_span: f32,
    moving_side: u32,
) -> Shadows {
    let s = normalize(sun)
    let (fwd, right, up) = sun_basis(sun)
    // The moving map's centre snapped to its texels, so its edges don't crawl as it follows.
    let texel = moving_span / f32(moving_side)
    let snapped = vec3(
        floor(dot(moving_at, right) / texel) * texel,
        floor(dot(moving_at, up) / texel) * texel,
        dot(moving_at, fwd),
    )
    let centre = right * snapped.x + up * snapped.y + fwd * snapped.z
    Shadows {
        near: sun_view(sun_of(near, s), near.centre, near.span, near.reach),
        far: sun_view(sun_of(far, s), far.centre, far.span, far.reach),
        moving: sun_view(s, centre, moving_span, 40.0),
        right,
        near_texel: near.span / f32(near.side),
        up,
        far_texel: far.span / f32(far.side),
        texel_uv: vec3(1.0) / vec3(f32(near.side), f32(far.side), f32(moving_side)),
        moving_texel: texel,
        near_depth: 2.0 * near.reach - 1.0,
        far_depth: 2.0 * far.reach - 1.0,
    }
}

/// A symmetric filter in shadow texels. Comparison sampling filters each tap bilinearly.
/// Rotating sparse taps each frame made static dappled shadows flicker, especially while
/// moving, when temporal history cannot gather a complete cycle.
const TAPS = [vec2(-0.75, -0.75), vec2(0.75, -0.75), vec2(-0.75, 0.75), vec2(0.75, 0.75)]

/// How lit `p` is in one map (`view`'s, one of its texels `texel_uv` of its uv), `soft` texels
/// of penumbra, biased `bias` in depth.
fn lookup(
    view: mat4,
    map: DepthTexture,
    texel_uv: f32,
    s: ComparisonSampler,
    p: vec3,
    soft: f32,
    bias: f32,
) -> (f32, bool) {
    let lp = view * vec4(p, 1.0)
    let uv = vec2(lp.x * 0.5 + 0.5, lp.y * -0.5 + 0.5)
    let inside = uv.x > 0.01 &&
        uv.x < 0.99 &&
        uv.y > 0.01 &&
        uv.y < 0.99 &&
        lp.z < 1.0 &&
        lp.z > 0.0
    if !inside {
        return (1.0, false)
    }
    let texel = soft * texel_uv
    let at = |o: vec2| map.sample_compare_level(s, uv + o * texel, lp.z - bias)
    let lit = at(TAPS[0]) + at(TAPS[1]) + at(TAPS[2]) + at(TAPS[3])
    (lit / 4.0, true)
}

/// How lit `p` is in one static map (`view`'s, one of its texels `texel_uv` of its uv and
/// `texel` metres, its depth's 0 to 1 `depth` metres), its penumbra as wide as the sun (`size`
/// radians) makes it at the blockers' distance (`Shadows::soft_pcss`): the blockers within `SEARCH`
/// texels found (8 taps), their mean depth, and a filter of 12 taps that wide (1 to `WIDEST`
/// texels); biased `bias` in depth.
fn soft_lookup(
    view: mat4,
    map: DepthTexture,
    texel_uv: f32,
    texel: f32,
    depth: f32,
    size: f32,
    s: ComparisonSampler,
    p: vec3,
    bias: f32,
) -> (f32, bool) {
    let lp = view * vec4(p, 1.0)
    let uv = vec2(lp.x * 0.5 + 0.5, lp.y * -0.5 + 0.5)
    let inside = uv.x > 0.01 &&
        uv.x < 0.99 &&
        uv.y > 0.01 &&
        uv.y < 0.99 &&
        lp.z < 1.0 &&
        lp.z > 0.0
    if !inside {
        return (1.0, false)
    }
    let side = vec2(f32(map.width()), f32(map.height()))
    var sum = 0.0
    var n = 0.0
    for i in 0..8 {
        let t = clamp((uv + disc(i, 8) * SEARCH * texel_uv) * side, vec2(0.0), side - vec2(1.0))
        let d = map.load(x: u32(t.x), y: u32(t.y))
        if d < lp.z - bias {
            sum += d
            n += 1.0
        }
    }
    if n == 0.0 {
        return (1.0, true)
    }
    // The blockers' distance above the point (m), and the penumbra the sun's disc spreads there.
    let apart = (lp.z - sum / n) * depth
    let width = clamp(apart * size / texel, 1.0, WIDEST)
    var lit = 0.0
    for i in 0..12 {
        lit += map.sample_compare_level(s, uv + disc(i, 12) * width * texel_uv, lp.z - bias)
    }
    (lit / 12.0, true)
}

/// How lit `world` is by the sun (0 to 1), its normal `n`: the static cascades (the near one
/// where it holds the point, else the far) and the moving map, the darker of the two; `soft`
/// texels of penumbra (`pcss` as `statically_sunlit`'s).
pub fn sunlit(
    sh: Shadows,
    world: vec3,
    n: vec3,
    near: DepthTexture,
    far: DepthTexture,
    moving: DepthTexture,
    s: ComparisonSampler,
    soft: f32,
    pcss: bool = true,
) -> f32 {
    let lit = statically_sunlit(sh, world, n, near, far, s, soft, pcss: pcss)
    let (m, _) = lookup(
        sh.moving,
        moving,
        sh.texel_uv.z,
        s,
        world + n * (sh.moving_texel * 1.5),
        1.5,
        bias: 0.0008,
    )
    min(lit, m)
}

/// How lit `world` is by the sun through the static cascades alone (`sunlit` without the moving
/// map): for light kept over many frames, such as the probes', which a moving shadow mustn't
/// mark. `pcss` false leaves the soft shadows out whatever `sh` says: a program whose switches have
/// none (`switches::Switches::PCSS`), its shading no code of it.
pub fn statically_sunlit(
    sh: Shadows,
    world: vec3,
    n: vec3,
    near: DepthTexture,
    far: DepthTexture,
    s: ComparisonSampler,
    soft: f32,
    pcss: bool = true,
) -> f32 {
    let at = world + n * (sh.near_texel * 1.2)
    let (a, inside) = if pcss && sh.soft_pcss != 0 {
        soft_lookup(
            sh.near,
            near,
            sh.texel_uv.x,
            sh.near_texel,
            sh.near_depth,
            sh.sun_size,
            s,
            at,
            bias: 0.0004,
        )
    } else { lookup(sh.near, near, sh.texel_uv.x, s, at, soft, bias: 0.0004) }
    let share = if inside { near_share((sh.near * vec4(world, 1.0)).xyz) } else { 0.0 }
    if share >= 1.0 {
        return a
    }
    let (b, _) = lookup(
        sh.far,
        far,
        sh.texel_uv.y,
        s,
        world + n * (sh.far_texel * 1.2),
        1.5,
        bias: 0.0006,
    )
    mix(b, a, share)
}

@test
fn static_shadow_replacement_keeps_its_texel_grid() {
    let sun = normalize(vec3(0.9, 0.407, -0.159))
    let (_, right, up) = sun_basis(sun)
    let reference = vec3(12.3, 7.1, -22.6)
    let texel = 144.0 / 2048.0
    let at = reference + vec3(41.37, -2.1, 13.6)
    let snapped = snapped_centre(sun, at, reference, texel)
    let delta = snapped - reference
    assert(
        abs(dot(delta, right) / texel - round(dot(delta, right) / texel)) < 0.001,
        "replacement moved the shadow's horizontal texel grid",
    )
    assert(
        abs(dot(delta, up) / texel - round(dot(delta, up) / texel)) < 0.001,
        "replacement moved the shadow's vertical texel grid",
    )
    let shift = vec3(256.0, 0.0, -512.0)
    let moved = snapped_centre(sun, at + shift, reference + shift, texel)
    assert(length(moved - shift - snapped) < 0.0002, "render origin shift moved the static grid")
}

@test
fn static_shadow_cascades_meet_over_a_continuous_band() {
    assert(near_share(vec3(0.0, 0.0, 0.5)) == 1.0, "near centre lost its detail")
    assert(near_share(vec3(0.98, 0.0, 0.5)) < 0.0001, "near edge switches before fading out")
    var previous = 1.0
    for i in 0..101 {
        let share = near_share(vec3(0.75 + f32(i) * 0.0025, 0.0, 0.5))
        assert(share <= previous && previous - share < 0.02, "cascade boundary pops")
        previous = share
    }
    assert(previous == 0.0, "near map extends beyond its valid border")
}

// ---- A cascade that follows the eye ---------------------------------------------------------

/// A static shadow cascade kept round a moving middle, with no frame drawing it whole: the map
/// in use stays while the next is drawn beside it, a strip of its trees a frame (the wood
/// chooses each strip's on the GPU), and the two swap when the last strip is drawn. So the
/// shadows re-centre with no long frame.
///
/// It holds the map in use and its middle; the map being drawn beside it and its middle, and the
/// strip it's at; its square's size and reach, how far past the square a shadow can reach into
/// it, its texels a side and its strips; and whether what casts into it changed (it's drawn
/// again in place), and which of what casts the maps hold (`recast`, `whole`).
pub struct Kept {
    pub front: DepthTexture,
    pub back: DepthTexture,
    pub centre: vec3,
    next: Option<vec3>,
    strip: u32,
    pub span: f32,
    pub reach: f32,
    reach_in: f32,
    pub side: u32,
    pub strips: u32,
    stale: bool,
    /// The sun the strips being drawn are seen from: a set is drawn from one sun.
    sun: vec3,
    /// The sun the map in use was drawn from.
    front_sun: vec3,
    /// Whether the map in use has been drawn at all (the first is drawn before it's used).
    pub ready: bool,
    /// What casts into it, a version a change of it (`recast`); and the version the set being
    /// drawn began with, and the one the map in use was drawn with.
    pub casters: u32,
    next_casters: u32,
    pub front_casters: u32,
    /// How many sets of strips have been drawn whole.
    pub sets: u32,
}

impl Kept {
    /// The GPU bytes its two maps take (32-bit depth).
    pub fn bytes(self) -> u64 {
        memory::texels(self.front.width(), self.front.height(), 4) +
            memory::texels(self.back.width(), self.back.height(), 4)
    }

    /// A cascade `span` wide round `centre`, `side` texels a side, drawn in `strips` strips;
    /// `reach_in` is how far past its square a tree's shadow can reach into it (m: a 25 m tree's
    /// at a sun 24° up is 56 m long).
    pub fn new(centre: vec3, span: f32, reach: f32, reach_in: f32, side: u32, strips: u32) -> Kept {
        Kept {
            front: depth_texture(width: side, height: side),
            back: depth_texture(width: side, height: side),
            centre,
            next: Some(centre),
            strip: 0,
            span,
            reach,
            reach_in,
            side,
            strips,
            stale: false,
            sun: vec3(0.0),
            front_sun: vec3(0.0),
            ready: false,
            casters: 0,
            next_casters: 0,
            front_casters: 0,
            sets: 0,
        }
    }

    /// The cascade in use, read toward the sun its map was drawn from.
    pub fn cascade(self) -> Cascade {
        Cascade {
            centre: self.centre,
            span: self.span,
            reach: self.reach,
            side: self.side,
            sun: self.front_sun,
        }
    }

    /// Moved by `d` with render space (the render origin moved by `-d`): its maps hold what they
    /// held: replacement maps snap relative to this shifted centre.
    pub fn shift(mut self, d: vec3) {
        self.centre += d
        if let Some(n) = self.next {
            self.next = Some(n + d)
        }
    }

    /// What casts into it changed: drawn again where it is, once the drawing under way ends (a
    /// drawing that hasn't drawn its first strip yet draws what casts now).
    pub fn changed(mut self) {
        self.stale = self.stale || draws_again(drawing: self.next.is_some(), strip: self.strip)
    }

    /// What casts into it changed (not only the sun it's seen from): drawn again where it is
    /// (`changed`), and whole only once a map holds what casts now (`whole`).
    pub fn recast(mut self) {
        self.casters += 1
        self.changed()
    }

    /// Whether it's drawn whole for what casts now, seen from `sun`: settled, or with a complete
    /// map of what casts now drawn from a sun that has moved since. (A sun that moves again
    /// before a set ends never lets it settle: each set begins as the last ends, a set behind.)
    pub fn whole(self, sun: vec3) -> bool {
        self.settled() ||
            (self.ready && self.front_casters == self.casters && self.front_sun != sun)
    }

    /// Follows `at`: once it's `moves` from the middle in use (or what casts changed), the next
    /// map starts round it, unless one is being drawn.
    pub fn follow(mut self, at: vec3, moves: f32) {
        if self.next.is_some() {
            return
        }
        let moved = length(at.xz - self.centre.xz) > moves
        if moved || self.stale {
            self.next = Some(if moved { at } else { self.centre })
            self.strip = 0
            self.stale = false
        }
    }

    /// Whether a map is being drawn beside the one in use.
    pub fn drawing(self) -> bool {
        self.next.is_some()
    }

    /// A complete map with no active or queued replacement. Finishing a strip set may
    /// leave a stale map until follow starts the next set on the following frame.
    pub fn settled(self) -> bool {
        cache_settled(self.ready, self.drawing(), self.stale)
    }

    /// The strip of the next map to draw, if one's being drawn: its square's view from the sun
    /// toward `sun`, the part of the square (and a shadow's reach past it) whose casters it
    /// draws, and whether it's the first strip (which draws what casts only once: solids, the
    /// ground). The first strip of a replacement snaps to the texels of the map in use. A set is
    /// drawn from the sun it began with, though the sun moves meanwhile: no map is drawn from two
    /// suns, and a set always finishes (its map is read toward its own sun: `cascade`), so
    /// shadows follow a moving sun a set behind. Draw it into `back` (cleared on the first
    /// strip, kept after), then call `drawn`.
    pub fn strip(mut self, sun: vec3) -> Option<Strip> {
        let Some(requested) = self.next else { return None }
        self.sun = set_sun(self.strip, self.sun, sun)
        // A set draws what casts as its first strip is drawn (`changed`).
        if self.strip == 0 {
            self.next_casters = self.casters
        }
        let sun = self.sun
        let c = if self.strip == 0 && self.ready {
            snapped_centre(sun, requested, self.centre, self.span / f32(self.side))
        } else { requested }
        self.next = Some(c)
        let half = self.span * 0.5 + self.reach_in
        let lo = c.xz - vec2(half)
        let step = 2.0 * half / f32(self.strips)
        let a = vec2(lo.x, lo.y + step * f32(self.strip))
        Some(
            Strip {
                view: sun_view(normalize(sun), c, self.span, self.reach),
                lo: a,
                hi: vec2(lo.x + 2.0 * half, a.y + step),
                first: self.strip == 0,
            },
        )
    }

    /// The strip `strip` gave is drawn: after the last, the maps swap.
    pub fn drawn(mut self) {
        let Some(c) = self.next else { return }
        self.strip += 1
        if self.strip >= self.strips {
            swap(mut self.front, mut self.back)
            self.centre = c
            self.front_sun = self.sun
            self.front_casters = self.next_casters
            self.next = None
            self.ready = true
            self.sets += 1
        }
    }
}

/// A strip of a kept cascade being drawn: the sun's view of its square, the part of the square
/// whose casters it draws (`lo` to `hi`, x and z), and whether it's the first.
pub struct Strip: Copy {
    pub view: mat4,
    pub lo: vec2,
    pub hi: vec2,
    pub first: bool,
}

fn cache_settled(ready: bool, drawing: bool, stale: bool) -> bool {
    ready && !drawing && !stale
}

@test
fn static_light_is_not_settled_between_queued_replacements() {
    assert(!cache_settled(ready: false, drawing: false, stale: false), "an empty map is settled")
    assert(
        !cache_settled(ready: false, drawing: true, stale: false),
        "the first strip set is settled",
    )
    assert(
        cache_settled(ready: true, drawing: false, stale: false),
        "the completed first map is not settled",
    )
    assert(
        !cache_settled(ready: true, drawing: true, stale: false),
        "an active replacement is settled",
    )
    assert(
        !cache_settled(ready: true, drawing: true, stale: true),
        "changed casters are settled during drawing",
    )
    assert(
        !cache_settled(ready: true, drawing: false, stale: true),
        "the gap before a queued replacement is settled",
    )
    assert(
        cache_settled(ready: true, drawing: false, stale: false),
        "the completed replacement never settles",
    )
}

/// Whether a change to what casts draws a cascade again: not while its drawing (`drawing`) is
/// still at its first strip (`strip`), which draws what casts then.
fn draws_again(drawing: bool, strip: u32) -> bool {
    !drawing || strip > 0
}

/// A change to what casts before a drawing's first strip is drawn with it (the far cascade at
/// load: the far layer and the built things come while it waits); one after it, or with no
/// drawing under way, draws the map again.
@test
fn a_change_before_the_first_strip_is_drawn_with_it() {
    assert(
        !draws_again(drawing: true, strip: 0),
        "a change before the first strip draws the map again",
    )
    assert(draws_again(drawing: true, strip: 1), "a change after the first strip isn't drawn")
    assert(draws_again(drawing: false, strip: 0), "a change with no drawing under way isn't drawn")
}

/// The sun strip `strip` (0 the first) of a set is drawn from, the sun now `sun`: a set's first
/// strip takes it, and the rest keep the one the set began with (`began`).
fn set_sun(strip: u32, began: vec3, sun: vec3) -> vec3 {
    if strip == 0 { sun } else { began }
}

/// A set of strips is drawn from one sun: one partway through keeps the sun it began with when
/// the sun moves (and finishes), and a set's first strip takes the sun as it is.
@test
fn a_cascade_set_is_drawn_from_one_sun() {
    let (a, b) = (normalize(vec3(0.5, 0.8, 0.2)), normalize(vec3(-0.4, 0.7, 0.3)))
    assert(set_sun(2, a, b) == a, "a moved sun changed the strips of a set under way")
    assert(set_sun(0, a, b) == b, "a first strip kept the last set's sun")
}
