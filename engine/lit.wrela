// The lighting that every shading pass reads, as one parameter (`Lighting`, a group:
// language.md §18): the frame's camera and light, the sun's shadows, the probes' sky light (and
// the ambient occlusion over it), the scene's local lights, what glossy surfaces reflect, the
// clouds' shadows and the air.
//
// A shading pass binds a `Lighting`, then asks how much sun reaches a point (`sun_at`, or
// `sun_and_sky` and `sun_and_gloss` for more), and `shown` for a lit surface's colour as the
// eye sees it through the air.

use ambient::{Ambient, ao_at, cascaded_at}
use light::{Light, Lit}
use lights::{Froxels, shed}
use distance::{DistanceGrid, contact_through}
use fog::{FogGrid, fog_at}
use reflect::{Mirror, contact_shadow, reflected}
use probes::{ProbeGrid, sky_light, sky_lights}
use shadow::{Shadows, sunlit}
use sky::{Clouds, cloud_shadow}
use switches::Switches
use std::gpu::{
    ComparisonSampler, Cubemap, DepthTexture, GpuSpan, R32Float, Rgba16Float, Sampler, Texture,
    Texture3d,
}
use terrain::Levels
use view::Camera

/// The frame's lighting: the camera, the light, the sun's shadows and their maps (`near`,
/// `far`, `moving`, read through `cmp`), the probes' grid, maps (`probes`) and their columns'
/// `grounds` and their sights (`seen`), the clouds (where their field has drifted) and their shadow map (`cloud`), the
/// clipmap's levels, the air's aerial perspective (`air`), and the ambient occlusion (`ao`, as
/// `ambient` says it was built: `ambient::ao_at`), and the local lights and their froxels'
/// lists (`lights`, as `froxels` says: `lights::shed`), and what glossy surfaces reflect: the last
/// frame's screen (`screen`, as `mirror` says) and the specular probe (`spec`: `reflect`), and the
/// solids' distance volume (`distance`, `volume`: `distance`, which the contact shadows march
/// once it's cooked); textures read through `s`, a linear sampler. `Q` is the program's switches
/// (`switches::Switches`): a path whose switch is off is no code, and binds nothing.
pub borrow struct Lighting<Q: Switches> {
    pub cam: Camera,
    pub light: Light,
    pub shadows: Shadows,
    pub grid: ProbeGrid,
    pub clouds: Clouds,
    pub levels: Levels,
    pub near: borrow DepthTexture,
    pub far: borrow DepthTexture,
    pub moving: borrow DepthTexture,
    pub cmp: borrow ComparisonSampler,
    pub probes: borrow Texture<Rgba16Float>,
    pub grounds: GpuSpan<f32>,
    pub seen: GpuSpan<u32>,
    pub cloud: borrow Texture<Rgba16Float>,
    pub air: borrow Texture3d<Rgba16Float>,
    pub ambient: Ambient,
    pub ao: borrow Texture<Rgba16Float>,
    pub froxels: Froxels,
    pub lights: GpuSpan<u32>,
    pub mirror: Mirror,
    pub screen: borrow Texture<Rgba16Float>,
    pub spec: borrow Cubemap<Rgba16Float>,
    pub s: borrow Sampler,
    pub distance: DistanceGrid,
    pub volume: borrow Texture3d<R32Float>,
    pub fog: FogGrid,
    pub fogged: borrow Texture3d<Rgba16Float>,
}

/// How much sun reaches `world` (0 to 1), its normal `n`: the shadow maps', `soft` texels of
/// penumbra, times the clouds' shadow.
pub fn sun_at<Q: Switches>(l: Lighting<Q>, world: vec3, n: vec3, soft: f32) -> f32 {
    sun_through(l, world, n, soft, cloud_shadow(l.clouds, l.cloud, l.s, world))
}

/// `sun_at` through the clouds' shadow `shade`.
fn sun_through<Q: Switches>(l: Lighting<Q>, world: vec3, n: vec3, soft: f32, shade: f32) -> f32 {
    sunlit(l.shadows, world, n, l.near, l.far, l.moving, l.cmp, soft, pcss: Q::PCSS) * shade
}

/// `sun_through`, and where the maps let it through, past what's within a couple of metres
/// toward the sun: through the solids' distance volume once it's cooked
/// (`distance::contact_through`), else through the last frame's screen
/// (`reflect::contact_shadow`); a solid surface's (a grass blade's sward darkens it its own way).
fn sun_past<Q: Switches>(l: Lighting<Q>, world: vec3, n: vec3, soft: f32, shade: f32) -> f32 {
    let sun = sun_through(l, world, n, soft, shade)
    if sun <= 0.0 {
        return 0.0
    }
    if !Q::CONTACT {
        return sun
    }
    if Q::DISTANCE && l.distance.on != 0 && l.mirror.contact != 0 {
        return sun * contact_through(l.distance, l.volume, world, n, l.light.sun)
    }
    // The march turned a pixel's own way each frame (interleaved gradient noise), so temporal AA
    // gathers its steps.
    let p = l.cam.pixel(world)
    let turn = fract(
        52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))) + f32(l.cam.frame % 16) * 0.618034,
    )
    sun * contact_shadow(l.mirror, l.screen, world, n, l.light.sun, turn)
}

/// How much sun reaches `world` (as `sun_at`), and the sky light (and bounce) there for a
/// surface facing `sky_n`, from the probes: the bounce of the sun dimmed by the clouds' shadow
/// there, which is read once for both; and by what's near it (`ambient_at`), or the radiance
/// cascades' where they left it (`ambient::cascaded_at`); and the local lights' on a surface
/// facing `n` (`local_at`).
pub fn sun_and_sky<Q: Switches>(
    l: Lighting<Q>,
    world: vec3,
    n: vec3,
    sky_n: vec3,
    soft: f32,
) -> (f32, vec3) {
    let shade = cloud_shadow(l.clouds, l.cloud, l.s, world)
    let sky = sky_at(
        l,
        world,
        sky_light(
            l.grid,
            l.probes,
            l.s,
            l.grounds,
            l.seen,
            l.light,
            world,
            sky_n,
            shade,
            sighted: Q::SIGHT,
        ),
    )
    (sun_past(l, world, n, soft, shade), sky + local_at(l, world, n))
}

/// The sky's light that reaches `world`, the probes' being `sky`: the radiance cascades', where
/// they left it (`ambient::cascaded_at`: it holds its own occlusion), or `sky` dimmed by what's
/// near it (`ambient_at`). Every surface's sky term goes through here.
pub fn sky_at<Q: Switches>(l: Lighting<Q>, world: vec3, sky: vec3) -> vec3 {
    // The cascades' test stays a run-time one (`Ambient::cascades`, 0 where the switch is off):
    // folded, the GPU's compiler evaluates the occlusion's lookup a little differently, and 12 of
    // the clearing's 921,600 pixels move by 1/255 (docs/bench.md, C1).
    match cascaded_at(l.ambient, l.ao, world) {
        Some(e) => e,
        None => sky * ambient_at(l, world),
    }
}

/// The local lights' light on a surface at `world` facing `n` (`lights::shed`).
pub fn local_at<Q: Switches>(l: Lighting<Q>, world: vec3, n: vec3) -> vec3 {
    shed(l.froxels, l.lights, l.cam, world, n)
}

/// The share of the sky's light that reaches `world` past what's near it (`ambient::ao_at`).
pub fn ambient_at<Q: Switches>(l: Lighting<Q>, world: vec3) -> f32 {
    if Q::AMBIENT { ao_at(l.ambient, l.ao, world) } else { 1.0 }
}

/// How much sun reaches `world` (as `sun_at`), the sky light there for a surface facing `n` (as
/// `sun_and_sky`), and the light its gloss reflects: toward its reflection of the ray from the
/// eye (`light::Lit::reflected`).
pub fn sun_and_gloss<Q: Switches>(
    l: Lighting<Q>,
    world: vec3,
    n: vec3,
    soft: f32,
) -> (f32, vec3, vec3) {
    sun_sky_and_gloss(l, world, n, sky_n: n, facing: n, soft: soft, shadow_at: world)
}

/// `sun_and_gloss` for a surface whose sky light is for another facing, `sky_n`, and whose gloss
/// is about `facing`: a leaf's, whose sky light is its crown's, and whose gloss is its side's
/// that faces the eye. Its shadow maps are read at `shadow_at`: a leaf's, past its own mass's
/// leaves.
pub fn sun_sky_and_gloss<Q: Switches>(
    l: Lighting<Q>,
    world: vec3,
    n: vec3,
    sky_n: vec3,
    facing: vec3,
    soft: f32,
    shadow_at: vec3,
) -> (f32, vec3, vec3) {
    let shade = cloud_shadow(l.clouds, l.cloud, l.s, world)
    let v = normalize(l.cam.eye - world)
    let r = facing * (2.0 * dot(facing, v)) - v
    let (sky, reflected) = sky_lights(
        l.grid,
        l.probes,
        l.s,
        l.grounds,
        l.seen,
        l.light,
        world,
        sky_n,
        r,
        shade,
        sighted: Q::SIGHT,
    )
    (
        sun_past(l, shadow_at, n, soft, shade),
        sky_at(l, world, sky) + local_at(l, world, n),
        reflected,
    )
}

/// What a surface at `world` facing `n` of roughness `rough` reflects toward the eye, given the
/// probes' light toward its reflection (`toward`: `sun_and_gloss`'s third): for a glossy one
/// (smoother than `reflect::GLOSSY`), the screen and the specular probe (`reflect::reflected`);
/// for the rest, `toward`.
pub fn reflect<Q: Switches>(
    l: Lighting<Q>,
    world: vec3,
    n: vec3,
    rough: f32,
    toward: vec3,
) -> vec3 {
    let v = normalize(l.cam.eye - world)
    let r = n * (2.0 * dot(n, v)) - v
    if !Q::REFLECTIONS {
        return toward
    }
    reflected(l.mirror, l.screen, l.spec, l.s, world, r, rough, toward)
}

/// `colour`, at `world`, as the eye sees it through the air between them (`light::hazed`).
pub fn through_air<Q: Switches>(l: Lighting<Q>, colour: vec3, world: vec3) -> vec3 {
    // The froxels' fog first (`fog::fog_at`): what shows of the surface, and the light in front.
    if !Q::FOG {
        return light::hazed(l.air, l.s, l.light, colour, world, l.cam.eye)
    }
    let f = fog_at(l.fog, l.fogged, l.s, world)
    light::hazed(l.air, l.s, l.light, colour * f.a + f.rgb, world, l.cam.eye)
}

/// What a surface at `world` shows: lit as `lit` says (`light::world`), through the air.
pub fn shown<Q: Switches>(l: Lighting<Q>, lit: Lit, world: vec3) -> vec3 {
    through_air(l, light::world(l.light, lit, world, l.cam.eye), world)
}
