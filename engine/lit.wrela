// What every surface's shading reads (#28 §5): the frame's camera and light, the sun's shadows,
// the probes' sky light and the clouds' shadows, gathered in one uniform block, with the
// textures and buffers beside it. A shading pass binds these, and asks `sun_at` and `sky_at`.

use light::Light
use probes::{Probe, ProbeGrid, sky_light, sky_lights}
use shadow::{Shadows, sunlit}
use sky::{Clouds, cloud_shadow}
use std::gpu::{ComparisonSampler, DepthTexture, Sampler, Texture}
use terrain::{Levels, Texel}
use view::Camera

/// The frame's lighting, one uniform block: the camera, the light, the shadows, the probes'
/// grid, the clouds (where their field has drifted, for their shadow map), and the clipmap's
/// levels.
pub struct Lighting: Copy + GpuData {
    pub cam: Camera,
    pub light: Light,
    pub shadows: Shadows,
    pub grid: ProbeGrid,
    pub clouds: Clouds,
    pub levels: Levels,
}

/// How much sun reaches `world` (0 to 1), its normal `n`: the shadow maps', `soft` texels of
/// penumbra, times the clouds' shadow.
pub fn sun_at(
    l: Lighting,
    world: vec3,
    n: vec3,
    near: DepthTexture,
    far: DepthTexture,
    moving: DepthTexture,
    cmp: ComparisonSampler,
    clouds: Texture,
    s: Sampler,
    soft: f32,
) -> f32 {
    sunlit(l.shadows, world, n, near, far, moving, cmp, soft) *
        cloud_shadow(l.clouds, clouds, s, world)
}

/// The sky light (and bounce) at `world` for a surface facing `n`, from the probes (their maps,
/// `probes`, read through `s`, a linear sampler, and their columns' `grounds`): the bounce of
/// the sun dimmed by the clouds' shadow there (their map, `clouds`).
pub fn sky_at(
    l: Lighting,
    probes: Texture,
    clouds: Texture,
    s: Sampler,
    grounds: [f32],
    world: vec3,
    n: vec3,
) -> vec3 {
    let shade = cloud_shadow(l.clouds, clouds, s, world)
    sky_light(l.grid, probes, s, grounds, l.light, world, n, shade)
}

/// The sky light at `world` for a surface facing `n` (as `sky_at`), and the light its gloss
/// reflects: toward its reflection of the ray from `eye` (`light::Lit::reflected`).
pub fn sky_gloss(
    l: Lighting,
    probes: Texture,
    clouds: Texture,
    s: Sampler,
    grounds: [f32],
    world: vec3,
    n: vec3,
    eye: vec3,
) -> (vec3, vec3) {
    let shade = cloud_shadow(l.clouds, clouds, s, world)
    let v = normalize(eye - world)
    let r = n * (2.0 * dot(n, v)) - v
    sky_lights(l.grid, probes, s, grounds, l.light, world, n, r, shade)
}
