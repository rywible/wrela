// A flat frame: a scene drawn at a render scale the frames keep (`Scale`, `pace`), a copy of it
// under what bends it (water), and a page that stretches it over the screen at the screen's own
// size (the game's fragment shader). No depth, no light, no history: a 2D game's (the capybara's),
// which pays for nothing a lit 3D frame (`engine::frame`) does. Its targets hold display colours
// (`Rgba8`: no light is simulated), at most one and a half times the screen's logical size (its
// CSS pixels: `render_size`), however many device pixels a CSS pixel is.
//
//     let size = sheet.begin(dt, width, height)   paced, the targets sized
//     begin_pass(mut sheet.scene) ...             the scene
//     sheet.copy_below(linear)                    the copy the water reads
//     begin_pass(mut sheet.scene, keep: true) ... what goes over the copy
//     begin_screen_pass(...) + the page           stretched over the screen

use frame::full
use std::gpu::{FragCoord, Rgba8, Sampler, Texture, begin_pass, draw, texture}

/// A flat frame's targets at the render scale (`width` × `height`, the scene's), the scale kept
/// by watching the frames, and the screen's size the last frame.
pub struct Sheet {
    pub scene: Texture<Rgba8>,
    pub below: Texture<Rgba8>,
    pub width: u32,
    pub height: u32,
    pub scale: Scale,
}

/// A sheet before its first frame sizes it.
pub fn sheet() -> Sheet {
    Sheet {
        scene: texture(width: 4, height: 4),
        below: texture(width: 4, height: 4),
        width: 4,
        height: 4,
        scale: Scale {},
    }
}

impl Sheet {
    /// A frame `dt` seconds after the last, on a screen `width` × `height` (device pixels, `ratio`
    /// of them a CSS pixel): the scale paced by it, and the targets made again at the scene's size
    /// if it changed. The scene's size.
    pub fn begin(mut self, dt: f32, width: u32, height: u32, ratio: f32 = 1.0) -> (u32, u32) {
        pace(mut self.scale, dt)
        let (w, h) = render_size(self.scale, width, height, ratio)
        if w != self.width || h != self.height {
            self.scene = texture(width: w, height: h)
            self.below = texture(width: w, height: h)
            self.width = w
            self.height = h
        }
        (w, h)
    }

    /// The scene copied under what bends it (`below`): water reads it to see what's behind.
    pub fn copy_below(mut self, s: Sampler) {
        let p = begin_pass(mut self.below)
        draw(p, full.bind(z: 0.0), copy.bind(src: self.scene, s: s), vertices: 3)
        p.end()
    }
}

/// A copy of `src`, texel for texel.
@fragment
pub fn copy(pixel: FragCoord, src: Texture<Rgba8>, s: Sampler) -> vec4 {
    let size = vec2(f32(src.width()), f32(src.height()))
    src.sample_level(s, pixel.position.xy / size)
}

// ---- the render scale ---------------------------------------------------------------------------

/// The least render scale: a GPU that can't keep up at this is too slow for the game.
pub const LEAST_SCALE: f32 = 0.35

/// The render scale, kept by watching the frames (the capybara game's rule, Ryan, 2026-10-22:
/// "match the max fps and display resolution of the device", and play on "basically all commodity
/// hardware"). The game draws a frame each time the display refreshes, at the screen's size in its
/// own pixels. While frames come once a refresh, the scene is drawn at that size (1). When a
/// fraction of them come late (a refresh or more missed: the GPU can't keep up), the scene is
/// drawn smaller, a tenth less at a time, and the page stretches it over the screen (the HUD stays
/// at the screen's size). After five seconds with none late, it's drawn a twentieth bigger again,
/// up to 1.
pub struct Scale: Copy {
    pub value: f32 = 1.0,
    /// The least it steps down to (`LEAST_SCALE` for the 2D sheet; the 3D frame's own).
    pub least: f32 = LEAST_SCALE,
    /// The display's refresh interval as the frames show it (s): their usual shortest.
    pub refresh: f32 = 0.0,
    frames: u32 = 0,
    window: u32 = 0,
    late: u32 = 0,
    calm: u32 = 0,
}

/// Frames at the start not judged (pipelines are being made), and a window's frames.
const WARM_FRAMES: u32 = 90

const WINDOW: u32 = 30

/// A frame later than this many refresh intervals is late; this many late in a window steps the
/// scale down; this many frames with none late steps it up.
const LATE: f32 = 1.5

const LATE_IN_WINDOW: u32 = 4

const CALM_FRAMES: u32 = 300

/// The scale after a frame `dt` seconds after the last.
pub fn pace(g: mut Scale, dt: f32) {
    if dt <= 0.0 || dt > 0.25 {
        // The first frame, or a pause (the tab hidden): nothing to judge.
        return
    }
    // The refresh: the frames' usual shortest interval, quick to come down, slow to go up.
    if g.refresh <= 0.0 {
        g.refresh = dt
    } else {
        let rate = if dt < g.refresh { 0.1 } else { 0.002 }
        g.refresh += (dt - g.refresh) * rate
    }
    g.frames += 1
    if g.frames < WARM_FRAMES {
        return
    }
    g.window += 1
    if dt > g.refresh * LATE {
        g.late += 1
    }
    if g.window < WINDOW {
        return
    }
    if g.late >= LATE_IN_WINDOW {
        g.value = max(g.value - 0.1, g.least)
        g.calm = 0
    } else if g.late == 0 {
        g.calm += WINDOW
        if g.calm >= CALM_FRAMES && g.value < 1.0 {
            g.value = min(g.value + 0.05, 1.0)
            g.calm = 0
        }
    } else {
        g.calm = 0
    }
    g.window = 0
    g.late = 0
}

/// How many device pixels the scene is drawn at a CSS pixel, at most: a 2× display's scene is
/// drawn at 1.5× (the page stretches it the rest), which a painted picture loses nothing by.
pub const MOST_DENSITY: f32 = 1.5

/// The size the scene is drawn at, for a screen `width` by `height` (device pixels, `ratio` of
/// them a CSS pixel): the screen's CSS size at `MOST_DENSITY`, no more than its device pixels,
/// times the scale.
pub fn render_size(g: Scale, width: u32, height: u32, ratio: f32 = 1.0) -> (u32, u32) {
    let dense = min(MOST_DENSITY / max(ratio, 1.0), 1.0)
    let w = max(u32(round(f32(width) * dense * g.value)), 4)
    let h = max(u32(round(f32(height) * dense * g.value)), 4)
    (w, h)
}

@test
fn the_scale_stays_whole_while_frames_come_every_refresh() {
    var g = Scale {}
    for i in 0..2000 {
        // A 120 Hz display, its frames' times jittering a little.
        pace(mut g, 1.0 / 120.0 + 0.0003 * f32(i % 3))
    }
    assert(g.value == 1.0)
    assert(abs(g.refresh - 1.0 / 120.0) < 3.0e-4)
}

@test
fn the_scale_comes_down_when_frames_are_late_and_back_up_once_they_are_not() {
    var g = Scale {}
    // A 60 Hz display; a GPU that misses one refresh in three.
    for i in 0..600 {
        pace(mut g, if i % 3 == 0 { 2.0 / 60.0 } else { 1.0 / 60.0 })
    }
    assert(g.value < 0.5, "drawn smaller")
    assert(g.value >= LEAST_SCALE, "but not too small")
    let low = g.value
    // Once frames come every refresh again, it grows back, slowly.
    for _ in 0..600 {
        pace(mut g, 1.0 / 60.0)
    }
    assert(g.value > low && g.value < low + 0.2, "a little bigger after 10 s")
    for _ in 0..12000 {
        pace(mut g, 1.0 / 60.0)
    }
    assert(g.value == 1.0, "and whole again")
}

@test
fn a_pause_and_the_first_frames_dont_move_the_scale() {
    var g = Scale {}
    for i in 0..WARM_FRAMES - 1 {
        // Pipelines being made: slow frames.
        pace(mut g, if i == 0 { 0.2 } else { 1.0 / 20.0 })
    }
    pace(mut g, 3.0)
    assert(g.value == 1.0)
    assert(render_size(g, width: 2940, height: 1912) == (2940, 1912))
}

/// A 2× display's scene is drawn at 1.5× its CSS size; a 1× display's at its own; a 3×'s at 1.5×.
@test
fn the_scene_is_drawn_at_most_one_and_a_half_times_css_pixels() {
    let g = Scale {}
    assert(render_size(g, width: 2940, height: 1912, ratio: 2.0) == (2205, 1434))
    assert(render_size(g, width: 1280, height: 720, ratio: 1.0) == (1280, 720))
    assert(render_size(g, width: 1170, height: 2532, ratio: 3.0) == (585, 1266))
}
