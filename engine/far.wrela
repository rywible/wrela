// What a far eye can hold. A big, far thing reads as big and far by two things: the size of its
// parts, and its air. A pattern finer than a pixel fades to its mean (`shown`), and never crawls.
// What's far takes all the air its distance holds (`light::hazed`, in full). A scene that holds
// some of the air back makes a far thing read near and small, like a model held close. A big
// thing is big by having more parts at their own size, not by being a smaller thing scaled up.

/// How much of a pattern repeating every `period` m a pixel `foot` m wide can show: all of it
/// while it spans four pixels, none once it spans two. (Finer, it would only crawl.)
pub fn shown(period: f32, foot: f32) -> f32 {
    1.0 - smoothstep(0.25 * period, 0.5 * period, foot)
}

/// How wide a pixel is on a surface `t` m off, met at `facing` (the cosine between the ray and
/// the surface's normal), for a view `focal` deep on a screen `height` pixels tall (m). A face
/// turned from the eye spreads a pixel longer.
pub fn foot(t: f32, height: f32, focal: f32, facing: f32) -> f32 {
    t * 2.0 / (height * focal) / max(abs(facing), 0.25)
}

// ---- the vista ------------------------------------------------------------------------------
//
// A far thing that doesn't move (a mountain, a floating rock, a city kilometres off) is drawn
// into a picture of its own, pinned to the world and not the screen: a pinhole view from a
// fixed eye (`Vista::eye`, where the camera was when it was aimed) looking at it, at finer than
// the screen's pixels. Each drawing adds a few more looks to a band of its texels, each look at
// its own place in the texel (`stratum`), and each texel keeps their plain mean (`gathered`),
// up to `KEPT` of them. The screen reads it through each pixel's ray (`vista_seen`).
//
// Why: drawn in the screen's own pixels, such a thing has to be met again as the camera bobs
// and turns, and a spire or a window thinner than a pixel is met all or nothing each time. A
// few looks a drawing, carried from drawing to drawing in the screen's pixels, never settle:
// the carried picture has to be slid and resampled to follow every bob, and held long it
// smears, so it's held short, and each new look jumps the pixel. Pinned to the world, a texel
// holds the same patch of the thing however the camera turns, so its mean of many looks
// settles and stays. Only the eye's own travel moves the thing in it, by its parallax, a
// fraction of a texel over tens of metres at kilometres off; that's read through each texel's
// depth, and past `REAIM` m the vista is aimed again from where the eye is (`aimed`), what it
// held carried over to the new one.

/// A vista's view: its eye, its axes, its focal length (`vista_ray`), its texels a side, and
/// how far its thing's middle is.
pub struct Vista: Copy + GpuData {
    pub eye: vec3,
    pub focal: f32,
    pub right: vec3,
    pub up: vec3,
    pub size: f32,
    pub forward: vec3,
    pub depth: f32,
}

/// The most looks a texel's mean holds: past them a new look weighs one part in so many, so a
/// light that changes slowly (a storm coming on) still comes through.
pub const KEPT: f32 = 32.0

/// How far (m) the eye may travel from where its vista was aimed before it's aimed again: read
/// through each texel's depth, what it holds stays where it is till what's nearer starts to
/// uncover what's behind, far past this at kilometres off.
pub const REAIM: f32 = 120.0

/// A vista from `eye` of a thing within the sphere `bound` (its middle, its radius), `size`
/// texels a side, the sphere filling all but `margin` of it.
pub fn aimed(eye: vec3, bound: vec4, size: f32, margin: f32) -> Vista {
    let to = bound.xyz - eye
    let depth = length(to)
    let forward = to / depth
    let side = if abs(forward.y) > 0.99 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
    let right = normalize(cross(forward, side) * -1.0)
    let up = cross(right, forward)
    // (The sphere's edge seen from the eye: its half width's tangent.)
    let half = bound.w / sqrt(max(depth * depth - bound.w * bound.w, 1.0))
    Vista { eye, forward, right, up, focal: 1.0 / (half * (1.0 + margin)), size, depth }
}

/// The ray from the vista's eye through texel place `px` (texel centres at half-integers, y
/// down).
pub fn vista_ray(v: Vista, px: vec2) -> vec3 {
    let uv = (px * 2.0 - vec2(v.size)) / v.size
    normalize(v.forward * v.focal + v.right * uv.x - v.up * uv.y)
}

/// Where in the vista (texels) the world point `w` lies, and whether it's in it (z: 1 or 0).
pub fn vista_at(v: Vista, w: vec3) -> vec3 {
    let r = w - v.eye
    let z = dot(r, v.forward)
    let uv = vec2(dot(r, v.right), -dot(r, v.up)) * (v.focal / max(z, 1.0e-3))
    let at = (uv * v.size + vec2(v.size)) * 0.5
    let inside = z > 0.0 && at.x >= 0.0 && at.y >= 0.0 && at.x < v.size && at.y < v.size
    vec3(at, if inside { 1.0 } else { 0.0 })
}

/// Where in texel `texel` (its corner) its `n`th look goes: the R2 sequence, each texel's turned
/// by its own hash so neighbours' looks don't line up. Any `n` looks are spread over the texel
/// more evenly than at random, so an edge's share of it comes right faster.
pub fn stratum(n: f32, texel: vec2) -> vec2 {
    let turn = fract(
        sin(vec2(dot(texel, vec2(12.9898, 78.233)), dot(texel, vec2(39.3468, 11.135)))) * 43758.547,
    )
    texel + fract(vec2(0.5) + turn + n * vec2(0.7548777, 0.5698403))
}

/// The mean `old` of `n` looks with `look` added (`n` capped at `KEPT`).
pub fn gathered(old: vec4, look: vec4, n: f32) -> vec4 {
    mix(old, look, 1.0 / min(n + 1.0, KEPT))
}

/// Whether the eye at `eye` has gone so far from where vista `v` was aimed that it's aimed again.
pub fn strayed(v: Vista, eye: vec3) -> bool {
    length(eye - v.eye) > REAIM
}

/// Whether the eye has jumped (a save loaded, a cut) rather than travelled from where vista `v`
/// was aimed: travelling, it's aimed again as soon as it strays, so never this far. What it holds
/// is then of another view, and it starts again.
pub fn jumped(v: Vista, eye: vec3) -> bool {
    length(eye - v.eye) > 2.0 * REAIM
}

/// How many texels a side a vista of the sphere `bound` from `eye` needs for one texel to a pixel
/// of a camera `rows` pixels high with focal length `focal` (a pixel `2 / (rows * focal)` of its
/// tangent): its texels are `2 * half * (1 + margin) / size` of theirs.
pub fn texels_needed(eye: vec3, bound: vec4, margin: f32, rows: f32, focal: f32) -> f32 {
    let depth = length(bound.xyz - eye)
    let half = bound.w / sqrt(max(depth * depth - bound.w * bound.w, 1.0))
    half * (1.0 + margin) * rows * focal
}

/// How many texels a vista's are to a screen pixel (`vista_side`): sharper than the screen, so
/// reading it through each pixel's footprint doesn't soften it.
pub const FINER: f32 = 2.0

/// The most texels a side a vista is (its memory goes as the square: at this, 64 MB).
pub const MOST_SIDE: u32 = 1024

/// The fewest.
const FEWEST_SIDE: u32 = 256

/// What a vista's side rounds up to: so many drawings go to looking at it whole
/// (`side / SWEEP` rows a drawing).
pub const SWEEP: u32 = 32

/// A vista's side for `needed` texels (`texels_needed`): `FINER` times, a whole number of
/// `SWEEP`s, from `FEWEST_SIDE` to `MOST_SIDE`.
pub fn vista_side(needed: f32) -> u32 {
    let want = u32(ceil(needed * FINER / f32(SWEEP))) * SWEEP
    clamp(want, FEWEST_SIDE, MOST_SIDE)
}

/// Whether a vista serves a camera that `needed` texels (`texels_needed`) would show one to a
/// pixel, from `eye`, of the sphere `bound`: its texels no coarser than `COARSEST` pixels, and
/// the eye well outside the sphere (near, a pinhole's texels stretch at its edges, and the thing
/// fills the screen: drawn as ever there). `slack` above 1 widens both, for one already in use, so
/// it doesn't come and go on the line.
pub fn vista_fits(eye: vec3, bound: vec4, needed: f32, slack: f32) -> bool {
    let depth = length(bound.xyz - eye)
    needed <= f32(MOST_SIDE) * COARSEST * slack && depth * slack >= bound.w * NEAREST
}

/// The coarsest a vista's texels may be, in screen pixels.
const COARSEST: f32 = 1.5

/// The nearest the eye may be to the sphere's middle, in radii.
const NEAREST: f32 = 1.6

@test
fn a_vista_point_is_where_its_ray_goes() {
    let v = aimed(
        vec3(0.0, 3.0, 0.0),
        vec4(-1890.0, 1500.0, 7560.0, 1890.0),
        size: 512.0,
        margin: 0.05,
    )
    for px in [vec2(0.5, 0.5), vec2(256.0, 256.0), vec2(100.25, 400.75), vec2(511.5, 3.5)] {
        let w = v.eye + vista_ray(v, px) * 7000.0
        let at = vista_at(v, w)
        assert(at.z > 0.5 && length(at.xy - px) < 1.0e-2, f"texel {px} came back at {at.xy}")
    }
    let edge = vista_at(v, vec3(-1890.0, 1500.0 + 1890.0, 7560.0))
    assert(edge.z > 0.5, "the vista doesn't hold its sphere's top")
}

@test
fn a_texels_looks_spread_over_it() {
    var lo = vec2(1.0)
    var hi = vec2(0.0)
    var mean = vec2(0.0)
    for i in 0..16 {
        let p = stratum(f32(i), vec2(7.0, 3.0)) - vec2(7.0, 3.0)
        assert(p.x >= 0.0 && p.x < 1.0 && p.y >= 0.0 && p.y < 1.0, f"look {i} left its texel: {p}")
        lo = min(lo, p)
        hi = max(hi, p)
        mean += p / 16.0
    }
    assert(hi.x - lo.x > 0.8 && hi.y - lo.y > 0.8, "sixteen looks bunched in one part of the texel")
    assert(length(mean - vec2(0.5)) < 0.08, f"sixteen looks lean to one side: {mean}")
}

@test
fn a_vista_is_finer_than_the_screen_and_gives_way_near() {
    let b = vec4(-1890.0, 1500.0, 7560.0, 1890.0)
    let eye = vec3(0.0, 3.0, 0.0)
    // (The opening's sailing camera at 720p, a sixth of the screen's height to its focal.)
    let n = texels_needed(eye, b, 0.04, rows: 540.0, focal: 1.75)
    let side = vista_side(n)
    assert(f32(side) >= n * FINER - 0.5 || side == MOST_SIDE, f"{side} texels for {n} pixels")
    assert(side % SWEEP == 0, f"a side of {side} isn't whole sweeps")
    assert(vista_fits(eye, b, n, 1.0), "the sailing camera's vista doesn't fit")
    // (Under the rock: drawn as ever.)
    assert(!vista_fits(vec3(-1890.0, 3.0, 7000.0), b, n, 1.0), "a vista fits from under the rock")
    // (A long lens on a big screen: past the most texels, drawn as ever.)
    let tele = texels_needed(eye, b, 0.04, rows: 2160.0, focal: 6.0)
    assert(!vista_fits(eye, b, tele, 1.0), f"a vista of {tele} texels fits")
}

@test
fn a_mean_settles() {
    var m = vec4(0.0)
    for i in 0..10 {
        m = gathered(m, vec4(if i % 2 == 0 { 1.0 } else { 0.0 }), f32(i))
    }
    assert(abs(m.x - 0.5) < 1.0e-5, f"ten looks, half of them 1, meaned {m.x}")
}
