// Contacts between a box and a sphere or a capsule, as MuJoCo MJX 3.16 computes them (its
// `collision_convex`: the box as a convex polyhedron, separating axes on its faces, clipping
// against a face's sides, a shallow contact on an edge), in f64, so an articulated body
// (`engine::articulated`) touches steps, ledges and ramps as it did in training. The method from
// MJX's source; nothing copied.
//
// A contact is its distance (negative through), its place (midway between the surfaces) and its
// normal (from the box to the other shape, MJX's sign), each in the world.

use quatd::normalized3

/// A box: its middle, its turn (its frame's three columns) and its half sizes.
pub struct Box: Copy {
    pub at: vec3d,
    pub mat: [vec3d; 3],
    pub size: vec3d,
}

/// A contact: how far apart (negative through), where, and the normal from the box.
pub struct Touch: Copy {
    pub dist: f64,
    pub pos: vec3d,
    pub normal: vec3d,
}

// The unit box's corners, in itertools.product((-1, 1), (-1, 1), (-1, 1))'s order, and its faces
// (counter-clockwise, outward): left, bottom, front, right, top, back.
const CORNERS: [vec3d; 8] = [
    vec3d(-1.0, -1.0, -1.0),
    vec3d(-1.0, -1.0, 1.0),
    vec3d(-1.0, 1.0, -1.0),
    vec3d(-1.0, 1.0, 1.0),
    vec3d(1.0, -1.0, -1.0),
    vec3d(1.0, -1.0, 1.0),
    vec3d(1.0, 1.0, -1.0),
    vec3d(1.0, 1.0, 1.0),
]
const FACES: [[u32; 4]; 6] = [
    [0, 4, 5, 1],
    [0, 2, 6, 4],
    [6, 7, 5, 4],
    [2, 3, 7, 6],
    [1, 5, 7, 3],
    [0, 1, 3, 2],
]

/// Each face's outward normal (from its corners, as MJX's `_get_face_norm`).
fn face_normal(f: u32) -> vec3d {
    let v = FACES[f]
    let e0 = CORNERS[v[1]] - CORNERS[v[0]]
    let e1 = CORNERS[v[3]] - CORNERS[v[0]]
    let n = cross(e0, e1)
    n / sqrt(dot(n, n))
}

/// The box's edges, each a pair of corners with the normals of its two faces, in the order MJX's
/// `_get_edge_normals` finds them (each face's edges in turn, the first time each is met).
struct Edge: Copy {
    a: u32,
    b: u32,
    n0: vec3d,
    n1: vec3d,
}

fn edges() -> [Edge; 12] {
    var out = [Edge { a: 0, b: 0, n0: vec3d(0.0, 0.0, 0.0), n1: vec3d(0.0, 0.0, 0.0) }; 12]
    var count = 0
    for f in 0..6 {
        for k in 0..4 {
            let v = FACES[f]
            let (p, q) = (v[k], v[(k + 3) % 4])
            let (a, b) = (min(p, q), max(p, q))
            var found = 12
            for e in 0..count {
                if out[e].a == a && out[e].b == b {
                    found = e
                }
            }
            if found < 12 {
                out[found].n1 = face_normal(f)
            } else {
                out[count] = Edge { a, b, n0: face_normal(f), n1: vec3d(0.0, 0.0, 0.0) }
                count += 1
            }
        }
    }
    out
}

const EDGES: [Edge; 12] = edges()

fn to_box(b: Box, p: vec3d) -> vec3d {
    let d = p - b.at
    vec3d(dot(b.mat[0], d), dot(b.mat[1], d), dot(b.mat[2], d))
}

fn from_box(b: Box, v: vec3d) -> vec3d {
    b.mat[0] * v.x + b.mat[1] * v.y + b.mat[2] * v.z
}

fn corner(b: Box, i: u32) -> vec3d {
    let c = CORNERS[i]
    vec3d(c.x * b.size.x, c.y * b.size.y, c.z * b.size.z)
}

/// MJX's `closest_segment_point`: the point of segment a–b nearest `p`.
fn closest_on_segment(a: vec3d, b: vec3d, p: vec3d) -> vec3d {
    let ab = b - a
    let t = dot(p - a, ab) / (dot(ab, ab) + 1.0e-6)
    a + ab * clamp(t, 0.0, 1.0)
}

/// The contact of a sphere (centre `c`, radius `r`) with a box: MJX's `_sphere_convex`.
pub fn sphere_box(c: vec3d, r: f64, b: Box) -> Touch {
    let s = to_box(b, c)
    // The face whose plane best separates the sphere from the box.
    var best = 0
    var best_support = -1.0e300
    var separated = false
    for f in 0..6 {
        let n = face_normal(f)
        let support = dot(s - n * r - corner(b, FACES[f][0]), n)
        if support >= 0.0 {
            separated = true
        }
        if support > best_support {
            best_support = support
            best = f
        }
    }
    let n = face_normal(best)
    let v = FACES[best]
    // The sphere's centre projected onto that face, or onto the nearest of its sides it's past.
    let f0 = corner(b, v[0])
    let pt0 = s - n * dot(s - f0, n)
    var inside = true
    var edge_best = 4
    var edge_dist = 1.0e12
    for k in 0..4 {
        let p0 = corner(b, v[(k + 3) % 4])
        let p1 = corner(b, v[k])
        let side = cross(p1 - p0, n)
        let d = dot(pt0 - p0, side)
        if d > 0.0 {
            inside = false
        }
        let degenerate = side.x == 0.0 && side.y == 0.0 && side.z == 0.0
        let score = if degenerate || d < 0.0 { 1.0e12 } else { d }
        if score < edge_dist {
            edge_dist = score
            edge_best = k
        }
    }
    var pt = pt0
    if !inside {
        let k = if edge_best < 4 { edge_best } else { 0 }
        pt = closest_on_segment(corner(b, v[(k + 3) % 4]), corner(b, v[k]), pt0)
    }
    let (dir, d0) = normalized3(pt - s)
    let into = dot(pt, dir) > 0.0
    let sign = if into { -1.0 } else { 1.0 }
    let normal = if inside || d0 < 1.0e-6 { -n } else { dir * sign }
    let d = d0 * sign
    let spt = s + normal * r
    let dist = if separated { 1.0 } else { d - r }
    Touch { dist, pos: b.at + from_box(b, (pt + spt) * 0.5), normal: from_box(b, normal) }
}

/// MJX's `_closest_segment_point_plane`: where segment a–b meets the plane through `p0` with
/// normal `n` (clamped to the segment).
fn segment_plane(a: vec3d, b: vec3d, p0: vec3d, n: vec3d) -> vec3d {
    let d = dot(p0, n)
    let denom = dot(n, b - a)
    let t = (d - dot(n, a)) / (denom + if denom == 0.0 { 1.0e-6 } else { 0.0 })
    a + (b - a) * clamp(t, 0.0, 1.0)
}

/// MJX's `closest_segment_to_segment_points`: the nearest points of segments a0–a1 and b0–b1.
fn segments_nearest(a0: vec3d, a1: vec3d, b0: vec3d, b1: vec3d) -> (vec3d, vec3d) {
    let (dir_a, len_a) = normalized3(a1 - a0)
    let (dir_b, len_b) = normalized3(b1 - b0)
    let (half_a, half_b) = (len_a * 0.5, len_b * 0.5)
    let a_mid = a0 + dir_a * half_a
    let b_mid = b0 + dir_b * half_b
    let trans = a_mid - b_mid
    let ab = dot(dir_a, dir_b)
    let at = dot(dir_a, trans)
    let bt = dot(dir_b, trans)
    let denom = 1.0 - ab * ab
    let ta0 = (-at + ab * bt) / (denom + 1.0e-6)
    let tb0 = bt + ta0 * ab
    let best_a = a_mid + dir_a * clamp(ta0, -half_a, half_a)
    let best_b = b_mid + dir_b * clamp(tb0, -half_b, half_b)
    let new_a = closest_on_segment(a0, a1, best_b)
    let d1 = dot(best_b - new_a, best_b - new_a)
    let new_b = closest_on_segment(b0, b1, best_a)
    let d2 = dot(best_a - new_b, best_a - new_b)
    if d1 < d2 { (new_a, best_b) } else { (best_a, new_b) }
}

/// One end of a segment p–q clipped against a face's side planes (MJX's `clip_edge_point`): the
/// furthest along the segment of `p` and the places it crosses the planes it's in front of.
fn clip_end(p: vec3d, q: vec3d, front: [bool; 4], cuts: [vec3d; 4]) -> vec3d {
    var best = p
    var best_d = -1.0e300
    for k in 0..4 {
        let c = if front[k] { cuts[k] } else { p }
        let d = dot(c - p, q - p)
        if d > best_d {
            best_d = d
            best = c
        }
    }
    best
}

/// The two contacts of a capsule (centre `c`, axis `axis`, radius `r`, half length `half`) with a
/// box: MJX's `_capsule_convex` (on the face it least penetrates, the segment clipped to that face;
/// or the first on the box's nearest edge, when that contact is shallower).
pub fn capsule_box(c: vec3d, axis: vec3d, r: f64, half: f64, b: Box) -> [Touch; 2] {
    let cp = to_box(b, c)
    let ax = to_box(b, b.at + axis)
    let seg = ax * half
    let pts = [cp - seg, cp + seg]
    // The face with the least penetration (the most support).
    var best = 0
    var best_support = -1.0e300
    var all_below = true
    for f in 0..6 {
        let n = face_normal(f)
        let f0 = corner(b, FACES[f][0])
        let support = min(dot(pts[0] - n * r - f0, n), dot(pts[1] - n * r - f0, n))
        if !(support < 0.0) {
            all_below = false
        }
        if support > best_support {
            best_support = support
            best = f
        }
    }
    let n = face_normal(best)
    let v = FACES[best]
    let f0 = corner(b, v[0])
    // The segment clipped against the face's sides.
    var front0 = [false; 4]
    var front1 = [false; 4]
    var cuts = [vec3d(0.0, 0.0, 0.0); 4]
    for k in 0..4 {
        let p0 = corner(b, v[(k + 3) % 4])
        let p1 = corner(b, v[k])
        let side = cross(p1 - p0, n)
        front0[k] = dot(pts[0] - p0, side) > 1.0e-6
        front1[k] = dot(pts[1] - p0, side) > 1.0e-6
        cuts[k] = segment_plane(pts[0], pts[1], p0, side)
    }
    let new0 = clip_end(pts[0], pts[1], front0, cuts)
    let new1 = clip_end(pts[1], pts[0], front1, cuts)
    var keep = true
    for k in 0..4 {
        if front0[k] && front1[k] {
            keep = false
        }
    }
    var clipped = if keep { [new0, new1] } else { [pts[0], pts[1]] }
    if dot(pts[0] - pts[1], clipped[0] - clipped[1]) < 0.0 {
        keep = false
    }
    var pos = [vec3d(0.0, 0.0, 0.0); 2]
    var normals = [-n, -n]
    var face_pen = [0.0; 2]
    for i in 0..2 {
        clipped[i] = clipped[i] - n * r
        let on_face = clipped[i] - n * dot(clipped[i] - f0, n)
        pos[i] = (clipped[i] + on_face) * 0.5
        face_pen[i] = if keep && all_below { dot(on_face - clipped[i], n) } else { -1.0 }
    }
    // A shallow contact on the box's nearest edge.
    var e_best = 0
    var e_dist = 1.0e300
    var e_axis = vec3d(0.0, 0.0, 0.0)
    var e_degenerate = false
    var e_pt = vec3d(0.0, 0.0, 0.0)
    var c_pt = vec3d(0.0, 0.0, 0.0)
    for e in 0..12 {
        let (ep, cpt) = segments_nearest(
            corner(b, EDGES[e].a),
            corner(b, EDGES[e].b),
            pts[0],
            pts[1],
        )
        let dir = ep - cpt
        let (axis_e, dist_e) = normalized3(dir)
        if abs(dist_e) < e_dist {
            e_dist = abs(dist_e)
            e_best = e
            e_axis = axis_e
            e_degenerate = dot(dir, dir) < 1.0e-6
            e_pt = ep
            c_pt = cpt
        }
    }
    let front = dot(EDGES[e_best].n0, e_axis) < 0.0 && dot(EDGES[e_best].n1, e_axis) < 0.0
    let shallow = !e_degenerate && front
    let edge_pen = if shallow { r - e_dist } else { -1.0 }
    let edge_pos = (e_pt + (c_pt + e_axis * r)) * 0.5
    let parallel = abs(dot(e_axis, n)) > 0.99 && !e_degenerate
    let min_face = min(face_pen[0], face_pen[1])
    let edge = edge_pen > 0.0 && (if min_face > 0.0 { edge_pen < min_face } else {
        true
    }) && !parallel && front
    var dist = [-face_pen[0], -face_pen[1]]
    if edge {
        pos[0] = edge_pos
        normals[0] = e_axis
        dist = [-edge_pen, 1.0]
    }
    [
        Touch { dist: dist[0], pos: b.at + from_box(b, pos[0]), normal: from_box(b, normals[0]) },
        Touch { dist: dist[1], pos: b.at + from_box(b, pos[1]), normal: from_box(b, normals[1]) },
    ]
}

// ---- tests ---------------------------------------------------------------------------------------

use golden::{Fixture, apart}
use quatd::qmat

/// MJX's `make_frame`, as `engine::articulated` has it: the normal and two tangents.
fn frame_of(n0: vec3d) -> [vec3d; 3] {
    let (a, _) = normalized3(n0)
    var b = if -0.5 < a.y && a.y < 0.5 { vec3d(0.0, 1.0, 0.0) } else { vec3d(0.0, 0.0, 1.0) }
    b = b - a * dot(a, b)
    let (bn, _) = normalized3(b)
    [a, bn, cross(a, bn)]
}

fn touch_numbers(t: Touch) -> Vec<f64> {
    let f = frame_of(t.normal)
    var out: Vec<f64> = Vec::new()
    out.push(t.dist)
    for v in [t.pos, f[0], f[1], f[2]] {
        out.push(v.x)
        out.push(v.y)
        out.push(v.z)
    }
    out
}

/// A sphere's and a capsule's contacts with boxes agree with MJX's (in f64) for forty random boxes
/// and places on and past their faces, edges and corners.
@test
fn box_contacts_agree_with_mjx() {
    var fx = Fixture::of(embed("fixtures/boxes.wfx"))
    let cases = u32(fx.f())
    var worst = 0.0
    for case in 0..cases {
        let size = vec3d(fx.f(), fx.f(), fx.f())
        let at = vec3d(fx.f(), fx.f(), fx.f())
        let mat = qmat(vec4d(fx.f(), fx.f(), fx.f(), fx.f()))
        let b = Box { at, mat, size }
        let sc = vec3d(fx.f(), fx.f(), fx.f())
        let r = fx.f()
        let cc = vec3d(fx.f(), fx.f(), fx.f())
        let cq = vec4d(fx.f(), fx.f(), fx.f(), fx.f())
        let (cr, ch) = (fx.f(), fx.f())
        let s = sphere_box(sc, r, b)
        let caps = capsule_box(cc, qmat(cq)[2], cr, ch, b)
        let a0 = apart(touch_numbers(s), fx.many(13))
        let a1 = apart(touch_numbers(caps[0]), fx.many(13))
        let a2 = apart(touch_numbers(caps[1]), fx.many(13))
        let here = max(a0, max(a1, a2))
        if here > 1.0e-9 {
            std::io::print(f"case {case}: sphere {a0}, capsule {a1} {a2}")
        }
        worst = max(worst, here)
    }
    std::io::print(f"box contacts: worst {worst} from MJX")
    assert(worst < 1.0e-12, f"box contacts are {worst} from MJX")
}
