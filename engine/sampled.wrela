// Sampled shapes: a distance stored as samples on a lattice, read from GPU memory, realized into
// the same meshes as a field's (`realize::Mesh`).
//
// A field written as code is evaluated wherever the realizer asks; a constant table in it is
// written out in the WGSL of every pipeline that reads it, and copied into each invocation's
// memory, so a detailed table (a sculpt's distance) is over a pipeline's 256 KiB (E0707). A
// sampled shape keeps its samples in a buffer instead: bricks of the realizer's blocks (4 cells,
// 5³ samples a side, so a cell's corners are in its block), a byte a sample, and a slot per block
// saying whether the block is all outside, all inside or stored. Realizing it is the realizer's
// passes 2 to 4 with the samples for the field: the blocks it stores are the live ones; each
// cell the surface crosses gets a vertex where the planes through its edges' crossings best
// meet (the crossings and normals of the samples' trilinear blend); then its quads and
// `realize::finish_mesh` as for any field. Its vertices go whole to one bone, as a rigid
// realization's do.
//
// Its edges stay sharp: a field's vertex has one normal, the blend's gradient, which rounds a
// crease off in the shading however sharp the surface is (a cut stone's edges look melted). Here
// each cell's vertex looks at the quads round it, sorts their normals into sides (a quad joins
// the side its normal is within `CREASE` degrees of, or starts one), and becomes a vertex a side,
// each with its side's mean normal; each quad then takes, at each corner, the vertex of the side
// that faces as it does. Faces meeting at a gentler angle share a vertex and shade smoothly.

use realize::{
    BLOCK, CellWord, Grid, LiveBlock, Mesh, NO_VERTEX, QEF_PULL, Quad, Room, Scratch, SkinVertex,
    cell_key, corner_offset, finish_mesh, solve3, vertex_at,
}
use creature::PartMask
use std::gpu::{
    Append, AppendBuffer, Atomics, GlobalId, GpuBuffer, LocalId, Slots, WorkgroupId, append_buffer,
    buffer, dispatch, write,
}

/// A block's slot: all outside, all inside; a stored block's is `STORED` + its index.
pub const OUTSIDE: u32 = 0
pub const INSIDE: u32 = 1
pub const STORED: u32 = 2

/// The words a stored block takes: its 125 samples, a byte each, four to a word, x slowest.
pub const BLOCK_WORDS: u32 = 32

/// Where a sampled shape's lattice lies and what its bytes mean: blocks of `realize::BLOCK` cells
/// `cell` wide from `origin`, `size` blocks along each axis; a byte `b` is the distance
/// `(b / 255 − ½) × 2 × band`; its vertices go to bone `bone`.
pub struct Lattice: Copy + GpuData {
    pub origin: vec3,
    pub cell: f32,
    pub size: vec3u,
    pub band: f32,
    pub bone: u32,
}

impl Lattice {
    /// Its grid, as the realizer's passes read it.
    pub fn grid(self) -> Grid {
        Grid {
            origin: self.origin,
            cell: self.cell,
            size: self.size,
            blocks: self.size.x * self.size.y * self.size.z,
        }
    }
}

/// A sampled shape on the GPU: its lattice, each block's slot, and the stored blocks' words.
pub struct Sampled {
    pub lattice: Lattice,
    pub slots: GpuBuffer<u32>,
    pub samples: GpuBuffer<u32>,
    /// How many blocks it stores.
    pub stored: u32,
}

/// A sampled shape from its tables (written by a tool from a distance: `slots`, a slot a block,
/// x fastest; `samples`, `BLOCK_WORDS` words a stored block), uploaded once.
pub fn sampled(lattice: Lattice, slots: [u32], samples: [u32]) -> Sampled {
    let stored = samples.len() / BLOCK_WORDS
    for v in slots {
        assert(v < STORED || v - STORED < stored, f"a sampled shape's slot {v} is past its blocks")
    }
    var s: GpuBuffer<u32> = buffer(slots.len())
    write(mut s, 0, slots)
    var w: GpuBuffer<u32> = buffer(max(samples.len(), 1))
    if samples.len() > 0 {
        write(mut w, 0, samples)
    }
    Sampled { lattice, slots: s, samples: w, stored }
}

/// A sampled shape's tables on the CPU, as a tool wrote them: to upload (`upload`), and to ask
/// its distance anywhere (`distance`: a test's, or a hit's).
pub struct Samples {
    pub lattice: Lattice,
    pub slots: Vec<u32>,
    pub words: Vec<u32>,
}

impl Samples {
    /// The tables on the GPU.
    pub fn upload(self) -> Sampled {
        sampled(self.lattice, self.slots, self.words)
    }

    /// Its distance at `p` (m), as the realized mesh has it: the samples' trilinear blend in
    /// a stored block; `band` (or −`band`) in a block all outside (inside); outside the
    /// lattice, `band` plus how far `p` is from it.
    pub fn distance(self, p: vec3) -> f32 {
        let l = self.lattice
        let n = vec3(l.size * BLOCK)
        let q = (p - l.origin) / l.cell
        let past = length(max(max(-q, q - n), vec3(0.0))) * l.cell
        if past > 0.0 {
            return l.band + past
        }
        let c = vec3u(min(q, n - vec3(0.001)))
        let f = q - vec3(c)
        let b = c / BLOCK
        let slot = self.slots[b.x + l.size.x * (b.y + l.size.y * b.z)]
        if slot < STORED {
            return if slot == OUTSIDE { l.band } else { -l.band }
        }
        let base = (slot - STORED) * BLOCK_WORDS
        let lc = c - b * BLOCK
        var v = [0.0; 8]
        for j in 0..8 {
            let k = lc + corner_offset(j)
            let i = (k.x * 5 + k.y) * 5 + k.z
            let byte = (self.words[base + i / 4] >> ((i % 4) * 8)) & 255
            v[j] = (f32(byte) / 255.0 - 0.5) * 2.0 * l.band
        }
        mix(
            mix(mix(v[0], v[1], f.x), mix(v[2], v[3], f.x), f.y),
            mix(mix(v[4], v[5], f.x), mix(v[6], v[7], f.x), f.y),
            f.z,
        )
    }
}

/// Sample `c` (0 to 4 along each axis) of the stored block whose words start at `base`.
fn sample(samples: [u32], base: u32, c: vec3u, band: f32) -> f32 {
    let i = (c.x * 5 + c.y) * 5 + c.z
    let b = (samples[base + i / 4] >> ((i % 4) * 8)) & 255
    (f32(b) / 255.0 - 0.5) * 2.0 * band
}

/// The gradient of the trilinear blend of a cell's corners `v` (corner `j` at
/// `realize::corner_offset(j)`) at `f` (0 to 1 along each axis), per cell.
fn blend_gradient(v: [f32; 8], f: vec3) -> vec3 {
    let (x, y, z) = (f.x, f.y, f.z)
    // Along x: the four edges' differences, blended over y and z; and so on.
    let gx = mix(mix(v[1] - v[0], v[3] - v[2], y), mix(v[5] - v[4], v[7] - v[6], y), z)
    let gy = mix(mix(v[2] - v[0], v[3] - v[1], x), mix(v[6] - v[4], v[7] - v[5], x), z)
    let gz = mix(mix(v[4] - v[0], v[5] - v[1], x), mix(v[6] - v[2], v[7] - v[3], x), y)
    vec3(gx, gy, gz)
}

/// The blocks a sampled shape stores are its live ones: each stored block's live slot + 1 in
/// the block map, 0 for the rest.
@compute(64)
pub fn cull_sampled(
    grid: Grid,
    slots: [u32],
    live: mut Append<LiveBlock>,
    block_map: mut Slots<u32>,
    id: GlobalId,
) {
    if id.x >= grid.blocks {
        return
    }
    if slots[id.x] < STORED {
        block_map[id] = 0
        return
    }
    block_map[id] = live.push(LiveBlock { block: id.x, mask: PartMask::bit(0) }) + 1
}

/// In each live block, a vertex for every cell the surface crosses: its edges' crossings (where
/// the samples' blend along each is 0) and the blend's gradient there, a QEF pulled toward
/// their mean, clamped to the cell, as `realize::place_vertices` places a field's. The cell map
/// gets its signs and vertex.
@compute(4, 4, 4)
pub fn place_sampled_vertices(
    lattice: Lattice,
    grid: Grid,
    first: u32,
    blocks: [LiveBlock],
    slots: [u32],
    samples: [u32],
    cells: mut Atomics<u32>,
    verts: mut Append<SkinVertex>,
    block: WorkgroupId,
    lid: LocalId,
) {
    let slot = block.x + first
    let lb = blocks[slot]
    let key = cell_key(slot, lid.xyz(), cells.len() / (BLOCK * BLOCK * BLOCK))
    let base = (slots[lb.block] - STORED) * BLOCK_WORDS
    var vals = [0.0; 8]
    var signs = 0
    for j in 0..8 {
        vals[j] = sample(samples, base, lid.xyz() + corner_offset(j), lattice.band)
        if vals[j] < 0.0 {
            signs = signs | (1 << j)
        }
    }
    if signs == 0 || signs == 255 {
        cells.store(key, u32(CellWord { vertex: NO_VERTEX, signs }))
        return
    }
    let cell = grid.cell
    let cmin = grid.corner(grid.block_xyz(lb.block) * BLOCK + lid.xyz())
    var pts = [vec3(0.0); 12]
    var nrm = [vec3(0.0); 12]
    var n = 0
    var mass = vec3(0.0)
    for e in 0..12 {
        let axis = e >> 2
        let r = e & 3
        let ja = ((r & 1) << ((axis + 1) % 3)) | ((r >> 1) << ((axis + 2) % 3))
        let jb = ja | (1 << axis)
        let (va, vb) = (vals[ja], vals[jb])
        if (va < 0.0) == (vb < 0.0) {
            continue
        }
        let t = va / (va - vb)
        let f = vec3(corner_offset(ja)) + vec3(corner_offset(jb) - corner_offset(ja)) * t
        let at = cmin + f * cell
        pts[n] = at
        nrm[n] = normalize(blend_gradient(vals, f))
        mass += at
        n += 1
    }
    let m = mass / f32(n)
    var a0 = vec3(QEF_PULL, 0.0, 0.0)
    var a1 = vec3(0.0, QEF_PULL, 0.0)
    var a2 = vec3(0.0, 0.0, QEF_PULL)
    var rhs = vec3(0.0)
    for i in 0..n {
        let q = nrm[i]
        a0 += q * q.x
        a1 += q * q.y
        a2 += q * q.z
        rhs += q * dot(q, pts[i] - m)
    }
    let pos = clamp(m + solve3(a0, a1, a2, rhs), cmin, cmin + vec3(cell))
    // The gradient there, or (where it vanishes, as at a saddle's middle) its crossings' normals'.
    let gradient = blend_gradient(vals, (pos - cmin) / cell)
    var crossed = vec3(0.0)
    for i in 0..n {
        crossed += nrm[i]
    }
    let normal = unit_or(gradient, unit_or(crossed, vec3(0.0, 1.0, 0.0)))
    let vi = verts.push(
        SkinVertex { pos, bones: lattice.bone, normal, weights: 255, mask: lb.mask },
    )
    cells.store(key, u32(CellWord { vertex: min(vi, NO_VERTEX), signs }))
}

/// `v` made a unit long, or `instead` where it's too short to have a direction.
fn unit_or(v: vec3, instead: vec3) -> vec3 {
    if dot(v, v) > 1.0e-20 { normalize(v) } else { instead }
}

/// The angle (degrees) past which two faces meeting at a vertex make a crease: the vertex is split
/// into one for each side of it, so the edge shades sharp. Gentler bends shade smoothly.
pub const CREASE: f32 = 40.0

/// The most sides a vertex is split into.
pub const SIDES: u32 = 4

/// The words a cell's vertex takes in the sides map: its sides' vertices (`NO_VERTEX` past the
/// last), then their normals, packed, then where it is (its position's three words): the pass
/// that reads its sides reads its place there too, and so binds one buffer fewer.
const SIDE_WORDS: u32 = 2 * SIDES + 3

/// `x`'s sign, 1 for 0.
fn sign_of(x: f32) -> f32 {
    if x < 0.0 { -1.0 } else { 1.0 }
}

/// A unit normal in a word: octahedral, 16 bits an axis.
pub fn pack_normal(n: vec3) -> u32 {
    var p = vec2(n.x, n.y) / (abs(n.x) + abs(n.y) + abs(n.z))
    if n.z < 0.0 {
        p = (vec2(1.0) - abs(vec2(p.y, p.x))) * vec2(sign_of(p.x), sign_of(p.y))
    }
    let q = clamp(p * 0.5 + vec2(0.5), vec2(0.0), vec2(1.0)) * 65535.0
    u32(round(q.x)) | (u32(round(q.y)) << 16)
}

/// A normal `pack_normal` packed.
pub fn unpack_normal(w: u32) -> vec3 {
    let p = vec2(f32(w & 65535), f32(w >> 16)) / 65535.0 * 2.0 - vec2(1.0)
    let z = 1.0 - abs(p.x) - abs(p.y)
    if z >= 0.0 {
        return normalize(vec3(p.x, p.y, z))
    }
    let q = (vec2(1.0) - abs(vec2(p.y, p.x))) * vec2(sign_of(p.x), sign_of(p.y))
    normalize(vec3(q.x, q.y, z))
}

/// The unit vectors along the two axes across `axis`.
fn across(axis: u32) -> (vec3i, vec3i) {
    let a1 = (axis + 1) % 3
    let a2 = (axis + 2) % 3
    (
        vec3i(i32(a1 == 0), i32(a1 == 1), i32(a1 == 2)),
        vec3i(i32(a2 == 0), i32(a2 == 1), i32(a2 == 2)),
    )
}

/// The outward normal (unit) of the quad round the lattice edge from point `g` along `axis` (the
/// cells `g`, `g − u`, `g − u − w` and `g − w` round it), inside at `g` or not; zero if a
/// cell round it has no vertex.
fn edge_normal(
    grid: Grid,
    block_map: [u32],
    cells: [u32],
    blocks: u32,
    points: [SkinVertex],
    g: vec3i,
    axis: u32,
    inside_low: bool,
) -> vec3 {
    let room = points.len()
    let (u, w) = across(axis)
    let a = vertex_at(grid, block_map, cells, blocks, room, g)
    let b = vertex_at(grid, block_map, cells, blocks, room, g - u)
    let c = vertex_at(grid, block_map, cells, blocks, room, g - u - w)
    let d = vertex_at(grid, block_map, cells, blocks, room, g - w)
    if a == NO_VERTEX || b == NO_VERTEX || c == NO_VERTEX || d == NO_VERTEX {
        return vec3(0.0)
    }
    quad_normal(points[a].pos, points[b].pos, points[c].pos, points[d].pos, axis, inside_low)
}

/// The outward normal (unit) of the quad whose corners are at `a`, `b`, `c` and `d` in order
/// round a lattice edge along `axis`, inside at the edge's low end or not; zero if it has no
/// area.
fn quad_normal(a: vec3, b: vec3, c: vec3, d: vec3, axis: u32, inside_low: bool) -> vec3 {
    let n = cross(c - a, d - b)
    let l = length(n)
    if l < 1.0e-12 {
        return vec3(0.0)
    }
    let along = vec3(f32(axis == 0), f32(axis == 1), f32(axis == 2))
    let out = if inside_low { along } else { -along }
    if dot(n, out) < 0.0 { -n / l } else { n / l }
}

/// Each cell's vertex (`points`) split into a vertex for each side of the creases through it
/// (pushed to `verts`, with its side's normal); the sides map gets them and their normals.
@compute(4, 4, 4)
pub fn crease_vertices(
    grid: Grid,
    first: u32,
    blocks: [LiveBlock],
    block_map: [u32],
    cells: [u32],
    points: [SkinVertex],
    cos_crease: f32,
    vroom: u32,
    verts: mut Append<SkinVertex>,
    sides: mut Atomics<u32>,
    block: WorkgroupId,
    lid: LocalId,
) {
    let slot = block.x + first
    let n = cells.len() / (BLOCK * BLOCK * BLOCK)
    let word = CellWord::of_bits(cells[cell_key(slot, lid.xyz(), n)])
    let v0 = word.vertex
    if v0 >= points.len() {
        return
    }
    let c = vec3i(grid.block_xyz(blocks[slot].block) * BLOCK + lid.xyz())
    // The quads round it are those of its crossed edges, one an edge.
    var sums = [vec3(0.0); 4]
    var count = 0
    for e in 0..12 {
        let axis = e >> 2
        let r = e & 3
        let ja = ((r & 1) << ((axis + 1) % 3)) | ((r >> 1) << ((axis + 2) % 3))
        let jb = ja | (1 << axis)
        let ia = (word.signs >> ja) & 1
        if ia == ((word.signs >> jb) & 1) {
            continue
        }
        let g = c + vec3i(corner_offset(ja))
        let nf = edge_normal(grid, block_map, cells, n, points, g, axis, ia == 1)
        if dot(nf, nf) == 0.0 {
            continue
        }
        var best = 0
        var near = -2.0
        for k in 0..count {
            let d = dot(unit_or(sums[k], nf), nf)
            if d > near {
                near = d
                best = k
            }
        }
        if count < SIDES && near < cos_crease {
            sums[count] = nf
            count += 1
        } else if near > 0.0 {
            sums[best] += nf
        }
    }
    let p = points[v0]
    if count == 0 {
        sums[0] = p.normal
        count = 1
    }
    sides.store(v0 * SIDE_WORDS + 2 * SIDES, bitcast_u32(p.pos.x))
    sides.store(v0 * SIDE_WORDS + 2 * SIDES + 1, bitcast_u32(p.pos.y))
    sides.store(v0 * SIDE_WORDS + 2 * SIDES + 2, bitcast_u32(p.pos.z))
    for k in 0..SIDES {
        if k < count {
            let nk = unit_or(sums[k], p.normal)
            let vi = verts.push(
                SkinVertex {
                    pos: p.pos,
                    bones: p.bones,
                    normal: nk,
                    weights: p.weights,
                    mask: p.mask,
                },
            )
            // Past the mesh's room the side has no vertex, and its quads are holes.
            sides.store(v0 * SIDE_WORDS + k, if vi < vroom { vi } else { NO_VERTEX })
            sides.store(v0 * SIDE_WORDS + SIDES + k, pack_normal(nk))
        } else {
            sides.store(v0 * SIDE_WORDS + k, NO_VERTEX)
        }
    }
}

/// Of cell vertex `v`'s sides (the sides map's), the vertex of the one facing most as `nf` does.
fn side_facing(sides: [u32], v: u32, nf: vec3) -> u32 {
    var best = NO_VERTEX
    var near = -2.0
    for k in 0..SIDES {
        let i = sides[v * SIDE_WORDS + k]
        if i == NO_VERTEX {
            continue
        }
        let d = dot(unpack_normal(sides[v * SIDE_WORDS + SIDES + k]), nf)
        if d > near {
            near = d
            best = i
        }
    }
    best
}

/// Where cell vertex `v` is (the sides map's).
fn side_pos(sides: [u32], v: u32) -> vec3 {
    let i = v * SIDE_WORDS + 2 * SIDES
    vec3(bitcast_f32(sides[i]), bitcast_f32(sides[i + 1]), bitcast_f32(sides[i + 2]))
}

/// `realize::emit_quads` for a creased mesh: each quad round a crossed edge takes, at each corner,
/// the side of that cell's vertex facing as it does.
@compute(4, 4, 4)
pub fn emit_creased_quads(
    grid: Grid,
    first: u32,
    blocks: [LiveBlock],
    block_map: [u32],
    cells: [u32],
    sides: [u32],
    quads: mut Append<Quad>,
    holes: mut Atomics<u32>,
    block: WorkgroupId,
    lid: LocalId,
) {
    let slot = block.x + first
    let n = cells.len() / (BLOCK * BLOCK * BLOCK)
    let room = sides.len() / SIDE_WORDS
    let cell = CellWord::of_bits(cells[cell_key(slot, lid.xyz(), n)])
    if cell.vertex >= room {
        return
    }
    let g = vec3i(grid.block_xyz(blocks[slot].block) * BLOCK + lid.xyz())
    let in0 = cell.signs & 1
    for axis in 0..3 {
        if in0 == ((cell.signs >> (1 << axis)) & 1) {
            continue
        }
        let (u, w) = across(axis)
        let p1 = vertex_at(grid, block_map, cells, n, room, g - u)
        let p2 = vertex_at(grid, block_map, cells, n, room, g - u - w)
        let p3 = vertex_at(grid, block_map, cells, n, room, g - w)
        if p1 == NO_VERTEX || p2 == NO_VERTEX || p3 == NO_VERTEX {
            let _ = holes.add(i: 0, value: 1)
            continue
        }
        let nf = quad_normal(
            side_pos(sides, cell.vertex),
            side_pos(sides, p1),
            side_pos(sides, p2),
            side_pos(sides, p3),
            axis,
            in0 == 1,
        )
        let v0 = side_facing(sides, cell.vertex, nf)
        let v1 = side_facing(sides, p1, nf)
        let v2 = side_facing(sides, p2, nf)
        let v3 = side_facing(sides, p3, nf)
        if v0 == NO_VERTEX || v1 == NO_VERTEX || v2 == NO_VERTEX || v3 == NO_VERTEX {
            let _ = holes.add(i: 0, value: 1)
            continue
        }
        let _ = quads.push(if in0 == 1 {
            Quad { a: v0, b: v1, c: v2, d: v0, e: v2, f: v3 }
        } else {
            Quad { a: v0, b: v2, c: v1, d: v0, e: v3, f: v2 }
        })
    }
}

/// `shape`'s mesh: a vertex for each cell its surface crosses, split along creases sharper than
/// `crease` degrees (room for one a cell of its stored blocks), a quad for each crossed edge, its
/// draw's arguments and tally, its vertices whole to its lattice's bone. 180 shades it all
/// smoothly. At most 65,535 stored blocks.
pub fn realize_sampled(shape: Sampled, crease: f32 = CREASE) -> Mesh {
    let grid = shape.lattice.grid()
    assert(shape.stored <= 65535, f"a sampled shape stores {shape.stored} blocks, past 65,535")
    assert(
        shape.slots.len() == grid.blocks,
        f"a sampled shape has {shape.slots.len()} slots for {grid.blocks} blocks",
    )
    let cells = BLOCK * BLOCK * BLOCK
    let room = max(shape.stored * cells, 1)
    var mesh = Mesh::new(Room { vertices: room, quads: room * 3 })
    var points: AppendBuffer<SkinVertex> = append_buffer(room)
    var sides: GpuBuffer<u32> = buffer(room * SIDE_WORDS)
    var scratch = Scratch::new(grid.blocks)
    write(mut mesh.holes, 0, [0])
    dispatch(
        cull_sampled.bind(
            grid: grid,
            slots: shape.slots.items(),
            live: mut scratch.live,
            block_map: mut scratch.block_map,
        ),
        groups: (grid.blocks + 63) / 64,
    )
    dispatch(
        place_sampled_vertices.bind(
            lattice: shape.lattice,
            grid: grid,
            first: 0,
            blocks: scratch.live.items(),
            slots: shape.slots.items(),
            samples: shape.samples.items(),
            cells: mut scratch.cells,
            verts: mut points,
        ),
        groups: scratch.live.count(),
    )
    dispatch(
        crease_vertices.bind(
            grid: grid,
            first: 0,
            blocks: scratch.live.items(),
            block_map: scratch.block_map.items(),
            cells: scratch.cells.items(),
            points: points.items(),
            cos_crease: cos(crease * 0.017453292),
            vroom: room,
            verts: mut mesh.verts,
            sides: mut sides,
        ),
        groups: scratch.live.count(),
    )
    dispatch(
        emit_creased_quads.bind(
            grid: grid,
            first: 0,
            blocks: scratch.live.items(),
            block_map: scratch.block_map.items(),
            cells: scratch.cells.items(),
            sides: sides.items(),
            quads: mut mesh.quads,
            holes: mut mesh.holes,
        ),
        groups: scratch.live.count(),
    )
    dispatch(
        finish_mesh.bind(
            vertices: mesh.verts.count(),
            quads: mesh.quads.count(),
            live: scratch.live.count(),
            holes: mesh.holes.items(),
            vroom: room,
            qroom: room * 3,
            draw: mut mesh.draw,
            skin: mut mesh.skin,
            tally: mut mesh.tally,
        ),
        groups: 1,
    )
    mesh
}

/// A base64 character's six bits, or 64 for any other character.
fn sextet(c: u32) -> u32 {
    if c >= 65 && c <= 90 {
        return c - 65
    }
    if c >= 97 && c <= 122 {
        return c - 71
    }
    if c >= 48 && c <= 57 {
        return c + 4
    }
    if c == 43 { 62 } else if c == 47 { 63 } else { 64 }
}

/// The words a tool wrote as base64 text, in lines (`A–Z a–z 0–9 + /`, four characters to three bytes,
/// the bytes little-endian four to a word): a sampled shape's tables, kept in source as text, a
/// third larger than its bytes where numbers would be three times larger.
pub fn words_of(lines: [Text]) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    var word = 0
    var have = 0
    var acc = 0
    var bits = 0
    for line in lines {
        let s = line.to_string()
        let b = s.as_bytes()
        for i in 0..b.len() {
            let c = u32(b[i])
            let v = sextet(c)
            if v == 64 {
                continue
            }
            acc = ((acc << 6) | v) & 0xffffff
            bits += 6
            if bits >= 8 {
                bits -= 8
                word = word | (((acc >> bits) & 255) << (8 * have))
                have += 1
                if have == 4 {
                    out.push(word)
                    word = 0
                    have = 0
                }
            }
        }
    }
    if have > 0 {
        out.push(word)
    }
    out
}
