// Plants (#28 §4, §9): trees and shrubs as fields, authored like creatures. A plant is limbs
// (tapered tubes along curves) and a crown (clumps of leaves on the limbs, blended into one
// soft field); its leaf kind, card size and colours are parameters. Its field is a `Surface`, so
// the lens draws it, probes it and drags its literals.
//
// Cooking a plant (once, on the GPU) turns its crown into leaf cards: each a cluster of leaves
// cut from a square by `discard`, placed over the clumps' spheres, with the crown's normal there
// and how deep in the crown it is (from the crown's field). The cards come in three nested
// levels: level L draws the first quarter^L of them, each 2^L times its own size, so every
// level covers the crown as often (spike 15: 472K cards became 120K with no visible loss). Each
// level's own share is spread over all the clumps, so the first cards are a coarse crown.
//
// A plant is cooked once as a kind; the world places instances of it (where, turned, scaled,
// tinted). Near instances draw their kind's cards and limbs; impostors and volumes stand in
// farther away (`vegetation`).

use noise::{direction, hash2, pick, rand}
use std::field::{Surface, PartName, Tube, unnamed}
use std::gpu::{
    ClipPosition, FragCoord, GlobalId, Oct32, Rgba8, Sampler, Slots, Texture, Unorm8x4, VertexIndex,
    begin_pass, draw, texture,
}
use std::math::{PI, TAU}

/// A clump of leaves: a sphere of them on a limb.
pub struct Clump: Copy + GpuData {
    pub centre: vec3,
    pub radius: f32,
}

/// A plant's leaves: a card's width at the nearest level (m), how many times the cards cover
/// each clump's sphere, the colours of young (lit) and old (deep) leaves and of the light
/// they pass, linear, and how many leaves a card holds.
pub struct Leaves: Copy + GpuData {
    pub young: vec3 = vec3(0.17, 0.25, 0.035),
    pub size: f32 = 0.9,
    pub old: vec3 = vec3(0.045, 0.10, 0.03),
    pub cover: f32 = 1.7,
    pub through: vec3 = vec3(0.11, 0.16, 0.02),
    pub per_card: u32 = 6,
}

impl Leaves {
    /// About how wide one of its leaves is (m): a card's width over its leaves along a side.
    pub fn leaf_width(self) -> f32 {
        self.size / sqrt(f32(self.per_card))
    }
}

/// A plant's bark: its dark and light tones, and its moss, linear.
pub struct Bark: Copy + GpuData {
    pub dark: vec3 = vec3(0.16, 0.12, 0.09),
    pub light: vec3 = vec3(0.30, 0.25, 0.19),
    pub moss: vec3 = vec3(0.06, 0.09, 0.02),
}

/// The most limbs and clumps a plant has.
pub const MAX_LIMBS: u32 = 40
pub const MAX_CLUMPS: u32 = 64

/// A plant: limbs (tubes through four points each) and a crown of clumps, in the plant's own
/// frame (its base at the origin, +y up).
pub struct Plant: Copy + GpuData {
    pub limbs: Bounded<Tube<4>, MAX_LIMBS>,
    pub clumps: Bounded<Clump, MAX_CLUMPS>,
    pub leaves: Leaves,
    pub bark: Bark,
    /// How softly the crown's clumps blend (per metre: higher is harder).
    pub blend: f32,
}

/// A plant with no limbs or clumps yet, its leaves and bark as given.
pub fn plant(leaves: Leaves, bark: Bark) -> Plant {
    Plant { limbs: Bounded::new(), clumps: Bounded::new(), leaves, bark, blend: 1.1 }
}

impl Plant {
    /// A limb from `from` to `to`, bending toward `bend` (a quadratic curve), its radius
    /// `r_from` at its start and `r_to` at its end.
    pub fn limb(mut self, from: vec3, bend: vec3, to: vec3, r_from: f32, r_to: f32) {
        var points = [vec3(0.0); 4]
        var radii = [0.0; 4]
        for i in 0..4 {
            let t = f32(i) / 3.0
            let a = mix(from, bend, vec3(t))
            let b = mix(bend, to, vec3(t))
            points[i] = mix(a, b, vec3(t))
            radii[i] = mix(r_from, r_to, t)
        }
        if !self.limbs.is_full() {
            self.limbs.push(Tube { points, radii })
        }
    }

    /// A limb through four points, its radius at each given: a trunk that flares at its root
    /// and tapers in one tube, with no seam where two tubes cross.
    pub fn tube(mut self, points: [vec3; 4], radii: [f32; 4]) {
        if !self.limbs.is_full() {
            self.limbs.push(Tube { points, radii })
        }
    }

    /// A straight limb from `from` to `to`.
    pub fn straight(mut self, from: vec3, to: vec3, r_from: f32, r_to: f32) {
        self.limb(from, mix(from, to, vec3(0.5)), to, r_from, r_to)
    }

    /// A clump of leaves at `at`, `radius` across.
    pub fn clump(mut self, at: vec3, radius: f32) {
        if !self.clumps.is_full() {
            self.clumps.push(Clump { centre: at, radius })
        }
    }

    /// The crown's field at `p`: the soft union of its clumps (an exponential smooth minimum),
    /// and its gradient. Its gradient is a mean of unit vectors, so it never exceeds 1.
    pub fn crown(self, p: vec3) -> (f32, vec3) {
        let k = self.blend
        var s = 0.0
        var g = vec3(0.0)
        for i in 0..self.clumps.len() {
            let c = self.clumps[i]
            let v = p - c.centre
            let l = max(length(v), 1.0e-4)
            let w = exp(-k * (l - c.radius))
            s += w
            g += v / l * w
        }
        if s <= 0.0 {
            return (1.0e9, vec3(0.0, 1.0, 0.0))
        }
        (-log(s) / k, g / s)
    }

    /// The limbs' field at `p`: the nearest limb's distance.
    pub fn wood(self, p: vec3) -> f32 {
        var d = 1.0e9
        for i in 0..self.limbs.len() {
            d = min(d, self.limbs[i].distance(p))
        }
        d
    }

    /// How tall it stands (m): its crown's top, or its limbs'.
    pub fn top(self) -> f32 {
        var top = 0.0
        for i in 0..self.clumps.len() {
            top = max(top, self.clumps[i].centre.y + self.clumps[i].radius)
        }
        for i in 0..self.limbs.len() {
            for k in 0..4 {
                top = max(top, self.limbs[i].points[k].y + self.limbs[i].radii[k])
            }
        }
        top
    }

    /// The radius of a sphere round its base's axis that holds it all (m).
    pub fn reach(self) -> f32 {
        var r = 0.0
        let mid = vec3(0.0, self.top() * 0.5, 0.0)
        for i in 0..self.clumps.len() {
            r = max(r, length(self.clumps[i].centre - mid) + self.clumps[i].radius)
        }
        for i in 0..self.limbs.len() {
            for k in 0..4 {
                r = max(r, length(self.limbs[i].points[k] - mid) + self.limbs[i].radii[k])
            }
        }
        r
    }

    /// How many leaf cards its nearest level has: enough to cover each clump `cover` times
    /// with cards `size` wide, at least 16 a clump, in multiples of 16 (so every level's count
    /// is whole).
    pub fn cards(self) -> u32 {
        var n = 0.0
        let s = self.leaves.size
        for i in 0..self.clumps.len() {
            let r = self.clumps[i].radius
            n += max(4.0 * PI * r * r * self.leaves.cover / (s * s), 16.0)
        }
        (u32(n) + 15) / 16 * 16
    }
}

/// A plant's field: its limbs, and its crown as one soft solid. The lens draws it as clay.
impl Surface for Plant {
    fn distance(self, p: vec3) -> f32 {
        let (crown, _) = self.crown(p)
        min(self.wood(p), crown)
    }

    fn parts(self) -> u32 {
        self.limbs.len() + self.clumps.len()
    }

    fn part_at(self, p: vec3) -> (f32, u32) {
        var best = 1.0e9
        var which = 0
        for i in 0..self.limbs.len() {
            let d = self.limbs[i].distance(p)
            if d < best {
                best = d
                which = i
            }
        }
        let (crown, _) = self.crown(p)
        if crown < best {
            best = crown
            // The clump nearest the point decides it most.
            var nearest = 1.0e9
            for i in 0..self.clumps.len() {
                let c = self.clumps[i]
                let d = length(p - c.centre) - c.radius
                if d < nearest {
                    nearest = d
                    which = self.limbs.len() + i
                }
            }
        }
        (best, which)
    }

    fn part_distance(self, p: vec3, i: u32) -> f32 {
        if i < self.limbs.len() {
            return self.limbs[i].distance(p)
        }
        let c = self.clumps[min(i - self.limbs.len(), self.clumps.len() - 1)]
        length(p - c.centre) - c.radius
    }

    fn part_name(self, i: u32) -> PartName {
        if i < self.limbs.len() {
            PartName { name: "limb", group: "wood", ..unnamed() }
        } else {
            PartName { name: "clump", group: "crown", ..unnamed() }
        }
    }

    fn part_offset(self, p: vec3, i: u32, by: f32) -> f32 {
        if i < self.limbs.len() {
            var d = 1.0e9
            for k in 0..self.limbs.len() {
                let x = self.limbs[k].distance(p) + if k == i { by } else { 0.0 }
                d = min(d, x)
            }
            let (crown, _) = self.crown(p)
            return min(d, crown)
        }
        // A clump raised by `by`: its term in the crown's blend, moved.
        let j = i - self.limbs.len()
        let k = self.blend
        var s = 0.0
        for c in 0..self.clumps.len() {
            let cl = self.clumps[c]
            let d = length(p - cl.centre) - cl.radius + if c == j { by } else { 0.0 }
            s += exp(-k * d)
        }
        min(self.wood(p), -log(max(s, 1.0e-30)) / k)
    }

    fn lipschitz(self, near: f32) -> f32 {
        1.0
    }
}

// ---- cooking: leaf cards ------------------------------------------------------------------------

/// A leaf card, in its plant's frame: its centre and width (at the nearest level), the crown's
/// normal there and how deep in the crown it is (m), its seed, and its tint.
pub struct Card: Copy + GpuData {
    pub centre: vec3,
    pub size: f32,
    pub normal: Oct32,
    pub depth: f32,
    pub seed: u32,
    pub tint: Unorm8x4,
}

/// The levels of a plant's cards.
pub const CARD_LEVELS: u32 = 3

/// How many of a plant's `n` cards (`Plant::cards`) level `level` draws: all of them at level
/// 0, a quarter at 1, a sixteenth at 2.
pub fn level_cards(n: u32, level: u32) -> u32 {
    n >> (2 * level)
}

/// Card `id` of a plant's `n`: which level's own share it's in (the coarsest's first), and its
/// place in that share as a fraction.
fn card_share(id: u32, n: u32) -> (u32, f32) {
    let n2 = level_cards(n, 2)
    let n1 = level_cards(n, 1)
    if id < n2 {
        return (2, (f32(id) + 0.5) / f32(n2))
    }
    if id < n1 {
        return (1, (f32(id - n2) + 0.5) / f32(n1 - n2))
    }
    (0, (f32(id - n1) + 0.5) / f32(n - n1))
}

/// The level share card `id` of a plant's `n` is in (`card_share`): its first card and its end.
fn share_range(id: u32, n: u32) -> vec2u {
    let n2 = level_cards(n, 2)
    let n1 = level_cards(n, 1)
    if id < n2 {
        return vec2u(0, n2)
    }
    if id < n1 {
        return vec2u(n2, n1)
    }
    vec2u(n1, n)
}

/// The corners a plant is seen from, for the orders its cards are drawn in: the eight ways round
/// it, each axis's sign a bit (x, then y, then z).
pub const CORNERS: u32 = 8

fn corner_dir(o: u32) -> vec3 {
    vec3(f32(o & 1) * 2.0 - 1.0, f32((o >> 1) & 1) * 2.0 - 1.0, f32((o >> 2) & 1) * 2.0 - 1.0)
}

/// Which corner a plant at `inst` is seen from by an eye at `eye` (`mid` metres up its middle,
/// in its own frame).
pub fn corner_of(inst: Instance, mid: f32, eye: vec3) -> u32 {
    let v = unturned(inst.yaw, eye - inst.at)
    let y = v.y - mid * inst.scale
    u32(v.x > 0.0) | (u32(y > 0.0) << 1) | (u32(v.z > 0.0) << 2)
}

/// The plant's `n` cards (cooked by `seed`) in each corner's order (`CORNERS`, one after
/// another): each level's own share front to back seen from the corner, the nearest it first,
/// each share's run where it was (a level draws the first of them). A cut fragment behind the
/// depth already written is dropped before it's cut, so the prepass draws a crown's cards so:
/// 0.62 ms, 0.57. Found once, at load, from where each card is (`card_place`).
pub fn card_orders(plant: Plant, n: u32, seed: u32) -> Vec<u32> {
    var centres: Vec<vec3> = Vec::new()
    for c in 0..n {
        let (_, p, _, _) = card_place(plant, n, seed, c)
        centres.push(p)
    }
    var out: Vec<u32> = Vec::new()
    for o in 0..CORNERS {
        let dir = corner_dir(o)
        var c = 0
        while c < n {
            let range = share_range(c, n)
            // Each card's distance back from the corner, and the card.
            var keyed: Vec<vec2> = Vec::new()
            for j in range.x..range.y {
                keyed.push(vec2(-dot(centres[j], dir), f32(j)))
            }
            keyed.sort_by(|a, b| a.x < b.x || a.x == b.x && a.y < b.y)
            for e in keyed {
                out.push(u32(e.y))
            }
            c = range.y
        }
    }
    out
}

/// Card `id` of a plant's `n` (cooked by `seed`): its clump (each level's share spread over the
/// clumps by their areas), where it is (on its clump's sphere, most near its surface), the
/// direction from the clump's centre, and its draws' seed.
fn card_place(plant: Plant, n: u32, seed: u32, id: u32) -> (u32, vec3, vec3, u32) {
    let (_, f) = card_share(id, n)
    // The clump whose share of the total area holds `f`.
    var total = 0.0
    for i in 0..plant.clumps.len() {
        let r = plant.clumps[i].radius
        total += r * r
    }
    var at = f * total
    var which = plant.clumps.len() - 1
    for i in 0..plant.clumps.len() {
        let r = plant.clumps[i].radius
        if at < r * r {
            which = i
            break
        }
        at -= r * r
    }
    let c = plant.clumps[which]
    let k = seed.wrapping_mul(7919) ^ id.wrapping_mul(2654435761)
    let dir = direction(rand(k, 3), rand(k, 4))
    (which, c.centre + dir * (c.radius * (0.72 + 0.28 * sqrt(rand(k, 5)))), dir, k)
}

/// Each of a plant's cards' middle and size as `cook_cards` places them (seed `seed`), on
/// the CPU: for tests of what a camera's near plane meets.
pub fn card_centres(plant: Plant, seed: u32) -> Vec<vec4> {
    let n = plant.cards()
    var out: Vec<vec4> = Vec::with_capacity(n)
    for c in 0..n {
        let (_, p, _, k) = card_place(plant, n, seed, c)
        out.push(vec4(p, plant.leaves.size * pick(k, 6, lo: 0.8, hi: 1.2)))
    }
    out
}

/// The plant's cards: each level's share spread over the clumps by their areas, each card on
/// its clump's sphere (most near its surface), its normal the crown's there mixed with the
/// clump's own (so each clump reads as a lump of light), its depth in the crown.
@compute(64)
pub fn cook_cards(plant: Plant, n: u32, seed: u32, out: mut Slots<Card>, id: GlobalId) {
    let (which, p, dir, k) = card_place(plant, n, seed, id.x)
    let (d, g) = plant.crown(p)
    let normal = normalize(normalize(g) * 0.45 + dir * 0.55)
    let size = plant.leaves.size * pick(k, 6, lo: 0.8, hi: 1.2)
    let tint = vec4(rand(k, 7), rand(k, 8), rand(k, 9), rand(which, 10))
    out[id] = Card {
        centre: p,
        size,
        normal: Oct32::encode(normal),
        depth: max(-d, 0.0),
        seed: k,
        tint: Unorm8x4::encode(tint),
    }
}

/// A card's corner `q` (on its square, each in [-1, 1]) turned by the card's own turn, a draw of
/// its seed: the same for every way a card is drawn (`vegetation::card_corner`, and the cards an
/// impostor is baked from).
pub fn card_turn(card: Card, q: vec2) -> vec2 {
    let a = TAU * rand(card.seed, 11)
    let (s, c) = (sin(a), cos(a))
    vec2(c * q.x - s * q.y, s * q.x + c * q.y)
}

/// A card's own tint, added to its instance's: a little more or less red and green.
pub fn card_tint(card: Card) -> vec3 {
    (card.tint.decode().xyz - vec3(0.5)) * vec3(0.04, 0.05, 0.0)
}

// ---- a leaf's look (its cards', its impostor's and its volume's alike) -------------------------

/// Leaf `which` of a card of seed `seed`: its tilt off the crown's normal (each part in
/// [-0.5, 0.5)), and the draw that changes its age (`leaf_age`, in [-0.5, 0.5)).
pub fn leaf_draws(seed: u32, which: u32) -> (vec3, f32) {
    let tilt = vec3(
        rand(seed, 100 + which) - 0.5,
        rand(seed, 120 + which) - 0.5,
        rand(seed, 140 + which) - 0.5,
    )
    (tilt, rand(seed, 160 + which) - 0.5)
}

/// A leaf's normal: its crown's, `crown_n`, tilted by its draws (`leaf_draws`).
pub fn leaf_normal(crown_n: vec3, tilt: vec3) -> vec3 {
    normalize(crown_n + tilt * 0.9)
}

/// A leaf's colour by its age: young where its crown faces up (`up`, the y of the crown's
/// normal), old deep down, and moved by its own draw (`aged`, in [-0.5, 0.5); 0 for none).
pub fn leaf_age(leaves: Leaves, up: f32, aged: f32) -> vec3 {
    mix(leaves.old, leaves.young, vec3(saturate(0.35 + 0.65 * up + 0.3 * aged)))
}

/// A leaf's albedo: its colour (`leaf_age`) and half its tint (its instance's and its card's,
/// `card_tint`), never black.
pub fn tinted(colour: vec3, tint: vec3) -> vec3 {
    max(colour + tint * 0.5, vec3(0.005))
}

/// The leaves on a card at `uv` (in [-1, 1]²), `n` of them: how much is leaf (0 to 1, a soft
/// edge `w` wide), and which leaf. Pointed leaves, widest a third of the way along, round the
/// card's middle.
pub fn leaves_on(uv: vec2, seed: u32, w: f32, n: u32) -> (f32, u32) {
    var best = -1.0
    var which = 0
    for i in 0..n {
        let a = TAU * (f32(i) + rand(seed, 20 + i) * 0.6) / f32(n)
        let dir = vec2(cos(a), sin(a))
        let len = 0.55 + 0.3 * rand(seed, 40 + i)
        let o = dir * (0.18 + 0.1 * rand(seed, 60 + i))
        let q = uv - o
        let s = dot(q, dir) / len
        let t = dot(q, vec2(-dir.y, dir.x))
        let half = 0.36 * len * sin(PI * clamp(s, 0.0, 1.0)) * (1.15 - 0.5 * s)
        let inside = min(half - abs(t), min(s, 1.0 - s) * len) / max(len, 0.01)
        if inside > best {
            best = inside
            which = i
        }
    }
    (smoothstep(-w, w, best), which)
}

// ---- limbs as geometry -----------------------------------------------------------------------

/// Sides round a limb's tube, and rings along each of its three pieces. A piece is straight, and
/// its radius changes evenly along it, so two rings are enough (the last piece's closing tip
/// takes the second); sides are what a thick trunk shows, as flat faces the look paints by.
pub const SIDES: u32 = 14
pub const RINGS: u32 = 2
/// Vertices a limb draws: each piece's rings of quads round it.
pub const LIMB_VERTICES: u32 = 3 * RINGS * SIDES * 6

/// Points a limb has: each piece's rings' points round it, the first again at the end (where
/// the bark's place round the limb comes back to 1).
pub const LIMB_POINTS: u32 = 3 * (RINGS + 1) * (SIDES + 1)

/// Which point (of `LIMB_POINTS`) a limb's vertex `k` (of `LIMB_VERTICES`) is: each piece's
/// rings of quads, two triangles each.
pub fn limb_corner(k: u32) -> u32 {
    let qx = [0, 1, 1, 0, 1, 0]
    let qz = [0, 0, 1, 0, 1, 1]
    let q = k / 6
    let c = k % 6
    let piece = q / (RINGS * SIDES)
    let r = q % (RINGS * SIDES)
    let side = r % SIDES + qx[c]
    let ring = r / SIDES + qz[c]
    (piece * (RINGS + 1) + ring) * (SIDES + 1) + side
}

/// A limb's vertex `k` (of `LIMB_VERTICES`): where it is, its normal, and where it is round and
/// along the limb (`limb_point`).
pub fn limb_vertex(limb: Tube<4>, k: u32) -> (vec3, vec3, vec2) {
    let (centre, n, radius, along) = limb_point(limb, limb_corner(k))
    (centre + n * radius, n, along)
}

/// A limb's point `p` (of `LIMB_POINTS`), in the plant's frame: the point of its axis it's
/// round, its normal and its distance out from the axis (the point is `centre + n * radius`),
/// and where it is round and along the limb (for bark's ridges).
pub fn limb_point(limb: Tube<4>, p: u32) -> (vec3, vec3, f32, vec2) {
    let piece = p / ((RINGS + 1) * (SIDES + 1))
    let r = p % ((RINGS + 1) * (SIDES + 1))
    let side = f32(r % (SIDES + 1))
    let along = f32(r / (SIDES + 1)) / f32(RINGS)
    let a = limb.points[piece]
    let b = limb.points[piece + 1]
    // A ring at a joint lies across both pieces it joins (their axes' mean), and every ring's
    // frame turns from one reference for the whole limb: no crack or twist where pieces meet.
    var axis = normalize(b - a)
    if along == 0.0 && piece > 0 {
        axis = normalize(axis + normalize(a - limb.points[piece - 1]))
    } else if along == 1.0 && piece < 2 {
        axis = normalize(axis + normalize(limb.points[piece + 2] - b))
    }
    let whole = normalize(limb.points[3] - limb.points[0] + vec3(0.0, 1.0e-4, 0.0))
    let ref_axis = if abs(whole.y) > 0.9 { vec3(1.0, 0.0, 0.0) } else { vec3(0.0, 1.0, 0.0) }
    let t1 = normalize(cross(axis, ref_axis))
    let t2 = cross(axis, t1)
    let ang = TAU * side / f32(SIDES)
    let n = t1 * cos(ang) + t2 * sin(ang)
    // The last piece closes to a point at the limb's end, so its tip is never an open tube.
    let closing = if piece == 2 { 1.0 - smoothstep(0.6, 1.0, along) } else { 1.0 }
    let radius = mix(limb.radii[piece], limb.radii[piece + 1], along) * closing
    let centre = mix(a, b, vec3(along))
    // How far along the limb (m), from its start: the bark's ridges run on across the joints.
    var walked = 0.0
    for k in 0..piece {
        walked += length(limb.points[k + 1] - limb.points[k])
    }
    (centre, n, radius, vec2(side / f32(SIDES), walked + along * length(b - a)))
}

// ---- instances ---------------------------------------------------------------------------------

/// A plant placed in the world: where its base is, its turn about +y, its tint (added to its
/// leaves' red and green, packed: `tint_of`), its size, its fork: how much higher its trunk
/// forks than its kind's (below 0, lower), as a share of the height there (`bend`), so two trees
/// of a kind don't fork at the same height (#54 §9); and how wide its crown is drawn against its
/// kind's (0 to 1: as wide as its history grew it among its neighbours; its trunk and limbs keep
/// their girth).
pub struct Instance: Copy + GpuData {
    pub at: vec3,
    pub yaw: f32,
    pub tint: Unorm8x4,
    pub scale: f32,
    pub fork: f32,
    pub wide: f32,
}

/// No plant: an empty place in an instances' buffer.
pub const NO_INSTANCE = Instance {
    at: vec3(0.0),
    yaw: 0.0,
    tint: tint_of(vec2(0.0)),
    scale: 0.0,
    fork: 0.0,
    wide: 1.0,
}

/// An instance's tint (its leaves' red and green, each within ±0.08), packed.
pub fn tint_of(t: vec2) -> Unorm8x4 {
    let u = clamp((t + vec2(0.08)) / 0.16, vec2(0.0), vec2(1.0))
    Unorm8x4::encode(vec4(u, 0.0, 0.0))
}

impl Instance {
    /// A point of the plant's frame in the world: its crown narrowed (`wide`), bent at its fork,
    /// sized and turned.
    pub fn place(self, p: vec3) -> vec3 {
        self.at +
            turned(
                self.yaw,
                vec3(p.x * self.wide, bend(p.y, self.fork), p.z * self.wide) * self.scale,
            )
    }

    /// A point of a limb's surface in the world: its axis's point `centre` placed, and the
    /// surface's offset `off` from it sized and turned (a limb keeps its girth where its crown
    /// is narrowed).
    pub fn place_round(self, centre: vec3, off: vec3) -> vec3 {
        self.place(centre) + turned(self.yaw, off * self.scale)
    }

    /// A direction of the plant's frame in the world.
    pub fn turn(self, v: vec3) -> vec3 {
        turned(self.yaw, v)
    }

    /// A normal of the plant's frame at height `y` in it, in the world: bent as `place` bends
    /// the plant there.
    pub fn turn_normal(self, n: vec3, y: f32) -> vec3 {
        turned(self.yaw, normalize(vec3(n.x, n.y / bend_slope(y, self.fork), n.z)))
    }

    /// Its tint (`tint_of`), as added to its leaves' colour.
    pub fn tint_rgb(self) -> vec3 {
        vec3(self.tint.decode().xy * 0.16 - vec2(0.08), 0.0)
    }
}

/// How far up a plant's frame (m) the bend of its fork reaches: nothing above it moves.
pub const BEND_TO: f32 = 32.0

/// A height `y` of a plant's frame bent by `fork`: its trunk and what's low on it stretched (or,
/// below 0, squeezed) by up to `fork` of their height, the stretch fading to nothing at
/// `BEND_TO`; its foot stays where it is. The bend keeps its order (its slope over 0) for a
/// `fork` between -1 and 3.
pub fn bend(y: f32, fork: f32) -> f32 {
    let u = clamp(y / BEND_TO, 0.0, 1.0)
    y + fork * y * (1.0 - u) * (1.0 - u)
}

/// `bend`'s slope at `y`.
pub fn bend_slope(y: f32, fork: f32) -> f32 {
    let u = clamp(y / BEND_TO, 0.0, 1.0)
    1.0 + fork * (1.0 - u) * (1.0 - 3.0 * u)
}

/// The height of a plant's frame that `bend` takes to `h` (Newton's method).
pub fn unbend(h: f32, fork: f32) -> f32 {
    var y = h
    for _ in 0..5 {
        y -= (bend(y, fork) - h) / bend_slope(y, fork)
    }
    y
}

/// A direction of a plant's frame in the world, the plant turned `yaw` about +y.
pub fn turned(yaw: f32, v: vec3) -> vec3 {
    let (c, s) = (cos(yaw), sin(yaw))
    vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z)
}

/// A direction of the world in the frame of a plant turned `yaw` about +y: turned back.
pub fn unturned(yaw: f32, v: vec3) -> vec3 {
    let (c, s) = (cos(yaw), sin(yaw))
    vec3(c * v.x - s * v.z, v.y, s * v.x + c * v.z)
}

/// The wind (#28 §4, Q5 of #51): gusts carried over the land (`gust`), a function of time and
/// place only: its mean direction, how far it bends a plant, its time, and how fast its gusts
/// travel downwind (m/s).
pub struct Wind: Copy + GpuData {
    /// The render origin within `view::KEYED_PERIOD` (`Camera::keyed`): its gusts cross the
    /// world, not render space, so they don't jump when the origin moves.
    pub origin: vec3 = vec3(0.0),
    pub time: f32,
    pub dir: vec2,
    pub speed: f32 = 5.0,
    pub strength: f32,
}

/// The wind's gust at `p` (on the plane, in the world) at `time` (0 calm to about 1.4 in a strong
/// gust): a field of gusts about 45 m across carried downwind at the wind's speed, its pattern
/// slowly turning as it goes, so it never repeats; gust fronts sweep over the land, irregular in
/// time and place (the sum of sines this replaced swayed every plant on one schedule). One
/// lookup of noise: it's read for every vertex of every plant.
pub fn gust(wind: Wind, p: vec2, time: f32) -> f32 {
    let q = (p - wind.dir * (wind.speed * time)) / 45.0
    let a = time * 0.013
    let turned = vec2(q.x * cos(a) - q.y * sin(a), q.x * sin(a) + q.y * cos(a))
    0.25 + 1.15 * smoothstep(0.35, 0.8, noise::noise2(turned + vec2(time * 0.021, 0.0)))
}

/// How far a point at `at` (render space), `height` up its plant (or `height` up a blade), sways at the
/// wind's time: along the gust's direction, more with height, as the plant answers the gusts that
/// reach it (`gust`): a little behind them (its bend follows the gust of a moment ago and of a
/// second ago), rocking only while the gust it feels changes (a gust's front, its passing) and
/// most at its own pace (taller sways slower), and its leaves fluttering more in a strong gust.
/// A function of the wind (its time) and the place, nothing else (AC4).
pub fn sway(wind: Wind, at: vec3, height: f32) -> vec3 {
    let world = at + wind.origin
    let t = wind.time
    let lately = gust(wind, world.xz, t - 0.3)
    let before = gust(wind, world.xz, t - 1.1)
    let felt = 0.65 * lately + 0.35 * before
    // The gust's turn of the wind, a little, as it varies.
    let turn = 0.35 * (lately - before)
    let (c, s) = (cos(turn), sin(turn))
    let dir = vec2(wind.dir.x * c - wind.dir.y * s, wind.dir.x * s + wind.dir.y * c)
    let d = vec3(dir.x, 0.0, dir.y)
    let across = vec3(-dir.y, 0.0, dir.x)
    let bend = wind.strength * height * height / (1.0 + height)
    // Rocking at the plant's own pace, its phase its place's, as large as the gust's change; and
    // the leaves' flutter, quicker, as large as the gust.
    let pace = 2.6 / sqrt(1.0 + height)
    let phase = hash2(i32(floor(world.x * 0.7)), i32(floor(world.z * 0.7))) * TAU
    let rock = (lately - before) * sin(t * pace + phase)
    let flutter = sin(t * 7.3 + phase * 3.0 + world.y * 2.1) * 0.25 * lately
    d * (bend * (felt + 0.6 * rock)) + across * (bend * flutter)
}

// ---- the leaf atlas ----------------------------------------------------------------------------

/// The leaf patterns a card can show, and each one's texels a side: cooked once into an atlas
/// (`LEAF_PATTERNS` side by side, in a square), so cutting a card reads one texel, not its
/// leaves' shapes (the prepass draws every layer of a crown).
pub const LEAF_PATTERNS: u32 = 16
pub const LEAF_TEXELS: u32 = 64
pub const LEAF_ATLAS: u32 = 256
/// The patterns along each side of the atlas.
const LEAF_SIDE: u32 = LEAF_ATLAS / LEAF_TEXELS

/// Pattern `k`'s leaves, from a seed of its own, `n` of them.
fn pattern_seed(k: u32) -> u32 {
    k.wrapping_mul(2246822519) ^ 3266489917
}

/// The leaf atlas's texels: each pattern's coverage (a soft edge a texel wide) in red, and which
/// of its leaves covers it (its index over 8) in green.
@fragment
pub fn cook_leaves(pixel: FragCoord, n: u32) -> vec4 {
    let p = vec2u(pixel.position.xy)
    let k = (p.y / LEAF_TEXELS) * LEAF_SIDE + p.x / LEAF_TEXELS
    let local = (vec2(p % vec2u(LEAF_TEXELS)) + vec2(0.5)) / f32(LEAF_TEXELS)
    let uv = local * 2.0 - vec2(1.0)
    let (m, which) = leaves_on(uv, pattern_seed(k), w: 2.0 / f32(LEAF_TEXELS), n: n)
    vec4(m, (f32(which) + 0.5) / 8.0, 0.0, 1.0)
}

/// Where a card of seed `seed` reads its pattern at `uv` (in [-1, 1]²): its pattern's cell in
/// the atlas.
pub fn leaf_uv(seed: u32, uv: vec2) -> vec2 {
    let k = seed % LEAF_PATTERNS
    let cell = vec2(f32(k % LEAF_SIDE), f32(k / LEAF_SIDE))
    let local = clamp(
        uv * 0.5 + vec2(0.5),
        vec2(0.5 / f32(LEAF_TEXELS)),
        vec2(1.0 - 0.5 / f32(LEAF_TEXELS)),
    )
    (cell + local) / f32(LEAF_SIDE)
}

/// The card of seed `seed` at `uv`, from the atlas: its coverage, and which leaf covers it.
pub fn leaf_at(atlas: Texture<Rgba8>, s: Sampler, seed: u32, uv: vec2) -> (f32, u32) {
    let t = atlas.sample_level(s, leaf_uv(seed, uv))
    (t.r, u32(t.g * 8.0))
}

/// Corners an outline has: a card is drawn as the rectangle round what its cut can keep.
pub const OUTLINE: u32 = 4

/// Corner `id % OUTLINE` of pattern `id / OUTLINE`'s outline: the smallest rectangle (of 16
/// turns) round every point of the card where its cut can keep a pixel, about 0.77 of the card.
/// A bilinear sample reads the texels within one texel of its point, so wherever `leaf_at` is
/// above 0 is in a square a texel each way round a covered texel's centre (clamped to the card).
/// A card's corners are shaded once each (an indexed draw) and its cut runs on fewer pixels:
/// the prepass 0.71 ms, 0.63, the cards' shading 0.65, 0.58. More corners hold the leaves
/// closer but cost more than they save (an octagon's six triangles: 0.75, 0.70).
@compute(64)
pub fn cook_outlines(atlas: Texture<Rgba8>, out: mut Slots<vec2>, id: GlobalId) {
    let k = id.x / OUTLINE
    let origin = vec2u((k % LEAF_SIDE) * LEAF_TEXELS, (k / LEAF_SIDE) * LEAF_TEXELS)
    let texel = 2.0 / f32(LEAF_TEXELS)
    // Each turn's bounds: its two axes' least and most.
    var lo: [vec2; 16] = [vec2(9.0); 16]
    var hi: [vec2; 16] = [vec2(-9.0); 16]
    for y in 0..LEAF_TEXELS {
        for x in 0..LEAF_TEXELS {
            if atlas.load(x: origin.x + x, y: origin.y + y).r > 0.0 {
                let centre = (vec2(f32(x), f32(y)) + vec2(0.5)) * texel - vec2(1.0)
                for j in 0..2 {
                    for i in 0..2 {
                        let off = vec2(f32(i) * 2.0 - 1.0, f32(j) * 2.0 - 1.0) * texel
                        let p = clamp(centre + off, vec2(-1.0), vec2(1.0))
                        for t in 0..16 {
                            let a = f32(t) * PI / 32.0
                            let u = vec2(cos(a), sin(a))
                            let q = vec2(dot(p, u), dot(p, vec2(-u.y, u.x)))
                            lo[t] = min(lo[t], q)
                            hi[t] = max(hi[t], q)
                        }
                    }
                }
            }
        }
    }
    var best = 0
    for t in 1..16 {
        let e = hi[t] - lo[t]
        let b = hi[best] - lo[best]
        if e.x * e.y < b.x * b.y {
            best = t
        }
    }
    let a = f32(best) * PI / 32.0
    let u = vec2(cos(a), sin(a))
    let c = id.x % OUTLINE
    let q = vec2(if c == 1 || c == 2 { hi[best].x } else { lo[best].x }, if c >= 2 {
        hi[best].y
    } else { lo[best].y })
    out[id] = u * q.x + vec2(-u.y, u.x) * q.y
}

/// The leaf atlas of `n` leaves a card, cooked.
pub fn leaf_atlas(n: u32) -> Texture<Rgba8> {
    var atlas = texture::<Rgba8>(width: LEAF_ATLAS, height: LEAF_ATLAS)
    let p = begin_pass(mut atlas)
    draw(p, full.bind(z: 0.5), cook_leaves.bind(n), vertices: 3)
    p.end()
    atlas
}

/// Bark's ridges, cooked once (#55 AC12: no field per pixel per frame for bark): a tile of them
/// round a limb (across, once round: 22 ridges) and along it (down, `RIDGES_ALONG` m, 1.6 a
/// metre), read through a repeating sampler.
pub const RIDGES_ALONG: f32 = 40.0
const RIDGES_W: u32 = 256
const RIDGES_H: u32 = 1024

pub fn cook_ridges() -> Texture<Rgba8> {
    var t = texture::<Rgba8>(width: RIDGES_W, height: RIDGES_H)
    let p = begin_pass(mut t)
    draw(p, full.bind(z: 0.5), ridge_texel, vertices: 3)
    p.end()
    t
}

/// A texel of the ridges' tile: value noise, 22 cells round and 64 along, wrapping.
@fragment
fn ridge_texel(pixel: FragCoord) -> vec4 {
    let uv = pixel.position.xy / vec2(f32(RIDGES_W), f32(RIDGES_H))
    let r = noise::noise2_wrapped(
        vec2(uv.x * 22.0, uv.y * RIDGES_ALONG * 1.6),
        period: vec2i(22, 64),
    )
    vec4(r, r, r, 1.0)
}

/// A triangle that covers the target, at depth `z`.
@vertex
pub fn full(v: VertexIndex, z: f32) -> ClipPosition {
    let x = f32((v.index << 1) & 2) * 2.0 - 1.0
    let y = f32(v.index & 2) * 2.0 - 1.0
    ClipPosition { position: vec4(x, y, z, 1.0) }
}
