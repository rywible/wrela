// The rollback driver: a `Timeline` steps a world, keeps its inputs and keyframes, and replays
// from a keyframe when a correction arrives for an earlier tick.
//
// It is generic over any game's world and inputs. Sim state is ordinary values (language.md
// §6.11): a keyframe is a clone, every `KEYFRAME_TICKS` ticks. A correction for an earlier tick
// restores the last keyframe at or before it, fixes the input, and replays to the present. The
// checksum is the derived `StateHash` of the whole world.

use sim::Tick
use std::hash::{StateHash, state_hash}

/// How often a keyframe is kept.
pub const KEYFRAME_TICKS: u32 = 16

/// The last `capacity` values pushed, by the tick they were pushed at.
pub struct Ring<T> {
    items: Vec<T>,
    /// The tick of `items[0]`'s slot's value: values are at `tick % capacity`.
    first: Tick,
    next: Tick,
    capacity: u32,
}

impl<T: Clone> Ring<T> {
    pub fn new(capacity: u32) -> Ring<T> {
        Ring { items: Vec::with_capacity(capacity), first: 0, next: 0, capacity }
    }

    /// The value for the next tick; the oldest falls out when the ring is full.
    pub fn push(mut self, value: take T) {
        if self.capacity == 0 {
            self.first += 1
            self.next += 1
            return
        }
        match self.claim() {
            None => self.items.push(take value),
            Some(at) => self.items[at] = take value,
        }
    }

    /// Where the next tick's value goes, that tick counted: once the ring is full, the oldest's
    /// slot (that value falls out); before, `None`, and the value is pushed.
    fn claim(mut self) -> Option<u32> {
        let at = if self.items.len() < self.capacity { None } else {
            self.first += 1
            Some(self.next % self.capacity)
        }
        self.next += 1
        at
    }

    /// Whether the ring still holds tick `t`'s value.
    pub fn holds(self, t: Tick) -> bool {
        t >= self.first && t < self.next
    }

    /// Tick `t`'s value. A tick the ring no longer holds panics.
    pub fn at(self, t: Tick) -> borrow T {
        assert(self.holds(t), "the ring no longer holds that tick")
        self.items[t % self.capacity]
    }

    /// Replaces tick `t`'s value.
    pub fn replace(mut self, t: Tick, value: take T) {
        assert(self.holds(t), "the ring no longer holds that tick")
        self.items[t % self.capacity] = take value
    }

    /// The ticks it holds, oldest first: `first()..end()`.
    pub fn first(self) -> Tick {
        self.first
    }

    pub fn end(self) -> Tick {
        self.next
    }
}

/// A keyframe: a whole world, and the tick it was taken before.
pub struct Saved<W>: Clone {
    pub tick: Tick,
    pub world: W,
}

impl<W: Clone> Ring<Saved<W>> {
    /// Keeps `world` as tick `tick`'s keyframe: copied into the oldest one's place once the
    /// ring is full (`clone_into`), so a steady timeline allocates nothing for it.
    pub fn keep(mut self, tick: Tick, world: W) {
        if self.capacity == 0 {
            self.first += 1
            self.next += 1
            return
        }
        match self.claim() {
            None => self.items.push(Saved { tick, world: world.clone() }),
            Some(at) => {
                self.items[at].tick = tick
                world.clone_into(mut self.items[at].world)
            },
        }
    }

    /// The newest keyframe taken at or before tick `t`.
    pub fn last_at_or_before(self, t: Tick) -> borrow Saved<W> {
        var i = self.next
        while i > self.first {
            i -= 1
            if self.items[i % self.capacity].tick <= t {
                return self.items[i % self.capacity]
            }
        }
        panic("no keyframe that early: the correction is too late to replay")
    }

    /// Replaces the world in the keyframe taken before `tick`, while a correction replays it.
    fn refresh(mut self, tick: Tick, world: W) {
        var i = self.first
        while i < self.next {
            let at = i % self.capacity
            if self.items[at].tick == tick {
                world.clone_into(mut self.items[at].world)
                return
            }
            i += 1
        }
        panic("a replayed keyframe is no longer held")
    }
}

/// A world, its tick, its last inputs, its keyframes, and each tick's checksum.
pub struct Timeline<W, I> {
    world: W,
    tick: Tick,
    inputs: Ring<I>,
    saved: Ring<Saved<W>>,
    hashes: Ring<u64>,
}

impl<W: Clone + StateHash, I: Clone> Timeline<W, I> {
    /// A timeline from `world`, keeping `history` ticks of inputs (and keyframes enough to
    /// replay them).
    pub fn new(world: take W, history: u32) -> Timeline<W, I> {
        // The oldest correctable tick may start up to 15 ticks after its keyframe. Keep that
        // replay prefix's inputs and hashes as well, even when `history` is not a full cycle.
        let replay = if history == 0 { 0 } else { history + KEYFRAME_TICKS - 1 }
        Timeline {
            world,
            tick: 0,
            inputs: Ring::new(replay),
            saved: Ring::new(history / KEYFRAME_TICKS + 2),
            hashes: Ring::new(replay),
        }
    }

    pub fn tick(self) -> Tick {
        self.tick
    }

    pub fn world(self) -> borrow W {
        self.world
    }

    /// Steps the world with `input`, which it keeps for a correction to replay.
    pub fn advance<F: @deterministic fn(mut W, I)>(mut self, input: take I, step: F) {
        if self.tick % KEYFRAME_TICKS == 0 {
            self.saved.keep(self.tick, self.world) // a copy, into the oldest keyframe's buffers
        }
        step(mut self.world, input)
        self.inputs.push(take input)
        self.hashes.push(state_hash(self.world))
        self.tick += 1
    }

    /// A correction arrived for tick `t`, for example from the server: restore the last
    /// copy at or before `t`, fix the input, and replay to the present. The replayed ticks'
    /// checksums replace the ones recorded; how many of them changed.
    pub fn correct<F: @deterministic fn(mut W, I)>(
        mut self,
        t: Tick,
        input: take I,
        step: F,
    ) -> u32 {
        borrow s = self.saved.last_at_or_before(t)
        self.world = s.world.clone()
        let from = s.tick
        self.inputs.replace(t, take input)
        var changed = 0
        for tick in from..self.tick {
            if tick % KEYFRAME_TICKS == 0 {
                self.saved.refresh(tick, self.world)
            }
            step(mut self.world, self.inputs.at(tick))
            let h = state_hash(self.world)
            if h != self.hashes.at(tick) {
                changed += 1
                self.hashes.replace(tick, h)
            }
        }
        changed
    }

    /// The whole world's checksum.
    pub fn checksum(self) -> u64 {
        state_hash(self.world)
    }

    /// The checksum recorded after tick `t`.
    pub fn checksum_at(self, t: Tick) -> u64 {
        self.hashes.at(t)
    }
}

// ---- tests ------------------------------------------------------------------------------------

/// A zero-capacity ring accepts values while retaining none of them.
@test
fn a_zero_capacity_ring_stays_empty() {
    var pushed: Ring<u32> = Ring::new(0)
    pushed.push(7)
    assert(pushed.first() == pushed.end(), "a zero-capacity ring has a nonempty tick range")
    assert(!pushed.holds(0), "a zero-capacity ring retained a pushed value")

    var saved: Ring<Saved<u32>> = Ring::new(0)
    saved.keep(tick: 4, world: 9)
    assert(saved.first() == saved.end(), "a zero-capacity ring has a saved tick range")
    assert(!saved.holds(0), "a zero-capacity ring retained a saved value")
}

struct TestWorld: Clone + StateHash {
    total: u32,
}

@deterministic
fn add_input(world: mut TestWorld, input: u32) {
    world.total += input
}

/// Replaying a correction refreshes the later keyframes, so a correction based on one of them
/// does not put back the world from before the first correction.
@test
fn a_later_correction_keeps_an_earlier_one() {
    var timeline: Timeline<TestWorld, u32> = Timeline::new(TestWorld { total: 0 }, history: 64)
    for _ in 0..40 {
        timeline.advance(0, add_input)
    }
    let _ = timeline.correct(t: 5, input: 10, step: add_input)
    assert(timeline.world().total == 10, "the first correction was not replayed")
    let _ = timeline.correct(t: 20, input: 1, step: add_input)
    assert(timeline.world().total == 11, "the second correction lost the first")
}

/// The oldest retained input can be after its keyframe when history isn't a multiple of 16.
/// Replaying it still needs the inputs and hashes between that keyframe and the correction.
@test
fn a_correction_at_a_partial_history_boundary_replays_from_its_keyframe() {
    var timeline: Timeline<TestWorld, u32> = Timeline::new(TestWorld { total: 0 }, history: 20)
    for _ in 0..40 {
        timeline.advance(1, add_input)
    }
    let changed = timeline.correct(t: 20, input: 3, step: add_input)
    assert(changed == 20, f"changed {changed} checksums")
    assert(timeline.world().total == 42, "the oldest retained correction was not replayed")
}
