// Trees and shrubs: plants cooked once on the GPU (`kind`: a kind's leaf cards and its limbs,
// its impostor and its volume), and the shaders that draw them as leaf cards, limbs, impostors or
// volumes. A wood (`engine::wood`) holds the kinds and their instances and chooses on the GPU each
// frame how each instance is drawn.
//
// Cut cards cost their shading only once a pixel: a depth prepass draws the cards cut by
// `discard` into the depth target alone; the shading pass draws them again where the depth is
// equal and writes none, so only the nearest leaf at each pixel is shaded, and the shading needs
// no `discard` (which would turn off the GPU's early depth test).

use impostor::{
    Cooked, Impostor, KindDesc, bake, cook, far_cut, far_quad, far_shade, kind_of, leaf_light,
    volume_cut, volume_shade, which_crown,
}
use light::Lit
use lit::{Lighting, shown, sun_and_sky}
use switches::Switches
use style
use style::{Style, flattened, lit_normal, substance_of}
use noise::{cell_size, hashed_threshold_of}
use lod::{
    IMPOSTOR, Lod, VOLUME, anchor, by_card, keeps_packed, packed, place, share, unpacked, ways,
}
use plant::{
    Bark, CARD_LEVELS, Card, Instance, LEAF_PATTERNS, LIMB_POINTS, LIMB_VERTICES, Leaves, OUTLINE,
    Plant, Wind, CORNERS, LEAF_TEXELS, card_orders, card_tint, card_turn, cook_cards, cook_outlines,
    card_scale, corner_of, leaf_age, leaf_at, leaf_uv, level_cards, limb_corner, limb_point,
    NO_INSTANCE, sway, tinted,
}
use shadow::{CASTER, Shadows}
use std::field::Tube
use std::math::TAU
use std::gpu::{
    Atomics, ClipPosition, Compare, Depth, DepthTexture, DrawIndexedArgs, Flat, FragCoord,
    GpuBuffer, GpuSpan, InstanceIndex, R32Uint, RenderPass, Rgba8, Sampler, Texture, VertexIndex,
    buffer, buffer_of, discard, dispatch, draw, write,
}
use view::{Camera, PREPASSED}

/// A kind of plant, cooked: the plant, its cards and limbs on the GPU, and its size.
pub struct Kind {
    pub plant: Plant,
    pub cards: GpuBuffer<Card>,
    pub card_count: u32,
    /// Its cards in each corner's order (`card_orders`), the corners one after the other.
    pub orders: GpuBuffer<u32>,
    pub limbs: GpuBuffer<Tube<4>>,
    pub limb_count: u32,
    /// Its height and the radius of a sphere round its middle that holds it.
    pub top: f32,
    pub reach: f32,
    /// Its impostor, baked from its cards and limbs, and its volume, cooked from its crown.
    pub impostor: Impostor,
    pub volume: Cooked,
}

/// Cooks `plant` as a kind: its cards (by `seed`), and its limbs.
pub fn kind(plant: Plant, seed: u32, atlas: Texture<Rgba8>, s: Sampler) -> Kind {
    kind_ordered(plant, seed, card_orders(plant, plant.cards(), seed), atlas, s)
}

/// `kind`, its cards' orders found already (`card_orders`, `plant::orders_of` on a helper).
pub fn kind_ordered(
    plant: Plant,
    seed: u32,
    found: take Vec<u32>,
    atlas: Texture<Rgba8>,
    s: Sampler,
) -> Kind {
    // A plant with no leaves (a snag, a log) has no cards: its limbs alone are drawn.
    let n = plant.cards()
    var cards: GpuBuffer<Card> = buffer(max(n, 1))
    if n > 0 {
        dispatch(cook_cards.bind(plant, n, seed, out: mut cards), over: n)
    }
    let orders = buffer_of(take found, at_least: 1)
    let limb_count = plant.limbs.len()
    var list: Vec<Tube<4>> = Vec::new()
    for i in 0..limb_count {
        list.push(plant.limbs[i])
    }
    let limbs = buffer_of(list, at_least: 1)
    let impostor = bake(plant, cards, n, limbs, limb_count, atlas, s)
    let volume = cook(impostor.bake, cards, n, atlas, s)
    Kind {
        plant,
        cards,
        card_count: n,
        orders,
        limbs,
        limb_count,
        top: plant.top(),
        reach: plant.reach(),
        impostor,
        volume,
    }
}

/// An instance of a kind in the world.
pub struct Placed: Copy {
    pub kind: u32,
    pub at: Instance,
}

/// The ways an instance is drawn: its cards' levels, an impostor, a volume (`lod`).
pub const WAYS: u32 = VOLUME + 1

/// A list's indexed draws (`wood::Wood`'s): its cards' and its limbs'.
pub struct ListDraws: Copy + GpuData {
    pub cards: DrawIndexedArgs,
    pub limbs: DrawIndexedArgs,
}

impl Kind {
    /// Its cards that level `level` draws (`level_cards`), to bind.
    pub fn cards_at(self, level: u32) -> GpuSpan<Card> {
        self.cards.span(start: 0, count: level_cards(self.card_count, level))
    }
}

// ---- cards -------------------------------------------------------------------------------------

/// Whether instance `at`, its plant `top` tall and `reach` round its middle, is outside `cam`'s
/// view cone (`corner` its corner's angle) by more than its own angular radius: on the CPU
/// (`ways_for`) and on the GPU (`wood::choose`) alike.
pub fn out_of_view(at: Instance, cam: Camera, top: f32, reach: f32, corner: f32) -> bool {
    let centre = at.at + at.turn(vec3(0.0, top * 0.5 * at.scale, 0.0))
    let r = at.bound_radius(reach)
    let v = centre - cam.eye
    let d = length(v)
    if d > r {
        let off = acos(clamp(dot(v / d, cam.forward), -1.0, 1.0))
        return off > corner + asin(min(r / d, 1.0)) + 0.02
    }
    false
}

/// Where instance `at` is between its levels (`lod::place`), its reach widened as its crown is
/// (`Instance::wide`).
pub fn place_of(l: Lod, cam: Camera, at: Instance) -> (f32, f32) {
    var extent = l
    extent.reach *= max(at.wide, 1.0)
    place(extent, cam, at.at, at.scale)
}

/// What drawing cards reads besides the camera: the wind, how much each card grows at the
/// level drawn, the leaves (their count per card), and the basis the cards face (the camera's,
/// or the sun's for shadows).
pub struct CardDraw: Copy + GpuData {
    pub right: vec3,
    pub per_card: u32,
    pub up: vec3,
    /// The way drawn (its level; `ALL` for every instance whole: the shadows').
    pub way: u32,
    pub wind: Wind,
    pub grow: f32,
    /// How wide a cut's hashed cell is, in the scene's pixels (`Lod::cell`).
    pub cell: f32,
    /// What a third person's camera keeps clear of leaves: the point it looks at (the player)
    /// and, in `w`, how far round the line from the eye to it a card fades (0: none). The camera
    /// never shows the inside of foliage.
    pub clear: vec4 = vec4(0.0),
}

/// How much of a card centred at `c`, reaching `half` from it, fades for an eye at `eye` keeping
/// `clear` clear (0 to 1): those whose centres are near the line from the eye to the point it
/// looks at, and those that reach within a metre or two of the eye itself (a wide card's centre
/// can be off the line while its edge meets the near plane; a crown beside the eye filled half
/// the view).
pub fn faded(c: vec3, half: f32, eye: vec3, clear: vec4) -> f32 {
    if clear.w <= 0.0 {
        return 0.0
    }
    let ab = clear.xyz - eye
    let t = clamp(dot(c - eye, ab) / max(dot(ab, ab), 1.0e-6), 0.0, 1.0)
    let d = length(c - (eye + ab * t))
    let reach = length(c - eye) - half
    // Over a short way (a card part faded for long reads as a curtain of dots).
    max(1.0 - smoothstep(clear.w, clear.w * 1.25, d), 1.0 - smoothstep(1.0, 1.4, reach))
}

/// A draw of every instance whole, whatever its level (the static shadows').
pub const ALL: u32 = 99

/// What a card's vertex passes on.
pub struct LeafVertex: Copy {
    pub clip: ClipPosition,
    pub uv: vec2,
    /// The card's seed (its pattern in the low bits: `seed_of`).
    pub seed: Flat<u32>,
    /// The part of a pixel's draws its instance keeps this way, packed (`lod::packed`).
    pub keep: Flat<u32>,
    /// Which card of which instance (its place in its list in the low 24 bits, and which crown it
    /// is in the high 8, `which_crown`): the shading reads the rest from them.
    pub card: Flat<u32>,
    pub instance: Flat<u32>,
    /// The kind it's of (`kind_of`).
    pub kind: Flat<u32>,
}

/// Indices a card draws: its outline's two triangles (each corner shaded once).
pub const CARD_INDICES: u32 = 6
const TRIANGLES: [u32; 6] = [0, 1, 2, 0, 2, 3]

/// `n` cards' triangles: each card's corners.
pub fn card_indices(n: u32) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    for c in 0..n {
        for k in TRIANGLES {
            out.push(c * OUTLINE + k)
        }
    }
    out
}

/// Corner `k` of card `c` of the kind's, of instance `i`, facing `d`'s basis, swayed by the wind;
/// seen by `view` (the camera's jittered view-projection, or the sun's).
fn card_corner(
    c: u32,
    k: u32,
    i: u32,
    d: CardDraw,
    cards: [Card],
    instances: [Instance],
    outlines: [vec2],
) -> (vec3, vec2, Card, Instance) {
    let card = cards[c]
    let inst = instances[i]
    let q = outlines[(card.seed % LEAF_PATTERNS) * OUTLINE + k]
    let t = card_turn(card, q)
    let centre = inst.place(card.centre)
    let swayed = centre + sway(d.wind, centre, card.centre.y * inst.scale)
    let half = card.size * d.grow * inst.scale * 0.5
    (swayed + (d.right * t.x + d.up * t.y) * half, q, card, inst)
}

/// A card's corner, seen by the camera. Its vertices carry little (a tile-based GPU writes every
/// vertex's outputs to memory before it draws, and the cards are many): the shading reads the
/// card's normal, depth and tint from the card and its instance, and its point from the depth.
/// Every kind's cards are in `cards`, and their orders in `orders` (`KindDesc`), so one draw
/// draws every kind's instances of a way.
@vertex
pub fn card(
    v: VertexIndex,
    i: InstanceIndex,
    cam: Camera,
    d: CardDraw,
    kinds: [KindDesc],
    cards: [Card],
    instances: [Instance],
    marks: [vec2u],
    outlines: [vec2],
    orders: [u32],
) -> LeafVertex {
    // The instance's cards in the order for the corner it's seen from (front to back).
    let inst = instances[i.index]
    let k = kind_of(inst)
    let kd = kinds[k]
    let mark = marks[i.index]
    let c = kd.card_first +
        orders[kd.order_first + (mark.y >> 8) * kd.card_count + v.index / OUTLINE]
    let card = cards[c]
    // A card in the camera's way fades: its share of the instance's cards shrinks.
    let fade = faded(
        inst.place(card.centre),
        card.size * d.grow * inst.scale * 0.75,
        cam.eye,
        d.clear,
    )
    let faded_keep = if fade > 0.0 { fade_packed(mark.x, fade) } else { mark.x }
    // Each card whole or gone by its own draw, and smaller near its share's ends
    // (`lod::by_card`).
    let seed = seed_of(card, mark.y & 255)
    let mixed = (seed ^ (card.seed >> 15)) * 2246822519
    let (keep, size) = by_card(faded_keep, f32(mixed >> 22) / 1024.0)
    let (world, uv, _, _) = card_corner(
        c,
        v.index % OUTLINE,
        i.index,
        CardDraw { grow: d.grow * size, ..d },
        cards,
        instances,
        outlines,
    )
    // A coarser level draws the same card sqrt(2) times the size in the same plane (a card faces the
    // camera's basis, so it's at one depth), so where two levels cross-fade the prepass's depth
    // would pass both levels' equal test. Each level's cards lie a hundred-thousandth farther
    // along the eye's ray than the level before's: each corner stays on its pixel, and the
    // depth is one level's (some hundred steps of a float apart, in reversed depth).
    let apart = cam.eye + (world - cam.eye) * (1.0 + 1.0e-5 * f32(min(d.way, CARD_LEVELS)))
    LeafVertex {
        clip: ClipPosition { position: cam.clip(apart) },
        uv,
        seed: Flat { value: seed },
        keep: Flat { value: keep },
        card: Flat { value: c },
        instance: Flat { value: i.index | ((mark.y & 255) << 24) },
        kind: Flat { value: k },
    }
}

/// A share packed by `lod::packed` with `fade` of it taken away (its end moved toward its
/// start): all of it at 1.
fn fade_packed(k: u32, fade: f32) -> u32 {
    let (start, end) = unpacked(k)
    let e = mix(end, start, fade)
    let s = u32(round(saturate(start) * 16383.0))
    let q = u32(round(saturate(e) * 16383.0))
    (k & 4026531840) | s | (q << 14)
}

/// A card's seed for its cut: its pattern (the card's seed's low bits, `plant::leaf_uv`), the
/// rest mixed with its crown's (`which_crown`), so the same card of two crowns doesn't cut alike.
fn seed_of(card: Card, crown: u32) -> u32 {
    (card.seed & 15) | ((card.seed ^ crown * 2246822519) & 4294967280)
}

/// A card in a shadow map: facing the sun.
@vertex
pub fn card_shadow(
    v: VertexIndex,
    i: InstanceIndex,
    view: mat4,
    d: CardDraw,
    kinds: [KindDesc],
    cards: [Card],
    instances: [Instance],
    outlines: [vec2],
) -> LeafVertex {
    let k = kind_of(instances[i.index])
    let c = kinds[k].card_first + v.index / OUTLINE
    let (world, uv, card, _) = card_corner(
        c,
        v.index % OUTLINE,
        i.index,
        d,
        cards,
        instances,
        outlines,
    )
    LeafVertex {
        clip: ClipPosition { position: view * vec4(world, 1.0) },
        uv,
        seed: Flat { value: card.seed },
        keep: Flat { value: packed(vec4(0.0, 1.0, 0.0, 0.0)) },
        card: Flat { value: c },
        instance: Flat { value: i.index },
        kind: Flat { value: k },
    }
}

/// A card cut to its leaves, from the leaf atlas: the depth prepass's (its id 0: no far
/// instance's, `impostor::far_cut`), and the shadow maps' (which keep only the first `per_card`
/// of a pattern's leaves, so a crown's shadow is dappled; a draw whose `per_card` is 0 keeps
/// its kind's leaves).
@fragment
pub fn leaf_cut(
    l: LeafVertex,
    pixel: FragCoord,
    d: CardDraw,
    kinds: [KindDesc],
    atlas: Texture<Rgba8>,
    s: Sampler,
) -> u32 {
    let per_card = if d.per_card > 0 { d.per_card } else {
        kinds[l.kind.value].bake.leaves.per_card
    }
    let cover = leaf_pixel(atlas, s, l.seed.value, l.uv, per_card)
    let size = cell_size(l.uv, d.cell)
    if cover <= 0.0 || !keeps_packed(l.keep.value, pixel.position.xy) {
        discard()
    }
    // A pixel covered in part is kept that much of the time, by a draw that holds still on the
    // card (hashed alpha): a fixed cut left hard, crawling edges for temporal AA, and a draw
    // changing each frame, noise. Most of a card is empty or covered: they draw nothing.
    if cover < 1.0 && cover < hashed_threshold_of(l.uv, l.seed.value, size) {
        discard()
    }
    0
}

/// Filter cutout coverage over the pixel before the alpha test. A centre-only sample
/// skipped thin leaves as the camera moved, especially obvious against a bright backlight.
/// Magnified leaves keep the sharp derivative edge; minified leaves use four area samples.
fn leaf_pixel(atlas: Texture<Rgba8>, s: Sampler, seed: u32, uv: vec2, per_card: u32) -> f32 {
    let dx = dpdx(uv)
    let dy = dpdy(uv)
    let (m, which) = leaf_at(atlas, s, seed, uv)
    let sharp = leaf_cover(m) * if which < per_card { 1.0 } else { 0.0 }
    let footprint = max(length(dx), length(dy)) * f32(LEAF_TEXELS) * 0.5
    let filtered = smoothstep(0.75, 1.5, footprint)
    if filtered <= 0.0 {
        return sharp
    }
    var area = 0.0
    for i in 0..4 {
        let offset = dx * (f32(i & 1) - 0.5) * 0.5 + dy * (f32(i >> 1) - 0.5) * 0.5
        let (coverage, leaf) = leaf_at(atlas, s, seed, uv + offset)
        if leaf < per_card {
            area += coverage * 0.25
        }
    }
    mix(sharp, area, filtered)
}

/// How much of the pixel a card's leaves cover where the atlas reads `m`: the atlas's soft edge
/// made a pixel wide. A fragment shader's, in uniform control flow (its derivatives).
fn leaf_cover(m: f32) -> f32 {
    saturate((m - 0.5) / max(fwidth(m), 1.0e-4) + 0.5)
}

/// A leaf's pixel, where the prepass left its depth: its crown's normal (its mass's), lit by
/// the sun through its shadows and the crown's depth, the sky light (the probes, darkened
/// inside the crown) and the light through it, and its gloss (`impostor::leaf_light`, as its
/// impostor and volume have them); through the haze.
@fragment
pub fn leaf_shade<Q: Switches, Y: Style>(
    l: LeafVertex,
    pixel: FragCoord,
    kinds: [KindDesc],
    cards: [Card],
    instances: [Instance],
    lt: Lighting<Q, Y>,
    atlas: Texture<Rgba8>,
) -> Y::Out {
    let leaves = kinds[l.kind.value].bake.leaves
    let card = cards[l.card.value]
    let inst = instances[l.instance.value & 16777215]
    let world = lt.cam.world_at(pixel.position.xy, pixel.position.z)
    let base_n = card.normal.decode()
    let wide = max(inst.wide, 1.0e-4)
    let crown_n = inst.turn_normal(vec3(base_n.x / wide, base_n.y, base_n.z / wide), card.centre.y)
    let leaf_px = leaves.leaf_width() *
        inst.scale /
        lt.cam.footprint(max(dot(world - lt.cam.eye, lt.cam.forward), 0.1))
    let resolved = smoothstep(4.0, 12.0, leaf_px)
    let tissue = atlas.sample_level(lt.s, leaf_uv(card.seed, l.uv)).ba
    let transmission = mix(1.0, mix(0.4, 1.06, tissue.x), resolved)
    let fold = mix(1.0, mix(0.92, 1.04, tissue.y), resolved)
    let history = inst.history.decode()
    let tint = tinted(leaf_age(leaves, crown_n.y), inst.tint_rgb() + card_tint(card))
    // (Not flattened, `style::flattened`: a leaf's fold and tissue changed its range across the
    // pixel from frame to frame as its cards alias, and the flattening flickered with it: the wood
    // under cloud's flicker 51.9 → 56.6 ×10⁻⁶ in the cel look, past its bar of 54.7.)
    let flat = 0.0
    let albedo = Y::palette(lt.light, style::LEAVES, history, tint * fold)
    // A leaf's form is its crown's (`crown_n`, as it's lit), and its coarse form the crown's
    // mass round its middle.
    let s = substance_of::<Y>(
        crown_n,
        normalize(world - inst.place(kinds[l.kind.value].bake.mid)),
        history,
        albedo,
        flat,
    )
    let c = leaf_light(
        lt,
        world,
        crown_n,
        sky_n: crown_n,
        depth: card.depth * inst.scale,
        albedo: albedo,
        through: leaves.through * transmission,
        leaf: leaves.leaf_width() * inst.scale,
        s: s,
    )
    Y::written(vec4(c, view::LEAVES + f32(l.instance.value >> 24)), s)
}

// ---- limbs -------------------------------------------------------------------------------------

pub struct BarkVertex: Copy {
    pub clip: ClipPosition,
    pub world: vec3,
    pub normal: vec3,
    /// Where it is on its bark's tiles (round in tiles, `plant::bark_round`; along in m), and how
    /// high it is over its plant's foot (m of the plant as it's built: `Bark::foot`).
    pub along: vec2,
    pub up: f32,
    /// How mossy it is: on its upper side, in patches (worked out at its corners).
    pub moss: f32,
    /// The part of a pixel's draws its instance keeps this way, packed (`wood::Wood`'s marks).
    pub keep: Flat<u32>,
    /// The kind it's of (`kind_of`).
    pub kind: Flat<u32>,
    /// Its instance's history (`plant::Instance::history`).
    pub history: Flat<u32>,
}

/// `n` limbs' triangles: each limb's points (`limb_corner`).
pub fn limb_indices(n: u32) -> Vec<u32> {
    var out: Vec<u32> = Vec::new()
    for l in 0..n {
        for k in 0..LIMB_VERTICES {
            out.push(l * LIMB_POINTS + limb_corner(k))
        }
    }
    out
}

/// Point `v % LIMB_POINTS` of limb `v / LIMB_POINTS` of instance `i`'s kind (every kind's limbs
/// in `limbs`, `KindDesc`), in the world, and where it is on its bark (`BarkVertex::along`:
/// round a whole number of bark's tiles, as round as its limb is at its foot in the world;
/// along, in the world's metres).
fn limb_world(
    v: u32,
    i: u32,
    kinds: [KindDesc],
    limbs: [Tube<4>],
    instances: [Instance],
) -> (vec3, vec3, vec2) {
    let inst = instances[i]
    let limb = limbs[kinds[kind_of(inst)].limb_first + v / LIMB_POINTS]
    let (centre, n, radius, along) = limb_point(limb, v % LIMB_POINTS)
    let girth = TAU * limb.radii[0] * inst.scale * inst.thick
    let on_bark = vec2(along.x * plant::bark_round(girth), along.y * inst.scale)
    (inst.place_round(centre, n * radius), inst.turn_normal(n, centre.y), on_bark)
}

@vertex
pub fn limb(
    v: VertexIndex,
    i: InstanceIndex,
    cam: Camera,
    kinds: [KindDesc],
    limbs: [Tube<4>],
    instances: [Instance],
    marks: [vec2u],
) -> BarkVertex {
    let (world, n, along) = limb_world(v.index, i.index, kinds, limbs, instances)
    let inst = instances[i.index]
    BarkVertex {
        clip: ClipPosition { position: cam.clip(world) },
        world,
        normal: n,
        along,
        up: (world.y - inst.at.y) / max(inst.scale, 1.0e-3),
        moss: mossy(n, along.y, noise::noise2((world.xz + cam.keyed().xz) * 3.0 + world.y * 0.7)),
        keep: Flat { value: marks[i.index].x },
        kind: Flat { value: kind_of(inst) },
        history: Flat { value: inst.history.bits },
    }
}

@vertex
pub fn limb_shadow(
    v: VertexIndex,
    i: InstanceIndex,
    view: mat4,
    kinds: [KindDesc],
    limbs: [Tube<4>],
    instances: [Instance],
) -> ClipPosition {
    let (world, _, _) = limb_world(v.index, i.index, kinds, limbs, instances)
    ClipPosition { position: view * vec4(world, 1.0) }
}

/// How mossy bark is (0 to 1), its normal `n`, `along` metres up its limb, `patch` its noise
/// there: near its foot (a trunk's base, a limb's fork), on faces turned up or to the north (-z,
/// where the sun doesn't reach), in patches with edges: moss is a material on the bark, not a
/// tint over it. (All over a trunk's sides, it turned the wood's trunks green; soft and wide at
/// a big trunk's foot, it still tinted its lower half.)
fn mossy(n: vec3, along: f32, patch: f32) -> f32 {
    let foot = 1.0 - smoothstep(0.2, 1.4, along)
    let place = max(
        foot * 0.75,
        max(smoothstep(0.45, 0.85, n.y) * 0.6, smoothstep(0.3, 0.9, -n.z) * 0.25),
    )
    place * smoothstep(0.42, 0.58, patch)
}

/// Turns a surface by the gradient of its height, measured along two screen directions.
/// Unlike height alone, opposite sides of a furrow face opposite ways. The surface basis
/// follows horizontal limbs as well as trunks; unresolved or edge-on relief stays bounded.
fn bark_normal(n: vec3, dx: vec3, dy: vec3, height: vec2) -> vec3 {
    let across = cross(dy, n)
    let along = cross(n, dx)
    let det = dot(dx, across)
    if abs(det) < max(length(dx) * length(dy) * 1.0e-4, 1.0e-12) {
        return n
    }
    let gradient = (across * height.x + along * height.y) / det
    normalize(n - gradient / max(1.0, length(gradient) / 1.2))
}

/// A limb's pixel: its bark, its ridges read from their cooked tiles (`plant::cook_ridges`, and
/// `plant::cook_coarse` as a pixel grows past their texels, through a repeating sampler `rs`),
/// darker in its furrows; its foot's bark low on its trunk (`Bark::foot`), lichen in its pale
/// patches and its moss from its corners: no field is evaluated here. Its pattern fades to its
/// mean as a pixel grows past the coarse tile's texels (`plant::bark_at`), so a far trunk doesn't
/// sparkle.
@fragment
pub fn bark_shade<Q: Switches, Y: Style>(
    b: BarkVertex,
    pixel: FragCoord,
    lt: Lighting<Q, Y>,
    kinds: [KindDesc],
    ridges: Texture<Rgba8>,
    coarse: Texture<Rgba8>,
    rs: Sampler,
) -> Y::Out {
    let bark = kinds[b.kind.value].bake.bark
    // Derivatives run before the coverage discard, so every lane has a surface and height.
    let uv = vec2(b.along.x, b.along.y / plant::RIDGES_ALONG)
    let size = vec2(f32(plant::RIDGES_W), f32(plant::RIDGES_H))
    let texels = max(length(dpdx(uv) * size), length(dpdy(uv) * size))
    let (t, fine) = plant::bark_at(ridges, coarse, rs, uv, texels)
    let smooth_n = normalize(b.normal)
    // The foot's bark, fading up into the trunk's over its last metre or so, unevenly.
    let foot = if bark.foot.w > 0.0 {
        1.0 - smoothstep(bark.foot.w - 0.6, bark.foot.w + 0.9, b.up + 1.4 * (t.a - 0.6))
    } else { 0.0 }
    // The foot's bark: cracked plates, the ridges' fissures through them.
    let foot_tone = t.g * (0.6 + 0.4 * t.r)
    let raised = mix(bark.raised(t), (foot_tone - 0.5) * 1.6, foot)
    // Its relief's slope, read from the tiles a texel (of those read) each way along them, turned
    // into the screen's by the tiles' own derivatives: the height's own screen derivatives are one
    // a 2x2 block of pixels, and on fine bark the blocks' normals read as stitches.
    let height = |p: vec4| mix(bark.raised(p), (p.g * (0.6 + 0.4 * p.r) - 0.5) * 1.6, foot) * 0.035
    let step = vec2(max(texels, 1.0)) / size
    let (tu, _) = plant::bark_at(ridges, coarse, rs, uv + vec2(step.x, 0.0), texels)
    let (tv, _) = plant::bark_at(ridges, coarse, rs, uv + vec2(0.0, step.y), texels)
    let h = height(t)
    let slope = vec2(height(tu) - h, height(tv) - h) / step * fine
    let n = bark_normal(
        smooth_n,
        dpdx(b.world),
        dpdy(b.world),
        vec2(dot(slope, dpdx(uv)), dot(slope, dpdy(uv))),
    )
    let history = std::gpu::Unorm8x4 { bits: b.history.value }.decode()
    // Its ridges' tone, flattened where the look says it can't be told (`style::flattened`): their
    // mean the bark's middle tone (found before the discard, which `fwidth` can't follow).
    let (smooth_tone, flat) = flattened::<Y>(
        vec3(mix(0.55, bark.tone(t), fine)),
        vec3(0.55),
    )
    if !keeps_packed(b.keep.value, pixel.position.xy) {
        discard()
    }
    let tone = smooth_tone.x
    var albedo = mix(bark.dark, bark.light, vec3(tone))
    albedo = mix(albedo, bark.foot.xyz * (0.45 + 1.1 * mix(0.5, foot_tone, fine)), vec3(foot))
    // Darker down its furrows and cracks, as their depth hides them from the light: as much as
    // the bark is rough (a smooth bark's mottle isn't a furrow).
    let rough = max(bark.relief, 1.6 * foot)
    let depth = clamp(raised / max(rough, 1.0e-3) + 0.5, 0.0, 1.0)
    albedo *= 1.0 - fine * 0.5 * min(rough / 1.6, 1.0) * (1.0 - depth)
    albedo = mix(
        albedo,
        bark.lichen.xyz,
        vec3(bark.lichen.w * smoothstep(0.72, 0.88, t.a) * (1.0 - foot)),
    )
    let a = Y::palette(lt.light, style::BARK, history, mix(albedo, bark.moss, vec3(b.moss)))
    let ln = lit_normal::<Y>(n, smooth_n, smooth_n)
    // No gloss: bark is rough, and its impostor lights it as its leaves (`leaf_light`).
    let (sun, sky) = sun_and_sky(lt, b.world, ln, sky_n: ln, soft: 1.5)
    let lit = Lit { albedo: a, n: ln, sun, sky, through: vec3(0.0) }
    // A limb's form is its round without its bark's relief (`smooth_n`), its own coarse form.
    let s = substance_of::<Y>(smooth_n, smooth_n, history, a, flat)
    let c = shown(lt, lit, b.world, s, style::BARK)
    Y::written(vec4(c, view::BARK), s)
}

@test
fn bark_relief_follows_surface_slopes_and_stays_bounded() {
    let n = vec3(0.0, 0.0, 1.0)
    let dx = vec3(0.1, 0.0, 0.0)
    let dy = vec3(0.0, 0.1, 0.0)
    let a = bark_normal(n, dx, dy, vec2(0.03, 0.0))
    let b = bark_normal(n, dx, dy, vec2(-0.03, 0.0))
    assert(a.x < -0.2 && b.x > 0.2, "furrow sides face the same way")
    assert(length(bark_normal(n, dx, dy, vec2(0.0)) - n) < 1.0e-6, "flat bark is tilted")
    let turned = bark_normal(vec3(0.0, 1.0, 0.0), dx, vec3(0.0, 0.0, -0.1), vec2(0.03, 0.0))
    assert(
        abs(turned.x - a.x) < 1.0e-6 && abs(turned.y - a.z) < 1.0e-6,
        "relief does not turn with a fallen limb",
    )
    assert(
        length(bark_normal(n, -dx, dy, vec2(-0.03, 0.0)) - a) < 1.0e-6,
        "screen winding reverses relief",
    )
    assert(
        dot(bark_normal(n, dx, dy, vec2(100.0)), n) > 0.6,
        "unresolved relief turns inside the surface",
    )
    assert(
        length(bark_normal(n, dx, dx, vec2(1.0)) - n) < 1.0e-6,
        "collapsed surface basis is not finite",
    )
}

/// The leaves a card holds in the sun's shadow maps.
pub const SHADOW_LEAVES: u32 = 3

/// A depth-only draw's fragment: its colour goes nowhere.
@fragment
pub fn nothing() -> vec4 {
    vec4(0.0)
}

// ---- drawing a forest ----------------------------------------------------------------------

/// The cards' draw state for a level: they grow sqrt(2)^level, and face `right` and `up`; their
/// cut's cells are `cell` pixels wide.
pub fn card_draw(
    wind: Wind,
    level: u32,
    leaves: Leaves,
    right: vec3,
    up: vec3,
    cell: f32,
    way: u32,
) -> CardDraw {
    CardDraw { wind, grow: card_scale(level), right, per_card: leaves.per_card, up, way, cell }
}

/// What the draws of an instance drawn way `way` read of it this frame (`wood::Wood`'s marks): the
/// part of a pixel's draws it keeps (`lod::share`, from `at`: its level and how far it has faded,
/// `lod::place`), anchored where its pattern is (`lod::anchor`), packed (`lod::packed`); and
/// which crown it is (the low 8 bits) and which corner it's seen from (the next 8,
/// `plant::corner_of`).
pub fn mark_of(l: Lod, cam: Camera, inst: Instance, way: u32, at: vec2) -> vec2u {
    let keep = vec4(share(at.x, at.y, way), anchor(cam, inst.at, l.top, inst.scale))
    vec2u(
        packed(keep),
        which_crown(inst.at + cam.keyed()) | (corner_of(inst, l.top * 0.5, cam.eye) << 8),
    )
}
