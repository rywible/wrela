// A blow's sound from what strikes, what's struck and how fast: an `engine::sound` `Surface` for
// an impact, worked out from the two bodies rather than tuned by ear or fitted to a recording.
//
// Two bodies meet as two springs in series pressing two masses together: the contact lasts half
// a period of that spring on their reduced mass, so a hard blow on a light, hard body (a fist
// on a cheekbone) is short and bright, and a soft one on a heavy, soft body (a shin into a
// belly) is long and dark. The blow's impulse (the momentum it hands over) rings the struck
// body's modes, each falling away by its material's loss: flesh in tens of milliseconds, bone
// longer, stone for a good part of a second. Skin meeting skin pushes the air from between
// them (the slap), and cloth caught between them thwaps.
//
//     struck(FIST, FACE, speed: 9.0)   -> a Surface for the palette's impacts
//
// Every number in the presets is a body's: its mass, its stiffness, its shape's modes, its
// material's loss. Only the levels' scale is chosen, so the mix's blows sit where the mixer's
// other impacts do.

use sound::{Mode, Surface}
use std::math::PI

/// What strikes: its effective mass (kg, the limb behind it), its striking surface's stiffness
/// (N/m: knuckles are hard, a palm soft), how much skin it bares (0 to 1: the slap), how much
/// cloth covers it (0 to 1: the thwap), its contact patch (a share of a fist's), and its own
/// ringing.
pub struct Striker: Copy {
    pub mass: f32 = 2.0,
    pub stiffness: f32 = 4.0e6,
    pub skin: f32 = 1.0,
    pub cloth: f32 = 0.0,
    pub patch: f32 = 1.0,
    /// Its own modes and its flesh's loss: a fist's knuckles and the flesh over them ring too,
    /// and on something harder than itself, they're most of what's heard.
    pub hz: [f32; 2] = [180.0, 420.0],
    pub share: [f32; 2] = [1.0, 0.6],
    pub loss: f32 = 0.35,
}

/// What's struck: its effective mass (kg) and stiffness (N/m) where it's hit, its modes'
/// frequencies (Hz) and how much each takes up of a blow (0 to 1; 0 none), its material's loss
/// factor (the share of a cycle's energy it loses: flesh about 0.3, bone 0.05, stone 0.005),
/// its bare skin, its cloth and its surface's crack (0 to 1).
pub struct Target: Copy {
    pub mass: f32 = 5.0,
    pub stiffness: f32 = 1.5e6,
    pub hz: [f32; 4] = [0.0; 4],
    pub share: [f32; 4] = [0.0; 4],
    pub loss: f32 = 0.3,
    pub skin: f32 = 1.0,
    pub cloth: f32 = 0.0,
    /// How much its surface cracks when struck (0 to 1): grains of stone, a bone's edge.
    pub crack: f32 = 0.0,
}

/// A bare fist, the arm behind it.
pub const FIST = Striker {}
/// The point of an elbow: the shoulder's mass behind it, bone under thin skin, a sleeve.
pub const ELBOW = Striker {
    mass: 4.0,
    stiffness: 8.0e6,
    skin: 0.5,
    cloth: 0.5,
    patch: 0.5,
    hz: [250.0, 600.0],
    share: [1.0, 0.5],
    loss: 0.2,
}
/// A shin swung from the hip, in trousers.
pub const SHIN = Striker {
    mass: 8.0,
    stiffness: 3.0e6,
    skin: 0.0,
    cloth: 1.0,
    patch: 1.5,
    hz: [140.0, 350.0],
    share: [1.0, 0.6],
    loss: 0.3,
}
/// An open palm: soft, wide, all skin.
pub const PALM = Striker {
    mass: 2.0,
    stiffness: 1.0e6,
    skin: 1.0,
    cloth: 0.0,
    patch: 2.5,
    hz: [160.0, 380.0],
    share: [1.0, 0.5],
    loss: 0.4,
}

/// A face: the head's mass on the neck, thin flesh over the cheekbone and jaw, which ring.
pub const FACE = Target {
    mass: 5.0,
    stiffness: 1.5e6,
    hz: [120.0, 320.0, 650.0, 1100.0],
    share: [0.5, 1.0, 0.75, 0.35],
    loss: 0.1,
    skin: 1.0,
    cloth: 0.0,
    crack: 0.05,
}
/// The ribs through a shirt: the chest's mass, a springy cage, the lungs' air behind it.
pub const RIBS = Target {
    mass: 12.0,
    stiffness: 3.0e5,
    hz: [85.0, 140.0, 230.0, 400.0],
    share: [0.75, 0.6, 1.0, 0.6],
    loss: 0.22,
    skin: 0.3,
    cloth: 1.0,
}
/// The belly through a shirt: soft and heavy, no bone.
pub const BELLY = Target {
    mass: 10.0,
    stiffness: 1.0e5,
    hz: [60.0, 110.0, 180.0, 0.0],
    share: [1.0, 0.7, 0.4, 0.0],
    loss: 0.4,
    skin: 0.2,
    cloth: 1.0,
}
/// A raised guard: a forearm's bone under skin, light, braced by the shoulder.
pub const GUARD = Target {
    mass: 3.0,
    stiffness: 8.0e5,
    hz: [150.0, 400.0, 900.0, 0.0],
    share: [0.6, 1.0, 0.5, 0.0],
    loss: 0.15,
    skin: 0.8,
    cloth: 0.3,
    crack: 0.3,
}
/// Carved stone the size of a man (the idol's hand): far heavier and stiffer than any limb, so
/// the limb sets the contact, and it barely moves, so its modes take up little: what's heard
/// is mostly the fist's own flesh and bone, and the stone's grains cracking. A solid block
/// bolted into the rest of the idol doesn't ring like a jar: the joints drink it in a few
/// tens of milliseconds.
pub const STONE = Target {
    mass: 400.0,
    stiffness: 1.0e9,
    hz: [210.0, 590.0, 1130.0, 1870.0],
    share: [0.08, 0.06, 0.04, 0.03],
    loss: 0.15,
    skin: 0.0,
    cloth: 0.0,
    crack: 0.5,
}

/// The speed a blow's levels are set at (m/s: a fast fist).
const SPEED: f32 = 9.0
/// The mode levels, slap and thwap at that speed for a fist into a face (the mix's scale: a
/// blow's modes ring to about the levels the mixer's other impacts do).
const RING: f32 = 8.0
const SLAP: f32 = 3.0
const THWAP: f32 = 3.0
/// The striker's own ringing against the struck body's.
const SELF: f32 = 0.6

/// Two springs in series, or masses pressed together: their reduced value.
fn reduced(a: f32, b: f32) -> f32 {
    a * b / (a + b)
}

/// How long `by` and `on` stay in contact at `speed` (s): half a period of their springs on
/// their reduced mass, a little shorter the faster they meet (a body's stiffness grows as it's
/// pressed: Hertz's contact, the time going as speed to the -1/5).
pub fn contact(by: Striker, on: Target, speed: f32) -> f32 {
    let m = reduced(by.mass, on.mass)
    let k = reduced(by.stiffness, on.stiffness)
    PI * sqrt(m / k) * pow(max(speed, 0.5) / SPEED, -0.2)
}

/// The impact `by` makes striking `on` at `speed` (m/s).
pub fn struck(by: Striker, on: Target, speed: f32) -> Surface {
    let t = contact(by, on, speed)
    // The impulse the blow hands over, against a fist's into a face at full speed.
    let j = reduced(by.mass, on.mass) * speed / (reduced(FIST.mass, FACE.mass) * SPEED)
    let fast = speed / SPEED
    var modes = [Mode {}; 8]
    for i in 0..4 {
        if on.hz[i] > 0.0 && on.share[i] > 0.0 {
            // A loss factor η: a mode at f falls 60 dB in ln(1000) / (π f η) seconds.
            modes[i] = Mode {
                hz: on.hz[i],
                t60: min(6.91 / (PI * on.hz[i] * on.loss), 2.0),
                level: RING * on.share[i] * j,
            }
        }
    }
    // The striker's own: as loud as the struck body is hard against it (a fist into a belly
    // barely rings itself; a fist on stone is mostly its own knuckles).
    let hard = on.stiffness / (on.stiffness + by.stiffness)
    for i in 0..2 {
        modes[4 + i] = Mode {
            hz: by.hz[i],
            t60: min(6.91 / (PI * by.hz[i] * by.loss), 2.0),
            level: RING * SELF * by.share[i] * hard * j,
        }
    }
    // The slap: air squeezed from between two wet skins, lower and longer than a dry clap, a
    // little higher the faster it's pushed out. It takes bare skin on both sides; the patch sets
    // how much air.
    let skin = by.skin * on.skin
    // The crack: the struck surface's grains, a click as short as the contact, as loud as the
    // blow's force (its impulse over its contact).
    let crack = on.crack * j * contact(FIST, FACE, speed: SPEED) / t
    // The thwap: cloth caught between them, crushed and snapped taut, lower and duller than a
    // slap (the weave lets the air through slowly).
    let cloth = min(by.cloth + on.cloth, 1.0)
    Surface {
        knock: 0.0,
        grit_hz: if crack > skin { 2500.0 } else { 1500.0 * sqrt(fast) },
        grit_q: if crack > skin { 0.5 } else { 1.0 },
        grit_t60: if crack > skin { 0.06 } else { 4.0 * t + 0.025 },
        grit: SLAP * max(skin * by.patch * fast * fast, crack),
        tail_hz: 1100.0 * sqrt(fast),
        tail_q: 1.4,
        tail_t60: 4.0 * t + 0.02,
        tail: THWAP * cloth * by.patch * fast * fast,
        modes,
        contact: t,
        // The pulse's grain: wet skin on skin squelches, cloth smooths it.
        rough: 0.03 + 0.3 * skin,
    }
}

/// A game's weight on a blow: a low thump under it that drops in pitch, as an animated blow
/// lands harder than a real one (`weight` 0 none, 1 a heavy hit). Not physics: what makes a
/// hit feel big on screen.
pub fn weighted(s: Surface, weight: f32) -> Surface {
    var w = s
    w.knock_hz = 55.0
    w.knock_t60 = 0.15
    w.knock = 4.0 * weight
    w.knock_drop = 2.0
    w.knock_glide = 0.03
    w
}

@test
fn a_fist_on_a_face_is_shorter_than_a_shin_in_a_belly() {
    let face = contact(FIST, FACE, speed: 9.0)
    let belly = contact(SHIN, BELLY, speed: 9.0)
    // About 2.6 ms and 20 ms.
    assert(face > 0.002 && face < 0.004, f"{face}")
    assert(belly > 0.012 && belly < 0.03, f"{belly}")
}

@test
fn a_harder_blow_rings_louder_and_slaps_brighter() {
    let soft = struck(FIST, FACE, speed: 4.0)
    let hard = struck(FIST, FACE, speed: 9.0)
    assert(hard.modes[1].level > 2.0 * soft.modes[1].level)
    assert(hard.grit_hz > soft.grit_hz && hard.grit > soft.grit)
}

@test
fn a_fist_on_stone_is_mostly_its_own_knuckles() {
    let stone = struck(FIST, STONE, speed: 9.0)
    let belly = struck(FIST, BELLY, speed: 9.0)
    // On stone the fist rings louder than the stone; in a belly it barely rings at all.
    assert(stone.modes[4].level > stone.modes[0].level)
    assert(belly.modes[4].level < 0.1 * stone.modes[4].level, f"{belly.modes[4].level}")
    // Stone cracks, higher and longer than a face's slap.
    let face = struck(FIST, FACE, speed: 9.0)
    assert(stone.grit_hz > face.grit_hz && stone.grit_t60 > face.grit_t60)
    // A fist on stone: the fist's own stiffness sets the contact.
    assert(stone.contact < contact(FIST, RIBS, speed: 9.0))
}
