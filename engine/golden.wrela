// Golden fixtures from the motion lab: what its f64 oracles computed, for the engine's ports of
// them to agree with ("WFX1", the u32 version 1, then little-endian f64s, each fixture's layout
// told where it's written).

/// A fixture's f64s, read in order.
pub struct Fixture {
    bytes: Bytes,
    at: u32,
}

impl Fixture {
    pub fn of(bytes: Bytes) -> Fixture {
        assert(
            bytes.u32_le(0) == 0x31584657 && bytes.u32_le(4) == 1,
            "a fixture starts WFX1, version 1",
        )
        Fixture { bytes, at: 0 }
    }

    pub fn f(mut self) -> f64 {
        let x = self.bytes.f64_le(8 + 8 * self.at)
        self.at += 1
        x
    }

    pub fn many(mut self, n: u32) -> Vec<f64> {
        var out: Vec<f64> = Vec::new()
        for _ in 0..n {
            out.push(self.f())
        }
        out
    }
}

/// The largest difference between `got` and `want`, over the largest entry of `want` (at least 1).
pub fn apart(got: [f64], want: Vec<f64>) -> f64 {
    var big = 1.0
    var worst = 0.0
    for i in 0..want.len() {
        big = max(big, abs(want[i]))
        worst = max(worst, abs(got[i] - want[i]))
    }
    worst / big
}
