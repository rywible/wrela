// Humanoids from files: a rigged, skinned body read from a glTF binary (`engine::gltf`) and motion
// capture read from a BVH take (`engine::bvh`) or a glTF animation, converted at build time into
// one skeleton named by VRM 1.0's humanoid bones, a mesh skinned to it, and clips retargeted onto
// it. A program holds each as a constant (`const HERO = import(embed("hero.glb"), ...)`), so a
// file that doesn't fit (a missing bone, more than `MAX_BONES`) fails the build, and nothing is
// parsed at load.
//
// - The bones are VRM 1.0's (github.com/vrm-c/vrm-specification, `VRMC_vrm-1.0/humanoid.md`):
//   a file's own names are mapped to them by a table (`UNREAL`, `HUNDRED_STYLE`), and a joint the
//   table leaves out is folded into its nearest mapped ancestor (its weights go there, and its
//   turn moves the bones below it).
// - A clip is retargeted by each bone's turn in the world from the take's rest pose, applied to
//   the rig's rest pose after the rig's bone is aimed where the take's points at rest (a T-pose
//   against an A-pose, a longer forearm): `retarget`. Its hips travel by the ratio of the legs'
//   lengths, and its feet are set on the rig's ground.
// - A looped clip's last frame is its first again, a stride further on: the little that doesn't
//   meet is spread across it, so it loops without a pop (`Retarget::looped`).
// - Posing (`Clip::pose`) and the palette (`palette`) run on the CPU: 52 bones are a few
//   microseconds a frame.

use std::collections::Vec
use std::string::String
use creature::MAX_BONES
use gltf::{Glb, Node, Track, Path}
use bvh::Bvh

/// No bone.
pub const NONE: u32 = 4294967295

/// The first of VRM's bones past its spine, neck, head and jaw.
const AXIAL: u32 = 7

/// VRM 1.0's humanoid bones, each parent before its children.
pub const BONES: [Text; 55] = [
    "hips",
    "spine",
    "chest",
    "upperChest",
    "neck",
    "head",
    "jaw",
    "leftEye",
    "rightEye",
