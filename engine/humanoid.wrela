    "rightLittleDistal",
]

/// The bone each bone aims at (its child along it), by VRM name; "" where it has none to aim
/// at (the head, the eyes, a finger's tip).
const AIMS: [(Text, Text); 24] = [
    ("hips", "spine"),
    ("spine", "chest"),
    ("chest", "upperChest"),
    ("upperChest", "neck"),
    ("neck", "head"),
    ("leftUpperLeg", "leftLowerLeg"),
    ("leftLowerLeg", "leftFoot"),
    ("leftFoot", "leftToes"),
    ("rightUpperLeg", "rightLowerLeg"),
    ("rightLowerLeg", "rightFoot"),
    ("rightFoot", "rightToes"),
    ("leftShoulder", "leftUpperArm"),
    ("leftUpperArm", "leftLowerArm"),
    ("leftLowerArm", "leftHand"),
    ("leftHand", "leftMiddleProximal"),
    ("rightShoulder", "rightUpperArm"),
    ("rightUpperArm", "rightLowerArm"),
    ("rightLowerArm", "rightHand"),
    ("rightHand", "rightMiddleProximal"),
    // A chest of two bones aims past the one it lacks.
    ("chest", "neck"),
    ("spine", "upperChest"),
    ("spine", "neck"),
    ("hips", "chest"),
    ("upperChest", "head"),
]

/// The bones a humanoid must have: VRM 1.0's required fifteen.
const REQUIRED: [Text; 15] = [
    "hips",
    "spine",
    "head",
    "leftUpperLeg",
    "leftLowerLeg",
    "leftFoot",
    "rightUpperLeg",
    "rightLowerLeg",
    "rightFoot",
    "leftUpperArm",
    "leftLowerArm",
    "leftHand",
    "rightUpperArm",
    "rightLowerArm",
    "rightHand",
]

/// The bone named `name` (VRM's), or `NONE`.
pub fn bone(name: str) -> u32 {
    for i in 0..55 {
        if BONES[i] == name {
            return i
        }
    }
    NONE
}

