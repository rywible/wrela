// A wood that streams: the forest of a floor, its instances loaded a tile at a time into slots
// and dropped when their tile is, and chosen each frame on the GPU, not the CPU.
//
// Make a `Wood` (`Wood::new`), `load` and `drop` tiles as the player moves, and each frame
// `select` the lists and draw them (`prepass_cards`, `prepass_far`, `shade`; `shadow` for a
// cascade chosen by `select_shadow`).
//
// A floor streams tens of thousands of instances round the player, and a moving player changes
// them every frame, so every loaded instance stays on the GPU, in its tile's slot; each frame a
// kernel chooses each one's ways (its cards' level, an impostor, a volume: `lod::place`, the same
// function the draws read its shares by) and writes its index and marks into its list's room,
// counted with atomics; a second gathers each list's instances into place, and a third writes
// each list's indirect draws. The draws are `vegetation`'s shaders. A scene that stands still (the
// clearing) is one tile of a wood.
//
// A list is a kind drawn one way. Its room is the kind's loaded instances (an instance is in at
// most two ways), laid out on the CPU when tiles come and go.
//
// The static shadows choose the same way, for the sun's view of a cascade: every instance in
// its square, drawn whole.

use compress::{encode_bc5, encode_bc7, halves}
use impostor_pages::{Build as PageBuild, Checking as PageChecking, Packed as PagePacked}
use impostor_identity::{
    Build as IdentityBuild, Checking as IdentityChecking, Packed as IdentityPacked,
}
use std::io::{print, Pending}
use cull::{Hzb, NO_HZB, occluded}
use impostor::{
    KindDesc, NO_NET, Neural, far_cut_flat, far_quad, far_shade, of_kind, volume_cut, volume_shade,
    page_cut_flat, page_shade, identity_cut_flat, identity_shade,
}
use lit::Lighting
use lod::{IMPOSTOR, Lod, VOLUME, ways}
use memory::{Share, Usage}
use plant::{
    CARD_LEVELS, CORNERS, Card, Instance, Leaves, NO_INSTANCE, Wind, cook_outlines, level_cards,
}
use shadow::{CASTER, Shadows}
use std::field::Tube
use std::mem::size_of
use std::gpu::{
    Atomics, Bc5, Bc7, DepthTexture, DrawArgs, DrawIndexedArgs, Filtered, Format, GlobalId,
    GpuBuffer, GpuSpan, Half2, R32Float, Rg16Float, copy_buffer_to_texture, R32Uint, RenderPass,
    Rgba16Float, Rgba8, Sampler, Slots, Texels3d, Texture, Texture3d, TextureArray, buffer,
    buffer_of, copy, copy_texture, dispatch, draw, draw_multi, label, texture, texture3d,
    texture_array, writable_texture, write, read,
}
use vegetation::{
    CARD_INDICES, CardDraw, Kind, ListDraws, SHADOW_LEAVES, WAYS, ALL, bark_shade, card, card_draw,
    card_indices, card_shadow, leaf_cut, leaf_shade, limb, limb_indices, limb_shadow, mark_of,
    nothing, out_of_view, place_of, leaf_cut_supported, cook_leaf_support,
}
use view::{Camera, NEAREST, PREPASSED}

/// Instances a slot holds: a tile's trees (the floor's densest tile holds fewer).
pub const SLOT: u32 = 4096

/// No kind: an empty place in a slot.
pub const NO_KIND: u32 = 4294967295

/// A slot: the tile its instances are of (none: free), whether they're its far layer's (drawn
/// only far: impostors and volumes) or its own trees, and how many of each kind it holds.
pub struct Slot {
    pub tile: Option<vec2i>,
    pub far: bool,
    pub count: u32,
    pub kinds: Vec<u32>,
    /// The part drawn while a streamed tile arrives or leaves.
    pub visibility: f32,
}

/// A list: a kind drawn one way, and its room in the frame's buffers (its first place and how
/// many it can hold).
pub struct List: Copy + GpuData {
    pub kind: u32,
    pub how: u32,
    pub first: u32,
    pub room: u32,
}

/// What choosing reads besides the instances: the camera, the view's cone (its corner's angle),
/// where the levels hand over, the lists' count, and whether it chooses for a shadow (every
/// instance within `square`, drawn whole: the cards' level 1) or for the camera; the slots'
/// places (`instances`), and the instances loaded in them, in `runs` runs (`instance_of`).
pub struct Choose: Copy + GpuData {
    pub cam: Camera,
    pub corner: f32,
    pub kinds: u32,
    pub shadow: u32,
    pub instances: u32,
    pub square: vec4,
    pub loaded: u32,
    pub runs: u32,
    /// How many lists there are, and where the second phase's counts begin in `counts`
    /// (`Chosen`); the pyramid an instance is tested against (`cull::occluded`).
    pub lists: u32,
    pub late_at: u32,
    pub hzb: Hzb,
}

/// The place of the `k`th loaded instance: the loaded slots' instances are runs, each a slot's
/// first `count` places, numbered on from the run before (`metadata` holds each run's first
/// number and its slot after the slots' visible shares), so a choosing dispatches over what's
/// loaded, not over every slot's room.
fn instance_of(c: Choose, metadata: [u32], k: u32) -> u32 {
    let base = c.instances + c.instances / SLOT
    var lo = 0
    var hi = c.runs
    while hi - lo > 1 {
        let mid = (lo + hi) / 2
        if metadata[base + 2 * mid] <= k {
            lo = mid
        } else {
            hi = mid
        }
    }
    metadata[base + 2 * lo + 1] * SLOT + k - metadata[base + 2 * lo]
}

/// Chooses the `id`th loaded instance's ways (`lod::place`), and puts its index and marks in each
/// way's list: a place taken from the list's count (`counts`), its index into `picked` and its
/// marks into `marks` (two words a place). For a shadow, its one list is its kind's, at level 1,
/// if it stands in the cascade's square. `metadata` holds the instances' kinds, then each
/// slot's visible share as an f32 bit pattern, then the loaded runs (`instance_of`), read
/// together through one storage binding.
@compute(64)
pub fn choose(
    c: Choose,
    every: [Instance],
    metadata: [u32],
    lods: [Lod],
    lists: [List],
    pyramid: Texture<R32Float>,
    counts: mut Atomics<u32>,
    picked: mut Atomics<u32>,
    marks: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= c.loaded {
        return
    }
    let i = instance_of(c, metadata, id.x)
    let k = metadata[i]
    if k == NO_KIND {
        return
    }
    let inst = every[i]
    if c.shadow != 0 {
        let p = inst.at.xz
        if p.x < c.square.x || p.y < c.square.y || p.x > c.square.z || p.y > c.square.w {
            return
        }
        let l = lists[k]
        let at = counts.add(k, 1)
        if at < l.room {
            picked.store(l.first + at, i)
        }
        return
    }
    let l = lods[k]
    if out_of_view(inst, c.cam, l.top, l.reach, c.corner) {
        return
    }
    // Hidden behind what last frame drew (its pyramid): left for the second phase (`reveal`),
    // which tests it against this frame's.
    let b = bound_of(inst, l.top, l.reach)
    let visibility = bitcast_f32(metadata[c.instances + i / SLOT])
    let (level, distant) = place_of(l, c.cam, inst)
    let faint = 1.0 - (1.0 - distant) * visibility
    let (drawn, lower, upper) = ways(level, faint)
    let refine = drawn && lower == IMPOSTOR && upper == IMPOSTOR
    if occluded(pyramid, c.hzb, b.xyz, b.w, refine: refine) {
        let j = counts.add(c.lists, 1)
        counts.store(c.lists + 1 + j, i)
        return
    }
    chosen_into(
        c,
        metadata,
        lists,
        i,
        k,
        inst,
        l,
        counts_from: 0,
        counts: mut counts,
        picked: mut picked,
        marks: mut marks,
    )
}

/// The second phase's choosing: candidate `id` of those the first phase left (`choose`: their
/// count after the lists' counts, then their indices), tested against this frame's pyramid
/// (built after the first phase's opaque passes); one it doesn't hide is chosen into the second
/// phase's lists as `choose` chooses (their counts from `c.late_at`), and drawn this frame.
@compute(64)
pub fn reveal(
    c: Choose,
    every: [Instance],
    metadata: [u32],
    lods: [Lod],
    lists: [List],
    pyramid: Texture<R32Float>,
    counts: mut Atomics<u32>,
    picked: mut Atomics<u32>,
    marks: mut Atomics<u32>,
    id: GlobalId,
) {
    if id.x >= counts.load(c.lists) {
        return
    }
    let i = counts.load(c.lists + 1 + id.x)
    let k = metadata[i]
    let inst = every[i]
    let l = lods[k]
    let b = bound_of(inst, l.top, l.reach)
    let visibility = bitcast_f32(metadata[c.instances + i / SLOT])
    let (level, distant) = place_of(l, c.cam, inst)
    let faint = 1.0 - (1.0 - distant) * visibility
    let (drawn, lower, upper) = ways(level, faint)
    let refine = drawn && lower == IMPOSTOR && upper == IMPOSTOR
    if occluded(pyramid, c.hzb, b.xyz, b.w, refine: refine) {
        return
    }
    chosen_into(
        c,
        metadata,
        lists,
        i,
        k,
        inst,
        l,
        counts_from: c.late_at,
        counts: mut counts,
        picked: mut picked,
        marks: mut marks,
    )
}

/// Instance `i` (of kind `k`, `l` its kind's levels) chosen into its ways' lists (`lod::place`):
/// for each way, a place taken from its list's count (`counts`, from `counts_from`), its index
/// into `picked` and its marks into `marks` (two words a place). `choose`'s and `reveal`'s.
fn chosen_into(
    c: Choose,
    metadata: [u32],
    lists: [List],
    i: u32,
    k: u32,
    inst: Instance,
    l: Lod,
    counts_from: u32,
    counts: mut Atomics<u32>,
    picked: mut Atomics<u32>,
    marks: mut Atomics<u32>,
) {
    let visibility = bitcast_f32(metadata[c.instances + i / SLOT])
    let (level, distant) = place_of(l, c.cam, inst)
    let faint = 1.0 - (1.0 - distant) * visibility
    let (drawn, lower, upper) = ways(level, faint)
    if !drawn {
        return
    }
    for n in 0..2 {
        let way = if n == 0 { lower } else { upper }
        if n == 1 && upper == lower {
            return
        }
        let slot = way * c.kinds + k
        let list = lists[slot]
        let at = counts.add(counts_from + slot, 1)
        if at < list.room {
            let to = list.first + at
            picked.store(to, i)
            let m = mark_of(l, c.cam, inst, way, vec2(level, faint))
            marks.store(2 * to, m.x)
            marks.store(2 * to + 1, m.y)
        }
    }
}

/// An instance's bounding sphere (its centre and radius, `w`): its crown's middle, as
/// `out_of_view` has it, widened as the crown is.
fn bound_of(inst: Instance, top: f32, reach: f32) -> vec4 {
    vec4(inst.at + inst.turn(vec3(0.0, top * 0.5 * inst.scale, 0.0)), inst.bound_radius(reach))
}

/// Every instance moved by `d` (the render origin moved by `-d`); an empty one (`scale` 0)
/// stays.
@compute(64)
pub fn shift_instances(every: mut Slots<Instance>, d: vec3, n: u32, id: GlobalId) {
    if id.x >= n {
        return
    }
    let inst = every[id]
    if inst.scale > 0.0 {
        every[id] = Instance { at: inst.at + d, ..inst }
    }
}

/// The instances and marks the choosing put in each place, gathered: place `id` gets the
/// instance whose index is there (a place past its list's count holds an old one, which no draw
/// reads).
@compute(64)
pub fn gather(
    every: [Instance],
    picked: [u32],
    from: [u32],
    places: u32,
    out: mut Slots<Instance>,
    marks: mut Slots<vec2u>,
    id: GlobalId,
) {
    if id.x >= places {
        return
    }
    let i = picked[id.x]
    out[id] = if i < every.len() { every[i] } else {
        NO_INSTANCE
    }
    marks[id] = vec2u(from[2 * id.x], from[2 * id.x + 1])
}

/// Each list's draws: its cards' and limbs' (`templates`, with its count of instances), and its
/// far quads' (`far`: six vertices an instance), each from its list's first place (so a way's
/// lists, one after another, are one multi-draw over every place: `Wood::shade`).
@compute(64)
pub fn draws_of(
    templates: [ListDraws],
    counts: [u32],
    lists: [List],
    n: u32,
    cards: mut Slots<DrawIndexedArgs>,
    limbs: mut Slots<DrawIndexedArgs>,
    far: mut Slots<DrawArgs>,
    id: GlobalId,
) {
    if id.x >= n {
        return
    }
    let l = lists[id.x]
    let count = min(counts[id.x], l.room)
    let t = templates[id.x]
    cards[id] = DrawIndexedArgs { instances: count, first_instance: l.first, ..t.cards }
    limbs[id] = DrawIndexedArgs { instances: count, first_instance: l.first, ..t.limbs }
    far[id] = DrawArgs { vertices: 6, instances: count, first_vertex: 0, first_instance: l.first }
}

/// What one phase of a choosing writes (`Chosen`): the places' instance indices and marks as
/// the choosing wrote them, the instances and marks gathered into place, and each list's draws
/// (`draws_of`): its cards', its limbs' and its far quads'.
pub struct Phase {
    picked: GpuBuffer<u32>,
    raw_marks: GpuBuffer<u32>,
    pub instances: GpuBuffer<Instance>,
    pub marks: GpuBuffer<vec2u>,
    pub cards: GpuBuffer<DrawIndexedArgs>,
    pub limbs: GpuBuffer<DrawIndexedArgs>,
    pub far: GpuBuffer<DrawArgs>,
}

impl Phase {
    /// Room for `n` places, made anew (to grow, or to shrink: `Chosen::run`).
    fn room_for(mut self, n: u32) {
        self.picked = buffer(n)
        self.raw_marks = buffer(2 * n)
        self.instances = buffer(n)
        self.marks = buffer(n)
    }

    /// The GPU bytes its places take.
    fn bytes(self) -> u64 {
        u64(self.instances.len()) * u64(size_of::<Instance>() + size_of::<vec2u>() + 12)
    }

    fn empty() -> Phase {
        Phase {
            picked: buffer(1),
            raw_marks: buffer(2),
            instances: buffer(1),
            marks: buffer(1),
            cards: buffer(1),
            limbs: buffer(1),
            far: buffer(1),
        }
    }

    /// Room for `places` places (`grown` of them, when it grows) and `lists` lists' draws.
    fn fit(mut self, places: u32, grown: u32, lists: u32) {
        if places > self.instances.len() {
            self.room_for(grown)
        }
        self.cards = buffer(room(lists))
        self.limbs = buffer(room(lists))
        self.far = buffer(room(lists))
    }
}

/// What a choosing writes: its lists (and their rooms), the counts, and two phases' places and
/// draws (`Phase`): the first's (`early`: what wasn't hidden behind last frame's depth), and the
/// second's (`late`: what the first left out that this frame's depth doesn't hide, `reveal`).
/// `counts` holds the first phase's lists' counts, how many it left out and which, then the
/// second phase's lists' counts (from `late_at`).
pub struct Chosen {
    pub lists: Vec<List>,
    lists_gpu: GpuBuffer<List>,
    templates: GpuBuffer<ListDraws>,
    counts: GpuBuffer<u32>,
    /// Counts' reset values (the first phase's and how many it left out; the second phase's),
    /// kept on the CPU while the lists stay laid out.
    zero_counts: Vec<u32>,
    pub early: Phase,
    pub late: Phase,
    /// The current lists' aligned places. Buffers keep extra room for later tiles, but a
    /// frame gathers only these places; draws cannot read the unused tail.
    places: u32,
    /// Room for what the first phase leaves out (every instance the lists hold).
    held: u32,
    /// Frames its places have filled less than half their room (`SHRINK_AFTER`).
    under: u32,
}

/// Frames a choosing's places may fill less than half their room before it shrinks to half again
/// what they need (the room a tile more grows into).
pub const SHRINK_AFTER: u32 = 300

/// Whether a choosing's room of `room` places shrinks for `places` (`under` frames under half,
/// `after` of them enough: `SHRINK_AFTER`, or fewer while memory is over its budget).
pub fn shrinks(places: u32, room: u32, under: u32, after: u32 = SHRINK_AFTER) -> bool {
    places * 2 < room && under >= after
}

/// Phase `ph`'s `places` places gathered from `every` (`gather`), and its `n` lists' draws
/// written from their `counts` (`draws_of`).
fn finished(
    ph: mut Phase,
    every: GpuBuffer<Instance>,
    templates: GpuBuffer<ListDraws>,
    counts: GpuSpan<u32>,
    lists: GpuBuffer<List>,
    places: u32,
    n: u32,
) {
    dispatch(
        gather.bind(
            every,
            picked: ph.picked,
            from: ph.raw_marks,
            places: places,
            out: mut ph.instances,
            marks: mut ph.marks,
        ),
        over: places,
    )
    dispatch(
        draws_of.bind(
            templates: templates,
            counts: counts,
            lists: lists,
            n: n,
            cards: mut ph.cards,
            limbs: mut ph.limbs,
            far: mut ph.far,
        ),
        over: room(n),
    )
}

/// Room for `n` places, at least one.
fn room(n: u32) -> u32 {
    max(n, 1)
}

impl Chosen {
    fn empty() -> Chosen {
        Chosen {
            lists: Vec::new(),
            lists_gpu: buffer(1),
            templates: buffer(1),
            counts: buffer(3),
            zero_counts: Vec::new(),
            early: Phase::empty(),
            late: Phase::empty(),
            places: 0,
            held: 0,
            under: 0,
        }
    }

    /// Where the second phase's counts begin in `counts`: after the first phase's and what it
    /// left out, at a word a binding may start at (256 bytes).
    fn late_at(self) -> u32 {
        (self.lists.len() + 1 + room(self.held) + 63) / 64 * 64
    }

    /// Lists laid out for `per_kind` instances of each kind loaded (`kinds`, then each far kind,
    /// `far_kinds` its own), `ways` lists a kind (the camera's every way, or a shadow's one), each
    /// list's draws' template from its kind: a way's lists one after another, a kind each (list
    /// `way * kinds + kind`), so its draws are one multi-draw. A second phase (`late`) has room
    /// only for the camera's (`ways` more than 1).
    fn lay_out(mut self, kinds: [Kind], far_kinds: [u32], per_kind: [u32], ways: u32) {
        self.lists.clear()
        var first = 0
        var held = 0
        var templates: Vec<ListDraws> = Vec::new()
        for k in 0..(kinds.len() + far_kinds.len()) {
            held += per_kind[k]
        }
        for way in 0..ways {
            for k in 0..(kinds.len() + far_kinds.len()) {
                let n = per_kind[k]
                borrow kd = kinds[if k < kinds.len() { k } else { far_kinds[k - kinds.len()] }]
                let how = if ways == 1 { 1 } else { way }
                self.lists.push(List { kind: k, how, first, room: n })
                first += (n + 31) / 32 * 32
                let near = how < CARD_LEVELS
                let cards = if near { level_cards(kd.card_count, how) } else { 0 }
                let limbs = if near { kd.limb_count } else { 0 }
                let d = |indices: u32| DrawIndexedArgs {
                    indices,
                    instances: 0,
                    first_index: 0,
                    base_vertex: 0,
                    first_instance: 0,
                }
                templates.push(
                    ListDraws {
                        cards: d(cards * CARD_INDICES),
                        limbs: d(limbs * plant::LIMB_VERTICES),
                    },
                )
            }
        }
        let places = room(first)
        // Room to grow into, so a tile more doesn't make them again.
        let grown = places + places / 2
        let n = self.lists.len()
        self.early.fit(places, grown, n)
        if ways > 1 {
            self.late.fit(places, grown, n)
        }
        self.places = places
        self.held = if ways > 1 { held } else { 0 }
        self.lists_gpu = buffer_of(self.lists, at_least: 1)
        self.templates = buffer_of(templates, at_least: 1)
        self.counts = buffer(self.late_at() + n + 1)
        self.zero_counts = Vec::filled(n + 1, 0)
    }

    /// Chooses from `every` for `c` (its first phase, against `pyramid`: last frame's), then
    /// gathers and writes its draws. The second phase's counts are made 0 for `reveal` (a
    /// shadow's choosing has no second phase: nothing reads them).
    fn run(
        mut self,
        c: Choose,
        every: GpuBuffer<Instance>,
        metadata: GpuBuffer<u32>,
        lods: GpuBuffer<Lod>,
        pyramid: Texture<R32Float>,
        after: u32 = SHRINK_AFTER,
    ) {
        let n = self.lists.len()
        // Room left half empty for long (tiles dropped) is given back: half again what's needed.
        let room = self.early.instances.len()
        self.under = if self.places * 2 < room { self.under + 1 } else { 0 }
        if shrinks(self.places, room, self.under, after) {
            let grown = self.places + self.places / 2
            self.early.room_for(grown)
            if self.held > 0 {
                self.late.room_for(grown)
            }
            self.under = 0
        }
        let c = Choose { lists: n, late_at: self.late_at(), ..c }
        write(mut self.counts, 0, self.zero_counts)
        if c.shadow == 0 {
            write(mut self.counts, self.late_at(), self.zero_counts)
        }
        dispatch(
            choose.bind(
                c,
                every,
                metadata,
                lods,
                lists: self.lists_gpu,
                pyramid: pyramid,
                counts: mut self.counts,
                picked: mut self.early.picked,
                marks: mut self.early.raw_marks,
            ),
            over: max(c.loaded, 1),
        )
        self.finish(every, late: false)
    }

    /// The second phase: what the first left out, tested against `pyramid` (this frame's, `c`'s
    /// camera), chosen, gathered and drawn.
    fn reveal(
        mut self,
        c: Choose,
        every: GpuBuffer<Instance>,
        metadata: GpuBuffer<u32>,
        lods: GpuBuffer<Lod>,
        pyramid: Texture<R32Float>,
    ) {
        let c = Choose { lists: self.lists.len(), late_at: self.late_at(), ..c }
        dispatch(
            reveal.bind(
                c,
                every,
                metadata,
                lods,
                lists: self.lists_gpu,
                pyramid: pyramid,
                counts: mut self.counts,
                picked: mut self.late.picked,
                marks: mut self.late.raw_marks,
            ),
            over: room(self.held),
        )
        self.finish(every, late: true)
    }

    /// A phase's places gathered and its draws written (`late`: the second's).
    fn finish(mut self, every: GpuBuffer<Instance>, late: bool) {
        let n = self.lists.len()
        let counts = self.counts.span(start: if late { self.late_at() } else { 0 }, count: room(n))
        if late {
            finished(mut self.late, every, self.templates, counts, self.lists_gpu, self.places, n)
        } else {
            finished(mut self.early, every, self.templates, counts, self.lists_gpu, self.places, n)
        }
    }

    /// The GPU bytes its places take, both phases'.
    fn bytes(self) -> u64 {
        self.early.bytes() + self.late.bytes()
    }

    /// Whether any list of way `way` (of `kinds` kinds) holds a place (the CPU's laid-out
    /// rooms).
    fn way_has(self, way: u32, kinds: u32) -> bool {
        for k in 0..kinds {
            if self.lists[way * kinds + k].room > 0 {
                return true
            }
        }
        false
    }
}

/// A wood's kinds pooled for its draws (`impostor::KindDesc`, one an instance's kind): every
/// kind's cards, their orders, its limbs and its impostor's views' bounds one after another;
/// the impostors as layers of two arrays, and the volumes as slabs of one atlas (`in_slab`). So a
/// way's draws bind the same for every kind, and are one multi-draw.
pub struct Pool {
    pub kinds: GpuBuffer<KindDesc>,
    pub cards: GpuBuffer<Card>,
    pub orders: GpuBuffer<u32>,
    pub limbs: GpuBuffer<Tube<4>>,
    pub bounds: GpuBuffer<vec4>,
    pub impostors: Impostors,
    pub grid: Texture3d<Rgba16Float>,
    pub grid_depth: Texture3d<Rgba16Float>,
}

/// The kinds' impostors, a layer of each array a kind: their colour, their normals (octahedral,
/// `* 0.5 + 0.5`) and their toward-and-depth, compressed (BC7 and BC5: a byte a texel each, where
/// the device has BC) or not (8-bit colour and half floats).
pub enum Impostors {
    Plain {
        colour: TextureArray<Rgba8>,
        normal: TextureArray<Rg16Float>,
        depth: TextureArray<Rg16Float>,
    },
    Compressed { colour: TextureArray<Bc7>, normal: TextureArray<Bc5>, depth: TextureArray<Bc5> },
    Paged { data: PagePacked },
    Source { data: IdentityPacked },
}

/// Kind `k`'s volume into slab `slab` of the volumes' atlas (`in_slab`): its voxel there, read
/// from its own volume (an invocation below the slab writes nothing: `Texels3d` writes its own
/// voxel, so the dispatch reaches the slab from the atlas's start).
@compute(4, 4, 4)
fn slab_of(from: Texture3d<Rgba16Float>, slab: u32, out: mut Texels3d<Rgba16Float>, id: GlobalId) {
    let z0 = slab * impostor::VOXELS
    if id.z < z0 || id.z >= z0 + impostor::VOXELS {
        return
    }
    out.store(id, from.load(x: id.x, y: id.y, z: id.z - z0))
}

/// `n` layers of impostors, compressed or not.
fn impostors_of(n: u32, compress: bool) -> Impostors {
    let a = impostor::ATLAS
    if compress {
        Impostors::Compressed {
            colour: texture_array::<Bc7>(width: a, height: a, layers: n),
            normal: texture_array::<Bc5>(width: a, height: a, layers: n),
            depth: texture_array::<Bc5>(width: a, height: a, layers: n),
        }
    } else {
        Impostors::Plain {
            colour: texture_array::<Rgba8>(width: a, height: a, layers: n),
            normal: texture_array::<Rg16Float>(width: a, height: a, layers: n),
            depth: texture_array::<Rg16Float>(width: a, height: a, layers: n),
        }
    }
}

/// A kind's impostor (`colour`, `normal`: its bake's) into layer `i` of `into`, through
/// `scratch`: compressed (BC7, and BC5 twice: the normals, then toward-and-depth) or the colour
/// copied and the normal's channels packed as halves (`compress::halves`).
fn into_layer(
    into: mut Impostors,
    scratch: mut GpuBuffer<u32>,
    colour: Texture<Rgba8>,
    normal: Texture<Rgba16Float>,
    i: u32,
) {
    let a = impostor::ATLAS
    let blocks = vec2u(a / 4)
    let words = 4 * blocks.x * blocks.y
    match mut into {
        Impostors::Compressed { colour: c, normal: nm, depth: d } => {
            label("impostors compress")
            dispatch(encode_bc7.bind(colour, blocks, out: mut scratch), over: blocks.x * blocks.y)
            copy_buffer_to_texture(from: scratch.span(start: 0, count: words), to: c.layer_mut(i))
            dispatch(
                encode_bc5.bind(normal, which: 0, blocks: blocks, out: mut scratch),
                over: blocks.x * blocks.y,
            )
            copy_buffer_to_texture(from: scratch.span(start: 0, count: words), to: nm.layer_mut(i))
            dispatch(
                encode_bc5.bind(normal, which: 1, blocks: blocks, out: mut scratch),
                over: blocks.x * blocks.y,
            )
            copy_buffer_to_texture(from: scratch.span(start: 0, count: words), to: d.layer_mut(i))
        },
        Impostors::Paged { .. } => { assert(false, "cannot pool into a packed atlas") },
        Impostors::Source { .. } => { assert(false, "cannot pool into source identities") },
        Impostors::Plain { colour: c, normal: nm, depth: d } => {
            copy_texture(from: colour.level(0), to: c.layer_mut(i))
            let texels = a * a
            dispatch(halves.bind(normal, which: 0, size: vec2u(a), out: mut scratch), over: texels)
            copy_buffer_to_texture(from: scratch.span(start: 0, count: texels), to: nm.layer_mut(i))
            dispatch(halves.bind(normal, which: 1, size: vec2u(a), out: mut scratch), over: texels)
            copy_buffer_to_texture(from: scratch.span(start: 0, count: texels), to: d.layer_mut(i))
        },
    }
}

// Common storage for both an existing collection of kinds and an incremental build.
fn empty_pool(
    count: u32,
    far_count: u32,
    cards: u32,
    orders: u32,
    limbs: u32,
    compress: bool,
) -> Pool {
    let n = max(count, 1)
    let views = impostor::VIEWS * impostor::VIEWS
    let side = impostor::VOXELS
    Pool {
        kinds: buffer(max(count + far_count, 1)),
        cards: buffer(max(cards, 1)),
        orders: buffer(max(orders, 1)),
        limbs: buffer(max(limbs, 1)),
        bounds: buffer(n * views),
        impostors: impostors_of(n, compress),
        grid: texture3d::<Rgba16Float>(side, side, side * n),
        grid_depth: texture3d::<Rgba16Float>(side, side, side * n),
    }
}

fn install_kind(p: mut Pool, k: mut Kind, i: u32, at: vec3u) -> KindDesc {
    let views = impostor::VIEWS * impostor::VIEWS
    let side = impostor::VOXELS
    let c = k.card_count
    let l = k.limb_count
    let desc = KindDesc {
        bake: k.impostor.bake,
        card_first: at.x,
        card_count: c,
        order_first: at.y,
        limb_first: at.z,
        limb_count: l,
        bounds_first: i * views,
        layer: i,
        slab: i,
    }
    if c > 0 {
        copy(
            from: k.cards.span(start: 0, count: c),
            to: p.cards.span_mut(start: at.x, count: c),
        )
        copy(
            from: k.orders.span(start: 0, count: CORNERS * c),
            to: p.orders.span_mut(start: at.y, count: CORNERS * c),
        )
    }
    if l > 0 {
        copy(
            from: k.limbs.span(start: 0, count: l),
            to: p.limbs.span_mut(start: at.z, count: l),
        )
    }
    copy(
        from: k.impostor.bounds.span(start: 0, count: views),
        to: p.bounds.span_mut(start: i * views, count: views),
    )
    dispatch(
        slab_of.bind(from: k.volume.grid, slab: i, out: mut p.grid),
        groups: (side / 4, side / 4, side * (i + 1) / 4),
    )
    dispatch(
        slab_of.bind(from: k.volume.grid_depth, slab: i, out: mut p.grid_depth),
        groups: (side / 4, side / 4, side * (i + 1) / 4),
    )
    // The pool holds them now (a host releases a texture after the work recorded before).
    k.impostor.colour = texture::<Rgba8>(width: 1, height: 1)
    k.impostor.normal = texture::<Rgba16Float>(width: 1, height: 1)
    k.volume.grid = texture3d::<Rgba16Float>(width: 1, height: 1, depth: 1)
    k.volume.grid_depth = texture3d::<Rgba16Float>(width: 1, height: 1, depth: 1)
    desc
}

fn pool_of(kinds: mut Vec<Kind>, far_kinds: [u32], compress: bool) -> Pool {
    var cards = 0
    var orders = 0
    var limbs = 0
    for k in kinds {
        cards += k.card_count
        orders += CORNERS * k.card_count
        limbs += k.limb_count
    }
    var p = empty_pool(kinds.len(), far_kinds.len(), cards, orders, limbs, compress)
    var descs: Vec<KindDesc> = Vec::new()
    var at = vec3u(0)
    var scratch: GpuBuffer<u32> = buffer(impostor::ATLAS * impostor::ATLAS)
    for i in 0..kinds.len() {
        into_layer(
            mut p.impostors,
            mut scratch,
            kinds[i].impostor.colour,
            kinds[i].impostor.normal,
            i,
        )
        let desc = install_kind(mut p, mut kinds[i], i, at)
        at += vec3u(desc.card_count, CORNERS * desc.card_count, desc.limb_count)
        descs.push(desc)
    }
    for f in far_kinds { descs.push(descs[f]) }
    if descs.len() > 0 { write(mut p.kinds, 0, descs) }
    p
}

/// Builds each kind into pooled storage immediately; no per-kind colour/normal atlases remain.
pub struct PoolCook {
    expected: u32,
    kinds: Vec<Kind>,
    far_kinds: Vec<u32>,
    descs: Vec<KindDesc>,
    pool: Pool,
    at: vec3u,
    bake: impostor::BakeScratch,
    scratch: GpuBuffer<u32>,
}

impl PoolCook {
    /// Reserve the source capacities, then add every kind before passing this to Wood::cooked.
    /// Each add encodes the shared bake before the next one overwrites it.
    pub fn new(
        plants: [plant::Plant],
        far_kinds: take Vec<u32>,
        compress: bool = false,
    ) -> PoolCook {
        var cards = 0
        var limbs = 0
        for p in plants {
            cards += p.cards()
            limbs += p.limbs.len()
        }
        let pool = empty_pool(
            plants.len(),
            far_kinds.len(),
            cards,
            CORNERS * cards,
            limbs,
            compress,
        )
        PoolCook {
            expected: plants.len(),
            kinds: Vec::new(),
            far_kinds,
            descs: Vec::new(),
            pool,
            at: vec3u(0),
            bake: impostor::BakeScratch::new(),
            scratch: buffer(impostor::ATLAS * impostor::ATLAS),
        }
    }
    pub fn len(self) -> u32 {
        self.kinds.len()
    }
    pub fn add(mut self, plant: plant::Plant, seed: u32, atlas: Texture<Rgba8>, s: Sampler) {
        let i = self.kinds.len()
        assert(i < self.expected, "too many pooled kinds")
        let source = vegetation::source(plant, seed)
        let b = impostor::bake_settings(plant)
        let bounds = self.bake.render(
            b,
            source.cards,
            source.card_count,
            source.limbs,
            source.limb_count,
            atlas,
            s,
        )
        let volume = impostor::cook(b, source.cards, source.card_count, atlas, s)
        let image = impostor::Impostor {
            colour: texture::<Rgba8>(width: 1, height: 1),
            normal: texture::<Rgba16Float>(width: 1, height: 1),
            bake: b,
            bounds,
        }
        var k = take source.finish(take image, take volume)
        assert(
            self.at.x + k.card_count <= self.pool.cards.len() &&
                self.at.y + CORNERS * k.card_count <= self.pool.orders.len() &&
                self.at.z + k.limb_count <= self.pool.limbs.len(),
            "pooled source counts changed",
        )
        into_layer(mut self.pool.impostors, mut self.scratch, self.bake.colour, self.bake.normal, i)
        let desc = install_kind(mut self.pool, mut k, i, self.at)
        self.at += vec3u(desc.card_count, CORNERS * desc.card_count, desc.limb_count)
        self.descs.push(desc)
        self.kinds.push(take k)
    }
    fn finish(take self) -> (Vec<Kind>, Vec<u32>, Pool) {
        assert(self.kinds.len() == self.expected, "incomplete pooled kinds")
        var descs = take self.descs
        var pool = take self.pool
        for f in self.far_kinds {
            assert(f < self.expected)
            descs.push(descs[f])
        }
        if descs.len() > 0 { write(mut pool.kinds, 0, descs) }
        (take self.kinds, take self.far_kinds, take pool)
    }
}

/// A wood: its kinds and their leaves' atlas, the instances loaded (in slots, a tile each, and
/// each one's kind), the camera's and the shadows' choosings, and where its levels hand over.
pub struct Wood {
    pub kinds: Vec<Kind>,
    /// Each far kind's own kind: instances name the wood's own kinds, then its far kinds, each one
    /// of its own drawn only far (a far layer's: never as cards, nor in the shadows).
    pub far_kinds: Vec<u32>,
    pub atlas: Texture<Rgba8>,
    outlines: GpuBuffer<vec2>,
    leaf_support: Option<Texture<R32Uint>>,
    /// Bark's ridges, cooked once (`plant::cook_ridges`, and coarse: `plant::cook_coarse`), and the
    /// sampler that repeats them.
    ridges: Texture<Rgba8>,
    coarse: Texture<Rgba8>,
    repeat: Sampler,
    card_triangles: GpuBuffer<u32>,
    limb_triangles: GpuBuffer<u32>,
    lods: GpuBuffer<Lod>,
    every: GpuBuffer<Instance>,
    /// One kind per instance, then one f32 bit pattern per slot for its visible share, then
    /// the loaded runs (two words each: `instance_of`). Sharing a binding leaves room for lifted
    /// kernels' parameter storage within WebGPU's eight-storage-buffer limit.
    metadata: GpuBuffer<u32>,
    pub slots: Vec<Slot>,
    /// The kinds pooled for the draws.
    pub pool: Pool,
    page_build: Option<PageBuild>,
    page_fence: Option<Pending<vec4>>,
    page_check: Option<PageChecking>,
    source_pages: bool,
    source_build: Option<IdentityBuild>,
    source_check: Option<IdentityChecking>,
    /// The camera's last choosing (`select`), which `reveal`'s second phase repeats; and a
    /// pyramid of nothing, for the shadows' choosing.
    chose: Option<Choose>,
    no_pyramid: Texture<R32Float>,
    /// The instances loaded, and the runs they're in (laid out with the lists).
    loaded_places: u32,
    runs: u32,
    seen: Chosen,
    shadowed: Chosen,
    /// Whether the lists need laying out again (a tile came or went).
    laid: bool,
    pub cards_to: f32,
    /// Maximum centre of the cards-to-impostor handover, in metres.
    pub cards_limit: f32,
    /// Desired maximum crown diameter at that handover, in scene pixels.
    pub impostor_px: f32,
    pub impostors_to: f32,
    pub card_px: f32,
    pub cell: f32,
    /// What the camera keeps clear of leaves (`vegetation::CardDraw::clear`).
    pub clear: vec4,
    /// Frames a choosing's room stays under half full before it's given back (`shrinks`): fewer
    /// while memory is over its budget (`engine::memory::shrink_after`).
    pub shrink_after: u32,
    /// A kind's impostor read through a net, and its weights (`read_through`: none unless a game
    /// gives one, `Quality::neural`).
    neural: Neural,
    net: GpuBuffer<Half2>,
}

impl Wood {
    /// A wood of `kinds` (cooked with `atlas`) and far kinds (`far_kinds`: each its own kind's
    /// index), with room for `slots` tiles.
    /// With fixed_leaf_atlas, the caller guarantees the atlas is unchanged for this Wood's
    /// lifetime. Reconstruct the Wood after an atlas edit. Only the standard atlas size
    /// enables the source support table; other callers keep the original coverage shader.
    pub fn new(
        kinds: take Vec<Kind>,
        far_kinds: take Vec<u32>,
        atlas: take Texture<Rgba8>,
        slots: u32,
        cards_to: f32,
        impostors_to: f32,
        compress: bool = false,
        fixed_leaf_atlas: bool = false,
    ) -> Wood {
        var kinds = take kinds
        let pool = pool_of(mut kinds, far_kinds, compress)
        Wood::with_pool(
            take kinds,
            take far_kinds,
            take atlas,
            take pool,
            slots,
            cards_to,
            impostors_to,
            fixed_leaf_atlas,
        )
    }

    /// Finish the ordered pooled build. Rendering and page-compaction policies are unchanged.
    pub fn cooked(
        cooked: take PoolCook,
        atlas: take Texture<Rgba8>,
        slots: u32,
        cards_to: f32,
        impostors_to: f32,
        fixed_leaf_atlas: bool = false,
    ) -> Wood {
        let (kinds, far_kinds, pool) = take cooked.finish()
        Wood::with_pool(
            take kinds,
            take far_kinds,
            take atlas,
            take pool,
            slots,
            cards_to,
            impostors_to,
            fixed_leaf_atlas,
        )
    }

    fn with_pool(
        kinds: take Vec<Kind>,
        far_kinds: take Vec<u32>,
        atlas: take Texture<Rgba8>,
        pool: take Pool,
        slots: u32,
        cards_to: f32,
        impostors_to: f32,
        fixed_leaf_atlas: bool,
    ) -> Wood {
        var outlines: GpuBuffer<vec2> = buffer(plant::LEAF_PATTERNS * plant::OUTLINE)
        dispatch(
            cook_outlines.bind(atlas, mut outlines),
            over: plant::LEAF_PATTERNS * plant::OUTLINE,
        )
        let leaf_support = if fixed_leaf_atlas &&
            atlas.width() == plant::LEAF_ATLAS &&
            atlas.height() == plant::LEAF_ATLAS {
            var support = writable_texture::<R32Uint>(
                width: plant::LEAF_ATLAS / 4,
                height: plant::LEAF_ATLAS / 4,
            )
            label("leaf support")
            dispatch(cook_leaf_support.bind(atlas, out: mut support), over: support)
            label("cook")
            Some(take support)
        } else { None }
        var most = 1
        var most_limbs = 1
        for k in kinds {
            most = max(most, k.card_count)
            most_limbs = max(most_limbs, k.limb_count)
        }
        var metadata: GpuBuffer<u32> = buffer(slots * SLOT + 3 * slots)
        // Empty slots return at NO_KIND before reading their unused visibility words.
        write(mut metadata, 0, Vec::filled(slots * SLOT, NO_KIND))
        let n = kinds.len() + far_kinds.len()
        let ridges = plant::cook_ridges()
        let coarse = plant::cook_coarse(ridges)
        var w = Wood {
            kinds,
            far_kinds,
            atlas,
            outlines,
            leaf_support,
            ridges,
            coarse,
            repeat: std::gpu::sampler(address: std::gpu::Address::Repeat),
            card_triangles: buffer_of(card_indices(most)),
            limb_triangles: buffer_of(limb_indices(most_limbs)),
            lods: buffer(max(n, 1)),
            every: buffer(slots * SLOT),
            metadata,
            slots: Vec::from_fn(
                slots,
                |_| Slot {
                    tile: None,
                    far: false,
                    count: 0,
                    kinds: Vec::filled(n, 0),
                    visibility: 1.0,
                },
            ),
            pool,
            page_build: None,
            page_fence: None,
            page_check: None,
            source_pages: false,
            source_build: None,
            source_check: None,
            chose: None,
            no_pyramid: writable_texture::<R32Float>(width: 1, height: 1),
            loaded_places: 0,
            runs: 0,
            seen: Chosen::empty(),
            shadowed: Chosen::empty(),
            laid: false,
            cards_to,
            cards_limit: cards_to,
            impostor_px: f32(impostor::CELL),
            impostors_to,
            card_px: lod::CARD_PX,
            cell: 1.0,
            clear: vec4(0.0),
            shrink_after: SHRINK_AFTER,
            neural: NO_NET,
            net: buffer(1),
        }
        w.write_lods()
        w
    }

    /// Request exact block deduplication; ordinary arrays remain until every block is verified.
    pub fn request_pages(mut self) {
        if self.pages_pending() { return }
        match self.pool.impostors {
            Impostors::Compressed { .. } => {
                // The source bake's temporary textures must retire before allocating hash scratch.
                self.page_fence = Some(read(self.pool.bounds.span(start: 0, count: 1)))
            },
            _ => {},
        }
    }

    /// Opt in to source visibility palettes. Oversized sources keep the exact BC page path.
    /// Rebuilding the Wood after source edits rebuilds its identities and releases old data.
    pub fn request_source_pages(mut self) {
        if self.pages_pending() { return }
        self.source_pages = impostor_identity::fits(self.kinds)
        self.request_pages()
    }

    pub fn pages_pending(self) -> bool {
        self.page_fence.is_some() ||
            self.page_build.is_some() ||
            self.page_check.is_some() ||
            self.source_build.is_some() ||
            self.source_check.is_some()
    }

    pub fn settle_pages(mut self) {
        let source_done = match mut self.page_fence {
            Some(f) => match f.poll() {
                Some(Ok(_)) => true,
                Some(Err(_)) => {
                    assert(false, "appearance source fence failed")
                    false
                },
                None => false,
            },
            None => false,
        }
        if source_done {
            self.page_fence = None
            match self.pool.impostors {
                Impostors::Compressed { colour, normal, depth } => {
                    if self.source_pages {
                        self.source_build = Some(IdentityBuild::new(self.kinds, self.atlas))
                    } else {
                        self.page_build = Some(PageBuild::new(colour, normal, depth))
                    }
                },
                _ => {},
            }
        }
        let source_counted = match mut self.source_build {
            Some(b) => b.poll(),
            None => None,
        }
        if let Some(values) = source_counted {
            let build = replace(mut self.source_build, None).unwrap()
            assert(values.len() == 2 && values[1] == 0, "source identity verification failed")
            print(f"SOURCE_ID_PAGES payload_words={values[0]} errors={values[1]}")
            self.source_check = Some(take build.finish(values[0]))
        }
        let source_checked = match mut self.source_check {
            Some(c) => c.poll(),
            None => None,
        }
        if let Some(errors) = source_checked {
            assert(errors == 0, "source identity fence failed")
            let checked = replace(mut self.source_check, None).unwrap()
            self.pool.impostors = Impostors::Source { data: take checked.packed }
            print("SOURCE_ID_PAGES active all_source_ids_verified")
        }
        let counted = match mut self.page_build {
            Some(b) => b.poll(),
            None => None,
        }
        if let Some(values) = counted {
            let build = replace(mut self.page_build, None).unwrap()
            assert(values.len() == 2 && values[1] == 0, "appearance page hash overflow")
            print(f"APPEARANCE_PAGES unique={values[0]} hash_errors={values[1]}")
            self.page_check = Some(take build.finish(values[0]))
        }
        let checked = match mut self.page_check {
            Some(c) => c.poll(),
            None => None,
        }
        if let Some(errors) = checked {
            assert(errors == 0, "appearance page word verification failed")
            let checked = replace(mut self.page_check, None).unwrap()
            self.pool.impostors = Impostors::Paged { data: take checked.packed }
            print("APPEARANCE_PAGES active all_block_words_verified")
        }
    }

    /// The GPU bytes its pooled kinds take but their impostors (`impostor_bytes`): their cards,
    /// card orders, limbs, impostor bounds and volumes, and every instance loaded.
    pub fn pool_bytes(self) -> u64 {
        borrow p = self.pool
        let v = impostor::VOXELS
        u64(p.cards.len()) * u64(size_of::<Card>()) +
            u64(p.orders.len()) * 4 +
            u64(p.limbs.len()) * u64(size_of::<Tube<4>>()) +
            u64(p.bounds.len()) * 16 +
            2 * memory::texels(v, v, 8, d: v) * u64(self.kinds.len()) +
            u64(self.every.len()) * u64(size_of::<Instance>()) +
            u64(self.metadata.len()) * 4 +
            match self.leaf_support {
                Some(support) => memory::texels(support.width(), support.height(), 4),
                None => 0,
            }
    }

    /// The GPU bytes its kinds' impostors take (`Impostors`: a layer of each array a kind).
    pub fn impostor_bytes(self) -> u64 {
        if let Impostors::Source { data } = self.pool.impostors {
            return u64(data.data.len()) * 4
        }
        if let Impostors::Paged { data } = self.pool.impostors {
            return memory::texels(data.colour.width(), data.colour.height(), 3) +
                u64(data.map.len()) * 4
        }
        let texel = match self.pool.impostors {
            Impostors::Plain { .. } => 12,
            Impostors::Compressed { .. } => 3,
            Impostors::Paged { .. } => 0,
            Impostors::Source { .. } => 0,
        }
        memory::texels(impostor::ATLAS, impostor::ATLAS, texel, d: self.kinds.len())
    }

    /// The GPU bytes its choosings' places take (the camera's and the shadows').
    pub fn list_bytes(self) -> u64 {
        self.seen.bytes() + self.shadowed.bytes()
    }

    /// Its shares of the GPU's memory (`engine::memory`): its lists' and its impostors', each
    /// against its own budget, and the rest of what it holds (`pool_bytes`), against the total.
    pub fn shares(self) -> Vec<Share> {
        Vec::from(
            [
                Share { name: "wood lists", bytes: self.list_bytes(), budget: memory::WOOD_LISTS },
                Share {
                    name: "impostors",
                    bytes: self.impostor_bytes(),
                    budget: memory::IMPOSTORS,
                },
                Share { name: "wood", bytes: self.pool_bytes(), budget: memory::TOTAL },
            ],
        )
    }

    /// Its kind `k`'s impostor read through net `nn` (its weights then its grid's, `w`) in place
    /// of its atlas (§B14.2); every kind's if `k` is `impostor::EVERY_KIND`.
    pub fn read_through(mut self, k: u32, nn: Neural, w: [Half2]) {
        self.net = buffer_of(w)
        self.neural = Neural { layer: k, on: 1, ..nn }
    }

    /// Over its budget (`usage`), it gives back its choosings' room sooner (`shrink_after`).
    pub fn pressed(mut self, usage: Usage) {
        self.shrink_after = memory::shrink_after(usage, default: SHRINK_AFTER)
    }

    /// All the kinds its instances name: its own and its far ones.
    pub fn all_kinds(self) -> u32 {
        self.kinds.len() + self.far_kinds.len()
    }

    /// The kind kind `k` is drawn as: its own, or a far kind's own.
    pub fn own(self, k: u32) -> u32 {
        if k < self.kinds.len() { k } else { self.far_kinds[k - self.kinds.len()] }
    }

    /// How kind `k`'s instances choose their level: a far kind's are past their cards from the
    /// first metre.
    pub fn lod(self, k: u32) -> Lod {
        borrow kind = self.kinds[self.own(k)]
        Lod {
            cards_to: if k < self.kinds.len() { self.cards_to } else { 1.0e-3 },
            cards_limit: if k < self.kinds.len() { self.cards_limit } else { 1.0e-3 },
            impostor_px: self.impostor_px,
            impostors_to: self.impostors_to,
            leaf: kind.plant.leaves.size,
            top: kind.top,
            reach: kind.reach,
            card_px: self.card_px,
            cell: self.cell,
        }
    }

    /// The kinds' levels, to the GPU (after a change of where they hand over).
    pub fn write_lods(mut self) {
        var l: Vec<Lod> = Vec::new()
        for k in 0..self.all_kinds() {
            l.push(self.lod(k))
        }
        if l.len() > 0 {
            write(mut self.lods, 0, l)
        }
    }

    /// The slot holding tile `t`'s own trees (or its far layer's, `far`), if they're loaded.
    pub fn slot_of(self, t: vec2i, far: bool = false) -> Option<u32> {
        for i in 0..self.slots.len() {
            if self.slots[i].tile == Some(t) && self.slots[i].far == far {
                return Some(i)
            }
        }
        None
    }

    /// Whether a slot is free.
    pub fn has_room(self) -> bool {
        for s in self.slots {
            if s.tile.is_none() {
                return true
            }
        }
        false
    }

    /// Loads tile `t`'s instances (at most `SLOT`; each an instance and its kind) into a free slot:
    /// false if there's none. A far layer's (`far`) name far kinds.
    pub fn load(
        mut self,
        t: vec2i,
        placed: [vegetation::Placed],
        far: bool = false,
        visibility: f32 = 1.0,
    ) -> bool {
        var free = self.slots.len()
        for i in 0..self.slots.len() {
            if self.slots[i].tile.is_none() {
                free = i
                break
            }
        }
        if free == self.slots.len() {
            return false
        }
        let n = min(placed.len(), SLOT)
        var at: Vec<Instance> = Vec::with_capacity(SLOT)
        var kinds: Vec<u32> = Vec::with_capacity(SLOT)
        var per: Vec<u32> = Vec::filled(self.all_kinds(), 0)
        for i in 0..n {
            at.push(of_kind(placed[i].at, placed[i].kind))
            kinds.push(placed[i].kind)
            per[placed[i].kind] += 1
        }
        while kinds.len() < SLOT {
            at.push(NO_INSTANCE)
            kinds.push(NO_KIND)
        }
        write(mut self.every, free * SLOT, at)
        write(mut self.metadata, free * SLOT, kinds)
        self.slots[free] = Slot { tile: Some(t), far, count: n, kinds: per, visibility }
        write(mut self.metadata, self.slots.len() * SLOT + free, [bitcast_u32(visibility)])
        self.laid = false
        true
    }

    /// Changes a tile's visible share without replacing its instances. Shadows keep their
    /// complete static casters; games finish the handover outside the near shadow cascade.
    pub fn show(mut self, t: vec2i, visibility: f32, far: bool = false) {
        if let Some(i) = self.slot_of(t, far) {
            let value = saturate(visibility)
            if self.slots[i].visibility != value {
                self.slots[i].visibility = value
                write(mut self.metadata, self.slots.len() * SLOT + i, [bitcast_u32(value)])
            }
        }
    }

    /// Every loaded instance moved by `d`: render space moved (the render origin by `-d`, whole
    /// tiles), so they stand where they stood in the world.
    pub fn shift(mut self, d: vec3) {
        if d == vec3(0.0) {
            return
        }
        label("wood shift")
        let n = self.slots.len() * SLOT
        dispatch(shift_instances.bind(mut self.every, d, n), over: n)
    }

    /// Drops tile `t`'s instances (or its far layer's, `far`), if they're loaded.
    pub fn drop(mut self, t: vec2i, far: bool = false) {
        if let Some(i) = self.slot_of(t, far) {
            write(mut self.metadata, i * SLOT, Vec::filled(SLOT, NO_KIND))
            self.slots[i] = Slot {
                tile: None,
                far: false,
                count: 0,
                kinds: Vec::filled(self.all_kinds(), 0),
                visibility: 1.0,
            }
            self.laid = false
        }
    }

    /// Every kind's loaded instances.
    fn per_kind(self) -> Vec<u32> {
        var out: Vec<u32> = Vec::filled(self.all_kinds(), 0)
        for s in self.slots {
            for k in 0..self.all_kinds() {
                out[k] += s.kinds[k]
            }
        }
        out
    }

    /// The instances loaded (the tiles' own, not the far layer's).
    pub fn loaded(self) -> u32 {
        var n = 0
        for s in self.slots {
            if !s.far {
                n += s.count
            }
        }
        n
    }

    fn lay_out(mut self) {
        if !self.laid {
            var per = self.per_kind()
            self.seen.lay_out(self.kinds, self.far_kinds, per, WAYS)
            // The far layer casts no shadow of its own (the cascades' trees are the tiles').
            for k in self.kinds.len()..self.all_kinds() {
                per[k] = 0
            }
            self.shadowed.lay_out(self.kinds, self.far_kinds, per, 1)
            // The loaded runs: each occupied slot's instances, numbered on.
            var runs: Vec<u32> = Vec::new()
            var total = 0
            for i in 0..self.slots.len() {
                if self.slots[i].count > 0 {
                    runs.push(total)
                    runs.push(i)
                    total += self.slots[i].count
                }
            }
            self.loaded_places = total
            self.runs = runs.len() / 2
            if runs.len() > 0 {
                write(mut self.metadata, self.slots.len() * (SLOT + 1), runs)
            }
            self.laid = true
        }
    }

    /// This frame's lists for `cam`, chosen on the GPU.
    pub fn select(mut self, cam: Camera, pyramid: Texture<R32Float>, hzb: Hzb) {
        self.lay_out()
        let corner = cam.corner_angle()
        let c = Choose {
            cam,
            corner,
            kinds: self.all_kinds(),
            shadow: 0,
            instances: self.slots.len() * SLOT,
            square: vec4(0.0),
            loaded: self.loaded_places,
            runs: self.runs,
            lists: 0,
            late_at: 0,
            hzb,
        }
        self.seen.run(c, self.every, self.metadata, self.lods, pyramid, self.shrink_after)
        self.chose = Some(c)
    }

    /// The lists for a shadow cascade: every instance within the square `lo` to `hi` (x, z).
    pub fn select_shadow(mut self, cam: Camera, lo: vec2, hi: vec2) {
        self.lay_out()
        let c = Choose {
            cam,
            corner: 0.0,
            kinds: self.all_kinds(),
            shadow: 1,
            instances: self.slots.len() * SLOT,
            square: vec4(lo, hi),
            loaded: self.loaded_places,
            runs: self.runs,
            lists: 0,
            late_at: 0,
            hzb: NO_HZB,
        }
        self.shadowed.run(
            c,
            self.every,
            self.metadata,
            self.lods,
            self.no_pyramid,
            self.shrink_after,
        )
    }

    /// The second phase (`cull`): what `select` left out as hidden behind last frame's depth,
    /// tested against `pyramid` (this frame's, built after the first phase's opaque passes:
    /// `hzb`), chosen into the second phase's lists for `late_prepass` and `late_shade`.
    pub fn reveal(mut self, pyramid: Texture<R32Float>, hzb: Hzb) {
        if let Some(c) = self.chose {
            self.seen.reveal(Choose { hzb, ..c }, self.every, self.metadata, self.lods, pyramid)
        }
    }

    /// The cards' draw state of way `way` (a card level), seen by `cam`: each kind's leaves
    /// (`per_card` 0: the kind's own, `KindDesc`).
    fn card_draw_of(self, way: u32, cam: Camera, wind: Wind) -> CardDraw {
        let d = card_draw(wind, way, Leaves { per_card: 0 }, cam.right, cam.up, self.cell, way)
        CardDraw { clear: self.clear, ..d }
    }

    /// The draws of way `way`'s lists (a kind each, one after another: `Chosen::lay_out`) in
    /// `args`.
    fn of_way<T: GpuData>(self, args: GpuBuffer<T>, way: u32) -> GpuSpan<T> {
        let n = self.all_kinds()
        args.span(start: way * n, count: n)
    }

    /// The depth prepass's cards: each card level's lists, cut, into the depth target alone,
    /// one multi-draw a level over every kind. Then `prepass_far`.
    pub fn prepass_cards<P: RenderPass>(self, pass: P, cam: Camera, wind: Wind, s: Sampler) {
        self.cards_prepass(pass, cam, wind, s, late: false)
    }

    /// The second phase's depth prepass (`reveal`'s): its cards and its far crowns.
    pub fn late_prepass<P: RenderPass>(self, pass: P, cam: Camera, wind: Wind, s: Sampler) {
        self.cards_prepass(pass, cam, wind, s, late: true)
        self.far_prepass(pass, cam, wind, s, late: true)
    }

    /// A phase's cards in the depth prepass (`late`: the second's).
    fn cards_prepass<P: RenderPass>(
        self,
        pass: P,
        cam: Camera,
        wind: Wind,
        s: Sampler,
        late: bool,
    ) {
        borrow ph = if late { self.seen.late } else { self.seen.early }
        let n = self.all_kinds()
        for way in 0..CARD_LEVELS {
            if !self.seen.way_has(way, n) {
                continue
            }
            let d = self.card_draw_of(way, cam, wind)
            let vertex = card.bind(
                cam,
                d,
                kinds: self.pool.kinds,
                cards: self.pool.cards,
                instances: ph.instances.span(start: 0, count: self.seen.places),
                marks: ph.marks.span(start: 0, count: self.seen.places),
                outlines: self.outlines,
                orders: self.pool.orders,
            )
            match self.leaf_support {
                Some(support) => draw_multi(
                    pass,
                    vertex,
                    leaf_cut_supported.bind(
                        d,
                        kinds: self.pool.kinds,
                        atlas: self.atlas,
                        s: s,
                        support: support,
                    ),
                    indices: self.card_triangles,
                    indirect: self.of_way(ph.cards, way),
                    count: n,
                    depth: NEAREST,
                ),
                None => draw_multi(
                    pass,
                    vertex,
                    leaf_cut.bind(d, kinds: self.pool.kinds, atlas: self.atlas, s: s),
                    indices: self.card_triangles,
                    indirect: self.of_way(ph.cards, way),
                    count: n,
                    depth: NEAREST,
                ),
            }
        }
    }

    /// The depth prepass's far crowns: their cut quads (impostors and volumes), after
    /// `prepass_cards`: one multi-draw a way over every kind.
    pub fn prepass_far<P: RenderPass>(self, pass: P, cam: Camera, wind: Wind, s: Sampler) {
        self.far_prepass(pass, cam, wind, s, late: false)
    }

    /// A phase's far crowns in the depth prepass (`late`: the second's).
    fn far_prepass<P: RenderPass>(self, pass: P, cam: Camera, wind: Wind, s: Sampler, late: bool) {
        borrow ph = if late { self.seen.late } else { self.seen.early }
        let n = self.all_kinds()
        if self.seen.way_has(IMPOSTOR, n) {
            match self.pool.impostors {
                Impostors::Plain { colour: c, .. } => self.impostors_prepass(
                    pass,
                    cam,
                    wind,
                    s,
                    ph,
                    c,
                ),
                Impostors::Compressed { colour: c, .. } => {
                    self.impostors_prepass(pass, cam, wind, s, ph, c)
                },
                Impostors::Paged { data } => {
                    draw_multi(
                        pass,
                        far_quad.bind(
                            cam,
                            wind,
                            kinds: self.pool.kinds,
                            instances: ph.instances.span(start: 0, count: self.seen.places),
                            marks: ph.marks.span(start: 0, count: self.seen.places),
                            bounds: self.pool.bounds,
                            front: 0,
                        ),
                        page_cut_flat.bind(
                            kinds: self.pool.kinds,
                            colour: data.colour,
                            pages: data.map,
                            s: s,
                            cell: self.cell,
                        ),
                        indirect: self.of_way(ph.far, IMPOSTOR),
                        count: n,
                        depth: NEAREST,
                    )
                },
                Impostors::Source { data } => {
                    draw_multi(
                        pass,
                        far_quad.bind(
                            cam,
                            wind,
                            kinds: self.pool.kinds,
                            instances: ph.instances.span(start: 0, count: self.seen.places),
                            marks: ph.marks.span(start: 0, count: self.seen.places),
                            bounds: self.pool.bounds,
                            front: 0,
                        ),
                        identity_cut_flat.bind(
                            kinds: self.pool.kinds,
                            pages: data.data,
                            cell: self.cell,
                        ),
                        indirect: self.of_way(ph.far, IMPOSTOR),
                        count: n,
                        depth: NEAREST,
                    )
                },
            }
        }
        if self.seen.way_has(VOLUME, n) {
            draw_multi(
                pass,
                far_quad.bind(
                    cam,
                    wind,
                    kinds: self.pool.kinds,
                    instances: ph.instances.span(start: 0, count: self.seen.places),
                    marks: ph.marks.span(start: 0, count: self.seen.places),
                    bounds: self.pool.bounds,
                    front: 0,
                ),
                volume_cut.bind(
                    cam,
                    kinds: self.pool.kinds,
                    grid: self.pool.grid,
                    grid_depth: self.pool.grid_depth,
                    s: s,
                    cell: self.cell,
                ),
                indirect: self.of_way(ph.far, VOLUME),
                count: n,
                depth: NEAREST,
            )
        }
    }

    /// A phase's (`ph`) impostors in the depth prepass, cut to their coverage in `c` (the pool's
    /// colour, of whichever format: `Impostors`).
    fn impostors_prepass<P: RenderPass, C: Format + Filtered>(
        self,
        pass: P,
        cam: Camera,
        wind: Wind,
        s: Sampler,
        ph: Phase,
        c: TextureArray<C>,
    ) {
        let n = self.all_kinds()
        draw_multi(
            pass,
            far_quad.bind(
                cam,
                wind,
                kinds: self.pool.kinds,
                instances: ph.instances.span(start: 0, count: self.seen.places),
                marks: ph.marks.span(start: 0, count: self.seen.places),
                bounds: self.pool.bounds,
                front: 0,
            ),
            far_cut_flat.bind(
                kinds: self.pool.kinds,
                colour: c,
                s: s,
                cell: self.cell,
                nn: self.neural,
                net: self.net,
            ),
            indirect: self.of_way(ph.far, IMPOSTOR),
            count: n,
            depth: NEAREST,
        )
    }

    /// The shading pass's draws: the cards where the prepass left their depth, the limbs, then
    /// the far instances: one multi-draw a way over every kind.
    pub fn shade<P: RenderPass>(self, pass: P, lt: Lighting, wind: Wind, ids: Texture<R32Uint>) {
        self.phase_shade(pass, lt, wind, ids, late: false)
    }

    /// The second phase's shading (`reveal`'s), as `shade`'s.
    pub fn late_shade<P: RenderPass>(
        self,
        pass: P,
        lt: Lighting,
        wind: Wind,
        ids: Texture<R32Uint>,
    ) {
        self.phase_shade(pass, lt, wind, ids, late: true)
    }

    /// A phase's shading draws (`late`: the second's).
    fn phase_shade<P: RenderPass>(
        self,
        pass: P,
        lt: Lighting,
        wind: Wind,
        ids: Texture<R32Uint>,
        late: bool,
    ) {
        borrow ph = if late { self.seen.late } else { self.seen.early }
        let cam = lt.cam
        let n = self.all_kinds()
        for way in 0..CARD_LEVELS {
            if !self.seen.way_has(way, n) {
                continue
            }
            let d = self.card_draw_of(way, cam, wind)
            draw_multi(
                pass,
                card.bind(
                    cam,
                    d,
                    kinds: self.pool.kinds,
                    cards: self.pool.cards,
                    instances: ph.instances.span(start: 0, count: self.seen.places),
                    marks: ph.marks.span(start: 0, count: self.seen.places),
                    outlines: self.outlines,
                    orders: self.pool.orders,
                ),
                leaf_shade.bind(
                    kinds: self.pool.kinds,
                    cards: self.pool.cards,
                    instances: ph.instances.span(start: 0, count: self.seen.places),
                    lt: lt,
                    atlas: self.atlas,
                ),
                indices: self.card_triangles,
                indirect: self.of_way(ph.cards, way),
                count: n,
                depth: PREPASSED,
            )
        }
        for way in 0..CARD_LEVELS {
            if !self.seen.way_has(way, n) {
                continue
            }
            draw_multi(
                pass,
                limb.bind(
                    cam,
                    kinds: self.pool.kinds,
                    limbs: self.pool.limbs,
                    instances: ph.instances.span(start: 0, count: self.seen.places),
                    marks: ph.marks.span(start: 0, count: self.seen.places),
                ),
                bark_shade.bind(
                    lt,
                    kinds: self.pool.kinds,
                    ridges: self.ridges,
                    coarse: self.coarse,
                    rs: self.repeat,
                ),
                indices: self.limb_triangles,
                indirect: self.of_way(ph.limbs, way),
                count: n,
                cull: std::gpu::Cull::Back,
                depth: NEAREST,
            )
        }
        if self.seen.way_has(IMPOSTOR, n) {
            match self.pool.impostors {
                Impostors::Plain { colour: c, normal: nm, depth: d } => {
                    self.impostors_shade(pass, lt, wind, ids, ph, c, nm, d)
                },
                Impostors::Compressed { colour: c, normal: nm, depth: d } => {
                    self.impostors_shade(pass, lt, wind, ids, ph, c, nm, d)
                },
                Impostors::Paged { data } => {
                    draw_multi(
                        pass,
                        far_quad.bind(
                            cam,
                            wind,
                            kinds: self.pool.kinds,
                            instances: ph.instances.span(start: 0, count: self.seen.places),
                            marks: ph.marks.span(start: 0, count: self.seen.places),
                            bounds: self.pool.bounds,
                            front: 0,
                        ),
                        page_shade.bind(
                            lt,
                            ids,
                            kinds: self.pool.kinds,
                            colour: data.colour,
                            normal: data.normal,
                            depth: data.depth,
                            pages: data.map,
                            grid: self.pool.grid,
                        ),
                        indirect: self.of_way(ph.far, IMPOSTOR),
                        count: n,
                        depth: PREPASSED,
                    )
                },
                Impostors::Source { data } => {
                    draw_multi(
                        pass,
                        far_quad.bind(
                            cam,
                            wind,
                            kinds: self.pool.kinds,
                            instances: ph.instances.span(start: 0, count: self.seen.places),
                            marks: ph.marks.span(start: 0, count: self.seen.places),
                            bounds: self.pool.bounds,
                            front: 0,
                        ),
                        identity_shade.bind(
                            lt,
                            ids,
                            kinds: self.pool.kinds,
                            cards: self.pool.cards,
                            limbs: self.pool.limbs,
                            pages: data.data,
                            grid: self.pool.grid,
                        ),
                        indirect: self.of_way(ph.far, IMPOSTOR),
                        count: n,
                        depth: PREPASSED,
                    )
                },
            }
        }
        if self.seen.way_has(VOLUME, n) {
            draw_multi(
                pass,
                far_quad.bind(
                    cam,
                    wind,
                    kinds: self.pool.kinds,
                    instances: ph.instances.span(start: 0, count: self.seen.places),
                    marks: ph.marks.span(start: 0, count: self.seen.places),
                    bounds: self.pool.bounds,
                    front: 1,
                ),
                volume_shade.bind(
                    lt,
                    ids,
                    kinds: self.pool.kinds,
                    grid: self.pool.grid,
                    grid_depth: self.pool.grid_depth,
                ),
                indirect: self.of_way(ph.far, VOLUME),
                count: n,
                depth: impostor::SHADED,
            )
        }
    }

    /// A phase's (`ph`) impostors shaded, from the pool's colour, normals and toward-and-depth
    /// (`c`, `nm`, `d`: of whichever formats, `Impostors`).
    /// Flat impostors use the prepass's exact depth to reject uncovered and hidden pixels
    /// early; keep the winning-ID check for coincident surfaces.
    fn impostors_shade<P: RenderPass, C: Format + Filtered, N: Format>(
        self,
        pass: P,
        lt: Lighting,
        wind: Wind,
        ids: Texture<R32Uint>,
        ph: Phase,
        c: TextureArray<C>,
        nm: TextureArray<N>,
        d: TextureArray<N>,
    ) {
        let cam = lt.cam
        let n = self.all_kinds()
        draw_multi(
            pass,
            far_quad.bind(
                cam,
                wind,
                kinds: self.pool.kinds,
                instances: ph.instances.span(start: 0, count: self.seen.places),
                marks: ph.marks.span(start: 0, count: self.seen.places),
                bounds: self.pool.bounds,
                front: 0,
            ),
            far_shade.bind(
                lt,
                ids,
                kinds: self.pool.kinds,
                colour: c,
                normal: nm,
                depth: d,
                grid: self.pool.grid,
                nn: self.neural,
                net: self.net,
            ),
            indirect: self.of_way(ph.far, IMPOSTOR),
            count: n,
            depth: PREPASSED,
        )
    }

    /// A shadow cascade's draws, of what `select_shadow` chose: every kind's cards at level 1,
    /// facing the sun, cut to their leaves, and its limbs: a multi-draw each over every kind.
    pub fn shadow<P: RenderPass>(self, pass: P, view: mat4, sh: Shadows, wind: Wind, s: Sampler) {
        let n = self.all_kinds()
        if !self.shadowed.way_has(0, n) {
            return
        }
        let instances = self.shadowed.early.instances.span(start: 0, count: self.shadowed.places)
        let leaves = Leaves { per_card: SHADOW_LEAVES }
        let d = card_draw(wind, 1, leaves, sh.right, sh.up, self.cell, ALL)
        draw_multi(
            pass,
            card_shadow.bind(
                view,
                d,
                kinds: self.pool.kinds,
                cards: self.pool.cards,
                instances: instances,
                outlines: self.outlines,
            ),
            leaf_cut.bind(d, kinds: self.pool.kinds, atlas: self.atlas, s: s),
            indices: self.card_triangles,
            indirect: self.of_way(self.shadowed.early.cards, 0),
            count: n,
            depth_bias: CASTER,
        )
        draw_multi(
            pass,
            limb_shadow.bind(
                view,
                kinds: self.pool.kinds,
                limbs: self.pool.limbs,
                instances: instances,
            ),
            nothing,
            indices: self.limb_triangles,
            indirect: self.of_way(self.shadowed.early.limbs, 0),
            count: n,
            depth_bias: CASTER,
        )
    }
}

/// A choosing's room shrinks once its places fill less than half of it for `SHRINK_AFTER`
/// frames, not before, and not while they fill half.
@test
fn a_half_empty_choosing_shrinks_after_a_while() {
    assert(shrinks(places: 100, room: 300, under: SHRINK_AFTER), "a third-full room didn't shrink")
    assert(!shrinks(places: 100, room: 300, under: SHRINK_AFTER - 1), "it shrank early")
    assert(!shrinks(places: 160, room: 300, under: SHRINK_AFTER), "a half-full room shrank")
}
