{
  "name": "wrela",
  "displayName": "Wrela",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:wrela"
  ],
  "contributes": {
    "configurationDefaults": {
      "[wrela]": {
        "editor.semanticHighlighting.enabled": false,
        "editor.suggest.completeFunctionCalls": false,
        "editor.wordBasedSuggestions": "off",
        "editor.codeLens": false,
        "editor.lineHeight": 0,
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "punctuation.separator.wrela",
              "settings": {
                "foreground": "#D4D4D4"
              }
            }
          ]
        }
      }
    },
    "languages": [
      {
        "id": "wrela",
        "aliases": [
          "Wrela",
          "wrela"
        ],
        "extensions": [
          ".wr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wrela",
        "scopeName": "source.wrela",
        "path": "./syntaxes/wrela.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "wrela.codeLens.showReferences",
        "title": "Wrela: Show References Info"
      },
      {
        "command": "wrela.goToTypeDefinitionClient",
        "title": "Wrela: Go To Type Definition"
      },
      {
        "command": "wrela.peekTypeDefinitionClient",
        "title": "Wrela: Peek Type Definition"
      },
      {
        "command": "wrela.smokeTest.openGuide",
        "title": "Wrela: Open Smoke Test Guide"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Wrela",
      "properties": {
        "wrela.languageServer.command": {
          "type": "string",
          "default": "",
          "description": "Command to launch the Wrela language server."
        },
        "wrela.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the Wrela language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
