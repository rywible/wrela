{
  "name": "wrela",
  "displayName": "Wrela",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configurationDefaults": {
      "[wrela]": {
        "editor.semanticHighlighting.enabled": false,
        "editor.suggest.completeFunctionCalls": false,
        "editor.wordBasedSuggestions": "off",
        "editor.codeLens": false,
        "editor.lineHeight": 0,
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "punctuation.separator.wrela",
              "settings": {
                "foreground": "#D4D4D4"
              }
            }
          ]
        }
      }
    },
    "languages": [
      {
        "id": "wrela",
        "aliases": [
          "Wrela",
          "wrela"
        ],
        "extensions": [
          ".wr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "wrela",
        "scopeName": "source.wrela",
        "path": "./syntaxes/wrela.tmLanguage.json"
      }
    ]
  }
}
