{
  "name": "Wrela",
  "scopeName": "source.wrela",
  "fileTypes": [
    "wr"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#has_statement"
    },
    {
      "include": "#field_definitions"
    },
    {
      "include": "#return_type"
    },
    {
      "include": "#detach_pool"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#named_argument"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "definitions": {
      "patterns": [
        {
          "include": "#class_definition"
        },
        {
          "include": "#function_definition"
        },
        {
          "include": "#method_definition"
        }
      ]
    },
    "class_definition": {
      "match": "\\b(?:(public|private)\\s+)?(A|An)\\s+([_\\p{L}][_\\p{L}\\p{N}]*)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.wrela"
        },
        "2": {
          "name": "storage.type.wrela"
        },
        "3": {
          "name": "entity.name.type.wrela"
        }
      }
    },
    "has_statement": {
      "match": "\\b(?:(public|private)\\s+)?(has)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.wrela"
        },
        "2": {
          "name": "storage.type.wrela"
        }
      }
    },
    "function_definition": {
      "begin": "\\b(?:(public|private)\\s+)?(to)\\s+([_\\p{L}][_\\p{L}\\p{N}]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.wrela"
        },
        "2": {
          "name": "storage.type.wrela"
        },
        "3": {
          "name": "entity.name.function.wrela"
        },
        "4": {
          "name": "punctuation.bracket.wrela"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.wrela"
        }
      },
      "patterns": [
        {
          "include": "#parameter"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "method_definition": {
      "begin": "\\b(?:(public|private)\\s+)?(can)\\s+([_\\p{L}][_\\p{L}\\p{N}]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.wrela"
        },
        "2": {
          "name": "storage.type.wrela"
        },
        "3": {
          "name": "entity.name.function.method.wrela"
        },
        "4": {
          "name": "punctuation.bracket.wrela"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.wrela"
        }
      },
      "patterns": [
        {
          "include": "#parameter"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "field_definitions": {
      "patterns": [
        {
          "begin": "(?m)^\\s*(?:(public|private)\\s+)?(?!A\\b|An\\b|has\\b|can\\b|to\\b|public\\b|private\\b|changing\\b|if\\b|else\\b|while\\b|for\\b|in\\b|return\\b|break\\b|continue\\b|match\\b|otherwise\\b|use\\b|from\\b|optimize\\b|and\\b|or\\b|not\\b|await\\b|detach\\b|spawn\\b|fire\\b|err\\b|crash\\b|true\\b|false\\b|nothing\\b|nil\\b|it\\b|its\\b|n\\b|so\\b)([_\\p{L}][_\\p{L}\\p{N}]*)\\s*(:)\\s*",
          "beginCaptures": {
            "1": {
              "name": "storage.modifier.wrela"
            },
            "2": {
              "name": "variable.other.member.wrela"
            },
            "3": {
              "name": "punctuation.separator.wrela"
            }
          },
          "end": "(?=$|\\n)",
          "patterns": [
            {
              "include": "#type"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            }
          ]
        }
      ]
    },
    "parameter": {
      "begin": "\\b([_\\p{L}][_\\p{L}\\p{N}]*)\\s*(:)\\s*",
      "beginCaptures": {
        "1": {
          "name": "variable.parameter.wrela"
        },
        "2": {
          "name": "punctuation.separator.wrela"
        }
      },
      "end": "(?=,|\\))",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "return_type": {
      "begin": "(->)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.arrow.wrela"
        }
      },
      "end": "(?=\\s*:)",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "detach_pool": {
      "patterns": [
        {
          "begin": "\\b(detach)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.wrela"
            }
          },
          "end": "$",
          "patterns": [
            {
              "match": "(\\*)(\\s*)(n)\\b",
              "captures": {
                "1": {
                  "name": "keyword.operator.arithmetic.wrela"
                },
                "3": {
                  "name": "keyword.control.wrela"
                }
              }
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#function_calls"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#identifiers"
            }
          ]
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([A-Z][_\\p{L}\\p{N}]*)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.type.wrela"
            }
          }
        },
        {
          "match": "(\\.)\\s*([_\\p{L}][_\\p{L}\\p{N}]*)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.wrela"
            },
            "2": {
              "name": "entity.name.function.method.wrela"
            }
          }
        },
        {
          "match": "\\b(?!A\\b|An\\b|has\\b|can\\b|to\\b|public\\b|private\\b|changing\\b|if\\b|else\\b|while\\b|for\\b|in\\b|return\\b|break\\b|continue\\b|match\\b|otherwise\\b|use\\b|from\\b|optimize\\b|and\\b|or\\b|not\\b|await\\b|detach\\b|spawn\\b|fire\\b|err\\b|crash\\b|true\\b|false\\b|nothing\\b|nil\\b|it\\b|its\\b|n\\b)([_\\p{L}][_\\p{L}\\p{N}]*)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.wrela"
            }
          }
        }
      ]
    },
    "function_calls_in_interpolation": {
      "patterns": [
        {
          "match": "\\b([A-Z][_\\p{L}\\p{N}]*)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.type.wrela"
            }
          }
        },
        {
          "match": "(\\.)\\s*([_\\p{L}][_\\p{L}\\p{N}]*)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.separator.wrela"
            },
            "2": {
              "name": "entity.name.function.method.wrela"
            }
          }
        },
        {
          "match": "\\b(?!A\\b|An\\b|has\\b|can\\b|to\\b|public\\b|private\\b|changing\\b|if\\b|else\\b|while\\b|for\\b|in\\b|return\\b|break\\b|continue\\b|match\\b|otherwise\\b|use\\b|from\\b|optimize\\b|and\\b|or\\b|not\\b|await\\b|detach\\b|spawn\\b|fire\\b|err\\b|crash\\b|true\\b|false\\b|nothing\\b|nil\\b|it\\b|its\\b|n\\b)([_\\p{L}][_\\p{L}\\p{N}]*)\\b(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.wrela"
            }
          }
        }
      ]
    },
    "interpolation_punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.wrela",
          "match": "\\."
        },
        {
          "name": "punctuation.brackets.wrela",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.comma.wrela",
          "match": ","
        }
      ]
    },
    "named_argument": {
      "name": "variable.parameter.wrela",
      "match": "\\b([_\\p{L}][_\\p{L}\\p{N}]*)\\b(?=\\s*=)"
    },
    "identifiers": {
      "name": "variable.other.wrela",
      "match": "\\b(?!A\\b|An\\b|has\\b|can\\b|to\\b|public\\b|private\\b|changing\\b|if\\b|else\\b|while\\b|for\\b|in\\b|return\\b|break\\b|continue\\b|match\\b|otherwise\\b|use\\b|from\\b|optimize\\b|and\\b|or\\b|not\\b|await\\b|detach\\b|spawn\\b|fire\\b|err\\b|crash\\b|true\\b|false\\b|nothing\\b|nil\\b|it\\b|its\\b|n\\b)[_\\p{L}][_\\p{L}\\p{N}]*\\b"
    },
    "type": {
      "patterns": [
        {
          "include": "#type_ref"
        },
        {
          "include": "#type_args"
        }
      ]
    },
    "type_ref": {
      "name": "entity.name.type.wrela",
      "match": "\\b[_\\p{L}][_\\p{L}\\p{N}]*\\b"
    },
    "type_args": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.bracket.wrela"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.wrela"
        }
      },
      "patterns": [
        {
          "include": "#type_ref"
        },
        {
          "include": "#type_args"
        },
        {
          "name": "punctuation.separator.comma.wrela",
          "match": ","
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.wrela",
          "begin": "(?m)^(\\s*)so:.*$",
          "while": "(?m)^(?:\\1\\s+.*|\\s*$)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wrela",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wrela",
              "match": "\\\\(?:[nrt\"\\\\{}])"
            },
            {
              "name": "constant.character.escape.invalid.wrela",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.wrela",
          "contentName": "source.wrela.interpolated",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.brackets.wrela"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.brackets.wrela"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#interpolation_punctuation"
        },
        {
          "include": "#function_calls_in_interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.wrela",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.wrela",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.wrela",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.wrela",
          "match": "(?:\\b\\d[\\d_]*\\.\\d[\\d_]*|\\B\\.\\d[\\d_]+)(?:[eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.float.wrela",
          "match": "\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.wrela",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wrela",
          "match": "\\b(?:public|private|changing|if|else|while|for|in|return|break|continue|match|otherwise|use|from|optimize|await|detach|spawn|fire|err|crash|latency|throughput|conservation|balance)\\b"
        },
        {
          "name": "keyword.control.wrela",
          "match": "\\b(?:its|it|n)\\b"
        },
        {
          "name": "keyword.operator.wrela",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "constant.language.wrela",
          "match": "\\b(?:true|false|nothing|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.wrela",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.comparison.wrela",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.wrela",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.wrela",
          "match": "<<|>>|~|&|\\||\\^"
        },
        {
          "name": "keyword.operator.range.wrela",
          "match": "\\.\\.\\."
        },
        {
          "name": "punctuation.definition.arrow.wrela",
          "match": "->"
        },
        {
          "name": "punctuation.separator.wrela",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.wrela",
          "match": ","
        },
        {
          "name": "punctuation.accessor.wrela",
          "match": "\\."
        },
        {
          "name": "punctuation.brackets.wrela",
          "match": "[()\\[\\]{}]"
        },
        {
          "name": "punctuation.definition.at.wrela",
          "match": "@"
        }
      ]
    }
  }
}
