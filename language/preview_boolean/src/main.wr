field exact distance ground(p: Vec3) -> F32 {
    plane(normal=vec3(0.0, 1.0, 0.0), offset=1.1)
}

field conservative distance wall_panel(p: Vec3) -> F32 {
    extrude = f32(0.36) {
        rounded_rect2(half = vec2(1.45, 1.08), radius = 0.12)
    }
}

field conservative distance door_cut(p: Vec3) -> F32 {
    translate = vec3(0.0, -0.34, 0.0) {
        extrude = f32(0.52) {
            rect2(half = vec2(0.34, 0.60))
        }
    }
}

field conservative distance arch_cut(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.28, 0.0) {
        extrude = f32(0.52) {
            circle2(radius = 0.34)
        }
    }
}

field conservative distance relief_cut(p: Vec3) -> F32 {
    translate = vec3(0.78, 0.10, 0.0) {
        extrude = f32(0.52) {
            polygon2(vertices = [
                vec2(-0.16, -0.48),
                vec2(0.24, -0.18),
                vec2(0.18, 0.40),
                vec2(-0.22, 0.28)
            ])
        }
    }
}

field conservative distance arch_wall(p: Vec3) -> F32 {
    subtract {
        provenance_policy = left
        use wall_panel
        union {
            provenance_policy = nearest
            use door_cut
            use arch_cut
            use relief_cut
        }
    }
}

field conservative distance lintel(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.74, 0.0) {
        sweep = vec3(1.95, 0.0, 0.0) {
            rect2(half = vec2(0.10, 0.10))
        }
    }
}

field conservative distance brace(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.18, 0.0) {
        sweep = vec3(1.7, 0.0, 0.0) {
            segment2(a = vec2(-0.20, 0.0), b = vec2(0.20, 0.0))
        }
    }
}

field conservative distance scene(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use arch_wall
        use lintel
        use brace
        use ground
    }
}

radiance field scene_radiance(p: Vec3, direction: Vec3, feature_id: U32) -> Vec3 {
    sky_t = clamp(0.5 + direction.y * 0.5, 0.0, 1.0)
    carve = clamp(0.24 - abs(p.x) * 0.18 - abs(p.y) * 0.10, 0.0, 0.24) / 0.24
    return vec3(12.0, 14.0, 22.0) * (1.0 - sky_t)
        + vec3(54.0, 82.0, 124.0) * sky_t
        + vec3(14.0, 8.0, 4.0) * carve
}

volume field scene_volume(p: Vec3, surface_distance: F32) -> Medium {
    doorway = clamp(0.24 - abs(p.x) * 0.16, 0.0, 0.24) / 0.24
    near_surface = clamp((0.12 - abs(surface_distance)) * 6.0, 0.0, 1.0)
    density = clamp(0.012 + doorway * 0.018 + near_surface * 0.016, 0.0, 0.08)
    return Medium(
        density=density,
        emission=vec3(3.0, 3.5, 5.0) * density + vec3(0.0, 0.01, 0.02) * near_surface,
        anisotropy=0.08
    )
}

material boolean_surface(hit: Hit3) -> Surface {
    panel = clamp(abs(hit.local_position.x) * 0.35 + abs(hit.local_position.y) * 0.2, 0.0, 1.0)
    return Surface(
        albedo=vec3(196.0, 160.0, 112.0) + vec3(24.0, 18.0, 12.0) * panel,
        roughness=0.18 + panel * 0.18,
        metalness=0.10 + clamp(hit.local_normal.z, 0.0, 1.0) * 0.10,
        clearcoat=0.10 + clamp(hit.local_normal.y, 0.0, 1.0) * 0.18,
        clearcoat_roughness=0.08 + abs(hit.local_position.x) * 0.10,
        sheen=0.04 + abs(hit.local_normal.x) * 0.12,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material accent_surface(hit: Hit3) -> Surface {
    rib = clamp(abs(hit.local_position.x) * 0.5 + abs(hit.local_normal.y) * 0.4, 0.0, 1.0)
    return Surface(
        albedo=vec3(92.0, 136.0, 186.0) + vec3(14.0, 18.0, 20.0) * rib,
        roughness=0.12 + abs(hit.local_position.y) * 0.12,
        metalness=0.14 + rib * 0.22,
        clearcoat=0.18 + rib * 0.18,
        clearcoat_roughness=0.10 + (1.0 - rib) * 0.14,
        sheen=0.08 + abs(hit.local_normal.x) * 0.18,
        emissive=vec3(2.5, 3.0, 4.5) * clamp(hit.local_normal.y, 0.0, 1.0)
    )
}

material ground_surface(hit: Hit3) -> Surface {
    dust = clamp(abs(hit.local_position.x) * 0.18 + abs(hit.local_position.z) * 0.18, 0.0, 1.0)
    return Surface(
        albedo=vec3(66.0, 74.0, 86.0) + vec3(8.0, 7.0, 6.0) * dust,
        roughness=0.90 + dust * 0.08,
        metalness=0.0,
        clearcoat=0.03,
        clearcoat_roughness=0.22,
        sheen=0.02,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape left_shape {
    field = arch_wall
    material = boolean_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(1),
        material_id=u32(1),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape right_shape {
    field = brace
    material = accent_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(2),
        material_id=u32(2),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape bridge_shape {
    field = lintel
    material = accent_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(4),
        material_id=u32(4),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape ground_shape {
    field = ground
    material = ground_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(3),
        material_id=u32(3),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape scene_shape {
    union {
        provenance_policy = nearest
        use left_shape
        use right_shape
        use bridge_shape
        use ground_shape
    }
}

region scene_region() {
    place coarse = scene_shape
    place fine = scene_shape
}

domain scene_domain(world: RegionCapture) {
    geometry_detail = 1
    material = true
    radiance = true
    media = true
    max_distance = 6.0
    min_step = 0.1
    hit_epsilon = 0.0008
    max_steps = 96
}

view main_view(
    world: RegionCapture,
    camera: Camera
) {
    domain = scene_domain(world = world)
    viewport = viewport(width = 8, height = 8)
    quality = realtime_quality(target_fps = 60)
    lighting = key_light(
        light = Light(
            position=vec3(2.8, 3.4, 2.2),
            direction=normalize(vec3(-0.8, -0.9, -0.9)),
            intensity=vec3(1.0, 0.98, 0.94),
            range=14.0
        ),
        fill_direction = normalize(vec3(-0.7, 0.4, 0.2))
    )
    outputs = frame_outputs(color = true, depth = true, normal = true, motion = true)
    history = temporal_history(color = true)
}
