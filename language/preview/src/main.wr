use print_line from host/io

field conservative distance cube(p: Vec3) -> F32 {
    yaw_c = cos(0.7)
    yaw_s = sin(0.7)
    spun = vec3(p.x * yaw_c + p.z * yaw_s, p.y, p.z * yaw_c - p.x * yaw_s)
    pitch_c = cos(-0.45)
    pitch_s = sin(-0.45)
    local = vec3(
        spun.x,
        spun.y * pitch_c - spun.z * pitch_s,
        spun.y * pitch_s + spun.z * pitch_c
    )
    abs_p = vec3(abs(local.x), abs(local.y), abs(local.z))
    q = abs_p - vec3(0.65, 0.65, 0.65)
    outside = length(max(q, vec3(0.0, 0.0, 0.0)))
    inside = min(max(q.x, max(q.y, q.z)), 0.0)
    return outside + inside
}

field exact distance ground(p: Vec3) -> F32 {
    plane(normal=vec3(0.0, 1.0, 0.0), offset=0.95)
}

field conservative distance scene(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use cube
        use ground
    }
}

material cube_surface(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(214.0, 180.0, 130.0),
        roughness=0.25,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material ground_surface(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(74.0, 80.0, 94.0),
        roughness=0.95,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape cube_shape {
    field = cube
    material = cube_surface
    payload = Payload(
        entity_id=u64(1),
        material_id=u64(1),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape ground_shape {
    field = ground
    material = ground_surface
    payload = Payload(
        entity_id=u64(2),
        material_id=u64(2),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape scene_shape {
    union {
        provenance_policy = nearest
        use cube_shape
        use ground_shape
    }
}

fn compute_scene_surface(scene_capture: ShapeCapture, hit: Hit3) -> Surface {
    return surface_at(capture=scene_capture, hit=hit)
}

fn compute_scene_hit(scene_capture: ShapeCapture, origin: Vec3, direction: Vec3) -> Hit3 {
    return trace_shape(
        capture=scene_capture,
        origin=origin,
        direction=direction,
        max_distance=12.0,
        min_step=0.02,
        hit_epsilon=0.0008,
        max_steps=192
    )
}

fn compute_shadow_visibility(
    scene_capture: ShapeCapture,
    hit_position: Vec3,
    hit_normal: Vec3,
    light: Light
) -> F32 {
    shadow_origin = hit_position + hit_normal * 0.01
    shadow_direction = normalize(light.position - shadow_origin)
    shadow_limit = length(light.position - shadow_origin)
    mutable total = 0.02
    mutable step_count = 0
    while total < shadow_limit and step_count < 96 {
        sample_position = shadow_origin + shadow_direction * total
        sampled_distance = distance_at(capture=scene_capture, point=sample_position)
        if sampled_distance < 0.001 {
            return 0.0
        }
        total += max(sampled_distance, 0.01)
        step_count += 1
    }
    return 1.0
}

fn compute_scene_color(
    scene_capture: ShapeCapture,
    camera_position: Vec3,
    light: Light,
    ray_direction: Vec3
) -> Vec3 {
    hit = compute_scene_hit(
        scene_capture=scene_capture,
        origin=camera_position,
        direction=ray_direction
    )

    if hit.hit {
        surface = compute_scene_surface(scene_capture=scene_capture, hit=hit)
        key_dir = normalize(light.position - hit.position)
        fill_dir = normalize(vec3(-0.9, 0.45, 0.2))
        view_dir = normalize(camera_position - hit.position)
        half_dir = normalize(key_dir + view_dir)
        distance_to_light = length(light.position - hit.position)
        attenuation = clamp(1.0 - distance_to_light / light.range, 0.0, 1.0)
        shadow = compute_shadow_visibility(
            scene_capture=scene_capture,
            hit_position=hit.position,
            hit_normal=hit.normal,
            light=light
        )
        diffuse = max(dot(hit.normal, key_dir), 0.0) * shadow
        fill = 0.2 * max(dot(hit.normal, fill_dir), 0.0)
        specular = pow(max(dot(hit.normal, half_dir), 0.0), 24.0) * 0.22
        lighting = 0.11 + (0.92 * diffuse * attenuation) + (fill * 0.35)
        return vec3(
            clamp(surface.albedo.x * lighting * light.intensity.x + 255.0 * specular * (0.25 + surface.roughness * 0.75), 0.0, 255.0),
            clamp(surface.albedo.y * lighting * light.intensity.y + 224.0 * specular * (0.25 + surface.roughness * 0.75), 0.0, 255.0),
            clamp(surface.albedo.z * lighting * light.intensity.z + 196.0 * specular * (0.25 + surface.roughness * 0.75), 0.0, 255.0)
        )
    }

    sky_t = 0.5 * (ray_direction.y + 1.0)
    return vec3(10.0, 14.0, 22.0) * (1.0 - sky_t) + vec3(58.0, 84.0, 130.0) * sky_t
}

fn render_ppm() -> String {
    width = 64
    height = 64
    aspect = f32(width) / f32(height)
    camera_position = vec3(0.0, 0.1, 2.7)
    forward = normalize(vec3(0.0, 0.0, -1.0))
    world_up = vec3(0.0, 1.0, 0.0)
    right = normalize(cross(forward, world_up))
    up = normalize(cross(right, forward))
    scene_capture = capture scene_shape
    light = Light(
        position=vec3(2.4, 2.8, 2.4),
        direction=normalize(vec3(-0.8, -0.9, -0.9)),
        intensity=vec3(1.0, 0.98, 0.95),
        range=12.0
    )

    mutable ppm = "P3\n64 64\n255\n"
    mutable y = 0
    while y < height {
        mutable x = 0
        while x < width {
            sample_u = (f32(x) + 0.5) / f32(width)
            sample_v = (f32(y) + 0.5) / f32(height)
            screen_x = (sample_u - 0.5) * 2.0 * aspect * 0.72
            screen_y = (0.5 - sample_v) * 2.0 * 0.72
            ray = normalize(forward + right * screen_x + up * screen_y)
            shaded = compute_scene_color(
                scene_capture=scene_capture,
                camera_position=camera_position,
                light=light,
                ray_direction=ray
            )
            r = i32(clamp(shaded.x, 0.0, 255.0))
            g = i32(clamp(shaded.y, 0.0, 255.0))
            b = i32(clamp(shaded.z, 0.0, 255.0))

            ppm += "{r} {g} {b}\n"
            x += 1
        }
        y += 1
    }

    return ppm
}

fn run() -> Integer {
    print_line(text=render_ppm())
    return 0
}
