field conservative distance plinth(p: Vec3) -> F32 {
    translate = vec3(0.0, -0.78, 0.0) {
        extrude = f32(0.34) {
            rounded_rect2(half = vec2(0.82, 0.42), radius = 0.14)
        }
    }
}

field conservative distance column(p: Vec3) -> F32 {
    revolve {
        rounded_rect2(half = vec2(0.34, 0.82), radius = 0.12)
    }
}

field conservative distance crown(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.84, 0.0) {
        loft = f32(0.46) {
            from rect2(half = vec2(0.22, 0.16))
            to rounded_rect2(half = vec2(0.48, 0.20), radius = 0.08)
        }
    }
}

field conservative distance fin(p: Vec3) -> F32 {
    translate = vec3(-0.86, 0.06, 0.0) {
        extrude = f32(0.20) {
            polygon2(vertices = [
                vec2(-0.10, -0.62),
                vec2(0.42, 0.0),
                vec2(-0.10, 0.62)
            ])
        }
    }
}

field conservative distance fin_pair(p: Vec3) -> F32 {
    mirror_array = vec3(1.0, 0.0, 0.0) {
        use fin
    }
}

field exact distance ground(p: Vec3) -> F32 {
    plane(normal = vec3(0.0, 1.0, 0.0), offset = 0.98)
}

field conservative distance scene(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use plinth
        use column
        use crown
        use fin_pair
        use ground
    }
}

radiance field scene_radiance(p: Vec3, direction: Vec3, feature_id: U32) -> Vec3 {
    sky_t = clamp(0.5 + direction.y * 0.5, 0.0, 1.0)
    horizon = clamp(0.16 - abs(p.y) * 0.04, 0.0, 0.16) / 0.16
    return vec3(10.0, 14.0, 22.0) * (1.0 - sky_t)
        + vec3(58.0, 84.0, 130.0) * sky_t
        + vec3(4.0, 3.0, 2.0) * horizon
}

volume field scene_volume(p: Vec3, surface_distance: F32) -> Medium {
    near_ground = clamp((0.25 - p.y) * 4.0, 0.0, 1.0)
    near_surface = clamp((0.18 - abs(surface_distance)) * 5.0, 0.0, 1.0)
    density = clamp(0.01 + near_ground * 0.035 + near_surface * 0.02, 0.0, 0.12)
    emission = vec3(5.0, 7.0, 11.0) * density * 0.1
    return Medium(
        density=density,
        emission=emission,
        anisotropy=0.14
    )
}

material core_surface(hit: Hit3) -> Surface {
    rib = clamp(abs(hit.local_position.y) * 0.9 + abs(hit.local_normal.x) * 0.25, 0.0, 1.0)
    return Surface(
        albedo=vec3(192.0, 162.0, 116.0) + vec3(22.0, 16.0, 10.0) * rib,
        roughness=0.18 + rib * 0.16,
        metalness=0.08 + clamp(hit.local_normal.z, 0.0, 1.0) * 0.18,
        clearcoat=0.12 + clamp(hit.local_normal.y, 0.0, 1.0) * 0.20,
        clearcoat_roughness=0.06 + abs(hit.local_position.x) * 0.12,
        sheen=0.04 + abs(hit.local_normal.x) * 0.16,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material accent_surface(hit: Hit3) -> Surface {
    glow = clamp(0.55 + hit.local_position.z * 0.65 + hit.local_normal.y * 0.2, 0.0, 1.0)
    return Surface(
        albedo=vec3(82.0, 126.0, 186.0) + vec3(10.0, 18.0, 28.0) * glow,
        roughness=0.12 + abs(hit.local_position.y) * 0.12,
        metalness=0.20 + glow * 0.22,
        clearcoat=0.22 + glow * 0.26,
        clearcoat_roughness=0.10 + (1.0 - glow) * 0.18,
        sheen=0.12 + abs(hit.local_normal.x) * 0.18,
        emissive=vec3(8.0, 5.0, 2.0) * glow
    )
}

material base_surface(hit: Hit3) -> Surface {
    grit = clamp(abs(hit.local_position.x) * 0.4 + abs(hit.local_position.z) * 0.25, 0.0, 1.0)
    return Surface(
        albedo=vec3(62.0, 70.0, 82.0) + vec3(10.0, 8.0, 8.0) * grit,
        roughness=0.88 + grit * 0.10,
        metalness=0.0,
        clearcoat=0.04,
        clearcoat_roughness=0.24,
        sheen=0.02,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material frame_surface(hit: Hit3) -> Surface {
    band = clamp(abs(hit.local_position.x) * 0.8 + abs(hit.local_normal.y) * 0.2, 0.0, 1.0)
    return Surface(
        albedo=vec3(168.0, 144.0, 108.0) + vec3(14.0, 10.0, 8.0) * band,
        roughness=0.20 + band * 0.12,
        metalness=0.06 + abs(hit.local_normal.z) * 0.12,
        clearcoat=0.14 + band * 0.12,
        clearcoat_roughness=0.08 + abs(hit.local_position.y) * 0.10,
        sheen=0.06 + abs(hit.local_normal.x) * 0.12,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape core_shape {
    field = column
    material = core_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(1),
        material_id=u32(1),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape accent_shape {
    field = crown
    material = accent_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(2),
        material_id=u32(2),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape foot_shape {
    field = plinth
    material = frame_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(3),
        material_id=u32(3),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape floor_shape {
    field = ground
    material = base_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(4),
        material_id=u32(4),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape fin_shape {
    field = fin_pair
    material = accent_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(5),
        material_id=u32(5),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape scene_shape {
    union {
        provenance_policy = nearest
        use core_shape
        use accent_shape
        use foot_shape
        use floor_shape
        use fin_shape
    }
}

region scene_region() {
    place coarse = scene_shape
    place fine = scene_shape
}

domain scene_domain(world: RegionCapture) {
    geometry_detail = 1
    material = true
    radiance = true
    media = true
    max_distance = 12.0
    min_step = 0.02
    hit_epsilon = 0.0008
    max_steps = 96
}

view main_view(
    world: RegionCapture,
    camera: Camera
) {
    domain = scene_domain(world = world)
    viewport = viewport(width = 40, height = 40)
    quality = realtime_quality(target_fps = 60)
    lighting = key_light(
        light = Light(
            position=vec3(2.4, 2.8, 2.4),
            direction=normalize(vec3(-0.8, -0.9, -0.9)),
            intensity=vec3(1.0, 0.98, 0.95),
            range=12.0
        ),
        fill_direction = normalize(vec3(-0.9, 0.45, 0.2))
    )
    outputs = frame_outputs(color = true, depth = true, normal = true, motion = true)
    history = temporal_history(color = true)
}
