use explain_policy_db from db/explain_kernel

//
// Read-only policy explain wrappers.

fn explain_policy(db_handle: Integer, namespace: String, key: String) -> Result[String] {
    return explain_policy_db(
        db_handle_explain_policy=db_handle,
        namespace_explain_policy=namespace,
        key_explain_policy=key
    )
}
