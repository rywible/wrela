use explain_topology_db from db/explain_kernel

//
// Read-only topology explain wrappers.

fn explain_topology(db_handle: Integer, namespace: String, key: String) -> Result[String] {
    return explain_topology_db(
        db_handle_explain_topology=db_handle,
        namespace_explain_topology=namespace,
        key_explain_topology=key
    )
}
