so:
    Admin helpers for machine-readable cluster health checks.

to get_cluster_health_summary(
    total_nodes: Integer,
    healthy_nodes: Integer,
    degraded_nodes: Integer,
    unavailable_nodes: Integer
) -> Integer:
    if total_nodes <= 0:
        return 0
    if healthy_nodes < 0:
        return 0
    if degraded_nodes < 0:
        return 0
    if unavailable_nodes < 0:
        return 0
    if healthy_nodes + degraded_nodes + unavailable_nodes == total_nodes:
        return 1
    return 0
