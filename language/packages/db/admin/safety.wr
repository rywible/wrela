use promote_async_failover_db from db/admin_kernel

//
// Safety admin bindings to failover promotion.

fn promote_async_failover(
    db_handle: Integer,
    keyrange: String,
    region: String,
    expected_epoch: Integer
) -> Result[String] {
    return promote_async_failover_db(
        db_handle_promote_async_failover=db_handle,
        keyrange_promote_async_failover=keyrange,
        region_promote_async_failover=region,
        expected_epoch_promote_async_failover=expected_epoch
    )
}
