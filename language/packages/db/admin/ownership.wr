//
// Ownership, rehome, and failover contracts bound to runtime admin APIs.

use {
    plan_rehome_db,
    advance_rehome_db,
    promote_async_failover_db
}
from db/admin_kernel

enum RelocationMode {
    Strict
}

class RelocationRequest {
    db_handle: Integer
    keyrange: String
    target_home: String
    reason: String
}

fn set_home(db_handle: Integer, keyrange: String, home: String, reason: String) -> Result[String] {
    return plan_rehome_db(
        db_handle_plan_rehome=db_handle,
        keyrange_plan_rehome=keyrange,
        target_region_plan_rehome=home,
        reason_plan_rehome=reason
    )
}

fn relocate_home(
    db_handle: Integer,
    keyrange: String,
    target_home: String,
    reason: String
) -> Result[String] {
    return plan_rehome_db(
        db_handle_plan_rehome=db_handle,
        keyrange_plan_rehome=keyrange,
        target_region_plan_rehome=target_home,
        reason_plan_rehome=reason
    )
}

fn advance_relocation(db_handle: Integer, job_id: String, phase_ack: String) -> Result[String] {
    return advance_rehome_db(
        db_handle_advance_rehome=db_handle,
        job_id_advance_rehome=job_id,
        phase_ack_advance_rehome=phase_ack
    )
}

fn promote_async_failover(
    db_handle: Integer,
    keyrange: String,
    region: String,
    expected_epoch: Integer
) -> Result[String] {
    return promote_async_failover_db(
        db_handle_promote_async_failover=db_handle,
        keyrange_promote_async_failover=keyrange,
        region_promote_async_failover=region,
        expected_epoch_promote_async_failover=expected_epoch
    )
}
