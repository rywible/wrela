//
// Wrela-first cluster admin orchestration surface.

class ClusterPlan {
    operation: String
    target: String

}
fn add_node(node_id: String) -> ClusterPlan {
    return ClusterPlan(operation="add_node", target=node_id)

}
fn decommission(node_id: String) -> ClusterPlan {
    return ClusterPlan(operation="decommission", target=node_id)
}
