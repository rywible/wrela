//
// Shard migration orchestration contract.

class MigrationPlan {
    migration_id: String
    shard_id: Integer
    source_region: String
    target_region: String

}
fn plan_migration(
    migration_id: String,
    shard_id: Integer,
    source_region: String,
    target_region: String
) -> MigrationPlan {
    return MigrationPlan(
        migration_id=migration_id,
        shard_id=shard_id,
        source_region=source_region,
        target_region=target_region
    )
}
