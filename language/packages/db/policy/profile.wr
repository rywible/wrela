//
// Placement profile contracts for multi-region survivability policy.

enum PlacementProfile {
    ThreeRegionSurvivability
    SingleRegion

}
fn default_profile() -> PlacementProfile {
    return PlacementProfile.ThreeRegionSurvivability

}
fn is_explicit_single_region(placement_profile: PlacementProfile) -> Boolean {
    if placement_profile == PlacementProfile.SingleRegion {
        return true
    }
    return false
}
