//
// Safety simulation helpers for deterministic gate outcomes.

fn create_safety_gate_result(
    required_additional_failures: Integer,
    survivable_additional_failures: Integer,
    degraded_selected: Integer,
    max_degraded_selected: Integer
) -> Integer {
    if survivable_additional_failures < required_additional_failures {
        return 0
    }
    if degraded_selected > max_degraded_selected {
        return 0
    }
    return 1
}
