//
// Policy intent DSL surface for DB autopilot compile inputs.

enum SurvivabilityIntent {
    SingleRegion
    RegionFailure
    TwoRegionFailure

}
enum CostTier {
    Economy
    Balanced
    Performance

}
enum BudgetClass {
    Constrained
    Standard
    Flexible

}
class PolicyIntent {
    policy_id: String
    survivability: SurvivabilityIntent
    latency_target_ms: Integer
    residency_scope: String
    cost_tier: CostTier
    budget_class: BudgetClass

}
fn default_policy_intent(policy_id: String, residency_scope: String) -> PolicyIntent {
    return PolicyIntent(
        policy_id=policy_id,
        survivability=SurvivabilityIntent.RegionFailure,
        latency_target_ms=80,
        residency_scope=residency_scope,
        cost_tier=CostTier.Balanced,
        budget_class=BudgetClass.Standard
    )

}
fn has_required_intent_fields(intent: PolicyIntent) -> Boolean {
    if intent.policy_id == "" {
        return false
    }
    if intent.latency_target_ms <= 0 {
        return false
    }
    if intent.residency_scope == "" {
        return false
    }
    return true
}
