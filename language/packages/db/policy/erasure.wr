//
// Erasure policy contract for delete propagation across CDC and backups.

enum ErasureMode {
    HardDelete
    CryptoShred

}
class ErasureRequest {
    intent_id: String
    mode: ErasureMode
    legal_hold_until_commit_seq: Integer
    tombstone_retention_commits: Integer
    residency_scope: String

}
fn request_hard_delete(intent_id: String, residency_scope: String) -> ErasureRequest {
    return ErasureRequest(
        intent_id=intent_id,
        mode=ErasureMode.HardDelete,
        legal_hold_until_commit_seq=-1,
        tombstone_retention_commits=0,
        residency_scope=residency_scope
    )

}
fn has_legal_hold(request: ErasureRequest) -> Boolean {
    return request.legal_hold_until_commit_seq >= 0
}
