//
// Any-region write router contract for DB client package.

class WriteRoute {
    shard_id: Integer
    leader_node: String
    forwarded: Boolean

}
fn route_for_write(shard_id: Integer, leader_node: String, local_node: String) -> WriteRoute {
    if leader_node == local_node {
        return WriteRoute(shard_id=shard_id, leader_node=leader_node, forwarded=false)
    }
    return WriteRoute(shard_id=shard_id, leader_node=leader_node, forwarded=true)
}
