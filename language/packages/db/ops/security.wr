//
// Security hardening helpers with fail-closed defaults.

fn validate_secure_defaults(
    require_mtls: Integer,
    enforce_authz: Integer,
    enable_audit: Integer,
    allow_insecure_fallback: Integer
) -> Integer {
    if allow_insecure_fallback != 0 {
        return 0
    }
    if require_mtls != 1 {
        return 0
    }
    if enforce_authz != 1 {
        return 0
    }
    if enable_audit != 1 {
        return 0
    }
    return 1

}
fn check_rotate_cert(
    cert_not_after_s: Integer,
    now_s: Integer,
    rotate_window_s: Integer
) -> Integer {
    if rotate_window_s <= 0 {
        return 1
    }
    if now_s + rotate_window_s >= cert_not_after_s {
        return 1
    }
    return 0

}
fn check_rotate_key(
    last_rotation_s: Integer,
    now_s: Integer,
    interval_s: Integer
) -> Integer {
    if interval_s <= 0 {
        return 1
    }
    if now_s - last_rotation_s >= interval_s {
        return 1
    }
    return 0
}
