//
// Background scrub policy helpers used by DB operator workflows.

fn create_checksum_mismatch_result(expected_checksum: Integer, observed_checksum: Integer) -> Integer {
    if expected_checksum != observed_checksum {
        return 1
    }
    return 0

}
fn choose_target_severity(target_kind: String) -> String {
    if target_kind == "snapshot" {
        return "critical"
    }
    return "warning"

}
fn choose_repair_action(target_kind: String) -> String {
    if target_kind == "snapshot" {
        return "refetch_snapshot"
    }
    if target_kind == "wal" {
        return "rebuild_follower"
    }
    if target_kind == "sstable" {
        return "rebuild_follower"
    }
    return "unknown"

}
fn check_quarantine_target(target_kind: String, mismatch_detected: Integer) -> Integer {
    if mismatch_detected == 1 {
        if target_kind == "snapshot" {
            return 1
        }
    }
    return 0
}
