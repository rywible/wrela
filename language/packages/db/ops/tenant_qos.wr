so:
    Tenant isolation policy helpers for admission and fairness workflows.

to validate_quota_inputs(
    max_in_flight: Integer,
    max_ops_per_window: Integer,
    window_ms: Integer,
    retry_after_ms: Integer
) -> Integer:
    if max_in_flight <= 0:
        return 0
    if max_ops_per_window <= 0:
        return 0
    if window_ms <= 0:
        return 0
    if retry_after_ms <= 0:
        return 0
    return 1

to create_retry_metadata(token: String, retry_after_ms: Integer) -> String:
    if retry_after_ms == 25:
        return token + ":25"
    if retry_after_ms == 50:
        return token + ":50"
    return token + ":retry"

to choose_fair_tenant(
    tenant_a: String,
    tenant_a_backlog: Integer,
    tenant_a_served: Integer,
    tenant_b: String,
    tenant_b_backlog: Integer,
    tenant_b_served: Integer
) -> String:
    if tenant_a_backlog <= 0:
        return tenant_b
    if tenant_b_backlog <= 0:
        return tenant_a
    if tenant_a_served <= tenant_b_served:
        return tenant_a
    return tenant_b
