//
// Domain and view contracts for game session payloads.

class GameInputFrame {
    mutable sequence: Integer = 0
    mutable tick: Integer = 0
    mutable axis_x: Integer = 0
    mutable axis_y: Integer = 0
    mutable delta_milliseconds: Integer = 16
}

class GameWorldSnapshot {
    mutable tick: Integer = 0
    mutable player_x: Integer = 0
    mutable player_y: Integer = 0
    mutable score: Integer = 0
    mutable collected_mask: Integer = 0
}

fn create_game_input_frame(
    sequence: Integer,
    tick: Integer,
    axis_x: Integer,
    axis_y: Integer,
    delta_milliseconds: Integer
) -> GameInputFrame {
    return GameInputFrame(
        sequence=sequence,
        tick=tick,
        axis_x=axis_x,
        axis_y=axis_y,
        delta_milliseconds=delta_milliseconds
    )
}

fn create_game_world_snapshot(
    tick: Integer,
    player_x: Integer,
    player_y: Integer,
    score: Integer,
    collected_mask: Integer
) -> GameWorldSnapshot {
    return GameWorldSnapshot(
        tick=tick,
        player_x=player_x,
        player_y=player_y,
        score=score,
        collected_mask=collected_mask
    )
}
