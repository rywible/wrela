//
// Generic persistent-physics contracts for archetype-driven simulation.

resource PersistentPhysicsBodyState {
    mutable entity_id: Integer = 0
    mutable archetype_id: Integer = 0
    mutable lifecycle_state: Integer = 0
    mutable position_x: Integer = 0
    mutable position_y: Integer = 0
    mutable position_z: Integer = 0
    mutable velocity_x: Integer = 0
    mutable velocity_y: Integer = 0
    mutable velocity_z: Integer = 0
    mutable durability_milli: Integer = 1000
    mutable burden_milli: Integer = 0
    mutable persistence_ticks: Integer = 0
}

event PersistentPhysicsLifecycleEvent {
    mutable entity_id: Integer = 0
    mutable archetype_id: Integer = 0
    mutable previous_state: Integer = 0
    mutable next_state: Integer = 0
    mutable reason_code: Integer = 0
    mutable tick: Integer = 0
}

event PersistentPhysicsInteractionEvent {
    mutable source_entity_id: Integer = 0
    mutable target_entity_id: Integer = 0
    mutable interaction_type: Integer = 0
    mutable impulse_x: Integer = 0
    mutable impulse_y: Integer = 0
    mutable impulse_z: Integer = 0
    mutable contact_x: Integer = 0
    mutable contact_y: Integer = 0
    mutable contact_z: Integer = 0
    mutable tick: Integer = 0
}

fn get_persistent_physics_state_static() -> Integer {
    return 0
}

fn get_persistent_physics_state_active() -> Integer {
    return 1
}

fn get_persistent_physics_state_sleeping() -> Integer {
    return 2
}

fn get_persistent_physics_state_baked() -> Integer {
    return 3
}

fn get_persistent_physics_state_harvested() -> Integer {
    return 4
}

fn create_persistent_physics_body_state(
    entity_id: Integer,
    archetype_id: Integer,
    lifecycle_state: Integer,
    position_x: Integer, position_y: Integer, position_z: Integer,
    velocity_x: Integer, velocity_y: Integer, velocity_z: Integer,
    durability_milli: Integer,
    burden_milli: Integer,
    persistence_ticks: Integer
) -> PersistentPhysicsBodyState {
    return PersistentPhysicsBodyState(
        entity_id=entity_id,
        archetype_id=archetype_id,
        lifecycle_state=lifecycle_state,
        position_x=position_x,
        position_y=position_y,
        position_z=position_z,
        velocity_x=velocity_x,
        velocity_y=velocity_y,
        velocity_z=velocity_z,
        durability_milli=durability_milli,
        burden_milli=burden_milli,
        persistence_ticks=persistence_ticks
    )
}

fn create_persistent_physics_body_state_with_state(
    state: PersistentPhysicsBodyState,
    next_state: Integer
) -> PersistentPhysicsBodyState {
    return PersistentPhysicsBodyState(
        entity_id=state.entity_id,
        archetype_id=state.archetype_id,
        lifecycle_state=next_state,
        position_x=state.position_x,
        position_y=state.position_y,
        position_z=state.position_z,
        velocity_x=state.velocity_x,
        velocity_y=state.velocity_y,
        velocity_z=state.velocity_z,
        durability_milli=state.durability_milli,
        burden_milli=state.burden_milli,
        persistence_ticks=state.persistence_ticks
    )
}

fn check_persistent_physics_state_terminal(lifecycle_state: Integer) -> Boolean {
    if lifecycle_state == get_persistent_physics_state_baked() {
        return true
    }
    if lifecycle_state == get_persistent_physics_state_harvested() {
        return true
    }
    return false
}

fn create_persistent_physics_lifecycle_event(
    state: PersistentPhysicsBodyState,
    next_state: Integer,
    reason_code: Integer,
    tick: Integer
) -> PersistentPhysicsLifecycleEvent {
    return PersistentPhysicsLifecycleEvent(
        entity_id=state.entity_id,
        archetype_id=state.archetype_id,
        previous_state=state.lifecycle_state,
        next_state=next_state,
        reason_code=reason_code,
        tick=tick
    )
}
