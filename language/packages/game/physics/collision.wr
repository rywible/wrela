//
// Fixed-point collision primitives and overlap tests.

resource AabbFixed {
    mutable min_x: Integer = 0
    mutable min_y: Integer = 0
    mutable min_z: Integer = 0
    mutable max_x: Integer = 0
    mutable max_y: Integer = 0
    mutable max_z: Integer = 0
}

resource CapsuleFixed {
    mutable base_x: Integer = 0
    mutable base_y: Integer = 0
    mutable base_z: Integer = 0
    mutable tip_x: Integer = 0
    mutable tip_y: Integer = 1000
    mutable tip_z: Integer = 0
    mutable radius: Integer = 500
}

fn create_aabb(
    min_x: Integer, min_y: Integer, min_z: Integer,
    max_x: Integer, max_y: Integer, max_z: Integer
) -> AabbFixed {
    return AabbFixed(
        min_x=min_x, min_y=min_y, min_z=min_z,
        max_x=max_x, max_y=max_y, max_z=max_z
    )
}

fn create_aabb_from_center(
    cx: Integer, cy: Integer, cz: Integer,
    hx: Integer, hy: Integer, hz: Integer
) -> AabbFixed {
    return AabbFixed(
        min_x=cx - hx, min_y=cy - hy, min_z=cz - hz,
        max_x=cx + hx, max_y=cy + hy, max_z=cz + hz
    )
}

fn create_capsule(
    base_x: Integer, base_y: Integer, base_z: Integer,
    tip_x: Integer, tip_y: Integer, tip_z: Integer,
    radius: Integer
) -> CapsuleFixed {
    return CapsuleFixed(
        base_x=base_x, base_y=base_y, base_z=base_z,
        tip_x=tip_x, tip_y=tip_y, tip_z=tip_z,
        radius=radius
    )
}

fn test_aabb_overlap(a: AabbFixed, b: AabbFixed) -> Boolean {
    if a.max_x < b.min_x {
        return false
    }
    if a.min_x > b.max_x {
        return false
    }
    if a.max_y < b.min_y {
        return false
    }
    if a.min_y > b.max_y {
        return false
    }
    if a.max_z < b.min_z {
        return false
    }
    if a.min_z > b.max_z {
        return false
    }
    return true
}

fn test_capsule_aabb_overlap(capsule: CapsuleFixed, box: AabbFixed) -> Boolean {
    // Simplified: test capsule as AABB (sufficient for Phase 1)
    mutable cap_min_x = capsule.base_x - capsule.radius
    mutable cap_max_x = capsule.base_x + capsule.radius
    if capsule.tip_x - capsule.radius < cap_min_x {
        cap_min_x = capsule.tip_x - capsule.radius
    }
    if capsule.tip_x + capsule.radius > cap_max_x {
        cap_max_x = capsule.tip_x + capsule.radius
    }

    mutable cap_min_y = capsule.base_y - capsule.radius
    mutable cap_max_y = capsule.base_y + capsule.radius
    if capsule.tip_y - capsule.radius < cap_min_y {
        cap_min_y = capsule.tip_y - capsule.radius
    }
    if capsule.tip_y + capsule.radius > cap_max_y {
        cap_max_y = capsule.tip_y + capsule.radius
    }

    mutable cap_min_z = capsule.base_z - capsule.radius
    mutable cap_max_z = capsule.base_z + capsule.radius
    if capsule.tip_z - capsule.radius < cap_min_z {
        cap_min_z = capsule.tip_z - capsule.radius
    }
    if capsule.tip_z + capsule.radius > cap_max_z {
        cap_max_z = capsule.tip_z + capsule.radius
    }

    cap_aabb = create_aabb(
        min_x=cap_min_x, min_y=cap_min_y, min_z=cap_min_z,
        max_x=cap_max_x, max_y=cap_max_y, max_z=cap_max_z
    )
    return test_aabb_overlap(cap_aabb, box)
}

fn test_capsule_capsule_overlap(a: CapsuleFixed, b: CapsuleFixed) -> Boolean {
    // Simplified: distance between midpoints < sum of radii + half-heights
    mid_ax = (a.base_x + a.tip_x) / 2
    mid_ay = (a.base_y + a.tip_y) / 2
    mid_az = (a.base_z + a.tip_z) / 2
    mid_bx = (b.base_x + b.tip_x) / 2
    mid_by = (b.base_y + b.tip_y) / 2
    mid_bz = (b.base_z + b.tip_z) / 2

    dx = mid_ax - mid_bx
    dy = mid_ay - mid_by
    dz = mid_az - mid_bz
    dist_sq = (dx * dx + dy * dy + dz * dz) / 1000
    threshold = a.radius + b.radius
    threshold_sq = threshold * threshold / 1000

    return dist_sq <= threshold_sq
}
