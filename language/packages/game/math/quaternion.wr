//
// Fixed-point quaternion math. All values milli-scaled (1000 = 1.0).

use {
    Mat4Fixed
}
from game/math/mat4

resource QuaternionFixed {
    mutable w: Integer = 1000
    mutable x: Integer = 0
    mutable y: Integer = 0
    mutable z: Integer = 0
}

fn quat_identity() -> QuaternionFixed {
    return QuaternionFixed()
}

fn quat_from_axis_angle(
    axis_x: Integer,
    axis_y: Integer,
    axis_z: Integer,
    angle_milliradians: Integer
) -> QuaternionFixed {
    // sin(a/2) ~ a/2 - (a/2)^3/6 for small angles (millirad)
    half_angle = angle_milliradians / 2
    ha_cubed = half_angle * half_angle * half_angle
    sin_milli = half_angle - ha_cubed / 6000000
    // cos(a/2) ~ 1 - (a/2)^2/2
    cos_milli = 1000 - half_angle * half_angle / 2000

    return QuaternionFixed(
        w=cos_milli,
        x=axis_x * sin_milli / 1000,
        y=axis_y * sin_milli / 1000,
        z=axis_z * sin_milli / 1000
    )
}

fn quat_multiply(a: QuaternionFixed, b: QuaternionFixed) -> QuaternionFixed {
    return QuaternionFixed(
        w=(a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z) / 1000,
        x=(a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y) / 1000,
        y=(a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x) / 1000,
        z=(a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w) / 1000
    )
}

fn quat_slerp(a: QuaternionFixed, b: QuaternionFixed, t_milli: Integer) -> QuaternionFixed {
    // Linear interpolation for simplicity in Phase 1 (nlerp)
    inv_t = 1000 - t_milli

    // Check dot product sign to take shortest path
    dot = (a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z) / 1000
    mutable bw = b.w
    mutable bx = b.x
    mutable by = b.y
    mutable bz = b.z
    if dot < 0 {
        bw = 0 - b.w
        bx = 0 - b.x
        by = 0 - b.y
        bz = 0 - b.z
    }

    rw = (a.w * inv_t + bw * t_milli) / 1000
    rx = (a.x * inv_t + bx * t_milli) / 1000
    ry = (a.y * inv_t + by * t_milli) / 1000
    rz = (a.z * inv_t + bz * t_milli) / 1000

    // Normalize
    len_sq = (rw * rw + rx * rx + ry * ry + rz * rz) / 1000
    if len_sq <= 0 {
        return QuaternionFixed()
    }
    mutable estimate = len_sq
    mutable prev = 0
    while estimate != prev {
        prev = estimate
        estimate = (estimate + len_sq / estimate) / 2
    }
    length = estimate
    if length <= 0 {
        return QuaternionFixed()
    }

    return QuaternionFixed(
        w=rw * 1000 / length,
        x=rx * 1000 / length,
        y=ry * 1000 / length,
        z=rz * 1000 / length
    )
}

fn quat_to_mat4(q: QuaternionFixed) -> Mat4Fixed {
    xx = q.x * q.x / 1000
    yy = q.y * q.y / 1000
    zz = q.z * q.z / 1000
    xy = q.x * q.y / 1000
    xz = q.x * q.z / 1000
    yz = q.y * q.z / 1000
    wx = q.w * q.x / 1000
    wy = q.w * q.y / 1000
    wz = q.w * q.z / 1000

    return Mat4Fixed(
        m00=1000 - 2 * (yy + zz),
        m01=2 * (xy + wz),
        m02=2 * (xz - wy),
        m03=0,
        m10=2 * (xy - wz),
        m11=1000 - 2 * (xx + zz),
        m12=2 * (yz + wx),
        m13=0,
        m20=2 * (xz + wy),
        m21=2 * (yz - wx),
        m22=1000 - 2 * (xx + yy),
        m23=0,
        m30=0,
        m31=0,
        m32=0,
        m33=1000
    )
}

fn quat_normalize(q: QuaternionFixed) -> QuaternionFixed {
    len_sq = (q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z) / 1000
    if len_sq <= 0 {
        return QuaternionFixed()
    }
    mutable estimate = len_sq
    mutable prev = 0
    while estimate != prev {
        prev = estimate
        estimate = (estimate + len_sq / estimate) / 2
    }
    length = estimate
    if length <= 0 {
        return QuaternionFixed()
    }
    return QuaternionFixed(
        w=q.w * 1000 / length,
        x=q.x * 1000 / length,
        y=q.y * 1000 / length,
        z=q.z * 1000 / length
    )
}
