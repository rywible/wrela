//
// Fixed-point 3D vector math. All values milli-scaled (1000 = 1.0).

resource Vec3Fixed {
    mutable x: Integer = 0
    mutable y: Integer = 0
    mutable z: Integer = 0
}

fn create_vec3(x: Integer, y: Integer, z: Integer) -> Vec3Fixed {
    return Vec3Fixed(x=x, y=y, z=z)
}

fn create_vec3_zero() -> Vec3Fixed {
    return Vec3Fixed()
}

fn create_vec3_up() -> Vec3Fixed {
    return Vec3Fixed(x=0, y=1000, z=0)
}

fn create_vec3_forward() -> Vec3Fixed {
    return Vec3Fixed(x=0, y=0, z=1000)
}

fn vec3_add(a: Vec3Fixed, b: Vec3Fixed) -> Vec3Fixed {
    return Vec3Fixed(
        x=a.x + b.x,
        y=a.y + b.y,
        z=a.z + b.z
    )
}

fn vec3_sub(a: Vec3Fixed, b: Vec3Fixed) -> Vec3Fixed {
    return Vec3Fixed(
        x=a.x - b.x,
        y=a.y - b.y,
        z=a.z - b.z
    )
}

fn vec3_scale(v: Vec3Fixed, scale_milli: Integer) -> Vec3Fixed {
    return Vec3Fixed(
        x=v.x * scale_milli / 1000,
        y=v.y * scale_milli / 1000,
        z=v.z * scale_milli / 1000
    )
}

fn vec3_dot(a: Vec3Fixed, b: Vec3Fixed) -> Integer {
    return (a.x * b.x + a.y * b.y + a.z * b.z) / 1000
}

fn vec3_length_squared(v: Vec3Fixed) -> Integer {
    return (v.x * v.x + v.y * v.y + v.z * v.z) / 1000
}

fn vec3_normalize(v: Vec3Fixed) -> Vec3Fixed {
    len_sq = vec3_length_squared(v)
    if len_sq <= 0 {
        return Vec3Fixed()
    }
    // Integer square root via Newton's method
    mutable estimate = len_sq
    mutable prev = 0
    while estimate != prev {
        prev = estimate
        estimate = (estimate + len_sq / estimate) / 2
    }
    length = estimate
    if length <= 0 {
        return Vec3Fixed()
    }
    return Vec3Fixed(
        x=v.x * 1000 / length,
        y=v.y * 1000 / length,
        z=v.z * 1000 / length
    )
}

fn vec3_cross(a: Vec3Fixed, b: Vec3Fixed) -> Vec3Fixed {
    return Vec3Fixed(
        x=(a.y * b.z - a.z * b.y) / 1000,
        y=(a.z * b.x - a.x * b.z) / 1000,
        z=(a.x * b.y - a.y * b.x) / 1000
    )
}

fn vec3_lerp(a: Vec3Fixed, b: Vec3Fixed, t_milli: Integer) -> Vec3Fixed {
    inv_t = 1000 - t_milli
    return Vec3Fixed(
        x=(a.x * inv_t + b.x * t_milli) / 1000,
        y=(a.y * inv_t + b.y * t_milli) / 1000,
        z=(a.z * inv_t + b.z * t_milli) / 1000
    )
}

fn vec3_clamp_magnitude(v: Vec3Fixed, max_length_milli: Integer) -> Vec3Fixed {
    len_sq = vec3_length_squared(v)
    max_sq = max_length_milli * max_length_milli / 1000
    if len_sq <= max_sq {
        return v
    }
    return vec3_scale(vec3_normalize(v), max_length_milli)
}

fn vec3_distance_squared(a: Vec3Fixed, b: Vec3Fixed) -> Integer {
    diff = vec3_sub(a, b)
    return vec3_length_squared(diff)
}

fn vec3_negate(v: Vec3Fixed) -> Vec3Fixed {
    return Vec3Fixed(x=0 - v.x, y=0 - v.y, z=0 - v.z)
}
