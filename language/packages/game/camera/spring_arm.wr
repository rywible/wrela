//
// Third-person spring arm camera with jolt and FOV shift.

use {
    Vec3Fixed,
    vec3_add,
    vec3_sub,
    vec3_scale,
    vec3_lerp,
    create_vec3
}
from game/math/vec3

use {
    CameraDescriptor
}
from game/render/contracts

resource SpringArmState {
    mutable target_x: Integer = 0
    mutable target_y: Integer = 0
    mutable target_z: Integer = 0
    mutable current_x: Integer = 0
    mutable current_y: Integer = 0
    mutable current_z: Integer = 0
    mutable arm_length: Integer = 5000
    mutable pitch_milli: Integer = 500
    mutable yaw_milli: Integer = 0
    mutable spring_stiffness: Integer = 200
    mutable damping: Integer = 800
}

resource CameraJoltState {
    mutable active: Boolean = false
    mutable remaining_ticks: Integer = 0
    mutable magnitude_milli: Integer = 0
    mutable decay_milli: Integer = 800
    mutable offset_x: Integer = 0
    mutable offset_y: Integer = 0
    mutable offset_z: Integer = 0
}

resource CameraFovShiftState {
    mutable base_fov_milli: Integer = 1047
    mutable target_fov_milli: Integer = 1047
    mutable current_fov_milli: Integer = 1047
    mutable blend_speed_milli: Integer = 100
}

fn create_default_spring_arm() -> SpringArmState {
    return SpringArmState()
}

fn create_default_camera_jolt() -> CameraJoltState {
    return CameraJoltState()
}

fn create_default_fov_shift() -> CameraFovShiftState {
    return CameraFovShiftState()
}

fn update_spring_arm_target(
    arm: SpringArmState,
    target_x: Integer,
    target_y: Integer,
    target_z: Integer
) -> SpringArmState {
    return SpringArmState(
        target_x=target_x,
        target_y=target_y,
        target_z=target_z,
        current_x=arm.current_x,
        current_y=arm.current_y,
        current_z=arm.current_z,
        arm_length=arm.arm_length,
        pitch_milli=arm.pitch_milli,
        yaw_milli=arm.yaw_milli,
        spring_stiffness=arm.spring_stiffness,
        damping=arm.damping
    )
}

fn tick_spring_arm(arm: SpringArmState) -> SpringArmState {
    // Lerp current toward target using damping factor
    blend = arm.damping
    inv_blend = 1000 - blend
    new_x = (arm.current_x * inv_blend + arm.target_x * blend) / 1000
    new_y = (arm.current_y * inv_blend + arm.target_y * blend) / 1000
    new_z = (arm.current_z * inv_blend + arm.target_z * blend) / 1000

    return SpringArmState(
        target_x=arm.target_x,
        target_y=arm.target_y,
        target_z=arm.target_z,
        current_x=new_x,
        current_y=new_y,
        current_z=new_z,
        arm_length=arm.arm_length,
        pitch_milli=arm.pitch_milli,
        yaw_milli=arm.yaw_milli,
        spring_stiffness=arm.spring_stiffness,
        damping=arm.damping
    )
}

fn compute_camera_position(arm: SpringArmState) -> Vec3Fixed {
    // Camera sits behind and above the target based on pitch and arm length.
    // Simplified: cam_y = target_y + arm_length * pitch, cam_z = target_z - arm_length
    offset_y = arm.arm_length * arm.pitch_milli / 1000
    offset_z = 0 - arm.arm_length

    return create_vec3(
        x=arm.current_x,
        y=arm.current_y + offset_y,
        z=arm.current_z + offset_z
    )
}

fn trigger_camera_jolt(
    jolt: CameraJoltState,
    magnitude_milli: Integer,
    duration_ticks: Integer
) -> CameraJoltState {
    return CameraJoltState(
        active=true,
        remaining_ticks=duration_ticks,
        magnitude_milli=magnitude_milli,
        decay_milli=jolt.decay_milli,
        offset_x=0,
        offset_y=magnitude_milli,
        offset_z=0
    )
}

fn tick_camera_jolt(jolt: CameraJoltState) -> CameraJoltState {
    if jolt.active == false {
        return jolt
    }
    new_remaining = jolt.remaining_ticks - 1
    if new_remaining <= 0 {
        return CameraJoltState(
            active=false,
            remaining_ticks=0,
            magnitude_milli=0,
            decay_milli=jolt.decay_milli,
            offset_x=0,
            offset_y=0,
            offset_z=0
        )
    }
    // Decay the offset
    new_offset_x = jolt.offset_x * jolt.decay_milli / 1000
    new_offset_y = jolt.offset_y * jolt.decay_milli / 1000
    new_offset_z = jolt.offset_z * jolt.decay_milli / 1000
    // Alternate sign for shake effect
    new_offset_y = 0 - new_offset_y

    return CameraJoltState(
        active=true,
        remaining_ticks=new_remaining,
        magnitude_milli=jolt.magnitude_milli * jolt.decay_milli / 1000,
        decay_milli=jolt.decay_milli,
        offset_x=new_offset_x,
        offset_y=new_offset_y,
        offset_z=new_offset_z
    )
}

fn tick_fov_shift(state: CameraFovShiftState) -> CameraFovShiftState {
    if state.current_fov_milli == state.target_fov_milli {
        return state
    }
    diff = state.target_fov_milli - state.current_fov_milli
    step = diff * state.blend_speed_milli / 1000
    if step == 0 {
        step = 1
        if diff < 0 {
            step = -1
        }
    }
    new_fov = state.current_fov_milli + step
    return CameraFovShiftState(
        base_fov_milli=state.base_fov_milli,
        target_fov_milli=state.target_fov_milli,
        current_fov_milli=new_fov,
        blend_speed_milli=state.blend_speed_milli
    )
}

fn build_camera_descriptor(
    arm: SpringArmState,
    jolt: CameraJoltState,
    fov_state: CameraFovShiftState
) -> CameraDescriptor {
    cam_pos = compute_camera_position(arm)
    return CameraDescriptor(
        camera_id="main",
        x=cam_pos.x + jolt.offset_x,
        y=cam_pos.y + jolt.offset_y,
        z=cam_pos.z + jolt.offset_z,
        fov_milliradians=fov_state.current_fov_milli,
        near_plane_milli=100,
        far_plane_milli=500000
    )
}
