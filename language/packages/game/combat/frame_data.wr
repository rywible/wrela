//
// Frame data definitions for combat moves. Engine defines structure; app fills in numbers.

resource FrameDataEntry {
    mutable move_id: Integer = 0
    mutable startup_ticks: Integer = 0
    mutable active_ticks: Integer = 0
    mutable recovery_ticks: Integer = 0
    mutable damage_milli: Integer = 0
    mutable stamina_cost_milli: Integer = 0
    mutable hitstun_ticks: Integer = 0
    mutable poise_damage_milli: Integer = 0
    mutable knockback_milli: Integer = 0
}

resource HitboxDescriptor {
    mutable offset_x: Integer = 0
    mutable offset_y: Integer = 0
    mutable offset_z: Integer = 0
    mutable half_x: Integer = 0
    mutable half_y: Integer = 0
    mutable half_z: Integer = 0
}

resource HurtboxDescriptor {
    mutable offset_x: Integer = 0
    mutable offset_y: Integer = 0
    mutable offset_z: Integer = 0
    mutable half_x: Integer = 0
    mutable half_y: Integer = 0
    mutable half_z: Integer = 0
}

fn create_frame_data_entry(
    move_id: Integer,
    startup_ticks: Integer,
    active_ticks: Integer,
    recovery_ticks: Integer,
    damage_milli: Integer,
    stamina_cost_milli: Integer,
    hitstun_ticks: Integer,
    poise_damage_milli: Integer,
    knockback_milli: Integer
) -> FrameDataEntry {
    return FrameDataEntry(
        move_id=move_id,
        startup_ticks=startup_ticks,
        active_ticks=active_ticks,
        recovery_ticks=recovery_ticks,
        damage_milli=damage_milli,
        stamina_cost_milli=stamina_cost_milli,
        hitstun_ticks=hitstun_ticks,
        poise_damage_milli=poise_damage_milli,
        knockback_milli=knockback_milli
    )
}

fn create_hitbox(
    offset_x: Integer, offset_y: Integer, offset_z: Integer,
    half_x: Integer, half_y: Integer, half_z: Integer
) -> HitboxDescriptor {
    return HitboxDescriptor(
        offset_x=offset_x, offset_y=offset_y, offset_z=offset_z,
        half_x=half_x, half_y=half_y, half_z=half_z
    )
}

fn create_hurtbox(
    offset_x: Integer, offset_y: Integer, offset_z: Integer,
    half_x: Integer, half_y: Integer, half_z: Integer
) -> HurtboxDescriptor {
    return HurtboxDescriptor(
        offset_x=offset_x, offset_y=offset_y, offset_z=offset_z,
        half_x=half_x, half_y=half_y, half_z=half_z
    )
}

fn is_in_startup(entry: FrameDataEntry, current_tick: Integer) -> Boolean {
    return current_tick < entry.startup_ticks
}

fn is_in_active(entry: FrameDataEntry, current_tick: Integer) -> Boolean {
    if current_tick < entry.startup_ticks {
        return false
    }
    if current_tick >= entry.startup_ticks + entry.active_ticks {
        return false
    }
    return true
}

fn is_in_recovery(entry: FrameDataEntry, current_tick: Integer) -> Boolean {
    active_end = entry.startup_ticks + entry.active_ticks
    if current_tick < active_end {
        return false
    }
    if current_tick >= active_end + entry.recovery_ticks {
        return false
    }
    return true
}

fn total_frames(entry: FrameDataEntry) -> Integer {
    return entry.startup_ticks + entry.active_ticks + entry.recovery_ticks
}

fn is_move_complete(entry: FrameDataEntry, current_tick: Integer) -> Boolean {
    return current_tick >= total_frames(entry)
}
