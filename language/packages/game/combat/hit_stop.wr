//
// Hit stop: freezes game time briefly on impact for weight and feedback.

resource HitStopState {
    mutable active: Boolean = false
    mutable remaining_ticks: Integer = 0
    mutable strength_milli: Integer = 0
}

fn create_default_hit_stop() -> HitStopState {
    return HitStopState()
}

fn trigger_hit_stop(state: HitStopState, duration_ticks: Integer, strength_milli: Integer) -> HitStopState {
    // Stronger hit stop overrides weaker
    if state.active {
        if strength_milli <= state.strength_milli {
            return state
        }
    }
    return HitStopState(
        active=true,
        remaining_ticks=duration_ticks,
        strength_milli=strength_milli
    )
}

fn tick_hit_stop(state: HitStopState) -> HitStopState {
    if state.active == false {
        return state
    }
    new_remaining = state.remaining_ticks - 1
    if new_remaining <= 0 {
        return HitStopState(
            active=false,
            remaining_ticks=0,
            strength_milli=0
        )
    }
    return HitStopState(
        active=true,
        remaining_ticks=new_remaining,
        strength_milli=state.strength_milli
    )
}

fn is_hit_stopped(state: HitStopState) -> Boolean {
    return state.active
}

fn hit_stop_time_scale_milli(state: HitStopState) -> Integer {
    // Returns 0-1000. 0 = fully frozen, 1000 = normal speed.
    if state.active == false {
        return 1000
    }
    return 0
}

fn hit_stop_strength(state: HitStopState) -> Integer {
    if state.active == false {
        return 0
    }
    return state.strength_milli
}
