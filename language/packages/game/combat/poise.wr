//
// Poise system: tracks stagger threshold. When poise breaks, entity enters stagger state.

resource PoiseState {
    mutable current_milli: Integer = 50000
    mutable max_milli: Integer = 50000
    mutable regen_per_tick_milli: Integer = 200
    mutable broken: Boolean = false
    mutable broken_duration_ticks: Integer = 20
    mutable broken_tick: Integer = 0
}

fn create_default_poise() -> PoiseState {
    return PoiseState()
}

fn create_poise(max_milli: Integer, regen_per_tick_milli: Integer, broken_duration_ticks: Integer) -> PoiseState {
    return PoiseState(
        current_milli=max_milli,
        max_milli=max_milli,
        regen_per_tick_milli=regen_per_tick_milli,
        broken_duration_ticks=broken_duration_ticks
    )
}

fn apply_poise_damage(state: PoiseState, damage_milli: Integer) -> PoiseState {
    if state.broken {
        return state
    }
    new_current = state.current_milli - damage_milli
    if new_current <= 0 {
        return PoiseState(
            current_milli=0,
            max_milli=state.max_milli,
            regen_per_tick_milli=state.regen_per_tick_milli,
            broken=true,
            broken_duration_ticks=state.broken_duration_ticks,
            broken_tick=0
        )
    }
    return PoiseState(
        current_milli=new_current,
        max_milli=state.max_milli,
        regen_per_tick_milli=state.regen_per_tick_milli,
        broken=false,
        broken_duration_ticks=state.broken_duration_ticks,
        broken_tick=0
    )
}

fn tick_poise(state: PoiseState) -> PoiseState {
    if state.broken {
        new_tick = state.broken_tick + 1
        if new_tick >= state.broken_duration_ticks {
            // Recover from stagger
            return PoiseState(
                current_milli=state.max_milli,
                max_milli=state.max_milli,
                regen_per_tick_milli=state.regen_per_tick_milli,
                broken=false,
                broken_duration_ticks=state.broken_duration_ticks,
                broken_tick=0
            )
        }
        return PoiseState(
            current_milli=0,
            max_milli=state.max_milli,
            regen_per_tick_milli=state.regen_per_tick_milli,
            broken=true,
            broken_duration_ticks=state.broken_duration_ticks,
            broken_tick=new_tick
        )
    }

    // Regenerate poise
    new_current = state.current_milli + state.regen_per_tick_milli
    if new_current > state.max_milli {
        new_current = state.max_milli
    }
    return PoiseState(
        current_milli=new_current,
        max_milli=state.max_milli,
        regen_per_tick_milli=state.regen_per_tick_milli,
        broken=false,
        broken_duration_ticks=state.broken_duration_ticks,
        broken_tick=0
    )
}

fn is_poise_broken(state: PoiseState) -> Boolean {
    return state.broken
}

fn poise_ratio_milli(state: PoiseState) -> Integer {
    if state.max_milli <= 0 {
        return 0
    }
    return state.current_milli * 1000 / state.max_milli
}
