//
// Health and damage system with modifiers.

resource HealthState {
    mutable current_milli: Integer = 100000
    mutable max_milli: Integer = 100000
}

resource DamageModifier {
    mutable multiplier_milli: Integer = 1000
    mutable flat_bonus_milli: Integer = 0
    mutable remaining_ticks: Integer = 0
}

fn create_default_health() -> HealthState {
    return HealthState()
}

fn create_health(max_milli: Integer) -> HealthState {
    return HealthState(current_milli=max_milli, max_milli=max_milli)
}

fn create_damage_modifier(
    multiplier_milli: Integer,
    flat_bonus_milli: Integer,
    remaining_ticks: Integer
) -> DamageModifier {
    return DamageModifier(
        multiplier_milli=multiplier_milli,
        flat_bonus_milli=flat_bonus_milli,
        remaining_ticks=remaining_ticks
    )
}

fn apply_damage(state: HealthState, amount_milli: Integer) -> HealthState {
    new_current = state.current_milli - amount_milli
    if new_current < 0 {
        new_current = 0
    }
    return HealthState(
        current_milli=new_current,
        max_milli=state.max_milli
    )
}

fn apply_healing(state: HealthState, amount_milli: Integer) -> HealthState {
    new_current = state.current_milli + amount_milli
    if new_current > state.max_milli {
        new_current = state.max_milli
    }
    return HealthState(
        current_milli=new_current,
        max_milli=state.max_milli
    )
}

fn is_dead(state: HealthState) -> Boolean {
    return state.current_milli <= 0
}

fn health_ratio_milli(state: HealthState) -> Integer {
    if state.max_milli <= 0 {
        return 0
    }
    return state.current_milli * 1000 / state.max_milli
}

fn compute_modified_damage(
    base_damage_milli: Integer,
    modifier: DamageModifier
) -> Integer {
    if modifier.remaining_ticks <= 0 {
        return base_damage_milli
    }
    return base_damage_milli * modifier.multiplier_milli / 1000 + modifier.flat_bonus_milli
}

fn tick_damage_modifier(modifier: DamageModifier) -> DamageModifier {
    if modifier.remaining_ticks <= 0 {
        return DamageModifier()
    }
    return DamageModifier(
        multiplier_milli=modifier.multiplier_milli,
        flat_bonus_milli=modifier.flat_bonus_milli,
        remaining_ticks=modifier.remaining_ticks - 1
    )
}
