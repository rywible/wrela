//
// Game-agnostic world parameter registry. 8 Integer slots, meaning defined by app.

resource WorldParameterRegistry {
    mutable param_0: Integer = 0
    mutable param_1: Integer = 0
    mutable param_2: Integer = 0
    mutable param_3: Integer = 0
    mutable param_4: Integer = 0
    mutable param_5: Integer = 0
    mutable param_6: Integer = 0
    mutable param_7: Integer = 0
}

event WorldParameterChangeEvent {
    mutable slot: Integer = 0
    mutable old_value: Integer = 0
    mutable new_value: Integer = 0
}

fn create_default_world_parameters() -> WorldParameterRegistry {
    return WorldParameterRegistry()
}

fn set_world_parameter(
    registry: WorldParameterRegistry,
    slot: Integer,
    value: Integer
) -> WorldParameterRegistry {
    if slot == 0 { return WorldParameterRegistry(param_0=value, param_1=registry.param_1, param_2=registry.param_2, param_3=registry.param_3, param_4=registry.param_4, param_5=registry.param_5, param_6=registry.param_6, param_7=registry.param_7) }
    if slot == 1 { return WorldParameterRegistry(param_0=registry.param_0, param_1=value, param_2=registry.param_2, param_3=registry.param_3, param_4=registry.param_4, param_5=registry.param_5, param_6=registry.param_6, param_7=registry.param_7) }
    if slot == 2 { return WorldParameterRegistry(param_0=registry.param_0, param_1=registry.param_1, param_2=value, param_3=registry.param_3, param_4=registry.param_4, param_5=registry.param_5, param_6=registry.param_6, param_7=registry.param_7) }
    if slot == 3 { return WorldParameterRegistry(param_0=registry.param_0, param_1=registry.param_1, param_2=registry.param_2, param_3=value, param_4=registry.param_4, param_5=registry.param_5, param_6=registry.param_6, param_7=registry.param_7) }
    if slot == 4 { return WorldParameterRegistry(param_0=registry.param_0, param_1=registry.param_1, param_2=registry.param_2, param_3=registry.param_3, param_4=value, param_5=registry.param_5, param_6=registry.param_6, param_7=registry.param_7) }
    if slot == 5 { return WorldParameterRegistry(param_0=registry.param_0, param_1=registry.param_1, param_2=registry.param_2, param_3=registry.param_3, param_4=registry.param_4, param_5=value, param_6=registry.param_6, param_7=registry.param_7) }
    if slot == 6 { return WorldParameterRegistry(param_0=registry.param_0, param_1=registry.param_1, param_2=registry.param_2, param_3=registry.param_3, param_4=registry.param_4, param_5=registry.param_5, param_6=value, param_7=registry.param_7) }
    if slot == 7 { return WorldParameterRegistry(param_0=registry.param_0, param_1=registry.param_1, param_2=registry.param_2, param_3=registry.param_3, param_4=registry.param_4, param_5=registry.param_5, param_6=registry.param_6, param_7=value) }
    return registry
}

fn get_world_parameter(registry: WorldParameterRegistry, slot: Integer) -> Integer {
    if slot == 0 { return registry.param_0 }
    if slot == 1 { return registry.param_1 }
    if slot == 2 { return registry.param_2 }
    if slot == 3 { return registry.param_3 }
    if slot == 4 { return registry.param_4 }
    if slot == 5 { return registry.param_5 }
    if slot == 6 { return registry.param_6 }
    if slot == 7 { return registry.param_7 }
    return 0
}

fn clamp_world_parameter(
    registry: WorldParameterRegistry,
    slot: Integer,
    min_value: Integer,
    max_value: Integer
) -> WorldParameterRegistry {
    current = get_world_parameter(registry, slot)
    mutable clamped = current
    if clamped < min_value {
        clamped = min_value
    }
    if clamped > max_value {
        clamped = max_value
    }
    if clamped == current {
        return registry
    }
    return set_world_parameter(registry, slot, clamped)
}
