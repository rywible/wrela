//
// Render-lane contracts for compiler-owned WebGPU scene packets.

class RenderScenePacket {
    mutable packet_id: String = "scene"
    mutable world_width: Integer = 800
    mutable world_height: Integer = 600
    mutable instance_capacity: Integer = 256
    mutable pass_profile: String = "depth+opaque+transparent+ui+post"
}

class CameraDescriptor {
    mutable camera_id: String = "main"
    mutable x: Integer = 0
    mutable y: Integer = 0
    mutable z: Integer = 0
    mutable fov_milliradians: Integer = 1047
    mutable near_plane_milli: Integer = 100
    mutable far_plane_milli: Integer = 500000
}

class LightDescriptor {
    mutable light_id: String = "sun"
    mutable kind: String = "directional"
    mutable x: Integer = 0
    mutable y: Integer = 1000
    mutable z: Integer = 0
    mutable intensity_milli: Integer = 1000
}

class MeshDescriptor {
    mutable mesh_id: String = "quad"
    mutable material_id: String = "default"
    mutable chunk_id: String = "runtime-0"
    mutable lod_group: String = "base"
}

class MsdfTextStyle {
    mutable font_face: String = "mono"
    mutable weight: Integer = 500
    mutable size_px: Integer = 14
    mutable edge_softness_milli: Integer = 220
    mutable color_hex: String = "#def4ff"
}

fn create_default_scene_packet() -> RenderScenePacket {
    return RenderScenePacket()
}

fn create_default_camera_descriptor() -> CameraDescriptor {
    return CameraDescriptor()
}

fn create_default_light_descriptor() -> LightDescriptor {
    return LightDescriptor()
}

fn create_default_mesh_descriptor() -> MeshDescriptor {
    return MeshDescriptor()
}

fn create_default_msdf_text_style() -> MsdfTextStyle {
    return MsdfTextStyle()
}
