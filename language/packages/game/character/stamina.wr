//
// Stamina resource with consumption, regeneration, and delay.

resource StaminaState {
    mutable current_milli: Integer = 100000
    mutable max_milli: Integer = 100000
    mutable regen_per_tick_milli: Integer = 500
    mutable regen_delay_ticks: Integer = 30
    mutable ticks_since_consume: Integer = 999
}

fn create_default_stamina() -> StaminaState {
    return StaminaState()
}

fn consume_stamina(state: StaminaState, amount_milli: Integer) -> StaminaState {
    new_current = state.current_milli - amount_milli
    if new_current < 0 {
        new_current = 0
    }
    return StaminaState(
        current_milli=new_current,
        max_milli=state.max_milli,
        regen_per_tick_milli=state.regen_per_tick_milli,
        regen_delay_ticks=state.regen_delay_ticks,
        ticks_since_consume=0
    )
}

fn has_stamina(state: StaminaState, amount_milli: Integer) -> Boolean {
    return state.current_milli >= amount_milli
}

fn tick_stamina_regen(state: StaminaState) -> StaminaState {
    new_ticks = state.ticks_since_consume + 1
    if new_ticks < state.regen_delay_ticks {
        return StaminaState(
            current_milli=state.current_milli,
            max_milli=state.max_milli,
            regen_per_tick_milli=state.regen_per_tick_milli,
            regen_delay_ticks=state.regen_delay_ticks,
            ticks_since_consume=new_ticks
        )
    }

    new_current = state.current_milli + state.regen_per_tick_milli
    if new_current > state.max_milli {
        new_current = state.max_milli
    }
    return StaminaState(
        current_milli=new_current,
        max_milli=state.max_milli,
        regen_per_tick_milli=state.regen_per_tick_milli,
        regen_delay_ticks=state.regen_delay_ticks,
        ticks_since_consume=new_ticks
    )
}

fn stamina_ratio_milli(state: StaminaState) -> Integer {
    if state.max_milli <= 0 {
        return 0
    }
    return state.current_milli * 1000 / state.max_milli
}
