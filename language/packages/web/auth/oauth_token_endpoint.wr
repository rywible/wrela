//
// OAuth2 client_credentials token endpoint helpers.

use {
    get_bytes_from_list,
    get_bytes_from_string,
    get_list_from_bytes,
    get_string_from_bytes
}
from bytes

use get_current_nanoseconds_since_epoch from host/time

use {
    OAuthClientCredentialsGrantRequest,
    OAuthServiceAccountRegistration,
    create_oauth_token_error_response_body,
    create_oauth_token_success_response_body,
    try_to_authenticate_service_account_client,
    try_to_issue_client_credentials_access_token,
    try_to_resolve_granted_scope_values,
    try_to_validate_client_credentials_grant_request
}
from pkg/web/auth/oauth_client_credentials

use {
    WebServiceAccountRegistration,
    try_to_read_service_account_registration
}
from pkg/web/auth/authentication_store

use create_scope_values_from_scope_value_text from pkg/web/auth/bearer_token_authentication

use {
    HttpRequest,
    HttpResponse,
    try_to_parse_json_request_body
}
from host/web_server

use apply_security_headers from pkg/web/security/headers


fn resolve_current_unix_seconds_for_oauth_token_endpoint() -> Integer {
    return get_current_nanoseconds_since_epoch() / 1000000000


}
fn create_oauth_json_response_context(
    status_code: Integer,
    response_body: Map[Any, Any]
) -> HttpResponse {
    response_context = HttpResponse()
    response_context.status_code = status_code

    response_headers = {}
    response_headers.set("Content-Type", "application/json")
    response_headers.set("Cache-Control", "no-store")
    response_headers.set("Pragma", "no-cache")
    response_context.headers = apply_security_headers(response_headers)
    response_context.body = response_body
    return response_context


}
fn create_oauth_error_response_context(
    status_code: Integer,
    error_code: String,
    error_description: String
) -> HttpResponse {
    return create_oauth_json_response_context(
        status_code,
        create_oauth_token_error_response_body(error_code, error_description)
    )


}
fn create_form_field_items_from_text(form_text: String) -> Map[Any, Any] {
    field_items = {}
    form_text_bytes = get_list_from_bytes(get_bytes_from_string(form_text))
    key_bytes = []
    value_bytes = []
    mutable is_parsing_value = false

    for form_text_byte in form_text_bytes {
        if form_text_byte == 38 {
            field_items.set(get_string_from_bytes(get_bytes_from_list(key_bytes)), get_string_from_bytes(get_bytes_from_list(value_bytes))
            )
            key_bytes = []
            value_bytes = []
            is_parsing_value = false
            continue

        }
        if form_text_byte == 61 and not is_parsing_value {
            is_parsing_value = true
            continue

        }
        if is_parsing_value {
            value_bytes.push(form_text_byte)
        }
        else {
            key_bytes.push(form_text_byte)

        }
    }
    mutable has_key_bytes = false
    for key_byte in key_bytes {
        has_key_bytes = true
        if key_byte == key_byte {
            break

        }
    }
    if has_key_bytes {
        field_items.set(get_string_from_bytes(get_bytes_from_list(key_bytes)), get_string_from_bytes(get_bytes_from_list(value_bytes))
        )
    }
    return field_items


}
fn resolve_http_request_body_text(request_context: HttpRequest) -> String {
    match request_context.body {
        String(body_text) {
            return body_text
        }
        default {
            body_text = get_string_from_bytes(request_context.body)
            match body_text {
                String(decoded_body_text) {
                    return decoded_body_text
                }
                default {
                    return ""


                }
            }
        }
    }
}
fn create_oauth_client_credentials_grant_request_from_request_items(
    request_items: Map[Any, Any]
) -> OAuthClientCredentialsGrantRequest {
    grant_request = OAuthClientCredentialsGrantRequest()

    grant_type_value = request_items.get("grant_type")
    match grant_type_value {
        String(grant_type) {
            grant_request.grant_type = grant_type
        }
        default {
            grant_request.grant_type = "client_credentials"

        }
    }
    client_identifier_value = request_items.get("client_identifier")
    match client_identifier_value {
        String(client_identifier) {
            grant_request.client_identifier = client_identifier
        }
        default {
            client_id_value = request_items.get("client_id")
            match client_id_value {
                String(client_id) {
                    grant_request.client_identifier = client_id
                }
                default {
                    grant_request.client_identifier = ""

                }
            }
        }
    }
    client_secret_value = request_items.get("client_secret")
    match client_secret_value {
        String(client_secret) {
            grant_request.client_secret = client_secret
        }
        default {
            grant_request.client_secret = ""

        }
    }
    scope_value = request_items.get("scope")
    match scope_value {
        String(scope_value_text) {
            grant_request.requested_scope_values = create_scope_values_from_scope_value_text(
                scope_value_text
            )
        }
        default {
            grant_request.requested_scope_values = []

        }
    }
    tenant_identifier_value = request_items.get("tenant_identifier")
    match tenant_identifier_value {
        String(tenant_identifier) {
            grant_request.tenant_identifier = tenant_identifier
        }
        default {
            grant_request.tenant_identifier = ""

        }
    }
    subject_identifier_value = request_items.get("subject_identifier")
    match subject_identifier_value {
        String(subject_identifier) {
            grant_request.subject_identifier = subject_identifier
        }
        default {
            grant_request.subject_identifier = ""

        }
    }
    return grant_request


}
fn try_to_resolve_oauth_request_items(request_context: HttpRequest) -> Result[Map[Any, Any]] {
    body_text = resolve_http_request_body_text(request_context)
    if body_text == "" {
        return error "oauth invalid_request: request body is required"

    }
    match try_to_parse_json_request_body(body_text) {
        Ok(request_items) {
            return request_items
        }
        Err(_) {
            return create_form_field_items_from_text(body_text)


        }
    }
}
fn map_oauth_error_to_status_code(error_message: String) -> Integer {
    if oauth_text_has_prefix(error_message, "oauth invalid_client") {
        return 401
    }
    if oauth_text_has_prefix(error_message, "oauth invalid_scope") {
        return 400
    }
    if oauth_text_has_prefix(error_message, "oauth invalid_grant") {
        return 400
    }
    if oauth_text_has_prefix(error_message, "oauth invalid_request") {
        return 400
    }
    return 500


}
fn oauth_text_has_prefix(text: String, prefix: String) -> Boolean {
    text_bytes = get_list_from_bytes(get_bytes_from_string(text))
    prefix_bytes = get_list_from_bytes(get_bytes_from_string(prefix))

    mutable prefix_length = 0
    for prefix_byte in prefix_bytes {
        prefix_length = prefix_length + 1

    }
    mutable text_length = 0
    for text_byte in text_bytes {
        text_length = text_length + 1

    }
    if text_length < prefix_length {
        return false

    }
    mutable prefix_index = 0
    for prefix_byte in prefix_bytes {
        mutable text_index = 0
        mutable has_matched_prefix_byte = false
        for text_byte in text_bytes {
            if text_index == prefix_index {
                if text_byte != prefix_byte {
                    return false
                }
                has_matched_prefix_byte = true
                break
            }
            text_index = text_index + 1
        }
        if not has_matched_prefix_byte {
            return false
        }
        prefix_index = prefix_index + 1
    }
    return true


}
fn create_oauth_error_code_from_message(error_message: String) -> String {
    if oauth_text_has_prefix(error_message, "oauth invalid_client") {
        return "invalid_client"
    }
    if oauth_text_has_prefix(error_message, "oauth invalid_scope") {
        return "invalid_scope"
    }
    if oauth_text_has_prefix(error_message, "oauth invalid_grant") {
        return "invalid_grant"
    }
    if oauth_text_has_prefix(error_message, "oauth invalid_request") {
        return "invalid_request"
    }
    return "server_error"


}
fn create_oauth_service_account_registration_from_web_store_registration(
    web_store_registration: WebServiceAccountRegistration
) -> OAuthServiceAccountRegistration {
    oauth_registration = OAuthServiceAccountRegistration()
    oauth_registration.client_identifier = web_store_registration.client_identifier
    oauth_registration.hashed_client_secret = web_store_registration.hashed_client_secret
    oauth_registration.allowed_scope_values = web_store_registration.allowed_scope_values
    oauth_registration.tenant_identifier = web_store_registration.tenant_identifier
    return oauth_registration


}
fn try_to_create_oauth_client_credentials_token_response_context(
    request_context: HttpRequest,
    authentication_store_handle: Integer,
    issuer: String,
    audience: String,
    key_id: String,
    access_token_ttl_seconds: Integer
) -> Result[HttpResponse] {
    if request_context.method != "POST" {
        return create_oauth_error_response_context(
            405,
            "invalid_request",
            "oauth token endpoint only allows POST"
        )

    }
    request_items_result = try_to_resolve_oauth_request_items(request_context)
    match request_items_result {
        Ok(request_items) {
            grant_request = create_oauth_client_credentials_grant_request_from_request_items(
                request_items
            )

            validated_grant_request_result = try_to_validate_client_credentials_grant_request(
                grant_request
            )
            match validated_grant_request_result {
                Ok(validated_grant_request) {
                    registration_result = try_to_read_service_account_registration(
                        authentication_store_handle,
                        validated_grant_request.client_identifier
                    )
                    match registration_result {
                        Ok(web_store_registration) {
                            service_account_registration = create_oauth_service_account_registration_from_web_store_registration(
                                web_store_registration
                            )
                            authenticated_registration_result = try_to_authenticate_service_account_client(
                                validated_grant_request,
                                [service_account_registration]
                            )
                            match authenticated_registration_result {
                                Ok(authenticated_service_account_registration) {
                                    granted_scope_values_result = try_to_resolve_granted_scope_values(
                                        validated_grant_request.requested_scope_values,
                                        authenticated_service_account_registration.allowed_scope_values
                                    )
                                    match granted_scope_values_result {
                                        Ok(granted_scope_values) {
                                            issued_access_token_result = try_to_issue_client_credentials_access_token(
                                                validated_grant_request,
                                                authenticated_service_account_registration,
                                                granted_scope_values,
                                                issuer,
                                                audience,
                                                key_id,
                                                resolve_current_unix_seconds_for_oauth_token_endpoint(),
                                                access_token_ttl_seconds
                                            )
                                            match issued_access_token_result {
                                                Ok(issued_access_token) {
                                                    return create_oauth_json_response_context(
                                                        200,
                                                        create_oauth_token_success_response_body(
                                                            issued_access_token
                                                        )
                                                    )
                                                }
                                                Err(error_message) {
                                                    return create_oauth_error_response_context(
                                                        map_oauth_error_to_status_code(
                                                            error_message
                                                        ),
                                                        create_oauth_error_code_from_message(
                                                            error_message
                                                        ),
                                                        error_message
                                                    )
                                                }
                                            }
                                        }
                                        Err(error_message) {
                                            return create_oauth_error_response_context(
                                                map_oauth_error_to_status_code(error_message),
                                                create_oauth_error_code_from_message(error_message),
                                                error_message
                                            )
                                        }
                                    }
                                }
                                Err(error_message) {
                                    return create_oauth_error_response_context(
                                        map_oauth_error_to_status_code(error_message),
                                        create_oauth_error_code_from_message(error_message),
                                        error_message
                                    )
                                }
                            }
                        }
                        Err(error_message) {
                            return create_oauth_error_response_context(
                                401,
                                "invalid_client",
                                error_message
                            )
                        }
                    }
                }
                Err(error_message) {
                    return create_oauth_error_response_context(
                        map_oauth_error_to_status_code(error_message),
                        create_oauth_error_code_from_message(error_message),
                        error_message
                    )
                }
            }
        }
        Err(error_message) {
            return create_oauth_error_response_context(
                400,
                "invalid_request",
                error_message
            )
        }
    }
}
