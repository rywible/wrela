//
// Refresh token exchange endpoint helpers.

use {
    get_bytes_from_string,
    get_list_from_bytes,
    get_string_from_bytes
}
from bytes

use get_current_nanoseconds_since_epoch from host/time

use {
    OAuthClientCredentialsGrantRequest,
    OAuthIssuedAccessToken,
    OAuthServiceAccountRegistration,
    create_oauth_token_error_response_body,
    create_oauth_token_success_response_body,
    try_to_issue_client_credentials_access_token
}
from pkg/web/auth/oauth_client_credentials

use {
    WebAuthenticationStoreConfiguration,
    create_web_authentication_store_configuration_from_environment
}
from host/web_authentication

use create_scope_values_from_scope_value_text from pkg/web/auth/bearer_token_authentication

use {
    WebRefreshTokenRecord,
    try_to_read_refresh_token_record
}
from pkg/web/auth/authentication_store

use {
    try_to_rotate_refresh_token_record
}
from pkg/web/auth/refresh_token_lifecycle

use {
    HttpRequest,
    HttpResponse,
    try_to_parse_json_request_body
}
from host/web_server

use apply_security_headers from pkg/web/security/headers


fn resolve_current_unix_seconds_for_refresh_token_endpoint() -> Integer {
    return get_current_nanoseconds_since_epoch() / 1000000000


}
fn create_refresh_token_json_response_context(
    status_code: Integer,
    response_body: Map[Any, Any]
) -> HttpResponse {
    response_context = HttpResponse()
    response_context.status_code = status_code

    response_headers = {}
    response_headers.set("Content-Type", "application/json")
    response_headers.set("Cache-Control", "no-store")
    response_headers.set("Pragma", "no-cache")
    response_context.headers = apply_security_headers(response_headers)
    response_context.body = response_body
    return response_context


}
fn create_refresh_token_error_response_context(
    status_code: Integer,
    error_code: String,
    error_description: String
) -> HttpResponse {
    return create_refresh_token_json_response_context(
        status_code,
        create_oauth_token_error_response_body(error_code, error_description)
    )


}
fn resolve_http_request_body_text_for_refresh_token_exchange(
    request_context: HttpRequest
) -> String {
    match request_context.body {
        String(body_text) {
            return body_text
        }
        default {
            body_text = get_string_from_bytes(request_context.body)
            match body_text {
                String(decoded_body_text) {
                    return decoded_body_text
                }
                default {
                    return ""


                }
            }
        }
    }
}
fn try_to_resolve_refresh_token_identifier_from_request_context(
    request_context: HttpRequest
) -> Result[String] {
    request_body_text = resolve_http_request_body_text_for_refresh_token_exchange(request_context)
    if request_body_text == "" {
        return error "oauth invalid_request: request body is required"

    }
    request_items_result = try_to_parse_json_request_body(request_body_text)
    match request_items_result {
        Ok(request_items) {
            refresh_token_value = request_items.get("refresh_token")
            match refresh_token_value {
                String(refresh_token_identifier) {
                    if refresh_token_identifier == "" {
                        return error "oauth invalid_request: refresh_token is required"
                    }
                    return refresh_token_identifier
                }
                default {
                    return error "oauth invalid_request: refresh_token is required"
                }
            }
        }
        Err(error_message) {
            return error error_message


        }
    }
}
fn create_oauth_service_account_registration_from_refresh_token_record(
    refresh_token_record: WebRefreshTokenRecord,
    granted_scope_values: List[String]
) -> OAuthServiceAccountRegistration {
    service_account_registration = OAuthServiceAccountRegistration()
    service_account_registration.client_identifier = refresh_token_record.client_identifier
    service_account_registration.hashed_client_secret = ""
    service_account_registration.allowed_scope_values = granted_scope_values
    service_account_registration.tenant_identifier = refresh_token_record.tenant_identifier
    return service_account_registration


}
fn create_oauth_client_credentials_grant_request_from_refresh_token_record(
    refresh_token_record: WebRefreshTokenRecord,
    granted_scope_values: List[String]
) -> OAuthClientCredentialsGrantRequest {
    grant_request = OAuthClientCredentialsGrantRequest()
    grant_request.grant_type = "client_credentials"
    grant_request.client_identifier = refresh_token_record.client_identifier
    grant_request.client_secret = ""
    grant_request.requested_scope_values = granted_scope_values
    grant_request.tenant_identifier = refresh_token_record.tenant_identifier
    grant_request.subject_identifier = refresh_token_record.subject_identifier
    return grant_request


}
fn create_refresh_token_success_response_body(
    issued_access_token: OAuthIssuedAccessToken,
    refresh_token_identifier: String
) -> Map[Any, Any] {
    token_response_items = create_oauth_token_success_response_body(issued_access_token)
    token_response_items.set("refresh_token", refresh_token_identifier)
    return token_response_items


}
fn map_refresh_token_error_to_status_code(error_message: String) -> Integer {
    if refresh_token_endpoint_text_has_prefix(error_message, "oauth invalid_request") {
        return 400
    }
    if refresh_token_endpoint_text_has_prefix(error_message, "refresh token lifecycle") {
        return 400
    }
    if refresh_token_endpoint_text_has_prefix(error_message, "auth store") {
        return 401
    }
    return 500


}
fn create_refresh_token_error_code_from_message(error_message: String) -> String {
    if refresh_token_endpoint_text_has_prefix(error_message, "oauth invalid_request") {
        return "invalid_request"
    }
    if refresh_token_endpoint_text_has_prefix(error_message, "refresh token lifecycle") {
        return "invalid_grant"
    }
    if refresh_token_endpoint_text_has_prefix(error_message, "auth store") {
        return "invalid_grant"
    }
    return "server_error"


}
fn refresh_token_endpoint_text_has_prefix(text: String, prefix: String) -> Boolean {
    text_bytes = get_list_from_bytes(get_bytes_from_string(text))
    prefix_bytes = get_list_from_bytes(get_bytes_from_string(prefix))

    mutable prefix_length = 0
    for prefix_byte in prefix_bytes {
        prefix_length = prefix_length + 1

    }
    mutable text_length = 0
    for text_byte in text_bytes {
        text_length = text_length + 1

    }
    if text_length < prefix_length {
        return false

    }
    mutable prefix_index = 0
    for prefix_byte in prefix_bytes {
        mutable text_index = 0
        mutable has_matched_prefix_byte = false
        for text_byte in text_bytes {
            if text_index == prefix_index {
                if text_byte != prefix_byte {
                    return false
                }
                has_matched_prefix_byte = true
                break
            }
            text_index = text_index + 1
        }
        if not has_matched_prefix_byte {
            return false
        }
        prefix_index = prefix_index + 1
    }
    return true


}
fn try_to_create_refresh_token_exchange_response_context(
    request_context: HttpRequest,
    authentication_store_handle: Integer,
    issuer: String,
    audience: String,
    key_id: String,
    access_token_ttl_seconds: Integer,
    refresh_token_ttl_seconds: Integer,
    refresh_token_rotation_grace_seconds: Integer
) -> Result[HttpResponse] {
    if request_context.method != "POST" {
        return create_refresh_token_error_response_context(
            405,
            "invalid_request",
            "refresh token endpoint only allows POST"
        )

    }
    refresh_token_identifier_result = try_to_resolve_refresh_token_identifier_from_request_context(
        request_context
    )
    match refresh_token_identifier_result {
        Ok(presented_refresh_token_identifier) {
            store_configuration = create_web_authentication_store_configuration_from_environment()
            store_configuration.refresh_token_ttl_seconds = refresh_token_ttl_seconds
            store_configuration.refresh_token_rotation_grace_seconds = refresh_token_rotation_grace_seconds

            rotated_refresh_token_record_result = try_to_rotate_refresh_token_record(
                authentication_store_handle,
                store_configuration,
                presented_refresh_token_identifier
            )
            match rotated_refresh_token_record_result {
                Ok(rotated_refresh_token_record) {
                    rotated_record_result = try_to_read_refresh_token_record(
                        authentication_store_handle,
                        rotated_refresh_token_record.refresh_token_identifier
                    )
                    match rotated_record_result {
                        Ok(rotated_record) {
                            granted_scope_values = create_scope_values_from_scope_value_text(
                                rotated_record.scope_value_text
                            )
                            service_account_registration = create_oauth_service_account_registration_from_refresh_token_record(
                                rotated_record,
                                granted_scope_values
                            )
                            grant_request = create_oauth_client_credentials_grant_request_from_refresh_token_record(
                                rotated_record,
                                granted_scope_values
                            )
                            issued_access_token_result = try_to_issue_client_credentials_access_token(
                                grant_request,
                                service_account_registration,
                                granted_scope_values,
                                issuer,
                                audience,
                                key_id,
                                resolve_current_unix_seconds_for_refresh_token_endpoint(),
                                access_token_ttl_seconds
                            )
                            match issued_access_token_result {
                                Ok(issued_access_token) {
                                    return create_refresh_token_json_response_context(
                                        200,
                                        create_refresh_token_success_response_body(
                                            issued_access_token,
                                            rotated_record.refresh_token_identifier
                                        )
                                    )
                                }
                                Err(error_message) {
                                    return create_refresh_token_error_response_context(
                                        map_refresh_token_error_to_status_code(error_message),
                                        create_refresh_token_error_code_from_message(error_message),
                                        error_message
                                    )
                                }
                            }
                        }
                        Err(error_message) {
                            return create_refresh_token_error_response_context(
                                map_refresh_token_error_to_status_code(error_message),
                                create_refresh_token_error_code_from_message(error_message),
                                error_message
                            )
                        }
                    }
                }
                Err(error_message) {
                    return create_refresh_token_error_response_context(
                        map_refresh_token_error_to_status_code(error_message),
                        create_refresh_token_error_code_from_message(error_message),
                        error_message
                    )
                }
            }
        }
        Err(error_message) {
            return create_refresh_token_error_response_context(
                map_refresh_token_error_to_status_code(error_message),
                create_refresh_token_error_code_from_message(error_message),
                error_message
            )
        }
    }
}
