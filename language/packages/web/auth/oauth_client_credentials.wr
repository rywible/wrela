//
// OAuth2 client_credentials helpers for service-account style agent access.

use {
    try_to_generate_secure_token,
    try_to_sign_json_web_token,
    try_to_verify_password_hash
}
from host/web_authentication

use try_to_render_json_response_body from host/web_server

fn try_to_render_oauth_json_text(value: Map[Any, Any]) -> Result[String] {
    return try_to_render_json_response_body(value)

}
class OAuthServiceAccountRegistration {
    mutable client_identifier: String = ""
    mutable hashed_client_secret: String = ""
    mutable allowed_scope_values: List[String] = []
    mutable tenant_identifier: String = ""

}
class OAuthClientCredentialsGrantRequest {
    mutable grant_type: String = "client_credentials"
    mutable client_identifier: String = ""
    mutable client_secret: String = ""
    mutable requested_scope_values: List[String] = []
    mutable tenant_identifier: String = ""
    mutable subject_identifier: String = ""

}
class OAuthIssuedAccessToken {
    mutable access_token: String = ""
    mutable token_type: String = "Bearer"
    mutable expires_in_seconds: Integer = 900
    mutable scope_values: List[String] = []
    mutable issued_at_unix_seconds: Integer = 0
    mutable expires_at_unix_seconds: Integer = 0


}
fn create_default_oauth_client_credentials_grant_request(
) -> OAuthClientCredentialsGrantRequest {
    return OAuthClientCredentialsGrantRequest()


}
fn create_default_oauth_service_account_registration(
) -> OAuthServiceAccountRegistration {
    return OAuthServiceAccountRegistration()


}
fn try_to_validate_client_credentials_grant_request(
    grant_request: OAuthClientCredentialsGrantRequest
) -> Result[OAuthClientCredentialsGrantRequest] {
    if grant_request.grant_type != "client_credentials" {
        return error "oauth invalid_grant: grant_type must be client_credentials"
    }
    if grant_request.client_identifier == "" {
        return error "oauth invalid_request: client_identifier is required"
    }
    if grant_request.client_secret == "" {
        return error "oauth invalid_request: client_secret is required"
    }
    return grant_request


}
fn try_to_authenticate_service_account_client(
    grant_request: OAuthClientCredentialsGrantRequest,
    service_account_registrations: List[OAuthServiceAccountRegistration]
) -> Result[OAuthServiceAccountRegistration] {
    mutable has_matched_client_identifier = false

    for registration in service_account_registrations {
        if registration.client_identifier != grant_request.client_identifier {
            continue

        }
        has_matched_client_identifier = true

        verification_result = try_to_verify_password_hash(
            grant_request.client_secret,
            registration.hashed_client_secret
        )
        match verification_result {
            Ok(is_valid_client_secret) {
                if is_valid_client_secret == 1 and registration.tenant_identifier != "" and grant_request.tenant_identifier != registration.tenant_identifier {
                    return error "oauth invalid_request: tenant binding does not match"
                }
                if is_valid_client_secret == 1 {
                    return registration
                }
            }
            Err(_) {
                return error "oauth invalid_client: failed to verify client secret"

            }
        }
    }
    if has_matched_client_identifier {
        return error "oauth invalid_client: client secret is not valid"
    }
    return error "oauth invalid_client: unknown client_identifier"


}
fn scope_values_has_scope_value(
    scope_values: List[String],
    target_scope_value: String
) -> Boolean {
    for scope_value in scope_values {
        if scope_value == target_scope_value {
            return true
        }
    }
    return false


}
fn create_scope_values_copy(scope_values: List[String]) -> List[String] {
    copied_scope_values = []
    for scope_value in scope_values {
        copied_scope_values.push(scope_value)
    }
    return copied_scope_values


}
fn try_to_resolve_granted_scope_values(
    requested_scope_values: List[String],
    allowed_scope_values: List[String]
) -> Result[List[String]] {
    mutable has_requested_scope_values = false
    for requested_scope_value in requested_scope_values {
        has_requested_scope_values = true
        if (scope_values_has_scope_value(allowed_scope_values, requested_scope_value) == false) {
            return error "oauth invalid_scope: requested scope is not allowed"

        }
    }
    if not has_requested_scope_values {
        return create_scope_values_copy(allowed_scope_values)

    }
    granted_scope_values = []
    for requested_scope_value in requested_scope_values {
        granted_scope_values.push(requested_scope_value)
    }
    return granted_scope_values


}
fn create_scope_value_text(scope_values: List[String]) -> String {
    mutable scope_value_text = ""
    mutable is_first_scope_value = true
    for scope_value in scope_values {
        if is_first_scope_value {
            scope_value_text = scope_value
            is_first_scope_value = false
        }
        else {
            scope_value_text = scope_value_text + " " + scope_value
        }
    }
    return scope_value_text


}
fn try_to_issue_client_credentials_access_token(
    grant_request: OAuthClientCredentialsGrantRequest,
    service_account_registration: OAuthServiceAccountRegistration,
    granted_scope_values: List[String],
    issuer: String,
    audience: String,
    key_id: String,
    issued_at_unix_seconds: Integer,
    requested_access_token_lifetime_seconds: Integer
) -> Result[OAuthIssuedAccessToken] {
    mutable access_token_lifetime_seconds = requested_access_token_lifetime_seconds
    if access_token_lifetime_seconds <= 0 {
        access_token_lifetime_seconds = 900

    }
    mutable subject_identifier = grant_request.subject_identifier
    if subject_identifier == "" {
        subject_identifier = grant_request.client_identifier

    }
    expires_at_unix_seconds = issued_at_unix_seconds + access_token_lifetime_seconds

    claims_payload_items = {}
    claims_payload_items.set("iss", issuer)
    claims_payload_items.set("aud", audience)
    claims_payload_items.set("sub", subject_identifier)
    claims_payload_items.set("client_id", grant_request.client_identifier)
    claims_payload_items.set("scope", create_scope_value_text(granted_scope_values)
    )
    claims_payload_items.set("iat", issued_at_unix_seconds)
    claims_payload_items.set("exp", expires_at_unix_seconds)
    json_web_token_identifier_result = try_to_generate_secure_token(24)
    match json_web_token_identifier_result {
        Ok(json_web_token_identifier) {
            claims_payload_items.set("jti", json_web_token_identifier)
        }
        Err(_) {
            nothing

        }
    }
    if service_account_registration.tenant_identifier != "" {
        claims_payload_items.set("tenant_id", service_account_registration.tenant_identifier)

    }
    claims_json_result = try_to_render_oauth_json_text(claims_payload_items)
    match claims_json_result {
        Ok(claims_json) {
            match try_to_sign_json_web_token(claims_json, key_id) {
                Ok(access_token) {
                    issued_access_token = OAuthIssuedAccessToken()
                    issued_access_token.access_token = access_token
                    issued_access_token.expires_in_seconds = access_token_lifetime_seconds
                    issued_access_token.scope_values = create_scope_values_copy(granted_scope_values)
                    issued_access_token.issued_at_unix_seconds = issued_at_unix_seconds
                    issued_access_token.expires_at_unix_seconds = expires_at_unix_seconds
                    return issued_access_token
                }
                Err(signing_error_message) {
                    if signing_error_message != "" {
                        return error "oauth server_error: failed to sign access token"
                    }
                    return error "oauth server_error: failed to sign access token"
                }
            }
        }
        Err(claims_json_error_message) {
            if claims_json_error_message != "" {
                return error "oauth server_error: failed to serialize jwt claims"
            }
            return error "oauth server_error: failed to serialize jwt claims"


        }
    }
}
fn create_oauth_token_success_response_body(
    issued_access_token: OAuthIssuedAccessToken
) -> Map[Any, Any] {
    token_response_items = {}
    token_response_items.set("access_token", issued_access_token.access_token)
    token_response_items.set("token_type", issued_access_token.token_type)
    token_response_items.set("expires_in", issued_access_token.expires_in_seconds)
    token_response_items.set("scope", create_scope_value_text(issued_access_token.scope_values)
    )
    return token_response_items


}
fn create_oauth_token_error_response_body(
    error_code: String,
    error_description: String
) -> Map[Any, Any] {
    token_error_items = {}
    token_error_items.set("error", error_code)
    token_error_items.set("error_description", error_description)
    return token_error_items
}
