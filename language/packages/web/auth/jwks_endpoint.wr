//
// JSON Web Key Set endpoint response helpers.

use try_to_get_json_web_key_set_document from pkg/web/auth/session

use {
    HttpResponse,
    create_http_json_error_response_context
}
from host/web_server


fn create_json_web_key_set_response_context() -> HttpResponse {
    match try_to_get_json_web_key_set_document() {
        Ok(json_web_key_set_document) {
            response_context = HttpResponse()
            response_context.status_code = 200
            response_headers = {}
            response_headers.set("Content-Type", "application/json")
            response_context.headers = response_headers
            response_context.body = json_web_key_set_document
            return response_context
        }
        Err(_) {
            return create_http_json_error_response_context(
                500,
                "server_error",
                "failed to render jwks document"
            )
        }
    }
}
