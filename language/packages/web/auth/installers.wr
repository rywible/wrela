//
// Explicit installation configuration classes for HTTP authentication features.


class OAuthClientCredentialsAuthenticationInstallationConfiguration {
    issuer: String
    audience: String
    key_identifier: String
    token_path: String = "/oauth/token"
    access_token_ttl_seconds: Integer = 900


}
class RefreshTokenExchangeInstallationConfiguration {
    issuer: String
    audience: String
    key_identifier: String
    refresh_path: String = "/auth/refresh"
    access_token_ttl_seconds: Integer = 900
    refresh_token_ttl_seconds: Integer = 2592000
    refresh_token_rotation_grace_seconds: Integer = 30


}
class BearerJsonWebTokenAuthenticationMethodConfiguration {
    authentication_method_identifier: String
    enforce_revocation_check: Boolean = true


}
class JsonWebKeySetRouteInstallationConfiguration {
    json_web_key_set_path: String = "/.well-known/jwks.json"
}
