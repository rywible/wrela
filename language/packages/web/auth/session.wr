//
// Session and token issuance helpers.

use {
    create_http_only_secure_cookie_header,
    try_to_generate_secure_token,
    try_to_hash_password,
    try_to_render_json_web_key_set_document,
    try_to_sign_json_web_token,
    try_to_verify_password_hash,
    try_to_verify_json_web_token
}
from host/web_authentication

class PasswordCredential {
    email_address: String = ""
    password: String = ""

}
fn try_to_hash_password_credential(password: String) -> Result[String] {
    return try_to_hash_password(password)

}
fn try_to_verify_password_credential(
    password: String,
    hashed_password: String
) -> Result[Integer] {
    return try_to_verify_password_hash(password, hashed_password)

}
fn try_to_issue_access_token(claims_json: String, key_id: String) -> Result[String] {
    return try_to_sign_json_web_token(claims_json, key_id)

}
fn try_to_validate_access_token(token: String) -> Result[String] {
    return try_to_verify_json_web_token(token)

}
fn try_to_issue_refresh_token() -> Result[String] {
    return try_to_generate_secure_token(48)

}
fn build_access_cookie_header(access_token: String) -> String {
    return create_http_only_secure_cookie_header(
        name="wrela_access_token",
        value=access_token,
        max_age_seconds="900",
        path="/"
    )

}
fn build_refresh_cookie_header(refresh_token: String) -> String {
    return create_http_only_secure_cookie_header(
        name="wrela_refresh_token",
        value=refresh_token,
        max_age_seconds="2592000",
        path="/auth"
    )

}
fn try_to_get_json_web_key_set_document() -> Result[String] {
    return try_to_render_json_web_key_set_document()
}
