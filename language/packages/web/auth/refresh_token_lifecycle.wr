//
// Refresh token issuance, validation, and rotation helpers backed by the auth store.

use get_current_nanoseconds_since_epoch from host/time

use {
    WebAuthenticationStoreConfiguration,
    create_web_authentication_store_configuration_from_environment,
    try_to_generate_secure_token
}
from host/web_authentication

use {
    WebRefreshTokenRecord,
    try_to_read_refresh_token_record,
    try_to_store_refresh_token_record
}
from pkg/web/auth/authentication_store


fn create_default_refresh_token_lifecycle_configuration(
) -> WebAuthenticationStoreConfiguration {
    return create_web_authentication_store_configuration_from_environment()


}
fn resolve_current_unix_seconds() -> Integer {
    return get_current_nanoseconds_since_epoch() / 1000000000


}
fn refresh_token_record_is_active(
    refresh_token_record: WebRefreshTokenRecord,
    current_unix_seconds: Integer,
    refresh_token_rotation_grace_seconds: Integer
) -> Boolean {
    if refresh_token_record.expires_at_unix_seconds < current_unix_seconds {
        return false

    }
    if not refresh_token_record.rotation_state {
        return true

    }
    if refresh_token_record.next_refresh_token_identifier == "" {
        return false

    }
    grace_expiration_seconds = refresh_token_record.expires_at_unix_seconds + refresh_token_rotation_grace_seconds
    if current_unix_seconds <= grace_expiration_seconds {
        return true
    }
    return false


}
fn try_to_issue_refresh_token_record(
    authentication_store_handle: Integer,
    configuration: WebAuthenticationStoreConfiguration,
    subject_identifier: String,
    client_identifier: String,
    tenant_identifier: String,
    scope_value_text: String
) -> Result[WebRefreshTokenRecord] {
    if subject_identifier == "" {
        return error "refresh token lifecycle: subject_identifier is required"
    }
    if client_identifier == "" {
        return error "refresh token lifecycle: client_identifier is required"

    }
    refresh_token_identifier_result = try_to_generate_secure_token(48)
    refresh_token_family_identifier_result = try_to_generate_secure_token(24)

    match refresh_token_identifier_result {
        Ok(refresh_token_identifier) {
            match refresh_token_family_identifier_result {
                Ok(refresh_token_family_identifier) {
                    current_unix_seconds = resolve_current_unix_seconds()
                    refresh_token_record = WebRefreshTokenRecord()
                    refresh_token_record.refresh_token_identifier = refresh_token_identifier
                    refresh_token_record.refresh_token_family_identifier = refresh_token_family_identifier
                    refresh_token_record.subject_identifier = subject_identifier
                    refresh_token_record.client_identifier = client_identifier
                    refresh_token_record.tenant_identifier = tenant_identifier
                    refresh_token_record.scope_value_text = scope_value_text
                    refresh_token_record.expires_at_unix_seconds = current_unix_seconds + configuration.refresh_token_ttl_seconds

                    match try_to_store_refresh_token_record(
                        authentication_store_handle,
                        refresh_token_record
                    ) {
                        Ok(_) {
                            return refresh_token_record
                        }
                        Err(error_message) {
                            return error error_message
                        }
                    }
                }
                Err(error_message) {
                    return error error_message
                }
            }
        }
        Err(error_message) {
            return error error_message


        }
    }
}
fn try_to_rotate_refresh_token_record(
    authentication_store_handle: Integer,
    configuration: WebAuthenticationStoreConfiguration,
    presented_refresh_token_identifier: String
) -> Result[WebRefreshTokenRecord] {
    if presented_refresh_token_identifier == "" {
        return error "refresh token lifecycle: presented_refresh_token_identifier is required"

    }
    current_unix_seconds = resolve_current_unix_seconds()
    current_refresh_token_record_result = try_to_read_refresh_token_record(
        authentication_store_handle,
        presented_refresh_token_identifier
    )

    match current_refresh_token_record_result {
        Ok(current_refresh_token_record) {
            if not refresh_token_record_is_active(
                current_refresh_token_record,
                current_unix_seconds,
                configuration.refresh_token_rotation_grace_seconds
            ) {
                return error "refresh token lifecycle: refresh token is inactive or expired"

            }
            if current_refresh_token_record.rotation_state {
                return error "refresh token lifecycle: refresh token already rotated"

            }
            next_refresh_token_identifier_result = try_to_generate_secure_token(48)
            match next_refresh_token_identifier_result {
                Ok(next_refresh_token_identifier) {
                    next_refresh_token_record = WebRefreshTokenRecord()
                    next_refresh_token_record.refresh_token_identifier = next_refresh_token_identifier
                    next_refresh_token_record.refresh_token_family_identifier = current_refresh_token_record.refresh_token_family_identifier
                    next_refresh_token_record.subject_identifier = current_refresh_token_record.subject_identifier
                    next_refresh_token_record.client_identifier = current_refresh_token_record.client_identifier
                    next_refresh_token_record.tenant_identifier = current_refresh_token_record.tenant_identifier
                    next_refresh_token_record.scope_value_text = current_refresh_token_record.scope_value_text
                    next_refresh_token_record.expires_at_unix_seconds = current_unix_seconds + configuration.refresh_token_ttl_seconds

                    current_refresh_token_record.rotation_state = true
                    current_refresh_token_record.next_refresh_token_identifier = next_refresh_token_identifier
                    match try_to_store_refresh_token_record(
                        authentication_store_handle,
                        current_refresh_token_record
                    ) {
                        Ok(_) {
                            match try_to_store_refresh_token_record(
                                authentication_store_handle,
                                next_refresh_token_record
                            ) {
                                Ok(_) {
                                    return next_refresh_token_record
                                }
                                Err(error_message) {
                                    return error error_message
                                }
                            }
                        }
                        Err(error_message) {
                            return error error_message
                        }
                    }
                }
                Err(error_message) {
                    return error error_message
                }
            }
        }
        Err(error_message) {
            return error error_message
        }
    }
}
