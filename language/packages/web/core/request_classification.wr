//
// HTTP request path classification helpers for application routing.

use {
    get_namespace_prefix_match_flag,
    check_reserved_database_namespace_path
}
from host/web_server


class HttpRouteClassification {
    mutable database_namespace_path_match: Boolean = false
    mutable oauth_token_path_match: Boolean = false
    mutable refresh_token_path_match: Boolean = false
    mutable json_web_key_set_path_match: Boolean = false
    mutable api_namespace_path_match: Boolean = false
    mutable auth_namespace_path_match: Boolean = false
    mutable single_page_application_namespace_path_match: Boolean = false


}
fn path_is_namespace_path(path: String, namespace_prefix: String) -> Boolean {
    if path == namespace_prefix {
        return true
    }
    if path == namespace_prefix + "/" {
        return true
    }
    if get_namespace_prefix_match_flag(path, namespace_prefix + "/") == 1 {
        return true
    }
    return false


}
fn create_http_route_classification(path: String) -> HttpRouteClassification {
    classification = HttpRouteClassification()
    classification.database_namespace_path_match = check_reserved_database_namespace_path(path)
    classification.oauth_token_path_match = (path == "/oauth/token")
    classification.refresh_token_path_match = (path == "/auth/refresh")
    classification.json_web_key_set_path_match = (path == "/.well-known/jwks.json")
    classification.api_namespace_path_match = path_is_namespace_path(path, "/api")
    classification.auth_namespace_path_match = path_is_namespace_path(path, "/auth")
    classification.single_page_application_namespace_path_match = path_is_namespace_path(path, "/app")
    return classification
}
