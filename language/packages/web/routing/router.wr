//
// Route policy helpers.

use check_reserved_database_namespace_path from host/web_server

class RouteAuthorizationPolicy {
    mutable required_scope: String = ""


}
fn route_is_reserved(path: String) -> Boolean {
    return check_reserved_database_namespace_path(path)


}
fn route_is_authorized(
    principal_scopes: List[String],
    policy: RouteAuthorizationPolicy
) -> Boolean {
    if policy.required_scope == "" {
        return true

    }
    for scope in principal_scopes {
        if scope == policy.required_scope {
            return true
        }
    }
    return false
}
