    return Surface(
        albedo=vec3(220.0, 60.0, 60.0),
        roughness=0.25,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material right_tie_surface(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(60.0, 120.0, 220.0),
        roughness=0.25,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
