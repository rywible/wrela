field conservative distance wrapped_stack_field(p: Vec3) -> F32 {
    mirror = vec3(1.0, 0.0, 0.0) {
        repeat = vec3(2.0, 0.0, 0.0) {
            transform = vec3(0.0, 0.0, 0.0) {
                instance = Transform3(
                    matrix=mat4_cols(
                        vec4(1.0, 0.0, 0.0, 0.0),
                        vec4(0.0, 1.0, 0.0, 0.0),
                        vec4(0.0, 0.0, 1.0, 0.0),
                        vec4(0.0, 0.0, 0.0, 1.0)
                    ),
                    inverse=mat4_cols(
                        vec4(1.0, 0.0, 0.0, 0.0),
                        vec4(0.0, 1.0, 0.0, 0.0),
                        vec4(0.0, 0.0, 1.0, 0.0),
                        vec4(0.0, 0.0, 0.0, 1.0)
                    )
                ) {
                    sphere(radius=0.5)
                }
            }
        }
    }
}

field conservative distance wrapped_decoy_field(p: Vec3) -> F32 {
    transform = vec3(4.0, 0.0, 0.0) {
        sphere(radius=0.5)
    }
}

