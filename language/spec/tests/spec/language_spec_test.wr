fn test_boolean_provenance_ties_and_wrapper_stack_stay_stable() -> Nothing {
    tie_left_scene = capture tie_left_shape
    tie_right_scene = capture tie_right_shape
    tie_union_scene = capture tie_union_shape
    tie_intersection_scene = capture tie_intersection_shape
    wrapped_stack_scene = capture wrapped_stack_shape
    wrapped_scene_capture = capture wrapped_scene_shape
    tie_left_hit = trace_shape(
        capture=tie_left_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    tie_right_hit = trace_shape(
        capture=tie_right_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    tie_union_hit = trace_shape(
        capture=tie_union_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    tie_intersection_hit = trace_shape(
        capture=tie_intersection_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    wrapped_direct_hit = trace_shape(
        capture=wrapped_stack_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    wrapped_scene_hit = trace_shape(
        capture=wrapped_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    wrapped_repeat_hit = trace_shape(
        capture=wrapped_stack_scene,
        origin=vec3(2.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )

    assert value tie_left_hit.hit == true
    assert value tie_right_hit.hit == true
    assert value tie_union_hit.hit == true
    assert value tie_intersection_hit.hit == true
    assert value tie_union_hit.payload.entity_id == u32(101)
    assert value tie_intersection_hit.payload.entity_id == u32(101)
    assert value tie_union_hit.feature_id == tie_left_hit.feature_id
    assert value tie_intersection_hit.feature_id == tie_left_hit.feature_id
    assert approx surface_at(capture=tie_union_scene, hit=tie_union_hit).albedo.x ~= 220.0 within 0.001
    assert approx surface_at(capture=tie_intersection_scene, hit=tie_intersection_hit).albedo.x ~= 220.0 within 0.001
    assert value wrapped_direct_hit.hit == true
    assert value wrapped_scene_hit.hit == true
    assert value wrapped_repeat_hit.hit == true
    assert value wrapped_direct_hit.feature_id == wrapped_scene_hit.feature_id
    assert value wrapped_direct_hit.feature_id == wrapped_repeat_hit.feature_id
    assert value wrapped_direct_hit.instance_id != u32(0)
    assert value wrapped_direct_hit.repeat_id != u32(0)
    assert value wrapped_scene_hit.instance_id == wrapped_direct_hit.instance_id
    assert value wrapped_scene_hit.repeat_id == wrapped_direct_hit.repeat_id
    assert value wrapped_repeat_hit.instance_id == wrapped_direct_hit.instance_id
    assert value wrapped_repeat_hit.repeat_id != wrapped_direct_hit.repeat_id
    assert value wrapped_direct_hit.payload.entity_id == wrapped_scene_hit.payload.entity_id
    assert value wrapped_direct_hit.payload.entity_id == wrapped_repeat_hit.payload.entity_id
    assert approx wrapped_direct_hit.local_position.x ~= wrapped_repeat_hit.local_position.x within 0.001
    assert approx wrapped_direct_hit.local_position.y ~= wrapped_repeat_hit.local_position.y within 0.001
    assert approx wrapped_direct_hit.local_position.z ~= wrapped_repeat_hit.local_position.z within 0.001
    assert approx wrapped_direct_hit.local_normal.x ~= wrapped_repeat_hit.local_normal.x within 0.001
    assert approx wrapped_direct_hit.local_normal.y ~= wrapped_repeat_hit.local_normal.y within 0.001
    assert approx wrapped_direct_hit.local_normal.z ~= wrapped_repeat_hit.local_normal.z within 0.001
    assert approx surface_at(capture=wrapped_scene_capture, hit=wrapped_scene_hit).albedo.z ~= 120.0 within 0.001
}

fn test_phase9_trace_shape_batch_preserves_repeat_identity_and_local_frame() -> Nothing {
    wrapped_scene = capture wrapped_stack_shape
    hits = trace_shape_batch(
        capture=wrapped_scene,
        rays=[
            RayQuery(
                origin=vec3(0.0, 0.0, 3.0),
                direction=vec3(0.0, 0.0, -1.0),
                max_distance=6.0,
                min_step=0.05,
                hit_epsilon=0.001,
                max_steps=96
            ),
            RayQuery(
                origin=vec3(2.0, 0.0, 3.0),
                direction=vec3(0.0, 0.0, -1.0),
                max_distance=6.0,
                min_step=0.05,
                hit_epsilon=0.001,
                max_steps=96
            )
        ],
        backend=dispatch_backend_cpu()
    )

    assert value hits[0].hit == true
    assert value hits[1].hit == true
    assert value hits[0].feature_id == hits[1].feature_id
    assert value hits[0].instance_id == hits[1].instance_id
    assert value hits[0].repeat_id != hits[1].repeat_id
    assert value hits[0].payload.entity_id == hits[1].payload.entity_id
    assert approx hits[0].local_position.x ~= hits[1].local_position.x within 0.001
    assert approx hits[0].local_position.y ~= hits[1].local_position.y within 0.001
    assert approx hits[0].local_position.z ~= hits[1].local_position.z within 0.001
    assert approx hits[0].local_normal.x ~= hits[1].local_normal.x within 0.001
    assert approx hits[0].local_normal.y ~= hits[1].local_normal.y within 0.001
    assert approx hits[0].local_normal.z ~= hits[1].local_normal.z within 0.001
}

