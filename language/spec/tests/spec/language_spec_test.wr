fn test_authored_support_bounds_prune_scene() -> Nothing {
    hinted_pruned_before = __wr_metrics_get(__wr_metrics_scene_trace_support_pruned_branch_id())
    hinted_scene = capture hinted_scene_shape
    hinted_hit = trace_shape(
        capture=hinted_scene,
        origin=vec3(-0.8, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    hinted_pruned_after = __wr_metrics_get(__wr_metrics_scene_trace_support_pruned_branch_id())
    plain_pruned_before = hinted_pruned_after
    plain_scene = capture plain_scene_shape
    plain_hit = trace_shape(
        capture=plain_scene,
        origin=vec3(-0.8, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    plain_pruned_after = __wr_metrics_get(__wr_metrics_scene_trace_support_pruned_branch_id())
    hinted_surface = surface_at(capture=hinted_scene, hit=hinted_hit)
    plain_surface = surface_at(capture=plain_scene, hit=plain_hit)

    assert value hinted_hit.hit == true
    assert value plain_hit.hit == true
    assert value hinted_hit.feature_id == plain_hit.feature_id
    assert approx hinted_hit.distance ~= plain_hit.distance within 0.0001
    assert value hinted_surface.albedo.x == plain_surface.albedo.x
    assert value hinted_pruned_after - hinted_pruned_before > 0
    assert value plain_pruned_after - plain_pruned_before == 0
}

