fn test_authored_support_prunes_custom_field_branches() -> Nothing {
    pruned_before = __wr_metrics_get(__wr_metrics_scene_trace_support_pruned_branch_id())
    candidate_before = __wr_metrics_get(__wr_metrics_scene_trace_candidate_branch_id())
    supported_scene_capture = capture authored_support_scene
    supported_hit = trace_shape(
        capture=supported_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    pruned_mid = __wr_metrics_get(__wr_metrics_scene_trace_support_pruned_branch_id())
    candidate_mid = __wr_metrics_get(__wr_metrics_scene_trace_candidate_branch_id())
    plain_scene_capture = capture authored_plain_scene
    plain_hit = trace_shape(
        capture=plain_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    pruned_after = __wr_metrics_get(__wr_metrics_scene_trace_support_pruned_branch_id())
    candidate_after = __wr_metrics_get(__wr_metrics_scene_trace_candidate_branch_id())

    assert value supported_hit.hit == true
    assert value plain_hit.hit == true
    assert value candidate_mid - candidate_before > 0
    assert value candidate_after - candidate_mid > 0
    assert value pruned_mid - pruned_before > 0
    assert value pruned_after - pruned_mid == 0
}

field conservative distance translated_sphere(p: Vec3) -> F32 {
    transform = vec3(2.0, 0.0, 0.0) {
        sphere(radius=1.0)
    }
}

field conservative distance mirrored_box(p: Vec3) -> F32 {
    mirror = vec3(1.0, 0.0, 0.0) {
        transform = vec3(1.0, 0.0, 0.0) {
            box(half=vec3(0.5, 0.5, 0.5))
        }
    }
}

field exact distance repeated_sphere(p: Vec3) -> F32 {
    repeat = vec3(2.0, 0.0, 0.0) {
        sphere(radius=0.5)
    }
}

field conservative distance instanced_sphere(p: Vec3) -> F32 {
    instance = Transform3(
        matrix=mat4_cols(
            vec4(1.0, 0.0, 0.0, 0.0),
            vec4(0.0, 1.0, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(0.0, 0.0, 1.0, 1.0)
        ),
        inverse=mat4_cols(
            vec4(1.0, 0.0, 0.0, 0.0),
            vec4(0.0, 1.0, 0.0, 0.0),
            vec4(0.0, 0.0, 1.0, 0.0),
            vec4(0.0, 0.0, -1.0, 1.0)
        )
    ) {
        sphere(radius=0.5)
    }
}

fn test_structural_field_wrappers_affect_sampling() -> Nothing {
    translated_scene = capture translated_sphere
    mirrored_scene = capture mirrored_box
    repeated_scene = capture repeated_sphere
    instanced_scene = capture instanced_sphere
    translated_sample = distance_at(capture=translated_scene, point=vec3(2.0, 0.0, 0.0))
    mirrored_sample = distance_at(capture=mirrored_scene, point=vec3(-1.0, 0.0, 0.0))
    repeated_sample = distance_at(capture=repeated_scene, point=vec3(2.0, 0.0, 0.0))
    instanced_sample = distance_at(capture=instanced_scene, point=vec3(0.0, 0.0, 1.0))

    assert approx translated_sample ~= -1.0 within 0.001
    assert approx mirrored_sample ~= -0.5 within 0.001
    assert approx repeated_sample ~= -0.5 within 0.001
    assert approx instanced_sample ~= -0.5 within 0.001
}

// ------------------------------------------------------------
// 5) Classes, fields, methods, and implicit receiver

class Whale {
    mutable name: String
    age: Integer

    fn show_greeting() -> String {
        return "hi {self.name}"
    }

    fn update_name(new_name: String) -> Nothing {
        self.name = new_name
        return nothing
    }

    fn get_next_age() -> Integer {
        return self.age + 1
    }
}

class BoxSelf {
    value: Integer

    fn return_self() -> BoxSelf {
        return self
    }
}

class Defaults {
    name: String = "default"
    item_count: Integer = 3
    flags: List[Boolean] = [true, false]
    metas: Map[String, Integer] = {"a": 1}
}

fn test_class_fields_and_methods() -> Nothing {
    whale = Whale(name="Moby", age=7)
    assert value whale.show_greeting() == "hi Moby"
    whale.update_name(new_name="Blue")
    assert value whale.show_greeting() == "hi Blue"
    assert value whale.get_next_age() == 8
}

fn test_return_it() -> Nothing {
    box_item = BoxSelf(value=1)
    same_box_item = box_item.return_self()
    assert value same_box_item.value == 1
}

fn test_class_field_defaults() -> Nothing {
    defaults = Defaults()
    assert value defaults.name == "default"
    assert value defaults.item_count == 3
    assert value defaults.flags == [true, false]
    assert value defaults.metas == {"a": 1}

    customized = Defaults(name="custom")
    assert value customized.name == "custom"
    assert value customized.item_count == 3
}

// ------------------------------------------------------------
// 6) Enums, interfaces, generics, and defer

enum Status {
    Pending
    Processing(worker_id: Integer)
    Done(result: String)
}

class Box[T] {
    value: T
}

interface Printable {
    must show_value() -> String
}

class Foo {
    is a Printable

    fn show_value() -> String {
        return "foo"
    }
}

class Counter {
    mutable value: Integer

    fn add(delta: Integer) -> Nothing {
        self.value += delta
        return nothing
    }
}

fn show_printable(item: Printable) -> String {
    return item.show_value()
}

fn add_deferred_bump(counter: Counter) -> Nothing {
    defer counter.add(delta=1)
    defer counter.add(delta=2)
    return nothing
}

fn test_enum_and_match_patterns() -> Nothing {
    status = Status.Processing(worker_id=7)
    match status {
        Status.Pending {
            assert value false == true
        }
        Status.Processing(id) {
            assert value id == 7
        }
        Status.Done(result) {
            assert value result == "x"
        }
        default {
            assert value true == true
        }
    }
}

fn test_generic_class_instantiation() -> Nothing {
    boxed = Box[Integer](value=7)
    assert value boxed.value == 7
}

fn test_interface_dispatch() -> Nothing {
    assert value show_printable(item=Foo()) == "foo"
}

fn test_defer_lifo() -> Nothing {
    counter = Counter(value=0)
    add_deferred_bump(counter=counter)
    assert value counter.value == 3
}

fn test_match_or_pattern_pipe() -> Nothing {
    status = Status.Pending
    mutable out = 0
    match status {
        Status.Pending | Status.Done(_) {
            out = 1
        }
        Status.Processing(_) {
            out = 0
        }
        default {
            out = 0
        }
    }
    assert value out == 1
}

fn test_match_guard_pattern() -> Nothing {
    status = Status.Processing(worker_id=7)
    mutable out = 0
    match status {
        Status.Processing(worker_id) if worker_id > 5 {
            out = worker_id
        }
        Status.Processing(_) {
            out = 0
        }
        default {
            out = 0
        }
    }
    assert value out == 7
}

// ------------------------------------------------------------
// 7) Lists, maps, and equality semantics

fn test_list_and_map_literals() -> Nothing {
    left_numbers = [1, 2, 3]
    right_numbers = [1, 2, 3]
    left_maps = {"x": 1, "y": 2}
    right_maps = {"x": 1, "y": 2}
    assert value left_numbers == right_numbers
    assert value left_maps == right_maps
}

fn test_identity_vs_value() -> Nothing {
    left_numbers = [1, 2]
    right_numbers = [1, 2]
    assert value left_numbers == right_numbers
    assert identity left_numbers == left_numbers
    assert identity left_numbers != right_numbers
}

fn test_collection_methods_and_index_ops() -> Nothing {
    numbers = [1, 2]
    numbers.push(3)
    numbers[1] = 4
    assert value numbers[0] == 1
    assert value numbers[1] == 4
    assert value numbers.len() == 3

    items = {"x": 1}
    items.set(key="y", value=2)
    items["x"] = 3
    assert value items.get("x") == 3
    assert value items["y"] == 2
    assert value items.len() == 2
}

// ------------------------------------------------------------
// 8) Operators and precedence

fn test_arithmetic_and_precedence() -> Nothing {
    assert value 1 + 2 * 3 == 7
    assert value (1 + 2) * 3 == 9
    assert value 7 % 4 == 3
}

fn test_comparisons_and_boolean_ops() -> Nothing {
    assert value 3 > 2 == true
    assert value 2 >= 2 == true
    assert value 2 < 1 == false
    assert value (true and false) == false
    assert value (true or false) == true
    assert value (false == false) == true
}

fn test_bitwise_ops() -> Nothing {
    assert value (1 & 3) == 1
    assert value (1 | 2) == 3
    assert value (5 ^ 1) == 4
    assert value (1 << 3) == 8
    assert value (8 >> 2) == 2
}

fn test_range_operator() -> Nothing {
    assert value (1...3) == [1, 2, 3]
}

fn test_range_operator_descending() -> Nothing {
    assert value (3...1) == [3, 2, 1]
}

fn test_range_operator_float() -> Nothing {
    assert value (1.0...3.0) == [1.0, 2.0, 3.0]
}

// ------------------------------------------------------------
// 9) Results, error, ??, ignore result, capture

fn try_to_return_result(is_flag: Boolean) -> Result[Integer] {
    if is_flag {
        return 7
    }
    return error "bad"
}

fn test_match_pattern_result() -> Nothing {
    result = try_to_return_result(is_flag=true)
    mutable out = 0
    match result {
        Ok(value) {
            out = value
        }
        Err(_) {
            out = 0
        }
        default {
            out = 0
        }
    }
    assert value out == 7
}

fn test_result_fallback_ok() -> Nothing {
    value = try_to_return_result(is_flag=true) ?? 0
    assert value value == 7
}

fn test_result_fallback_err() -> Nothing {
    value = try_to_return_result(is_flag=false) ?? 9
    assert value value == 9
}

fn test_result_ignore_result() -> Nothing {
    ignore result try_to_return_result(is_flag=true)
    value = try_to_return_result(is_flag=true) ?? 0
    assert value value == 7
}

fn test_result_capture() -> Nothing {
    capture result = try_to_return_result(is_flag=true)
    match result {
        Ok(value) {
            assert value value == 7
        }
        Err(_) {
            assert value false == true
        }
        default {
            assert value false == true
        }
    }
}

enum AuthError {
    MissingToken
    InvalidToken(reason: String)
}

fn try_to_parse_token(token: String) -> Result[Integer, AuthError] {
    if token == "" {
        return error AuthError.MissingToken
    }
    return 1
}

fn try_to_add_with_try(left: Result[Integer], right: Result[Integer]) -> Result[Integer] {
    left_value = left?
    right_value = right?
    return left_value + right_value
}

fn test_custom_error_handling() -> Nothing {
    result = try_to_parse_token(token="")
    match result {
        Ok(_) {
            assert value false == true
        }
        Err(err_value) {
            match err_value {
                AuthError.MissingToken {
                    assert value true == true
                }
                AuthError.InvalidToken(_) {
                    assert value false == true
                }
                default {
                    assert value false == true
                }
            }
        }
        default {
            assert value false == true
        }
    }
}

fn test_try_operator_ok_path() -> Nothing {
    total = try_to_add_with_try(left=try_to_return_result(is_flag=true), right=try_to_return_result(is_flag=true)) ?? 0
    assert value total == 14
}

fn test_try_operator_err_path() -> Nothing {
    total = try_to_add_with_try(left=try_to_return_result(is_flag=true), right=try_to_return_result(is_flag=false)) ?? 3
    assert value total == 3
}

fn test_parse_helper_result_contract() -> Nothing {
    parsed = try_to_parse_integer("42") ?? 0
    fallback = try_to_parse_integer("nope") ?? -1
    assert value parsed == 42
    assert value fallback == -1
}

// ------------------------------------------------------------
// 10) Assertions

fn test_assert_value_comparison() -> Nothing {
    assert value 1 + 1 == 2
    assert value "a" + "b" == "ab"
}

fn test_assert_identity_for_objects() -> Nothing {
    left_numbers = [1]
    right_numbers = [1]
    assert identity left_numbers != right_numbers
}

fn test_assert_approx_within_tolerance() -> Nothing {
    assert approx 1.0 ~= 1.001 within 0.01
}
