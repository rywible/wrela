fn test_boolean_provenance_is_stable_across_order_and_subtract() -> Nothing {
    scene_capture = capture scene_shape
    reversed_scene_capture = capture reversed_scene_shape
    carved_scene_capture = capture carved_shape
    near_scene_capture = capture near_shape
    far_scene_capture = capture far_shape
    nearest_scene_capture = capture nearest_scene_shape
    ordered_scene_capture = capture ordered_scene_shape
    overlap_scene_capture = capture overlap_scene_shape
    cutter_scene_capture = capture cutter_shape
    body_scene_capture = capture body_shape
    carved_left_scene_capture = capture carved_left_shape
    left_hit = trace_shape(
        capture=scene_capture,
        origin=vec3(-0.8, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    right_hit = trace_shape(
        capture=scene_capture,
        origin=vec3(0.8, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    reversed_left_hit = trace_shape(
        capture=reversed_scene_capture,
        origin=vec3(-0.8, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    reversed_right_hit = trace_shape(
        capture=reversed_scene_capture,
        origin=vec3(0.8, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    carve_hit = trace_shape(
        capture=carved_scene_capture,
        origin=vec3(0.0, 0.0, 0.0),
        direction=vec3(1.0, 0.0, 0.0),
        max_distance=4.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    near_direct = trace_shape(
        capture=near_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    far_direct = trace_shape(
        capture=far_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    nearest_hit = trace_shape(
        capture=nearest_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    ordered_hit = trace_shape(
        capture=ordered_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    overlap_hit = trace_shape(
        capture=overlap_scene_capture,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    cutter_hit = trace_shape(
        capture=cutter_scene_capture,
        origin=vec3(0.0, 0.0, 0.0),
        direction=vec3(1.0, 0.0, 0.0),
        max_distance=4.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    body_hit = trace_shape(
        capture=body_scene_capture,
        origin=vec3(0.0, 0.0, 0.0),
        direction=vec3(1.0, 0.0, 0.0),
        max_distance=4.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    carve_left_hit = trace_shape(
        capture=carved_left_scene_capture,
        origin=vec3(0.0, 0.0, 0.0),
        direction=vec3(1.0, 0.0, 0.0),
        max_distance=4.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )

    assert value left_hit.hit == true
    assert value right_hit.hit == true
    assert value reversed_left_hit.hit == true
    assert value reversed_right_hit.hit == true
    assert value left_hit.payload.entity_id == u32(31)
    assert value right_hit.payload.entity_id == u32(32)
    assert value reversed_left_hit.payload.entity_id == u32(31)
    assert value reversed_right_hit.payload.entity_id == u32(32)
    assert value carve_hit.hit == true
    assert value carve_hit.payload.entity_id == u32(42)
    assert value carve_hit.payload.material_id == u32(42)
    assert value near_direct.feature_id != u32(0)
    assert value far_direct.feature_id != u32(0)
    assert value nearest_hit.hit == true
    assert value ordered_hit.hit == true
    assert value overlap_hit.hit == true
    assert value nearest_hit.payload.entity_id == u32(61)
    assert value ordered_hit.payload.entity_id == u32(62)
    assert value overlap_hit.payload.entity_id == u32(62)
    assert value nearest_hit.feature_id == near_direct.feature_id
    assert value ordered_hit.feature_id == far_direct.feature_id
    assert value overlap_hit.feature_id == far_direct.feature_id
    assert value carve_hit.feature_id == cutter_hit.feature_id
    carve_left_frame = inverse_transform3(transform=carve_left_hit.shading_frame)
    carve_left_local_origin = transform_point(transform=carve_left_frame, point=carve_left_hit.position)
    assert value carve_left_hit.hit == true
    assert value carve_left_hit.payload.entity_id == u32(41)
    assert value carve_left_hit.feature_id == body_hit.feature_id
    assert approx carve_left_local_origin.x ~= 0.0 within 0.001
    assert approx carve_left_local_origin.y ~= 0.0 within 0.001
    assert approx carve_left_local_origin.z ~= 0.0 within 0.001
    assert approx surface_at(capture=carved_scene_capture, hit=carve_hit).albedo.y ~= 200.0 within 0.001
    assert approx surface_at(capture=carved_left_scene_capture, hit=carve_left_hit).albedo.x ~= 220.0 within 0.001
}

