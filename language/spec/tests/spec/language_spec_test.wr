fn test_boolean_provenance_is_stable_across_order_and_subtract() -> Nothing {
    scene_capture = capture scene_shape
    reversed_scene_capture = capture reversed_scene_shape
    carved_scene_capture = capture carved_shape
    near_scene_capture = capture near_shape
    far_scene_capture = capture far_shape
