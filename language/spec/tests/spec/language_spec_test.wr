use {
    try_to_parse_integer
}
from parse

// ------------------------------------------------------------
// 1) Literals and basic values

fn test_literals_numbers() -> Nothing {
    assert value 42 == 42
    assert value 0x10 == 16
    assert value 0b1010 == 10
    assert value 0o10 == 8
    assert value 1_000 == 1000
    assert value 1.5 > 1.0
    assert value 1e3 == 1000
    assert value 1E+3 == 1000
}

fn test_literals_boolean_and_nothing() -> Nothing {
    assert value true == true
    assert value false == false
    assert value nothing == nothing
}

fn test_literals_strings_basic() -> Nothing {
    value = "hello"
    assert value value == "hello"
}

fn test_string_interpolation() -> Nothing {
    name = "Wrela"
    count = 3
    assert value "Hello {name}" == "Hello Wrela"
    assert value "{name} has {count}" == "Wrela has 3"
}

fn test_string_escapes() -> Nothing {
    value = "a\\n\\t\\\"b\\\""
    assert value value == "a\n\t\"b\""
}

// ------------------------------------------------------------
// 2) Variables and assignment

fn test_assignment_mutable() -> Nothing {
    mutable count = 1
    count += 2
    count -= 1
    count *= 3
    count /= 2
    assert value count == 3
}

// ------------------------------------------------------------
// 3) Control flow: if / while / for / match

fn test_if_else() -> Nothing {
    mutable out = 0
    if true {
        out = 1
    }
    else {
        out = 2
    }
    assert value out == 1
}

fn test_else_if_chain() -> Nothing {
    mutable out = 0
    if false {
        out = 1
    }
    else if true {
        out = 2
    }
    else {
        out = 3
    }
    assert value out == 2
}

fn test_while_loop() -> Nothing {
    mutable index = 0
    mutable total = 0
    while index < 3 {
        total = total + index
        index = index + 1
    }
    assert value total == 3
}

fn test_for_loop_over_list() -> Nothing {
    mutable total = 0
    for value in [1, 2, 3] {
        total = total + value
    }
    assert value total == 6
}

fn test_for_loop_over_range() -> Nothing {
    mutable total = 0
    for value in 1...3 {
        total = total + value
    }
    assert value total == 6
}

fn test_for_loop_over_list_with_index() -> Nothing {
    mutable total = 0
    for value in [1, 2, 3] with index idx {
        total = total + value + idx
    }
    assert value total == 9
}

fn test_for_loop_over_map_key_value() -> Nothing {
    mutable total = 0
    for key_name, value_name in {"a": 1, "b": 2} {
        if key_name == "a" {
            total = total + value_name
        }
        if key_name == "b" {
            total = total + value_name
        }
    }
    assert value total == 3
}

fn test_match_expression_labels() -> Nothing {
    mutable out = ""
    value = 2
    match value {
        1 {
            out = "one"
        }
        2, 3 {
            out = "small"
        }
        default {
            out = "other"
        }
    }
    assert value out == "small"
}

fn test_match_pattern_wildcard() -> Nothing {
    value = 5
    mutable out = 0
    match value {
        _ {
            out = 1
        }
        default {
            out = 2
        }
    }
    assert value out == 1
}

fn test_match_pattern_type_check() -> Nothing {
    value = "hi"
    mutable out = ""
    match value {
        String {
            out = "string"
        }
        default {
            out = "other"
        }
    }
    assert value out == "string"
}

fn test_require_statement() -> Nothing {
    require true else "must be true"
}

// ------------------------------------------------------------
// 4) Functions and returns

fn add(left: Integer, right: Integer) -> Integer {
    return left + right
}

fn test_functions_and_return() -> Nothing {
    assert value add(left=2, right=3) == 5
}

value SubstrateSample {
    flag: Bool
    count: I32
    measure: F32
}

fn compute_middle_value(values: Array[I32, 3]) -> I32 {
    return values[1]
}

fn test_value_declarations_and_scalar_aliases() -> Nothing {
    sample = SubstrateSample(flag=true, count=7, measure=1.25)
    assert value sample.flag == true
    assert value sample.count == 7
    assert approx sample.measure ~= 1.251 within 0.01
}

fn test_fixed_array_type_surface() -> Nothing {
    assert value compute_middle_value(values=[4, 6, 7]) == 6
}

// ------------------------------------------------------------
// Vector and matrix substrate

fn test_vec2_surface() -> Nothing {
    base = vec2(3.0, 4.0)
    unit = normalize(base)
    shifted = base + vec2(1.0, -1.0)
    restored = (shifted * 0.5) / 0.5
    assert approx base.x ~= 3.0 within 0.0001
    assert approx base.y ~= 4.0 within 0.0001
    assert approx length(base) ~= 5.0 within 0.0001
    assert approx dot(unit, vec2(0.6, 0.8)) ~= 1.0 within 0.0001
    assert approx restored.x ~= 4.0 within 0.0001
    assert approx restored.y ~= 3.0 within 0.0001
}

fn test_vec3_field_access() -> Nothing {
    value = vec3(1.0, 2.0, 3.0)
    assert approx value.x ~= 1.0 within 0.0001
    assert approx value.y ~= 2.0 within 0.0001
    assert approx value.z ~= 3.0 within 0.0001
}

fn test_vec_math_intrinsics() -> Nothing {
    unit = normalize(vec3(3.0, 0.0, 4.0))
    assert approx dot(unit, vec3(1.0, 0.0, 0.0)) ~= 0.6 within 0.0001
    assert approx length(unit) ~= 1.0 within 0.0001
    assert approx cross(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0)).z ~= 1.0 within 0.0001
}

fn test_portable_math_surface() -> Nothing {
    q = normalize(quat(0.0, 3.0, 4.0, 0.0))
    assert approx q.y ~= 0.6 within 0.0001
    assert approx q.z ~= 0.8 within 0.0001
    assert approx length(q) ~= 1.0 within 0.0001

    basis = mat3_cols(
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0)
    )
    assert approx (mat3_identity() * vec3(4.0, 5.0, 6.0)).y ~= 5.0 within 0.0001
    projected = basis * vec3(1.0, 2.0, 3.0)
    assert approx projected.x ~= 1.0 within 0.0001
    assert approx projected.y ~= 2.0 within 0.0001
    assert approx projected.z ~= 3.0 within 0.0001

    assert approx f32(7) ~= 7.0 within 0.0001
    assert value i32(7.8) == 7
    assert value u32(7.8) == 7
    assert approx min(2.0, 3.0) ~= 2.0 within 0.0001
    assert approx max(2.0, 3.0) ~= 3.0 within 0.0001
    assert approx clamp(5.0, 0.0, 4.0) ~= 4.0 within 0.0001
    assert approx mix(10.0, 20.0, 0.25) ~= 12.5 within 0.0001
    assert approx abs(-3.5) ~= 3.5 within 0.0001
    assert approx sign(-3.5) ~= -1.0 within 0.0001
    assert approx floor(1.8) ~= 1.0 within 0.0001
    assert approx ceil(1.2) ~= 2.0 within 0.0001
    assert approx fract(1.25) ~= 0.25 within 0.0001
    assert approx sin(0.0) ~= 0.0 within 0.0001
    assert approx cos(0.0) ~= 1.0 within 0.0001
    assert approx sqrt(9.0) ~= 3.0 within 0.0001
    assert approx pow(2.0, 3.0) ~= 8.0 within 0.0001
    assert approx distance(vec3(0.0, 0.0, 0.0), vec3(0.0, 3.0, 4.0)) ~= 5.0 within 0.0001
    reflected = reflect(vec3(1.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0))
    assert approx reflected.y ~= 1.0 within 0.0001
}

value SceneProbe {
    surface: Surface
    medium: Medium
    hit: Hit3
    contact: Contact
    light: Light
    support: Support3
    camera: Camera
    pose: Transform3
}

fn test_portable_builtin_records() -> Nothing {
    handle = ActorHandle(id=u64(7), generation=u32(3))
    payload = Payload(entity_id=u64(7), material_id=u64(11), actor=handle)
    hit = Hit3(
        hit=true,
        distance=4.0,
        position=vec3(1.0, 2.0, 3.0),
        normal=vec3(0.0, 1.0, 0.0),
        steps=0,
        feature_id=u64(0),
        payload=payload
    )
    surface = Surface(
        albedo=vec3(0.25, 0.5, 0.75),
        roughness=0.125,
        metalness=0.25,
        clearcoat=0.5,
        clearcoat_roughness=0.75,
        sheen=0.1,
        emissive=vec3(1.0, 0.0, 2.0)
    )
    medium = Medium(
        density=0.5,
        emission=vec3(0.5, 0.25, 0.75),
        anisotropy=-0.25
    )
    bounds = Bounds3(
        min=vec3(0.0, 1.0, 2.0),
        max=vec3(6.0, 7.0, 8.0)
    )
    support = Support3(bounds=bounds)
    contact = Contact(
        hit=true,
        position=hit.position,
        normal=hit.normal,
        penetration=0.5,
        payload=payload
    )
    light = Light(
        position=vec3(2.0, 4.0, 6.0),
        direction=vec3(0.0, -1.0, 0.0),
        intensity=vec3(8.0, 6.0, 4.0),
        range=12.0
    )
    camera = Camera(
        position=vec3(0.0, 1.0, 2.0),
        forward=vec3(0.0, 0.0, -1.0),
        up=vec3(0.0, 1.0, 0.0),
        vertical_fov_degrees=60.0
    )
    pose = Transform3(
        matrix=mat4_identity(),
        inverse=mat4_identity()
    )
    scene = SceneProbe(
        surface=surface,
        medium=medium,
        hit=hit,
        contact=contact,
        light=light,
        support=support,
        camera=camera,
        pose=pose
    )

    assert value scene.hit.payload.actor.id == 7
    assert value scene.hit.payload.actor.generation == 3
    assert approx scene.surface.roughness ~= 0.125 within 0.0001
    assert approx scene.medium.anisotropy ~= -0.25 within 0.0001
    assert value scene.support.bounds == bounds
    assert value scene.pose == pose
    assert value scene.contact.payload.material_id == 11
    assert approx scene.light.range ~= 12.0 within 0.0001
    assert approx scene.camera.vertical_fov_degrees ~= 60.0 within 0.0001
}

fn test_bounds_and_transform_helpers() -> Nothing {
    bounds2_box = Bounds2(
        min=vec2(1.0, 2.0),
        max=vec2(5.0, 6.0)
    )
    bounds3_box = Bounds3(
        min=vec3(0.0, 1.0, 2.0),
        max=vec3(6.0, 7.0, 8.0)
    )
    ray = Ray3(
        origin=vec3(1.0, 2.0, 3.0),
        direction=normalize(vec3(0.0, 1.0, 0.0))
    )
    pose = Transform3(
        matrix=mat4_identity(),
        inverse=mat4_identity()
    )

    center2 = bounds2_center(bounds=bounds2_box)
    size2 = bounds2_size(bounds=bounds2_box)
    center3 = bounds3_center(bounds=bounds3_box)
    size3 = bounds3_size(bounds=bounds3_box)
    identity = transform3_identity()
    composed = compose_transform3(
        left=pose,
        right=inverse_transform3(transform=identity)
    )
    point = transform_point(transform=composed, point=ray.origin)
    vector = transform_vector(transform=composed, vector=ray.direction)
    normal = transform_normal(transform=composed, normal=vec3(0.0, 1.0, 0.0))

    assert approx center2.x ~= 3.0 within 0.0001
    assert approx center2.y ~= 4.0 within 0.0001
    assert approx size2.x ~= 4.0 within 0.0001
    assert approx size2.y ~= 4.0 within 0.0001
    assert approx center3.x ~= 3.0 within 0.0001
    assert approx center3.y ~= 4.0 within 0.0001
    assert approx center3.z ~= 5.0 within 0.0001
    assert approx size3.x ~= 6.0 within 0.0001
    assert approx size3.y ~= 6.0 within 0.0001
    assert approx size3.z ~= 6.0 within 0.0001
    assert approx point.x ~= 1.0 within 0.0001
    assert approx point.y ~= 2.0 within 0.0001
    assert approx point.z ~= 3.0 within 0.0001
    assert approx vector.y ~= 1.0 within 0.0001
    assert approx normal.y ~= 1.0 within 0.0001
}

fn test_vec_and_mat_arithmetic() -> Nothing {
    left = vec3(1.0, 2.0, 3.0)
    right = vec3(4.0, 5.0, 6.0)
    sum = left + right
    delta = right - left
    scaled = sum * 0.5
    restored = scaled / 0.5
    assert approx restored.x ~= 5.0 within 0.0001
    assert approx restored.y ~= 7.0 within 0.0001
    assert approx restored.z ~= 9.0 within 0.0001
    assert approx delta.x ~= 3.0 within 0.0001
    assert approx delta.y ~= 3.0 within 0.0001
    assert approx delta.z ~= 3.0 within 0.0001

    transform = mat4_cols(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(4.0, 5.0, 6.0, 1.0)
    )
    adjusted = (transform + mat4_identity() - mat4_identity()) * 0.5 / 0.5
    result = adjusted * vec4(1.0, 2.0, 3.0, 1.0)
    assert approx result.x ~= 5.0 within 0.0001
    assert approx result.y ~= 7.0 within 0.0001
    assert approx result.z ~= 9.0 within 0.0001
    assert approx result.w ~= 1.0 within 0.0001
}

fn test_mat4_transform_path() -> Nothing {
    transform = mat4_cols(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0)
    )
    result = transform * vec4(1.0, 2.0, 3.0, 1.0)
    assert approx result.x ~= 1.0 within 0.0001
    assert approx result.y ~= 2.0 within 0.0001
    assert approx result.z ~= 3.0 within 0.0001
    assert approx result.w ~= 1.0 within 0.0001
}

class PortableKernelShadow {
    offset: Integer

    fn add_one(value: Integer) -> Integer {
        return value + self.offset
    }

    fn run_portable_kernel() -> Integer {
        return self.offset
    }
}

kernel fn add_one(value: I32) -> I32 {
    return value + i32(1)
}

kernel fn run_portable_kernel(output: GpuBuffer[I32]) -> Nothing {
    gid = global_invocation_id()
    gpu_buffer_set(
        buffer=output,
        index=gid[0],
        value=add_one(i32(gid[0]))
    )
}

fn test_kernel_fn_direct_call_surface() -> Nothing {
    assert value add_one(value=i32(1)) == 2
}

fn test_kernel_fn_dispatch_surface() -> Nothing {
    shadow = PortableKernelShadow(offset=99)
    assert value shadow.add_one(value=1) == 100
    assert value shadow.run_portable_kernel() == 99

    output = gpu_buffer_new(length=4, default_value=i32(0))
    dispatch_compute(
        kernel=run_portable_kernel,
        output=output,
        workgroups_x=u32(2),
        workgroups_y=u32(1),
        workgroups_z=u32(1),
        workgroup_size_x=u32(2),
        workgroup_size_y=u32(1),
        workgroup_size_z=u32(1)
    )

    assert value gpu_buffer_get(buffer=output, index=0) == 1
    assert value gpu_buffer_get(buffer=output, index=1) == 2
    assert value gpu_buffer_get(buffer=output, index=2) == 3
    assert value gpu_buffer_get(buffer=output, index=3) == 4
}

field exact distance sphere_field(p: Vec3) -> F32 {
    sphere(radius = 1.0)
}

field conservative distance shifted_sphere(p: Vec3) -> F32 {
    return sphere(p=p - vec3(0.0, 0.0, 1.0), radius=1.0)
}

fn test_field_query_surface() -> Nothing {
    sphere_capture = capture sphere_field
    shifted_capture = capture shifted_sphere
    sampled_distance = distance_at(capture=sphere_capture, point=vec3(0.0, 0.0, 2.0))
    sampled_normal = normal_at(capture=sphere_capture, point=vec3(0.0, 0.0, 2.0))
    shifted_distance = distance_at(capture=shifted_capture, point=vec3(0.0, 0.0, 3.0))

    assert approx sampled_distance ~= 1.0 within 0.001
    assert approx sampled_normal.x ~= 0.0 within 0.01
    assert approx sampled_normal.y ~= 0.0 within 0.01
    assert approx sampled_normal.z ~= 1.0 within 0.01
    assert approx shifted_distance ~= 1.0 within 0.001
}

field conservative distance left_x(p: Vec3) -> F32 {
    return p.x
}

field conservative distance left_y(p: Vec3) -> F32 {
    return p.y
}

field conservative distance cap_z(p: Vec3) -> F32 {
    return p.z
}

field conservative distance notch(p: Vec3) -> F32 {
    return p.x - 0.5
}

field conservative distance composed(p: Vec3) -> F32 {
    subtract {
        provenance_policy = right
        intersection {
            provenance_policy = nearest
            union {
                provenance_policy = nearest
                use left_x
                use left_y
            }
            use cap_z
        }
        use notch
    }
}

fn test_semantic_field_composition() -> Nothing {
    composed_capture = capture composed
    sample_a = distance_at(capture=composed_capture, point=vec3(1.0, 2.0, 3.0))
    sample_b = distance_at(capture=composed_capture, point=vec3(-1.0, 2.0, 0.5))

    assert approx sample_a ~= 3.0 within 0.001
    assert approx sample_b ~= 1.5 within 0.001
}

material shade(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(1.0, 0.0, 0.0),
        roughness=0.0,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape sphere_shape {
    field = sphere_field
    material = shade
    payload = Payload(
        entity_id=u64(1),
        material_id=u64(1),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

fn render_ppm() -> String {
    camera = Camera(
        position=vec3(0.0, 0.0, 3.0),
        forward=vec3(0.0, 0.0, -1.0),
        up=vec3(0.0, 1.0, 0.0),
        vertical_fov_degrees=60.0
    )
    light = Light(
        position=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        intensity=vec3(255.0, 255.0, 255.0),
        range=10.0
    )
    scene = capture sphere_shape

    hit = trace_shape(
        capture=scene,
        origin=camera.position,
        direction=camera.forward,
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    surface = surface_at(capture=scene, hit=hit)
    to_light = normalize(light.position - hit.position)
    ndotl = max(dot(hit.normal, to_light), 0.0)

    r = i32(clamp(surface.albedo.x * ndotl * light.intensity.x + surface.emissive.x, 0.0, 255.0))
    g = i32(clamp(surface.albedo.y * ndotl * light.intensity.y + surface.emissive.y, 0.0, 255.0))
    b = i32(clamp(surface.albedo.z * ndotl * light.intensity.z + surface.emissive.z, 0.0, 255.0))

    mutable ppm = "P3\n1 1\n255\n"
    ppm += "{r} {g} {b}"
    return ppm
}

fn test_host_raymarch_material_ppm() -> Nothing {
    assert value render_ppm() == "P3\n1 1\n255\n255 0 0"
}

fn test_query_batch_records_and_snapshot_determinism() -> Nothing {
    scene = capture sphere_shape
    scene_again = capture sphere_shape
    points = [
        PointQuery(point=vec3(0.0, 0.0, 2.0)),
        PointQuery(point=vec3(0.0, 0.0, 3.0)),
        PointQuery(point=vec3(0.5, 0.0, 2.0))
    ]
    rays = [
        RayQuery(
            origin=vec3(0.0, 0.0, 3.0),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=6.0,
            min_step=0.05,
            hit_epsilon=0.001,
            max_steps=96
        ),
        RayQuery(
            origin=vec3(0.5, 0.0, 3.0),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=6.0,
            min_step=0.05,
            hit_epsilon=0.001,
            max_steps=96
        )
    ]
    shadow_rays = [
        RayQuery(
            origin=vec3(0.0, 0.0, 3.0),
            direction=vec3(0.0, 0.0, -1.0),
            max_distance=6.0,
            min_step=0.05,
            hit_epsilon=0.001,
            max_steps=96
        ),
        RayQuery(
            origin=vec3(0.0, 0.0, 3.0),
            direction=vec3(0.0, 1.0, 0.0),
            max_distance=6.0,
            min_step=0.05,
            hit_epsilon=0.001,
            max_steps=96
        )
    ]
    cpu_distances = distance_at_batch(
        capture=scene,
        points=points,
        backend=dispatch_backend_cpu()
    )
    vgpu_distances = distance_at_batch(
        capture=scene,
        points=points,
        backend=dispatch_backend_virtual_gpu()
    )
    cpu_normals = normal_at_batch(
        capture=scene,
        points=points,
        backend=dispatch_backend_cpu()
    )
    vgpu_normals = normal_at_batch(
        capture=scene,
        points=points,
        backend=dispatch_backend_virtual_gpu()
    )
    cpu_hits = trace_shape_batch(
        capture=scene,
        rays=rays,
        backend=dispatch_backend_cpu()
    )
    vgpu_hits = trace_shape_batch(
        capture=scene,
        rays=rays,
        backend=dispatch_backend_virtual_gpu()
    )
    cpu_surfaces = surface_at_batch(
        capture=scene,
        hits=cpu_hits,
        backend=dispatch_backend_auto()
    )
    vgpu_surfaces = surface_at_batch(
        capture=scene,
        hits=vgpu_hits,
        backend=dispatch_backend_virtual_gpu()
    )
    cpu_occlusions = occluded_batch(
        capture=scene,
        rays=shadow_rays,
        backend=dispatch_backend_cpu()
    )
    vgpu_occlusions = occluded_batch(
        capture=scene,
        rays=shadow_rays,
        backend=dispatch_backend_virtual_gpu()
    )

    assert value scene.scene_id == scene_again.scene_id
    assert value scene.root_feature_id == scene_again.root_feature_id
    assert approx cpu_distances[0].distance ~= 1.0 within 0.001
    assert approx cpu_distances[1].distance ~= 2.0 within 0.001
    assert approx cpu_distances[2].distance ~= 1.0615 within 0.01
    assert approx vgpu_distances[0].distance ~= cpu_distances[0].distance within 0.001
    assert approx vgpu_distances[1].distance ~= cpu_distances[1].distance within 0.001
    assert approx vgpu_distances[2].distance ~= cpu_distances[2].distance within 0.001
    assert approx cpu_normals[0].normal.z ~= 1.0 within 0.01
    assert approx vgpu_normals[0].normal.z ~= cpu_normals[0].normal.z within 0.01
    assert value cpu_hits[0].hit == true
    assert value cpu_hits[1].hit == true
    assert value vgpu_hits[0].feature_id == cpu_hits[0].feature_id
    assert value vgpu_hits[1].feature_id == cpu_hits[1].feature_id
    assert approx cpu_surfaces[0].albedo.x ~= 1.0 within 0.001
    assert approx vgpu_surfaces[0].albedo.x ~= cpu_surfaces[0].albedo.x within 0.001
    assert value cpu_occlusions[0].occluded == true
    assert value cpu_occlusions[1].occluded == false
    assert value vgpu_occlusions[0].occluded == cpu_occlusions[0].occluded
    assert value vgpu_occlusions[1].occluded == cpu_occlusions[1].occluded
}

