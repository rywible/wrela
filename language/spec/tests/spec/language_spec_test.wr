fn test_phase5_primitive_point_sampling() -> Nothing {
    rounded_box_scene = capture phase5_rounded_box_shape
    ellipsoid_scene = capture phase5_ellipsoid_shape
    cone_scene = capture phase5_cone_shape
    capped_cone_scene = capture phase5_capped_cone_shape
    box_frame_scene = capture phase5_box_frame_shape
    slab_scene = capture phase5_slab_shape
    triangle_scene = capture phase5_triangle_prism_shape
    hex_scene = capture phase5_hex_prism_shape

    rounded_box_center = distance_at(capture=rounded_box_scene, point=vec3(0.0, 0.0, 0.0))
    ellipsoid_center = distance_at(capture=ellipsoid_scene, point=vec3(0.0, 0.0, 0.0))
    cone_center = distance_at(capture=cone_scene, point=vec3(0.0, 0.0, 0.0))
    capped_cone_center = distance_at(capture=capped_cone_scene, point=vec3(0.0, 0.0, 0.0))
    box_frame_center = distance_at(capture=box_frame_scene, point=vec3(0.0, 0.0, 0.0))
    slab_center = distance_at(capture=slab_scene, point=vec3(0.0, 0.0, 0.0))
    triangle_center = distance_at(capture=triangle_scene, point=vec3(0.0, 0.0, 0.0))
    hex_center = distance_at(capture=hex_scene, point=vec3(0.0, 0.0, 0.0))

    assert value rounded_box_center < 0.0
    assert value ellipsoid_center < 0.0
    assert value cone_center < 0.0
    assert value capped_cone_center < 0.0
    assert value box_frame_center > 0.0
    assert value slab_center < 0.0
    assert value triangle_center < 0.0
    assert value hex_center < 0.0
}

fn test_phase5_transform_and_repeat_families_are_sampleable() -> Nothing {
    translate_scene = capture phase5_translate_shape
    rotate_scene = capture phase5_rotate_shape
    scale_scene = capture phase5_uniform_scale_shape
    affine_scene = capture phase5_affine_transform_shape
    warp_scene = capture phase5_warp_shape
    repeat_linear_scene = capture phase5_repeat_linear_shape
    repeat_grid_scene = capture phase5_repeat_grid_shape
    radial_repeat_scene = capture phase5_radial_repeat_shape
    mirror_array_scene = capture phase5_mirror_array_shape
    instance_array_scene = capture phase5_instance_array_shape

    translate_sample = distance_at(capture=translate_scene, point=vec3(0.85, 0.0, 0.0))
    rotate_sample = distance_at(capture=rotate_scene, point=vec3(0.0, 0.0, 0.0))
    scale_sample = distance_at(capture=scale_scene, point=vec3(0.0, 0.0, 0.0))
    affine_sample = distance_at(capture=affine_scene, point=vec3(0.32, 0.0, 0.0))
    warp_sample = distance_at(capture=warp_scene, point=vec3(0.0, 0.0, 0.0))
    repeat_linear_sample = distance_at(capture=repeat_linear_scene, point=vec3(1.35, 0.0, 0.0))
    repeat_grid_sample = distance_at(capture=repeat_grid_scene, point=vec3(1.35, 1.35, 0.0))
    radial_repeat_sample = distance_at(capture=radial_repeat_scene, point=vec3(0.0, 0.0, 0.0))
    mirror_array_sample = distance_at(capture=mirror_array_scene, point=vec3(-0.85, 0.0, 0.0))
    instance_array_sample = distance_at(capture=instance_array_scene, point=vec3(0.0, 0.0, 0.0))

    assert value translate_sample < 0.0
    assert value rotate_sample < 0.0
    assert value scale_sample < 0.0
    assert value affine_sample > 0.0
    assert value warp_sample < 0.0
    assert value repeat_linear_sample < 0.0
    assert value repeat_grid_sample < 0.0
    assert value radial_repeat_sample < 0.0
    assert value mirror_array_sample > 0.0
    assert value instance_array_sample > 0.0
}

fn test_phase5_smooth_and_deform_costs_raise_field_sampling() -> Nothing {
    control_samples_before = __wr_metrics_get(__wr_metrics_field_sample_id())
    control_scene = capture phase5_rounded_box_shape
    control_hit = trace_shape(
        capture=control_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    control_samples_after = __wr_metrics_get(__wr_metrics_field_sample_id())

    smooth_samples_before = control_samples_after
    smooth_scene = capture phase5_smooth_scene_shape
    smooth_hit = trace_shape(
        capture=smooth_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    smooth_samples_after = __wr_metrics_get(__wr_metrics_field_sample_id())

    deform_samples_before = smooth_samples_after
    deform_scene = capture phase5_deform_scene_shape
    deform_hit = trace_shape(
        capture=deform_scene,
        origin=vec3(0.0, 0.0, 3.0),
        direction=vec3(0.0, 0.0, -1.0),
        max_distance=6.0,
        min_step=0.05,
        hit_epsilon=0.001,
        max_steps=96
    )
    deform_samples_after = __wr_metrics_get(__wr_metrics_field_sample_id())

    control_samples = control_samples_after - control_samples_before
    smooth_samples = smooth_samples_after - smooth_samples_before
    deform_samples = deform_samples_after - deform_samples_before

    assert value control_hit.hit == true
    assert value smooth_hit.hit == true
    assert value deform_hit.hit == true
    assert value smooth_samples > control_samples
    assert value deform_samples > control_samples
}

