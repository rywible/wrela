use {
    try_to_parse_integer
}
from parse

// ------------------------------------------------------------
// 1) Literals and basic values

fn test_literals_numbers() -> Nothing {
    assert value 42 == 42
    assert value 0x10 == 16
    assert value 0b1010 == 10
    assert value 0o10 == 8
    assert value 1_000 == 1000
    assert value 1.5 > 1.0
    assert value 1e3 == 1000
    assert value 1E+3 == 1000
}

fn test_literals_boolean_and_nothing() -> Nothing {
    assert value true == true
    assert value false == false
    assert value nothing == nothing
}

fn test_literals_strings_basic() -> Nothing {
    value = "hello"
    assert value value == "hello"
}

fn test_string_interpolation() -> Nothing {
    name = "Wrela"
    count = 3
    assert value "Hello {name}" == "Hello Wrela"
    assert value "{name} has {count}" == "Wrela has 3"
}

fn test_string_escapes() -> Nothing {
    value = "a\\n\\t\\\"b\\\""
    assert value value == "a\n\t\"b\""
}

// ------------------------------------------------------------
// 2) Variables and assignment

fn test_assignment_mutable() -> Nothing {
    mutable count = 1
    count += 2
    count -= 1
    count *= 3
    count /= 2
    assert value count == 3
}

// ------------------------------------------------------------
// 3) Control flow: if / while / for / match

fn test_if_else() -> Nothing {
    mutable out = 0
    if true {
        out = 1
    }
    else {
        out = 2
    }
    assert value out == 1
}

fn test_else_if_chain() -> Nothing {
    mutable out = 0
    if false {
        out = 1
    }
    else if true {
        out = 2
    }
    else {
        out = 3
    }
    assert value out == 2
}

fn test_while_loop() -> Nothing {
    mutable index = 0
    mutable total = 0
    while index < 3 {
        total = total + index
        index = index + 1
    }
    assert value total == 3
}

fn test_for_loop_over_list() -> Nothing {
    mutable total = 0
    for value in [1, 2, 3] {
        total = total + value
    }
    assert value total == 6
}

fn test_for_loop_over_range() -> Nothing {
    mutable total = 0
    for value in 1...3 {
        total = total + value
    }
    assert value total == 6
}

fn test_for_loop_over_list_with_index() -> Nothing {
    mutable total = 0
    for value in [1, 2, 3] with index idx {
        total = total + value + idx
    }
    assert value total == 9
}

fn test_for_loop_over_map_key_value() -> Nothing {
    mutable total = 0
    for key_name, value_name in {"a": 1, "b": 2} {
        if key_name == "a" {
            total = total + value_name
        }
        if key_name == "b" {
            total = total + value_name
        }
    }
    assert value total == 3
}

fn test_match_expression_labels() -> Nothing {
    mutable out = ""
    value = 2
    match value {
        1 {
            out = "one"
        }
        2, 3 {
            out = "small"
        }
        default {
            out = "other"
        }
    }
    assert value out == "small"
}

fn test_match_pattern_wildcard() -> Nothing {
    value = 5
    mutable out = 0
    match value {
        _ {
            out = 1
        }
        default {
            out = 2
        }
    }
    assert value out == 1
}

fn test_match_pattern_type_check() -> Nothing {
    value = "hi"
    mutable out = ""
    match value {
        String {
            out = "string"
        }
        default {
            out = "other"
        }
    }
    assert value out == "string"
}

fn test_require_statement() -> Nothing {
    require true else "must be true"
}

// ------------------------------------------------------------
// 4) Functions and returns

fn add(left: Integer, right: Integer) -> Integer {
    return left + right
}

fn test_functions_and_return() -> Nothing {
    assert value add(left=2, right=3) == 5
}

value SubstrateSample {
    flag: Bool
    count: I32
    measure: F32
}

fn compute_middle_value(values: Array[I32, 3]) -> I32 {
    return values[1]
}

fn test_value_declarations_and_scalar_aliases() -> Nothing {
    sample = SubstrateSample(flag=true, count=7, measure=1.25)
    assert value sample.flag == true
    assert value sample.count == 7
    assert approx sample.measure ~= 1.251 within 0.01
}

fn test_fixed_array_type_surface() -> Nothing {
    assert value compute_middle_value(values=[4, 6, 7]) == 6
}

// ------------------------------------------------------------
// Vector and matrix substrate

fn test_vec2_surface() -> Nothing {
    base = vec2(3.0, 4.0)
    unit = normalize(base)
    shifted = base + vec2(1.0, -1.0)
    restored = (shifted * 0.5) / 0.5
    assert approx base.x ~= 3.0 within 0.0001
    assert approx base.y ~= 4.0 within 0.0001
    assert approx length(base) ~= 5.0 within 0.0001
    assert approx dot(unit, vec2(0.6, 0.8)) ~= 1.0 within 0.0001
    assert approx restored.x ~= 4.0 within 0.0001
    assert approx restored.y ~= 3.0 within 0.0001
}

fn test_vec3_field_access() -> Nothing {
    value = vec3(1.0, 2.0, 3.0)
    assert approx value.x ~= 1.0 within 0.0001
    assert approx value.y ~= 2.0 within 0.0001
    assert approx value.z ~= 3.0 within 0.0001
}

fn test_vec_math_intrinsics() -> Nothing {
    unit = normalize(vec3(3.0, 0.0, 4.0))
    assert approx dot(unit, vec3(1.0, 0.0, 0.0)) ~= 0.6 within 0.0001
    assert approx length(unit) ~= 1.0 within 0.0001
    assert approx cross(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0)).z ~= 1.0 within 0.0001
}

fn test_portable_math_surface() -> Nothing {
    q = normalize(quat(0.0, 3.0, 4.0, 0.0))
    assert approx q.y ~= 0.6 within 0.0001
    assert approx q.z ~= 0.8 within 0.0001
    assert approx length(q) ~= 1.0 within 0.0001

    basis = mat3_cols(
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0)
    )
    assert approx (mat3_identity() * vec3(4.0, 5.0, 6.0)).y ~= 5.0 within 0.0001
    projected = basis * vec3(1.0, 2.0, 3.0)
    assert approx projected.x ~= 1.0 within 0.0001
    assert approx projected.y ~= 2.0 within 0.0001
    assert approx projected.z ~= 3.0 within 0.0001

    assert approx f32(7) ~= 7.0 within 0.0001
    assert value i32(7.8) == 7
    assert value u32(7.8) == 7
    assert approx min(2.0, 3.0) ~= 2.0 within 0.0001
    assert approx max(2.0, 3.0) ~= 3.0 within 0.0001
    assert approx clamp(5.0, 0.0, 4.0) ~= 4.0 within 0.0001
    assert approx mix(10.0, 20.0, 0.25) ~= 12.5 within 0.0001
    assert approx abs(-3.5) ~= 3.5 within 0.0001
    assert approx sign(-3.5) ~= -1.0 within 0.0001
    assert approx floor(1.8) ~= 1.0 within 0.0001
    assert approx ceil(1.2) ~= 2.0 within 0.0001
    assert approx fract(1.25) ~= 0.25 within 0.0001
    assert approx sin(0.0) ~= 0.0 within 0.0001
    assert approx cos(0.0) ~= 1.0 within 0.0001
    assert approx sqrt(9.0) ~= 3.0 within 0.0001
    assert approx pow(2.0, 3.0) ~= 8.0 within 0.0001
    assert approx distance(vec3(0.0, 0.0, 0.0), vec3(0.0, 3.0, 4.0)) ~= 5.0 within 0.0001
    reflected = reflect(vec3(1.0, -1.0, 0.0), vec3(0.0, 1.0, 0.0))
    assert approx reflected.y ~= 1.0 within 0.0001
}

fn test_vec_and_mat_arithmetic() -> Nothing {
    left = vec3(1.0, 2.0, 3.0)
    right = vec3(4.0, 5.0, 6.0)
    sum = left + right
    delta = right - left
    scaled = sum * 0.5
    restored = scaled / 0.5
    assert approx restored.x ~= 5.0 within 0.0001
    assert approx restored.y ~= 7.0 within 0.0001
    assert approx restored.z ~= 9.0 within 0.0001
    assert approx delta.x ~= 3.0 within 0.0001
    assert approx delta.y ~= 3.0 within 0.0001
    assert approx delta.z ~= 3.0 within 0.0001

    transform = mat4_cols(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(4.0, 5.0, 6.0, 1.0)
    )
    adjusted = (transform + mat4_identity() - mat4_identity()) * 0.5 / 0.5
    result = adjusted * vec4(1.0, 2.0, 3.0, 1.0)
    assert approx result.x ~= 5.0 within 0.0001
    assert approx result.y ~= 7.0 within 0.0001
    assert approx result.z ~= 9.0 within 0.0001
    assert approx result.w ~= 1.0 within 0.0001
}

fn test_mat4_transform_path() -> Nothing {
    transform = mat4_cols(
        vec4(1.0, 0.0, 0.0, 0.0),
        vec4(0.0, 1.0, 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0)
    )
    result = transform * vec4(1.0, 2.0, 3.0, 1.0)
    assert approx result.x ~= 1.0 within 0.0001
    assert approx result.y ~= 2.0 within 0.0001
    assert approx result.z ~= 3.0 within 0.0001
    assert approx result.w ~= 1.0 within 0.0001
}

// ------------------------------------------------------------
// 5) Classes, fields, methods, and implicit receiver

class Whale {
    mutable name: String
    age: Integer

    fn show_greeting() -> String {
        return "hi {self.name}"
    }

    fn update_name(new_name: String) -> Nothing {
        self.name = new_name
        return nothing
    }

    fn get_next_age() -> Integer {
        return self.age + 1
    }
}

class BoxSelf {
    value: Integer

    fn return_self() -> BoxSelf {
        return self
    }
}

class Defaults {
    name: String = "default"
    item_count: Integer = 3
    flags: List[Boolean] = [true, false]
    metas: Map[String, Integer] = {"a": 1}
}

fn test_class_fields_and_methods() -> Nothing {
    whale = Whale(name="Moby", age=7)
    assert value whale.show_greeting() == "hi Moby"
    whale.update_name(new_name="Blue")
    assert value whale.show_greeting() == "hi Blue"
    assert value whale.get_next_age() == 8
}

fn test_return_it() -> Nothing {
    box_item = BoxSelf(value=1)
    same_box_item = box_item.return_self()
    assert value same_box_item.value == 1
}

fn test_class_field_defaults() -> Nothing {
    defaults = Defaults()
    assert value defaults.name == "default"
    assert value defaults.item_count == 3
    assert value defaults.flags == [true, false]
    assert value defaults.metas == {"a": 1}

    customized = Defaults(name="custom")
    assert value customized.name == "custom"
    assert value customized.item_count == 3
}

// ------------------------------------------------------------
// 6) Enums, interfaces, generics, and defer

enum Status {
    Pending
    Processing(worker_id: Integer)
    Done(result: String)
}

class Box[T] {
    value: T
}

interface Printable {
    must show_value() -> String
}

class Foo {
    is a Printable

    fn show_value() -> String {
        return "foo"
    }
}

class Counter {
    mutable value: Integer

    fn add(delta: Integer) -> Nothing {
        self.value += delta
        return nothing
    }
}

fn show_printable(item: Printable) -> String {
    return item.show_value()
}

fn add_deferred_bump(counter: Counter) -> Nothing {
    defer counter.add(delta=1)
    defer counter.add(delta=2)
    return nothing
}

fn test_enum_and_match_patterns() -> Nothing {
    status = Status.Processing(worker_id=7)
    match status {
        Status.Pending {
            assert value false == true
        }
        Status.Processing(id) {
            assert value id == 7
        }
        Status.Done(result) {
            assert value result == "x"
        }
        default {
            assert value true == true
        }
    }
}

fn test_generic_class_instantiation() -> Nothing {
    boxed = Box[Integer](value=7)
    assert value boxed.value == 7
}

fn test_interface_dispatch() -> Nothing {
    assert value show_printable(item=Foo()) == "foo"
}

fn test_defer_lifo() -> Nothing {
    counter = Counter(value=0)
    add_deferred_bump(counter=counter)
    assert value counter.value == 3
}

fn test_match_or_pattern_pipe() -> Nothing {
    status = Status.Pending
    mutable out = 0
    match status {
        Status.Pending | Status.Done(_) {
            out = 1
        }
        Status.Processing(_) {
            out = 0
        }
        default {
            out = 0
        }
    }
    assert value out == 1
}

fn test_match_guard_pattern() -> Nothing {
    status = Status.Processing(worker_id=7)
    mutable out = 0
    match status {
        Status.Processing(worker_id) if worker_id > 5 {
            out = worker_id
        }
        Status.Processing(_) {
            out = 0
        }
        default {
            out = 0
        }
    }
    assert value out == 7
}

// ------------------------------------------------------------
// 7) Lists, maps, and equality semantics

fn test_list_and_map_literals() -> Nothing {
    left_numbers = [1, 2, 3]
    right_numbers = [1, 2, 3]
    left_maps = {"x": 1, "y": 2}
    right_maps = {"x": 1, "y": 2}
    assert value left_numbers == right_numbers
    assert value left_maps == right_maps
}

fn test_identity_vs_value() -> Nothing {
    left_numbers = [1, 2]
    right_numbers = [1, 2]
    assert value left_numbers == right_numbers
    assert identity left_numbers == left_numbers
    assert identity left_numbers != right_numbers
}

fn test_collection_methods_and_index_ops() -> Nothing {
    numbers = [1, 2]
    numbers.push(3)
    numbers[1] = 4
    assert value numbers[0] == 1
    assert value numbers[1] == 4
    assert value numbers.len() == 3

    items = {"x": 1}
    items.set(key="y", value=2)
    items["x"] = 3
    assert value items.get("x") == 3
    assert value items["y"] == 2
    assert value items.len() == 2
}

// ------------------------------------------------------------
// 8) Operators and precedence

fn test_arithmetic_and_precedence() -> Nothing {
    assert value 1 + 2 * 3 == 7
    assert value (1 + 2) * 3 == 9
    assert value 7 % 4 == 3
}

fn test_comparisons_and_boolean_ops() -> Nothing {
    assert value 3 > 2 == true
    assert value 2 >= 2 == true
    assert value 2 < 1 == false
    assert value (true and false) == false
    assert value (true or false) == true
    assert value (false == false) == true
}

fn test_bitwise_ops() -> Nothing {
    assert value (1 & 3) == 1
    assert value (1 | 2) == 3
    assert value (5 ^ 1) == 4
    assert value (1 << 3) == 8
    assert value (8 >> 2) == 2
}

fn test_range_operator() -> Nothing {
    assert value (1...3) == [1, 2, 3]
}

fn test_range_operator_descending() -> Nothing {
    assert value (3...1) == [3, 2, 1]
}

fn test_range_operator_float() -> Nothing {
    assert value (1.0...3.0) == [1.0, 2.0, 3.0]
}

// ------------------------------------------------------------
// 9) Results, error, ??, ignore result, capture

fn try_to_return_result(is_flag: Boolean) -> Result[Integer] {
    if is_flag {
        return 7
    }
    return error "bad"
}

fn test_match_pattern_result() -> Nothing {
    result = try_to_return_result(is_flag=true)
    mutable out = 0
    match result {
        Ok(value) {
            out = value
        }
        Err(_) {
            out = 0
        }
        default {
            out = 0
        }
    }
    assert value out == 7
}

fn test_result_fallback_ok() -> Nothing {
    value = try_to_return_result(is_flag=true) ?? 0
    assert value value == 7
}

fn test_result_fallback_err() -> Nothing {
    value = try_to_return_result(is_flag=false) ?? 9
    assert value value == 9
}

fn test_result_ignore_result() -> Nothing {
    ignore result try_to_return_result(is_flag=true)
    value = try_to_return_result(is_flag=true) ?? 0
    assert value value == 7
}

fn test_result_capture() -> Nothing {
    capture result = try_to_return_result(is_flag=true)
    match result {
        Ok(value) {
            assert value value == 7
        }
        Err(_) {
            assert value false == true
        }
        default {
            assert value false == true
        }
    }
}

enum AuthError {
    MissingToken
    InvalidToken(reason: String)
}

fn try_to_parse_token(token: String) -> Result[Integer, AuthError] {
    if token == "" {
        return error AuthError.MissingToken
    }
    return 1
}

fn try_to_add_with_try(left: Result[Integer], right: Result[Integer]) -> Result[Integer] {
    left_value = left?
    right_value = right?
    return left_value + right_value
}

fn test_custom_error_handling() -> Nothing {
    result = try_to_parse_token(token="")
    match result {
        Ok(_) {
            assert value false == true
        }
        Err(err_value) {
            match err_value {
                AuthError.MissingToken {
                    assert value true == true
                }
                AuthError.InvalidToken(_) {
                    assert value false == true
                }
                default {
                    assert value false == true
                }
            }
        }
        default {
            assert value false == true
        }
    }
}

fn test_try_operator_ok_path() -> Nothing {
    total = try_to_add_with_try(left=try_to_return_result(is_flag=true), right=try_to_return_result(is_flag=true)) ?? 0
    assert value total == 14
}

fn test_try_operator_err_path() -> Nothing {
    total = try_to_add_with_try(left=try_to_return_result(is_flag=true), right=try_to_return_result(is_flag=false)) ?? 3
    assert value total == 3
}

fn test_parse_helper_result_contract() -> Nothing {
    parsed = try_to_parse_integer("42") ?? 0
    fallback = try_to_parse_integer("nope") ?? -1
    assert value parsed == 42
    assert value fallback == -1
}

// ------------------------------------------------------------
// 10) Assertions

fn test_assert_value_comparison() -> Nothing {
    assert value 1 + 1 == 2
    assert value "a" + "b" == "ab"
}

fn test_assert_identity_for_objects() -> Nothing {
    left_numbers = [1]
    right_numbers = [1]
    assert identity left_numbers != right_numbers
}

fn test_assert_approx_within_tolerance() -> Nothing {
    assert approx 1.0 ~= 1.001 within 0.01
}
