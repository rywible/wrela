    ordered_scene_capture = capture ordered_scene_shape
    overlap_scene_capture = capture overlap_scene_shape
    cutter_scene_capture = capture cutter_shape
    body_scene_capture = capture body_shape
    carved_left_scene_capture = capture carved_left_shape
    left_hit = trace_shape(
        capture=scene_capture,
        origin=vec3(-0.8, 0.0, 3.0),
