field conservative distance spine(p: Vec3) -> F32 {
    local = p - vec3(0.58, 0.0, 0.38)
    abs_local = vec3(abs(local.x), abs(local.y), abs(local.z))
    q = abs_local - vec3(0.08, 1.05, 0.06)
    outside = length(max(q, vec3(0.0, 0.0, 0.0)))
    inside = min(max(q.x, max(q.y, q.z)), 0.0)
    return outside + inside
}

field conservative distance slabs(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use slab_0
        use slab_1
        use slab_2
        use slab_3
        use slab_4
        use slab_5
    }
}

field conservative distance scene(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use slabs
        use spine
        use ground
    }
}

material slab_surface(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(210.0, 168.0, 118.0),
        roughness=0.26,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material spine_surface(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(100.0, 132.0, 190.0),
        roughness=0.18,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material ground_surface(hit: Hit3) -> Surface {
    return Surface(
        albedo=vec3(72.0, 78.0, 90.0),
        roughness=0.98,
        metalness=0.0,
        clearcoat=0.0,
        clearcoat_roughness=0.0,
        sheen=0.0,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape slabs_shape {
    field = slabs
    material = slab_surface
    payload = Payload(
        entity_id=u64(1),
        material_id=u64(1),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape spine_shape {
    field = spine
    material = spine_surface
    payload = Payload(
        entity_id=u64(2),
        material_id=u64(2),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape ground_shape {
    field = ground
    material = ground_surface
    payload = Payload(
        entity_id=u64(3),
        material_id=u64(3),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape scene_shape {
    union {
        provenance_policy = nearest
        use slabs_shape
        use spine_shape
        use ground_shape
    }
}

fn compute_scene_surface(scene_capture: ShapeCapture, hit: Hit3) -> Surface {
    return surface_at(capture=scene_capture, hit=hit)
}

fn compute_scene_hit(scene_capture: ShapeCapture, origin: Vec3, direction: Vec3) -> Hit3 {
    return trace_shape(
        capture=scene_capture,
        origin=origin,
        direction=direction,
        max_distance=14.0,
        min_step=0.04,
        hit_epsilon=0.0008,
        max_steps=112
    )
}

fn compute_shadow_visibility(
    scene_capture: ShapeCapture,
    hit_position: Vec3,
    hit_normal: Vec3,
    light: Light
) -> F32 {
    shadow_origin = hit_position + hit_normal * 0.01
    shadow_direction = normalize(light.position - shadow_origin)
    shadow_limit = length(light.position - shadow_origin)
    shadow_hit = trace_shape(
        capture=scene_capture,
        origin=shadow_origin,
        direction=shadow_direction,
        max_distance=shadow_limit,
        min_step=0.06,
        hit_epsilon=0.0012,
        max_steps=40
    )
    if shadow_hit.hit {
        return 0.0
    }
    return 1.0
}

fn compute_scene_color(
    scene_capture: ShapeCapture,
    camera_position: Vec3,
    light: Light,
    ray_direction: Vec3
) -> Vec3 {
    hit = compute_scene_hit(
        scene_capture=scene_capture,
        origin=camera_position,
        direction=ray_direction
    )

    if hit.hit {
        surface = compute_scene_surface(scene_capture=scene_capture, hit=hit)
        key_dir = normalize(light.position - hit.position)
        fill_dir = normalize(vec3(-0.5, 0.42, 0.25))
        view_dir = normalize(camera_position - hit.position)
        half_dir = normalize(key_dir + view_dir)
        distance_to_light = length(light.position - hit.position)
        attenuation = clamp(1.0 - distance_to_light / light.range, 0.0, 1.0)
        shadow = compute_shadow_visibility(
            scene_capture=scene_capture,
            hit_position=hit.position,
            hit_normal=hit.normal,
            light=light
        )
        diffuse = max(dot(hit.normal, key_dir), 0.0) * shadow
        fill = 0.22 * max(dot(hit.normal, fill_dir), 0.0)
        specular = pow(max(dot(hit.normal, half_dir), 0.0), 26.0) * 0.17
        lighting = 0.11 + (0.90 * diffuse * attenuation) + (fill * 0.26)
        return vec3(
            clamp(surface.albedo.x * lighting * light.intensity.x + 240.0 * specular * (0.2 + surface.roughness * 0.8), 0.0, 255.0),
            clamp(surface.albedo.y * lighting * light.intensity.y + 214.0 * specular * (0.2 + surface.roughness * 0.8), 0.0, 255.0),
            clamp(surface.albedo.z * lighting * light.intensity.z + 188.0 * specular * (0.2 + surface.roughness * 0.8), 0.0, 255.0)
        )
    }

    sky_t = 0.5 * (ray_direction.y + 1.0)
    return vec3(8.0, 10.0, 16.0) * (1.0 - sky_t) + vec3(58.0, 84.0, 130.0) * sky_t
}

fn render_ppm() -> String {
    width = 48
    height = 48
    aspect = f32(width) / f32(height)
    camera_position = vec3(-0.15, 0.55, 4.4)
    forward = normalize(vec3(0.10, -0.10, -1.0))
    world_up = vec3(0.0, 1.0, 0.0)
    right = normalize(cross(forward, world_up))
    up = normalize(cross(right, forward))
    scene_capture = capture scene_shape
    light = Light(
        position=vec3(2.7, 3.0, 2.0),
        direction=normalize(vec3(-0.9, -0.85, -0.8)),
        intensity=vec3(1.0, 0.98, 0.96),
        range=18.0
    )

    mutable ppm = "P3\n48 48\n255\n"
    mutable y = 0
    while y < height {
        mutable x = 0
        while x < width {
            sample_u = (f32(x) + 0.5) / f32(width)
            sample_v = (f32(y) + 0.5) / f32(height)
            screen_x = (sample_u - 0.5) * 2.0 * aspect * 0.74
            screen_y = (0.5 - sample_v) * 2.0 * 0.74
            ray = normalize(forward + right * screen_x + up * screen_y)
            shaded = compute_scene_color(
                scene_capture=scene_capture,
                camera_position=camera_position,
                light=light,
                ray_direction=ray
            )
            r = i32(clamp(shaded.x, 0.0, 255.0))
            g = i32(clamp(shaded.y, 0.0, 255.0))
            b = i32(clamp(shaded.z, 0.0, 255.0))

            ppm += "{r} {g} {b}\n"
            x += 1
        }
        y += 1
    }

    return ppm
}

fn run() -> Integer {
    print_line(text=render_ppm())
    return 0
}
