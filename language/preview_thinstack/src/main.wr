use print_line from host/io

field exact distance ground(p: Vec3) -> F32 {
    plane(normal=vec3(0.0, 1.0, 0.0), offset=1.0)
}

field conservative distance slab_0(p: Vec3) -> F32 {
    local = p - vec3(-0.34, -0.74, 0.0)
    abs_local = vec3(abs(local.x), abs(local.y), abs(local.z))
    q = abs_local - vec3(1.02, 0.05, 0.72)
    outside = length(max(q, vec3(0.0, 0.0, 0.0)))
    inside = min(max(q.x, max(q.y, q.z)), 0.0)
    return outside + inside
}

field conservative distance slab_1(p: Vec3) -> F32 {
    local = p - vec3(-0.22, -0.50, 0.02)
    abs_local = vec3(abs(local.x), abs(local.y), abs(local.z))
    q = abs_local - vec3(0.94, 0.045, 0.66)
    outside = length(max(q, vec3(0.0, 0.0, 0.0)))
    inside = min(max(q.x, max(q.y, q.z)), 0.0)
    return outside + inside
}

