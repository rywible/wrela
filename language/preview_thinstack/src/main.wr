use print_line from host/io

field exact distance ground(p: Vec3) -> F32 {
    plane(normal=vec3(0.0, 1.0, 0.0), offset=1.0)
}

field conservative distance torso(p: Vec3) -> F32 {
    loft = f32(1.24) {
        from rounded_rect2(half = vec2(0.24, 0.18), radius = 0.10)
        to rounded_rect2(half = vec2(0.36, 0.26), radius = 0.12)
    }
}

field conservative distance hips(p: Vec3) -> F32 {
    translate = vec3(0.0, -0.58, 0.0) {
        extrude = f32(0.34) {
            rounded_rect2(half = vec2(0.34, 0.18), radius = 0.08)
        }
    }
}

field conservative distance head(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.94, 0.0) {
        revolve {
            circle2(radius = 0.28)
        }
    }
}

field conservative distance shoulder_shell(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.28, 0.0) {
        extrude = f32(0.28) {
            capsule2(a = vec2(-0.34, 0.0), b = vec2(0.34, 0.0), radius = 0.15)
        }
    }
}

field conservative distance leg_column(p: Vec3) -> F32 {
    sweep = vec3(0.0, 0.94, 0.0) {
        circle2(radius = 0.09)
    }
}

field conservative distance arms(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.12, 0.0) {
        mirror_array = vec3(1.0, 0.0, 0.0) {
            translate = vec3(0.46, 0.0, 0.0) {
                sweep = vec3(0.72, 0.0, 0.0) {
                    circle2(radius = 0.07)
                }
            }
        }
    }
}

field conservative distance legs(p: Vec3) -> F32 {
    mirror_array = vec3(1.0, 0.0, 0.0) {
        translate = vec3(0.18, -1.04, 0.0) {
            use leg_column
        }
    }
}

field conservative distance body_cluster(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use torso
        use hips
        use legs
        use shoulder_shell
    }
}

field conservative distance scene(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use body_cluster
        use head
        use arms
        use ground
    }
}

radiance field scene_radiance(p: Vec3, direction: Vec3, feature_id: U64) -> Vec3 {
    sky_t = clamp(0.5 + direction.y * 0.5, 0.0, 1.0)
    silhouette = clamp(0.22 - abs(p.x) * 0.14 - abs(p.y - 0.9) * 0.10, 0.0, 0.22) / 0.22
    feature_bias = clamp(f32(feature_id), 0.0, 1.0)
    return vec3(8.0, 10.0, 16.0) * (1.0 - sky_t)
        + vec3(58.0, 84.0, 130.0) * sky_t
        + vec3(10.0, 9.0, 12.0) * silhouette * (0.35 + 0.65 * feature_bias)
}

volume field scene_volume(p: Vec3, surface_distance: F32) -> Medium {
    torso_band = clamp((0.9 - abs(p.y)) * 0.5, 0.0, 0.5) / 0.5
    near_surface = clamp((0.14 - abs(surface_distance)) * 6.0, 0.0, 1.0)
    density = clamp(0.014 + torso_band * 0.025 + near_surface * 0.016, 0.0, 0.10)
    return Medium(
        density=density,
        emission=vec3(2.5, 3.5, 5.5) * density + vec3(0.0, 0.01, 0.02) * near_surface,
        anisotropy=0.12
    )
}

material slab_surface(hit: Hit3) -> Surface {
    slab_band = clamp(abs(hit.local_position.y) * 0.35 + abs(hit.local_normal.x) * 0.25, 0.0, 1.0)
    return Surface(
        albedo=vec3(196.0, 156.0, 108.0) + vec3(20.0, 14.0, 10.0) * slab_band,
        roughness=0.18 + slab_band * 0.18,
        metalness=0.08 + clamp(hit.local_normal.z, 0.0, 1.0) * 0.12,
        clearcoat=0.12 + clamp(hit.local_normal.y, 0.0, 1.0) * 0.18,
        clearcoat_roughness=0.08 + abs(hit.local_position.x) * 0.10,
        sheen=0.04 + abs(hit.local_normal.x) * 0.14,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material spine_surface(hit: Hit3) -> Surface {
    crest = clamp(0.5 + hit.local_position.y * 0.45 + abs(hit.local_normal.x) * 0.2, 0.0, 1.0)
    return Surface(
        albedo=vec3(92.0, 126.0, 182.0) + vec3(12.0, 16.0, 22.0) * crest,
        roughness=0.12 + abs(hit.local_position.z) * 0.12,
        metalness=0.18 + crest * 0.16,
        clearcoat=0.18 + crest * 0.18,
        clearcoat_roughness=0.10 + (1.0 - crest) * 0.12,
        sheen=0.08 + abs(hit.local_normal.y) * 0.16,
        emissive=vec3(2.0, 2.4, 4.2) * clamp(hit.local_normal.y, 0.0, 1.0)
    )
}

material ground_surface(hit: Hit3) -> Surface {
    dust = clamp(abs(hit.local_position.x) * 0.18 + abs(hit.local_position.z) * 0.18, 0.0, 1.0)
    return Surface(
        albedo=vec3(66.0, 74.0, 86.0) + vec3(8.0, 7.0, 6.0) * dust,
        roughness=0.90 + dust * 0.08,
        metalness=0.0,
        clearcoat=0.03,
        clearcoat_roughness=0.22,
        sheen=0.02,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape slabs_shape {
    field = body_cluster
    material = slab_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u64(1),
        material_id=u64(1),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape spine_shape {
    field = head
    material = spine_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u64(2),
        material_id=u64(2),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape displace_shape {
    field = arms
    material = slab_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u64(4),
        material_id=u64(4),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape ground_shape {
    field = ground
    material = ground_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u64(5),
        material_id=u64(5),
        actor=ActorHandle(id=u64(1), generation=u32(0))
    )
}

shape scene_shape {
    union {
        provenance_policy = nearest
        use slabs_shape
        use spine_shape
        use displace_shape
        use ground_shape
    }
}

fn compute_scene_surface(scene_capture: ShapeCapture, hit: Hit3) -> Surface {
    return surface_at(capture=scene_capture, hit=hit)
}

fn compute_scene_hit(scene_capture: ShapeCapture, origin: Vec3, direction: Vec3) -> Hit3 {
    return trace_shape(
        capture=scene_capture,
        origin=origin,
        direction=direction,
        max_distance=14.0,
        min_step=0.04,
        hit_epsilon=0.0008,
        max_steps=88
    )
}

fn compute_shadow_visibility(
    scene_capture: ShapeCapture,
    hit_position: Vec3,
    hit_normal: Vec3,
    light: Light
) -> F32 {
    shadow_origin = hit_position + hit_normal * 0.01
    shadow_direction = normalize(light.position - shadow_origin)
    shadow_limit = length(light.position - shadow_origin)
    shadow_hit = trace_shape(
        capture=scene_capture,
        origin=shadow_origin,
        direction=shadow_direction,
        max_distance=shadow_limit,
        min_step=0.06,
        hit_epsilon=0.0012,
        max_steps=24
    )
    if shadow_hit.hit {
        return 0.0
    }
    return 1.0
}

fn compute_ambient_occlusion(
    scene_capture: ShapeCapture,
    hit_position: Vec3,
    hit_normal: Vec3
) -> F32 {
    sample_a = distance_at(capture=scene_capture, point=hit_position + hit_normal * 0.06)
    sample_b = distance_at(capture=scene_capture, point=hit_position + hit_normal * 0.14)
    sample_c = distance_at(capture=scene_capture, point=hit_position + hit_normal * 0.30)
    occlusion = clamp(
        (0.06 - sample_a) * 1.4 + (0.14 - sample_b) * 1.0 + (0.30 - sample_c) * 0.8,
        0.0,
        1.0
    )
    return 1.0 - occlusion * 0.80
}

fn compute_scene_color(
    scene_capture: ShapeCapture,
    camera_position: Vec3,
    light: Light,
    ray_direction: Vec3
) -> Vec3 {
    hit = compute_scene_hit(
        scene_capture=scene_capture,
        origin=camera_position,
        direction=ray_direction
    )

    if hit.hit {
        surface = compute_scene_surface(scene_capture=scene_capture, hit=hit)
        radiance = radiance_at(
            capture=scene_capture,
            point=hit.position,
            direction=ray_direction
        )
        medium = medium_at(capture=scene_capture, point=hit.position)
        key_dir = normalize(light.position - hit.position)
        fill_dir = normalize(vec3(-0.5, 0.42, 0.25))
        view_dir = normalize(camera_position - hit.position)
        half_dir = normalize(key_dir + view_dir)
        distance_to_light = length(light.position - hit.position)
        attenuation = clamp(1.0 - distance_to_light / light.range, 0.0, 1.0)
        ao = compute_ambient_occlusion(
            scene_capture=scene_capture,
            hit_position=hit.position,
            hit_normal=hit.normal
        )
        shadow = compute_shadow_visibility(
            scene_capture=scene_capture,
            hit_position=hit.position,
            hit_normal=hit.normal,
            light=light
        )
        ndotl = max(dot(hit.normal, key_dir), 0.0)
        ndotv = max(dot(hit.normal, view_dir), 0.0)
        ndoth = max(dot(hit.normal, half_dir), 0.0)
        diffuse = ndotl * shadow
        fill = 0.22 * max(dot(hit.normal, fill_dir), 0.0) * ao
        specular = pow(ndoth, mix(58.0, 9.0, clamp(surface.roughness, 0.0, 1.0))) * (0.16 + surface.metalness * 0.34 + surface.clearcoat * 0.36)
        sheen = surface.sheen * pow(1.0 - ndotv, 3.0) * 20.0
        lighting = (0.11 + (0.90 * diffuse * attenuation) + (fill * 0.26)) * ao
        direct = vec3(
            clamp(surface.albedo.x * lighting * light.intensity.x + 240.0 * specular + sheen * 0.7, 0.0, 255.0),
            clamp(surface.albedo.y * lighting * light.intensity.y + 214.0 * specular + sheen * 0.5, 0.0, 255.0),
            clamp(surface.albedo.z * lighting * light.intensity.z + 188.0 * specular + sheen * 0.4, 0.0, 255.0)
        )
        fog_strength = clamp(medium.density * distance_to_light * 0.18 + (1.0 - ao) * 0.12, 0.0, 0.58)
        fog_color = medium.emission + radiance * 0.22
        return mix(direct + surface.emissive + radiance * 0.20, fog_color, fog_strength)
    }

    miss_point = camera_position + ray_direction * 4.0
    miss_radiance = radiance_at(
        capture=scene_capture,
        point=miss_point,
        direction=ray_direction
    )
    miss_medium = medium_at(capture=scene_capture, point=miss_point)
    miss_fog = clamp(miss_medium.density * 2.9, 0.0, 0.44)
    return mix(miss_radiance, miss_medium.emission + miss_radiance * 0.24, miss_fog)
}

fn render_ppm() -> String {
    width = 40
    height = 40
    aspect = f32(width) / f32(height)
    camera_position = vec3(-0.15, 0.55, 4.4)
    forward = normalize(vec3(0.10, -0.10, -1.0))
    world_up = vec3(0.0, 1.0, 0.0)
    right = normalize(cross(forward, world_up))
    up = normalize(cross(right, forward))
    scene_capture = capture scene_shape
    light = Light(
        position=vec3(2.7, 3.0, 2.0),
        direction=normalize(vec3(-0.9, -0.85, -0.8)),
        intensity=vec3(1.0, 0.98, 0.96),
        range=18.0
    )

    mutable ppm = "P3\n40 40\n255\n"
    mutable y = 0
    while y < height {
        mutable x = 0
        while x < width {
            sample_u = (f32(x) + 0.5) / f32(width)
            sample_v = (f32(y) + 0.5) / f32(height)
            screen_x = (sample_u - 0.5) * 2.0 * aspect * 0.74
            screen_y = (0.5 - sample_v) * 2.0 * 0.74
            ray = normalize(forward + right * screen_x + up * screen_y)
            shaded = compute_scene_color(
                scene_capture=scene_capture,
                camera_position=camera_position,
                light=light,
                ray_direction=ray
            )
            r = i32(clamp(shaded.x, 0.0, 255.0))
            g = i32(clamp(shaded.y, 0.0, 255.0))
            b = i32(clamp(shaded.z, 0.0, 255.0))

            ppm += "{r} {g} {b}\n"
            x += 1
        }
        y += 1
    }

    return ppm
}

fn run() -> Integer {
    print_line(text=render_ppm())
    return 0
}
