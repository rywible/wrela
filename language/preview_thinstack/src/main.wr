use print_line from host/io

field exact distance ground(p: Vec3) -> F32 {
    plane(normal=vec3(0.0, 1.0, 0.0), offset=1.0)
}

field conservative distance torso(p: Vec3) -> F32 {
    loft = f32(1.24) {
        from rounded_rect2(half = vec2(0.24, 0.18), radius = 0.10)
        to rounded_rect2(half = vec2(0.36, 0.26), radius = 0.12)
    }
}

field conservative distance hips(p: Vec3) -> F32 {
    translate = vec3(0.0, -0.58, 0.0) {
        extrude = f32(0.34) {
            rounded_rect2(half = vec2(0.34, 0.18), radius = 0.08)
        }
    }
}

field conservative distance head(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.94, 0.0) {
        revolve {
            circle2(radius = 0.28)
        }
    }
}

field conservative distance shoulder_shell(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.28, 0.0) {
        extrude = f32(0.28) {
            capsule2(a = vec2(-0.34, 0.0), b = vec2(0.34, 0.0), radius = 0.15)
        }
    }
}

field conservative distance leg_column(p: Vec3) -> F32 {
    sweep = vec3(0.0, 0.94, 0.0) {
        circle2(radius = 0.09)
    }
}

field conservative distance arms(p: Vec3) -> F32 {
    translate = vec3(0.0, 0.12, 0.0) {
        mirror_array = vec3(1.0, 0.0, 0.0) {
            translate = vec3(0.46, 0.0, 0.0) {
                sweep = vec3(0.72, 0.0, 0.0) {
                    circle2(radius = 0.07)
                }
            }
        }
    }
}

field conservative distance legs(p: Vec3) -> F32 {
    mirror_array = vec3(1.0, 0.0, 0.0) {
        translate = vec3(0.18, -1.04, 0.0) {
            use leg_column
        }
    }
}

field conservative distance body_cluster(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use torso
        use hips
        use legs
        use shoulder_shell
    }
}

field conservative distance scene(p: Vec3) -> F32 {
    union {
        provenance_policy = nearest
        use body_cluster
        use head
        use arms
        use ground
    }
}

radiance field scene_radiance(p: Vec3, direction: Vec3, feature_id: U32) -> Vec3 {
    sky_t = clamp(0.5 + direction.y * 0.5, 0.0, 1.0)
    silhouette = clamp(0.22 - abs(p.x) * 0.14 - abs(p.y - 0.9) * 0.10, 0.0, 0.22) / 0.22
    return vec3(8.0, 10.0, 16.0) * (1.0 - sky_t)
        + vec3(58.0, 84.0, 130.0) * sky_t
        + vec3(10.0, 9.0, 12.0) * silhouette
}

volume field scene_volume(p: Vec3, surface_distance: F32) -> Medium {
    torso_band = clamp((0.9 - abs(p.y)) * 0.5, 0.0, 0.5) / 0.5
    near_surface = clamp((0.14 - abs(surface_distance)) * 6.0, 0.0, 1.0)
    density = clamp(0.014 + torso_band * 0.025 + near_surface * 0.016, 0.0, 0.10)
    return Medium(
        density=density,
        emission=vec3(2.5, 3.5, 5.5) * density + vec3(0.0, 0.01, 0.02) * near_surface,
        anisotropy=0.12
    )
}

material slab_surface(hit: Hit3) -> Surface {
    slab_band = clamp(abs(hit.local_position.y) * 0.35 + abs(hit.local_normal.x) * 0.25, 0.0, 1.0)
    return Surface(
        albedo=vec3(196.0, 156.0, 108.0) + vec3(20.0, 14.0, 10.0) * slab_band,
        roughness=0.18 + slab_band * 0.18,
        metalness=0.08 + clamp(hit.local_normal.z, 0.0, 1.0) * 0.12,
        clearcoat=0.12 + clamp(hit.local_normal.y, 0.0, 1.0) * 0.18,
        clearcoat_roughness=0.08 + abs(hit.local_position.x) * 0.10,
        sheen=0.04 + abs(hit.local_normal.x) * 0.14,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

material spine_surface(hit: Hit3) -> Surface {
    crest = clamp(0.5 + hit.local_position.y * 0.45 + abs(hit.local_normal.x) * 0.2, 0.0, 1.0)
    return Surface(
        albedo=vec3(92.0, 126.0, 182.0) + vec3(12.0, 16.0, 22.0) * crest,
        roughness=0.12 + abs(hit.local_position.z) * 0.12,
        metalness=0.18 + crest * 0.16,
        clearcoat=0.18 + crest * 0.18,
        clearcoat_roughness=0.10 + (1.0 - crest) * 0.12,
        sheen=0.08 + abs(hit.local_normal.y) * 0.16,
        emissive=vec3(2.0, 2.4, 4.2) * clamp(hit.local_normal.y, 0.0, 1.0)
    )
}

material ground_surface(hit: Hit3) -> Surface {
    dust = clamp(abs(hit.local_position.x) * 0.18 + abs(hit.local_position.z) * 0.18, 0.0, 1.0)
    return Surface(
        albedo=vec3(66.0, 74.0, 86.0) + vec3(8.0, 7.0, 6.0) * dust,
        roughness=0.90 + dust * 0.08,
        metalness=0.0,
        clearcoat=0.03,
        clearcoat_roughness=0.22,
        sheen=0.02,
        emissive=vec3(0.0, 0.0, 0.0)
    )
}

shape slabs_shape {
    field = body_cluster
    material = slab_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(1),
        material_id=u32(1),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape spine_shape {
    field = head
    material = spine_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(2),
        material_id=u32(2),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape displace_shape {
    field = arms
    material = slab_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(4),
        material_id=u32(4),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape ground_shape {
    field = ground
    material = ground_surface
    radiance = scene_radiance
    volume = scene_volume
    payload = Payload(
        entity_id=u32(5),
        material_id=u32(5),
        actor=ActorHandle(id=u32(1), generation=u32(0))
    )
}

shape scene_shape {
    union {
        provenance_policy = nearest
        use slabs_shape
        use spine_shape
        use displace_shape
        use ground_shape
    }
}

region scene_region() {
    place coarse = scene_shape
    place fine = scene_shape
}

domain scene_domain(world: RegionCapture) {
    geometry_detail = 1
    material = true
    radiance = true
    media = true
    max_distance = 14.0
    min_step = 0.04
    hit_epsilon = 0.0008
    max_steps = 88
}

render render_ppm(
    world: RegionCapture,
    camera: Camera
) {
    domain = scene_domain(world = world)
    light = Light(
        position=vec3(-1.8, 3.0, 2.8),
        direction=normalize(vec3(-0.9, -0.85, -0.8)),
        intensity=vec3(1.0, 0.98, 0.96),
        range=18.0
    )
    width = 40
    height = 40
    world_up = camera.up
    view_scale = 0.74
    fill_dir = normalize(vec3(-0.5, 0.42, 0.25))
}

fn run() -> Integer {
    camera = Camera(
        position=vec3(-0.15, 0.55, 4.4),
        forward=normalize(vec3(0.10, -0.10, -1.0)),
        up=vec3(0.0, 1.0, 0.0),
        vertical_fov_degrees=46.0
    )
    world = capture scene_region
    print_line(text=render_ppm(world=world, camera=camera))
    return 0
}
