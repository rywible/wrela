field conservative distance slab_3(p: Vec3) -> F32 {
    local = p - vec3(0.04, -0.02, 0.03)
    abs_local = vec3(abs(local.x), abs(local.y), abs(local.z))
    q = abs_local - vec3(0.74, 0.035, 0.54)
    outside = length(max(q, vec3(0.0, 0.0, 0.0)))
    inside = min(max(q.x, max(q.y, q.z)), 0.0)
    return outside + inside
}

field conservative distance slab_4(p: Vec3) -> F32 {
    local = p - vec3(0.18, 0.22, -0.02)
    abs_local = vec3(abs(local.x), abs(local.y), abs(local.z))
    q = abs_local - vec3(0.64, 0.032, 0.48)
    outside = length(max(q, vec3(0.0, 0.0, 0.0)))
    inside = min(max(q.x, max(q.y, q.z)), 0.0)
