fn play_combat_impact(sound_id: Integer, volume: Integer) -> Integer {
    return __wr_audio_play_oneshot(sound_id, volume, 100, 0)
}

fn play_ambient_loop(sound_id: Integer, volume: Integer, fade_ms: Integer) -> Integer {
    return __wr_audio_play_loop(sound_id, volume, fade_ms)
}

fn stop_ambient_loop(handle: Integer, fade_ms: Integer) -> Integer {
    return __wr_audio_stop_loop(handle, fade_ms)
}

fn set_audio_listener(x: Integer, y: Integer, z: Integer) -> Integer {
    return __wr_audio_set_listener(x, y, z)
}

fn set_audio_parameter(name: String, value: Integer) -> Integer {
    return __wr_audio_set_parameter(name, value)
}
