so:
    Logging helpers and configuration.

A Logger:
    has:
        level: String = "info"

    so: Apply logging configuration when fields are provided.
    can __configure__() -> Nothing:
        if its.level != nothing:
            return __wr_log_configure(its)
        return nothing

    so: Log a debug message.
    can debug(message: String) -> Nothing:
        __wr_log("debug", message, __wr_map_new())
        return nothing

    so: Log an info message.
    can info(message: String) -> Nothing:
        __wr_log("info", message, __wr_map_new())
        return nothing

    so: Log a warning message.
    can warn(message: String) -> Nothing:
        __wr_log("warn", message, __wr_map_new())
        return nothing

    so: Log an error message.
    can emit_error(message: String) -> Nothing:
        __wr_log("error", message, __wr_map_new())
        return nothing

    so: Log a debug message with fields.
    can debug_with(message: String, fields: Map) -> Nothing:
        __wr_log("debug", message, fields)
        return nothing

    so: Log an info message with fields.
    can info_with(message: String, fields: Map) -> Nothing:
        __wr_log("info", message, fields)
        return nothing

    so: Log a warning message with fields.
    can warn_with(message: String, fields: Map) -> Nothing:
        __wr_log("warn", message, fields)
        return nothing

    so: Log an error message with fields.
    can emit_error_with(message: String, fields: Map) -> Nothing:
        __wr_log("error", message, fields)
        return nothing

    so: Log a debug message.
    can debug_log(message: String) -> Nothing:
        __wr_log("debug", message, __wr_map_new())
        return nothing

    so: Log an info message.
    can info_log(message: String) -> Nothing:
        __wr_log("info", message, __wr_map_new())
        return nothing

    so: Log a warning message.
    can warn_log(message: String) -> Nothing:
        __wr_log("warn", message, __wr_map_new())
        return nothing

    so: Log a warning message (alias).
    can warn_log_alias(message: String) -> Nothing:
        __wr_log("warn", message, __wr_map_new())
        return nothing

    so: Log an error message.
    can emit_error_log(message: String) -> Nothing:
        __wr_log("error", message, __wr_map_new())
        return nothing

    so: Log a debug message with fields.
    can debug_log_with(message: String, fields: Map) -> Nothing:
        __wr_log("debug", message, fields)
        return nothing

    so: Log an info message with fields.
    can info_log_with(message: String, fields: Map) -> Nothing:
        __wr_log("info", message, fields)
        return nothing

    so: Log a warning message with fields.
    can warn_log_with(message: String, fields: Map) -> Nothing:
        __wr_log("warn", message, fields)
        return nothing

    so: Log a warning message with fields (alias).
    can warn_log_with_alias(message: String, fields: Map) -> Nothing:
        __wr_log("warn", message, fields)
        return nothing

    so: Log an error message with fields.
    can emit_error_log_with(message: String, fields: Map) -> Nothing:
        __wr_log("error", message, fields)
        return nothing
