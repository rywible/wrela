//
// Security header defaults for HTTP responses.


fn apply_default_web_security_headers(headers: Map[Any, Any]) -> Map[Any, Any] {
    __wr_map_set(map=headers, key="Content-Security-Policy", value="default-src 'self'; frame-ancestors 'none'; base-uri 'self'")
    __wr_map_set(map=headers, key="X-Content-Type-Options", value="nosniff")
    __wr_map_set(map=headers, key="X-Frame-Options", value="DENY")
    __wr_map_set(map=headers, key="Referrer-Policy", value="strict-origin-when-cross-origin")
    __wr_map_set(map=headers, key="Permissions-Policy", value="camera=(), microphone=(), geolocation=()"
    )
    return headers
}
