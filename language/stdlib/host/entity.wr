fn spawn_entity(archetype_id: Integer) -> Integer {
    return __wr_entity_spawn(archetype_id)
}

fn despawn_entity(entity_id: Integer) -> Integer {
    return __wr_entity_despawn(entity_id)
}

fn set_entity_position(entity_id: Integer, x: Integer, y: Integer, z: Integer) -> Integer {
    return __wr_entity_set_position(entity_id, x, y, z)
}

fn get_entity_position_x(entity_id: Integer) -> Integer {
    return __wr_entity_get_position_x(entity_id)
}

fn get_entity_position_y(entity_id: Integer) -> Integer {
    return __wr_entity_get_position_y(entity_id)
}

fn get_entity_position_z(entity_id: Integer) -> Integer {
    return __wr_entity_get_position_z(entity_id)
}

fn set_entity_component(entity_id: Integer, key: String, value: Integer) -> Integer {
    return __wr_entity_set_component(entity_id, key, value)
}

fn get_entity_component(entity_id: Integer, key: String) -> Integer {
    return __wr_entity_get_component(entity_id, key)
}

fn query_entities_by_archetype(archetype_id: Integer) -> Integer {
    return __wr_entity_query_archetype(archetype_id)
}

fn query_entities_in_radius(x: Integer, y: Integer, z: Integer, radius: Integer) -> Integer {
    return __wr_entity_query_radius(x, y, z, radius)
}

fn entity_count() -> Integer {
    return __wr_entity_count()
}
