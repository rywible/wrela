//
// File system helpers.

// Read a UTF-8 text file into a String.
fn try_to_read_text(path: String) -> Result[String] {
    match __wr_fs_read_bytes(path) {
        Ok(bytes) {
            text = __wr_bytes_to_string(bytes)
            match text {
                String {
                    return text
                }
                default {
                    return error "try_to_read_text: invalid utf8"
                }
            }
        }
        Err(err) {
            return error err

        }
    }
}
// Write a String to a UTF-8 text file.
fn try_to_write_text(path: String, contents: String) -> Result[Nothing] {
    payload = __wr_bytes_from_string(contents)
    return __wr_fs_write_bytes(path, payload)
}
