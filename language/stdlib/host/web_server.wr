//
// Wrela-native HTTP server primitives.
// NOTE: The legacy interactive HTTP transport lane has been retired.
// Compatibility wrappers remain only to steer callers toward the core HTTP server surface.

use {
    get_bytes_from_string,
    get_list_from_bytes
}
from bytes

class HttpListenerConfiguration {
    mutable bind_address: String = "127.0.0.1:8080"
    mutable listener_namespace: String = "app"
    mutable reuse_port_enabled: Boolean = false

}
class HttpRouteDefinition {
    mutable method: String = "GET"
    mutable path: String = "/"
    mutable required_scope: String = ""

}
class HttpRequest {
    mutable method: String = ""
    mutable path: String = ""
    mutable headers: Map[Any, Any] = {}
    mutable body: Any = nothing
    mutable keep_alive_requested: Boolean = true

}
class HttpResponse {
    mutable status_code: Integer = 200
    mutable reason_phrase: String = ""
    mutable headers: Map[Any, Any] = {}
    mutable body: Any = nothing
    mutable should_close_connection: Boolean = false

}
class HttpMiddlewarePipeline {
    mutable middleware_names: List[String] = []

}
class HttpRequestQueueThresholdConfiguration {
    mutable authentication_queue_threshold: Integer = 128
    mutable application_queue_threshold: Integer = 512
    mutable static_asset_queue_threshold: Integer = 256
    mutable retry_after_seconds: Integer = 1


}
fn create_http_server_configuration(
    bind_address: String,
    listener_namespace: String
) -> HttpListenerConfiguration {
    return HttpListenerConfiguration(
        bind_address=bind_address,
        listener_namespace=listener_namespace
    )


}
fn create_http_server_configuration_map(configuration: HttpListenerConfiguration) -> Map[Any, Any] {
    configuration_items = __wr_map_new()
    __wr_map_set(map=configuration_items, key="bind_address", value=configuration.bind_address)
    __wr_map_set(map=configuration_items, key="listener_namespace", value=configuration.listener_namespace)
    __wr_map_set(map=configuration_items, key="reuse_port_enabled", value=configuration.reuse_port_enabled)
    return configuration_items


}
