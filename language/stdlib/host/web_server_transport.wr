//
// Deprecated compatibility shim for legacy HTTP transport wrappers.
// Interactive web transport behavior is retired in favor of host/game_transport.

class HttpListenerConfiguration {
    mutable bind_address: String = "127.0.0.1:8080"
    mutable listener_namespace: String = "app"
    mutable reuse_port_enabled: Boolean = false


}
fn create_http_server_configuration(
    bind_address: String,
    listener_namespace: String
) -> HttpListenerConfiguration {
    return HttpListenerConfiguration(
        bind_address=bind_address,
        listener_namespace=listener_namespace
    )


}
fn create_http_server_configuration_map(configuration: HttpListenerConfiguration) -> Map[Any, Any] {
    configuration_items = __wr_map_new()
    __wr_map_set(map=configuration_items, key="bind_address", value=configuration.bind_address)
    __wr_map_set(map=configuration_items, key="listener_namespace", value=configuration.listener_namespace)
    __wr_map_set(map=configuration_items, key="reuse_port_enabled", value=configuration.reuse_port_enabled)
    return configuration_items


}
fn create_web_transport_retired_error() -> String {
    return "host/web_server_transport retired: use host/game_transport and pkg/game"


}
fn try_to_create_http_server_listener(configuration: HttpListenerConfiguration) -> Result[Integer] {
    return error create_web_transport_retired_error()


}
fn try_to_create_http_server_listener_by_address(
    bind_address: String,
    listener_namespace: String
) -> Result[Integer] {
    return error create_web_transport_retired_error()


}
fn try_to_poll_http_server_event(
    poll_listener_handle: Integer,
    poll_timeout_milliseconds: Integer
) -> Result[Map[Any, Any]] {
    return error create_web_transport_retired_error()


}
fn try_to_accept_http_connection(accept_listener_handle: Integer) -> Result[Integer] {
    return error create_web_transport_retired_error()


}
fn try_to_read_http_request_frame_items(
    read_listener_handle: Integer,
    read_connection_handle: Integer
) -> Result[Map[Any, Any]] {
    return error create_web_transport_retired_error()


}
fn get_http_request_path(path_request_items: Map[Any, Any]) -> String {
    request_path_value = __wr_map_get(map=path_request_items, key="path")
    match request_path_value {
        String(request_path_text) {
            return request_path_text
        }
        default {
            return "/"


        }
    }
}
fn try_to_write_http_response_frame_items(
    write_listener_handle: Integer,
    write_connection_handle: Integer,
    write_response_frame_items: Map[Any, Any]
) -> Result[Integer] {
    return error create_web_transport_retired_error()


}
fn try_to_close_http_connection(
    close_listener_handle: Integer,
    close_connection_handle: Integer
) -> Result[Nothing] {
    return error create_web_transport_retired_error()


}
fn get_http_event_type(event_type_items: Map[Any, Any]) -> String {
    event_type_value = __wr_map_get(map=event_type_items, key="event_type")
    match event_type_value {
        String(event_type_text_value) {
            return event_type_text_value
        }
        default {
            return ""


        }
    }
}
fn get_http_event_connection_handle(event_connection_items: Map[Any, Any]) -> Integer {
    event_connection_value = __wr_map_get(map=event_connection_items, key="connection_handle")
    match event_connection_value {
        Integer(event_connection_handle) {
            return event_connection_handle
        }
        default {
            return -1


        }
    }
}
fn try_to_render_json_response_body(render_body_value: Any) -> Result[String] {
    render_body_result = __wr_web_render_json_text(render_body_value)
    match render_body_result {
        Ok(rendered_response_text) {
            return rendered_response_text
        }
        Err(render_response_error) {
            return error render_response_error
        }
        default {
            return error "web_render_json_text returned unexpected value"


        }
    }
}
fn create_json_response_frame_items(
    response_status_code: Integer,
    response_body_items: Map[Any, Any]
) -> Map[Any, Any] {
    response_frame_items = {}
    response_frame_items.set("status_code", response_status_code)

    headers = {}
    headers.set("Content-Type", "application/json")
    response_frame_items.set("headers", headers)

    rendered_body_result = try_to_render_json_response_body(response_body_items)
    match rendered_body_result {
        Ok(rendered_body_text) {
            response_frame_items.set("body_text", rendered_body_text)
        }
        Err(_) {
            response_frame_items.set("body_text", "")
        }
        default {
            response_frame_items.set("body_text", "")

        }
    }
    return response_frame_items
}
