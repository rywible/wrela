so:
    Environment variable helpers.

use:
    get_bytes_from_list,
    get_bytes_from_string,
    get_list_from_bytes,
    get_string_from_bytes
from bytes

use try_to_read_text from fs
use add_to_list from list
use try_to_parse_integer from parse

so: Canonical data-carried truth type for retrieved boolean values.
A StoredBoolean:
    has:
        value: Boolean = false


to get_trimmed_bytes(text: String) -> List[Integer]:
    raw_bytes = get_list_from_bytes(get_bytes_from_string(text))
    out = []
    mutable is_started = false
    mutable pending_bytes = []

    for byte_value in raw_bytes:
        if byte_value == 9 or byte_value == 10 or byte_value == 13 or byte_value == 32:
            if is_started:
                add_to_list(pending_bytes, byte_value)
        otherwise:
            if not is_started:
                is_started = true
            for pending_byte in pending_bytes:
                add_to_list(out, pending_byte)
            pending_bytes = []
            add_to_list(out, byte_value)

    return out


check list_is_empty(values: List[Integer]) -> Boolean:
    for value in values:
        return false
    return true


to drop_export_prefix(key_bytes: List[Integer]) -> List[Integer]:
    mutable word_bytes = []
    mutable rest_bytes = []
    mutable is_in_rest = false
    mutable has_seen_space = false

    for byte_value in key_bytes:
        if not is_in_rest:
            if byte_value == 32 or byte_value == 9:
                if list_is_empty given word_bytes:
                    continue
                is_in_rest = true
                has_seen_space = true
                continue
            add_to_list(word_bytes, byte_value)
            continue

        add_to_list(rest_bytes, byte_value)

    word_text = get_string_from_bytes(get_bytes_from_list(word_bytes))
    if has_seen_space and word_text == "export":
        return get_trimmed_bytes(get_string_from_bytes(get_bytes_from_list(rest_bytes)))

    return key_bytes


to strip_wrapping_quotes(value_bytes: List[Integer]) -> List[Integer]:
    mutable total = 0
    mutable first = -1
    mutable last = -1

    for byte_value in value_bytes:
        total = total + 1
        if first == -1:
            first = byte_value
        last = byte_value

    is_quoted = (first == 34 and last == 34) or (first == 39 and last == 39)
    if not is_quoted or total < 2:
        return value_bytes

    out = []
    mutable index = 0
    for byte_value in value_bytes:
        index = index + 1
        if index > 1 and index < total:
            add_to_list(out, byte_value)
    return out


to try_to_parse_dotenv_line(line: String) -> Result[Nothing]:
    line_bytes = get_trimmed_bytes(line)
    if list_is_empty given line_bytes:
        return nothing

    mutable first_byte = -1
    for byte_value in line_bytes:
        first_byte = byte_value
        break
    if first_byte == 35:
        return nothing

    mutable left_bytes = []
    mutable right_bytes = []
    mutable has_seen_equals = false

    for byte_value in line_bytes:
        if not has_seen_equals and byte_value == 61:
            has_seen_equals = true
            continue
        if has_seen_equals:
            add_to_list(right_bytes, byte_value)
        otherwise:
            add_to_list(left_bytes, byte_value)

    if not has_seen_equals:
        return nothing

    key_bytes = drop_export_prefix(get_trimmed_bytes(get_string_from_bytes(get_bytes_from_list(left_bytes))))
    if list_is_empty given key_bytes:
        return error "try_to_load_environment_variables: invalid key"

    value_bytes = strip_wrapping_quotes(get_trimmed_bytes(get_string_from_bytes(get_bytes_from_list(right_bytes))))

    key = get_string_from_bytes(get_bytes_from_list(key_bytes))
    value = get_string_from_bytes(get_bytes_from_list(value_bytes))
    is_ok = __wr_env_set(key, value)
    if is_ok:
        return nothing

    return error "try_to_load_environment_variables: failed to set variable"


to try_to_load_dotenv_text(contents: String) -> Result[Nothing]:
    bytes = get_list_from_bytes(get_bytes_from_string(contents))
    mutable current_line = []

    for byte_value in bytes:
        if byte_value == 13:
            continue

        if byte_value == 10:
            try_to_parse_dotenv_line(get_string_from_bytes(get_bytes_from_list(current_line))) otherwise nothing
            current_line = []
            continue

        add_to_list(current_line, byte_value)

    try_to_parse_dotenv_line(get_string_from_bytes(get_bytes_from_list(current_line))) otherwise nothing
    return nothing


so: Get an environment variable by key.
to try_to_get_environment_variable(key: String) -> Result[String]:
    value = __wr_env_get(key)
    match value:
        String:
            return value
        otherwise:
            return error "environment variable not found: {key}"


so: Get an environment variable or return the provided default.
to get_environment_variable_or_default(key: String, default: String) -> String:
    return try_to_get_environment_variable(key) otherwise default


so: Read an environment variable and coerce it to StoredBoolean.
to try_to_get_environment_variable_as_boolean(key: String) -> Result[StoredBoolean]:
    result = try_to_get_environment_variable(key)
    mutable value = ""
    match result:
        Ok(text):
            value = text
        Err(err):
            return error "environment variable not found: {key}: {err}"
        otherwise:
            return error "environment variable not found: {key}"

    normalized_bytes = get_trimmed_bytes(value)
    normalized = get_string_from_bytes(get_bytes_from_list(normalized_bytes))

    if normalized == "1" or normalized == "true" or normalized == "on":
        return true

    if normalized == "0" or normalized == "false" or normalized == "off":
        return false

    return error "environment variable is not a boolean: {key}"


so: Read an environment variable and coerce it to Integer.
to try_to_get_environment_variable_as_integer(key: String) -> Result[Integer]:
    result = try_to_get_environment_variable(key)
    mutable value = ""
    match result:
        Ok(text):
            value = text
        Err(err):
            return error "environment variable not found: {key}: {err}"
        otherwise:
            return error "environment variable not found: {key}"
    return try_to_parse_integer(value)


so: Set an environment variable.
to try_to_set_environment_variable(key: String, value: String) -> Result[Nothing]:
    if __wr_env_set(key, value):
        return nothing
    return error "failed to set environment variable: {key}"


so: Load environment variables from a file path.
to try_to_load_environment_variables(path: String) -> Result[Nothing]:
    read_result = try_to_read_text(path)
    mutable contents = ""
    match read_result:
        Ok(text):
            contents = text
        Err(err):
            return error "try_to_load_environment_variables: failed to read file: {err}"
        otherwise:
            return error "try_to_load_environment_variables: failed to read file"
    return try_to_load_dotenv_text(contents)
