//
// Environment variable helpers.

use {
    get_bytes_from_list,
    get_bytes_from_string,
    get_list_from_bytes,
    get_string_from_bytes
}
from bytes

use try_to_read_text from fs
use try_to_parse_integer from parse

// Canonical data-carried truth type for retrieved boolean values.
class StoredBoolean {
    value: Boolean = false


}
fn get_trimmed_bytes(text: String) -> List[Integer] {
    raw_values = get_list_from_bytes(get_bytes_from_string(text))
    trimmed_values = []
    mutable has_started = false
    mutable pending_values = []

    for byte_value in raw_values {
        if has_started and (byte_value == 9 or byte_value == 10 or byte_value == 13 or byte_value == 32) {
            pending_values.push(byte_value)
        }
        else if byte_value != 9 and byte_value != 10 and byte_value != 13 and byte_value != 32 {
            if not has_started {
                has_started = true
            }
            for pending_value in pending_values {
                trimmed_values.push(pending_value)
            }
            pending_values = []
            trimmed_values.push(byte_value)

        }
    }
    return trimmed_values


}
fn list_is_empty(values: List[Integer]) -> Boolean {
    for value_item in values {
        return false
    }
    return true


}
fn drop_export_prefix(key_bytes: List[Integer]) -> List[Integer] {
    mutable word_bytes = []
    mutable rest_bytes = []
    mutable is_in_rest = false
    mutable has_seen_space = false

    for byte_value in key_bytes {
        if not is_in_rest and (byte_value == 32 or byte_value == 9) {
            if list_is_empty(word_bytes) {
                continue
            }
            is_in_rest = true
            has_seen_space = true
            continue
        }
        if not is_in_rest {
            word_bytes.push(byte_value)
            continue

        }
        rest_bytes.push(byte_value)

    }
    word_text = get_string_from_bytes(get_bytes_from_list(word_bytes))
    if has_seen_space and word_text == "export" {
        return get_trimmed_bytes(get_string_from_bytes(get_bytes_from_list(rest_bytes)))

    }
    return key_bytes


}
fn strip_wrapping_quotes(value_bytes: List[Integer]) -> List[Integer] {
    mutable total = 0
    mutable first = -1
    mutable last = -1

    for byte_value in value_bytes {
        total = total + 1
        if first == -1 {
            first = byte_value
        }
        last = byte_value

    }
    is_quoted = (first == 34 and last == 34) or (first == 39 and last == 39)
    if not is_quoted or total < 2 {
        return value_bytes

    }
    out = []
    mutable index = 0
    for byte_value in value_bytes {
        index = index + 1
        if index > 1 and index < total {
            out.push(byte_value)
        }
    }
    return out


}
fn try_to_parse_dotenv_line(line: String) -> Result[Nothing] {
    line_bytes = get_trimmed_bytes(line)
    if list_is_empty(line_bytes) {
        return nothing

    }
    mutable first_byte = -1
    for byte_value in line_bytes {
        first_byte = byte_value
        break
    }
    if first_byte == 35 {
        return nothing

    }
    mutable left = []
    mutable right = []
    mutable has_seen_equals = false

    for byte_value in line_bytes {
        if not has_seen_equals and byte_value == 61 {
            has_seen_equals = true
            continue
        }
        if has_seen_equals {
            right.push(byte_value)
        }
        else {
            left.push(byte_value)

        }
    }
    if not has_seen_equals {
        return nothing

    }
    key_bytes = drop_export_prefix(get_trimmed_bytes(get_string_from_bytes(get_bytes_from_list(left))))
    if list_is_empty(key_bytes) {
        return error "try_to_load_environment_variables: invalid key"

    }
    value_bytes = strip_wrapping_quotes(get_trimmed_bytes(get_string_from_bytes(get_bytes_from_list(right))))

    key = get_string_from_bytes(get_bytes_from_list(key_bytes))
    value = get_string_from_bytes(get_bytes_from_list(value_bytes))
    if __wr_env_set(key, value) {
        return nothing

    }
    return error "try_to_load_environment_variables: failed to set variable"


}
fn try_to_load_dotenv_text(contents: String) -> Result[Nothing] {
    bytes = get_list_from_bytes(get_bytes_from_string(contents))
    mutable current_line = []

    for byte_value in bytes {
        if byte_value == 13 {
            continue

        }
        if byte_value == 10 {
            try_to_parse_dotenv_line(get_string_from_bytes(get_bytes_from_list(current_line))) ?? nothing
            current_line = []
            continue

        }
        current_line.push(byte_value)

    }
    try_to_parse_dotenv_line(get_string_from_bytes(get_bytes_from_list(current_line))) ?? nothing
    return nothing


}
// Get an environment variable by key.
fn try_to_get_environment_variable(key: String) -> Result[String] {
    value = __wr_env_get(key)
    match value {
        String {
            return value
        }
        default {
            return error "environment variable not found: {key}"


        }
    }
}
// Get an environment variable or return the provided default.
fn get_environment_variable_or_default(key: String, fallback: String) -> String {
    return try_to_get_environment_variable(key) ?? fallback


}
// Read an environment variable and coerce it to StoredBoolean.
fn try_to_get_environment_variable_as_boolean(key: String) -> Result[StoredBoolean] {
    result = try_to_get_environment_variable(key)
    mutable value = ""
    match result {
        Ok(text) {
            value = text
        }
        default {
            return error "environment variable not found: {key}"

        }
    }
    normalized_bytes = get_trimmed_bytes(value)
    normalized = get_string_from_bytes(get_bytes_from_list(normalized_bytes))

    if normalized == "1" or normalized == "true" or normalized == "on" {
        return true

    }
    if normalized == "0" or normalized == "false" or normalized == "off" {
        return false

    }
    return error "environment variable is not a boolean: {key}"


}
// Read an environment variable and coerce it to Integer.
fn try_to_get_environment_variable_as_integer(key: String) -> Result[Integer] {
    result = try_to_get_environment_variable(key)
    mutable value = ""
    match result {
        Ok(text) {
            value = text
        }
        default {
            return error "environment variable not found: {key}"
        }
    }
    return try_to_parse_integer(value)


}
// Set an environment variable.
fn try_to_set_environment_variable(key: String, value: String) -> Result[Nothing] {
    if __wr_env_set(key, value) {
        return nothing
    }
    return error "failed to set environment variable: {key}"


}
// Load environment variables from a file path.
fn try_to_load_environment_variables(path: String) -> Result[Nothing] {
    read_result = try_to_read_text(path)
    mutable contents = ""
    match read_result {
        Ok(text) {
            contents = text
        }
        default {
            return error "try_to_load_environment_variables: failed to read file"
        }
    }
    return try_to_load_dotenv_text(contents)
}
