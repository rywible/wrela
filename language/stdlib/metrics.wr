//
// Metrics helpers.

// Fetch a metric by id.
fn get(id: Integer) -> Integer {
    return __wr_metrics_get(id)

}
// Metric id for messages dropped due to pause.
fn get_dropped_paused_id() -> Integer {
    return __wr_metrics_dropped_paused_id()

}
