so:
    Parsing helpers.

use:
    get_bytes_from_string,
    get_list_from_bytes
from bytes

use add_to_list from list


check byte_is_ascii_space(byte_value: Integer) -> Boolean:
    return byte_value == 9 or byte_value == 10 or byte_value == 13 or byte_value == 32


to digit_value(byte_value: Integer) -> Integer:
    if byte_value >= 48 and byte_value <= 57:
        return byte_value - 48
    return -1


to trim_bytes(text: String) -> List[Integer]:
    raw_bytes = get_list_from_bytes(get_bytes_from_string(text))
    trimmed = []
    mutable is_started = false
    mutable pending_whitespace = []

    for byte_value in raw_bytes:
        if byte_is_ascii_space given byte_value:
            if is_started:
                add_to_list(pending_whitespace, byte_value)
        otherwise:
            if not is_started:
                is_started = true
            for pending in pending_whitespace:
                add_to_list(trimmed, pending)
            pending_whitespace = []
            add_to_list(trimmed, byte_value)

    return trimmed


so: Parse an Integer from a String.
to try_to_parse_integer(text: String) -> Result[Integer]:
    bytes = trim_bytes(text)
    mutable is_started = false
    mutable has_seen_digit = false
    mutable sign = 1
    mutable value = 0
    mutable has_previous_underscore = false

    for byte_value in bytes:
        if not is_started and (byte_value == 43 or byte_value == 45):
            is_started = true
            if byte_value == 45:
                sign = -1
            continue

        digit = digit_value(byte_value)
        if digit >= 0:
            is_started = true
            has_seen_digit = true
            has_previous_underscore = false
            value = value * 10 + digit
            continue

        if byte_value == 95:
            if not has_seen_digit or has_previous_underscore:
                return error "try_to_parse_integer: invalid integer"
            has_previous_underscore = true
            continue

        return error "try_to_parse_integer: invalid integer"

    if not has_seen_digit or has_previous_underscore:
        return error "try_to_parse_integer: invalid integer"

    return value * sign


so: Parse a Float from a String.
to try_to_parse_float(text: String) -> Result[Float]:
    bytes = trim_bytes(text)

    mutable is_started = false
    mutable sign = 1
    mutable whole = 0
    mutable fractional = 0
    mutable fractional_scale = 1.0
    mutable has_seen_digit = false
    mutable has_seen_dot = false

    mutable has_seen_exponent = false
    mutable is_parsing_exponent = false
    mutable has_just_entered_exponent = false
    mutable exponent_sign = 1
    mutable exponent_value = 0
    mutable has_seen_exponent_digit = false
    mutable has_previous_underscore = false

    for byte_value in bytes:
        if not is_started and (byte_value == 43 or byte_value == 45):
            is_started = true
            if byte_value == 45:
                sign = -1
            continue

        if byte_value == 95:
            if has_previous_underscore:
                return error "try_to_parse_float: invalid float"
            if is_parsing_exponent and not has_seen_exponent_digit:
                return error "try_to_parse_float: invalid float"
            if not is_parsing_exponent and not has_seen_digit:
                return error "try_to_parse_float: invalid float"
            has_previous_underscore = true
            continue

        if not is_parsing_exponent and byte_value == 46:
            if has_seen_dot or has_seen_exponent or has_previous_underscore:
                return error "try_to_parse_float: invalid float"
            is_started = true
            has_seen_dot = true
            has_previous_underscore = false
            continue

        if byte_value == 101 or byte_value == 69:
            if has_seen_exponent or has_previous_underscore or not has_seen_digit:
                return error "try_to_parse_float: invalid float"
            has_seen_exponent = true
            is_parsing_exponent = true
            has_just_entered_exponent = true
            has_previous_underscore = false
            continue

        if is_parsing_exponent and has_just_entered_exponent and (byte_value == 43 or byte_value == 45):
            if byte_value == 45:
                exponent_sign = -1
            has_just_entered_exponent = false
            has_previous_underscore = false
            continue

        digit = digit_value(byte_value)
        if digit < 0:
            return error "try_to_parse_float: invalid float"

        is_started = true
        has_previous_underscore = false

        if is_parsing_exponent:
            has_seen_exponent_digit = true
            has_just_entered_exponent = false
            exponent_value = exponent_value * 10 + digit
            continue

        has_seen_digit = true
        if has_seen_dot:
            fractional = fractional * 10 + digit
            fractional_scale = fractional_scale * 10.0
        otherwise:
            whole = whole * 10 + digit

    if not has_seen_digit or has_previous_underscore:
        return error "try_to_parse_float: invalid float"

    if is_parsing_exponent and (not has_seen_exponent_digit or has_just_entered_exponent):
        return error "try_to_parse_float: invalid float"

    mutable value = whole + 0.0
    value = value + (fractional / fractional_scale)

    if exponent_value > 0:
        for exponent_step in 1...exponent_value:
            if exponent_sign == 1:
                value = value * 10.0
            otherwise:
                value = value / 10.0

    if sign == -1:
        return 0.0 - value

    return value
