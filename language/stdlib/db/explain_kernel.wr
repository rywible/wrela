//
// DB explain kernel wrappers around runtime explain intrinsics.
// This module intentionally exposes read-only diagnostics.

fn explain_ownership_db(
    db_handle_explain_ownership: Integer,
    namespace_explain_ownership: String,
    key_explain_ownership: String
) -> Result[String] {
    owner_result = __wr_db_explain_resolve_owner(
        db_handle_explain_ownership,
        namespace_explain_ownership,
        key_explain_ownership
    )
    match owner_result {
        String(owner_json) {
            return owner_json
        }
        default {
            return error "explain_ownership_db failed"
        }
    }
}

fn explain_topology_db(
    db_handle_explain_topology: Integer,
    namespace_explain_topology: String,
    key_explain_topology: String
) -> Result[String] {
    topology_result = __wr_db_explain_global_route_lookup(
        db_handle_explain_topology,
        namespace_explain_topology,
        key_explain_topology
    )
    match topology_result {
        String(topology_json) {
            return topology_json
        }
        default {
            return error "explain_topology_db failed"
        }
    }
}

